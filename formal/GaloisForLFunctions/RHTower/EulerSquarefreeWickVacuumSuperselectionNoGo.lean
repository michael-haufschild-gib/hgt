import GaloisForLFunctions.RHTower.EulerSquarefreeWickRegularOrbitFlux
import GaloisForLFunctions.HTGeometry.PrimeResidueValuationInteractionSuperselection

/-!
# Vacuum superselection obstruction for Euler--Wick

The EWQ regular orbit contains four Fourier sectors, but its interaction data live in the three
nonvacuum residue-support sectors.  The corpus prime-residue valuation matroid makes the resulting
landing problem exact.  At the actual moduli `3` and `4`, every finite family of vacuum
prime-power ghosts is differentially independent over the field generated by **all** nonvacuum
residue sectors at every depth in the same window.

Thus neither the joint χ₁₂ interaction, the χ₃ and χ₄ marginals, nor arbitrary
differential-rational combinations of all three can synthesize the coefficient-faithful ζ vacuum.
The coefficient field already permits finite-prime rational corrections, so the ramified primes
`2` and `3` do not evade the obstruction.  Archimedean completion also cannot repair a missing
prime-coefficient coordinate.

This closes the EWQ-only completed-Xi landing branch.  A surviving Frankenstein route must import
an independent source-native vacuum carrier and use EWQ only as a transverse orientation or
positivity channel.
-/

open scoped BigOperators Matrix

noncomputable section

namespace GaloisForLFunctions.RHTower

open GaloisForLFunctions GaloisForLFunctions.HTGeometry

/-- The literal pair of EWQ residue moduli. -/
def ewqResidueModulus : Fin 2 → ℕ := ![3, 4]

instance ewqResidueModulus_neZero (i : Fin 2) : NeZero (ewqResidueModulus i) := by
  fin_cases i <;> constructor <;> norm_num [ewqResidueModulus]

instance ewqResidueModulus_product_neZero :
    NeZero (∏ i : Fin 2, ewqResidueModulus i) := by
  constructor
  norm_num [ewqResidueModulus]

/-- Moduli `3` and `4` satisfy the exact coprimality input of the corpus residue profile. -/
theorem ewqResidueModulus_pairwise :
    Pairwise (Function.onFun Nat.Coprime ewqResidueModulus) := by
  intro i j hij
  fin_cases i <;> fin_cases j <;>
    simp_all [Function.onFun, ewqResidueModulus, Nat.Coprime]

/-- **EWQ vacuum superselection.** Across every positive finite valuation window, all empty-support
ζ ghosts are differentially independent over the field generated by every nonempty-support
mod-3/mod-4 residue carrier. -/
theorem ewqPrimeResidueValuationVacuumSector_relativeHT
    {d : ℕ} (hd : 0 < d) :
    let A := fun i : Fin 2 => (ZMod (ewqResidueModulus i))ˣ
    let y := pairwiseCoprimePrimeUnitResidueProfile ewqResidueModulus
      ewqResidueModulus_pairwise
    GaloisForLFunctions.DifferentialIndependent
        (GaloisForLFunctions.differentialAdjoin
          finitePrimeRationalCoefficientField
          (Set.range (primeResidueValuationSupportComplementCarrier
            (d := d) A y (∅ : Finset (Fin 2)))))
        (primeResidueValuationSupportCellCarrier
          (d := d) A y (∅ : Finset (Fin 2))) := by
  have h := pairwiseCoprimePrimeResidueValuationSupportSectorSuperselection
    ewqResidueModulus ewqResidueModulus_pairwise hd (∅ : Finset (Fin 2))
  exact h.1

/-- Each individual ζ prime-valuation ghost lies outside the differential field generated by all
nonvacuum EWQ residue sectors in the window. -/
theorem ewqZetaPrimeValuationGhost_not_mem_nonvacuumField
    {d : ℕ} (hd : 0 < d) (r : Fin d) :
    let A := fun i : Fin 2 => (ZMod (ewqResidueModulus i))ˣ
    let y := pairwiseCoprimePrimeUnitResidueProfile ewqResidueModulus
      ewqResidueModulus_pairwise
    zetaPrimeValuationGhost ⟨r, ((), ())⟩ ∉
      GaloisForLFunctions.differentialAdjoin
        finitePrimeRationalCoefficientField
        (Set.range (primeResidueValuationSupportComplementCarrier
          (d := d) A y (∅ : Finset (Fin 2)))) := by
  dsimp only
  let A := fun i : Fin 2 => (ZMod (ewqResidueModulus i))ˣ
  let y := pairwiseCoprimePrimeUnitResidueProfile ewqResidueModulus
    ewqResidueModulus_pairwise
  let base := GaloisForLFunctions.differentialAdjoin
    finitePrimeRationalCoefficientField
    (Set.range (primeResidueValuationSupportComplementCarrier
      (d := d) A y (∅ : Finset (Fin 2))))
  let z : ∀ i, A i := fun _ => 1
  have hz : pointedSupport A z = ∅ := by
    ext i
    simp [pointedSupport, z]
  let q : PrimeResidueValuationSupportCellIndex d A ∅ :=
    ⟨r, ⟨z, hz⟩⟩
  let f := primeResidueValuationSupportCellCarrier
    (d := d) A y (∅ : Finset (Fin 2))
  have hDI : GaloisForLFunctions.DifferentialIndependent base f := by
    simpa [A, y, base, f] using
      ewqPrimeResidueValuationVacuumSector_relativeHT hd
  have htrans : Transcendental base (f q) := by
    unfold GaloisForLFunctions.DifferentialIndependent at hDI
    simpa using hDI.transcendental (q, 0)
  have hnot : f q ∉ base := by
    intro hmem
    apply htrans
    simpa using isAlgebraic_algebraMap
      (R := base) (A := arithmeticFunctionRationalCoordinateField)
      (⟨f q, hmem⟩ : base)
  have heq : f q = zetaPrimeValuationGhost ⟨r, ((), ())⟩ := by
    exact primeResidueValuationInteractionGridCarrier_vacuum_eq_zetaGhost A y r
  rw [heq] at hnot
  exact hnot

end GaloisForLFunctions.RHTower
