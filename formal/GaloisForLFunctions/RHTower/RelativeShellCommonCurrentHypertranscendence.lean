import GaloisForLFunctions.RHTower.RelativeShellCommonDivisorHypertranscendence
import GaloisForLFunctions.RHTower.HighExponentShellZeroFree
import GaloisForLFunctions.HTGeometry.ScalarLogCurrentReconstruction

/-!
# The common zeta connection is irreducible over the complete shell frame

Every high-exponent shell channel is the product of zeta with a holomorphic zero-free transverse
multiplier.  Its logarithmic current therefore splits into a common zeta current and a transverse
connection.  This file proves that the common current remains hypertranscendental after adjoining
the complete countable transverse frame.

Thus the divisor-bearing connection is not a finite differential-algebraic synthesis of all
zero-free shell coordinates, even though it is recovered exactly as the relative logarithmic
connection of every individual divisor-sharing channel.
-/

open scoped Differential UpperEndDifferentialInstances UpperEndComplexTowerInstances
open Set

namespace RHTower

open GaloisForLFunctions
open GaloisForLFunctions.HTGeometry

noncomputable section

/-- Differential field generated by the complete zero-free high-exponent shell frame. -/
abbrev relativeShellCurrentDifferentialField :
    IntermediateField upperEndRationalCoordinateField upperEndMeroField :=
  differentialAdjoin upperEndRationalCoordinateField
    (Set.range (fun m : {m : ℕ // 12 ≤ m} =>
      relativeShellMultiplierUpperEndCarrier m.1))

local instance relativeShellCurrentDifferentialFieldDifferential :
    Differential relativeShellCurrentDifferentialField :=
  derivationClosedDifferential _
    (derivationClosed_differentialAdjoin upperEndRationalCoordinateField _)

local instance relativeShellCurrentDifferentialFieldDifferentialAlgebra :
    DifferentialAlgebra relativeShellCurrentDifferentialField upperEndMeroField where
  deriv_algebraMap _ := rfl

/--
**Common-current irreducibility.**  The zeta logarithmic current remains hypertranscendental
over the differential field generated by every zero-free high-exponent shell multiplier.

Combined with `logDeriv_riemannZeta_mul_shellMultiplier`, this says that every divisor-sharing
shell channel carries the same exact relative connection, but the complete transverse frame
cannot manufacture that connection by any finite differential-algebraic expression.
-/
theorem zetaLogCurrentUpperEnd_hypertranscendentalOver_relativeShellMultipliers :
    HypertranscendentalOver relativeShellCurrentDifferentialField
      (Differential.logDeriv zetaUpperEndMero) := by
  exact
    logDeriv_hypertranscendentalOver
      zetaUpperEndMero_hypertranscendentalOver_relativeShellMultipliers
      zetaUpperEndMero_ne_zero

end

end RHTower
