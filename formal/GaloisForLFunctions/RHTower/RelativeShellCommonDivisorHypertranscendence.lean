import GaloisForLFunctions.RHTower.HighExponentShellHypertranscendence

/-!
# The common zeta divisor is hypertranscendental over its transverse shell frame

The high-exponent shell family factors as `S_m = ζ H_m`.  Existing results prove that the
zero-free transverse multipliers `H_m` remain jointly differentially independent after adjoining
zeta.  The converse direction is equally important for divisor geometry and is proved here:
zeta remains hypertranscendental after adjoining the complete countable transverse multiplier
family.

Thus the shared zeta divisor is not a finite differential-algebraic consequence of the
transverse shell frame.  This is stronger than separate hypertranscendence and stronger than
pairwise independence: even the differential field generated by every transverse shell
multiplier does not contain a differential-algebraic explanation of the common divisor factor.
-/

open scoped Differential UpperEndDifferentialInstances UpperEndComplexTowerInstances
open Set

namespace RHTower

open GaloisForLFunctions
open GaloisForLFunctions.HTGeometry

noncomputable section

/-- Zeta and all transverse shell multipliers from level two onward are jointly differentially
independent over the rational coordinate field. -/
theorem zetaRelativeShellMultiplierUpperEnd_differentialIndependent_two :
    DifferentialIndependent upperEndRationalCoordinateField
      (Sum.elim (fun _ : Unit => zetaUpperEndMero)
        (fun m : {m : ℕ // 2 ≤ m} =>
          relativeShellMultiplierUpperEndCarrier m.1)) := by
  apply (differentialIndependent_sumElim_iff
    (fun _ : Unit => zetaUpperEndMero)
    (fun m : {m : ℕ // 2 ≤ m} =>
      relativeShellMultiplierUpperEndCarrier m.1)).2
  constructor
  · exact
      ((differentialIndependent_sumElim_iff
        (fun _ : Unit => zetaUpperEndMero)
        (fun m : {m : ℕ // 2 ≤ m} =>
          highExponentShellUpperEndCarrier m.1)).1
        zetaPositiveShellUpperEnd_differentialIndependent).1
  · exact relativeShellMultiplierUpperEndCarrier_differentialIndependent_two

set_option maxHeartbeats 800000 in
/--
**Reciprocal common-divisor hypertranscendence.**  Zeta remains hypertranscendental over the
differential field generated by the complete countable family of transverse shell multipliers.
-/
theorem zetaUpperEndMero_hypertranscendentalOver_relativeShellMultipliers_two :
    HypertranscendentalOver
      (differentialAdjoin upperEndRationalCoordinateField
        (Set.range (fun m : {m : ℕ // 2 ≤ m} =>
          relativeShellMultiplierUpperEndCarrier m.1)))
      zetaUpperEndMero := by
  rw [hypertranscendentalOver_iff_differentialIndependent_singleton]
  have hswap :
      DifferentialIndependent upperEndRationalCoordinateField
        (Sum.elim
          (fun m : {m : ℕ // 2 ≤ m} =>
            relativeShellMultiplierUpperEndCarrier m.1)
          (fun _ : Unit => zetaUpperEndMero)) := by
    simpa using
      (zetaRelativeShellMultiplierUpperEnd_differentialIndependent_two.comp
        (Equiv.sumComm {m : ℕ // 2 ≤ m} Unit)
        (Equiv.sumComm {m : ℕ // 2 ≤ m} Unit).injective)
  exact
    ((differentialIndependent_sumElim_iff
      (fun m : {m : ℕ // 2 ≤ m} =>
        relativeShellMultiplierUpperEndCarrier m.1)
      (fun _ : Unit => zetaUpperEndMero)).1 hswap).2

/-- Zeta and the zero-free transverse shell multipliers from level twelve onward are jointly
differentially independent. -/
theorem zetaRelativeShellMultiplierUpperEnd_differentialIndependent :
    DifferentialIndependent upperEndRationalCoordinateField
      (Sum.elim (fun _ : Unit => zetaUpperEndMero)
        (fun m : {m : ℕ // 12 ≤ m} =>
          relativeShellMultiplierUpperEndCarrier m.1)) := by
  apply (differentialIndependent_sumElim_iff
    (fun _ : Unit => zetaUpperEndMero)
    (fun m : {m : ℕ // 12 ≤ m} =>
      relativeShellMultiplierUpperEndCarrier m.1)).2
  constructor
  · exact
      ((differentialIndependent_sumElim_iff
        (fun _ : Unit => zetaUpperEndMero)
        (fun m : {m : ℕ // 12 ≤ m} =>
          highExponentShellUpperEndCarrier m.1)).1
        zetaHighExponentShellUpperEnd_differentialIndependent).1
  · exact relativeShellMultiplierUpperEndCarrier_differentialIndependent

set_option maxHeartbeats 800000 in
/--
**Zero-free-frame common-divisor theorem.**  The common zeta factor remains
hypertranscendental over the differential field generated by every zero-free high-exponent
transverse multiplier.
-/
theorem zetaUpperEndMero_hypertranscendentalOver_relativeShellMultipliers :
    HypertranscendentalOver
      (differentialAdjoin upperEndRationalCoordinateField
        (Set.range (fun m : {m : ℕ // 12 ≤ m} =>
          relativeShellMultiplierUpperEndCarrier m.1)))
      zetaUpperEndMero := by
  rw [hypertranscendentalOver_iff_differentialIndependent_singleton]
  have hswap :
      DifferentialIndependent upperEndRationalCoordinateField
        (Sum.elim
          (fun m : {m : ℕ // 12 ≤ m} =>
            relativeShellMultiplierUpperEndCarrier m.1)
          (fun _ : Unit => zetaUpperEndMero)) := by
    simpa using
      (zetaRelativeShellMultiplierUpperEnd_differentialIndependent.comp
        (Equiv.sumComm {m : ℕ // 12 ≤ m} Unit)
        (Equiv.sumComm {m : ℕ // 12 ≤ m} Unit).injective)
  exact
    ((differentialIndependent_sumElim_iff
      (fun m : {m : ℕ // 12 ≤ m} =>
        relativeShellMultiplierUpperEndCarrier m.1)
      (fun _ : Unit => zetaUpperEndMero)).1 hswap).2

end

end RHTower
