import GaloisForLFunctions.RHTower.DeningerQ8RootNumberNegOneAutomorphisms
import Mathlib.NumberTheory.NumberField.InfinitePlace.TotallyRealComplex

/-!
# Total realness of the literal SST quaternion field

The SST radical field is generated by `z` with
`z² = (5 + √5) * (41 + 6√41)`.  Under every complex embedding the two
quadratic radicals are real.  Their four possible sign choices still make
both factors strictly positive, so the image of `z` is real as well.  Since
`z` generates the complete degree-eight field, every complex embedding is
fixed by conjugation.

This closes the archimedean field-classification input for the Q8 capstone. It
does not identify a global Artin epsilon factor or select the dyadic local
character.
-/

namespace RHTower

open scoped NumberField

noncomputable section

local notation "K1" => deningerQ8RootNumberNegOneFirstQuadraticField
local notation "K2" => deningerQ8RootNumberNegOneSecondQuadraticField
local notation "K3" => deningerQ8RootNumberNegOneTopField

noncomputable local instance q8TotallyRealFiniteDimensionalK1K2 : FiniteDimensional K1 K2 :=
  Module.Basis.finiteDimensional_of_finite
    (AdjoinRoot.powerBasis
      deningerQ8RootNumberNegOne_secondQuadratic_irreducible.ne_zero).basis

noncomputable local instance q8TotallyRealFiniteDimensionalK2K3 : FiniteDimensional K2 K3 :=
  Module.Basis.finiteDimensional_of_finite
    (AdjoinRoot.powerBasis
      deningerQ8RootNumberNegOne_thirdQuadratic_irreducible.ne_zero).basis

noncomputable local instance q8TotallyRealFiniteDimensionalRatK2 : FiniteDimensional ℚ K2 :=
  FiniteDimensional.trans ℚ K1 K2

noncomputable local instance q8TotallyRealFiniteDimensionalRatK3 : FiniteDimensional ℚ K3 :=
  FiniteDimensional.trans ℚ K2 K3

private theorem complex_conj_eq_self_of_sq_eq_pos
    {z : ℂ} {r : ℝ} (hr : 0 < r) (hz : z ^ (2 : ℕ) = (r : ℂ)) :
    (starRingEnd ℂ) z = z := by
  rw [Complex.conj_eq_iff_im]
  have him : z.re * z.im + z.im * z.re = 0 := by
    have h := congrArg Complex.im hz
    simpa [pow_two, Complex.mul_im] using h
  have hre : z.re * z.re - z.im * z.im = r := by
    have h := congrArg Complex.re hz
    simpa [pow_two, Complex.mul_re] using h
  by_cases hzre : z.re = 0
  · rw [hzre] at hre
    nlinarith [sq_nonneg z.im]
  · have him' : z.re * z.im = 0 := by nlinarith [him]
    exact (mul_eq_zero.mp him').resolve_left hzre

private theorem deningerQ8RootNumberNegOne_complexEmbedding_topX_real
    (φ : K3 →+* ℂ) :
    (starRingEnd ℂ) (φ deningerQ8RootNumberNegOneTopX) =
      φ deningerQ8RootNumberNegOneTopX := by
  apply complex_conj_eq_self_of_sq_eq_pos (r := 5) (by norm_num)
  convert (show (φ deningerQ8RootNumberNegOneTopX) ^ (2 : ℕ) = (5 : ℂ) by
    simpa only [map_pow, map_ofNat] using
      congrArg φ deningerQ8RootNumberNegOne_topX_sq) using 1
  norm_num

private theorem deningerQ8RootNumberNegOne_complexEmbedding_topY_real
    (φ : K3 →+* ℂ) :
    (starRingEnd ℂ) (φ deningerQ8RootNumberNegOneTopY) =
      φ deningerQ8RootNumberNegOneTopY := by
  apply complex_conj_eq_self_of_sq_eq_pos (r := 41) (by norm_num)
  convert (show (φ deningerQ8RootNumberNegOneTopY) ^ (2 : ℕ) = (41 : ℂ) by
    simpa only [map_pow, map_ofNat] using
      congrArg φ deningerQ8RootNumberNegOne_topY_sq) using 1
  norm_num

private theorem deningerQ8RootNumberNegOne_complexEmbedding_topRoot_real
    (φ : K3 →+* ℂ) :
    (starRingEnd ℂ) (φ deningerQ8RootNumberNegOneTopRoot) =
      φ deningerQ8RootNumberNegOneTopRoot := by
  let x : ℂ := φ deningerQ8RootNumberNegOneTopX
  let y : ℂ := φ deningerQ8RootNumberNegOneTopY
  have hx : (starRingEnd ℂ) x = x :=
    deningerQ8RootNumberNegOne_complexEmbedding_topX_real φ
  have hy : (starRingEnd ℂ) y = y :=
    deningerQ8RootNumberNegOne_complexEmbedding_topY_real φ
  have hxim : x.im = 0 := Complex.conj_eq_iff_im.mp hx
  have hyim : y.im = 0 := Complex.conj_eq_iff_im.mp hy
  have hxsq : x.re ^ (2 : ℕ) = 5 := by
    have h := congrArg Complex.re
      (congrArg φ deningerQ8RootNumberNegOne_topX_sq)
    simpa [x, map_pow, map_ofNat, pow_two, Complex.mul_re, hxim] using h
  have hysq : y.re ^ (2 : ℕ) = 41 := by
    have h := congrArg Complex.re
      (congrArg φ deningerQ8RootNumberNegOne_topY_sq)
    simpa [y, map_pow, map_ofNat, pow_two, Complex.mul_re, hyim] using h
  have hxpos : 0 < 5 + x.re := by
    nlinarith [sq_nonneg (x.re + 5)]
  have hypos : 0 < 41 + 6 * y.re := by
    nlinarith [sq_nonneg (6 * y.re + 41)]
  have hzsq :
      (φ deningerQ8RootNumberNegOneTopRoot) ^ (2 : ℕ) =
        (((5 + x.re) * (41 + 6 * y.re) : ℝ) : ℂ) := by
    calc
      (φ deningerQ8RootNumberNegOneTopRoot) ^ (2 : ℕ) =
          φ (deningerQ8RootNumberNegOneR deningerQ8RootNumberNegOneTopX *
            deningerQ8RootNumberNegOneS deningerQ8RootNumberNegOneTopY) := by
              rw [← map_pow, q8TopRoot_radical_relation]
      _ = (((5 + x.re) * (41 + 6 * y.re) : ℝ) : ℂ) := by
        apply Complex.ext
        · simp [deningerQ8RootNumberNegOneR, deningerQ8RootNumberNegOneS,
            x, y, hxim, hyim, map_ofNat]
        · simp [deningerQ8RootNumberNegOneR, deningerQ8RootNumberNegOneS,
            x, y, hxim, hyim, map_ofNat]
  exact complex_conj_eq_self_of_sq_eq_pos (mul_pos hxpos hypos) hzsq

/-- Every complex embedding of the literal SST field is fixed by complex
conjugation. -/
theorem deningerQ8RootNumberNegOne_complexEmbedding_isReal
    (φ : K3 →+* ℂ) : NumberField.ComplexEmbedding.IsReal φ := by
  rw [NumberField.ComplexEmbedding.isReal_iff]
  have hAlg :
      (NumberField.ComplexEmbedding.conjugate φ).toRatAlgHom =
        φ.toRatAlgHom := by
    apply AlgHom.ext_of_adjoin_eq_top
      (show Algebra.adjoin ℚ {deningerQ8RootNumberNegOneTopRoot} = ⊤ by
        exact (IntermediateField.adjoin_eq_top_iff_of_isAlgebraic
          (fun z _ => Algebra.IsAlgebraic.isAlgebraic z)).mp
            deningerQ8RootNumberNegOne_primitiveField_eq_top)
    intro z hz
    simp only [Set.mem_singleton_iff] at hz
    subst z
    change (starRingEnd ℂ) (φ deningerQ8RootNumberNegOneTopRoot) =
      φ deningerQ8RootNumberNegOneTopRoot
    exact deningerQ8RootNumberNegOne_complexEmbedding_topRoot_real φ
  exact congrArg AlgHom.toRingHom hAlg

/-- The literal SST quaternion field has no complex infinite places. -/
theorem deningerQ8RootNumberNegOne_isTotallyReal :
    NumberField.IsTotallyReal K3 where
  isReal v := NumberField.InfinitePlace.isReal_iff.mpr
    (deningerQ8RootNumberNegOne_complexEmbedding_isReal v.embedding)

end

end RHTower
