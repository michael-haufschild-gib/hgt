import Mathlib.LinearAlgebra.SymmetricAlgebra.Basic
import Mathlib.RingTheory.TensorProduct.Quotient
import GaloisForLFunctions.RHTower.DeningerRankQuotient

/-!
# The rank quotient is the pushout along the free algebra on the fibre

The free commutative algebra on the low-rank fibre maps to the algebra by the fibre inclusion and to
the unit by the augmentation that kills every generator.  By the free–forgetful adjunction an
algebra map out of the algebra makes the resulting square commute exactly when it kills the fibre,
so the rank quotient — the quotient by the ideal generated by the fibre — together with the
projection and the unit map is the pushout of that span in commutative algebras.

This is the one-categorical content of the homotopy pushout defining the multiplicative rank
quotient and of its mapping-space description: a map out of the pushout is a map out of the algebra
together with a killing of the fibre.  Only the killing survives when the higher homotopies are
discarded, and that is what the degree-zero statement uses.

* `deningerRankFreeToA`, `deningerRankAug` : the two maps of the pushout span.
* `deningerRank_comp_eq_iff` : **commuting over the free algebra is exactly killing the fibre.**
* `deningerRankQuotient_square` : the pushout square commutes.
* `deningerRankQuotient_isPushout` : **the rank quotient is the pushout.**
-/

namespace RHTower

section Pushout

variable {R A M : Type*} [CommRing R] [CommRing A] [Algebra R A] [AddCommGroup M] [Module R M]
variable {T : Type*} [CommRing T] [Algebra R T]

/-- The map from the free commutative algebra on the low-rank fibre to the algebra, determined by
the fibre inclusion. -/
noncomputable def deningerRankFreeToA (j : M →ₗ[R] A) : SymmetricAlgebra R M →ₐ[R] A :=
  SymmetricAlgebra.lift j

@[simp]
theorem deningerRankFreeToA_ι (j : M →ₗ[R] A) (m : M) :
    deningerRankFreeToA j (SymmetricAlgebra.ι R M m) = j m :=
  SymmetricAlgebra.lift_ι_apply j m

/-- The augmentation of the free commutative algebra on the low-rank fibre: the map to the unit
killing every generator. -/
noncomputable def deningerRankAug (R M : Type*) [CommRing R] [AddCommGroup M] [Module R M] :
    SymmetricAlgebra R M →ₐ[R] R :=
  SymmetricAlgebra.algebraMapInv

@[simp]
theorem deningerRankAug_ι (m : M) :
    deningerRankAug R M (SymmetricAlgebra.ι R M m) = 0 :=
  SymmetricAlgebra.algebraMapInv_ι m

/-- **The free–forgetful reduction.**  An algebra map out of the algebra makes the square over the
free algebra on the fibre commute exactly when it kills the fibre. -/
theorem deningerRank_comp_eq_iff (j : M →ₗ[R] A) (f : A →ₐ[R] T) :
    f.comp (deningerRankFreeToA j) = (Algebra.ofId R T).comp (deningerRankAug R M)
      ↔ ∀ m, f (j m) = 0 := by
  constructor
  · intro h m
    have hval := congrArg (fun F : SymmetricAlgebra R M →ₐ[R] T => F (SymmetricAlgebra.ι R M m)) h
    simpa using hval
  · intro hf
    refine SymmetricAlgebra.algHom_ext (LinearMap.ext fun m => ?_)
    show f (deningerRankFreeToA j (SymmetricAlgebra.ι R M m))
      = (Algebra.ofId R T) (deningerRankAug R M (SymmetricAlgebra.ι R M m))
    rw [deningerRankFreeToA_ι, deningerRankAug_ι, hf m, map_zero]

/-- The pushout square commutes: the rank quotient kills the fibre, so its projection agrees with
the augmentation over the free algebra. -/
theorem deningerRankQuotient_square (j : M →ₗ[R] A) :
    (deningerRankQuotientMap j).comp (deningerRankFreeToA j)
      = (Algebra.ofId R (A ⧸ deningerRankIdeal j)).comp (deningerRankAug R M) :=
  (deningerRank_comp_eq_iff j (deningerRankQuotientMap j)).mpr (deningerRankQuotient_j_eq_zero j)

/-- **The rank quotient is the pushout of the span `A ← Sym(J) → 1`** in commutative algebras: a
commuting square out of that span factors uniquely through it.  This is the one-categorical content
of the homotopy pushout defining the multiplicative rank quotient, and of the mapping-space
description of maps out of it. -/
theorem deningerRankQuotient_isPushout (j : M →ₗ[R] A) (f : A →ₐ[R] T) (g : R →ₐ[R] T)
    (hcomm : f.comp (deningerRankFreeToA j) = g.comp (deningerRankAug R M)) :
    ∃! h : (A ⧸ deningerRankIdeal j) →ₐ[R] T, h.comp (deningerRankQuotientMap j) = f := by
  have hg : g = Algebra.ofId R T := by
    refine AlgHom.ext fun r => ?_
    have := g.commutes r
    simpa using this
  rw [hg] at hcomm
  exact deningerRankQuotient_factor j f ((deningerRank_comp_eq_iff j f).mp hcomm)

end Pushout

section AugmentationIdeal

variable {R A M : Type*} [CommRing R] [CommRing A] [Algebra R A] [AddCommGroup M] [Module R M]

/-- Every element of the free commutative algebra differs from its augmentation by an element of
the ideal generated by the generators. -/
theorem deningerRankAug_sub_mem (x : SymmetricAlgebra R M) :
    x - algebraMap R (SymmetricAlgebra R M) (deningerRankAug R M x)
      ∈ Ideal.span (Set.range (SymmetricAlgebra.ι R M)) := by
  induction x using SymmetricAlgebra.induction with
  | algebraMap r =>
    have hr : deningerRankAug R M (algebraMap R (SymmetricAlgebra R M) r) = r := by
      simp
    rw [hr, sub_self]
    exact Ideal.zero_mem _
  | ι m =>
    rw [deningerRankAug_ι, map_zero, sub_zero]
    exact Ideal.subset_span ⟨m, rfl⟩
  | mul a b ha hb =>
    have hid : a * b - algebraMap R (SymmetricAlgebra R M) (deningerRankAug R M (a * b))
        = (a - algebraMap R (SymmetricAlgebra R M) (deningerRankAug R M a)) * b
          + algebraMap R (SymmetricAlgebra R M) (deningerRankAug R M a)
            * (b - algebraMap R (SymmetricAlgebra R M) (deningerRankAug R M b)) := by
      rw [map_mul, map_mul]
      ring
    rw [hid]
    exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ ha) (Ideal.mul_mem_left _ _ hb)
  | add a b ha hb =>
    have hid : a + b - algebraMap R (SymmetricAlgebra R M) (deningerRankAug R M (a + b))
        = (a - algebraMap R (SymmetricAlgebra R M) (deningerRankAug R M a))
          + (b - algebraMap R (SymmetricAlgebra R M) (deningerRankAug R M b)) := by
      rw [map_add, map_add]
      ring
    rw [hid]
    exact Ideal.add_mem _ ha hb

/-- **The augmentation ideal is generated by the generators.** -/
theorem deningerRankAug_ker :
    RingHom.ker (deningerRankAug R M : SymmetricAlgebra R M →+* R)
      = Ideal.span (Set.range (SymmetricAlgebra.ι R M)) := by
  refine le_antisymm (fun x hx => ?_) ?_
  · have h := deningerRankAug_sub_mem (R := R) (M := M) x
    have hx' : deningerRankAug R M x = 0 := RingHom.mem_ker.mp hx
    rw [hx', map_zero, sub_zero] at h
    exact h
  · rw [Ideal.span_le]
    rintro _ ⟨m, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker]
    exact deningerRankAug_ι m

/-- **The rank ideal is the base change of the augmentation ideal.**  This is the identification the
degree-zero statement needs: dividing by the ideal generated by the fibre *is* the base change of
the free algebra along its augmentation. -/
theorem deningerRankIdeal_eq_map (j : M →ₗ[R] A) :
    Ideal.map (deningerRankFreeToA j : SymmetricAlgebra R M →+* A)
        (RingHom.ker (deningerRankAug R M : SymmetricAlgebra R M →+* R))
      = deningerRankIdeal j := by
  rw [deningerRankAug_ker, Ideal.map_span, deningerRankIdeal]
  congr 1
  rw [← Set.range_comp]
  exact congrArg Set.range (funext fun m => deningerRankFreeToA_ι j m)

end AugmentationIdeal


section BaseChange

open scoped TensorProduct

variable {R A M : Type*} [CommRing R] [CommRing A] [Algebra R A] [AddCommGroup M] [Module R M]

/-- The augmentation of the free commutative algebra is surjective: it splits the unit. -/
theorem deningerRankAug_surjective :
    Function.Surjective (deningerRankAug R M) := fun r =>
  ⟨algebraMap R (SymmetricAlgebra R M) r, by simp⟩

/-- The free algebra modulo its augmentation ideal is the unit. -/
noncomputable def deningerRankAugQuotientEquiv :
    (SymmetricAlgebra R M ⧸ RingHom.ker (deningerRankAug R M : SymmetricAlgebra R M →+* R))
      ≃ₐ[R] R :=
  Ideal.quotientKerAlgEquivOfSurjective (deningerRankAug_surjective (R := R) (M := M))

/-- **The degree-zero base change.**  Regarding the algebra as an algebra over the free algebra on
the fibre, the base change along the augmentation is the rank quotient.  Together with
`deningerRankAugQuotientEquiv` this is the degree-zero identification: the pushout of
`A ← Sym(J) → 1` is `A` modulo the ideal generated by the fibre. -/
noncomputable def deningerRankBaseChangeEquiv (j : M →ₗ[R] A) :
    letI : Algebra (SymmetricAlgebra R M) A := (deningerRankFreeToA j).toAlgebra
    (A ⧸ deningerRankIdeal j) ≃ₐ[A]
      A ⊗[SymmetricAlgebra R M]
        (SymmetricAlgebra R M ⧸ RingHom.ker (deningerRankAug R M : SymmetricAlgebra R M →+* R)) := by
  letI : Algebra (SymmetricAlgebra R M) A := (deningerRankFreeToA j).toAlgebra
  refine (Ideal.quotientEquivAlgOfEq A ?_).trans
    (Algebra.TensorProduct.quotIdealMapEquivTensorQuot A
      (RingHom.ker (deningerRankAug R M : SymmetricAlgebra R M →+* R)))
  exact (deningerRankIdeal_eq_map j).symm

end BaseChange

end RHTower
