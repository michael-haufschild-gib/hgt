import GaloisForLFunctions.RHTower.PaperPrimeCoShiftEscape
import GaloisForLFunctions.HTGeometry.CompactCofinalEssentialMargin
import Mathlib.Topology.Algebra.StarSubalgebra

/-!
# The arithmetic shift algebra retains its norm modulo compacts

The norm-closed star algebra generated by all multiplicative shifts has no nonzero compact
operator. More precisely, its operator norms and distances are unchanged by quotienting by the
compact ideal. Escaping unused primes prove the lower bound before norm closure. The proven
paper ideal trace consequently takes only zero at zero and infinity elsewhere on this algebra.
-/

namespace RHTower.PrimeCoShift

noncomputable section

open Filter Topology GaloisForLFunctions.HTGeometry
open scoped ENNReal Classical

private def eventualPrimeCommutant : StarSubalgebra ℂ (H →L[ℂ] H) where
  carrier := {A | ∀ᶠ n in atTop,
    Commute A (Vop (primePNat (paperCoShiftEscapePrime n))) ∧
    Commute A (primeCoShift (primePNat (paperCoShiftEscapePrime n)))}
  zero_mem' := .of_forall fun _ => ⟨Commute.zero_left _, Commute.zero_left _⟩
  add_mem' := by
    intro A B hA hB
    filter_upwards [hA, hB] with n hn hm
    exact ⟨hn.1.add_left hm.1, hn.2.add_left hm.2⟩
  mul_mem' := by
    intro A B hA hB
    filter_upwards [hA, hB] with n hn hm
    exact ⟨hn.1.mul_left hm.1, hn.2.mul_left hm.2⟩
  algebraMap_mem' := fun c => .of_forall fun _ => ⟨Algebra.commutes c _, Algebra.commutes c _⟩
  star_mem' := by
    intro A hA
    filter_upwards [hA] with n hn
    exact ⟨by simpa only [star_primeCoShift] using hn.2.star_star,
      by simpa only [star_Vop] using hn.1.star_star⟩

/-- The full norm-closed algebra of the native arithmetic shifts and their adjoints. -/
def paperPrimeCoShiftAlgebra : StarSubalgebra ℂ (H →L[ℂ] H) :=
  (StarAlgebra.adjoin ℂ (Set.range Vop)).topologicalClosure

theorem paperPrimeCoShiftAlgebra_shift_mem (p : ℕ+) : Vop p ∈ paperPrimeCoShiftAlgebra :=
  StarSubalgebra.le_topologicalClosure _ (StarAlgebra.subset_adjoin ℂ _ ⟨p, rfl⟩)

theorem paperPrimeCoShiftAlgebra_coShift_mem (p : ℕ+) :
    primeCoShift p ∈ paperPrimeCoShiftAlgebra := by
  rw [← star_Vop]
  exact star_mem (paperPrimeCoShiftAlgebra_shift_mem p)

theorem paperPrimeCoShiftAlgebra_defect_mem (p : ℕ+) : Eop p ∈ paperPrimeCoShiftAlgebra :=
  sub_mem (one_mem _) (mul_mem
    (paperPrimeCoShiftAlgebra_shift_mem p) (paperPrimeCoShiftAlgebra_coShift_mem p))

private theorem eventualPrimeCommutant_norm_le (A : eventualPrimeCommutant)
    (K : compactOperatorStarAlgebra H) : ‖A.1‖ ≤ ‖A.1 - K.1‖ := by
  apply ContinuousLinearMap.opNorm_le_of_unit_norm (norm_nonneg _)
  intro v hv
  have hK := (paperCoShiftEscape_compact_tendsto K v).norm
  have ht : Tendsto
      (fun n => ‖A.1 v‖ - ‖K.1 (Vop (primePNat (paperCoShiftEscapePrime n)) v)‖)
      atTop (𝓝 ‖A.1 v‖) := by
    simpa only [norm_zero, sub_zero] using tendsto_const_nhds.sub hK
  apply le_of_tendsto ht
  filter_upwards [A.property] with n hn
  let U := Vop (primePNat (paperCoShiftEscapePrime n))
  have hAv : A.1 (U v) = U (A.1 v) :=
    congrArg (fun T : H →L[ℂ] H => T v) hn.1.eq
  have hnorm : ‖A.1 (U v)‖ = ‖A.1 v‖ := by
    rw [hAv]
    exact (primeShift _).norm_map _
  have hUv : ‖U v‖ = 1 := ((primeShift _).norm_map v).trans hv
  calc
    ‖A.1 v‖ - ‖K.1 (U v)‖ = ‖A.1 (U v)‖ - ‖K.1 (U v)‖ := by rw [hnorm]
    _ ≤ ‖A.1 (U v) - K.1 (U v)‖ := norm_sub_norm_le _ _
    _ = ‖(A.1 - K.1) (U v)‖ := rfl
    _ ≤ ‖A.1 - K.1‖ := by simpa only [hUv, mul_one] using (A.1 - K.1).le_opNorm (U v)

/-- Compact corrections cannot lower the norm anywhere in the closed arithmetic shift algebra. -/
theorem paperPrimeCoShiftAlgebra_norm_le_sub_compact (A : paperPrimeCoShiftAlgebra)
    (K : compactOperatorStarAlgebra H) : ‖A.1‖ ≤ ‖A.1 - K.1‖ := by
  have hgen : StarAlgebra.adjoin ℂ (Set.range Vop) ≤ eventualPrimeCommutant := by
    apply StarAlgebra.adjoin_le
    rintro _ ⟨p, rfl⟩
    exact paperCoShiftEscape_eventually_commute p
  have hclosed : IsClosed {T : H →L[ℂ] H | ‖T‖ ≤ ‖T - K.1‖} :=
    isClosed_le continuous_norm ((continuous_id.sub continuous_const).norm)
  exact closure_minimal (fun T hT => eventualPrimeCommutant_norm_le ⟨T, hgen hT⟩ K)
    hclosed A.property

/-- Exact preservation of essential norm throughout the arithmetic shift algebra. -/
theorem paperPrimeCoShiftAlgebra_compactIdealDistance (A : paperPrimeCoShiftAlgebra) :
    compactIdealDistance A.1 = ‖A.1‖ := by
  apply le_antisymm
  · simpa using compactIdealDistance_le A.1 0 isCompactOperator_zero
  · exact le_compactIdealDistance A.1 ‖A.1‖ fun K hK =>
      paperPrimeCoShiftAlgebra_norm_le_sub_compact A ⟨K, hK⟩

/-- The represented arithmetic shift algebra meets the compact ideal only at zero. -/
theorem paperPrimeCoShiftAlgebra_compact_iff_zero (A : paperPrimeCoShiftAlgebra) :
    IsCompactOperator A.1 ↔ A = 0 := by
  constructor
  · intro h
    have hn := paperPrimeCoShiftAlgebra_norm_le_sub_compact A ⟨A.1, h⟩
    rw [sub_self, norm_zero] at hn
    apply Subtype.ext
    exact norm_eq_zero.mp (le_antisymm hn (norm_nonneg _))
  · rintro rfl
    exact isCompactOperator_zero

theorem paperPrimeCoShiftAlgebra_compact_sub_iff_eq (A B : paperPrimeCoShiftAlgebra) :
    IsCompactOperator (A.1 - B.1) ↔ A = B := by
  change IsCompactOperator (A - B).1 ↔ _
  rw [paperPrimeCoShiftAlgebra_compact_iff_zero, sub_eq_zero]

theorem paperPrimeCoShiftAlgebra_compactIdealDistance_sub (A B : paperPrimeCoShiftAlgebra) :
    compactIdealDistance (A.1 - B.1) = dist A B := by
  simpa [dist_eq_norm] using paperPrimeCoShiftAlgebra_compactIdealDistance (A - B)

/-- The paper compact-ideal weight has zero cost exactly at the zero algebra element. -/
theorem paperPrimeCoShiftAlgebra_traceCost (A : paperPrimeCoShiftAlgebra) :
    compactOperatorTraceCost H A.1 = if A = 0 then 0 else ∞ := by
  rw [compactOperatorTraceCost_eq, paperPrimeCoShiftAlgebra_compact_iff_zero]
  split_ifs <;> rfl

theorem paperPrimeCoShiftAlgebra_traceCost_lt_top_iff (A : paperPrimeCoShiftAlgebra) :
    compactOperatorTraceCost H A.1 < ∞ ↔ A = 0 := by
  rw [compactOperatorTraceCost_lt_top_iff, paperPrimeCoShiftAlgebra_compact_iff_zero]

/-- Compact corrections retain the exact zero-or-infinite ideal cost. -/
theorem paperPrimeCoShiftAlgebra_traceCost_add_compact (A : paperPrimeCoShiftAlgebra)
    (K : compactOperatorStarAlgebra H) :
    compactOperatorTraceCost H (A.1 + K.1) = if A = 0 then 0 else ∞ := by
  rw [compactOperatorTraceCost_add_compact, paperPrimeCoShiftAlgebra_traceCost]

end

end RHTower.PrimeCoShift
