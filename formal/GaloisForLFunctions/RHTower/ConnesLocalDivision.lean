import GaloisForLFunctions.RHTower.ConnesDivisionDistribution

/-!
# Appendix I (27): the local division step

Appendix I (27) of

  A. Connes, *Trace formula in noncommutative geometry and the zeros of the Riemann zeta
  function*, arXiv:math/9811068.

`ConnesDivisionDistribution.connes_division_solution_structure` reduces the classification of the
solutions of `φ·α = 0` to the *division hypothesis*: every test function vanishing near the origin
lies in the ideal generated by `φ`.  This file discharges that hypothesis in the situation the
paper is in — `φ` smooth with an isolated zero, test functions supported in a window on which the
zero is the only one.  No growth hypothesis on `1/φ` is needed, because the quotient inherits the
compact support of the numerator and a compactly supported smooth function is Schwartz.
-/

open Set
open scoped ContDiff

namespace GaloisForLFunctions.RHTower

noncomputable section

/-- **Appendix I (27), the division.**  If `φ` is smooth and has no zero on `(-R,R)` other than the
origin, then every Schwartz function supported in `(-R,R)` and vanishing near the origin is `φ`
times a Schwartz function. -/
theorem connes_schwartz_local_division {R : ℝ} (φ : ℝ → ℂ)
    (hφsmooth : ContDiff ℝ ∞ φ)
    (hφne : ∀ x : ℝ, x ∈ Ioo (-R) R → x ≠ 0 → φ x ≠ 0)
    (ψ : SchwartzMap ℝ ℂ) (hsupp : tsupport (ψ : ℝ → ℂ) ⊆ Ioo (-R) R)
    {δ : ℝ} (hδ : 0 < δ) (hvanish : ∀ x : ℝ, |x| ≤ δ → (ψ : ℝ → ℂ) x = 0) :
    ∃ χ : SchwartzMap ℝ ℂ, (ψ : ℝ → ℂ) = fun x => φ x * (χ : ℝ → ℂ) x := by
  set q : ℝ → ℂ := fun x => (ψ : ℝ → ℂ) x / φ x with hq
  -- Off the closed support of `ψ` the quotient vanishes.
  have hoff : ∀ x : ℝ, x ∉ tsupport (ψ : ℝ → ℂ) → (ψ : ℝ → ℂ) x = 0 := by
    intro x hx
    exact image_eq_zero_of_notMem_tsupport hx
  -- `ψ` vanishes wherever `φ` does.
  have hzero : ∀ x : ℝ, φ x = 0 → (ψ : ℝ → ℂ) x = 0 := by
    intro x hx
    by_cases hmem : x ∈ tsupport (ψ : ℝ → ℂ)
    · have hx' : x ∈ Ioo (-R) R := hsupp hmem
      by_cases hx0 : x = 0
      · rw [hx0]
        exact hvanish 0 (by simpa using hδ.le)
      · exact absurd hx (hφne x hx' hx0)
    · exact hoff x hmem
  have hsmooth : ContDiff ℝ ∞ q := by
    rw [contDiff_iff_contDiffAt]
    intro x
    by_cases hx : φ x = 0
    · -- `q` vanishes on a neighbourhood of `x`
      have hnbhd : ∀ᶠ y in nhds x, q y = 0 := by
        by_cases hmem : x ∈ tsupport (ψ : ℝ → ℂ)
        · have hx' : x ∈ Ioo (-R) R := hsupp hmem
          have hx0 : x = 0 := by
            by_contra hne
            exact (hφne x hx' hne) hx
          subst hx0
          have hball : Metric.ball (0 : ℝ) δ ∈ nhds (0 : ℝ) :=
            Metric.ball_mem_nhds _ hδ
          filter_upwards [hball] with y hy
          have hy' : |y| ≤ δ := by
            have := Metric.mem_ball.mp hy
            simp only [Real.dist_eq, sub_zero] at this
            exact this.le
          rw [hq]
          simp only
          rw [hvanish y hy', zero_div]
        · have hopen : IsOpen (tsupport (ψ : ℝ → ℂ))ᶜ := (isClosed_tsupport _).isOpen_compl
          have hmem' : (tsupport (ψ : ℝ → ℂ))ᶜ ∈ nhds x := hopen.mem_nhds hmem
          filter_upwards [hmem'] with y hy
          rw [hq]
          simp only
          rw [hoff y hy, zero_div]
      exact (contDiffAt_const (c := (0 : ℂ))).congr_of_eventuallyEq hnbhd
    · have hinv : ContDiffAt ℝ ∞ (fun y : ℝ => (φ y)⁻¹) x :=
        (hφsmooth.contDiffAt (x := x)).inv hx
      have hmulc : ContDiffAt ℝ ∞ (fun y : ℝ => (ψ : ℝ → ℂ) y * (φ y)⁻¹) x :=
        ψ.smooth'.contDiffAt.mul hinv
      have heq : (fun y : ℝ => (ψ : ℝ → ℂ) y / φ y)
          = fun y : ℝ => (ψ : ℝ → ℂ) y * (φ y)⁻¹ := by
        funext y
        rw [div_eq_mul_inv]
      show ContDiffAt ℝ ∞ (fun y : ℝ => (ψ : ℝ → ℂ) y / φ y) x
      rw [heq]
      exact hmulc
  have hsupportq : Function.support q ⊆ tsupport (ψ : ℝ → ℂ) := by
    intro x hx
    by_contra hmem
    exact hx (by rw [hq]; simp only; rw [hoff x hmem, zero_div])
  have hcompactψ : IsCompact (tsupport (ψ : ℝ → ℂ)) := by
    refine Metric.isCompact_of_isClosed_isBounded (isClosed_tsupport _) ?_
    refine Bornology.IsBounded.subset ?_ hsupp
    exact Metric.isBounded_Ioo (-R) R
  have hcompact : HasCompactSupport q := by
    refine IsCompact.of_isClosed_subset hcompactψ (isClosed_closure) ?_
    exact closure_minimal hsupportq (isClosed_tsupport _)
  refine ⟨hcompact.toSchwartzMap hsmooth, ?_⟩
  funext x
  by_cases hx : φ x = 0
  · rw [hzero x hx, hx, zero_mul]
  · show (ψ : ℝ → ℂ) x = φ x * q x
    rw [hq]
    field_simp

/-- **Appendix I (27), the conclusion.**  A functional annihilated by every multiple of `φ`
annihilates every test function supported in the window and vanishing near the origin: it is
"supported at the origin" inside the window. -/
theorem connes_division_kills_local {X : Type*} [NormedAddCommGroup X] [NormedSpace ℂ X]
    (u : SchwartzMap ℝ ℂ →L[ℂ] X) (φ : ℝ → ℂ) {R : ℝ}
    (hφsmooth : ContDiff ℝ ∞ φ)
    (hφne : ∀ x : ℝ, x ∈ Ioo (-R) R → x ≠ 0 → φ x ≠ 0)
    (hmul : ∀ ψ χ : SchwartzMap ℝ ℂ,
      ((ψ : ℝ → ℂ) = fun x => φ x * (χ : ℝ → ℂ) x) → u ψ = 0)
    (ψ : SchwartzMap ℝ ℂ) (hsupp : tsupport (ψ : ℝ → ℂ) ⊆ Ioo (-R) R)
    (hvanish : ∃ δ > 0, ∀ x : ℝ, |x| ≤ δ → (ψ : ℝ → ℂ) x = 0) :
    u ψ = 0 := by
  obtain ⟨δ, hδ, hv⟩ := hvanish
  obtain ⟨χ, hχ⟩ := connes_schwartz_local_division φ hφsmooth hφne ψ hsupp hδ hv
  exact hmul ψ χ hχ

end

end GaloisForLFunctions.RHTower
