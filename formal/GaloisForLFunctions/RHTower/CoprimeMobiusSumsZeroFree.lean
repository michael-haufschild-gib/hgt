import GaloisForLFunctions.RHTower.ZetaMultipleLandauZeroFree

/-!
# Möbius sums over integers coprime to a set of primes

Let `E` be a set of primes, `μ_E(n) = μ(n)` for `n` free of `E` and `0` otherwise, and
`H_E(s) = Σ_{n E-smooth} n^{-s}` (all prime factors in `E`).  The divisor sum of `μ_E` is the
indicator of the `E`-smooth numbers, so `L(μ_E)·ζ = H_E` on `Re s > 1`.

**Theorem.**  Suppose `Σ_{n ≤ x} μ_E(n) = O(x^θ)` with `0 ≤ θ < 1`, and suppose the `E`-smooth
numbers are sparse at `s = 1` in the sense `(σ-1) H_E(σ) → 0` as `σ ↓ 1`.  Then
`H_E(σ) < ∞` for every `σ > θ`, and `ζ(s) ≠ 0` for every `Re s > θ`
(`summable_smooth_of_isBigO`, `riemannZeta_ne_zero_of_isBigO`).  By Hardy's theorem `θ ≥ 1/2`
(`half_le_of_isBigO`).

**Proof.**  Partial summation continues `F = L(μ_E)` to `Re s > θ`.  Sparsity forces `F(1) = 0`,
so `G = (F/(s-1))·(s-1)ζ` is holomorphic on `Re s > θ` and equals the nonnegative series `H_E`
right of `1`.  Landau's theorem pushes the abscissa of `H_E` down to `θ`; there `H_E` is an
absolutely convergent Euler product, hence nonzero, while `G = Fζ` vanishes at every zero of
`ζ`.

For `Σ_{p ∈ E} 1/p < ∞` the sparsity holds (`H_E(1) < ∞`), and the `E`-free integers form the
Beurling system generated by the primes outside `E`.  So no such system has Möbius sums
`O(x^{1/2-δ})`: the Hilberdink–Neamah conjecture (no `[1/2, 1/2, 0]` system) holds for every
Beurling system whose generators are rational primes (`not_isBigO_coprimeMobius_of_summable`).
-/

open Filter Topology Complex Asymptotics Set Metric ArithmeticFunction LSeries

noncomputable section

namespace RHTower

namespace CoprimeMobius

variable (E : Set ℕ)

/-- `n` is `E`-smooth: `n ≠ 0` and every prime factor of `n` lies in `E`. -/
def IsSmooth (n : ℕ) : Prop := n ≠ 0 ∧ ∀ p ∈ n.primeFactors, p ∈ E

/-- `n` is `E`-free: `n ≠ 0` and no prime factor of `n` lies in `E`. -/
def IsFree (n : ℕ) : Prop := n ≠ 0 ∧ ∀ p ∈ n.primeFactors, p ∉ E

open Classical in
/-- The indicator of the `E`-smooth numbers. -/
def smoothAF : ArithmeticFunction ℤ :=
  ⟨fun n => if IsSmooth E n then 1 else 0, by simp [IsSmooth]⟩

open Classical in
/-- The indicator of the `E`-free numbers. -/
def freeAF : ArithmeticFunction ℤ :=
  ⟨fun n => if IsFree E n then 1 else 0, by simp [IsFree]⟩

/-- The Möbius function restricted to the `E`-free numbers. -/
def mobiusAF : ArithmeticFunction ℤ := moebius.pmul (freeAF E)

theorem isSmooth_mul_iff {m n : ℕ} (hm : m ≠ 0) (hn : n ≠ 0) :
    IsSmooth E (m * n) ↔ IsSmooth E m ∧ IsSmooth E n := by
  simp only [IsSmooth, Nat.primeFactors_mul hm hn, Finset.mem_union, mul_ne_zero_iff]
  constructor
  · rintro ⟨_, h⟩; exact ⟨⟨hm, fun p hp => h p (Or.inl hp)⟩, ⟨hn, fun p hp => h p (Or.inr hp)⟩⟩
  · rintro ⟨⟨_, h1⟩, ⟨_, h2⟩⟩; exact ⟨⟨hm, hn⟩, fun p hp => hp.elim (h1 p) (h2 p)⟩

theorem isFree_mul_iff {m n : ℕ} (hm : m ≠ 0) (hn : n ≠ 0) :
    IsFree E (m * n) ↔ IsFree E m ∧ IsFree E n := by
  simp only [IsFree, Nat.primeFactors_mul hm hn, Finset.mem_union, mul_ne_zero_iff]
  constructor
  · rintro ⟨_, h⟩; exact ⟨⟨hm, fun p hp => h p (Or.inl hp)⟩, ⟨hn, fun p hp => h p (Or.inr hp)⟩⟩
  · rintro ⟨⟨_, h1⟩, ⟨_, h2⟩⟩; exact ⟨⟨hm, hn⟩, fun p hp => hp.elim (h1 p) (h2 p)⟩

theorem isSmooth_one : IsSmooth E 1 := ⟨one_ne_zero, by simp⟩

theorem isFree_one : IsFree E 1 := ⟨one_ne_zero, by simp⟩

theorem isSmooth_prime_pow {p k : ℕ} (hp : p.Prime) (hk : k ≠ 0) :
    IsSmooth E (p ^ k) ↔ p ∈ E := by
  simp [IsSmooth, Nat.primeFactors_pow _ hk, hp.primeFactors, hp.ne_zero]

theorem isFree_prime {p : ℕ} (hp : p.Prime) : IsFree E p ↔ p ∉ E := by
  simp [IsFree, hp.primeFactors, hp.ne_zero]

open Classical in
theorem smoothAF_apply (n : ℕ) : smoothAF E n = if IsSmooth E n then 1 else 0 := rfl

open Classical in
theorem freeAF_apply (n : ℕ) : freeAF E n = if IsFree E n then 1 else 0 := rfl

theorem isMultiplicative_smoothAF : (smoothAF E).IsMultiplicative := by
  classical
  refine ⟨by simp [smoothAF_apply, isSmooth_one], fun {m n} hmn => ?_⟩
  rcases eq_or_ne m 0 with rfl | hm
  · simp [smoothAF_apply, IsSmooth]
  rcases eq_or_ne n 0 with rfl | hn
  · simp [smoothAF_apply, IsSmooth]
  simp only [smoothAF_apply, isSmooth_mul_iff E hm hn]
  by_cases h1 : IsSmooth E m <;> by_cases h2 : IsSmooth E n <;> simp [h1, h2]

theorem isMultiplicative_freeAF : (freeAF E).IsMultiplicative := by
  classical
  refine ⟨by simp [freeAF_apply, isFree_one], fun {m n} hmn => ?_⟩
  rcases eq_or_ne m 0 with rfl | hm
  · simp [freeAF_apply, IsFree]
  rcases eq_or_ne n 0 with rfl | hn
  · simp [freeAF_apply, IsFree]
  simp only [freeAF_apply, isFree_mul_iff E hm hn]
  by_cases h1 : IsFree E m <;> by_cases h2 : IsFree E n <;> simp [h1, h2]

theorem isMultiplicative_mobiusAF : (mobiusAF E).IsMultiplicative :=
  isMultiplicative_moebius.pmul (isMultiplicative_freeAF E)

theorem mobiusAF_prime_pow_eq_zero {p k : ℕ} (hp : p.Prime) (hk : 2 ≤ k) :
    mobiusAF E (p ^ k) = 0 := by
  rw [mobiusAF, pmul_apply, moebius_apply_prime_pow hp (by omega)]
  simp [show k ≠ 1 by omega]

/-- **The divisor sum of the coprime Möbius function is the smooth indicator.** -/
theorem sum_divisors_mobiusAF (n : ℕ) : ∑ d ∈ n.divisors, mobiusAF E d = smoothAF E n := by
  classical
  rw [← coe_mul_zeta_apply]
  refine congrArg (fun f : ArithmeticFunction ℤ => f n) ?_
  refine ((isMultiplicative_mobiusAF E).mul isMultiplicative_zeta.natCast).eq_iff_eq_on_prime_powers
    _ _ (isMultiplicative_smoothAF E) |>.mpr fun p i hp => ?_
  rw [coe_mul_zeta_apply, Nat.sum_divisors_prime_pow hp]
  rcases Nat.eq_zero_or_pos i with rfl | hi
  · simp [(isMultiplicative_mobiusAF E).map_one, (isMultiplicative_smoothAF E).map_one]
  obtain ⟨k, rfl⟩ : ∃ k, i = k + 1 := ⟨i - 1, by omega⟩
  have htail : ∀ j : ℕ, ∑ x ∈ Finset.range (j + 2), mobiusAF E (p ^ x) =
      ∑ x ∈ Finset.range 2, mobiusAF E (p ^ x) := by
    intro j
    induction j with
    | zero => rfl
    | succ j ih =>
      rw [Finset.sum_range_succ, ih, mobiusAF_prime_pow_eq_zero E hp (by omega), add_zero]
  rw [htail k, smoothAF_apply, if_congr (isSmooth_prime_pow E hp (Nat.succ_ne_zero k)) rfl rfl]
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, zero_add, pow_zero, pow_one,
    mobiusAF, pmul_apply, moebius_apply_prime hp, freeAF_apply, if_congr (isFree_prime E hp) rfl rfl,
    if_pos (isFree_one E)]
  by_cases hpE : p ∈ E <;> simp [hpE]

/-! ### The analytic side -/

/-- The Möbius function restricted to the `E`-free numbers, as a real sequence. -/
def coprimeMobius (n : ℕ) : ℝ := (mobiusAF E n : ℝ)

/-- The indicator of the `E`-smooth numbers, as a complex sequence. -/
def smooth (n : ℕ) : ℂ := (smoothAF E n : ℂ)

theorem abs_coprimeMobius_le (n : ℕ) : |coprimeMobius E n| ≤ 1 := by
  classical
  rw [coprimeMobius, mobiusAF, pmul_apply, freeAF_apply]
  split_ifs
  · rw [mul_one, Int.cast_abs.symm]; exact_mod_cast abs_moebius_le_one
  · simp

theorem smooth_re_nonneg (n : ℕ) : 0 ≤ (smoothAF E n : ℝ) := by
  classical
  rw [smoothAF_apply]; split_ifs <;> norm_num

theorem smooth_eq_ofReal (n : ℕ) : smooth E n = ((smoothAF E n : ℝ) : ℂ) := by
  simp [smooth]

/-- `L(μ_E) · ζ = H_E` on `Re s > 1`. -/
theorem LSeries_coprimeMobius_mul_riemannZeta {s : ℂ} (hs : 1 < s.re) :
    LSeries (IntegerBeurling.countSeq (coprimeMobius E)) s * riemannZeta s =
      LSeries (smooth E) s := by
  have hconv : convolution (IntegerBeurling.countSeq (coprimeMobius E)) 1 = smooth E := by
    funext n
    rw [convolution_def]
    simp only [Pi.one_apply, mul_one]
    rw [Nat.sum_divisorsAntidiagonal (fun a _ => IntegerBeurling.countSeq (coprimeMobius E) a)]
    simp only [IntegerBeurling.countSeq, coprimeMobius, smooth, ← sum_divisors_mobiusAF E n]
    push_cast
    rfl
  rw [← LSeries_one_eq_riemannZeta hs, ← LSeries_convolution'
    (IntegerBeurling.summable_countSeq (abs_coprimeMobius_le E) hs)
    (LSeriesSummable_one_iff.mpr hs), hconv]

/-! ### The Euler product of `H_E` and the zeros of `ζ` -/

theorem smoothAF_mul (m n : ℕ) : smoothAF E (m * n) = smoothAF E m * smoothAF E n := by
  classical
  rcases eq_or_ne m 0 with rfl | hm
  · simp [smoothAF_apply, IsSmooth]
  rcases eq_or_ne n 0 with rfl | hn
  · simp [smoothAF_apply, IsSmooth]
  simp only [smoothAF_apply, isSmooth_mul_iff E hm hn]
  by_cases h1 : IsSmooth E m <;> by_cases h2 : IsSmooth E n <;> simp [h1, h2]

/-- `n ↦ 1_{E-smooth}(n) n^{-s}` is completely multiplicative. -/
def smoothSummandHom (s : ℂ) : ℕ →*₀ ℂ where
  toFun n := smooth E n * (n : ℂ) ^ (-s)
  map_zero' := by simp [smooth]
  map_one' := by
    classical
    simp [smooth, smoothAF_apply, isSmooth_one]
  map_mul' m n := by
    simp only [smooth, smoothAF_mul, Int.cast_mul, Nat.cast_mul]
    rw [show ((m : ℂ) * n) = ((m : ℝ) : ℂ) * ((n : ℝ) : ℂ) by push_cast; ring,
      mul_cpow_ofReal_nonneg m.cast_nonneg n.cast_nonneg]
    push_cast
    ring

/-- **`H_E` does not vanish where it converges absolutely.** -/
theorem LSeries_smooth_ne_zero {s : ℂ} (hsum : LSeriesSummable (smooth E) s) :
    LSeries (smooth E) s ≠ 0 := by
  have hterm : ∀ n, term (smooth E) s n = smoothSummandHom E s n := by
    intro n
    rcases eq_or_ne n 0 with rfl | hn
    · simp [smoothSummandHom, smooth, smoothAF_apply, IsSmooth]
    · rw [term_of_ne_zero hn, smoothSummandHom, MonoidWithZeroHom.coe_mk, ZeroHom.coe_mk,
        cpow_neg, div_eq_mul_inv]
  have hnorm : Summable fun n => ‖smoothSummandHom E s n‖ := by
    rw [summable_norm_iff, ← funext hterm]
    exact hsum
  rw [LSeries]
  simp_rw [hterm]
  rw [← EulerProduct.exp_tsum_primes_log_eq_tsum hnorm]
  exact Complex.exp_ne_zero _

theorem summable_smooth_two : LSeriesSummable (smooth E) 2 := by
  have h := IntegerBeurling.summable_countSeq (a := fun n => (smoothAF E n : ℝ))
    (fun n => by
      classical
      rw [smoothAF_apply]; split_ifs <;> norm_num) (s := 2) (by norm_num)
  convert h using 1
  funext n
  simp [IntegerBeurling.countSeq, smooth]

theorem smooth_fun_eq : (fun n => (((smoothAF E n : ℝ)) : ℂ)) = smooth E := by
  funext n; simp [smooth]

/-- **Landau's theorem moves the abscissa of `H_E` down to `θ`.** -/
theorem summable_smooth_of_isBigO {θ : ℝ} (hθ : 0 ≤ θ) (hθ1 : θ < 1)
    (hM : (fun x : ℝ => ∑ n ∈ Finset.Icc 1 ⌊x⌋₊, coprimeMobius E n) =O[atTop] fun x => x ^ θ)
    (hD : Tendsto (fun σ : ℝ => ((σ : ℂ) - 1) * LSeries (smooth E) σ) (𝓝[>] 1) (𝓝 0))
    {σ : ℝ} (hσ : θ < σ) : LSeriesSummable (smooth E) σ := by
  rw [← smooth_fun_eq E] at hD ⊢
  exact ZetaMultiple.summable_of_isBigO (abs_coprimeMobius_le E) (smooth_re_nonneg E)
    (by rw [smooth_fun_eq]; exact summable_smooth_two E)
    (fun s hs => by rw [smooth_fun_eq]; exact LSeries_coprimeMobius_mul_riemannZeta E hs)
    hθ hθ1 hM hD hσ

/-- **Main theorem.**  If the Möbius sums over the `E`-free integers are `O(x^θ)`,
`0 ≤ θ < 1`, and the `E`-smooth numbers are sparse at `s = 1`, then `ζ(s) ≠ 0` for
`Re s > θ`. -/
theorem riemannZeta_ne_zero_of_isBigO {θ : ℝ} (hθ : 0 ≤ θ) (hθ1 : θ < 1)
    (hM : (fun x : ℝ => ∑ n ∈ Finset.Icc 1 ⌊x⌋₊, coprimeMobius E n) =O[atTop] fun x => x ^ θ)
    (hD : Tendsto (fun σ : ℝ => ((σ : ℂ) - 1) * LSeries (smooth E) σ) (𝓝[>] 1) (𝓝 0))
    {z : ℂ} (hz : θ < z.re) : riemannZeta z ≠ 0 := by
  rw [← smooth_fun_eq E] at hD
  exact ZetaMultiple.riemannZeta_ne_zero_of_isBigO (abs_coprimeMobius_le E) (smooth_re_nonneg E)
    (by rw [smooth_fun_eq]; exact summable_smooth_two E)
    (fun s hs => by rw [smooth_fun_eq]; exact LSeries_coprimeMobius_mul_riemannZeta E hs)
    hθ hθ1 hM hD (fun s hs => by rw [smooth_fun_eq] at hs ⊢; exact LSeries_smooth_ne_zero E hs) hz

/-- **Möbius cancellation over `E`-free integers stops at the half power.**  Under the sparsity
of the `E`-smooth numbers, `Σ_{n ≤ x, n E-free} μ(n) = O(x^θ)` forces `θ ≥ 1/2`. -/
theorem half_le_of_isBigO
    (hD : Tendsto (fun σ : ℝ => ((σ : ℂ) - 1) * LSeries (smooth E) σ) (𝓝[>] 1) (𝓝 0))
    {θ : ℝ}
    (hM : (fun x : ℝ => ∑ n ∈ Finset.Icc 1 ⌊x⌋₊, coprimeMobius E n) =O[atTop] fun x => x ^ θ) :
    1 / 2 ≤ θ := by
  rw [← smooth_fun_eq E] at hD
  exact ZetaMultiple.half_le_of_isBigO (abs_coprimeMobius_le E) (smooth_re_nonneg E)
    (by rw [smooth_fun_eq]; exact summable_smooth_two E)
    (fun s hs => by rw [smooth_fun_eq]; exact LSeries_coprimeMobius_mul_riemannZeta E hs)
    (fun s hs => by rw [smooth_fun_eq] at hs ⊢; exact LSeries_smooth_ne_zero E hs) hD hM

/-! ### Thin deletions: `Σ_{p ∈ E} 1/p < ∞` -/

theorem inv_one_sub_le_exp {x : ℝ} (hx0 : 0 ≤ x) (hx : x ≤ 1 / 2) :
    (1 - x)⁻¹ ≤ Real.exp (2 * x) := by
  have h1 : 0 < 1 - x := by linarith
  rw [inv_eq_one_div, div_le_iff₀ h1]
  have := Real.add_one_le_exp (2 * x)
  nlinarith

theorem one_div_cast_pow (p k : ℕ) : (1 : ℝ) / ((p ^ k : ℕ) : ℝ) = ((1 : ℝ) / p) ^ k := by
  push_cast
  rw [one_div_pow]

theorem one_div_prime_lt_one {p : ℕ} (hp : p.Prime) : (1 : ℝ) / p < 1 := by
  have h2 : (2 : ℝ) ≤ p := by exact_mod_cast hp.two_le
  rw [div_lt_one (by linarith)]
  linarith

theorem summable_norm_one_div_prime_pow {p : ℕ} (hp : p.Prime) :
    Summable fun k : ℕ => ‖(1 : ℝ) / ((p ^ k : ℕ) : ℝ)‖ := by
  have hfun : (fun k : ℕ => ‖(1 : ℝ) / ((p ^ k : ℕ) : ℝ)‖) = fun k => ((1 : ℝ) / p) ^ k := by
    funext k
    rw [one_div_cast_pow, Real.norm_of_nonneg (by positivity)]
  rw [hfun]
  exact summable_geometric_of_lt_one (by positivity) (one_div_prime_lt_one hp)

/-- The local factor `Σ_k p^{-k} = (1 - 1/p)⁻¹ ≤ exp(2/p)`. -/
theorem tsum_one_div_prime_pow_le {p : ℕ} (hp : p.Prime) :
    ∑' k : ℕ, (1 : ℝ) / ((p ^ k : ℕ) : ℝ) ≤ Real.exp (2 * ((1 : ℝ) / p)) := by
  have h2 : (2 : ℝ) ≤ p := by exact_mod_cast hp.two_le
  have hfun : (fun k : ℕ => (1 : ℝ) / ((p ^ k : ℕ) : ℝ)) = fun k => ((1 : ℝ) / p) ^ k :=
    funext fun k => one_div_cast_pow p k
  rw [hfun, tsum_geometric_of_lt_one (by positivity) (one_div_prime_lt_one hp)]
  exact inv_one_sub_le_exp (by positivity)
    (by rw [div_le_div_iff₀ (by linarith) (by norm_num)]; linarith)

theorem mem_factoredNumbers_of_isSmooth [DecidablePred (· ∈ E)] {N n : ℕ} (hnN : n < N)
    (hn : IsSmooth E n) : n ∈ Nat.factoredNumbers ((Finset.range N).filter (· ∈ E)) := by
  refine Nat.mem_factoredNumbers.mpr ⟨hn.1, fun p hp => ?_⟩
  rw [Finset.mem_filter, Finset.mem_range]
  exact ⟨lt_of_le_of_lt (Nat.le_of_mem_primeFactorsList hp) hnN,
    hn.2 p (Nat.mem_primeFactors_iff_mem_primeFactorsList.mpr hp)⟩

/-- The `E`-smooth reciprocals below `N` are bounded by the Euler product over `E ∩ [0, N)`. -/
theorem sum_range_smooth_div_le [DecidablePred (· ∈ E)] (N : ℕ) :
    ∑ i ∈ Finset.range N, (smoothAF E i : ℝ) / i ≤
      ∏ p ∈ (Finset.range N).filter (· ∈ E) with p.Prime,
        ∑' k : ℕ, (1 : ℝ) / ((p ^ k : ℕ) : ℝ) := by
  classical
  set s : Finset ℕ := (Finset.range N).filter (· ∈ E) with hs
  have hmul : ∀ {m n : ℕ}, m.Coprime n → (fun n : ℕ => (1 : ℝ) / n) (m * n) =
      (fun n : ℕ => (1 : ℝ) / n) m * (fun n : ℕ => (1 : ℝ) / n) n := by
    intro m n _
    simp only [Nat.cast_mul]
    rw [one_div_mul_one_div]
  have hhas := (EulerProduct.summable_and_hasSum_factoredNumbers_prod_filter_prime_tsum
    (f := fun n : ℕ => (1 : ℝ) / n) (by norm_num) hmul
    (fun hp => summable_norm_one_div_prime_pow hp) s).2
  have hsub : ∀ n ∈ (Finset.range N).filter (IsSmooth E), n ∈ Nat.factoredNumbers s := by
    intro n hn
    rw [Finset.mem_filter, Finset.mem_range] at hn
    exact mem_factoredNumbers_of_isSmooth E hn.1 hn.2
  have hrange : ∑ i ∈ Finset.range N, (smoothAF E i : ℝ) / i =
      ∑ i ∈ (Finset.range N).filter (IsSmooth E), (1 : ℝ) / i := by
    rw [Finset.sum_filter]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [smoothAF_apply]
    split_ifs <;> simp
  rw [hrange, ← Finset.sum_subtype_of_mem (fun i : ℕ => (1 : ℝ) / i) hsub]
  exact sum_le_hasSum _ (fun i _ => by positivity) hhas

/-- **`Σ_{p ∈ E} 1/p < ∞` makes the reciprocals of the `E`-smooth numbers summable.**  Every
`E`-smooth `n < N` is factored over the finite set `E ∩ [0, N)`, whose Euler product is
`∏ (1 - 1/p)⁻¹ ≤ exp(2 Σ_{p ∈ E} 1/p)`. -/
theorem summable_smooth_div
    (hE : Summable ({p : ℕ | p.Prime ∧ p ∈ E}.indicator fun p => (1 : ℝ) / p)) :
    Summable fun n : ℕ => (smoothAF E n : ℝ) / n := by
  classical
  set g : ℕ → ℝ := {p : ℕ | p.Prime ∧ p ∈ E}.indicator fun p => (1 : ℝ) / p with hg
  have hg0 : ∀ p, 0 ≤ g p := fun p =>
    Set.indicator_nonneg (fun p _ => by positivity) p
  refine summable_of_sum_range_le (c := Real.exp (2 * ∑' p, g p))
    (fun n => div_nonneg (smooth_re_nonneg E n) n.cast_nonneg) fun N => ?_
  set s : Finset ℕ := (Finset.range N).filter (· ∈ E) with hs
  have hfactor : ∀ p ∈ Finset.filter (fun p => p.Prime) s,
      ∑' k : ℕ, (1 : ℝ) / ((p ^ k : ℕ) : ℝ) ≤ Real.exp (2 * g p) := by
    intro p hp
    rw [Finset.mem_filter, hs, Finset.mem_filter] at hp
    have hgp : g p = 1 / p := by
      rw [hg, Set.indicator_of_mem (show p ∈ {p : ℕ | p.Prime ∧ p ∈ E} from ⟨hp.2, hp.1.2⟩)]
    rw [hgp]
    exact tsum_one_div_prime_pow_le hp.2
  have hprod : ∏ p ∈ s with p.Prime, ∑' k : ℕ, (1 : ℝ) / ((p ^ k : ℕ) : ℝ) ≤
      Real.exp (2 * ∑ p ∈ s with p.Prime, g p) := by
    rw [Finset.mul_sum, Real.exp_sum]
    exact Finset.prod_le_prod (fun p _ => tsum_nonneg fun k => by positivity) hfactor
  have hgsum : ∑ p ∈ s with p.Prime, g p ≤ ∑' p, g p :=
    hE.sum_le_tsum _ (fun p _ => hg0 p)
  calc ∑ i ∈ Finset.range N, (smoothAF E i : ℝ) / i
      ≤ ∏ p ∈ s with p.Prime, ∑' k : ℕ, (1 : ℝ) / ((p ^ k : ℕ) : ℝ) := sum_range_smooth_div_le E N
    _ ≤ Real.exp (2 * ∑ p ∈ s with p.Prime, g p) := hprod
    _ ≤ Real.exp (2 * ∑' p, g p) := Real.exp_le_exp.mpr (by linarith)

/-- **Thin deletions keep the `E`-smooth numbers sparse at `s = 1`.** -/
theorem tendsto_sub_one_mul_LSeries_smooth
    (hE : Summable ({p : ℕ | p.Prime ∧ p ∈ E}.indicator fun p => (1 : ℝ) / p)) :
    Tendsto (fun σ : ℝ => ((σ : ℂ) - 1) * LSeries (smooth E) σ) (𝓝[>] 1) (𝓝 0) := by
  rw [← smooth_fun_eq E]
  exact ZetaMultiple.tendsto_sub_one_mul_LSeries_of_summable (smooth_re_nonneg E)
    (summable_smooth_div E hE)

/-- **A prime-deleted Mertens bound is a zero-free region.**  If `Σ_{p ∈ E} 1/p < ∞` and the
Möbius sums over the `E`-free integers are `O(x^θ)`, `0 ≤ θ < 1`, then `ζ(s) ≠ 0` for
`Re s > θ`. -/
theorem riemannZeta_ne_zero_of_isBigO_of_summable
    (hE : Summable ({p : ℕ | p.Prime ∧ p ∈ E}.indicator fun p => (1 : ℝ) / p))
    {θ : ℝ} (hθ : 0 ≤ θ) (hθ1 : θ < 1)
    (hM : (fun x : ℝ => ∑ n ∈ Finset.Icc 1 ⌊x⌋₊, coprimeMobius E n) =O[atTop] fun x => x ^ θ)
    {z : ℂ} (hz : θ < z.re) : riemannZeta z ≠ 0 :=
  riemannZeta_ne_zero_of_isBigO E hθ hθ1 hM (tendsto_sub_one_mul_LSeries_smooth E hE) hz

/-- **Hilberdink–Neamah for prime-generated Beurling systems.**  Let the generalized primes be
the rational primes outside `E`, with `Σ_{p ∈ E} 1/p < ∞` (so the generalized integers, the
`E`-free numbers, have positive density).  Then the Möbius sums of the system are never
`O(x^θ)` with `θ < 1/2`.  In particular no such system is a `[1/2, 1/2, 0]`-system. -/
theorem not_isBigO_coprimeMobius_of_summable
    (hE : Summable ({p : ℕ | p.Prime ∧ p ∈ E}.indicator fun p => (1 : ℝ) / p))
    {θ : ℝ} (hθ : θ < 1 / 2) :
    ¬ (fun x : ℝ => ∑ n ∈ Finset.Icc 1 ⌊x⌋₊, coprimeMobius E n) =O[atTop] fun x => x ^ θ :=
  fun hM => absurd (half_le_of_isBigO E (tendsto_sub_one_mul_LSeries_smooth E hE) hM)
    (not_le.mpr hθ)

end CoprimeMobius

end RHTower
