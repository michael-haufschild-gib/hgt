import GaloisForLFunctions.RHTower.WeilPositivityRoughRandomPrimes

/-!
# No producer has a positive floor on a sparse multiplicative set

Let `P'` be a set of primes such that `(y, 2y]` contains at least `√y (log y)²` primes of `P'`
for arbitrarily large `y`.  The theorem `not_floor_of_sparse_primes` says that no full-cone
Weil-positive weight system satisfies `lam(n) ≥ c > 0` on every squarefree `n ≥ 2` whose prime
factors all lie in `P'`.

The relative density of `P'` among the primes may be as small as `(log y)³/√y`.  The floor is
imposed only on the multiplicative set generated by `P'`; the weights are unrestricted at every
other integer, including all primes outside `P'`.

**Proof.**
* Take `S` = the primes of `P'` in `(y, 2y]` and `N = ∏_{p ∈ S} p`.
* The divisor resonance law gives `2c (Q_S - 1) ≤ log N + C₀`
  (`floor_resonance_inequality`), where `Q_S = ∏_{p ∈ S}(1 + p^{-1/2}/2)`.
* The product satisfies `Q_S ≥ exp(|S| (2y)^{-1/2}/4) ≥ exp((log y)²/(4√2))`.
* This is superpolynomial in `y`, while `log N ≤ |S| log 2y ≤ 16 y² · (|S|(2y)^{-1/2}/4)`.
-/

open Finset Filter

namespace RHTower
namespace SparsePrimeFloor

open PrimorialResonance CramerModel RoughRandomPrimes

/-- **Resonance inequality for an arbitrary prime set.**  If Weil-positive weights satisfy
`lam(n) ≥ c` on every squarefree `n ≥ 2` whose prime factors lie in `S` (a finite set of primes),
then `2c (Q_S - 1) ≤ log ∏_{p ∈ S} p + C₀`, with `Q_S = ∏_{p ∈ S}(1 + p^{-1/2}/2)`. -/
theorem floor_resonance_inequality {lam : ℕ → ℝ} (hW : WeilPositive lam) :
    ∃ C₀ : ℝ, ∀ S : Finset ℕ, (∀ p ∈ S, p.Prime) → ∀ c : ℝ, 0 ≤ c →
      (∀ n ∈ (∏ p ∈ S, p).divisors, 2 ≤ n → c ≤ lam n) →
      2 * c * (setProduct S - 1) ≤ Real.log (∏ p ∈ S, p : ℕ) + C₀ := by
  obtain ⟨C₀, hC⟩ := weil_divisor_resonance_bound hW
  refine ⟨C₀, fun S hS c hc hlow => ?_⟩
  set N := ∏ p ∈ S, p with hNdef
  have hN : 1 ≤ N := Nat.one_le_iff_ne_zero.mpr (prod_ne_zero_iff.mpr fun p hp => (hS p hp).ne_zero)
  have h := hC N hN
  have hterm : ∀ n ∈ N.divisors.filter (fun n => 2 ≤ n),
      c * ((n : ℝ) ^ (-(1 / 2 : ℝ)) * ((N / n).divisors.card : ℝ)) ≤
        lam n / Real.sqrt n * ((N / n).divisors.card : ℝ) := by
    intro n hn
    obtain ⟨hnd, h2⟩ := mem_filter.mp hn
    have hn0 : (0 : ℝ) < n := by exact_mod_cast (show 0 < n by omega)
    have hs : (n : ℝ) ^ (-(1 / 2 : ℝ)) = 1 / Real.sqrt n := by
      rw [Real.rpow_neg hn0.le, Real.sqrt_eq_rpow]; exact (one_div _).symm
    have hsp : 0 < Real.sqrt n := Real.sqrt_pos.mpr hn0
    have hcard : (0 : ℝ) ≤ ((N / n).divisors.card : ℝ) := Nat.cast_nonneg _
    rw [hs, ← mul_assoc, mul_one_div]
    exact mul_le_mul_of_nonneg_right (div_le_div_of_nonneg_right (hlow n hnd h2) hsp.le) hcard
  have hlower := sum_le_sum hterm
  rw [← mul_sum, sum_divisors_two_le_eq _ hN, resonanceMass_half_prod_primes hS,
    card_divisors_prod_primes hS] at hlower
  rw [card_divisors_prod_primes hS] at h
  have hq : (0 : ℝ) < 2 ^ S.card := by positivity
  have key : 2 * c * (2 ^ S.card * setProduct S - 2 ^ S.card) ≤
      (Real.log N + C₀) * 2 ^ S.card := by linarith
  have : 2 * c * (setProduct S - 1) * 2 ^ S.card ≤ (Real.log N + C₀) * 2 ^ S.card := by
    calc 2 * c * (setProduct S - 1) * 2 ^ S.card
        = 2 * c * (2 ^ S.card * setProduct S - 2 ^ S.card) := by ring
      _ ≤ (Real.log N + C₀) * 2 ^ S.card := key
  exact le_of_mul_le_mul_right this hq

/-- Arithmetic core: if `u ≥ u₀ ≥ 1`, `c e^{u₀/2} ≥ B + 2c + |C₀| + 1` and `R ≤ u B`, then
`R + C₀ < 2c (e^u - 1)`. -/
theorem lt_of_exp_aux {c u u₀ B R C₀ : ℝ} (hc : 0 < c) (hu : u₀ ≤ u) (hu₀ : 1 ≤ u₀)
    (_hB : 0 ≤ B) (hbig : B + 2 * c + |C₀| + 1 ≤ c * Real.exp (u₀ / 2)) (hR : R ≤ u * B) :
    R + C₀ < 2 * c * (Real.exp u - 1) := by
  have hu1 : 1 ≤ u := hu₀.trans hu
  have hsplit : Real.exp u = Real.exp (u / 2) * Real.exp (u / 2) := by
    rw [← Real.exp_add]; ring_nf
  have h1 : u / 2 + 1 ≤ Real.exp (u / 2) := Real.add_one_le_exp _
  have h2 : Real.exp (u₀ / 2) ≤ Real.exp (u / 2) := Real.exp_le_exp.mpr (by linarith)
  have hE0 : 0 < Real.exp (u₀ / 2) := Real.exp_pos _
  have hexp : Real.exp (u₀ / 2) * (u / 2) ≤ Real.exp u := by
    rw [hsplit]
    have : Real.exp (u₀ / 2) * (u / 2) ≤ Real.exp (u / 2) * (u / 2 + 1) :=
      mul_le_mul h2 (by linarith) (by linarith) (Real.exp_pos _).le
    calc Real.exp (u₀ / 2) * (u / 2) ≤ Real.exp (u / 2) * (u / 2 + 1) := this
      _ ≤ Real.exp (u / 2) * Real.exp (u / 2) :=
          mul_le_mul_of_nonneg_left h1 (Real.exp_pos _).le
  -- 2c(e^u - 1) ≥ c e^{u₀/2} u - 2c ≥ u (B + 2c + |C₀| + 1) - 2c
  have h3 : c * Real.exp (u₀ / 2) * u - 2 * c ≤ 2 * c * (Real.exp u - 1) := by
    have := mul_le_mul_of_nonneg_left hexp (show 0 ≤ 2 * c by linarith)
    nlinarith
  have h4 : u * (B + 2 * c + |C₀| + 1) ≤ c * Real.exp (u₀ / 2) * u := by
    have := mul_le_mul_of_nonneg_left hbig (show 0 ≤ u by linarith)
    linarith
  have h5 : u * B + |C₀| + 1 ≤ u * (B + 2 * c + |C₀| + 1) - 2 * c := by
    have : (1 : ℝ) * (2 * c + |C₀| + 1) ≤ u * (2 * c + |C₀| + 1) :=
      mul_le_mul_of_nonneg_right hu1 (by positivity)
    nlinarith
  have hC : C₀ ≤ |C₀| := le_abs_self C₀
  linarith

theorem eventually_sparse_aux (c C₀ : ℝ) (hc : 0 < c) :
    ∀ᶠ y : ℕ in atTop, 1 ≤ Real.log y ^ 2 / (4 * Real.sqrt 2) ∧
      16 * (y : ℝ) ^ 2 + 2 * c + |C₀| + 1 ≤ c * Real.exp (Real.log y ^ 2 / (4 * Real.sqrt 2) / 2) := by
  have hs2 : 0 < Real.sqrt 2 := Real.sqrt_pos.mpr (by norm_num)
  have hs2' : Real.sqrt 2 ≤ 2 := by
    rw [Real.sqrt_le_left (by norm_num)]; norm_num
  have hlog : Tendsto (fun y : ℕ => Real.log y) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  filter_upwards [hlog.eventually_ge_atTop (48 : ℝ),
    (tendsto_natCast_atTop_atTop (R := ℝ)).eventually_ge_atTop
      ((16 + 2 * c + |C₀| + 1) / c + 1)] with y hy1 hy2
  have hyr : (1 : ℝ) ≤ y := by
    have : (0 : ℝ) ≤ (16 + 2 * c + |C₀| + 1) / c := by positivity
    linarith
  have hy0 : (0 : ℝ) < y := by linarith
  have hly : 0 ≤ Real.log y := Real.log_nonneg hyr
  refine ⟨?_, ?_⟩
  · rw [le_div_iff₀ (by positivity)]
    nlinarith
  · -- exp(log² y /(8√2)) ≥ exp(3 log y) = y³
    have hq : 3 * Real.log y ≤ Real.log y ^ 2 / (4 * Real.sqrt 2) / 2 := by
      rw [div_div, le_div_iff₀ (by positivity)]
      have : 3 * (4 * Real.sqrt 2 * 2) ≤ Real.log y := by nlinarith
      nlinarith
    have hcube : (y : ℝ) ^ 3 ≤ Real.exp (Real.log y ^ 2 / (4 * Real.sqrt 2) / 2) := by
      calc (y : ℝ) ^ 3 = Real.exp (3 * Real.log y) := by
            rw [show 3 * Real.log y = Real.log ((y : ℝ) ^ 3) by rw [Real.log_pow]; norm_num,
              Real.exp_log (by positivity)]
        _ ≤ _ := Real.exp_le_exp.mpr hq
    have hlin : 16 + 2 * c + |C₀| + 1 ≤ c * y := by
      have := (div_le_iff₀ hc).mp (show (16 + 2 * c + |C₀| + 1) / c ≤ y by linarith)
      linarith
    have hy2' : (y : ℝ) ^ 2 * (16 + 2 * c + |C₀| + 1) ≤ c * (y : ℝ) ^ 3 := by
      have := mul_le_mul_of_nonneg_left hlin (sq_nonneg (y : ℝ))
      nlinarith
    have hy22 : (1 : ℝ) ≤ (y : ℝ) ^ 2 := by nlinarith
    have hC : 0 ≤ 2 * c + |C₀| + 1 := by positivity
    have : 16 * (y : ℝ) ^ 2 + 2 * c + |C₀| + 1 ≤ (y : ℝ) ^ 2 * (16 + 2 * c + |C₀| + 1) := by
      nlinarith
    calc 16 * (y : ℝ) ^ 2 + 2 * c + |C₀| + 1 ≤ c * (y : ℝ) ^ 3 := this.trans hy2'
      _ ≤ c * Real.exp (Real.log y ^ 2 / (4 * Real.sqrt 2) / 2) :=
          mul_le_mul_of_nonneg_left hcube hc.le

/-- **No producer has a positive floor on a sparse multiplicative set.**  Let `P'` be a set of
primes containing at least `√y (log y)²` primes in `(y, 2y]` for arbitrarily large `y`.  Then no
full-cone Weil-positive weight system is bounded below by a positive constant on the squarefree
integers `n ≥ 2` all of whose prime factors lie in `P'`.  The resonator `1_{m ∣ N}`,
`N = ∏_{p ∈ S} p` for `S` the primes of `P'` in `(y, 2y]`, has
`Q_S ≥ exp(|S| (2y)^{-1/2}/4) ≥ exp((log y)²/(4√2))`, which beats `log N ≤ |S| log 2y`. -/
theorem not_floor_of_sparse_primes {lam : ℕ → ℝ} (hW : WeilPositiveFull lam) {P' : Set ℕ}
    {c : ℝ} (hc : 0 < c)
    (hfloor : ∀ n, 2 ≤ n → Squarefree n → (∀ p, p.Prime → p ∣ n → p ∈ P') → c ≤ lam n)
    (hdense : ∀ Y : ℕ, ∃ y ≥ Y, ∃ S : Finset ℕ,
      (∀ p ∈ S, p.Prime ∧ p ∈ P' ∧ y < p ∧ p ≤ 2 * y) ∧
      Real.sqrt y * Real.log y ^ 2 ≤ S.card) : False := by
  obtain ⟨C₀, hC⟩ := floor_resonance_inequality (weilPositive_of_weilPositiveFull hW)
  obtain ⟨Y, hY⟩ := eventually_atTop.mp ((eventually_sparse_aux c C₀ hc).and
    (eventually_ge_atTop 1))
  obtain ⟨y, hyY, S, hS, hcard⟩ := hdense Y
  obtain ⟨⟨hu₀, hbig⟩, hy1⟩ := hY y hyY
  have hSp : ∀ p ∈ S, p.Prime := fun p hp => (hS p hp).1
  set N := ∏ p ∈ S, p with hNdef
  have hN : N ≠ 0 := prod_ne_zero_iff.mpr fun p hp => (hSp p hp).ne_zero
  have hsq : Squarefree N := squarefree_prod_primes hSp
  have hlow : ∀ n ∈ N.divisors, 2 ≤ n → c ≤ lam n := by
    intro n hn h2
    have hdn := Nat.dvd_of_mem_divisors hn
    refine hfloor n h2 (hsq.squarefree_of_dvd hdn) fun q hq hqn => ?_
    exact (hS q (mem_of_prime_dvd_prod hSp hq (hqn.trans hdn))).2.1
  have hineq := hC S hSp c hc.le hlow
  have hyr : (1 : ℝ) ≤ y := by exact_mod_cast hy1
  have h2y : (0 : ℝ) < 2 * y := by linarith
  -- log N ≤ |S| log 2y
  have hlogN : Real.log N ≤ S.card * Real.log (2 * y) := by
    rw [hNdef, Nat.cast_prod, Real.log_prod (fun p hp => by exact_mod_cast (hSp p hp).ne_zero)]
    calc ∑ p ∈ S, Real.log (p : ℝ) ≤ ∑ _p ∈ S, Real.log (2 * y) := by
          refine sum_le_sum fun p hp => ?_
          obtain ⟨hpr, -, -, hp2⟩ := hS p hp
          exact Real.log_le_log (by exact_mod_cast hpr.pos) (by exact_mod_cast hp2)
      _ = S.card * Real.log (2 * y) := by rw [sum_const, nsmul_eq_mul]
  -- Q_S ≥ exp(u)
  set u : ℝ := S.card * (2 * (y : ℝ)) ^ (-(1 / 2 : ℝ)) / 4 with hudef
  have hQ : Real.exp u ≤ setProduct S :=
    exp_le_setProduct hSp fun p hp => by exact_mod_cast (hS p hp).2.2.2
  have hs2y : (2 * (y : ℝ)) ^ (-(1 / 2 : ℝ)) = 1 / Real.sqrt (2 * y) := by
    rw [Real.rpow_neg h2y.le, Real.sqrt_eq_rpow]; exact (one_div _).symm
  have hsq2y : Real.sqrt (2 * y) = Real.sqrt 2 * Real.sqrt y := Real.sqrt_mul (by norm_num) _
  have hsy : 0 < Real.sqrt (y : ℝ) := Real.sqrt_pos.mpr (by linarith)
  have hs2 : 0 < Real.sqrt 2 := Real.sqrt_pos.mpr (by norm_num)
  have hu : Real.log y ^ 2 / (4 * Real.sqrt 2) ≤ u := by
    rw [hudef, hs2y, hsq2y]
    rw [div_le_div_iff₀ (by positivity) (by norm_num)]
    have h := mul_le_mul_of_nonneg_right hcard (show 0 ≤ 1 / (Real.sqrt 2 * Real.sqrt y) by
      positivity)
    have heq : Real.sqrt y * Real.log y ^ 2 * (1 / (Real.sqrt 2 * Real.sqrt y)) =
        Real.log y ^ 2 / Real.sqrt 2 := by field_simp
    rw [heq] at h
    have : Real.log y ^ 2 * 4 ≤ (S.card : ℝ) * (1 / (Real.sqrt 2 * Real.sqrt y)) *
        (4 * Real.sqrt 2) := by
      have := mul_le_mul_of_nonneg_right h (show 0 ≤ 4 * Real.sqrt 2 by positivity)
      calc Real.log y ^ 2 * 4 = Real.log y ^ 2 / Real.sqrt 2 * (4 * Real.sqrt 2) := by
            field_simp
        _ ≤ _ := this
    linarith
  -- B := 4 √(2y) log 2y ≤ 16 y²
  set B : ℝ := 4 * Real.sqrt (2 * y) * Real.log (2 * y) with hBdef
  have hB0 : 0 ≤ B := by
    have := Real.log_nonneg (show (1 : ℝ) ≤ 2 * y by linarith)
    positivity
  have hBle : B ≤ 16 * (y : ℝ) ^ 2 := by
    have hsq_le : Real.sqrt (2 * y) ≤ 2 * y := by
      rw [Real.sqrt_le_left (by positivity)]; nlinarith
    have hlog_le : Real.log (2 * y) ≤ 2 * y := by
      have := Real.log_le_sub_one_of_pos h2y; linarith
    have hl0 := Real.log_nonneg (show (1 : ℝ) ≤ 2 * y by linarith)
    calc B = 4 * Real.sqrt (2 * y) * Real.log (2 * y) := rfl
      _ ≤ 4 * (2 * y) * (2 * y) :=
          mul_le_mul (mul_le_mul_of_nonneg_left hsq_le (by norm_num)) hlog_le hl0 (by positivity)
      _ = 16 * (y : ℝ) ^ 2 := by ring
  have hR : (S.card : ℝ) * Real.log (2 * y) ≤ u * B := by
    rw [hudef, hBdef, hs2y]
    have hne : Real.sqrt (2 * (y : ℝ)) ≠ 0 := (Real.sqrt_pos.mpr h2y).ne'
    have : (S.card : ℝ) * (1 / Real.sqrt (2 * y)) / 4 * (4 * Real.sqrt (2 * y) * Real.log (2 * y)) =
        S.card * Real.log (2 * y) := by field_simp
    linarith
  have hfin := lt_of_exp_aux (R := (S.card : ℝ) * Real.log (2 * y)) (C₀ := C₀) hc hu hu₀ hB0
    (by linarith) hR
  have hchain : Real.log N + C₀ ≤ S.card * Real.log (2 * y) + C₀ := by linarith
  have hQ' : 2 * c * (Real.exp u - 1) ≤ 2 * c * (setProduct S - 1) :=
    mul_le_mul_of_nonneg_left (by linarith) (by linarith)
  linarith

end SparsePrimeFloor

end RHTower
