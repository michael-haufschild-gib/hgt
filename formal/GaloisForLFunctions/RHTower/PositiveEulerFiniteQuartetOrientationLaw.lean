import GaloisForLFunctions.RHTower.HypertranscendentalFiniteQuartetWardIndex
import GaloisForLFunctions.RHTower.PositivePrimeDensityMobiusInversion
import GaloisForLFunctions.RHTower.WeilIndexBudgetBridge
import GaloisForLFunctions.HTGeometry.ZetaJetFreeness

/-!
# Positive Euler realization of arbitrary finite off-line quartet packets

The one-quartet positive prime-density inversion is stable under finite
superposition.  Hence every finite packet of centered FE--Schwarz quartets
inside the radius-one-half disc is generated by one locally finite
nonnegative continuous generalized-prime density.

The same packet has:

* strictly positive unsquared Cauchy orientation at every common regular
  first-quadrant probe;
* Ward mass `8π` per quartet;
* pole-order excess two per quartet.

Consequently its Ward charge is exactly `4π` times its pole-order excess.
The law makes the missing direction in a Julia/Cauchy proof explicit:
positive Euler source data produce the positive, not the excluding, oriented
response.
-/

open Complex Filter MeasureTheory Real
open scoped BigOperators

noncomputable section

namespace RHTower

open GaloisForLFunctions
open GaloisForLFunctions.HTGeometry

/-- Prime density of a finite packet of centered off-line quartets. -/
def finiteQuartetPrimeLogDensity {ι : Type*} [Fintype ι]
    (a gam : ι → ℝ) (u : ℝ) : ℝ :=
  ∑ i, quartetPrimeLogDensity (a i) (gam i) u

/-- Prime-power density of the same packet. -/
def finiteQuartetPrimePowerLogDensity {ι : Type*} [Fintype ι]
    (a gam : ι → ℝ) (u : ℝ) : ℝ :=
  ∑ i, quartetPrimePowerLogDensity (a i) (gam i) u

theorem finiteQuartetPrimeLogDensity_measurable
    {ι : Type*} [Fintype ι] {a gam : ι → ℝ}
    (ha : ∀ i, 0 < a i) (hgam : ∀ i, gam i ≠ 0)
    (hradius : ∀ i, a i ^ 2 + gam i ^ 2 ≤ 1 / 4) :
    Measurable (finiteQuartetPrimeLogDensity a gam) := by
  classical
  unfold finiteQuartetPrimeLogDensity
  exact Finset.measurable_fun_sum Finset.univ fun i _ =>
    quartetPrimeLogDensity_measurable (ha i) (hgam i) (hradius i)

theorem finiteQuartetPrimeLogDensity_nonneg
    {ι : Type*} [Fintype ι] {a gam : ι → ℝ}
    (ha : ∀ i, 0 < a i) (hgam : ∀ i, gam i ≠ 0)
    (hradius : ∀ i, a i ^ 2 + gam i ^ 2 ≤ 1 / 4)
    {u : ℝ} (hu : 0 ≤ u) :
    0 ≤ finiteQuartetPrimeLogDensity a gam u := by
  classical
  unfold finiteQuartetPrimeLogDensity
  exact Finset.sum_nonneg fun i _ =>
    quartetPrimeLogDensity_nonneg (ha i) (hgam i) (hradius i) hu

theorem integrableOn_finiteQuartetPrimeLogDensity_Icc
    {ι : Type*} [Fintype ι] {a gam : ι → ℝ}
    (ha : ∀ i, 0 < a i) (hgam : ∀ i, gam i ≠ 0)
    (hradius : ∀ i, a i ^ 2 + gam i ^ 2 ≤ 1 / 4)
    (R : ℝ) :
    IntegrableOn (finiteQuartetPrimeLogDensity a gam)
      (Set.Icc 0 R) volume := by
  classical
  unfold finiteQuartetPrimeLogDensity
  induction (Finset.univ : Finset ι) using Finset.induction_on with
  | empty =>
      simp
  | @insert i s hi ih =>
      have hiint :=
        integrableOn_quartetPrimeLogDensity_Icc
          (ha i) (hgam i) (hradius i) (R := R)
      simpa [Finset.sum_insert hi] using! hiint.add ih

/-- The prime-power series of one positive quartet density is absolutely
summable at every nonnegative logarithmic coordinate. -/
theorem summable_primePowerDensityTransform_quartetPrimeLogDensity
    {a gam u : ℝ} (ha : 0 < a) (hgam : gam ≠ 0)
    (hradius : a ^ 2 + gam ^ 2 ≤ 1 / 4) (hu : 0 ≤ u) :
    Summable (fun n : ℕ+ =>
      1 / (n : ℝ) ^ 2 * quartetPrimeLogDensity a gam (u / n)) := by
  let Z : ℝ := ∑' n : ℕ+, 1 / (n : ℝ) ^ 2
  let g : ℝ → ℝ := quartetPrimePowerLogDensity a gam
  have hz : Summable (fun n : ℕ+ => 1 / (n : ℝ) ^ 2) :=
    hasSum_zeta_two.summable.comp_injective Subtype.val_injective
  have hZ : 0 ≤ Z := tsum_nonneg fun _ => by positivity
  have hgu : 0 ≤ g u :=
    quartetPrimePowerLogDensity_nonneg ha hgam hradius u
  have hmajor :
      Summable (fun n : ℕ+ => (Z * g u) * (1 / (n : ℝ) ^ 2)) :=
    hz.mul_left (Z * g u)
  apply Summable.of_norm_bounded hmajor
  intro n
  have hn : (0 : ℝ) < (n : ℝ) := by positivity
  have hn1 : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast n.property
  have huv : 0 ≤ u / (n : ℝ) := div_nonneg hu hn.le
  have huv_le : u / (n : ℝ) ≤ u := by
    rw [div_le_iff₀ hn]
    nlinarith
  have hp :=
    norm_positiveMobiusPrimeDensity_le_zetaTwoMass
      (fun x => quartetPrimePowerLogDensity_nonneg ha hgam hradius x)
      (monotone_quartetPrimePowerLogDensity ha hgam hradius) huv
  have hg_le : g (u / (n : ℝ)) ≤ g u :=
    (monotone_quartetPrimePowerLogDensity ha hgam hradius) huv_le
  change
    ‖1 / (n : ℝ) ^ 2 *
        positiveMobiusPrimeDensity g (u / (n : ℝ))‖ ≤
      (Z * g u) * (1 / (n : ℝ) ^ 2)
  rw [Real.norm_eq_abs, abs_mul,
    abs_of_nonneg (by positivity : 0 ≤ 1 / (n : ℝ) ^ 2)]
  calc
    1 / (n : ℝ) ^ 2 *
          ‖positiveMobiusPrimeDensity g (u / (n : ℝ))‖ ≤
        1 / (n : ℝ) ^ 2 * (Z * g (u / (n : ℝ))) := by
          gcongr
    _ ≤ 1 / (n : ℝ) ^ 2 * (Z * g u) := by
          gcongr
    _ = (Z * g u) * (1 / (n : ℝ) ^ 2) := by ring

/-- Finite superposition commutes with the prime-power transform. -/
theorem primePowerDensityTransform_finiteQuartetPrimeLogDensity
    {ι : Type*} [Fintype ι] {a gam : ι → ℝ}
    (ha : ∀ i, 0 < a i) (hgam : ∀ i, gam i ≠ 0)
    (hradius : ∀ i, a i ^ 2 + gam i ^ 2 ≤ 1 / 4)
    {u : ℝ} (hu : 0 ≤ u) :
    primePowerDensityTransform (finiteQuartetPrimeLogDensity a gam) u =
      finiteQuartetPrimePowerLogDensity a gam u := by
  classical
  unfold primePowerDensityTransform finiteQuartetPrimeLogDensity
    finiteQuartetPrimePowerLogDensity
  simp_rw [Finset.mul_sum]
  rw [Summable.tsum_finsetSum]
  · apply Finset.sum_congr rfl
    intro i _
    exact primePowerDensityTransform_quartetPrimeLogDensity
      (ha i) (hgam i) (hradius i) hu
  · intro i _
    exact summable_primePowerDensityTransform_quartetPrimeLogDensity
      (ha i) (hgam i) (hradius i) hu

/-- Unsquared Cauchy orientation response of a finite quartet packet. -/
def finiteQuartetCauchyOrientationResponse
    {ι : Type*} [Fintype ι] (a gam : ι → ℝ) (z : ℂ) : ℝ :=
  ∑ i, (
      cauchyQuartetOrientationTerm z (eulerQuartetSpectralPoint (a i) (gam i)) +
      cauchyQuartetOrientationTerm z
        ((starRingEnd ℂ) (eulerQuartetSpectralPoint (a i) (gam i))) +
      cauchyQuartetOrientationTerm z
        (-(eulerQuartetSpectralPoint (a i) (gam i))) +
      cauchyQuartetOrientationTerm z
        (-(starRingEnd ℂ) (eulerQuartetSpectralPoint (a i) (gam i))))

theorem finiteQuartetCauchyOrientationResponse_pos
    {ι : Type*} [Fintype ι] [Nonempty ι] {a gam : ι → ℝ}
    (ha : ∀ i, 0 < a i) (hgam : ∀ i, 0 < gam i)
    (z : ℂ) (hzre : 0 < z.re) (hzim : 0 < z.im)
    (haz : ∀ i, eulerQuartetSpectralPoint (a i) (gam i) - z ≠ 0)
    (hcaz : ∀ i,
      (starRingEnd ℂ) (eulerQuartetSpectralPoint (a i) (gam i)) - z ≠ 0)
    (hapz : ∀ i, eulerQuartetSpectralPoint (a i) (gam i) + z ≠ 0)
    (hcapz : ∀ i,
      (starRingEnd ℂ) (eulerQuartetSpectralPoint (a i) (gam i)) + z ≠ 0) :
    0 < finiteQuartetCauchyOrientationResponse a gam z := by
  classical
  unfold finiteQuartetCauchyOrientationResponse
  apply Finset.sum_pos
  · intro i _
    rw [cauchyQuartetOrientationTerm_sum_orbit
      z (eulerQuartetSpectralPoint (a i) (gam i)) ?_
      (haz i) (hcaz i) (hapz i) (hcapz i)]
    · have hv :=
        cauchyQuartetVariance_eulerQuartetSpectralPoint_pos
          (ha i) (hgam i).ne' z (haz i) (hcaz i) (hapz i) (hcapz i)
      positivity
    · intro hzero
      have hre := congrArg Complex.re hzero
      simp only [eulerQuartetSpectralPoint_re, Complex.zero_re] at hre
      exact (hgam i).ne' hre
  · exact Finset.univ_nonempty

/-- Pole-order excess of a finite complex-quartet packet. -/
def finiteQuartetPoleExcess (ι : Type*) [Fintype ι] : ℕ :=
  2 * Fintype.card ι

/-- Rational Euler gauge of a finite quartet packet.  The denominator
exponent is the packet's pole-order excess. -/
def finiteEulerQuartetGauge {ι : Type*} [Fintype ι]
    (a gam : ι → ℝ) (s : ℂ) : ℂ :=
  finiteQuartetGauge a gam s /
    (s * (s - 1)) ^ finiteQuartetPoleExcess ι

/-- Additive transform generated by a finite quartet packet. -/
def finiteQuartetTransform {ι : Type*} [Fintype ι]
    (a gam : ι → ℝ) (s : ℂ) : ℂ :=
  ∑ i, entireFETransform (a i) (gam i) s

/-- The packet gauge is one Euler object: it is exactly the product of the
single-quartet rational Euler gauges. -/
theorem finiteEulerQuartetGauge_eq_prod
    {ι : Type*} [Fintype ι] (a gam : ι → ℝ) (s : ℂ) :
    finiteEulerQuartetGauge a gam s =
      ∏ i, entireFEGauge (a i) (gam i) s := by
  classical
  unfold finiteEulerQuartetGauge finiteQuartetPoleExcess
    finiteQuartetGauge entireFEGauge
  simp_rw [offLineQuartet_eq_centeredQuartetGauge]
  rw [Finset.prod_div_distrib]
  congr 1
  rw [Finset.prod_const]
  rw [← pow_mul]
  simp

/-- Exact source-to-divisor connection for a finite packet: away from its
poles and zeros, the logarithmic derivative of the packet gauge is the
negative of the additive prime-power transform. -/
theorem logDeriv_finiteEulerQuartetGauge_eq_neg_transform
    {ι : Type*} [Fintype ι]
    (a gam : ι → ℝ) (s : ℂ)
    (hs : s ≠ 0) (hs1 : s ≠ 1)
    (h1 : ∀ i, s - (((1 / 2 + a i : ℝ) : ℂ) +
      (gam i : ℂ) * Complex.I) ≠ 0)
    (h2 : ∀ i, s - (((1 / 2 + a i : ℝ) : ℂ) -
      (gam i : ℂ) * Complex.I) ≠ 0)
    (h3 : ∀ i, s - (((1 / 2 - a i : ℝ) : ℂ) +
      (gam i : ℂ) * Complex.I) ≠ 0)
    (h4 : ∀ i, s - (((1 / 2 - a i : ℝ) : ℂ) -
      (gam i : ℂ) * Complex.I) ≠ 0) :
    logDeriv (finiteEulerQuartetGauge a gam) s =
      -finiteQuartetTransform a gam s := by
  classical
  have hfun :
      finiteEulerQuartetGauge a gam =
        fun z => ∏ i, entireFEGauge (a i) (gam i) z := by
    funext z
    exact finiteEulerQuartetGauge_eq_prod a gam z
  rw [hfun]
  have hden : (s * (s - 1)) ^ 2 ≠ 0 :=
    pow_ne_zero _ (mul_ne_zero hs (sub_ne_zero.mpr hs1))
  have hne : ∀ i ∈ (Finset.univ : Finset ι),
      entireFEGauge (a i) (gam i) s ≠ 0 := by
    intro i _
    unfold entireFEGauge offLineQuartet
    exact div_ne_zero
      (mul_ne_zero
        (mul_ne_zero (mul_ne_zero (h1 i) (h2 i)) (h3 i)) (h4 i))
      hden
  have hdiff : ∀ i ∈ (Finset.univ : Finset ι),
      DifferentiableAt ℂ (entireFEGauge (a i) (gam i)) s := by
    intro i _
    unfold entireFEGauge offLineQuartet
    fun_prop
  rw [logDeriv_prod (x := s) hne hdiff]
  simp_rw [logDeriv_entireFEGauge_eq_neg_transform
    (s := s) (hs := hs) (hs1 := hs1)
    (h1 := h1 _) (h2 := h2 _) (h3 := h3 _) (h4 := h4 _)]
  unfold finiteQuartetTransform
  rw [Finset.sum_neg_distrib]

/-- A linear factor has a simple zero at its root. -/
private theorem analyticOrderAt_sub_self (w : ℂ) :
    analyticOrderAt (fun z : ℂ => z - w) w = 1 := by
  have h : AnalyticAt ℂ (fun z : ℂ => z - w) w :=
    analyticAt_id.sub analyticAt_const
  have hc := h.analyticOrderAt_eq_natCast (n := 1)
  rw [Nat.cast_one] at hc
  rw [hc]
  exact ⟨fun _ => 1, analyticAt_const, one_ne_zero,
    by filter_upwards with z using by simp⟩

/-- **Exact pole budget.**  A nonempty finite packet of complex quartets has
a rational Euler gauge with pole order exactly twice packet cardinality at
`s = 1`.  Equivalently, its meromorphic order is the negative of
`finiteQuartetPoleExcess`. -/
theorem meromorphicOrderAt_finiteEulerQuartetGauge_one
    {ι : Type*} [Fintype ι] {a gam : ι → ℝ}
    (hgam : ∀ i, 0 < gam i) :
    meromorphicOrderAt (finiteEulerQuartetGauge a gam) 1 =
      -(finiteQuartetPoleExcess ι : ℤ) := by
  let num : ℂ → ℂ := finiteQuartetGauge a gam
  let base : ℂ → ℂ := fun s => s * (s - 1)
  let den : ℂ → ℂ := fun s => (base s) ^ finiteQuartetPoleExcess ι
  have hnumAn : AnalyticAt ℂ num 1 := by
    have hfun : num =
        fun z => Polynomial.eval z (finiteQuartetPolynomial a gam) := by
      funext z
      exact (finiteQuartetPolynomial_eval a gam z).symm
    rw [hfun]
    exact (AnalyticOnNhd.eval_polynomial (𝕜 := ℂ)
      (finiteQuartetPolynomial a gam)) 1 (Set.mem_univ 1)
  have hnumNe : num 1 ≠ 0 := by
    intro hzero
    have hre := congrArg Complex.re hzero
    simp only [Complex.zero_re] at hre
    exact (ne_of_gt (finiteQuartetGauge_real_pos hgam 1)) hre
  have hnumOrder : analyticOrderAt num 1 = 0 :=
    analyticOrderAt_eq_zero.mpr (Or.inr hnumNe)
  have hbaseAn : AnalyticAt ℂ base 1 := by
    dsimp [base]
    fun_prop
  have hdenAn : AnalyticAt ℂ den 1 := by
    exact hbaseAn.pow _
  have hidOrder :
      analyticOrderAt (fun s : ℂ => s) 1 = 0 :=
    analyticOrderAt_eq_zero.mpr (Or.inr one_ne_zero)
  have hlinOrder :
      analyticOrderAt (fun s : ℂ => s - 1) 1 = 1 :=
    analyticOrderAt_sub_self 1
  have hbaseOrder : analyticOrderAt base 1 = 1 := by
    dsimp [base]
    change analyticOrderAt
      ((fun s : ℂ => s) * (fun s : ℂ => s - 1)) 1 = 1
    rw [analyticOrderAt_mul (f := fun s : ℂ => s)
      (g := fun s : ℂ => s - 1) analyticAt_id
      (analyticAt_id.sub analyticAt_const), hidOrder, hlinOrder]
    norm_num
  have hdenOrder :
      analyticOrderAt den 1 = (finiteQuartetPoleExcess ι : ℕ∞) := by
    dsimp [den]
    change analyticOrderAt
      (base ^ finiteQuartetPoleExcess ι) 1 =
        (finiteQuartetPoleExcess ι : ℕ∞)
    rw [analyticOrderAt_pow hbaseAn, hbaseOrder]
    simp
  change meromorphicOrderAt (num / den) 1 =
    -(finiteQuartetPoleExcess ι : ℤ)
  rw [meromorphicOrderAt_div hnumAn.meromorphicAt hdenAn.meromorphicAt,
    hnumAn.meromorphicOrderAt_eq, hdenAn.meromorphicOrderAt_eq,
    hnumOrder, hdenOrder]
  simp

/-- Riemann zeta deformed by the positive Euler gauge of a finite packet. -/
def finiteEulerDeformedZeta {ι : Type*} [Fintype ι]
    (a gam : ι → ℝ) (s : ℂ) : ℂ :=
  riemannZeta s * finiteEulerQuartetGauge a gam s

/-- The total pole order of the deformed zeta function is one plus the
packet's exact rational-gauge pole excess. -/
theorem meromorphicOrderAt_finiteEulerDeformedZeta_one
    {ι : Type*} [Fintype ι] {a gam : ι → ℝ}
    (hgam : ∀ i, 0 < gam i) :
    meromorphicOrderAt (finiteEulerDeformedZeta a gam) 1 =
      -((1 + finiteQuartetPoleExcess ι : ℕ) : ℤ) := by
  have hgauge : MeromorphicAt (finiteEulerQuartetGauge a gam) 1 := by
    have hnum : AnalyticAt ℂ (finiteQuartetGauge a gam) 1 := by
      have hfun : finiteQuartetGauge a gam =
          fun z => Polynomial.eval z (finiteQuartetPolynomial a gam) := by
        funext z
        exact (finiteQuartetPolynomial_eval a gam z).symm
      rw [hfun]
      exact (AnalyticOnNhd.eval_polynomial (𝕜 := ℂ)
        (finiteQuartetPolynomial a gam)) 1 (Set.mem_univ 1)
    have hden : AnalyticAt ℂ
        (fun s : ℂ =>
          (s * (s - 1)) ^ finiteQuartetPoleExcess ι) 1 := by
      fun_prop
    exact hnum.meromorphicAt.div hden.meromorphicAt
  change meromorphicOrderAt
    (riemannZeta * finiteEulerQuartetGauge a gam) 1 = _
  rw [meromorphicOrderAt_mul meromorphicAt_riemannZeta_one hgauge,
    meromorphicOrderAt_riemannZeta_one,
    meromorphicOrderAt_finiteEulerQuartetGauge_one hgam]
  push_cast
  simp [neg_add_rev, add_comm]

/-- Squared modulus of the two-factor Cayley phase attached to one
strict-right upper Schwarz pair.  The aperture variable is the unsquared
normal coordinate. -/
def quartetJuliaWardPhaseNormSq
    (a gam t alpha : ℝ) : ℝ :=
  ((((a + 1 / 2) - alpha) ^ 2 + (t + gam) ^ 2) /
      (((a + 1 / 2) + alpha) ^ 2 + (t + gam) ^ 2)) *
    ((((a + 1 / 2) - alpha) ^ 2 + (t - gam) ^ 2) /
      (((a + 1 / 2) + alpha) ^ 2 + (t - gam) ^ 2))

/-- Julia phase defect along the unsquared aperture. -/
def quartetJuliaWardPhaseDefect
    (a gam t alpha : ℝ) : ℝ :=
  1 - quartetJuliaWardPhaseNormSq a gam t alpha

/-- **Unsquared Julia--Ward orientation law.**  The first aperture
derivative of the phase defect is exactly the pointwise Ward density. -/
theorem hasDerivAt_quartetJuliaWardPhaseDefect_zero
    {a gam t : ℝ} (ha : 0 < a + 1 / 2) :
    HasDerivAt (quartetJuliaWardPhaseDefect a gam t)
      (quartetWardInfinitesimalDensity a gam t) 0 := by
  let c : ℝ := a + 1 / 2
  let factor : ℝ → ℝ → ℝ := fun y alpha =>
    ((c - alpha) ^ 2 + y ^ 2) / ((c + alpha) ^ 2 + y ^ 2)
  have hc : 0 < c := by simpa only [c] using ha
  have hfactor (y : ℝ) :
      HasDerivAt (factor y) (-4 * c / (c ^ 2 + y ^ 2)) 0 := by
    have hnum :
        HasDerivAt (fun alpha : ℝ => (c - alpha) ^ 2 + y ^ 2)
          (-2 * c) 0 := by
      simpa [mul_comm] using
        (((hasDerivAt_const (x := (0 : ℝ)) (c := c)).sub
          (hasDerivAt_id (x := (0 : ℝ)))).pow 2).add_const (y ^ 2)
    have hden :
        HasDerivAt (fun alpha : ℝ => (c + alpha) ^ 2 + y ^ 2)
          (2 * c) 0 := by
      simpa [mul_comm] using
        (((hasDerivAt_const (x := (0 : ℝ)) (c := c)).add
          (hasDerivAt_id (x := (0 : ℝ)))).pow 2).add_const (y ^ 2)
    have hne : c ^ 2 + y ^ 2 ≠ 0 := by positivity
    have hquot := hnum.div hden (by simpa using hne)
    change HasDerivAt
      ((fun alpha : ℝ => (c - alpha) ^ 2 + y ^ 2) /
        fun alpha : ℝ => (c + alpha) ^ 2 + y ^ 2)
      (-4 * c / (c ^ 2 + y ^ 2)) 0
    apply hquot.congr_deriv
    simp only [sub_zero, add_zero]
    field_simp [hne]
    ring
  have hprod := (hfactor (t + gam)).mul (hfactor (t - gam))
  have hdefect :=
    (hasDerivAt_const (x := (0 : ℝ)) (c := (1 : ℝ))).sub hprod
  change HasDerivAt
    (fun alpha : ℝ =>
      1 - factor (t + gam) alpha * factor (t - gam) alpha)
    (quartetWardInfinitesimalDensity a gam t) 0
  apply hdefect.congr_deriv
  simp only [factor, sub_zero, add_zero, div_self (by
    positivity : c ^ 2 + (t + gam) ^ 2 ≠ 0),
    div_self (by positivity : c ^ 2 + (t - gam) ^ 2 ≠ 0),
    mul_one, one_mul, zero_sub]
  unfold quartetWardInfinitesimalDensity
  dsimp only [c]
  ring

/-- Real Ward charge of a finite complex-quartet packet. -/
def finiteQuartetWardCharge (ι : Type*) [Fintype ι] : ℝ :=
  (8 * π) * Fintype.card ι

/-- Negative index of the isolated Weil block form carried by a finite packet
of generic FE--Schwarz quartets: every quartet has signature `(2,2)`. -/
def finiteQuartetWeilBlockIndex (ι : Type*) [Fintype ι] : ℕ :=
  2 * Fintype.card ι

/-- The linear Euler pole budget and the quadratic packet-block index are the
same integer on a purely generic off-critical packet. -/
theorem finiteQuartetPoleExcess_eq_weilBlockIndex
    (ι : Type*) [Fintype ι] :
    finiteQuartetPoleExcess ι = finiteQuartetWeilBlockIndex ι := by
  rfl

/-- **Pole--Ward charge law.**  Ward charge is `4π` times pole-order
excess for every finite packet of genuinely complex FE--Schwarz quartets. -/
theorem finiteQuartetWardCharge_eq_fourPi_poleExcess
    (ι : Type*) [Fintype ι] :
    finiteQuartetWardCharge ι =
      (4 * π) * finiteQuartetPoleExcess ι := by
  unfold finiteQuartetWardCharge finiteQuartetPoleExcess
  push_cast
  ring

/-- **Euler--Ward--Weil index law.**  The Ward charge divided by `4π`,
the rational Euler pole-order excess, and the negative index of the isolated
Weil packet block are one invariant for every finite generic quartet packet. -/
theorem finiteQuartet_eulerWardWeil_index_law
    (ι : Type*) [Fintype ι] :
    finiteQuartetPoleExcess ι = finiteQuartetWeilBlockIndex ι ∧
    finiteQuartetWardCharge ι =
      (4 * π) * finiteQuartetWeilBlockIndex ι := by
  constructor
  · exact finiteQuartetPoleExcess_eq_weilBlockIndex ι
  · rw [← finiteQuartetPoleExcess_eq_weilBlockIndex]
    exact finiteQuartetWardCharge_eq_fourPi_poleExcess ι

/-- **Positive-Euler finite-packet orientation law.**  An arbitrary nonempty
finite off-line quartet packet in the centered radius-one-half disc has one
locally finite nonnegative generalized-prime density, exact prime-power
recovery, an entire reflection-symmetric hypertranscendental completion,
strictly positive unsquared Cauchy orientation, `8π` Ward mass per quartet,
and Ward charge equal to `4π` times pole-order excess. -/
theorem positiveEuler_finiteQuartet_orientation_poleWard_law
    {ι : Type*} [Fintype ι] [Nonempty ι] {a gam : ι → ℝ}
    (ha : ∀ i, 0 < a i) (hgam : ∀ i, 0 < gam i)
    (hradius : ∀ i, a i ^ 2 + gam i ^ 2 ≤ 1 / 4)
    (z : ℂ) (hzre : 0 < z.re) (hzim : 0 < z.im)
