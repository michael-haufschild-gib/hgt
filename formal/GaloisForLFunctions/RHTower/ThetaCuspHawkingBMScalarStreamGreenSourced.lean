/-- The master source as a Horner radial function. -/
def srcMaster (s μ : ℂ) : ℝ → ℂ :=
  ratCoef [(((-9 : ℂ) * s ^ (2 : ℕ) + (9 / 4 : ℂ) * s ^ (2 : ℕ) * μ + (-1 / 8 : ℂ) * s ^ (2 : ℕ) * μ ^ (2 : ℕ) + (-75 / 2 : ℂ) * s ^ (3 : ℕ) + (7 : ℂ) * s ^ (3 : ℕ) * μ + (-1 / 4 : ℂ) * s ^ (3 : ℕ) * μ ^ (2 : ℕ) + (-129 / 2 : ℂ) * s ^ (4 : ℕ) + (8 : ℂ) * s ^ (4 : ℕ) * μ + (-1 / 8 : ℂ) * s ^ (4 : ℕ) * μ ^ (2 : ℕ) + (-59 : ℂ) * s ^ (5 : ℕ) + (4 : ℂ) * s ^ (5 : ℕ) * μ + (-61 / 2 : ℂ) * s ^ (6 : ℕ) + (3 / 4 : ℂ) * s ^ (6 : ℕ) * μ + (-17 / 2 : ℂ) * s ^ (7 : ℕ) + (-1 : ℂ) * s ^ (8 : ℕ)) / ((2 - μ))), (0 : ℂ), (((-8 : ℂ) * s + (2 : ℂ) * s * μ + (1 : ℂ) * s * μ ^ (2 : ℕ) + (-5 / 2 : ℂ) * s ^ (2 : ℕ) + (-9 / 4 : ℂ) * s ^ (2 : ℕ) * μ + (5 / 2 : ℂ) * s ^ (2 : ℕ) * μ ^ (2 : ℕ) + (79 / 2 : ℂ) * s ^ (3 : ℕ) + (-17 / 2 : ℂ) * s ^ (3 : ℕ) * μ + (54 : ℂ) * s ^ (4 : ℕ) + (-29 / 4 : ℂ) * s ^ (4 : ℕ) * μ + (51 / 2 : ℂ) * s ^ (5 : ℕ) + (11 / 2 : ℂ) * s ^ (6 : ℕ)) / ((2 - μ))), (0 : ℂ), (((-2 : ℂ) * μ + (1 : ℂ) * μ ^ (2 : ℕ) + (-4 : ℂ) * s + (2 : ℂ) * s * μ + (8 : ℂ) * s ^ (2 : ℕ) + (-4 : ℂ) * s ^ (2 : ℕ) * μ) / ((2 - μ))), (0 : ℂ), (((-4 : ℂ) + (2 : ℂ) * μ) / ((2 - μ)))] 5 1

theorem srcMaster_eq (s μ : ℂ) {r : ℝ} (hr1 : 1 < r) (hs : s ≠ 0) (hμ : (2 : ℂ) - μ ≠ 0) :
    srcMaster s μ r = ssMasterSource s r μ := by
  have hr := (exterior_ne r hr1).1
  have hf := (exterior_ne r hr1).2
  unfold srcMaster ssMasterSource
  simp only [ratCoef, horner]
  field_simp
  ring

theorem srcMaster_contDiffOn (s μ : ℂ) : ContDiffOn ℝ ∞ (srcMaster s μ) (Ioi 1) :=
  contDiffOn_ratCoef _ _ _

/-- The exterior radius of a horizon coordinate: `r = √((1−z)⁻¹)`. -/
def rOfZ (z : ℝ) : ℝ := Real.sqrt ((1 - z)⁻¹)

theorem rOfZ_sq {z : ℝ} (hz : z ∈ Ioo (0 : ℝ) 1) : rOfZ z ^ (2 : ℕ) = (1 - z)⁻¹ := by
  unfold rOfZ
  exact Real.sq_sqrt (inv_nonneg.mpr (by linarith [hz.2]))

theorem one_lt_rOfZ {z : ℝ} (hz : z ∈ Ioo (0 : ℝ) 1) : 1 < rOfZ z := by
  unfold rOfZ
  rw [Real.lt_sqrt zero_le_one, one_pow]
  have h1 : 0 < 1 - z := by linarith [hz.2]
  rw [lt_inv_comm₀ one_pos h1, inv_one]
  linarith [hz.1]

theorem zmap_rOfZ {z : ℝ} (hz : z ∈ Ioo (0 : ℝ) 1) : zmap (rOfZ z) = z := by
  unfold zmap
  rw [inv_pow, rOfZ_sq hz, inv_inv]
  ring

theorem rOfZ_zmap {r : ℝ} (hr1 : 1 < r) : rOfZ (zmap r) = r := by
  unfold rOfZ zmap
  have h : (1 - (1 - r⁻¹ ^ (2 : ℕ)))⁻¹ = r ^ (2 : ℕ) := by
    rw [sub_sub_cancel, inv_pow, inv_inv]
  rw [h, Real.sqrt_sq (by linarith)]

theorem mapsTo_rOfZ : MapsTo rOfZ (Ioo (0 : ℝ) 1) (Ioi 1) := fun z hz => one_lt_rOfZ hz

theorem mapsTo_zmap : MapsTo zmap (Ioi (1 : ℝ)) (Ioo 0 1) := fun r hr => zmap_mem r hr

theorem contDiffOn_rOfZ : ContDiffOn ℝ ∞ rOfZ (Ioo (0 : ℝ) 1) := by
  intro z hz
  have h1 : (1 : ℝ) - z ≠ 0 := by linarith [hz.2]
  have hinner : ContDiffAt ℝ ∞ (fun z : ℝ => (1 - z)⁻¹) z :=
    (contDiffAt_const.sub contDiffAt_id).inv h1
  exact ((Real.contDiffAt_sqrt (inv_ne_zero h1)).comp z hinner).contDiffWithinAt

theorem contDiffOn_zmap : ContDiffOn ℝ ∞ zmap (Ioi (1 : ℝ)) := by
  intro r hr
  have h0 : r ≠ 0 := by have : (1 : ℝ) < r := hr; linarith
  exact (contDiffAt_const.sub ((contDiffAt_id.inv h0).pow 2)).contDiffWithinAt

/-- The forcing of the corpus Green problem producing the scalar–scalar master source. -/
def ssForcing (s μ : ℂ) (z : ℝ) : ℂ :=
  -(((rOfZ z : ℂ) ^ (2 : ℕ) * ((rOfZ z : ℂ) ^ (2 : ℕ) - 1)) / 4) * srcMaster s μ (rOfZ z)

theorem contDiffOn_ssForcing (s μ : ℂ) : ContDiffOn ℝ ∞ (ssForcing s μ) (Ioo (0 : ℝ) 1) := by
  have hpoly : ContDiff ℝ ∞ (fun x : ℝ => -(((x : ℂ) ^ (2 : ℕ) * ((x : ℂ) ^ (2 : ℕ) - 1)) / 4)) := by fun_prop
  have h1 : ContDiffOn ℝ ∞ (fun z : ℝ => -(((rOfZ z : ℂ) ^ (2 : ℕ) * ((rOfZ z : ℂ) ^ (2 : ℕ) - 1)) / 4)) (Ioo 0 1) :=
    hpoly.comp_contDiffOn contDiffOn_rOfZ
  have h2 : ContDiffOn ℝ ∞ (fun z : ℝ => srcMaster s μ (rOfZ z)) (Ioo 0 1) :=
    (srcMaster_contDiffOn s μ).comp contDiffOn_rOfZ mapsTo_rOfZ
  exact h1.mul h2

/-- The scalar–scalar `++` master response at overtone `n`, angular parameter `chi`, cutoffs `a b`. -/
def greenSS (n : ℕ) (chi : ℂ) (a b : ℝ) : ℝ → ℂ :=
  d4BMPlusPlusContinuousGreenResponse n chi (ssForcing (dictRate n chi) (dictEigen chi)) a b ∘ zmap

theorem greenSS_masterEquation (n : ℕ) (chi : ℂ) (hchi : chi.re ≠ 0) {a b : ℝ}
    (ha : a ∈ Ioo (0 : ℝ) 1) (hb : b ∈ Ioo (0 : ℝ) 1) (hs : dictRate n chi ≠ 0)
    (hμ : (2 : ℂ) - dictEigen chi ≠ 0) :
    SSMasterEquation (dictRate n chi) (dictEigen chi) (greenSS n chi a b) := by
  intro r hr1
  have hr := (exterior_ne r hr1).1
  have hf := (exterior_ne r hr1).2
  have h := greenResponse_masterOp n chi hchi (contDiffOn_ssForcing (dictRate n chi) (dictEigen chi)).continuousOn ha hb hr1
  have h2 : ssForcing (dictRate n chi) (dictEigen chi) (zmap r) =
      -(((r : ℂ) ^ (2 : ℕ) * ((r : ℂ) ^ (2 : ℕ) - 1)) / 4) * ssMasterSource (dictRate n chi) r (dictEigen chi) := by
    unfold ssForcing
    rw [rOfZ_zmap hr1, srcMaster_eq _ _ hr1 hs hμ]
  have h3 : 4 / ((r : ℂ) ^ (2 : ℕ) * ((r : ℂ) ^ (2 : ℕ) - 1)) *
      (-(((r : ℂ) ^ (2 : ℕ) * ((r : ℂ) ^ (2 : ℕ) - 1)) / 4) * ssMasterSource (dictRate n chi) r (dictEigen chi)) =
      -ssMasterSource (dictRate n chi) r (dictEigen chi) := by
    field_simp
  rw [h2, h3] at h
  unfold greenSS
  linear_combination h

private def hypA (n : ℕ) (chi : ℂ) : ℂ :=
  d4BMCausalHypergeometricA (d4BMCausalPlusPlusFrequency n chi) chi
private def hypB (n : ℕ) (chi : ℂ) : ℂ :=
  d4BMCausalHypergeometricB (d4BMCausalPlusPlusFrequency n chi) chi
private def hypC (n : ℕ) (chi : ℂ) : ℂ :=
  d4BMCausalRadialC (d4BMCausalPlusPlusFrequency n chi)

theorem greenResponse_contDiffOn (n : ℕ) (chi : ℂ) (hchi : chi.re ≠ 0) {g : ℝ → ℂ}
    (hg : ContDiffOn ℝ ∞ g (Ioo 0 1)) {a b : ℝ} (ha : a ∈ Ioo (0 : ℝ) 1) (hb : b ∈ Ioo (0 : ℝ) 1) :
    ContDiffOn ℝ ∞ (d4BMPlusPlusContinuousGreenResponse n chi g a b) (Ioo 0 1) := by
  have hz0 : ∀ z ∈ Ioo (0 : ℝ) 1, ((z * (1 - z) : ℝ) : ℂ) ≠ 0 := by
    intro z hz
    exact_mod_cast (mul_pos hz.1 (by linarith [hz.2])).ne'
  have hden : ContDiffOn ℝ ∞ (fun z : ℝ => ((z * (1 - z) : ℝ) : ℂ)⁻¹) (Ioo 0 1) :=
    (contDiff_ofReal_real.comp (contDiff_id.mul (contDiff_const.sub contDiff_id))).contDiffOn.inv hz0
  refine contDiffOn_of_linear_ode isOpen_Ioo _ (d4BMPlusPlusContinuousGreenResponseDerivative n chi g a b)
    (fun z => -(hypC n chi - (hypA n chi + hypB n chi + 1) * (z : ℂ)) * ((z * (1 - z) : ℝ) : ℂ)⁻¹)
    (fun z => hypA n chi * hypB n chi * ((z * (1 - z) : ℝ) : ℂ)⁻¹)
    (fun z => g z * ((z * (1 - z) : ℝ) : ℂ)⁻¹) ?_ ?_ ?_
    (fun z hz => hasDerivAt_d4BMPlusPlusContinuousGreenResponse n chi hchi hg.continuousOn ha hb hz) ?_
  · exact ((contDiff_const.sub (contDiff_const.mul contDiff_ofReal_real)).neg).contDiffOn.mul hden
  · exact contDiffOn_const.mul hden
  · exact hg.mul hden
  · intro z hz
    have h := hasDerivAt_d4BMPlusPlusContinuousGreenResponseDerivative n chi hchi hg.continuousOn ha hb hz
    refine h.congr_deriv ?_
    have hj := d4BMPlusPlusContinuousGreenResponse_forcedJet n chi hchi g a b hz
    unfold d4BMPlusPlusHypergeometricJet at hj
    have hz1 := hz0 z hz
    unfold hypA hypB hypC
    field_simp
    linear_combination hj

theorem greenSS_contDiffOn (n : ℕ) (chi : ℂ) (hchi : chi.re ≠ 0) {a b : ℝ}
    (ha : a ∈ Ioo (0 : ℝ) 1) (hb : b ∈ Ioo (0 : ℝ) 1) :
    ContDiffOn ℝ ∞ (greenSS n chi a b) (Ioi 1) :=
  (greenResponse_contDiffOn n chi hchi (contDiffOn_ssForcing _ _) ha hb).comp contDiffOn_zmap mapsTo_zmap

