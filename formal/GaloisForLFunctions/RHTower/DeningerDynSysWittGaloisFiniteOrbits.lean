import GaloisForLFunctions.RHTower.DeningerDynSysVerschiebungRational
import Mathlib.Algebra.Polynomial.GroupRingAction
import Mathlib.RingTheory.PowerSeries.Basic

/-!
# Galois descent of rational Witt vectors for finite orbits

Deninger, *Dynamical systems for arithmetic schemes* (arXiv:1807.06400v4), Proposition 1.2(a)
(`t21n`): if a group `G` acts on a commutative ring `A` by ring automorphisms with all orbits
finite, then

`W_rat (A ^ G) = W_rat (A) ^ G`.

A rational Witt vector is recorded as a power series `F` with a normalized presentation
`Q · F = P` by polynomials with constant coefficient one (`DeningerIsRationalSeries`), so the
theorem says that a `G`-invariant such `F` admits a presentation whose numerator and denominator
have `G`-invariant coefficients.

The mechanism is the source's:  the translates `{σ Q}` form a *finite* set `T` of polynomials
because the coefficients of `Q` have finite orbits; then

`β = ∏_{R ∈ T} R`,  `α = P · ∏_{R ∈ T, R ≠ Q} R`

are `G`-invariant with `α · Q = P · β`, so `F = α / β`.  Invariance of `α` uses the cross relation
`σP · Q = σQ · P`, which follows from applying `σ` to `Q · F = P` and multiplying.

The source first replaces `A` by the subring generated by the finitely many `G`-translates of the
coefficients in order to reduce to a finite group; the argument here works directly with the finite
set of translated polynomials and needs no such reduction.
-/

namespace RHTower

open Finset

variable {G A : Type*} [Group G] [CommRing A] [MulSemiringAction G A]

/-- The action of `G` on polynomials induced by a semiring action on the coefficients. -/
noncomputable def deningerPolyAct (σ : G) : Polynomial A →+* Polynomial A :=
  Polynomial.mapRingHom (MulSemiringAction.toRingHom G A σ)

theorem deningerPolyAct_coeff (σ : G) (P : Polynomial A) (n : ℕ) :
    (deningerPolyAct σ P).coeff n = σ • P.coeff n := by
  simp [deningerPolyAct, Polynomial.coeff_map]

theorem deningerPolyAct_injective (σ : G) :
    Function.Injective (deningerPolyAct (A := A) σ) := by
  intro P Q h
  ext n
  have := congrArg (fun R : Polynomial A => R.coeff n) h
  simp only [deningerPolyAct_coeff] at this
  exact MulAction.injective σ this

theorem deningerPolyAct_mul (τ σ : G) (P : Polynomial A) :
    deningerPolyAct τ (deningerPolyAct σ P) = deningerPolyAct (τ * σ) P := by
  ext n
  simp [deningerPolyAct_coeff, mul_smul]

theorem deningerPolyAct_one (P : Polynomial A) : deningerPolyAct (1 : G) P = P := by
  ext n
  simp [deningerPolyAct_coeff]

theorem deningerPolyProd_coeff_zero {ι : Type*} (s : Finset ι) (f : ι → Polynomial A) :
    (∏ i ∈ s, f i).coeff 0 = ∏ i ∈ s, (f i).coeff 0 := by
  classical
  refine Finset.induction_on s (by simp) ?_
  intro a s ha ih
  rw [Finset.prod_insert ha, Finset.prod_insert ha, Polynomial.mul_coeff_zero, ih]

/-- Finiteness of the orbits on the coefficient ring gives finiteness of the orbit of a
polynomial. -/
theorem deningerPolyAct_range_finite (horb : ∀ a : A, (MulAction.orbit G a).Finite)
    (Q : Polynomial A) :
    (Set.range (fun σ : G => deningerPolyAct σ Q)).Finite := by
  classical
  set d := Q.natDegree with hd
  set Φ : Polynomial A → (Fin (d + 1) → A) := fun R i => R.coeff i with hΦ
  have hdeg : ∀ σ : G, (deningerPolyAct (A := A) σ Q).natDegree ≤ d := by
    intro σ
    exact Polynomial.natDegree_map_le
  have hsub : Φ '' (Set.range (fun σ : G => deningerPolyAct σ Q))
      ⊆ Set.univ.pi (fun i : Fin (d + 1) => MulAction.orbit G (Q.coeff i)) := by
    rintro _ ⟨_, ⟨σ, rfl⟩, rfl⟩ i -
    exact ⟨σ, (deningerPolyAct_coeff σ Q i).symm⟩
  have hfin : (Φ '' (Set.range (fun σ : G => deningerPolyAct σ Q))).Finite :=
    Set.Finite.subset (Set.Finite.pi fun i => horb _) hsub
  refine Set.Finite.of_finite_image hfin ?_
  rintro _ ⟨σ, rfl⟩ _ ⟨τ, rfl⟩ h
  ext n
  by_cases hn : n ≤ d
  · exact congrFun h ⟨n, by omega⟩
  · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt (hdeg σ) (by omega)),
      Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt (hdeg τ) (by omega))]

/-- **Deninger, Proposition 1.2(a) (`t21n`).**  If all orbits of `G` on `A` are finite, every
`G`-invariant rational Witt vector over `A` is already a normalized quotient of polynomials with
`G`-invariant coefficients, i.e. `W_rat (A)^G = W_rat (A^G)`. -/
theorem deningerRationalSeries_galoisDescent_of_finiteOrbits
    (horb : ∀ a : A, (MulAction.orbit G a).Finite) (F : PowerSeries A)
    (hF : ∀ (σ : G) (n : ℕ), σ • PowerSeries.coeff n F = PowerSeries.coeff n F)
    (hrat : DeningerIsRationalSeries F) :
    ∃ α β : Polynomial A,
      (∀ (σ : G) (n : ℕ), σ • α.coeff n = α.coeff n) ∧
      (∀ (σ : G) (n : ℕ), σ • β.coeff n = β.coeff n) ∧
      α.coeff 0 = 1 ∧ β.coeff 0 = 1 ∧ (β : PowerSeries A) * F = (α : PowerSeries A) := by
  classical
  obtain ⟨P, Q, hP0, hQ0, hPQ⟩ := hrat
  -- `F` is fixed by the induced action on power series
  have hFmap : ∀ σ : G, PowerSeries.map (MulSemiringAction.toRingHom G A σ) F = F := by
    intro σ
    ext n
    simpa using hF σ n
  -- the defining equation is transported by every `σ`
  have hmap : ∀ σ : G,
      ((deningerPolyAct σ Q : Polynomial A) : PowerSeries A) * F
        = ((deningerPolyAct σ P : Polynomial A) : PowerSeries A) := by
    intro σ
    have h := congrArg (PowerSeries.map (MulSemiringAction.toRingHom G A σ)) hPQ
    rw [map_mul, hFmap σ] at h
    have e1 : ((deningerPolyAct σ Q : Polynomial A) : PowerSeries A)
        = PowerSeries.map (MulSemiringAction.toRingHom G A σ) (Q : PowerSeries A) := by
      simp [deningerPolyAct, Polynomial.coe_mapRingHom, Polynomial.polynomial_map_coe]
    have e2 : ((deningerPolyAct σ P : Polynomial A) : PowerSeries A)
        = PowerSeries.map (MulSemiringAction.toRingHom G A σ) (P : PowerSeries A) := by
      simp [deningerPolyAct, Polynomial.coe_mapRingHom, Polynomial.polynomial_map_coe]
    rw [e1, e2]
    exact h
  -- the resulting cross relation `σP · Q = σQ · P`
  have hcross : ∀ σ : G, deningerPolyAct σ P * Q = deningerPolyAct σ Q * P := by
    intro σ
    apply Polynomial.coe_injective A
    push_cast
    rw [← hmap σ, ← hPQ]
    ring
  -- the finite set of translates of `Q`
  have hTfin := deningerPolyAct_range_finite horb Q
  set T : Finset (Polynomial A) := hTfin.toFinset with hT
  have hmemT : ∀ R : Polynomial A, R ∈ T ↔ ∃ σ : G, deningerPolyAct σ Q = R := by
    intro R
    rw [hT, Set.Finite.mem_toFinset]
    exact Iff.rfl
  have hQT : Q ∈ T := (hmemT Q).mpr ⟨1, deningerPolyAct_one Q⟩
  have hstable : ∀ τ : G, T.image (deningerPolyAct τ) = T := by
    intro τ
    refine Finset.eq_of_subset_of_card_le ?_ ?_
    · intro R hR
      obtain ⟨R', hR', rfl⟩ := Finset.mem_image.mp hR
      obtain ⟨σ, rfl⟩ := (hmemT R').mp hR'
      exact (hmemT _).mpr ⟨τ * σ, (deningerPolyAct_mul τ σ Q).symm ▸ rfl⟩
    · exact le_of_eq (Finset.card_image_of_injective T (deningerPolyAct_injective τ)).symm
  have hconst : ∀ R ∈ T, R.coeff 0 = 1 := by
    intro R hR
    obtain ⟨σ, rfl⟩ := (hmemT R).mp hR
    rw [deningerPolyAct_coeff, hQ0, smul_one]
  refine ⟨P * ∏ R ∈ T.erase Q, R, ∏ R ∈ T, R, ?_, ?_, ?_, ?_, ?_⟩
  · -- invariance of the numerator
    intro σ n
    have key : deningerPolyAct σ (P * ∏ R ∈ T.erase Q, R) = P * ∏ R ∈ T.erase Q, R := by
      rw [map_mul, map_prod]
      have himg : (T.erase Q).image (deningerPolyAct σ) = T.erase (deningerPolyAct σ Q) := by
        rw [Finset.image_erase (deningerPolyAct_injective σ), hstable σ]
      have hinj : Set.InjOn (fun R : Polynomial A => deningerPolyAct σ R) ↑(T.erase Q) :=
        fun x _ y _ h => deningerPolyAct_injective σ h
      have hprod : ∏ R ∈ T.erase Q, deningerPolyAct σ R
          = ∏ R ∈ T.erase (deningerPolyAct σ Q), R := by
        rw [← himg]
        exact (Finset.prod_image (f := fun R : Polynomial A => R) hinj).symm
      rw [hprod]
      by_cases hfix : deningerPolyAct σ Q = Q
      · have hPfix : deningerPolyAct σ P = P := by
          apply Polynomial.coe_injective A
          have := hmap σ
          rw [hfix, hPQ] at this
          exact this.symm
        rw [hfix, hPfix]
      · have h1 : Q ∈ T.erase (deningerPolyAct σ Q) :=
          Finset.mem_erase.mpr ⟨fun h => hfix h.symm, hQT⟩
        have h2 : deningerPolyAct σ Q ∈ T.erase Q :=
          Finset.mem_erase.mpr ⟨hfix, (hmemT _).mpr ⟨σ, rfl⟩⟩
        rw [← Finset.mul_prod_erase _ _ h1, ← Finset.mul_prod_erase _ _ h2,
          Finset.erase_right_comm]
        rw [← mul_assoc, ← mul_assoc, hcross σ]
        ring
    have h : (deningerPolyAct σ (P * ∏ R ∈ T.erase Q, R)).coeff n
        = (P * ∏ R ∈ T.erase Q, R).coeff n := by rw [key]
    rwa [deningerPolyAct_coeff] at h
  · -- invariance of the denominator
    intro σ n
    have key : deningerPolyAct σ (∏ R ∈ T, R) = ∏ R ∈ T, R := by
      rw [map_prod]
      have hinj : Set.InjOn (fun R : Polynomial A => deningerPolyAct σ R) ↑T :=
        fun x _ y _ h => deningerPolyAct_injective σ h
      conv_rhs => rw [← hstable σ]
      exact (Finset.prod_image (f := fun R : Polynomial A => R) hinj).symm
    have h : (deningerPolyAct σ (∏ R ∈ T, R)).coeff n = (∏ R ∈ T, R).coeff n := by rw [key]
    rwa [deningerPolyAct_coeff] at h
  · -- constant term of the numerator
    rw [Polynomial.mul_coeff_zero, deningerPolyProd_coeff_zero, hP0, one_mul,
      Finset.prod_congr rfl (fun R hR => hconst R (Finset.mem_of_mem_erase hR)),
      Finset.prod_const_one]
  · -- constant term of the denominator
    rw [deningerPolyProd_coeff_zero, Finset.prod_congr rfl hconst, Finset.prod_const_one]
  · -- the fraction is unchanged
    have hsplit : (∏ R ∈ T, R) = Q * ∏ R ∈ T.erase Q, R :=
      (Finset.mul_prod_erase T (fun R => R) hQT).symm
    rw [hsplit]
    push_cast
    rw [mul_comm ((Q : PowerSeries A)) _, mul_assoc, hPQ]
    ring

end RHTower
