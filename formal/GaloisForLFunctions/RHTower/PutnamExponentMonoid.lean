import Mathlib.Analysis.SpecialFunctions.Log.Basic
import Mathlib.Data.Rat.Lemmas
import Mathlib.Tactic

/-!
# The exponent monoid of a period

For a period `P > 0` let `K(P) = {k ∈ ℕ : e^{kP} ∈ ℕ}`.  It contains `0`, it is closed under
addition, and — this is the point — it is generated by its least positive element:

`K(P) = k₀ ℕ` .

The reason is that if `g = gcd(k, k₀)` then `e^{gP}` is a *rational* number (a Bézout product of the
two integers `e^{kP}` and `e^{k₀P}`) whose `k/g`-th power is an integer, hence an integer; so
`g ∈ K(P)` and minimality forces `g = k₀`.

Consequently the jump of the periodised Putnam kernel is a genuine geometric series, hence nonzero.
-/

open Real

noncomputable section

namespace RHTower

/-- A positive rational whose `N`-th power is a natural number is itself a natural number. -/
theorem exists_nat_of_rat_pow_eq_nat {r : ℚ} (hr : 0 < r) {N m : ℕ} (hN : 0 < N)
    (h : r ^ N = (m : ℚ)) : ∃ t : ℕ, (t : ℚ) = r := by
  have hden : (r ^ N).den = 1 := by
    rw [h]
    exact Rat.den_natCast m
  have hpow : (r ^ N).den = r.den ^ N := Rat.den_pow r N
  rw [hpow] at hden
  have hd1 : r.den = 1 := Nat.pow_eq_one.mp hden |>.resolve_right (by omega)
  have hnum : 0 < r.num := Rat.num_pos.mpr hr
  refine ⟨r.num.toNat, ?_⟩
  have : ((r.num.toNat : ℤ) : ℚ) = (r.num : ℚ) := by
    rw [Int.toNat_of_nonneg hnum.le]
  rw [show ((r.num.toNat : ℕ) : ℚ) = ((r.num.toNat : ℤ) : ℚ) by push_cast; ring, this]
  exact Rat.num_div_den r ▸ by rw [hd1]; simp

/-- The exponent monoid of a period. -/
def expNatSet (P : ℝ) : Set ℕ := {k : ℕ | ∃ m : ℕ, Real.exp ((k : ℝ) * P) = (m : ℝ)}

theorem zero_mem_expNatSet (P : ℝ) : 0 ∈ expNatSet P := ⟨1, by simp⟩

theorem add_mem_expNatSet {P : ℝ} {j k : ℕ} (hj : j ∈ expNatSet P) (hk : k ∈ expNatSet P) :
    j + k ∈ expNatSet P := by
  obtain ⟨m, hm⟩ := hj
  obtain ⟨n, hn⟩ := hk
  refine ⟨m * n, ?_⟩
  have : ((j : ℝ) + (k : ℝ)) * P = (j : ℝ) * P + (k : ℝ) * P := by ring
  push_cast
  rw [this, Real.exp_add, hm, hn]

theorem pos_of_mem_expNatSet {P : ℝ} {k m : ℕ} (h : Real.exp ((k : ℝ) * P) = (m : ℝ)) :
    0 < m := by
  by_contra hcon
  have hm0 : m = 0 := by omega
  rw [hm0] at h
  exact absurd h (ne_of_gt (by simpa using Real.exp_pos ((k : ℝ) * P)))

/-- **The gcd of two exponents is an exponent.**  A Bézout combination of the two integer values is
a positive rational whose integer power is an integer, hence an integer. -/
theorem gcd_mem_expNatSet {P : ℝ} {k k₀ : ℕ} (hk : 0 < k)
    (hkm : k ∈ expNatSet P) (hk₀m : k₀ ∈ expNatSet P) :
    Nat.gcd k k₀ ∈ expNatSet P := by
  obtain ⟨m, hm⟩ := hkm
  obtain ⟨u, hu⟩ := hk₀m
  have hmpos : 0 < m := pos_of_mem_expNatSet hm
  have hupos : 0 < u := pos_of_mem_expNatSet hu
  set g : ℕ := Nat.gcd k k₀ with hg
  have hgpos : 0 < g := Nat.gcd_pos_of_pos_left _ hk
  obtain ⟨k', hk'⟩ : g ∣ k := Nat.gcd_dvd_left _ _
  obtain ⟨k₀', hk₀'⟩ : g ∣ k₀ := Nat.gcd_dvd_right _ _
  have hcop : Nat.gcd k' k₀' = 1 := by
    have := Nat.coprime_div_gcd_div_gcd (m := k) (n := k₀) hgpos
    have hk'eq : k / g = k' := by
      rw [hk']
      exact Nat.mul_div_cancel_left _ hgpos
    have hk₀'eq : k₀ / g = k₀' := by
      rw [hk₀']
      exact Nat.mul_div_cancel_left _ hgpos
    rwa [hk'eq, hk₀'eq] at this
  have hk'pos : 0 < k' := by
    rcases Nat.eq_zero_or_pos k' with h | h
    · rw [h, Nat.mul_zero] at hk'
      omega
    · exact h
  set q : ℝ := Real.exp ((g : ℝ) * P) with hqdef
  have hqpos : 0 < q := Real.exp_pos _
  have hqk : q ^ k' = (m : ℝ) := by
    rw [hqdef, ← Real.exp_nat_mul, ← hm]
    congr 1
    rw [hk']
    push_cast
    ring
  have hqk₀ : q ^ k₀' = (u : ℝ) := by
    rw [hqdef, ← Real.exp_nat_mul, ← hu]
    congr 1
    rw [hk₀']
    push_cast
    ring
  -- Bézout
  obtain ⟨α, β, hbez⟩ : ∃ α β : ℤ, α * (k' : ℤ) + β * (k₀' : ℤ) = 1 := by
    refine ⟨Nat.gcdA k' k₀', Nat.gcdB k' k₀', ?_⟩
    have := Nat.gcd_eq_gcd_ab k' k₀'
    rw [hcop] at this
    push_cast at this ⊢
    linarith [this]
  have hqzpow : q = (m : ℝ) ^ α * (u : ℝ) ^ β := by
    have hmr : (m : ℝ) = q ^ (k' : ℤ) := by
      rw [zpow_natCast]
      exact hqk.symm
    have hur : (u : ℝ) = q ^ (k₀' : ℤ) := by
      rw [zpow_natCast]
      exact hqk₀.symm
    rw [hmr, hur, ← zpow_mul, ← zpow_mul, ← zpow_add₀ (ne_of_gt hqpos),
      show (k' : ℤ) * α + (k₀' : ℤ) * β = 1 by linarith [hbez], zpow_one]
  set r : ℚ := (m : ℚ) ^ α * (u : ℚ) ^ β with hrdef
  have hrcast : ((r : ℚ) : ℝ) = q := by
    rw [hrdef, hqzpow]
    push_cast
    ring
  have hrpos : 0 < r := by
    have hmq : (0 : ℚ) < (m : ℚ) := by exact_mod_cast hmpos
    have huq : (0 : ℚ) < (u : ℚ) := by exact_mod_cast hupos
    rw [hrdef]
    positivity
  have hrpow : r ^ k' = (m : ℚ) := by
    have : ((r ^ k' : ℚ) : ℝ) = ((m : ℚ) : ℝ) := by
      push_cast
      rw [hrcast, hqk]
    exact_mod_cast this
  obtain ⟨t, ht⟩ := exists_nat_of_rat_pow_eq_nat hrpos hk'pos hrpow
  refine ⟨t, ?_⟩
  rw [← hqdef, ← hrcast, ← ht]
  push_cast
  ring

/-- **The exponent monoid is generated by its least positive element.** -/
theorem dvd_of_mem_expNatSet {P : ℝ} {k₀ : ℕ} (hk0 : 0 < k₀)
    (hmin : ∀ j : ℕ, 0 < j → j ∈ expNatSet P → k₀ ≤ j)
    {k : ℕ} (hk : k ∈ expNatSet P) (hk₀m : k₀ ∈ expNatSet P) : k₀ ∣ k := by
  rcases Nat.eq_zero_or_pos k with rfl | hkpos
  · exact dvd_zero _
  have hgmem := gcd_mem_expNatSet hkpos hk hk₀m
  have hgpos : 0 < Nat.gcd k k₀ := Nat.gcd_pos_of_pos_left _ hkpos
  have hle := hmin _ hgpos hgmem
  have hdvd : Nat.gcd k k₀ ∣ k₀ := Nat.gcd_dvd_right _ _
  have hge : Nat.gcd k k₀ ≤ k₀ := Nat.le_of_dvd hk0 hdvd
  have heq : Nat.gcd k k₀ = k₀ := le_antisymm hge hle
  rw [← heq]
  exact Nat.gcd_dvd_left _ _

end RHTower

end
