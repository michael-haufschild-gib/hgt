import GaloisForLFunctions.RHTower.XiShiftedCanonicalAdmissionAdaptiveMixedSourceIntegralLaw
import GaloisForLFunctions.RHTower.XiShiftedCanonicalAdmissionAdaptiveMixedSourceParabolicFloor

/-!
# Reciprocal clock generated by adaptive mixed arithmetic source

The mass-normalized adaptive mixed/completed `P^sharp` source does more than decrease cumulative
Jacobi flux.  On a complete positive chamber it is the exact speed of the reciprocal normalized
flux clock.  If

`U_n = F_n / (2n+1)` and `M_n = J_n / (2n+1)`,

then the literal source law and strict projective surplus give

`(U_n⁻¹)' = M_n / U_n² = 1 + Sigma_n / U_n² > 1`.

Thus elapsed physical mass is paid strictly by the arithmetic producer before any observation or
reflection aggregation.  Integration yields an exact reciprocal-source path law and the sharp
degree-free terminal estimate `U_n(b) < 1 / (b-a)`.  Every fixed degree obtains such a chamber
unconditionally from shifted-Xi recession.
-/

open Matrix Polynomial MeasureTheory Set Filter Topology
open scoped BigOperators Interval

namespace RHTower
namespace XiShiftedCanonicalAdmission

noncomputable section

/-- Literal mass-normalized source speed measured in reciprocal normalized-flux units. -/
noncomputable def xiShiftedCanonicalAdmissionAdaptiveMixedSourceReciprocalClockDensity
    (y : ℝ) (n : ℕ) : ℝ :=
  xiShiftedCanonicalAdmissionMassNormalizedAdaptiveMixedCompletedSourceAction y n /
    xiShiftedCanonicalAdmissionRenormalizedJacobiFlux y n ^ (2 : ℕ)

/-- Reciprocal source density splits into universal unit clock plus strict projective arithmetic
surplus.  This is the nonlinear source law; no fixed linear reporter appears. -/
theorem adaptiveMixedSourceReciprocalClockDensity_eq_one_add_surplus
    {y : ℝ} (hy : 0 ≤ y) {n : ℕ}
    (hU : xiShiftedCanonicalAdmissionRenormalizedJacobiFlux y n ≠ 0) :
    xiShiftedCanonicalAdmissionAdaptiveMixedSourceReciprocalClockDensity y n =
      1 + xiShiftedCanonicalAdmissionNormalizedProjectiveSurplusDensity y n /
        xiShiftedCanonicalAdmissionRenormalizedJacobiFlux y n ^ (2 : ℕ) := by
  rw [xiShiftedCanonicalAdmissionAdaptiveMixedSourceReciprocalClockDensity,
    xiShiftedCanonicalAdmissionMassNormalizedSourceAction_eq_flux_sq_add_surplus hy]
  field_simp [hU]

/-- Exact derivative law: reciprocal normalized flux is driven by literal adaptive mixed source
divided by current squared flux. -/
theorem hasDerivAt_inv_renormalizedJacobiFlux_eq_adaptiveMixedSourceReciprocalClockDensity
    {A y : ℝ} (hA : 1 / 4 ≤ A) (hy : A < y) {n : ℕ} (hn : 0 < n)
    (hchamber : ∀ v, A < v →
      (HTGeometry.momentHankelMatrix
        (fun k => (xiShiftedReciprocalMoment v k).re) (n + 2)).PosDef) :
    HasDerivAt
      (fun v => (xiShiftedCanonicalAdmissionRenormalizedJacobiFlux v n)⁻¹)
      (xiShiftedCanonicalAdmissionAdaptiveMixedSourceReciprocalClockDensity y n) y := by
  have hA0 : 0 ≤ A := le_trans (by norm_num) hA
  have hyquarter : 1 / 4 < y := lt_of_le_of_lt hA hy
  have hUpos := xiShiftedCanonicalAdmissionRenormalizedJacobiFlux_pos_of_terminalChamber
    hA0 hy hn hchamber
  have hflow :=
    hasDerivAt_xiShiftedCanonicalAdmissionRenormalizedJacobiFlux_eq_neg_massSourceAction
      hyquarter hn (hchamber y hy)
  have hinv := hflow.inv hUpos.ne'
  apply hinv.congr_deriv
  rw [xiShiftedCanonicalAdmissionAdaptiveMixedSourceReciprocalClockDensity]
  ring

/-- Strict source-clock acceleration on every terminal positive chamber.  The unit term is forced
by Riccati self-interaction and strictness is exactly the projective arithmetic surplus. -/
theorem one_lt_adaptiveMixedSourceReciprocalClockDensity_of_terminalChamber
    {A y : ℝ} (hA : 1 / 4 ≤ A) (hy : A < y) {n : ℕ} (hn : 0 < n)
    (hchamber : ∀ v, A < v →
      (HTGeometry.momentHankelMatrix
        (fun k => (xiShiftedReciprocalMoment v k).re) (n + 2)).PosDef) :
    1 < xiShiftedCanonicalAdmissionAdaptiveMixedSourceReciprocalClockDensity y n := by
  have hA0 : 0 ≤ A := le_trans (by norm_num) hA
  have hyquarter : 1 / 4 < y := lt_of_le_of_lt hA hy
  have hUpos := xiShiftedCanonicalAdmissionRenormalizedJacobiFlux_pos_of_terminalChamber
    hA0 hy hn hchamber
  rw [adaptiveMixedSourceReciprocalClockDensity_eq_one_add_surplus
    (le_trans (by norm_num) hyquarter.le) hUpos.ne']
  have hsurplus := xiShiftedCanonicalAdmissionNormalizedProjectiveSurplusDensity_pos
    hyquarter hn (hchamber y hy)
  have hsq : 0 < xiShiftedCanonicalAdmissionRenormalizedJacobiFlux y n ^ (2 : ℕ) :=
    sq_pos_of_pos hUpos
  have hquot : 0 < xiShiftedCanonicalAdmissionNormalizedProjectiveSurplusDensity y n /
      xiShiftedCanonicalAdmissionRenormalizedJacobiFlux y n ^ (2 : ℕ) :=
    div_pos hsurplus hsq
  linarith

/-- **Exact reciprocal integral source law.**  Integrated adaptive mixed arithmetic source speed
is precisely reciprocal normalized-flux displacement.  Positivity supplies integrability. -/
theorem integral_adaptiveMixedSourceReciprocalClockDensity_eq_invFlux_drop
    {A a b : ℝ} (hA : 1 / 4 ≤ A) (hAa : A < a) (hab : a ≤ b)
    {n : ℕ} (hn : 0 < n)
    (hchamber : ∀ y, A < y →
      (HTGeometry.momentHankelMatrix
        (fun k => (xiShiftedReciprocalMoment y k).re) (n + 2)).PosDef) :
    (∫ y in a..b,
        xiShiftedCanonicalAdmissionAdaptiveMixedSourceReciprocalClockDensity y n) =
      (xiShiftedCanonicalAdmissionRenormalizedJacobiFlux b n)⁻¹ -
        (xiShiftedCanonicalAdmissionRenormalizedJacobiFlux a n)⁻¹ := by
  let C : ℝ → ℝ := fun y =>
    (xiShiftedCanonicalAdmissionRenormalizedJacobiFlux y n)⁻¹
  let K : ℝ → ℝ := fun y =>
    xiShiftedCanonicalAdmissionAdaptiveMixedSourceReciprocalClockDensity y n
  have hd : ∀ y ∈ Icc a b, HasDerivAt C (K y) y := by
    intro y hy
    exact hasDerivAt_inv_renormalizedJacobiFlux_eq_adaptiveMixedSourceReciprocalClockDensity
      hA (lt_of_lt_of_le hAa hy.1) hn hchamber
  have hcont : ContinuousOn C (uIcc a b) := by
    rw [uIcc_of_le hab]
    intro y hy
    exact (hd y hy).continuousAt.continuousWithinAt
  have hdIoo : ∀ y ∈ Ioo (min a b) (max a b), HasDerivAt C (K y) y := by
    simp only [min_eq_left hab, max_eq_right hab]
    intro y hy
    exact hd y ⟨hy.1.le, hy.2.le⟩
  have hKnonneg : ∀ y ∈ Ioo (min a b) (max a b), 0 ≤ K y := by
    simp only [min_eq_left hab, max_eq_right hab]
    intro y hy
    have hclock := one_lt_adaptiveMixedSourceReciprocalClockDensity_of_terminalChamber
      hA (lt_of_lt_of_le hAa hy.1.le) hn hchamber
    dsimp only [K]
    linarith
  have hKint : IntervalIntegrable K volume a b :=
    intervalIntegral.intervalIntegrable_deriv_of_nonneg hcont hdIoo hKnonneg
  have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt
    (fun y hy => hd y (by simpa [uIcc_of_le hab] using hy)) hKint
  simpa only [C, K] using hftc

/-- Reciprocal normalized flux advances faster than physical mass on every nontrivial terminal
interval. -/
theorem mass_lt_invFlux_drop_of_terminalChamber
    {A a b : ℝ} (hA : 1 / 4 ≤ A) (hAa : A < a) (hab : a < b)
    {n : ℕ} (hn : 0 < n)
    (hchamber : ∀ y, A < y →
      (HTGeometry.momentHankelMatrix
        (fun k => (xiShiftedReciprocalMoment y k).re) (n + 2)).PosDef) :
    b - a <
      (xiShiftedCanonicalAdmissionRenormalizedJacobiFlux b n)⁻¹ -
        (xiShiftedCanonicalAdmissionRenormalizedJacobiFlux a n)⁻¹ := by
  let G : ℝ → ℝ := fun y =>
    (xiShiftedCanonicalAdmissionRenormalizedJacobiFlux y n)⁻¹ - y
  have hGcont : ContinuousOn G (Icc a b) := by
    intro y hy
    have hd :=
      hasDerivAt_inv_renormalizedJacobiFlux_eq_adaptiveMixedSourceReciprocalClockDensity
        hA (lt_of_lt_of_le hAa hy.1) hn hchamber
    exact (hd.sub (hasDerivAt_id y)).continuousAt.continuousWithinAt
  have hGderiv : ∀ y ∈ interior (Icc a b), 0 < deriv G y := by
    intro y hy
    rw [interior_Icc] at hy
    have hd :=
      hasDerivAt_inv_renormalizedJacobiFlux_eq_adaptiveMixedSourceReciprocalClockDensity
        hA (lt_trans hAa hy.1) hn hchamber
    have hsub := hd.sub (hasDerivAt_id y)
    change 0 < deriv
      ((fun v => (xiShiftedCanonicalAdmissionRenormalizedJacobiFlux v n)⁻¹) - id) y
    rw [hsub.deriv]
    have hclock := one_lt_adaptiveMixedSourceReciprocalClockDensity_of_terminalChamber
      hA (lt_trans hAa hy.1) hn hchamber
    linarith
  have hmono : StrictMonoOn G (Icc a b) :=
    strictMonoOn_of_deriv_pos (convex_Icc a b) hGcont hGderiv
  have h := hmono (left_mem_Icc.mpr hab.le) (right_mem_Icc.mpr hab.le) hab
  dsimp only [G] at h
  linarith

/-- **Degree-free diagonal entry-capital bound.**  Terminal normalized flux at `b` is strictly
smaller than reciprocal elapsed mass, independently of degree. -/
theorem renormalizedJacobiFlux_lt_inv_massGap_of_terminalChamber
    {A a b : ℝ} (hA : 1 / 4 ≤ A) (hAa : A < a) (hab : a < b)
    {n : ℕ} (hn : 0 < n)
    (hchamber : ∀ y, A < y →
      (HTGeometry.momentHankelMatrix
        (fun k => (xiShiftedReciprocalMoment y k).re) (n + 2)).PosDef) :
    xiShiftedCanonicalAdmissionRenormalizedJacobiFlux b n < (b - a)⁻¹ := by
  have hA0 : 0 ≤ A := le_trans (by norm_num) hA
  have hUa := xiShiftedCanonicalAdmissionRenormalizedJacobiFlux_pos_of_terminalChamber
    hA0 hAa hn hchamber
  have hUb := xiShiftedCanonicalAdmissionRenormalizedJacobiFlux_pos_of_terminalChamber
    hA0 (lt_trans hAa hab) hn hchamber
  have hclock := mass_lt_invFlux_drop_of_terminalChamber hA hAa hab hn hchamber
  have hgap : 0 < b - a := sub_pos.mpr hab
  have hinvUa : 0 <
      (xiShiftedCanonicalAdmissionRenormalizedJacobiFlux a n)⁻¹ := inv_pos.mpr hUa
  have hltInv : b - a <
      (xiShiftedCanonicalAdmissionRenormalizedJacobiFlux b n)⁻¹ := by linarith
  have hprod : (b - a) *
      xiShiftedCanonicalAdmissionRenormalizedJacobiFlux b n < 1 :=
    (lt_div_iff₀ hUb).1 (by simpa only [inv_eq_one_div] using hltInv)
  rw [inv_eq_one_div]
  apply (lt_div_iff₀ hgap).2
  nlinarith

/-- Actual cumulative flux has only forced trace multiplicity left after reciprocal-clock
contraction. -/
theorem cumulativeJacobiFlux_lt_degreeWeight_div_massGap_of_terminalChamber
    {A a b : ℝ} (hA : 1 / 4 ≤ A) (hAa : A < a) (hab : a < b)
    {n : ℕ} (hn : 0 < n)
    (hchamber : ∀ y, A < y →
      (HTGeometry.momentHankelMatrix
        (fun k => (xiShiftedReciprocalMoment y k).re) (n + 2)).PosDef) :
    xiShiftedCanonicalAdmissionCumulativeJacobiFlux b n <
      (2 * n + 1 : ℝ) / (b - a) := by
  have hU := renormalizedJacobiFlux_lt_inv_massGap_of_terminalChamber
    hA hAa hab hn hchamber
  have hc : 0 < (2 * n + 1 : ℝ) := by positivity
  rw [xiShiftedCanonicalAdmissionRenormalizedJacobiFlux] at hU
  have hmul := mul_lt_mul_of_pos_left hU hc
  field_simp [hc.ne'] at hmul
  simpa only [inv_eq_one_div] using hmul

/-- **Sharp terminal-boundary clock law.**  The singular endpoint need not itself carry positive
admission.  Letting the interior clock origin approach it gives the closed optimal estimate
`(b-A) U_n(b) ≤ 1`. -/
theorem massGap_mul_renormalizedJacobiFlux_le_one_of_terminalChamber
    {A b : ℝ} (hA : 1 / 4 ≤ A) (hAb : A < b)
    {n : ℕ} (hn : 0 < n)
    (hchamber : ∀ y, A < y →
      (HTGeometry.momentHankelMatrix
        (fun k => (xiShiftedReciprocalMoment y k).re) (n + 2)).PosDef) :
    (b - A) * xiShiftedCanonicalAdmissionRenormalizedJacobiFlux b n ≤ 1 := by
  have hA0 : 0 ≤ A := le_trans (by norm_num) hA
  have hU := xiShiftedCanonicalAdmissionRenormalizedJacobiFlux_pos_of_terminalChamber
    hA0 hAb hn hchamber
  by_contra hnot
  have hlarge : 1 <
      (b - A) * xiShiftedCanonicalAdmissionRenormalizedJacobiFlux b n :=
    lt_of_not_ge hnot
  let q : ℝ := (xiShiftedCanonicalAdmissionRenormalizedJacobiFlux b n)⁻¹
  have hqpos : 0 < q := inv_pos.mpr hU
  have hqgap : q < b - A := by
    dsimp only [q]
    rw [inv_eq_one_div]
    exact (div_lt_iff₀ hU).2 hlarge
  let a : ℝ := A + ((b - A) - q) / 2
  have hAa : A < a := by dsimp only [a]; linarith
  have hab : a < b := by dsimp only [a]; linarith
  have hbound := renormalizedJacobiFlux_lt_inv_massGap_of_terminalChamber
    hA hAa hab hn hchamber
  have hprod : xiShiftedCanonicalAdmissionRenormalizedJacobiFlux b n * (b - a) < 1 := by
    exact (lt_div_iff₀ (sub_pos.mpr hab)).1 (by simpa only [inv_eq_one_div] using hbound)
  have hqinverse : q * xiShiftedCanonicalAdmissionRenormalizedJacobiFlux b n = 1 := by
    dsimp only [q]
    exact inv_mul_cancel₀ hU.ne'
  have hgapq : q < b - a := by dsimp only [a]; linarith
  nlinarith [mul_lt_mul_of_pos_left hgapq hU]

/-- Actual cumulative entry flux at a terminal boundary has only forced trace multiplicity as
capital. -/
theorem massGap_mul_cumulativeJacobiFlux_le_degreeWeight_of_terminalChamber
    {A b : ℝ} (hA : 1 / 4 ≤ A) (hAb : A < b)
    {n : ℕ} (hn : 0 < n)
    (hchamber : ∀ y, A < y →
      (HTGeometry.momentHankelMatrix
        (fun k => (xiShiftedReciprocalMoment y k).re) (n + 2)).PosDef) :
    (b - A) * xiShiftedCanonicalAdmissionCumulativeJacobiFlux b n ≤
      (2 * n + 1 : ℝ) := by
  have hclock := massGap_mul_renormalizedJacobiFlux_le_one_of_terminalChamber
    hA hAb hn hchamber
  have hc : 0 < (2 * n + 1 : ℝ) := by positivity
  rw [xiShiftedCanonicalAdmissionRenormalizedJacobiFlux] at hclock
  calc
    (b - A) * xiShiftedCanonicalAdmissionCumulativeJacobiFlux b n =
        ((b - A) *
          (xiShiftedCanonicalAdmissionCumulativeJacobiFlux b n / (2 * n + 1 : ℝ))) *
            (2 * n + 1 : ℝ) := by field_simp [hc.ne']
    _ ≤ 1 * (2 * n + 1 : ℝ) := mul_le_mul_of_nonneg_right hclock hc.le
    _ = (2 * n + 1 : ℝ) := one_mul _

/-- **Strict-frontier rung-spacing law.**  Consecutive canonical frontier gap times normalized
entry flux at its right endpoint is at most one.  This is diagonal degree--mass information, not a
chosen schedule. -/
theorem strictFrontierGap_mul_renormalizedJacobiFlux_le_one
    {n : ℕ}
    (hphysical : 1 / 4 ≤ xiShiftedHigherBlockTerminalFrontier (n + 1))
    (hstrict : xiShiftedHigherBlockTerminalFrontier (n + 1) <
      xiShiftedHigherBlockTerminalFrontier (n + 2)) :
    (xiShiftedHigherBlockTerminalFrontier (n + 2) -
        xiShiftedHigherBlockTerminalFrontier (n + 1)) *
      xiShiftedCanonicalAdmissionRenormalizedJacobiFlux
        (xiShiftedHigherBlockTerminalFrontier (n + 2)) (n + 1) ≤ 1 := by
  let A := xiShiftedHigherBlockTerminalFrontier (n + 1)
  have hA0 : 0 ≤ A := le_trans (by norm_num) hphysical
  have hchamber : ∀ y, A < y →
      (HTGeometry.momentHankelMatrix
        (fun k => (xiShiftedReciprocalMoment y k).re) ((n + 1) + 2)).PosDef := by
    intro y hy
    exact xiShiftedHigherBlock_posDef_of_terminalFrontier_lt
      (le_trans hA0 hy.le) hy
  exact massGap_mul_renormalizedJacobiFlux_le_one_of_terminalChamber
    hphysical hstrict (by omega) hchamber

/-- Cumulative-flux form of the canonical rung-spacing constraint. -/
theorem strictFrontierGap_mul_cumulativeJacobiFlux_le_degreeWeight
    {n : ℕ}
    (hphysical : 1 / 4 ≤ xiShiftedHigherBlockTerminalFrontier (n + 1))
    (hstrict : xiShiftedHigherBlockTerminalFrontier (n + 1) <
      xiShiftedHigherBlockTerminalFrontier (n + 2)) :
    (xiShiftedHigherBlockTerminalFrontier (n + 2) -
        xiShiftedHigherBlockTerminalFrontier (n + 1)) *
      xiShiftedCanonicalAdmissionCumulativeJacobiFlux
        (xiShiftedHigherBlockTerminalFrontier (n + 2)) (n + 1) ≤
      (2 * (n + 1) + 1 : ℝ) := by
  let A := xiShiftedHigherBlockTerminalFrontier (n + 1)
  have hA0 : 0 ≤ A := le_trans (by norm_num) hphysical
  have hchamber : ∀ y, A < y →
      (HTGeometry.momentHankelMatrix
        (fun k => (xiShiftedReciprocalMoment y k).re) ((n + 1) + 2)).PosDef := by
    intro y hy
    exact xiShiftedHigherBlock_posDef_of_terminalFrontier_lt
      (le_trans hA0 hy.le) hy
  simpa only [Nat.cast_add, Nat.cast_one] using
    (massGap_mul_cumulativeJacobiFlux_le_degreeWeight_of_terminalChamber
      hphysical hstrict (by omega) hchamber)

/-- **Unconditional fixed-degree reciprocal source clock.**  Every positive degree eventually
enters a chamber where exact integral source transport, strict clock separation, and the
degree-free terminal flux bound all hold on every later interval. -/
theorem exists_terminalAdaptiveMixedSourceReciprocalClock
    {n : ℕ} (hn : 0 < n) :
    ∃ A : ℝ, 1 / 4 ≤ A ∧
      ∀ a b, A < a → a < b →
        (∫ y in a..b,
            xiShiftedCanonicalAdmissionAdaptiveMixedSourceReciprocalClockDensity y n) =
          (xiShiftedCanonicalAdmissionRenormalizedJacobiFlux b n)⁻¹ -
            (xiShiftedCanonicalAdmissionRenormalizedJacobiFlux a n)⁻¹ ∧
        b - a <
          (xiShiftedCanonicalAdmissionRenormalizedJacobiFlux b n)⁻¹ -
            (xiShiftedCanonicalAdmissionRenormalizedJacobiFlux a n)⁻¹ ∧
        xiShiftedCanonicalAdmissionRenormalizedJacobiFlux b n < (b - a)⁻¹ := by
  obtain ⟨A₀, hA₀, hchamber₀⟩ := exists_xiShiftedCanonicalAdmissionTerminalChamber n
  let A : ℝ := max A₀ (1 / 4)
  have hA : 1 / 4 ≤ A := le_max_right _ _
  have hA₀A : A₀ ≤ A := le_max_left _ _
  have hchamber : ∀ y, A < y →
      (HTGeometry.momentHankelMatrix
        (fun k => (xiShiftedReciprocalMoment y k).re) (n + 2)).PosDef := by
    intro y hy
    exact hchamber₀ y (lt_of_le_of_lt hA₀A hy)
  refine ⟨A, hA, ?_⟩
  intro a b hAa hab
  refine ⟨integral_adaptiveMixedSourceReciprocalClockDensity_eq_invFlux_drop
      hA hAa hab.le hn hchamber, ?_, ?_⟩
  · exact mass_lt_invFlux_drop_of_terminalChamber hA hAa hab hn hchamber
  · exact renormalizedJacobiFlux_lt_inv_massGap_of_terminalChamber
      hA hAa hab hn hchamber

/-! ### Hostile audit: raw clock has a two-unit arcsine vacuum -/

/-- Remove the exact fixed-degree arcsine vacuum from reciprocal source speed.  This is the only
candidate left for finite diagonal clock capital; no sign is asserted. -/
noncomputable def xiShiftedCanonicalAdmissionVacuumRenormalizedSourceReciprocalClockDensity
    (y : ℝ) (n : ℕ) : ℝ :=
  xiShiftedCanonicalAdmissionAdaptiveMixedSourceReciprocalClockDensity y n - 2

/-- Actual reciprocal source speed is one plus the scale-free dimensionless projective arithmetic
work rate.  Exact coordinate weights cancel; this is not an asymptotic identification. -/
theorem adaptiveMixedSourceReciprocalClockDensity_sq_eq_one_add_dimensionlessWorkRate
    {w : ℝ} (hw : 1 < w) {n : ℕ} (hn : 0 < n)
    (hA : (HTGeometry.momentHankelMatrix
      (xiShiftedRealMomentSequence w) (n + 4)).PosDef)
    (hF : xiShiftedCanonicalAdmissionCumulativeJacobiFlux (w ^ (2 : ℕ)) n ≠ 0) :
    xiShiftedCanonicalAdmissionAdaptiveMixedSourceReciprocalClockDensity (w ^ (2 : ℕ)) n =
      1 + dimensionlessProjectiveArithmeticWorkRate w n := by
  have hN0 := xiShiftedFarRightNormalizedHankelMatrix_posDef_of_actual hw (n + 4) hA
  have hN : (HTGeometry.momentHankelMatrix
      (xiShiftedFarRightNormalizedMoment w) (n + 4)).PosDef := by
    simpa only [xiShiftedFarRightNormalizedHankelMatrix] using hN0
  have hAsmall : (HTGeometry.momentHankelMatrix
      (xiShiftedRealMomentSequence w) (n + 2)).PosDef :=
    momentHankel_posDef_of_le (by omega) hA
  have hNsmall : (HTGeometry.momentHankelMatrix
      (xiShiftedFarRightNormalizedMoment w) (n + 2)).PosDef :=
    momentHankel_posDef_of_le (by omega) hN
  have hD := dimensionlessCumulativeJacobiDissipation_eq_fourth_mul_actual hw hA
  have hFscale := dimensionlessCumulativeJacobiFlux_eq_square_mul_actual
    hw hn hN hA
  have hPiActual :=
    xiShiftedCanonicalAdmissionProjectiveArithmeticSurplus_eq_cauchyGap
      (lt_trans (by norm_num) hw) hn hAsmall
  have hPiDim := dimensionlessProjectiveArithmeticSurplus_eq_cauchyGap
    hw hn hNsmall
  have hPiScale : dimensionlessProjectiveArithmeticSurplus w n =
      w ^ (4 : ℕ) * xiShiftedCanonicalAdmissionProjectiveArithmeticSurplus w n := by
    rw [hPiDim, hPiActual, hD, hFscale]
    ring
  have hU : xiShiftedCanonicalAdmissionRenormalizedJacobiFlux (w ^ (2 : ℕ)) n ≠ 0 := by
    rw [xiShiftedCanonicalAdmissionRenormalizedJacobiFlux]
    exact div_ne_zero hF (by positivity)
  rw [adaptiveMixedSourceReciprocalClockDensity_eq_one_add_surplus
    (sq_nonneg w) hU]
  unfold xiShiftedCanonicalAdmissionNormalizedProjectiveSurplusDensity
  rw [Real.sqrt_sq_eq_abs, abs_of_pos (lt_trans zero_lt_one hw)]
  unfold xiShiftedCanonicalAdmissionRenormalizedJacobiFlux
  unfold dimensionlessProjectiveArithmeticWorkRate
  rw [hPiScale, hFscale]
  field_simp [hF, ne_of_gt (lt_trans zero_lt_one hw)]

/-- Fixed-degree raw reciprocal source speed converges to exactly two: one Riccati unit and one
projective arcsine-work unit. -/
theorem tendsto_adaptiveMixedSourceReciprocalClockDensity_squareParam_two
    {n : ℕ} (hn : 0 < n) :
    Tendsto
      (fun w : ℝ =>
        xiShiftedCanonicalAdmissionAdaptiveMixedSourceReciprocalClockDensity (w ^ (2 : ℕ)) n)
      atTop (nhds 2) := by
  have hwork := tendsto_dimensionlessProjectiveArithmeticWorkRate_one hn.ne'
  have htarget : Tendsto
      (fun w : ℝ => 1 + dimensionlessProjectiveArithmeticWorkRate w n)
      atTop (nhds 2) := by
    have hone : Tendsto (fun _w : ℝ => (1 : ℝ)) atTop (nhds 1) :=
      tendsto_const_nhds
    simpa only [one_add_one_eq_two] using hone.add hwork
  obtain ⟨A, hA, hchamber⟩ := exists_xiShiftedCanonicalAdmissionTerminalChamber n
  apply htarget.congr'
  filter_upwards [xiShiftedMomentHankelMatrix_squareParam_posDef_eventually (n + 4),
    eventually_gt_atTop (max 1 (Real.sqrt A))] with w hblock hw
  have hw1 : 1 < w := lt_of_le_of_lt (le_max_left _ _) hw
  have hsqrtw : Real.sqrt A < w := lt_of_le_of_lt (le_max_right _ _) hw
  have hAw : A < w ^ (2 : ℕ) := by
    have hsqrtSq : (Real.sqrt A) ^ (2 : ℕ) = A := Real.sq_sqrt hA
    have hw0 : 0 < w := lt_trans zero_lt_one hw1
    nlinarith [Real.sqrt_nonneg A]
  have hUpos := xiShiftedCanonicalAdmissionRenormalizedJacobiFlux_pos_of_terminalChamber
    hA hAw hn hchamber
  have hF : xiShiftedCanonicalAdmissionCumulativeJacobiFlux (w ^ (2 : ℕ)) n ≠ 0 := by
    intro hzero
    rw [xiShiftedCanonicalAdmissionRenormalizedJacobiFlux, hzero, zero_div] at hUpos
    exact (lt_irrefl 0) hUpos
  exact (adaptiveMixedSourceReciprocalClockDensity_sq_eq_one_add_dimensionlessWorkRate
    hw1 hn hblock hF).symm

/-- After removing both forced vacuum units, fixed-degree reciprocal source speed tends to zero. -/
theorem tendsto_vacuumRenormalizedSourceReciprocalClockDensity_squareParam_zero
    {n : ℕ} (hn : 0 < n) :
    Tendsto
      (fun w : ℝ =>
        xiShiftedCanonicalAdmissionVacuumRenormalizedSourceReciprocalClockDensity
          (w ^ (2 : ℕ)) n)
      atTop (nhds 0) := by
  have hconst : Tendsto (fun _w : ℝ => (2 : ℝ)) atTop (nhds 2) :=
    tendsto_const_nhds
  simpa only [xiShiftedCanonicalAdmissionVacuumRenormalizedSourceReciprocalClockDensity,
    sub_self] using
    (tendsto_adaptiveMixedSourceReciprocalClockDensity_squareParam_two hn).sub
      hconst

/-- Vacuum-renormalized reciprocal source density is the exact derivative of reciprocal flux
after subtraction of two units of physical mass clock. -/
theorem hasDerivAt_inv_renormalizedJacobiFlux_sub_two_mass_eq_vacuumRenormalizedSourceClock
    {A y : ℝ} (hA : 1 / 4 ≤ A) (hy : A < y) {n : ℕ} (hn : 0 < n)
    (hchamber : ∀ v, A < v →
      (HTGeometry.momentHankelMatrix
        (fun k => (xiShiftedReciprocalMoment v k).re) (n + 2)).PosDef) :
    HasDerivAt
      (fun v => (xiShiftedCanonicalAdmissionRenormalizedJacobiFlux v n)⁻¹ - 2 * v)
      (xiShiftedCanonicalAdmissionVacuumRenormalizedSourceReciprocalClockDensity y n) y := by
  have hinv :=
    hasDerivAt_inv_renormalizedJacobiFlux_eq_adaptiveMixedSourceReciprocalClockDensity
      hA hy hn hchamber
  have hlinear := (hasDerivAt_id y).const_mul 2
  have h := hinv.sub hlinear
  have hfun :
      ((fun v => (xiShiftedCanonicalAdmissionRenormalizedJacobiFlux v n)⁻¹) -
          fun v => 2 * id v) =
        (fun v => (xiShiftedCanonicalAdmissionRenormalizedJacobiFlux v n)⁻¹ - 2 * v) := by
    funext v
    rfl
  rw [hfun] at h
  simpa only [xiShiftedCanonicalAdmissionVacuumRenormalizedSourceReciprocalClockDensity,
    mul_one] using h

/-- **Raw-clock finite-capital no-go.**  Source reciprocal speed is everywhere larger than one on
a terminal ray, so it cannot be integrable there.  Any common diagonal budget must first remove
the two-unit arcsine vacuum. -/
theorem not_integrableOn_Ioi_adaptiveMixedSourceReciprocalClockDensity
    {A a : ℝ} (hA : 1 / 4 ≤ A) (hAa : A < a) {n : ℕ} (hn : 0 < n)
    (hchamber : ∀ y, A < y →
      (HTGeometry.momentHankelMatrix
        (fun k => (xiShiftedReciprocalMoment y k).re) (n + 2)).PosDef) :
    ¬IntegrableOn
      (fun y => xiShiftedCanonicalAdmissionAdaptiveMixedSourceReciprocalClockDensity y n)
      (Ioi a) := by
  intro hint
  have hone : IntegrableOn (fun _ : ℝ => (1 : ℝ)) (Ioi a) := by
    refine hint.mono' aestronglyMeasurable_const ?_
    refine (ae_restrict_iff' measurableSet_Ioi).mpr
      (Filter.Eventually.of_forall fun y hy => ?_)
    have hclock := one_lt_adaptiveMixedSourceReciprocalClockDensity_of_terminalChamber
      hA (lt_trans hAa hy) hn hchamber
    rw [Real.norm_eq_abs, abs_of_pos]
    · exact hclock.le
    · linarith
  rw [IntegrableOn, integrable_const_iff] at hone
  rcases hone with hzero | hfinite
  · exact one_ne_zero hzero
  · haveI := hfinite
    have hfin := measure_lt_top (volume.restrict (Ioi a)) univ
    rw [Measure.restrict_apply_univ, Real.volume_Ioi] at hfin
    exact (lt_irrefl _) hfin

end
