import GaloisForLFunctions.RHTower.XiFiniteMarkedFields
import GaloisForLFunctions.HTGeometry.QuadraticRootConjugation

/-!
# The common quadratic class is unramified over the finite plane

Let `F` be a field over the global meromorphic field `K` carrying a marking `u² = ξ F_n`.  The
element `a = 1 - 2d_n + 2iβ_n u` has the polynomial inverse `1 - 2d_n - 2iβ_n u` and
`ξ = a (u - iβ_n ξ)²`.  A place of `F` over the finite plane is a valuation which is at most one on
every entire function.  At every such place `a` is a unit, so `ξ` has even order there and the
quadratic extension `F(√ξ) = F(√a)` is generated by the square root of a unit: it is unramified at
every finite place.  This applies to every finite marked field `L_T` with `T` nonempty.

On the common cover `L_T(√ξ)` put `v² = ξ`, `w_n = u_n / v` (so `w_n² = F_n`) and
`U_n = w_n + iβ_n v`.  Then `U_n (w_n - iβ_n v) = w_n² + β_n² v² = 1`, so a point of the cover
never has `v = w_n = 0`; `U_n² = a_n`; the deck involution `v ↦ -v` sends `U_n` to `-U_n`; the
ratios `U_p / U_q` lie in `L_T` although no `U_n` does; and
`(U_p - U_p⁻¹)/(U_q - U_q⁻¹) = β_p/β_q`.
-/

noncomputable section
namespace RHTower.XiGlobalKummer
open GaloisForLFunctions.HTGeometry
open scoped IntermediateField

local instance : CharZero K := charZero_of_injective_algebraMap constPlane_injective

private theorem unit_core {R : Type*} [CommRing R] {b xi' fa u' i' : R}
    (hbf : b ^ 2 * xi' + fa = 1) (hu : u' * u' = xi' * fa) (hi : i' ^ 2 = -1) :
    (1 - 2 * (b ^ 2 * xi') + 2 * i' * b * u') * (1 - 2 * (b ^ 2 * xi') - 2 * i' * b * u') = 1 ∧
      (1 - 2 * (b ^ 2 * xi') + 2 * i' * b * u') * (u' - i' * b * xi') ^ 2 = xi' := by
  constructor
  · linear_combination (-4 * b ^ 2 * u' ^ 2) * hi + 4 * b ^ 2 * hu + 4 * b ^ 2 * xi' * hbf
  · set a := 1 - 2 * (b ^ 2 * xi') + 2 * i' * b * u'
    linear_combination (a * xi' + 4 * b ^ 2 * xi' ^ 2) * hbf +
      (a * b ^ 2 * xi' ^ 2 - 4 * b ^ 2 * u' ^ 2 * xi') * hi + (a + 4 * b ^ 2 * xi') * hu

section Marking
variable {F : Type*} [Field F] [Algebra K F]

/-- The Kummer unit `a = 1 - 2d_n + 2iβ_n u` attached to a marking `u`. -/
def markingUnit (n : ℕ) (u : F) : F :=
  1 - 2 * algebraMap K F (betaElement n ^ 2 * xiElement) +
    2 * algebraMap K F (constPlane Complex.I) * algebraMap K F (betaElement n) * u

/-- Its polynomial inverse `1 - 2d_n - 2iβ_n u`. -/
def markingUnitInv (n : ℕ) (u : F) : F :=
  1 - 2 * algebraMap K F (betaElement n ^ 2 * xiElement) -
    2 * algebraMap K F (constPlane Complex.I) * algebraMap K F (betaElement n) * u

private theorem marking_relations (n : ℕ) {u : F} (hu : u * u = algebraMap K F (radicand n)) :
    algebraMap K F (betaElement n) ^ 2 * algebraMap K F xiElement +
        algebraMap K F (factorElement (n + 2)) = 1 ∧
      u * u = algebraMap K F xiElement * algebraMap K F (factorElement (n + 2)) ∧
      algebraMap K F (constPlane Complex.I) ^ 2 = -1 := by
  have hbf := congrArg (algebraMap K F) (betaElement_sq_mul_xi n)
  simp only [map_mul, map_pow, map_sub, map_one] at hbf
  refine ⟨by linear_combination hbf, by rw [hu, radicand, map_mul], ?_⟩
  rw [← map_pow, ← map_pow, Complex.I_sq, map_neg, map_one, map_neg, map_one]

theorem markingUnit_mul_inv (n : ℕ) {u : F} (hu : u * u = algebraMap K F (radicand n)) :
    markingUnit n u * markingUnitInv n u = 1 := by
  obtain ⟨h1, h2, h3⟩ := marking_relations n hu
  simp only [markingUnit, markingUnitInv, map_mul, map_pow]
  exact (unit_core h1 h2 h3).1

/-- `ξ = a (u - iβ_n ξ)²`. -/
theorem markingUnit_mul_sq (n : ℕ) {u : F} (hu : u * u = algebraMap K F (radicand n)) :
    markingUnit n u * (u - algebraMap K F (constPlane Complex.I) * algebraMap K F (betaElement n) *
      algebraMap K F xiElement) ^ 2 = algebraMap K F xiElement := by
  obtain ⟨h1, h2, h3⟩ := marking_relations n hu
  simp only [markingUnit, map_mul, map_pow]
  exact (unit_core h1 h2 h3).2

/-- A place over the finite plane: a valuation at most one on every entire function. -/
def IsFinitePlace {Γ₀ : Type*} [LinearOrderedCommGroupWithZero Γ₀] (v : Valuation F Γ₀) : Prop :=
  ∀ (f : ℂ → ℂ) (hf : Differentiable ℂ f),
    v (algebraMap K F (ofMeromorphic f (fun z => (hf.analyticAt z).meromorphicAt))) ≤ 1

variable {Γ₀ : Type*} [LinearOrderedCommGroupWithZero Γ₀] {v : Valuation F Γ₀}

private theorem const_mem (hv : IsFinitePlace v) (c : ℂ) :
    algebraMap K F (constPlane c) ∈ v.integer :=
  hv (fun _ => c) (differentiable_const c)

private theorem le_one_of_mul_self_le_one {x : Γ₀} (h : x * x ≤ 1) : x ≤ 1 := by
  by_contra hx
  push Not at hx
  exact absurd h (not_le.mpr (lt_of_lt_of_le hx (le_mul_of_one_le_right' hx.le)))

private theorem eq_one_of_mul_eq_one {x y : Γ₀} (hx : x ≤ 1) (hy : y ≤ 1) (h : x * y = 1) :
    x = 1 := by
  refine le_antisymm hx ?_
  calc (1 : Γ₀) = x * y := h.symm
    _ ≤ x * 1 := by gcongr
    _ = x := mul_one x

/-- **The Kummer unit is a unit at every finite place.** -/
theorem valuation_markingUnit (hv : IsFinitePlace v) (n : ℕ) {u : F}
    (hu : u * u = algebraMap K F (radicand n)) :
    v (markingUnit n u) = 1 ∧ v (markingUnitInv n u) = 1 := by
  have hxi : algebraMap K F xiElement ∈ v.integer := hv xi xi_differentiable
  have hβ : algebraMap K F (betaElement n) ∈ v.integer := hv (beta n) (beta_differentiable n)
  have hF : algebraMap K F (factorElement (n + 2)) ∈ v.integer :=
    hv (deletionFactor (n + 2)) (deletionFactor_differentiable (n + 2))
  have hI := const_mem hv Complex.I
  have hu' : u ∈ v.integer := by
    apply le_one_of_mul_self_le_one
    rw [← map_mul, hu, radicand, map_mul]
    exact v.integer.mul_mem hxi hF
  have h2 : (2 : F) ∈ v.integer := by simp
  have ha : markingUnit n u ∈ v.integer := by
    simp only [markingUnit, map_mul, map_pow]
    exact v.integer.add_mem (v.integer.sub_mem v.integer.one_mem
      (v.integer.mul_mem h2 (v.integer.mul_mem (v.integer.pow_mem hβ 2) hxi)))
      (v.integer.mul_mem (v.integer.mul_mem (v.integer.mul_mem h2 hI) hβ) hu')
  have ha' : markingUnitInv n u ∈ v.integer := by
    simp only [markingUnitInv, map_mul, map_pow]
    exact v.integer.sub_mem (v.integer.sub_mem v.integer.one_mem
      (v.integer.mul_mem h2 (v.integer.mul_mem (v.integer.pow_mem hβ 2) hxi)))
      (v.integer.mul_mem (v.integer.mul_mem (v.integer.mul_mem h2 hI) hβ) hu')
  have hprod : v (markingUnit n u) * v (markingUnitInv n u) = 1 := by
    rw [← map_mul, markingUnit_mul_inv n hu, map_one]
  exact ⟨eq_one_of_mul_eq_one ha ha' hprod,
    eq_one_of_mul_eq_one ha' ha (by rw [mul_comm]; exact hprod)⟩

/-- **Even order of `ξ` at every finite place.** -/
theorem valuation_xi_eq_sq (hv : IsFinitePlace v) (n : ℕ) {u : F}
    (hu : u * u = algebraMap K F (radicand n)) :
    v (algebraMap K F xiElement) = v (u - algebraMap K F (constPlane Complex.I) *
      algebraMap K F (betaElement n) * algebraMap K F xiElement) ^ 2 := by
  conv_lhs => rw [← markingUnit_mul_sq n hu]
  rw [map_mul, (valuation_markingUnit hv n hu).1, one_mul, map_pow]

/-- The discriminant `4a` of `X² - a` is a unit at every finite place. -/
theorem valuation_discriminant (hv : IsFinitePlace v) (n : ℕ) {u : F}
    (hu : u * u = algebraMap K F (radicand n)) : v (4 * markingUnit n u) = 1 := by
  haveI : CharZero F := charZero_of_injective_algebraMap (algebraMap K F).injective
  have h4 : v (4 : F) = 1 := by
    have hc : algebraMap K F (constPlane 4) = 4 := by rw [map_ofNat, map_ofNat]
    have hc' : algebraMap K F (constPlane 4⁻¹) = 4⁻¹ := by rw [map_inv₀, map_inv₀, hc]
    have h1 : v (4 : F) ≤ 1 := hc ▸ const_mem hv 4
    have h2 : v (4⁻¹ : F) ≤ 1 := hc' ▸ const_mem hv 4⁻¹
    refine eq_one_of_mul_eq_one h1 h2 ?_
    rw [← map_mul, mul_inv_cancel₀ (by norm_num : (4 : F) ≠ 0), map_one]
  rw [map_mul, h4, one_mul, (valuation_markingUnit hv n hu).1]

end Marking

/-! ## The finite marked fields -/

/-- The marking `u_n = √(ξ F_n)` of `L_T`, `n ∈ T`. -/
def finiteMarking (T : Finset ℕ) {n : ℕ} (hn : n ∈ T) : finiteMarkedExtension T :=
  ⟨root n, root_mem_finiteMarkedExtension hn⟩

/-- **Unramified at every finite place.**  For `n ∈ T`, `a_n` is a unit of `L_T` at every place over
the finite plane, the discriminant of `X² - a_n` is a unit there, `ξ = a_n t²` has even order there,
and `L_T(√ξ) = L_T(√a_n)`. -/
theorem finiteMarked_unramified (T : Finset ℕ) {n : ℕ} (hn : n ∈ T) :
    (∀ (Γ₀ : Type*) [LinearOrderedCommGroupWithZero Γ₀]
        (v : Valuation (finiteMarkedExtension T) Γ₀),
        IsFinitePlace v →
          v (markingUnit n (finiteMarking T hn)) = 1 ∧
          v (4 * markingUnit n (finiteMarking T hn)) = 1 ∧
          ∃ t : finiteMarkedExtension T, v (algebraMap K _ xiElement) = v t ^ 2) ∧
      ∃ s : Ω, s * s = algebraMap (finiteMarkedExtension T) Ω (markingUnit n (finiteMarking T hn)) ∧
        (finiteMarkedExtension T)⟮s⟯ = (finiteMarkedExtension T)⟮xiRoot⟯ := by
  have hu : finiteMarking T hn * finiteMarking T hn =
      algebraMap K (finiteMarkedExtension T) (radicand n) := finiteMarking_sq T hn
  refine ⟨fun Γ₀ _ v hv => ⟨(valuation_markingUnit hv n hu).1, valuation_discriminant hv n hu,
    _, valuation_xi_eq_sq hv n hu⟩, ?_⟩
  set L := finiteMarkedExtension T
  set t : L := finiteMarking T hn - algebraMap K L (constPlane Complex.I) *
    algebraMap K L (betaElement n) * algebraMap K L xiElement
  have hsq := markingUnit_mul_sq n hu
  have ht : t ≠ 0 := by
    intro h0
    have : algebraMap K L xiElement = 0 := by rw [← hsq]; change _ * t ^ 2 = 0; rw [h0]; ring
    exact xiElement_ne_zero ((map_eq_zero_iff _ (algebraMap K L).injective).mp this)
  have htΩ : algebraMap L Ω t ≠ 0 := (map_ne_zero _).mpr ht
  set s := xiRoot / algebraMap L Ω t with hs
  refine ⟨s, ?_, ?_⟩
  · have hx : xiRoot * xiRoot = algebraMap L Ω (algebraMap K L xiElement) := by
      rw [xiRoot_sq, IsScalarTower.algebraMap_apply K L Ω]
    rw [hs, div_mul_div_comm, hx, ← hsq, map_mul, map_pow, div_eq_iff (mul_ne_zero htΩ htΩ)]
    ring
  · apply le_antisymm
    · rw [IntermediateField.adjoin_simple_le_iff]
      exact div_mem (IntermediateField.mem_adjoin_simple_self _ _)
        (IntermediateField.algebraMap_mem _ t)
    · rw [IntermediateField.adjoin_simple_le_iff]
      have he : xiRoot = s * algebraMap L Ω t := by
        rw [hs, div_mul_cancel₀ _ htΩ]
      rw [he]
      exact mul_mem (IntermediateField.mem_adjoin_simple_self _ _)
        (IntermediateField.algebraMap_mem _ t)

/-! ## Units on the common cover -/

theorem xiRoot_closure_ne_zero : xiRoot ≠ 0 := fun h => by
  have hx := xiRoot_sq
  rw [h, zero_mul] at hx
  exact xiElement_ne_zero ((map_eq_zero_iff _ (algebraMap K Ω).injective).mp hx.symm)

/-- `w_n = u_n / √ξ`, a square root of `F_n` on the common cover. -/
def coverW (n : ℕ) : Ω := root n / xiRoot

theorem coverW_sq (n : ℕ) : coverW n * coverW n = algebraMap K Ω (factorElement (n + 2)) := by
  have hu := root_sq n
  rw [radicand, map_mul] at hu
  rw [coverW, div_mul_div_comm, hu, xiRoot_sq, mul_div_cancel_left₀ _
    ((map_ne_zero _).mpr xiElement_ne_zero)]

private theorem iota_sq : algebraMap K Ω (constPlane Complex.I) ^ 2 = -1 := by
  rw [← map_pow, ← map_pow, Complex.I_sq, map_neg, map_one, map_neg, map_one]

private theorem beta_xi_add_factor (n : ℕ) :
    algebraMap K Ω (betaElement n) ^ 2 * algebraMap K Ω xiElement +
      algebraMap K Ω (factorElement (n + 2)) = 1 := by
  have hbf := congrArg (algebraMap K Ω) (betaElement_sq_mul_xi n)
  simp only [map_mul, map_pow, map_sub, map_one] at hbf
  linear_combination hbf

/-- `U_n = w_n + iβ_n √ξ`. -/
def coverUnit (n : ℕ) : Ω :=
  coverW n + algebraMap K Ω (constPlane Complex.I) * algebraMap K Ω (betaElement n) * xiRoot

/-- `U_n⁻¹ = w_n - iβ_n √ξ`. -/
def coverUnitInv (n : ℕ) : Ω :=
  coverW n - algebraMap K Ω (constPlane Complex.I) * algebraMap K Ω (betaElement n) * xiRoot

/-- `w_n² + (β_n √ξ)² = 1`: no point of the cover has `√ξ = w_n = 0`. -/
theorem coverW_sq_add_sq (n : ℕ) :
    coverW n ^ 2 + (algebraMap K Ω (betaElement n) * xiRoot) ^ 2 = 1 := by
  linear_combination coverW_sq n + algebraMap K Ω (betaElement n) ^ 2 * xiRoot_sq +
    beta_xi_add_factor n

theorem coverUnit_mul_inv (n : ℕ) : coverUnit n * coverUnitInv n = 1 := by
  simp only [coverUnit, coverUnitInv]
  linear_combination coverW_sq_add_sq n -
    algebraMap K Ω (betaElement n) ^ 2 * xiRoot ^ 2 * iota_sq

/-- `U_n² = a_n` with the marking `u_n`. -/
theorem coverUnit_sq (n : ℕ) : coverUnit n ^ 2 = markingUnit (F := Ω) n (root n) := by
  have hvw : xiRoot * coverW n = root n := by
    rw [coverW, mul_div_cancel₀ _ xiRoot_closure_ne_zero]
  simp only [coverUnit, markingUnit, map_mul, map_pow]
  linear_combination coverW_sq n + 2 * algebraMap K Ω (constPlane Complex.I) *
    algebraMap K Ω (betaElement n) * hvw +
    algebraMap K Ω (betaElement n) ^ 2 * xiRoot ^ 2 * iota_sq -
    algebraMap K Ω (betaElement n) ^ 2 * xiRoot_sq + beta_xi_add_factor n

theorem coverUnit_sub_inv (n : ℕ) : coverUnit n - coverUnitInv n =
    2 * algebraMap K Ω (constPlane Complex.I) * algebraMap K Ω (betaElement n) * xiRoot := by
  simp only [coverUnit, coverUnitInv]; ring

/-- **Prime ratio from the odd parts:** `(U_p - U_p⁻¹)/(U_q - U_q⁻¹) = β_p/β_q`. -/
theorem coverUnit_odd_ratio (p q : ℕ) :
    (coverUnit p - coverUnitInv p) / (coverUnit q - coverUnitInv q) =
      algebraMap K Ω (betaElement p) / algebraMap K Ω (betaElement q) := by
  have hI : algebraMap K Ω (constPlane Complex.I) ≠ 0 := fun h => by
    have := iota_sq; rw [h] at this; norm_num at this
  have hq : algebraMap K Ω (betaElement q) ≠ 0 := (map_ne_zero _).mpr (betaElement_ne_zero q)
  rw [coverUnit_sub_inv, coverUnit_sub_inv]
  field_simp [xiRoot_closure_ne_zero]

/-- The ratios `U_p U_q⁻¹` descend to `L_T`. -/
theorem coverUnit_mul_inv_mem {T : Finset ℕ} {p q : ℕ} (hp : p ∈ T) (hq : q ∈ T) :
    coverUnit p * coverUnitInv q ∈ finiteMarkedExtension T := by
  have hvw : ∀ n, xiRoot * coverW n = root n := fun n => by
    rw [coverW, mul_div_cancel₀ _ xiRoot_closure_ne_zero]
  have he : coverUnit p * coverUnitInv q =
      root p * root q / algebraMap K Ω xiElement -
        algebraMap K Ω (constPlane Complex.I) * algebraMap K Ω (betaElement q) * root p +
        algebraMap K Ω (constPlane Complex.I) * algebraMap K Ω (betaElement p) * root q +
        algebraMap K Ω (betaElement p) * algebraMap K Ω (betaElement q) *
          algebraMap K Ω xiElement := by
    have hxi : algebraMap K Ω xiElement ≠ 0 := (map_ne_zero _).mpr xiElement_ne_zero
    simp only [coverUnit, coverUnitInv, coverW]
    rw [← xiRoot_sq]
    field_simp [xiRoot_closure_ne_zero]
    linear_combination (-(xiRoot ^ 2 * algebraMap K Ω (betaElement p) *
      algebraMap K Ω (betaElement q) * xiRoot ^ 2)) * iota_sq
  rw [he]
  have hm := fun z => IntermediateField.algebraMap_mem (finiteMarkedExtension T) z
  have hrp := root_mem_finiteMarkedExtension hp
  have hrq := root_mem_finiteMarkedExtension hq
  exact add_mem (add_mem (sub_mem (div_mem (mul_mem hrp hrq) (hm _))
    (mul_mem (mul_mem (hm _) (hm _)) hrp)) (mul_mem (mul_mem (hm _) (hm _)) hrq))
    (mul_mem (mul_mem (hm _) (hm _)) (hm _))

/-- No single `U_n` lies in `L_T`. -/
theorem coverUnit_not_mem (T : Finset ℕ) (n : ℕ) :
    coverUnit n ∉ finiteMarkedExtension T := by
  intro hU
  have hUi : coverUnitInv n ∈ finiteMarkedExtension T := by
    have : coverUnitInv n = (coverUnit n)⁻¹ :=
      (eq_inv_of_mul_eq_one_right (coverUnit_mul_inv n))
    rw [this]; exact inv_mem hU
  have hI : algebraMap K Ω (constPlane Complex.I) ≠ 0 := fun h => by
    have := iota_sq; rw [h] at this; norm_num at this
  have hβ : algebraMap K Ω (betaElement n) ≠ 0 := (map_ne_zero _).mpr (betaElement_ne_zero n)
  have hc : (2 * algebraMap K Ω (constPlane Complex.I) * algebraMap K Ω (betaElement n)) ≠ 0 :=
    mul_ne_zero (mul_ne_zero two_ne_zero hI) hβ
  have hv : xiRoot ∈ finiteMarkedExtension T := by
    have he : xiRoot = (coverUnit n - coverUnitInv n) /
        (2 * algebraMap K Ω (constPlane Complex.I) * algebraMap K Ω (betaElement n)) := by
      rw [coverUnit_sub_inv, mul_div_cancel_left₀ _ hc]
    rw [he]
    have h2 : (2 : Ω) ∈ finiteMarkedExtension T := by simp
    exact div_mem (sub_mem hU hUi) (mul_mem (mul_mem h2 (IntermediateField.algebraMap_mem _ _))
      (IntermediateField.algebraMap_mem _ _))
  apply xi_not_isSquare_finiteMarkedExtension T
  exact (root_mem_iff_isSquare xiRoot_sq (finiteMarkedExtension T)).mp hv

/-! ## The deck involution of the common cover -/

private theorem xiRoot_sq_finite' (T : Finset ℕ) :
    xiRoot * xiRoot = algebraMap (finiteMarkedExtension T) Ω
      (algebraMap K (finiteMarkedExtension T) xiElement) := by
  rw [xiRoot_sq, IsScalarTower.algebraMap_apply K (finiteMarkedExtension T) Ω]

theorem coverUnit_mem_cover {T : Finset ℕ} {n : ℕ} (hn : n ∈ T) :
    coverUnit n ∈ (finiteMarkedExtension T)⟮xiRoot⟯ := by
  set L := finiteMarkedExtension T
  have hx := IntermediateField.mem_adjoin_simple_self L xiRoot
  have hr : root n ∈ L⟮xiRoot⟯ := by
    have := IntermediateField.algebraMap_mem L⟮xiRoot⟯
      (⟨root n, root_mem_finiteMarkedExtension hn⟩ : L)
    simpa using this
  have hk : ∀ z : K, algebraMap K Ω z ∈ L⟮xiRoot⟯ := fun z => by
    have := IntermediateField.algebraMap_mem L⟮xiRoot⟯ (algebraMap K L z)
    rwa [← IsScalarTower.algebraMap_apply] at this
  exact add_mem (div_mem hr hx) (mul_mem (mul_mem (hk _) (hk _)) hx)

/-- **Deck involution** of the common cover `L_T(√ξ)/L_T`: `√ξ ↦ -√ξ`. -/
def finiteDeck (T : Finset ℕ) :
    (finiteMarkedExtension T)⟮xiRoot⟯ ≃ₐ[finiteMarkedExtension T]
      (finiteMarkedExtension T)⟮xiRoot⟯ :=
  quadraticRootConjugation (xiRoot_sq_finite' T) (xi_not_isSquare_finiteMarkedExtension T)

theorem finiteDeck_root (T : Finset ℕ) :
    finiteDeck T ⟨xiRoot, IntermediateField.mem_adjoin_simple_self _ xiRoot⟩ =
      -⟨xiRoot, IntermediateField.mem_adjoin_simple_self _ xiRoot⟩ :=
  quadraticRootConjugation_gen (xiRoot_sq_finite' T) (xi_not_isSquare_finiteMarkedExtension T)

theorem finiteDeck_involutive (T : Finset ℕ) : Function.Involutive (finiteDeck T) :=
  quadraticRootConjugation_involutive (xiRoot_sq_finite' T)
    (xi_not_isSquare_finiteMarkedExtension T)

/-- The deck involution negates every unit `U_n`, `n ∈ T`. -/
theorem finiteDeck_coverUnit (T : Finset ℕ) {n : ℕ} (hn : n ∈ T) :
    finiteDeck T ⟨coverUnit n, coverUnit_mem_cover hn⟩ =
      -⟨coverUnit n, coverUnit_mem_cover hn⟩ := by
  set L := finiteMarkedExtension T
  set g : L⟮xiRoot⟯ := ⟨xiRoot, IntermediateField.mem_adjoin_simple_self _ xiRoot⟩
  set uL : L := ⟨root n, root_mem_finiteMarkedExtension hn⟩
  set cL : L := algebraMap K L (constPlane Complex.I * betaElement n)
  have hdecomp : (⟨coverUnit n, coverUnit_mem_cover hn⟩ : L⟮xiRoot⟯) =
      algebraMap L L⟮xiRoot⟯ uL * g⁻¹ + algebraMap L L⟮xiRoot⟯ cL * g := by
    apply Subtype.ext
    simp only [IntermediateField.coe_add, IntermediateField.coe_mul, IntermediateField.coe_inv,
      IntermediateField.coe_algebraMap_apply, g, uL, cL, IntermediateField.algebraMap_apply,
      coverUnit, coverW, map_mul]
    rw [div_eq_mul_inv]
  rw [hdecomp, map_add, map_mul, map_mul, map_inv₀, finiteDeck_root, AlgEquiv.commutes,
    AlgEquiv.commutes, inv_neg]
  ring

end RHTower.XiGlobalKummer
