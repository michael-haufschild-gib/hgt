import GaloisForLFunctions.RHTower.XiHeatCassiniWoldChebyshevErrorIncrement
import GaloisForLFunctions.RHTower.Sieve.PrimeWindowRayleighFloor
import GaloisForLFunctions.RHTower.GammaValuationSchurAdjacentPrimePrimitiveRecovery

open Complex MeasureTheory Set
open scoped BigOperators

namespace RHTower.Sieve

noncomputable section

/-- Canonical physical dyadic base. -/
def routeTPrimeGapDyadicBase (k : ℕ) : ℝ := ((2 ^ k : ℕ) : ℝ)

/-- Canonical dyadic gap scale. -/
def routeTPrimeGapDyadicScale (j : ℕ) : ℝ := ((2 ^ j : ℕ) : ℝ)

/-- Ordered prime gaps whose endpoints lie in one physical dyadic block and whose lengths lie in
the scale class `[2h,4h]`.  The value bound on the right endpoint makes the carrier finite without
any prime-counting input. -/
def routeTPrimeGapDyadicBlockShell (k j : ℕ) : Finset ℕ :=
  (Finset.range (2 ^ (k + 1))).filter fun n =>
    routeTPrimeGapDyadicBase k ≤ (nthPrimeSubtype n : ℝ) ∧
    (nthPrimeSubtype (n + 1) : ℝ) ≤ 2 * routeTPrimeGapDyadicBase k ∧
    2 * routeTPrimeGapDyadicScale j ≤ xiHeatCassiniOrderedPrimeGap n ∧
    xiHeatCassiniOrderedPrimeGap n ≤ 4 * routeTPrimeGapDyadicScale j

/-- Base points contributed by one consecutive-prime gap after reserving one dyadic target
window at its right edge. -/
def routeTPrimeGapOccupancyInterval (n : ℕ) (h : ℝ) : Set ℝ :=
  Set.Ico (nthPrimeSubtype n : ℝ) ((nthPrimeSubtype (n + 1) : ℝ) - h)

/-- Prime-free base occupancy generated by one dyadic shell of actual consecutive-prime gaps. -/
def routeTPrimeGapDyadicBlockOccupancy (k j : ℕ) : Set ℝ :=
  ⋃ n ∈ routeTPrimeGapDyadicBlockShell k j,
    routeTPrimeGapOccupancyInterval n (routeTPrimeGapDyadicScale j)

theorem routeTPrimeGapDyadicBase_pos (k : ℕ) :
    0 < routeTPrimeGapDyadicBase k := by
  simp [routeTPrimeGapDyadicBase]

theorem routeTPrimeGapDyadicScale_pos (j : ℕ) :
    0 < routeTPrimeGapDyadicScale j := by
  simp [routeTPrimeGapDyadicScale]

theorem mem_routeTPrimeGapDyadicBlockShell {k j n : ℕ} :
    n ∈ routeTPrimeGapDyadicBlockShell k j ↔
      routeTPrimeGapDyadicBase k ≤ (nthPrimeSubtype n : ℝ) ∧
      (nthPrimeSubtype (n + 1) : ℝ) ≤ 2 * routeTPrimeGapDyadicBase k ∧
      2 * routeTPrimeGapDyadicScale j ≤ xiHeatCassiniOrderedPrimeGap n ∧
      xiHeatCassiniOrderedPrimeGap n ≤ 4 * routeTPrimeGapDyadicScale j := by
  rw [routeTPrimeGapDyadicBlockShell, Finset.mem_filter]
  constructor
  · exact fun h => h.2
  · intro h
    refine ⟨?_, h⟩
    rw [Finset.mem_range]
    have hindex := nthPrimeSubtype_index_add_two_le n
    have hpMono : (nthPrimeSubtype n : ℝ) ≤
        (nthPrimeSubtype (n + 1) : ℝ) := by
      exact_mod_cast nthPrimeSubtype_strictMono.monotone (Nat.le_succ n)
    have hpBoundReal : (nthPrimeSubtype n : ℝ) ≤ ((2 ^ (k + 1) : ℕ) : ℝ) := by
      calc
        (nthPrimeSubtype n : ℝ) ≤ (nthPrimeSubtype (n + 1) : ℝ) := hpMono
        _ ≤ 2 * routeTPrimeGapDyadicBase k := h.2.1
        _ = ((2 ^ (k + 1) : ℕ) : ℝ) := by
          simp [routeTPrimeGapDyadicBase, pow_succ, mul_comm]
    have hpBound : (nthPrimeSubtype n : ℕ) ≤ 2 ^ (k + 1) := by
      exact_mod_cast hpBoundReal
    omega

theorem pairwiseDisjoint_routeTPrimeGapOccupancyInterval
    {S : Finset ℕ} {h : ℝ} (hh : 0 ≤ h) :
    (↑S : Set ℕ).PairwiseDisjoint
      (fun n => routeTPrimeGapOccupancyInterval n h) := by
  intro n hn m hm hnm
  change Disjoint (routeTPrimeGapOccupancyInterval n h)
    (routeTPrimeGapOccupancyInterval m h)
  rw [Set.disjoint_left]
  intro x hxn hxm
  simp only [routeTPrimeGapOccupancyInterval, Set.mem_Ico] at hxn hxm
  rcases lt_or_gt_of_ne hnm with hnm' | hmn'
  · have hindex : n + 1 ≤ m := by omega
    have hpmono : (nthPrimeSubtype (n + 1) : ℝ) ≤ (nthPrimeSubtype m : ℝ) := by
      exact_mod_cast nthPrimeSubtype_strictMono.monotone hindex
    linarith
  · have hindex : m + 1 ≤ n := by omega
    have hpmono : (nthPrimeSubtype (m + 1) : ℝ) ≤ (nthPrimeSubtype n : ℝ) := by
      exact_mod_cast nthPrimeSubtype_strictMono.monotone hindex
    linarith

theorem chebyshevTheta_window_eq_zero_of_mem_primeGapOccupancyInterval
    {n : ℕ} {h lambda : ℝ} (hh : 0 ≤ h)
    (hlambda : lambda ∈ routeTPrimeGapOccupancyInterval n h) :
    Chebyshev.theta (lambda + h) - Chebyshev.theta lambda = 0 := by
  have hp : 0 < (nthPrimeSubtype n : ℝ) := nthPrimeSubtype_pos n
  have hlambdaBounds :
      (nthPrimeSubtype n : ℝ) ≤ lambda ∧
        lambda < (nthPrimeSubtype (n + 1) : ℝ) - h := hlambda
  have hlambda0 : 0 ≤ lambda := hp.le.trans hlambdaBounds.1
  have hsum0 :
      ∑ p ∈ Finset.Ioc ⌊lambda⌋₊ ⌊lambda + h⌋₊ with Nat.Prime p,
          Real.log p = 0 := by
    apply Finset.sum_eq_zero
    intro p hpMem
    simp only [Finset.mem_filter, Finset.mem_Ioc] at hpMem
    have hleftFloor : (nthPrimeSubtype n : ℕ) ≤ ⌊lambda⌋₊ := by
      exact Nat.le_floor hlambdaBounds.1
    have hpn : (nthPrimeSubtype n : ℕ) < p := hleftFloor.trans_lt hpMem.1.1
    have hfloorUpper : (⌊lambda + h⌋₊ : ℝ) ≤ lambda + h :=
      Nat.floor_le (by positivity)
    have hpUpperCast : (p : ℝ) ≤ (⌊lambda + h⌋₊ : ℝ) := by
      exact_mod_cast hpMem.1.2
    have hpUpper : (p : ℝ) ≤ lambda + h := hpUpperCast.trans hfloorUpper
    have hpnext : p < (nthPrimeSubtype (n + 1) : ℕ) := by
      exact_mod_cast (show (p : ℝ) < (nthPrimeSubtype (n + 1) : ℝ) by linarith)
    have hpShell :
        p ∈ (Finset.Ioc (nthPrimeSubtype n : ℕ)
          (nthPrimeSubtype (n + 1) : ℕ)).filter Nat.Prime := by
      simp only [Finset.mem_filter, Finset.mem_Ioc]
      exact ⟨⟨hpn, hpnext.le⟩, hpMem.2⟩
    rw [filter_prime_Ioc_consecutive_nthPrime] at hpShell
    simp only [Finset.mem_singleton] at hpShell
    omega
  rw [theta_sub_eq_sum_Ioc (by linarith)]
  exact hsum0

theorem routeTPrimeGapDyadicBlockOccupancy_subset_primeFree (k j : ℕ) :
    routeTPrimeGapDyadicBlockOccupancy k j ⊆
      {lambda : ℝ |
        Chebyshev.theta (lambda + routeTPrimeGapDyadicScale j) -
            Chebyshev.theta lambda = 0} := by
  intro lambda hlambda
  simp only [routeTPrimeGapDyadicBlockOccupancy, Set.mem_iUnion] at hlambda
  obtain ⟨n, _hn, hlambda⟩ := hlambda
  exact chebyshevTheta_window_eq_zero_of_mem_primeGapOccupancyInterval
    (routeTPrimeGapDyadicScale_pos j).le hlambda

theorem routeTPrimeGapDyadicBlockOccupancy_subset_block (k j : ℕ) :
    routeTPrimeGapDyadicBlockOccupancy k j ⊆
      Set.Icc (routeTPrimeGapDyadicBase k) (2 * routeTPrimeGapDyadicBase k) := by
  intro lambda hlambda
  simp only [routeTPrimeGapDyadicBlockOccupancy, Set.mem_iUnion] at hlambda
  obtain ⟨n, hn, hlambda⟩ := hlambda
  have hshell := mem_routeTPrimeGapDyadicBlockShell.mp hn
  simp only [routeTPrimeGapOccupancyInterval, Set.mem_Ico] at hlambda
  constructor
  · exact hshell.1.trans hlambda.1
  · linarith [routeTPrimeGapDyadicScale_pos j]

theorem volume_routeTPrimeGapDyadicBlockOccupancy (k j : ℕ) :
    volume.real (routeTPrimeGapDyadicBlockOccupancy k j) =
      ∑ n ∈ routeTPrimeGapDyadicBlockShell k j,
        (xiHeatCassiniOrderedPrimeGap n - routeTPrimeGapDyadicScale j) := by
  rw [routeTPrimeGapDyadicBlockOccupancy,
    measureReal_biUnion_finset
      (pairwiseDisjoint_routeTPrimeGapOccupancyInterval
        (routeTPrimeGapDyadicScale_pos j).le)
      (fun _ _ => measurableSet_Ico)
      (fun n _ => by
        simp [routeTPrimeGapOccupancyInterval, Real.volume_Ico])]
  apply Finset.sum_congr rfl
  intro n hn
  have hshell := mem_routeTPrimeGapDyadicBlockShell.mp hn
  have hle : (nthPrimeSubtype n : ℝ) ≤
      (nthPrimeSubtype (n + 1) : ℝ) - routeTPrimeGapDyadicScale j := by
    unfold xiHeatCassiniOrderedPrimeGap at hshell
    linarith [routeTPrimeGapDyadicScale_pos j]
  rw [routeTPrimeGapOccupancyInterval, Real.volume_real_Ico_of_le hle]
  unfold xiHeatCassiniOrderedPrimeGap
  ring

/-- Actual ordered-prime gap-square mass in one dyadic length class is bounded by eight times the
reserved target width times literal prime-free base occupancy. -/
theorem sum_primeGapSquare_le_eight_mul_volume_occupancy (k j : ℕ) :
    (∑ n ∈ routeTPrimeGapDyadicBlockShell k j,
        xiHeatCassiniOrderedPrimeGap n ^ 2) ≤
      8 * routeTPrimeGapDyadicScale j *
        volume.real (routeTPrimeGapDyadicBlockOccupancy k j) := by
  rw [volume_routeTPrimeGapDyadicBlockOccupancy]
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro n hn
  have hshell := mem_routeTPrimeGapDyadicBlockShell.mp hn
  have hh := routeTPrimeGapDyadicScale_pos j
  nlinarith [sq_nonneg (xiHeatCassiniOrderedPrimeGap n -
    2 * routeTPrimeGapDyadicScale j)]

/-- Closed gap-occupancy bridge: the same shell mass is controlled by prime-free bases inside its
physical dyadic block. -/
theorem sum_primeGapSquare_le_eight_mul_primeFree_block_measure (k j : ℕ) :
    (∑ n ∈ routeTPrimeGapDyadicBlockShell k j,
        xiHeatCassiniOrderedPrimeGap n ^ 2) ≤
      8 * routeTPrimeGapDyadicScale j *
        (volume.restrict
          (Set.Icc (routeTPrimeGapDyadicBase k)
            (2 * routeTPrimeGapDyadicBase k))).real
          {lambda : ℝ |
            Chebyshev.theta (lambda + routeTPrimeGapDyadicScale j) -
                Chebyshev.theta lambda = 0} := by
  refine (sum_primeGapSquare_le_eight_mul_volume_occupancy k j).trans ?_
  apply mul_le_mul_of_nonneg_left _
    (mul_nonneg (by norm_num) (routeTPrimeGapDyadicScale_pos j).le)
  let B := Set.Icc (routeTPrimeGapDyadicBase k) (2 * routeTPrimeGapDyadicBase k)
  let P : Set ℝ := {lambda : ℝ |
    Chebyshev.theta (lambda + routeTPrimeGapDyadicScale j) -
      Chebyshev.theta lambda = 0}
  have hoccBlock : routeTPrimeGapDyadicBlockOccupancy k j ⊆ B :=
    routeTPrimeGapDyadicBlockOccupancy_subset_block k j
  have hoccPrimeFree : routeTPrimeGapDyadicBlockOccupancy k j ⊆ P :=
    routeTPrimeGapDyadicBlockOccupancy_subset_primeFree k j
  have hfiniteP : (volume.restrict B) P ≠ ⊤ := by
    apply ne_of_lt
    calc
      (volume.restrict B) P ≤ (volume.restrict B) Set.univ :=
        measure_mono (Set.subset_univ P)
      _ = volume B := Measure.restrict_apply_univ B
      _ < ⊤ := by
        dsimp only [B]
        exact isCompact_Icc.measure_lt_top
  have hmono : (volume.restrict B).real
      (routeTPrimeGapDyadicBlockOccupancy k j) ≤
      (volume.restrict B).real P :=
    measureReal_mono hoccPrimeFree hfiniteP
  have hoccMeas : MeasurableSet (routeTPrimeGapDyadicBlockOccupancy k j) := by
    exact MeasurableSet.iUnion fun n =>
      MeasurableSet.iUnion fun _hn => measurableSet_Ico
  have hrestrictOcc :
      (volume.restrict B).real (routeTPrimeGapDyadicBlockOccupancy k j) =
        volume.real (routeTPrimeGapDyadicBlockOccupancy k j) := by
    rw [measureReal_def, measureReal_def, Measure.restrict_apply hoccMeas]
    rw [Set.inter_eq_self_of_subset_left hoccBlock]
  rw [hrestrictOcc] at hmono
  simpa only [B, P] using hmono

end

end RHTower.Sieve
