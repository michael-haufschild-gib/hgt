import GaloisForLFunctions.RHTower.Sieve.RamarePrimeOffDiagonal

/-!
# Route E: exact Ramaré off-diagonal integer-incidence recombination

This module closes the finite recombination seam between the prime-pair Ramaré
off-diagonal and an ordinary-integer pair sum.  The coefficient attached to
`(n,m)` is exactly the normalized number of ordered distinct prime incidences,
equivalently

`1 - |P(n) ∩ P(m)| / (|P(n)| |P(m)|)`.

The final theorem retains the finite-volume Möbius signs, the full Mellin pair
kernel, and every active prime incidence.  No asymptotic estimate is used here;
the remaining Route E burden is the analytic control of this exact integer-pair
formula through the moving Gallagher/recurrence seam.
-/

namespace RHTower.Sieve

open Finset MeasureTheory
open scoped ArithmeticFunction.Moebius

/-- Prime-incidence block generated by coefficients on a finite integer set. -/
noncomputable def routeEIncidenceBlock {ι κ : Type*} [DecidableEq ι] [DecidableEq κ]
    (S : Finset κ) (F : κ → Finset ι) (c : κ → ℂ) (p : ι) : ℂ :=
  ∑ n ∈ S, if p ∈ F n then c n else 0

/-- Number of ordered pairs of distinct primes incident to `A` and `B`. -/
noncomputable def routeEDistinctIncidenceCount {ι : Type*} [DecidableEq ι]
    (P A B : Finset ι) : ℕ :=
  ((P ×ˢ P).filter fun pq => pq.1 ∈ A ∧ pq.2 ∈ B ∧ pq.1 ≠ pq.2).card

/-- Ordered distinct pairs in a finite prime packet. -/
noncomputable def routeEDistinctPairs {ι : Type*} [DecidableEq ι] (P : Finset ι) :
    Finset (ι × ι) :=
  (P ×ˢ P).filter fun pq => pq.1 ≠ pq.2

theorem routeEDistinctIncidenceCount_comm {ι : Type*} [DecidableEq ι]
    (P A B : Finset ι) :
    routeEDistinctIncidenceCount P A B = routeEDistinctIncidenceCount P B A := by
  classical
  rw [routeEDistinctIncidenceCount, routeEDistinctIncidenceCount]
  refine Finset.card_bij (fun pq _ => pq.swap) ?_ ?_ ?_
  · intro pq hpq
    simp only [Finset.mem_filter, Finset.mem_product] at hpq ⊢
    exact ⟨⟨hpq.1.2, hpq.1.1⟩, hpq.2.2.1, hpq.2.1, hpq.2.2.2.symm⟩
  · intro a₁ h₁ a₂ h₂ heq
    exact Prod.swap_injective heq
  · intro pq hpq
    refine ⟨pq.swap, ?_, by simp⟩
    simp only [Finset.mem_filter, Finset.mem_product] at hpq ⊢
    exact ⟨⟨hpq.1.2, hpq.1.1⟩, hpq.2.2.1, hpq.2.1, hpq.2.2.2.symm⟩

/-- Exact complement law for distinct ordered incidences. -/
theorem routeEDistinctIncidenceCount_eq_card_mul_sub_inter
    {ι : Type*} [DecidableEq ι] {P A B : Finset ι}
    (hA : A ⊆ P) (hB : B ⊆ P) :
    routeEDistinctIncidenceCount P A B = A.card * B.card - (A ∩ B).card := by
  classical
  rw [routeEDistinctIncidenceCount]
  have hsupport :
      (P ×ˢ P).filter (fun pq => pq.1 ∈ A ∧ pq.2 ∈ B ∧ pq.1 ≠ pq.2) =
        (A ×ˢ B).filter (fun pq => pq.1 ≠ pq.2) := by
    ext pq
    simp only [Finset.mem_filter, Finset.mem_product]
    constructor
    · rintro ⟨-, hpA, hpB, hne⟩
      exact ⟨⟨hpA, hpB⟩, hne⟩
    · rintro ⟨⟨hpA, hpB⟩, hne⟩
      exact ⟨⟨hA hpA, hB hpB⟩, hpA, hpB, hne⟩
  rw [hsupport]
  have hdiag :
      ((A ×ˢ B).filter (fun pq => ¬ pq.1 ≠ pq.2)).card = (A ∩ B).card := by
    refine Finset.card_bij (fun pq _ => pq.1) ?_ ?_ ?_
    · intro pq hpq
      simp only [Finset.mem_filter, Finset.mem_product] at hpq
      have heq : pq.1 = pq.2 := not_ne_iff.mp hpq.2
      exact Finset.mem_inter.mpr ⟨hpq.1.1, by simpa [heq] using hpq.1.2⟩
    · intro pq₁ hpq₁ pq₂ hpq₂ heq
      simp only [Finset.mem_filter, Finset.mem_product] at hpq₁ hpq₂
      have h₁ : pq₁.1 = pq₁.2 := not_ne_iff.mp hpq₁.2
      have h₂ : pq₂.1 = pq₂.2 := not_ne_iff.mp hpq₂.2
      apply Prod.ext
      · exact heq
      · exact h₁.symm.trans (heq.trans h₂)
    · intro x hx
      have hmem : (x, x) ∈ (A ×ˢ B).filter (fun pq => ¬ pq.1 ≠ pq.2) := by
        simp only [Finset.mem_filter, Finset.mem_product, not_ne_iff]
        exact ⟨Finset.mem_inter.mp hx, trivial⟩
      exact ⟨(x, x), hmem, rfl⟩
  have hpartition := Finset.card_filter_add_card_filter_not
    (s := A ×ˢ B) (p := fun pq => pq.1 ≠ pq.2)
  rw [hdiag, Finset.card_product] at hpartition
  omega

/-- Probability form of the exact distinct-incidence complement law. -/
theorem routeEDistinctIncidenceRatio_eq_one_sub_inter
    {ι : Type*} [DecidableEq ι] {P A B : Finset ι}
    (hA : A ⊆ P) (hB : B ⊆ P) (hAn : A.Nonempty) (hBn : B.Nonempty) :
    (routeEDistinctIncidenceCount P A B : ℝ) / ((A.card : ℝ) * (B.card : ℝ)) =
      1 - ((A ∩ B).card : ℝ) / ((A.card : ℝ) * (B.card : ℝ)) := by
  rw [routeEDistinctIncidenceCount_eq_card_mul_sub_inter hA hB]
  have hAc : 0 < A.card := Finset.card_pos.mpr hAn
  have hBc : 0 < B.card := Finset.card_pos.mpr hBn
  have hinter : (A ∩ B).card ≤ A.card * B.card := by
    have hleft : (A ∩ B).card ≤ A.card :=
      Finset.card_le_card Finset.inter_subset_left
    nlinarith
  rw [Nat.cast_sub hinter]
  push_cast
  field_simp

theorem routeE_sum_erase_eq_sum_distinctPairs
    {ι M : Type*} [DecidableEq ι] [AddCommMonoid M]
    (P : Finset ι) (f : ι → ι → M) :
    ∑ p ∈ P, ∑ q ∈ P.erase p, f p q =
      ∑ pq ∈ routeEDistinctPairs P, f pq.1 pq.2 := by
  classical
  rw [routeEDistinctPairs, Finset.sum_filter, Finset.sum_product]
  refine Finset.sum_congr rfl fun p hp => ?_
  rw [← Finset.sum_filter]
  congr 1
  ext q
  simp only [Finset.mem_erase, Finset.mem_filter]
  constructor
  · rintro ⟨hne, hq⟩
    exact ⟨hq, Ne.symm hne⟩
  · rintro ⟨hq, hne⟩
    exact ⟨Ne.symm hne, hq⟩

theorem routeE_incidenceBlock_pair_expand
    {ι κ : Type*} [DecidableEq ι] [DecidableEq κ]
    (S : Finset κ) (F : κ → Finset ι) (c : κ → ℂ) (p q : ι) :
    ((routeEIncidenceBlock S F c p) *
        (starRingEnd ℂ) (routeEIncidenceBlock S F c q)).re =
      ∑ n ∈ S, ∑ m ∈ S,
        if p ∈ F m ∧ q ∈ F n then (c m * (starRingEnd ℂ) (c n)).re else 0 := by
  classical
  simp only [routeEIncidenceBlock, map_sum, Finset.sum_mul, Finset.mul_sum,
    Complex.re_sum]
  apply Finset.sum_congr rfl
  intro n hn
  apply Finset.sum_congr rfl
  intro m hm
  by_cases hpm : p ∈ F m <;> by_cases hqn : q ∈ F n <;> simp [hpm, hqn]

/-- Generic prime-block off-diagonal reindexing into integer-incidence counts. -/
theorem routeE_offDiagonal_incidenceBlock_sum_reindex
    {ι κ : Type*} [DecidableEq ι] [DecidableEq κ]
    (P : Finset ι) (S : Finset κ) (F : κ → Finset ι) (c : κ → ℂ) :
    ∑ p ∈ P, ∑ q ∈ P.erase p,
        ((routeEIncidenceBlock S F c p) *
          (starRingEnd ℂ) (routeEIncidenceBlock S F c q)).re =
      ∑ n ∈ S, ∑ m ∈ S,
        (routeEDistinctIncidenceCount P (F n) (F m) : ℝ) *
          (c n * (starRingEnd ℂ) (c m)).re := by
  classical
  rw [routeE_sum_erase_eq_sum_distinctPairs]
  simp_rw [routeE_incidenceBlock_pair_expand]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro n hn
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro m hm
  rw [routeEDistinctIncidenceCount]
  rw [← Finset.sum_filter]
  rw [Finset.sum_const, nsmul_eq_mul]
  have hfilter :
      (routeEDistinctPairs P).filter (fun pq => pq.1 ∈ F m ∧ pq.2 ∈ F n) =
        (P ×ˢ P).filter (fun pq => pq.1 ∈ F m ∧ pq.2 ∈ F n ∧ pq.1 ≠ pq.2) := by
    ext pq
    simp [routeEDistinctPairs, and_assoc, and_left_comm, and_comm]
  rw [hfilter]
  change (routeEDistinctIncidenceCount P (F m) (F n) : ℝ) *
      (c m * (starRingEnd ℂ) (c n)).re =
    (routeEDistinctIncidenceCount P (F n) (F m) : ℝ) *
      (c n * (starRingEnd ℂ) (c m)).re
  rw [routeEDistinctIncidenceCount_comm P (F m) (F n)]
  congr 1
  simp [Complex.mul_re]
  ring

/-- Integers in `[1,M]` carrying at least one prime from `P`. -/
def ramareActiveSet (P : Finset ℕ) (M : ℕ) : Finset ℕ :=
  (Finset.Icc 1 M).filter fun n => (primeFactorsIn P n).Nonempty

/-- Möbius phase divided by the number of active prime incidences. -/
noncomputable def ramareNormalizedIntegerCoefficient
    (P : Finset ℕ) (w : ℝ) (n : ℕ) : ℂ :=
  moebiusPhase w n / ((primeFactorsIn P n).card : ℂ)

theorem moebiusPhase_mul_eq_zero_of_prime_dvd_right
    {p m : ℕ} (hp : p.Prime) (hpm : p ∣ m) (w : ℝ) :
    moebiusPhase w (p * m) = 0 := by
  have hpp : p * p ∣ p * m := Nat.mul_dvd_mul_left p hpm
  have hnonsq : ¬ Squarefree (p * m) := by
    intro hn
    have hppsq : Squarefree (p * p) := hn.squarefree_of_dvd hpp
    have hcop := Nat.coprime_of_squarefree_mul hppsq
    exact hp.ne_one (by simpa [Nat.coprime_self] using hcop)
  rw [moebiusPhase, ArithmeticFunction.moebius_eq_zero_of_not_squarefree hnonsq]
  simp

/-- Each Ramaré prime block is exactly its ordinary-integer incidence block. -/
theorem ramarePrimeBlock_eq_integerIncidenceBlock
    {P : Finset ℕ} (hPprime : ∀ q ∈ P, q.Prime) {p : ℕ} (hpP : p ∈ P)
    (M : ℕ) (w : ℝ) :
    moebiusPhase w p * ramareCofactorPoly P M p w =
      ∑ n ∈ {n ∈ Finset.Icc 1 M | p ∣ n},
        ramareNormalizedIntegerCoefficient P w n := by
  classical
  have hp : p.Prime := hPprime p hpP
  have hsplit := sum_ramare_bilinear_split_complex hPprime
    (moebiusPhase_mul_of_coprime w) hp hpP (ramareCofactorSet (Finset.Icc 1 M) p)
  have hrem :
      (∑ m ∈ {m ∈ ramareCofactorSet (Finset.Icc 1 M) p | p ∣ m},
        moebiusPhase w (p * m) / ((primeFactorsIn P (p * m)).card : ℂ)) = 0 := by
    apply Finset.sum_eq_zero
    intro m hm
    rw [moebiusPhase_mul_eq_zero_of_prime_dvd_right hp (Finset.mem_filter.mp hm).2]
    simp
  have hinner :
      (∑ n ∈ {n ∈ Finset.Icc 1 M | p ∣ n}, ramareNormalizedIntegerCoefficient P w n) =
        ∑ m ∈ ramareCofactorSet (Finset.Icc 1 M) p,
          moebiusPhase w (p * m) / ((primeFactorsIn P (p * m)).card : ℂ) := by
    exact (sum_div_image_complex p {n ∈ Finset.Icc 1 M | p ∣ n}
      (fun n hn => (Finset.mem_filter.mp hn).2)
      (fun n => ramareNormalizedIntegerCoefficient P w n)).symm
  have hpoly :
      (∑ m ∈ {m ∈ ramareCofactorSet (Finset.Icc 1 M) p | ¬ p ∣ m},
          moebiusPhase w m / (((primeFactorsIn P m).card : ℂ) + 1)) =
        ramareCofactorPoly P M p w := by
    exact sum_moebiusPhase_div_eq_logPoly P _ w
  calc
    moebiusPhase w p * ramareCofactorPoly P M p w =
        moebiusPhase w p *
          (∑ m ∈ {m ∈ ramareCofactorSet (Finset.Icc 1 M) p | ¬ p ∣ m},
            moebiusPhase w m / (((primeFactorsIn P m).card : ℂ) + 1)) := by rw [hpoly]
    _ = ∑ m ∈ ramareCofactorSet (Finset.Icc 1 M) p,
          moebiusPhase w (p * m) / ((primeFactorsIn P (p * m)).card : ℂ) := by
        rw [hsplit, hrem, add_zero]
    _ = ∑ n ∈ {n ∈ Finset.Icc 1 M | p ∣ n},
          ramareNormalizedIntegerCoefficient P w n := hinner.symm

theorem ramarePrimeBlock_eq_activeIndicatorBlock
    {P : Finset ℕ} (hPprime : ∀ q ∈ P, q.Prime) {p : ℕ} (hpP : p ∈ P)
    (M : ℕ) (w : ℝ) :
    moebiusPhase w p * ramareCofactorPoly P M p w =
      ∑ n ∈ ramareActiveSet P M,
        if p ∈ primeFactorsIn P n then ramareNormalizedIntegerCoefficient P w n else 0 := by
  rw [ramarePrimeBlock_eq_integerIncidenceBlock hPprime hpP]
  have hsets :
      (ramareActiveSet P M).filter (fun n => p ∈ primeFactorsIn P n) =
        {n ∈ Finset.Icc 1 M | p ∣ n} := by
    ext n
    simp only [ramareActiveSet, Finset.mem_filter]
    constructor
    · rintro ⟨⟨hnI, -⟩, hpFactor⟩
      exact ⟨hnI, (mem_primeFactorsIn.mp hpFactor).2⟩
    · rintro ⟨hnI, hpn⟩
      have hpFactor : p ∈ primeFactorsIn P n := mem_primeFactorsIn.mpr ⟨hpP, hpn⟩
      exact ⟨⟨hnI, ⟨p, hpFactor⟩⟩, hpFactor⟩
  rw [← Finset.sum_filter]
  rw [hsets]

/-- Exact normalized complement of the shared-prime diagonal. -/
noncomputable def ramareIncidenceComplement (P : Finset ℕ) (n m : ℕ) : ℝ :=
  1 - (((primeFactorsIn P n) ∩ (primeFactorsIn P m)).card : ℝ) /
    (((primeFactorsIn P n).card : ℝ) * ((primeFactorsIn P m).card : ℝ))

/-- The complement is literally the probability of drawing two distinct active primes. -/
theorem ramareIncidenceComplement_eq_normalizedDistinctIncidence
    {P : Finset ℕ} {n m : ℕ}
    (hn : (primeFactorsIn P n).Nonempty) (hm : (primeFactorsIn P m).Nonempty) :
    ramareIncidenceComplement P n m =
      (routeEDistinctIncidenceCount P (primeFactorsIn P n) (primeFactorsIn P m) : ℝ) /
        (((primeFactorsIn P n).card : ℝ) * ((primeFactorsIn P m).card : ℝ)) := by
  have hnsub : primeFactorsIn P n ⊆ P := fun p hp => (mem_primeFactorsIn.mp hp).1
  have hmsub : primeFactorsIn P m ⊆ P := fun p hp => (mem_primeFactorsIn.mp hp).1
  rw [ramareIncidenceComplement]
  exact (routeEDistinctIncidenceRatio_eq_one_sub_inter hnsub hmsub hn hm).symm

theorem ramareIncidenceComplement_nonneg
    {P : Finset ℕ} {n m : ℕ}
    (hn : (primeFactorsIn P n).Nonempty) (hm : (primeFactorsIn P m).Nonempty) :
    0 ≤ ramareIncidenceComplement P n m := by
  rw [ramareIncidenceComplement_eq_normalizedDistinctIncidence hn hm]
  have hnpos : 0 < ((primeFactorsIn P n).card : ℝ) := by
    exact_mod_cast Finset.card_pos.mpr hn
  have hmpos : 0 < ((primeFactorsIn P m).card : ℝ) := by
    exact_mod_cast Finset.card_pos.mpr hm
  positivity

theorem ramareIncidenceComplement_le_one
    {P : Finset ℕ} {n m : ℕ}
    (hn : (primeFactorsIn P n).Nonempty) (hm : (primeFactorsIn P m).Nonempty) :
    ramareIncidenceComplement P n m ≤ 1 := by
  rw [ramareIncidenceComplement]
  have hnpos : 0 < ((primeFactorsIn P n).card : ℝ) := by
    exact_mod_cast Finset.card_pos.mpr hn
  have hmpos : 0 < ((primeFactorsIn P m).card : ℝ) := by
    exact_mod_cast Finset.card_pos.mpr hm
  have hratio : 0 ≤
      (((primeFactorsIn P n) ∩ (primeFactorsIn P m)).card : ℝ) /
        (((primeFactorsIn P n).card : ℝ) * ((primeFactorsIn P m).card : ℝ)) := by
    positivity
  linarith

theorem ramarePrimeOffDiagonalIntegrand_eq_incidenceCount
    {P : Finset ℕ} (hPprime : ∀ q ∈ P, q.Prime) (M : ℕ) (w : ℝ) :
    ∑ p ∈ P, ∑ q ∈ P.erase p,
        ((moebiusPhase w p * ramareCofactorPoly P M p w) *
          (starRingEnd ℂ) (moebiusPhase w q * ramareCofactorPoly P M q w)).re =
      ∑ n ∈ ramareActiveSet P M, ∑ m ∈ ramareActiveSet P M,
        (routeEDistinctIncidenceCount P (primeFactorsIn P n) (primeFactorsIn P m) : ℝ) *
          (ramareNormalizedIntegerCoefficient P w n *
            (starRingEnd ℂ) (ramareNormalizedIntegerCoefficient P w m)).re := by
  classical
  let B : ℕ → ℂ := fun p => moebiusPhase w p * ramareCofactorPoly P M p w
  let C : ℕ → ℂ := routeEIncidenceBlock (ramareActiveSet P M) (primeFactorsIn P)
    (ramareNormalizedIntegerCoefficient P w)
  have hBC : ∀ p ∈ P, B p = C p := by
    intro p hp
    exact ramarePrimeBlock_eq_activeIndicatorBlock hPprime hp M w
  calc
    ∑ p ∈ P, ∑ q ∈ P.erase p,
        ((moebiusPhase w p * ramareCofactorPoly P M p w) *
          (starRingEnd ℂ) (moebiusPhase w q * ramareCofactorPoly P M q w)).re =
      ∑ p ∈ P, ∑ q ∈ P.erase p, (C p * (starRingEnd ℂ) (C q)).re := by
        apply Finset.sum_congr rfl
        intro p hp
        apply Finset.sum_congr rfl
        intro q hq
        rw [← hBC p hp, ← hBC q (Finset.mem_of_mem_erase hq)]
    _ = _ := routeE_offDiagonal_incidenceBlock_sum_reindex P (ramareActiveSet P M)
      (primeFactorsIn P) (ramareNormalizedIntegerCoefficient P w)

/-- Normalized incidence count is exactly the shared-prime complement coefficient. -/
theorem ramare_incidenceCount_normalized_pair_eq_complement
    {P : Finset ℕ} {n m : ℕ}
    (hn : (primeFactorsIn P n).Nonempty) (hm : (primeFactorsIn P m).Nonempty)
    (w : ℝ) :
    (routeEDistinctIncidenceCount P (primeFactorsIn P n) (primeFactorsIn P m) : ℝ) *
        (ramareNormalizedIntegerCoefficient P w n *
          (starRingEnd ℂ) (ramareNormalizedIntegerCoefficient P w m)).re =
      ramareIncidenceComplement P n m *
        (moebiusPhase w n * (starRingEnd ℂ) (moebiusPhase w m)).re := by
  have hnsub : primeFactorsIn P n ⊆ P := fun p hp => (mem_primeFactorsIn.mp hp).1
  have hmsub : primeFactorsIn P m ⊆ P := fun p hp => (mem_primeFactorsIn.mp hp).1
  have hratio := routeEDistinctIncidenceRatio_eq_one_sub_inter hnsub hmsub hn hm
  rw [ramareIncidenceComplement, ← hratio]
  have hnc : ((primeFactorsIn P n).card : ℂ) ≠ 0 := by
    exact_mod_cast (Finset.card_pos.mpr hn).ne'
  have hmc : ((primeFactorsIn P m).card : ℂ) ≠ 0 := by
    exact_mod_cast (Finset.card_pos.mpr hm).ne'
  have hnr : ((primeFactorsIn P n).card : ℝ) ≠ 0 := by
    exact_mod_cast (Finset.card_pos.mpr hn).ne'
  have hmr : ((primeFactorsIn P m).card : ℝ) ≠ 0 := by
    exact_mod_cast (Finset.card_pos.mpr hm).ne'
  have hpair :
      (ramareNormalizedIntegerCoefficient P w n *
        (starRingEnd ℂ) (ramareNormalizedIntegerCoefficient P w m)).re =
      (1 / (((primeFactorsIn P n).card : ℝ) * ((primeFactorsIn P m).card : ℝ))) *
        (moebiusPhase w n * (starRingEnd ℂ) (moebiusPhase w m)).re := by
    simp only [ramareNormalizedIntegerCoefficient, Complex.mul_re, map_div₀, map_natCast,
      Complex.div_re, Complex.div_im, Complex.conj_re, Complex.conj_im,
      Complex.normSq_natCast]
    norm_num
    field_simp
    ring
  rw [hpair]
  ring

/-- Pointwise prime-pair off-diagonal equals the ordinary-integer incidence complement sum. -/
theorem ramarePrimeOffDiagonalIntegrand_eq_integerIncidence
    {P : Finset ℕ} (hPprime : ∀ q ∈ P, q.Prime) (M : ℕ) (w : ℝ) :
    ∑ p ∈ P, ∑ q ∈ P.erase p,
        ((moebiusPhase w p * ramareCofactorPoly P M p w) *
          (starRingEnd ℂ) (moebiusPhase w q * ramareCofactorPoly P M q w)).re =
      ∑ n ∈ ramareActiveSet P M, ∑ m ∈ ramareActiveSet P M,
        ramareIncidenceComplement P n m *
          (moebiusPhase w n * (starRingEnd ℂ) (moebiusPhase w m)).re := by
  rw [ramarePrimeOffDiagonalIntegrand_eq_incidenceCount hPprime]
  apply Finset.sum_congr rfl
  intro n hn
  apply Finset.sum_congr rfl
  intro m hm
  exact ramare_incidenceCount_normalized_pair_eq_complement
    (Finset.mem_filter.mp hn).2 (Finset.mem_filter.mp hm).2 w

noncomputable def ramarePrimeOffDiagonalIntegrand
    (P : Finset ℕ) (M : ℕ) (w : ℝ) : ℝ :=
  ∑ p ∈ P, ∑ q ∈ P.erase p,
    ((moebiusPhase w p * ramareCofactorPoly P M p w) *
      (starRingEnd ℂ) (moebiusPhase w q * ramareCofactorPoly P M q w)).re

/-- Finite-volume Mellin kernel retained by the integer-pair recombination. -/
noncomputable def ramareMellinPairKernel (W : ℝ) (n m : ℕ) : ℝ :=
  ∫ w in Set.Icc (-W) W,
    (unitLogPhase w n * (starRingEnd ℂ) (unitLogPhase w m)).re

theorem re_moebiusPhase_mul_conj_eq_signs_mul_phase (w : ℝ) (n m : ℕ) :
    (moebiusPhase w n * (starRingEnd ℂ) (moebiusPhase w m)).re =
      (((μ n : ℤ) : ℝ) * ((μ m : ℤ) : ℝ)) *
        (unitLogPhase w n * (starRingEnd ℂ) (unitLogPhase w m)).re := by
  rw [moebiusPhase, moebiusPhase, map_mul]
  simp [Complex.mul_re]
  ring

theorem ramarePrimeOffDiagonal_eq_integral_integrand
    (P : Finset ℕ) (M : ℕ) (W : ℝ) :
    ramarePrimeOffDiagonal P M W =
      ∫ w in Set.Icc (-W) W, ramarePrimeOffDiagonalIntegrand P M w := by
  classical
  have hcontPair : ∀ p q : ℕ, Continuous fun w : ℝ =>
      ((moebiusPhase w p * ramareCofactorPoly P M p w) *
        (starRingEnd ℂ) (moebiusPhase w q * ramareCofactorPoly P M q w)).re := by
    intro p q
    refine Complex.continuous_re.comp ?_
    exact (((continuous_moebiusPhase p).mul (continuous_ramareCofactorPoly P M p)).mul
      (Complex.continuous_conj.comp
        ((continuous_moebiusPhase q).mul (continuous_ramareCofactorPoly P M q))))
  have hintPair : ∀ p q : ℕ, IntegrableOn (fun w : ℝ =>
      ((moebiusPhase w p * ramareCofactorPoly P M p w) *
        (starRingEnd ℂ) (moebiusPhase w q * ramareCofactorPoly P M q w)).re)
      (Set.Icc (-W) W) volume := fun p q => (hcontPair p q).integrableOn_Icc
  have hintRow : ∀ p ∈ P, IntegrableOn (fun w : ℝ =>
      ∑ q ∈ P.erase p,
        ((moebiusPhase w p * ramareCofactorPoly P M p w) *
          (starRingEnd ℂ) (moebiusPhase w q * ramareCofactorPoly P M q w)).re)
      (Set.Icc (-W) W) volume :=
    fun p _ => integrable_finsetSum _ fun q _ => hintPair p q
  rw [ramarePrimeOffDiagonal]
  change (∑ p ∈ P, ∑ q ∈ P.erase p, (∫ w in Set.Icc (-W) W,
      ((moebiusPhase w p * ramareCofactorPoly P M p w) *
        (starRingEnd ℂ) (moebiusPhase w q * ramareCofactorPoly P M q w)).re)) =
    ∫ w in Set.Icc (-W) W, ∑ p ∈ P, ∑ q ∈ P.erase p,
      ((moebiusPhase w p * ramareCofactorPoly P M p w) *
        (starRingEnd ℂ) (moebiusPhase w q * ramareCofactorPoly P M q w)).re
  rw [integral_finsetSum _ hintRow]
  apply Finset.sum_congr rfl
  intro p hp
  rw [integral_finsetSum _ (fun q _ => hintPair p q)]

/--
Exact finite-volume Ramaré prime off-diagonal as an ordinary-integer pair sum.
Every alternating Möbius sign and the full Mellin pair kernel is retained.
-/
theorem ramarePrimeOffDiagonal_eq_integerIncidence
    {P : Finset ℕ} (hPprime : ∀ q ∈ P, q.Prime) (M : ℕ) (W : ℝ) :
    ramarePrimeOffDiagonal P M W =
      ∑ n ∈ ramareActiveSet P M, ∑ m ∈ ramareActiveSet P M,
        (((μ n : ℤ) : ℝ) * ((μ m : ℤ) : ℝ) * ramareIncidenceComplement P n m) *
          ramareMellinPairKernel W n m := by
  classical
  rw [ramarePrimeOffDiagonal_eq_integral_integrand]
  change (∫ w in Set.Icc (-W) W, ∑ p ∈ P, ∑ q ∈ P.erase p,
      ((moebiusPhase w p * ramareCofactorPoly P M p w) *
        (starRingEnd ℂ) (moebiusPhase w q * ramareCofactorPoly P M q w)).re) = _
  rw [setIntegral_congr_fun measurableSet_Icc
    (fun w _ => ramarePrimeOffDiagonalIntegrand_eq_integerIncidence hPprime M w)]
  have hcontPair : ∀ n m : ℕ, Continuous fun w : ℝ =>
      ramareIncidenceComplement P n m *
        (moebiusPhase w n * (starRingEnd ℂ) (moebiusPhase w m)).re := by
    intro n m
    exact (Complex.continuous_re.comp
      ((continuous_moebiusPhase n).mul
        (Complex.continuous_conj.comp (continuous_moebiusPhase m)))).const_mul _
  have hintPair : ∀ n m : ℕ, IntegrableOn (fun w : ℝ =>
      ramareIncidenceComplement P n m *
        (moebiusPhase w n * (starRingEnd ℂ) (moebiusPhase w m)).re)
      (Set.Icc (-W) W) volume := fun n m => (hcontPair n m).integrableOn_Icc
  have hintRow : ∀ n ∈ ramareActiveSet P M, IntegrableOn (fun w : ℝ =>
      ∑ m ∈ ramareActiveSet P M, ramareIncidenceComplement P n m *
        (moebiusPhase w n * (starRingEnd ℂ) (moebiusPhase w m)).re)
      (Set.Icc (-W) W) volume :=
    fun n _ => integrable_finsetSum _ fun m _ => hintPair n m
  rw [integral_finsetSum _ hintRow]
  apply Finset.sum_congr rfl
  intro n hn
  rw [integral_finsetSum _ (fun m _ => hintPair n m)]
  apply Finset.sum_congr rfl
  intro m hm
  simp_rw [re_moebiusPhase_mul_conj_eq_signs_mul_phase]
  have hfun : (fun w : ℝ =>
      ramareIncidenceComplement P n m *
        ((((μ n : ℤ) : ℝ) * ((μ m : ℤ) : ℝ)) *
          (unitLogPhase w n * (starRingEnd ℂ) (unitLogPhase w m)).re)) =
      fun w : ℝ =>
        ((((μ n : ℤ) : ℝ) * ((μ m : ℤ) : ℝ)) *
          ramareIncidenceComplement P n m) *
          (unitLogPhase w n * (starRingEnd ℂ) (unitLogPhase w m)).re := by
    funext w
    ring
  rw [hfun, MeasureTheory.integral_const_mul]
  simp only [ramareMellinPairKernel]

end RHTower.Sieve
