import GaloisForLFunctions.RHTower.Sieve.RouteTZetaDLVP

/-!
# Route-T zero-free region

The analytic inequality is optimized with a deliberately generous square-log budget.  Squaring
costs only a power of `log log γ`, while keeping every comparison elementary and explicit.
-/

namespace RHTower.Sieve

open Complex

noncomputable section

def routeTZeroFreeBudget (A γ : ℝ) : ℝ :=
  10001 + |A| + Real.log (routeTLandauPhi γ) +
    Real.log (1 + 1 / routeTLandauRadius γ)

def routeTZeroFreeDelta (A γ : ℝ) : ℝ :=
  routeTLandauRadius γ / (10000 * routeTZeroFreeBudget A γ ^ (2 : ℕ))

def routeTZeroFreeWidth (A γ : ℝ) : ℝ :=
  routeTZeroFreeDelta A γ / 10

theorem routeTZeroFreeBudget_ge (A γ : ℝ) : 10001 ≤ routeTZeroFreeBudget A γ := by
  have hΦ := routeTLandauPhi_one_le γ
  have hlogΦ : 0 ≤ Real.log (routeTLandauPhi γ) := Real.log_nonneg hΦ
  have hR := routeTLandauRadius_pos γ
  have hlogR : 0 ≤ Real.log (1 + 1 / routeTLandauRadius γ) :=
    Real.log_nonneg (by
      have hinv : 0 < 1 / routeTLandauRadius γ := by positivity
      linarith)
  unfold routeTZeroFreeBudget
  linarith [abs_nonneg A]

theorem routeTZeroFreeBudget_pos (A γ : ℝ) : 0 < routeTZeroFreeBudget A γ :=
  lt_of_lt_of_le (by norm_num) (routeTZeroFreeBudget_ge A γ)

theorem routeTZeroFreeDelta_pos (A γ : ℝ) : 0 < routeTZeroFreeDelta A γ := by
  unfold routeTZeroFreeDelta
  exact div_pos (routeTLandauRadius_pos γ) (by
    have hQ := routeTZeroFreeBudget_pos A γ
    positivity)

theorem routeTZeroFreeWidth_pos (A γ : ℝ) : 0 < routeTZeroFreeWidth A γ := by
  unfold routeTZeroFreeWidth
  exact div_pos (routeTZeroFreeDelta_pos A γ) (by norm_num)

theorem routeT_log_phi_le_budget_sq (A γ : ℝ) :
    Real.log (routeTLandauPhi γ) ≤ routeTZeroFreeBudget A γ ^ (2 : ℕ) := by
  have hΦ := routeTLandauPhi_one_le γ
  have hlogΦ : 0 ≤ Real.log (routeTLandauPhi γ) := Real.log_nonneg hΦ
  have hR := routeTLandauRadius_pos γ
  have hlogR : 0 ≤ Real.log (1 + 1 / routeTLandauRadius γ) :=
    Real.log_nonneg (by
      have hinv : 0 < 1 / routeTLandauRadius γ := by positivity
      linarith)
  have hQ := routeTZeroFreeBudget_ge A γ
  have hterm : Real.log (routeTLandauPhi γ) ≤ routeTZeroFreeBudget A γ := by
    unfold routeTZeroFreeBudget
    linarith [abs_nonneg A]
  nlinarith [sq_nonneg (routeTZeroFreeBudget A γ - 1)]

theorem routeT_pole_const_le_budget_sq_div_radius (A γ : ℝ) :
    A ≤ routeTZeroFreeBudget A γ ^ (2 : ℕ) / routeTLandauRadius γ := by
  let Q := routeTZeroFreeBudget A γ
  let R := routeTLandauRadius γ
  have hQ := routeTZeroFreeBudget_ge A γ
  have hR0 := routeTLandauRadius_pos γ
  have hR1 : R ≤ 1 := by
    dsimp only [R]
    linarith [routeTLandauRadius_lt_half γ]
  have hAQ : A ≤ Q := by
    have hΦ := routeTLandauPhi_one_le γ
    have hlogΦ : 0 ≤ Real.log (routeTLandauPhi γ) := Real.log_nonneg hΦ
    have hlogR : 0 ≤ Real.log (1 + 1 / routeTLandauRadius γ) :=
      Real.log_nonneg (by
        have hinv : 0 < 1 / routeTLandauRadius γ := by positivity
        linarith)
    dsimp only [Q]
    unfold routeTZeroFreeBudget
    linarith [le_abs_self A]
  have hQQ : Q ≤ Q ^ (2 : ℕ) := by nlinarith
  have hdiv : Q ^ (2 : ℕ) ≤ Q ^ (2 : ℕ) / R := by
    rw [le_div_iff₀ (by simpa only [R] using hR0)]
    have hQsq : 0 ≤ Q ^ (2 : ℕ) := sq_nonneg Q
    nlinarith
  exact hAQ.trans (hQQ.trans hdiv)

set_option maxHeartbeats 800000 in
/-- The logarithm generated by the reciprocal `δ` is absorbed by the squared budget. -/
theorem routeT_log_delta_le_budget_sq (A γ : ℝ) :
    Real.log (1 + 1 / routeTZeroFreeDelta A γ) ≤
      routeTZeroFreeBudget A γ ^ (2 : ℕ) := by
  let Q := routeTZeroFreeBudget A γ
  let R := routeTLandauRadius γ
  have hQ := routeTZeroFreeBudget_ge A γ
  have hQ0 : 0 < Q := by simpa only [Q] using routeTZeroFreeBudget_pos A γ
  have hQ1 : 1 ≤ Q := by linarith
  have hR0 : 0 < R := by simpa only [R] using routeTLandauRadius_pos γ
  have hΦ := routeTLandauPhi_one_le γ
  have hlogΦ : 0 ≤ Real.log (routeTLandauPhi γ) := Real.log_nonneg hΦ
  have hlogR0 : 0 ≤ Real.log (1 + 1 / R) := Real.log_nonneg (by
    have hinv : 0 < 1 / R := by positivity
    linarith)
  have hlogRQ : Real.log (1 + 1 / R) ≤ Q := by
    dsimp only [Q, R]
    unfold routeTZeroFreeBudget
    linarith [abs_nonneg A]
  have hdelta : 1 / routeTZeroFreeDelta A γ = 10000 * Q ^ (2 : ℕ) / R := by
    unfold routeTZeroFreeDelta
    dsimp only [Q, R]
    field_simp [ne_of_gt hR0, ne_of_gt hQ0]
  have harg : 1 + 1 / routeTZeroFreeDelta A γ ≤
      (1 + 1 / R) * (10001 * Q ^ (2 : ℕ)) := by
    rw [hdelta]
    have hQsq : 1 ≤ Q ^ (2 : ℕ) := one_le_pow₀ hQ1
    field_simp [ne_of_gt hR0]
    nlinarith
  have harg0 : 0 < 1 + 1 / routeTZeroFreeDelta A γ := by
    have hinv : 0 < 1 / routeTZeroFreeDelta A γ := by
      exact one_div_pos.mpr (routeTZeroFreeDelta_pos A γ)
    linarith
  have hprod0 : 0 < (1 + 1 / R) * (10001 * Q ^ (2 : ℕ)) := by positivity
  have hlogmono := Real.log_le_log harg0 harg
  have hsplit : Real.log ((1 + 1 / R) * (10001 * Q ^ (2 : ℕ))) =
      Real.log (1 + 1 / R) + Real.log 10001 + Real.log (Q ^ (2 : ℕ)) := by
    rw [Real.log_mul (by positivity) (by positivity), Real.log_mul (by norm_num) (by positivity)]
    ring
  rw [hsplit] at hlogmono
  have hlog10001 : Real.log (10001 : ℝ) ≤ 10000 := by
    have hh := Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 10001)
    norm_num at hh
    exact hh
  have hlogQ : Real.log Q ≤ Q - 1 := Real.log_le_sub_one_of_pos hQ0
  have hlogQsq : Real.log (Q ^ (2 : ℕ)) ≤ 2 * Q := by
    rw [Real.log_pow]
    norm_num
    linarith
  have hbudget : 3 * Q + 10000 ≤ Q ^ (2 : ℕ) := by nlinarith
  exact hlogmono.trans (by linarith)

theorem routeTZeroFreeDelta_le_sixteenth (A γ : ℝ) :
    routeTZeroFreeDelta A γ ≤ 1 / 16 := by
  have hR : routeTLandauRadius γ < 1 / 2 := routeTLandauRadius_lt_half γ
  have hQ := routeTZeroFreeBudget_ge A γ
  have hden : (16 : ℝ) ≤ 10000 * routeTZeroFreeBudget A γ ^ (2 : ℕ) := by nlinarith
  unfold routeTZeroFreeDelta
  have hden0 : (0 : ℝ) < 10000 * routeTZeroFreeBudget A γ ^ (2 : ℕ) := by positivity
  rw [div_le_div_iff₀ hden0 (by norm_num)]
  nlinarith

set_option maxHeartbeats 800000 in
/-- **Positive-height Route-T zero-free region.** -/
theorem riemannZeta_ne_zero_routeT_region
    {β γ A : ℝ}
    (hA : ∀ σ : ℝ, 1 < σ → σ ≤ 2 →
      (-deriv riemannZeta (σ : ℂ) / riemannZeta (σ : ℂ)).re ≤ 1 / (σ - 1) + A)
    (hγ : 100000 ≤ γ)
    (hlarge : routeTBandDepthRootThreshold ^ (10 : ℕ) ≤ routeTBinaryHeight γ)
    (hβ1 : β ≤ 1)
    (hβgt : 1 - routeTZeroFreeWidth A γ < β) :
    riemannZeta ((β : ℂ) + (γ : ℂ) * Complex.I) ≠ 0 := by
  let R := routeTLandauRadius γ
  let Q := routeTZeroFreeBudget A γ
  let δ := routeTZeroFreeDelta A γ
  have hR0 : 0 < R := by simpa only [R] using routeTLandauRadius_pos γ
  have hQ := routeTZeroFreeBudget_ge A γ
  have hQ0 : 0 < Q := by simpa only [Q] using routeTZeroFreeBudget_pos A γ
  have hδ0 : 0 < δ := by simpa only [δ] using routeTZeroFreeDelta_pos A γ
  have hδ16 : δ ≤ 1 / 16 := by
    simpa only [δ] using routeTZeroFreeDelta_le_sixteenth A γ
  have hβgap : 1 - β < δ / 10 := by
    dsimp only [δ]
    unfold routeTZeroFreeWidth at hβgt
    linarith
  have hgap0 : 0 < 1 + δ - β := by linarith
  have hgapsmall : 1 + δ - β < 11 * δ / 10 := by linarith
  have hδeq : δ = R / (10000 * Q ^ (2 : ℕ)) := by rfl
  have hclose : 1 + δ - β ≤ R / 4 := by
    have hQsq : (1 : ℝ) ≤ Q ^ (2 : ℕ) := by nlinarith
    rw [hδeq] at hgapsmall
    have hden0 : (0 : ℝ) < 10000 * Q ^ (2 : ℕ) := by positivity
    have hsmall : 11 * (R / (10000 * Q ^ (2 : ℕ))) / 10 ≤ R / 4 := by
      field_simp [ne_of_gt hR0, ne_of_gt hQ0]
      nlinarith
    linarith
  apply riemannZeta_ne_zero_routeT_of_dlvp_lt hA hγ hlarge hδ0 hδ16 hβ1 hclose
  have hlogΦ : Real.log (routeTLandauPhi γ) ≤ Q ^ (2 : ℕ) := by
    simpa only [Q] using routeT_log_phi_le_budget_sq A γ
  have hlogδ : Real.log (1 + 1 / δ) ≤ Q ^ (2 : ℕ) := by
    simpa only [δ, Q] using routeT_log_delta_le_budget_sq A γ
  have hAle : A ≤ Q ^ (2 : ℕ) / R := by
    simpa only [Q, R] using routeT_pole_const_le_budget_sq_div_radius A γ
  have hδinv : 1 / δ = 10000 * Q ^ (2 : ℕ) / R := by
    rw [hδeq]
    field_simp [ne_of_gt hR0, ne_of_gt hQ0]
  have hinside : 5 / 4 * Real.log (routeTLandauPhi γ) +
      3 / 4 * Real.log (1 + 1 / δ) + 6 ≤ 8 * Q ^ (2 : ℕ) := by
    have hQsq : (1 : ℝ) ≤ Q ^ (2 : ℕ) := by nlinarith
    nlinarith
  have hRHS : 3 / δ + 3 * A + 160 / R *
      (5 / 4 * Real.log (routeTLandauPhi γ) +
        3 / 4 * Real.log (1 + 1 / δ) + 6) ≤
      31283 * Q ^ (2 : ℕ) / R := by
    have hmul := mul_le_mul_of_nonneg_left hinside (by positivity : 0 ≤ 160 / R)
    have hthree : 3 / δ = 30000 * Q ^ (2 : ℕ) / R := by
      calc
        3 / δ = 3 * (1 / δ) := by ring
        _ = 3 * (10000 * Q ^ (2 : ℕ) / R) := by rw [hδinv]
        _ = 30000 * Q ^ (2 : ℕ) / R := by ring
    have hpole : 3 * A ≤ 3 * (Q ^ (2 : ℕ) / R) :=
      mul_le_mul_of_nonneg_left hAle (by norm_num)
    have hlandau : 160 / R *
        (5 / 4 * Real.log (routeTLandauPhi γ) +
          3 / 4 * Real.log (1 + 1 / δ) + 6) ≤ 1280 * Q ^ (2 : ℕ) / R := by
      calc
        160 / R *
            (5 / 4 * Real.log (routeTLandauPhi γ) +
              3 / 4 * Real.log (1 + 1 / δ) + 6) ≤
            160 / R * (8 * Q ^ (2 : ℕ)) := hmul
        _ = 1280 * Q ^ (2 : ℕ) / R := by ring
    rw [hthree]
    calc
      30000 * Q ^ (2 : ℕ) / R + 3 * A + 160 / R *
          (5 / 4 * Real.log (routeTLandauPhi γ) +
            3 / 4 * Real.log (1 + 1 / δ) + 6) ≤
        30000 * Q ^ (2 : ℕ) / R + 3 * (Q ^ (2 : ℕ) / R) + 1280 * Q ^ (2 : ℕ) / R :=
          add_le_add (add_le_add le_rfl hpole) hlandau
      _ = 31283 * Q ^ (2 : ℕ) / R := by ring
  have hLHS : (400000 / 11) * Q ^ (2 : ℕ) / R < 4 / (1 + δ - β) := by
    have hsmallpos : 0 < 11 * δ / 10 := by positivity
    have hh := div_lt_div_of_pos_left (by norm_num : (0 : ℝ) < 4) hgap0 hgapsmall
    have heq : 4 / (11 * δ / 10) = (400000 / 11) * Q ^ (2 : ℕ) / R := by
      rw [hδeq]
      field_simp [ne_of_gt hR0, ne_of_gt hQ0]
      ring
    rw [heq] at hh
    exact hh
  have hnum : (31283 : ℝ) < 400000 / 11 := by norm_num
  have hscale : 0 < Q ^ (2 : ℕ) / R := by positivity
  have hcompare : 31283 * Q ^ (2 : ℕ) / R < (400000 / 11) * Q ^ (2 : ℕ) / R := by
    have hQsq0 : 0 < Q ^ (2 : ℕ) := sq_pos_of_pos hQ0
    have hh := mul_lt_mul_of_pos_right hnum hQsq0
    exact div_lt_div_of_pos_right hh hR0
  exact lt_of_le_of_lt hRHS (hcompare.trans hLHS)

/-- Existence form with the pole constant hidden. -/
theorem exists_routeT_zero_free_region :
    ∃ A : ℝ, ∀ β γ : ℝ, 100000 ≤ γ →
      routeTBandDepthRootThreshold ^ (10 : ℕ) ≤ routeTBinaryHeight γ → β ≤ 1 →
      1 - routeTZeroFreeWidth A γ < β →
      riemannZeta ((β : ℂ) + (γ : ℂ) * Complex.I) ≠ 0 := by
  obtain ⟨A, hA⟩ := exists_pole_bound
  exact ⟨A, fun _β _γ hγ hlarge hβ1 hβgt =>
    riemannZeta_ne_zero_routeT_region hA hγ hlarge hβ1 hβgt⟩

end

end RHTower.Sieve
