namespace HedenmalmThetaSource

/-- Every actual compact theta Xi vector satisfies the generalized quantile root equation at its
literal reciprocal eigenvalue.  This bridge exposes the full cross-polarized Green law, not only
its diagonal flux specialization. -/
theorem thetaXiDivisorEigenvector_isQuantileRootMode (q : XiZeroCopy) :
    IsQuantileRootMode thetaSource (thetaXiReciprocalEigenvalue q)
      (thetaXiDivisorEigenvector q) := by
  let g : Lp ℂ 2 unitIntervalMeasure := thetaXiDivisorEigenvector q
  let lam : ℂ := thetaXiReciprocalEigenvalue q
  have heigen : thetaCompactSourceInverse g = lam • g := by
    exact thetaCompactSourceInverse_thetaXi_eigen q
  have hop :
      (thetaCompactSourceInverse g : ℝ → ℂ) =ᵐ[unitIntervalMeasure]
        fun t => pinnedKernelField thetaSource t g := by
    simpa [thetaCompactSourceInverse] using
      (pinnedKernelOperator_ae thetaSource hasFiniteKernelEnergy_thetaSource g)
  have heigenAe :
      (thetaCompactSourceInverse g : ℝ → ℂ) =ᵐ[unitIntervalMeasure]
        fun t => lam * g t := by
    rw [heigen]
    exact Lp.coeFn_smul lam g
  have hvolterra := pinnedVolterra_coeFn g
  unfold IsQuantileRootMode
  filter_upwards [hop, heigenAe, hvolterra] with t hopT heigenT hvolterraT
  rw [hvolterraT, ← pinnedKernelField_apply_eq_pinnedVolterraFun]
  rw [← hopT, heigenT]

/-- **Critical-line cross-boundary blindness.**  The two actual line-conjugate theta root modes
are orthogonal for the complete rank-two pinned Green form. -/
theorem inner_pinnedBoundaryCLM_thetaXi_lineConj_eq_zero (q : XiZeroCopy) :
    (inner ℂ (pinnedBoundaryCLM (thetaXiDivisorEigenvector q))
      (thetaXiDivisorEigenvector (xiZeroCopyLineConjEquiv q)) : ℂ) = 0 := by
  rw [inner_pinnedBoundaryCLM_rootMode_pair thetaSource
    (thetaXiDivisorEigenvector_isQuantileRootMode q)
    (thetaXiDivisorEigenvector_isQuantileRootMode (xiZeroCopyLineConjEquiv q))
    thetaMetricBound_nonneg norm_metricSymbol_thetaSource_le]
  simp [thetaXiReciprocalEigenvalue, xiSpectralPoint_lineConj, map_inv₀]

/-- Line-conjugate source primitive is conjugate spatial reflection of the original primitive. -/
theorem sourceModeU_xiSpectralPoint_lineConj_eq_criticalConjReflection
    (q : XiZeroCopy) (x : ℝ) :
    sourceModeU thetaSource (xiSpectralPoint (xiZeroCopyLineConjEquiv q)) x =
      (starRingEnd ℂ) (sourceModeU thetaSource (xiSpectralPoint q) (-x)) := by
  let z : ℂ := (starRingEnd ℂ) (xiSpectralPoint q)
  have hz : |z.im| < 1 := by
    dsimp [z]
    rw [abs_neg]
    exact thetaXiSpectralPoint_mem_sourceStrip q
  have hzero : xiC thetaSource z = 0 := by
    dsimp [z]
    rw [← xiSpectralPoint_lineConj]
    exact xiC_thetaSource_xiSpectralPoint_eq_zero (xiZeroCopyLineConjEquiv q)
  rw [xiSpectralPoint_lineConj]
  calc
    sourceModeU thetaSource z x = -sourceModeU thetaSource (-z) (-x) := by
      rw [sourceModeU_neg thetaSource thetaSource_even
        (hasShiftedTail_thetaSource hz) hzero x]
      ring
    _ = (starRingEnd ℂ) (sourceModeU thetaSource (xiSpectralPoint q) (-x)) := by
      rw [conj_sourceModeU]

/-- Critical-line reflection preserves the positive theta root energy. -/
theorem thetaXiRootEnergy_lineConj (q : XiZeroCopy) :
    thetaXiRootEnergy (xiZeroCopyLineConjEquiv q) = thetaXiRootEnergy q := by
  rw [thetaXiRootEnergy, thetaXiRootEnergy,
    thetaRootEnergy_eq_integral_norm_sq_sourceModeU_div_mass_sq
      (thetaXiSpectralPoint_mem_sourceStrip (xiZeroCopyLineConjEquiv q)),
    thetaRootEnergy_eq_integral_norm_sq_sourceModeU_div_mass_sq
      (thetaXiSpectralPoint_mem_sourceStrip q)]
  congr 1
  rw [show (fun x : ℝ =>
      ‖sourceModeU thetaSource
        (xiSpectralPoint (xiZeroCopyLineConjEquiv q)) x‖ ^ 2) =
      fun x : ℝ => ‖sourceModeU thetaSource (xiSpectralPoint q) (-x)‖ ^ 2 by
    funext x
    rw [sourceModeU_xiSpectralPoint_lineConj_eq_criticalConjReflection,
      RCLike.norm_conj]]
  simpa using (integral_neg_eq_self
    (fun x : ℝ => ‖sourceModeU thetaSource (xiSpectralPoint q) x‖ ^ 2)
    (volume : Measure ℝ))

/-- Diagonal pinned-boundary current reverses under critical-line reflection. -/
theorem thetaXiRankTwoBoundaryFlux_lineConj (q : XiZeroCopy) :
    thetaXiRankTwoBoundaryFlux (xiZeroCopyLineConjEquiv q) =
      -thetaXiRankTwoBoundaryFlux q := by
  rw [thetaXiRankTwoBoundaryFlux_eq, thetaXiRankTwoBoundaryFlux_eq,
    xiSpectralPoint_lineConj, Complex.conj_im, thetaXiRootEnergy_lineConj]
  ring

/-- General reflection-symmetric Hermitian scalar correction generated by the pinned rank-two
boundary form.  `a` is its common diagonal coefficient and `c` its arbitrary cross coefficient. -/
def thetaXiReflectionSymmetricRankTwoCorrection
    (a : ℝ) (c : ℂ) (q : XiZeroCopy) : ℝ :=
  a * (thetaXiRankTwoBoundaryFlux q +
    thetaXiRankTwoBoundaryFlux (xiZeroCopyLineConjEquiv q)) +
  2 * (c * inner ℂ (pinnedBoundaryCLM (thetaXiDivisorEigenvector q))
    (thetaXiDivisorEigenvector (xiZeroCopyLineConjEquiv q))).re

/-- **Full rank-two correction blindness.**  Every reflection-symmetric Hermitian correction
generated by the pinned Green form vanishes on every actual Xi line-conjugate pair. -/
theorem thetaXiReflectionSymmetricRankTwoCorrection_eq_zero
    (a : ℝ) (c : ℂ) (q : XiZeroCopy) :
    thetaXiReflectionSymmetricRankTwoCorrection a c q = 0 := by
  rw [thetaXiReflectionSymmetricRankTwoCorrection,
    thetaXiRankTwoBoundaryFlux_lineConj,
    inner_pinnedBoundaryCLM_thetaXi_lineConj_eq_zero]
  simp

/-- Reflected-pair forward energy after the most general symmetric pinned-rank-two correction. -/
def criticalXiReflectionPairCorrectedForwardEnergy
    (L a : ℝ) (c : ℂ) (q : XiZeroCopy) : ℝ :=
  criticalXiSourceModeForwardEnergy L q +
    criticalXiSourceModeForwardEnergy L (xiZeroCopyLineConjEquiv q) +
      thetaXiReflectionSymmetricRankTwoCorrection a c q

/-- P-G109's sharp hyperbolic lower bound specialized to an actual Xi line-conjugate pair. -/
theorem criticalXiReflectionPairForwardEnergy_hyperbolic_lower
    {L : ℝ} (hL : 0 ≤ L) (q : XiZeroCopy) :
    2 * Real.cosh L * criticalXiSourceModeEnergy q ≤
      criticalXiSourceModeForwardEnergy L q +
        criticalXiSourceModeForwardEnergy L (xiZeroCopyLineConjEquiv q) := by
  let f : ℝ → ℂ := sourceModeF thetaSource (xiSpectralPoint q)
  have hz := thetaXiSpectralPoint_mem_sourceStrip q
  have hzero := xiC_thetaSource_xiSpectralPoint_eq_zero q
  have hbase := integrable_criticalEnergyDensity_sourceModeF hz hzero
  have hf : AEStronglyMeasurable f := by
    dsimp [f]
    unfold sourceModeF
    exact (continuous_const.mul (continuous_sourceModeU hz)).aestronglyMeasurable
  have hforward := integrable_criticalForwardPulledEnergyDensity hL hf hbase
  have hbackward := integrable_criticalBackwardPulledEnergyDensity hL hf hbase
  have hsum := integral_criticalEnergyDensity_hyperbolic_le_shift_sum
    hL f hbase hforward hbackward
  rw [criticalXiSourceModeForwardEnergy, criticalXiSourceModeEnergy,
    criticalCenteredForwardTranslationEnergy_eq_pulled,
    criticalXiSourceModeForwardEnergy_lineConj_eq_backward,
    criticalCenteredBackwardTranslationEnergy_eq_pulled]
  exact hsum

/-- Rank-two correction leaves the exact hyperbolic lower bound unchanged. -/
theorem criticalXiReflectionPairCorrectedForwardEnergy_hyperbolic_lower
    {L : ℝ} (hL : 0 ≤ L) (a : ℝ) (c : ℂ) (q : XiZeroCopy) :
    2 * Real.cosh L * criticalXiSourceModeEnergy q ≤
      criticalXiReflectionPairCorrectedForwardEnergy L a c q := by
  rw [criticalXiReflectionPairCorrectedForwardEnergy,
    thetaXiReflectionSymmetricRankTwoCorrection_eq_zero, add_zero]
  exact criticalXiReflectionPairForwardEnergy_hyperbolic_lower hL q

/-- **Quantitative corrected no-go.**  At every positive aperture, corrected forward pair energy
is strictly larger than unshifted pair energy, for all symmetric pinned-rank-two coefficients. -/
theorem criticalXiReflectionPairEnergy_lt_correctedForwardEnergy
    {L : ℝ} (hL : 0 < L) (a : ℝ) (c : ℂ) (q : XiZeroCopy) :
    2 * criticalXiSourceModeEnergy q <
      criticalXiReflectionPairCorrectedForwardEnergy L a c q := by
  have hlower :=
    criticalXiReflectionPairCorrectedForwardEnergy_hyperbolic_lower hL.le a c q
  have hcosh : 1 < Real.cosh L := Real.one_lt_cosh.mpr hL.ne'
  have henergy := criticalXiSourceModeEnergy_pos q
  nlinarith

