import GaloisForLFunctions.RHTower.Hedenmalm.HedenmalmPrimeGammaExteriorReflectionProjector
import GaloisForLFunctions.RHTower.BurnolCoPoissonTopConormalPluckerJuliaCayleyLanding

/-!
# Source-native prime--Ward clock for the exterior reflection projector

The horizontal clock in the exterior projector can be generated by one fixed integer translation
of the Hedenmalm source.  Its normalized squared gain is `p^(2 Re rho - 1)` and its literal Ward
coordinate is `(A-1)/(A+1)`.  Applying the real Cayley transform produces a unit clock which is
reciprocal under critical-line reflection and injective in the horizontal rate.

Consequently, two prime ordinate clocks and this source-native Ward clock select exactly the
critical-line reflected partner.  Replacing the abstract horizontal clock by this one leaves the
exterior determinant limit and the full two-orientation Ward--Green packet unchanged.
-/

open Complex Filter Topology
open scoped BigOperators

namespace RHTower

noncomputable section

/-- Canonical multiplicity copy attached to one Xi divisor support point. -/
def xiDivisorSupportCanonicalCopy (rho : XiDivisorSupport) : XiZeroCopy :=
  ⟨rho, ⟨0, xiSupportMultiplicity_pos rho⟩⟩

@[simp] theorem xiDivisorSupportCanonicalCopy_support (rho : XiDivisorSupport) :
    (xiDivisorSupportCanonicalCopy rho).1 = rho := rfl

/-- Ward coordinate produced by normalized squared gain of one fixed prime translation. -/
def xiPrimeWardTranslationCoordinate (p : Nat.Primes) (rho : XiDivisorSupport) : ℝ :=
  ((p : ℝ) ^ primeDepthBVWoldXiCenteredRate rho - 1) /
    ((p : ℝ) ^ primeDepthBVWoldXiCenteredRate rho + 1)

/-- Exact provenance: the support coordinate is the existing fixed-source Xi--Ward coordinate. -/
theorem xiPrimeWardTranslationCoordinate_eq_fixedSource
    (p : Nat.Primes) (rho : XiDivisorSupport) :
    xiPrimeWardTranslationCoordinate p rho =
      HedenmalmThetaSource.burnolXiPrimeCayleyCoordinate
        (xiDivisorSupportCanonicalCopy rho) p := by
  rw [HedenmalmThetaSource.burnolXiPrimeCayleyCoordinate_eq_character_ratio]
  rfl

/-- The coordinate is literally the Ward half-plane factor of the fixed source aperture. -/
theorem xiWardHalfPlaneCayleyFactor_canonicalPrimeAperture
    (p : Nat.Primes) (rho : XiDivisorSupport) :
    xiWardHalfPlaneCayleyFactor
        ((((1 + 2 * HedenmalmThetaSource.burnolXiPrimeCayleyAperture
          (xiDivisorSupportCanonicalCopy rho) p) / 2 : ℝ) : ℂ))
        ((((1 + 2 * HedenmalmThetaSource.burnolXiPrimeCayleyAperture
          (xiDivisorSupportCanonicalCopy rho) p) / 2 : ℝ) : ℂ))
        1 = (xiPrimeWardTranslationCoordinate p rho : ℂ) := by
  rw [xiPrimeWardTranslationCoordinate_eq_fixedSource]
  exact HedenmalmThetaSource.xiWardHalfPlaneCayleyFactor_burnolXiPrimeAperture
    (xiDivisorSupportCanonicalCopy rho) p

/-- Critical-line reflection reverses the fixed-source Ward coordinate. -/
theorem xiPrimeWardTranslationCoordinate_lineConj
    (p : Nat.Primes) (rho : XiDivisorSupport) :
    xiPrimeWardTranslationCoordinate p (xiZeroLineConjEquiv rho) =
      -xiPrimeWardTranslationCoordinate p rho := by
  have hp0 : (0 : ℝ) < (p : ℝ) := by exact_mod_cast p.2.pos
  let A : ℝ := (p : ℝ) ^ primeDepthBVWoldXiCenteredRate rho
  have hA : 0 < A := Real.rpow_pos_of_pos hp0 _
  rw [xiPrimeWardTranslationCoordinate, xiPrimeWardTranslationCoordinate,
    primeDepthBVWoldXiCenteredRate_reflection, Real.rpow_neg hp0.le]
  change (A⁻¹ - 1) / (A⁻¹ + 1) = -((A - 1) / (A + 1))
  field_simp [hA.ne', (by positivity : A + 1 ≠ 0)]
  ring

/-- At one retained prime, Ward translation coordinate is injective in horizontal position. -/
theorem eq_re_of_xiPrimeWardTranslationCoordinate_eq
    (p : Nat.Primes) {rho sigma : XiDivisorSupport}
    (h : xiPrimeWardTranslationCoordinate p rho =
      xiPrimeWardTranslationCoordinate p sigma) :
    (rho : ℂ).re = (sigma : ℂ).re := by
  have hp0 : (0 : ℝ) < (p : ℝ) := by exact_mod_cast p.2.pos
  have hp1 : (1 : ℝ) < (p : ℝ) := by exact_mod_cast p.2.one_lt
  let A : ℝ := (p : ℝ) ^ primeDepthBVWoldXiCenteredRate rho
  let B : ℝ := (p : ℝ) ^ primeDepthBVWoldXiCenteredRate sigma
  have hA : 0 < A := Real.rpow_pos_of_pos hp0 _
  have hB : 0 < B := Real.rpow_pos_of_pos hp0 _
  have hfrac : (A - 1) / (A + 1) = (B - 1) / (B + 1) := by
    simpa only [xiPrimeWardTranslationCoordinate, A, B] using h
  have hAB : A = B := by
    field_simp [(by positivity : A + 1 ≠ 0), (by positivity : B + 1 ≠ 0)] at hfrac
    linarith
  have hrate : primeDepthBVWoldXiCenteredRate rho =
      primeDepthBVWoldXiCenteredRate sigma :=
    (Real.strictMono_rpow_of_base_gt_one hp1).injective hAB
  rw [primeDepthBVWoldXiCenteredRate, primeDepthBVWoldXiCenteredRate] at hrate
  linarith

/-- Unit-circle clock obtained by Cayley-transforming the literal prime--Ward coordinate. -/
def xiPrimeWardSourceCayleyPhase (p : Nat.Primes) (rho : XiDivisorSupport) : ℂ :=
  GaloisForLFunctions.HTGeometry.realCayley
    (xiPrimeWardTranslationCoordinate p rho)

theorem xiPrimeWardSourceCayleyPhase_norm
    (p : Nat.Primes) (rho : XiDivisorSupport) :
    ‖xiPrimeWardSourceCayleyPhase p rho‖ = 1 :=
  GaloisForLFunctions.HTGeometry.norm_realCayley _

/-- The source-native clock is reciprocal under critical-line reflection. -/
theorem xiPrimeWardSourceCayleyPhase_mul_lineConj
    (p : Nat.Primes) (rho : XiDivisorSupport) :
    xiPrimeWardSourceCayleyPhase p rho *
      xiPrimeWardSourceCayleyPhase p (xiZeroLineConjEquiv rho) = 1 := by
  rw [xiPrimeWardSourceCayleyPhase, xiPrimeWardSourceCayleyPhase,
    xiPrimeWardTranslationCoordinate_lineConj]
  exact realCayley_neg_mul (xiPrimeWardTranslationCoordinate p rho)

/-- Two ordinate clocks plus one fixed-source Ward clock select exactly line reflection. -/
theorem xiPrimeWardExteriorPhase_selector_iff
    (p : Nat.Primes) (rho sigma : XiDivisorSupport) :
    (xiHorizontalPrimePhase 2 (rho : ℂ).im =
        xiHorizontalPrimePhase 2 (sigma : ℂ).im ∧
      xiHorizontalPrimePhase 3 (rho : ℂ).im =
        xiHorizontalPrimePhase 3 (sigma : ℂ).im ∧
      xiPrimeWardSourceCayleyPhase p rho *
          xiPrimeWardSourceCayleyPhase p sigma = 1) ↔
      sigma = xiZeroLineConjEquiv rho := by
  constructor
  · rintro ⟨h2, h3, hu⟩
    have him : (rho : ℂ).im = (sigma : ℂ).im :=
      xiHorizontalPrimePhase_pair_injective (Prod.ext h2 h3)
    have href := xiPrimeWardSourceCayleyPhase_mul_lineConj p rho
    have hne : xiPrimeWardSourceCayleyPhase p rho ≠ 0 :=
      norm_ne_zero_iff.mp (by rw [xiPrimeWardSourceCayleyPhase_norm]; norm_num)
    have hphase : xiPrimeWardSourceCayleyPhase p sigma =
        xiPrimeWardSourceCayleyPhase p (xiZeroLineConjEquiv rho) := by
      apply mul_left_cancel₀ hne
      exact hu.trans href.symm
    have hcoord : xiPrimeWardTranslationCoordinate p sigma =
        xiPrimeWardTranslationCoordinate p (xiZeroLineConjEquiv rho) :=
      GaloisForLFunctions.HTGeometry.injective_realCayley hphase
    apply Subtype.ext
    apply Complex.ext
    · exact eq_re_of_xiPrimeWardTranslationCoordinate_eq p hcoord
    · simpa [xiZeroLineConjEquiv_apply] using him.symm
  · intro hsigma
    subst sigma
    exact ⟨
      congrArg (xiHorizontalPrimePhase 2) (by simp [xiZeroLineConjEquiv_apply]),
      congrArg (xiHorizontalPrimePhase 3) (by simp [xiZeroLineConjEquiv_apply]),
      xiPrimeWardSourceCayleyPhase_mul_lineConj p rho⟩

/-- Mixed projector with third clock generated by a fixed source translation. -/
def xiPrimeWardExteriorReflectionProjector
    (p : Nat.Primes) (S : Finset XiDivisorSupport)
    (C : XiDivisorSupport → XiDivisorSupport → ℂ) (N : ℕ) : ℂ :=
  finiteExteriorReflectionProjector S C
    (fun rho => xiHorizontalPrimePhase 2 (rho : ℂ).im)
    (fun rho => xiHorizontalPrimePhase 3 (rho : ℂ).im)
    (xiPrimeWardSourceCayleyPhase p) N

theorem tendsto_xiPrimeWardExteriorReflectionProjector
    (p : Nat.Primes) (S : Finset XiDivisorSupport)
    (C : XiDivisorSupport → XiDivisorSupport → ℂ) :
    Tendsto (xiPrimeWardExteriorReflectionProjector p S C) atTop
      (nhds (∑ rho ∈ S, ∑ sigma ∈ S,
        if sigma = xiZeroLineConjEquiv rho then C rho sigma else 0)) := by
  have hlim := tendsto_finiteExteriorReflectionProjector S C
    (fun rho => xiHorizontalPrimePhase 2 (rho : ℂ).im)
    (fun rho => xiHorizontalPrimePhase 3 (rho : ℂ).im)
    (xiPrimeWardSourceCayleyPhase p)
    (fun rho _ => xiHorizontalPrimePhase_norm 2 (rho : ℂ).im)
    (fun rho _ => xiHorizontalPrimePhase_norm 3 (rho : ℂ).im)
    (fun rho _ => xiPrimeWardSourceCayleyPhase_norm p rho)
  convert hlim using 1
  · rfl
  · apply congrArg nhds
    apply Finset.sum_congr rfl
    intro rho hrho
    apply Finset.sum_congr rfl
    intro sigma hsigma
    simp only [xiPrimeWardExteriorPhase_selector_iff]

/-- Source determinant whose horizontal clock is the fixed-prime Ward translation clock. -/
def xiPrimeWardExteriorReflectionDeterminant
    (p : Nat.Primes) (S : Finset XiDivisorSupport)
    (r f g : XiDivisorSupport → ℂ) (a b c : ℕ) : ℂ :=
  finiteExteriorReflectionDeterminant S r f g
    (fun rho => xiHorizontalPrimePhase 2 (rho : ℂ).im)
    (fun rho => xiHorizontalPrimePhase 3 (rho : ℂ).im)
    (xiPrimeWardSourceCayleyPhase p) a b c

/-- The fixed-source clock removes all cross minors and lands on reflected Pluecker squares. -/
theorem tendsto_xiPrimeWardExteriorReflectionDeterminant
    (p : Nat.Primes) (S : Finset XiDivisorSupport)
    (hclosed : ∀ rho ∈ S, xiZeroLineConjEquiv rho ∈ S)
    (r f g : XiDivisorSupport → ℂ) :
    Tendsto
      (fun N : ℕ => (((N : ℝ)⁻¹ : ℂ) ^ 3) *
        ∑ a ∈ Finset.range N, ∑ b ∈ Finset.range N, ∑ c ∈ Finset.range N,
          xiPrimeWardExteriorReflectionDeterminant p S r f g a b c)
      atTop
      (nhds ((1 / 2 : ℂ) * ∑ rho ∈ S,
        r rho * r (xiZeroLineConjEquiv rho) *
          (f rho * g (xiZeroLineConjEquiv rho) -
            f (xiZeroLineConjEquiv rho) * g rho) ^ 2)) := by
  let C : XiDivisorSupport → XiDivisorSupport → ℂ := fun rho sigma =>
    r rho * r sigma * (f rho * g sigma) *
      (f rho * g sigma - f sigma * g rho)
  have hprojector := tendsto_xiPrimeWardExteriorReflectionProjector p S C
  have hdet : Tendsto
      (fun N : ℕ => (((N : ℝ)⁻¹ : ℂ) ^ 3) *
        ∑ a ∈ Finset.range N, ∑ b ∈ Finset.range N, ∑ c ∈ Finset.range N,
          xiPrimeWardExteriorReflectionDeterminant p S r f g a b c)
      atTop
      (nhds (∑ rho ∈ S, ∑ sigma ∈ S,
        if sigma = xiZeroLineConjEquiv rho then C rho sigma else 0)) := by
    apply hprojector.congr'
    filter_upwards with N
    rw [xiPrimeWardExteriorReflectionProjector,
      finiteExteriorReflectionProjector_eq_detCesaro]
    rfl
  rw [xiExteriorReflectionSelectedPairSum_eq S hclosed C] at hdet
  have hsym := xiReflectionOrientedMinor_sum_eq_half_square S hclosed r f g
  have hlimitEq :
      (∑ rho ∈ S, C rho (xiZeroLineConjEquiv rho)) =
        (1 / 2 : ℂ) * ∑ rho ∈ S,
          r rho * r (xiZeroLineConjEquiv rho) *
            (f rho * g (xiZeroLineConjEquiv rho) -
              f (xiZeroLineConjEquiv rho) * g rho) ^ 2 := by
    simpa only [C] using hsym
  rw [hlimitEq] at hdet
  exact hdet

/-- Fixed-feature Abel determinant with fully source-native horizontal clock. -/
def xiPrimeWardExteriorAbelDeterminant
    (p : Nat.Primes) (S : Finset XiDivisorSupport)
    (R t : ℝ) (a b c : ℕ) : ℂ :=
  xiPrimeWardExteriorReflectionDeterminant p S
    (xiExteriorAbelRowWeight R)
    (xiCriticalFeatureSpectralValue t)
    (xiCriticalFeatureSpectralValue (t + 1)) a b c

/-- At the Abel boundary, the source-native determinant lands on fixed-center positive energy. -/
theorem tendsto_xiPrimeWardExteriorAbelDeterminant_one
    (p : Nat.Primes) (S : Finset XiDivisorSupport)
    (hclosed : ∀ rho ∈ S, xiZeroLineConjEquiv rho ∈ S)
    (t : ℝ) :
    Tendsto
      (fun N : ℕ => (((N : ℝ)⁻¹ : ℂ) ^ 3) *
        ∑ a ∈ Finset.range N, ∑ b ∈ Finset.range N, ∑ c ∈ Finset.range N,
          xiPrimeWardExteriorAbelDeterminant p S 1 t a b c)
      atTop
      (nhds (((1 / 2 : ℝ) *
        xiExteriorCayleyAbelFixedPacketEnergy S 1 t : ℝ) : ℂ)) := by
  have hlim := tendsto_xiPrimeWardExteriorReflectionDeterminant p S hclosed
    (xiExteriorAbelRowWeight 1)
    (xiCriticalFeatureSpectralValue t)
    (xiCriticalFeatureSpectralValue (t + 1))
  convert hlim using 1
  · rfl
  · apply congrArg nhds
    rw [xiExteriorCayleyAbelFixedPacketEnergy]
    push_cast
    rw [Finset.mul_sum, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro rho hrho
    rw [xiExteriorBoundaryReflectedMinor_eq_normSq,
      xiExteriorAbelRowWeight_mul_wedge_eq_fixedCoefficient]

/-- Both fixed adjacent orientations, assembled before taking the source-clock Cesaro limit. -/
def xiPrimeWardExteriorAbelPacketCesaro
    (p : Nat.Primes) (S : Finset XiDivisorSupport) (R : ℝ) (N : ℕ) : ℂ :=
  2 * ∑ t ∈ S.image xiExteriorReporterCenter,
    ((((N : ℝ)⁻¹ : ℂ) ^ 3) *
        ∑ a ∈ Finset.range N, ∑ b ∈ Finset.range N, ∑ c ∈ Finset.range N,
          xiPrimeWardExteriorAbelDeterminant p
            (xiExteriorReporterBlock S t) R t a b c +
      (((N : ℝ)⁻¹ : ℂ) ^ 3) *
        ∑ a ∈ Finset.range N, ∑ b ∈ Finset.range N, ∑ c ∈ Finset.range N,
          xiPrimeWardExteriorAbelDeterminant p
            (xiExteriorReporterBlock S t) R (t - 1) a b c)

/-- Full source-native determinant packet lands exactly on the existing Ward--Green energy. -/
theorem tendsto_xiPrimeWardExteriorAbelPacketCesaro_one
    (p : Nat.Primes) (S : Finset XiDivisorSupport)
    (hclosed : ∀ rho ∈ S, xiZeroLineConjEquiv rho ∈ S) :
    Tendsto (xiPrimeWardExteriorAbelPacketCesaro p S 1) atTop
      (nhds ((xiWardGreenExteriorPacketEnergy S : ℝ) : ℂ)) := by
  let G := S.image xiExteriorReporterCenter
  have hsum := tendsto_finsetSum G fun t ht =>
    (tendsto_xiPrimeWardExteriorAbelDeterminant_one p
      (xiExteriorReporterBlock S t)
      (xiExteriorReporterBlock_lineConj_closed S hclosed t) t).add
    (tendsto_xiPrimeWardExteriorAbelDeterminant_one p
      (xiExteriorReporterBlock S t)
      (xiExteriorReporterBlock_lineConj_closed S hclosed t) (t - 1))
  have htwo : Tendsto (fun _ : ℕ => (2 : ℂ)) atTop (nhds 2) :=
    tendsto_const_nhds
  have hscaled := htwo.mul hsum
  convert hscaled using 1
  · rfl
  · apply congrArg nhds
    rw [← sum_xiExteriorCayleyAbelFixedPacketEnergy_eq_packetEnergy S]
    push_cast
    dsimp [G]
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro t ht
    ring

end

end RHTower
