import GaloisForLFunctions.HTGeometry.CoerciveFiniteSchurComplement
import GaloisForLFunctions.RHTower.AnalyticKernelUniquenessRegion

namespace RHTower

open Set Filter Topology
open scoped InnerProductSpace
open GaloisForLFunctions.HTGeometry

noncomputable section

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- Closed Hilbert span generated by an analytic section family on its domain. -/
def analyticSectionClosedSpan (domain : Set ℂ) (sec : ℂ → H) : Submodule ℂ H :=
  (Submodule.span ℂ (sec '' domain)).topologicalClosure

instance analyticSectionClosedSpan_completeSpace (domain : Set ℂ) (sec : ℂ → H) :
    CompleteSpace (analyticSectionClosedSpan domain sec) :=
  (Submodule.isClosed_topologicalClosure _).completeSpace_coe

omit [CompleteSpace H] in
theorem analyticSection_mem_closedSpan {domain : Set ℂ} {sec : ℂ → H}
    {z : ℂ} (hz : z ∈ domain) :
    sec z ∈ analyticSectionClosedSpan domain sec := by
  apply Submodule.le_topologicalClosure
  apply Submodule.subset_span
  exact ⟨z, hz, rfl⟩

/-- Section family restricted to its own closed span, totalized by zero off-domain. -/
def closedSpanSection (domain : Set ℂ) (sec : ℂ → H) (z : ℂ) :
    analyticSectionClosedSpan domain sec := by
  classical
  exact if hz : z ∈ domain then ⟨sec z, analyticSection_mem_closedSpan hz⟩ else 0

omit [CompleteSpace H] in
theorem closedSpanSection_coe {domain : Set ℂ} {sec : ℂ → H}
    {z : ℂ} (hz : z ∈ domain) :
    (closedSpanSection domain sec z : H) = sec z := by
  simp [closedSpanSection, hz]

theorem closedSpanSection_global_total (domain : Set ℂ) (sec : ℂ → H) :
    (Submodule.span ℂ (closedSpanSection domain sec '' domain)).topologicalClosure = ⊤ := by
  rw [topologicalClosure_span_eq_top_iff]
  intro w hw
  apply Subtype.ext
  show (w : H) = 0
  apply (inner_self_eq_zero (𝕜 := ℂ)).mp
  have hwmem : (w : H) ∈ analyticSectionClosedSpan domain sec := w.property
  change (w : H) ∈ (Submodule.span ℂ (sec '' domain)).topologicalClosure at hwmem
  rw [mem_topologicalClosure_span_iff] at hwmem
  apply hwmem (w : H)
  intro s hs
  obtain ⟨z, hz, rfl⟩ := hs
  simpa [Submodule.coe_inner, closedSpanSection_coe hz] using
    hw (closedSpanSection domain sec z) ⟨z, hz, rfl⟩

/-- Ambient bounded form compressed to the closed span of a section family. -/
def compressedClosedSpanForm (domain : Set ℂ) (sec : ℂ → H) (A : H →L[ℂ] H) :
    analyticSectionClosedSpan domain sec →L[ℂ]
      analyticSectionClosedSpan domain sec :=
  (analyticSectionClosedSpan domain sec).orthogonalProjectionOnto.comp
    (A.comp (analyticSectionClosedSpan domain sec).subtypeL)

theorem compressedClosedSpanForm_hermitian
    (domain : Set ℂ) (sec : ℂ → H) (A : H →L[ℂ] H)
    (hA : ∀ x y : H, inner ℂ x (A y) = inner ℂ (A x) y)
    (x y : analyticSectionClosedSpan domain sec) :
    inner ℂ x (compressedClosedSpanForm domain sec A y) =
      inner ℂ (compressedClosedSpanForm domain sec A x) y := by
  rw [Submodule.coe_inner, Submodule.coe_inner]
  simp only [compressedClosedSpanForm, ContinuousLinearMap.comp_apply,
    Submodule.subtypeL_apply]
  rw [inner_coe_orthogonalProjectionOnto_eq,
    coe_orthogonalProjectionOnto_inner_eq, hA]

/-- Canonical analytic Hermitian realization obtained by compressing an ambient
Hermitian form to the closed span of its weakly analytic sections. -/
def compressedClosedSpanRealization
    (domain : Set ℂ) (sec : ℂ → H) (A : H →L[ℂ] H)
    (hpre : IsPreconnected domain)
    (hopen : IsOpen domain)
    (han : ∀ w : H, AnalyticOnNhd ℂ (fun z => inner ℂ w (sec z)) domain)
    (hA : ∀ x y : H, inner ℂ x (A y) = inner ℂ (A x) y) :
    AnalyticHermitianKernelRealization (analyticSectionClosedSpan domain sec) where
  domain := domain
  kernelSection := closedSpanSection domain sec
  domain_preconnected := hpre
  coefficient_analytic := by
    intro w
    apply AnalyticOnNhd.congr hopen (han (w : H))
    intro z hz
    change inner ℂ (w : H) (sec z) =
      inner ℂ (w : H) (closedSpanSection domain sec z : H)
    rw [closedSpanSection_coe hz]
  global_total := closedSpanSection_global_total domain sec
  form := compressedClosedSpanForm domain sec A
  form_hermitian := compressedClosedSpanForm_hermitian domain sec A hA

theorem compressedClosedSpanRealization_kernel_eq
    (domain : Set ℂ) (sec : ℂ → H) (A : H →L[ℂ] H)
    (hpre : IsPreconnected domain) (hopen : IsOpen domain)
    (han : ∀ w : H, AnalyticOnNhd ℂ (fun z => inner ℂ w (sec z)) domain)
    (hA : ∀ x y : H, inner ℂ x (A y) = inner ℂ (A x) y)
    {z w : ℂ} (hz : z ∈ domain) (hw : w ∈ domain) :
    (compressedClosedSpanRealization domain sec A hpre hopen han hA).kernel z w =
      inner ℂ (sec w) (A (sec z)) := by
  rw [AnalyticHermitianKernelRealization.kernel]
  simp only [compressedClosedSpanRealization, compressedClosedSpanForm,
    ContinuousLinearMap.comp_apply, Submodule.subtypeL_apply]
  rw [Submodule.coe_inner, closedSpanSection_coe hw, closedSpanSection_coe hz]
  exact (analyticSectionClosedSpan domain sec).inner_orthogonalProjectionOnto_eq_of_mem_left
    (⟨sec w, analyticSection_mem_closedSpan hw⟩ : analyticSectionClosedSpan domain sec)
    (A (sec z))

end
end RHTower
