    skewPlateauMuVV ((-3 / 2 : ℂ) + (t : ℂ) * Complex.I) (-(l : ℂ)) * ((128 * (2 + l) ^ 2 * ((4 * t ^ 2 - 2 - l) ^ 2 + 36 * t ^ 2) : ℝ) : ℂ) =
      Complex.I * (skewPlateauMuVVLine t l : ℂ) := by
  have hden : ((128 * (2 + l) ^ 2 * ((4 * t ^ 2 - 2 - l) ^ 2 + 36 * t ^ 2) : ℝ) : ℂ) ≠ 0 := by
    exact_mod_cast (skewPlateauLineDen_pos t l hl).ne'
  unfold skewPlateauMuVV
  rw [← skewPlateauMu_line_denominator t l, div_mul_cancel₀ _ (by rw [skewPlateauMu_line_denominator t l]; exact hden)]
  exact skewPlateauMuVVNumerator_line t l

/-- On the bulk harmonics `40t ≤ l ≤ 2t²` at height `t ≥ 50` the vector-vector kernel has positive
imaginary part, the opposite sign to the scalar-scalar kernel there. -/
theorem skewPlateauMuVV_line_im_pos (t l : ℝ) (ht : (50 : ℝ) ≤ t) (h1 : 40 * t ≤ l) (h2 : l ≤ 2 * t ^ 2) :
    0 < (skewPlateauMuVV ((-3 / 2 : ℂ) + (t : ℂ) * Complex.I) (-(l : ℂ))).im := by
  have hl0 : (0 : ℝ) ≤ l := by nlinarith
  have h := congrArg Complex.im (skewPlateauMuVV_line t l hl0)
  simp only [Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, Complex.I_re, Complex.I_im, mul_zero, zero_add, one_mul] at h
  have hden := skewPlateauLineDen_pos t l hl0
  have hF := skewPlateauMuVVLine_pos t l ht h1 h2
  nlinarith

/-- The two pure excitations give opposite signs on every bulk harmonic. -/
theorem skewSector_opposite_signs (t l : ℝ) (ht : (50 : ℝ) ≤ t) (h1 : 40 * t ≤ l) (h2 : l ≤ 2 * t ^ 2) :
    (skewPlateauMu ((-3 / 2 : ℂ) + (t : ℂ) * Complex.I) (-(l : ℂ))).im < 0 ∧
      0 < (skewPlateauMuVV ((-3 / 2 : ℂ) + (t : ℂ) * Complex.I) (-(l : ℂ))).im :=
  ⟨skewPlateauMu_line_im_neg t l ht h1, skewPlateauMuVV_line_im_pos t l ht h1 h2⟩

