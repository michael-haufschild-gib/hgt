import GaloisForLFunctions.RHTower.GammaSewnMobiusJuliaSourceTransport
import GaloisForLFunctions.HTGeometry.PrimeClockAnalyticEulerCompletion

/-!
# Gamma-sewn Julia transgression to the hypertranscendental Euler completion

The canonical Gamma-sewn Julia environment has a second arithmetic boundary face besides the
critical von Mangoldt face.  At damping `u = -1`, its squared hard coordinate divided by the
integer logarithm converges on every prime-power cell to `1 / r`.  Extended by zero, this is
exactly the natural-number coefficient stream of the canonical Euler logarithm of zeta.

Finite Dirichlet scalarizations therefore converge first to the Euler-logarithm polynomials; on
`Re s > 1`, removing the cutoff recovers the canonical Euler logarithm.  Its already constructed
analytic carrier is differentially independent over the differential field generated by the
coordinate and every prime-zeta valuation layer simultaneously.

Thus one source-defined Julia normal coordinate reaches both sides of the Euler completion
barrier: the present `u = -1` face reaches the hypertranscendental Euler logarithm, while the
critical `u = -1/2` face reaches the divisor-complete von Mangoldt source.

No Xi zero, RH assumption, estimate, numerical computation, or nonstandard axiom is used.
-/

open Complex Filter Function Set
open scoped Topology

namespace RHTower

noncomputable section

/-- Euler-logarithm coefficient generated by the squared Julia environment at damping `u = -1`. -/
def gammaSewnMobiusJuliaEulerLogCoefficient (x : ℝ) (n : ℕ) : ℂ :=
  if hpow : IsPrimePow n then
    ((gammaSewnMobiusJuliaHardHalfWeightTransport x (-1)
      (Nat.Primes.prodNatEquiv.symm ⟨n, hpow⟩) ^ 2 / Real.log n : ℝ) : ℂ)
  else 0

/-- Exact boundary normalization on one prime-power cell. -/
theorem xiGammaEulerBoundaryRealAmplitude_neg_one_sq_div_log
    (pe : Nat.Primes × ℕ) :
    xiGammaEulerBoundaryRealAmplitude (-1) pe ^ 2 /
        Real.log (xiGammaEulerValuationNat pe) =
      1 / (pe.2 + 1 : ℝ) := by
  have hpLog : 0 < Real.log (pe.1 : ℝ) :=
    Real.log_pos (by exact_mod_cast pe.1.property.one_lt)
  have hnNat : 0 < xiGammaEulerValuationNat pe := by
    unfold xiGammaEulerValuationNat
    exact Nat.pow_pos pe.1.property.pos
  have hn : (0 : ℝ) < xiGammaEulerValuationNat pe := by
    exact_mod_cast hnNat
  have hlog :
      Real.log (xiGammaEulerValuationNat pe) =
        (pe.2 + 1 : ℝ) * Real.log (pe.1 : ℝ) := by
    unfold xiGammaEulerValuationNat
    push_cast
    rw [Real.log_pow]
    norm_num [Nat.cast_add, Nat.cast_one]
  have hamp := xiGammaEulerBoundaryRealAmplitude_sq (-1) pe
  have hamp' :
      xiGammaEulerBoundaryRealAmplitude (-1) pe ^ 2 =
        Real.log (pe.1 : ℝ) := by
    rw [show -(-1 : ℝ) * Real.log (xiGammaEulerValuationNat pe) =
      Real.log (xiGammaEulerValuationNat pe) by ring,
      Real.exp_log hn] at hamp
    have hnne : (xiGammaEulerValuationNat pe : ℝ) ≠ 0 := ne_of_gt hn
    simpa [hnne] using hamp
  rw [hamp', hlog]
  field_simp [hpLog.ne', show (pe.2 + 1 : ℝ) ≠ 0 by positivity]

/-- **Julia-to-Euler coefficient law.**  The Euler face of the Julia normal coordinate converges
coefficientwise to the canonical Euler logarithm of zeta. -/
theorem tendsto_gammaSewnMobiusJuliaEulerLogCoefficient_nhdsGT_zero
    (n : ℕ) :
    Tendsto
      (fun x : ℝ => gammaSewnMobiusJuliaEulerLogCoefficient x n)
      (nhdsWithin (0 : ℝ) (Ioi 0))
      (nhds (eulerLogDirichletCoeff n)) := by
  by_cases hpow : IsPrimePow n
  · let pe : Nat.Primes × ℕ := Nat.Primes.prodNatEquiv.symm ⟨n, hpow⟩
    have hn :
        xiGammaEulerValuationNat pe = n := by
      have hx := congrArg Subtype.val
        (Nat.Primes.prodNatEquiv.apply_symm_apply ⟨n, hpow⟩)
      change (pe.1 : ℕ) ^ (pe.2 + 1) = n
      rw [← Nat.Primes.coe_prodNatEquiv_apply]
      exact hx
    have hlim :=
      (tendsto_gammaSewnMobiusJuliaHardHalfWeightTransport_nhdsGT_zero
        (-1) pe).pow 2
    have hnlog : Real.log n ≠ 0 := by
      rw [← hn]
      have hnNat : 1 < xiGammaEulerValuationNat pe := by
        unfold xiGammaEulerValuationNat
        exact one_lt_pow₀ pe.1.property.one_lt (Nat.succ_ne_zero pe.2)
      exact ne_of_gt (Real.log_pos (by exact_mod_cast hnNat))
    have hdiv :
        Tendsto
          (fun x : ℝ =>
            gammaSewnMobiusJuliaHardHalfWeightTransport x (-1) pe ^ 2 /
              Real.log n)
          (nhdsWithin (0 : ℝ) (Ioi 0))
          (nhds
            (xiGammaEulerBoundaryRealAmplitude (-1) pe ^ 2 /
              Real.log n)) :=
      hlim.div_const (Real.log n)
    have hcast := Complex.continuous_ofReal.tendsto
      (xiGammaEulerBoundaryRealAmplitude (-1) pe ^ 2 / Real.log n) |>.comp hdiv
    have htarget :
        ((xiGammaEulerBoundaryRealAmplitude (-1) pe ^ 2 / Real.log n : ℝ) : ℂ) =
          eulerLogDirichletCoeff n := by
      rw [← hn,
        xiGammaEulerBoundaryRealAmplitude_neg_one_sq_div_log]
      change ((1 / (pe.2 + 1 : ℝ) : ℝ) : ℂ) =
        eulerLogDirichletCoeff ((pe.1 : ℕ) ^ (pe.2 + 1))
      rw [eulerLogDirichletCoeff_prime_pow_succ
        pe.1 pe.2 pe.1.property]
      norm_num
    rw [htarget] at hcast
    apply hcast.congr'
    filter_upwards with x
    simp only [gammaSewnMobiusJuliaEulerLogCoefficient, dif_pos hpow, pe,
      Function.comp_apply]
  · rw [eulerLogDirichletCoeff_eq_zero_of_not_primePower hpow]
    simp only [gammaSewnMobiusJuliaEulerLogCoefficient, hpow]
    exact tendsto_const_nhds

/-- Finite Dirichlet scalarization of the Julia-generated Euler face. -/
def gammaSewnMobiusJuliaEulerLogPartialSum
    (x : ℝ) (N : ℕ) (s : ℂ) : ℂ :=
  ∑ n ∈ Finset.range N,
    LSeries.term (gammaSewnMobiusJuliaEulerLogCoefficient x) s n

/-- At fixed cutoff, the Julia Euler face converges to the corresponding canonical Euler-log
Dirichlet polynomial. -/
theorem tendsto_gammaSewnMobiusJuliaEulerLogPartialSum_nhdsGT_zero
    (N : ℕ) (s : ℂ) :
    Tendsto
      (fun x : ℝ => gammaSewnMobiusJuliaEulerLogPartialSum x N s)
      (nhdsWithin (0 : ℝ) (Ioi 0))
      (nhds
        (∑ n ∈ Finset.range N, LSeries.term eulerLogDirichletCoeff s n)) := by
  unfold gammaSewnMobiusJuliaEulerLogPartialSum
  apply tendsto_finsetSum
  intro n _hn
  by_cases hn : n = 0
  · subst n
    simp [LSeries.term_zero]
  · simp only [LSeries.term_def, if_neg hn]
    exact
      (tendsto_gammaSewnMobiusJuliaEulerLogCoefficient_nhdsGT_zero n).div_const
        ((n : ℂ) ^ s)

/-- Removing the finite cutoff after taking the Julia boundary recovers the canonical Euler
logarithm on its half-plane of absolute convergence. -/
theorem tendsto_canonicalEulerLogPartialSum_atTop
    {s : ℂ} (hs : 1 < s.re) :
    Tendsto
      (fun N : ℕ =>
        ∑ n ∈ Finset.range N, LSeries.term eulerLogDirichletCoeff s n)
      atTop (nhds (canonicalEulerLogZeta s)) := by
  simpa [canonicalEulerLogZeta, LSeries] using
    (canonicalEulerLogZeta_summable hs).hasSum.tendsto_sum_nat

end

end RHTower
