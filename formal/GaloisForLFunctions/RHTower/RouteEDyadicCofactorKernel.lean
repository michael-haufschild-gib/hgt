import GaloisForLFunctions.RHTower.RouteECofactorCutoffStability

/-!
# Exact dyadic regrouping of the nonlinear completed source

Pairing odd numerator `a` with `2a` and splitting denominator cofactors by parity
leaves one exact signed odd-cofactor kernel and an explicit upper-half boundary.
At critical order, the kernel is positive at every positive scale and the entire
boundary below prime `q` is at most `1/q`. No far-cone approximation is used.
The remaining signed kernel sum is not bounded here; no RH conclusion follows.
-/

namespace RHTower
noncomputable section
open scoped BigOperators

private theorem sum_odd_double (f : ℕ → ℝ) (Q : ℕ)
    (hzero : ∀ d, ¬ Odd d → f (2 * d) = 0) :
    (∑ d ∈ Finset.Ioo 0 Q, f d) =
      (∑ d ∈ (Finset.Ioo 0 Q).filter Odd, f d) +
      ∑ d ∈ (Finset.Ioo 0 Q).filter Odd, if 2 * d < Q then f (2 * d) else 0 := by
  have heven : (∑ d ∈ (Finset.Ioo 0 Q).filter (fun d => ¬ Odd d), f d) =
      ∑ d ∈ (Finset.Ioo 0 Q).filter (fun d => 2 * d < Q), f (2 * d) := by
    refine Finset.sum_bij' (fun d _ => d / 2) (fun d _ => 2 * d) ?_ ?_ ?_ ?_ ?_
    · intro d hd
      simp only [Finset.mem_filter, Finset.mem_Ioo, Nat.odd_iff] at hd ⊢
      omega
    · intro d hd
      simp only [Finset.mem_filter, Finset.mem_Ioo, Nat.odd_iff] at hd ⊢
      omega
    · intro d hd
      simp only [Finset.mem_filter, Finset.mem_Ioo, Nat.odd_iff] at hd
      omega
    · intro d hd
      omega
    · intro d hd
      have heq : 2 * (d / 2) = d := by
        simp only [Finset.mem_filter, Finset.mem_Ioo, Nat.odd_iff] at hd
        omega
      rw [heq]
  rw [← Finset.sum_filter_add_sum_filter_not (Finset.Ioo 0 Q) Odd f, heven]
  congr 1
  simp only [Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro d hd
  by_cases ho : Odd d
  · simp [ho]
  · simp [ho, hzero d ho]

private theorem moebius_double_odd {n : ℕ} (hn : Odd n) :
    (ArithmeticFunction.moebius (2 * n) : ℝ) = -(ArithmeticFunction.moebius n : ℝ) := by
  rw [ArithmeticFunction.isMultiplicative_moebius.map_mul_of_coprime
    hn.coprime_two_left, ArithmeticFunction.moebius_apply_prime Nat.prime_two]
  simp

private theorem moebius_double_even {n : ℕ} (hn : ¬ Odd n) :
    ArithmeticFunction.moebius (2 * n) = 0 := by
  apply ArithmeticFunction.moebius_eq_zero_of_not_squarefree
  intro hs
  have hdiv : 2 * 2 ∣ 2 * n := by
    obtain ⟨k, hk⟩ := even_iff_exists_two_mul.mp (Nat.not_odd_iff_even.mp hn)
    rw [hk]
    exact ⟨k, by ring⟩
  exact (Nat.squarefree_iff_prime_squarefree.mp hs 2 Nat.prime_two) hdiv

/-- Exact kernel left after pairing both numerator and denominator parity. -/
def routeE_dyadicCofactorKernel (r a b : ℝ) : ℝ :=
  routeEFixedOrderDifference r (2 * a) b - routeEFixedOrderDifference r a b +
    routeEFixedOrderDifference r a (2 * b)

theorem routeE_dyadicCofactorKernel_one {a b : ℝ} (ha : 0 < a) (hb : 0 < b) :
    routeE_dyadicCofactorKernel 1 a b =
      a * (4 * a ^ 2 + 5 * b ^ 2) /
        (2 * (a + b) * (a + 2 * b) * (2 * a + b) * (4 * a + b)) := by
  unfold routeE_dyadicCofactorKernel routeEFixedOrderDifference
  simp only [Real.rpow_neg_one]
  have h1 : a + b ≠ 0 := by positivity
  have h2 : a + 2 * b ≠ 0 := by positivity
  have h3 : 2 * a + b ≠ 0 := by positivity
  have h4 : 4 * a + b ≠ 0 := by positivity
  have h5 : 2 * a + 2 * b ≠ 0 := by positivity
  field_simp
  ring


theorem routeE_dyadicCofactorKernel_one_pos {a b : ℝ} (ha : 0 < a) (hb : 0 < b) :
    0 < routeE_dyadicCofactorKernel 1 a b := by
  rw [routeE_dyadicCofactorKernel_one ha hb]
  positivity

private def dyadicCoeff (a : ℕ) (q : Nat.Primes) (d : ℕ) : ℝ :=
  if Nat.Coprime a d then
    (ArithmeticFunction.moebius a : ℝ) *
      (ArithmeticFunction.moebius ((q : ℕ) * d) : ℝ) else 0

/-- Signed odd-cofactor kernel sum, with the actual prime-divisible coefficients. -/
def routeE_oddCofactorKernelSum (r : ℝ) (a : ℕ) (q : Nat.Primes) (Q : ℕ) : ℝ :=
  ∑ d ∈ (Finset.Ioo 0 Q).filter Odd,
    dyadicCoeff a q d * routeE_dyadicCofactorKernel r (a : ℝ) ((q : ℝ) * (d : ℝ))

/-- The upper-half cofactor seam generated by the finite dyadic reindexing. -/
def routeE_oddCofactorBoundary (r : ℝ) (a : ℕ) (q : Nat.Primes) (Q : ℕ) : ℝ :=
  ∑ d ∈ (Finset.Ioo 0 Q).filter Odd,
    if Q ≤ 2 * d then dyadicCoeff a q d *
      routeEFixedOrderDifference r (a : ℝ) (2 * ((q : ℝ) * (d : ℝ))) else 0

/-- Exact finite regrouping: completing the odd cofactor range creates a boundary. -/
theorem routeE_integerPair_dyadicCofactor_exact
    (r : ℝ) {a : ℕ} (ha : Odd a) (q : Nat.Primes) (hq : Odd (q : ℕ)) (Q : ℕ) :
    routeE_integerNumeratorCutoffFibre r a q Q +
      routeE_integerNumeratorCutoffFibre r (2 * a) q Q =
        -routeE_oddCofactorKernelSum r a q Q + routeE_oddCofactorBoundary r a q Q := by
  let f : ℕ → ℝ := fun d => dyadicCoeff a q d *
    routeEFixedOrderDifference r (a : ℝ) ((q : ℝ) * (d : ℝ))
  have hdouble (d : ℕ) (hd : Odd d) :
      f (2 * d) = -dyadicCoeff a q d *
        routeEFixedOrderDifference r (a : ℝ) (2 * ((q : ℝ) * (d : ℝ))) := by
    have hmu : (ArithmeticFunction.moebius ((q : ℕ) * (2 * d)) : ℝ) =
        -(ArithmeticFunction.moebius ((q : ℕ) * d) : ℝ) := by
      rw [show (q : ℕ) * (2 * d) = 2 * ((q : ℕ) * d) by ring]
      exact moebius_double_odd (hq.mul hd)
    dsimp [f, dyadicCoeff]
    simp only [Nat.coprime_mul_iff_right, Nat.coprime_two_right, ha, true_and, hmu]
    push_cast
    ring_nf
    split_ifs <;> ring
  have hzero (d : ℕ) (hd : ¬ Odd d) : f (2 * d) = 0 := by
    have hmu : ArithmeticFunction.moebius ((q : ℕ) * (2 * d)) = 0 := by
      rw [show (q : ℕ) * (2 * d) = 2 * ((q : ℕ) * d) by ring]
      exact moebius_double_even (by simpa only [Nat.odd_mul, hq, true_and] using hd)
    simp [f, dyadicCoeff, hmu]
  have hfirst := sum_odd_double f Q hzero
  have hsecond : routeE_integerNumeratorCutoffFibre r (2 * a) q Q =
      ∑ d ∈ (Finset.Ioo 0 Q).filter Odd,
        -dyadicCoeff a q d *
          routeEFixedOrderDifference r (2 * (a : ℝ)) ((q : ℝ) * (d : ℝ)) := by
    unfold routeE_integerNumeratorCutoffFibre
    rw [Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro d hd
    simp only [Nat.coprime_mul_iff_left, Nat.coprime_two_left, moebius_double_odd ha]
    push_cast
    by_cases ho : Odd d
    · simp [ho, dyadicCoeff]
      split_ifs <;> ring
    · simp [ho]
  change (∑ d ∈ Finset.Ioo 0 Q, f d) + _ = _
  rw [hfirst, hsecond]
  unfold routeE_oddCofactorKernelSum routeE_oddCofactorBoundary
  rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib,
    ← Finset.sum_neg_distrib, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro d hd
  have ho := (Finset.mem_filter.mp hd).2
  rw [hdouble d ho]
  dsimp [f, routeE_dyadicCofactorKernel]
  by_cases hc : 2 * d < Q
  · rw [if_pos hc, if_neg (by omega)]
    ring
  · rw [if_neg hc, if_pos (by omega)]
    ring

private theorem dyadic_boundary_term_le
    {a d : ℕ} (q : Nat.Primes) (haq : a ≤ (q : ℕ)) (hqd : (q : ℕ) ≤ 2 * d) :
    |dyadicCoeff a q d *
      routeEFixedOrderDifference 1 (a : ℝ) (2 * ((q : ℝ) * (d : ℝ)))| ≤
        1 / (q : ℝ) ^ (3 : ℕ) := by
  have hq : (0 : ℝ) < q := by exact_mod_cast q.property.pos
  have ha : (0 : ℝ) ≤ a := Nat.cast_nonneg a
  have haqR : (a : ℝ) ≤ q := by exact_mod_cast haq
  have hqdR : (q : ℝ) ≤ 2 * (d : ℝ) := by exact_mod_cast hqd
  let b : ℝ := 2 * ((q : ℝ) * (d : ℝ))
  have hqb : (q : ℝ) ^ 2 ≤ b := by
    dsimp [b]
    nlinarith [mul_le_mul_of_nonneg_left hqdR hq.le]
  have hb : 0 < b := lt_of_lt_of_le (sq_pos_of_pos hq) hqb
  have hk0 : 0 ≤ routeEFixedOrderDifference 1 (a : ℝ) b := by
    unfold routeEFixedOrderDifference
    apply sub_nonneg.mpr
    exact Real.rpow_le_rpow_of_nonpos (by positivity) (by linarith) (by norm_num)
  have hk : routeEFixedOrderDifference 1 (a : ℝ) b ≤ (a : ℝ) / b ^ (2 : ℕ) := by
    have h := sub_nonneg.mp
      (routeEFixedOrderDifference_linearization (r := 1) le_rfl (by norm_num) ha hb).1
    convert h using 1
    norm_num [Real.rpow_neg hb.le, Real.rpow_ofNat, div_eq_mul_inv]
  have hbound : (a : ℝ) / b ^ (2 : ℕ) ≤ 1 / (q : ℝ) ^ (3 : ℕ) := by
    apply (div_le_div_iff₀ (sq_pos_of_pos hb) (pow_pos hq _)).mpr
    calc
      (a : ℝ) * (q : ℝ) ^ (3 : ℕ) ≤ (q : ℝ) * (q : ℝ) ^ (3 : ℕ) :=
        mul_le_mul_of_nonneg_right haqR (by positivity)
      _ = ((q : ℝ) ^ (2 : ℕ)) ^ (2 : ℕ) := by ring
      _ ≤ 1 * b ^ (2 : ℕ) := by nlinarith [mul_self_le_mul_self (sq_nonneg (q : ℝ)) hqb]
  have hc : |dyadicCoeff a q d| ≤ 1 := routeE_integer_coeff_bound a q d
  change |dyadicCoeff a q d * routeEFixedOrderDifference 1 (a : ℝ) b| ≤ _
  rw [abs_mul, abs_of_nonneg hk0]
  have hmul : |dyadicCoeff a q d| * routeEFixedOrderDifference 1 (a : ℝ) b ≤
      routeEFixedOrderDifference 1 (a : ℝ) b := by
    simpa using mul_le_mul_of_nonneg_right hc hk0
  exact hmul.trans (hk.trans hbound)

/-- Each upper-half seam is at most one inverse square of the denominator prime. -/
theorem routeE_oddCofactorBoundary_le {a : ℕ} (q : Nat.Primes) (haq : a ≤ (q : ℕ)) :
    |routeE_oddCofactorBoundary 1 a q (q : ℕ)| ≤ 1 / (q : ℝ) ^ (2 : ℕ) := by
  have hq : (0 : ℝ) < q := by exact_mod_cast q.property.pos
  unfold routeE_oddCofactorBoundary
  calc
    _ ≤ ∑ d ∈ (Finset.Ioo 0 (q : ℕ)).filter Odd,
        |if (q : ℕ) ≤ 2 * d then dyadicCoeff a q d *
          routeEFixedOrderDifference 1 (a : ℝ) (2 * ((q : ℝ) * (d : ℝ))) else 0| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _d ∈ (Finset.Ioo 0 (q : ℕ)).filter Odd, 1 / (q : ℝ) ^ (3 : ℕ) := by
      apply Finset.sum_le_sum
      intro d hd
      by_cases hqd : (q : ℕ) ≤ 2 * d
      · rw [if_pos hqd]
        exact dyadic_boundary_term_le q haq hqd
      · rw [if_neg hqd, abs_zero]
        positivity
    _ ≤ (q : ℝ) * (1 / (q : ℝ) ^ (3 : ℕ)) := by
      have hcard : (((Finset.Ioo 0 (q : ℕ)).filter Odd).card : ℝ) ≤ q := by
        exact_mod_cast (Finset.card_filter_le (Finset.Ioo 0 (q : ℕ)) Odd).trans (by simp)
      simp only [Finset.sum_const, nsmul_eq_mul]
      exact mul_le_mul_of_nonneg_right hcard (by positivity)
    _ = _ := by field_simp

/-- The literal complete odd-core block differs from its exact signed kernel sum
by at most `1/q`, including the comparable-numerator region. -/
theorem routeE_integerPairBlock_dyadicCofactor_error
    (A : ℕ) (q : Nat.Primes) (hqOdd : Odd (q : ℕ)) (hAq : A < (q : ℕ)) :
    |routeE_integerPairCutoffBlock 1 A q (q : ℕ) +
      ∑ a ∈ (Finset.Icc 1 A).filter Odd, routeE_oddCofactorKernelSum 1 a q (q : ℕ)| ≤
        1 / (q : ℝ) := by
  have hq : (0 : ℝ) < q := by exact_mod_cast q.property.pos
  have heq : routeE_integerPairCutoffBlock 1 A q (q : ℕ) +
      ∑ a ∈ (Finset.Icc 1 A).filter Odd, routeE_oddCofactorKernelSum 1 a q (q : ℕ) =
        ∑ a ∈ (Finset.Icc 1 A).filter Odd, routeE_oddCofactorBoundary 1 a q (q : ℕ) := by
    unfold routeE_integerPairCutoffBlock
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro a ha
    rw [routeE_integerPair_dyadicCofactor_exact 1 (Finset.mem_filter.mp ha).2 q hqOdd]
    ring
  rw [heq]
  calc
    _ ≤ ∑ a ∈ (Finset.Icc 1 A).filter Odd, |routeE_oddCofactorBoundary 1 a q (q : ℕ)| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _a ∈ (Finset.Icc 1 A).filter Odd, 1 / (q : ℝ) ^ (2 : ℕ) := by
      apply Finset.sum_le_sum
      intro a ha
      have haA := (Finset.mem_Icc.mp (Finset.mem_filter.mp ha).1).2
      exact routeE_oddCofactorBoundary_le q (haA.trans hAq.le)
    _ ≤ (q : ℝ) * (1 / (q : ℝ) ^ (2 : ℕ)) := by
      have hcard : (((Finset.Icc 1 A).filter Odd).card : ℝ) ≤ q := by
        exact_mod_cast (Finset.card_filter_le (Finset.Icc 1 A) Odd).trans (by simpa using hAq.le)
      simp only [Finset.sum_const, nsmul_eq_mul]
      exact mul_le_mul_of_nonneg_right hcard (by positivity)
    _ = _ := by field_simp

end
end RHTower
