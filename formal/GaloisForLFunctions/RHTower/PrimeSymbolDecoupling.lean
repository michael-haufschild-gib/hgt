import GaloisForLFunctions.RHTower.WeilIndexConservation

/-!
# Decoupled extremes of the prime symbol

The prime side of the Weil explicit formula has symbol

```text
P(ξ) = 2 Σ_{n≥2} Λ(n) n^{-1/2} cos(ξ log n) = 2 Σ_p log p · Σ_{k≥1} p^{-k/2} cos(k ξ log p),
```

a trigonometric sum whose frequency group is **freely** generated by `{log p}`: a relation
`Σ a_p log p = 0` with integer `a_p` says `∏ p^{a_p} = 1`, hence all `a_p = 0`.  By Kronecker's
theorem the flow `ξ ↦ (ξ log p)_p mod 2π` is therefore dense in the torus, so the extremes of `P`
**decouple completely across primes**: `sup_ξ P = Σ_p sup_θ f_p(θ)` and likewise for the infimum,
where `f_p` is the local factor at `p`.  This is the one place in the whole theory where
multiplicative independence of the primes — the property no Beurling counterexample shares — enters
as an exact statement rather than a heuristic.

The local factor sums in closed form.  With `x = p^{-1/2} ∈ (0,1)` and `c = cos θ`,

```text
Σ_{k≥1} x^k cos(kθ) = Re( x e^{iθ}/(1 - x e^{iθ}) ) = (x c - x²)/(1 - 2 x c + x²),
```

which is strictly increasing in `c` — its derivative in `c` is `x(1-x²)/(1-2xc+x²)² > 0` — so its
range over `c ∈ [-1,1]` is exactly

```text
[ -x/(1+x) ,  x/(1-x) ],
```

both endpoints attained, at `θ = π` and `θ = 0`.  Consequently the prime symbol satisfies the sharp
**attained** two-sided bound

```text
-2 Σ_p (log p)/(√p + 1)  ≤  P(ξ)  ≤  2 Σ_p (log p)/(√p - 1),
```

term by term, with equality approached along the Kronecker orbit.  The upper extreme sits at `ξ = 0`,
where the pole term of the explicit formula also concentrates; the lower extreme is genuinely off
`ξ = 0` and is smaller in modulus by the factor `(√p-1)/(√p+1)` at each prime — an asymmetry that is
invisible without decoupling.

This file formalizes the closed form of the local factor and the sharpness of both endpoints.
-/

open Real

noncomputable section

namespace RHTower

/-- Local factor of the prime symbol at a prime with `x = p^{-1/2}`, written in the variable
`c = cos θ`: the closed form of `Σ_{k≥1} x^k cos(kθ)`. -/
def primeLocalSymbol (x c : ℝ) : ℝ := (x * c - x ^ 2) / (1 - 2 * x * c + x ^ 2)

theorem primeLocalSymbol_denom_pos {x c : ℝ} (hx : 0 < x) (hx1 : x < 1) (hc : |c| ≤ 1) :
    0 < 1 - 2 * x * c + x ^ 2 := by
  have hc1 : c ≤ 1 := (abs_le.mp hc).2
  have hsq : 0 < (1 - x) ^ 2 := by nlinarith
  nlinarith [hsq, hx.le]

/-- At `θ = 0` the local factor attains `x/(1-x)`. -/
theorem primeLocalSymbol_one {x : ℝ} (hx : 0 < x) (hx1 : x < 1) :
    primeLocalSymbol x 1 = x / (1 - x) := by
  have h1 : (1 : ℝ) - x ≠ 0 := by linarith
  unfold primeLocalSymbol
  rw [show (1 : ℝ) - 2 * x * 1 + x ^ 2 = (1 - x) ^ 2 from by ring,
    show x * 1 - x ^ 2 = x * (1 - x) from by ring]
  field_simp

/-- At `θ = π` the local factor attains `-x/(1+x)`. -/
theorem primeLocalSymbol_neg_one {x : ℝ} (hx : 0 < x) (hx1 : x < 1) :
    primeLocalSymbol x (-1) = -(x / (1 + x)) := by
  have h1 : (1 : ℝ) + x ≠ 0 := by linarith
  unfold primeLocalSymbol
  rw [show (1 : ℝ) - 2 * x * (-1) + x ^ 2 = (1 + x) ^ 2 from by ring,
    show x * (-1) - x ^ 2 = -(x * (1 + x)) from by ring]
  field_simp

/-- **Monotonicity in `c = cos θ`.**  The local factor is strictly increasing, because its numerator
and denominator combine to a positive derivative `x(1-x²)/(1-2xc+x²)²`.  Cross-multiplied form. -/
theorem primeLocalSymbol_strictMono {x c d : ℝ} (hx : 0 < x) (hx1 : x < 1)
    (hc : |c| ≤ 1) (hd : |d| ≤ 1) (hcd : c < d) :
    primeLocalSymbol x c < primeLocalSymbol x d := by
  have hDc := primeLocalSymbol_denom_pos hx hx1 hc
  have hDd := primeLocalSymbol_denom_pos hx hx1 hd
  unfold primeLocalSymbol
  rw [div_lt_div_iff₀ hDc hDd]
  have hkey : 0 < x * (d - c) * (1 - x ^ 2) := by
    have h1 : 0 < x * (d - c) := mul_pos hx (sub_pos.mpr hcd)
    have h2 : (0 : ℝ) < 1 - x ^ 2 := by nlinarith
    exact mul_pos h1 h2
  nlinarith [hkey]

/-- **Sharp upper extreme.**  The local factor never exceeds its value at `θ = 0`. -/
theorem primeLocalSymbol_le {x c : ℝ} (hx : 0 < x) (hx1 : x < 1) (hc : |c| ≤ 1) :
    primeLocalSymbol x c ≤ x / (1 - x) := by
  rcases lt_or_eq_of_le (abs_le.mp hc).2 with h | h
  · exact le_of_lt ((primeLocalSymbol_strictMono hx hx1 hc (by simp) h).trans_eq
      (primeLocalSymbol_one hx hx1))
  · rw [h, primeLocalSymbol_one hx hx1]

/-- **Sharp lower extreme.**  The local factor is never below its value at `θ = π`. -/
theorem primeLocalSymbol_ge {x c : ℝ} (hx : 0 < x) (hx1 : x < 1) (hc : |c| ≤ 1) :
    -(x / (1 + x)) ≤ primeLocalSymbol x c := by
  rcases lt_or_eq_of_le (neg_le_of_abs_le hc) with h | h
  · exact le_of_lt ((primeLocalSymbol_neg_one hx hx1) ▸
      primeLocalSymbol_strictMono hx hx1 (by simp) hc h)
  · rw [← h, primeLocalSymbol_neg_one hx hx1]

/-- **The asymmetry.**  The lower extreme is strictly smaller in modulus than the upper one, by the
factor `(1-x)/(1+x)`; equivalently at a prime `p`, by `(√p-1)/(√p+1)`.  This asymmetry between the
two ends of the prime symbol is invisible without the decoupling. -/
theorem primeLocalSymbol_asymmetry {x : ℝ} (hx : 0 < x) (hx1 : x < 1) :
    x / (1 + x) < x / (1 - x) := by
  have h1 : (0 : ℝ) < 1 - x := by linarith
  have h2 : (0 : ℝ) < 1 + x := by linarith
  rw [div_lt_div_iff₀ h2 h1]
  nlinarith

/-- The full range of the local factor is exactly the closed interval between the two extremes,
both attained. -/
theorem primeLocalSymbol_range {x c : ℝ} (hx : 0 < x) (hx1 : x < 1) (hc : |c| ≤ 1) :
    primeLocalSymbol x c ∈ Set.Icc (-(x / (1 + x))) (x / (1 - x)) :=
  ⟨primeLocalSymbol_ge hx hx1 hc, primeLocalSymbol_le hx hx1 hc⟩

end RHTower
