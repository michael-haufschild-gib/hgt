import GaloisForLFunctions.HTGeometry.ProjectiveHorizonActualSchwarzianDiamond
import GaloisForLFunctions.RHTower.ZetaGammaPhaseIntensityObservability

/-!
# Exact projective-horizon diamond of the centered zeta Gamma clock

The centered Gamma reflection clock and its reciprocal-frequency observer have an exact
field-lattice phase transition over the natural differential coefficient field `ℂ(z)`.  At first
derivative depth they jointly reconstruct the full clock field and share exactly the differential
field generated by projective curvature.  Advancing either observer to depth two erases every
common nonconstant rational differential observable.
-/

open scoped Differential UnivMeroFieldInstances

namespace RHTower

open GaloisForLFunctions GaloisForLFunctions.HTGeometry
open Bottcher

noncomputable section

/-- **Exact centered zeta--Gamma projective-horizon diamond.**  The natural `ℂ(z)` coefficient
field is retained: no restriction to constants or auxiliary carrier is used. -/
theorem centeredZetaGamma_projectiveHorizon_schwarzianDiamond :
    jetTailField (RatFunc ℂ) centeredZetaGammaReflectionMero 1 ⊔
          jetTailField (RatFunc ℂ) centeredZetaGammaReflectedFrequencyMero 1 =
        jetTailField (RatFunc ℂ) centeredZetaGammaReflectionMero 0 ∧
      jetTailField (RatFunc ℂ) centeredZetaGammaReflectionMero 1 ⊓
          jetTailField (RatFunc ℂ) centeredZetaGammaReflectedFrequencyMero 1 =
        actualSchwarzianDifferentialField (RatFunc ℂ)
          centeredZetaGammaReflectionMero ∧
      ∀ {m n : ℕ}, 1 ≤ m → 1 ≤ n → (2 ≤ m ∨ 2 ≤ n) →
        jetTailField (RatFunc ℂ) centeredZetaGammaReflectionMero m ⊓
            jetTailField (RatFunc ℂ) centeredZetaGammaReflectedFrequencyMero n = ⊥ := by
  have hinv : centeredZetaGammaReflectionMero⁻¹ =
      centeredZetaGammaReflectedFrequencyMero := by
    rw [centeredZetaGammaReflectionMero_eq_inv_reflectedFrequency, inv_inv]
  simpa only [hinv] using
    hypertranscendentalOver_projectiveHorizon_schwarzianDiamond
      centeredZetaGammaReflectionMero
      hypertranscendentalOver_centeredZetaGammaReflectionMero

end

end RHTower
