import GaloisForLFunctions.RHTower.XiHorizontalSliceLogConcaveCone
import GaloisForLFunctions.RHTower.XiRealAxisNonvanishing

/-!
# Log-concavity of the Taylor coefficients of `ξ` at the centre

Write `ξ(½ + x) = Σ_k a_k x^{2k}`.  The coefficients `a_k` form a Turán sequence: they are
nonnegative and `a_{k−1}·a_{k+1} ≤ a_k²` (`xi_centre_turanSeq`), unconditionally.

The proof groups the Hadamard product `ξ(½ + x) = ξ(½) ∏ E₁(−ix/z_q)` (spectral points
`z_q = (ρ − ½)(−i)`) into orbits of the Klein group generated by the functional-equation reflection
`ρ ↦ 1 − ρ` (`z ↦ −z`) and complex conjugation `ρ ↦ ρ̄` (`z ↦ −z̄`).  A critical zero `z = γ` has the
orbit `{γ, −γ}` and contributes `1 + x²/γ²`; an off-line zero `z = a + ci` has a four-element orbit
contributing `(1 + x²/z²)(1 + x²/z̄²) = 1 + 2(a² − c²)x²/|z|⁴ + x⁴/|z|⁴`, a Turán factor exactly when
`a² ≥ 3c²`, i.e. `|Im ρ| ≥ √3 |Re ρ − ½|`.  Every off-line zero has `|Im ρ| ≥ 243/20` and
`|Re ρ − ½| < ½` (the unconditional critical-line band below squared ordinate `2365/16`), so every
factor is Turán, and Turán sequences are closed under the Cauchy product and pointwise limits.
-/

open Complex Filter Topology
open scoped ComplexOrder
open GaloisForLFunctions.HTGeometry

namespace RHTower

noncomputable section

/-! ## The Klein group of divisor symmetries -/

/-- Reflection and conjugation commute on divisor copies. -/
theorem xiZeroCopyReflectEquiv_conjEquiv_comm (q : XiZeroCopy) :
    xiZeroCopyReflectEquiv (xiZeroCopyConjEquiv q) =
      xiZeroCopyConjEquiv (xiZeroCopyReflectEquiv q) := by
  have hfst : (xiZeroCopyReflectEquiv (xiZeroCopyConjEquiv q)).1 =
      (xiZeroCopyConjEquiv (xiZeroCopyReflectEquiv q)).1 := by
    apply Subtype.ext
    simp [xiZeroCopyReflectEquiv, xiZeroReflectEquiv, xiZeroCopyConjEquiv, xiZeroConjEquiv,
      Equiv.sigmaCongr, Equiv.sigmaCongrRight, Equiv.sigmaCongrLeft]
  apply Sigma.ext hfst
  apply (Fin.heq_ext_iff (congrArg (fun rho : XiDivisorSupport =>
    Int.toNat ((MeromorphicOn.divisor xi Set.univ) (rho : ℂ))) hfst)).2
  simp [xiZeroCopyReflectEquiv, xiZeroReflectEquiv, xiZeroCopyConjEquiv, xiZeroConjEquiv,
    Equiv.sigmaCongr, Equiv.sigmaCongrRight, Equiv.sigmaCongrLeft]
  exact Fin.val_eq_val_of_heq ((cast_heq _ _).trans (cast_heq _ _).symm)

/-- On the critical line conjugation agrees with reflection. -/
theorem xiZeroCopyConjEquiv_eq_reflect_of_re {q : XiZeroCopy} (h : (q.1 : ℂ).re = 1 / 2) :
    xiZeroCopyConjEquiv q = xiZeroCopyReflectEquiv q := by
  have hpt : (starRingEnd ℂ) (q.1 : ℂ) = 1 - (q.1 : ℂ) := by
    apply Complex.ext <;> simp [h]; norm_num
  have hfst : (xiZeroCopyConjEquiv q).1 = (xiZeroCopyReflectEquiv q).1 := by
    apply Subtype.ext
    simpa [xiZeroCopyReflectEquiv, xiZeroReflectEquiv, xiZeroCopyConjEquiv, xiZeroConjEquiv,
      Equiv.sigmaCongr, Equiv.sigmaCongrRight, Equiv.sigmaCongrLeft] using hpt
  apply Sigma.ext hfst
  apply (Fin.heq_ext_iff (congrArg (fun rho : XiDivisorSupport =>
    Int.toNat ((MeromorphicOn.divisor xi Set.univ) (rho : ℂ))) hfst)).2
  simp [xiZeroCopyReflectEquiv, xiZeroReflectEquiv, xiZeroCopyConjEquiv, xiZeroConjEquiv,
    Equiv.sigmaCongr, Equiv.sigmaCongrRight, Equiv.sigmaCongrLeft]
  exact Fin.val_eq_val_of_heq ((cast_heq _ _).trans (cast_heq _ _).symm)

theorem xiZeroCopyConjEquiv_coe (q : XiZeroCopy) :
    ((xiZeroCopyConjEquiv q).1 : ℂ) = (starRingEnd ℂ) (q.1 : ℂ) := by
  simp [xiZeroCopyConjEquiv, xiZeroConjEquiv, Equiv.sigmaCongr, Equiv.sigmaCongrRight,
    Equiv.sigmaCongrLeft]

theorem xiZeroCopyReflectEquiv_coe (q : XiZeroCopy) :
    ((xiZeroCopyReflectEquiv q).1 : ℂ) = 1 - (q.1 : ℂ) := by
  simp [xiZeroCopyReflectEquiv, xiZeroReflectEquiv, Equiv.sigmaCongr, Equiv.sigmaCongrRight,
    Equiv.sigmaCongrLeft]

/-- Reflection has no fixed copy: `½` is not a zero. -/
theorem xiZeroCopyReflectEquiv_ne_self (q : XiZeroCopy) : xiZeroCopyReflectEquiv q ≠ q := by
  intro h
  have h1 := congrArg (fun r : XiZeroCopy => (r.1 : ℂ)) h
  simp only [xiZeroCopyReflectEquiv_coe] at h1
  apply xi_divisor_support_ne_half q.1
  linear_combination (-(1 : ℂ) / 2) * h1

/-- Conjugation moves every off-line copy off its reflection orbit. -/
theorem xiZeroCopyConjEquiv_ne_of_re_ne {q : XiZeroCopy} (h : (q.1 : ℂ).re ≠ 1 / 2) :
    xiZeroCopyConjEquiv q ≠ q ∧ xiZeroCopyConjEquiv q ≠ xiZeroCopyReflectEquiv q := by
  constructor
  · intro he
    have h1 := congrArg (fun r : XiZeroCopy => (r.1 : ℂ)) he
    simp only [xiZeroCopyConjEquiv_coe] at h1
    have him : (q.1 : ℂ).im = 0 := by
      have := congrArg Complex.im h1
      simp only [Complex.conj_im] at this
      linarith
    have hx : xi (q.1 : ℂ) = 0 := xi_eq_zero_of_mem_divisor_support q.1
    have hreal : (q.1 : ℂ) = ((q.1 : ℂ).re : ℂ) := by
      apply Complex.ext <;> simp [him]
    rw [hreal] at hx
    exact xi_ne_zero_of_real _ hx
  · intro he
    have h1 := congrArg (fun r : XiZeroCopy => (r.1 : ℂ)) he
    simp only [xiZeroCopyConjEquiv_coe, xiZeroCopyReflectEquiv_coe] at h1
    have hre := congrArg Complex.re h1
    simp only [Complex.conj_re, Complex.sub_re, Complex.one_re] at hre
    exact h (by linarith)

theorem xiSpectralPoint_conjEquiv (q : XiZeroCopy) :
    xiSpectralPoint (xiZeroCopyConjEquiv q) = -(starRingEnd ℂ) (xiSpectralPoint q) := by
  rw [xiSpectralPoint, xiSpectralPoint, xiZeroCopyConjEquiv_coe]
  simp only [map_mul, map_sub, map_neg, Complex.conj_I, map_div₀, map_one, map_ofNat]
  ring

/-! ## Grouping a finite product into Klein orbits -/

/-- The Turán property of a finite product grouped into orbits of two commuting involutions, the
first without fixed points. -/
theorem turanTaylorAtZero_prod_of_kleinOrbits {α : Type*} [DecidableEq α] (σ τ : α → α)
    (hσ : ∀ a, σ (σ a) = a) (hτ : ∀ a, τ (τ a) = a) (hστ : ∀ a, σ (τ a) = τ (σ a))
    (hσfix : ∀ a, σ a ≠ a) (f : α → ℂ → ℂ)
    (hsmall : ∀ a, (τ a = a ∨ τ a = σ a) → TuranTaylorAtZero (f a * f (σ a)))
    (hbig : ∀ a, τ a ≠ a → τ a ≠ σ a →
      TuranTaylorAtZero ((f a * f (σ a)) * (f (τ a) * f (σ (τ a))))) :
    ∀ S : Finset α, (∀ a ∈ S, σ a ∈ S) → (∀ a ∈ S, τ a ∈ S) →
      TuranTaylorAtZero (fun x => ∏ a ∈ S, f a x) := by
  intro S
  induction S using Finset.strongInduction with
  | H S ih =>
    intro hSσ hSτ
    rcases S.eq_empty_or_nonempty with hE | ⟨a, ha⟩
    · subst hE
      simpa using turanTaylorAtZero_const (zero_le_one : (0 : ℝ) ≤ 1)
    have hσa : σ a ∈ S := hSσ a ha
    have hσane : σ a ≠ a := hσfix a
    by_cases hsm : τ a = a ∨ τ a = σ a
    · -- two-element orbit
      set T := (S.erase a).erase (σ a) with hT
      have hσaT : σ a ∈ S.erase a := Finset.mem_erase.mpr ⟨hσane, hσa⟩
      have hTS : T ⊂ S := (Finset.erase_ssubset hσaT).trans_le (Finset.erase_subset a S)
      have hτσa : τ (σ a) = a ∨ τ (σ a) = σ a := by
        rcases hsm with h | h
        · right; rw [← hστ, h]
        · left; rw [← hστ, h, hσ]
      have hmemT : ∀ b, b ∈ T ↔ b ∈ S ∧ b ≠ a ∧ b ≠ σ a := by
        intro b
        rw [hT, Finset.mem_erase, Finset.mem_erase]
        tauto
      have hTσ : ∀ b ∈ T, σ b ∈ T := by
        intro b hb
        rw [hmemT] at hb ⊢
        refine ⟨hSσ b hb.1, fun h => hb.2.2 ?_, fun h => hb.2.1 ?_⟩
        · rw [← h, hσ]
        · rw [← hσ b, h, hσ]
      have hTτ : ∀ b ∈ T, τ b ∈ T := by
        intro b hb
        rw [hmemT] at hb ⊢
        refine ⟨hSτ b hb.1, fun h => ?_, fun h => ?_⟩
        · have : b = τ a := by rw [← h, hτ]
          rcases hsm with h' | h'
          · exact hb.2.1 (this.trans h')
          · exact hb.2.2 (this.trans h')
        · have : b = τ (σ a) := by rw [← h, hτ]
          rcases hτσa with h' | h'
          · exact hb.2.1 (this.trans h')
          · exact hb.2.2 (this.trans h')
      have e : (fun x => ∏ b ∈ S, f b x) = (f a * f (σ a)) * fun x => ∏ b ∈ T, f b x := by
        funext x
        rw [Pi.mul_apply, Pi.mul_apply, hT,
          ← Finset.mul_prod_erase S (fun b => f b x) ha,
          ← Finset.mul_prod_erase (S.erase a) (fun b => f b x) hσaT]
        ring
      rw [e]
      exact (hsmall a hsm).mul (ih T hTS hTσ hTτ)
    · -- four-element orbit
      push Not at hsm
      obtain ⟨hτa1, hτa2⟩ := hsm
      have hτaS : τ a ∈ S := hSτ a ha
      have hστaS : σ (τ a) ∈ S := hSσ _ hτaS
      have hστ1 : σ (τ a) ≠ a := fun h => hτa2 (by rw [← hσ (τ a), h])
      have hστ2 : σ (τ a) ≠ σ a := fun h => hτa1 (by rw [← hσ (τ a), h, hσ])
      have hστ3 : σ (τ a) ≠ τ a := hσfix (τ a)
      set T := (((S.erase a).erase (σ a)).erase (τ a)).erase (σ (τ a)) with hT
      have hmemT : ∀ b, b ∈ T ↔ b ∈ S ∧ b ≠ a ∧ b ≠ σ a ∧ b ≠ τ a ∧ b ≠ σ (τ a) := by
        intro b
        rw [hT, Finset.mem_erase, Finset.mem_erase, Finset.mem_erase, Finset.mem_erase]
        tauto
      have hTS : T ⊂ S := by
        refine Finset.ssubset_iff_subset_ne.mpr ⟨fun b hb => ((hmemT b).mp hb).1, fun h => ?_⟩
        have : a ∈ T := h ▸ ha
        exact ((hmemT a).mp this).2.1 rfl
      have hTσ : ∀ b ∈ T, σ b ∈ T := by
        intro b hb
        rw [hmemT] at hb ⊢
        obtain ⟨hbS, h1, h2, h3, h4⟩ := hb
        refine ⟨hSσ b hbS, fun h => h2 ?_, fun h => h1 ?_, fun h => h4 ?_, fun h => h3 ?_⟩
        · rw [← h, hσ]
        · rw [← hσ b, h, hσ]
        · rw [← h, hσ]
        · rw [← hσ b, h, hσ]
      have hTτ : ∀ b ∈ T, τ b ∈ T := by
        intro b hb
        rw [hmemT] at hb ⊢
        obtain ⟨hbS, h1, h2, h3, h4⟩ := hb
        refine ⟨hSτ b hbS, fun h => h3 ?_, fun h => h4 ?_, fun h => h1 ?_, fun h => h2 ?_⟩
        · rw [← h, hτ]
        · rw [hστ, ← h, hτ]
        · rw [← hτ b, h, hτ]
        · rw [← hτ b, h, ← hστ (τ a), hτ]
      have hσaS1 : σ a ∈ S.erase a := Finset.mem_erase.mpr ⟨hσane, hσa⟩
      have hτaS2 : τ a ∈ (S.erase a).erase (σ a) :=
        Finset.mem_erase.mpr ⟨hτa2, Finset.mem_erase.mpr ⟨hτa1, hτaS⟩⟩
      have hστaS3 : σ (τ a) ∈ ((S.erase a).erase (σ a)).erase (τ a) :=
        Finset.mem_erase.mpr ⟨hστ3, Finset.mem_erase.mpr ⟨hστ2,
          Finset.mem_erase.mpr ⟨hστ1, hστaS⟩⟩⟩
      have e : (fun x => ∏ b ∈ S, f b x) =
          ((f a * f (σ a)) * (f (τ a) * f (σ (τ a)))) * fun x => ∏ b ∈ T, f b x := by
        funext x
        rw [Pi.mul_apply, Pi.mul_apply, Pi.mul_apply, Pi.mul_apply, hT,
          ← Finset.mul_prod_erase S (fun b => f b x) ha,
          ← Finset.mul_prod_erase (S.erase a) (fun b => f b x) hσaS1,
          ← Finset.mul_prod_erase ((S.erase a).erase (σ a)) (fun b => f b x) hτaS2,
          ← Finset.mul_prod_erase (((S.erase a).erase (σ a)).erase (τ a)) (fun b => f b x)
            hστaS3]
        ring
      rw [e]
      exact (hbig a hτa1 hτa2).mul (ih T hTS hTσ hTτ)

/-! ## The factors of `ξ(½ + x)` -/

/-- The paired Weierstrass factor of `±z`: `E₁(−ix/z)·E₁(ix/z) = 1 + x²/z²`. -/
theorem weierstrassE1_centre_pair {z : ℂ} (hz : z ≠ 0) (x : ℂ) :
    weierstrassE1 (-(I * x) / z) * weierstrassE1 (-(I * x) / -z) = 1 + x ^ 2 / z ^ 2 := by
  unfold weierstrassE1
  have hexp : cexp (-(I * x) / z) * cexp (-(I * x) / -z) = 1 := by
    rw [← Complex.exp_add, show -(I * x) / z + -(I * x) / -z = 0 by field_simp; ring,
      Complex.exp_zero]
  calc (1 - -(I * x) / z) * cexp (-(I * x) / z) * ((1 - -(I * x) / -z) * cexp (-(I * x) / -z))
      = (1 - -(I * x) / z) * (1 - -(I * x) / -z) * (cexp (-(I * x) / z) * cexp (-(I * x) / -z)) := by
        ring
    _ = 1 + x ^ 2 / z ^ 2 := by
      rw [hexp, mul_one]
      field_simp
      linear_combination (-x ^ 2) * Complex.I_sq

/-- A critical zero contributes the Turán factor `1 + x²/γ²`. -/
theorem turanTaylorAtZero_centre_critical {γ : ℝ} (hγ : γ ≠ 0) :
    TuranTaylorAtZero (fun x => weierstrassE1 (-(I * x) / (γ : ℂ)) *
      weierstrassE1 (-(I * x) / -(γ : ℂ))) := by
  have hγc : (γ : ℂ) ≠ 0 := by exact_mod_cast hγ
  have e : (fun x => weierstrassE1 (-(I * x) / (γ : ℂ)) * weierstrassE1 (-(I * x) / -(γ : ℂ))) =
      fun x : ℂ => ((1 : ℝ) : ℂ) + ((1 / γ ^ 2 : ℝ) : ℂ) * x ^ 2 + ((0 : ℝ) : ℂ) * x ^ 4 := by
    funext x
    rw [weierstrassE1_centre_pair hγc x]
    push_cast
    field_simp
    ring
  rw [e]
  exact turanTaylorAtZero_evenQuartic zero_le_one (by positivity) le_rfl
    (by rw [mul_zero]; exact mul_self_nonneg _)

/-- An off-line zero `z = a + ci` with `3c² ≤ a²` contributes a Turán factor. -/
theorem turanTaylorAtZero_centre_offLine {a c : ℝ} (hz : (a : ℂ) + c * I ≠ 0)
    (hcone : 3 * c ^ 2 ≤ a ^ 2) :
    TuranTaylorAtZero (fun x => (1 + x ^ 2 / ((a : ℂ) + c * I) ^ 2) *
      (1 + x ^ 2 / (starRingEnd ℂ ((a : ℂ) + c * I)) ^ 2)) := by
  have hconj : starRingEnd ℂ ((a : ℂ) + c * I) = (a : ℂ) - c * I := by
    simp [map_add, map_mul, Complex.conj_ofReal, Complex.conj_I]
    ring
  have hnorm : a ^ 2 + c ^ 2 ≠ 0 := by
    intro h0
    apply hz
    have ha : a = 0 := by nlinarith [sq_nonneg a, sq_nonneg c]
    have hc : c = 0 := by nlinarith [sq_nonneg a, sq_nonneg c]
    simp [ha, hc]
  have hz' : (a : ℂ) - c * I ≠ 0 := by rw [← hconj]; exact (map_ne_zero _).mpr hz
  have hprod : ((a : ℂ) + c * I) * ((a : ℂ) - c * I) = (a : ℂ) ^ 2 + (c : ℂ) ^ 2 := by
    linear_combination (-(c : ℂ) ^ 2) * Complex.I_sq
  have hnormc : (a : ℂ) ^ 2 + (c : ℂ) ^ 2 ≠ 0 := by exact_mod_cast hnorm
  have hsum : ((a : ℂ) + c * I) ^ 2 + ((a : ℂ) - c * I) ^ 2 = 2 * ((a : ℂ) ^ 2 - (c : ℂ) ^ 2) := by
    linear_combination (2 * (c : ℂ) ^ 2) * Complex.I_sq
  have hprod2 : ((a : ℂ) + c * I) ^ 2 * ((a : ℂ) - c * I) ^ 2 = ((a : ℂ) ^ 2 + (c : ℂ) ^ 2) ^ 2 := by
    rw [← mul_pow, hprod]
  have hs : ((a : ℂ) + c * I) ^ 2 ≠ 0 := pow_ne_zero 2 hz
  have hd : ((a : ℂ) - c * I) ^ 2 ≠ 0 := pow_ne_zero 2 hz'
  have e : (fun x : ℂ => (1 + x ^ 2 / ((a : ℂ) + c * I) ^ 2) *
      (1 + x ^ 2 / (starRingEnd ℂ ((a : ℂ) + c * I)) ^ 2)) =
      fun x : ℂ => ((1 : ℝ) : ℂ) + ((2 * (a ^ 2 - c ^ 2) / (a ^ 2 + c ^ 2) ^ 2 : ℝ) : ℂ) * x ^ 2 +
        ((1 / (a ^ 2 + c ^ 2) ^ 2 : ℝ) : ℂ) * x ^ 4 := by
    funext x
    rw [hconj]
    calc (1 + x ^ 2 / ((a : ℂ) + c * I) ^ 2) * (1 + x ^ 2 / ((a : ℂ) - c * I) ^ 2)
        = 1 + x ^ 2 * ((((a : ℂ) + c * I) ^ 2 + ((a : ℂ) - c * I) ^ 2) /
            (((a : ℂ) + c * I) ^ 2 * ((a : ℂ) - c * I) ^ 2)) +
            x ^ 4 / (((a : ℂ) + c * I) ^ 2 * ((a : ℂ) - c * I) ^ 2) := by
          field_simp
          ring
      _ = 1 + x ^ 2 * (2 * ((a : ℂ) ^ 2 - (c : ℂ) ^ 2) / ((a : ℂ) ^ 2 + (c : ℂ) ^ 2) ^ 2) +
            x ^ 4 / ((a : ℂ) ^ 2 + (c : ℂ) ^ 2) ^ 2 := by
          rw [hsum, hprod2]
      _ = _ := by
          push_cast
          ring
  rw [e]
  have hpos : 0 < (a ^ 2 + c ^ 2) ^ 2 := by positivity
  refine turanTaylorAtZero_evenQuartic zero_le_one ?_ (by positivity) ?_
  · apply div_nonneg _ hpos.le
    nlinarith [sq_nonneg c]
  · have key : (a ^ 2 + c ^ 2) ^ 2 ≤ (2 * (a ^ 2 - c ^ 2)) ^ 2 := by
      have h1 : 0 ≤ a ^ 2 + c ^ 2 := by positivity
      have h2 : a ^ 2 + c ^ 2 ≤ 2 * (a ^ 2 - c ^ 2) := by linarith
      exact pow_le_pow_left₀ h1 h2 2
    rw [one_mul, div_mul_div_comm, div_le_div_iff₀ hpos (by positivity)]
    nlinarith [key, hpos]

/-! ## The value at the centre -/

theorem im_xi_ofReal (σ : ℝ) : (xi (σ : ℂ)).im = 0 := by
  have h := xi_conj (σ : ℂ)
  rw [Complex.conj_ofReal] at h
  have := congrArg Complex.im h
  rw [Complex.conj_im] at this
  linarith

/-- `ξ(½) > 0`: `ξ` is real and zero-free on `ℝ` and `ξ(1) = ½`. -/
theorem re_xi_half_pos : 0 < (xi ((1 / 2 : ℝ) : ℂ)).re := by
  set g : ℝ → ℝ := fun σ => (xi (σ : ℂ)).re with hg
  have hgc : Continuous g := Complex.continuous_re.comp
    (xi_differentiable.continuous.comp Complex.continuous_ofReal)
  have hg1 : g 1 = 1 / 2 := by
    simp only [hg, Complex.ofReal_one, xi_one]
    norm_num
  have hne : ∀ σ : ℝ, g σ ≠ 0 := by
    intro σ h0
    apply xi_ne_zero_of_real σ
    apply Complex.ext
    · simpa [hg] using h0
    · simpa using im_xi_ofReal σ
  by_contra hle
  push Not at hle
  have hivt := intermediate_value_Icc (by norm_num : (1 / 2 : ℝ) ≤ 1) hgc.continuousOn
  obtain ⟨σ, -, hσ⟩ := hivt ⟨hle, by rw [hg1]; norm_num⟩
  exact hne σ hσ

theorem XiC_zero_eq_ofReal : XiC 0 = (((xi ((1 / 2 : ℝ) : ℂ)).re : ℝ) : ℂ) := by
  have hc : XiC 0 = xi ((1 / 2 : ℝ) : ℂ) := by
    simp [XiC]
  rw [hc]
  apply Complex.ext
  · simp
  · simpa using im_xi_ofReal (1 / 2)

/-! ## Assembly -/

/-- **Turán property of `ξ(½ + x)` under the `√3`-cone condition at the centre.** -/
theorem turanTaylorAtZero_XiC_neg_I_mul_of_cone
    (hcone : ∀ q : XiZeroCopy, 3 * ((q.1 : ℂ).re - 1 / 2) ^ 2 ≤ ((q.1 : ℂ).im) ^ 2) :
    TuranTaylorAtZero (fun x => XiC (-(I * x))) := by
  classical
  set φ : ℂ → ℂ := fun x => -(I * x) with hφ
  have hcφ : Continuous φ := by rw [hφ]; fun_prop
  have hP : TendstoLocallyUniformlyOn
      (fun S x => ∏ q ∈ S, weierstrassE1 (x / xiSpectralPoint q)) xiCanonicalProduct atTop
      Set.univ := xiCanonicalProduct_hasProdLocallyUniformlyOn
  have hPdiff : Differentiable ℂ xiCanonicalProduct := fun z =>
    (xiCanonicalProduct_analytic z (Set.mem_univ z)).differentiableAt
  have hm := TendstoLocallyUniformlyOn.comp hP φ (Set.mapsTo_univ φ Set.univ) hcφ.continuousOn
  set σ := xiZeroCopyReflectEquiv with hσdef
  set τ := xiZeroCopyConjEquiv with hτdef
  have hσσ : ∀ q, σ (σ q) = q := xiZeroCopyReflectEquiv_apply_apply
  have hττ : ∀ q, τ (τ q) = q := xiZeroCopyConjEquiv_apply_apply
  have hστ : ∀ q, σ (τ q) = τ (σ q) := xiZeroCopyReflectEquiv_conjEquiv_comm
  let c : Finset XiZeroCopy → Finset XiZeroCopy := fun S =>
    S ∪ S.image σ ∪ S.image τ ∪ S.image (fun q => σ (τ q))
  have hc : Tendsto c atTop atTop :=
    tendsto_atTop_mono (fun S => by
      intro q hq
      simp only [c, Finset.mem_union]
      exact Or.inl (Or.inl (Or.inl hq))) tendsto_id
  have hclσ : ∀ S, ∀ a ∈ c S, σ a ∈ c S := by
    intro S a ha
    simp only [c, Finset.mem_union, Finset.mem_image] at ha ⊢
    rcases ha with ((ha | ⟨b, hb, rfl⟩) | ⟨b, hb, rfl⟩) | ⟨b, hb, rfl⟩
    · exact Or.inl (Or.inl (Or.inr ⟨a, ha, rfl⟩))
    · exact Or.inl (Or.inl (Or.inl (by rw [hσσ]; exact hb)))
    · exact Or.inr ⟨b, hb, rfl⟩
    · exact Or.inl (Or.inr ⟨b, hb, by rw [hσσ]⟩)
  have hclτ : ∀ S, ∀ a ∈ c S, τ a ∈ c S := by
    intro S a ha
    simp only [c, Finset.mem_union, Finset.mem_image] at ha ⊢
    rcases ha with ((ha | ⟨b, hb, rfl⟩) | ⟨b, hb, rfl⟩) | ⟨b, hb, rfl⟩
    · exact Or.inl (Or.inr ⟨a, ha, rfl⟩)
    · exact Or.inr ⟨b, hb, by rw [hστ]⟩
    · exact Or.inl (Or.inl (Or.inl (by rw [hττ]; exact hb)))
    · exact Or.inl (Or.inl (Or.inr ⟨b, hb, by rw [← hστ, hττ]⟩))
  have hm' := tendstoLocallyUniformlyOn_comp_index hm hc
  set f : XiZeroCopy → ℂ → ℂ := fun q x => weierstrassE1 (φ x / xiSpectralPoint q) with hf
  have hsmall : ∀ q, (τ q = q ∨ τ q = σ q) → TuranTaylorAtZero (f q * f (σ q)) := by
    intro q hq
    have hre : (q.1 : ℂ).re = 1 / 2 := by
      by_contra hne
      obtain ⟨h1, h2⟩ := xiZeroCopyConjEquiv_ne_of_re_ne hne
      rcases hq with h | h
      · exact h1 h
      · exact h2 h
    have hz : xiSpectralPoint q = (((q.1 : ℂ).im : ℝ) : ℂ) := by
      rw [xiSpectralPoint_eq_re_im, hre]
      simp
    have hγ : (q.1 : ℂ).im ≠ 0 := by
      intro h0
      apply xiSpectralPoint_ne_zero q
      rw [hz, h0, Complex.ofReal_zero]
    have e : f q * f (σ q) = fun x => weierstrassE1 (-(I * x) / (((q.1 : ℂ).im : ℝ) : ℂ)) *
        weierstrassE1 (-(I * x) / -(((q.1 : ℂ).im : ℝ) : ℂ)) := by
      funext x
      simp only [Pi.mul_apply, hf, hφ, hσdef, xiSpectralPoint_reflect, hz]
    rw [e]
    exact turanTaylorAtZero_centre_critical hγ
  have hbig : ∀ q, τ q ≠ q → τ q ≠ σ q →
      TuranTaylorAtZero ((f q * f (σ q)) * (f (τ q) * f (σ (τ q)))) := by
    intro q _ _
    set a : ℝ := (q.1 : ℂ).im with ha
    set cc : ℝ := 1 / 2 - (q.1 : ℂ).re with hcc
    have hz : xiSpectralPoint q = (a : ℂ) + cc * I := xiSpectralPoint_eq_re_im q
    have hz0 : (a : ℂ) + cc * I ≠ 0 := by rw [← hz]; exact xiSpectralPoint_ne_zero q
    have hzτ : xiSpectralPoint (τ q) = -(starRingEnd ℂ ((a : ℂ) + cc * I)) := by
      rw [hτdef, xiSpectralPoint_conjEquiv, hz]
    have hzτ0 : -(starRingEnd ℂ ((a : ℂ) + cc * I)) ≠ 0 := by
      rw [← hzτ]; exact xiSpectralPoint_ne_zero _
    have e : (f q * f (σ q)) * (f (τ q) * f (σ (τ q))) = fun x =>
        (1 + x ^ 2 / ((a : ℂ) + cc * I) ^ 2) *
          (1 + x ^ 2 / (starRingEnd ℂ ((a : ℂ) + cc * I)) ^ 2) := by
      funext x
      simp only [Pi.mul_apply, hf, hφ, hσdef, xiSpectralPoint_reflect]
      rw [hz, hzτ, weierstrassE1_centre_pair hz0 x, weierstrassE1_centre_pair hzτ0 x, neg_sq]
    rw [e]
    have hcone' : 3 * cc ^ 2 ≤ a ^ 2 := by
      have h := hcone q
      have hc2 : cc ^ 2 = ((q.1 : ℂ).re - 1 / 2) ^ 2 := by rw [hcc]; ring
      rw [hc2, ha]
      exact h
    exact turanTaylorAtZero_centre_offLine hz0 hcone'
  have hfin : ∀ S : Finset XiZeroCopy, TuranTaylorAtZero
      ((fun S x => ∏ q ∈ S, weierstrassE1 (x / xiSpectralPoint q)) (c S) ∘ φ) := by
    intro S
    have e : ((fun S x => ∏ q ∈ S, weierstrassE1 (x / xiSpectralPoint q)) (c S) ∘ φ) =
        fun x => ∏ q ∈ c S, f q x := by
      funext x
      simp only [Function.comp_apply, hf]
    rw [e]
    exact turanTaylorAtZero_prod_of_kleinOrbits σ τ hσσ hττ hστ xiZeroCopyReflectEquiv_ne_self f
      hsmall hbig (c S) (hclσ S) (hclτ S)
  have hlim : TuranTaylorAtZero (xiCanonicalProduct ∘ φ) :=
    TuranTaylorAtZero.of_tendstoLocallyUniformlyOn hfin
      (hPdiff.comp (by rw [hφ]; fun_prop)) hm'
  have e : (fun x => XiC (-(I * x))) =
      (fun _ => (((xi ((1 / 2 : ℝ) : ℂ)).re : ℝ) : ℂ)) * (xiCanonicalProduct ∘ φ) := by
    funext x
    have hX := congrFun XiC_eq_constant_mul_canonicalProduct (-(I * x))
    simp only [Pi.mul_apply] at hX
    rw [hX, XiC_zero_eq_ofReal]
    rfl
  rw [e]
  exact (turanTaylorAtZero_const re_xi_half_pos.le).mul hlim

/-- Every zero copy lies outside the `√3`-cone at the centre: off-line zeros have
`Im² ≥ 2365/16 > 3/4 > 3 (Re − ½)²`. -/
theorem sqrt3Cone_centre (q : XiZeroCopy) :
    3 * ((q.1 : ℂ).re - 1 / 2) ^ 2 ≤ ((q.1 : ℂ).im) ^ 2 := by
  by_cases hh : (q.1 : ℂ).im ^ 2 < 2365 / 16
  · rw [xiZeroCopy_re_eq_half_of_im_sq_lt_2365_over_16 q hh, sub_self]
    simp only [ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow, mul_zero]
    exact sq_nonneg _
  · push Not at hh
    have hstrip := xiZeroCopy_re_mem_open_unit q
    have h1 : ((q.1 : ℂ).re - 1 / 2) ^ 2 < 1 / 4 := by
      nlinarith [hstrip.1, hstrip.2]
    nlinarith

/-- **The Taylor coefficients of `ξ` at the centre form a Turán sequence, unconditionally.**  With
`ξ(½ + x) = Σ_k a_k x^{2k}`, the coefficients `a_k` are nonnegative and `a_i·a_{j+1} ≤ a_{i+1}·a_j`
for `i < j`; in particular `a_{k−1}·a_{k+1} ≤ a_k²`. -/
theorem xi_centre_turanSeq : TuranSeq (evenTaylorRe (fun x => xi (1 / 2 + x))) := by
  have e : (fun x => xi (1 / 2 + x)) = fun x => XiC (-(I * x)) := by
    funext x
    simp only [XiC]
    congr 1
    ring_nf
    rw [Complex.I_sq]
    ring
  rw [e]
  exact (turanTaylorAtZero_XiC_neg_I_mul_of_cone sqrt3Cone_centre).2.2

/-- **Log-concavity of the Taylor coefficients of `ξ` at the centre.** -/
theorem xi_centre_logConcave (k : ℕ) :
    evenTaylorRe (fun x => xi (1 / 2 + x)) k * evenTaylorRe (fun x => xi (1 / 2 + x)) (k + 2) ≤
      evenTaylorRe (fun x => xi (1 / 2 + x)) (k + 1) ^ 2 := by
  have h := xi_centre_turanSeq.2 k (k + 1) (Nat.lt_succ_self k)
  rw [sq]
  simpa only [show k + 1 + 1 = k + 2 by ring] using h

end

