import GaloisForLFunctions.RHTower.RelativeShellProvenanceScalarHomogeneityWall

/-!
# Private-shell hypertranscendence and finite coefficient-rank wall

Exact deletion kernels suggest trying to detect each private shell by one
complex-linear coefficient.  Differential independence rules this out more
strongly than scalar-homogeneity alone.

For every private label `m`, the generator `H_m` is transcendental over the
differential field generated by zeta and every private shell other than `m`.
Consequently `H_m² - c H_m` stays outside that deletion field for every
complex scalar `c`.

If one complex-linear functional vanished exactly on observables without
label `m`, choose `c = L(H_m²) / L(H_m)`.  Then
`L(H_m² - c H_m) = 0`, while transcendence says the same vector still has
label `m`.

More generally, every complex-linear map with that exact kernel sends the
positive power orbit `H_m, H_m², ...` to a linearly independent family.
Consequently no finite-dimensional complex coefficient target can realize
the exact deletion kernel.  Exact label incidence requires infinite
coefficient rank.

The result is unconditional and uses the actual complete-shell differential
independence theorem.  It does not manufacture a target coefficient complex.
-/

open Set
open scoped Classical
open scoped Differential UpperEndDifferentialInstances
  UpperEndComplexTowerInstances

namespace RHTower

open GaloisForLFunctions
open GaloisForLFunctions.HTGeometry

noncomputable section

/--
Private shell `H_m` is transcendental over zeta and all private shells except
`m`.  This is the order-zero consequence of full differential independence.
-/
theorem relativeShellMultiplier_transcendental_over_complement
    (m : RelativeShellLabel) :
    Transcendental
      (relativeShellSubsetDifferentialField
        (relativeShellLabelComplement m))
      (relativeShellMultiplierUpperEndCarrier m.1) := by
  let f : Unit ⊕ RelativeShellLabel → upperEndMeroField :=
    Sum.elim
      (fun _ : Unit => zetaUpperEndMero)
      (fun n : RelativeShellLabel =>
        relativeShellMultiplierUpperEndCarrier n.1)
  let j :
      (Unit ⊕ RelativeShellLabel) × ℕ →
        upperEndMeroField :=
    fun p => differentialJet p.2 (f p.1)
  let S : Set ((Unit ⊕ RelativeShellLabel) × ℕ) :=
    {p | p.1 ≠ Sum.inr m}
  let g :
      Unit ⊕ (relativeShellLabelComplement m) →
        upperEndMeroField :=
    Sum.elim
      (fun _ : Unit => zetaUpperEndMero)
      (fun n : relativeShellLabelComplement m =>
        relativeShellMultiplierUpperEndCarrier n.1.1)
  have hj :
      AlgebraicIndependent upperEndRationalCoordinateField j := by
    exact
      zetaRelativeShellMultiplierUpperEnd_differentialIndependent
  have htarget :
      ((Sum.inr m, 0) :
        (Unit ⊕ RelativeShellLabel) × ℕ) ∉ S := by
    simp [S]
  have htr :
      Transcendental
        (Algebra.adjoin upperEndRationalCoordinateField
          (j '' S))
        (j (Sum.inr m, 0)) :=
    hj.transcendental_adjoin htarget
  have hset :
      differentialJetSet (Set.range g) = j '' S := by
    ext z
    constructor
    · rintro ⟨w, ⟨u | n, rfl⟩, k, rfl⟩
      · refine ⟨(Sum.inl u, k), ?_, rfl⟩
        simp [S]
      · refine ⟨(Sum.inr n.1, k), ?_, rfl⟩
        change Sum.inr n.1 ≠ Sum.inr m
        intro h
        have hnm : n.1 = m := Sum.inr.inj h
        have hnprop : n.1 ≠ m := by
          exact n.2
        exact hnprop hnm
    · rintro ⟨⟨i, k⟩, hi, rfl⟩
      rcases i with u | n
      · refine ⟨zetaUpperEndMero, ?_, k, rfl⟩
        exact ⟨Sum.inl u, rfl⟩
      · have hnm : n ≠ m := by
          simpa [S] using hi
        refine
          ⟨relativeShellMultiplierUpperEndCarrier n.1,
            ?_, k, rfl⟩
        exact
          ⟨Sum.inr
            (⟨n, by exact hnm⟩ :
              relativeShellLabelComplement m),
            rfl⟩
  change
    Transcendental
      (differentialAdjoin upperEndRationalCoordinateField
        (Set.range g))
      (relativeShellMultiplierUpperEndCarrier m.1)
  rw [differentialAdjoin]
  apply (IntermediateField.transcendental_adjoin_iff).2
  rw [hset]
  simpa [j, f] using htr

/--
No complex linear correction of `H_m²` by `H_m` enters the field generated by
all other shells.
-/
theorem relativeShellMultiplier_quadraticDefect_not_mem_complement
    (m : RelativeShellLabel) (c : ℂ) :
    (((relativeShellMultiplierObservable m) ^ (2 : ℕ) -
          c • relativeShellMultiplierObservable m :
        RelativeShellFullObservable) :
      upperEndMeroField) ∉
        relativeShellSubsetDifferentialField
          (relativeShellLabelComplement m) := by
  intro hyMem
  let B :=
    relativeShellSubsetDifferentialField
      (relativeShellLabelComplement m)
  let y : RelativeShellFullObservable :=
    (relativeShellMultiplierObservable m) ^ (2 : ℕ) -
      c • relativeShellMultiplierObservable m
  have hyMem' :
      (y : upperEndMeroField) ∈ B := hyMem
  let yB : B := ⟨(y : upperEndMeroField), hyMem'⟩
  let cB : B := algebraMap ℂ B c
  have hcB :
      (cB : upperEndMeroField) =
        algebraMap ℂ upperEndMeroField c := by
    change
      algebraMap upperEndRationalCoordinateField
          upperEndMeroField
          (algebraMap ℂ upperEndRationalCoordinateField c) =
        algebraMap ℂ upperEndMeroField c
    exact
      (IsScalarTower.algebraMap_apply ℂ
        upperEndRationalCoordinateField
        upperEndMeroField c).symm
  have hcFull :
      ((algebraMap ℂ RelativeShellFullObservable c :
          RelativeShellFullObservable) :
        upperEndMeroField) =
      algebraMap ℂ upperEndMeroField c := by
    change
      algebraMap upperEndRationalCoordinateField
          upperEndMeroField
          (algebraMap ℂ upperEndRationalCoordinateField c) =
        algebraMap ℂ upperEndMeroField c
    exact
      (IsScalarTower.algebraMap_apply ℂ
        upperEndRationalCoordinateField
        upperEndMeroField c).symm
  let P : Polynomial B :=
    Polynomial.X ^ (2 : ℕ) -
      Polynomial.C cB * Polynomial.X -
        Polynomial.C yB
  have hPne : P ≠ 0 := by
    intro hzero
    have hcoeff :=
      congrArg (fun Q : Polynomial B => Q.coeff 2) hzero
    simp [P] at hcoeff
  have heval :
      Polynomial.aeval
        (relativeShellMultiplierUpperEndCarrier m.1)
        P = 0 := by
    have hx :
        ((relativeShellMultiplierObservable m :
            RelativeShellFullObservable) :
          upperEndMeroField) =
        relativeShellMultiplierUpperEndCarrier m.1 := rfl
    simp [P, yB, y, pow_two, Algebra.smul_def]
    rw [hcB, hcFull]
    rw [hx]
    ring
  exact
    (relativeShellMultiplier_transcendental_over_complement m)
      ⟨P, hPne, heval⟩

/--
No single complex-linear coefficient has kernel exactly equal to absence of
private label `m`.
-/
theorem no_complexLinearFunctional_exact_relativeShellLabelKernel
    (m : RelativeShellLabel) :
    ¬ ∃ L :
        RelativeShellFullObservable →ₗ[ℂ] ℂ,
      ∀ x,
        L x = 0 ↔
          relativeShellLabelCoordinateSize m x = 0 := by
  rintro ⟨L, hkernel⟩
  let x : RelativeShellFullObservable :=
    relativeShellMultiplierObservable m
  have hxCoordinate :
      relativeShellLabelCoordinateSize m x = 1 := by
    simp [x, relativeShellLabelCoordinateSize_multiplier]
  have hLx : L x ≠ 0 := by
    intro hzero
    have hcoord := (hkernel x).1 hzero
    rw [hxCoordinate] at hcoord
    norm_num at hcoord
  let c : ℂ := L (x * x) / L x
  let y : RelativeShellFullObservable :=
    x * x - c • x
  have hLy : L y = 0 := by
    change L (x * x - c • x) = 0
    rw [map_sub, LinearMap.map_smul]
    change L (x * x) - c * L x = 0
    dsimp [c]
    field_simp
    ring
  have hyCoordinate :
      relativeShellLabelCoordinateSize m y = 0 :=
    (hkernel y).1 hLy
  have hyMem :
      (y : upperEndMeroField) ∈
        relativeShellSubsetDifferentialField
          (relativeShellLabelComplement m) :=
    (relativeShellLabelCoordinateSize_kernel m y).1
      hyCoordinate
  apply
    relativeShellMultiplier_quadraticDefect_not_mem_complement
      m c
  simpa [y, x, pow_two] using hyMem

/--
Any complex-linear coefficient map whose kernel exactly detects absence of
label `m` has an infinite linearly independent power image
`L(H_m), L(H_m²), ...`.

The proof converts a hypothetical finite linear relation into a polynomial
over the deletion field.  Exact-kernel detection places the relation in that
field, while private-shell transcendence forces every coefficient to vanish.
-/
theorem relativeShellLabel_exactKernel_powerImages_linearIndependent
    (m : RelativeShellLabel)
    {V : Type*} [AddCommGroup V] [Module ℂ V]
    (L : RelativeShellFullObservable →ₗ[ℂ] V)
    (hkernel :
      ∀ x,
        L x = 0 ↔
          relativeShellLabelCoordinateSize m x = 0) :
    LinearIndependent ℂ
      (fun n : ℕ =>
        L ((relativeShellMultiplierObservable m) ^ (n + 1))) := by
  let x : RelativeShellFullObservable :=
    relativeShellMultiplierObservable m
  let B :=
    relativeShellSubsetDifferentialField
      (relativeShellLabelComplement m)
  have htr :
      Transcendental B
        (relativeShellMultiplierUpperEndCarrier m.1) :=
    relativeShellMultiplier_transcendental_over_complement m
  rw [linearIndependent_iff]
  intro l hl
  let z : RelativeShellFullObservable :=
    l.sum (fun n a => a • x ^ (n + 1))
  have hLz : L z = 0 := by
    have hmap :
        L z =
          l.sum (fun n a => a • L (x ^ (n + 1))) := by
      simp [z, Finsupp.sum]
    rw [hmap]
    simpa [Finsupp.linearCombination_apply, x] using hl
  have hzCoordinate :
      relativeShellLabelCoordinateSize m z = 0 :=
    (hkernel z).1 hLz
  have hzMem :
      (z : upperEndMeroField) ∈ B :=
    (relativeShellLabelCoordinateSize_kernel m z).1
      hzCoordinate
  let zB : B := ⟨(z : upperEndMeroField), hzMem⟩
  let P : Polynomial B :=
    l.sum (fun n a =>
      Polynomial.C (algebraMap ℂ B a) *
        Polynomial.X ^ (n + 1)) -
      Polynomial.C zB
  have heval :
      Polynomial.aeval
        (relativeShellMultiplierUpperEndCarrier m.1)
        P = 0 := by
    have hB (a : ℂ) :
        algebraMap B upperEndMeroField
            (algebraMap ℂ B a) =
          algebraMap ℂ upperEndMeroField a := by
      change
        algebraMap upperEndRationalCoordinateField
            upperEndMeroField
            (algebraMap ℂ
              upperEndRationalCoordinateField a) =
          algebraMap ℂ upperEndMeroField a
      exact
        (IsScalarTower.algebraMap_apply ℂ
          upperEndRationalCoordinateField
          upperEndMeroField a).symm
    have hFull (a : ℂ) :
        ((algebraMap ℂ RelativeShellFullObservable a :
            RelativeShellFullObservable) :
          upperEndMeroField) =
          algebraMap ℂ upperEndMeroField a := by
      change
        algebraMap upperEndRationalCoordinateField
            upperEndMeroField
            (algebraMap ℂ
              upperEndRationalCoordinateField a) =
          algebraMap ℂ upperEndMeroField a
      exact
        (IsScalarTower.algebraMap_apply ℂ
          upperEndRationalCoordinateField
          upperEndMeroField a).symm
    simp [P, zB, z, Polynomial.aeval_def,
      Algebra.smul_def, Finsupp.sum, x,
      relativeShellMultiplierObservable]
    change
      (Polynomial.eval₂RingHom
        (algebraMap B upperEndMeroField)
        (relativeShellMultiplierUpperEndCarrier m.1))
          (∑ n ∈ l.support,
            Polynomial.C (algebraMap ℂ B (l n)) *
              Polynomial.X ^ (n + 1)) -
        ∑ n ∈ l.support,
          ((algebraMap ℂ RelativeShellFullObservable
              (l n) : RelativeShellFullObservable) :
            upperEndMeroField) *
            relativeShellMultiplierUpperEndCarrier m.1 ^
              (n + 1) = 0
    rw [map_sum]
    simp [hB, hFull]
  have hPzero : P = 0 := by
    by_contra hPne
    exact htr ⟨P, hPne, heval⟩
  apply Finsupp.ext
  intro n
  have hcoeff :=
    congrArg (fun Q : Polynomial B => Q.coeff (n + 1))
      hPzero
  by_cases hn : n ∈ l.support
  · simp [P, Finsupp.sum, hn] at hcoeff
    exact hcoeff
  · simpa [Finsupp.mem_support_iff] using hn

/--
No finite-dimensional complex coefficient target can have kernel exactly
equal to absence of one private shell label.
-/
theorem no_finiteDimensional_complexLinearMap_exact_relativeShellLabelKernel
    (m : RelativeShellLabel)
    (V : Type*) [AddCommGroup V] [Module ℂ V]
    [FiniteDimensional ℂ V] :
    ¬ ∃ L :
        RelativeShellFullObservable →ₗ[ℂ] V,
      ∀ x,
        L x = 0 ↔
          relativeShellLabelCoordinateSize m x = 0 := by
  rintro ⟨L, hkernel⟩
  let x : RelativeShellFullObservable :=
    relativeShellMultiplierObservable m
  have hLI :
      LinearIndependent ℂ
        (fun n : ℕ => L (x ^ (n + 1))) := by
    simpa [x] using
      relativeShellLabel_exactKernel_powerImages_linearIndependent
        m L hkernel
  let N := Module.finrank ℂ V + 1
  have hLIFin :
      LinearIndependent ℂ
        (fun i : Fin N => L (x ^ (i.1 + 1))) :=
    hLI.comp (fun i : Fin N => i.1) Fin.val_injective
  have hcard :=
    hLIFin.fintype_card_le_finrank
  simp [N] at hcard

end

end RHTower
