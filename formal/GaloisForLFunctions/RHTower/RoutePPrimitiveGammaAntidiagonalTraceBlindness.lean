import GaloisForLFunctions.RHTower.RoutePPrimitiveGammaResolvedAntidiagonalShorting
import GaloisForLFunctions.RHTower.FrankensteinMatrixCompleteBoundaryRestriction

/-!
# Route P Gamma antidiagonal trace blindness

The P-G191 antidiagonal is the complete kernel of the physical two-channel
Gamma reporter, but Route P's endpoint is a Loewner trace estimate.  This
module proves that those facts are incompatible with treating shorting as the
missing transport: the literal double-Green Wold current has zero report while
its positive Gram trace survives exactly.

The positive survivor is an exact visible/hidden Pythagorean law.  Any viable
boundary transport must retain the antidiagonal as an energy-carrying defect
channel in a matrix-complete colligation; no observer applied after the Gamma
codiagonal can recover or bound that energy.

No Xi divisor, zero-location statement, target positivity assumption, or
Riemann-hypothesis premise occurs.
-/

open Complex Matrix Set
open scoped BigOperators ComplexOrder

namespace RHTower

open GaloisForLFunctions.HTGeometry

noncomputable section

/-- Euclidean energy of a resolved real two-channel current. -/
def routePPrimitiveGammaResolvedEnergy (z : ℝ × ℝ) : ℝ :=
  z.1 ^ (2 : ℕ) + z.2 ^ (2 : ℕ)

/-- Difference coordinate carrying the hidden antidiagonal channel. -/
def routePPrimitiveGammaResolvedHiddenCoordinate (z : ℝ × ℝ) : ℝ :=
  z.1 - z.2

/-- **Exact visible/hidden energy split.**  The physical Gamma reporter sees
only the codiagonal coordinate; the complementary antidiagonal energy remains
as an exact positive square.  The division-free form includes the balanced
section without singular denominators. -/
theorem routePPrimitiveGammaResolvedReporter_pythagorean
    (a : ℝ) (i j : Nat.Primes × ℕ) (z : ℝ × ℝ) :
    2 * xiGammaEulerPrimitiveCoorientedReflectionOddExterior a i j ^ (2 : ℕ) *
        routePPrimitiveGammaResolvedEnergy z =
      routePPrimitiveGammaCoorientedResolvedReporter a i j z ^ (2 : ℕ) +
        xiGammaEulerPrimitiveCoorientedReflectionOddExterior a i j ^ (2 : ℕ) *
          routePPrimitiveGammaResolvedHiddenCoordinate z ^ (2 : ℕ) := by
  rw [routePPrimitiveGammaCoorientedResolvedReporter_eq_codiagonal]
  simp only [resolvedDefectCodiagonal_apply]
  unfold routePPrimitiveGammaResolvedEnergy
    routePPrimitiveGammaResolvedHiddenCoordinate
  ring

theorem routePPrimitiveGammaResolvedWoldCurrent_energy_pos
    (i j : Nat.Primes × ℕ) :
    0 < routePPrimitiveGammaResolvedEnergy
      (routePPrimitiveGammaResolvedWoldCurrent i j) := by
  rw [routePPrimitiveGammaResolvedEnergy,
    routePPrimitiveGammaResolvedWoldCurrent_energy]
  exact mul_pos
    (mul_pos (by norm_num)
      (routePPrimitiveGammaSewnCriticalQuadraticGreenFlux_pos i))
    (routePPrimitiveGammaSewnCriticalQuadraticGreenFlux_pos j)

/-- No scalar multiple of the squared physical report can control resolved
energy: the canonical source-derived Wold current is an explicit counterexample. -/
theorem not_exists_routePPrimitiveGammaResolvedEnergy_le_reporter_sq
    (a : ℝ) (i j : Nat.Primes × ℕ) :
    ¬ ∃ C : ℝ, ∀ z : ℝ × ℝ,
      routePPrimitiveGammaResolvedEnergy z ≤
        C * routePPrimitiveGammaCoorientedResolvedReporter a i j z ^ (2 : ℕ) := by
  rintro ⟨C, hC⟩
  have hbad := hC (routePPrimitiveGammaResolvedWoldCurrent i j)
  rw [routePPrimitiveGammaCoorientedResolvedReporter_woldCurrent,
    zero_pow (by norm_num), mul_zero] at hbad
  exact (not_lt_of_ge hbad)
    (routePPrimitiveGammaResolvedWoldCurrent_energy_pos i j)

/-- One-dimensional source sector generated by the canonical hidden Wold
current. -/
def routePPrimitiveGammaResolvedWoldSector
    (i j : Nat.Primes × ℕ) : Submodule ℝ (ℝ × ℝ) :=
  Submodule.span ℝ {routePPrimitiveGammaResolvedWoldCurrent i j}

/-- Every observer applied after the physical Gamma reporter is nonconservative
on the actual double-Green Wold sector. -/
theorem routePPrimitiveGammaResolvedWoldSector_no_postReporter_conservativity
    {W : Type*} [AddCommGroup W] [Module ℝ W]
    (observe : ℝ →ₗ[ℝ] W) (a : ℝ) (i j : Nat.Primes × ℕ) :
    ¬ IsConservativeOn
      (observe.comp (routePPrimitiveGammaCoorientedResolvedReporter a i j))
      (routePPrimitiveGammaResolvedWoldSector i j) := by
  intro hconservative
  let w := routePPrimitiveGammaResolvedWoldCurrent i j
  have hsector : w ∈ routePPrimitiveGammaResolvedWoldSector i j := by
    exact Submodule.subset_span (Set.mem_singleton w)
  have hkernel : w ∈ LinearMap.ker
      (observe.comp (routePPrimitiveGammaCoorientedResolvedReporter a i j)) := by
    change observe
      (routePPrimitiveGammaCoorientedResolvedReporter a i j w) = 0
    rw [show w = routePPrimitiveGammaResolvedWoldCurrent i j from rfl,
      routePPrimitiveGammaCoorientedResolvedReporter_woldCurrent,
      map_zero]
  have hzero :=
    (Submodule.disjoint_def.mp hconservative) w hsector hkernel
  exact routePPrimitiveGammaResolvedWoldCurrent_ne_zero i j hzero

/-- Complex two-column realization of the source-derived P-G191 Wold current. -/
def routePPrimitiveGammaResolvedWoldPacket
    (i j : Nat.Primes × ℕ) : Fin 2 → ℂ :=
  ![(routePPrimitiveGammaResolvedWoldAmplitude i j : ℂ),
    -(routePPrimitiveGammaResolvedWoldAmplitude i j : ℂ)]

/-- Its coherent scalar observation vanishes exactly. -/
theorem routePPrimitiveGammaResolvedWoldPacket_sum
    (i j : Nat.Primes × ℕ) :
    ∑ k : Fin 2, routePPrimitiveGammaResolvedWoldPacket i j k = 0 := by
  simp [routePPrimitiveGammaResolvedWoldPacket, Fin.sum_univ_two]

theorem routePPrimitiveGammaResolvedWoldPacket_gram_posSemidef
    (i j : Nat.Primes × ℕ) :
    (Matrix.gram ℂ
      (routePPrimitiveGammaResolvedWoldPacket i j)).PosSemidef := by
  exact Matrix.posSemidef_gram ℂ _

/-- The Gram trace is exactly the strictly positive P-G191 pair energy despite
coherent cancellation. -/
theorem re_trace_routePPrimitiveGammaResolvedWoldPacket_gram
    (i j : Nat.Primes × ℕ) :
    (Matrix.gram ℂ
        (routePPrimitiveGammaResolvedWoldPacket i j)).trace.re =
      2 * routePPrimitiveGammaSewnCriticalQuadraticGreenFlux i *
        routePPrimitiveGammaSewnCriticalQuadraticGreenFlux j := by
  simp [Matrix.trace, Matrix.gram_apply,
    routePPrimitiveGammaResolvedWoldPacket, Fin.sum_univ_two]
  rw [abs_of_pos (routePPrimitiveGammaResolvedWoldAmplitude_pos i j)]
  have hcast :
      (((routePPrimitiveGammaResolvedWoldAmplitude i j : ℝ) : ℂ) ^ (2 : ℕ)).re =
        routePPrimitiveGammaResolvedWoldAmplitude i j ^ (2 : ℕ) := by
    rw [pow_two]
    norm_num
    exact (pow_two _).symm
  rw [hcast]
  rw [routePPrimitiveGammaResolvedWoldAmplitude_sq]
  ring

theorem re_trace_routePPrimitiveGammaResolvedWoldPacket_gram_pos
    (i j : Nat.Primes × ℕ) :
    0 < (Matrix.gram ℂ
      (routePPrimitiveGammaResolvedWoldPacket i j)).trace.re := by
  rw [re_trace_routePPrimitiveGammaResolvedWoldPacket_gram]
  exact mul_pos
    (mul_pos (by norm_num)
      (routePPrimitiveGammaSewnCriticalQuadraticGreenFlux_pos i))
    (routePPrimitiveGammaSewnCriticalQuadraticGreenFlux_pos j)

/-- The observer-blind positive Gram trace remains globally trace-finite over
all ordered primitive cell pairs. -/
theorem summable_re_trace_routePPrimitiveGammaResolvedWoldPacket_gram :
    Summable (fun ij :
        (Nat.Primes × ℕ) × (Nat.Primes × ℕ) =>
      (Matrix.gram ℂ
        (routePPrimitiveGammaResolvedWoldPacket ij.1 ij.2)).trace.re) := by
  exact summable_routePPrimitiveGammaResolvedWoldCurrent_energy.congr fun ij => by
    rw [re_trace_routePPrimitiveGammaResolvedWoldPacket_gram,
      routePPrimitiveGammaResolvedWoldCurrent_energy]

/-- Source-native coherent shorting cannot yield even the zero Loewner
majorant: positive matrix trace survives. -/
theorem not_routePPrimitiveGammaResolvedWoldPacket_gram_le_zero :
    ∀ i j : Nat.Primes × ℕ,
      ¬ frankensteinMatrixLoewnerLE
        (Matrix.gram ℂ (routePPrimitiveGammaResolvedWoldPacket i j)) 0 := by
  intro i j hle
  have htrace := matrix_re_trace_mono_of_frankensteinLoewnerLE hle
  have hpos :=
    re_trace_routePPrimitiveGammaResolvedWoldPacket_gram_pos i j
  simp only [Matrix.trace_zero, Complex.zero_re] at htrace
  linarith

/-- Literal Route-P counterexample to passing from coherent shorting to Gram
trace control. -/
theorem routePPrimitiveGammaResolvedWoldPacket_not_trace_le_coherentNormSq
    (i j : Nat.Primes × ℕ) :
    ¬ (Matrix.gram ℂ
          (routePPrimitiveGammaResolvedWoldPacket i j)).trace.re ≤
        ‖∑ k : Fin 2, routePPrimitiveGammaResolvedWoldPacket i j k‖ ^ (2 : ℕ) := by
  rw [routePPrimitiveGammaResolvedWoldPacket_sum]
  simp only [norm_zero, pow_two, mul_zero]
  exact not_le.mpr
    (re_trace_routePPrimitiveGammaResolvedWoldPacket_gram_pos i j)

end

end RHTower
