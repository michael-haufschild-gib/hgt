import GaloisForLFunctions.RHTower.RelativeShellSummableProvenanceTopology

/-!
# Coordinate provenance topology

A single increasing provenance norm is discrete, while dyadic total support
mass is non-discrete and sends cofinal shell atoms to zero.  This file extracts
the stronger positive survivor: one non-Archimedean `0/1` seminorm for every
private shell label.

The `m`-coordinate seminorm detects whether canonical least support contains
`m`.  Its kernel is exactly the differential field generated by every private
shell except `m`.  The joint kernel of all coordinates is exactly the common
zeta differential field.  Thus the coordinate family separates the transverse
quotient even though the explicit cofinal sequence of private singleton
supports converges coordinatewise to zero.

This proves that algebraic label detection is compatible with non-discrete
cofinal attenuation when provenance is retained as a family rather than one
uniform scalar cost.  The associated finitely supported `0/1` vector is only a
support shadow, not an additive coefficient comparison and not the missing
Deninger/Meyer relevant complex.
-/

open Set Filter
open scoped Classical Topology
open scoped Differential UpperEndDifferentialInstances
  UpperEndComplexTowerInstances

namespace RHTower

open GaloisForLFunctions
open GaloisForLFunctions.HTGeometry

noncomputable section

/-- `0/1` detector for occurrence of private label `m` in canonical support. -/
def relativeShellLabelCoordinateSize
    (m : RelativeShellLabel)
    (x : RelativeShellFullObservable) : ℝ :=
  if m ∈ relativeShellObservableSupport x then 1 else 0

@[simp] theorem relativeShellLabelCoordinateSize_zero
    (m : RelativeShellLabel) :
    relativeShellLabelCoordinateSize m
        (0 : RelativeShellFullObservable) = 0 := by
  simp [relativeShellLabelCoordinateSize,
    relativeShellObservableSupport_zero]

theorem relativeShellLabelCoordinateSize_nonneg
    (m : RelativeShellLabel)
    (x : RelativeShellFullObservable) :
    0 ≤ relativeShellLabelCoordinateSize m x := by
  simp only [relativeShellLabelCoordinateSize]
  split_ifs <;> norm_num

theorem relativeShellLabelCoordinateSize_neg
    (m : RelativeShellLabel)
    (x : RelativeShellFullObservable) :
    relativeShellLabelCoordinateSize m (-x) =
      relativeShellLabelCoordinateSize m x := by
  simp [relativeShellLabelCoordinateSize,
    relativeShellObservableSupport_neg]

theorem relativeShellLabelCoordinateSize_add_le_max
    (m : RelativeShellLabel)
    (x y : RelativeShellFullObservable) :
    relativeShellLabelCoordinateSize m (x + y) ≤
      max (relativeShellLabelCoordinateSize m x)
        (relativeShellLabelCoordinateSize m y) := by
  by_cases hsum :
      m ∈ relativeShellObservableSupport (x + y)
  · have hxy :=
      relativeShellObservableSupport_add_subset x y hsum
    rcases hxy with hx | hy
    · simp [relativeShellLabelCoordinateSize, hsum, hx]
    · simp [relativeShellLabelCoordinateSize, hsum, hy]
  · rw [relativeShellLabelCoordinateSize, if_neg hsum]
    exact
      (relativeShellLabelCoordinateSize_nonneg m x).trans
        (le_max_left _ _)

/-- Non-Archimedean provenance seminorm for one private label. -/
def relativeShellLabelCoordinateSeminorm
    (m : RelativeShellLabel) :
    NonarchAddGroupSeminorm RelativeShellFullObservable where
  toFun := relativeShellLabelCoordinateSize m
  map_zero' := relativeShellLabelCoordinateSize_zero m
  add_le_max' := relativeShellLabelCoordinateSize_add_le_max m
  neg' := relativeShellLabelCoordinateSize_neg m

@[simp] theorem relativeShellLabelCoordinateSize_eq_zero_iff
    (m : RelativeShellLabel)
    (x : RelativeShellFullObservable) :
    relativeShellLabelCoordinateSize m x = 0 ↔
      m ∉ relativeShellObservableSupport x := by
  simp [relativeShellLabelCoordinateSize]

/-- All private labels except `m`. -/
def relativeShellLabelComplement
    (m : RelativeShellLabel) :
    Set RelativeShellLabel :=
  {n | n ≠ m}

/--
Exact coordinate kernel: deleting coordinate `m` deletes precisely private
generator `m`, while retaining every other shell and the common zeta field.
-/
theorem relativeShellLabelCoordinateSize_kernel
    (m : RelativeShellLabel)
    (x : RelativeShellFullObservable) :
    relativeShellLabelCoordinateSize m x = 0 ↔
      (x : upperEndMeroField) ∈
        relativeShellSubsetDifferentialField
          (relativeShellLabelComplement m) := by
  rw [relativeShellLabelCoordinateSize_eq_zero_iff,
    mem_relativeShellSubsetDifferentialField_iff_support_subset]
  constructor
  · intro hm n hn
    change n ≠ m
    intro hnm
    subst n
    exact hm hn
  · intro hsub hm
    exact (hsub hm) rfl

theorem relativeShellLabelCoordinateSize_add_of_common
    (m : RelativeShellLabel)
    (x c : RelativeShellFullObservable)
    (hc :
      (c : upperEndMeroField) ∈
        relativeShellSubsetDifferentialField
          (∅ : Set RelativeShellLabel)) :
    relativeShellLabelCoordinateSize m (x + c) =
      relativeShellLabelCoordinateSize m x := by
  simp [relativeShellLabelCoordinateSize,
    relativeShellObservableSupport_add_of_common x c hc]

/-- Coordinate matrix of private shell atoms is the Kronecker delta. -/
theorem relativeShellLabelCoordinateSize_multiplier
    (m n : RelativeShellLabel) :
    relativeShellLabelCoordinateSize m
        (relativeShellMultiplierObservable n) =
      if m = n then 1 else 0 := by
  simp [relativeShellLabelCoordinateSize,
    relativeShellMultiplierObservable_support]

/-- Joint radical of the entire coordinate-seminorm family. -/
theorem relativeShellLabelCoordinateSize_joint_kernel
    (x : RelativeShellFullObservable) :
    (∀ m : RelativeShellLabel,
        relativeShellLabelCoordinateSize m x = 0) ↔
      (x : upperEndMeroField) ∈
        relativeShellSubsetDifferentialField
          (∅ : Set RelativeShellLabel) := by
  rw [← relativeShellObservableSupport_eq_empty_iff]
  constructor
  · intro hall
    apply Set.Subset.antisymm
    · intro m hm
      exact
        ((relativeShellLabelCoordinateSize_eq_zero_iff m x).mp
          (hall m) hm).elim
    · exact Set.empty_subset _
  · intro hs m
    rw [relativeShellLabelCoordinateSize_eq_zero_iff]
    simp [hs]

/--
Finite `0/1` support shadow of an observable.  Its exact support is canonical
provenance, but its values deliberately contain no coefficient information.
-/
def relativeShellProvenanceVector
    (x : RelativeShellFullObservable) :
    RelativeShellLabel →₀ ℝ :=
  Finsupp.onFinset
    (relativeShellObservableSupportFinset x)
    (fun m => relativeShellLabelCoordinateSize m x)
    (by
      intro m hm
      by_contra hmem
      have hnot :
          m ∉ relativeShellObservableSupport x := by
        intro hs
        apply hmem
        have hmSet :
            m ∈
              (relativeShellObservableSupportFinset x :
                Set RelativeShellLabel) := by
          rwa [coe_relativeShellObservableSupportFinset]
        exact hmSet
      exact
        hm
          ((relativeShellLabelCoordinateSize_eq_zero_iff m x).2
            hnot))

@[simp] theorem relativeShellProvenanceVector_apply
    (x : RelativeShellFullObservable)
    (m : RelativeShellLabel) :
    relativeShellProvenanceVector x m =
      relativeShellLabelCoordinateSize m x :=
  Finsupp.onFinset_apply

theorem relativeShellProvenanceVector_support
    (x : RelativeShellFullObservable) :
    (relativeShellProvenanceVector x).support =
      relativeShellObservableSupportFinset x := by
  apply Finset.ext
  intro m
  rw [Finsupp.mem_support_iff,
    relativeShellProvenanceVector_apply]
  constructor
  · intro hne
    by_contra hmem
    have hnot :
        m ∉ relativeShellObservableSupport x := by
      intro hs
      apply hmem
      have hmSet :
          m ∈
            (relativeShellObservableSupportFinset x :
              Set RelativeShellLabel) := by
        rwa [coe_relativeShellObservableSupportFinset]
      exact hmSet
    exact
      hne
        ((relativeShellLabelCoordinateSize_eq_zero_iff m x).2
          hnot)
  · intro hmem
    have hmSet :
        m ∈
          (relativeShellObservableSupportFinset x :
            Set RelativeShellLabel) := hmem
    rw [coe_relativeShellObservableSupportFinset] at hmSet
    simp [relativeShellLabelCoordinateSize, hmSet]

theorem relativeShellProvenanceVector_eq_zero_iff
    (x : RelativeShellFullObservable) :
    relativeShellProvenanceVector x = 0 ↔
      (x : upperEndMeroField) ∈
        relativeShellSubsetDifferentialField
          (∅ : Set RelativeShellLabel) := by
  rw [← relativeShellLabelCoordinateSize_joint_kernel]
  constructor
  · intro hx m
    have hfun := DFunLike.congr_fun hx m
    simpa using hfun
  · intro hx
    ext m
    simp [hx m]

theorem relativeShellProvenanceVector_add_of_common
    (x c : RelativeShellFullObservable)
    (hc :
      (c : upperEndMeroField) ∈
        relativeShellSubsetDifferentialField
          (∅ : Set RelativeShellLabel)) :
    relativeShellProvenanceVector (x + c) =
      relativeShellProvenanceVector x := by
  ext m
  simp [relativeShellLabelCoordinateSize_add_of_common
    m x c hc]

/-- Provenance vector of private shell `m` is the standard basis vector at `m`. -/
theorem relativeShellProvenanceVector_multiplier
    (m : RelativeShellLabel) :
    relativeShellProvenanceVector
        (relativeShellMultiplierObservable m) =
      Finsupp.single m 1 := by
  ext n
  simp [relativeShellLabelCoordinateSize_multiplier,
    Finsupp.single_apply, eq_comm]

/-- Every fixed label coordinate eventually vanishes along cofinal shell atoms. -/
theorem relativeShellLabelCoordinateSize_cofinal_tendsto_zero
    (m : RelativeShellLabel) :
    Tendsto
      (fun n : ℕ =>
        relativeShellLabelCoordinateSize m
          (relativeShellMultiplierObservable
            (relativeShellCofinalLabel n)))
      atTop (𝓝 0) := by
  apply tendsto_const_nhds.congr'
  filter_upwards [eventually_ge_atTop (m.1 + 1)]
    with n hn
  have hne :
      m ≠ relativeShellCofinalLabel n := by
    intro heq
    have hval := congrArg Subtype.val heq
    dsimp [relativeShellCofinalLabel] at hval
    omega
  simp [relativeShellLabelCoordinateSize_multiplier, hne]

/--
Cofinal private standard-basis vectors converge to zero in the product of all
label coordinates, although every vector is nonzero and its active label is
detected exactly.
-/
theorem relativeShellProvenanceVector_cofinal_tendsto_zero :
    Tendsto
      (fun n : ℕ =>
        fun m : RelativeShellLabel =>
          relativeShellProvenanceVector
            (relativeShellMultiplierObservable
              (relativeShellCofinalLabel n)) m)
      atTop
      (𝓝 (0 : RelativeShellLabel → ℝ)) := by
  rw [tendsto_pi_nhds]
  intro m
  simpa using
    relativeShellLabelCoordinateSize_cofinal_tendsto_zero m

end

end RHTower
