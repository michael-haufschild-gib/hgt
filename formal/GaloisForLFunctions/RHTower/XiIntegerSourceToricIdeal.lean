import GaloisForLFunctions.HTGeometry.HomogenizedIntegerBlowup
import GaloisForLFunctions.RHTower.XiExponentialSourceRelations
import Mathlib.Data.PNat.Basic

/-!
# The exact quadratic ideal of the integer-marked Xi source

For every positive integer `n`, take the actual upper-end germ represented by
`xi(-I*z) * exp(I*log(n)*z)`. The kernel of polynomial evaluation in all these germs is precisely
the ideal generated by `X_a*X_b-X_1*X_(a*b)`.

The logarithmic label map on positive integers is an injective additive homomorphism when their
multiplication is written additively. It therefore preserves the faithful monoid-algebra normal
form. Combining this with actual Xi source faithfulness proves the complete kernel equality.
-/

open GaloisForLFunctions.HTGeometry
open scoped UpperEndDifferentialInstances UpperEndComplexTowerInstances
noncomputable section
namespace RHTower.XiIntegerSourceToricIdeal

/-- Positive integers with multiplication written as addition. -/
abbrev Index := Additive ℕ+

/-- The rotated logarithmic label, additive under integer multiplication. -/
def logParameter : Index →+ ℂ where
  toFun n := Complex.I * (Real.log (n.toMul : ℕ) : ℂ)
  map_zero' := by simp
  map_add' m n := by
    change Complex.I * (Real.log ((m.toMul * n.toMul : ℕ+) : ℕ) : ℂ) = _
    rw [PNat.mul_coe, Nat.cast_mul, Real.log_mul]
    · simp [Complex.ofReal_add, mul_add]
    · exact_mod_cast m.toMul.2.ne'
    · exact_mod_cast n.toMul.2.ne'

/-- Distinct positive integers have distinct logarithmic labels. -/
theorem logParameter_injective : Function.Injective logParameter := by
  intro m n h
  have hlog : Real.log (m.toMul : ℕ) = Real.log (n.toMul : ℕ) :=
    Complex.ofReal_injective (mul_left_cancel₀ Complex.I_ne_zero h)
  have hnat : (m.toMul : ℕ) = (n.toMul : ℕ) := by
    exact_mod_cast Real.log_injOn_pos
      (show (0 : ℝ) < (m.toMul : ℕ) by exact_mod_cast m.toMul.2)
      (show (0 : ℝ) < (n.toMul : ℕ) by exact_mod_cast n.toMul.2) hlog
  exact congrArg Additive.ofMul (Subtype.ext hnat)

/-- Embed the arithmetic label algebra into the complex-parameter group algebra. -/
def coefficientMap : AddMonoidAlgebra ℂ Index →ₐ[ℂ] AddMonoidAlgebra ℂ ℂ :=
  AddMonoidAlgebra.mapDomainAlgHom ℂ ℂ logParameter

/-- The arithmetic coefficient embedding is faithful. -/
theorem coefficientMap_injective : Function.Injective coefficientMap :=
  AddMonoidAlgebra.mapDomain_injective logParameter_injective

/-- Arithmetic normal forms agree with the actual exponential-parameter normal forms. -/
theorem normalForm_factorization : RHTower.XiExponentialSourceRelations.normalForm logParameter =
    (Polynomial.mapAlgHom coefficientMap).comp
      (HomogenizedMonoidAlgebra.normalForm ℂ Index) := by
  apply MvPolynomial.algHom_ext
  intro n
  simp [RHTower.XiExponentialSourceRelations.normalForm,
    HomogenizedMonoidAlgebra.normalForm, coefficientMap, AddMonoidAlgebra.mapDomainAlgHom]

/-- The literal integer-marked Xi germ, corresponding to `xi(s)*n^(-s)` under `s=-I*z`. -/
def integerSource (n : ℕ+) : upperEndMeroField :=
  RHTower.xiRotatedUpperEndCarrier *
    RHTower.XiExponentialSourceRelations.expMero (Complex.I * (Real.log (n : ℕ) : ℂ))

/-- The ideal generated by the homogeneous multiplication-table quadrics. -/
def integerRelationIdeal : Ideal (MvPolynomial ℕ+ ℂ) :=
  Ideal.span (Set.range (fun ab : ℕ+ × ℕ+ =>
    MvPolynomial.X ab.1 * MvPolynomial.X ab.2 -
      MvPolynomial.X 1 * MvPolynomial.X (ab.1 * ab.2)))

/-- The actual integer-marked Xi source has exactly the multiplication-table quadratic relations. -/
theorem integerSource_kernel : RingHom.ker (MvPolynomial.aeval integerSource).toRingHom =
    integerRelationIdeal := by
  change RingHom.ker
      (MvPolynomial.aeval (RHTower.XiExponentialSourceRelations.source logParameter)).toRingHom =
    HomogenizedMonoidAlgebra.relationIdeal ℂ Index
  rw [← HomogenizedMonoidAlgebra.normalForm_kernel]
  ext P
  change MvPolynomial.aeval (RHTower.XiExponentialSourceRelations.source logParameter) P = 0 ↔
    HomogenizedMonoidAlgebra.normalForm ℂ Index P = 0
  rw [RHTower.XiExponentialSourceRelations.source_relation_iff_normalForm_zero,
    normalForm_factorization]
  exact map_eq_zero_iff (Polynomial.mapAlgHom coefficientMap)
    (Polynomial.map_injective coefficientMap.toRingHom coefficientMap_injective)

/-- The actual source image is the explicit algebra of positive-degree monoid normal forms. -/
def integerSourceRangeEquiv : (MvPolynomial.aeval (R := ℂ) integerSource).range ≃ₐ[ℂ]
    MonoidAlgebra ℂ (HomogenizedMonoidAlgebra.Tag Index) :=
  (Ideal.quotientKerEquivRange (MvPolynomial.aeval (R := ℂ) integerSource)).symm.trans
    ((Ideal.quotientEquivAlgOfEq ℂ integerSource_kernel).trans
      (HomogenizedMonoidAlgebra.quotientEquiv ℂ Index))

/-- Identify the actual source image with the faithful pinched polynomial realization. -/
def integerSourcePinchedEquiv : (MvPolynomial.aeval (R := ℂ) integerSource).range ≃ₐ[ℂ]
    (HomogenizedMonoidAlgebra.polynomialRealization ℂ Index).range :=
  integerSourceRangeEquiv.trans
    (AlgEquiv.ofInjective (HomogenizedMonoidAlgebra.polynomialRealization ℂ Index)
      (HomogenizedMonoidAlgebra.polynomialRealization_injective ℂ Index))


/-- The faithful integer-source algebra written in prime-variable polynomial coordinates. -/
def integerPrimeRealization : MonoidAlgebra ℂ (HomogenizedMonoidAlgebra.Tag Index) →ₐ[ℂ]
    Polynomial (MvPolynomial Nat.Primes ℂ) :=
  (HomogenizedIntegerBlowup.primePolynomialEquiv ℂ).toAlgHom.comp
    (HomogenizedMonoidAlgebra.polynomialRealization ℂ Index)

/-- Prime factorization preserves the faithful source realization. -/
theorem integerPrimeRealization_injective : Function.Injective integerPrimeRealization :=
  (HomogenizedIntegerBlowup.primePolynomialEquiv ℂ).injective.comp
    (HomogenizedMonoidAlgebra.polynomialRealization_injective ℂ Index)

/-- The actual Xi source image is the pinched prime-variable algebra. -/
def integerSourcePrimePinchedEquiv : (MvPolynomial.aeval (R := ℂ) integerSource).range ≃ₐ[ℂ]
    integerPrimeRealization.range :=
  integerSourceRangeEquiv.trans
    (AlgEquiv.ofInjective integerPrimeRealization integerPrimeRealization_injective)

/-- Its image is exactly scalar constants plus the homogenizer times arbitrary prime polynomials. -/
theorem integerPrimeRealization_range_iff (p : Polynomial (MvPolynomial Nat.Primes ℂ)) :
    p ∈ integerPrimeRealization.range ↔
      ∃ (c : ℂ) (q : Polynomial (MvPolynomial Nat.Primes ℂ)),
        p = Polynomial.C (MvPolynomial.C c) + Polynomial.X * q := by
  let e := HomogenizedIntegerBlowup.primePolynomialEquiv ℂ
  have hs (c : ℂ) : e (Polynomial.C (AddMonoidAlgebra.single (0 : Index) c)) =
      Polynomial.C (MvPolynomial.C c) := by
    change Polynomial.map _ (Polynomial.C _) = _
    rw [Polynomial.map_C]
    congr 1
    change HomogenizedIntegerBlowup.primeCoordinateEquiv ℂ (AddMonoidAlgebra.single 0 c) = _
    rw [HomogenizedIntegerBlowup.primeCoordinateEquiv_single,map_zero]
    rfl
  have hx : e Polynomial.X = Polynomial.X := Polynomial.map_X _
  constructor
  · rintro ⟨f,rfl⟩
    obtain ⟨c,q,h⟩ := (HomogenizedMonoidAlgebra.range_iff_pinched ℂ Index _).1 ⟨f,rfl⟩
    change HomogenizedMonoidAlgebra.polynomialRealization ℂ Index f = _ at h
    refine ⟨c,e q,?_⟩
    change e (HomogenizedMonoidAlgebra.polynomialRealization ℂ Index f) = _
    rw [h,map_add,map_mul,hs,hx]
  · rintro ⟨c,q,rfl⟩
    have hh : Polynomial.C (AddMonoidAlgebra.single (0 : Index) c) + Polynomial.X * e.symm q ∈
        (HomogenizedMonoidAlgebra.polynomialRealization ℂ Index).range :=
      (HomogenizedMonoidAlgebra.range_iff_pinched ℂ Index _).2 ⟨c,e.symm q,rfl⟩
    obtain ⟨f,hf⟩ := hh
    change HomogenizedMonoidAlgebra.polynomialRealization ℂ Index f = _ at hf
    refine ⟨f,?_⟩
    change e (HomogenizedMonoidAlgebra.polynomialRealization ℂ Index f) = _
    rw [hf,map_add,map_mul,hs,hx,e.apply_symm_apply]


end RHTower.XiIntegerSourceToricIdeal
