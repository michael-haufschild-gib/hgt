/-!
# Observer-dependent temporal dimension

An arbitrary family of observer-visible real frequencies generates:

* an additive frequency group over `ℤ`;
* a rational frequency module over `ℚ`;
* a cardinal-valued temporal dimension, the rank of that module.

Every additive subgroup of the real line is exclusively cyclic or dense.
Exact positive return of every visible phase is equivalent to cyclicity of
the visible frequency group.  This remains true for infinite families and
arbitrary positive spectral measures.

The infinite case has a strict fracture absent from finite packets: rational
rank one need not imply periodicity.  The rational frequencies have temporal
dimension one, generate a dense subgroup of `ℝ`, and admit no positive exact
return.
-/

open scoped BigOperators MeasureTheory

noncomputable section

namespace RHTower

/-! ## Arbitrary visible frequency families -/

/-- Additive group generated by an arbitrary family of observer-visible
frequencies. -/
def visibleFrequencyGroup {ι : Type*} (frequency : ι → ℝ) :
    AddSubgroup ℝ :=
  AddSubgroup.closure (Set.range frequency)

/-- Rational frequency module generated by an arbitrary observer-visible
family. -/
def visibleFrequencyModule {ι : Type*} (frequency : ι → ℝ) :
    Submodule ℚ ℝ :=
  Submodule.span ℚ (Set.range frequency)

/-- Observer temporal dimension.  The value is a cardinal, so the definition
applies without any finiteness assumption. -/
def observerTemporalDimension {ι : Type*} (frequency : ι → ℝ) :
    Cardinal :=
  Module.rank ℚ (visibleFrequencyModule frequency)

/-- Temporal dimension is zero exactly when every visible frequency is
zero. -/
theorem observerTemporalDimension_eq_zero_iff
    {ι : Type*} (frequency : ι → ℝ) :
    observerTemporalDimension frequency = 0 ↔
      ∀ i, frequency i = 0 := by
  rw [observerTemporalDimension, visibleFrequencyModule,
    Submodule.rank_eq_zero, Submodule.span_eq_bot]
  simp

/-- The visible additive group is trivial exactly when every generator is
zero. -/
theorem visibleFrequencyGroup_eq_bot_iff
    {ι : Type*} (frequency : ι → ℝ) :
    visibleFrequencyGroup frequency = ⊥ ↔
      ∀ i, frequency i = 0 := by
  rw [visibleFrequencyGroup, AddSubgroup.closure_eq_bot_iff]
  simp

/-- Zero temporal dimension and a trivial visible frequency group are
equivalent. -/
theorem observerTemporalDimension_eq_zero_iff_group_eq_bot
    {ι : Type*} (frequency : ι → ℝ) :
    observerTemporalDimension frequency = 0 ↔
      visibleFrequencyGroup frequency = ⊥ := by
  rw [observerTemporalDimension_eq_zero_iff,
    visibleFrequencyGroup_eq_bot_iff]

/-- Universal lattice--continuum dichotomy: every observer-visible frequency
group is exclusively dense or cyclic. -/
theorem visibleFrequencyGroup_dense_xor_cyclic
    {ι : Type*} (frequency : ι → ℝ) :
    Xor (Dense (visibleFrequencyGroup frequency : Set ℝ))
      (∃ omega : ℝ,
        visibleFrequencyGroup frequency =
          AddSubgroup.zmultiples omega) :=
  AddSubgroup.dense_xor_cyclic (visibleFrequencyGroup frequency)

/-- Inclusion of visible generators gives inclusion of visible additive
groups. -/
theorem visibleFrequencyGroup_mono
    {ι κ : Type*} {frequency : ι → ℝ} {larger : κ → ℝ}
    (h : Set.range frequency ⊆ Set.range larger) :
    visibleFrequencyGroup frequency ≤ visibleFrequencyGroup larger :=
  AddSubgroup.closure_mono h

/-- Inclusion of visible generators gives inclusion of visible rational
modules. -/
theorem visibleFrequencyModule_mono
    {ι κ : Type*} {frequency : ι → ℝ} {larger : κ → ℝ}
    (h : Set.range frequency ⊆ Set.range larger) :
    visibleFrequencyModule frequency ≤ visibleFrequencyModule larger :=
  Submodule.span_mono h

/-- Observer refinement cannot decrease temporal dimension. -/
theorem observerTemporalDimension_mono
    {ι κ : Type*} {frequency : ι → ℝ} {larger : κ → ℝ}
    (h : Set.range frequency ⊆ Set.range larger) :
    observerTemporalDimension frequency ≤
      observerTemporalDimension larger :=
  Submodule.rank_mono (visibleFrequencyModule_mono h)

/-! ## Exact return for arbitrary families -/

/-- Exact return in normalized cycles: every visible frequency accumulates
an integer number of turns. -/
def normalizedExactReturn {ι : Type*}
    (frequency : ι → ℝ) (t : ℝ) : Prop :=
  ∀ i, ∃ n : ℤ, t * frequency i = n

/-- Exact normalized return is equivalent to containment of the full visible
frequency group in one reciprocal-time lattice. -/
theorem normalizedExactReturn_iff_group_le_zmultiples
    {ι : Type*} (frequency : ι → ℝ) {t : ℝ} (ht : t ≠ 0) :
    normalizedExactReturn frequency t ↔
      visibleFrequencyGroup frequency ≤
        AddSubgroup.zmultiples t⁻¹ := by
  rw [visibleFrequencyGroup, AddSubgroup.closure_le]
  constructor
  · intro h x hx
    obtain ⟨i, rfl⟩ := hx
    obtain ⟨n, hn⟩ := h i
    change frequency i ∈ AddSubgroup.zmultiples t⁻¹
    rw [AddSubgroup.mem_zmultiples_iff]
    refine ⟨n, ?_⟩
    rw [zsmul_eq_mul]
    calc
      (n : ℝ) * t⁻¹ = (t * frequency i) * t⁻¹ := by rw [hn]
      _ = frequency i := by field_simp
  · intro h i
    have hmem : frequency i ∈ AddSubgroup.zmultiples t⁻¹ :=
      h (Set.mem_range_self i)
    rw [AddSubgroup.mem_zmultiples_iff] at hmem
    obtain ⟨n, hn⟩ := hmem
    refine ⟨n, ?_⟩
    rw [← hn, zsmul_eq_mul]
    field_simp

/-- An arbitrary visible frequency family has a positive exact return if and
only if its additive frequency group is cyclic. -/
theorem exists_positive_normalizedExactReturn_iff_cyclic
    {ι : Type*} (frequency : ι → ℝ) :
    (∃ t : ℝ, 0 < t ∧ normalizedExactReturn frequency t) ↔
      ∃ omega : ℝ,
        visibleFrequencyGroup frequency =
          AddSubgroup.zmultiples omega := by
  constructor
  · rintro ⟨t, ht, hret⟩
    have hle :
        visibleFrequencyGroup frequency ≤
          AddSubgroup.zmultiples t⁻¹ :=
      (normalizedExactReturn_iff_group_le_zmultiples
        frequency ht.ne').mp hret
    obtain ⟨n, hn⟩ :=
      (AddSubgroup.le_zmultiples_iff
        t⁻¹ (visibleFrequencyGroup frequency)).mp hle
    exact ⟨n • t⁻¹, hn⟩
  · rintro ⟨omega, hgroup⟩
    by_cases homega : omega = 0
    · refine ⟨1, by norm_num, ?_⟩
      rw [normalizedExactReturn_iff_group_le_zmultiples
        frequency one_ne_zero, inv_one, hgroup, homega]
      simp
    · refine ⟨|omega|⁻¹,
        inv_pos.mpr (abs_pos.mpr homega), ?_⟩
      rw [normalizedExactReturn_iff_group_le_zmultiples frequency
        (inv_ne_zero (abs_ne_zero.mpr homega)),
        inv_inv, hgroup]
      by_cases hpos : 0 < omega
      · rw [abs_of_pos hpos]
      · rw [abs_of_nonpos (le_of_not_gt hpos)]
        intro x hx
        rw [AddSubgroup.mem_zmultiples_iff] at hx ⊢
        obtain ⟨n, rfl⟩ := hx
        exact ⟨-n, by simp⟩

/-! ## Infinite rank-one fracture -/

/-- The rationally indexed real frequencies span exactly one rational
direction. -/
theorem rationalCast_visibleFrequencyModule :
    visibleFrequencyModule (fun q : ℚ => (q : ℝ)) =
      ℚ ∙ (1 : ℝ) := by
  apply le_antisymm
  · rw [visibleFrequencyModule, Submodule.span_le]
    rintro x ⟨q, rfl⟩
    change (q : ℝ) ∈ ℚ ∙ (1 : ℝ)
    rw [Submodule.mem_span_singleton]
    exact ⟨q, by simp⟩
  · rw [Submodule.span_le]
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst x
    exact Submodule.subset_span ⟨1, by simp⟩

/-- The rational frequency family has temporal dimension exactly one. -/
theorem rationalCast_observerTemporalDimension :
    observerTemporalDimension (fun q : ℚ => (q : ℝ)) = 1 := by
  rw [observerTemporalDimension, rationalCast_visibleFrequencyModule,
    Module.rank_eq_one_iff_finrank_eq_one]
  exact finrank_span_singleton one_ne_zero

/-- Despite having dimension one, the rational frequency family generates a
dense visible frequency group. -/
theorem rationalCast_visibleFrequencyGroup_dense :
    Dense
      (visibleFrequencyGroup
        (fun q : ℚ => (q : ℝ)) : Set ℝ) :=
  Rat.denseRange_cast.mono fun _ hx =>
    AddSubgroup.subset_closure hx

/-- The dimension-one rational frequency family has no positive exact
return. -/
theorem rationalCast_has_no_positive_exactReturn :
    ¬ ∃ t : ℝ, 0 < t ∧
      normalizedExactReturn (fun q : ℚ => (q : ℝ)) t := by
  intro h
  obtain ⟨omega, hgroup⟩ :=
    (exists_positive_normalizedExactReturn_iff_cyclic
      (fun q : ℚ => (q : ℝ))).mp h
  exact
    ((AddSubgroup.dense_iff_ne_zmultiples.mp
      rationalCast_visibleFrequencyGroup_dense) omega) hgroup

/-- Prime logarithms give an explicit observer with countably infinite
temporal dimension.  Unique factorization supplies the independent
frequencies; no limiting or genericity assumption is used. -/
theorem observerTemporalDimension_logPrimes :
    observerTemporalDimension
        (fun p : Nat.Primes => Real.log (p : ℕ)) =
      Cardinal.aleph0 := by
  rw [observerTemporalDimension, visibleFrequencyModule]
  calc
    Module.rank ℚ
        (Submodule.span ℚ
          (Set.range (fun p : Nat.Primes => Real.log (p : ℕ)))) =
        Cardinal.mk
          (Set.range (fun p : Nat.Primes => Real.log (p : ℕ))) :=
      rank_span GaloisForLFunctions.linearIndependent_log_primes
    _ = Cardinal.mk Nat.Primes := by
      simpa using Cardinal.mk_range_eq_of_injective
        GaloisForLFunctions.linearIndependent_log_primes.injective
    _ = Cardinal.aleph0 := Cardinal.mk_eq_aleph0 Nat.Primes

/-! ## Finite observer graphs -/

/-- The energy gap carried by an ordered graph edge, and zero off the
coherence graph. -/
def graphVisibleGap {V : Type*} (G : SimpleGraph V)
    (energy : V → ℝ) (p : V × V) : ℝ :=
  by
    classical
    exact if G.Adj p.1 p.2 then energy p.1 - energy p.2 else 0

/-- Rational module generated by all graph-visible energy gaps. -/
def graphTemporalModule {V : Type*} (G : SimpleGraph V)
    (energy : V → ℝ) : Submodule ℚ ℝ :=
  visibleFrequencyModule (graphVisibleGap G energy)

/-- Arithmetic temporal dimension of a finite observer graph. -/
def graphTemporalDimension {V : Type*} [Fintype V]
    (G : SimpleGraph V) (energy : V → ℝ) : ℕ :=
  Module.finrank ℚ (graphTemporalModule G energy)

/-- Rational module generated by non-reference component-relative
energies. -/
def graphRelativeEnergyModule {V : Type*} (G : SimpleGraph V)
    (energy : V → ℝ) : Submodule ℚ ℝ :=
  Submodule.span ℚ
    (Set.range (fun v : graphNonRoot G =>
      graphRelativeEnergy G energy v.1))

/-- Every component-relative energy lies in the module generated by the
non-reference relative energies. -/
theorem graphRelativeEnergy_mem_module
    {V : Type*} (G : SimpleGraph V) (energy : V → ℝ) (v : V) :
    graphRelativeEnergy G energy v ∈
      graphRelativeEnergyModule G energy := by
  by_cases hv : IsGraphComponentRoot G v
  · rw [graphRelativeEnergy_eq_zero_of_root G energy hv]
    exact Submodule.zero_mem _
  · exact Submodule.subset_span
      ⟨(⟨v, hv⟩ : graphNonRoot G), rfl⟩

/-- Every visible edge gap belongs to the component-relative energy
module. -/
theorem graphVisibleGap_mem_relativeEnergyModule
    {V : Type*} (G : SimpleGraph V) (energy : V → ℝ)
    (p : V × V) :
    graphVisibleGap G energy p ∈
      graphRelativeEnergyModule G energy := by
  classical
  simp only [graphVisibleGap]
  split_ifs with hp
  · rw [energy_sub_eq_graphRelativeEnergy_sub_of_adj G energy hp]
    exact Submodule.sub_mem _
      (graphRelativeEnergy_mem_module G energy p.1)
      (graphRelativeEnergy_mem_module G energy p.2)
  · exact Submodule.zero_mem _

/-- The graph temporal module is contained in the module of component
relative energies. -/
theorem graphTemporalModule_le_relativeEnergyModule
    {V : Type*} (G : SimpleGraph V) (energy : V → ℝ) :
    graphTemporalModule G energy ≤
      graphRelativeEnergyModule G energy := by
  rw [graphTemporalModule, visibleFrequencyModule, Submodule.span_le]
  rintro _ ⟨p, rfl⟩
  exact graphVisibleGap_mem_relativeEnergyModule G energy p

/-- Every gap between reachable vertices is generated by visible edge
gaps. -/
theorem energy_sub_mem_graphTemporalModule_of_reachable
    {V : Type*} (G : SimpleGraph V) (energy : V → ℝ)
    {u v : V} (huv : G.Reachable u v) :
    energy u - energy v ∈ graphTemporalModule G energy := by
  rw [G.reachable_iff_reflTransGen] at huv
  induction huv with
  | refl =>
      simp
  | @tail b c hub hbc ih =>
      have hedge :
          energy b - energy c ∈ graphTemporalModule G energy := by
        have hgenerator :
            graphVisibleGap G energy (b, c) ∈
              graphTemporalModule G energy := by
          exact Submodule.subset_span (Set.mem_range_self (b, c))
        simpa [graphVisibleGap, hbc] using hgenerator
      have hadd := Submodule.add_mem _ ih hedge
      convert hadd using 1
      ring

/-- Every component-relative energy is generated by visible edge gaps. -/
theorem graphRelativeEnergy_mem_graphTemporalModule
    {V : Type*} (G : SimpleGraph V) (energy : V → ℝ) (v : V) :
    graphRelativeEnergy G energy v ∈
      graphTemporalModule G energy := by
  have hcomponent :
      G.connectedComponentMk v =
        G.connectedComponentMk
          (graphComponentRoot G (G.connectedComponentMk v)) := by
    symm
    exact connectedComponentMk_graphComponentRoot G _
  have hreachable :
      G.Reachable v
        (graphComponentRoot G (G.connectedComponentMk v)) :=
    SimpleGraph.ConnectedComponent.exact hcomponent
  simpa [graphRelativeEnergy] using
    energy_sub_mem_graphTemporalModule_of_reachable G energy hreachable

/-- Component-relative energies are contained in the visible edge-gap
module. -/
theorem graphRelativeEnergyModule_le_graphTemporalModule
    {V : Type*} (G : SimpleGraph V) (energy : V → ℝ) :
    graphRelativeEnergyModule G energy ≤
      graphTemporalModule G energy := by
  rw [graphRelativeEnergyModule, Submodule.span_le]
  rintro _ ⟨v, rfl⟩
  exact graphRelativeEnergy_mem_graphTemporalModule G energy v.1

/-- Exact graph arithmetic law: visible edge gaps and non-reference
component-relative energies generate the same rational module. -/
theorem graphTemporalModule_eq_relativeEnergyModule
    {V : Type*} (G : SimpleGraph V) (energy : V → ℝ) :
    graphTemporalModule G energy =
      graphRelativeEnergyModule G energy :=
  le_antisymm
    (graphTemporalModule_le_relativeEnergyModule G energy)
    (graphRelativeEnergyModule_le_graphTemporalModule G energy)

/-- The relative-energy module has rank at most the number of
non-reference vertices. -/
theorem graphRelativeEnergyModule_finrank_le
    {V : Type*} [Fintype V] (G : SimpleGraph V) (energy : V → ℝ) :
    Module.finrank ℚ (graphRelativeEnergyModule G energy) ≤
      Fintype.card (graphNonRoot G) := by
  let s : Set ℝ :=
    Set.range (fun v : graphNonRoot G =>
      graphRelativeEnergy G energy v.1)
  letI : Fintype s := Fintype.ofFinite s
  have hspan :
      Module.finrank ℚ (Submodule.span ℚ s) ≤ s.toFinset.card :=
    finrank_span_le_card s
  calc
    Module.finrank ℚ (graphRelativeEnergyModule G energy) =
        Module.finrank ℚ (Submodule.span ℚ s) := by rfl
    _ ≤ s.toFinset.card := hspan
    _ = Fintype.card s := Set.toFinset_card s
    _ ≤ Fintype.card (graphNonRoot G) := Fintype.card_range_le _

/-- Arithmetic temporal dimension never exceeds the observer graph's
topological phase capacity `vertices - components`. -/
theorem graphTemporalDimension_le_phaseCapacity
    {V : Type*} [Fintype V] (G : SimpleGraph V) (energy : V → ℝ) :
    graphTemporalDimension G energy ≤
      Fintype.card V - Nat.card G.ConnectedComponent := by
  letI : Module.Finite ℚ
      (graphRelativeEnergyModule G energy) := by
    rw [graphRelativeEnergyModule]
    exact Module.Finite.span_of_finite ℚ (Set.finite_range _)
  rw [graphTemporalDimension]
  calc
    Module.finrank ℚ (graphTemporalModule G energy) ≤
        Module.finrank ℚ (graphRelativeEnergyModule G energy) :=
      Submodule.finrank_mono
        (graphTemporalModule_le_relativeEnergyModule G energy)
    _ ≤ Fintype.card (graphNonRoot G) :=
      graphRelativeEnergyModule_finrank_le G energy
    _ = Fintype.card V - Nat.card G.ConnectedComponent :=
      card_graphNonRoot G

/-- Rational independence of the component-relative energies saturates the
observer graph phase capacity. -/
theorem graphTemporalDimension_eq_phaseCapacity_of_independent
    {V : Type*} [Fintype V] (G : SimpleGraph V) (energy : V → ℝ)
    (hLI : LinearIndependent ℚ
      (fun v : graphNonRoot G =>
        graphRelativeEnergy G energy v.1)) :
    graphTemporalDimension G energy =
      Fintype.card V - Nat.card G.ConnectedComponent := by
  rw [graphTemporalDimension,
    graphTemporalModule_eq_relativeEnergyModule,
    graphRelativeEnergyModule]
  calc
    Module.finrank ℚ
        (Submodule.span ℚ
          (Set.range (fun v : graphNonRoot G =>
            graphRelativeEnergy G energy v.1))) =
        Fintype.card (graphNonRoot G) := by
      simpa using finrank_span_eq_card hLI
    _ = Fintype.card V - Nat.card G.ConnectedComponent :=
      card_graphNonRoot G

/-- A rationally independent full energy family makes every observer-visible
component-relative energy family rationally independent. -/
theorem graphRelativeEnergy_linearIndependent_of_energy
    {V : Type*} [Fintype V] (G : SimpleGraph V) (energy : V → ℝ)
    (hE : LinearIndependent ℚ energy) :
    LinearIndependent ℚ
      (fun v : graphNonRoot G =>
        graphRelativeEnergy G energy v.1) := by
  classical
  let S : Submodule ℚ ℝ := Submodule.span ℚ (Set.range energy)
  let eS : V → S := fun v =>
    ⟨energy v, Submodule.subset_span (Set.mem_range_self v)⟩
  let rel : graphNonRoot G → S := fun v =>
    eS v.1 -
      eS (graphComponentRoot G (G.connectedComponentMk v.1))
  let inc : graphNonRoot G → V →₀ ℚ := fun v =>
    Finsupp.single v.1 1 -
      Finsupp.single
        (graphComponentRoot G (G.connectedComponentMk v.1)) 1
  have hrepr (v : graphNonRoot G) :
      hE.repr (rel v) = inc v := by
    simp only [rel, inc, map_sub, eS]
    rw [hE.repr_eq_single v.1, hE.repr_eq_single
      (graphComponentRoot G (G.connectedComponentMk v.1))]
    all_goals rfl
  have hinc : LinearIndependent ℚ inc := by
    rw [Fintype.linearIndependent_iff]
    intro g hg v
    have hcoord := congrArg (fun z : V →₀ ℚ => z v.1) hg
    have hroot_ne (u : graphNonRoot G) :
        graphComponentRoot G (G.connectedComponentMk u.1) ≠ v.1 := by
      intro h
      apply v.2
      rw [IsGraphComponentRoot, ← h]
      have hcomp :
          G.connectedComponentMk
              (graphComponentRoot G
                (G.connectedComponentMk u.1)) =
            G.connectedComponentMk u.1 :=
        connectedComponentMk_graphComponentRoot G _
      rw [hcomp]
    have hinc_apply (u : graphNonRoot G) :
        inc u v.1 = if u = v then 1 else 0 := by
      by_cases huv : u = v
      · subst u
        simp [inc, hroot_ne]
      · have hcoene : u.1 ≠ v.1 := by
          intro h
          exact huv (Subtype.ext h)
        simp [inc, hroot_ne, huv, hcoene]
    simpa [hinc_apply] using hcoord
  have hrel : LinearIndependent ℚ rel := by
    apply LinearIndependent.of_comp hE.repr
    rw [show (⇑hE.repr ∘ rel) = inc by
      funext v
      exact hrepr v]
    exact hinc
  have hmapped := hrel.map' S.subtype (by simp)
  simpa only [Function.comp_apply, rel, eS, graphRelativeEnergy,
    Submodule.coe_sub] using hmapped

/-- A rationally independent full energy family simultaneously saturates
the temporal capacity of every observer graph on the system. -/
theorem graphTemporalDimension_eq_phaseCapacity_of_energy_independent
    {V : Type*} [Fintype V] (G : SimpleGraph V) (energy : V → ℝ)
    (hE : LinearIndependent ℚ energy) :
    graphTemporalDimension G energy =
      Fintype.card V - Nat.card G.ConnectedComponent :=
  graphTemporalDimension_eq_phaseCapacity_of_independent G energy
    (graphRelativeEnergy_linearIndependent_of_energy G energy hE)

/-- One fixed energy assignment realizes the maximal temporal dimension for
every possible observer graph on the same finite system. -/
theorem universalGraphTemporalDimension_eq_phaseCapacity
    {V : Type*} [Fintype V] (G : SimpleGraph V) :
    graphTemporalDimension G
        (GaloisForLFunctions.HTGeometry.rationalIndependentWeights V) =
      Fintype.card V - Nat.card G.ConnectedComponent :=
  graphTemporalDimension_eq_phaseCapacity_of_energy_independent G _
    (GaloisForLFunctions.HTGeometry.rationalIndependentWeights_linearIndependent V)

/-! ## State-generated modular temporal dimension -/

/-- Partition function of a finite real spectral potential. -/
def observerModularPartition {V : Type*} [Fintype V]
    (energy : V → ℝ) : ℝ :=
  ∑ v, Real.exp (energy v)

/-- Faithful normalized spectral weight generated by a finite real
potential. -/
def observerModularProbability {V : Type*} [Fintype V]
    (energy : V → ℝ) (v : V) : ℝ :=
  Real.exp (energy v) / observerModularPartition energy

theorem observerModularPartition_pos
    {V : Type*} [Fintype V] [Nonempty V] (energy : V → ℝ) :
    0 < observerModularPartition energy := by
  unfold observerModularPartition
  exact Finset.sum_pos
    (fun v _ => Real.exp_pos (energy v))
    Finset.univ_nonempty

/-- Every modular spectral weight is strictly positive. -/
theorem observerModularProbability_pos
    {V : Type*} [Fintype V] [Nonempty V]
    (energy : V → ℝ) (v : V) :
    0 < observerModularProbability energy v :=
  div_pos (Real.exp_pos _) (observerModularPartition_pos energy)

/-- The modular spectral weights form a probability distribution. -/
theorem sum_observerModularProbability
    {V : Type*} [Fintype V] [Nonempty V] (energy : V → ℝ) :
    ∑ v, observerModularProbability energy v = 1 := by
  unfold observerModularProbability observerModularPartition
  rw [← Finset.sum_div]
  exact div_self (ne_of_gt (observerModularPartition_pos energy))

theorem log_observerModularProbability
    {V : Type*} [Fintype V] [Nonempty V]
    (energy : V → ℝ) (v : V) :
    Real.log (observerModularProbability energy v) =
      energy v - Real.log (observerModularPartition energy) := by
  unfold observerModularProbability
  rw [Real.log_div (Real.exp_ne_zero _)
    (ne_of_gt (observerModularPartition_pos energy))]
  rw [Real.log_exp]

/-- Normalization cancels from every modular log-frequency. -/
theorem modularLogGap_eq_energyGap
    {V : Type*} [Fintype V] [Nonempty V]
    (energy : V → ℝ) (v w : V) :
    Real.log (observerModularProbability energy v) -
        Real.log (observerModularProbability energy w) =
      energy v - energy w := by
  rw [log_observerModularProbability,
    log_observerModularProbability]
  ring

/-- Temporal dimension of an observer graph under the intrinsic modular
flow generated by the faithful probability state. -/
def graphModularTemporalDimension
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) (energy : V → ℝ) : ℕ :=
  graphTemporalDimension G
    (fun v => Real.log (observerModularProbability energy v))

theorem graphVisibleGap_log_probability_eq_energy
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) (energy : V → ℝ) :
    graphVisibleGap G
        (fun v => Real.log (observerModularProbability energy v)) =
      graphVisibleGap G energy := by
  classical
  funext p
  unfold graphVisibleGap
  split_ifs
  · exact modularLogGap_eq_energyGap energy p.1 p.2
  · rfl

/-- The intrinsic modular temporal dimension of the normalized state equals
the gap dimension of its generating potential. -/
theorem graphModularTemporalDimension_eq
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) (energy : V → ℝ) :
    graphModularTemporalDimension G energy =
      graphTemporalDimension G energy := by
  have hgap :
      graphVisibleGap G
          (fun v => Real.log (observerModularProbability energy v)) =
        graphVisibleGap G energy :=
    graphVisibleGap_log_probability_eq_energy G energy
  have hmodule :
      graphTemporalModule G
          (fun v => Real.log (observerModularProbability energy v)) =
        graphTemporalModule G energy :=
    congrArg
      (fun f : V × V → ℝ => visibleFrequencyModule f) hgap
  unfold graphModularTemporalDimension graphTemporalDimension
  exact LinearEquiv.finrank_eq
    (LinearEquiv.ofEq _ _ hmodule)

/-- One fixed faithful state simultaneously realizes maximal intrinsic
modular temporal dimension for every observer graph on the system. -/
theorem universalGraphModularTemporalDimension_eq_phaseCapacity
    {V : Type*} [Fintype V] [Nonempty V] (G : SimpleGraph V) :
    graphModularTemporalDimension G
        (GaloisForLFunctions.HTGeometry.rationalIndependentWeights V) =
      Fintype.card V - Nat.card G.ConnectedComponent := by
  rw [graphModularTemporalDimension_eq]
  exact universalGraphTemporalDimension_eq_phaseCapacity G

/-! ## Arbitrary observer spectral measures -/

/-- Physical spectral phase at time `t` and frequency `x`. -/
def observerSpectralPhase (t x : ℝ) : ℂ :=
  Complex.exp (((t * x : ℝ) : ℂ) * Complex.I)

/-- Observer spectral phase is continuous in frequency. -/
theorem observerSpectralPhase_continuous (t : ℝ) :
    Continuous (observerSpectralPhase t) := by
  unfold observerSpectralPhase
  fun_prop

/-- A physical spectral phase is one exactly on the corresponding
frequency lattice. -/
theorem observerSpectralPhase_eq_one_iff_mem_zmultiples
    {t x : ℝ} (ht : t ≠ 0) :
    observerSpectralPhase t x = 1 ↔
      x ∈ AddSubgroup.zmultiples (2 * Real.pi / t) := by
  constructor
  · intro h
    obtain ⟨n, hn⟩ := Complex.exp_eq_one_iff.mp h
    have hreal : t * x = 2 * Real.pi * n := by
      have him := congrArg Complex.im hn
      calc
        t * x = (n : ℝ) * (2 * Real.pi) := by
          simpa [observerSpectralPhase] using him
        _ = 2 * Real.pi * n := by ring
    rw [AddSubgroup.mem_zmultiples_iff]
    refine ⟨n, ?_⟩
    rw [zsmul_eq_mul]
    calc
      (n : ℝ) * (2 * Real.pi / t) =
          (2 * Real.pi * n) / t := by ring
      _ = (t * x) / t := by rw [hreal]
      _ = x := by field_simp
  · intro h
    rw [AddSubgroup.mem_zmultiples_iff] at h
    obtain ⟨n, rfl⟩ := h
    have htx :
        t * ((n : ℤ) • (2 * Real.pi / t)) =
          (n : ℝ) * (2 * Real.pi) := by
      rw [zsmul_eq_mul]
      field_simp
    rw [observerSpectralPhase, htx]
    convert Complex.exp_int_mul_two_pi_mul_I n using 1
    push_cast
    ring_nf

/-! ## Exact finite modular flow -/

/-- Matrix-entry phase of the intrinsic modular flow generated by the
faithful normalized state. -/
def observerModularPhase
    {V : Type*} [Fintype V] [Nonempty V]
    (energy : V → ℝ) (t : ℝ) (i j : V) : ℂ :=
  observerSpectralPhase t
    (Real.log (observerModularProbability energy i) -
      Real.log (observerModularProbability energy j))

/-- Modular phase is exactly the phase of the generating potential gap. -/
theorem observerModularPhase_eq_energyGap
    {V : Type*} [Fintype V] [Nonempty V]
    (energy : V → ℝ) (t : ℝ) (i j : V) :
    observerModularPhase energy t i j =
      observerSpectralPhase t (energy i - energy j) := by
  rw [observerModularPhase, modularLogGap_eq_energyGap]

/-- Modular phases obey the index cocycle law. -/
theorem observerModularPhase_cocycle
    {V : Type*} [Fintype V] [Nonempty V]
    (energy : V → ℝ) (t : ℝ) (i j k : V) :
    observerModularPhase energy t i k *
        observerModularPhase energy t k j =
      observerModularPhase energy t i j := by
  simp only [observerModularPhase_eq_energyGap,
    observerSpectralPhase]
  rw [← Complex.exp_add]
  congr 1
  push_cast
  ring

/-- Modular phases compose additively in time. -/
theorem observerModularPhase_add
    {V : Type*} [Fintype V] [Nonempty V]
    (energy : V → ℝ) (s t : ℝ) (i j : V) :
    observerModularPhase energy (s + t) i j =
      observerModularPhase energy s i j *
        observerModularPhase energy t i j := by
  simp only [observerModularPhase_eq_energyGap,
    observerSpectralPhase]
  rw [← Complex.exp_add]
  congr 1
  push_cast
  ring

/-- Intrinsic modular flow on a finite matrix observable algebra. -/
def finiteObserverModularFlow
    {V : Type*} [Fintype V] [Nonempty V]
    (energy : V → ℝ) (t : ℝ) (B : Matrix V V ℂ) :
    Matrix V V ℂ :=
  fun i j => observerModularPhase energy t i j * B i j

@[simp] theorem finiteObserverModularFlow_zero
    {V : Type*} [Fintype V] [Nonempty V]
    (energy : V → ℝ) (B : Matrix V V ℂ) :
    finiteObserverModularFlow energy 0 B = B := by
  ext i j
  simp [finiteObserverModularFlow, observerModularPhase,
    observerSpectralPhase]

/-- The state-generated modular maps form an exact one-parameter flow. -/
theorem finiteObserverModularFlow_add
    {V : Type*} [Fintype V] [Nonempty V]
    (energy : V → ℝ) (s t : ℝ) (B : Matrix V V ℂ) :
    finiteObserverModularFlow energy (s + t) B =
      finiteObserverModularFlow energy s
        (finiteObserverModularFlow energy t B) := by
  ext i j
  rw [finiteObserverModularFlow, finiteObserverModularFlow,
    finiteObserverModularFlow, observerModularPhase_add]
  ring

/-- Every modular-flow map is invertible, with inverse time `-t`. -/
theorem finiteObserverModularFlow_neg_apply
    {V : Type*} [Fintype V] [Nonempty V]
    (energy : V → ℝ) (t : ℝ) (B : Matrix V V ℂ) :
    finiteObserverModularFlow energy (-t)
        (finiteObserverModularFlow energy t B) = B := by
  rw [← finiteObserverModularFlow_add, neg_add_cancel,
    finiteObserverModularFlow_zero]

/-- Each modular-flow map preserves matrix multiplication. -/
theorem finiteObserverModularFlow_mul
    {V : Type*} [Fintype V] [Nonempty V]
    (energy : V → ℝ) (t : ℝ) (A B : Matrix V V ℂ) :
    finiteObserverModularFlow energy t (A * B) =
      finiteObserverModularFlow energy t A *
        finiteObserverModularFlow energy t B := by
  classical
  ext i j
  simp only [finiteObserverModularFlow, Matrix.mul_apply]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro k _
  rw [← observerModularPhase_cocycle energy t i j k]
  ring

/-- Identity matrix, written without imposing a global decidable-equality
instance on the sector type. -/
def finiteObserverIdentity {V : Type*} : Matrix V V ℂ :=
  by
    classical
    exact fun i j => if i = j then 1 else 0

/-- The modular flow fixes the identity observable. -/
@[simp] theorem finiteObserverModularFlow_one
    {V : Type*} [Fintype V] [Nonempty V]
    (energy : V → ℝ) (t : ℝ) :
    finiteObserverModularFlow energy t
        (finiteObserverIdentity : Matrix V V ℂ) =
      finiteObserverIdentity := by
  classical
  ext i j
  by_cases hij : i = j
  · subst j
    simp [finiteObserverModularFlow, finiteObserverIdentity,
      observerModularPhase, observerSpectralPhase]
  · simp [finiteObserverModularFlow, finiteObserverIdentity, hij]

namespace SpectralMemory

/-- Additive group generated by the topological support of an arbitrary
positive observer spectral measure. -/
def measureVisibleFrequencyGroup (mu : MeasureTheory.Measure ℝ) :
    AddSubgroup ℝ :=
  AddSubgroup.closure mu.support

/-- Rational module generated by the support of an arbitrary observer
spectral measure. -/
def measureVisibleFrequencyModule (mu : MeasureTheory.Measure ℝ) :
    Submodule ℚ ℝ :=
  Submodule.span ℚ mu.support

/-- Cardinal-valued temporal dimension of an arbitrary observer spectral
measure. -/
def measureTemporalDimension (mu : MeasureTheory.Measure ℝ) :
    Cardinal :=
  Module.rank ℚ (measureVisibleFrequencyModule mu)

/-- Exact observer return means phase one almost everywhere in the observer
spectral measure. -/
def measureExactReturn
    (mu : MeasureTheory.Measure ℝ) (t : ℝ) : Prop :=
  observerSpectralPhase t =ᵐ[mu] fun _ => 1

/-- Squared observer displacement integrated against a finite spectral
measure. -/
def measureObserverDisplacementSq
    (mu : MeasureTheory.Measure ℝ) (t : ℝ) : ℝ :=
  ∫ x, ‖observerSpectralPhase t x - 1‖ ^ 2 ∂mu

/-- The squared spectral displacement is integrable for every finite
observer spectral measure. -/
theorem integrable_measureObserverDisplacementSq_integrand
    (mu : MeasureTheory.Measure ℝ) [MeasureTheory.IsFiniteMeasure mu]
    (t : ℝ) :
    MeasureTheory.Integrable
      (fun x => ‖observerSpectralPhase t x - 1‖ ^ 2) mu := by
  refine (MeasureTheory.integrable_const (4 : ℝ)).mono' ?_ ?_
  · exact
      (((observerSpectralPhase_continuous t).sub
        continuous_const).norm.pow 2).aestronglyMeasurable
  · filter_upwards with x
    have hnorm : ‖observerSpectralPhase t x‖ = 1 := by
      exact Complex.norm_exp_ofReal_mul_I (t * x)
    have htri : ‖observerSpectralPhase t x - 1‖ ≤ 2 := by
      calc
        ‖observerSpectralPhase t x - 1‖ ≤
            ‖observerSpectralPhase t x‖ + ‖(1 : ℂ)‖ :=
          norm_sub_le _ _
        _ = 2 := by rw [hnorm]; norm_num
    have hsq : ‖observerSpectralPhase t x - 1‖ ^ 2 ≤ 4 := by
      have hs :=
        (sq_le_sq₀ (norm_nonneg (observerSpectralPhase t x - 1))
          (by norm_num : (0 : ℝ) ≤ 2)).2 htri
      norm_num at hs ⊢
      exact hs
    change ‖(‖observerSpectralPhase t x - 1‖ ^ 2 : ℝ)‖ ≤ 4
    rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
    exact hsq

/-- An observer's integrated displacement vanishes exactly at its
measure-theoretic exact returns. -/
theorem measureObserverDisplacementSq_eq_zero_iff
    (mu : MeasureTheory.Measure ℝ) [MeasureTheory.IsFiniteMeasure mu]
    (t : ℝ) :
    measureObserverDisplacementSq mu t = 0 ↔
      measureExactReturn mu t := by
  rw [measureObserverDisplacementSq, measureExactReturn,
    MeasureTheory.integral_eq_zero_iff_of_nonneg
      (fun _ => sq_nonneg _)
      (integrable_measureObserverDisplacementSq_integrand mu t)]
  constructor
  · intro h
    filter_upwards [h] with x hx
    exact sub_eq_zero.mp (norm_eq_zero.mp (sq_eq_zero_iff.mp hx))
  · intro h
    filter_upwards [h] with x hx
    simp [hx]

/-- Almost-everywhere exact return is equivalent to phase locking at every
point of the spectral support. -/
theorem measureExactReturn_iff_support
    (mu : MeasureTheory.Measure ℝ) (t : ℝ) :
    measureExactReturn mu t ↔
      ∀ x ∈ mu.support, observerSpectralPhase t x = 1 := by
  constructor
  · intro h
    have hclosed :
        IsClosed {x : ℝ | observerSpectralPhase t x = 1} :=
      isClosed_eq (observerSpectralPhase_continuous t) continuous_const
    exact MeasureTheory.Measure.support_subset_of_isClosed hclosed h
  · intro h
    filter_upwards
      [MeasureTheory.Measure.support_mem_ae (μ := mu)] with x hx
    exact h x hx

/-- Exact return of an arbitrary spectral measure is equivalent to
containment of its full visible group in one return lattice. -/
theorem measureExactReturn_iff_group_le_zmultiples
    (mu : MeasureTheory.Measure ℝ) {t : ℝ} (ht : t ≠ 0) :
    measureExactReturn mu t ↔
      measureVisibleFrequencyGroup mu ≤
        AddSubgroup.zmultiples (2 * Real.pi / t) := by
  rw [measureExactReturn_iff_support, measureVisibleFrequencyGroup,
    AddSubgroup.closure_le]
  exact forall_congr' fun x =>
    imp_congr_right fun _ =>
      observerSpectralPhase_eq_one_iff_mem_zmultiples ht

/-- Measure temporal dimension is zero exactly when its visible frequency
group is trivial. -/
theorem measureTemporalDimension_eq_zero_iff_group_eq_bot
    (mu : MeasureTheory.Measure ℝ) :
    measureTemporalDimension mu = 0 ↔
      measureVisibleFrequencyGroup mu = ⊥ := by
  rw [measureTemporalDimension, measureVisibleFrequencyModule,
    Submodule.rank_eq_zero, Submodule.span_eq_bot,
    measureVisibleFrequencyGroup, AddSubgroup.closure_eq_bot_iff]
  simp

/-- Every observer spectral measure has an exclusively dense or cyclic
visible frequency group. -/
theorem measureVisibleFrequencyGroup_dense_xor_cyclic
    (mu : MeasureTheory.Measure ℝ) :
    Xor (Dense (measureVisibleFrequencyGroup mu : Set ℝ))
      (∃ omega : ℝ,
        measureVisibleFrequencyGroup mu =
          AddSubgroup.zmultiples omega) :=
  AddSubgroup.dense_xor_cyclic (measureVisibleFrequencyGroup mu)

/-- An arbitrary observer spectral measure has a positive exact return if and
only if its visible frequency group is cyclic. -/
theorem exists_positive_measureExactReturn_iff_cyclic
    (mu : MeasureTheory.Measure ℝ) :
    (∃ t : ℝ, 0 < t ∧ measureExactReturn mu t) ↔
      ∃ omega : ℝ,
        measureVisibleFrequencyGroup mu =
          AddSubgroup.zmultiples omega := by
  constructor
  · rintro ⟨t, ht, hret⟩
    have hle :
        measureVisibleFrequencyGroup mu ≤
          AddSubgroup.zmultiples (2 * Real.pi / t) :=
      (measureExactReturn_iff_group_le_zmultiples
        mu ht.ne').mp hret
    obtain ⟨n, hn⟩ :=
      (AddSubgroup.le_zmultiples_iff
        (2 * Real.pi / t) (measureVisibleFrequencyGroup mu)).mp hle
    exact ⟨n • (2 * Real.pi / t), hn⟩
  · rintro ⟨omega, hgroup⟩
    by_cases homega : omega = 0
    · refine ⟨1, by norm_num, ?_⟩
      rw [measureExactReturn_iff_group_le_zmultiples
        mu one_ne_zero, hgroup, homega]
      simp
    · let t : ℝ := 2 * Real.pi / |omega|
      have ht : 0 < t := by
        dsimp [t]
        positivity
      refine ⟨t, ht, ?_⟩
      rw [measureExactReturn_iff_group_le_zmultiples
        mu ht.ne', hgroup]
      have hscale : 2 * Real.pi / t = |omega| := by
        dsimp [t]
        field_simp
      rw [hscale]
      by_cases hpos : 0 < omega
      · rw [abs_of_pos hpos]
      · rw [abs_of_nonpos (le_of_not_gt hpos)]
        intro x hx
        rw [AddSubgroup.mem_zmultiples_iff] at hx ⊢
        obtain ⟨n, rfl⟩ := hx
        exact ⟨-n, by simp⟩

/-- Support inclusion makes temporal dimension monotone. -/
theorem measureTemporalDimension_mono_of_support_subset
    {mu nu : MeasureTheory.Measure ℝ}
    (h : mu.support ⊆ nu.support) :
    measureTemporalDimension mu ≤ measureTemporalDimension nu :=
  Submodule.rank_mono (Submodule.span_mono h)

/-- Absolute continuity of observer spectral measures makes temporal
dimension monotone. -/
theorem measureTemporalDimension_mono_of_absolutelyContinuous
    {mu nu : MeasureTheory.Measure ℝ} (h : mu ≪ nu) :
    measureTemporalDimension mu ≤ measureTemporalDimension nu :=
  measureTemporalDimension_mono_of_support_subset h.support_mono

end SpectralMemory

/-! ## Universal spectral return-density law -/

open Filter MeasureTheory Set
open scoped Topology

/-- **Complete operational spectral identification.** Equality of every
time-labelled return amplitude determines the full finite real spectral
measure exactly. -/
theorem spectralMeasure_eq_of_all_returnAmplitudes_eq
    (mu nu : Measure ℝ)
    [IsFiniteMeasure mu] [IsFiniteMeasure nu]
    (hreturn : ∀ t : ℝ, charFun mu t = charFun nu t) :
    mu = nu :=
  Measure.ext_of_charFun (funext hreturn)

/-- Atomic versus atomless spectral type is fixed by the complete
time-labelled return record. -/
theorem noAtoms_iff_of_all_returnAmplitudes_eq
    (mu nu : Measure ℝ)
    [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hreturn : ∀ t : ℝ, charFun mu t = charFun nu t) :
    NoAtoms mu ↔ NoAtoms nu := by
  rw [spectralMeasure_eq_of_all_returnAmplitudes_eq mu nu hreturn]

/-- Away from zero frequency, the rescaled sinc kernel vanishes at large
positive time. -/
lemma tendsto_sinc_mul_atTop (x : ℝ) (hx : x ≠ 0) :
    Tendsto (fun r : ℝ ↦ Real.sinc (r * x)) atTop (𝓝 0) := by
  rw [tendsto_zero_iff_norm_tendsto_zero]
  refine squeeze_zero' (g := fun r ↦ |r * x|⁻¹)
    (Eventually.of_forall fun r ↦ norm_nonneg _) ?_ ?_
  · filter_upwards [eventually_gt_atTop (0 : ℝ)] with r hr
    rw [Real.norm_eq_abs, Real.sinc_of_ne_zero (mul_ne_zero hr.ne' hx), abs_div]
    rw [div_eq_mul_inv]
    simpa using mul_le_mul_of_nonneg_right (Real.abs_sin_le_one (r * x))
      (inv_nonneg.mpr (abs_nonneg (r * x)))
  · have h :=
      (tendsto_inv_atTop_zero : Tendsto (fun r : ℝ ↦ r⁻¹) atTop (𝓝 0)).const_mul |x|⁻¹
    have heq : (fun r : ℝ ↦ |x|⁻¹ * r⁻¹) =ᶠ[atTop] fun r ↦ |r * x|⁻¹ := by
      filter_upwards [eventually_gt_atTop (0 : ℝ)] with r hr
      rw [abs_mul, abs_of_pos hr, mul_inv_rev]
    simpa using h.congr' heq

/-- For every finite measure, the integrated rescaled sinc kernel converges
exactly to the real mass at zero. -/
lemma tendsto_integral_sinc_mul {nu : Measure ℝ} [IsFiniteMeasure nu] :
    Tendsto (fun r : ℝ ↦ ∫ x, Real.sinc (r * x) ∂nu) atTop
      (𝓝 (nu.real {0})) := by
  have h := tendsto_integral_filter_of_dominated_convergence
    (μ := nu) (F := fun r x ↦ Real.sinc (r * x))
    (f := Set.indicator ({0} : Set ℝ) fun _ ↦ (1 : ℝ)) (fun _ ↦ (1 : ℝ))
    (Eventually.of_forall fun _ ↦ by fun_prop)
    (Eventually.of_forall fun _ ↦ ae_of_all _ fun x ↦ by
      rw [Real.norm_eq_abs]
      exact Real.abs_sinc_le_one _)
    (integrable_const 1)
    (ae_of_all _ fun x ↦ by
      by_cases hx : x = 0
      · subst x
        convert (tendsto_const_nhds :
          Tendsto (fun _ : ℝ ↦ (1 : ℝ)) atTop (𝓝 1)) using 1 <;> simp
      · simpa [hx] using tendsto_sinc_mul_atTop x hx)
  have hi :
      (∫ x, Set.indicator ({0} : Set ℝ) (fun _ ↦ (1 : ℝ)) x ∂nu) =
        nu.real {0} := by
    simpa only [Pi.one_apply] using
      (integral_indicator_one (μ := nu) (s := ({0} : Set ℝ))
        (measurableSet_singleton 0))
  convert h using 1
  rw [hi]

/-- Complex-valued version of the integrated sinc limit. -/
lemma tendsto_integral_complex_sinc_mul
    {nu : Measure ℝ} [IsFiniteMeasure nu] :
    Tendsto (fun r : ℝ ↦ ∫ x, (Real.sinc (r * x) : ℂ) ∂nu) atTop
      (𝓝 (nu.real {0} : ℂ)) := by
  have h := (Complex.continuous_ofReal.tendsto (nu.real {0})).comp
    (tendsto_integral_sinc_mul (nu := nu))
  simpa only [Function.comp_apply, integral_complex_ofReal] using h

/-- Distribution of the difference of two independent samples from the same
spectral measure. -/
noncomputable def spectralDifferenceMeasure (mu : Measure ℝ) : Measure ℝ :=
  (mu.prod mu).map fun p ↦ p.1 - p.2

noncomputable instance spectralDifferenceMeasure.instIsProbabilityMeasure
    (mu : Measure ℝ) [IsProbabilityMeasure mu] :
    IsProbabilityMeasure (spectralDifferenceMeasure mu) :=
  Measure.isProbabilityMeasure_map (by fun_prop)

/-- Characteristic function of the spectral-difference distribution is
exactly the survival fidelity. -/
lemma charFun_spectralDifferenceMeasure
    (mu : Measure ℝ) [IsProbabilityMeasure mu] (t : ℝ) :
    charFun (spectralDifferenceMeasure mu) t =
      (Complex.normSq (charFun mu t) : ℂ) := by
  rw [spectralDifferenceMeasure, charFun_apply_real,
    integral_map (by fun_prop) (by fun_prop)]
  have hfun :
      (fun p : ℝ × ℝ ↦
        Complex.exp ((t : ℂ) * ((p.1 - p.2 : ℝ) : ℂ) * Complex.I)) =
        fun p ↦ Complex.exp (t * p.1 * Complex.I) *
          Complex.exp ((-t) * p.2 * Complex.I) := by
    funext p
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  rw [hfun]
  calc
    (∫ p : ℝ × ℝ, Complex.exp (t * p.1 * Complex.I) *
        Complex.exp ((-t) * p.2 * Complex.I) ∂mu.prod mu) =
        (∫ x : ℝ, Complex.exp (t * x * Complex.I) ∂mu) *
          ∫ y : ℝ, Complex.exp ((-t) * y * Complex.I) ∂mu :=
      integral_prod_mul (μ := mu) (ν := mu)
        (fun x : ℝ ↦ Complex.exp (t * x * Complex.I))
        (fun y : ℝ ↦ Complex.exp ((-t) * y * Complex.I))
    _ = charFun mu t * charFun mu (-t) := by
      rw [charFun_apply_real, charFun_apply_real]
      congr 2 with y
      push_cast
      rfl
    _ = (Complex.normSq (charFun mu t) : ℂ) := by
      rw [charFun_neg]
      exact Complex.mul_conj _

/-- Zero difference is exactly equality of two independent spectral
samples. -/
lemma spectralDifferenceMeasure_singleton_zero (mu : Measure ℝ) :
    spectralDifferenceMeasure mu {0} = mu.prod mu (diagonal ℝ) := by
  rw [spectralDifferenceMeasure,
    Measure.map_apply (by fun_prop) (measurableSet_singleton 0)]
  congr 1
  ext p
  simp [sub_eq_zero]

/-- Atomless spectra have zero spectral collision mass. -/
lemma spectralDifferenceMeasure_singleton_zero_of_noAtoms
    (mu : Measure ℝ) [IsFiniteMeasure mu] [NoAtoms mu] :
    spectralDifferenceMeasure mu {0} = 0 := by
  rw [spectralDifferenceMeasure_singleton_zero,
    Measure.prod_apply measurableSet_diagonal]
  have hfiber (x : ℝ) : Prod.mk x ⁻¹' diagonal ℝ = {x} := by
    ext y
    simp [eq_comm]
  simp_rw [hfiber, measure_singleton]
  exact lintegral_zero

/-- For finite real spectral measures, vanishing collision mass is
equivalent to absence of atoms. -/
theorem spectralDifferenceMeasure_singleton_zero_iff_noAtoms
    (mu : Measure ℝ) [IsFiniteMeasure mu] :
    spectralDifferenceMeasure mu {0} = 0 ↔ NoAtoms mu := by
  constructor
  · intro hzero
    rw [spectralDifferenceMeasure_singleton_zero] at hzero
    constructor
    intro x
    have hsubset : ({x} ×ˢ {x} : Set (ℝ × ℝ)) ⊆ diagonal ℝ := by
      rintro ⟨a, b⟩ ⟨ha, hb⟩
      simp_all
    have hprod : mu.prod mu ({x} ×ˢ {x}) = 0 :=
      nonpos_iff_eq_zero.mp <| (measure_mono hsubset).trans_eq hzero
    rw [Measure.prod_prod] at hprod
    exact mul_self_eq_zero.mp hprod
  · intro h
    letI : NoAtoms mu := h
    exact spectralDifferenceMeasure_singleton_zero_of_noAtoms mu

/-- Symmetric-window normalized mean survival fidelity, as a complex
quantity. -/
noncomputable def spectralReturnMean (mu : Measure ℝ) (r : ℝ) : ℂ :=
  ((2 * r : ℝ) : ℂ)⁻¹ *
    ∫ t in -r..r, (Complex.normSq (charFun mu t) : ℂ)

/-- Symmetric-window normalized mean survival fidelity. -/
noncomputable def spectralReturnMeanReal (mu : Measure ℝ) (r : ℝ) : ℝ :=
  (2 * r)⁻¹ * ∫ t in -r..r, Complex.normSq (charFun mu t)

lemma spectralReturnMean_eq_ofReal (mu : Measure ℝ) (r : ℝ) :
    spectralReturnMean mu r = (spectralReturnMeanReal mu r : ℂ) := by
  rw [spectralReturnMean, spectralReturnMeanReal,
    intervalIntegral.integral_ofReal]
  push_cast
  rfl

/-- At every positive window radius, normalized mean fidelity is the sinc
average of the difference distribution. -/
lemma spectralReturnMean_eq_integral_sinc
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {r : ℝ} (hr : 0 < r) :
    spectralReturnMean mu r =
      ∫ x, (Real.sinc (r * x) : ℂ) ∂spectralDifferenceMeasure mu := by
  rw [spectralReturnMean]
  simp_rw [← charFun_spectralDifferenceMeasure mu]
  rw [integral_charFun_Icc hr]
  have hne : ((2 * r : ℝ) : ℂ) ≠ 0 := by
    norm_cast
    positivity
  rw [integral_complex_ofReal]
  have hcast : (2 : ℂ) * (r : ℂ) = ((2 * r : ℝ) : ℂ) := by
    norm_num
  rw [hcast]
  rw [← mul_assoc, inv_mul_cancel₀ hne, one_mul]

/-- Universal return law: for every probability spectral measure, normalized
mean survival fidelity converges exactly to spectral collision mass. -/
theorem spectralReturnMean_tendsto_collision
    (mu : Measure ℝ) [IsProbabilityMeasure mu] :
    Tendsto (spectralReturnMean mu) atTop
      (𝓝 ((spectralDifferenceMeasure mu).real {0} : ℂ)) := by
  have h :=
    tendsto_integral_complex_sinc_mul
      (nu := spectralDifferenceMeasure mu)
  apply h.congr'
  filter_upwards [eventually_gt_atTop (0 : ℝ)] with r hr
  exact (spectralReturnMean_eq_integral_sinc mu hr).symm

/-- Real form of the universal mean-return law. -/
theorem spectralReturnMeanReal_tendsto_collision
    (mu : Measure ℝ) [IsProbabilityMeasure mu] :
    Tendsto (spectralReturnMeanReal mu) atTop
      (𝓝 ((spectralDifferenceMeasure mu).real {0})) := by
  have h := (Complex.continuous_re.tendsto
    ((spectralDifferenceMeasure mu).real {0} : ℂ)).comp
      (spectralReturnMean_tendsto_collision mu)
  have heq :
      Complex.re ∘ spectralReturnMean mu =
        spectralReturnMeanReal mu := by
    funext r
    rw [Function.comp_apply, spectralReturnMean_eq_ofReal,
      Complex.ofReal_re]
  rwa [heq] at h

/-- Every atomless probability spectrum has vanishing normalized mean
fidelity, without any absolute-continuity assumption. -/
theorem spectralReturnMean_tendsto_zero_of_noAtoms
    (mu : Measure ℝ) [IsProbabilityMeasure mu] [NoAtoms mu] :
    Tendsto (spectralReturnMean mu) atTop (𝓝 0) := by
  have h := spectralReturnMean_tendsto_collision mu
  have hzero : (spectralDifferenceMeasure mu).real {0} = 0 := by
    rw [Measure.real,
      spectralDifferenceMeasure_singleton_zero_of_noAtoms mu]
    simp
  simpa [hzero] using h

/-- Real form of atomless mean-fidelity escape. -/
theorem spectralReturnMeanReal_tendsto_zero_of_noAtoms
    (mu : Measure ℝ) [IsProbabilityMeasure mu] [NoAtoms mu] :
    Tendsto (spectralReturnMeanReal mu) atTop (𝓝 0) := by
  have h := spectralReturnMeanReal_tendsto_collision mu
  have hzero : (spectralDifferenceMeasure mu).real {0} = 0 := by
    rw [Measure.real,
      spectralDifferenceMeasure_singleton_zero_of_noAtoms mu]
    simp
  simpa [hzero] using h

/-- Times at which survival fidelity reaches a prescribed threshold. -/
def highFidelityTimes (mu : Measure ℝ) (eta : ℝ) : Set ℝ :=
  {t | eta ≤ Complex.normSq (charFun mu t)}

/-- Fraction of the symmetric time window on which fidelity reaches the
threshold. -/
noncomputable def highFidelityWindowDensity
    (mu : Measure ℝ) (eta r : ℝ) : ℝ :=
  (2 * r)⁻¹ *
    volume.real (highFidelityTimes mu eta ∩ Ioc (-r) r)

/-- Complete return records determine temporal dimension, collision mass,
and every finite-window high-fidelity density simultaneously. -/
theorem temporalData_eq_of_all_returnAmplitudes_eq
    (mu nu : Measure ℝ)
    [IsProbabilityMeasure mu] [IsProbabilityMeasure nu]
    (hreturn : ∀ t : ℝ, charFun mu t = charFun nu t) :
    SpectralMemory.measureTemporalDimension mu =
        SpectralMemory.measureTemporalDimension nu ∧
      spectralDifferenceMeasure mu {0} =
        spectralDifferenceMeasure nu {0} ∧
      (∀ eta r : ℝ,
        highFidelityWindowDensity mu eta r =
          highFidelityWindowDensity nu eta r) := by
  have hmeasure :=
    spectralMeasure_eq_of_all_returnAmplitudes_eq mu nu hreturn
  subst nu
  exact ⟨rfl, rfl, fun _ _ => rfl⟩

lemma measurableSet_highFidelityTimes
    (mu : Measure ℝ) [IsFiniteMeasure mu] (eta : ℝ) :
    MeasurableSet (highFidelityTimes mu eta) := by
  exact measurableSet_le measurable_const
    (Complex.continuous_normSq.measurable.comp measurable_charFun)

/-- Markov bound relating high-fidelity time volume to integrated
fidelity. -/
lemma highFidelity_window_markov
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {eta r : ℝ} (hr : 0 < r) :
    eta * volume.real (highFidelityTimes mu eta ∩ Ioc (-r) r) ≤
      ∫ t in -r..r, Complex.normSq (charFun mu t) := by
  let f : ℝ → ℝ := fun t ↦ Complex.normSq (charFun mu t)
  have hf_meas : Measurable f :=
    Complex.continuous_normSq.measurable.comp measurable_charFun
  have hf_nonneg :
      ∀ᵐ t ∂volume.restrict (Ioc (-r) r), 0 ≤ f t :=
    ae_of_all _ fun t ↦ Complex.normSq_nonneg _
  have hf_interval : IntervalIntegrable f volume (-r) r := by
    refine (intervalIntegrable_const (μ := volume) (a := -r) (b := r)
      (c := (1 : ℝ))).mono_fun'
        hf_meas.aestronglyMeasurable.restrict ?_
    exact ae_of_all _ fun t ↦ by
      change |Complex.normSq (charFun mu t)| ≤ 1
      rw [abs_of_nonneg (Complex.normSq_nonneg _),
        Complex.normSq_eq_norm_sq]
      nlinarith [norm_nonneg (charFun mu t),
        norm_charFun_le_one (μ := mu) t]
  have hmark := mul_meas_ge_le_integral_of_nonneg
    (μ := volume.restrict (Ioc (-r) r))
      hf_nonneg hf_interval.1 eta
  change
    eta * (volume.restrict (Ioc (-r) r)).real
      (highFidelityTimes mu eta) ≤
        ∫ t in Ioc (-r) r,
          Complex.normSq (charFun mu t) at hmark
  rw [measureReal_restrict_apply
    (measurableSet_highFidelityTimes mu eta)] at hmark
  simpa only [intervalIntegral.integral_of_le
    (neg_le_self hr.le)] using hmark

lemma highFidelityWindowDensity_nonneg
    (mu : Measure ℝ) {eta r : ℝ} (hr : 0 < r) :
    0 ≤ highFidelityWindowDensity mu eta r := by
  exact mul_nonneg (inv_nonneg.mpr (by positivity))
    measureReal_nonneg

/-- High-fidelity time density is bounded by mean fidelity divided by the
threshold. -/
lemma highFidelityWindowDensity_le_mean_div
    (mu : Measure ℝ) [IsProbabilityMeasure mu] {eta r : ℝ}
    (heta : 0 < eta) (hr : 0 < r) :
    highFidelityWindowDensity mu eta r ≤
      spectralReturnMeanReal mu r / eta := by
  have hm :=
    highFidelity_window_markov mu (eta := eta) (r := r) hr
  rw [highFidelityWindowDensity, spectralReturnMeanReal,
    div_eq_mul_inv]
  have hscale : 0 ≤ (2 * r)⁻¹ :=
    inv_nonneg.mpr (by positivity)
  calc
    (2 * r)⁻¹ *
        volume.real (highFidelityTimes mu eta ∩ Ioc (-r) r)
        ≤ (2 * r)⁻¹ *
            ((∫ t in -r..r,
              Complex.normSq (charFun mu t)) / eta) := by
          gcongr
          exact (le_div_iff₀ heta).2
            (by simpa [mul_comm] using hm)
    _ = ((2 * r)⁻¹ *
          ∫ t in -r..r, Complex.normSq (charFun mu t)) *
            eta⁻¹ := by
      ring

/-- For every atomless spectrum—including singular-continuous spectra—the
time density of every fixed positive-fidelity return threshold vanishes. -/
theorem highFidelityWindowDensity_tendsto_zero_of_noAtoms
    (mu : Measure ℝ) [IsProbabilityMeasure mu] [NoAtoms mu]
    {eta : ℝ} (heta : 0 < eta) :
    Tendsto (highFidelityWindowDensity mu eta) atTop (𝓝 0) := by
  refine squeeze_zero'
    (g := fun r ↦ spectralReturnMeanReal mu r / eta) ?_ ?_ ?_
  · filter_upwards [eventually_gt_atTop (0 : ℝ)] with r hr
    exact highFidelityWindowDensity_nonneg mu hr
  · filter_upwards [eventually_gt_atTop (0 : ℝ)] with r hr
    exact highFidelityWindowDensity_le_mean_div mu heta hr
  · simpa using
      (spectralReturnMeanReal_tendsto_zero_of_noAtoms mu).div_const eta

/-- For every mixed spectrum, collision mass gives the universal
asymptotic upper budget for high-fidelity return-time density. -/
theorem highFidelityWindowDensity_eventually_lt_collision_add
    (mu : Measure ℝ) [IsProbabilityMeasure mu]
    {eta delta : ℝ} (heta : 0 < eta) (hdelta : 0 < delta) :
    ∀ᶠ r in atTop,
      highFidelityWindowDensity mu eta r <
        ((spectralDifferenceMeasure mu).real {0} + delta) / eta := by
  have hmean := spectralReturnMeanReal_tendsto_collision mu
  have hevent :
      ∀ᶠ r in atTop,
        spectralReturnMeanReal mu r <
          (spectralDifferenceMeasure mu).real {0} + delta :=
    (tendsto_order.1 hmean).2 _
      (lt_add_of_pos_right _ hdelta)
  filter_upwards
    [hevent, eventually_gt_atTop (0 : ℝ)]
      with r hmean_lt hr
  exact
    (highFidelityWindowDensity_le_mean_div
      mu heta hr).trans_lt
        (div_lt_div_of_pos_right hmean_lt heta)

/-! ## A bounded-below continuous-spectrum nonreturn law -/

open Complex MeasureTheory Set Filter
open scoped Topology FourierTransform Real

/-! ### Universal absolutely-continuous spectral escape -/

/-- Fourier survival amplitude of a real absolutely continuous observer
spectral density. -/
def absolutelyContinuousObserverAmplitude
    (density : ℝ → ℝ) (t : ℝ) : ℂ :=
  𝓕 (fun x => (density x : ℂ)) t

/-- Return fidelity of an absolutely continuous observer spectral density. -/
def absolutelyContinuousObserverFidelity
    (density : ℝ → ℝ) (t : ℝ) : ℝ :=
  Complex.normSq (absolutelyContinuousObserverAmplitude density t)

/-- Every absolutely continuous spectral amplitude vanishes at frequency
infinity. -/
theorem absolutelyContinuousObserverAmplitude_tendsto_zero_cocompact
    (density : ℝ → ℝ) :
    Tendsto (absolutelyContinuousObserverAmplitude density)
      (cocompact ℝ) (𝓝 0) := by
  exact Real.zero_at_infty_fourier
    (fun x => (density x : ℂ))

/-- Every absolutely continuous observer return fidelity vanishes along both
temporal rays. -/
theorem absolutelyContinuousObserverFidelity_tendsto_zero_cocompact
    (density : ℝ → ℝ) :
    Tendsto (absolutelyContinuousObserverFidelity density)
      (cocompact ℝ) (𝓝 0) := by
  have hnorm :
      Tendsto
        (fun t => ‖absolutelyContinuousObserverAmplitude density t‖)
        (cocompact ℝ) (𝓝 0) := by
    simpa using
      (absolutelyContinuousObserverAmplitude_tendsto_zero_cocompact
        density).norm
  have hsq := hnorm.pow 2
  simpa [absolutelyContinuousObserverFidelity,
    Complex.sq_norm] using hsq

/-- In particular, absolutely continuous observer fidelity vanishes along
the positive time ray. -/
theorem absolutelyContinuousObserverFidelity_tendsto_zero_atTop
    (density : ℝ → ℝ) :
    Tendsto (absolutelyContinuousObserverFidelity density)
      atTop (𝓝 0) :=
  (absolutelyContinuousObserverFidelity_tendsto_zero_cocompact
    density).mono_left atTop_le_cocompact

/-- At the initial instant the spectral amplitude is total spectral mass. -/
theorem absolutelyContinuousObserverAmplitude_zero_eq_integral
    (density : ℝ → ℝ) :
    absolutelyContinuousObserverAmplitude density 0 =
      (∫ x : ℝ, density x : ℝ) := by
  rw [absolutelyContinuousObserverAmplitude, Real.fourier_eq]
  calc
    (∫ v : ℝ, 𝐞 (-inner ℝ v 0) • (density v : ℂ)) =
        ∫ v : ℝ, (density v : ℂ) := by
      apply integral_congr_ae
      filter_upwards with v
      simp
    _ = (∫ x : ℝ, density x : ℝ) :=
      _root_.integral_ofReal
        (X := ℝ) (μ := volume) (𝕜 := ℂ) (f := density)

/-- Universal continuous-spectrum nonreturn law: every normalized
nonnegative integrable spectral density starts at unit fidelity, and after
some finite deadline its fidelity stays below any prescribed positive
resolution. -/
theorem normalized_absolutelyContinuousObserverSpectrum_no_return
    (density : ℝ → ℝ) (_hint : Integrable density)
    (_hnonneg : ∀ x, 0 ≤ density x)
    (hnorm : ∫ x : ℝ, density x = 1) :
    absolutelyContinuousObserverFidelity density 0 = 1 ∧
      ∀ epsilon : ℝ, 0 < epsilon →
        ∀ᶠ t in atTop,
          absolutelyContinuousObserverFidelity density t < epsilon := by
  constructor
  · rw [absolutelyContinuousObserverFidelity,
      absolutelyContinuousObserverAmplitude_zero_eq_integral, hnorm]
    norm_num
  · intro epsilon hepsilon
    exact
      (absolutelyContinuousObserverFidelity_tendsto_zero_atTop
        density).eventually (Iio_mem_nhds hepsilon)

/-- Survival fidelity of the normalized unit-rate exponential spectral
measure on the bounded-below energy half-line. -/
def exponentialObserverFidelity (t : ℝ) : ℝ :=
  Complex.normSq
    (charFun
      (mobiusCriticalExponentialProbabilityMeasure : Measure ℝ) t)

/-- Exact continuous-spectrum fidelity law. -/
theorem exponentialObserverFidelity_eq (t : ℝ) :
    exponentialObserverFidelity t = (1 + t ^ 2)⁻¹ := by
  rw [exponentialObserverFidelity,
    charFun_mobiusCriticalExponentialProbabilityMeasure]
  rw [Complex.normSq_inv]
  norm_num [Complex.normSq, Complex.mul_re, Complex.mul_im]
  ring

/-- The bounded-below continuous spectral clock returns with unit fidelity
only at its initial instant. -/
theorem exponentialObserverFidelity_eq_one_iff (t : ℝ) :
    exponentialObserverFidelity t = 1 ↔ t = 0 := by
  rw [exponentialObserverFidelity_eq, inv_eq_one]
  constructor
  · intro h
    have ht2 : t ^ 2 = 0 := by linarith
    exact (sq_eq_zero_iff).mp ht2
  · intro ht
    rw [ht]
    norm_num

/-- Every nonzero instant has strictly subunit return fidelity. -/
theorem exponentialObserverFidelity_lt_one
    {t : ℝ} (ht : t ≠ 0) :
    exponentialObserverFidelity t < 1 := by
  rw [exponentialObserverFidelity_eq]
  have ht2 : 0 < t ^ 2 := sq_pos_of_ne_zero ht
  rw [inv_lt_one₀]
  · nlinarith
  · positivity

/-- Along the positive time ray, return fidelity of the bounded-below
continuous spectrum tends to zero. -/
theorem exponentialObserverFidelity_tendsto_zero :
    Tendsto exponentialObserverFidelity atTop (𝓝 0) := by
  rw [show exponentialObserverFidelity =
      fun t : ℝ => (1 + t ^ 2)⁻¹ by
    funext t
    exact exponentialObserverFidelity_eq t]
  apply tendsto_inv_atTop_zero.comp
  simpa [add_comm] using
    tendsto_atTop_add_const_right atTop 1
      (tendsto_pow_atTop (by norm_num : (2 : ℕ) ≠ 0))

/-! ## Positive stationary field forms and observer probes -/

open SchwartzMap

/-- Finite spectral measure selected from a positive temperate spectrum by a
Schwartz observer probe. -/
def schwartzObserverSpectralMeasure
    (mu : Measure ℝ) [mu.HasTemperateGrowth]
    (probe : SchwartzMap ℝ ℂ) : Measure ℝ :=
  mu.withDensity fun x ↦
    ENNReal.ofReal (pointwiseNormSqReal probe x)

noncomputable instance schwartzObserverSpectralMeasure.instIsFiniteMeasure
    (mu : Measure ℝ) [mu.HasTemperateGrowth]
    (probe : SchwartzMap ℝ ℂ) :
    IsFiniteMeasure (schwartzObserverSpectralMeasure mu probe) := by
  apply isFiniteMeasure_withDensity_ofReal
  exact (pointwiseNormSqReal probe).integrable.hasFiniteIntegral

/-- Total observer weight is the quadratic spectral weight of the probe. -/
theorem schwartzObserverSpectralMeasure_univ
    (mu : Measure ℝ) [mu.HasTemperateGrowth]
    (probe : SchwartzMap ℝ ℂ) :
    schwartzObserverSpectralMeasure mu probe Set.univ =
      ENNReal.ofReal
        (∫ x, pointwiseNormSqReal probe x ∂mu) := by
  rw [schwartzObserverSpectralMeasure,
    withDensity_apply _ MeasurableSet.univ,
    Measure.restrict_univ,
    ← ofReal_integral_eq_lintegral_ofReal
      (pointwiseNormSqReal probe).integrable
      (ae_of_all _ (pointwiseNormSqReal_nonnegative probe))]

/-- Probability spectrum seen by a Schwartz observer probe.  Physical
statements below exclude zero-weight probes; the zero case uses the canonical
normalization fallback. -/
def schwartzObserverProbabilityMeasure
    (mu : Measure ℝ) [mu.HasTemperateGrowth]
    (probe : SchwartzMap ℝ ℂ) : ProbabilityMeasure ℝ :=
  FiniteMeasure.normalize
    (⟨schwartzObserverSpectralMeasure mu probe, inferInstance⟩ :
      FiniteMeasure ℝ)

/-- Positive quadratic weight makes the probe spectral measure nonzero. -/
theorem schwartzObserverSpectralMeasure_ne_zero
    (mu : Measure ℝ) [mu.HasTemperateGrowth]
    (probe : SchwartzMap ℝ ℂ)
    (hprobe :
      0 < ∫ x, pointwiseNormSqReal probe x ∂mu) :
    schwartzObserverSpectralMeasure mu probe ≠ 0 := by
  intro hzero
  have huniv := schwartzObserverSpectralMeasure_univ mu probe
  rw [hzero] at huniv
  simp only [Measure.coe_zero, Pi.zero_apply] at huniv
  exact (ENNReal.ofReal_pos.mpr hprobe).ne' huniv.symm

/-- Exact normalized observer spectrum as an inverse-mass rescaling. -/
theorem schwartzObserverProbabilityMeasure_toMeasure
    (mu : Measure ℝ) [mu.HasTemperateGrowth]
    (probe : SchwartzMap ℝ ℂ)
    (hprobe :
      0 < ∫ x, pointwiseNormSqReal probe x ∂mu) :
    (schwartzObserverProbabilityMeasure mu probe : Measure ℝ) =
      (FiniteMeasure.mass
        (⟨schwartzObserverSpectralMeasure mu probe, inferInstance⟩ :
          FiniteMeasure ℝ))⁻¹ •
          schwartzObserverSpectralMeasure mu probe := by
  apply FiniteMeasure.toMeasure_normalize_eq_of_nonzero
  intro hfinite
  apply schwartzObserverSpectralMeasure_ne_zero mu probe hprobe
  have hcoerce := congrArg
    (fun nu : FiniteMeasure ℝ ↦ (nu : Measure ℝ)) hfinite
  simpa using hcoerce

/-- Atomlessness of the underlying stationary spectrum survives probe
selection and normalization. -/
theorem schwartzObserverProbabilityMeasure_noAtoms
    (mu : Measure ℝ) [mu.HasTemperateGrowth] [NoAtoms mu]
    (probe : SchwartzMap ℝ ℂ)
    (hprobe :
      0 < ∫ x, pointwiseNormSqReal probe x ∂mu) :
    NoAtoms
      (schwartzObserverProbabilityMeasure mu probe :
        Measure ℝ) := by
  letI : NoAtoms (schwartzObserverSpectralMeasure mu probe) := by
    rw [schwartzObserverSpectralMeasure]
    infer_instance
  rw [schwartzObserverProbabilityMeasure_toMeasure mu probe hprobe]
  constructor
  intro x
  rw [Measure.smul_apply, measure_singleton]
  simp

/-- Reconstructed probe weight is intrinsic: it is exactly the real
diagonal of the original stationary form. -/
theorem stationarySchwartzObserverSpectralWeight_eq
    (Q : ContinuousSchwartzSesquilinearForm)
    (hQ : Q.MomentumSymmetric) (hQnonneg : Q.IsNonnegative)
    (probe : SchwartzMap ℝ ℂ) :
    ∫ x, pointwiseNormSqReal probe x
        ∂Q.compactSpectralRieszMeasure hQ hQnonneg =
      (Q.fourierPullback probe probe).re := by
  let mu := Q.compactSpectralRieszMeasure hQ hQnonneg
  letI : mu.HasTemperateGrowth :=
    Q.compactSpectralRieszMeasure_hasTemperateGrowth hQ hQnonneg
  have hdiag :=
    Q.compactSpectralRieszMeasure_fourierPullback_diag_all
      hQ hQnonneg probe
  have hweight :=
    spectralMeasureForm_fourierPullback_diag_re mu probe
  change
    (spectralMeasureForm mu).fourierPullback probe probe =
      Q.fourierPullback probe probe at hdiag
  rw [hdiag] at hweight
  exact hweight.symm

/-- Every nonnegative momentum-symmetric continuous Schwartz form induces,
for every observer probe, a normalized spectral return whose long-time mean
is exactly that probe's spectral collision mass. -/
theorem stationarySchwartzObserverReturnMean_tendsto_collision
    (Q : ContinuousSchwartzSesquilinearForm)
    (hQ : Q.MomentumSymmetric) (hQnonneg : Q.IsNonnegative)
    (probe : SchwartzMap ℝ ℂ) :
    Tendsto
      (spectralReturnMeanReal
        (@schwartzObserverProbabilityMeasure
          (Q.compactSpectralRieszMeasure hQ hQnonneg)
          (Q.compactSpectralRieszMeasure_hasTemperateGrowth
            hQ hQnonneg) probe :
          Measure ℝ))
      atTop
      (𝓝 ((spectralDifferenceMeasure
        (@schwartzObserverProbabilityMeasure
          (Q.compactSpectralRieszMeasure hQ hQnonneg)
          (Q.compactSpectralRieszMeasure_hasTemperateGrowth
            hQ hQnonneg) probe :
          Measure ℝ)).real {0})) := by
  letI :
      (Q.compactSpectralRieszMeasure hQ hQnonneg).HasTemperateGrowth :=
    Q.compactSpectralRieszMeasure_hasTemperateGrowth hQ hQnonneg
  exact spectralReturnMeanReal_tendsto_collision
    (schwartzObserverProbabilityMeasure
      (Q.compactSpectralRieszMeasure hQ hQnonneg) probe :
        Measure ℝ)

/-- In the atomless phase, every positive-weight Schwartz observer probe has
zero asymptotic density of returns above every fixed positive fidelity
threshold. -/
theorem stationarySchwartzObserverHighFidelityDensity_tendsto_zero
    (Q : ContinuousSchwartzSesquilinearForm)
    (hQ : Q.MomentumSymmetric) (hQnonneg : Q.IsNonnegative)
    [NoAtoms (Q.compactSpectralRieszMeasure hQ hQnonneg)]
    (probe : SchwartzMap ℝ ℂ)
    (hprobe :
      0 < (Q.fourierPullback probe probe).re)
    {eta : ℝ} (heta : 0 < eta) :
    Tendsto
      (highFidelityWindowDensity
        (@schwartzObserverProbabilityMeasure
          (Q.compactSpectralRieszMeasure hQ hQnonneg)
          (Q.compactSpectralRieszMeasure_hasTemperateGrowth
            hQ hQnonneg) probe :
            Measure ℝ) eta)
      atTop (𝓝 0) := by
  letI :
      (Q.compactSpectralRieszMeasure hQ hQnonneg).HasTemperateGrowth :=
    Q.compactSpectralRieszMeasure_hasTemperateGrowth hQ hQnonneg
  letI : NoAtoms
      (schwartzObserverProbabilityMeasure
        (Q.compactSpectralRieszMeasure hQ hQnonneg) probe :
          Measure ℝ) :=
    schwartzObserverProbabilityMeasure_noAtoms
      (Q.compactSpectralRieszMeasure hQ hQnonneg) probe
      (by
        rw [stationarySchwartzObserverSpectralWeight_eq
          Q hQ hQnonneg probe]
        exact hprobe)
  exact highFidelityWindowDensity_tendsto_zero_of_noAtoms
    (schwartzObserverProbabilityMeasure
      (Q.compactSpectralRieszMeasure hQ hQnonneg) probe :
        Measure ℝ) heta

/-! ## One stationary field, two observer temporal phases -/

/-- One fixed mixed stationary spectrum: a zero-frequency atom together with
a separated unit-width continuum. -/
def observerPhaseSeparatedSpectrum : Measure ℝ :=
  Measure.dirac 0 +
    (volume : Measure ℝ).restrict (Set.Icc 4 5)

noncomputable instance observerPhaseSeparatedSpectrum.instIsFiniteMeasure :
    IsFiniteMeasure observerPhaseSeparatedSpectrum := by
  rw [observerPhaseSeparatedSpectrum]
  infer_instance

/-- Probe supported around the recurrent atom and disjoint from the
continuum. -/
def recurrentPhaseObserverProbe : SchwartzMap ℝ ℂ :=
  compactIntervalCutoff 1

/-- Probe supported around the continuum and disjoint from the recurrent
atom. -/
def dispersivePhaseObserverProbe : SchwartzMap ℝ ℂ :=
  translateCLM ℂ (-(9 / 2 : ℝ)) (compactIntervalCutoff 0)

/-- The recurrent observer selects exactly the atomic sector. -/
theorem recurrentPhaseObserver_selectedMeasure :
    schwartzObserverSpectralMeasure observerPhaseSeparatedSpectrum
        recurrentPhaseObserverProbe =
      Measure.dirac 0 := by
  rw [schwartzObserverSpectralMeasure,
    observerPhaseSeparatedSpectrum, withDensity_add_measure,
    dirac_withDensity]
  have hatom :
      ENNReal.ofReal
          (pointwiseNormSqReal recurrentPhaseObserverProbe 0) = 1 := by
    simp [recurrentPhaseObserverProbe, pointwiseNormSqReal_apply]
  rw [hatom, one_smul]
  have hcontinuum :
      ((volume : Measure ℝ).restrict (Set.Icc 4 5)).withDensity
          (fun x ↦ ENNReal.ofReal
            (pointwiseNormSqReal recurrentPhaseObserverProbe x)) =
        0 := by
    apply (withDensity_eq_zero_iff
      (by fun_prop)).2
    filter_upwards
      [ae_restrict_mem (μ := (volume : Measure ℝ))
        measurableSet_Icc] with x hx
    have hnot :
        x ∉ tsupport recurrentPhaseObserverProbe := by
      rw [recurrentPhaseObserverProbe,
        compactIntervalCutoff_tsupport]
      simp only [Set.mem_setOf_eq, abs_one]
      intro habs
      have hx4 : 4 ≤ x := hx.1
      have hxabs : x ≤ |x| := le_abs_self x
      linarith
    have hzero :
        recurrentPhaseObserverProbe x = 0 :=
      image_eq_zero_of_notMem_tsupport hnot
    simp [pointwiseNormSqReal_apply, hzero]
  rw [hcontinuum, add_zero]

/-- The dispersive observer selects exactly the continuum sector. -/
theorem dispersivePhaseObserver_selectedMeasure :
    schwartzObserverSpectralMeasure observerPhaseSeparatedSpectrum
        dispersivePhaseObserverProbe =
      (volume : Measure ℝ).restrict (Set.Icc 4 5) := by
  rw [schwartzObserverSpectralMeasure,
    observerPhaseSeparatedSpectrum, withDensity_add_measure,
    dirac_withDensity]
  have hzeroAtAtom :
      dispersivePhaseObserverProbe 0 = 0 := by
    rw [dispersivePhaseObserverProbe, translateCLM_apply]
    have hnot :
        (-(9 / 2 : ℝ)) ∉
          tsupport (compactIntervalCutoff 0) := by
      rw [compactIntervalCutoff_tsupport]
      norm_num
    simpa using image_eq_zero_of_notMem_tsupport hnot
  have hatom :
      ENNReal.ofReal
          (pointwiseNormSqReal dispersivePhaseObserverProbe 0) = 0 := by
    simp [pointwiseNormSqReal_apply, hzeroAtAtom]
  rw [hatom, zero_smul, zero_add]
  calc
    ((volume : Measure ℝ).restrict (Set.Icc 4 5)).withDensity
        (fun x ↦ ENNReal.ofReal
          (pointwiseNormSqReal dispersivePhaseObserverProbe x)) =
        ((volume : Measure ℝ).restrict (Set.Icc 4 5)).withDensity 1 := by
      apply withDensity_congr_ae
      filter_upwards
        [ae_restrict_mem (μ := (volume : Measure ℝ))
          measurableSet_Icc] with x hx
      have hone :
          dispersivePhaseObserverProbe x = 1 := by
        rw [dispersivePhaseObserverProbe, translateCLM_apply]
        apply compactIntervalCutoff_apply_of_abs_le_add_one
        norm_num only [abs_zero]
        rw [abs_le]
        constructor <;> linarith [hx.1, hx.2]
      simp [pointwiseNormSqReal_apply, hone]
    _ = (volume : Measure ℝ).restrict (Set.Icc 4 5) :=
      withDensity_one

noncomputable instance unitContinuumSpectrum.instIsProbabilityMeasure :
    IsProbabilityMeasure
      ((volume : Measure ℝ).restrict (Set.Icc 4 5)) where
  measure_univ := by
    rw [Measure.restrict_apply_univ, Real.volume_Icc]
    norm_num

/-- Normalization preserves exact atomic selection. -/
theorem recurrentPhaseObserver_probabilityMeasure :
    (schwartzObserverProbabilityMeasure observerPhaseSeparatedSpectrum
        recurrentPhaseObserverProbe : Measure ℝ) =
      Measure.dirac 0 := by
  let recurrentLaw : ProbabilityMeasure ℝ :=
    ⟨Measure.dirac 0, Measure.dirac.isProbabilityMeasure⟩
  have hfinite :
      (⟨schwartzObserverSpectralMeasure observerPhaseSeparatedSpectrum
          recurrentPhaseObserverProbe, inferInstance⟩ :
        FiniteMeasure ℝ) =
        recurrentLaw.toFiniteMeasure := by
    apply FiniteMeasure.toMeasure_injective
    exact recurrentPhaseObserver_selectedMeasure
  change
    (FiniteMeasure.normalize
      (⟨schwartzObserverSpectralMeasure observerPhaseSeparatedSpectrum
          recurrentPhaseObserverProbe, inferInstance⟩ :
        FiniteMeasure ℝ) : Measure ℝ) =
      Measure.dirac 0
  rw [hfinite,
    ProbabilityMeasure.toFiniteMeasure_normalize_eq_self]
  rfl

/-- Normalization preserves exact continuum selection. -/
theorem dispersivePhaseObserver_probabilityMeasure :
    (schwartzObserverProbabilityMeasure observerPhaseSeparatedSpectrum
        dispersivePhaseObserverProbe : Measure ℝ) =
      (volume : Measure ℝ).restrict (Set.Icc 4 5) := by
  let dispersiveLaw : ProbabilityMeasure ℝ :=
    ⟨(volume : Measure ℝ).restrict (Set.Icc 4 5),
      unitContinuumSpectrum.instIsProbabilityMeasure⟩
  have hfinite :
      (⟨schwartzObserverSpectralMeasure observerPhaseSeparatedSpectrum
          dispersivePhaseObserverProbe, inferInstance⟩ :
        FiniteMeasure ℝ) =
        dispersiveLaw.toFiniteMeasure := by
    apply FiniteMeasure.toMeasure_injective
    exact dispersivePhaseObserver_selectedMeasure
  change
    (FiniteMeasure.normalize
      (⟨schwartzObserverSpectralMeasure observerPhaseSeparatedSpectrum
          dispersivePhaseObserverProbe, inferInstance⟩ :
        FiniteMeasure ℝ) : Measure ℝ) =
      (volume : Measure ℝ).restrict (Set.Icc 4 5)
  rw [hfinite,
    ProbabilityMeasure.toFiniteMeasure_normalize_eq_self]
  rfl

/-- Same positive stationary field form, opposite observer return phases:
one probe has perfect return at every instant, while the other has
zero-density returns above every fixed positive fidelity threshold. -/
theorem oneStationaryForm_twoObserverTemporalPhases :
    (∀ t : ℝ,
      Complex.normSq
        (charFun
          (schwartzObserverProbabilityMeasure
            observerPhaseSeparatedSpectrum
            recurrentPhaseObserverProbe : Measure ℝ) t) = 1) ∧
    (∀ eta : ℝ, 0 < eta →
      Tendsto
        (highFidelityWindowDensity
          (schwartzObserverProbabilityMeasure
            observerPhaseSeparatedSpectrum
            dispersivePhaseObserverProbe : Measure ℝ) eta)
        atTop (𝓝 0)) := by
  constructor
  · intro t
    rw [recurrentPhaseObserver_probabilityMeasure,
      charFun_dirac]
    norm_num
  · intro eta heta
    haveI : NoAtoms
        (schwartzObserverProbabilityMeasure
          observerPhaseSeparatedSpectrum
          dispersivePhaseObserverProbe : Measure ℝ) := by
      rw [dispersivePhaseObserver_probabilityMeasure]
      infer_instance
    exact highFidelityWindowDensity_tendsto_zero_of_noAtoms
      (schwartzObserverProbabilityMeasure
        observerPhaseSeparatedSpectrum
        dispersivePhaseObserverProbe : Measure ℝ) heta

/-! ## Spatial dephasing through arbitrary dispersions -/

/-- A dispersion with countable fibers in one atomless coordinate cannot
create an energy atom from a product spectral law.  Neither finiteness nor
sigma-finiteness of either factor is required. -/
theorem noAtoms_map_prod_of_countable_fibers
    {α β γ : Type*}
    [MeasurableSpace α] [MeasurableSpace β] [MeasurableSpace γ]
    [MeasurableSingletonClass γ]
    (mu : Measure α) (nu : Measure β) [NoAtoms nu]
    (dispersion : α × β → γ) (hdispersion : Measurable dispersion)
    (hfiber :
      ∀ a energy, {b | dispersion (a, b) = energy}.Countable) :
    NoAtoms ((mu.prod nu).map dispersion) where
  measure_singleton energy := by
    rw [Measure.map_apply hdispersion
      (measurableSet_singleton energy)]
    apply Measure.measure_prod_null_of_ae_null
      (hdispersion (measurableSet_singleton energy))
    filter_upwards with a
    exact (hfiber a energy).measure_zero nu

/-- The spatial dephasing mechanism survives arbitrary correlations whose
joint spectral law is absolutely continuous with respect to a product
having one atomless coordinate. -/
theorem noAtoms_map_of_absolutelyContinuous_prod_of_countable_fibers
    {α β γ : Type*}
    [MeasurableSpace α] [MeasurableSpace β] [MeasurableSpace γ]
    [MeasurableSingletonClass γ]
    (mu : Measure α) (nu : Measure β) [NoAtoms nu]
    (source : Measure (α × β))
    (hsource : source ≪ mu.prod nu)
    (dispersion : α × β → γ) (hdispersion : Measurable dispersion)
    (hfiber :
      ∀ a energy, {b | dispersion (a, b) = energy}.Countable) :
    NoAtoms (source.map dispersion) where
  measure_singleton energy := by
    rw [Measure.map_apply hdispersion
      (measurableSet_singleton energy)]
    apply hsource
    apply Measure.measure_prod_null_of_ae_null
      (hdispersion (measurableSet_singleton energy))
    filter_upwards with a
    exact (hfiber a energy).measure_zero nu

/-- Arbitrary nonnegative observer weighting preserves spatial dephasing. -/
theorem noAtoms_map_withDensity_prod_of_countable_fibers
    {α β γ : Type*}
    [MeasurableSpace α] [MeasurableSpace β] [MeasurableSpace γ]
    [MeasurableSingletonClass γ]
    (mu : Measure α) (nu : Measure β) [NoAtoms nu]
    (weight : α × β → ENNReal)
    (dispersion : α × β → γ) (hdispersion : Measurable dispersion)
    (hfiber :
      ∀ a energy, {b | dispersion (a, b) = energy}.Countable) :
    NoAtoms
      (((mu.prod nu).withDensity weight).map dispersion) :=
  noAtoms_map_of_absolutelyContinuous_prod_of_countable_fibers
    mu nu ((mu.prod nu).withDensity weight)
    (withDensity_absolutelyContinuous (mu.prod nu) weight)
    dispersion hdispersion hfiber

/-- One-dimensional relativistic energy with arbitrary nonnegative mass
and momentum coordinates. -/
def relativisticEnergy (massMomentum : ℝ × ℝ) : ℝ :=
  Real.sqrt
    (massMomentum.1 ^ 2 + massMomentum.2 ^ 2)

/-- At fixed mass, every relativistic energy has at most two real momentum
preimages. -/
theorem relativisticEnergy_fiber_finite (mass energy : ℝ) :
    {momentum : ℝ |
      relativisticEnergy (mass, momentum) = energy}.Finite := by
  apply
    ((Set.finite_singleton
      (-Real.sqrt (energy ^ 2 - mass ^ 2))).insert
      (Real.sqrt (energy ^ 2 - mass ^ 2))).subset
  intro momentum hmomentum
  simp only [Set.mem_setOf_eq, relativisticEnergy] at hmomentum
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
  have hsqrtSum :
      Real.sqrt (mass ^ 2 + momentum ^ 2) ^ 2 =
        mass ^ 2 + momentum ^ 2 :=
    Real.sq_sqrt
      (add_nonneg (sq_nonneg mass) (sq_nonneg momentum))
  rw [hmomentum] at hsqrtSum
  have hsq :
      momentum ^ 2 = energy ^ 2 - mass ^ 2 := by
    nlinarith
  have hnonneg :
      0 ≤ energy ^ 2 - mass ^ 2 := by
    rw [← hsq]
    positivity
  have hsqrt :
      Real.sqrt (energy ^ 2 - mass ^ 2) ^ 2 =
        momentum ^ 2 := by
    rw [Real.sq_sqrt hnonneg, hsq]
  rcases (sq_eq_sq_iff_eq_or_eq_neg.mp hsqrt) with h | h
  · exact Or.inl h.symm
  · right
    nlinarith

/-- Every arbitrary mass mixture with an atomless spatial momentum law
has atomless observed relativistic energy, after every nonnegative
observer weighting. -/
theorem noAtoms_relativisticEnergy_weighted_product
    (massMeasure momentumMeasure : Measure ℝ)
    [NoAtoms momentumMeasure]
    (weight : ℝ × ℝ → ENNReal) :
    NoAtoms
      (((massMeasure.prod momentumMeasure).withDensity weight).map
        relativisticEnergy) :=
  noAtoms_map_withDensity_prod_of_countable_fibers
    massMeasure momentumMeasure weight relativisticEnergy
    (by
      unfold relativisticEnergy
      fun_prop)
    (fun mass energy ↦
      (relativisticEnergy_fiber_finite mass energy).countable)

/-! ## Cardinal jump forced by atomlessness -/

namespace SpectralMemory

open scoped Cardinal

/-- An atomless probability spectrum cannot have countable topological
support. -/
theorem support_not_countable_of_noAtoms
    (mu : Measure ℝ) [IsProbabilityMeasure mu] [NoAtoms mu] :
    ¬mu.support.Countable := by
  intro hcount
  have hzero : mu mu.support = 0 :=
    hcount.measure_zero mu
  have hone : mu mu.support = 1 := by
    rw [measure_of_measure_compl_eq_zero
      Measure.measure_compl_support, measure_univ]
  exact zero_ne_one (hzero.symm.trans hone)

/-- Every uncountable closed spectral support on the real line has exactly
continuum cardinality. -/
theorem mk_support_eq_continuum_of_not_countable
    (mu : Measure ℝ) (huncountable : ¬mu.support.Countable) :
    #(mu.support) = Cardinal.continuum := by
  obtain ⟨f, hf, _, hinjective⟩ :=
    Measure.isClosed_support.exists_nat_bool_injection_of_not_countable
      huncountable
  let injection : (ℕ → Bool) → mu.support :=
    fun x ↦ ⟨f x, hf (Set.mem_range_self x)⟩
  have hinjection : Function.Injective injection := by
    intro x y hxy
    exact hinjective (Subtype.ext_iff.mp hxy)
  have hcantor :
      #(ℕ → Bool) = Cardinal.continuum := by
    rw [← Cardinal.power_def, Cardinal.mk_bool,
      Cardinal.mk_nat, Cardinal.two_power_aleph0]
  apply le_antisymm
  · exact (Cardinal.mk_subtype_le _).trans_eq
      Cardinal.mk_real
  · rw [← hcantor]
    exact Cardinal.mk_le_of_injective hinjection

/-- Closed support of every atomless probability law on the real line has
exactly continuum cardinality. -/
theorem mk_support_eq_continuum_of_noAtoms
    (mu : Measure ℝ) [IsProbabilityMeasure mu] [NoAtoms mu] :
    #(mu.support) = Cardinal.continuum :=
  mk_support_eq_continuum_of_not_countable mu
    (support_not_countable_of_noAtoms mu)

/-- The rational span generated by every uncountable closed real spectrum
has continuum cardinality. -/
theorem mk_measureVisibleFrequencyModule_eq_continuum_of_not_countable
    (mu : Measure ℝ) (huncountable : ¬mu.support.Countable) :
    #(measureVisibleFrequencyModule mu) =
      Cardinal.continuum := by
  let inclusion : mu.support →
      measureVisibleFrequencyModule mu :=
    fun x ↦ ⟨x, Submodule.subset_span x.property⟩
  have hinclusion : Function.Injective inclusion := by
    intro x y hxy
    apply Subtype.ext
    exact congrArg
      (fun z : measureVisibleFrequencyModule mu ↦ (z : ℝ)) hxy
  have hlower :
      #(mu.support) ≤
        #(measureVisibleFrequencyModule mu) :=
    Cardinal.mk_le_of_injective hinclusion
  rw [mk_support_eq_continuum_of_not_countable mu
    huncountable] at hlower
  apply le_antisymm
  · exact (Cardinal.mk_subtype_le _).trans_eq
      Cardinal.mk_real
  · exact hlower

/-- Every uncountable closed real spectrum has observer temporal dimension
exactly continuum. -/
theorem measureTemporalDimension_eq_continuum_of_not_countable
    (mu : Measure ℝ) (huncountable : ¬mu.support.Countable) :
    measureTemporalDimension mu =
      Cardinal.continuum := by
  rw [measureTemporalDimension]
  calc
    Module.rank ℚ (measureVisibleFrequencyModule mu) =
        #(measureVisibleFrequencyModule mu) := by
      apply Module.Free.rank_eq_mk_of_infinite_lt
      rw [Cardinal.mkRat,
        mk_measureVisibleFrequencyModule_eq_continuum_of_not_countable
          mu huncountable]
      simpa using Cardinal.aleph0_lt_continuum
    _ = Cardinal.continuum :=
      mk_measureVisibleFrequencyModule_eq_continuum_of_not_countable
        mu huncountable

/-- Universal cardinal jump: every atomless probability spectrum has
observer temporal dimension exactly continuum, not merely infinite. -/
theorem measureTemporalDimension_eq_continuum_of_noAtoms
    (mu : Measure ℝ) [IsProbabilityMeasure mu] [NoAtoms mu] :
    measureTemporalDimension mu =
      Cardinal.continuum :=
  measureTemporalDimension_eq_continuum_of_not_countable mu
    (support_not_countable_of_noAtoms mu)

/-- Universal temporal-cardinality gap: every real spectral measure has
either at most countable rational temporal dimension or exactly continuum
dimension.  No intermediate uncountable cardinal can occur. -/
theorem measureTemporalDimension_le_aleph0_or_eq_continuum
    (mu : Measure ℝ) :
    measureTemporalDimension mu ≤ Cardinal.aleph0 ∨
      measureTemporalDimension mu = Cardinal.continuum := by
  by_cases hcountable : mu.support.Countable
  · left
    rw [measureTemporalDimension, measureVisibleFrequencyModule]
    exact (rank_span_le mu.support).trans
      (Cardinal.le_aleph0_iff_set_countable.mpr hcountable)
  · right
    exact measureTemporalDimension_eq_continuum_of_not_countable
      mu hcountable

/-- Atomless observer phase law: continuum temporal dimension and vanishing
density of every fixed positive-fidelity return threshold hold together for
every probability spectrum on the real line. -/
theorem atomlessObserverTemporalPhaseLaw
    (mu : Measure ℝ) [IsProbabilityMeasure mu] [NoAtoms mu] :
    measureTemporalDimension mu = Cardinal.continuum ∧
      ∀ eta : ℝ, 0 < eta →
        Tendsto (highFidelityWindowDensity mu eta)
          atTop (𝓝 0) := by
  refine
    ⟨measureTemporalDimension_eq_continuum_of_noAtoms mu, ?_⟩
  intro eta heta
  exact highFidelityWindowDensity_tendsto_zero_of_noAtoms
    mu heta

end SpectralMemory

/-- Universal dispersive spatial phase law.  For every normalized observer
energy spectrum obtained from a joint spectral law absolutely continuous
with respect to a product having one atomless coordinate, every
countable-fiber dispersion forces continuum temporal dimension and
zero-density returns above every fixed positive fidelity. -/
theorem dispersiveSpatialObserverTemporalPhaseLaw
    {α β : Type*}
    [MeasurableSpace α] [MeasurableSpace β]
    (mu : Measure α) (nu : Measure β) [NoAtoms nu]
    (source : Measure (α × β))
    (hsource : source ≪ mu.prod nu)
    (dispersion : α × β → ℝ)
    (hdispersion : Measurable dispersion)
    (hfiber :
      ∀ a energy, {b | dispersion (a, b) = energy}.Countable)
    [IsProbabilityMeasure (source.map dispersion)] :
    SpectralMemory.measureTemporalDimension
        (source.map dispersion) =
      Cardinal.continuum ∧
      ∀ eta : ℝ, 0 < eta →
        Tendsto
          (highFidelityWindowDensity
            (source.map dispersion) eta)
          atTop (𝓝 0) := by
  letI : NoAtoms (source.map dispersion) :=
    noAtoms_map_of_absolutelyContinuous_prod_of_countable_fibers
      mu nu source hsource dispersion hdispersion hfiber
  exact SpectralMemory.atomlessObserverTemporalPhaseLaw
    (source.map dispersion)

/-- Relativistic spatial phase law, uniform over every mass mixture and
every normalized correlated joint law absolutely continuous with respect
to an arbitrary mass law times an atomless momentum law. -/
theorem relativisticSpatialObserverTemporalPhaseLaw
    (massMeasure momentumMeasure : Measure ℝ)
    [NoAtoms momentumMeasure]
    (source : Measure (ℝ × ℝ))
    (hsource :
      source ≪ massMeasure.prod momentumMeasure)
    [IsProbabilityMeasure (source.map relativisticEnergy)] :
    SpectralMemory.measureTemporalDimension
        (source.map relativisticEnergy) =
      Cardinal.continuum ∧
      ∀ eta : ℝ, 0 < eta →
        Tendsto
          (highFidelityWindowDensity
            (source.map relativisticEnergy) eta)
          atTop (𝓝 0) := by
  exact dispersiveSpatialObserverTemporalPhaseLaw
    massMeasure momentumMeasure source hsource
    relativisticEnergy
    (by
      unfold relativisticEnergy
      fun_prop)
    (fun mass energy ↦
      (relativisticEnergy_fiber_finite mass energy).countable)

/-- Intrinsic stationary-field phase law: if the unique positive temperate
spectrum of a stationary form is atomless, then every nonzero Schwartz
observer has continuum temporal dimension and zero-density fixed-fidelity
returns. -/
theorem stationarySchwartzObserverTemporalPhaseLaw
    (Q : ContinuousSchwartzSesquilinearForm)
    (hQ : Q.MomentumSymmetric) (hQnonneg : Q.IsNonnegative)
    [NoAtoms (Q.compactSpectralRieszMeasure hQ hQnonneg)]
    (probe : SchwartzMap ℝ ℂ)
    (hprobe :
      0 < (Q.fourierPullback probe probe).re) :
    SpectralMemory.measureTemporalDimension
        (@schwartzObserverProbabilityMeasure
          (Q.compactSpectralRieszMeasure hQ hQnonneg)
          (Q.compactSpectralRieszMeasure_hasTemperateGrowth
            hQ hQnonneg) probe : Measure ℝ) =
        Cardinal.continuum ∧
      ∀ eta : ℝ, 0 < eta →
        Tendsto
          (highFidelityWindowDensity
            (@schwartzObserverProbabilityMeasure
              (Q.compactSpectralRieszMeasure hQ hQnonneg)
              (Q.compactSpectralRieszMeasure_hasTemperateGrowth
                hQ hQnonneg) probe : Measure ℝ) eta)
          atTop (𝓝 0) := by
  letI :
      (Q.compactSpectralRieszMeasure hQ hQnonneg).HasTemperateGrowth :=
    Q.compactSpectralRieszMeasure_hasTemperateGrowth hQ hQnonneg
  letI : NoAtoms
      (schwartzObserverProbabilityMeasure
        (Q.compactSpectralRieszMeasure hQ hQnonneg) probe :
          Measure ℝ) :=
    schwartzObserverProbabilityMeasure_noAtoms
      (Q.compactSpectralRieszMeasure hQ hQnonneg) probe
      (by
        rw [stationarySchwartzObserverSpectralWeight_eq
          Q hQ hQnonneg probe]
        exact hprobe)
  exact SpectralMemory.atomlessObserverTemporalPhaseLaw
    (schwartzObserverProbabilityMeasure
      (Q.compactSpectralRieszMeasure hQ hQnonneg) probe :
        Measure ℝ)

