import GaloisForLFunctions.RHTower.FiniteQuantumObserverGraphRecurrenceBound
import Mathlib.Analysis.SpecialFunctions.Complex.Log
import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic
import Mathlib.LinearAlgebra.Dimension.Finite
import Mathlib.MeasureTheory.Measure.Support

/-!
# Observer-dependent temporal dimension

An arbitrary family of observer-visible real frequencies generates:

* an additive frequency group over `ℤ`;
* a rational frequency module over `ℚ`;
* a cardinal-valued temporal dimension, the rank of that module.

Every additive subgroup of the real line is exclusively cyclic or dense.
Exact positive return of every visible phase is equivalent to cyclicity of
the visible frequency group.  This remains true for infinite families and
arbitrary positive spectral measures.

The infinite case has a strict fracture absent from finite packets: rational
rank one need not imply periodicity.  The rational frequencies have temporal
dimension one, generate a dense subgroup of `ℝ`, and admit no positive exact
return.
-/

open scoped BigOperators MeasureTheory

noncomputable section

namespace RHTower

/-! ## Arbitrary visible frequency families -/

/-- Additive group generated by an arbitrary family of observer-visible
frequencies. -/
def visibleFrequencyGroup {ι : Type*} (frequency : ι → ℝ) :
    AddSubgroup ℝ :=
  AddSubgroup.closure (Set.range frequency)

/-- Rational frequency module generated by an arbitrary observer-visible
family. -/
def visibleFrequencyModule {ι : Type*} (frequency : ι → ℝ) :
    Submodule ℚ ℝ :=
  Submodule.span ℚ (Set.range frequency)

/-- Observer temporal dimension.  The value is a cardinal, so the definition
applies without any finiteness assumption. -/
def observerTemporalDimension {ι : Type*} (frequency : ι → ℝ) :
    Cardinal :=
  Module.rank ℚ (visibleFrequencyModule frequency)

/-- Temporal dimension is zero exactly when every visible frequency is
zero. -/
theorem observerTemporalDimension_eq_zero_iff
    {ι : Type*} (frequency : ι → ℝ) :
    observerTemporalDimension frequency = 0 ↔
      ∀ i, frequency i = 0 := by
  rw [observerTemporalDimension, visibleFrequencyModule,
    Submodule.rank_eq_zero, Submodule.span_eq_bot]
  simp

/-- The visible additive group is trivial exactly when every generator is
zero. -/
theorem visibleFrequencyGroup_eq_bot_iff
    {ι : Type*} (frequency : ι → ℝ) :
    visibleFrequencyGroup frequency = ⊥ ↔
      ∀ i, frequency i = 0 := by
  rw [visibleFrequencyGroup, AddSubgroup.closure_eq_bot_iff]
  simp

/-- Zero temporal dimension and a trivial visible frequency group are
equivalent. -/
theorem observerTemporalDimension_eq_zero_iff_group_eq_bot
    {ι : Type*} (frequency : ι → ℝ) :
    observerTemporalDimension frequency = 0 ↔
      visibleFrequencyGroup frequency = ⊥ := by
  rw [observerTemporalDimension_eq_zero_iff,
    visibleFrequencyGroup_eq_bot_iff]

/-- Universal lattice--continuum dichotomy: every observer-visible frequency
group is exclusively dense or cyclic. -/
theorem visibleFrequencyGroup_dense_xor_cyclic
    {ι : Type*} (frequency : ι → ℝ) :
    Xor (Dense (visibleFrequencyGroup frequency : Set ℝ))
      (∃ omega : ℝ,
        visibleFrequencyGroup frequency =
          AddSubgroup.zmultiples omega) :=
  AddSubgroup.dense_xor_cyclic (visibleFrequencyGroup frequency)

/-- Inclusion of visible generators gives inclusion of visible additive
groups. -/
theorem visibleFrequencyGroup_mono
    {ι κ : Type*} {frequency : ι → ℝ} {larger : κ → ℝ}
    (h : Set.range frequency ⊆ Set.range larger) :
    visibleFrequencyGroup frequency ≤ visibleFrequencyGroup larger :=
  AddSubgroup.closure_mono h

/-- Inclusion of visible generators gives inclusion of visible rational
modules. -/
theorem visibleFrequencyModule_mono
    {ι κ : Type*} {frequency : ι → ℝ} {larger : κ → ℝ}
    (h : Set.range frequency ⊆ Set.range larger) :
    visibleFrequencyModule frequency ≤ visibleFrequencyModule larger :=
  Submodule.span_mono h

/-- Observer refinement cannot decrease temporal dimension. -/
theorem observerTemporalDimension_mono
    {ι κ : Type*} {frequency : ι → ℝ} {larger : κ → ℝ}
    (h : Set.range frequency ⊆ Set.range larger) :
    observerTemporalDimension frequency ≤
      observerTemporalDimension larger :=
  Submodule.rank_mono (visibleFrequencyModule_mono h)

/-! ## Exact return for arbitrary families -/

/-- Exact return in normalized cycles: every visible frequency accumulates
an integer number of turns. -/
def normalizedExactReturn {ι : Type*}
    (frequency : ι → ℝ) (t : ℝ) : Prop :=
  ∀ i, ∃ n : ℤ, t * frequency i = n

/-- Exact normalized return is equivalent to containment of the full visible
frequency group in one reciprocal-time lattice. -/
theorem normalizedExactReturn_iff_group_le_zmultiples
    {ι : Type*} (frequency : ι → ℝ) {t : ℝ} (ht : t ≠ 0) :
    normalizedExactReturn frequency t ↔
      visibleFrequencyGroup frequency ≤
        AddSubgroup.zmultiples t⁻¹ := by
  rw [visibleFrequencyGroup, AddSubgroup.closure_le]
  constructor
  · intro h x hx
    obtain ⟨i, rfl⟩ := hx
    obtain ⟨n, hn⟩ := h i
    change frequency i ∈ AddSubgroup.zmultiples t⁻¹
    rw [AddSubgroup.mem_zmultiples_iff]
    refine ⟨n, ?_⟩
    rw [zsmul_eq_mul]
    calc
      (n : ℝ) * t⁻¹ = (t * frequency i) * t⁻¹ := by rw [hn]
      _ = frequency i := by field_simp
  · intro h i
    have hmem : frequency i ∈ AddSubgroup.zmultiples t⁻¹ :=
      h (Set.mem_range_self i)
    rw [AddSubgroup.mem_zmultiples_iff] at hmem
    obtain ⟨n, hn⟩ := hmem
    refine ⟨n, ?_⟩
    rw [← hn, zsmul_eq_mul]
    field_simp

/-- An arbitrary visible frequency family has a positive exact return if and
only if its additive frequency group is cyclic. -/
theorem exists_positive_normalizedExactReturn_iff_cyclic
    {ι : Type*} (frequency : ι → ℝ) :
    (∃ t : ℝ, 0 < t ∧ normalizedExactReturn frequency t) ↔
      ∃ omega : ℝ,
        visibleFrequencyGroup frequency =
          AddSubgroup.zmultiples omega := by
  constructor
  · rintro ⟨t, ht, hret⟩
    have hle :
        visibleFrequencyGroup frequency ≤
          AddSubgroup.zmultiples t⁻¹ :=
      (normalizedExactReturn_iff_group_le_zmultiples
        frequency ht.ne').mp hret
    obtain ⟨n, hn⟩ :=
      (AddSubgroup.le_zmultiples_iff
        t⁻¹ (visibleFrequencyGroup frequency)).mp hle
    exact ⟨n • t⁻¹, hn⟩
  · rintro ⟨omega, hgroup⟩
    by_cases homega : omega = 0
    · refine ⟨1, by norm_num, ?_⟩
      rw [normalizedExactReturn_iff_group_le_zmultiples
        frequency one_ne_zero, inv_one, hgroup, homega]
      simp
    · refine ⟨|omega|⁻¹,
        inv_pos.mpr (abs_pos.mpr homega), ?_⟩
      rw [normalizedExactReturn_iff_group_le_zmultiples frequency
        (inv_ne_zero (abs_ne_zero.mpr homega)),
        inv_inv, hgroup]
      by_cases hpos : 0 < omega
      · rw [abs_of_pos hpos]
      · rw [abs_of_nonpos (le_of_not_gt hpos)]
        intro x hx
        rw [AddSubgroup.mem_zmultiples_iff] at hx ⊢
        obtain ⟨n, rfl⟩ := hx
        exact ⟨-n, by simp⟩

/-! ## Infinite rank-one fracture -/

/-- The rationally indexed real frequencies span exactly one rational
direction. -/
theorem rationalCast_visibleFrequencyModule :
    visibleFrequencyModule (fun q : ℚ => (q : ℝ)) =
      ℚ ∙ (1 : ℝ) := by
  apply le_antisymm
  · rw [visibleFrequencyModule, Submodule.span_le]
    rintro x ⟨q, rfl⟩
    change (q : ℝ) ∈ ℚ ∙ (1 : ℝ)
    rw [Submodule.mem_span_singleton]
    exact ⟨q, by simp⟩
  · rw [Submodule.span_le]
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst x
    exact Submodule.subset_span ⟨1, by simp⟩

/-- The rational frequency family has temporal dimension exactly one. -/
theorem rationalCast_observerTemporalDimension :
    observerTemporalDimension (fun q : ℚ => (q : ℝ)) = 1 := by
  rw [observerTemporalDimension, rationalCast_visibleFrequencyModule,
    Module.rank_eq_one_iff_finrank_eq_one]
  exact finrank_span_singleton one_ne_zero

/-- Despite having dimension one, the rational frequency family generates a
dense visible frequency group. -/
theorem rationalCast_visibleFrequencyGroup_dense :
    Dense
      (visibleFrequencyGroup
        (fun q : ℚ => (q : ℝ)) : Set ℝ) :=
  Rat.denseRange_cast.mono fun _ hx =>
    AddSubgroup.subset_closure hx

/-- The dimension-one rational frequency family has no positive exact
return. -/
theorem rationalCast_has_no_positive_exactReturn :
    ¬ ∃ t : ℝ, 0 < t ∧
      normalizedExactReturn (fun q : ℚ => (q : ℝ)) t := by
  intro h
  obtain ⟨omega, hgroup⟩ :=
    (exists_positive_normalizedExactReturn_iff_cyclic
      (fun q : ℚ => (q : ℝ))).mp h
  exact
    ((AddSubgroup.dense_iff_ne_zmultiples.mp
      rationalCast_visibleFrequencyGroup_dense) omega) hgroup

/-! ## Finite observer graphs -/

/-- The energy gap carried by an ordered graph edge, and zero off the
coherence graph. -/
def graphVisibleGap {V : Type*} (G : SimpleGraph V)
    (energy : V → ℝ) (p : V × V) : ℝ :=
  by
    classical
    exact if G.Adj p.1 p.2 then energy p.1 - energy p.2 else 0

/-- Rational module generated by all graph-visible energy gaps. -/
def graphTemporalModule {V : Type*} (G : SimpleGraph V)
    (energy : V → ℝ) : Submodule ℚ ℝ :=
  visibleFrequencyModule (graphVisibleGap G energy)

/-- Arithmetic temporal dimension of a finite observer graph. -/
def graphTemporalDimension {V : Type*} [Fintype V]
    (G : SimpleGraph V) (energy : V → ℝ) : ℕ :=
  Module.finrank ℚ (graphTemporalModule G energy)

/-- Rational module generated by non-reference component-relative
energies. -/
def graphRelativeEnergyModule {V : Type*} (G : SimpleGraph V)
    (energy : V → ℝ) : Submodule ℚ ℝ :=
  Submodule.span ℚ
    (Set.range (fun v : graphNonRoot G =>
      graphRelativeEnergy G energy v.1))

/-- Every component-relative energy lies in the module generated by the
non-reference relative energies. -/
theorem graphRelativeEnergy_mem_module
    {V : Type*} (G : SimpleGraph V) (energy : V → ℝ) (v : V) :
    graphRelativeEnergy G energy v ∈
      graphRelativeEnergyModule G energy := by
  by_cases hv : IsGraphComponentRoot G v
  · rw [graphRelativeEnergy_eq_zero_of_root G energy hv]
    exact Submodule.zero_mem _
  · exact Submodule.subset_span
      ⟨(⟨v, hv⟩ : graphNonRoot G), rfl⟩

/-- Every visible edge gap belongs to the component-relative energy
module. -/
theorem graphVisibleGap_mem_relativeEnergyModule
    {V : Type*} (G : SimpleGraph V) (energy : V → ℝ)
    (p : V × V) :
    graphVisibleGap G energy p ∈
      graphRelativeEnergyModule G energy := by
  classical
  simp only [graphVisibleGap]
  split_ifs with hp
  · rw [energy_sub_eq_graphRelativeEnergy_sub_of_adj G energy hp]
    exact Submodule.sub_mem _
      (graphRelativeEnergy_mem_module G energy p.1)
      (graphRelativeEnergy_mem_module G energy p.2)
  · exact Submodule.zero_mem _

/-- The graph temporal module is contained in the module of component
relative energies. -/
theorem graphTemporalModule_le_relativeEnergyModule
    {V : Type*} (G : SimpleGraph V) (energy : V → ℝ) :
    graphTemporalModule G energy ≤
      graphRelativeEnergyModule G energy := by
  rw [graphTemporalModule, visibleFrequencyModule, Submodule.span_le]
  rintro _ ⟨p, rfl⟩
  exact graphVisibleGap_mem_relativeEnergyModule G energy p

/-- The relative-energy module has rank at most the number of
non-reference vertices. -/
theorem graphRelativeEnergyModule_finrank_le
    {V : Type*} [Fintype V] (G : SimpleGraph V) (energy : V → ℝ) :
    Module.finrank ℚ (graphRelativeEnergyModule G energy) ≤
      Fintype.card (graphNonRoot G) := by
  let s : Set ℝ :=
    Set.range (fun v : graphNonRoot G =>
      graphRelativeEnergy G energy v.1)
  letI : Fintype s := Fintype.ofFinite s
  have hspan :
      Module.finrank ℚ (Submodule.span ℚ s) ≤ s.toFinset.card :=
    finrank_span_le_card s
  calc
    Module.finrank ℚ (graphRelativeEnergyModule G energy) =
        Module.finrank ℚ (Submodule.span ℚ s) := by rfl
    _ ≤ s.toFinset.card := hspan
    _ = Fintype.card s := Set.toFinset_card s
    _ ≤ Fintype.card (graphNonRoot G) := Fintype.card_range_le _

/-- Arithmetic temporal dimension never exceeds the observer graph's
topological phase capacity `vertices - components`. -/
theorem graphTemporalDimension_le_phaseCapacity
    {V : Type*} [Fintype V] (G : SimpleGraph V) (energy : V → ℝ) :
    graphTemporalDimension G energy ≤
      Fintype.card V - Nat.card G.ConnectedComponent := by
  letI : Module.Finite ℚ
      (graphRelativeEnergyModule G energy) := by
    rw [graphRelativeEnergyModule]
    exact Module.Finite.span_of_finite ℚ (Set.finite_range _)
  rw [graphTemporalDimension]
  calc
    Module.finrank ℚ (graphTemporalModule G energy) ≤
        Module.finrank ℚ (graphRelativeEnergyModule G energy) :=
      Submodule.finrank_mono
        (graphTemporalModule_le_relativeEnergyModule G energy)
    _ ≤ Fintype.card (graphNonRoot G) :=
      graphRelativeEnergyModule_finrank_le G energy
    _ = Fintype.card V - Nat.card G.ConnectedComponent :=
      card_graphNonRoot G

/-! ## Arbitrary observer spectral measures -/

/-- Physical spectral phase at time `t` and frequency `x`. -/
def observerSpectralPhase (t x : ℝ) : ℂ :=
  Complex.exp (((t * x : ℝ) : ℂ) * Complex.I)

/-- Observer spectral phase is continuous in frequency. -/
theorem observerSpectralPhase_continuous (t : ℝ) :
    Continuous (observerSpectralPhase t) := by
  unfold observerSpectralPhase
  fun_prop

/-- A physical spectral phase is one exactly on the corresponding
frequency lattice. -/
theorem observerSpectralPhase_eq_one_iff_mem_zmultiples
    {t x : ℝ} (ht : t ≠ 0) :
    observerSpectralPhase t x = 1 ↔
      x ∈ AddSubgroup.zmultiples (2 * Real.pi / t) := by
  constructor
  · intro h
    obtain ⟨n, hn⟩ := Complex.exp_eq_one_iff.mp h
    have hreal : t * x = 2 * Real.pi * n := by
      have him := congrArg Complex.im hn
      calc
        t * x = (n : ℝ) * (2 * Real.pi) := by
          simpa [observerSpectralPhase] using him
        _ = 2 * Real.pi * n := by ring
    rw [AddSubgroup.mem_zmultiples_iff]
    refine ⟨n, ?_⟩
    rw [zsmul_eq_mul]
    calc
      (n : ℝ) * (2 * Real.pi / t) =
          (2 * Real.pi * n) / t := by ring
      _ = (t * x) / t := by rw [hreal]
      _ = x := by field_simp
  · intro h
    rw [AddSubgroup.mem_zmultiples_iff] at h
    obtain ⟨n, rfl⟩ := h
    have htx :
        t * ((n : ℤ) • (2 * Real.pi / t)) =
          (n : ℝ) * (2 * Real.pi) := by
      rw [zsmul_eq_mul]
      field_simp
    rw [observerSpectralPhase, htx]
    convert Complex.exp_int_mul_two_pi_mul_I n using 1
    push_cast
    ring_nf

namespace SpectralMemory

/-- Additive group generated by the topological support of an arbitrary
positive observer spectral measure. -/
def measureVisibleFrequencyGroup (mu : MeasureTheory.Measure ℝ) :
    AddSubgroup ℝ :=
  AddSubgroup.closure mu.support

/-- Rational module generated by the support of an arbitrary observer
spectral measure. -/
def measureVisibleFrequencyModule (mu : MeasureTheory.Measure ℝ) :
    Submodule ℚ ℝ :=
  Submodule.span ℚ mu.support

/-- Cardinal-valued temporal dimension of an arbitrary observer spectral
measure. -/
def measureTemporalDimension (mu : MeasureTheory.Measure ℝ) :
    Cardinal :=
  Module.rank ℚ (measureVisibleFrequencyModule mu)

/-- Exact observer return means phase one almost everywhere in the observer
spectral measure. -/
def measureExactReturn
    (mu : MeasureTheory.Measure ℝ) (t : ℝ) : Prop :=
  observerSpectralPhase t =ᵐ[mu] fun _ => 1

/-- Squared observer displacement integrated against a finite spectral
measure. -/
def measureObserverDisplacementSq
    (mu : MeasureTheory.Measure ℝ) (t : ℝ) : ℝ :=
  ∫ x, ‖observerSpectralPhase t x - 1‖ ^ 2 ∂mu

/-- The squared spectral displacement is integrable for every finite
observer spectral measure. -/
theorem integrable_measureObserverDisplacementSq_integrand
    (mu : MeasureTheory.Measure ℝ) [MeasureTheory.IsFiniteMeasure mu]
    (t : ℝ) :
    MeasureTheory.Integrable
      (fun x => ‖observerSpectralPhase t x - 1‖ ^ 2) mu := by
  refine (MeasureTheory.integrable_const (4 : ℝ)).mono' ?_ ?_
  · exact
      (((observerSpectralPhase_continuous t).sub
        continuous_const).norm.pow 2).aestronglyMeasurable
  · filter_upwards with x
    have hnorm : ‖observerSpectralPhase t x‖ = 1 := by
      exact Complex.norm_exp_ofReal_mul_I (t * x)
    have htri : ‖observerSpectralPhase t x - 1‖ ≤ 2 := by
      calc
        ‖observerSpectralPhase t x - 1‖ ≤
            ‖observerSpectralPhase t x‖ + ‖(1 : ℂ)‖ :=
          norm_sub_le _ _
        _ = 2 := by rw [hnorm]; norm_num
    have hsq : ‖observerSpectralPhase t x - 1‖ ^ 2 ≤ 4 := by
      have hs :=
        (sq_le_sq₀ (norm_nonneg (observerSpectralPhase t x - 1))
          (by norm_num : (0 : ℝ) ≤ 2)).2 htri
      norm_num at hs ⊢
      exact hs
    change ‖(‖observerSpectralPhase t x - 1‖ ^ 2 : ℝ)‖ ≤ 4
    rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
    exact hsq

/-- An observer's integrated displacement vanishes exactly at its
measure-theoretic exact returns. -/
theorem measureObserverDisplacementSq_eq_zero_iff
    (mu : MeasureTheory.Measure ℝ) [MeasureTheory.IsFiniteMeasure mu]
    (t : ℝ) :
    measureObserverDisplacementSq mu t = 0 ↔
      measureExactReturn mu t := by
  rw [measureObserverDisplacementSq, measureExactReturn,
    MeasureTheory.integral_eq_zero_iff_of_nonneg
      (fun _ => sq_nonneg _)
      (integrable_measureObserverDisplacementSq_integrand mu t)]
  constructor
  · intro h
    filter_upwards [h] with x hx
    exact sub_eq_zero.mp (norm_eq_zero.mp (sq_eq_zero_iff.mp hx))
  · intro h
    filter_upwards [h] with x hx
    simp [hx]

/-- Almost-everywhere exact return is equivalent to phase locking at every
point of the spectral support. -/
theorem measureExactReturn_iff_support
    (mu : MeasureTheory.Measure ℝ) (t : ℝ) :
    measureExactReturn mu t ↔
      ∀ x ∈ mu.support, observerSpectralPhase t x = 1 := by
  constructor
  · intro h
    have hclosed :
        IsClosed {x : ℝ | observerSpectralPhase t x = 1} :=
      isClosed_eq (observerSpectralPhase_continuous t) continuous_const
    exact MeasureTheory.Measure.support_subset_of_isClosed hclosed h
  · intro h
    filter_upwards
      [MeasureTheory.Measure.support_mem_ae (μ := mu)] with x hx
    exact h x hx

/-- Exact return of an arbitrary spectral measure is equivalent to
containment of its full visible group in one return lattice. -/
theorem measureExactReturn_iff_group_le_zmultiples
    (mu : MeasureTheory.Measure ℝ) {t : ℝ} (ht : t ≠ 0) :
    measureExactReturn mu t ↔
      measureVisibleFrequencyGroup mu ≤
        AddSubgroup.zmultiples (2 * Real.pi / t) := by
  rw [measureExactReturn_iff_support, measureVisibleFrequencyGroup,
    AddSubgroup.closure_le]
  exact forall_congr' fun x =>
    imp_congr_right fun _ =>
      observerSpectralPhase_eq_one_iff_mem_zmultiples ht

/-- Measure temporal dimension is zero exactly when its visible frequency
group is trivial. -/
theorem measureTemporalDimension_eq_zero_iff_group_eq_bot
    (mu : MeasureTheory.Measure ℝ) :
    measureTemporalDimension mu = 0 ↔
      measureVisibleFrequencyGroup mu = ⊥ := by
  rw [measureTemporalDimension, measureVisibleFrequencyModule,
    Submodule.rank_eq_zero, Submodule.span_eq_bot,
    measureVisibleFrequencyGroup, AddSubgroup.closure_eq_bot_iff]
  simp

/-- Every observer spectral measure has an exclusively dense or cyclic
visible frequency group. -/
theorem measureVisibleFrequencyGroup_dense_xor_cyclic
    (mu : MeasureTheory.Measure ℝ) :
    Xor (Dense (measureVisibleFrequencyGroup mu : Set ℝ))
      (∃ omega : ℝ,
        measureVisibleFrequencyGroup mu =
          AddSubgroup.zmultiples omega) :=
  AddSubgroup.dense_xor_cyclic (measureVisibleFrequencyGroup mu)

/-- An arbitrary observer spectral measure has a positive exact return if and
only if its visible frequency group is cyclic. -/
theorem exists_positive_measureExactReturn_iff_cyclic
    (mu : MeasureTheory.Measure ℝ) :
    (∃ t : ℝ, 0 < t ∧ measureExactReturn mu t) ↔
      ∃ omega : ℝ,
        measureVisibleFrequencyGroup mu =
          AddSubgroup.zmultiples omega := by
  constructor
  · rintro ⟨t, ht, hret⟩
    have hle :
        measureVisibleFrequencyGroup mu ≤
          AddSubgroup.zmultiples (2 * Real.pi / t) :=
      (measureExactReturn_iff_group_le_zmultiples
        mu ht.ne').mp hret
    obtain ⟨n, hn⟩ :=
      (AddSubgroup.le_zmultiples_iff
        (2 * Real.pi / t) (measureVisibleFrequencyGroup mu)).mp hle
    exact ⟨n • (2 * Real.pi / t), hn⟩
  · rintro ⟨omega, hgroup⟩
    by_cases homega : omega = 0
    · refine ⟨1, by norm_num, ?_⟩
      rw [measureExactReturn_iff_group_le_zmultiples
        mu one_ne_zero, hgroup, homega]
      simp
    · let t : ℝ := 2 * Real.pi / |omega|
      have ht : 0 < t := by
        dsimp [t]
        positivity
      refine ⟨t, ht, ?_⟩
      rw [measureExactReturn_iff_group_le_zmultiples
        mu ht.ne', hgroup]
      have hscale : 2 * Real.pi / t = |omega| := by
        dsimp [t]
        field_simp
      rw [hscale]
      by_cases hpos : 0 < omega
      · rw [abs_of_pos hpos]
      · rw [abs_of_nonpos (le_of_not_gt hpos)]
        intro x hx
        rw [AddSubgroup.mem_zmultiples_iff] at hx ⊢
        obtain ⟨n, rfl⟩ := hx
        exact ⟨-n, by simp⟩

/-- Support inclusion makes temporal dimension monotone. -/
theorem measureTemporalDimension_mono_of_support_subset
    {mu nu : MeasureTheory.Measure ℝ}
    (h : mu.support ⊆ nu.support) :
    measureTemporalDimension mu ≤ measureTemporalDimension nu :=
  Submodule.rank_mono (Submodule.span_mono h)

/-- Absolute continuity of observer spectral measures makes temporal
dimension monotone. -/
theorem measureTemporalDimension_mono_of_absolutelyContinuous
    {mu nu : MeasureTheory.Measure ℝ} (h : mu ≪ nu) :
    measureTemporalDimension mu ≤ measureTemporalDimension nu :=
  measureTemporalDimension_mono_of_support_subset h.support_mono

end SpectralMemory

