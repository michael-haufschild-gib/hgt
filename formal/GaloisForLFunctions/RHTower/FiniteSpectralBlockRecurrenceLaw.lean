import Mathlib

/-!
# Finite spectral-block recurrence law

Exact algebraic identities for finite families of coherently evolving blocks.
They isolate the complete dependence of a quadratic recurrence signal on
spectral phases and off-diagonal block weights.
-/

open scoped BigOperators

namespace RHTower

noncomputable section

/-- Squared displacement of a finite array of blocks under scalar phases. -/
def finiteSpectralBlockDistanceSq
    {d : ℕ} {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (phase : Fin d → Fin d → ℂ) (block : Fin d → Fin d → E) : ℝ :=
  ∑ i, ∑ j, ‖phase i j • block i j - block i j‖ ^ (2 : ℕ)

/-- Phase energy associated with a finite array of weighted coherent blocks. -/
def finiteSpectralBlockPhaseEnergy
    {d : ℕ} {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (phase : Fin d → Fin d → ℂ) (block : Fin d → Fin d → E) : ℝ :=
  ∑ i, ∑ j, ‖block i j‖ ^ (2 : ℕ) * ‖phase i j - 1‖ ^ (2 : ℕ)

/--
Universal finite spectral-block law: the full squared displacement is exactly
the sum of the squared block norms weighted by the associated chord lengths.
-/
theorem finiteSpectralBlockDistanceSq_eq_phaseEnergy
    {d : ℕ} {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (phase : Fin d → Fin d → ℂ) (block : Fin d → Fin d → E) :
    finiteSpectralBlockDistanceSq phase block =
      finiteSpectralBlockPhaseEnergy phase block := by
  unfold finiteSpectralBlockDistanceSq finiteSpectralBlockPhaseEnergy
  apply Finset.sum_congr rfl
  intro i _hi
  apply Finset.sum_congr rfl
  intro j _hj
  have h :
      phase i j • block i j - block i j =
        (phase i j - 1) • block i j := by
    module
  rw [h, norm_smul, mul_pow]
  ring

/-- Pairwise spectral phase generated by a finite real energy list. -/
def finiteSpectralHamiltonianPhase {d : ℕ}
    (t : ℝ) (energy : Fin d → ℝ) : Fin d → Fin d → ℂ :=
  fun i j => Complex.exp
    (Complex.I * (((t * (energy i - energy j) : ℝ) : ℂ)))

/--
Hamiltonian specialization of the universal block law: only energy gaps and
the corresponding block norms enter the recurrence signal.
-/
theorem finiteSpectralHamiltonianDistanceSq_eq_gapEnergy
    {d : ℕ} {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (t : ℝ) (energy : Fin d → ℝ) (block : Fin d → Fin d → E) :
    finiteSpectralBlockDistanceSq
        (finiteSpectralHamiltonianPhase t energy) block =
      ∑ i, ∑ j, ‖block i j‖ ^ (2 : ℕ) *
        ‖Complex.exp
          (Complex.I * (((t * (energy i - energy j) : ℝ) : ℂ))) - 1‖ ^ (2 : ℕ) := by
  rw [finiteSpectralBlockDistanceSq_eq_phaseEnergy]
  rfl

/-- Weighted sum of recurrence signals recorded by a finite observer family. -/
def finiteObserverBlockDistanceSq
    {d : ℕ} {J E : Type*} [Fintype J]
    [NormedAddCommGroup E] [NormedSpace ℂ E]
    (lam : J → ℝ) (phase : Fin d → Fin d → ℂ)
    (block : J → Fin d → Fin d → E) : ℝ :=
  ∑ a, lam a * finiteSpectralBlockDistanceSq phase (block a)

/-- Aggregate weight with which an observer family sees a spectral block. -/
def finiteObserverUnionWeight
    {d : ℕ} {J E : Type*} [Fintype J]
    [NormedAddCommGroup E] [NormedSpace ℂ E]
    (lam : J → ℝ) (block : J → Fin d → Fin d → E)
    (i j : Fin d) : ℝ :=
  ∑ a, lam a * ‖block a i j‖ ^ (2 : ℕ)

/--
Observer-union law: a finite collection of quadratic records is exactly one
record whose block weights are the weighted union of the observers' weights.
-/
theorem finiteObserverBlockDistanceSq_eq_unionWeight
    {d : ℕ} {J E : Type*} [Fintype J]
    [NormedAddCommGroup E] [NormedSpace ℂ E]
    (lam : J → ℝ) (phase : Fin d → Fin d → ℂ)
    (block : J → Fin d → Fin d → E) :
    finiteObserverBlockDistanceSq lam phase block =
      ∑ i, ∑ j, finiteObserverUnionWeight lam block i j *
        ‖phase i j - 1‖ ^ (2 : ℕ) := by
  unfold finiteObserverBlockDistanceSq finiteObserverUnionWeight
  simp_rw [finiteSpectralBlockDistanceSq_eq_phaseEnergy,
    finiteSpectralBlockPhaseEnergy, Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i _hi
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro j _hj
  rw [Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro a _ha
  ring

end

end RHTower
