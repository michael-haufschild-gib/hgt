/-!
# Reflection law for Suzuki's actual covariance source

The completed prime--polar--Gamma restricted-Weil form is reflection invariant.  Polarization
upgrades that diagonal invariance to commutation of its coercive metric and covariance with
physical reflection.  Applying the result to Suzuki's literal exponential Riesz sources proves

`C_a exp(-x) = R_a C_a exp(x)`.

Consequently the two raw deficiency norms agree, Suzuki's cross-normalization collapses to one
common scalar, and the actual finite v2 characteristic is generated by a single Fourier carrier
and its reflected carrier:

`A_a(z) = (z-i) P_a(z)`, `E_a(z) = (z+i) P_a(-z)`.

This is an unconditional source-faithful reduction.  It does not identify a cofinal limit with
the Xi target; that remaining step is the arithmetic parity-energy problem for the actual
covariance.
-/

open Complex MeasureTheory Set Filter Topology
open scoped ENNReal InnerProduct FourierTransform LinearPMap
open GaloisForLFunctions.HTGeometry

noncomputable section
namespace RHTower

attribute [local instance] Measure.Subtype.measureSpace

/-- Whole-line reflection restricted to the physical aperture. -/
def suzukiAperturePhysicalReflection (a : SuzukiPositiveAperture) :
    suzukiApertureHilbert a →ₗᵢ[ℂ] suzukiApertureHilbert a where
  toFun f := ⟨l2Reflection f.1, by
    change l2Reflection f.1 ∈ physicalForbidden
      (centralInterval a.1) (measurableSet_centralInterval a.1)
    rw [physicalForbidden, LinearMap.mem_range]
    refine ⟨l2Reflection f.1, ?_⟩
    change indicatorCutoff (centralInterval a.1)
        (measurableSet_centralInterval a.1) (l2Reflection f.1) = l2Reflection f.1
    rw [← l2Reflection_indicatorCutoff_central,
      indicatorCutoff_suzukiApertureHilbert]⟩
  map_add' f g := Subtype.ext (map_add l2Reflection f.1 g.1)
  map_smul' c f := Subtype.ext (map_smul l2Reflection c f.1)
  norm_map' f := l2ReflectionIsometry.norm_map f.1

@[simp] theorem suzukiAperturePhysicalReflection_coe
    (a : SuzukiPositiveAperture) (f : suzukiApertureHilbert a) :
    ((suzukiAperturePhysicalReflection a f : suzukiApertureHilbert a) : SoninL2) =
      l2Reflection (f : SoninL2) := rfl

@[simp] theorem suzukiAperturePhysicalReflection_involutive
    (a : SuzukiPositiveAperture) (f : suzukiApertureHilbert a) :
    suzukiAperturePhysicalReflection a (suzukiAperturePhysicalReflection a f) = f := by
  exact Subtype.ext (l2Reflection_involutive f.1)

/-- Reflection in literal interval coordinates. -/
def suzukiWeilIntervalReflection (a : SuzukiPositiveAperture) :
    SuzukiApertureIntervalL2 a.1 →ₗᵢ[ℂ] SuzukiApertureIntervalL2 a.1 where
  toFun f := (suzukiApertureL2Equiv a).symm
    (suzukiAperturePhysicalReflection a (suzukiApertureL2Equiv a f))
  map_add' f g := by simp
  map_smul' c f := by simp
  norm_map' f := by simp

@[simp] theorem suzukiWeilIntervalReflection_involutive
    (a : SuzukiPositiveAperture) (f : SuzukiApertureIntervalL2 a.1) :
    suzukiWeilIntervalReflection a (suzukiWeilIntervalReflection a f) = f := by
  simp [suzukiWeilIntervalReflection]

@[simp] theorem suzukiApertureL2Equiv_intervalReflection
    (a : SuzukiPositiveAperture) (f : SuzukiApertureIntervalL2 a.1) :
    suzukiApertureL2Equiv a (suzukiWeilIntervalReflection a f) =
      suzukiAperturePhysicalReflection a (suzukiApertureL2Equiv a f) := by
  simp [suzukiWeilIntervalReflection]

theorem suzukiApertureZeroExtendL2_intervalReflection
    (a : SuzukiPositiveAperture) (f : SuzukiApertureIntervalL2 a.1) :
    suzukiApertureZeroExtendL2 (suzukiWeilIntervalReflection a f) =
      l2Reflection (suzukiApertureZeroExtendL2 f) := by
  exact congrArg Subtype.val (suzukiApertureL2Equiv_intervalReflection a f)

theorem suzukiWeilIntervalFormEmbedding_reflection
    (a : SuzukiPositiveAperture) (f : CCMArchimedeanFormDomain a) :
    suzukiWeilIntervalFormEmbedding a (ccmArchimedeanFormReflection a f) =
      suzukiWeilIntervalReflection a (suzukiWeilIntervalFormEmbedding a f) := by
  change (suzukiApertureL2Equiv a).symm
      (ccmArchimedeanFormToAperture a (ccmArchimedeanFormReflection a f)) =
    (suzukiApertureL2Equiv a).symm
      (suzukiAperturePhysicalReflection a
        ((suzukiApertureL2Equiv a)
          ((suzukiApertureL2Equiv a).symm
            (ccmArchimedeanFormToAperture a f))))
  rw [LinearIsometryEquiv.apply_symm_apply]
  apply congrArg (fun q : suzukiApertureHilbert a =>
    (suzukiApertureL2Equiv a).symm q)
  exact Subtype.ext (ccmArchimedeanFormToAperture_reflection a f)

theorem inner_covariant_of_quadratic_invariant
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (T : H →L[ℂ] H) (hT : IsSelfAdjoint T)
    (S : H →ₗᵢ[ℂ] H)
    (hq : ∀ x, inner ℂ (T (S x)) (S x) = inner ℂ (T x) x)
    (x y : H) :
    inner ℂ (T (S x)) (S y) = inner ℂ (T x) y := by
  have hp := hq (x + y)
  have hi := hq (x + I • y)
  have hx := hq x
  have hy := hq y
  simp only [map_add, map_smul, inner_add_left, inner_add_right,
    inner_smul_left, inner_smul_right, conj_I] at hp hi
  have hleft : inner ℂ (T (S y)) (S x) = starRingEnd ℂ (inner ℂ (T (S x)) (S y)) := by
    calc
      inner ℂ (T (S y)) (S x) = inner ℂ (S y) (T (S x)) :=
        hT.isSymmetric (S y) (S x)
      _ = starRingEnd ℂ (inner ℂ (T (S x)) (S y)) :=
        (inner_conj_symm (𝕜 := ℂ) (S y) (T (S x))).symm
  have hright : inner ℂ (T y) x = starRingEnd ℂ (inner ℂ (T x) y) := by
    calc
      inner ℂ (T y) x = inner ℂ y (T x) := hT.isSymmetric y x
      _ = starRingEnd ℂ (inner ℂ (T x) y) :=
        (inner_conj_symm (𝕜 := ℂ) y (T x)).symm
  rw [hleft, hright] at hp hi
  have hsum :
      starRingEnd ℂ (inner ℂ (T (S x)) (S y)) + inner ℂ (T (S x)) (S y) =
        starRingEnd ℂ (inner ℂ (T x) y) + inner ℂ (T x) y := by
    linear_combination hp - hx - hy
  have hdiff :
      -I * starRingEnd ℂ (inner ℂ (T (S x)) (S y)) +
          I * inner ℂ (T (S x)) (S y) =
        -I * starRingEnd ℂ (inner ℂ (T x) y) + I * inner ℂ (T x) y := by
    linear_combination hi - hx + I ^ 2 * hy
  have hdiff' :
      -starRingEnd ℂ (inner ℂ (T (S x)) (S y)) + inner ℂ (T (S x)) (S y) =
        -starRingEnd ℂ (inner ℂ (T x) y) + inner ℂ (T x) y := by
    apply mul_left_cancel₀ Complex.I_ne_zero
    calc
      I * (-starRingEnd ℂ (inner ℂ (T (S x)) (S y)) +
          inner ℂ (T (S x)) (S y)) =
        -I * starRingEnd ℂ (inner ℂ (T (S x)) (S y)) +
          I * inner ℂ (T (S x)) (S y) := by ring
      _ = _ := hdiff
      _ = I * (-starRingEnd ℂ (inner ℂ (T x) y) + inner ℂ (T x) y) := by ring
  linear_combination (1 / 2 : ℂ) * hsum + (1 / 2 : ℂ) * hdiff'

theorem operator_commutes_of_quadratic_invariant
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (T : H →L[ℂ] H) (hT : IsSelfAdjoint T)
    (S : H →ₗᵢ[ℂ] H) (hS : ∀ x, S (S x) = x)
    (hq : ∀ x, inner ℂ (T (S x)) (S x) = inner ℂ (T x) x)
    (x : H) : T (S x) = S (T x) := by
  apply ext_inner_right ℂ
  intro y
  have hcov := inner_covariant_of_quadratic_invariant T hT S hq x (S y)
  rw [hS] at hcov
  calc
    inner ℂ (T (S x)) y = inner ℂ (T x) (S y) := hcov
    _ = inner ℂ (S (T x)) (S (S y)) := (S.inner_map_map (T x) (S y)).symm
    _ = inner ℂ (S (T x)) y := by rw [hS]

theorem suzukiTaMetricRiesz_reflection
    (a : SuzukiPositiveAperture) (f : CCMArchimedeanFormDomain a) :
    boundedPerturbedFormRiesz
        (suzukiWeilIntervalFormEmbedding a)
        (suzukiWeilIntervalBoundedRemainder a)
        (ccmArchimedeanFormReflection a f) =
      ccmArchimedeanFormReflection a
        (boundedPerturbedFormRiesz
          (suzukiWeilIntervalFormEmbedding a)
          (suzukiWeilIntervalBoundedRemainder a) f) := by
  let J := suzukiWeilIntervalFormEmbedding a
  let B := suzukiWeilIntervalBoundedRemainder a
  let R := boundedPerturbedFormRiesz J B
  let S := ccmArchimedeanFormReflection a
  apply operator_commutes_of_quadratic_invariant R
    (boundedPerturbedFormRiesz_isSelfAdjoint J B
      (suzukiWeilIntervalBoundedRemainder_isSelfAdjoint a)) S
    (ccmArchimedeanFormReflection_involutive a)
  intro x
  change inner ℂ (R (S x)) (S x) = inner ℂ (R x) x
  dsimp only [R]
  simp only [boundedPerturbedFormRiesz_apply,
    inner_add_left, inner_add_left, inner_smul_left,
    J.adjoint_inner_left]
  simp only [Complex.conj_ofReal]
  change suzukiWeilIntervalForm a (S x) (S x) +
      (boundedPerturbedFormShift B : ℂ) * inner ℂ (J (S x)) (J (S x)) =
    suzukiWeilIntervalForm a x x +
      (boundedPerturbedFormShift B : ℂ) * inner ℂ (J x) (J x)
  have hInterval : suzukiWeilIntervalForm a (S x) (S x) =
      suzukiWeilIntervalForm a x x := by
    rw [suzukiWeilIntervalForm_eq_ccmRestrictedWeilForm,
      suzukiWeilIntervalForm_eq_ccmRestrictedWeilForm]
    unfold ccmRestrictedWeilForm
    rw [S.inner_map_map,
      inner_ccmRestrictedWeilBoundedRemainder_reflection]
  rw [hInterval]
  have hJ : inner ℂ (J (S x)) (J (S x)) = inner ℂ (J x) (J x) := by
    rw [suzukiWeilIntervalFormEmbedding_reflection]
    exact (suzukiWeilIntervalReflection a).inner_map_map _ _
  rw [hJ]

theorem suzukiApertureRepresentative_exponential_ae
    (a : SuzukiPositiveAperture) (eps : ℝ) :
    suzukiApertureRepresentative (suzukiTaExponentialL2 a eps) =ᵐ[volume]
      fun x : SuzukiApertureInterval a.1 => (Real.exp (eps * (x : ℝ)) : ℂ) := by
  filter_upwards [suzukiApertureRepresentative_ae (suzukiTaExponentialL2 a eps),
    ContinuousMap.coeFn_toLp (p := 2) (𝕜 := ℂ) volume
      (suzukiTaExponentialContinuous a eps)] with x hrep hexp
  rw [hrep]
  simpa [suzukiTaExponentialL2, suzukiTaExponentialContinuous] using hexp

theorem l2Reflection_suzukiApertureZeroExtendL2_exponential
    (a : SuzukiPositiveAperture) (eps : ℝ) :
    l2Reflection (suzukiApertureZeroExtendL2 (suzukiTaExponentialL2 a eps)) =
      suzukiApertureZeroExtendL2 (suzukiTaExponentialL2 a (-eps)) := by
  let s : Set ℝ := Icc (-a.1) a.1
  let ep := suzukiTaExponentialL2 a eps
  let em := suzukiTaExponentialL2 a (-eps)
  have hp : suzukiApertureZeroExtend ep =ᵐ[volume]
      s.indicator (fun x : ℝ => (Real.exp (eps * x) : ℂ)) := by
    apply ae_of_ae_restrict_of_ae_restrict_compl s
    · rw [ae_restrict_iff_subtype measurableSet_Icc]
      filter_upwards [suzukiApertureRepresentative_exponential_ae a eps] with x hx
      change suzukiApertureZeroExtend ep (x : ℝ) =
        s.indicator (fun y : ℝ => (Real.exp (eps * y) : ℂ)) x
      rw [suzukiApertureZeroExtend_apply, Set.indicator_of_mem x.property]
      simpa [ep] using hx
    · filter_upwards [ae_restrict_mem (μ := volume) measurableSet_Icc.compl] with x hx
      have hx' : x ∉ s := hx
      rw [suzukiApertureZeroExtend_eq_zero_of_notMem ep hx',
        Set.indicator_of_notMem hx']
  have hm : suzukiApertureZeroExtend em =ᵐ[volume]
      s.indicator (fun x : ℝ => (Real.exp ((-eps) * x) : ℂ)) := by
    apply ae_of_ae_restrict_of_ae_restrict_compl s
    · rw [ae_restrict_iff_subtype measurableSet_Icc]
      filter_upwards [suzukiApertureRepresentative_exponential_ae a (-eps)] with x hx
      change suzukiApertureZeroExtend em (x : ℝ) =
        s.indicator (fun y : ℝ => (Real.exp ((-eps) * y) : ℂ)) x
      rw [suzukiApertureZeroExtend_apply, Set.indicator_of_mem x.property]
      simpa [em] using hx
    · filter_upwards [ae_restrict_mem (μ := volume) measurableSet_Icc.compl] with x hx
      have hx' : x ∉ s := hx
      rw [suzukiApertureZeroExtend_eq_zero_of_notMem em hx',
        Set.indicator_of_notMem hx']
  have hpNeg := hp.comp_tendsto
    (Measure.measurePreserving_neg (volume : Measure ℝ)).quasiMeasurePreserving.tendsto_ae
  apply Lp.ext
  filter_upwards [l2Reflection_ae (suzukiApertureZeroExtendL2 ep),
    (suzukiApertureZeroExtendL2_coeFn ep).comp_tendsto
      (Measure.measurePreserving_neg (volume : Measure ℝ)).quasiMeasurePreserving.tendsto_ae,
    suzukiApertureZeroExtendL2_coeFn em, hpNeg, hm] with x href hzp hzm hpn hmx
  rw [href]
  change (suzukiApertureZeroExtendL2 ep : ℝ → ℂ) (-x) =
    (suzukiApertureZeroExtendL2 em : ℝ → ℂ) x
  simp only [Function.comp_apply] at hzp hpn
  rw [hzp, hzm, hpn, hmx]
  by_cases hx : x ∈ s
  · have hnx : -x ∈ s := by
      change -a.1 ≤ -x ∧ -x ≤ a.1
      change -a.1 ≤ x ∧ x ≤ a.1 at hx
      constructor <;> linarith
    rw [Set.indicator_of_mem hnx, Set.indicator_of_mem hx]
    congr 2
    ring
  · have hnx : -x ∉ s := by
      intro h
      apply hx
      change -a.1 ≤ x ∧ x ≤ a.1
      change -a.1 ≤ -x ∧ -x ≤ a.1 at h
      constructor <;> linarith
    rw [Set.indicator_of_notMem hnx, Set.indicator_of_notMem hx]

@[simp] theorem suzukiWeilIntervalReflection_exponential
    (a : SuzukiPositiveAperture) (eps : ℝ) :
    suzukiWeilIntervalReflection a (suzukiTaExponentialL2 a eps) =
      suzukiTaExponentialL2 a (-eps) := by
  apply (suzukiApertureL2Equiv a).injective
  rw [suzukiApertureL2Equiv_intervalReflection]
  apply Subtype.ext
  change l2Reflection
      (suzukiApertureZeroExtendL2 (suzukiTaExponentialL2 a eps)) =
    suzukiApertureZeroExtendL2 (suzukiTaExponentialL2 a (-eps))
  exact l2Reflection_suzukiApertureZeroExtendL2_exponential a eps

theorem suzukiWeilIntervalFormAdjoint_reflection
    (a : SuzukiPositiveAperture) (u : SuzukiApertureIntervalL2 a.1) :
    (suzukiWeilIntervalFormEmbedding a).adjoint
        (suzukiWeilIntervalReflection a u) =
      ccmArchimedeanFormReflection a
        ((suzukiWeilIntervalFormEmbedding a).adjoint u) := by
  let J := suzukiWeilIntervalFormEmbedding a
  let S := ccmArchimedeanFormReflection a
  let U := suzukiWeilIntervalReflection a
  apply ext_inner_right ℂ
  intro f
  calc
    inner ℂ (J.adjoint (U u)) f = inner ℂ (U u) (J f) := J.adjoint_inner_left _ _
    _ = inner ℂ (U u) (U (J (S f))) := by
      rw [suzukiWeilIntervalFormEmbedding_reflection,
        suzukiWeilIntervalReflection_involutive]
    _ = inner ℂ u (J (S f)) := U.inner_map_map _ _
    _ = inner ℂ (J.adjoint u) (S f) := (J.adjoint_inner_left _ _).symm
    _ = inner ℂ (S (J.adjoint u)) (S (S f)) := (S.inner_map_map _ _).symm
    _ = inner ℂ (S (J.adjoint u)) f := by
      rw [ccmArchimedeanFormReflection_involutive]

theorem suzukiWeilIntervalFormAdjoint_exponential_reflection
    (a : SuzukiPositiveAperture) (eps : ℝ) :
    (suzukiWeilIntervalFormEmbedding a).adjoint
        (suzukiTaExponentialL2 a (-eps)) =
      ccmArchimedeanFormReflection a
        ((suzukiWeilIntervalFormEmbedding a).adjoint
          (suzukiTaExponentialL2 a eps)) := by
  rw [← suzukiWeilIntervalReflection_exponential]
  exact suzukiWeilIntervalFormAdjoint_reflection a _

theorem suzukiTaMetricRieszInv_reflection
    (a : SuzukiPositiveAperture) (f : CCMArchimedeanFormDomain a) :
    boundedPerturbedFormRieszInv
        (suzukiWeilIntervalFormEmbedding a)
        (suzukiWeilIntervalBoundedRemainder a)
        (suzukiWeilIntervalBoundedRemainder_isSelfAdjoint a)
        (ccmArchimedeanFormReflection a f) =
      ccmArchimedeanFormReflection a
        (boundedPerturbedFormRieszInv
          (suzukiWeilIntervalFormEmbedding a)
          (suzukiWeilIntervalBoundedRemainder a)
          (suzukiWeilIntervalBoundedRemainder_isSelfAdjoint a) f) := by
  let J := suzukiWeilIntervalFormEmbedding a
  let B := suzukiWeilIntervalBoundedRemainder a
  let hB := suzukiWeilIntervalBoundedRemainder_isSelfAdjoint a
  let R := boundedPerturbedFormRiesz J B
  let Rinv := boundedPerturbedFormRieszInv J B hB
  let S := ccmArchimedeanFormReflection a
  apply (boundedPerturbedFormRieszEquiv J B hB).injective
  change R (Rinv (S f)) = R (S (Rinv f))
  have hleft : R (Rinv (S f)) = S f := by
    exact (boundedPerturbedFormRieszEquiv J B hB).apply_symm_apply (S f)
  have hright : R (S (Rinv f)) = S f := by
    rw [suzukiTaMetricRiesz_reflection]
    exact congrArg S ((boundedPerturbedFormRieszEquiv J B hB).apply_symm_apply f)
  rw [hleft, hright]

theorem suzukiWeilIntervalCovariance_reflection
    (a : SuzukiPositiveAperture) (f : SuzukiApertureIntervalL2 a.1) :
    suzukiWeilIntervalCovariance a (suzukiWeilIntervalReflection a f) =
      suzukiWeilIntervalReflection a (suzukiWeilIntervalCovariance a f) := by
  rw [suzukiWeilIntervalCovariance, boundedPerturbedFormCovariance]
  simp only [ContinuousLinearMap.comp_apply]
  rw [suzukiWeilIntervalFormAdjoint_reflection,
    suzukiTaMetricRieszInv_reflection,
    suzukiWeilIntervalFormEmbedding_reflection]

theorem suzukiWeilIntervalCovariance_exponential_reflection
    (a : SuzukiPositiveAperture) (eps : ℝ) :
    suzukiWeilIntervalCovariance a (suzukiTaExponentialL2 a (-eps)) =
      suzukiWeilIntervalReflection a
        (suzukiWeilIntervalCovariance a (suzukiTaExponentialL2 a eps)) := by
  rw [← suzukiWeilIntervalReflection_exponential,
    suzukiWeilIntervalCovariance_reflection]

theorem suzukiTaPhysicalEmbedding_rawDeficiency_reflection
    (a : SuzukiPositiveAperture) (eps : ℝ) :
    suzukiTaPhysicalEmbedding a (suzukiTaRawDeficiency a (-eps)) =
      suzukiWeilIntervalReflection a
        (suzukiTaPhysicalEmbedding a (suzukiTaRawDeficiency a eps)) := by
  rw [suzukiTaPhysicalEmbedding_rawDeficiency_eq_covariance,
    suzukiTaPhysicalEmbedding_rawDeficiency_eq_covariance,
    suzukiWeilIntervalCovariance_exponential_reflection]

theorem norm_suzukiTaRawDeficiency_neg_eq
    (a : SuzukiPositiveAperture) (eps : ℝ) :
    ‖suzukiTaRawDeficiency a (-eps)‖ = ‖suzukiTaRawDeficiency a eps‖ := by
  have hinner :
      inner ℂ (suzukiTaRawDeficiency a (-eps)) (suzukiTaRawDeficiency a (-eps)) =
        inner ℂ (suzukiTaRawDeficiency a eps) (suzukiTaRawDeficiency a eps) := by
    rw [suzukiTaRawDeficiency_inner, suzukiTaRawDeficiency_inner]
    change inner ℂ (suzukiTaExponentialL2 a (-eps))
        (suzukiTaPhysicalEmbedding a (suzukiTaRawDeficiency a (-eps))) =
      inner ℂ (suzukiTaExponentialL2 a eps)
        (suzukiTaPhysicalEmbedding a (suzukiTaRawDeficiency a eps))
    rw [← suzukiWeilIntervalReflection_exponential,
      suzukiTaPhysicalEmbedding_rawDeficiency_reflection]
    exact (suzukiWeilIntervalReflection a).inner_map_map _ _
  rw [inner_self_eq_norm_sq_to_K, inner_self_eq_norm_sq_to_K] at hinner
  have hsquares : ‖suzukiTaRawDeficiency a (-eps)‖ ^ 2 =
      ‖suzukiTaRawDeficiency a eps‖ ^ 2 := by exact_mod_cast hinner
  nlinarith [norm_nonneg (suzukiTaRawDeficiency a (-eps)),
    norm_nonneg (suzukiTaRawDeficiency a eps)]

theorem suzukiTaPhysicalEmbedding_minusDeficiency_reflection
    (a : SuzukiPositiveAperture) :
    suzukiTaPhysicalEmbedding a (suzukiTaMinusDeficiency a) =
      suzukiWeilIntervalReflection a
        (suzukiTaPhysicalEmbedding a (suzukiTaPlusDeficiency a)) := by
  rw [suzukiTaMinusDeficiency, suzukiTaPlusDeficiency, map_smul, map_smul,
    map_smul, suzukiTaPhysicalEmbedding_rawDeficiency_reflection]
  rw [norm_suzukiTaRawDeficiency_neg_eq a 1]

theorem suzukiCompactL2Fourier_l2Reflection
    (a : ℝ) (f : SoninL2) (z : ℂ) :
    suzukiCompactL2Fourier a (l2Reflection f) z =
      suzukiCompactL2Fourier a f (-z) := by
  have hcut : suzukiCutoff a (l2Reflection f) =
      l2Reflection (suzukiCutoff a f) :=
    (l2Reflection_indicatorCutoff_central a f).symm
  rw [suzukiCompactL2Fourier, suzukiCompactL2Fourier]
  change (∫ x : ℝ, (suzukiCutoff a (l2Reflection f) : ℝ → ℂ) x *
      Complex.exp (I * z * (x : ℂ))) =
    ∫ x : ℝ, (suzukiCutoff a f : ℝ → ℂ) x *
      Complex.exp (I * (-z) * (x : ℂ))
  rw [hcut]
  calc
    (∫ x : ℝ, (l2Reflection (suzukiCutoff a f) : ℝ → ℂ) x *
        Complex.exp (I * z * (x : ℂ))) =
      ∫ x : ℝ, (suzukiCutoff a f : ℝ → ℂ) (-x) *
        Complex.exp (I * z * (x : ℂ)) := by
          apply integral_congr_ae
          filter_upwards [l2Reflection_ae (suzukiCutoff a f)] with x hx
          rw [hx]
    _ = ∫ x : ℝ, ((fun y : ℝ => (suzukiCutoff a f : ℝ → ℂ) y *
        Complex.exp (I * (-z) * (y : ℂ))) ∘ (fun y : ℝ => -y)) x := by
          congr 1
          funext x
          simp only [Function.comp_apply]
          congr 1
          congr 1
          push_cast
          ring
    _ = ∫ x : ℝ, (suzukiCutoff a f : ℝ → ℂ) x *
        Complex.exp (I * (-z) * (x : ℂ)) :=
      by
        simpa [Function.comp_apply] using
          (MeasureTheory.integral_neg_eq_self
            (fun x : ℝ => (suzukiCutoff a f : ℝ → ℂ) x *
              Complex.exp (I * (-z) * (x : ℂ))) volume)

theorem suzukiTaPhysicalFourier_minusDeficiency_reflection
    (a : SuzukiPositiveAperture) (z : ℂ) :
    suzukiTaPhysicalFourier a (suzukiTaMinusDeficiency a) z =
      suzukiTaPhysicalFourier a (suzukiTaPlusDeficiency a) (-z) := by
  rw [suzukiTaPhysicalFourier, suzukiTaPhysicalFourier,
    suzukiTaPhysicalEmbedding_minusDeficiency_reflection,
    suzukiApertureZeroExtendL2_intervalReflection,
    suzukiCompactL2Fourier_l2Reflection]

/-- Actual finite Suzuki v2 channels are generated by one covariance-resolvent Fourier carrier. -/
theorem suzukiTaV2_parityPair (a : SuzukiPositiveAperture) :
    GaloisForLFunctions.RHTower.SuzukiParityPair
      (suzukiTaV2CharacteristicA a) (suzukiTaV2CharacteristicE a) := by
  intro z
  constructor
  · rw [suzukiTaV2CharacteristicA, suzukiTaV2CharacteristicE,
      suzukiTaPhysicalFourier_minusDeficiency_reflection]
    ring
  · rw [suzukiTaV2CharacteristicA, suzukiTaV2CharacteristicE,
      suzukiTaPhysicalFourier_minusDeficiency_reflection]
    ring

end RHTower
