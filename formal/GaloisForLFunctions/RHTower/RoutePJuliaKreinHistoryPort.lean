import GaloisForLFunctions.RHTower.RoutePPrimitiveGammaJuliaSignedBivariateStability

/-!
# Route-P Julia--Krein chronological port

The forced P-G105F child/pivot block already contains a two-letter noncommutative carrier.  Its
letters are not invented prime signs: they are its literal child row and its literal negative
Julia--Krein pivot row.  Their opposite two-letter products have a calibrated `1`/`0` readout,
with the calibration forced by the defect square `63 / 64`.

This supplies the target-side chronological port required by the pruned Suzuki history witness.
It does not assert an intertwiner from Suzuki valuations, a Type-B insertion law, a cofinal
assembly, or an RH consequence.
-/

open Complex Matrix
open scoped Kronecker

namespace RHTower

noncomputable section

/-- Literal child-channel row action of the universal P-G105F Julia--Krein block. -/
def routePJuliaKreinChildHistoryStep : Matrix (Fin 2) (Fin 2) ℂ :=
  routePPrimitiveGammaJuliaSignedChannelDiagonal 1 0 *
    routePPrimitiveBurnolJuliaKreinBlock

/-- Literal negative-pivot-channel row action of the universal P-G105F Julia--Krein block. -/
def routePJuliaKreinNegativePivotHistoryStep : Matrix (Fin 2) (Fin 2) ℂ :=
  routePPrimitiveGammaJuliaSignedChannelDiagonal 0 1 *
    routePPrimitiveBurnolJuliaKreinBlock

/-- Free finite-word action generated by actual P Julia--Krein channel steps. -/
def routePJuliaKreinHistoryAction :
    List (Matrix (Fin 2) (Fin 2) ℂ) → Matrix (Fin 2) (Fin 2) ℂ
  | [] => 1
  | A :: word => A * routePJuliaKreinHistoryAction word

@[simp]
theorem routePJuliaKreinHistoryAction_nil :
    routePJuliaKreinHistoryAction [] = 1 := rfl

@[simp]
theorem routePJuliaKreinHistoryAction_cons (A : Matrix (Fin 2) (Fin 2) ℂ)
    (word : List (Matrix (Fin 2) (Fin 2) ℂ)) :
    routePJuliaKreinHistoryAction (A :: word) =
      A * routePJuliaKreinHistoryAction word := rfl

/-- Concatenating target histories is matrix composition in chronological order. -/
theorem routePJuliaKreinHistoryAction_append
    (left right : List (Matrix (Fin 2) (Fin 2) ℂ)) :
    routePJuliaKreinHistoryAction (left ++ right) =
      routePJuliaKreinHistoryAction left * routePJuliaKreinHistoryAction right := by
  induction left with
  | nil => simp [routePJuliaKreinHistoryAction]
  | cons A left ih =>
      simp only [List.cons_append, routePJuliaKreinHistoryAction_cons, ih,
        Matrix.mul_assoc]

/-- The defect-square-normalized child-coordinate observation of a P Julia history. -/
def routePJuliaKreinHistoryReadout (A : Matrix (Fin 2) (Fin 2) ℂ) : ℂ :=
  (64 / 63 : ℂ) * A 0 0

/-- The actual P Julia child and negative-pivot rows distinguish their two chronological orders.
The nonzero amplitude is exactly the forced fourth-depth Julia defect square. -/
theorem routePJuliaKrein_history_ordered_coordinate_asymmetry :
    (routePJuliaKreinChildHistoryStep * routePJuliaKreinNegativePivotHistoryStep) 0 0 =
        (63 / 64 : ℂ) ∧
      (routePJuliaKreinNegativePivotHistoryStep * routePJuliaKreinChildHistoryStep) 0 0 = 0 := by
  have hdefect : (routeEPCubicFourthDepthJuliaDefect : ℂ) ^ 2 = 63 / 64 := by
    calc
      (routeEPCubicFourthDepthJuliaDefect : ℂ) ^ 2 =
          ((routeEPCubicFourthDepthJuliaDefect ^ 2 : ℝ) : ℂ) :=
        (Complex.ofReal_pow _ _).symm
      _ = ((63 / 64 : ℝ) : ℂ) := by
        have h := routeEPCubicFourthDepthJulia_pythagoras
        norm_num [routeEPCubicFourthDepthNormalizedContraction] at h
        congr 1
        nlinarith
      _ = 63 / 64 := Complex.ofReal_div _ _
  constructor <;>
    simp [routePJuliaKreinChildHistoryStep, routePJuliaKreinNegativePivotHistoryStep,
      routePPrimitiveGammaJuliaSignedChannelDiagonal,
      routePPrimitiveBurnolJuliaKreinBlock, Matrix.mul_apply, Fin.sum_univ_two,
      hdefect] <;> ring

/-- The calibrated P target history readout has the same `1`/`0` ordered-value shape as the
literal pruned Suzuki source witness. -/
theorem routePJuliaKreinHistoryReadout_ordered_value_asymmetry :
    routePJuliaKreinHistoryReadout
        (routePJuliaKreinHistoryAction
          [routePJuliaKreinChildHistoryStep, routePJuliaKreinNegativePivotHistoryStep]) = 1 ∧
      routePJuliaKreinHistoryReadout
        (routePJuliaKreinHistoryAction
          [routePJuliaKreinNegativePivotHistoryStep, routePJuliaKreinChildHistoryStep]) = 0 := by
  rw [show routePJuliaKreinHistoryAction
        [routePJuliaKreinChildHistoryStep, routePJuliaKreinNegativePivotHistoryStep] =
        routePJuliaKreinChildHistoryStep * routePJuliaKreinNegativePivotHistoryStep by rfl,
    show routePJuliaKreinHistoryAction
        [routePJuliaKreinNegativePivotHistoryStep, routePJuliaKreinChildHistoryStep] =
        routePJuliaKreinNegativePivotHistoryStep * routePJuliaKreinChildHistoryStep by rfl]
  constructor
  · rw [routePJuliaKreinHistoryReadout,
      routePJuliaKrein_history_ordered_coordinate_asymmetry.1]
    norm_num
  · rw [routePJuliaKreinHistoryReadout,
      routePJuliaKrein_history_ordered_coordinate_asymmetry.2]
    ring

/-- The canonical P Julia channel steps are genuinely noncommuting. -/
theorem routePJuliaKreinChild_negativePivot_noncommuting :
    routePJuliaKreinChildHistoryStep * routePJuliaKreinNegativePivotHistoryStep ≠
      routePJuliaKreinNegativePivotHistoryStep * routePJuliaKreinChildHistoryStep := by
  intro h
  have hcoord := congrArg (fun A : Matrix (Fin 2) (Fin 2) ℂ => A 0 0) h
  rw [routePJuliaKrein_history_ordered_coordinate_asymmetry.1,
    routePJuliaKrein_history_ordered_coordinate_asymmetry.2] at hcoord
  norm_num at hcoord

/-- Full P-G186-incidence channel step: left channel action on the universal Julia block tensored
with the uncompressed incidence matrix. -/
def routePJuliaKreinIncidenceHistoryStep {N : ℕ}
    (H : Matrix (Fin N) (Fin N) ℂ) (z w : ℂ) :
    Matrix (Fin 2 × Fin N) (Fin 2 × Fin N) ℂ :=
  ((routePPrimitiveGammaJuliaSignedChannelDiagonal z w ⊗ₖ
      (1 : Matrix (Fin N) (Fin N) ℂ)) *
    (routePPrimitiveBurnolJuliaKreinBlock ⊗ₖ H))

/-- Full-incidence child-channel history step. -/
def routePJuliaKreinIncidenceChildHistoryStep {N : ℕ}
    (H : Matrix (Fin N) (Fin N) ℂ) :
    Matrix (Fin 2 × Fin N) (Fin 2 × Fin N) ℂ :=
  routePJuliaKreinIncidenceHistoryStep H 1 0

/-- Full-incidence negative-pivot-channel history step. -/
def routePJuliaKreinIncidenceNegativePivotHistoryStep {N : ℕ}
    (H : Matrix (Fin N) (Fin N) ℂ) :
    Matrix (Fin 2 × Fin N) (Fin 2 × Fin N) ℂ :=
  routePJuliaKreinIncidenceHistoryStep H 0 1

/-- The literal full-incidence child step is the child chronology port tensored with every P-G186
incidence entry. -/
theorem routePJuliaKreinIncidenceChildHistoryStep_eq_kronecker {N : ℕ}
    (H : Matrix (Fin N) (Fin N) ℂ) :
    routePJuliaKreinIncidenceChildHistoryStep H =
      routePJuliaKreinChildHistoryStep ⊗ₖ H := by
  rw [routePJuliaKreinIncidenceChildHistoryStep,
    routePJuliaKreinIncidenceHistoryStep, routePJuliaKreinChildHistoryStep,
    ← Matrix.mul_kronecker_mul]

/-- The literal full-incidence pivot step is the negative-pivot chronology port tensored with
every P-G186 incidence entry. -/
theorem routePJuliaKreinIncidenceNegativePivotHistoryStep_eq_kronecker {N : ℕ}
    (H : Matrix (Fin N) (Fin N) ℂ) :
    routePJuliaKreinIncidenceNegativePivotHistoryStep H =
      routePJuliaKreinNegativePivotHistoryStep ⊗ₖ H := by
  rw [routePJuliaKreinIncidenceNegativePivotHistoryStep,
    routePJuliaKreinIncidenceHistoryStep, routePJuliaKreinNegativePivotHistoryStep,
    ← Matrix.mul_kronecker_mul]

/-- Full P-G186 incidence survives the ordered child/pivot distinction exactly: the forward
amplitude is the forced defect square times `H²`, while the reverse amplitude vanishes. -/
theorem routePJuliaKreinIncidence_history_ordered_coordinate_asymmetry {N : ℕ}
    (H : Matrix (Fin N) (Fin N) ℂ) (i j : Fin N) :
    (routePJuliaKreinIncidenceChildHistoryStep H *
        routePJuliaKreinIncidenceNegativePivotHistoryStep H) (0, i) (0, j) =
        (63 / 64 : ℂ) * (H * H) i j ∧
      (routePJuliaKreinIncidenceNegativePivotHistoryStep H *
        routePJuliaKreinIncidenceChildHistoryStep H) (0, i) (0, j) = 0 := by
  rw [routePJuliaKreinIncidenceChildHistoryStep_eq_kronecker,
    routePJuliaKreinIncidenceNegativePivotHistoryStep_eq_kronecker,
    Matrix.mul_kronecker_mul]
  constructor
  · rw [Matrix.kronecker_apply,
      routePJuliaKrein_history_ordered_coordinate_asymmetry.1]
  · rw [Matrix.kronecker_apply,
      routePJuliaKrein_history_ordered_coordinate_asymmetry.2, zero_mul]

/-- The full ordered port specializes without loss to the literal prime-log-conjugated P-G186
window incidence carried by P-G105F. -/
theorem routePPrimitiveBurnolGammaJulia_history_ordered_coordinate_asymmetry {N : ℕ}
    (pe : Fin N → Nat.Primes × ℕ) (kappa : Fin N → ℝ) (i j : Fin N) :
    (routePJuliaKreinIncidenceChildHistoryStep
        (routePPrimitiveJointDepthPrimeLogConjugate pe
          (routePPrimitiveBurnolWindowGramMatrix pe kappa)) *
      routePJuliaKreinIncidenceNegativePivotHistoryStep
        (routePPrimitiveJointDepthPrimeLogConjugate pe
          (routePPrimitiveBurnolWindowGramMatrix pe kappa))) (0, i) (0, j) =
        (63 / 64 : ℂ) *
          ((routePPrimitiveJointDepthPrimeLogConjugate pe
            (routePPrimitiveBurnolWindowGramMatrix pe kappa)) *
            routePPrimitiveJointDepthPrimeLogConjugate pe
              (routePPrimitiveBurnolWindowGramMatrix pe kappa)) i j ∧
      (routePJuliaKreinIncidenceNegativePivotHistoryStep
          (routePPrimitiveJointDepthPrimeLogConjugate pe
            (routePPrimitiveBurnolWindowGramMatrix pe kappa)) *
        routePJuliaKreinIncidenceChildHistoryStep
          (routePPrimitiveJointDepthPrimeLogConjugate pe
            (routePPrimitiveBurnolWindowGramMatrix pe kappa))) (0, i) (0, j) = 0 := by
  exact routePJuliaKreinIncidence_history_ordered_coordinate_asymmetry _ i j

end
end RHTower
