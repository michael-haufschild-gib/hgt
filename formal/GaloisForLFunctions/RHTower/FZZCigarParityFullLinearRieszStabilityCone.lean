import GaloisForLFunctions.RHTower.FZZCigarParityDiagonalRieszStabilityPhaseDiagram

/-!
# Full linear FZZ parity Riesz stability cone

The literal parity-delay source supplies two canonical Hermitian reporters on its indefinite
two-scale Krein block: unit second-scale diagonal energy and the oriented chiral crossing. Their
source-metric Riesz representatives generate the full local real two-parameter interaction plane.

This module classifies that plane exactly at every positive physical scale. All imaginary cross
terms cancel from trace and determinant. Chiral coupling subtracts an exact square from the HC34
diagonal characteristic discriminant, producing a hyperbolic completed-square cone. Actual
spectral reality is equivalent to lying outside this cone. Its interior carries an explicit
positive-imaginary eigenvalue and nonzero neutral eigenvector, while every fixed chiral coupling
has two distinct source-defined diagonal stability branches.

Hence no local linear combination of the two canonical source reporters supplies a rigid FZZ-P
selector. Any surviving dynamical mechanism must be nonlinear, nonlocal/infinite, singular, or
contain an additional independent interaction channel with genuine parity-Mellin landing.
-/

open Complex

namespace RHTower

noncomputable section

/-- Full local linear interaction generated by the literal diagonal and chiral Riesz reporters. -/
def fzzCigarParityDilatedMixedRieszPerturbedKreinOperator
    (beta gamma eta : ℝ) (u : ℂ × ℂ) : ℂ × ℂ :=
  let Au := fzzCigarParityDilatedSecondDiagonalPerturbedKreinOperator beta gamma u
  let Cu := fzzCigarParityDilatedChiralRieszOperator beta u
  (Au.1 + (eta : ℂ) * Cu.1, Au.2 + (eta : ℂ) * Cu.2)

/-- First diagonal coefficient of the mixed source matrix. -/
def fzzCigarParityDilatedMixedRieszDiagOne
    (beta eta : ℝ) : ℂ :=
  (fzzKreinPAt beta : ℂ) -
    Complex.I * ((eta * fzzKreinQAt beta /
      fzzCigarParityDilatedTwoScaleKreinGap beta : ℝ) : ℂ)

/-- Upper coefficient of the mixed source matrix. -/
def fzzCigarParityDilatedMixedRieszUpper
    (beta gamma eta : ℝ) : ℂ :=
  ((fzzKreinQAt beta *
    (1 + gamma / fzzCigarParityDilatedTwoScaleKreinGap beta) : ℝ) : ℂ) -
    Complex.I * ((eta * fzzKreinRAt beta /
      fzzCigarParityDilatedTwoScaleKreinGap beta : ℝ) : ℂ)

/-- Lower coefficient of the mixed source matrix. -/
def fzzCigarParityDilatedMixedRieszLower
    (beta eta : ℝ) : ℂ :=
  -((fzzKreinPAt beta * fzzKreinQAt beta /
      fzzKreinRAt beta : ℝ) : ℂ) +
    Complex.I * ((eta * fzzKreinPAt beta /
      fzzCigarParityDilatedTwoScaleKreinGap beta : ℝ) : ℂ)

/-- Second diagonal coefficient of the mixed source matrix. -/
def fzzCigarParityDilatedMixedRieszDiagTwo
    (beta gamma eta : ℝ) : ℂ :=
  -((fzzKreinPAt beta *
      (1 + gamma / fzzCigarParityDilatedTwoScaleKreinGap beta) : ℝ) : ℂ) +
    Complex.I * ((eta * fzzKreinQAt beta /
      fzzCigarParityDilatedTwoScaleKreinGap beta : ℝ) : ℂ)

theorem fzzCigarParityDilatedMixedRieszPerturbedKreinOperator_matrix
    (beta gamma eta : ℝ) (u : ℂ × ℂ) :
    fzzCigarParityDilatedMixedRieszPerturbedKreinOperator beta gamma eta u =
      (fzzCigarParityDilatedMixedRieszDiagOne beta eta * u.1 +
          fzzCigarParityDilatedMixedRieszUpper beta gamma eta * u.2,
        fzzCigarParityDilatedMixedRieszLower beta eta * u.1 +
          fzzCigarParityDilatedMixedRieszDiagTwo beta gamma eta * u.2) := by
  rcases u with ⟨u₁, u₂⟩
  apply Prod.ext <;>
    simp [fzzCigarParityDilatedMixedRieszPerturbedKreinOperator,
      fzzCigarParityDilatedSecondDiagonalPerturbedKreinOperator,
      fzzCigarParityDilatedTwoScaleKreinOperator,
      fzzCigarParityDilatedSecondDiagonalRieszOperator,
      fzzCigarParityDilatedChiralRieszOperator,
      fzzCigarParityDilatedMixedRieszDiagOne,
      fzzCigarParityDilatedMixedRieszUpper,
      fzzCigarParityDilatedMixedRieszLower,
      fzzCigarParityDilatedMixedRieszDiagTwo] <;>
    ring

/-- Mixed trace is real and independent of the chiral coupling. -/
def fzzCigarParityDilatedMixedRieszTrace
    (beta gamma : ℝ) : ℝ :=
  fzzCigarParityDilatedSecondDiagonalPerturbedTrace beta gamma

/-- Mixed determinant: diagonal determinant plus exact chiral square tax. -/
def fzzCigarParityDilatedMixedRieszDeterminant
    (beta gamma eta : ℝ) : ℝ :=
  fzzCigarParityDilatedSecondDiagonalPerturbedDeterminant beta gamma +
    eta ^ 2 / fzzCigarParityDilatedTwoScaleKreinGap beta

/-- Real characteristic discriminant of the full mixed source matrix. -/
def fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant
    (beta gamma eta : ℝ) : ℝ :=
  fzzCigarParityDilatedMixedRieszTrace beta gamma ^ 2 -
    4 * fzzCigarParityDilatedMixedRieszDeterminant beta gamma eta

theorem fzzCigarParityDilatedMixedRiesz_trace_eq
    (beta gamma eta : ℝ) :
    fzzCigarParityDilatedMixedRieszDiagOne beta eta +
        fzzCigarParityDilatedMixedRieszDiagTwo beta gamma eta =
      (fzzCigarParityDilatedMixedRieszTrace beta gamma : ℂ) := by
  simp [fzzCigarParityDilatedMixedRieszDiagOne,
    fzzCigarParityDilatedMixedRieszDiagTwo,
    fzzCigarParityDilatedMixedRieszTrace,
    fzzCigarParityDilatedSecondDiagonalPerturbedTrace]
  ring

theorem fzzCigarParityDilatedMixedRiesz_determinant_eq
    {beta : ℝ} (hbeta : 0 < beta) (gamma eta : ℝ) :
    fzzCigarParityDilatedMixedRieszDiagOne beta eta *
          fzzCigarParityDilatedMixedRieszDiagTwo beta gamma eta -
        fzzCigarParityDilatedMixedRieszUpper beta gamma eta *
          fzzCigarParityDilatedMixedRieszLower beta eta =
      (fzzCigarParityDilatedMixedRieszDeterminant beta gamma eta : ℂ) := by
  have hE := (fzzCigarParityDilatedTwoScaleKreinGap_pos hbeta).ne'
  have hR := (fzzKreinRAt_pos hbeta).ne'
  have hEC : (fzzCigarParityDilatedTwoScaleKreinGap beta : ℂ) ≠ 0 := by
    exact_mod_cast hE
  have hRC : (fzzKreinRAt beta : ℂ) ≠ 0 := by exact_mod_cast hR
  simp [fzzCigarParityDilatedMixedRieszDiagOne,
    fzzCigarParityDilatedMixedRieszUpper,
    fzzCigarParityDilatedMixedRieszLower,
    fzzCigarParityDilatedMixedRieszDiagTwo,
    fzzCigarParityDilatedMixedRieszDeterminant,
    fzzCigarParityDilatedSecondDiagonalPerturbedDeterminant,
    fzzCigarParityDilatedTwoScaleKreinDiscriminant]
  field_simp [hE, hR, hEC, hRC]
  rw [fzzCigarParityDilatedTwoScaleKreinGap]
  push_cast
  ring_nf
  rw [Complex.I_sq]
  ring

/-- Exact cancellation law for the two-parameter characteristic discriminant. -/
theorem fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant_eq
    (beta gamma eta : ℝ) :
    fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant beta gamma eta =
      fzzCigarParityDilatedSecondDiagonalPerturbedCharacteristicDiscriminant beta gamma -
        4 * eta ^ 2 / fzzCigarParityDilatedTwoScaleKreinGap beta := by
  simp [fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant,
    fzzCigarParityDilatedMixedRieszTrace,
    fzzCigarParityDilatedMixedRieszDeterminant,
    fzzCigarParityDilatedSecondDiagonalPerturbedCharacteristicDiscriminant]
  ring

/-- Every real mixed coupling remains formally self-adjoint for the literal source Krein form. -/
theorem fzzCigarParityDilatedMixedRieszPerturbedKreinOperator_formallySelfAdjoint
    {beta : ℝ} (hbeta : 0 < beta) (gamma eta : ℝ) (u v : ℂ × ℂ) :
    fzzCigarParityDilatedTwoScaleKreinPairing beta
        (fzzCigarParityDilatedMixedRieszPerturbedKreinOperator beta gamma eta u) v =
      fzzCigarParityDilatedTwoScaleKreinPairing beta u
        (fzzCigarParityDilatedMixedRieszPerturbedKreinOperator beta gamma eta v) := by
  rcases u with ⟨u₁, u₂⟩
  rcases v with ⟨v₁, v₂⟩
  have hE := (fzzCigarParityDilatedTwoScaleKreinGap_pos hbeta).ne'
  have hR := (fzzKreinRAt_pos hbeta).ne'
  have hEC : (fzzCigarParityDilatedTwoScaleKreinGap beta : ℂ) ≠ 0 := by
    exact_mod_cast hE
  have hRC : (fzzKreinRAt beta : ℂ) ≠ 0 := by exact_mod_cast hR
  simp [fzzCigarParityDilatedTwoScaleKreinPairing,
    fzzCigarParityDilatedMixedRieszPerturbedKreinOperator,
    fzzCigarParityDilatedSecondDiagonalPerturbedKreinOperator,
    fzzCigarParityDilatedTwoScaleKreinOperator,
    fzzCigarParityDilatedSecondDiagonalRieszOperator,
    fzzCigarParityDilatedChiralRieszOperator,
    Complex.conj_ofReal]
  field_simp [hE, hR, hEC, hRC]
  ring

private theorem twoByTwoComplexEigenvalue_quadratic
    {a b c d lambda : ℂ} {v : ℂ × ℂ}
    (hv : v ≠ 0)
    (heigen :
      (a * v.1 + b * v.2, c * v.1 + d * v.2) = lambda • v) :
    lambda ^ 2 - (a + d) * lambda + (a * d - b * c) = 0 := by
  rcases v with ⟨x, y⟩
  have hfirst := congrArg Prod.fst heigen
  have hsecond := congrArg Prod.snd heigen
  simp only [Prod.smul_fst, Prod.smul_snd, smul_eq_mul] at hfirst hsecond
  have hfirstZero : a * x + b * y - lambda * x = 0 :=
    sub_eq_zero.mpr hfirst
  have hsecondZero : c * x + d * y - lambda * y = 0 :=
    sub_eq_zero.mpr hsecond
  have hxprod :
      (lambda ^ 2 - (a + d) * lambda + (a * d - b * c)) * x = 0 := by
    calc
      (lambda ^ 2 - (a + d) * lambda + (a * d - b * c)) * x =
          -((lambda - d) * (a * x + b * y - lambda * x) +
            b * (c * x + d * y - lambda * y)) := by ring
      _ = 0 := by rw [hfirstZero, hsecondZero]; ring
  have hyprod :
      (lambda ^ 2 - (a + d) * lambda + (a * d - b * c)) * y = 0 := by
    calc
      (lambda ^ 2 - (a + d) * lambda + (a * d - b * c)) * y =
          -(c * (a * x + b * y - lambda * x) +
            (lambda - a) * (c * x + d * y - lambda * y)) := by ring
      _ = 0 := by rw [hfirstZero, hsecondZero]; ring
  by_cases hx : x = 0
  · have hy : y ≠ 0 := by
      intro hy
      apply hv
      simp [hx, hy]
    exact (mul_eq_zero.mp hyprod).resolve_right hy
  · exact (mul_eq_zero.mp hxprod).resolve_right hx

private theorem twoByTwoComplex_eigenpair_of_quadratic_root
    {a b c d lambda : ℂ}
    (hroot : lambda ^ 2 - (a + d) * lambda + (a * d - b * c) = 0) :
    (a * b + b * (lambda - a),
        c * b + d * (lambda - a)) =
      lambda • (b, lambda - a) := by
  apply Prod.ext
  · simp only [Prod.smul_fst, smul_eq_mul]
    ring
  · simp only [Prod.smul_snd, smul_eq_mul]
    linear_combination -hroot

private theorem complexQuadraticRoot_eq_star_of_real_discriminant_nonneg
    {T D : ℝ} {lambda : ℂ}
    (hdisc : 0 ≤ T ^ 2 - 4 * D)
    (hroot : lambda ^ 2 - (T : ℂ) * lambda + (D : ℂ) = 0) :
    lambda = star lambda := by
  have hre := congrArg Complex.re hroot
  have him := congrArg Complex.im hroot
  norm_num [Complex.mul_re, Complex.mul_im, pow_two] at hre him
  by_cases hli : lambda.im = 0
  · apply Complex.ext <;> simp [hli]
  · have hreal : lambda.re = T / 2 := by
      have hfactor : (2 * lambda.re - T) * lambda.im = 0 := by nlinarith
      have := (mul_eq_zero.mp hfactor).resolve_right hli
      linarith
    have hdiscEq : T ^ 2 - 4 * D = -4 * lambda.im ^ 2 := by nlinarith
    nlinarith [sq_pos_of_ne_zero hli]

/-- Every mixed eigenvalue satisfies the real characteristic quadratic. -/
theorem fzzCigarParityDilatedMixedRiesz_eigenvalue_characteristic
    {beta : ℝ} (hbeta : 0 < beta) (gamma eta : ℝ)
    {lambda : ℂ} {v : ℂ × ℂ} (hv : v ≠ 0)
    (heigen :
      fzzCigarParityDilatedMixedRieszPerturbedKreinOperator beta gamma eta v =
        lambda • v) :
    lambda ^ 2 -
        (fzzCigarParityDilatedMixedRieszTrace beta gamma : ℂ) * lambda +
        (fzzCigarParityDilatedMixedRieszDeterminant beta gamma eta : ℂ) = 0 := by
  rw [fzzCigarParityDilatedMixedRieszPerturbedKreinOperator_matrix] at heigen
  have hroot := twoByTwoComplexEigenvalue_quadratic hv heigen
  rw [fzzCigarParityDilatedMixedRiesz_trace_eq,
    fzzCigarParityDilatedMixedRiesz_determinant_eq hbeta] at hroot
  exact hroot

/-- Actual spectral-reality predicate for the full local linear Riesz interaction. -/
def FZZCigarParityDilatedMixedRieszSpectrallyReal
    (beta gamma eta : ℝ) : Prop :=
  ∀ lambda : ℂ, ∀ v : ℂ × ℂ,
    v ≠ 0 →
    fzzCigarParityDilatedMixedRieszPerturbedKreinOperator beta gamma eta v =
      lambda • v →
    lambda = star lambda

theorem fzzCigarParityDilatedMixedRieszSpectrallyReal_of_discriminant_nonneg
    {beta : ℝ} (hbeta : 0 < beta) (gamma eta : ℝ)
    (hdisc : 0 ≤
      fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant beta gamma eta) :
    FZZCigarParityDilatedMixedRieszSpectrallyReal beta gamma eta := by
  intro lambda v hv heigen
  apply complexQuadraticRoot_eq_star_of_real_discriminant_nonneg
  · simpa [fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant] using hdisc
  · exact fzzCigarParityDilatedMixedRiesz_eigenvalue_characteristic
      hbeta gamma eta hv heigen

/-- Positive-imaginary eigenvalue in the negative mixed-discriminant chamber. -/
def fzzCigarParityDilatedMixedRieszInstabilityEigenvalue
    (beta gamma eta : ℝ) : ℂ :=
  (fzzCigarParityDilatedMixedRieszTrace beta gamma / 2 : ℝ) +
    Complex.I *
      (Real.sqrt
        (-fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant
          beta gamma eta) / 2 : ℝ)

/-- Explicit source-coordinate mixed instability eigenvector. -/
def fzzCigarParityDilatedMixedRieszInstabilityEigenvector
    (beta gamma eta : ℝ) : ℂ × ℂ :=
  (fzzCigarParityDilatedMixedRieszUpper beta gamma eta,
    fzzCigarParityDilatedMixedRieszInstabilityEigenvalue beta gamma eta -
      fzzCigarParityDilatedMixedRieszDiagOne beta eta)

theorem fzzCigarParityDilatedMixedRieszInstabilityEigenvalue_root
    {beta gamma eta : ℝ}
    (hdisc :
      fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant beta gamma eta < 0) :
    fzzCigarParityDilatedMixedRieszInstabilityEigenvalue beta gamma eta ^ 2 -
        (fzzCigarParityDilatedMixedRieszTrace beta gamma : ℂ) *
          fzzCigarParityDilatedMixedRieszInstabilityEigenvalue beta gamma eta +
        (fzzCigarParityDilatedMixedRieszDeterminant beta gamma eta : ℂ) = 0 := by
  let T := fzzCigarParityDilatedMixedRieszTrace beta gamma
  let D := fzzCigarParityDilatedMixedRieszDeterminant beta gamma eta
  let disc :=
    fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant beta gamma eta
  let y := Real.sqrt (-disc) / 2
  have hdiscEq : disc = T ^ 2 - 4 * D := by rfl
  have hnonneg : 0 ≤ -disc := by
    dsimp [disc]
    linarith
  have hy2 : y ^ 2 = -disc / 4 := by
    dsimp [y]
    rw [div_pow, Real.sq_sqrt hnonneg]
    norm_num
  have heigenvalue :
      fzzCigarParityDilatedMixedRieszInstabilityEigenvalue beta gamma eta =
        (T / 2 : ℝ) + Complex.I * (y : ℝ) := by rfl
  rw [heigenvalue]
  apply Complex.ext
  · norm_num [Complex.mul_re, Complex.mul_im, pow_two]
    nlinarith [hy2, hdiscEq]
  · norm_num [Complex.mul_re, Complex.mul_im, pow_two]
    ring

theorem fzzCigarParityDilatedMixedRieszInstabilityEigenvalue_im_pos
    {beta gamma eta : ℝ}
    (hdisc :
      fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant beta gamma eta < 0) :
    0 < (fzzCigarParityDilatedMixedRieszInstabilityEigenvalue beta gamma eta).im := by
  rw [fzzCigarParityDilatedMixedRieszInstabilityEigenvalue]
  simp only [add_im, ofReal_im, zero_add, mul_im, I_re, mul_zero, I_im,
    ofReal_re]
  have hsqrt := Real.sqrt_pos.2 (neg_pos.mpr hdisc)
  nlinarith

theorem fzzCigarParityDilatedMixedRieszInstabilityEigenvalue_not_real
    {beta gamma eta : ℝ}
    (hdisc :
      fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant beta gamma eta < 0) :
    fzzCigarParityDilatedMixedRieszInstabilityEigenvalue beta gamma eta ≠
      star (fzzCigarParityDilatedMixedRieszInstabilityEigenvalue beta gamma eta) := by
  intro h
  have him := congrArg Complex.im h
  have hstar :
      (star
        (fzzCigarParityDilatedMixedRieszInstabilityEigenvalue beta gamma eta)).im =
        -(fzzCigarParityDilatedMixedRieszInstabilityEigenvalue beta gamma eta).im := by
    change ((starRingEnd ℂ)
      (fzzCigarParityDilatedMixedRieszInstabilityEigenvalue beta gamma eta)).im = _
    exact Complex.conj_im _
  rw [hstar] at him
  linarith [fzzCigarParityDilatedMixedRieszInstabilityEigenvalue_im_pos hdisc]

theorem fzzCigarParityDilatedMixedRieszUpper_ne_zero_of_discriminant_neg
    {beta : ℝ} (hbeta : 0 < beta) {gamma eta : ℝ}
    (hdisc :
      fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant beta gamma eta < 0) :
    fzzCigarParityDilatedMixedRieszUpper beta gamma eta ≠ 0 := by
  intro hupper
  have hre := congrArg Complex.re hupper
  have him := congrArg Complex.im hupper
  norm_num [fzzCigarParityDilatedMixedRieszUpper, Complex.mul_re,
    Complex.mul_im] at hre him
  have hQ := (fzzKreinQAt_pos hbeta).ne'
  have hR := (fzzKreinRAt_pos hbeta).ne'
  have hE := (fzzCigarParityDilatedTwoScaleKreinGap_pos hbeta).ne'
  have halpha :
      1 + gamma / fzzCigarParityDilatedTwoScaleKreinGap beta = 0 :=
    hre.resolve_left hQ
  have heta : eta = 0 := by
    rcases him with (heta | hRzero) | hEzero
    · exact heta
    · exact False.elim (hR hRzero)
    · exact False.elim (hE hEzero)
  have hx : gamma / fzzCigarParityDilatedTwoScaleKreinGap beta = -1 := by
    linarith
  rw [fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant,
    fzzCigarParityDilatedMixedRieszTrace,
    fzzCigarParityDilatedMixedRieszDeterminant,
    fzzCigarParityDilatedSecondDiagonalPerturbedTrace,
    fzzCigarParityDilatedSecondDiagonalPerturbedDeterminant,
    heta, hx] at hdisc
  simp at hdisc
  nlinarith [sq_nonneg (fzzKreinPAt beta)]

theorem fzzCigarParityDilatedMixedRieszInstabilityEigenvector_ne_zero
    {beta : ℝ} (hbeta : 0 < beta) {gamma eta : ℝ}
    (hdisc :
      fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant beta gamma eta < 0) :
    fzzCigarParityDilatedMixedRieszInstabilityEigenvector beta gamma eta ≠ 0 := by
  intro hzero
  have hfirst := congrArg Prod.fst hzero
  simp only [fzzCigarParityDilatedMixedRieszInstabilityEigenvector,
    Prod.fst_zero] at hfirst
  exact (fzzCigarParityDilatedMixedRieszUpper_ne_zero_of_discriminant_neg
    hbeta hdisc) hfirst

/-- Every point of the negative mixed chamber carries an explicit nonreal eigenpair. -/
theorem fzzCigarParityDilatedMixedRieszInstabilityEigenpair
    {beta : ℝ} (hbeta : 0 < beta) {gamma eta : ℝ}
    (hdisc :
      fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant beta gamma eta < 0) :
    fzzCigarParityDilatedMixedRieszPerturbedKreinOperator beta gamma eta
        (fzzCigarParityDilatedMixedRieszInstabilityEigenvector beta gamma eta) =
      fzzCigarParityDilatedMixedRieszInstabilityEigenvalue beta gamma eta •
        fzzCigarParityDilatedMixedRieszInstabilityEigenvector beta gamma eta := by
  have hroot := fzzCigarParityDilatedMixedRieszInstabilityEigenvalue_root hdisc
  rw [← fzzCigarParityDilatedMixedRiesz_trace_eq beta gamma eta,
    ← fzzCigarParityDilatedMixedRiesz_determinant_eq hbeta gamma eta] at hroot
  have hp := twoByTwoComplex_eigenpair_of_quadratic_root hroot
  rw [fzzCigarParityDilatedMixedRieszPerturbedKreinOperator_matrix]
  simpa [fzzCigarParityDilatedMixedRieszInstabilityEigenvector] using hp

/-- The explicit mixed instability mode is neutral for the literal source Krein form. -/
theorem fzzCigarParityDilatedMixedRieszInstabilityEigenvector_null
    {beta : ℝ} (hbeta : 0 < beta) {gamma eta : ℝ}
    (hdisc :
      fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant beta gamma eta < 0) :
    fzzCigarParityDilatedTwoScaleKreinPairing beta
        (fzzCigarParityDilatedMixedRieszInstabilityEigenvector beta gamma eta)
        (fzzCigarParityDilatedMixedRieszInstabilityEigenvector beta gamma eta) = 0 := by
  have hself :=
    fzzCigarParityDilatedMixedRieszPerturbedKreinOperator_formallySelfAdjoint
      hbeta gamma eta
      (fzzCigarParityDilatedMixedRieszInstabilityEigenvector beta gamma eta)
      (fzzCigarParityDilatedMixedRieszInstabilityEigenvector beta gamma eta)
  rw [fzzCigarParityDilatedMixedRieszInstabilityEigenpair hbeta hdisc] at hself
  rw [fzzCigarParityDilatedTwoScaleKreinPairing_smul_left,
    fzzCigarParityDilatedTwoScaleKreinPairing_smul_right] at hself
  have hfactor :
      (star (fzzCigarParityDilatedMixedRieszInstabilityEigenvalue beta gamma eta) -
          fzzCigarParityDilatedMixedRieszInstabilityEigenvalue beta gamma eta) *
        fzzCigarParityDilatedTwoScaleKreinPairing beta
          (fzzCigarParityDilatedMixedRieszInstabilityEigenvector beta gamma eta)
          (fzzCigarParityDilatedMixedRieszInstabilityEigenvector beta gamma eta) = 0 := by
    calc
      (star (fzzCigarParityDilatedMixedRieszInstabilityEigenvalue beta gamma eta) -
            fzzCigarParityDilatedMixedRieszInstabilityEigenvalue beta gamma eta) *
          fzzCigarParityDilatedTwoScaleKreinPairing beta
            (fzzCigarParityDilatedMixedRieszInstabilityEigenvector beta gamma eta)
            (fzzCigarParityDilatedMixedRieszInstabilityEigenvector beta gamma eta) =
        star (fzzCigarParityDilatedMixedRieszInstabilityEigenvalue beta gamma eta) *
            fzzCigarParityDilatedTwoScaleKreinPairing beta
              (fzzCigarParityDilatedMixedRieszInstabilityEigenvector beta gamma eta)
              (fzzCigarParityDilatedMixedRieszInstabilityEigenvector beta gamma eta) -
          fzzCigarParityDilatedMixedRieszInstabilityEigenvalue beta gamma eta *
            fzzCigarParityDilatedTwoScaleKreinPairing beta
              (fzzCigarParityDilatedMixedRieszInstabilityEigenvector beta gamma eta)
              (fzzCigarParityDilatedMixedRieszInstabilityEigenvector beta gamma eta) := by ring
      _ = 0 := sub_eq_zero.mpr hself
  exact (mul_eq_zero.mp hfactor).resolve_left
    (sub_ne_zero.mpr
      (fzzCigarParityDilatedMixedRieszInstabilityEigenvalue_not_real hdisc).symm)

theorem not_fzzCigarParityDilatedMixedRieszSpectrallyReal_of_discriminant_neg
    {beta : ℝ} (hbeta : 0 < beta) {gamma eta : ℝ}
    (hdisc :
      fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant beta gamma eta < 0) :
    ¬ FZZCigarParityDilatedMixedRieszSpectrallyReal beta gamma eta := by
  intro hreal
  exact fzzCigarParityDilatedMixedRieszInstabilityEigenvalue_not_real hdisc
    (hreal
      (fzzCigarParityDilatedMixedRieszInstabilityEigenvalue beta gamma eta)
      (fzzCigarParityDilatedMixedRieszInstabilityEigenvector beta gamma eta)
      (fzzCigarParityDilatedMixedRieszInstabilityEigenvector_ne_zero hbeta hdisc)
      (fzzCigarParityDilatedMixedRieszInstabilityEigenpair hbeta hdisc))

/-- Actual mixed spectral reality is equivalent to the exact real discriminant inequality. -/
theorem fzzCigarParityDilatedMixedRieszSpectrallyReal_iff_discriminant_nonneg
    {beta : ℝ} (hbeta : 0 < beta) (gamma eta : ℝ) :
    FZZCigarParityDilatedMixedRieszSpectrallyReal beta gamma eta ↔
      0 ≤ fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant beta gamma eta := by
  constructor
  · intro hreal
    by_contra hnot
    have hneg :
        fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant beta gamma eta < 0 :=
      lt_of_not_ge hnot
    exact (not_fzzCigarParityDilatedMixedRieszSpectrallyReal_of_discriminant_neg
      hbeta hneg) hreal
  · exact fzzCigarParityDilatedMixedRieszSpectrallyReal_of_discriminant_nonneg
      hbeta gamma eta

/-- Chiral-broadened radial threshold of the full mixed stability cone. -/
def fzzCigarParityDilatedMixedRieszStabilityRadius
    (beta eta : ℝ) : ℝ :=
  Real.sqrt
    (fzzCigarParityDilatedDiagonalStabilityRadius beta ^ 2 +
      4 * eta ^ 2 /
        (fzzCigarParityDilatedTwoScaleKreinGap beta * fzzKreinPAt beta ^ 2))

theorem fzzCigarParityDilatedMixedRieszStabilityRadius_pos
    {beta : ℝ} (hbeta : 0 < beta) (eta : ℝ) :
    0 < fzzCigarParityDilatedMixedRieszStabilityRadius beta eta := by
  rw [fzzCigarParityDilatedMixedRieszStabilityRadius]
  have hr := fzzCigarParityDilatedDiagonalStabilityRadius_pos hbeta
  have hE := fzzCigarParityDilatedTwoScaleKreinGap_pos hbeta
  have hP := fzzKreinPAt_pos hbeta
  apply Real.sqrt_pos.2
  have htax : 0 ≤ 4 * eta ^ 2 /
      (fzzCigarParityDilatedTwoScaleKreinGap beta * fzzKreinPAt beta ^ 2) := by
    positivity
  nlinarith [sq_pos_of_pos hr]

/-- Hyperbolic completed-square normal form of the full two-parameter discriminant. -/
theorem fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant_eq_squareCone
    {beta : ℝ} (hbeta : 0 < beta) (gamma eta : ℝ) :
    fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant beta gamma eta =
      fzzKreinPAt beta ^ 2 *
        ((gamma / fzzCigarParityDilatedTwoScaleKreinGap beta -
            fzzCigarParityDilatedDiagonalStabilityCenter beta) ^ 2 -
          fzzCigarParityDilatedMixedRieszStabilityRadius beta eta ^ 2) := by
  have hE := (fzzCigarParityDilatedTwoScaleKreinGap_pos hbeta).ne'
  have hP := (fzzKreinPAt_pos hbeta).ne'
  have hnonneg : 0 ≤
      fzzCigarParityDilatedDiagonalStabilityRadius beta ^ 2 +
        4 * eta ^ 2 /
          (fzzCigarParityDilatedTwoScaleKreinGap beta * fzzKreinPAt beta ^ 2) := by
    have hEpos := fzzCigarParityDilatedTwoScaleKreinGap_pos hbeta
    have hPpos := fzzKreinPAt_pos hbeta
    positivity
  rw [fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant_eq,
    fzzCigarParityDilatedSecondDiagonalPerturbedCharacteristicDiscriminant_eq_squareWindow
      hbeta,
    fzzCigarParityDilatedMixedRieszStabilityRadius,
    Real.sq_sqrt hnonneg]
  field_simp [hE, hP]
  ring

theorem fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant_neg_iff
    {beta : ℝ} (hbeta : 0 < beta) (gamma eta : ℝ) :
    fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant beta gamma eta < 0 ↔
      |gamma / fzzCigarParityDilatedTwoScaleKreinGap beta -
          fzzCigarParityDilatedDiagonalStabilityCenter beta| <
        fzzCigarParityDilatedMixedRieszStabilityRadius beta eta := by
  rw [fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant_eq_squareCone
    hbeta]
  have hP2 : 0 < fzzKreinPAt beta ^ 2 := sq_pos_of_pos (fzzKreinPAt_pos hbeta)
  have hr := fzzCigarParityDilatedMixedRieszStabilityRadius_pos hbeta eta
  let x := gamma / fzzCigarParityDilatedTwoScaleKreinGap beta -
    fzzCigarParityDilatedDiagonalStabilityCenter beta
  let r := fzzCigarParityDilatedMixedRieszStabilityRadius beta eta
  have hr' : 0 < r := by simpa [r] using hr
  constructor
  · intro h
    have hs : x ^ 2 < r ^ 2 := by
      change fzzKreinPAt beta ^ 2 * (x ^ 2 - r ^ 2) < 0 at h
      nlinarith
    change |x| < r
    simpa [abs_of_pos hr'] using (sq_lt_sq.mp hs)
  · intro h
    have hs : x ^ 2 < r ^ 2 := by
      change |x| < r at h
      exact sq_lt_sq.mpr (by simpa [abs_of_pos hr'] using h)
    change fzzKreinPAt beta ^ 2 * (x ^ 2 - r ^ 2) < 0
    nlinarith

theorem fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant_nonneg_iff
    {beta : ℝ} (hbeta : 0 < beta) (gamma eta : ℝ) :
    0 ≤ fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant beta gamma eta ↔
      fzzCigarParityDilatedMixedRieszStabilityRadius beta eta ≤
        |gamma / fzzCigarParityDilatedTwoScaleKreinGap beta -
          fzzCigarParityDilatedDiagonalStabilityCenter beta| := by
  rw [← not_lt, ← not_lt,
    fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant_neg_iff
      hbeta gamma eta]

/-- **Exact full linear stability cone.** Mixed spectral reality lies precisely outside the
chiral-broadened source window. -/
theorem fzzCigarParityDilatedMixedRieszSpectrallyReal_iff_outside_cone
    {beta : ℝ} (hbeta : 0 < beta) (gamma eta : ℝ) :
    FZZCigarParityDilatedMixedRieszSpectrallyReal beta gamma eta ↔
      fzzCigarParityDilatedMixedRieszStabilityRadius beta eta ≤
        |gamma / fzzCigarParityDilatedTwoScaleKreinGap beta -
          fzzCigarParityDilatedDiagonalStabilityCenter beta| := by
  rw [fzzCigarParityDilatedMixedRieszSpectrallyReal_iff_discriminant_nonneg
      hbeta gamma eta,
    fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant_nonneg_iff
      hbeta gamma eta]

def fzzCigarParityDilatedMixedRieszStabilityLowerCoupling
    (beta eta : ℝ) : ℝ :=
  fzzCigarParityDilatedTwoScaleKreinGap beta *
    (fzzCigarParityDilatedDiagonalStabilityCenter beta -
      fzzCigarParityDilatedMixedRieszStabilityRadius beta eta)

def fzzCigarParityDilatedMixedRieszStabilityUpperCoupling
    (beta eta : ℝ) : ℝ :=
  fzzCigarParityDilatedTwoScaleKreinGap beta *
    (fzzCigarParityDilatedDiagonalStabilityCenter beta +
      fzzCigarParityDilatedMixedRieszStabilityRadius beta eta)

theorem fzzCigarParityDilatedMixedRieszStabilityLowerCoupling_lt_upper
    {beta : ℝ} (hbeta : 0 < beta) (eta : ℝ) :
    fzzCigarParityDilatedMixedRieszStabilityLowerCoupling beta eta <
      fzzCigarParityDilatedMixedRieszStabilityUpperCoupling beta eta := by
  rw [fzzCigarParityDilatedMixedRieszStabilityLowerCoupling,
    fzzCigarParityDilatedMixedRieszStabilityUpperCoupling]
  have hE := fzzCigarParityDilatedTwoScaleKreinGap_pos hbeta
  have hr := fzzCigarParityDilatedMixedRieszStabilityRadius_pos hbeta eta
  nlinarith

theorem fzzCigarParityDilatedMixedRieszSpectrallyReal_lowerBoundary
    {beta : ℝ} (hbeta : 0 < beta) (eta : ℝ) :
    FZZCigarParityDilatedMixedRieszSpectrallyReal beta
      (fzzCigarParityDilatedMixedRieszStabilityLowerCoupling beta eta) eta := by
  rw [fzzCigarParityDilatedMixedRieszSpectrallyReal_iff_outside_cone hbeta]
  have hE := (fzzCigarParityDilatedTwoScaleKreinGap_pos hbeta).ne'
  have hr := fzzCigarParityDilatedMixedRieszStabilityRadius_pos hbeta eta
  rw [fzzCigarParityDilatedMixedRieszStabilityLowerCoupling]
  have hquot :
      fzzCigarParityDilatedTwoScaleKreinGap beta *
            (fzzCigarParityDilatedDiagonalStabilityCenter beta -
              fzzCigarParityDilatedMixedRieszStabilityRadius beta eta) /
          fzzCigarParityDilatedTwoScaleKreinGap beta =
        fzzCigarParityDilatedDiagonalStabilityCenter beta -
          fzzCigarParityDilatedMixedRieszStabilityRadius beta eta := by
    field_simp [hE]
  rw [hquot]
  rw [show
      fzzCigarParityDilatedDiagonalStabilityCenter beta -
            fzzCigarParityDilatedMixedRieszStabilityRadius beta eta -
          fzzCigarParityDilatedDiagonalStabilityCenter beta =
        -fzzCigarParityDilatedMixedRieszStabilityRadius beta eta by ring,
    abs_neg, abs_of_pos hr]

theorem fzzCigarParityDilatedMixedRieszSpectrallyReal_upperBoundary
    {beta : ℝ} (hbeta : 0 < beta) (eta : ℝ) :
    FZZCigarParityDilatedMixedRieszSpectrallyReal beta
      (fzzCigarParityDilatedMixedRieszStabilityUpperCoupling beta eta) eta := by
  rw [fzzCigarParityDilatedMixedRieszSpectrallyReal_iff_outside_cone hbeta]
  have hE := (fzzCigarParityDilatedTwoScaleKreinGap_pos hbeta).ne'
  have hr := fzzCigarParityDilatedMixedRieszStabilityRadius_pos hbeta eta
  rw [fzzCigarParityDilatedMixedRieszStabilityUpperCoupling]
  have hquot :
      fzzCigarParityDilatedTwoScaleKreinGap beta *
            (fzzCigarParityDilatedDiagonalStabilityCenter beta +
              fzzCigarParityDilatedMixedRieszStabilityRadius beta eta) /
          fzzCigarParityDilatedTwoScaleKreinGap beta =
        fzzCigarParityDilatedDiagonalStabilityCenter beta +
          fzzCigarParityDilatedMixedRieszStabilityRadius beta eta := by
    field_simp [hE]
  rw [hquot]
  rw [show
      fzzCigarParityDilatedDiagonalStabilityCenter beta +
            fzzCigarParityDilatedMixedRieszStabilityRadius beta eta -
          fzzCigarParityDilatedDiagonalStabilityCenter beta =
        fzzCigarParityDilatedMixedRieszStabilityRadius beta eta by ring,
    abs_of_pos hr]

/-- **Full local-linear nonuniqueness.** Every chiral coupling admits two distinct source-defined
diagonal stabilizations, while the interval between them contains the nonreal neutral chamber. -/
theorem fzzCigarParityDilatedMixedRiesz_twoStableBranches
    {beta : ℝ} (hbeta : 0 < beta) (eta : ℝ) :
    fzzCigarParityDilatedMixedRieszStabilityLowerCoupling beta eta <
        fzzCigarParityDilatedMixedRieszStabilityUpperCoupling beta eta ∧
      FZZCigarParityDilatedMixedRieszSpectrallyReal beta
        (fzzCigarParityDilatedMixedRieszStabilityLowerCoupling beta eta) eta ∧
      FZZCigarParityDilatedMixedRieszSpectrallyReal beta
        (fzzCigarParityDilatedMixedRieszStabilityUpperCoupling beta eta) eta := by
  exact ⟨fzzCigarParityDilatedMixedRieszStabilityLowerCoupling_lt_upper hbeta eta,
    fzzCigarParityDilatedMixedRieszSpectrallyReal_lowerBoundary hbeta eta,
    fzzCigarParityDilatedMixedRieszSpectrallyReal_upperBoundary hbeta eta⟩

/-- Every coupling strictly between the two stability sheets carries the explicit nonreal neutral
mode and is not spectrally real. -/
theorem not_fzzCigarParityDilatedMixedRieszSpectrallyReal_of_between_boundaries
    {beta : ℝ} (hbeta : 0 < beta) {gamma eta : ℝ}
    (hlow : fzzCigarParityDilatedMixedRieszStabilityLowerCoupling beta eta < gamma)
    (hupp : gamma < fzzCigarParityDilatedMixedRieszStabilityUpperCoupling beta eta) :
    ¬ FZZCigarParityDilatedMixedRieszSpectrallyReal beta gamma eta := by
  have hEpos := fzzCigarParityDilatedTwoScaleKreinGap_pos hbeta
  have hr := fzzCigarParityDilatedMixedRieszStabilityRadius_pos hbeta eta
  rw [fzzCigarParityDilatedMixedRieszStabilityLowerCoupling] at hlow
  rw [fzzCigarParityDilatedMixedRieszStabilityUpperCoupling] at hupp
  have hlowDiv :
      fzzCigarParityDilatedDiagonalStabilityCenter beta -
          fzzCigarParityDilatedMixedRieszStabilityRadius beta eta <
        gamma / fzzCigarParityDilatedTwoScaleKreinGap beta := by
    apply (lt_div_iff₀ hEpos).2
    simpa [mul_comm] using hlow
  have huppDiv :
      gamma / fzzCigarParityDilatedTwoScaleKreinGap beta <
        fzzCigarParityDilatedDiagonalStabilityCenter beta +
          fzzCigarParityDilatedMixedRieszStabilityRadius beta eta := by
    apply (div_lt_iff₀ hEpos).2
    simpa [mul_comm] using hupp
  have habs :
      |gamma / fzzCigarParityDilatedTwoScaleKreinGap beta -
          fzzCigarParityDilatedDiagonalStabilityCenter beta| <
        fzzCigarParityDilatedMixedRieszStabilityRadius beta eta := by
    rw [abs_lt]
    constructor <;> linarith
  have hdisc :=
    (fzzCigarParityDilatedMixedRieszCharacteristicDiscriminant_neg_iff
      hbeta gamma eta).2 habs
  exact not_fzzCigarParityDilatedMixedRieszSpectrallyReal_of_discriminant_neg
    hbeta hdisc

end

