/-
# The Guinand--Weil explicit formula on the regularized Cauchy test algebra

For a single centered base point `z` the regulator-independent identity

`∑' q, (a_q⁻¹ - (a_q - z)⁻¹) = -I·(-ζ'/ζ - Γ_ℝ'/Γ_ℝ)(1/2 + z I)`

pairs one regularized Cauchy kernel evaluated on the exact centered Xi divisor `a_q`
against the continued prime plus archimedean source.  This module promotes that
rank-one identity to the full linear test algebra generated by these kernels.

A test function `h = ∑ i ∈ t, c i · (·⁻¹ - (· - z i)⁻¹)` is an arbitrary finite
`ℂ`-linear superposition of regularized Cauchy kernels.  Its sum over the centered Xi
divisor equals the matching superposition of the continued prime--archimedean source
traces.  The zero side is a genuine `tsum` over the multiplicity-exact divisor and the
source side is built from the von-Mangoldt carrier `-ζ'/ζ` and the fixed archimedean
factor, with no zero enumeration.  This is the Guinand--Weil explicit formula for the
resolvent test class: the spectral sum over the Xi zeros equals a prime sum minus an
archimedean term.
-/
import GaloisForLFunctions.RHTower.XiRelativeResolventFlux

open Complex Function

namespace RHTower

noncomputable section

/-- Admissibility of a centered base point: its Xi coordinate `s = 1/2 + z I` lies in the
right half-plane, avoids the boundary point `1`, and is not a zeta zero.  These are exactly
the hypotheses under which the continued prime--archimedean source trace equals the Xi
relative resolvent trace. -/
structure XiExplicitAdmissible (z : ℂ) : Prop where
  /-- The Xi coordinate has positive real part. -/
  re_pos : 0 < (1 / 2 + z * Complex.I).re
  /-- The Xi coordinate is not the completed pole at `1`. -/
  ne_one : (1 / 2 + z * Complex.I) ≠ 1
  /-- The Xi coordinate is not a zeta zero. -/
  zeta_ne : riemannZeta (1 / 2 + z * Complex.I) ≠ 0

/-- Admissibility on the absolute-convergence half-plane `1 < Re(1/2 + z I)`. -/
theorem XiExplicitAdmissible_of_one_lt_re {z : ℂ}
    (hz : 1 < (1 / 2 + z * Complex.I).re) : XiExplicitAdmissible z where
  re_pos := lt_trans zero_lt_one hz
  ne_one := by
    intro h
    rw [h, Complex.one_re] at hz
    exact lt_irrefl 1 hz
  zeta_ne := riemannZeta_ne_zero_of_one_lt_re hz

/-- An admissible base point avoids the centered Xi divisor. -/
theorem XiC_ne_zero_of_admissible {z : ℂ} (h : XiExplicitAdmissible z) : XiC z ≠ 0 := by
  have hspos := h.re_pos
  have hs0 : (1 / 2 + z * Complex.I) ≠ 0 := by
    intro hh
    rw [hh, Complex.zero_re] at hspos
    exact lt_irrefl 0 hspos
  have hG := Gammaℝ_ne_zero_of_re_pos hspos
  change xi (1 / 2 + z * Complex.I) ≠ 0
  rw [xi_eq_archFactor_mul_zeta hs0 h.ne_one hG]
  exact mul_ne_zero (archFactor_ne_zero hs0 h.ne_one hG) h.zeta_ne

/-- The regularized Cauchy kernel `w ↦ w⁻¹ - (w - z)⁻¹`.  The genus-one subtraction at the
functional-equation centre improves the first-order resolvent to inverse-square size, so its
values over the centered Xi divisor are absolutely summable. -/
def xiCauchyRegularizedKernel (z : ℂ) : ℂ → ℂ := fun w => w⁻¹ - (w - z)⁻¹

/-- On a centered divisor coordinate the kernel is the relative resolvent term. -/
@[simp] theorem xiCauchyRegularizedKernel_apply_spectralPoint (z : ℂ) (q : XiZeroCopy) :
    xiCauchyRegularizedKernel z (xiSpectralPoint q) = xiRelativeResolventTerm z q := rfl

/-- A finite `ℂ`-linear superposition of regularized Cauchy kernels: the admissible test
functions of the explicit formula. -/
def xiTestFunction {ι : Type*} (c z : ι → ℂ) (t : Finset ι) : ℂ → ℂ :=
  fun w => ∑ i ∈ t, c i * xiCauchyRegularizedKernel (z i) w

/-- The prime--archimedean source functional attached to a finite test superposition: the
matching finite combination of continued source traces `-I·(-ζ'/ζ - Γ_ℝ'/Γ_ℝ)`. -/
def xiTestPrimeArchFunctional {ι : Type*} (c z : ι → ℂ) (t : Finset ι) : ℂ :=
  ∑ i ∈ t, c i * continuedPrimeArchSourceRelativeTrace (z i)

/-- **Guinand--Weil explicit formula on the resolvent test algebra.**  For any finite family of
admissible base points, the sum of the test superposition `∑ i, c i·(·⁻¹ - (· - z i)⁻¹)` over
the multiplicity-exact centered Xi divisor equals the matching superposition of continued
prime--archimedean source traces.  The left side is the spectral sum over the Xi zeros; the
right side is a prime (von-Mangoldt `-ζ'/ζ`) minus archimedean superposition. -/
theorem xiGuinandWeilExplicitFormula {ι : Type*} (c z : ι → ℂ) (t : Finset ι)
    (hz : ∀ i ∈ t, XiExplicitAdmissible (z i)) :
    (∑' q : XiZeroCopy, xiTestFunction c z t (xiSpectralPoint q)) =
      xiTestPrimeArchFunctional c z t := by
  have hsummand : ∀ i ∈ t,
      Summable (fun q : XiZeroCopy => c i * xiRelativeResolventTerm (z i) q) :=
    fun i hi => (summable_xiRelativeResolventTerm (XiC_ne_zero_of_admissible (hz i hi))).mul_left (c i)
  calc
    (∑' q : XiZeroCopy, xiTestFunction c z t (xiSpectralPoint q))
        = ∑' q : XiZeroCopy, ∑ i ∈ t, c i * xiRelativeResolventTerm (z i) q := by
          refine tsum_congr (fun q => ?_)
          simp only [xiTestFunction, xiCauchyRegularizedKernel_apply_spectralPoint]
    _ = ∑ i ∈ t, ∑' q : XiZeroCopy, c i * xiRelativeResolventTerm (z i) q :=
          Summable.tsum_finsetSum hsummand
    _ = ∑ i ∈ t, c i * xiRelativeResolventTrace (z i) := by
          refine Finset.sum_congr rfl (fun i _ => ?_)
          unfold xiRelativeResolventTrace
          exact tsum_mul_left
    _ = xiTestPrimeArchFunctional c z t := by
          refine Finset.sum_congr rfl (fun i hi => ?_)
          rw [← continuedPrimeArchSourceRelativeTrace_eq_xiRelativeResolventTrace
                (hz i hi).re_pos (hz i hi).ne_one (hz i hi).zeta_ne]

/-- **Prime-series form.**  When every base point lies on the absolute-convergence half-plane
`1 < Re(1/2 + z i I)`, the source side is the honest von-Mangoldt Dirichlet series: the sum over
the Xi divisor equals `∑ i, c i·(-I)·(L(Λ, s i) - Γ_ℝ'/Γ_ℝ (s i))` with `s i = 1/2 + z i I`. -/
theorem xiGuinandWeilExplicitFormula_primeSeries {ι : Type*} (c z : ι → ℂ) (t : Finset ι)
    (hz : ∀ i ∈ t, 1 < (1 / 2 + z i * Complex.I).re) :
    (∑' q : XiZeroCopy, xiTestFunction c z t (xiSpectralPoint q)) =
      ∑ i ∈ t, c i * primeArchSourceRelativeTrace (z i) := by
  rw [xiGuinandWeilExplicitFormula c z t
        (fun i hi => XiExplicitAdmissible_of_one_lt_re (hz i hi))]
  refine Finset.sum_congr rfl (fun i hi => ?_)
  rw [primeArchSourceRelativeTrace_eq_continued (hz i hi)]

/-- **Rank-one specialization.**  The sum of a single regularized Cauchy kernel over the centered
Xi divisor is the continued prime--archimedean source trace.  This is the explicit formula for one
resolvent test. -/
theorem xiGuinandWeilExplicitFormula_single {z : ℂ} (h : XiExplicitAdmissible z) :
    (∑' q : XiZeroCopy, xiCauchyRegularizedKernel z (xiSpectralPoint q)) =
      continuedPrimeArchSourceRelativeTrace z := by
  have := xiGuinandWeilExplicitFormula (fun _ : Unit => (1 : ℂ)) (fun _ => z) {()}
    (fun i _ => h)
  simpa [xiTestFunction, xiTestPrimeArchFunctional] using this

end

end RHTower
