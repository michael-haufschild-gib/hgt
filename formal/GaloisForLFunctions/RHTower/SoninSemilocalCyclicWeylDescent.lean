import GaloisForLFunctions.RHTower.SoninSemilocalTraceObstruction
import GaloisForLFunctions.RHTower.SoninSemilocalWeylGenerator
import GaloisForLFunctions.RHTower.TraceNorm
import GaloisForLFunctions.HTGeometry.OperatorFredholmGerm
import Mathlib.NumberTheory.SumPrimeReciprocals

/-!
# Infinite-dimensional cyclic descent of the semilocal Weyl source

The logarithmic-position phase and additive translation act on the full infinite-dimensional
space `L²(ℝ)`.  Their group commutator is the scalar Weyl character.  A scalar commutator survives
every nonzero Hilbert--Schmidt cyclic probe: after normalizing by the probe energy, its trace is
exactly the central character and is independent of the probe.

Specializing the probe to the exact Sonin projection correction gives an unconditional
trace-class descent of the semilocal Weyl phase.  Its analytic continuation is the already
constructed prime-power Weyl character, so its tangent is the von--Mangoldt coefficient.  This
closes the finite-test cyclic-phase descent left open by `SoninSemilocalWeylGenerator`; it does not
assert the later cofinal prime--archimedean positivity theorem.
-/

noncomputable section

open MeasureTheory
open ContinuousLinearMap

namespace RHTower

/-! ## The full `L²(ℝ)` Weyl pair -/

/-- Multiplication on logarithmic `L²` by `x ↦ exp(i t x)`, using the existing unitary Fourier
character multiplier with the `2π` normalization removed. -/
def soninLogPositionPhaseUnitary (t : ℝ) : SoninL2 ≃ₗᵢ[ℂ] SoninL2 :=
  MellinL2.fourierPhaseMulUnitary (t / (2 * Real.pi))

/-- Logarithmic-position phase as a bounded operator. -/
def soninLogPositionPhaseCLM (t : ℝ) : SoninL2 →L[ℂ] SoninL2 :=
  (soninLogPositionPhaseUnitary t).toLinearIsometry.toContinuousLinearMap

/-- Additive translation on logarithmic `L²` as a bounded operator. -/
def soninLogTranslationCLM (h : ℝ) : SoninL2 →L[ℂ] SoninL2 :=
  (MellinL2.additiveTranslationUnitary h).toLinearIsometry.toContinuousLinearMap

/-- Inverse logarithmic-position phase. -/
def soninLogPositionPhaseInvCLM (t : ℝ) : SoninL2 →L[ℂ] SoninL2 :=
  (soninLogPositionPhaseUnitary t).symm.toLinearIsometry.toContinuousLinearMap

/-- Inverse additive translation. -/
def soninLogTranslationInvCLM (h : ℝ) : SoninL2 →L[ℂ] SoninL2 :=
  (MellinL2.additiveTranslationUnitary h).symm.toLinearIsometry.toContinuousLinearMap

/-- The Fourier-character normalization is exactly the desired logarithmic Weyl phase under a
translation by `h`. -/
private theorem fourierPhase_log_shift_weyl (h t x : ℝ) :
    MellinL2.fourierPhase (t / (2 * Real.pi)) x =
      HTGeometry.scalarWeylCharacter h (t : ℂ) *
        MellinL2.fourierPhase (t / (2 * Real.pi)) (x + h) := by
  simp only [MellinL2.fourierPhase, Real.fourierChar_apply,
    HTGeometry.scalarWeylCharacter]
  rw [← Complex.exp_add]
  congr 1
  push_cast
  field_simp [Real.pi_ne_zero]
  ring

/-- **Infinite-dimensional Weyl law.**  On all of logarithmic `L²(ℝ)`, not a finite-rank model,
phase multiplication and translation commute up to the exact scalar character generated by the
translation length. -/
theorem soninLogPositionPhaseCLM_mul_translation
    (h t : ℝ) :
    soninLogPositionPhaseCLM t * soninLogTranslationCLM h =
      HTGeometry.scalarWeylCharacter h (t : ℂ) •
        (soninLogTranslationCLM h * soninLogPositionPhaseCLM t) := by
  apply ContinuousLinearMap.ext
  intro f
  apply Lp.ext
  let a := t / (2 * Real.pi)
  let U := MellinL2.additiveTranslationUnitary h
  filter_upwards [
    MellinL2.fourierPhaseMulAux_ae a (U f),
    Lp.coeFn_compMeasurePreserving f (MellinL2.realTranslation_measurePreserving h),
    Lp.coeFn_compMeasurePreserving (MellinL2.fourierPhaseMulAux a f)
      (MellinL2.realTranslation_measurePreserving h),
    (MellinL2.fourierPhaseMulAux_ae a f).comp_tendsto
      (MellinL2.realTranslation_measurePreserving h).quasiMeasurePreserving.tendsto_ae,
    Lp.coeFn_smul (HTGeometry.scalarWeylCharacter h (t : ℂ))
      (U (MellinL2.fourierPhaseMulAux a f))
  ] with x hleft htranslate htranslatedPhase hphaseShift hsmul
  change MellinL2.fourierPhaseMulAux a (U f) x =
    (HTGeometry.scalarWeylCharacter h (t : ℂ) •
      U (MellinL2.fourierPhaseMulAux a f)) x
  rw [hleft, hsmul]
  change MellinL2.fourierPhase a x * U f x =
    HTGeometry.scalarWeylCharacter h (t : ℂ) *
      U (MellinL2.fourierPhaseMulAux a f) x
  rw [show U f x = f (x + h) by
      simpa [U, MellinL2.realTranslationEquiv, Function.comp_apply] using! htranslate,
    show U (MellinL2.fourierPhaseMulAux a f) x =
        MellinL2.fourierPhaseMulAux a f (x + h) by
      simpa [U, MellinL2.realTranslationEquiv, Function.comp_apply] using! htranslatedPhase,
    show MellinL2.fourierPhaseMulAux a f (x + h) =
        MellinL2.fourierPhase a (x + h) * f (x + h) by
      simpa [U, MellinL2.realTranslationEquiv, Function.comp_apply] using hphaseShift,
    fourierPhase_log_shift_weyl h t x]
  ring

/-- The phase followed by its inverse is the identity operator. -/
private theorem soninLogPositionPhaseCLM_mul_inv (t : ℝ) :
    soninLogPositionPhaseCLM t * soninLogPositionPhaseInvCLM t = 1 := by
  apply ContinuousLinearMap.ext
  intro f
  exact (soninLogPositionPhaseUnitary t).apply_symm_apply f

/-- Translation followed by its inverse is the identity operator. -/
private theorem soninLogTranslationCLM_mul_inv (h : ℝ) :
    soninLogTranslationCLM h * soninLogTranslationInvCLM h = 1 := by
  apply ContinuousLinearMap.ext
  intro f
  exact (MellinL2.additiveTranslationUnitary h).apply_symm_apply f

/-- Group commutator of logarithmic position phase and translation. -/
def soninLogWeylGroupCommutator (h t : ℝ) : SoninL2 →L[ℂ] SoninL2 :=
  soninLogPositionPhaseCLM t * soninLogTranslationCLM h *
    soninLogPositionPhaseInvCLM t * soninLogTranslationInvCLM h

/-- **Central group-commutator law.**  The full infinite-dimensional Weyl commutator collapses
exactly to its scalar central character. -/
theorem soninLogWeylGroupCommutator_eq_character (h t : ℝ) :
    soninLogWeylGroupCommutator h t =
      HTGeometry.scalarWeylCharacter h (t : ℂ) • (1 : SoninL2 →L[ℂ] SoninL2) := by
  rw [soninLogWeylGroupCommutator,
    soninLogPositionPhaseCLM_mul_translation h t]
  rw [smul_mul_assoc, smul_mul_assoc]
  congr 1
  rw [mul_assoc (soninLogTranslationCLM h) (soninLogPositionPhaseCLM t),
    soninLogPositionPhaseCLM_mul_inv t, mul_one,
    soninLogTranslationCLM_mul_inv h]

/-! ## Universal cyclic descent through Hilbert--Schmidt probes -/

section UniversalCyclicTrace

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- Trace-class cyclic carrier obtained by sandwiching a bounded response between a
Hilbert--Schmidt probe and its adjoint. -/
def hilbertSchmidtCyclicCarrier
    (C W : H →L[ℂ] H) : H →L[ℂ] H :=
  ContinuousLinearMap.adjoint C ∘L (W ∘L C)

/-- Probe-energy-normalized cyclic response. -/
def normalizedHilbertSchmidtCyclicResponse
    (C W : H →L[ℂ] H) : ℂ :=
  (hsInner C C)⁻¹ * opTrace (hilbertSchmidtCyclicCarrier C W)

/-- Every Hilbert--Schmidt probe makes the cyclic carrier trace class. -/
theorem hilbertSchmidtCyclicCarrier_isTraceClass
    {C : H →L[ℂ] H} (hC : IsHilbertSchmidt C) (W : H →L[ℂ] H) :
    IsTraceClass (hilbertSchmidtCyclicCarrier C W) := by
  exact hC.adjoint.comp_isTraceClass (hC.comp_left W)

/-- **Universal central-character trace law.**  Every nonzero Hilbert--Schmidt cyclic probe reads
the same scalar from a central response.  Thus cyclic descent neither changes nor renormalizes a
Weyl central character, independently of probe rank or detailed geometry. -/
theorem normalizedHilbertSchmidtCyclicResponse_eq_of_eq_smul_one
    {C W : H →L[ℂ] H} (hself : hsInner C C ≠ 0) (χ : ℂ)
    (hW : W = χ • (1 : H →L[ℂ] H)) :
    normalizedHilbertSchmidtCyclicResponse C W = χ := by
  rw [normalizedHilbertSchmidtCyclicResponse, hilbertSchmidtCyclicCarrier, hW]
  have hcomp : (χ • (1 : H →L[ℂ] H)) ∘L C = χ • C := by
    apply ContinuousLinearMap.ext
    intro x
    simp
  rw [hcomp, opTrace_comp_eq_hsInner, adjoint_adjoint,
    hsInner_smul_right]
  field_simp

/-! ### Universal tangent-carrier law -/

/-- The energy-normalized trace-class carrier of a scalar tangent coefficient.  This is the
operator-valued form of differentiating a central cyclic response: all index dependence is in
`a i`, while every fixed probe contributes the same positive effect `C†C`. -/
def normalizedHilbertSchmidtCentralTangentCarrier
    {I : Type*} (C : H →L[ℂ] H) (a : I → ℂ) (i : I) : H →L[ℂ] H :=
  ContinuousLinearMap.adjoint C ∘L (((hsInner C C)⁻¹ * a i) • C)

/-- A Hilbert--Schmidt probe makes every normalized central tangent carrier trace class. -/
theorem normalizedHilbertSchmidtCentralTangentCarrier_isTraceClass
    {I : Type*} {C : H →L[ℂ] H} (hC : IsHilbertSchmidt C)
    (a : I → ℂ) (i : I) :
    IsTraceClass (normalizedHilbertSchmidtCentralTangentCarrier C a i) := by
  exact hC.adjoint.comp_isTraceClass (hC.smul _)

/-- Every normalized central tangent carrier is a scalar multiple of the single probe effect
`C†C`.  Thus changing the arithmetic label cannot create new operator directions. -/
theorem normalizedHilbertSchmidtCentralTangentCarrier_eq_smul_effect
    {I : Type*} (C : H →L[ℂ] H) (a : I → ℂ) (i : I) :
    normalizedHilbertSchmidtCentralTangentCarrier C a i =
      ((hsInner C C)⁻¹ * a i) •
        (ContinuousLinearMap.adjoint C ∘L C) := by
  apply ContinuousLinearMap.ext
  intro x
  simp [normalizedHilbertSchmidtCentralTangentCarrier]

/-- The normalized carrier trace recovers its scalar coefficient exactly. -/
theorem opTrace_normalizedHilbertSchmidtCentralTangentCarrier
    {I : Type*} {C : H →L[ℂ] H} (hself : hsInner C C ≠ 0)
    (a : I → ℂ) (i : I) :
    opTrace (normalizedHilbertSchmidtCentralTangentCarrier C a i) = a i := by
  rw [normalizedHilbertSchmidtCentralTangentCarrier,
    opTrace_comp_eq_hsInner, adjoint_adjoint, hsInner_smul_right]
  field_simp

/-- The trace norm factors into the coefficient norm and one label-independent probe scale. -/
theorem traceNorm_normalizedHilbertSchmidtCentralTangentCarrier
    {I : Type*} (C : H →L[ℂ] H) (a : I → ℂ) (i : I) :
    traceNorm H (normalizedHilbertSchmidtCentralTangentCarrier C a i) =
      ‖(hsInner C C)⁻¹‖ * traceNorm H (ContinuousLinearMap.adjoint C ∘L C) * ‖a i‖ := by
  rw [normalizedHilbertSchmidtCentralTangentCarrier_eq_smul_effect,
    traceNorm_smul, norm_mul]
  ring

/-- A nonzero Hilbert--Schmidt probe has a strictly positive normalized trace-norm scale. -/
theorem normalizedHilbertSchmidtCentralTraceScale_pos
    {C : H →L[ℂ] H} (hC : IsHilbertSchmidt C) (hCne : C ≠ 0) :
    0 < ‖(hsInner C C)⁻¹‖ *
      traceNorm H (ContinuousLinearMap.adjoint C ∘L C) := by
  have hself : hsInner C C ≠ 0 := by
    rw [HTGeometry.hsInner_self_eq_ofReal_hsNormSq hC]
    exact Complex.ofReal_ne_zero.mpr
      (fun hzero => hCne ((hsNormSq_eq_zero_iff hC).mp hzero))
  have heffectSum : Summable (fun n =>
      approxNumber (ContinuousLinearMap.adjoint C ∘L C) n) :=
    summable_approxNumber_comp hC.adjoint hC
  have heffectNe : ContinuousLinearMap.adjoint C ∘L C ≠ 0 :=
    (HTGeometry.adjoint_comp_self_ne_zero_iff C).2 hCne
  have htraceNe :
      traceNorm H (ContinuousLinearMap.adjoint C ∘L C) ≠ 0 := by
    intro hzero
    exact heffectNe ((traceNorm_eq_zero_iff heffectSum).1 hzero)
  exact mul_pos (norm_pos_iff.mpr (inv_ne_zero hself))
    (lt_of_le_of_ne (traceNorm_nonneg _ ) (Ne.symm htraceNe))

/-- **Universal summability invariance.**  A fixed nonzero Hilbert--Schmidt cyclic probe neither
improves nor worsens absolute summability of a central coefficient family.  Trace-norm assembly
of the operator carriers is equivalent to scalar `ℓ¹` summability. -/
theorem summable_traceNorm_normalizedHilbertSchmidtCentralTangentCarrier_iff
    {I : Type*} {C : H →L[ℂ] H} (hC : IsHilbertSchmidt C) (hCne : C ≠ 0)
    (a : I → ℂ) :
    Summable (fun i =>
      traceNorm H (normalizedHilbertSchmidtCentralTangentCarrier C a i)) ↔
      Summable (fun i => ‖a i‖) := by
  let d : ℝ := ‖(hsInner C C)⁻¹‖ *
    traceNorm H (ContinuousLinearMap.adjoint C ∘L C)
  have hd : 0 < d := normalizedHilbertSchmidtCentralTraceScale_pos hC hCne
  constructor
  · intro h
    have hscaled : Summable (fun i => d * ‖a i‖) := h.congr fun i => by
      exact traceNorm_normalizedHilbertSchmidtCentralTangentCarrier C a i
    have hunscaled := hscaled.mul_left d⁻¹
    exact hunscaled.congr fun i => by
      change d⁻¹ * (d * ‖a i‖) = ‖a i‖
      rw [← mul_assoc, inv_mul_cancel₀ hd.ne', one_mul]
  · intro h
    have hscaled : Summable (fun i => d * ‖a i‖) := h.mul_left d
    exact hscaled.congr fun i => by
      exact (traceNorm_normalizedHilbertSchmidtCentralTangentCarrier C a i).symm

end UniversalCyclicTrace

/-! ## Exact Sonin specialization and arithmetic consumer -/

/-- Canonical exact-Sonin Hilbert--Schmidt probe at unit aperture. -/
def canonicalSoninCyclicProbe : SoninL2 →L[ℂ] SoninL2 :=
  centralSoninProjectionCorrection 1

/-- The canonical Sonin cyclic probe is Hilbert--Schmidt. -/
theorem canonicalSoninCyclicProbe_isHilbertSchmidt :
    IsHilbertSchmidt canonicalSoninCyclicProbe := by
  simpa [canonicalSoninCyclicProbe] using
    centralSoninProjectionCorrection_isHilbertSchmidt 1 zero_lt_one

/-- Exact nonzero normalization of the canonical cyclic probe. -/
theorem hsInner_canonicalSoninCyclicProbe_self :
    hsInner canonicalSoninCyclicProbe canonicalSoninCyclicProbe = 8 := by
  rw [HTGeometry.hsInner_self_eq_ofReal_hsNormSq
    canonicalSoninCyclicProbe_isHilbertSchmidt]
  change ((hsNormSq (centralSoninProjectionCorrection 1) : ℝ) : ℂ) = 8
  rw [hsNormSq_centralSoninProjectionCorrection_eq_eight_mul_sq 1 zero_lt_one]
  norm_num

/-- Actual normalized cyclic trace of the prime-power logarithmic Weyl commutator through the
exact Sonin projection-correction probe. -/
def soninSemilocalCyclicWeylResponse
    (pk : Nat.Primes × ℕ) (t : ℝ) : ℂ :=
  normalizedHilbertSchmidtCyclicResponse canonicalSoninCyclicProbe
    (soninLogWeylGroupCommutator
      (Real.log (soninSemilocalPrimePowerScale pk)) t)

/-- The operator under the canonical cyclic trace is unconditionally trace class. -/
theorem soninSemilocalCyclicWeylCarrier_isTraceClass
    (pk : Nat.Primes × ℕ) (t : ℝ) :
    IsTraceClass
      (hilbertSchmidtCyclicCarrier canonicalSoninCyclicProbe
        (soninLogWeylGroupCommutator
          (Real.log (soninSemilocalPrimePowerScale pk)) t)) :=
  hilbertSchmidtCyclicCarrier_isTraceClass
    canonicalSoninCyclicProbe_isHilbertSchmidt _

/-- **Exact cyclic phase descent.**  The normalized trace through the exact Sonin correction is
the physical prime-power Weyl character for every real parameter. -/
theorem soninSemilocalCyclicWeylResponse_eq_character
    (pk : Nat.Primes × ℕ) (t : ℝ) :
    soninSemilocalCyclicWeylResponse pk t =
      soninSemilocalWeylCharacter pk (t : ℂ) := by
  apply normalizedHilbertSchmidtCyclicResponse_eq_of_eq_smul_one
  · rw [hsInner_canonicalSoninCyclicProbe_self]
    norm_num
  · exact soninLogWeylGroupCommutator_eq_character
      (Real.log (soninSemilocalPrimePowerScale pk)) t

/-- The existing entire Weyl character supplies an analytic continuation of the cyclic response
from the exact real-axis character identity. -/
def soninSemilocalCyclicWeylContinuation
    (pk : Nat.Primes × ℕ) (z : ℂ) : ℂ :=
  soninSemilocalWeylCharacter pk z

/-- The continuation restricts to the actual normalized cyclic trace on the real axis. -/
theorem soninSemilocalCyclicWeylContinuation_ofReal
    (pk : Nat.Primes × ℕ) (t : ℝ) :
    soninSemilocalCyclicWeylContinuation pk (t : ℂ) =
      soninSemilocalCyclicWeylResponse pk t := by
  exact (soninSemilocalCyclicWeylResponse_eq_character pk t).symm

/-- Euler-weighted analytic cyclic response. -/
def soninSemilocalCyclicWeylFluxContinuation
    (pk : Nat.Primes × ℕ) (z : ℂ) : ℂ :=
  soninSemilocalLogPrimePowerCoefficient pk *
    soninSemilocalCyclicWeylContinuation pk z

/-- **Cyclic von--Mangoldt generator law.**  The tangent of the analytic continuation of the
actual Sonin cyclic trace is exactly the unsquared prime-power flux coefficient. -/
theorem I_mul_deriv_soninSemilocalCyclicWeylFluxContinuation_zero
    (pk : Nat.Primes × ℕ) :
    Complex.I * deriv (soninSemilocalCyclicWeylFluxContinuation pk) 0 =
      soninSemilocalPrimeFluxCoefficient pk := by
  simpa only [soninSemilocalCyclicWeylFluxContinuation,
    soninSemilocalCyclicWeylContinuation, soninSemilocalWeylFluxOrbit] using!
      I_mul_deriv_soninSemilocalWeylFluxOrbit_zero pk

/-! ## Critical all-prime obstruction -/

/-- The critical von--Mangoldt tangent coefficients are not absolutely summable over the full
prime-power set.  The exponent-one prime slice already dominates half of Euler's prime-harmonic
series. -/
theorem not_summable_norm_soninSemilocalPrimeFluxCoefficient :
    ¬ Summable (fun pk : Nat.Primes × ℕ =>
      ‖soninSemilocalPrimeFluxCoefficient pk‖) := by
  intro hsum
  have hslice : Summable (fun p : Nat.Primes =>
      ‖soninSemilocalPrimeFluxCoefficient (p, 0)‖) :=
    hsum.comp_injective (fun p q hpq => by simpa using congrArg Prod.fst hpq)
  have hhalf : Summable (fun p : Nat.Primes => 1 / (2 * (p : ℝ))) := by
    apply Summable.of_nonneg_of_le
      (fun p => by positivity) _ hslice
    intro p
    have hp : 0 < (p : ℝ) := by exact_mod_cast p.prop.pos
    have hp2 : (2 : ℝ) ≤ (p : ℝ) := by exact_mod_cast p.prop.two_le
    have hinvHalf : ((p : ℝ))⁻¹ ≤ 1 / 2 := by
      simpa [one_div] using
        (one_div_le_one_div_of_le (by norm_num : (0 : ℝ) < 2) hp2)
    have hlogHalf : (1 / 2 : ℝ) ≤ Real.log (p : ℝ) := by
      have hlog := Real.one_sub_inv_le_log_of_pos hp
      linarith
    have hsqrtLe : Real.sqrt (p : ℝ) ≤ (p : ℝ) := by
      rw [Real.sqrt_le_iff]
      constructor
      · positivity
      · nlinarith
    have hinvSqrt : ((p : ℝ))⁻¹ ≤ (Real.sqrt (p : ℝ))⁻¹ := by
      simpa [one_div] using
        (one_div_le_one_div_of_le (Real.sqrt_pos.2 hp) hsqrtLe)
    rw [soninSemilocalPrimeFluxCoefficient_eq, Complex.norm_real,
      Real.norm_eq_abs, pow_one,
      abs_of_pos (mul_pos (inv_pos.mpr (Real.sqrt_pos.2 hp))
        (Real.log_pos (by linarith)))]
    calc
      1 / (2 * (p : ℝ)) = (1 / 2) * ((p : ℝ))⁻¹ := by field_simp
      _ ≤ (1 / 2) * (Real.sqrt (p : ℝ))⁻¹ := by
        exact mul_le_mul_of_nonneg_left hinvSqrt (by norm_num)
      _ ≤ Real.log (p : ℝ) * (Real.sqrt (p : ℝ))⁻¹ := by
        exact mul_le_mul_of_nonneg_right hlogHalf (by positivity)
      _ = (Real.sqrt (p : ℝ))⁻¹ * Real.log (p : ℝ) := by ring
  have hone : Summable (fun p : Nat.Primes => 1 / (p : ℝ)) := by
    apply (hhalf.mul_left 2).congr
    intro p
    have hp0 : (p : ℝ) ≠ 0 := by exact_mod_cast p.prop.ne_zero
    field_simp
  exact Nat.Primes.not_summable_one_div hone

/-- Canonical trace-class tangent carrier attached to one prime-power cyclic Sonin response. -/
def soninSemilocalCyclicPrimeTangentCarrier
    (pk : Nat.Primes × ℕ) : SoninL2 →L[ℂ] SoninL2 :=
  normalizedHilbertSchmidtCentralTangentCarrier canonicalSoninCyclicProbe
    soninSemilocalPrimeFluxCoefficient pk

/-- Every individual critical prime-power tangent carrier is trace class. -/
theorem soninSemilocalCyclicPrimeTangentCarrier_isTraceClass
    (pk : Nat.Primes × ℕ) :
    IsTraceClass (soninSemilocalCyclicPrimeTangentCarrier pk) :=
  normalizedHilbertSchmidtCentralTangentCarrier_isTraceClass
    canonicalSoninCyclicProbe_isHilbertSchmidt _ pk

/-- The trace of the canonical tangent carrier is exactly its von--Mangoldt coefficient. -/
theorem opTrace_soninSemilocalCyclicPrimeTangentCarrier
    (pk : Nat.Primes × ℕ) :
    opTrace (soninSemilocalCyclicPrimeTangentCarrier pk) =
      soninSemilocalPrimeFluxCoefficient pk := by
  apply opTrace_normalizedHilbertSchmidtCentralTangentCarrier
  rw [hsInner_canonicalSoninCyclicProbe_self]
  norm_num

/-- **Critical central-cyclic no-go.**  Although every local tangent carrier is trace class, the
full all-prime/all-valuation family is not trace-norm summable.  The universal summability law
shows that no fixed nonzero Hilbert--Schmidt cyclic probe can repair this failure. -/
theorem not_summable_traceNorm_soninSemilocalCyclicPrimeTangentCarrier :
    ¬ Summable (fun pk : Nat.Primes × ℕ =>
      traceNorm SoninL2 (soninSemilocalCyclicPrimeTangentCarrier pk)) := by
  have hprobeNe : canonicalSoninCyclicProbe ≠ 0 := by
    intro hzero
    have hself := hsInner_canonicalSoninCyclicProbe_self
    rw [hzero] at hself
    simp [ContinuousLinearMap.hsInner] at hself
  change ¬ Summable (fun pk : Nat.Primes × ℕ =>
    traceNorm SoninL2
      (normalizedHilbertSchmidtCentralTangentCarrier canonicalSoninCyclicProbe
        soninSemilocalPrimeFluxCoefficient pk))
  rw [summable_traceNorm_normalizedHilbertSchmidtCentralTangentCarrier_iff
    canonicalSoninCyclicProbe_isHilbertSchmidt hprobeNe]
  exact not_summable_norm_soninSemilocalPrimeFluxCoefficient

/-- Compact-support semilocal von--Mangoldt trace is the finite sum of the cyclic Sonin phase
generators.  Each summand comes from a trace-class operator on infinite-dimensional `L²(ℝ)`. -/
theorem finiteVonMangoldtCentralTrace_eq_sum_cyclicSoninWeylGenerators
    (f : SoninPrimePowerTest) :
    finiteVonMangoldtCentralTrace f =
      f.sum fun pk w =>
        w * (Complex.I *
          deriv (soninSemilocalCyclicWeylFluxContinuation pk) 0) := by
  rw [finiteVonMangoldtCentralTrace]
  apply Finsupp.sum_congr
  intro pk hpk
  rw [I_mul_deriv_soninSemilocalCyclicWeylFluxContinuation_zero,
    soninSemilocalPrimeFluxCoefficient_eq_vonMangoldt]

end RHTower
