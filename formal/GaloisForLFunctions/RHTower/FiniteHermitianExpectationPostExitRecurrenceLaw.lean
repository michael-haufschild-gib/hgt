import GaloisForLFunctions.RHTower.FiniteQuantumExpectationSectorOptimalRateDistortionLaw
import GaloisForLFunctions.HTGeometry.SpectralObservedOrbitDimension

/-!
# Observable post-exit recurrence for finite Hermitian quantum dynamics

The abstract sector coefficient law is lifted here to genuine unitary
Hamiltonian evolution.  Every finite Hermitian matrix is diagonalized by its
canonical spectral unitary; trace cyclicity then identifies physical
expectation histories with the sector phase histories exactly.

For every finite family of matrix records and observables, every positive
tolerance, and every positive guard time, either the complete weighted
expectation history never exits the tolerance or a witnessed exit is followed
strictly later by a return.  The deadline is the least certified clock after
jointly optimizing phase resolution and observer-visible sector graph.

No simple-spectrum, distinct-gap, noncancellation, randomness, chaos, or
genericity premise is used.
-/

open scoped BigOperators Matrix
open Matrix

noncomputable section

namespace RHTower

open GaloisForLFunctions.HTGeometry

/-- Entrywise phase conjugation is exactly unitary evolution under the real
diagonal Hamiltonian. -/
theorem finiteQuantumPhaseConjugatedMatrix_negEnergy_eq_unitaryEvolution
    {d : ℕ} (energy : Fin d → ℝ) (t : ℝ)
    (rho : Matrix (Fin d) (Fin d) ℂ) :
    finiteQuantumPhaseConjugatedMatrix
        (finiteObserverHamiltonianVertexPhase t (fun i => -energy i)) rho =
      unitaryEvolution (Matrix.diagonal fun i => (energy i : ℂ)) t * rho *
        star (unitaryEvolution (Matrix.diagonal fun i => (energy i : ℂ)) t) := by
  rw [unitaryEvolution_diagonal]
  ext i j
  rw [diagonal_conj_entry]
  unfold finiteQuantumPhaseConjugatedMatrix finiteQuantumObserverPhase
    finiteObserverHamiltonianVertexPhase
  have hphase (k : Fin d) :
      Complex.exp (Complex.I * (((t * -energy k : ℝ) : ℂ))) =
        Complex.exp (-(Complex.I * (t * energy k))) := by
    congr 1
    push_cast
    ring
  rw [hphase i, hphase j]
  simp only [starRingEnd_apply]
  ring

/-- On a standard finite index set, the sector and entrywise displacement
definitions coincide literally. -/
theorem finiteQuantumExpectationSectorDisplacement_fin_eq
    {d : ℕ} {J : Type*} (z : Fin d → ℂ)
    (coeff : J → Fin d → Fin d → ℂ) (a : J) :
    finiteQuantumExpectationSectorDisplacement z coeff a =
      finiteQuantumExpectationDisplacement z coeff a := by
  rfl

/-- On a standard finite index set, the sector and entrywise total
deviations coincide literally. -/
theorem finiteQuantumExpectationSectorTotalDeviation_fin_eq
    {d : ℕ} {J : Type*} [Fintype J]
    (lam : J → ℝ) (z : Fin d → ℂ)
    (coeff : J → Fin d → Fin d → ℂ) :
    finiteQuantumExpectationSectorTotalDeviation lam z coeff =
      finiteQuantumExpectationTotalDeviation lam z coeff := by
  rfl

/-- Ordered energy-pair coefficients of a finite family of state--observable
records in an energy basis. -/
def finiteDiagonalQuantumExpectationCoefficient
    {d : ℕ} {J : Type*}
    (rho observable : J → Matrix (Fin d) (Fin d) ℂ) :
    J → Fin d → Fin d → ℂ :=
  finiteQuantumStateObservableCoefficient rho observable

/-- Weighted absolute displacement of actual trace expectations under the
unitary generated by a real diagonal Hamiltonian. -/
def finiteDiagonalQuantumExpectationTotalDeviation
    {d : ℕ} {J : Type*} [Fintype J]
    (energy : Fin d → ℝ) (lam : J → ℝ)
    (rho observable : J → Matrix (Fin d) (Fin d) ℂ)
    (t : ℝ) : ℝ :=
  ∑ a, lam a *
    ‖(unitaryEvolution (Matrix.diagonal fun i => (energy i : ℂ)) t *
          rho a *
          star (unitaryEvolution
            (Matrix.diagonal fun i => (energy i : ℂ)) t) *
          observable a).trace -
        (rho a * observable a).trace‖

/-- Exact physical realization of the abstract expectation-history defect
for a diagonal Hamiltonian. -/
theorem finiteDiagonalQuantumExpectationTotalDeviation_eq_sector
    {d : ℕ} {J : Type*} [Fintype J]
    (energy : Fin d → ℝ) (lam : J → ℝ)
    (rho observable : J → Matrix (Fin d) (Fin d) ℂ)
    (t : ℝ) :
    finiteDiagonalQuantumExpectationTotalDeviation
        energy lam rho observable t =
      finiteQuantumExpectationSectorTotalDeviation lam
        (finiteQuantumExpectationSectorVertexPhase t
          (fun i => -energy i))
        (finiteDiagonalQuantumExpectationCoefficient rho observable) := by
  classical
  unfold finiteDiagonalQuantumExpectationTotalDeviation
    finiteQuantumExpectationSectorTotalDeviation
  apply Finset.sum_congr rfl
  intro a _ha
  congr 1
  rw [finiteQuantumExpectationSectorDisplacement_fin_eq]
  unfold finiteDiagonalQuantumExpectationCoefficient
  rw [finiteQuantumExpectationDisplacement_eq_trace_sub]
  rw [show finiteQuantumExpectationSectorVertexPhase t (fun i => -energy i) =
      finiteObserverHamiltonianVertexPhase t (fun i => -energy i) from rfl]
  rw [finiteQuantumPhaseConjugatedMatrix_negEnergy_eq_unitaryEvolution]

/-- Diagonal-Hamiltonian observable escape--return law with the jointly
optimal certified observer clock. -/
theorem finiteDiagonalQuantumExpectation_positiveTarget_optimal_neverExits_or_postExit
    {d : ℕ} {J : Type*} [Fintype J]
    (energy : Fin d → ℝ) (lam : J → ℝ)
    (rho observable : J → Matrix (Fin d) (Fin d) ℂ)
    (hlam : ∀ a, 0 ≤ lam a)
    {ε : ℝ} (hε : 0 < ε)
    (guardTime : ℝ) (hguard : 0 < guardTime) :
    (∀ t : ℝ, 0 ≤ t →
      finiteDiagonalQuantumExpectationTotalDeviation
        energy lam rho observable t ≤ ε) ∨
    ∃ exitTime : ℝ, ∃ n : ℕ,
      0 ≤ exitTime ∧
      0 < n ∧
      n ≤ finiteQuantumExpectationSectorOptimalCertifiedDeadline
        lam (finiteDiagonalQuantumExpectationCoefficient rho observable) ε ∧
      ε < finiteDiagonalQuantumExpectationTotalDeviation
        energy lam rho observable exitTime ∧
      exitTime < (n : ℝ) * (exitTime + guardTime) ∧
      (n : ℝ) * (exitTime + guardTime) ≤
        (finiteQuantumExpectationSectorOptimalCertifiedDeadline
          lam (finiteDiagonalQuantumExpectationCoefficient rho observable) ε : ℝ) *
            (exitTime + guardTime) ∧
      finiteDiagonalQuantumExpectationTotalDeviation
        energy lam rho observable
          ((n : ℝ) * (exitTime + guardTime)) ≤ ε := by
  simpa only [finiteDiagonalQuantumExpectationTotalDeviation_eq_sector] using
    finiteQuantumExpectationSector_positiveTarget_optimal_neverExits_or_postExit
      lam (finiteDiagonalQuantumExpectationCoefficient rho observable) hlam
      (fun i => -energy i) hε guardTime hguard

/-- Matrix written in the canonical spectral coordinates of a Hermitian
Hamiltonian. -/
def finiteHermitianSpectralCoordinate {d : ℕ}
    {H : Matrix (Fin d) (Fin d) ℂ} (hH : H.IsHermitian)
    (X : Matrix (Fin d) (Fin d) ℂ) : Matrix (Fin d) (Fin d) ℂ :=
  star (hH.eigenvectorUnitary : Matrix (Fin d) (Fin d) ℂ) * X *
    (hH.eigenvectorUnitary : Matrix (Fin d) (Fin d) ℂ)

/-- Trace expectations under arbitrary Hermitian dynamics are exactly trace
expectations under the diagonal spectral representative. -/
theorem finiteHermitianExpectationTrace_eq_diagonal
    {d : ℕ} {H : Matrix (Fin d) (Fin d) ℂ} (hH : H.IsHermitian)
    (rho observable : Matrix (Fin d) (Fin d) ℂ) (t : ℝ) :
    (unitaryEvolution H t * rho * star (unitaryEvolution H t) *
        observable).trace =
      (unitaryEvolution
          (Matrix.diagonal fun i => (hH.eigenvalues i : ℂ)) t *
          finiteHermitianSpectralCoordinate hH rho *
          star (unitaryEvolution
            (Matrix.diagonal fun i => (hH.eigenvalues i : ℂ)) t) *
          finiteHermitianSpectralCoordinate hH observable).trace := by
  let V : Matrix (Fin d) (Fin d) ℂ := hH.eigenvectorUnitary
  let D : Matrix (Fin d) (Fin d) ℂ :=
    Matrix.diagonal fun i => Complex.exp (-(Complex.I * (t * hH.eigenvalues i)))
  let X : Matrix (Fin d) (Fin d) ℂ :=
    D * (star V * rho * V) * star D
  have hevolved :
      unitaryEvolution H t * rho * star (unitaryEvolution H t) =
        V * X * star V := by
    dsimp only [V, X, D]
    exact evolved_reporter_conj hH.eigenvectorUnitary.2 hH.eigenvalues
      (isHermitian_eq_conj_diagonal hH) rho t
  rw [hevolved]
  have htrace :
      ((V * X * star V) * observable).trace =
        (X * (star V * observable * V)).trace := by
    calc
      ((V * X * star V) * observable).trace =
          (V * X * (star V * observable)).trace := by
            simp only [Matrix.mul_assoc]
      _ = ((star V * observable) * V * X).trace :=
        Matrix.trace_mul_cycle V X (star V * observable)
      _ = (X * (star V * observable) * V).trace :=
        Matrix.trace_mul_cycle (star V * observable) V X
      _ = (X * (star V * observable * V)).trace := by
        simp only [Matrix.mul_assoc]
  rw [htrace]
  dsimp only [finiteHermitianSpectralCoordinate, V, X, D]
  rw [unitaryEvolution_diagonal]

/-- Ordered energy-pair coefficients obtained canonically from a Hermitian
Hamiltonian's spectral coordinates. -/
def finiteHermitianQuantumExpectationCoefficient
    {d : ℕ} {H : Matrix (Fin d) (Fin d) ℂ} (hH : H.IsHermitian)
    {J : Type*}
    (rho observable : J → Matrix (Fin d) (Fin d) ℂ) :
    J → Fin d → Fin d → ℂ :=
  finiteQuantumStateObservableCoefficient
    (fun a => finiteHermitianSpectralCoordinate hH (rho a))
    (fun a => finiteHermitianSpectralCoordinate hH (observable a))

/-- Weighted absolute displacement of actual trace expectations under an
arbitrary finite Hermitian Hamiltonian. -/
def finiteHermitianQuantumExpectationTotalDeviation
    {d : ℕ} {H : Matrix (Fin d) (Fin d) ℂ} (_hH : H.IsHermitian)
    {J : Type*} [Fintype J] (lam : J → ℝ)
    (rho observable : J → Matrix (Fin d) (Fin d) ℂ) (t : ℝ) : ℝ :=
  ∑ a, lam a *
    ‖(unitaryEvolution H t * rho a * star (unitaryEvolution H t) *
          observable a).trace -
        (rho a * observable a).trace‖

/-- Exact spectral-sector realization of physical trace-expectation
deviation for an arbitrary finite Hermitian Hamiltonian. -/
theorem finiteHermitianQuantumExpectationTotalDeviation_eq_sector
    {d : ℕ} {H : Matrix (Fin d) (Fin d) ℂ} (hH : H.IsHermitian)
    {J : Type*} [Fintype J] (lam : J → ℝ)
    (rho observable : J → Matrix (Fin d) (Fin d) ℂ) (t : ℝ) :
    finiteHermitianQuantumExpectationTotalDeviation hH lam rho observable t =
      finiteQuantumExpectationSectorTotalDeviation lam
        (finiteQuantumExpectationSectorVertexPhase t
          (fun i => -hH.eigenvalues i))
        (finiteHermitianQuantumExpectationCoefficient hH rho observable) := by
  classical
  unfold finiteHermitianQuantumExpectationTotalDeviation
    finiteQuantumExpectationSectorTotalDeviation
  apply Finset.sum_congr rfl
  intro a _ha
  congr 1
  rw [finiteQuantumExpectationSectorDisplacement_fin_eq]
  unfold finiteHermitianQuantumExpectationCoefficient
  rw [finiteQuantumExpectationDisplacement_eq_trace_sub]
  rw [show finiteQuantumExpectationSectorVertexPhase t
      (fun i => -hH.eigenvalues i) =
        finiteObserverHamiltonianVertexPhase t
          (fun i => -hH.eigenvalues i) from rfl]
  rw [finiteQuantumPhaseConjugatedMatrix_negEnergy_eq_unitaryEvolution]
  rw [← finiteHermitianExpectationTrace_eq_diagonal hH (rho a) (observable a) t]
  have htrace0 :
      (rho a * observable a).trace =
        (finiteHermitianSpectralCoordinate hH (rho a) *
          finiteHermitianSpectralCoordinate hH (observable a)).trace := by
    simpa [unitaryEvolution] using
      (finiteHermitianExpectationTrace_eq_diagonal hH
        (rho a) (observable a) 0)
  rw [← htrace0]

/-- **Finite Hermitian observable escape--return law.** At every positive
target deviation, a finite family of trace-expectation histories either
never exits or returns strictly after an exit. The bound is the least
certified graph--resolution clock visible to the supplied records. -/
theorem finiteHermitianQuantumExpectation_positiveTarget_optimal_neverExits_or_postExit
    {d : ℕ} {H : Matrix (Fin d) (Fin d) ℂ} (hH : H.IsHermitian)
    {J : Type*} [Fintype J] (lam : J → ℝ)
    (rho observable : J → Matrix (Fin d) (Fin d) ℂ)
    (hlam : ∀ a, 0 ≤ lam a)
    {ε : ℝ} (hε : 0 < ε)
    (guardTime : ℝ) (hguard : 0 < guardTime) :
    (∀ t : ℝ, 0 ≤ t →
      finiteHermitianQuantumExpectationTotalDeviation
        hH lam rho observable t ≤ ε) ∨
    ∃ exitTime : ℝ, ∃ n : ℕ,
      0 ≤ exitTime ∧
      0 < n ∧
      n ≤ finiteQuantumExpectationSectorOptimalCertifiedDeadline
        lam (finiteHermitianQuantumExpectationCoefficient hH rho observable) ε ∧
      ε < finiteHermitianQuantumExpectationTotalDeviation
        hH lam rho observable exitTime ∧
      exitTime < (n : ℝ) * (exitTime + guardTime) ∧
      (n : ℝ) * (exitTime + guardTime) ≤
        (finiteQuantumExpectationSectorOptimalCertifiedDeadline lam
          (finiteHermitianQuantumExpectationCoefficient hH rho observable) ε : ℝ) *
            (exitTime + guardTime) ∧
      finiteHermitianQuantumExpectationTotalDeviation hH lam rho observable
        ((n : ℝ) * (exitTime + guardTime)) ≤ ε := by
  simpa only [finiteHermitianQuantumExpectationTotalDeviation_eq_sector] using
    finiteQuantumExpectationSector_positiveTarget_optimal_neverExits_or_postExit
      lam (finiteHermitianQuantumExpectationCoefficient hH rho observable) hlam
      (fun i => -hH.eigenvalues i) hε guardTime hguard

end RHTower
