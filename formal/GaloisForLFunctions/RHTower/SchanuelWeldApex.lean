import Mathlib
import GaloisForLFunctions.HTGeometry.WeldRateLattice

/-!
# Schanuel's conjecture welds the prime spectrum into an algebraically independent set

The archimedean–difference weld `𝓜⁺` carries a native rate spectrum, the prime-log group
`primeLogLattice = ⟨log p⟩ ⊆ ℝ`, the eigenvalue group of `ad(∂_s)` on the shift base `{σ_p}`.
Independence of that spectrum sits in a ladder of ever finer statements:

* `ℤ`-linear independence — `primeLog_linearIndependent`, an elementary consequence of unique
  factorization;
* `ℚ̄`-linear independence (Baker) and the pairwise Gelfond–Schneider layer;
* **algebraic independence over `ℚ`** — the apex, meaning `{log p}` satisfies *no* nonzero
  polynomial relation with rational coefficients whatsoever.

The apex is exactly the content of Schanuel's conjecture applied to the family `x_i = log p_i`.
Schanuel's conjecture states: for `ℚ`-linearly-independent complex numbers `x₁, …, xₙ`, the field
`ℚ(x₁, …, xₙ, e^{x₁}, …, e^{xₙ})` has transcendence degree at least `n` over `ℚ`.  A transcendence
basis can always be extracted from a generating set, so "trdeg ≥ n" is equivalent to the existence
of an `n`-element algebraically independent subset among the `2n` generators
`x₁, …, xₙ, e^{x₁}, …, e^{xₙ}`; that extraction form is the interface `SchanuelConjecture` below.

Schanuel's conjecture is the deepest open problem of transcendental number theory and is **not proved
here**; it is carried as an explicit `Prop` interface — the analytic residual — and every downstream
statement is proved unconditionally *modulo* that one interface.  Feeding the prime-log family in
turns the generic transcendence-degree bound into a sharp arithmetic conclusion: since each `e^{x_i}`
is the integer `p_i` (algebraic), no exponential generator can enter a transcendence basis, so the
basis must be `{x_i}` itself — the whole prime spectrum is algebraically independent.
-/

namespace GaloisForLFunctions.RHTower

/-- **Schanuel's conjecture** (extraction form).  For every `ℚ`-linearly independent family
`x : Fin n → ℂ`, among the `2n` numbers `x₁, …, xₙ, e^{x₁}, …, e^{xₙ}` there is an `n`-element
subfamily (indexed injectively by `Fin n`, its members drawn from the `x_j` and the `e^{x_j}`) that
is algebraically independent over `ℚ`.

This is the transcendence-degree statement `trdeg_ℚ ℚ(x₁,…,xₙ,e^{x₁},…,e^{xₙ}) ≥ n` in extracted
form: a transcendence basis of a field generated by a finite set is always a subset of that
generating set, and `n` algebraically independent generators witness transcendence degree `≥ n`
(conversely trdeg `≥ n` forces `n` of the `2n` generators to be independent).  The deepest open
conjecture of transcendental number theory; carried here as an interface, never proved. -/
def SchanuelConjecture : Prop :=
  ∀ (n : ℕ) (x : Fin n → ℂ), LinearIndependent ℚ x →
    ∃ t : Fin n → ℂ, Function.Injective t ∧
      (∀ i, t i ∈ Set.range x ∪ Set.range (fun j => Complex.exp (x j))) ∧
      AlgebraicIndependent ℚ t

/-- **The prime spectrum is algebraically independent, given Schanuel.**  For distinct primes
`p₁, …, pₙ`, the archimedean rates `log p₁, …, log pₙ` are algebraically independent over `ℚ`: they
satisfy no nonzero rational polynomial relation.  This is the apex of the weld-spectrum independence
ladder, strictly above the unconditional `ℤ`-linear independence `primeLog_linearIndependent`.

Proof.  Put `x_i = log p_i`.  The family is `ℚ`-linearly independent: `primeLog_linearIndependent`
gives `ℤ`-linear independence of `{log p}` over `ℝ`, which upgrades to `ℚ`-linear independence
(`ℚ` is the fraction field of `ℤ`), restricts to the finite injective subfamily, and pushes along the
injective `ℚ`-linear map `ℝ ↪ ℂ`.  Schanuel then supplies an `n`-element algebraically independent
`t` drawn from the `x_j` and the `e^{x_j}`.  But `e^{x_j} = e^{log p_j} = p_j` is a rational integer,
hence algebraic, while every member of an algebraically independent family is transcendental; so no
`t_i` can be an exponential generator, forcing `t_i ∈ {x_j}`.  Thus `range t ⊆ range x`; both are
injective images of `Fin n`, so equal in cardinality and therefore equal as sets.  Algebraic
independence of `t` transported across `range t = range x` yields algebraic independence of `x`. -/
theorem primeLogs_algebraicallyIndependent (hS : SchanuelConjecture)
    {n : ℕ} (p : Fin n → ℕ) (hp : ∀ i, (p i).Prime) (hpinj : Function.Injective p) :
    AlgebraicIndependent ℚ (fun i => (Real.log (p i) : ℂ)) := by
  set x : Fin n → ℂ := fun i => (Real.log (p i) : ℂ) with hxdef
  -- Step 1: `ℚ`-linear independence of the complex prime-log family.
  have hxLI : LinearIndependent ℚ x := by
    have hQ : LinearIndependent ℚ (fun P : Nat.Primes => Real.log (P : ℕ)) :=
      (LinearIndependent.iff_fractionRing ℤ ℚ).mp primeLog_linearIndependent
    let q : Fin n → Nat.Primes := fun i => ⟨p i, hp i⟩
    have hqinj : Function.Injective q := by
      intro i j h
      apply hpinj
      have := congrArg (fun P : Nat.Primes => (P : ℕ)) h
      simpa [q] using this
    have hcR : LinearIndependent ℚ (fun i => (Real.log (p i) : ℝ)) := by
      have hc := hQ.comp q hqinj
      have he : ((fun P : Nat.Primes => Real.log (P : ℕ)) ∘ q)
          = (fun i => (Real.log (p i) : ℝ)) := by funext i; simp [q]
      rwa [he] at hc
    let f : ℝ →ₗ[ℚ] ℂ := (Algebra.linearMap ℝ ℂ).restrictScalars ℚ
    have hfe : ∀ r : ℝ, f r = (r : ℂ) := fun _ => rfl
    have hinj : Function.Injective (⇑f) := by
      intro a b hab
      rw [hfe, hfe] at hab
      exact Complex.ofReal_injective hab
    have hker : f.ker = ⊥ := LinearMap.ker_eq_bot.mpr hinj
    have hmap := hcR.map' f hker
    have hcomp : (⇑f ∘ (fun i => (Real.log (p i) : ℝ))) = x := by
      funext i; rw [hxdef]; exact hfe (Real.log (p i))
    rwa [hcomp] at hmap
  have hxinj : Function.Injective x := hxLI.injective
  -- Step 2: extract the algebraically independent `t` from Schanuel.
  obtain ⟨t, htinj, htmem, htAI⟩ := hS n x hxLI
  -- Step 3: no `t i` is an exponential generator, so `range t ⊆ range x`.
  have hexpval : ∀ j, Complex.exp (x j) = ((p j : ℕ) : ℂ) := by
    intro j
    have hxj : x j = ((Real.log (p j) : ℝ) : ℂ) := rfl
    rw [hxj, ← Complex.ofReal_exp, Real.exp_log (by exact_mod_cast (hp j).pos)]
    push_cast; ring
  have hsub : Set.range t ⊆ Set.range x := by
    rintro z ⟨i, rfl⟩
    rcases htmem i with hin | hexp
    · exact hin
    · exfalso
      obtain ⟨j, hj⟩ := hexp
      have htrans : Transcendental ℚ (t i) := htAI.transcendental i
      have hti : t i = ((p j : ℕ) : ℂ) := by rw [← hj]; exact hexpval j
      exact htrans (hti ▸ isAlgebraic_nat (p j))
  -- Step 4: equal cardinality forces `range t = range x`.
  have hrange : Set.range t = Set.range x := by
    have hFsub : Finset.image t Finset.univ ⊆ Finset.image x Finset.univ := by
      intro a ha
      rw [Finset.mem_image] at ha ⊢
      obtain ⟨i, _, rfl⟩ := ha
      obtain ⟨j, hj⟩ := hsub ⟨i, rfl⟩
      exact ⟨j, Finset.mem_univ j, hj⟩
    have hcx : (Finset.image x Finset.univ).card = n := by
      rw [Finset.card_image_of_injective _ hxinj, Finset.card_univ, Fintype.card_fin]
    have hct : (Finset.image t Finset.univ).card = n := by
      rw [Finset.card_image_of_injective _ htinj, Finset.card_univ, Fintype.card_fin]
    have hFeq : Finset.image t Finset.univ = Finset.image x Finset.univ :=
      Finset.eq_of_subset_of_card_le hFsub (by rw [hcx, hct])
    have hc := congrArg (fun s : Finset ℂ => (↑s : Set ℂ)) hFeq
    simpa [Finset.coe_image, Finset.coe_univ, Set.image_univ] using hc
  -- Step 5: transport algebraic independence of `t` to `x`.
  have h1 : AlgebraicIndependent ℚ (Subtype.val : ↥(Set.range t) → ℂ) :=
    (algebraicIndependent_subtype_range htinj).mpr htAI
  rw [hrange] at h1
  exact (algebraicIndependent_subtype_range hxinj).mp h1

/-- **The weld-spectrum independence ladder, apex form.**  Under Schanuel's conjecture the entire
prime rate spectrum `{log p}` of the archimedean–difference weld is algebraically independent over
`ℚ` — no finite set of primes has its logarithms tied by any nonzero rational polynomial relation.
This sits one strict step above the unconditional `ℤ`-linear independence `primeLog_linearIndependent`
and above the `ℚ̄`-linear (Baker) and pairwise Gelfond–Schneider layers, all of which it implies. -/
theorem weldSpectrum_algebraicallyIndependent (hS : SchanuelConjecture) :
    ∀ {n : ℕ} (p : Fin n → ℕ), (∀ i, (p i).Prime) → Function.Injective p →
      AlgebraicIndependent ℚ (fun i => (Real.log (p i) : ℂ)) :=
  fun p hp hpinj => primeLogs_algebraicallyIndependent hS p hp hpinj

end GaloisForLFunctions.RHTower
