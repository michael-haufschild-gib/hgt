import GaloisForLFunctions.RHTower.Artin.ArtinCongruenceModuloAPrime
import Mathlib.LinearAlgebra.FreeModule.PID
import Mathlib.RingTheory.PrincipalIdealDomain

/-!
# Descent from algebraic integers to integers

An integer vector that is a combination of integer vectors with algebraic integer coefficients
is a combination of them with integer coefficients (`exists_int_combination`).

Let `M ⊆ ℂ` be the `ℤ`-module generated by `1` and the coefficients `a_k` (`unitSpan`). It is
finitely generated and torsion free, hence free, and all its elements are algebraic integers.
The coordinates of `1` in a basis generate the unit ideal of `ℤ`: if `g` divides them all,
`1 = g w` with `w ∈ M` an algebraic integer, so `1/g` is an integer. Hence there is a
`ℤ`-linear map `π : M → ℤ` with `π(1) = 1` (`exists_retraction`). Applied to
`X_q · 1 = Σ_k N_{kq} a_k` it gives `X_q = Σ_k N_{kq} π(a_k)`.
-/

open scoped BigOperators

noncomputable section

namespace GaloisForLFunctions

section Retraction

variable {ι : Type*} (a : ι → ℂ)

/-- The `ℤ`-module generated by `1` and a family of complex numbers. -/
def unitSpan : Submodule ℤ ℂ := Submodule.span ℤ (insert (1 : ℂ) (Set.range a))

theorem one_mem_unitSpan : (1 : ℂ) ∈ unitSpan a :=
  Submodule.subset_span (Set.mem_insert _ _)

theorem mem_unitSpan (k : ι) : a k ∈ unitSpan a :=
  Submodule.subset_span (Set.mem_insert_of_mem _ (Set.mem_range_self k))

/-- The elements of the module generated by `1` and algebraic integers are algebraic
integers. -/
theorem isIntegral_of_mem_unitSpan (ha : ∀ k, IsIntegral ℤ (a k)) {w : ℂ}
    (hw : w ∈ unitSpan a) : IsIntegral ℤ w := by
  refine Submodule.span_induction (p := fun w _ => IsIntegral ℤ w) ?_ ?_ ?_ ?_ hw
  · rintro w (rfl | ⟨k, rfl⟩)
    · exact isIntegral_one
    · exact ha k
  · exact isIntegral_zero
  · intro u v _ _ hu hv
    exact hu.add hv
  · intro n u _ hu
    rw [zsmul_eq_mul]
    exact (isIntegral_intCast_complex n).mul hu

variable [Finite ι]

/-- **A `ℤ`-linear retraction onto `ℤ·1`** on the module generated by `1` and finitely many
algebraic integers. -/
theorem exists_retraction (ha : ∀ k, IsIntegral ℤ (a k)) :
    ∃ π : unitSpan a →ₗ[ℤ] ℤ, π ⟨1, one_mem_unitSpan a⟩ = 1 := by
  haveI : Module.Finite ℤ (unitSpan a) :=
    Module.Finite.span_of_finite ℤ ((Set.finite_range a).insert 1)
  haveI : Module.Free ℤ (unitSpan a) := Module.free_of_finite_type_torsion_free'
  let b := Module.Free.chooseBasis ℤ (unitSpan a)
  obtain ⟨one, hone⟩ : ∃ one : unitSpan a, one = ⟨1, one_mem_unitSpan a⟩ := ⟨_, rfl⟩
  have honeC : (one : ℂ) = 1 := by rw [hone]
  -- the coordinates of `1` generate the unit ideal
  have hI : Ideal.span (Set.range fun i => b.repr one i) = ⊤ := by
    obtain ⟨g, hg⟩ : ∃ g : ℤ, Ideal.span (Set.range fun i => b.repr one i) = Ideal.span {g} :=
      ⟨Submodule.IsPrincipal.generator _, (Ideal.span_singleton_generator _).symm⟩
    have hdvd : ∀ i, g ∣ b.repr one i := fun i => by
      have h : b.repr one i ∈ Ideal.span (Set.range fun i => b.repr one i) :=
        Ideal.subset_span (Set.mem_range_self i)
      rw [hg] at h
      exact Ideal.mem_span_singleton.mp h
    choose d hd using hdvd
    obtain ⟨w, hw⟩ : ∃ w : unitSpan a, w = ∑ i, d i • b i := ⟨_, rfl⟩
    have hgw : one = g • w := by
      rw [hw, Finset.smul_sum]
      conv_lhs => rw [← b.sum_repr one]
      exact Finset.sum_congr rfl fun i _ => by rw [hd i, mul_smul]
    have hwint : IsIntegral ℤ (w : ℂ) := isIntegral_of_mem_unitSpan a ha w.2
    have hC : (1 : ℂ) = (g : ℂ) * (w : ℂ) := by
      rw [← honeC, hgw, Submodule.coe_smul, zsmul_eq_mul]
    -- `1/g` is an algebraic integer and rational
    have hg0 : (g : ℂ) ≠ 0 := by
      intro h0
      rw [h0, zero_mul] at hC
      exact one_ne_zero hC
    have hr : algebraMap ℚ ℂ ((1 : ℚ) / g) = (w : ℂ) := by
      rw [eq_ratCast]
      push_cast
      rw [eq_comm, eq_div_iff hg0, mul_comm]
      exact hC.symm
    rw [← hr] at hwint
    have hq : IsIntegral ℤ ((1 : ℚ) / g) :=
      (isIntegral_algebraMap_iff (algebraMap ℚ ℂ).injective).mp hwint
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hq
    rw [eq_intCast] at hy
    have hgq : (g : ℚ) ≠ 0 := by
      intro h
      exact hg0 (by exact_mod_cast h)
    have h1 : (g : ℚ) * y = 1 := by
      rw [hy]
      field_simp
    rw [hg, Ideal.span_singleton_eq_top]
    exact isUnit_iff_exists_inv.mpr ⟨y, by exact_mod_cast h1⟩
  have h1 : (1 : ℤ) ∈ Ideal.span (Set.range fun i => b.repr one i) := by
    rw [hI]
    exact Submodule.mem_top
  obtain ⟨u, hu⟩ := Ideal.mem_span_range_iff_exists_fun.mp h1
  refine ⟨∑ i, u i • b.coord i, ?_⟩
  rw [← hone, LinearMap.sum_apply, ← hu]
  exact Finset.sum_congr rfl fun i _ => by
    rw [LinearMap.smul_apply, Module.Basis.coord_apply, smul_eq_mul]

end Retraction

/-- **Descent of the coefficients.** If the integer vector `X` is a combination of the integer
vectors `N_k` with algebraic integer coefficients, it is a combination with integer
coefficients. -/
theorem exists_int_combination {ι Q : Type*} [Fintype ι] (a : ι → ℂ)
    (ha : ∀ k, IsIntegral ℤ (a k)) (N : ι → Q → ℤ) (X : Q → ℤ)
    (h : ∀ q, (X q : ℂ) = ∑ k, a k * (N k q : ℂ)) :
    ∃ m : ι → ℤ, ∀ q, X q = ∑ k, m k * N k q := by
  obtain ⟨π, hπ⟩ := exists_retraction a ha
  refine ⟨fun k => π ⟨a k, mem_unitSpan a k⟩, fun q => ?_⟩
  have hM : X q • (⟨1, one_mem_unitSpan a⟩ : unitSpan a) =
      ∑ k, N k q • (⟨a k, mem_unitSpan a k⟩ : unitSpan a) := by
    apply Subtype.ext
    rw [Submodule.coe_smul, Submodule.coe_sum, zsmul_eq_mul, mul_one, h q]
    exact Finset.sum_congr rfl fun k _ => by
      rw [Submodule.coe_smul, zsmul_eq_mul, mul_comm]
  have hπM := congrArg π hM
  rw [map_zsmul, hπ, map_sum, smul_eq_mul, mul_one] at hπM
  rw [hπM]
  exact Finset.sum_congr rfl fun k _ => by rw [map_zsmul, smul_eq_mul, mul_comm]

end GaloisForLFunctions
