import GaloisForLFunctions.RHTower.Artin.IdealsWithArtinSymbolInASubgroupOfACyclotomicExtension
import GaloisForLFunctions.RHTower.Artin.RelativeNormsOfRayElementsAreRayElements

/-!
# The norm group of the fixed field of a subgroup and its Artin symbols

Let `M/K` be an abelian extension of number fields with group `Γ`, and `N ≥ 1` such that the
primes `v ∤ N` of `K` are unramified in `M`. For a subgroup `H` of `Γ` let

  `D_H = ⟨v^g : v ∤ N, Frob_v^g ∈ H⟩`  (`frobeniusPowerGroup`).

With `E` the fixed field of `H`:

* `D_H` is the group of the norms from `E` of the ideals prime to `N`
  (`idealNormHom_mem_frobeniusPowerGroup`, `frobeniusPowerGroup_le_map_idealNormHom`): the norm
  of a prime `w` of `E` is `v^f` with `Frob_v^f = Frob_w ∈ H`, and if `Frob_v^g ∈ H` then
  `f(w | v)` divides `g`;
* the Artin map of `M/K` sends `D_H` onto `H` (`artinMap_mem_of_mem_frobeniusPowerGroup`,
  `exists_mem_frobeniusPowerGroup_artinMap_eq`): the Artin map of `M/E` is onto `H`, and
  `(N_{E/K} 𝔅, M/K) = (𝔅, M/E)`.

**The kernel modulo a subgroup** (`mem_rayPrincipal_sup_frobeniusPowerGroup`). Let `ζ ∈ M` be a
primitive `m`-th root of unity, `m | N`, whose cyclotomic character is injective on `H`; so `M`
lies in `E(ζ)`. For every subgroup `Λ` of `Γ`, an ideal `𝔠 ∈ D_H` with `(𝔠, M/K) ∈ Λ` lies in
`P_{(N) ∞} · D_Λ`, with `P_{(N) ∞}` the principal ideals of the ray modulo `(N) ∞`. Proof:
`𝔠 = N_{E/K} 𝔅` with `(𝔅, M/E) ∈ Λ ∩ H`; over `E` the ideal `𝔅` is a product of a principal
ideal of the ray modulo `(N) ∞` and of primes with Frobenius element in `Λ ∩ H`; the norm maps
the ray of `E` into the ray of `K`, and such a prime `w` to `v^f` with `Frob_v^f ∈ Λ`.
-/

open scoped Classical BigOperators NumberField nonZeroDivisors
open NumberField IsDedekindDomain FractionalIdeal

noncomputable section

universe u

namespace GaloisForLFunctions

open HeckeLFunctions ArtinMertens

/-- The cyclotomic character of a subgroup is the restriction of the cyclotomic character. -/
theorem cyclotomicCharacter_subgroup {M Γ : Type u} [Field M] [Group Γ] [MulSemiringAction Γ M]
    {m : ℕ} [NeZero m] {ζ : 𝓞 M} (hζ : IsPrimitiveRoot ζ m) (H : Subgroup Γ) (h : H) :
    cyclotomicCharacter (G := ↥H) hζ h = cyclotomicCharacter (G := Γ) hζ (h : Γ) :=
  Units.ext ((coe_cyclotomicCharacter_of_smul_eq_pow hζ (σ := h)
    (pow_cyclotomicCharacter_val hζ (h : Γ)).symm).trans (ZMod.natCast_zmod_val _))

variable (K M : Type u) {Γ : Type u} [Field K] [NumberField K] [Field M] [NumberField M]
  [Algebra K M] [CommGroup Γ] [Fintype Γ] [MulSemiringAction Γ M] [IsGaloisGroup Γ K M]
  (N : ℕ) [NeZero N]

/-- The group of ideals generated by the powers `v^g` of the primes `v ∤ N` with
`Frob_v^g ∈ H`. -/
def frobeniusPowerGroup (H : Subgroup Γ) : Subgroup (FractionalIdeal (𝓞 K)⁰ K)ˣ :=
  Subgroup.closure {I | ∃ (v : HeightOneSpectrum (𝓞 K)) (g : ℕ), (N : 𝓞 K) ∉ v.asIdeal ∧
    frobeniusElement K M Γ v ^ g ∈ H ∧ I = idealUnit v.ne_bot ^ g}

omit [NeZero N] in
theorem frobeniusPowerGroup_mono {H H' : Subgroup Γ} (h : H ≤ H') :
    frobeniusPowerGroup K M N H ≤ frobeniusPowerGroup K M N H' :=
  Subgroup.closure_mono (by
    rintro _ ⟨v, g, hv, hg, rfl⟩
    exact ⟨v, g, hv, h hg, rfl⟩)

omit [NumberField K] [NeZero N] in
/-- A prime of the fixed field that does not divide `N` lies over a prime that does not divide
`N`. -/
theorem natCast_notMem_under (E : Type u) [Field E] [NumberField E] [Algebra K E]
    {w : HeightOneSpectrum (𝓞 E)} (hw : (N : 𝓞 E) ∉ w.asIdeal) :
    (N : 𝓞 K) ∉ (w.under (𝓞 K)).asIdeal := fun h => hw (by
  have h' : algebraMap (𝓞 K) (𝓞 E) (N : 𝓞 K) ∈ w.asIdeal := h
  rwa [map_natCast] at h')

/-- A prime in the support of an ideal prime to `N` lies over a prime that does not divide
`N`. -/
theorem natCast_notMem_under_of_count_ne_zero (E : Type u) [Field E] [NumberField E]
    [Algebra K E] {𝔅 : (FractionalIdeal (𝓞 E)⁰ E)ˣ} (h𝔅 : 𝔅 ∈ idealGroup (normModulus E N))
    {w : HeightOneSpectrum (𝓞 E)} (hw : count E w (𝔅 : FractionalIdeal (𝓞 E)⁰ E) ≠ 0) :
    (N : 𝓞 K) ∉ (w.under (𝓞 K)).asIdeal :=
  natCast_notMem_under K N E fun h => hw (h𝔅 w ((dvd_normModulus_fin_iff E N w).mpr h))

variable (hur : ∀ v : HeightOneSpectrum (𝓞 K), (N : 𝓞 K) ∉ v.asIdeal →
  IsUnramifiedPrime K M Γ v)

include hur

omit [NeZero N] in
/-- The Artin map sends `D_H` into `H`. -/
theorem artinMap_mem_of_mem_frobeniusPowerGroup (H : Subgroup Γ)
    {I : (FractionalIdeal (𝓞 K)⁰ K)ˣ} (hI : I ∈ frobeniusPowerGroup K M N H) :
    artinMap K M Γ I ∈ H := by
  have hle : frobeniusPowerGroup K M N H ≤ H.comap (artinMap K M Γ) := by
    refine (Subgroup.closure_le _).mpr ?_
    rintro _ ⟨v, g, hv, hg, rfl⟩
    rw [SetLike.mem_coe, Subgroup.mem_comap, map_pow, artinMap_idealUnit_prime, frobeniusOrOne,
      if_pos (hur v hv)]
    exact hg
  exact hle hI

/-- **The norm of an ideal prime to `N` of the fixed field of `H` lies in `D_H`.** -/
theorem idealNormHom_mem_frobeniusPowerGroup (H : Subgroup Γ)
    {𝔅 : (FractionalIdeal (𝓞 (FixedPoints.intermediateField H : IntermediateField K M))⁰
      (FixedPoints.intermediateField H : IntermediateField K M))ˣ}
    (h𝔅 : 𝔅 ∈ idealGroup
      (normModulus (FixedPoints.intermediateField H : IntermediateField K M) N)) :
    idealNormHom K (FixedPoints.intermediateField H : IntermediateField K M) 𝔅 ∈
      frobeniusPowerGroup K M N H := by
  refine primeValuesHom_mem _ 𝔅 fun w hw => ?_
  have hNw := natCast_notMem_under_of_count_ne_zero K N _ h𝔅 hw
  refine Subgroup.subset_closure ⟨w.under (𝓞 K), w.asIdeal.inertiaDeg (𝓞 K), hNw, ?_, rfl⟩
  rw [← map_frobeniusElement_eq_pow K (FixedPoints.intermediateField H : IntermediateField K M)
    M H.subtype (fun _ _ => rfl) w (hur _ hNw)]
  exact SetLike.coe_mem _

omit hur in
/-- **Every element of `D_H` is the norm of an ideal prime to `N` of the fixed field of `H`.** -/
theorem frobeniusPowerGroup_le_map_idealNormHom (H : Subgroup Γ) :
    frobeniusPowerGroup K M N H ≤
      (idealGroup (normModulus (FixedPoints.intermediateField H : IntermediateField K M) N)).map
        (idealNormHom K (FixedPoints.intermediateField H : IntermediateField K M)) := by
  refine (Subgroup.closure_le _).mpr ?_
  rintro _ ⟨v, g, hv, hg, rfl⟩
  obtain ⟨w, k, hwv, hnorm⟩ := exists_idealNormHom_pow_eq_idealUnit_pow K
    (FixedPoints.intermediateField H : IntermediateField K M) M v (g := g)
    fun x => x.2 ⟨_, hg⟩
  refine ⟨idealUnit w.ne_bot ^ k, Subgroup.pow_mem _ ?_ _, hnorm⟩
  refine idealUnit_prime_mem_idealGroup _ fun hdvd => hv ?_
  rw [dvd_normModulus_fin_iff] at hdvd
  rw [← hwv, HeightOneSpectrum.under_asIdeal, Ideal.under_def, Ideal.mem_comap, map_natCast]
  exact hdvd

/-- **The Artin map sends `D_H` onto `H`.** -/
theorem exists_mem_frobeniusPowerGroup_artinMap_eq (H : Subgroup Γ) {h : Γ} (hh : h ∈ H) :
    ∃ I ∈ frobeniusPowerGroup K M N H, artinMap K M Γ I = h := by
  -- the Artin map of `M` over the fixed field is onto `H`
  obtain ⟨𝔅, h𝔅, h𝔅eq⟩ := exists_mem_idealGroup_artinMap_eq
    (FixedPoints.intermediateField H : IntermediateField K M) M ↥H
    (normModulus (FixedPoints.intermediateField H : IntermediateField K M) N)
    (fun w hw => isUnramifiedPrime_of_under K _ M H.subtype (fun _ _ => rfl) w
      (hur _ (natCast_notMem_under K N _ fun hN => hw ((dvd_normModulus_fin_iff _ N w).mpr hN))))
    ⟨h, hh⟩
  refine ⟨_, idealNormHom_mem_frobeniusPowerGroup K M N hur H h𝔅, ?_⟩
  rw [← map_artinMap_eq_artinMap_idealNormHom K
    (FixedPoints.intermediateField H : IntermediateField K M) M H.subtype (fun _ _ => rfl) 𝔅
    fun w hw => hur _ (natCast_notMem_under_of_count_ne_zero K N _ h𝔅 hw), h𝔅eq]
  rfl

/-- **Ideals of the norm group with Artin symbol in a subgroup.** If the cyclotomic character of
a primitive `m`-th root of unity of `M`, `m | N`, is injective on `H`, then every `𝔠 ∈ D_H` with
`(𝔠, M/K) ∈ Λ` is the product of a principal ideal of the ray modulo `(N) ∞` and of an element
of `D_Λ`. -/
theorem mem_rayPrincipal_sup_frobeniusPowerGroup {m : ℕ} [NeZero m] {ζ : 𝓞 M}
    (hζ : IsPrimitiveRoot ζ m) (hmN : m ∣ N) (H Λ : Subgroup Γ)
    (hκ : Function.Injective (cyclotomicCharacter (G := ↥H) hζ))
    {I : (FractionalIdeal (𝓞 K)⁰ K)ˣ} (hI : I ∈ frobeniusPowerGroup K M N H)
    (hIΛ : artinMap K M Γ I ∈ Λ) :
    I ∈ rayPrincipal (normModulus K N) ⊔ frobeniusPowerGroup K M N Λ := by
  obtain ⟨𝔅, h𝔅, rfl⟩ := frobeniusPowerGroup_le_map_idealNormHom K M N H hI
  -- the Artin symbol of `𝔅` over the fixed field lies in `Λ ∩ H`
  have hsym : artinMap (FixedPoints.intermediateField H : IntermediateField K M) M ↥H 𝔅 ∈
      Λ.subgroupOf H := by
    rw [Subgroup.mem_subgroupOf]
    have h := map_artinMap_eq_artinMap_idealNormHom K
      (FixedPoints.intermediateField H : IntermediateField K M) M H.subtype (fun _ _ => rfl) 𝔅
      fun w hw => hur _ (natCast_notMem_under_of_count_ne_zero K N _ h𝔅 hw)
    rw [← h] at hIΛ
    exact hIΛ
  have hC := mem_rayPrincipal_sup_frobeniusPrimeGroup
    (FixedPoints.intermediateField H : IntermediateField K M) M hζ hκ N hmN (Λ.subgroupOf H)
    h𝔅 hsym
  have hmap := Subgroup.mem_map_of_mem
    (idealNormHom K (FixedPoints.intermediateField H : IntermediateField K M)) hC
  rw [Subgroup.map_sup] at hmap
  -- the norm maps the ray into the ray
  have h1 : (rayPrincipal
      (normModulus (FixedPoints.intermediateField H : IntermediateField K M) N)).map
        (idealNormHom K (FixedPoints.intermediateField H : IntermediateField K M)) ≤
      rayPrincipal (normModulus K N) := by
    rintro _ ⟨J, hJ, rfl⟩
    exact idealNormHom_mem_rayPrincipal K _ N hJ
  -- the norm of a prime with Frobenius element in `Λ ∩ H`
  have h2 : (frobeniusPrimeGroup (FixedPoints.intermediateField H : IntermediateField K M) M N
      (Λ.subgroupOf H)).map
        (idealNormHom K (FixedPoints.intermediateField H : IntermediateField K M)) ≤
      frobeniusPowerGroup K M N Λ := by
    rw [Subgroup.map_le_iff_le_comap, frobeniusPrimeGroup, Subgroup.closure_le]
    rintro _ ⟨w, hw, hwΛ, rfl⟩
    rw [SetLike.mem_coe, Subgroup.mem_comap, idealNormHom_idealUnit_prime]
    have hNw := natCast_notMem_under K N _ hw
    refine Subgroup.subset_closure ⟨w.under (𝓞 K), w.asIdeal.inertiaDeg (𝓞 K), hNw, ?_, rfl⟩
    rw [← map_frobeniusElement_eq_pow K
      (FixedPoints.intermediateField H : IntermediateField K M) M H.subtype (fun _ _ => rfl) w
      (hur _ hNw)]
    exact Subgroup.mem_subgroupOf.mp hwΛ
  exact sup_le_sup h1 h2 hmap

end GaloisForLFunctions
