import GaloisForLFunctions.RHTower.Artin.ArtinInducedSpanIsAnIdeal
import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic

/-!
# Spans over the algebraic integers

Brauer's theorem is proved with coefficients in the ring `𝓞` of algebraic integers of `ℂ`.

* `virtualIntGroup G`: the `𝓞`-span of the characters of `G`. It is a ring of class functions
  (`mul_mem_virtualIntGroup`, `one_mem_virtualIntGroup`, `pow_mem_virtualIntGroup`,
  `virtualIntGroup_conj`) that contains the virtual characters.
* `inducedSpanInt 𝔉`: the `𝓞`-span of the characters induced from the subgroups of a family
  `𝔉`. It contains `inducedSpan 𝔉`, is stable under multiplication by algebraic integers
  (`smul_mem_inducedSpanInt`) and is an ideal of `virtualIntGroup G`
  (`mul_mem_inducedSpanInt`), by the projection formula.

Both are defined as additive subgroups generated by the multiples `a · χ` with `a` an algebraic
integer.
-/

open scoped Classical

noncomputable section

universe u

namespace GaloisForLFunctions

variable {G : Type u} [Group G]

/-! ### The span of the characters over the algebraic integers -/

/-- The span over the algebraic integers of the characters of `G`. -/
def virtualIntGroup (G : Type u) [Group G] : AddSubgroup (G → ℂ) :=
  AddSubgroup.closure
    {f | ∃ a : ℂ, IsIntegral ℤ a ∧ ∃ χ ∈ fdCharacterSet G, f = fun g => a * χ g}

theorem virtualCharacterGroup_le_virtualIntGroup :
    virtualCharacterGroup G ≤ virtualIntGroup G := by
  rw [virtualCharacterGroup, AddSubgroup.closure_le]
  intro χ hχ
  exact AddSubgroup.subset_closure ⟨1, isIntegral_one, χ, hχ, funext fun g => (one_mul _).symm⟩

/-- Multiplication by an algebraic integer. -/
theorem smul_mem_virtualIntGroup {a : ℂ} (ha : IsIntegral ℤ a) {f : G → ℂ}
    (hf : f ∈ virtualIntGroup G) : (fun g => a * f g) ∈ virtualIntGroup G := by
  refine AddSubgroup.closure_induction (p := fun f _ => (fun g => a * f g) ∈ virtualIntGroup G)
    ?_ ?_ ?_ ?_ hf
  · rintro f ⟨b, hb, χ, hχ, rfl⟩
    exact AddSubgroup.subset_closure ⟨a * b, ha.mul hb, χ, hχ, funext fun g => (mul_assoc _ _ _).symm⟩
  · simp only [Pi.zero_apply, mul_zero]
    exact zero_mem _
  · intro x y _ _ hx hy
    have e : (fun g => a * (x + y) g) = (fun g => a * x g) + fun g => a * y g :=
      funext fun g => mul_add _ _ _
    rw [e]
    exact add_mem hx hy
  · intro x _ hx
    have e : (fun g => a * (-x) g) = -fun g => a * x g := funext fun g => mul_neg _ _
    rw [e]
    exact neg_mem hx

/-- The `𝓞`-span of the characters is closed under products. -/
theorem mul_mem_virtualIntGroup {f ψ : G → ℂ} (hf : f ∈ virtualIntGroup G)
    (hψ : ψ ∈ virtualIntGroup G) : f * ψ ∈ virtualIntGroup G := by
  refine AddSubgroup.closure_induction (p := fun ψ _ => f * ψ ∈ virtualIntGroup G) ?_ ?_ ?_ ?_ hψ
  · rintro ψ ⟨b, hb, χ', hχ', rfl⟩
    refine AddSubgroup.closure_induction
      (p := fun f _ => (f * fun g => b * χ' g) ∈ virtualIntGroup G) ?_ ?_ ?_ ?_ hf
    · rintro f ⟨a, ha, χ, hχ, rfl⟩
      exact AddSubgroup.subset_closure ⟨a * b, ha.mul hb, χ * χ', mul_mem_fdCharacterSet hχ hχ',
        funext fun g => by simp only [Pi.mul_apply]; ring⟩
    · rw [zero_mul]
      exact zero_mem _
    · intro x y _ _ hx hy
      rw [add_mul]
      exact add_mem hx hy
    · intro x _ hx
      rw [neg_mul]
      exact neg_mem hx
  · rw [mul_zero]
    exact zero_mem _
  · intro x y _ _ hx hy
    rw [mul_add]
    exact add_mem hx hy
  · intro x _ hx
    rw [mul_neg]
    exact neg_mem hx

theorem one_mem_virtualIntGroup : (1 : G → ℂ) ∈ virtualIntGroup G :=
  virtualCharacterGroup_le_virtualIntGroup (AddSubgroup.subset_closure one_mem_fdCharacterSet)

theorem pow_mem_virtualIntGroup {f : G → ℂ} (hf : f ∈ virtualIntGroup G) (n : ℕ) :
    f ^ n ∈ virtualIntGroup G := by
  induction n with
  | zero =>
    rw [pow_zero]
    exact one_mem_virtualIntGroup
  | succ n ih =>
    rw [pow_succ]
    exact mul_mem_virtualIntGroup ih hf

/-- The members of the `𝓞`-span of the characters are class functions. -/
theorem virtualIntGroup_conj {f : G → ℂ} (hf : f ∈ virtualIntGroup G) (x g : G) :
    f (x * g * x⁻¹) = f g := by
  refine AddSubgroup.closure_induction (p := fun f _ => f (x * g * x⁻¹) = f g) ?_ ?_ ?_ ?_ hf
  · rintro f ⟨a, -, χ, ⟨V, rfl⟩, rfl⟩
    exact congrArg (a * ·) (FDRep.char_conj V g x)
  · rfl
  · intro u v _ _ hu hv
    simp only [Pi.add_apply, hu, hv]
  · intro u _ hu
    simp only [Pi.neg_apply, hu]

/-! ### The span of the induced characters over the algebraic integers -/

variable [Fintype G]

/-- The span over the algebraic integers of the characters induced from the subgroups of a
family. -/
def inducedSpanInt (𝔉 : Set (Subgroup G)) : AddSubgroup (G → ℂ) :=
  AddSubgroup.closure {f | ∃ a : ℂ, IsIntegral ℤ a ∧ ∃ H ∈ 𝔉, ∃ χ ∈ fdCharacterSet H,
    f = fun g => a * inducedFunction H χ g}

theorem inducedSpan_le_inducedSpanInt (𝔉 : Set (Subgroup G)) :
    inducedSpan 𝔉 ≤ inducedSpanInt 𝔉 := by
  rw [inducedSpan, AddSubgroup.closure_le]
  rintro f ⟨H, hH, χ, hχ, rfl⟩
  exact AddSubgroup.subset_closure
    ⟨1, isIntegral_one, H, hH, χ, hχ, funext fun g => (one_mul _).symm⟩

theorem inducedSpanInt_mono {𝔉 𝔉' : Set (Subgroup G)} (h : 𝔉 ⊆ 𝔉') :
    inducedSpanInt 𝔉 ≤ inducedSpanInt 𝔉' := by
  rw [inducedSpanInt, AddSubgroup.closure_le]
  rintro f ⟨a, ha, H, hH, χ, hχ, rfl⟩
  exact AddSubgroup.subset_closure ⟨a, ha, H, h hH, χ, hχ, rfl⟩

/-- Multiplication by an algebraic integer. -/
theorem smul_mem_inducedSpanInt {𝔉 : Set (Subgroup G)} {a : ℂ} (ha : IsIntegral ℤ a)
    {f : G → ℂ} (hf : f ∈ inducedSpanInt 𝔉) : (fun g => a * f g) ∈ inducedSpanInt 𝔉 := by
  refine AddSubgroup.closure_induction (p := fun f _ => (fun g => a * f g) ∈ inducedSpanInt 𝔉)
    ?_ ?_ ?_ ?_ hf
  · rintro f ⟨b, hb, H, hH, χ, hχ, rfl⟩
    exact AddSubgroup.subset_closure
      ⟨a * b, ha.mul hb, H, hH, χ, hχ, funext fun g => (mul_assoc _ _ _).symm⟩
  · simp only [Pi.zero_apply, mul_zero]
    exact zero_mem _
  · intro x y _ _ hx hy
    have e : (fun g => a * (x + y) g) = (fun g => a * x g) + fun g => a * y g :=
      funext fun g => mul_add _ _ _
    rw [e]
    exact add_mem hx hy
  · intro x _ hx
    have e : (fun g => a * (-x) g) = -fun g => a * x g := funext fun g => mul_neg _ _
    rw [e]
    exact neg_mem hx

/-- **The `𝓞`-span of the induced characters is an ideal of the `𝓞`-span of the characters.** -/
theorem mul_mem_inducedSpanInt {𝔉 : Set (Subgroup G)} {f ψ : G → ℂ}
    (hf : f ∈ inducedSpanInt 𝔉) (hψ : ψ ∈ virtualIntGroup G) : f * ψ ∈ inducedSpanInt 𝔉 := by
  refine AddSubgroup.closure_induction (p := fun ψ _ => f * ψ ∈ inducedSpanInt 𝔉) ?_ ?_ ?_ ?_ hψ
  · rintro ψ ⟨b, hb, χ', hχ', rfl⟩
    refine AddSubgroup.closure_induction
      (p := fun f _ => (f * fun g => b * χ' g) ∈ inducedSpanInt 𝔉) ?_ ?_ ?_ ?_ hf
    · rintro f ⟨a, ha, H, hH, χ, hχ, rfl⟩
      -- the projection formula
      have hclass : ∀ x g : G, χ' (x * g * x⁻¹) = χ' g := by
        obtain ⟨W, rfl⟩ := hχ'
        exact fun x g => FDRep.char_conj W g x
      have hproj := inducedFunction_mul_restrict H χ χ' hclass
      have hmem : (fun h : H => χ h * χ' h) ∈ fdCharacterSet H :=
        mul_mem_fdCharacterSet hχ (restrict_mem_fdCharacterSet H hχ')
      refine AddSubgroup.subset_closure ⟨a * b, ha.mul hb, H, hH, _, hmem, ?_⟩
      rw [hproj]
      funext g
      simp only [Pi.mul_apply]
      ring
    · rw [zero_mul]
      exact zero_mem _
    · intro x y _ _ hx hy
      rw [add_mul]
      exact add_mem hx hy
    · intro x _ hx
      rw [neg_mul]
      exact neg_mem hx
  · rw [mul_zero]
    exact zero_mem _
  · intro x y _ _ hx hy
    rw [mul_add]
    exact add_mem hx hy
  · intro x _ hx
    rw [mul_neg]
    exact neg_mem hx

end GaloisForLFunctions
