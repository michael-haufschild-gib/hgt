import GaloisForLFunctions.RHTower.Artin.TheArtinMapOverAnIntermediateFieldIsTheArtinMapOfTheNorm
import GaloisForLFunctions.RHTower.Artin.RayClassesBelowDegreeOnePrimesHaveIndexAtMostTheDegree

/-!
# Ideals with Artin symbol in a subgroup of a cyclotomic extension

Let `L/K` be an abelian extension of number fields with group `G`, and `ζ ∈ L` a primitive
`m`-th root of unity whose cyclotomic character `κ : G → (ℤ/m)ˣ` is injective; so `L ⊂ K(ζ)`.
Let `N` be a multiple of `m`.

* **Ramification** (`isUnramifiedPrime_of_cyclotomicCharacter_injective`): a prime `v ∤ m` is
  unramified, since inertia acts trivially on `ζ`.
* **Reciprocity** (`cyclotomicCharacter_artinMap`): `κ((𝔞, L/K)) = N(𝔞) mod m` for the ideals
  `𝔞` prime to `N`. Hence the Artin map is trivial on the ray modulo `(N) ∞`
  (`rayPrincipal_normModulus_le_ker_artinMap`).
* **The kernel modulo a subgroup** (`mem_rayPrincipal_sup_frobeniusPrimeGroup`): for a subgroup
  `H` of `G`, an ideal `𝔞` prime to `N` with `(𝔞, L/K) ∈ H` is the product of a principal ideal
  of the ray modulo `(N) ∞` and of primes `v ∤ N` with Frobenius element in `H`.

Proof of the last statement. Let `S` be the group generated by the ray and these primes. The
Artin map sends the ideals prime to `N` onto `G`, and `S` into `H`; so `[I^N : S] ≥ [G : H]`. Let
`F` be the fixed field of `H`. A prime `P` of `F` of degree one over `v = P ∩ K` has the
Frobenius element of `v`, which is the Frobenius element of `P` in `L/F`, in `H`. So the classes
of the primes below the degree-one primes of `F` are trivial modulo `S`, and
`[I^N : S] ≤ [F : K] = [G : H]`.
-/

open scoped Classical BigOperators NumberField nonZeroDivisors
open NumberField IsDedekindDomain FractionalIdeal

noncomputable section

universe u

namespace GaloisForLFunctions

open HeckeLFunctions ArtinMertens

/-- The residue modulo a divisor `m` of `N` of the class modulo `N` of an integer prime to
`N`. -/
theorem unitsMap_unitOfCoprime {m N : ℕ} (hmN : m ∣ N) (n : ℕ) (hN : n.Coprime N)
    (hm : n.Coprime m) :
    ZMod.unitsMap hmN (ZMod.unitOfCoprime n hN) = ZMod.unitOfCoprime n hm := by
  refine Units.ext ?_
  rw [ZMod.unitsMap_def, Units.coe_map, ZMod.coe_unitOfCoprime, ZMod.coe_unitOfCoprime]
  exact map_natCast (ZMod.castHom hmN (ZMod m)) n

variable (K L : Type u) {G : Type u} [Field K] [NumberField K] [Field L] [NumberField L]
  [Algebra K L] [CommGroup G] [Fintype G] [MulSemiringAction G L] [IsGaloisGroup G K L]
  {m : ℕ} [NeZero m] {ζ : 𝓞 L} (hζ : IsPrimitiveRoot ζ m)
  (hκ : Function.Injective (cyclotomicCharacter (G := G) hζ))

/-! ### Ramification and reciprocity -/

include hκ in
omit [NumberField K] [NumberField L] [Fintype G] [IsGaloisGroup G K L] in
/-- **A prime that does not divide `m` is unramified**: its inertia groups act trivially on
`ζ`. -/
theorem isUnramifiedPrime_of_cyclotomicCharacter_injective {v : HeightOneSpectrum (𝓞 K)}
    (hv : (m : 𝓞 K) ∉ v.asIdeal) : IsUnramifiedPrime K L G v := by
  intro Q _ hQv
  have hQm : (m : 𝓞 L) ∉ Q := fun h => hv (by
    rw [hQv.over, Ideal.under_def, Ideal.mem_comap, map_natCast]
    exact h)
  refine (Subgroup.eq_bot_iff_forall _).mpr fun τ hτ => hκ ?_
  rw [cyclotomicCharacter_eq_one_of_mem_inertia hζ hQm hτ, map_one]

/-- The Frobenius element of a prime `v ∤ m` raises `ζ` to the power `N(v)`. -/
theorem coe_cyclotomicCharacter_frobeniusElement (v : HeightOneSpectrum (𝓞 K))
    (hv : (m : 𝓞 K) ∉ v.asIdeal) :
    ((cyclotomicCharacter hζ (frobeniusElement K L G v) : (ZMod m)ˣ) : ZMod m) =
      (Ideal.absNorm v.asIdeal : ZMod m) := by
  have hQm : (m : 𝓞 L) ∉ primeAbove K L v := fun h => hv (by
    rw [(primeAbove_liesOver K L v).over, Ideal.under_def, Ideal.mem_comap, map_natCast]
    exact h)
  rw [frobeniusElement, coe_cyclotomicCharacter_arithFrobAt K L hζ _ hQm,
    ← (primeAbove_liesOver K L v).over, Ideal.absNorm_apply, Submodule.cardQuot_apply]

variable (N : ℕ) [NeZero N] (hmN : m ∣ N)

include hκ hmN

omit [NumberField K] [NumberField L] [Fintype G] [IsGaloisGroup G K L] [NeZero m] [NeZero N]
  hκ in
/-- A prime that does not divide `N` does not divide `m`. -/
theorem natCast_notMem_of_dvd {v : HeightOneSpectrum (𝓞 K)} (hv : (N : 𝓞 K) ∉ v.asIdeal) :
    (m : 𝓞 K) ∉ v.asIdeal := fun h => hv (by
  obtain ⟨c, rfl⟩ := hmN
  rw [Nat.cast_mul]
  exact Ideal.mul_mem_right _ _ h)

/-- **Reciprocity inside a cyclotomic extension**: the cyclotomic character of the Artin symbol
of an ideal prime to `N` is the residue of its norm modulo `m`. -/
theorem cyclotomicCharacter_artinMap (I : idealGroup (normModulus K N)) :
    cyclotomicCharacter hζ (artinMap K L G (I : (FractionalIdeal (𝓞 K)⁰ K)ˣ)) =
      ZMod.unitsMap hmN (normResidueHom K N I) := by
  have h1 : cyclotomicCharacter hζ (artinMap K L G (I : (FractionalIdeal (𝓞 K)⁰ K)ˣ)) =
      primeValuesHom (fun v => cyclotomicCharacter hζ (frobeniusOrOne K L G v))
        (I : (FractionalIdeal (𝓞 K)⁰ K)ˣ) :=
    DFunLike.congr_fun (comp_primeValuesHom (cyclotomicCharacter hζ) _) _
  have h2 : ZMod.unitsMap hmN (normResidueHom K N I) =
      primeValuesHom (fun v => ZMod.unitsMap hmN (normResidueUnit K N v))
        (I : (FractionalIdeal (𝓞 K)⁰ K)ˣ) :=
    DFunLike.congr_fun (comp_primeValuesHom (ZMod.unitsMap hmN) _) _
  rw [h1, h2]
  refine primeValuesHom_congr _ fun v hv => ?_
  have hvN : (N : 𝓞 K) ∉ v.asIdeal := fun h =>
    hv (I.2 v ((dvd_normModulus_fin_iff K N v).mpr h))
  have hvm : (m : 𝓞 K) ∉ v.asIdeal := natCast_notMem_of_dvd K N hmN hvN
  rw [frobeniusOrOne, if_pos (isUnramifiedPrime_of_cyclotomicCharacter_injective K L hζ hκ hvm),
    normResidueUnit, dif_neg hvN,
    unitsMap_unitOfCoprime hmN _ _ (absNorm_coprime_of_natCast_notMem v hvm)]
  exact Units.ext ((coe_cyclotomicCharacter_frobeniusElement K L hζ v hvm).trans
    (ZMod.coe_unitOfCoprime _ _).symm)

/-- **The Artin map of an extension inside a cyclotomic extension is trivial on the ray modulo
`(N) ∞`**, for every multiple `N` of `m`. -/
theorem rayPrincipal_normModulus_le_ker_artinMap :
    rayPrincipal (normModulus K N) ≤ (artinMap K L G).ker := by
  intro I hI
  have hI' : I ∈ idealGroup (normModulus K N) := rayPrincipal_le _ hI
  refine MonoidHom.mem_ker.mpr (hκ ?_)
  have h := cyclotomicCharacter_artinMap K L hζ hκ N hmN ⟨I, hI'⟩
  rw [normResidueHom_eq_one_of_mem K N ⟨I, hI'⟩ (Subgroup.mem_subgroupOf.mpr hI), map_one] at h
  rw [map_one]
  exact h

omit hκ hmN

/-! ### The kernel modulo a subgroup -/

/-- The group of ideals generated by the primes `v ∤ N` whose Frobenius element lies in `H`. -/
def frobeniusPrimeGroup (H : Subgroup G) : Subgroup (FractionalIdeal (𝓞 K)⁰ K)ˣ :=
  Subgroup.closure {I | ∃ v : HeightOneSpectrum (𝓞 K), (N : 𝓞 K) ∉ v.asIdeal ∧
    frobeniusElement K L G v ∈ H ∧ I = idealUnit v.ne_bot}

theorem frobeniusPrimeGroup_le_idealGroup (H : Subgroup G) :
    frobeniusPrimeGroup K L N H ≤ idealGroup (normModulus K N) := by
  refine (Subgroup.closure_le _).mpr ?_
  rintro _ ⟨v, hv, -, rfl⟩
  exact idealUnit_prime_mem_idealGroup _ fun h => hv ((dvd_normModulus_fin_iff K N v).mp h)

/-- The degree of the fixed field of a subgroup over the base is the index of the subgroup. -/
theorem finrank_fixedPoints_eq_index (H : Subgroup G) :
    Module.finrank K (FixedPoints.intermediateField H : IntermediateField K L) = H.index := by
  have h2 := IsGaloisGroup.finrank_fixedPoints_eq_card_subgroup G K L H
  have h3 := Module.finrank_mul_finrank K
    (FixedPoints.intermediateField H : IntermediateField K L) L
  rw [h2, ← IsGaloisGroup.card_eq_finrank G K L, ← H.index_mul_card] at h3
  exact Nat.eq_of_mul_eq_mul_right Nat.card_pos h3

include hκ hmN

/-- **Ideals with Artin symbol in a subgroup.** An ideal prime to `N` whose Artin symbol lies in
`H` is the product of a principal ideal of the ray modulo `(N) ∞` and of primes `v ∤ N` with
Frobenius element in `H`. -/
theorem mem_rayPrincipal_sup_frobeniusPrimeGroup (H : Subgroup G)
    {I : (FractionalIdeal (𝓞 K)⁰ K)ˣ} (hI : I ∈ idealGroup (normModulus K N))
    (hIH : artinMap K L G I ∈ H) :
    I ∈ rayPrincipal (normModulus K N) ⊔ frobeniusPrimeGroup K L N H := by
  have hur : ∀ v : HeightOneSpectrum (𝓞 K), (N : 𝓞 K) ∉ v.asIdeal →
      IsUnramifiedPrime K L G v := fun v hv =>
    isUnramifiedPrime_of_cyclotomicCharacter_injective K L hζ hκ
      (natCast_notMem_of_dvd K N hmN hv)
  have hram : ∀ v : HeightOneSpectrum (𝓞 K), ¬ v.asIdeal ∣ (normModulus K N).fin →
      IsUnramifiedPrime K L G v := fun v hv =>
    hur v fun h => hv ((dvd_normModulus_fin_iff K N v).mpr h)
  -- the Artin map sends the ray and the primes with Frobenius element in `H` into `H`
  have hSH : rayPrincipal (normModulus K N) ⊔ frobeniusPrimeGroup K L N H ≤
      H.comap (artinMap K L G) := by
    refine sup_le (fun J hJ => ?_) ((Subgroup.closure_le _).mpr ?_)
    · rw [Subgroup.mem_comap,
        MonoidHom.mem_ker.mp (rayPrincipal_normModulus_le_ker_artinMap K L hζ hκ N hmN hJ)]
      exact H.one_mem
    · rintro _ ⟨v, hv, hvH, rfl⟩
      rw [SetLike.mem_coe, Subgroup.mem_comap, artinMap_idealUnit_prime, frobeniusOrOne,
        if_pos (hur v hv)]
      exact hvH
  let S : Subgroup (idealGroup (normModulus K N)) :=
    (rayPrincipal (normModulus K N) ⊔ frobeniusPrimeGroup K L N H).subgroupOf
      (idealGroup (normModulus K N))
  let Ψ : idealGroup (normModulus K N) →* G ⧸ H :=
    (QuotientGroup.mk' H).comp ((artinMap K L G).comp (idealGroup (normModulus K N)).subtype)
  have hΨ : ∀ x : idealGroup (normModulus K N),
      x ∈ Ψ.ker ↔ artinMap K L G (x : (FractionalIdeal (𝓞 K)⁰ K)ˣ) ∈ H := fun x =>
    MonoidHom.mem_ker.trans (QuotientGroup.eq_one_iff _)
  have hSΨ : S ≤ Ψ.ker := fun x hx => (hΨ x).mpr (hSH (Subgroup.mem_subgroupOf.mp hx))
  -- the index of the kernel is `[G : H]`
  have hΨsurj : Function.Surjective Ψ := fun q => by
    obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective q
    obtain ⟨J, hJ, rfl⟩ := exists_mem_idealGroup_artinMap_eq K L G (normModulus K N) hram g
    exact ⟨⟨J, hJ⟩, rfl⟩
  have hΨidx : Ψ.ker.index = H.index := by
    rw [Subgroup.index_ker, MonoidHom.range_eq_top.mpr hΨsurj, Subgroup.card_top]
    rfl
  -- the classes modulo `S` form a quotient of the ray class group
  let π : RayClassGroup (normModulus K N) →* idealGroup (normModulus K N) ⧸ S :=
    QuotientGroup.lift _ (QuotientGroup.mk' S) fun x hx =>
      (QuotientGroup.eq_one_iff x).mpr
        (Subgroup.mem_subgroupOf.mpr (Subgroup.mem_sup_left (Subgroup.mem_subgroupOf.mp hx)))
  have hπ : Function.Surjective π := fun q => by
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective q
    exact ⟨rayClass (normModulus K N) x, rfl⟩
  haveI : Finite (idealGroup (normModulus K N) ⧸ S) := Finite.of_surjective π hπ
  -- the primes below the degree-one primes of the fixed field of `H` lie in `S`
  have hcard : Nat.card (idealGroup (normModulus K N) ⧸ S) ≤
      Module.finrank K (FixedPoints.intermediateField H : IntermediateField K L) := by
    refine card_le_finrank_of_forall_degreeOne_eq_one
      (L := (FixedPoints.intermediateField H : IntermediateField K L)) (normModulus K N) π hπ
      fun P hP hPN h0 hm => ?_
    have hP0 : P ≠ ⊥ := Ideal.ne_bot_of_liesOver_of_ne_bot h0 P
    let w : HeightOneSpectrum (𝓞 (FixedPoints.intermediateField H : IntermediateField K L)) :=
      ⟨P, hP, hP0⟩
    have hvN : (N : 𝓞 K) ∉ (w.under (𝓞 K)).asIdeal := fun h => by
      have htop := (idealUnit_mem_idealGroup_iff (normModulus K N) h0).mp hm
      have hle : (normModulus K N).fin ≤ P.under (𝓞 K) :=
        (Ideal.span_singleton_le_iff_mem _).mpr h
      rw [sup_eq_left.mpr hle] at htop
      exact (w.under (𝓞 K)).isPrime.ne_top htop
    have hdeg : w.asIdeal.inertiaDeg (𝓞 K) = 1 :=
      inertiaDeg_eq_one_of_absNorm_eq K
        (FixedPoints.intermediateField H : IntermediateField K L) w hPN
    -- the Frobenius element of `P ∩ K` is the Frobenius element of `P`, an element of `H`
    have hfrob := map_frobeniusElement_eq_pow K
      (FixedPoints.intermediateField H : IntermediateField K L) L H.subtype (fun _ _ => rfl) w
      (hur _ hvN)
    rw [hdeg, pow_one] at hfrob
    have hmem : frobeniusElement K L G (w.under (𝓞 K)) ∈ H := hfrob ▸ SetLike.coe_mem _
    have hgen : idealUnit h0 ∈ frobeniusPrimeGroup K L N H :=
      Subgroup.subset_closure ⟨w.under (𝓞 K), hvN, hmem, rfl⟩
    exact (QuotientGroup.eq_one_iff _).mpr
      (Subgroup.mem_subgroupOf.mpr (Subgroup.mem_sup_right hgen))
  rw [finrank_fixedPoints_eq_index K L H] at hcard
  -- `S` has index at most `[G : H]` and lies in the kernel, so it is the kernel
  have hrel := Subgroup.relIndex_mul_index hSΨ
  have hSidx : S.index = Nat.card (idealGroup (normModulus K N) ⧸ S) := rfl
  have hSpos : 0 < S.index := hSidx ▸ Nat.card_pos
  rw [hΨidx] at hrel
  have hHpos : 0 < H.index := Nat.pos_of_ne_zero fun h0 => by
    rw [h0, mul_zero] at hrel
    exact hSpos.ne hrel
  have hone : S.relIndex Ψ.ker = 1 := by
    have hle : S.relIndex Ψ.ker * H.index ≤ 1 * H.index := by
      rw [hrel, one_mul, hSidx]
      exact hcard
    have h1 := Nat.le_of_mul_le_mul_right hle hHpos
    have h2 : S.relIndex Ψ.ker ≠ 0 := fun h0 => by
      rw [h0, zero_mul] at hrel
      exact hSpos.ne hrel
    omega
  have hmemS : (⟨I, hI⟩ : idealGroup (normModulus K N)) ∈ S :=
    Subgroup.relIndex_eq_one.mp hone ((hΨ ⟨I, hI⟩).mpr hIH)
  exact Subgroup.mem_subgroupOf.mp hmemS

end GaloisForLFunctions
