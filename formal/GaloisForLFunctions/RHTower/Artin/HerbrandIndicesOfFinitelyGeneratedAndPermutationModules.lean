import GaloisForLFunctions.RHTower.Artin.TheHerbrandQuotientIsMultiplicative
import Mathlib.GroupTheory.FiniteAbelian.Basic
import Mathlib.GroupTheory.GroupAction.Quotient
import Mathlib.RingTheory.Noetherian.Basic
import Mathlib.Data.ZMod.Basic
import Mathlib.Algebra.BigOperators.Group.Finset.Basic

/-!
# Herbrand indices of a cyclic group: finitely generated and permutation modules

Let a finite group `G` generated by `σ` act on an abelian group `A`, `f = σ − 1`
(`actionDiff`) and `g = Σ_τ τ` the norm (`actionNorm`). Then `f g = g f = 0`,
`[ker f : im g] = [A^G : N A]` and `[ker g : im f]` are the orders of `Ĥ⁰(G, A)` and
`Ĥ¹(G, A)`.

* **Finitely generated modules** (`herbrandIndex_actionDiff_ne_zero`,
  `herbrandIndex_actionNorm_ne_zero`): both indices are finite if `A` is finitely generated.
  Indeed `|G| · ker f ⊆ im g`, since `N a = |G| a` for invariant `a`, and `|G| · ker g ⊆ im f`,
  since `|G| a = Σ_τ (a − τa)` for `N a = 0` and `a − τa ∈ im (σ − 1)` for every `τ`.
* **The trivial module `ℤ`** (`herbrandIndex_int_trivial`): the indices are `|G|` and `1`.
* **Permutation modules** (`herbrandIndex_permRep_le`): for a finite `G`-set `X`,
  `[(ℤ^X)^G : N ℤ^X] ≤ Π_ω |G_ω|`, the product over the orbits of the orders of the
  stabilizers. An invariant function `y` whose value on the orbit `ω` is `|G_ω| d_ω` is the
  norm of the function with value `d_ω` at one point of `ω` and `0` elsewhere.
-/

open Function
open scoped Classical

noncomputable section

namespace GaloisForLFunctions

section Action

variable {G : Type*} [Group G] [Fintype G] {A : Type*} [AddCommGroup A]
  (ρ : G →* AddMonoid.End A)

/-- The endomorphism `a ↦ σa − a`. -/
def actionDiff (σ : G) : A →+ A := (show A →+ A from ρ σ) - AddMonoidHom.id A

/-- The norm `a ↦ Σ_τ τa`. -/
def actionNorm : A →+ A := ∑ τ : G, (show A →+ A from ρ τ)

omit [Fintype G] in
theorem actionDiff_apply (σ : G) (a : A) : actionDiff ρ σ a = ρ σ a - a := rfl

theorem actionNorm_apply (a : A) : actionNorm ρ a = ∑ τ : G, ρ τ a := by
  rw [actionNorm, AddMonoidHom.finsetSum_apply]
  rfl

omit [Fintype G] in
theorem rep_mul_apply (σ τ : G) (a : A) : ρ (σ * τ) a = ρ σ (ρ τ a) := by
  rw [map_mul]; rfl

omit [Fintype G] in
theorem rep_one_apply (a : A) : ρ 1 a = a := by
  rw [map_one]; rfl

theorem rep_apply_actionNorm (σ : G) (a : A) : ρ σ (actionNorm ρ a) = actionNorm ρ a := by
  rw [actionNorm_apply, map_sum]
  simp_rw [← rep_mul_apply]
  exact Fintype.sum_bijective (σ * ·) (Group.mulLeft_bijective σ) _ _ fun _ => rfl

theorem actionNorm_rep_apply (σ : G) (a : A) : actionNorm ρ (ρ σ a) = actionNorm ρ a := by
  rw [actionNorm_apply, actionNorm_apply]
  simp_rw [← rep_mul_apply]
  exact Fintype.sum_bijective (· * σ) (Group.mulRight_bijective σ) _ _ fun _ => rfl

theorem actionDiff_actionNorm (σ : G) (a : A) : actionDiff ρ σ (actionNorm ρ a) = 0 := by
  rw [actionDiff_apply, rep_apply_actionNorm, sub_self]

theorem actionNorm_actionDiff (σ : G) (a : A) : actionNorm ρ (actionDiff ρ σ a) = 0 := by
  rw [actionDiff_apply, map_sub, actionNorm_rep_apply, sub_self]

variable {ρ} {σ : G}

omit [Fintype G] in
/-- An element fixed by a generator is fixed by the group. -/
theorem rep_apply_eq_of_actionDiff_eq_zero (hσ : ∀ τ : G, τ ∈ Subgroup.zpowers σ) {a : A}
    (ha : actionDiff ρ σ a = 0) (τ : G) : ρ τ a = a := by
  let S : Subgroup G :=
    { carrier := {τ | ρ τ a = a}
      mul_mem' := fun {τ τ'} h h' => by
        show ρ (τ * τ') a = a
        rw [rep_mul_apply, show ρ τ' a = a from h', show ρ τ a = a from h]
      one_mem' := rep_one_apply ρ a
      inv_mem' := fun {τ} h => by
        show ρ τ⁻¹ a = a
        conv_lhs => rw [← show ρ τ a = a from h]
        rw [← rep_mul_apply, inv_mul_cancel, rep_one_apply] }
  have hS : Subgroup.zpowers σ ≤ S :=
    (Subgroup.zpowers_le (H := S)).mpr (sub_eq_zero.mp ha)
  exact hS (hσ τ)

/-- The norm of an invariant element `a` is `|G| a`. -/
theorem actionNorm_eq_card_nsmul (hσ : ∀ τ : G, τ ∈ Subgroup.zpowers σ) {a : A}
    (ha : actionDiff ρ σ a = 0) : actionNorm ρ a = Fintype.card G • a := by
  rw [actionNorm_apply,
    Finset.sum_congr rfl fun τ _ => rep_apply_eq_of_actionDiff_eq_zero hσ ha τ,
    Finset.sum_const, Finset.card_univ]

omit [Fintype G] in
/-- For every `τ` in the group generated by `σ`, `a − τa` lies in the image of `σ − 1`. -/
theorem sub_rep_mem_range_actionDiff (hσ : ∀ τ : G, τ ∈ Subgroup.zpowers σ) (τ : G) (a : A) :
    a - ρ τ a ∈ (actionDiff ρ σ).range := by
  let S : Subgroup G :=
    { carrier := {τ | ∀ a, a - ρ τ a ∈ (actionDiff ρ σ).range}
      mul_mem' := fun {τ τ'} h h' a => by
        have e : a - ρ (τ * τ') a = (a - ρ τ' a) + (ρ τ' a - ρ τ (ρ τ' a)) := by
          rw [rep_mul_apply]; abel
        rw [e]
        exact add_mem (h' a) (h (ρ τ' a))
      one_mem' := fun a => by
        rw [rep_one_apply, sub_self]
        exact zero_mem _
      inv_mem' := fun {τ} h a => by
        have e : a - ρ τ⁻¹ a = -(ρ τ⁻¹ a - ρ τ (ρ τ⁻¹ a)) := by
          rw [← rep_mul_apply, mul_inv_cancel, rep_one_apply]; abel
        rw [e]
        exact neg_mem (h _) }
  have hS : Subgroup.zpowers σ ≤ S :=
    (Subgroup.zpowers_le (H := S)).mpr fun a =>
      ⟨-a, by rw [actionDiff_apply, map_neg]; abel⟩
  exact hS (hσ τ) a

/-- `|G| a` lies in the image of `σ − 1` if `N a = 0`. -/
theorem card_nsmul_mem_range_actionDiff (hσ : ∀ τ : G, τ ∈ Subgroup.zpowers σ) {a : A}
    (ha : actionNorm ρ a = 0) : Fintype.card G • a ∈ (actionDiff ρ σ).range := by
  have e : Fintype.card G • a = ∑ τ : G, (a - ρ τ a) := by
    rw [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_univ, ← actionNorm_apply, ha,
      sub_zero]
  rw [e]
  exact sum_mem fun τ _ => sub_rep_mem_range_actionDiff hσ τ a

end Action

section Equivariant

variable {G : Type*} [Group G] [Fintype G] {A W : Type*} [AddCommGroup A] [AddCommGroup W]
  {ρ : G →* AddMonoid.End A} {ρ' : G →* AddMonoid.End W} (φ : A →+ W)

omit [Fintype G] in
/-- An equivariant homomorphism commutes with `σ − 1`. -/
theorem map_actionDiff (hφ : ∀ τ a, φ (ρ τ a) = ρ' τ (φ a)) (σ : G) (a : A) :
    φ (actionDiff ρ σ a) = actionDiff ρ' σ (φ a) := by
  rw [actionDiff_apply, actionDiff_apply, map_sub, hφ]

/-- An equivariant homomorphism commutes with the norm. -/
theorem map_actionNorm (hφ : ∀ τ a, φ (ρ τ a) = ρ' τ (φ a)) (a : A) :
    φ (actionNorm ρ a) = actionNorm ρ' (φ a) := by
  rw [actionNorm_apply, actionNorm_apply, map_sum]
  exact Finset.sum_congr rfl fun τ _ => hφ τ a

end Equivariant

section Finite

variable {A : Type*} [AddCommGroup A]

/-- In a finitely generated abelian group, a subgroup `N` with `n M ⊆ N` has finite index in
`M`: the quotient is finitely generated and killed by `n`. -/
theorem relIndex_ne_zero_of_nsmul_mem [Module.Finite ℤ A] {N M : AddSubgroup A} {n : ℕ}
    (hn : n ≠ 0) (h : ∀ a ∈ M, n • a ∈ N) : N.relIndex M ≠ 0 := by
  haveI : AddGroup.FG M := by
    rw [AddGroup.fg_iff_addSubgroup_fg, ← AddSubgroup.toIntSubmodule_toAddSubgroup M,
      ← Submodule.fg_iff_addSubgroup_fg]
    exact IsNoetherian.noetherian _
  haveI : Finite (M ⧸ N.addSubgroupOf M) := by
    refine AddCommGroup.finite_of_fg_torsion _ fun x => ?_
    obtain ⟨m, rfl⟩ := QuotientAddGroup.mk_surjective x
    refine isOfFinAddOrder_iff_nsmul_eq_zero.mpr ⟨n, Nat.pos_of_ne_zero hn, ?_⟩
    rw [← QuotientAddGroup.mk_nsmul, QuotientAddGroup.eq_zero_iff]
    exact h m m.2
  exact AddSubgroup.index_ne_zero_of_finite

variable {G : Type*} [Group G] [Fintype G] {ρ : G →* AddMonoid.End A} {σ : G}

/-- `Ĥ⁰` of a finitely generated module is finite. -/
theorem herbrandIndex_actionDiff_ne_zero [Module.Finite ℤ A]
    (hσ : ∀ τ : G, τ ∈ Subgroup.zpowers σ) :
    herbrandIndex (actionDiff ρ σ) (actionNorm ρ) ≠ 0 :=
  relIndex_ne_zero_of_nsmul_mem Fintype.card_ne_zero fun a ha =>
    ⟨a, actionNorm_eq_card_nsmul hσ (AddMonoidHom.mem_ker.mp ha)⟩

/-- `Ĥ¹` of a finitely generated module is finite. -/
theorem herbrandIndex_actionNorm_ne_zero [Module.Finite ℤ A]
    (hσ : ∀ τ : G, τ ∈ Subgroup.zpowers σ) :
    herbrandIndex (actionNorm ρ) (actionDiff ρ σ) ≠ 0 :=
  relIndex_ne_zero_of_nsmul_mem Fintype.card_ne_zero fun _ ha =>
    card_nsmul_mem_range_actionDiff hσ (AddMonoidHom.mem_ker.mp ha)

/-- **The trivial module `ℤ`**: `[ℤ : |G| ℤ] = |G|` and the norm is injective. -/
theorem herbrandIndex_int_trivial (ρ : G →* AddMonoid.End ℤ) (hρ : ∀ τ a, ρ τ a = a) (σ : G) :
    herbrandIndex (actionDiff ρ σ) (actionNorm ρ) = Fintype.card G ∧
      herbrandIndex (actionNorm ρ) (actionDiff ρ σ) = 1 := by
  have hf : actionDiff ρ σ = 0 := by
    ext
    rw [actionDiff_apply, hρ, sub_self, AddMonoidHom.zero_apply]
  have hg : ∀ a : ℤ, actionNorm ρ a = (Fintype.card G : ℤ) * a := fun a => by
    rw [actionNorm_apply, Finset.sum_congr rfl fun τ _ => hρ τ a, Finset.sum_const,
      Finset.card_univ, nsmul_eq_mul]
  have hc : (Fintype.card G : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr Fintype.card_ne_zero
  constructor
  · have hr : (actionNorm ρ).range = AddSubgroup.zmultiples (Fintype.card G : ℤ) := by
      ext a
      rw [AddMonoidHom.mem_range, Int.mem_zmultiples_iff]
      constructor
      · rintro ⟨b, rfl⟩
        exact ⟨b, by rw [hg, mul_comm]⟩
      · rintro ⟨b, rfl⟩
        exact ⟨b, by rw [hg, mul_comm]⟩
    rw [herbrandIndex, hf, AddMonoidHom.ker_zero, AddSubgroup.relIndex_top_right, hr,
      Int.index_zmultiples, Int.natAbs_natCast]
  · have hk : (actionNorm ρ).ker = ⊥ := by
      rw [eq_bot_iff]
      intro a ha
      rw [AddMonoidHom.mem_ker, hg] at ha
      exact (mul_eq_zero.mp ha).resolve_left hc
    rw [herbrandIndex, hk, AddSubgroup.relIndex_bot_right]

end Finite

section Permutation

variable (G : Type*) [Group G] [Fintype G] (X : Type*) [Fintype X] [MulAction G X]

/-- The permutation representation of `G` on `ℤ^X`: `(τ y)(x) = y(τ⁻¹ x)`. -/
def permRep : G →* AddMonoid.End (X → ℤ) where
  toFun τ :=
    { toFun := fun y x => y (τ⁻¹ • x)
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  map_one' := AddMonoidHom.ext fun y => funext fun x => by
    show y ((1 : G)⁻¹ • x) = y x
    rw [inv_one, one_smul]
  map_mul' τ τ' := AddMonoidHom.ext fun y => funext fun x => by
    show y ((τ * τ')⁻¹ • x) = y (τ'⁻¹ • τ⁻¹ • x)
    rw [mul_inv_rev, mul_smul]

variable {G X}

omit [Fintype G] [Fintype X] in
theorem permRep_apply (τ : G) (y : X → ℤ) (x : X) : permRep G X τ y x = y (τ⁻¹ • x) := rfl

omit [Fintype X] in
/-- The elements carrying a point `r` to a point `x` of its orbit form a coset of the
stabilizer of `r`. -/
theorem card_filter_inv_smul_eq (x r : X) (hx : x ∈ MulAction.orbit G r) :
    (Finset.univ.filter fun τ : G => τ⁻¹ • x = r).card = Nat.card (MulAction.stabilizer G r) := by
  obtain ⟨τ₀, rfl⟩ := hx
  rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
  refine Finset.card_equiv (Equiv.mulLeft τ₀⁻¹) fun τ => ?_
  simp only [Finset.mem_filter, Finset.mem_univ, true_and, Equiv.coe_mulLeft,
    MulAction.mem_stabilizer_iff]
  rw [inv_smul_eq_iff, mul_smul, inv_smul_eq_iff]
  exact eq_comm

/-- **Permutation modules**: `[(ℤ^X)^G : N ℤ^X] ≤ Π_ω |G_ω|`, the product over the orbits `ω`
of the orders of the stabilizers. -/
theorem herbrandIndex_permRep_le {σ : G} (hσ : ∀ τ : G, τ ∈ Subgroup.zpowers σ) :
    herbrandIndex (actionDiff (permRep G X) σ) (actionNorm (permRep G X)) ≤
      ∏ ω : MulAction.orbitRel.Quotient G X, Nat.card (MulAction.stabilizer G ω.out) := by
  set f := actionDiff (permRep G X) σ
  set g := actionNorm (permRep G X)
  set m : MulAction.orbitRel.Quotient G X → ℕ := fun ω => Nat.card (MulAction.stabilizer G ω.out)
  haveI : ∀ ω, NeZero (m ω) := fun ω => ⟨Nat.card_pos.ne'⟩
  -- the values at the chosen points of the orbits, modulo the orders of the stabilizers
  let Θ : (X → ℤ) →+ (∀ ω : MulAction.orbitRel.Quotient G X, ZMod (m ω)) :=
    { toFun := fun y ω => ((y ω.out : ℤ) : ZMod (m ω))
      map_zero' := funext fun ω => by simp
      map_add' := fun y z => funext fun ω => by simp }
  have hout : ∀ x : X, x ∈ MulAction.orbit G (Quotient.mk'' x :
      MulAction.orbitRel.Quotient G X).out := fun x => by
    letI := MulAction.orbitRel G X
    exact MulAction.orbitRel_apply.mp (Setoid.symm (Quotient.mk_out x))
  -- an invariant function divisible by `|G_ω|` on each orbit is a norm
  have hle : Θ.ker ⊓ f.ker ≤ g.range := by
    intro y hy
    obtain ⟨hy0, hyf⟩ := AddSubgroup.mem_inf.mp hy
    have hinv : ∀ (τ : G) (x : X), y (τ⁻¹ • x) = y x := fun τ x =>
      congrFun (rep_apply_eq_of_actionDiff_eq_zero hσ (AddMonoidHom.mem_ker.mp hyf) τ) x
    have hdvd : ∀ ω : MulAction.orbitRel.Quotient G X, (m ω : ℤ) ∣ y ω.out := fun ω =>
      (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp (congrFun (AddMonoidHom.mem_ker.mp hy0) ω)
    choose d hd using hdvd
    refine ⟨fun x => if x = (Quotient.mk'' x : MulAction.orbitRel.Quotient G X).out
      then d (Quotient.mk'' x) else 0, funext fun x => ?_⟩
    have hyx : y x = y (Quotient.mk'' x : MulAction.orbitRel.Quotient G X).out := by
      obtain ⟨τ, hτ⟩ := hout x
      rw [← hinv τ x, inv_smul_eq_iff.mpr hτ.symm]
    set ω : MulAction.orbitRel.Quotient G X := Quotient.mk'' x
    have hω : ∀ τ : G, (Quotient.mk'' (τ⁻¹ • x) : MulAction.orbitRel.Quotient G X) = ω :=
      fun τ => Quotient.sound' (MulAction.orbitRel_apply.mpr ⟨τ⁻¹, rfl⟩)
    rw [actionNorm_apply, Finset.sum_apply]
    simp only [permRep_apply, hω]
    rw [← Finset.sum_filter, Finset.sum_const, card_filter_inv_smul_eq x ω.out (hout x),
      nsmul_eq_mul, hyx, hd ω]
  have hfin : Finite (∀ ω : MulAction.orbitRel.Quotient G X, ZMod (m ω)) := inferInstance
  have hcard : Θ.ker.relIndex f.ker ≤ ∏ ω, m ω := by
    rw [AddSubgroup.relIndex_ker]
    calc Nat.card (f.ker.map Θ)
        ≤ Nat.card (∀ ω : MulAction.orbitRel.Quotient G X, ZMod (m ω)) :=
          Nat.card_le_card_of_injective _ Subtype.val_injective
      _ = ∏ ω, m ω := by
          rw [Nat.card_pi]
          exact Finset.prod_congr rfl fun ω _ => Nat.card_zmod (m ω)
  have hne : (Θ.ker ⊓ f.ker).relIndex f.ker ≠ 0 := by
    rw [AddSubgroup.inf_relIndex_right, AddSubgroup.relIndex_ker]
    exact Nat.card_pos.ne'
  calc herbrandIndex f g = g.range.relIndex f.ker := rfl
    _ ≤ (Θ.ker ⊓ f.ker).relIndex f.ker := AddSubgroup.relIndex_le_of_le_left hle hne
    _ = Θ.ker.relIndex f.ker := AddSubgroup.inf_relIndex_right _ _
    _ ≤ ∏ ω, m ω := hcard

end Permutation

end GaloisForLFunctions
