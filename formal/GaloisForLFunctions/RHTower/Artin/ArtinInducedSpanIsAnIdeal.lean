import GaloisForLFunctions.RHTower.Artin.ArtinClassFunctionInduction

/-!
# The characters induced from a family of subgroups span an ideal

The virtual characters of a finite group form a ring: the product of two characters is the
character of the tensor product (`mul_mem_fdCharacterSet`, `mul_mem_virtualCharacterGroup`), and
the constant `1` is the trivial character (`one_mem_fdCharacterSet`).

For a family `𝔉` of subgroups, `inducedSpan 𝔉` is the subgroup of functions generated by the
functions induced from the characters of the members of `𝔉`. It consists of virtual characters
(`inducedSpan_le`), and it is an ideal (`mul_mem_inducedSpan`): by the projection formula
`Ind(χ) · ψ = Ind(χ · ψ|_H)`, and `χ · ψ|_H` is a character of `H`. So the induced characters
span all virtual characters as soon as they span the constant `1`
(`inducedSpan_eq_of_one_mem`).
-/

open scoped Classical

noncomputable section

universe u

namespace GaloisForLFunctions

variable {G : Type u} [Group G]

/-! ### The ring of virtual characters -/

/-- The product of two characters is a character. -/
theorem mul_mem_fdCharacterSet {f₁ f₂ : G → ℂ} (h₁ : f₁ ∈ fdCharacterSet G)
    (h₂ : f₂ ∈ fdCharacterSet G) : f₁ * f₂ ∈ fdCharacterSet G := by
  obtain ⟨V, rfl⟩ := h₁
  obtain ⟨W, rfl⟩ := h₂
  exact ⟨CategoryTheory.MonoidalCategory.tensorObj V W, FDRep.char_tensor V W⟩

/-- The constant `1` is the trivial character. -/
theorem one_mem_fdCharacterSet : (1 : G → ℂ) ∈ fdCharacterSet G := by
  have h := representation_character_mem_fdCharacterSet G
    (linearCharacterRepresentation (1 : LinearCharacter G))
  have e : (linearCharacterRepresentation (1 : LinearCharacter G)).character = 1 := by
    funext g
    rw [linearCharacterRepresentation_character]
    simp
  rwa [e] at h

/-- The product of two virtual characters is a virtual character. -/
theorem mul_mem_virtualCharacterGroup {f ψ : G → ℂ} (hf : f ∈ virtualCharacterGroup G)
    (hψ : ψ ∈ virtualCharacterGroup G) : f * ψ ∈ virtualCharacterGroup G := by
  refine AddSubgroup.closure_induction (p := fun ψ _ => f * ψ ∈ virtualCharacterGroup G)
    ?_ ?_ ?_ ?_ hψ
  · intro ψ hψ
    refine AddSubgroup.closure_induction (p := fun f _ => f * ψ ∈ virtualCharacterGroup G)
      ?_ ?_ ?_ ?_ hf
    · intro f hf
      exact AddSubgroup.subset_closure (mul_mem_fdCharacterSet hf hψ)
    · rw [zero_mul]
      exact zero_mem _
    · intro a b _ _ ha hb
      rw [add_mul]
      exact add_mem ha hb
    · intro a _ ha
      rw [neg_mul]
      exact neg_mem ha
  · rw [mul_zero]
    exact zero_mem _
  · intro a b _ _ ha hb
    rw [mul_add]
    exact add_mem ha hb
  · intro a _ ha
    rw [mul_neg]
    exact neg_mem ha

/-- The restriction of a character to a subgroup is a character. -/
theorem restrict_mem_fdCharacterSet (H : Subgroup G) {ψ : G → ℂ} (hψ : ψ ∈ fdCharacterSet G) :
    (fun h : H => ψ h) ∈ fdCharacterSet H := by
  obtain ⟨V, rfl⟩ := hψ
  exact ⟨restrictFDRep G H.subtype V, funext fun h => rfl⟩

/-! ### The span of the induced characters -/

variable [Fintype G]

/-- The function induced from a character of a subgroup is a character. -/
theorem inducedFunction_mem_fdCharacterSet (H : Subgroup G) {χ : H → ℂ}
    (hχ : χ ∈ fdCharacterSet H) : inducedFunction H χ ∈ fdCharacterSet G := by
  obtain ⟨V, rfl⟩ := hχ
  have h : (Representation.ind H.subtype V.ρ).character ∈ fdCharacterSet G :=
    inducedRepresentation_character_mem_fdCharacterSet G H V.ρ
  rw [induced_character_eq_inducedFunction] at h
  exact h

/-- The subgroup of functions generated by the characters induced from the characters of the
subgroups of a family. -/
def inducedSpan (𝔉 : Set (Subgroup G)) : AddSubgroup (G → ℂ) :=
  AddSubgroup.closure {f | ∃ H ∈ 𝔉, ∃ χ ∈ fdCharacterSet H, f = inducedFunction H χ}

/-- The span of the induced characters consists of virtual characters. -/
theorem inducedSpan_le (𝔉 : Set (Subgroup G)) : inducedSpan 𝔉 ≤ virtualCharacterGroup G := by
  rw [inducedSpan, AddSubgroup.closure_le]
  rintro f ⟨H, -, χ, hχ, rfl⟩
  exact AddSubgroup.subset_closure (inducedFunction_mem_fdCharacterSet H hχ)

/-- **The span of the induced characters is an ideal of the ring of virtual characters.** -/
theorem mul_mem_inducedSpan {𝔉 : Set (Subgroup G)} {f ψ : G → ℂ} (hf : f ∈ inducedSpan 𝔉)
    (hψ : ψ ∈ virtualCharacterGroup G) : f * ψ ∈ inducedSpan 𝔉 := by
  refine AddSubgroup.closure_induction (p := fun ψ _ => f * ψ ∈ inducedSpan 𝔉) ?_ ?_ ?_ ?_ hψ
  · intro ψ hψ
    refine AddSubgroup.closure_induction (p := fun f _ => f * ψ ∈ inducedSpan 𝔉) ?_ ?_ ?_ ?_ hf
    · rintro f ⟨H, hH, χ, hχ, rfl⟩
      -- the projection formula
      have hclass : ∀ x g : G, ψ (x * g * x⁻¹) = ψ g := by
        obtain ⟨W, rfl⟩ := hψ
        exact fun x g => FDRep.char_conj W g x
      have hproj := inducedFunction_mul_restrict H χ ψ hclass
      have hmem : (fun h : H => χ h * ψ h) ∈ fdCharacterSet H :=
        mul_mem_fdCharacterSet hχ (restrict_mem_fdCharacterSet H hψ)
      refine AddSubgroup.subset_closure ⟨H, hH, _, hmem, ?_⟩
      rw [hproj]
      rfl
    · rw [zero_mul]
      exact zero_mem _
    · intro a b _ _ ha hb
      rw [add_mul]
      exact add_mem ha hb
    · intro a _ ha
      rw [neg_mul]
      exact neg_mem ha
  · rw [mul_zero]
    exact zero_mem _
  · intro a b _ _ ha hb
    rw [mul_add]
    exact add_mem ha hb
  · intro a _ ha
    rw [mul_neg]
    exact neg_mem ha

/-- **If the induced characters span the constant `1`, they span all virtual characters.** -/
theorem inducedSpan_eq_of_one_mem {𝔉 : Set (Subgroup G)} (h1 : (1 : G → ℂ) ∈ inducedSpan 𝔉) :
    inducedSpan 𝔉 = virtualCharacterGroup G := by
  refine le_antisymm (inducedSpan_le 𝔉) fun ψ hψ => ?_
  have h := mul_mem_inducedSpan h1 hψ
  rwa [one_mul] at h

end GaloisForLFunctions
