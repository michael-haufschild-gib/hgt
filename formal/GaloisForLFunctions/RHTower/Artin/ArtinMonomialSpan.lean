import GaloisForLFunctions.RHTower.Artin.ArtinClassFunctionOfARegularElement

/-!
# The integer span of the monomial characters

`monomialSpan G` is the additive group generated by the functions `Ind_K^G λ`, `K` a subgroup of
the finite group `G` and `λ` a linear character of `K`.

* **Induction in stages** (`inducedFunction_inducedFunction`): for `L ≤ H ≤ G`,
  `Ind_H^G Ind_L^H f = Ind_L^G f`. Hence induction maps `monomialSpan H` into `monomialSpan G`
  (`inducedFunction_mem_monomialSpan`).
* **Inflation** (`inducedFunction_comap`): for a surjective homomorphism `π : G → Q`,
  `(Ind_K^Q f) ∘ π = Ind_{π⁻¹K}^G (f ∘ π)`. Hence composition with `π` maps `monomialSpan Q` into
  `monomialSpan G` (`comp_mem_monomialSpan`).
* A linear character of `G` is monomial (`linearCharacter_mem_monomialSpan`), and every
  character of a finite abelian group is in the monomial span
  (`fdCharacterSet_subset_monomialSpan_of_comm`).
-/

open scoped Classical BigOperators

noncomputable section

universe u

namespace GaloisForLFunctions

variable {G : Type u} [Group G] [Fintype G]

/-- The integer span of the monomial characters: the functions induced from linear characters
of subgroups. -/
def monomialSpan (G : Type u) [Group G] [Fintype G] : AddSubgroup (G → ℂ) :=
  AddSubgroup.closure {f | ∃ (K : Subgroup G) (χ : LinearCharacter K),
    f = inducedFunction K fun k => ((χ k : ℂˣ) : ℂ)}

/-! ### Linear characters and abelian groups -/

/-- Induction from the whole group is the identity on class functions. -/
theorem inducedFunction_top (f : G → ℂ) (hf : ∀ x g : G, f (x * g * x⁻¹) = f g) :
    inducedFunction (⊤ : Subgroup G) (fun k => f k) = f := by
  funext g
  have hne : (Fintype.card G : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr Fintype.card_ne_zero
  have hterm : ∀ x : G,
      extendByZero ⊤ (fun k : (⊤ : Subgroup G) => f k) (x * g * x⁻¹) = f g := fun x => by
    rw [extendByZero_of_mem _ _ (Subgroup.mem_top _)]
    exact hf x g
  rw [inducedFunction, Finset.sum_congr rfl fun x _ => hterm x, Finset.sum_const,
    Finset.card_univ, nsmul_eq_mul, Subgroup.card_top, Nat.card_eq_fintype_card,
    inv_mul_cancel_left₀ hne]

/-- A linear character is a monomial character. -/
theorem linearCharacter_mem_monomialSpan (χ : LinearCharacter G) :
    (fun g => ((χ g : ℂˣ) : ℂ)) ∈ monomialSpan G := by
  have h := inducedFunction_top (fun g => ((χ g : ℂˣ) : ℂ)) fun x g => by
    show ((χ (x * g * x⁻¹) : ℂˣ) : ℂ) = ((χ g : ℂˣ) : ℂ)
    rw [map_mul, map_mul, map_inv, mul_comm, inv_mul_cancel_left]
  rw [← h]
  exact AddSubgroup.subset_closure ⟨⊤, χ.comp (⊤ : Subgroup G).subtype, rfl⟩

/-- **Every character of a finite abelian group is an integer combination of linear
characters.** -/
theorem fdCharacterSet_subset_monomialSpan_of_comm (hcomm : ∀ a b : G, a * b = b * a) :
    fdCharacterSet G ⊆ monomialSpan G := by
  letI : CommGroup G := { ‹Group G› with mul_comm := hcomm }
  intro χ hχ
  have h : χ ∈ finiteAbelianLinearVirtualCharacterGroup G := by
    rw [← finiteAbelian_virtualCharacterGroup_eq_linear]
    exact AddSubgroup.subset_closure hχ
  refine AddSubgroup.closure_induction (p := fun θ _ => θ ∈ monomialSpan G) ?_ (zero_mem _)
    (fun _ _ _ _ hu hv => add_mem hu hv) (fun _ _ hu => neg_mem hu) h
  rintro θ ⟨χ', rfl⟩
  have e : (linearVirtualCharacter G χ').val = fun g => ((χ' g : ℂˣ) : ℂ) :=
    funext fun g => linearVirtualCharacter_apply G χ' g
  show (linearVirtualCharacter G χ').val ∈ monomialSpan G
  rw [e]
  exact linearCharacter_mem_monomialSpan χ'

/-! ### Induction in stages -/

omit [Fintype G] in
/-- Extension by zero through two stages. -/
theorem extendByZero_map (H : Subgroup G) (L : Subgroup H) (f : L → ℂ) (y : G) :
    extendByZero (L.map H.subtype)
        (fun k => f ((L.equivMapOfInjective H.subtype H.subtype_injective).symm k)) y =
      extendByZero H (extendByZero L f) y := by
  by_cases hy : y ∈ H
  · rw [extendByZero_of_mem H _ hy]
    by_cases hl : (⟨y, hy⟩ : H) ∈ L
    · have hmap : y ∈ L.map H.subtype := ⟨⟨y, hy⟩, hl, rfl⟩
      rw [extendByZero_of_mem _ _ hmap, extendByZero_of_mem L _ hl]
      congr 1
      rw [MulEquiv.symm_apply_eq]
      exact Subtype.ext rfl
    · have hmap : y ∉ L.map H.subtype := by
        rintro ⟨h, hh, rfl⟩
        exact hl hh
      rw [extendByZero_of_notMem _ _ hmap, extendByZero_of_notMem L _ hl]
  · have hmap : y ∉ L.map H.subtype := by
      rintro ⟨h, -, rfl⟩
      exact hy h.2
    rw [extendByZero_of_notMem _ _ hmap, extendByZero_of_notMem H _ hy]

/-- **Induction in stages**: `Ind_H^G Ind_L^H f = Ind_L^G f`. -/
theorem inducedFunction_inducedFunction (H : Subgroup G) (L : Subgroup H) (f : L → ℂ) :
    inducedFunction H (inducedFunction L f) =
      inducedFunction (L.map H.subtype)
        (fun k => f ((L.equivMapOfInjective H.subtype H.subtype_injective).symm k)) := by
  funext g
  have hH : (Fintype.card H : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr Fintype.card_ne_zero
  -- the first stage, extended by zero, is an average over `H`
  have hstage : ∀ y : G, extendByZero H (inducedFunction L f) y =
      (Nat.card L : ℂ)⁻¹ *
        ∑ h : H, extendByZero H (extendByZero L f) ((h : G) * y * (h : G)⁻¹) := by
    intro y
    by_cases hy : y ∈ H
    · rw [extendByZero_of_mem _ _ hy, inducedFunction]
      congr 1
      refine Finset.sum_congr rfl fun h _ => ?_
      have hmem : (h : G) * y * (h : G)⁻¹ ∈ H := H.mul_mem (H.mul_mem h.2 hy) (H.inv_mem h.2)
      rw [extendByZero_of_mem H _ hmem]
      exact congrArg (extendByZero L f) (Subtype.ext rfl)
    · rw [extendByZero_of_notMem _ _ hy, Finset.sum_eq_zero, mul_zero]
      intro h _
      refine extendByZero_of_notMem _ _ fun hmem => hy ?_
      have h2 := H.mul_mem (H.mul_mem (H.inv_mem h.2) hmem) h.2
      simpa [mul_assoc] using h2
  -- conjugation by `h` permutes the outer sum
  have hinner : ∀ h : H,
      ∑ x : G, extendByZero H (extendByZero L f) ((h : G) * (x * g * x⁻¹) * (h : G)⁻¹) =
        ∑ x : G, extendByZero H (extendByZero L f) (x * g * x⁻¹) := by
    intro h
    rw [← Equiv.sum_comp (Equiv.mulLeft (h : G))
      fun x => extendByZero H (extendByZero L f) (x * g * x⁻¹)]
    refine Finset.sum_congr rfl fun x _ => ?_
    congr 1
    simp [mul_assoc]
  rw [inducedFunction, Finset.sum_congr rfl fun x _ => hstage (x * g * x⁻¹), ← Finset.mul_sum,
    Finset.sum_comm, Finset.sum_congr rfl fun h _ => hinner h, Finset.sum_const,
    Finset.card_univ, nsmul_eq_mul, inducedFunction,
    Subgroup.card_map_of_injective H.subtype_injective,
    Finset.sum_congr rfl fun x _ => extendByZero_map H L f (x * g * x⁻¹),
    Nat.card_eq_fintype_card (α := H)]
  field_simp

/-- **Induction maps the monomial span of a subgroup into the monomial span of the group.** -/
theorem inducedFunction_mem_monomialSpan (H : Subgroup G) {m : H → ℂ}
    (hm : m ∈ monomialSpan H) : inducedFunction H m ∈ monomialSpan G := by
  have hle : monomialSpan H ≤ (monomialSpan G).comap (inducedFunctionHom H) := by
    rw [monomialSpan, AddSubgroup.closure_le]
    rintro f ⟨L, χ, rfl⟩
    show inducedFunction H (inducedFunction L _) ∈ monomialSpan G
    rw [inducedFunction_inducedFunction]
    exact AddSubgroup.subset_closure ⟨L.map H.subtype,
      χ.comp (L.equivMapOfInjective H.subtype H.subtype_injective).symm.toMonoidHom, rfl⟩
  exact hle hm

/-! ### Inflation -/

section Inflation

variable {Q : Type u} [Group Q] [Fintype Q] (π : G →* Q) (hπ : Function.Surjective π)

include hπ in
/-- A sum over the group of a function of the image is `|ker π|` times the sum over the
image. -/
theorem sum_comp_surjective_hom (F : Q → ℂ) :
    ∑ x : G, F (π x) = (Nat.card π.ker : ℂ) * ∑ q : Q, F q := by
  have hfib : ∀ q : Q, (Finset.univ.filter fun x : G => π x = q).card = Nat.card π.ker := by
    intro q
    rw [MonoidHom.card_fiber_eq_of_mem_range π (hπ q) (hπ 1), Nat.card_eq_fintype_card]
    exact (Fintype.card_of_subtype (p := fun x => x ∈ π.ker) _ fun x => by
      rw [Finset.mem_filter, MonoidHom.mem_ker]
      exact and_iff_right (Finset.mem_univ x)).symm
  rw [← Finset.sum_fiberwise' Finset.univ π F, Finset.mul_sum]
  refine Finset.sum_congr rfl fun q _ => ?_
  rw [Finset.sum_const, hfib q, nsmul_eq_mul]

include hπ in
/-- `|π⁻¹K| = |ker π| · |K|`. -/
theorem card_comap_of_surjective (K : Subgroup Q) :
    (Nat.card (K.comap π) : ℂ) = (Nat.card π.ker : ℂ) * Nat.card K := by
  have h := sum_comp_surjective_hom π hπ fun q => if q ∈ K then (1 : ℂ) else 0
  rw [Finset.sum_boole, Finset.sum_boole] at h
  have h1 : (Finset.univ.filter fun x : G => π x ∈ K).card = Nat.card (K.comap π) := by
    rw [Nat.card_eq_fintype_card]
    exact (Fintype.card_of_subtype (p := fun x => x ∈ K.comap π) _ fun x => by
      rw [Finset.mem_filter, Subgroup.mem_comap]
      exact and_iff_right (Finset.mem_univ x)).symm
  have h2 : (Finset.univ.filter fun q : Q => q ∈ K).card = Nat.card K := by
    rw [Nat.card_eq_fintype_card]
    exact (Fintype.card_of_subtype (p := fun q => q ∈ K) _ fun q => by
      rw [Finset.mem_filter]
      exact and_iff_right (Finset.mem_univ q)).symm
  rw [h1, h2] at h
  exact h

include hπ in
/-- **Inflation of an induced function**: `(Ind_K^Q f) ∘ π = Ind_{π⁻¹K}^G (f ∘ π)`. -/
theorem inducedFunction_comap (K : Subgroup Q) (f : K → ℂ) (g : G) :
    inducedFunction (K.comap π) (fun k => f ⟨π k, Subgroup.mem_comap.mp k.2⟩) g =
      inducedFunction K f (π g) := by
  have hext : ∀ y : G, extendByZero (K.comap π)
      (fun k => f ⟨π k, Subgroup.mem_comap.mp k.2⟩) y = extendByZero K f (π y) := by
    intro y
    by_cases hy : π y ∈ K
    · rw [extendByZero_of_mem _ _ (Subgroup.mem_comap.mpr hy), extendByZero_of_mem K _ hy]
    · rw [extendByZero_of_notMem _ _ (fun h => hy (Subgroup.mem_comap.mp h)),
        extendByZero_of_notMem K _ hy]
  have hker : (Nat.card π.ker : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr Nat.card_pos.ne'
  have hK : (Nat.card K : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr Nat.card_pos.ne'
  have hsum := sum_comp_surjective_hom π hπ fun q => extendByZero K f (q * π g * q⁻¹)
  rw [inducedFunction, inducedFunction, card_comap_of_surjective π hπ K,
    Finset.sum_congr rfl fun x _ => hext (x * g * x⁻¹)]
  simp only [map_mul, map_inv]
  rw [hsum]
  field_simp

include hπ in
/-- **Composition with a surjective homomorphism maps the monomial span into the monomial
span.** -/
theorem comp_mem_monomialSpan {m : Q → ℂ} (hm : m ∈ monomialSpan Q) :
    (fun g => m (π g)) ∈ monomialSpan G := by
  refine AddSubgroup.closure_induction (p := fun m _ => (fun g => m (π g)) ∈ monomialSpan G) ?_
    (zero_mem _) (fun _ _ _ _ hu hv => add_mem hu hv) (fun _ _ hu => neg_mem hu) hm
  rintro m ⟨K, χ, rfl⟩
  have e : (fun g => inducedFunction K (fun k => ((χ k : ℂˣ) : ℂ)) (π g)) =
      inducedFunction (K.comap π)
        (fun k => ((χ ⟨π k, Subgroup.mem_comap.mp k.2⟩ : ℂˣ) : ℂ)) :=
    funext fun g => (inducedFunction_comap π hπ K _ g).symm
  rw [e]
  exact AddSubgroup.subset_closure ⟨K.comap π,
    χ.comp ((π.comp (K.comap π).subtype).codRestrict K fun k => Subgroup.mem_comap.mp k.2), rfl⟩

end Inflation

end GaloisForLFunctions
