import GaloisForLFunctions.RHTower.Artin.ArtinMonomialMultiplicityHasse
import Mathlib.LinearAlgebra.Matrix.ToLin
import Mathlib.LinearAlgebra.Matrix.DotProduct
import Mathlib.LinearAlgebra.Matrix.Symmetric
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
import Mathlib.RingTheory.RootsOfUnity.Basic

/-!
# Artin's induction theorem: the monomial characters span the virtual characters rationally

For a finite group `G`, every virtual character has a positive multiple that is an integer
combination of characters induced from linear characters of subgroups
(`exists_nsmul_mem_closure_monomial`).

The proof is linear algebra on the separation theorem: a virtual character that pairs to zero
with every monomial character is zero.

* **A symmetric rational matrix maps onto the orthogonal complement of its kernel**
  (`exists_mulVec_eq_of_orthogonal_ker`): range and kernel meet in zero, because
  `Γ(Γc) = 0` gives `(Γc)·(Γc) = c·Γ(Γc) = 0`, and their dimensions add up.
* **A lattice with a separating finite family** (`exists_nsmul_mem_closure_range`): let `b` be a
  symmetric integer pairing on an abelian group `R` and `μ` a finite family such that only `0`
  pairs to zero with every `μ_q`. For `θ ∈ R` the vector `(b(θ, μ_q))_q` is orthogonal to the
  kernel of the Gram matrix of `μ`, so it is `Γc` with `c` rational; with `N` a common
  denominator, `Σ (N c_q) μ_q − Nθ` pairs to zero with every `μ_q`, hence `Nθ = Σ (N c_q) μ_q`.

This is the rational form of the theorem. The integral form for elementary subgroups is
Brauer's theorem and is not proved here.
-/

open scoped BigOperators
open Matrix

noncomputable section

universe u

namespace GaloisForLFunctions

/-! ### Linear algebra over the rationals -/

/-- **A symmetric rational matrix maps onto the vectors orthogonal to its kernel.** -/
theorem exists_mulVec_eq_of_orthogonal_ker {Q : Type*} [Fintype Q] [DecidableEq Q]
    (Γ : Matrix Q Q ℚ) (hΓ : Γ.IsSymm) (y : Q → ℚ)
    (hy : ∀ c : Q → ℚ, Γ *ᵥ c = 0 → c ⬝ᵥ y = 0) : ∃ c : Q → ℚ, Γ *ᵥ c = y := by
  -- symmetry moves the matrix across the dot product
  have hsymm : ∀ a c : Q → ℚ, (Γ *ᵥ a) ⬝ᵥ c = a ⬝ᵥ (Γ *ᵥ c) := fun a c => by
    rw [Matrix.dotProduct_mulVec, ← Matrix.vecMul_transpose, hΓ.eq]
  have hinf : LinearMap.range Γ.mulVecLin ⊓ LinearMap.ker Γ.mulVecLin = ⊥ := by
    rw [Submodule.eq_bot_iff]
    rintro x ⟨⟨c, rfl⟩, hk⟩
    have hk' : Γ *ᵥ (Γ *ᵥ c) = 0 := hk
    have h0 : (Γ *ᵥ c) ⬝ᵥ (Γ *ᵥ c) = 0 := by
      rw [hsymm, hk', dotProduct_zero]
    exact dotProduct_self_eq_zero.mp h0
  have hsup : LinearMap.range Γ.mulVecLin ⊔ LinearMap.ker Γ.mulVecLin = ⊤ := by
    apply Submodule.eq_top_of_finrank_eq
    have h1 := Submodule.finrank_sup_add_finrank_inf_eq (LinearMap.range Γ.mulVecLin)
      (LinearMap.ker Γ.mulVecLin)
    rw [hinf, finrank_bot, add_zero] at h1
    rw [h1, LinearMap.finrank_range_add_finrank_ker]
  have hy' : y ∈ LinearMap.range Γ.mulVecLin ⊔ LinearMap.ker Γ.mulVecLin := by
    rw [hsup]
    trivial
  obtain ⟨r, ⟨c, rfl⟩, k, hk, hrk⟩ := Submodule.mem_sup.mp hy'
  have hk' : Γ *ᵥ k = 0 := hk
  -- the part of `y` in the kernel vanishes
  have hkk : k ⬝ᵥ k = 0 := by
    have h1 := hy k hk'
    rw [← hrk, dotProduct_add] at h1
    have h2 : k ⬝ᵥ (Γ *ᵥ c) = 0 := by
      rw [← hsymm, hk', zero_dotProduct]
    have h3 : k ⬝ᵥ Γ.mulVecLin c = k ⬝ᵥ (Γ *ᵥ c) := rfl
    rw [h3, h2, zero_add] at h1
    exact h1
  have hk0 : k = 0 := dotProduct_self_eq_zero.mp hkk
  refine ⟨c, ?_⟩
  rw [← hrk, hk0, add_zero]
  rfl

/-- A common denominator of finitely many rationals. -/
theorem exists_int_multiple {Q : Type*} [Fintype Q] [DecidableEq Q] (c : Q → ℚ) :
    ∃ N : ℕ, 0 < N ∧ ∃ z : Q → ℤ, ∀ q, (z q : ℚ) = (N : ℚ) * c q := by
  refine ⟨∏ q, (c q).den, Finset.prod_pos fun q _ => (c q).den_pos,
    fun q => (c q).num * ∏ q' ∈ Finset.univ.erase q, ((c q').den : ℤ), fun q => ?_⟩
  rw [← Finset.mul_prod_erase Finset.univ (fun q => (c q).den) (Finset.mem_univ q)]
  push_cast
  have h := Rat.mul_den_eq_num (c q)
  rw [← h]
  ring

/-! ### A lattice with a separating finite family -/

/-- **A finite family that separates a lattice spans it rationally.** Let `b` be a symmetric
integer pairing, additive in the second variable, and `μ` a finite family such that only `0`
pairs to zero with every member. Then every element has a positive multiple in the subgroup
generated by `μ`. -/
theorem exists_nsmul_mem_closure_range {R : Type*} [AddCommGroup R] {Q : Type*} [Fintype Q]
    (b : R → R → ℤ) (hadd : ∀ x y z, b x (y + z) = b x y + b x z)
    (hcomm : ∀ x y, b x y = b y x) (μ : Q → R)
    (hinj : ∀ θ, (∀ q, b θ (μ q) = 0) → θ = 0) (θ : R) :
    ∃ n : ℕ, 0 < n ∧ n • θ ∈ AddSubgroup.closure (Set.range μ) := by
  classical
  let B : R → R →+ ℤ := fun x => AddMonoidHom.mk' (b x) (hadd x)
  have hB : ∀ x y, B x y = b x y := fun _ _ => rfl
  -- the pairing with an integer combination of the family
  have hcomb : ∀ (x : R) (z : Q → ℤ), b x (∑ q, z q • μ q) = ∑ q, z q * b x (μ q) :=
    fun x z => by
      rw [← hB, map_sum]
      exact Finset.sum_congr rfl fun q _ => by rw [map_zsmul, hB, smul_eq_mul]
  -- the Gram matrix of the family, over the rationals
  let Γ : Matrix Q Q ℚ := Matrix.of fun q q' => (b (μ q) (μ q') : ℚ)
  have hΓ : Γ.IsSymm := Matrix.IsSymm.ext fun q q' => by
    simp only [Γ, Matrix.of_apply]
    rw [hcomm]
  have hΓc : ∀ (z : Q → ℤ) (c : Q → ℚ) (N : ℕ), (∀ q, (z q : ℚ) = (N : ℚ) * c q) → ∀ q' : Q,
      ((∑ q, z q * b (μ q') (μ q) : ℤ) : ℚ) = (N : ℚ) * (Γ *ᵥ c) q' := fun z c N hz q' => by
    push_cast
    simp only [Matrix.mulVec, dotProduct, Γ, Matrix.of_apply, Finset.mul_sum]
    exact Finset.sum_congr rfl fun q _ => by
      rw [hz q]
      ring
  let y : Q → ℚ := fun q => (b θ (μ q) : ℚ)
  -- `y` is orthogonal to the kernel of the Gram matrix
  have hy : ∀ c : Q → ℚ, Γ *ᵥ c = 0 → c ⬝ᵥ y = 0 := by
    intro c hc
    obtain ⟨N, hN, z, hz⟩ := exists_int_multiple c
    have hη : ∑ q, z q • μ q = 0 := by
      apply hinj
      intro q'
      rw [hcomm, hcomb]
      have h := hΓc z c N hz q'
      rw [hc, Pi.zero_apply, mul_zero] at h
      exact_mod_cast h
    have h0 : ∑ q, z q * b θ (μ q) = 0 := by
      rw [← hcomb, hη]
      exact (B θ).map_zero
    have h1 : (N : ℚ) * (c ⬝ᵥ y) = 0 := by
      have h : ((∑ q, z q * b θ (μ q) : ℤ) : ℚ) = (N : ℚ) * (c ⬝ᵥ y) := by
        push_cast
        simp only [dotProduct, y, Finset.mul_sum]
        exact Finset.sum_congr rfl fun q _ => by
          rw [hz q]
          ring
      rw [← h, h0, Int.cast_zero]
    exact (mul_eq_zero.mp h1).resolve_left (by exact_mod_cast hN.ne')
  obtain ⟨c, hc⟩ := exists_mulVec_eq_of_orthogonal_ker Γ hΓ y hy
  obtain ⟨N, hN, z, hz⟩ := exists_int_multiple c
  refine ⟨N, hN, ?_⟩
  have hkey : ∑ q, z q • μ q - N • θ = 0 := by
    apply hinj
    intro q'
    rw [hcomm, ← hB, map_sub, map_nsmul, hB, hB, hcomb, nsmul_eq_mul]
    have h := hΓc z c N hz q'
    rw [hc] at h
    have h2 : ((∑ q, z q * b (μ q') (μ q) - (N : ℤ) * b (μ q') θ : ℤ) : ℚ) = 0 := by
      rw [Int.cast_sub, h]
      simp only [y]
      rw [hcomm θ (μ q')]
      push_cast
      ring
    exact_mod_cast h2
  rw [← sub_eq_zero.mp hkey]
  exact AddSubgroup.sum_mem _ fun q _ =>
    AddSubgroup.zsmul_mem _ (AddSubgroup.subset_closure (Set.mem_range_self q)) _

/-! ### Artin's induction theorem -/

/-- A finite group has finitely many linear characters. -/
theorem finite_linearCharacter (H : Type*) [Group H] [Finite H] : Finite (LinearCharacter H) := by
  haveI : NeZero (Nat.card H) := ⟨Nat.card_pos.ne'⟩
  refine Finite.of_injective (fun (χ : H →* ℂˣ) (h : H) =>
    (⟨χ h, by rw [mem_rootsOfUnity, ← map_pow, pow_card_eq_one', map_one]⟩ :
      rootsOfUnity (Nat.card H) ℂ)) ?_
  intro χ ψ hχψ
  ext x
  have h := congrFun hχψ x
  exact congrArg (fun z : rootsOfUnity (Nat.card H) ℂ => ((z : ℂˣ) : ℂ)) h

/-- **Artin's induction theorem.** For a finite group every virtual character has a positive
multiple in the subgroup generated by the characters induced from linear characters of
subgroups. -/
theorem exists_nsmul_mem_closure_monomial (G : Type u) [Group G] [Fintype G]
    (θ : VirtualCharacter G) :
    ∃ n : ℕ, 0 < n ∧ n • θ ∈ AddSubgroup.closure
      (Set.range fun q : Σ H : Subgroup G, LinearCharacter H =>
        monomialVirtualCharacter G q.1 q.2) := by
  classical
  haveI : Finite (Subgroup G) :=
    Finite.of_injective (fun H : Subgroup G => (H : Set G)) SetLike.coe_injective
  haveI : ∀ H : Subgroup G, Finite (LinearCharacter H) := fun H => finite_linearCharacter H
  haveI := Fintype.ofFinite (Σ H : Subgroup G, LinearCharacter H)
  have hsep : ∀ η : VirtualCharacter G,
      (∀ q : Σ H : Subgroup G, LinearCharacter H,
        virtualMultiplicity G η (monomialVirtualCharacter G q.1 q.2) = 0) → η = 0 :=
    fun η h => (virtualCharacter_eq_zero_monomialMultiplicity_hasse_iff G η).2
      fun H χ => h ⟨H, χ⟩
  exact exists_nsmul_mem_closure_range (R := VirtualCharacter G)
    (Q := Σ H : Subgroup G, LinearCharacter H) (virtualMultiplicity G)
    (virtualMultiplicity_add_right G) (virtualMultiplicity_comm G)
    (fun q => monomialVirtualCharacter G q.1 q.2) hsep θ

end GaloisForLFunctions
