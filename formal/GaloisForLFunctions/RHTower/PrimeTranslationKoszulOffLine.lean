import GaloisForLFunctions.HTGeometry.KoszulCartanContraction
import GaloisForLFunctions.RHTower.L2MellinUnitary

/-!
# Prime-translation Koszul complexes contract off the unitary axis

The critical normalization `δ_s(p) = p^{1/2 - s}` has modulus `p^{1/2 - Re s}`, which equals one
exactly on the critical line.  Off the line every coordinate `U_p - δ_s(p)` of the prime-translation
Koszul complex is therefore an invertible operator, with the uniform bound
`1 / |2^{1/2 - Re s} - 1|`, and a single invertible coordinate contracts the whole finite complex by
the Cartan identity.

## Main results

* `deltaS`, `norm_deltaS`, `norm_deltaS_eq_one_iff` — the critical normalization;
* `contractionBound_le` — the uniform off-line bound, attained at `p = 2`;
* `commute_of_mem_adjoin`, `adjoinCommRing` — a commuting set generates a commutative algebra;
* `primeKoszulContraction` — the chain homotopy contracting the finite prime Koszul complex;
* `primeTranslationKoszul_offLine` — the concrete prime logarithmic translations on `L²(ℝ)`.
-/

noncomputable section

namespace RHTower

open GaloisForLFunctions.HTGeometry MeasureTheory RHTower.MellinL2

/-! ### The critical normalization -/

/-- The critical prime multiplier `δ_s(p) = p^{1/2 - s}`. -/
def deltaS (p : ℕ) (s : ℂ) : ℂ := (p : ℂ) ^ ((1 : ℂ) / 2 - s)

theorem norm_deltaS {p : ℕ} (hp : 0 < p) (s : ℂ) :
    ‖deltaS p s‖ = (p : ℝ) ^ (1 / 2 - s.re) := by
  have hcast : ((p : ℕ) : ℂ) = (((p : ℝ)) : ℂ) := by push_cast; ring
  have hppos : (0 : ℝ) < (p : ℝ) := by exact_mod_cast hp
  rw [deltaS, hcast, Complex.norm_cpow_eq_rpow_re_of_pos hppos]
  congr 1
  simp

/-- **The unit circle is exactly the critical line.** -/
theorem norm_deltaS_eq_one_iff {p : ℕ} (hp : 2 ≤ p) (s : ℂ) :
    ‖deltaS p s‖ = 1 ↔ s.re = 1 / 2 := by
  have hp0 : 0 < p := by omega
  have hp1 : (1 : ℝ) < (p : ℝ) := by
    have : (2 : ℝ) ≤ (p : ℝ) := by exact_mod_cast hp
    linarith
  rw [norm_deltaS hp0, Real.rpow_def_of_pos (by linarith), Real.exp_eq_one_iff]
  have hlog : Real.log (p : ℝ) ≠ 0 := ne_of_gt (Real.log_pos hp1)
  constructor
  · intro h
    have := (mul_eq_zero.mp h).resolve_left hlog
    linarith
  · intro h
    rw [h, sub_self, mul_zero]

/-- **The uniform off-line contraction bound.**  The `p = 2` coordinate gives the largest resolvent
bound, so it dominates uniformly over every prime. -/
theorem contractionBound_le {p : ℕ} (hp : 2 ≤ p) {s : ℂ} (hs : s.re ≠ 1 / 2) :
    1 / |‖deltaS p s‖ - 1| ≤ 1 / |‖deltaS 2 s‖ - 1| := by
  have hp0 : 0 < p := by omega
  have h2 : (1 : ℝ) < 2 := by norm_num
  have hple : (2 : ℝ) ≤ (p : ℝ) := by exact_mod_cast hp
  rw [norm_deltaS hp0, norm_deltaS (by norm_num : 0 < 2)]
  push_cast
  set a : ℝ := 1 / 2 - s.re with ha
  have ha0 : a ≠ 0 := sub_ne_zero.mpr (Ne.symm hs)
  have hmono : |(2 : ℝ) ^ a - 1| ≤ |(p : ℝ) ^ a - 1| := by
    rcases lt_or_gt_of_ne ha0 with hneg | hpos
    · -- `a < 0` : both powers are below one and `p ^ a ≤ 2 ^ a`
      have h1 : (p : ℝ) ^ a ≤ (2 : ℝ) ^ a :=
        Real.rpow_le_rpow_of_nonpos (by norm_num) hple (le_of_lt hneg)
      have h2' : (2 : ℝ) ^ a < 1 := by
        rw [show (1 : ℝ) = (2 : ℝ) ^ (0 : ℝ) by norm_num]
        exact Real.rpow_lt_rpow_of_exponent_lt h2 hneg
      have h3 : (0 : ℝ) < (p : ℝ) ^ a := Real.rpow_pos_of_pos (by linarith) a
      rw [abs_of_nonpos (by linarith), abs_of_nonpos (by linarith)]
      linarith
    · -- `a > 0` : both powers exceed one and `2 ^ a ≤ p ^ a`
      have h1 : (2 : ℝ) ^ a ≤ (p : ℝ) ^ a :=
        Real.rpow_le_rpow (by norm_num) hple (le_of_lt hpos)
      have h2' : (1 : ℝ) < (2 : ℝ) ^ a := by
        rw [show (1 : ℝ) = (2 : ℝ) ^ (0 : ℝ) by norm_num]
        exact Real.rpow_lt_rpow_of_exponent_lt h2 hpos
      rw [abs_of_nonneg (by linarith), abs_of_nonneg (by linarith)]
      linarith
  have hpos2 : 0 < |(2 : ℝ) ^ a - 1| := by
    refine abs_pos.mpr (sub_ne_zero.mpr ?_)
    intro hcon
    rw [Real.rpow_def_of_pos (by norm_num), Real.exp_eq_one_iff] at hcon
    have : Real.log 2 ≠ 0 := ne_of_gt (Real.log_pos h2)
    exact ha0 ((mul_eq_zero.mp hcon).resolve_left this)
  exact one_div_le_one_div_of_le hpos2 hmono

/-! ### A commuting set generates a commutative algebra -/

/-- **Elements of the algebra generated by a commuting set commute.** -/
theorem commute_of_mem_adjoin {A : Type*} [Ring A] [Algebra ℂ A] {S : Set A}
    (hS : ∀ x ∈ S, ∀ y ∈ S, Commute x y) {a b : A}
    (ha : a ∈ Algebra.adjoin ℂ S) (hb : b ∈ Algebra.adjoin ℂ S) : Commute a b := by
  have hSc : S ⊆ (Subalgebra.centralizer ℂ S : Set A) := by
    intro x hx
    rw [SetLike.mem_coe, Subalgebra.mem_centralizer_iff]
    intro g hg
    exact hS g hg x hx
  have h1 : Algebra.adjoin ℂ S ≤ Subalgebra.centralizer ℂ S := Algebra.adjoin_le hSc
  have h2 : Algebra.adjoin ℂ S
      ≤ Subalgebra.centralizer ℂ (Subalgebra.centralizer ℂ S : Set A) :=
    Algebra.adjoin_le_centralizer_centralizer ℂ S
  have hbc : b ∈ (Subalgebra.centralizer ℂ S : Set A) := h1 hb
  exact ((Subalgebra.mem_centralizer_iff ℂ).mp (h2 ha) b hbc).symm

/-- The commutative ring structure on the algebra generated by a commuting set. -/
@[reducible]
def adjoinCommRing {A : Type*} [Ring A] [Algebra ℂ A] {S : Set A}
    (hS : ∀ x ∈ S, ∀ y ∈ S, Commute x y) : CommRing (Algebra.adjoin ℂ S) :=
  { (inferInstance : Ring (Algebra.adjoin ℂ S)) with
    mul_comm := fun a b => Subtype.ext (commute_of_mem_adjoin hS a.2 b.2) }

/-! ### The Koszul functional of a tuple -/

/-- The Koszul functional of a tuple: `v ↦ ∑ a i * v i`. -/
def koszulFunctional {R : Type*} [CommRing R] {n : ℕ} (a : Fin n → R) :
    (Fin n → R) →ₗ[R] R :=
  ∑ i : Fin n, (a i) • (LinearMap.proj i)

theorem koszulFunctional_apply {R : Type*} [CommRing R] {n : ℕ} (a : Fin n → R)
    (v : Fin n → R) : koszulFunctional a v = ∑ i : Fin n, a i * v i := by
  rw [koszulFunctional]
  simp [LinearMap.sum_apply, smul_eq_mul]

theorem koszulFunctional_single {R : Type*} [CommRing R] {n : ℕ} (a : Fin n → R) (j : Fin n) :
    koszulFunctional a (Pi.single j 1) = a j := by
  classical
  rw [koszulFunctional_apply, Finset.sum_eq_single j]
  · rw [Pi.single_eq_same, mul_one]
  · intro i _ hij
    rw [Pi.single_eq_of_ne hij, mul_zero]
  · intro hj
    exact absurd (Finset.mem_univ j) hj

/-- **A single invertible coordinate contracts the Koszul complex of a tuple.** -/
theorem koszul_tuple_contraction {R : Type*} [CommRing R] {n : ℕ} (a : Fin n → R) (j : Fin n)
    {b : R} (hb : b * a j = 1) (m : ℕ) :
    (physicalKoszulDifferential (m + 1) (koszulFunctional a)).comp
        (b • wedgeLeft (m + 1) (Pi.single j (1 : R)))
      + (b • wedgeLeft m (Pi.single j (1 : R))).comp
          (physicalKoszulDifferential m (koszulFunctional a))
      = LinearMap.id := by
  refine koszul_contraction m (koszulFunctional a) (Pi.single j (1 : R)) ?_
  rw [koszulFunctional_single]
  exact hb

/-! ### The finite prime Koszul complex -/

set_option synthInstance.maxHeartbeats 1000000 in
set_option maxHeartbeats 1000000 in
/-- **The contraction of the Koszul complex of a commuting tuple.**  Inside the commutative algebra
generated by a commuting set, one invertible coordinate contracts the whole complex. -/
theorem primeKoszulContraction {A : Type*} [Ring A] [Algebra ℂ A] {S : Set A}
    (hS : ∀ x ∈ S, ∀ y ∈ S, Commute x y) {n : ℕ}
    (a : Fin n → (Algebra.adjoin ℂ S)) (j : Fin n) (b : Algebra.adjoin ℂ S)
    (hb : b * a j = 1) (m : ℕ) :
    letI : CommRing (Algebra.adjoin ℂ S) := adjoinCommRing hS
    (physicalKoszulDifferential (m + 1) (koszulFunctional a)).comp
        (b • wedgeLeft (m + 1) (Pi.single j 1))
      + (b • wedgeLeft m (Pi.single j 1)).comp
          (physicalKoszulDifferential m (koszulFunctional a))
      = LinearMap.id := by
  letI : CommRing (Algebra.adjoin ℂ S) := adjoinCommRing hS
  exact koszul_tuple_contraction a j hb m

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- The Koszul coordinate `U_p - δ_s(p)` at the critical normalization. -/
def primeKoszulCoord {n : ℕ} (U : Fin n → (H ≃ₗᵢ[ℂ] H)) (P : Fin n → ℕ) (s : ℂ) (i : Fin n) :
    H →L[ℂ] H :=
  unitaryOp (U i) - deltaS (P i) s • (1 : H →L[ℂ] H)

/-- **Off the critical line every prime coordinate is invertible.** -/
theorem isUnit_primeKoszulCoord {n : ℕ} (U : Fin n → (H ≃ₗᵢ[ℂ] H)) (P : Fin n → ℕ) {s : ℂ}
    {i : Fin n} (hP : 2 ≤ P i) (hs : s.re ≠ 1 / 2) :
    IsUnit (primeKoszulCoord U P s i) := by
  refine isUnit_unitaryOp_sub_smul (U i) ?_
  intro h
  exact hs ((norm_deltaS_eq_one_iff hP s).mp h)

omit [CompleteSpace H] in
/-- Scalars are central. -/
theorem commute_smul_one (c : ℂ) (x : H →L[ℂ] H) : Commute (c • (1 : H →L[ℂ] H)) x := by
  rw [← Algebra.algebraMap_eq_smul_one]
  exact Algebra.commutes c x

omit [CompleteSpace H] in
/-- **Commuting unitaries give commuting Koszul coordinates.** -/
theorem commute_primeKoszulCoord {n : ℕ} (U : Fin n → (H ≃ₗᵢ[ℂ] H)) (P : Fin n → ℕ) (s : ℂ)
    (hcomm : ∀ i k, Commute (unitaryOp (U i)) (unitaryOp (U k))) (i k : Fin n) :
    Commute (primeKoszulCoord U P s i) (primeKoszulCoord U P s k) := by
  refine Commute.sub_left ?_ ?_
  · exact Commute.sub_right (hcomm i k) (commute_smul_one _ _).symm
  · exact Commute.sub_right (commute_smul_one _ _) (commute_smul_one _ _)

/-- **The commuting generating set off the critical line.**  There is a commuting set of operators
whose generated algebra contains every prime Koszul coordinate together with a two-sided inverse of
the `j`-th one. -/
theorem exists_commuting_adjoin_of_offLine {n : ℕ} (U : Fin n → (H ≃ₗᵢ[ℂ] H)) (P : Fin n → ℕ)
    {s : ℂ} (hcomm : ∀ i k, Commute (unitaryOp (U i)) (unitaryOp (U k)))
    (j : Fin n) (hP : 2 ≤ P j) (hs : s.re ≠ 1 / 2) :
    ∃ S : Set (H →L[ℂ] H), (∀ x ∈ S, ∀ y ∈ S, Commute x y) ∧
      (∀ i, primeKoszulCoord U P s i ∈ Algebra.adjoin ℂ S) ∧
      ∃ b ∈ Algebra.adjoin ℂ S, b * primeKoszulCoord U P s j = 1 := by
  classical
  obtain ⟨u, hu⟩ := isUnit_primeKoszulCoord U P hP hs
  set r : H →L[ℂ] H := ((u⁻¹ : (H →L[ℂ] H)ˣ) : H →L[ℂ] H) with hr
  refine ⟨Set.range (primeKoszulCoord U P s) ∪ {r}, ?_, ?_, ?_⟩
  · have hcu : ∀ i, Commute (primeKoszulCoord U P s i) r := by
      intro i
      refine Commute.units_inv_right ?_
      rw [hu]
      exact commute_primeKoszulCoord U P s hcomm i j
    rintro x (⟨i, rfl⟩ | hx) y (⟨k, rfl⟩ | hy)
    · exact commute_primeKoszulCoord U P s hcomm i k
    · rw [Set.mem_singleton_iff] at hy
      subst hy
      exact hcu i
    · rw [Set.mem_singleton_iff] at hx
      subst hx
      exact (hcu k).symm
    · rw [Set.mem_singleton_iff] at hx hy
      subst hx; subst hy
      exact Commute.refl _
  · intro i
    exact Algebra.subset_adjoin (Or.inl ⟨i, rfl⟩)
  · refine ⟨r, Algebra.subset_adjoin (Or.inr rfl), ?_⟩
    rw [hr, ← hu]
    exact u.inv_mul

/-! ### The prime logarithmic translations -/

theorem additiveTranslationUnitary_comm (a b : ℝ) (f : Lp (α := ℝ) ℂ 2) :
    additiveTranslationUnitary a (additiveTranslationUnitary b f)
      = additiveTranslationUnitary b (additiveTranslationUnitary a f) := by
  have hfun : (realTranslationEquiv b : ℝ → ℝ) ∘ (realTranslationEquiv a : ℝ → ℝ)
      = (realTranslationEquiv a : ℝ → ℝ) ∘ (realTranslationEquiv b : ℝ → ℝ) := by
    funext x
    simp only [Function.comp_apply, realTranslationEquiv]
    simp
    ring
  change Lp.compMeasurePreserving (realTranslationEquiv a) (realTranslation_measurePreserving a)
      (Lp.compMeasurePreserving (realTranslationEquiv b) (realTranslation_measurePreserving b) f)
    = Lp.compMeasurePreserving (realTranslationEquiv b) (realTranslation_measurePreserving b)
      (Lp.compMeasurePreserving (realTranslationEquiv a) (realTranslation_measurePreserving a) f)
  rw [← Lp.compMeasurePreserving_comp_apply f (realTranslation_measurePreserving b)
        (realTranslation_measurePreserving a),
      ← Lp.compMeasurePreserving_comp_apply f (realTranslation_measurePreserving a)
        (realTranslation_measurePreserving b)]
  have hcongr : ∀ (g₁ g₂ : ℝ → ℝ) (h₁ : MeasurePreserving g₁ (volume : Measure ℝ) volume)
      (h₂ : MeasurePreserving g₂ (volume : Measure ℝ) volume), g₁ = g₂ →
      (Lp.compMeasurePreserving (E := ℂ) (p := 2) g₁ h₁)
        = Lp.compMeasurePreserving (E := ℂ) (p := 2) g₂ h₂ := by
    rintro g₁ g₂ h₁ h₂ rfl
    rfl
  exact congrArg (fun T => T f) (hcongr _ _ _ _ hfun)

theorem commute_additiveTranslationUnitary (a b : ℝ) :
    Commute (unitaryOp (additiveTranslationUnitary a)) (unitaryOp (additiveTranslationUnitary b)) := by
  refine ContinuousLinearMap.ext (fun f => ?_)
  show unitaryOp (additiveTranslationUnitary a) (unitaryOp (additiveTranslationUnitary b) f)
    = unitaryOp (additiveTranslationUnitary b) (unitaryOp (additiveTranslationUnitary a) f)
  simp only [unitaryOp_apply]
  exact additiveTranslationUnitary_comm a b f

/-- **The finite prime Koszul complex contracts off the critical line.**  For any finite family of
primes the logarithmic translations commute, and off `Re s = 1/2` their Koszul coordinates lie in a
single commutative algebra in which one coordinate is invertible; the Cartan contraction
`koszul_tuple_contraction` then contracts the complex. -/
theorem primeTranslationKoszul_offLine {n : ℕ} (P : Fin n → ℕ) {s : ℂ}
    (j : Fin n) (hP : 2 ≤ P j) (hs : s.re ≠ 1 / 2) :
    ∃ S : Set (Lp (α := ℝ) ℂ 2 (volume : Measure ℝ) →L[ℂ]
        Lp (α := ℝ) ℂ 2 (volume : Measure ℝ)),
      (∀ x ∈ S, ∀ y ∈ S, Commute x y) ∧
      (∀ i, primeKoszulCoord (fun i => additiveTranslationUnitary (Real.log (P i))) P s i
        ∈ Algebra.adjoin ℂ S) ∧
      ∃ b ∈ Algebra.adjoin ℂ S,
        b * primeKoszulCoord (fun i => additiveTranslationUnitary (Real.log (P i))) P s j = 1 :=
  exists_commuting_adjoin_of_offLine _ P
    (fun _ _ => commute_additiveTranslationUnitary _ _) j hP hs

end RHTower
