theorem thetaCuspFirstAtomWardMoment_stein_bounds :
    (1697/10000 : ℝ) * Real.exp (-Real.pi) ≤ thetaCuspLiouvilleGibbsMoment 0 1 ∧
    (423/5000 : ℝ) * Real.exp (-Real.pi) ≤ thetaCuspFirstAtomWardMoment 1 ∧
    thetaCuspFirstAtomWardMoment 2 ≤ (5457/500000 : ℝ) * Real.exp (-Real.pi) ∧
    (441/200000 : ℝ) * Real.exp (-Real.pi) ≤ thetaCuspFirstAtomWardMoment 3 := by
  have h0 := massStein_integral_lower
  have h1 := ward1Stein_integral_lower
  have h2 := ward2Stein_integral_lower
  have h3 := ward3Stein_integral_lower
  simp only [massSteinTarget, ward1SteinTarget, ward2SteinTarget, ward3SteinTarget,
    thetaGibbsPolynomialIntegral_add, thetaGibbsPolynomialIntegral_C_mul_pow] at h0 h1 h2 h3
  norm_num only [one_mul, neg_mul, neg_one_mul] at h0 h1 h2 h3
  refine ⟨h0, ?_, ?_, ?_⟩
  · norm_num [thetaCuspFirstAtomWardMoment]
    linarith
  · norm_num [thetaCuspFirstAtomWardMoment]
    linarith
  · norm_num [thetaCuspFirstAtomWardMoment]
    linarith

/-- The two actual theta-source ratio inequalities hold unconditionally. -/
theorem thetaCuspFirstAtomWardMoment_stein_ratio_bounds :
    14 * ((3005/2997 : ℝ) * thetaCuspFirstAtomWardMoment 2)^2 ≤
      9 * thetaCuspFirstAtomWardMoment 1 * thetaCuspFirstAtomWardMoment 3 ∧
    16 * ((3005/2997 : ℝ) * thetaCuspFirstAtomWardMoment 0) *
      ((3005/2997 : ℝ) * thetaCuspFirstAtomWardMoment 2) ≤
        45 * thetaCuspFirstAtomWardMoment 1 ^ 2 := by
  obtain ⟨h0, h1, h2, h3⟩ := thetaCuspFirstAtomWardMoment_stein_bounds
  let e := Real.exp (-Real.pi)
  have he : 0 ≤ e := (Real.exp_pos _).le
  have hw0 := thetaCuspFirstAtomWardMoment_nonneg 0
  have hw1 := thetaCuspFirstAtomWardMoment_nonneg 1
  have hw2 := thetaCuspFirstAtomWardMoment_nonneg 2
  have hw3 := thetaCuspFirstAtomWardMoment_nonneg 3
  have h0' : thetaCuspFirstAtomWardMoment 0 ≤ (18303/10000 : ℝ) * e := by
    dsimp [thetaCuspFirstAtomWardMoment, e]
    linarith
  constructor
  · calc
      14 * ((3005/2997 : ℝ) * thetaCuspFirstAtomWardMoment 2)^2 ≤
          14 * ((3005/2997 : ℝ) * ((5457/500000 : ℝ)*e))^2 := by
            gcongr
      _ ≤ 9 * ((423/5000 : ℝ)*e) * ((441/200000 : ℝ)*e) := by
        have hn : (14 : ℝ) * ((3005/2997 : ℝ)*(5457/500000))^2 ≤
            9*(423/5000)*(441/200000) := by norm_num
        convert mul_le_mul_of_nonneg_right hn (sq_nonneg e) using 1 <;> first | rfl | ring
      _ ≤ 9 * thetaCuspFirstAtomWardMoment 1 * thetaCuspFirstAtomWardMoment 3 := by
        gcongr
  · calc
      16 * ((3005/2997 : ℝ) * thetaCuspFirstAtomWardMoment 0) *
          ((3005/2997 : ℝ) * thetaCuspFirstAtomWardMoment 2) ≤
        16 * ((3005/2997 : ℝ) * ((18303/10000 : ℝ)*e)) *
          ((3005/2997 : ℝ) * ((5457/500000 : ℝ)*e)) := by
            gcongr
      _ ≤ 45 * ((423/5000 : ℝ)*e)^2 := by
        have hn : (16 : ℝ) * ((3005/2997 : ℝ)*(18303/10000)) *
            ((3005/2997 : ℝ)*(5457/500000)) ≤ 45*(423/5000)^2 := by norm_num
        convert mul_le_mul_of_nonneg_right hn (sq_nonneg e) using 1 <;> first | rfl | ring
      _ ≤ 45 * thetaCuspFirstAtomWardMoment 1 ^ 2 := by
        gcongr

/-- Every linear-polynomial completed prime--Gamma source Hankel test is nonnegative.
This closes the first nonconstant source minor; it does not assert higher-rank positivity. -/
theorem forall_primeArchSourceTraceHankel_linear_nonneg_stein :
    ∀ a b : ℝ, 0 ≤ (primeArchSourceTraceHankel (C a + C b * X)).re :=
  forall_primeArchSourceTraceHankel_linear_nonneg_of_liouvilleWard
    thetaCuspFirstAtomWardMoment_stein_ratio_bounds.1
    thetaCuspFirstAtomWardMoment_stein_ratio_bounds.2

end
