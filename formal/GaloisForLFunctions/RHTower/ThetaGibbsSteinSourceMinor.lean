import GaloisForLFunctions.RHTower.ThetaGibbsSteinIntegral

/-!
# The first completed source Hankel minor

Four exponential-polynomial Stein primitives have globally nonnegative
Bernstein remainders. Exact integration gives first-atom Ward moment bounds;
the uniform theta-atom comparison then proves both source moment-ratio
inequalities and every linear-polynomial prime--Gamma Hankel test.

All residual identities and rational inequalities are proved in the kernel.
The density, improper integrals and boundary charge remain exact throughout.
-/

open Real MeasureTheory Set Filter Topology Polynomial
open scoped BigOperators
namespace RHTower
noncomputable section
set_option maxHeartbeats 400000

private def massSteinWitness : Fin 4 → ℝ[X] :=
  ![C (795520895838047 / 5000000000000000 : ℝ) * X^0,
    C (15472419179299 / 1250000000000000 : ℝ) * X^0,
    C (-21055774626681 / 10000000000000000 : ℝ) * X^0,
    C (646925903239 / 2000000000000000 : ℝ) * X^0]

private def massSteinTarget : ℝ[X] := C (1 / 1 : ℝ) * X^0

private def massSteinResidualLo (x t : ℝ) : ℝ :=
  (4*x)^0 * ((79950884414992527 / 250000000000000000000 : ℝ) * t^0 * (1-t)^4 +
      (23894593306673967 / 7812500000000000000 : ℝ) * t^1 * (1-t)^3 +
      (959760895265567619 / 500000000000000000000 : ℝ) * t^2 * (1-t)^2 +
      (127987907292108757 / 100000000000000000000 : ℝ) * t^3 * (1-t)^1 +
      (320015454077 / 1000000000000000 : ℝ) * t^4 * (1-t)^0)

private theorem massSteinResidualLo_nonneg (x t : ℝ) (_hx : 0 ≤ x)
    (ht : 0 ≤ t) (ht1 : t ≤ 1) :
    0 ≤ massSteinResidualLo x t := by
  have h1 : 0 ≤ 1-t := sub_nonneg.mpr ht1
  unfold massSteinResidualLo
  positivity

private def massSteinResidualHi (x t : ℝ) : ℝ :=
  (4*x)^0 * ((989442043989431 / 3125000000000000000 : ℝ) * t^0 * (1-t)^4 +
      (19034575313837439 / 6250000000000000000 : ℝ) * t^1 * (1-t)^3 +
      (2968326131968233 / 1562500000000000000 : ℝ) * t^2 * (1-t)^2 +
      (3166214540766367 / 2500000000000000000 : ℝ) * t^3 * (1-t)^1 +
      (316621454077 / 1000000000000000 : ℝ) * t^4 * (1-t)^0)

private theorem massSteinResidualHi_nonneg (x t : ℝ) (_hx : 0 ≤ x)
    (ht : 0 ≤ t) (ht1 : t ≤ 1) :
    0 ≤ massSteinResidualHi x t := by
  have h1 : 0 ≤ 1-t := sub_nonneg.mpr ht1
  unfold massSteinResidualHi
  positivity

private theorem massStein_remainder_nonneg (x t : ℝ)
    (hx : 0 ≤ x) (ht : 0 ≤ t) (ht1 : t ≤ 1) :
    0 ≤ massSteinTarget.eval x -
      thetaGibbsSteinPolynomial Real.pi massSteinWitness x t := by
  have hpilo : (314159/100000 : ℝ) ≤ Real.pi := by linarith [Real.pi_gt_d6]
  have hpihi : Real.pi ≤ (3927/1250 : ℝ) := by linarith [Real.pi_lt_d4]
  have hm := add_nonneg
    (mul_nonneg (sub_nonneg.mpr hpihi) (massSteinResidualLo_nonneg x t hx ht ht1))
    (mul_nonneg (sub_nonneg.mpr hpilo) (massSteinResidualHi_nonneg x t hx ht ht1))
  have hid : (1/100000 : ℝ) * (massSteinTarget.eval x -
      thetaGibbsSteinPolynomial Real.pi massSteinWitness x t) =
      ((3927/1250 : ℝ)-Real.pi)*massSteinResidualLo x t +
        (Real.pi-(314159/100000 : ℝ))*massSteinResidualHi x t := by
    norm_num [massSteinTarget, massSteinWitness, massSteinResidualLo, massSteinResidualHi,
      thetaGibbsSteinPolynomial, Fin.sum_univ_succ, Polynomial.derivative_pow]
    ring
  nlinarith only [hm, hid]

private theorem massStein_integral_lower :
    (1697 / 10000 : ℝ) * Real.exp (-Real.pi) ≤
      thetaGibbsPolynomialIntegral massSteinTarget := by
  have h := thetaGibbsPolynomialIntegral_lower_of_stein
    massSteinTarget massSteinWitness (fun x hx =>
      massStein_remainder_nonneg x (Real.exp (-2*x)) hx
        (Real.exp_pos _).le (Real.exp_le_one_iff.mpr (by linarith)))
  norm_num [massSteinWitness, Fin.sum_univ_succ] at h
  simpa only [neg_div, neg_mul] using h

