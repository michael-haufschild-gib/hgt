import GaloisForLFunctions.RHTower.DeningerPacketUnits
import GaloisForLFunctions.RHTower.DeningerMappingTorus
import Mathlib.Topology.Algebra.OpenSubgroup

/-!
# Prime-packet quotient by the Frobenius closure

For a prime `p`, the diagonal image of `p` is a unit in every `ℓ`-adic factor with `ℓ ≠ p`.
This file constructs that element in `DeningerPacketUnits p`, divides by the topological closure
of its cyclic subgroup, and proves that its class is one.  The quotient remains profinite.

The last fact uses a reusable theorem proved here: a quotient of a compact Hausdorff totally
disconnected abelian group by a closed subgroup is totally disconnected.  Mathlib did not expose
this instance.  The proof separates any nontrivial quotient class by an open subgroup obtained
inside a clopen neighborhood of the identity.

Finally, suspending the quotient with period `log p` gives a concrete prime-fibre candidate and a
homeomorphism with the quotient packet times `AddCircle (log p)`.  No claim is made here that this
candidate is already identified with Deninger's arithmetic space or relevant complex.
-/

namespace RHTower

open Set
open scoped Pointwise

/-- A closed quotient of a profinite abelian group is again totally disconnected. -/
theorem deningerTotallyDisconnected_quotient_closedSubgroup
    {G : Type*} [CommGroup G] [TopologicalSpace G] [IsTopologicalGroup G]
    [CompactSpace G] [T2Space G] [TotallyDisconnectedSpace G]
    (N : Subgroup G) [hN : IsClosed (N : Set G)] :
    TotallyDisconnectedSpace (G ⧸ N) := by
  rw [totallyDisconnectedSpace_iff_connectedComponent_one]
  apply Set.Subset.antisymm
  · intro z hz
    by_contra hz1
    obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective z
    have hgN : g ∉ N := by
      intro hg
      exact hz1 ((QuotientGroup.eq_one_iff g).mpr hg)
    have hbadClosed : IsClosed (((N : Set G)⁻¹) * ({g} : Set G)) :=
      hN.inv.mul_right_of_isCompact isCompact_singleton
    have hOneGood : (1 : G) ∈ ((((N : Set G)⁻¹) * ({g} : Set G))ᶜ) := by
      intro hbad
      rw [Set.mem_mul] at hbad
      obtain ⟨n, hn, y, hy, hny⟩ := hbad
      rw [Set.mem_inv] at hn
      simp only [Set.mem_singleton_iff] at hy
      subst y
      apply hgN
      have hn' : n⁻¹ ∈ N := hn
      have hg : g = n⁻¹ := eq_inv_of_mul_eq_one_right hny
      exact hg.symm ▸ hn'
    obtain ⟨C, hCclopen, hOneC, hCgood⟩ :=
      compact_exists_isClopen_in_isOpen hbadClosed.isOpen_compl hOneGood
    obtain ⟨H, hHC⟩ :=
      IsTopologicalGroup.exist_openSubgroup_sub_clopen_nhds_of_one hCclopen hOneC
    let K : Subgroup G := N ⊔ (H : Subgroup G)
    have hNK : N ≤ K := le_sup_left
    have hHK : (H : Subgroup G) ≤ K := le_sup_right
    have hKopen : IsOpen (K : Set G) :=
      Subgroup.isOpen_mono hHK H.isOpen
    have hgK : g ∉ K := by
      intro hg
      obtain ⟨n, hn, h, hh, hnh⟩ :=
        (Subgroup.mem_sup_of_normal_left (s := N) (t := (H : Subgroup G))).mp hg
      have hhC : h ∈ C := hHC hh
      have hhgood := hCgood hhC
      apply hhgood
      rw [Set.mem_mul]
      refine ⟨n⁻¹, ?_, g, Set.mem_singleton g, ?_⟩
      · rw [Set.mem_inv]
        simpa using hn
      · rw [← hnh]
        simp
    let QK : OpenSubgroup (G ⧸ N) :=
      { toSubgroup := Subgroup.map (QuotientGroup.mk' N) K
        isOpen' := by
          have himage :
              (Subgroup.map (QuotientGroup.mk' N) K : Set (G ⧸ N)) =
                QuotientGroup.mk '' (K : Set G) := by
            ext q
            constructor <;> rintro ⟨g, hg, rfl⟩ <;> exact ⟨g, hg, rfl⟩
          change IsOpen ((Subgroup.map (QuotientGroup.mk' N) K :
            Subgroup (G ⧸ N)) : Set (G ⧸ N))
          rw [himage]
          exact QuotientGroup.isOpenMap_coe (K : Set G) hKopen }
    have hcc : connectedComponent (1 : G ⧸ N) ⊆ (QK : Set (G ⧸ N)) :=
      QK.isClopen.connectedComponent_subset QK.one_mem
    have hmkQK : (QuotientGroup.mk g : G ⧸ N) ∈ QK := hcc hz
    apply hgK
    have hcomap : g ∈ Subgroup.comap (QuotientGroup.mk' N) QK := hmkQK
    rw [show (QK : Subgroup (G ⧸ N)) =
      Subgroup.map (QuotientGroup.mk' N) K from rfl,
      QuotientGroup.comap_map_mk', sup_eq_right.mpr hNK] at hcomap
    exact hcomap
  · exact Set.singleton_subset_iff.mpr mem_connectedComponent

/-- The diagonal prime unit in `∏_{ℓ ≠ p} ℤ_ℓˣ`. -/
noncomputable def deningerPacketFrobeniusUnit (p : Nat.Primes) :
    DeningerPacketUnits p := fun ℓ =>
  (PadicInt.isUnit_iff.mpr (by
    rw [PadicInt.norm_natCast_eq_one_iff]
    exact (Nat.coprime_primes ℓ.1.2 p.2).mpr ℓ.2)).unit

/-- Algebraic cyclic subgroup generated by the diagonal prime unit. -/
noncomputable def deningerPacketFrobeniusCyclic (p : Nat.Primes) :
    Subgroup (DeningerPacketUnits p) :=
  Subgroup.zpowers (deningerPacketFrobeniusUnit p)

/-- Closed subgroup generated topologically by the diagonal prime unit. -/
noncomputable def deningerPacketFrobeniusClosure (p : Nat.Primes) :
    Subgroup (DeningerPacketUnits p) :=
  (deningerPacketFrobeniusCyclic p).topologicalClosure

noncomputable instance (p : Nat.Primes) :
    IsClosed (deningerPacketFrobeniusClosure p : Set (DeningerPacketUnits p)) :=
  Subgroup.isClosed_topologicalClosure _

/-- Profinite packet factor after dividing by the Frobenius closure. -/
abbrev DeningerPacketFrobeniusQuotient (p : Nat.Primes) :=
  DeningerPacketUnits p ⧸ deningerPacketFrobeniusClosure p

/-- Frobenius is trivial in the closure quotient, by construction of the actual diagonal unit. -/
theorem deningerPacketFrobenius_eq_one (p : Nat.Primes) :
    (QuotientGroup.mk (deningerPacketFrobeniusUnit p) :
      DeningerPacketFrobeniusQuotient p) = 1 := by
  rw [QuotientGroup.eq_one_iff]
  exact Subgroup.le_topologicalClosure _ (Subgroup.mem_zpowers _)

noncomputable instance (p : Nat.Primes) :
    CompactSpace (DeningerPacketFrobeniusQuotient p) := inferInstance

noncomputable instance (p : Nat.Primes) :
    T2Space (DeningerPacketFrobeniusQuotient p) := inferInstance

noncomputable instance (p : Nat.Primes) :
    IsTopologicalGroup (DeningerPacketFrobeniusQuotient p) := inferInstance

noncomputable instance (p : Nat.Primes) :
    TotallyDisconnectedSpace (DeningerPacketFrobeniusQuotient p) :=
  deningerTotallyDisconnected_quotient_closedSubgroup _

/-- Concrete mapping-torus candidate for the prime fibre, with period `log p`. -/
abbrev DeningerPrimeFibreCandidate (p : Nat.Primes) :=
  DeningerMappingTorus (DeningerPacketFrobeniusQuotient p) (Real.log (p : ℝ))

/-- The prime-fibre candidate is the quotient packet times its period circle. -/
noncomputable def deningerPrimeFibreCandidateHomeomorph (p : Nat.Primes) :
    DeningerPrimeFibreCandidate p ≃ₜ
      DeningerPacketFrobeniusQuotient p × AddCircle (Real.log (p : ℝ)) :=
  deningerMappingTorusHomeomorph

/-- The concrete quotient packet with its prime-period circle admits a finite continuous
partition of unity subordinate to every open cover, locally constant in the profinite direction. -/
theorem deningerPrimeFibreCandidateFine (p : Nat.Primes) {κ : Type}
    (U : κ → Set (DeningerPacketFrobeniusQuotient p ×
      AddCircle (Real.log (p : ℝ))))
    (hU : ∀ j, IsOpen (U j))
    (hcov : ∀ q, ∃ j, q ∈ U j) :
    ∃ (ι : Type) (_ : Fintype ι)
      (ρ : ι → DeningerPacketFrobeniusQuotient p ×
        AddCircle (Real.log (p : ℝ)) → ℝ) (g : ι → κ),
      (∀ i, Continuous (ρ i))
        ∧ (∀ (i : ι) (t : AddCircle (Real.log (p : ℝ))),
            IsLocallyConstant fun b : DeningerPacketFrobeniusQuotient p => ρ i (b, t))
        ∧ (∀ q, ∑ i, ρ i q = 1)
        ∧ ∀ (i : ι) (q), ρ i q ≠ 0 → q ∈ U (g i) := by
  letI : Fact (0 < Real.log (p : ℝ)) :=
    ⟨Real.log_pos (by exact_mod_cast p.prop.one_lt)⟩
  exact deningerPacketFine U hU hcov

end RHTower
