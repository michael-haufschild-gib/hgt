/-!
# Arithmetic Julia normal-cone universality

The actual-prime logarithmic clock has maximally multivalued graph closure after every finite
trace subtraction.  This file connects that global Hardy obstruction to the canonical
Gamma-sewn Julia normal coordinate.

On finite prime packets the normalized Julia coordinate converges to the logarithmic clock.
Every bounded Hardy realization of these packet clocks along any boundary schedule must
therefore escape to infinite operator norm.  The same source-defined coordinate is the unique
minimal positive two-channel lift on each prime cell, and its squared Mellin orbit has two
distinguished boundary faces:

* the Euler face is the von Mangoldt carrier, hypertranscendental over the differential field
  generated by the coordinate and every prime-zeta valuation layer simultaneously;
* the critical face generates a completed prime--Gamma source whose continuation recovers the
  complete strict-right Xi divisor with exact multiplicity.

The recovered divisor carries the universal Euler-edge Julia-defect index, with one `8π` packet
per strict-right upper Schwarz pair.

No zero hypothesis, RH assumption, estimate, numerical computation, or new axiom is used.
-/

open Complex Filter Function Set Topology
open scoped Topology

namespace RHTower

noncomputable section

local instance arithmeticJuliaNormalConeUpperEndDomain :
    IsDomain GaloisForLFunctions.HTGeometry.upperEndAnalyticSubring :=
  GaloisForLFunctions.HTGeometry.isDomain_upperEndAnalyticSubring

local instance arithmeticJuliaNormalConeUpperEndComplexAlgebra :
    Algebra ℂ GaloisForLFunctions.HTGeometry.upperEndMeroField :=
  GaloisForLFunctions.HTGeometry.upperEndComplexToMero.toAlgebra

local instance arithmeticJuliaNormalConeUpperEndDifferential :
    Differential GaloisForLFunctions.HTGeometry.upperEndMeroField :=
  GaloisForLFunctions.HTGeometry.upperEndMeroFieldDifferential

/-- Julia-normal regularization of the order-`m` actual-prime logarithmic clock. -/
def gammaSewnMobiusJuliaFiniteTraceClock
    (x : ℝ) (m : ℕ) : (Nat.Primes →₀ ℝ) →ₗ[ℝ] PrimeHardy :=
  Finsupp.lsum ℝ (fun p => LinearMap.toSpanSingleton ℝ _
    ((gammaSewnMobiusJuliaNormalizedPrimeLog x p *
      primeReciprocal p ^ m) • primeHardyKernel p))

@[simp] theorem gammaSewnMobiusJuliaFiniteTraceClock_single
    (x : ℝ) (m : ℕ) (p : Nat.Primes) (c : ℝ) :
    gammaSewnMobiusJuliaFiniteTraceClock x m (Finsupp.single p c) =
      c • ((gammaSewnMobiusJuliaNormalizedPrimeLog x p *
        primeReciprocal p ^ m) • primeHardyKernel p) := by
  simp [gammaSewnMobiusJuliaFiniteTraceClock]

/-- The Julia-normal packet clock converges to the logarithmic clock on every finite
actual-prime packet. -/
theorem tendsto_gammaSewnMobiusJuliaFiniteTraceClock_nhdsGT_zero
    (m : ℕ) (d : Nat.Primes →₀ ℝ) :
    Tendsto
      (fun x : ℝ => gammaSewnMobiusJuliaFiniteTraceClock x m d)
      (nhdsWithin (0 : ℝ) (Ioi 0))
      (nhds (primeFiniteTraceClock m d)) := by
  classical
  induction d using Finsupp.induction with
  | zero =>
      simp only [map_zero]
      exact tendsto_const_nhds
  | @single_add p c d _hp _hc ih =>
      simp only [map_add, gammaSewnMobiusJuliaFiniteTraceClock_single,
        primeFiniteTraceClock_single]
      have hterm := ((tendsto_const_nhds :
        Tendsto (fun _ : ℝ => c)
          (nhdsWithin (0 : ℝ) (Ioi 0)) (nhds c)).smul
        (((tendsto_gammaSewnMobiusJuliaNormalizedPrimeLog_nhdsGT_zero p).mul_const
          (primeReciprocal p ^ m)).smul_const (primeHardyKernel p)))
      exact hterm.add ih

/-- Every bounded Hardy realization of the Julia-normal packet clocks along a boundary
schedule becomes singular in operator norm. -/
theorem tendsto_norm_of_extends_gammaSewnMobiusJuliaFiniteTraceClock
    (m : ℕ) (x : ℕ → ℝ)
    (hx : Tendsto x atTop (nhdsWithin (0 : ℝ) (Ioi 0)))
    (F : ℕ → PrimeHardy →L[ℝ] PrimeHardy)
    (hF : ∀ n d,
      F n (primeHardyKernelMap d) =
        gammaSewnMobiusJuliaFiniteTraceClock (x n) m d) :
    Tendsto (fun n => ‖F n‖) atTop atTop := by
  apply tendsto_norm_primeBoundedPostprocessedTraceClock_any_recovery_atTop
    m (ContinuousLinearMap.id ℝ PrimeHardy)
  · exact ⟨hardyVacuum, by
      simp only [ContinuousLinearMap.id_apply]
      intro hzero
      have hcoord := congrArg (fun z : PrimeHardy => z 0) hzero
      change (1 : ℝ) = 0 at hcoord
      norm_num at hcoord⟩
  · intro d
    have hclock :=
      (tendsto_gammaSewnMobiusJuliaFiniteTraceClock_nhdsGT_zero m d).comp hx
    simpa [hF, Function.comp_def] using hclock

/-- The von Mangoldt carrier recovered by the Julia normal coordinate is hypertranscendental
over the differential field generated by the genuine coordinate and every prime-zeta valuation
layer simultaneously. -/
theorem vonMangoldtUpperEndMero_hypertranscendentalOver_all_valuationLayers :
    GaloisForLFunctions.HypertranscendentalOver
      GaloisForLFunctions.HTGeometry.analyticScalarValuationLayerDifferentialField
      GaloisForLFunctions.HTGeometry.vonMangoldtUpperEndMero := by
  apply
    GaloisForLFunctions.HTGeometry.analyticPrimeProfileCarrier_hypertranscendentalOver_all_valuationLayers
      GaloisForLFunctions.HTGeometry.vonMangoldtSource
  · exact
      GaloisForLFunctions.HTGeometry.vonMangoldtArith_supportedOnPositivePrimePowers
  · have hall :
        {e : ℕ | ∀ p : Nat.Primes,
          GaloisForLFunctions.HTGeometry.vonMangoldtSource.1
            ((p : ℕ) ^ (e + 1)) ≠ 0} = Set.univ := by
      ext e
      simp only [Set.mem_setOf_eq, Set.mem_univ, iff_true]
      intro p
      have hlog : Real.log (p : ℝ) ≠ 0 :=
        (Real.log_pos (by exact_mod_cast p.property.one_lt)).ne'
      change
        ((ArithmeticFunction.vonMangoldt ((p : ℕ) ^ (e + 1)) : ℝ) : ℂ) ≠ 0
      rw [vonMangoldt_prime_pow_succ_eq_log (p, e)]
      exact_mod_cast hlog
    rw [hall]
    exact Set.infinite_univ

/-- Complete divisor statement used by the arithmetic Julia normal-cone law. -/
def ArithmeticJuliaDivisorComplete (L : ℝ) (N : ℕ) : Prop :=
  (∀ n : ℕ,
    Tendsto
      (fun x : ℝ =>
        gammaSewnMobiusJuliaCriticalCompletedTailCoefficient x L N n)
      (nhdsWithin (0 : ℝ) (Ioi 0))
      (nhds (xiRectangularPrimeGammaTailCoefficient L N n))) ∧
  MeromorphicOn (xiRectangularPrimeGammaTailContinuation L N)
    {s : ℂ | 1 < s.re} ∧
  (∀ s : ℂ, 1 < s.re →
    (meromorphicOrderAt (xiRectangularPrimeGammaTailContinuation L N) s =
        ((-1 : ℤ) : WithTop ℤ) ↔
      ∃ q : XiRightZeroCopy, xiRightShiftedPole q = s)) ∧
  (∀ q : XiRightZeroCopy,
    meromorphicTrailingCoeffAt
        (xiRectangularPrimeGammaTailContinuation L N)
        (xiRightShiftedPole q) /
        (2 * xiRectangularRightCoefficient L q) =
      (xiRightMultiplicity q : ℂ)) ∧
  (RiemannHypothesis ↔
    ∀ s : ℂ, 1 < s.re →
      AnalyticAt ℂ (xiRectangularPrimeGammaTailContinuation L N) s)

/-- Global Hardy singularity and packetwise Julia recovery. -/
def ArithmeticJuliaHardySingularCompletion : Prop :=
  (∀ m : ℕ,
    (realLinearGraphSubmodule primeHardyKernelMap
      (primeFiniteTraceClock m)).topologicalClosure = ⊤) ∧
  (∀ (m : ℕ) (d : Nat.Primes →₀ ℝ),
    Tendsto
      (fun x : ℝ => gammaSewnMobiusJuliaFiniteTraceClock x m d)
      (nhdsWithin (0 : ℝ) (Ioi 0))
      (nhds (primeFiniteTraceClock m d))) ∧
  (∀ (m : ℕ) (x : ℕ → ℝ),
    Tendsto x atTop (nhdsWithin (0 : ℝ) (Ioi 0)) →
    ∀ F : ℕ → PrimeHardy →L[ℝ] PrimeHardy,
      (∀ n d,
        F n (primeHardyKernelMap d) =
          gammaSewnMobiusJuliaFiniteTraceClock (x n) m d) →
      Tendsto (fun n => ‖F n‖) atTop atTop)

/-- Cellwise uniqueness and minimality of the positive Julia normal coordinate. -/
def ArithmeticJuliaCellwiseMinimality : Prop :=
  ∀ (x : ℝ), 0 < x → ∀ p : Nat.Primes,
    (¬ ∀ u : ℝ,
      (gammaSewnMobiusValuationContractionMultiplier x p * u) ^ 2 = u ^ 2) ∧
    ∀ {a b : ℝ},
      a ^ 2 + b ^ 2 = 1 →
      gammaSewnMobiusValuationContractionMultiplier x p * a +
          gammaSewnMobiusJuliaDefect x p * b = 0 →
      0 < gammaSewnMobiusValuationContractionMultiplier x p * b -
          gammaSewnMobiusJuliaDefect x p * a →
      a = -gammaSewnMobiusJuliaDefect x p ∧
        b = gammaSewnMobiusValuationContractionMultiplier x p

/-- Mellin and Kolchin faces of the Julia normal coordinate. -/
def ArithmeticJuliaMellinKolchinCompletion : Prop :=
  (∀ p : Nat.Primes,
    Tendsto
      (fun x : ℝ => gammaSewnMobiusJuliaNormalizedPrimeLog x p)
      (nhdsWithin (0 : ℝ) (Ioi 0))
      (nhds (Real.log (p : ℝ)))) ∧
  (∀ (u : ℝ) (n : ℕ),
    Tendsto
      (fun x : ℝ => gammaSewnMobiusJuliaHardMassCoefficient x u n)
      (nhdsWithin (0 : ℝ) (Ioi 0))
      (nhds (gammaSewnMobiusJuliaMellinBoundaryMass u n))) ∧
  GaloisForLFunctions.HypertranscendentalOver
    GaloisForLFunctions.HTGeometry.analyticScalarValuationLayerDifferentialField
    GaloisForLFunctions.HTGeometry.vonMangoldtUpperEndMero

/-- **Arithmetic Julia normal-cone universality law.**  The actual-prime clock has no bounded
Hardy completion, its canonical Julia packet realization is necessarily singular and cellwise
minimal, its Mellin orbit crosses the complete prime-zeta Kolchin barrier, its critical face
recovers the complete strict-right Xi divisor with multiplicity, and its absolute Euler-edge
index is quantized in universal `8π` packets. -/
theorem arithmeticJuliaNormalConeUniversality :
    ArithmeticJuliaHardySingularCompletion ∧
    ArithmeticJuliaCellwiseMinimality ∧
    ArithmeticJuliaMellinKolchinCompletion ∧
    (∀ {L : ℝ}, 0 < L → ∀ {N : ℕ},
      (∀ n : ℕ, N ≤ n → 1 ≤ n ∧ L ≤ Real.log n / 2) →
      ArithmeticJuliaDivisorComplete L N) ∧
    (∫⁻ t : ℝ, ENNReal.ofReal (xiWardInfinitesimalDefectDensity t) =
      ∑' _ : XiRightUpperZeroCopy, ENNReal.ofReal (8 * Real.pi)) := by
  refine ⟨?_, ?_, ?_, ?_, lintegral_xiWardInfinitesimalDefectDensity⟩
  · refine ⟨primeFiniteTraceClock_graphClosure_eq_top,
      tendsto_gammaSewnMobiusJuliaFiniteTraceClock_nhdsGT_zero, ?_⟩
    intro m x hx F hF
    exact tendsto_norm_of_extends_gammaSewnMobiusJuliaFiniteTraceClock
      m x hx F hF
  · intro x hx p
    refine ⟨gammaSewnMobiusValuationContractionMultiplier_not_scalar_isometry hx p,
      ?_⟩
    intro a b hsecond horth horient
    exact gammaSewnMobiusJuliaSourceTransportV_unique_minimal_positive_lift
      hx p hsecond horth horient
  · exact ⟨tendsto_gammaSewnMobiusJuliaNormalizedPrimeLog_nhdsGT_zero,
      tendsto_gammaSewnMobiusJuliaHardMassCoefficient_nhdsGT_zero,
      vonMangoldtUpperEndMero_hypertranscendentalOver_all_valuationLayers⟩
  · intro L hL N hN
    simpa only [ArithmeticJuliaDivisorComplete] using
      gammaSewnMobiusJuliaCriticalCompletedTail_divisorComplete hL hN

end

end RHTower
