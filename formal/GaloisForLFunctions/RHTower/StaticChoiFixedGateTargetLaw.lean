import GaloisForLFunctions.HTGeometry.GateWordDictionary
import GaloisForLFunctions.RHTower.GaussianHermitianPencilSpectralActionLaw

open Matrix
open GaloisForLFunctions.HTGeometry
open GaloisForLFunctions.RHTower

namespace RHTower

noncomputable section

/-- Literal endpoint of a padded word in one fixed finite unitary gate alphabet. -/
def paddedGateWordEndpoint
    {d : ℕ} {gate : Type*} [Fintype gate]
    (g : gate → Matrix.unitaryGroup (Fin d) ℂ) {s : ℕ}
    (w : PaddedCircuitWord gate s) : Matrix.unitaryGroup (Fin d) ℂ :=
  ⟨gateWord (fun c => (g c : Matrix (Fin d) (Fin d) ℂ)) w,
    gateWord_mem_unitary (fun c => (g c).property) w⟩

/-- Physical Choi target dictionary generated by fixed gate semantics. -/
def paddedGateWordChoiTarget
    {d : ℕ} {gate : Type*} [Fintype gate]
    (g : gate → Matrix.unitaryGroup (Fin d) ℂ) {s : ℕ}
    (w : PaddedCircuitWord gate s) :
    EuclideanSpace ℂ (Fin d × Fin d) :=
  choiVector (paddedGateWordEndpoint g w : Matrix (Fin d) (Fin d) ℂ)

theorem norm_paddedGateWordChoiTarget
    {d : ℕ} (hd : 0 < d)
    {gate : Type*} [Fintype gate]
    (g : gate → Matrix.unitaryGroup (Fin d) ℂ) {s : ℕ}
    (w : PaddedCircuitWord gate s) :
    ‖paddedGateWordChoiTarget g w‖ = 1 := by
  exact norm_choiVector_eq_one (by simpa using hd)
    (Unitary.coe_star_mul_self (paddedGateWordEndpoint g w))

/-- All-identity padded word. -/
def paddedGateIdentityWord {gate : Type*} (e : gate) (s : ℕ) :
    PaddedCircuitWord gate s := fun _ => e

@[simp] theorem paddedGateWordEndpoint_identity
    {d : ℕ} {gate : Type*} [Fintype gate]
    (g : gate → Matrix.unitaryGroup (Fin d) ℂ) (e : gate)
    (he : g e = 1) (s : ℕ) :
    paddedGateWordEndpoint g (paddedGateIdentityWord e s) = 1 := by
  apply Subtype.ext
  change gateWord (fun c => (g c : Matrix (Fin d) (Fin d) ℂ))
      (paddedGateIdentityWord e s) = 1
  unfold gateWord paddedGateIdentityWord
  simp [he]

theorem choiVector_one_eq_staticSpectralChoiVector_zero
    (d : ℕ) (energy : Fin (d + 1) → ℝ) :
    choiVector (1 : Matrix (Fin (d + 1)) (Fin (d + 1)) ℂ) =
      staticSpectralChoiVector (d + 1) 0 energy := by
  ext ij
  rw [staticSpectralChoiVector, fullUniformPhaseChoiVector_apply]
  rw [fourier_finiteHamiltonianAddCirclePhase]
  simp [choiVector, finiteObserverHamiltonianVertexPhase, Matrix.one_apply]
  split <;> ring

@[simp] theorem paddedGateWordChoiTarget_identity
    {d : ℕ} {gate : Type*} [Fintype gate]
    (g : gate → Matrix.unitaryGroup (Fin (d + 1)) ℂ) (e : gate)
    (he : g e = 1) (s : ℕ) (energy : Fin (d + 1) → ℝ) :
    paddedGateWordChoiTarget g (paddedGateIdentityWord e s) =
      staticSpectralChoiVector (d + 1) 0 energy := by
  rw [paddedGateWordChoiTarget, paddedGateWordEndpoint_identity g e he s]
  exact choiVector_one_eq_staticSpectralChoiVector_zero d energy

end

end RHTower
