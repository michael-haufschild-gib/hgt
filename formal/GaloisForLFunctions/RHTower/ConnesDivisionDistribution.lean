import GaloisForLFunctions.HTGeometry.PointSupportStructure
import Mathlib.Analysis.Calculus.IteratedDeriv.Lemmas

/-!
# Connes' division equation for distributions

Formalization of Appendix I (27)(28) of

  A. Connes, *Trace formula in noncommutative geometry and the zeros of the Riemann zeta
  function*, arXiv:math/9811068.

In the proof of Theorem III.1 Connes reaches the distributional equation

  `L(Χ₀, 1/2 + it) · α(t) = 0`,        (27)

and concludes that `α` is a finite linear combination of the derivatives `δ^{(k)}_{t_0}` of Dirac
masses at the zeros `t_0` of `L`, with `k` strictly below the order of the zero:

  *"The condition `k <` order of the zero is necessary and sufficient."*   (28)

The corpus already owns the hard half — the structure theorem for distributions supported at a
point, `GaloisForLFunctions.HTGeometry.exists_delta_representation`, together with the jet test
functions realizing every prescribed finite jet.  This file adds the arithmetic of the equation:

* `connes_iteratedDeriv_mul_eq_zero` - sufficiency in (28): if `φ` vanishes to order `> k` at the
  point, then `δ^{(k)}` solves `φ · α = 0`.
* `connes_iteratedDeriv_mul_ne_zero_of_le` - necessity in (28): if `φ` vanishes to order at least
  `n`, then on the corpus jet test function `jetTest (k - n)` the `k`-th jet of `φ ψ` is
  `C(k,n) φ^{(n)}(0)`, which is nonzero as soon as the order is exactly `n` and `k ≥ n`.
* `connes_delta_order_iff` - the sharp statement `δ^{(k)}` solves `(27)` ⟺ `k < n`.
* `connes_jet_functionals_independent` - the `δ^{(k)}` are linearly independent.
* `connes_division_solution_structure` - every solution is such a combination, once the smooth
  division property `ψ ∈ (φ)` for `ψ` vanishing near the zero is available (which is Connes'
  quoted description of the ideal generated by `φ` in `C^∞`).
-/

namespace GaloisForLFunctions.RHTower

noncomputable section

open GaloisForLFunctions.HTGeometry Finset

/-- **Appendix I (28), sufficiency.**  If `φ` vanishes to order `> k` at the origin then
`⟨φ ψ⟩^{(k)}(0) = 0` for every `ψ`, i.e. `δ^{(k)}_0` solves `φ · α = 0`. -/
theorem connes_iteratedDeriv_mul_eq_zero {φ ψ : ℝ → ℂ} {k : ℕ}
    (hφ : ContDiffAt ℝ (k : ℕ∞) φ 0) (hψ : ContDiffAt ℝ (k : ℕ∞) ψ 0)
    (hvanish : ∀ j, j ≤ k → iteratedDeriv j φ 0 = 0) :
    iteratedDeriv k (fun x => φ x * ψ x) 0 = 0 := by
  have hfun : (fun x => φ x * ψ x) = φ * ψ := rfl
  rw [hfun, iteratedDeriv_mul hφ hψ]
  refine Finset.sum_eq_zero fun i hi => ?_
  rw [hvanish i (Nat.lt_succ_iff.mp (Finset.mem_range.mp hi))]
  ring

/-- **Appendix I (28), necessity.**  If `φ` vanishes to order exactly `n` at the origin and
`n ≤ k`, then `δ^{(k)}_0` does *not* solve `φ · α = 0`: the corpus jet test function
`jetTest (k - n)` is an explicit witness. -/
theorem connes_iteratedDeriv_mul_ne_zero_of_le {φ : ℝ → ℂ} {n k : ℕ}
    (hφ : ContDiff ℝ (⊤ : ℕ∞) φ)
    (hvanish : ∀ j, j < n → iteratedDeriv j φ 0 = 0) (hnk : n ≤ k) :
    iteratedDeriv k (fun x => φ x * (jetTest (k - n) : ℝ → ℂ) x) 0
      = (k.choose n : ℂ) * iteratedDeriv n φ 0 := by
  have hφk : ContDiffAt ℝ (k : ℕ∞) φ 0 :=
    (hφ.of_le (by exact_mod_cast le_top)).contDiffAt
  have hψk : ContDiffAt ℝ (k : ℕ∞) (jetTest (k - n) : ℝ → ℂ) 0 :=
    (((jetTest (k - n)).smooth').of_le (by exact_mod_cast le_top)).contDiffAt
  have hfun : (fun x => φ x * (jetTest (k - n) : ℝ → ℂ) x)
      = φ * (jetTest (k - n) : ℝ → ℂ) := rfl
  rw [hfun, iteratedDeriv_mul hφk hψk]
  rw [Finset.sum_eq_single n]
  · rw [iteratedDeriv_jetTest_zero, if_pos rfl, mul_one]
  · intro i hi hin
    have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
    rcases lt_or_gt_of_ne hin with h | h
    · rw [hvanish i h]; ring
    · rw [iteratedDeriv_jetTest_zero, if_neg (by omega), mul_zero]
  · intro hmem
    exact absurd (Finset.mem_range.mpr (by omega)) hmem

/-- **Appendix I (28), sharp form.**  `δ^{(k)}_0` solves `φ · α = 0` exactly when `k` is strictly
below the order of the zero of `φ`. -/
theorem connes_delta_order_iff {φ : ℝ → ℂ} {n k : ℕ}
    (hφ : ContDiff ℝ (⊤ : ℕ∞) φ)
    (hvanish : ∀ j, j < n → iteratedDeriv j φ 0 = 0)
    (hnz : iteratedDeriv n φ 0 ≠ 0) :
    (∀ ψ : SchwartzMap ℝ ℂ,
        iteratedDeriv k (fun x => φ x * (ψ : ℝ → ℂ) x) 0 = 0) ↔ k < n := by
  constructor
  · intro h
    by_contra hk
    have hnk : n ≤ k := not_lt.mp hk
    have hval := connes_iteratedDeriv_mul_ne_zero_of_le hφ hvanish hnk
    rw [h (jetTest (k - n))] at hval
    have hchoose : (k.choose n : ℂ) ≠ 0 := by
      have hpos : 0 < k.choose n := Nat.choose_pos hnk
      exact_mod_cast hpos.ne'
    exact hnz ((mul_eq_zero.mp hval.symm).resolve_left hchoose)
  · intro hk ψ
    refine connes_iteratedDeriv_mul_eq_zero
      ((hφ.of_le (by exact_mod_cast le_top)).contDiffAt)
      (((ψ.smooth').of_le (by exact_mod_cast le_top)).contDiffAt) ?_
    intro j hj
    exact hvanish j (lt_of_le_of_lt hj hk)

/-- **Appendix I (28), independence.**  The jet functionals `ψ ↦ ψ^{(j)}(0)` are linearly
independent, so the `δ^{(j)}_0` really form a basis of the solution space. -/
theorem connes_jet_functionals_independent {N : ℕ} (c : ℕ → ℂ)
    (h : ∀ ψ : SchwartzMap ℝ ℂ,
      ∑ j ∈ Finset.range (N + 1), c j * iteratedDeriv j (ψ : ℝ → ℂ) 0 = 0) :
    ∀ j, j ≤ N → c j = 0 := by
  intro j hj
  have hval := h (jetTest j)
  simp only [iteratedDeriv_jetTest_zero, mul_ite, mul_one, mul_zero] at hval
  rwa [Finset.sum_ite_eq' (Finset.range (N+1)) j c,
    if_pos (Finset.mem_range.mpr (by omega))] at hval

/-- **Appendix I (27), reduction to the point support.**  If every test function vanishing near the
origin lies in the ideal generated by `φ`, then any distribution annihilated by multiplication by
`φ` is supported at the origin, hence — by the corpus structure theorem — is a finite combination
of derivatives of the Dirac mass. -/
theorem connes_division_solution_structure {X : Type*} [NormedAddCommGroup X] [NormedSpace ℂ X]
    (u : SchwartzMap ℝ ℂ →L[ℂ] X) (φ : ℝ → ℂ)
    (hmul : ∀ ψ χ : SchwartzMap ℝ ℂ,
      ((ψ : ℝ → ℂ) = fun x => φ x * (χ : ℝ → ℂ) x) → u ψ = 0)
    (hdiv : ∀ ψ : SchwartzMap ℝ ℂ, (∃ δ > 0, ∀ x : ℝ, |x| ≤ δ → (ψ : ℝ → ℂ) x = 0) →
      ∃ χ : SchwartzMap ℝ ℂ, (ψ : ℝ → ℂ) = fun x => φ x * (χ : ℝ → ℂ) x) :
    ∃ (N : ℕ) (c : ℕ → X), ∀ ψ : SchwartzMap ℝ ℂ,
      u ψ = ∑ j ∈ Finset.range (N + 1), (iteratedDeriv j (ψ : ℝ → ℂ) 0) • c j := by
  refine exists_delta_representation u ?_
  intro ψ hψ
  obtain ⟨χ, hχ⟩ := hdiv ψ hψ
  exact hmul ψ χ hχ

end

end GaloisForLFunctions.RHTower
