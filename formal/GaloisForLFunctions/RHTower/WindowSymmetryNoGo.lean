/-
Finite symmetry filter for line-centered windows.

The FE/reality Klein action has four visible maps on the `s`-plane.  On a positive
height line, only the identity and critical-line reflection preserve that height.
Thus after the window identity has consumed the reflection pairing, there is no
second geometric involution left inside the same window.
-/
import GaloisForLFunctions.RHTower.WindowRelation

namespace RHTower

open Complex

/-- The four maps generated by the functional equation and Schwarz reflection. -/
inductive FESymmetry where
  | id
  | fe
  | conj
  | mirror
  deriving DecidableEq

namespace FESymmetry

/-- Action of the FE/reality Klein maps on the `s`-plane. -/
noncomputable def act : FESymmetry → ℂ → ℂ
  | id => fun z => z
  | fe => fun z => 1 - z
  | conj => fun z => (starRingEnd ℂ) z
  | mirror => lineReflect

/-- Imaginary part under each FE/reality symmetry. -/
theorem act_im (g : FESymmetry) (z : ℂ) :
    (act g z).im =
      match g with
      | id => z.im
      | fe => -z.im
      | conj => -z.im
      | mirror => z.im := by
  cases g <;> simp [act, lineReflect]

/-- On a nonzero height line, the window-preserving FE/reality symmetries are exactly
the identity and critical-line reflection. -/
theorem preserves_height_line_iff {g : FESymmetry} {T : ℝ} (hT : T ≠ 0) :
    (∀ z : ℂ, z.im = T → (act g z).im = T) ↔ g = id ∨ g = mirror := by
  constructor
  · intro h
    cases g with
    | id => exact Or.inl rfl
    | fe =>
        have hz : (((T : ℂ) * I).im) = T := by simp
        have hgot := h ((T : ℂ) * I) hz
        simp [act] at hgot
        have hzero : T = 0 := by linarith
        exfalso
        exact hT hzero
    | conj =>
        have hz : (((T : ℂ) * I).im) = T := by simp
        have hgot := h ((T : ℂ) * I) hz
        simp [act] at hgot
        have hzero : T = 0 := by linarith
        exfalso
        exact hT hzero
    | mirror => exact Or.inr rfl
  · rintro (rfl | rfl) z hz
    · simp [act, hz]
    · simp [act, lineReflect, hz]

end FESymmetry

end RHTower
