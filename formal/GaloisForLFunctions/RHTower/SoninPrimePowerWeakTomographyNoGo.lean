import GaloisForLFunctions.RHTower.ApertureShiftCutoff
import GaloisForLFunctions.RHTower.SoninPrimePowerRegularization

/-!
# A common wavepacket separator for every retained prime-power dilation mode

The retained scales are all at least `4`.  Hence any logarithmic wavepacket supported in an
interval `[-log λ, log λ]` with `1 < λ` and `λ² < 4` has zero correlation with both
translation directions of every retained symmetric prime-power dilation observable.  The same
wavepacket has nonzero identity correlation whenever its squared norm is nonzero.

This is the exact matrix-coefficient obstruction to recovering the identity from the **linear
span** of the retained Chebyshev/QSP modes in either the weak or strong operator topology.  It
strengthens the earlier uniform/operator-norm zero-frequency obstruction and retires topology
weakening as a route to prime-power residual nondegeneracy.  It makes no claim about the
multiplicative algebra generated by those modes; the correction response is only linear, so
values on such products are not supplied by the residual family.
-/

open Set MeasureTheory Filter

namespace RHTower

noncomputable section

/-- Matrix coefficient of the retained symmetric prime-power logarithmic translation on a fixed
wavepacket. -/
def retainedPrimePowerSymmetricLogCorrelation
    (f : ℝ → ℂ) (pk : Nat.Primes × ℕ) : ℂ :=
  ∫ x, (starRingEnd ℂ) (f x) *
    (f (x + Real.log (soninPrimePowerScale pk)) +
      f (x - Real.log (soninPrimePowerScale pk)))

/-- Every retained prime-power symmetric logarithmic translation has zero matrix coefficient on
one common sufficiently narrow wavepacket.  The statement is pointwise-support based and needs
no limiting or spectral hypothesis. -/
theorem retainedPrimePower_symmetricLogCorrelation_eq_zero
    {lambda : ℝ} (hlambda : 1 < lambda) (hlambdaSq : lambda ^ 2 < 4)
    {f : ℝ → ℂ}
    (hf : Function.support f ⊆ Set.Icc (-Real.log lambda) (Real.log lambda))
    (pk : Nat.Primes × ℕ) :
    retainedPrimePowerSymmetricLogCorrelation f pk = 0 := by
  have hq : lambda ^ 2 < soninPrimePowerScale pk :=
    hlambdaSq.trans_le (four_le_soninPrimePowerScale pk)
  have hlambdaPos : 0 < lambda := zero_lt_one.trans hlambda
  have hlambdaSqPos : 0 < lambda ^ 2 := sq_pos_of_pos hlambdaPos
  have hqPos : 0 < soninPrimePowerScale pk := hlambdaSqPos.trans hq
  have hlog : 2 * Real.log lambda < Real.log (soninPrimePowerScale pk) := by
    calc
      2 * Real.log lambda = Real.log (lambda ^ 2) := by
        rw [Real.log_pow]
        norm_num
      _ < Real.log (soninPrimePowerScale pk) := Real.strictMonoOn_log
        (Set.mem_Ioi.mpr hlambdaSqPos) (Set.mem_Ioi.mpr hqPos) hq
  have hforward := intervalShiftProduct_eq_zero hf hlog
  have hreverse := intervalNegativeShiftProduct_eq_zero hf (neg_lt_neg hlog)
  rw [retainedPrimePowerSymmetricLogCorrelation]
  have hzero :
      (fun x : ℝ => (starRingEnd ℂ) (f x) *
        (f (x + Real.log (soninPrimePowerScale pk)) +
          f (x - Real.log (soninPrimePowerScale pk)))) = fun _ => 0 := by
    funext x
    rw [mul_add, hforward x]
    have hback : (starRingEnd ℂ) (f x) *
        f (x - Real.log (soninPrimePowerScale pk)) = 0 := by
      simpa only [sub_eq_add_neg] using hreverse x
    rw [hback, add_zero]
  rw [hzero]
  simp

/-- A nonzero self-correlation is separated from every retained symmetric prime-power mode by
the same compactly supported logarithmic wavepacket. -/
theorem retainedPrimePower_symmetricLogCorrelation_ne_selfCorrelation
    {lambda : ℝ} (hlambda : 1 < lambda) (hlambdaSq : lambda ^ 2 < 4)
    {f : ℝ → ℂ}
    (hf : Function.support f ⊆ Set.Icc (-Real.log lambda) (Real.log lambda))
    (hself : (∫ x, (starRingEnd ℂ) (f x) * f x) ≠ 0)
    (pk : Nat.Primes × ℕ) :
    retainedPrimePowerSymmetricLogCorrelation f pk ≠
      ∫ x, (starRingEnd ℂ) (f x) * f x := by
  rw [retainedPrimePower_symmetricLogCorrelation_eq_zero
    hlambda hlambdaSq hf pk]
  exact hself.symm

/-- No sequence of finite linear combinations of retained prime-power matrix coefficients can
converge to the identity coefficient on the separating wavepacket.  Any weak- or strong-operator
identity approximation would imply precisely this forbidden scalar convergence. -/
theorem not_tendsto_finite_retainedPrimePowerLogCorrelations_to_selfCorrelation
    {lambda : ℝ} (hlambda : 1 < lambda) (hlambdaSq : lambda ^ 2 < 4)
    {f : ℝ → ℂ}
    (hf : Function.support f ⊆ Set.Icc (-Real.log lambda) (Real.log lambda))
    (hself : (∫ x, (starRingEnd ℂ) (f x) * f x) ≠ 0)
    (s : ℕ → Finset (Nat.Primes × ℕ))
    (c : ℕ → (Nat.Primes × ℕ) → ℂ) :
    ¬ Tendsto
      (fun n => ∑ pk ∈ s n,
        c n pk * retainedPrimePowerSymmetricLogCorrelation f pk)
      atTop (nhds (∫ x, (starRingEnd ℂ) (f x) * f x)) := by
  have hzero : ∀ n : ℕ,
      (∑ pk ∈ s n,
        c n pk * retainedPrimePowerSymmetricLogCorrelation f pk) = 0 := by
    intro n
    simp_rw [retainedPrimePower_symmetricLogCorrelation_eq_zero
      hlambda hlambdaSq hf]
    simp
  intro hlimit
  have hlimitZero : Tendsto
      (fun n => ∑ pk ∈ s n,
        c n pk * retainedPrimePowerSymmetricLogCorrelation f pk)
      atTop (nhds 0) := by
    simpa only [hzero] using
      (tendsto_const_nhds : Tendsto (fun _ : ℕ => (0 : ℂ)) atTop (nhds 0))
  have heq : (0 : ℂ) = ∫ x, (starRingEnd ℂ) (f x) * f x :=
    tendsto_nhds_unique hlimitZero hlimit
  exact hself heq.symm

end

end RHTower
