import GaloisForLFunctions.RHTower.DissipativeQuantumReturnInformationTransition
import GaloisForLFunctions.RHTower.FiniteAtomicObserverTimeGapLaw

/-!
# Observer-time gap law for every finite contraction

Closed unitary dynamics are not required for the asymptotic return law.  Every
finite-dimensional contraction splits its state autocorrelation exactly into
a persistent peripheral characteristic function and a transient amplitude
that tends to zero.  The squared persistent record is therefore controlled
by the observer-time gap measure of the normalized peripheral spectrum,
scaled only by the surviving mass.

Thus finite dissipation can remove persistent observer weight, but it cannot
create a different asymptotic recurrence carrier.
-/

open Filter MeasureTheory
open scoped Topology

noncomputable section

namespace RHTower

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
  [CompleteSpace H] [FiniteDimensional ℂ H]

/-- Normalized observer spectrum of the unit-modulus peripheral modes of a
finite contraction. -/
def finiteContractionPeripheralObserverSpectrum
    (T : H →L[ℂ] H) (x : H) : Measure ℝ :=
  finiteAtomicObserverSpectrum
    (finiteContractionPeripheralWeight T x)
    (finiteContractionPeripheralPhase T)

theorem finiteContractionPeripheralObserverSpectrum_isProbabilityMeasure
    (T : H →L[ℂ] H) (x : H)
    (hpersistent : 0 < finiteContractionPersistentMass T x) :
    IsProbabilityMeasure
      (finiteContractionPeripheralObserverSpectrum T x) := by
  unfold finiteContractionPeripheralObserverSpectrum
  exact finiteAtomicObserverSpectrum_isProbabilityMeasure
    _ _
    (finiteContractionPeripheralWeight_nonneg T x hpersistent)
    (sum_finiteContractionPeripheralWeight T x hpersistent)

/-- Integer samples of the peripheral characteristic function are exactly
the normalized persistent Floquet return amplitude. -/
theorem charFun_finiteContractionPeripheralObserverSpectrum
    (T : H →L[ℂ] H) (x : H)
    (hpersistent : 0 < finiteContractionPersistentMass T x)
    (n : ℕ) :
    charFun (finiteContractionPeripheralObserverSpectrum T x) (n : ℝ) =
      weightedFloquetReturnAmplitude
        (finiteContractionPeripheralWeight T x)
        (finiteContractionPeripheralPhase T) n := by
  rw [finiteContractionPeripheralObserverSpectrum]
  rw [charFun_finiteAtomicObserverSpectrum _ _
    (finiteContractionPeripheralWeight_nonneg T x hpersistent)]
  unfold weightedFloquetReturnAmplitude
  apply Finset.sum_congr rfl
  intro i hi
  congr 2
  push_cast
  ring

/-- **Exact persistent/transient factorization.**  Every return amplitude of
every finite contraction is persistent mass times one characteristic
function plus a transient that tends to zero. -/
theorem finiteContraction_returnAmplitude_eq_peripheralCharFun_add_transient
    (T : H →L[ℂ] H) (hT : ‖T‖ ≤ 1) (x : H)
    (hpersistent : 0 < finiteContractionPersistentMass T x)
    (n : ℕ) :
    inner ℂ x ((T ^ n) x) =
      (finiteContractionPersistentMass T x : ℂ) *
        charFun (finiteContractionPeripheralObserverSpectrum T x) (n : ℝ) +
      finiteContractionTransientReturnAmplitude T x n := by
  rw [finiteContraction_returnAmplitude_eq_dissipativeWeighted
    T hT x hpersistent n]
  unfold dissipativeWeightedReturnAmplitude
  rw [charFun_finiteContractionPeripheralObserverSpectrum
    T x hpersistent n]

/-- After the exactly identified transient is removed, return fidelity is
persistent mass squared times the projective record generated by the
peripheral observer-time gap measure. -/
theorem finiteContraction_transientStrippedFidelity_eq_gapRecord
    (T : H →L[ℂ] H) (hT : ‖T‖ ≤ 1) (x : H)
    (hpersistent : 0 < finiteContractionPersistentMass T x)
    (n : ℕ) :
    Complex.normSq
      (inner ℂ x ((T ^ n) x) -
        finiteContractionTransientReturnAmplitude T x n) =
      finiteContractionPersistentMass T x ^ 2 *
        projectiveReturnRecord
          (finiteContractionPeripheralObserverSpectrum T x) (n : ℝ) := by
  rw [finiteContraction_returnAmplitude_eq_peripheralCharFun_add_transient
    T hT x hpersistent n]
  rw [add_sub_cancel_right]
  unfold projectiveReturnRecord
  rw [Complex.normSq_mul, Complex.normSq_ofReal]
  ring

/-- The peripheral observer-time gap measure is the complete invariant of
the persistent projective return record. -/
theorem finiteContraction_peripheralGapMeasure_complete
    (T : H →L[ℂ] H) (x : H)
    (hpersistent : 0 < finiteContractionPersistentMass T x)
    (mu : Measure ℝ) [IsProbabilityMeasure mu] :
    observerTimeGapMeasure
        (finiteContractionPeripheralObserverSpectrum T x) =
        observerTimeGapMeasure mu ↔
      ∀ t : ℝ,
        projectiveReturnRecord
          (finiteContractionPeripheralObserverSpectrum T x) t =
        projectiveReturnRecord mu t := by
  letI :
      IsProbabilityMeasure
        (finiteContractionPeripheralObserverSpectrum T x) :=
    finiteContractionPeripheralObserverSpectrum_isProbabilityMeasure
      T x hpersistent
  exact observerTimeGapMeasure_eq_iff_projectiveReturnRecord_eq _ _

end RHTower
