import GaloisForLFunctions.RHTower.CriticalDiscSchwarzCompleteness
import Mathlib.Analysis.Calculus.FDeriv.Mul
import Mathlib.Analysis.Calculus.FDeriv.RestrictScalars

/-!
# Nonlinear critical-disc Euler-unit orbit density

This file formalizes the step from tangent completeness to the additive group
generated by genuine degree-one Euler-unit increments.  Repetition is encoded
as natural-number addition in an `AddSubgroup`; no assertion is made that a
repeated local unit remains in the raw degree-one parameter locus.
-/

noncomputable section

namespace RHTower

open Complex Metric Set Filter Topology ComplexConjugate

variable {K : Type*} [TopologicalSpace K] [CompactSpace K]

/-- The Banach-algebra Mobius flux `a q / (1-aq)` on a compact carrier. -/
def compactMobiusFlux (q : C(K, ℂ)) (a : ℂ) : C(K, ℂ) :=
  (a • q) * Ring.inverse (1 - a • q)

/-- The derivative of the compact Mobius flux at the actual source `a=1`. -/
theorem hasDerivAt_compactMobiusFlux_one
    (q : C(K, ℂ)) (hq : ‖q‖ < 1) :
    HasDerivAt (compactMobiusFlux q)
      (Ring.inverse (1 - q) * q * Ring.inverse (1 - q)) 1 := by
  let u : C(K, ℂ)ˣ := Units.oneSub q hq
  have hu : (u : C(K, ℂ)) = 1 - q := by rfl
  have hnum : HasDerivAt (fun a : ℂ ↦ a • q) q 1 := by
    simpa using (hasDerivAt_id (1 : ℂ)).smul_const q
  have hden : HasDerivAt (fun a : ℂ ↦ 1 - a • q) (-q) 1 := by
    simpa using hnum.const_sub 1
  have hinvBase : HasFDerivAt Ring.inverse
      (-ContinuousLinearMap.mulLeftRight ℂ C(K, ℂ) (↑u⁻¹) (↑u⁻¹))
      (1 - (1 : ℂ) • q) := by
    simpa only [one_smul, ← hu] using
      (hasFDerivAt_ringInverse (𝕜 := ℂ) u)
  have hinv := hinvBase.comp (1 : ℂ) hden.hasFDerivAt
  have hprod := hnum.hasFDerivAt.mul hinv
  show HasFDerivAt (compactMobiusFlux q)
    (ContinuousLinearMap.toSpanSingleton ℂ
      (Ring.inverse (1 - q) * q * Ring.inverse (1 - q))) 1
  convert! hprod using 1
  ext k
  simp [u, ContinuousLinearMap.mulLeftRight_apply,
    NormedRing.inverse_one_sub q hq]
  have hunit : (↑u⁻¹ : C(K, ℂ)) * (1 - q) = 1 := by
    rw [← hu]
    exact Units.inv_mul u
  have hk := congrArg (fun f : C(K, ℂ) ↦ f k) hunit
  simp at hk
  let v : ℂ := (↑(u⁻¹) : C(K, ℂ)) k
  change v * q k * v = q k * (v * q k * v) + v * q k
  change v * (1 - q k) = 1 at hk
  linear_combination (v * q k) * hk

/-- The compact degree-one local Euler logarithmic flux. -/
def compactDegreeOneEulerLocalFlux
    (q : C(K, ℂ)) (p : ℕ) (a : ℂ) : C(K, ℂ) :=
  (Real.log p : ℂ) • compactMobiusFlux q a

/-- Its exact actual-source tangent, expressed in the compact Banach algebra. -/
def compactEulerTangentFromQ (q : C(K, ℂ)) (p : ℕ) : C(K, ℂ) :=
  (Real.log p : ℂ) •
    (Ring.inverse (1 - q) * q * Ring.inverse (1 - q))

theorem hasDerivAt_compactDegreeOneEulerLocalFlux_one
    (q : C(K, ℂ)) (p : ℕ) (hq : ‖q‖ < 1) :
    HasDerivAt (compactDegreeOneEulerLocalFlux q p)
      (compactEulerTangentFromQ q p) 1 := by
  exact (hasDerivAt_compactMobiusFlux_one q hq).const_smul (Real.log p : ℂ)

/-- The genuine degree-one increment from the actual Euler parameter `a=1`. -/
def compactEulerUnitIncrement
    (q : C(K, ℂ)) (p : ℕ) (b : ℂ) : C(K, ℂ) :=
  compactDegreeOneEulerLocalFlux q p (1 + b) -
    compactDegreeOneEulerLocalFlux q p 1

omit [CompactSpace K] in
@[simp]
theorem compactEulerUnitIncrement_zero (q : C(K, ℂ)) (p : ℕ) :
    compactEulerUnitIncrement q p 0 = 0 := by
  simp [compactEulerUnitIncrement]

theorem hasDerivAt_compactEulerUnitIncrement_zero
    (q : C(K, ℂ)) (p : ℕ) (hq : ‖q‖ < 1) :
    HasDerivAt (compactEulerUnitIncrement q p)
      (compactEulerTangentFromQ q p) 0 := by
  have hshift : HasDerivAt (fun b : ℂ ↦ 1 + b) 1 0 := by
    simpa using! (hasDerivAt_const (x := (0 : ℂ)) (c := (1 : ℂ))).add
      (hasDerivAt_id (0 : ℂ))
  have houter : HasFDerivAt (compactDegreeOneEulerLocalFlux q p)
      (ContinuousLinearMap.toSpanSingleton ℂ (compactEulerTangentFromQ q p))
      (1 + 0) := by
    simpa using
      (hasDerivAt_compactDegreeOneEulerLocalFlux_one q p hq).hasFDerivAt
  have hcomp := houter.comp 0 hshift.hasFDerivAt
  have hsub := hcomp.sub_const (compactDegreeOneEulerLocalFlux q p 1)
  show HasFDerivAt (compactEulerUnitIncrement q p)
    (ContinuousLinearMap.toSpanSingleton ℂ (compactEulerTangentFromQ q p)) 0
  convert! hsub using 1
  ext c
  simp

/-- The FE-paired genuine local increment. -/
def compactEulerUnitFEIncrement
    (q : C(K, ℂ)) (tau : C(K, K)) (p : ℕ) (b : ℂ) : C(K, ℂ) :=
  compactEulerUnitIncrement q p b -
    compactEulerUnitIncrement (q.comp tau) p b

/-- The corresponding paired Banach-algebra tangent. -/
def compactEulerFETangentFromQ
    (q : C(K, ℂ)) (tau : C(K, K)) (p : ℕ) : C(K, ℂ) :=
  compactEulerTangentFromQ q p - compactEulerTangentFromQ (q.comp tau) p

omit [CompactSpace K] in
@[simp]
theorem compactEulerUnitFEIncrement_zero
    (q : C(K, ℂ)) (tau : C(K, K)) (p : ℕ) :
    compactEulerUnitFEIncrement q tau p 0 = 0 := by
  simp [compactEulerUnitFEIncrement]

theorem norm_comp_lt_one
    (q : C(K, ℂ)) (tau : C(K, K)) (hq : ‖q‖ < 1) :
  ‖q.comp tau‖ < 1 := by
  apply lt_of_le_of_lt ?_ hq
  apply (ContinuousMap.norm_le _ (norm_nonneg q)).2
  intro k
  exact ContinuousMap.norm_coe_le_norm q (tau k)

theorem hasDerivAt_compactEulerUnitFEIncrement_zero
    (q : C(K, ℂ)) (tau : C(K, K)) (p : ℕ) (hq : ‖q‖ < 1) :
    HasDerivAt (compactEulerUnitFEIncrement q tau p)
      (compactEulerFETangentFromQ q tau p) 0 := by
  exact (hasDerivAt_compactEulerUnitIncrement_zero q p hq).sub
    (hasDerivAt_compactEulerUnitIncrement_zero (q.comp tau) p
      (norm_comp_lt_one q tau hq))

theorem ringInverse_one_sub_apply
    (q : C(K, ℂ)) (hq : ‖q‖ < 1) (k : K) :
    Ring.inverse (1 - q) k = (1 - q k)⁻¹ := by
  rw [NormedRing.inverse_one_sub q hq]
  let u : C(K, ℂ)ˣ := Units.oneSub q hq
  have hmul : (↑(u⁻¹) : C(K, ℂ)) k * (1 - q k) = 1 := by
    have hunit : (↑(u⁻¹) : C(K, ℂ)) * (u : C(K, ℂ)) = 1 := Units.inv_mul u
    have hk := congrArg (fun f : C(K, ℂ) ↦ f k) hunit
    simpa [u] using hk
  exact (mul_eq_one_iff_eq_inv₀ (right_ne_zero_of_mul_eq_one hmul)).mp hmul

theorem compactEulerTangentFromQ_comp
    (q : C(K, ℂ)) (tau : C(K, K)) (p : ℕ) (hq : ‖q‖ < 1) :
    compactEulerTangentFromQ (q.comp tau) p =
      (compactEulerTangentFromQ q p).comp tau := by
  ext k
  simp only [compactEulerTangentFromQ, ContinuousMap.smul_apply,
    ContinuousMap.mul_apply, ContinuousMap.comp_apply]
  rw [ringInverse_one_sub_apply (q.comp tau) (norm_comp_lt_one q tau hq),
    ringInverse_one_sub_apply q hq]
  rfl

theorem compactEulerTangentFromQ_exponential
    (s : C(K, ℂ)) (p : ℕ) :
    compactEulerTangentFromQ
        (compactExponentialTest s (Real.log p)) p =
      compactPrimeEulerUnitTangent s p := by
  unfold compactEulerTangentFromQ compactPrimeEulerUnitTangent compactLambertKernel
  ring

theorem compactEulerFETangentFromQ_exponential
    (s : C(K, ℂ)) (tau : C(K, K)) (p : ℕ)
    (hq : ‖compactExponentialTest s (Real.log p)‖ < 1) :
    compactEulerFETangentFromQ
        (compactExponentialTest s (Real.log p)) tau p =
      compactPrimeEulerUnitFETangent s tau p := by
  unfold compactEulerFETangentFromQ compactPrimeEulerUnitFETangent
  rw [compactEulerTangentFromQ_comp _ _ _ hq,
    compactEulerTangentFromQ_exponential]

/-- The critical disc gives a uniform Neumann radius for every prime source. -/
theorem criticalDisc_compactExponentialTest_norm_lt_one
    {r : ℝ} (hr : r < 1 / 2) (p : Nat.Primes) :
    ‖compactExponentialTest (criticalDiscCoordinate r) (Real.log (p : ℝ))‖ < 1 := by
  have hdelta : 0 < 1 / 2 - r := by linarith
  have hlog : 0 < Real.log ((p : Nat.Primes) : ℝ) :=
    Real.log_pos (by exact_mod_cast p.prop.one_lt)
  apply norm_compactExponentialTest_lt_one_of_re_pos
    (criticalDiscCoordinate r) _
    (Real.log (p : ℝ) * (1 / 2 - r)) (mul_pos hlog hdelta)
  intro k
  have hk := criticalDiscCoordinate_re_lower k
  simp only [mul_re, ofReal_re, ofReal_im, zero_mul, sub_zero]
  exact mul_le_mul_of_nonneg_left hk hlog.le

/-- The derivative of the genuine FE-paired degree-one Euler increment on a
critical disc is exactly the paired actual-source tangent used by the
completeness theorem. -/
theorem hasDerivAt_criticalDiscEulerUnitFEIncrement_zero
    {r : ℝ} (hr : r < 1 / 2) (p : Nat.Primes) :
    HasDerivAt
      (compactEulerUnitFEIncrement
        (compactExponentialTest (criticalDiscCoordinate r) (Real.log (p : ℝ)))
        (criticalDiscReflection r) (p : ℕ))
      (compactPrimeEulerUnitFETangent
        (criticalDiscCoordinate r) (criticalDiscReflection r) (p : ℕ)) 0 := by
  have hq := criticalDisc_compactExponentialTest_norm_lt_one hr p
  have hder := hasDerivAt_compactEulerUnitFEIncrement_zero
    (compactExponentialTest (criticalDiscCoordinate r) (Real.log (p : ℝ)))
    (criticalDiscReflection r) (p : ℕ) hq
  convert hder using 1
  exact (compactEulerFETangentFromQ_exponential
    (criticalDiscCoordinate r) (criticalDiscReflection r) (p : ℕ) hq).symm

/-- Differentiability gives the exact repetition limit used by the generated
additive gauge group. -/
theorem HasDerivAt.tendsto_nat_nsmul_inv
    {𝕜 E : Type*} [RCLike 𝕜]
    [NormedAddCommGroup E] [NormedSpace 𝕜 E]
    (f : 𝕜 → E) (w : E) (h : HasDerivAt f w 0) (h0 : f 0 = 0) :
    Tendsto (fun n : ℕ ↦ (n + 1) • f (((n + 1 : ℕ) : 𝕜)⁻¹))
      atTop (nhds w) := by
  have ht0 : Tendsto (fun n : ℕ ↦ (((n + 1 : ℕ) : 𝕜)⁻¹))
      atTop (nhds 0) := by
    simpa [one_div, Nat.cast_add, Nat.cast_one] using
      (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := 𝕜))
  have hne : ∀ n : ℕ, (((n + 1 : ℕ) : 𝕜)⁻¹) ≠ 0 := by
    intro n
    exact inv_ne_zero (Nat.cast_ne_zero.mpr (by omega))
  have ht : Tendsto (fun n : ℕ ↦ (((n + 1 : ℕ) : 𝕜)⁻¹))
      atTop (nhdsWithin 0 ({0} : Set 𝕜)ᶜ) := by
    rw [tendsto_nhdsWithin_iff]
    exact ⟨ht0, Eventually.of_forall (fun n ↦ hne n)⟩
  have hslope := h.tendsto_slope_zero.comp ht
  convert hslope using 1
  funext n
  simp only [Function.comp_apply, zero_add, h0, sub_zero, inv_inv]
  exact (Nat.cast_smul_eq_nsmul 𝕜 (n + 1) _).symm

theorem HasDerivAt.comp_const_mul
    {𝕜 E : Type*} [RCLike 𝕜]
    [NormedAddCommGroup E] [NormedSpace 𝕜 E]
    (f : 𝕜 → E) (w : E) (h : HasDerivAt f w 0) (c : 𝕜) :
    HasDerivAt (fun t : 𝕜 ↦ f (c * t)) (c • w) 0 := by
  have hinner : HasDerivAt (fun t : 𝕜 ↦ c * t) c 0 := by
    simpa using (hasDerivAt_id (0 : 𝕜)).const_mul c
  have houter : HasFDerivAt f
      (ContinuousLinearMap.toSpanSingleton 𝕜 w) (c * 0) := by
    simpa using h.hasFDerivAt
  have hout := houter.comp (0 : 𝕜) hinner.hasFDerivAt
  show HasFDerivAt (fun t : 𝕜 ↦ f (c * t))
    (ContinuousLinearMap.toSpanSingleton 𝕜 (c • w)) 0
  convert! hout using 1
  ext
  simp [smul_smul, mul_comm]

/-- Restrict a complex Banach-valued derivative to the real parameter axis. -/
theorem HasDerivAt.restrict_real
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (f : ℂ → E) (w : E) (h : HasDerivAt f w 0) :
    HasDerivAt (fun x : ℝ ↦ f x) w 0 := by
  have houter : HasFDerivAt f
      ((ContinuousLinearMap.toSpanSingleton ℂ w).restrictScalars ℝ)
      (Complex.ofRealCLM 0) := by
    simpa using h.hasFDerivAt.restrictScalars ℝ
  have hcomp := houter.comp (0 : ℝ) Complex.ofRealCLM.hasFDerivAt
  show HasFDerivAt (fun x : ℝ ↦ f x)
    (ContinuousLinearMap.toSpanSingleton ℝ w) 0
  convert! hcomp using 1

/-- Every scalar tangent direction lies in the closure of the additive group
generated by the genuine increments.  Natural-number multiplication is the
formal record of repeated use of the same degree-one local unit. -/
theorem smul_deriv_mem_incrementGroup_topologicalClosure
    {𝕜 E : Type*} [RCLike 𝕜]
    [NormedAddCommGroup E] [NormedSpace 𝕜 E]
    (f : 𝕜 → E) (w : E) (h : HasDerivAt f w 0) (h0 : f 0 = 0)
    (c : 𝕜) :
    c • w ∈ (AddSubgroup.closure (Set.range f)).topologicalClosure := by
  let g : 𝕜 → E := fun t ↦ f (c * t)
  have hg : HasDerivAt g (c • w) 0 := by
    simpa [g] using
      (HasDerivAt.comp_const_mul (f := f) (w := w) h c)
  have hg0 : g 0 = 0 := by simp [g, h0]
  have hlim : Tendsto
      (fun n : ℕ ↦ (n + 1) • g (((n + 1 : ℕ) : 𝕜)⁻¹))
      atTop (nhds (c • w)) :=
    HasDerivAt.tendsto_nat_nsmul_inv (f := g) (w := c • w) hg hg0
  apply (AddSubgroup.closure (Set.range f)).isClosed_topologicalClosure.mem_of_tendsto hlim
  filter_upwards with n
  apply (AddSubgroup.closure (Set.range f)).le_topologicalClosure
  apply (AddSubgroup.closure (Set.range f)).nsmul_mem
  apply AddSubgroup.subset_closure
  exact ⟨c * (((n + 1 : ℕ) : 𝕜)⁻¹), rfl⟩

/-- Local form: an arbitrarily small parameter ball already generates every
scalar multiple of the tangent in topological closure. -/
theorem smul_deriv_mem_localIncrementGroup_topologicalClosure
    {𝕜 E : Type*} [RCLike 𝕜]
    [NormedAddCommGroup E] [NormedSpace 𝕜 E]
    (f : 𝕜 → E) (w : E) (h : HasDerivAt f w 0) (h0 : f 0 = 0)
    (c : 𝕜) {epsilon : ℝ} (hepsilon : 0 < epsilon) :
    c • w ∈
      (AddSubgroup.closure (f '' ball (0 : 𝕜) epsilon)).topologicalClosure := by
  let g : 𝕜 → E := fun t ↦ f (c * t)
  have hg : HasDerivAt g (c • w) 0 := by
    simpa [g] using
      (HasDerivAt.comp_const_mul (f := f) (w := w) h c)
  have hg0 : g 0 = 0 := by simp [g, h0]
  have hlim : Tendsto
      (fun n : ℕ ↦ (n + 1) • g (((n + 1 : ℕ) : 𝕜)⁻¹))
      atTop (nhds (c • w)) :=
    HasDerivAt.tendsto_nat_nsmul_inv (f := g) (w := c • w) hg hg0
  have hparam : Tendsto
      (fun n : ℕ ↦ c * (((n + 1 : ℕ) : 𝕜)⁻¹)) atTop (nhds 0) := by
    have hinv : Tendsto (fun n : ℕ ↦ (((n + 1 : ℕ) : 𝕜)⁻¹))
        atTop (nhds 0) := by
      simpa [one_div, Nat.cast_add, Nat.cast_one] using
        (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := 𝕜))
    simpa using (tendsto_const_nhds.mul hinv)
  have hevent : ∀ᶠ n in atTop,
      c * (((n + 1 : ℕ) : 𝕜)⁻¹) ∈ ball 0 epsilon :=
    hparam.eventually (Metric.ball_mem_nhds 0 hepsilon)
  apply (AddSubgroup.closure
    (f '' ball (0 : 𝕜) epsilon)).isClosed_topologicalClosure.mem_of_tendsto hlim
  filter_upwards [hevent] with n hn
  apply (AddSubgroup.closure
    (f '' ball (0 : 𝕜) epsilon)).le_topologicalClosure
  apply (AddSubgroup.closure
    (f '' ball (0 : 𝕜) epsilon)).nsmul_mem
  apply AddSubgroup.subset_closure
  exact ⟨c * (((n + 1 : ℕ) : 𝕜)⁻¹), hn, rfl⟩

/-- Prime exponentials on a critical disc are Schwarz fixed. -/
theorem criticalSchwarzTransform_compactExponentialTest_criticalDisc
    (r : ℝ) (p : ℕ) :
    criticalSchwarzTransform r
        (compactExponentialTest (criticalDiscCoordinate r) (Real.log p)) =
      compactExponentialTest (criticalDiscCoordinate r) (Real.log p) := by
  ext z
  rw [criticalSchwarzTransform_apply, compactExponentialTest_apply,
    compactExponentialTest_apply, ← Complex.exp_conj]
  congr 1
  have hlog : conj (Real.log p : ℂ) = (Real.log p : ℂ) :=
    RCLike.conj_ofReal _
  rw [map_mul, map_neg, hlog, criticalDiscCoordinate_conjugation]
  simp

/-- Schwarz conjugation commutes with precomposition by critical reflection. -/
theorem criticalSchwarzTransform_comp_criticalDiscReflection
    (r : ℝ) (f : C(CriticalClosedDisc r, ℂ)) :
    criticalSchwarzTransform r (f.comp (criticalDiscReflection r)) =
      (criticalSchwarzTransform r f).comp (criticalDiscReflection r) := by
  ext z
  simp [criticalSchwarzTransform, criticalDiscConjugation,
    criticalDiscReflection]

/-- A Mobius flux is Schwarz fixed when its carrier and scalar parameter are. -/
theorem criticalSchwarzTransform_compactMobiusFlux
    {r : ℝ} {q : C(CriticalClosedDisc r, ℂ)}
    (hq : criticalSchwarzTransform r q = q) {a : ℂ} (ha : conj a = a) :
    criticalSchwarzTransform r (compactMobiusFlux q a) =
      compactMobiusFlux q a := by
  unfold compactMobiusFlux
  rw [criticalSchwarzTransform_mul, criticalSchwarzTransform_smul,
    criticalSchwarzTransform_ringInverse,
    criticalSchwarzTransform_sub, criticalSchwarzTransform_one,
    criticalSchwarzTransform_smul, ha, hq]

/-- Every real-parameter FE-paired degree-one increment on a critical disc is
Schwarz fixed. -/
theorem criticalSchwarzTransform_criticalDisc_realEulerUnitFEIncrement
    (r : ℝ) (p : ℕ) (b : ℝ) :
    criticalSchwarzTransform r
      (compactEulerUnitFEIncrement
        (compactExponentialTest (criticalDiscCoordinate r) (Real.log p))
        (criticalDiscReflection r) p b) =
      compactEulerUnitFEIncrement
        (compactExponentialTest (criticalDiscCoordinate r) (Real.log p))
        (criticalDiscReflection r) p b := by
  let q := compactExponentialTest (criticalDiscCoordinate r) (Real.log p)
  have hq : criticalSchwarzTransform r q = q :=
    criticalSchwarzTransform_compactExponentialTest_criticalDisc r p
  have hqref : criticalSchwarzTransform r (q.comp (criticalDiscReflection r)) =
      q.comp (criticalDiscReflection r) := by
    rw [criticalSchwarzTransform_comp_criticalDiscReflection, hq]
  have hreal (a : ℝ) : conj (a : ℂ) = (a : ℂ) := RCLike.conj_ofReal a
  have hflux (q' : C(CriticalClosedDisc r, ℂ))
      (hq' : criticalSchwarzTransform r q' = q') (a : ℝ) :
      criticalSchwarzTransform r (compactDegreeOneEulerLocalFlux q' p a) =
        compactDegreeOneEulerLocalFlux q' p a := by
    unfold compactDegreeOneEulerLocalFlux
    rw [criticalSchwarzTransform_smul]
    have hlog : conj (Real.log p : ℂ) = (Real.log p : ℂ) :=
      RCLike.conj_ofReal _
    rw [hlog, criticalSchwarzTransform_compactMobiusFlux hq' (hreal a)]
  unfold compactEulerUnitFEIncrement compactEulerUnitIncrement
  have hqb : criticalSchwarzTransform r
      (compactDegreeOneEulerLocalFlux q p (1 + (b : ℂ))) =
      compactDegreeOneEulerLocalFlux q p (1 + (b : ℂ)) := by
    simpa using hflux q hq (1 + b)
  have hqone : criticalSchwarzTransform r
      (compactDegreeOneEulerLocalFlux q p 1) =
      compactDegreeOneEulerLocalFlux q p 1 := by
    simpa using hflux q hq 1
  have hrefb : criticalSchwarzTransform r
      (compactDegreeOneEulerLocalFlux (q.comp (criticalDiscReflection r)) p
        (1 + (b : ℂ))) =
      compactDegreeOneEulerLocalFlux (q.comp (criticalDiscReflection r)) p
        (1 + (b : ℂ)) := by
    simpa using hflux (q.comp (criticalDiscReflection r)) hqref (1 + b)
  have hrefone : criticalSchwarzTransform r
      (compactDegreeOneEulerLocalFlux (q.comp (criticalDiscReflection r)) p 1) =
      compactDegreeOneEulerLocalFlux (q.comp (criticalDiscReflection r)) p 1 := by
    simpa using hflux (q.comp (criticalDiscReflection r)) hqref 1
  rw [criticalSchwarzTransform_sub, criticalSchwarzTransform_sub,
    criticalSchwarzTransform_sub, hqb, hqone, hrefb, hrefone]

/-- The real local FE Euler-increment generators surviving an arbitrary finite
prime deletion. -/
def criticalDiscRealEulerIncrementGenerators
    (r : ℝ) (S : Finset Nat.Primes) (epsilon : ℝ) :
    Set C(CriticalClosedDisc r, ℂ) :=
  {g | ∃ p : {p : Nat.Primes // p ∉ S},
    ∃ b ∈ ball (0 : ℝ) epsilon,
      g = compactEulerUnitFEIncrement
        (compactExponentialTest (criticalDiscCoordinate r)
          (Real.log ((p : Nat.Primes) : ℝ)))
        (criticalDiscReflection r) ((p : Nat.Primes) : ℕ) b}

/-- Additive group generated by the genuine degree-one real local increments. -/
def criticalDiscRealEulerIncrementGroup
    (r : ℝ) (S : Finset Nat.Primes) (epsilon : ℝ) :
    AddSubgroup C(CriticalClosedDisc r, ℂ) :=
  AddSubgroup.closure (criticalDiscRealEulerIncrementGenerators r S epsilon)

/-- Every real scalar multiple of every retained paired Euler tangent lies in
the closure of the local generated increment group. -/
theorem real_smul_tangent_mem_criticalDiscRealEulerIncrementGroup_closure
    {r epsilon : ℝ} (hr : r < 1 / 2) (hepsilon : 0 < epsilon)
    (S : Finset Nat.Primes) (p : {p : Nat.Primes // p ∉ S}) (c : ℝ) :
    c • compactPrimeEulerUnitFETangent
        (criticalDiscCoordinate r) (criticalDiscReflection r)
        ((p : Nat.Primes) : ℕ) ∈
      (criticalDiscRealEulerIncrementGroup r S epsilon).topologicalClosure := by
  let DeltaC : ℂ → C(CriticalClosedDisc r, ℂ) :=
    compactEulerUnitFEIncrement
      (compactExponentialTest (criticalDiscCoordinate r)
        (Real.log ((p : Nat.Primes) : ℝ)))
      (criticalDiscReflection r) ((p : Nat.Primes) : ℕ)
  let DeltaR : ℝ → C(CriticalClosedDisc r, ℂ) := fun b ↦ DeltaC b
  let w : C(CriticalClosedDisc r, ℂ) :=
    compactPrimeEulerUnitFETangent
      (criticalDiscCoordinate r) (criticalDiscReflection r)
      ((p : Nat.Primes) : ℕ)
  have hcomplex : HasDerivAt DeltaC w 0 := by
    simpa [DeltaC, w] using
      hasDerivAt_criticalDiscEulerUnitFEIncrement_zero hr (p : Nat.Primes)
  have hreal : HasDerivAt DeltaR w 0 := by
    simpa [DeltaR] using
      (HasDerivAt.restrict_real (f := DeltaC) (w := w) hcomplex)
  have hzero : DeltaR 0 = 0 := by simp [DeltaR, DeltaC]
  have hind := smul_deriv_mem_localIncrementGroup_topologicalClosure
    DeltaR w hreal hzero c hepsilon
  apply (AddSubgroup.topologicalClosure_mono ?_) hind
  apply AddSubgroup.closure_mono
  rintro g ⟨b, hb, rfl⟩
  exact ⟨p, b, hb, rfl⟩

/-- The real span of the retained paired tangents is contained in the closed
generated Euler-increment group. -/
theorem realSpan_tangents_le_criticalDiscRealEulerIncrementGroup_closure
    {r epsilon : ℝ} (hr : r < 1 / 2) (hepsilon : 0 < epsilon)
    (S : Finset Nat.Primes) :
    (Submodule.span ℝ
        (Set.range fun p : {p : Nat.Primes // p ∉ S} ↦
          compactPrimeEulerUnitFETangent
            (criticalDiscCoordinate r) (criticalDiscReflection r)
            (p : Nat.Primes)) : Set C(CriticalClosedDisc r, ℂ)) ⊆
      ((criticalDiscRealEulerIncrementGroup r S epsilon).topologicalClosure :
        Set C(CriticalClosedDisc r, ℂ)) := by
  intro x hx
  have hstrong : ∀ c : ℝ,
      c • x ∈ (criticalDiscRealEulerIncrementGroup r S epsilon).topologicalClosure := by
    refine Submodule.span_induction (p := fun y _ ↦ ∀ c : ℝ,
      c • y ∈ (criticalDiscRealEulerIncrementGroup r S epsilon).topologicalClosure)
      ?_ ?_ ?_ ?_ hx
    · rintro y ⟨p, rfl⟩ c
      exact real_smul_tangent_mem_criticalDiscRealEulerIncrementGroup_closure
        hr hepsilon S p c
    · intro c
      simp
    · intro y z hy hz iy iz c
      rw [smul_add]
      exact AddSubgroup.add_mem _ (iy c) (iz c)
    · intro a y hy iy c
      rw [smul_smul]
      exact iy (c * a)
  simpa using! hstrong 1

/-- Full nonlinear critical-disc conclusion.  Every analytic FE-odd,
Schwarz-real target on a smaller critical disc lies in the closure of the
additive group generated by arbitrarily small real, paired, degree-one Euler
increments, even after deleting any finite set of primes. -/
theorem criticalDisc_analytic_odd_schwarz_mem_realEulerIncrementGroup_closure
    (f : ℂ → ℂ) {r₀ r₁ epsilon : ℝ}
    (hr₀ : 0 ≤ r₀) (hr01 : r₀ < r₁) (hr1 : r₁ < 1 / 2)
    (hepsilon : 0 < epsilon)
    (hf : DiffContOnCl ℂ f (ball (1 / 2 : ℂ) r₁))
    (hodd : ∀ z ∈ closedBall (1 / 2 : ℂ) r₀, f (1 - z) = -f z)
    (hschwarz : ∀ z : ℂ, f (conj z) = conj (f z))
    (S : Finset Nat.Primes) :
    criticalDiscRestriction f r₀
        (hf.continuousOn_ball.mono (Metric.closedBall_subset_closedBall hr01.le)) ∈
      (criticalDiscRealEulerIncrementGroup r₀ S epsilon).topologicalClosure := by
  have hspan := criticalDisc_analytic_odd_schwarz_mem_realClosedSpan_compl_finset
    f hr₀ hr01 hr1 hf hodd hschwarz S
  have hspan' : criticalDiscRestriction f r₀
      (hf.continuousOn_ball.mono (Metric.closedBall_subset_closedBall hr01.le)) ∈
      closure (↑(Submodule.span ℝ
        (Set.range fun p : {p : Nat.Primes // p ∉ S} ↦
          compactPrimeEulerUnitFETangent
            (criticalDiscCoordinate r₀) (criticalDiscReflection r₀)
            (p : Nat.Primes))) : Set C(CriticalClosedDisc r₀, ℂ)) := hspan
  exact (closure_minimal
    (realSpan_tangents_le_criticalDiscRealEulerIncrementGroup_closure
      (hr01.trans hr1) hepsilon S)
    (criticalDiscRealEulerIncrementGroup r₀ S epsilon).isClosed_topologicalClosure) hspan'

/-- Positive quotient classification: on the analytic FE-odd Schwarz-real
regular-germ fiber, every continuous reader invariant under finite real Euler
increments is exactly its value at the zero regular germ.  Equivalently, this
fiber has a one-point maximal continuous quotient under the generated action. -/
theorem criticalDisc_continuous_finiteUnitInvariant_eq_base
    {r₀ r₁ epsilon : ℝ} (S : Finset Nat.Primes)
    {Y : Type*} [TopologicalSpace Y] [T2Space Y]
    (A : C(CriticalClosedDisc r₀, ℂ) → Y) (hA : Continuous A)
    (hinvariant : ∀ x g,
      g ∈ criticalDiscRealEulerIncrementGroup r₀ S epsilon →
      A (x + g) = A x)
    (f : ℂ → ℂ)
    (hr₀ : 0 ≤ r₀) (hr01 : r₀ < r₁) (hr1 : r₁ < 1 / 2)
    (hepsilon : 0 < epsilon)
    (hf : DiffContOnCl ℂ f (ball (1 / 2 : ℂ) r₁))
    (hodd : ∀ z ∈ closedBall (1 / 2 : ℂ) r₀, f (1 - z) = -f z)
    (hschwarz : ∀ z : ℂ, f (conj z) = conj (f z)) :
    A (criticalDiscRestriction f r₀
      (hf.continuousOn_ball.mono (Metric.closedBall_subset_closedBall hr01.le))) = A 0 := by
  let G := criticalDiscRealEulerIncrementGroup r₀ S epsilon
  let target := criticalDiscRestriction f r₀
    (hf.continuousOn_ball.mono (Metric.closedBall_subset_closedBall hr01.le))
  have htarget : target ∈ G.topologicalClosure := by
    simpa [G, target] using
      criticalDisc_analytic_odd_schwarz_mem_realEulerIncrementGroup_closure
        f hr₀ hr01 hr1 hepsilon hf hodd hschwarz S
  have hG : (↑G : Set C(CriticalClosedDisc r₀, ℂ)) ⊆ {x | A x = A 0} := by
    intro g hg
    simpa using hinvariant 0 g hg
  have hclosed : IsClosed {x : C(CriticalClosedDisc r₀, ℂ) | A x = A 0} :=
    isClosed_eq hA continuous_const
  exact (closure_minimal hG hclosed) htarget

end RHTower
