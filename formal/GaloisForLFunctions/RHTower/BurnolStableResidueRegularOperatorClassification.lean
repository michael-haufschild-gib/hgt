import GaloisForLFunctions.RHTower.BurnolGammaSteinCollarKernel

/-!
# Regular Gamma--Stein operators on the stable Burnol residue line

The stable first-wall residue has logarithmic profile `phi(u) = exp(-u/2)`.  It is killed by the
Stein generator `A = d/du + 1/2`, while translation by `L` acts by the scalar `exp(-L/2)`.
Consequently every finite expression generated by scalars, `A`, translations, addition, and
composition acts by one scalar on the entire stable residue line.

This gives an exact no-go theorem for a source-blind regular annihilator: such an expression either
has zero scalar gain and erases every residue coefficient, or has nonzero gain and is
coefficient-faithful but cannot annihilate the carrier.  The result is unconditional and does not
use Xi zeros, landing, critical-line placement, or RH.
-/

open Real

noncomputable section

namespace RHTower

/-- Stable logarithmic profile of the Burnol first-wall residue. -/
def burnolStableResidueProfile (u : ℝ) : ℝ := Real.exp (-u / 2)

/-- A residue coefficient multiplying the fixed stable profile. -/
def burnolStableResidueCarrier (c : ℝ) : ℝ → ℝ :=
  fun u => c * burnolStableResidueProfile u

theorem hasDerivAt_burnolStableResidueProfile (u : ℝ) :
    HasDerivAt burnolStableResidueProfile
      (-(1 / 2) * burnolStableResidueProfile u) u := by
  have hlinear : HasDerivAt (fun v : ℝ => -v / 2) (-(1 / 2)) u := by
    exact ((hasDerivAt_id u).neg.div_const 2).congr_deriv (by ring)
  change HasDerivAt (fun v : ℝ => Real.exp (-v / 2))
    (-(1 / 2) * Real.exp (-u / 2)) u
  exact hlinear.exp.congr_deriv (by ring)

/-- The stable profile is the zero mode of the Gamma--Stein generator. -/
theorem burnolSteinA_stableResidueProfile (u : ℝ) :
    burnolSteinA burnolStableResidueProfile u = 0 := by
  rw [burnolSteinA, (hasDerivAt_burnolStableResidueProfile u).deriv]
  ring

/-- The Stein generator kills every coefficient on the stable residue line. -/
theorem burnolSteinA_stableResidueCarrier (c u : ℝ) :
    burnolSteinA (burnolStableResidueCarrier c) u = 0 := by
  have hderiv := (hasDerivAt_const u c).mul (hasDerivAt_burnolStableResidueProfile u)
  rw [burnolSteinA]
  change deriv ((fun _ : ℝ => c) * burnolStableResidueProfile) u +
    c * burnolStableResidueProfile u / 2 = 0
  rw [hderiv.deriv]
  ring

/-- Translation restricts to scalar multiplication on the stable residue line. -/
theorem burnolStableResidueCarrier_translate (c L u : ℝ) :
    burnolStableResidueCarrier c (u + L) =
      Real.exp (-L / 2) * burnolStableResidueCarrier c u := by
  simp only [burnolStableResidueCarrier, burnolStableResidueProfile]
  rw [
    show -(u + L) / 2 = -L / 2 + -u / 2 by ring, Real.exp_add]
  ring

/-- Finite source-blind regular expressions generated by the Gamma--Stein operator and logarithmic
translations.  Composition is retained explicitly, so this is stronger than a commutative
polynomial normal form. -/
inductive BurnolRegularResidueOperator where
  | scalar (c : ℝ)
  | stein
  | translate (L : ℝ)
  | add (P Q : BurnolRegularResidueOperator)
  | comp (P Q : BurnolRegularResidueOperator)

namespace BurnolRegularResidueOperator

/-- Action of a finite regular expression on a logarithmic profile. -/
def act : BurnolRegularResidueOperator → (ℝ → ℝ) → ℝ → ℝ
  | .scalar c, f => fun u => c * f u
  | .stein, f => burnolSteinA f
  | .translate L, f => fun u => f (u + L)
  | .add P Q, f => fun u => act P f u + act Q f u
  | .comp P Q, f => act P (act Q f)

/-- Scalar by which a regular expression acts on the stable residue line. -/
def stableGain : BurnolRegularResidueOperator → ℝ
  | .scalar c => c
  | .stein => 0
  | .translate L => Real.exp (-L / 2)
  | .add P Q => stableGain P + stableGain Q
  | .comp P Q => stableGain P * stableGain Q

/-- **Stable-line classification.** Every finite regular Gamma--Stein/translation expression acts
by its scalar gain on every residue coefficient. -/
theorem act_stableResidueCarrier (Q : BurnolRegularResidueOperator) (c : ℝ) :
    Q.act (burnolStableResidueCarrier c) =
      burnolStableResidueCarrier (Q.stableGain * c) := by
  induction Q generalizing c with
  | scalar a =>
      funext u
      simp only [act, stableGain, burnolStableResidueCarrier]
      ring
  | stein =>
      funext u
      simp only [act, stableGain, burnolStableResidueCarrier, zero_mul]
      exact burnolSteinA_stableResidueCarrier c u
  | translate L =>
      funext u
      change burnolStableResidueCarrier c (u + L) =
        burnolStableResidueCarrier (Real.exp (-L / 2) * c) u
      rw [burnolStableResidueCarrier_translate]
      simp only [burnolStableResidueCarrier]
      ring
  | add P Q hP hQ =>
      funext u
      rw [act, hP, hQ]
      simp only [stableGain, burnolStableResidueCarrier]
      ring
  | comp P Q hP hQ =>
      rw [act, hQ, hP]
      apply congrArg burnolStableResidueCarrier
      simp only [stableGain]
      ring

/-- A regular operator annihilates the literal unit stable carrier. -/
def AnnihilatesStableResidue (Q : BurnolRegularResidueOperator) : Prop :=
  Q.act (burnolStableResidueCarrier 1) = 0

/-- A regular operator retains the coefficient on the stable residue line. -/
def CoefficientFaithfulOnStableResidue (Q : BurnolRegularResidueOperator) : Prop :=
  ∀ c : ℝ, Q.act (burnolStableResidueCarrier c) = 0 ↔ c = 0

theorem stableResidueCarrier_eq_zero_iff (c : ℝ) :
    burnolStableResidueCarrier c = 0 ↔ c = 0 := by
  constructor
  · intro h
    have h0 := congrFun h 0
    simpa [burnolStableResidueCarrier, burnolStableResidueProfile] using h0
  · rintro rfl
    funext u
    simp [burnolStableResidueCarrier]

/-- Annihilation is exactly zero stable gain. -/
theorem annihilatesStableResidue_iff_stableGain_eq_zero
    (Q : BurnolRegularResidueOperator) :
    Q.AnnihilatesStableResidue ↔ Q.stableGain = 0 := by
  rw [AnnihilatesStableResidue, act_stableResidueCarrier,
    stableResidueCarrier_eq_zero_iff]
  simp

/-- Coefficient faithfulness is exactly nonzero stable gain. -/
theorem coefficientFaithfulOnStableResidue_iff_stableGain_ne_zero
    (Q : BurnolRegularResidueOperator) :
    Q.CoefficientFaithfulOnStableResidue ↔ Q.stableGain ≠ 0 := by
  constructor
  · intro hfaith hzero
    have hz : Q.act (burnolStableResidueCarrier 1) = 0 := by
      rw [act_stableResidueCarrier, hzero]
      simpa using (stableResidueCarrier_eq_zero_iff 0).2 rfl
    have hone := (hfaith 1).mp hz
    norm_num at hone
  · intro hgain c
    rw [act_stableResidueCarrier, stableResidueCarrier_eq_zero_iff]
    exact mul_eq_zero.trans (or_iff_right hgain)

/-- **Regular stable-residue no-go.** No finite source-blind Gamma--Stein/translation expression
can both annihilate the stable carrier and retain its coefficient. -/
theorem not_annihilatesStableResidue_and_coefficientFaithful
    (Q : BurnolRegularResidueOperator) :
    ¬(Q.AnnihilatesStableResidue ∧ Q.CoefficientFaithfulOnStableResidue) := by
  rintro ⟨hannihilates, hfaithful⟩
  exact (coefficientFaithfulOnStableResidue_iff_stableGain_ne_zero Q).mp hfaithful
    ((annihilatesStableResidue_iff_stableGain_eq_zero Q).mp hannihilates)

end BurnolRegularResidueOperator

end RHTower
