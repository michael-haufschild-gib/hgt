import Mathlib

/-!
# Pure-point spectral-block recurrence law

The exact spectral-block displacement identity does not depend on finite
dimension.  It holds for arbitrary spectral index types; in the physically
relevant countable pure-point case, the accompanying summability equivalence
identifies the precise finite-energy condition.
-/

open scoped BigOperators

namespace RHTower

noncomputable section

/-- Total squared block displacement over an arbitrary pure-point spectrum. -/
def purePointSpectralBlockDistanceSq
    {ι E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (phase : ι → ι → ℂ) (block : ι → ι → E) : ℝ :=
  ∑' p : ι × ι, ‖phase p.1 p.2 • block p.1 p.2 - block p.1 p.2‖ ^ (2 : ℕ)

/-- Total weighted chord energy over an arbitrary pure-point spectrum. -/
def purePointSpectralBlockPhaseEnergy
    {ι E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (phase : ι → ι → ℂ) (block : ι → ι → E) : ℝ :=
  ∑' p : ι × ι, ‖block p.1 p.2‖ ^ (2 : ℕ) * ‖phase p.1 p.2 - 1‖ ^ (2 : ℕ)

/--
Dimension-free pure-point law: total squared displacement equals total
coherence-weighted phase energy for every spectral index type.
-/
theorem purePointSpectralBlockDistanceSq_eq_phaseEnergy
    {ι E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (phase : ι → ι → ℂ) (block : ι → ι → E) :
    purePointSpectralBlockDistanceSq phase block =
      purePointSpectralBlockPhaseEnergy phase block := by
  unfold purePointSpectralBlockDistanceSq purePointSpectralBlockPhaseEnergy
  apply tsum_congr
  intro p
  have h :
      phase p.1 p.2 • block p.1 p.2 - block p.1 p.2 =
        (phase p.1 p.2 - 1) • block p.1 p.2 := by
    module
  rw [h, norm_smul, mul_pow]
  ring

/-- Pairwise phase generated by an arbitrary pure-point energy list. -/
def purePointHamiltonianPhase {ι : Type*}
    (t : ℝ) (energy : ι → ℝ) : ι → ι → ℂ :=
  fun i j => Complex.exp
    (Complex.I * (((t * (energy i - energy j) : ℝ) : ℂ)))

/--
Hamiltonian pure-point specialization: recurrence depends exactly on visible
energy gaps and their block weights.
-/
theorem purePointHamiltonianDistanceSq_eq_gapEnergy
    {ι E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (t : ℝ) (energy : ι → ℝ) (block : ι → ι → E) :
    purePointSpectralBlockDistanceSq
        (purePointHamiltonianPhase t energy) block =
      ∑' p : ι × ι, ‖block p.1 p.2‖ ^ (2 : ℕ) *
        ‖Complex.exp
          (Complex.I * (((t * (energy p.1 - energy p.2) : ℝ) : ℂ))) - 1‖ ^ (2 : ℕ) := by
  rw [purePointSpectralBlockDistanceSq_eq_phaseEnergy]
  rfl

/--
The displacement series is summable exactly when its weighted phase-energy
series is summable.
-/
theorem summable_purePoint_blockDistance_iff_phaseEnergy
    {ι E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (phase : ι → ι → ℂ) (block : ι → ι → E) :
    Summable (fun p : ι × ι =>
        ‖phase p.1 p.2 • block p.1 p.2 - block p.1 p.2‖ ^ (2 : ℕ)) ↔
      Summable (fun p : ι × ι =>
        ‖block p.1 p.2‖ ^ (2 : ℕ) * ‖phase p.1 p.2 - 1‖ ^ (2 : ℕ)) := by
  apply summable_congr
  intro p
  have h :
      phase p.1 p.2 • block p.1 p.2 - block p.1 p.2 =
        (phase p.1 p.2 - 1) • block p.1 p.2 := by
    module
  rw [h, norm_smul, mul_pow]
  ring

end

end RHTower
