import GaloisForLFunctions.RHTower.PaperCircleEnergyHeatKernel
import GaloisForLFunctions.HTGeometry.PaperFourierLLogL.Thermal.Order

/-! # Positive cosine correlations for native circle-energy Gibbs laws

The actual dyadic energy pays every positivity requirement of the source Ginibre and
comparison theorems. Increasing the nonnegative coupling increases cosine expectations,
decreases phase fluctuations, and gives diminishing free-energy increments.
-/

open scoped BigOperators NNReal
open GaloisForLFunctions.HTGeometry.FourierLLogL
open GaloisForLFunctions.HTGeometry.FourierLLogL.Dyadic

namespace RHTower
noncomputable section
variable {ι : Type*} [Fintype ι]

/-- The Gibbs law for the spectral form generated by actual native circle energy. -/
def paperCircleGibbsLaw (a : ι → CCMCircleBoundedSymbol) (M : ℕ) (t : ℝ≥0) : Law (Grid M) :=
  Thermal.label ((t : ℝ) • paperCircleGridEnergy a M)

/-- The negative logarithm of the corresponding return probability. -/
def paperCircleFreeEnergy (a : ι → CCMCircleBoundedSymbol) (M : ℕ) (t : ℝ≥0) : ℝ :=
  Thermal.F ((t : ℝ) • paperCircleGridEnergy a M)

private theorem scaled_energy_nonneg (a : ι → CCMCircleBoundedSymbol) (M : ℕ) (t : ℝ≥0) :
    0 ≤ (t : ℝ) • paperCircleGridEnergy a M :=
  fun x => mul_nonneg t.coe_nonneg (paperCircleGridEnergy_nonneg a M x)

private theorem scaled_energy_mono (a : ι → CCMCircleBoundedSymbol) (M : ℕ) :
    Monotone (fun t : ℝ≥0 => (t : ℝ) • paperCircleGridEnergy a M) := by
  intro s t h x
  exact mul_le_mul_of_nonneg_right (show (s : ℝ) ≤ t from h)
    (paperCircleGridEnergy_nonneg a M x)

/-- Gibbs Fourier expectations are normalized native heat-kernel entries. -/
theorem paperCircleGibbsLaw_characteristic (a : ι → CCMCircleBoundedSymbol) (M : ℕ)
    (t : ℝ≥0) (u : Grid M) :
    (paperCircleGibbsLaw a M t).Cx (chi u) =
      ((paperCircleGridHeat a M t u / paperCircleGridHeat a M t 0 : ℝ) : ℂ) :=
  (Thermal.cred_eq _ _).symm

theorem paperCircleGibbsLaw_cosine_nonneg (a : ι → CCMCircleBoundedSymbol) (M : ℕ)
    (t : ℝ≥0) (u : Grid M) : 0 ≤ (paperCircleGibbsLaw a M t).Ex (Thermal.wave u) := by
  exact (Thermal.cred_ex _ _).symm ▸ Thermal.cred_nonneg (scaled_energy_nonneg a M t) u

/-- Ginibre association holds for every pair of finite cosine modes. -/
theorem paperCircleGibbsLaw_cosine_covariance_nonneg (a : ι → CCMCircleBoundedSymbol)
    (M : ℕ) (t : ℝ≥0) (u v : Grid M) :
    0 ≤ (paperCircleGibbsLaw a M t).Ex (fun x => Thermal.wave u x * Thermal.wave v x) -
      (paperCircleGibbsLaw a M t).Ex (Thermal.wave u) *
        (paperCircleGibbsLaw a M t).Ex (Thermal.wave v) := by
  apply sub_nonneg.mpr
  change (Thermal.label _).Ex _ * (Thermal.label _).Ex _ ≤ _
  rw [← Thermal.cred_ex, ← Thermal.cred_ex]
  exact Thermal.ginibre (scaled_energy_nonneg a M t) u v

/-- Every cosine expectation increases with the actual energy coupling. -/
theorem monotone_paperCircleGibbsLaw_cosine (a : ι → CCMCircleBoundedSymbol) (M : ℕ)
    (u : Grid M) : Monotone (fun t : ℝ≥0 => (paperCircleGibbsLaw a M t).Ex (Thermal.wave u)) := by
  intro s t h
  change (Thermal.label _).Ex _ ≤ (Thermal.label _).Ex _
  rw [← Thermal.cred_ex, ← Thermal.cred_ex]
  exact Thermal.cred_mono (scaled_energy_nonneg a M s) (scaled_energy_mono a M h) u

/-- The mean squared displacement of each character decreases with coupling. -/
theorem antitone_paperCircleGibbsLaw_phase_fluctuation (a : ι → CCMCircleBoundedSymbol)
    (M : ℕ) (u : Grid M) :
    Antitone (fun t : ℝ≥0 => (paperCircleGibbsLaw a M t).Ex (fun x => ‖1 - chi u x‖ ^ 2)) := by
  intro s t h
  simp_rw [Thermal.norm_phase_sq, Law.Ex_lmul]
  change 2 * (Thermal.label _).Ex _ ≤ 2 * (Thermal.label _).Ex _
  rw [Thermal.cred_cost, Thermal.cred_cost]
  have H := Thermal.cred_mono (scaled_energy_nonneg a M s) (scaled_energy_mono a M h) u
  linarith

/-- The expected native spectral energy decreases with coupling. -/
theorem antitone_paperCircleGibbsLaw_energy (a : ι → CCMCircleBoundedSymbol) (M : ℕ) :
    Antitone (fun t : ℝ≥0 =>
      (paperCircleGibbsLaw a M t).Ex (Thermal.form (paperCircleGridEnergy a M))) := by
  intro s t h
  exact Thermal.form_energy_mono (scaled_energy_nonneg a M s) (scaled_energy_mono a M h)
    (paperCircleGridEnergy_nonneg a M)

theorem paperCircleFreeEnergy_zero (a : ι → CCMCircleBoundedSymbol) (M : ℕ) :
    paperCircleFreeEnergy a M 0 = 0 := by
  simp only [paperCircleFreeEnergy, NNReal.coe_zero, zero_smul, Thermal.F_zero]

theorem monotone_paperCircleFreeEnergy (a : ι → CCMCircleBoundedSymbol) (M : ℕ) :
    Monotone (paperCircleFreeEnergy a M) := fun _ _ h => Thermal.F_mono (scaled_energy_mono a M h)

theorem paperCircleFreeEnergy_nonneg (a : ι → CCMCircleBoundedSymbol) (M : ℕ) (t : ℝ≥0) :
    0 ≤ paperCircleFreeEnergy a M t := by
  rw [← paperCircleFreeEnergy_zero a M]
  exact monotone_paperCircleFreeEnergy a M (show 0 ≤ t from zero_le)

/-- An equal added coupling costs less free energy after any previous added coupling. -/
theorem paperCircleFreeEnergy_diminishing_increment (a : ι → CCMCircleBoundedSymbol)
    (M : ℕ) (s t r : ℝ≥0) :
    paperCircleFreeEnergy a M (s + t + r) - paperCircleFreeEnergy a M (s + t) ≤
      paperCircleFreeEnergy a M (s + r) - paperCircleFreeEnergy a M s := by
  simpa only [paperCircleFreeEnergy, NNReal.coe_add, add_smul] using
    (Thermal.F_increment (scaled_energy_nonneg a M s)
      (scaled_energy_mono a M (show s ≤ s + t from le_add_of_nonneg_right (show 0 ≤ t from zero_le)))
      (scaled_energy_nonneg a M r))

/-- Native mean added energy is bounded by its exact free-energy increment. -/
theorem paperCircleGibbsLaw_energy_increment_le (a : ι → CCMCircleBoundedSymbol)
    (M : ℕ) (s t : ℝ≥0) :
    (t : ℝ) * (paperCircleGibbsLaw a M (s + t)).Ex
      (Thermal.form (paperCircleGridEnergy a M)) ≤
        paperCircleFreeEnergy a M (s + t) - paperCircleFreeEnergy a M s := by
  have H := Thermal.mean_energy ((s : ℝ) • paperCircleGridEnergy a M)
    ((t : ℝ) • paperCircleGridEnergy a M)
  rw [show Thermal.form ((t : ℝ) • paperCircleGridEnergy a M) =
    (fun x => (t : ℝ) * Thermal.form (paperCircleGridEnergy a M) x) from
      funext (Thermal.form_smul _ _), Law.Ex_lmul] at H
  simpa only [paperCircleGibbsLaw, paperCircleFreeEnergy, NNReal.coe_add, add_smul] using H

end
end RHTower
