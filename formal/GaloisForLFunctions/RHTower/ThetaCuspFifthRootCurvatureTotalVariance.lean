import GaloisForLFunctions.HilbertMetric.FifthRootCurvatureMixture
import GaloisForLFunctions.HTGeometry.SmoothDerivativeChain
import GaloisForLFunctions.RHTower.ThetaCuspCompletedProductFiberCofinalDropRepair
import GaloisForLFunctions.RHTower.ThetaCuspReflectedSourceFifthRootCurvature

/-!
# Cofinal total-variance decomposition of theta fifth-root curvature

The completed product-fibre expansion separates the reflected theta product
into its first fibre and a cofinal higher tail.  The corresponding accumulated
drop therefore splits exactly.  Combining that split with the fifth-root law
of total variance gives an unconditional peeling identity for the literal
theta `C₅` numerator.

The endpoint flux and curvature of the distinguished fibre are left as
algebraic jet coordinates `d,j`.  This makes the identity valid even at the
absolute-value seams; on a smooth chamber they may be instantiated with the
actual first-fibre jets.  The remaining sign is then an exact cofinal
curvature-absorption problem, including the nonnegative projective-flux
mismatch square.
-/

namespace RHTower

noncomputable section

private theorem iteratedDeriv_congr_of_eventuallyEq_real
    {f g : ℝ → ℝ} {x : ℝ} (hfg : f =ᶠ[nhds x] g) (n : ℕ) :
    iteratedDeriv n f x = iteratedDeriv n g x := by
  rw [← iteratedDerivWithin_univ, ← iteratedDerivWithin_univ]
  refine Filter.EventuallyEq.iteratedDerivWithin_eq ?_ hfg.eq_of_nhds
  rwa [nhdsWithin_univ]

private theorem iteratedDeriv_sub_apply_real
    {f g : ℝ → ℝ} {n : ℕ} {x : ℝ}
    (hf : ContDiffAt ℝ n f x) (hg : ContDiffAt ℝ n g x) :
    iteratedDeriv n (f - g) x = iteratedDeriv n f x - iteratedDeriv n g x := by
  rw [iteratedDeriv_eq_iteratedFDeriv, iteratedDeriv_eq_iteratedFDeriv,
    iteratedDeriv_eq_iteratedFDeriv, iteratedFDeriv_sub_apply hf hg,
    sub_apply]

private theorem contDiff_top_thetaCuspSourceTerm (n : ℕ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (fun x => thetaCuspSourceTerm x n) := by
  let f : ℕ → ℝ → ℝ := fun m =>
    thetaCuspPolynomialAtom (thetaCuspLogDerivativePolynomial m) n
  have hf : ∀ m x, HasDerivAt (f m) (f (m + 1) x) x := by
    intro m x
    simpa [f, thetaCuspLogDerivativePolynomial] using
      hasDerivAt_thetaCuspPolynomialAtom
        (thetaCuspLogDerivativePolynomial m) n x
  have hs :=
    GaloisForLFunctions.HTGeometry.contDiff_top_of_hasDerivAt_chain hf 0
  simpa [f, thetaCuspLogDerivativePolynomial,
    thetaCuspSourceTerm_eq_polynomialAtom] using hs

private theorem thetaCuspCompletedProductFiberFirst_zero_eventuallyEq_sourceTerm_sq
    {t : ℝ} (ht : 0 < t) :
    thetaCuspCompletedProductFiberAmplitude 1 0 =ᶠ[nhds t]
      fun s => thetaCuspSourceTerm s 1 ^ 2 := by
  filter_upwards [isOpen_Ioi.mem_nhds ht] with s hs
  rw [thetaCuspCompletedProductFiberAmplitude_one_zero, abs_of_pos hs]

/-- Accumulated drop of the first completed product fibre. -/
def thetaCuspCompletedProductFiberFirstDrop (u t : ℝ) : ℝ :=
  thetaCuspCompletedProductFiberAmplitude 1 u 0 -
    thetaCuspCompletedProductFiberAmplitude 1 u t

/-- Accumulated drop of the cofinal completed product-fibre tail. -/
def thetaCuspCompletedProductFiberHigherTailDrop (u t : ℝ) : ℝ :=
  thetaCuspCompletedProductFiberHigherTail u 0 -
    thetaCuspCompletedProductFiberHigherTail u t

/-- Higher-to-first likelihood factor generated by squaring the completed
source decomposition at modular center. -/
def thetaCuspCompletedProductFiberCofinalLikelihoodFactor (t : ℝ) : ℝ :=
  thetaCuspHigherToFirstAtomLikelihoodRatio t *
    (2 + thetaCuspHigherToFirstAtomLikelihoodRatio t)

/-- First ordinary jet of the cofinal likelihood factor. -/
def thetaCuspCompletedProductFiberCofinalLikelihoodFactorJetOne (t : ℝ) : ℝ :=
  2 * (1 + thetaCuspHigherToFirstAtomLikelihoodRatio t) *
    thetaCuspHigherLikelihoodJetOne t

/-- Second ordinary jet of the cofinal likelihood factor. -/
def thetaCuspCompletedProductFiberCofinalLikelihoodFactorJetTwo (t : ℝ) : ℝ :=
  2 * (thetaCuspHigherLikelihoodJetOne t ^ 2 +
    (1 + thetaCuspHigherToFirstAtomLikelihoodRatio t) *
      thetaCuspHigherLikelihoodJetTwo t)

/-- Algebraic decay-flux jet of the completed first product fibre. -/
def thetaCuspCompletedProductFiberFirstDecayFlux (u t : ℝ) : ℝ :=
  -iteratedDeriv 1 (thetaCuspCompletedProductFiberAmplitude 1 u) t

/-- Algebraic flux-curvature jet of the completed first product fibre. -/
def thetaCuspCompletedProductFiberFirstDecayFluxCurvature (u t : ℝ) : ℝ :=
  -iteratedDeriv 2 (thetaCuspCompletedProductFiberAmplitude 1 u) t

/-- Literal decay-flux jet of the cofinal higher product-fibre tail. -/
def thetaCuspCompletedProductFiberHigherTailDecayFlux (u t : ℝ) : ℝ :=
  -iteratedDeriv 1 (thetaCuspCompletedProductFiberHigherTail u) t

/-- Literal flux-curvature jet of the cofinal higher product-fibre tail. -/
def thetaCuspCompletedProductFiberHigherTailDecayFluxCurvature
    (u t : ℝ) : ℝ :=
  -iteratedDeriv 2 (thetaCuspCompletedProductFiberHigherTail u) t

/-- Fifth-root numerator of the completed first product fibre. -/
def thetaCuspCompletedProductFiberFirstFifthRootCurvatureNumerator
    (u t : ℝ) : ℝ :=
  HilbertMetric.fifthRootCurvatureJetForm t
    (thetaCuspCompletedProductFiberFirstDrop u t)
    (thetaCuspCompletedProductFiberFirstDecayFlux u t)
    (thetaCuspCompletedProductFiberFirstDecayFluxCurvature u t)

/-- Algebraic fifth-root numerator of the residual cofinal jet after the
literal first product-fibre jet is removed from the source jet. -/
def thetaCuspCompletedProductFiberHigherTailResidualFifthRootCurvatureNumerator
    (u t : ℝ) : ℝ :=
  HilbertMetric.fifthRootCurvatureJetForm t
    (thetaCuspCompletedProductFiberHigherTailDrop u t)
    (thetaCuspReflectedSourceDecayFlux u t -
      thetaCuspCompletedProductFiberFirstDecayFlux u t)
    (thetaCuspReflectedSourceDecayFluxCurvature u t -
      thetaCuspCompletedProductFiberFirstDecayFluxCurvature u t)

/-- Literal functional fifth-root numerator of the cofinal higher tail. -/
def thetaCuspCompletedProductFiberHigherTailFifthRootCurvatureNumerator
    (u t : ℝ) : ℝ :=
  HilbertMetric.fifthRootDividedDropCurvatureNumerator
    (thetaCuspCompletedProductFiberHigherTail u) t

/-- The exact cofinal budget which must absorb first-fibre fifth-root
curvature and projective-flux mismatch in the first-fibre-rise chamber. -/
def thetaCuspCompletedProductFiberCofinalCurvatureAbsorptionBudget
    (u t : ℝ) : ℝ :=
  thetaCuspCompletedProductFiberHigherTailDrop u t *
      thetaCuspReflectedSourceFirstDrop u t *
      thetaCuspCompletedProductFiberFirstFifthRootCurvatureNumerator u t +
    thetaCuspCompletedProductFiberFirstDrop u t *
      thetaCuspReflectedSourceFirstDrop u t *
      thetaCuspCompletedProductFiberHigherTailResidualFifthRootCurvatureNumerator u t +
    4 * t ^ 2 *
      (thetaCuspCompletedProductFiberFirstDrop u t *
          thetaCuspReflectedSourceDecayFlux u t -
        thetaCuspReflectedSourceFirstDrop u t *
          thetaCuspCompletedProductFiberFirstDecayFlux u t) ^ 2

/-- Fully functional cofinal absorption budget at modular center.  Both
component curvature terms are literal fifth-root divided-drop numerators. -/
def thetaCuspCompletedProductFiberCofinalFunctionalAbsorptionBudgetAtZero
    (t : ℝ) : ℝ :=
  thetaCuspCompletedProductFiberHigherTailDrop 0 t *
      thetaCuspReflectedSourceFirstDrop 0 t *
      HilbertMetric.fifthRootDividedDropCurvatureNumerator
        (thetaCuspCompletedProductFiberAmplitude 1 0) t +
    thetaCuspCompletedProductFiberFirstDrop 0 t *
      thetaCuspReflectedSourceFirstDrop 0 t *
      thetaCuspCompletedProductFiberHigherTailFifthRootCurvatureNumerator 0 t +
    4 * t ^ 2 *
      (thetaCuspCompletedProductFiberFirstDrop 0 t *
          thetaCuspReflectedSourceDecayFlux 0 t -
        thetaCuspReflectedSourceFirstDrop 0 t *
          thetaCuspCompletedProductFiberFirstDecayFlux 0 t) ^ 2

/-- Exact drop decomposition induced by the completed product-fibre sum. -/
theorem thetaCuspReflectedSourceFirstDrop_eq_firstFiber_add_higherTail
    (u t : ℝ) :
    thetaCuspReflectedSourceFirstDrop u t =
      thetaCuspCompletedProductFiberFirstDrop u t +
        thetaCuspCompletedProductFiberHigherTailDrop u t := by
  have hzero :=
    thetaCuspCompletedProductFiberAmplitude_one_add_higherTail u 0
  have ht :=
    thetaCuspCompletedProductFiberAmplitude_one_add_higherTail u t
  unfold thetaCuspReflectedSourceFirstDrop
    thetaCuspCompletedProductFiberFirstDrop
    thetaCuspCompletedProductFiberHigherTailDrop
  linarith

/-- **Cofinal likelihood factorization.**  At modular center and positive
displacement, every completed product fibre above the first is exactly the
first-fibre amplitude times `R(2+R)`, where `R` is the complete
higher-to-first atom likelihood ratio. -/
theorem thetaCuspCompletedProductFiberHigherTail_zero_eq_firstFiber_mul_likelihoodFactor
    {t : ℝ} (ht : 0 < t) :
    thetaCuspCompletedProductFiberHigherTail 0 t =
      thetaCuspCompletedProductFiberAmplitude 1 0 t *
        thetaCuspCompletedProductFiberCofinalLikelihoodFactor t := by
  have hsplit :=
    thetaCuspCompletedProductFiberAmplitude_one_add_higherTail 0 t
  have hfactor := thetaCuspFullSource_eq_firstAtom_mul_higherFactor ht
  unfold thetaCuspReflectedSourceProduct at hsplit
  simp only [zero_add, zero_sub, thetaCuspFullSource_neg] at hsplit
  rw [thetaCuspCompletedProductFiberAmplitude_one_zero, abs_of_pos ht]
    at hsplit ⊢
  rw [hfactor] at hsplit
  unfold thetaCuspCompletedProductFiberCofinalLikelihoodFactor
  ring_nf at hsplit ⊢
  linarith

/-- The cofinal likelihood factor is nonnegative on the positive half-line. -/
theorem thetaCuspCompletedProductFiberCofinalLikelihoodFactor_nonneg
    {t : ℝ} (ht : 0 < t) :
    0 ≤ thetaCuspCompletedProductFiberCofinalLikelihoodFactor t := by
  have hR := thetaCuspHigherToFirstAtomLikelihoodRatio_nonneg ht
  unfold thetaCuspCompletedProductFiberCofinalLikelihoodFactor
  positivity

/-- Exact first derivative of the cofinal likelihood factor. -/
theorem hasDerivAt_thetaCuspCompletedProductFiberCofinalLikelihoodFactor
    {t : ℝ} (ht : 0 < t) :
    HasDerivAt thetaCuspCompletedProductFiberCofinalLikelihoodFactor
      (thetaCuspCompletedProductFiberCofinalLikelihoodFactorJetOne t) t := by
  have hR := hasDerivAt_thetaCuspHigherToFirstAtomLikelihoodRatio ht
  have hraw := hR.mul ((hasDerivAt_const t 2).add hR)
  unfold thetaCuspCompletedProductFiberCofinalLikelihoodFactor
    thetaCuspCompletedProductFiberCofinalLikelihoodFactorJetOne
  refine (hraw.congr_of_eventuallyEq
    (Filter.Eventually.of_forall fun x => ?_)).congr_deriv ?_
  · rfl
  · simp only [Pi.add_apply]
    ring

/-- Exact second derivative of the cofinal likelihood factor. -/
theorem hasDerivAt_thetaCuspCompletedProductFiberCofinalLikelihoodFactorJetOne
    {t : ℝ} (ht : 0 < t) :
    HasDerivAt thetaCuspCompletedProductFiberCofinalLikelihoodFactorJetOne
      (thetaCuspCompletedProductFiberCofinalLikelihoodFactorJetTwo t) t := by
  have hR := hasDerivAt_thetaCuspHigherToFirstAtomLikelihoodRatio ht
  have hRone := hasDerivAt_thetaCuspHigherLikelihoodJetOne ht
  have hraw := (((hasDerivAt_const t 1).add hR).mul hRone).const_mul 2
  unfold thetaCuspCompletedProductFiberCofinalLikelihoodFactorJetOne
    thetaCuspCompletedProductFiberCofinalLikelihoodFactorJetTwo
  refine (hraw.congr_of_eventuallyEq
    (Filter.Eventually.of_forall fun x => ?_)).congr_deriv ?_
  · simp only [Pi.add_apply, Pi.mul_apply]
    ring
  · simp only [Pi.add_apply]
    ring

/-- The completed first product fibre differentiates to the negative of its
literal decay flux on the positive modular-center chamber. -/
theorem hasDerivAt_thetaCuspCompletedProductFiberAmplitude_one_zero
    {t : ℝ} (ht : 0 < t) :
    HasDerivAt (thetaCuspCompletedProductFiberAmplitude 1 0)
      (-thetaCuspCompletedProductFiberFirstDecayFlux 0 t) t := by
  let g : ℝ → ℝ := fun s => thetaCuspSourceTerm s 1 ^ 2
  have hfirst :
      thetaCuspCompletedProductFiberAmplitude 1 0 =ᶠ[nhds t] g :=
    thetaCuspCompletedProductFiberFirst_zero_eventuallyEq_sourceTerm_sq ht
  have hg : ContDiff ℝ (↑(⊤ : ℕ∞)) g :=
    (contDiff_top_thetaCuspSourceTerm 1).pow 2
  refine (((hg.differentiable (by simp)) t).hasDerivAt.congr_of_eventuallyEq
    hfirst).congr_deriv ?_
  unfold thetaCuspCompletedProductFiberFirstDecayFlux
  rw [iteratedDeriv_one]
  have hj := iteratedDeriv_congr_of_eventuallyEq_real hfirst 1
  rw [iteratedDeriv_one, iteratedDeriv_one] at hj
  linarith

/-- The derivative of the completed first-fibre decay flux is its literal
flux-curvature jet. -/
theorem hasDerivAt_thetaCuspCompletedProductFiberFirstDecayFlux_zero
    {t : ℝ} (ht : 0 < t) :
    HasDerivAt (thetaCuspCompletedProductFiberFirstDecayFlux 0)
      (thetaCuspCompletedProductFiberFirstDecayFluxCurvature 0 t) t := by
  let g : ℝ → ℝ := fun s => thetaCuspSourceTerm s 1 ^ 2
  have hfirst :
      thetaCuspCompletedProductFiberAmplitude 1 0 =ᶠ[nhds t] g :=
    thetaCuspCompletedProductFiberFirst_zero_eventuallyEq_sourceTerm_sq ht
  have hflux :
      thetaCuspCompletedProductFiberFirstDecayFlux 0 =ᶠ[nhds t]
        fun s => -iteratedDeriv 1 g s := by
    filter_upwards [isOpen_Ioi.mem_nhds ht] with s hs
    have hlocal :
        thetaCuspCompletedProductFiberAmplitude 1 0 =ᶠ[nhds s] g :=
      thetaCuspCompletedProductFiberFirst_zero_eventuallyEq_sourceTerm_sq hs
    unfold thetaCuspCompletedProductFiberFirstDecayFlux
    rw [iteratedDeriv_congr_of_eventuallyEq_real hlocal 1]
  have hg : ContDiff ℝ (↑(⊤ : ℕ∞)) g :=
    (contDiff_top_thetaCuspSourceTerm 1).pow 2
  have hjet :
      HasDerivAt (iteratedDeriv 1 g) (iteratedDeriv 2 g t) t := by
    have hd := (hg.differentiable_iteratedDeriv 1 (by simp)) t
    refine hd.hasDerivAt.congr_deriv ?_
    change deriv (iteratedDeriv 1 g) t = iteratedDeriv 2 g t
    conv_rhs =>
      rw [show 2 = 1 + 1 by norm_num, iteratedDeriv_succ]
  refine (hjet.neg.congr_of_eventuallyEq hflux).congr_deriv ?_
  unfold thetaCuspCompletedProductFiberFirstDecayFluxCurvature
  have hj := iteratedDeriv_congr_of_eventuallyEq_real hfirst 2
  linarith

/-- **First cofinal product-jet law.**  The infinite higher-tail decay flux is
forced by the first fibre and the first likelihood-factor jet. -/
theorem thetaCuspCompletedProductFiberHigherTailDecayFlux_zero_eq_product
    {t : ℝ} (ht : 0 < t) :
    thetaCuspCompletedProductFiberHigherTailDecayFlux 0 t =
      thetaCuspCompletedProductFiberFirstDecayFlux 0 t *
          thetaCuspCompletedProductFiberCofinalLikelihoodFactor t -
        thetaCuspCompletedProductFiberAmplitude 1 0 t *
          thetaCuspCompletedProductFiberCofinalLikelihoodFactorJetOne t := by
  have htail :
      thetaCuspCompletedProductFiberHigherTail 0 =ᶠ[nhds t]
        fun s => thetaCuspCompletedProductFiberAmplitude 1 0 s *
          thetaCuspCompletedProductFiberCofinalLikelihoodFactor s := by
    filter_upwards [isOpen_Ioi.mem_nhds ht] with s hs
    exact
      thetaCuspCompletedProductFiberHigherTail_zero_eq_firstFiber_mul_likelihoodFactor hs
  have hprod :=
    (hasDerivAt_thetaCuspCompletedProductFiberAmplitude_one_zero ht).mul
      (hasDerivAt_thetaCuspCompletedProductFiberCofinalLikelihoodFactor ht)
  have htailDeriv := hprod.congr_of_eventuallyEq htail
  unfold thetaCuspCompletedProductFiberHigherTailDecayFlux
  rw [iteratedDeriv_one, htailDeriv.deriv]
  ring

/-- **Second cofinal product-jet law.**  The infinite higher-tail curvature
jet is forced by the first-fibre jets and the first two likelihood-factor
jets.  In particular, no independent regularity hypothesis on the cofinal
tail is needed. -/
theorem thetaCuspCompletedProductFiberHigherTailDecayFluxCurvature_zero_eq_product
    {t : ℝ} (ht : 0 < t) :
    thetaCuspCompletedProductFiberHigherTailDecayFluxCurvature 0 t =
      thetaCuspCompletedProductFiberFirstDecayFluxCurvature 0 t *
          thetaCuspCompletedProductFiberCofinalLikelihoodFactor t +
        2 * thetaCuspCompletedProductFiberFirstDecayFlux 0 t *
          thetaCuspCompletedProductFiberCofinalLikelihoodFactorJetOne t -
        thetaCuspCompletedProductFiberAmplitude 1 0 t *
          thetaCuspCompletedProductFiberCofinalLikelihoodFactorJetTwo t := by
  let q : ℝ → ℝ := fun s =>
    -thetaCuspCompletedProductFiberFirstDecayFlux 0 s *
        thetaCuspCompletedProductFiberCofinalLikelihoodFactor s +
      thetaCuspCompletedProductFiberAmplitude 1 0 s *
        thetaCuspCompletedProductFiberCofinalLikelihoodFactorJetOne s
  have htailOne :
      deriv (thetaCuspCompletedProductFiberHigherTail 0) =ᶠ[nhds t] q := by
    filter_upwards [isOpen_Ioi.mem_nhds ht] with s hs
    have htail :
        thetaCuspCompletedProductFiberHigherTail 0 =ᶠ[nhds s]
          fun r => thetaCuspCompletedProductFiberAmplitude 1 0 r *
            thetaCuspCompletedProductFiberCofinalLikelihoodFactor r := by
      filter_upwards [isOpen_Ioi.mem_nhds hs] with r hr
      exact
        thetaCuspCompletedProductFiberHigherTail_zero_eq_firstFiber_mul_likelihoodFactor hr
    have hprod :=
      (hasDerivAt_thetaCuspCompletedProductFiberAmplitude_one_zero hs).mul
        (hasDerivAt_thetaCuspCompletedProductFiberCofinalLikelihoodFactor hs)
    have htailDeriv := hprod.congr_of_eventuallyEq htail
    exact htailDeriv.deriv
  have hq :
      HasDerivAt q
        (-thetaCuspCompletedProductFiberFirstDecayFluxCurvature 0 t *
            thetaCuspCompletedProductFiberCofinalLikelihoodFactor t -
          2 * thetaCuspCompletedProductFiberFirstDecayFlux 0 t *
            thetaCuspCompletedProductFiberCofinalLikelihoodFactorJetOne t +
          thetaCuspCompletedProductFiberAmplitude 1 0 t *
            thetaCuspCompletedProductFiberCofinalLikelihoodFactorJetTwo t) t := by
    have hleft :=
      (hasDerivAt_thetaCuspCompletedProductFiberFirstDecayFlux_zero ht).neg.mul
        (hasDerivAt_thetaCuspCompletedProductFiberCofinalLikelihoodFactor ht)
    have hright :=
      (hasDerivAt_thetaCuspCompletedProductFiberAmplitude_one_zero ht).mul
        (hasDerivAt_thetaCuspCompletedProductFiberCofinalLikelihoodFactorJetOne ht)
    have hraw := hleft.add hright
    refine (hraw.congr_of_eventuallyEq
      (Filter.Eventually.of_forall fun s => ?_)).congr_deriv ?_
    · rfl
    · simp only [Pi.neg_apply]
      ring
  have htailTwo := hq.congr_of_eventuallyEq htailOne
  unfold thetaCuspCompletedProductFiberHigherTailDecayFluxCurvature
  rw [show iteratedDeriv 2 (thetaCuspCompletedProductFiberHigherTail 0) =
    deriv (deriv (thetaCuspCompletedProductFiberHigherTail 0)) by
      rw [show 2 = 1 + 1 by norm_num, iteratedDeriv_succ, iteratedDeriv_one]]
  rw [htailTwo.deriv]
  ring

/-- Higher-atom likelihood ordering makes the cofinal factor decrease. -/
theorem thetaCuspCompletedProductFiberCofinalLikelihoodFactorJetOne_nonpos
    {t : ℝ} (ht : 0 < t) :
    thetaCuspCompletedProductFiberCofinalLikelihoodFactorJetOne t ≤ 0 := by
  have hR := hasDerivAt_thetaCuspHigherToFirstAtomLikelihoodRatio ht
  have hRone : thetaCuspHigherLikelihoodJetOne t ≤ 0 := by
    exact hR.hasDerivWithinAt.nonpos_of_antitoneOn
      (isOpen_Ioi.preperfect t ht)
      thetaCuspHigherToFirstAtomLikelihoodRatio_antitoneOn
  have hRnonneg := thetaCuspHigherToFirstAtomLikelihoodRatio_nonneg ht
  unfold thetaCuspCompletedProductFiberCofinalLikelihoodFactorJetOne
  exact mul_nonpos_of_nonneg_of_nonpos (by positivity) hRone

/-- Strict convexity of the cofinal likelihood factor.  It is supplied by the
strictly positive second jet of the complete higher/first likelihood ratio. -/
theorem thetaCuspCompletedProductFiberCofinalLikelihoodFactorJetTwo_pos
    {t : ℝ} (ht : 0 < t) :
    0 < thetaCuspCompletedProductFiberCofinalLikelihoodFactorJetTwo t := by
  have hRnonneg := thetaCuspHigherToFirstAtomLikelihoodRatio_nonneg ht
  have hRtwo := thetaCuspHigherLikelihoodJetTwo_pos ht
  unfold thetaCuspCompletedProductFiberCofinalLikelihoodFactorJetTwo
  positivity

/-- The literal theta fifth-root numerator is the universal algebraic jet
form in its accumulated drop, decay flux, and flux curvature. -/
theorem thetaCuspReflectedSourceFifthRootCurvatureNumerator_eq_jetForm
    (u t : ℝ) :
    thetaCuspReflectedSourceFifthRootCurvatureNumerator u t =
      HilbertMetric.fifthRootCurvatureJetForm t
        (thetaCuspReflectedSourceFirstDrop u t)
        (thetaCuspReflectedSourceDecayFlux u t)
        (thetaCuspReflectedSourceDecayFluxCurvature u t) := by
  rfl

/-- The first-fibre algebraic numerator is the universal functional
fifth-root numerator of that literal fibre. -/
theorem thetaCuspCompletedProductFiberFirstFifthRootCurvatureNumerator_eq_functional
    (u t : ℝ) :
    thetaCuspCompletedProductFiberFirstFifthRootCurvatureNumerator u t =
      HilbertMetric.fifthRootDividedDropCurvatureNumerator
        (thetaCuspCompletedProductFiberAmplitude 1 u) t := by
  rw [HilbertMetric.fifthRootDividedDropCurvatureNumerator_eq_jetForm]
  rfl

/-- On the positive modular-center chamber, the cofinal tail's literal first
jet is exactly the source jet minus the completed first-fibre jet. -/
theorem thetaCuspCompletedProductFiberHigherTailDecayFlux_zero_eq_residual
    {t : ℝ} (ht : 0 < t) :
    thetaCuspCompletedProductFiberHigherTailDecayFlux 0 t =
      thetaCuspReflectedSourceDecayFlux 0 t -
        thetaCuspCompletedProductFiberFirstDecayFlux 0 t := by
  let g : ℝ → ℝ := fun s => thetaCuspSourceTerm s 1 ^ 2
  have hfirst :
      thetaCuspCompletedProductFiberAmplitude 1 0 =ᶠ[nhds t] g := by
    filter_upwards [isOpen_Ioi.mem_nhds ht] with s hs
    rw [thetaCuspCompletedProductFiberAmplitude_one_zero, abs_of_pos hs]
  have htail : thetaCuspCompletedProductFiberHigherTail 0 =ᶠ[nhds t]
      thetaCuspReflectedSourceProduct 0 - g := by
    filter_upwards [hfirst] with s hs
    have hsplit :=
      thetaCuspCompletedProductFiberAmplitude_one_add_higherTail 0 s
    dsimp only [Pi.sub_apply]
    rw [hs] at hsplit
    linarith
  have hP : ContDiffAt ℝ 1 (thetaCuspReflectedSourceProduct 0) t :=
    (contDiff_thetaCuspReflectedSourceProduct 0).contDiffAt.of_le (by simp)
  have hg : ContDiffAt ℝ 1 g t := by
    have hs := contDiff_top_thetaCuspSourceTerm 1
    exact (hs.contDiffAt.pow 2).of_le (by simp)
  have htailJet := iteratedDeriv_congr_of_eventuallyEq_real htail 1
  rw [iteratedDeriv_sub_apply_real hP hg] at htailJet
  have hfirstJet := iteratedDeriv_congr_of_eventuallyEq_real hfirst 1
  have hsourceJet :
      iteratedDeriv 1 (thetaCuspReflectedSourceProduct 0) t =
        -thetaCuspReflectedSourceDecayFlux 0 t := by
    rw [iteratedDeriv_one]
    exact (hasDerivAt_thetaCuspReflectedSourceProduct 0 t).deriv
  unfold thetaCuspCompletedProductFiberHigherTailDecayFlux
    thetaCuspCompletedProductFiberFirstDecayFlux
  rw [htailJet, hsourceJet, hfirstJet]
  ring

/-- On the positive modular-center chamber, the cofinal tail's literal second
jet is exactly the source jet minus the completed first-fibre jet. -/
theorem thetaCuspCompletedProductFiberHigherTailDecayFluxCurvature_zero_eq_residual
    {t : ℝ} (ht : 0 < t) :
    thetaCuspCompletedProductFiberHigherTailDecayFluxCurvature 0 t =
      thetaCuspReflectedSourceDecayFluxCurvature 0 t -
        thetaCuspCompletedProductFiberFirstDecayFluxCurvature 0 t := by
  let g : ℝ → ℝ := fun s => thetaCuspSourceTerm s 1 ^ 2
  have hfirst :
      thetaCuspCompletedProductFiberAmplitude 1 0 =ᶠ[nhds t] g := by
    filter_upwards [isOpen_Ioi.mem_nhds ht] with s hs
    rw [thetaCuspCompletedProductFiberAmplitude_one_zero, abs_of_pos hs]
  have htail : thetaCuspCompletedProductFiberHigherTail 0 =ᶠ[nhds t]
      thetaCuspReflectedSourceProduct 0 - g := by
    filter_upwards [hfirst] with s hs
    have hsplit :=
      thetaCuspCompletedProductFiberAmplitude_one_add_higherTail 0 s
    dsimp only [Pi.sub_apply]
    rw [hs] at hsplit
    linarith
  have hP : ContDiffAt ℝ 2 (thetaCuspReflectedSourceProduct 0) t :=
    (contDiff_thetaCuspReflectedSourceProduct 0).contDiffAt.of_le (by
      change (↑(2 : ℕ∞) : WithTop ℕ∞) ≤ ↑(⊤ : ℕ∞)
      exact WithTop.coe_le_coe.mpr le_top)
  have hg : ContDiffAt ℝ 2 g t := by
    have hs := contDiff_top_thetaCuspSourceTerm 1
    exact (hs.contDiffAt.pow 2).of_le (by
      change (↑(2 : ℕ∞) : WithTop ℕ∞) ≤ ↑(⊤ : ℕ∞)
      exact WithTop.coe_le_coe.mpr le_top)
  have htailJet := iteratedDeriv_congr_of_eventuallyEq_real htail 2
  rw [iteratedDeriv_sub_apply_real hP hg] at htailJet
  have hfirstJet := iteratedDeriv_congr_of_eventuallyEq_real hfirst 2
  have hsourceOne :
      iteratedDeriv 1 (thetaCuspReflectedSourceProduct 0) =
        fun s => -thetaCuspReflectedSourceDecayFlux 0 s := by
    funext s
    rw [iteratedDeriv_one]
    exact (hasDerivAt_thetaCuspReflectedSourceProduct 0 s).deriv
  have hsourceJet :
      iteratedDeriv 2 (thetaCuspReflectedSourceProduct 0) t =
        -thetaCuspReflectedSourceDecayFluxCurvature 0 t := by
    rw [show iteratedDeriv 2 (thetaCuspReflectedSourceProduct 0) =
      deriv (iteratedDeriv 1 (thetaCuspReflectedSourceProduct 0)) by
        rw [show 2 = 1 + 1 by norm_num, iteratedDeriv_succ]]
    rw [hsourceOne]
    exact (hasDerivAt_thetaCuspReflectedSourceDecayFlux 0 t).neg.deriv
  unfold thetaCuspCompletedProductFiberHigherTailDecayFluxCurvature
    thetaCuspCompletedProductFiberFirstDecayFluxCurvature
  rw [htailJet, hsourceJet, hfirstJet]
  ring

/-- At modular center and positive displacement, the residual cofinal
algebraic numerator is the literal functional fifth-root numerator of the
higher product-fibre tail. -/
theorem thetaCuspCompletedProductFiberHigherTailResidualFifthRootCurvatureNumerator_zero_eq_functional
    {t : ℝ} (ht : 0 < t) :
    thetaCuspCompletedProductFiberHigherTailResidualFifthRootCurvatureNumerator 0 t =
      thetaCuspCompletedProductFiberHigherTailFifthRootCurvatureNumerator 0 t := by
  unfold thetaCuspCompletedProductFiberHigherTailFifthRootCurvatureNumerator
  rw [HilbertMetric.fifthRootDividedDropCurvatureNumerator_eq_jetForm]
  unfold thetaCuspCompletedProductFiberHigherTailResidualFifthRootCurvatureNumerator
    thetaCuspCompletedProductFiberHigherTailDrop
  rw [← thetaCuspCompletedProductFiberHigherTailDecayFlux_zero_eq_residual ht,
    ← thetaCuspCompletedProductFiberHigherTailDecayFluxCurvature_zero_eq_residual ht]
  rfl

/-- At positive modular-center displacement, the algebraic cofinal budget is
exactly the fully functional first-fibre/higher-tail budget. -/
theorem thetaCuspCompletedProductFiberCofinalCurvatureAbsorptionBudget_zero_eq_functional
    {t : ℝ} (ht : 0 < t) :
    thetaCuspCompletedProductFiberCofinalCurvatureAbsorptionBudget 0 t =
      thetaCuspCompletedProductFiberCofinalFunctionalAbsorptionBudgetAtZero t := by
  unfold thetaCuspCompletedProductFiberCofinalCurvatureAbsorptionBudget
    thetaCuspCompletedProductFiberCofinalFunctionalAbsorptionBudgetAtZero
  rw [thetaCuspCompletedProductFiberFirstFifthRootCurvatureNumerator_eq_functional,
    thetaCuspCompletedProductFiberHigherTailResidualFifthRootCurvatureNumerator_zero_eq_functional
      ht]

/-- **Cofinal fifth-root total-variance law.**  Peel the completed first
product fibre from the literal theta source.  The residual accumulated drop
is exactly the cofinal higher-fibre drop.  For any proposed first-fibre jet
`(d,j)`, the only interaction term is the square of the projective flux
mismatch.

This theorem has no sign, smoothness, or convergence hypotheses: convergence
entered earlier through the exact completed product-fibre decomposition. -/
theorem thetaCuspReflectedSourceFifthRootCurvature_peel_firstFiber
    (u t d j : ℝ) :
    thetaCuspCompletedProductFiberFirstDrop u t *
          thetaCuspCompletedProductFiberHigherTailDrop u t *
          thetaCuspReflectedSourceFifthRootCurvatureNumerator u t =
      thetaCuspCompletedProductFiberHigherTailDrop u t *
          thetaCuspReflectedSourceFirstDrop u t *
          HilbertMetric.fifthRootCurvatureJetForm t
            (thetaCuspCompletedProductFiberFirstDrop u t) d j +
        thetaCuspCompletedProductFiberFirstDrop u t *
          thetaCuspReflectedSourceFirstDrop u t *
          HilbertMetric.fifthRootCurvatureJetForm t
            (thetaCuspCompletedProductFiberHigherTailDrop u t)
            (thetaCuspReflectedSourceDecayFlux u t - d)
            (thetaCuspReflectedSourceDecayFluxCurvature u t - j) +
        4 * t ^ 2 *
          (thetaCuspCompletedProductFiberFirstDrop u t *
              thetaCuspReflectedSourceDecayFlux u t -
            thetaCuspReflectedSourceFirstDrop u t * d) ^ 2 := by
  have hpeel := HilbertMetric.fifthRootCurvatureJetForm_peel_totalVariance
    t
    (thetaCuspReflectedSourceFirstDrop u t)
    (thetaCuspReflectedSourceDecayFlux u t)
    (thetaCuspReflectedSourceDecayFluxCurvature u t)
    (thetaCuspCompletedProductFiberFirstDrop u t) d j
  rw [thetaCuspReflectedSourceFifthRootCurvatureNumerator_eq_jetForm]
  rw [thetaCuspReflectedSourceFirstDrop_eq_firstFiber_add_higherTail] at hpeel ⊢
  ring_nf at hpeel ⊢
  exact hpeel

/-- Literal first-fibre specialization of the cofinal total-variance law. -/
theorem thetaCuspReflectedSourceFifthRootCurvature_mul_firstFiber_higherTail_eq_budget
    (u t : ℝ) :
    thetaCuspCompletedProductFiberFirstDrop u t *
          thetaCuspCompletedProductFiberHigherTailDrop u t *
          thetaCuspReflectedSourceFifthRootCurvatureNumerator u t =
      thetaCuspCompletedProductFiberCofinalCurvatureAbsorptionBudget u t := by
  simpa [thetaCuspCompletedProductFiberCofinalCurvatureAbsorptionBudget,
    thetaCuspCompletedProductFiberFirstFifthRootCurvatureNumerator,
    thetaCuspCompletedProductFiberHigherTailResidualFifthRootCurvatureNumerator] using
    thetaCuspReflectedSourceFifthRootCurvature_peel_firstFiber u t
      (thetaCuspCompletedProductFiberFirstDecayFlux u t)
      (thetaCuspCompletedProductFiberFirstDecayFluxCurvature u t)

/-- The first-fibre-rise chamber is nonempty, and the cofinal higher-tail drop
is then strictly positive. -/
theorem exists_thetaCuspCompletedProductFiber_firstDrop_neg_higherTailDrop_pos :
    ∃ t : ℝ, 0 < t ∧
      thetaCuspCompletedProductFiberFirstDrop 0 t < 0 ∧
      0 < thetaCuspCompletedProductFiberHigherTailDrop 0 t := by
  obtain ⟨t, ht, hrise⟩ :=
    exists_thetaCuspCompletedProductFiberAmplitude_one_rise
  have hsource := thetaCuspReflectedSourceFirstDrop_pos 0 ht
  have hsplit :=
    thetaCuspReflectedSourceFirstDrop_eq_firstFiber_add_higherTail 0 t
  have ha : thetaCuspCompletedProductFiberFirstDrop 0 t < 0 := by
    unfold thetaCuspCompletedProductFiberFirstDrop
    linarith
  refine ⟨t, ht, ?_, ?_⟩
  · exact ha
  · linarith

/-- **Exact hard-core reduction in the first-fibre-rise chamber.**  Whenever
the completed first product fibre rises, the cofinal tail drop is positive.
The prefactor in the total-variance law is therefore negative, so literal
theta `C₅ ≥ 0` is equivalent to the cofinal absorption budget having the
opposite sign.

This equivalence isolates the precise statement a cofinal product-fibre proof
must establish; componentwise positivity cannot replace it. -/
theorem thetaCuspReflectedSourceFifthRootCurvatureNumerator_nonneg_iff_cofinalBudget_nonpos
    {u t : ℝ} (ht : 0 < t)
    (hrise :
      thetaCuspCompletedProductFiberAmplitude 1 u 0 <
        thetaCuspCompletedProductFiberAmplitude 1 u t) :
    0 ≤ thetaCuspReflectedSourceFifthRootCurvatureNumerator u t ↔
      thetaCuspCompletedProductFiberCofinalCurvatureAbsorptionBudget u t ≤ 0 := by
  have ha : thetaCuspCompletedProductFiberFirstDrop u t < 0 := by
    unfold thetaCuspCompletedProductFiberFirstDrop
    linarith
  have hsource := thetaCuspReflectedSourceFirstDrop_pos u ht
  have hsplit :=
    thetaCuspReflectedSourceFirstDrop_eq_firstFiber_add_higherTail u t
  have hb : 0 < thetaCuspCompletedProductFiberHigherTailDrop u t := by
    linarith
  have hab :
      thetaCuspCompletedProductFiberFirstDrop u t *
        thetaCuspCompletedProductFiberHigherTailDrop u t < 0 :=
    mul_neg_of_neg_of_pos ha hb
  have hbudget :=
    thetaCuspReflectedSourceFifthRootCurvature_mul_firstFiber_higherTail_eq_budget u t
  constructor
  · intro hC
    rw [← hbudget]
    exact mul_nonpos_of_nonpos_of_nonneg hab.le hC
  · intro hB
    by_contra hC
    have hCneg : thetaCuspReflectedSourceFifthRootCurvatureNumerator u t < 0 :=
      lt_of_not_ge hC
    have hprod : 0 <
        thetaCuspCompletedProductFiberFirstDrop u t *
          thetaCuspCompletedProductFiberHigherTailDrop u t *
          thetaCuspReflectedSourceFifthRootCurvatureNumerator u t :=
      mul_pos_of_neg_of_neg hab hCneg
    rw [hbudget] at hprod
    exact (not_lt_of_ge hB) hprod

/-- Fully functional modular-center hard core.  In every positive
first-fibre-rise chamber, source `C₅ ≥ 0` is exactly the nonpositivity of a
budget built from the literal first-fibre and infinite cofinal-tail curvature
functionals plus their projective-flux mismatch square. -/
theorem thetaCuspReflectedSourceFifthRootCurvatureNumerator_zero_nonneg_iff_cofinalFunctionalBudget_nonpos
    {t : ℝ} (ht : 0 < t)
    (hrise :
      thetaCuspCompletedProductFiberAmplitude 1 0 0 <
        thetaCuspCompletedProductFiberAmplitude 1 0 t) :
    0 ≤ thetaCuspReflectedSourceFifthRootCurvatureNumerator 0 t ↔
      thetaCuspCompletedProductFiberCofinalFunctionalAbsorptionBudgetAtZero t ≤ 0 := by
  rw [← thetaCuspCompletedProductFiberCofinalCurvatureAbsorptionBudget_zero_eq_functional ht]
  exact
    thetaCuspReflectedSourceFifthRootCurvatureNumerator_nonneg_iff_cofinalBudget_nonpos
      ht hrise

end

