import GaloisForLFunctions.RHTower.FiniteAndersonLocalizationTailLaw
import GaloisForLFunctions.RHTower.FiniteLocalizedSpectralSupportRecurrenceLaw
import GaloisForLFunctions.RHTower.FiniteQuantumSurvivalHistoryLaw

/-!
# Anderson-localized survival recurrence

This file composes three independent laws:

1. exponential localization plus shell growth bounds the spectral weight
   outside a localization ball;
2. synchronizing the modes inside that ball has phase exponent exactly the
   ball cardinality minus one; and
3. the resulting scalar history is exactly the local survival probability.

The result is a deterministic localization-volume recurrence law.  It does
not prove that a concrete random Anderson Hamiltonian supplies the
site-labelled localized eigensystem used by its hypotheses.
-/

open scoped BigOperators

noncomputable section

namespace RHTower

/-- Modes whose assigned localization centres lie inside radius `R`. -/
def finiteLocalizationBall
    {d : ℕ} (radius : Fin d → ℕ) (R : ℕ) : Finset (Fin d) :=
  Finset.univ.filter fun i => radius i ≤ R

/-- Explicit spectral-tail budget generated by exponential localization and
geometric shell growth. -/
def finiteLocalizationGeometricTailBound
    (C μ A B : ℝ) (R : ℕ) : ℝ :=
  A * C * (B * Real.exp (-2 * μ)) ^ (R + 1) *
    (1 - B * Real.exp (-2 * μ))⁻¹

/-- The subset tail outside the localization ball is definitionally the
radius tail used by the localization theorem. -/
theorem finiteLocalizedSubsetTail_localizationBall_eq
    {d : ℕ} (p : Fin d → ℝ) (radius : Fin d → ℕ) (R : ℕ) :
    finiteLocalizedSubsetTail p (finiteLocalizationBall radius R) =
      finiteLocalizedSpectralTail p radius R := by
  classical
  unfold finiteLocalizedSubsetTail finiteLocalizationBall
    finiteLocalizedSpectralTail
  rw [Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro i _hi
  by_cases h : radius i ≤ R
  · simp [h]
  · have hR : R < radius i := by omega
    simp [h, hR]

/--
The abstract localized coefficient history is exactly the physical
survival-probability deviation for normalized spectral weights.
-/
theorem finiteLocalizedSpectralDeviation_eq_survivalDeviation
    {d : ℕ} (p : Fin d → ℝ) (z : Fin d → ℂ)
    (hpSum : ∑ i, p i = 1) :
    finiteLocalizedSpectralDeviation p z =
      finiteSpectralSurvivalDeviation p z := by
  have hcoeff :
      finiteLocalizedSpectralCoefficient p =
        finiteSpectralSurvivalCoefficient p := by
    funext a i j
    rfl
  unfold finiteLocalizedSpectralDeviation
  rw [hcoeff]
  exact
    finiteQuantumExpectationTotalDeviation_survivalCoefficient_normalized
      p z hpSum

/--
**Finite localization-volume survival recurrence law.**

For every normalized finite spectral packet with exponential site-weight
decay and controlled shell growth, some positive return has survival loss
at most the explicit localization tail plus phase resolution.  Its deadline
exponent is exactly the number of modes inside the chosen localization ball
minus one, not the ambient spectral dimension.
-/
theorem exists_finiteAndersonLocalizedSurvival_recurrence
    {d : ℕ} (p : Fin d → ℝ)
    (hp : ∀ i, 0 ≤ p i) (hpSum : ∑ i, p i = 1)
    (radius : Fin d → ℕ) (R : ℕ)
    (hBall : (finiteLocalizationBall radius R).Nonempty)
    (C μ A B : ℝ)
    (hC : 0 ≤ C) (hμ : 0 < μ) (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hcontract : B * Real.exp (-2 * μ) < 1)
    (hdecay :
      ∀ i, p i ≤ C * Real.exp (-2 * μ * (radius i : ℝ)))
    (hshell :
      ∀ m,
        ((finiteLocalizationShell radius m).card : ℝ) ≤ A * B ^ m)
    (energy : Fin d → ℝ) (Q : ℕ) :
    ∃ n : ℕ, 0 < n ∧
      n ≤ (Q + 1) ^
        ((finiteLocalizationBall radius R).card - 1) ∧
      finiteSpectralSurvivalDeviation p
          (finiteObserverHamiltonianVertexPhase (n : ℝ) energy) ≤
        4 * finiteLocalizationGeometricTailBound C μ A B R +
          2 * (2 * Real.pi / (Q + 1 : ℝ)) := by
  have htail :
      finiteLocalizedSubsetTail p (finiteLocalizationBall radius R) ≤
        finiteLocalizationGeometricTailBound C μ A B R := by
    rw [finiteLocalizedSubsetTail_localizationBall_eq]
    exact finiteLocalizedSpectralTail_le_shellExponential
      p radius R C μ A B hC hμ hA hB hcontract hdecay hshell
  obtain ⟨n, hn0, hnQ, hdev⟩ :=
    exists_finiteLocalizedSpectralSupport_recurrence
      p hp hpSum (finiteLocalizationBall radius R) hBall
      (finiteLocalizationGeometricTailBound C μ A B R) htail
      energy Q
  refine ⟨n, hn0, hnQ, ?_⟩
  rw [← finiteLocalizedSpectralDeviation_eq_survivalDeviation p _ hpSum]
  simpa [finiteLocalizedSpectralRecurrenceBudget] using hdev

/--
Volume-growth corollary: any explicit upper bound `Veff` on the localization
ball cardinality replaces the exact ball count in the recurrence deadline.
-/
theorem exists_finiteAndersonLocalizedSurvival_volume_recurrence
    {d : ℕ} (p : Fin d → ℝ)
    (hp : ∀ i, 0 ≤ p i) (hpSum : ∑ i, p i = 1)
    (radius : Fin d → ℕ) (R Veff : ℕ)
    (hBall : (finiteLocalizationBall radius R).Nonempty)
    (hvolume : (finiteLocalizationBall radius R).card ≤ Veff)
    (C μ A B : ℝ)
    (hC : 0 ≤ C) (hμ : 0 < μ) (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hcontract : B * Real.exp (-2 * μ) < 1)
    (hdecay :
      ∀ i, p i ≤ C * Real.exp (-2 * μ * (radius i : ℝ)))
    (hshell :
      ∀ m,
        ((finiteLocalizationShell radius m).card : ℝ) ≤ A * B ^ m)
    (energy : Fin d → ℝ) (Q : ℕ) :
    ∃ n : ℕ, 0 < n ∧
      n ≤ (Q + 1) ^ (Veff - 1) ∧
      finiteSpectralSurvivalDeviation p
          (finiteObserverHamiltonianVertexPhase (n : ℝ) energy) ≤
        4 * finiteLocalizationGeometricTailBound C μ A B R +
          2 * (2 * Real.pi / (Q + 1 : ℝ)) := by
  obtain ⟨n, hn0, hnBall, hdev⟩ :=
    exists_finiteAndersonLocalizedSurvival_recurrence
      p hp hpSum radius R hBall C μ A B hC hμ hA hB
      hcontract hdecay hshell energy Q
  refine ⟨n, hn0, hnBall.trans ?_, hdev⟩
  exact Nat.pow_le_pow_right (by omega)
    (Nat.sub_le_sub_right hvolume 1)

/--
**Non-vacuous localized survival escape--return law.**

At the localization-volume budget, either local survival never leaves its
initial neighborhood, or an exit is followed strictly later by a return.
The same ball-cardinality exponent controls the post-exit deadline.
-/
theorem finiteAndersonLocalizedSurvival_neverExits_or_postExit_return
    {d : ℕ} (p : Fin d → ℝ)
    (hp : ∀ i, 0 ≤ p i) (hpSum : ∑ i, p i = 1)
    (radius : Fin d → ℕ) (R : ℕ)
    (hBall : (finiteLocalizationBall radius R).Nonempty)
    (C μ A B : ℝ)
    (hC : 0 ≤ C) (hμ : 0 < μ) (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hcontract : B * Real.exp (-2 * μ) < 1)
    (hdecay :
      ∀ i, p i ≤ C * Real.exp (-2 * μ * (radius i : ℝ)))
    (hshell :
      ∀ m,
        ((finiteLocalizationShell radius m).card : ℝ) ≤ A * B ^ m)
    (energy : Fin d → ℝ) (Q : ℕ)
    (guardTime : ℝ) (hguard : 0 < guardTime) :
    (∀ t : ℝ, 0 ≤ t →
      finiteSpectralSurvivalDeviation p
          (finiteObserverHamiltonianVertexPhase t energy) ≤
        4 * finiteLocalizationGeometricTailBound C μ A B R +
          2 * (2 * Real.pi / (Q + 1 : ℝ))) ∨
    ∃ exitTime : ℝ, ∃ n : ℕ,
      0 ≤ exitTime ∧
      0 < n ∧
      n ≤ (Q + 1) ^
        ((finiteLocalizationBall radius R).card - 1) ∧
      4 * finiteLocalizationGeometricTailBound C μ A B R +
          2 * (2 * Real.pi / (Q + 1 : ℝ)) <
        finiteSpectralSurvivalDeviation p
          (finiteObserverHamiltonianVertexPhase
            exitTime energy) ∧
      exitTime < (n : ℝ) * (exitTime + guardTime) ∧
      (n : ℝ) * (exitTime + guardTime) ≤
        (((Q + 1) ^
          ((finiteLocalizationBall radius R).card - 1) : ℕ) : ℝ) *
            (exitTime + guardTime) ∧
      finiteSpectralSurvivalDeviation p
          (finiteObserverHamiltonianVertexPhase
            ((n : ℝ) * (exitTime + guardTime)) energy) ≤
        4 * finiteLocalizationGeometricTailBound C μ A B R +
          2 * (2 * Real.pi / (Q + 1 : ℝ)) := by
  have htail :
      finiteLocalizedSubsetTail p (finiteLocalizationBall radius R) ≤
        finiteLocalizationGeometricTailBound C μ A B R := by
    rw [finiteLocalizedSubsetTail_localizationBall_eq]
    exact finiteLocalizedSpectralTail_le_shellExponential
      p radius R C μ A B hC hμ hA hB hcontract hdecay hshell
  simpa only [finiteLocalizedSpectralRecurrenceBudget,
    finiteLocalizedSpectralDeviation_eq_survivalDeviation p _ hpSum] using
    finiteLocalizedSpectralSupport_neverExits_or_postExit_return
      p hp hpSum (finiteLocalizationBall radius R) hBall
      (finiteLocalizationGeometricTailBound C μ A B R) htail
      energy Q guardTime hguard

end RHTower
