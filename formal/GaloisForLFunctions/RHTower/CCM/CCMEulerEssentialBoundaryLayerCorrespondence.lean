import GaloisForLFunctions.RHTower.CCM.CCMEssentialCuspBoundaryLayer
import GaloisForLFunctions.RHTower.EulerSquarefreeAffineFisherCutoffWard

/-!
# Euler source and the essential CCM boundary layer

The essential Hilbert cusp has a canonical probability coordinate.  Normalize its boundary-layer
energy and rescale `t` by `x = 2t/u`.  At every positive finite scale the resulting CDF is exactly
the unit exponential CDF conditioned on `x ≤ 2/u`.  It therefore converges to `Exp(1)`.

The physical all-integer affine Euler clock converges to the same CDF and carries the same
four-unit Fisher normalization.  Thus the essential cusp is not extraneous at clock/Fisher level:
it is the continuous boundary-layer realization selected by the physical Euler source.

Every theorem is unconditional.  The correspondence does not orient the microscopic
von-Mangoldt first-clock phase and does not assert RH.
-/

open Complex MeasureTheory Set Filter ArithmeticFunction LSeries
open scoped Topology

noncomputable section

namespace RHTower

/-! ## The actual positive von Mangoldt fixed current -/

/-- Complex Euler parameter generated by the critical clock phase of the positive von Mangoldt
fixed current. -/
def ccmEulerPrimeCurrentCriticalParameter (sigma t : ℝ) : ℂ :=
  (sigma : ℂ) - ((t * (sigma - 1) : ℝ) : ℂ) * Complex.I

theorem ccmEulerPrimeCurrentCriticalParameter_re (sigma t : ℝ) :
    (ccmEulerPrimeCurrentCriticalParameter sigma t).re = sigma := by
  simp [ccmEulerPrimeCurrentCriticalParameter]

/-- Normalized characteristic response of the actual positive Euler prime-power current. -/
def ccmEulerPrimeCurrentClockResponse (sigma t : ℝ) : ℂ :=
  infinitePrimeFlux (ccmEulerPrimeCurrentCriticalParameter sigma t) /
    infinitePrimeFlux sigma

/-- In the Euler half-plane the normalized current response is literally the ratio of two
von Mangoldt Dirichlet series. -/
theorem ccmEulerPrimeCurrentClockResponse_eq_vonMangoldtLSeriesRatio
    {sigma : ℝ} (hsigma : 1 < sigma) (t : ℝ) :
    ccmEulerPrimeCurrentClockResponse sigma t =
      LSeries (fun n => (ArithmeticFunction.vonMangoldt n : ℂ))
          (ccmEulerPrimeCurrentCriticalParameter sigma t) /
        LSeries (fun n => (ArithmeticFunction.vonMangoldt n : ℂ)) sigma := by
  rw [ccmEulerPrimeCurrentClockResponse,
    infinitePrimeFlux_eq_vonMangoldtLSeries
      (by simpa [ccmEulerPrimeCurrentCriticalParameter_re] using hsigma),
    infinitePrimeFlux_eq_vonMangoldtLSeries (by simpa using hsigma)]

private theorem tendsto_ccmEulerPrimeCurrentCriticalParameter_nhdsNE
    (t : ℝ) :
    Tendsto (fun sigma : ℝ => ccmEulerPrimeCurrentCriticalParameter sigma t)
      (nhdsWithin 1 (Ioi 1)) (𝓝[≠] (1 : ℂ)) := by
  rw [tendsto_nhdsWithin_iff]
  constructor
  · have hcont :
        ContinuousAt (fun sigma : ℝ =>
          ccmEulerPrimeCurrentCriticalParameter sigma t) 1 := by
      unfold ccmEulerPrimeCurrentCriticalParameter
      fun_prop
    simpa [ccmEulerPrimeCurrentCriticalParameter] using
      hcont.tendsto.mono_left nhdsWithin_le_nhds
  · filter_upwards [self_mem_nhdsWithin] with sigma hsigma
    change 1 < sigma at hsigma
    simp only [mem_compl_iff, mem_singleton_iff]
    intro h
    have hre := congrArg Complex.re h
    rw [ccmEulerPrimeCurrentCriticalParameter_re] at hre
    norm_num at hre
    linarith

private theorem tendsto_realEulerParameter_nhdsNE :
    Tendsto (fun sigma : ℝ => (sigma : ℂ))
      (nhdsWithin 1 (Ioi 1)) (𝓝[≠] (1 : ℂ)) := by
  rw [tendsto_nhdsWithin_iff]
  constructor
  · simpa using!
      Complex.continuous_ofReal.continuousAt.tendsto.mono_left
        nhdsWithin_le_nhds
  · filter_upwards [self_mem_nhdsWithin] with sigma hsigma
    simpa using hsigma.ne'

private theorem infinitePrimeFlux_real_ne_zero
    {sigma : ℝ} (hsigma : 1 < sigma) :
    infinitePrimeFlux sigma ≠ 0 := by
  have hpos := vonMangoldtPrimeLaplaceChannel_pos (sub_pos.mpr hsigma)
  have heq :
      vonMangoldtPrimeLaplaceChannel (sigma - 1) =
        infinitePrimeFlux sigma := by
    rw [vonMangoldtPrimeLaplaceChannel_eq_logDeriv (sub_pos.mpr hsigma),
      infinitePrimeFlux, logDeriv_apply]
    push_cast
    ring_nf
  rw [heq] at hpos
  intro hzero
  have hre := (Complex.pos_iff.mp hpos).1
  rw [hzero] at hre
  norm_num at hre

/-- **Positive Euler-current critical clock law.**  The actual von Mangoldt fixed current selects
the unit exponential characteristic function at the critical boundary.  This is a source theorem,
not a squarefree surrogate. -/
theorem tendsto_ccmEulerPrimeCurrentClockResponse (t : ℝ) :
    Tendsto (fun sigma : ℝ => ccmEulerPrimeCurrentClockResponse sigma t)
      (nhdsWithin 1 (Ioi 1))
      (nhds ((1 - (t : ℂ) * Complex.I)⁻¹)) := by
  let q : ℂ := 1 - (t : ℂ) * Complex.I
  have hq : q ≠ 0 := by
    intro h
    have hre := congrArg Complex.re h
    simp [q, Complex.mul_re] at hre
  have hresParam :
      Tendsto
        (fun sigma : ℝ =>
          (ccmEulerPrimeCurrentCriticalParameter sigma t - 1) *
            infinitePrimeFlux (ccmEulerPrimeCurrentCriticalParameter sigma t))
        (nhdsWithin 1 (Ioi 1)) (nhds 1) := by
    have h := neg_logDeriv_zeta_residue.comp
      (tendsto_ccmEulerPrimeCurrentCriticalParameter_nhdsNE t)
    apply h.congr'
    filter_upwards with sigma
    simp only [Function.comp_apply, infinitePrimeFlux, logDeriv_apply]
    ring_nf
  have hresReal :
      Tendsto
        (fun sigma : ℝ =>
          ((sigma : ℂ) - 1) * infinitePrimeFlux sigma)
        (nhdsWithin 1 (Ioi 1)) (nhds 1) := by
    have h := neg_logDeriv_zeta_residue.comp
      tendsto_realEulerParameter_nhdsNE
    apply h.congr'
    filter_upwards with sigma
    simp only [Function.comp_apply, infinitePrimeFlux, logDeriv_apply]
    ring_nf
  have hregularized :
      Tendsto
        (fun sigma : ℝ =>
          ((ccmEulerPrimeCurrentCriticalParameter sigma t - 1) *
              infinitePrimeFlux
                (ccmEulerPrimeCurrentCriticalParameter sigma t)) /
            ((((sigma : ℂ) - 1) * infinitePrimeFlux sigma) * q))
        (nhdsWithin 1 (Ioi 1)) (nhds q⁻¹) := by
    have h := hresParam.div (hresReal.mul_const q)
      (mul_ne_zero one_ne_zero hq)
    simpa [q, hq, Pi.div_apply] using! h
  apply hregularized.congr'
  filter_upwards [self_mem_nhdsWithin] with sigma hsigma
  change 1 < sigma at hsigma
  have hepsilon : ((sigma : ℂ) - 1) ≠ 0 := by
    exact sub_ne_zero.mpr (by exact_mod_cast hsigma.ne')
  have hflux : infinitePrimeFlux sigma ≠ 0 :=
    infinitePrimeFlux_real_ne_zero hsigma
  have hparam :
      ccmEulerPrimeCurrentCriticalParameter sigma t - 1 =
        ((sigma : ℂ) - 1) * q := by
    unfold ccmEulerPrimeCurrentCriticalParameter q
    push_cast
    ring_nf
  rw [ccmEulerPrimeCurrentClockResponse, hparam]
  field_simp [hepsilon, hflux, hq]

/-- The positive Euler current and the unit exponential probability law have the same critical
characteristic response. -/
theorem tendsto_ccmEulerPrimeCurrentClockResponse_eq_exponentialCharFun
    (t : ℝ) :
    Tendsto (fun sigma : ℝ => ccmEulerPrimeCurrentClockResponse sigma t)
      (nhdsWithin 1 (Ioi 1))
      (nhds
        (charFun (mobiusCriticalExponentialProbabilityMeasure : Measure ℝ) t)) := by
  rw [charFun_mobiusCriticalExponentialProbabilityMeasure]
  exact tendsto_ccmEulerPrimeCurrentClockResponse t

/-- The positive Euler current has a universal critical sine response.  Its value is the imaginary
part of the unit exponential characteristic function. -/
theorem tendsto_im_ccmEulerPrimeCurrentClockResponse (t : ℝ) :
    Tendsto (fun sigma : ℝ => (ccmEulerPrimeCurrentClockResponse sigma t).im)
      (nhdsWithin 1 (Ioi 1)) (nhds (t / (1 + t ^ (2 : ℕ)))) := by
  have h :=
    Complex.continuous_im.continuousAt.tendsto.comp
      (tendsto_ccmEulerPrimeCurrentClockResponse t)
  have hvalue :
      ((1 - (t : ℂ) * Complex.I)⁻¹).im = t / (1 + t ^ (2 : ℕ)) := by
    rw [Complex.inv_im]
    simp [Complex.normSq_apply]
    ring_nf
  rw [hvalue] at h
  exact h

/-- Every positive critical phase has eventually positive Abel-smoothed prime-power sine
orientation. -/
theorem eventually_ccmEulerPrimeCurrentClockSineResponse_pos
    {t : ℝ} (ht : 0 < t) :
    ∀ᶠ sigma in nhdsWithin 1 (Ioi 1),
      0 < (ccmEulerPrimeCurrentClockResponse sigma t).im := by
  have hlimit : 0 < t / (1 + t ^ (2 : ℕ)) :=
    div_pos ht (by positivity)
  exact
    (tendsto_order.1
      (tendsto_im_ccmEulerPrimeCurrentClockResponse t)).1 0 hlimit

/-- At the first CCM phase `2π`, actual positive von Mangoldt current is eventually aligned on the
Abel side.  The RH-complete difficulty is therefore de-Abelization to the literal hard aperture,
not orientation of the critical positive current itself. -/
theorem eventually_ccmEulerPrimeCurrent_firstClockSineResponse_pos :
    ∀ᶠ sigma in nhdsWithin 1 (Ioi 1),
      0 < (ccmEulerPrimeCurrentClockResponse sigma (2 * Real.pi)).im :=
  eventually_ccmEulerPrimeCurrentClockSineResponse_pos
    (mul_pos (by norm_num) Real.pi_pos)

/-! ## Complex essential-boundary-layer realization -/

/-- Exact characteristic response of the normalized essential boundary layer in the rescaled
clock coordinate `x = 2t/u`.  It is the transform of the unit exponential law truncated at
`2/u`. -/
def ccmEssentialBoundaryLayerClockResponse (u t : ℝ) : ℂ :=
  (1 - Complex.exp
      (-(((2 / u : ℝ) : ℂ) * (1 - (t : ℂ) * Complex.I)))) /
    ((1 - (t : ℂ) * Complex.I) * (1 - Real.exp (-2 / u)))

private theorem tendsto_ccmEssentialBoundaryLayerClockTail_zero (t : ℝ) :
    Tendsto
      (fun u : ℝ =>
        Complex.exp
          (-(((2 / u : ℝ) : ℂ) * (1 - (t : ℂ) * Complex.I))))
      (𝓝[>] 0) (nhds 0) := by
  rw [tendsto_zero_iff_norm_tendsto_zero]
  convert tendsto_exp_neg_two_div_nhdsGT_zero using 1
  funext u
  rw [Complex.norm_exp]
  simp [Complex.mul_re]
  ring_nf

/-- The finite essential boundary-layer response converges to the full unit exponential
characteristic function. -/
theorem tendsto_ccmEssentialBoundaryLayerClockResponse (t : ℝ) :
    Tendsto (fun u : ℝ => ccmEssentialBoundaryLayerClockResponse u t)
      (𝓝[>] 0) (nhds ((1 - (t : ℂ) * Complex.I)⁻¹)) := by
  let q : ℂ := 1 - (t : ℂ) * Complex.I
  have hq : q ≠ 0 := by
    intro h
    have hre := congrArg Complex.re h
    simp [q, Complex.mul_re] at hre
  have hnum :
      Tendsto
        (fun u : ℝ =>
          1 - Complex.exp
            (-(((2 / u : ℝ) : ℂ) * q)))
        (𝓝[>] 0) (nhds 1) := by
    simpa [q] using
      tendsto_const_nhds.sub
        (tendsto_ccmEssentialBoundaryLayerClockTail_zero t)
  have hdenReal :
      Tendsto (fun u : ℝ => 1 - Real.exp (-2 / u))
        (𝓝[>] 0) (nhds 1) := by
    simpa using tendsto_const_nhds.sub tendsto_exp_neg_two_div_nhdsGT_zero
  have hdenComplex :
      Tendsto (fun u : ℝ => ((1 - Real.exp (-2 / u) : ℝ) : ℂ))
        (𝓝[>] 0) (nhds 1) :=
    Complex.continuous_ofReal.continuousAt.tendsto.comp hdenReal
  have h := hnum.div (tendsto_const_nhds.mul hdenComplex)
    (mul_ne_zero hq one_ne_zero)
  simpa [ccmEssentialBoundaryLayerClockResponse, q, hq, Pi.div_apply] using! h

/-- **Prime-current/essential-cusp complex correspondence.**  The actual von Mangoldt current and
the essential Hilbert boundary layer have asymptotically identical full complex clock response,
not merely matching mass or first moments. -/
theorem tendsto_ccmEulerPrimeCurrentClockResponse_sub_essentialBoundaryLayer
    (t : ℝ) :
    Tendsto
      (fun p : ℝ × ℝ =>
        ccmEulerPrimeCurrentClockResponse p.1 t -
          ccmEssentialBoundaryLayerClockResponse p.2 t)
      ((nhdsWithin 1 (Ioi 1)) ×ˢ (𝓝[>] 0))
      (nhds 0) := by
  have hsource :
      Tendsto
        (fun p : ℝ × ℝ => ccmEulerPrimeCurrentClockResponse p.1 t)
        ((nhdsWithin 1 (Ioi 1)) ×ˢ (𝓝[>] 0))
        (nhds ((1 - (t : ℂ) * Complex.I)⁻¹)) :=
    (tendsto_ccmEulerPrimeCurrentClockResponse t).comp tendsto_fst
  have hcusp :
      Tendsto
        (fun p : ℝ × ℝ => ccmEssentialBoundaryLayerClockResponse p.2 t)
        ((nhdsWithin 1 (Ioi 1)) ×ˢ (𝓝[>] 0))
        (nhds ((1 - (t : ℂ) * Complex.I)⁻¹)) :=
    (tendsto_ccmEssentialBoundaryLayerClockResponse t).comp tendsto_snd
  simpa using hsource.sub hcusp

/-- Energy in the essential cusp between the endpoint and the rescaled clock location `x`.  The
definition by total minus tail is valid globally; the literal head-integral interpretation is used
on `0 ≤ x ≤ 2/u`. -/
def ccmEssentialBoundaryLayerRescaledHeadEnergy (u x : ℝ) : ℝ :=
  ccmEssentialBoundaryLayerEnergy u -
    ccmEssentialBoundaryLayerTailEnergy (u * x / 2) u

/-- Normalized CDF of the essential cusp energy in the source coordinate `x = 2t/u`. -/
def ccmEssentialBoundaryLayerRescaledCDF (u x : ℝ) : ℝ :=
  ccmEssentialBoundaryLayerRescaledHeadEnergy u x /
    ccmEssentialBoundaryLayerEnergy u

/-- Exact head-energy law: after `x = 2t/u`, the essential cusp has unnormalized density
`4u exp(-x)` on its finite interval. -/
theorem ccmEssentialBoundaryLayerRescaledHeadEnergy_eq
    {u x : ℝ} (hu : 0 < u) (hx : 0 ≤ x) (hxu : x ≤ 2 / u) :
    ccmEssentialBoundaryLayerRescaledHeadEnergy u x =
      4 * u * (1 - Real.exp (-x)) := by
  have hcut : u * x / 2 ∈ Icc (0 : ℝ) 1 := by
    constructor
    · positivity
    · calc
        u * x / 2 ≤ u * (2 / u) / 2 := by gcongr
        _ = 1 := by field_simp [hu.ne']
  rw [ccmEssentialBoundaryLayerRescaledHeadEnergy,
    ccmEssentialBoundaryLayerEnergy_eq hu,
    ccmEssentialBoundaryLayerTailEnergy_eq hcut.2 hu]
  have hscale : -2 * (u * x / 2) / u = -x := by
    field_simp [hu.ne']
  rw [hscale]
  ring

/-- Exact conditional-exponential CDF of the finite essential boundary layer. -/
theorem ccmEssentialBoundaryLayerRescaledCDF_eq
    {u x : ℝ} (hu : 0 < u) (hx : 0 ≤ x) (hxu : x ≤ 2 / u) :
    ccmEssentialBoundaryLayerRescaledCDF u x =
      (1 - Real.exp (-x)) / (1 - Real.exp (-2 / u)) := by
  have htail : 0 < 1 - Real.exp (-2 / u) := by
    rw [sub_pos, Real.exp_lt_one_iff]
    exact div_neg_of_neg_of_pos (by norm_num) hu
  rw [ccmEssentialBoundaryLayerRescaledCDF,
    ccmEssentialBoundaryLayerRescaledHeadEnergy_eq hu hx hxu,
    ccmEssentialBoundaryLayerEnergy_eq hu]
  field_simp [hu.ne', htail.ne']

private theorem eventually_le_two_div_nhdsGT_zero
    (x : ℝ) :
    ∀ᶠ u in 𝓝[>] (0 : ℝ), x ≤ 2 / u := by
  have hmul :
      Tendsto (fun u : ℝ => u * x) (𝓝[>] (0 : ℝ)) (nhds 0) := by
    simpa using
      ((tendsto_id.mono_left inf_le_left :
        Tendsto (fun u : ℝ => u) (𝓝[>] (0 : ℝ)) (nhds 0)).mul_const x)
  have hevent : ∀ᶠ u in 𝓝[>] (0 : ℝ), u * x < 2 :=
    (tendsto_order.1 hmul).2 2 (by norm_num)
  filter_upwards [self_mem_nhdsWithin, hevent] with u hu hux
  have hu' : 0 < u := hu
  rw [le_div_iff₀ hu']
  linarith

/-- The normalized essential cusp energy converges to the unit exponential CDF in its canonical
source coordinate. -/
theorem tendsto_ccmEssentialBoundaryLayerRescaledCDF
    {x : ℝ} (hx : 0 ≤ x) :
    Tendsto (fun u : ℝ => ccmEssentialBoundaryLayerRescaledCDF u x)
      (𝓝[>] 0) (nhds (1 - Real.exp (-x))) := by
  have hden :
      Tendsto (fun u : ℝ => 1 - Real.exp (-2 / u))
        (𝓝[>] 0) (nhds 1) := by
    simpa using tendsto_const_nhds.sub tendsto_exp_neg_two_div_nhdsGT_zero
  have hquot :
      Tendsto
        (fun u : ℝ => (1 - Real.exp (-x)) /
          (1 - Real.exp (-2 / u)))
        (𝓝[>] 0) (nhds ((1 - Real.exp (-x)) / 1)) :=
    tendsto_const_nhds.div hden (by norm_num)
  have hquot' :
      Tendsto
        (fun u : ℝ => (1 - Real.exp (-x)) /
          (1 - Real.exp (-2 / u)))
        (𝓝[>] 0) (nhds (1 - Real.exp (-x))) := by
    simpa using hquot
  apply hquot'.congr'
  filter_upwards [self_mem_nhdsWithin,
    eventually_le_two_div_nhdsGT_zero x] with u hu hxu
  exact (ccmEssentialBoundaryLayerRescaledCDF_eq hu hx hxu).symm

/-- **Euler--essential exponential-clock correspondence.**  Physical all-integer Euler source and
the normalized essential cusp boundary layer converge to the same CDF at every nonnegative clock
coordinate. -/
theorem eulerAffine_and_essentialCusp_select_same_exponentialClock
    {x : ℝ} (hx : 0 ≤ x) :
    Tendsto
        (fun sigma : ℝ => eulerSquarefreeAffineCriticalClockCDF sigma x)
        (nhdsWithin 1 (Ioi 1)) (nhds (1 - Real.exp (-x))) ∧
      Tendsto
        (fun u : ℝ => ccmEssentialBoundaryLayerRescaledCDF u x)
        (𝓝[>] 0) (nhds (1 - Real.exp (-x))) := by
  constructor
  · simpa [hx] using tendsto_eulerSquarefreeAffineCriticalClockCDF x
  · exact tendsto_ccmEssentialBoundaryLayerRescaledCDF hx

/-- **Four-unit source/cusp correspondence.**  The physical affine Euler Fisher energy and the
essential cusp boundary density have the same exact critical normalization. -/
theorem eulerAffineEssentialCusp_fourUnitCorrespondence :
    Tendsto eulerSquarefreeAffineCriticalProjectiveFisherEnergy
        (nhdsWithin 1 (Ioi 1)) (nhds 4) ∧
      Tendsto
        (fun u : ℝ =>
          ccmEssentialBoundaryLayerEnergy u / (1 - Real.exp (-u)))
        (𝓝[>] 0) (nhds 4) :=
  ⟨tendsto_eulerSquarefreeAffineCriticalProjectiveFisherEnergy,
    ccmEssentialBoundaryLayer_fourUnitDensity⟩

/-- Square residuals are invisible even in `L²` while the essential cusp and the full affine
Euler source retain four units.  This packages the exact frontier correction: critical
clock/Fisher data cannot distinguish the physical Euler source from the essential boundary-layer
category. -/
theorem eulerAffineEssentialCusp_residualInvisible_fourUnit :
    Tendsto (eulerSquareResidualCriticalClockMoment 2)
        (nhdsWithin 1 (Ioi 1)) (nhds 0) ∧
      Tendsto eulerSquarefreeAffineCriticalProjectiveFisherEnergy
        (nhdsWithin 1 (Ioi 1)) (nhds 4) ∧
      Tendsto
        (fun u : ℝ =>
          ccmEssentialBoundaryLayerEnergy u / (1 - Real.exp (-u)))
        (𝓝[>] 0) (nhds 4) :=
  ⟨tendsto_eulerSquareResidualCriticalClockMoment_two,
    tendsto_eulerSquarefreeAffineCriticalProjectiveFisherEnergy,
    ccmEssentialBoundaryLayer_fourUnitDensity⟩

end RHTower
