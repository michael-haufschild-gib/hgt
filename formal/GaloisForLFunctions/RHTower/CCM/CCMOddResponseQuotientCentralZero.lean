import GaloisForLFunctions.RHTower.CCM.CCMFullCharpolyCentralZeroNoGo

/-!
# Odd-response quotient central-zero law

CCM clock truncations have one more reflection-even coordinate than reflection-odd coordinates.
For any off-diagonal graded clock, the map from the even sector to the odd sector therefore has a
nontrivial kernel.  If the selected radical lies in the odd sector, quotienting that radical leaves
this independent even zero mode untouched.

Consequently the characteristic polynomial of every odd-response radical quotient still vanishes
at the centered origin.  No scalar normalization of a cofinal odd-response determinant family can
converge locally uniformly to centered Xi.  Thus the response branch does not remove CCM's
cofinal parity-selection problem: any determinant route to Xi must eventually select an even
channel (or change the target by a non-scalar operation that removes the residual zero mode).
-/

noncomputable section

namespace RHTower

open Filter LinearMap Topology

/-- Reflection-even sector of a `2N+1`-dimensional CCM truncation. -/
abbrev CCMEvenSector (N : ℕ) := Fin (N + 1) → ℂ

/-- Reflection-odd sector of a `2N+1`-dimensional CCM truncation. -/
abbrev CCMOddSector (N : ℕ) := Fin N → ℂ

/-- Product realization of the reflection grading. -/
abbrev CCMGradedSector (N : ℕ) := CCMEvenSector N × CCMOddSector N

/-- General off-diagonal operator for the CCM reflection grading. -/
def ccmGradedOffDiagonal
    {N : ℕ}
    (B : CCMOddSector N →ₗ[ℂ] CCMEvenSector N)
    (C : CCMEvenSector N →ₗ[ℂ] CCMOddSector N) :
    CCMGradedSector N →ₗ[ℂ] CCMGradedSector N where
  toFun v := (B v.2, C v.1)
  map_add' v w := by ext <;> simp
  map_smul' a v := by ext <;> simp

@[simp]
theorem ccmGradedOffDiagonal_apply
    {N : ℕ}
    (B : CCMOddSector N →ₗ[ℂ] CCMEvenSector N)
    (C : CCMEvenSector N →ₗ[ℂ] CCMOddSector N)
    (v : CCMGradedSector N) :
    ccmGradedOffDiagonal B C v = (B v.2, C v.1) := rfl

/-- Line generated by a selected odd radical vector. -/
def ccmOddRadicalLine {N : ℕ} (o : CCMOddSector N) :
    Submodule ℂ (CCMGradedSector N) :=
  ℂ ∙ ((0, o) : CCMGradedSector N)

/-- An odd zero vector generates an invariant line for the off-diagonal clock. -/
theorem ccmOddRadicalLine_invariant
    {N : ℕ}
    (B : CCMOddSector N →ₗ[ℂ] CCMEvenSector N)
    (C : CCMEvenSector N →ₗ[ℂ] CCMOddSector N)
    (o : CCMOddSector N) (hBo : B o = 0) :
    ccmOddRadicalLine o ≤
      (ccmOddRadicalLine o).comap (ccmGradedOffDiagonal B C) := by
  unfold ccmOddRadicalLine
  rw [Submodule.span_singleton_le_iff_mem, Submodule.mem_comap]
  change (B o, C 0) ∈ ℂ ∙ ((0, o) : CCMGradedSector N)
  rw [hBo, map_zero]
  exact Submodule.zero_mem _

/-- Clock induced after cancelling one selected odd radical line. -/
def ccmOddRadicalQuotientCompletion
    {N : ℕ}
    (B : CCMOddSector N →ₗ[ℂ] CCMEvenSector N)
    (C : CCMEvenSector N →ₗ[ℂ] CCMOddSector N)
    (o : CCMOddSector N) (hBo : B o = 0) :
    (CCMGradedSector N ⧸ ccmOddRadicalLine o) →ₗ[ℂ]
      (CCMGradedSector N ⧸ ccmOddRadicalLine o) :=
  (ccmOddRadicalLine o).mapQ (ccmOddRadicalLine o)
    (ccmGradedOffDiagonal B C)
    (ccmOddRadicalLine_invariant B C o hBo)

/-- **Odd-response residual-zero law.** Cancelling an odd radical line leaves a nonzero even zero
mode because the even sector has dimension `N+1` and the odd sector has dimension `N`. -/
theorem exists_nonzero_kernel_ccmOddRadicalQuotientCompletion
    {N : ℕ}
    (B : CCMOddSector N →ₗ[ℂ] CCMEvenSector N)
    (C : CCMEvenSector N →ₗ[ℂ] CCMOddSector N)
    (o : CCMOddSector N) (hBo : B o = 0) :
    ∃ q : CCMGradedSector N ⧸ ccmOddRadicalLine o,
      q ≠ 0 ∧ ccmOddRadicalQuotientCompletion B C o hBo q = 0 := by
  have hdim : Module.finrank ℂ (CCMOddSector N) <
      Module.finrank ℂ (CCMEvenSector N) := by
    simp [CCMOddSector, CCMEvenSector]
  have hker : LinearMap.ker C ≠ ⊥ := C.ker_ne_bot_of_finrank_lt hdim
  have hlt : (⊥ : Submodule ℂ (CCMEvenSector N)) < LinearMap.ker C :=
    bot_lt_iff_ne_bot.mpr hker
  obtain ⟨e, heker, heBot⟩ := SetLike.exists_of_lt hlt
  have he : e ≠ 0 := by
    intro he0
    apply heBot
    simp [he0]
  have hCe : C e = 0 := LinearMap.mem_ker.mp heker
  let v : CCMGradedSector N := (e, 0)
  let q : CCMGradedSector N ⧸ ccmOddRadicalLine o :=
    (ccmOddRadicalLine o).mkQ v
  have hq : q ≠ 0 := by
    intro hq0
    have hvline : v ∈ ccmOddRadicalLine o :=
      (Submodule.Quotient.mk_eq_zero (ccmOddRadicalLine o)).mp hq0
    obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp hvline
    have hfirst : (0 : CCMEvenSector N) = e := by
      simpa [ccmOddRadicalLine, v] using congrArg Prod.fst ha
    exact he hfirst.symm
  refine ⟨q, hq, ?_⟩
  change (ccmOddRadicalLine o).mkQ (ccmGradedOffDiagonal B C v) = 0
  have hAv : ccmGradedOffDiagonal B C v = 0 := by
    ext <;> simp [v, hCe]
  rw [hAv]
  rfl

/-- The odd-response radical-quotient characteristic polynomial retains a central zero. -/
theorem ccmOddRadicalQuotientCompletion_charpoly_eval_zero
    {N : ℕ}
    (B : CCMOddSector N →ₗ[ℂ] CCMEvenSector N)
    (C : CCMEvenSector N →ₗ[ℂ] CCMOddSector N)
    (o : CCMOddSector N) (hBo : B o = 0) :
    (ccmOddRadicalQuotientCompletion B C o hBo).charpoly.eval 0 = 0 := by
  obtain ⟨q, hq, hAq⟩ :=
    exists_nonzero_kernel_ccmOddRadicalQuotientCompletion B C o hBo
  exact linearMap_charpoly_eval_zero_of_nontrivial_kernel _ q hq hAq

/-- **Cofinal odd-response determinant no-go.** Arbitrary scalar normalizations of odd-response
radical-quotient characteristic polynomials cannot converge locally uniformly to centered Xi. -/
theorem not_ccmOddRadicalQuotientCharpoly_tendstoLocallyUniformly_XiC
    {N : ℕ → ℕ}
    (B : ∀ k, CCMOddSector (N k) →ₗ[ℂ] CCMEvenSector (N k))
    (C : ∀ k, CCMEvenSector (N k) →ₗ[ℂ] CCMOddSector (N k))
    (o : ∀ k, CCMOddSector (N k))
    (hBo : ∀ k, B k (o k) = 0)
    (u : ℕ → ℂ → ℂ) :
    ¬ TendstoLocallyUniformly
      (fun k z => u k z *
        (ccmOddRadicalQuotientCompletion (B k) (C k) (o k) (hBo k)).charpoly.eval z)
      XiC atTop := by
  apply not_tendstoLocallyUniformly_XiC_of_central_zero
  intro k
  rw [ccmOddRadicalQuotientCompletion_charpoly_eval_zero
    (B k) (C k) (o k) (hBo k), mul_zero]

end RHTower
