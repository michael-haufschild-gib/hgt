import GaloisForLFunctions.RHTower.Deninger.DeningerPacketFrobeniusQuotientNontrivial
import Mathlib.Topology.Algebra.Group.Quotient

/-!
# Connes--Consani arithmetic-Jacobian prime fibre

Connes--Consani, *On the Jacobian of Spec Z* (2026), identify the universal
fibre over the prime orbit `C_p` with

`(K^(p) × ℝ) / ((u,t) ~ (p*u,t+log p))`,

where `K^(p) = ∏_{ℓ ≠ p} ℤ_ℓˣ`, and prove that multiplication of adelic
classes makes this fibre a topological group.  The additive presentation below
formalizes that literal twisted mapping torus: its deck subgroup is generated
by the pair consisting of diagonal Frobenius and `log p`.

The final section goes beyond the literature statement.  There is a canonical
continuous surjection from the twisted fibre to the earlier closure-quotient
packet times its suspension circle.  It is not injective: quotienting by the
Frobenius closure before suspension erases a nonzero horizontal Frobenius
class.  Thus the closure-quotient product is a proper receiver quotient, not
the universal arithmetic-Jacobian prime fibre.
-/

namespace RHTower

noncomputable section

private abbrev PrimeUnits (p : Nat.Primes) := DeningerPacketUnits p

/-- Deck generator `(p, log p)` in additive notation on the away-prime unit
group. -/
def ccmArithmeticJacobianPrimeDeck (p : Nat.Primes) :
    Additive (PrimeUnits p) × ℝ :=
  (Additive.ofMul (deningerPacketFrobeniusUnit p), Real.log (p : ℝ))

/-- Cyclic deck subgroup generated by diagonal arithmetic Frobenius and one
prime period. -/
def ccmArithmeticJacobianPrimeDeckSubgroup (p : Nat.Primes) :
    AddSubgroup (Additive (PrimeUnits p) × ℝ) :=
  AddSubgroup.zmultiples (ccmArithmeticJacobianPrimeDeck p)

/-- Connes--Consani's literal universal prime fibre
`(K^(p) × ℝ)/ℤ(p,log p)`. -/
abbrev CCMArithmeticJacobianPrimeFibre (p : Nat.Primes) :=
  (Additive (PrimeUnits p) × ℝ) ⧸
    ccmArithmeticJacobianPrimeDeckSubgroup p

/-- Quotient projection onto the arithmetic-Jacobian prime fibre. -/
def ccmArithmeticJacobianPrimeFibreMk (p : Nat.Primes) :
    Additive (PrimeUnits p) × ℝ →+ CCMArithmeticJacobianPrimeFibre p :=
  QuotientAddGroup.mk' (ccmArithmeticJacobianPrimeDeckSubgroup p)

/-- Connes--Consani Proposition 7.3 at the mapping-torus presentation: the
universal prime fibre has its canonical topological abelian group structure. -/
theorem ccmArithmeticJacobianPrimeFibre_isTopologicalAddGroup
    (p : Nat.Primes) :
    IsTopologicalAddGroup (CCMArithmeticJacobianPrimeFibre p) := by
  infer_instance

/-- Generator of prime-orbit monodromy: literal multiplication by diagonal
`p` on all away-prime local units. -/
def ccmArithmeticJacobianPrimeMonodromy (p : Nat.Primes) :
    PrimeUnits p ≃ₜ PrimeUnits p :=
  Homeomorph.mulLeft (deningerPacketFrobeniusUnit p)

@[simp]
theorem ccmArithmeticJacobianPrimeMonodromy_apply
    (p : Nat.Primes) (u : PrimeUnits p) :
    ccmArithmeticJacobianPrimeMonodromy p u =
      deningerPacketFrobeniusUnit p * u :=
  rfl

theorem ccmArithmeticJacobianPrimePeriod_pos (p : Nat.Primes) :
    0 < Real.log (p : ℝ) :=
  Real.log_pos (by exact_mod_cast p.2.one_lt)

/-- Connes--Consani's displayed mapping-torus relation
`(u,t) ~ (p*u,t+log p)`. -/
theorem ccmArithmeticJacobianPrimeFibre_frobenius_relation
    (p : Nat.Primes) (u : PrimeUnits p) (t : ℝ) :
    ccmArithmeticJacobianPrimeFibreMk p
        (Additive.ofMul (deningerPacketFrobeniusUnit p * u),
          t + Real.log (p : ℝ)) =
      ccmArithmeticJacobianPrimeFibreMk p (Additive.ofMul u, t) := by
  rw [show (Additive.ofMul (deningerPacketFrobeniusUnit p * u),
      t + Real.log (p : ℝ)) =
        (Additive.ofMul u, t) + ccmArithmeticJacobianPrimeDeck p by
    ext <;> simp [ccmArithmeticJacobianPrimeDeck, mul_comm]]
  rw [map_add]
  have hdeck : ccmArithmeticJacobianPrimeFibreMk p
      (ccmArithmeticJacobianPrimeDeck p) = 0 := by
    apply (QuotientAddGroup.eq_zero_iff _).2
    exact AddSubgroup.mem_zmultiples _
  rw [hdeck, add_zero]

/-- Every deck iterate acts by literal `p^n` multiplication while advancing
the logarithmic coordinate by `n log p`. -/
theorem ccmArithmeticJacobianPrimeFibre_frobenius_zpow_relation
    (p : Nat.Primes) (u : PrimeUnits p) (t : ℝ) (n : ℤ) :
    ccmArithmeticJacobianPrimeFibreMk p
        (Additive.ofMul ((deningerPacketFrobeniusUnit p) ^ n * u),
          t + (n : ℝ) * Real.log (p : ℝ)) =
      ccmArithmeticJacobianPrimeFibreMk p (Additive.ofMul u, t) := by
  rw [show (Additive.ofMul
        ((deningerPacketFrobeniusUnit p) ^ n * u),
      t + (n : ℝ) * Real.log (p : ℝ)) =
        (Additive.ofMul u, t) +
          n • ccmArithmeticJacobianPrimeDeck p by
    ext
    · simp [ccmArithmeticJacobianPrimeDeck, mul_comm]
    · simp [ccmArithmeticJacobianPrimeDeck, zsmul_eq_mul]]
  rw [map_add, map_zsmul]
  have hdeck : ccmArithmeticJacobianPrimeFibreMk p
      (ccmArithmeticJacobianPrimeDeck p) = 0 := by
    apply (QuotientAddGroup.eq_zero_iff _).2
    exact AddSubgroup.mem_zmultiples _
  rw [hdeck, smul_zero, add_zero]

/-! ## The closure-quotient product is a proper receiver quotient -/

/-- The diagonal prime is not the identity in the product of away-prime
local-unit groups. -/
theorem deningerPacketFrobeniusUnit_ne_one (p : Nat.Primes) :
    deningerPacketFrobeniusUnit p ≠ 1 := by
  intro h
  let l : {l : Nat.Primes // (l : ℕ) ≠ (p : ℕ)} :=
    if hp : (p : ℕ) = 2 then
      ⟨⟨3, Nat.prime_three⟩, by simp [hp]⟩
    else
      ⟨⟨2, Nat.prime_two⟩, Ne.symm hp⟩
  have hv := congrArg
    (fun u : PrimeUnits p =>
      ((u l : ℤ_[(l.1 : ℕ)]ˣ) : ℤ_[(l.1 : ℕ)])) h
  change ((p : ℕ) : ℤ_[(l.1 : ℕ)]) = 1 at hv
  have hp1 : (p : ℕ) = 1 := by
    exact_mod_cast hv
  exact p.2.ne_one hp1

/-- Horizontal Frobenius at zero logarithmic height.  It is different from
the deck generator, which also advances by `log p`. -/
def ccmArithmeticJacobianPrimeHorizontalFrobenius (p : Nat.Primes) :
    CCMArithmeticJacobianPrimeFibre p :=
  ccmArithmeticJacobianPrimeFibreMk p
    (Additive.ofMul (deningerPacketFrobeniusUnit p), 0)

/-- Horizontal Frobenius survives in the actual twisted fibre. -/
theorem ccmArithmeticJacobianPrimeHorizontalFrobenius_ne_zero
    (p : Nat.Primes) :
    ccmArithmeticJacobianPrimeHorizontalFrobenius p ≠ 0 := by
  intro h
  have hmem :
      (Additive.ofMul (deningerPacketFrobeniusUnit p), 0) ∈
        ccmArithmeticJacobianPrimeDeckSubgroup p :=
    (QuotientAddGroup.eq_zero_iff _).1 h
  obtain ⟨n, hn⟩ := AddSubgroup.mem_zmultiples_iff.mp hmem
  have hsecond := congrArg Prod.snd hn
  have hsecond' : (n : ℝ) * Real.log (p : ℝ) = 0 := by
    simpa [ccmArithmeticJacobianPrimeDeck, zsmul_eq_mul] using hsecond
  have hn0 : n = 0 := by
    have hperiod : Real.log (p : ℝ) ≠ 0 :=
      (ccmArithmeticJacobianPrimePeriod_pos p).ne'
    have hnR : (n : ℝ) = 0 :=
      (mul_eq_zero.mp hsecond').resolve_right hperiod
    exact_mod_cast hnR
  subst n
  simp only [zero_zsmul] at hn
  have hfirst := congrArg Prod.fst hn
  apply deningerPacketFrobeniusUnit_ne_one p
  simpa using hfirst.symm

/-- Additive presentation of the closure-quotient packet times the prime
circle.  Its underlying space is the product used by the earlier trivial
mapping-torus candidate. -/
abbrev CCMArithmeticJacobianCollapsedPrimeFibre (p : Nat.Primes) :=
  Additive (DeningerPacketFrobeniusQuotient p) ×
    AddCircle (Real.log (p : ℝ))

private def ccmArithmeticJacobianPacketClosureQuotientAddHom
    (p : Nat.Primes) :
    Additive (PrimeUnits p) →+
      Additive (DeningerPacketFrobeniusQuotient p) :=
  MonoidHom.toAdditive
    (QuotientGroup.mk' (deningerPacketFrobeniusClosure p))

private def ccmArithmeticJacobianPrimeCollapsePre
    (p : Nat.Primes) :
    Additive (PrimeUnits p) × ℝ →+
      CCMArithmeticJacobianCollapsedPrimeFibre p :=
  ((ccmArithmeticJacobianPacketClosureQuotientAddHom p).comp
      (AddMonoidHom.fst _ _)).prod
    ((QuotientAddGroup.mk'
      (AddSubgroup.zmultiples (Real.log (p : ℝ)))).comp
        (AddMonoidHom.snd _ _))

private theorem ccmArithmeticJacobianPrimeDeck_le_collapsePre_ker
    (p : Nat.Primes) :
    ccmArithmeticJacobianPrimeDeckSubgroup p ≤
      (ccmArithmeticJacobianPrimeCollapsePre p).ker := by
  change AddSubgroup.zmultiples (ccmArithmeticJacobianPrimeDeck p) ≤
    (ccmArithmeticJacobianPrimeCollapsePre p).ker
  rw [AddSubgroup.zmultiples_le]
  change ccmArithmeticJacobianPrimeCollapsePre p
    (ccmArithmeticJacobianPrimeDeck p) = 0
  apply Prod.ext
  · change Additive.ofMul
      (QuotientGroup.mk (deningerPacketFrobeniusUnit p) :
        DeningerPacketFrobeniusQuotient p) = 0
    simpa using congrArg Additive.ofMul
      (deningerPacketFrobenius_eq_one p)
  · apply (QuotientAddGroup.eq_zero_iff _).2
    exact AddSubgroup.mem_zmultiples _

/-- Canonical collapse from the actual twisted fibre to closure quotient
times prime circle. -/
def ccmArithmeticJacobianPrimeCollapse (p : Nat.Primes) :
    CCMArithmeticJacobianPrimeFibre p →+
      CCMArithmeticJacobianCollapsedPrimeFibre p :=
  QuotientAddGroup.lift
    (ccmArithmeticJacobianPrimeDeckSubgroup p)
    (ccmArithmeticJacobianPrimeCollapsePre p)
    (ccmArithmeticJacobianPrimeDeck_le_collapsePre_ker p)

@[simp]
theorem ccmArithmeticJacobianPrimeCollapse_mk
    (p : Nat.Primes) (x : Additive (PrimeUnits p) × ℝ) :
    ccmArithmeticJacobianPrimeCollapse p
        (ccmArithmeticJacobianPrimeFibreMk p x) =
      ccmArithmeticJacobianPrimeCollapsePre p x :=
  rfl

private theorem ccmArithmeticJacobianPrimeCollapsePre_continuous
    (p : Nat.Primes) :
    Continuous (ccmArithmeticJacobianPrimeCollapsePre p) := by
  have hpacket : Continuous
      (ccmArithmeticJacobianPacketClosureQuotientAddHom p) := by
    change Continuous (fun u : PrimeUnits p =>
      (QuotientGroup.mk u : DeningerPacketFrobeniusQuotient p))
    exact QuotientGroup.continuous_mk
  exact
    (hpacket.comp continuous_fst).prodMk
      (QuotientAddGroup.continuous_mk.comp continuous_snd)

/-- The canonical collapse is continuous. -/
theorem ccmArithmeticJacobianPrimeCollapse_continuous
    (p : Nat.Primes) :
    Continuous (ccmArithmeticJacobianPrimeCollapse p) := by
  rw [(QuotientAddGroup.isQuotientMap_mk
    (ccmArithmeticJacobianPrimeDeckSubgroup p)).continuous_iff]
  exact ccmArithmeticJacobianPrimeCollapsePre_continuous p

/-- The canonical collapse reaches every closure-quotient/circle pair. -/
theorem ccmArithmeticJacobianPrimeCollapse_surjective
    (p : Nat.Primes) :
    Function.Surjective (ccmArithmeticJacobianPrimeCollapse p) := by
  rintro ⟨a, s⟩
  obtain ⟨u, hu⟩ := QuotientGroup.mk_surjective (Additive.toMul a)
  obtain ⟨t, ht⟩ := QuotientAddGroup.mk'_surjective
    (AddSubgroup.zmultiples (Real.log (p : ℝ))) s
  refine ⟨ccmArithmeticJacobianPrimeFibreMk p
    (Additive.ofMul u, t), ?_⟩
  apply Prod.ext
  · exact congrArg Additive.ofMul hu
  · exact ht

/-- Closure quotient erases the surviving horizontal Frobenius class. -/
theorem ccmArithmeticJacobianPrimeCollapse_horizontalFrobenius_eq_zero
    (p : Nat.Primes) :
    ccmArithmeticJacobianPrimeCollapse p
        (ccmArithmeticJacobianPrimeHorizontalFrobenius p) = 0 := by
  apply Prod.ext
  · change Additive.ofMul
      (QuotientGroup.mk (deningerPacketFrobeniusUnit p) :
        DeningerPacketFrobeniusQuotient p) = 0
    simpa using congrArg Additive.ofMul
      (deningerPacketFrobenius_eq_one p)
  · rfl

/-- New frontier theorem: the closure-quotient product is a proper quotient
of Connes--Consani's universal prime fibre. -/
theorem ccmArithmeticJacobianPrimeCollapse_not_injective
    (p : Nat.Primes) :
    ¬ Function.Injective (ccmArithmeticJacobianPrimeCollapse p) := by
  intro h
  apply ccmArithmeticJacobianPrimeHorizontalFrobenius_ne_zero p
  apply h
  rw [ccmArithmeticJacobianPrimeCollapse_horizontalFrobenius_eq_zero,
    map_zero]

/-- Literature frontier plus strict new comparison in one unconditional
statement. -/
theorem connesConsani_arithmeticJacobianPrimeFibre_frontier
    (p : Nat.Primes) :
    (∀ (u : PrimeUnits p) (t : ℝ),
      ccmArithmeticJacobianPrimeFibreMk p
          (Additive.ofMul (deningerPacketFrobeniusUnit p * u),
            t + Real.log (p : ℝ)) =
        ccmArithmeticJacobianPrimeFibreMk p (Additive.ofMul u, t)) ∧
      Function.Surjective (ccmArithmeticJacobianPrimeCollapse p) ∧
      ¬ Function.Injective (ccmArithmeticJacobianPrimeCollapse p) := by
  exact ⟨ccmArithmeticJacobianPrimeFibre_frobenius_relation p,
    ccmArithmeticJacobianPrimeCollapse_surjective p,
    ccmArithmeticJacobianPrimeCollapse_not_injective p⟩

end

end RHTower
