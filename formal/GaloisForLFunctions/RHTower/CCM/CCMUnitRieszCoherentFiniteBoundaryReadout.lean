import GaloisForLFunctions.RHTower.CCM.CCMUnitRieszCoherentRelativeCarrier


/-!
# Finite HG boundary readout of the completed unit-Riesz charge

The principal-relative carrier reconstructs half the arithmetic resolvent as an infinite translated
codiagonal series.  At logarithmic step `L = log N`, however, every translate after aperture lies
in the exact two-dimensional tail span generated by `exp(-u/2)` and `exp(-u)`.  The infinite
series therefore collapses algebraically to three codiagonal samples at `0`, `L`, and `2L`.

Writing `r = exp(-L/2)`, this module proves the exact formula

`R_1(L)/2 = D(0) + ((1-r-r²)D(L)+D(2L))/((1-r)²(1+r))`.

For every integer `N >= 2`, `r <= 3/4`; consequently the readout is uniformly conditioned:

`|R_1(L)/2| <= |D(0)| + 48|D(L)| + 16|D(2L)|`.

The same inequality is stated for real parts of one canonical HG-admissible profile.  This removes
the divergent dual-mass obstruction: remaining problem is quantitative control of three literal
source samples, not convergence or unbounded summation.
-/

open Set MeasureTheory Filter Topology

noncomputable section

namespace GaloisForLFunctions.RHTower

open _root_.RHTower

theorem twoModeConstant_eq_threeIncrementReadout
    {q A B r s : ℝ} (hrs : r ≠ s) (hr1 : r ≠ 1) (hs1 : s ≠ 1) :
    q =
      (q + A * r + B * s) +
      (((q + A * r ^ 3 + B * s ^ 3) - (q + A * r ^ 2 + B * s ^ 2)) -
          s * ((q + A * r ^ 2 + B * s ^ 2) - (q + A * r + B * s))) /
        ((r - s) * (1 - r)) +
      (r * ((q + A * r ^ 2 + B * s ^ 2) - (q + A * r + B * s)) -
          ((q + A * r ^ 3 + B * s ^ 3) - (q + A * r ^ 2 + B * s ^ 2))) /
        ((r - s) * (1 - s)) := by
  field_simp
  ring

theorem squareMode_threeIncrementReadout_simplify
    {r d₁ d₂ : ℝ} (hr0 : 0 < r) (hr1 : r < 1) :
    (d₂ - r ^ 2 * d₁) / ((r - r ^ 2) * (1 - r)) +
        (r * d₁ - d₂) / ((r - r ^ 2) * (1 - r ^ 2)) =
      ((1 - r - r ^ 2) * d₁ + d₂) / ((1 - r) ^ 2 * (1 + r)) := by
  have hrrsq : r - r ^ 2 ≠ 0 := by nlinarith
  have h1mr : 1 - r ≠ 0 := by nlinarith
  have h1mrsq : 1 - r ^ 2 ≠ 0 := by nlinarith
  have h1pr : 1 + r ≠ 0 := by nlinarith
  field_simp [hrrsq, h1mr, h1mrsq, h1pr]
  ring

theorem abs_squareMode_threeSampleReadout_le
    {r d₀ d₁ d₂ : ℝ} (hr0 : 0 ≤ r) (hr34 : r ≤ 3 / 4) :
    |d₀ + (((1 - r - r ^ 2) * d₁ + d₂) / ((1 - r) ^ 2 * (1 + r)))| ≤
      |d₀| + 48 * |d₁| + 16 * |d₂| := by
  have hr1 : r ≤ 1 := by linarith
  have hr2 : r ^ 2 ≤ 1 := by
    simpa using (sq_le_sq₀ hr0 (by norm_num : (0 : ℝ) ≤ 1)).2 hr1
  have hcoef : |1 - r - r ^ 2| ≤ 3 := by
    rw [abs_le]
    constructor <;> nlinarith
  have hquarter : (1 / 4 : ℝ) ≤ 1 - r := by linarith
  have hsquare : (1 / 16 : ℝ) ≤ (1 - r) ^ 2 := by
    have hsq := (sq_le_sq₀ (by norm_num : (0 : ℝ) ≤ 1 / 4) (by linarith)).2 hquarter
    norm_num at hsq ⊢
    exact hsq
  have hden : (1 / 16 : ℝ) ≤ (1 - r) ^ 2 * (1 + r) := by
    calc
      (1 / 16 : ℝ) = (1 / 16) * 1 := by ring
      _ ≤ (1 - r) ^ 2 * (1 + r) :=
        mul_le_mul hsquare (by linarith) (by norm_num) (sq_nonneg _)
  have hdenpos : 0 < (1 - r) ^ 2 * (1 + r) := lt_of_lt_of_le (by norm_num) hden
  have hnum : |(1 - r - r ^ 2) * d₁ + d₂| ≤ 3 * |d₁| + |d₂| := by
    calc
      |(1 - r - r ^ 2) * d₁ + d₂| ≤
          |(1 - r - r ^ 2) * d₁| + |d₂| := abs_add_le _ _
      _ = |1 - r - r ^ 2| * |d₁| + |d₂| := by rw [abs_mul]
      _ ≤ 3 * |d₁| + |d₂| := by gcongr
  have hT : 0 ≤ 3 * |d₁| + |d₂| := by positivity
  have hquot :
      |((1 - r - r ^ 2) * d₁ + d₂) / ((1 - r) ^ 2 * (1 + r))| ≤
        16 * (3 * |d₁| + |d₂|) := by
    rw [abs_div, abs_of_pos hdenpos]
    apply (div_le_iff₀ hdenpos).2
    calc
      |(1 - r - r ^ 2) * d₁ + d₂| ≤ 3 * |d₁| + |d₂| := hnum
      _ = (3 * |d₁| + |d₂|) * 1 := by ring
      _ ≤ (3 * |d₁| + |d₂|) * (16 * ((1 - r) ^ 2 * (1 + r))) := by
        apply mul_le_mul_of_nonneg_left _ hT
        nlinarith
      _ = 16 * (3 * |d₁| + |d₂|) * ((1 - r) ^ 2 * (1 + r)) := by ring
  calc
    |d₀ + (((1 - r - r ^ 2) * d₁ + d₂) / ((1 - r) ^ 2 * (1 + r)))| ≤
        |d₀| + |((1 - r - r ^ 2) * d₁ + d₂) /
          ((1 - r) ^ 2 * (1 + r))| := abs_add_le _ _
    _ ≤ |d₀| + 16 * (3 * |d₁| + |d₂|) := add_le_add le_rfl hquot
    _ = |d₀| + 48 * |d₁| + 16 * |d₂| := by ring

theorem unitRieszCoherentCompletedLogCodiagonal_finiteChargeReadout
    {N : ℕ} (hN : 2 ≤ N) :
    let L := Real.log N
    let r := Real.exp (-L / 2)
    let s := Real.exp (-L)
    criticalMellinChebyshevResolventSource L / 2 =
      unitRieszCoherentCompletedShiftCodiagonal N L 0 +
      (unitRieszCoherentCompletedShiftCodiagonal N L (2 * L) -
          s * unitRieszCoherentCompletedShiftCodiagonal N L L) /
        ((r - s) * (1 - r)) +
      (r * unitRieszCoherentCompletedShiftCodiagonal N L L -
          unitRieszCoherentCompletedShiftCodiagonal N L (2 * L)) /
        ((r - s) * (1 - s)) := by
  dsimp only
  let L : ℝ := Real.log N
  let r : ℝ := Real.exp (-L / 2)
  let s : ℝ := Real.exp (-L)
  let q : ℝ := criticalMellinChebyshevResolventSource L / 2
  let A : ℝ := unitRieszCoherentPrimeKernelTailMode N N - Real.sqrt N
  let B : ℝ := (4 / 3) * Real.sqrt N
  have hNpos : (0 : ℝ) < N := by
    exact_mod_cast (lt_of_lt_of_le Nat.zero_lt_two hN)
  have hL : 0 < L := by
    dsimp only [L]
    exact Real.log_pos (by exact_mod_cast hN)
  have hrpos : 0 < r := by dsimp only [r]; positivity
  have hspos : 0 < s := by dsimp only [s]; positivity
  have hrlt : r < 1 := by
    dsimp only [r]
    exact Real.exp_lt_one_iff.mpr (by linarith)
  have hslt : s < 1 := by
    dsimp only [s]
    exact Real.exp_lt_one_iff.mpr (by linarith)
  have hrslt : s < r := by
    dsimp only [r, s]
    exact Real.exp_lt_exp.mpr (by linarith)
  have hrpow (m : ℕ) : Real.exp (-((m : ℝ) * L) / 2) = r ^ m := by
    dsimp only [r]
    rw [← Real.exp_nat_mul]
    congr 1
    ring
  have hspow (m : ℕ) : Real.exp (-((m : ℝ) * L)) = s ^ m := by
    dsimp only [s]
    rw [← Real.exp_nat_mul]
    congr 1
    ring
  have hC1 : unitRieszCoherentCompletedKernelResponse N L = q + A * r + B * s := by
    rw [unitRieszCoherentCompletedKernelResponse_eq_rightTail hN le_rfl]
    dsimp only [q, A, B, r, s]
    ring
  have hC2 : unitRieszCoherentCompletedKernelResponse N (2 * L) =
      q + A * r ^ 2 + B * s ^ 2 := by
    rw [unitRieszCoherentCompletedKernelResponse_eq_rightTail hN (by linarith : L ≤ 2 * L)]
    rw [show Real.exp (-(2 * L) / 2) = r ^ 2 by exact hrpow 2,
      show Real.exp (-(2 * L)) = s ^ 2 by exact hspow 2]
    dsimp only [q, A, B]
    ring
  have hC3 : unitRieszCoherentCompletedKernelResponse N (3 * L) =
      q + A * r ^ 3 + B * s ^ 3 := by
    rw [unitRieszCoherentCompletedKernelResponse_eq_rightTail hN (by linarith : L ≤ 3 * L)]
    rw [show Real.exp (-(3 * L) / 2) = r ^ 3 by exact hrpow 3,
      show Real.exp (-(3 * L)) = s ^ 3 by exact hspow 3]
    dsimp only [q, A, B]
    ring
  have hD0 : unitRieszCoherentCompletedShiftCodiagonal N L 0 =
      q + A * r + B * s := by
    rw [unitRieszCoherentCompletedShiftCodiagonal,
      zero_add, hC1, unitRieszCoherentCompletedKernelResponse_zero hN, sub_zero]
  have hD1 : unitRieszCoherentCompletedShiftCodiagonal N L L =
      (q + A * r ^ 2 + B * s ^ 2) - (q + A * r + B * s) := by
    rw [unitRieszCoherentCompletedShiftCodiagonal, show L + L = 2 * L by ring, hC2, hC1]
  have hD2 : unitRieszCoherentCompletedShiftCodiagonal N L (2 * L) =
      (q + A * r ^ 3 + B * s ^ 3) - (q + A * r ^ 2 + B * s ^ 2) := by
    rw [unitRieszCoherentCompletedShiftCodiagonal, show 2 * L + L = 3 * L by ring, hC3, hC2]
  rw [hD0, hD1, hD2]
  exact twoModeConstant_eq_threeIncrementReadout hrslt.ne' hrlt.ne hslt.ne

/-- Because the two tail ratios are `r` and `r²`, the boundary charge is a uniformly conditioned
three-sample readout of one logarithmic-step codiagonal; no infinite-series functional remains. -/
theorem unitRieszCoherentCompletedLogCodiagonal_threeSampleReadout
    {N : ℕ} (hN : 2 ≤ N) :
    let L := Real.log N
    let r := Real.exp (-L / 2)
    criticalMellinChebyshevResolventSource L / 2 =
      unitRieszCoherentCompletedShiftCodiagonal N L 0 +
      ((1 - r - r ^ 2) * unitRieszCoherentCompletedShiftCodiagonal N L L +
          unitRieszCoherentCompletedShiftCodiagonal N L (2 * L)) /
        ((1 - r) ^ 2 * (1 + r)) := by
  dsimp only
  let L : ℝ := Real.log N
  let r : ℝ := Real.exp (-L / 2)
  change criticalMellinChebyshevResolventSource L / 2 =
    unitRieszCoherentCompletedShiftCodiagonal N L 0 +
      ((1 - r - r ^ 2) * unitRieszCoherentCompletedShiftCodiagonal N L L +
          unitRieszCoherentCompletedShiftCodiagonal N L (2 * L)) /
        ((1 - r) ^ 2 * (1 + r))
  have hL : 0 < L := by
    dsimp only [L]
    exact Real.log_pos (by exact_mod_cast hN)
  have hrpos : 0 < r := by dsimp only [r]; positivity
  have hrlt : r < 1 := by
    dsimp only [r]
    exact Real.exp_lt_one_iff.mpr (by linarith)
  have hsquare : Real.exp (-L) = r ^ 2 := by
    dsimp only [r]
    rw [pow_two, ← Real.exp_add]
    congr 1
    ring
  have h : criticalMellinChebyshevResolventSource L / 2 =
      unitRieszCoherentCompletedShiftCodiagonal N L 0 +
      (unitRieszCoherentCompletedShiftCodiagonal N L (2 * L) -
          Real.exp (-L) * unitRieszCoherentCompletedShiftCodiagonal N L L) /
        ((r - Real.exp (-L)) * (1 - r)) +
      (r * unitRieszCoherentCompletedShiftCodiagonal N L L -
          unitRieszCoherentCompletedShiftCodiagonal N L (2 * L)) /
        ((r - Real.exp (-L)) * (1 - Real.exp (-L))) := by
    simpa only [L, r] using
      unitRieszCoherentCompletedLogCodiagonal_finiteChargeReadout hN
  rw [hsquare] at h
  rw [h]
  convert congrArg
    (fun x : ℝ => unitRieszCoherentCompletedShiftCodiagonal N L 0 + x)
    (squareMode_threeIncrementReadout_simplify
      (d₁ := unitRieszCoherentCompletedShiftCodiagonal N L L)
      (d₂ := unitRieszCoherentCompletedShiftCodiagonal N L (2 * L)) hrpos hrlt) using 1
  all_goals ring

theorem unitRieszCoherent_logTailRatio_le_three_quarters
    {N : ℕ} (hN : 2 ≤ N) :
    Real.exp (-Real.log N / 2) ≤ 3 / 4 := by
  let L : ℝ := Real.log N
  let r : ℝ := Real.exp (-L / 2)
  have hNpos : (0 : ℝ) < N := by
    exact_mod_cast (lt_of_lt_of_le Nat.zero_lt_two hN)
  have hsqrtNpos : 0 < Real.sqrt (N : ℝ) := Real.sqrt_pos.mpr hNpos
  have hsqrtExp : Real.sqrt (N : ℝ) = Real.exp (L / 2) := by
    dsimp only [L]
    rw [← Real.log_sqrt hNpos.le, Real.exp_log hsqrtNpos]
  have hrmul : r * Real.sqrt (N : ℝ) = 1 := by
    rw [hsqrtExp]
    dsimp only [r]
    rw [← Real.exp_add]
    rw [show -L / 2 + L / 2 = 0 by ring, Real.exp_zero]
  have hsqrt2sq : Real.sqrt (2 : ℝ) ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have hsqrt2ge : (4 / 3 : ℝ) ≤ Real.sqrt 2 := by
    nlinarith [Real.sqrt_nonneg (2 : ℝ)]
  have hsqrtNge2 : Real.sqrt (2 : ℝ) ≤ Real.sqrt N :=
    Real.sqrt_le_sqrt (by exact_mod_cast hN)
  have hsqrtNge : (4 / 3 : ℝ) ≤ Real.sqrt N := le_trans hsqrt2ge hsqrtNge2
  have hmul : r * Real.sqrt (N : ℝ) ≤ (3 / 4) * Real.sqrt N := by
    rw [hrmul]
    nlinarith
  nlinarith

/-- Uniformly conditioned finite boundary readout: half completed CCM resolvent is controlled by
three samples of one HG-admissible logarithmic-step codiagonal with aperture-independent constants. -/
theorem abs_criticalMellinChebyshevResolventSource_half_le_threeCodiagonalSamples
    {N : ℕ} (hN : 2 ≤ N) :
    let L := Real.log N
    |criticalMellinChebyshevResolventSource L / 2| ≤
      |unitRieszCoherentCompletedShiftCodiagonal N L 0| +
        48 * |unitRieszCoherentCompletedShiftCodiagonal N L L| +
        16 * |unitRieszCoherentCompletedShiftCodiagonal N L (2 * L)| := by
  dsimp only
  let L : ℝ := Real.log N
  let r : ℝ := Real.exp (-L / 2)
  change |criticalMellinChebyshevResolventSource L / 2| ≤
    |unitRieszCoherentCompletedShiftCodiagonal N L 0| +
      48 * |unitRieszCoherentCompletedShiftCodiagonal N L L| +
      16 * |unitRieszCoherentCompletedShiftCodiagonal N L (2 * L)|
  have hread := unitRieszCoherentCompletedLogCodiagonal_threeSampleReadout hN
  dsimp only at hread
  have hread' : criticalMellinChebyshevResolventSource L / 2 =
      unitRieszCoherentCompletedShiftCodiagonal N L 0 +
      ((1 - r - r ^ 2) * unitRieszCoherentCompletedShiftCodiagonal N L L +
          unitRieszCoherentCompletedShiftCodiagonal N L (2 * L)) /
        ((1 - r) ^ 2 * (1 + r)) := by
    simpa only [L, r] using hread
  rw [hread']
  exact abs_squareMode_threeSampleReadout_le (Real.exp_pos _).le
    (by simpa only [L, r] using unitRieszCoherent_logTailRatio_le_three_quarters hN)

theorem abs_criticalMellinChebyshevResolventSource_half_le_threeHGProfileSamples
    {N : ℕ} (hN : 2 ≤ N) :
    let L := Real.log N
    |criticalMellinChebyshevResolventSource L / 2| ≤
      |(unitRieszCoherentCompletedShiftCodiagonalProfile N L 0).re| +
        48 * |(unitRieszCoherentCompletedShiftCodiagonalProfile N L L).re| +
        16 * |(unitRieszCoherentCompletedShiftCodiagonalProfile N L (2 * L)).re| := by
  dsimp only
  let L : ℝ := Real.log N
  have hL : 0 ≤ L := Real.log_nonneg (by
    have hN1 : 1 ≤ N := by omega
    exact_mod_cast hN1)
  have h := abs_criticalMellinChebyshevResolventSource_half_le_threeCodiagonalSamples hN
  dsimp only at h
  rw [unitRieszCoherentCompletedShiftCodiagonalProfile_eq hL (by norm_num),
    unitRieszCoherentCompletedShiftCodiagonalProfile_eq hL hL,
    unitRieszCoherentCompletedShiftCodiagonalProfile_eq hL (by linarith : 0 ≤ 2 * L)]
  simpa only [L] using h

end GaloisForLFunctions.RHTower

