import GaloisForLFunctions.RHTower.CCM.CCMFirstClockJuliaPrincipalRelativeNoGo

/-!
# Source-phased scalarization of the Julia--Gamma exterior current

The calibrated Julia--Gamma exterior cell is real and antisymmetric, so scalarization against real
weights vanishes. Its own finite-aperture source height supplies a canonical nonuniform complex
phase. Multiplication by `i` then makes the exterior kernel Hermitian. This module proves that the
real Hermitian energy is a sum of terms

`aᵢ aⱼ (hᵢ-hⱼ) sin (τ(hᵢ-hⱼ))`.

It is nonnegative while packet phase diameter is at most `π`, and strictly positive when two
retained source heights differ below that phase boundary. This constructs a genuine source-defined
positive scalar current. No uniform-budget or first-clock domination assertion is made.
-/

open Set Finset Filter Topology
open scoped BigOperators

noncomputable section
namespace RHTower

/-- Unit complex phase generated by a real source height. -/
def sourceHeightPhase {ι : Type*} (τ : ℝ) (height : ι → ℝ) (i : ι) : ℂ :=
  (Real.cos (τ * height i) : ℂ) +
    Complex.I * (Real.sin (τ * height i) : ℂ)

/-- Hermitian energy obtained by phasing `i` times a rank-two real exterior kernel. -/
def sourcePhasedExteriorHermitianEnergy
    {ι : Type*} (packet : Finset ι) (amplitude height : ι → ℝ) (τ : ℝ) : ℂ :=
  ∑ i ∈ packet, ∑ j ∈ packet,
    star (sourceHeightPhase τ height i) *
      (Complex.I *
        (amplitude i * amplitude j * (height i - height j) : ℝ)) *
      sourceHeightPhase τ height j

/-- Explicit real scalar energy carried by the phased exterior kernel. -/
def sourcePhasedExteriorScalarEnergy
    {ι : Type*} (packet : Finset ι) (amplitude height : ι → ℝ) (τ : ℝ) : ℝ :=
  ∑ i ∈ packet, ∑ j ∈ packet,
    amplitude i * amplitude j * (height i - height j) *
      Real.sin (τ * (height i - height j))

/-- The real part of phased Hermitian exterior energy is its explicit sine scalarization. -/
theorem sourcePhasedExteriorHermitianEnergy_re_eq
    {ι : Type*} (packet : Finset ι) (amplitude height : ι → ℝ) (τ : ℝ) :
    (sourcePhasedExteriorHermitianEnergy packet amplitude height τ).re =
      sourcePhasedExteriorScalarEnergy packet amplitude height τ := by
  rw [sourcePhasedExteriorHermitianEnergy, sourcePhasedExteriorScalarEnergy,
    Complex.re_sum]
  apply Finset.sum_congr rfl
  intro i hi
  rw [Complex.re_sum]
  apply Finset.sum_congr rfl
  intro j hj
  simp only [sourceHeightPhase, Complex.star_def, map_add, map_mul,
    Complex.conj_ofReal, Complex.conj_I, Complex.ofReal_mul, Complex.mul_re,
    Complex.mul_im, Complex.add_re, Complex.add_im, Complex.neg_re,
    Complex.neg_im, Complex.ofReal_re, Complex.ofReal_im, Complex.I_re,
    Complex.I_im, neg_zero, zero_add, zero_mul, mul_zero, sub_zero, one_mul,
    neg_mul, zero_sub, neg_neg]
  rw [show τ * (height i - height j) =
      τ * height i - τ * height j by ring, Real.sin_sub]
  ring

/-- A height difference times its sine phase is nonnegative before the first phase wrap. -/
theorem mul_sin_mul_nonneg_of_phaseBound
    {τ d : ℝ} (hτ : 0 ≤ τ) (hphase : |τ * d| ≤ Real.pi) :
    0 ≤ d * Real.sin (τ * d) := by
  by_cases hd : 0 ≤ d
  · exact mul_nonneg hd
      (Real.sin_nonneg_of_nonneg_of_le_pi (mul_nonneg hτ hd)
        (le_trans (le_abs_self _) hphase))
  · have hd' : d ≤ 0 := le_of_not_ge hd
    have hτd : τ * d ≤ 0 := mul_nonpos_of_nonneg_of_nonpos hτ hd'
    have hnegPhase : 0 ≤ -(τ * d) := neg_nonneg.mpr hτd
    have hnegPhasePi : -(τ * d) ≤ Real.pi := by
      rw [← abs_of_nonpos hτd]
      exact hphase
    have hsinNeg : Real.sin (τ * d) ≤ 0 := by
      rw [← neg_nonneg, ← Real.sin_neg]
      exact Real.sin_nonneg_of_nonneg_of_le_pi hnegPhase hnegPhasePi
    exact mul_nonneg_of_nonpos_of_nonpos hd' hsinNeg

/-- A nonzero height difference gives strict positivity before the first phase wrap. -/
theorem mul_sin_mul_pos_of_phaseBound
    {τ d : ℝ} (hτ : 0 < τ) (hd : d ≠ 0)
    (hphase : |τ * d| < Real.pi) :
    0 < d * Real.sin (τ * d) := by
  rcases lt_or_gt_of_ne hd with hdneg | hdpos
  · have hτd : τ * d < 0 := mul_neg_of_pos_of_neg hτ hdneg
    have hargPos : 0 < -(τ * d) := neg_pos.mpr hτd
    have hargPi : -(τ * d) < Real.pi := by
      rw [← abs_of_nonpos (mul_nonpos_of_nonneg_of_nonpos hτ.le hdneg.le)]
      exact hphase
    have hsinNeg : Real.sin (τ * d) < 0 := by
      rw [show τ * d = -(-(τ * d)) by ring, Real.sin_neg]
      exact neg_neg_of_pos
        (Real.sin_pos_of_pos_of_lt_pi hargPos hargPi)
    exact mul_pos_of_neg_of_neg hdneg hsinNeg
  · have hargPos : 0 < τ * d := mul_pos hτ hdpos
    have hargPi : τ * d < Real.pi :=
      (le_abs_self (τ * d)).trans_lt hphase
    exact mul_pos hdpos (Real.sin_pos_of_pos_of_lt_pi hargPos hargPi)

/-- Nonnegative amplitudes and phase diameter at most `π` make the scalar energy nonnegative. -/
theorem sourcePhasedExteriorScalarEnergy_nonneg
    {ι : Type*} (packet : Finset ι) (amplitude height : ι → ℝ) (τ : ℝ)
    (hamp : ∀ i ∈ packet, 0 ≤ amplitude i)
    (hτ : 0 ≤ τ)
    (hphase : ∀ i ∈ packet, ∀ j ∈ packet,
      |τ * (height i - height j)| ≤ Real.pi) :
    0 ≤ sourcePhasedExteriorScalarEnergy packet amplitude height τ := by
  unfold sourcePhasedExteriorScalarEnergy
  apply Finset.sum_nonneg
  intro i hi
  apply Finset.sum_nonneg
  intro j hj
  rw [show amplitude i * amplitude j * (height i - height j) *
      Real.sin (τ * (height i - height j)) =
      (amplitude i * amplitude j) *
        ((height i - height j) *
          Real.sin (τ * (height i - height j))) by ring]
  exact mul_nonneg (mul_nonneg (hamp i hi) (hamp j hj))
    (mul_sin_mul_nonneg_of_phaseBound hτ (hphase i hi j hj))

/-- A source-height phase gives a genuinely nonzero scalar current as soon as two retained source
heights differ and their phase separation stays strictly below `π`. -/
theorem sourcePhasedExteriorScalarEnergy_pos
    {ι : Type*} (packet : Finset ι) (amplitude height : ι → ℝ) (τ : ℝ)
    (hamp : ∀ i ∈ packet, 0 < amplitude i)
    (hτ : 0 < τ)
    (hphase : ∀ i ∈ packet, ∀ j ∈ packet,
      |τ * (height i - height j)| ≤ Real.pi)
    {i j : ι} (hi : i ∈ packet) (hj : j ∈ packet)
    (hheight : height i ≠ height j)
    (hphaseStrict : |τ * (height i - height j)| < Real.pi) :
    0 < sourcePhasedExteriorScalarEnergy packet amplitude height τ := by
  let term := fun i j =>
    amplitude i * amplitude j * (height i - height j) *
      Real.sin (τ * (height i - height j))
  have htermNonneg :
      ∀ k ∈ packet, ∀ l ∈ packet, 0 ≤ term k l := by
    intro k hk l hl
    dsimp only [term]
    rw [show amplitude k * amplitude l * (height k - height l) *
        Real.sin (τ * (height k - height l)) =
        (amplitude k * amplitude l) *
          ((height k - height l) *
            Real.sin (τ * (height k - height l))) by ring]
    exact mul_nonneg
      (mul_nonneg (hamp k hk).le (hamp l hl).le)
      (mul_sin_mul_nonneg_of_phaseBound hτ.le (hphase k hk l hl))
  have htermPos : 0 < term i j := by
    dsimp only [term]
    rw [show amplitude i * amplitude j * (height i - height j) *
        Real.sin (τ * (height i - height j)) =
        (amplitude i * amplitude j) *
          ((height i - height j) *
            Real.sin (τ * (height i - height j))) by ring]
    exact mul_pos (mul_pos (hamp i hi) (hamp j hj))
      (mul_sin_mul_pos_of_phaseBound hτ (sub_ne_zero.mpr hheight)
        hphaseStrict)
  have hinner :
      term i j ≤ ∑ l ∈ packet, term i l :=
    Finset.single_le_sum (fun l hl => htermNonneg i hi l hl) hj
  have houter :
      (∑ l ∈ packet, term i l) ≤
        ∑ k ∈ packet, ∑ l ∈ packet, term k l :=
    Finset.single_le_sum
      (fun k hk => Finset.sum_nonneg fun l hl => htermNonneg k hk l hl) hi
  exact htermPos.trans_le (hinner.trans houter)

/-- Finite-aperture source height whose exterior difference is exactly the calibrated
Julia--Gamma cell. -/
def gammaSewnMobiusJuliaCalibratedEulerHeight
    (x : ℝ) (pe : Nat.Primes × ℕ) : ℝ :=
  (1 / 2 : ℝ) * gammaSewnMobiusApertureCellMidHeight pe.1 pe.2 +
    (1 / 4 : ℝ) * gammaSewnMobiusJuliaNormalizedPrimeLog x pe.1

/-- Calibrated exterior cell is the amplitude-weighted difference of calibrated source heights. -/
theorem gammaSewnMobiusJuliaCalibratedEulerExteriorCell_eq_heightDifference
    (x u : ℝ) (i j : Nat.Primes × ℕ) :
    gammaSewnMobiusJuliaCalibratedEulerExteriorCell x u i j =
      xiGammaEulerBoundaryRealAmplitude u i *
        xiGammaEulerBoundaryRealAmplitude u j *
          (gammaSewnMobiusJuliaCalibratedEulerHeight x i -
            gammaSewnMobiusJuliaCalibratedEulerHeight x j) := by
  rw [gammaSewnMobiusJuliaCalibratedEulerExteriorCell,
    gammaSewnRecoveredEulerAmplitudeExteriorCell_eq]
  unfold gammaSewnMobiusJuliaPrimeLogExteriorSeam
    gammaSewnMobiusJuliaCalibratedEulerHeight
  ring

/-- Calibrated finite-aperture height converges to the literal Euler half-height. -/
theorem tendsto_gammaSewnMobiusJuliaCalibratedEulerHeight_nhdsGT_zero
    (pe : Nat.Primes × ℕ) :
    Tendsto
      (fun x : ℝ => gammaSewnMobiusJuliaCalibratedEulerHeight x pe)
      (nhdsWithin (0 : ℝ) (Ioi 0))
      (nhds (xiGammaEulerBoundaryHalfHeight pe.1 pe.2)) := by
  have hmid :
      Tendsto
        (fun _ : ℝ =>
          (1 / 2 : ℝ) * gammaSewnMobiusApertureCellMidHeight pe.1 pe.2)
        (nhdsWithin (0 : ℝ) (Ioi 0))
        (nhds ((1 / 2 : ℝ) *
          gammaSewnMobiusApertureCellMidHeight pe.1 pe.2)) :=
    tendsto_const_nhds
  have hquarter :
      Tendsto (fun _ : ℝ => (1 / 4 : ℝ))
        (nhdsWithin (0 : ℝ) (Ioi 0)) (nhds (1 / 4 : ℝ)) :=
    tendsto_const_nhds
  have hprime := hquarter.mul
    (tendsto_gammaSewnMobiusJuliaNormalizedPrimeLog_nhdsGT_zero pe.1)
  have h := hmid.add hprime
  simpa only [gammaSewnMobiusJuliaCalibratedEulerHeight,
    xiGammaEulerBoundaryHalfHeight_eq_half_midHeight_add_quarter_primeLog]
    using h

/-- Complex source-phased Hermitian energy of the calibrated Julia--Gamma exterior cell. -/
def gammaSewnMobiusJuliaSourcePhasedExteriorHermitianEnergy
    (x u τ : ℝ) (packet : Finset (Nat.Primes × ℕ)) : ℂ :=
  sourcePhasedExteriorHermitianEnergy packet
    (xiGammaEulerBoundaryRealAmplitude u)
    (gammaSewnMobiusJuliaCalibratedEulerHeight x) τ

/-- Explicit real source-phased scalar energy of the calibrated Julia--Gamma exterior cell. -/
def gammaSewnMobiusJuliaSourcePhasedExteriorScalarEnergy
    (x u τ : ℝ) (packet : Finset (Nat.Primes × ℕ)) : ℝ :=
  sourcePhasedExteriorScalarEnergy packet
    (xiGammaEulerBoundaryRealAmplitude u)
    (gammaSewnMobiusJuliaCalibratedEulerHeight x) τ

/-- The abstract phased exterior form is literally the Hermitian scalarization of `i` times the
finite-aperture calibrated Julia--Gamma exterior cell. -/
theorem gammaSewnMobiusJuliaSourcePhasedExteriorHermitianEnergy_eq_calibrated
    (x u τ : ℝ) (packet : Finset (Nat.Primes × ℕ)) :
    gammaSewnMobiusJuliaSourcePhasedExteriorHermitianEnergy x u τ packet =
      ∑ i ∈ packet, ∑ j ∈ packet,
        star
            (sourceHeightPhase τ
              (gammaSewnMobiusJuliaCalibratedEulerHeight x) i) *
          (Complex.I *
            (gammaSewnMobiusJuliaCalibratedEulerExteriorCell x u i j : ℂ)) *
          sourceHeightPhase τ
            (gammaSewnMobiusJuliaCalibratedEulerHeight x) j := by
  unfold gammaSewnMobiusJuliaSourcePhasedExteriorHermitianEnergy
    sourcePhasedExteriorHermitianEnergy
  apply Finset.sum_congr rfl
  intro i hi
  apply Finset.sum_congr rfl
  intro j hj
  rw [gammaSewnMobiusJuliaCalibratedEulerExteriorCell_eq_heightDifference]

/-- Real part of the actual phased Julia--Gamma Hermitian energy is its sine scalarization. -/
theorem gammaSewnMobiusJuliaSourcePhasedExteriorHermitianEnergy_re_eq
    (x u τ : ℝ) (packet : Finset (Nat.Primes × ℕ)) :
    (gammaSewnMobiusJuliaSourcePhasedExteriorHermitianEnergy
      x u τ packet).re =
      gammaSewnMobiusJuliaSourcePhasedExteriorScalarEnergy x u τ packet :=
  sourcePhasedExteriorHermitianEnergy_re_eq packet _ _ τ

/-- Actual phased Julia--Gamma scalar energy is nonnegative before any packet phase wraps. -/
theorem gammaSewnMobiusJuliaSourcePhasedExteriorScalarEnergy_nonneg
    (x u τ : ℝ) (packet : Finset (Nat.Primes × ℕ))
    (hτ : 0 ≤ τ)
    (hphase : ∀ i ∈ packet, ∀ j ∈ packet,
      |τ * (gammaSewnMobiusJuliaCalibratedEulerHeight x i -
        gammaSewnMobiusJuliaCalibratedEulerHeight x j)| ≤ Real.pi) :
    0 ≤ gammaSewnMobiusJuliaSourcePhasedExteriorScalarEnergy x u τ packet := by
  exact sourcePhasedExteriorScalarEnergy_nonneg packet _ _ τ
    (fun i _ => (xiGammaEulerBoundaryRealAmplitude_pos u i).le) hτ hphase

/-- Actual phased Julia--Gamma scalar energy is positive on every pre-wrap packet containing two
different calibrated source heights. -/
theorem gammaSewnMobiusJuliaSourcePhasedExteriorScalarEnergy_pos
    (x u τ : ℝ) (packet : Finset (Nat.Primes × ℕ))
    (hτ : 0 < τ)
    (hphase : ∀ i ∈ packet, ∀ j ∈ packet,
      |τ * (gammaSewnMobiusJuliaCalibratedEulerHeight x i -
        gammaSewnMobiusJuliaCalibratedEulerHeight x j)| ≤ Real.pi)
    {i j : Nat.Primes × ℕ} (hi : i ∈ packet) (hj : j ∈ packet)
    (hheight :
      gammaSewnMobiusJuliaCalibratedEulerHeight x i ≠
        gammaSewnMobiusJuliaCalibratedEulerHeight x j)
    (hphaseStrict :
      |τ * (gammaSewnMobiusJuliaCalibratedEulerHeight x i -
        gammaSewnMobiusJuliaCalibratedEulerHeight x j)| < Real.pi) :
    0 < gammaSewnMobiusJuliaSourcePhasedExteriorScalarEnergy x u τ packet := by
  exact sourcePhasedExteriorScalarEnergy_pos packet _ _ τ
    (fun k _ => xiGammaEulerBoundaryRealAmplitude_pos u k)
    hτ hphase hi hj hheight hphaseStrict

end RHTower
