/-
# Full finite Guinand--Weil source observer

For modes `0,...,N`, a finite atomic event source is observed by exactly the `2N+1` coordinates
appearing in the finite Guinand--Weil quotient: one weighted-horizon coordinate, `N` sine
coordinates, and `N` weighted-cosine coordinates.  This file proves that this coordinate observer
and the entire finite CCM event-packet matrix have exactly the same kernel.

Consequently, more than `2N+1` atomic events always admit a nonzero signed weighting whose whole
finite CCM matrix vanishes, for every placement of the event horizons.  Thus restoring the diagonal
coordinates moves the unavoidable ambiguity threshold from `N` to `2N+1`; it does not canonically
recover an overcomplete source.  The theorem concerns finite signed atomic sources.  Selecting the
actual prime/pole/archimedean source, including its continuous part, still has to happen in the
physical source horizon before passage to this quotient.
-/
import GaloisForLFunctions.RHTower.CCM.CCMGuinandWeilCodiagonalObserverDimension
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

noncomputable section

open scoped BigOperators

namespace RHTower

open Matrix

/-- The exact `2N+1`-dimensional coordinate space seen by modes `0,...,N`: weighted horizon,
positive sine moments, and positive weighted-cosine moments. -/
abbrev CCMGuinandWeilSourceCoordinates (N : ℕ) :=
  ℝ × (Fin N → ℝ) × (Fin N → ℝ)

/-- Full finite source-coordinate observer for `R` signed atomic events. -/
def ccmGuinandWeilFiniteSourceCoordinateObserver {N R : ℕ} (horizon : Fin R → ℝ) :
    (Fin R → ℝ) →ₗ[ℝ] CCMGuinandWeilSourceCoordinates N where
  toFun weight :=
    (∑ i, weight i * horizon i,
      (fun k => ∑ i, weight i *
        Real.sin (((k : ℕ) + 1 : ℝ) * (2 * Real.pi * horizon i))),
      fun k => ∑ i, weight i * horizon i *
        Real.cos (((k : ℕ) + 1 : ℝ) * (2 * Real.pi * horizon i)))
  map_add' := by
    intro a b
    apply Prod.ext
    · simp [add_mul, Finset.sum_add_distrib]
    · apply Prod.ext <;> apply _root_.funext <;> intro k
      · simp [add_mul, Finset.sum_add_distrib]
      · simp [add_mul, Finset.sum_add_distrib]
  map_smul' := by
    intro c a
    apply Prod.ext
    · simp [Finset.mul_sum]
      ring_nf
    · apply Prod.ext <;> apply _root_.funext <;> intro k
      · simp [Finset.mul_sum]
        ring_nf
      · change (∑ i, (c * a i) * horizon i *
          Real.cos (((k : ℕ) + 1 : ℝ) * (2 * Real.pi * horizon i))) =
          c * ∑ i, a i * horizon i *
            Real.cos (((k : ℕ) + 1 : ℝ) * (2 * Real.pi * horizon i))
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro i _
        ring

/-- The full source-coordinate observer has dimension exactly `2N+1`. -/
theorem ccmGuinandWeilSourceCoordinates_finrank (N : ℕ) :
    Module.finrank ℝ (CCMGuinandWeilSourceCoordinates N) = 2 * N + 1 := by
  simp [CCMGuinandWeilSourceCoordinates]
  omega

/-- More than `2N+1` atomic events always give a nonzero signed source invisible to every full
finite source coordinate, independently of horizon placement. -/
theorem ccmGuinandWeilFiniteSourceCoordinateObserver_exists_nonzero_kernel
    {N R : ℕ} (hNR : 2 * N + 1 < R) (horizon : Fin R → ℝ) :
    ∃ weight : Fin R → ℝ, weight ≠ 0 ∧
      ccmGuinandWeilFiniteSourceCoordinateObserver (N := N) horizon weight = 0 := by
  let T := ccmGuinandWeilFiniteSourceCoordinateObserver (N := N) horizon
  have hdimension : Module.finrank ℝ (CCMGuinandWeilSourceCoordinates N) <
      Module.finrank ℝ (Fin R → ℝ) := by
    rw [ccmGuinandWeilSourceCoordinates_finrank]
    simpa using hNR
  have hker : LinearMap.ker T ≠ ⊥ := T.ker_ne_bot_of_finrank_lt hdimension
  obtain ⟨weight, hweight, hne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hker
  exact ⟨weight, hne, LinearMap.mem_ker.mp hweight⟩

/-- Whole finite CCM packet generated by `R` signed events on modes `0,...,N`. -/
def ccmGuinandWeilFiniteEventPacketMatrix {N R : ℕ} (weight horizon : Fin R → ℝ) :
    Matrix (Fin (N + 1)) (Fin (N + 1)) ℝ :=
  ∑ r, weight r • ccmGuinandWeilEventMatrix
    (fun j : Fin (N + 1) => (j.val : ℤ)) (horizon r)

/-- A zero-to-positive edge reads the corresponding sine coordinate, up to its nonzero mode
normalization. -/
theorem ccmGuinandWeilFiniteEventPacketMatrix_zero_edge {N R : ℕ}
    (weight horizon : Fin R → ℝ) (k : Fin N) :
    ccmGuinandWeilFiniteEventPacketMatrix weight horizon (Fin.succ k) 0 =
      (∑ r, weight r *
        Real.sin (((k : ℕ) + 1 : ℝ) * (2 * Real.pi * horizon r))) /
          (Real.pi * ((k : ℕ) + 1 : ℝ)) := by
  rw [ccmGuinandWeilFiniteEventPacketMatrix, Matrix.sum_apply]
  simp only [Matrix.smul_apply, smul_eq_mul]
  simp [ccmGuinandWeilEventMatrix, ccmDividedDifferenceMatrix,
    ccmGuinandWeilEventSource]
  rw [Finset.sum_div]
  apply Finset.sum_congr rfl
  intro r _
  rw [show 2 * Real.pi * horizon r * (((k : ℕ) : ℝ) + 1) =
    (((k : ℕ) : ℝ) + 1) * (2 * Real.pi * horizon r) by ring]
  have hkpos : (0 : ℝ) < ((k : ℕ) : ℝ) + 1 := by positivity
  field_simp [Real.pi_ne_zero, ne_of_gt hkpos]

/-- The zero-mode diagonal reads twice the weighted-horizon coordinate. -/
theorem ccmGuinandWeilFiniteEventPacketMatrix_zero_diagonal {N R : ℕ}
    (weight horizon : Fin R → ℝ) :
    ccmGuinandWeilFiniteEventPacketMatrix (N := N) weight horizon 0 0 =
      2 * ∑ r, weight r * horizon r := by
  rw [ccmGuinandWeilFiniteEventPacketMatrix, Matrix.sum_apply]
  simp [ccmGuinandWeilEventMatrix, ccmDividedDifferenceMatrix,
    ccmGuinandWeilEventDiagonal]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro r _
  ring

/-- A positive-mode diagonal reads twice the corresponding weighted-cosine coordinate. -/
theorem ccmGuinandWeilFiniteEventPacketMatrix_positive_diagonal {N R : ℕ}
    (weight horizon : Fin R → ℝ) (k : Fin N) :
    ccmGuinandWeilFiniteEventPacketMatrix weight horizon (Fin.succ k) (Fin.succ k) =
      2 * ∑ r, weight r * horizon r *
        Real.cos (((k : ℕ) + 1 : ℝ) * (2 * Real.pi * horizon r)) := by
  rw [ccmGuinandWeilFiniteEventPacketMatrix, Matrix.sum_apply]
  simp [ccmGuinandWeilEventMatrix, ccmDividedDifferenceMatrix,
    ccmGuinandWeilEventDiagonal]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro r _
  rw [show 2 * Real.pi * horizon r * (((k : ℕ) : ℝ) + 1) =
    (((k : ℕ) : ℝ) + 1) * (2 * Real.pi * horizon r) by ring]
  ring

/-- Vanishing of every full finite source coordinate forces the entire event-packet matrix to
vanish, including entries away from the distinguished edge and diagonal. -/
theorem ccmGuinandWeilFiniteSourceCoordinateObserver_zero_implies_packet_zero
    {N R : ℕ} (weight horizon : Fin R → ℝ)
    (hobserver :
      ccmGuinandWeilFiniteSourceCoordinateObserver (N := N) horizon weight = 0) :
    ccmGuinandWeilFiniteEventPacketMatrix (N := N) weight horizon = 0 := by
  have hcentral : ∑ r, weight r * horizon r = 0 := by
    have h := congrArg Prod.fst hobserver
    simpa [ccmGuinandWeilFiniteSourceCoordinateObserver] using h
  have hsine : ∀ k : Fin N, ∑ r, weight r *
      Real.sin (((k : ℕ) + 1 : ℝ) * (2 * Real.pi * horizon r)) = 0 := by
    intro k
    have h := congr_fun (congrArg (fun x => x.2.1) hobserver) k
    simpa [ccmGuinandWeilFiniteSourceCoordinateObserver] using h
  have hcosine : ∀ k : Fin N, ∑ r, weight r * horizon r *
      Real.cos (((k : ℕ) + 1 : ℝ) * (2 * Real.pi * horizon r)) = 0 := by
    intro k
    have h := congr_fun (congrArg (fun x => x.2.2) hobserver) k
    simpa [ccmGuinandWeilFiniteSourceCoordinateObserver] using h
  have hsource : ∀ j : Fin (N + 1),
      ∑ r, weight r * ccmGuinandWeilEventSource (horizon r) (j.val : ℤ) = 0 := by
    intro j
    refine Fin.cases ?_ (fun k => ?_) j
    · simp [ccmGuinandWeilEventSource]
    · simp only [ccmGuinandWeilEventSource, Fin.val_succ, Nat.cast_add, Nat.cast_one]
      simp_rw [← mul_div_assoc]
      rw [← Finset.sum_div]
      have hnumerator : (∑ i, weight i *
          Real.sin (2 * Real.pi * horizon i *
            (((k.val : ℤ) + 1 : ℤ) : ℝ))) = 0 := by
        rw [show (∑ i, weight i *
            Real.sin (2 * Real.pi * horizon i *
              (((k.val : ℤ) + 1 : ℤ) : ℝ))) =
            ∑ i, weight i * Real.sin
              (((k.val : ℝ) + 1) * (2 * Real.pi * horizon i)) by
          apply Finset.sum_congr rfl
          intro i _
          congr 2
          push_cast
          ring]
        exact hsine k
      rw [hnumerator, zero_div]
  ext i j
  by_cases hij : i = j
  · subst j
    refine Fin.cases ?_ (fun k => ?_) i
    · rw [ccmGuinandWeilFiniteEventPacketMatrix_zero_diagonal, hcentral]
      simp
    · rw [ccmGuinandWeilFiniteEventPacketMatrix_positive_diagonal, hcosine k]
      simp
  · rw [ccmGuinandWeilFiniteEventPacketMatrix, Matrix.sum_apply]
    simp only [Matrix.smul_apply, smul_eq_mul,
      ccmGuinandWeilEventMatrix, ccmDividedDifferenceMatrix, hij, if_false]
    simp_rw [← mul_div_assoc]
    rw [← Finset.sum_div]
    simp_rw [mul_sub]
    rw [Finset.sum_sub_distrib, hsource i, hsource j, sub_self, zero_div]
    simp

/-- Conversely, the zero edge and diagonal entries of a zero event packet recover all `2N+1`
source coordinates. -/
theorem ccmGuinandWeilFiniteEventPacketMatrix_zero_implies_coordinateObserver_zero
    {N R : ℕ} (weight horizon : Fin R → ℝ)
    (hpacket : ccmGuinandWeilFiniteEventPacketMatrix (N := N) weight horizon = 0) :
    ccmGuinandWeilFiniteSourceCoordinateObserver (N := N) horizon weight = 0 := by
  apply Prod.ext
  · have h := congr_fun (congr_fun hpacket 0) 0
    change ccmGuinandWeilFiniteEventPacketMatrix (N := N) weight horizon 0 0 = 0 at h
    rw [ccmGuinandWeilFiniteEventPacketMatrix_zero_diagonal] at h
    change (∑ r, weight r * horizon r) = 0
    linarith
  · apply Prod.ext
    · apply _root_.funext
      intro k
      have h := congr_fun (congr_fun hpacket (Fin.succ k)) 0
      change ccmGuinandWeilFiniteEventPacketMatrix (N := N) weight horizon
        (Fin.succ k) 0 = 0 at h
      rw [ccmGuinandWeilFiniteEventPacketMatrix_zero_edge] at h
      have hdenom : Real.pi * ((k : ℕ) + 1 : ℝ) ≠ 0 :=
        mul_ne_zero Real.pi_ne_zero (by positivity)
      exact (div_eq_zero_iff.mp h).resolve_right hdenom
    · apply _root_.funext
      intro k
      have h := congr_fun (congr_fun hpacket (Fin.succ k)) (Fin.succ k)
      change ccmGuinandWeilFiniteEventPacketMatrix (N := N) weight horizon
        (Fin.succ k) (Fin.succ k) = 0 at h
      rw [ccmGuinandWeilFiniteEventPacketMatrix_positive_diagonal] at h
      change (∑ r, weight r * horizon r *
        Real.cos (((k : ℕ) + 1 : ℝ) * (2 * Real.pi * horizon r))) = 0
      linarith

/-- Exact kernel identification: full finite source coordinates vanish precisely when the whole
finite CCM event packet vanishes. -/
theorem ccmGuinandWeilFiniteSourceCoordinateObserver_zero_iff_packet_zero
    {N R : ℕ} (weight horizon : Fin R → ℝ) :
    ccmGuinandWeilFiniteSourceCoordinateObserver (N := N) horizon weight = 0 ↔
      ccmGuinandWeilFiniteEventPacketMatrix (N := N) weight horizon = 0 :=
  ⟨ccmGuinandWeilFiniteSourceCoordinateObserver_zero_implies_packet_zero weight horizon,
    ccmGuinandWeilFiniteEventPacketMatrix_zero_implies_coordinateObserver_zero weight horizon⟩

/-- **Whole-matrix overcompleteness theorem.**  If `R>2N+1`, every horizon placement supports a
nonzero signed atomic source whose entire finite CCM event-packet matrix vanishes. -/
theorem ccmGuinandWeilFiniteEventPacketMatrix_exists_nonzero_kernel
    {N R : ℕ} (hNR : 2 * N + 1 < R) (horizon : Fin R → ℝ) :
    ∃ weight : Fin R → ℝ, weight ≠ 0 ∧
      ccmGuinandWeilFiniteEventPacketMatrix (N := N) weight horizon = 0 := by
  obtain ⟨weight, hne, hobserver⟩ :=
    ccmGuinandWeilFiniteSourceCoordinateObserver_exists_nonzero_kernel hNR horizon
  exact ⟨weight, hne,
    ccmGuinandWeilFiniteSourceCoordinateObserver_zero_implies_packet_zero
      weight horizon hobserver⟩

end RHTower
