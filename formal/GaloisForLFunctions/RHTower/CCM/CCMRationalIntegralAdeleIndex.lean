import Mathlib.NumberTheory.Padics.RingHoms
import Mathlib.GroupTheory.QuotientGroup.Basic
import Mathlib.Data.Nat.Factorization.Basic
import Mathlib.NumberTheory.Padics.HeightOneSpectrum
import Mathlib.GroupTheory.Index
import GaloisForLFunctions.RHTower.CCM.CCMRationalFiniteAdeleHaar

/-!
# Exact index law for rational integral finite adeles

This file computes the arithmetic index of multiplication by a nonzero natural number on the
product of all rational local integer rings.  Locally, the quotient at `p` is identified with
`ZMod (p ^ v_p(n))`; globally, the prime factorization formula gives index exactly `n`.

The final theorem is stated on the height-one spectrum indexing used by the actual rational
finite-adele ring.  Thus it is reusable in the Haar-modulus computation without replacing the
adele ring by an abstract proxy.
-/

noncomputable section

open scoped Classical
open PadicInt

namespace GaloisForLFunctions
namespace RHTower

local instance (p : Nat.Primes) : Fact p.1.Prime := ⟨p.2⟩

/-- Removing the full `p`-power from a nonzero natural number leaves a `p`-unit. -/
theorem ccmPadicResidual_not_dvd (p : Nat.Primes) {n : ℕ} (hn : n ≠ 0) :
    ¬ p.1 ∣ n / p.1 ^ padicValNat p.1 n := by
  intro hdiv
  let e := padicValNat p.1 n
  have hd : p.1 ^ e ∣ n := pow_padicValNat_dvd
  have hdecomp : p.1 ^ e * (n / p.1 ^ e) = n := Nat.mul_div_cancel' hd
  have hnot : ¬p.1 ^ (e + 1) ∣ n :=
    pow_succ_padicValNat_not_dvd (p := p.1) (n := n) hn
  apply hnot
  rw [pow_succ, ← hdecomp]
  exact Nat.mul_dvd_mul_left _ hdiv

/-- In `ℤ_p`, a nonzero natural is associated to its exact `p`-power divisor. -/
theorem ccmPadicInt_natCast_associated_primePower
    (p : Nat.Primes) {n : ℕ} (hn : n ≠ 0) :
    Associated (n : ℤ_[p]) ((p.1 : ℤ_[p]) ^ padicValNat p.1 n) := by
  let m := n / p.1 ^ padicValNat p.1 n
  have hd : p.1 ^ padicValNat p.1 n ∣ n := pow_padicValNat_dvd
  have hdecomp : p.1 ^ padicValNat p.1 n * m = n := Nat.mul_div_cancel' hd
  have hmCoprime : p.1.Coprime m :=
    p.2.coprime_iff_not_dvd.mpr (ccmPadicResidual_not_dvd p hn)
  have hmUnit : IsUnit (m : ℤ_[p]) :=
    PadicInt.isUnit_iff.mpr (PadicInt.norm_natCast_eq_one_iff.mpr hmCoprime)
  have hcast : (n : ℤ_[p]) =
      (p.1 : ℤ_[p]) ^ padicValNat p.1 n * (m : ℤ_[p]) := by
    exact_mod_cast hdecomp.symm
  rw [hcast]
  exact associated_mul_unit_left _ _ hmUnit

/-- Principal ideals generated by `n` and by its exact local `p`-power agree in `ℤ_p`. -/
theorem ccmPadicInt_span_natCast_eq_span_primePower
    (p : Nat.Primes) {n : ℕ} (hn : n ≠ 0) :
    Ideal.span ({(n : ℤ_[p])} : Set ℤ_[p]) =
      Ideal.span {((p.1 : ℤ_[p]) ^ padicValNat p.1 n)} := by
  exact Ideal.span_singleton_eq_span_singleton.mpr
    (ccmPadicInt_natCast_associated_primePower p hn)

/-- In a commutative ring, the range of multiplication by `n` is the additive group of `(n)`. -/
theorem range_nsmulAddMonoidHom_eq_span_natCast
    {R : Type*} [CommRing R] (n : ℕ) :
    (nsmulAddMonoidHom (α := R) n).range =
      (Ideal.span ({(n : R)} : Set R)).toAddSubgroup := by
  ext x
  constructor
  · rintro ⟨y, rfl⟩
    have hmem : (n : R) * y ∈ Ideal.span ({(n : R)} : Set R) :=
      Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self (n : R))
    simpa [nsmulAddMonoidHom, nsmul_eq_mul] using hmem
  · intro hx
    change x ∈ Ideal.span ({(n : R)} : Set R) at hx
    rw [Ideal.mem_span_singleton] at hx
    rcases hx with ⟨y, rfl⟩
    exact ⟨y, by simp [nsmulAddMonoidHom, nsmul_eq_mul, mul_comm]⟩

/-- Exact local quotient classification at `p`. -/
noncomputable def ccmPadicIntQuotientNSMulEquivZModPow
    (p : Nat.Primes) (n : ℕ) (hn : n ≠ 0) :
    ℤ_[p] ⧸ (nsmulAddMonoidHom n).range ≃+
      ZMod (p.1 ^ padicValNat p.1 n) := by
  let e := padicValNat p.1 n
  let f := PadicInt.toZModPow (p := p.1) e
  have hker : (nsmulAddMonoidHom (α := ℤ_[p]) n).range =
      f.toAddMonoidHom.ker := by
    rw [range_nsmulAddMonoidHom_eq_span_natCast]
    ext x
    change x ∈ Ideal.span ({(n : ℤ_[p])} : Set ℤ_[p]) ↔
      x ∈ RingHom.ker f
    rw [ccmPadicInt_span_natCast_eq_span_primePower p hn]
    change x ∈ Ideal.span {((p.1 : ℤ_[p]) ^ e)} ↔
      x ∈ RingHom.ker (PadicInt.toZModPow e)
    exact (SetLike.ext_iff.mp (PadicInt.ker_toZModPow e) x).symm
  exact (QuotientAddGroup.quotientAddEquivOfEq hker).trans
    (QuotientAddGroup.quotientKerEquivOfSurjective f.toAddMonoidHom
      (ZMod.ringHom_surjective f))

/-- Local cardinality form of the quotient classification. -/
theorem ccmPadicIntQuotientNSMul_card
    (p : Nat.Primes) {n : ℕ} (hn : n ≠ 0) :
    Nat.card (ℤ_[p] ⧸ (nsmulAddMonoidHom n).range) =
      p.1 ^ padicValNat p.1 n := by
  rw [Nat.card_congr (ccmPadicIntQuotientNSMulEquivZModPow p n hn).toEquiv]
  exact Nat.card_zmod _

/-- Primes dividing `n`, indexed as prime subtypes or as `n.primeFactors`. -/
noncomputable def ccmPrimeFactorsPrimesEquiv (n : ℕ) :
    {p : Nat.Primes // p.1 ∈ n.primeFactors} ≃ n.primeFactors where
  toFun p := ⟨p.1.1, p.2⟩
  invFun p := ⟨⟨p.1, Nat.prime_of_mem_primeFactors p.2⟩, p.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

/-- Outside the prime factors of `n`, the local quotient is trivial. -/
@[reducible] noncomputable def ccmPadicIntQuotientNSMul_unique_of_not_primeFactor
    (p : Nat.Primes) {n : ℕ} (hn : n ≠ 0) (hp : p.1 ∉ n.primeFactors) :
    Unique (ℤ_[p.1] ⧸ (nsmulAddMonoidHom n).range) := by
  have hnotdvd : ¬p.1 ∣ n := by
    intro hdvd
    exact hp (p.2.mem_primeFactors hdvd hn)
  have hcard : Nat.card (ℤ_[p.1] ⧸ (nsmulAddMonoidHom n).range) = 1 := by
    rw [ccmPadicIntQuotientNSMul_card p hn,
      padicValNat.eq_zero_of_not_dvd hnotdvd, pow_zero]
  have h := Nat.card_eq_one_iff_unique.mp hcard
  exact { default := Classical.choice h.2
          uniq := fun x ↦ h.1.elim x (Classical.choice h.2) }

/-- Product of all local quotient cardinalities is the original natural number. -/
theorem ccmPadicIntPiQuotientFactors_card {n : ℕ} (hn : n ≠ 0) :
    Nat.card ((p : Nat.Primes) →
      ℤ_[p] ⧸ (nsmulAddMonoidHom n).range) = n := by
  classical
  let good := fun p : Nat.Primes ↦ p.1 ∈ n.primeFactors
  let e := Equiv.piEquivPiSubtypeProd good
    (fun p : Nat.Primes ↦ ℤ_[p] ⧸ (nsmulAddMonoidHom n).range)
  rw [Nat.card_congr e, Nat.card_prod]
  haveI : Fintype {p : Nat.Primes // good p} :=
    Fintype.ofEquiv n.primeFactors (ccmPrimeFactorsPrimesEquiv n).symm
  haveI (p : {p : Nat.Primes // ¬good p}) :
      Unique (ℤ_[p.1] ⧸ (nsmulAddMonoidHom n).range) :=
    ccmPadicIntQuotientNSMul_unique_of_not_primeFactor p.1 hn p.2
  rw [Nat.card_pi]
  have hbad : Nat.card ((p : {p : Nat.Primes // ¬good p}) →
      ℤ_[p.1] ⧸ (nsmulAddMonoidHom n).range) = 1 :=
    Nat.card_eq_one_iff_unique.mpr ⟨inferInstance, inferInstance⟩
  rw [hbad, mul_one]
  have hcards (p : {p : Nat.Primes // good p}) :
      Nat.card (ℤ_[p.1.1] ⧸ (nsmulAddMonoidHom n).range) =
        p.1.1 ^ padicValNat p.1.1 n :=
    ccmPadicIntQuotientNSMul_card p.1 hn
  simp_rw [hcards]
  calc
    (∏ p : {p : Nat.Primes // good p},
        p.1.1 ^ padicValNat p.1.1 n) =
        ∏ q : n.primeFactors,
          q.1 ^ padicValNat q.1 n := by
      exact Fintype.prod_equiv (ccmPrimeFactorsPrimesEquiv n)
        (fun p : {p : Nat.Primes // good p} ↦
          p.1.1 ^ padicValNat p.1.1 n)
        (fun q : n.primeFactors ↦ q.1 ^ padicValNat q.1 n)
        (fun _ ↦ rfl)
    _ = ∏ q : n.primeFactors,
          q.1 ^ n.factorization q.1 := by
      apply Fintype.prod_congr
      intro q
      rw [Nat.factorization_def n (Nat.prime_of_mem_primeFactors q.2)]
    _ = n := (Nat.prod_primeFactors_coe_pow_factorization hn).symm

/-- Quotient of the full `p`-adic integer product by multiplication by `n` has cardinality `n`. -/
theorem ccmPadicIntPiQuotientNSMul_card {n : ℕ} (hn : n ≠ 0) :
    Nat.card (((p : Nat.Primes) → ℤ_[p]) ⧸
      (nsmulAddMonoidHom n).range) = n := by
  rw [Nat.card_congr
    (QuotientAddGroup.addEquivPiModRangeNSMulAddMonoidHom
      (fun p : Nat.Primes ↦ ℤ_[p]) n).toEquiv]
  exact ccmPadicIntPiQuotientFactors_card hn

/-- Multiplication by nonzero `n` has index `n` on the full `p`-adic integer product. -/
theorem ccmPadicIntPiNSMulRange_index {n : ℕ} (hn : n ≠ 0) :
    (nsmulAddMonoidHom (α := (p : Nat.Primes) → ℤ_[p]) n).range.index = n := by
  rw [AddSubgroup.index_eq_card]
  exact ccmPadicIntPiQuotientNSMul_card hn

/-- Reindex a dependent product through an equivalence as an additive equivalence. -/
def addEquivPiCongrLeft {I K : Type*} (P : K → Type*)
    [∀ k, Add (P k)] (e : I ≃ K) :
    ((i : I) → P (e i)) ≃+ ((k : K) → P k) where
  toEquiv := Equiv.piCongrLeft P e
  map_add' x y := by
    funext k
    rw [← e.apply_symm_apply k]
    simp

/-- Additive identification of rational height-one local integers with all `ℤ_p`. -/
noncomputable def ccmRationalIntegralPiPadicEquiv :
    ((v : IsDedekindDomain.HeightOneSpectrum ℤ) →
        v.adicCompletionIntegers ℚ) ≃+
      ((p : Nat.Primes) → ℤ_[p]) :=
  (AddEquiv.piCongrRight fun v ↦
    by
      letI : Algebra ℤ (v.adicCompletionIntegers ℚ) := Ring.toIntAlgebra _
      exact (Rat.HeightOneSpectrum.adicCompletionIntegers.padicIntEquiv v).toAddEquiv).trans
  (addEquivPiCongrLeft (fun p : Nat.Primes ↦ ℤ_[p])
    Rat.HeightOneSpectrum.primesEquiv)

/-- Additive equivalences carry multiplication-by-`n` ranges to multiplication-by-`n` ranges. -/
theorem AddEquiv.map_range_nsmulAddMonoidHom
    {A B : Type*} [AddCommGroup A] [AddCommGroup B]
    (e : A ≃+ B) (n : ℕ) :
    ((nsmulAddMonoidHom (α := A) n).range.map e.toAddMonoidHom) =
      (nsmulAddMonoidHom (α := B) n).range := by
  ext y
  constructor
  · rintro ⟨x, ⟨z, rfl⟩, rfl⟩
    exact ⟨e z, by simp [nsmulAddMonoidHom]⟩
  · rintro ⟨z, rfl⟩
    refine ⟨n • e.symm z, ⟨e.symm z, by simp [nsmulAddMonoidHom]⟩, ?_⟩
    simp

/-- Exact index law in the height-one indexing of rational integral finite adeles. -/
theorem ccmRationalIntegralPiNSMulRange_index {n : ℕ} (hn : n ≠ 0) :
    (nsmulAddMonoidHom
      (α := (v : IsDedekindDomain.HeightOneSpectrum ℤ) →
        v.adicCompletionIntegers ℚ) n).range.index = n := by
  have hindex := AddSubgroup.index_map_equiv
    (nsmulAddMonoidHom
      (α := (v : IsDedekindDomain.HeightOneSpectrum ℤ) →
        v.adicCompletionIntegers ℚ) n).range
    ccmRationalIntegralPiPadicEquiv
  have hmap :
      AddSubgroup.map ccmRationalIntegralPiPadicEquiv.toAddMonoidHom
        (nsmulAddMonoidHom
          (α := (v : IsDedekindDomain.HeightOneSpectrum ℤ) →
            v.adicCompletionIntegers ℚ) n).range =
        (nsmulAddMonoidHom (α := (p : Nat.Primes) → ℤ_[p]) n).range :=
    ccmRationalIntegralPiPadicEquiv.map_range_nsmulAddMonoidHom n
  change (AddSubgroup.map ccmRationalIntegralPiPadicEquiv.toAddMonoidHom
      (nsmulAddMonoidHom
        (α := (v : IsDedekindDomain.HeightOneSpectrum ℤ) →
          v.adicCompletionIntegers ℚ) n).range).index = _ at hindex
  rw [hmap] at hindex
  calc
    (nsmulAddMonoidHom
      (α := (v : IsDedekindDomain.HeightOneSpectrum ℤ) →
        v.adicCompletionIntegers ℚ) n).range.index =
        (nsmulAddMonoidHom (α := (p : Nat.Primes) → ℤ_[p]) n).range.index :=
      hindex.symm
    _ = n := ccmPadicIntPiNSMulRange_index hn

end RHTower
end GaloisForLFunctions
