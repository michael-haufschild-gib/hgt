import GaloisForLFunctions.RHTower.CCM.CCMFirstClockSourcePhasedExteriorCurrent

/-!
# Global Cayley orientation of the Julia--Gamma exterior current

Linear height phases eventually wrap on an unbounded source.  The normalized Cayley phase

`uτ(h) = (1 + i τ h) / sqrt (1 + τ² h²)`

does not.  For every real height pair it converts the real antisymmetric exterior cell into the
positive square

`τ (hᵢ-hⱼ)² / (sqrt (1+τ²hᵢ²) sqrt (1+τ²hⱼ²))`.

The theorem is packet-uniform: it has no phase-diameter hypothesis.  Its Julia--Gamma
specialization therefore removes the finite-packet phase-wrap obstruction while retaining the
literal calibrated Euler exterior current.
-/

open Finset
open scoped BigOperators

noncomputable section
namespace RHTower

/-- Positive reciprocal normalization of the Cayley height phase. -/
def sourceCayleyPhaseScale
    {ι : Type*} (τ : ℝ) (height : ι → ℝ) (i : ι) : ℝ :=
  (Real.sqrt (1 + (τ * height i) ^ (2 : ℕ)))⁻¹

theorem sourceCayleyPhaseScale_pos
    {ι : Type*} (τ : ℝ) (height : ι → ℝ) (i : ι) :
    0 < sourceCayleyPhaseScale τ height i := by
  unfold sourceCayleyPhaseScale
  positivity

/-- Unit complex Cayley phase generated by a real source height. -/
def sourceCayleyPhase
    {ι : Type*} (τ : ℝ) (height : ι → ℝ) (i : ι) : ℂ :=
  (sourceCayleyPhaseScale τ height i : ℂ) +
    Complex.I *
      ((τ * height i * sourceCayleyPhaseScale τ height i : ℝ) : ℂ)

private theorem sourceCayleyPhaseScale_sq_mul
    {ι : Type*} (τ : ℝ) (height : ι → ℝ) (i : ι) :
    sourceCayleyPhaseScale τ height i ^ (2 : ℕ) *
        (1 + (τ * height i) ^ (2 : ℕ)) = 1 := by
  unfold sourceCayleyPhaseScale
  rw [inv_pow, Real.sq_sqrt (by positivity : 0 ≤ 1 + (τ * height i) ^ (2 : ℕ))]
  field_simp

/-- The Cayley height phase has unit norm at every height and every scale. -/
theorem norm_sourceCayleyPhase
    {ι : Type*} (τ : ℝ) (height : ι → ℝ) (i : ι) :
    ‖sourceCayleyPhase τ height i‖ = 1 := by
  have hscale := sourceCayleyPhaseScale_sq_mul τ height i
  have hnormSq : Complex.normSq (sourceCayleyPhase τ height i) = 1 := by
    rw [Complex.normSq_apply]
    simp only [sourceCayleyPhase, Complex.add_re, Complex.add_im,
      Complex.mul_re, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
      Complex.I_re, Complex.I_im, zero_mul, one_mul, mul_zero, zero_add]
    nlinarith
  rw [Complex.normSq_eq_norm_sq] at hnormSq
  nlinarith [norm_nonneg (sourceCayleyPhase τ height i)]

/-- Hermitian energy of `i` times a real exterior kernel against the global Cayley phase. -/
def sourceCayleyExteriorHermitianEnergy
    {ι : Type*} (packet : Finset ι) (amplitude height : ι → ℝ) (τ : ℝ) : ℂ :=
  ∑ i ∈ packet, ∑ j ∈ packet,
    star (sourceCayleyPhase τ height i) *
      (Complex.I *
        (amplitude i * amplitude j * (height i - height j) : ℝ)) *
      sourceCayleyPhase τ height j

/-- Explicit positive-square scalarization of the Cayley-oriented exterior kernel. -/
def sourceCayleyExteriorScalarEnergy
    {ι : Type*} (packet : Finset ι) (amplitude height : ι → ℝ) (τ : ℝ) : ℝ :=
  ∑ i ∈ packet, ∑ j ∈ packet,
    amplitude i * amplitude j * τ * (height i - height j) ^ (2 : ℕ) *
      sourceCayleyPhaseScale τ height i *
      sourceCayleyPhaseScale τ height j

/-- Pairwise Cayley orientation identity.  Unlike a linear phase, it is valid at arbitrary
height separation. -/
theorem sourceCayleyExteriorPair_re_eq
    {ι : Type*} (amplitude height : ι → ℝ) (τ : ℝ) (i j : ι) :
    (star (sourceCayleyPhase τ height i) *
        (Complex.I *
          (amplitude i * amplitude j * (height i - height j) : ℝ)) *
        sourceCayleyPhase τ height j).re =
      amplitude i * amplitude j * τ * (height i - height j) ^ (2 : ℕ) *
        sourceCayleyPhaseScale τ height i *
        sourceCayleyPhaseScale τ height j := by
  simp only [sourceCayleyPhase, Complex.star_def, map_add, map_mul,
    Complex.conj_ofReal, Complex.conj_I, Complex.ofReal_mul, Complex.mul_re,
    Complex.mul_im, Complex.add_re, Complex.add_im, Complex.neg_re,
    Complex.neg_im, Complex.ofReal_re, Complex.ofReal_im, Complex.I_re,
    Complex.I_im, neg_zero, zero_add, zero_mul, mul_zero, sub_zero, one_mul,
    neg_mul, zero_sub, neg_neg]
  ring

/-- The real Hermitian energy is exactly the global positive-square scalarization. -/
theorem sourceCayleyExteriorHermitianEnergy_re_eq
    {ι : Type*} (packet : Finset ι) (amplitude height : ι → ℝ) (τ : ℝ) :
    (sourceCayleyExteriorHermitianEnergy packet amplitude height τ).re =
      sourceCayleyExteriorScalarEnergy packet amplitude height τ := by
  rw [sourceCayleyExteriorHermitianEnergy, sourceCayleyExteriorScalarEnergy,
    Complex.re_sum]
  apply Finset.sum_congr rfl
  intro i hi
  rw [Complex.re_sum]
  apply Finset.sum_congr rfl
  intro j hj
  exact sourceCayleyExteriorPair_re_eq amplitude height τ i j

/-- Nonnegative amplitudes give a globally nonnegative Cayley-oriented exterior current.
No packet phase bound is required. -/
theorem sourceCayleyExteriorScalarEnergy_nonneg
    {ι : Type*} (packet : Finset ι) (amplitude height : ι → ℝ) (τ : ℝ)
    (hamp : ∀ i ∈ packet, 0 ≤ amplitude i) (hτ : 0 ≤ τ) :
    0 ≤ sourceCayleyExteriorScalarEnergy packet amplitude height τ := by
  unfold sourceCayleyExteriorScalarEnergy
  apply Finset.sum_nonneg
  intro i hi
  apply Finset.sum_nonneg
  intro j hj
  have hai := hamp i hi
  have haj := hamp j hj
  have hsi := (sourceCayleyPhaseScale_pos τ height i).le
  have hsj := (sourceCayleyPhaseScale_pos τ height j).le
  positivity

/-- With positive amplitudes, one unequal-height pair makes the globally oriented current
strictly positive. -/
theorem sourceCayleyExteriorScalarEnergy_pos
    {ι : Type*} (packet : Finset ι) (amplitude height : ι → ℝ) (τ : ℝ)
    (hamp : ∀ i ∈ packet, 0 < amplitude i) (hτ : 0 < τ)
    {i j : ι} (hi : i ∈ packet) (hj : j ∈ packet)
    (hheight : height i ≠ height j) :
    0 < sourceCayleyExteriorScalarEnergy packet amplitude height τ := by
  let term := fun i j =>
    amplitude i * amplitude j * τ * (height i - height j) ^ (2 : ℕ) *
      sourceCayleyPhaseScale τ height i *
      sourceCayleyPhaseScale τ height j
  have htermNonneg :
      ∀ k ∈ packet, ∀ l ∈ packet, 0 ≤ term k l := by
    intro k hk l hl
    dsimp only [term]
    have hak := (hamp k hk).le
    have hal := (hamp l hl).le
    have hsk := (sourceCayleyPhaseScale_pos τ height k).le
    have hsl := (sourceCayleyPhaseScale_pos τ height l).le
    positivity
  have htermPos : 0 < term i j := by
    dsimp only [term]
    have hai := hamp i hi
    have haj := hamp j hj
    have hd : 0 < (height i - height j) ^ (2 : ℕ) :=
      sq_pos_of_ne_zero (sub_ne_zero.mpr hheight)
    have hsi := sourceCayleyPhaseScale_pos τ height i
    have hsj := sourceCayleyPhaseScale_pos τ height j
    positivity
  have hinner :
      term i j ≤ ∑ l ∈ packet, term i l :=
    Finset.single_le_sum (fun l hl => htermNonneg i hi l hl) hj
  have houter :
      (∑ l ∈ packet, term i l) ≤
        ∑ k ∈ packet, ∑ l ∈ packet, term k l :=
    Finset.single_le_sum
      (fun k hk => Finset.sum_nonneg fun l hl => htermNonneg k hk l hl) hi
  change 0 <
    ∑ k ∈ packet, ∑ l ∈ packet,
      amplitude k * amplitude l * τ * (height k - height l) ^ (2 : ℕ) *
        sourceCayleyPhaseScale τ height k *
        sourceCayleyPhaseScale τ height l
  simpa only [term] using htermPos.trans_le (hinner.trans houter)

/-- Cayley-oriented Hermitian energy of the actual calibrated Julia--Gamma exterior current. -/
def gammaSewnMobiusJuliaCayleyExteriorHermitianEnergy
    (x u τ : ℝ) (packet : Finset (Nat.Primes × ℕ)) : ℂ :=
  sourceCayleyExteriorHermitianEnergy packet
    (xiGammaEulerBoundaryRealAmplitude u)
    (gammaSewnMobiusJuliaCalibratedEulerHeight x) τ

/-- Its explicit global positive-square scalar energy. -/
def gammaSewnMobiusJuliaCayleyExteriorScalarEnergy
    (x u τ : ℝ) (packet : Finset (Nat.Primes × ℕ)) : ℝ :=
  sourceCayleyExteriorScalarEnergy packet
    (xiGammaEulerBoundaryRealAmplitude u)
    (gammaSewnMobiusJuliaCalibratedEulerHeight x) τ

/-- The abstract Cayley exterior form is literally the Hermitian scalarization of the calibrated
Julia--Gamma exterior cell. -/
theorem gammaSewnMobiusJuliaCayleyExteriorHermitianEnergy_eq_calibrated
    (x u τ : ℝ) (packet : Finset (Nat.Primes × ℕ)) :
    gammaSewnMobiusJuliaCayleyExteriorHermitianEnergy x u τ packet =
      ∑ i ∈ packet, ∑ j ∈ packet,
        star
            (sourceCayleyPhase τ
              (gammaSewnMobiusJuliaCalibratedEulerHeight x) i) *
          (Complex.I *
            (gammaSewnMobiusJuliaCalibratedEulerExteriorCell x u i j : ℂ)) *
          sourceCayleyPhase τ
            (gammaSewnMobiusJuliaCalibratedEulerHeight x) j := by
  unfold gammaSewnMobiusJuliaCayleyExteriorHermitianEnergy
    sourceCayleyExteriorHermitianEnergy
  apply Finset.sum_congr rfl
  intro i hi
  apply Finset.sum_congr rfl
  intro j hj
  rw [gammaSewnMobiusJuliaCalibratedEulerExteriorCell_eq_heightDifference]

/-- The actual calibrated Julia--Gamma Cayley current is globally nonnegative for every finite
packet and every nonnegative Cayley scale. -/
theorem gammaSewnMobiusJuliaCayleyExteriorScalarEnergy_nonneg
    (x u τ : ℝ) (packet : Finset (Nat.Primes × ℕ)) (hτ : 0 ≤ τ) :
    0 ≤ gammaSewnMobiusJuliaCayleyExteriorScalarEnergy x u τ packet := by
  exact sourceCayleyExteriorScalarEnergy_nonneg packet _ _ τ
    (fun i _ => (xiGammaEulerBoundaryRealAmplitude_pos u i).le) hτ

/-- The actual Cayley-oriented Julia--Gamma current is strictly positive whenever a finite packet
contains two distinct calibrated heights. -/
theorem gammaSewnMobiusJuliaCayleyExteriorScalarEnergy_pos
    (x u τ : ℝ) (packet : Finset (Nat.Primes × ℕ)) (hτ : 0 < τ)
    {i j : Nat.Primes × ℕ} (hi : i ∈ packet) (hj : j ∈ packet)
    (hheight :
      gammaSewnMobiusJuliaCalibratedEulerHeight x i ≠
        gammaSewnMobiusJuliaCalibratedEulerHeight x j) :
    0 < gammaSewnMobiusJuliaCayleyExteriorScalarEnergy x u τ packet := by
  exact sourceCayleyExteriorScalarEnergy_pos packet _ _ τ
    (fun k _ => xiGammaEulerBoundaryRealAmplitude_pos u k) hτ hi hj hheight

end RHTower
