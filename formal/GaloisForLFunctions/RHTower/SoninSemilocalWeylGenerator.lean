import GaloisForLFunctions.HTGeometry.WeylCharacterGenerator
import GaloisForLFunctions.RHTower.SoninLogCoordinateScattering
import GaloisForLFunctions.RHTower.SoninSemilocalFluxSource

/-!
# The semilocal von-Mangoldt coefficient as a bounded Weyl-phase generator

The fixed Hilbert--Schmidt projection-correction response in
`SoninSemilocalTraceObstruction.lean` is uniformly bounded in the prime-power scale, so it cannot
equal the growing orbital length `log(p^m)`.  Weyl's exponentiated quantum relation gives a
different value interface.  Multiplication by the unitary logarithmic-position phase and physical
dilation obey

```text
M_t U_q = exp(-i t log q) U_q M_t.
```

Every multiplier on the right has modulus one, but its tangent at `t=0` is `-i log q`.  For
`q=p^m`, multiplying that tangent by the existing logarithmic Euler coefficient `p^(-m/2)/m`
recovers `log(p) p^(-m/2)`, exactly the finite von-Mangoldt source coefficient.

This is a positive successor to the bounded-response no-go, not a proof of the missing Sonin
descent.  The pointwise phase response is the actual Heisenberg conjugation orbit
`M_t U_q M_{-t}`.  The remaining analytic task is to descend that orbit through the
cutoff/scattering cyclic class and justify taking its tangent or Wigner--Smith relative phase
derivative.  No fixed bounded observable is asserted to equal `log q`.

The tangent relation is the exact linear-response value used in R. Kubo, *Statistical-Mechanical
Theory of Irreversible Processes. I*, J. Phys. Soc. Japan 12 (1957), 570--586,
DOI 10.1143/JPSJ.12.570.  The relative phase derivative follows the Wigner--Smith scattering-time
interface: E. P. Wigner, Phys. Rev. 98 (1955), 145--147, DOI 10.1103/PhysRev.98.145; F. T. Smith,
Phys. Rev. 118 (1960), 349--356, DOI 10.1103/PhysRev.118.349.
-/

open Complex

namespace RHTower

noncomputable section

/-- Pointwise unitary generated by logarithmic position. -/
def logPositionUnitaryFunction (t : ℝ) (f : ℝ → ℂ) (x : ℝ) : ℂ :=
  Complex.exp (Complex.I * (t : ℂ) * (Real.log |x| : ℂ)) * f x

/-- Logarithmic-position exponentiation preserves every pointwise amplitude away from the null
point (and in fact also at any point where the displayed logarithm is defined by Lean). -/
theorem norm_logPositionUnitaryFunction (t : ℝ) (f : ℝ → ℂ) (x : ℝ) :
    ‖logPositionUnitaryFunction t f x‖ = ‖f x‖ := by
  rw [logPositionUnitaryFunction, norm_mul, Complex.norm_exp]
  have hre :
      (Complex.I * (t : ℂ) * (Real.log |x| : ℂ)).re = 0 := by
    simp
  rw [hre, Real.exp_zero, one_mul]

/-- Opposite logarithmic-position phases cancel pointwise. -/
theorem logPositionUnitaryFunction_neg_cancel
    (t : ℝ) (f : ℝ → ℂ) (x : ℝ) :
    logPositionUnitaryFunction t (logPositionUnitaryFunction (-t) f) x = f x := by
  simp only [logPositionUnitaryFunction]
  rw [← mul_assoc, ← Complex.exp_add]
  have hexponent :
      Complex.I * (t : ℂ) * (Real.log |x| : ℂ) +
          Complex.I * ((-t : ℝ) : ℂ) * (Real.log |x| : ℂ) = 0 := by
    push_cast
    ring
  rw [hexponent, Complex.exp_zero, one_mul]

/-- **Exponentiated orbital-length commutator.**  The normalized physical dilation and the
unitary logarithmic-position character form the exact Weyl pair whose phase is the bounded
character generated by `log p`. -/
theorem logPositionUnitary_normalizedDilation_weyl
    (p : ℝ) (hp : 0 < p) (t : ℝ) (f : ℝ → ℂ) {x : ℝ} (hx : x ≠ 0) :
    logPositionUnitaryFunction t (normalizedDilationFunction p f) x =
      HTGeometry.scalarWeylCharacter (Real.log p) (t : ℂ) *
        normalizedDilationFunction p (logPositionUnitaryFunction t f) x := by
  have habsx : 0 < |x| := abs_pos.mpr hx
  have habs : |p * x| = p * |x| := by
    rw [abs_mul, abs_of_pos hp]
  simp only [logPositionUnitaryFunction, normalizedDilationFunction,
    HTGeometry.scalarWeylCharacter]
  rw [habs, Real.log_mul hp.ne' habsx.ne']
  have hphase :
      Complex.exp (Complex.I * (t : ℂ) * (Real.log |x| : ℂ)) =
        Complex.exp (-Complex.I * (Real.log p : ℂ) * (t : ℂ)) *
          Complex.exp (Complex.I * (t : ℂ) *
            (Real.log p + Real.log |x| : ℝ)) := by
    rw [← Complex.exp_add]
    push_cast
    congr 1
    ring
  rw [hphase]
  ring

/-- The actual real-parameter Heisenberg conjugation orbit of physical dilation by logarithmic
position. -/
def normalizedDilationWeylConjugationFunction
    (t p : ℝ) (f : ℝ → ℂ) (x : ℝ) : ℂ :=
  logPositionUnitaryFunction t
    (normalizedDilationFunction p (logPositionUnitaryFunction (-t) f)) x

/-- The Weyl character is exactly the phase acquired by the physical dilation under logarithmic
position conjugation.  It is therefore fixed by the existing Sonin geometry rather than fitted
independently from the arithmetic coefficient. -/
theorem normalizedDilationWeylConjugationFunction_eq_character
    (p : ℝ) (hp : 0 < p) (t : ℝ) (f : ℝ → ℂ) {x : ℝ} (hx : x ≠ 0) :
    normalizedDilationWeylConjugationFunction t p f x =
      HTGeometry.scalarWeylCharacter (Real.log p) (t : ℂ) *
        normalizedDilationFunction p f x := by
  rw [normalizedDilationWeylConjugationFunction,
    logPositionUnitary_normalizedDilation_weyl p hp t
      (logPositionUnitaryFunction (-t) f) hx]
  congr 1
  apply congrArg (fun g : ℝ → ℂ => normalizedDilationFunction p g x)
  funext y
  exact logPositionUnitaryFunction_neg_cancel t f y

/-- Complex-parameter continuation of the scalar phase multiplying one fixed physical-dilation
matrix value.  Its real restriction is the actual Heisenberg conjugation orbit above. -/
def normalizedDilationWeylCharacterOrbit
    (p : ℝ) (f : ℝ → ℂ) (x : ℝ) (z : ℂ) : ℂ :=
  HTGeometry.scalarWeylCharacter (Real.log p) z *
    normalizedDilationFunction p f x

/-- On the real parameter axis the complex character orbit is exactly logarithmic-position
conjugation of physical dilation. -/
theorem normalizedDilationWeylCharacterOrbit_ofReal
    (p : ℝ) (hp : 0 < p) (t : ℝ) (f : ℝ → ℂ) {x : ℝ} (hx : x ≠ 0) :
    normalizedDilationWeylCharacterOrbit p f x (t : ℂ) =
      normalizedDilationWeylConjugationFunction t p f x := by
  rw [normalizedDilationWeylConjugationFunction_eq_character p hp t f hx]
  rfl

/-- Differentiability of the physical-dilation Weyl character orbit. -/
theorem hasDerivAt_normalizedDilationWeylCharacterOrbit
    (p : ℝ) (f : ℝ → ℂ) (x : ℝ) (z : ℂ) :
    HasDerivAt (normalizedDilationWeylCharacterOrbit p f x)
      ((-Complex.I * (Real.log p : ℂ) *
          HTGeometry.scalarWeylCharacter (Real.log p) z) *
        normalizedDilationFunction p f x) z := by
  simpa only [normalizedDilationWeylCharacterOrbit] using!
    (HTGeometry.hasDerivAt_scalarWeylCharacter (Real.log p) z).mul_const
      (normalizedDilationFunction p f x)

/-- The tangent of the conjugation character is the skew logarithmic orbital length. -/
@[simp]
theorem deriv_normalizedDilationWeylCharacterOrbit_zero
    (p : ℝ) (f : ℝ → ℂ) (x : ℝ) :
    deriv (normalizedDilationWeylCharacterOrbit p f x) 0 =
      -Complex.I * (Real.log p : ℂ) * normalizedDilationFunction p f x := by
  rw [(hasDerivAt_normalizedDilationWeylCharacterOrbit p f x 0).deriv]
  simp

/-- **Kubo/Heisenberg tangent law.**  The identity tangent of the actual Weyl conjugation orbit is
`i` times the logarithmic-position/dilation commutator already present in the Sonin corpus. -/
theorem deriv_normalizedDilationWeylCharacterOrbit_zero_eq_I_mul_commutator
    (p : ℝ) (hp : 0 < p) (f : ℝ → ℂ) {x : ℝ} (hx : x ≠ 0) :
    deriv (normalizedDilationWeylCharacterOrbit p f x) 0 =
      Complex.I *
        (logPositionFunction (normalizedDilationFunction p f) x -
          normalizedDilationFunction p (logPositionFunction f) x) := by
  rw [deriv_normalizedDilationWeylCharacterOrbit_zero,
    logPosition_normalizedDilation_commutator p hp f hx]
  ring

/-- The bounded Weyl character at the actual semilocal prime-power scale. -/
def soninSemilocalWeylCharacter (pk : Nat.Primes × ℕ) (z : ℂ) : ℂ :=
  HTGeometry.scalarWeylCharacter
    (Real.log (soninSemilocalPrimePowerScale pk)) z

/-- Every real phase value remains on the unit circle, uniformly in the prime-power scale. -/
theorem norm_soninSemilocalWeylCharacter_ofReal
    (pk : Nat.Primes × ℕ) (t : ℝ) :
    ‖soninSemilocalWeylCharacter pk (t : ℂ)‖ = 1 := by
  exact HTGeometry.norm_scalarWeylCharacter_ofReal
    (Real.log (soninSemilocalPrimePowerScale pk)) t

/-- Wigner--Smith relative phase derivative of the actual semilocal prime-power character. -/
def soninSemilocalWignerSmithCharge (pk : Nat.Primes × ℕ) (t : ℝ) : ℂ :=
  Complex.I * (starRingEnd ℂ) (soninSemilocalWeylCharacter pk (t : ℂ)) *
    deriv (soninSemilocalWeylCharacter pk) (t : ℂ)

/-- The Wigner--Smith value recovers the full logarithmic orbital length at every real phase
parameter.  The source descent may therefore use any analytically accessible parameter rather
than a distinguished identity basepoint. -/
theorem soninSemilocalWignerSmithCharge_eq_log_scale
    (pk : Nat.Primes × ℕ) (t : ℝ) :
    soninSemilocalWignerSmithCharge pk t =
      (Real.log (soninSemilocalPrimePowerScale pk) : ℂ) := by
  simpa only [soninSemilocalWignerSmithCharge, soninSemilocalWeylCharacter] using!
    HTGeometry.scalarWeylWignerSmithValue_eq
      (Real.log (soninSemilocalPrimePowerScale pk)) t

/-- Weighting the Wigner--Smith charge by the existing logarithmic Euler coefficient recovers the
same semilocal prime-flux coefficient at every real phase parameter. -/
theorem soninSemilocalLogCoefficient_mul_wignerSmithCharge
    (pk : Nat.Primes × ℕ) (t : ℝ) :
    soninSemilocalLogPrimePowerCoefficient pk *
        soninSemilocalWignerSmithCharge pk t =
      soninSemilocalPrimeFluxCoefficient pk := by
  rw [soninSemilocalWignerSmithCharge_eq_log_scale,
    ← soninSemilocalLogScaleLength_eq_log_scale,
    soninSemilocalPrimeFluxCoefficient]

/-- The semilocal Weyl character is the exact phase in the physical-dilation relation, rather than
an independently fitted scalar character. -/
theorem logPositionUnitary_soninSemilocalPrimePower_weyl
    (pk : Nat.Primes × ℕ) (t : ℝ) (f : ℝ → ℂ) {x : ℝ} (hx : x ≠ 0) :
    logPositionUnitaryFunction t
        (normalizedDilationFunction (soninSemilocalPrimePowerScale pk) f) x =
      soninSemilocalWeylCharacter pk (t : ℂ) *
        normalizedDilationFunction (soninSemilocalPrimePowerScale pk)
          (logPositionUnitaryFunction t f) x := by
  exact logPositionUnitary_normalizedDilation_weyl
    (soninSemilocalPrimePowerScale pk)
    (zero_lt_one.trans (one_lt_soninSemilocalPrimePowerScale pk)) t f hx

/-- The bounded Weyl orbit weighted by the existing unsquared logarithmic Euler coefficient. -/
def soninSemilocalWeylFluxOrbit (pk : Nat.Primes × ℕ) (z : ℂ) : ℂ :=
  soninSemilocalLogPrimePowerCoefficient pk *
    soninSemilocalWeylCharacter pk z

/-- The weighted semilocal Weyl orbit multiplies the physical dilation exactly as the existing
Euler weight multiplies its actual logarithmic-position conjugation orbit. -/
theorem soninSemilocalWeylFluxOrbit_mul_normalizedDilation_eq_conjugation
    (pk : Nat.Primes × ℕ) (t : ℝ) (f : ℝ → ℂ) {x : ℝ} (hx : x ≠ 0) :
    soninSemilocalWeylFluxOrbit pk (t : ℂ) *
        normalizedDilationFunction (soninSemilocalPrimePowerScale pk) f x =
      soninSemilocalLogPrimePowerCoefficient pk *
        normalizedDilationWeylConjugationFunction t
          (soninSemilocalPrimePowerScale pk) f x := by
  rw [normalizedDilationWeylConjugationFunction_eq_character
    (soninSemilocalPrimePowerScale pk)
    (zero_lt_one.trans (one_lt_soninSemilocalPrimePowerScale pk)) t f hx]
  simp only [soninSemilocalWeylFluxOrbit, soninSemilocalWeylCharacter]
  ring

/-- The weighted orbit is bounded on the real parameter axis by the modulus of the Euler
coefficient; the growing logarithmic source is retained only in its tangent. -/
theorem norm_soninSemilocalWeylFluxOrbit_ofReal
    (pk : Nat.Primes × ℕ) (t : ℝ) :
    ‖soninSemilocalWeylFluxOrbit pk (t : ℂ)‖ =
      ‖soninSemilocalLogPrimePowerCoefficient pk‖ := by
  rw [soninSemilocalWeylFluxOrbit, norm_mul,
    norm_soninSemilocalWeylCharacter_ofReal, mul_one]

/-- Differentiability of the weighted semilocal Weyl orbit. -/
theorem hasDerivAt_soninSemilocalWeylFluxOrbit
    (pk : Nat.Primes × ℕ) (z : ℂ) :
    HasDerivAt (soninSemilocalWeylFluxOrbit pk)
      (soninSemilocalLogPrimePowerCoefficient pk *
        (-Complex.I *
          (Real.log (soninSemilocalPrimePowerScale pk) : ℂ) *
            soninSemilocalWeylCharacter pk z)) z := by
  simpa only [soninSemilocalWeylFluxOrbit, soninSemilocalWeylCharacter] using!
    (HTGeometry.hasDerivAt_scalarWeylCharacter
      (Real.log (soninSemilocalPrimePowerScale pk)) z).const_mul
        (soninSemilocalLogPrimePowerCoefficient pk)

/-- The identity tangent is the skew form of the exact semilocal prime-flux coefficient. -/
@[simp]
theorem deriv_soninSemilocalWeylFluxOrbit_zero
    (pk : Nat.Primes × ℕ) :
    deriv (soninSemilocalWeylFluxOrbit pk) 0 =
      -Complex.I * soninSemilocalPrimeFluxCoefficient pk := by
  rw [(hasDerivAt_soninSemilocalWeylFluxOrbit pk 0).deriv]
  simp only [soninSemilocalWeylCharacter, HTGeometry.scalarWeylCharacter_zero,
    mul_one]
  rw [soninSemilocalPrimeFluxCoefficient,
    soninSemilocalLogScaleLength_eq_log_scale]
  ring

/-- **Weyl-generator von-Mangoldt value.**  The tangent of a bounded phase orbit recovers the
full, unsquared semilocal arithmetic flux coefficient. -/
theorem I_mul_deriv_soninSemilocalWeylFluxOrbit_zero
    (pk : Nat.Primes × ℕ) :
    Complex.I * deriv (soninSemilocalWeylFluxOrbit pk) 0 =
      soninSemilocalPrimeFluxCoefficient pk := by
  rw [deriv_soninSemilocalWeylFluxOrbit_zero]
  calc
    Complex.I * (-Complex.I * soninSemilocalPrimeFluxCoefficient pk) =
        -(Complex.I * Complex.I) * soninSemilocalPrimeFluxCoefficient pk := by ring
    _ = soninSemilocalPrimeFluxCoefficient pk := by
      rw [Complex.I_mul_I]
      ring

/-- Direct finite-corpus consumer: the existing finite von-Mangoldt central trace is the weighted
sum of the identity tangents of the bounded prime-power Weyl orbits. -/
theorem finiteVonMangoldtCentralTrace_eq_sum_weylGenerators
    (f : SoninPrimePowerTest) :
    finiteVonMangoldtCentralTrace f =
      f.sum fun pk w =>
        w * (Complex.I * deriv (soninSemilocalWeylFluxOrbit pk) 0) := by
  rw [finiteVonMangoldtCentralTrace]
  apply Finsupp.sum_congr
  intro pk hpk
  rw [I_mul_deriv_soninSemilocalWeylFluxOrbit_zero,
    soninSemilocalPrimeFluxCoefficient_eq_vonMangoldt]

/-- **Wigner--Smith finite-trace consumer.**  At every real phase parameter, the finite
von-Mangoldt central trace is the weighted sum of relative phase derivatives of the bounded
prime-power channels.  No identity-basepoint limit is required. -/
theorem finiteVonMangoldtCentralTrace_eq_sum_wignerSmithCharges
    (f : SoninPrimePowerTest) (t : ℝ) :
    finiteVonMangoldtCentralTrace f =
      f.sum fun pk w =>
        w * (soninSemilocalLogPrimePowerCoefficient pk *
          soninSemilocalWignerSmithCharge pk t) := by
  rw [finiteVonMangoldtCentralTrace]
  apply Finsupp.sum_congr
  intro pk hpk
  rw [soninSemilocalLogCoefficient_mul_wignerSmithCharge,
    soninSemilocalPrimeFluxCoefficient_eq_vonMangoldt]

end

