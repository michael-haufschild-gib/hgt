import GaloisForLFunctions.RHTower.ThetaCuspHawkingBMSourceFECenteredQNMClockRigidity

/-!
# Finite physical-clock covariance rigidity for the HB source

The centered Birmingham--Mokhtari QNM generator already exposes the infinitesimal source-FE clock
defect. This module classifies a strictly weaker datum: covariance of one finite physical-time
step. For the real physical propagator `exp(-i t H)`, anti-linearity converts horizontal Xi tilt
into positive real gain rather than a periodic phase. Consequently there are no finite-time
aliases:

`sourceFE (U_t e_q) = U_t (sourceFE e_q) ↔ t = 0 ∨ Re(q) = 1/2`.

On finite packets, one fixed nonzero source-predeclared time is therefore enough: global
covariance is exactly RH. This kills finite-clock sampling as an easier HB escape while reducing
the remaining physical producer from an infinitesimal or all-time Ward law to one finite-time
Einstein--Teukolsky covariance identity.

`[NEW] [FINITE PHYSICAL CLOCK] [NO ALIASES] [EXACT RH ENDPOINT] [LEAN-PROVED]`
-/

open Complex Real

namespace RHTower

noncomputable section

/-- Physical finite-time evolution generated by the centered BM QNM frequency. -/
def hbXiPeierlsCenteredQNMPhysicalClockStep (n : ℕ) (t : ℝ) :
    HBXiPeierlsPacket →ₗ[ℂ] HBXiPeierlsPacket :=
  hbXiPeierlsWeightedPacketLinear fun q =>
    Complex.exp
      (-Complex.I * (t : ℂ) * hbXiPeierlsCenteredQNMFrequency n q)

@[simp]
theorem hbXiPeierlsCenteredQNMPhysicalClockStep_single
    (n : ℕ) (t : ℝ) (q : XiZeroCopy) (c : ℂ) :
    hbXiPeierlsCenteredQNMPhysicalClockStep n t (Finsupp.single q c) =
      Finsupp.single q
        (Complex.exp
            (-Complex.I * (t : ℂ) * hbXiPeierlsCenteredQNMFrequency n q) * c) := by
  exact hbXiPeierlsWeightedPacket_single _ q c

@[simp]
theorem hbXiPeierlsCenteredQNMPhysicalClockStep_apply
    (n : ℕ) (t : ℝ) (x : HBXiPeierlsPacket) (q : XiZeroCopy) :
    hbXiPeierlsCenteredQNMPhysicalClockStep n t x q =
      Complex.exp
          (-Complex.I * (t : ℂ) * hbXiPeierlsCenteredQNMFrequency n q) * x q := by
  exact hbXiPeierlsWeightedPacket_apply _ x q

theorem hbXiPeierlsUnitSourceFEPhysicalClockStep_left_single
    (n : ℕ) (t : ℝ) (q : XiZeroCopy) :
    hbXiPeierlsUnitSourceFEPacketTransport
        (hbXiPeierlsCenteredQNMPhysicalClockStep n t (Finsupp.single q 1)) =
      Finsupp.single (xiZeroCopyReflectEquiv q)
        (hbXiPeierlsUnitSourceFECocycle q *
          Complex.exp
            (Complex.I * (t : ℂ) *
              (starRingEnd ℂ) (hbXiPeierlsCenteredQNMFrequency n q))) := by
  rw [hbXiPeierlsCenteredQNMPhysicalClockStep_single,
    hbXiPeierlsUnitSourceFEPacketTransport_single]
  simp only [map_mul, map_one]
  congr 1
  rw [← Complex.exp_conj]
  congr 1
  simp only [map_mul, map_neg]
  simp

theorem hbXiPeierlsUnitSourceFEPhysicalClockStep_right_single
    (n : ℕ) (t : ℝ) (q : XiZeroCopy) :
    hbXiPeierlsCenteredQNMPhysicalClockStep n t
        (hbXiPeierlsUnitSourceFEPacketTransport (Finsupp.single q 1)) =
      Finsupp.single (xiZeroCopyReflectEquiv q)
        (hbXiPeierlsUnitSourceFECocycle q *
          Complex.exp
            (Complex.I * (t : ℂ) * hbXiPeierlsCenteredQNMFrequency n q)) := by
  rw [hbXiPeierlsUnitSourceFEPacketTransport_single,
    hbXiPeierlsCenteredQNMPhysicalClockStep_single,
    hbXiPeierlsCenteredQNMFrequency_reflect]
  simp only [map_one]
  congr 1
  ring_nf

theorem hbXiPeierlsCenteredQNMFrequency_im_eq
    (n : ℕ) (q : XiZeroCopy) :
    (hbXiPeierlsCenteredQNMFrequency n q).im =
      (1 / 2 - (q.1 : ℂ).re) / 2 := by
  rw [hbXiPeierlsCenteredQNMFrequency_eq]
  simp [xiSpectralPoint, Complex.mul_im]

/-- At one Xi copy, a finite physical clock step commutes with literal anti-linear source-FE
transport exactly at zero elapsed time or on the critical wall. -/
theorem hbXiPeierlsUnitSourceFEPhysicalClockStep_single_commute_iff
    (n : ℕ) (t : ℝ) (q : XiZeroCopy) :
    hbXiPeierlsUnitSourceFEPacketTransport
        (hbXiPeierlsCenteredQNMPhysicalClockStep n t (Finsupp.single q 1)) =
      hbXiPeierlsCenteredQNMPhysicalClockStep n t
        (hbXiPeierlsUnitSourceFEPacketTransport (Finsupp.single q 1)) ↔
      t = 0 ∨ (q.1 : ℂ).re = 1 / 2 := by
  constructor
  · intro h
    have hcoeff := congrArg
      (fun x : HBXiPeierlsPacket => x (xiZeroCopyReflectEquiv q)) h
    rw [hbXiPeierlsUnitSourceFEPhysicalClockStep_left_single,
      hbXiPeierlsUnitSourceFEPhysicalClockStep_right_single] at hcoeff
    simp only [Finsupp.single_eq_same] at hcoeff
    have hexp :
        Complex.exp
            (Complex.I * (t : ℂ) *
              (starRingEnd ℂ) (hbXiPeierlsCenteredQNMFrequency n q)) =
          Complex.exp
            (Complex.I * (t : ℂ) * hbXiPeierlsCenteredQNMFrequency n q) :=
      mul_left_cancel₀ (hbXiPeierlsUnitSourceFECocycle_ne_zero q) hcoeff
    have hnorm := congrArg norm hexp
    rw [Complex.norm_exp, Complex.norm_exp] at hnorm
    have hreLeft :
        (Complex.I * (t : ℂ) *
          (starRingEnd ℂ) (hbXiPeierlsCenteredQNMFrequency n q)).re =
        t * (hbXiPeierlsCenteredQNMFrequency n q).im := by
      simp [Complex.mul_re, Complex.mul_im]
    have hreRight :
        (Complex.I * (t : ℂ) * hbXiPeierlsCenteredQNMFrequency n q).re =
        -(t * (hbXiPeierlsCenteredQNMFrequency n q).im) := by
      simp [Complex.mul_re, Complex.mul_im]
    rw [hreLeft, hreRight] at hnorm
    have harg :
        t * (hbXiPeierlsCenteredQNMFrequency n q).im =
          -(t * (hbXiPeierlsCenteredQNMFrequency n q).im) :=
      Real.exp_injective hnorm
    have hprod : t * (hbXiPeierlsCenteredQNMFrequency n q).im = 0 := by
      linarith
    rcases mul_eq_zero.mp hprod with ht | him
    · exact Or.inl ht
    · right
      rw [hbXiPeierlsCenteredQNMFrequency_im_eq] at him
      linarith
  · rintro (ht | hline)
    · subst t
      rw [hbXiPeierlsUnitSourceFEPhysicalClockStep_left_single,
        hbXiPeierlsUnitSourceFEPhysicalClockStep_right_single]
      simp
    · have him : (hbXiPeierlsCenteredQNMFrequency n q).im = 0 := by
        rw [hbXiPeierlsCenteredQNMFrequency_im_eq, hline]
        norm_num
      have hreal :
          (starRingEnd ℂ) (hbXiPeierlsCenteredQNMFrequency n q) =
            hbXiPeierlsCenteredQNMFrequency n q := by
        apply Complex.ext
        · simp
        · simp [him]
      rw [hbXiPeierlsUnitSourceFEPhysicalClockStep_left_single,
        hbXiPeierlsUnitSourceFEPhysicalClockStep_right_single, hreal]

theorem hbXiPeierlsCenteredQNMPhysicalClockStep_zero
    (n : ℕ) (x : HBXiPeierlsPacket) :
    hbXiPeierlsCenteredQNMPhysicalClockStep n 0 x = x := by
  ext q
  simp [hbXiPeierlsCenteredQNMPhysicalClockStep_apply]

private theorem hbXiPeierlsCenteredQNMPhysicalClockStep_conj_reflect
    (n : ℕ) (t : ℝ) (q : XiZeroCopy)
    (hline : (q.1 : ℂ).re = 1 / 2) :
    (starRingEnd ℂ)
        (Complex.exp
          (-Complex.I * (t : ℂ) * hbXiPeierlsCenteredQNMFrequency n q)) =
      Complex.exp
        (-Complex.I * (t : ℂ) *
          hbXiPeierlsCenteredQNMFrequency n (xiZeroCopyReflectEquiv q)) := by
  rw [← Complex.exp_conj]
  congr 1
  have him : (hbXiPeierlsCenteredQNMFrequency n q).im = 0 := by
    rw [hbXiPeierlsCenteredQNMFrequency_im_eq, hline]
    norm_num
  have hreal :
      (starRingEnd ℂ) (hbXiPeierlsCenteredQNMFrequency n q) =
        hbXiPeierlsCenteredQNMFrequency n q := by
    apply Complex.ext
    · simp
    · simp [him]
  simp only [map_mul, map_neg]
  rw [hreal, hbXiPeierlsCenteredQNMFrequency_reflect]
  simp

/-- Full finite-packet covariance of one physical centered-QNM clock step. -/
def HBXiPeierlsUnitSourceFEPhysicalClockStepCovariant
    (n : ℕ) (t : ℝ) : Prop :=
  ∀ x : HBXiPeierlsPacket,
    hbXiPeierlsUnitSourceFEPacketTransport
        (hbXiPeierlsCenteredQNMPhysicalClockStep n t x) =
      hbXiPeierlsCenteredQNMPhysicalClockStep n t
        (hbXiPeierlsUnitSourceFEPacketTransport x)

/-- A finite physical clock step is globally FE-covariant exactly at zero time or under RH. -/
theorem hbXiPeierlsUnitSourceFEPhysicalClockStepCovariant_iff
    (n : ℕ) (t : ℝ) :
    HBXiPeierlsUnitSourceFEPhysicalClockStepCovariant n t ↔
      t = 0 ∨ RiemannHypothesis := by
  constructor
  · intro h
    by_cases ht : t = 0
    · exact Or.inl ht
    · right
      apply (forall_hbXiPeierlsUnitSourceFEBasisTransport_fixedPairing_iff_rh).mp
      intro q
      apply (hbXiPeierlsUnitSourceFEBasisTransport_fixedPairing_iff q).mpr
      exact
        (hbXiPeierlsUnitSourceFEPhysicalClockStep_single_commute_iff n t q).mp
          (h (Finsupp.single q 1)) |>.resolve_left ht
  · rintro (ht | hRH)
    · subst t
      intro x
      rw [hbXiPeierlsCenteredQNMPhysicalClockStep_zero,
        hbXiPeierlsCenteredQNMPhysicalClockStep_zero]
    · intro x
      ext r
      simp only [hbXiPeierlsUnitSourceFEPacketTransport_apply,
        hbXiPeierlsCenteredQNMPhysicalClockStep_apply, map_mul]
      have hline : ((xiZeroCopyReflectEquiv r).1 : ℂ).re = 1 / 2 :=
        (hbXiPeierlsUnitSourceFEBasisTransport_fixedPairing_iff
          (xiZeroCopyReflectEquiv r)).mp
            ((forall_hbXiPeierlsUnitSourceFEBasisTransport_fixedPairing_iff_rh).mpr hRH
              (xiZeroCopyReflectEquiv r))
      rw [hbXiPeierlsCenteredQNMPhysicalClockStep_conj_reflect n t
        (xiZeroCopyReflectEquiv r) hline]
      simp only [xiZeroCopyReflectEquiv_apply_apply]
      ring_nf

/-- At any one fixed nonzero physical time, full finite-packet covariance is exactly RH. -/
theorem hbXiPeierlsUnitSourceFEPhysicalClockStepCovariant_iff_rh
    (n : ℕ) {t : ℝ} (ht : t ≠ 0) :
    HBXiPeierlsUnitSourceFEPhysicalClockStepCovariant n t ↔
      RiemannHypothesis := by
  rw [hbXiPeierlsUnitSourceFEPhysicalClockStepCovariant_iff]
  exact or_iff_right ht

/-- Closed unit-time HB endpoint: one source-predeclared finite physical clock step is covariant
exactly under RH. -/
theorem hbXiPeierlsUnitSourceFEUnitPhysicalClockStepCovariant_iff_rh :
    HBXiPeierlsUnitSourceFEPhysicalClockStepCovariant 0 1 ↔
      RiemannHypothesis := by
  exact hbXiPeierlsUnitSourceFEPhysicalClockStepCovariant_iff_rh 0 one_ne_zero

end

end RHTower
