/-
# The weld spectrum is gapless: the archimedean rate group is dense in ℝ

A native invariant of the archimedean–difference weld, intrinsic to how `∂_s` glues to `{σ_p}` and
blind to the location of any zero.

The prime shift `σ_p` multiplies by `p^{−s}`, so on the difference algebra generated by the `σ_p`
the archimedean derivation `∂_s` acts as `[∂_s, σ_p] = −(log p)·σ_p`: each `σ_p` is an eigenvector
of `ad(∂_s)` with eigenvalue `−log p`.  A monomial `∏ σ_p^{a_p}` has eigenvalue `−∑ a_p log p =
−log ∏ p^{a_p}`, so the **spectrum of `ad(∂_s)` on the difference algebra is the rate group**
`primeLogLattice = ⟨log p : p prime⟩ ⊆ ℝ` — already the carrier of the weld cocycle in
`WeldClassTable`.

`WeldClassTable`/`WeldRateLattice` record that this group is *free* (`ℤ`-linearly independent
generators).  This file records its *topology*: it is **dense** in the archimedean line.

* `primeLogLattice_not_cyclic` — the rate group has no fundamental frequency: it is not `⟨a⟩` for any
  single `a`.  Two distinct prime rates `log 2, log 3` with `ℤ`-independent (irrational-ratio) values
  cannot both be integer multiples of one generator.
* `primeLogLattice_dense` — hence, by the dichotomy `dense ∨ cyclic` for subgroups of ℝ, the rate
  group is dense: `ad(∂_s)` has **no spectral gap** on the difference algebra.

The consequence is structural, not a detector: the seam carries no smallest rate quantum, so no
discrete clock scale is intrinsic to the weld — the difference shifts fill the archimedean line
densely.  This is the spectral counterpart of clock non-localization (`SeamClockSelection`): the
weld's own rate spectrum offers nothing discrete to localize on.  It sees no zero of anything; it is
a property of the primes' logarithms as they sit inside `ℝ`.
-/
import GaloisForLFunctions.HTGeometry.WeldClassTable
import GaloisForLFunctions.HTGeometry.ExpNatIrrational

open Real

namespace GaloisForLFunctions
namespace RHTower

/-- **No fundamental frequency.**  The archimedean rate group `⟨log p⟩` is not cyclic: it is not the
group generated by any single real `a`.  If it were, `log 2` and `log 3` would both be integer
multiples of `a`, forcing an integer relation `m·log 2 = n·log 3` with `m, n` not both zero — ruled
out by `ℤ`-independence of the prime logarithms (unique factorization). -/
theorem primeLogLattice_not_cyclic : ¬ ∃ a : ℝ, primeLogLattice = AddSubgroup.closure {a} := by
  rintro ⟨a, ha⟩
  have h2 : Real.log (2:ℕ) ∈ primeLogLattice := primeLog_mem_primeLogLattice (by norm_num)
  have h3 : Real.log (3:ℕ) ∈ primeLogLattice := primeLog_mem_primeLogLattice (by norm_num)
  rw [ha, AddSubgroup.mem_closure_singleton] at h2 h3
  obtain ⟨n, hn⟩ := h2
  obtain ⟨m, hm⟩ := h3
  have key : (m:ℝ) * Real.log (2:ℕ) + ((-n : ℤ):ℝ) * Real.log (3:ℕ) = 0 := by
    rw [← hn, ← hm, zsmul_eq_mul, zsmul_eq_mul]; push_cast; ring
  obtain ⟨hm0, hn0'⟩ :=
    two_prime_log_indep (by norm_num) (by norm_num) (by norm_num) m (-n) key
  have hn0 : n = 0 := by omega
  rw [hn0, zero_zsmul] at hn
  exact (Real.log_pos (by norm_num : (1:ℝ) < (2:ℕ))).ne' hn.symm

/-- **The weld spectrum is gapless.**  The archimedean rate group `⟨log p⟩ = primeLogLattice`, the
spectrum of `ad(∂_s)` on the prime-shift difference algebra, is dense in ℝ.  By the order-dichotomy
`Dense ∨ cyclic` for subgroups of an archimedean ordered group, density is exactly the failure of
`primeLogLattice_not_cyclic`.  So the weld has no spectral gap and no smallest rate quantum: the
difference base fills the archimedean line densely, and nothing discrete is available for a clock to
localize on. -/
theorem primeLogLattice_dense : Dense (primeLogLattice : Set ℝ) := by
  rcases AddSubgroup.dense_or_cyclic primeLogLattice with hd | hcyc
  · exact hd
  · exact absurd hcyc primeLogLattice_not_cyclic

/-- **No fundamental frequency quantum.**  The concrete payoff of gaplessness: the weld admits
arbitrarily small positive rates — for every `ε > 0` there is a nonzero rate `x ∈ ⟨log p⟩` with
`0 < x < ε`.  There is no smallest step in the archimedean spectrum of `ad(∂_s)`, so the seam offers
no intrinsic frequency unit around which a discrete clock could be built. -/
theorem primeLogLattice_arbitrarily_small_rate :
    ∀ ε : ℝ, 0 < ε → ∃ x ∈ primeLogLattice, 0 < x ∧ x < ε := by
  intro ε hε
  have hne : (Set.Ioo (0:ℝ) ε).Nonempty := ⟨ε/2, by constructor <;> linarith⟩
  obtain ⟨x, hx⟩ :=
    (dense_iff_inter_open.mp primeLogLattice_dense) (Set.Ioo 0 ε) isOpen_Ioo hne
  exact ⟨x, hx.2, hx.1.1, hx.1.2⟩

/-- **Each fundamental rate is irrational.**  The generating rate `log p` of the weld spectrum is
irrational: if `log p = a/b` then `p^b = e^{a}` would make `e^{a}` rational for a nonzero integer
`a`, contradicting the irrationality of `e^{a}`.  So no fundamental frequency of the weld is
commensurable with `1` — the archimedean unit rate `log e = 1` is transcendental over the arithmetic
prime rates, which are themselves all irrational. -/
theorem primeLog_irrational {p : ℕ} (hp : 2 ≤ p) : Irrational (Real.log p) := by
  rintro ⟨r, hr⟩
  have hp0 : (0 : ℝ) < p := by positivity
  have hexp : Real.exp (r : ℝ) = p := by rw [hr, Real.exp_log hp0]
  have hden : ((r.num : ℤ) : ℝ) = (r.den : ℝ) * (r : ℝ) := by rw [Rat.cast_def]; field_simp
  have hpow : Real.exp ((r.num : ℤ) : ℝ) = (p : ℝ) ^ r.den := by rw [hden, Real.exp_nat_mul, hexp]
  have hne : (r.num : ℤ) ≠ 0 := by
    intro h0
    have hr0 : (r : ℝ) = 0 := by rw [Rat.cast_def, h0]; simp
    rw [hr0, Real.exp_zero] at hexp
    have h2 : (2 : ℝ) ≤ (p : ℝ) := by exact_mod_cast hp
    linarith
  have hirr : Irrational (Real.exp ((r.num : ℤ) : ℝ)) := exp_int_irrational hne
  rw [hpow] at hirr
  exact hirr ⟨(p ^ r.den : ℚ), by push_cast; ring⟩

end RHTower
end GaloisForLFunctions
