/-! ## Graph-normalized physical clock splitting -/

/-- Cubic physical splitting recovers the full same-atom codiagonal with an
error that vanishes even after one inverse normal amplification.  The
existing energy theorem supplies the independent squared-normal estimate. -/
theorem
    tendsto_cubicClockSplitSameAtomCodiagonal_error_div_normalScale_zero
    {ι : Type*}
    (p a d h : ι → ℝ)
    (hcollision : Summable (fun i => p i ^ 2 * a i * d i)) :
    Tendsto
      (fun n : ℕ =>
        (physicalSplitSameAtomCodiagonalOn
            (cubicClockSplitReplicaCount n)
            (cubicClockSplitOffset n) p a d h -
          2 * ∑' i, p i ^ 2 * a i * d i) /
            cubicClockSplitNormalScale n)
      atTop (nhds 0) := by
  let C : ℝ := ∑' i, p i ^ 2 * a i * d i
  have hscale : Tendsto cubicClockSplitNormalScale atTop (nhds 0) := by
    have heq : cubicClockSplitNormalScale =
        fun n : ℕ => (((n : ℝ) + 1))⁻¹ := by
      funext n
      rw [cubicClockSplitNormalScale]
      norm_num
    rw [heq]
    simpa only [one_div] using
      (tendsto_one_div_add_atTop_nhds_zero_nat :
        Tendsto (fun n : ℕ => 1 / ((n : ℝ) + 1)) atTop (nhds 0))
  have hoffset (n : ℕ) :
      cubicClockSplitOffset n = cubicClockSplitNormalScale n ^ 3 := by
    rw [cubicClockSplitOffset, cubicClockSplitNormalScale,
      cubicClockSplitReplicaCount]
    push_cast
    rw [inv_pow]
  have hvalue (n : ℕ) :
      physicalSplitSameAtomCodiagonalOn
          (cubicClockSplitReplicaCount n)
          (cubicClockSplitOffset n) p a d h =
        2 * (1 - cubicClockSplitOffset n) * C := by
    rw [physicalSplitSameAtomCodiagonalOn_eq
        (cubicClockSplitReplicaCount_pos n)
        (cubicClockSplitOffset_pos n)]
    rw [splitSameAtomCodiagonalOn_eq
      (cubicClockSplitReplicaCount_pos n) p a d hcollision]
    rfl
  have herr (n : ℕ) :
      (physicalSplitSameAtomCodiagonalOn
            (cubicClockSplitReplicaCount n)
            (cubicClockSplitOffset n) p a d h - 2 * C) /
          cubicClockSplitNormalScale n =
        -2 * cubicClockSplitNormalScale n ^ 2 * C := by
    rw [hvalue, hoffset]
    have hscale0 : cubicClockSplitNormalScale n ≠ 0 := by
      rw [cubicClockSplitNormalScale]
      positivity
    field_simp [hscale0]
    ring
  have hlim : Tendsto
      (fun n : ℕ => -2 * cubicClockSplitNormalScale n ^ 2 * C)
      atTop (nhds 0) := by
    simpa [mul_assoc, mul_comm, mul_left_comm] using
      (hscale.pow 2).const_mul (-2 * C)
  apply hlim.congr'
  filter_upwards with n
  simpa only [C] using (herr n).symm

private theorem squarefreeMobiusProbability_le_one
    {sigma : ℝ} (hsigma : 1 < sigma) (n : ℕ) :
    squarefreeMobiusProbability sigma n ≤ 1 := by
  calc
    squarefreeMobiusProbability sigma n ≤
        (squarefreeMobiusTotal sigma)⁻¹ :=
      squarefreeMobiusProbability_le_invTotal hsigma n
    _ ≤ 1 := by
      rw [inv_le_one₀ (squarefreeMobiusTotal_pos hsigma)]
      have hterm : squarefreeMobiusMass sigma 1 = 1 := by
        simp [squarefreeMobiusMass]
      calc
        1 = squarefreeMobiusMass sigma 1 := hterm.symm
        _ ≤ ∑' n, squarefreeMobiusMass sigma n :=
          (summable_squarefreeMobiusMass hsigma).le_tsum 1
            (fun j _ => squarefreeMobiusMass_nonneg sigma j)
        _ = squarefreeMobiusTotal sigma := rfl

private theorem
    summable_squarefreeMobiusProbability_sq_mul_fisherCoordinate_twice_sq
    {sigma : ℝ} (hsigma : 1 < sigma) :
    Summable (fun n : ℕ =>
      squarefreeMobiusProbability sigma n ^ 2 *
        (2 * mobiusCriticalFisherCoordinate sigma n - 2 * 0) ^ 2) := by
  have hpa2 : Summable (fun n : ℕ =>
      squarefreeMobiusProbability sigma n *
        mobiusCriticalFisherCoordinate sigma n ^ 2) := by
    apply (summable_squarefreeMobiusCriticalFisherWeights hsigma).congr
    intro n
    unfold mobiusCriticalFisherCoordinate
    ring
  have hmajor := hpa2.mul_left 4
  refine Summable.of_nonneg_of_le (fun n => by positivity) ?_ hmajor
  intro n
  have hp0 := squarefreeMobiusProbability_nonneg hsigma n
  have hp1 := squarefreeMobiusProbability_le_one hsigma n
  have hp2 : squarefreeMobiusProbability sigma n ^ 2 ≤
      squarefreeMobiusProbability sigma n := by
    nlinarith
  calc
    squarefreeMobiusProbability sigma n ^ 2 *
          (2 * mobiusCriticalFisherCoordinate sigma n - 2 * 0) ^ 2 =
        (4 * squarefreeMobiusProbability sigma n ^ 2) *
          mobiusCriticalFisherCoordinate sigma n ^ 2 := by ring
    _ ≤ (4 * squarefreeMobiusProbability sigma n) *
          mobiusCriticalFisherCoordinate sigma n ^ 2 := by
      exact mul_le_mul_of_nonneg_right (by nlinarith)
        (sq_nonneg _)
    _ = 4 *
        (squarefreeMobiusProbability sigma n *
          mobiusCriticalFisherCoordinate sigma n ^ 2) := by ring

/-- **Actual Möbius graph-scale clock-split law.**  At every safe Euler
parameter and damping aperture, cubic physical replicas remove the exact
atomic Fisher collision after one Gamma normal division, while their added
holonomy energy vanishes after squared normal division.  Both limits use the
same literal squarefree probability, centered Fisher coordinate, damping
coordinate, and critical logarithmic clock. -/
theorem tendsto_squarefreeMobiusCubicClockSplitGraphNormalizedErrorAndEnergy
    {sigma u : ℝ} (hsigma : 1 < sigma) (hu : 0 ≤ u) :
    Tendsto
      (fun n : ℕ =>
        ((physicalSplitSameAtomCodiagonalOn
              (cubicClockSplitReplicaCount n)
              (cubicClockSplitOffset n)
              (squarefreeMobiusProbability sigma)
              (mobiusCriticalFisherCoordinate sigma)
              (mobiusCriticalDampingCoordinate sigma u)
              (squarefreeMobiusCriticalClock sigma) -
            2 * ∑' i,
              squarefreeMobiusProbability sigma i ^ 2 *
                mobiusCriticalFisherCoordinate sigma i *
