import GaloisForLFunctions.RHTower.MobiusCriticalFisherOneCornerCodiagonalContraction
import GaloisForLFunctions.RHTower.MobiusClockSplitReplicaOneCorner
import GaloisForLFunctions.HTGeometry.FisherOneCornerCommonHardyReporter
import Mathlib.MeasureTheory.Integral.DominatedConvergence

/-!
# Countable squarefree-Mobius one-corner common Hardy reporter

The actual finite-Euler squarefree source is assembled into one literal
`L²((0,∞), du)` reporter for every contraction of the completed source
Hilbert space.  Countable tail integrability is obtained from discrete first
and third logarithmic moments, rather than a finite truncation or a nodewise
choice.

The global reporter budget simplifies exactly to

`(σ - 1)^3 (M₃(σ) - M₁(σ) M₂(σ))`,

and tends to four at the critical Euler boundary.  Thus countable completion
does not lose the sharp one-corner four-unit budget.
-/

open Complex Filter MeasureTheory Set
open scoped BigOperators InnerProductSpace Topology

noncomputable section

namespace RHTower

open ContinuousLinearMap InnerProductSpace
open GaloisForLFunctions.HTGeometry

/-- Positive half-line tail generated by discrete weights and heights. -/
def positiveDiscreteTail (w h : ℕ → ℝ) (u : ℝ) : ℝ :=
  ∑' n : ℕ, if 0 < u ∧ u < h n then w n else 0

private theorem integrable_positiveTailTerm (c b : ℝ) :
    Integrable (fun u : ℝ => if 0 < u ∧ u < b then c else 0) := by
  rw [show (fun u : ℝ => if 0 < u ∧ u < b then c else 0) =
      (Ioo 0 b).indicator (fun _ => c) by
    funext u
    simp [Set.indicator, mem_Ioo]]
  exact (integrableOn_const (by simp [Real.volume_Ioo]) :
    IntegrableOn (fun _ : ℝ => c) (Ioo 0 b)).integrable_indicator
      measurableSet_Ioo

private theorem integral_positiveTailTerm {c b : ℝ}
    (_hc : 0 ≤ c) (hb : 0 ≤ b) :
    (∫ u : ℝ, if 0 < u ∧ u < b then c else 0) = c * b := by
  rw [show (fun u : ℝ => if 0 < u ∧ u < b then c else 0) =
      (Ioo 0 b).indicator (fun _ => c) by
    funext u
    simp [Set.indicator, mem_Ioo]]
  rw [integral_indicator measurableSet_Ioo, setIntegral_const]
  unfold Measure.real
  rw [Real.volume_Ioo, ENNReal.toReal_ofReal]
  · ring
  · linarith

/-- A positive countable tail is integrable when weights and
weight-times-height are summable. -/
theorem positiveDiscreteTail_integrable
    (w h : ℕ → ℝ) (hw : ∀ n, 0 ≤ w n) (hh : ∀ n, 0 ≤ h n)
    (hws : Summable w) (hwh : Summable (fun n => w n * h n)) :
    Integrable (positiveDiscreteTail w h) := by
  let F : ℕ → ℝ → ℝ := fun n u => if 0 < u ∧ u < h n then w n else 0
  have hFint (n : ℕ) : Integrable (F n) := integrable_positiveTailTerm _ _
  have hFmeas (n : ℕ) : AEStronglyMeasurable (F n) :=
    (hFint n).aestronglyMeasurable
  have htotalMeas : AEStronglyMeasurable (positiveDiscreteTail w h) := by
    exact AEStronglyMeasurable.tsum hFmeas
  refine ⟨htotalMeas, ?_⟩
  rw [hasFiniteIntegral_iff_norm]
  have hpoint (u : ℝ) :
      ENNReal.ofReal ‖positiveDiscreteTail w h u‖ =
        ∑' n : ℕ, ENNReal.ofReal (F n u) := by
    change ENNReal.ofReal ‖∑' n : ℕ, F n u‖ =
      ∑' n : ℕ, ENNReal.ofReal (F n u)
    have hFnonneg (n : ℕ) : 0 ≤ F n u := by
      dsimp [F]
      split_ifs
      · exact hw n
      · exact le_rfl
    have hFs : Summable (fun n => F n u) := by
      apply hws.of_nonneg_of_le hFnonneg
      intro n
      dsimp [F]
      split_ifs
      · exact le_rfl
      · exact hw n
    rw [Real.norm_eq_abs, abs_of_nonneg (tsum_nonneg hFnonneg)]
    exact ENNReal.ofReal_tsum_of_nonneg hFnonneg hFs
  rw [show (fun u : ℝ => ENNReal.ofReal ‖positiveDiscreteTail w h u‖) =
      fun u => ∑' n : ℕ, ENNReal.ofReal (F n u) by
    funext u
    exact hpoint u]
  rw [lintegral_tsum]
  · rw [show (fun n : ℕ => ∫⁻ u : ℝ, ENNReal.ofReal (F n u)) =
        fun n => ENNReal.ofReal (w n * h n) by
      funext n
      rw [← ofReal_integral_eq_lintegral_ofReal (hFint n)
        (Filter.Eventually.of_forall fun u => by
          dsimp [F]
          split_ifs
          · exact hw n
          · exact le_rfl)]
      exact congrArg ENNReal.ofReal
        (integral_positiveTailTerm (hw n) (hh n))]
    exact hwh.tsum_ofReal_lt_top
  · intro n
    exact (hFmeas n).aemeasurable.ennreal_ofReal

/-- Exact layer-cake integral of a positive countable tail. -/
theorem integral_positiveDiscreteTail
    (w h : ℕ → ℝ) (hw : ∀ n, 0 ≤ w n) (hh : ∀ n, 0 ≤ h n)
    (hwh : Summable (fun n => w n * h n)) :
    (∫ u : ℝ, positiveDiscreteTail w h u) = ∑' n, w n * h n := by
  let F : ℕ → ℝ → ℝ := fun n u => if 0 < u ∧ u < h n then w n else 0
  have hFint (n : ℕ) : Integrable (F n) := integrable_positiveTailTerm _ _
  have hFnorm (n : ℕ) :
      (∫ u : ℝ, ‖F n u‖) = w n * h n := by
    rw [show (fun u : ℝ => ‖F n u‖) =
        fun u => if 0 < u ∧ u < h n then w n else 0 by
      funext u
      by_cases hu : 0 < u ∧ u < h n
      · simp [F, hu, Real.norm_eq_abs, abs_of_nonneg (hw n)]
      · simp [F, hu]]
    exact integral_positiveTailTerm (hw n) (hh n)
  have hsum : Summable (fun n => ∫ u : ℝ, ‖F n u‖) := by
    simpa only [hFnorm] using hwh
  rw [show positiveDiscreteTail w h = fun u => ∑' n, F n u by rfl]
  rw [← integral_tsum_of_summable_integral_norm hFint hsum]
  apply tsum_congr
  intro n
  exact integral_positiveTailTerm (hw n) (hh n)

private theorem positiveDiscreteTail_nonneg
    (w h : ℕ → ℝ) (hw : ∀ n, 0 ≤ w n) (u : ℝ) :
    0 ≤ positiveDiscreteTail w h u := by
  unfold positiveDiscreteTail
  apply tsum_nonneg
  intro n
  split_ifs
  · exact hw n
  · exact le_rfl

/-- Escaped probability mass of the actual critical squarefree clock. -/
def squarefreeMobiusCriticalClockTailMass (sigma u : ℝ) : ℝ :=
  positiveDiscreteTail (squarefreeMobiusProbability sigma)
    (squarefreeMobiusCriticalClock sigma) u

/-- Escaped Fisher energy of the actual critical squarefree clock. -/
def squarefreeMobiusCriticalFisherTailEnergy (sigma u : ℝ) : ℝ :=
  positiveDiscreteTail
    (fun n => 4 * (sigma - 1) ^ 2 * squarefreeMobiusProbability sigma n *
      (Real.log n - squarefreeMobiusLogMoment 1 sigma) ^ 2)
    (squarefreeMobiusCriticalClock sigma) u

private theorem summable_squarefreeMobiusCriticalFisherWeights
    {sigma : ℝ} (hsigma : 1 < sigma) :
    Summable (fun n : ℕ =>
      4 * (sigma - 1) ^ 2 * squarefreeMobiusProbability sigma n *
        (Real.log n - squarefreeMobiusLogMoment 1 sigma) ^ 2) := by
  let m := squarefreeMobiusLogMoment 1 sigma
  have h2 := (summable_squarefreeMobiusLogMoment 2 hsigma).mul_left
    (4 * (sigma - 1) ^ 2)
  have h1 := (summable_squarefreeMobiusLogMoment 1 hsigma).mul_left
    (-8 * (sigma - 1) ^ 2 * m)
  have h0 := (summable_squarefreeMobiusProbability hsigma).mul_left
    (4 * (sigma - 1) ^ 2 * m ^ 2)
  apply ((h2.add h1).add h0).congr
  intro n
  dsimp [m]
  ring

private theorem summable_squarefreeMobiusCriticalFisherWeights_mul_clock
    {sigma : ℝ} (hsigma : 1 < sigma) :
    Summable (fun n : ℕ =>
      (4 * (sigma - 1) ^ 2 * squarefreeMobiusProbability sigma n *
        (Real.log n - squarefreeMobiusLogMoment 1 sigma) ^ 2) *
          squarefreeMobiusCriticalClock sigma n) := by
  let m := squarefreeMobiusLogMoment 1 sigma
  have h3 := (summable_squarefreeMobiusLogMoment 3 hsigma).mul_left
    (4 * (sigma - 1) ^ 3)
  have h2 := (summable_squarefreeMobiusLogMoment 2 hsigma).mul_left
    (-8 * (sigma - 1) ^ 3 * m)
  have h1 := (summable_squarefreeMobiusLogMoment 1 hsigma).mul_left
    (4 * (sigma - 1) ^ 3 * m ^ 2)
  apply ((h3.add h2).add h1).congr
  intro n
  dsimp [m]
  unfold squarefreeMobiusCriticalClock
  ring

theorem integrable_squarefreeMobiusCriticalClockTailMass
    {sigma : ℝ} (hsigma : 1 < sigma) :
    Integrable (squarefreeMobiusCriticalClockTailMass sigma) := by
  apply positiveDiscreteTail_integrable
  · exact squarefreeMobiusProbability_nonneg hsigma
  · intro n
    unfold squarefreeMobiusCriticalClock
    exact mul_nonneg (sub_nonneg.mpr hsigma.le)
      (Real.log_natCast_nonneg n)
  · exact summable_squarefreeMobiusProbability hsigma
  · have h := (summable_squarefreeMobiusLogMoment 1 hsigma).mul_left
        (sigma - 1)
    apply h.congr
    intro n
    unfold squarefreeMobiusCriticalClock
    simp only [pow_one]
    ring

theorem integrable_squarefreeMobiusCriticalFisherTailEnergy
    {sigma : ℝ} (hsigma : 1 < sigma) :
    Integrable (squarefreeMobiusCriticalFisherTailEnergy sigma) := by
  apply positiveDiscreteTail_integrable
  · intro n
    exact mul_nonneg
      (mul_nonneg (mul_nonneg (by positivity) (sq_nonneg _))
        (squarefreeMobiusProbability_nonneg hsigma n))
      (sq_nonneg _)
  · intro n
    unfold squarefreeMobiusCriticalClock
    exact mul_nonneg (sub_nonneg.mpr hsigma.le)
      (Real.log_natCast_nonneg n)
  · exact summable_squarefreeMobiusCriticalFisherWeights hsigma
  · exact summable_squarefreeMobiusCriticalFisherWeights_mul_clock hsigma

private theorem tsum_squarefreeMobiusCriticalFisherWeights_eq
    {sigma : ℝ} (hsigma : 1 < sigma) :
    (∑' n : ℕ,
      4 * (sigma - 1) ^ 2 * squarefreeMobiusProbability sigma n *
        (Real.log n - squarefreeMobiusLogMoment 1 sigma) ^ 2) =
      squarefreeMobiusCriticalProjectiveFisherEnergy sigma := by
  rw [← norm_infiniteMobiusCriticalFisherTangentLp_sq hsigma,
    HilbertSchmidt.lp_norm_sq_eq]
  apply tsum_congr
  intro n
  exact (norm_infiniteMobiusCriticalFisherTangentWeight_sq hsigma n).symm

/-- Escaped clock mass is exactly the complement of hard-cut source mass. -/
theorem one_sub_squarefreeMobiusCriticalClockCutMass_eq_tail
    {sigma u : ℝ} (hsigma : 1 < sigma) (hu : 0 < u) :
    1 - squarefreeMobiusCriticalClockCutMass sigma u =
      squarefreeMobiusCriticalClockTailMass sigma u := by
  rw [← tsum_squarefreeMobiusProbability hsigma]
  unfold squarefreeMobiusCriticalClockCutMass
    squarefreeMobiusCriticalClockTailMass positiveDiscreteTail
  rw [← Summable.tsum_sub (summable_squarefreeMobiusProbability hsigma)
    ((summable_squarefreeMobiusProbability hsigma).indicator
      (squarefreeMobiusCriticalClockCut sigma u))]
  apply tsum_congr
  intro n
  by_cases hn : squarefreeMobiusCriticalClock sigma n ≤ u
  · simp [squarefreeMobiusCriticalClockCut, hn, hu, not_lt.mpr hn]
  · have hlt : u < squarefreeMobiusCriticalClock sigma n := lt_of_not_ge hn
    simp [squarefreeMobiusCriticalClockCut, hn, hu, hlt]

/-- Escaped Fisher energy is exactly the complement of hard-cut tangent
energy. -/
theorem squarefreeMobiusCriticalProjectiveFisherEnergy_sub_cutEnergy_eq_tail
    {sigma u : ℝ} (hsigma : 1 < sigma) (hu : 0 < u) :
    squarefreeMobiusCriticalProjectiveFisherEnergy sigma -
        squarefreeMobiusCriticalFisherCutEnergy sigma u =
      squarefreeMobiusCriticalFisherTailEnergy sigma u := by
  rw [← tsum_squarefreeMobiusCriticalFisherWeights_eq hsigma]
  unfold squarefreeMobiusCriticalFisherCutEnergy
    squarefreeMobiusCriticalFisherTailEnergy positiveDiscreteTail
  rw [← Summable.tsum_sub
    (summable_squarefreeMobiusCriticalFisherWeights hsigma)
    ((summable_squarefreeMobiusCriticalFisherWeights hsigma).indicator
      (squarefreeMobiusCriticalClockCut sigma u))]
  apply tsum_congr
  intro n
  by_cases hn : squarefreeMobiusCriticalClock sigma n ≤ u
  · simp [squarefreeMobiusCriticalClockCut, hn, hu, not_lt.mpr hn]
  · have hlt : u < squarefreeMobiusCriticalClock sigma n := lt_of_not_ge hn
    simp [squarefreeMobiusCriticalClockCut, hn, hu, hlt]

/-- Actual finite-Euler lower-corner energy is controlled by escaped Fisher
energy plus total Fisher energy times escaped source mass. -/
theorem two_mul_squarefreeMobiusCriticalFisherLowerBoundaryEnergy_le_tails
    {sigma u : ℝ} (hsigma : 1 < sigma) (hu : 0 < u) :
    2 * squarefreeMobiusCriticalFisherLowerBoundaryEnergy sigma u ≤
      squarefreeMobiusCriticalFisherTailEnergy sigma u +
        squarefreeMobiusCriticalProjectiveFisherEnergy sigma *
          squarefreeMobiusCriticalClockTailMass sigma u := by
  let E := squarefreeMobiusCriticalProjectiveFisherEnergy sigma
  let C := squarefreeMobiusCriticalFisherCutEnergy sigma u
  let M := squarefreeMobiusCriticalClockCutMass sigma u
  let O := squarefreeMobiusCriticalFisherCutOverlap sigma u
  let A := squarefreeMobiusCriticalFisherTailEnergy sigma u
  let T := squarefreeMobiusCriticalClockTailMass sigma u
  have hA : 0 ≤ A := by
    dsimp [A, squarefreeMobiusCriticalFisherTailEnergy]
    apply positiveDiscreteTail_nonneg
    intro n
    exact mul_nonneg
      (mul_nonneg (mul_nonneg (by positivity) (sq_nonneg _))
        (squarefreeMobiusProbability_nonneg hsigma n))
      (sq_nonneg _)
  have hT : 0 ≤ T := by
    dsimp [T, squarefreeMobiusCriticalClockTailMass]
    exact positiveDiscreteTail_nonneg _ _
      (squarefreeMobiusProbability_nonneg hsigma) u
  have hC : 0 ≤ C := by
    dsimp [C]
    exact squarefreeMobiusCriticalFisherCutEnergy_nonneg hsigma
  have hM : 0 ≤ M := by
    dsimp [M]
    rw [← norm_squarefreeMobiusCriticalClockCutoff_signed_sq hsigma]
    positivity
  have hEA : E - C = A := by
    dsimp [E, C, A]
    exact
      squarefreeMobiusCriticalProjectiveFisherEnergy_sub_cutEnergy_eq_tail
        hsigma hu
  have hMT : 1 - M = T := by
    dsimp [M, T]
    exact one_sub_squarefreeMobiusCriticalClockCutMass_eq_tail hsigma hu
  rw [← squarefreeMobiusCriticalFisherCutoffCommutatorEnergy_eq_two_mul_lower
    hsigma]
  rw [squarefreeMobiusCriticalFisherCutoffCommutatorEnergy_eq hsigma]
  dsimp [E, C, M, O, A, T] at *
  nlinarith [sq_nonneg O]

/-- Cutoff inner product used to expose measurability of the countable
reporter without an operator-valued measurability assumption. -/
def squarefreeMobiusCriticalClockCutInner (sigma : ℝ)
    (x y : lp (fun _ : ℕ => ℂ) 2) (u : ℝ) : ℂ :=
  inner ℂ
    (squarefreeMobiusCriticalClockCutoff sigma u x)
    (squarefreeMobiusCriticalClockCutoff sigma u y)

theorem measurable_squarefreeMobiusCriticalClockCutInner (sigma : ℝ)
    (x y : lp (fun _ : ℕ => ℂ) 2) :
    Measurable (squarefreeMobiusCriticalClockCutInner sigma x y) := by
  unfold squarefreeMobiusCriticalClockCutInner
  simp_rw [lp.inner_eq_tsum, squarefreeMobiusCriticalClockCutoff_apply]
  apply Measurable.tsum
  intro n
  rw [show (fun u : ℝ => inner ℂ
      ((squarefreeMobiusCriticalClockCut sigma u).indicator
        (fun j => (x j : ℂ)) n)
      ((squarefreeMobiusCriticalClockCut sigma u).indicator
        (fun j => (y j : ℂ)) n)) =
      fun u : ℝ => if squarefreeMobiusCriticalClock sigma n ≤ u then
        inner ℂ (x n : ℂ) (y n : ℂ) else 0 by
    funext u
    by_cases hn : squarefreeMobiusCriticalClock sigma n ≤ u
    · simp [squarefreeMobiusCriticalClockCut, Set.indicator, hn]
    · simp [squarefreeMobiusCriticalClockCut, Set.indicator, hn]]
  exact Measurable.ite
    (measurableSet_le measurable_const measurable_id)
    measurable_const measurable_const

private theorem measurable_squarefreeMobiusCriticalClockCutSum
    (sigma : ℝ) (a : ℕ → ℝ) :
    Measurable (fun u : ℝ =>
      ∑' n : ℕ,
        (squarefreeMobiusCriticalClockCut sigma u).indicator a n) := by
  apply Measurable.tsum
  intro n
  rw [show (fun u : ℝ =>
      (squarefreeMobiusCriticalClockCut sigma u).indicator a n) =
      fun u : ℝ =>
        if squarefreeMobiusCriticalClock sigma n ≤ u then a n else 0 by
    funext u
    by_cases hn : squarefreeMobiusCriticalClock sigma n ≤ u <;>
      simp [squarefreeMobiusCriticalClockCut, Set.indicator, hn]]
  exact Measurable.ite
    (measurableSet_le measurable_const measurable_id)
    measurable_const measurable_const

/-- The actual finite-Euler one-corner energy is a measurable function of
the physical clock aperture. -/
theorem measurable_squarefreeMobiusCriticalFisherLowerBoundaryEnergy
    (sigma : ℝ) (hsigma : 1 < sigma) :
    Measurable
      (squarefreeMobiusCriticalFisherLowerBoundaryEnergy sigma) := by
  have hM : Measurable
      (squarefreeMobiusCriticalClockCutMass sigma) := by
    unfold squarefreeMobiusCriticalClockCutMass
    exact measurable_squarefreeMobiusCriticalClockCutSum sigma _
  have hC : Measurable
      (squarefreeMobiusCriticalFisherCutEnergy sigma) := by
    unfold squarefreeMobiusCriticalFisherCutEnergy
    exact measurable_squarefreeMobiusCriticalClockCutSum sigma _
  have hO : Measurable
      (squarefreeMobiusCriticalFisherCutOverlap sigma) := by
    unfold squarefreeMobiusCriticalFisherCutOverlap
    exact measurable_squarefreeMobiusCriticalClockCutSum sigma _
  rw [show squarefreeMobiusCriticalFisherLowerBoundaryEnergy sigma =
      fun u : ℝ => (1 / 2 : ℝ) *
        ((squarefreeMobiusCriticalProjectiveFisherEnergy sigma -
              squarefreeMobiusCriticalFisherCutEnergy sigma u) *
            squarefreeMobiusCriticalClockCutMass sigma u +
          (1 - squarefreeMobiusCriticalClockCutMass sigma u) *
            squarefreeMobiusCriticalFisherCutEnergy sigma u -
          2 * squarefreeMobiusCriticalFisherCutOverlap sigma u ^ 2) by
    funext u
    calc
      squarefreeMobiusCriticalFisherLowerBoundaryEnergy sigma u =
          (1 / 2 : ℝ) *
            squarefreeMobiusCriticalFisherCutoffCommutatorEnergy sigma u := by
        rw [squarefreeMobiusCriticalFisherCutoffCommutatorEnergy_eq_two_mul_lower
          hsigma]
        ring
      _ = _ := by
        rw [squarefreeMobiusCriticalFisherCutoffCommutatorEnergy_eq hsigma]]
  exact measurable_const.mul
    ((((measurable_const.sub hC).mul hM).add
      ((measurable_const.sub hM).mul hC)).sub
        (measurable_const.mul (hO.pow_const 2)))

theorem squarefreeMobiusCriticalFisherLowerBoundaryEnergy_nonneg
    {sigma u : ℝ} (hsigma : 1 < sigma) :
    0 ≤ squarefreeMobiusCriticalFisherLowerBoundaryEnergy sigma u := by
  rw [squarefreeMobiusCriticalFisherLowerBoundaryEnergy, dif_pos hsigma]
  exact hsNormSq_nonneg _

/-- The actual lower-corner energy is integrable on the complete positive
clock ray.  This is finite-`sigma` source integrability, not a limiting
profile substitution. -/
theorem integrable_squarefreeMobiusCriticalFisherLowerBoundaryEnergy
    {sigma : ℝ} (hsigma : 1 < sigma) :
    Integrable (squarefreeMobiusCriticalFisherLowerBoundaryEnergy sigma)
      halfLineLaplaceMeasure := by
  have htailF : Integrable
      (squarefreeMobiusCriticalFisherTailEnergy sigma)
      halfLineLaplaceMeasure :=
    (integrable_squarefreeMobiusCriticalFisherTailEnergy hsigma).mono_measure
      Measure.restrict_le_self
  have htailM : Integrable
      (squarefreeMobiusCriticalClockTailMass sigma)
      halfLineLaplaceMeasure :=
    (integrable_squarefreeMobiusCriticalClockTailMass hsigma).mono_measure
      Measure.restrict_le_self
  let major := fun u : ℝ => (1 / 2 : ℝ) *
    (squarefreeMobiusCriticalFisherTailEnergy sigma u +
      squarefreeMobiusCriticalProjectiveFisherEnergy sigma *
        squarefreeMobiusCriticalClockTailMass sigma u)
  have hmajor : Integrable major halfLineLaplaceMeasure :=
    (htailF.add (htailM.const_mul
      (squarefreeMobiusCriticalProjectiveFisherEnergy sigma))).const_mul
        (1 / 2 : ℝ)
  refine Integrable.mono' hmajor
    (measurable_squarefreeMobiusCriticalFisherLowerBoundaryEnergy sigma hsigma
      |>.aestronglyMeasurable) ?_
  filter_upwards [ae_restrict_mem measurableSet_Ioi] with u hu
  rw [Real.norm_eq_abs,
    abs_of_nonneg
      (squarefreeMobiusCriticalFisherLowerBoundaryEnergy_nonneg hsigma)]
  have htail :=
    two_mul_squarefreeMobiusCriticalFisherLowerBoundaryEnergy_le_tails
      hsigma hu
  dsimp only [major]
  nlinarith

private def squarefreeMobiusCriticalClockComplementInner (sigma : ℝ)
    (x y : lp (fun _ : ℕ => ℂ) 2) (u : ℝ) : ℂ :=
  inner ℂ
    ((1 - squarefreeMobiusCriticalClockCutoff sigma u) x)
    ((1 - squarefreeMobiusCriticalClockCutoff sigma u) y)

private theorem squarefreeMobiusCriticalClockComplementInner_eq
    (sigma : ℝ) (x y : lp (fun _ : ℕ => ℂ) 2) (u : ℝ) :
    squarefreeMobiusCriticalClockComplementInner sigma x y u =
      inner ℂ x y - squarefreeMobiusCriticalClockCutInner sigma x y u := by
  let e := squarefreeMobiusCriticalClockCutoff sigma u
  have he : IsIdempotentElem e :=
    squarefreeMobiusCriticalClockCutoff_idempotent sigma u
  have heAdj : adjoint e = e :=
    squarefreeMobiusCriticalClockCutoff_selfAdjoint sigma u
  have hxy : inner ℂ (e x) y = inner ℂ x (e y) := by
    simpa only [heAdj] using adjoint_inner_left e y x
  have he_apply : e (e y) = e y := by
    have h := congrArg (fun f : lp (fun _ : ℕ => ℂ) 2 →L[ℂ]
      lp (fun _ : ℕ => ℂ) 2 => f y) he
    simpa only [mul_apply] using! h
  have hproj : inner ℂ (e x) (e y) = inner ℂ x (e y) := by
    simpa only [heAdj, he_apply] using adjoint_inner_left e (e y) x
  simp only [squarefreeMobiusCriticalClockComplementInner,
    squarefreeMobiusCriticalClockCutInner, sub_apply, one_apply_eq_self,
    inner_sub_left, inner_sub_right]
  rw [hxy, hproj]
  ring

private theorem measurable_squarefreeMobiusCriticalClockComplementInner
    (sigma : ℝ) (x y : lp (fun _ : ℕ => ℂ) 2) :
    Measurable (squarefreeMobiusCriticalClockComplementInner sigma x y) := by
  rw [show squarefreeMobiusCriticalClockComplementInner sigma x y =
      fun u => inner ℂ x y -
        squarefreeMobiusCriticalClockCutInner sigma x y u by
    funext u
    exact squarefreeMobiusCriticalClockComplementInner_eq sigma x y u]
  exact measurable_const.sub
    (measurable_squarefreeMobiusCriticalClockCutInner sigma x y)

private theorem summable_complementInner_mul_cutInner
    (S : Set ℕ) [DecidablePred (· ∈ S)]
    (x y z t : lp (fun _ : ℕ => ℂ) 2) :
    Summable (fun p : ℕ × ℕ =>
      if p.1 ∈ S ∧ p.2 ∉ S then
        inner ℂ (x p.2 : ℂ) (y p.2 : ℂ) *
          inner ℂ (z p.1 : ℂ) (t p.1 : ℂ)
      else 0) := by
  classical
  let a : ℕ → ℂ := S.indicator
    (fun i => inner ℂ (z i : ℂ) (t i : ℂ))
  let b : ℕ → ℂ := Sᶜ.indicator
    (fun j => inner ℂ (x j : ℂ) (y j : ℂ))
  have hzt : Summable (fun i : ℕ =>
      inner ℂ (z i : ℂ) (t i : ℂ)) := lp.summable_inner z t
  have hxy : Summable (fun j : ℕ =>
      inner ℂ (x j : ℂ) (y j : ℂ)) := lp.summable_inner x y
  have ha : Summable a := hzt.indicator S
  have hb : Summable b := hxy.indicator Sᶜ
  have hab : Summable (fun p : ℕ × ℕ => a p.1 * b p.2) :=
    summable_mul_of_summable_norm ha.norm hb.norm
  apply hab.congr
  intro p
  by_cases hi : p.1 ∈ S <;> by_cases hj : p.2 ∈ S <;>
    simp [a, b, hi, hj, mul_comm]

private theorem complementInner_mul_cutInner_eq_tsum
    (S : Set ℕ) [DecidablePred (· ∈ S)]
    (x y z t : lp (fun _ : ℕ => ℂ) 2) :
    inner ℂ ((1 - lpCoordinateProjection S) x)
        ((1 - lpCoordinateProjection S) y) *
      inner ℂ (lpCoordinateProjection S z) (lpCoordinateProjection S t) =
    ∑' p : ℕ × ℕ,
      if p.1 ∈ S ∧ p.2 ∉ S then
        inner ℂ (x p.2 : ℂ) (y p.2 : ℂ) *
          inner ℂ (z p.1 : ℂ) (t p.1 : ℂ)
      else 0 := by
  classical
  let a : ℕ → ℂ := S.indicator
    (fun i => inner ℂ (z i : ℂ) (t i : ℂ))
  let b : ℕ → ℂ := Sᶜ.indicator
    (fun j => inner ℂ (x j : ℂ) (y j : ℂ))
  have hzt : Summable (fun i : ℕ =>
      inner ℂ (z i : ℂ) (t i : ℂ)) := lp.summable_inner z t
  have hxy : Summable (fun j : ℕ =>
      inner ℂ (x j : ℂ) (y j : ℂ)) := lp.summable_inner x y
  have ha : Summable a := hzt.indicator S
  have hb : Summable b := hxy.indicator Sᶜ
  have hab : Summable (fun p : ℕ × ℕ => a p.1 * b p.2) :=
    summable_mul_of_summable_norm ha.norm hb.norm
  have hcut : inner ℂ (lpCoordinateProjection S z)
      (lpCoordinateProjection S t) = ∑' i, a i := by
    rw [lp.inner_eq_tsum]
    apply tsum_congr
    intro i
    by_cases hi : i ∈ S
    · simp [a, lpCoordinateProjection_apply, hi]
    · simp [a, lpCoordinateProjection_apply, hi]
  have hcomp : inner ℂ ((1 - lpCoordinateProjection S) x)
      ((1 - lpCoordinateProjection S) y) = ∑' j, b j := by
    rw [lp.inner_eq_tsum]
    apply tsum_congr
    intro j
    by_cases hj : j ∈ S
    · simp [b, lpCoordinateProjection_apply, hj]
    · simp [b, lpCoordinateProjection_apply, hj]
  rw [hcomp, hcut, mul_comm]
  rw [ha.tsum_mul_tsum hb hab]
  apply tsum_congr
  intro p
  by_cases hi : p.1 ∈ S <;> by_cases hj : p.2 ∈ S <;>
    simp [a, b, hi, hj, mul_comm]

/-- Scalar countable one-corner field generated by a contraction of the
actual completed squarefree source. -/
def squarefreeMobiusCriticalFisherJoinedCodiagonal
    (sigma : ℝ) (hsigma : 1 < sigma)
    (D : lp (fun _ : ℕ => ℂ) 2 →L[ℂ] lp (fun _ : ℕ => ℂ) 2)
    (u : ℝ) : ℂ :=
  hsInner
    (squarefreeMobiusCriticalFisherLowerBoundary sigma u hsigma)
    (infiniteFisherOneCornerJoinedReporter
      (squarefreeMobiusCriticalClockCutoff sigma u) D
      (infiniteMobiusSignedWeightLp sigma hsigma))

/-- Ordered-pair coefficient of the literal countable one-corner source.
The first index lies in the hard lower window and the second in its
complement. -/
def squarefreeMobiusCriticalFisherJoinedPairCoefficient
    (sigma : ℝ) (hsigma : 1 < sigma)
    (D : lp (fun _ : ℕ => ℂ) 2 →L[ℂ] lp (fun _ : ℕ => ℂ) 2)
    (i j : ℕ) : ℂ :=
  let psi := infiniteMobiusSignedWeightLp sigma hsigma
  let chi := infiniteMobiusCriticalFisherTangentLp sigma hsigma
  let phi := D psi
  let alpha : ℂ := (Real.sqrt 2)⁻¹
  (starRingEnd ℂ) alpha * alpha *
    (inner ℂ (chi j : ℂ) (phi j : ℂ) *
        inner ℂ (psi i : ℂ) (psi i : ℂ) +
      inner ℂ (chi j : ℂ) (psi j : ℂ) *
        inner ℂ (phi i : ℂ) (psi i : ℂ) +
      inner ℂ (psi j : ℂ) (phi j : ℂ) *
        inner ℂ (psi i : ℂ) (chi i : ℂ) +
      inner ℂ (psi j : ℂ) (psi j : ℂ) *
        inner ℂ (phi i : ℂ) (chi i : ℂ))

/-- Absolute summability of the complete ordered-pair coefficient field. -/
theorem summable_norm_squarefreeMobiusCriticalFisherJoinedPairCoefficient
    (sigma : ℝ) (hsigma : 1 < sigma)
    (D : lp (fun _ : ℕ => ℂ) 2 →L[ℂ] lp (fun _ : ℕ => ℂ) 2) :
    Summable (fun p : ℕ × ℕ =>
      ‖squarefreeMobiusCriticalFisherJoinedPairCoefficient
        sigma hsigma D p.1 p.2‖) := by
  let psi := infiniteMobiusSignedWeightLp sigma hsigma
  let chi := infiniteMobiusCriticalFisherTangentLp sigma hsigma
  let phi := D psi
  let alpha : ℂ := (Real.sqrt 2)⁻¹
  have hpsiPsi : Summable (fun i : ℕ =>
      inner ℂ (psi i : ℂ) (psi i : ℂ)) := lp.summable_inner psi psi
  have hchiPhi : Summable (fun j : ℕ =>
      inner ℂ (chi j : ℂ) (phi j : ℂ)) := lp.summable_inner chi phi
  have hchiPsi : Summable (fun j : ℕ =>
      inner ℂ (chi j : ℂ) (psi j : ℂ)) := lp.summable_inner chi psi
  have hphiPsi : Summable (fun i : ℕ =>
      inner ℂ (phi i : ℂ) (psi i : ℂ)) := lp.summable_inner phi psi
  have hpsiPhi : Summable (fun j : ℕ =>
      inner ℂ (psi j : ℂ) (phi j : ℂ)) := lp.summable_inner psi phi
  have hpsiChi : Summable (fun i : ℕ =>
      inner ℂ (psi i : ℂ) (chi i : ℂ)) := lp.summable_inner psi chi
  have hphiChi : Summable (fun i : ℕ =>
      inner ℂ (phi i : ℂ) (chi i : ℂ)) := lp.summable_inner phi chi
  have hA : Summable (fun p : ℕ × ℕ =>
      inner ℂ (chi p.2 : ℂ) (phi p.2 : ℂ) *
        inner ℂ (psi p.1 : ℂ) (psi p.1 : ℂ)) := by
    have h := summable_mul_of_summable_norm hpsiPsi.norm hchiPhi.norm
    apply h.congr
    intro p
    ring
  have hB : Summable (fun p : ℕ × ℕ =>
      inner ℂ (chi p.2 : ℂ) (psi p.2 : ℂ) *
        inner ℂ (phi p.1 : ℂ) (psi p.1 : ℂ)) := by
    have h := summable_mul_of_summable_norm hphiPsi.norm hchiPsi.norm
    apply h.congr
    intro p
    ring
  have hC : Summable (fun p : ℕ × ℕ =>
      inner ℂ (psi p.2 : ℂ) (phi p.2 : ℂ) *
        inner ℂ (psi p.1 : ℂ) (chi p.1 : ℂ)) := by
    have h := summable_mul_of_summable_norm hpsiChi.norm hpsiPhi.norm
    apply h.congr
    intro p
    ring
  have hE : Summable (fun p : ℕ × ℕ =>
      inner ℂ (psi p.2 : ℂ) (psi p.2 : ℂ) *
        inner ℂ (phi p.1 : ℂ) (chi p.1 : ℂ)) := by
    have h := summable_mul_of_summable_norm hphiChi.norm hpsiPsi.norm
    apply h.congr
    intro p
    ring
  have hcoeff : Summable (fun p : ℕ × ℕ =>
      squarefreeMobiusCriticalFisherJoinedPairCoefficient
        sigma hsigma D p.1 p.2) := by
    have hsum := (((hA.add hB).add hC).add hE).mul_left
      ((starRingEnd ℂ) alpha * alpha)
    apply hsum.congr
    intro p
    simp only [squarefreeMobiusCriticalFisherJoinedPairCoefficient,
      psi, chi, phi, alpha]
  exact hcoeff.norm

private theorem squarefreeMobiusCriticalFisherJoinedCodiagonal_eq
    (sigma : ℝ) (hsigma : 1 < sigma)
    (D : lp (fun _ : ℕ => ℂ) 2 →L[ℂ] lp (fun _ : ℕ => ℂ) 2)
    (u : ℝ) :
    squarefreeMobiusCriticalFisherJoinedCodiagonal sigma hsigma D u =
      let psi := infiniteMobiusSignedWeightLp sigma hsigma
      let chi := infiniteMobiusCriticalFisherTangentLp sigma hsigma
      let phi := D psi
      let alpha : ℂ := (Real.sqrt 2)⁻¹
      (starRingEnd ℂ) alpha * alpha *
        (squarefreeMobiusCriticalClockComplementInner sigma chi phi u *
            squarefreeMobiusCriticalClockCutInner sigma psi psi u +
         squarefreeMobiusCriticalClockComplementInner sigma chi psi u *
            squarefreeMobiusCriticalClockCutInner sigma phi psi u +
         squarefreeMobiusCriticalClockComplementInner sigma psi phi u *
            squarefreeMobiusCriticalClockCutInner sigma psi chi u +
         squarefreeMobiusCriticalClockComplementInner sigma psi psi u *
            squarefreeMobiusCriticalClockCutInner sigma phi chi u) := by
  let psi := infiniteMobiusSignedWeightLp sigma hsigma
  let chi := infiniteMobiusCriticalFisherTangentLp sigma hsigma
  let phi := D psi
  let e := squarefreeMobiusCriticalClockCutoff sigma u
  let alpha : ℂ := (Real.sqrt 2)⁻¹
  let S1 := rankOne ℂ ((1 - e) chi) (e psi)
  let S2 := rankOne ℂ ((1 - e) psi) (e chi)
  let T1 := rankOne ℂ ((1 - e) phi) (e psi)
  let T2 := rankOne ℂ ((1 - e) psi) (e phi)
  have hS1 := isHilbertSchmidt_rankOne ((1 - e) chi) (e psi)
  have hS2 := isHilbertSchmidt_rankOne ((1 - e) psi) (e chi)
  have hT1 := isHilbertSchmidt_rankOne ((1 - e) phi) (e psi)
  have hT2 := isHilbertSchmidt_rankOne ((1 - e) psi) (e phi)
  rw [squarefreeMobiusCriticalFisherJoinedCodiagonal,
    squarefreeMobiusCriticalFisherLowerBoundary,
    infiniteFisherOneCornerJoinedReporter,
    pointedFisherConnection_lowerBoundary,
    pointedFisherConnection_lowerBoundary]
  change hsInner (alpha • (S1 + S2)) (alpha • (T1 + T2)) = _
  rw [hsInner_smul_left, hsInner_smul_right,
    hsInner_add_left hS1 hS2 (hT1.add hT2),
    hsInner_add_right hS1 hT1 hT2,
    hsInner_add_right hS2 hT1 hT2,
    hsInner_rankOne, hsInner_rankOne, hsInner_rankOne, hsInner_rankOne]
  simp only [squarefreeMobiusCriticalClockComplementInner,
    squarefreeMobiusCriticalClockCutInner]
  ring
  all_goals exact squarefreeMobiusCriticalClockCutoff_selfAdjoint sigma u

/-- Exact ordered-pair expansion of the actual countable source field.  One
series works for every cutoff aperture; no finite truncation is present. -/
theorem squarefreeMobiusCriticalFisherJoinedCodiagonal_eq_tsum
    (sigma : ℝ) (hsigma : 1 < sigma)
    (D : lp (fun _ : ℕ => ℂ) 2 →L[ℂ] lp (fun _ : ℕ => ℂ) 2)
    (u : ℝ) :
    squarefreeMobiusCriticalFisherJoinedCodiagonal sigma hsigma D u =
      ∑' p : ℕ × ℕ,
        if squarefreeMobiusCriticalClock sigma p.1 ≤ u ∧
            u < squarefreeMobiusCriticalClock sigma p.2 then
          squarefreeMobiusCriticalFisherJoinedPairCoefficient
            sigma hsigma D p.1 p.2
        else 0 := by
  classical
  let psi := infiniteMobiusSignedWeightLp sigma hsigma
  let chi := infiniteMobiusCriticalFisherTangentLp sigma hsigma
  let phi := D psi
  let alpha : ℂ := (Real.sqrt 2)⁻¹
  let S := squarefreeMobiusCriticalClockCut sigma u
  let A : ℕ × ℕ → ℂ := fun p =>
    if p.1 ∈ S ∧ p.2 ∉ S then
      inner ℂ (chi p.2 : ℂ) (phi p.2 : ℂ) *
        inner ℂ (psi p.1 : ℂ) (psi p.1 : ℂ)
    else 0
  let B : ℕ × ℕ → ℂ := fun p =>
    if p.1 ∈ S ∧ p.2 ∉ S then
      inner ℂ (chi p.2 : ℂ) (psi p.2 : ℂ) *
        inner ℂ (phi p.1 : ℂ) (psi p.1 : ℂ)
    else 0
  let C : ℕ × ℕ → ℂ := fun p =>
    if p.1 ∈ S ∧ p.2 ∉ S then
      inner ℂ (psi p.2 : ℂ) (phi p.2 : ℂ) *
        inner ℂ (psi p.1 : ℂ) (chi p.1 : ℂ)
    else 0
  let E : ℕ × ℕ → ℂ := fun p =>
    if p.1 ∈ S ∧ p.2 ∉ S then
      inner ℂ (psi p.2 : ℂ) (psi p.2 : ℂ) *
        inner ℂ (phi p.1 : ℂ) (chi p.1 : ℂ)
    else 0
  have hA : Summable A :=
    summable_complementInner_mul_cutInner S chi phi psi psi
  have hB : Summable B :=
    summable_complementInner_mul_cutInner S chi psi phi psi
  have hC : Summable C :=
    summable_complementInner_mul_cutInner S psi phi psi chi
  have hE : Summable E :=
    summable_complementInner_mul_cutInner S psi psi phi chi
  have hAeq :
      squarefreeMobiusCriticalClockComplementInner sigma chi phi u *
        squarefreeMobiusCriticalClockCutInner sigma psi psi u = ∑' p, A p := by
    simpa only [squarefreeMobiusCriticalClockComplementInner,
      squarefreeMobiusCriticalClockCutInner,
      squarefreeMobiusCriticalClockCutoff, S, A] using
        (complementInner_mul_cutInner_eq_tsum S chi phi psi psi)
  have hBeq :
      squarefreeMobiusCriticalClockComplementInner sigma chi psi u *
        squarefreeMobiusCriticalClockCutInner sigma phi psi u = ∑' p, B p := by
    simpa only [squarefreeMobiusCriticalClockComplementInner,
      squarefreeMobiusCriticalClockCutInner,
      squarefreeMobiusCriticalClockCutoff, S, B] using
        (complementInner_mul_cutInner_eq_tsum S chi psi phi psi)
  have hCeq :
      squarefreeMobiusCriticalClockComplementInner sigma psi phi u *
        squarefreeMobiusCriticalClockCutInner sigma psi chi u = ∑' p, C p := by
    simpa only [squarefreeMobiusCriticalClockComplementInner,
      squarefreeMobiusCriticalClockCutInner,
      squarefreeMobiusCriticalClockCutoff, S, C] using
        (complementInner_mul_cutInner_eq_tsum S psi phi psi chi)
  have hEeq :
      squarefreeMobiusCriticalClockComplementInner sigma psi psi u *
        squarefreeMobiusCriticalClockCutInner sigma phi chi u = ∑' p, E p := by
    simpa only [squarefreeMobiusCriticalClockComplementInner,
      squarefreeMobiusCriticalClockCutInner,
      squarefreeMobiusCriticalClockCutoff, S, E] using
        (complementInner_mul_cutInner_eq_tsum S psi psi phi chi)
  rw [squarefreeMobiusCriticalFisherJoinedCodiagonal_eq]
  dsimp only
  rw [hAeq, hBeq, hCeq, hEeq,
    ← Summable.tsum_add hA hB,
    ← Summable.tsum_add (hA.add hB) hC,
    ← Summable.tsum_add ((hA.add hB).add hC) hE,
    ← tsum_mul_left]
  apply tsum_congr
  intro p
  by_cases hi : squarefreeMobiusCriticalClock sigma p.1 ≤ u
  · by_cases hj : u < squarefreeMobiusCriticalClock sigma p.2
    · simp [A, B, C, E, S, squarefreeMobiusCriticalClockCut,
        squarefreeMobiusCriticalFisherJoinedPairCoefficient,
        psi, chi, phi, hi, hj]
    ·
      simp [A, B, C, E, S, squarefreeMobiusCriticalClockCut,
        hi, hj]
  · simp [A, B, C, E, S, squarefreeMobiusCriticalClockCut, hi]

private def countablePairLaplaceIntegrand
    (a b : ℝ) (k w : ℂ) (u : ℝ) : ℂ :=
  Complex.exp (-w * (u : ℂ)) *
    (if a ≤ u ∧ u < b then k else 0)

private theorem countablePairLaplaceIntegrand_integrable
    (a b : ℝ) (k w : ℂ) (hw : 0 < w.re) :
    Integrable (countablePairLaplaceIntegrand a b k w)
      halfLineLaplaceMeasure := by
  have hbase : Integrable
      (fun u : ℝ => ‖k‖ * Real.exp (-w.re * u))
      halfLineLaplaceMeasure := by
    change IntegrableOn
      (fun u : ℝ => ‖k‖ * Real.exp (-w.re * u)) (Ioi 0)
    exact (integrableOn_exp_mul_Ioi (a := -w.re) (by linarith) 0).const_mul ‖k‖
  have hmeas : AEStronglyMeasurable
      (countablePairLaplaceIntegrand a b k w)
      halfLineLaplaceMeasure := by
    have hcont : Continuous
        (fun u : ℝ => Complex.exp (-w * (u : ℂ)) * k) := by
      fun_prop
    rw [show countablePairLaplaceIntegrand a b k w =
        (Ico a b).indicator
          (fun u : ℝ => Complex.exp (-w * (u : ℂ)) * k) by
      funext u
      simp [countablePairLaplaceIntegrand, Set.indicator, mem_Ico]]
    exact (hcont.measurable.indicator measurableSet_Ico).aestronglyMeasurable
  refine Integrable.mono' hbase hmeas ?_
  filter_upwards [ae_restrict_mem measurableSet_Ioi] with u hu
  by_cases hab : a ≤ u ∧ u < b
  · simp [countablePairLaplaceIntegrand, hab, norm_exp, mul_comm]
  · simp [countablePairLaplaceIntegrand, hab]
    positivity

private theorem integral_norm_countablePairLaplaceIntegrand_le
    (a b : ℝ) (k w : ℂ) (hw : 0 < w.re) :
    (∫ u : ℝ, ‖countablePairLaplaceIntegrand a b k w u‖
        ∂halfLineLaplaceMeasure) ≤ ‖k‖ / w.re := by
  have hpair := countablePairLaplaceIntegrand_integrable a b k w hw
  have hbase : Integrable
      (fun u : ℝ => ‖k‖ * Real.exp (-w.re * u))
      halfLineLaplaceMeasure := by
    change IntegrableOn
      (fun u : ℝ => ‖k‖ * Real.exp (-w.re * u)) (Ioi 0)
    exact (integrableOn_exp_mul_Ioi (a := -w.re) (by linarith) 0).const_mul ‖k‖
  calc
    (∫ u : ℝ, ‖countablePairLaplaceIntegrand a b k w u‖
        ∂halfLineLaplaceMeasure) ≤
      ∫ u : ℝ, ‖k‖ * Real.exp (-w.re * u)
        ∂halfLineLaplaceMeasure := by
      apply integral_mono_ae hpair.norm hbase
      filter_upwards [ae_restrict_mem measurableSet_Ioi] with u hu
      by_cases hab : a ≤ u ∧ u < b
      · simp [countablePairLaplaceIntegrand, hab, norm_exp, mul_comm]
      · simp [countablePairLaplaceIntegrand, hab]
        positivity
    _ = ‖k‖ / w.re := by
      rw [halfLineLaplaceMeasure, integral_const_mul,
        integral_exp_mul_Ioi (a := -w.re) (by linarith) 0]
      simp only [mul_zero, Real.exp_zero, neg_div]
      field_simp [ne_of_gt hw]

private theorem integral_countablePairLaplaceIntegrand_eq_oriented
    {a b : ℝ} (ha : 0 ≤ a) (k w : ℂ) :
    (∫ u : ℝ, countablePairLaplaceIntegrand a b k w u
        ∂halfLineLaplaceMeasure) =
      orientedCutoffLaplaceCoefficient a b k w := by
  by_cases hab : a ≤ b
  · rw [orientedCutoffLaplaceCoefficient, if_pos hab,
      halfLineLaplaceMeasure]
    have hae : countablePairLaplaceIntegrand a b k w =ᵐ[volume]
        (Ioc a b).indicator
          (fun u : ℝ => Complex.exp (-w * (u : ℂ)) * k) := by
      filter_upwards [(Ico_ae_eq_Ioc (μ := volume) (a := a) (b := b))]
        with u hu
      simp only [countablePairLaplaceIntegrand]
      rw [show (if a ≤ u ∧ u < b then k else 0) =
          (Ico a b).indicator (fun _ => k) u by
        simp [Set.indicator, mem_Ico]]
      rw [show (Ioc a b).indicator
          (fun u : ℝ => Complex.exp (-w * (u : ℂ)) * k) u =
          Complex.exp (-w * (u : ℂ)) *
            (Ioc a b).indicator (fun _ => k) u by
        simp [Set.indicator]]
      by_cases hco : u ∈ Ico a b
      · have hoc : u ∈ Ioc a b := Eq.mp hu hco
        simp [indicator_of_mem hco, indicator_of_mem hoc]
      · have hoc : u ∉ Ioc a b := fun hoc => hco (Eq.mpr hu hoc)
        simp [indicator_of_notMem hco, indicator_of_notMem hoc]
    rw [integral_congr_ae (ae_restrict_of_ae hae)]
    rw [setIntegral_indicator measurableSet_Ioc]
    have hinter : Ioi 0 ∩ Ioc a b = Ioc a b := by
      ext u
      simp only [mem_inter_iff, mem_Ioi, mem_Ioc]
      constructor
      · exact fun hu => hu.2
      · exact fun hu => ⟨ha.trans_lt hu.1, hu⟩
    rw [hinter, intervalIntegral.integral_of_le hab]
  · rw [orientedCutoffLaplaceCoefficient, if_neg hab]
    have hnone : ∀ u : ℝ, ¬ (a ≤ u ∧ u < b) := by
      intro u hu
      exact hab (hu.1.trans hu.2.le)
    simp [countablePairLaplaceIntegrand, hnone]

theorem measurable_squarefreeMobiusCriticalFisherJoinedCodiagonal
    (sigma : ℝ) (hsigma : 1 < sigma)
    (D : lp (fun _ : ℕ => ℂ) 2 →L[ℂ] lp (fun _ : ℕ => ℂ) 2) :
    Measurable
      (squarefreeMobiusCriticalFisherJoinedCodiagonal sigma hsigma D) := by
  rw [show squarefreeMobiusCriticalFisherJoinedCodiagonal sigma hsigma D =
      fun u =>
        let psi := infiniteMobiusSignedWeightLp sigma hsigma
        let chi := infiniteMobiusCriticalFisherTangentLp sigma hsigma
        let phi := D psi
        let alpha : ℂ := (Real.sqrt 2)⁻¹
        (starRingEnd ℂ) alpha * alpha *
          (squarefreeMobiusCriticalClockComplementInner sigma chi phi u *
              squarefreeMobiusCriticalClockCutInner sigma psi psi u +
           squarefreeMobiusCriticalClockComplementInner sigma chi psi u *
              squarefreeMobiusCriticalClockCutInner sigma phi psi u +
           squarefreeMobiusCriticalClockComplementInner sigma psi phi u *
              squarefreeMobiusCriticalClockCutInner sigma psi chi u +
           squarefreeMobiusCriticalClockComplementInner sigma psi psi u *
              squarefreeMobiusCriticalClockCutInner sigma phi chi u) by
    funext u
    exact squarefreeMobiusCriticalFisherJoinedCodiagonal_eq sigma hsigma D u]
  let psi := infiniteMobiusSignedWeightLp sigma hsigma
  let chi := infiniteMobiusCriticalFisherTangentLp sigma hsigma
  let phi := D psi
  have ha :=
    (measurable_squarefreeMobiusCriticalClockComplementInner sigma chi phi).mul
      (measurable_squarefreeMobiusCriticalClockCutInner sigma psi psi)
  have hb :=
    (measurable_squarefreeMobiusCriticalClockComplementInner sigma chi psi).mul
      (measurable_squarefreeMobiusCriticalClockCutInner sigma phi psi)
  have hc :=
    (measurable_squarefreeMobiusCriticalClockComplementInner sigma psi phi).mul
      (measurable_squarefreeMobiusCriticalClockCutInner sigma psi chi)
  have hd :=
    (measurable_squarefreeMobiusCriticalClockComplementInner sigma psi psi).mul
      (measurable_squarefreeMobiusCriticalClockCutInner sigma phi chi)
  exact measurable_const.mul (((ha.add hb).add hc).add hd)

private theorem joinedCodiagonal_sq_le_tailMajorant
    {sigma u : ℝ} (hsigma : 1 < sigma)
    (D : lp (fun _ : ℕ => ℂ) 2 →L[ℂ] lp (fun _ : ℕ => ℂ) 2)
    (hD : ‖D‖ ≤ 1) (hu : 0 < u) :
    ‖squarefreeMobiusCriticalFisherJoinedCodiagonal sigma hsigma D u‖ ^ 2 ≤
      (1 / 4 : ℝ) *
        (squarefreeMobiusCriticalFisherTailEnergy sigma u +
          squarefreeMobiusCriticalProjectiveFisherEnergy sigma *
            squarefreeMobiusCriticalClockTailMass sigma u) := by
  have hpoint :=
    norm_sq_hsInner_squarefreeMobiusCriticalFisherLowerBoundary_joinedReporter_le_half
      hsigma D hD (u := u)
  have htail :=
    two_mul_squarefreeMobiusCriticalFisherLowerBoundaryEnergy_le_tails
      hsigma hu
  change
    ‖squarefreeMobiusCriticalFisherJoinedCodiagonal sigma hsigma D u‖ ^ 2 ≤
      (1 / 2 : ℝ) *
        squarefreeMobiusCriticalFisherLowerBoundaryEnergy sigma u at hpoint
  change
    ‖squarefreeMobiusCriticalFisherJoinedCodiagonal sigma hsigma D u‖ ^ 2 ≤ _
  norm_num at hpoint ⊢
  nlinarith

/-- The literal countable source codiagonal is square-integrable on the
complete positive cutoff ray. -/
theorem squarefreeMobiusCriticalFisherJoinedCodiagonal_memLp
    (sigma : ℝ) (hsigma : 1 < sigma)
    (D : lp (fun _ : ℕ => ℂ) 2 →L[ℂ] lp (fun _ : ℕ => ℂ) 2)
    (hD : ‖D‖ ≤ 1) :
    MemLp (squarefreeMobiusCriticalFisherJoinedCodiagonal sigma hsigma D) 2
      halfLineLaplaceMeasure := by
  let f := squarefreeMobiusCriticalFisherJoinedCodiagonal sigma hsigma D
  have hfmeas : AEStronglyMeasurable f halfLineLaplaceMeasure :=
    (measurable_squarefreeMobiusCriticalFisherJoinedCodiagonal sigma hsigma D)
      |>.aestronglyMeasurable
  apply (memLp_two_iff_integrable_sq_norm hfmeas).2
  have htailF : Integrable
      (squarefreeMobiusCriticalFisherTailEnergy sigma)
      halfLineLaplaceMeasure :=
    (integrable_squarefreeMobiusCriticalFisherTailEnergy hsigma).mono_measure
      Measure.restrict_le_self
  have htailM : Integrable
      (squarefreeMobiusCriticalClockTailMass sigma)
      halfLineLaplaceMeasure :=
    (integrable_squarefreeMobiusCriticalClockTailMass hsigma).mono_measure
      Measure.restrict_le_self
  have hmajor : Integrable (fun u => (1 / 4 : ℝ) *
      (squarefreeMobiusCriticalFisherTailEnergy sigma u +
        squarefreeMobiusCriticalProjectiveFisherEnergy sigma *
          squarefreeMobiusCriticalClockTailMass sigma u))
      halfLineLaplaceMeasure :=
    (htailF.add (htailM.const_mul
      (squarefreeMobiusCriticalProjectiveFisherEnergy sigma))).const_mul
        (1 / 4 : ℝ)
  refine Integrable.mono' hmajor (hfmeas.norm.pow 2) ?_
  filter_upwards [ae_restrict_mem measurableSet_Ioi] with u hu
  rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
  exact joinedCodiagonal_sq_le_tailMajorant hsigma D hD hu

/-- Actual countable common Hardy reporter produced by one source
contraction. -/
def squarefreeMobiusCriticalFisherCountableCommonHardyReporter
    (sigma : ℝ) (hsigma : 1 < sigma)
    (D : lp (fun _ : ℕ => ℂ) 2 →L[ℂ] lp (fun _ : ℕ => ℂ) 2)
    (hD : ‖D‖ ≤ 1) : Lp ℂ 2 halfLineLaplaceMeasure :=
  (squarefreeMobiusCriticalFisherJoinedCodiagonal_memLp
    sigma hsigma D hD).toLp
      (squarefreeMobiusCriticalFisherJoinedCodiagonal sigma hsigma D)

/-- **Simultaneous countable Laplace column.**  The single literal common
reporter has, at every right-half-plane node, the unconditional countable
sum of exact source semigroup divided differences. -/
theorem
    halfLineLaplaceTransform_squarefreeMobiusCriticalFisherCountableCommonHardyReporter_eq
    (sigma : ℝ) (hsigma : 1 < sigma)
    (D : lp (fun _ : ℕ => ℂ) 2 →L[ℂ] lp (fun _ : ℕ => ℂ) 2)
    (hD : ‖D‖ ≤ 1) (w : ℂ) (hw : 0 < w.re) :
    halfLineLaplaceTransform
        (squarefreeMobiusCriticalFisherCountableCommonHardyReporter
          sigma hsigma D hD) w hw =
      ∑' p : ℕ × ℕ,
        semigroupDividedDifferenceCoefficient
          (squarefreeMobiusCriticalClock sigma p.1)
          (squarefreeMobiusCriticalClock sigma p.2)
          (squarefreeMobiusCriticalFisherJoinedPairCoefficient
            sigma hsigma D p.1 p.2) w := by
  let k : ℕ × ℕ → ℂ := fun p =>
    squarefreeMobiusCriticalFisherJoinedPairCoefficient
      sigma hsigma D p.1 p.2
  let F : (ℕ × ℕ) → ℝ → ℂ := fun p =>
    countablePairLaplaceIntegrand
      (squarefreeMobiusCriticalClock sigma p.1)
      (squarefreeMobiusCriticalClock sigma p.2) (k p) w
  have hk : Summable (fun p => ‖k p‖) :=
    summable_norm_squarefreeMobiusCriticalFisherJoinedPairCoefficient
      sigma hsigma D
  have hFint (p : ℕ × ℕ) : Integrable (F p) halfLineLaplaceMeasure :=
    countablePairLaplaceIntegrand_integrable _ _ _ w hw
  have hFbound (p : ℕ × ℕ) :
      (∫ u : ℝ, ‖F p u‖ ∂halfLineLaplaceMeasure) ≤
        ‖k p‖ / w.re :=
    integral_norm_countablePairLaplaceIntegrand_le _ _ _ w hw
  have hmajor : Summable (fun p => ‖k p‖ / w.re) := by
    simpa only [div_eq_mul_inv] using hk.mul_right (w.re)⁻¹
  have hFsum : Summable
      (fun p => ∫ u : ℝ, ‖F p u‖ ∂halfLineLaplaceMeasure) := by
    exact Summable.of_nonneg_of_le
      (fun p => integral_nonneg fun u => norm_nonneg (F p u))
      hFbound hmajor
  rw [halfLineLaplaceTransform_eq_integral]
  let hf := squarefreeMobiusCriticalFisherJoinedCodiagonal_memLp
    sigma hsigma D hD
  have hcoe := hf.coeFn_toLp
  rw [integral_congr_ae (by
    filter_upwards [hcoe] with u hu
    rw [squarefreeMobiusCriticalFisherCountableCommonHardyReporter, hu])]
  rw [show (fun u : ℝ => Complex.exp (-w * (u : ℂ)) *
      squarefreeMobiusCriticalFisherJoinedCodiagonal sigma hsigma D u) =
      fun u => ∑' p, F p u by
    funext u
    rw [squarefreeMobiusCriticalFisherJoinedCodiagonal_eq_tsum]
    rw [← tsum_mul_left]
    apply tsum_congr
    intro p
    simp only [F, k, countablePairLaplaceIntegrand]]
  rw [← integral_tsum_of_summable_integral_norm hFint hFsum]
  apply tsum_congr
  intro p
  rw [integral_countablePairLaplaceIntegrand_eq_oriented
    (by
      unfold squarefreeMobiusCriticalClock
      exact mul_nonneg (sub_nonneg.mpr hsigma.le)
        (Real.log_natCast_nonneg p.1))]
  apply orientedCutoffLaplaceCoefficient_eq_dividedDifference
  intro hwzero
  subst w
  simp at hw

private theorem integral_halfLine_positiveDiscreteTail
    (w h : ℕ → ℝ) (hw : ∀ n, 0 ≤ w n) (hh : ∀ n, 0 ≤ h n)
    (hwh : Summable (fun n => w n * h n)) :
    (∫ u : ℝ, positiveDiscreteTail w h u ∂halfLineLaplaceMeasure) =
      ∑' n, w n * h n := by
  rw [halfLineLaplaceMeasure, ← integral_indicator measurableSet_Ioi]
  rw [show (Ioi 0).indicator (positiveDiscreteTail w h) =
      positiveDiscreteTail w h by
    funext u
    by_cases hu : 0 < u
    · simp [Set.indicator, hu]
    · simp [Set.indicator, hu, positiveDiscreteTail]]
  exact integral_positiveDiscreteTail w h hw hh hwh

/-- Exact total escaped-mass layer cake. -/
theorem integral_halfLine_squarefreeMobiusCriticalClockTailMass
    {sigma : ℝ} (hsigma : 1 < sigma) :
    (∫ u : ℝ, squarefreeMobiusCriticalClockTailMass sigma u
        ∂halfLineLaplaceMeasure) =
      (sigma - 1) * squarefreeMobiusLogMoment 1 sigma := by
  unfold squarefreeMobiusCriticalClockTailMass
  rw [integral_halfLine_positiveDiscreteTail
      (squarefreeMobiusProbability sigma)
      (squarefreeMobiusCriticalClock sigma)
      (squarefreeMobiusProbability_nonneg hsigma)
      (fun n => by
        unfold squarefreeMobiusCriticalClock
        exact mul_nonneg (sub_nonneg.mpr hsigma.le)
          (Real.log_natCast_nonneg n))
      (by
        have h := (summable_squarefreeMobiusLogMoment 1 hsigma).mul_left
          (sigma - 1)
        apply h.congr
        intro n
        unfold squarefreeMobiusCriticalClock
        simp only [pow_one]
        ring)]
  rw [show (fun n : ℕ => squarefreeMobiusProbability sigma n *
      squarefreeMobiusCriticalClock sigma n) =
      fun n => (sigma - 1) *
        (squarefreeMobiusProbability sigma n * Real.log n) by
    funext n
    unfold squarefreeMobiusCriticalClock
    ring]
  rw [tsum_mul_left]
  unfold squarefreeMobiusLogMoment
  simp only [pow_one]

/-- Exact total escaped-Fisher layer cake. -/
theorem integral_halfLine_squarefreeMobiusCriticalFisherTailEnergy
    {sigma : ℝ} (hsigma : 1 < sigma) :
    (∫ u : ℝ, squarefreeMobiusCriticalFisherTailEnergy sigma u
        ∂halfLineLaplaceMeasure) =
      4 * (sigma - 1) ^ 3 *
        (squarefreeMobiusLogMoment 3 sigma -
          2 * squarefreeMobiusLogMoment 1 sigma *
            squarefreeMobiusLogMoment 2 sigma +
          squarefreeMobiusLogMoment 1 sigma ^ 3) := by
  unfold squarefreeMobiusCriticalFisherTailEnergy
  rw [integral_halfLine_positiveDiscreteTail
      (fun n => 4 * (sigma - 1) ^ 2 *
        squarefreeMobiusProbability sigma n *
          (Real.log n - squarefreeMobiusLogMoment 1 sigma) ^ 2)
      (squarefreeMobiusCriticalClock sigma)
      (fun n => by
        exact mul_nonneg
          (mul_nonneg (mul_nonneg (by positivity) (sq_nonneg _))
            (squarefreeMobiusProbability_nonneg hsigma n))
          (sq_nonneg _))
      (fun n => by
        unfold squarefreeMobiusCriticalClock
        exact mul_nonneg (sub_nonneg.mpr hsigma.le)
          (Real.log_natCast_nonneg n))
      (summable_squarefreeMobiusCriticalFisherWeights_mul_clock hsigma)]
  let m := squarefreeMobiusLogMoment 1 sigma
  have h3 := (summable_squarefreeMobiusLogMoment 3 hsigma).mul_left
    (4 * (sigma - 1) ^ 3)
  have h2 := (summable_squarefreeMobiusLogMoment 2 hsigma).mul_left
    (-8 * (sigma - 1) ^ 3 * m)
  have h1 := (summable_squarefreeMobiusLogMoment 1 hsigma).mul_left
    (4 * (sigma - 1) ^ 3 * m ^ 2)
  simp only [pow_one] at h1
  rw [show (fun n : ℕ =>
      (4 * (sigma - 1) ^ 2 * squarefreeMobiusProbability sigma n *
        (Real.log n - squarefreeMobiusLogMoment 1 sigma) ^ 2) *
          squarefreeMobiusCriticalClock sigma n) =
      fun n =>
        4 * (sigma - 1) ^ 3 *
            (squarefreeMobiusProbability sigma n * Real.log n ^ 3) +
          (-8 * (sigma - 1) ^ 3 * m) *
            (squarefreeMobiusProbability sigma n * Real.log n ^ 2) +
          (4 * (sigma - 1) ^ 3 * m ^ 2) *
            (squarefreeMobiusProbability sigma n * Real.log n) by
    funext n
    dsimp [m]
    unfold squarefreeMobiusCriticalClock
    ring]
  rw [Summable.tsum_add (h3.add h2) h1, Summable.tsum_add h3 h2,
    tsum_mul_left, tsum_mul_left, tsum_mul_left]
  rw [show (∑' n : ℕ,
      squarefreeMobiusProbability sigma n * Real.log n ^ 3) =
        squarefreeMobiusLogMoment 3 sigma by rfl]
  rw [show (∑' n : ℕ,
      squarefreeMobiusProbability sigma n * Real.log n ^ 2) =
        squarefreeMobiusLogMoment 2 sigma by rfl]
  rw [show (∑' n : ℕ,
      squarefreeMobiusProbability sigma n * Real.log n) =
        squarefreeMobiusLogMoment 1 sigma by
    unfold squarefreeMobiusLogMoment
    simp only [pow_one]]
  dsimp [m]
  ring

/-- Sharp finite-Euler global budget of the countable reporter. -/
def squarefreeMobiusCriticalFisherCountableReporterBudget
    (sigma : ℝ) : ℝ :=
  (sigma - 1) ^ 3 *
    (squarefreeMobiusLogMoment 3 sigma -
      squarefreeMobiusLogMoment 1 sigma *
        squarefreeMobiusLogMoment 2 sigma)

private theorem norm_sq_toLp_eq_integral_norm_sq
    {alpha : Type*} [MeasurableSpace alpha] {mu : Measure alpha}
    {f : alpha → ℂ} (hf : MemLp f 2 mu) :
    ‖hf.toLp f‖ ^ 2 = ∫ a, ‖f a‖ ^ 2 ∂mu := by
  have key := inner_self_eq_norm_sq (𝕜 := ℂ) (hf.toLp f)
  rw [MeasureTheory.L2.inner_def] at key
  have hint :
      (∫ a, inner ℂ ((hf.toLp f : alpha → ℂ) a)
          ((hf.toLp f : alpha → ℂ) a) ∂mu) =
        (((∫ a, ‖f a‖ ^ 2 ∂mu) : ℝ) : ℂ) := by
    rw [← integral_complex_ofReal]
    refine integral_congr_ae ?_
    filter_upwards [hf.coeFn_toLp] with a ha
    rw [ha, RCLike.inner_apply, Complex.mul_conj,
      Complex.normSq_eq_norm_sq]
  rw [hint] at key
  simpa using key.symm

/-- Exact integrated half-energy law for the literal countable reporter.
This retains the native one-corner energy on the right-hand side rather than
replacing it by the later moment majorant. -/
theorem
    norm_sq_squarefreeMobiusCriticalFisherCountableCommonHardyReporter_le_half_integral_lower
    (sigma : ℝ) (hsigma : 1 < sigma)
    (D : lp (fun _ : ℕ => ℂ) 2 →L[ℂ] lp (fun _ : ℕ => ℂ) 2)
    (hD : ‖D‖ ≤ 1) :
    ‖squarefreeMobiusCriticalFisherCountableCommonHardyReporter
        sigma hsigma D hD‖ ^ 2 ≤
      (1 / 2 : ℝ) *
        ∫ u : ℝ, squarefreeMobiusCriticalFisherLowerBoundaryEnergy sigma u
          ∂halfLineLaplaceMeasure := by
  let f := squarefreeMobiusCriticalFisherJoinedCodiagonal sigma hsigma D
  let hf := squarefreeMobiusCriticalFisherJoinedCodiagonal_memLp
    sigma hsigma D hD
  rw [squarefreeMobiusCriticalFisherCountableCommonHardyReporter,
    norm_sq_toLp_eq_integral_norm_sq hf]
  have hfsq : Integrable (fun u => ‖f u‖ ^ 2) halfLineLaplaceMeasure :=
    (memLp_two_iff_integrable_sq_norm hf.aestronglyMeasurable).1 hf
  have hlower :=
    integrable_squarefreeMobiusCriticalFisherLowerBoundaryEnergy hsigma
  calc
    (∫ u, ‖f u‖ ^ 2 ∂halfLineLaplaceMeasure) ≤
        ∫ u, (1 / 2 : ℝ) *
          squarefreeMobiusCriticalFisherLowerBoundaryEnergy sigma u
            ∂halfLineLaplaceMeasure := by
      apply integral_mono_ae hfsq (hlower.const_mul (1 / 2 : ℝ))
      filter_upwards with u
      exact
        norm_sq_hsInner_squarefreeMobiusCriticalFisherLowerBoundary_joinedReporter_le_half
          hsigma D hD (u := u)
    _ = (1 / 2 : ℝ) *
        ∫ u, squarefreeMobiusCriticalFisherLowerBoundaryEnergy sigma u
          ∂halfLineLaplaceMeasure := by
      rw [integral_const_mul]

/-- **Countable common-reporter four-unit law.**  Every contraction of the
completed squarefree source gives one common Hardy reporter whose complete
half-line energy is bounded by the sharp third-cumulant budget. -/
theorem norm_sq_squarefreeMobiusCriticalFisherCountableCommonHardyReporter_le
    (sigma : ℝ) (hsigma : 1 < sigma)
    (D : lp (fun _ : ℕ => ℂ) 2 →L[ℂ] lp (fun _ : ℕ => ℂ) 2)
    (hD : ‖D‖ ≤ 1) :
    ‖squarefreeMobiusCriticalFisherCountableCommonHardyReporter
        sigma hsigma D hD‖ ^ 2 ≤
      squarefreeMobiusCriticalFisherCountableReporterBudget sigma := by
  let f := squarefreeMobiusCriticalFisherJoinedCodiagonal sigma hsigma D
  let hf := squarefreeMobiusCriticalFisherJoinedCodiagonal_memLp
    sigma hsigma D hD
  rw [squarefreeMobiusCriticalFisherCountableCommonHardyReporter,
    norm_sq_toLp_eq_integral_norm_sq hf]
  have hfsq : Integrable (fun u => ‖f u‖ ^ 2) halfLineLaplaceMeasure :=
    (memLp_two_iff_integrable_sq_norm hf.aestronglyMeasurable).1 hf
  have htailF : Integrable
      (squarefreeMobiusCriticalFisherTailEnergy sigma)
      halfLineLaplaceMeasure :=
    (integrable_squarefreeMobiusCriticalFisherTailEnergy hsigma).mono_measure
      Measure.restrict_le_self
  have htailM : Integrable
      (squarefreeMobiusCriticalClockTailMass sigma)
      halfLineLaplaceMeasure :=
    (integrable_squarefreeMobiusCriticalClockTailMass hsigma).mono_measure
      Measure.restrict_le_self
  let major := fun u : ℝ => (1 / 4 : ℝ) *
    (squarefreeMobiusCriticalFisherTailEnergy sigma u +
      squarefreeMobiusCriticalProjectiveFisherEnergy sigma *
        squarefreeMobiusCriticalClockTailMass sigma u)
  have hmajor : Integrable major halfLineLaplaceMeasure :=
    (htailF.add (htailM.const_mul
      (squarefreeMobiusCriticalProjectiveFisherEnergy sigma))).const_mul
        (1 / 4 : ℝ)
  calc
    (∫ u, ‖f u‖ ^ 2 ∂halfLineLaplaceMeasure) ≤
        ∫ u, major u ∂halfLineLaplaceMeasure := by
      apply integral_mono_ae hfsq hmajor
      filter_upwards [ae_restrict_mem measurableSet_Ioi] with u hu
      exact joinedCodiagonal_sq_le_tailMajorant hsigma D hD hu
    _ = squarefreeMobiusCriticalFisherCountableReporterBudget sigma := by
      rw [show (∫ u, major u ∂halfLineLaplaceMeasure) =
          (1 / 4 : ℝ) *
            ((∫ u, squarefreeMobiusCriticalFisherTailEnergy sigma u
                ∂halfLineLaplaceMeasure) +
              squarefreeMobiusCriticalProjectiveFisherEnergy sigma *
                (∫ u, squarefreeMobiusCriticalClockTailMass sigma u
                  ∂halfLineLaplaceMeasure)) by
        dsimp [major]
        rw [integral_const_mul, integral_add htailF
          (htailM.const_mul
            (squarefreeMobiusCriticalProjectiveFisherEnergy sigma)),
          integral_const_mul]]
      rw [integral_halfLine_squarefreeMobiusCriticalFisherTailEnergy hsigma,
        integral_halfLine_squarefreeMobiusCriticalClockTailMass hsigma]
      unfold squarefreeMobiusCriticalFisherCountableReporterBudget
        squarefreeMobiusCriticalProjectiveFisherEnergy
        squarefreeMobiusCriticalClockVariance
      ring

/-- Countable completion preserves the exact critical four-unit source
budget. -/
theorem tendsto_squarefreeMobiusCriticalFisherCountableReporterBudget :
