import GaloisForLFunctions.RHTower.FieldOnePadicSoninL2TwoShell

/-!
# Connes--Consani--Moscovici Proposition 4.4

The `ℤ_pˣ`-invariant part of the local Sonin space
`S₁(ℚ_p,e_p)` is exactly one-dimensional, generated by
`σ_p = ε₀ - p⁻¹ ε₁`.
-/

namespace GaloisForLFunctions.RHTower

noncomputable section

open MeasureTheory Set Topology TopologicalSpace
open scoped BigOperators ENNReal NNReal ComplexConjugate

variable (p : ℕ) [Fact p.Prime]

theorem fieldOnePadicSoninBall_unitInvariant
    (m : ℤ) (u : ℤ_[p]ˣ) (x : ℚ_[p]) :
    (fieldOnePadicSoninBall p m).1
        ((((u : ℤ_[p]) : ℚ_[p])) * x) =
      (fieldOnePadicSoninBall p m).1 x := by
  rw [fieldOnePadicSoninBall_apply_eq_indicator,
    fieldOnePadicSoninBall_apply_eq_indicator]
  rw [fieldOnePadicSoninBallSet_unit_mul_iff]

theorem fieldOnePadicSoninSigma_unitInvariant
    (u : ℤ_[p]ˣ) (x : ℚ_[p]) :
    (fieldOnePadicSoninSigma p).1
        ((((u : ℤ_[p]) : ℚ_[p])) * x) =
      (fieldOnePadicSoninSigma p).1 x := by
  simp only [fieldOnePadicSoninSigma, fieldOnePadicSoninShell]
  change (((fieldOnePadicSoninBall p 0).1 _ -
      (fieldOnePadicSoninBall p (0 - 1)).1 _) -
    (p : ℂ)⁻¹ * ((fieldOnePadicSoninBall p 1).1 _ -
      (fieldOnePadicSoninBall p (1 - 1)).1 _)) =
    (((fieldOnePadicSoninBall p 0).1 x -
      (fieldOnePadicSoninBall p (0 - 1)).1 x) -
    (p : ℂ)⁻¹ * ((fieldOnePadicSoninBall p 1).1 x -
      (fieldOnePadicSoninBall p (1 - 1)).1 x))
  rw [fieldOnePadicSoninBall_unitInvariant,
    fieldOnePadicSoninBall_unitInvariant,
    fieldOnePadicSoninBall_unitInvariant,
    fieldOnePadicSoninBall_unitInvariant]

theorem fieldOnePadicSoninSigmaL2_mem_unitInvariant :
    fieldOnePadicSoninSigmaL2 p ∈ FieldOnePadicUnitInvariantL2 p := by
  rw [mem_fieldOnePadicUnitInvariantL2_iff]
  intro u
  rw [fieldOnePadicSoninSigmaL2, fieldOnePadicUnitActionL2_bruhat]
  apply congrArg (fieldOnePadicBruhatToL2Linear p)
  apply Subtype.ext
  apply LocallyConstant.ext
  intro x
  rw [fieldOnePadicBruhatDilation_apply, fieldOnePadicUnitEmbedding_val]
  exact fieldOnePadicSoninSigma_unitInvariant p u x

theorem fieldOnePadicTwoShell_fourierGap_coeff_relation
    (a b : ℂ)
    (hgap : fieldOnePadicL2SetProjection p
      (fieldOnePadicSoninInnerBall p)
      (fieldOnePadicSoninInnerBall_measurable p)
      (fieldOnePadicL2Fourier p
        (a • fieldOnePadicSoninShellL2 p 0 +
          b • fieldOnePadicSoninShellL2 p 1)) = 0) :
    b = -(p : ℂ)⁻¹ * a := by
  let h : compactlySupportedLocallyConstant ℚ_[p] :=
    a • fieldOnePadicSoninShell p 0 +
      b • fieldOnePadicSoninShell p 1
  have hproj : fieldOnePadicL2SetProjection p
      (fieldOnePadicSoninInnerBall p)
      (fieldOnePadicSoninInnerBall_measurable p)
      (fieldOnePadicBruhatToL2Linear p
        (fieldOnePadicBruhatFourierLinear p h)) = 0 := by
    have hinput : a • fieldOnePadicSoninShellL2 p 0 +
        b • fieldOnePadicSoninShellL2 p 1 =
      fieldOnePadicBruhatToL2Linear p h := by
      simp only [h, fieldOnePadicSoninShellL2, map_add, map_smul]
    rw [hinput, fieldOnePadicL2Fourier_bruhat] at hgap
    change fieldOnePadicL2SetProjection p
      (fieldOnePadicSoninInnerBall p)
      (fieldOnePadicSoninInnerBall_measurable p)
      (fieldOnePadicBruhatToL2Linear p
        (fieldOnePadicBruhatFourierLinear p h)) = 0 at hgap
    exact hgap
  let hrestrict := fieldOnePadicBruhatRestrict p
    (fieldOnePadicSoninInnerBall p)
    (fieldOnePadicSoninBallSet_isClopen p (-1))
    (fieldOnePadicBruhatFourierLinear p h)
  have hrestrictL2 : fieldOnePadicBruhatToL2Linear p hrestrict = 0 := by
    rw [fieldOnePadicBruhatToL2_restrict]
    exact hproj
  have hrestrictZero : hrestrict = 0 := by
    apply fieldOnePadicBruhatToL2Linear_injective p
    simpa using hrestrictL2
  let x : ℚ_[p] :=
    ((fieldOnePadicValuationUnitForward p
      (Multiplicative.ofAdd (1 : ℤ), 1) : ℚ_[p]ˣ) : ℚ_[p])
  have hxinner : x ∈ fieldOnePadicSoninInnerBall p := by
    change x ∈ fieldOnePadicSoninBallSet p (-1)
    rw [fieldOnePadicSoninBallSet_mem_forward_iff]
    omega
  have hevalRestrict := congrArg
    (fun q : compactlySupportedLocallyConstant ℚ_[p] => q.1 x)
    hrestrictZero
  have heval : (fieldOnePadicBruhatFourierLinear p h).1 x = 0 := by
    simpa [hrestrict, fieldOnePadicBruhatRestrict_apply,
      Set.indicator_of_mem hxinner] using hevalRestrict
  change fieldOnePadicBruhatEvalLinear p x
    (fieldOnePadicBruhatFourierLinear p h) = 0 at heval
  simp only [h, map_add, map_smul, fieldOnePadicBruhatEvalLinear_apply,
    smul_eq_mul] at heval
  rw [fieldOnePadicBruhatFourierLinear_soninShell,
    fieldOnePadicBruhatFourierLinear_soninShell] at heval
  change a * (((p : ℂ) ^ (0 : ℤ)) *
      (fieldOnePadicSoninBall p 0).1 x -
    ((p : ℂ) ^ ((0 : ℤ) - 1)) *
      (fieldOnePadicSoninBall p 1).1 x) +
    b * (((p : ℂ) ^ (1 : ℤ)) *
      (fieldOnePadicSoninBall p (-1)).1 x -
    ((p : ℂ) ^ ((1 : ℤ) - 1)) *
      (fieldOnePadicSoninBall p 0).1 x) = 0 at heval
  have hx0 : x ∈ fieldOnePadicSoninBallSet p 0 := by
    rw [fieldOnePadicSoninBallSet_mem_forward_iff]
    omega
  have hx1 : x ∈ fieldOnePadicSoninBallSet p 1 := by
    rw [fieldOnePadicSoninBallSet_mem_forward_iff]
    omega
  change x ∈ fieldOnePadicSoninBallSet p (-1) at hxinner
  simp_rw [fieldOnePadicSoninBall_apply_eq_indicator] at heval
  simp only [if_pos hx0, if_pos hx1, if_pos hxinner] at heval
  norm_num at heval
  have hp : (p : ℂ) ≠ 0 := by
    exact_mod_cast (Fact.out : Nat.Prime p).ne_zero
  field_simp [hp] at heval
  simp only [mul_zero] at heval
  have hp1 : (p : ℂ) - 1 ≠ 0 := by
    apply sub_ne_zero.mpr
    exact_mod_cast (Fact.out : Nat.Prime p).ne_one
  have hab : a + (p : ℂ) * b = 0 :=
    (mul_eq_zero.mp heval).resolve_left hp1
  have hpb : (p : ℂ) * b = -a := by
    linear_combination hab
  calc
    b = (p : ℂ)⁻¹ * ((p : ℂ) * b) := by field_simp
    _ = (p : ℂ)⁻¹ * (-a) := by rw [hpb]
    _ = -(p : ℂ)⁻¹ * a := by ring

theorem fieldOnePadicUnitInvariantSonin_eq_smul_sigma
    {f : FieldOnePadicL2 p}
    (hunit : f ∈ FieldOnePadicUnitInvariantL2 p)
    (hsonin : f ∈ FieldOnePadicSoninL2 p) :
    ∃ a : ℂ, f = a • fieldOnePadicSoninSigmaL2 p := by
  have htwo := fieldOnePadicUnitInvariantSonin_mem_twoShell p hunit hsonin
  change f ∈ Submodule.span ℂ
    ({fieldOnePadicSoninShellL2 p 0,
      fieldOnePadicSoninShellL2 p 1} : Set (FieldOnePadicL2 p)) at htwo
  obtain ⟨a, b, hab⟩ := (Submodule.mem_span_pair.mp htwo)
  change fieldOnePadicL2SetProjection p
      (fieldOnePadicSoninInnerBall p)
      (fieldOnePadicSoninInnerBall_measurable p) f = 0 ∧
    fieldOnePadicL2SetProjection p
      (fieldOnePadicSoninInnerBall p)
      (fieldOnePadicSoninInnerBall_measurable p)
      (fieldOnePadicL2Fourier p f) = 0 at hsonin
  have hcoeff := fieldOnePadicTwoShell_fourierGap_coeff_relation p a b (by
    rw [hab]
    exact hsonin.2)
  refine ⟨a, ?_⟩
  rw [← hab, hcoeff]
  simp only [fieldOnePadicSoninSigmaL2, fieldOnePadicSoninSigma,
    fieldOnePadicSoninShellL2, map_sub, map_smul]
  module

/-- Exact local spherical Sonin theorem, Proposition 4.4 of
Connes--Consani--Moscovici. -/
theorem fieldOnePadicProposition44 :
    FieldOnePadicSoninL2 p ⊓ FieldOnePadicUnitInvariantL2 p =
      ℂ ∙ fieldOnePadicSoninSigmaL2 p := by
  ext f
  constructor
  · intro hf
    obtain ⟨a, ha⟩ := fieldOnePadicUnitInvariantSonin_eq_smul_sigma
      p hf.2 hf.1
    rw [Submodule.mem_span_singleton]
    exact ⟨a, ha.symm⟩
  · intro hf
    rw [Submodule.mem_span_singleton] at hf
    obtain ⟨a, rfl⟩ := hf
    exact ⟨(FieldOnePadicSoninL2 p).smul_mem a
        (fieldOnePadicSoninSigmaL2_mem p),
      (FieldOnePadicUnitInvariantL2 p).smul_mem a
        (fieldOnePadicSoninSigmaL2_mem_unitInvariant p)⟩

end

end GaloisForLFunctions.RHTower
