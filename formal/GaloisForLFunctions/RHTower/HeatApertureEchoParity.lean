/-
# Closed parity laws and the single-missing-rung law for the heat-aperture echo ladder

Iterating the two-step recurrence of the archimedean echo coefficients gives closed Pochhammer
formulas for the even and odd subsequences, so the whole ladder is generated by its two initial
coefficients.  Combined with the nonvanishing of every strict backward zeta shift, this says that
a nontrivial zeta zero removes exactly the zeroth rung of the ladder and leaves every later rung
present.
-/
import GaloisForLFunctions.RHTower.HeatApertureEchoLadder

namespace GaloisForLFunctions

open Complex

noncomputable section

/-- **Closed even parity law.**  Every even echo coefficient is the zeroth one times an explicit
rising-factorial multiplier. -/
theorem factorial_mul_heatApertureEchoCoeff_two_mul {s : ℂ} (hs : 0 < s.re) (m : ℕ) :
    (Nat.factorial (2 * m) : ℂ) * heatApertureEchoCoeff s (2 * m)
      = heatApertureEchoCoeff s 0
        * ((-1 : ℂ) ^ m * (4 * (Real.pi : ℂ)) ^ m
            * ∏ j ∈ Finset.range m, (s / 2 + j)) := by
  induction m with
  | zero => simp
  | succ m ih =>
      have h1 : (2 * (m : ℂ) + 1) ≠ 0 := by
        intro hcon
        have hre := congrArg Complex.re hcon
        simp at hre
        linarith [Nat.cast_nonneg (α := ℝ) m]
      have h2 : (2 * (m : ℂ) + 2) ≠ 0 := by
        intro hcon
        have hre := congrArg Complex.re hcon
        simp at hre
        linarith [Nat.cast_nonneg (α := ℝ) m]
      have hstep := heatApertureEchoCoeff_add_two hs (2 * m)
      have hstep' : (2 * (m : ℂ) + 1) * (2 * (m : ℂ) + 2)
            * heatApertureEchoCoeff s (2 * m + 2)
          = -(2 * (Real.pi : ℂ) * (s + 2 * (m : ℂ)))
            * heatApertureEchoCoeff s (2 * m) := by
        rw [hstep]
        push_cast
        rw [show ((2 : ℂ) * m + 1) * (2 * m + 2) = (2 * (m : ℂ) + 1) * (2 * (m : ℂ) + 2) by ring]
        field_simp
      have hfac : (Nat.factorial (2 * (m + 1)) : ℂ)
          = (2 * (m : ℂ) + 1) * (2 * (m : ℂ) + 2) * (Nat.factorial (2 * m) : ℂ) := by
        rw [show 2 * (m + 1) = (2 * m + 1) + 1 by ring, Nat.factorial_succ, Nat.factorial_succ]
        push_cast
        ring
      rw [hfac, show 2 * (m + 1) = 2 * m + 2 by ring, Finset.prod_range_succ]
      calc (2 * (m : ℂ) + 1) * (2 * (m : ℂ) + 2) * (Nat.factorial (2 * m) : ℂ)
            * heatApertureEchoCoeff s (2 * m + 2)
          = (Nat.factorial (2 * m) : ℂ)
            * ((2 * (m : ℂ) + 1) * (2 * (m : ℂ) + 2) * heatApertureEchoCoeff s (2 * m + 2)) := by
            ring
        _ = (Nat.factorial (2 * m) : ℂ)
            * (-(2 * (Real.pi : ℂ) * (s + 2 * (m : ℂ))) * heatApertureEchoCoeff s (2 * m)) := by
            rw [hstep']
        _ = -(2 * (Real.pi : ℂ) * (s + 2 * (m : ℂ)))
            * ((Nat.factorial (2 * m) : ℂ) * heatApertureEchoCoeff s (2 * m)) := by ring
        _ = -(2 * (Real.pi : ℂ) * (s + 2 * (m : ℂ)))
            * (heatApertureEchoCoeff s 0
              * ((-1 : ℂ) ^ m * (4 * (Real.pi : ℂ)) ^ m
                * ∏ j ∈ Finset.range m, (s / 2 + j))) := by rw [ih]
        _ = heatApertureEchoCoeff s 0
            * ((-1 : ℂ) ^ (m + 1) * (4 * (Real.pi : ℂ)) ^ (m + 1)
              * ((∏ j ∈ Finset.range m, (s / 2 + j)) * (s / 2 + (m : ℂ)))) := by ring

/-- **Closed odd parity law.**  Every odd echo coefficient is the first one times an explicit
rising-factorial multiplier. -/
theorem factorial_mul_heatApertureEchoCoeff_two_mul_add_one {s : ℂ} (hs : 0 < s.re) (m : ℕ) :
    (Nat.factorial (2 * m + 1) : ℂ) * heatApertureEchoCoeff s (2 * m + 1)
      = heatApertureEchoCoeff s 1
        * ((-1 : ℂ) ^ m * (4 * (Real.pi : ℂ)) ^ m
            * ∏ j ∈ Finset.range m, ((s + 1) / 2 + j)) := by
  induction m with
  | zero => simp
  | succ m ih =>
      have h2 : (2 * (m : ℂ) + 2) ≠ 0 := by
        intro hcon
        have hre := congrArg Complex.re hcon
        simp at hre
        linarith [Nat.cast_nonneg (α := ℝ) m]
      have h3 : (2 * (m : ℂ) + 3) ≠ 0 := by
        intro hcon
        have hre := congrArg Complex.re hcon
        simp at hre
        linarith [Nat.cast_nonneg (α := ℝ) m]
      have hstep := heatApertureEchoCoeff_add_two hs (2 * m + 1)
      have hstep' : (2 * (m : ℂ) + 2) * (2 * (m : ℂ) + 3)
            * heatApertureEchoCoeff s (2 * m + 1 + 2)
          = -(2 * (Real.pi : ℂ) * (s + (2 * (m : ℂ) + 1)))
            * heatApertureEchoCoeff s (2 * m + 1) := by
        rw [hstep]
        push_cast
        rw [show ((2 : ℂ) * m + 1 + 1) * (2 * m + 1 + 2)
          = (2 * (m : ℂ) + 2) * (2 * (m : ℂ) + 3) by ring]
        field_simp
      have hfac : (Nat.factorial (2 * (m + 1) + 1) : ℂ)
          = (2 * (m : ℂ) + 2) * (2 * (m : ℂ) + 3) * (Nat.factorial (2 * m + 1) : ℂ) := by
        rw [show 2 * (m + 1) + 1 = (2 * m + 2) + 1 by ring, Nat.factorial_succ, Nat.factorial_succ]
        push_cast
        ring
      rw [hfac, show 2 * (m + 1) + 1 = 2 * m + 1 + 2 by ring, Finset.prod_range_succ]
      calc (2 * (m : ℂ) + 2) * (2 * (m : ℂ) + 3) * (Nat.factorial (2 * m + 1) : ℂ)
            * heatApertureEchoCoeff s (2 * m + 1 + 2)
          = (Nat.factorial (2 * m + 1) : ℂ)
            * ((2 * (m : ℂ) + 2) * (2 * (m : ℂ) + 3)
              * heatApertureEchoCoeff s (2 * m + 1 + 2)) := by ring
        _ = (Nat.factorial (2 * m + 1) : ℂ)
            * (-(2 * (Real.pi : ℂ) * (s + (2 * (m : ℂ) + 1)))
              * heatApertureEchoCoeff s (2 * m + 1)) := by rw [hstep']
        _ = -(2 * (Real.pi : ℂ) * (s + (2 * (m : ℂ) + 1)))
            * ((Nat.factorial (2 * m + 1) : ℂ) * heatApertureEchoCoeff s (2 * m + 1)) := by ring
        _ = -(2 * (Real.pi : ℂ) * (s + (2 * (m : ℂ) + 1)))
            * (heatApertureEchoCoeff s 1
              * ((-1 : ℂ) ^ m * (4 * (Real.pi : ℂ)) ^ m
                * ∏ j ∈ Finset.range m, ((s + 1) / 2 + j))) := by rw [ih]
        _ = heatApertureEchoCoeff s 1
            * ((-1 : ℂ) ^ (m + 1) * (4 * (Real.pi : ℂ)) ^ (m + 1)
              * ((∏ j ∈ Finset.range m, ((s + 1) / 2 + j)) * ((s + 1) / 2 + (m : ℂ)))) := by ring

/-- The card's `(5a)`, in divided form. -/
theorem heatApertureEchoCoeff_two_mul {s : ℂ} (hs : 0 < s.re) (m : ℕ) :
    heatApertureEchoCoeff s (2 * m)
      = heatApertureEchoCoeff s 0
        * ((-1 : ℂ) ^ m * (4 * (Real.pi : ℂ)) ^ m
            * ∏ j ∈ Finset.range m, (s / 2 + j)) / (Nat.factorial (2 * m) : ℂ) := by
  have hne : ((Nat.factorial (2 * m) : ℕ) : ℂ) ≠ 0 :=
    Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
  rw [eq_div_iff hne, mul_comm]
  exact factorial_mul_heatApertureEchoCoeff_two_mul hs m

/-- The card's `(5a)`, odd half, in divided form. -/
theorem heatApertureEchoCoeff_two_mul_add_one {s : ℂ} (hs : 0 < s.re) (m : ℕ) :
    heatApertureEchoCoeff s (2 * m + 1)
      = heatApertureEchoCoeff s 1
        * ((-1 : ℂ) ^ m * (4 * (Real.pi : ℂ)) ^ m
            * ∏ j ∈ Finset.range m, ((s + 1) / 2 + j)) / (Nat.factorial (2 * m + 1) : ℂ) := by
  have hne : ((Nat.factorial (2 * m + 1) : ℕ) : ℂ) ≠ 0 :=
    Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
  rw [eq_div_iff hne, mul_comm]
  exact factorial_mul_heatApertureEchoCoeff_two_mul_add_one hs m

/-! ### The single-missing-rung law -/

/-- The zeroth echo value is the archimedean weight times the reflected zeta value. -/
theorem heatApertureEchoValue_zero (s : ℂ) :
    heatApertureEchoValue s 0
      = heatApertureEchoCoeff s 0 * (starRingEnd ℂ) (riemannZeta s) := by
  rw [heatApertureEchoValue, heatApertureBackwardZetaValue]
  simp [riemannZeta_conj]

/-- **Every strict rung of the ladder is present.** -/
theorem heatApertureEchoValue_ne_zero {s : ℂ} (hslo : (1 / 2 : ℝ) < s.re) (hshi : s.re < 1)
    {k : ℕ} (hk : 1 ≤ k) : heatApertureEchoValue s k ≠ 0 := by
  have hre : ((starRingEnd ℂ) s).re = s.re := Complex.conj_re s
  refine mul_ne_zero (heatApertureEchoCoeff_ne_zero hslo hshi k) ?_
  rw [heatApertureBackwardZetaValue]
  exact riemannZeta_sub_nat_ne_zero_of_criticalStrip (by rw [hre]; exact hslo)
    (by rw [hre]; exact hshi) hk

/-- **The single-missing-rung law.**  In the open critical strip a zeta zero is exactly the
disappearance of the zeroth rung of the echo ladder, every later rung remaining present. -/
theorem riemannZeta_eq_zero_iff_echoLadder {s : ℂ} (hslo : (1 / 2 : ℝ) < s.re)
    (hshi : s.re < 1) :
    riemannZeta s = 0
      ↔ heatApertureEchoValue s 0 = 0 ∧ ∀ k : ℕ, 1 ≤ k → heatApertureEchoValue s k ≠ 0 := by
  have h0 : (0 : ℝ) < s.re := by linarith
  constructor
  · intro hz
    refine ⟨?_, fun k hk => heatApertureEchoValue_ne_zero hslo hshi hk⟩
    rw [heatApertureEchoValue_zero, hz, map_zero, mul_zero]
  · rintro ⟨hz, -⟩
    rw [heatApertureEchoValue_zero] at hz
    rcases mul_eq_zero.mp hz with h | h
    · exact absurd h (heatApertureEchoCoeff_ne_zero hslo hshi 0)
    · exact (map_eq_zero_iff _ (starRingEnd ℂ).injective).mp h

end

end GaloisForLFunctions
