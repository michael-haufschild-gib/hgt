import GaloisForLFunctions.RHTower.XiCenteredRealShiftDiagonalExtractor
import GaloisForLFunctions.RHTower.RectangleConfluentTwoPoleResidue

/-!
# Exact centered-shift correction for the rational Xi pair kernel

The fixed-pole rational pair kernel is the exact complement of the centered reciprocal shift
generated by its two prescribed poles.  Consequently total finite mass minus the centered-shift
diagonal covariance is exactly the rational pair covariance, already at nonzero displacement.

This is the algebraic residue connector needed before a nested pole--Gamma--von-Mangoldt contour
landing.  No divisor enumeration, limiting interchange, simplicity assumption, or zero-dependent
scale occurs in the definitions.
-/

open Complex
open scoped BigOperators

namespace RHTower

noncomputable section

/-- The prescribed two-pole centered reciprocal shift is exactly the diagonal complement of the
rational pair kernel. -/
theorem meromorphicCauchyDiagonalKernel_eq_centeredReciprocalShift
    (eps : ℝ) (z w : ℂ)
    (hminus : z - w - (eps : ℂ) ≠ 0)
    (hplus : z - w + (eps : ℂ) ≠ 0) :
    meromorphicCauchyDiagonalKernel eps z w =
      (eps / 2 : ℂ) *
        (((w + (eps : ℂ)) - z)⁻¹ - ((w - (eps : ℂ)) - z)⁻¹) := by
  rw [meromorphicCauchyDiagonalKernel,
    meromorphicCauchyPairKernel_eq_resolventDifference eps z w hminus hplus]
  rw [show (w + (eps : ℂ)) - z = -(z - w - (eps : ℂ)) by ring,
    show (w - (eps : ℂ)) - z = -(z - w + (eps : ℂ)) by ring]
  simp only [inv_neg]
  ring

/-- The rational pair kernel is symmetric in its two support variables. -/
theorem meromorphicCauchyPairKernel_comm (eps : ℝ) (z w : ℂ) :
    meromorphicCauchyPairKernel eps z w =
      meromorphicCauchyPairKernel eps w z := by
  rw [meromorphicCauchyPairKernel, meromorphicCauchyPairKernel]
  congr 1 <;> ring

/-- Finite centered reciprocal-shift row.  This is the exact finite-divisor contribution of the
two prescribed positive-real source shifts. -/
def finiteCenteredReciprocalShiftDiagonalRow {ι : Type*}
    (s : Finset ι) (z m : ι → ℂ) (eps : ℝ) (w : ℂ) : ℂ :=
  ∑ i ∈ s, m i * (eps / 2 : ℂ) *
    (((w + (eps : ℂ)) - z i)⁻¹ - ((w - (eps : ℂ)) - z i)⁻¹)

/-- At finite nonzero displacement, the centered reciprocal-shift row is exactly the weighted
sum of diagonal-complement kernels. -/
theorem finiteCenteredReciprocalShiftDiagonalRow_eq_diagonalKernelSum
    {ι : Type*} (s : Finset ι) (z m : ι → ℂ) (eps : ℝ) (w : ℂ)
    (hminus : ∀ i ∈ s, z i - w - (eps : ℂ) ≠ 0)
    (hplus : ∀ i ∈ s, z i - w + (eps : ℂ) ≠ 0) :
    finiteCenteredReciprocalShiftDiagonalRow s z m eps w =
      ∑ i ∈ s, m i * meromorphicCauchyDiagonalKernel eps (z i) w := by
  rw [finiteCenteredReciprocalShiftDiagonalRow]
  apply Finset.sum_congr rfl
  intro i hi
  rw [meromorphicCauchyDiagonalKernel_eq_centeredReciprocalShift
    eps (z i) w (hminus i hi) (hplus i hi)]
  ring

/-- Total mass minus the centered positive-real shift row is the rational off-diagonal pair row.
This is the exact finite-displacement replacement for taking a diagonal-extractor limit first. -/
theorem finiteTotalMass_sub_centeredReciprocalShiftDiagonalRow_eq_pairRow
    {ι : Type*} (s : Finset ι) (z m : ι → ℂ) (eps : ℝ) (w : ℂ)
    (hminus : ∀ i ∈ s, z i - w - (eps : ℂ) ≠ 0)
    (hplus : ∀ i ∈ s, z i - w + (eps : ℂ) ≠ 0) :
    (∑ i ∈ s, m i) -
        finiteCenteredReciprocalShiftDiagonalRow s z m eps w =
      ∑ i ∈ s, m i * meromorphicCauchyPairKernel eps (z i) w := by
  rw [finiteCenteredReciprocalShiftDiagonalRow_eq_diagonalKernelSum
    s z m eps w hminus hplus, ← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro i hi
  rw [meromorphicCauchyDiagonalKernel]
  ring

/-- Finite centered-shift diagonal covariance before any shrinking-shift limit. -/
def finiteCenteredReciprocalShiftDiagonalCovariance {ι : Type*}
    (s : Finset ι) (z m : ι → ℂ) (eps : ℝ) : ℂ :=
  ∑ w ∈ s, m w *
    finiteCenteredReciprocalShiftDiagonalRow s z m eps (z w)

/-- Finite rational pair covariance at an arbitrary prescribed displacement. -/
def finiteRationalCauchyPairCovarianceAtScale {ι : Type*}
    (s : Finset ι) (z m : ι → ℂ) (eps : ℝ) : ℂ :=
  ∑ p ∈ s.product s,
    m p.1 * m p.2 * meromorphicCauchyPairKernel eps (z p.1) (z p.2)

/-- **Exact finite covariance correction.**  Total mass squared minus the centered positive-real
shift diagonal covariance equals the fixed-pole rational pair covariance. -/
theorem totalMass_sq_sub_centeredReciprocalShiftDiagonalCovariance_eq_pairCovariance
    {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (z m : ι → ℂ) (eps : ℝ)
    (hminus : ∀ i ∈ s, ∀ j ∈ s, z i - z j - (eps : ℂ) ≠ 0)
    (hplus : ∀ i ∈ s, ∀ j ∈ s, z i - z j + (eps : ℂ) ≠ 0) :
    (∑ i ∈ s, m i) ^ (2 : ℕ) -
        finiteCenteredReciprocalShiftDiagonalCovariance s z m eps =
      finiteRationalCauchyPairCovarianceAtScale s z m eps := by
  let M : ℂ := ∑ i ∈ s, m i
  have hrow : ∀ w ∈ s,
      M - finiteCenteredReciprocalShiftDiagonalRow s z m eps (z w) =
        ∑ i ∈ s, m i * meromorphicCauchyPairKernel eps (z i) (z w) := by
    intro w hw
    exact finiteTotalMass_sub_centeredReciprocalShiftDiagonalRow_eq_pairRow
      s z m eps (z w) (fun i hi => hminus i hi w hw)
        (fun i hi => hplus i hi w hw)
  calc
    (∑ i ∈ s, m i) ^ (2 : ℕ) -
        finiteCenteredReciprocalShiftDiagonalCovariance s z m eps =
        ∑ w ∈ s, m w *
          (M - finiteCenteredReciprocalShiftDiagonalRow s z m eps (z w)) := by
      rw [finiteCenteredReciprocalShiftDiagonalCovariance]
      simp_rw [mul_sub]
      rw [Finset.sum_sub_distrib, ← Finset.sum_mul]
      dsimp only [M]
      ring
    _ = ∑ w ∈ s, m w *
        (∑ i ∈ s, m i *
          meromorphicCauchyPairKernel eps (z i) (z w)) := by
      apply Finset.sum_congr rfl
      intro w hw
      rw [hrow w hw]
    _ = ∑ w ∈ s, ∑ i ∈ s,
        m w * m i * meromorphicCauchyPairKernel eps (z i) (z w) := by
      apply Finset.sum_congr rfl
      intro w hw
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i hi
      ring
    _ = ∑ w ∈ s, ∑ i ∈ s,
        m w * m i * meromorphicCauchyPairKernel eps (z w) (z i) := by
      apply Finset.sum_congr rfl
      intro w hw
      apply Finset.sum_congr rfl
      intro i hi
      rw [meromorphicCauchyPairKernel_comm eps (z i) (z w)]
    _ = finiteRationalCauchyPairCovarianceAtScale s z m eps := by
      rw [finiteRationalCauchyPairCovarianceAtScale]
      exact (Finset.sum_product s s (fun p : ι × ι =>
        m p.1 * m p.2 *
          meromorphicCauchyPairKernel eps (z p.1) (z p.2))).symm

/-- The arbitrary-scale covariance specializes definitionally to the existing reciprocal-scale
pair covariance used by the source-kernel construction. -/
theorem finiteRationalCauchyPairCovarianceAtScale_reciprocal_eq
    {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (z m : ι → ℂ) (n : ℕ) :
    finiteRationalCauchyPairCovarianceAtScale s z m
        (1 / ((n : ℝ) + 1)) =
      finiteMeromorphicCauchyPairCovariance s z m n := by
  rfl

/-! ## Local source-cofactor residue correction -/

/-- **Two-pole cofactor correction.**  If an analytic source row `g` is defined near a rectangle
and both prescribed rational-kernel poles lie strictly inside, integrating the rational pair
kernel against `g` gives exactly the centered positive-real shift of `g` at `w`.

Applied to the zero-free logarithmic derivative cofactor in a finite Xi factorization, this is the
cofactor half of the desired pre-divisor rational-pair contour landing. -/
theorem rectIntegral_meromorphicCauchyPairKernel_mul_of_analyticOnNhd
    {g : ℂ → ℂ} {eps : ℝ} {w z₁ z₂ : ℂ} {U : Set ℂ}
    (hg : AnalyticOnNhd ℂ g U)
    (hsub : (Set.uIcc z₁.re z₂.re ×ℂ Set.uIcc z₁.im z₂.im) ⊆ U)
    (hplus : z₁.re < (w + (eps : ℂ)).re ∧
      (w + (eps : ℂ)).re < z₂.re ∧
      z₁.im < (w + (eps : ℂ)).im ∧
      (w + (eps : ℂ)).im < z₂.im)
    (hminus : z₁.re < (w - (eps : ℂ)).re ∧
      (w - (eps : ℂ)).re < z₂.re ∧
      z₁.im < (w - (eps : ℂ)).im ∧
      (w - (eps : ℂ)).im < z₂.im) :
    rectIntegral
        (fun z => meromorphicCauchyPairKernel eps z w * g z) z₁ z₂ =
      2 * Real.pi * I *
        ((eps / 2 : ℂ) *
          (g (w + (eps : ℂ)) - g (w - (eps : ℂ)))) := by
  let p : ℂ := w + (eps : ℂ)
  let q : ℂ := w - (eps : ℂ)
  let R : ℂ → ℂ := fun z =>
    g z + (eps / 2 : ℂ) * dslope g p z -
      (eps / 2 : ℂ) * dslope g q z
  have hpU : p ∈ U := by
    apply hsub
    apply Complex.mem_reProdIm.mpr
    constructor
    · rw [Set.uIcc_of_le (hplus.1.trans hplus.2.1).le]
      exact ⟨hplus.1.le, hplus.2.1.le⟩
    · rw [Set.uIcc_of_le (hplus.2.2.1.trans hplus.2.2.2).le]
      exact ⟨hplus.2.2.1.le, hplus.2.2.2.le⟩
  have hqU : q ∈ U := by
    apply hsub
    apply Complex.mem_reProdIm.mpr
    constructor
    · rw [Set.uIcc_of_le (hminus.1.trans hminus.2.1).le]
      exact ⟨hminus.1.le, hminus.2.1.le⟩
    · rw [Set.uIcc_of_le (hminus.2.2.1.trans hminus.2.2.2).le]
      exact ⟨hminus.2.2.1.le, hminus.2.2.2.le⟩
  have hdp : AnalyticOnNhd ℂ (dslope g p) U := by
    intro z hz
    exact analyticAt_dslope_of_analyticAt (hg p hpU) (hg z hz)
  have hdq : AnalyticOnNhd ℂ (dslope g q) U := by
    intro z hz
    exact analyticAt_dslope_of_analyticAt (hg q hqU) (hg z hz)
  have hR : AnalyticOnNhd ℂ R U := by
    exact (hg.add (analyticOnNhd_const.mul hdp)).sub
      (analyticOnNhd_const.mul hdq)
  have hdecomp : ∀ z : ℂ, z ≠ p → z ≠ q →
      meromorphicCauchyPairKernel eps z w * g z =
        (0 : ℂ) * (z - q)⁻¹ ^ (2 : ℕ) +
          ((eps / 2 : ℂ) * g p * (z - p)⁻¹ +
            ((-(eps / 2 : ℂ) * g q) * (z - q)⁻¹ + R z)) := by
    intro z hzp hzq
    have hzp0 : z - p ≠ 0 := sub_ne_zero.mpr hzp
    have hzq0 : z - q ≠ 0 := sub_ne_zero.mpr hzq
    have hkminus : z - w - (eps : ℂ) ≠ 0 := by
      intro hzero
      apply hzp
      dsimp only [p]
      linear_combination hzero
    have hkplus : z - w + (eps : ℂ) ≠ 0 := by
      intro hzero
      apply hzq
      dsimp only [q]
      linear_combination hzero
    have hsp := sub_smul_dslope g p z
    have hsq := sub_smul_dslope g q z
    simp only [smul_eq_mul] at hsp hsq
    have hgp : g z = g p + (z - p) * dslope g p z := by
      calc
        g z = g p + (g z - g p) := by ring
        _ = g p + (z - p) * dslope g p z := by rw [hsp]
    have hgq : g z = g q + (z - q) * dslope g q z := by
      calc
        g z = g q + (g z - g q) := by ring
        _ = g q + (z - q) * dslope g q z := by rw [hsq]
    have hfracp : g z * (z - p)⁻¹ =
        g p * (z - p)⁻¹ + dslope g p z := by
      rw [hgp]
      field_simp [hzp0]
    have hfracq : g z * (z - q)⁻¹ =
        g q * (z - q)⁻¹ + dslope g q z := by
      rw [hgq]
      field_simp [hzq0]
    rw [meromorphicCauchyPairKernel_eq_resolventDifference
      eps z w hkminus hkplus]
    rw [show z - w - (eps : ℂ) = z - p by dsimp only [p]; ring,
      show z - w + (eps : ℂ) = z - q by dsimp only [q]; ring]
    simp only [zero_mul, zero_add]
    calc
      (1 + (eps / 2 : ℂ) * ((z - p)⁻¹ - (z - q)⁻¹)) * g z =
          g z + (eps / 2 : ℂ) * (g z * (z - p)⁻¹) -
            (eps / 2 : ℂ) * (g z * (z - q)⁻¹) := by ring
      _ = g z + (eps / 2 : ℂ) *
            (g p * (z - p)⁻¹ + dslope g p z) -
          (eps / 2 : ℂ) *
            (g q * (z - q)⁻¹ + dslope g q z) := by
        rw [hfracp, hfracq]
      _ = (eps / 2 : ℂ) * g p * (z - p)⁻¹ +
          (-(eps / 2 : ℂ) * g q * (z - q)⁻¹ + R z) := by
        dsimp only [R]
        ring
  have hres := rectIntegral_eq_confluent_two_pole_residues_of_analyticOnNhd
    (F := fun z => meromorphicCauchyPairKernel eps z w * g z)
    (R := R) (p := p) (q := q)
    (rp := (eps / 2 : ℂ) * g p) (dq := 0)
    (rq := -(eps / 2 : ℂ) * g q)
    hplus.1 hplus.2.1 hplus.2.2.1 hplus.2.2.2
    hminus.1 hminus.2.1 hminus.2.2.1 hminus.2.2.2
    hsub hR hdecomp
  dsimp only [p, q] at hres
  convert hres using 1
  all_goals ring

/-- Zero-free analytic cofactors satisfy the rational-kernel correction law with their literal
logarithmic derivative. -/
theorem rectIntegral_meromorphicCauchyPairKernel_mul_logDeriv_of_zeroFree
    {h : ℂ → ℂ} {eps : ℝ} {w z₁ z₂ : ℂ} {U : Set ℂ}
    (hh : AnalyticOnNhd ℂ h U) (hh0 : ∀ z ∈ U, h z ≠ 0)
    (hsub : (Set.uIcc z₁.re z₂.re ×ℂ Set.uIcc z₁.im z₂.im) ⊆ U)
    (hplus : z₁.re < (w + (eps : ℂ)).re ∧
      (w + (eps : ℂ)).re < z₂.re ∧
      z₁.im < (w + (eps : ℂ)).im ∧
      (w + (eps : ℂ)).im < z₂.im)
    (hminus : z₁.re < (w - (eps : ℂ)).re ∧
      (w - (eps : ℂ)).re < z₂.re ∧
      z₁.im < (w - (eps : ℂ)).im ∧
      (w - (eps : ℂ)).im < z₂.im) :
    rectIntegral
        (fun z => meromorphicCauchyPairKernel eps z w * logDeriv h z) z₁ z₂ =
      2 * Real.pi * I *
        ((eps / 2 : ℂ) *
          (logDeriv h (w + (eps : ℂ)) -
            logDeriv h (w - (eps : ℂ)))) := by
  have hlog : AnalyticOnNhd ℂ (logDeriv h) U := by
    intro z hz
    exact (hh.deriv z hz).div (hh z hz) (hh0 z hz)
  exact rectIntegral_meromorphicCauchyPairKernel_mul_of_analyticOnNhd
    hlog hsub hplus hminus

/-- At reciprocal displacement, the same cofactor contour is exactly the existing centered
logarithmic-derivative shift extractor. -/
theorem rectIntegral_meromorphicCauchyPairKernel_mul_logDeriv_eq_centeredExtractor
    {h : ℂ → ℂ} {w z₁ z₂ : ℂ} {U : Set ℂ} (n : ℕ)
    (hh : AnalyticOnNhd ℂ h U) (hh0 : ∀ z ∈ U, h z ≠ 0)
    (hsub : (Set.uIcc z₁.re z₂.re ×ℂ Set.uIcc z₁.im z₂.im) ⊆ U)
    (hplus : z₁.re < (w + ((1 / ((n : ℝ) + 1) : ℝ) : ℂ)).re ∧
      (w + ((1 / ((n : ℝ) + 1) : ℝ) : ℂ)).re < z₂.re ∧
      z₁.im < (w + ((1 / ((n : ℝ) + 1) : ℝ) : ℂ)).im ∧
      (w + ((1 / ((n : ℝ) + 1) : ℝ) : ℂ)).im < z₂.im)
    (hminus : z₁.re < (w - ((1 / ((n : ℝ) + 1) : ℝ) : ℂ)).re ∧
      (w - ((1 / ((n : ℝ) + 1) : ℝ) : ℂ)).re < z₂.re ∧
      z₁.im < (w - ((1 / ((n : ℝ) + 1) : ℝ) : ℂ)).im ∧
      (w - ((1 / ((n : ℝ) + 1) : ℝ) : ℂ)).im < z₂.im) :
    rectIntegral
        (fun z => meromorphicCauchyPairKernel
          (1 / ((n : ℝ) + 1)) z w * logDeriv h z) z₁ z₂ =
      2 * Real.pi * I * centeredLogDerivRealShiftExtractor h w n := by
  simpa only [centeredLogDerivRealShiftExtractor] using
    rectIntegral_meromorphicCauchyPairKernel_mul_logDeriv_of_zeroFree
      hh hh0 hsub hplus hminus

end

end RHTower
