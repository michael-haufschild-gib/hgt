import GaloisForLFunctions.RHTower.PrimeGammaCofinalBocksteinDeterminantTransgression
import GaloisForLFunctions.HTGeometry.ConstitutiveExchangeableFormationSelection

/-!
# Prime Gamma Bockstein as exchangeable-formation work

The two reflected physical Gamma determinants define two Fisher-dressed source laws at one
ordinary prime.  Their three-slot exchangeability defect is exactly one half of the square of the
Route-R Gamma Bockstein coefficient.  Independent formation depth therefore amplifies a
nonneutral Bockstein linearly, and uniformly bounded work is possible exactly at neutral grade.

This identifies the Route-R obstruction with a positive source-formation work density before any
Xi specialization or completion.  No divisor-location, recurrence, or RH hypothesis enters.
-/

namespace RHTower

noncomputable section

open GaloisForLFunctions.HTGeometry

/-- Fisher-dressed forward Gamma orientation, as a one-reporter source law. -/
def routeRPrimeGammaForwardFormationLaw (t : ℝ) (p : Nat.Primes) : Fin 1 → ℝ :=
  fun _ => primeActivationOccupancyFisherDensity p *
    primeGammaPhysicalRotationDeterminant t p

/-- Fisher-dressed reflected Gamma orientation, on the same prime reporter. -/
def routeRPrimeGammaReflectedFormationLaw (t : ℝ) (p : Nat.Primes) : Fin 1 → ℝ :=
  fun _ => primeActivationOccupancyFisherDensity p *
    primeGammaPhysicalRotationDeterminant (-t) p

/-- Three-slot exchange defect of the two physical Gamma orientations at one prime. -/
def routeRPrimeGammaFormationDefect (t : ℝ) (p : Nat.Primes) : ℝ :=
  finiteExchangeDefect
    (routeRPrimeGammaForwardFormationLaw t p)
    (routeRPrimeGammaReflectedFormationLaw t p)

/-- Work generated by `n` independent copies of the reflected Gamma formation experiment. -/
def routeRPrimeGammaFormationWork (n : ℕ) (t : ℝ) (p : Nat.Primes) : ℝ :=
  finiteExchangeWork n
    (routeRPrimeGammaForwardFormationLaw t p)
    (routeRPrimeGammaReflectedFormationLaw t p)

@[simp] theorem routeRPrimeGammaForwardFormationLaw_neg
    (t : ℝ) (p : Nat.Primes) :
    routeRPrimeGammaForwardFormationLaw (-t) p =
      routeRPrimeGammaReflectedFormationLaw t p := by
  funext i
  simp [routeRPrimeGammaForwardFormationLaw,
    routeRPrimeGammaReflectedFormationLaw]

@[simp] theorem routeRPrimeGammaReflectedFormationLaw_neg
    (t : ℝ) (p : Nat.Primes) :
    routeRPrimeGammaReflectedFormationLaw (-t) p =
      routeRPrimeGammaForwardFormationLaw t p := by
  funext i
  simp [routeRPrimeGammaForwardFormationLaw,
    routeRPrimeGammaReflectedFormationLaw]

/-- **Bockstein/work-density identity.** The positive three-slot formation defect is exactly the
square of the signed Route-R Gamma Bockstein, with universal factor `1 / 2`. -/
theorem routeRPrimeGammaFormationDefect_eq_bockstein_sq
    (t : ℝ) (p : Nat.Primes) :
    routeRPrimeGammaFormationDefect t p =
      primeGammaCofinalBocksteinCoefficient t p ^ 2 / 2 := by
  rw [primeGammaCofinalBocksteinCoefficient_eq_determinantTransgression]
  simp [routeRPrimeGammaFormationDefect, finiteExchangeDefect,
    threeSlotExchangeDefect_eq, routeRPrimeGammaForwardFormationLaw,
    routeRPrimeGammaReflectedFormationLaw]
  ring

/-- Functional-equation reflection preserves the positive formation defect while reversing its
signed Bockstein square root. -/
theorem routeRPrimeGammaFormationDefect_neg
    (t : ℝ) (p : Nat.Primes) :
    routeRPrimeGammaFormationDefect (-t) p =
      routeRPrimeGammaFormationDefect t p := by
  simp only [routeRPrimeGammaFormationDefect,
    routeRPrimeGammaForwardFormationLaw_neg,
    routeRPrimeGammaReflectedFormationLaw_neg,
    finiteExchangeDefect_swap]

/-- Exact extensive-work law: independent formation depth multiplies Bockstein energy linearly. -/
theorem routeRPrimeGammaFormationWork_eq_bockstein_sq
    (n : ℕ) (t : ℝ) (p : Nat.Primes) :
    routeRPrimeGammaFormationWork n t p =
      (n : ℝ) * (primeGammaCofinalBocksteinCoefficient t p ^ 2 / 2) := by
  rw [routeRPrimeGammaFormationWork, finiteExchangeWork,
    ← routeRPrimeGammaFormationDefect,
    routeRPrimeGammaFormationDefect_eq_bockstein_sq]

/-- Three-slot exchangeability of the reflected physical Gamma laws selects exactly neutral
horizontal grade. -/
theorem routeRPrimeGamma_threeSlotExchangeable_iff
    (t : ℝ) (p : Nat.Primes) :
    ThreeSlotExchangeable
        (routeRPrimeGammaForwardFormationLaw t p)
        (routeRPrimeGammaReflectedFormationLaw t p) ↔
      t = 0 := by
  rw [threeSlotExchangeable_iff]
  constructor
  · intro h
    apply (primeGammaCofinalBocksteinCoefficient_eq_zero_iff t p).mp
    have h0 := congrFun h (0 : Fin 1)
    rw [primeGammaCofinalBocksteinCoefficient_eq_determinantTransgression]
    calc
      primeActivationOccupancyFisherDensity p *
          (primeGammaPhysicalRotationDeterminant t p -
            primeGammaPhysicalRotationDeterminant (-t) p) =
          routeRPrimeGammaForwardFormationLaw t p 0 -
            routeRPrimeGammaReflectedFormationLaw t p 0 := by
              simp [routeRPrimeGammaForwardFormationLaw,
                routeRPrimeGammaReflectedFormationLaw]
              ring
      _ = 0 := by rw [h0, sub_self]
  · rintro rfl
    funext i
    simp [routeRPrimeGammaForwardFormationLaw,
      routeRPrimeGammaReflectedFormationLaw]

/-- **Finite-work critical selection.** Uniformly bounded reflected formation work across all
depths is possible exactly when the horizontal Gamma grade is neutral. -/
theorem routeRPrimeGammaFormationWork_bounded_iff
    (t : ℝ) (p : Nat.Primes) :
    (∃ C : ℝ, ∀ n : ℕ, routeRPrimeGammaFormationWork n t p ≤ C) ↔
      t = 0 := by
  simpa only [routeRPrimeGammaFormationWork] using
    (finiteExchangeWork_bounded_iff
      (routeRPrimeGammaForwardFormationLaw t p)
      (routeRPrimeGammaReflectedFormationLaw t p)).trans
        (by
          rw [← threeSlotExchangeable_iff]
          exact routeRPrimeGamma_threeSlotExchangeable_iff t p)

/-- Every nonneutral grade has unbounded source-formation work at every ordinary prime. -/
theorem routeRPrimeGammaFormationWork_unbounded_of_ne_zero
    {t : ℝ} (ht : t ≠ 0) (p : Nat.Primes) :
    ¬ ∃ C : ℝ, ∀ n : ℕ, routeRPrimeGammaFormationWork n t p ≤ C := by
  exact mt (routeRPrimeGammaFormationWork_bounded_iff t p).mp ht

end

end RHTower
