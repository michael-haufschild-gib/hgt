/-
The joint `{σ_p} × ∂_s` symmetry, at a pinned configuration, has exponent 2.

The q62 independence mechanism (`Bottcher/Q62.lean`) kills a relation by a **weight mismatch**:
a field automorphism `σ` fixes the base `G` and scales the target `F ↦ ζ·F` by a root of unity
`ζ` of **unbounded order** — the graded pieces vanish one weight at a time. Transposed to ξ, the
hope was that an off-line zero creates a defect the two constraints (functional equation,
Euler positivity) cannot match, because they are invariant under a group action of unbounded
weight. This module shows the group is too small.

At a pinned configuration — no Bohr flow, no analytic continuation across the wall — the only
divisor symmetries the two constraints supply are:

* `feEquiv` (`s ↦ 1 − s`), the **∂_s side** functional-equation involution (`xi (1 − s) = xi s`);
* `cjEquiv` (`s ↦ s̄`), the **{σ_p} side** reality of the real Dirichlet coefficients
  (`xi (s̄) = conj (xi s)`), the conjugation across the real axis.

Both are involutions, they commute, and the group they generate — the whole pinned joint symmetry
— is the Klein four-group, of **exponent 2** (`joint_symmetry_orderOf_le_two`). So it contains no
element of order exceeding `2` (`no_q62_unbounded_weight`): it cannot furnish the unbounded-order
weight the q62 mechanism requires. The one symmetry of unbounded order in the picture — the Kummer
deck group `ℤ/2^k` of the tower — acts around a zero with weight `exp(2πi·m/2^k)` equal to the
very multiplicity in question (`XiDeck`, `DeckMultiZero`), so using it is circular, not external.

External-and-base-fixing (the joint symmetry, exponent 2) and unbounded-order (the deck, but
tautological) are disjoint here; no single automorphism realizes both roles. The weight-mismatch
engine has nothing non-circular to run on. Together with the ∂_s-only Klein-four blindness
(`WeightMismatchRefutation`), the {σ_p}-only real-axis blindness (`LandauShadowNoGo`), and the
seam-equals-rung collapse (`SeamCongruence.seam_iff_rung`), the flow-free, non-Weil joint reading
is closed.
-/
import GaloisForLFunctions.RHTower.CertificateActivation

noncomputable section

namespace RHTower

open Complex

/-! ### §1 The two generators: `∂_s` functional equation and `{σ_p}` reality -/

/-- The `∂_s`-side symmetry `s ↦ 1 − s` — the functional-equation involution. -/
def feEquiv : Equiv.Perm ℂ := Function.Involutive.toPerm (fun z => 1 - z) (fun z => by ring)

/-- The `{σ_p}`-side symmetry `s ↦ s̄` — the reality of the real Dirichlet coefficients. -/
def cjEquiv : Equiv.Perm ℂ := Function.Involutive.toPerm (starRingEnd ℂ) Complex.conj_conj

theorem feEquiv_apply (z : ℂ) : feEquiv z = 1 - z := rfl
theorem cjEquiv_apply (z : ℂ) : cjEquiv z = (starRingEnd ℂ) z := rfl

theorem feEquiv_sq : feEquiv ^ 2 = 1 := by
  ext z; simp [feEquiv, pow_two, Equiv.Perm.mul_apply, Function.Involutive.toPerm]

theorem cjEquiv_sq : cjEquiv ^ 2 = 1 := by
  ext z; simp [cjEquiv, pow_two, Equiv.Perm.mul_apply, Function.Involutive.toPerm]

/-- The functional equation and the reality involution **commute** — the joint symmetry is
abelian, generated by two commuting involutions. -/
theorem feEquiv_cjEquiv_commute : Commute feEquiv cjEquiv := by
  show feEquiv * cjEquiv = cjEquiv * feEquiv
  ext z; simp [feEquiv, cjEquiv, Equiv.Perm.mul_apply, Function.Involutive.toPerm]

/-! ### §2 The pinned joint symmetry group has exponent 2 -/

/-- The pinned joint symmetry group: everything the two constraints generate at a fixed
configuration. -/
def jointSym : Subgroup (Equiv.Perm ℂ) :=
  Subgroup.closure ({feEquiv, cjEquiv} : Set (Equiv.Perm ℂ))

theorem feEquiv_mem : feEquiv ∈ jointSym :=
  Subgroup.subset_closure (by left; rfl)

theorem cjEquiv_mem : cjEquiv ∈ jointSym :=
  Subgroup.subset_closure (by right; rfl)

/-- The group is abelian: any two of its elements commute (they are words in two commuting
involutions). -/
theorem jointSym_commute : ∀ x ∈ jointSym, ∀ y ∈ jointSym, Commute x y := by
  intro x hx y hy
  induction hx, hy using Subgroup.closure_induction₂ with
  | mem a b ha hb =>
      rcases ha with h | h <;> subst h <;> rcases hb with h | h <;> subst h
      · exact Commute.refl _
      · exact feEquiv_cjEquiv_commute
      · exact feEquiv_cjEquiv_commute.symm
      · exact Commute.refl _
  | one_left x _ => exact Commute.one_left x
  | one_right x _ => exact Commute.one_right x
  | mul_left _ _ _ _ _ _ hab hbz => exact hab.mul_left hbz
  | mul_right _ _ _ _ _ _ hab hbz => exact hab.mul_right hbz
  | inv_left _ _ _ _ hab => exact hab.inv_left
  | inv_right _ _ _ _ hab => exact hab.inv_right

/-- **Every element of the pinned joint symmetry squares to the identity.**  Generated by two
commuting involutions, the group has exponent `2`. -/
theorem jointSym_sq : ∀ g ∈ jointSym, g ^ 2 = 1 := by
  intro g hg
  induction hg using Subgroup.closure_induction with
  | mem x hx => rcases hx with h | h <;> subst h <;> [exact feEquiv_sq; exact cjEquiv_sq]
  | one => simp
  | mul a b ha hb hpa hpb => rw [(jointSym_commute a ha b hb).mul_pow, hpa, hpb, mul_one]
  | inv a _ hpa => rw [inv_pow, hpa, inv_one]

/-- Every element of the pinned joint symmetry has order at most `2`. -/
theorem jointSym_orderOf_le_two (g : Equiv.Perm ℂ) (hg : g ∈ jointSym) : orderOf g ≤ 2 :=
  orderOf_le_of_pow_eq_one (by norm_num) (jointSym_sq g hg)

/-! ### §3 The group genuinely fixes ξ's divisor -/

/-- The functional-equation generator fixes the ξ-divisor. -/
theorem jointSym_feEquiv_order_invariant (z : ℂ) :
    analyticOrderAt xi (feEquiv z) = analyticOrderAt xi z := by
  rw [feEquiv_apply]; exact xi_orderAt_one_sub z

/-- The reality generator fixes the ξ-divisor. -/
theorem jointSym_cjEquiv_order_invariant (z : ℂ) :
    analyticOrderAt xi (cjEquiv z) = analyticOrderAt xi z := by
  rw [cjEquiv_apply]; exact xi_orderAt_conj z

/-- Their composite is the critical-line reflection `s ↦ 1 − s̄`, which also fixes the divisor —
the whole joint group acts on ξ's zeros. -/
theorem jointSym_feEquiv_cjEquiv_order_invariant (z : ℂ) :
    analyticOrderAt xi ((feEquiv * cjEquiv) z) = analyticOrderAt xi z := by
  have hval : (feEquiv * cjEquiv) z = lineReflection (1 / 2) z := by
    rw [Equiv.Perm.mul_apply, feEquiv_apply, cjEquiv_apply, lineReflection]; norm_num
  rw [hval]; exact xi_orderAt_lineReflection z

/-! ### §4 The kill: no unbounded-order weight -/

/-- **The q62 weight-mismatch engine cannot fire on the pinned joint reading.**  The mechanism
requires symmetries of unbounded order (`∀ d, ∃` symmetry of order `> d`); the pinned
`{σ_p} × ∂_s` group has exponent `2`, so no such symmetry exists.  Taking `d = 2` already fails.

The only symmetry of unbounded order available is the Kummer deck group `ℤ/2^k`, whose weight
around a zero is `exp(2πi·m/2^k)` — the multiplicity itself; using it is circular, not the
external base-fixing automorphism the mechanism needs.  External-and-base-fixing and
unbounded-order are disjoint here. -/
theorem no_q62_unbounded_weight :
    ¬ ∀ d : ℕ, ∃ g ∈ jointSym, d < orderOf g := by
  intro h
  obtain ⟨g, hg, hgd⟩ := h 2
  exact absurd (jointSym_orderOf_le_two g hg) (not_le.mpr hgd)

/-- Stated at the single element the mechanism would need: no element of the pinned joint symmetry
scales anything by a root of unity of order `> 2`. -/
theorem jointSym_no_high_order (g : Equiv.Perm ℂ) (hg : g ∈ jointSym) : ¬ 2 < orderOf g :=
  not_lt.mpr (jointSym_orderOf_le_two g hg)

end RHTower
