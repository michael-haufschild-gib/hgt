import GaloisForLFunctions.RHTower.FieldOneGlobalAdeleComparison
import Mathlib.GroupTheory.QuotientGroup.Basic
import Mathlib.Topology.Algebra.Group.Quotient

/-!
# Finite-stage rational adelic class spaces

For a finite set `S` of finite places of `ℚ`, this file constructs the algebraic objects
appearing in the finite-stage Connes--Consani semilocal trace model:

* the additive ring `A_S = ℝ × ∏_{v ∈ S} ℚ_v`;
* its explicitly coordinatewise idele group;
* the rational `S`-unit subgroup generated by `-1` and the primes in `S`;
* the diagonal image of that subgroup in the finite-stage ideles;
* the orbit class space `ℤ_Sˣ \ A_S`;
* the semilocal idele class group; and
* its well-defined multiplicative scaling action on the class space.

The action is proved by first descending the full idele action through the orbit relation,
then proving that the diagonal `S`-unit image is contained in its kernel.  The resulting action
therefore factors through the quotient idele class group.

This is an algebraic construction.  It does not yet equip the orbit quotient with a quotient
measure, identify an `L²` trace Hilbert space, construct restriction maps as `S` varies, or
construct the characteristic-one sheaf and its cohomology.
-/

namespace GaloisForLFunctions.RHTower

noncomputable section

open IsDedekindDomain

/-- Additive rational adelic ring at the infinite place and a finite set `S` of finite places. -/
abbrev FieldOneFiniteStageAdele
    (S : Finset (HeightOneSpectrum ℤ)) :=
  ℝ × ((v : ↥S) → v.1.adicCompletion ℚ)

/-- Explicit coordinatewise idele group of `FieldOneFiniteStageAdele S`. -/
abbrev FieldOneFiniteStageIdele
    (S : Finset (HeightOneSpectrum ℤ)) :=
  ℝˣ × ((v : ↥S) → (v.1.adicCompletion ℚ)ˣ)

/-- A nonzero rational maps to its real component as a unit. -/
def fieldOneRationalRealUnit : ℚˣ →* ℝˣ :=
  Units.map (Rat.castHom ℝ)

/-- A nonzero rational maps to its component at the finite place `v` as a unit. -/
def fieldOneRationalLocalUnit
    (v : HeightOneSpectrum ℤ) :
    ℚˣ →* (v.adicCompletion ℚ)ˣ :=
  Units.map (algebraMap ℚ (v.adicCompletion ℚ))

/-- Coordinatewise finite-place unit map for a finite set `S`. -/
def fieldOneRationalFiniteStageUnit
    (S : Finset (HeightOneSpectrum ℤ)) :
    ℚˣ →* (((v : ↥S) → v.1.adicCompletion ℚ)ˣ) :=
  MulEquiv.piUnits.symm.toMonoidHom.comp
    { toFun := fun u v =>
        fieldOneRationalLocalUnit v.1 u
      map_one' := by
        funext v
        exact map_one (fieldOneRationalLocalUnit v.1)
      map_mul' := by
        intro x y
        funext v
        exact map_mul (fieldOneRationalLocalUnit v.1) x y }

/-- Diagonal embedding of rational units into finite-stage ideles. -/
def fieldOneFiniteStageDiagonalUnit
    (S : Finset (HeightOneSpectrum ℤ)) :
    ℚˣ →* FieldOneFiniteStageIdele S :=
  fieldOneRationalRealUnit.prod
    (MulEquiv.piUnits.toMonoidHom.comp
      (fieldOneRationalFiniteStageUnit S))

/-- Rational prime unit associated to a finite place. -/
def fieldOneRationalPrimeUnit
    (v : HeightOneSpectrum ℤ) : ℚˣ :=
  Units.mk0
    (Rat.HeightOneSpectrum.primesEquiv v : ℚ)
    (by
      exact_mod_cast
        (Rat.HeightOneSpectrum.primesEquiv v).property.ne_zero)

/-- Rational `S`-unit subgroup, presented by its standard generators `-1` and the primes in `S`. -/
def fieldOneSUnitSubgroup
    (S : Finset (HeightOneSpectrum ℤ)) : Subgroup ℚˣ :=
  Subgroup.closure
    (Set.insert (-1)
      (Set.range fun v : ↥S =>
        fieldOneRationalPrimeUnit v.1))

/-- The sign unit is a rational `S`-unit. -/
theorem fieldOne_negOne_mem_sUnitSubgroup
    (S : Finset (HeightOneSpectrum ℤ)) :
    (-1 : ℚˣ) ∈ fieldOneSUnitSubgroup S :=
  Subgroup.subset_closure (Set.mem_insert _ _)

/-- Every prime selected by `S` is a rational `S`-unit. -/
theorem fieldOne_prime_mem_sUnitSubgroup
    (S : Finset (HeightOneSpectrum ℤ))
    (v : ↥S) :
    fieldOneRationalPrimeUnit v.1 ∈ fieldOneSUnitSubgroup S := by
  apply Subgroup.subset_closure
  exact Set.mem_insert_iff.mpr (Or.inr ⟨v, rfl⟩)

/-- Diagonal image of rational `S`-units in finite-stage ideles. -/
def fieldOneFiniteStageSUnitImage
    (S : Finset (HeightOneSpectrum ℤ)) :
    Subgroup (FieldOneFiniteStageIdele S) :=
  Subgroup.map
    (fieldOneFiniteStageDiagonalUnit S)
    (fieldOneSUnitSubgroup S)

/-- The diagonal unit embedding is injective; the real coordinate already detects a rational. -/
theorem fieldOneFiniteStageDiagonalUnit_injective
    (S : Finset (HeightOneSpectrum ℤ)) :
    Function.Injective (fieldOneFiniteStageDiagonalUnit S) := by
  intro x y h
  apply Units.ext
  have hreal :=
    congrArg
      (fun u : FieldOneFiniteStageIdele S => (u.1 : ℝ))
      h
  change ((x : ℚ) : ℝ) = ((y : ℚ) : ℝ) at hreal
  exact_mod_cast hreal

/-- A rational `S`-unit maps into the diagonal `S`-unit image. -/
theorem fieldOneFiniteStageDiagonalUnit_mem_sUnitImage
    (S : Finset (HeightOneSpectrum ℤ))
    (u : fieldOneSUnitSubgroup S) :
    fieldOneFiniteStageDiagonalUnit S u ∈
      fieldOneFiniteStageSUnitImage S :=
  ⟨u, u.property, rfl⟩

/-- Coordinatewise multiplicative scaling of the finite-stage additive adelic ring. -/
instance fieldOneFiniteStageIdeleSMul
    (S : Finset (HeightOneSpectrum ℤ)) :
    SMul (FieldOneFiniteStageIdele S)
      (FieldOneFiniteStageAdele S) where
  smul u x :=
    (u.1 • x.1, fun v => u.2 v • x.2 v)

/-- Coordinatewise scaling is a group action. -/
instance fieldOneFiniteStageIdeleMulAction
    (S : Finset (HeightOneSpectrum ℤ)) :
    MulAction (FieldOneFiniteStageIdele S)
      (FieldOneFiniteStageAdele S) where
  one_smul x := by
    apply Prod.ext
    · exact one_smul ℝˣ x.1
    · funext v
      exact one_smul (v.1.adicCompletion ℚ)ˣ (x.2 v)
  mul_smul u w x := by
    apply Prod.ext
    · exact mul_smul u.1 w.1 x.1
    · funext v
      exact mul_smul (u.2 v) (w.2 v) (x.2 v)

/-- Finite-stage ideles commute coordinatewise. -/
instance fieldOneFiniteStageIdeleIsMulCommutative
    (S : Finset (HeightOneSpectrum ℤ)) :
    IsMulCommutative (FieldOneFiniteStageIdele S) :=
  IsMulCommutative.of_comm fun u w => by
    apply Prod.ext
    · apply Units.ext
      exact mul_comm (u.1 : ℝ) (w.1 : ℝ)
    · funext v
      apply Units.ext
      exact mul_comm
        (u.2 v : v.1.adicCompletion ℚ)
        (w.2 v : v.1.adicCompletion ℚ)

/-- The diagonal `S`-unit image is normal in the commutative finite-stage idele group. -/
instance fieldOneFiniteStageSUnitImageNormal
    (S : Finset (HeightOneSpectrum ℤ)) :
    (fieldOneFiniteStageSUnitImage S).Normal :=
  Subgroup.normal_of_isMulCommutative
    (fieldOneFiniteStageSUnitImage S)

/-- Orbit quotient `ℤ_Sˣ \ A_S` of the additive finite-stage adelic ring. -/
abbrev FieldOneFiniteStageClassSpace
    (S : Finset (HeightOneSpectrum ℤ)) :=
  Quotient
    (MulAction.orbitRel
      (fieldOneFiniteStageSUnitImage S)
      (FieldOneFiniteStageAdele S))

/-- Finite-stage idele class group modulo diagonal rational `S`-units. -/
abbrev FieldOneFiniteStageIdeleClassGroup
    (S : Finset (HeightOneSpectrum ℤ)) :=
  FieldOneFiniteStageIdele S ⧸
    fieldOneFiniteStageSUnitImage S

/-- Scaling by a finite-stage idele preserves diagonal `S`-unit orbits. -/
def fieldOneFiniteStageIdeleClassAction
    (S : Finset (HeightOneSpectrum ℤ))
    (u : FieldOneFiniteStageIdele S) :
    FieldOneFiniteStageClassSpace S →
      FieldOneFiniteStageClassSpace S :=
  Quotient.map (fun x => u • x) (by
    intro a b hab
    change
      MulAction.orbitRel
        (fieldOneFiniteStageSUnitImage S)
        (FieldOneFiniteStageAdele S) a b at hab
    change
      MulAction.orbitRel
        (fieldOneFiniteStageSUnitImage S)
        (FieldOneFiniteStageAdele S)
        (u • a) (u • b)
    rw [MulAction.orbitRel_apply] at hab ⊢
    rw [MulAction.mem_orbit_iff] at hab ⊢
    obtain ⟨h, rfl⟩ := hab
    refine ⟨h, ?_⟩
    simp only [MulAction.subgroup_smul_def]
    rw [← mul_smul, ← mul_smul, mul_comm'])

/-- Full finite-stage ideles act on the diagonal `S`-unit orbit quotient. -/
instance fieldOneFiniteStageIdeleClassMulAction
    (S : Finset (HeightOneSpectrum ℤ)) :
    MulAction (FieldOneFiniteStageIdele S)
      (FieldOneFiniteStageClassSpace S) where
  smul := fieldOneFiniteStageIdeleClassAction S
  one_smul x := by
    refine Quotient.inductionOn x ?_
    intro a
    change
      Quotient.mk _ ((1 : FieldOneFiniteStageIdele S) • a) =
        Quotient.mk _ a
    rw [one_smul]
  mul_smul u w x := by
    refine Quotient.inductionOn x ?_
    intro a
    change
      Quotient.mk _ ((u * w) • a) =
        Quotient.mk _ (u • w • a)
    rw [mul_smul]

/-- Every diagonal `S`-unit acts trivially on its orbit quotient. -/
theorem fieldOneFiniteStageSUnitImage_smul_class
    (S : Finset (HeightOneSpectrum ℤ))
    (h : fieldOneFiniteStageSUnitImage S)
    (x : FieldOneFiniteStageClassSpace S) :
    (h : FieldOneFiniteStageIdele S) • x = x := by
  refine Quotient.inductionOn x ?_
  intro a
  change
    Quotient.mk _ ((h : FieldOneFiniteStageIdele S) • a) =
      Quotient.mk _ a
  apply Quotient.sound
  change
    MulAction.orbitRel
      (fieldOneFiniteStageSUnitImage S)
      (FieldOneFiniteStageAdele S)
      ((h : FieldOneFiniteStageIdele S) • a) a
  rw [MulAction.orbitRel_apply, MulAction.mem_orbit_iff]
  exact ⟨h, rfl⟩

/-- The diagonal `S`-unit image lies in the kernel of the orbit action. -/
theorem fieldOneFiniteStageSUnitImage_le_actionKernel
    (S : Finset (HeightOneSpectrum ℤ)) :
    fieldOneFiniteStageSUnitImage S ≤
      (MulAction.toPermHom
        (FieldOneFiniteStageIdele S)
        (FieldOneFiniteStageClassSpace S)).ker := by
  intro u hu
  rw [MonoidHom.mem_ker]
  apply Equiv.ext
  intro x
  change u • x = x
  exact
    fieldOneFiniteStageSUnitImage_smul_class S ⟨u, hu⟩ x

/-- Permutation representation of the finite-stage idele class group on the class space. -/
def fieldOneFiniteStageIdeleClassPermHom
    (S : Finset (HeightOneSpectrum ℤ)) :
    FieldOneFiniteStageIdeleClassGroup S →*
      Equiv.Perm (FieldOneFiniteStageClassSpace S) :=
  QuotientGroup.lift
    (fieldOneFiniteStageSUnitImage S)
    (MulAction.toPermHom
      (FieldOneFiniteStageIdele S)
      (FieldOneFiniteStageClassSpace S))
    (fieldOneFiniteStageSUnitImage_le_actionKernel S)

/-- Multiplicative scaling action of finite-stage idele classes on `ℤ_Sˣ \ A_S`. -/
instance fieldOneFiniteStageIdeleClassGroupMulAction
    (S : Finset (HeightOneSpectrum ℤ)) :
    MulAction (FieldOneFiniteStageIdeleClassGroup S)
      (FieldOneFiniteStageClassSpace S) where
  smul c x :=
    fieldOneFiniteStageIdeleClassPermHom S c x
  one_smul x := by
    change
      fieldOneFiniteStageIdeleClassPermHom S
        (1 : FieldOneFiniteStageIdeleClassGroup S) x = x
    rw [map_one]
    rfl
  mul_smul c d x := by
    change
      fieldOneFiniteStageIdeleClassPermHom S (c * d) x =
        fieldOneFiniteStageIdeleClassPermHom S c
          (fieldOneFiniteStageIdeleClassPermHom S d x)
    rw [map_mul]
    rfl

/-- Scaling by a represented idele class agrees with scaling by its representative. -/
theorem fieldOneFiniteStageIdeleClassGroup_mk_smul
    (S : Finset (HeightOneSpectrum ℤ))
    (u : FieldOneFiniteStageIdele S)
    (x : FieldOneFiniteStageClassSpace S) :
    (QuotientGroup.mk' (fieldOneFiniteStageSUnitImage S) u :
        FieldOneFiniteStageIdeleClassGroup S) • x =
      u • x := by
  rfl

end

end GaloisForLFunctions.RHTower
