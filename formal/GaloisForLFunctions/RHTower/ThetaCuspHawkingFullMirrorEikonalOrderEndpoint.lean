import GaloisForLFunctions.RHTower.ThetaCuspHawkingTiltedMirrorOpticalTheoremEndpoint
import GaloisForLFunctions.RHTower.ThetaCuspKernelLogConcavity
import Mathlib.Analysis.SpecialFunctions.Trigonometric.Bounds

/-!
# Full theta-mirror eikonal scattering and coupling-order hierarchy

For the genuine tilted trajectory `p(v) = v + lambda * k_a(v)`, this file evaluates the complete
inertial-subtracted Davies--Fulling numerator. Integration by parts gives its exact
nonperturbative normal form

`M = -2 * incoming * Fourier (exp (-i * lambda * outgoing * k_a) - 1)`.

This is an eikonal Fourier scattering law, not a sectorwise scalar Cayley transform. Its coupling
jets are Fourier moments of positive powers of `k_a`. Strict log-concavity and Schwartz decay make
`k_a` strictly unimodal; peak concentration proves every fixed tilted frequency has nonzero
moments at all sufficiently high orders. Thus all-order sector coupling is unconditional. RH is
exactly stronger principal-order law: every noncentral sector couples through first moment
`XiC (w + a*I)`.
-/

open Complex Real MeasureTheory
open scoped FourierTransform SchwartzMap


noncomputable section

namespace RHTower

/-- Inertial-subtracted nonlinear phase generated by tilted theta-cusp trajectory. -/
def thetaCuspHawkingEikonalPhaseDefect (a t v : ℝ) : ℂ :=
  Complex.exp (Complex.I * ((-t * thetaCuspTiltedSource a v : ℝ) : ℂ)) - 1

private theorem thetaCuspHawkingEikonalPhaseDefect_integrable
    (a : ℝ) (ha : |a| < 1) (t : ℝ) :
    Integrable (thetaCuspHawkingEikonalPhaseDefect a t) := by
  let source : 𝓢(ℝ, ℂ) := thetaCuspTiltedSchwartz a ha
  have hmajor : Integrable (fun v : ℝ => ((|t| : ℝ) : ℂ) * source v) :=
    source.integrable.const_mul ((|t| : ℝ) : ℂ)
  apply Integrable.mono hmajor
  · apply Continuous.aestronglyMeasurable
    have hg : Continuous thetaCuspFullSource := contDiff_thetaCuspFullSource.continuous
    unfold thetaCuspHawkingEikonalPhaseDefect thetaCuspTiltedSource
    fun_prop
  · filter_upwards with v
    have h := Real.norm_exp_I_mul_ofReal_sub_one_le
      (x := -t * thetaCuspTiltedSource a v)
    rw [Real.norm_eq_abs, abs_mul, abs_neg] at h
    have hkpos : 0 < thetaCuspTiltedSource a v := by
      unfold thetaCuspTiltedSource
      exact mul_pos (Real.exp_pos _) (thetaCuspFullSource_pos_all _)
    rw [abs_of_pos hkpos] at h
    have hsourceNorm : ‖source v‖ = thetaCuspTiltedSource a v := by
      rw [show source v = ((thetaCuspTiltedSource a v : ℝ) : ℂ) by rfl,
        Complex.norm_real, Real.norm_eq_abs, abs_of_pos hkpos]
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_abs, hsourceNorm]
    simpa [thetaCuspHawkingEikonalPhaseDefect] using h

private theorem hasDerivAt_thetaCuspHawkingEikonalPhaseDefect (a t v : ℝ) :
    HasDerivAt (thetaCuspHawkingEikonalPhaseDefect a t)
      (Complex.exp (Complex.I * ((-t * thetaCuspTiltedSource a v : ℝ) : ℂ)) *
        (Complex.I * ((-t * deriv (thetaCuspTiltedSource a) v : ℝ) : ℂ))) v := by
  have hk : HasDerivAt (thetaCuspTiltedSource a)
      (deriv (thetaCuspTiltedSource a) v) v :=
    ((contDiff_thetaCuspTiltedSource a).differentiable
      (by simp)).differentiableAt.hasDerivAt
  have hr := (hk.const_mul (-t)).ofReal_comp
  have hphase := (hr.const_mul Complex.I).cexp
  change HasDerivAt
    (fun x : ℝ => Complex.exp
      (Complex.I * ((-t * thetaCuspTiltedSource a x : ℝ) : ℂ)) - 1) _ v
  convert hphase.sub_const 1 using 1 <;> ring

private theorem thetaCuspHawkingEikonalPhaseDefect_differentiable (a t : ℝ) :
    Differentiable ℝ (thetaCuspHawkingEikonalPhaseDefect a t) :=
  fun v => (hasDerivAt_thetaCuspHawkingEikonalPhaseDefect a t v).differentiableAt

private theorem thetaCuspHawkingEikonalPhaseDefect_deriv_eq (a t v : ℝ) :
    deriv (thetaCuspHawkingEikonalPhaseDefect a t) v =
      Complex.exp (Complex.I * ((-t * thetaCuspTiltedSource a v : ℝ) : ℂ)) *
        (Complex.I * ((-t * deriv (thetaCuspTiltedSource a) v : ℝ) : ℂ)) :=
  (hasDerivAt_thetaCuspHawkingEikonalPhaseDefect a t v).deriv

private theorem thetaCuspHawkingEikonalPhaseDefect_deriv_integrable
    (a : ℝ) (ha : |a| < 1) (t : ℝ) :
    Integrable (deriv (thetaCuspHawkingEikonalPhaseDefect a t)) := by
  let source : 𝓢(ℝ, ℝ) := thetaCuspTiltedSchwartzReal a ha
  let sourceDeriv : 𝓢(ℝ, ℝ) := SchwartzMap.derivCLM ℝ ℝ source
  have hmajor : Integrable (fun v : ℝ => |t| * sourceDeriv v) :=
    sourceDeriv.integrable.const_mul |t|
  apply Integrable.mono hmajor
  · apply Continuous.aestronglyMeasurable
    rw [show deriv (thetaCuspHawkingEikonalPhaseDefect a t) = fun v =>
        Complex.exp (Complex.I * ((-t * thetaCuspTiltedSource a v : ℝ) : ℂ)) *
          (Complex.I * ((-t * deriv (thetaCuspTiltedSource a) v : ℝ) : ℂ)) by
      funext v
      exact thetaCuspHawkingEikonalPhaseDefect_deriv_eq a t v]
    have hk : Continuous (thetaCuspTiltedSource a) :=
      (contDiff_thetaCuspTiltedSource a).continuous
    have hk' : Continuous (deriv (thetaCuspTiltedSource a)) :=
      (contDiff_thetaCuspTiltedSource a).continuous_deriv (by simp)
    fun_prop
  · filter_upwards with v
    rw [thetaCuspHawkingEikonalPhaseDefect_deriv_eq, norm_mul, Complex.norm_exp]
    have him : (Complex.I * ((-t * thetaCuspTiltedSource a v : ℝ) : ℂ)).re = 0 := by simp
    rw [him, Real.exp_zero, one_mul, norm_mul, norm_I, one_mul,
      Complex.norm_real, Real.norm_eq_abs, abs_mul, abs_neg]
    change |t| * |deriv (thetaCuspTiltedSource a) v| ≤
      ‖|t| * sourceDeriv v‖
    rw [norm_mul, Real.norm_eq_abs, abs_abs]
    have hsource : (source : ℝ → ℝ) = thetaCuspTiltedSource a := rfl
    rw [← hsource]
    simp [sourceDeriv, Real.norm_eq_abs]

/-- Inertial-subtracted Davies--Fulling numerator integrand for tilted trajectory. -/
def thetaCuspHawkingFullMirrorIntegrand
    (a lambda outgoing incoming v : ℝ) : ℂ :=
  let k := thetaCuspTiltedSource a v
  let k' := deriv (thetaCuspTiltedSource a) v
  let total := incoming + outgoing
  Complex.exp (((-total * v : ℝ) : ℂ) * Complex.I) *
    (Complex.exp (Complex.I * ((-lambda * outgoing * k : ℝ) : ℂ)) *
        (((outgoing - incoming : ℝ) : ℂ) +
          ((lambda * outgoing * k' : ℝ) : ℂ)) -
      ((outgoing - incoming : ℝ) : ℂ))

/-- Complete nonlinear pair-scattering numerator. -/
def thetaCuspHawkingFullMirrorAmplitude (a lambda outgoing incoming : ℝ) : ℂ :=
  ∫ v : ℝ, thetaCuspHawkingFullMirrorIntegrand a lambda outgoing incoming v

/-- Fourier channel of full eikonal phase defect at physical total frequency. -/
def thetaCuspHawkingEikonalFourier (a t total : ℝ) : ℂ :=
  FourierTransform.fourier (thetaCuspHawkingEikonalPhaseDefect a t) (total / (2 * Real.pi))

private theorem thetaCuspHawkingFullMirrorIntegrand_eq
    (a lambda outgoing incoming v : ℝ) :
    thetaCuspHawkingFullMirrorIntegrand a lambda outgoing incoming v =
      Complex.exp (((-(incoming + outgoing) * v : ℝ) : ℂ) * Complex.I) *
        ((((outgoing - incoming : ℝ) : ℂ) *
            thetaCuspHawkingEikonalPhaseDefect a (lambda * outgoing) v) +
          Complex.I * deriv (thetaCuspHawkingEikonalPhaseDefect a (lambda * outgoing)) v) := by
  rw [thetaCuspHawkingEikonalPhaseDefect_deriv_eq]
  unfold thetaCuspHawkingFullMirrorIntegrand thetaCuspHawkingEikonalPhaseDefect
  dsimp only
  push_cast
  ring_nf
  rw [Complex.I_sq]
  ring

/-- Exact nonperturbative source-faithful scattering normal form. -/
theorem thetaCuspHawkingFullMirrorAmplitude_eq_eikonalFourier
    (a : ℝ) (ha : |a| < 1) (lambda outgoing incoming : ℝ) :
    thetaCuspHawkingFullMirrorAmplitude a lambda outgoing incoming =
      (-2 * incoming : ℝ) *
        thetaCuspHawkingEikonalFourier a (lambda * outgoing) (incoming + outgoing) := by
  let t := lambda * outgoing
  let total := incoming + outgoing
  let h := thetaCuspHawkingEikonalPhaseDefect a t
  let oscillation : ℝ → ℂ := fun v =>
    Complex.exp (((-total * v : ℝ) : ℂ) * Complex.I)
  have hh : Integrable h := thetaCuspHawkingEikonalPhaseDefect_integrable a ha t
  have hh' : Integrable (deriv h) := thetaCuspHawkingEikonalPhaseDefect_deriv_integrable a ha t
  have hosc : Continuous oscillation := by
    dsimp [oscillation]
    fun_prop
  have hoscNorm : ∀ v, ‖oscillation v‖ = 1 := by
    intro v
    dsimp [oscillation]
    rw [Complex.norm_exp]
    simp
  have hfirst : Integrable (fun v : ℝ => oscillation v *
      (((outgoing - incoming : ℝ) : ℂ) * h v)) :=
    (hh.const_mul ((outgoing - incoming : ℝ) : ℂ)).bdd_mul
      hosc.aestronglyMeasurable (Filter.Eventually.of_forall fun v => by
        rw [hoscNorm])
  have hsecond : Integrable (fun v : ℝ => oscillation v *
      (Complex.I * deriv h v)) :=
    (hh'.const_mul Complex.I).bdd_mul
      hosc.aestronglyMeasurable (Filter.Eventually.of_forall fun v => by
        rw [hoscNorm])
  have hFourier := congrFun
    (Real.fourier_deriv hh (thetaCuspHawkingEikonalPhaseDefect_differentiable a t) hh')
      (total / (2 * Real.pi))
  have hscale : 2 * (Real.pi : ℂ) * Complex.I *
      ((total / (2 * Real.pi) : ℝ) : ℂ) = Complex.I * (total : ℂ) := by
    push_cast
    field_simp [Real.pi_ne_zero]
  have hFourier' : FourierTransform.fourier (deriv h)
      (total / (2 * Real.pi)) =
      (Complex.I * (total : ℂ)) *
        FourierTransform.fourier h (total / (2 * Real.pi)) := by
    simpa only [smul_eq_mul, hscale] using hFourier
  have hphase :
      (∫ v : ℝ, oscillation v * h v) =
        FourierTransform.fourier h (total / (2 * Real.pi)) := by
    rw [Real.fourier_real_eq_integral_exp_smul]
    apply integral_congr_ae
    filter_upwards with v
    simp only [smul_eq_mul]
    congr 2
    dsimp [oscillation]
    congr 1
    push_cast
    field_simp [Real.pi_ne_zero]
  have hphaseDeriv :
      (∫ v : ℝ, oscillation v * deriv h v) =
        FourierTransform.fourier (deriv h) (total / (2 * Real.pi)) := by
    rw [Real.fourier_real_eq_integral_exp_smul]
    apply integral_congr_ae
    filter_upwards with v
    simp only [smul_eq_mul]
    congr 2
    dsimp [oscillation]
    congr 1
    push_cast
    field_simp [Real.pi_ne_zero]
  rw [thetaCuspHawkingFullMirrorAmplitude]
  calc
    (∫ v : ℝ, thetaCuspHawkingFullMirrorIntegrand a lambda outgoing incoming v) =
        ∫ v : ℝ, oscillation v *
          ((((outgoing - incoming : ℝ) : ℂ) * h v) +
            Complex.I * deriv h v) := by
      apply integral_congr_ae
      filter_upwards with v
      simpa [oscillation, h, t, total] using
        thetaCuspHawkingFullMirrorIntegrand_eq a lambda outgoing incoming v
    _ = (∫ v : ℝ, oscillation v *
          (((outgoing - incoming : ℝ) : ℂ) * h v)) +
        ∫ v : ℝ, oscillation v * (Complex.I * deriv h v) := by
      rw [← integral_add hfirst hsecond]
      apply integral_congr_ae
      filter_upwards with v
      ring
    _ = ((outgoing - incoming : ℝ) : ℂ) *
          (∫ v : ℝ, oscillation v * h v) +
        Complex.I * (∫ v : ℝ, oscillation v * deriv h v) := by
      rw [← integral_const_mul, ← integral_const_mul]
      apply congrArg₂ (· + ·)
      · apply integral_congr_ae
        filter_upwards with v
        ring
      · apply integral_congr_ae
        filter_upwards with v
        ring
    _ = ((outgoing - incoming : ℝ) : ℂ) *
          FourierTransform.fourier h (total / (2 * Real.pi)) +
        Complex.I * FourierTransform.fourier (deriv h)
          (total / (2 * Real.pi)) := by rw [hphase, hphaseDeriv]
    _ = ((outgoing - incoming : ℝ) : ℂ) *
          FourierTransform.fourier h (total / (2 * Real.pi)) +
        Complex.I * ((Complex.I * (total : ℂ)) *
          FourierTransform.fourier h (total / (2 * Real.pi))) := by rw [hFourier']
    _ = (-2 * incoming : ℝ) * thetaCuspHawkingEikonalFourier a t total := by
      rw [thetaCuspHawkingEikonalFourier]
      dsimp [h, total]
      push_cast
      rw [← mul_assoc,
        ← mul_assoc Complex.I Complex.I
          ((incoming : ℂ) + (outgoing : ℂ)), Complex.I_mul_I]
      ring
    _ = (-2 * incoming : ℝ) *
        thetaCuspHawkingEikonalFourier a (lambda * outgoing) (incoming + outgoing) := rfl

private def thetaCuspTiltedLogSource (a x : ℝ) : ℝ :=
  a * x + thetaCuspLogSource x

private theorem exp_tiltedLogSource (a x : ℝ) :
    Real.exp (thetaCuspTiltedLogSource a x) = thetaCuspTiltedSource a x := by
  rw [thetaCuspTiltedLogSource, Real.exp_add, thetaCuspLogSource, thetaCuspTiltedSource,
    Real.exp_log (thetaCuspFullSource_pos_all x)]

private theorem deriv_tiltedLogSource (a x : ℝ) :
    deriv (thetaCuspTiltedLogSource a) x = a + deriv thetaCuspLogSource x := by
  have hlinear : HasDerivAt (fun y : ℝ => a * y) a x := by
    simpa using (hasDerivAt_id x).const_mul a
  have hlog : HasDerivAt thetaCuspLogSource (deriv thetaCuspLogSource x) x := by
    have h := hasDerivAt_thetaCuspLogSource x
    convert h using 1
    exact h.deriv
  exact (hlinear.add hlog).deriv

private theorem strictAnti_deriv_tiltedLogSource (a : ℝ) :
    StrictAnti (deriv (thetaCuspTiltedLogSource a)) := by
  have hanti : StrictAnti (deriv thetaCuspLogSource) :=
    strictAntiOn_univ.mp <|
      strictConcaveOn_thetaCuspLogSource.strictAntiOn_deriv fun x _ =>
        (hasDerivAt_thetaCuspLogSource x).differentiableAt
  intro x y hxy
  rw [deriv_tiltedLogSource, deriv_tiltedLogSource]
  simpa [add_comm] using add_lt_add_left (hanti hxy) a

private theorem exists_tiltedSource_globalPeak
    (a : ℝ) (ha : |a| < 1) :
    ∃ x0 : ℝ, ∀ x : ℝ,
      thetaCuspTiltedSource a x ≤ thetaCuspTiltedSource a x0 := by
  let source : 𝓢(ℝ, ℝ) := thetaCuspTiltedSchwartzReal a ha
  have hzero : 0 < thetaCuspTiltedSource a 0 := by
    unfold thetaCuspTiltedSource
    simpa using thetaCuspFullSource_pos_all 0
  obtain ⟨r, hr⟩ := ZeroAtInftyContinuousMapClass.norm_le source
    (thetaCuspTiltedSource a 0) hzero
  let R : ℝ := |r| + 1
  have hR : 0 < R := by dsimp [R]; linarith [abs_nonneg r]
  have hcont : Continuous (thetaCuspTiltedSource a) :=
    (contDiff_thetaCuspTiltedSource a).continuous
  obtain ⟨x0, hx0, hmax⟩ := isCompact_Icc.exists_isMaxOn
    (Set.nonempty_Icc.mpr (by linarith : -R ≤ R)) hcont.continuousOn
  refine ⟨x0, fun x => ?_⟩
  by_cases hx : x ∈ Set.Icc (-R) R
  · exact hmax hx
  · have hnorm : R < |x| := by
      simp only [Set.mem_Icc, not_and_or, not_le] at hx
      rcases hx with hx | hx
      · rw [abs_of_neg (by linarith)]
        linarith
      · exact lt_of_lt_of_le hx (le_abs_self x)
    have hrx : r < |x| := by
      dsimp [R] at hnorm
      linarith [le_abs_self r]
    have htail := hr x hrx
    have hxpos : 0 < thetaCuspTiltedSource a x := by
      unfold thetaCuspTiltedSource
      exact mul_pos (Real.exp_pos _) (thetaCuspFullSource_pos_all _)
    have htail' : thetaCuspTiltedSource a x < thetaCuspTiltedSource a 0 := by
      simpa [source, Real.norm_eq_abs, abs_of_pos hxpos] using htail
    have h0mem : (0 : ℝ) ∈ Set.Icc (-R) R := by constructor <;> linarith
    exact htail'.le.trans (hmax h0mem)

private theorem tiltedSource_strictUnimodal
    (a : ℝ) (ha : |a| < 1) :
    ∃ x0 : ℝ,
      StrictMonoOn (thetaCuspTiltedSource a) (Set.Iic x0) ∧
      StrictAntiOn (thetaCuspTiltedSource a) (Set.Ici x0) := by
  obtain ⟨x0, hmax⟩ := exists_tiltedSource_globalPeak a ha
  have hphiMax : ∀ x : ℝ,
      thetaCuspTiltedLogSource a x ≤ thetaCuspTiltedLogSource a x0 := by
    intro x
    rw [← Real.exp_le_exp]
    simpa only [exp_tiltedLogSource] using hmax x
  have hlocal : IsLocalMax (thetaCuspTiltedLogSource a) x0 :=
    Filter.Eventually.of_forall hphiMax
  have hderiv0 : deriv (thetaCuspTiltedLogSource a) x0 = 0 :=
    hlocal.deriv_eq_zero
  have hderivAnti := strictAnti_deriv_tiltedLogSource a
  have hphiMono : StrictMonoOn (thetaCuspTiltedLogSource a) (Set.Iic x0) := by
    apply strictMonoOn_of_deriv_pos (convex_Iic x0)
    · have hcont : Continuous thetaCuspLogSource :=
        contDiff_thetaCuspFullSource.continuous.log fun x =>
          (thetaCuspFullSource_pos_all x).ne'
      unfold thetaCuspTiltedLogSource
      fun_prop
    · intro x hx
      have hxx0 : x < x0 := by simpa using hx
      have hsign := hderivAnti hxx0
      rw [hderiv0] at hsign
      exact hsign
  have hphiAnti : StrictAntiOn (thetaCuspTiltedLogSource a) (Set.Ici x0) := by
    apply strictAntiOn_of_deriv_neg (convex_Ici x0)
    · have hcont : Continuous thetaCuspLogSource :=
        contDiff_thetaCuspFullSource.continuous.log fun x =>
          (thetaCuspFullSource_pos_all x).ne'
      unfold thetaCuspTiltedLogSource
      fun_prop
    · intro x hx
      have hx0x : x0 < x := by simpa using hx
      have hsign := hderivAnti hx0x
      rw [hderiv0] at hsign
      exact hsign
  refine ⟨x0, ?_, ?_⟩
  · intro x hx y hy hxy
    rw [← exp_tiltedLogSource, ← exp_tiltedLogSource]
    exact Real.exp_lt_exp.mpr (hphiMono hx hy hxy)
  · intro x hx y hy hxy
    rw [← exp_tiltedLogSource, ← exp_tiltedLogSource]
    exact Real.exp_lt_exp.mpr (hphiAnti hx hy hxy)

/-- Frequency-`w` Fourier moment of `n`th power of tilted theta-cusp source. -/
def thetaCuspTiltedPowerMoment (a : ℝ) (n : ℕ) (w : ℝ) : ℂ :=
  ∫ x : ℝ,
    Complex.exp (Complex.I * ((-w * x : ℝ) : ℂ)) *
      (((thetaCuspTiltedSource a x) ^ n : ℝ) : ℂ)

private theorem tiltedSource_le_peak
    {a x0 : ℝ}
    (hmono : StrictMonoOn (thetaCuspTiltedSource a) (Set.Iic x0))
    (hanti : StrictAntiOn (thetaCuspTiltedSource a) (Set.Ici x0))
    (x : ℝ) :
    thetaCuspTiltedSource a x ≤ thetaCuspTiltedSource a x0 := by
  rcases le_total x x0 with hx | hx
  · exact hmono.monotoneOn hx (by simp) hx
  · exact hanti.antitoneOn (by simp) hx hx

private theorem integrable_tiltedSource_pow_succ
    {a x0 : ℝ} (ha : |a| < 1)
    (hmono : StrictMonoOn (thetaCuspTiltedSource a) (Set.Iic x0))
    (hanti : StrictAntiOn (thetaCuspTiltedSource a) (Set.Ici x0))
    (n : ℕ) :
    Integrable (fun x : ℝ => thetaCuspTiltedSource a x ^ (n + 1)) := by
  let source : 𝓢(ℝ, ℝ) := thetaCuspTiltedSchwartzReal a ha
  let M := thetaCuspTiltedSource a x0
  have hM : 0 ≤ M := by
    dsimp [M]
    unfold thetaCuspTiltedSource
    exact (mul_pos (Real.exp_pos _) (thetaCuspFullSource_pos_all _)).le
  have hmajor : Integrable (fun x : ℝ => M ^ n * source x) :=
    source.integrable.const_mul (M ^ n)
  apply Integrable.mono hmajor
  · apply Continuous.aestronglyMeasurable
    have hcont := (contDiff_thetaCuspTiltedSource a).continuous
    fun_prop
  · filter_upwards with x
    have hkpos : 0 < thetaCuspTiltedSource a x := by
      unfold thetaCuspTiltedSource
      exact mul_pos (Real.exp_pos _) (thetaCuspFullSource_pos_all _)
    have hkM := tiltedSource_le_peak hmono hanti x
    rw [Real.norm_eq_abs, Real.norm_eq_abs,
      abs_of_nonneg (pow_nonneg hkpos.le _)]
    have hsource : source x = thetaCuspTiltedSource a x := rfl
    rw [hsource, abs_of_nonneg (mul_nonneg (pow_nonneg hM _) hkpos.le)]
    rw [pow_succ']
    rw [mul_comm]
    exact mul_le_mul_of_nonneg_right (pow_le_pow_left₀ hkpos.le hkM n) hkpos.le

private theorem integrable_tiltedPowerMoment_integrand
    {a x0 : ℝ} (ha : |a| < 1)
    (hmono : StrictMonoOn (thetaCuspTiltedSource a) (Set.Iic x0))
    (hanti : StrictAntiOn (thetaCuspTiltedSource a) (Set.Ici x0))
    (n : ℕ) (w : ℝ) :
    Integrable (fun x : ℝ =>
      Complex.exp (Complex.I * ((-w * x : ℝ) : ℂ)) *
        (((thetaCuspTiltedSource a x) ^ (n + 1) : ℝ) : ℂ)) := by
  have hp : Integrable (fun x : ℝ =>
      (((thetaCuspTiltedSource a x) ^ (n + 1) : ℝ) : ℂ)) :=
    (integrable_tiltedSource_pow_succ ha hmono hanti n).ofReal
  apply hp.bdd_mul (c := 1)
  · apply Continuous.aestronglyMeasurable
    fun_prop
  · filter_upwards with x
    rw [Complex.norm_exp]
    simp

private theorem cos_phase_ge_half
    {w x0 r x : ℝ} (hr : 0 ≤ r) (hwr : |w| * r ≤ 1 / 2)
    (hx : x ∈ Set.Icc (x0 - r) (x0 + r)) :
    (1 / 2 : ℝ) ≤ Real.cos (w * (x0 - x)) := by
  have hdx : |x0 - x| ≤ r := by
    rw [abs_le]
    constructor <;> linarith [hx.1, hx.2]
  have harg : |w * (x0 - x)| ≤ 1 / 2 := by
    rw [abs_mul]
    exact (mul_le_mul_of_nonneg_left hdx (abs_nonneg w)).trans hwr
  have hcos := Real.abs_cos_sub_cos_le (w * (x0 - x)) 0
  rw [Real.cos_zero, sub_zero] at hcos
  have hlower := neg_le_of_abs_le (hcos.trans harg)
  linarith

private theorem tiltedSource_tail_le_boundaryMax
    {a x0 r x : ℝ} (hr : 0 < r)
    (hmono : StrictMonoOn (thetaCuspTiltedSource a) (Set.Iic x0))
    (hanti : StrictAntiOn (thetaCuspTiltedSource a) (Set.Ici x0))
    (hx : x ∉ Set.Icc (x0 - r) (x0 + r)) :
    thetaCuspTiltedSource a x ≤
      max (thetaCuspTiltedSource a (x0 - r))
        (thetaCuspTiltedSource a (x0 + r)) := by
  simp only [Set.mem_Icc, not_and_or, not_le] at hx
  rcases hx with hx | hx
  · have hxmem : x ∈ Set.Iic x0 := by simp; linarith
    have hbmem : x0 - r ∈ Set.Iic x0 := by simp; linarith
    exact (hmono.monotoneOn hxmem hbmem hx.le).trans (le_max_left _ _)
  · have hbmem : x0 + r ∈ Set.Ici x0 := by simp; linarith
    have hxmem : x ∈ Set.Ici x0 := by simp; linarith
    exact (hanti.antitoneOn hbmem hxmem hx.le).trans (le_max_right _ _)

private theorem eventually_pos_tiltedRotatedPowerIntegral
    (a : ℝ) (ha : |a| < 1) (w : ℝ) :
    ∃ x0 : ℝ, ∀ᶠ n : ℕ in Filter.atTop,
      0 < ∫ x : ℝ,
        Real.cos (w * (x0 - x)) * thetaCuspTiltedSource a x ^ (n + 1) := by
  obtain ⟨x0, hmono, hanti⟩ := tiltedSource_strictUnimodal a ha
  refine ⟨x0, ?_⟩
  let r : ℝ := 1 / (2 * (|w| + 1))
  have hden : 0 < |w| + 1 := by linarith [abs_nonneg w]
  have hr : 0 < r := by dsimp [r]; positivity
  have hwr : |w| * r ≤ 1 / 2 := by
    have hratio : |w| / (|w| + 1) < 1 := (div_lt_one hden).2 (by linarith)
    dsimp [r]
    rw [show |w| * (1 / (2 * (|w| + 1))) =
      (1 / 2 : ℝ) * (|w| / (|w| + 1)) by field_simp]
    simpa using
      (mul_lt_mul_of_pos_left hratio (by norm_num : (0 : ℝ) < 1 / 2)).le
  let M := thetaCuspTiltedSource a x0
  let q := max (thetaCuspTiltedSource a (x0 - r))
    (thetaCuspTiltedSource a (x0 + r))
  have hleft : thetaCuspTiltedSource a (x0 - r) < M := by
    have hLmem : x0 - r ∈ Set.Iic x0 := by simp; linarith
    have h0mem : x0 ∈ Set.Iic x0 := by simp
    exact hmono hLmem h0mem (by linarith)
  have hright : thetaCuspTiltedSource a (x0 + r) < M := by
    have h0mem : x0 ∈ Set.Ici x0 := by simp
    have hRmem : x0 + r ∈ Set.Ici x0 := by simp; linarith
    exact hanti h0mem hRmem (by linarith)
  have hqM : q < M := by
    dsimp [q]
    exact max_lt hleft hright
  have hqpos : 0 < q := by
    dsimp [q]
    have hp : 0 < thetaCuspTiltedSource a (x0 - r) := by
      unfold thetaCuspTiltedSource
      exact mul_pos (Real.exp_pos _) (thetaCuspFullSource_pos_all _)
    exact hp.trans_le (le_max_left _ _)
  let m : ℝ := (q + M) / 2
  have hqm : q < m := by dsimp [m]; linarith
  have hmM : m < M := by dsimp [m]; linarith
  have hmpos : 0 < m := hqpos.trans hqm
  have hcont : Continuous (thetaCuspTiltedSource a) :=
    (contDiff_thetaCuspTiltedSource a).continuous
  have hnear : ∀ᶠ x : ℝ in nhds x0, m < thetaCuspTiltedSource a x :=
    continuousAt_const.eventually_lt hcont.continuousAt hmM
  obtain ⟨eps, heps, hepsSub⟩ := Metric.mem_nhds_iff.1 hnear
  let d : ℝ := min (eps / 2) (r / 2)
  have hd : 0 < d := by dsimp [d]; positivity
  have hdr : d ≤ r := by
    have := min_le_right (eps / 2) (r / 2)
    dsimp [d]
    linarith
  have hdeps : d < eps := by
    have := min_le_left (eps / 2) (r / 2)
    dsimp [d]
    linarith
  have hinner : ∀ x ∈ Set.Icc (x0 - d) (x0 + d),
      m ≤ thetaCuspTiltedSource a x := by
    intro x hx
    have hxball : x ∈ Metric.ball x0 eps := by
      rw [Metric.mem_ball, Real.dist_eq]
      have habs : |x - x0| ≤ d := by
        rw [abs_le]
        constructor <;> linarith [hx.1, hx.2]
      exact habs.trans_lt hdeps
    exact (hepsSub hxball).le
  let source := thetaCuspTiltedSchwartzReal a ha
  let mass : ℝ := ∫ x : ℝ, thetaCuspTiltedSource a x
  have hmasspos : 0 < mass := by
    dsimp [mass]
    apply integral_pos_of_integrable_nonneg_nonzero hcont source.integrable
    · intro x
      exact (mul_pos (Real.exp_pos _) (thetaCuspFullSource_pos_all _)).le
    · show thetaCuspTiltedSource a 0 ≠ 0
      unfold thetaCuspTiltedSource
      exact (mul_pos (Real.exp_pos _) (thetaCuspFullSource_pos_all 0)).ne'
  have hratio0 : 0 ≤ q / m := div_nonneg hqpos.le hmpos.le
  have hratio1 : q / m < 1 := (div_lt_one hmpos).2 hqm
  have htailLimit : Filter.Tendsto (fun n : ℕ => mass * (q / m) ^ n)
      Filter.atTop (nhds 0) := by
    simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one hratio0 hratio1).const_mul mass
  have htail : ∀ᶠ n : ℕ in Filter.atTop,
      mass * (q / m) ^ n < d * m :=
    htailLimit.eventually_lt tendsto_const_nhds (mul_pos hd hmpos)
  filter_upwards [htail] with n hn
  let core : Set ℝ := Set.Icc (x0 - d) (x0 + d)
  let c : ℝ := (1 / 2) * m ^ (n + 1)
  have hsourceInt : Integrable (thetaCuspTiltedSource a) volume := by
    simpa using (integrable_tiltedSource_pow_succ ha hmono hanti 0)
  have hpowInt : Integrable (fun x : ℝ =>
      thetaCuspTiltedSource a x ^ (n + 1)) :=
    integrable_tiltedSource_pow_succ ha hmono hanti n
  have htargetInt : Integrable (fun x : ℝ =>
      Real.cos (w * (x0 - x)) * thetaCuspTiltedSource a x ^ (n + 1)) := by
    apply hpowInt.bdd_mul (c := 1)
    · apply Continuous.aestronglyMeasurable
      fun_prop
    · filter_upwards with x
      simpa [Real.norm_eq_abs] using Real.abs_cos_le_one (w * (x0 - x))
  have hcoreInt : Integrable (core.indicator (fun _ : ℝ => c)) := by
    apply IntegrableOn.integrable_indicator
    · exact integrableOn_const (measure_Icc_lt_top.ne)
    · exact measurableSet_Icc
  have hlowerInt : Integrable (fun x : ℝ =>
      core.indicator (fun _ : ℝ => c) x -
        q ^ n * thetaCuspTiltedSource a x) :=
    hcoreInt.sub (hsourceInt.const_mul (q ^ n))
  have hpoint : ∀ x : ℝ,
      core.indicator (fun _ : ℝ => c) x -
          q ^ n * thetaCuspTiltedSource a x ≤
        Real.cos (w * (x0 - x)) * thetaCuspTiltedSource a x ^ (n + 1) := by
    intro x
    have hkpos : 0 < thetaCuspTiltedSource a x := by
      unfold thetaCuspTiltedSource
      exact mul_pos (Real.exp_pos _) (thetaCuspFullSource_pos_all _)
    by_cases hxcore : x ∈ core
    · have hxA : x ∈ Set.Icc (x0 - r) (x0 + r) := by
        dsimp [core] at hxcore
        constructor <;> linarith [hxcore.1, hxcore.2, hdr]
      have hphase := cos_phase_ge_half hr.le hwr hxA
      have hpower : m ^ (n + 1) ≤ thetaCuspTiltedSource a x ^ (n + 1) :=
        pow_le_pow_left₀ hmpos.le (hinner x (by simpa [core] using hxcore)) _
      have hcoherent : c ≤
          Real.cos (w * (x0 - x)) * thetaCuspTiltedSource a x ^ (n + 1) := by
        dsimp [c]
        exact mul_le_mul hphase hpower (pow_nonneg hmpos.le _)
          (by linarith : 0 ≤ Real.cos (w * (x0 - x)))
      rw [Set.indicator_of_mem hxcore]
      exact (sub_le_self c (mul_nonneg (pow_nonneg hqpos.le _) hkpos.le)).trans hcoherent
    · rw [Set.indicator_of_notMem hxcore, zero_sub]
      by_cases hxA : x ∈ Set.Icc (x0 - r) (x0 + r)
      · have hphase := cos_phase_ge_half hr.le hwr hxA
        exact (neg_nonpos.mpr (mul_nonneg (pow_nonneg hqpos.le _) hkpos.le)).trans
          (mul_nonneg (by linarith) (pow_nonneg hkpos.le _))
      · have hkq := tiltedSource_tail_le_boundaryMax hr hmono hanti hxA
        change thetaCuspTiltedSource a x ≤ q at hkq
        have hpowTail : thetaCuspTiltedSource a x ^ (n + 1) ≤
            q ^ n * thetaCuspTiltedSource a x := by
          rw [pow_succ']
          rw [mul_comm]
          exact mul_le_mul_of_nonneg_right
            (pow_le_pow_left₀ hkpos.le hkq n) hkpos.le
        calc
          -(q ^ n * thetaCuspTiltedSource a x) ≤
              -(thetaCuspTiltedSource a x ^ (n + 1)) := neg_le_neg hpowTail
          _ = (-1) * thetaCuspTiltedSource a x ^ (n + 1) := by ring
          _ ≤ Real.cos (w * (x0 - x)) *
              thetaCuspTiltedSource a x ^ (n + 1) :=
            mul_le_mul_of_nonneg_right (Real.neg_one_le_cos _) (pow_nonneg hkpos.le _)
  have hintegralLower := integral_mono_ae hlowerInt htargetInt
    (Filter.Eventually.of_forall hpoint)
  have hcoreIntegral :
      ∫ x : ℝ, core.indicator (fun _ : ℝ => c) x = 2 * d * c := by
    rw [integral_indicator measurableSet_Icc, setIntegral_const]
    unfold Measure.real
    dsimp [core]
    rw [Real.volume_Icc, ENNReal.toReal_ofReal]
    · ring
    · linarith
  have hlowerValue :
      ∫ x : ℝ, core.indicator (fun _ : ℝ => c) x -
          q ^ n * thetaCuspTiltedSource a x =
        2 * d * c - q ^ n * mass := by
    rw [integral_sub hcoreInt (hsourceInt.const_mul (q ^ n)),
      hcoreIntegral, integral_const_mul]
  have htailScaled : q ^ n * mass < d * m ^ (n + 1) := by
    have hmPow : m ^ n ≠ 0 := pow_ne_zero n hmpos.ne'
    have hcancel : m ^ n * (q ^ n / m ^ n) = q ^ n := by
      field_simp [hmPow]
    have hdivpow : (q / m) ^ n = q ^ n / m ^ n := div_pow q m n
    calc
      q ^ n * mass = mass * q ^ n := mul_comm _ _
      _ = mass * (m ^ n * (q ^ n / m ^ n)) := by rw [hcancel]
      _ = m ^ n * (mass * (q ^ n / m ^ n)) := by ring
      _ = m ^ n * (mass * (q / m) ^ n) := by rw [hdivpow]
      _ < m ^ n * (d * m) := mul_lt_mul_of_pos_left hn (pow_pos hmpos n)
      _ = d * m ^ (n + 1) := by rw [pow_succ']; ring
  have hlowerPos : 0 < 2 * d * c - q ^ n * mass := by
    dsimp [c]
    nlinarith
  rw [hlowerValue] at hintegralLower
  exact hlowerPos.trans_le hintegralLower

private theorem rotatedPowerPhase_re
    (a w x0 x : ℝ) (n : ℕ) :
    (Complex.exp (Complex.I * ((w * x0 : ℝ) : ℂ)) *
      (Complex.exp (Complex.I * ((-w * x : ℝ) : ℂ)) *
        (((thetaCuspTiltedSource a x) ^ n : ℝ) : ℂ))).re =
      Real.cos (w * (x0 - x)) * thetaCuspTiltedSource a x ^ n := by
  rw [← mul_assoc, ← Complex.exp_add]
  have harg :
      Complex.I * ((w * x0 : ℝ) : ℂ) +
          Complex.I * ((-w * x : ℝ) : ℂ) =
        (((w * (x0 - x) : ℝ) : ℂ) * Complex.I) := by
    push_cast
    ring
  have hpowre :
      ((((thetaCuspTiltedSource a x) ^ n : ℝ) : ℂ)).re =
        thetaCuspTiltedSource a x ^ n := rfl
  have hpowim :
      ((((thetaCuspTiltedSource a x) ^ n : ℝ) : ℂ)).im = 0 := rfl
  rw [harg, Complex.mul_re, Complex.exp_ofReal_mul_I_re, hpowre, hpowim]
  simp

/-- Every fixed tilted sector has nonzero power moments at all sufficiently high orders. -/
theorem eventually_ne_tiltedPowerMoment
    (a : ℝ) (ha : |a| < 1) (w : ℝ) :
    ∀ᶠ n : ℕ in Filter.atTop, thetaCuspTiltedPowerMoment a (n + 1) w ≠ 0 := by
  obtain ⟨x0, hpos⟩ := eventually_pos_tiltedRotatedPowerIntegral a ha w
  filter_upwards [hpos] with n hn
  obtain ⟨xPeak, hmono, hanti⟩ := tiltedSource_strictUnimodal a ha
  have hint := integrable_tiltedPowerMoment_integrand ha hmono hanti n w
  have hrotInt : Integrable (fun x : ℝ =>
      Complex.exp (Complex.I * ((w * x0 : ℝ) : ℂ)) *
        (Complex.exp (Complex.I * ((-w * x : ℝ) : ℂ)) *
          (((thetaCuspTiltedSource a x) ^ (n + 1) : ℝ) : ℂ))) :=
    hint.const_mul _
  have hrot :
      (Complex.exp (Complex.I * ((w * x0 : ℝ) : ℂ)) *
          thetaCuspTiltedPowerMoment a (n + 1) w).re =
        ∫ x : ℝ,
          Real.cos (w * (x0 - x)) * thetaCuspTiltedSource a x ^ (n + 1) := by
    rw [thetaCuspTiltedPowerMoment, ← integral_const_mul]
    have hre :
        (∫ x : ℝ,
            (Complex.exp (Complex.I * ((w * x0 : ℝ) : ℂ)) *
              (Complex.exp (Complex.I * ((-w * x : ℝ) : ℂ)) *
                (((thetaCuspTiltedSource a x) ^ (n + 1) : ℝ) : ℂ))).re) =
          (∫ x : ℝ,
            Complex.exp (Complex.I * ((w * x0 : ℝ) : ℂ)) *
              (Complex.exp (Complex.I * ((-w * x : ℝ) : ℂ)) *
                (((thetaCuspTiltedSource a x) ^ (n + 1) : ℝ) : ℂ))).re := by
      exact integral_re hrotInt
    rw [← hre]
    apply integral_congr_ae
    filter_upwards with x
    exact rotatedPowerPhase_re a w x0 x (n + 1)
  intro hzero
  rw [hzero, mul_zero, Complex.zero_re] at hrot
  linarith

/-- First coupling moment is exactly centered Xi on corresponding tilted line. -/
theorem tiltedPowerMoment_one_eq_XiC
    {a : ℝ} (ha : |a| < 1) (w : ℝ) :
    thetaCuspTiltedPowerMoment a 1 w = XiC ((w : ℂ) + (a : ℂ) * Complex.I) := by
  have hfourier := fourier_thetaCuspTiltedSchwartz_scaled ha w
  rw [SchwartzMap.fourier_coe,
    Real.fourier_real_eq_integral_exp_smul] at hfourier
  simp only [thetaCuspTiltedPowerMoment, pow_one]
  convert hfourier using 1
  apply integral_congr_ae
  filter_upwards with x
  rw [thetaCuspTiltedSchwartz_apply]
  simp only [smul_eq_mul]
  congr 1
  congr 1
  push_cast
  field_simp [Real.pi_ne_zero]

/-- Every real-frequency tilted sector is visible in some finite coupling jet. -/
def ThetaCuspHawkingAllOrderSectorJetMixing : Prop :=
  ∀ (a w : ℝ), |a| < 1 →
    ∃ n : ℕ, 1 ≤ n ∧ thetaCuspTiltedPowerMoment a n w ≠ 0

/-- Full eikonal hierarchy couples every tilted real-frequency sector unconditionally. -/
theorem thetaCuspHawkingAllOrderSectorJetMixing :
    ThetaCuspHawkingAllOrderSectorJetMixing := by
  intro a w ha
  obtain ⟨n, hn⟩ := (eventually_ne_tiltedPowerMoment a ha w).exists
  exact ⟨n + 1, by omega, hn⟩

/-- Principal-order mixing means no noncentral tilted sector waits for a nonlinear jet. -/
def ThetaCuspHawkingPrincipalSectorMixing : Prop :=
  ∀ (a w : ℝ), |a| < 1 → a ≠ 0 →
    thetaCuspTiltedPowerMoment a 1 w ≠ 0

/-- Principal-order mixing is existing tilted-mirror no-dark-mode law. -/
theorem principalSectorMixing_iff_darkFree :
    ThetaCuspHawkingPrincipalSectorMixing ↔
      ThetaCuspHawkingTiltedMirrorsDarkFree := by
  constructor
  · intro h a w ha hane
    simpa [thetaCuspHawkingTiltedDeembeddedPairCarrier,
      tiltedPowerMoment_one_eq_XiC ha w] using h a w ha hane
  · intro h a w ha hane
    simpa [thetaCuspHawkingTiltedDeembeddedPairCarrier,
      tiltedPowerMoment_one_eq_XiC ha w] using h a w ha hane

/-- RH selects absence of every nonlinear coupling-order jump, not all-order mixing itself. -/
theorem riemannHypothesis_iff_principalSectorMixing :
    RiemannHypothesis ↔ ThetaCuspHawkingPrincipalSectorMixing :=
  riemannHypothesis_iff_thetaCuspHawkingTiltedMirrorsDarkFree.trans
    principalSectorMixing_iff_darkFree.symm

end RHTower
