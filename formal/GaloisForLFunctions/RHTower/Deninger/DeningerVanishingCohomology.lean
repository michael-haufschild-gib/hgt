import GaloisForLFunctions.RHTower.Deninger.DeningerHomologyCohomology
import GaloisForLFunctions.RHTower.Deninger.DeningerBauSubsingleton
import GaloisForLFunctions.RHTower.Deninger.DeningerTower

/-!
# The cohomological form of the vanishing results

Over a field the cochain complex with trivial coefficients is the dual of the chain complex, so
every vanishing statement about group homology in a positive degree gives one about group
cohomology in the same degree.  Applied to the rationalization of a group generated by one element,
to a root adjunction, and to a tower of root adjunctions, this puts the vanishing in the degree and
the theory in which the Milnor packet states it.

* `deningerBau_isZero_cohomology_of_cyclic` : the rationalization of a cyclic group.
* `deningerBauFree_isZero_cohomology_of_subsingleton` : a free group on at most one generator.
* `deningerRootAdjunction_isZero_cohomology_two` : a root adjunction in degree two.
* `deningerTower_isZero_cohomology_two` : a tower of root adjunctions in degree two.
-/

namespace RHTower

open Monoid Monoid.PushoutI CategoryTheory CategoryTheory.Limits

universe u

/-- **The rationalization of a group generated by one element has no cohomology in degrees at
least two.** -/
theorem deningerBau_isZero_cohomology_of_cyclic (k : Type u) [Field k] {α : Type u} [Group α]
    (g : α) (hgen : ∀ a : α, a ∈ Subgroup.zpowers g) (n : ℕ) :
    IsZero (groupCohomology (Rep.trivial k (DeningerBau α) k) (n + 2)) :=
  deningerIsZero_cohomology_of_homology k (DeningerBau α) (n + 1)
    (deningerBau_isZero_of_cyclic k g hgen n)

/-- **The rationalization of a free group on at most one generator has no cohomology in degrees at
least two.** -/
theorem deningerBauFree_isZero_cohomology_of_subsingleton (k : Type u) [Field k] {ι : Type u}
    [Subsingleton ι] (n : ℕ) :
    IsZero (groupCohomology (Rep.trivial k (DeningerBau (FreeGroup ι)) k) (n + 2)) :=
  deningerIsZero_cohomology_of_homology k (DeningerBau (FreeGroup ι)) (n + 1)
    (deningerBauFree_isZero_of_subsingleton k n)

namespace RootAdjunction

/-- **A root adjunction has vanishing second cohomology** when the group it is applied to does. -/
theorem deningerRootAdjunction_isZero_cohomology_two (A : Type u) [Group A] (a : A) (m : ℤ)
    (hm : m ≠ 0) (ha : ∀ n : ℤ, a ^ n = 1 → n = 0) (k : Type u) [Field k] [CharZero k]
    (hA : IsZero (groupHomology (Rep.trivial k A k) 2)) :
    IsZero (groupCohomology (Rep.trivial k (PushoutI (deningerRootMap A a m)) k) 2) :=
  deningerIsZero_cohomology_of_homology k (PushoutI (deningerRootMap A a m)) 1
    (deningerRootAdjunction_isZero_two A a m hm ha k hA)

variable (S₀ : DeningerStage.{u}) (d : ∀ S : DeningerStage.{u}, S.carrier × ℤ)

/-- **Every stage of a tower of root adjunctions has vanishing second cohomology.** -/
theorem deningerTower_isZero_cohomology_two (k : Type u) [Field k] [CharZero k]
    (h0 : ∀ (y : S₀.carrier) (n : ℕ), 0 < n → y ^ n = 1 → y = 1)
    (hm : ∀ S, (d S).2 ≠ 0) (hne : ∀ S, (d S).1 ≠ 1)
    (hz : IsZero (groupHomology (Rep.trivial k S₀.carrier k) 2)) (n : ℕ) :
    IsZero (groupCohomology (Rep.trivial k (deningerTower S₀ d n).carrier k) 2) :=
  deningerIsZero_cohomology_of_homology k (deningerTower S₀ d n).carrier 1
    (deningerTower_isZero_two S₀ d k h0 hm hne hz n)

end RootAdjunction

end RHTower
