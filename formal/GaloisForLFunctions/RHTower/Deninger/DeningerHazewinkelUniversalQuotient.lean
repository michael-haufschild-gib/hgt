import GaloisForLFunctions.RHTower.Deninger.DeningerHazewinkelHankelDescent

/-!
# Hazewinkel universal quotient: tail containment and characteristic zero

For positive `n`, Hazewinkel's ideal `J_n` lies in the coefficient-tail
ideal generated by `X_n, X_(n+1), ...` (with the zero-based variable indexing
used by `MvPolynomial`).  Evaluation of all variables at zero therefore
factors through the quotient by `J_n`, proving that quotient has
characteristic zero.

This is the first arithmetic input in Hazewinkel's reduced-tensor argument.
It does not assume the still-deeper theorem that `J_n` is prime.
-/

namespace RHTower
noncomputable section

/-- The ideal generated by universal coefficients from zero-based index `k`
onward. -/
def deningerHazewinkelTailIdeal (k : ℕ) : Ideal (MvPolynomial ℕ ℤ) :=
  Ideal.span {p | ∃ j : ℕ, k ≤ j ∧ p = MvPolynomial.X j}

theorem deningerHazewinkelUniversalCoeff_mem_tail
    {n s : ℕ} (hn : 0 < n) (hns : n ≤ s) :
    deningerHazewinkelUniversalCoeff s ∈ deningerHazewinkelTailIdeal (n - 1) := by
  cases s with
  | zero => omega
  | succ k =>
      apply Ideal.subset_span
      exact ⟨k, by omega, rfl⟩

/-- An injection from `Fin (n+1)` to the naturals takes some value at least
`n`. -/
theorem exists_le_apply_of_injective_fin_succ
    {n : ℕ} {f : Fin (n + 1) → ℕ} (hf : Function.Injective f) :
    ∃ i, n ≤ f i := by
  by_contra h
  push Not at h
  let g : Fin (n + 1) → Fin n := fun i => ⟨f i, h i⟩
  have hg : Function.Injective g := by
    intro i j hij
    apply hf
    exact congrArg Fin.val hij
  have hcard := Fintype.card_le_of_injective g hg
  simp only [Fintype.card_fin] at hcard
  omega

/-- Hazewinkel's universal `(n+1)`-minor ideal is supported in coefficient
indices at least `n`. -/
theorem deningerHazewinkelIdeal_le_tail (n : ℕ) (hn : 0 < n) :
    deningerHazewinkelIdeal n ≤ deningerHazewinkelTailIdeal (n - 1) := by
  rw [deningerHazewinkelIdeal, deningerMatrixMinorIdeal, Ideal.span_le]
  rintro z ⟨rows, cols, rfl⟩
  by_cases hrows : Function.Injective rows
  · obtain ⟨i, hi⟩ := exists_le_apply_of_injective_fin_succ hrows
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    rw [(Ideal.Quotient.mk (deningerHazewinkelTailIdeal (n - 1))).map_det]
    apply Matrix.det_eq_zero_of_row_eq_zero i
    intro j
    change (Ideal.Quotient.mk (deningerHazewinkelTailIdeal (n - 1)))
      (deningerHazewinkelUniversalCoeff (rows i + cols j)) = 0
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    apply deningerHazewinkelUniversalCoeff_mem_tail hn
    exact hi.trans (Nat.le_add_right _ _)
  · obtain ⟨i, j, hEq, hij⟩ := Function.not_injective_iff.mp hrows
    rw [Matrix.det_zero_of_row_eq hij]
    · exact Ideal.zero_mem _
    · funext k
      simp only [Matrix.submatrix_apply]
      rw [hEq]

theorem deningerHazewinkelTailIdeal_le_ker_eval_zero (k : ℕ) :
    deningerHazewinkelTailIdeal k ≤
      RingHom.ker (MvPolynomial.eval (fun _ : ℕ => (0 : ℤ))) := by
  rw [deningerHazewinkelTailIdeal, Ideal.span_le]
  rintro p ⟨j, hj, rfl⟩
  exact RingHom.mem_ker.mpr (by simp)

/-- Every positive-stage Hazewinkel universal quotient has characteristic
zero, independently of the primeness theorem. -/
theorem deningerHazewinkelQuotient_charZero (n : ℕ) (hn : 0 < n) :
    CharZero (MvPolynomial ℕ ℤ ⧸ deningerHazewinkelIdeal n) := by
  let ev : MvPolynomial ℕ ℤ →+* ℤ := MvPolynomial.eval (fun _ => 0)
  have hker : deningerHazewinkelIdeal n ≤ RingHom.ker ev :=
    (deningerHazewinkelIdeal_le_tail n hn).trans
      (deningerHazewinkelTailIdeal_le_ker_eval_zero (n - 1))
  let evq : (MvPolynomial ℕ ℤ ⧸ deningerHazewinkelIdeal n) →+* ℤ :=
    Ideal.Quotient.lift (deningerHazewinkelIdeal n) ev hker
  refine ⟨fun a b hab => ?_⟩
  have h := congrArg evq hab
  simpa [evq, ev] using h

end
end RHTower
