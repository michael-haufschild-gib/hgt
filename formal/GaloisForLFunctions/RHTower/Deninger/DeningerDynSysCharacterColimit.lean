import GaloisForLFunctions.RHTower.Deninger.DeningerDynSysCharacterPoints

/-!
# The colimit `X̌ (C)` of the Frobenius system

Deninger, *Dynamical systems for arithmetic schemes* (arXiv:1807.06400v4), §3.

For a submonoid `N₀ ⊆ ℕ`, ordered by divisibility, the Frobenius operators `F_ν` form a directed
system on the character points `X̂ (C)` and

`X̌ (C) = colim_{N₀} X̂ (C)`

is the localisation of `X̂ (C)` at the `F_ν`.  A point of the colimit is written `F_ν⁻¹ P`; two
such data `(ν , P)` and `(ν' , P')` describe the same point exactly when they become equal after
applying suitable Frobenius operators.  The operators `F_ν` become bijections on the colimit, which
is what makes the `N₀`-action extend to an action of the group `Q^{>0}_0` generated by `N₀`.

Everything here is unconditional: the defining relation is an equivalence relation and `F_ν` is
bijective on the colimit for every `ν ∈ N₀`, with no hypothesis on the residue fields.  The
canonical map `X̂ (C) → X̌ (C)` is injective as soon as the `F_ν` are, i.e. as soon as the residue
fields are algebraically closed.
-/

namespace RHTower

open AlgebraicGeometry CategoryTheory

universe u

variable {X Y : Scheme.{u}} {C : Type u} [Field C] (N₀ : Submonoid ℕ)

/-- The colimit relation on pairs `(ν , P)` describing the formal point `F_ν⁻¹ P`. -/
def DeningerColimRel (P Q : N₀ × DeningerCharPoints X C) : Prop :=
  ∃ a b : N₀, (P.1 : ℕ) * (a : ℕ) = (Q.1 : ℕ) * (b : ℕ) ∧
    deningerCharFrobenius (a : ℕ) P.2 = deningerCharFrobenius (b : ℕ) Q.2

variable {N₀}

theorem deningerColimRel_refl (P : N₀ × DeningerCharPoints X C) : DeningerColimRel N₀ P P :=
  ⟨1, 1, rfl, rfl⟩

theorem deningerColimRel_symm {P Q : N₀ × DeningerCharPoints X C}
    (h : DeningerColimRel N₀ P Q) : DeningerColimRel N₀ Q P := by
  obtain ⟨a, b, h1, h2⟩ := h
  exact ⟨b, a, h1.symm, h2.symm⟩

theorem deningerColimRel_trans {P Q R : N₀ × DeningerCharPoints X C}
    (hPQ : DeningerColimRel N₀ P Q) (hQR : DeningerColimRel N₀ Q R) :
    DeningerColimRel N₀ P R := by
  obtain ⟨a, b, h1, h2⟩ := hPQ
  obtain ⟨c, d, h3, h4⟩ := hQR
  refine ⟨a * c, b * d, ?_, ?_⟩
  · push_cast
    calc (P.1 : ℕ) * ((a : ℕ) * (c : ℕ)) = ((P.1 : ℕ) * (a : ℕ)) * (c : ℕ) := by ring
      _ = ((Q.1 : ℕ) * (b : ℕ)) * (c : ℕ) := by rw [h1]
      _ = ((Q.1 : ℕ) * (c : ℕ)) * (b : ℕ) := by ring
      _ = ((R.1 : ℕ) * (d : ℕ)) * (b : ℕ) := by rw [h3]
      _ = (R.1 : ℕ) * ((b : ℕ) * (d : ℕ)) := by ring
  · have e1 : deningerCharFrobenius ((a : ℕ) * (c : ℕ)) P.2
        = deningerCharFrobenius (c : ℕ) (deningerCharFrobenius (a : ℕ) P.2) :=
      (deningerCharFrobenius_comp _ _ _).symm
    have e2 : deningerCharFrobenius ((b : ℕ) * (d : ℕ)) R.2
        = deningerCharFrobenius (b : ℕ) (deningerCharFrobenius (d : ℕ) R.2) := by
      rw [deningerCharFrobenius_comp, Nat.mul_comm]
    have e3 : deningerCharFrobenius (c : ℕ) (deningerCharFrobenius (b : ℕ) Q.2)
        = deningerCharFrobenius (b : ℕ) (deningerCharFrobenius (c : ℕ) Q.2) := by
      rw [deningerCharFrobenius_comp, deningerCharFrobenius_comp, Nat.mul_comm]
    push_cast
    rw [e1, h2, e3, h4, e2]

variable (N₀) in
/-- The setoid defining the colimit `X̌ (C)`. -/
def deningerColimSetoid (X : Scheme.{u}) (C : Type u) [Field C] :
    Setoid (N₀ × DeningerCharPoints X C) where
  r := DeningerColimRel N₀
  iseqv := ⟨deningerColimRel_refl, deningerColimRel_symm, deningerColimRel_trans⟩

variable (N₀) in
/-- **Deninger, §3.**  The colimit `X̌ (C) = colim_{N₀} X̂ (C)` of the Frobenius system. -/
def DeningerColimPoints (X : Scheme.{u}) (C : Type u) [Field C] : Type u :=
  Quotient (deningerColimSetoid N₀ X C)

variable (N₀) in
/-- The class of the formal point `F_ν⁻¹ P`. -/
def deningerColimMk (ν : N₀) (P : DeningerCharPoints X C) : DeningerColimPoints N₀ X C :=
  Quotient.mk _ (ν, P)

theorem deningerColimMk_eq_iff {ν μ : N₀} {P Q : DeningerCharPoints X C} :
    deningerColimMk N₀ ν P = deningerColimMk N₀ μ Q ↔
      ∃ a b : N₀, (ν : ℕ) * (a : ℕ) = (μ : ℕ) * (b : ℕ) ∧
        deningerCharFrobenius (a : ℕ) P = deningerCharFrobenius (b : ℕ) Q :=
  Quotient.eq (r := deningerColimSetoid N₀ X C)

theorem deningerColimMk_surjective (z : DeningerColimPoints N₀ X C) :
    ∃ (ν : N₀) (P : DeningerCharPoints X C), deningerColimMk N₀ ν P = z := by
  obtain ⟨⟨ν, P⟩, rfl⟩ := Quotient.exists_rep z
  exact ⟨ν, P, rfl⟩

/-! ## The projection to `X` -/

variable (N₀) in
/-- The projection `X̌ (C) → X`. -/
def deningerColimProj (z : DeningerColimPoints N₀ X C) : X := by
  refine Quotient.liftOn z (fun P => P.2.1) ?_
  rintro ⟨ν, P⟩ ⟨μ, Q⟩ ⟨a, b, -, h2⟩
  have h := congrArg Sigma.fst h2
  simpa using h

@[simp] theorem deningerColimProj_mk (ν : N₀) (P : DeningerCharPoints X C) :
    deningerColimProj N₀ (deningerColimMk N₀ ν P) = P.1 := rfl

/-! ## The Frobenius operators on the colimit -/

variable (N₀) in
/-- The Frobenius operator `F_ν` on the colimit. -/
noncomputable def deningerColimFrobenius (ν : ℕ) (z : DeningerColimPoints N₀ X C) :
    DeningerColimPoints N₀ X C := by
  refine Quotient.liftOn z (fun P => deningerColimMk N₀ P.1 (deningerCharFrobenius ν P.2)) ?_
  rintro ⟨μ, P⟩ ⟨μ', Q⟩ ⟨a, b, h1, h2⟩
  refine deningerColimMk_eq_iff.2 ⟨a, b, h1, ?_⟩
  have e1 : deningerCharFrobenius (a : ℕ) (deningerCharFrobenius ν P)
      = deningerCharFrobenius ν (deningerCharFrobenius (a : ℕ) P) := by
    rw [deningerCharFrobenius_comp, deningerCharFrobenius_comp, Nat.mul_comm]
  have e2 : deningerCharFrobenius (b : ℕ) (deningerCharFrobenius ν Q)
      = deningerCharFrobenius ν (deningerCharFrobenius (b : ℕ) Q) := by
    rw [deningerCharFrobenius_comp, deningerCharFrobenius_comp, Nat.mul_comm]
  rw [e1, e2, h2]

@[simp] theorem deningerColimFrobenius_mk (ν : ℕ) (μ : N₀) (P : DeningerCharPoints X C) :
    deningerColimFrobenius N₀ ν (deningerColimMk N₀ μ P)
      = deningerColimMk N₀ μ (deningerCharFrobenius ν P) := rfl

/-- **Deninger, §3.**  The Frobenius operators are surjective on the colimit. -/
theorem deningerColimFrobenius_surjective {ν : ℕ} (hν : ν ∈ N₀) :
    Function.Surjective (deningerColimFrobenius (X := X) (C := C) N₀ ν) := by
  intro z
  obtain ⟨μ, P, rfl⟩ := deningerColimMk_surjective z
  refine ⟨deningerColimMk N₀ (μ * ⟨ν, hν⟩) P, ?_⟩
  rw [deningerColimFrobenius_mk]
  refine deningerColimMk_eq_iff.2 ⟨1, ⟨ν, hν⟩, ?_, ?_⟩
  · simp [mul_comm]
  · simp

/-- **Deninger, §3.**  The Frobenius operators are injective on the colimit. -/
theorem deningerColimFrobenius_injective {ν : ℕ} (hν : ν ∈ N₀) :
    Function.Injective (deningerColimFrobenius (X := X) (C := C) N₀ ν) := by
  intro z w h
  obtain ⟨μ, P, rfl⟩ := deningerColimMk_surjective z
  obtain ⟨μ', Q, rfl⟩ := deningerColimMk_surjective w
  rw [deningerColimFrobenius_mk, deningerColimFrobenius_mk, deningerColimMk_eq_iff] at h
  obtain ⟨a, b, h1, h2⟩ := h
  refine deningerColimMk_eq_iff.2 ⟨a * ⟨ν, hν⟩, b * ⟨ν, hν⟩, ?_, ?_⟩
  · push_cast
    calc (μ : ℕ) * ((a : ℕ) * ν) = ((μ : ℕ) * (a : ℕ)) * ν := by ring
      _ = ((μ' : ℕ) * (b : ℕ)) * ν := by rw [h1]
      _ = (μ' : ℕ) * ((b : ℕ) * ν) := by ring
  · push_cast
    rw [Nat.mul_comm (a : ℕ) ν, Nat.mul_comm (b : ℕ) ν,
      ← deningerCharFrobenius_comp (a : ℕ) ν P, ← deningerCharFrobenius_comp (b : ℕ) ν Q]
    exact h2

/-- **Deninger, §3.**  The Frobenius operators are bijections on the colimit. -/
theorem deningerColimFrobenius_bijective {ν : ℕ} (hν : ν ∈ N₀) :
    Function.Bijective (deningerColimFrobenius (X := X) (C := C) N₀ ν) :=
  ⟨deningerColimFrobenius_injective hν, deningerColimFrobenius_surjective hν⟩

/-! ## The canonical map from `X̂ (C)` -/

variable (N₀) in
/-- The canonical map `X̂ (C) → X̌ (C)`. -/
def deningerColimUnit (P : DeningerCharPoints X C) : DeningerColimPoints N₀ X C :=
  deningerColimMk N₀ 1 P

/-- **Deninger, §3.**  Since the Frobenius operators are injective on `X̂ (C)`, the canonical map to
the colimit is injective. -/
theorem deningerColimUnit_injective (halg : ∀ x : X, IsAlgClosed (X.residueField x))
    (hN₀ : ∀ ν ∈ N₀, 0 < ν) :
    Function.Injective (deningerColimUnit (X := X) (C := C) N₀) := by
  intro P Q h
  rw [deningerColimUnit, deningerColimUnit, deningerColimMk_eq_iff] at h
  obtain ⟨a, b, h1, h2⟩ := h
  have hab : (a : ℕ) = (b : ℕ) := by simpa using h1
  rw [hab] at h2
  exact deningerCharFrobenius_injective halg (hN₀ b b.2) h2

end RHTower
