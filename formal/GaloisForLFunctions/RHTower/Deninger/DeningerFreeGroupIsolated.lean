import GaloisForLFunctions.RHTower.Deninger.DeningerFreeGroupCentral

/-!
# A basis element of a free group is isolated

The factor of a basis element is generated by it, so isolation inside the factor is automatic, and
the free product theorem lifts it to the whole group: an element whose positive power is a power of
a basis element is itself a power of it.

* `deningerRootGen_order` : the generator has infinite order.
* `deningerFreeGroup_isolated` : a basis element is isolated.
-/

namespace RHTower

open Monoid Monoid.PushoutI RootAdjunction

universe u

/-- **The generator of the infinite cyclic group has infinite order.** -/
theorem deningerRootGen_order (c : ℤ) (h : deningerRootGen.{u} ^ c = 1) : c = 0 := by
  have h1 : Multiplicative.toAdd (MulEquiv.ulift (deningerRootGen.{u} ^ c)) = 0 := by
    rw [h]
    simp
  rw [map_zpow, deningerRootGen] at h1
  simpa using h1

/-- **A basis element of a free group is isolated.** -/
theorem deningerFreeGroup_isolated (ι : Type u) (i : ι) (w : FreeGroup ι) (n : ℕ) (hn : 0 < n)
    (hw : w ^ n ∈ Subgroup.zpowers (FreeGroup.of i)) :
    w ∈ Subgroup.zpowers (FreeGroup.of i) := by
  classical
  have hEq : deningerFreeGroupEquiv ι (FreeGroup.of i) =
      PushoutI.of (φ := deningerFreeMap ι) i deningerRootGen.{u} :=
    deningerFreeToPushout_of ι i
  obtain ⟨c, hc'⟩ := hw
  have hc : (FreeGroup.of i) ^ c = w ^ n := hc'
  have hpow : (deningerFreeGroupEquiv ι w) ^ n ∈
      Subgroup.zpowers (PushoutI.of (φ := deningerFreeMap ι) i deningerRootGen.{u}) := by
    refine ⟨c, ?_⟩
    show (PushoutI.of (φ := deningerFreeMap ι) i deningerRootGen.{u}) ^ c = _
    rw [← hEq, ← map_zpow, hc, map_pow]
  obtain ⟨x, hx'⟩ := deningerFreeProduct_isolated (φ := deningerFreeMap ι)
    (fun _ p q _ => Subsingleton.elim p q)
    (fun g m hm hg => deningerFreeProduct_torsionFree (fun _ p q _ => Subsingleton.elim p q)
      (fun _ p q j hj hpq => deningerUliftInt_pow_inj p q j hj hpq) g m hm hg)
    i deningerRootGen.{u} deningerRootGen_order
    (fun y m _ _ => ⟨Multiplicative.toAdd (MulEquiv.ulift y), deningerFreeFactor_zpow ι i y⟩)
    (deningerFreeGroupEquiv ι w) n hn hpow
  have hx : (PushoutI.of (φ := deningerFreeMap ι) i deningerRootGen.{u}) ^ x =
      deningerFreeGroupEquiv ι w := hx'
  refine ⟨x, ?_⟩
  show (FreeGroup.of i) ^ x = w
  refine (deningerFreeGroupEquiv ι).injective ?_
  rw [map_zpow, hEq]
  exact hx

end RHTower
