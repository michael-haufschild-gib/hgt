import GaloisForLFunctions.RHTower.Deninger.DeningerCalderonWittAlgebraicSource
import GaloisForLFunctions.RHTower.Deninger.DeningerPolarizationAlmostProjection
import GaloisForLFunctions.RHTower.Deninger.DeningerArithmeticThreeTermCohomology
import Mathlib.LinearAlgebra.ExteriorPower.Basic
import Mathlib.LinearAlgebra.Alternating.Curry
import Mathlib.Algebra.Exact.Basic

/-!
# Milnor incidence presentation of the Calderón--Witt source

The algebraic first-suspension center is not an added analytic target.
It is generated by degree-one source products.  More precisely, the
alternating Calderón--Witt cup induces a surjection

`Λ² A_p¹ → A_p²`.

Consequently `A_p²` is canonically the quotient of `Λ² A_p¹` by the
kernel of the source cup.  This kernel is the exact local
Milnor-incidence relation space.  The result supplies the missing
quadratic relation object needed before attaching arithmetic
differentials or completing the source.
-/

namespace RHTower

noncomputable section

/-! ## The algebraic suspension center is one packet copy -/

/-- First suspension restricted to the algebraic packet and
codomain-restricted to its exact image. -/
def deningerPrimeFinitePacketGaugeAlgebraicFirstMode
    (p : Nat.Primes) :
    DeningerPrimeFinitePacketGaugeAlgebraic p →ₗ[ℂ]
      DeningerPrimeFinitePacketGaugeAlgebraicSuspension p where
  toFun a :=
    ⟨deningerPrimeFinitePacketGaugeSuspensionFirstMode p a.1,
      ⟨a.1, a.2, rfl⟩⟩
  map_add' a b := by
    apply Subtype.ext
    exact map_add
      (deningerPrimeFinitePacketGaugeSuspensionFirstMode p) a.1 b.1
  map_smul' c a := by
    apply Subtype.ext
    exact map_smul
      (deningerPrimeFinitePacketGaugeSuspensionFirstMode p) c a.1

@[simp]
theorem deningerPrimeFinitePacketGaugeAlgebraicFirstMode_coe
    (p : Nat.Primes)
    (a : DeningerPrimeFinitePacketGaugeAlgebraic p) :
    (deningerPrimeFinitePacketGaugeAlgebraicFirstMode p a :
        DeningerPrimeFinitePacketGaugeSuspensionHaarL2 p) =
      deningerPrimeFinitePacketGaugeSuspensionFirstMode p a.1 :=
  rfl

theorem deningerPrimeFinitePacketGaugeAlgebraicFirstMode_injective
    (p : Nat.Primes) :
    Function.Injective
      (deningerPrimeFinitePacketGaugeAlgebraicFirstMode p) := by
  intro a b hab
  apply Subtype.ext
  apply deningerPrimeFinitePacketGaugeSuspensionFirstMode_injective p
  exact congrArg Subtype.val hab

theorem deningerPrimeFinitePacketGaugeAlgebraicFirstMode_surjective
    (p : Nat.Primes) :
    Function.Surjective
      (deningerPrimeFinitePacketGaugeAlgebraicFirstMode p) := by
  intro z
  obtain ⟨a, ha, hza⟩ := z.property
  refine ⟨⟨a, ha⟩, ?_⟩
  apply Subtype.ext
  exact hza

/-- Algebraic packet and algebraic first-suspension center are
canonically linearly equivalent. -/
def deningerPrimeFinitePacketGaugeAlgebraicFirstModeEquiv
    (p : Nat.Primes) :
    DeningerPrimeFinitePacketGaugeAlgebraic p ≃ₗ[ℂ]
      DeningerPrimeFinitePacketGaugeAlgebraicSuspension p :=
  LinearEquiv.ofBijective
    (deningerPrimeFinitePacketGaugeAlgebraicFirstMode p)
    ⟨deningerPrimeFinitePacketGaugeAlgebraicFirstMode_injective p,
      deningerPrimeFinitePacketGaugeAlgebraicFirstMode_surjective p⟩

@[simp]
theorem deningerPrimeFinitePacketGaugeAlgebraicFirstModeEquiv_apply
    (p : Nat.Primes)
    (a : DeningerPrimeFinitePacketGaugeAlgebraic p) :
    deningerPrimeFinitePacketGaugeAlgebraicFirstModeEquiv p a =
      deningerPrimeFinitePacketGaugeAlgebraicFirstMode p a :=
  rfl

/-! ## Cup generation of the center -/

/-- Nonzero arithmetic half-density scale in the cross-effect. -/
def deningerCalderonWittHalfDensityScale
    (p : Nat.Primes) : ℂ :=
  ((deningerPrimePolarizedHalfDensity p : ℝ) : ℂ)

theorem deningerCalderonWittHalfDensityScale_ne_zero
    (p : Nat.Primes) :
    deningerCalderonWittHalfDensityScale p ≠ 0 :=
  Complex.ofReal_ne_zero.mpr
    (deningerPrimePolarizedHalfDensity_pos p).ne'

/-- On the canonical Calderón unit, the source cross-effect is the
nonzero half-density scale times first suspension. -/
theorem deningerMeyerCalderonWittAlgebraicCrossEffect_unit
    (p : Nat.Primes)
    (a : DeningerPrimeFinitePacketGaugeAlgebraic p) :
    deningerMeyerCalderonWittAlgebraicCrossEffect p
        (deningerCalderonWittUnitDefect p) a =
      deningerCalderonWittHalfDensityScale p •
        deningerPrimeFinitePacketGaugeAlgebraicFirstMode p a := by
  apply Subtype.ext
  change
    deningerMeyerPoissonCalderonQuotientEquiv (p : ℝ)
        (deningerCalderonWittUnitDefect p) •
        (deningerCalderonWittHalfDensityScale p •
          deningerPrimeFinitePacketGaugeSuspensionFirstMode p a.1) =
      deningerCalderonWittHalfDensityScale p •
        deningerPrimeFinitePacketGaugeSuspensionFirstMode p a.1
  rw [deningerMeyerPoissonCalderonQuotientEquiv_unitDefect,
    one_smul]

/-- Every algebraic suspension class is a single cup of two
degree-one source classes. -/
theorem deningerCalderonWittAlgebraicCup_exists_eq
    (p : Nat.Primes)
    (z : DeningerCalderonWittAlgebraicDegreeTwo p) :
    ∃ x y : DeningerCalderonWittAlgebraicDegreeOne p,
      deningerCalderonWittAlgebraicCup p x y = z := by
  let a :
      DeningerPrimeFinitePacketGaugeAlgebraic p :=
    (deningerPrimeFinitePacketGaugeAlgebraicFirstModeEquiv p).symm z
  let c : ℂ := deningerCalderonWittHalfDensityScale p
  refine
    ⟨(deningerCalderonWittUnitDefect p, 0),
      (0, c⁻¹ • a), ?_⟩
  change
    deningerMeyerCalderonWittAlgebraicCrossEffect p
        (deningerCalderonWittUnitDefect p) (c⁻¹ • a) -
      deningerMeyerCalderonWittAlgebraicCrossEffect p 0 0 =
        z
  rw [map_zero, sub_zero,
    deningerMeyerCalderonWittAlgebraicCrossEffect_unit,
    map_smul]
  change
    c • (c⁻¹ •
      deningerPrimeFinitePacketGaugeAlgebraicFirstMode p a) =
        z
  rw [← mul_smul, mul_inv_cancel₀
    (deningerCalderonWittHalfDensityScale_ne_zero p), one_smul]
  exact
    (deningerPrimeFinitePacketGaugeAlgebraicFirstModeEquiv p)
      |>.apply_symm_apply z

/-! ## Exterior-square regulator and exact Milnor relations -/

/-- The algebraic source cup vanishes on the diagonal. -/
@[simp]
theorem deningerCalderonWittAlgebraicCup_self
    (p : Nat.Primes)
    (x : DeningerCalderonWittAlgebraicDegreeOne p) :
    deningerCalderonWittAlgebraicCup p x x = 0 := by
  change
    deningerMeyerCalderonWittAlgebraicCrossEffect p x.1 x.2 -
      deningerMeyerCalderonWittAlgebraicCrossEffect p x.1 x.2 =
        0
  rw [sub_self]

/-- The source cup as a two-variable alternating map. -/
def deningerCalderonWittAlgebraicCupAlternating
    (p : Nat.Primes) :
    DeningerCalderonWittAlgebraicDegreeOne p
      [⋀^Fin 2]→ₗ[ℂ]
        DeningerCalderonWittAlgebraicDegreeTwo p where
  toFun v :=
    deningerCalderonWittAlgebraicCup p (v 0) (v 1)
  map_update_add' v i x y := by
    fin_cases i <;> simp
  map_update_smul' v i c x := by
    fin_cases i <;> simp
  map_eq_zero_of_eq' v i j hij hne := by
    fin_cases i <;> fin_cases j
    · exact (hne rfl).elim
    · have hij' : v 0 = v 1 := by simpa using hij
      rw [hij']
      exact deningerCalderonWittAlgebraicCup_self p (v 1)
    · have hij' : v 1 = v 0 := by simpa using hij
      rw [hij']
      exact deningerCalderonWittAlgebraicCup_self p (v 0)
    · exact (hne rfl).elim

@[simp]
theorem deningerCalderonWittAlgebraicCupAlternating_apply
    (p : Nat.Primes)
    (v : Fin 2 → DeningerCalderonWittAlgebraicDegreeOne p) :
    deningerCalderonWittAlgebraicCupAlternating p v =
      deningerCalderonWittAlgebraicCup p (v 0) (v 1) :=
  rfl

/-- Linearized Milnor cup on the exterior square of local degree one. -/
def deningerCalderonWittAlgebraicExteriorCup
    (p : Nat.Primes) :
    (⋀[ℂ]^(2 : ℕ) (DeningerCalderonWittAlgebraicDegreeOne p)) →ₗ[ℂ]
      DeningerCalderonWittAlgebraicDegreeTwo p :=
  exteriorPower.alternatingMapLinearEquiv
    (deningerCalderonWittAlgebraicCupAlternating p)

@[simp]
theorem deningerCalderonWittAlgebraicExteriorCup_ιMulti
    (p : Nat.Primes)
    (v : Fin 2 → DeningerCalderonWittAlgebraicDegreeOne p) :
    deningerCalderonWittAlgebraicExteriorCup p
        (exteriorPower.ιMulti ℂ 2 v) =
      deningerCalderonWittAlgebraicCup p (v 0) (v 1) := by
  exact
    exteriorPower.alternatingMapLinearEquiv_apply_ιMulti
      (deningerCalderonWittAlgebraicCupAlternating p) v

/-- The exterior-square cup generates the entire algebraic suspension
center. -/
theorem deningerCalderonWittAlgebraicExteriorCup_surjective
    (p : Nat.Primes) :
    Function.Surjective
      (deningerCalderonWittAlgebraicExteriorCup p) := by
  intro z
  obtain ⟨x, y, hxy⟩ :=
    deningerCalderonWittAlgebraicCup_exists_eq p z
  let v : Fin 2 → DeningerCalderonWittAlgebraicDegreeOne p :=
    ![x, y]
  refine ⟨exteriorPower.ιMulti ℂ 2 v, ?_⟩
  rw [deningerCalderonWittAlgebraicExteriorCup_ιMulti]
  simpa [v] using hxy

/-- Exact local Milnor-incidence relations: exterior degree-two
classes killed by the source cup. -/
def deningerCalderonWittMilnorIncidence
    (p : Nat.Primes) :
    Submodule ℂ
      (⋀[ℂ]^(2 : ℕ) (DeningerCalderonWittAlgebraicDegreeOne p)) :=
  LinearMap.ker (deningerCalderonWittAlgebraicExteriorCup p)

/-- The Milnor-incidence inclusion followed by cup is exact. -/
theorem deningerCalderonWittMilnorIncidence_exact
    (p : Nat.Primes) :
    Function.Exact
      (deningerCalderonWittMilnorIncidence p).subtype
      (deningerCalderonWittAlgebraicExteriorCup p) :=
  LinearMap.exact_subtype_ker_map
    (deningerCalderonWittAlgebraicExteriorCup p)

/-- **Local source presentation.** The algebraic suspension center is
canonically the exterior square of degree one modulo the exact
Milnor-incidence relations. -/
def deningerCalderonWittMilnorQuotientEquiv
    (p : Nat.Primes) :
    ((⋀[ℂ]^(2 : ℕ) (DeningerCalderonWittAlgebraicDegreeOne p)) ⧸
        deningerCalderonWittMilnorIncidence p) ≃ₗ[ℂ]
      DeningerCalderonWittAlgebraicDegreeTwo p :=
  LinearMap.quotKerEquivOfSurjective
    (deningerCalderonWittAlgebraicExteriorCup p)
    (deningerCalderonWittAlgebraicExteriorCup_surjective p)

@[simp]
theorem deningerCalderonWittMilnorQuotientEquiv_mk
    (p : Nat.Primes)
    (w : ⋀[ℂ]^(2 : ℕ) (DeningerCalderonWittAlgebraicDegreeOne p)) :
    deningerCalderonWittMilnorQuotientEquiv p
        (Submodule.Quotient.mk w) =
      deningerCalderonWittAlgebraicExteriorCup p w :=
  rfl

/-! ## Explicit local Koszul--Green splitting -/

/-- Exterior multiplication on the left by one local degree-one
source class. -/
def deningerCalderonWittExteriorWedgeLeft
    (p : Nat.Primes)
    (x : DeningerCalderonWittAlgebraicDegreeOne p) :
    DeningerCalderonWittAlgebraicDegreeOne p →ₗ[ℂ]
      (⋀[ℂ]^(2 : ℕ) (DeningerCalderonWittAlgebraicDegreeOne p)) :=
  (AlternatingMap.ofSubsingleton ℂ
      (DeningerCalderonWittAlgebraicDegreeOne p)
      (⋀[ℂ]^(2 : ℕ) (DeningerCalderonWittAlgebraicDegreeOne p))
      (0 : Fin 1)).symm
    ((exteriorPower.ιMulti ℂ 2).curryLeft x)

@[simp]
theorem deningerCalderonWittExteriorWedgeLeft_apply
    (p : Nat.Primes)
    (x y : DeningerCalderonWittAlgebraicDegreeOne p) :
    deningerCalderonWittExteriorWedgeLeft p x y =
      exteriorPower.ιMulti ℂ 2 ![x, y] :=
  rfl

/-- Canonical center-to-packet leg, normalized by the inverse
half-density scale. -/
def deningerCalderonWittCenterToDegreeOne
    (p : Nat.Primes) :
    DeningerCalderonWittAlgebraicDegreeTwo p →ₗ[ℂ]
      DeningerCalderonWittAlgebraicDegreeOne p :=
  (LinearMap.inr ℂ
      (DeningerMeyerPrimeCalderonQuotient p)
      (DeningerPrimeFinitePacketGaugeAlgebraic p)).comp
    ((deningerCalderonWittHalfDensityScale p)⁻¹ •
      (deningerPrimeFinitePacketGaugeAlgebraicFirstModeEquiv p).symm.toLinearMap)

@[simp]
theorem deningerCalderonWittCenterToDegreeOne_apply
    (p : Nat.Primes)
    (z : DeningerCalderonWittAlgebraicDegreeTwo p) :
    deningerCalderonWittCenterToDegreeOne p z =
      (0,
        (deningerCalderonWittHalfDensityScale p)⁻¹ •
          (deningerPrimeFinitePacketGaugeAlgebraicFirstModeEquiv p).symm z) :=
  rfl

/-- Explicit source-derived section of the exterior cup. -/
def deningerCalderonWittExteriorCupSection
    (p : Nat.Primes) :
    DeningerCalderonWittAlgebraicDegreeTwo p →ₗ[ℂ]
      (⋀[ℂ]^(2 : ℕ) (DeningerCalderonWittAlgebraicDegreeOne p)) :=
  (deningerCalderonWittExteriorWedgeLeft p
      (deningerCalderonWittUnitDefect p, 0)).comp
    (deningerCalderonWittCenterToDegreeOne p)

/-- **Koszul--Green section law.** Exterior cup retracts its explicit
source section exactly. -/
theorem deningerCalderonWittExteriorCup_section
    (p : Nat.Primes) :
    (deningerCalderonWittAlgebraicExteriorCup p).comp
        (deningerCalderonWittExteriorCupSection p) =
      LinearMap.id := by
  apply LinearMap.ext
  intro z
  rw [LinearMap.comp_apply, deningerCalderonWittExteriorCupSection,
    LinearMap.comp_apply,
    deningerCalderonWittExteriorWedgeLeft_apply,
    deningerCalderonWittAlgebraicExteriorCup_ιMulti]
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one,
    LinearMap.id_apply, deningerCalderonWittCenterToDegreeOne_apply]
  change
    deningerMeyerCalderonWittAlgebraicCrossEffect p
        (deningerCalderonWittUnitDefect p)
        ((deningerCalderonWittHalfDensityScale p)⁻¹ •
          (deningerPrimeFinitePacketGaugeAlgebraicFirstModeEquiv p).symm z) -
      deningerMeyerCalderonWittAlgebraicCrossEffect p 0 0 =
        z
  rw [map_zero, sub_zero,
    deningerMeyerCalderonWittAlgebraicCrossEffect_unit,
    map_smul]
  rw [← mul_smul, mul_inv_cancel₀
    (deningerCalderonWittHalfDensityScale_ne_zero p), one_smul]
  exact
    (deningerPrimeFinitePacketGaugeAlgebraicFirstModeEquiv p)
      |>.apply_symm_apply z

/-- The explicit exterior-cup section is injective. -/
theorem deningerCalderonWittExteriorCupSection_injective
    (p : Nat.Primes) :
    Function.Injective
      (deningerCalderonWittExteriorCupSection p) :=
  Function.LeftInverse.injective (by
    intro z
    have hz := LinearMap.congr_fun
      (deningerCalderonWittExteriorCup_section p) z
    simpa [LinearMap.comp_apply] using hz)

/-- Kernel of the section--cup projection is exactly the
Milnor-incidence relation space. -/
theorem ker_deningerCalderonWittExteriorCupProjection
    (p : Nat.Primes) :
    LinearMap.ker
        ((deningerCalderonWittExteriorCupSection p).comp
          (deningerCalderonWittAlgebraicExteriorCup p)) =
      deningerCalderonWittMilnorIncidence p := by
  ext w
  simp only [LinearMap.mem_ker, LinearMap.comp_apply,
    deningerCalderonWittMilnorIncidence]
  constructor
  · intro hw
    apply deningerCalderonWittExteriorCupSection_injective p
    simpa using hw
  · intro hw
    rw [hw, map_zero]

/-- The exterior square splits exactly into Milnor-incidence
relations and the canonical suspension-center section. -/
theorem deningerCalderonWittMilnorIncidence_isCompl_center
    (p : Nat.Primes) :
    IsCompl
      (deningerCalderonWittMilnorIncidence p)
      (LinearMap.range
        (deningerCalderonWittExteriorCupSection p)) := by
  have hcompl :=
    deningerExactLeg_isCompl
      (iota := deningerCalderonWittExteriorCupSection p)
      (pi := deningerCalderonWittAlgebraicExteriorCup p)
      (deningerCalderonWittExteriorCup_section p)
  rw [deningerLeg,
    ker_deningerCalderonWittExteriorCupProjection p] at hcompl
  exact hcompl

/-! ## Local source Green contraction -/

/-- An injective first differential kills degree-zero cohomology. -/
theorem deningerThreeTermH0_eq_zero_of_injective
    {R A0 A1 A2 : Type*}
    [CommRing R]
    [AddCommGroup A0] [Module R A0]
    [AddCommGroup A1] [Module R A1]
    [AddCommGroup A2] [Module R A2]
    (C : DeningerArithmeticThreeTermComplex R A0 A1 A2)
    (hinjective : Function.Injective C.d0)
    (x : C.H0) :
    x = 0 := by
  apply Subtype.ext
  apply hinjective
  simpa using x.property

/-- Exactness at the middle term kills degree-one cohomology. -/
theorem deningerThreeTermH1_eq_zero_of_exact
    {R A0 A1 A2 : Type*}
    [CommRing R]
    [AddCommGroup A0] [Module R A0]
    [AddCommGroup A1] [Module R A1]
    [AddCommGroup A2] [Module R A2]
    (C : DeningerArithmeticThreeTermComplex R A0 A1 A2)
    (hexact : Function.Exact C.d0 C.d1)
    (q : C.H1) :
    q = 0 := by
  obtain ⟨x, rfl⟩ :=
    Submodule.Quotient.mk_surjective
      (C.boundaries1.comap C.cycles1.subtype) q
  apply (C.H1_mk_eq_zero_iff x).2
  exact (hexact (x : A1)).1 x.property

/-- A surjective last differential kills degree-two cohomology. -/
theorem deningerThreeTermH2_eq_zero_of_surjective
    {R A0 A1 A2 : Type*}
    [CommRing R]
    [AddCommGroup A0] [Module R A0]
    [AddCommGroup A1] [Module R A1]
    [AddCommGroup A2] [Module R A2]
    (C : DeningerArithmeticThreeTermComplex R A0 A1 A2)
    (hsurjective : Function.Surjective C.d1)
    (q : C.H2) :
    q = 0 := by
  obtain ⟨z, rfl⟩ :=
    Submodule.Quotient.mk_surjective C.boundaries2 q
  apply (C.H2_mk_eq_zero_iff z).2
  exact hsurjective z

/-- Retraction onto exact Milnor-incidence relations, obtained by
subtracting the canonical center section. -/
def deningerCalderonWittMilnorGreenRetraction
    (p : Nat.Primes) :
    (⋀[ℂ]^(2 : ℕ) (DeningerCalderonWittAlgebraicDegreeOne p)) →ₗ[ℂ]
      deningerCalderonWittMilnorIncidence p :=
  ((LinearMap.id -
      (deningerCalderonWittExteriorCupSection p).comp
        (deningerCalderonWittAlgebraicExteriorCup p))).codRestrict
    (deningerCalderonWittMilnorIncidence p) (fun w => by
      change
        deningerCalderonWittAlgebraicExteriorCup p
            (w -
              deningerCalderonWittExteriorCupSection p
                (deningerCalderonWittAlgebraicExteriorCup p w)) =
          0
      rw [map_sub]
      have hw := LinearMap.congr_fun
        (deningerCalderonWittExteriorCup_section p)
        (deningerCalderonWittAlgebraicExteriorCup p w)
      simpa [LinearMap.comp_apply] using sub_eq_zero.mpr hw.symm)

@[simp]
theorem deningerCalderonWittMilnorGreenRetraction_coe
    (p : Nat.Primes)
    (w : ⋀[ℂ]^(2 : ℕ) (DeningerCalderonWittAlgebraicDegreeOne p)) :
    (deningerCalderonWittMilnorGreenRetraction p w :
        ⋀[ℂ]^(2 : ℕ) (DeningerCalderonWittAlgebraicDegreeOne p)) =
      w -
        deningerCalderonWittExteriorCupSection p
          (deningerCalderonWittAlgebraicExteriorCup p w) :=
  by
    change
      ((LinearMap.id :
          (⋀[ℂ]^(2 : ℕ) (DeningerCalderonWittAlgebraicDegreeOne p)) →ₗ[ℂ]
            (⋀[ℂ]^(2 : ℕ) (DeningerCalderonWittAlgebraicDegreeOne p))) -
          (deningerCalderonWittExteriorCupSection p).comp
            (deningerCalderonWittAlgebraicExteriorCup p)) w =
        w -
          deningerCalderonWittExteriorCupSection p
            (deningerCalderonWittAlgebraicExteriorCup p w)
    rw [LinearMap.sub_apply, LinearMap.id_apply, LinearMap.comp_apply]

/-- Green retraction is the identity on Milnor-incidence relations. -/
theorem deningerCalderonWittMilnorGreenRetraction_subtype
    (p : Nat.Primes)
    (i : deningerCalderonWittMilnorIncidence p) :
    deningerCalderonWittMilnorGreenRetraction p i.1 = i := by
  apply Subtype.ext
  rw [deningerCalderonWittMilnorGreenRetraction_coe]
  change
    i.1 -
        deningerCalderonWittExteriorCupSection p
          (deningerCalderonWittAlgebraicExteriorCup p i.1) =
      i.1
  rw [i.2, map_zero, sub_zero]

/-- Middle Green contraction identity:
`d₀ h₁ + h₂ d₁ = id`. -/
theorem deningerCalderonWittMilnorGreenContraction_middle
    (p : Nat.Primes)
    (w : ⋀[ℂ]^(2 : ℕ) (DeningerCalderonWittAlgebraicDegreeOne p)) :
    (deningerCalderonWittMilnorIncidence p).subtype
        (deningerCalderonWittMilnorGreenRetraction p w) +
      deningerCalderonWittExteriorCupSection p
        (deningerCalderonWittAlgebraicExteriorCup p w) =
      w := by
  change
    (w -
        deningerCalderonWittExteriorCupSection p
          (deningerCalderonWittAlgebraicExteriorCup p w)) +
      deningerCalderonWittExteriorCupSection p
        (deningerCalderonWittAlgebraicExteriorCup p w) =
      w
  abel

/-- Canonical three-term Milnor relation resolution. -/
def deningerCalderonWittMilnorComplex
    (p : Nat.Primes) :
    DeningerArithmeticThreeTermComplex ℂ
      (deningerCalderonWittMilnorIncidence p)
      (⋀[ℂ]^(2 : ℕ) (DeningerCalderonWittAlgebraicDegreeOne p))
      (DeningerCalderonWittAlgebraicDegreeTwo p) where
  d0 := (deningerCalderonWittMilnorIncidence p).subtype
  d1 := deningerCalderonWittAlgebraicExteriorCup p
  d1_comp_d0 :=
    (deningerCalderonWittMilnorIncidence_exact p).linearMap_comp_eq_zero

/-- Local Milnor relation resolution has trivial degree-zero
cohomology. -/
theorem deningerCalderonWittMilnorComplex_H0_eq_zero
    (p : Nat.Primes)
    (x : (deningerCalderonWittMilnorComplex p).H0) :
    x = 0 :=
  deningerThreeTermH0_eq_zero_of_injective
    (deningerCalderonWittMilnorComplex p)
    (deningerCalderonWittMilnorIncidence p).subtype_injective x

/-- Exact incidence relations kill all middle cohomology. -/
theorem deningerCalderonWittMilnorComplex_H1_eq_zero
    (p : Nat.Primes)
    (q : (deningerCalderonWittMilnorComplex p).H1) :
    q = 0 :=
  deningerThreeTermH1_eq_zero_of_exact
    (deningerCalderonWittMilnorComplex p)
    (deningerCalderonWittMilnorIncidence_exact p) q

/-- Cup surjectivity kills all top cohomology of the relation
resolution. -/
theorem deningerCalderonWittMilnorComplex_H2_eq_zero
    (p : Nat.Primes)
    (q : (deningerCalderonWittMilnorComplex p).H2) :
    q = 0 :=
  deningerThreeTermH2_eq_zero_of_surjective
    (deningerCalderonWittMilnorComplex p)
    (deningerCalderonWittAlgebraicExteriorCup_surjective p) q

/-! ## All-prime Milnor presentation -/

/-- The all-prime algebraic cup vanishes on the diagonal. -/
@[simp]
theorem deningerCalderonWittAlgebraicGlobalCup_self
    (x : DeningerCalderonWittAlgebraicGlobalDegreeOne) :
    deningerCalderonWittAlgebraicGlobalCup x x = 0 := by
  apply DirectSum.ext_component ℂ
  intro p
  rw [deningerCalderonWittAlgebraicGlobalCup_component]
  exact
    deningerCalderonWittAlgebraicCup_self p
      (DirectSum.component ℂ Nat.Primes
        DeningerCalderonWittAlgebraicDegreeOne p x)

/-- All-prime source cup as a two-variable alternating map. -/
def deningerCalderonWittAlgebraicGlobalCupAlternating :
    DeningerCalderonWittAlgebraicGlobalDegreeOne
      [⋀^Fin 2]→ₗ[ℂ]
        DeningerCalderonWittAlgebraicGlobalDegreeTwo where
  toFun v :=
    deningerCalderonWittAlgebraicGlobalCup (v 0) (v 1)
  map_update_add' v i x y := by
    fin_cases i <;> simp
  map_update_smul' v i c x := by
    fin_cases i <;> simp
  map_eq_zero_of_eq' v i j hij hne := by
    fin_cases i <;> fin_cases j
    · exact (hne rfl).elim
    · have hij' : v 0 = v 1 := by simpa using hij
      rw [hij']
      exact deningerCalderonWittAlgebraicGlobalCup_self (v 1)
    · have hij' : v 1 = v 0 := by simpa using hij
      rw [hij']
      exact deningerCalderonWittAlgebraicGlobalCup_self (v 0)
    · exact (hne rfl).elim

/-- Linearized all-prime cup on the exterior square. -/
def deningerCalderonWittAlgebraicGlobalExteriorCup :
    (⋀[ℂ]^(2 : ℕ) DeningerCalderonWittAlgebraicGlobalDegreeOne) →ₗ[ℂ]
      DeningerCalderonWittAlgebraicGlobalDegreeTwo :=
  exteriorPower.alternatingMapLinearEquiv
    deningerCalderonWittAlgebraicGlobalCupAlternating

@[simp]
theorem deningerCalderonWittAlgebraicGlobalExteriorCup_ιMulti
    (v : Fin 2 → DeningerCalderonWittAlgebraicGlobalDegreeOne) :
    deningerCalderonWittAlgebraicGlobalExteriorCup
        (exteriorPower.ιMulti ℂ 2 v) =
      deningerCalderonWittAlgebraicGlobalCup (v 0) (v 1) := by
  change
    exteriorPower.alternatingMapLinearEquiv
        deningerCalderonWittAlgebraicGlobalCupAlternating
        (exteriorPower.ιMulti ℂ 2 v) =
      deningerCalderonWittAlgebraicGlobalCup (v 0) (v 1)
  rw [exteriorPower.alternatingMapLinearEquiv_apply_ιMulti]
  rfl

/-- The all-prime exterior cup generates the whole finite-support
algebraic suspension center. -/
theorem deningerCalderonWittAlgebraicGlobalExteriorCup_surjective :
    Function.Surjective
      deningerCalderonWittAlgebraicGlobalExteriorCup := by
  intro z
  induction z using DirectSum.induction_on with
  | zero =>
      exact ⟨0, map_zero _⟩
  | of p z =>
      rw [← DirectSum.lof_eq_of
        (R := ℂ) (ι := Nat.Primes)
        (M := DeningerCalderonWittAlgebraicDegreeTwo) p z]
      obtain ⟨x, y, hxy⟩ :=
        deningerCalderonWittAlgebraicCup_exists_eq p z
      let v : Fin 2 →
          DeningerCalderonWittAlgebraicGlobalDegreeOne :=
        ![
          DirectSum.lof ℂ Nat.Primes
            DeningerCalderonWittAlgebraicDegreeOne p x,
          DirectSum.lof ℂ Nat.Primes
            DeningerCalderonWittAlgebraicDegreeOne p y]
      refine ⟨exteriorPower.ιMulti ℂ 2 v, ?_⟩
      rw [deningerCalderonWittAlgebraicGlobalExteriorCup_ιMulti]
      simpa [v, hxy]
  | add z w hz hw =>
      obtain ⟨a, ha⟩ := hz
      obtain ⟨b, hb⟩ := hw
      refine ⟨a + b, ?_⟩
      rw [map_add, ha, hb]

/-- Exact all-prime Milnor-incidence relation space. -/
def deningerCalderonWittGlobalMilnorIncidence :
    Submodule ℂ
      (⋀[ℂ]^(2 : ℕ) DeningerCalderonWittAlgebraicGlobalDegreeOne) :=
  LinearMap.ker deningerCalderonWittAlgebraicGlobalExteriorCup

/-- Cross-prime exterior products are exact incidence relations. -/
theorem deningerCalderonWittGlobalCrossPrime_mem_milnorIncidence
    {p q : Nat.Primes}
    (hpq : p ≠ q)
    (x : DeningerCalderonWittAlgebraicDegreeOne p)
    (y : DeningerCalderonWittAlgebraicDegreeOne q) :
    exteriorPower.ιMulti ℂ 2
        ![
          DirectSum.lof ℂ Nat.Primes
            DeningerCalderonWittAlgebraicDegreeOne p x,
          DirectSum.lof ℂ Nat.Primes
            DeningerCalderonWittAlgebraicDegreeOne q y] ∈
      deningerCalderonWittGlobalMilnorIncidence := by
  change
    deningerCalderonWittAlgebraicGlobalExteriorCup
        (exteriorPower.ιMulti ℂ 2
          ![
            DirectSum.lof ℂ Nat.Primes
              DeningerCalderonWittAlgebraicDegreeOne p x,
            DirectSum.lof ℂ Nat.Primes
              DeningerCalderonWittAlgebraicDegreeOne q y]) =
      0
  rw [deningerCalderonWittAlgebraicGlobalExteriorCup_ιMulti]
  exact
    deningerCalderonWittAlgebraicGlobalCup_lof_ne hpq x y

/-- All-prime Milnor-incidence inclusion followed by source cup is
exact. -/
theorem deningerCalderonWittGlobalMilnorIncidence_exact :
    Function.Exact
      deningerCalderonWittGlobalMilnorIncidence.subtype
      deningerCalderonWittAlgebraicGlobalExteriorCup :=
  LinearMap.exact_subtype_ker_map
    deningerCalderonWittAlgebraicGlobalExteriorCup

/-- **All-prime source presentation.** The complete algebraic
finite-support suspension center is exactly the exterior square of
degree one modulo global Milnor-incidence relations. -/
def deningerCalderonWittGlobalMilnorQuotientEquiv :
    ((⋀[ℂ]^(2 : ℕ) DeningerCalderonWittAlgebraicGlobalDegreeOne) ⧸
        deningerCalderonWittGlobalMilnorIncidence) ≃ₗ[ℂ]
      DeningerCalderonWittAlgebraicGlobalDegreeTwo :=
  LinearMap.quotKerEquivOfSurjective
    deningerCalderonWittAlgebraicGlobalExteriorCup
    deningerCalderonWittAlgebraicGlobalExteriorCup_surjective

@[simp]
theorem deningerCalderonWittGlobalMilnorQuotientEquiv_mk
    (w : ⋀[ℂ]^(2 : ℕ) DeningerCalderonWittAlgebraicGlobalDegreeOne) :
    deningerCalderonWittGlobalMilnorQuotientEquiv
        (Submodule.Quotient.mk w) =
      deningerCalderonWittAlgebraicGlobalExteriorCup w :=
  rfl

/-! ## All-prime source Green contraction -/

/-- Exterior multiplication on the left in the all-prime algebraic
source. -/
def deningerCalderonWittGlobalExteriorWedgeLeft
    (x : DeningerCalderonWittAlgebraicGlobalDegreeOne) :
    DeningerCalderonWittAlgebraicGlobalDegreeOne →ₗ[ℂ]
      (⋀[ℂ]^(2 : ℕ) DeningerCalderonWittAlgebraicGlobalDegreeOne) :=
  (AlternatingMap.ofSubsingleton ℂ
      DeningerCalderonWittAlgebraicGlobalDegreeOne
      (⋀[ℂ]^(2 : ℕ) DeningerCalderonWittAlgebraicGlobalDegreeOne)
      (0 : Fin 1)).symm
    ((exteriorPower.ιMulti ℂ 2).curryLeft x)

@[simp]
theorem deningerCalderonWittGlobalExteriorWedgeLeft_apply
    (x y : DeningerCalderonWittAlgebraicGlobalDegreeOne) :
    deningerCalderonWittGlobalExteriorWedgeLeft x y =
      exteriorPower.ιMulti ℂ 2 ![x, y] :=
  rfl

/-- One-prime center section into the global exterior square. -/
def deningerCalderonWittGlobalPrimeExteriorCupSection
    (p : Nat.Primes) :
    DeningerCalderonWittAlgebraicDegreeTwo p →ₗ[ℂ]
      (⋀[ℂ]^(2 : ℕ) DeningerCalderonWittAlgebraicGlobalDegreeOne) :=
  (deningerCalderonWittGlobalExteriorWedgeLeft
      (DirectSum.lof ℂ Nat.Primes
        DeningerCalderonWittAlgebraicDegreeOne p
        (deningerCalderonWittUnitDefect p, 0))).comp
    ((DirectSum.lof ℂ Nat.Primes
      DeningerCalderonWittAlgebraicDegreeOne p).comp
        (deningerCalderonWittCenterToDegreeOne p))

/-- Global exterior cup sends the one-prime section back to that
prime center exactly. -/
theorem deningerCalderonWittGlobalExteriorCup_primeSection
    (p : Nat.Primes) :
    deningerCalderonWittAlgebraicGlobalExteriorCup.comp
        (deningerCalderonWittGlobalPrimeExteriorCupSection p) =
      DirectSum.lof ℂ Nat.Primes
        DeningerCalderonWittAlgebraicDegreeTwo p := by
  apply LinearMap.ext
  intro z
  rw [LinearMap.comp_apply,
    deningerCalderonWittGlobalPrimeExteriorCupSection,
    LinearMap.comp_apply, LinearMap.comp_apply,
    deningerCalderonWittGlobalExteriorWedgeLeft_apply,
    deningerCalderonWittAlgebraicGlobalExteriorCup_ιMulti]
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
  rw [deningerCalderonWittAlgebraicGlobalCup_lof_same]
  apply congrArg
    (DirectSum.lof ℂ Nat.Primes
      DeningerCalderonWittAlgebraicDegreeTwo p)
  have hz := LinearMap.congr_fun
    (deningerCalderonWittExteriorCup_section p) z
  simpa [LinearMap.comp_apply,
    deningerCalderonWittExteriorCupSection,
    deningerCalderonWittExteriorWedgeLeft_apply] using hz

/-- Explicit all-prime section, assembled from finite-support prime
center sections. -/
def deningerCalderonWittGlobalExteriorCupSection :
    DeningerCalderonWittAlgebraicGlobalDegreeTwo →ₗ[ℂ]
      (⋀[ℂ]^(2 : ℕ) DeningerCalderonWittAlgebraicGlobalDegreeOne) :=
  DirectSum.toModule ℂ Nat.Primes
    (⋀[ℂ]^(2 : ℕ) DeningerCalderonWittAlgebraicGlobalDegreeOne)
    deningerCalderonWittGlobalPrimeExteriorCupSection

@[simp]
theorem deningerCalderonWittGlobalExteriorCupSection_lof
    (p : Nat.Primes)
    (z : DeningerCalderonWittAlgebraicDegreeTwo p) :
    deningerCalderonWittGlobalExteriorCupSection
        (DirectSum.lof ℂ Nat.Primes
          DeningerCalderonWittAlgebraicDegreeTwo p z) =
      deningerCalderonWittGlobalPrimeExteriorCupSection p z := by
  rw [deningerCalderonWittGlobalExteriorCupSection,
    DirectSum.toModule_lof]

/-- **All-prime Green section law.** Global exterior cup retracts the
finite-support source section exactly. -/
theorem deningerCalderonWittGlobalExteriorCup_section :
    deningerCalderonWittAlgebraicGlobalExteriorCup.comp
        deningerCalderonWittGlobalExteriorCupSection =
      LinearMap.id := by
  apply DirectSum.linearMap_ext ℂ
  intro p
  apply LinearMap.ext
  intro z
  simp only [LinearMap.comp_apply, LinearMap.id_apply]
  rw [deningerCalderonWittGlobalExteriorCupSection_lof]
  exact LinearMap.congr_fun
    (deningerCalderonWittGlobalExteriorCup_primeSection p) z

/-- Global source Green retraction onto exact Milnor-incidence
relations. -/
def deningerCalderonWittGlobalMilnorGreenRetraction :
    (⋀[ℂ]^(2 : ℕ) DeningerCalderonWittAlgebraicGlobalDegreeOne) →ₗ[ℂ]
      deningerCalderonWittGlobalMilnorIncidence :=
  ((LinearMap.id -
      deningerCalderonWittGlobalExteriorCupSection.comp
        deningerCalderonWittAlgebraicGlobalExteriorCup)).codRestrict
    deningerCalderonWittGlobalMilnorIncidence (fun w => by
      change
        deningerCalderonWittAlgebraicGlobalExteriorCup
            (w -
              deningerCalderonWittGlobalExteriorCupSection
                (deningerCalderonWittAlgebraicGlobalExteriorCup w)) =
          0
      rw [map_sub]
      have hw := LinearMap.congr_fun
        deningerCalderonWittGlobalExteriorCup_section
        (deningerCalderonWittAlgebraicGlobalExteriorCup w)
      simpa [LinearMap.comp_apply] using sub_eq_zero.mpr hw.symm)

@[simp]
theorem deningerCalderonWittGlobalMilnorGreenRetraction_coe
    (w : ⋀[ℂ]^(2 : ℕ) DeningerCalderonWittAlgebraicGlobalDegreeOne) :
    (deningerCalderonWittGlobalMilnorGreenRetraction w :
        ⋀[ℂ]^(2 : ℕ) DeningerCalderonWittAlgebraicGlobalDegreeOne) =
      w -
        deningerCalderonWittGlobalExteriorCupSection
          (deningerCalderonWittAlgebraicGlobalExteriorCup w) := by
  change
    ((LinearMap.id :
        (⋀[ℂ]^(2 : ℕ) DeningerCalderonWittAlgebraicGlobalDegreeOne) →ₗ[ℂ]
          (⋀[ℂ]^(2 : ℕ) DeningerCalderonWittAlgebraicGlobalDegreeOne)) -
      deningerCalderonWittGlobalExteriorCupSection.comp
        deningerCalderonWittAlgebraicGlobalExteriorCup) w =
      w -
        deningerCalderonWittGlobalExteriorCupSection
          (deningerCalderonWittAlgebraicGlobalExteriorCup w)
  rw [LinearMap.sub_apply, LinearMap.id_apply, LinearMap.comp_apply]

/-- Global middle Green contraction identity. -/
theorem deningerCalderonWittGlobalMilnorGreenContraction_middle
    (w : ⋀[ℂ]^(2 : ℕ) DeningerCalderonWittAlgebraicGlobalDegreeOne) :
    deningerCalderonWittGlobalMilnorIncidence.subtype
        (deningerCalderonWittGlobalMilnorGreenRetraction w) +
      deningerCalderonWittGlobalExteriorCupSection
        (deningerCalderonWittAlgebraicGlobalExteriorCup w) =
      w := by
  change
    (w -
        deningerCalderonWittGlobalExteriorCupSection
          (deningerCalderonWittAlgebraicGlobalExteriorCup w)) +
      deningerCalderonWittGlobalExteriorCupSection
        (deningerCalderonWittAlgebraicGlobalExteriorCup w) =
      w
  abel

/-- All-prime exact Milnor relation resolution. -/
def deningerCalderonWittGlobalMilnorComplex :
    DeningerArithmeticThreeTermComplex ℂ
      deningerCalderonWittGlobalMilnorIncidence
      (⋀[ℂ]^(2 : ℕ) DeningerCalderonWittAlgebraicGlobalDegreeOne)
      DeningerCalderonWittAlgebraicGlobalDegreeTwo where
  d0 := deningerCalderonWittGlobalMilnorIncidence.subtype
  d1 := deningerCalderonWittAlgebraicGlobalExteriorCup
  d1_comp_d0 :=
    deningerCalderonWittGlobalMilnorIncidence_exact.linearMap_comp_eq_zero

theorem deningerCalderonWittGlobalMilnorComplex_H0_eq_zero
    (x : deningerCalderonWittGlobalMilnorComplex.H0) :
    x = 0 :=
  deningerThreeTermH0_eq_zero_of_injective
    deningerCalderonWittGlobalMilnorComplex
    deningerCalderonWittGlobalMilnorIncidence.subtype_injective x

theorem deningerCalderonWittGlobalMilnorComplex_H1_eq_zero
    (x : deningerCalderonWittGlobalMilnorComplex.H1) :
    x = 0 :=
  deningerThreeTermH1_eq_zero_of_exact
    deningerCalderonWittGlobalMilnorComplex
    deningerCalderonWittGlobalMilnorIncidence_exact x

theorem deningerCalderonWittGlobalMilnorComplex_H2_eq_zero
    (x : deningerCalderonWittGlobalMilnorComplex.H2) :
    x = 0 :=
  deningerThreeTermH2_eq_zero_of_surjective
    deningerCalderonWittGlobalMilnorComplex
    deningerCalderonWittAlgebraicGlobalExteriorCup_surjective x

end

