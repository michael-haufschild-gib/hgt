import GaloisForLFunctions.RHTower.Deninger.DeningerRootChain

/-!
# The rationalization of a cyclic group

The rationalization of a cyclic group has no homology in degrees at least two: it is the increasing
union of the cyclic subgroups generated by the iterated roots of a generator, and each of those is
infinite cyclic unless the whole rationalization is trivial.

* `deningerBau_isZero_of_cyclic` : the vanishing.
-/

namespace RHTower

open CategoryTheory CategoryTheory.Limits

universe u

/-- **The rationalization of a cyclic group has no homology in degrees at least two.** -/
theorem deningerBau_isZero_of_cyclic (k : Type u) [CommRing k] {α : Type u} [Group α] (g : α)
    (hgen : ∀ a : α, a ∈ Subgroup.zpowers g) (n : ℕ) :
    IsZero (groupHomology (Rep.trivial k (DeningerBau α) k) (n + 2)) := by
  classical
  by_cases hg : DeningerBau.of g = 1
  · have hbot : (⊥ : Subgroup (DeningerBau α)) = ⊤ := by
      refine DeningerBau.eq_top_of_rootClosed _ (fun m x hx => ?_) (fun a => ?_)
      · rw [Subgroup.mem_bot] at hx
        subst hx
        rw [Subgroup.mem_bot]
        refine DeningerBau.torsionFree _ (m + 1) (by omega) ?_
        rw [DeningerBau.root_pow]
      · rw [Subgroup.mem_bot]
        obtain ⟨t, ht⟩ := hgen a
        rw [← ht]
        show DeningerBau.of (g ^ t) = 1
        rw [map_zpow, hg, one_zpow]
    haveI : Subsingleton (DeningerBau α) := by
      constructor
      intro x y
      have hx : x ∈ (⊥ : Subgroup (DeningerBau α)) := by rw [hbot]; trivial
      have hy : y ∈ (⊥ : Subgroup (DeningerBau α)) := by rw [hbot]; trivial
      rw [Subgroup.mem_bot] at hx hy
      rw [hx, hy]
    exact isZero_groupHomology_succ_of_subsingleton _ (n + 1)
  · have hdir : Directed (· ≤ ·) (fun m => Subgroup.zpowers (deningerRootChain g m)) :=
      (deningerRootChain_zpowers_mono g).directed_le
    refine deningerIsZero_of_iUnion_cyclic k (DeningerBau α) _
      (deningerRootChain_zpowers_mono g) (fun y => ?_)
      (deningerRootChain_zpowers_equiv g hg) n
    have hy : y ∈ (⨆ m, Subgroup.zpowers (deningerRootChain g m)) := by
      rw [deningerRootChain_iSup_eq_top g hgen]
      trivial
    rw [Subgroup.mem_iSup_of_directed hdir] at hy
    exact hy

end RHTower
