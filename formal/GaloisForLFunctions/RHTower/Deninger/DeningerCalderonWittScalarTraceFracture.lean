import GaloisForLFunctions.RHTower.Deninger.DeningerCalderonWittDerivedCupSource
import GaloisForLFunctions.RHTower.Deninger.DeningerPacketFrobeniusQuotientNontrivial
import GaloisForLFunctions.HTGeometry.DerivedPolarizationLaw
import Mathlib.Topology.UrysohnsLemma

/-!
# Scalar-trace fracture of the Calderón--Witt cup

The affine rational-Witt packet limit is nontrivial at every prime.  Its
full-support Haar `L²` carrier therefore contains two linearly independent
continuous packets.  By contrast, the local Meyer--Poisson Calderón quotient
is one-dimensional.

The scalar-trace rank fracture then applies: no scalar trace of the
vector-valued Calderón--Witt cross-effect can induce a nondegenerate
alternating cup.  The degree-two packet, or a genuinely family-valued trace,
must survive until polarization.  Scalarization before polarization loses a
source direction unconditionally.
-/

open Set

namespace RHTower

noncomputable section

/-- The affine gauge limit is nontrivial because it is a torsor for the
nontrivial concrete Frobenius packet quotient. -/
noncomputable instance deningerPrimeFinitePacketGaugeLimitNontrivial
    (p : Nat.Primes) :
    Nontrivial (DeningerPrimeFinitePacketGaugeLimit p) := by
  let e :
      DeningerPacketFrobeniusQuotient p ≃
        DeningerPrimeFinitePacketGaugeLimit p :=
    (deningerPrimePacketFiniteLimitHomeomorph p).toEquiv.trans
      (deningerPrimeFinitePacketGaugeLimitEquiv p)
  exact Equiv.nontrivial e.symm

/--
Every local rational-Witt Haar packet contains two independent directions.
The proof separates two affine packet points by a continuous function and
uses full support of Haar measure to preserve independence in `L²`.
-/
theorem exists_deningerPrimeFinitePacketGaugeComplexHaarL2_independent_pair
    (p : Nat.Primes) :
    ∃ packet : Fin 2 →
        DeningerPrimeFinitePacketGaugeComplexHaarL2 p,
      LinearIndependent ℂ packet := by
  let X := DeningerPrimeFinitePacketGaugeLimit p
  obtain ⟨x, y, hxy⟩ := exists_pair_ne X
  have hdisjoint : Disjoint ({x} : Set X) {y} := by
    simpa [Set.disjoint_singleton] using hxy
  obtain ⟨f, hfx, hfy, _hf⟩ :=
    exists_continuous_zero_one_of_isClosed
      (isClosed_singleton : IsClosed ({x} : Set X))
      (isClosed_singleton : IsClosed ({y} : Set X))
      hdisjoint
  let fC : C(X, ℂ) :=
    { toFun := fun z => (f z : ℂ)
      continuous_toFun := Complex.continuous_ofReal.comp f.continuous }
  let packetC : Fin 2 → C(X, ℂ) :=
    ![1, fC]
  have hfx0 : fC x = 0 := by
    have hxR : f x = 0 := by
      simpa using hfx (Set.mem_singleton x)
    change (f x : ℂ) = 0
    rw [hxR]
    simp
  have hfy1 : fC y = 1 := by
    have hyR : f y = 1 := by
      simpa using hfy (Set.mem_singleton y)
    change (f y : ℂ) = 1
    rw [hyR]
    simp
  have hpacketC : LinearIndependent ℂ packetC := by
    rw [linearIndependent_fin2]
    constructor
    · intro hzero
      have hy := DFunLike.congr_fun hzero y
      simp [packetC, hfy1] at hy
    · intro c hscalar
      have hx := DFunLike.congr_fun hscalar x
      simp [packetC, hfx0] at hx
  let toL2 :
      C(X, ℂ) →L[ℂ]
        DeningerPrimeFinitePacketGaugeComplexHaarL2 p :=
    ContinuousMap.toLp 2
      (deningerPrimeFinitePacketGaugeHaarMeasure p) ℂ
  have htoL2 : Function.Injective toL2 :=
    ContinuousMap.toLp_injective
      (deningerPrimeFinitePacketGaugeHaarMeasure p)
  refine ⟨fun i => toL2 (packetC i), ?_⟩
  simpa [Function.comp_def] using
    hpacketC.map' toL2.toLinearMap
      (LinearMap.ker_eq_bot.mpr htoL2)

/-- The local Meyer--Poisson Calderón quotient is generated by its canonical
unit defect. -/
theorem deningerMeyerPrimeCalderonQuotient_span_unitDefect
    (p : Nat.Primes)
    (q : DeningerMeyerPrimeCalderonQuotient p) :
    ∃ c : ℂ, q = c • deningerCalderonWittUnitDefect p := by
  let e := deningerMeyerPoissonCalderonQuotientEquiv (p : ℝ)
  refine ⟨e q, ?_⟩
  apply e.injective
  rw [map_smul,
    deningerMeyerPoissonCalderonQuotientEquiv_unitDefect]
  simp

/--
**Calderón--Witt scalar-trace fracture.**  At every prime, every scalar trace
of the actual vector-valued source cross-effect has a degenerate alternating
cup.  A faithful cup must remain packet-valued or retain more than one test.
-/
theorem deningerCalderonWitt_no_scalar_trace_nondegenerate
    (p : Nat.Primes)
    (trace : DeningerCalderonWittDegreeTwo p →ₗ[ℂ] ℂ) :
    ¬(GaloisForLFunctions.HTGeometry.tracedMixedSourceCup
        (deningerMeyerCalderonGaugePacketCrossEffect p)
        trace).Nondegenerate := by
  obtain ⟨packet, hpacket⟩ :=
    exists_deningerPrimeFinitePacketGaugeComplexHaarL2_independent_pair p
  exact
    GaloisForLFunctions.HTGeometry.no_scalar_tracedMixedSourceCup_of_oneDimensional_left
      (deningerMeyerCalderonGaugePacketCrossEffect p)
      trace
      (deningerCalderonWittUnitDefect p)
      (deningerMeyerPrimeCalderonQuotient_span_unitDefect p)
      packet hpacket

end

end RHTower
