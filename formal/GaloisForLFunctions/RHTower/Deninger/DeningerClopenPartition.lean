import Mathlib.Topology.Clopen
import Mathlib.Topology.Separation.Profinite

/-!
# Refining a finite clopen cover to a finite clopen partition

The atoms of the Boolean algebra generated by a finite family of clopen sets are the loci where the
membership pattern is prescribed.  They are clopen, pairwise disjoint, cover the space, and each
nonempty one is contained in a member of the family.  So a finite clopen cover of a space is
refined by a finite clopen partition — the step that turns a box refinement over a profinite factor
into a partition on which a transverse partition of unity can be assembled.

* `deningerAtom` : the locus of a prescribed membership pattern.
* `deningerAtom_isClopen`, `deningerAtom_pairwiseDisjoint`, `deningerAtom_existsUnique` : the atoms
  form a clopen partition.
* `deningerClopenPartition` : the refinement statement.
-/

namespace RHTower

open Set

section ClopenPartition

variable {B : Type*} [TopologicalSpace B] {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The locus where the membership pattern in a finite family is exactly the prescribed one. -/
def deningerAtom (C : ι → Set B) (T : Finset (ι)) : Set B :=
  {b : B | ∀ j : ι, j ∈ T ↔ b ∈ C j}

omit [TopologicalSpace B] in
theorem deningerAtom_eq (C : ι → Set B) (T : Finset (ι)) :
    deningerAtom C T = (⋂ j ∈ T, C j) ∩ ⋂ j ∈ (Tᶜ : Finset (ι)), (C j)ᶜ := by
  ext b
  simp only [deningerAtom, mem_setOf_eq, mem_inter_iff, mem_iInter, Finset.mem_compl,
    mem_compl_iff]
  constructor
  · intro h
    exact ⟨fun j hj => (h j).mp hj, fun j hj hb => hj ((h j).mpr hb)⟩
  · rintro ⟨h1, h2⟩ j
    refine ⟨fun hj => h1 j hj, fun hb => ?_⟩
    by_contra hj
    exact h2 j hj hb

/-- **The atoms are clopen.** -/
theorem deningerAtom_isClopen {C : ι → Set B} (hC : ∀ j, IsClopen (C j))
    (T : Finset (ι)) : IsClopen (deningerAtom C T) := by
  rw [deningerAtom_eq]
  exact (isClopen_biInter_finset fun j _ => hC j).inter
    (isClopen_biInter_finset fun j _ => (hC j).compl)

omit [TopologicalSpace B] [Fintype ι] [DecidableEq ι] in
/-- **The atoms are pairwise disjoint.** -/
theorem deningerAtom_pairwiseDisjoint (C : ι → Set B) {T T' : Finset (ι)} (h : T ≠ T') :
    Disjoint (deningerAtom C T) (deningerAtom C T') := by
  rw [Set.disjoint_left]
  intro b hb hb'
  refine h (Finset.ext fun j => ?_)
  rw [hb j, ← hb' j]

omit [TopologicalSpace B] [DecidableEq ι] in
/-- **Every point lies in exactly one atom.** -/
theorem deningerAtom_existsUnique (C : ι → Set B) (b : B) :
    ∃! T : Finset (ι), b ∈ deningerAtom C T := by
  classical
  refine ⟨Finset.univ.filter fun j => b ∈ C j, ?_, ?_⟩
  · intro j
    simp
  · intro T hT
    refine Finset.ext fun j => ?_
    rw [Finset.mem_filter, hT j]
    simp

omit [TopologicalSpace B] [Fintype ι] [DecidableEq ι] in
/-- **A nonempty pattern places the atom inside a member of the family.** -/
theorem deningerAtom_subset {C : ι → Set B} {T : Finset (ι)} {j : ι} (hj : j ∈ T) :
    deningerAtom C T ⊆ C j := fun _ hb => (hb j).mp hj

omit [TopologicalSpace B] [Fintype ι] [DecidableEq ι] in
/-- **The empty pattern is empty when the family covers.** -/
theorem deningerAtom_empty_of_cover {C : ι → Set B} (hcover : ∀ b : B, ∃ j, b ∈ C j) :
    deningerAtom C ∅ = ∅ := by
  ext b
  simp only [deningerAtom, mem_setOf_eq, mem_empty_iff_false, iff_false]
  intro h
  obtain ⟨j, hj⟩ := hcover b
  exact absurd ((h j).mpr hj) (Finset.notMem_empty j)

/-- **A finite clopen cover is refined by a finite clopen partition.**  The partition is by the
atoms of the Boolean algebra generated by the cover: each is clopen, they are pairwise disjoint,
every point lies in exactly one, and each is contained in a member of the cover. -/
theorem deningerClopenPartition [Nonempty ι] {C : ι → Set B} (hC : ∀ j, IsClopen (C j))
    (hcover : ∀ b : B, ∃ j, b ∈ C j) :
    ∃ f : Finset (ι) → ι,
      (∀ T, IsClopen (deningerAtom C T))
        ∧ (∀ T, deningerAtom C T ⊆ C (f T))
        ∧ (∀ T T' : Finset (ι), T ≠ T' →
            Disjoint (deningerAtom C T) (deningerAtom C T'))
        ∧ ∀ b : B, ∃! T : Finset (ι), b ∈ deningerAtom C T := by
  classical
  refine ⟨fun T => if h : T.Nonempty then h.choose else Classical.arbitrary ι, fun T => ?_, fun T => ?_,
    fun T T' h => deningerAtom_pairwiseDisjoint C h, deningerAtom_existsUnique C⟩
  · exact deningerAtom_isClopen hC T
  · dsimp only
    split_ifs with h
    · exact deningerAtom_subset h.choose_spec
    · rw [Finset.not_nonempty_iff_eq_empty.mp h, deningerAtom_empty_of_cover hcover]
      exact Set.empty_subset _

end ClopenPartition

end RHTower
