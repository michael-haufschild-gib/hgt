import GaloisForLFunctions.RHTower.XiHedenmalmMultiplicityChain

/-!
# Completed-Xi entire-quotient comparison cohomology

Finite Cauchy packets give the arithmetic trace pairing but are not stable under the Frobenius
generator: coordinate multiplication creates polynomial boundary terms.  The intrinsic algebraic
middle cohomology is instead the quotient

`H¹_ent = Entire(ℂ) / XiC · Entire(ℂ)`.

This definition uses the completed zeta function itself, hence the prime--Gamma source, but no
zero enumeration.  Multiplication by `1/2 + I*z` descends automatically and supplies Deninger's
Frobenius generator.  The removable Xi divided chains give the corresponding Jordan chains only
after the quotient has been constructed.

This is an analytic completed-Xi comparison carrier.  Because `XiC` is built into the quotient,
it is not the independently constructed arithmetic source carrier required by Deninger's program.
Comparing a source-native coefficient with this quotient, and then transporting its cup/Hodge
topology, remain separate obligations.
-/

open Complex

namespace RHTower

noncomputable section

/-- Entire complex functions as a source algebra under pointwise operations. -/
def deningerEntireSubalgebra : Subalgebra ℂ (ℂ → ℂ) where
  carrier := {F | Differentiable ℂ F}
  zero_mem' := differentiable_const 0
  one_mem' := differentiable_const 1
  add_mem' := fun hF hG => hF.add hG
  mul_mem' := fun hF hG => hF.mul hG
  algebraMap_mem' := fun c => by
    change Differentiable ℂ (fun _ : ℂ => c)
    exact differentiable_const c

/-- Algebra of entire complex functions. -/
abbrev DeningerEntire := deningerEntireSubalgebra

/-- Evaluate an entire source at a complex point. -/
instance deningerEntireCoeFun : CoeFun DeningerEntire (fun _ => ℂ → ℂ) :=
  ⟨fun F => F.1⟩

@[ext]
theorem DeningerEntire.ext {F G : DeningerEntire}
    (h : ∀ z, F z = G z) : F = G :=
  Subtype.ext (funext h)

@[simp]
theorem deningerEntire_zero_apply (z : ℂ) :
    (0 : DeningerEntire) z = 0 :=
  rfl

@[simp]
theorem deningerEntire_one_apply (z : ℂ) :
    (1 : DeningerEntire) z = 1 :=
  rfl

@[simp]
theorem deningerEntire_add_apply (F G : DeningerEntire) (z : ℂ) :
    (F + G) z = F z + G z :=
  rfl

@[simp]
theorem deningerEntire_sub_apply (F G : DeningerEntire) (z : ℂ) :
    (F - G) z = F z - G z :=
  rfl

@[simp]
theorem deningerEntire_mul_apply (F G : DeningerEntire) (z : ℂ) :
    (F * G) z = F z * G z :=
  rfl

@[simp]
theorem deningerEntire_smul_apply (c : ℂ) (F : DeningerEntire) (z : ℂ) :
    (c • F) z = c * F z :=
  rfl

@[simp]
theorem deningerEntire_algebraMap_apply (c z : ℂ) :
    (algebraMap ℂ DeningerEntire c) z = c :=
  rfl

/-- The completed Xi source as an element of the entire-function algebra. -/
def deningerEntireXi : DeningerEntire :=
  ⟨XiC, fun z => (XiC_analytic z (Set.mem_univ z)).differentiableAt⟩

@[simp]
theorem deningerEntireXi_apply (z : ℂ) :
    (deningerEntireXi : ℂ → ℂ) z = XiC z :=
  rfl

/-- Complex coordinate in the entire-function algebra. -/
def deningerEntireCoordinate : DeningerEntire :=
  ⟨fun z => z, differentiable_id⟩

@[simp]
theorem deningerEntireCoordinate_apply (z : ℂ) :
    (deningerEntireCoordinate : ℂ → ℂ) z = z :=
  rfl

/-- Deninger's weight-one coordinate `s = 1/2 + I*z`. -/
def deningerEntireThetaCoordinate : DeningerEntire :=
  (1 / 2 : ℂ) • (1 : DeningerEntire) +
    Complex.I • deningerEntireCoordinate

@[simp]
theorem deningerEntireThetaCoordinate_apply (z : ℂ) :
    (deningerEntireThetaCoordinate : ℂ → ℂ) z =
      1 / 2 + Complex.I * z := by
  change (1 / 2 : ℂ) * 1 + Complex.I * z = 1 / 2 + Complex.I * z
  ring

/-- Principal source ideal generated by the completed Xi function. -/
def deningerEntireXiIdeal : Ideal DeningerEntire :=
  Ideal.span {deningerEntireXi}

/--
Algebraic completed-Xi comparison cohomology, constructed without indexing Xi zeros but not
independently of `XiC`.
-/
abbrev DeningerEntireH1 :=
  DeningerEntire ⧸ deningerEntireXiIdeal

/-- Canonical cohomology class of an entire source. -/
def deningerEntireH1Class :
    DeningerEntire →ₐ[ℂ] DeningerEntireH1 :=
  Ideal.Quotient.mkₐ ℂ deningerEntireXiIdeal

@[simp]
theorem deningerEntireH1Class_Xi :
    deningerEntireH1Class deningerEntireXi = 0 := by
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  exact Ideal.mem_span_singleton_self deningerEntireXi

/-- Coordinate class in middle cohomology. -/
def deningerEntireCoordinateClass : DeningerEntireH1 :=
  deningerEntireH1Class deningerEntireCoordinate

/-- The source-defined Frobenius coordinate in middle cohomology. -/
def deningerEntireThetaClass : DeningerEntireH1 :=
  algebraMap ℂ DeningerEntireH1 (1 / 2) +
    algebraMap ℂ DeningerEntireH1 Complex.I *
      deningerEntireCoordinateClass

/-- The Frobenius class is `1/2 + I` times the coordinate class. -/
theorem deningerEntireThetaClass_eq :
    deningerEntireThetaClass =
      algebraMap ℂ DeningerEntireH1 (1 / 2) +
        algebraMap ℂ DeningerEntireH1 Complex.I *
          deningerEntireCoordinateClass := by
  rfl

/-- The quotient of the source theta coordinate is the displayed Frobenius class. -/
theorem deningerEntireH1Class_thetaCoordinate :
    deningerEntireH1Class deningerEntireThetaCoordinate =
      deningerEntireThetaClass := by
  rw [deningerEntireThetaCoordinate, deningerEntireThetaClass,
    deningerEntireCoordinateClass]
  change
    deningerEntireH1Class
      ((algebraMap ℂ DeningerEntire) (1 / 2) * 1 +
        (algebraMap ℂ DeningerEntire) Complex.I *
          deningerEntireCoordinate) =
      algebraMap ℂ DeningerEntireH1 (1 / 2) +
        algebraMap ℂ DeningerEntireH1 Complex.I *
          deningerEntireH1Class deningerEntireCoordinate
  exact map_add deningerEntireH1Class _ _ |>.trans <| by
    rw [map_mul deningerEntireH1Class, map_one deningerEntireH1Class,
      deningerEntireH1Class.commutes, mul_one,
      map_mul deningerEntireH1Class, deningerEntireH1Class.commutes]

/-- Frobenius-flow generator on algebraic middle cohomology. -/
def deningerEntireTheta : Module.End ℂ DeningerEntireH1 :=
  LinearMap.mulLeft ℂ deningerEntireThetaClass

@[simp]
theorem deningerEntireTheta_apply (x : DeningerEntireH1) :
    deningerEntireTheta x = deningerEntireThetaClass * x :=
  rfl

/-- Every removable Xi divided chain is an entire source. -/
def deningerEntireDividedChain (alpha : ℂ) (k : ℕ) : DeningerEntire :=
  ⟨xiThetaDividedChain alpha k,
    fun z => (xiThetaDividedChain_analyticAt alpha k z).differentiableAt⟩

@[simp]
theorem deningerEntireDividedChain_apply (alpha : ℂ) (k : ℕ) (z : ℂ) :
    (deningerEntireDividedChain alpha k : ℂ → ℂ) z =
      xiThetaDividedChain alpha k z :=
  rfl

@[simp]
theorem deningerEntireDividedChain_zero (alpha : ℂ) :
    deningerEntireDividedChain alpha 0 = deningerEntireXi := by
  apply Subtype.ext
  exact xiThetaDividedChain_zero alpha

/-- Cohomology class of the `k`th removable Xi divided chain. -/
def deningerEntireDividedChainClass (alpha : ℂ) (k : ℕ) :
    DeningerEntireH1 :=
  deningerEntireH1Class (deningerEntireDividedChain alpha k)

@[simp]
theorem deningerEntireDividedChainClass_zero (alpha : ℂ) :
    deningerEntireDividedChainClass alpha 0 = 0 := by
  rw [deningerEntireDividedChainClass, deningerEntireDividedChain_zero,
    deningerEntireH1Class_Xi]

/-- Coordinate multiplication gives the exact entire-function Jordan recurrence. -/
theorem deningerEntireCoordinate_mul_dividedChain
    (rho : XiDivisorSupport) {k : ℕ}
    (hk : k < xiSupportMultiplicity rho) :
    deningerEntireCoordinate *
        deningerEntireDividedChain (xiSpectralPointSupport rho) (k + 1) =
      (xiSpectralPointSupport rho : ℂ) •
          deningerEntireDividedChain (xiSpectralPointSupport rho) (k + 1) +
        deningerEntireDividedChain (xiSpectralPointSupport rho) k := by
  apply Subtype.ext
  funext z
  change z * xiThetaDividedChain (xiSpectralPointSupport rho) (k + 1) z =
    xiSpectralPointSupport rho *
        xiThetaDividedChain (xiSpectralPointSupport rho) (k + 1) z +
      xiThetaDividedChain (xiSpectralPointSupport rho) k z
  exact xiThetaDividedChain_multiplication_step rho hk z

/-- The weight-one coordinate acts on each source divided chain by the expected Jordan law. -/
theorem deningerEntireThetaCoordinate_mul_dividedChain
    (rho : XiDivisorSupport) {k : ℕ}
    (hk : k < xiSupportMultiplicity rho) :
    deningerEntireThetaCoordinate *
        deningerEntireDividedChain (xiSpectralPointSupport rho) (k + 1) =
      (1 / 2 + Complex.I * xiSpectralPointSupport rho) •
          deningerEntireDividedChain (xiSpectralPointSupport rho) (k + 1) +
        Complex.I •
          deningerEntireDividedChain (xiSpectralPointSupport rho) k := by
  rw [deningerEntireThetaCoordinate, add_mul]
  simp only [Algebra.smul_def]
  rw [show
      (algebraMap ℂ DeningerEntire) Complex.I * deningerEntireCoordinate *
          deningerEntireDividedChain (xiSpectralPointSupport rho) (k + 1) =
        (algebraMap ℂ DeningerEntire) Complex.I *
          (deningerEntireCoordinate *
            deningerEntireDividedChain
              (xiSpectralPointSupport rho) (k + 1)) by
      rw [mul_assoc],
    deningerEntireCoordinate_mul_dividedChain rho hk]
  simp only [Algebra.smul_def, map_add, map_mul]
  ring

/-- The source quotient carries the full multiplicity-exact Jordan recurrence. -/
theorem deningerEntireTheta_dividedChainClass
    (rho : XiDivisorSupport) {k : ℕ}
    (hk : k < xiSupportMultiplicity rho) :
    deningerEntireTheta
        (deningerEntireDividedChainClass
          (xiSpectralPointSupport rho) (k + 1)) =
      (1 / 2 + Complex.I * xiSpectralPointSupport rho) •
          deningerEntireDividedChainClass
            (xiSpectralPointSupport rho) (k + 1) +
        Complex.I •
          deningerEntireDividedChainClass
            (xiSpectralPointSupport rho) k := by
  change
    deningerEntireThetaClass *
        deningerEntireH1Class
          (deningerEntireDividedChain (xiSpectralPointSupport rho) (k + 1)) =
      (1 / 2 + Complex.I * xiSpectralPointSupport rho) •
          deningerEntireH1Class
            (deningerEntireDividedChain (xiSpectralPointSupport rho) (k + 1)) +
        Complex.I •
          deningerEntireH1Class
            (deningerEntireDividedChain (xiSpectralPointSupport rho) k)
  rw [← deningerEntireH1Class_thetaCoordinate]
  have h := congrArg deningerEntireH1Class
    (deningerEntireThetaCoordinate_mul_dividedChain rho hk)
  simpa only [map_mul, map_add, Algebra.smul_def, AlgHom.commutes] using! h

/--
The terminal multiplicity-depth divided chain is a nonzero cohomology class.  Evaluation at its
base point rules out divisibility by `XiC`.
-/
theorem deningerEntireDividedChainClass_multiplicity_ne_zero
    (rho : XiDivisorSupport) :
    deningerEntireDividedChainClass
      (xiSpectralPointSupport rho) (xiSupportMultiplicity rho) ≠ 0 := by
  intro hzero
  have hmem :
      deningerEntireDividedChain
          (xiSpectralPointSupport rho) (xiSupportMultiplicity rho) ∈
        deningerEntireXiIdeal := by
    exact Ideal.Quotient.eq_zero_iff_mem.mp hzero
  rw [deningerEntireXiIdeal, Ideal.mem_span_singleton'] at hmem
  obtain ⟨G, hG⟩ := hmem
  have heval := congrArg
    (fun F : DeningerEntire =>
      (F : ℂ → ℂ) (xiSpectralPointSupport rho)) hG
  have hXi :
      XiC (xiSpectralPointSupport rho) = 0 := by
    simpa only [xiThetaDividedChain_zero] using
      xiThetaDividedChain_vanish_before_multiplicity rho
        (xiSupportMultiplicity_pos rho)
  have hterminal :=
    xiThetaDividedChain_nonzero_at_multiplicity rho
  apply hterminal
  simpa [deningerEntireXi_apply, deningerEntireDividedChain_apply, hXi] using heval.symm

/--
Every source-defined Xi divisor produces a genuine Frobenius eigenvector in algebraic middle
cohomology.  The proof chooses the first nonzero class in the multiplicity-exact divided chain;
the preceding class then vanishes, so the Jordan recurrence becomes an eigenvector equation.
-/
theorem exists_deningerEntireTheta_eigenvector
    (rho : XiDivisorSupport) :
    ∃ x : DeningerEntireH1,
      x ≠ 0 ∧
        deningerEntireTheta x =
          (1 / 2 + Complex.I * xiSpectralPointSupport rho) • x := by
  classical
  have hex :
      ∃ j : ℕ,
        deningerEntireDividedChainClass
          (xiSpectralPointSupport rho) j ≠ 0 :=
    ⟨xiSupportMultiplicity rho,
      deningerEntireDividedChainClass_multiplicity_ne_zero rho⟩
  have hfind0 : Nat.find hex ≠ 0 := by
    intro hzero
    have hnonzero := Nat.find_spec hex
    rw [hzero, deningerEntireDividedChainClass_zero] at hnonzero
    exact hnonzero rfl
  obtain ⟨k, hfind⟩ := Nat.exists_eq_succ_of_ne_zero hfind0
  have hclass :
      deningerEntireDividedChainClass
        (xiSpectralPointSupport rho) (k + 1) ≠ 0 := by
    have hnonzero := Nat.find_spec hex
    rw [hfind] at hnonzero
    simpa only [Nat.succ_eq_add_one] using hnonzero
  have hkmult : k < xiSupportMultiplicity rho := by
    have hle :
        Nat.find hex ≤ xiSupportMultiplicity rho :=
      Nat.find_min' hex
        (deningerEntireDividedChainClass_multiplicity_ne_zero rho)
    omega
  have hkzero :
      deningerEntireDividedChainClass
        (xiSpectralPointSupport rho) k = 0 := by
    by_contra hk
    have hle : Nat.find hex ≤ k := Nat.find_min' hex hk
    omega
  refine ⟨deningerEntireDividedChainClass
      (xiSpectralPointSupport rho) (k + 1), hclass, ?_⟩
  rw [deningerEntireTheta_dividedChainClass rho hkmult]
  rw [hkzero]
  have hsourceZero :
      Complex.I • (0 : DeningerEntire) = 0 := by
    apply DeningerEntire.ext
    intro z
    simp only [deningerEntire_smul_apply, deningerEntire_zero_apply,
      mul_zero]
  have hIzero : Complex.I • (0 : DeningerEntireH1) = 0 := by
    calc
      Complex.I • (0 : DeningerEntireH1) =
          Complex.I • deningerEntireH1Class (0 : DeningerEntire) := by
            rw [map_zero]
      _ = deningerEntireH1Class (Complex.I • (0 : DeningerEntire)) := by
            exact
              (deningerEntireH1Class.toLinearMap.map_smul
                Complex.I (0 : DeningerEntire)).symm
      _ = deningerEntireH1Class (0 : DeningerEntire) := by rw [hsourceZero]
      _ = 0 := map_zero deningerEntireH1Class
  rw [hIzero, add_zero]

/-- The first removable divided chain is the exact global divided difference of `XiC`. -/
theorem deningerEntire_coordinate_sub_mul_dividedChain_one (alpha : ℂ) :
    (deningerEntireCoordinate - algebraMap ℂ DeningerEntire alpha) *
        deningerEntireDividedChain alpha 1 =
      deningerEntireXi -
        algebraMap ℂ DeningerEntire (XiC alpha) := by
  apply DeningerEntire.ext
  intro z
  simp only [deningerEntire_sub_apply, deningerEntireCoordinate_apply,
    deningerEntire_algebraMap_apply, deningerEntire_mul_apply,
    deningerEntireDividedChain_apply, deningerEntireXi_apply]
  simpa [xiThetaDividedChain, smul_eq_mul] using
    sub_smul_dslope XiC alpha z

/-- Entire Bezout inverse for the coordinate away from the completed Xi divisor. -/
def deningerEntireCoordinateResolventSource (alpha : ℂ) : DeningerEntire :=
  (-(XiC alpha)⁻¹) • deningerEntireDividedChain alpha 1

/--
The source Bezout identity: away from a Xi zero, the coordinate difference times the explicit
divided-difference resolvent is one modulo the Xi ideal.
-/
theorem deningerEntire_coordinateResolvent_bezout
    {alpha : ℂ} (hXi : XiC alpha ≠ 0) :
    (deningerEntireCoordinate - algebraMap ℂ DeningerEntire alpha) *
        deningerEntireCoordinateResolventSource alpha =
      1 - (XiC alpha)⁻¹ • deningerEntireXi := by
  rw [deningerEntireCoordinateResolventSource]
  apply DeningerEntire.ext
  intro z
  simp only [deningerEntire_mul_apply, deningerEntire_sub_apply,
    deningerEntireCoordinate_apply, deningerEntire_algebraMap_apply,
    deningerEntire_smul_apply, deningerEntireDividedChain_apply,
    deningerEntire_one_apply, deningerEntireXi_apply]
  have hdiv := congrArg
    (fun F : DeningerEntire => F z)
    (deningerEntire_coordinate_sub_mul_dividedChain_one alpha)
  simp only [deningerEntire_mul_apply, deningerEntire_sub_apply,
    deningerEntireCoordinate_apply, deningerEntire_algebraMap_apply,
    deningerEntireDividedChain_apply, deningerEntireXi_apply] at hdiv
  calc
    (z - alpha) * (-(XiC alpha)⁻¹ *
        xiThetaDividedChain alpha 1 z) =
      -(XiC alpha)⁻¹ *
        ((z - alpha) * xiThetaDividedChain alpha 1 z) := by ring
    _ = -(XiC alpha)⁻¹ * (XiC z - XiC alpha) := by rw [hdiv]
    _ = 1 - (XiC alpha)⁻¹ * XiC z := by
      field_simp [hXi]
      ring

/-- Coordinate resolvent class in the entire quotient. -/
def deningerEntireCoordinateResolvent (alpha : ℂ) : DeningerEntireH1 :=
  deningerEntireH1Class (deningerEntireCoordinateResolventSource alpha)

/-- Off the Xi divisor, coordinate multiplication is invertible in middle cohomology. -/
theorem deningerEntireCoordinateResolvent_mul
    {alpha : ℂ} (hXi : XiC alpha ≠ 0) :
    (deningerEntireCoordinateClass -
        algebraMap ℂ DeningerEntireH1 alpha) *
      deningerEntireCoordinateResolvent alpha = 1 := by
  calc
    (deningerEntireCoordinateClass -
          algebraMap ℂ DeningerEntireH1 alpha) *
        deningerEntireCoordinateResolvent alpha =
      deningerEntireH1Class
        ((deningerEntireCoordinate - algebraMap ℂ DeningerEntire alpha) *
          deningerEntireCoordinateResolventSource alpha) := by
            simp [deningerEntireCoordinateClass,
              deningerEntireCoordinateResolvent]
    _ = deningerEntireH1Class
        (1 - (XiC alpha)⁻¹ • deningerEntireXi) := by
          rw [deningerEntire_coordinateResolvent_bezout hXi]
    _ = 1 := by
      simp [Algebra.smul_def, deningerEntireH1Class_Xi]

/-- No coordinate eigenvector can occur away from the source-defined Xi divisor. -/
theorem eq_zero_of_deningerEntireCoordinate_sub_mul_eq_zero
    {alpha : ℂ} (hXi : XiC alpha ≠ 0) {x : DeningerEntireH1}
    (hx :
      (deningerEntireCoordinateClass -
        algebraMap ℂ DeningerEntireH1 alpha) * x = 0) :
    x = 0 := by
  calc
    x = 1 * x := (one_mul x).symm
    _ = ((deningerEntireCoordinateClass -
          algebraMap ℂ DeningerEntireH1 alpha) *
        deningerEntireCoordinateResolvent alpha) * x := by
          rw [deningerEntireCoordinateResolvent_mul hXi]
    _ = (deningerEntireCoordinateResolvent alpha *
          (deningerEntireCoordinateClass -
            algebraMap ℂ DeningerEntireH1 alpha)) * x := by
          rw [mul_comm
            (deningerEntireCoordinateClass -
              algebraMap ℂ DeningerEntireH1 alpha)
            (deningerEntireCoordinateResolvent alpha)]
    _ = deningerEntireCoordinateResolvent alpha *
        ((deningerEntireCoordinateClass -
          algebraMap ℂ DeningerEntireH1 alpha) * x) := by rw [mul_assoc]
    _ = 0 := by rw [hx, mul_zero]

/--
Exact source-spectrum converse.  Any genuine eigenvalue of the entire-quotient Frobenius
generator gives a zero of `XiC` in the centered coordinate.
-/
theorem XiC_eq_zero_of_deningerEntireTheta_eigenvalue
    {rho : ℂ} {x : DeningerEntireH1}
    (hx0 : x ≠ 0) (hx : deningerEntireTheta x = rho • x) :
    XiC ((rho - 1 / 2) / Complex.I) = 0 := by
  let alpha : ℂ := (rho - 1 / 2) / Complex.I
  have hrho : rho = 1 / 2 + Complex.I * alpha := by
    dsimp [alpha]
    field_simp [Complex.I_ne_zero]
    ring
  by_contra hXi
  apply hx0
  apply eq_zero_of_deningerEntireCoordinate_sub_mul_eq_zero hXi
  rw [deningerEntireTheta_apply, deningerEntireThetaClass_eq, hrho] at hx
  change
    (algebraMap ℂ DeningerEntireH1 (1 / 2) +
        algebraMap ℂ DeningerEntireH1 Complex.I *
          deningerEntireCoordinateClass) * x =
      algebraMap ℂ DeningerEntireH1
        (1 / 2 + Complex.I * alpha) * x at hx
  rw [(algebraMap ℂ DeningerEntireH1).map_add,
    (algebraMap ℂ DeningerEntireH1).map_mul] at hx
  have hI :
      algebraMap ℂ DeningerEntireH1 Complex.I *
        ((deningerEntireCoordinateClass -
          algebraMap ℂ DeningerEntireH1 alpha) * x) = 0 := by
    linear_combination hx
  calc
    (deningerEntireCoordinateClass -
        algebraMap ℂ DeningerEntireH1 alpha) * x =
      (algebraMap ℂ DeningerEntireH1 (-Complex.I) *
          algebraMap ℂ DeningerEntireH1 Complex.I) *
        ((deningerEntireCoordinateClass -
          algebraMap ℂ DeningerEntireH1 alpha) * x) := by
            rw [← (algebraMap ℂ DeningerEntireH1).map_mul]
            norm_num
    _ = algebraMap ℂ DeningerEntireH1 (-Complex.I) *
        (algebraMap ℂ DeningerEntireH1 Complex.I *
          ((deningerEntireCoordinateClass -
            algebraMap ℂ DeningerEntireH1 alpha) * x)) := by rw [mul_assoc]
    _ = 0 := by rw [hI, mul_zero]

/--
Exact source-defined point-spectrum theorem: `1/2 + I*alpha` is an eigenvalue of the
entire-quotient Frobenius generator precisely when the prime--Gamma completed Xi source vanishes
at `alpha`.  No zero list or spectral realization is assumed in the definition of either side.
-/
theorem XiC_eq_zero_iff_exists_deningerEntireTheta_eigenvector
    (alpha : ℂ) :
    XiC alpha = 0 ↔
      ∃ x : DeningerEntireH1,
        x ≠ 0 ∧
          deningerEntireTheta x =
            (1 / 2 + Complex.I * alpha) • x := by
  constructor
  · intro hXi
    obtain ⟨q, hq⟩ :=
      (XiC_eq_zero_iff_exists_xiZeroCopy alpha).mp hXi
    obtain ⟨x, hx0, hx⟩ :=
      exists_deningerEntireTheta_eigenvector q.1
    refine ⟨x, hx0, ?_⟩
    calc
      deningerEntireTheta x =
          (1 / 2 + Complex.I * xiSpectralPointSupport q.1) • x := hx
      _ = (1 / 2 + Complex.I * alpha) • x := by
        rw [← xiSpectralPoint_eq_support q, hq]
  · rintro ⟨x, hx0, hx⟩
    have hXi :=
      XiC_eq_zero_of_deningerEntireTheta_eigenvalue
        (rho := 1 / 2 + Complex.I * alpha) hx0 hx
    have hcenter :
        ((1 / 2 + Complex.I * alpha - 1 / 2) / Complex.I) =
          alpha := by
      field_simp [Complex.I_ne_zero]
      ring
    rw [hcenter] at hXi
    exact hXi

end

end RHTower
