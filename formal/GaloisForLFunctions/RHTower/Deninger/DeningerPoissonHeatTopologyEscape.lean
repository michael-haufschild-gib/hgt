import Mathlib.Analysis.SpecialFunctions.Pow.Asymptotics

/-!
# High-frequency escape from positive-time Poisson energy

For every positive time, the multiplier `λ * exp (-2 * r * λ)` tends to zero as the
frequency `λ` tends to infinity.  Hence the family of all positive-time Poisson--Green
energies is pointwise faithful but does not generate the ambient Hilbert topology: normalized
high-frequency modes converge to zero in every family coordinate while their norm stays one.

The Tate-normalized Deninger prime-circle frequencies are `2 * π * k`.  The results below give
the exact scalar and product-topology obstruction used by
`DAC_POISSON_HEAT_TOPOLOGY_HIGH_FREQUENCY_ESCAPE`.
-/

namespace RHTower

open Filter Topology

/-- Positive-time Poisson--Green energy at spectral frequency `lam`. -/
noncomputable def deningerPoissonHeatWeight (r lam : ℝ) : ℝ :=
  lam * Real.exp (-(2 * r * lam))

/-- Positive-time Poisson--Green energy vanishes at high frequency. -/
theorem deningerPoissonHeatWeight_tendsto_zero (r : ℝ) (hr : 0 < r) :
    Tendsto (deningerPoissonHeatWeight r) atTop (𝓝 0) := by
  change Tendsto (fun lam : ℝ => lam * Real.exp (-(2 * r * lam))) atTop (𝓝 0)
  have h := tendsto_rpow_mul_exp_neg_mul_atTop_nhds_zero 1 (2 * r)
    (mul_pos zero_lt_two hr)
  refine h.congr' (Eventually.of_forall fun lam => ?_)
  simp only [Real.rpow_one]
  congr 2
  ring

/-- Tate-normalized frequency of the `k`th prime-circle Fourier mode. -/
noncomputable def deningerTateCircleModeRate (k : ℕ) : ℝ :=
  2 * Real.pi * (k : ℝ)

/-- Tate-normalized circle frequencies tend to infinity. -/
theorem deningerTateCircleModeRate_tendsto_atTop :
    Tendsto deningerTateCircleModeRate atTop atTop := by
  have hnat : Tendsto (fun k : ℕ => (k : ℝ)) atTop atTop := tendsto_natCast_atTop_atTop
  exact (tendsto_const_mul_atTop_of_pos (mul_pos zero_lt_two Real.pi_pos)).2 hnat

/-- Every fixed positive collar scale loses Tate-normalized high-frequency modes. -/
theorem deningerTateCircleModeHeat_tendsto_zero (r : ℝ) (hr : 0 < r) :
    Tendsto
      (fun k => deningerPoissonHeatWeight r (deningerTateCircleModeRate k))
      atTop (𝓝 0) :=
  (deningerPoissonHeatWeight_tendsto_zero r hr).comp
    deningerTateCircleModeRate_tendsto_atTop

/-- Every nonzero mode has strictly positive energy at each finite collar scale. -/
theorem deningerTateCircleModeHeat_pos (r : ℝ) {k : ℕ} (hk : 0 < k) :
    0 < deningerPoissonHeatWeight r (deningerTateCircleModeRate k) := by
  have hrate : 0 < deningerTateCircleModeRate k := by
    exact mul_pos (mul_pos zero_lt_two Real.pi_pos) (Nat.cast_pos.mpr hk)
  exact mul_pos hrate (Real.exp_pos _)

/-- Fixed-prime normalized packet energy, relative to the source weight `L²`. -/
noncomputable def deningerNormalizedPrimePacketHeatEnergy (L r : ℝ) (k : ℕ) : ℝ :=
  deningerPoissonHeatWeight r (deningerTateCircleModeRate k) / L ^ 2

/-- On every fixed prime packet, normalized high modes escape all positive-time energies. -/
theorem deningerNormalizedPrimePacketHeatEnergy_tendsto_zero (L r : ℝ) (hr : 0 < r) :
    Tendsto (deningerNormalizedPrimePacketHeatEnergy L r) atTop (𝓝 0) := by
  change Tendsto
    (fun k => deningerPoissonHeatWeight r (deningerTateCircleModeRate k) / L ^ 2)
    atTop (𝓝 0)
  have h := (tendsto_const_nhds.mul (deningerTateCircleModeHeat_tendsto_zero r hr) :
    Tendsto
      (fun k => (L ^ 2)⁻¹ *
        deningerPoissonHeatWeight r (deningerTateCircleModeRate k))
      atTop (𝓝 ((L ^ 2)⁻¹ * 0)))
  simpa [div_eq_mul_inv, mul_comm] using h

/-- Positive collar times, used as the coordinate set of the energy-family topology. -/
abbrev DeningerPositiveCollarTime := {r : ℝ // 0 < r}

/-- Complete positive-time energy profile of a Tate-normalized circle mode. -/
noncomputable def deningerPoissonHeatProfile (k : ℕ) :
    DeningerPositiveCollarTime → ℝ := fun r =>
  deningerPoissonHeatWeight r.1 (deningerTateCircleModeRate k)

/-- The high-frequency sequence converges to zero in the product topology generated by every
positive-time energy coordinate. -/
theorem deningerPoissonHeatProfile_tendsto_zero :
    Tendsto deningerPoissonHeatProfile atTop (𝓝 0) := by
  rw [tendsto_pi_nhds]
  intro r
  simpa [deningerPoissonHeatProfile] using
    deningerTateCircleModeHeat_tendsto_zero r.1 r.property

/-- The constant ambient norm of normalized modes does not converge to zero. -/
theorem deningerNormalizedModeNorm_not_tendsto_zero :
    ¬ Tendsto (fun _ : ℕ => (1 : ℝ)) atTop (𝓝 0) := by
  intro h
  have h' : (1 : ℝ) = 0 := tendsto_nhds_unique tendsto_const_nhds h
  norm_num at h'

/-- **Poisson-heat topology high-frequency escape.**  All positive-time coordinates converge to
zero along normalized high modes, while their ambient norm stays one. -/
theorem deningerPoissonHeatTopology_highFrequencyEscape :
    Tendsto deningerPoissonHeatProfile atTop (𝓝 0) ∧
      ¬ Tendsto (fun _ : ℕ => (1 : ℝ)) atTop (𝓝 0) :=
  ⟨deningerPoissonHeatProfile_tendsto_zero,
    deningerNormalizedModeNorm_not_tendsto_zero⟩

end RHTower
