import Mathlib.Combinatorics.SimpleGraph.Coloring.Vertex
import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
# Perfect Hankel-chain graph and its monomial secant ideal

This module formalizes the combinatorial half of Nam's higher-rank Hankel Gröbner theorem.
For ordinary Hankel matrices, diagonal monomials are chains of indices separated by at least two.
The corresponding graph is proved perfect constructively on every finite support: a greedy scan
simultaneously constructs a maximum clique and an optimal coloring.

The second half identifies membership in the monomial ideal generated by `t`-chains over every
commutative semiring and proves that an exponent avoids `(r+1)`-chain generators exactly when its
support is `r`-colorable. No field, characteristic, reducedness, or finiteness-of-the-ambient-index
assumption is used.

This does **not** assert the still-open algebraic comparison between this monomial ideal and the
initial ideal of the higher Hankel determinantal ideal. That comparison is the remaining
Conca--Nam/Hazewinkel frontier.
-/

namespace RHTower

open SimpleGraph

/-- Graph whose cliques are ordinary Hankel chains: distinct indices are adjacent exactly when
they differ by at least two. -/
def hankelChainGraph : SimpleGraph ℕ where
  Adj i j := i + 1 < j ∨ j + 1 < i
  symm := ⟨by intro i j h; exact h.symm⟩
  loopless := ⟨by intro i; omega⟩

/-- Greedy left-to-right chain selector. An occupied index is selected precisely when its
predecessor was not selected. -/
def hankelGreedyCenter (s : Finset ℕ) : ℕ → Bool
  | 0 => decide (0 ∈ s)
  | n + 1 => decide (n + 1 ∈ s) && !(hankelGreedyCenter s n)

@[simp] theorem hankelGreedyCenter_zero {s : Finset ℕ} :
    hankelGreedyCenter s 0 = true ↔ 0 ∈ s := by
  simp [hankelGreedyCenter]

@[simp] theorem hankelGreedyCenter_succ {s : Finset ℕ} {n : ℕ} :
    hankelGreedyCenter s (n + 1) = true ↔
      n + 1 ∈ s ∧ hankelGreedyCenter s n = false := by
  simp [hankelGreedyCenter]

theorem hankelGreedyCenter_mem {s : Finset ℕ} {n : ℕ}
    (hn : hankelGreedyCenter s n = true) : n ∈ s := by
  cases n with
  | zero => simpa using hn
  | succ n => exact (hankelGreedyCenter_succ.mp hn).1

theorem hankelGreedyCenter_or_pred {s : Finset ℕ} {n : ℕ} (hn : n ∈ s) :
    hankelGreedyCenter s n = true ∨
      ∃ k, n = k + 1 ∧ hankelGreedyCenter s k = true := by
  cases n with
  | zero => exact Or.inl (hankelGreedyCenter_zero.mpr hn)
  | succ k =>
      by_cases hk : hankelGreedyCenter s k = true
      · exact Or.inr ⟨k, rfl, hk⟩
      · left
        have hkfalse : hankelGreedyCenter s k = false := by
          cases h : hankelGreedyCenter s k <;> simp_all
        exact hankelGreedyCenter_succ.mpr ⟨hn, hkfalse⟩

theorem hankelGreedyCenter_not_succ {s : Finset ℕ} {n : ℕ}
    (hn : hankelGreedyCenter s n = true) :
    hankelGreedyCenter s (n + 1) ≠ true := by
  intro hs
  have := hankelGreedyCenter_succ.mp hs
  simp [hn] at this

/-- Finite set selected by the greedy Hankel-chain scan. -/
def hankelGreedyCenters (s : Finset ℕ) : Finset ℕ :=
  s.filter fun n => hankelGreedyCenter s n = true

@[simp] theorem mem_hankelGreedyCenters {s : Finset ℕ} {n : ℕ} :
    n ∈ hankelGreedyCenters s ↔ hankelGreedyCenter s n = true := by
  constructor
  · exact fun h => (Finset.mem_filter.mp h).2
  · intro h
    exact Finset.mem_filter.mpr ⟨hankelGreedyCenter_mem h, h⟩

theorem hankelGreedyCenters_pairwise_chain (s : Finset ℕ) :
    (↑(hankelGreedyCenters s) : Set ℕ).Pairwise (hankelChainGraph.Adj) := by
  intro i hi j hj hij
  change i ∈ hankelGreedyCenters s at hi
  change j ∈ hankelGreedyCenters s at hj
  rw [mem_hankelGreedyCenters] at hi hj
  rcases lt_trichotomy i j with hijlt | hijeq | hjilt
  · left
    by_contra hnot
    have hji : j ≤ i + 1 := Nat.le_of_not_gt hnot
    have : j = i + 1 := by omega
    subst j
    exact hankelGreedyCenter_not_succ hi hj
  · exact (hij hijeq).elim
  · right
    by_contra hnot
    have hij' : i ≤ j + 1 := Nat.le_of_not_gt hnot
    have : i = j + 1 := by omega
    subst i
    exact hankelGreedyCenter_not_succ hj hi

/-- Greedy color representative: selected vertex itself, or selected predecessor. -/
def hankelGreedyRepresentative (s : Finset ℕ) (n : ℕ) : ℕ :=
  if hankelGreedyCenter s n = true then n else n - 1

theorem hankelGreedyRepresentative_mem {s : Finset ℕ} {n : ℕ} (hn : n ∈ s) :
    hankelGreedyRepresentative s n ∈ hankelGreedyCenters s := by
  rcases hankelGreedyCenter_or_pred hn with hc | ⟨k, rfl, hk⟩
  · simp [hankelGreedyRepresentative, hc]
  · have hsucc : hankelGreedyCenter s (k + 1) ≠ true :=
      hankelGreedyCenter_not_succ hk
    simp [hankelGreedyRepresentative, hsucc, hk]

theorem hankelGreedyRepresentative_eq_or_succ {s : Finset ℕ} {n : ℕ}
    (hn : n ∈ s) :
    n = hankelGreedyRepresentative s n ∨
      n = hankelGreedyRepresentative s n + 1 := by
  rcases hankelGreedyCenter_or_pred hn with hc | ⟨k, rfl, hk⟩
  · left
    simp [hankelGreedyRepresentative, hc]
  · right
    have hsucc : hankelGreedyCenter s (k + 1) ≠ true :=
      hankelGreedyCenter_not_succ hk
    simp [hankelGreedyRepresentative, hsucc]

/-- Explicit optimal coloring of every finite induced Hankel-chain graph. -/
def hankelGreedyColoring (s : Finset ℕ) :
    (hankelChainGraph.induce (s : Set ℕ)).Coloring
      {n // n ∈ hankelGreedyCenters s} :=
  SimpleGraph.Coloring.mk
    (fun n => ⟨hankelGreedyRepresentative s n.1,
      hankelGreedyRepresentative_mem n.2⟩)
    (by
      intro i j hij heq
      have hrep : hankelGreedyRepresentative s i.1 =
          hankelGreedyRepresentative s j.1 := congrArg Subtype.val heq
      have hi := hankelGreedyRepresentative_eq_or_succ i.2
      have hj := hankelGreedyRepresentative_eq_or_succ j.2
      change i.1 + 1 < j.1 ∨ j.1 + 1 < i.1 at hij
      rcases hi with hi | hi <;> rcases hj with hj | hj <;> omega)

theorem hankelChainGraph_induce_colorable (s : Finset ℕ) :
    (hankelChainGraph.induce (s : Set ℕ)).Colorable
      (hankelGreedyCenters s).card := by
  simpa using (hankelGreedyColoring s).colorable

theorem hankelChainGraph_centers_le_chromaticNumber (s : Finset ℕ) :
    (hankelGreedyCenters s).card ≤
      (hankelChainGraph.induce (s : Set ℕ)).chromaticNumber := by
  let f : {n // n ∈ hankelGreedyCenters s} →
      {n // n ∈ (s : Set ℕ)} := fun n =>
    ⟨n.1, by
      have hc : hankelGreedyCenter s n.1 = true :=
        mem_hankelGreedyCenters.mp n.2
      exact hankelGreedyCenter_mem hc⟩
  apply le_chromaticNumber_of_pairwise_adj (n := (hankelGreedyCenters s).card)
    (by
      change (hankelGreedyCenters s).card ≤
        Nat.card ↑(hankelGreedyCenters s)
      rw [Nat.card_eq_fintype_card]
      simp) f
  intro i j hij
  change hankelChainGraph.Adj i.1 j.1
  exact hankelGreedyCenters_pairwise_chain s i.2 j.2
    (by intro h; exact hij (Subtype.ext h))

/-- **Nam c-chain perfectness, constructive and finite.** Every finite induced subgraph of the
ordinary Hankel chain graph has chromatic number equal to the number of greedy centers. -/
theorem hankelChainGraph_induce_chromaticNumber (s : Finset ℕ) :
    (hankelChainGraph.induce (s : Set ℕ)).chromaticNumber =
      (hankelGreedyCenters s).card := by
  apply le_antisymm
  · exact (hankelChainGraph_induce_colorable s).chromaticNumber_le
  · exact hankelChainGraph_centers_le_chromaticNumber s

/-- Clique number of every finite induced Hankel-chain graph is attained by greedy centers. -/
theorem hankelChainGraph_induce_cliqueNum (s : Finset ℕ) :
    (hankelChainGraph.induce (s : Set ℕ)).cliqueNum =
      (hankelGreedyCenters s).card := by
  classical
  apply le_antisymm
  · have h :
        ((hankelChainGraph.induce (s : Set ℕ)).cliqueNum : ℕ∞) ≤
          ((hankelGreedyCenters s).card : ℕ∞) := by
        rw [← hankelChainGraph_induce_chromaticNumber s]
        exact SimpleGraph.cliqueNum_le_chromaticNumber
    exact_mod_cast h
  · let t : Finset {n // n ∈ (s : Set ℕ)} :=
      (hankelGreedyCenters s).attach.map
        ⟨fun n => ⟨n.1, hankelGreedyCenter_mem
          (mem_hankelGreedyCenters.mp n.2)⟩, by
          intro i j h
          exact Subtype.ext (congrArg (fun x => x.1) h)⟩
    have htcard : t.card = (hankelGreedyCenters s).card := by
      simp [t]
    rw [← htcard]
    apply SimpleGraph.IsClique.card_le_cliqueNum
    rw [Finset.coe_map]
    intro i hi j hj hij
    obtain ⟨i', hi', rfl⟩ := hi
    obtain ⟨j', hj', rfl⟩ := hj
    change hankelChainGraph.Adj i'.1 j'.1
    apply hankelGreedyCenters_pairwise_chain s i'.2 j'.2
    intro h
    apply hij
    exact Subtype.ext h

/-- Exact perfect-graph identity required by the Conca--Nam secant argument. -/
theorem hankelChainGraph_finite_induced_perfect (s : Finset ℕ) :
    (hankelChainGraph.induce (s : Set ℕ)).chromaticNumber =
      (hankelChainGraph.induce (s : Set ℕ)).cliqueNum := by
  rw [hankelChainGraph_induce_chromaticNumber,
    hankelChainGraph_induce_cliqueNum]

/-- Perfectness in the exact secant form: absence of an `(r+1)`-chain is equivalent to an
`r`-coloring of the finite support. -/
theorem hankelChainGraph_induce_cliqueFree_succ_iff_colorable
    (s : Finset ℕ) (r : ℕ) :
    (hankelChainGraph.induce (s : Set ℕ)).CliqueFree (r + 1) ↔
      (hankelChainGraph.induce (s : Set ℕ)).Colorable r := by
  constructor
  · intro hfree
    rw [← SimpleGraph.chromaticNumber_le_iff_colorable]
    have hclique :
        (hankelChainGraph.induce (s : Set ℕ)).cliqueNum ≤ r := by
      by_contra hnot
      have hle : r + 1 ≤
          (hankelChainGraph.induce (s : Set ℕ)).cliqueNum := by omega
      have hfreeMax := hfree.mono hle
      obtain ⟨t, ht⟩ :=
        (hankelChainGraph.induce (s : Set ℕ)).exists_isNClique_cliqueNum
      exact hfreeMax t ht
    rw [hankelChainGraph_induce_chromaticNumber]
    rw [hankelChainGraph_induce_cliqueNum] at hclique
    exact_mod_cast hclique
  · intro hcolor
    exact hcolor.cliqueFree (by omega)

/-! ## Chain monomial ideal -/

open MvPolynomial

/-- Squarefree exponent supported on a finite set of moment indices. -/
noncomputable def hankelChainIndicator (J : Finset ℕ) : ℕ →₀ ℕ :=
  ∑ j ∈ J, Finsupp.single j 1

@[simp] theorem hankelChainIndicator_apply (J : Finset ℕ) (i : ℕ) :
    hankelChainIndicator J i = if i ∈ J then 1 else 0 := by
  rw [hankelChainIndicator, Finsupp.finsetSum_apply]
  simp only [Finsupp.single_apply]
  rw [Finset.sum_ite_eq' J i (fun _ => (1 : ℕ))]

@[simp] theorem hankelChainIndicator_support (J : Finset ℕ) :
    (hankelChainIndicator J).support = J := by
  ext i
  simp [Finsupp.mem_support_iff, hankelChainIndicator_apply]

theorem hankelChainIndicator_le_iff {J : Finset ℕ} {e : ℕ →₀ ℕ} :
    hankelChainIndicator J ≤ e ↔ J ⊆ e.support := by
  constructor
  · intro h i hi
    rw [Finsupp.mem_support_iff]
    have hle := h i
    rw [hankelChainIndicator_apply, if_pos hi] at hle
    omega
  · intro h i
    rw [hankelChainIndicator_apply]
    by_cases hi : i ∈ J
    · rw [if_pos hi]
      exact Nat.one_le_iff_ne_zero.mpr
        (Finsupp.mem_support_iff.mp (h hi))
    · simp [hi]

/-- Exponents of squarefree Hankel `t`-chains. -/
def hankelChainExponentSet (t : ℕ) : Set (ℕ →₀ ℕ) :=
  {d | ∃ J : Finset ℕ, J.card = t ∧
    (↑J : Set ℕ).Pairwise hankelChainGraph.Adj ∧
    d = hankelChainIndicator J}

/-- Monomial ideal generated by all squarefree Hankel `t`-chains. This is the chain ideal on the
monomial side of Nam's secant comparison, on the infinite moment-variable set. -/
noncomputable def hankelChainMonomialIdeal
    (R : Type*) [CommSemiring R] (t : ℕ) : Ideal (MvPolynomial ℕ R) :=
  Ideal.span ((fun d => MvPolynomial.monomial d (1 : R)) ''
    hankelChainExponentSet t)

/-- Exact coefficient-free membership criterion for the Hankel chain monomial ideal. -/
theorem mem_hankelChainMonomialIdeal_iff
    {R : Type*} [CommSemiring R] {t : ℕ} (P : MvPolynomial ℕ R) :
    P ∈ hankelChainMonomialIdeal R t ↔
      ∀ e ∈ P.support, ∃ J : Finset ℕ, J.card = t ∧
        (↑J : Set ℕ).Pairwise hankelChainGraph.Adj ∧ J ⊆ e.support := by
  rw [hankelChainMonomialIdeal,
    MvPolynomial.mem_ideal_span_monomial_image]
  constructor
  · intro h e he
    obtain ⟨d, ⟨J, hJcard, hJchain, rfl⟩, hde⟩ := h e he
    exact ⟨J, hJcard, hJchain, hankelChainIndicator_le_iff.mp hde⟩
  · intro h e he
    obtain ⟨J, hJcard, hJchain, hJsub⟩ := h e he
    exact ⟨hankelChainIndicator J, ⟨J, hJcard, hJchain, rfl⟩,
      hankelChainIndicator_le_iff.mpr hJsub⟩

/-- A finite support contains a `t`-chain exactly when its induced chain graph is not
`t`-clique-free. -/
theorem exists_hankelChain_subset_iff_not_cliqueFree
    (s : Finset ℕ) (t : ℕ) :
    (∃ J : Finset ℕ, J.card = t ∧
        (↑J : Set ℕ).Pairwise hankelChainGraph.Adj ∧ J ⊆ s) ↔
      ¬(hankelChainGraph.induce (s : Set ℕ)).CliqueFree t := by
  classical
  constructor
  · rintro ⟨J, hJcard, hJchain, hJsub⟩ hfree
    let T : Finset {n // n ∈ (s : Set ℕ)} :=
      J.attach.map ⟨fun n => ⟨n.1, hJsub n.2⟩, by
        intro i j h
        exact Subtype.ext (congrArg (fun x => x.1) h)⟩
    apply hfree T
    constructor
    · rw [Finset.coe_map]
      intro i hi j hj hij
      obtain ⟨i', hi', rfl⟩ := hi
      obtain ⟨j', hj', rfl⟩ := hj
      change hankelChainGraph.Adj i'.1 j'.1
      exact hJchain i'.2 j'.2 (by
        intro h
        apply hij
        exact Subtype.ext h)
    · simpa [T] using hJcard
  · intro hnot
    unfold SimpleGraph.CliqueFree at hnot
    push Not at hnot
    obtain ⟨T, hT⟩ := hnot
    let J : Finset ℕ := T.map ⟨Subtype.val, Subtype.val_injective⟩
    refine ⟨J, ?_, ?_, ?_⟩
    · simpa [J] using hT.card_eq
    · rw [Finset.coe_map]
      intro i hi j hj hij
      obtain ⟨i', hi', rfl⟩ := hi
      obtain ⟨j', hj', rfl⟩ := hj
      exact hT.isClique hi' hj' (by
        intro h
        apply hij
        exact congrArg Subtype.val h)
    · intro i hi
      have hiSet : i ∈ (↑J : Set ℕ) := hi
      simp only [J, Finset.coe_map] at hiSet
      obtain ⟨i', hi', rfl⟩ := hiSet
      exact i'.2

/-- Exponent is reduced for Hankel rank `r` when its support contains no `(r+1)`-chain. -/
def HankelChainReduced (r : ℕ) (e : ℕ →₀ ℕ) : Prop :=
  ¬∃ J : Finset ℕ, J.card = r + 1 ∧
    (↑J : Set ℕ).Pairwise hankelChainGraph.Adj ∧ J ⊆ e.support

/-- **Conca--Nam reduced-support classification.** A monomial avoids every `(r+1)`-chain
generator iff its finite support admits an `r`-coloring. -/
theorem hankelChainReduced_iff_colorable (r : ℕ) (e : ℕ →₀ ℕ) :
    HankelChainReduced r e ↔
      (hankelChainGraph.induce (e.support : Set ℕ)).Colorable r := by
  rw [HankelChainReduced,
    exists_hankelChain_subset_iff_not_cliqueFree,
    not_not,
    hankelChainGraph_induce_cliqueFree_succ_iff_colorable]

/-- Polynomial membership is exactly failure of reducedness at every occurring monomial. -/
theorem mem_hankelChainMonomialIdeal_succ_iff
    {R : Type*} [CommSemiring R] (r : ℕ) (P : MvPolynomial ℕ R) :
    P ∈ hankelChainMonomialIdeal R (r + 1) ↔
      ∀ e ∈ P.support, ¬HankelChainReduced r e := by
  rw [mem_hankelChainMonomialIdeal_iff]
  simp only [HankelChainReduced, not_not]

end RHTower
