import GaloisForLFunctions.RHTower.Deninger.DeningerCyclicExterior
import GaloisForLFunctions.HTGeometry.Homology.AugmentationUnitWedge
import GaloisForLFunctions.RHTower.Deninger.DeningerHiddenPrimeCyclic

/-!
# Unit cycles and positive source classes

Every inverse-unit tensor vanishes in ordinary cyclic degree one.
Pairs of the original positive prime tangents span exactly the diagonal in the
two exterior prime sectors. Every cyclic class splits into its positive part
and a signed discrepancy. The hidden logarithmic relations map to exterior
products with the prime-two coordinate; signed-only basis vectors lie outside
the whole positive sector.
-/

noncomputable section
namespace RHTower
open GaloisForLFunctions.RHTower GaloisForLFunctions.RHTower.SquareZeroCyclic
open PositiveSteinbergCyclic

/-- Every unit cycle in the actual Steinberg quotient vanishes in ordinary cyclic degree one. -/
theorem deningerCyclicUnit_eq_zero (u : Quotientˣ) :
    cyclicClass (↑(u⁻¹) : Quotient) (↑u : Quotient) = 0 := by
  apply deningerCyclicPrimeExteriorEquiv.injective
  rw [deningerCyclicPrimeExteriorEquiv_class, map_zero]
  exact Prod.ext
    (augmentationUnit_tangentWedge deningerPrimeAugmentation deningerQuotientPrimeMoment
      deningerQuotientPrimeMoment_mul u)
    (augmentationUnit_tangentWedge deningerSignedPrimeAugmentation deningerQuotientSignedPrimeMoment
      deningerQuotientSignedPrimeMoment_mul u)

/-- Every inverse-unit tensor belongs to the sum of actual boundaries and signed rotations. -/
theorem deningerUnit_pair_cyclic (u : Quotientˣ) :
    pair (↑(u⁻¹) : Quotient) (↑u : Quotient) ∈ cyclicRelations :=
  (Submodule.Quotient.mk_eq_zero (cyclicRelations (A := Quotient))).mp
    (deningerCyclicUnit_eq_zero u)

/-- The cyclic exterior classes generated by the original positive prime tangents. -/
def deningerPositiveCyclic : (⋀[ℂ]^2 DeningerPrimeSpace) →ₗ[ℂ] CyclicOne Quotient :=
  deningerCyclicPrimeExteriorEquiv.symm.toLinearMap.comp
    ((LinearMap.id : (⋀[ℂ]^2 DeningerPrimeSpace) →ₗ[ℂ] ⋀[ℂ]^2 DeningerPrimeSpace).prod LinearMap.id)

@[simp] theorem deningerPositiveCyclic_coordinates (w : ⋀[ℂ]^2 DeningerPrimeSpace) :
    deningerCyclicPrimeExteriorEquiv (deningerPositiveCyclic w) = (w,w) :=
  deningerCyclicPrimeExteriorEquiv.apply_symm_apply _

theorem deningerPositiveCyclic_injective : Function.Injective deningerPositiveCyclic := by
  intro x y h
  have he := congrArg deningerCyclicPrimeExteriorEquiv h
  rw [deningerPositiveCyclic_coordinates, deningerPositiveCyclic_coordinates] at he
  exact congrArg Prod.fst he

/-- Positive tangent classes are exactly the diagonal of the two exterior sign sectors. -/
theorem deningerPositiveCyclic_range (q : CyclicOne Quotient) :
    q ∈ LinearMap.range deningerPositiveCyclic ↔
      (deningerCyclicPrimeExteriorEquiv q).1 = (deningerCyclicPrimeExteriorEquiv q).2 := by
  constructor
  · rintro ⟨w, rfl⟩
    rw [deningerPositiveCyclic_coordinates]
  · intro h
    refine ⟨(deningerCyclicPrimeExteriorEquiv q).1, ?_⟩
    apply deningerCyclicPrimeExteriorEquiv.injective
    rw [deningerPositiveCyclic_coordinates]
    exact Prod.ext rfl h

/-- The second exterior sector complements the diagonal positive sector. -/
def deningerCyclicSignedComplement : (⋀[ℂ]^2 DeningerPrimeSpace) →ₗ[ℂ] CyclicOne Quotient :=
  deningerCyclicPrimeExteriorEquiv.symm.toLinearMap.comp
    ((0 : (⋀[ℂ]^2 DeningerPrimeSpace) →ₗ[ℂ] ⋀[ℂ]^2 DeningerPrimeSpace).prod LinearMap.id)

@[simp] theorem deningerCyclicSignedComplement_coordinates (w : ⋀[ℂ]^2 DeningerPrimeSpace) :
    deningerCyclicPrimeExteriorEquiv (deningerCyclicSignedComplement w) = (0,w) :=
  deningerCyclicPrimeExteriorEquiv.apply_symm_apply _

/-- Every cyclic class decomposes into its positive diagonal part and a signed discrepancy. -/
theorem deningerCyclic_positive_signed_decomposition (q : CyclicOne Quotient) :
    q = deningerPositiveCyclic (deningerCyclicPrimeExteriorEquiv q).1 +
      deningerCyclicSignedComplement
        ((deningerCyclicPrimeExteriorEquiv q).2 - (deningerCyclicPrimeExteriorEquiv q).1) := by
  apply deningerCyclicPrimeExteriorEquiv.injective
  rw [map_add, deningerPositiveCyclic_coordinates, deningerCyclicSignedComplement_coordinates]
  apply Prod.ext
  · simp
  · change (deningerCyclicPrimeExteriorEquiv q).2 =
      (deningerCyclicPrimeExteriorEquiv q).1 +
        ((deningerCyclicPrimeExteriorEquiv q).2 - (deningerCyclicPrimeExteriorEquiv q).1)
    abel

/-- The positive part and signed discrepancy in this decomposition are unique. -/
theorem deningerCyclic_positive_signed_unique
    (x y x' y' : ⋀[ℂ]^2 DeningerPrimeSpace) :
    deningerPositiveCyclic x + deningerCyclicSignedComplement y =
      deningerPositiveCyclic x' + deningerCyclicSignedComplement y' ↔ x = x' ∧ y = y' := by
  constructor
  · intro h
    have he := congrArg deningerCyclicPrimeExteriorEquiv h
    simp only [map_add, deningerPositiveCyclic_coordinates,
      deningerCyclicSignedComplement_coordinates] at he
    have hx : x = x' := by simpa using congrArg Prod.fst he
    have hy : x+y = x'+y' := congrArg Prod.snd he
    rw [hx] at hy
    exact ⟨hx, add_left_cancel hy⟩
  · rintro ⟨rfl, rfl⟩
    rfl

theorem deningerSourcePrimeTangent_signedMoment (x : DeningerPrimeSpace) :
    deningerQuotientSignedPrimeMoment (deningerSourcePrimeTangent x) = x := by
  change deningerQuotientSignedPrimeMoment (quotientMap (deningerPrimeTangentSection x)) = x
  rw [deningerQuotientSignedPrimeMoment_quotientMap, deningerPrimeTangentSection_signedMoment]

/-- Pairs of the original positive source tangents represent the complete diagonal exterior space. -/
theorem deningerSourcePrimeCyclic_class (x y : DeningerPrimeSpace) :
    cyclicClass (deningerSourcePrimeTangent x) (deningerSourcePrimeTangent y) =
      deningerPositiveCyclic (tangentWedge x y) := by
  apply deningerCyclicPrimeExteriorEquiv.injective
  rw [deningerCyclicPrimeExteriorEquiv_class, deningerPositiveCyclic_coordinates,
    deningerSourcePrimeTangent_moment, deningerSourcePrimeTangent_moment,
    deningerSourcePrimeTangent_signedMoment, deningerSourcePrimeTangent_signedMoment]

/-- The diagonal is exactly the linear span of pairs of original positive source tangents. -/
theorem deningerPositiveCyclic_range_span :
    LinearMap.range deningerPositiveCyclic = Submodule.span ℂ
      (Set.range (fun xy : DeningerPrimeSpace × DeningerPrimeSpace =>
        cyclicClass (deningerSourcePrimeTangent xy.1) (deningerSourcePrimeTangent xy.2))) := by
  rw [LinearMap.range_eq_map, ← exteriorPower.ιMulti_span ℂ 2 DeningerPrimeSpace,
    LinearMap.map_span]
  apply congrArg (Submodule.span ℂ)
  ext q
  constructor
  · rintro ⟨w, ⟨v, rfl⟩, rfl⟩
    refine ⟨(v 0, v 1), ?_⟩
    have hv : v = ![v 0, v 1] := by funext i; fin_cases i <;> rfl
    rw [hv]
    exact deningerSourcePrimeCyclic_class _ _
  · rintro ⟨⟨x, y⟩, rfl⟩
    refine ⟨tangentWedge x y, ⟨![x,y], rfl⟩, ?_⟩
    exact (deningerSourcePrimeCyclic_class x y).symm

/-- The hidden-relation family is the diagonal exterior product with the prime-two coordinate. -/
theorem deningerHiddenPrimeCyclic_eq_positive (x : deningerPrimeLog.ker) :
    deningerHiddenPrimeCyclic x =
      deningerPositiveCyclic (tangentWedge (Finsupp.single deningerPrimeLogPivot 1) x.val) := by
  change cyclicClass deningerPivotTangent (deningerSourcePrimeTangent x.val) = _
  exact deningerSourcePrimeCyclic_class (Finsupp.single deningerPrimeLogPivot 1) x.val

/-- Every signed-only prime-pair basis vector lies outside the entire positive tangent sector. -/
theorem deningerCyclicBasis_inr_not_positive (s : DeningerCyclicPrimePair) :
    deningerCyclicBasis (Sum.inr s) ∉ LinearMap.range deningerPositiveCyclic := by
  intro h
  have he := (deningerPositiveCyclic_range _).mp h
  rw [deningerCyclicBasis_inr_coordinates] at he
  exact deningerPrimeExteriorBasis.ne_zero s he.symm

/-- Positive source tangents generate a proper subspace of the full cyclic quotient. -/
theorem deningerPositiveCyclic_range_ne_top : LinearMap.range deningerPositiveCyclic ≠ ⊤ := by
  letI : Infinite Nat.Primes := Nat.infinite_setOf_prime.to_subtype
  obtain ⟨s⟩ : Nonempty DeningerCyclicPrimePair := inferInstance
  intro h
  apply deningerCyclicBasis_inr_not_positive s
  rw [h]
  exact Submodule.mem_top

#print axioms deningerCyclicUnit_eq_zero
#print axioms deningerUnit_pair_cyclic
#print axioms deningerPositiveCyclic_injective
#print axioms deningerPositiveCyclic_range
#print axioms deningerCyclic_positive_signed_decomposition
#print axioms deningerCyclic_positive_signed_unique
#print axioms deningerPositiveCyclic_range_span
#print axioms deningerHiddenPrimeCyclic_eq_positive
#print axioms deningerCyclicBasis_inr_not_positive
#print axioms deningerPositiveCyclic_range_ne_top
end RHTower
