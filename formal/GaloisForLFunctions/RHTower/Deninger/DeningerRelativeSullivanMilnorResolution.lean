import Mathlib.LinearAlgebra.ExteriorPower.Basic
import Mathlib.Algebra.TrivSqZeroExt.Basic
import Mathlib.Algebra.Algebra.Subalgebra.Basic
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.Tactic.NoncommRing
import GaloisForLFunctions.HTGeometry.SullivanTower

/-!
# The Milnor quotient of an exterior algebra and the first relative Sullivan layer

The free graded-commutative algebra on a space of degree-one generators is the exterior algebra,
and the two-term algebra `k ⊕ V` with vanishing products is the split square-zero extension.  The
canonical map from the free algebra to the two-term algebra is the identity on scalars and on
generators, is surjective, and its kernel is exactly the ideal generated by the degree-two part.

That last identification is the algebraic content of the relative Sullivan factorization in the
two-term case: the first layer of new degree-one generators has differential the inclusion of the
degree-two part, and the ideal spanned by that differential is precisely the kernel to be killed.

The relative extension itself is the exterior algebra on a direct sum: adjoining a space `W` of new
degree-one generators to the exterior algebra on `V` gives `Λ(V ⊕ W)`, which is the graded tensor
product of `Λ(V)` with `Λ(W)`.  The old algebra includes into it as a retract, and the kernel of
the retraction is exactly the ideal generated by the new generators — the well-ordered filtration
and the lower-triangularity of the differential are then recorded by `DeningerRelativeSullivan`,
whose first layer is constructed unconditionally.

* `deningerExteriorPowerTwo_central` : degree-two elements are central.
* `deningerMilnorEpsilon`, `_surjective` : the canonical map to the two-term algebra.
* `deningerMilnorEpsilon_ker` : its kernel is the ideal generated by the degree-two part.
* `deningerMilnorQuotientEquiv` : the two-term algebra is the Milnor quotient.
* `deningerSullivanInclusion_injective`, `deningerSullivanAugmentation_ker` : the relative
  extension is a split extension whose augmentation ideal is generated by the new generators.
* `deningerSullivanFirstLayer` : the first relative Sullivan layer, with its filtration and
  lower-triangular differential.
-/

namespace RHTower

open ExteriorAlgebra

section Centrality

variable {k V : Type*} [CommRing k] [AddCommGroup V] [Module k V]

/-- A product of two generators commutes with every generator: two transpositions of
anticommuting generators restore the original order. -/
theorem deningerExteriorTwo_comm_ι (a b x : V) :
    (ι k a * ι k b) * ι k x = ι k x * (ι k a * ι k b) := by
  have ha : ι k a * ι k x = -(ι k x * ι k a) :=
    add_eq_zero_iff_eq_neg.mp (ExteriorAlgebra.ι_add_mul_swap a x)
  have hb : ι k b * ι k x = -(ι k x * ι k b) :=
    add_eq_zero_iff_eq_neg.mp (ExteriorAlgebra.ι_add_mul_swap b x)
  calc (ι k a * ι k b) * ι k x = ι k a * (ι k b * ι k x) := by rw [mul_assoc]
    _ = ι k a * -(ι k x * ι k b) := by rw [hb]
    _ = -(ι k a * ι k x * ι k b) := by rw [mul_neg, mul_assoc]
    _ = -(-(ι k x * ι k a) * ι k b) := by rw [ha]
    _ = ι k x * ι k a * ι k b := by rw [neg_mul, neg_neg]
    _ = ι k x * (ι k a * ι k b) := by rw [mul_assoc]

/-- **A product of two generators is central.**  The centralizer is a subalgebra containing the
generators, and the generators generate the exterior algebra. -/
theorem deningerExteriorTwo_central (a b : V) (z : ExteriorAlgebra k V) :
    (ι k a * ι k b) * z = z * (ι k a * ι k b) := by
  have hgen : Algebra.adjoin k (Set.range (ι k : V →ₗ[k] ExteriorAlgebra k V)) = ⊤ :=
    CliffordAlgebra.adjoin_range_ι
  have hsub : Algebra.adjoin k (Set.range (ι k : V →ₗ[k] ExteriorAlgebra k V))
      ≤ Subalgebra.centralizer k {ι k a * ι k b} := by
    rw [Algebra.adjoin_le_iff]
    rintro _ ⟨x, rfl⟩
    rw [SetLike.mem_coe, Subalgebra.mem_centralizer_iff]
    intro g hg
    rw [Set.mem_singleton_iff] at hg
    subst hg
    exact deningerExteriorTwo_comm_ι a b x
  have : z ∈ Subalgebra.centralizer k {ι k a * ι k b} := by
    rw [hgen] at hsub
    exact hsub trivial
  exact (Subalgebra.mem_centralizer_iff k).mp this _ rfl

/-- **Every degree-two element is central.** -/
theorem deningerExteriorPowerTwo_central {x : ExteriorAlgebra k V} (hx : x ∈ ⋀[k]^(2 : ℕ) V)
    (z : ExteriorAlgebra k V) : x * z = z * x := by
  have hx' : x ∈ LinearMap.range (ι k : V →ₗ[k] ExteriorAlgebra k V) *
      LinearMap.range (ι k : V →ₗ[k] ExteriorAlgebra k V) := by
    rw [← pow_two]
    exact hx
  refine Submodule.mul_induction_on hx' ?_ ?_
  · rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩
    exact deningerExteriorTwo_central a b z
  · intro p q hp hq
    rw [add_mul, mul_add, hp, hq]

/-- A product of two generators lies in the degree-two part. -/
theorem deningerExteriorTwo_mem (a b : V) : ι k a * ι k b ∈ ⋀[k]^(2 : ℕ) V := by
  have h : ι k a * ι k b ∈ LinearMap.range (ι k : V →ₗ[k] ExteriorAlgebra k V) *
      LinearMap.range (ι k : V →ₗ[k] ExteriorAlgebra k V) :=
    Submodule.mul_mem_mul ⟨a, rfl⟩ ⟨b, rfl⟩
  rwa [← pow_two] at h

end Centrality

section MilnorQuotient

variable (k V : Type*) [CommRing k] [AddCommGroup V] [Module k V]

/-- **The Milnor ideal**: the ideal generated by the degree-two part of the exterior algebra. -/
def deningerMilnorIdeal : Ideal (ExteriorAlgebra k V) :=
  Ideal.span (↑(⋀[k]^(2 : ℕ) V) : Set (ExteriorAlgebra k V))

variable {k V}

theorem deningerExteriorTwo_mem_milnorIdeal (a b : V) :
    ι k a * ι k b ∈ deningerMilnorIdeal k V :=
  Ideal.subset_span (deningerExteriorTwo_mem a b)

/-- **The Milnor ideal is two-sided**, because its generators are central. -/
theorem deningerMilnorIdeal_mul_right {i : ExteriorAlgebra k V}
    (hi : i ∈ deningerMilnorIdeal k V) (z : ExteriorAlgebra k V) :
    i * z ∈ deningerMilnorIdeal k V := by
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hi
  · intro x hx
    rw [deningerExteriorPowerTwo_central hx z]
    exact Ideal.mul_mem_left _ z (Ideal.subset_span hx)
  · rw [zero_mul]
    exact Submodule.zero_mem _
  · intro p q _ _ hp hq
    rw [add_mul]
    exact Submodule.add_mem _ hp hq
  · intro a p _ hp
    rw [smul_eq_mul, mul_assoc]
    exact Ideal.mul_mem_left _ a hp

instance deningerMilnorIdeal_isTwoSided : (deningerMilnorIdeal k V).IsTwoSided :=
  ⟨fun b hi => deningerMilnorIdeal_mul_right hi b⟩

/-- **Scalars, generators and the Milnor ideal exhaust the exterior algebra.**  The set of such
sums contains the generators and the scalars and is closed under products, because the product of
two generators is already in the Milnor ideal and the ideal is two-sided. -/
theorem deningerExterior_decomposition (x : ExteriorAlgebra k V) :
    ∃ c : k, ∃ v : V, ∃ i ∈ deningerMilnorIdeal k V,
      x = algebraMap k (ExteriorAlgebra k V) c + ι k v + i := by
  have hx : x ∈ Algebra.adjoin k (Set.range (ι k : V →ₗ[k] ExteriorAlgebra k V)) := by
    rw [CliffordAlgebra.adjoin_range_ι]
    trivial
  induction hx using Algebra.adjoin_induction with
  | mem y hy =>
      obtain ⟨v, rfl⟩ := hy
      exact ⟨0, v, 0, Submodule.zero_mem _, by rw [map_zero, zero_add, add_zero]⟩
  | algebraMap r => exact ⟨r, 0, 0, Submodule.zero_mem _, by rw [map_zero, add_zero, add_zero]⟩
  | add a b _ _ ha hb =>
      obtain ⟨c₁, v₁, i₁, hi₁, rfl⟩ := ha
      obtain ⟨c₂, v₂, i₂, hi₂, rfl⟩ := hb
      refine ⟨c₁ + c₂, v₁ + v₂, i₁ + i₂, Submodule.add_mem _ hi₁ hi₂, ?_⟩
      rw [map_add, map_add]
      abel
  | mul a b _ _ ha hb =>
      obtain ⟨c₁, v₁, i₁, hi₁, rfl⟩ := ha
      obtain ⟨c₂, v₂, i₂, hi₂, rfl⟩ := hb
      refine ⟨c₁ * c₂, c₁ • v₂ + c₂ • v₁,
        algebraMap k (ExteriorAlgebra k V) c₁ * i₂ + ι k v₁ * ι k v₂ + ι k v₁ * i₂
          + i₁ * algebraMap k (ExteriorAlgebra k V) c₂ + i₁ * ι k v₂ + i₁ * i₂, ?_, ?_⟩
      · refine Submodule.add_mem _ (Submodule.add_mem _ (Submodule.add_mem _
          (Submodule.add_mem _ (Submodule.add_mem _ ?_ ?_) ?_) ?_) ?_) ?_
        · exact Ideal.mul_mem_left _ _ hi₂
        · exact deningerExteriorTwo_mem_milnorIdeal v₁ v₂
        · exact Ideal.mul_mem_left _ _ hi₂
        · exact deningerMilnorIdeal_mul_right hi₁ _
        · exact deningerMilnorIdeal_mul_right hi₁ _
        · exact deningerMilnorIdeal_mul_right hi₁ _
      · have h1 : algebraMap k (ExteriorAlgebra k V) (c₁ * c₂)
            = algebraMap k (ExteriorAlgebra k V) c₁ * algebraMap k (ExteriorAlgebra k V) c₂ :=
          map_mul _ _ _
        have h2 : ι k (c₁ • v₂) = algebraMap k (ExteriorAlgebra k V) c₁ * ι k v₂ := by
          rw [map_smul, Algebra.smul_def]
        have h3 : ι k (c₂ • v₁) = ι k v₁ * algebraMap k (ExteriorAlgebra k V) c₂ := by
          rw [map_smul, Algebra.smul_def, Algebra.commutes]
        rw [h1, map_add, h2, h3]
        noncomm_ring

/-- **A generated square-zero target is a quotient of the exterior algebra.**  This is the general
form of the surjection to be factored: any algebra generated by a space of square-zero elements
receives a surjection from the free graded-commutative algebra on that space. -/
theorem deningerExteriorLift_surjective {A : Type*} [Ring A] [Algebra k A] (j : V →ₗ[k] A)
    (hj : ∀ v, j v * j v = 0) (hgen : Algebra.adjoin k (Set.range j) = ⊤) :
    Function.Surjective (ExteriorAlgebra.lift k ⟨j, hj⟩) := by
  rw [← AlgHom.range_eq_top]
  refine top_le_iff.mp ?_
  rw [← hgen, Algebra.adjoin_le_iff]
  rintro _ ⟨v, rfl⟩
  exact ⟨ι k v, ExteriorAlgebra.lift_ι_apply k j hj v⟩

variable (k V) [Module kᵐᵒᵖ V] [IsCentralScalar k V]

/-- **The canonical map to the two-term algebra**: the exterior algebra maps to the split
square-zero extension by sending each generator to its square-zero copy. -/
noncomputable def deningerMilnorEpsilon :
    ExteriorAlgebra k V →ₐ[k] TrivSqZeroExt k V :=
  ExteriorAlgebra.lift k ⟨TrivSqZeroExt.inrHom k V, fun v => TrivSqZeroExt.inr_mul_inr k v v⟩

variable {k V}

@[simp]
theorem deningerMilnorEpsilon_ι (v : V) :
    deningerMilnorEpsilon k V (ι k v) = TrivSqZeroExt.inr v := by
  rw [deningerMilnorEpsilon, ExteriorAlgebra.lift_ι_apply]
  rfl

theorem deningerMilnorEpsilon_algebraMap (c : k) :
    deningerMilnorEpsilon k V (algebraMap k (ExteriorAlgebra k V) c) = TrivSqZeroExt.inl c := by
  rw [AlgHom.commutes]
  exact congrFun (TrivSqZeroExt.algebraMap_eq_inl k V) c

/-- **The canonical map is surjective**: it is the identity on scalars and on generators, and
those exhaust the two-term algebra. -/
theorem deningerMilnorEpsilon_surjective :
    Function.Surjective (deningerMilnorEpsilon k V) := by
  intro x
  refine ⟨algebraMap k (ExteriorAlgebra k V) x.fst + ι k x.snd, ?_⟩
  rw [map_add, deningerMilnorEpsilon_algebraMap, deningerMilnorEpsilon_ι,
    TrivSqZeroExt.inl_fst_add_inr_snd_eq]

theorem deningerMilnorIdeal_le_ker :
    deningerMilnorIdeal k V ≤ RingHom.ker (deningerMilnorEpsilon k V) := by
  rw [deningerMilnorIdeal, Ideal.span_le]
  intro x hx
  have hx' : x ∈ LinearMap.range (ι k : V →ₗ[k] ExteriorAlgebra k V) *
      LinearMap.range (ι k : V →ₗ[k] ExteriorAlgebra k V) := by
    rw [← pow_two]
    exact hx
  rw [SetLike.mem_coe, RingHom.mem_ker]
  refine Submodule.mul_induction_on hx' ?_ ?_
  · rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩
    rw [map_mul, deningerMilnorEpsilon_ι, deningerMilnorEpsilon_ι]
    exact TrivSqZeroExt.inr_mul_inr k a b
  · intro p q hp hq
    rw [map_add, hp, hq, add_zero]

/-- **The kernel of the canonical map is the Milnor ideal.**  A scalar plus a generator maps to
zero only if both vanish, so the whole kernel is the degree-two ideal. -/
theorem deningerMilnorEpsilon_ker :
    RingHom.ker (deningerMilnorEpsilon k V) = deningerMilnorIdeal k V := by
  refine le_antisymm ?_ deningerMilnorIdeal_le_ker
  intro x hx
  obtain ⟨c, v, i, hi, rfl⟩ := deningerExterior_decomposition x
  rw [RingHom.mem_ker, map_add, map_add, deningerMilnorEpsilon_algebraMap,
    deningerMilnorEpsilon_ι] at hx
  rw [RingHom.mem_ker.mp (deningerMilnorIdeal_le_ker hi), add_zero] at hx
  have hc : c = 0 := by
    have := congrArg TrivSqZeroExt.fst hx
    simpa using this
  have hv : v = 0 := by
    have := congrArg TrivSqZeroExt.snd hx
    simpa using this
  subst hc
  subst hv
  simpa using hi

/-- **The two-term algebra is the Milnor quotient of the exterior algebra.** -/
noncomputable def deningerMilnorQuotientEquiv :
    (ExteriorAlgebra k V ⧸ deningerMilnorIdeal k V) ≃ₐ[k] TrivSqZeroExt k V :=
  (Ideal.quotientEquivAlgOfEq k deningerMilnorEpsilon_ker.symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective deningerMilnorEpsilon_surjective)

end MilnorQuotient

section RelativeExtension

variable (k V W : Type*) [CommRing k] [AddCommGroup V] [Module k V] [AddCommGroup W] [Module k W]

/-- **The relative extension** obtained by adjoining a space `W` of new degree-one generators:
the exterior algebra on the direct sum, which is the graded tensor product of the two exterior
algebras. -/
def deningerSullivanInclusion : ExteriorAlgebra k V →ₐ[k] ExteriorAlgebra k (V × W) :=
  ExteriorAlgebra.map (LinearMap.inl k V W)

/-- The augmentation of the relative extension, killing the new generators. -/
def deningerSullivanAugmentation : ExteriorAlgebra k (V × W) →ₐ[k] ExteriorAlgebra k V :=
  ExteriorAlgebra.map (LinearMap.fst k V W)

variable {k V W}

@[simp]
theorem deningerSullivanInclusion_ι (v : V) :
    deningerSullivanInclusion k V W (ι k v) = ι k ((v, 0) : V × W) :=
  ExteriorAlgebra.map_apply_ι _ v

@[simp]
theorem deningerSullivanAugmentation_ι (p : V × W) :
    deningerSullivanAugmentation k V W (ι k p) = ι k p.1 :=
  ExteriorAlgebra.map_apply_ι _ p

theorem deningerSullivanAugmentation_comp_inclusion :
    (deningerSullivanAugmentation k V W).comp (deningerSullivanInclusion k V W)
      = AlgHom.id k (ExteriorAlgebra k V) := by
  rw [deningerSullivanAugmentation, deningerSullivanInclusion, ExteriorAlgebra.map_comp_map,
    LinearMap.fst_comp_inl, ExteriorAlgebra.map_id]

/-- **The old algebra is a retract of the relative extension**, hence includes into it. -/
theorem deningerSullivanInclusion_injective :
    Function.Injective (deningerSullivanInclusion k V W) := by
  intro x y h
  have hx := AlgHom.congr_fun (deningerSullivanAugmentation_comp_inclusion (k := k)
    (V := V) (W := W)) x
  have hy := AlgHom.congr_fun (deningerSullivanAugmentation_comp_inclusion (k := k)
    (V := V) (W := W)) y
  simp only [AlgHom.comp_apply, AlgHom.id_apply] at hx hy
  rw [← hx, ← hy, h]

variable (k V W)

/-- The ideal generated by the new degree-one generators. -/
def deningerSullivanNewIdeal : Ideal (ExteriorAlgebra k (V × W)) :=
  Ideal.span (Set.range fun w : W => ι k ((0, w) : V × W))

variable {k V W}

/-- A new generator moves past any element up to replacing that element: generators
anticommute, so odd generators are normal. -/
theorem deningerSullivanNew_normal (w : W) (z : ExteriorAlgebra k (V × W)) :
    ∃ z' : ExteriorAlgebra k (V × W),
      ι k ((0, w) : V × W) * z = z' * ι k ((0, w) : V × W) := by
  induction z using ExteriorAlgebra.induction with
  | algebraMap r =>
      exact ⟨algebraMap k (ExteriorAlgebra k (V × W)) r, (Algebra.commutes r _).symm⟩
  | ι m =>
      refine ⟨-(ι k m), ?_⟩
      rw [neg_mul]
      exact add_eq_zero_iff_eq_neg.mp (ExteriorAlgebra.ι_add_mul_swap _ m)
  | mul a b ha hb =>
      obtain ⟨a', ha'⟩ := ha
      obtain ⟨b', hb'⟩ := hb
      refine ⟨a' * b', ?_⟩
      rw [← mul_assoc, ha', mul_assoc, hb', ← mul_assoc]
  | add a b ha hb =>
      obtain ⟨a', ha'⟩ := ha
      obtain ⟨b', hb'⟩ := hb
      refine ⟨a' + b', ?_⟩
      rw [mul_add, ha', hb', add_mul]

/-- **The new-generator ideal is two-sided.** -/
theorem deningerSullivanNewIdeal_mul_right {i : ExteriorAlgebra k (V × W)}
    (hi : i ∈ deningerSullivanNewIdeal k V W) (z : ExteriorAlgebra k (V × W)) :
    i * z ∈ deningerSullivanNewIdeal k V W := by
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hi
  · rintro _ ⟨w, rfl⟩
    obtain ⟨z', hz'⟩ := deningerSullivanNew_normal (V := V) w z
    rw [hz']
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨w, rfl⟩)
  · rw [zero_mul]
    exact Submodule.zero_mem _
  · intro p q _ _ hp hq
    rw [add_mul]
    exact Submodule.add_mem _ hp hq
  · intro a p _ hp
    rw [smul_eq_mul, mul_assoc]
    exact Ideal.mul_mem_left _ a hp

instance deningerSullivanNewIdeal_isTwoSided : (deningerSullivanNewIdeal k V W).IsTwoSided :=
  ⟨fun b hi => deningerSullivanNewIdeal_mul_right hi b⟩

theorem deningerSullivanNewIdeal_le_ker :
    deningerSullivanNewIdeal k V W ≤ RingHom.ker (deningerSullivanAugmentation k V W) := by
  rw [deningerSullivanNewIdeal, Ideal.span_le]
  rintro _ ⟨w, rfl⟩
  rw [SetLike.mem_coe, RingHom.mem_ker, deningerSullivanAugmentation_ι]
  exact map_zero _

/-- **The relative extension is the old algebra plus the new-generator ideal.** -/
theorem deningerSullivan_decomposition (x : ExteriorAlgebra k (V × W)) :
    ∃ y : ExteriorAlgebra k V, ∃ i ∈ deningerSullivanNewIdeal k V W,
      x = deningerSullivanInclusion k V W y + i := by
  have hx : x ∈ Algebra.adjoin k
      (Set.range (ι k : (V × W) →ₗ[k] ExteriorAlgebra k (V × W))) := by
    rw [CliffordAlgebra.adjoin_range_ι]
    trivial
  induction hx using Algebra.adjoin_induction with
  | mem y hy =>
      obtain ⟨p, rfl⟩ := hy
      refine ⟨ι k p.1, ι k ((0, p.2) : V × W), Ideal.subset_span ⟨p.2, rfl⟩, ?_⟩
      rw [deningerSullivanInclusion_ι, ← map_add]
      congr 1
      exact (Prod.ext (add_zero p.1) (zero_add p.2)).symm
  | algebraMap r =>
      refine ⟨algebraMap k (ExteriorAlgebra k V) r, 0, Submodule.zero_mem _, ?_⟩
      rw [AlgHom.commutes, add_zero]
  | add a b _ _ ha hb =>
      obtain ⟨y₁, i₁, hi₁, rfl⟩ := ha
      obtain ⟨y₂, i₂, hi₂, rfl⟩ := hb
      refine ⟨y₁ + y₂, i₁ + i₂, Submodule.add_mem _ hi₁ hi₂, ?_⟩
      rw [map_add]
      abel
  | mul a b _ _ ha hb =>
      obtain ⟨y₁, i₁, hi₁, rfl⟩ := ha
      obtain ⟨y₂, i₂, hi₂, rfl⟩ := hb
      refine ⟨y₁ * y₂, deningerSullivanInclusion k V W y₁ * i₂
        + i₁ * deningerSullivanInclusion k V W y₂ + i₁ * i₂, ?_, ?_⟩
      · exact Submodule.add_mem _ (Submodule.add_mem _ (Ideal.mul_mem_left _ _ hi₂)
          (deningerSullivanNewIdeal_mul_right hi₁ _)) (deningerSullivanNewIdeal_mul_right hi₁ _)
      · rw [map_mul]
        noncomm_ring

/-- **The augmentation ideal of the relative extension is generated by the new generators.**
This is the freeness of the relative extension: the new generators cut out exactly the old
algebra. -/
theorem deningerSullivanAugmentation_ker :
    RingHom.ker (deningerSullivanAugmentation k V W) = deningerSullivanNewIdeal k V W := by
  refine le_antisymm ?_ deningerSullivanNewIdeal_le_ker
  intro x hx
  obtain ⟨y, i, hi, rfl⟩ := deningerSullivan_decomposition x
  rw [RingHom.mem_ker, map_add,
    RingHom.mem_ker.mp (deningerSullivanNewIdeal_le_ker hi), add_zero] at hx
  have hy : y = 0 := by
    have h := AlgHom.congr_fun (deningerSullivanAugmentation_comp_inclusion (k := k)
      (V := V) (W := W)) y
    simp only [AlgHom.comp_apply, AlgHom.id_apply] at h
    rw [h] at hx
    exact hx
  subst hy
  simpa using hi

/-- **The relative extension modulo its new generators is the old algebra.** -/
noncomputable def deningerSullivanRelativeEquiv :
    (ExteriorAlgebra k (V × W) ⧸ deningerSullivanNewIdeal k V W) ≃ₐ[k] ExteriorAlgebra k V :=
  (Ideal.quotientEquivAlgOfEq k deningerSullivanAugmentation_ker.symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (f := deningerSullivanAugmentation k V W)
      (fun y => ⟨deningerSullivanInclusion k V W y, by
        have h := AlgHom.congr_fun (deningerSullivanAugmentation_comp_inclusion (k := k)
          (V := V) (W := W)) y
        simpa using h⟩))

/-- **The range of the inclusion is the subalgebra generated by the old generators.** -/
theorem deningerSullivanInclusion_range :
    (deningerSullivanInclusion k V W).range
      = Algebra.adjoin k (Set.range fun v : V => ι k ((v, 0) : V × W)) := by
  refine le_antisymm ?_ ?_
  · rintro x ⟨y, rfl⟩
    show deningerSullivanInclusion k V W y
      ∈ Algebra.adjoin k (Set.range fun v : V => ι k ((v, 0) : V × W))
    induction y using ExteriorAlgebra.induction with
    | algebraMap r =>
        rw [AlgHom.commutes]
        exact Subalgebra.algebraMap_mem _ r
    | ι v =>
        rw [deningerSullivanInclusion_ι]
        exact Algebra.subset_adjoin ⟨v, rfl⟩
    | mul a b ha hb =>
        rw [map_mul]
        exact Subalgebra.mul_mem _ ha hb
    | add a b ha hb =>
        rw [map_add]
        exact Subalgebra.add_mem _ ha hb
  · rw [Algebra.adjoin_le_iff]
    rintro _ ⟨v, rfl⟩
    exact ⟨ι k v, deningerSullivanInclusion_ι v⟩

end RelativeExtension

section Filtration

variable (k V W B : Type*) [CommRing k] [AddCommGroup V] [Module k V] [AddCommGroup W]
  [Module k W] [Preorder B]

/-- **A relative Sullivan extension.**  The new generators carry a filtration indexed by a
well-ordered type which exhausts them, and the differential of a generator appearing at a stage
lies in the subalgebra generated by the old generators together with the generators of strictly
earlier stages. -/
structure DeningerRelativeSullivan where
  /-- The filtration of the space of new generators. -/
  filt : B → Submodule k W
  /-- The filtration is increasing. -/
  mono : Monotone filt
  /-- The filtration exhausts the new generators. -/
  exhaust : ⨆ b, filt b = ⊤
  /-- The differential of the new generators. -/
  d : W →ₗ[k] ExteriorAlgebra k (V × W)
  /-- Lower triangularity: the differential of a stage lies in the algebra of earlier stages. -/
  lower : ∀ b : B, ∀ w ∈ filt b, d w ∈ Algebra.adjoin k
    ((Set.range fun v : V => ι k ((v, 0) : V × W)) ∪
      ⋃ b' ∈ {b' : B | b' < b}, (fun w : W => ι k ((0, w) : V × W)) '' (filt b' : Set W))

variable {k V W B}

end Filtration

section FirstLayer

variable (k V : Type*) [CommRing k] [AddCommGroup V] [Module k V]

/-- **The differential of the first relative Sullivan layer.**  The new degree-one generators are
indexed by the degree-two part, and the differential of a generator is the degree-two element it
kills. -/
def deningerSullivanFirstDifferential :
    (⋀[k]^(2 : ℕ) V) →ₗ[k] ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V)) :=
  (deningerSullivanInclusion k V (⋀[k]^(2 : ℕ) V)).toLinearMap ∘ₗ (⋀[k]^(2 : ℕ) V).subtype

@[simp]
theorem deningerSullivanFirstDifferential_apply (w : ⋀[k]^(2 : ℕ) V) :
    deningerSullivanFirstDifferential k V w
      = deningerSullivanInclusion k V (⋀[k]^(2 : ℕ) V) (w : ExteriorAlgebra k V) := rfl

/-- **The first layer kills the degree-two products**: every product of two generators is the
differential of a new generator. -/
theorem deningerSullivanFirstDifferential_covers (a b : V) :
    deningerSullivanFirstDifferential k V ⟨ι k a * ι k b, deningerExteriorTwo_mem a b⟩
      = deningerSullivanInclusion k V (⋀[k]^(2 : ℕ) V) (ι k a * ι k b) := rfl

/-- The differential of the first layer is injective, so the layer creates no new degree-one
cohomology. -/
theorem deningerSullivanFirstDifferential_injective :
    Function.Injective (deningerSullivanFirstDifferential k V) := by
  intro x y h
  exact Subtype.ext (deningerSullivanInclusion_injective h)

variable {k V}

/-- **The ideal spanned by the first-layer differential is exactly the ideal to be killed.**
Pulling back along the inclusion, the span of the differential of the first layer is the Milnor
ideal, which by `deningerMilnorEpsilon_ker` is the kernel of the map to the two-term algebra. -/
theorem deningerSullivanFirstDifferential_span :
    Ideal.span (Set.range ((⋀[k]^(2 : ℕ) V).subtype)) = deningerMilnorIdeal k V := by
  rw [deningerMilnorIdeal]
  congr 1
  exact Subtype.range_coe

section SquareZeroTarget

variable [Module kᵐᵒᵖ V] [IsCentralScalar k V]

theorem deningerSullivanFirstDifferential_span_eq_ker :
    Ideal.span (Set.range ((⋀[k]^(2 : ℕ) V).subtype))
      = RingHom.ker (deningerMilnorEpsilon k V) := by
  rw [deningerSullivanFirstDifferential_span, deningerMilnorEpsilon_ker]

end SquareZeroTarget

variable (k V)

/-- **The first relative Sullivan layer**, with its one-stage filtration and its lower-triangular
differential: the differential of every new generator lies in the subalgebra generated by the old
generators. -/
noncomputable def deningerSullivanFirstLayer :
    DeningerRelativeSullivan k V (⋀[k]^(2 : ℕ) V) Unit where
  filt _ := ⊤
  mono := fun _ _ _ => le_refl _
  exhaust := by
    simp
  d := deningerSullivanFirstDifferential k V
  lower := by
    intro b w _
    have hempty : (⋃ b' ∈ {b' : Unit | b' < b},
        (fun w : (⋀[k]^(2 : ℕ) V) => ι k ((0, w) : V × (⋀[k]^(2 : ℕ) V))) ''
          ((⊤ : Submodule k (⋀[k]^(2 : ℕ) V)) : Set (⋀[k]^(2 : ℕ) V)))
        = (∅ : Set (ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V)))) := by
      simp
    rw [hempty, Set.union_empty, ← deningerSullivanInclusion_range]
    exact ⟨(w : ExteriorAlgebra k V), rfl⟩

section Projection

variable [Module kᵐᵒᵖ V] [IsCentralScalar k V]

/-- **The projection of the first layer onto the two-term algebra is surjective**, which is the
algebra-level half of the quasi-isomorphism: the relative extension still maps onto the Milnor
algebra. -/
theorem deningerSullivanFirstLayerProjection_surjective :
    Function.Surjective
      ((deningerMilnorEpsilon k V).comp (deningerSullivanAugmentation k V (⋀[k]^(2 : ℕ) V))) := by
  intro x
  obtain ⟨z, hz⟩ := deningerMilnorEpsilon_surjective (k := k) (V := V) x
  refine ⟨deningerSullivanInclusion k V (⋀[k]^(2 : ℕ) V) z, ?_⟩
  have h := AlgHom.congr_fun (deningerSullivanAugmentation_comp_inclusion (k := k)
    (V := V) (W := (⋀[k]^(2 : ℕ) V))) z
  rw [AlgHom.comp_apply, AlgHom.id_apply] at h
  rw [AlgHom.comp_apply, h, hz]

end Projection

end FirstLayer

section FirstLayerDifferential

open HTGeometry

variable {k V : Type*} [CommRing k] [AddCommGroup V] [Module k V]

/-- The grading involution is the identity on the degree-two part. -/
theorem deningerExteriorInvolute_exteriorTwo {U : Type*} [AddCommGroup U] [Module k U]
    {x : ExteriorAlgebra k U} (hx : x ∈ ⋀[k]^(2 : ℕ) U) :
    deningerExteriorInvolute k U x = x := by
  have hx' : x ∈ LinearMap.range (ι k : U →ₗ[k] ExteriorAlgebra k U) *
      LinearMap.range (ι k : U →ₗ[k] ExteriorAlgebra k U) := by
    rw [← pow_two]
    exact hx
  refine Submodule.mul_induction_on hx' ?_ ?_
  · rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩
    rw [map_mul, deningerExteriorInvolute_ι, deningerExteriorInvolute_ι, neg_mul_neg]
  · intro p q hp hq
    rw [map_add, hp, hq]

/-- The relative inclusion carries the degree-two part into the degree-two part. -/
theorem deningerSullivanInclusion_exteriorTwo (W : Type*) [AddCommGroup W] [Module k W]
    {x : ExteriorAlgebra k V} (hx : x ∈ ⋀[k]^(2 : ℕ) V) :
    deningerSullivanInclusion k V W x ∈ ⋀[k]^(2 : ℕ) (V × W) := by
  have hx' : x ∈ LinearMap.range (ι k : V →ₗ[k] ExteriorAlgebra k V) *
      LinearMap.range (ι k : V →ₗ[k] ExteriorAlgebra k V) := by
    rw [← pow_two]
    exact hx
  refine Submodule.mul_induction_on hx' ?_ ?_
  · rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩
    rw [map_mul, deningerSullivanInclusion_ι, deningerSullivanInclusion_ι]
    exact deningerExteriorTwo_mem _ _
  · intro p q hp hq
    rw [map_add]
    exact Submodule.add_mem _ hp hq

variable (k V)

/-- The generator assignment of the first Sullivan layer on the whole generator space: the old
generators are closed and every new generator maps to the degree-two element it kills. -/
noncomputable def deningerSullivanFirstPhi :
    (V × (⋀[k]^(2 : ℕ) V)) →ₗ[k] ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V)) :=
  (deningerSullivanFirstDifferential k V).comp (LinearMap.snd k V (⋀[k]^(2 : ℕ) V))

@[simp]
theorem deningerSullivanFirstPhi_apply (u : V × (⋀[k]^(2 : ℕ) V)) :
    deningerSullivanFirstPhi k V u =
      deningerSullivanInclusion k V (⋀[k]^(2 : ℕ) V) ((u.2 : ExteriorAlgebra k V)) :=
  rfl

variable {k V}

/-- Every generator value of the first layer lies in the degree-two part. -/
theorem deningerSullivanFirstPhi_mem (u : V × (⋀[k]^(2 : ℕ) V)) :
    deningerSullivanFirstPhi k V u ∈ ⋀[k]^(2 : ℕ) (V × (⋀[k]^(2 : ℕ) V)) :=
  deningerSullivanInclusion_exteriorTwo _ u.2.2

/-- The generator values of the first layer are central, so they determine an odd derivation. -/
theorem deningerSullivanFirstPhi_commute (u : V × (⋀[k]^(2 : ℕ) V))
    (x : ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V))) :
    Commute (deningerSullivanFirstPhi k V u) x :=
  deningerExteriorPowerTwo_central (deningerSullivanFirstPhi_mem u) x

/-- The generator values of the first layer are invariant under the grading involution. -/
theorem deningerSullivanFirstPhi_involute (u : V × (⋀[k]^(2 : ℕ) V)) :
    deningerExteriorInvolute k (V × (⋀[k]^(2 : ℕ) V)) (deningerSullivanFirstPhi k V u) =
      deningerSullivanFirstPhi k V u :=
  deningerExteriorInvolute_exteriorTwo (deningerSullivanFirstPhi_mem u)

variable (k V)

/-- **The differential of the first relative Sullivan layer**, as an odd derivation of the whole
extension algebra. -/
noncomputable def deningerSullivanFirstLayerDifferential :
    ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V)) →ₗ[k] ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V)) :=
  deningerOddDerivation (deningerSullivanFirstPhi k V) deningerSullivanFirstPhi_commute

variable {k V}

/-- The old generators are closed. -/
@[simp]
theorem deningerSullivanFirstLayerDifferential_old (v : V) :
    deningerSullivanFirstLayerDifferential k V (ι k ((v, 0) : V × (⋀[k]^(2 : ℕ) V))) = 0 := by
  rw [deningerSullivanFirstLayerDifferential, deningerOddDerivation_ι,
    deningerSullivanFirstPhi_apply]
  simp

/-- Every new generator has the degree-two element it kills as differential. -/
@[simp]
theorem deningerSullivanFirstLayerDifferential_new (w : ⋀[k]^(2 : ℕ) V) :
    deningerSullivanFirstLayerDifferential k V (ι k ((0, w) : V × (⋀[k]^(2 : ℕ) V))) =
      deningerSullivanInclusion k V (⋀[k]^(2 : ℕ) V) (w : ExteriorAlgebra k V) := by
  rw [deningerSullivanFirstLayerDifferential, deningerOddDerivation_ι,
    deningerSullivanFirstPhi_apply]

/-- **The graded Leibniz rule for the first-layer differential.** -/
theorem deningerSullivanFirstLayerDifferential_leibniz
    (x y : ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V))) :
    deningerSullivanFirstLayerDifferential k V (x * y) =
      deningerExteriorInvolute k (V × (⋀[k]^(2 : ℕ) V)) x *
          deningerSullivanFirstLayerDifferential k V y +
        deningerSullivanFirstLayerDifferential k V x * y :=
  deningerOddDerivation_leibniz _ _ x y

/-- The first-layer differential kills the image of the degree-two part. -/
theorem deningerSullivanFirstLayerDifferential_kill {x : ExteriorAlgebra k V}
    (hx : x ∈ ⋀[k]^(2 : ℕ) V) :
    deningerSullivanFirstLayerDifferential k V
      (deningerSullivanInclusion k V (⋀[k]^(2 : ℕ) V) x) = 0 := by
  have hx' : x ∈ LinearMap.range (ι k : V →ₗ[k] ExteriorAlgebra k V) *
      LinearMap.range (ι k : V →ₗ[k] ExteriorAlgebra k V) := by
    rw [← pow_two]
    exact hx
  refine Submodule.mul_induction_on hx' ?_ ?_
  · rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩
    rw [map_mul, deningerSullivanInclusion_ι, deningerSullivanInclusion_ι,
      deningerSullivanFirstLayerDifferential_leibniz,
      deningerSullivanFirstLayerDifferential_old,
      deningerSullivanFirstLayerDifferential_old]
    simp
  · intro p q hp hq
    rw [map_add, map_add, hp, hq, add_zero]

/-- **The first-layer differential squares to zero**, so the first relative Sullivan layer is an
honest differential graded algebra. -/
theorem deningerSullivanFirstLayerDifferential_comp_self
    (x : ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V))) :
    deningerSullivanFirstLayerDifferential k V
      (deningerSullivanFirstLayerDifferential k V x) = 0 :=
  deningerOddDerivation_comp_self _ _ deningerSullivanFirstPhi_involute
    (fun u => deningerSullivanFirstLayerDifferential_kill u.2.2) x

/-- The base of closed generators of the first layer: the old generators. -/
def deningerSullivanFirstBase (k V : Type*) [CommRing k] [AddCommGroup V] [Module k V] :
    Submodule k (V × (⋀[k]^(2 : ℕ) V)) :=
  Submodule.prod (⊤ : Submodule k V) (⊥ : Submodule k (⋀[k]^(2 : ℕ) V))

theorem deningerSullivanFirstBase_mem (v : V) :
    ((v, 0) : V × (⋀[k]^(2 : ℕ) V)) ∈ deningerSullivanFirstBase k V :=
  ⟨Submodule.mem_top, Submodule.zero_mem _⟩

/-- The image of the degree-two part lies in the subalgebra of the old generators. -/
theorem deningerSullivanInclusion_mem_baseSubalgebra {x : ExteriorAlgebra k V}
    (hx : x ∈ ⋀[k]^(2 : ℕ) V) :
    deningerSullivanInclusion k V (⋀[k]^(2 : ℕ) V) x ∈
      deningerGeneratorSubalgebra (deningerSullivanFirstBase k V) := by
  have hx' : x ∈ LinearMap.range (ι k : V →ₗ[k] ExteriorAlgebra k V) *
      LinearMap.range (ι k : V →ₗ[k] ExteriorAlgebra k V) := by
    rw [← pow_two]
    exact hx
  refine Submodule.mul_induction_on hx' ?_ ?_
  · rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩
    rw [map_mul, deningerSullivanInclusion_ι, deningerSullivanInclusion_ι]
    exact Subalgebra.mul_mem _
      (deningerGeneratorSubalgebra_ι (deningerSullivanFirstBase_mem a))
      (deningerGeneratorSubalgebra_ι (deningerSullivanFirstBase_mem b))
  · intro p q hp hq
    rw [map_add]
    exact Subalgebra.add_mem _ hp hq

variable (k V)

/-- **The first relative Sullivan layer as a Sullivan tower.**  Its one stage sits above the base of
closed old generators, its differential is the odd derivation of the layer, and lower triangularity
holds because every new generator differentiates into the subalgebra of the old ones.  In
particular the tower structure is not vacuous. -/
noncomputable def deningerSullivanFirstTower :
    DeningerSullivanTower k (V × (⋀[k]^(2 : ℕ) V)) Unit where
  base := deningerSullivanFirstBase k V
  filt _ := ⊤
  base_le _ := le_top
  mono := fun _ _ _ => le_refl _
  exhaust := by simp
  phi := deningerSullivanFirstPhi k V
  central := deningerSullivanFirstPhi_commute
  involute := deningerSullivanFirstPhi_involute
  lower := by
    intro b u _
    have hempty : (⨆ b' ∈ {b' : Unit | b' < b}, (⊤ : Submodule k (V × (⋀[k]^(2 : ℕ) V)))) = ⊥ := by
      simp
    rw [hempty, sup_bot_eq]
    exact deningerSullivanInclusion_mem_baseSubalgebra u.2.2
  kill := fun u => deningerSullivanFirstLayerDifferential_kill u.2.2

variable {k V}

@[simp]
theorem deningerSullivanFirstTower_d :
    (deningerSullivanFirstTower k V).d = deningerSullivanFirstLayerDifferential k V :=
  rfl

/-- **The degree-one cocycles of the first layer are exactly the old generators.**  A new generator
is never closed, so the first layer creates no degree-one cohomology and its degree-one cocycle
space is the base `V`. -/
theorem deningerSullivanFirstPhi_ker :
    LinearMap.ker (deningerSullivanFirstPhi k V) = deningerSullivanFirstBase k V := by
  refine le_antisymm (fun u hu => ?_) (fun u hu => ?_)
  · refine ⟨Submodule.mem_top, ?_⟩
    have h : deningerSullivanInclusion k V (⋀[k]^(2 : ℕ) V) ((u.2 : ExteriorAlgebra k V)) = 0 := hu
    have h0 : ((u.2 : ExteriorAlgebra k V)) = 0 := by
      have := deningerSullivanInclusion_injective (k := k) (V := V) (W := (⋀[k]^(2 : ℕ) V))
      exact this (by rw [h, map_zero])
    exact Submodule.mem_bot k |>.mpr (Subtype.ext h0)
  · have h0 : u.2 = 0 := (Submodule.mem_bot k).mp hu.2
    show deningerSullivanInclusion k V (⋀[k]^(2 : ℕ) V) ((u.2 : ExteriorAlgebra k V)) = 0
    rw [h0]
    simp

/-- The first-layer tower is closed exactly on the old generators. -/
theorem deningerSullivanFirstTower_d_ι_eq_zero_iff (u : V × (⋀[k]^(2 : ℕ) V)) :
    (deningerSullivanFirstTower k V).d (ι k u) = 0 ↔ u ∈ deningerSullivanFirstBase k V := by
  rw [(deningerSullivanFirstTower k V).d_ι_eq_zero_iff]
  show u ∈ LinearMap.ker (deningerSullivanFirstPhi k V) ↔ _
  rw [deningerSullivanFirstPhi_ker]

/-- **The old algebra consists of cocycles.**  The first-layer differential vanishes on the whole
image of `Λ(V)`, because it vanishes on the old generators and obeys the Leibniz rule. -/
theorem deningerSullivanFirstLayerDifferential_inl (z : ExteriorAlgebra k V) :
    deningerSullivanFirstLayerDifferential k V
      (deningerSullivanInclusion k V (⋀[k]^(2 : ℕ) V) z) = 0 := by
  induction z using ExteriorAlgebra.induction with
  | algebraMap r =>
    rw [AlgHom.commutes, deningerSullivanFirstLayerDifferential,
      deningerOddDerivation_algebraMap]
  | ι v =>
    rw [deningerSullivanInclusion_ι, deningerSullivanFirstLayerDifferential_old]
  | add a b ha hb => rw [map_add, map_add, ha, hb, add_zero]
  | mul a b ha hb =>
    rw [map_mul, deningerSullivanFirstLayerDifferential_leibniz, ha, hb]
    simp

end FirstLayerDifferential

section FirstLayerChainMap

open HTGeometry

variable {k V : Type*} [CommRing k] [AddCommGroup V] [Module k V]
variable [Module kᵐᵒᵖ V] [IsCentralScalar k V]

variable (k V)

/-- The map of the first layer onto the two-term algebra: the augmentation followed by the Milnor
projection. -/
noncomputable def deningerSullivanFirstProjection :
    ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V)) →ₐ[k] TrivSqZeroExt k V :=
  (deningerMilnorEpsilon k V).comp (deningerSullivanAugmentation k V (⋀[k]^(2 : ℕ) V))

variable {k V}

@[simp]
theorem deningerSullivanFirstProjection_inl (z : ExteriorAlgebra k V) :
    deningerSullivanFirstProjection k V (deningerSullivanInclusion k V (⋀[k]^(2 : ℕ) V) z) =
      deningerMilnorEpsilon k V z := by
  rw [deningerSullivanFirstProjection, AlgHom.comp_apply]
  have h := AlgHom.congr_fun
    (deningerSullivanAugmentation_comp_inclusion (k := k) (V := V) (W := (⋀[k]^(2 : ℕ) V))) z
  rw [AlgHom.comp_apply, AlgHom.id_apply] at h
  rw [h]

/-- **The projection is a chain map.**  The target carries the zero differential, and the
projection kills every coboundary of the first layer, so it is a map of differential graded
algebras. -/
theorem deningerSullivanFirstProjection_comp_d (x : ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V))) :
    deningerSullivanFirstProjection k V
      (deningerSullivanFirstLayerDifferential k V x) = 0 := by
  induction x using ExteriorAlgebra.induction with
  | algebraMap r =>
    rw [deningerSullivanFirstLayerDifferential, deningerOddDerivation_algebraMap, map_zero]
  | ι u =>
    rw [deningerSullivanFirstLayerDifferential, deningerOddDerivation_ι,
      deningerSullivanFirstPhi_apply, deningerSullivanFirstProjection_inl]
    exact deningerMilnorIdeal_le_ker (Ideal.subset_span u.2.2)
  | add a b ha hb => rw [map_add, map_add, ha, hb, add_zero]
  | mul a b ha hb =>
    rw [deningerSullivanFirstLayerDifferential_leibniz, map_add, map_mul, map_mul, ha, hb]
    simp

/-- **Every class of the two-term algebra is represented by a cocycle.**  The old algebra consists
of cocycles and already surjects onto the target, so the projection is surjective on cohomology. -/
theorem deningerSullivanFirstProjection_cocycle_surjective (x : TrivSqZeroExt k V) :
    ∃ z : ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V)),
      deningerSullivanFirstLayerDifferential k V z = 0 ∧
        deningerSullivanFirstProjection k V z = x := by
  obtain ⟨y, hy⟩ := deningerMilnorEpsilon_surjective (k := k) (V := V) x
  refine ⟨deningerSullivanInclusion k V (⋀[k]^(2 : ℕ) V) y, ?_, ?_⟩
  · exact deningerSullivanFirstLayerDifferential_inl y
  · rw [deningerSullivanFirstProjection_inl, hy]

/-- **The degree-one comparison is injective.**  A generator that is closed and dies in the target
is zero, so the first layer creates no spurious degree-one class. -/
theorem deningerSullivanFirstProjection_ι_eq_zero {u : V × (⋀[k]^(2 : ℕ) V)}
    (hcocycle : deningerSullivanFirstLayerDifferential k V (ι k u) = 0)
    (hzero : deningerSullivanFirstProjection k V (ι k u) = 0) :
    u = 0 := by
  have hbase : u ∈ deningerSullivanFirstBase k V := by
    rw [← deningerSullivanFirstTower_d_ι_eq_zero_iff]
    exact hcocycle
  have hsnd : u.2 = 0 := (Submodule.mem_bot k).mp hbase.2
  have hmk : u = ((u.1, 0) : V × (⋀[k]^(2 : ℕ) V)) := by
    refine Prod.ext rfl ?_
    exact hsnd
  have hval : deningerSullivanFirstProjection k V (ι k u) = TrivSqZeroExt.inr u.1 := by
    rw [hmk, ← deningerSullivanInclusion_ι, deningerSullivanFirstProjection_inl,
      deningerMilnorEpsilon_ι]
  rw [hval] at hzero
  have hfst : u.1 = 0 := by
    have := congrArg TrivSqZeroExt.snd hzero
    simpa using this
  rw [hmk, hfst]
  rfl

/-- **The degree-one comparison is surjective.**  Every degree-one class of the target is the image
of a closed old generator. -/
theorem deningerSullivanFirstProjection_degreeOne_surjective (v : V) :
    ∃ u : V × (⋀[k]^(2 : ℕ) V),
      deningerSullivanFirstLayerDifferential k V (ι k u) = 0 ∧
        deningerSullivanFirstProjection k V (ι k u) = TrivSqZeroExt.inr v := by
  refine ⟨(v, 0), deningerSullivanFirstLayerDifferential_old v, ?_⟩
  rw [← deningerSullivanInclusion_ι, deningerSullivanFirstProjection_inl,
    deningerMilnorEpsilon_ι]

/-- **The degree-one part of clause 3.**  On generators the comparison map of `(3)` is a bijection
between the closed generators and the degree-one part of the target: `H¹` of the first layer is
exactly `V`. -/
theorem deningerSullivanFirstProjection_degreeOne_bijective :
    (∀ v : V, ∃ u : V × (⋀[k]^(2 : ℕ) V),
        deningerSullivanFirstLayerDifferential k V (ι k u) = 0 ∧
          deningerSullivanFirstProjection k V (ι k u) = TrivSqZeroExt.inr v) ∧
      ∀ u : V × (⋀[k]^(2 : ℕ) V),
        deningerSullivanFirstLayerDifferential k V (ι k u) = 0 →
          deningerSullivanFirstProjection k V (ι k u) = 0 → u = 0 :=
  ⟨deningerSullivanFirstProjection_degreeOne_surjective,
    fun _ hc hz => deningerSullivanFirstProjection_ι_eq_zero hc hz⟩

/-- **Degree zero.**  The comparison map is a bijection between the scalars and the degree-zero
part of the target: `H⁰` of the first layer is `k`. -/
theorem deningerSullivanFirstProjection_degreeZero (c : k) :
    deningerSullivanFirstLayerDifferential k V
        (algebraMap k (ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V))) c) = 0 ∧
      deningerSullivanFirstProjection k V
        (algebraMap k (ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V))) c) = TrivSqZeroExt.inl c := by
  refine ⟨?_, ?_⟩
  · rw [deningerSullivanFirstLayerDifferential, deningerOddDerivation_algebraMap]
  · rw [AlgHom.commutes]
    exact congrFun (TrivSqZeroExt.algebraMap_eq_inl k V) c

theorem deningerSullivanFirstProjection_degreeZero_injective {c : k}
    (h : deningerSullivanFirstProjection k V
      (algebraMap k (ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V))) c) = 0) : c = 0 := by
  rw [(deningerSullivanFirstProjection_degreeZero c).2] at h
  have := congrArg TrivSqZeroExt.fst h
  simpa using this

end FirstLayerChainMap

section FirstLayerKilling

open HTGeometry

variable {k V : Type*} [CommRing k] [AddCommGroup V] [Module k V]

/-- The grading involution commutes with the relative inclusion. -/
theorem deningerExteriorInvolute_sullivanInclusion {W : Type*} [AddCommGroup W] [Module k W]
    (z : ExteriorAlgebra k V) :
    deningerExteriorInvolute k (V × W) (deningerSullivanInclusion k V W z) =
      deningerSullivanInclusion k V W (deningerExteriorInvolute k V z) := by
  have h : (deningerExteriorInvolute k (V × W)).comp (deningerSullivanInclusion k V W) =
      (deningerSullivanInclusion k V W).comp (deningerExteriorInvolute k V) := by
    ext v
    simp
  exact AlgHom.congr_fun h z

/-- **The first layer kills every degree-two class.**  Each element of the image of the degree-two
part is the differential of a new generator. -/
theorem deningerSullivanFirstLayer_exteriorTwo_isCoboundary {x : ExteriorAlgebra k V}
    (hx : x ∈ ⋀[k]^(2 : ℕ) V) :
    ∃ y, deningerSullivanFirstLayerDifferential k V y =
      deningerSullivanInclusion k V (⋀[k]^(2 : ℕ) V) x :=
  ⟨ι k ((0, ⟨x, hx⟩) : V × (⋀[k]^(2 : ℕ) V)),
    deningerSullivanFirstLayerDifferential_new ⟨x, hx⟩⟩

variable [Module kᵐᵒᵖ V] [IsCentralScalar k V]

/-- **The classes the resolution must kill are killed by the first layer.**  If an element of the
old algebra dies in the two-term algebra, then its image in the first layer is a coboundary.  This
is the ideal-level statement `deningerMilnorEpsilon_ker` upgraded to the actual differential. -/
theorem deningerSullivanFirstLayer_inl_isCoboundary {z : ExteriorAlgebra k V}
    (hz : deningerMilnorEpsilon k V z = 0) :
    ∃ y, deningerSullivanFirstLayerDifferential k V y =
      deningerSullivanInclusion k V (⋀[k]^(2 : ℕ) V) z := by
  have hmem : z ∈ deningerMilnorIdeal k V := by
    rw [← deningerMilnorEpsilon_ker]
    exact hz
  rw [deningerMilnorIdeal] at hmem
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hmem
  · intro x hx
    exact deningerSullivanFirstLayer_exteriorTwo_isCoboundary hx
  · exact ⟨0, by rw [map_zero, map_zero]⟩
  · rintro p q _ _ ⟨yp, hyp⟩ ⟨yq, hyq⟩
    exact ⟨yp + yq, by rw [map_add, hyp, hyq, map_add]⟩
  · rintro c p _ ⟨y, hy⟩
    refine ⟨deningerSullivanInclusion k V (⋀[k]^(2 : ℕ) V)
      (deningerExteriorInvolute k V c) * y, ?_⟩
    rw [deningerSullivanFirstLayerDifferential_leibniz, hy,
      deningerSullivanFirstLayerDifferential_inl,
      deningerExteriorInvolute_sullivanInclusion, deningerExteriorInvolute_involute,
      zero_mul, add_zero, smul_eq_mul, map_mul]

/-- The new-generator part of an element of the first layer: what remains after subtracting the
image of its augmentation. -/
noncomputable def deningerSullivanNewPart (x : ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V))) :
    ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V)) :=
  x - deningerSullivanInclusion k V (⋀[k]^(2 : ℕ) V)
    (deningerSullivanAugmentation k V (⋀[k]^(2 : ℕ) V) x)

omit [Module kᵐᵒᵖ V] [IsCentralScalar k V] in
theorem deningerSullivanNewPart_augmentation (x : ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V))) :
    deningerSullivanAugmentation k V (⋀[k]^(2 : ℕ) V) (deningerSullivanNewPart x) = 0 := by
  have h := AlgHom.congr_fun
    (deningerSullivanAugmentation_comp_inclusion (k := k) (V := V) (W := (⋀[k]^(2 : ℕ) V)))
    (deningerSullivanAugmentation k V (⋀[k]^(2 : ℕ) V) x)
  rw [AlgHom.comp_apply, AlgHom.id_apply] at h
  rw [deningerSullivanNewPart, map_sub, h, sub_self]

omit [Module kᵐᵒᵖ V] [IsCentralScalar k V] in
/-- The new-generator part lies in the ideal generated by the new generators. -/
theorem deningerSullivanNewPart_mem (x : ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V))) :
    deningerSullivanNewPart x ∈ deningerSullivanNewIdeal k V (⋀[k]^(2 : ℕ) V) := by
  rw [← deningerSullivanAugmentation_ker]
  exact deningerSullivanNewPart_augmentation x

/-- **Reduction of clause 3's injectivity to the new generators.**  A class killed by the
comparison map is a coboundary exactly when its new-generator part is.  Everything coming from the
old algebra has already been killed, so the whole remaining content of the quasi-isomorphism sits
in the ideal generated by the new generators. -/
theorem deningerSullivanFirstLayer_isCoboundary_iff_newPart
    {x : ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V))}
    (hzero : deningerSullivanFirstProjection k V x = 0) :
    (∃ y, deningerSullivanFirstLayerDifferential k V y = x) ↔
      ∃ y, deningerSullivanFirstLayerDifferential k V y = deningerSullivanNewPart x := by
  have hker : deningerMilnorEpsilon k V (deningerSullivanAugmentation k V (⋀[k]^(2 : ℕ) V) x) = 0 :=
    hzero
  obtain ⟨y₀, hy₀⟩ := deningerSullivanFirstLayer_inl_isCoboundary hker
  constructor
  · rintro ⟨y, hy⟩
    refine ⟨y - y₀, ?_⟩
    rw [map_sub, hy, hy₀, deningerSullivanNewPart]
  · rintro ⟨y, hy⟩
    refine ⟨y + y₀, ?_⟩
    rw [map_add, hy, hy₀, deningerSullivanNewPart, sub_add_cancel]

omit [Module kᵐᵒᵖ V] [IsCentralScalar k V] in
/-- The differential of a new generator times an old element is the image of the product. -/
theorem deningerSullivanFirstLayer_newGenerator_mul_inl (w : ⋀[k]^(2 : ℕ) V)
    (z : ExteriorAlgebra k V) :
    deningerSullivanFirstLayerDifferential k V
        (ι k ((0, w) : V × (⋀[k]^(2 : ℕ) V)) * deningerSullivanInclusion k V (⋀[k]^(2 : ℕ) V) z) =
      deningerSullivanInclusion k V (⋀[k]^(2 : ℕ) V) ((w : ExteriorAlgebra k V) * z) := by
  rw [deningerSullivanFirstLayerDifferential_leibniz,
    deningerSullivanFirstLayerDifferential_inl, mul_zero, zero_add,
    deningerSullivanFirstLayerDifferential_new, ← map_mul]

omit [Module kᵐᵒᵖ V] [IsCentralScalar k V] in
/-- **The syzygy cocycles of the first layer.**  A new generator times an element of the old algebra
is closed exactly when the corresponding product already vanishes in the old algebra.  These are the
classes the next stage is attached to kill. -/
theorem deningerSullivanFirstLayer_newGenerator_mul_inl_cocycle_iff (w : ⋀[k]^(2 : ℕ) V)
    (z : ExteriorAlgebra k V) :
    deningerSullivanFirstLayerDifferential k V
        (ι k ((0, w) : V × (⋀[k]^(2 : ℕ) V)) * deningerSullivanInclusion k V (⋀[k]^(2 : ℕ) V) z) = 0 ↔
      (w : ExteriorAlgebra k V) * z = 0 := by
  rw [deningerSullivanFirstLayer_newGenerator_mul_inl]
  constructor
  · intro h
    exact deningerSullivanInclusion_injective (by rw [h, map_zero])
  · intro h
    rw [h, map_zero]

/-- **A class with no new-generator part is a coboundary.**  Combining the reduction with the
killing theorem: if a class killed by the comparison map lies entirely in the old algebra, it is a
coboundary of the first layer. -/
theorem deningerSullivanFirstLayer_isCoboundary_of_newPart_eq_zero
    {x : ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V))}
    (hzero : deningerSullivanFirstProjection k V x = 0)
    (hnew : deningerSullivanNewPart x = 0) :
    ∃ y, deningerSullivanFirstLayerDifferential k V y = x := by
  rw [deningerSullivanFirstLayer_isCoboundary_iff_newPart hzero, hnew]
  exact ⟨0, map_zero _⟩

end FirstLayerKilling

section SecondStageData

open HTGeometry

variable {k V : Type*} [CommRing k] [AddCommGroup V] [Module k V]

variable (k V)

/-- **The syzygy space of the first layer**: the span of the degree-two cocycles obtained by
multiplying a new generator with an old generator whose corresponding product already vanishes.
This is the space of classes the second stage is attached to kill. -/
def deningerSullivanSyzygy : Submodule k (ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V))) :=
  Submodule.span k { x | ∃ (w : ⋀[k]^(2 : ℕ) V) (v : V),
    (w : ExteriorAlgebra k V) * ι k v = 0 ∧
      x = ι k ((0, w) : V × (⋀[k]^(2 : ℕ) V)) * ι k ((v, 0) : V × (⋀[k]^(2 : ℕ) V)) }

variable {k V}

/-- The syzygy space consists of degree-two elements. -/
theorem deningerSullivanSyzygy_le_exteriorTwo :
    deningerSullivanSyzygy k V ≤ ⋀[k]^(2 : ℕ) (V × (⋀[k]^(2 : ℕ) V)) := by
  rw [deningerSullivanSyzygy, Submodule.span_le]
  rintro _ ⟨w, v, -, rfl⟩
  exact deningerExteriorTwo_mem _ _

/-- **The syzygy classes are central**, so they are admissible attaching data for a further odd
derivation. -/
theorem deningerSullivanSyzygy_central {s : ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V))}
    (hs : s ∈ deningerSullivanSyzygy k V) (x : ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V))) :
    Commute s x :=
  deningerExteriorPowerTwo_central (deningerSullivanSyzygy_le_exteriorTwo hs) x

/-- **The syzygy classes are invariant under the grading involution.** -/
theorem deningerSullivanSyzygy_involute {s : ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V))}
    (hs : s ∈ deningerSullivanSyzygy k V) :
    deningerExteriorInvolute k (V × (⋀[k]^(2 : ℕ) V)) s = s :=
  deningerExteriorInvolute_exteriorTwo (deningerSullivanSyzygy_le_exteriorTwo hs)

/-- **The syzygy classes are cocycles**, so attaching generators with these differentials produces
a differential that still squares to zero. -/
theorem deningerSullivanSyzygy_cocycle {s : ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V))}
    (hs : s ∈ deningerSullivanSyzygy k V) :
    deningerSullivanFirstLayerDifferential k V s = 0 := by
  rw [deningerSullivanSyzygy] at hs
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hs
  · rintro _ ⟨w, v, hwv, rfl⟩
    rw [← deningerSullivanInclusion_ι (W := (⋀[k]^(2 : ℕ) V)) v,
      deningerSullivanFirstLayer_newGenerator_mul_inl, hwv, map_zero]
  · exact map_zero _
  · intro p q _ _ hp hq
    rw [map_add, hp, hq, add_zero]
  · intro c p _ hp
    rw [map_smul, hp, smul_zero]

/-- The attaching map of the second stage: the inclusion of the syzygy space. -/
def deningerSullivanSecondPsi :
    (deningerSullivanSyzygy k V) →ₗ[k] ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V)) :=
  (deningerSullivanSyzygy k V).subtype

@[simp]
theorem deningerSullivanSecondPsi_apply (s : deningerSullivanSyzygy k V) :
    deningerSullivanSecondPsi s = (s : ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V))) :=
  rfl

/-- **The second stage's attaching data is admissible.**  Its values are central, involution
invariant, and killed by the first-layer differential — exactly the three conditions the successor
construction requires. -/
theorem deningerSullivanSecondPsi_admissible :
    (∀ (s : deningerSullivanSyzygy k V) (x : ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V))),
        Commute (deningerSullivanSecondPsi s) x) ∧
      (∀ s : deningerSullivanSyzygy k V,
        deningerExteriorInvolute k (V × (⋀[k]^(2 : ℕ) V)) (deningerSullivanSecondPsi s) =
          deningerSullivanSecondPsi s) ∧
      ∀ s : deningerSullivanSyzygy k V,
        deningerSullivanFirstLayerDifferential k V (deningerSullivanSecondPsi s) = 0 :=
  ⟨fun s => deningerSullivanSyzygy_central s.2,
    fun s => deningerSullivanSyzygy_involute s.2,
    fun s => deningerSullivanSyzygy_cocycle s.2⟩

end SecondStageData

section SecondLayer

open HTGeometry

variable {k V : Type*} [CommRing k] [AddCommGroup V] [Module k V]

/-- The two constructions of the inclusion of the old algebra agree. -/
theorem deningerExteriorInl_eq_sullivanInclusion {U N : Type*} [AddCommGroup U] [Module k U]
    [AddCommGroup N] [Module k N] :
    (deningerExteriorInl : ExteriorAlgebra k U →ₐ[k] ExteriorAlgebra k (U × N)) =
      deningerSullivanInclusion k U N := by
  ext u
  simp

/-- The inclusion of the old algebra preserves the degree-two part. -/
theorem deningerExteriorInl_exteriorTwo {U N : Type*} [AddCommGroup U] [Module k U]
    [AddCommGroup N] [Module k N] {x : ExteriorAlgebra k U} (hx : x ∈ ⋀[k]^(2 : ℕ) U) :
    (deningerExteriorInl : ExteriorAlgebra k U →ₐ[k] ExteriorAlgebra k (U × N)) x ∈
      ⋀[k]^(2 : ℕ) (U × N) := by
  rw [deningerExteriorInl_eq_sullivanInclusion]
  exact deningerSullivanInclusion_exteriorTwo _ hx

variable (k V)

/-- The generator assignment of the second stage. -/
noncomputable def deningerSullivanSecondPhi :
    ((V × (⋀[k]^(2 : ℕ) V)) × (deningerSullivanSyzygy k V)) →ₗ[k]
      ExteriorAlgebra k ((V × (⋀[k]^(2 : ℕ) V)) × (deningerSullivanSyzygy k V)) :=
  deningerSuccessorPhi (deningerSullivanFirstPhi k V) deningerSullivanSecondPsi

variable {k V}

set_option maxHeartbeats 4000000 in
/-- Every second-stage generator value is a degree-two element. -/
theorem deningerSullivanSecondPhi_mem
    (p : (V × (⋀[k]^(2 : ℕ) V)) × (deningerSullivanSyzygy k V)) :
    deningerSullivanSecondPhi k V p ∈ ⋀[k]^(2 : ℕ) ((V × (⋀[k]^(2 : ℕ) V)) × (deningerSullivanSyzygy k V)) := by
  have h : deningerSullivanSecondPhi k V p =
      deningerExteriorInl (deningerSullivanFirstPhi k V p.1) +
        deningerExteriorInl (deningerSullivanSecondPsi p.2) := rfl
  rw [h]
  exact Submodule.add_mem _
    (deningerExteriorInl_exteriorTwo (deningerSullivanFirstPhi_mem p.1))
    (deningerExteriorInl_exteriorTwo (deningerSullivanSyzygy_le_exteriorTwo p.2.2))

theorem deningerSullivanSecondPhi_commute
    (p : (V × (⋀[k]^(2 : ℕ) V)) × (deningerSullivanSyzygy k V))
    (x : ExteriorAlgebra k ((V × (⋀[k]^(2 : ℕ) V)) × (deningerSullivanSyzygy k V))) :
    Commute (deningerSullivanSecondPhi k V p) x :=
  deningerExteriorPowerTwo_central (deningerSullivanSecondPhi_mem p) x

theorem deningerSullivanSecondPhi_involute
    (p : (V × (⋀[k]^(2 : ℕ) V)) × (deningerSullivanSyzygy k V)) :
    deningerExteriorInvolute k ((V × (⋀[k]^(2 : ℕ) V)) × (deningerSullivanSyzygy k V))
        (deningerSullivanSecondPhi k V p) = deningerSullivanSecondPhi k V p :=
  deningerExteriorInvolute_exteriorTwo (deningerSullivanSecondPhi_mem p)

variable (k V)

/-- **The differential of the second relative Sullivan layer.** -/
noncomputable def deningerSullivanSecondLayerDifferential :
    ExteriorAlgebra k ((V × (⋀[k]^(2 : ℕ) V)) × (deningerSullivanSyzygy k V)) →ₗ[k]
      ExteriorAlgebra k ((V × (⋀[k]^(2 : ℕ) V)) × (deningerSullivanSyzygy k V)) :=
  deningerOddDerivation (deningerSullivanSecondPhi k V) deningerSullivanSecondPhi_commute

variable {k V}

/-- **The second layer extends the first.**  On the image of the first layer the second-stage
differential is the first-stage differential. -/
theorem deningerSullivanSecondLayerDifferential_inl
    (x : ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V))) :
    deningerSullivanSecondLayerDifferential k V (deningerExteriorInl x) =
      deningerExteriorInl (deningerSullivanFirstLayerDifferential k V x) :=
  deningerSuccessorDerivation_inl (deningerSullivanFirstPhi k V)
    deningerSullivanSecondPsi deningerSullivanFirstPhi_commute
    deningerSullivanSecondPhi_commute x

/-- **Every syzygy class becomes a coboundary at the second stage.**  This is step 2 performed on
the card's own first layer. -/
theorem deningerSullivanSecondLayerDifferential_new (s : deningerSullivanSyzygy k V) :
    deningerSullivanSecondLayerDifferential k V
        (ι k ((0, s) : (V × (⋀[k]^(2 : ℕ) V)) × (deningerSullivanSyzygy k V))) =
      deningerExteriorInl (s : ExteriorAlgebra k (V × (⋀[k]^(2 : ℕ) V))) :=
  deningerSuccessorDerivation_new (deningerSullivanFirstPhi k V)
    deningerSullivanSecondPsi deningerSullivanSecondPhi_commute s

set_option maxHeartbeats 1000000 in
/-- **The second-layer differential squares to zero**, so the second stage is again a differential
graded algebra. -/
theorem deningerSullivanSecondLayerDifferential_comp_self
    (x : ExteriorAlgebra k ((V × (⋀[k]^(2 : ℕ) V)) × (deningerSullivanSyzygy k V))) :
    deningerSullivanSecondLayerDifferential k V
      (deningerSullivanSecondLayerDifferential k V x) = 0 :=
  deningerSuccessorDerivation_comp_self (deningerSullivanFirstPhi k V)
    deningerSullivanSecondPsi deningerSullivanFirstPhi_commute
    deningerSullivanSecondPhi_commute deningerSullivanFirstPhi_involute
    (fun s => deningerSullivanSyzygy_involute s.2)
    (fun u => deningerSullivanFirstLayerDifferential_kill u.2.2)
    (fun s => deningerSullivanSyzygy_cocycle s.2) x

end SecondLayer

section GeneralStage

open HTGeometry

variable {k U : Type*} [CommRing k] [AddCommGroup U] [Module k U]
variable (phi : U →ₗ[k] ExteriorAlgebra k U)

/-- Generator values lying in the degree-two part are central. -/
theorem deningerStagePhi_central (hmem : ∀ u, phi u ∈ ⋀[k]^(2 : ℕ) U)
    (u : U) (x : ExteriorAlgebra k U) : Commute (phi u) x :=
  deningerExteriorPowerTwo_central (hmem u) x

/-- Generator values lying in the degree-two part are invariant under the grading involution. -/
theorem deningerStagePhi_involute (hmem : ∀ u, phi u ∈ ⋀[k]^(2 : ℕ) U) (u : U) :
    deningerExteriorInvolute k U (phi u) = phi u :=
  deningerExteriorInvolute_exteriorTwo (hmem u)

/-- **The degree-two cocycles of a Sullivan stage**: the degree-two elements killed by the stage's
differential.  These are exactly the classes the next stage is attached to kill, and they are
automatically admissible attaching data. -/
noncomputable def deningerStageDegreeTwoCocycles (hmem : ∀ u, phi u ∈ ⋀[k]^(2 : ℕ) U) :
    Submodule k (ExteriorAlgebra k U) :=
  (⋀[k]^(2 : ℕ) U) ⊓ LinearMap.ker (deningerOddDerivation phi (deningerStagePhi_central phi hmem))

theorem deningerStageDegreeTwoCocycles_le (hmem : ∀ u, phi u ∈ ⋀[k]^(2 : ℕ) U) :
    deningerStageDegreeTwoCocycles phi hmem ≤ ⋀[k]^(2 : ℕ) U :=
  inf_le_left

theorem deningerStageDegreeTwoCocycles_cocycle (hmem : ∀ u, phi u ∈ ⋀[k]^(2 : ℕ) U)
    (s : deningerStageDegreeTwoCocycles phi hmem) :
    deningerOddDerivation phi (deningerStagePhi_central phi hmem)
      (s : ExteriorAlgebra k U) = 0 :=
  s.2.2

/-- **The generator assignment of the successor stage**: the old assignment together with one new
generator for every degree-two cocycle. -/
noncomputable def deningerStageSuccessorPhi (hmem : ∀ u, phi u ∈ ⋀[k]^(2 : ℕ) U) :
    (U × (deningerStageDegreeTwoCocycles phi hmem)) →ₗ[k]
      ExteriorAlgebra k (U × (deningerStageDegreeTwoCocycles phi hmem)) :=
  deningerSuccessorPhi phi (deningerStageDegreeTwoCocycles phi hmem).subtype

/-- **The successor stage preserves the degree-two invariant**, so the construction iterates. -/
theorem deningerStageSuccessorPhi_mem (hmem : ∀ u, phi u ∈ ⋀[k]^(2 : ℕ) U)
    (p : U × (deningerStageDegreeTwoCocycles phi hmem)) :
    deningerStageSuccessorPhi phi hmem p ∈
      ⋀[k]^(2 : ℕ) (U × (deningerStageDegreeTwoCocycles phi hmem)) := by
  have h : deningerStageSuccessorPhi phi hmem p =
      deningerExteriorInl (phi p.1) +
        deningerExteriorInl ((p.2 : ExteriorAlgebra k U)) := rfl
  rw [h]
  exact Submodule.add_mem _ (deningerExteriorInl_exteriorTwo (hmem p.1))
    (deningerExteriorInl_exteriorTwo (deningerStageDegreeTwoCocycles_le phi hmem p.2.2))

/-- The successor differential restricts to the old one on the image of the old algebra. -/
theorem deningerStageSuccessorPhi_inl (hmem : ∀ u, phi u ∈ ⋀[k]^(2 : ℕ) U)
    (x : ExteriorAlgebra k U) :
    deningerOddDerivation (deningerStageSuccessorPhi phi hmem)
        (deningerStagePhi_central _ (deningerStageSuccessorPhi_mem phi hmem))
        (deningerExteriorInl x) =
      deningerExteriorInl
        (deningerOddDerivation phi (deningerStagePhi_central phi hmem) x) :=
  deningerSuccessorDerivation_inl phi (deningerStageDegreeTwoCocycles phi hmem).subtype
    (deningerStagePhi_central phi hmem)
    (deningerStagePhi_central _ (deningerStageSuccessorPhi_mem phi hmem)) x

/-- **The successor differential kills its own generator values**, which is the condition making it
square to zero.  Together with the preceding theorem this shows the successor of a Sullivan stage is
again a Sullivan stage. -/
theorem deningerStageSuccessorPhi_kill (hmem : ∀ u, phi u ∈ ⋀[k]^(2 : ℕ) U)
    (p : U × (deningerStageDegreeTwoCocycles phi hmem))
    (hkill : ∀ u, deningerOddDerivation phi (deningerStagePhi_central phi hmem) (phi u) = 0) :
    deningerOddDerivation (deningerStageSuccessorPhi phi hmem)
        (deningerStagePhi_central _ (deningerStageSuccessorPhi_mem phi hmem))
        (deningerStageSuccessorPhi phi hmem p) = 0 := by
  have h : deningerStageSuccessorPhi phi hmem p =
      deningerExteriorInl (phi p.1) +
        deningerExteriorInl ((p.2 : ExteriorAlgebra k U)) := rfl
  rw [h, map_add, deningerStageSuccessorPhi_inl, deningerStageSuccessorPhi_inl,
    hkill, deningerStageDegreeTwoCocycles_cocycle]
  simp

/-- **Every degree-two cocycle of a stage becomes a coboundary at its successor.** -/
theorem deningerStageSuccessor_kills (hmem : ∀ u, phi u ∈ ⋀[k]^(2 : ℕ) U)
    (s : deningerStageDegreeTwoCocycles phi hmem) :
    deningerOddDerivation (deningerStageSuccessorPhi phi hmem)
        (deningerStagePhi_central _ (deningerStageSuccessorPhi_mem phi hmem))
        (ι k ((0, s) : U × (deningerStageDegreeTwoCocycles phi hmem))) =
      deningerExteriorInl ((s : ExteriorAlgebra k U)) :=
  deningerSuccessorDerivation_new phi (deningerStageDegreeTwoCocycles phi hmem).subtype
    (deningerStagePhi_central _ (deningerStageSuccessorPhi_mem phi hmem)) s

end GeneralStage

section StageTower

open HTGeometry

/-- **A Sullivan stage**: a space of degree-one generators together with a generator assignment
whose values are degree two and are killed by the resulting differential.  Degree-two values are
automatically central and involution-invariant, so this single condition describes a stage. -/
structure DeningerSullivanStage (k : Type*) [CommRing k] where
  /-- The generator space of the stage. -/
  space : Type*
  [addCommGroup : AddCommGroup space]
  [module : Module k space]
  /-- The values of the differential on the generators. -/
  phi : space →ₗ[k] ExteriorAlgebra k space
  /-- The generator values are degree two. -/
  phi_mem : ∀ u, phi u ∈ ⋀[k]^(2 : ℕ) space
  /-- The differential kills its own generator values, hence squares to zero. -/
  kill : ∀ u, deningerOddDerivation phi (deningerStagePhi_central phi phi_mem) (phi u) = 0

attribute [instance] DeningerSullivanStage.addCommGroup DeningerSullivanStage.module

namespace DeningerSullivanStage

variable {k : Type*} [CommRing k]

/-- The differential of a stage. -/
noncomputable def d (S : DeningerSullivanStage k) :
    ExteriorAlgebra k S.space →ₗ[k] ExteriorAlgebra k S.space :=
  deningerOddDerivation S.phi (deningerStagePhi_central S.phi S.phi_mem)

theorem d_comp_self (S : DeningerSullivanStage k) (x : ExteriorAlgebra k S.space) :
    S.d (S.d x) = 0 :=
  deningerOddDerivation_comp_self _ _ (deningerStagePhi_involute S.phi S.phi_mem) S.kill x

/-- The degree-two cocycles of a stage. -/
noncomputable def cocycles (S : DeningerSullivanStage k) :
    Submodule k (ExteriorAlgebra k S.space) :=
  deningerStageDegreeTwoCocycles S.phi S.phi_mem

/-- **The successor of a stage**, obtained by attaching one new generator for every degree-two
cocycle. -/
noncomputable def succ (S : DeningerSullivanStage k) : DeningerSullivanStage k where
  space := S.space × (deningerStageDegreeTwoCocycles S.phi S.phi_mem)
  phi := deningerStageSuccessorPhi S.phi S.phi_mem
  phi_mem := deningerStageSuccessorPhi_mem S.phi S.phi_mem
  kill := fun p => deningerStageSuccessorPhi_kill S.phi S.phi_mem p S.kill

@[simp]
theorem succ_space (S : DeningerSullivanStage k) :
    S.succ.space = (S.space × (deningerStageDegreeTwoCocycles S.phi S.phi_mem)) := rfl

@[simp]
theorem succ_phi (S : DeningerSullivanStage k) :
    S.succ.phi = deningerStageSuccessorPhi S.phi S.phi_mem := rfl

/-- **The successor differential extends the stage differential.** -/
theorem succ_d_inl (S : DeningerSullivanStage k) (x : ExteriorAlgebra k S.space) :
    S.succ.d
        ((deningerExteriorInl :
          ExteriorAlgebra k S.space →ₐ[k]
            ExteriorAlgebra k (S.space × (deningerStageDegreeTwoCocycles S.phi S.phi_mem))) x) =
      (deningerExteriorInl :
        ExteriorAlgebra k S.space →ₐ[k]
          ExteriorAlgebra k (S.space × (deningerStageDegreeTwoCocycles S.phi S.phi_mem)))
        (S.d x) :=
  deningerStageSuccessorPhi_inl S.phi S.phi_mem x

/-- **Every degree-two cocycle of a stage is a coboundary at its successor.** -/
theorem succ_kills (S : DeningerSullivanStage k)
    (s : deningerStageDegreeTwoCocycles S.phi S.phi_mem) :
    S.succ.d
        (ι k ((0, s) : S.space × (deningerStageDegreeTwoCocycles S.phi S.phi_mem))) =
      (deningerExteriorInl :
        ExteriorAlgebra k S.space →ₐ[k]
          ExteriorAlgebra k (S.space × (deningerStageDegreeTwoCocycles S.phi S.phi_mem)))
        ((s : ExteriorAlgebra k S.space)) :=
  deningerStageSuccessor_kills S.phi S.phi_mem s

/-- **The base stage**: a space of generators with vanishing differential, which is the algebra
`P = Λ(V)` with `d_P = 0` of the statement. -/
def base (k V : Type*) [CommRing k] [AddCommGroup V] [Module k V] :
    DeningerSullivanStage k where
  space := V
  phi := 0
  phi_mem := fun _ => Submodule.zero_mem _
  kill := fun _ => by
    show deningerOddDerivation (0 : V →ₗ[k] ExteriorAlgebra k V) _ 0 = 0
    exact map_zero _

/-- **The stage tower**: iterating the successor construction from a given stage. -/
noncomputable def iterate (S : DeningerSullivanStage k) : ℕ → DeningerSullivanStage k
  | 0 => S
  | n + 1 => (S.iterate n).succ

@[simp]
theorem iterate_zero (S : DeningerSullivanStage k) : S.iterate 0 = S := rfl

@[simp]
theorem iterate_succ (S : DeningerSullivanStage k) (n : ℕ) :
    S.iterate (n + 1) = (S.iterate n).succ := rfl

/-- **Every degree-two cocycle appearing at a stage of the tower dies at the next stage.**  This is
the induction of the proof, carried out along the natural numbers. -/
theorem iterate_kills (S : DeningerSullivanStage k) (n : ℕ)
    (s : deningerStageDegreeTwoCocycles (S.iterate n).phi (S.iterate n).phi_mem) :
    (S.iterate (n + 1)).d
        (ι k ((0, s) : (S.iterate n).space ×
          (deningerStageDegreeTwoCocycles (S.iterate n).phi (S.iterate n).phi_mem))) =
      deningerExteriorInl ((s : ExteriorAlgebra k (S.iterate n).space)) :=
  (S.iterate n).succ_kills s

end DeningerSullivanStage

end StageTower

end RHTower

