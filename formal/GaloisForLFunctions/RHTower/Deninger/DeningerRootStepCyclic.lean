import GaloisForLFunctions.RHTower.Deninger.DeningerColimitHomology

/-!
# A root adjunction to a cyclic group is cyclic

If the group is generated by the element whose root is adjoined, then the amalgam is generated by
the adjoined root: the cyclic factor is its powers, and the group factor consists of powers of the
element, which is the `m`-th power of the root.  Every element of the amalgam is a product of
letters, so the whole amalgam is the powers of the root.

* `deningerRootStep_cyclic` : the amalgam is cyclic.
-/

namespace RHTower

open Monoid Monoid.PushoutI

universe u

namespace RootAdjunction

variable (A : Type u) [Group A] (a : A) (m : ℤ)

/-- Letters of either factor are powers of the adjoined root. -/
theorem deningerRootLetter_mem (hgen : ∀ x : A, x ∈ Subgroup.zpowers a)
    (p : Σ i, deningerRootFactor A i) :
    PushoutI.of (φ := deningerRootMap A a m) p.1 p.2 ∈
      Subgroup.zpowers (deningerRootElt A a m) := by
  obtain ⟨i, x⟩ := p
  obtain ⟨b⟩ := i
  cases b
  · exact deningerOfFalse_mem_zpowers A a m x
  · obtain ⟨c, hc⟩ := hgen x
    refine ⟨m * c, ?_⟩
    show (deningerRootElt A a m) ^ (m * c) = _
    rw [zpow_mul, deningerRootElt_zpow, ← map_zpow]
    exact congrArg (PushoutI.of (φ := deningerRootMap A a m) (ULift.up true)) hc

/-- **A root adjunction to a cyclic group is cyclic.** -/
theorem deningerRootStep_cyclic (hm : m ≠ 0)
    (ha : ∀ n : ℤ, a ^ n = 1 → n = 0) (hgen : ∀ x : A, x ∈ Subgroup.zpowers a)
    (g : PushoutI (deningerRootMap A a m)) :
    g ∈ Subgroup.zpowers (deningerRootElt A a m) := by
  classical
  obtain ⟨d⟩ := PushoutI.NormalWord.transversal_nonempty (deningerRootMap A a m)
    (deningerRootMap_injective A a m hm ha)
  rcases deningerExists_letterProd (d := d) g with ⟨h₀, hg, -⟩ | ⟨L, -, -, -, -, hg⟩
  · rw [hg, ← PushoutI.of_apply_eq_base (deningerRootMap A a m) (ULift.up false) h₀]
    exact deningerRootLetter_mem A a m hgen ⟨ULift.up false, _⟩
  · subst hg
    induction L with
    | nil =>
      rw [deningerLetterProd_nil]
      exact Subgroup.one_mem _
    | cons p L' ih =>
      rw [deningerLetterProd_cons]
      exact Subgroup.mul_mem _ (deningerRootLetter_mem A a m hgen p) ih

end RootAdjunction

end RHTower
