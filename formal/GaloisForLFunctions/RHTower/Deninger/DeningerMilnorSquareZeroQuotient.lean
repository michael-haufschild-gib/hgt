import Mathlib.LinearAlgebra.ExteriorAlgebra.Basic
import Mathlib.Algebra.TrivSqZeroExt.Basic
import Mathlib.Algebra.RingQuot

/-!
# The square-zero quotient of an exterior algebra

Killing all products of two vectors in an exterior algebra leaves exactly the square-zero extension
of the underlying space: the quotient map and the obvious section are mutually inverse algebra
maps, because the exterior algebra is generated by its vectors.

Cutting the relations down to a subspace gives an increasing family of relations whose union, over
the finitely generated subspaces, is the full relation.  Every relation of the total quotient
therefore already holds at a finite stage, which is the filtered-colimit statement.

* `DeningerExtSquareRel` : the relation of a subspace.
* `deningerExtSquareQuotEquiv` : the total quotient is `k ⊕ V` with `V² = 0`.
* `deningerExtSquareRel_mono`, `deningerExtSquareRel_finite` : the finite stages.
* `deningerRingQuotRel_finite` : every relation of the total quotient holds at a finite stage.
-/

namespace RHTower

open ExteriorAlgebra

section SquareZeroQuotient

variable (k V : Type*) [Field k] [AddCommGroup V] [Module k V]

/-- The square-zero relation of a subspace: the product of two of its vectors is killed. -/
inductive DeningerExtSquareRel (U : Submodule k V) :
    ExteriorAlgebra k V → ExteriorAlgebra k V → Prop
  | mul {x y : V} (hx : x ∈ U) (hy : y ∈ U) :
      DeningerExtSquareRel U (ι k x * ι k y) 0

/-- The square-zero quotient at a given stage. -/
abbrev DeningerExtSquareQuot (U : Submodule k V) := RingQuot (DeningerExtSquareRel k V U)

theorem deningerExtSquareRel_mono {U U' : Submodule k V} (h : U ≤ U')
    {a b : ExteriorAlgebra k V} (hab : DeningerExtSquareRel k V U a b) :
    DeningerExtSquareRel k V U' a b := by
  cases hab with
  | mul hx hy => exact DeningerExtSquareRel.mul (h hx) (h hy)

/-- **Every relation involves only finitely many vectors**, so it already holds at a finitely
generated stage. -/
theorem deningerExtSquareRel_finite {a b : ExteriorAlgebra k V}
    (hab : DeningerExtSquareRel k V ⊤ a b) :
    ∃ U : Submodule k V, U.FG ∧ DeningerExtSquareRel k V U a b := by
  cases hab with
  | @mul x y _ _ =>
    refine ⟨Submodule.span k {x, y}, Submodule.fg_span (Set.toFinite _), ?_⟩
    exact DeningerExtSquareRel.mul (Submodule.subset_span (by simp))
      (Submodule.subset_span (by simp))

variable [Module kᵐᵒᵖ V] [IsCentralScalar k V]

/-- The square-zero comparison map on the exterior algebra. -/
noncomputable def deningerExtToSquareZero : ExteriorAlgebra k V →ₐ[k] TrivSqZeroExt k V :=
  ExteriorAlgebra.lift k ⟨TrivSqZeroExt.inrHom k V, fun m => by
    simp [TrivSqZeroExt.inrHom]⟩

@[simp] theorem deningerExtToSquareZero_ι (v : V) :
    deningerExtToSquareZero k V (ι k v) = TrivSqZeroExt.inr v := by
  rw [deningerExtToSquareZero, ExteriorAlgebra.lift_ι_apply]
  rfl

/-- The comparison map kills the square-zero relation. -/
theorem deningerExtToSquareZero_rel {a b : ExteriorAlgebra k V}
    (hab : DeningerExtSquareRel k V ⊤ a b) :
    deningerExtToSquareZero k V a = deningerExtToSquareZero k V b := by
  cases hab with
  | @mul x y _ _ =>
    rw [map_mul, deningerExtToSquareZero_ι, deningerExtToSquareZero_ι, map_zero]
    exact TrivSqZeroExt.inr_mul_inr k x y

/-- The comparison map on the total square-zero quotient. -/
noncomputable def deningerExtSquareQuotHom :
    DeningerExtSquareQuot k V ⊤ →ₐ[k] TrivSqZeroExt k V :=
  RingQuot.liftAlgHom k ⟨deningerExtToSquareZero k V, fun _ _ h =>
    deningerExtToSquareZero_rel k V h⟩

/-- The section of the quotient map. -/
noncomputable def deningerSquareZeroToExtQuot :
    TrivSqZeroExt k V →ₐ[k] DeningerExtSquareQuot k V ⊤ :=
  TrivSqZeroExt.lift (Algebra.ofId k (DeningerExtSquareQuot k V ⊤))
    ((RingQuot.mkAlgHom k (DeningerExtSquareRel k V ⊤)).toLinearMap.comp (ι k))
    (fun x y => by
      show RingQuot.mkAlgHom k _ (ι k x) * RingQuot.mkAlgHom k _ (ι k y) = 0
      rw [← map_mul]
      have h : RingQuot.mkAlgHom k (DeningerExtSquareRel k V ⊤) (ι k x * ι k y)
          = RingQuot.mkAlgHom k (DeningerExtSquareRel k V ⊤) 0 :=
        RingQuot.mkAlgHom_rel k
          (DeningerExtSquareRel.mul (Submodule.mem_top) (Submodule.mem_top))
      rw [h, map_zero])
    (fun r x => by
      show RingQuot.mkAlgHom k _ (ι k (r • x))
        = Algebra.ofId k (DeningerExtSquareQuot k V ⊤) r * RingQuot.mkAlgHom k _ (ι k x)
      rw [map_smul, map_smul, Algebra.ofId_apply, Algebra.smul_def])
    (fun r x => by
      show RingQuot.mkAlgHom k _ (ι k (MulOpposite.op r • x))
        = RingQuot.mkAlgHom k _ (ι k x) * Algebra.ofId k (DeningerExtSquareQuot k V ⊤) r
      rw [op_smul_eq_smul, map_smul, map_smul, Algebra.ofId_apply, Algebra.smul_def,
        Algebra.commutes])

@[simp] theorem deningerSquareZeroToExtQuot_inr (v : V) :
    deningerSquareZeroToExtQuot k V (TrivSqZeroExt.inr v)
      = RingQuot.mkAlgHom k (DeningerExtSquareRel k V ⊤) (ι k v) := by
  rw [deningerSquareZeroToExtQuot, TrivSqZeroExt.lift_apply_inr]
  rfl

@[simp] theorem deningerExtSquareQuotHom_mk (z : ExteriorAlgebra k V) :
    deningerExtSquareQuotHom k V (RingQuot.mkAlgHom k (DeningerExtSquareRel k V ⊤) z)
      = deningerExtToSquareZero k V z := by
  rw [deningerExtSquareQuotHom]
  exact RingQuot.liftAlgHom_mkAlgHom_apply k _ _ z

/-- **The square-zero quotient.**  Killing all products of two vectors in the exterior algebra
leaves exactly the square-zero extension of the underlying space. -/
noncomputable def deningerExtSquareQuotEquiv :
    DeningerExtSquareQuot k V ⊤ ≃ₐ[k] TrivSqZeroExt k V :=
  AlgEquiv.ofAlgHom (deningerExtSquareQuotHom k V) (deningerSquareZeroToExtQuot k V)
    (by
      refine TrivSqZeroExt.algHom_ext fun m => ?_
      rw [AlgHom.comp_apply, deningerSquareZeroToExtQuot_inr, deningerExtSquareQuotHom_mk,
        deningerExtToSquareZero_ι, AlgHom.coe_id, id_eq])
    (by
      refine RingQuot.ringQuot_ext' k _ _ ?_
      refine ExteriorAlgebra.hom_ext ?_
      refine LinearMap.ext fun v => ?_
      show deningerSquareZeroToExtQuot k V
          (deningerExtSquareQuotHom k V
            (RingQuot.mkAlgHom k (DeningerExtSquareRel k V ⊤) (ι k v)))
        = RingQuot.mkAlgHom k (DeningerExtSquareRel k V ⊤) (ι k v)
      rw [deningerExtSquareQuotHom_mk, deningerExtToSquareZero_ι,
        deningerSquareZeroToExtQuot_inr])

end SquareZeroQuotient

section BaseChange

variable (k V : Type*) [Field k] [AddCommGroup V] [Module k V] (U : Submodule k V)

/-- **The finite-stage quotient is the base change.**  It has the universal property of the
pushout of `K_U ← Λ(U) → Λ(V)`: an algebra map out of it is exactly an algebra map out of `Λ(V)`
killing the products of two vectors of `U`, which is what factoring through `K_U` over `Λ(U)`
means. -/
theorem deningerExtSquareQuot_universal {B : Type*} [Semiring B] [Algebra k B]
    (f : ExteriorAlgebra k V →ₐ[k] B)
    (hf : ∀ x ∈ U, ∀ y ∈ U, f (ι k x * ι k y) = 0) :
    ∃! F : DeningerExtSquareQuot k V U →ₐ[k] B,
      F.comp (RingQuot.mkAlgHom k (DeningerExtSquareRel k V U)) = f := by
  have hrel : ∀ ⦃a b : ExteriorAlgebra k V⦄, DeningerExtSquareRel k V U a b → f a = f b := by
    intro a b hab
    cases hab with
    | @mul x y hx hy =>
      rw [map_zero]
      exact hf x hx y hy
  refine ⟨RingQuot.liftAlgHom k ⟨f, hrel⟩, ?_, ?_⟩
  · refine AlgHom.ext fun z => ?_
    exact RingQuot.liftAlgHom_mkAlgHom_apply k f hrel z
  · intro F hF
    exact RingQuot.liftAlgHom_unique k f hrel F hF

/-- The transition map between two stages. -/
noncomputable def deningerExtSquareStageMap {U U' : Submodule k V} (h : U ≤ U') :
    DeningerExtSquareQuot k V U →ₐ[k] DeningerExtSquareQuot k V U' :=
  RingQuot.liftAlgHom k ⟨RingQuot.mkAlgHom k (DeningerExtSquareRel k V U'), fun _ _ hab =>
    RingQuot.mkAlgHom_rel k (deningerExtSquareRel_mono k V h hab)⟩

theorem deningerExtSquareStageMap_mk {U U' : Submodule k V} (h : U ≤ U')
    (z : ExteriorAlgebra k V) :
    deningerExtSquareStageMap k V h (RingQuot.mkAlgHom k (DeningerExtSquareRel k V U) z)
      = RingQuot.mkAlgHom k (DeningerExtSquareRel k V U') z := by
  rw [deningerExtSquareStageMap]
  exact RingQuot.liftAlgHom_mkAlgHom_apply k _ _ z

/-- **Every element of the total quotient comes from a finite stage.** -/
theorem deningerExtSquareQuot_surjective (z : DeningerExtSquareQuot k V ⊤) :
    ∃ w : ExteriorAlgebra k V,
      RingQuot.mkAlgHom k (DeningerExtSquareRel k V ⊤) w = z :=
  RingQuot.mkAlgHom_surjective k _ z

end BaseChange

section Colimit

variable (k V : Type*) [Field k] [AddCommGroup V] [Module k V]

/-- **Every relation of the total quotient already holds at a finitely generated stage.**  This is
the filtered-colimit statement: the total square-zero quotient is the colimit of the finite-stage
quotients. -/
theorem deningerRingQuotRel_finite :
    ∀ {a b : ExteriorAlgebra k V}, RingQuot.Rel (DeningerExtSquareRel k V ⊤) a b →
      ∃ U : Submodule k V, U.FG ∧ RingQuot.Rel (DeningerExtSquareRel k V U) a b := by
  intro a b hab
  induction hab with
  | of h =>
    obtain ⟨U, hU, hrel⟩ := deningerExtSquareRel_finite k V h
    exact ⟨U, hU, RingQuot.Rel.of hrel⟩
  | add_left _ ih =>
    obtain ⟨U, hU, hrel⟩ := ih
    exact ⟨U, hU, RingQuot.Rel.add_left hrel⟩
  | mul_left _ ih =>
    obtain ⟨U, hU, hrel⟩ := ih
    exact ⟨U, hU, RingQuot.Rel.mul_left hrel⟩
  | mul_right _ ih =>
    obtain ⟨U, hU, hrel⟩ := ih
    exact ⟨U, hU, RingQuot.Rel.mul_right hrel⟩

end Colimit

end RHTower
