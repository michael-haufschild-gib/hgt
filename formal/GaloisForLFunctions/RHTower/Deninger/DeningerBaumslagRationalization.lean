import GaloisForLFunctions.RHTower.Deninger.DeningerUniquelyDivisibleKernel
import Mathlib.GroupTheory.FreeGroup.Basic
import Mathlib.LinearAlgebra.Span.Basic
import Mathlib.Data.Rat.Cast.Order

/-!
# Baumslag rationalization

A group has unique roots when every element has exactly one `n`-th root for every `n ≥ 1`.  Such
groups are the models of an equational theory: adjoin to the group signature a unary operation
`root n` for every `n`, subject to `(root n x)^{n+1} = x` and `root n (x^{n+1}) = x`.  Uniqueness of
roots is then a consequence, not an axiom, so the theory is a variety and the forgetful functor to
groups has a left adjoint.  That adjoint is the Baumslag rationalization, and it is built here as
the term algebra on the group modulo the congruence generated by the group axioms, the
homomorphism axioms for the unit, and the two root axioms.

* `DeningerDTerm` : the terms.
* `DeningerBau` : the rationalization, a group with unique roots.
* `deningerBauOf` : the unit `G → Bau G`.
* `deningerBauLift`, `deningerBauLift_comp`, `deningerBauLift_unique` : the universal property.
-/

namespace RHTower

universe u v w

section RootChoice

variable {H : Type v} [Group H]

/-- The `n+1`-st root supplied by unique divisibility. -/
noncomputable def deningerRoot (hH : DeningerUniquelyDivisible H) (n : ℕ) (x : H) : H :=
  (hH (n + 1) n.succ_pos x).choose

@[simp]
theorem deningerRoot_pow (hH : DeningerUniquelyDivisible H) (n : ℕ) (x : H) :
    deningerRoot hH n x ^ (n + 1) = x :=
  (hH (n + 1) n.succ_pos x).choose_spec.1

theorem deningerRoot_unique (hH : DeningerUniquelyDivisible H) (n : ℕ) {x y : H}
    (h : y ^ (n + 1) = x) : y = deningerRoot hH n x :=
  ((hH (n + 1) n.succ_pos x).choose_spec.2 y h).trans
    (((hH (n + 1) n.succ_pos x).choose_spec.2 _ (deningerRoot_pow hH n x)).symm ▸ rfl)

@[simp]
theorem deningerPow_root (hH : DeningerUniquelyDivisible H) (n : ℕ) (x : H) :
    deningerRoot hH n (x ^ (n + 1)) = x :=
  (deningerRoot_unique hH n rfl).symm

/-- **A homomorphism between groups with unique roots preserves roots.** -/
theorem deningerMap_root {K : Type w} [Group K] (hH : DeningerUniquelyDivisible H)
    (hK : DeningerUniquelyDivisible K) (f : H →* K) (n : ℕ) (x : H) :
    f (deningerRoot hH n x) = deningerRoot hK n (f x) :=
  deningerRoot_unique hK n (by rw [← map_pow, deningerRoot_pow])

end RootChoice

/-! ### The term algebra -/

/-- Terms in the signature of a group with root operations. -/
inductive DeningerDTerm (α : Type u) : Type u
  | of : α → DeningerDTerm α
  | one : DeningerDTerm α
  | mul : DeningerDTerm α → DeningerDTerm α → DeningerDTerm α
  | inv : DeningerDTerm α → DeningerDTerm α
  | root : ℕ → DeningerDTerm α → DeningerDTerm α

namespace DeningerDTerm

/-- The `k`-th power of a term. -/
def npow {α : Type u} (t : DeningerDTerm α) : ℕ → DeningerDTerm α
  | 0 => DeningerDTerm.one
  | k + 1 => DeningerDTerm.mul (npow t k) t

end DeningerDTerm

/-- The congruence presenting the Baumslag rationalization. -/
inductive DeningerDRel (α : Type u) [Group α] : DeningerDTerm α → DeningerDTerm α → Prop
  | refl (t) : DeningerDRel α t t
  | symm {s t} : DeningerDRel α s t → DeningerDRel α t s
  | trans {r s t} : DeningerDRel α r s → DeningerDRel α s t → DeningerDRel α r t
  | mul_congr {a b c d} : DeningerDRel α a c → DeningerDRel α b d →
      DeningerDRel α (DeningerDTerm.mul a b) (DeningerDTerm.mul c d)
  | inv_congr {a b} : DeningerDRel α a b →
      DeningerDRel α (DeningerDTerm.inv a) (DeningerDTerm.inv b)
  | root_congr (n) {a b} : DeningerDRel α a b →
      DeningerDRel α (DeningerDTerm.root n a) (DeningerDTerm.root n b)
  | assoc (a b c) : DeningerDRel α (DeningerDTerm.mul (DeningerDTerm.mul a b) c)
      (DeningerDTerm.mul a (DeningerDTerm.mul b c))
  | one_mul (a) : DeningerDRel α (DeningerDTerm.mul DeningerDTerm.one a) a
  | mul_one (a) : DeningerDRel α (DeningerDTerm.mul a DeningerDTerm.one) a
  | inv_mul (a) : DeningerDRel α (DeningerDTerm.mul (DeningerDTerm.inv a) a) DeningerDTerm.one
  | of_mul (g h : α) : DeningerDRel α (DeningerDTerm.of (g * h))
      (DeningerDTerm.mul (DeningerDTerm.of g) (DeningerDTerm.of h))
  | of_one : DeningerDRel α (DeningerDTerm.of (1 : α)) DeningerDTerm.one
  | root_pow (n) (t) :
      DeningerDRel α (DeningerDTerm.npow (DeningerDTerm.root n t) (n + 1)) t
  | pow_root (n) (t) :
      DeningerDRel α (DeningerDTerm.root n (DeningerDTerm.npow t (n + 1))) t

/-- **The Baumslag rationalization of a group.** -/
def DeningerBau (α : Type u) [Group α] : Type u := Quot (DeningerDRel α)

namespace DeningerBau

variable {α : Type u} [Group α]

/-- The class of a term. -/
def mk (t : DeningerDTerm α) : DeningerBau α := Quot.mk _ t

theorem sound {s t : DeningerDTerm α} (h : DeningerDRel α s t) : mk s = mk t := Quot.sound h

@[elab_as_elim]
theorem induction {motive : DeningerBau α → Prop} (h : ∀ t, motive (mk t)) (x : DeningerBau α) :
    motive x := Quot.ind h x

instance : Mul (DeningerBau α) :=
  ⟨fun x y => Quot.lift
    (fun s => Quot.lift (fun t => mk (DeningerDTerm.mul s t))
      (fun _ _ h => sound (DeningerDRel.mul_congr (DeningerDRel.refl s) h)) y)
    (fun s₁ s₂ h => by
      refine induction (motive := fun z => Quot.lift _ _ z = Quot.lift _ _ z) ?_ y
      intro t
      exact sound (DeningerDRel.mul_congr h (DeningerDRel.refl t))) x⟩

instance : One (DeningerBau α) := ⟨mk DeningerDTerm.one⟩

instance : Inv (DeningerBau α) :=
  ⟨Quot.lift (fun t => mk (DeningerDTerm.inv t))
    (fun _ _ h => sound (DeningerDRel.inv_congr h))⟩

theorem mk_mul (s t : DeningerDTerm α) : mk s * mk t = mk (DeningerDTerm.mul s t) := rfl

theorem mk_one : (1 : DeningerBau α) = mk DeningerDTerm.one := rfl

theorem mk_inv (t : DeningerDTerm α) : (mk t)⁻¹ = mk (DeningerDTerm.inv t) := rfl

instance : Group (DeningerBau α) where
  mul_assoc := by
    refine induction fun a => induction fun b => induction fun c => ?_
    rw [mk_mul, mk_mul, mk_mul, mk_mul]
    exact sound (DeningerDRel.assoc a b c)
  one_mul := by
    refine induction fun a => ?_
    rw [mk_one, mk_mul]
    exact sound (DeningerDRel.one_mul a)
  mul_one := by
    refine induction fun a => ?_
    rw [mk_one, mk_mul]
    exact sound (DeningerDRel.mul_one a)
  inv_mul_cancel := by
    refine induction fun a => ?_
    rw [mk_inv, mk_mul, mk_one]
    exact sound (DeningerDRel.inv_mul a)

theorem mk_npow (t : DeningerDTerm α) : ∀ k : ℕ, mk t ^ k = mk (DeningerDTerm.npow t k)
  | 0 => by rw [pow_zero, mk_one]; rfl
  | k + 1 => by rw [pow_succ, mk_npow t k, mk_mul]; rfl

/-- The chosen `n+1`-st root. -/
def root (n : ℕ) : DeningerBau α → DeningerBau α :=
  Quot.lift (fun t => mk (DeningerDTerm.root n t))
    (fun _ _ h => sound (DeningerDRel.root_congr n h))

theorem root_mk (n : ℕ) (t : DeningerDTerm α) : root n (mk t) = mk (DeningerDTerm.root n t) := rfl

@[simp]
theorem root_pow (n : ℕ) (x : DeningerBau α) : root n x ^ (n + 1) = x := by
  refine induction (motive := fun x => root n x ^ (n + 1) = x) ?_ x
  intro t
  rw [root_mk, mk_npow]
  exact sound (DeningerDRel.root_pow n t)

@[simp]
theorem pow_root (n : ℕ) (x : DeningerBau α) : root n (x ^ (n + 1)) = x := by
  refine induction (motive := fun x => root n (x ^ (n + 1)) = x) ?_ x
  intro t
  rw [mk_npow, root_mk]
  exact sound (DeningerDRel.pow_root n t)

/-- **The Baumslag rationalization has unique roots.** -/
theorem uniquelyDivisible : DeningerUniquelyDivisible (DeningerBau α) := by
  intro n hn x
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  refine ⟨root m x, root_pow m x, ?_⟩
  intro y hy
  rw [← hy, pow_root]

/-- **The unit of the rationalization.** -/
def of : α →* DeningerBau α where
  toFun a := mk (DeningerDTerm.of a)
  map_one' := sound DeningerDRel.of_one
  map_mul' g h := (sound (DeningerDRel.of_mul g h)).trans rfl

@[simp]
theorem of_apply (a : α) : of a = mk (DeningerDTerm.of a) := rfl

end DeningerBau

/-! ### The universal property -/

namespace DeningerDTerm

variable {α : Type u} {H : Type v} [Group α] [Group H]

/-- Evaluation of a term in a group with unique roots. -/
noncomputable def eval (hH : DeningerUniquelyDivisible H) (f : α →* H) :
    DeningerDTerm α → H
  | DeningerDTerm.of a => f a
  | DeningerDTerm.one => 1
  | DeningerDTerm.mul s t => eval hH f s * eval hH f t
  | DeningerDTerm.inv t => (eval hH f t)⁻¹
  | DeningerDTerm.root n t => deningerRoot hH n (eval hH f t)

theorem eval_npow (hH : DeningerUniquelyDivisible H) (f : α →* H) (t : DeningerDTerm α) :
    ∀ k : ℕ, eval hH f (DeningerDTerm.npow t k) = eval hH f t ^ k
  | 0 => by rw [DeningerDTerm.npow, pow_zero]; rfl
  | k + 1 => by
    show eval hH f (DeningerDTerm.npow t k) * eval hH f t = _
    rw [eval_npow hH f t k, pow_succ]

/-- **Evaluation respects the presenting congruence.** -/
theorem eval_rel (hH : DeningerUniquelyDivisible H) (f : α →* H) {s t : DeningerDTerm α}
    (h : DeningerDRel α s t) : eval hH f s = eval hH f t := by
  induction h with
  | refl t => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | mul_congr _ _ ih₁ ih₂ => exact congrArg₂ (· * ·) ih₁ ih₂
  | inv_congr _ ih => exact congrArg (·⁻¹) ih
  | root_congr n _ ih => exact congrArg (deningerRoot hH n) ih
  | assoc a b c => exact mul_assoc _ _ _
  | one_mul a => exact _root_.one_mul _
  | mul_one a => exact _root_.mul_one _
  | inv_mul a => exact inv_mul_cancel _
  | of_mul g h => exact map_mul f g h
  | of_one => exact map_one f
  | root_pow n t =>
      show eval hH f (DeningerDTerm.npow (DeningerDTerm.root n t) (n + 1)) = _
      rw [eval_npow]
      exact deningerRoot_pow hH n _
  | pow_root n t =>
      show deningerRoot hH n (eval hH f (DeningerDTerm.npow t (n + 1))) = _
      rw [eval_npow]
      exact deningerPow_root hH n _

end DeningerDTerm

section Universal

variable {α : Type u} {H : Type v} [Group α] [Group H]

/-- **The universal map out of the rationalization.** -/
noncomputable def deningerBauLift (hH : DeningerUniquelyDivisible H) (f : α →* H) :
    DeningerBau α →* H where
  toFun := Quot.lift (DeningerDTerm.eval hH f) fun _ _ h => DeningerDTerm.eval_rel hH f h
  map_one' := rfl
  map_mul' := by
    refine DeningerBau.induction fun a => ?_
    refine DeningerBau.induction fun b => ?_
    rfl

@[simp]
theorem deningerBauLift_mk (hH : DeningerUniquelyDivisible H) (f : α →* H)
    (t : DeningerDTerm α) :
    deningerBauLift hH f (DeningerBau.mk t) = DeningerDTerm.eval hH f t := rfl

/-- **The lift extends the given homomorphism.** -/
@[simp]
theorem deningerBauLift_of (hH : DeningerUniquelyDivisible H) (f : α →* H) (a : α) :
    deningerBauLift hH f (DeningerBau.of a) = f a := rfl

theorem deningerBauLift_comp (hH : DeningerUniquelyDivisible H) (f : α →* H) :
    (deningerBauLift hH f).comp (DeningerBau.of : α →* DeningerBau α) = f := by
  ext a
  rfl

/-- The chosen root of the rationalization is the root supplied by unique divisibility. -/
theorem deningerBau_root_eq (n : ℕ) (x : DeningerBau α) :
    DeningerBau.root n x = deningerRoot DeningerBau.uniquelyDivisible n x :=
  deningerRoot_unique _ n (DeningerBau.root_pow n x)

/-- **Uniqueness**: a homomorphism out of the rationalization is determined by its restriction to
the group, because it automatically preserves roots. -/
theorem deningerBauLift_unique (hH : DeningerUniquelyDivisible H) (f : α →* H)
    (F : DeningerBau α →* H) (hF : ∀ a : α, F (DeningerBau.of a) = f a) :
    F = deningerBauLift hH f := by
  have hroot : ∀ (n : ℕ) (x : DeningerBau α),
      F (DeningerBau.root n x) = deningerRoot hH n (F x) := by
    intro n x
    rw [deningerBau_root_eq]
    exact deningerMap_root DeningerBau.uniquelyDivisible hH F n x
  ext x
  refine DeningerBau.induction (motive := fun x => F x = deningerBauLift hH f x) ?_ x
  intro t
  induction t with
  | of a => exact hF a
  | one =>
    show F 1 = _
    rw [map_one]
    rfl
  | mul s t hs ht =>
    show F (DeningerBau.mk s * DeningerBau.mk t) = _
    rw [map_mul, hs, ht]
    rfl
  | inv t ht =>
    show F (DeningerBau.mk t)⁻¹ = _
    rw [map_inv, ht]
    rfl
  | root n t ht =>
    show F (DeningerBau.root n (DeningerBau.mk t)) = _
    rw [hroot, ht]
    rfl

/-- **The lift preserves roots.** -/
theorem deningerBauLift_root (hH : DeningerUniquelyDivisible H) (f : α →* H) (n : ℕ)
    (x : DeningerBau α) :
    deningerBauLift hH f (DeningerBau.root n x) = deningerRoot hH n (deningerBauLift hH f x) := by
  rw [deningerBau_root_eq]
  exact deningerMap_root DeningerBau.uniquelyDivisible hH _ n x

/-- **The lift is onto whenever the target is generated by the image as a group with roots.** -/
theorem deningerBauLift_surjective (hH : DeningerUniquelyDivisible H) (f : α →* H)
    (hgen : ∀ K : Subgroup H, (∀ (n : ℕ) (x : H), x ∈ K → deningerRoot hH n x ∈ K) →
      (∀ a : α, f a ∈ K) → K = ⊤) :
    Function.Surjective (deningerBauLift hH f) := by
  have hrange := hgen (deningerBauLift hH f).range ?_ ?_
  · intro y
    have : y ∈ (deningerBauLift hH f).range := by rw [hrange]; trivial
    exact this
  · rintro n x ⟨z, rfl⟩
    exact ⟨DeningerBau.root n z, deningerBauLift_root hH f n z⟩
  · intro a
    exact ⟨DeningerBau.of a, rfl⟩

end Universal

/-! ### The free rational packet -/

section FreeRational

variable {A : Type v} [AddCommGroup A] [Module ℚ A]

/-- **A rational vector space, written multiplicatively, has unique roots.** -/
theorem deningerMultiplicative_uniquelyDivisible :
    DeningerUniquelyDivisible (Multiplicative A) := by
  intro n hn x
  have hn' : (n : ℚ) ≠ 0 := Nat.cast_ne_zero.2 (by omega)
  refine ⟨Multiplicative.ofAdd ((n : ℚ)⁻¹ • Multiplicative.toAdd x), ?_, ?_⟩
  · show Multiplicative.ofAdd (n • ((n : ℚ)⁻¹ • Multiplicative.toAdd x)) = x
    rw [← Nat.cast_smul_eq_nsmul ℚ, smul_smul, mul_inv_cancel₀ hn', one_smul]
    rfl
  · intro y hy
    have hy' : n • Multiplicative.toAdd y = Multiplicative.toAdd x := congrArg Multiplicative.toAdd hy
    rw [← Nat.cast_smul_eq_nsmul ℚ] at hy'
    have : Multiplicative.toAdd y = (n : ℚ)⁻¹ • Multiplicative.toAdd x := by
      rw [← hy', smul_smul, inv_mul_cancel₀ hn', one_smul]
    exact congrArg Multiplicative.ofAdd this

theorem deningerRoot_multiplicative (n : ℕ) (x : Multiplicative A) :
    deningerRoot (deningerMultiplicative_uniquelyDivisible (A := A)) n x =
      Multiplicative.ofAdd (((n : ℚ) + 1)⁻¹ • Multiplicative.toAdd x) := by
  refine (deningerRoot_unique _ n ?_).symm
  have hn' : ((n : ℚ) + 1) ≠ 0 := by positivity
  show Multiplicative.ofAdd ((n + 1) • (((n : ℚ) + 1)⁻¹ • Multiplicative.toAdd x)) = x
  rw [← Nat.cast_smul_eq_nsmul ℚ, smul_smul]
  push_cast
  rw [mul_inv_cancel₀ hn', one_smul]
  rfl

/-- A subgroup of the multiplicative group of a rational vector space that is closed under roots is
a rational subspace. -/
def deningerRootSubmodule (K : Subgroup (Multiplicative A))
    (hK : ∀ (n : ℕ) (x : Multiplicative A), x ∈ K →
      deningerRoot (deningerMultiplicative_uniquelyDivisible (A := A)) n x ∈ K) :
    Submodule ℚ A where
  carrier := {a : A | Multiplicative.ofAdd a ∈ K}
  add_mem' ha hb := K.mul_mem ha hb
  zero_mem' := K.one_mem
  smul_mem' q a ha := by
    have hden : ((q.den : ℚ))⁻¹ • a ∈ {a : A | Multiplicative.ofAdd a ∈ K} := by
      obtain ⟨d, hd⟩ : ∃ d : ℕ, q.den = d + 1 := ⟨q.den - 1, by have := q.pos; omega⟩
      have h := hK d (Multiplicative.ofAdd a) ha
      rw [deningerRoot_multiplicative] at h
      have hcast : ((d : ℚ) + 1) = (q.den : ℚ) := by rw [hd]; push_cast; ring
      rw [hcast] at h
      exact h
    have hnum : (q.num : ℤ) • (((q.den : ℚ))⁻¹ • a) ∈ {a : A | Multiplicative.ofAdd a ∈ K} :=
      K.zpow_mem hden q.num
    have hq : q • a = (q.num : ℤ) • (((q.den : ℚ))⁻¹ • a) := by
      rw [← Int.cast_smul_eq_zsmul ℚ, smul_smul]
      congr 1
      rw [← div_eq_mul_inv]
      exact_mod_cast (Rat.num_div_den q).symm
    rw [hq]
    exact hnum

/-- **Clause `(1)` of the packet.**  The Baumslag rationalization of the free group on a spanning
family of a rational vector space surjects onto that space: the image is a subgroup closed under
roots, hence a rational subspace, and it contains the spanning family. -/
theorem deningerBauFree_surjective {ι : Type u} (b : ι → A)
    (hb : Submodule.span ℚ (Set.range b) = ⊤) :
    Function.Surjective (deningerBauLift (deningerMultiplicative_uniquelyDivisible (A := A))
      (FreeGroup.lift (fun i => Multiplicative.ofAdd (b i)))) := by
  refine deningerBauLift_surjective _ _ ?_
  intro K hKroot hKgen
  refine (Subgroup.eq_top_iff' K).2 fun x => ?_
  have hspan : Submodule.span ℚ (Set.range b) ≤ deningerRootSubmodule K hKroot := by
    rw [Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    have hmem := hKgen (FreeGroup.of i)
    show Multiplicative.ofAdd (b i) ∈ K
    simpa using hmem
  rw [hb] at hspan
  have : Multiplicative.toAdd x ∈ deningerRootSubmodule K hKroot := hspan trivial
  exact this

/-- A rational vector space, written multiplicatively, is torsion free. -/
theorem deningerMultiplicative_torsionFree (x : Multiplicative A) (n : ℕ) (hn : 0 < n)
    (hx : x ^ n = 1) : x = 1 := by
  have hn' : (n : ℚ) ≠ 0 := Nat.cast_ne_zero.2 (by omega)
  have h : n • Multiplicative.toAdd x = 0 := congrArg Multiplicative.toAdd hx
  rw [← Nat.cast_smul_eq_nsmul ℚ] at h
  have : Multiplicative.toAdd x = 0 := by
    have := congrArg (fun y : A => (n : ℚ)⁻¹ • y) h
    rwa [smul_smul, inv_mul_cancel₀ hn', one_smul, smul_zero] at this
  exact congrArg Multiplicative.ofAdd this

/-- The packet's surjection `a_U : R_U ↠ A`. -/
noncomputable def deningerBauFreeMap {ι : Type u} (b : ι → A) :
    DeningerBau (FreeGroup ι) →* Multiplicative A :=
  deningerBauLift (deningerMultiplicative_uniquelyDivisible (A := A))
    (FreeGroup.lift (fun i => Multiplicative.ofAdd (b i)))

/-- **Clause 1 of the packet, at the actual object**: the kernel of `a_U` is uniquely divisible. -/
theorem deningerBauFreeKer_uniquelyDivisible {ι : Type u} (b : ι → A) :
    DeningerUniquelyDivisible ((deningerBauFreeMap b).ker :
      Subgroup (DeningerBau (FreeGroup ι))) :=
  deningerKer_uniquelyDivisible _ DeningerBau.uniquelyDivisible
    deningerMultiplicative_torsionFree

/-- **Clause 2 of the packet, at the actual object**: that kernel has no nontrivial finite
quotient. -/
theorem deningerBauFreeKer_noFiniteQuotient {ι : Type u} (b : ι → A) :
    DeningerNoFiniteQuotient ((deningerBauFreeMap b).ker :
      Subgroup (DeningerBau (FreeGroup ι))) :=
  deningerKer_noFiniteQuotient _ DeningerBau.uniquelyDivisible
    deningerMultiplicative_torsionFree

end FreeRational

end RHTower
