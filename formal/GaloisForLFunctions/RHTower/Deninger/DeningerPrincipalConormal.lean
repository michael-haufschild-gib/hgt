import Mathlib.RingTheory.Ideal.Cotangent
import GaloisForLFunctions.RHTower.Deninger.DeningerPositiveCellDegreeZero

/-!
# The conormal module of a principal regular ideal

For an ideal generated by a single non-zero-divisor the conormal module `I/I²` is free of rank one
on the class of the generator: multiplication by the generator identifies the quotient by the ideal
with the conormal module.  The only thing to check is that a multiple of the generator lies in the
square of the ideal exactly when its cofactor lies in the ideal, which is cancellation by the
generator.

For a monic polynomial this is the trivialization of the conormal determinant line of the closed
immersion it cuts out, by the class of the polynomial itself — the first of the two trivializations
that orient the fundamental class of a monic hypersurface.

* `deningerConormal_mul_mem_sq_iff` : a multiple of a regular generator lies in the square of the
  ideal exactly when its cofactor lies in the ideal.
* `deningerConormalPrincipalEquiv` : **the conormal module of a principal regular ideal is free of
  rank one on the generator.**
* `deningerMonicConormalEquiv` : the trivialization for a monic polynomial.
-/

namespace RHTower

section PrincipalConormal

variable {S : Type*} [CommRing S] (P : S)

theorem deningerConormal_generator_mem : P ∈ Ideal.span ({P} : Set S) :=
  Ideal.subset_span rfl

/-- A multiple of a regular generator lies in the square of the principal ideal exactly when its
cofactor lies in the ideal: this is cancellation by the generator. -/
theorem deningerConormal_mul_mem_sq_iff (hP : IsRegular P) (q : S) :
    q * P ∈ (Ideal.span ({P} : Set S)) ^ (2 : ℕ) ↔ q ∈ Ideal.span ({P} : Set S) := by
  rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton', Ideal.mem_span_singleton']
  constructor
  · rintro ⟨a, ha⟩
    refine ⟨a, ?_⟩
    have h2 : a * P * P = q * P := by
      rw [mul_assoc, ← pow_two]
      exact ha
    exact hP.right h2
  · rintro ⟨a, ha⟩
    refine ⟨a, ?_⟩
    rw [← ha, pow_two]
    ring

/-- Multiplication by the generator, followed by the conormal projection. -/
noncomputable def deningerConormalMap : S →ₗ[S] (Ideal.span ({P} : Set S)).Cotangent :=
  (Ideal.span ({P} : Set S)).toCotangent.comp
    (LinearMap.toSpanSingleton S (Ideal.span ({P} : Set S))
      ⟨P, deningerConormal_generator_mem P⟩)

theorem deningerConormalMap_apply (q : S) :
    deningerConormalMap P q
      = (Ideal.span ({P} : Set S)).toCotangent
          ⟨q * P, Ideal.mem_span_singleton'.mpr ⟨q, rfl⟩⟩ := rfl

theorem deningerConormalMap_surjective : Function.Surjective (deningerConormalMap P) := by
  intro y
  obtain ⟨x, rfl⟩ := (Ideal.span ({P} : Set S)).toCotangent_surjective y
  obtain ⟨q, hq⟩ := Ideal.mem_span_singleton'.mp x.2
  refine ⟨q, ?_⟩
  rw [deningerConormalMap_apply]
  congr 1
  exact Subtype.ext hq

theorem deningerConormalMap_ker (hP : IsRegular P) :
    LinearMap.ker (deningerConormalMap P) = Ideal.span ({P} : Set S) := by
  refine Submodule.ext fun q => ?_
  rw [LinearMap.mem_ker, deningerConormalMap_apply,
    Ideal.toCotangent_eq_zero]
  exact deningerConormal_mul_mem_sq_iff P hP q

/-- **The conormal module of a principal ideal generated by a non-zero-divisor is free of rank one**
on the class of the generator: multiplication by the generator identifies the quotient by the ideal
with the conormal module. -/
noncomputable def deningerConormalPrincipalEquiv (hP : IsRegular P) :
    (S ⧸ Ideal.span ({P} : Set S)) ≃ₗ[S] (Ideal.span ({P} : Set S)).Cotangent :=
  (Submodule.quotEquivOfEq _ _ (deningerConormalMap_ker P hP).symm).trans
    ((deningerConormalMap P).quotKerEquivOfSurjective (deningerConormalMap_surjective P))

end PrincipalConormal

/-- **The conormal trivialization of a monic hypersurface.**  The conormal module of the ideal cut
out by a monic polynomial is free of rank one on the class of the polynomial, so its determinant
line is trivialized by that class. -/
noncomputable def deningerMonicConormalEquiv {A : Type*} [CommRing A] [Nontrivial A]
    {P : Polynomial A} (hP : P.Monic) :
    (Polynomial A ⧸ Ideal.span ({P} : Set (Polynomial A)))
      ≃ₗ[Polynomial A] (Ideal.span ({P} : Set (Polynomial A))).Cotangent :=
  deningerConormalPrincipalEquiv P (deningerMonic_isRegular hP)

end RHTower
