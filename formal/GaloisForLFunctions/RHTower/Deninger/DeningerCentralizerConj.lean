import GaloisForLFunctions.RHTower.Deninger.DeningerMaximalRootCentralizer
import GaloisForLFunctions.RHTower.Deninger.DeningerCyclicCentralizers

/-!
# Centralizers along conjugation

Conjugating an element conjugates its centralizer, so a cyclic centralizer stays cyclic.  For an
element conjugate to a cyclically reduced word of at least two letters this gives the whole
centralizer condition: the generator has infinite order, because the group has no torsion and the
element is nontrivial, and its powers exhaust the centralizer.

* `deningerCentralizer_conj` : transport of a cyclic centralizer along conjugation.
* `deningerCycRedConj_centralizer` : the centralizer condition for a conjugate of a cyclically
  reduced word.
-/

namespace RHTower

open Monoid Monoid.PushoutI Monoid.CoprodI

/-- **Transport of a cyclic centralizer along conjugation.** -/
theorem deningerCentralizer_conj {A : Type*} [Group A] (w y g : A)
    (h : ∀ z : A, z * w * z⁻¹ = w → z ∈ Subgroup.zpowers y) (z : A)
    (hz : z * (g * w * g⁻¹) * z⁻¹ = g * w * g⁻¹) : z ∈ Subgroup.zpowers (g * y * g⁻¹) := by
  have h1 : (g⁻¹ * z * g) * w * (g⁻¹ * z * g)⁻¹ = w := by
    calc (g⁻¹ * z * g) * w * (g⁻¹ * z * g)⁻¹
        = g⁻¹ * (z * (g * w * g⁻¹) * z⁻¹) * g := by group
      _ = g⁻¹ * (g * w * g⁻¹) * g := by rw [hz]
      _ = w := by group
  obtain ⟨k, hk'⟩ := h _ h1
  have hk : y ^ k = g⁻¹ * z * g := hk'
  refine ⟨k, ?_⟩
  show (g * y * g⁻¹) ^ k = z
  rw [conj_zpow, hk]
  group

/-- **A conjugate of an element of infinite order has infinite order.** -/
theorem deningerConj_order {A : Type*} [Group A] (y g : A)
    (hy : ∀ n : ℤ, y ^ n = 1 → n = 0) : ∀ n : ℤ, (g * y * g⁻¹) ^ n = 1 → n = 0 := by
  intro n hn
  refine hy n ?_
  have h1 : (g * y * g⁻¹) ^ n = g * y ^ n * g⁻¹ := conj_zpow
  rw [hn] at h1
  calc y ^ n = g⁻¹ * (g * y ^ n * g⁻¹) * g := by group
    _ = 1 := by rw [← h1]; group

/-- **The centralizer condition is transported by conjugation.**  If the centralizer of an element
is the cyclic subgroup generated by an element of infinite order, the same holds of every
conjugate. -/
theorem deningerCyclicCentralizer_conj {A : Type*} [Group A] (w g y : A)
    (hy : ∀ n : ℤ, y ^ n = 1 → n = 0)
    (h : ∀ z : A, z * w * z⁻¹ = w ↔ z ∈ Subgroup.zpowers y) :
    ∃ y' : A, (∀ n : ℤ, y' ^ n = 1 → n = 0) ∧
      ∀ z : A, z * (g * w * g⁻¹) * z⁻¹ = g * w * g⁻¹ ↔ z ∈ Subgroup.zpowers y' := by
  refine ⟨g * y * g⁻¹, ?_, fun z => ⟨fun hz => ?_, fun hz => ?_⟩⟩
  · intro n hn
    refine hy n ?_
    have h1 : (g * y * g⁻¹) ^ n = g * y ^ n * g⁻¹ := conj_zpow
    rw [hn] at h1
    calc y ^ n = g⁻¹ * (g * y ^ n * g⁻¹) * g := by group
      _ = 1 := by rw [← h1]; group
  · exact deningerCentralizer_conj w y g (fun z hz => (h z).1 hz) z hz
  · obtain ⟨k, hk'⟩ := hz
    have hk : (g * y * g⁻¹) ^ k = z := hk'
    have hcom : (y ^ k) * w * (y ^ k)⁻¹ = w := (h (y ^ k)).2 ⟨k, rfl⟩
    rw [← hk, conj_zpow]
    calc g * y ^ k * g⁻¹ * (g * w * g⁻¹) * (g * y ^ k * g⁻¹)⁻¹
        = g * ((y ^ k) * w * (y ^ k)⁻¹) * g⁻¹ := by group
      _ = g * w * g⁻¹ := by rw [hcom]

variable {ι : Type*} {G : ι → Type*} {H : Type*} [∀ i, Group (G i)] [Group H]
  {φ : ∀ i, H →* G i} {d : NormalWord.Transversal φ}
  [DecidableEq ι] [∀ i, DecidableEq (G i)]

include d in
/-- **The centralizer condition for a conjugate of a cyclically reduced word.**  The centralizer of
an element conjugate to a cyclically reduced word of at least two letters is the cyclic subgroup
generated by an element of infinite order. -/
theorem deningerCycRedConj_centralizer
    (hcent : ∀ (i : ι) (x : G i) (u v : H), x * φ i u * x⁻¹ = φ i v → v = u)
    (i₀ : ι)
    (hself : ∀ (i : ι) (x : G i) (v : H), i ≠ i₀ → v ≠ 1 → x * φ i v * x⁻¹ = φ i v →
      x ∈ (φ i).range)
    (huniq : ∀ (x y : PushoutI φ) (n : ℕ), 0 < n → x ^ n = y ^ n → x = y)
    (X : List (Σ i, G i)) (hX2 : 2 ≤ X.length)
    (hXred : ∀ p ∈ X, p.2 ∉ (φ p.1).range)
    (hXalt : List.IsChain (fun p q : Σ i, G i => p.1 ≠ q.1) X)
    (hXcyc : ∀ p ∈ X.getLast?, ∀ q ∈ X.head?, p.1 ≠ q.1) (g : PushoutI φ) :
    ∃ y : PushoutI φ, (∀ n : ℤ, y ^ n = 1 → n = 0) ∧
      ∀ z : PushoutI φ,
        z * (g * deningerLetterProd (φ := φ) X * g⁻¹) * z⁻¹ =
          g * deningerLetterProd (φ := φ) X * g⁻¹ ↔ z ∈ Subgroup.zpowers (g * y * g⁻¹) := by
  classical
  obtain ⟨y, N, hN, hyN, hC⟩ :=
    deningerCycRed_centralizer_cyclic (d := d) hcent i₀ hself huniq X hX2 hXred hXalt hXcyc
  have hXne1 : deningerLetterProd (φ := φ) X ≠ 1 := by
    intro hc
    have h1 : deningerLen d (deningerLetterProd (φ := φ) X) = X.length :=
      deningerLen_letterProd (d := d) X hXred hXalt
    rw [hc, deningerLen_one] at h1
    omega
  have hyorder : ∀ n : ℤ, y ^ n = 1 → n = 0 := by
    intro n hn
    by_contra hc
    have h1 : y ^ (n.natAbs) = 1 := by
      rcases Int.natAbs_eq n with h | h
      · rw [← zpow_natCast, ← h]
        exact hn
      · rw [← zpow_natCast, show ((n.natAbs : ℤ)) = -n by omega, zpow_neg, hn, inv_one]
    have h2 : y = 1 := deningerUniqueRoots_torsionFree huniq y n.natAbs (by omega) h1
    rw [h2, one_pow] at hyN
    exact hXne1 hyN.symm
  refine ⟨y, hyorder, fun z => ⟨fun hz => ?_, fun hz => ?_⟩⟩
  · exact deningerCentralizer_conj (deningerLetterProd (φ := φ) X) y g hC z hz
  · obtain ⟨k, hk'⟩ := hz
    have hk : (g * y * g⁻¹) ^ k = z := hk'
    rw [← hk]
    have hcomm : (g * y * g⁻¹) ^ k * (g * deningerLetterProd (φ := φ) X * g⁻¹) =
        (g * deningerLetterProd (φ := φ) X * g⁻¹) * (g * y * g⁻¹) ^ k := by
      rw [conj_zpow, ← hyN]
      have h1 : (y ^ k) * (y ^ (N : ℤ)) = (y ^ (N : ℤ)) * (y ^ k) := by
        rw [← zpow_add, ← zpow_add, add_comm]
      calc g * y ^ k * g⁻¹ * (g * y ^ N * g⁻¹)
          = g * (y ^ k * y ^ (N : ℤ)) * g⁻¹ := by rw [zpow_natCast]; group
        _ = g * (y ^ (N : ℤ) * y ^ k) * g⁻¹ := by rw [h1]
        _ = g * y ^ N * g⁻¹ * (g * y ^ k * g⁻¹) := by rw [zpow_natCast]; group
    rw [hcomm]
    group

end RHTower
