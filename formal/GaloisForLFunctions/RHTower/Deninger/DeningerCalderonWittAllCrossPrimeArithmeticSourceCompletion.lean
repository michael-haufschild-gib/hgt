import GaloisForLFunctions.RHTower.Deninger.DeningerCalderonWittAllCrossPrimeIncidenceKoszul

/-!
# Arithmetic source completion for the all-cross-prime packet

The all-cross-prime incidence carrier was constructed as an `ℓ²` packet
over ordered distinct-prime pairs.  This module identifies its algebraic
core with the span of the *actual* Calderón--Witt Milnor-incidence witnesses.

Normalized Gamma--modular coordinates make those witnesses linearly
independent.  Their source span is therefore canonically equivalent to
finitely supported packet coefficients.  The coefficient realization in
the `ℓ²` packet is injective and has dense range.  Thus the packet Hilbert
space is a completion presentation of the concrete arithmetic witness span,
not an auxiliary labelled copy.

No Riemann-hypothesis, zero-location, positivity, or spectral-synthesis
premise occurs.
-/

open Complex Function Set Topology
open scoped ENNReal

namespace RHTower

noncomputable section

noncomputable local instance deningerCalderonWittAllCrossPrimeArithmeticSourceCompletionInst1 : DecidableEq DeningerCalderonWittCrossPrimePacketIndex :=
  Classical.decEq _

/-- Actual ordered cross-prime Calderón--Witt witness family. -/
def deningerCalderonWittCrossPrimeGammaWitnessFamily
    (i : DeningerCalderonWittCrossPrimePacketIndex) :
    deningerCalderonWittGlobalMilnorIncidence :=
  deningerCalderonWittCrossPrimeGammaWitness i.2

/-- Concrete algebraic source span generated by all actual ordered
cross-prime Milnor-incidence witnesses. -/
def deningerCalderonWittCrossPrimeAlgebraicSourceSpan :
    Submodule ℂ deningerCalderonWittGlobalMilnorIncidence :=
  Submodule.span ℂ
    (Set.range deningerCalderonWittCrossPrimeGammaWitnessFamily)

/-- Every element of the concrete source span has unique finitely supported
ordered-pair coefficients. -/
def deningerCalderonWittCrossPrimeFinsuppEquivAlgebraicSourceSpan :
    (DeningerCalderonWittCrossPrimePacketIndex →₀ ℂ) ≃ₗ[ℂ]
      deningerCalderonWittCrossPrimeAlgebraicSourceSpan :=
  deningerCalderonWittCrossPrimeGammaWitness_linearIndependent
    |>.linearCombinationEquiv

@[simp]
theorem deningerCalderonWittCrossPrimeFinsuppEquivAlgebraicSourceSpan_coe
    (a : DeningerCalderonWittCrossPrimePacketIndex →₀ ℂ) :
    (deningerCalderonWittCrossPrimeFinsuppEquivAlgebraicSourceSpan a :
        deningerCalderonWittGlobalMilnorIncidence) =
      deningerCalderonWittCrossPrimeAlgebraicSourceRealization a := by
  rfl

/-- Standard single-coordinate vector in the completed cross-prime packet. -/
def deningerCalderonWittCrossPrimePacketBasisVector
    (i : DeningerCalderonWittCrossPrimePacketIndex) :
    DeningerCalderonWittCrossPrimePacketHilbert :=
  lp.single 2 i 1

/-- Canonical realization of finite arithmetic packet coefficients in their
Hilbert completion. -/
def deningerCalderonWittCrossPrimeAlgebraicPacketToHilbert :
    (DeningerCalderonWittCrossPrimePacketIndex →₀ ℂ) →ₗ[ℂ]
      DeningerCalderonWittCrossPrimePacketHilbert :=
  Finsupp.linearCombination ℂ
    deningerCalderonWittCrossPrimePacketBasisVector

@[simp]
theorem deningerCalderonWittCrossPrimeAlgebraicPacketToHilbert_apply
    (a : DeningerCalderonWittCrossPrimePacketIndex →₀ ℂ)
    (i : DeningerCalderonWittCrossPrimePacketIndex) :
    deningerCalderonWittCrossPrimeAlgebraicPacketToHilbert a i = a i := by
  change
    (lp.evalₗ (𝕜 := ℂ)
      (fun _ : DeningerCalderonWittCrossPrimePacketIndex => ℂ) 2 i)
        (deningerCalderonWittCrossPrimeAlgebraicPacketToHilbert a) = a i
  rw [deningerCalderonWittCrossPrimeAlgebraicPacketToHilbert,
    Finsupp.apply_linearCombination, Finsupp.linearCombination_apply]
  classical
  change a.sum (fun j c =>
    c * ((Pi.single j (1 : ℂ) :
      DeningerCalderonWittCrossPrimePacketIndex → ℂ) i)) = a i
  simp [Pi.single_apply, eq_comm]

theorem deningerCalderonWittCrossPrimeAlgebraicPacketToHilbert_injective :
    Function.Injective
      deningerCalderonWittCrossPrimeAlgebraicPacketToHilbert := by
  intro a b hab
  apply Finsupp.ext
  intro i
  rw [
    ← deningerCalderonWittCrossPrimeAlgebraicPacketToHilbert_apply a i,
    ← deningerCalderonWittCrossPrimeAlgebraicPacketToHilbert_apply b i,
    hab]

/-- Source-native embedding of the actual witness span into its packet
Hilbert completion. -/
def deningerCalderonWittCrossPrimeSourceSpanToPacketHilbert :
    deningerCalderonWittCrossPrimeAlgebraicSourceSpan →ₗ[ℂ]
      DeningerCalderonWittCrossPrimePacketHilbert :=
  deningerCalderonWittCrossPrimeAlgebraicPacketToHilbert.comp
    deningerCalderonWittCrossPrimeFinsuppEquivAlgebraicSourceSpan.symm.toLinearMap

@[simp]
theorem deningerCalderonWittCrossPrimeSourceSpanToPacketHilbert_finsupp
    (a : DeningerCalderonWittCrossPrimePacketIndex →₀ ℂ) :
    deningerCalderonWittCrossPrimeSourceSpanToPacketHilbert
        (deningerCalderonWittCrossPrimeFinsuppEquivAlgebraicSourceSpan a) =
      deningerCalderonWittCrossPrimeAlgebraicPacketToHilbert a := by
  simp [deningerCalderonWittCrossPrimeSourceSpanToPacketHilbert]

theorem deningerCalderonWittCrossPrimeSourceSpanToPacketHilbert_injective :
    Function.Injective
      deningerCalderonWittCrossPrimeSourceSpanToPacketHilbert := by
  exact
    deningerCalderonWittCrossPrimeAlgebraicPacketToHilbert_injective.comp
      deningerCalderonWittCrossPrimeFinsuppEquivAlgebraicSourceSpan.symm.injective

/-- Standard Hilbert basis of the cross-prime packet completion. -/
def deningerCalderonWittCrossPrimePacketHilbertBasis :
    HilbertBasis DeningerCalderonWittCrossPrimePacketIndex ℂ
      DeningerCalderonWittCrossPrimePacketHilbert :=
  HilbertBasis.ofRepr (LinearIsometryEquiv.refl ℂ _)

@[simp]
theorem deningerCalderonWittCrossPrimePacketHilbertBasis_apply
    (i : DeningerCalderonWittCrossPrimePacketIndex) :
    deningerCalderonWittCrossPrimePacketHilbertBasis i =
      deningerCalderonWittCrossPrimePacketBasisVector i := by
  rfl

/-- Finitely supported arithmetic packets are dense in the simultaneous
cross-prime Hilbert packet. -/
theorem deningerCalderonWittCrossPrimeAlgebraicPacketToHilbert_denseRange :
    DenseRange deningerCalderonWittCrossPrimeAlgebraicPacketToHilbert := by
  change Dense
    (↑(LinearMap.range
      deningerCalderonWittCrossPrimeAlgebraicPacketToHilbert) :
      Set DeningerCalderonWittCrossPrimePacketHilbert)
  rw [Submodule.dense_iff_topologicalClosure_eq_top,
    deningerCalderonWittCrossPrimeAlgebraicPacketToHilbert,
    Finsupp.range_linearCombination]
  have hfamily :
      (deningerCalderonWittCrossPrimePacketHilbertBasis :
        DeningerCalderonWittCrossPrimePacketIndex →
          DeningerCalderonWittCrossPrimePacketHilbert) =
        deningerCalderonWittCrossPrimePacketBasisVector := by
    funext i
    exact deningerCalderonWittCrossPrimePacketHilbertBasis_apply i
  rw [← hfamily]
  exact deningerCalderonWittCrossPrimePacketHilbertBasis.dense_span

/-- The completed packet is the dense completion presentation of the
concrete actual-witness source span. -/
theorem deningerCalderonWittCrossPrimeSourceSpanToPacketHilbert_denseRange :
    DenseRange deningerCalderonWittCrossPrimeSourceSpanToPacketHilbert := by
  change Dense
    (Set.range
      (deningerCalderonWittCrossPrimeSourceSpanToPacketHilbert :
        deningerCalderonWittCrossPrimeAlgebraicSourceSpan →
          DeningerCalderonWittCrossPrimePacketHilbert))
  rw [show Set.range
      deningerCalderonWittCrossPrimeSourceSpanToPacketHilbert =
      Set.range deningerCalderonWittCrossPrimeAlgebraicPacketToHilbert by
    ext z
    constructor
    · rintro ⟨x, rfl⟩
      exact
        ⟨deningerCalderonWittCrossPrimeFinsuppEquivAlgebraicSourceSpan.symm x,
          rfl⟩
    · rintro ⟨a, rfl⟩
      exact
        ⟨deningerCalderonWittCrossPrimeFinsuppEquivAlgebraicSourceSpan a, by
          simp [deningerCalderonWittCrossPrimeSourceSpanToPacketHilbert]⟩]
  exact deningerCalderonWittCrossPrimeAlgebraicPacketToHilbert_denseRange

/-! ## Exact obstruction to extending the old oriented boundary -/

/-- The existing all-prime oriented source boundary kills the complete
algebraic cross-prime source span. -/
theorem deningerCalderonWittGlobalOrientedBoundary_crossPrimeSourceSpan
    (x : deningerCalderonWittCrossPrimeAlgebraicSourceSpan) :
    deningerCalderonWittGlobalOrientedBoundary x.1.1 = 0 := by
  exact
    (deningerCalderonWittGlobalOrientedMilnorIncidence_exact x.1.1).2
      ⟨x.1, rfl⟩

/-- A continuous observation on the packet completion that vanishes on the
actual arithmetic source span is identically zero.  This is the uniqueness
half of the concrete completion presentation. -/
theorem
    deningerCalderonWittCrossPrimeContinuousObservation_eq_zero_of_sourceSpan
    {W : Type*} [NormedAddCommGroup W] [NormedSpace ℂ W]
    (B : DeningerCalderonWittCrossPrimePacketHilbert →L[ℂ] W)
    (hB : ∀ x : deningerCalderonWittCrossPrimeAlgebraicSourceSpan,
      B (deningerCalderonWittCrossPrimeSourceSpanToPacketHilbert x) = 0) :
    B = 0 := by
  apply ContinuousLinearMap.ext
  intro z
  have hfun : (fun z => B z) = (fun _ => (0 : W)) :=
    deningerCalderonWittCrossPrimeSourceSpanToPacketHilbert_denseRange.equalizer
      B.continuous continuous_const (by
        funext x
        exact hB x)
  exact congrFun hfun z

/-- Therefore every continuous extension of the old algebraic oriented
boundary to the source-faithful packet completion is the zero operator.  The
RH-bearing residual differential cannot be obtained by continuously
extending that boundary; it must introduce a horizontal/relative
transgression not already zero on the Milnor-incidence source span. -/
theorem
    deningerCalderonWittCrossPrimeContinuousOrientedBoundaryExtension_eq_zero
    {W : Type*} [NormedAddCommGroup W] [NormedSpace ℂ W]
    (F : (DeningerCalderonWittAlgebraicGlobalDegreeTwo × ℂ) →ₗ[ℂ] W)
    (B : DeningerCalderonWittCrossPrimePacketHilbert →L[ℂ] W)
    (hB : ∀ x : deningerCalderonWittCrossPrimeAlgebraicSourceSpan,
      B (deningerCalderonWittCrossPrimeSourceSpanToPacketHilbert x) =
        F (deningerCalderonWittGlobalOrientedBoundary x.1.1)) :
    B = 0 := by
  apply
    deningerCalderonWittCrossPrimeContinuousObservation_eq_zero_of_sourceSpan
  intro x
  rw [hB x,
    deningerCalderonWittGlobalOrientedBoundary_crossPrimeSourceSpan x,
    map_zero]

end

end RHTower
