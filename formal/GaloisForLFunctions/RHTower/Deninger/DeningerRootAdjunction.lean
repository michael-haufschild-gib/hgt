import GaloisForLFunctions.RHTower.Deninger.DeningerBaumslagComparison
import Mathlib.GroupTheory.PushoutI

/-!
# Adjoining a root to a single element

Baumslag's construction of the rationalization builds it as a colimit of amalgamated free products,
each step adjoining one root.  This file builds a single step: given `g` of infinite order and
`n ≥ 1`, the amalgam of `G` with an infinite cyclic group over the cyclic subgroups generated by `g`
and by the `n`-th power of the new generator.

The step is faithful — `G` embeds — and the new generator is an `n`-th root of `g`.

* `DeningerRootAdjoin` : the amalgam.
* `deningerRootAdjoin_of_injective` : `G` embeds.
* `deningerRootAdjoin_root_pow` : the new generator is an `n`-th root of `g`.
-/

namespace RHTower

open Monoid

section RootAdjunction

variable {G : Type} [Group G]

/-- The two factors of a root adjunction: the group itself and a new infinite cyclic group. -/
def DeningerRootFactor (G : Type) [Group G] : Bool → Type
  | false => G
  | true => Multiplicative ℤ

instance : ∀ b : Bool, Group (DeningerRootFactor G b)
  | false => inferInstanceAs (Group G)
  | true => inferInstanceAs (Group (Multiplicative ℤ))

/-- The two amalgamating maps: `1 ↦ g` into the group, and `1 ↦ n` into the new cyclic group. -/
def deningerRootBaseMap (g : G) (n : ℕ) :
    ∀ b : Bool, Multiplicative ℤ →* DeningerRootFactor G b
  | false => zpowersHom G g
  | true => zpowersHom (Multiplicative ℤ) (Multiplicative.ofAdd (n : ℤ))

/-- **One root adjunction.** -/
abbrev DeningerRootAdjoin (g : G) (n : ℕ) : Type :=
  Monoid.PushoutI (deningerRootBaseMap g n)

/-- The embedding of the group into the root adjunction. -/
def deningerRootAdjoinOf (g : G) (n : ℕ) : G →* DeningerRootAdjoin g n :=
  Monoid.PushoutI.of (φ := deningerRootBaseMap g n) false

/-- The adjoined root. -/
def deningerRootAdjoinRoot (g : G) (n : ℕ) : DeningerRootAdjoin g n :=
  Monoid.PushoutI.of (φ := deningerRootBaseMap g n) true (Multiplicative.ofAdd (1 : ℤ))

/-- **The adjoined generator is an `n`-th root of `g`.** -/
theorem deningerRootAdjoin_root_pow (g : G) (n : ℕ) :
    deningerRootAdjoinRoot g n ^ n = deningerRootAdjoinOf g n g := by
  have h1 : (Multiplicative.ofAdd (1 : ℤ)) ^ n = Multiplicative.ofAdd (n : ℤ) := by
    refine Multiplicative.toAdd.injective ?_
    simp
  have h2 : deningerRootBaseMap g n true (Multiplicative.ofAdd (1 : ℤ)) =
      Multiplicative.ofAdd (n : ℤ) := by
    show (Multiplicative.ofAdd (n : ℤ)) ^ (1 : ℤ) = _
    rw [zpow_one]
  have h3 : deningerRootBaseMap g n false (Multiplicative.ofAdd (1 : ℤ)) = g := by
    show g ^ (1 : ℤ) = g
    rw [zpow_one]
  calc deningerRootAdjoinRoot g n ^ n
      = Monoid.PushoutI.of (φ := deningerRootBaseMap g n) true
          ((Multiplicative.ofAdd (1 : ℤ)) ^ n) := by
        rw [deningerRootAdjoinRoot, ← map_pow]
        rfl
    _ = Monoid.PushoutI.of (φ := deningerRootBaseMap g n) true
          (deningerRootBaseMap g n true (Multiplicative.ofAdd (1 : ℤ))) := by rw [h1, h2]
    _ = Monoid.PushoutI.base (deningerRootBaseMap g n) (Multiplicative.ofAdd (1 : ℤ)) :=
        Monoid.PushoutI.of_apply_eq_base _ true _
    _ = Monoid.PushoutI.of (φ := deningerRootBaseMap g n) false
          (deningerRootBaseMap g n false (Multiplicative.ofAdd (1 : ℤ))) :=
        (Monoid.PushoutI.of_apply_eq_base _ false _).symm
    _ = deningerRootAdjoinOf g n g := by rw [h3]; rfl

/-- **The root adjunction is faithful.**  Both amalgamating maps are injective — the first because
`g` has infinite order, the second because `n` is nonzero — so the amalgam contains `G`. -/
theorem deningerRootAdjoin_of_injective (g : G) (n : ℕ) (hn : n ≠ 0)
    (hg : ∀ k : ℤ, g ^ k = 1 → k = 0) :
    Function.Injective (deningerRootAdjoinOf g n) := by
  refine Monoid.PushoutI.of_injective (fun b => ?_) false
  cases b with
  | false =>
    intro a b hab
    have hab' : g ^ Multiplicative.toAdd a = g ^ Multiplicative.toAdd b := hab
    have h : g ^ (Multiplicative.toAdd a - Multiplicative.toAdd b) = 1 := by
      rw [zpow_sub, hab']
      exact mul_inv_cancel _
    have := hg _ h
    exact Multiplicative.toAdd.injective (by omega)
  | true =>
    intro a b hab
    have hab' : (Multiplicative.ofAdd (n : ℤ)) ^ (Multiplicative.toAdd a) =
        (Multiplicative.ofAdd (n : ℤ)) ^ (Multiplicative.toAdd b) := hab
    have h : ((n : ℤ)) * Multiplicative.toAdd a = ((n : ℤ)) * Multiplicative.toAdd b := by
      have := congrArg Multiplicative.toAdd hab'
      simpa [mul_comm] using this
    have hn' : ((n : ℤ)) ≠ 0 := Int.natCast_ne_zero.2 hn
    exact Multiplicative.toAdd.injective (mul_left_cancel₀ hn' h)

end RootAdjunction

end RHTower
