import GaloisForLFunctions.RHTower.Deninger.DeningerRootCycRedCentralizer
import GaloisForLFunctions.RHTower.Deninger.DeningerRootEltCentral
import GaloisForLFunctions.RHTower.Deninger.DeningerRootEltIsolated
import GaloisForLFunctions.RHTower.Deninger.DeningerFreeGroupIsolated

/-!
# Cyclic centralizers in a root adjunction, for elements of a factor

An element of the adjoined infinite cyclic factor is a power of the adjoined root, so in a group
with unique roots its centralizer is the centralizer of the root, which is the cyclic group the root
generates.  An element of the rooted factor which is neither a power of the rooted element nor
conjugate to one has all of its centralizer inside that factor, so its centralizer is the image of
its centralizer there.

* `deningerRootElt_order` : the adjoined root has infinite order.
* `deningerOfFalse_centralizer` : the centralizer of a nontrivial element of the cyclic factor.
* `deningerOfTrue_centralizer` : the centralizer of an element of the rooted factor.
-/

namespace RHTower

open Monoid Monoid.PushoutI

universe u

namespace RootAdjunction

/-- **The adjoined root has infinite order.** -/
theorem deningerRootElt_order (A : Type u) [Group A] (a : A) (m : ℤ) (hm : m ≠ 0)
    (ha : ∀ n : ℤ, a ^ n = 1 → n = 0) :
    ∀ n : ℤ, (deningerRootElt A a m) ^ n = 1 → n = 0 := by
  intro n hn
  have hφ := deningerRootMap_injective A a m hm ha
  set g₀ : deningerRootFactor A (ULift.up false) := deningerRootGen.{u} with hg₀
  have h1 : PushoutI.of (φ := deningerRootMap A a m) (ULift.up false) (g₀ ^ n) =
      PushoutI.of (φ := deningerRootMap A a m) (ULift.up false) 1 := by
    rw [map_zpow, map_one]
    exact hn
  have h2 : g₀ ^ n = 1 := PushoutI.of_injective hφ (ULift.up false) h1
  exact deningerRootGen_order n h2

/-- **The centralizer of a nontrivial element of the adjoined cyclic factor** is the cyclic group
generated by the adjoined root. -/
theorem deningerOfFalse_centralizer (A : Type u) [Group A] (a : A) (m : ℤ)
    (hm : m ≠ 0) (hm2 : 2 ≤ m.natAbs) (ha : ∀ n : ℤ, a ^ n = 1 → n = 0)
    (hA : ∀ (x y : A) (n : ℕ), 0 < n → x ^ n = y ^ n → x = y)
    (hiso : ∀ (y : A) (n : ℕ), 0 < n → y ^ n ∈ Subgroup.zpowers a → y ∈ Subgroup.zpowers a)
    (hcentA : ∀ (x : A) (c : ℤ), c ≠ 0 → x * a ^ c * x⁻¹ = a ^ c → x ∈ Subgroup.zpowers a)
    (htorA : ∀ (x : A) (n : ℕ), 0 < n → x ^ n = 1 → x = 1)
    (v : deningerRootFactor A (ULift.up false))
    (hv : PushoutI.of (φ := deningerRootMap A a m) (ULift.up false) v ≠ 1) :
    ∀ z : PushoutI (deningerRootMap A a m),
      z * (PushoutI.of (φ := deningerRootMap A a m) (ULift.up false) v) * z⁻¹ =
        PushoutI.of (φ := deningerRootMap A a m) (ULift.up false) v ↔
        z ∈ Subgroup.zpowers (deningerRootElt A a m) := by
  have huniq : ∀ (x y : PushoutI (deningerRootMap A a m)) (n : ℕ), 0 < n →
      x ^ n = y ^ n → x = y := by
    intro x y n hn h
    refine deningerRootAdjunction_uniqueRoots A a m hm ha hA hiso hcentA htorA x y (n - 1) ?_
    rw [show n - 1 + 1 = n by omega]
    exact h
  obtain ⟨c, hc'⟩ := deningerOfFalse_mem_zpowers A a m v
  have hc : (deningerRootElt A a m) ^ c =
      PushoutI.of (φ := deningerRootMap A a m) (ULift.up false) v := hc'
  have hc0 : c ≠ 0 := by
    intro hz
    rw [hz, zpow_zero] at hc
    exact hv hc.symm
  intro z
  constructor
  · intro hz
    refine deningerRootElt_centralizer A a m hm hm2 ha z ?_
    have h1 : z * (deningerRootElt A a m) ^ c * z⁻¹ = (deningerRootElt A a m) ^ c := by
      rw [hc]
      exact hz
    have h2 := deningerCentralizer_zpow_eq huniq (deningerRootElt A a m) z c hc0 h1
    calc z * deningerRootElt A a m = z * deningerRootElt A a m * z⁻¹ * z := by group
      _ = deningerRootElt A a m * z := by rw [h2]
  · rintro ⟨k, hk'⟩
    have hk : (deningerRootElt A a m) ^ k = z := hk'
    rw [← hk, ← hc, ← zpow_neg, ← zpow_add, ← zpow_add]
    congr 1
    omega

/-- **The centralizer of an element of the rooted factor** which is neither a power of the rooted
element nor conjugate to one is the image of its centralizer in that factor. -/
theorem deningerOfTrue_centralizer (A : Type u) [Group A] (a : A) (m : ℤ)
    (hm : m ≠ 0) (ha : ∀ n : ℤ, a ^ n = 1 → n = 0)
    (x : deningerRootFactor A (ULift.up true))
    (hxrange : x ∉ (deningerRootMap A a m (ULift.up true)).range)
    (hnoesc : ¬ ∃ (x' : deningerRootFactor A (ULift.up true)) (k : ULift.{u} (Multiplicative ℤ)),
      x'⁻¹ * x * x' = deningerRootMap A a m (ULift.up true) k)
    (y₀ : deningerRootFactor A (ULift.up true)) (hy₀ : ∀ n : ℤ, y₀ ^ n = 1 → n = 0)
    (hC : ∀ w : deningerRootFactor A (ULift.up true),
      w * x * w⁻¹ = x ↔ w ∈ Subgroup.zpowers y₀) :
    (∀ n : ℤ, (PushoutI.of (φ := deningerRootMap A a m) (ULift.up true) y₀) ^ n = 1 → n = 0) ∧
      ∀ z : PushoutI (deningerRootMap A a m),
        z * (PushoutI.of (φ := deningerRootMap A a m) (ULift.up true) x) * z⁻¹ =
          PushoutI.of (φ := deningerRootMap A a m) (ULift.up true) x ↔
          z ∈ Subgroup.zpowers
            (PushoutI.of (φ := deningerRootMap A a m) (ULift.up true) y₀) := by
  classical
  obtain ⟨d⟩ := PushoutI.NormalWord.transversal_nonempty (deningerRootMap A a m)
    (deningerRootMap_injective A a m hm ha)
  have hφ := deningerRootMap_injective A a m hm ha
  refine ⟨?_, fun z => ⟨fun hz => ?_, fun hz => ?_⟩⟩
  · intro n hn
    refine hy₀ n (PushoutI.of_injective hφ (ULift.up true) ?_)
    rw [map_zpow, map_one]
    exact hn
  · have hcomm : z * PushoutI.of (φ := deningerRootMap A a m) (ULift.up true) x =
        PushoutI.of (φ := deningerRootMap A a m) (ULift.up true) x * z := by
      calc z * PushoutI.of (φ := deningerRootMap A a m) (ULift.up true) x
          = z * PushoutI.of (φ := deningerRootMap A a m) (ULift.up true) x * z⁻¹ * z := by group
        _ = PushoutI.of (φ := deningerRootMap A a m) (ULift.up true) x * z := by rw [hz]
    rcases deningerCentralizer_factor (d := d) (ULift.up true) x hxrange z hcomm with
      ⟨w, hw⟩ | ⟨x', k, hk⟩
    · have hwx : w * x * w⁻¹ = x := by
        refine PushoutI.of_injective hφ (ULift.up true) ?_
        rw [map_mul, map_mul, map_inv, ← hw]
        exact hz
      obtain ⟨n, hn'⟩ := (hC w).1 hwx
      have hn : y₀ ^ n = w := hn'
      refine ⟨n, ?_⟩
      show (PushoutI.of (φ := deningerRootMap A a m) (ULift.up true) y₀) ^ n = z
      rw [← map_zpow, hn, ← hw]
    · exact absurd ⟨x', k, hk⟩ hnoesc
  · obtain ⟨k, hk'⟩ := hz
    have hk : (PushoutI.of (φ := deningerRootMap A a m) (ULift.up true) y₀) ^ k = z := hk'
    have hy : (y₀ ^ k) * x * (y₀ ^ k)⁻¹ = x := (hC (y₀ ^ k)).2 ⟨k, rfl⟩
    rw [← hk, ← map_zpow, ← map_inv, ← map_mul, ← map_mul, hy]

end RootAdjunction

end RHTower
