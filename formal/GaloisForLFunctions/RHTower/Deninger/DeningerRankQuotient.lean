import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.Algebra.Algebra.Hom
import Mathlib.LinearAlgebra.Span.Basic

/-!
# The multiplicative rank quotient and its universal property

Killing a submodule of an algebra means dividing by the ideal it generates.  The quotient is
initial among algebra maps out of the algebra that kill the submodule: any such map factors
through it, uniquely.  A map to another algebra which already kills the submodule therefore
factors canonically, and the degree-zero ring of the quotient is the quotient ring by the ideal
generated by the image — by construction.

* `deningerRankIdeal`, `deningerRankQuotientMap` : the quotient and its structure map.
* `deningerRankQuotient_lift`, `_unique` : the universal property.
* `deningerRankQuotient_factor` : the canonical factorization.
* `deningerRankIdeal_eq_span_image` : the degree-zero identification.
-/

namespace RHTower

section RankQuotient

variable {R A M : Type*} [CommRing R] [CommRing A] [Algebra R A] [AddCommGroup M] [Module R M]

/-- The ideal generated by the image of the low-rank fibre. -/
def deningerRankIdeal (j : M →ₗ[R] A) : Ideal A := Ideal.span (Set.range j)

/-- **The degree-zero identification.**  The ideal killed is the one generated by the image of the
low-rank fibre, so the quotient ring is `A` modulo that image. -/
theorem deningerRankIdeal_eq_span_image (j : M →ₗ[R] A) :
    deningerRankIdeal j = Ideal.span (Set.range j) := rfl

theorem deningerRankIdeal_mem (j : M →ₗ[R] A) (m : M) : j m ∈ deningerRankIdeal j :=
  Ideal.subset_span ⟨m, rfl⟩

/-- The structure map of the rank quotient. -/
def deningerRankQuotientMap (j : M →ₗ[R] A) : A →ₐ[R] (A ⧸ deningerRankIdeal j) :=
  Ideal.Quotient.mkₐ R _

@[simp]
theorem deningerRankQuotientMap_apply (j : M →ₗ[R] A) (a : A) :
    deningerRankQuotientMap j a = Ideal.Quotient.mk (deningerRankIdeal j) a := rfl

/-- **The low-rank fibre dies in the quotient.** -/
theorem deningerRankQuotient_j_eq_zero (j : M →ₗ[R] A) (m : M) :
    deningerRankQuotientMap j (j m) = 0 := by
  rw [deningerRankQuotientMap_apply, Ideal.Quotient.eq_zero_iff_mem]
  exact deningerRankIdeal_mem j m

variable {T : Type*} [CommRing T] [Algebra R T]

/-- **The universal property, existence.**  An algebra map out of `A` killing the low-rank fibre
factors through the rank quotient. -/
def deningerRankQuotient_lift (j : M →ₗ[R] A) (f : A →ₐ[R] T) (hf : ∀ m, f (j m) = 0) :
    (A ⧸ deningerRankIdeal j) →ₐ[R] T :=
  Ideal.Quotient.liftₐ _ f (by
    intro a ha
    refine Submodule.span_induction ?_ ?_ ?_ ?_ ha
    · rintro _ ⟨m, rfl⟩
      exact hf m
    · exact map_zero f
    · intro x y _ _ hx hy
      rw [map_add, hx, hy, add_zero]
    · intro c x _ hx
      rw [smul_eq_mul, map_mul, hx, mul_zero])

@[simp]
theorem deningerRankQuotient_lift_mk (j : M →ₗ[R] A) (f : A →ₐ[R] T) (hf : ∀ m, f (j m) = 0)
    (a : A) :
    deningerRankQuotient_lift j f hf (Ideal.Quotient.mk (deningerRankIdeal j) a) = f a := rfl

theorem deningerRankQuotient_lift_comp (j : M →ₗ[R] A) (f : A →ₐ[R] T) (hf : ∀ m, f (j m) = 0) :
    (deningerRankQuotient_lift j f hf).comp (deningerRankQuotientMap j) = f := by
  refine AlgHom.ext fun a => ?_
  rfl

/-- **The universal property, uniqueness.**  Two algebra maps out of the rank quotient agreeing
after the structure map are equal, so the factorization is unique. -/
theorem deningerRankQuotient_unique (j : M →ₗ[R] A)
    {g h : (A ⧸ deningerRankIdeal j) →ₐ[R] T}
    (hgh : g.comp (deningerRankQuotientMap j) = h.comp (deningerRankQuotientMap j)) : g = h :=
  Ideal.Quotient.algHom_ext R hgh

/-- **The canonical factorization.**  A map to another algebra which already kills the low-rank
fibre factors canonically through the rank quotient, and the factorization is unique. -/
theorem deningerRankQuotient_factor (j : M →ₗ[R] A) {B : Type*} [CommRing B] [Algebra R B]
    (r : A →ₐ[R] B) (hr : ∀ m, r (j m) = 0) :
    ∃! s : (A ⧸ deningerRankIdeal j) →ₐ[R] B, s.comp (deningerRankQuotientMap j) = r := by
  refine ⟨deningerRankQuotient_lift j r hr, deningerRankQuotient_lift_comp j r hr, ?_⟩
  intro s hs
  refine deningerRankQuotient_unique j ?_
  rw [hs, deningerRankQuotient_lift_comp]

/-- **The arithmetic corollary `(5)`.**  If the comparison is onto and its kernel is exactly the
ideal generated by the low-rank fibre, the rank quotient is the target. -/
noncomputable def deningerRankQuotient_equivOfSurjective (j : M →ₗ[R] A) {B : Type*} [CommRing B]
    [Algebra R B] (r : A →ₐ[R] B) (hsurj : Function.Surjective r)
    (hker : RingHom.ker r = deningerRankIdeal j) :
    (A ⧸ deningerRankIdeal j) ≃ₐ[R] B :=
  (Ideal.quotientEquivAlgOfEq R hker.symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective hsurj)

end RankQuotient

end RHTower
