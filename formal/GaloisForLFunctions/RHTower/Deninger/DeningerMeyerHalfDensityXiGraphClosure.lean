import GaloisForLFunctions.RHTower.Deninger.DeningerMeyerHalfDensityL1Completion
import GaloisForLFunctions.RHTower.Deninger.DeningerMeyerLogGaussianUniversalOrbitCriterion

/-!
# Exact Xi graph closure in the Meyer half-density completion

The canonical half-density completion retains an actual zeroth Xi evaluation continuously exactly
on the critical line.  This file proves the stronger closed-relation statement.

For an actual Xi point `rho`, form the algebraic relation generated by the pairs

`(completionMk u, E_rho u)`

with `u` in literal Meyer cohomology.  On the critical line, its closed vertical fibre is zero,
because the evaluation has the already constructed continuous extension.  Off the critical line,
its closed vertical fibre is all of `ℂ`.

The off-line proof is source-explicit.  If `z = rho - 1/2`, `a = re z`, and `u_*` is the target-free
log-Gaussian class, then

`u_n = exp (-(n*a)*z) • V_(n*a) u_*`

has half-density completion norm `exp (-n*a^(2 : ℕ)) * ‖completionMk u_*‖`, hence tends to zero, while
its Xi evaluation is the fixed nonzero scalar `E_rho u_*`.  Scaling this one graph-null sequence
puts every scalar over zero in the graph closure.

Thus every closed linear relation containing the full literal-source Xi graph is maximally
multivalued off line.  In particular, an off-line evaluation admits no closed or sequentially
closable single-valued repair on the full source image.  Any successful singular admission must
restrict the source domain before half-density completion; taking a closed graph afterwards cannot
repair the defect.

All statements are unconditional.  No RH premise, numerical computation, divisor-indexed norm,
closed-range premise, or abstract admission hypothesis is used.
-/

open Complex Filter Set Topology

namespace RHTower

noncomputable section

/-- Actual zeroth Xi evaluation on literal Meyer cohomology. -/
abbrev deningerMeyerHalfDensityXiEvaluationLM (rho : XiDivisorSupport) :=
  deningerMeyerXiSupportJetEvaluationLM rho
    (⟨0, xiSupportMultiplicity_pos rho⟩ : DeningerArithmeticJetIndex rho)

/-- Algebraic Xi graph map into the canonical half-density completion times the scalar output. -/
def deningerMeyerHalfDensityXiGraphLM (rho : XiDivisorSupport) :
    DeningerMeyerStrongLogCohomology →ₗ[ℂ]
      DeningerMeyerHalfDensityCompletion × ℂ :=
  LinearMap.prod deningerMeyerHalfDensityCompletionMk
    (deningerMeyerHalfDensityXiEvaluationLM rho)

/-- Algebraic Xi evaluation graph relation on the literal source image. -/
def deningerMeyerHalfDensityXiGraph (rho : XiDivisorSupport) :
    Submodule ℂ (DeningerMeyerHalfDensityCompletion × ℂ) :=
  LinearMap.range (deningerMeyerHalfDensityXiGraphLM rho)

/-- Horizontal rate of the centered Xi character. -/
def deningerMeyerHalfDensityXiHorizontalRate (rho : XiDivisorSupport) : ℝ :=
  (rho : ℂ).re - 1 / 2

/-- Flow time that turns a nonzero horizontal rate into quadratic exponential damping. -/
def deningerMeyerHalfDensityXiGraphTime
    (rho : XiDivisorSupport) (n : ℕ) : ℝ :=
  (n : ℝ) * deningerMeyerHalfDensityXiHorizontalRate rho

/-- Explicit scaled Gaussian orbit whose completion coordinate collapses off line while its Xi
evaluation remains fixed. -/
def deningerMeyerHalfDensityXiGraphNullSequence
    (rho : XiDivisorSupport) (n : ℕ) :
    DeningerMeyerStrongLogCohomology :=
  Complex.exp
      (-((deningerMeyerHalfDensityXiGraphTime rho n : ℝ) : ℂ) *
        ((rho : ℂ) - 1 / 2)) •
    deningerMeyerStrongLogCenteredCohomologyFlow
      (deningerMeyerHalfDensityXiGraphTime rho n)
      deningerMeyerLogGaussianCohomologyClass

/-- The scaled Gaussian graph-null sequence has exactly constant Xi output. -/
theorem deningerMeyerHalfDensityXiEvaluation_graphNullSequence
    (rho : XiDivisorSupport) (n : ℕ) :
    deningerMeyerHalfDensityXiEvaluationLM rho
        (deningerMeyerHalfDensityXiGraphNullSequence rho n) =
      deningerMeyerHalfDensityXiEvaluationLM rho
        deningerMeyerLogGaussianCohomologyClass := by
  rw [deningerMeyerHalfDensityXiGraphNullSequence, map_smul,
    deningerMeyerXiSupportEvaluationLM_centeredFlow]
  change
    Complex.exp
          (-((deningerMeyerHalfDensityXiGraphTime rho n : ℝ) : ℂ) *
            ((rho : ℂ) - 1 / 2)) *
        (Complex.exp
            (((deningerMeyerHalfDensityXiGraphTime rho n : ℝ) : ℂ) *
              ((rho : ℂ) - 1 / 2)) *
          deningerMeyerHalfDensityXiEvaluationLM rho
            deningerMeyerLogGaussianCohomologyClass) =
      deningerMeyerHalfDensityXiEvaluationLM rho
        deningerMeyerLogGaussianCohomologyClass
  rw [← mul_assoc, ← Complex.exp_add]
  have hzero :
      (-((deningerMeyerHalfDensityXiGraphTime rho n : ℝ) : ℂ)) *
            ((rho : ℂ) - 1 / 2) +
          ((deningerMeyerHalfDensityXiGraphTime rho n : ℝ) : ℂ) *
            ((rho : ℂ) - 1 / 2) = 0 := by
    ring
  rw [hzero, Complex.exp_zero, one_mul]

/-- Exact exponential collapse rate of the completion coordinate. -/
theorem norm_deningerMeyerHalfDensityXiGraphNullSequence
    (rho : XiDivisorSupport) (n : ℕ) :
    ‖deningerMeyerHalfDensityCompletionMk
        (deningerMeyerHalfDensityXiGraphNullSequence rho n)‖ =
      Real.exp
          (-((n : ℝ) * deningerMeyerHalfDensityXiHorizontalRate rho ^ (2 : ℕ))) *
        ‖deningerMeyerHalfDensityCompletionMk
          deningerMeyerLogGaussianCohomologyClass‖ := by
  rw [deningerMeyerHalfDensityXiGraphNullSequence, map_smul, norm_smul,
    deningerMeyerHalfDensityCompletionMk_norm,
    deningerMeyerHalfDensityCohomologySeminorm_centeredFlow,
    ← deningerMeyerHalfDensityCompletionMk_norm, Complex.norm_exp]
  congr 2
  simp only [Complex.mul_re, Complex.neg_re, Complex.neg_im,
    Complex.ofReal_re, Complex.ofReal_im, Complex.sub_re,
    Complex.div_ofNat_re, Complex.one_re]
  rw [deningerMeyerHalfDensityXiGraphTime,
    deningerMeyerHalfDensityXiHorizontalRate]
  ring

/-- Off line, the explicit Gaussian sequence converges to zero in the canonical completion. -/
theorem deningerMeyerHalfDensityXiGraphNullSequence_tendsto_zero
    (rho : XiDivisorSupport) (hrho : (rho : ℂ).re ≠ 1 / 2) :
    Tendsto
      (fun n => deningerMeyerHalfDensityCompletionMk
        (deningerMeyerHalfDensityXiGraphNullSequence rho n))
      atTop (𝓝 0) := by
  rw [tendsto_zero_iff_norm_tendsto_zero]
  have hrate : deningerMeyerHalfDensityXiHorizontalRate rho ≠ 0 := by
    rw [deningerMeyerHalfDensityXiHorizontalRate]
    exact sub_ne_zero.mpr hrho
  have hrateSq : 0 < deningerMeyerHalfDensityXiHorizontalRate rho ^ (2 : ℕ) :=
    sq_pos_of_ne_zero hrate
  have htop :
      Tendsto
        (fun n : ℕ =>
          (n : ℝ) * deningerMeyerHalfDensityXiHorizontalRate rho ^ (2 : ℕ))
        atTop atTop :=
    tendsto_natCast_atTop_atTop.atTop_mul_const hrateSq
  have hdecay :
      Tendsto
        (fun n : ℕ => Real.exp
          (-((n : ℝ) * deningerMeyerHalfDensityXiHorizontalRate rho ^ (2 : ℕ))))
        atTop (𝓝 0) :=
    Real.tendsto_exp_atBot.comp (tendsto_neg_atTop_atBot.comp htop)
  have hmul := hdecay.const_mul
    ‖deningerMeyerHalfDensityCompletionMk
      deningerMeyerLogGaussianCohomologyClass‖
  simpa only [norm_deningerMeyerHalfDensityXiGraphNullSequence,
    mul_zero, zero_mul, mul_comm] using hmul

/-- The nonzero Gaussian Xi output occurs vertically in the off-line graph closure. -/
theorem deningerMeyerHalfDensityXiGraph_gaussianVertical_mem_topologicalClosure
    (rho : XiDivisorSupport) (hrho : (rho : ℂ).re ≠ 1 / 2) :
    ((0 : DeningerMeyerHalfDensityCompletion),
        deningerMeyerHalfDensityXiEvaluationLM rho
          deningerMeyerLogGaussianCohomologyClass) ∈
      (deningerMeyerHalfDensityXiGraph rho).topologicalClosure := by
  change
    ((0 : DeningerMeyerHalfDensityCompletion),
        deningerMeyerHalfDensityXiEvaluationLM rho
          deningerMeyerLogGaussianCohomologyClass) ∈
      closure (deningerMeyerHalfDensityXiGraph rho : Set
        (DeningerMeyerHalfDensityCompletion × ℂ))
  apply mem_closure_of_tendsto
    ((deningerMeyerHalfDensityXiGraphNullSequence_tendsto_zero rho hrho).prodMk_nhds
      (tendsto_const_nhds : Tendsto
        (fun _ : ℕ => deningerMeyerHalfDensityXiEvaluationLM rho
          deningerMeyerLogGaussianCohomologyClass)
        atTop (𝓝 (deningerMeyerHalfDensityXiEvaluationLM rho
          deningerMeyerLogGaussianCohomologyClass))))
  filter_upwards with n
  refine ⟨deningerMeyerHalfDensityXiGraphNullSequence rho n, ?_⟩
  apply Prod.ext
  · rfl
  · exact deningerMeyerHalfDensityXiEvaluation_graphNullSequence rho n

/-- **Off-line maximal verticality.** Every scalar lies over zero in the closed Xi relation. -/
theorem deningerMeyerHalfDensityXiGraph_fullVertical_of_offline
    (rho : XiDivisorSupport) (hrho : (rho : ℂ).re ≠ 1 / 2)
    (y : ℂ) :
    ((0 : DeningerMeyerHalfDensityCompletion), y) ∈
      (deningerMeyerHalfDensityXiGraph rho).topologicalClosure := by
  have hbase :=
    deningerMeyerHalfDensityXiGraph_gaussianVertical_mem_topologicalClosure
      rho hrho
  have hne :=
    deningerMeyerLogGaussianCohomologyClass_evaluation_ne_zero rho
  have hsmul :=
    (deningerMeyerHalfDensityXiGraph rho).topologicalClosure.smul_mem
      (y / deningerMeyerHalfDensityXiEvaluationLM rho
        deningerMeyerLogGaussianCohomologyClass) hbase
  have hy :
      y / deningerMeyerHalfDensityXiEvaluationLM rho
            deningerMeyerLogGaussianCohomologyClass *
          deningerMeyerHalfDensityXiEvaluationLM rho
            deningerMeyerLogGaussianCohomologyClass = y :=
    div_mul_cancel₀ y hne
  change
    ((y / deningerMeyerHalfDensityXiEvaluationLM rho
          deningerMeyerLogGaussianCohomologyClass) •
        (0 : DeningerMeyerHalfDensityCompletion),
      (y / deningerMeyerHalfDensityXiEvaluationLM rho
          deningerMeyerLogGaussianCohomologyClass) *
        deningerMeyerHalfDensityXiEvaluationLM rho
          deningerMeyerLogGaussianCohomologyClass) ∈
      (deningerMeyerHalfDensityXiGraph rho).topologicalClosure at hsmul
  rw [smul_zero, hy] at hsmul
  exact hsmul

/-- Continuous graph defect whose kernel is the graph of the critical Xi extension. -/
def deningerMeyerHalfDensityCriticalXiGraphDefectCLM
    (rho : XiDivisorSupport) (hrho : (rho : ℂ).re = 1 / 2) :
    (DeningerMeyerHalfDensityCompletion × ℂ) →L[ℂ] ℂ :=
  (deningerMeyerHalfDensityXiEvaluationCLM rho hrho).comp
      (ContinuousLinearMap.fst ℂ DeningerMeyerHalfDensityCompletion ℂ) -
    ContinuousLinearMap.snd ℂ DeningerMeyerHalfDensityCompletion ℂ

/-- The algebraic critical Xi graph lies in the closed graph of its continuous extension. -/
theorem deningerMeyerHalfDensityXiGraph_le_criticalGraphDefect_ker
    (rho : XiDivisorSupport) (hrho : (rho : ℂ).re = 1 / 2) :
    deningerMeyerHalfDensityXiGraph rho ≤
      LinearMap.ker
        (deningerMeyerHalfDensityCriticalXiGraphDefectCLM rho hrho).toLinearMap := by
  rintro _ ⟨u, rfl⟩
  change
    deningerMeyerHalfDensityXiEvaluationCLM rho hrho
        (deningerMeyerHalfDensityCompletionMk u) -
      deningerMeyerHalfDensityXiEvaluationLM rho u = 0
  rw [deningerMeyerHalfDensityXiEvaluationCLM_mk]
  exact sub_self _

/-- **Critical single-valuedness.** The closed Xi relation has zero vertical fibre on line. -/
theorem deningerMeyerHalfDensityXiGraph_vertical_eq_zero_of_critical
    (rho : XiDivisorSupport) (hrho : (rho : ℂ).re = 1 / 2)
    {y : ℂ}
    (hy : ((0 : DeningerMeyerHalfDensityCompletion), y) ∈
      (deningerMeyerHalfDensityXiGraph rho).topologicalClosure) :
    y = 0 := by
  have hclosure :
      (deningerMeyerHalfDensityXiGraph rho).topologicalClosure ≤
        LinearMap.ker
          (deningerMeyerHalfDensityCriticalXiGraphDefectCLM rho hrho).toLinearMap :=
    Submodule.topologicalClosure_minimal _
      (deningerMeyerHalfDensityXiGraph_le_criticalGraphDefect_ker rho hrho)
      (ContinuousLinearMap.isClosed_ker
        (deningerMeyerHalfDensityCriticalXiGraphDefectCLM rho hrho))
  have hker := hclosure hy
  change deningerMeyerHalfDensityXiEvaluationCLM rho hrho 0 - y = 0 at hker
  simpa using hker.symm

/-- Every closed linear relation retaining the full off-line algebraic Xi graph is maximally
vertical. -/
theorem deningerMeyerHalfDensityXiGraph_closedRelation_fullVertical_of_offline
    (rho : XiDivisorSupport) (hrho : (rho : ℂ).re ≠ 1 / 2)
    (R : Submodule ℂ (DeningerMeyerHalfDensityCompletion × ℂ))
    (hRclosed : IsClosed (R : Set
      (DeningerMeyerHalfDensityCompletion × ℂ)))
    (hgraph : deningerMeyerHalfDensityXiGraph rho ≤ R)
    (y : ℂ) :
    ((0 : DeningerMeyerHalfDensityCompletion), y) ∈ R := by
  have hclosure :
      (deningerMeyerHalfDensityXiGraph rho).topologicalClosure ≤ R :=
    Submodule.topologicalClosure_minimal _ hgraph hRclosed
  exact hclosure
    (deningerMeyerHalfDensityXiGraph_fullVertical_of_offline rho hrho y)

/-- No closed single-valued relation can contain the full literal-source graph of an off-line Xi
evaluation. -/
theorem deningerMeyerHalfDensityXiGraph_no_closed_singleValued_extension_of_offline
    (rho : XiDivisorSupport) (hrho : (rho : ℂ).re ≠ 1 / 2) :
    ¬ ∃ R : Submodule ℂ (DeningerMeyerHalfDensityCompletion × ℂ),
      IsClosed (R : Set (DeningerMeyerHalfDensityCompletion × ℂ)) ∧
      deningerMeyerHalfDensityXiGraph rho ≤ R ∧
      ∀ y : ℂ, ((0 : DeningerMeyerHalfDensityCompletion), y) ∈ R → y = 0 := by
  rintro ⟨R, hRclosed, hgraph, hsingle⟩
  have hone :=
    deningerMeyerHalfDensityXiGraph_closedRelation_fullVertical_of_offline
      rho hrho R hRclosed hgraph 1
  exact one_ne_zero (hsingle 1 hone)

/-- Exact closed-relation spectrum: the canonical Xi graph closure is single-valued over zero
exactly on the critical line. -/
theorem deningerMeyerHalfDensityXiGraph_singleValuedClosure_iff
    (rho : XiDivisorSupport) :
    (∀ y : ℂ,
        ((0 : DeningerMeyerHalfDensityCompletion), y) ∈
            (deningerMeyerHalfDensityXiGraph rho).topologicalClosure →
          y = 0) ↔
      (rho : ℂ).re = 1 / 2 := by
  constructor
  · intro hsingle
    by_contra hrho
    have hone :=
      deningerMeyerHalfDensityXiGraph_fullVertical_of_offline rho hrho 1
    exact one_ne_zero (hsingle 1 hone)
  · intro hrho y hy
    exact deningerMeyerHalfDensityXiGraph_vertical_eq_zero_of_critical
      rho hrho hy

/-- Sequential closability of the actual Xi evaluation through the canonical half-density
completion map. -/
def DeningerMeyerHalfDensityXiSequentiallyClosable
    (rho : XiDivisorSupport) : Prop :=
  ∀ u : ℕ → DeningerMeyerStrongLogCohomology,
    Tendsto
      (fun n => deningerMeyerHalfDensityCompletionMk (u n))
      atTop (𝓝 0) →
    ∀ y : ℂ,
      Tendsto
        (fun n => deningerMeyerHalfDensityXiEvaluationLM rho (u n))
        atTop (𝓝 y) →
      y = 0

/-- Critical Xi evaluation is sequentially closable because it extends continuously. -/
theorem deningerMeyerHalfDensityXiSequentiallyClosable_of_critical
    (rho : XiDivisorSupport) (hrho : (rho : ℂ).re = 1 / 2) :
    DeningerMeyerHalfDensityXiSequentiallyClosable rho := by
  intro u hu y hy
  let F := deningerMeyerHalfDensityXiEvaluationCLM rho hrho
  have hF : Tendsto
      (fun n => F (deningerMeyerHalfDensityCompletionMk (u n)))
      atTop (𝓝 0) := by
    simpa [Function.comp_def] using
      F.continuous.continuousAt.tendsto.comp hu
  have hEq :
      (fun n => F (deningerMeyerHalfDensityCompletionMk (u n))) =
        fun n => deningerMeyerHalfDensityXiEvaluationLM rho (u n) := by
    funext n
    exact deningerMeyerHalfDensityXiEvaluationCLM_mk rho hrho (u n)
  rw [hEq] at hF
  exact tendsto_nhds_unique hy hF

/-- Off-line Xi evaluation is not sequentially closable; the explicit Gaussian graph-null
sequence witnesses failure. -/
theorem deningerMeyerHalfDensityXi_not_sequentiallyClosable_of_offline
    (rho : XiDivisorSupport) (hrho : (rho : ℂ).re ≠ 1 / 2) :
    ¬ DeningerMeyerHalfDensityXiSequentiallyClosable rho := by
  intro hclose
  have hzero := hclose
    (deningerMeyerHalfDensityXiGraphNullSequence rho)
    (deningerMeyerHalfDensityXiGraphNullSequence_tendsto_zero rho hrho)
    (deningerMeyerHalfDensityXiEvaluationLM rho
      deningerMeyerLogGaussianCohomologyClass)
    (by simpa only [deningerMeyerHalfDensityXiEvaluation_graphNullSequence]
      using (tendsto_const_nhds : Tendsto
        (fun _ : ℕ => deningerMeyerHalfDensityXiEvaluationLM rho
          deningerMeyerLogGaussianCohomologyClass)
        atTop (𝓝 (deningerMeyerHalfDensityXiEvaluationLM rho
          deningerMeyerLogGaussianCohomologyClass))))
  exact deningerMeyerLogGaussianCohomologyClass_evaluation_ne_zero rho hzero

/-- **Exact closability spectrum.** The actual Xi evaluation is closable through the canonical
source completion exactly on the critical line. -/
theorem deningerMeyerHalfDensityXiSequentiallyClosable_iff
    (rho : XiDivisorSupport) :
    DeningerMeyerHalfDensityXiSequentiallyClosable rho ↔
      (rho : ℂ).re = 1 / 2 := by
  constructor
  · intro hclose
    by_contra hrho
    exact deningerMeyerHalfDensityXi_not_sequentiallyClosable_of_offline
      rho hrho hclose
  · exact deningerMeyerHalfDensityXiSequentiallyClosable_of_critical rho

/-- Global source-graph reformulation: every actual Xi evaluation is sequentially closable through
the one canonical half-density completion exactly when RH holds. -/
theorem riemannHypothesis_iff_deningerMeyerHalfDensityXiSequentiallyClosable :
    RiemannHypothesis ↔
      ∀ rho : XiDivisorSupport,
        DeningerMeyerHalfDensityXiSequentiallyClosable rho := by
  constructor
  · intro hRH rho
    rw [deningerMeyerHalfDensityXiSequentiallyClosable_iff]
    have hbounded :=
      (riemannHypothesis_iff_deningerMeyerHalfDensityXiEvaluationsBounded.mp
        hRH) rho
    exact deningerMeyerHalfDensityXiEvaluationBounded_iff rho |>.mp hbounded
  · intro hclose
    rw [riemannHypothesis_iff_deningerMeyerHalfDensityXiEvaluationsBounded]
    intro rho
    rw [deningerMeyerHalfDensityXiEvaluationBounded_iff]
    exact deningerMeyerHalfDensityXiSequentiallyClosable_iff rho |>.mp
      (hclose rho)

end

end RHTower
