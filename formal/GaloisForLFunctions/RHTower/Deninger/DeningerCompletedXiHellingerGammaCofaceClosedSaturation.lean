import GaloisForLFunctions.RHTower.Deninger.DeningerCalderonWittCompletedXiHellingerGammaPureHodgeCoface

/-!
# Closed saturation of the completed Hellinger--Gamma coface

The raw completed Hellinger--Gamma coface recovers every completed Xi
incidence vector in the ordinary product norm.  This file computes the
closed submodule generated by all adjacent coface ranges.

There is an exact phase transition.  At zero modular displacement the
closed coface span is precisely the diagonal channel.  At every nonzero
displacement it is the entire two-channel completion.  The proof uses the
cofinal telescoping limit to recover grade zero and the nonzero determinant
of grades zero and one to separate both channels.

Consequently the off-critical relative coface quotient is zero.  At the
critical displacement the raw depth-zero recovery does not descend through
the diagonal quotient.  Thus the current completed coend cannot supply an
injective relative-admission transport at any displacement; a replacement
differential must retain an additional source-provenance channel.
-/

open Complex Set Finset Filter Topology
open scoped BigOperators

namespace RHTower

noncomputable section

open PrimitivePromotedHellingerGammaPureHodgeCoface
open CompletedXiHellingerGammaPureHodgeCoface

def hellingerGammaCompletedCofaceDifference
    {p q : Nat.Primes} {hpq : p ≠ q} :
    HellingerGammaPureHodgeXiCofaceCompletion p q hpq →L[ℂ]
      DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq :=
  ContinuousLinearMap.fst ℂ
      (DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq)
      (DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq) -
    ContinuousLinearMap.snd ℂ
      (DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq)
      (DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq)

def hellingerGammaCompletedCofaceDiagonal
    {p q : Nat.Primes} {hpq : p ≠ q} :
    Submodule ℂ (HellingerGammaPureHodgeXiCofaceCompletion p q hpq) :=
  hellingerGammaCompletedCofaceDifference.ker

@[simp]
theorem mem_hellingerGammaCompletedCofaceDiagonal
    {p q : Nat.Primes} {hpq : p ≠ q}
    (z : HellingerGammaPureHodgeXiCofaceCompletion p q hpq) :
    z ∈ hellingerGammaCompletedCofaceDiagonal ↔ z.1 = z.2 := by
  simp [hellingerGammaCompletedCofaceDiagonal,
    hellingerGammaCompletedCofaceDifference]
  exact sub_eq_zero

theorem hellingerGammaCompletedCofaceDiagonal_isClosed
    {p q : Nat.Primes} {hpq : p ≠ q} :
    IsClosed
      (hellingerGammaCompletedCofaceDiagonal (p := p) (q := q)
        (hpq := hpq) :
        Set (HellingerGammaPureHodgeXiCofaceCompletion p q hpq)) :=
  hellingerGammaCompletedCofaceDifference.isClosed_ker

def hellingerGammaCompletedAdjacentCofaceSet
    {p q : Nat.Primes} (hpq : p ≠ q) (a : ℝ) :
    Set (HellingerGammaPureHodgeXiCofaceCompletion p q hpq) :=
  {z | ∃ (n : ℕ)
      (x : DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq),
    z = hellingerGammaCompletedAdjacentCoface hpq a n x}

def hellingerGammaCompletedAdjacentCofaceClosedSpan
    {p q : Nat.Primes} (hpq : p ≠ q) (a : ℝ) :
    Submodule ℂ (HellingerGammaPureHodgeXiCofaceCompletion p q hpq) :=
  (Submodule.span ℂ (hellingerGammaCompletedAdjacentCofaceSet hpq a)).topologicalClosure

theorem hellingerGammaCompletedAdjacentCoface_mem_closedSpan
    {p q : Nat.Primes} (hpq : p ≠ q) (a : ℝ) (n : ℕ)
    (x : DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq) :
    hellingerGammaCompletedAdjacentCoface hpq a n x ∈
      hellingerGammaCompletedAdjacentCofaceClosedSpan hpq a := by
  exact
    (Submodule.span ℂ (hellingerGammaCompletedAdjacentCofaceSet hpq a)).le_topologicalClosure
      (Submodule.subset_span ⟨n, x, rfl⟩)

theorem hellingerGammaGaugedModularCoefficient_neg_zero
    (a : ℝ) (p q : Nat.Primes) :
    hellingerGammaGaugedModularCoefficient (-a) p q 0 =
      Real.exp (a * (Real.log (p : ℝ) + Real.log (q : ℝ))) := by
  rw [hellingerGammaGaugedModularCoefficient,
    hellingerEvenGammaResidueGauge]
  norm_num [xiGammaEulerPrimitiveModularRate,
    criticalPrimeTowerRadius_log]
  ring

theorem hellingerGammaGaugedModularCoefficient_zero
    (a : ℝ) (p q : Nat.Primes) :
    hellingerGammaGaugedModularCoefficient a p q 0 =
      Real.exp (-a * (Real.log (p : ℝ) + Real.log (q : ℝ))) := by
  rw [hellingerGammaGaugedModularCoefficient,
    hellingerEvenGammaResidueGauge]
  norm_num [xiGammaEulerPrimitiveModularRate,
    criticalPrimeTowerRadius_log]
  ring

theorem hellingerGammaGaugedModularCoefficient_neg_one
    (a : ℝ) (p q : Nat.Primes) :
    hellingerGammaGaugedModularCoefficient (-a) p q 1 =
      (1 / 2 : ℝ) *
        Real.exp (2 * a * (Real.log (p : ℝ) + Real.log (q : ℝ))) := by
  rw [hellingerGammaGaugedModularCoefficient,
    hellingerEvenGammaResidueGauge]
  norm_num [xiGammaEulerPrimitiveModularRate,
    criticalPrimeTowerRadius_log]
  ring

theorem hellingerGammaGaugedModularCoefficient_one
    (a : ℝ) (p q : Nat.Primes) :
    hellingerGammaGaugedModularCoefficient a p q 1 =
      (1 / 2 : ℝ) *
        Real.exp (-2 * a * (Real.log (p : ℝ) + Real.log (q : ℝ))) := by
  rw [hellingerGammaGaugedModularCoefficient,
    hellingerEvenGammaResidueGauge]
  norm_num [xiGammaEulerPrimitiveModularRate,
    criticalPrimeTowerRadius_log]
  ring

def hellingerGammaCompletedFirstTwoDeterminant
    (a : ℝ) (p q : Nat.Primes) : ℝ :=
  hellingerGammaGaugedModularCoefficient (-a) p q 0 *
      hellingerGammaGaugedModularCoefficient a p q 1 -
    hellingerGammaGaugedModularCoefficient (-a) p q 1 *
      hellingerGammaGaugedModularCoefficient a p q 0

theorem hellingerGammaCompletedFirstTwoDeterminant_ne_zero
    {a : ℝ} (ha : a ≠ 0) (p q : Nat.Primes) :
    hellingerGammaCompletedFirstTwoDeterminant a p q ≠ 0 := by
  have hp : 0 < Real.log (p : ℝ) :=
    Real.log_pos (by exact_mod_cast p.property.one_lt)
  have hq : 0 < Real.log (q : ℝ) :=
    Real.log_pos (by exact_mod_cast q.property.one_lt)
  let L : ℝ := Real.log (p : ℝ) + Real.log (q : ℝ)
  have hL : 0 < L := by
    dsimp only [L]
    positivity
  rw [hellingerGammaCompletedFirstTwoDeterminant,
    hellingerGammaGaugedModularCoefficient_neg_zero,
    hellingerGammaGaugedModularCoefficient_zero,
    hellingerGammaGaugedModularCoefficient_neg_one,
    hellingerGammaGaugedModularCoefficient_one]
  change
    Real.exp (a * L) * (1 / 2 * Real.exp (-2 * a * L)) -
        1 / 2 * Real.exp (2 * a * L) * Real.exp (-a * L) ≠ 0
  have hprod1 :
      Real.exp (a * L) * Real.exp (-2 * a * L) =
        Real.exp (-a * L) := by
    rw [← Real.exp_add]
    congr 1
    ring
  have hprod2 :
      Real.exp (2 * a * L) * Real.exp (-a * L) =
        Real.exp (a * L) := by
    rw [← Real.exp_add]
    congr 1
    ring
  rw [show
    Real.exp (a * L) * (1 / 2 * Real.exp (-2 * a * L)) -
        1 / 2 * Real.exp (2 * a * L) * Real.exp (-a * L) =
      1 / 2 *
        (Real.exp (a * L) * Real.exp (-2 * a * L) -
          Real.exp (2 * a * L) * Real.exp (-a * L)) by ring,
    hprod1, hprod2]
  intro hzero
  have heq : Real.exp (-a * L) = Real.exp (a * L) := by
    nlinarith
  have harg : -a * L = a * L := Real.exp_injective heq
  have haL : a * L = 0 := by linarith
  exact ha ((mul_eq_zero.mp haL).resolve_right hL.ne')

theorem hellingerGammaCompletedBalancedPrimitive_mem_of_closed_cofaces
    {p q : Nat.Primes} (hpq : p ≠ q) (a : ℝ)
    (A : Submodule ℂ (HellingerGammaPureHodgeXiCofaceCompletion p q hpq))
    (hAclosed : IsClosed
      (A : Set (HellingerGammaPureHodgeXiCofaceCompletion p q hpq)))
    (hcoface : ∀ (n : ℕ)
      (x : DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq),
      hellingerGammaCompletedAdjacentCoface hpq a n x ∈ A)
    (x : DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq) :
    hellingerGammaCompletedBalancedPrimitive hpq a 0 x ∈ A := by
  have hpartial : ∀ N : ℕ,
      (∑ n ∈ Finset.range N,
        hellingerGammaCompletedAdjacentCoface hpq a n x) ∈ A := by
    intro N
    exact Submodule.sum_mem A fun n _ => hcoface n x
  have hneg : -hellingerGammaCompletedBalancedPrimitive hpq a 0 x ∈ A :=
    hAclosed.mem_of_tendsto
      (sum_hellingerGammaCompletedAdjacentCoface_tendsto hpq a x)
      (Filter.Eventually.of_forall hpartial)
  simpa only [neg_neg] using A.neg_mem hneg

theorem hellingerGammaCompletedBalancedPrimitive_one_mem_of_closed_cofaces
    {p q : Nat.Primes} (hpq : p ≠ q) (a : ℝ)
    (A : Submodule ℂ (HellingerGammaPureHodgeXiCofaceCompletion p q hpq))
    (hAclosed : IsClosed
      (A : Set (HellingerGammaPureHodgeXiCofaceCompletion p q hpq)))
    (hcoface : ∀ (n : ℕ)
      (x : DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq),
      hellingerGammaCompletedAdjacentCoface hpq a n x ∈ A)
    (x : DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq) :
    hellingerGammaCompletedBalancedPrimitive hpq a 1 x ∈ A := by
  have hzero := hellingerGammaCompletedBalancedPrimitive_mem_of_closed_cofaces
    hpq a A hAclosed hcoface x
  have hedge := hcoface 0 x
  simpa [hellingerGammaCompletedAdjacentCoface] using A.add_mem hedge hzero

theorem hellingerGammaCompletedAdjacentCoface_closedSaturation_eq_top
    {p q : Nat.Primes} (hpq : p ≠ q) {a : ℝ} (ha : a ≠ 0)
    (A : Submodule ℂ (HellingerGammaPureHodgeXiCofaceCompletion p q hpq))
    (hAclosed : IsClosed
      (A : Set (HellingerGammaPureHodgeXiCofaceCompletion p q hpq)))
    (hcoface : ∀ (n : ℕ)
      (x : DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq),
      hellingerGammaCompletedAdjacentCoface hpq a n x ∈ A) :
    A = ⊤ := by
  apply top_unique
  rintro z
  let c0m : ℂ := hellingerGammaGaugedModularCoefficient (-a) p q 0
  let c0p : ℂ := hellingerGammaGaugedModularCoefficient a p q 0
  let c1m : ℂ := hellingerGammaGaugedModularCoefficient (-a) p q 1
  let c1p : ℂ := hellingerGammaGaugedModularCoefficient a p q 1
  let D : ℂ := c0m * c1p - c1m * c0p
  have hD : D ≠ 0 := by
    dsimp only [D, c0m, c0p, c1m, c1p]
    exact_mod_cast hellingerGammaCompletedFirstTwoDeterminant_ne_zero ha p q
  have hB0fst := hellingerGammaCompletedBalancedPrimitive_mem_of_closed_cofaces
    hpq a A hAclosed hcoface z.1
  have hB1fst := hellingerGammaCompletedBalancedPrimitive_one_mem_of_closed_cofaces
    hpq a A hAclosed hcoface z.1
  have hfst : (z.1, 0) ∈ A := by
    have hlin := A.sub_mem (A.smul_mem c1p hB0fst) (A.smul_mem c0p hB1fst)
    have hinv := A.smul_mem D⁻¹ hlin
    have helem :
        D⁻¹ •
            (c1p • hellingerGammaCompletedBalancedPrimitive hpq a 0 z.1 -
              c0p • hellingerGammaCompletedBalancedPrimitive hpq a 1 z.1) =
          (z.1, 0) := by
      apply Prod.ext
      · change
          D⁻¹ • (c1p • (c0m • z.1) - c0p • (c1m • z.1)) = z.1
        rw [smul_smul, smul_smul, ← sub_smul, smul_smul]
        have hcoeff : c1p * c0m - c0p * c1m = D := by
          dsimp only [D]
          ring
        rw [hcoeff, inv_mul_cancel₀ hD, one_smul]
      · change
          D⁻¹ • (c1p • (c0p • z.1) - c0p • (c1p • z.1)) = 0
        rw [smul_smul, smul_smul]
        have hcoeff : c1p * c0p - c0p * c1p = 0 := by ring
        rw [← sub_smul, hcoeff, zero_smul, smul_zero]
    rw [helem] at hinv
    exact hinv
  have hB0snd := hellingerGammaCompletedBalancedPrimitive_mem_of_closed_cofaces
    hpq a A hAclosed hcoface z.2
  have hB1snd := hellingerGammaCompletedBalancedPrimitive_one_mem_of_closed_cofaces
    hpq a A hAclosed hcoface z.2
  have hsnd : (0, z.2) ∈ A := by
    have hlin := A.sub_mem (A.smul_mem c0m hB1snd) (A.smul_mem c1m hB0snd)
    have hinv := A.smul_mem D⁻¹ hlin
    have helem :
        D⁻¹ •
            (c0m • hellingerGammaCompletedBalancedPrimitive hpq a 1 z.2 -
              c1m • hellingerGammaCompletedBalancedPrimitive hpq a 0 z.2) =
          (0, z.2) := by
      apply Prod.ext
      · change
          D⁻¹ • (c0m • (c1m • z.2) - c1m • (c0m • z.2)) = 0
        rw [smul_smul, smul_smul]
        have hcoeff : c0m * c1m - c1m * c0m = 0 := by ring
        rw [← sub_smul, hcoeff, zero_smul, smul_zero]
      · change
          D⁻¹ • (c0m • (c1p • z.2) - c1m • (c0p • z.2)) = z.2
        rw [smul_smul, smul_smul, ← sub_smul, smul_smul]
        have hcoeff : c0m * c1p - c1m * c0p = D := by
          rfl
        rw [hcoeff, inv_mul_cancel₀ hD, one_smul]
    rw [helem] at hinv
    exact hinv
  simpa using A.add_mem hfst hsnd

theorem hellingerGammaCompletedAdjacentCofaceClosedSpan_eq_top
    {p q : Nat.Primes} (hpq : p ≠ q) {a : ℝ} (ha : a ≠ 0) :
    hellingerGammaCompletedAdjacentCofaceClosedSpan hpq a = ⊤ := by
  apply hellingerGammaCompletedAdjacentCoface_closedSaturation_eq_top hpq ha
  · exact Submodule.isClosed_topologicalClosure _
  · exact fun n x => hellingerGammaCompletedAdjacentCoface_mem_closedSpan hpq a n x

theorem hellingerGammaCompletedAdjacentCoface_zero_mem_diagonal
    {p q : Nat.Primes} (hpq : p ≠ q) (n : ℕ)
    (x : DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq) :
    hellingerGammaCompletedAdjacentCoface hpq 0 n x ∈
      hellingerGammaCompletedCofaceDiagonal := by
  rw [mem_hellingerGammaCompletedCofaceDiagonal]
  simp [hellingerGammaCompletedAdjacentCoface,
    hellingerGammaCompletedBalancedPrimitive,
    hellingerGammaGaugedModularCoefficient]

theorem hellingerGammaCompletedAdjacentCofaceClosedSpan_zero_le_diagonal
    {p q : Nat.Primes} (hpq : p ≠ q) :
    hellingerGammaCompletedAdjacentCofaceClosedSpan hpq 0 ≤
      hellingerGammaCompletedCofaceDiagonal := by
  apply Submodule.topologicalClosure_minimal
  · rw [Submodule.span_le]
    rintro z ⟨n, x, rfl⟩
    exact hellingerGammaCompletedAdjacentCoface_zero_mem_diagonal hpq n x
  · exact hellingerGammaCompletedCofaceDiagonal_isClosed

theorem hellingerGammaCompletedAdjacentCoface_zero_zero_scaled
    {p q : Nat.Primes} (hpq : p ≠ q)
    (x : DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq) :
    hellingerGammaCompletedAdjacentCoface hpq 0 0 ((-2 : ℂ) • x) =
      (x, x) := by
  apply Prod.ext <;>
    simp [hellingerGammaCompletedAdjacentCoface,
      hellingerGammaCompletedBalancedPrimitive,
      hellingerGammaGaugedModularCoefficient,
      hellingerEvenGammaResidueGauge, smul_smul] <;>
    module

theorem hellingerGammaCompletedCofaceDiagonal_le_closedSpan_zero
    {p q : Nat.Primes} (hpq : p ≠ q) :
    hellingerGammaCompletedCofaceDiagonal ≤
      hellingerGammaCompletedAdjacentCofaceClosedSpan hpq 0 := by
  intro z hz
  have hzEq : z.1 = z.2 :=
    (mem_hellingerGammaCompletedCofaceDiagonal z).mp hz
  have hgen :=
    hellingerGammaCompletedAdjacentCoface_mem_closedSpan hpq 0 0
      ((-2 : ℂ) • z.1)
  rw [hellingerGammaCompletedAdjacentCoface_zero_zero_scaled] at hgen
  rcases z with ⟨x, y⟩
  change x = y at hzEq
  subst y
  exact hgen

theorem hellingerGammaCompletedAdjacentCofaceClosedSpan_zero
    {p q : Nat.Primes} (hpq : p ≠ q) :
    hellingerGammaCompletedAdjacentCofaceClosedSpan hpq 0 =
      hellingerGammaCompletedCofaceDiagonal :=
  le_antisymm
    (hellingerGammaCompletedAdjacentCofaceClosedSpan_zero_le_diagonal hpq)
    (hellingerGammaCompletedCofaceDiagonal_le_closedSpan_zero hpq)

theorem hellingerGammaCompletedAdjacentCofaceClosedSpan_phase
    {p q : Nat.Primes} (hpq : p ≠ q) (a : ℝ) :
    hellingerGammaCompletedAdjacentCofaceClosedSpan hpq a =
      if a = 0 then hellingerGammaCompletedCofaceDiagonal else ⊤ := by
  by_cases ha : a = 0
  · subst a
    rw [if_pos rfl]
    exact hellingerGammaCompletedAdjacentCofaceClosedSpan_zero hpq
  · rw [if_neg ha]
    exact hellingerGammaCompletedAdjacentCofaceClosedSpan_eq_top hpq ha

theorem hellingerGammaCompletedAdjacentCofaceClosedSpan_antidiagonal_mem_iff
    {p q : Nat.Primes} (hpq : p ≠ q)
    (x : DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq) :
    (x, -x) ∈ hellingerGammaCompletedAdjacentCofaceClosedSpan hpq 0 ↔
      x = 0 := by
  rw [hellingerGammaCompletedAdjacentCofaceClosedSpan_zero,
    mem_hellingerGammaCompletedCofaceDiagonal]
  constructor
  · intro h
    change x = -x at h
    have htwo : (2 : ℂ) • x = 0 := by
      rw [two_smul]
      nth_rewrite 1 [h]
      simp
    exact (smul_eq_zero.mp htwo).resolve_left (by norm_num)
  · rintro rfl
    simp

theorem hellingerGammaCompletedAdjacentCofaceClosedSpan_mkQ_eq_zero_of_ne
    {p q : Nat.Primes} (hpq : p ≠ q) {a : ℝ} (ha : a ≠ 0)
    (z : HellingerGammaPureHodgeXiCofaceCompletion p q hpq) :
    (hellingerGammaCompletedAdjacentCofaceClosedSpan hpq a).mkQ z = 0 := by
  rw [hellingerGammaCompletedAdjacentCofaceClosedSpan_eq_top hpq ha,
    Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
  trivial

theorem hellingerGammaCompletedCofaceRecovery_zero_diagonal
    {p q : Nat.Primes} (hpq : p ≠ q)
    (x : DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq) :
    hellingerGammaCompletedCofaceRecovery hpq 0 (x, x) = -x := by
  simp [hellingerGammaCompletedCofaceRecovery,
    hellingerGammaGaugedModularCoefficient,
    hellingerEvenGammaResidueGauge]

theorem hellingerGammaCompletedCofaceRecovery_zero_not_quotient_descending
    {p q : Nat.Primes} (hpq : p ≠ q)
    (x : DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq)
    (hx : x ≠ 0) :
    ¬ ∃ T :
        (HellingerGammaPureHodgeXiCofaceCompletion p q hpq ⧸
            hellingerGammaCompletedAdjacentCofaceClosedSpan hpq 0) →ₗ[ℂ]
          DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq,
      T.comp (hellingerGammaCompletedAdjacentCofaceClosedSpan hpq 0).mkQ =
        (hellingerGammaCompletedCofaceRecovery hpq 0).toLinearMap := by
  rintro ⟨T, hT⟩
  have hdiag :
      (x, x) ∈ hellingerGammaCompletedAdjacentCofaceClosedSpan hpq 0 := by
    rw [hellingerGammaCompletedAdjacentCofaceClosedSpan_zero,
      mem_hellingerGammaCompletedCofaceDiagonal]
  have hq :
      (hellingerGammaCompletedAdjacentCofaceClosedSpan hpq 0).mkQ (x, x) = 0 :=
    (Submodule.Quotient.mk_eq_zero _).mpr hdiag
  have heval := LinearMap.congr_fun hT (x, x)
  rw [LinearMap.comp_apply, hq, map_zero] at heval
  change 0 = hellingerGammaCompletedCofaceRecovery hpq 0 (x, x) at heval
  rw [hellingerGammaCompletedCofaceRecovery_zero_diagonal] at heval
  exact hx (neg_eq_zero.mp heval.symm)

end

end RHTower
