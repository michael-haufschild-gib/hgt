import GaloisForLFunctions.RHTower.Deninger.DeningerPrimeMultiplicativeAutomorphismTopology
import Mathlib.Topology.Algebra.Group.Quotient

/-!
# Literal multiplicative prime fibre

This module quotients the full pointwise automorphism group
`Aut((AlgebraicClosure (ZMod p))ˣ)` by the closed cyclic subgroup generated by arithmetic
Frobenius.  The packet/automorphism homeomorphism maps the packet Frobenius closure exactly onto
this arithmetic closure, hence descends to a continuous multiplicative equivalence of quotients.

Suspending with period `log p` proves that the earlier packet mapping-torus candidate is
homeomorphic to this literal arithmetic multiplicative prime fibre.
-/

namespace RHTower

open Set

noncomputable section

/-- Arithmetic Frobenius cyclic subgroup inside all multiplicative automorphisms. -/
noncomputable def deningerPrimeArithmeticMulAutFrobeniusCyclic
    (p : Nat.Primes) :
    Subgroup (DeningerPrimeArithmeticMulAut p) :=
  Subgroup.zpowers (deningerPrimeArithmeticFrobeniusMulAut p)

/-- Pointwise closure of arithmetic Frobenius powers. -/
noncomputable def deningerPrimeArithmeticMulAutFrobeniusClosure
    (p : Nat.Primes) :
    Subgroup (DeningerPrimeArithmeticMulAut p) :=
  (deningerPrimeArithmeticMulAutFrobeniusCyclic p).topologicalClosure

noncomputable instance (p : Nat.Primes) :
    IsClosed (deningerPrimeArithmeticMulAutFrobeniusClosure p :
      Set (DeningerPrimeArithmeticMulAut p)) :=
  Subgroup.isClosed_topologicalClosure _

/-- Literal multiplicative prime fibre modulo the pointwise Frobenius closure. -/
abbrev DeningerPrimeArithmeticMulAutFrobeniusQuotient
    (p : Nat.Primes) :=
  DeningerPrimeArithmeticMulAut p ⧸
    deningerPrimeArithmeticMulAutFrobeniusClosure p

theorem deningerPrimePacketArithmeticContinuousMulEquiv_frobenius
    (p : Nat.Primes) :
    deningerPrimePacketArithmeticMulAutContinuousMulEquiv p
        (deningerPacketFrobeniusUnit p) =
      deningerPrimeArithmeticFrobeniusMulAut p := by
  rw [deningerPrimePacketArithmeticMulAutContinuousMulEquiv_apply,
    deningerPrimePacketArithmeticMulAutMulEquiv_frobenius]

/-- The pointwise packet homeomorphism maps the closed packet Frobenius subgroup exactly to the
closed arithmetic Frobenius subgroup. -/
theorem deningerPrimePacketArithmeticContinuousMulEquiv_map_frobeniusClosure
    (p : Nat.Primes) :
    (deningerPacketFrobeniusClosure p).map
        (deningerPrimePacketArithmeticMulAutContinuousMulEquiv p).toMonoidHom =
      deningerPrimeArithmeticMulAutFrobeniusClosure p := by
  let E := deningerPrimePacketArithmeticMulAutContinuousMulEquiv p
  apply SetLike.ext'
  have hmap :
      (deningerPacketFrobeniusCyclic p).map E.toMonoidHom =
        deningerPrimeArithmeticMulAutFrobeniusCyclic p := by
    change
      (Subgroup.zpowers (deningerPacketFrobeniusUnit p)).map
          E.toMonoidHom =
        Subgroup.zpowers (deningerPrimeArithmeticFrobeniusMulAut p)
    rw [MonoidHom.map_zpowers]
    calc
      Subgroup.zpowers
          (E.toMonoidHom (deningerPacketFrobeniusUnit p)) =
        Subgroup.zpowers
          (E (deningerPacketFrobeniusUnit p)) := rfl
      _ = Subgroup.zpowers
          (deningerPrimeArithmeticFrobeniusMulAut p) :=
        congrArg Subgroup.zpowers
          (deningerPrimePacketArithmeticContinuousMulEquiv_frobenius p)
  have hcyclic :
      E '' (deningerPacketFrobeniusCyclic p :
          Set (DeningerPacketUnits p)) =
        (deningerPrimeArithmeticMulAutFrobeniusCyclic p :
          Set (DeningerPrimeArithmeticMulAut p)) := by
    have hset := congrArg
      (fun H : Subgroup (DeningerPrimeArithmeticMulAut p) =>
        (H : Set (DeningerPrimeArithmeticMulAut p))) hmap
    rw [Subgroup.coe_map] at hset
    calc
      E '' (deningerPacketFrobeniusCyclic p :
          Set (DeningerPacketUnits p)) =
          E.toMonoidHom '' (deningerPacketFrobeniusCyclic p :
            Set (DeningerPacketUnits p)) := by
        ext y
        constructor <;> rintro ⟨x, hx, rfl⟩ <;> exact ⟨x, hx, rfl⟩
      _ = (deningerPrimeArithmeticMulAutFrobeniusCyclic p :
          Set (DeningerPrimeArithmeticMulAut p)) :=
        hset
  calc
    E '' closure (deningerPacketFrobeniusCyclic p :
        Set (DeningerPacketUnits p)) =
        closure (E '' (deningerPacketFrobeniusCyclic p :
          Set (DeningerPacketUnits p))) :=
      E.isHomeomorph.image_closure _
    _ = closure (deningerPrimeArithmeticMulAutFrobeniusCyclic p :
          Set (DeningerPrimeArithmeticMulAut p)) :=
      congrArg closure hcyclic

theorem deningerPrimePacketArithmeticContinuousMulEquiv_symm_map_frobeniusClosure
    (p : Nat.Primes) :
    (deningerPrimeArithmeticMulAutFrobeniusClosure p).map
        (deningerPrimePacketArithmeticMulAutContinuousMulEquiv p).symm.toMonoidHom =
      deningerPacketFrobeniusClosure p := by
  let E := deningerPrimePacketArithmeticMulAutContinuousMulEquiv p
  apply SetLike.ext'
  have hfrob :
      E.symm (deningerPrimeArithmeticFrobeniusMulAut p) =
        deningerPacketFrobeniusUnit p := by
    calc
      E.symm (deningerPrimeArithmeticFrobeniusMulAut p) =
          E.symm (E (deningerPacketFrobeniusUnit p)) := by
        rw [deningerPrimePacketArithmeticContinuousMulEquiv_frobenius]
      _ = deningerPacketFrobeniusUnit p :=
        ContinuousMulEquiv.symm_apply_apply E _
  have hmap :
      (deningerPrimeArithmeticMulAutFrobeniusCyclic p).map
          E.symm.toMonoidHom =
        deningerPacketFrobeniusCyclic p := by
    change
      (Subgroup.zpowers (deningerPrimeArithmeticFrobeniusMulAut p)).map
          E.symm.toMonoidHom =
        Subgroup.zpowers (deningerPacketFrobeniusUnit p)
    rw [MonoidHom.map_zpowers]
    calc
      Subgroup.zpowers
          (E.symm.toMonoidHom
            (deningerPrimeArithmeticFrobeniusMulAut p)) =
        Subgroup.zpowers
          (E.symm (deningerPrimeArithmeticFrobeniusMulAut p)) := rfl
      _ = Subgroup.zpowers (deningerPacketFrobeniusUnit p) :=
        congrArg Subgroup.zpowers hfrob
  have hcyclic :
      E.symm '' (deningerPrimeArithmeticMulAutFrobeniusCyclic p :
          Set (DeningerPrimeArithmeticMulAut p)) =
        (deningerPacketFrobeniusCyclic p :
          Set (DeningerPacketUnits p)) := by
    have hset := congrArg
      (fun H : Subgroup (DeningerPacketUnits p) =>
        (H : Set (DeningerPacketUnits p))) hmap
    rw [Subgroup.coe_map] at hset
    calc
      E.symm '' (deningerPrimeArithmeticMulAutFrobeniusCyclic p :
          Set (DeningerPrimeArithmeticMulAut p)) =
          E.symm.toMonoidHom ''
            (deningerPrimeArithmeticMulAutFrobeniusCyclic p :
              Set (DeningerPrimeArithmeticMulAut p)) := by
        ext y
        constructor <;> rintro ⟨x, hx, rfl⟩ <;> exact ⟨x, hx, rfl⟩
      _ = (deningerPacketFrobeniusCyclic p :
          Set (DeningerPacketUnits p)) :=
        hset
  calc
    E.symm '' closure
        (deningerPrimeArithmeticMulAutFrobeniusCyclic p :
          Set (DeningerPrimeArithmeticMulAut p)) =
        closure (E.symm ''
          (deningerPrimeArithmeticMulAutFrobeniusCyclic p :
            Set (DeningerPrimeArithmeticMulAut p))) :=
      E.symm.isHomeomorph.image_closure _
    _ = closure (deningerPacketFrobeniusCyclic p :
          Set (DeningerPacketUnits p)) :=
      congrArg closure hcyclic

private noncomputable def deningerPrimePacketArithmeticFrobeniusQuotientForward
    (p : Nat.Primes) :
  DeningerPacketFrobeniusQuotient p →*
      DeningerPrimeArithmeticMulAutFrobeniusQuotient p :=
  QuotientGroup.map
    (deningerPacketFrobeniusClosure p)
    (deningerPrimeArithmeticMulAutFrobeniusClosure p)
    (deningerPrimePacketArithmeticMulAutContinuousMulEquiv p).toMonoidHom
    (by
      intro x hx
      rw [← deningerPrimePacketArithmeticContinuousMulEquiv_map_frobeniusClosure p]
      exact Subgroup.mem_map_of_mem _ hx)

private noncomputable def deningerPrimePacketArithmeticFrobeniusQuotientBackward
    (p : Nat.Primes) :
  DeningerPrimeArithmeticMulAutFrobeniusQuotient p →*
      DeningerPacketFrobeniusQuotient p :=
  QuotientGroup.map
    (deningerPrimeArithmeticMulAutFrobeniusClosure p)
    (deningerPacketFrobeniusClosure p)
    (deningerPrimePacketArithmeticMulAutContinuousMulEquiv p).symm.toMonoidHom
    (by
      intro x hx
      rw [←
        deningerPrimePacketArithmeticContinuousMulEquiv_symm_map_frobeniusClosure p]
      exact Subgroup.mem_map_of_mem _ hx)

/-- Algebraic quotient equivalence induced by packet/arithmetic multiplicative comparison. -/
noncomputable def deningerPrimePacketArithmeticFrobeniusQuotientMulEquiv
    (p : Nat.Primes) :
    DeningerPacketFrobeniusQuotient p ≃*
      DeningerPrimeArithmeticMulAutFrobeniusQuotient p :=
  MonoidHom.toMulEquiv
    (deningerPrimePacketArithmeticFrobeniusQuotientForward p)
    (deningerPrimePacketArithmeticFrobeniusQuotientBackward p)
    (by
      apply MonoidHom.ext
      intro x
      induction x using QuotientGroup.induction_on with
      | _ x =>
          simp only [
            deningerPrimePacketArithmeticFrobeniusQuotientForward,
            deningerPrimePacketArithmeticFrobeniusQuotientBackward]
          exact congrArg QuotientGroup.mk
            (ContinuousMulEquiv.symm_apply_apply
              (deningerPrimePacketArithmeticMulAutContinuousMulEquiv p) x))
    (by
      apply MonoidHom.ext
      intro x
      induction x using QuotientGroup.induction_on with
      | _ x =>
          simp only [
            deningerPrimePacketArithmeticFrobeniusQuotientForward,
            deningerPrimePacketArithmeticFrobeniusQuotientBackward]
          exact congrArg QuotientGroup.mk
            (ContinuousMulEquiv.apply_symm_apply
              (deningerPrimePacketArithmeticMulAutContinuousMulEquiv p) x))

theorem deningerPrimePacketArithmeticFrobeniusQuotientMulEquiv_continuous
    (p : Nat.Primes) :
    Continuous (deningerPrimePacketArithmeticFrobeniusQuotientMulEquiv p) := by
  change Continuous
    (deningerPrimePacketArithmeticFrobeniusQuotientForward p)
  rw [(QuotientGroup.isQuotientMap_mk
    (deningerPacketFrobeniusClosure p)).continuous_iff]
  change Continuous (fun x : DeningerPacketUnits p =>
    QuotientGroup.mk
      (deningerPrimePacketArithmeticMulAutContinuousMulEquiv p x))
  exact QuotientGroup.continuous_mk.comp
    (deningerPrimePacketArithmeticMulAutContinuousMulEquiv p).continuous

theorem deningerPrimePacketArithmeticFrobeniusQuotientMulEquiv_symm_continuous
    (p : Nat.Primes) :
    Continuous (deningerPrimePacketArithmeticFrobeniusQuotientMulEquiv p).symm := by
  change Continuous
    (deningerPrimePacketArithmeticFrobeniusQuotientBackward p)
  rw [(QuotientGroup.isQuotientMap_mk
    (deningerPrimeArithmeticMulAutFrobeniusClosure p)).continuous_iff]
  change Continuous (fun x : DeningerPrimeArithmeticMulAut p =>
    QuotientGroup.mk
      ((deningerPrimePacketArithmeticMulAutContinuousMulEquiv p).symm x))
  exact QuotientGroup.continuous_mk.comp
    (deningerPrimePacketArithmeticMulAutContinuousMulEquiv p).symm.continuous

/-- **Literal prime-fibre quotient comparison.**  The candidate packet quotient and the full
multiplicative-automorphism quotient by arithmetic Frobenius closure are isomorphic as
topological groups. -/
noncomputable def
    deningerPrimePacketArithmeticFrobeniusQuotientContinuousMulEquiv
    (p : Nat.Primes) :
    DeningerPacketFrobeniusQuotient p ≃ₜ*
      DeningerPrimeArithmeticMulAutFrobeniusQuotient p where
  toMulEquiv := deningerPrimePacketArithmeticFrobeniusQuotientMulEquiv p
  continuous_toFun :=
    deningerPrimePacketArithmeticFrobeniusQuotientMulEquiv_continuous p
  continuous_invFun :=
    deningerPrimePacketArithmeticFrobeniusQuotientMulEquiv_symm_continuous p

noncomputable instance (p : Nat.Primes) :
    CompactSpace (DeningerPrimeArithmeticMulAutFrobeniusQuotient p) :=
  (deningerPrimePacketArithmeticFrobeniusQuotientContinuousMulEquiv p).toHomeomorph.compactSpace

noncomputable instance (p : Nat.Primes) :
    T2Space (DeningerPrimeArithmeticMulAutFrobeniusQuotient p) :=
  inferInstance

noncomputable instance (p : Nat.Primes) :
    IsTopologicalGroup
      (DeningerPrimeArithmeticMulAutFrobeniusQuotient p) :=
  inferInstance

noncomputable instance (p : Nat.Primes) :
    TotallyDisconnectedSpace
      (DeningerPrimeArithmeticMulAutFrobeniusQuotient p) :=
  deningerTotallyDisconnected_of_injective
    (f :=
      (deningerPrimePacketArithmeticFrobeniusQuotientContinuousMulEquiv p).symm)
    (ContinuousMulEquiv.symm
      (deningerPrimePacketArithmeticFrobeniusQuotientContinuousMulEquiv p)).continuous
    (ContinuousMulEquiv.symm
      (deningerPrimePacketArithmeticFrobeniusQuotientContinuousMulEquiv p)).injective

/-- Literal arithmetic multiplicative prime fibre with period `log p`. -/
abbrev DeningerPrimeArithmeticFibre (p : Nat.Primes) :=
  DeningerMappingTorus
    (DeningerPrimeArithmeticMulAutFrobeniusQuotient p)
    (Real.log (p : ℝ))

/-- **Prime-fibre identification.**  The previously constructed packet mapping torus is
homeomorphic to the literal arithmetic multiplicative prime fibre. -/
noncomputable def deningerPrimeFibreCandidateArithmeticHomeomorph
    (p : Nat.Primes) :
    DeningerPrimeFibreCandidate p ≃ₜ
      DeningerPrimeArithmeticFibre p :=
  (deningerPrimeFibreCandidateHomeomorph p).trans <|
    (Homeomorph.prodCongr
      (ContinuousMulEquiv.toHomeomorph
        (deningerPrimePacketArithmeticFrobeniusQuotientContinuousMulEquiv p))
      (Homeomorph.refl _)).trans <|
        (deningerMappingTorusHomeomorph).symm

end

end RHTower
