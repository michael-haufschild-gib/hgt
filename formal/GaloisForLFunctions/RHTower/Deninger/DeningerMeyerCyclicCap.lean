import GaloisForLFunctions.RHTower.Deninger.DeningerMeyerGaussianEulerDensity
import GaloisForLFunctions.RHTower.Deninger.DeningerMeyerExactXiCapSource

/-!
# One cyclic generator for the original Meyer cap

The Gaussian Euler module is dense among even Schwartz functions. Its two
cap constraints are evaluation of the Euler polynomial at zero and one.
Removing those two values leaves the ideal generated by X(X-1), whose source
is exactly the fixed Xi cap. Thus that single cap's polynomial Euler orbit
is dense in the entire original cap.
-/

open Complex Polynomial Topology
open scoped SchwartzMap
open GaloisForLFunctions

namespace RHTower
noncomputable section

private theorem negativeEuler_fourier (f : 𝓢(ℝ, ℂ)) :
    deningerFourierEval (deningerSchwartzNegativeEuler f) = deningerFourierEval f := by
  have he (g : 𝓢(ℝ, ℂ)) : deningerFourierEval g = fourierSCLM g 0 := by
    rw [deningerFourierEval_apply, FourierTransform.fourierCLE_apply, fourierSCLM_eq]
  rw [he, he]
  change fourierSCLM (-eulerSCLM f) 0 = _
  rw [map_neg]
  change -fourierSCLM (eulerSCLM f) 0 = _
  rw [fourierSCLM_eulerSCLM_zero, neg_neg]

private theorem gaussian_fourier : deningerFourierEval gaussianSchwartz = 1 := by
  rw [deningerFourierEval_apply, FourierTransform.fourierCLE_apply,
    ← fourierSCLM_eq, fourierSCLM_gaussianSchwartz, gaussianSchwartz_apply]
  simp [gaussReal]

theorem deningerGaussianEulerPolynomial_endpoints (p : ℂ[X]) :
    deningerGaussianEulerPolynomial p 0 = p.eval 0 ∧
      deningerFourierEval (deningerGaussianEulerPolynomial p) = p.eval 1 := by
  induction p using Polynomial.induction_on with
  | C a =>
    have he : deningerGaussianEulerPolynomial (C a) = a • gaussianSchwartz := by
      simp [deningerGaussianEulerPolynomial]
    rw [he]
    constructor
    · simp [gaussianSchwartz_apply, gaussReal]
    · rw [map_smul, gaussian_fourier]; simp
  | add p q hp hq =>
    simpa only [map_add, add_apply, Polynomial.eval_add] using
      (And.intro (congrArg₂ (· + ·) hp.1 hq.1) (congrArg₂ (· + ·) hp.2 hq.2))
  | monomial n a ih =>
    rw [show C a * X ^ (n + 1) = X * (C a * X ^ n) by ring,
      deningerGaussianEulerPolynomial_X_mul]
    constructor
    · change -eulerSCLM (deningerGaussianEulerPolynomial (C a * X ^ n)) 0 = _
      simp
    · rw [negativeEuler_fourier, ih.2]
      simp

private theorem gaussianPolynomial_even (p : ℂ[X]) :
    deningerGaussianEulerPolynomial p ∈ deningerEvenSchwartz := by
  induction p using Polynomial.induction_on with
  | C a =>
    apply (deningerEvenSchwartz_mem_iff _).mpr
    intro x
    simp [deningerGaussianEulerPolynomial, gaussianSchwartz_apply, gaussReal]
  | add p q hp hq => rw [map_add]; exact deningerEvenSchwartz.add_mem hp hq
  | monomial n a ih =>
    rw [show C a * X ^ (n + 1) = X * (C a * X ^ n) by ring,
      deningerGaussianEulerPolynomial_X_mul]
    apply (deningerEvenSchwartz_mem_iff _).mpr
    intro x
    change -eulerSCLM _ (-x) = -eulerSCLM _ x
    rw [eulerSCLM_even ((deningerEvenSchwartz_mem_iff _).mp ih)]

/-- The two-factor Gaussian Euler source is the literal normalized Xi cap. -/
theorem deningerGaussianEulerPolynomial_capSeed :
    deningerGaussianEulerPolynomial (X * (X - 1)) =
      (deningerMeyerXiCapSource : 𝓢(ℝ, ℂ)) := by
  have hd : derivSCLM gaussianSchwartz = -(2 * (Real.pi : ℂ)) • mulXCLM gaussianSchwartz := by
    have h := annihilationCLM_gaussianSchwartz
    rw [annihilationCLM_eq] at h
    simpa only [neg_smul] using (eq_neg_of_add_eq_zero_right h)
  change (Polynomial.aeval deningerSchwartzNegativeEuler (X * (X - 1))) gaussianSchwartz = _
  simp only [map_mul, map_sub, Polynomial.aeval_X, map_one, Module.End.mul_apply,
    LinearMap.sub_apply, Module.End.one_apply]
  change -eulerSCLM (-eulerSCLM gaussianSchwartz) - -eulerSCLM gaussianSchwartz = _
  simp only [map_neg, eulerSCLM, ContinuousLinearMap.comp_apply, hd,
    map_smul, derivSCLM_mulXCLM, map_add]
  ext x
  change _ = (4 * (Real.pi : ℂ) ^ 2) *
    ((meyerPoissonTestSource : 𝓢(ℝ, ℂ)) x)
  rw [show (meyerPoissonTestSource : 𝓢(ℝ, ℂ)) x = (meyerPoissonTest x : ℂ) from
    meyerPoissonTestSchwartz_apply x]
  simp only [neg_apply, sub_apply, add_apply, smul_apply, smul_eq_mul, mulXCLM_apply,
    gaussianSchwartz_apply, meyerPoissonTest, gaussReal]
  push_cast
  have he : -((Real.pi : ℂ) * (x : ℂ) ^ 2) = -(Real.pi : ℂ) * (x : ℂ) ^ 2 := by ring
  rw [he]
  field_simp [pi_ne_zero_complex]
  ring

/-- Polynomial Euler synthesis from the exact Xi cap. -/
def deningerMeyerXiCapPolynomial : ℂ[X] →ₗ[ℂ] DeningerMeyerCap :=
  (LinearMap.applyₗ deningerMeyerXiCapSource).comp
    (Polynomial.aeval deningerMeyerNegativeEuler).toLinearMap

theorem deningerMeyerXiCapPolynomial_X_mul (p : ℂ[X]) :
    deningerMeyerXiCapPolynomial (X * p) =
      deningerMeyerNegativeEuler (deningerMeyerXiCapPolynomial p) := by
  simp [deningerMeyerXiCapPolynomial, Polynomial.aeval_mul]

theorem deningerMeyerXiCapPolynomial_coe (p : ℂ[X]) :
    (deningerMeyerXiCapPolynomial p : 𝓢(ℝ, ℂ)) =
      deningerGaussianEulerPolynomial (p * (X * (X - 1))) := by
  induction p using Polynomial.induction_on with
  | C a =>
    have he : deningerMeyerXiCapPolynomial (C a) = a • deningerMeyerXiCapSource := by
      simp [deningerMeyerXiCapPolynomial]
    rw [he, Submodule.coe_smul, ← deningerGaussianEulerPolynomial_capSeed]
    simp [deningerGaussianEulerPolynomial, Polynomial.aeval_mul]
  | add p q hp hq =>
    simpa only [map_add, Submodule.coe_add, add_mul] using (congrArg₂ (· + ·) hp hq)
  | monomial n a ih =>
    rw [show C a * X ^ (n + 1) = X * (C a * X ^ n) by ring,
      deningerMeyerXiCapPolynomial_X_mul, mul_assoc,
      deningerGaussianEulerPolynomial_X_mul]
    change deningerSchwartzNegativeEuler (deningerMeyerXiCapPolynomial (C a * X ^ n) :
      𝓢(ℝ, ℂ)) = _
    rw [ih]

private def capCorrection : 𝓢(ℝ, ℂ) →L[ℂ] 𝓢(ℝ, ℂ) :=
  ContinuousLinearMap.id ℂ _ - (deningerSchwartzEval 0).smulRight gaussianSchwartz -
    (deningerFourierEval - deningerSchwartzEval 0).smulRight
      (deningerSchwartzNegativeEuler gaussianSchwartz)

private theorem capCorrection_fixed (f : DeningerMeyerCap) : capCorrection f = f := by
  obtain ⟨_, h0, hF⟩ := (deningerMeyerCap_mem_iff _).mp f.property
  change (f : 𝓢(ℝ, ℂ)) - f.val 0 • gaussianSchwartz -
    (deningerFourierEval f - f.val 0) • deningerSchwartzNegativeEuler gaussianSchwartz = f
  rw [deningerFourierEval_apply, h0, hF]
  simp

private theorem capCorrection_polynomial (p : ℂ[X]) :
    capCorrection (deningerGaussianEulerPolynomial p) =
      deningerGaussianEulerPolynomial (p - C (p.eval 0) - C (p.eval 1 - p.eval 0) * X) := by
  have he := deningerGaussianEulerPolynomial_endpoints p
  change deningerGaussianEulerPolynomial p -
    (deningerGaussianEulerPolynomial p 0) • gaussianSchwartz -
      (deningerFourierEval (deningerGaussianEulerPolynomial p) -
        deningerGaussianEulerPolynomial p 0) •
          deningerSchwartzNegativeEuler gaussianSchwartz = _
  rw [he.1, he.2, map_sub, map_sub]
  simp [deningerGaussianEulerPolynomial, Polynomial.aeval_mul, sub_smul]

private theorem two_endpoint_factor (p : ℂ[X]) :
    ∃ q : ℂ[X], p - C (p.eval 0) - C (p.eval 1 - p.eval 0) * X = q * (X * (X - 1)) := by
  let r := p - C (p.eval 0) - C (p.eval 1 - p.eval 0) * X
  have hr0 : r.eval 0 = 0 := by simp [r]
  have hr1 : r.eval 1 = 0 := by simp [r]
  obtain ⟨q, hq⟩ := Polynomial.dvd_iff_isRoot.mpr hr0
  simp only [Polynomial.C_0, sub_zero] at hq
  have hq1 : q.eval 1 = 0 := by simpa [hq] using hr1
  obtain ⟨v, hv⟩ := Polynomial.dvd_iff_isRoot.mpr hq1
  refine ⟨v, ?_⟩
  change r = _
  rw [hq, hv]
  simp only [Polynomial.C_1]
  ring

/-- One fixed Xi cap generates the entire original cap by Schwartz closure. -/
theorem deningerMeyerXiCapPolynomial_dense : DenseRange deningerMeyerXiCapPolynomial := by
  let H := LinearMap.range (DeningerMeyerCap.subtype.comp deningerMeyerXiCapPolynomial)
  have hW : LinearMap.range deningerGaussianEulerPolynomial ≤
      H.topologicalClosure.comap capCorrection.toLinearMap := by
    rintro g ⟨p, rfl⟩
    change capCorrection (deningerGaussianEulerPolynomial p) ∈ H.topologicalClosure
    apply H.le_topologicalClosure
    obtain ⟨q, hq⟩ := two_endpoint_factor p
    refine ⟨q, ?_⟩
    change (deningerMeyerXiCapPolynomial q : 𝓢(ℝ, ℂ)) = _
    rw [deningerMeyerXiCapPolynomial_coe, capCorrection_polynomial, hq]
  have hclosed : IsClosed ((H.topologicalClosure.comap capCorrection.toLinearMap :
      Submodule ℂ 𝓢(ℝ, ℂ)) : Set 𝓢(ℝ, ℂ)) :=
    H.isClosed_topologicalClosure.preimage capCorrection.continuous
  have hcl := (LinearMap.range deningerGaussianEulerPolynomial).topologicalClosure_minimal hW hclosed
  intro f
  have hf := hcl (deningerGaussianEulerPolynomial_dense_even f
    ((deningerEvenSchwartz_mem_iff _).mpr ((deningerMeyerCap_mem_iff _).mp f.property).1))
  change capCorrection f ∈ H.topologicalClosure at hf
  rw [capCorrection_fixed] at hf
  rw [Topology.IsInducing.subtypeVal.closure_eq_preimage_closure_image]
  change (f : 𝓢(ℝ, ℂ)) ∈ closure
    (((↑) : DeningerMeyerCap → 𝓢(ℝ, ℂ)) '' Set.range deningerMeyerXiCapPolynomial)
  have he : ((↑) : DeningerMeyerCap → 𝓢(ℝ, ℂ)) '' Set.range deningerMeyerXiCapPolynomial =
      (H : Set 𝓢(ℝ, ℂ)) := by
    ext g
    simp only [Set.mem_image, Set.mem_range, H]
    constructor
    · rintro ⟨v, ⟨p, rfl⟩, rfl⟩; exact ⟨p, rfl⟩
    · rintro ⟨p, rfl⟩; exact ⟨_, ⟨p, rfl⟩, rfl⟩
  rw [he]
  exact hf

end
end RHTower
