import GaloisForLFunctions.RHTower.Deninger.DeningerRootAdjunctionNoGo

/-!
# The rationalization is generated by the image of the group

A subgroup of `Bau(G)` that contains the image of `G` and is closed under the root operations is
everything: the terms are built from the image by the group operations and the roots, so a term
induction exhausts them.

The rationalization is also torsion free, which is immediate from uniqueness of roots.

* `deningerBau_eq_top_of_rootClosed` : the generation statement.
* `deningerBau_torsionFree` : no nontrivial element has finite order.
-/

namespace RHTower

namespace DeningerBau

variable {α : Type*} [Group α]

/-- **The rationalization is generated by the image of the group as a group with roots.** -/
theorem eq_top_of_rootClosed (K : Subgroup (DeningerBau α))
    (hroot : ∀ (n : ℕ) (x : DeningerBau α), x ∈ K → DeningerBau.root n x ∈ K)
    (hof : ∀ a : α, DeningerBau.of a ∈ K) : K = ⊤ := by
  refine (Subgroup.eq_top_iff' K).2 fun x => ?_
  refine DeningerBau.induction (motive := fun x => x ∈ K) ?_ x
  intro t
  induction t with
  | of a => exact hof a
  | one =>
    show (1 : DeningerBau α) ∈ K
    exact K.one_mem
  | mul s t hs ht =>
    show DeningerBau.mk s * DeningerBau.mk t ∈ K
    exact K.mul_mem hs ht
  | inv t ht =>
    show (DeningerBau.mk t)⁻¹ ∈ K
    exact K.inv_mem ht
  | root n t ht =>
    show DeningerBau.root n (DeningerBau.mk t) ∈ K
    exact hroot n _ ht

/-- **The rationalization is torsion free.** -/
theorem torsionFree (x : DeningerBau α) (n : ℕ) (hn : 0 < n) (hx : x ^ n = 1) : x = 1 := by
  obtain ⟨m, -, huniq⟩ := DeningerBau.uniquelyDivisible (α := α) n hn 1
  exact (huniq x hx).trans (huniq 1 (one_pow n)).symm

end DeningerBau

section Transfer

variable {G H : Type*} [Group G] [Group H]

/-- **Unique roots pass to subgroups of the ambient group along an injection.**  A group that embeds
in a group with unique roots has unique roots in the weak sense that equal powers are equal. -/
theorem deningerPow_injective_of_injective (f : G →* H)
    (hf : Function.Injective f) (hH : ∀ x y : H, ∀ n : ℕ, 0 < n → x ^ n = y ^ n → x = y)
    (x y : G) (n : ℕ) (hn : 0 < n) (h : x ^ n = y ^ n) : x = y := by
  refine hf ?_
  refine hH (f x) (f y) n hn ?_
  rw [← map_pow, ← map_pow, h]

/-- Equal powers are equal in a group with unique roots. -/
theorem deningerPow_injective_of_uniquelyDivisible (hH : DeningerUniquelyDivisible H)
    (x y : H) (n : ℕ) (hn : 0 < n) (h : x ^ n = y ^ n) : x = y := by
  obtain ⟨z, -, huniq⟩ := hH n hn (x ^ n)
  exact (huniq x rfl).trans (huniq y h.symm).symm

end Transfer

end RHTower
