import GaloisForLFunctions.RHTower.Deninger.DeningerHazewinkelSylvesterExchange
import Mathlib.RingTheory.Ideal.Colon

/-!
# Hazewinkel leading-determinant Sylvester containment

This module applies the determinant-exchange identity to the universal Hankel matrix. It constructs
Hazewinkel's bordered leading matrix, proves its determinant is `D_n`, and defines the exchange
ideal generated by its one-column replacements. The formal Appendix A.1 consequence is

`J_n ≤ K_n : D_n`, equivalently `D_n * J_n ≤ K_n` elementwise.

No regularity, primeness, reducedness, or saturation premise is used.
-/

namespace RHTower
noncomputable section

def deningerHazewinkelBorderedLeading (n : ℕ) :
    Matrix (Fin (n + 1)) (Fin (n + 1)) (MvPolynomial ℕ ℤ) :=
  Matrix.reindex finSumFinEquiv finSumFinEquiv
    (Matrix.fromBlocks
      (fun i j : Fin n => deningerHazewinkelUniversalCoeff (i.val + j.val))
      (0 : Matrix (Fin n) (Fin 1) (MvPolynomial ℕ ℤ))
      (fun (_ : Fin 1) (j : Fin n) =>
        deningerHazewinkelUniversalCoeff (n + j.val))
      (1 : Matrix (Fin 1) (Fin 1) (MvPolynomial ℕ ℤ)))

theorem deningerHazewinkelBorderedLeading_det (n : ℕ) :
    (deningerHazewinkelBorderedLeading n).det =
      deningerHazewinkelLeadingDeterminant n := by
  rw [deningerHazewinkelBorderedLeading, Matrix.det_reindex_self,
    Matrix.det_fromBlocks_zero₁₂, Matrix.det_one, mul_one]
  rfl

theorem deningerHazewinkelBorderedLeading_apply (n : ℕ) (i j : Fin (n + 1)) :
    deningerHazewinkelBorderedLeading n i j =
      if _hj : j.val < n then
        deningerHazewinkelUniversalCoeff (i.val + j.val)
      else if i.val = n then 1 else 0 := by
  refine Fin.lastCases ?_ (fun j' => ?_) j
  · refine Fin.lastCases ?_ (fun i' => ?_) i
    · have hlast : Fin.last n = Fin.natAdd n (0 : Fin 1) := by
        apply Fin.ext
        simp
      rw [hlast]
      simp [deningerHazewinkelBorderedLeading, Matrix.reindex,
        Matrix.submatrix, finSumFinEquiv_symm_apply_natAdd]
    · have hlast : Fin.last n = Fin.natAdd n (0 : Fin 1) := by
        apply Fin.ext
        simp
      rw [hlast]
      have hi : i'.val ≠ n := Nat.ne_of_lt i'.isLt
      simp [deningerHazewinkelBorderedLeading, Matrix.reindex,
        Matrix.submatrix, finSumFinEquiv_symm_apply_natAdd,
        finSumFinEquiv_symm_apply_castSucc, hi]
  · refine Fin.lastCases ?_ (fun i' => ?_) i
    · have hlast : Fin.last n = Fin.natAdd n (0 : Fin 1) := by
        apply Fin.ext
        simp
      rw [hlast]
      simp [deningerHazewinkelBorderedLeading, Matrix.reindex,
        Matrix.submatrix, finSumFinEquiv_symm_apply_natAdd,
        finSumFinEquiv_symm_apply_castSucc]
    · simp [deningerHazewinkelBorderedLeading, Matrix.reindex,
        Matrix.submatrix, finSumFinEquiv_symm_apply_castSucc]

/-- Ideal generated by all `(n+1)`-minors with the consecutive row set `0,...,n`. -/
def deningerHazewinkelFixedRowMinorIdeal (n : ℕ) : Ideal (MvPolynomial ℕ ℤ) :=
  Ideal.span {z | ∃ cols : Fin (n + 1) → ℕ,
    z = (deningerHazewinkelUniversalHankel.submatrix
      (fun i : Fin (n + 1) => i.val) cols).det}

/-- Hazewinkel's special ideal generated by `m_s`: the first `n` leading columns and one
arbitrary last Hankel column. -/
def deningerHazewinkelSpecialMinorIdeal (n : ℕ) : Ideal (MvPolynomial ℕ ℤ) :=
  Ideal.span {z | ∃ s : ℕ,
    z = ((deningerHazewinkelBorderedLeading n).updateCol (Fin.last n)
      (fun i => deningerHazewinkelUniversalCoeff (i.val + s))).det}

theorem deningerHazewinkelSpecialMinorIdeal_le_fixedRow (n : ℕ) :
    deningerHazewinkelSpecialMinorIdeal n ≤ deningerHazewinkelFixedRowMinorIdeal n := by
  rw [deningerHazewinkelSpecialMinorIdeal, deningerHazewinkelFixedRowMinorIdeal,
    Ideal.span_le]
  rintro z ⟨s, rfl⟩
  apply Ideal.subset_span
  let cols : Fin (n + 1) → ℕ := fun j =>
    if j = Fin.last n then s else j.val
  refine ⟨cols, ?_⟩
  congr 1
  ext i j
  by_cases hj : j = Fin.last n
  · subst j
    simp [cols, Matrix.submatrix, deningerHazewinkelUniversalHankel]
  · rw [Matrix.updateCol_ne hj]
    have hjlt : j.val < n := by
      have hjle : j.val ≤ n := Nat.le_of_lt_succ j.isLt
      rcases Nat.lt_or_eq_of_le hjle with hlt | heq
      · exact hlt
      · exfalso
        apply hj
        apply Fin.ext
        simpa using heq
    rw [deningerHazewinkelBorderedLeading_apply n i j]
    simp [hjlt, cols, hj, Matrix.submatrix,
      deningerHazewinkelUniversalHankel]

theorem deningerHazewinkelFixedRowMinorIdeal_le_ideal (n : ℕ) :
    deningerHazewinkelFixedRowMinorIdeal n ≤ deningerHazewinkelIdeal n := by
  rw [deningerHazewinkelFixedRowMinorIdeal, deningerHazewinkelIdeal,
    deningerMatrixMinorIdeal, Ideal.span_le]
  rintro z ⟨cols, rfl⟩
  apply Ideal.subset_span
  exact ⟨fun i : Fin (n + 1) => i.val, cols, rfl⟩

theorem deningerHazewinkelLeading_mul_fixedRowMinor_mem_special
    (n : ℕ) (cols : Fin (n + 1) → ℕ) :
    deningerHazewinkelLeadingDeterminant n *
      (deningerHazewinkelUniversalHankel.submatrix
        (fun i : Fin (n + 1) => i.val) cols).det ∈
      deningerHazewinkelSpecialMinorIdeal n := by
  let Y := deningerHazewinkelUniversalHankel.submatrix
    (fun i : Fin (n + 1) => i.val) cols
  have h := Matrix.det_mul_det_mem_updateColIdeal
    (deningerHazewinkelBorderedLeading n) Y (Fin.last n)
  rw [deningerHazewinkelBorderedLeading_det] at h
  apply Ideal.span_mono _ h
  rintro z ⟨q, rfl⟩
  exact ⟨cols q, rfl⟩

theorem deningerHazewinkelFixedRowMinorIdeal_le_special_colon (n : ℕ) :
    deningerHazewinkelFixedRowMinorIdeal n ≤
      (deningerHazewinkelSpecialMinorIdeal n).colon
        {deningerHazewinkelLeadingDeterminant n} := by
  rw [deningerHazewinkelFixedRowMinorIdeal, Ideal.span_le]
  rintro z ⟨cols, rfl⟩
  apply Submodule.mem_colon.mpr
  intro s hs
  rw [Set.mem_singleton_iff.mp hs]
  simp only [smul_eq_mul]
  rw [mul_comm]
  exact deningerHazewinkelLeading_mul_fixedRowMinor_mem_special n cols

theorem deningerHazewinkel_leadingIdeal_mul_fixedRow_le_special (n : ℕ) :
    Ideal.span {deningerHazewinkelLeadingDeterminant n} *
        deningerHazewinkelFixedRowMinorIdeal n ≤
      deningerHazewinkelSpecialMinorIdeal n := by
  rw [Ideal.span_singleton_mul_le_iff]
  intro z hz
  have hcolon := deningerHazewinkelFixedRowMinorIdeal_le_special_colon n hz
  have h := Submodule.mem_colon.mp hcolon
    (deningerHazewinkelLeadingDeterminant n) (Set.mem_singleton _)
  simpa only [smul_eq_mul, mul_comm] using h

def deningerHazewinkelSylvesterExchangeIdeal (n : ℕ) : Ideal (MvPolynomial ℕ ℤ) :=
  Ideal.span {z | ∃ rows : Fin (n + 1) → ℕ, ∃ s : ℕ,
    z = ((deningerHazewinkelBorderedLeading n).updateCol (Fin.last n)
      (fun i => deningerHazewinkelUniversalCoeff (rows i + s))).det}

theorem deningerHazewinkelLeading_mul_minor_mem_sylvesterExchangeIdeal
    (n : ℕ) (rows cols : Fin (n + 1) → ℕ) :
    deningerHazewinkelLeadingDeterminant n *
      (deningerHazewinkelUniversalHankel.submatrix rows cols).det ∈
        deningerHazewinkelSylvesterExchangeIdeal n := by
  let Y := deningerHazewinkelUniversalHankel.submatrix rows cols
  have h := Matrix.det_mul_det_mem_updateColIdeal
    (deningerHazewinkelBorderedLeading n) Y (Fin.last n)
  rw [deningerHazewinkelBorderedLeading_det] at h
  apply Ideal.span_mono _ h
  rintro z ⟨q, rfl⟩
  exact ⟨rows, cols q, rfl⟩

theorem deningerHazewinkelIdeal_le_sylvesterExchange_colon (n : ℕ) :
    deningerHazewinkelIdeal n ≤
      (deningerHazewinkelSylvesterExchangeIdeal n).colon
        {deningerHazewinkelLeadingDeterminant n} := by
  rw [deningerHazewinkelIdeal, deningerMatrixMinorIdeal, Ideal.span_le]
  rintro z ⟨rows, cols, rfl⟩
  apply Submodule.mem_colon.mpr
  intro s hs
  rw [Set.mem_singleton_iff.mp hs]
  simp only [smul_eq_mul]
  rw [mul_comm]
  exact deningerHazewinkelLeading_mul_minor_mem_sylvesterExchangeIdeal n rows cols

end
end RHTower
