import GaloisForLFunctions.RHTower.Deninger.DeningerAbsoluteHeight

/-!
# The absolute height is a seminorm on the multiplicative group

The absolute logarithmic Weil height is subadditive under multiplication, invariant under
inversion, and homogeneous under integer powers.  Together with the height-zero theorem — it
vanishes exactly on the roots of unity — this makes it a seminorm on `Q̄ˣ` whose null space is the
torsion subgroup, hence a norm on `𝒢 = Q̄ˣ/μ_∞`.

Subadditivity is the only statement that needs two elements at once; it is proved in the field
`ℚ⟮α, β⟯`, which is finite over `ℚ` and contains `α`, `β` and `αβ`.

* `deningerAbsHeight_mul_le` : subadditivity.
* `deningerAbsHeight_inv`, `deningerAbsHeight_zpow` : inversion and integer powers.
* `deningerAbsHeight_one` : it vanishes at one.
-/

namespace RHTower

open NumberField Module

open scoped IntermediateField

section NormalizedSeminorm

variable {K : Type*} [Field K] [NumberField K]

theorem deningerNormalizedHeight_mul_le (x y : K) :
    deningerNormalizedHeight K (x * y)
      ≤ deningerNormalizedHeight K x + deningerNormalizedHeight K y := by
  have hpos : (0 : ℝ) < (finrank ℚ K : ℝ) := by
    have := Module.finrank_pos (R := ℚ) (M := K)
    positivity
  rw [deningerNormalizedHeight, deningerNormalizedHeight, deningerNormalizedHeight,
    ← add_div, div_le_div_iff_of_pos_right hpos]
  exact Height.logHeight₁_mul_le x y

@[simp] theorem deningerNormalizedHeight_one : deningerNormalizedHeight K (1 : K) = 0 := by
  rw [deningerNormalizedHeight, Height.logHeight₁_one, zero_div]

@[simp] theorem deningerNormalizedHeight_inv (x : K) :
    deningerNormalizedHeight K x⁻¹ = deningerNormalizedHeight K x := by
  rw [deningerNormalizedHeight, deningerNormalizedHeight, Height.logHeight₁_inv]

theorem deningerNormalizedHeight_zpow (x : K) (n : ℤ) :
    deningerNormalizedHeight K (x ^ n) = (n.natAbs : ℝ) * deningerNormalizedHeight K x := by
  rw [deningerNormalizedHeight, deningerNormalizedHeight, Height.logHeight₁_zpow, mul_div_assoc]

end NormalizedSeminorm

section AbsoluteSeminorm

variable {F : Type*} [Field F] [Algebra ℚ F] [Algebra.IsAlgebraic ℚ F]

instance deningerAdjoinPair_numberField (α β : F) : NumberField ℚ⟮α, β⟯ where
  to_finiteDimensional := by
    have h : Module.Finite ℚ ℚ⟮α, β⟯ :=
      IntermediateField.finiteDimensional_adjoin_pair
        (Algebra.IsAlgebraic.isAlgebraic α).isIntegral
        (Algebra.IsAlgebraic.isAlgebraic β).isIntegral
    convert h using 2
    exact Subsingleton.elim _ _

/-- **Subadditivity of the absolute height.**  Both elements and their product lie in the finite
field `ℚ⟮α, β⟯`, where subadditivity is the ordinary height inequality. -/
theorem deningerAbsHeight_mul_le (α β : F) :
    deningerAbsHeight (α * β) ≤ deningerAbsHeight α + deningerAbsHeight β := by
  have hα : α ∈ (ℚ⟮α, β⟯ : IntermediateField ℚ F) :=
    IntermediateField.subset_adjoin ℚ {α, β} (by simp)
  have hβ : β ∈ (ℚ⟮α, β⟯ : IntermediateField ℚ F) :=
    IntermediateField.subset_adjoin ℚ {α, β} (by simp)
  have hαβ : α * β ∈ (ℚ⟮α, β⟯ : IntermediateField ℚ F) := mul_mem hα hβ
  rw [deningerAbsHeight_intermediateField _ hα, deningerAbsHeight_intermediateField _ hβ,
    deningerAbsHeight_intermediateField _ hαβ,
    show (⟨α * β, hαβ⟩ : (ℚ⟮α, β⟯ : IntermediateField ℚ F))
        = (⟨α, hα⟩ : (ℚ⟮α, β⟯ : IntermediateField ℚ F)) * ⟨β, hβ⟩ from rfl]
  exact deningerNormalizedHeight_mul_le _ _

/-- The absolute height computed in the field generated by the element. -/
theorem deningerAbsHeight_eq_adjoinSimple (α : F) :
    deningerAbsHeight α
      = deningerNormalizedHeight ℚ⟮α⟯
          ⟨α, IntermediateField.mem_adjoin_simple_self ℚ α⟩ :=
  deningerAbsHeight_intermediateField _ (IntermediateField.mem_adjoin_simple_self ℚ α)

/-- **The absolute height is invariant under inversion.** -/
@[simp] theorem deningerAbsHeight_inv (α : F) : deningerAbsHeight α⁻¹ = deningerAbsHeight α := by
  have hmem : α ∈ (ℚ⟮α⟯ : IntermediateField ℚ F) :=
    IntermediateField.mem_adjoin_simple_self ℚ α
  rw [deningerAbsHeight_intermediateField (ℚ⟮α⟯ : IntermediateField ℚ F) (inv_mem hmem),
    deningerAbsHeight_eq_adjoinSimple α,
    show (⟨α⁻¹, inv_mem hmem⟩ : (ℚ⟮α⟯ : IntermediateField ℚ F))
        = (⟨α, hmem⟩ : (ℚ⟮α⟯ : IntermediateField ℚ F))⁻¹ from rfl,
    deningerNormalizedHeight_inv]

/-- **Homogeneity under integer powers.** -/
theorem deningerAbsHeight_zpow (α : F) (n : ℤ) :
    deningerAbsHeight (α ^ n) = (n.natAbs : ℝ) * deningerAbsHeight α := by
  have hmem : α ∈ (ℚ⟮α⟯ : IntermediateField ℚ F) :=
    IntermediateField.mem_adjoin_simple_self ℚ α
  have hpow : α ^ n ∈ (ℚ⟮α⟯ : IntermediateField ℚ F) := zpow_mem hmem n
  rw [deningerAbsHeight_intermediateField (ℚ⟮α⟯ : IntermediateField ℚ F) hpow,
    deningerAbsHeight_eq_adjoinSimple α,
    show (⟨α ^ n, hpow⟩ : (ℚ⟮α⟯ : IntermediateField ℚ F))
        = (⟨α, hmem⟩ : (ℚ⟮α⟯ : IntermediateField ℚ F)) ^ n from rfl,
    deningerNormalizedHeight_zpow]

/-- **The absolute height vanishes at one.** -/
@[simp] theorem deningerAbsHeight_one : deningerAbsHeight (1 : F) = 0 := by
  have hmem : (1 : F) ∈ (ℚ⟮(1 : F)⟯ : IntermediateField ℚ F) :=
    IntermediateField.mem_adjoin_simple_self ℚ 1
  rw [deningerAbsHeight_eq_adjoinSimple (1 : F),
    show (⟨(1 : F), hmem⟩ : (ℚ⟮(1 : F)⟯ : IntermediateField ℚ F)) = 1 from rfl,
    deningerNormalizedHeight_one]

end AbsoluteSeminorm

end RHTower
