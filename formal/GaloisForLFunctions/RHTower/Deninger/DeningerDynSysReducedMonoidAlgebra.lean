import Mathlib.Algebra.MonoidAlgebra.Basic
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# The reduced monoid algebra

Deninger, *Dynamical systems for arithmetic schemes* (arXiv:1807.06400v4), §1: for a commutative
ring `A` the *reduced monoid ring* `ℤ̲A` is the monoid ring `ℤ A` of the multiplicative monoid of
`A` modulo the ideal `ℤ (0)`, and

`Hom (ℤ̲A, R) ≅ {P : A → R multiplicative with P 1 = 1 and P 0 = 0}`.

The right-hand side is `A →*₀ R`.  This identification is what turns Deninger's `C`-valued and
`𝔬`-valued points of `W_rat (X)` into multiplicative maps, and is used throughout §§1, 3 and 13 of
the source.
-/

namespace RHTower

open MonoidAlgebra

variable (A : Type*) [CommMonoidWithZero A]

/-- The ideal `ℤ · (0)` of the monoid algebra generated by the basis element at `0 ∈ A`. -/
noncomputable def deningerMonoidAlgebraZeroIdeal : Ideal (MonoidAlgebra ℤ A) :=
  Ideal.span {MonoidAlgebra.single (0 : A) (1 : ℤ)}

/-- Deninger's reduced monoid algebra `ℤ̲A = ℤ A / ℤ (0)`. -/
private abbrev DeningerReducedMonoidAlgebra : Type _ :=
  MonoidAlgebra ℤ A ⧸ deningerMonoidAlgebraZeroIdeal A

variable {A}
variable {R : Type*} [CommRing R]

/-- The pointed multiplicative map attached to a ring homomorphism out of the reduced monoid
algebra. -/
noncomputable def deningerReducedToPointed (f : DeningerReducedMonoidAlgebra A →+* R) : A →*₀ R where
  toFun a := f (Ideal.Quotient.mk _ (MonoidAlgebra.single a (1 : ℤ)))
  map_one' := by
    show f (Ideal.Quotient.mk _ (MonoidAlgebra.single (1 : A) (1 : ℤ))) = 1
    rw [← MonoidAlgebra.one_def, map_one, map_one]
  map_zero' := by
    show f (Ideal.Quotient.mk _ (MonoidAlgebra.single (0 : A) (1 : ℤ))) = 0
    have hmem : MonoidAlgebra.single (0 : A) (1 : ℤ) ∈ deningerMonoidAlgebraZeroIdeal A :=
      Ideal.subset_span rfl
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr hmem, map_zero]
  map_mul' a b := by
    show f (Ideal.Quotient.mk _ (MonoidAlgebra.single (a * b) (1 : ℤ)))
      = f (Ideal.Quotient.mk _ (MonoidAlgebra.single a (1 : ℤ)))
        * f (Ideal.Quotient.mk _ (MonoidAlgebra.single b (1 : ℤ)))
    rw [← map_mul, ← map_mul, MonoidAlgebra.single_mul_single, one_mul]

@[simp] theorem deningerReducedToPointed_apply (f : DeningerReducedMonoidAlgebra A →+* R) (a : A) :
    deningerReducedToPointed f a = f (Ideal.Quotient.mk _ (MonoidAlgebra.single a (1 : ℤ))) := rfl

theorem deningerReducedToPointed_injective :
    Function.Injective (deningerReducedToPointed (A := A) (R := R)) := by
  intro f g h
  apply Ideal.Quotient.ringHom_ext
  refine MonoidAlgebra.ringHom_ext ?_ ?_
  · intro b
    have h1 : (MonoidAlgebra.single (1 : A) b : MonoidAlgebra ℤ A)
        = b • (1 : MonoidAlgebra ℤ A) := by
      rw [MonoidAlgebra.one_def, MonoidAlgebra.smul_single, smul_eq_mul, mul_one]
    rw [h1]
    simp
  · intro a
    exact congrArg (fun P : A →*₀ R => P a) h

theorem deningerReducedToPointed_surjective :
    Function.Surjective (deningerReducedToPointed (A := A) (R := R)) := by
  intro P
  set F : MonoidAlgebra ℤ A →+* R :=
    (MonoidAlgebra.lift ℤ R A (P : A →* R) : MonoidAlgebra ℤ A →ₐ[ℤ] R).toRingHom with hF
  have hFsingle : ∀ a : A, F (MonoidAlgebra.single a (1 : ℤ)) = P a := by
    intro a
    show (MonoidAlgebra.lift ℤ R A (P : A →* R)) (MonoidAlgebra.single a (1 : ℤ)) = P a
    simp
  have hker : deningerMonoidAlgebraZeroIdeal A ≤ RingHom.ker F := by
    rw [deningerMonoidAlgebraZeroIdeal, Ideal.span_le]
    rintro x rfl
    show F (MonoidAlgebra.single (0 : A) (1 : ℤ)) = 0
    rw [hFsingle, map_zero]
  refine ⟨Ideal.Quotient.lift _ F hker, ?_⟩
  ext a
  show (Ideal.Quotient.lift _ F hker) (Ideal.Quotient.mk _ (MonoidAlgebra.single a (1 : ℤ))) = P a
  rw [Ideal.Quotient.lift_mk, hFsingle]

/-- **Deninger, §1.**  Ring homomorphisms out of the reduced monoid algebra `ℤ̲A` correspond
bijectively to multiplicative maps `A → R` sending `1` to `1` and `0` to `0`. -/
noncomputable def deningerReducedMonoidAlgebraHomEquiv :
    (DeningerReducedMonoidAlgebra A →+* R) ≃ (A →*₀ R) :=
  Equiv.ofBijective _ ⟨deningerReducedToPointed_injective, deningerReducedToPointed_surjective⟩

end RHTower
