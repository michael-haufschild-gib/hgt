import GaloisForLFunctions.RHTower.DeningerArithmeticHyperbolicLocalization
import Mathlib.RingTheory.AdjoinRoot
import Mathlib.RingTheory.Localization.Away.Basic

/-!
# Hyperbolic localization of the universal Grothendieck--Witt algebra

The universal algebra `ℤ[ε]/(ε² - 1)` becomes `ℤ[1/2]` once the hyperbolic class `1 + ε` is
inverted: the orientation class is forced to `1`, so the hyperbolic class becomes `2` and only
the rank channel survives.

* `DeningerGW` is `ℤ[ε]/(ε² - 1)` and `deningerGWEpsilon_sq` its defining relation.
* `deningerGW_ringHom_ext` says the algebra is generated by `ε` over `ℤ`.
* `deningerGWLoc_epsilon_eq_one` is the collapse of the orientation class after localization.
* `deningerGWLocEquivHalf` is the resulting ring isomorphism `ℤ[ε]/(ε² - 1)[h⁻¹] ≃+* ℤ[1/2]`.
-/

namespace RHTower

open Polynomial

/-- The universal Grothendieck--Witt algebra `ℤ[ε]/(ε² - 1)`. -/
abbrev DeningerGW : Type := AdjoinRoot (X ^ 2 - 1 : ℤ[X])

/-- The orientation class `ε = ⟨-1⟩`. -/
noncomputable def deningerGWEpsilon : DeningerGW := AdjoinRoot.root _

/-- The defining relation `ε² = 1`. -/
theorem deningerGWEpsilon_sq : deningerGWEpsilon ^ 2 = 1 := by
  have h := AdjoinRoot.eval₂_root (X ^ 2 - 1 : ℤ[X])
  simp only [eval₂_sub, eval₂_pow, eval₂_X, eval₂_one] at h
  exact sub_eq_zero.mp h

/-- **The algebra is generated by the orientation class over `ℤ`.**  A ring homomorphism out of
`ℤ[ε]/(ε² - 1)` is determined by the image of `ε`. -/
theorem deningerGW_ringHom_ext {S : Type*} [CommRing S] {F G : DeningerGW →+* S}
    (h : F deningerGWEpsilon = G deningerGWEpsilon) : F = G := by
  refine RingHom.ext fun x => ?_
  induction x using AdjoinRoot.induction_on with
  | ih p =>
    have hmk : (AdjoinRoot.mk (X ^ 2 - 1 : ℤ[X]) p)
        = Polynomial.eval₂ (AdjoinRoot.of (X ^ 2 - 1 : ℤ[X])) deningerGWEpsilon p := by
      rw [deningerGWEpsilon, ← AdjoinRoot.algebraMap_eq, ← Polynomial.aeval_def,
        AdjoinRoot.aeval_eq]
    rw [hmk, Polynomial.hom_eval₂, Polynomial.hom_eval₂, h,
      RingHom.ext_int (F.comp (AdjoinRoot.of (X ^ 2 - 1 : ℤ[X])))
        (G.comp (AdjoinRoot.of (X ^ 2 - 1 : ℤ[X])))]

/-- The hyperbolic localization `ℤ[ε]/(ε² - 1)[h⁻¹]`, `h = 1 + ε`. -/
abbrev DeningerGWLoc : Type := Localization.Away (1 + deningerGWEpsilon)

/-- The hyperbolic class is a unit after localization. -/
theorem deningerGWLoc_isUnit_hyperbolic :
    IsUnit (algebraMap DeningerGW DeningerGWLoc (1 + deningerGWEpsilon)) :=
  IsLocalization.map_units (M := Submonoid.powers (1 + deningerGWEpsilon)) _
    ⟨1 + deningerGWEpsilon, Submonoid.mem_powers _⟩

/-- **Collapse of the orientation class.**  After inverting the hyperbolic class, `ε = 1`:
the involution is trivialised, so no signature information survives. -/
theorem deningerGWLoc_epsilon_eq_one :
    algebraMap DeningerGW DeningerGWLoc deningerGWEpsilon = 1 := by
  obtain ⟨u, hu⟩ := deningerGWLoc_isUnit_hyperbolic
  refine deningerHyperbolicLocalization_epsilon_eq_one
    (algebraMap DeningerGW DeningerGWLoc deningerGWEpsilon) (↑u⁻¹) ?_ ?_
  · rw [← map_pow, deningerGWEpsilon_sq, map_one]
  · have hmap : (1 : DeningerGWLoc) + algebraMap DeningerGW DeningerGWLoc deningerGWEpsilon
        = algebraMap DeningerGW DeningerGWLoc (1 + deningerGWEpsilon) := by
      rw [map_add, map_one]
    rw [hmap, ← hu]
    exact u.mul_inv

/-- **The hyperbolic class becomes `2`.** -/
theorem deningerGWLoc_hyperbolic_eq_two :
    algebraMap DeningerGW DeningerGWLoc (1 + deningerGWEpsilon) = 2 := by
  rw [map_add, map_one, deningerGWLoc_epsilon_eq_one]
  norm_num

/-- **The rank map.**  The ring map `ℤ[ε]/(ε² - 1) → ℤ[1/2]` sending `ε` to `1`. -/
noncomputable def deningerGWToHalf : DeningerGW →+* Localization.Away (2 : ℤ) :=
  AdjoinRoot.lift (algebraMap ℤ (Localization.Away (2 : ℤ))) 1 (by simp)

@[simp] theorem deningerGWToHalf_epsilon :
    deningerGWToHalf deningerGWEpsilon = 1 :=
  AdjoinRoot.lift_root _

/-- The rank map sends the hyperbolic class to `2`. -/
theorem deningerGWToHalf_hyperbolic :
    deningerGWToHalf (1 + deningerGWEpsilon) = 2 := by
  rw [map_add, map_one, deningerGWToHalf_epsilon]
  norm_num

/-- `2` is a unit in `ℤ[1/2]`. -/
theorem deningerHalf_isUnit_two : IsUnit (2 : Localization.Away (2 : ℤ)) := by
  have h : (algebraMap ℤ (Localization.Away (2 : ℤ))) 2 = 2 := map_ofNat _ 2
  rw [← h]
  exact IsLocalization.map_units (M := Submonoid.powers (2 : ℤ)) _
    ⟨(2 : ℤ), Submonoid.mem_powers _⟩

/-- The image of the hyperbolic class under the rank map is a unit. -/
theorem deningerGWToHalf_isUnit_hyperbolic :
    IsUnit (deningerGWToHalf (1 + deningerGWEpsilon)) := by
  rw [deningerGWToHalf_hyperbolic]
  exact deningerHalf_isUnit_two

/-- `2` is a unit in the hyperbolic localization, because it is the hyperbolic class there. -/
theorem deningerGWLoc_isUnit_two : IsUnit ((algebraMap ℤ DeningerGWLoc) 2) := by
  have h : (algebraMap ℤ DeningerGWLoc) 2 = 2 := map_ofNat _ 2
  rw [h, ← deningerGWLoc_hyperbolic_eq_two]
  exact deningerGWLoc_isUnit_hyperbolic

/-- **The localized rank map** `ℤ[ε]/(ε² - 1)[h⁻¹] → ℤ[1/2]`. -/
noncomputable def deningerGWLocToHalf : DeningerGWLoc →+* Localization.Away (2 : ℤ) :=
  IsLocalization.Away.lift (S := DeningerGWLoc) (1 + deningerGWEpsilon)
    (g := deningerGWToHalf) deningerGWToHalf_isUnit_hyperbolic

@[simp] theorem deningerGWLocToHalf_algebraMap (x : DeningerGW) :
    deningerGWLocToHalf (algebraMap DeningerGW DeningerGWLoc x) = deningerGWToHalf x :=
  IsLocalization.lift_eq _ x

/-- **The comparison map back** `ℤ[1/2] → ℤ[ε]/(ε² - 1)[h⁻¹]`. -/
noncomputable def deningerHalfToGWLoc : Localization.Away (2 : ℤ) →+* DeningerGWLoc :=
  IsLocalization.Away.lift (S := Localization.Away (2 : ℤ)) (2 : ℤ)
    (g := algebraMap ℤ DeningerGWLoc) deningerGWLoc_isUnit_two

@[simp] theorem deningerHalfToGWLoc_algebraMap (n : ℤ) :
    deningerHalfToGWLoc (algebraMap ℤ (Localization.Away (2 : ℤ)) n)
      = algebraMap ℤ DeningerGWLoc n :=
  IsLocalization.lift_eq _ n

theorem deningerGWLocToHalf_comp_halfToGWLoc :
    deningerGWLocToHalf.comp deningerHalfToGWLoc
      = RingHom.id (Localization.Away (2 : ℤ)) :=
  IsLocalization.ringHom_ext (Submonoid.powers (2 : ℤ)) (RingHom.ext_int _ _)

theorem deningerHalfToGWLoc_comp_gwLocToHalf :
    deningerHalfToGWLoc.comp deningerGWLocToHalf = RingHom.id DeningerGWLoc := by
  refine IsLocalization.ringHom_ext (Submonoid.powers (1 + deningerGWEpsilon)) ?_
  refine deningerGW_ringHom_ext ?_
  show deningerHalfToGWLoc (deningerGWLocToHalf
      (algebraMap DeningerGW DeningerGWLoc deningerGWEpsilon))
    = algebraMap DeningerGW DeningerGWLoc deningerGWEpsilon
  rw [deningerGWLocToHalf_algebraMap, deningerGWToHalf_epsilon, map_one,
    deningerGWLoc_epsilon_eq_one]

/-- **Hyperbolic localization collapses the Grothendieck--Witt algebra to the rank ring.**
Inverting the hyperbolic class `h = 1 + ε` in `ℤ[ε]/(ε² - 1)` produces exactly `ℤ[1/2]`, with
`ε ↦ 1` and `h ↦ 2`. -/
noncomputable def deningerGWLocEquivHalf : DeningerGWLoc ≃+* Localization.Away (2 : ℤ) where
  toFun := deningerGWLocToHalf
  invFun := deningerHalfToGWLoc
  left_inv x := RingHom.congr_fun deningerHalfToGWLoc_comp_gwLocToHalf x
  right_inv x := RingHom.congr_fun deningerGWLocToHalf_comp_halfToGWLoc x
  map_mul' := map_mul _
  map_add' := map_add _

@[simp] theorem deningerGWLocEquivHalf_apply (x : DeningerGWLoc) :
    deningerGWLocEquivHalf x = deningerGWLocToHalf x := rfl

/-- Under the isomorphism the hyperbolic class is `2`. -/
theorem deningerGWLocEquivHalf_hyperbolic :
    deningerGWLocEquivHalf (algebraMap DeningerGW DeningerGWLoc (1 + deningerGWEpsilon)) = 2 := by
  rw [deningerGWLocEquivHalf_apply, deningerGWLocToHalf_algebraMap,
    deningerGWToHalf_hyperbolic]

/-- Under the isomorphism the orientation class is `1`: the signature channel is gone. -/
theorem deningerGWLocEquivHalf_epsilon :
    deningerGWLocEquivHalf (algebraMap DeningerGW DeningerGWLoc deningerGWEpsilon) = 1 := by
  rw [deningerGWLocEquivHalf_apply, deningerGWLocToHalf_algebraMap, deningerGWToHalf_epsilon]

end RHTower
