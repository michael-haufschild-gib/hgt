theorem boundaryRegularCore77_unit_rectangle_pos {t v : ℝ}
    (ht0 : 0≤t) (ht1 : t≤1) (hv0 : 0≤v) (hv1 : v≤1) :
    0<boundaryRegularCore77 (boundaryH77*t) (boundaryS77*v) := by
  by_cases ht : t=1
  · simpa only [ht,mul_one] using boundaryRegularCore77_clock_face_unit_pos hv0 hv1
  have htp : 0<1-t := by
    have htlt : t<1 := by
      by_contra hn
      have he : t=1 := by linarith
      exact ht he
    linarith
  have hwc (A : ℕ) : 0≤unscaledBernstein 96 A t :=
    mul_nonneg (pow_nonneg ht0 _) (pow_nonneg (sub_nonneg.mpr ht1) _)
  have hwp (B : ℕ) : 0≤unscaledBernstein 36 B v :=
    mul_nonneg (pow_nonneg hv0 _) (pow_nonneg (sub_nonneg.mpr hv1) _)
  rw [←boundaryFullCoefficient77_reconstruction]
  unfold boundaryBernstein77
  apply Finset.sum_pos'
  · intro A hA
    apply Finset.sum_nonneg
    intro B hB
    have hc := boundaryFullCoefficient77_pos
      ⟨A,Finset.mem_range.mp hA⟩ ⟨B,Finset.mem_range.mp hB⟩
    exact mul_nonneg (mul_nonneg hc.le (hwc A)) (hwp B)
  · refine ⟨0,by norm_num,?_⟩
    apply Finset.sum_pos'
    · intro B hB
      have hc := boundaryFullCoefficient77_row0_pos ⟨B,Finset.mem_range.mp hB⟩
      exact mul_nonneg (mul_nonneg hc.le (hwc 0)) (hwp B)
    · by_cases hv : v=1
      · refine ⟨36,by norm_num,?_⟩
        have hc := boundaryFullCoefficient77_row0_pos ⟨36,by norm_num⟩
        simpa [hv,unscaledBernstein] using mul_pos hc (pow_pos htp 96)
      · refine ⟨0,by norm_num,?_⟩
        have hvp : 0<1-v := by
          have hvlt : v<1 := by
            by_contra hn
            have he : v=1 := by linarith
            exact hv he
          linarith
        have hc := boundaryFullCoefficient77_row0_pos ⟨0,by norm_num⟩
        simpa [unscaledBernstein] using
          mul_pos (mul_pos hc (pow_pos htp 96)) (pow_pos hvp 36)

theorem boundaryRegularCore77_global_pos {h s : ℝ}
    (hh0 : 0≤h) (hh1 : h≤boundaryH77) (hs0 : 0≤s) (hs1 : s≤boundaryS77) :
    0<boundaryRegularCore77 h s := by
  have hH : 0<boundaryH77 := by norm_num [boundaryH77]
  have hS : 0<boundaryS77 := by norm_num [boundaryS77]
  have ht0 : 0≤h/boundaryH77 := div_nonneg hh0 hH.le
  have ht1 : h/boundaryH77≤1 := by
    apply (div_le_iff₀ hH).mpr
    simpa using hh1
  have hv0 : 0≤s/boundaryS77 := div_nonneg hs0 hS.le
  have hv1 : s/boundaryS77≤1 := by
    apply (div_le_iff₀ hS).mpr
    simpa using hs1
  have hp := boundaryRegularCore77_unit_rectangle_pos ht0 ht1 hv0 hv1
  have he : boundaryH77*(h/boundaryH77)=h := by field_simp [hH.ne']
  have se : boundaryS77*(s/boundaryS77)=s := by field_simp [hS.ne']
  rw [he,se] at hp
  exact hp


