import GaloisForLFunctions.RHTower.CriticalLocusConeFullness

/-!
# Cone fullness of the splitting weights at the critical locus

For a family of spectral tests holomorphic on a strip around the critical line, symmetric under
conjugation, decaying along the line, with linearly independent line restrictions, the closed convex
cone generated by the second-derivative vectors `(Re Fᵢ''(1/2 + iγ))ᵢ`, `γ ∈ ℝ`, is all of `ℝ^k`:
for every nonzero direction `w` some `γ` has `Σ wᵢ Re Fᵢ''(1/2 + iγ) < 0`.

The proof is elementary.  If the weighted second derivative were nonnegative everywhere on the
line, the line restriction `v(γ) = Re Σ wᵢ Fᵢ(1/2 + iγ)` would satisfy `v'' = −Re G'' ≤ 0`, hence
be concave on `ℝ`; a concave function tending to zero at both ends is identically zero (its slopes
are monotone, so it is monotone in both directions); independence of the line restrictions then
forces `w = 0`.  These second-derivative vectors are the leading weights of the splitting moves
"double line pair at `γ` → off-line quadruple of small displacement".
-/

namespace RHTower

noncomputable section

open Complex ComplexConjugate Set Filter Topology

/-! ## Concave functions vanishing at infinity -/

/-- A concave function on `ℝ` that tends to `0` at `+∞` and at `−∞` is nondecreasing. -/
theorem concaveOn_monotone_of_tendsto_zero {v : ℝ → ℝ} (hv : ConcaveOn ℝ univ v)
    (hpos : Tendsto v atTop (𝓝 0)) : Monotone v := by
  intro x y hxy
  rcases eq_or_lt_of_le hxy with rfl | hlt
  · exact le_rfl
  by_contra hcon
  push Not at hcon
  -- the slope beyond `y` is at most the negative slope on `[x, y]`
  set m : ℝ := (v x - v y) / (y - x) with hm
  have hmpos : 0 < m := by rw [hm]; exact div_pos (by linarith) (by linarith)
  have hslope : ∀ z, y < z → v z ≤ v y - m * (z - y) := by
    intro z hz
    have h := hv.slope_anti_adjacent (mem_univ x) (mem_univ z) hlt hz
    have hzy : 0 < z - y := by linarith
    rw [div_le_iff₀ hzy] at h
    have e : (v y - v x) / (y - x) = -m := by rw [hm]; ring
    rw [e] at h
    linarith
  -- but `v` tends to `0`, so it is eventually `≥ −1`
  have hev : ∀ᶠ z in atTop, -1 ≤ v z := by
    have := hpos.eventually (eventually_ge_nhds (show (-1 : ℝ) < 0 by norm_num))
    exact this
  obtain ⟨Z, hZ⟩ := Filter.eventually_atTop.mp hev
  set z : ℝ := max Z (y + (v y + 2) / m) with hz
  have hz1 : Z ≤ z := le_max_left _ _
  have hz2 : y + (v y + 2) / m ≤ z := le_max_right _ _
  have hzy : y < z := by
    have : 0 < (v y + 2) / m ∨ (v y + 2) / m ≤ 0 := lt_or_ge _ _
    rcases this with h | h
    · linarith
    · -- then `v y ≤ −2`, contradicting `v y ≥ −1` at some large point? use `z ≥ Z` and the slope bound
      have hvy : v y + 2 ≤ 0 := by
        rw [div_le_iff₀ hmpos] at h; linarith
      -- `v` is eventually `≥ −1`, and to the right of `y` it is `≤ v y ≤ −2`
      have := hZ (max Z (y + 1)) (le_max_left _ _)
      have hgt : y < max Z (y + 1) := by linarith [le_max_right Z (y + 1)]
      have := hslope _ hgt
      nlinarith [hmpos, le_max_right Z (y + 1)]
  have h1 := hZ z hz1
  have h2 := hslope z hzy
  have h3 : v y + 2 ≤ m * (z - y) := by
    have : (v y + 2) / m ≤ z - y := by linarith
    rwa [div_le_iff₀ hmpos, mul_comm] at this
  linarith

/-- A concave function on `ℝ` tending to `0` at both ends is identically zero. -/
theorem concaveOn_eq_zero_of_tendsto_zero {v : ℝ → ℝ} (hv : ConcaveOn ℝ univ v)
    (hpos : Tendsto v atTop (𝓝 0)) (hneg : Tendsto v atBot (𝓝 0)) : ∀ x, v x = 0 := by
  have hmono : Monotone v := concaveOn_monotone_of_tendsto_zero hv hpos
  -- reflect: `x ↦ v (−x)` is concave and tends to `0` at `+∞`, hence nondecreasing, so `v` is nonincreasing
  have hv' : ConcaveOn ℝ univ (fun x => v (-x)) := by
    refine ⟨convex_univ, fun x _ y _ a b ha hb hab => ?_⟩
    have := hv.2 (mem_univ (-x)) (mem_univ (-y)) ha hb hab
    have e : a • (-x) + b • (-y) = -(a • x + b • y) := by simp only [smul_eq_mul]; ring
    rw [e] at this
    exact this
  have hpos' : Tendsto (fun x => v (-x)) atTop (𝓝 0) := hneg.comp tendsto_neg_atTop_atBot
  have hanti : Antitone v := by
    intro x y hxy
    have := concaveOn_monotone_of_tendsto_zero hv' hpos' (neg_le_neg hxy)
    simpa using this
  intro x
  -- `v` is constant, and the constant is the limit `0`
  have hconst : ∀ y, v y = v x := fun y => by
    rcases le_total x y with h | h
    · exact le_antisymm (hanti h) (hmono h)
    · exact le_antisymm (hmono h) (hanti h)
  have : Tendsto v atTop (𝓝 (v x)) := by
    have : v = fun _ => v x := funext hconst
    rw [this]; exact tendsto_const_nhds
  exact tendsto_nhds_unique this hpos

/-! ## Derivatives along the critical line -/

/-- The vertical restriction `γ ↦ G(1/2 + iγ)` of a function holomorphic near the line. -/
theorem hasDerivAt_vertical {G : ℂ → ℂ} {γ : ℝ}
    (h : DifferentiableAt ℂ G (1 / 2 + (γ : ℂ) * I)) :
    HasDerivAt (fun x : ℝ => G (1 / 2 + (x : ℂ) * I)) (deriv G (1 / 2 + (γ : ℂ) * I) * I) γ := by
  have h1 : HasDerivAt (fun z : ℂ => G (1 / 2 + z * I)) (deriv G (1 / 2 + (γ : ℂ) * I) * I) (γ : ℂ) := by
    have hz : HasDerivAt (fun z : ℂ => (1 : ℂ) / 2 + z * I) I (γ : ℂ) := by
      simpa using ((hasDerivAt_id (γ : ℂ)).mul_const I).const_add ((1 : ℂ) / 2)
    exact HasDerivAt.comp (γ : ℂ) h.hasDerivAt hz
  exact h1.comp_ofReal

/-- The real part of the vertical restriction has derivative `Re(G'(1/2+iγ) · i)`. -/
theorem hasDerivAt_vertical_re {G : ℂ → ℂ} {γ : ℝ}
    (h : DifferentiableAt ℂ G (1 / 2 + (γ : ℂ) * I)) :
    HasDerivAt (fun x : ℝ => (G (1 / 2 + (x : ℂ) * I)).re) (deriv G (1 / 2 + (γ : ℂ) * I) * I).re γ := by
  have h1 : HasDerivAt (fun z : ℂ => G (1 / 2 + z * I)) (deriv G (1 / 2 + (γ : ℂ) * I) * I) (γ : ℂ) := by
    have hz : HasDerivAt (fun z : ℂ => (1 : ℂ) / 2 + z * I) I (γ : ℂ) := by
      simpa using ((hasDerivAt_id (γ : ℂ)).mul_const I).const_add ((1 : ℂ) / 2)
    exact HasDerivAt.comp (γ : ℂ) h.hasDerivAt hz
  exact h1.real_of_complex

/-! ## Cone fullness of the second-derivative weights -/

/-- **Cone fullness of the splitting weights.**  For a family of tests holomorphic on the strip
`|Re s − 1/2| < θ`, decaying along the critical line, with linearly independent line restrictions,
every nonzero direction `w` has some `γ` with `Σ wᵢ Re Fᵢ''(1/2 + iγ) < 0`. -/
theorem criticalLocus_weight_cone_fullness
    {k : ℕ} (F : Fin k → ℂ → ℂ) {θ : ℝ} (hθ : 0 < θ)
    (hhol : ∀ i, DifferentiableOn ℂ (F i) (criticalStrip θ))
    (hdecay : ∀ i, ∀ ε > 0, ∃ T : ℝ, ∀ γ : ℝ, T ≤ |γ| → ‖F i (1 / 2 + (γ : ℂ) * I)‖ ≤ ε)
    (hindep : ∀ v : Fin k → ℝ,
      (∀ τ : ℝ, ∑ i, v i * (F i (1 / 2 + (τ : ℂ) * I)).re = 0) → v = 0)
    (w : Fin k → ℝ) (hw : w ≠ 0) :
    ∃ γ : ℝ, ∑ i, w i * (iteratedDeriv 2 (F i) (1 / 2 + (γ : ℂ) * I)).re < 0 := by
  by_contra hcon
  push Not at hcon
  -- analyticity of each test and its derivatives at every point of the line
  have hline : ∀ γ : ℝ, (1 / 2 + (γ : ℂ) * I) ∈ criticalStrip θ := by
    intro γ; simp [criticalStrip, hθ]
  have han : ∀ i (γ : ℝ), AnalyticAt ℂ (F i) (1 / 2 + (γ : ℂ) * I) := fun i γ =>
    (hhol i).analyticAt ((isOpen_criticalStrip θ).mem_nhds (hline γ))
  have hd1 : ∀ i (γ : ℝ), DifferentiableAt ℂ (F i) (1 / 2 + (γ : ℂ) * I) := fun i γ =>
    (han i γ).differentiableAt
  have hd2 : ∀ i (γ : ℝ), DifferentiableAt ℂ (deriv (F i)) (1 / 2 + (γ : ℂ) * I) := fun i γ =>
    ((han i γ).deriv).differentiableAt
  -- the line restriction and its two derivatives
  set v : ℝ → ℝ := fun x => ∑ i, w i * (F i (1 / 2 + (x : ℂ) * I)).re with hv
  set v₁ : ℝ → ℝ := fun x => ∑ i, w i * (deriv (F i) (1 / 2 + (x : ℂ) * I) * I).re with hv₁
  set v₂ : ℝ → ℝ := fun x => ∑ i, w i * (deriv (deriv (F i)) (1 / 2 + (x : ℂ) * I) * I * I).re with hv₂
  have hv_deriv : ∀ x, HasDerivAt v (v₁ x) x := by
    intro x
    have := HasDerivAt.fun_sum (u := Finset.univ) (fun i _ => (hasDerivAt_vertical_re (hd1 i x)).const_mul (w i))
    exact this
  have hv₁_deriv : ∀ x, HasDerivAt v₁ (v₂ x) x := by
    intro x
    have hterm : ∀ i, HasDerivAt (fun y : ℝ => (deriv (F i) (1 / 2 + (y : ℂ) * I) * I).re)
        (deriv (deriv (F i)) (1 / 2 + (x : ℂ) * I) * I * I).re x := by
      intro i
      have h1 : HasDerivAt (fun z : ℂ => deriv (F i) (1 / 2 + z * I) * I)
          (deriv (deriv (F i)) (1 / 2 + (x : ℂ) * I) * I * I) (x : ℂ) := by
        have hz : HasDerivAt (fun z : ℂ => (1 : ℂ) / 2 + z * I) I (x : ℂ) := by
          simpa using ((hasDerivAt_id (x : ℂ)).mul_const I).const_add ((1 : ℂ) / 2)
        exact (HasDerivAt.comp (x : ℂ) (hd2 i x).hasDerivAt hz).mul_const I
      exact h1.real_of_complex
    have := HasDerivAt.fun_sum (u := Finset.univ) (fun i _ => (hterm i).const_mul (w i))
    exact this
  have hderiv_v : deriv v = v₁ := funext fun x => (hv_deriv x).deriv
  have hderiv_v₁ : deriv v₁ = v₂ := funext fun x => (hv₁_deriv x).deriv
  -- the second derivative is the negative of the weighted second-derivative sum
  have hv₂_eq : ∀ x, v₂ x = -∑ i, w i * (iteratedDeriv 2 (F i) (1 / 2 + (x : ℂ) * I)).re := by
    intro x
    simp only [hv₂]
    rw [← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [iteratedDeriv_succ, iteratedDeriv_one, mul_assoc, I_mul_I, mul_neg_one, Complex.neg_re]
    ring
  -- concavity
  have hconc : ConcaveOn ℝ univ v := by
    refine concaveOn_univ_of_deriv2_nonpos (fun x => (hv_deriv x).differentiableAt) ?_ ?_
    · rw [hderiv_v]; exact fun x => (hv₁_deriv x).differentiableAt
    · intro x
      have : deriv^[2] v x = deriv (deriv v) x := rfl
      rw [this, hderiv_v, hderiv_v₁, hv₂_eq]
      linarith [hcon x]
  -- decay at both ends
  have hk : 0 < k := by
    rcases Nat.eq_zero_or_pos k with h | h
    · subst h; exact absurd (Subsingleton.elim w 0) hw
    · exact h
  haveI : Nonempty (Fin k) := ⟨⟨0, hk⟩⟩
  have hdec : ∀ ε > 0, ∃ T : ℝ, ∀ γ : ℝ, T ≤ |γ| → |v γ| ≤ ε := by
    intro ε hε
    set W : ℝ := ∑ i, |w i| + 1 with hW
    have hWpos : 0 < W := by
      have : 0 ≤ ∑ i, |w i| := Finset.sum_nonneg fun i _ => abs_nonneg _
      linarith
    choose T hT using fun i => hdecay i (ε / W) (by positivity)
    set S₀ : ℝ := Finset.univ.sup' Finset.univ_nonempty (fun i => |T i|) with hS₀
    refine ⟨max S₀ 0, fun γ hγ => ?_⟩
    have hTi : ∀ i, T i ≤ |γ| := by
      intro i
      have h1 : |T i| ≤ S₀ := Finset.le_sup' (fun i => |T i|) (Finset.mem_univ i)
      have h2 : S₀ ≤ max S₀ 0 := le_max_left _ _
      linarith [le_abs_self (T i)]
    calc |v γ| = |∑ i, w i * (F i (1 / 2 + (γ : ℂ) * I)).re| := rfl
      _ ≤ ∑ i, |w i * (F i (1 / 2 + (γ : ℂ) * I)).re| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ i, |w i| * (ε / W) := by
          refine Finset.sum_le_sum fun i _ => ?_
          rw [abs_mul]
          gcongr
          exact (Complex.abs_re_le_norm _).trans (hT i γ (hTi i))
      _ = (∑ i, |w i|) * (ε / W) := by rw [Finset.sum_mul]
      _ ≤ ε := by
          rw [mul_div_assoc', div_le_iff₀ hWpos]
          have : ∑ i, |w i| ≤ W := by rw [hW]; linarith
          nlinarith [hε.le]
  have hpos : Tendsto v atTop (𝓝 0) := by
    rw [Metric.tendsto_nhds]
    intro ε hε
    obtain ⟨T, hT⟩ := hdec (ε / 2) (by positivity)
    refine Filter.eventually_atTop.mpr ⟨|T| + 1, fun γ hγ => ?_⟩
    rw [Real.dist_eq, sub_zero]
    have : T ≤ |γ| := by linarith [le_abs_self T, le_abs_self γ]
    linarith [hT γ this]
  have hneg : Tendsto v atBot (𝓝 0) := by
    rw [Metric.tendsto_nhds]
    intro ε hε
    obtain ⟨T, hT⟩ := hdec (ε / 2) (by positivity)
    refine Filter.eventually_atBot.mpr ⟨-(|T| + 1), fun γ hγ => ?_⟩
    rw [Real.dist_eq, sub_zero]
    have : T ≤ |γ| := by linarith [le_abs_self T, neg_le_abs γ]
    linarith [hT γ this]
  -- hence `v ≡ 0`, contradicting independence
  have hzero := concaveOn_eq_zero_of_tendsto_zero hconc hpos hneg
  exact hw (hindep w hzero)

end

end RHTower
