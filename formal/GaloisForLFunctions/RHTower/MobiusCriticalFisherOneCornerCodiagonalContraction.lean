import GaloisForLFunctions.HTGeometry.InfiniteFisherOneCornerCodiagonalContraction
import GaloisForLFunctions.RHTower.MobiusCriticalFisherLowerBoundaryBudget

/-!
# Non-diagonal contractions of the physical Möbius Fisher corner

This specializes the infinite joined-codiagonal contraction law to the
actual signed squarefree Möbius state and its critical Fisher tangent.
The reporter contraction may mix the two hard-clock sectors arbitrarily.
-/

open Complex
open scoped InnerProductSpace

noncomputable section

namespace RHTower

open ContinuousLinearMap
open GaloisForLFunctions.HTGeometry

/-- Actual lower corner of the signed squarefree Möbius pointed Fisher
connection at finite Euler parameter and hard-clock aperture. -/
def squarefreeMobiusCriticalFisherLowerBoundary
    (sigma u : ℝ) (hsigma : 1 < sigma) :
    lp (fun _ : ℕ => ℂ) 2 →L[ℂ] lp (fun _ : ℕ => ℂ) 2 :=
  cutoffLowerBoundary
    (squarefreeMobiusCriticalClockCutoff sigma u)
    (pointedFisherConnection
      (infiniteMobiusSignedWeightLp sigma hsigma)
      (infiniteMobiusCriticalFisherTangentLp sigma hsigma))

theorem hsNormSq_squarefreeMobiusCriticalFisherLowerBoundary
    {sigma u : ℝ} (hsigma : 1 < sigma) :
    hsNormSq
        (squarefreeMobiusCriticalFisherLowerBoundary sigma u hsigma) =
      squarefreeMobiusCriticalFisherLowerBoundaryEnergy sigma u := by
  rw [squarefreeMobiusCriticalFisherLowerBoundary,
    squarefreeMobiusCriticalFisherLowerBoundaryEnergy, dif_pos hsigma]

/-- **Physical Möbius one-corner contraction law.**  Pairing the actual
signed Möbius Fisher lower corner with the joined reporter generated by any
contraction costs at most half of the corner's Hilbert--Schmidt energy.
No diagonal, cutoff-commutation, finite-rank, or compactness assumption is
present. -/
theorem
    norm_sq_hsInner_squarefreeMobiusCriticalFisherLowerBoundary_joinedReporter_le_half
    {sigma u : ℝ} (hsigma : 1 < sigma)
    (D : lp (fun _ : ℕ => ℂ) 2 →L[ℂ] lp (fun _ : ℕ => ℂ) 2)
    (hD : ‖D‖ ≤ 1) :
    ‖hsInner
        (squarefreeMobiusCriticalFisherLowerBoundary sigma u hsigma)
        (infiniteFisherOneCornerJoinedReporter
          (squarefreeMobiusCriticalClockCutoff sigma u)
          D
          (infiniteMobiusSignedWeightLp sigma hsigma))‖ ^ 2 ≤
      (1 / 2 : ℝ) *
        squarefreeMobiusCriticalFisherLowerBoundaryEnergy sigma u := by
  rw [← hsNormSq_squarefreeMobiusCriticalFisherLowerBoundary hsigma]
  apply norm_sq_hsInner_infiniteFisherOneCornerJoinedReporter_le_half
  · exact
      ((pointedFisherConnection_isHilbertSchmidt
          (infiniteMobiusSignedWeightLp sigma hsigma)
          (infiniteMobiusCriticalFisherTangentLp sigma hsigma)).comp_right
        (squarefreeMobiusCriticalClockCutoff sigma u)).comp_left
        (1 - squarefreeMobiusCriticalClockCutoff sigma u)
  · exact squarefreeMobiusCriticalClockCutoff_idempotent sigma u
  · exact squarefreeMobiusCriticalClockCutoff_selfAdjoint sigma u
  · exact norm_infiniteMobiusSignedWeightLp hsigma
  · exact hD

end RHTower
