import GaloisForLFunctions.RHTower.DeningerRationalFreeDGroup

/-!
# Centralizers in a group with unique roots, and the abelian case

In a group with unique roots, commuting with a power forces commuting with the element: conjugation
by `x` sends `y` to another `(n+1)`-st root of `y ^ (n+1)`, so it fixes `y`.  Centralizers are
therefore closed under the root operations.

Since the rationalization is generated by the image of the group as a group with roots, this makes
`Bau(G)` abelian whenever `G` is.

* `deningerCommute_of_commute_pow` : centralizers are root closed.
* `deningerRoot_commute` : roots of commuting elements commute.
* `DeningerBau.commute_of_commGroup` : `Bau(G)` is abelian for abelian `G`.
-/

namespace RHTower

section RootClosedCentralizer

variable {H : Type*} [Group H]

/-- **Commuting with a power forces commuting with the element.** -/
theorem deningerCommute_of_commute_pow (hH : DeningerUniquelyDivisible H) {x y : H} (n : ℕ)
    (h : Commute x (y ^ (n + 1))) : Commute x y := by
  have hconj : (x * y * x⁻¹) ^ (n + 1) = y ^ (n + 1) := by
    rw [conj_pow]
    calc x * y ^ (n + 1) * x⁻¹ = (y ^ (n + 1) * x) * x⁻¹ := by rw [h.eq]
      _ = y ^ (n + 1) := by rw [mul_assoc, mul_inv_cancel, mul_one]
  have hxy : x * y * x⁻¹ = y :=
    deningerPow_injective_of_uniquelyDivisible hH _ _ (n + 1) n.succ_pos hconj
  show x * y = y * x
  calc x * y = (x * y * x⁻¹) * x := by rw [mul_assoc, inv_mul_cancel, mul_one]
    _ = y * x := by rw [hxy]

/-- **Roots of commuting elements commute.** -/
theorem deningerRoot_commute (hH : DeningerUniquelyDivisible H) {x y : H} (h : Commute x y)
    (m n : ℕ) :
    Commute (deningerRoot hH m x) (deningerRoot hH n y) := by
  have h1 : Commute y (deningerRoot hH m x) := by
    refine deningerCommute_of_commute_pow hH m ?_
    rw [deningerRoot_pow]
    exact h.symm
  have h2 : Commute (deningerRoot hH m x) y := h1.symm
  refine (deningerCommute_of_commute_pow hH n ?_)
  rw [deningerRoot_pow]
  exact h2

end RootClosedCentralizer

namespace DeningerBau

variable {α : Type*} [CommGroup α]

theorem commute_of_root {x y : DeningerBau α} (n : ℕ) (h : Commute x y) :
    Commute x (DeningerBau.root n y) := by
  refine deningerCommute_of_commute_pow DeningerBau.uniquelyDivisible n ?_
  rw [DeningerBau.root_pow]
  exact h

/-- **The rationalization of an abelian group is abelian.**  The centralizer of any element contains
the image of the group and is closed under the roots, hence is everything. -/
theorem commute_of_commGroup (x y : DeningerBau α) : Commute x y := by
  have hof : ∀ (g : α) (z : DeningerBau α), Commute (DeningerBau.of g) z := by
    intro g
    have hK : Subgroup.centralizer {DeningerBau.of g} = ⊤ := by
      refine DeningerBau.eq_top_of_rootClosed _ (fun n z hz => ?_) (fun a => ?_)
      · refine Subgroup.mem_centralizer_iff.2 fun w hw => ?_
        rw [Set.mem_singleton_iff] at hw
        subst hw
        have hcz : Commute (DeningerBau.of g) z :=
          (Subgroup.mem_centralizer_iff.1 hz _ rfl)
        exact (commute_of_root n hcz)
      · refine Subgroup.mem_centralizer_iff.2 fun w hw => ?_
        rw [Set.mem_singleton_iff] at hw
        subst hw
        show DeningerBau.of g * DeningerBau.of a = DeningerBau.of a * DeningerBau.of g
        rw [← map_mul, ← map_mul, mul_comm]
    intro z
    have : z ∈ Subgroup.centralizer {DeningerBau.of g} := by rw [hK]; trivial
    exact Subgroup.mem_centralizer_iff.1 this _ rfl
  have hK : Subgroup.centralizer {y} = ⊤ := by
    refine DeningerBau.eq_top_of_rootClosed _ (fun n z hz => ?_) (fun a => ?_)
    · refine Subgroup.mem_centralizer_iff.2 fun w hw => ?_
      rw [Set.mem_singleton_iff] at hw
      subst hw
      have hcz : Commute y z := Subgroup.mem_centralizer_iff.1 hz _ rfl
      exact commute_of_root n hcz
    · refine Subgroup.mem_centralizer_iff.2 fun w hw => ?_
      rw [Set.mem_singleton_iff] at hw
      subst hw
      exact (hof a y).symm
  have : x ∈ Subgroup.centralizer {y} := by rw [hK]; trivial
  exact (Subgroup.mem_centralizer_iff.1 this _ rfl).symm

/-- The rationalization of an abelian group, as a commutative group. -/
instance : CommGroup (DeningerBau α) where
  mul_comm x y := commute_of_commGroup x y

end DeningerBau

end RHTower
