import GaloisForLFunctions.RHTower.ThetaCuspRatioSlopeSeam
/-! # Exact algebraic certificate supporting the ratio-source third-slope seam cone. -/

namespace HTGeometry.ThetaRatioSource
noncomputable section

def alphaReal (k : ℝ) : ℝ := 11101498339085097038876780789760 + k * 243611969814651345202243625287680 + k ^ 2 * 1622293002243873003739634737348608 - k ^ 3 * 951485268985028569957268925186048 - k ^ 4 * 59864347164907419438823772560293888 - k ^ 5 * 283535296854382984120030111777947648 - k ^ 6 * 501598888239637321596255364165140480 + k ^ 7 * 14789657204210452513080577854799872 + k ^ 8 * 1291045708506871127168835898929315840 + k ^ 9 * 1857057304049635661130658125591871488 + k ^ 10 * 1774115456270131229255347863828824064 + k ^ 11 * 2553513924065544289288757139581435904 + k ^ 12 * 2332278203785502770295629051072610304 + k ^ 13 * 1590669227848617342487550433398095872 + k ^ 14 * 493575439899345519945299310145437696 - k ^ 15 * 43779136592859411189132903082622976 - k ^ 16 * 76685745847318793595953613738344448 - k ^ 17 * 12791937547871401453266108048998400

theorem alphaReal_eq (k : ℝ) : (alphaReal k:ℂ)=seamSlopeAlpha (k:ℂ) := by
  rw [(seamAlphaNorm (k:ℂ)).property]
  dsimp only [alphaReal,seamAlphaNorm]
  push_cast
  ring

def betaReal (k : ℝ) : ℝ := 66544405812968319697753441566720 + k * 1830477419644012180695698638897152 + k ^ 2 * 19835524149505853050202597137317888 + k ^ 3 * 107286098138228888783110340956127232 + k ^ 4 * 294908049896339186004526804991213568 + k ^ 5 * 321746412720576637985793256911273984 - k ^ 6 * 206646418130599652293018086103056384 - k ^ 7 * 849284447084407554553874440450473984 - k ^ 8 * 1078931388131648465524324577272922112 - k ^ 9 * 1975299843063879082476918562483077120 - k ^ 10 * 3590849682604491970301564265569452032 - k ^ 11 * 3588925997183746388274812249765314560 - k ^ 12 * 2208935674057393117013034742604365824 - k ^ 13 * 575541134921357525651451302362742784 + k ^ 14 * 107789443526915704339627710514987008 + k ^ 15 * 93436436185222413888784022579970048 + k ^ 16 * 12791937547871401453266108048998400

theorem betaReal_eq (k : ℝ) : (betaReal k:ℂ)=seamSlopeBeta (k:ℂ) := by
  rw [(seamBetaNorm (k:ℂ)).property]
  dsimp only [betaReal,seamBetaNorm]
  push_cast
  ring

def alphaUnit (s : ℝ) : ℝ := (60:ℝ)^17*alphaReal ((75+s)/60)
def edgeUnit (s : ℝ) : ℝ := (60:ℝ)^17*(3*alphaReal ((75+s)/60)+betaReal ((75+s)/60))

def unitAlphaNorm (s : ℝ) : {a : ℝ // alphaUnit s=a} := by
  have h : alphaUnit s=alphaUnit s := rfl
  conv at h =>
    rhs
    dsimp only [alphaUnit,alphaReal]
    ring_nf
  exact ⟨_,h⟩


def unitEdgeNorm (s : ℝ) : {a : ℝ // edgeUnit s=a} := by
  have h : edgeUnit s=edgeUnit s := rfl
  conv at h =>
    rhs
    dsimp only [edgeUnit,alphaReal,betaReal]
    ring_nf
  exact ⟨_,h⟩


end
end HTGeometry.ThetaRatioSource
