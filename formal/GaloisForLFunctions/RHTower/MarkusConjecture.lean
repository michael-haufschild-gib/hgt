/-!
# Markus's conjecture

`zeta` satisfies no algebraic differential equation whose coefficients are polynomial in `Gamma`
and its derivatives.

The proof runs through the digamma.  Hölder's difference-equation descent, carried out in the
Dirichlet coordinate `s = -I z`, makes the digamma jets algebraically independent over the field
generated by `C(s)` and *every* convergent Dirichlet series; the von Mangoldt echelon makes the
zeta jets algebraically independent over `C(s)`.  Together these give joint independence of the
two jet families, hence — reading the same joint independence the other way — hypertranscendence of
`zeta` over `C(s)<psi>`.

Finally `Gamma' = psi * Gamma` is a first-order affine relation with coefficients in `C(s)<psi>`,
so adjoining `Gamma` is a differentially algebraic base change and cannot make `zeta`
differentially algebraic.
-/

open Filter Set Complex
open scoped Differential

namespace RHTower

open GaloisForLFunctions
open GaloisForLFunctions.HTGeometry

noncomputable section

open scoped UpperEndDifferentialInstances
open scoped UpperEndComplexTowerInstances

/-! ## Narrowing the base of a hypertranscendence statement -/

/-- Hypertranscendence over a larger coefficient field implies it over a smaller one. -/
theorem hypertranscendentalOver_of_ringHom {K : Type*} [Field K] [Differential K]
    {A B : Type*} [Field A] [Field B] [Algebra A K] [Algebra B K]
    (phi : A →+* B)
    (hphi : ∀ a : A, algebraMap B K (phi a) = algebraMap A K a)
    {x : K} (h : HypertranscendentalOver B x) :
    HypertranscendentalOver A x := by
  intro hda
  letI : Algebra A B := phi.toAlgebra
  haveI : IsScalarTower A B K := IsScalarTower.of_algebraMap_eq fun a => (hphi a).symm
  exact h (differentialAlgebraicOver_mono hda)

/-- Hypertranscendence over a larger intermediate field implies it over a smaller one, even when
the two are built over different coefficient fields. -/
theorem hypertranscendentalOver_of_le {K : Type*} [Field K] [Differential K]
    {F₁ F₂ : Type*} [Field F₁] [Field F₂] [Algebra F₁ K] [Algebra F₂ K]
    (A : IntermediateField F₁ K) (B : IntermediateField F₂ K)
    (hAB : ∀ a ∈ A, a ∈ B) {x : K}
    (h : HypertranscendentalOver B x) : HypertranscendentalOver A x := by
  let phi : A →+* B :=
    { toFun := fun a => ⟨a.1, hAB a.1 a.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  exact hypertranscendentalOver_of_ringHom phi (fun _ => rfl) h

/-! ## The rotated Gamma germ -/

/-- `Gamma` in the Dirichlet coordinate. -/
def rotGammaFun : ℂ → ℂ := fun z => Complex.Gamma (-Complex.I * z)

/-- The reciprocal of `Gamma` in the Dirichlet coordinate. -/
def rotGammaInvFun : ℂ → ℂ := fun z => (Complex.Gamma (-Complex.I * z))⁻¹

theorem analyticOnNhd_rotGammaFun : AnalyticOnNhd ℂ rotGammaFun (upperTail 0) :=
  analyticOnNhd_Gamma_rightHalf.comp analyticOnNhd_rot rot_maps_rightHalf

theorem analyticOnNhd_rotGammaInvFun : AnalyticOnNhd ℂ rotGammaInvFun (upperTail 0) := by
  refine AnalyticOnNhd.inv analyticOnNhd_rotGammaFun ?_
  intro z hz
  exact Complex.Gamma_ne_zero (rot_ne_negNat hz)

/-- The rotated Gamma as an upper-end analytic germ. -/
def rotGammaAnalytic : upperEndAnalyticSubring :=
  ⟨(Germ.coeRingHom upperEndFilter rotGammaFun),
    ⟨rotGammaFun, 0, analyticOnNhd_rotGammaFun, rfl⟩⟩

/-- Its reciprocal, also an upper-end analytic germ. -/
def rotGammaInvAnalytic : upperEndAnalyticSubring :=
  ⟨(Germ.coeRingHom upperEndFilter rotGammaInvFun),
    ⟨rotGammaInvFun, 0, analyticOnNhd_rotGammaInvFun, rfl⟩⟩

/-- The rotated Gamma in the upper-end meromorphic field. -/
def rotGammaMero : upperEndMeroField :=
  algebraMap upperEndAnalyticSubring upperEndMeroField rotGammaAnalytic

theorem rotGammaAnalytic_mul_inv : rotGammaAnalytic * rotGammaInvAnalytic = 1 := by
  apply Subtype.ext
  change (Germ.coeRingHom upperEndFilter rotGammaFun)
      * (Germ.coeRingHom upperEndFilter rotGammaInvFun) = 1
  rw [← map_mul]
  have hev : ∀ᶠ z : ℂ in upperEndFilter, rotGammaFun z * rotGammaInvFun z = 1 := by
    rw [upperEndFilter_basis.eventually_iff]
    refine ⟨0, trivial, fun z hz => ?_⟩
    have hne : Complex.Gamma (-Complex.I * z) ≠ 0 := Complex.Gamma_ne_zero (rot_ne_negNat hz)
    show Complex.Gamma (-Complex.I * z) * (Complex.Gamma (-Complex.I * z))⁻¹ = 1
    rw [mul_inv_cancel₀ hne]
  exact Germ.coe_eq.mpr hev

theorem rotGammaMero_ne_zero : rotGammaMero ≠ 0 := by
  intro h
  have hmul : rotGammaMero
      * algebraMap upperEndAnalyticSubring upperEndMeroField rotGammaInvAnalytic = 1 := by
    rw [rotGammaMero, ← map_mul, rotGammaAnalytic_mul_inv, map_one]
  rw [h, zero_mul] at hmul
  exact zero_ne_one hmul

theorem deriv_rotGammaFun {z : ℂ} (hz : z ∈ upperTail 0) :
    deriv rotGammaFun z = -Complex.I * rotDigammaFun z * rotGammaFun z := by
  have hne : Complex.Gamma (-Complex.I * z) ≠ 0 := Complex.Gamma_ne_zero (rot_ne_negNat hz)
  have hG : HasDerivAt Complex.Gamma (deriv Complex.Gamma (-Complex.I * z)) (-Complex.I * z) :=
    (Complex.differentiableAt_Gamma _ (rot_ne_negNat hz)).hasDerivAt
  have hlin : HasDerivAt (fun w : ℂ => -Complex.I * w) (-Complex.I) z := by
    simpa using (hasDerivAt_id z).const_mul (-Complex.I)
  have hcomp : HasDerivAt rotGammaFun
      (deriv Complex.Gamma (-Complex.I * z) * -Complex.I) z := hG.comp z hlin
  rw [hcomp.deriv]
  show deriv Complex.Gamma (-Complex.I * z) * -Complex.I
    = -Complex.I * (deriv Complex.Gamma (-Complex.I * z) / Complex.Gamma (-Complex.I * z))
      * Complex.Gamma (-Complex.I * z)
  rw [mul_assoc, div_mul_cancel₀ _ hne]
  ring

theorem upperEndAnalyticDeriv_rotGammaAnalytic :
    upperEndAnalyticDeriv rotGammaAnalytic
      = upperEndPolyToAnalytic (Polynomial.C (-Complex.I))
        * rotDigammaAnalytic * rotGammaAnalytic := by
  apply Subtype.ext
  rw [upperEndAnalyticDeriv_coe]
  show upperEndGermDeriv (Germ.coeRingHom upperEndFilter rotGammaFun)
    = ((upperEndPolyToAnalytic (Polynomial.C (-Complex.I)) : upperEndAnalyticSubring) :
        Germ upperEndFilter ℂ)
      * (Germ.coeRingHom upperEndFilter rotDigammaFun)
      * (Germ.coeRingHom upperEndFilter rotGammaFun)
  have hconst : ((upperEndPolyToAnalytic (Polynomial.C (-Complex.I)) : upperEndAnalyticSubring) :
      Germ upperEndFilter ℂ) = Germ.coeRingHom upperEndFilter (fun _ : ℂ => -Complex.I) := by
    refine Germ.coe_eq.mpr (Filter.Eventually.of_forall fun z => ?_)
    simp
  rw [hconst, ← map_mul, ← map_mul]
  have hev : ∀ᶠ z : ℂ in upperEndFilter,
      deriv rotGammaFun z = -Complex.I * rotDigammaFun z * rotGammaFun z := by
    rw [upperEndFilter_basis.eventually_iff]
    exact ⟨0, trivial, fun z hz => deriv_rotGammaFun hz⟩
  exact Germ.coe_eq.mpr hev

/-- **The rotated Gamma satisfies a first-order affine relation over the digamma.** -/
theorem deriv_rotGammaMero :
    (rotGammaMero)′
      = algebraMap ℂ upperEndMeroField (-Complex.I) * rotDigammaMero * rotGammaMero := by
  rw [rotGammaMero, upperEndMeroFieldDifferential_algebraMap,
    upperEndAnalyticDeriv_rotGammaAnalytic, map_mul, map_mul]
  rfl

/-! ## Joint independence of the zeta and digamma jets -/

/-- The zeta jets. -/
def zetaJetMero (n : ℕ) : upperEndMeroField :=
  differentialJet n zetaUpperEndMero

theorem coordMero_mem_dirZetaBase : upperEndCoordinateMero ∈ dirZetaBase := by
  have hI : algebraMap ℂ upperEndMeroField Complex.I
      * algebraMap ℂ upperEndMeroField (-Complex.I) = 1 := by
    rw [← map_mul, show Complex.I * (-Complex.I) = 1 by
      rw [mul_neg, Complex.I_mul_I]; ring]
    exact map_one _
  have hco : upperEndCoordinateMero
      = algebraMap ℂ upperEndMeroField Complex.I * dirCoordMero := by
    rw [dirCoordMero_eq, ← mul_assoc, hI, one_mul, coordMero_eq_upperEndCoordinateMero]
  rw [hco]
  exact mul_mem (dirZetaBase.algebraMap_mem _) dirCoordMero_mem_dirZetaBase

theorem coordField_le_dirZetaBase : upperEndRationalCoordinateField ≤ dirZetaBase := by
  refine IntermediateField.adjoin_le_iff.mpr ?_
  rintro x hx
  rw [Set.mem_singleton_iff] at hx
  subst hx
  exact coordMero_mem_dirZetaBase

theorem zetaJetMero_mem_dirZetaBase (n : ℕ) : zetaJetMero n ∈ dirZetaBase := by
  rw [zetaJetMero, zetaUpperEndMero, differentialJet_finiteAbscissaLSeriesToUpperEndMero]
  exact lseries_mem_dirZetaBase _

theorem algebraicIndependent_zetaJetMero :
    AlgebraicIndependent (upperEndRationalCoordinateField : Type _) zetaJetMero := by
  have h := zetaUpperEndMero_hypertranscendentalOver
  rw [hypertranscendentalOver_iff_differentialIndependent_singleton] at h
  have h' : AlgebraicIndependent (upperEndRationalCoordinateField : Type _)
      (fun p : Unit × ℕ => differentialJet p.2 zetaUpperEndMero) := h
  have hinj : Function.Injective (fun n : ℕ => ((() : Unit), n)) := by
    intro a b hab
    simpa using hab
  exact h'.comp (fun n : ℕ => ((() : Unit), n)) hinj

/-- **Joint freeness of the zeta and digamma jets over `C(s)`.** -/
theorem algebraicIndependent_sumElim :
    AlgebraicIndependent (upperEndRationalCoordinateField : Type _)
      (Sum.elim rotDigammaJetMero zetaJetMero) := by
  refine AlgebraicIndependent.sumElim_iff.mpr ⟨algebraicIndependent_zetaJetMero, ?_⟩
  refine HTGeometry.algebraicIndependent_adjoin_of_le
    coordField_le_dirZetaBase ?_ algebraicIndependent_rotDigammaJetMero
  rintro _ ⟨n, rfl⟩
  exact zetaJetMero_mem_dirZetaBase n

/-- **Zeta is hypertranscendental over the differential field generated by the digamma.** -/
theorem zeta_hypertranscendentalOver_digamma :
    HypertranscendentalOver
      (differentialAdjoin upperEndRationalCoordinateField
        ({rotDigammaMero} : Set upperEndMeroField)) zetaUpperEndMero := by
  have hswap : AlgebraicIndependent (upperEndRationalCoordinateField : Type _)
      (Sum.elim zetaJetMero rotDigammaJetMero) := by
    have h := algebraicIndependent_sumElim.comp (Equiv.sumComm ℕ ℕ) (Equiv.sumComm ℕ ℕ).injective
    have heq : (Sum.elim rotDigammaJetMero zetaJetMero) ∘ (Equiv.sumComm ℕ ℕ)
        = Sum.elim zetaJetMero rotDigammaJetMero := by
      funext w
      rcases w with a | b <;> rfl
    rwa [heq] at h
  have hadj := (AlgebraicIndependent.sumElim_iff.mp hswap).2
  have hrange : differentialJetSet ({rotDigammaMero} : Set upperEndMeroField)
      = Set.range rotDigammaJetMero := by
    ext y
    constructor
    · rintro ⟨x, hx, n, rfl⟩
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact ⟨n, rfl⟩
    · rintro ⟨n, rfl⟩
      exact ⟨rotDigammaMero, Set.mem_singleton _, n, rfl⟩
  have hfield : AlgebraicIndependent
      (IntermediateField.adjoin (upperEndRationalCoordinateField : Type _)
        (Set.range rotDigammaJetMero) : Type _) zetaJetMero :=
    IntermediateField.algebraicIndependent_adjoin_iff.mpr hadj
  rw [hypertranscendentalOver_iff_differentialIndependent_singleton]
  rw [differentialAdjoin, hrange]
  exact hfield.comp (fun p : Unit × ℕ => p.2) (by
    rintro ⟨u1, m⟩ ⟨u2, n⟩ h
    simp only at h
    subst h
    rfl)

/-! ## The Gamma base change -/

/-- The digamma differential field. -/
def digammaBase : IntermediateField upperEndRationalCoordinateField upperEndMeroField :=
  differentialAdjoin upperEndRationalCoordinateField ({rotDigammaMero} : Set upperEndMeroField)

local instance markusDigammaBaseDifferential : Differential digammaBase :=
  derivationClosedDifferential _
    (derivationClosed_differentialAdjoin upperEndRationalCoordinateField _)

local instance markusDigammaBaseDifferentialAlgebra :
    DifferentialAlgebra digammaBase upperEndMeroField where
  deriv_algebraMap _ := rfl

theorem rotDigammaMero_mem_digammaBase : rotDigammaMero ∈ digammaBase :=
  subset_differentialAdjoin _ _ (Set.mem_singleton _)

/-- **`Gamma` is differentially algebraic over the digamma field.** -/
theorem rotGammaMero_differentialAlgebraicOver_digammaBase :
    DifferentialAlgebraicOver digammaBase rotGammaMero := by
  refine differentialAlgebraicOver_of_deriv_eq_base_mul_add
    (F := digammaBase) (E := upperEndMeroField)
    ⟨algebraMap ℂ upperEndMeroField (-Complex.I) * rotDigammaMero,
      mul_mem (digammaBase.algebraMap_mem
        (algebraMap ℂ upperEndRationalCoordinateField (-Complex.I)))
        rotDigammaMero_mem_digammaBase⟩ 0 ?_
  rw [deriv_rotGammaMero]
  show _ = algebraMap ℂ upperEndMeroField (-Complex.I) * rotDigammaMero * rotGammaMero
    + algebraMap digammaBase upperEndMeroField 0
  rw [_root_.map_zero, add_zero]

/-- The Gamma differential field over `C(s)`. -/
def gammaBase : IntermediateField upperEndRationalCoordinateField upperEndMeroField :=
  differentialAdjoin upperEndRationalCoordinateField ({rotGammaMero} : Set upperEndMeroField)

theorem gammaBase_le_digammaGammaBase :
    ∀ a ∈ gammaBase, a ∈ differentialAdjoin digammaBase ({rotGammaMero} : Set upperEndMeroField) :=
  by
  intro a ha
  refine IntermediateField.adjoin_induction
    (F := (upperEndRationalCoordinateField : Type _))
    (p := fun z _ => z ∈ differentialAdjoin digammaBase ({rotGammaMero} : Set upperEndMeroField))
    ?_ ?_ ?_ ?_ ?_ ha
  · rintro y ⟨x, hx, n, rfl⟩
    rw [Set.mem_singleton_iff] at hx
    subst hx
    exact differentialJet_mem_differentialAdjoin digammaBase (Set.mem_singleton _) n
  · intro c
    have hc : (c : upperEndMeroField) ∈ digammaBase := digammaBase.algebraMap_mem c
    exact (differentialAdjoin digammaBase
      ({rotGammaMero} : Set upperEndMeroField)).algebraMap_mem ⟨(c : upperEndMeroField), hc⟩
  · intro p q _ _ hp hq
    exact add_mem hp hq
  · intro p _ hp
    exact inv_mem hp
  · intro p q _ _ hp hq
    exact mul_mem hp hq

/-- Adjoining `Gamma` to the digamma field leaves `zeta` hypertranscendental. -/
theorem zeta_hypertranscendentalOver_digammaGamma :
    HypertranscendentalOver
      (differentialAdjoin digammaBase ({rotGammaMero} : Set upperEndMeroField))
      zetaUpperEndMero :=
  (hypertranscendentalOver_differentialAdjoinSingleton_iff
    rotGammaMero_differentialAlgebraicOver_digammaBase).mpr
    zeta_hypertranscendentalOver_digamma

/-- **Markus's conjecture.**  The Riemann zeta germ satisfies no algebraic differential equation
whose coefficients are rational in the coordinate and polynomial in `Gamma` and its derivatives. -/
theorem markus_conjecture :
    HypertranscendentalOver gammaBase zetaUpperEndMero :=
  hypertranscendentalOver_of_le gammaBase
    (differentialAdjoin digammaBase ({rotGammaMero} : Set upperEndMeroField))
    gammaBase_le_digammaGammaBase zeta_hypertranscendentalOver_digammaGamma

end

