import GaloisForLFunctions.RHTower.XiCriticalLineThinStripSourceProjector

/-!
# Entire exponential Euler gauges do not change the thin-strip source contour

A finite exponential Dirichlet gauge can cancel any prescribed finite packet of prime
log-derivative coefficients while remaining entire and zero-free.  This makes it look like a
possible mollifier for the corrected critical-feature budget.

The full weighted rectangle exposes the compensation: the logarithmic derivative of the gauge is
an entire derivative, its product with the pole-free critical-feature weight is holomorphic, and
its closed-contour contribution is exactly zero.  Thus finite coefficient cancellation only moves
mass between boundary channels; it cannot lower the source contour that extracts the Xi divisor.
-/

open Complex Set
open scoped BigOperators

namespace RHTower

noncomputable section

/-- Finite exponential Dirichlet potential supported on a chosen prime packet. -/
def finitePrimeExponentialPotential (P : Finset Nat.Primes)
    (a : Nat.Primes → ℂ) (z : ℂ) : ℂ :=
  ∑ p ∈ P, a p * (((p : ℕ) : ℂ) ^ (-z))

/-- Every finite prime potential is entire. -/
theorem analyticOnNhd_finitePrimeExponentialPotential
    (P : Finset Nat.Primes) (a : Nat.Primes → ℂ) :
    AnalyticOnNhd ℂ (finitePrimeExponentialPotential P a) Set.univ := by
  intro z hz
  change AnalyticAt ℂ
    (fun w => ∑ p ∈ P, a p * (((p : ℕ) : ℂ) ^ (-w))) z
  exact Finset.analyticAt_fun_sum P fun p hp => by
    have hp0 : (((p : ℕ) : ℂ)) ≠ 0 := by
      exact_mod_cast p.2.pos.ne'
    have hpow : Differentiable ℂ
        (fun w : ℂ => (((p : ℕ) : ℂ) ^ (-w))) :=
      differentiable_id.neg.const_cpow (Or.inl hp0)
    exact analyticAt_const.mul (hpow.analyticAt z)

/-- Exact prime-frequency derivative of the finite potential. -/
theorem deriv_finitePrimeExponentialPotential
    (P : Finset Nat.Primes) (a : Nat.Primes → ℂ) (z : ℂ) :
    deriv (finitePrimeExponentialPotential P a) z =
      ∑ p ∈ P, a p *
        ((((p : ℕ) : ℂ) ^ (-z)) * Complex.log ((p : ℕ) : ℂ) * (-1)) := by
  have hsum := HasDerivAt.sum (𝕜 := ℂ) (F := ℂ) (x := z) (u := P)
      (A := fun p w => a p * (((p : ℕ) : ℂ) ^ (-w)))
      (A' := fun p => a p *
        ((((p : ℕ) : ℂ) ^ (-z)) * Complex.log ((p : ℕ) : ℂ) * (-1)))
      (fun p hp => by
        have hp0 : (((p : ℕ) : ℂ)) ≠ 0 := by
          exact_mod_cast p.2.pos.ne'
        have hpow := (Complex.hasStrictDerivAt_const_cpow
          (x := ((p : ℕ) : ℂ)) (y := -z) (Or.inl hp0)).hasDerivAt.comp z
            (hasDerivAt_id z).neg
        exact hpow.const_mul (a p))
  have hfun : finitePrimeExponentialPotential P a =
      ∑ p ∈ P, fun w => a p * (((p : ℕ) : ℂ) ^ (-w)) := by
    funext w
    simp only [finitePrimeExponentialPotential, Finset.sum_apply]
  rw [hfun]
  exact hsum.deriv

/-- Coefficients `a(p) = -1` cancel the first-power prime terms of `zeta'/zeta`: the gauge
logarithmic derivative is `sum_{p in P} log(p) p^{-s}`. -/
theorem deriv_finitePrimeCancellationPotential
    (P : Finset Nat.Primes) (z : ℂ) :
    deriv (finitePrimeExponentialPotential P (fun _ => -1)) z =
      ∑ p ∈ P,
        (((p : ℕ) : ℂ) ^ (-z)) * Complex.log ((p : ℕ) : ℂ) := by
  rw [deriv_finitePrimeExponentialPotential]
  apply Finset.sum_congr rfl
  intro p hp
  ring

/-- Zero-free exponential gauge generated by the finite prime potential. -/
def finitePrimeExponentialGauge (P : Finset Nat.Primes)
    (a : Nat.Primes → ℂ) (z : ℂ) : ℂ :=
  Complex.exp (finitePrimeExponentialPotential P a z)

theorem finitePrimeExponentialGauge_ne_zero
    (P : Finset Nat.Primes) (a : Nat.Primes → ℂ) (z : ℂ) :
    finitePrimeExponentialGauge P a z ≠ 0 :=
  Complex.exp_ne_zero _

/-- The logarithmic derivative of the zero-free gauge is exactly the derivative of its
potential. -/
theorem logDeriv_finitePrimeExponentialGauge
    (P : Finset Nat.Primes) (a : Nat.Primes → ℂ) (z : ℂ) :
    logDeriv (finitePrimeExponentialGauge P a) z =
      deriv (finitePrimeExponentialPotential P a) z := by
  have hpot : DifferentiableAt ℂ (finitePrimeExponentialPotential P a) z :=
    (analyticOnNhd_finitePrimeExponentialPotential P a z
      (Set.mem_univ z)).differentiableAt
  change deriv
      (fun w => Complex.exp (finitePrimeExponentialPotential P a w)) z /
        Complex.exp (finitePrimeExponentialPotential P a z) =
      deriv (finitePrimeExponentialPotential P a) z
  rw [(hpot.hasDerivAt.cexp).deriv]
  field_simp [finitePrimeExponentialGauge_ne_zero P a z]

/-- Weighted thin-strip contribution of an analytic additive gauge current. -/
def criticalFeatureEntireGaugeContourContribution
    (h : ℂ → ℂ) (t A B delta : ℝ) : ℂ :=
  (2 * Real.pi * I : ℂ)⁻¹ *
    rectIntegral
      (fun z => criticalFeatureCauchyKernelTest t z ^ 2 * deriv h z)
      (xiThinStripLowerCorner A delta)
      (xiThinStripUpperCorner B delta)

/-- **Entire-gauge invariance.**  An analytic gauge current contributes exactly zero to the full
critical-feature thin-strip contour. -/
theorem criticalFeatureEntireGaugeContourContribution_eq_zero
    {h : ℂ → ℂ} {t A B delta : ℝ}
    (hdelta0 : 0 ≤ delta) (hdelta1 : delta < 1)
    (hh : AnalyticOnNhd ℂ h (criticalFeaturePoleFreeDomain t)) :
    criticalFeatureEntireGaugeContourContribution h t A B delta = 0 := by
  have hrect : rectIntegral
      (fun z => criticalFeatureCauchyKernelTest t z ^ 2 * deriv h z)
      (xiThinStripLowerCorner A delta)
      (xiThinStripUpperCorner B delta) = 0 := by
    apply rectIntegral_eq_zero_of_analyticOnNhd
      (xiThinStrip_rectangle_subset_criticalFeaturePoleFreeDomain
        t A B delta hdelta0 hdelta1)
    exact (analyticOnNhd_criticalFeatureCauchyKernelTest_sq t).mul hh.deriv
  rw [criticalFeatureEntireGaugeContourContribution, hrect, mul_zero]

/-- The apparent finite-prime cancellation has zero net weighted rectangle contribution. -/
theorem finitePrimeExponentialGaugeContourContribution_eq_zero
    (P : Finset Nat.Primes) (a : Nat.Primes → ℂ)
    {t A B delta : ℝ} (hdelta0 : 0 ≤ delta) (hdelta1 : delta < 1) :
    (2 * Real.pi * I : ℂ)⁻¹ *
        rectIntegral
          (fun z => criticalFeatureCauchyKernelTest t z ^ 2 *
            logDeriv (finitePrimeExponentialGauge P a) z)
          (xiThinStripLowerCorner A delta)
          (xiThinStripUpperCorner B delta) = 0 := by
  simp_rw [logDeriv_finitePrimeExponentialGauge]
  exact criticalFeatureEntireGaugeContourContribution_eq_zero
    hdelta0 hdelta1
      ((analyticOnNhd_finitePrimeExponentialPotential P a).mono
        (Set.subset_univ _))

end

end RHTower
