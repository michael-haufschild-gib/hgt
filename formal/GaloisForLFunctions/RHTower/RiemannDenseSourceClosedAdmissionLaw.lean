import GaloisForLFunctions.RHTower.DeningerCalderonWittCompletedXiGreenIncidenceComparison
import GaloisForLFunctions.RHTower.RiemannSingularGreenHodgeAdmissionLaw
import Mathlib.Topology.Closure

/-!
# Dense-source closed-admission law for the Riemann boundary

The completed Xi Green comparison has dense range in the honest Hilbert
completion generated by actual Calderón--Witt incidence relations.  The
Gamma/co-Poisson Hodge boundary has a finite canonical incidence witness
which is admitted exactly at zero modular displacement.

This module identifies the exact topological statement joining them.  One
does not need a bounded extension of the singular boundary defect.  It is
enough to construct a closed admission set in the completed incidence
carrier which:

* contains every completed source Green vector; and
* has the correct finite trace on one canonical incidence vector.

Density then makes the admission set the whole completion.  Its finite
trace contains the canonical Gamma witness, forcing zero displacement.
Conversely, at zero displacement the whole completion is such an
admission set.

At an Xi divisor fibre this existence statement is therefore equivalent
to critical-line placement, and its global form is equivalent to RH.  The
result isolates the remaining producer theorem without postulating a new
source or a new completed transport.
-/

open Set

namespace RHTower

noncomputable section

/--
A closed set containing the dense range of a source transport is the whole
target.  This is the route-independent topological core of closed
source-admission.
-/
theorem denseSource_closedAdmission_eq_univ
    {E H : Type*} [TopologicalSpace H]
    (U : E → H) (hU : DenseRange U)
    (K : Set H) (hKclosed : IsClosed K)
    (hland : ∀ x, U x ∈ K) :
    K = Set.univ := by
  apply Set.eq_univ_iff_forall.2
  intro y
  have hrange : Set.range U ⊆ K := by
    rintro _ ⟨x, rfl⟩
    exact hland x
  exact closure_minimal hrange hKclosed (hU y)

/--
One finite divisor coordinate in completed incidence.  Its coefficient is
one and its decoded source value is the actual nonzero cross-prime
Calderón--Witt Gamma witness.
-/
def deningerCanonicalCompletedIncidenceVector
    (p q : Nat.Primes) (hpq : p ≠ q)
    (r : XiZeroCopy) :
    DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq :=
  deningerCompletedXiToCrossPrimeIncidenceCompletion p q hpq
    (deningerArithmeticJetTestToHilbert (Finsupp.single r 1))

theorem deningerCanonicalCompletedIncidenceVector_sourceValue
    (p q : Nat.Primes) (hpq : p ≠ q)
    (r : XiZeroCopy) :
    deningerCalderonWittCrossPrimeXiIncidenceCompletionSourceValue
        p q hpq r
        (deningerCanonicalCompletedIncidenceVector p q hpq r) =
      deningerCalderonWittCrossPrimeGammaWitness hpq := by
  rw [deningerCanonicalCompletedIncidenceVector,
    deningerCalderonWittCrossPrimeXiIncidenceCompletionSourceValue_xi,
    deningerArithmeticJetTestToHilbert_apply]
  simp

/--
The exact missing completed-admission datum at modular displacement `a`.

The set need not be the kernel of a bounded operator.  Closedness is the
only regularity requested.  `completedGreen_lands` is the source-side
producer statement.  `finiteWitness_exact` says its finite trace is the
already constructed algebraic Gamma/Hodge admission law.
-/
structure DeningerCompletedXiClosedHodgeAdmission
    (p q : Nat.Primes) (hpq : p ≠ q)
    (r : XiZeroCopy) (a : ℝ) : Type where
  admitted :
    Set (DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq)
  isClosed_admitted : IsClosed admitted
  completedGreen_lands :
    ∀ ell : DeningerArithmeticTopologicalH1Compact,
      deningerArithmeticCompletedGreenToCrossPrimeIncidence
          p q hpq ell ∈ admitted
  finiteWitness_exact :
    deningerCanonicalCompletedIncidenceVector p q hpq r ∈ admitted ↔
      deningerCalderonWittCrossPrimeGammaWitness hpq ∈
        deningerCalderonWittGammaAdmittedHodgeSector a

/--
**Dense-source closed-admission classification.**

A closed completed admission set containing every source Green vector and
having the correct finite Gamma/Hodge trace exists exactly at zero modular
displacement.
-/
theorem exists_deningerCompletedXiClosedHodgeAdmission_iff
    (p q : Nat.Primes) (hpq : p ≠ q)
    (r : XiZeroCopy) (a : ℝ) :
    Nonempty (DeningerCompletedXiClosedHodgeAdmission p q hpq r a) ↔
      a = 0 := by
  constructor
  · rintro ⟨A⟩
    have huniv : A.admitted = Set.univ :=
      denseSource_closedAdmission_eq_univ
        (deningerArithmeticCompletedGreenToCrossPrimeIncidence p q hpq)
        (deningerArithmeticCompletedGreenToCrossPrimeIncidence_dense p q hpq)
        A.admitted A.isClosed_admitted A.completedGreen_lands
    have hcanonical :
        deningerCanonicalCompletedIncidenceVector p q hpq r ∈
          A.admitted := by
      rw [huniv]
      trivial
    have hwitness :=
      A.finiteWitness_exact.mp hcanonical
    exact
      (deningerCalderonWittCrossPrimeGammaWitness_mem_admittedHodgeSector_sameDepth_iff
        hpq a 0).mp hwitness
  · rintro rfl
    refine ⟨{
      admitted := Set.univ
      isClosed_admitted := isClosed_univ
      completedGreen_lands := fun _ => Set.mem_univ _
      finiteWitness_exact := ?_ }⟩
    constructor
    · intro _
      exact
        (deningerCalderonWittCrossPrimeGammaWitness_mem_admittedHodgeSector_sameDepth_iff
          hpq 0 0).mpr rfl
    · intro _
      exact Set.mem_univ _

/--
At a Riemann boundary point, completed closed Hodge admission exists
exactly on the critical line.
-/
theorem
    exists_deningerCompletedXiClosedHodgeAdmission_boundaryFracture_iff
    (p q : Nat.Primes) (hpq : p ≠ q)
    (r : XiZeroCopy) (rho : ℂ) :
    Nonempty
        (DeningerCompletedXiClosedHodgeAdmission p q hpq r
          (xiNearbyPoleDualityAdjunctionFracture rho).re) ↔
      rho.re = 1 / 2 := by
  rw [exists_deningerCompletedXiClosedHodgeAdmission_iff,
    xiNearbyPoleDualityAdjunctionFracture_eq_two_re]
  simp
  constructor <;> intro h <;> linarith

/--
Global closed landing of the dense completed Xi Green source into
Gamma/co-Poisson Hodge admission.
-/
def XiCompletedGreenClosedHodgeLanding
    (p q : Nat.Primes) (hpq : p ≠ q)
    (r : XiZeroCopy) : Prop :=
  ∀ rho : XiDivisorSupport,
    Nonempty
      (DeningerCompletedXiClosedHodgeAdmission p q hpq r
        (xiNearbyPoleDualityAdjunctionFracture (rho : ℂ)).re)

/--
**Global dense-source closed-admission law.**

For any fixed nonzero cross-prime incidence line and any fixed divisor
coordinate, global completed Green landing in a closed Hodge admission set
is equivalent to the Riemann hypothesis.
-/
theorem xiCompletedGreenClosedHodgeLanding_iff_riemannHypothesis
    (p q : Nat.Primes) (hpq : p ≠ q)
    (r : XiZeroCopy) :
    XiCompletedGreenClosedHodgeLanding p q hpq r ↔
      RiemannHypothesis := by
  rw [← xiBoundaryCharacterNeutral_iff_riemannHypothesis]
  constructor
  · intro h rho
    apply (xiNearbyPoleDualityAdjunctionFracture_eq_zero_iff
      (rho : ℂ)).2
    exact
      (exists_deningerCompletedXiClosedHodgeAdmission_boundaryFracture_iff
        p q hpq r (rho : ℂ)).1
        (h rho)
  · intro h rho
    apply
      (exists_deningerCompletedXiClosedHodgeAdmission_boundaryFracture_iff
        p q hpq r (rho : ℂ)).2
    exact
      (xiNearbyPoleDualityAdjunctionFracture_eq_zero_iff
        (rho : ℂ)).1 (h rho)

end

end RHTower
