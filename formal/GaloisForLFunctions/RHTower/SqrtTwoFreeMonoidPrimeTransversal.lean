import GaloisForLFunctions.RHTower.SqrtTwoUnitsAndInertPrimes
import Mathlib.Combinatorics.Hall.Basic
import Mathlib.LinearAlgebra.Dimension.Constructions
import Mathlib.RingTheory.UniqueFactorizationDomain.NormalizedFactors

/-!
# Prime transversals for free multiplicative monoids in `ℤ[√2]`

Let `g : ι → ℤ[√2]` have positive real embeddings, and let the product map
`f ↦ Π g_i^{f_i}` on `ι →₀ ℕ` be injective: the monoid generated by the `g_i` is free on them.

* **Relations.** A *relation* is a pair `(a, b)` of exponent vectors with `Π g^a` and `Π g^b`
  associated. Since positive units are powers of `u = 1+√2`, it can be oriented as
  `Π g^b = Π g^a · u^m` with `m ≥ 0`. Freeness makes any two oriented relations proportional:
  `n•b + m•c = n•a + m•d`. Hence all nonzero relations have the same set of indices where the
  two sides differ.
* **Transversal.** Removing one index from that set, every finite family of generators has at
  least as many distinct normalized prime factors as members. Otherwise the count vectors,
  more numerous than their ambient rank, would be `ℤ`-dependent and give a relation avoiding the
  removed index. Hall's theorem then gives an injective choice of a normalized prime factor for
  each remaining generator.
-/

noncomputable section

namespace RHTower.SqrtTwo

open UniqueFactorizationMonoid

noncomputable instance instNormalizationMonoid : NormalizationMonoid (ℤ√2) :=
  (UniqueFactorizationMonoid.strongNormalizationMonoid :
    StrongNormalizationMonoid (ℤ√2)).toNormalizationMonoid

variable {ι : Type*}

/-- The product `Π g_i^{f_i}` of a finitely supported exponent vector. -/
def prodPow (g : ι → ℤ√2) (f : ι →₀ ℕ) : ℤ√2 := f.prod fun i k => g i ^ k

variable {g : ι → ℤ√2}

theorem prodPow_add (f h : ι →₀ ℕ) : prodPow g (f + h) = prodPow g f * prodPow g h :=
  Finsupp.prod_add_index' (fun _ => pow_zero _) (fun _ _ _ => pow_add _ _ _)

theorem prodPow_nsmul (n : ℕ) (f : ι →₀ ℕ) : prodPow g (n • f) = prodPow g f ^ n := by
  induction n with
  | zero => simp [prodPow]
  | succ n ih => rw [succ_nsmul, prodPow_add, ih, pow_succ]

theorem emb_prodPow_pos (hg : ∀ i, 0 < emb (g i)) (f : ι →₀ ℕ) : 0 < emb (prodPow g f) := by
  rw [prodPow, map_finsuppProd]
  exact Finset.prod_pos fun i _ => by
    show 0 < emb (g i ^ f i)
    rw [map_pow]; exact pow_pos (hg i) _

theorem prodPow_ne_zero (hg : ∀ i, 0 < emb (g i)) (f : ι →₀ ℕ) : prodPow g f ≠ 0 := by
  intro h
  have := emb_prodPow_pos hg f
  rw [h, map_zero] at this
  exact lt_irrefl 0 this

theorem ne_zero_of_emb_pos {x : ℤ√2} (hx : 0 < emb x) : x ≠ 0 := by
  rintro rfl; rw [map_zero] at hx; exact lt_irrefl 0 hx

/-- Prime counts are additive along exponent vectors. -/
theorem count_normalizedFactors_prodPow (hg : ∀ i, 0 < emb (g i)) (π : ℤ√2) (f : ι →₀ ℕ) :
    (normalizedFactors (prodPow g f)).count π =
      f.sum fun i k => k * (normalizedFactors (g i)).count π := by
  induction f using Finsupp.induction with
  | zero => simp [prodPow]
  | single_add i k f _ _ ih =>
    rw [prodPow_add, normalizedFactors_mul (prodPow_ne_zero hg _) (prodPow_ne_zero hg _),
      Multiset.count_add, ih, Finsupp.sum_add_index' (fun _ => by simp) (fun _ _ _ => by ring)]
    congr 1
    rw [Finsupp.sum_single_index (by simp)]
    simp [prodPow, normalizedFactors_pow, Multiset.count_nsmul]

/-- Equal prime counts make the products associated. -/
theorem associated_prodPow_of_count (hg : ∀ i, 0 < emb (g i)) {a b : ι →₀ ℕ}
    (h : ∀ π, (a.sum fun i k => k * (normalizedFactors (g i)).count π) =
      b.sum fun i k => k * (normalizedFactors (g i)).count π) :
    Associated (prodPow g a) (prodPow g b) := by
  rw [associated_iff_normalizedFactors_eq_normalizedFactors (prodPow_ne_zero hg a)
    (prodPow_ne_zero hg b)]
  ext π
  rw [count_normalizedFactors_prodPow hg, count_normalizedFactors_prodPow hg, h]

/-- An associated pair differs by a power of the fundamental unit. -/
theorem exists_zpow_of_associated_prodPow (hg : ∀ i, 0 < emb (g i)) {a b : ι →₀ ℕ}
    (h : Associated (prodPow g a) (prodPow g b)) :
    ∃ m : ℤ, prodPow g b = prodPow g a * ((fundUnitU ^ m : (ℤ√2)ˣ) : ℤ√2) := by
  obtain ⟨V, hV⟩ := h
  have hpos : 0 < emb (V : ℤ√2) := by
    have ha := emb_prodPow_pos hg a
    have hb := emb_prodPow_pos hg b
    rw [← hV, map_mul] at hb
    exact pos_of_mul_pos_right hb ha.le
  obtain ⟨m, hm⟩ := exists_zpow_eq_of_emb_pos V hpos
  exact ⟨m, by rw [← hV, hm]⟩

/-- **Orientation.** A relation can be written with a natural unit exponent, in one of the two
directions. -/
theorem exists_oriented (hg : ∀ i, 0 < emb (g i)) {a b : ι →₀ ℕ}
    (h : Associated (prodPow g a) (prodPow g b)) :
    ∃ m : ℕ, prodPow g b = prodPow g a * fundUnit ^ m ∨
      prodPow g a = prodPow g b * fundUnit ^ m := by
  obtain ⟨m, hm⟩ := exists_zpow_of_associated_prodPow hg h
  have hU : ((fundUnitU : (ℤ√2)ˣ) : ℤ√2) = fundUnit := rfl
  rcases le_or_gt 0 m with hm0 | hm0
  · obtain ⟨n, rfl⟩ : ∃ n : ℕ, m = n := ⟨m.toNat, (Int.toNat_of_nonneg hm0).symm⟩
    refine ⟨n, Or.inl ?_⟩
    rw [hm, zpow_natCast, Units.val_pow_eq_pow_val, hU]
  · obtain ⟨n, hn⟩ : ∃ n : ℕ, -m = n := ⟨(-m).toNat, (Int.toNat_of_nonneg (by omega)).symm⟩
    refine ⟨n, Or.inr ?_⟩
    have : prodPow g a = prodPow g b * ((fundUnitU ^ (-m) : (ℤ√2)ˣ) : ℤ√2) := by
      rw [hm, mul_assoc, ← Units.val_mul, ← zpow_add, add_neg_cancel, zpow_zero, Units.val_one,
        mul_one]
    rw [this, hn, zpow_natCast, Units.val_pow_eq_pow_val, hU]

/-- **Proportionality.** Two oriented relations satisfy `n•b + m•c = n•a + m•d`. -/
theorem proportional_of_oriented (hfree : Function.Injective (prodPow g)) {a b c d : ι →₀ ℕ}
    {m n : ℕ} (h1 : prodPow g b = prodPow g a * fundUnit ^ m)
    (h2 : prodPow g d = prodPow g c * fundUnit ^ n) :
    n • b + m • c = n • a + m • d := by
  apply hfree
  simp only [prodPow_add, prodPow_nsmul, h1, h2]
  ring

/-- Two nontrivial oriented relations differ at exactly the same indices. -/
theorem ne_iff_of_oriented (hfree : Function.Injective (prodPow g)) {a b c d : ι →₀ ℕ}
    {m n : ℕ} (hab : a ≠ b) (hcd : c ≠ d) (h1 : prodPow g b = prodPow g a * fundUnit ^ m)
    (h2 : prodPow g d = prodPow g c * fundUnit ^ n) (i : ι) : a i ≠ b i ↔ c i ≠ d i := by
  have hm : m ≠ 0 := by
    rintro rfl; exact hab (hfree (by rw [h1, pow_zero, mul_one]))
  have hn : n ≠ 0 := by
    rintro rfl; exact hcd (hfree (by rw [h2, pow_zero, mul_one]))
  have hp := congrArg (fun f : ι →₀ ℕ => f i) (proportional_of_oriented hfree h1 h2)
  simp only [Finsupp.coe_add, Finsupp.coe_smul, Pi.add_apply, Pi.smul_apply, smul_eq_mul] at hp
  constructor
  · intro hi hcdi
    rw [hcdi] at hp
    exact hi (Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero hn) (by omega)).symm
  · intro hi habi
    rw [habi] at hp
    exact hi (Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero hm) (by omega))

/-- **All nontrivial relations have the same difference set.** -/
theorem ne_iff_of_associated (hg : ∀ i, 0 < emb (g i)) (hfree : Function.Injective (prodPow g))
    {a b c d : ι →₀ ℕ} (hab : a ≠ b) (hcd : c ≠ d)
    (h1 : Associated (prodPow g a) (prodPow g b)) (h2 : Associated (prodPow g c) (prodPow g d))
    (i : ι) : a i ≠ b i ↔ c i ≠ d i := by
  obtain ⟨m, hm | hm⟩ := exists_oriented hg h1 <;> obtain ⟨n, hn | hn⟩ := exists_oriented hg h2
  · exact ne_iff_of_oriented hfree hab hcd hm hn i
  · rw [ne_iff_of_oriented hfree hab (Ne.symm hcd) hm hn i, ne_comm]
  · rw [ne_comm, ne_iff_of_oriented hfree (Ne.symm hab) hcd hm hn i]
  · rw [ne_comm, ne_iff_of_oriented hfree (Ne.symm hab) (Ne.symm hcd) hm hn i, ne_comm]

/-- A finite family of generators with fewer distinct prime factors than members carries a
nontrivial relation supported on it. -/
theorem exists_relation_of_card_lt (hg : ∀ i, 0 < emb (g i)) {κ : Type*} (x : κ → ι)
    (hx : Function.Injective x) (s : Finset κ)
    (hlt : (s.biUnion fun i => (normalizedFactors (g (x i))).toFinset).card < s.card) :
    ∃ a b : ι →₀ ℕ, a ≠ b ∧ Associated (prodPow g a) (prodPow g b) ∧
      ∀ j, a j ≠ b j → ∃ i ∈ s, x i = j := by
  classical
  set N := s.biUnion fun i => (normalizedFactors (g (x i))).toFinset with hN
  let v : s → (N → ℤ) := fun i π => ((normalizedFactors (g (x i.1))).count π.1 : ℤ)
  have hli : ¬ LinearIndependent ℤ v := by
    intro h
    have := h.fintype_card_le_finrank
    rw [Module.finrank_fintype_fun_eq_card, Fintype.card_coe, Fintype.card_coe] at this
    omega
  obtain ⟨c, hc, i₁, hi₁⟩ := Fintype.not_linearIndependent_iff.mp hli
  let a : ι →₀ ℕ := ∑ i : s, Finsupp.single (x i.1) (c i).toNat
  let b : ι →₀ ℕ := ∑ i : s, Finsupp.single (x i.1) (-c i).toNat
  -- evaluation at the image points and elsewhere
  have heval : ∀ (n : s → ℕ) (i : s),
      (∑ k : s, Finsupp.single (x k.1) (n k)) (x i.1) = n i := by
    intro n i
    rw [Finsupp.finsetSum_apply, Finset.sum_eq_single i]
    · simp
    · intro k _ hki
      rw [Finsupp.single_apply, if_neg]
      intro h; exact hki (Subtype.ext (hx h))
    · simp
  have hout : ∀ (n : s → ℕ) (j : ι), (∀ i : s, x i.1 ≠ j) →
      (∑ k : s, Finsupp.single (x k.1) (n k)) j = 0 := by
    intro n j hj
    rw [Finsupp.finsetSum_apply]
    exact Finset.sum_eq_zero fun k _ => by rw [Finsupp.single_apply, if_neg (hj k)]
  have hsum : ∀ (n : s → ℕ) (w : ι → ℕ),
      ((∑ k : s, Finsupp.single (x k.1) (n k)).sum fun j e => e * w j) =
        ∑ k : s, n k * w (x k.1) := by
    intro n w
    rw [← Finsupp.sum_finsetSum_index (fun _ => zero_mul _) (fun _ _ _ => add_mul _ _ _)]
    exact Finset.sum_congr rfl fun k _ => Finsupp.sum_single_index (zero_mul _)
  refine ⟨a, b, ?_, ?_, ?_⟩
  · intro hab
    have h1 := heval (fun k => (c k).toNat) i₁
    have h2 := heval (fun k => (-c k).toNat) i₁
    have : (c i₁).toNat = (-c i₁).toNat := by
      rw [← h1, ← h2]; exact congrArg (fun f : ι →₀ ℕ => f (x i₁.1)) hab
    omega
  · apply associated_prodPow_of_count hg
    intro π
    rw [hsum, hsum]
    have hz : ∑ k : s, (c k) * ((normalizedFactors (g (x k.1))).count π : ℤ) = 0 := by
      by_cases hπ : π ∈ N
      · have := congrFun hc ⟨π, hπ⟩
        simpa [v, Finset.sum_apply, mul_comm] using this
      · refine Finset.sum_eq_zero fun k _ => ?_
        have : (normalizedFactors (g (x k.1))).count π = 0 := by
          rw [Multiset.count_eq_zero]
          intro hmem
          exact hπ (Finset.mem_biUnion.mpr ⟨k.1, k.2, Multiset.mem_toFinset.mpr hmem⟩)
        simp [this]
    have hsplit : ∀ k : s, ((c k).toNat : ℤ) - ((-c k).toNat : ℤ) = c k := fun k => by omega
    have : ((∑ k : s, (c k).toNat * (normalizedFactors (g (x k.1))).count π : ℕ) : ℤ) =
        ((∑ k : s, (-c k).toNat * (normalizedFactors (g (x k.1))).count π : ℕ) : ℤ) := by
      push_cast
      rw [← sub_eq_zero, ← Finset.sum_sub_distrib]
      rw [← hz]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [← sub_mul, hsplit]
    exact_mod_cast this
  · intro j hj
    by_contra hno
    push Not at hno
    have hj' : ∀ i : s, x i.1 ≠ j := fun i => hno i.1 i.2
    exact hj (by rw [hout _ j hj', hout _ j hj'])

/-- **Prime transversal.** After removing at most one generator, the remaining generators admit an
injective choice of a normalized prime factor each. -/
theorem exists_prime_transversal (hg : ∀ i, 0 < emb (g i))
    (hfree : Function.Injective (prodPow g)) :
    ∃ S : Set ι, S.Subsingleton ∧ ∃ τ : {i // i ∉ S} → ℤ√2, Function.Injective τ ∧
      ∀ i, τ i ∈ normalizedFactors (g i.1) := by
  classical
  have key : ∀ T : Set ι, (∀ a b : ι →₀ ℕ, a ≠ b → Associated (prodPow g a) (prodPow g b) →
      ∃ j ∈ T, a j ≠ b j) → ∃ τ : {i // i ∉ T} → ℤ√2, Function.Injective τ ∧
        ∀ i, τ i ∈ normalizedFactors (g i.1) := by
    intro T hT
    let t : {i // i ∉ T} → Finset (ℤ√2) := fun i => (normalizedFactors (g i.1)).toFinset
    have hall : ∀ s : Finset {i // i ∉ T}, s.card ≤ (s.biUnion t).card := by
      intro s
      by_contra hlt
      rw [not_le] at hlt
      obtain ⟨a, b, hab, hassoc, hsupp⟩ :=
        exists_relation_of_card_lt hg (fun i : {i // i ∉ T} => i.1) Subtype.val_injective s hlt
      obtain ⟨j, hjT, hj⟩ := hT a b hab hassoc
      obtain ⟨i, _, rfl⟩ := hsupp j hj
      exact i.2 hjT
    obtain ⟨τ, hτ, hmem⟩ := (Finset.all_card_le_biUnion_card_iff_exists_injective t).mp hall
    exact ⟨τ, hτ, fun i => Multiset.mem_toFinset.mp (hmem i)⟩
  by_cases hrel : ∃ a b : ι →₀ ℕ, a ≠ b ∧ Associated (prodPow g a) (prodPow g b)
  · obtain ⟨a₀, b₀, hab₀, h₀⟩ := hrel
    obtain ⟨i₀, hi₀⟩ := DFunLike.ne_iff.mp hab₀
    refine ⟨{i₀}, Set.subsingleton_singleton, key {i₀} fun a b hab h => ⟨i₀, rfl, ?_⟩⟩
    exact (ne_iff_of_associated hg hfree hab₀ hab h₀ h i₀).mp hi₀
  · refine ⟨∅, Set.subsingleton_empty, key ∅ fun a b hab h => ?_⟩
    exact absurd ⟨a, b, hab, h⟩ hrel

end RHTower.SqrtTwo
