/-
# Perturbation-stable Gaussian localization for triple clouds

The sixth moment of a finite extension sum is the squared norm of its
three-fold convolution.  This file lifts coordinatewise perturbation control
from individual curve samples to their triple cloud and combines it with the
Gaussian large sieve.  The resulting comparison has no additive coefficient
`ℓ¹` error.
-/
import GaloisForLFunctions.RHTower.BourgainGaussianLargeSieve
import GaloisForLFunctions.RHTower.BourgainScaledNearPerturbation

open MeasureTheory
open scoped BigOperators

namespace RHTower

noncomputable section

/-- Three-fold additive cloud generated by a finite point family. -/
def bourgainTripleCloud
    {H : ℕ} (p : Fin H → BourgainPhaseSpace)
    (h : Fin 3 → Fin H) : BourgainPhaseSpace :=
  ∑ k : Fin 3, p (h k)

/-- A pointwise scaled perturbation of size `δ` induces a scaled perturbation
of size `3δ` on the corresponding triple clouds. -/
theorem bourgainTripleCloud_scaledPerturbation
    {H : ℕ} {δ : ℝ} (hδ : 0 ≤ δ)
    {X : BourgainPhaseSpace}
    {p q : Fin H → BourgainPhaseSpace}
    (hperturb :
      ∀ n j, |X j * (p n j - q n j)| ≤ δ) :
    ∀ h j,
      |X j *
        (bourgainTripleCloud p h j -
          bourgainTripleCloud q h j)| ≤ 3 * δ := by
  intro h j
  unfold bourgainTripleCloud
  simp only [Finset.sum_apply, ← Finset.sum_sub_distrib, Finset.mul_sum]
  calc
    |∑ k : Fin 3, X j * (p (h k) j - q (h k) j)|
        ≤ ∑ k : Fin 3,
            |X j * (p (h k) j - q (h k) j)| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _k : Fin 3, δ := by
      apply Finset.sum_le_sum
      intro k hk
      exact hperturb (h k) j
    _ = 3 * δ := by simp

/-- Near-pair energy of an exact triple cloud is controlled by that of a
pointwise quadratic model after the explicit `1+12δ` scale shrink. -/
theorem bourgainTripleCloud_nearEnergy_perturbation_le
    {H : ℕ} {δ : ℝ} (hδ : 0 ≤ δ)
    (X : BourgainPhaseSpace)
    (p q : Fin H → BourgainPhaseSpace)
    (a : (Fin 3 → Fin H) → ℝ)
    (ha : ∀ h, 0 ≤ a h)
    (hperturb :
      ∀ n j, |X j * (p n j - q n j)| ≤ δ) :
    bourgainWeightedScaledNearEnergy X
        (bourgainTripleCloud p) a ≤
      bourgainWeightedScaledNearEnergy
        (bourgainPerturbedSpacingScale (3 * δ) X)
        (bourgainTripleCloud q) a := by
  apply bourgainWeightedScaledNearEnergy_perturbation_le
    (mul_nonneg (by norm_num) hδ) X
    (bourgainTripleCloud p) (bourgainTripleCloud q) a ha
  exact bourgainTripleCloud_scaledPerturbation hδ hperturb

/-- Gaussian `L²` localization for an exact triple cloud, transferred
without additive error to a pointwise quadratic model. -/
theorem integral_bourgainTripleCloud_gaussian_le_perturbed
    {H : ℕ} {δ : ℝ} (hδ : 0 ≤ δ)
    (X : BourgainPhaseSpace)
    (p q : Fin H → BourgainPhaseSpace)
    (b : (Fin 3 → Fin H) → ℂ)
    (hperturb :
      ∀ n j, |X j * (p n j - q n j)| ≤ δ) :
    (∫ x : BourgainPhaseSpace,
        bourgainRealGaussianL2Integrand X
          (bourgainTripleCloud p) b x) ≤
      331776 *
        bourgainWeightedScaledNearEnergy
          (bourgainPerturbedSpacingScale (3 * δ) X)
          (bourgainTripleCloud q) (fun h => ‖b h‖) := by
  calc
    (∫ x : BourgainPhaseSpace,
        bourgainRealGaussianL2Integrand X
          (bourgainTripleCloud p) b x)
        ≤ 331776 *
            bourgainWeightedScaledNearEnergy X
              (bourgainTripleCloud p) (fun h => ‖b h‖) :=
      integral_bourgainRealGaussianL2Integrand_le_scaledNear
        X (bourgainTripleCloud p) b
    _ ≤ 331776 *
        bourgainWeightedScaledNearEnergy
          (bourgainPerturbedSpacingScale (3 * δ) X)
          (bourgainTripleCloud q) (fun h => ‖b h‖) := by
      gcongr
      exact bourgainTripleCloud_nearEnergy_perturbation_le
        hδ X p q (fun h => ‖b h‖) (fun h => norm_nonneg _)
        hperturb

end

end RHTower
