import GaloisForLFunctions.RHTower.ThetaCuspHawkingBogoliubovCCRCompletionEndpoint

/-!
# Timelike realization of the theta-cusp Hawking Born family

The Xi-valued pair kernel in the Hawking route is the first variation of the ray-tracing family

`p_lambda(v) = v + lambda * thetaCuspFullSource(v)`.

Until this file, the corpus used that variation at amplitude level but did not certify that a
nontrivial interval of the surrounding trajectories is physical.  Here the global Schwartz bound
on the first source derivative gives an explicit coupling radius.  Inside it, `p_lambda' > 0`
everywhere.  Consequently `p_lambda` is strictly increasing and the associated Minkowski
worldline

`T(v) = (v + p_lambda(v))/2`, `X(v) = (p_lambda(v)-v)/2`

is future directed and strictly subluminal at every point.

**[LITERATURE]** In the Davies--Fulling moving-mirror model, a differentiable increasing null
ray-tracing map is the kinematic datum of a timelike mirror.  Its Bogoliubov coefficient has pair
resonance at the sum of exterior and partner frequencies.  Butera (`arXiv:2306.03813`) derives the
same sum-frequency channel from dynamical-Casimir backreaction: its quadratic influence kernel is
generated by emission of field quanta in pairs.

**[LOCAL-RESEARCH] [PAPER-PROVED] [LEAN-PROVED]** The theorem below makes the theta perturbation a
genuine open timelike mirror family, rather than attaching Hawking terminology to a Fourier
transform after the fact.  Combined with the existing first-variation calculation, its pair
kernel is exactly

`2 i omega_out omega_in XiC(omega_out + omega_in)`.

**[FALSIFIED]** Timelikeness, exact CCR completion, KMS fluctuation--dissipation, and HBT Gram
positivity do not confine complex zeros: each holds for general moving-mirror data and survives
inner/all-pass factors.

**[CONJECTURE] [NOVELTY UNVERIFIED]** A proof-producing completion would identify this same
timelike family's pair block, conformal-anomaly generator, and boundary Green current as shadows
of one source-causal conservative colligation.  Generic unitary dilation is insufficient because
self-adjoint scattering systems may have complex resonances.

**[OPEN CORE]** Derive a theta-specific positive storage/port identity for that common
colligation which applies to the two-ended anomaly resonances.  The present file proves physical
kinematics and the exact tangent carrier only; it does not assume that RH-strength identity.
-/

open Complex Real

noncomputable section

namespace RHTower

open HedenmalmThetaSource

/-! ## Physical theta ray family -/

/-- Theta-cusp perturbation of the inertial null ray. -/
def thetaCuspHawkingTimelikeRay (lambda v : ℝ) : ℝ :=
  v + lambda * thetaCuspFullSource v

/-- Named null-ray derivative. -/
def thetaCuspHawkingTimelikeRayDerivative (lambda v : ℝ) : ℝ :=
  1 + lambda * deriv thetaCuspFullSource v

/-- Global first-derivative bound controlling timelikeness. -/
def thetaCuspHawkingTimelikeDerivativeBound : ℝ :=
  thetaCuspDerivativeExpConstant 1

/-- Explicit nonzero coupling radius for the physical mirror family. -/
def thetaCuspHawkingTimelikeCouplingRadius : ℝ :=
  (thetaCuspHawkingTimelikeDerivativeBound + 1)⁻¹

theorem thetaCuspHawkingTimelikeDerivativeBound_nonneg :
    0 ≤ thetaCuspHawkingTimelikeDerivativeBound := by
  exact thetaCuspDerivativeExpConstant_nonneg 1

theorem thetaCuspHawkingTimelikeCouplingRadius_pos :
    0 < thetaCuspHawkingTimelikeCouplingRadius := by
  rw [thetaCuspHawkingTimelikeCouplingRadius]
  exact inv_pos.mpr (by
    linarith [thetaCuspHawkingTimelikeDerivativeBound_nonneg])

/-- The named derivative is the actual derivative of the theta ray. -/
theorem hasDerivAt_thetaCuspHawkingTimelikeRay (lambda v : ℝ) :
    HasDerivAt (thetaCuspHawkingTimelikeRay lambda)
      (thetaCuspHawkingTimelikeRayDerivative lambda v) v := by
  unfold thetaCuspHawkingTimelikeRay thetaCuspHawkingTimelikeRayDerivative
  have hsource : HasDerivAt thetaCuspFullSource
      (deriv thetaCuspFullSource v) v :=
    (contDiff_thetaCuspFullSource.differentiable (by simp) v).hasDerivAt
  convert (hasDerivAt_id v).add (hsource.const_mul lambda) using 1 <;> rfl

/-- Uniform source-slope estimate used by the physical coupling radius. -/
theorem abs_sourceDeriv_le_thetaCuspHawkingTimelikeDerivativeBound (v : ℝ) :
    |deriv thetaCuspFullSource v| ≤ thetaCuspHawkingTimelikeDerivativeBound := by
  have h := weighted_iteratedDeriv_thetaCuspFullSource_le 0 1 v
  simpa [iteratedDeriv_one, Real.norm_eq_abs,
    thetaCuspHawkingTimelikeDerivativeBound] using h

/-- Safe coupling makes the perturbative correction to the null slope strictly smaller than one. -/
theorem abs_mul_sourceDeriv_lt_one_of_lt_couplingRadius
    {lambda : ℝ} (hlambda : |lambda| < thetaCuspHawkingTimelikeCouplingRadius)
    (v : ℝ) :
    |lambda * deriv thetaCuspFullSource v| < 1 := by
  let C := thetaCuspHawkingTimelikeDerivativeBound
  let r := thetaCuspHawkingTimelikeCouplingRadius
  have hC : 0 ≤ C := thetaCuspHawkingTimelikeDerivativeBound_nonneg
  have hr : 0 < r := thetaCuspHawkingTimelikeCouplingRadius_pos
  have hsource : |deriv thetaCuspFullSource v| ≤ C :=
    abs_sourceDeriv_le_thetaCuspHawkingTimelikeDerivativeBound v
  have hden : 0 < C + 1 := by linarith
  have hrden : r * (C + 1) = 1 := by
    dsimp only [r, C]
    rw [thetaCuspHawkingTimelikeCouplingRadius]
    exact inv_mul_cancel₀ hden.ne'
  rw [abs_mul]
  calc
    |lambda| * |deriv thetaCuspFullSource v| ≤ |lambda| * C := by
      exact mul_le_mul_of_nonneg_left hsource (abs_nonneg lambda)
    _ ≤ r * C := mul_le_mul_of_nonneg_right hlambda.le hC
    _ < r * (C + 1) := mul_lt_mul_of_pos_left (by linarith) hr
    _ = 1 := hrden

/-- Every safe theta ray has positive null derivative at every source coordinate. -/
theorem thetaCuspHawkingTimelikeRayDerivative_pos
    {lambda : ℝ} (hlambda : |lambda| < thetaCuspHawkingTimelikeCouplingRadius)
    (v : ℝ) :
    0 < thetaCuspHawkingTimelikeRayDerivative lambda v := by
  have hsmall := abs_mul_sourceDeriv_lt_one_of_lt_couplingRadius hlambda v
  have hlower := (abs_lt.mp hsmall).1
  rw [thetaCuspHawkingTimelikeRayDerivative]
  linarith

/-- The physical ray-tracing map is globally orientation preserving. -/
theorem strictMono_thetaCuspHawkingTimelikeRay
    {lambda : ℝ} (hlambda : |lambda| < thetaCuspHawkingTimelikeCouplingRadius) :
    StrictMono (thetaCuspHawkingTimelikeRay lambda) := by
  apply strictMono_of_hasDerivAt_pos
    (hasDerivAt_thetaCuspHawkingTimelikeRay lambda)
  exact thetaCuspHawkingTimelikeRayDerivative_pos hlambda

/-! ## Associated Minkowski worldline -/

/-- Minkowski time coordinate of the mirror worldline parametrized by incoming null time. -/
def thetaCuspHawkingTimelikeWorldlineTime (lambda v : ℝ) : ℝ :=
  (v + thetaCuspHawkingTimelikeRay lambda v) / 2

/-- Minkowski position coordinate of the mirror worldline. -/
def thetaCuspHawkingTimelikeWorldlinePosition (lambda v : ℝ) : ℝ :=
  (thetaCuspHawkingTimelikeRay lambda v - v) / 2

/-- Coordinate velocity obtained from the null-ray slope. -/
def thetaCuspHawkingTimelikeWorldlineVelocity (lambda v : ℝ) : ℝ :=
  (thetaCuspHawkingTimelikeRayDerivative lambda v - 1) /
    (thetaCuspHawkingTimelikeRayDerivative lambda v + 1)

theorem hasDerivAt_thetaCuspHawkingTimelikeWorldlineTime (lambda v : ℝ) :
    HasDerivAt (thetaCuspHawkingTimelikeWorldlineTime lambda)
      ((1 + thetaCuspHawkingTimelikeRayDerivative lambda v) / 2) v := by
  change HasDerivAt
    (fun x : ℝ => (x + thetaCuspHawkingTimelikeRay lambda x) / 2)
    ((1 + thetaCuspHawkingTimelikeRayDerivative lambda v) / 2) v
  simpa only [Pi.add_apply, id_eq] using
    ((hasDerivAt_id v).add
      (hasDerivAt_thetaCuspHawkingTimelikeRay lambda v)).div_const 2

theorem hasDerivAt_thetaCuspHawkingTimelikeWorldlinePosition (lambda v : ℝ) :
    HasDerivAt (thetaCuspHawkingTimelikeWorldlinePosition lambda)
      ((thetaCuspHawkingTimelikeRayDerivative lambda v - 1) / 2) v := by
  change HasDerivAt
    (fun x : ℝ => (thetaCuspHawkingTimelikeRay lambda x - x) / 2)
    ((thetaCuspHawkingTimelikeRayDerivative lambda v - 1) / 2) v
  simpa only [Pi.sub_apply, id_eq] using
    ((hasDerivAt_thetaCuspHawkingTimelikeRay lambda v).sub
      (hasDerivAt_id v)).div_const 2

/-- Safe theta mirrors are future directed in Minkowski time. -/
theorem thetaCuspHawkingTimelikeWorldlineTimeDerivative_pos
    {lambda : ℝ} (hlambda : |lambda| < thetaCuspHawkingTimelikeCouplingRadius)
    (v : ℝ) :
    0 < (1 + thetaCuspHawkingTimelikeRayDerivative lambda v) / 2 := by
  have h := thetaCuspHawkingTimelikeRayDerivative_pos hlambda v
  linarith

/-- Exact ratio of spatial and temporal worldline derivatives. -/
theorem thetaCuspHawkingTimelikeWorldlineDerivativeRatio
    {lambda v : ℝ}
    (hpositive : 0 < thetaCuspHawkingTimelikeRayDerivative lambda v) :
    ((thetaCuspHawkingTimelikeRayDerivative lambda v - 1) / 2) /
        ((1 + thetaCuspHawkingTimelikeRayDerivative lambda v) / 2) =
      thetaCuspHawkingTimelikeWorldlineVelocity lambda v := by
  rw [thetaCuspHawkingTimelikeWorldlineVelocity]
  field_simp
  ring

/-- **[LEAN-PROVED] Timelike worldline law.**  Every safe member of the theta family is strictly
subluminal at every point. -/
theorem abs_thetaCuspHawkingTimelikeWorldlineVelocity_lt_one
    {lambda : ℝ} (hlambda : |lambda| < thetaCuspHawkingTimelikeCouplingRadius)
    (v : ℝ) :
    |thetaCuspHawkingTimelikeWorldlineVelocity lambda v| < 1 := by
  let d := thetaCuspHawkingTimelikeRayDerivative lambda v
  have hd : 0 < d := thetaCuspHawkingTimelikeRayDerivative_pos hlambda v
  have hden : 0 < d + 1 := by linarith
  rw [thetaCuspHawkingTimelikeWorldlineVelocity]
  change |(d - 1) / (d + 1)| < 1
  rw [abs_lt]
  constructor
  · rw [lt_div_iff₀ hden]
    linarith
  · rw [div_lt_iff₀ hden]
    linarith

/-- A nonempty open coupling interval consists entirely of genuine timelike mirrors. -/
theorem exists_open_thetaCuspHawkingTimelikeMirrorFamily :
    ∃ epsilon : ℝ, 0 < epsilon ∧
      ∀ lambda : ℝ, |lambda| < epsilon →
        StrictMono (thetaCuspHawkingTimelikeRay lambda) ∧
          ∀ v : ℝ, |thetaCuspHawkingTimelikeWorldlineVelocity lambda v| < 1 := by
  refine ⟨thetaCuspHawkingTimelikeCouplingRadius,
    thetaCuspHawkingTimelikeCouplingRadius_pos, ?_⟩
  intro lambda hlambda
  exact ⟨strictMono_thetaCuspHawkingTimelikeRay hlambda,
    abs_thetaCuspHawkingTimelikeWorldlineVelocity_lt_one hlambda⟩

/-! ## Exact theta tangent and Hawking pair carrier -/

/-- The configuration-space tangent of the physical mirror family is the literal theta source. -/
theorem hasDerivAt_thetaCuspHawkingTimelikeRay_coupling (lambda v : ℝ) :
    HasDerivAt (fun coupling => thetaCuspHawkingTimelikeRay coupling v)
      (thetaCuspFullSource v) lambda := by
  unfold thetaCuspHawkingTimelikeRay
  convert (hasDerivAt_const lambda v).add
    ((hasDerivAt_id lambda).mul_const (thetaCuspFullSource v)) using 1 <;> try rfl
  simp

/-- The slope tangent of the physical mirror family is the theta source derivative. -/
theorem hasDerivAt_thetaCuspHawkingTimelikeRayDerivative_coupling
    (lambda v : ℝ) :
    HasDerivAt (fun coupling =>
      thetaCuspHawkingTimelikeRayDerivative coupling v)
      (deriv thetaCuspFullSource v) lambda := by
  unfold thetaCuspHawkingTimelikeRayDerivative
  convert (hasDerivAt_const lambda (1 : ℝ)).add
    ((hasDerivAt_id lambda).mul_const (deriv thetaCuspFullSource v)) using 1 <;> try rfl
  simp

/-- The Born tangent of the genuine timelike family is exactly the symmetric Hawking pair kernel. -/
theorem thetaCuspHawkingTimelikeMirrorBornTangent_eq_pairKernel
    (outgoingFrequency incomingFrequency : ℝ) :
    thetaCuspMovingMirrorBornRaw outgoingFrequency incomingFrequency =
      thetaCuspHawkingBornPairKernel
        (outgoingFrequency : ℂ) (incomingFrequency : ℂ) := by
  exact (thetaCuspHawkingBornPairKernel_real_eq_raw
    outgoingFrequency incomingFrequency).symm

/-- Its pair tangent carries the completed theta/Xi transform at the physical DCE sum frequency. -/
theorem thetaCuspHawkingTimelikeMirrorBornTangent_eq_XiC
    (outgoingFrequency incomingFrequency : ℝ) :
    thetaCuspMovingMirrorBornRaw outgoingFrequency incomingFrequency =
      2 * Complex.I * (outgoingFrequency : ℂ) *
        (incomingFrequency : ℂ) *
        XiC ((outgoingFrequency + incomingFrequency : ℝ) : ℂ) :=
  thetaCuspMovingMirrorBornRaw_eq_XiC outgoingFrequency incomingFrequency

end RHTower
