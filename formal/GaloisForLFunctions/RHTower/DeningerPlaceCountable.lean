import GaloisForLFunctions.RHTower.DeningerTestSpaceComplex
import Mathlib.NumberTheory.NumberField.Completion.FinitePlace

/-!
# A number field has countably many places

A number field is a finite dimensional vector space over the rationals, hence countable, and so is
its ring of integers.  In a Noetherian ring every ideal is generated by a finite set, and an ideal
is determined by a generating set, so the ideals — in particular the height one primes, that is the
finite places — are countably many.  The infinite places are finitely many.

Countability is what makes the space of places second countable, and therefore a space to which
the locally constant test space theory applies.

* `deningerNumberField_countable`, `deningerRingOfIntegers_countable` : a number field and its ring
  of integers are countable.
* `deningerHeightOneSpectrum_countable` : the height one primes are countably many.
* `deningerFinitePlace_countable` : **a number field has countably many finite places.**
-/

namespace RHTower

open NumberField IsDedekindDomain

section Countability

variable (K : Type*) [Field K] [NumberField K]

/-- **A number field is countable**, being a finite dimensional space over the rationals. -/
theorem deningerNumberField_countable : Countable K := by
  classical
  have hfin : FiniteDimensional ℚ K := inferInstance
  let b := Module.finBasis ℚ K
  exact Countable.of_equiv _ b.equivFun.toEquiv.symm

/-- **The ring of integers of a number field is countable.** -/
theorem deningerRingOfIntegers_countable : Countable (𝓞 K) := by
  haveI := deningerNumberField_countable K
  exact Subtype.countable

/-- **A Noetherian ring with countably many elements has countably many ideals.** -/
theorem deningerIdeal_countable {R : Type*} [CommRing R] [IsNoetherianRing R] [Countable R] :
    Countable (Ideal R) := by
  classical
  have hfg : ∀ I : Ideal R, ∃ s : Finset R, Ideal.span (s : Set R) = I := by
    intro I
    obtain ⟨s, hs⟩ := (isNoetherian_def.mp (inferInstance : IsNoetherian R R) I)
    exact ⟨s, hs⟩
  choose gen hgen using hfg
  refine Function.Injective.countable (f := gen) ?_
  intro I J hIJ
  rw [← hgen I, ← hgen J, hIJ]

/-- **A number field has countably many height one primes.** -/
theorem deningerHeightOneSpectrum_countable : Countable (HeightOneSpectrum (𝓞 K)) := by
  haveI := deningerRingOfIntegers_countable K
  haveI : Countable (Ideal (𝓞 K)) := deningerIdeal_countable
  refine Function.Injective.countable (f := fun v : HeightOneSpectrum (𝓞 K) => v.asIdeal) ?_
  intro v w hvw
  exact HeightOneSpectrum.ext hvw

/-- **A number field has countably many finite places.** -/
theorem deningerFinitePlace_countable : Countable (FinitePlace K) := by
  haveI := deningerHeightOneSpectrum_countable K
  exact Countable.of_equiv _ FinitePlace.equivHeightOneSpectrum.symm

end Countability

end RHTower
