/-
The concrete two-sided operator ideal generated by finite time-band Fourier blocks.

Every generator is a finite-rectangle Fourier integral operator, hence classically
Hilbert--Schmidt. The inductive presentation retains the actual bounded factorizations instead
of forgetting them after proving compactness.
-/
import GaloisForLFunctions.RHTower.SoninEulerCalkinPartialIsometry
import GaloisForLFunctions.HTGeometry.TwoProjectionSupersymmetry

noncomputable section

namespace RHTower

open ContinuousLinearMap
open Filter Topology
open scoped InnerProduct InnerProductSpace

theorem adjoint_indicatorCutoff_central (a : ℝ) :
    (indicatorCutoff (centralInterval a) (measurableSet_centralInterval a))† =
      indicatorCutoff (centralInterval a) (measurableSet_centralInterval a) := by
  apply ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric.mpr
  exact indicatorCutoff_symmetric (centralInterval a)
    (measurableSet_centralInterval a)

theorem adjoint_fourierCutoff_central (a : ℝ) :
    (fourierCutoff (centralInterval a) (measurableSet_centralInterval a))† =
      fourierCutoff (centralInterval a) (measurableSet_centralInterval a) := by
  apply ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric.mpr
  exact fourierCutoff_symmetric (centralInterval a)
    (measurableSet_centralInterval a)

theorem adjoint_mul_soninL2
    (S T : SoninL2 →L[Complex] SoninL2) :
    (S * T)† = T† * S† := by
  change ContinuousLinearMap.adjoint (S ∘L T) =
    ContinuousLinearMap.adjoint T ∘L ContinuousLinearMap.adjoint S
  exact ContinuousLinearMap.adjoint_comp S T

theorem adjoint_add_soninL2
    (S T : SoninL2 →L[Complex] SoninL2) :
    (S + T)† = S† + T† := by
  let adj : (SoninL2 →L[Complex] SoninL2) ≃ₗᵢ⋆[Complex]
      (SoninL2 →L[Complex] SoninL2) := ContinuousLinearMap.adjoint
  change adj (S + T) = adj S + adj T
  exact adj.map_add S T

/-- The algebraic two-sided ideal generated by the physical/Fourier finite time-band blocks on
the actual Sonin `L2` model. -/
inductive IsSoninTimeBandIdeal : (SoninL2 →L[Complex] SoninL2) → Prop
  | zero : IsSoninTimeBandIdeal 0
  | indicatorFourier (s t : ℝ) (hs : 0 < s) (ht : 0 < t) :
      IsSoninTimeBandIdeal
        (indicatorCutoff (centralInterval s) (measurableSet_centralInterval s) *
          fourierCutoff (centralInterval t) (measurableSet_centralInterval t))
  | fourierIndicator (s t : ℝ) (hs : 0 < s) (ht : 0 < t) :
      IsSoninTimeBandIdeal
        (fourierCutoff (centralInterval s) (measurableSet_centralInterval s) *
          indicatorCutoff (centralInterval t) (measurableSet_centralInterval t))
  | add {S T : SoninL2 →L[Complex] SoninL2}
      (hS : IsSoninTimeBandIdeal S) (hT : IsSoninTimeBandIdeal T) :
      IsSoninTimeBandIdeal (S + T)
  | neg {T : SoninL2 →L[Complex] SoninL2}
      (hT : IsSoninTimeBandIdeal T) : IsSoninTimeBandIdeal (-T)
  | leftMul (L : SoninL2 →L[Complex] SoninL2)
      {T : SoninL2 →L[Complex] SoninL2} (hT : IsSoninTimeBandIdeal T) :
      IsSoninTimeBandIdeal (L * T)
  | rightMul {T : SoninL2 →L[Complex] SoninL2}
      (hT : IsSoninTimeBandIdeal T) (R : SoninL2 →L[Complex] SoninL2) :
      IsSoninTimeBandIdeal (T * R)

namespace IsSoninTimeBandIdeal

theorem sub {S T : SoninL2 →L[Complex] SoninL2}
    (hS : IsSoninTimeBandIdeal S) (hT : IsSoninTimeBandIdeal T) :
    IsSoninTimeBandIdeal (S - T) := by
  rw [sub_eq_add_neg]
  exact hS.add hT.neg

theorem of_eq {S T : SoninL2 →L[Complex] SoninL2}
    (hS : IsSoninTimeBandIdeal S) (h : S = T) : IsSoninTimeBandIdeal T := by
  rwa [← h]

theorem smul (c : Complex) {T : SoninL2 →L[Complex] SoninL2}
    (hT : IsSoninTimeBandIdeal T) : IsSoninTimeBandIdeal (c • T) := by
  have h := hT.leftMul (c • (1 : SoninL2 →L[Complex] SoninL2))
  apply h.of_eq
  apply ContinuousLinearMap.ext
  intro x
  simp

/-- Every concretely time-band-generated operator is compact. -/
theorem isCompactOperator {T : SoninL2 →L[Complex] SoninL2}
    (hT : IsSoninTimeBandIdeal T) : IsCompactOperator T := by
  induction hT with
  | zero => exact isCompactOperator_zero
  | indicatorFourier s t hs ht =>
      exact isCompactOperator_indicatorCutoff_fourierCutoff_central s t hs
  | fourierIndicator s t hs ht =>
      exact isCompactOperator_fourierCutoff_indicatorCutoff_central s t hs
  | add hS hT ihS ihT => exact ihS.add ihT
  | neg hT ihT => exact ihT.neg
  | leftMul L hT ihT => exact ihT.clm_comp L
  | rightMul hT R ihT => exact ihT.comp_clm R

/-- The time-band ideal is closed under Hilbert-space adjoint. This is proved from the actual
adjoints of the physical and Fourier cutoff generators, not postulated as a constructor. -/
theorem adjoint {T : SoninL2 →L[Complex] SoninL2}
    (hT : IsSoninTimeBandIdeal T) :
    IsSoninTimeBandIdeal (ContinuousLinearMap.adjoint T) := by
  induction hT with
  | zero =>
      simpa using (IsSoninTimeBandIdeal.zero :
        IsSoninTimeBandIdeal (0 : SoninL2 →L[Complex] SoninL2))
  | indicatorFourier s t hs ht =>
      have h := IsSoninTimeBandIdeal.fourierIndicator t s ht hs
      rw [adjoint_mul_soninL2, adjoint_indicatorCutoff_central,
        adjoint_fourierCutoff_central]
      exact h
  | fourierIndicator s t hs ht =>
      have h := IsSoninTimeBandIdeal.indicatorFourier t s ht hs
      rw [adjoint_mul_soninL2, adjoint_indicatorCutoff_central,
        adjoint_fourierCutoff_central]
      exact h
  | add hS hT ihS ihT =>
      rw [adjoint_add_soninL2]
      exact ihS.add ihT
  | @neg T hT ihT =>
      have hneg : ContinuousLinearMap.adjoint (-T) =
          -(ContinuousLinearMap.adjoint T) := by
        let adj : (SoninL2 →L[Complex] SoninL2) ≃ₗᵢ⋆[Complex]
            (SoninL2 →L[Complex] SoninL2) := ContinuousLinearMap.adjoint
        exact adj.map_neg T
      rw [hneg]
      exact ihT.neg
  | leftMul L hT ihT =>
      rw [adjoint_mul_soninL2]
      exact ihT.rightMul (ContinuousLinearMap.adjoint L)
  | rightMul hT R ihT =>
      rw [adjoint_mul_soninL2]
      exact ihT.leftMul (ContinuousLinearMap.adjoint R)

end IsSoninTimeBandIdeal

/-- A constructive trace-ideal certificate: an operator is presented as a product of two
finite-time-band-generated (hence classically Hilbert--Schmidt) operators. -/
def IsSoninTimeBandTraceIdeal (T : SoninL2 →L[Complex] SoninL2) : Prop :=
  ∃ S U : SoninL2 →L[Complex] SoninL2,
    IsSoninTimeBandIdeal S ∧ IsSoninTimeBandIdeal U ∧ T = S * U

namespace IsSoninTimeBandTraceIdeal

theorem isCompactOperator {T : SoninL2 →L[Complex] SoninL2}
    (hT : IsSoninTimeBandTraceIdeal T) : IsCompactOperator T := by
  obtain ⟨S, U, hS, hU, rfl⟩ := hT
  exact hU.isCompactOperator.clm_comp S

end IsSoninTimeBandTraceIdeal

/-- The exact Sonin projection correction, before forgetting its finite-time-band
factorization. -/
def centralSoninProjectionCorrection (a : ℝ) : SoninL2 →L[Complex] SoninL2 :=
  centralSoninProjection a -
    (1 - indicatorCutoff (centralInterval a) (measurableSet_centralInterval a) -
      fourierCutoff (centralInterval a) (measurableSet_centralInterval a))

/-- **Exact time-frequency anticommutator law for the Sonin correction.**  If `Q` is the
projection onto the common kernel of the physical and Fourier cutoffs `P,R`, then the correction
`C = Q - (1 - P - R)` obeys

`C * C + C = P * R + R * P`.

Thus the correction used by the time-band ideal is not merely Hilbert--Schmidt controlled: its
quadratic polynomial is exactly the anticommutator of the two limiting projections. -/
theorem centralSoninProjectionCorrection_sq_add_self_eq_anticommutator (a : ℝ) :
    centralSoninProjectionCorrection a * centralSoninProjectionCorrection a +
        centralSoninProjectionCorrection a =
      (centralPhysicalForbidden a).starProjection *
          (centralFourierForbidden a).starProjection +
        (centralFourierForbidden a).starProjection *
          (centralPhysicalForbidden a).starProjection := by
  let A := centralPhysicalForbidden a
  let B := centralFourierForbidden a
  let P : SoninL2 →L[Complex] SoninL2 := A.starProjection
  let R : SoninL2 →L[Complex] SoninL2 := B.starProjection
  let Q : SoninL2 →L[Complex] SoninL2 := centralSoninProjection a
  let C : SoninL2 →L[Complex] SoninL2 := centralSoninProjectionCorrection a
  have hPP : P * P = P := A.isIdempotentElem_starProjection
  have hRR : R * R = R := B.isIdempotentElem_starProjection
  have hQQ : Q * Q = Q := by
    dsimp only [Q, centralSoninProjection, centralSoninCarrier]
    exact (A.orthogonal ⊓ B.orthogonal).isIdempotentElem_starProjection
  have hPQ : P * Q = 0 := by
    apply ContinuousLinearMap.ext
    intro x
    change A.starProjection ((A.orthogonal ⊓ B.orthogonal).starProjection x) = 0
    apply A.starProjection_apply_eq_zero_iff.mpr
    exact ((A.orthogonal ⊓ B.orthogonal).starProjection_apply_mem x).1
  have hRQ : R * Q = 0 := by
    apply ContinuousLinearMap.ext
    intro x
    change B.starProjection ((A.orthogonal ⊓ B.orthogonal).starProjection x) = 0
    apply B.starProjection_apply_eq_zero_iff.mpr
    exact ((A.orthogonal ⊓ B.orthogonal).starProjection_apply_mem x).2
  have hPadj : P† = P := (isSelfAdjoint_starProjection A).star_eq
  have hRadj : R† = R := (isSelfAdjoint_starProjection B).star_eq
  have hQadj : Q† = Q := by
    dsimp only [Q, centralSoninProjection, centralSoninCarrier]
    exact (isSelfAdjoint_starProjection
      (A.orthogonal ⊓ B.orthogonal)).star_eq
  have hQP : Q * P = 0 := by
    calc
      Q * P = (P * Q)† := by rw [adjoint_mul_soninL2, hQadj, hPadj]
      _ = 0 := by rw [hPQ]; simp
  have hQR : Q * R = 0 := by
    calc
      Q * R = (R * Q)† := by rw [adjoint_mul_soninL2, hQadj, hRadj]
      _ = 0 := by rw [hRQ]; simp
  have hC : C = Q - (1 - P - R) := by
    simp only [C, Q, P, R, A, B, centralSoninProjectionCorrection,
      centralPhysicalForbidden, centralFourierForbidden, centralInterval,
      indicatorCutoff_eq_physicalForbidden_starProjection,
      fourierCutoff_eq_fourierForbidden_starProjection]
  have hidentity : C * C + C = P * R + R * P := by
    rw [hC]
    noncomm_ring [hPP, hRR, hQQ, hPQ, hQP, hRQ, hQR]
  simpa only [C, P, R, A, B] using hidentity

/-- The actual Sonin projection correction lies in the two-sided ideal generated by the two
finite time-band blocks. -/
theorem centralSoninProjectionCorrection_mem_timeBandIdeal
    (a : ℝ) (ha : 0 < a) :
    IsSoninTimeBandIdeal (centralSoninProjectionCorrection a) := by
  let A := centralPhysicalForbidden a
  let B := centralFourierForbidden a
  let T : SoninL2 →L[Complex] SoninL2 := soninAlternatingBlock A B
  let V : SoninL2 →L[Complex] SoninL2 :=
    soninProjectionResolvent A B (norm_centralSoninAlternatingBlock_lt_one a ha)
  let E : SoninL2 →L[Complex] SoninL2 := A.orthogonal.starProjection
  have hAB : IsSoninTimeBandIdeal (A.starProjection * B.starProjection) := by
    simpa [A, B, centralPhysicalForbidden, centralFourierForbidden,
      indicatorCutoff_eq_physicalForbidden_starProjection,
      fourierCutoff_eq_fourierForbidden_starProjection] using
      IsSoninTimeBandIdeal.indicatorFourier a a ha ha
  have hBA : IsSoninTimeBandIdeal (B.starProjection * A.starProjection) := by
    simpa [A, B, centralPhysicalForbidden, centralFourierForbidden,
      indicatorCutoff_eq_physicalForbidden_starProjection,
      fourierCutoff_eq_fourierForbidden_starProjection] using
      IsSoninTimeBandIdeal.fourierIndicator a a ha ha
  have hT : IsSoninTimeBandIdeal T := by
    have h := hBA.rightMul B.starProjection
    simpa [T, soninAlternatingBlock, mul_assoc] using h
  have hVsub : V - 1 = V * T := by
    let e : (SoninL2 →L[Complex] SoninL2)ˣ :=
      Units.oneSub T (by
        simpa [T] using norm_centralSoninAlternatingBlock_lt_one a ha)
    have hV : V = (↑(e⁻¹) : SoninL2 →L[Complex] SoninL2) := by
      rfl
    have hmul : V * (1 - T) = 1 := by
      rw [hV]
      change (↑(e⁻¹) : SoninL2 →L[Complex] SoninL2) *
          (↑e : SoninL2 →L[Complex] SoninL2) = 1
      rw [← Units.val_mul]
      simp
    calc
      V - 1 = V - V * (1 - T) := by rw [hmul]
      _ = V * T := by noncomm_ring
  have hVsubIdeal : IsSoninTimeBandIdeal (V - 1) := by
    rw [hVsub]
    exact hT.leftMul V
  have hABA : IsSoninTimeBandIdeal
      (A.starProjection * B.starProjection * A.starProjection) :=
    hAB.rightMul A.starProjection
  have hmiddle : IsSoninTimeBandIdeal
      (E * (V - 1) * B.starProjection * E) := by
    exact ((hVsubIdeal.leftMul E).rightMul B.starProjection).rightMul E
  have hformula := soninIntersectionProjection_eq_resolventFormula A B
    (norm_centralSoninAlternatingBlock_lt_one a ha)
  have hE : E = 1 - A.starProjection := by
    simpa [E] using A.starProjection_orthogonal'
  have halgebra :
      A.starProjection * B.starProjection + B.starProjection * A.starProjection -
          A.starProjection * B.starProjection * A.starProjection -
            E * (V - 1) * B.starProjection * E =
        (E - E * V * B.starProjection * E) - (E - B.starProjection) := by
    rw [hE]
    noncomm_ring
  have hideal : IsSoninTimeBandIdeal
      (A.starProjection * B.starProjection + B.starProjection * A.starProjection -
        A.starProjection * B.starProjection * A.starProjection -
          E * (V - 1) * B.starProjection * E) :=
    (hAB.add hBA).sub hABA |>.sub hmiddle
  apply hideal.of_eq
  rw [halgebra]
  rw [← hformula]
  rw [hE]
  simp only [centralSoninProjection_eq_soninIntersectionProjection,
    centralSoninProjectionCorrection, A, B,
    centralPhysicalForbidden, centralFourierForbidden,
    indicatorCutoff_eq_physicalForbidden_starProjection,
    fourierCutoff_eq_fourierForbidden_starProjection]
  rfl

/-- Compactness recovered from the stronger factorization certificate. -/
theorem centralSoninProjectionCorrection_isCompactOperator_via_timeBandIdeal
    (a : ℝ) (ha : 0 < a) :
    IsCompactOperator (centralSoninProjectionCorrection a) :=
  (centralSoninProjectionCorrection_mem_timeBandIdeal a ha).isCompactOperator

/-- Replacing a cutoff by another cutoff whose difference has a time-band factorization changes
every lower corner by an operator in the same ideal. No idempotence assumption on the comparison
cutoff is needed. -/
theorem crossBoundary_sub_mem_timeBandIdeal
    {Q Q₀ D : SoninL2 →L[Complex] SoninL2}
    (hQ : IsSoninTimeBandIdeal (Q - Q₀)) :
    IsSoninTimeBandIdeal (crossBoundary Q D - crossBoundary Q₀ D) := by
  have heq : crossBoundary Q D - crossBoundary Q₀ D =
      (1 - Q) * D * (Q - Q₀) - (Q - Q₀) * D * Q₀ := by
    simp only [crossBoundary]
    noncomm_ring
  rw [heq]
  exact (hQ.leftMul ((1 - Q) * D)).sub (hQ.rightMul (D * Q₀))

/-- The formal physical/Fourier complement used as the canonical principal cutoff before the
compact time-band correction. -/
def centralSoninFormalComplement (a : ℝ) : SoninL2 →L[Complex] SoninL2 :=
  1 - indicatorCutoff (centralInterval a) (measurableSet_centralInterval a) -
    fourierCutoff (centralInterval a) (measurableSet_centralInterval a)

/-- Linear-response defect between the actual Sonin projection and its formal-complement
principal model, evaluated at an arbitrary bounded observable. -/
def centralSoninCornerCorrectionResponse
    (a : ℝ) (D : SoninL2 →L[Complex] SoninL2) : SoninL2 →L[Complex] SoninL2 :=
  crossBoundary (centralSoninProjection a) D -
    crossBoundary (centralSoninFormalComplement a) D

/-- The response factors linearly through the exact projection correction.  This is the
two-channel perturbation identity used by every norm and Hilbert--Schmidt estimate downstream. -/
theorem centralSoninCornerCorrectionResponse_eq_correction_factorization
    (a : ℝ) (D : SoninL2 →L[Complex] SoninL2) :
    centralSoninCornerCorrectionResponse a D =
      (1 - centralSoninProjection a) * D * centralSoninProjectionCorrection a -
        centralSoninProjectionCorrection a * D * centralSoninFormalComplement a := by
  have hcorrection : centralSoninProjectionCorrection a =
      centralSoninProjection a - centralSoninFormalComplement a := by
    rfl
  rw [centralSoninCornerCorrectionResponse, hcorrection]
  simp only [crossBoundary]
  noncomm_ring

/-- If the exact Sonin projection correction kills a vector, then the part of that vector
outside the actual Sonin carrier has zero physical component.  The decisive input is one-sided
time--frequency transversality: a physically supported vector whose Fourier transform vanishes
on the central interval must be zero. -/
theorem centralPhysicalProjection_one_sub_projection_eq_zero_of_correction_eq_zero
    (a : ℝ) (ha : 0 < a) (psi : SoninL2)
    (hpsi : centralSoninProjectionCorrection a psi = 0) :
    (centralPhysicalForbidden a).starProjection
        (((1 : SoninL2 →L[ℂ] SoninL2) - centralSoninProjection a) psi) = 0 := by
  let A := centralPhysicalForbidden a
  let B := centralFourierForbidden a
  let P : SoninL2 →L[ℂ] SoninL2 := A.starProjection
  let R : SoninL2 →L[ℂ] SoninL2 := B.starProjection
  let Q : SoninL2 →L[ℂ] SoninL2 := centralSoninProjection a
  let C : SoninL2 →L[ℂ] SoninL2 := centralSoninProjectionCorrection a
  let y : SoninL2 := (1 - Q) psi
  have hRR : R * R = R := B.isIdempotentElem_starProjection
  have hQQ : Q * Q = Q := by
    dsimp only [Q, centralSoninProjection, centralSoninCarrier]
    exact (A.orthogonal ⊓ B.orthogonal).isIdempotentElem_starProjection
  have hPQ : P * Q = 0 := by
    apply ContinuousLinearMap.ext
    intro x
    change A.starProjection ((A.orthogonal ⊓ B.orthogonal).starProjection x) = 0
    apply A.starProjection_apply_eq_zero_iff.mpr
    exact ((A.orthogonal ⊓ B.orthogonal).starProjection_apply_mem x).1
  have hRQ : R * Q = 0 := by
    apply ContinuousLinearMap.ext
    intro x
    change B.starProjection ((A.orthogonal ⊓ B.orthogonal).starProjection x) = 0
    apply B.starProjection_apply_eq_zero_iff.mpr
    exact ((A.orthogonal ⊓ B.orthogonal).starProjection_apply_mem x).2
  have hC : C = Q - (1 - P - R) := by
    simp only [C, Q, P, R, A, B, centralSoninProjectionCorrection,
      centralPhysicalForbidden, centralFourierForbidden, centralInterval,
      indicatorCutoff_eq_physicalForbidden_starProjection,
      fourierCutoff_eq_fourierForbidden_starProjection]
  have hCQ : C * Q = 0 := by
    rw [hC]
    noncomm_ring [hQQ, hPQ, hRQ]
  have hQy : Q y = 0 := by
    dsimp only [y]
    change Q (psi - Q psi) = 0
    rw [map_sub]
    have hQQpsi := congrArg (fun T : SoninL2 →L[ℂ] SoninL2 => T psi) hQQ
    have hQQpsi' : Q (Q psi) = Q psi := by
      simpa only [mul_apply_eq_comp] using hQQpsi
    rw [hQQpsi', sub_self]
  have hCy : C y = 0 := by
    dsimp only [y]
    change C (psi - Q psi) = 0
    rw [map_sub, show C (Q psi) = 0 by
      have h := congrArg (fun T : SoninL2 →L[ℂ] SoninL2 => T psi) hCQ
      simpa only [mul_apply_eq_comp, _root_.zero_apply] using h]
    simpa only [sub_zero, C] using hpsi
  have hy : y = P y + R y := by
    have h := hCy
    rw [hC] at h
    change (Q - (1 - P - R)) y = 0 at h
    simp only [_root_.sub_apply, one_apply_eq_self] at h
    rw [hQy] at h
    have h' : y - P y - R y = 0 := by
      simpa only [zero_sub, neg_eq_zero] using h
    have hsub : y - P y = R y := sub_eq_zero.mp h'
    calc
      y = (y - P y) + P y := by abel
      _ = R y + P y := by rw [hsub]
      _ = P y + R y := add_comm _ _
  have hRPy : R (P y) = 0 := by
    have h := congrArg R hy
    rw [map_add] at h
    have hRRy := congrArg (fun T : SoninL2 →L[ℂ] SoninL2 => T y) hRR
    simp only [mul_apply_eq_comp] at hRRy
    rw [hRRy] at h
    apply add_right_cancel (b := R y)
    simpa only [zero_add] using h.symm
  have hPyMem : P y ∈ A ⊓ Bᗮ := by
    constructor
    · exact A.starProjection_apply_mem y
    · exact B.starProjection_apply_eq_zero_iff.mp hRPy
  have htrans : A ⊓ Bᗮ = ⊥ := by
    simpa only [A, B, centralPhysicalForbidden, centralFourierForbidden] using
      physicalForbidden_inf_fourierForbidden_orthogonal_eq_bot a ha
  have hPyZero : P y = 0 := by
    rw [htrans] at hPyMem
    simpa using hPyMem
  simpa only [A, P, Q, y] using hPyZero

/-- Multiplying a correction response by the actual Sonin projection isolates the projection
correction on the crossed vector.  This is the exact bridge from response vanishing to the
correction-kernel transversality theorem above. -/
theorem centralSoninCornerCorrectionResponse_mul_projection
    (a : ℝ) (D : SoninL2 →L[ℂ] SoninL2) :
    centralSoninCornerCorrectionResponse a D * centralSoninProjection a =
      -(centralSoninProjectionCorrection a * D * centralSoninProjection a) := by
  let A := centralPhysicalForbidden a
  let B := centralFourierForbidden a
  let P : SoninL2 →L[ℂ] SoninL2 := A.starProjection
  let R : SoninL2 →L[ℂ] SoninL2 := B.starProjection
  let Q : SoninL2 →L[ℂ] SoninL2 := centralSoninProjection a
  have hQQ : Q * Q = Q := by
    dsimp only [Q, centralSoninProjection, centralSoninCarrier]
    exact (A.orthogonal ⊓ B.orthogonal).isIdempotentElem_starProjection
  have hPQ : P * Q = 0 := by
    apply ContinuousLinearMap.ext
    intro x
    change A.starProjection ((A.orthogonal ⊓ B.orthogonal).starProjection x) = 0
    apply A.starProjection_apply_eq_zero_iff.mpr
    exact ((A.orthogonal ⊓ B.orthogonal).starProjection_apply_mem x).1
  have hRQ : R * Q = 0 := by
    apply ContinuousLinearMap.ext
    intro x
    change B.starProjection ((A.orthogonal ⊓ B.orthogonal).starProjection x) = 0
    apply B.starProjection_apply_eq_zero_iff.mpr
    exact ((A.orthogonal ⊓ B.orthogonal).starProjection_apply_mem x).2
  simp only [centralSoninCornerCorrectionResponse, crossBoundary,
    centralSoninFormalComplement, centralSoninProjectionCorrection, centralInterval,
    indicatorCutoff_eq_physicalForbidden_starProjection,
    fourierCutoff_eq_fourierForbidden_starProjection]
  change (((1 - Q) * D * Q - (1 - (1 - P - R)) * D * (1 - P - R)) * Q) =
    -((Q - (1 - P - R)) * D * Q)
  noncomm_ring [hQQ, hPQ, hRQ]

/-- The correction response is a bounded linear map of the inserted observable.  This is the
continuity interface needed by operator tomography; it does not assume a time evolution. -/
noncomputable def centralSoninCornerCorrectionResponseCLM (a : ℝ) :
    (SoninL2 →L[Complex] SoninL2) →L[Complex]
      (SoninL2 →L[Complex] SoninL2) :=
  let Q := centralSoninProjection a
  let Q₀ := centralSoninFormalComplement a
  LinearMap.mkContinuous
    { toFun := centralSoninCornerCorrectionResponse a
      map_add' := by
        intro D E
        simp only [centralSoninCornerCorrectionResponse, crossBoundary]
        noncomm_ring
      map_smul' := by
        intro c D
        simp only [RingHom.id_apply, centralSoninCornerCorrectionResponse, crossBoundary,
          mul_smul_comm, smul_mul_assoc, smul_sub] }
    (‖1 - Q‖ * ‖Q‖ + ‖1 - Q₀‖ * ‖Q₀‖)
    (fun D => by
      have hQbound :
          ‖crossBoundary Q D‖ ≤ (‖1 - Q‖ * ‖Q‖) * ‖D‖ := by
        calc
          ‖crossBoundary Q D‖ = ‖(1 - Q) * D * Q‖ := rfl
          _ ≤ ‖(1 - Q) * D‖ * ‖Q‖ := norm_mul_le _ _
          _ ≤ (‖1 - Q‖ * ‖D‖) * ‖Q‖ :=
            mul_le_mul_of_nonneg_right (norm_mul_le _ _) (norm_nonneg Q)
          _ = (‖1 - Q‖ * ‖Q‖) * ‖D‖ := by ring
      have hQ₀bound :
          ‖crossBoundary Q₀ D‖ ≤ (‖1 - Q₀‖ * ‖Q₀‖) * ‖D‖ := by
        calc
          ‖crossBoundary Q₀ D‖ = ‖(1 - Q₀) * D * Q₀‖ := rfl
          _ ≤ ‖(1 - Q₀) * D‖ * ‖Q₀‖ := norm_mul_le _ _
          _ ≤ (‖1 - Q₀‖ * ‖D‖) * ‖Q₀‖ :=
            mul_le_mul_of_nonneg_right (norm_mul_le _ _) (norm_nonneg Q₀)
          _ = (‖1 - Q₀‖ * ‖Q₀‖) * ‖D‖ := by ring
      calc
        ‖centralSoninCornerCorrectionResponse a D‖ ≤
            ‖crossBoundary Q D‖ + ‖crossBoundary Q₀ D‖ := norm_sub_le _ _
        _ ≤ (‖1 - Q‖ * ‖Q‖) * ‖D‖ +
            (‖1 - Q₀‖ * ‖Q₀‖) * ‖D‖ := add_le_add hQbound hQ₀bound
        _ = (‖1 - Q‖ * ‖Q‖ + ‖1 - Q₀‖ * ‖Q₀‖) * ‖D‖ := by ring)

@[simp]
theorem centralSoninCornerCorrectionResponseCLM_apply
    (a : ℝ) (D : SoninL2 →L[Complex] SoninL2) :
    centralSoninCornerCorrectionResponseCLM a D =
      centralSoninCornerCorrectionResponse a D := rfl

/-- Every bounded-observable correction response lies in the concrete two-sided time-band ideal.
This generic interface also covers nonlinear signal observables such as `D * D`; no separate
prime-scale factorization is required. -/
theorem centralSoninCornerCorrectionResponse_mem_timeBandIdeal
    (a : ℝ) (ha : 0 < a) (D : SoninL2 →L[Complex] SoninL2) :
    IsSoninTimeBandIdeal (centralSoninCornerCorrectionResponse a D) := by
  have hcorrection := centralSoninProjectionCorrection_mem_timeBandIdeal a ha
  have hresponse := crossBoundary_sub_mem_timeBandIdeal
    (Q := centralSoninProjection a) (Q₀ := centralSoninFormalComplement a)
    (D := D) hcorrection
  simpa [centralSoninCornerCorrectionResponse,
    centralSoninProjectionCorrection] using hresponse

/-- **Identity-response anticommutator law.**  The actual projection has no boundary response to
the identity, whereas the non-idempotent formal complement retains exactly the Jordan overlap of
the physical and Fourier sharp effects. -/
theorem centralSoninCornerCorrectionResponse_one_eq_anticommutator (a : ℝ) :
    centralSoninCornerCorrectionResponse a 1 =
      (centralPhysicalForbidden a).starProjection *
          (centralFourierForbidden a).starProjection +
        (centralFourierForbidden a).starProjection *
          (centralPhysicalForbidden a).starProjection := by
  let P : SoninL2 →L[Complex] SoninL2 :=
    (centralPhysicalForbidden a).starProjection
  let R : SoninL2 →L[Complex] SoninL2 :=
    (centralFourierForbidden a).starProjection
  have hPP : P * P = P := (centralPhysicalForbidden a).isIdempotentElem_starProjection
  have hRR : R * R = R := (centralFourierForbidden a).isIdempotentElem_starProjection
  have hQ : IsIdempotentElem (centralSoninProjection a) :=
    (centralSoninCarrier a).isIdempotentElem_starProjection
  have hformal : centralSoninFormalComplement a = 1 - P - R := by
    simp [centralSoninFormalComplement, P, R,
      centralPhysicalForbidden, centralFourierForbidden, centralInterval,
      indicatorCutoff_eq_physicalForbidden_starProjection,
      fourierCutoff_eq_fourierForbidden_starProjection]
  change centralSoninCornerCorrectionResponse a 1 = P * R + R * P
  rw [centralSoninCornerCorrectionResponse, crossBoundary_one hQ, hformal]
  simp only [zero_sub, crossBoundary, one_mul, mul_one]
  noncomm_ring [hPP, hRR]

/-- The principal lower Sonin dilation corner obtained from the formal complement cutoff. -/
def centralSoninPrincipalDilationCorner
    (a p : ℝ) (hp : 1 < p) : SoninL2 →L[Complex] SoninL2 :=
  crossBoundary (centralSoninFormalComplement a) (dilationSum p hp)

/-- The exact residual between the actual Sonin corner and its formal-complement principal part. -/
def centralSoninDilationCornerResidual
    (a p : ℝ) (hp : 1 < p) : SoninL2 →L[Complex] SoninL2 :=
  crossBoundary (centralSoninProjection a) (dilationSum p hp) -
    centralSoninPrincipalDilationCorner a p hp

/-- Every prime-scale residual is the correction response evaluated at its symmetric dilation
observable. -/
theorem centralSoninDilationCornerResidual_eq_correctionResponse
    (a p : ℝ) (hp : 1 < p) :
    centralSoninDilationCornerResidual a p hp =
      centralSoninCornerCorrectionResponse a (dilationSum p hp) := by
  rfl

/-- The prime-scale residual therefore factors through the single exact projection correction
on both sides of the symmetric dilation observable. -/
theorem centralSoninDilationCornerResidual_eq_correction_factorization
    (a p : ℝ) (hp : 1 < p) :
    centralSoninDilationCornerResidual a p hp =
      (1 - centralSoninProjection a) * dilationSum p hp *
          centralSoninProjectionCorrection a -
        centralSoninProjectionCorrection a * dilationSum p hp *
          centralSoninFormalComplement a := by
  rw [centralSoninDilationCornerResidual_eq_correctionResponse,
    centralSoninCornerCorrectionResponse_eq_correction_factorization]

/-- **Unconditional Sonin residual nondegeneracy.**  Every positive-aperture symmetric dilation
has a nonzero principal-subtracted Sonin corner residual.  If the residual vanished, the exact
response/projection identity would put every crossed vector in the correction kernel.  One-sided
time--frequency transversality would then kill its physical component, contradicting the explicit
shell sequence on which that component tends to norm one. -/
theorem centralSoninDilationCornerResidual_ne_zero
    (a p : ℝ) (ha : 0 < a) (hp : 1 < p) :
    centralSoninDilationCornerResidual a p hp ≠ 0 := by
  intro hres
  let P : SoninL2 →L[ℂ] SoninL2 := (centralPhysicalForbidden a).starProjection
  let Q : SoninL2 →L[ℂ] SoninL2 := centralSoninProjection a
  let C : SoninL2 →L[ℂ] SoninL2 := centralSoninProjectionCorrection a
  let D : SoninL2 →L[ℂ] SoninL2 := dilationSum p hp
  have hresponse : centralSoninCornerCorrectionResponse a D = 0 := by
    simpa only [D, ← centralSoninDilationCornerResidual_eq_correctionResponse] using hres
  have hmul := centralSoninCornerCorrectionResponse_mul_projection a D
  rw [hresponse, zero_mul] at hmul
  have hCDQ : C * D * Q = 0 := by
    exact neg_eq_zero.mp (by simpa only [C, D, Q] using hmul.symm)
  have hPQ : P * Q = 0 := by
    apply ContinuousLinearMap.ext
    intro x
    change (centralPhysicalForbidden a).starProjection
      ((centralSoninCarrier a).starProjection x) = 0
    apply (centralPhysicalForbidden a).starProjection_apply_eq_zero_iff.mpr
    exact ((centralSoninCarrier a).starProjection_apply_mem x).1
  have hPDQ : P * D * Q = 0 := by
    apply ContinuousLinearMap.ext
    intro x
    have hCx : C (D (Q x)) = 0 := by
      have h := congrArg (fun T : SoninL2 →L[ℂ] SoninL2 => T x) hCDQ
      simpa only [mul_apply_eq_comp, _root_.zero_apply] using h
    have hkernel :=
      centralPhysicalProjection_one_sub_projection_eq_zero_of_correction_eq_zero
        a ha (D (Q x)) (by simpa only [C] using hCx)
    have hPQx : P (Q (D (Q x))) = 0 := by
      have h := congrArg (fun T : SoninL2 →L[ℂ] SoninL2 => T (D (Q x))) hPQ
      simpa only [mul_apply_eq_comp, _root_.zero_apply] using h
    change P (D (Q x)) = 0
    change P ((1 - Q) (D (Q x))) = 0 at hkernel
    simp only [_root_.sub_apply, one_apply_eq_self,
      map_sub, hPQx, sub_zero] at hkernel
    exact hkernel
  have hzero : ∀ n : ℕ,
      ‖(centralPhysicalForbidden a).starProjection
        (dilationSum p hp
          (centralSoninProjection a
            (evenShellVector a (p * a) (by nlinarith) n)))‖ = 0 := by
    intro n
    have h := congrArg (fun T : SoninL2 →L[ℂ] SoninL2 =>
      T (evenShellVector a (p * a) (by nlinarith) n)) hPDQ
    simpa only [P, D, Q, mul_apply_eq_comp,
      _root_.zero_apply, norm_zero] using congrArg norm h
  have ht := centralPhysicalProjection_dilationSum_correctedShell_tendsto a p ha hp
  have ht0 : Tendsto (fun n : ℕ =>
      ‖(centralPhysicalForbidden a).starProjection
        (dilationSum p hp
          (centralSoninProjection a
            (evenShellVector a (p * a) (by nlinarith) n)))‖) atTop (𝓝 0) := by
    have heq : (fun n : ℕ =>
        ‖(centralPhysicalForbidden a).starProjection
          (dilationSum p hp
            (centralSoninProjection a
              (evenShellVector a (p * a) (by nlinarith) n)))‖) =
        (fun _ : ℕ => (0 : ℝ)) := funext hzero
    rw [heq]
    exact tendsto_const_nhds
  have h01 : (0 : ℝ) = 1 := tendsto_nhds_unique ht0 ht
  norm_num at h01

/-! ### Aperture-independent operator radius -/

/-- **Sonin active-space conservation law.**  The physical/Fourier projection mismatch and the
exact projection correction exhaust the squared norm outside the actual Sonin carrier. -/
theorem norm_centralSoninProjectionDifference_sq_add_correction_sq
    (a : ℝ) (psi : SoninL2) :
    ‖((centralPhysicalForbidden a).starProjection -
        (centralFourierForbidden a).starProjection) psi‖ ^ 2 +
      ‖centralSoninProjectionCorrection a psi‖ ^ 2 =
        ‖((1 : SoninL2 →L[ℂ] SoninL2) - centralSoninProjection a) psi‖ ^ 2 := by
  let A := centralPhysicalForbidden a
  let B := centralFourierForbidden a
  let P : SoninL2 →L[ℂ] SoninL2 := A.starProjection
  let R : SoninL2 →L[ℂ] SoninL2 := B.starProjection
  let Q : SoninL2 →L[ℂ] SoninL2 := centralSoninProjection a
  have hP : IsIdempotentElem P := A.isIdempotentElem_starProjection
  have hR : IsIdempotentElem R := B.isIdempotentElem_starProjection
  have hQ : IsIdempotentElem Q := by
    dsimp only [Q, centralSoninProjection, centralSoninCarrier]
    exact (A.orthogonal ⊓ B.orthogonal).isIdempotentElem_starProjection
  have hPadj : ContinuousLinearMap.adjoint P = P :=
    (isSelfAdjoint_starProjection A).star_eq
  have hRadj : ContinuousLinearMap.adjoint R = R :=
    (isSelfAdjoint_starProjection B).star_eq
  have hQadj : ContinuousLinearMap.adjoint Q = Q := by
    dsimp only [Q, centralSoninProjection, centralSoninCarrier]
    exact (isSelfAdjoint_starProjection
      (A.orthogonal ⊓ B.orthogonal)).star_eq
  have hPQ : P * Q = 0 := by
    apply ContinuousLinearMap.ext
    intro x
    change A.starProjection
      ((A.orthogonal ⊓ B.orthogonal).starProjection x) = 0
    apply A.starProjection_apply_eq_zero_iff.mpr
    exact ((A.orthogonal ⊓ B.orthogonal).starProjection_apply_mem x).1
  have hRQ : R * Q = 0 := by
    apply ContinuousLinearMap.ext
    intro x
    change B.starProjection
      ((A.orthogonal ⊓ B.orthogonal).starProjection x) = 0
    apply B.starProjection_apply_eq_zero_iff.mpr
    exact ((A.orthogonal ⊓ B.orthogonal).starProjection_apply_mem x).2
  have hQP : Q * P = 0 := by
    calc
      Q * P = ContinuousLinearMap.adjoint (P * Q) := by
        rw [adjoint_mul_soninL2, hQadj, hPadj]
      _ = 0 := by rw [hPQ]; simp
  have hQR : Q * R = 0 := by
    calc
      Q * R = ContinuousLinearMap.adjoint (R * Q) := by
        rw [adjoint_mul_soninL2, hQadj, hRadj]
      _ = 0 := by rw [hRQ]; simp
  have henergy :=
    HTGeometry.norm_twoProjection_difference_sq_add_corrected_complement_sq
      P R Q hP hR hQ hPadj hRadj hQadj hPQ hQP hRQ hQR psi
  simpa only [P, R, Q, A, B, centralSoninProjectionCorrection,
    centralPhysicalForbidden, centralFourierForbidden, centralInterval,
    indicatorCutoff_eq_physicalForbidden_starProjection,
    fourierCutoff_eq_fourierForbidden_starProjection] using henergy

theorem norm_one_sub_centralSoninProjection_le_one (a : ℝ) :
    ‖(1 : SoninL2 →L[ℂ] SoninL2) - centralSoninProjection a‖ ≤ 1 := by
  rw [centralSoninProjection]
  rw [← (centralSoninCarrier a).starProjection_orthogonal']
  exact Submodule.starProjection_norm_le _

/-- The exact Sonin projection correction is a contraction. -/
theorem norm_centralSoninProjectionCorrection_le_one (a : ℝ) :
    ‖centralSoninProjectionCorrection a‖ ≤ 1 := by
  apply (centralSoninProjectionCorrection a).opNorm_le_bound zero_le_one
  intro psi
  have henergy := norm_centralSoninProjectionDifference_sq_add_correction_sq a psi
  have hcorr : ‖centralSoninProjectionCorrection a psi‖ ≤
      ‖((1 : SoninL2 →L[ℂ] SoninL2) - centralSoninProjection a) psi‖ := by
    apply (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mp
    nlinarith [sq_nonneg
      ‖((centralPhysicalForbidden a).starProjection -
        (centralFourierForbidden a).starProjection) psi‖]
  calc
    ‖centralSoninProjectionCorrection a psi‖ ≤
        ‖((1 : SoninL2 →L[ℂ] SoninL2) - centralSoninProjection a) psi‖ := hcorr
    _ ≤ ‖(1 : SoninL2 →L[ℂ] SoninL2) - centralSoninProjection a‖ * ‖psi‖ :=
      ((1 : SoninL2 →L[ℂ] SoninL2) - centralSoninProjection a).le_opNorm psi
    _ ≤ 1 * ‖psi‖ := mul_le_mul_of_nonneg_right
      (norm_one_sub_centralSoninProjection_le_one a) (norm_nonneg psi)

/-- **Sharp two-projection bound.**  The formal physical/Fourier complement is a contraction. -/
theorem norm_centralSoninFormalComplement_le_one (a : ℝ) :
    ‖centralSoninFormalComplement a‖ ≤ 1 := by
  rw [centralSoninFormalComplement,
    indicatorCutoff_eq_physicalForbidden_starProjection,
    fourierCutoff_eq_fourierForbidden_starProjection]
  exact HTGeometry.norm_twoProjection_complement_le_one
    (centralPhysicalForbidden a).starProjection
    (centralFourierForbidden a).starProjection
    (centralPhysicalForbidden a).isIdempotentElem_starProjection
    (centralFourierForbidden a).isIdempotentElem_starProjection
    (isSelfAdjoint_starProjection (centralPhysicalForbidden a)).star_eq
    (isSelfAdjoint_starProjection (centralFourierForbidden a)).star_eq

/-- The active-space correction law gives an aperture- and scale-independent residual ceiling. -/
theorem norm_centralSoninDilationCornerResidual_le_four
    (a p : ℝ) (hp : 1 < p) :
    ‖centralSoninDilationCornerResidual a p hp‖ ≤ 4 := by
  let Q := centralSoninProjection a
  let Q₀ := centralSoninFormalComplement a
  let D := dilationSum p hp
  let C := centralSoninProjectionCorrection a
  have hEq : centralSoninDilationCornerResidual a p hp =
      (1 - Q) * D * C - C * D * Q₀ := by
    simpa [Q, Q₀, D, C] using
      centralSoninDilationCornerResidual_eq_correction_factorization a p hp
  have hQ : ‖(1 : SoninL2 →L[ℂ] SoninL2) - Q‖ ≤ 1 := by
    simpa [Q] using norm_one_sub_centralSoninProjection_le_one a
  have hQ₀ : ‖Q₀‖ ≤ 1 := by
    simpa [Q₀] using norm_centralSoninFormalComplement_le_one a
  have hC : ‖C‖ ≤ 1 := by
    simpa [C] using norm_centralSoninProjectionCorrection_le_one a
  have hD : ‖D‖ ≤ 2 := by
    dsimp [D]
    apply (dilationSum p hp).opNorm_le_bound (by norm_num)
    intro f
    rw [dilationSum_apply]
    calc
      ‖dilation p (zero_lt_one.trans hp) f +
          dilation p⁻¹ (inv_pos.mpr (zero_lt_one.trans hp)) f‖
          ≤ ‖dilation p (zero_lt_one.trans hp) f‖ +
            ‖dilation p⁻¹ (inv_pos.mpr (zero_lt_one.trans hp)) f‖ := norm_add_le _ _
      _ = 2 * ‖f‖ := by
        rw [(dilation p (zero_lt_one.trans hp)).norm_map,
          (dilation p⁻¹ (inv_pos.mpr (zero_lt_one.trans hp))).norm_map]
        ring
  rw [hEq]
  calc
    ‖(1 - Q) * D * C - C * D * Q₀‖ ≤
        ‖(1 - Q) * D * C‖ + ‖C * D * Q₀‖ := norm_sub_le _ _
    _ ≤ (‖1 - Q‖ * ‖D‖) * ‖C‖ + (‖C‖ * ‖D‖) * ‖Q₀‖ := by
      exact add_le_add
        ((norm_mul_le ((1 - Q) * D) C).trans
          (mul_le_mul_of_nonneg_right (norm_mul_le (1 - Q) D) (norm_nonneg C)))
        ((norm_mul_le (C * D) Q₀).trans
          (mul_le_mul_of_nonneg_right (norm_mul_le C D) (norm_nonneg Q₀)))
    _ ≤ (1 * 2) * 1 + (1 * 2) * 1 := by gcongr
    _ = 4 := by norm_num

/-- The actual one-scale Sonin corner residual retains a finite time-band factorization
certificate. This is stronger data than compactness and is the exact algebraic input for its
Hilbert--Schmidt upgrade. -/
theorem centralSoninDilationCornerResidual_mem_timeBandIdeal
    (a p : ℝ) (ha : 0 < a) (hp : 1 < p) :
    IsSoninTimeBandIdeal (centralSoninDilationCornerResidual a p hp) := by
  have hQ := centralSoninProjectionCorrection_mem_timeBandIdeal a ha
  have h := crossBoundary_sub_mem_timeBandIdeal
    (Q := centralSoninProjection a) (Q₀ := centralSoninFormalComplement a)
    (D := dilationSum p hp) hQ
  simpa [centralSoninDilationCornerResidual,
    centralSoninPrincipalDilationCorner, centralSoninFormalComplement,
    centralSoninProjectionCorrection] using h

/-- Compactness of the principal-subtracted lower corner follows from its stronger time-band
ideal certificate. -/
theorem centralSoninDilationCornerResidual_isCompactOperator
    (a p : ℝ) (ha : 0 < a) (hp : 1 < p) :
    IsCompactOperator (centralSoninDilationCornerResidual a p hp) :=
  (centralSoninDilationCornerResidual_mem_timeBandIdeal a p ha hp).isCompactOperator

/-- The positive energy of the principal-subtracted ambient Sonin dilation corner. -/
def centralSoninDilationCornerResidualEnergy
    (a p : ℝ) (hp : 1 < p) : SoninL2 →L[Complex] SoninL2 :=
  (centralSoninDilationCornerResidual a p hp)† *
    centralSoninDilationCornerResidual a p hp

/-- The residual energy has an explicit product-of-two-time-band factors certificate, the
constructive trace-class presentation used by the route. -/
theorem centralSoninDilationCornerResidualEnergy_mem_traceIdeal
    (a p : ℝ) (ha : 0 < a) (hp : 1 < p) :
    IsSoninTimeBandTraceIdeal (centralSoninDilationCornerResidualEnergy a p hp) := by
  let R := centralSoninDilationCornerResidual a p hp
  have hR : IsSoninTimeBandIdeal R :=
    centralSoninDilationCornerResidual_mem_timeBandIdeal a p ha hp
  exact ⟨R†, R, hR.adjoint, hR, rfl⟩

/-- The trace-ideal residual energy is compact. -/
theorem centralSoninDilationCornerResidualEnergy_isCompactOperator
    (a p : ℝ) (ha : 0 < a) (hp : 1 < p) :
    IsCompactOperator (centralSoninDilationCornerResidualEnergy a p hp) :=
  (centralSoninDilationCornerResidualEnergy_mem_traceIdeal a p ha hp).isCompactOperator

/-- The trace-ideal residual energy has nonnegative quadratic form. -/
theorem centralSoninDilationCornerResidualEnergy_re_inner_nonneg
    (a p : ℝ) (hp : 1 < p) (x : SoninL2) :
    0 ≤ Complex.re
      (inner Complex x (centralSoninDilationCornerResidualEnergy a p hp x)) := by
  change 0 ≤ Complex.re
    (inner Complex x
      (ContinuousLinearMap.adjoint (centralSoninDilationCornerResidual a p hp)
        (centralSoninDilationCornerResidual a p hp x)))
  rw [ContinuousLinearMap.adjoint_inner_right]
  exact inner_self_nonneg (𝕜 := Complex) (E := SoninL2)

end RHTower
