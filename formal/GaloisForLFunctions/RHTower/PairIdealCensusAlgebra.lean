/-
# Pair-ideal census: the polynomial algebra layer

For a finite configuration of distinct points `z i : ℂ` with two exponent profiles `a i`
and `c i`, the pair ideal generated by `W = ∏ (X - z i) ^ a i` and `V = ∏ (X - z i) ^ c i`
in `ℂ[X]` is the principal ideal of the exponent-wise minimum
`G = ∏ (X - z i) ^ min (a i) (c i)`, and the quotient dimension is the census mass
`∑ min (a i) (c i)`.

* `span_pair_pow_eq_span_pow_min`: `(p ^ a, p ^ c) = (p ^ min a c)` in any commutative
  semiring — the local colength identity;
* `quotientProdLinearPowEquiv`: Chinese-remainder splitting of the quotient by a product of
  powers of distinct linear factors into its local factors;
* `finrank_quotient_span_prod_linear_pow`: `dim ℂ[X]/(∏ (X - z i) ^ m i) = ∑ m i`;
* `span_pair_prod_linear_pow_eq_span_min` and `finrank_quotient_span_pair_prod_linear_pow`:
  the pair-ideal census `dim ℂ[X]/(W, V) = ∑ min (a i) (c i)`;
* `radical_prod_linear_pow`, `squarefree_prod_linear`,
  `isRoot_prod_linear_pow_iff_isRoot_prod_linear`, `finrank_quotient_span_prod_linear`:
  the squarefree layer — the radical of `W` is `∏ (X - z i)`, squarefree with the same
  roots, and its quotient dimension counts the distinct points.
-/
import Mathlib

open Polynomial

namespace GaloisForLFunctions
namespace RHTower
namespace PairIdealCensusAlgebra

noncomputable section

/-! ## Local colength: two powers of one element -/

/-- **Local colength identity.** In a commutative semiring, the ideal generated by two powers
of one element is the principal ideal of the smaller power. -/
theorem span_pair_pow_eq_span_pow_min {R : Type*} [CommSemiring R] (p : R) (a c : ℕ) :
    Ideal.span {p ^ a, p ^ c} = Ideal.span {p ^ min a c} := by
  apply le_antisymm
  · rw [Ideal.span_le, Set.pair_subset_iff]
    exact ⟨Ideal.mem_span_singleton.mpr (pow_dvd_pow p (min_le_left a c)),
      Ideal.mem_span_singleton.mpr (pow_dvd_pow p (min_le_right a c))⟩
  · rw [Ideal.span_singleton_le_iff_mem]
    rcases min_choice a c with h | h
    · rw [h]
      exact Ideal.subset_span (Set.mem_insert _ _)
    · rw [h]
      exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)

/-- Local colength, dimension form: the quotient of `ℂ[X]` by the pair ideal `(X ^ a, X ^ c)`
has dimension `min a c`. -/
theorem finrank_quotient_span_pair_X_pow (a c : ℕ) :
    Module.finrank ℂ
      (Polynomial ℂ ⧸ Ideal.span {(X : Polynomial ℂ) ^ a, (X : Polynomial ℂ) ^ c}) =
      min a c := by
  rw [(Ideal.quotientEquivAlgOfEq ℂ
      (span_pair_pow_eq_span_pow_min (X : Polynomial ℂ) a c)).toLinearEquiv.finrank_eq,
    finrank_quotient_span_eq_natDegree, natDegree_X_pow]

/-! ## Chinese-remainder splitting at distinct points -/

variable {ι : Type*} [Fintype ι]

/-- The ideal of a product of powers of distinct linear factors is the intersection of the
local ideals. -/
theorem span_prod_linear_pow_eq_iInf (z : ι → ℂ) (hz : Function.Injective z) (m : ι → ℕ) :
    Ideal.span {∏ i, (X - C (z i)) ^ m i} =
      ⨅ i, Ideal.span {(X - C (z i)) ^ m i} :=
  (Ideal.iInf_span_singleton fun _ _ hij =>
    (Polynomial.pairwise_coprime_X_sub_C hz hij).pow).symm

/-- **Chinese-remainder splitting.** The quotient of `ℂ[X]` by a product of powers of
distinct linear factors is the product of the local quotients. -/
def quotientProdLinearPowEquiv (z : ι → ℂ) (hz : Function.Injective z) (m : ι → ℕ) :
    (Polynomial ℂ ⧸ Ideal.span {∏ i, (X - C (z i)) ^ m i}) ≃+*
      Π i, Polynomial ℂ ⧸ Ideal.span {(X - C (z i)) ^ m i} :=
  (Ideal.quotEquivOfEq (span_prod_linear_pow_eq_iInf z hz m)).trans
    (Ideal.quotientInfRingEquivPiQuotient _ fun _ _ hij =>
      (Ideal.isCoprime_span_singleton_iff _ _).mpr
        ((Polynomial.pairwise_coprime_X_sub_C hz hij).pow))

/-! ## Dimension bookkeeping -/

/-- The degree of a product of powers of linear factors is the exponent sum. -/
theorem natDegree_prod_linear_pow (z : ι → ℂ) (m : ι → ℕ) :
    (∏ i, (X - C (z i)) ^ m i).natDegree = ∑ i, m i := by
  rw [Polynomial.natDegree_prod _ _
    (fun i _ => pow_ne_zero _ (Polynomial.X_sub_C_ne_zero (z i)))]
  simp [Polynomial.natDegree_pow]

/-- **Divisor mass as quotient dimension.** The quotient of `ℂ[X]` by a product of powers of
linear factors has dimension the exponent sum. -/
theorem finrank_quotient_span_prod_linear_pow (z : ι → ℂ) (m : ι → ℕ) :
    Module.finrank ℂ (Polynomial ℂ ⧸ Ideal.span {∏ i, (X - C (z i)) ^ m i}) =
      ∑ i, m i := by
  rw [finrank_quotient_span_eq_natDegree, natDegree_prod_linear_pow]

/-! ## The pair-ideal census -/

/-- After removing the exponent-wise minimum, the two residual cofactors are coprime: at every
point at least one residual exponent vanishes, and distinct points give coprime linear
factors. -/
theorem isCoprime_prod_linear_pow_sub_min (z : ι → ℂ) (hz : Function.Injective z)
    (a c : ι → ℕ) :
    IsCoprime (∏ i, (X - C (z i)) ^ (a i - min (a i) (c i)))
      (∏ i, (X - C (z i)) ^ (c i - min (a i) (c i))) := by
  apply IsCoprime.prod_left
  intro i _
  apply IsCoprime.prod_right
  intro j _
  by_cases hij : i = j
  · subst hij
    rcases le_total (a i) (c i) with h | h
    · rw [min_eq_left h, Nat.sub_self, pow_zero]
      exact isCoprime_one_left
    · rw [min_eq_right h, Nat.sub_self, pow_zero]
      exact isCoprime_one_right
  · exact (Polynomial.pairwise_coprime_X_sub_C hz hij).pow

/-- Factoring out the exponent-wise minimum from one exponent profile. -/
theorem prod_linear_pow_eq_min_mul_residual (z : ι → ℂ) (a c : ι → ℕ) :
    (∏ i, (X - C (z i)) ^ a i) =
      (∏ i, (X - C (z i)) ^ min (a i) (c i)) *
        ∏ i, (X - C (z i)) ^ (a i - min (a i) (c i)) := by
  rw [← Finset.prod_mul_distrib]
  refine Finset.prod_congr rfl fun i _ => ?_
  rw [← pow_add, Nat.add_sub_cancel' (min_le_left _ _)]

/-- **Pair-ideal census, ideal form.** For two exponent profiles on a common configuration of
distinct points, the pair ideal is the principal ideal of the exponent-wise minimum — the gcd
polynomial. -/
theorem span_pair_prod_linear_pow_eq_span_min (z : ι → ℂ) (hz : Function.Injective z)
    (a c : ι → ℕ) :
    Ideal.span {∏ i, (X - C (z i)) ^ a i, ∏ i, (X - C (z i)) ^ c i} =
      Ideal.span {∏ i, (X - C (z i)) ^ min (a i) (c i)} := by
  apply le_antisymm
  · rw [Ideal.span_le, Set.pair_subset_iff]
    exact ⟨Ideal.mem_span_singleton.mpr
        (Finset.prod_dvd_prod_of_dvd _ _ fun i _ => pow_dvd_pow _ (min_le_left _ _)),
      Ideal.mem_span_singleton.mpr
        (Finset.prod_dvd_prod_of_dvd _ _ fun i _ => pow_dvd_pow _ (min_le_right _ _))⟩
  · rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_span_pair]
    obtain ⟨u, v, huv⟩ := isCoprime_prod_linear_pow_sub_min z hz a c
    refine ⟨u, v, ?_⟩
    rw [prod_linear_pow_eq_min_mul_residual z a c]
    have hc : (∏ i, (X - C (z i)) ^ c i) =
        (∏ i, (X - C (z i)) ^ min (a i) (c i)) *
          ∏ i, (X - C (z i)) ^ (c i - min (a i) (c i)) := by
      rw [← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl fun i _ => ?_
      rw [← pow_add, Nat.add_sub_cancel' (min_le_right _ _)]
    rw [hc]
    linear_combination (∏ i, (X - C (z i)) ^ min (a i) (c i)) * huv

/-- **Pair-ideal census, dimension form.** The quotient of `ℂ[X]` by the pair ideal of two
exponent profiles on distinct points has dimension the sum of the pointwise minima. -/
theorem finrank_quotient_span_pair_prod_linear_pow (z : ι → ℂ) (hz : Function.Injective z)
    (a c : ι → ℕ) :
    Module.finrank ℂ
      (Polynomial ℂ ⧸
        Ideal.span {∏ i, (X - C (z i)) ^ a i, ∏ i, (X - C (z i)) ^ c i}) =
      ∑ i, min (a i) (c i) := by
  rw [(Ideal.quotientEquivAlgOfEq ℂ
      (span_pair_prod_linear_pow_eq_span_min z hz a c)).toLinearEquiv.finrank_eq,
    finrank_quotient_span_eq_natDegree, natDegree_prod_linear_pow]

/-! ## The squarefree layer -/

open UniqueFactorizationMonoid in
/-- **Radical of a linear-power product.** The radical of `∏ (X - z i) ^ a i` with all
exponents positive is the squarefree product `∏ (X - z i)`. -/
theorem radical_prod_linear_pow (z : ι → ℂ) (hz : Function.Injective z) (a : ι → ℕ)
    (ha : ∀ i, a i ≠ 0) :
    radical (∏ i, (X - C (z i)) ^ a i) = ∏ i, (X - C (z i)) := by
  rw [radical_prod Finset.univ fun i _ j _ hij =>
    ((Polynomial.pairwise_coprime_X_sub_C hz hij).pow).isRelPrime]
  refine Finset.prod_congr rfl fun i _ => ?_
  rw [radical_pow_of_prime (Polynomial.prime_X_sub_C (z i)) (ha i),
    (Polynomial.monic_X_sub_C (z i)).normalize_eq_self]

/-- The product of distinct linear factors is squarefree. -/
theorem squarefree_prod_linear (z : ι → ℂ) (hz : Function.Injective z) :
    Squarefree (∏ i, (X - C (z i))) :=
  (Polynomial.separable_prod_X_sub_C_iff.mpr hz).squarefree

/-- The squarefree part divides the original product. -/
theorem prod_linear_dvd_prod_linear_pow (z : ι → ℂ) (a : ι → ℕ) (ha : ∀ i, a i ≠ 0) :
    (∏ i, (X - C (z i))) ∣ ∏ i, (X - C (z i)) ^ a i :=
  Finset.prod_dvd_prod_of_dvd _ _ fun i _ => dvd_pow_self _ (ha i)

/-- The squarefree part has exactly the roots of the original product. -/
theorem isRoot_prod_linear_pow_iff_isRoot_prod_linear (z : ι → ℂ) (a : ι → ℕ)
    (ha : ∀ i, a i ≠ 0) (x : ℂ) :
    (∏ i, (X - C (z i)) ^ a i).IsRoot x ↔ (∏ i, (X - C (z i))).IsRoot x := by
  simp only [Polynomial.IsRoot, Polynomial.eval_prod, Polynomial.eval_pow,
    Finset.prod_eq_zero_iff, Finset.mem_univ, true_and]
  constructor
  · rintro ⟨i, hi⟩
    exact ⟨i, (pow_eq_zero_iff (ha i)).mp hi⟩
  · rintro ⟨i, hi⟩
    exact ⟨i, by rw [hi, zero_pow (ha i)]⟩

/-- **Squarefree census.** The quotient of `ℂ[X]` by the squarefree part has dimension the
number of distinct points. -/
theorem finrank_quotient_span_prod_linear (z : ι → ℂ) :
    Module.finrank ℂ (Polynomial ℂ ⧸ Ideal.span {∏ i, (X - C (z i))}) =
      Fintype.card ι := by
  rw [finrank_quotient_span_eq_natDegree,
    Polynomial.natDegree_prod _ _ (fun i _ => Polynomial.X_sub_C_ne_zero (z i))]
  simp

end

end PairIdealCensusAlgebra
end RHTower
end GaloisForLFunctions
