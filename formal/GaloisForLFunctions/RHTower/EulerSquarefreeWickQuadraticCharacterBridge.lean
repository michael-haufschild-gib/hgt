import GaloisForLFunctions.RHTower.EulerSquarefreeWickPrimeResidueHT
import GaloisForLFunctions.RHTower.DirichletCharacterTwoAdicQuadratic
import GaloisForLFunctions.RHTower.DirichletCharacterCRTProduct
import GaloisForLFunctions.RHTower.QuadraticJacobiSum
import GaloisForLFunctions.HTGeometry.AnalyticDirichletObservableFieldCorrespondence
import GaloisForLFunctions.HTGeometry.UpperEndDifferentialInstances

/-!
# Quadratic-character analytic realization of the Euler--Wick interaction

The two coefficient gauges of the four-factor squarefree Euler defect can be chosen canonically:
the nontrivial quadratic characters on the unit groups modulo three and modulo four. Their product
is the CRT quadratic character modulo twelve. For the normalized Euler packet, the literal gauge
orbit is `-2` times this character product.

The product character is not a row-plus-column observable: its anchored rectangle value at
`(-1,-1)` is nonzero. The corpus's analytic observable-product correspondence therefore upgrades
this finite obstruction to an actual prime-supported meromorphic Dirichlet carrier that is
relatively hypertranscendental over the full field generated by both marginal residue sectors.
At every unramified prime its coefficient is exactly the bundled quadratic character modulo
twelve, not an arbitrarily enumerated two-point sign.
-/

namespace GaloisForLFunctions.RHTower

open Set
open GaloisForLFunctions.HTGeometry
open scoped Differential UpperEndDifferentialInstances UpperEndComplexTowerInstances

noncomputable section

local instance eulerWickQuadraticUpperEndAnalyticDomain :
    IsDomain upperEndAnalyticSubring :=
  isDomain_upperEndAnalyticSubring

local instance eulerWickQuadraticUpperEndMeroComplexAlgebra :
    Algebra ℂ upperEndMeroField :=
  upperEndComplexToMero.toAlgebra

local instance eulerWickQuadraticUpperEndMeroDifferential :
    Differential upperEndMeroField :=
  upperEndMeroFieldDifferential

/-- Complex quadratic character modulo three. -/
def quadraticCharacterThree : MulChar (ZMod 3) ℂ :=
  (quadraticChar (ZMod 3)).ringHomComp (Int.castRingHom ℂ)

/-- Restriction of the modulo-three quadratic character to units. -/
def quadraticCharacterThreeUnit (u : (ZMod 3)ˣ) : ℂ :=
  quadraticCharacterThree (u : ZMod 3)

/-- Restriction of the corpus's modulo-four quadratic character to units. -/
def quadraticCharacterFourUnit (u : (ZMod 4)ˣ) : ℂ :=
  RHTower.quadraticCharacterFour (u : ZMod 4)

@[simp] theorem quadraticCharacterThreeUnit_one :
    quadraticCharacterThreeUnit 1 = 1 := by
  simp [quadraticCharacterThreeUnit, quadraticCharacterThree]

@[simp] theorem quadraticCharacterFourUnit_one :
    quadraticCharacterFourUnit 1 = 1 := by
  simp [quadraticCharacterFourUnit, RHTower.quadraticCharacterFour]

@[simp] theorem quadraticCharacterThreeUnit_neg_one :
    quadraticCharacterThreeUnit (-1) = -1 := by
  have hval : quadraticChar (ZMod 3) (-1) = -1 := by
    rw [quadraticChar_neg_one (by norm_num [ZMod.ringChar_zmod_n])]
    norm_num [ZMod.χ₄]
  change ((quadraticChar (ZMod 3) (-1) : ℤ) : ℂ) = -1
  rw [hval]
  norm_num

@[simp] theorem quadraticCharacterFourUnit_neg_one :
    quadraticCharacterFourUnit (-1) = -1 := by
  change RHTower.quadraticCharacterFour (-1 : ZMod 4) = -1
  rw [show (-1 : ZMod 4) = 3 by decide]
  norm_num [RHTower.quadraticCharacterFour, ZMod.χ₄]

/-- The two canonical residue characters act on two literal Euler coefficient legs. -/
def eulerSquarefreeWickQuadraticGauge
    (a : Fin 4 → ℂ) (w : (ZMod 3)ˣ × (ZMod 4)ˣ) : Fin 4 → ℂ :=
  fun i => if i = 0 then quadraticCharacterThreeUnit w.1 * a i
    else if i = 1 then quadraticCharacterFourUnit w.2 * a i else a i

/-- The raw four-factor defect transforms by the product of the two quadratic characters. -/
theorem eulerSquarefreeWickFourDefect_quadraticGauge
    (a : Fin 4 → ℂ) (w : (ZMod 3)ˣ × (ZMod 4)ˣ) :
    eulerSquarefreeWickFourDefect (eulerSquarefreeWickQuadraticGauge a w) =
      quadraticCharacterThreeUnit w.1 * quadraticCharacterFourUnit w.2 *
        eulerSquarefreeWickFourDefect a := by
  rw [eulerSquarefreeWickFourDefect_eq, eulerSquarefreeWickFourDefect_eq]
  simp [eulerSquarefreeWickQuadraticGauge]
  ring

/-- Gauge orbit of the literal Euler defect on the two residue-unit groups. -/
def eulerSquarefreeWickQuadraticGaugeOrbitObservable (a : Fin 4 → ℂ) :
    FullValueSubtype ((ZMod 3)ˣ × (ZMod 4)ˣ) → ℂ :=
  fun w => eulerSquarefreeWickFourDefect
    (eulerSquarefreeWickQuadraticGauge a w.1)

/-- Canonical anchored representative of the quadratic gauge orbit modulo both marginals. -/
def eulerSquarefreeWickQuadraticAnchoredObservable (a : Fin 4 → ℂ) :
    FullValueSubtype ((ZMod 3)ˣ × (ZMod 4)ˣ) → ℂ :=
  productAnchoredInteractionPart (ZMod 3)ˣ (ZMod 4)ˣ
    (eulerSquarefreeWickQuadraticGaugeOrbitObservable a)

/-- Exact anchored character-product law for every four-factor packet. -/
theorem eulerSquarefreeWickQuadraticAnchoredObservable_eq
    (a : Fin 4 → ℂ)
    (w : FullValueSubtype ((ZMod 3)ˣ × (ZMod 4)ˣ)) :
    eulerSquarefreeWickQuadraticAnchoredObservable a w =
      eulerSquarefreeWickFourDefect a *
        (quadraticCharacterThreeUnit w.1.1 - 1) *
        (quadraticCharacterFourUnit w.1.2 - 1) := by
  rw [eulerSquarefreeWickQuadraticAnchoredObservable]
  simp only [productAnchoredInteractionPart, productRowPart, productColumnPart,
    eulerSquarefreeWickQuadraticGaugeOrbitObservable,
    eulerSquarefreeWickFourDefect_quadraticGauge,
    quadraticCharacterThreeUnit_one, quadraticCharacterFourUnit_one]
  ring

/-- Joint quadratic residue character on the full two-modulus interaction space. -/
def quadraticResidueProductObservable
    (w : FullValueSubtype ((ZMod 3)ˣ × (ZMod 4)ˣ)) : ℂ :=
  quadraticCharacterThreeUnit w.1.1 * quadraticCharacterFourUnit w.1.2

def quadraticResidueFstObservable
    (w : (ZMod 3)ˣ × (ZMod 4)ˣ) : ℂ :=
  quadraticCharacterThreeUnit w.1

def quadraticResidueSndObservable
    (w : (ZMod 3)ˣ × (ZMod 4)ˣ) : ℂ :=
  quadraticCharacterFourUnit w.2

/-- Bundled CRT product: the canonical quadratic character modulo twelve. -/
def quadraticCharacterTwelve : DirichletCharacter ℂ 12 :=
  RHTower.crtProductCharacter (ZMod.chineseRemainder (by norm_num : Nat.Coprime 3 4))
    quadraticCharacterThree RHTower.quadraticCharacterFour

/-- The residue interaction product is literally the modulo-twelve CRT character on units. -/
theorem quadraticResidueProduct_eq_quadraticCharacterTwelve_on_units
    (u : (ZMod 12)ˣ) :
    quadraticResidueFstObservable
          (coprimeUnitChineseRemainderEquiv 3 4 (by norm_num) u) *
        quadraticResidueSndObservable
          (coprimeUnitChineseRemainderEquiv 3 4 (by norm_num) u) =
      quadraticCharacterTwelve (u : ZMod 12) := by
  rw [quadraticCharacterTwelve, RHTower.crtProductCharacter_apply]
  rfl

/-- The normalized Euler gauge orbit is exactly `-2` times the quadratic residue product. -/
theorem eulerSquarefreeWickNormalizedQuadraticGaugeOrbit_eq_characterProduct
    (w : FullValueSubtype ((ZMod 3)ˣ × (ZMod 4)ˣ)) :
    eulerSquarefreeWickQuadraticGaugeOrbitObservable
        eulerSquarefreeWickNormalizedPacket w =
      -2 * quadraticResidueProductObservable w := by
  rw [eulerSquarefreeWickQuadraticGaugeOrbitObservable,
    eulerSquarefreeWickFourDefect_quadraticGauge,
    eulerSquarefreeWickNormalizedDefect]
  simp [quadraticResidueProductObservable]
  ring

/-- The canonical product character cannot be assembled from separate residue marginals. -/
theorem quadraticResidueProductObservable_not_mem_marginal :
    quadraticResidueProductObservable ∉
      productMarginalObservableSubmodule (ZMod 3)ˣ (ZMod 4)ˣ := by
  intro hmem
  let interaction := productAnchoredInteractionPart (ZMod 3)ˣ (ZMod 4)ˣ
    quadraticResidueProductObservable
  have hinteractionQ : interaction ∈
      productAnchoredInteractionSubmodule (ZMod 3)ˣ (ZMod 4)ˣ :=
    productAnchoredInteractionPart_mem (ZMod 3)ˣ (ZMod 4)ˣ
      quadraticResidueProductObservable
  have hrow := productRowPart_mem_fst (ZMod 3)ˣ (ZMod 4)ˣ
    quadraticResidueProductObservable
  have hcol := productColumnPart_mem_snd (ZMod 3)ˣ (ZMod 4)ˣ
    quadraticResidueProductObservable
  have hmarginalParts :
      productRowPart (ZMod 3)ˣ (ZMod 4)ˣ quadraticResidueProductObservable +
          productColumnPart (ZMod 3)ˣ (ZMod 4)ˣ quadraticResidueProductObservable ∈
        productMarginalObservableSubmodule (ZMod 3)ˣ (ZMod 4)ˣ :=
    Submodule.mem_sup.mpr ⟨_, hrow, _, hcol, rfl⟩
  have hinteractionU : interaction ∈
      productMarginalObservableSubmodule (ZMod 3)ˣ (ZMod 4)ˣ := by
    have heq : interaction = quadraticResidueProductObservable -
        (productRowPart (ZMod 3)ˣ (ZMod 4)ˣ quadraticResidueProductObservable +
          productColumnPart (ZMod 3)ˣ (ZMod 4)ˣ quadraticResidueProductObservable) := by
      funext w
      simp [interaction, productAnchoredInteractionPart]
      ring
    rw [heq]
    exact Submodule.sub_mem _ hmem hmarginalParts
  have hzero : interaction = 0 :=
    (Submodule.disjoint_def.mp
      (productAnchoredInteractionSubmodule_isCompl (ZMod 3)ˣ (ZMod 4)ˣ).1)
      interaction hinteractionU hinteractionQ
  have hvalue := congrFun hzero
    (⟨((-1 : (ZMod 3)ˣ), (-1 : (ZMod 4)ˣ)), Set.mem_univ _⟩)
  norm_num [interaction, productAnchoredInteractionPart, productRowPart,
    productColumnPart, quadraticResidueProductObservable] at hvalue

theorem quadraticCharacterThree_norm_le_one (x : ZMod 3) :
    ‖quadraticCharacterThree x‖ ≤ 1 := by
  have hquadratic : quadraticCharacterThree.IsQuadratic :=
    (quadraticChar_isQuadratic (ZMod 3)).comp (Int.castRingHom ℂ)
  rcases hquadratic x with hzero | hone | hneg
  · rw [hzero]
    norm_num
  · rw [hone]
    norm_num
  · rw [hneg]
    norm_num

theorem quadraticCharacterThreeUnit_norm_le_one (u : (ZMod 3)ˣ) :
    ‖quadraticCharacterThreeUnit u‖ ≤ 1 :=
  quadraticCharacterThree_norm_le_one (u : ZMod 3)

theorem quadraticCharacterFourUnit_norm_le_one (u : (ZMod 4)ˣ) :
    ‖quadraticCharacterFourUnit u‖ ≤ 1 :=
  RHTower.quadraticCharacterFour_norm_le_one (u : ZMod 4)

/-- Full row-plus-column marginal observable space for the two quadratic residue gauges. -/
def quadraticResidueMarginalSubmodule :
    Submodule ℂ
      (FullValueSubtype ((ZMod 3)ˣ × (ZMod 4)ˣ) → ℂ) :=
  productMarginalObservableSubmodule (ZMod 3)ˣ (ZMod 4)ˣ

noncomputable def quadraticResidueMarginalBasis
    (j : Fin (Module.finrank ℂ quadraticResidueMarginalSubmodule))
    (w : (ZMod 3)ˣ × (ZMod 4)ˣ) : ℂ :=
  finiteSubmoduleObservable quadraticResidueMarginalSubmodule j w

noncomputable def quadraticResidueMarginalBasisBound
    (j : Fin (Module.finrank ℂ quadraticResidueMarginalSubmodule)) : ℝ :=
  ∑ w : (ZMod 3)ˣ × (ZMod 4)ˣ, ‖quadraticResidueMarginalBasis j w‖

theorem quadraticResidueMarginalBasis_norm_le
    (j : Fin (Module.finrank ℂ quadraticResidueMarginalSubmodule))
    (w : (ZMod 3)ˣ × (ZMod 4)ˣ) :
    ‖quadraticResidueMarginalBasis j w‖ ≤
      quadraticResidueMarginalBasisBound j := by
  rw [quadraticResidueMarginalBasisBound]
  exact Finset.single_le_sum (fun z _ => norm_nonneg
    (quadraticResidueMarginalBasis j z)) (Finset.mem_univ w)

/-- Actual primes observed through their simultaneous unit residues modulo three and four. -/
def quadraticResiduePrimeProfile :
    Nat.Primes → (ZMod 3)ˣ × (ZMod 4)ˣ :=
  coprimePrimeUnitResidueProfile 3 4 (by norm_num)

/-- Prime coefficient of the canonical joint quadratic residue interaction. -/
def quadraticResidueProductPrimeCoefficient (p : Nat.Primes) : ℂ :=
  quadraticResidueFstObservable (quadraticResiduePrimeProfile p) *
    quadraticResidueSndObservable (quadraticResiduePrimeProfile p)

/-- At every unramified prime, the interaction coefficient is exactly the modulo-twelve
quadratic character. -/
theorem quadraticResidueProductPrimeCoefficient_eq_quadraticCharacterTwelve_of_isUnit
    (p : Nat.Primes) (hp : IsUnit ((p.1 : ℕ) : ZMod 12)) :
    quadraticResidueProductPrimeCoefficient p =
      quadraticCharacterTwelve ((p.1 : ℕ) : ZMod 12) := by
  let u : (ZMod 12)ˣ := hp.unit
  have hu : ((u : (ZMod 12)ˣ) : ZMod 12) = ((p.1 : ℕ) : ZMod 12) :=
    hp.unit_spec
  have hprofile : primeUnitResidueProfile 12 p = u := by
    apply primeUnitResidueProfile_eq_of_cast_eq
    exact hu.symm
  calc
    quadraticResidueProductPrimeCoefficient p =
        quadraticResidueFstObservable
            (coprimeUnitChineseRemainderEquiv 3 4 (by norm_num) u) *
          quadraticResidueSndObservable
            (coprimeUnitChineseRemainderEquiv 3 4 (by norm_num) u) := by
      simp [quadraticResidueProductPrimeCoefficient, quadraticResiduePrimeProfile,
        coprimePrimeUnitResidueProfile, hprofile]
    _ = quadraticCharacterTwelve (u : ZMod 12) :=
      quadraticResidueProduct_eq_quadraticCharacterTwelve_on_units u
    _ = quadraticCharacterTwelve ((p.1 : ℕ) : ZMod 12) := by rw [hu]

theorem quadraticResidueProductPrimeCoefficient_norm_le_one (p : Nat.Primes) :
    ‖quadraticResidueProductPrimeCoefficient p‖ ≤ 1 := by
  rw [quadraticResidueProductPrimeCoefficient, norm_mul]
  exact mul_le_one₀
    (quadraticCharacterThreeUnit_norm_le_one _)
    (norm_nonneg _)
    (quadraticCharacterFourUnit_norm_le_one _)

/-- Analytic differential field generated by all separate mod-three and mod-four marginals. -/
noncomputable def quadraticResidueAnalyticMarginalField (shift : ℂ) :
    IntermediateField upperEndRationalCoordinateField upperEndMeroField :=
  analyticObservableShiftField quadraticResiduePrimeProfile
    quadraticResidueMarginalBasis quadraticResidueMarginalBasisBound
    (fun j p => quadraticResidueMarginalBasis_norm_le j
      (quadraticResiduePrimeProfile p)) shift

/-- Actual meromorphic Dirichlet carrier of the joint modulo-twelve interaction channel. -/
noncomputable def quadraticResidueAnalyticProductCarrier (shift : ℂ) :
    upperEndMeroField :=
  analyticPrimeObservableShiftCarrier quadraticResidueProductPrimeCoefficient 1
    quadraticResidueProductPrimeCoefficient_norm_le_one shift

/-- The actual quadratic interaction carrier is relatively hypertranscendental over the full
analytic marginal field. -/
theorem quadraticResidueAnalyticProductCarrier_relativeHT
    (shift : ℂ) :
    GaloisForLFunctions.DifferentialIndependent
      (quadraticResidueAnalyticMarginalField shift)
      (fun _ : Fin 1 => quadraticResidueAnalyticProductCarrier shift) := by
  let W := (ZMod 3)ˣ × (ZMod 4)ˣ
  let U := quadraticResidueMarginalSubmodule
  let f : Fin (Module.finrank ℂ U) → W → ℂ :=
    quadraticResidueMarginalBasis
  let M : Fin (Module.finrank ℂ U) → ℝ :=
    quadraticResidueMarginalBasisBound
  let x : Nat.Primes → W := quadraticResiduePrimeProfile
  have hx : CofiniteTailDenseOn x Set.univ :=
    cofiniteTailDenseOn_coprimePrimeUnitResidueProfile 3 4 (by norm_num)
  let r := productFstSetoid (ZMod 3)ˣ (ZMod 4)ˣ
  let Ur := ClassInvariantRestricted r
  letI : FiniteDimensional ℂ Ur := classInvariantRestrictedFiniteDimensional r
  have hrpos : 0 < Module.finrank ℂ Ur := by
    rw [classInvariantRestricted_finrank]
    exact Fintype.card_pos_iff.mpr ((nonempty_quotient_iff r).mpr inferInstance)
  have hUpos : 0 < Module.finrank ℂ U := by
    have hle := Submodule.finrank_mono
      (show Ur ≤ U from le_sup_left)
    omega
  letI : Nonempty (Fin (Module.finrank ℂ U)) :=
    Fin.pos_iff_nonempty.mp hUpos
  have hlinear : LinearIndependent ℂ
      (fun j => fun w : FullValueSubtype W => f j w.1) := by
    exact finiteSubmoduleObservable_restricted_linearIndependent U
  have hescape :
      (fun w : FullValueSubtype W =>
        quadraticResidueFstObservable w.1 * quadraticResidueSndObservable w.1) ∉
        Submodule.span ℂ
          (Set.range fun j => fun w : FullValueSubtype W => f j w.1) := by
    change quadraticResidueProductObservable ∉
      Submodule.span ℂ (Set.range (fun j : Fin (Module.finrank ℂ U) =>
        fun w : FullValueSubtype W => finiteSubmoduleObservable U j w.1))
    rw [finiteSubmoduleObservable_restricted_span]
    simpa [U, quadraticResidueMarginalSubmodule] using
      quadraticResidueProductObservable_not_mem_marginal
  have hproduct :=
    (cofiniteTailDenseOn_analyticObservableProduct_relativeHT_iff_product_escapes_span
      x Set.univ hx f (fun _ => continuous_of_discreteTopology) hlinear M
      (fun j p => quadraticResidueMarginalBasis_norm_le j (x p))
      quadraticResidueFstObservable quadraticResidueSndObservable
      continuous_of_discreteTopology continuous_of_discreteTopology 1
      quadraticResidueProductPrimeCoefficient_norm_le_one shift).mpr hescape
  simpa [quadraticResidueAnalyticMarginalField,
    quadraticResidueAnalyticProductCarrier,
    quadraticResidueProductPrimeCoefficient,
    quadraticResiduePrimeProfile, x, f, M, U, W] using! hproduct

/-- The actual modulo-twelve interaction carrier is not contained in the analytic field generated
by every separate modulo-three and modulo-four marginal.  This is the exact analytic
no-cancellation form of the finite checkerboard obstruction. -/
theorem quadraticResidueAnalyticProductCarrier_not_mem_marginalField
    (shift : ℂ) :
    quadraticResidueAnalyticProductCarrier shift ∉
      quadraticResidueAnalyticMarginalField shift := by
  intro hmem
  have hrel := quadraticResidueAnalyticProductCarrier_relativeHT shift
  unfold GaloisForLFunctions.DifferentialIndependent at hrel
  have ht := hrel.transcendental (0, 0)
  apply ht
  let z : quadraticResidueAnalyticMarginalField shift :=
    ⟨quadraticResidueAnalyticProductCarrier shift, hmem⟩
  refine ⟨Polynomial.X - Polynomial.C z, Polynomial.X_sub_C_ne_zero z, ?_⟩
  simp [z]

/-- No analytic marginal counterterm can additively cancel the actual quadratic interaction
carrier. -/
theorem quadraticResidueAnalyticProductCarrier_add_marginal_ne_zero
    (shift : ℂ) (g : quadraticResidueAnalyticMarginalField shift) :
    quadraticResidueAnalyticProductCarrier shift + (g : upperEndMeroField) ≠ 0 := by
  intro hzero
  apply quadraticResidueAnalyticProductCarrier_not_mem_marginalField shift
  have hcarrier :
      quadraticResidueAnalyticProductCarrier shift = -(g : upperEndMeroField) := by
    calc
      quadraticResidueAnalyticProductCarrier shift =
          quadraticResidueAnalyticProductCarrier shift + (g : upperEndMeroField) - g := by ring
      _ = 0 - g := by rw [hzero]
      _ = -(g : upperEndMeroField) := by ring
  rw [hcarrier]
  exact (quadraticResidueAnalyticMarginalField shift).neg_mem g.property

end

end GaloisForLFunctions.RHTower
