import GaloisForLFunctions.RHTower.DeningerDivisiblePowers

/-!
# An isolated element is not a proper power

If the cyclic subgroup generated by an element of infinite order is isolated, then the element is a
maximal root: a proper power of another element would put that element in the cyclic subgroup, and
the exponents would multiply to one.

* `deningerIsolated_not_properPower` : the implication.
-/

namespace RHTower

universe u

/-- **An element of infinite order generating an isolated subgroup is not a proper power.** -/
theorem deningerIsolated_not_properPower {G : Type u} [Group G] (y : G)
    (hy : ∀ n : ℤ, y ^ n = 1 → n = 0)
    (hiso : ∀ (z : G) (n : ℕ), 0 < n → z ^ n ∈ Subgroup.zpowers y → z ∈ Subgroup.zpowers y)
    (z : G) (n : ℕ) (hn : 1 < n) : z ^ n ≠ y := by
  intro h
  have hmem : z ^ n ∈ Subgroup.zpowers y := by
    refine ⟨1, ?_⟩
    show y ^ (1 : ℤ) = z ^ n
    rw [zpow_one, h]
  obtain ⟨k, hk'⟩ := hiso z n (by omega) hmem
  have hk : y ^ k = z := hk'
  have h1 : y ^ ((k : ℤ) * (n : ℤ)) = y ^ (1 : ℤ) := by
    rw [zpow_mul, hk, zpow_one, ← h, zpow_natCast]
  have h2 : y ^ ((k : ℤ) * (n : ℤ) - 1) = 1 := by
    rw [sub_eq_add_neg, zpow_add, h1, zpow_neg, zpow_one, mul_inv_cancel]
  have h3 : (k : ℤ) * (n : ℤ) = 1 := by
    have := hy _ h2
    omega
  rcases Int.mul_eq_one_iff_eq_one_or_neg_one.1 h3 with ⟨-, hn1⟩ | ⟨-, hn1⟩ <;> omega

end RHTower
