import GaloisForLFunctions.HTGeometry.HermiteLindemann

/-!
# The continuation block of a function-field zeta function has transcendence degree one

Over `F_q(C)` the multipliers of the carrier are the powers of a single unit, so the relation
lattice has corank one, spanned by `ln q`; and every Laurent coefficient of `ζ_C` at the edge is a
polynomial in `ln q` over the algebraic numbers, while `ln q` itself occurs as the leading Laurent
coefficient.  The transcendence degree of the continuation block is therefore exactly one, matching
the corank: both invariants collapse to the single Frobenius logarithm.

The upper bound is the algebraic tier of `LinearVersusAlgebraicCollapse`.  The lower bound is the
transcendence of `ln q`, which is `HermiteLindemann`.

* `trdeg_adjoin_log_natCast_eq_one` — the algebra generated by `ln q` has transcendence degree one.
* `trdeg_continuationBlock_eq_one` — **the identity**: any family lying in that algebra and
  containing `ln q` generates an algebra of transcendence degree exactly one.
-/

namespace GaloisForLFunctions.RHTower

open Algebra GaloisForLFunctions.HTGeometry

/-- The algebra generated by the logarithm of an integer `q ≥ 2` has transcendence degree one. -/
theorem trdeg_adjoin_log_natCast_eq_one {q : ℕ} (hq : 2 ≤ q) :
    Algebra.trdeg ℚ (Algebra.adjoin ℚ ({Real.log q} : Set ℝ)) = 1 :=
  trdeg_adjoin_singleton_eq_one (transcendental_log_natCast hq)

/-- **The corank–transcendence identity in the function-field case.**  A family of continuation data
drawn from the algebra generated by the single Frobenius logarithm, and containing that logarithm,
generates an algebra of transcendence degree exactly one — the corank of the relation lattice. -/
theorem trdeg_continuationBlock_eq_one {ι : Type*} {L : ι → ℝ} {q : ℕ} (hq : 2 ≤ q)
    (hsub : Set.range L ⊆ (Algebra.adjoin ℚ ({Real.log q} : Set ℝ) : Set ℝ))
    (hmem : Real.log q ∈ Set.range L) :
    Algebra.trdeg ℚ (Algebra.adjoin ℚ (Set.range L)) = 1 := by
  refine le_antisymm (trdeg_adjoin_le_one_of_subset_adjoin_singleton hsub) ?_
  have hle : Algebra.adjoin ℚ ({Real.log q} : Set ℝ) ≤ Algebra.adjoin ℚ (Set.range L) := by
    refine Algebra.adjoin_le ?_
    rintro y hy
    rw [Set.mem_singleton_iff] at hy
    subst hy
    exact Algebra.subset_adjoin hmem
  rw [← trdeg_adjoin_log_natCast_eq_one hq]
  exact trdeg_le_of_injective _ (Subalgebra.inclusion_injective hle)

end GaloisForLFunctions.RHTower
