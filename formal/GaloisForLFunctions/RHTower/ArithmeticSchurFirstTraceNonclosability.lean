import GaloisForLFunctions.HTGeometry.HilbertSchmidtMatrix
import GaloisForLFunctions.RHTower.ArithmeticSchurRenormalizationLaw
import Mathlib.Data.Nat.Prime.Nth
import Mathlib.NumberTheory.PrimeCounting
import Mathlib.NumberTheory.Bertrand

/-!
# The arithmetic-Schur first-trace clock is nonclosable

The completed Gamma--valuation Schur carrier is the Hardy space generated by reciprocal-prime
coherent kernels.  Removing its vacuum/first-trace coordinate does not repair the prime-log clock.

This module constructs an explicit actual-prime graph-null sequence.  For the `n`th prime `p`,
Bertrand's theorem selects a prime `r` with `p^2 < r <= 2p^2`.  The normalized two-kernel packet
has source norm at most `4 / log p`, while its first-trace clock image is within `8 / p` of the
nonzero first valuation basis vector.  Hence the clock and its squared graph form are not
sequentially closable through the intrinsic arithmetic-Schur Hilbert completion.

`xiTransverseGammaValuationSzegoKernel_eq_scaled_primeHardy_inner` connects this concrete Hardy
model to the existing completed Gamma--valuation kernel.  No Xi zero, RH, or numerical computation
is used.
-/

open Filter Topology
open scoped ENNReal NNReal

namespace RHTower

noncomputable section

def hardyVacuum : PrimeHardy := lp.single 2 0 1

def hardyFirstTail (q : ℝ) (hq : |q| < 1) : PrimeHardy :=
  hardyKernel q hq - hardyVacuum

theorem hardyFirstTail_apply_zero (q : ℝ) (hq : |q| < 1) :
    hardyFirstTail q hq 0 = 0 := by
  change q ^ 0 - (lp.single (E := fun _ : ℕ => ℝ) 2 0 1) 0 = 0
  simp [lp.single_apply]

theorem hardyFirstTail_apply_succ (q : ℝ) (hq : |q| < 1) (m : ℕ) :
    hardyFirstTail q hq (m + 1) = q ^ (m + 1) := by
  change q ^ (m + 1) - (lp.single (E := fun _ : ℕ => ℝ) 2 0 1) (m + 1) = q ^ (m + 1)
  simp [lp.single_apply]

theorem norm_sq_hardyFirstTail {q : ℝ} (hq0 : 0 ≤ q) (hq : q < 1) :
    ‖hardyFirstTail q (by simpa [abs_of_nonneg hq0] using hq)‖ ^ 2 = q ^ 2 / (1 - q ^ 2) := by
  let hqa : |q| < 1 := by simpa [abs_of_nonneg hq0] using hq
  change ‖hardyFirstTail q hqa‖ ^ 2 = q ^ 2 / (1 - q ^ 2)
  have hnorm := lp.norm_rpow_eq_tsum (p := (2 : ℝ≥0∞)) (by norm_num)
    (hardyFirstTail q hqa)
  have hnorm' : ‖hardyFirstTail q hqa‖ ^ 2 =
      ∑' i : ℕ, ‖hardyFirstTail q hqa i‖ ^ 2 := by
    simpa only [ENNReal.toReal_ofNat, Real.rpow_two] using hnorm
  calc
    ‖hardyFirstTail q hqa‖ ^ 2 =
        ∑' i : ℕ, ‖hardyFirstTail q hqa i‖ ^ 2 := hnorm'
    _ = ∑' b : ℕ, hardyFirstTail q hqa (b + 1) ^ 2 := by
          simp only [Real.norm_eq_abs, sq_abs]
          have hq2 : ‖q ^ 2‖ < 1 := by
            rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg q)]
            nlinarith
          have hbase : Summable (fun b : ℕ => (q ^ 2) ^ b) :=
            summable_geometric_of_norm_lt_one hq2
          have hshift : Summable (fun b : ℕ => (q ^ 2) ^ (b + 1)) := by
            refine (hbase.mul_left (q ^ 2)).congr (fun b => ?_)
            rw [pow_succ]
            ring
          have hsum : Summable (fun i : ℕ => hardyFirstTail q hqa i ^ 2) := by
            apply (summable_nat_add_iff 1).mp
            refine hshift.congr (fun n => ?_)
            rw [hardyFirstTail_apply_succ, ← pow_mul, ← pow_mul, Nat.mul_comm]
          have hsplit := hsum.sum_add_tsum_nat_add 1
          simpa [hardyFirstTail_apply_zero] using hsplit.symm
    _ =
        ∑' b : ℕ, (q ^ 2) ^ (b + 1) := by
          apply tsum_congr
          intro b
          rw [hardyFirstTail_apply_succ]
          ring
    _ = q ^ 2 * ∑' b : ℕ, (q ^ 2) ^ b := by
          rw [← tsum_mul_left]
          apply tsum_congr
          intro b
          rw [pow_succ]
          ring
    _ = q ^ 2 * (1 - q ^ 2)⁻¹ := by
          rw [tsum_geometric_of_norm_lt_one]
          rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg q)]
          nlinarith
    _ = q ^ 2 / (1 - q ^ 2) := by rw [div_eq_mul_inv]

theorem norm_hardyFirstTail {q : ℝ} (hq0 : 0 ≤ q) (hq : q < 1) :
    ‖hardyFirstTail q (by simpa [abs_of_nonneg hq0] using hq)‖ =
      q / Real.sqrt (1 - q ^ 2) := by
  have hden : 0 < 1 - q ^ 2 := by nlinarith
  have hsqrt : 0 < Real.sqrt (1 - q ^ 2) := Real.sqrt_pos.2 hden
  have hsq := norm_sq_hardyFirstTail hq0 hq
  have hquot : (q / Real.sqrt (1 - q ^ 2)) ^ 2 = q ^ 2 / (1 - q ^ 2) := by
    field_simp [ne_of_gt hsqrt]
    rw [Real.sq_sqrt (le_of_lt hden)]
  have hnonneg : 0 ≤ q / Real.sqrt (1 - q ^ 2) := div_nonneg hq0 (le_of_lt hsqrt)
  nlinarith [norm_nonneg (hardyFirstTail q (by simpa [abs_of_nonneg hq0] using hq))]

def hardyFirstTailRemainder (q : ℝ) (hq : |q| < 1) : PrimeHardy :=
  q⁻¹ • hardyFirstTail q hq - lp.single 2 1 1

theorem hardyFirstTailRemainder_apply_zero {q : ℝ} (hq : |q| < 1) :
    hardyFirstTailRemainder q hq 0 = 0 := by
  change q⁻¹ * hardyFirstTail q hq 0 -
    (lp.single (E := fun _ : ℕ => ℝ) 2 1 1) 0 = 0
  simp [hardyFirstTail_apply_zero, lp.single_apply]

theorem hardyFirstTailRemainder_apply_one {q : ℝ} (hq0 : q ≠ 0) (hq : |q| < 1) :
    hardyFirstTailRemainder q hq 1 = 0 := by
  change q⁻¹ * hardyFirstTail q hq 1 -
    (lp.single (E := fun _ : ℕ => ℝ) 2 1 1) 1 = 0
  have ht : hardyFirstTail q hq 1 = q := by
    simpa using hardyFirstTail_apply_succ q hq 0
  simp [lp.single_apply, ht, hq0]

theorem hardyFirstTailRemainder_apply_add_two {q : ℝ} (hq : |q| < 1) (m : ℕ) :
    hardyFirstTailRemainder q hq (m + 2) = q ^ (m + 1) := by
  change q⁻¹ * hardyFirstTail q hq (m + 2) -
    (lp.single (E := fun _ : ℕ => ℝ) 2 1 1) (m + 2) = q ^ (m + 1)
  rw [show m + 2 = (m + 1) + 1 by omega, hardyFirstTail_apply_succ]
  simp [lp.single_apply]
  by_cases hq0 : q = 0
  · simp [hq0]
  · field_simp [hq0]
    rw [pow_succ]
    ring

theorem norm_sq_hardyFirstTailRemainder {q : ℝ} (hq0 : 0 < q) (hq : q < 1) :
    ‖hardyFirstTailRemainder q (by simpa [abs_of_pos hq0] using hq)‖ ^ 2 =
      q ^ 2 / (1 - q ^ 2) := by
  let hqa : |q| < 1 := by simpa [abs_of_pos hq0] using hq
  change ‖hardyFirstTailRemainder q hqa‖ ^ 2 = q ^ 2 / (1 - q ^ 2)
  have hnorm := lp.norm_rpow_eq_tsum (p := (2 : ℝ≥0∞)) (by norm_num)
    (hardyFirstTailRemainder q hqa)
  have hnorm' : ‖hardyFirstTailRemainder q hqa‖ ^ 2 =
      ∑' i : ℕ, ‖hardyFirstTailRemainder q hqa i‖ ^ 2 := by
    simpa only [ENNReal.toReal_ofNat, Real.rpow_two] using hnorm
  have hq2 : ‖q ^ 2‖ < 1 := by
    rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg q)]
    nlinarith
  have hbase : Summable (fun b : ℕ => (q ^ 2) ^ b) :=
    summable_geometric_of_norm_lt_one hq2
  have hshift : Summable (fun b : ℕ => (q ^ 2) ^ (b + 1)) := by
    refine (hbase.mul_left (q ^ 2)).congr (fun b => ?_)
    rw [pow_succ]
    ring
  have hsum : Summable (fun i : ℕ => hardyFirstTailRemainder q hqa i ^ 2) := by
    apply (summable_nat_add_iff 2).mp
    refine hshift.congr (fun n => ?_)
    rw [hardyFirstTailRemainder_apply_add_two, ← pow_mul, ← pow_mul, Nat.mul_comm]
  calc
    ‖hardyFirstTailRemainder q hqa‖ ^ 2 =
        ∑' i : ℕ, ‖hardyFirstTailRemainder q hqa i‖ ^ 2 := hnorm'
    _ = ∑' b : ℕ, hardyFirstTailRemainder q hqa (b + 2) ^ 2 := by
          simp only [Real.norm_eq_abs, sq_abs]
          have hsplit := hsum.sum_add_tsum_nat_add 2
          simpa [Finset.sum_range_succ, hardyFirstTailRemainder_apply_zero,
            hardyFirstTailRemainder_apply_one hq0.ne'] using hsplit.symm
    _ = ∑' b : ℕ, (q ^ 2) ^ (b + 1) := by
          apply tsum_congr
          intro b
          rw [hardyFirstTailRemainder_apply_add_two, ← pow_mul, ← pow_mul, Nat.mul_comm]
    _ = q ^ 2 * ∑' b : ℕ, (q ^ 2) ^ b := by
          rw [← tsum_mul_left]
          apply tsum_congr
          intro b
          rw [pow_succ]
          ring
    _ = q ^ 2 * (1 - q ^ 2)⁻¹ := by
          rw [tsum_geometric_of_norm_lt_one hq2]
    _ = q ^ 2 / (1 - q ^ 2) := by rw [div_eq_mul_inv]

theorem norm_hardyFirstTailRemainder {q : ℝ} (hq0 : 0 < q) (hq : q < 1) :
    ‖hardyFirstTailRemainder q (by simpa [abs_of_pos hq0] using hq)‖ =
      q / Real.sqrt (1 - q ^ 2) := by
  have hden : 0 < 1 - q ^ 2 := by nlinarith
  have hsqrt : 0 < Real.sqrt (1 - q ^ 2) := Real.sqrt_pos.2 hden
  have hsq := norm_sq_hardyFirstTailRemainder hq0 hq
  have hquot : (q / Real.sqrt (1 - q ^ 2)) ^ 2 = q ^ 2 / (1 - q ^ 2) := by
    field_simp [ne_of_gt hsqrt]
    rw [Real.sq_sqrt (le_of_lt hden)]
  have hnonneg : 0 ≤ q / Real.sqrt (1 - q ^ 2) :=
    div_nonneg hq0.le (le_of_lt hsqrt)
  nlinarith [norm_nonneg
    (hardyFirstTailRemainder q (by simpa [abs_of_pos hq0] using hq))]

theorem norm_hardyFirstTail_le_two_mul {q : ℝ} (hq0 : 0 < q) (hqhalf : q ≤ 1 / 2) :
    ‖hardyFirstTail q (by
      rw [abs_of_pos hq0]
      linarith)‖ ≤ 2 * q := by
  have hq1 : q < 1 := lt_of_le_of_lt hqhalf (by norm_num)
  rw [norm_hardyFirstTail hq0.le hq1]
  have hrad : (1 / 2 : ℝ) ^ 2 ≤ 1 - q ^ 2 := by nlinarith
  have hsqrt : (1 / 2 : ℝ) ≤ Real.sqrt (1 - q ^ 2) :=
    Real.le_sqrt_of_sq_le hrad
  have hsqrt0 : 0 < Real.sqrt (1 - q ^ 2) := lt_of_lt_of_le (by norm_num) hsqrt
  apply (div_le_iff₀ hsqrt0).2
  nlinarith

theorem norm_hardyFirstTailRemainder_le_two_mul {q : ℝ}
    (hq0 : 0 < q) (hqhalf : q ≤ 1 / 2) :
    ‖hardyFirstTailRemainder q (by
      rw [abs_of_pos hq0]
      linarith)‖ ≤ 2 * q := by
  have hq1 : q < 1 := lt_of_le_of_lt hqhalf (by norm_num)
  rw [norm_hardyFirstTailRemainder hq0 hq1]
  have hrad : (1 / 2 : ℝ) ^ 2 ≤ 1 - q ^ 2 := by nlinarith
  have hsqrt : (1 / 2 : ℝ) ≤ Real.sqrt (1 - q ^ 2) :=
    Real.le_sqrt_of_sq_le hrad
  have hsqrt0 : 0 < Real.sqrt (1 - q ^ 2) := lt_of_lt_of_le (by norm_num) hsqrt
  apply (div_le_iff₀ hsqrt0).2
  nlinarith

def primeReciprocal (p : Nat.Primes) : ℝ := ((p.1 : ℝ))⁻¹

theorem primeReciprocal_pos (p : Nat.Primes) : 0 < primeReciprocal p := by
  apply inv_pos.mpr
  norm_cast
  exact p.2.pos

theorem primeReciprocal_lt_one (p : Nat.Primes) : primeReciprocal p < 1 := by
  apply inv_lt_one_of_one_lt₀
  exact_mod_cast p.2.one_lt

theorem primeReciprocal_abs_lt_one (p : Nat.Primes) : |primeReciprocal p| < 1 := by
  simpa [abs_of_pos (primeReciprocal_pos p)] using primeReciprocal_lt_one p

def primeHardyKernel (p : Nat.Primes) : PrimeHardy :=
  hardyKernel (primeReciprocal p) (primeReciprocal_abs_lt_one p)

def primeHardyTail (p : Nat.Primes) : PrimeHardy :=
  hardyFirstTail (primeReciprocal p) (primeReciprocal_abs_lt_one p)

theorem inner_primeHardyKernel (p r : Nat.Primes) :
    inner ℝ (primeHardyKernel p) (primeHardyKernel r) =
      1 / (1 - primeReciprocal p * primeReciprocal r) := by
  exact inner_hardyKernel _ _
    (primeReciprocal_abs_lt_one p) (primeReciprocal_abs_lt_one r)

/-- The normalized reciprocal-prime Hardy kernels are exactly the intrinsic carrier of the
arithmetic Gamma--valuation Schur kernel; the source amplitudes are only nonzero diagonal
rescalings. -/
theorem xiTransverseGammaValuationSzegoKernel_eq_scaled_primeHardy_inner
    (p r : Nat.Primes) :
    xiTransverseGammaValuationSzegoKernel p r =
      arithmeticPrimeSchurBoundaryAmplitude p *
        arithmeticPrimeSchurBoundaryAmplitude r *
          inner ℝ (primeHardyKernel p) (primeHardyKernel r) := by
  rw [inner_primeHardyKernel, ← arithmeticSchurKernel_prime_eq]
  simp [arithmeticSchurKernel, primeReciprocal,
    xiTransversePrimeApertureDiskNode_one_eq_inv]
  rw [div_eq_mul_inv]

theorem primeReciprocal_le_half (p : Nat.Primes) : primeReciprocal p ≤ 1 / 2 := by
  rw [primeReciprocal, div_eq_mul_inv, one_mul]
  apply (inv_le_inv₀ (by exact_mod_cast p.2.pos) (by norm_num)).2
  exact_mod_cast p.2.two_le

theorem norm_primeHardyTail_le (p : Nat.Primes) :
    ‖primeHardyTail p‖ ≤ 2 / (p.1 : ℝ) := by
  have h := norm_hardyFirstTail_le_two_mul (primeReciprocal_pos p)
    (primeReciprocal_le_half p)
  simpa [primeHardyTail, primeReciprocal, div_eq_mul_inv] using h

theorem norm_primeHardyRemainder_le (p : Nat.Primes) :
    ‖hardyFirstTailRemainder (primeReciprocal p) (primeReciprocal_abs_lt_one p)‖ ≤
      2 / (p.1 : ℝ) := by
  have h := norm_hardyFirstTailRemainder_le_two_mul (primeReciprocal_pos p)
    (primeReciprocal_le_half p)
  simpa [primeReciprocal, div_eq_mul_inv] using h

theorem prime_smul_tail_eq_remainder_add_basisOne (p : Nat.Primes) :
    (p.1 : ℝ) • primeHardyTail p =
      hardyFirstTailRemainder (primeReciprocal p) (primeReciprocal_abs_lt_one p) +
        lp.single 2 1 1 := by
  rw [hardyFirstTailRemainder]
  simp only [sub_add_cancel]
  congr 1
  simp [primeReciprocal]

noncomputable def farPrime (p : Nat.Primes) : Nat.Primes := by
  have hsq : p.1 ^ 2 ≠ 0 := pow_ne_zero 2 p.2.ne_zero
  let r := Classical.choose (Nat.exists_prime_lt_and_le_two_mul (p.1 ^ 2) hsq)
  exact ⟨r, (Classical.choose_spec
    (Nat.exists_prime_lt_and_le_two_mul (p.1 ^ 2) hsq)).1⟩

theorem farPrime_sq_lt (p : Nat.Primes) : p.1 ^ 2 < (farPrime p).1 := by
  have hsq : p.1 ^ 2 ≠ 0 := pow_ne_zero 2 p.2.ne_zero
  exact (Classical.choose_spec
    (Nat.exists_prime_lt_and_le_two_mul (p.1 ^ 2) hsq)).2.1

theorem farPrime_le_two_sq (p : Nat.Primes) : (farPrime p).1 ≤ 2 * p.1 ^ 2 := by
  have hsq : p.1 ^ 2 ≠ 0 := pow_ne_zero 2 p.2.ne_zero
  exact (Classical.choose_spec
    (Nat.exists_prime_lt_and_le_two_mul (p.1 ^ 2) hsq)).2.2

theorem farPrime_log_le_three_log (p : Nat.Primes) :
    Real.log ((farPrime p).1 : ℝ) ≤ 3 * Real.log (p.1 : ℝ) := by
  have hp0 : (0 : ℝ) < p.1 := by exact_mod_cast p.2.pos
  have hr0 : (0 : ℝ) < (farPrime p).1 := by exact_mod_cast (farPrime p).2.pos
  have hleNat := farPrime_le_two_sq p
  have hle : ((farPrime p).1 : ℝ) ≤ 2 * (p.1 : ℝ) ^ 2 := by exact_mod_cast hleNat
  have hlog := Real.log_le_log hr0 hle
  have hlog2 : Real.log 2 ≤ Real.log (p.1 : ℝ) := by
    apply Real.log_le_log (by norm_num)
    exact_mod_cast p.2.two_le
  calc
    Real.log ((farPrime p).1 : ℝ) ≤ Real.log (2 * (p.1 : ℝ) ^ 2) := hlog
    _ = Real.log 2 + Real.log ((p.1 : ℝ) ^ 2) := by
      rw [Real.log_mul (by norm_num) (pow_ne_zero 2 hp0.ne')]
    _ = Real.log 2 + 2 * Real.log (p.1 : ℝ) := by rw [Real.log_pow]; norm_num
    _ ≤ 3 * Real.log (p.1 : ℝ) := by linarith

theorem farPrime_clock_ratio_le (p : Nat.Primes) :
    (p.1 : ℝ) * Real.log ((farPrime p).1 : ℝ) /
        ((farPrime p).1 * Real.log (p.1 : ℝ)) ≤ 3 / (p.1 : ℝ) := by
  let P : ℝ := p.1
  let R : ℝ := (farPrime p).1
  have hP0 : 0 < P := by dsimp [P]; exact_mod_cast p.2.pos
  have hR0 : 0 < R := by dsimp [R]; exact_mod_cast (farPrime p).2.pos
  have hlogP : 0 < Real.log P := Real.log_pos (by
    dsimp [P]
    exact_mod_cast p.2.one_lt)
  have hlog : Real.log R ≤ 3 * Real.log P := by
    simpa [P, R] using farPrime_log_le_three_log p
  have hsq : P ^ 2 ≤ R := by
    dsimp [P, R]
    exact_mod_cast (farPrime_sq_lt p).le
  apply (div_le_iff₀ (mul_pos hR0 hlogP)).2
  calc
    P * Real.log R ≤ 3 * P * Real.log P := by nlinarith
    _ ≤ (3 / P) * (R * Real.log P) := by
      rw [show (3 / P) * (R * Real.log P) = (3 * R * Real.log P) / P by ring]
      apply (le_div_iff₀ hP0).2
      have hm := mul_le_mul_of_nonneg_right hsq
        (mul_nonneg (by norm_num : (0 : ℝ) ≤ 3) hlogP.le)
      nlinarith

def primeHardyKernelMap : (Nat.Primes →₀ ℝ) →ₗ[ℝ] PrimeHardy :=
  Finsupp.lsum ℝ (fun p => LinearMap.toSpanSingleton ℝ _ (primeHardyKernel p))

def primeFirstTraceClock : (Nat.Primes →₀ ℝ) →ₗ[ℝ] PrimeHardy :=
  Finsupp.lsum ℝ (fun p =>
    LinearMap.toSpanSingleton ℝ _ (Real.log (p.1 : ℝ) • primeHardyTail p))

@[simp] theorem primeHardyKernelMap_single (p : Nat.Primes) (c : ℝ) :
    primeHardyKernelMap (Finsupp.single p c) = c • primeHardyKernel p := by
  simp [primeHardyKernelMap]

@[simp] theorem primeFirstTraceClock_single (p : Nat.Primes) (c : ℝ) :
    primeFirstTraceClock (Finsupp.single p c) =
      c • (Real.log (p.1 : ℝ) • primeHardyTail p) := by
  simp [primeFirstTraceClock]

def primeFirstTraceWitness (p r : Nat.Primes) : Nat.Primes →₀ ℝ :=
  ((p.1 : ℝ) / Real.log (p.1 : ℝ)) •
    (Finsupp.single p 1 - Finsupp.single r 1)

theorem primeHardyKernelMap_witness (p r : Nat.Primes) :
    primeHardyKernelMap (primeFirstTraceWitness p r) =
      ((p.1 : ℝ) / Real.log (p.1 : ℝ)) •
        (primeHardyTail p - primeHardyTail r) := by
  simp [primeFirstTraceWitness, primeHardyKernel, primeHardyTail, hardyFirstTail]

theorem primeFirstTraceClock_witness (p r : Nat.Primes) :
    primeFirstTraceClock (primeFirstTraceWitness p r) =
      (p.1 : ℝ) • primeHardyTail p -
        ((p.1 : ℝ) * Real.log (r.1 : ℝ) / Real.log (p.1 : ℝ)) • primeHardyTail r := by
  have hlogp : Real.log (p.1 : ℝ) ≠ 0 :=
    ne_of_gt (Real.log_pos (by exact_mod_cast p.2.one_lt))
  have hpcoef : (p.1 : ℝ) / Real.log (p.1 : ℝ) * Real.log (p.1 : ℝ) = p.1 := by
    field_simp [hlogp]
  have hrcoef : (p.1 : ℝ) / Real.log (p.1 : ℝ) * Real.log (r.1 : ℝ) =
      (p.1 : ℝ) * Real.log (r.1 : ℝ) / Real.log (p.1 : ℝ) := by ring
  simp only [primeFirstTraceWitness, map_smul, map_sub, primeFirstTraceClock_single,
    smul_sub, smul_smul, one_mul]
  rw [hpcoef, hrcoef]

theorem norm_primeHardyKernelMap_farWitness_le (p : Nat.Primes) :
    ‖primeHardyKernelMap (primeFirstTraceWitness p (farPrime p))‖ ≤
      4 / Real.log (p.1 : ℝ) := by
  let P : ℝ := p.1
  let R : ℝ := (farPrime p).1
  let L : ℝ := Real.log P
  have hP0 : 0 < P := by dsimp [P]; exact_mod_cast p.2.pos
  have hR0 : 0 < R := by dsimp [R]; exact_mod_cast (farPrime p).2.pos
  have hL0 : 0 < L := by
    dsimp [L, P]
    exact Real.log_pos (by exact_mod_cast p.2.one_lt)
  have hPR : P ≤ R := by
    dsimp [P, R]
    have hp2 : p.1 ≤ p.1 ^ 2 := by nlinarith [p.2.two_le]
    exact_mod_cast hp2.trans (farPrime_sq_lt p).le
  rw [primeHardyKernelMap_witness, norm_smul, Real.norm_eq_abs,
    abs_of_pos (div_pos hP0 hL0)]
  calc
    P / L * ‖primeHardyTail p - primeHardyTail (farPrime p)‖ ≤
        P / L * (‖primeHardyTail p‖ + ‖primeHardyTail (farPrime p)‖) := by
      exact mul_le_mul_of_nonneg_left (norm_sub_le _ _) (div_nonneg hP0.le hL0.le)
    _ ≤ P / L * (2 / P + 2 / R) := by
      apply mul_le_mul_of_nonneg_left _ (div_nonneg hP0.le hL0.le)
      exact add_le_add (by simpa [P] using norm_primeHardyTail_le p)
        (by simpa [R] using norm_primeHardyTail_le (farPrime p))
    _ = (2 / L) * (1 + P / R) := by field_simp
    _ ≤ (2 / L) * 2 := by
      apply mul_le_mul_of_nonneg_left _ (div_nonneg (by norm_num) hL0.le)
      have : P / R ≤ 1 := (div_le_one hR0).2 hPR
      linarith
    _ = 4 / L := by ring
    _ = 4 / Real.log (p.1 : ℝ) := rfl

theorem norm_primeFirstTraceClock_farWitness_sub_basisOne_le (p : Nat.Primes) :
    ‖primeFirstTraceClock (primeFirstTraceWitness p (farPrime p)) -
        lp.single 2 1 1‖ ≤ 8 / (p.1 : ℝ) := by
  let P : ℝ := p.1
  let R : ℝ := (farPrime p).1
  let L : ℝ := Real.log P
  let M : ℝ := Real.log R
  have hP0 : 0 < P := by dsimp [P]; exact_mod_cast p.2.pos
  have hR0 : 0 < R := by dsimp [R]; exact_mod_cast (farPrime p).2.pos
  have hL0 : 0 < L := by
    dsimp [L, P]
    exact Real.log_pos (by exact_mod_cast p.2.one_lt)
  have hM0 : 0 < M := by
    dsimp [M, R]
    exact Real.log_pos (by exact_mod_cast (farPrime p).2.one_lt)
  rw [primeFirstTraceClock_witness, prime_smul_tail_eq_remainder_add_basisOne]
  have heq :
      (hardyFirstTailRemainder (primeReciprocal p) (primeReciprocal_abs_lt_one p) +
          lp.single 2 1 1 - (P * M / L) • primeHardyTail (farPrime p)) -
          lp.single 2 1 1 =
        hardyFirstTailRemainder (primeReciprocal p) (primeReciprocal_abs_lt_one p) -
          (P * M / L) • primeHardyTail (farPrime p) := by abel
  rw [heq]
  calc
    ‖hardyFirstTailRemainder (primeReciprocal p) (primeReciprocal_abs_lt_one p) -
        (P * M / L) • primeHardyTail (farPrime p)‖ ≤
        ‖hardyFirstTailRemainder (primeReciprocal p) (primeReciprocal_abs_lt_one p)‖ +
          ‖(P * M / L) • primeHardyTail (farPrime p)‖ := norm_sub_le _ _
    _ ≤ 2 / P + (P * M / L) * (2 / R) := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (div_pos (mul_pos hP0 hM0) hL0)]
      exact add_le_add (by simpa [P] using norm_primeHardyRemainder_le p)
        (mul_le_mul_of_nonneg_left
          (by simpa [R] using norm_primeHardyTail_le (farPrime p))
          (div_nonneg (mul_nonneg hP0.le hM0.le) hL0.le))
    _ = 2 / P + 2 * (P * M / (R * L)) := by field_simp
    _ ≤ 2 / P + 2 * (3 / P) := by
      have hratio : P * M / (R * L) ≤ 3 / P := by
        simpa [P, R, L, M] using farPrime_clock_ratio_le p
      simpa [add_comm] using add_le_add_left
        (mul_le_mul_of_nonneg_left hratio (by norm_num : (0 : ℝ) ≤ 2)) (2 / P)
    _ = 8 / P := by ring
    _ = 8 / (p.1 : ℝ) := rfl

def IsSequentiallyClosableThrough
    {D H : Type*} [AddCommGroup D] [Module ℝ D]
    [NormedAddCommGroup H] [NormedSpace ℝ H]
    (T j : D →ₗ[ℝ] H) : Prop :=
  ∀ u : ℕ → D,
    Tendsto (fun n => j (u n)) atTop (𝓝 0) →
    ∀ y : H, Tendsto (fun n => T (u n)) atTop (𝓝 y) → y = 0

theorem not_isSequentiallyClosableThrough_of_graphNull
    {D H : Type*} [AddCommGroup D] [Module ℝ D]
    [NormedAddCommGroup H] [NormedSpace ℝ H]
    (T j : D →ₗ[ℝ] H) (u : ℕ → D) (y : H)
    (hju : Tendsto (fun n => j (u n)) atTop (𝓝 0))
    (hTu : Tendsto (fun n => T (u n)) atTop (𝓝 y)) (hy : y ≠ 0) :
    ¬ IsSequentiallyClosableThrough T j := by
  intro hclose
  exact hy (hclose u hju y hTu)

def nthPrimePoint (n : ℕ) : Nat.Primes :=
  ⟨Nat.nth Nat.Prime n, Nat.prime_nth_prime n⟩

theorem tendsto_nthPrimePoint_cast_atTop :
    Tendsto (fun n : ℕ => ((nthPrimePoint n).1 : ℝ)) atTop atTop := by
  apply Filter.tendsto_atTop.2
  intro b
  obtain ⟨N, hN⟩ := exists_nat_ge b
  filter_upwards [eventually_ge_atTop N] with n hn
  calc
    b ≤ (N : ℝ) := hN
    _ ≤ n := by exact_mod_cast hn
    _ ≤ Nat.nth Nat.Prime n := by
      exact_mod_cast (show n ≤ Nat.nth Nat.Prime n by
        exact (by omega : n ≤ n + 2).trans (Nat.add_two_le_nth_prime n))

def primeFirstTraceNullSequence (n : ℕ) : Nat.Primes →₀ ℝ :=
  let p := nthPrimePoint n
  primeFirstTraceWitness p (farPrime p)

theorem tendsto_primeHardyKernelMap_nullSequence :
    Tendsto (fun n => primeHardyKernelMap (primeFirstTraceNullSequence n))
      atTop (𝓝 0) := by
  have hP := tendsto_nthPrimePoint_cast_atTop
  have hlog : Tendsto (fun n : ℕ => Real.log ((nthPrimePoint n).1 : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp hP
  have hinv : Tendsto (fun n : ℕ =>
      (Real.log ((nthPrimePoint n).1 : ℝ))⁻¹) atTop (𝓝 0) :=
    tendsto_inv_atTop_zero.comp hlog
  have hbound : Tendsto (fun n : ℕ =>
      4 / Real.log ((nthPrimePoint n).1 : ℝ)) atTop (𝓝 0) := by
    simpa [div_eq_mul_inv] using (tendsto_const_nhds.mul hinv :
      Tendsto (fun n : ℕ => 4 * (Real.log ((nthPrimePoint n).1 : ℝ))⁻¹)
        atTop (𝓝 (4 * 0)))
  rw [NormedAddGroup.tendsto_nhds_zero]
  intro ε hε
  have hevent : ∀ᶠ n : ℕ in atTop,
      4 / Real.log ((nthPrimePoint n).1 : ℝ) < ε :=
    (tendsto_order.1 hbound).2 ε hε
  filter_upwards [hevent] with n hn
  exact lt_of_le_of_lt
    (by simpa [primeFirstTraceNullSequence] using
      norm_primeHardyKernelMap_farWitness_le (nthPrimePoint n)) hn

theorem tendsto_primeFirstTraceClock_nullSequence :
    Tendsto (fun n => primeFirstTraceClock (primeFirstTraceNullSequence n))
      atTop (𝓝 (lp.single 2 1 1)) := by
  have hP := tendsto_nthPrimePoint_cast_atTop
  have hinv : Tendsto (fun n : ℕ => (((nthPrimePoint n).1 : ℝ))⁻¹)
      atTop (𝓝 0) := tendsto_inv_atTop_zero.comp hP
  have hbound : Tendsto (fun n : ℕ => 8 / ((nthPrimePoint n).1 : ℝ))
      atTop (𝓝 0) := by
    simpa [div_eq_mul_inv] using (tendsto_const_nhds.mul hinv :
      Tendsto (fun n : ℕ => 8 * (((nthPrimePoint n).1 : ℝ))⁻¹)
        atTop (𝓝 (8 * 0)))
  have hzero : Tendsto (fun n =>
      primeFirstTraceClock (primeFirstTraceNullSequence n) - lp.single 2 1 1)
      atTop (𝓝 0) := by
    rw [NormedAddGroup.tendsto_nhds_zero]
    intro ε hε
    have hevent : ∀ᶠ n : ℕ in atTop,
        8 / ((nthPrimePoint n).1 : ℝ) < ε :=
      (tendsto_order.1 hbound).2 ε hε
    filter_upwards [hevent] with n hn
    exact lt_of_le_of_lt
      (by simpa [primeFirstTraceNullSequence] using
        norm_primeFirstTraceClock_farWitness_sub_basisOne_le (nthPrimePoint n)) hn
  have hadd := hzero.add (tendsto_const_nhds :
    Tendsto (fun _ : ℕ => (lp.single 2 1 1 : PrimeHardy)) atTop (𝓝 (lp.single 2 1 1)))
  simpa only [sub_add_cancel, zero_add] using hadd

theorem primeHardy_basisOne_ne_zero : (lp.single 2 1 1 : PrimeHardy) ≠ 0 := by
  intro h
  have hcoord := congrArg (fun v : PrimeHardy => v 1) h
  change (1 : ℝ) = 0 at hcoord
  norm_num at hcoord

/-- **Actual-prime first-trace obstruction.**  The logarithmic clock after subtraction of the
vacuum/first-trace channel is not sequentially closable on the intrinsic reciprocal-prime Hardy
completion.  The graph-null sequence uses only actual primes, with its second prime selected by
Bertrand's theorem. -/
theorem not_closable_primeFirstTraceClock :
    ¬ IsSequentiallyClosableThrough primeFirstTraceClock primeHardyKernelMap := by
  exact not_isSequentiallyClosableThrough_of_graphNull
    primeFirstTraceClock primeHardyKernelMap primeFirstTraceNullSequence
    (lp.single 2 1 1) tendsto_primeHardyKernelMap_nullSequence
    tendsto_primeFirstTraceClock_nullSequence primeHardy_basisOne_ne_zero

end

