import GaloisForLFunctions.RHTower.DeningerArithmeticCochainComplex
import GaloisForLFunctions.RHTower.XiGuinandWeilExplicitFormula
import Mathlib.RingTheory.Ideal.Colon

/-!
# Source characteristic section for Deninger arithmetic cohomology

The middle cohomology is the cyclic module

`H¹ = Entire(ℂ) / XiC · Entire(ℂ)`.

Consequently its characteristic ideal is not inferred from a separately enumerated divisor: it
is the annihilator of this source quotient, namely the principal ideal generated by `XiC`.
Evaluating the one-relation presentation gives the centered characteristic section `XiC`, or `xi`
in the uncentered `s`-coordinate.

This file also identifies the logarithmic derivative of that source characteristic section with
the independently defined prime--Gamma trace.  It does not call the characteristic section a
zeta-regularized operator determinant; constructing the corresponding topological determinant is
a separate analytic obligation.
-/

open Complex

namespace RHTower

noncomputable section

set_option synthInstance.maxHeartbeats 100000

/-- Characteristic ideal of the cyclic source middle cohomology. -/
def deningerArithmeticH1CharacteristicIdeal : Ideal DeningerEntire :=
  Module.annihilator DeningerEntire DeningerArithmeticH1

/--
The source characteristic ideal is exactly the principal completed-Xi ideal.  This is the
one-relation/Fitting statement for the cochain presentation, with no divisor enumeration.
-/
theorem deningerArithmeticH1CharacteristicIdeal_eq :
    deningerArithmeticH1CharacteristicIdeal = deningerEntireXiIdeal := by
  exact Ideal.annihilator_quotient
    (R := DeningerEntire) (I := deningerEntireXiIdeal)

/-- Centered characteristic section obtained by evaluating the source presentation relation. -/
def deningerArithmeticH1CenteredCharacteristic (z : ℂ) : ℂ :=
  deningerEntireXi z

@[simp]
theorem deningerArithmeticH1CenteredCharacteristic_eq (z : ℂ) :
    deningerArithmeticH1CenteredCharacteristic z = XiC z :=
  rfl

/--
Exact point-spectrum law for the source characteristic section.  The spectrum here is the
point spectrum of the quotient multiplication operator, not a target supplied from a zero list.
-/
theorem deningerArithmeticH1CenteredCharacteristic_eq_zero_iff_eigenvector
    (alpha : ℂ) :
    deningerArithmeticH1CenteredCharacteristic alpha = 0 ↔
      ∃ x : DeningerArithmeticH1,
        x ≠ 0 ∧
          deningerEntireTheta x =
            (1 / 2 + Complex.I * alpha) • x := by
  exact XiC_eq_zero_iff_exists_deningerEntireTheta_eigenvector alpha

/-- Uncentered characteristic section in Deninger's Frobenius coordinate `s`. -/
def deningerArithmeticH1Characteristic (s : ℂ) : ℂ :=
  deningerArithmeticH1CenteredCharacteristic ((s - 1 / 2) * (-Complex.I))

/-- The uncentered source characteristic section is the entire Riemann `xi` function. -/
theorem deningerArithmeticH1Characteristic_eq_xi (s : ℂ) :
    deningerArithmeticH1Characteristic s = xi s := by
  simp only [deningerArithmeticH1Characteristic,
    deningerArithmeticH1CenteredCharacteristic_eq, XiC]
  congr 1
  rw [mul_assoc, neg_mul, Complex.I_mul_I, neg_neg, mul_one]
  ring

/-- Degree-zero endpoint characteristic factor. -/
def deningerArithmeticH0Characteristic (s : ℂ) : ℂ :=
  s

/-- Degree-two endpoint characteristic factor. -/
def deningerArithmeticH2Characteristic (s : ℂ) : ℂ :=
  s - 1

/--
Deninger's alternating characteristic quotient recovers the completed zeta function, with the
standard factor `2` coming from the normalization of `xi`.
-/
theorem deningerArithmeticCharacteristicQuotient_eq_completedRiemannZeta
    {s : ℂ} (h0 : s ≠ 0) (h1 : s ≠ 1) :
    2 * deningerArithmeticH1Characteristic s /
        (deningerArithmeticH0Characteristic s *
          deningerArithmeticH2Characteristic s) =
      completedRiemannZeta s := by
  have hs1 : s - 1 ≠ 0 := sub_ne_zero.mpr h1
  rw [deningerArithmeticH1Characteristic_eq_xi,
    xi_eq_half_mul h0 h1]
  simp only [deningerArithmeticH0Characteristic,
    deningerArithmeticH2Characteristic]
  field_simp [h0, hs1]

/--
Source Lefschetz identity on the continued admissible domain: logarithmic derivative of the
source characteristic section equals the continued prime--Gamma trace.
-/
theorem deningerArithmeticCenteredCharacteristic_logDeriv_eq_continuedPrimeGamma
    {z : ℂ} (h : XiExplicitAdmissible z) :
    logDeriv deningerArithmeticH1CenteredCharacteristic z =
      continuedPrimeArchSourceRelativeTrace z := by
  rw [show deningerArithmeticH1CenteredCharacteristic = XiC by
    funext w
    exact deningerArithmeticH1CenteredCharacteristic_eq w]
  rw [logDeriv_XiC_eq_relativeResolventTrace
    (XiC_ne_zero_of_admissible h)]
  exact (continuedPrimeArchSourceRelativeTrace_eq_xiRelativeResolventTrace
    h.re_pos h.ne_one h.zeta_ne).symm

/--
Absolute-convergence source Lefschetz identity.  Its finite-place term is the honest von-Mangoldt
Dirichlet series and contains no zero data.
-/
theorem deningerArithmeticCenteredCharacteristic_logDeriv_eq_primeGamma
    {z : ℂ} (hz : 1 < (1 / 2 + z * Complex.I).re) :
    logDeriv deningerArithmeticH1CenteredCharacteristic z =
      primeArchSourceRelativeTrace z := by
  have h := XiExplicitAdmissible_of_one_lt_re hz
  rw [show deningerArithmeticH1CenteredCharacteristic = XiC by
    funext w
    exact deningerArithmeticH1CenteredCharacteristic_eq w]
  rw [logDeriv_XiC_eq_relativeResolventTrace
    (XiC_ne_zero_of_admissible h)]
  exact (primeArchSourceRelativeTrace_eq_xiRelativeResolventTrace hz).symm

end

end RHTower
