import Mathlib

/-!
# Haar measure on the closure of a discrete orbit in a torus

For `θ ∈ ℝ^K` let `θ̄ ∈ 𝕋^K` be its image and `H = cl ℤθ̄` the closed subgroup generated by `θ̄`.
`H` is a compact abelian group; `μ_H` is its Haar probability measure, pushed to `𝕋^K`
(`orbitHaar`).

**Characters** (`integral_mFourier_orbitHaar`). For `m ∈ ℤ^K`,
`∫ e_m dμ_H = 1` if `e_m(θ̄) = 1` and `0` otherwise: if `e_m(θ̄) = 1` the character is trivial on
`ℤθ̄`, hence on its closure; otherwise translation invariance by `θ̄ ∈ H` gives
`∫ e_m = e_m(θ̄) ∫ e_m`. Here `e_m(θ̄) = e^{2πi⟨m, θ⟩}` (`mFourier_orbitPoint`).
-/

open MeasureTheory UnitAddTorus Complex Set Filter Topology
open scoped BigOperators

namespace RHTower.BohrOrbit

noncomputable section

variable {K : ℕ}

/-- The point `θ̄ = θ mod ℤ^K` of the torus. -/
def orbitPoint (θ : Fin K → ℝ) : UnitAddTorus (Fin K) := fun i => ((θ i : ℝ) : UnitAddCircle)

/-- The orbit closure `H = cl ℤθ̄`. -/
def orbitSubgroup (θ : Fin K → ℝ) : AddSubgroup (UnitAddTorus (Fin K)) :=
  (AddSubgroup.zmultiples (orbitPoint θ)).topologicalClosure

instance (θ : Fin K → ℝ) : CompactSpace (orbitSubgroup θ) :=
  isCompact_iff_compactSpace.mp (AddSubgroup.isClosed_topologicalClosure _).isCompact

instance (θ : Fin K → ℝ) : MeasurableSpace (orbitSubgroup θ) := borel _

instance (θ : Fin K → ℝ) : BorelSpace (orbitSubgroup θ) := ⟨rfl⟩

/-- The Haar probability measure of `H`. -/
def orbitHaarSub (θ : Fin K → ℝ) : Measure (orbitSubgroup θ) := Measure.addHaarMeasure ⊤

instance (θ : Fin K → ℝ) : (orbitHaarSub θ).IsAddHaarMeasure := by
  unfold orbitHaarSub; infer_instance

instance (θ : Fin K → ℝ) : IsProbabilityMeasure (orbitHaarSub θ) :=
  ⟨Measure.addHaarMeasure_self⟩

/-- **The Haar measure of the orbit closure**, as a measure on `𝕋^K`. -/
def orbitHaar (θ : Fin K → ℝ) : Measure (UnitAddTorus (Fin K)) :=
  (orbitHaarSub θ).map Subtype.val

theorem measurable_subtype_val (θ : Fin K → ℝ) :
    Measurable (Subtype.val : orbitSubgroup θ → UnitAddTorus (Fin K)) :=
  continuous_subtype_val.measurable

instance (θ : Fin K → ℝ) : IsProbabilityMeasure (orbitHaar θ) :=
  Measure.isProbabilityMeasure_map (measurable_subtype_val θ).aemeasurable

theorem orbitPoint_mem (θ : Fin K → ℝ) : orbitPoint θ ∈ orbitSubgroup θ :=
  AddSubgroup.le_topologicalClosure _ (AddSubgroup.mem_zmultiples _)

/-- An open set meeting `H` has positive `μ_H`-measure. -/
theorem orbitHaar_pos_of_isOpen (θ : Fin K → ℝ) {U : Set (UnitAddTorus (Fin K))} (hU : IsOpen U)
    (hUH : ∃ x ∈ U, x ∈ orbitSubgroup θ) : 0 < orbitHaar θ U := by
  unfold orbitHaar
  rw [Measure.map_apply (measurable_subtype_val θ) hU.measurableSet]
  obtain ⟨x, hxU, hxH⟩ := hUH
  exact (hU.preimage continuous_subtype_val).measure_pos _ ⟨⟨x, hxH⟩, hxU⟩

/-! ## Characters -/

theorem fourier_add_point (n : ℤ) (x y : UnitAddCircle) :
    fourier n (x + y) = fourier n x * fourier n y := by
  simp only [fourier_apply, smul_add, AddCircle.toCircle_add, Circle.coe_mul]

theorem mFourier_add_point (m : Fin K → ℤ) (x y : UnitAddTorus (Fin K)) :
    mFourier m (x + y) = mFourier m x * mFourier m y := by
  simp only [mFourier, ContinuousMap.coe_mk, Pi.add_apply, fourier_add_point,
    Finset.prod_mul_distrib]

theorem mFourier_zero_point (m : Fin K → ℤ) : mFourier m (0 : UnitAddTorus (Fin K)) = 1 := by
  simp only [mFourier, ContinuousMap.coe_mk, Pi.zero_apply, fourier_eval_zero,
    Finset.prod_const_one]

theorem mFourier_zsmul_point (m : Fin K → ℤ) (x : UnitAddTorus (Fin K)) (ℓ : ℤ) :
    mFourier m (ℓ • x) = mFourier m x ^ ℓ := by
  have hne : mFourier m x ≠ 0 := by
    intro h
    have := congrArg (‖·‖) h
    simp only [mFourier, ContinuousMap.coe_mk, norm_prod, fourier_apply, Circle.norm_coe,
      Finset.prod_const_one, norm_zero] at this
    exact one_ne_zero this
  induction ℓ using Int.induction_on with
  | zero => simp [mFourier_zero_point]
  | succ n ih =>
      rw [add_smul, one_smul, mFourier_add_point, ih, zpow_add_one₀ hne]
  | pred n ih =>
      have := mFourier_add_point m ((-(n : ℤ) - 1) • x) x
      rw [show (-(n : ℤ) - 1) • x + x = (-(n : ℤ)) • x by rw [sub_smul, one_smul, sub_add_cancel],
        ih] at this
      rw [zpow_sub_one₀ hne, this, mul_assoc, mul_inv_cancel₀ hne, mul_one]

/-- `e_m(θ̄) = e^{2πi⟨m, θ⟩}`. -/
theorem mFourier_orbitPoint (θ : Fin K → ℝ) (m : Fin K → ℤ) :
    mFourier m (orbitPoint θ) = Complex.exp (2 * Real.pi * Complex.I * ∑ i, (m i : ℂ) * θ i) := by
  simp only [mFourier, ContinuousMap.coe_mk, orbitPoint, fourier_coe_apply]
  rw [← Complex.exp_sum, Finset.mul_sum]
  congr 1
  refine Finset.sum_congr rfl fun i _ => ?_
  push_cast
  ring

theorem mFourier_eq_one_on_orbit {θ : Fin K → ℝ} {m : Fin K → ℤ}
    (h : mFourier m (orbitPoint θ) = 1) {x : UnitAddTorus (Fin K)} (hx : x ∈ orbitSubgroup θ) :
    mFourier m x = 1 := by
  have hsub : (AddSubgroup.zmultiples (orbitPoint θ) : Set (UnitAddTorus (Fin K))) ⊆
      {x | mFourier m x = 1} := by
    rintro _ ⟨ℓ, rfl⟩
    simp only [Set.mem_setOf_eq, mFourier_zsmul_point, h, one_zpow]
  have hclosed : IsClosed {x : UnitAddTorus (Fin K) | mFourier m x = 1} :=
    isClosed_eq (mFourier m).continuous continuous_const
  have := closure_minimal hsub hclosed
  exact this hx

/-- **Characters of the orbit closure.** -/
theorem integral_mFourier_orbitHaar (θ : Fin K → ℝ) (m : Fin K → ℤ) :
    ∫ x, mFourier m x ∂(orbitHaar θ) = if mFourier m (orbitPoint θ) = 1 then 1 else 0 := by
  unfold orbitHaar
  rw [integral_map (measurable_subtype_val θ).aemeasurable
    (mFourier m).continuous.aestronglyMeasurable]
  split_ifs with h
  · rw [integral_congr_ae (Eventually.of_forall fun x => mFourier_eq_one_on_orbit h x.2)]
    simp
  · set I := ∫ x : orbitSubgroup θ, mFourier m x.1 ∂(orbitHaarSub θ)
    set g : orbitSubgroup θ := ⟨orbitPoint θ, orbitPoint_mem θ⟩
    have hinv : ∫ x : orbitSubgroup θ, mFourier m (g + x).1 ∂(orbitHaarSub θ) = I :=
      integral_add_left_eq_self (fun x : orbitSubgroup θ => mFourier m x.1) g
    have hmul : ∫ x : orbitSubgroup θ, mFourier m (g + x).1 ∂(orbitHaarSub θ) =
        mFourier m (orbitPoint θ) * I := by
      rw [← integral_const_mul]
      refine integral_congr_ae (Eventually.of_forall fun x => ?_)
      simp only [AddSubgroup.coe_add, mFourier_add_point, g]
    rw [hmul] at hinv
    have : (mFourier m (orbitPoint θ) - 1) * I = 0 := by linear_combination hinv
    rcases mul_eq_zero.mp this with h' | h'
    · exact absurd (sub_eq_zero.mp h') h
    · exact h'

end

end RHTower.BohrOrbit
