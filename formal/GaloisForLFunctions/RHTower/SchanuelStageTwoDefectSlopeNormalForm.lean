import GaloisForLFunctions.RHTower.SchanuelStageTwoExponentialAlgebraicity
import GaloisForLFunctions.HTGeometry.LogarithmicDifferentialPathIntegral
import GaloisForLFunctions.HTGeometry.FunctionFieldPullback

/-!
# Stage-two Schanuel defect-slope affine normalization and analytic pullbacks

Clauses 1--4 of the paper theorem are supplied by the concrete stage-two value-field and
exponential-algebraicity theorems.  This module constructs the integral-closure affine chart of the
slope line and proves that its scheme function field is the concrete stage-two value field.  It
also proves the exact analytic logarithm-lift and regulator formula for genuine coordinate
pullbacks along any supplied smooth divisor-avoiding path.  The algebraic affine-chart construction
and analytic pullback theorem are deliberately kept separate: mathlib currently has no
analytification or complex-point functor identifying evaluations of scheme rational functions with
complex-valued smooth paths, and it has no ready-made projective compactification theorem for a
finite extension of a rational function field.
-/

namespace GaloisForLFunctions.RHTower

open GaloisForLFunctions.HTGeometry
open IntermediateField
open Set
open TopologicalSpace
open scoped IntermediateField.algebraAdjoinAdjoin

set_option synthInstance.maxHeartbeats 1000000
set_option maxHeartbeats 4000000

noncomputable section

/-- Polynomial-coordinate subring generated by the canonical defect slope. -/
abbrev stageTwoSlopeCoordinateRing (x : Fin 2 → ℂ) (core : StageTwoDefectSlopeCore x) :=
  Algebra.adjoin AlgNum
    ({core.rho} : Set (stageTwoValueField (x 0) (x 1)))

/-- Rational function field of the slope line inside the concrete stage-two value field. -/
abbrev stageTwoSlopeRationalField (x : Fin 2 → ℂ) (core : StageTwoDefectSlopeCore x) :=
  IntermediateField.adjoin AlgNum
    ({core.rho} : Set (stageTwoValueField (x 0) (x 1)))

/-- Integral-closure coordinate ring of the canonical affine normalization chart. -/
abbrev stageTwoSlopeAffineNormalizationRing
    (x : Fin 2 → ℂ) (core : StageTwoDefectSlopeCore x) :=
  integralClosure (stageTwoSlopeCoordinateRing x core)
    (stageTwoValueField (x 0) (x 1))

/-- Canonical affine normalization chart obtained from the integral closure of
`AlgNum[core.rho]` in the concrete stage-two value field. -/
abbrev stageTwoSlopeAffineNormalizationScheme
    (x : Fin 2 → ℂ) (core : StageTwoDefectSlopeCore x) :=
  AlgebraicGeometry.Spec (.of (stageTwoSlopeAffineNormalizationRing x core))

/-- The integral-closure chart is an integral affine scheme. -/
instance stageTwoSlopeAffineNormalizationScheme_isIntegral
    (x : Fin 2 → ℂ) (core : StageTwoDefectSlopeCore x) :
    AlgebraicGeometry.IsIntegral (stageTwoSlopeAffineNormalizationScheme x core) := by
  infer_instance

/-- The concrete stage-two value field is the fraction field of its slope-line integral closure. -/
noncomputable instance stageTwoSlopeAffineNormalization_isFractionRing
    (x : Fin 2 → ℂ) (core : StageTwoDefectSlopeCore x) :
    IsFractionRing (stageTwoSlopeAffineNormalizationRing x core)
      (stageTwoValueField (x 0) (x 1)) := by
  letI : Algebra (stageTwoSlopeRationalField x core)
      (stageTwoValueField (x 0) (x 1)) :=
    (stageTwoSlopeRationalField x core).val.toAlgebra
  letI : IsScalarTower AlgNum (stageTwoSlopeRationalField x core)
      (stageTwoValueField (x 0) (x 1)) :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  letI : IsScalarTower (stageTwoSlopeCoordinateRing x core)
      (stageTwoSlopeRationalField x core) (stageTwoValueField (x 0) (x 1)) :=
    IntermediateField.algebraAdjoinAdjoin.instIsScalarTowerSubtypeMemSubalgebraAdjoinAdjoin_1
      AlgNum ({core.rho} : Set (stageTwoValueField (x 0) (x 1)))
      (stageTwoValueField (x 0) (x 1))
  letI : FiniteDimensional (stageTwoSlopeRationalField x core)
      (stageTwoValueField (x 0) (x 1)) := core.finite_over_slope
  exact @IsIntegralClosure.isFractionRing_of_finite_extension
    (stageTwoSlopeCoordinateRing x core) (stageTwoSlopeRationalField x core)
    inferInstance (stageTwoValueField (x 0) (x 1)) inferInstance inferInstance
    inferInstance inferInstance inferInstance
    (stageTwoSlopeAffineNormalizationRing x core) inferInstance inferInstance
    inferInstance inferInstance inferInstance inferInstance inferInstance inferInstance
    (IntermediateField.algebraAdjoinAdjoin.instIsScalarTowerSubtypeMemSubalgebraAdjoinAdjoin_1
      AlgNum ({core.rho} : Set (stageTwoValueField (x 0) (x 1)))
      (stageTwoValueField (x 0) (x 1)))
    core.finite_over_slope

/-- Canonical algebra structure from the integral-closure chart ring to the function field of its
spectrum. -/
@[implicit_reducible] noncomputable def stageTwoSlopeAffineNormalizationFunctionFieldAlgebra
    (x : Fin 2 → ℂ) (core : StageTwoDefectSlopeCore x) :
    Algebra (stageTwoSlopeAffineNormalizationRing x core)
      (stageTwoSlopeAffineNormalizationScheme x core).functionField := by
  exact RingHom.toAlgebra
    (AlgebraicGeometry.StructureSheaf.toStalk
      (stageTwoSlopeAffineNormalizationRing x core)
      (genericPoint (stageTwoSlopeAffineNormalizationScheme x core))).hom

/-- The scheme function field of the canonical affine integral-closure chart is exactly the
concrete stage-two value field. -/
noncomputable def stageTwoSlopeAffineNormalizationFunctionFieldEquiv
    (x : Fin 2 → ℂ) (core : StageTwoDefectSlopeCore x) :
    stageTwoValueField (x 0) (x 1) ≃+*
      (stageTwoSlopeAffineNormalizationScheme x core).functionField := by
  letI := stageTwoSlopeAffineNormalizationFunctionFieldAlgebra x core
  letI : IsFractionRing (stageTwoSlopeAffineNormalizationRing x core)
      (stageTwoSlopeAffineNormalizationScheme x core).functionField :=
    AlgebraicGeometry.functionField_isFractionRing_of_affine
      (.of (stageTwoSlopeAffineNormalizationRing x core))
  exact @IsFractionRing.ringEquivOfRingEquiv
    (stageTwoSlopeAffineNormalizationRing x core)
    (stageTwoValueField (x 0) (x 1))
    (stageTwoSlopeAffineNormalizationRing x core)
    (stageTwoSlopeAffineNormalizationScheme x core).functionField
    inferInstance inferInstance inferInstance inferInstance inferInstance inferInstance
    inferInstance inferInstance
    (RingEquiv.refl (stageTwoSlopeAffineNormalizationRing x core))

/-- Additive coordinate rational functions on the canonical affine normalization chart. -/
noncomputable def stageTwoSlopeAffineExponentCoordinate
    (x : Fin 2 → ℂ) (core : StageTwoDefectSlopeCore x) (i : Fin 2) :
    (stageTwoSlopeAffineNormalizationScheme x core).functionField :=
  stageTwoSlopeAffineNormalizationFunctionFieldEquiv x core (stageTwoExponentIn x i)

/-- Multiplicative coordinate rational functions on the canonical affine normalization chart. -/
noncomputable def stageTwoSlopeAffineExponentialCoordinate
    (x : Fin 2 → ℂ) (core : StageTwoDefectSlopeCore x) (i : Fin 2) :
    (stageTwoSlopeAffineNormalizationScheme x core).functionField :=
  stageTwoSlopeAffineNormalizationFunctionFieldEquiv x core (stageTwoExponentialIn x i)

/-- Two additive and two multiplicative complex coordinate pullbacks along a smooth path.  The base
point is algebraic, the pullbacks avoid coordinate poles and multiplicative zero divisors, and the
terminal point is the original exponential tuple.

Coordinate-pole avoidance is encoded by the fact that `X` and `Y` are honest complex-valued
functions on the entire closed parameter interval. -/
structure StageTwoDivisorAvoidingCoordinatePath (x : Fin 2 → ℂ) (a b : ℝ) where
  X : Fin 2 → ℝ → ℂ
  Y : Fin 2 → ℝ → ℂ
  X' : Fin 2 → ℝ → ℂ
  Y' : Fin 2 → ℝ → ℂ
  parameter_order : a ≤ b
  hasDeriv_X : ∀ i t, t ∈ Icc a b → HasDerivAt (X i) (X' i t) t
  hasDeriv_Y : ∀ i t, t ∈ Icc a b → HasDerivAt (Y i) (Y' i t) t
  continuous_X' : ∀ i, ContinuousOn (X' i) (Icc a b)
  continuous_Y' : ∀ i, ContinuousOn (Y' i) (Icc a b)
  avoids_multiplicative_divisor : ∀ i t, t ∈ Icc a b → Y i t ≠ 0
  algebraic_base_X : ∀ i, X i a ∈ AlgNum
  algebraic_base_Y : ∀ i, Y i a ∈ AlgNum
  terminal_X : ∀ i, X i b = x i
  terminal_Y : ∀ i, Y i b = Complex.exp (x i)

/-- A genuine path on a carrier `V`, together with two additive and two multiplicative coordinate
functions whose pullbacks are continuously differentiable and avoid their multiplicative zero
divisors.  The named endpoints record the algebraic base point and target point separately from the
parameterization. -/
structure StageTwoDivisorAvoidingCurvePath (V : Type*) (x : Fin 2 → ℂ) (a b : ℝ) where
  q : V
  p : V
  path : ℝ → V
  X : Fin 2 → V → ℂ
  Y : Fin 2 → V → ℂ
  X' : Fin 2 → ℝ → ℂ
  Y' : Fin 2 → ℝ → ℂ
  parameter_order : a ≤ b
  path_source : path a = q
  path_target : path b = p
  hasDeriv_X : ∀ i t, t ∈ Icc a b →
    HasDerivAt (fun s => X i (path s)) (X' i t) t
  hasDeriv_Y : ∀ i t, t ∈ Icc a b →
    HasDerivAt (fun s => Y i (path s)) (Y' i t) t
  continuous_X' : ∀ i, ContinuousOn (X' i) (Icc a b)
  continuous_Y' : ∀ i, ContinuousOn (Y' i) (Icc a b)
  avoids_multiplicative_divisor : ∀ i t, t ∈ Icc a b → Y i (path t) ≠ 0
  algebraic_base_X : ∀ i, X i q ∈ AlgNum
  algebraic_base_Y : ∀ i, Y i q ∈ AlgNum
  terminal_X : ∀ i, X i p = x i
  terminal_Y : ∀ i, Y i p = Complex.exp (x i)

/-- Forget a curve path down to its four pulled-back complex coordinate functions. -/
def StageTwoDivisorAvoidingCurvePath.toCoordinatePath
    {V : Type*} {x : Fin 2 → ℂ} {a b : ℝ}
    (curvePath : StageTwoDivisorAvoidingCurvePath V x a b) :
    StageTwoDivisorAvoidingCoordinatePath x a b where
  X i t := curvePath.X i (curvePath.path t)
  Y i t := curvePath.Y i (curvePath.path t)
  X' := curvePath.X'
  Y' := curvePath.Y'
  parameter_order := curvePath.parameter_order
  hasDeriv_X := curvePath.hasDeriv_X
  hasDeriv_Y := curvePath.hasDeriv_Y
  continuous_X' := curvePath.continuous_X'
  continuous_Y' := curvePath.continuous_Y'
  avoids_multiplicative_divisor := curvePath.avoids_multiplicative_divisor
  algebraic_base_X i := by rw [curvePath.path_source]; exact curvePath.algebraic_base_X i
  algebraic_base_Y i := by rw [curvePath.path_source]; exact curvePath.algebraic_base_Y i
  terminal_X i := by rw [curvePath.path_target]; exact curvePath.terminal_X i
  terminal_Y i := by rw [curvePath.path_target]; exact curvePath.terminal_Y i

/-- Simultaneous logarithm branches and exact regulator values for both coordinates of a
divisor-avoiding stage-two path. -/
structure StageTwoRegulatorWitness {x : Fin 2 → ℂ} {a b : ℝ}
    (path : StageTwoDivisorAvoidingCoordinatePath x a b) where
  L : Fin 2 → ℝ → ℂ
  branch : Fin 2 → ℤ
  continuousOn_L : ∀ i, ContinuousOn (L i) (Icc a b)
  hasDeriv_L : ∀ i t, t ∈ Icc a b →
    HasDerivAt (L i) (path.Y' i t / path.Y i t) t
  exp_L : ∀ i t, t ∈ Icc a b → Complex.exp (L i t) = path.Y i t
  regulator : ∀ i,
    (∫ t in a..b, path.Y' i t / path.Y i t - path.X' i t) =
      path.X i a - L i a +
        (branch i : ℂ) * (2 * (Real.pi : ℂ) * Complex.I)

/-- Every smooth divisor-avoiding coordinate path has simultaneous logarithm lifts and the two
exact length-one exponential-period regulator values from clause 5. -/
theorem exists_stageTwoRegulatorWitness {x : Fin 2 → ℂ} {a b : ℝ}
    (path : StageTwoDivisorAvoidingCoordinatePath x a b) :
    Nonempty (StageTwoRegulatorWitness path) := by
  have hlogCont (i : Fin 2) :
      ContinuousOn (fun t => path.Y' i t / path.Y i t) (Icc a b) := by
    intro t ht
    exact (path.continuous_Y' i t ht).div
      (path.hasDeriv_Y i t ht).continuousAt.continuousWithinAt
      (path.avoids_multiplicative_divisor i t ht)
  have hint (i : Fin 2) :
      IntervalIntegrable
        (fun t => path.Y' i t / path.Y i t - path.X' i t)
        MeasureTheory.volume a b := by
    have hlog : IntervalIntegrable (fun t => path.Y' i t / path.Y i t)
        MeasureTheory.volume a b := by
      apply ContinuousOn.intervalIntegrable
      simpa only [uIcc_of_le path.parameter_order] using
        hlogCont i
    have hX : IntervalIntegrable (path.X' i) MeasureTheory.volume a b := by
      apply ContinuousOn.intervalIntegrable
      simpa only [uIcc_of_le path.parameter_order] using path.continuous_X' i
    exact hlog.sub hX
  have hend (i : Fin 2) : path.Y i b = Complex.exp (path.X i b) := by
    rw [path.terminal_X i, path.terminal_Y i]
  choose L branch hLcont hLderiv hLexp hreg using fun i =>
    exists_logarithmLift_intervalIntegral_eq_base_add_branch
      path.parameter_order (path.hasDeriv_X i) (path.hasDeriv_Y i)
        (hlogCont i)
        (path.avoids_multiplicative_divisor i) (hend i) (hint i)
  exact ⟨{
    L := L
    branch := branch
    continuousOn_L := hLcont
    hasDeriv_L := hLderiv
    exp_L := hLexp
    regulator := hreg
  }⟩

/-- Exact simultaneous logarithm lifts and regulator values for the coordinate pullbacks of every
supplied smooth divisor-avoiding curve path. -/
theorem exists_stageTwoCurvePathRegulatorWitness
    {V : Type*} {x : Fin 2 → ℂ} {a b : ℝ}
    (curvePath : StageTwoDivisorAvoidingCurvePath V x a b) :
    Nonempty (StageTwoRegulatorWitness curvePath.toCoordinatePath) :=
  exists_stageTwoRegulatorWitness curvePath.toCoordinatePath

/-- Clauses 1--4 together with the exact affine integral-closure chart and its independent analytic
coordinate-pullback consequence.  This package intentionally does not assert the unavailable
projective compactification/analytification comparison. -/
structure StageTwoDefectSlopeAffineNormalizationPackage (x : Fin 2 → ℂ) where
  core : StageTwoDefectSlopeCore x
  essential : IsEssentialSchanuelCounterexample x
  slope_mem_exponentialAlgebraicClosure :
    (core.rho : ℂ) ∈ complexExponentialAlgebraicClosure
  exponentialAlgebraicClosure_countable :
    Set.Countable (complexExponentialAlgebraicClosure : Set ℂ)
  functionFieldEquiv :
    stageTwoValueField (x 0) (x 1) ≃+*
      (stageTwoSlopeAffineNormalizationScheme x core).functionField
  regulator : ∀ {V : Type*} {a b : ℝ}
    (path : StageTwoDivisorAvoidingCurvePath V x a b),
    Nonempty (StageTwoRegulatorWitness path.toCoordinatePath)

/-- Unconditional construction of clauses 1--4, the affine integral-closure scheme with its exact
function field, and the analytic regulator theorem for every supplied coordinate pullback path. -/
theorem exists_stageTwoDefectSlopeAffineNormalizationPackage
    (x : Fin 2 → ℂ) (hx : LinearIndependent ℚ x)
    (hlt : Algebra.trdeg AlgNum (stageTwoValueField (x 0) (x 1)) < 2) :
    Nonempty (StageTwoDefectSlopeAffineNormalizationPackage x) := by
  obtain ⟨core, hessential, hecl⟩ :=
    exists_stageTwoDefectSlopeCore_essential_ecl x hx hlt
  exact ⟨{
    core := core
    essential := hessential
    slope_mem_exponentialAlgebraicClosure := hecl
    exponentialAlgebraicClosure_countable :=
      countable_complexExponentialAlgebraicClosure
    functionFieldEquiv := stageTwoSlopeAffineNormalizationFunctionFieldEquiv x core
    regulator := fun path => exists_stageTwoCurvePathRegulatorWitness path
  }⟩

/-- Literal stage-two extraction-failure form of the affine normalization package. -/
theorem exists_stageTwoDefectSlopeAffineNormalizationPackage_of_extraction_failure
    (x : Fin 2 → ℂ) (hx : LinearIndependent ℚ x)
    (hfail : ¬ SchanuelExtractionFor x) :
    Nonempty (StageTwoDefectSlopeAffineNormalizationPackage x) :=
  exists_stageTwoDefectSlopeAffineNormalizationPackage x hx
    ((not_schanuelExtractionFor_two_iff_stageTwoValueField_trdeg_lt x).mp hfail)

end

end GaloisForLFunctions.RHTower
