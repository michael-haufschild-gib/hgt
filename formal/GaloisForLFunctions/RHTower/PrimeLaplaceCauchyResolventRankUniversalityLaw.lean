import GaloisForLFunctions.HTGeometry.PrimeLogCauchyRenormalizationRank
import GaloisForLFunctions.RHTower.PrimeLaplaceEvenFactorialSourceTransport
import Mathlib.Analysis.SpecialFunctions.ImproperIntegrals

/-!
# Prime-Laplace Cauchy-resolvent rank universality

The exact source-translation eigenvalue `p⁻ᵗ` has a right-half-plane Laplace resolvent equal to the
negative transported prime-log Cauchy section at the reflected parameter.  Canonical resolvents
therefore have unbounded finite rank modulo ordinary prime `ℓ²`, and no finite-dimensional source
can repair the complete canonical family.
-/

open Complex MeasureTheory Set

namespace RHTower

open GaloisForLFunctions.HTGeometry

noncomputable section

/-- The prime source-translation orbit, with the Cauchy-seam critical weight. -/
def primeLaplaceWeightedSourceTranslationOrbit (b t : ℝ) (p : Nat.Primes) : ℝ :=
  Real.sqrt ((p : ℝ) ^ (2 * b - 1)) *
    ((p : ℝ) ^ (-t) * primeLaplaceRawJet p 0)

/-- The weighted orbit is generated by the complete raw prime jet under Taylor translation. -/
theorem hasSum_primeLaplaceWeightedSourceTranslationOrbit
    (b t : ℝ) (p : Nat.Primes) :
    HasSum
      (fun h : ℕ =>
        Real.sqrt ((p : ℝ) ^ (2 * b - 1)) *
          (t ^ h * primeLaplaceRawJet p (0 + h) / (h.factorial : ℝ)))
      (primeLaplaceWeightedSourceTranslationOrbit b t p) := by
  simpa [primeLaplaceWeightedSourceTranslationOrbit, primeLaplaceRawJet] using
    (hasSum_primeLaplaceRawJet_translate p 0 t).mul_left
      (Real.sqrt ((p : ℝ) ^ (2 * b - 1)))

/-- Coordinatewise Laplace resolvent of the weighted source-translation orbit. -/
def primeLaplaceCauchyResolvent (b : ℝ) (z : ℂ) : PrimeLogSequence :=
  fun p => ∫ t : ℝ in Ioi 0,
    Complex.exp ((-z) * (t : ℂ)) *
      (primeLaplaceWeightedSourceTranslationOrbit b t p : ℂ)

/-- The prime-semigroup Laplace resolvent is the reflected transported Cauchy section. -/
theorem primeLaplaceCauchyResolvent_eq_reflectedCauchySection
    (b : ℝ) (z : ℂ) (hz : 0 < z.re) :
    primeLaplaceCauchyResolvent b z =
      -primeLogTransportedCauchySection b (-z) := by
  funext p
  have hp : (0 : ℝ) < (p : ℝ) := by
    exact_mod_cast p.prop.pos
  have hlog : 0 < Real.log (p : ℝ) :=
    Real.log_pos (by exact_mod_cast p.prop.one_lt)
  let a : ℂ := -(z + (Real.log (p : ℝ) : ℂ))
  have ha : a.re < 0 := by
    simp only [a, Complex.neg_re, Complex.add_re, Complex.ofReal_re]
    linarith
  have hpoint : ∀ t : ℝ,
      Complex.exp ((-z) * (t : ℂ)) *
          (primeLaplaceWeightedSourceTranslationOrbit b t p : ℂ) =
        (Real.sqrt ((p : ℝ) ^ (2 * b - 1)) : ℂ) *
          Complex.exp (a * (t : ℂ)) := by
    intro t
    have hrpow :
        (p : ℝ) ^ (-t) = Real.exp (Real.log (p : ℝ) * (-t)) :=
      Real.rpow_def_of_pos hp (-t)
    rw [primeLaplaceWeightedSourceTranslationOrbit, primeLaplaceRawJet, hrpow]
    simp only [pow_zero, mul_one, Complex.ofReal_mul]
    rw [Complex.ofReal_exp]
    rw [show
      Complex.exp (-z * (t : ℂ)) *
          ((Real.sqrt ((p : ℝ) ^ (2 * b - 1)) : ℂ) *
            Complex.exp ((Real.log (p : ℝ) * (-t) : ℝ) : ℂ)) =
        (Real.sqrt ((p : ℝ) ^ (2 * b - 1)) : ℂ) *
          (Complex.exp (-z * (t : ℂ)) *
            Complex.exp ((Real.log (p : ℝ) * (-t) : ℝ) : ℂ)) by ring]
    rw [← Complex.exp_add]
    congr 2
    simp only [a]
    push_cast
    ring
  rw [primeLaplaceCauchyResolvent,
    MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall hpoint)]
  rw [MeasureTheory.integral_const_mul, integral_exp_mul_complex_Ioi ha 0]
  simp only [Complex.ofReal_zero, mul_zero, Complex.exp_zero, neg_div, one_div,
    Pi.neg_apply, primeLogTransportedCauchySection, primeLogSupport, a]
  have hne : z + (Real.log (p : ℝ) : ℂ) ≠ 0 := by
    intro h
    have hre := congrArg Complex.re h
    simp only [Complex.add_re, Complex.ofReal_re, Complex.zero_re] at hre
    linarith
  have hneg : -z - (Real.log (p : ℝ) : ℂ) ≠ 0 := by
    intro h
    apply hne
    linear_combination -h
  field_simp [hneg]
  ring

/-- Quotient class of the prime-semigroup Laplace resolvent. -/
def primeLaplaceCauchyResolventClass (b : ℝ) (z : ℂ) : PrimeLogCauchyQuotient :=
  Submodule.Quotient.mk (primeLaplaceCauchyResolvent b z)

theorem primeLaplaceCauchyResolventClass_eq_reflectedCauchyClass
    (b : ℝ) (z : ℂ) (hz : 0 < z.re) :
    primeLaplaceCauchyResolventClass b z =
      -primeLogTransportedCauchyClass b (-z) := by
  rw [primeLaplaceCauchyResolventClass,
    primeLaplaceCauchyResolvent_eq_reflectedCauchySection b z hz,
    primeLogTransportedCauchyClass]
  exact map_neg primeLogSquareSummable.mkQ _

/-- Canonical right-half-plane Laplace parameters. -/
def primeLaplaceCanonicalParameter (j : ℕ) : ℂ :=
  ((j + 1 : ℕ) : ℂ) - Complex.I

theorem primeLaplaceCanonicalParameter_re_pos (j : ℕ) :
    0 < (primeLaplaceCanonicalParameter j).re := by
  simp only [primeLaplaceCanonicalParameter, Complex.sub_re, Complex.I_re, sub_zero,
    Nat.cast_add, Nat.cast_one]
  exact_mod_cast Nat.succ_pos j

theorem primeLaplaceCanonicalReflectedNode_injective :
    Function.Injective (fun j : ℕ => -primeLaplaceCanonicalParameter j) := by
  intro j k hjk
  have hre := congrArg Complex.re hjk
  simp only [primeLaplaceCanonicalParameter, Complex.neg_re, Complex.sub_re,
    Complex.natCast_re, Complex.I_re, sub_zero, neg_inj] at hre
  norm_cast at hre
  omega

theorem primeLaplaceCanonicalReflectedNode_im_pos (j : ℕ) :
    0 < (-primeLaplaceCanonicalParameter j).im := by
  simp [primeLaplaceCanonicalParameter]

/-- Every finite canonical family of prime-semigroup Laplace resolvents is independent modulo
ordinary prime `ℓ²`. -/
theorem primeLaplaceCauchyResolventClass_linearIndependent
    (n : ℕ) {b : ℝ} (hb : 0 < b) :
    LinearIndependent ℂ
      (fun j : Fin n =>
        primeLaplaceCauchyResolventClass b (primeLaplaceCanonicalParameter j)) := by
  have hcauchy :
      LinearIndependent ℂ
        (fun j : Fin n =>
          primeLogTransportedCauchyClass b (-primeLaplaceCanonicalParameter j)) :=
    primeLogTransportedCauchyClass_linearIndependent
      (fun j : Fin n => -primeLaplaceCanonicalParameter j)
      (primeLaplaceCanonicalReflectedNode_injective.comp Fin.val_injective)
      (fun j => primeLaplaceCanonicalReflectedNode_im_pos j) hb
  have hneg := hcauchy.neg
  simpa only [Pi.neg_apply,
    primeLaplaceCauchyResolventClass_eq_reflectedCauchyClass b
      (primeLaplaceCanonicalParameter _)
      (primeLaplaceCanonicalParameter_re_pos _)] using! hneg

/-- No finite-dimensional source can repair every canonical prime-semigroup Laplace resolvent. -/
theorem primeLaplaceCauchyResolvent_no_finiteDimensional_repair
    {F : Type*} [AddCommGroup F] [Module ℂ F]
    (repair : F →ₗ[ℂ] PrimeLogCauchyQuotient)
    {b : ℝ} (hb : 0 < b)
    (hrepair : ∀ j : ℕ,
      primeLaplaceCauchyResolventClass b (primeLaplaceCanonicalParameter j) ∈
        LinearMap.range repair) :
    ¬ Module.Finite ℂ F := by
  intro hfinite
  letI : Module.Finite ℂ F := hfinite
  choose f hf using fun j : Fin (Module.finrank ℂ F + 1) => hrepair j
  have hindependent : LinearIndependent ℂ f := by
    apply LinearIndependent.of_comp repair
    have himage : repair ∘ f =
        (fun j : Fin (Module.finrank ℂ F + 1) =>
          primeLaplaceCauchyResolventClass b (primeLaplaceCanonicalParameter j)) := by
      funext j
      exact hf j
    rw [himage]
    exact primeLaplaceCauchyResolventClass_linearIndependent
      (Module.finrank ℂ F + 1) hb
  have hle := hindependent.fintype_card_le_finrank
  simp only [Fintype.card_fin] at hle
  omega

/-- **Prime-Laplace Cauchy-resolvent complete rank universality law.**  The weighted translation
orbit is source-generated, its right-half-plane Laplace transform is the reflected Cauchy section,
and its canonical resolvents have every finite rank modulo ordinary prime `ℓ²`. -/
theorem primeLaplaceCauchyResolvent_completeRankUniversality
    {b : ℝ} (hb : 0 < b) :
    (∀ t : ℝ, ∀ p : Nat.Primes,
      HasSum
        (fun h : ℕ =>
          Real.sqrt ((p : ℝ) ^ (2 * b - 1)) *
            (t ^ h * primeLaplaceRawJet p (0 + h) / (h.factorial : ℝ)))
        (primeLaplaceWeightedSourceTranslationOrbit b t p)) ∧
      (∀ z : ℂ, 0 < z.re →
        primeLaplaceCauchyResolvent b z =
          -primeLogTransportedCauchySection b (-z)) ∧
      ∀ n : ℕ,
        LinearIndependent ℂ
          (fun j : Fin n =>
            primeLaplaceCauchyResolventClass b (primeLaplaceCanonicalParameter j)) := by
  exact ⟨hasSum_primeLaplaceWeightedSourceTranslationOrbit b,
    primeLaplaceCauchyResolvent_eq_reflectedCauchySection b,
    fun n => primeLaplaceCauchyResolventClass_linearIndependent n hb⟩

end

end RHTower
