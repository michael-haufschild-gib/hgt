import GaloisForLFunctions.RHTower.PrimeGammaCofinalBocksteinDiagonalCompact
import GaloisForLFunctions.HTGeometry.CZeroFiniteSupportDensity
import GaloisForLFunctions.HTGeometry.SeminormTopologyCarrier
import Mathlib.Analysis.CStarAlgebra.Spectrum

/-!
# `c₀` closure blindness of the cofinal Gamma defect

The strip-wide Gamma multiplier is constructed as a literal element of `C₀(ℕ,ℂ)`.  Its
finite-support truncations converge uniformly.  Consequently every norm-closed set containing
`c₀₀` contains the defect.  More generally, the same conclusion holds for every family of
seminorms dominated by the uniform norm and every set closed under those seminorm limits.
-/

open Filter Topology
open scoped ZeroAtInfty
open GaloisForLFunctions.HTGeometry

namespace RHTower

noncomputable section

/-- The prime-enumerated cofinal Gamma defect as a literal element of `c₀`. -/
def primeGammaCofinalBocksteinCZero (t : ℝ) (ht : |t| < 1) : C₀(ℕ, ℂ) where
  toFun := primeGammaCofinalBocksteinDiagonalMultiplier t
  continuous_toFun := continuous_of_discreteTopology
  zero_at_infty' := by
    rw [Filter.cocompact_eq_cofinite, Nat.cofinite_eq_atTop]
    apply tendsto_zero_iff_norm_tendsto_zero.mpr
    exact tendsto_norm_primeGammaCofinalBocksteinDiagonalMultiplier_zero ht

@[simp] theorem primeGammaCofinalBocksteinCZero_apply
    (t : ℝ) (ht : |t| < 1) (n : ℕ) :
    primeGammaCofinalBocksteinCZero t ht n =
      primeGammaCofinalBocksteinDiagonalMultiplier t n := rfl

/-- Norm-closed `c₀₀` blindness: every uniformly closed set containing all finite-support
sequences contains the cofinal Gamma defect. -/
theorem primeGammaCofinalBocksteinCZero_mem_of_isClosed_of_contains_finiteSupport
    {t : ℝ} (ht : |t| < 1) (J : Set C₀(ℕ, ℂ)) (hJ : IsClosed J)
    (hfinite : ∀ f : C₀(ℕ, ℂ), Set.Finite (Function.support f) → f ∈ J) :
    primeGammaCofinalBocksteinCZero t ht ∈ J := by
  apply hJ.mem_of_tendsto
    (GaloisForLFunctions.HTGeometry.tendsto_cZeroNatTruncation
      (primeGammaCofinalBocksteinCZero t ht))
  exact Filter.Eventually.of_forall fun n ↦
    hfinite _ (GaloisForLFunctions.HTGeometry.cZeroNatTruncation_support_finite _ n)

/-- Closure under sequential convergence for a specified seminorm family.  Every set closed in
the topology generated by the family has this property. -/
def ClosedUnderSeminormSequentialLimits {κ A : Type*}
    [AddCommGroup A] [Module ℂ A]
    (p : κ → Seminorm ℂ A) (J : Set A) : Prop :=
  ∀ (u : ℕ → A) (x : A),
    (∀ i, Tendsto (fun n ↦ p i (u n - x)) atTop (nhds 0)) →
    (∀ n, u n ∈ J) → x ∈ J

/-- Seminorm-topology form of `c₀₀` blindness.  Uniform convergence of the finite cuts forces
convergence for every seminorm dominated by the C*-norm. -/
theorem primeGammaCofinalBocksteinCZero_mem_of_seminormClosed_of_contains_finiteSupport
    {κ : Type*} {t : ℝ} (ht : |t| < 1)
    (p : κ → Seminorm ℂ C₀(ℕ, ℂ))
    (hdom : ∀ i f, p i f ≤ ‖f‖)
    (J : Set C₀(ℕ, ℂ)) (hJ : ClosedUnderSeminormSequentialLimits p J)
    (hfinite : ∀ f : C₀(ℕ, ℂ), Set.Finite (Function.support f) → f ∈ J) :
    primeGammaCofinalBocksteinCZero t ht ∈ J := by
  apply hJ
    (GaloisForLFunctions.HTGeometry.cZeroNatTruncation
      (primeGammaCofinalBocksteinCZero t ht))
    (primeGammaCofinalBocksteinCZero t ht)
  · intro i
    apply squeeze_zero (fun n ↦ apply_nonneg (p i) _)
      (fun n ↦ hdom i _)
    exact tendsto_iff_norm_sub_tendsto_zero.mp
      (GaloisForLFunctions.HTGeometry.tendsto_cZeroNatTruncation
        (primeGammaCofinalBocksteinCZero t ht))
  · intro n
    exact hfinite _
      (GaloisForLFunctions.HTGeometry.cZeroNatTruncation_support_finite _ n)

/-- Seminorm family pulled back from a family of non-unital C*-algebra receivers.  This is the
projective presentation of a locally C* topology. -/
def cStarHomSeminormFamily {κ : Type*} (B : κ → Type*)
    [∀ i, NonUnitalCStarAlgebra (B i)]
    (q : ∀ i, C₀(ℕ, ℂ) →⋆ₙₐ[ℂ] B i) : κ → Seminorm ℂ C₀(ℕ, ℂ) :=
  fun i ↦ Seminorm.of (fun f ↦ ‖q i f‖)
    (fun f g ↦ by simpa only [map_add] using norm_add_le (q i f) (q i g))
    (fun a f ↦ by rw [map_smul, norm_smul])

/-- Every C*-receiver seminorm is contractive for the fixed `c₀` C*-norm. -/
theorem cStarHomSeminormFamily_le_norm {κ : Type*} (B : κ → Type*)
    [∀ i, NonUnitalCStarAlgebra (B i)]
    (q : ∀ i, C₀(ℕ, ℂ) →⋆ₙₐ[ℂ] B i) (i : κ) (f : C₀(ℕ, ℂ)) :
    cStarHomSeminormFamily B q i f ≤ ‖f‖ := by
  exact NonUnitalStarAlgHom.norm_apply_le (q i) f

/-- Clause (4), in the projective C*-receiver presentation: every set closed under the defining
C*-seminorm limits and containing `c₀₀` contains the literal Gamma defect. -/
theorem primeGammaCofinalBocksteinCZero_mem_of_cStarHomClosed_of_contains_finiteSupport
    {κ : Type*} {t : ℝ} (ht : |t| < 1)
    (B : κ → Type*) [∀ i, NonUnitalCStarAlgebra (B i)]
    (q : ∀ i, C₀(ℕ, ℂ) →⋆ₙₐ[ℂ] B i)
    (J : Set C₀(ℕ, ℂ))
    (hJ : ClosedUnderSeminormSequentialLimits (cStarHomSeminormFamily B q) J)
    (hfinite : ∀ f : C₀(ℕ, ℂ), Set.Finite (Function.support f) → f ∈ J) :
    primeGammaCofinalBocksteinCZero t ht ∈ J := by
  exact primeGammaCofinalBocksteinCZero_mem_of_seminormClosed_of_contains_finiteSupport
    ht (cStarHomSeminormFamily B q) (cStarHomSeminormFamily_le_norm B q) J hJ hfinite

/-- The Gamma defect in the actual projective topology generated by a family of C*-receivers. -/
def primeGammaCofinalBocksteinProjectiveCZero
    {κ : Type*} {t : ℝ} (ht : |t| < 1)
    (B : κ → Type*) [∀ i, NonUnitalCStarAlgebra (B i)]
    (q : ∀ i, C₀(ℕ, ℂ) →⋆ₙₐ[ℂ] B i) :
    SeminormTopologyCarrier (cStarHomSeminormFamily B q) :=
  ⟨primeGammaCofinalBocksteinCZero t ht⟩

/-- Finite-support cuts of the Gamma defect in the projective C*-topology. -/
def primeGammaCofinalBocksteinProjectiveCZeroTruncation
    {κ : Type*} {t : ℝ} (ht : |t| < 1)
    (B : κ → Type*) [∀ i, NonUnitalCStarAlgebra (B i)]
    (q : ∀ i, C₀(ℕ, ℂ) →⋆ₙₐ[ℂ] B i) (n : ℕ) :
    SeminormTopologyCarrier (cStarHomSeminormFamily B q) :=
  ⟨cZeroNatTruncation (primeGammaCofinalBocksteinCZero t ht) n⟩

/-- Uniform convergence of the finite cuts implies convergence in every projective C*-receiver
topology on the fixed diagonal algebra. -/
theorem tendsto_primeGammaCofinalBocksteinProjectiveCZeroTruncation
    {κ : Type*} {t : ℝ} (ht : |t| < 1)
    (B : κ → Type*) [∀ i, NonUnitalCStarAlgebra (B i)]
    (q : ∀ i, C₀(ℕ, ℂ) →⋆ₙₐ[ℂ] B i) :
    Tendsto (primeGammaCofinalBocksteinProjectiveCZeroTruncation ht B q) atTop
      (nhds (primeGammaCofinalBocksteinProjectiveCZero ht B q)) := by
  apply (SeminormTopologyCarrier.withSeminorms
    (cStarHomSeminormFamily B q)).tendsto_nhds_atTop
      (primeGammaCofinalBocksteinProjectiveCZeroTruncation ht B q)
      (primeGammaCofinalBocksteinProjectiveCZero ht B q) |>.mpr
  intro i ε hε
  have hnorm := tendsto_iff_norm_sub_tendsto_zero.mp
    (tendsto_cZeroNatTruncation (primeGammaCofinalBocksteinCZero t ht))
  have hp : Tendsto (fun n ↦
      cStarHomSeminormFamily B q i
        (cZeroNatTruncation (primeGammaCofinalBocksteinCZero t ht) n -
          primeGammaCofinalBocksteinCZero t ht)) atTop (nhds 0) := by
    apply squeeze_zero (fun n ↦ apply_nonneg _ _)
      (fun n ↦ cStarHomSeminormFamily_le_norm B q i _)
    exact hnorm
  obtain ⟨N, hN⟩ := (Metric.tendsto_atTop.mp hp) ε hε
  refine ⟨N, fun n hn ↦ ?_⟩
  have h := hN n hn
  rw [Real.dist_eq, sub_zero, abs_of_nonneg (apply_nonneg _ _)] at h
  exact h

/-- Clause (4), topological form: a closed subset of any projective locally C* topology on `c₀`
that contains every finite-support sequence contains the cofinal Gamma defect.  The ideal laws are
not needed for this stronger closure conclusion. -/
theorem primeGammaCofinalBocksteinProjectiveCZero_mem_of_isClosed_of_contains_finiteSupport
    {κ : Type*} {t : ℝ} (ht : |t| < 1)
    (B : κ → Type*) [∀ i, NonUnitalCStarAlgebra (B i)]
    (q : ∀ i, C₀(ℕ, ℂ) →⋆ₙₐ[ℂ] B i)
    (J : Set (SeminormTopologyCarrier (cStarHomSeminormFamily B q))) (hJ : IsClosed J)
    (hfinite : ∀ f : SeminormTopologyCarrier (cStarHomSeminormFamily B q),
      Set.Finite (Function.support
        (SeminormTopologyCarrier.toBase (cStarHomSeminormFamily B q) f)) → f ∈ J) :
    primeGammaCofinalBocksteinProjectiveCZero ht B q ∈ J := by
  apply hJ.mem_of_tendsto
    (tendsto_primeGammaCofinalBocksteinProjectiveCZeroTruncation ht B q)
  exact Eventually.of_forall fun n ↦ hfinite _ (cZeroNatTruncation_support_finite _ n)

end
end RHTower
