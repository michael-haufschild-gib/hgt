import GaloisForLFunctions.RHTower.CCMFirstClockPrimitivePromotedHellingerGammaPureHodgeCoface
import GaloisForLFunctions.RHTower.DeningerCalderonWittCompletedXiGreenIncidenceComparison

/-!
# Completed Xi Hellinger--Gamma pure-Hodge coend

The local Hellinger--Gamma coface becomes coefficient-faithful on the
completed Xi incidence carrier by taking two completed channels.  Every
finite divisor coordinate evaluates to an actual pure-Hodge cell incidence.
The balanced grade maps are injective, Hodge exchange conjugates modular
displacement, adjacent differences telescope, and the factorial gauge sends
their endpoint to zero in the completed norm.

A continuous depth-zero recovery therefore sends the partial coface sums to
the exact completed Xi Green primitive.  This is a raw completed-norm
landing theorem.  It does not assert convergence in the closed secondary
Gamma/Hodge boundary graph norm or injectivity on the relative admission
quotient; those are the remaining RH-bearing obligations.
-/

open Complex Set Finset Filter Topology
open scoped BigOperators

namespace RHTower

noncomputable section

namespace CompletedXiHellingerGammaPureHodgeCoface

open PrimitivePromotedCellHodgeRigidity
open PrimitivePromotedPureHodgeCountertransport
open PrimitivePromotedPureHodgeModularTransgression
open PrimitivePromotedHellingerGammaPureHodgeCoface

/-- Two completed Xi incidence channels carrying the pure-Hodge coend. -/
abbrev HellingerGammaPureHodgeXiCofaceCompletion
    (p q : Nat.Primes) (hpq : p ≠ q) :=
  DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq ×
    DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq

def hellingerGammaCompletedPureHodgeExchange
    {p q : Nat.Primes} {hpq : p ≠ q} :
    HellingerGammaPureHodgeXiCofaceCompletion p q hpq →
      HellingerGammaPureHodgeXiCofaceCompletion p q hpq :=
  fun z => (z.2, z.1)

/-- Completed balanced grade primitive.  Each scalar is the exact
Hellinger--Gamma gauge times one reflected modular direction. -/
def hellingerGammaCompletedBalancedPrimitive
    {p q : Nat.Primes} (hpq : p ≠ q) (a : ℝ) (n : ℕ)
    (x : DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq) :
    HellingerGammaPureHodgeXiCofaceCompletion p q hpq :=
  ((hellingerGammaGaugedModularCoefficient (-a) p q n : ℂ) • x,
    (hellingerGammaGaugedModularCoefficient a p q n : ℂ) • x)

theorem hellingerGammaCompletedPureHodgeExchange_balanced
    {p q : Nat.Primes} (hpq : p ≠ q) (a : ℝ) (n : ℕ)
    (x : DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq) :
    hellingerGammaCompletedPureHodgeExchange
        (hellingerGammaCompletedBalancedPrimitive hpq a n x) =
      hellingerGammaCompletedBalancedPrimitive hpq (-a) n x := by
  simp [hellingerGammaCompletedPureHodgeExchange,
    hellingerGammaCompletedBalancedPrimitive]

/-- No completed Xi coefficient is lost at any finite Hellinger grade. -/
theorem hellingerGammaCompletedBalancedPrimitive_injective
    {p q : Nat.Primes} (hpq : p ≠ q) (a : ℝ) (n : ℕ) :
    Function.Injective
      (hellingerGammaCompletedBalancedPrimitive hpq a n) := by
  intro x y hxy
  have hfst := congrArg Prod.fst hxy
  have hc :
      (hellingerGammaGaugedModularCoefficient (-a) p q n : ℂ) ≠ 0 := by
    exact Complex.ofReal_ne_zero.mpr <|
      mul_ne_zero (hellingerEvenGammaResidueGauge_ne_zero n)
        (Real.exp_ne_zero _)
  exact smul_right_injective _ hc hfst

/-- Adjacent-grade completed coface. -/
def hellingerGammaCompletedAdjacentCoface
    {p q : Nat.Primes} (hpq : p ≠ q) (a : ℝ) (n : ℕ)
    (x : DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq) :
    HellingerGammaPureHodgeXiCofaceCompletion p q hpq :=
  hellingerGammaCompletedBalancedPrimitive hpq a (n + 1) x -
    hellingerGammaCompletedBalancedPrimitive hpq a n x

/-- Evaluation of a completed two-channel coefficient at one divisor copy,
followed by the actual pure-Hodge cell-plane embedding. -/
def hellingerGammaCompletedPureHodgeSourceValue
    {p q : Nat.Primes} (hpq : p ≠ q) (n : ℕ) (r : XiZeroCopy)
    (z : HellingerGammaPureHodgeXiCofaceCompletion p q hpq) :
    xiGammaEulerCalderonWittCellMilnorIncidence :=
  pureHodgeCellPlaneEmbedding
      (shiftedPureOrderedDistinctCellPair hpq n n)
    (deningerCalderonWittCrossPrimeXiIncidenceCompletionCoefficient
        p q hpq r z.1,
      deningerCalderonWittCrossPrimeXiIncidenceCompletionCoefficient
        p q hpq r z.2)

theorem hellingerGammaCompletedPureHodgeSourceValue_mem_actual
    {p q : Nat.Primes} (hpq : p ≠ q) (n : ℕ) (r : XiZeroCopy)
    (b : ℝ) (z : HellingerGammaPureHodgeXiCofaceCompletion p q hpq) :
    hellingerGammaCompletedPureHodgeSourceValue hpq n r z ∈
      actualCellGammaAdmittedHodgeSector b := by
  exact pureHodgeCellPlaneEmbedding_mem_actual b _ _

/-- Coordinate formula proving that the completed coend is generated by
actual labelled pure-Hodge cell incidences. -/
theorem hellingerGammaCompletedPureHodgeSourceValue_balanced
    {p q : Nat.Primes} (hpq : p ≠ q) (a : ℝ) (n : ℕ)
    (r : XiZeroCopy)
    (x : DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq) :
    hellingerGammaCompletedPureHodgeSourceValue hpq n r
        (hellingerGammaCompletedBalancedPrimitive hpq a n x) =
      pureHodgeCellPlaneEmbedding
        (shiftedPureOrderedDistinctCellPair hpq n n)
        ((hellingerGammaGaugedModularCoefficient (-a) p q n : ℂ) *
            deningerCalderonWittCrossPrimeXiIncidenceCompletionCoefficient
              p q hpq r x,
          (hellingerGammaGaugedModularCoefficient a p q n : ℂ) *
            deningerCalderonWittCrossPrimeXiIncidenceCompletionCoefficient
              p q hpq r x) := by
  simp [hellingerGammaCompletedPureHodgeSourceValue,
    hellingerGammaCompletedBalancedPrimitive]

/-- Finite completed coface boundaries telescope exactly. -/
theorem sum_hellingerGammaCompletedAdjacentCoface
    {p q : Nat.Primes} (hpq : p ≠ q) (a : ℝ) (N : ℕ)
    (x : DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq) :
    ∑ n ∈ Finset.range N,
        hellingerGammaCompletedAdjacentCoface hpq a n x =
      hellingerGammaCompletedBalancedPrimitive hpq a N x -
        hellingerGammaCompletedBalancedPrimitive hpq a 0 x := by
  simpa only [hellingerGammaCompletedAdjacentCoface, Nat.add_comm] using
    (Finset.sum_range_sub
      (fun n => hellingerGammaCompletedBalancedPrimitive hpq a n x) N)

/-- Both completed channels tend to zero by the factorial Gamma-residue
estimate. -/
theorem hellingerGammaCompletedBalancedPrimitive_tendsto_zero
    {p q : Nat.Primes} (hpq : p ≠ q) (a : ℝ)
    (x : DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq) :
    Tendsto
      (fun n : ℕ => hellingerGammaCompletedBalancedPrimitive hpq a n x)
      atTop (𝓝 0) := by
  have hminusR :=
    hellingerGammaGaugedModularCoefficient_tendsto_zero (-a) p q
  have hplusR :=
    hellingerGammaGaugedModularCoefficient_tendsto_zero a p q
  have hminusC :
      Tendsto
        (fun n : ℕ =>
          (hellingerGammaGaugedModularCoefficient (-a) p q n : ℂ))
        atTop (𝓝 0) := by
    exact Complex.continuous_ofReal.continuousAt.tendsto.comp hminusR
  have hplusC :
      Tendsto
        (fun n : ℕ =>
          (hellingerGammaGaugedModularCoefficient a p q n : ℂ))
        atTop (𝓝 0) := by
    exact Complex.continuous_ofReal.continuousAt.tendsto.comp hplusR
  have hminus := hminusC.smul_const x
  have hplus := hplusC.smul_const x
  convert hminus.prodMk_nhds hplus using 1 <;>
    simp [hellingerGammaCompletedBalancedPrimitive]
  apply Prod.ext <;> rfl

/-- Partial completed coface sums converge to the negative depth-zero
balanced primitive. -/
theorem sum_hellingerGammaCompletedAdjacentCoface_tendsto
    {p q : Nat.Primes} (hpq : p ≠ q) (a : ℝ)
    (x : DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq) :
    Tendsto
      (fun N : ℕ => ∑ n ∈ Finset.range N,
        hellingerGammaCompletedAdjacentCoface hpq a n x)
      atTop
      (𝓝 (-hellingerGammaCompletedBalancedPrimitive hpq a 0 x)) := by
  have hzero := hellingerGammaCompletedBalancedPrimitive_tendsto_zero hpq a x
  have hsub := hzero.sub_const
    (hellingerGammaCompletedBalancedPrimitive hpq a 0 x)
  have hsub' :
      Tendsto
        (fun N => hellingerGammaCompletedBalancedPrimitive hpq a N x -
          hellingerGammaCompletedBalancedPrimitive hpq a 0 x)
        atTop
        (𝓝 (-hellingerGammaCompletedBalancedPrimitive hpq a 0 x)) := by
    simpa only [zero_sub] using hsub
  apply hsub'.congr'
  filter_upwards with N
  exact (sum_hellingerGammaCompletedAdjacentCoface hpq a N x).symm

/-- Continuous depth-zero head-channel recovery.  The sign is chosen so
that the limit of partial coface sums recovers the original completed Xi
vector. -/
def hellingerGammaCompletedCofaceRecovery
    {p q : Nat.Primes} (hpq : p ≠ q) (a : ℝ) :
    HellingerGammaPureHodgeXiCofaceCompletion p q hpq →L[ℂ]
      DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq :=
  (-(hellingerGammaGaugedModularCoefficient (-a) p q 0 : ℂ))⁻¹ •
    ContinuousLinearMap.fst ℂ
      (DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq)
      (DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq)

theorem hellingerGammaCompletedCofaceRecovery_limit
    {p q : Nat.Primes} (hpq : p ≠ q) (a : ℝ)
    (x : DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq) :
    hellingerGammaCompletedCofaceRecovery hpq a
        (-hellingerGammaCompletedBalancedPrimitive hpq a 0 x) = x := by
  have hc :
      (hellingerGammaGaugedModularCoefficient (-a) p q 0 : ℂ) ≠ 0 := by
    exact Complex.ofReal_ne_zero.mpr <|
      mul_ne_zero (hellingerEvenGammaResidueGauge_ne_zero 0)
        (Real.exp_ne_zero _)
  rw [hellingerGammaCompletedCofaceRecovery,
    hellingerGammaCompletedBalancedPrimitive]
  simp only [smul_apply, ContinuousLinearMap.coe_fst', Prod.fst_neg]
  change
    (-(hellingerGammaGaugedModularCoefficient (-a) p q 0 : ℂ))⁻¹ •
      (-((hellingerGammaGaugedModularCoefficient (-a) p q 0 : ℂ) • x)) = x
  rw [← neg_smul, smul_smul,
    inv_mul_cancel₀ (neg_ne_zero.mpr hc), one_smul]

/-- Continuous recovery turns the telescoping coface limit into the exact
completed Xi incidence vector. -/
theorem hellingerGammaCompletedCofaceRecovery_tendsto_xi
    {p q : Nat.Primes} (hpq : p ≠ q) (a : ℝ)
    (x : DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq) :
    Tendsto
      (fun N : ℕ => hellingerGammaCompletedCofaceRecovery hpq a
        (∑ n ∈ Finset.range N,
          hellingerGammaCompletedAdjacentCoface hpq a n x))
      atTop (𝓝 x) := by
  have hsum := sum_hellingerGammaCompletedAdjacentCoface_tendsto hpq a x
  have hmap :=
    (hellingerGammaCompletedCofaceRecovery hpq a).continuous.continuousAt.tendsto.comp hsum
  change Tendsto
    (fun N : ℕ => hellingerGammaCompletedCofaceRecovery hpq a
      (∑ n ∈ Finset.range N,
        hellingerGammaCompletedAdjacentCoface hpq a n x))
    atTop
    (𝓝 (hellingerGammaCompletedCofaceRecovery hpq a
      (-hellingerGammaCompletedBalancedPrimitive hpq a 0 x))) at hmap
  simpa only [hellingerGammaCompletedCofaceRecovery_limit] using hmap

/-- Specialization to the already constructed completed Xi Green
comparison. -/
theorem hellingerGammaCompletedGreenCofaceRecovery_tendsto
    (p q : Nat.Primes) (hpq : p ≠ q) (a : ℝ)
    (ell : DeningerArithmeticTopologicalH1Compact) :
    Tendsto
      (fun N : ℕ => hellingerGammaCompletedCofaceRecovery hpq a
        (∑ n ∈ Finset.range N,
          hellingerGammaCompletedAdjacentCoface hpq a n
            (deningerArithmeticCompletedGreenToCrossPrimeIncidence
              p q hpq ell)))
      atTop
      (𝓝 (deningerArithmeticCompletedGreenToCrossPrimeIncidence
        p q hpq ell)) := by
  exact hellingerGammaCompletedCofaceRecovery_tendsto_xi hpq a
    (deningerArithmeticCompletedGreenToCrossPrimeIncidence p q hpq ell)

end CompletedXiHellingerGammaPureHodgeCoface

