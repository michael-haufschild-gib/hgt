import GaloisForLFunctions.RHTower.DeningerQ8ActualQuadraticSource
import Mathlib.FieldTheory.IntermediateField.Algebraic
import Mathlib.GroupTheory.Commutator.Basic
import Mathlib.GroupTheory.PGroup

/-!
# The literal maximal abelian subfield of the Q8 witness

Fröhlich's quaternion root-number formula is stated relative to the maximal
abelian subfield.  This file identifies that field inside the literal radical
Q8 extension, without assuming an epsilon factor or root-number sign.

The embedded second radical field `Q(sqrt 5, sqrt 41)` is fixed by the
nontrivial involution `q8C` and has relative degree two.  Artin's degree
formula therefore identifies it with the fixed field of `<q8C>`.  A separate
group calculation proves that this subgroup is both the center and the
commutator subgroup of the actual Galois group.  Hence the field is exactly
the maximal abelian subextension required by the arithmetic formula.
-/

namespace RHTower

noncomputable section

open GaloisForLFunctions
open scoped IntermediateField
open scoped commutatorElement

local notation "K1" => deningerQ8RootNumberNegOneFirstQuadraticField
local notation "K2" => deningerQ8RootNumberNegOneSecondQuadraticField
local notation "K3" => deningerQ8RootNumberNegOneTopField

local instance deningerQ8MaxAbAlgebra : Algebra ℚ K3 := by infer_instance

noncomputable local instance deningerQ8MaxAbFiniteDimensionalK1K2 :
    FiniteDimensional K1 K2 :=
  Module.Basis.finiteDimensional_of_finite
    (AdjoinRoot.powerBasis
      deningerQ8RootNumberNegOne_secondQuadratic_irreducible.ne_zero).basis

noncomputable local instance deningerQ8MaxAbFiniteDimensionalK2K3 :
    FiniteDimensional K2 K3 :=
  Module.Basis.finiteDimensional_of_finite
    (AdjoinRoot.powerBasis
      deningerQ8RootNumberNegOne_thirdQuadratic_irreducible.ne_zero).basis

noncomputable local instance deningerQ8MaxAbFiniteDimensionalRatK2 :
    FiniteDimensional ℚ K2 :=
  FiniteDimensional.trans ℚ K1 K2

noncomputable local instance deningerQ8MaxAbFiniteDimensionalRatK3 :
    FiniteDimensional ℚ K3 :=
  FiniteDimensional.trans ℚ K2 K3

local instance deningerQ8MaxAbCharZero : CharZero K3 :=
  charZero_of_injective_algebraMap (algebraMap ℚ K3).injective

noncomputable local instance deningerQ8MaxAbIsGalois : IsGalois ℚ K3 :=
  deningerQ8RootNumberNegOne_isGalois

/-- The literal embedded biquadratic field `Q(sqrt 5, sqrt 41)`. -/
abbrev deningerQ8ActualBiquadraticField : IntermediateField ℚ K3 :=
  IntermediateField.map (IsScalarTower.toAlgHom ℚ K2 K3) ⊤

noncomputable local instance deningerQ8MaxAbFiniteDimensionalRatBiquadratic :
    FiniteDimensional ℚ deningerQ8ActualBiquadraticField :=
  LinearEquiv.finiteDimensional
    (IntermediateField.equivMap (⊤ : IntermediateField ℚ K2)
      (IsScalarTower.toAlgHom ℚ K2 K3)).toLinearEquiv

/-- The literal central involution of the radical Q8 action. -/
abbrev deningerQ8ActualCentralInvolution : Gal(K3/ℚ) := q8CAlgEquiv

/-- The cyclic subgroup generated by the literal central involution. -/
abbrev deningerQ8ActualCentralSubgroup : Subgroup Gal(K3/ℚ) :=
  Subgroup.zpowers deningerQ8ActualCentralInvolution

/-- The top radical detects that `q8C` is not the identity. -/
theorem deningerQ8ActualCentralInvolution_ne_one :
    deningerQ8ActualCentralInvolution ≠ 1 := by
  intro h
  have hr := DFunLike.congr_fun h deningerQ8RootNumberNegOneTopRoot
  simp only [deningerQ8ActualCentralInvolution, q8CAlgEquiv_apply,
    q8C_root] at hr
  have hr' : -deningerQ8RootNumberNegOneTopRoot =
      deningerQ8RootNumberNegOneTopRoot := by simpa using hr
  apply q8TopRoot_ne_zero
  have htwo : (2 : K3) * deningerQ8RootNumberNegOneTopRoot = 0 := by
    rw [two_mul]
    calc
      deningerQ8RootNumberNegOneTopRoot + deningerQ8RootNumberNegOneTopRoot =
          -deningerQ8RootNumberNegOneTopRoot +
            deningerQ8RootNumberNegOneTopRoot := by rw [hr']
      _ = 0 := neg_add_cancel _
  exact (mul_eq_zero.mp htwo).resolve_left (by norm_num)

/-- The literal central involution has exact order two. -/
theorem deningerQ8ActualCentralInvolution_orderOf :
    orderOf deningerQ8ActualCentralInvolution = 2 := by
  exact orderOf_eq_prime q8CAlgEquiv_sq_eq_one
    deningerQ8ActualCentralInvolution_ne_one

/-- The literal central cyclic subgroup has exactly two elements. -/
theorem deningerQ8ActualCentralSubgroup_natCard :
    Nat.card deningerQ8ActualCentralSubgroup = 2 := by
  rw [Nat.card_zpowers, deningerQ8ActualCentralInvolution_orderOf]

/-- The embedded second radical field retains its literal degree four. -/
theorem deningerQ8ActualBiquadraticField_finrank_over_rat :
    Module.finrank ℚ deningerQ8ActualBiquadraticField = 4 := by
  calc
    Module.finrank ℚ deningerQ8ActualBiquadraticField =
        Module.finrank ℚ (⊤ : IntermediateField ℚ K2) :=
      (IntermediateField.equivMap (⊤ : IntermediateField ℚ K2)
        (IsScalarTower.toAlgHom ℚ K2 K3)).toLinearEquiv.finrank_eq.symm
    _ = Module.finrank ℚ K2 := by simp
    _ = 4 := deningerQ8RootNumberNegOneSecondQuadraticField_finrank_over_rat

/-- Every power of `q8C` fixes the embedded second radical field. -/
theorem deningerQ8ActualBiquadraticField_le_fixedField_centralSubgroup :
    deningerQ8ActualBiquadraticField ≤
      IntermediateField.fixedField deningerQ8ActualCentralSubgroup := by
  intro x hx
  rw [IntermediateField.mem_fixedField_iff]
  intro g hg
  obtain ⟨y, -, rfl⟩ := hx
  obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hg
  clear hg
  have hc : q8CAlgEquiv ((IsScalarTower.toAlgHom ℚ K2 K3) y) =
      (IsScalarTower.toAlgHom ℚ K2 K3) y := by
    change q8C ((IsScalarTower.toAlgHom ℚ K2 K3) y) =
      (IsScalarTower.toAlgHom ℚ K2 K3) y
    exact q8C_of y
  change (q8CAlgEquiv ^ n) ((IsScalarTower.toAlgHom ℚ K2 K3) y) =
    (IsScalarTower.toAlgHom ℚ K2 K3) y
  induction n using Int.induction_on with
  | zero => simp
  | succ n hn =>
      rw [zpow_add_one, AlgEquiv.mul_apply, hc, hn]
  | pred n hn =>
      rw [zpow_sub_one, AlgEquiv.mul_apply]
      have hcinv : q8CAlgEquiv⁻¹ = q8CAlgEquiv := by
        apply inv_eq_of_mul_eq_one_left
        simpa [pow_two] using q8CAlgEquiv_sq_eq_one
      rw [hcinv, hc, hn]

/-- The top Q8 field has relative degree two over the embedded biquadratic field. -/
theorem deningerQ8ActualBiquadraticField_finrank_over_top :
    Module.finrank deningerQ8ActualBiquadraticField K3 = 2 := by
  have htower :
      Module.finrank ℚ deningerQ8ActualBiquadraticField *
          Module.finrank deningerQ8ActualBiquadraticField K3 =
        Module.finrank ℚ K3 :=
    Module.finrank_mul_finrank ℚ deningerQ8ActualBiquadraticField K3
  rw [deningerQ8ActualBiquadraticField_finrank_over_rat,
    deningerQ8RootNumberNegOneTopField_finrank_over_rat] at htower
  omega

/-- The embedded biquadratic field is exactly the fixed field of `<q8C>`. -/
theorem deningerQ8ActualBiquadraticField_eq_fixedField_centralSubgroup :
    deningerQ8ActualBiquadraticField =
      IntermediateField.fixedField deningerQ8ActualCentralSubgroup := by
  apply GaloisForLFunctions.HTGeometry.eq_fixedField_of_le_of_finrank_eq
    deningerQ8ActualCentralSubgroup
    deningerQ8ActualBiquadraticField_le_fixedField_centralSubgroup
  rw [deningerQ8ActualBiquadraticField_finrank_over_top,
    deningerQ8ActualCentralSubgroup_natCard]

/-! ## Exact center and commutator of Q8 -/

/-- The element `a 2` is central in the concrete quaternion group. -/
theorem deningerQ8_a_two_mem_center :
    QuaternionGroup.a (2 : ZMod 4) ∈ Subgroup.center (QuaternionGroup 2) := by
  rw [Subgroup.mem_center_iff]
  rintro (j | j)
  · simp only [QuaternionGroup.a_mul_a]
    congr 1
    ring
  · simp only [QuaternionGroup.xa_mul_a, QuaternionGroup.a_mul_xa]
    congr 1
    have htwo : (2 : ZMod 4) = -2 := by
      apply eq_neg_iff_add_eq_zero.mpr
      change (4 : ZMod 4) = 0
      exact ZMod.natCast_self 4
    simpa [sub_eq_add_neg] using congrArg (fun x : ZMod 4 => j + x) htwo

private theorem deningerQ8_zmod_four_one_ne_neg_one :
    (1 : ZMod 4) ≠ -1 := by
  intro h
  have htwo_ne : (2 : ZMod 4) ≠ 0 := by
    intro hz
    have hv := congrArg ZMod.val hz
    change (2 : ℕ) = 0 at hv
    omega
  apply htwo_ne
  calc
    (2 : ZMod 4) = 1 + 1 := by norm_num
    _ = -1 + 1 := congrArg (fun x : ZMod 4 => x + 1) h
    _ = 0 := neg_add_cancel _

/-- The center of concrete Q8 is exactly the subgroup generated by `a 2`. -/
theorem deningerQ8_center_eq_centralGenerator :
    Subgroup.center (QuaternionGroup 2) =
      Subgroup.zpowers (QuaternionGroup.a (2 : ZMod 4)) := by
  apply le_antisymm
  · rintro (i | i) hi
    · have hcomm := Subgroup.mem_center_iff.mp hi
        (QuaternionGroup.xa (0 : ZMod 4))
      simp only [QuaternionGroup.xa_mul_a, QuaternionGroup.a_mul_xa] at hcomm
      injection hcomm with hind
      fin_cases i
      · exact Subgroup.one_mem _
      · exfalso
        change (1 : ZMod 4) = -1 at hind
        exact deningerQ8_zmod_four_one_ne_neg_one hind
      · change QuaternionGroup.a (n := 2) (2 : ZMod 4) ∈
          Subgroup.zpowers (QuaternionGroup.a (n := 2) (2 : ZMod 4))
        exact Subgroup.mem_zpowers _
      · exfalso
        change (3 : ZMod 4) = -(3 : ZMod 4) at hind
        have hthree : (3 : ZMod 4) = -1 := by
          apply eq_neg_iff_add_eq_zero.mpr
          change (4 : ZMod 4) = 0
          exact ZMod.natCast_self 4
        rw [hthree, neg_neg] at hind
        exact deningerQ8_zmod_four_one_ne_neg_one hind.symm
    · have hcomm := Subgroup.mem_center_iff.mp hi
        (QuaternionGroup.a (1 : ZMod 4))
      simp only [QuaternionGroup.a_mul_xa, QuaternionGroup.xa_mul_a] at hcomm
      injection hcomm with hind
      exfalso
      have hneg_one_eq_one : (-1 : ZMod 4) = 1 := by
        apply add_left_cancel (a := i)
        simpa [sub_eq_add_neg] using hind
      exact deningerQ8_zmod_four_one_ne_neg_one hneg_one_eq_one.symm
  · exact Subgroup.zpowers_le.mpr deningerQ8_a_two_mem_center

/-- The concrete Q8 center has exactly two elements. -/
theorem deningerQ8_center_natCard :
    Nat.card (Subgroup.center (QuaternionGroup 2)) = 2 := by
  have horder : orderOf (QuaternionGroup.a (n := 2) (2 : ZMod 4)) = 2 := by
    apply orderOf_eq_prime
    · rw [pow_two, QuaternionGroup.a_mul_a, QuaternionGroup.one_def]
      congr 1
    · intro h
      rw [QuaternionGroup.one_def] at h
      injection h with hz
      have hv := congrArg ZMod.val hz
      change (2 : ℕ) = 0 at hv
      omega
  rw [deningerQ8_center_eq_centralGenerator, Nat.card_zpowers, horder]

/-- One literal commutator produces the nontrivial central element. -/
theorem deningerQ8_commutator_generator :
    ⁅QuaternionGroup.a (n := 2) (1 : ZMod 4),
        QuaternionGroup.xa (n := 2) (0 : ZMod 4)⁆ =
      QuaternionGroup.a (n := 2) (2 : ZMod 4) := by
  have ha_inv : (QuaternionGroup.a (n := 2) (1 : ZMod 4))⁻¹ =
      QuaternionGroup.a (n := 2) (3 : ZMod 4) := by
    apply inv_eq_of_mul_eq_one_right
    rw [QuaternionGroup.a_mul_a, QuaternionGroup.one_def]
    congr 1
  have hx_inv : (QuaternionGroup.xa (n := 2) (0 : ZMod 4))⁻¹ =
      QuaternionGroup.xa (n := 2) (2 : ZMod 4) := by
    apply inv_eq_of_mul_eq_one_right
    rw [QuaternionGroup.xa_mul_xa, QuaternionGroup.one_def]
    congr 1
  rw [commutatorElement_def, ha_inv, hx_inv,
    QuaternionGroup.a_mul_xa, QuaternionGroup.xa_mul_a,
    QuaternionGroup.xa_mul_xa]
  congr 1

/-- For concrete Q8, commutator subgroup and center coincide. -/
theorem deningerQ8_commutator_eq_center :
    commutator (QuaternionGroup 2) = Subgroup.center (QuaternionGroup 2) := by
  apply le_antisymm
  · rw [← Subgroup.Normal.quotient_commutative_iff_commutator_le]
    apply IsPGroup.isMulCommutative_of_card_eq_prime_sq (p := 2)
    have hcard := Subgroup.card_eq_card_quotient_mul_card_subgroup
      (Subgroup.center (QuaternionGroup 2))
    rw [Nat.card_eq_fintype_card, QuaternionGroup.card,
      deningerQ8_center_natCard] at hcard
    norm_num at hcard ⊢
    omega
  · rw [deningerQ8_center_eq_centralGenerator, Subgroup.zpowers_le]
    rw [← deningerQ8_commutator_generator]
    rw [commutator_def]
    exact Subgroup.commutator_mem_commutator
      (show QuaternionGroup.a (n := 2) (1 : ZMod 4) ∈
        (⊤ : Subgroup (QuaternionGroup 2)) from Subgroup.mem_top _)
      (show QuaternionGroup.xa (n := 2) (0 : ZMod 4) ∈
        (⊤ : Subgroup (QuaternionGroup 2)) from Subgroup.mem_top _)

/-! ## Transport to the literal Galois group -/

/-- The actual Galois equivalence sends `q8C` to the concrete element `a 2`. -/
theorem deningerQ8_galoisEquiv_q8C :
    deningerQ8RootNumberNegOne_galoisEquivQ8 q8CAlgEquiv =
      QuaternionGroup.a (n := 2) (2 : ZMod 4) := by
  let e : QuaternionGroup 2 ≃* Gal(K3/ℚ) :=
    MulEquiv.ofBijective q8AutCandidateHom q8AutCandidateHom_bijective
  change e.symm q8CAlgEquiv = QuaternionGroup.a (n := 2) (2 : ZMod 4)
  apply e.injective
  rw [e.apply_symm_apply]
  symm
  change q8IAlgPow (2 : ZMod 4) = q8CAlgEquiv
  exact q8IAlgPow_two_eq_C

/-- The literal cyclic subgroup `<q8C>` is the center of the actual Galois group. -/
theorem deningerQ8ActualCentralSubgroup_eq_center :
    deningerQ8ActualCentralSubgroup = Subgroup.center Gal(K3/ℚ) := by
  apply le_antisymm
  · rw [Subgroup.zpowers_le]
    rw [Subgroup.mem_center_iff]
    intro g
    apply deningerQ8RootNumberNegOne_galoisEquivQ8.injective
    rw [map_mul, map_mul, deningerQ8_galoisEquiv_q8C]
    exact Subgroup.mem_center_iff.mp deningerQ8_a_two_mem_center
      (deningerQ8RootNumberNegOne_galoisEquivQ8 g)
  · intro g hg
    have hq : deningerQ8RootNumberNegOne_galoisEquivQ8 g ∈
        Subgroup.center (QuaternionGroup 2) := by
      rw [Subgroup.mem_center_iff]
      intro q
      obtain ⟨h, rfl⟩ := deningerQ8RootNumberNegOne_galoisEquivQ8.surjective q
      simpa only [map_mul] using
        congrArg deningerQ8RootNumberNegOne_galoisEquivQ8
          (Subgroup.mem_center_iff.mp hg h)
    rw [deningerQ8_center_eq_centralGenerator] at hq
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hq
    apply Subgroup.mem_zpowers_iff.mpr
    refine ⟨n, ?_⟩
    apply deningerQ8RootNumberNegOne_galoisEquivQ8.injective
    rw [map_zpow, deningerQ8_galoisEquiv_q8C]
    exact hn

/-- The actual commutator subgroup is exactly `<q8C>`. -/
theorem deningerQ8ActualCommutator_eq_centralSubgroup :
    commutator Gal(K3/ℚ) = deningerQ8ActualCentralSubgroup := by
  apply Subgroup.map_injective
    (f := deningerQ8RootNumberNegOne_galoisEquivQ8.toMonoidHom)
    deningerQ8RootNumberNegOne_galoisEquivQ8.injective
  calc
    (commutator Gal(K3/ℚ)).map
        deningerQ8RootNumberNegOne_galoisEquivQ8.toMonoidHom =
        ⁅deningerQ8RootNumberNegOne_galoisEquivQ8.toMonoidHom.range,
          deningerQ8RootNumberNegOne_galoisEquivQ8.toMonoidHom.range⁆ :=
      map_commutator_eq Gal(K3/ℚ)
        deningerQ8RootNumberNegOne_galoisEquivQ8.toMonoidHom
    _ = commutator (QuaternionGroup 2) := by
      rw [MonoidHom.range_eq_top.mpr
        deningerQ8RootNumberNegOne_galoisEquivQ8.surjective]
      rfl
    _ = Subgroup.center (QuaternionGroup 2) := deningerQ8_commutator_eq_center
    _ = Subgroup.zpowers (QuaternionGroup.a (n := 2) (2 : ZMod 4)) :=
      deningerQ8_center_eq_centralGenerator
    _ = deningerQ8ActualCentralSubgroup.map
        deningerQ8RootNumberNegOne_galoisEquivQ8.toMonoidHom := by
      rw [MonoidHom.map_zpowers]
      change Subgroup.zpowers (QuaternionGroup.a (n := 2) (2 : ZMod 4)) =
        Subgroup.zpowers
          (deningerQ8RootNumberNegOne_galoisEquivQ8 q8CAlgEquiv)
      rw [deningerQ8_galoisEquiv_q8C]

/-- The embedded biquadratic field is the fixed field of the actual center. -/
theorem deningerQ8ActualBiquadraticField_eq_fixedField_center :
    deningerQ8ActualBiquadraticField =
      IntermediateField.fixedField (Subgroup.center Gal(K3/ℚ)) := by
  rw [← deningerQ8ActualCentralSubgroup_eq_center]
  exact deningerQ8ActualBiquadraticField_eq_fixedField_centralSubgroup

/-- The embedded biquadratic field is the fixed field of the actual commutator subgroup. -/
theorem deningerQ8ActualBiquadraticField_eq_fixedField_commutator :
    deningerQ8ActualBiquadraticField =
      IntermediateField.fixedField (commutator Gal(K3/ℚ)) := by
  rw [deningerQ8ActualCommutator_eq_centralSubgroup]
  exact deningerQ8ActualBiquadraticField_eq_fixedField_centralSubgroup

noncomputable instance deningerQ8ActualCentralSubgroup_normal :
    deningerQ8ActualCentralSubgroup.Normal := by
  rw [deningerQ8ActualCentralSubgroup_eq_center]
  infer_instance

/-- The actual quotient by `<q8C>` is abelian. -/
theorem deningerQ8ActualCentralQuotient_isMulCommutative :
    IsMulCommutative (Gal(K3/ℚ) ⧸ deningerQ8ActualCentralSubgroup) := by
  rw [Subgroup.Normal.quotient_commutative_iff_commutator_le]
  rw [deningerQ8ActualCommutator_eq_centralSubgroup]

/-- `<q8C>` is minimal among normal subgroups with abelian quotient.  This is
the group-theoretic maximal-abelian universal property used by Fröhlich's
field `K`. -/
theorem deningerQ8ActualCentralSubgroup_le_of_quotient_commutative
    (H : Subgroup Gal(K3/ℚ)) [H.Normal]
    [IsMulCommutative (Gal(K3/ℚ) ⧸ H)] :
    deningerQ8ActualCentralSubgroup ≤ H := by
  rw [← deningerQ8ActualCommutator_eq_centralSubgroup]
  exact Subgroup.Normal.quotient_commutative_iff_commutator_le.mp inferInstance

end

end RHTower
