import GaloisForLFunctions.RHTower.SuzukiFiniteApertureHermiteBiehler

/-!
# Suzuki's projective defect boundary

Suzuki's finite-aperture Livšic carrier is insensitive to a common positive rescaling of its two
defect channels.  This makes the carrier projective: the absolute scale of the shifted positive
operator is not visible, while the relative even/odd defect energy is visible.

The far-negative shift end has an exact universal representative

`(exp (-2a) - exp (2iaz)) / (1 - exp (-2a) exp (2iaz))`.

This module proves that these free representatives converge locally uniformly to zero on the
upper half-plane as the aperture tends to infinity.  Thus the zero Schur carrier is a genuine
boundary point of the Suzuki projective family, not merely a pointwise or numerical artifact.

The same source presentation has an exact parity involution.  It selects the phase `u = 1` as the
unique odd member and `u = -1` as the unique even member whenever the two source channels do not
degenerate.  Together these results replace arbitrary-shift independence by a concrete forward
problem: work in the unconditional ground-centered chart and prove survival of a fixed anchored
defect jet away from the universal free boundary.
-/

open Complex Metric Set Filter Topology

noncomputable section

namespace GaloisForLFunctions.RHTower

/-! ## Projective carrier laws -/

/-- A common nonzero scale of both deficiency channels is invisible to the Livšic carrier. -/
theorem suzukiLivsicQuotient_common_scale
    (A E : ℂ → ℂ) {c z : ℂ} (hc : c ≠ 0) :
    suzukiLivsicQuotient (fun w => c * A w) (fun w => c * E w) z =
      suzukiLivsicQuotient A E z := by
  exact mul_div_mul_left (A z) (E z) hc

/-- The characteristic pencil itself changes only by the common projective scale. -/
theorem suzukiCharacteristicPencil_common_scale
    (A E : ℂ → ℂ) (c u z : ℂ) :
    suzukiCharacteristicPencil (fun w => c * A w) (fun w => c * E w) u z =
      c * suzukiCharacteristicPencil A E u z := by
  simp only [suzukiCharacteristicPencil]
  ring

/-! ## Source parity and exact phase selection -/

/-- The reflection relation carried by Suzuki's two Fourier defect channels. -/
def SuzukiParityPair (A E : ℂ → ℂ) : Prop :=
  ∀ z : ℂ, A (-z) = -E z ∧ E (-z) = -A z

/-- The two source channels generated by one Fourier transform. -/
def suzukiFourierNumerator (F : ℂ → ℂ) (z : ℂ) : ℂ :=
  (z - I) * F z

/-- The reflected Fourier channel in Suzuki's characteristic pencil. -/
def suzukiFourierDenominator (F : ℂ → ℂ) (z : ℂ) : ℂ :=
  (z + I) * F (-z)

/-- Suzuki's Fourier source pair has the parity involution identically, with no analytic
hypothesis on the source transform. -/
theorem suzukiFourier_parityPair (F : ℂ → ℂ) :
    SuzukiParityPair (suzukiFourierNumerator F) (suzukiFourierDenominator F) := by
  intro z
  constructor <;> simp only [suzukiFourierNumerator, suzukiFourierDenominator, neg_neg] <;> ring

/-- Reflection in the spectral variable inverts the extension phase. -/
theorem suzukiCharacteristicPencil_neg_of_parity
    {A E : ℂ → ℂ} (hpar : SuzukiParityPair A E) {u : ℂ} (hu : u ≠ 0) (z : ℂ) :
    suzukiCharacteristicPencil A E u (-z) =
      -u * suzukiCharacteristicPencil A E u⁻¹ z := by
  obtain ⟨hA, hE⟩ := hpar z
  simp only [suzukiCharacteristicPencil, hA, hE]
  field_simp
  ring

/-- The phase `u=1` is the parity-preserving odd Suzuki member. -/
theorem suzukiCharacteristicPencil_one_odd
    {A E : ℂ → ℂ} (hpar : SuzukiParityPair A E) (z : ℂ) :
    suzukiCharacteristicPencil A E 1 (-z) = -suzukiCharacteristicPencil A E 1 z := by
  simpa using suzukiCharacteristicPencil_neg_of_parity hpar one_ne_zero z

/-- The phase `u=-1` is the parity-preserving even Suzuki member. -/
theorem suzukiCharacteristicPencil_neg_one_even
    {A E : ℂ → ℂ} (hpar : SuzukiParityPair A E) (z : ℂ) :
    suzukiCharacteristicPencil A E (-1) (-z) = suzukiCharacteristicPencil A E (-1) z := by
  simpa using suzukiCharacteristicPencil_neg_of_parity hpar (by norm_num : (-1 : ℂ) ≠ 0) z

/-- Away from the diagonal degeneration `A=E`, an odd member has the unique phase `u=1`. -/
theorem suzuki_odd_phase_eq_one
    {A E : ℂ → ℂ} (hpar : SuzukiParityPair A E) {u : ℂ}
    (hodd : ∀ z, suzukiCharacteristicPencil A E u (-z) =
      -suzukiCharacteristicPencil A E u z)
    (hsep : ∃ z, A z ≠ E z) :
    u = 1 := by
  obtain ⟨z, hz⟩ := hsep
  obtain ⟨hA, hE⟩ := hpar z
  have hw := hodd z
  simp only [suzukiCharacteristicPencil, hA, hE] at hw
  have hfactor : (u - 1) * (A z - E z) = 0 := by
    calc
      (u - 1) * (A z - E z) =
          -((-E z + u * -A z) - (-(A z + u * E z))) := by ring
      _ = 0 := by rw [hw]; ring
  exact sub_eq_zero.mp ((mul_eq_zero.mp hfactor).resolve_right (sub_ne_zero.mpr hz))

/-- Away from the anti-diagonal degeneration `A=-E`, an even member has the unique phase `u=-1`. -/
theorem suzuki_even_phase_eq_neg_one
    {A E : ℂ → ℂ} (hpar : SuzukiParityPair A E) {u : ℂ}
    (heven : ∀ z, suzukiCharacteristicPencil A E u (-z) =
      suzukiCharacteristicPencil A E u z)
    (hsep : ∃ z, A z ≠ -E z) :
    u = -1 := by
  obtain ⟨z, hz⟩ := hsep
  obtain ⟨hA, hE⟩ := hpar z
  have hw := heven z
  simp only [suzukiCharacteristicPencil, hA, hE] at hw
  have hfactor : (u + 1) * (A z + E z) = 0 := by
    calc
      (u + 1) * (A z + E z) =
          -((-E z + u * -A z) - (A z + u * E z)) := by ring
      _ = 0 := by rw [hw]; ring
  have hsum : A z + E z ≠ 0 := by
    intro hzero
    apply hz
    linear_combination hzero
  have hu : u + 1 = 0 := (mul_eq_zero.mp hfactor).resolve_right hsum
  linear_combination hu

/-! ## The normalized two-defect Gram state -/

/-- The projectively normalized two-channel defect Gram operator. -/
def suzukiNormalizedDefectGram (N C : ℝ) (x : ℝ × ℝ) : ℝ × ℝ :=
  ((N * x.1 + C * x.2) / (2 * N), (C * x.1 + N * x.2) / (2 * N))

/-- The even defect channel is an eigenline of the normalized Gram state. -/
theorem suzukiNormalizedDefectGram_even (N C : ℝ) :
    suzukiNormalizedDefectGram N C (1, 1) =
      ((N + C) / (2 * N), (N + C) / (2 * N)) := by
  apply Prod.ext
  · simp [suzukiNormalizedDefectGram]
  · simp [suzukiNormalizedDefectGram]
    ring

/-- The odd defect channel is the complementary eigenline. -/
theorem suzukiNormalizedDefectGram_odd (N C : ℝ) :
    suzukiNormalizedDefectGram N C (1, -1) =
      ((N - C) / (2 * N), -(N - C) / (2 * N)) := by
  ext <;> simp [suzukiNormalizedDefectGram] <;> ring

/-- The normalized defect Gram state depends only on the projective ray `(N,C)`. -/
theorem suzukiNormalizedDefectGram_common_scale
    {c N C : ℝ} (hc : c ≠ 0) (hN : N ≠ 0) (x : ℝ × ℝ) :
    suzukiNormalizedDefectGram (c * N) (c * C) x =
      suzukiNormalizedDefectGram N C x := by
  ext <;> simp only [suzukiNormalizedDefectGram] <;> field_simp

/-- The even and odd Gram eigenweights form a probability split, and their signed polarization is
exactly the normalized defect angle `C/N`. -/
theorem suzukiDefectGram_weight_and_polarization {N C : ℝ} (hN : N ≠ 0) :
    (N + C) / (2 * N) + (N - C) / (2 * N) = 1 ∧
      (N + C) / (2 * N) - (N - C) / (2 * N) = C / N := by
  constructor <;> field_simp <;> ring

/-- Positivity of a two-channel Gram matrix puts both parity weights in the unit interval. -/
theorem suzukiDefectGram_weights_mem_unitInterval
    {N C : ℝ} (hN : 0 < N) (hC : |C| ≤ N) :
    (N + C) / (2 * N) ∈ Set.Icc 0 1 ∧ (N - C) / (2 * N) ∈ Set.Icc 0 1 := by
  rcases abs_le.mp hC with ⟨hlo, hhi⟩
  have hden : 0 < 2 * N := mul_pos (by norm_num) hN
  constructor
  · constructor
    · exact div_nonneg (by linarith) hden.le
    · exact (div_le_one hden).mpr (by linarith)
  · constructor
    · exact div_nonneg (by linarith) hden.le
    · exact (div_le_one hden).mpr (by linarith)

/-! ## The universal free boundary -/

/-- The free-interval Livšic carrier reached at the far-negative projective shift end. -/
def suzukiFreeLivsic (a : ℝ) (z : ℂ) : ℂ :=
  (((Real.exp (-2 * a) : ℝ) : ℂ) - Complex.exp (2 * I * (a : ℂ) * z)) /
    (1 - ((Real.exp (-2 * a) : ℝ) : ℂ) * Complex.exp (2 * I * (a : ℂ) * z))

/-- The oscillatory free channel has exact exponential decay controlled by the imaginary height. -/
theorem norm_suzukiFreeOscillator (a : ℝ) (z : ℂ) :
    ‖Complex.exp (2 * I * (a : ℂ) * z)‖ = Real.exp (-2 * a * z.im) := by
  rw [Complex.norm_exp]
  congr 1
  norm_num [Complex.mul_re]

/-- The free carrier retains Suzuki's canonical zero at `i`. -/
theorem suzukiFreeLivsic_I_eq_zero (a : ℝ) : suzukiFreeLivsic a I = 0 := by
  have hexp : Complex.exp (2 * I * (a : ℂ) * I) = (Real.exp (-2 * a) : ℂ) := by
    calc
      Complex.exp (2 * I * (a : ℂ) * I) =
          Complex.exp (((-2 * a : ℝ) : ℂ)) := by
        congr 1
        calc
          2 * I * (a : ℂ) * I = (2 * (a : ℂ)) * (I * I) := by ring
          _ = ((-2 * a : ℝ) : ℂ) := by rw [I_mul_I]; push_cast; ring
      _ = (Real.exp (-2 * a) : ℂ) := (Complex.ofReal_exp _).symm
  simp [suzukiFreeLivsic, hexp]

/-- Exponential decay after any positive linear rescaling of the aperture. -/
theorem suzuki_exp_neg_mul_tendsto_zero {c : ℝ} (hc : 0 < c) :
    Tendsto (fun a : ℝ => Real.exp (-c * a)) atTop (𝓝 0) := by
  have hscale : Tendsto (fun a : ℝ => c * a) atTop atTop :=
    (tendsto_const_mul_atTop_of_pos hc).mpr tendsto_id
  simpa only [neg_mul] using Real.tendsto_exp_neg_atTop_nhds_zero.comp hscale

/-- A uniform majorant for the free carrier on a positive upper strip. -/
theorem norm_suzukiFreeLivsic_le
    {a η : ℝ} {z : ℂ} (ha : 0 ≤ a) (hz : η ≤ z.im)
    (hhalf : Real.exp (-2 * a) * Real.exp (-2 * a * η) ≤ 1 / 2) :
    ‖suzukiFreeLivsic a z‖ ≤
      2 * (Real.exp (-2 * a) + Real.exp (-2 * a * η)) := by
  let q : ℂ := (Real.exp (-2 * a) : ℝ)
  let b : ℂ := Complex.exp (2 * I * (a : ℂ) * z)
  have hq : ‖q‖ = Real.exp (-2 * a) := by
    dsimp [q]
    rw [Complex.norm_real, Real.norm_of_nonneg (Real.exp_pos _).le]
  have hb : ‖b‖ ≤ Real.exp (-2 * a * η) := by
    dsimp [b]
    rw [norm_suzukiFreeOscillator]
    apply Real.exp_monotone
    nlinarith
  have hqb : ‖q * b‖ ≤ Real.exp (-2 * a) * Real.exp (-2 * a * η) := by
    rw [norm_mul, hq]
    exact mul_le_mul_of_nonneg_left hb (Real.exp_pos _).le
  have hden : (1 : ℝ) / 2 ≤ ‖1 - q * b‖ := by
    calc
      (1 : ℝ) / 2 ≤ 1 - ‖q * b‖ := by linarith
      _ ≤ ‖1 - q * b‖ := by simpa using norm_sub_norm_le (1 : ℂ) (q * b)
  have hdenpos : 0 < ‖1 - q * b‖ := lt_of_lt_of_le (by norm_num) hden
  have hnum : ‖q - b‖ ≤ Real.exp (-2 * a) + Real.exp (-2 * a * η) := by
    exact (norm_sub_le q b).trans (add_le_add hq.le hb)
  have hmajor : 0 ≤ Real.exp (-2 * a) + Real.exp (-2 * a * η) := by positivity
  change ‖(q - b) / (1 - q * b)‖ ≤ _
  rw [norm_div]
  apply (div_le_iff₀ hdenpos).mpr
  nlinarith

/-- On every positive upper strip, the universal free carriers converge uniformly to zero. -/
theorem suzukiFreeLivsic_tendstoUniformlyOn_upperStrip {η : ℝ} (hη : 0 < η) :
    TendstoUniformlyOn (fun a : ℝ => suzukiFreeLivsic a) (fun _ => 0) atTop
      {z : ℂ | η < z.im} := by
  change TendstoUniformlyOn (fun a : ℝ => suzukiFreeLivsic a) (0 : ℂ → ℂ) atTop
    {z : ℂ | η < z.im}
  rw [SeminormedAddGroup.tendstoUniformlyOn_zero]
  intro ε hε
  have hq : Tendsto (fun a : ℝ => Real.exp (-2 * a)) atTop (𝓝 0) := by
    simpa using suzuki_exp_neg_mul_tendsto_zero (c := (2 : ℝ)) (by norm_num)
  have hηdecay : Tendsto (fun a : ℝ => Real.exp (-(2 * η) * a)) atTop (𝓝 0) :=
    suzuki_exp_neg_mul_tendsto_zero (mul_pos (by norm_num) hη)
  have hηdecay' : Tendsto (fun a : ℝ => Real.exp (-2 * a * η)) atTop (𝓝 0) := by
    have hfun : (fun a : ℝ => Real.exp (-2 * a * η)) =
        fun a : ℝ => Real.exp (-(2 * η) * a) := by
      funext a
      congr 1
      ring
    rw [hfun]
    exact hηdecay
  have hproduct : Tendsto
      (fun a : ℝ => Real.exp (-2 * a) * Real.exp (-2 * a * η)) atTop (𝓝 0) := by
    simpa using hq.mul hηdecay'
  have hmajor : Tendsto
      (fun a : ℝ => 2 * (Real.exp (-2 * a) + Real.exp (-2 * a * η))) atTop (𝓝 0) := by
    simpa using (hq.add hηdecay').const_mul 2
  have hhalf := hproduct.eventually (eventually_le_nhds (by norm_num : (0 : ℝ) < 1 / 2))
  have hsmall := hmajor.eventually (eventually_lt_nhds hε)
  filter_upwards [eventually_ge_atTop (0 : ℝ), hhalf, hsmall] with a ha hprod hmaj
  intro z hz
  exact lt_of_le_of_lt
    (norm_suzukiFreeLivsic_le ha hz.le hprod) hmaj

/-- **Universal free-boundary theorem.**  The far-negative finite-aperture representatives
converge to the zero Schur carrier locally uniformly on the whole upper half-plane. -/
theorem suzukiFreeLivsic_tendstoLocallyUniformlyOn :
    TendstoLocallyUniformlyOn (fun a : ℝ => suzukiFreeLivsic a) (fun _ => 0) atTop
      {z : ℂ | 0 < z.im} := by
  apply tendstoLocallyUniformlyOn_of_forall_exists_nhds
  intro z hz
  change 0 < z.im at hz
  let η : ℝ := z.im / 2
  let t : Set ℂ := {w | η < w.im}
  have hη : 0 < η := half_pos hz
  have htOpen : IsOpen t := isOpen_lt continuous_const Complex.continuous_im
  have hzt : z ∈ t := by
    change z.im / 2 < z.im
    linarith
  refine ⟨t, Filter.Eventually.filter_mono nhdsWithin_le_nhds
    (htOpen.mem_nhds hzt), ?_⟩
  exact suzukiFreeLivsic_tendstoUniformlyOn_upperStrip hη

/-! ## The unconditional ground-centered chart -/

/-- Shift a lower spectral floor by a fixed positive gap. -/
def suzukiGroundCenteredShift (spectralFloor τ : ℝ) : ℝ :=
  spectralFloor - τ

/-- Every positive ground gap gives an admissible shift below the spectral floor. -/
theorem suzukiGroundCenteredShift_lt {spectralFloor τ : ℝ} (hτ : 0 < τ) :
    suzukiGroundCenteredShift spectralFloor τ < spectralFloor := by
  exact sub_lt_self spectralFloor hτ

/-- The shifted operator's lower edge is exactly the prescribed ground gap. -/
theorem suzukiGroundCenteredShift_gap (spectralFloor τ : ℝ) :
    spectralFloor - suzukiGroundCenteredShift spectralFloor τ = τ := by
  simp [suzukiGroundCenteredShift]

end GaloisForLFunctions.RHTower
