import GaloisForLFunctions.RHTower.RoutePDepthBinomialXiGraphCollapse
import GaloisForLFunctions.RHTower.RoutePPrimitiveDepthParabolicGraphObstruction

/-!
# A nonzero physical boundary in the closure of the primitive Xi source relation

Rescaling even binomial depth packets preserves their strong Xi-jet convergence to zero,
while their literal matched parabolic second moments converge to a strictly positive value.
The linear relation generated by primitive jet/moment pairs therefore has a nonzero vertical
vector in its closure. Even a closed partial linear recovery relation cannot contain these
source pairs and remain single-valued. The explicit graph limit is the surviving source
boundary datum. The complete matched-minus-quantile signed current remains a separate problem.
-/

open Complex Set Filter Topology
open scoped BigOperators

namespace RHTower
noncomputable section

def routePDepthEvenScale (p : Nat.Primes) (N : ℕ) : ℂ :=
  ((p : ℂ) - 1)⁻¹ ^ (2 * N)

def routePDepthNormalizedXiJet (p : Nat.Primes) (e N : ℕ) : DeningerArithmeticJetHilbert :=
  routePDepthEvenScale p N • routePDepthBinomialXiJet p e (2 * N)

def routePDepthSecondBoundary (p : Nat.Primes) (e : ℕ) : ℝ :=
  2 * (p : ℝ) ^ (e + 1) * criticalMellinAtomWeight (xiGammaEulerValuationNat (p, e))

theorem routePDepthSecondBoundary_pos (p : Nat.Primes) (e : ℕ) :
    0 < routePDepthSecondBoundary p e := by
  have hp : (0 : ℝ) < p := by exact_mod_cast p.property.pos
  have hw : 0 < criticalMellinAtomWeight (xiGammaEulerValuationNat (p, e)) := by
    rw [criticalMellinAtomWeight_eq_div_sqrt, xiGammaEulerValuationNat,
      vonMangoldt_prime_pow_succ_eq_log (p, e)]
    exact div_pos (Real.log_pos (by exact_mod_cast p.property.one_lt))
      (Real.sqrt_pos.mpr (by exact_mod_cast pow_pos p.property.pos (e + 1)))
  dsimp [routePDepthSecondBoundary]
  positivity

theorem routePDepthEvenScale_norm_le_one (p : Nat.Primes) (N : ℕ) :
    ‖routePDepthEvenScale p N‖ ≤ 1 := by
  have hp : (2 : ℝ) ≤ p := by exact_mod_cast p.property.two_le
  have hnorm : ‖(p : ℂ) - 1‖ = (p : ℝ) - 1 := by
    calc
      _ = ‖(((p : ℝ) - 1 : ℝ) : ℂ)‖ := by congr 1; push_cast; rfl
      _ = |(p : ℝ) - 1| := by rw [Complex.norm_real, Real.norm_eq_abs]
      _ = _ := abs_of_nonneg (by linarith)
  rw [routePDepthEvenScale, norm_pow, norm_inv, hnorm]
  exact pow_le_one₀ (inv_nonneg.mpr (by linarith))
    ((inv_le_one₀ (by linarith : 0 < (p : ℝ) - 1)).mpr (by linarith))

private theorem even_atTop : Tendsto (fun N : ℕ => 2 * N) atTop atTop := by
  apply tendsto_atTop.mpr
  intro B
  exact eventually_atTop.mpr ⟨B, by omega⟩

theorem tendsto_routePDepthNormalizedXiJet (p : Nat.Primes) (e : ℕ) :
    Tendsto (routePDepthNormalizedXiJet p e) atTop (nhds 0) := by
  rw [tendsto_iff_norm_sub_tendsto_zero]
  simp only [sub_zero]
  have h := ((tendsto_routePDepthBinomialXiJet p e).comp even_atTop).norm
  simp only [norm_zero] at h
  refine squeeze_zero (fun N => norm_nonneg _) (fun N => ?_) h
  rw [routePDepthNormalizedXiJet, norm_smul]
  exact mul_le_of_le_one_left (norm_nonneg _) (routePDepthEvenScale_norm_le_one p N)

/-- Exact rescaling retains a nonzero source coordinate while the Xi jet disappears. -/
theorem routePDepthEvenScale_mul_matchedSecondMoment (p : Nat.Primes) (e N : ℕ) :
    routePDepthEvenScale p N * routePDepthBinomialMatchedSecondMoment p e (2 * N) =
      (routePDepthSecondBoundary p e +
        criticalMellinAtomWeight (xiGammaEulerValuationNat (p, e)) ^ 3 / 6 *
          ((p : ℝ)⁻¹) ^ (2 * N) : ℝ) := by
  have hp0 : (p : ℂ) ≠ 0 := by exact_mod_cast p.property.ne_zero
  have hp1 : (p : ℂ) - 1 ≠ 0 := by
    have h : (p : ℂ) ≠ 1 := by exact_mod_cast p.property.ne_one
    exact sub_ne_zero.mpr h
  have hmain : ((p : ℂ) - 1)⁻¹ ^ (2 * N) * (1 - (p : ℂ)) ^ (2 * N) = 1 := by
    rw [← mul_pow, show ((p : ℂ) - 1)⁻¹ * (1 - (p : ℂ)) = -1 by field_simp [hp1]; ring]
    rw [pow_mul]
    norm_num
  have htail : ((p : ℂ) - 1)⁻¹ ^ (2 * N) * (1 - (p : ℂ)⁻¹) ^ (2 * N) =
      ((p : ℂ)⁻¹) ^ (2 * N) := by
    rw [← mul_pow]
    congr 1
    field_simp [hp0, hp1]
  rw [routePDepthEvenScale, routePDepthBinomialMatchedSecondMoment_eq]
  push_cast
  dsimp [routePDepthSecondBoundary]
  push_cast
  linear_combination
    (2 * (p : ℂ) ^ (e + 1) *
      (criticalMellinAtomWeight (xiGammaEulerValuationNat (p, e)) : ℂ)) * hmain +
    ((criticalMellinAtomWeight (xiGammaEulerValuationNat (p, e)) : ℂ) ^ 3 / 6) * htail

theorem tendsto_routePDepthNormalizedSecondMoment (p : Nat.Primes) (e : ℕ) :
    Tendsto (fun N => routePDepthEvenScale p N *
      routePDepthBinomialMatchedSecondMoment p e (2 * N)) atTop
      (nhds (routePDepthSecondBoundary p e : ℂ)) := by
  have hp : (1 : ℝ) < p := by exact_mod_cast p.property.one_lt
  have hx := (tendsto_pow_atTop_nhds_zero_of_lt_one
    (inv_nonneg.mpr (by linarith : (0 : ℝ) ≤ p))
    ((inv_lt_one₀ (by linarith : (0 : ℝ) < p)).mpr hp)).comp even_atTop
  have ht : Tendsto (fun N => routePDepthSecondBoundary p e +
      criticalMellinAtomWeight (xiGammaEulerValuationNat (p, e)) ^ 3 / 6 *
        ((p : ℝ)⁻¹) ^ (2 * N)) atTop (nhds (routePDepthSecondBoundary p e)) := by
    simpa using (hx.const_mul
      (criticalMellinAtomWeight (xiGammaEulerValuationNat (p, e)) ^ 3 / 6)).const_add
        (routePDepthSecondBoundary p e)
  simp_rw [routePDepthEvenScale_mul_matchedSecondMoment]
  exact (Complex.continuous_ofReal.tendsto _).comp ht

/-- Linear relation generated by the literal primitive jet/matched-moment pairs. -/
def routePDepthMatchedSecondGraph (p : Nat.Primes) (e : ℕ) :
    Submodule ℂ (DeningerArithmeticJetHilbert × ℂ) :=
  Submodule.span ℂ (Set.range fun j : ℕ =>
    (routePDeningerUpperSquaredCauchyJet
      (-finiteVonMangoldtDepthOneAmplitude (xiGammaEulerValuationNat (p, e + j)))
      (routePPrimitiveDeningerUpperPoint (p, e + j) 0),
      (ccmActualHeadMatchedParabolicMoment (xiGammaEulerValuationNat (p, e + j)) 2 : ℂ)))

private theorem packet_pair_mem (p : Nat.Primes) (e N : ℕ) :
    (routePDepthBinomialXiJet p e N, routePDepthBinomialMatchedSecondMoment p e N) ∈
      routePDepthMatchedSecondGraph p e := by
  classical
  have h := Submodule.sum_mem (routePDepthMatchedSecondGraph p e)
    (fun j (_hj : j ∈ Finset.range (N + 1)) =>
      Submodule.smul_mem (routePDepthMatchedSecondGraph p e)
        (routePDepthBinomialCoefficient p e N j)
        (Submodule.subset_span (Set.mem_range_self j)))
  convert h using 1
  apply Prod.ext <;>
    simp [routePDepthBinomialXiJet, routePDepthBinomialMatchedSecondMoment,
      Prod.fst_sum, Prod.snd_sum]

/-- The source relation has a nonzero vertical limit in the actual Xi Hilbert topology. -/
theorem routePDepthSecondBoundary_mem_graphClosure (p : Nat.Primes) (e : ℕ) :
    (0, (routePDepthSecondBoundary p e : ℂ)) ∈
      closure (routePDepthMatchedSecondGraph p e : Set (DeningerArithmeticJetHilbert × ℂ)) := by
  apply mem_closure_of_tendsto
    ((tendsto_routePDepthNormalizedXiJet p e).prodMk_nhds
      (tendsto_routePDepthNormalizedSecondMoment p e))
  apply Eventually.of_forall
  intro N
  exact (routePDepthMatchedSecondGraph p e).smul_mem (routePDepthEvenScale p N)
    (packet_pair_mem p e (2 * N))

/-- No closed single-valued linear relation on the Xi carrier can retain these literal source
pairs. This obstructs closed recovery of the matched moment, not the full signed current. -/
theorem not_routePDepthMatchedSecond_closedRecovery (p : Nat.Primes) (e : ℕ) :
    ¬ ∃ G : Submodule ℂ (DeningerArithmeticJetHilbert × ℂ),
      IsClosed (G : Set (DeningerArithmeticJetHilbert × ℂ)) ∧
      routePDepthMatchedSecondGraph p e ≤ G ∧
      ∀ c : ℂ, (0, c) ∈ G → c = 0 := by
  rintro ⟨G, hclosed, hcontains, hsingle⟩
  have hmem := (closure_minimal hcontains hclosed)
    (routePDepthSecondBoundary_mem_graphClosure p e)
  have hz := hsingle _ hmem
  have hzR : routePDepthSecondBoundary p e = 0 := by exact_mod_cast hz
  exact (ne_of_gt (routePDepthSecondBoundary_pos p e)) hzR

end
end RHTower
