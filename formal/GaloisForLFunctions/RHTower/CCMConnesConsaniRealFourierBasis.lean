import GaloisForLFunctions.HTGeometry.FourierCircleTruncation
import GaloisForLFunctions.RHTower.CCMConnesConsaniPolarizeTwo

/-!
# Exact real Fourier basis in Connes--Consani `polarize2`

This module proves the basis clause omitted from the correlation-table formalization.
We work on the additive circle of arbitrary positive length `T` with probability Haar
measure.  This is the unitary normalization of the paper's Lebesgue model: multiplying
the paper modes of amplitudes `T⁻¹/²` and `(2/T)¹/²` by `T¹/²` gives the modes below.

The parity factors `(-1)^n` are retained.  They encode the paper's centered interval
`[-T/2,T/2]`, rather than choosing a phase-free Fourier basis.  The main theorem proves
both claims needed for “basis”: exact orthonormality and equality of its span with the
literal Laurent section generated by frequencies `|k| ≤ N`.
-/

open MeasureTheory Set

noncomputable section

namespace RHTower

abbrev CCMCircleL2 (T : ℝ) [Fact (0 < T)] :=
  Lp ℂ 2 (AddCircle.haarAddCircle (T := T))

abbrev CCMRealFourierIndex (N : ℕ) := Option (Fin N ⊕ Fin N)

def ccmPositiveFrequency {N : ℕ} (n : Fin N) : ℤ := (n.1 + 1 : ℕ)

def ccmRealFourierScale (n : ℕ) : ℂ :=
  (((-1 : ℝ) ^ n : ℝ) : ℂ) * ((Real.sqrt 2 : ℝ) : ℂ)⁻¹

@[simp] theorem star_ccmRealFourierScale (n : ℕ) :
    (starRingEnd ℂ) (ccmRealFourierScale n) = ccmRealFourierScale n := by
  simp [ccmRealFourierScale]

theorem ccmRealFourierScale_sq (n : ℕ) :
    ccmRealFourierScale n * ccmRealFourierScale n = (1 / 2 : ℂ) := by
  have hsqrt : Real.sqrt 2 * Real.sqrt 2 = 2 :=
    Real.mul_self_sqrt (by norm_num)
  have hsqrtC : ((Real.sqrt 2 : ℝ) : ℂ) * (Real.sqrt 2 : ℝ) = 2 := by
    exact_mod_cast hsqrt
  have hsqrt_ne : (Real.sqrt 2 : ℝ) ≠ 0 :=
    ne_of_gt (Real.sqrt_pos.2 (by norm_num))
  rcases neg_one_pow_eq_or ℝ n with hn | hn <;>
    rw [ccmRealFourierScale, hn] <;>
    norm_num only [Complex.ofReal_one, one_mul, Complex.ofReal_neg,
      Complex.ofReal_one, neg_mul] <;>
    field_simp <;> simpa only [pow_two] using hsqrtC.symm

def ccmCircleCosineMode (T : ℝ) [Fact (0 < T)] {N : ℕ}
    (n : Fin N) : CCMCircleL2 T :=
  ccmRealFourierScale (n.1 + 1) •
    (fourierLp 2 (ccmPositiveFrequency n) +
      fourierLp 2 (-ccmPositiveFrequency n))

def ccmCircleNegativeSineMode (T : ℝ) [Fact (0 < T)] {N : ℕ}
    (n : Fin N) : CCMCircleL2 T :=
  (ccmRealFourierScale (n.1 + 1) * Complex.I) •
    (fourierLp 2 (ccmPositiveFrequency n) -
      fourierLp 2 (-ccmPositiveFrequency n))

def ccmCircleRealFourierMode (T : ℝ) [Fact (0 < T)] {N : ℕ} :
    CCMRealFourierIndex N → CCMCircleL2 T
  | none => fourierLp 2 0
  | some (Sum.inl n) => ccmCircleCosineMode T n
  | some (Sum.inr n) => ccmCircleNegativeSineMode T n

theorem ccm_inner_fourierLp_fourierLp
    {T : ℝ} [Fact (0 < T)] (l j : ℤ) :
    (inner ℂ (fourierLp (T := T) 2 l) (fourierLp (T := T) 2 j) : ℂ) =
      if l = j then 1 else 0 := by
  rw [← coe_fourierBasis]
  rcases eq_or_ne l j with h | h
  · subst h
    rw [if_pos rfl]
    have hn := (fourierBasis (T := T)).orthonormal.1 l
    rw [inner_self_eq_norm_sq_to_K, hn]
    norm_num
  · rw [if_neg h]
    exact (fourierBasis (T := T)).orthonormal.2 h

private theorem ccmPositiveFrequency_injective {N : ℕ} {n m : Fin N}
    (h : ccmPositiveFrequency n = ccmPositiveFrequency m) : n = m := by
  apply Fin.ext
  simp only [ccmPositiveFrequency, Int.ofNat_inj] at h
  omega

private theorem ccmPositiveFrequency_ne_zero {N : ℕ} (n : Fin N) :
    ccmPositiveFrequency n ≠ 0 := by
  change ((n.1 + 1 : ℕ) : ℤ) ≠ 0
  omega

private theorem ccmPositiveFrequency_ne_neg {N : ℕ} (n m : Fin N) :
    ccmPositiveFrequency n ≠ -ccmPositiveFrequency m := by
  have hn : 0 < ccmPositiveFrequency n := by
    change (0 : ℤ) < ((n.1 + 1 : ℕ) : ℤ)
    omega
  have hm : 0 < ccmPositiveFrequency m := by
    change (0 : ℤ) < ((m.1 + 1 : ℕ) : ℤ)
    omega
  linarith

private theorem ccmPositiveFrequency_eq_iff {N : ℕ} (n m : Fin N) :
    ccmPositiveFrequency n = ccmPositiveFrequency m ↔ n = m := by
  exact ⟨ccmPositiveFrequency_injective, congrArg ccmPositiveFrequency⟩

private theorem inner_ccmCircleCosineMode
    (T : ℝ) [Fact (0 < T)] {N : ℕ} (n m : Fin N) :
    inner ℂ (ccmCircleCosineMode T n) (ccmCircleCosineMode T m) =
      if n = m then 1 else 0 := by
  rw [ccmCircleCosineMode, ccmCircleCosineMode, inner_smul_left,
    inner_smul_right, inner_add_left, inner_add_right,
    inner_add_right, ccm_inner_fourierLp_fourierLp,
    ccm_inner_fourierLp_fourierLp, ccm_inner_fourierLp_fourierLp,
    ccm_inner_fourierLp_fourierLp, star_ccmRealFourierScale]
  by_cases hnm : n = m
  · subst m
    rw [if_pos rfl, if_pos rfl,
      if_neg (ccmPositiveFrequency_ne_neg n n),
      if_neg (fun h => ccmPositiveFrequency_ne_neg n n h.symm), if_pos rfl,
      ← mul_assoc, ccmRealFourierScale_sq]
    norm_num
  · have hf : ccmPositiveFrequency n ≠ ccmPositiveFrequency m :=
      fun h => hnm (ccmPositiveFrequency_injective h)
    have hnn : -ccmPositiveFrequency n ≠ -ccmPositiveFrequency m :=
      fun h => hf (neg_injective h)
    rw [if_neg hnm, if_neg hf,
      if_neg (ccmPositiveFrequency_ne_neg n m),
      if_neg (fun h => ccmPositiveFrequency_ne_neg m n h.symm), if_neg hnn]
    ring

private theorem inner_ccmCircleCosineNegativeSineMode
    (T : ℝ) [Fact (0 < T)] {N : ℕ} (n m : Fin N) :
    inner ℂ (ccmCircleCosineMode T n) (ccmCircleNegativeSineMode T m) = 0 := by
  rw [ccmCircleCosineMode, ccmCircleNegativeSineMode, inner_smul_left,
    inner_smul_right, inner_add_left, inner_sub_right,
    inner_sub_right, ccm_inner_fourierLp_fourierLp,
    ccm_inner_fourierLp_fourierLp, ccm_inner_fourierLp_fourierLp,
    ccm_inner_fourierLp_fourierLp, star_ccmRealFourierScale]
  by_cases hnm : n = m
  · subst m
    rw [if_pos rfl, if_neg (ccmPositiveFrequency_ne_neg n n),
      if_neg (fun h => ccmPositiveFrequency_ne_neg n n h.symm), if_pos rfl]
    ring
  · have hf : ccmPositiveFrequency n ≠ ccmPositiveFrequency m :=
      fun h => hnm (ccmPositiveFrequency_injective h)
    have hnn : -ccmPositiveFrequency n ≠ -ccmPositiveFrequency m :=
      fun h => hf (neg_injective h)
    rw [if_neg hf, if_neg (ccmPositiveFrequency_ne_neg n m),
      if_neg (fun h => ccmPositiveFrequency_ne_neg m n h.symm), if_neg hnn]
    ring

private theorem inner_ccmCircleNegativeSineCosineMode
    (T : ℝ) [Fact (0 < T)] {N : ℕ} (n m : Fin N) :
    inner ℂ (ccmCircleNegativeSineMode T n) (ccmCircleCosineMode T m) = 0 := by
  rw [← inner_conj_symm]
  rw [inner_ccmCircleCosineNegativeSineMode]
  simp

private theorem inner_ccmCircleNegativeSineMode
    (T : ℝ) [Fact (0 < T)] {N : ℕ} (n m : Fin N) :
    inner ℂ (ccmCircleNegativeSineMode T n) (ccmCircleNegativeSineMode T m) =
      if n = m then 1 else 0 := by
  rw [ccmCircleNegativeSineMode, ccmCircleNegativeSineMode, inner_smul_left,
    inner_smul_right, inner_sub_left, inner_sub_right,
    inner_sub_right, ccm_inner_fourierLp_fourierLp,
    ccm_inner_fourierLp_fourierLp, ccm_inner_fourierLp_fourierLp,
    ccm_inner_fourierLp_fourierLp, map_mul, star_ccmRealFourierScale,
    Complex.conj_I]
  by_cases hnm : n = m
  · subst m
    rw [if_pos rfl, if_neg (ccmPositiveFrequency_ne_neg n n),
      if_neg (fun h => ccmPositiveFrequency_ne_neg n n h.symm), if_pos rfl]
    norm_num
    calc
      -(ccmRealFourierScale (↑n + 1) * Complex.I *
          (ccmRealFourierScale (↑n + 1) * Complex.I * 2)) =
          (ccmRealFourierScale (↑n + 1) * ccmRealFourierScale (↑n + 1)) * 2 := by
            rw [show ccmRealFourierScale (↑n + 1) * Complex.I *
                (ccmRealFourierScale (↑n + 1) * Complex.I * 2) =
                (ccmRealFourierScale (↑n + 1) * ccmRealFourierScale (↑n + 1)) *
                  (Complex.I * Complex.I) * 2 by ring,
              Complex.I_mul_I]
            ring
      _ = 1 := by rw [ccmRealFourierScale_sq]; norm_num
  · have hf : ccmPositiveFrequency n ≠ ccmPositiveFrequency m :=
      fun h => hnm (ccmPositiveFrequency_injective h)
    have hnn : -ccmPositiveFrequency n ≠ -ccmPositiveFrequency m :=
      fun h => hf (neg_injective h)
    rw [if_neg hnm, if_neg hf,
      if_neg (ccmPositiveFrequency_ne_neg n m),
      if_neg (fun h => ccmPositiveFrequency_ne_neg m n h.symm), if_neg hnn]
    ring

private theorem inner_fourierZero_ccmCircleCosineMode
    (T : ℝ) [Fact (0 < T)] {N : ℕ} (n : Fin N) :
    inner ℂ (fourierLp (T := T) 2 0) (ccmCircleCosineMode T n) = 0 := by
  rw [ccmCircleCosineMode, inner_smul_right, inner_add_right,
    ccm_inner_fourierLp_fourierLp, ccm_inner_fourierLp_fourierLp,
    if_neg (ccmPositiveFrequency_ne_zero n).symm,
    if_neg (neg_ne_zero.mpr (ccmPositiveFrequency_ne_zero n)).symm]
  ring

private theorem inner_fourierZero_ccmCircleNegativeSineMode
    (T : ℝ) [Fact (0 < T)] {N : ℕ} (n : Fin N) :
    inner ℂ (fourierLp (T := T) 2 0) (ccmCircleNegativeSineMode T n) = 0 := by
  rw [ccmCircleNegativeSineMode, inner_smul_right, inner_sub_right,
    ccm_inner_fourierLp_fourierLp, ccm_inner_fourierLp_fourierLp,
    if_neg (ccmPositiveFrequency_ne_zero n).symm,
    if_neg (neg_ne_zero.mpr (ccmPositiveFrequency_ne_zero n)).symm]
  ring

private theorem inner_ccmCircleCosineMode_fourierZero
    (T : ℝ) [Fact (0 < T)] {N : ℕ} (n : Fin N) :
    inner ℂ (ccmCircleCosineMode T n) (fourierLp (T := T) 2 0) = 0 := by
  rw [← inner_conj_symm, inner_fourierZero_ccmCircleCosineMode]
  simp

private theorem inner_ccmCircleNegativeSineMode_fourierZero
    (T : ℝ) [Fact (0 < T)] {N : ℕ} (n : Fin N) :
    inner ℂ (ccmCircleNegativeSineMode T n) (fourierLp (T := T) 2 0) = 0 := by
  rw [← inner_conj_symm, inner_fourierZero_ccmCircleNegativeSineMode]
  simp

theorem orthonormal_ccmCircleRealFourierMode
    (T : ℝ) [Fact (0 < T)] (N : ℕ) :
    Orthonormal ℂ (ccmCircleRealFourierMode T (N := N)) := by
  rw [orthonormal_iff_ite]
  intro i j
  rcases i with _ | i
  · rcases j with _ | j
    · rw [ccmCircleRealFourierMode, ccm_inner_fourierLp_fourierLp, if_pos rfl]
      simp
    · rcases j with j | j
      · simpa only [ccmCircleRealFourierMode, reduceCtorEq, ↓reduceIte] using
          (inner_fourierZero_ccmCircleCosineMode T j)
      · simpa only [ccmCircleRealFourierMode, reduceCtorEq, ↓reduceIte] using
          (inner_fourierZero_ccmCircleNegativeSineMode T j)
  · rcases i with i | i
    · rcases j with _ | j
      · simpa only [ccmCircleRealFourierMode, reduceCtorEq, ↓reduceIte] using
          (inner_ccmCircleCosineMode_fourierZero T i)
      · rcases j with j | j
        · simpa only [ccmCircleRealFourierMode, Option.some.injEq,
            Sum.inl.injEq] using inner_ccmCircleCosineMode T i j
        · simpa [ccmCircleRealFourierMode] using
            inner_ccmCircleCosineNegativeSineMode T i j
    · rcases j with _ | j
      · simpa only [ccmCircleRealFourierMode, reduceCtorEq, ↓reduceIte] using
          (inner_ccmCircleNegativeSineMode_fourierZero T i)
      · rcases j with j | j
        · simpa [ccmCircleRealFourierMode] using
            inner_ccmCircleNegativeSineCosineMode T i j
        · simpa only [ccmCircleRealFourierMode, Option.some.injEq,
            Sum.inr.injEq] using inner_ccmCircleNegativeSineMode T i j

/-! ## Exact equality with the Laurent section -/

def ccmCircleLaurentSection (T : ℝ) [Fact (0 < T)] (N : ℕ) :
    Submodule ℂ (CCMCircleL2 T) :=
  Submodule.span ℂ
    ((fun k : ℤ => fourierLp (T := T) 2 k) '' {k : ℤ | k.natAbs ≤ N})

private theorem ccmPositiveFrequency_natAbs_le {N : ℕ} (n : Fin N) :
    (ccmPositiveFrequency n).natAbs ≤ N := by
  change n.1 + 1 ≤ N
  omega

private theorem ccmNegativePositiveFrequency_natAbs_le {N : ℕ} (n : Fin N) :
    (-ccmPositiveFrequency n).natAbs ≤ N := by
  rw [Int.natAbs_neg]
  exact ccmPositiveFrequency_natAbs_le n

private theorem ccmCircleRealFourierMode_mem_laurentSection
    (T : ℝ) [Fact (0 < T)] (N : ℕ) (j : CCMRealFourierIndex N) :
    ccmCircleRealFourierMode T j ∈ ccmCircleLaurentSection T N := by
  rw [ccmCircleLaurentSection]
  rcases j with _ | j
  · exact Submodule.subset_span ⟨0, by simp, rfl⟩
  · rcases j with n | n
    · rw [ccmCircleRealFourierMode, ccmCircleCosineMode]
      exact Submodule.smul_mem _ _
        (Submodule.add_mem _
          (Submodule.subset_span ⟨ccmPositiveFrequency n,
            ccmPositiveFrequency_natAbs_le n, rfl⟩)
          (Submodule.subset_span ⟨-ccmPositiveFrequency n,
            ccmNegativePositiveFrequency_natAbs_le n, rfl⟩))
    · rw [ccmCircleRealFourierMode, ccmCircleNegativeSineMode]
      exact Submodule.smul_mem _ _
        (Submodule.sub_mem _
          (Submodule.subset_span ⟨ccmPositiveFrequency n,
            ccmPositiveFrequency_natAbs_le n, rfl⟩)
          (Submodule.subset_span ⟨-ccmPositiveFrequency n,
            ccmNegativePositiveFrequency_natAbs_le n, rfl⟩))

private theorem scale_mul_I_mul_scale_mul_I (n : ℕ) :
    (ccmRealFourierScale n * Complex.I) *
        (ccmRealFourierScale n * Complex.I) = -(1 / 2 : ℂ) := by
  calc
    (ccmRealFourierScale n * Complex.I) *
          (ccmRealFourierScale n * Complex.I) =
        (ccmRealFourierScale n * ccmRealFourierScale n) *
          (Complex.I * Complex.I) := by ring
    _ = -(1 / 2 : ℂ) := by rw [ccmRealFourierScale_sq, Complex.I_mul_I]; ring

private theorem neg_scale_mul_I_mul_scale_mul_I (n : ℕ) :
    (-(ccmRealFourierScale n * Complex.I)) *
        (ccmRealFourierScale n * Complex.I) = (1 / 2 : ℂ) := by
  rw [neg_mul, scale_mul_I_mul_scale_mul_I]
  ring

private theorem fourierLp_positive_eq_real_modes
    (T : ℝ) [Fact (0 < T)] {N : ℕ} (n : Fin N) :
    (fourierLp (T := T) 2 (ccmPositiveFrequency n) : CCMCircleL2 T) =
      ccmRealFourierScale (n.1 + 1) • ccmCircleCosineMode T n +
        (-(ccmRealFourierScale (n.1 + 1) * Complex.I)) •
          ccmCircleNegativeSineMode T n := by
  rw [ccmCircleCosineMode, ccmCircleNegativeSineMode]
  simp only [smul_add, smul_sub, smul_smul]
  rw [ccmRealFourierScale_sq, neg_scale_mul_I_mul_scale_mul_I]
  module

private theorem fourierLp_negative_eq_real_modes
    (T : ℝ) [Fact (0 < T)] {N : ℕ} (n : Fin N) :
    (fourierLp (T := T) 2 (-ccmPositiveFrequency n) : CCMCircleL2 T) =
      ccmRealFourierScale (n.1 + 1) • ccmCircleCosineMode T n +
        (ccmRealFourierScale (n.1 + 1) * Complex.I) •
          ccmCircleNegativeSineMode T n := by
  rw [ccmCircleCosineMode, ccmCircleNegativeSineMode]
  simp only [smul_add, smul_sub, smul_smul]
  rw [ccmRealFourierScale_sq, scale_mul_I_mul_scale_mul_I]
  module

theorem span_ccmCircleRealFourierMode_eq_laurentSection
    (T : ℝ) [Fact (0 < T)] (N : ℕ) :
    Submodule.span ℂ (Set.range (ccmCircleRealFourierMode T (N := N))) =
      ccmCircleLaurentSection T N := by
  apply le_antisymm
  · exact Submodule.span_le.mpr fun _ ⟨j, hj⟩ =>
      hj ▸ ccmCircleRealFourierMode_mem_laurentSection T N j
  · rw [ccmCircleLaurentSection]
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨k, hk, rfl⟩
    cases k with
    | ofNat n =>
        cases n with
        | zero =>
            exact Submodule.subset_span ⟨none, rfl⟩
        | succ n =>
            have hnN : n < N := by
              change n + 1 ≤ N at hk
              omega
            let j : Fin N := ⟨n, hnN⟩
            rw [show ((Int.ofNat (n + 1)) : ℤ) = ccmPositiveFrequency j by
              simp [ccmPositiveFrequency, j]]
            change (fourierLp (T := T) 2 (ccmPositiveFrequency j) : CCMCircleL2 T) ∈
              Submodule.span ℂ (Set.range (ccmCircleRealFourierMode T (N := N)))
            rw [fourierLp_positive_eq_real_modes T j]
            exact Submodule.add_mem _
              (Submodule.smul_mem _ _ (Submodule.subset_span ⟨some (Sum.inl j), rfl⟩))
              (Submodule.smul_mem _ _ (Submodule.subset_span ⟨some (Sum.inr j), rfl⟩))
    | negSucc n =>
        have hnN : n < N := by
          change n + 1 ≤ N at hk
          omega
        let j : Fin N := ⟨n, hnN⟩
        rw [show (Int.negSucc n : ℤ) = -ccmPositiveFrequency j by
          simp only [ccmPositiveFrequency, j]
          omega]
        change (fourierLp (T := T) 2 (-ccmPositiveFrequency j) : CCMCircleL2 T) ∈
          Submodule.span ℂ (Set.range (ccmCircleRealFourierMode T (N := N)))
        rw [fourierLp_negative_eq_real_modes T j]
        exact Submodule.add_mem _
          (Submodule.smul_mem _ _ (Submodule.subset_span ⟨some (Sum.inl j), rfl⟩))
          (Submodule.smul_mem _ _ (Submodule.subset_span ⟨some (Sum.inr j), rfl⟩))

/-- Exact basis clause of Connes--Consani `polarize2`: the centered real modes are
orthonormal and span precisely the Laurent section `E_N`. -/
theorem connesConsani_polarize2_realBasis
    (T : ℝ) [Fact (0 < T)] (N : ℕ) :
    Orthonormal ℂ (ccmCircleRealFourierMode T (N := N)) ∧
      Submodule.span ℂ (Set.range (ccmCircleRealFourierMode T (N := N))) =
        ccmCircleLaurentSection T N :=
  ⟨orthonormal_ccmCircleRealFourierMode T N,
    span_ccmCircleRealFourierMode_eq_laurentSection T N⟩

end RHTower
