import Mathlib.Analysis.Fourier.RiemannLebesgueLemma
import Mathlib.Topology.MetricSpace.Bounded

/-!
# Vanishing at infinity is uniform outside a bounded set

On the real line the cocompact filter is generated by complements of bounded sets, so a function
tending to zero along it is uniformly small outside some radius.  Applied to a Fourier transform
this turns the Riemann--Lebesgue lemma into the uniform bound the frequency-escape estimate needs:
once the packet's carrier frequency exceeds that radius by the aperture, the whole central Fourier
band sees only values below the chosen tolerance.
-/

noncomputable section

namespace RHTower

open Filter Metric
open scoped Topology

/-- A function vanishing along the cocompact filter of `ℝ` is uniformly small outside a radius. -/
theorem exists_forall_norm_le_of_tendsto_cocompact
    {E : Type*} [NormedAddCommGroup E] {f : ℝ → E}
    (hf : Tendsto f (cocompact ℝ) (𝓝 0)) {ε : ℝ} (hε : 0 < ε) :
    ∃ R : ℝ, ∀ η : ℝ, R ≤ |η| → ‖f η‖ ≤ ε := by
  have hmem : {η : ℝ | ‖f η‖ ≤ ε} ∈ cocompact ℝ := by
    have hball : Metric.closedBall (0 : E) ε ∈ 𝓝 (0 : E) :=
      Metric.closedBall_mem_nhds _ hε
    have hpre : f ⁻¹' Metric.closedBall (0 : E) ε ∈ cocompact ℝ := hf hball
    refine Filter.mem_of_superset hpre fun η hη => ?_
    simpa [Set.mem_preimage, Metric.mem_closedBall, dist_zero_right] using hη
  obtain ⟨K, hK, hsub⟩ := mem_cocompact.mp hmem
  obtain ⟨R, hR⟩ := hK.isBounded.subset_closedBall (0 : ℝ)
  refine ⟨R + 1, fun η hη => ?_⟩
  have hnot : η ∉ K := by
    intro hmemK
    have := hR hmemK
    rw [Metric.mem_closedBall, Real.dist_eq, sub_zero] at this
    linarith
  exact hsub hnot

end RHTower
