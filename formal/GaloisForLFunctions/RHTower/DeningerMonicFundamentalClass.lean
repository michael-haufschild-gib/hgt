import GaloisForLFunctions.HTGeometry.MilnorWittCycles
import GaloisForLFunctions.RHTower.DeningerPrincipalConormal
import Mathlib.RingTheory.PrincipalIdealDomain

/-!
# The oriented fundamental class of a principal divisor

A non-zero-divisor generating a maximal ideal cuts out a closed point whose conormal module is a
one-dimensional vector space over the residue field, generated by the class of the generator.  The
Milnor--Witt fundamental class of that closed immersion is therefore an element of the twist of
`K_0^{MW}` of the residue field by the conormal line, and the unit quadratic orientation puts `⟨1⟩`
at the class of the generator.

Its rank is one for every trivialization of the twist: a different generator of the conormal line
moves the class by a unit form, and the rank does not see unit forms.  This is the forgetful
statement of the monic Milnor--Witt lift — the oriented class covers the ordinary fundamental cycle
of the regular immersion with multiplicity one.

* `deningerConormalGen` : the class of the generator, a basis of the conormal line.
* `deningerFundamentalClass` : **the oriented Milnor--Witt fundamental class.**
* `deningerFundamentalClass_rank` : **its rank is one, for every trivialization.**
* `deningerMonicFundamentalClass_rank` : the case of a monic irreducible polynomial, where the
  divisor is the closed point `Z_P ⊂ 𝔸¹`.
* `mwCyclesRank_deningerMWCycle`, `mwCyclesRank_gysin_fundamentalClass` : **the ordinary cycle
  underlying the Gysin image of the oriented fundamental class is the divisor itself, with
  multiplicity one.**
-/

namespace RHTower

open GaloisForLFunctions.HTGeometry

attribute [local instance] Ideal.Quotient.field

section ConormalLine

variable {S : Type*} [CommRing S] (P : S)

/-- The class of the generator in the conormal module. -/
noncomputable def deningerConormalGen : (Ideal.span ({P} : Set S)).Cotangent :=
  deningerConormalMap P 1

/-- **The conormal module is generated over the residue field by the class of the generator.** -/
theorem deningerConormalGen_smul (q : S) :
    (Ideal.Quotient.mk (Ideal.span ({P} : Set S)) q) • deningerConormalGen P
      = deningerConormalMap P q := by
  rw [deningerConormalGen, ← Ideal.Quotient.algebraMap_eq, algebraMap_smul, ← map_smul]
  congr 1
  rw [smul_eq_mul, mul_one]

/-- **The class of the generator spans the conormal line.** -/
theorem deningerConormalGen_span (v : (Ideal.span ({P} : Set S)).Cotangent) :
    ∃ c : S ⧸ Ideal.span ({P} : Set S), v = c • deningerConormalGen P := by
  obtain ⟨q, rfl⟩ := deningerConormalMap_surjective P v
  exact ⟨Ideal.Quotient.mk _ q, (deningerConormalGen_smul P q).symm⟩

variable [hmax : (Ideal.span ({P} : Set S)).IsMaximal]

/-- **The class of the generator is nonzero**, because the ideal is proper. -/
theorem deningerConormalGen_ne_zero (hP : IsRegular P) : deningerConormalGen P ≠ 0 := by
  intro h
  have h1 : (1 : S) ∈ LinearMap.ker (deningerConormalMap P) := h
  rw [deningerConormalMap_ker P hP] at h1
  exact hmax.ne_top ((Ideal.eq_top_iff_one _).2 h1)

/-- **The oriented Milnor--Witt fundamental class** of the divisor cut out by a regular generator
of a maximal ideal: the unit quadratic orientation placed at the class of the generator. -/
noncomputable def deningerFundamentalClass (hP : IsRegular P) :
    MWLineTwist (S ⧸ Ideal.span ({P} : Set S)) 0 (Ideal.span ({P} : Set S)).Cotangent :=
  mwFundamentalClass _ _ (deningerConormalGen P) (deningerConormalGen_ne_zero P hP)

/-- **The oriented fundamental class has rank one.**  Read through the trivialization by any basis
of the conormal line, the class differs from the unit orientation by a unit form, and unit forms
have rank one: the oriented class covers the ordinary fundamental cycle with multiplicity one. -/
theorem deningerFundamentalClass_rank (hP : IsRegular P)
    (e : (Ideal.span ({P} : Set S)).Cotangent) (he : e ≠ 0)
    (hspan : ∀ v : (Ideal.span ({P} : Set S)).Cotangent,
      ∃ c : S ⧸ Ideal.span ({P} : Set S), v = c • e) :
    mwRank (mwLineTwistEquiv e he hspan (deningerFundamentalClass P hP)) = 1 :=
  mwRank_fundamentalClass e (deningerConormalGen P) he
    (deningerConormalGen_ne_zero P hP) hspan

/-- The class built from the generator, read through its own trivialization, is the unit
orientation. -/
theorem deningerFundamentalClass_triv (hP : IsRegular P) :
    mwLineTwistEquiv (deningerConormalGen P) (deningerConormalGen_ne_zero P hP)
        (deningerConormalGen_span P) (deningerFundamentalClass P hP) = mwOne :=
  mwFundamentalClass_triv _ _ _

end ConormalLine

section Monic

variable {k : Type*} [Field k] {P : Polynomial k}

/-- An irreducible polynomial over a field generates a maximal ideal. -/
theorem deningerMonic_span_isMaximal (hirr : Irreducible P) :
    (Ideal.span ({P} : Set (Polynomial k))).IsMaximal :=
  PrincipalIdealRing.isMaximal_of_irreducible hirr

/-- **The monic Milnor--Witt lift.**  For a monic irreducible `P`, the closed point
`Z_P = Spec k[T]/(P)` of the affine line has an oriented Milnor--Witt fundamental class whose rank
is one for every trivialization of the conormal determinant line — its underlying ordinary cycle is
`[Z_P]`. -/
theorem deningerMonicFundamentalClass_rank (hmon : P.Monic)
    [(Ideal.span ({P} : Set (Polynomial k))).IsMaximal]
    (e : (Ideal.span ({P} : Set (Polynomial k))).Cotangent) (he : e ≠ 0)
    (hspan : ∀ v : (Ideal.span ({P} : Set (Polynomial k))).Cotangent,
      ∃ c : Polynomial k ⧸ Ideal.span ({P} : Set (Polynomial k)), v = c • e) :
    mwRank (mwLineTwistEquiv e he hspan
      (deningerFundamentalClass P (deningerMonic_isRegular hmon))) = 1 :=
  deningerFundamentalClass_rank P (deningerMonic_isRegular hmon) e he hspan

end Monic

section Cycle

variable {S : Type*} [CommRing S] (P : S) [hmax : (Ideal.span ({P} : Set S)).IsMaximal]

/-- The closed point cut out by a generator of a maximal ideal. -/
@[reducible] def deningerMonicClosedPoint : ClosedPoint S :=
  ⟨Ideal.span ({P} : Set S), hmax⟩

/-- **The Milnor--Witt fundamental cycle of the divisor cut out by `P`**: the oriented fundamental
class, placed at the closed point it is supported on. -/
noncomputable def deningerMWCycle (hP : IsRegular P) : MWCycles S :=
  mwCycleSingle (deningerMonicClosedPoint P) (deningerFundamentalClass P hP)

/-- **The ordinary cycle underlying the oriented fundamental class is the divisor itself, with
multiplicity one.**  No trivialization of the conormal determinant line enters: the rank is
invariant under the unit forms by which the twist is defined.  This is the card's forgetful
statement, that the Milnor--Witt Gysin fundamental class covers `[Z_P]`. -/
theorem mwCyclesRank_deningerMWCycle (hP : IsRegular P) :
    mwCyclesRank S (deningerMWCycle P hP) = cycleSingle (deningerMonicClosedPoint P) 1 := by
  rw [deningerMWCycle, mwCyclesRank_single]
  exact congrArg (cycleSingle (deningerMonicClosedPoint P))
    (mwTwistRank_fundamentalClass (deningerConormalGen P) (deningerConormalGen_ne_zero P hP))

/-- The fundamental cycle is the Gysin pushforward of the unit quadratic orientation. -/
theorem deningerMWCycle_eq_gysin (hP : IsRegular P) :
    deningerMWCycle P hP
      = mwGysin (deningerMonicClosedPoint P) (deningerFundamentalClass P hP) := rfl

/-- **The monic Milnor--Witt lift, in full.**  The Gysin pushforward along the closed immersion of
the divisor, applied to the unit quadratic orientation `⟨1⟩` sitting in the twist by the conormal
determinant line, is a Milnor--Witt cycle on the ambient space whose underlying ordinary cycle is
`[Z_P]` with multiplicity one. -/
theorem mwCyclesRank_gysin_fundamentalClass (hP : IsRegular P) :
    mwCyclesRank S (mwGysin (deningerMonicClosedPoint P) (deningerFundamentalClass P hP))
      = cycleSingle (deningerMonicClosedPoint P) 1 :=
  mwCyclesRank_deningerMWCycle P hP

end Cycle

section PrincipalIdealDomain

variable {R : Type*} [CommRing R] [IsDomain R] [IsPrincipalIdealRing R]

omit [IsDomain R] in
/-- An irreducible element of a principal ideal domain generates a maximal ideal. -/
theorem deningerIrreducible_span_isMaximal {π : R} (hirr : Irreducible π) :
    (Ideal.span ({π} : Set R)).IsMaximal :=
  PrincipalIdealRing.isMaximal_of_irreducible hirr

omit [IsPrincipalIdealRing R] in
/-- An irreducible element of a domain is a non-zero-divisor. -/
theorem deningerIrreducible_isRegular {π : R} (hirr : Irreducible π) : IsRegular π :=
  IsRegular.of_ne_zero hirr.ne_zero

/-- **Every codimension-one point of a principal ideal domain carries an oriented Milnor--Witt
fundamental cycle whose underlying ordinary cycle is the point itself.**  This covers the local ring
at a codimension-one point of a normal Noetherian scheme, which is a discrete valuation ring, and
the closed points `Z_P ⊂ 𝔸¹` of the card. -/
theorem mwCyclesRank_deningerMWCycle_irreducible {π : R} (hirr : Irreducible π) :
    haveI : (Ideal.span ({π} : Set R)).IsMaximal := deningerIrreducible_span_isMaximal hirr
    mwCyclesRank R (deningerMWCycle π (deningerIrreducible_isRegular hirr))
      = cycleSingle (deningerMonicClosedPoint π) 1 :=
  haveI : (Ideal.span ({π} : Set R)).IsMaximal := deningerIrreducible_span_isMaximal hirr
  mwCyclesRank_deningerMWCycle π (deningerIrreducible_isRegular hirr)

end PrincipalIdealDomain

end RHTower
