import GaloisForLFunctions.RHTower.PhysicalOrdinateZeroDensityRigidity
import GaloisForLFunctions.HTGeometry.WeightedDirichletAlgebra

/-!
# Finite matrix packaging of bounded observations

Every bounded observation `γ ↦ L(z_{1,γ})` of the rigged critical source is the readout of an
element of the weighted Wiener algebra `A_η` for each `0 < η < a` (by (13)).  Since the readout is
a ring homomorphism `A_η → ℂ`, every determinant, and every ring expression, of finitely many such
observations is again the readout of an element of the same `A_η`.  Hence:

* a determinant of bounded observations vanishing at every positive simple critical Xi ordinate
  vanishes at every real height; the same for any element of the subring generated by the
  observations;
* the same holds for a limit whose approximants converge in a fixed `A_η` norm.

A source determinant carrying Xi's divisor must therefore lose every fixed positive weighted-Wiener
aperture in the limit.
-/

noncomputable section
set_option autoImplicit false

open Complex Filter Topology Set

namespace RHTower

open GaloisForLFunctions.HTGeometry

local notation "ℓ²ℕ" => lp (fun _ : ℕ => ℂ) 2

/-- The coefficients `μ(n) n^{-(a+1/2)} L(δ_n)` of the observation `γ ↦ L(z_{1,γ})`. -/
def observationCoeff (a : ℝ) (L : ℓ²ℕ →L[ℂ] ℂ) : ArithmeticFunction ℂ :=
  ⟨fun n => riggedWeight a n * L (lp.single 2 n 1), by simp [riggedWeight]⟩

theorem observationCoeff_apply (a : ℝ) (L : ℓ²ℕ →L[ℂ] ℂ) (n : ℕ) :
    observationCoeff a L n = riggedWeight a n * L (lp.single 2 n 1) := rfl

/-- Bounded observations lie in `A_η` for every `η < a`. -/
theorem observationCoeff_mem {a η : ℝ} (hη : η < a) (L : ℓ²ℕ →L[ℂ] ℂ) :
    observationCoeff a L ∈ weightedDirichletSubring η :=
  weightedAbsSummable_rigged_mul (a := a) hη (summable_norm_sq_functional L)

theorem dirichletReadout_observationCoeff {a : ℝ} (ha : 0 < a) (L : ℓ²ℕ →L[ℂ] ℂ) (γ : ℝ) :
    dirichletReadout (⇑(observationCoeff a L)) γ = L (riggedSource a 1 γ) :=
  (functional_rigged_eq_readout ha L γ).symm

/-- An element of `A_η` whose readout vanishes at every positive simple critical ordinate has
vanishing readout at every real height. -/
theorem readout_eq_zero_of_simpleCritical {η : ℝ} (hη : 0 < η) {f : ArithmeticFunction ℂ}
    (hf : f ∈ weightedDirichletSubring η)
    (hvanish : ∀ t : ℝ, 0 < t → xi (linePt t) = 0 → (analyticOrderAt xi (linePt t)).toNat = 1 →
      dirichletReadout (⇑f) t = 0) (γ : ℝ) : dirichletReadout (⇑f) γ = 0 := by
  have hcoef := coeff_eq_zero_of_readout_vanishes_on_simpleCritical hf hη hvanish
  rw [dirichletReadout_ofReal hf hη.le, GaloisForLFunctions.expSeriesCarrier]
  refine (tsum_congr fun m => ?_).trans tsum_zero
  rw [hcoef (m + 1) (Nat.succ_pos m), zero_mul]

theorem im_ofReal_ge {η : ℝ} (hη : 0 ≤ η) (t : ℝ) : -η ≤ ((t : ℂ)).im := by simp; linarith

/-- **Determinants of observations.**  If a determinant of bounded observations of the rigged
critical source vanishes at every positive simple critical Xi ordinate, it vanishes at every real
height. -/
theorem det_observations_eq_zero {a : ℝ} (ha : 0 < a) {ι : Type*} [Fintype ι] [DecidableEq ι]
    (Lm : Matrix ι ι (ℓ²ℕ →L[ℂ] ℂ))
    (hvanish : ∀ t : ℝ, 0 < t → xi (linePt t) = 0 → (analyticOrderAt xi (linePt t)).toNat = 1 →
      (Matrix.of fun i j => Lm i j (riggedSource a 1 t)).det = 0) (γ : ℝ) :
    (Matrix.of fun i j => Lm i j (riggedSource a 1 γ)).det = 0 := by
  set η : ℝ := a / 2 with hηdef
  have hη : 0 < η := by positivity
  have hηa : η < a := by linarith
  let C : Matrix ι ι (weightedDirichletSubring η) :=
    fun i j => ⟨observationCoeff a (Lm i j), observationCoeff_mem hηa (Lm i j)⟩
  have hread : ∀ t : ℝ, (Matrix.of fun i j => Lm i j (riggedSource a 1 t)).det =
      dirichletReadout (⇑((C.det : weightedDirichletSubring η) : ArithmeticFunction ℂ)) t := by
    intro t
    rw [← readoutHom_apply η t (im_ofReal_ge hη.le t), readoutHom_det]
    congr 1
    ext i j
    simp only [Matrix.map_apply, Matrix.of_apply, readoutHom_apply, C]
    rw [dirichletReadout_observationCoeff ha]
  rw [hread]
  exact readout_eq_zero_of_simpleCritical hη (C.det).2
    (fun t ht0 hxi hs => by rw [← hread]; exact hvanish t ht0 hxi hs) γ

/-- **Ring expressions of observations.**  Every element of the subring generated by the
observation coefficients lies in `A_η`; if its readout vanishes at every positive simple critical
ordinate, it vanishes at every real height. -/
theorem closure_observations_readout_eq_zero {a : ℝ} (ha : 0 < a) (S : Set (ℓ²ℕ →L[ℂ] ℂ))
    {f : ArithmeticFunction ℂ} (hf : f ∈ Subring.closure (observationCoeff a '' S))
    (hvanish : ∀ t : ℝ, 0 < t → xi (linePt t) = 0 → (analyticOrderAt xi (linePt t)).toNat = 1 →
      dirichletReadout (⇑f) t = 0) (γ : ℝ) : dirichletReadout (⇑f) γ = 0 := by
  have hη : 0 < a / 2 := by positivity
  have hmem : f ∈ weightedDirichletSubring (a / 2) := by
    refine (Subring.closure_le.mpr ?_) hf
    rintro _ ⟨L, -, rfl⟩
    exact observationCoeff_mem (by linarith) L
  exact readout_eq_zero_of_simpleCritical hη hmem hvanish γ

/-- **Limits in a fixed aperture.**  If approximants in `A_η` converge in the `A_η` norm to `g`, and
the readout of `g` vanishes at every positive simple critical ordinate, it vanishes at every real
height. -/
theorem limit_readout_eq_zero {η : ℝ} (hη : 0 < η) (f : ℕ → ArithmeticFunction ℂ)
    (hf : ∀ k, f k ∈ weightedDirichletSubring η) (g : ArithmeticFunction ℂ)
    (hfg : ∀ k, WeightedAbsSummable (⇑(f k - g)) η)
    (hlim : Tendsto (fun k => weightedNorm (⇑(f k - g)) η) atTop (𝓝 0))
    (hvanish : ∀ t : ℝ, 0 < t → xi (linePt t) = 0 → (analyticOrderAt xi (linePt t)).toNat = 1 →
      dirichletReadout (⇑g) t = 0) (γ : ℝ) : dirichletReadout (⇑g) γ = 0 :=
  readout_eq_zero_of_simpleCritical hη (readout_limit f hf g hfg hlim).1 hvanish γ

end RHTower
