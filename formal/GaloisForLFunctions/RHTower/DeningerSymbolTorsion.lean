import Mathlib.LinearAlgebra.TensorProduct.Associator
import Mathlib.GroupTheory.Torsion
import Mathlib.Data.Real.Basic
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.Push

/-!
# Realification of a symbol algebra over a torsion group

A symbol that is additive in each entry takes torsion values as soon as its entries lie in a
torsion group: raising the first entry to its order multiplies the symbol by that order and
replaces the entry by the unit, where the symbol vanishes.  A group generated by such symbols is
therefore torsion, and a torsion group has vanishing realification, because a real scalar is
divisible by the order.

Over the algebraic closure of a finite field every unit is a root of unity, so this is the collapse
of the positive-degree Milnor algebra after realification, leaving only the degree-zero unit.

* `deningerSymbol_nsmul` : the order of an entry multiplies the symbol.
* `deningerSymbol_isOfFinAddOrder` : symbols are torsion.
* `deningerSymbolGenerated_isTorsion` : a group generated by symbols is torsion.
* `deningerTorsion_tensor_real` : a torsion group has vanishing realification.
* `deningerDegreeZero_tensor_real` : the degree-zero unit realifies to `ℝ`.
-/

namespace RHTower

open TensorProduct

section Symbol

variable {G : Type*} [CommGroup G] {K : Type*} [AddCommGroup K] {n : ℕ}

/-- Additivity of a symbol in one entry. -/
def DeningerSymbolAdditive (s : (Fin n → G) → K) : Prop :=
  ∀ (i : Fin n) (a a' : G) (v : Fin n → G),
    s (Function.update v i (a * a')) = s (Function.update v i a) + s (Function.update v i a')

/-- **A symbol with a unit entry vanishes.** -/
theorem deningerSymbol_one {s : (Fin n → G) → K} (hs : DeningerSymbolAdditive s) (i : Fin n)
    (v : Fin n → G) : s (Function.update v i 1) = 0 := by
  have h := hs i 1 1 v
  rw [one_mul] at h
  have h2 : s (Function.update v i 1) + s (Function.update v i 1)
      = s (Function.update v i 1) + 0 := by
    rw [add_zero]
    exact h.symm
  exact add_left_cancel h2

/-- **Raising an entry to a power multiplies the symbol by that power.** -/
theorem deningerSymbol_pow {s : (Fin n → G) → K} (hs : DeningerSymbolAdditive s) (i : Fin n)
    (v : Fin n → G) (k : ℕ) :
    s (Function.update v i (v i ^ k)) = k • s v := by
  induction k with
  | zero =>
    rw [pow_zero, zero_smul]
    exact deningerSymbol_one hs i v
  | succ m ih =>
    rw [pow_succ, hs i (v i ^ m) (v i) v, ih, Function.update_eq_self, succ_nsmul]

/-- **The order of an entry annihilates the symbol.** -/
theorem deningerSymbol_nsmul {s : (Fin n → G) → K} (hs : DeningerSymbolAdditive s) (i : Fin n)
    (v : Fin n → G) {m : ℕ} (hm : v i ^ m = 1) : m • s v = 0 := by
  rw [← deningerSymbol_pow hs i v m, hm]
  exact deningerSymbol_one hs i v

/-- **A symbol over a torsion group is torsion.** -/
theorem deningerSymbol_isTorsion {s : (Fin n → G) → K} (hs : DeningerSymbolAdditive s)
    (htor : ∀ g : G, IsOfFinOrder g) (hn : 0 < n) (v : Fin n → G) :
    ∃ m : ℕ, 0 < m ∧ m • s v = 0 := by
  refine ⟨orderOf (v ⟨0, hn⟩), ?_, ?_⟩
  · exact (htor (v ⟨0, hn⟩)).orderOf_pos
  · exact deningerSymbol_nsmul hs ⟨0, hn⟩ v (pow_orderOf_eq_one _)

/-- **A group generated by torsion symbols is torsion.**  The torsion elements form a subgroup,
which therefore contains the subgroup generated by the symbols. -/
theorem deningerSymbolGenerated_isTorsion {s : (Fin n → G) → K} (hs : DeningerSymbolAdditive s)
    (htor : ∀ g : G, IsOfFinOrder g) (hn : 0 < n)
    (hgen : AddSubgroup.closure (Set.range s) = ⊤) (x : K) :
    ∃ m : ℕ, 0 < m ∧ m • x = 0 := by
  have hsub : Set.range s ⊆ (AddCommGroup.torsion K : Set K) := by
    rintro _ ⟨v, rfl⟩
    obtain ⟨m, hm, hmv⟩ := deningerSymbol_isTorsion hs htor hn v
    exact isOfFinAddOrder_iff_nsmul_eq_zero.mpr ⟨m, hm, hmv⟩
  have hle : AddSubgroup.closure (Set.range s) ≤ AddCommGroup.torsion K :=
    AddSubgroup.closure_le _ |>.mpr hsub
  rw [hgen, top_le_iff] at hle
  have hmem : x ∈ AddCommGroup.torsion K := hle ▸ AddSubgroup.mem_top x
  obtain ⟨m, hm, hmx⟩ := isOfFinAddOrder_iff_nsmul_eq_zero.mp hmem
  exact ⟨m, hm, hmx⟩

end Symbol

section Realification

/-- **A torsion group has vanishing realification.**  A real scalar is divisible by the order of
the group element, and the order can be moved across the tensor sign. -/
theorem deningerTorsion_tensor_real {K : Type*} [AddCommGroup K]
    (htor : ∀ x : K, ∃ m : ℕ, 0 < m ∧ m • x = 0) (t : TensorProduct ℤ K ℝ) : t = 0 := by
  induction t using TensorProduct.induction_on with
  | zero => rfl
  | tmul x r =>
    obtain ⟨m, hm, hmx⟩ := htor x
    have hmne : (m : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hm.ne'
    have hzx : (m : ℤ) • x = 0 := by
      rw [← Nat.cast_smul_eq_nsmul ℤ m x] at hmx
      exact hmx
    have hsplit : r = (m : ℤ) • (r / (m : ℝ)) := by
      rw [zsmul_eq_mul]
      push_cast
      field_simp
    rw [hsplit, ← TensorProduct.smul_tmul, hzx, TensorProduct.zero_tmul]
  | add a b ha hb => rw [ha, hb, add_zero]

/-- **The degree-zero unit realifies to the reals.** -/
noncomputable def deningerDegreeZero_tensor_real : TensorProduct ℤ ℤ ℝ ≃ₗ[ℤ] ℝ :=
  TensorProduct.lid ℤ ℝ

end Realification

end RHTower
