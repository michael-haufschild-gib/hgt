import GaloisForLFunctions.RHTower.FilteredArcGeneratorMoments

/-!
# Decay-class line witnesses blind at every finite level

**Theorem** (`exists_decayClass_lineWitness`). For every `N` there are `h, h' : ℝ → ℝ` with:
* `h'` is the derivative of `h` everywhere, and `h`, `h'` are integrable;
* `h` is even, with `h(1/x) = |x| h(x)`;
* `∫ h = 0`, and `|e^{v/2} h(e^v)| ≤ C e^{−3|v|/2}` (decay class);
* `∫ h'(x) sin(2πm x) dx = 0` for every integer `2 ≤ m ≤ N + 1`;
* the log-scale profile `e^{v/2} h(e^v)` strictly positive definite.

In the multiplier language of the (N1) problem this is a nonnegative symbol, analytic across the poles
`s = 0, 1`, whose ζ-free kernel vanishes at `2, …, N + 1`. So every finite truncation of the integer
blindness condition is compatible with the decay class.

Proof.
1. **Density of the Whittaker cone** (`closure_momentCone_arcSineMomentVec`). Let
   `W(u) = (J_u(2πm))_{2 ≤ m ≤ N+1}` with `J_u(c) = −4c√y K₀(cy) cos(cu)`.
   If a functional `f` were `≥ 0` on every `W(u)`, then `Σ_m a_m K₀(2πm y) cos(2πm u) ≥ 0` on the modular
   arc. The arc minimum principle (`whittakerArc_coeff_eq_zero`) then gives `f = 0`. Hence the
   nonnegative cone of the `W(u)` is dense.
2. Each signed basis vector `±e_j` is approximated by a finite nonnegative combination of `W(u)`'s.
3. The filtered generators `h_{K,u}` have moment vectors within `B(2e^{−K/4} + e^{−K/2})` of `W(u)`,
   uniformly in `u`.
4. For one large `K`, the `2N` perturbed vectors lie within `1/(2(N+2))` of `±e_j`. Then `0` is a convex
   combination of them (`zero_mem_convexHull_of_near_signedBasis`, a separation argument).
5. The corresponding nonnegative combination of filtered generators is the witness.
-/

open MeasureTheory Set Filter Topology
open GaloisForLFunctions.HTGeometry RHTower.BesselKZero

namespace RHTower

noncomputable section

/-- A functional on `ℝ^N` is a sum over coordinates. -/
theorem strongDual_pi_apply_eq_sum {N : ℕ} (f : StrongDual ℝ (Fin N → ℝ)) (x : Fin N → ℝ) :
    f x = ∑ i, x i * f (Pi.single i 1) := by
  conv_lhs => rw [pi_eq_sum_univ' x]
  rw [map_sum]
  simp only [map_smul, smul_eq_mul]

/-- The nonnegative cone generated by a family of vectors. -/
def momentCone {N : ℕ} (V : ArcParam → (Fin N → ℝ)) : Set (Fin N → ℝ) :=
  {x | ∃ L : ArcParam →₀ ℝ, (∀ u, 0 ≤ L u) ∧ Finsupp.linearCombination ℝ V L = x}

theorem convex_momentCone {N : ℕ} (V : ArcParam → (Fin N → ℝ)) : Convex ℝ (momentCone V) := by
  rintro x ⟨L₁, h₁, rfl⟩ y ⟨L₂, h₂, rfl⟩ a b ha hb _
  refine ⟨a • L₁ + b • L₂, fun u => ?_, by rw [map_add, map_smul, map_smul]⟩
  simp only [Finsupp.coe_add, Finsupp.coe_smul, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
  exact add_nonneg (mul_nonneg ha (h₁ u)) (mul_nonneg hb (h₂ u))

theorem zero_mem_momentCone {N : ℕ} (V : ArcParam → (Fin N → ℝ)) : (0 : Fin N → ℝ) ∈ momentCone V :=
  ⟨0, fun _ => le_rfl, map_zero _⟩

theorem smul_vec_mem_momentCone {N : ℕ} (V : ArcParam → (Fin N → ℝ)) (u : ArcParam) {t : ℝ}
    (ht : 0 ≤ t) : t • V u ∈ momentCone V := by
  refine ⟨Finsupp.single u t, fun v => ?_, ?_⟩
  · rw [Finsupp.single_apply]; split_ifs <;> simp [ht]
  · rw [Finsupp.linearCombination_single]

/-- The limiting Whittaker moment vector `W(u) = (J_u(2π(i+2)))_{i < N}`. -/
def arcSineMomentVec (N : ℕ) (u : ArcParam) : Fin N → ℝ :=
  fun i => arcPairSineMoment u (arcFreq (i + 1))

/-- The filtered moment vector `(∫ h_{K,u}' sin(2π(i+2)x) dx)_{i < N}`. -/
def filteredSineMomentVec (N : ℕ) (K : ℝ) (u : ArcParam) : Fin N → ℝ :=
  fun i => ∫ x, filteredArcDeriv K u x * Real.sin (arcFreq (i + 1) * x)

/-- **The Whittaker moment cone is dense** (arc minimum principle). -/
theorem closure_momentCone_arcSineMomentVec (N : ℕ) :
    closure (momentCone (arcSineMomentVec N)) = univ := by
  refine eq_univ_of_forall fun e => ?_
  by_contra he
  obtain ⟨f, s, hfe, hfC⟩ := geometric_hahn_banach_point_closed
    (convex_momentCone _).closure isClosed_closure he
  have hs : s < 0 := by
    have := hfC 0 (subset_closure (zero_mem_momentCone _)); rwa [map_zero] at this
  have hW : ∀ u, 0 ≤ f (arcSineMomentVec N u) := by
    intro u
    by_contra hneg
    push Not at hneg
    set t := s / f (arcSineMomentVec N u)
    have ht : 0 ≤ t := (div_pos_of_neg_of_neg hs hneg).le
    have h := hfC _ (subset_closure (smul_vec_mem_momentCone _ u ht))
    rw [map_smul, smul_eq_mul, div_mul_cancel₀ _ hneg.ne] at h
    exact lt_irrefl _ h
  -- Whittaker coefficients
  set a : ℕ → ℝ := fun m => if h : 1 ≤ m ∧ m - 1 < N then
    -(4 * arcFreq m * f (Pi.single (⟨m - 1, h.2⟩ : Fin N) 1)) else 0 with ha
  set b : ℕ → ℝ := fun _ => 0 with hb
  have hrepr : ∀ u : ArcParam, f (arcSineMomentVec N u) = Real.sqrt (modularArcHeight u) *
      whittakerArcSum (N + 1) a b u (modularArcHeight u) := by
    intro u
    rw [strongDual_pi_apply_eq_sum, whittakerArcSum, Finset.sum_range_succ', mul_add,
      Finset.mul_sum]
    have h0 : a 0 = 0 := by simp [ha]
    simp only [arcTrig, h0, zero_mul, hb, add_zero, mul_zero]
    rw [← Fin.sum_univ_eq_sum_range]
    refine Finset.sum_congr rfl fun i _ => ?_
    have hi : 1 ≤ (i : ℕ) + 1 ∧ (i : ℕ) + 1 - 1 < N := ⟨by omega, by simp⟩
    have hai : a ((i : ℕ) + 1) = -(4 * arcFreq ((i : ℕ) + 1) * f (Pi.single i 1)) := by
      simp only [ha, dif_pos hi]
      congr 3
    rw [hai]
    simp only [arcSineMomentVec, arcPairSineMoment]
    ring
  have harc : ∀ u y, 0 < y → |u| ≤ 1 / 2 → u ^ 2 + y ^ 2 = 1 →
      0 ≤ whittakerArcSum (N + 1) a b u y := by
    intro u y hy hu huy
    have huI : u ∈ Icc (-1 / 2 : ℝ) (1 / 2) := by
      rw [abs_le] at hu; exact ⟨by linarith [hu.1], hu.2⟩
    have hyh : y = modularArcHeight u := by
      unfold modularArcHeight
      rw [show 1 - u ^ 2 = y ^ 2 by linarith, Real.sqrt_sq hy.le]
    have h := hW ⟨u, huI⟩
    rw [hrepr] at h
    simp only at h
    rw [← hyh] at h
    exact (mul_nonneg_iff_of_pos_left (Real.sqrt_pos.mpr hy)).mp h
  have hf0 : ∀ i : Fin N, f (Pi.single i 1) = 0 := by
    intro i
    have h := (whittakerArc_coeff_eq_zero (N + 1) a b harc (m := (i : ℕ) + 1)
      (by omega)).1
    have hi : 1 ≤ (i : ℕ) + 1 ∧ (i : ℕ) + 1 - 1 < N := ⟨by omega, by simp⟩
    simp only [ha, dif_pos hi] at h
    have hc := arcFreq_pos ((i : ℕ) + 1)
    have : f (Pi.single (⟨(i : ℕ) + 1 - 1, hi.2⟩ : Fin N) 1) = 0 := by
      have h4 : (4 * arcFreq ((i : ℕ) + 1)) ≠ 0 := by positivity
      have := neg_eq_zero.mp h
      exact (mul_eq_zero.mp this).resolve_left h4
    simpa using this
  have hfe0 : f e = 0 := by
    rw [strongDual_pi_apply_eq_sum]
    exact Finset.sum_eq_zero fun i _ => by rw [hf0 i, mul_zero]
  linarith

/-- The signed basis vector `±e_j`. -/
def signedBasis {M : ℕ} (q : Fin M × Bool) : Fin M → ℝ :=
  (if q.2 then (1 : ℝ) else -1) • Pi.single q.1 1

theorem norm_signedBasis {M : ℕ} (q : Fin M × Bool) : ‖signedBasis q‖ = 1 := by
  unfold signedBasis
  split_ifs <;> simp [Pi.norm_single]

/-- **Robustness of the signed basis.** If `p(j, ±)` lies within `1/(2(M+1))` of `±e_j` for every
`j`, then `0` is a convex combination of the `p(j, ±)`. -/
theorem zero_mem_convexHull_of_near_signedBasis {M : ℕ} (p : Fin (M + 1) × Bool → (Fin (M + 1) → ℝ))
    (hp : ∀ q, ‖p q - signedBasis q‖ ≤ 1 / (2 * ((M : ℝ) + 2))) :
    (0 : Fin (M + 1) → ℝ) ∈ convexHull ℝ (range p) := by
  by_contra h0
  have hcl : IsClosed (convexHull ℝ (range p)) :=
    ((finite_range p).isCompact_convexHull ℝ).isClosed
  obtain ⟨f, s, hf0, hfS⟩ := geometric_hahn_banach_point_closed (convex_convexHull ℝ _) hcl h0
  rw [map_zero] at hf0
  set a : Fin (M + 1) → ℝ := fun i => f (Pi.single i 1) with ha
  obtain ⟨j, -, hj⟩ := Finset.exists_max_image Finset.univ (fun i => |a i|) Finset.univ_nonempty
  set q : Fin (M + 1) × Bool := (j, decide (a j < 0)) with hq
  have hpos : s < f (p q) := hfS _ (subset_convexHull ℝ _ (mem_range_self q))
  have hsb : f (signedBasis q) = -|a j| := by
    simp only [signedBasis, hq, map_smul, smul_eq_mul]
    change (if decide (a j < 0) then (1 : ℝ) else -1) * a j = -|a j|
    by_cases hneg : a j < 0
    · simp [hneg, abs_of_neg hneg]
    · push Not at hneg; simp [not_lt.mpr hneg, abs_of_nonneg hneg]
  have herr : |f (p q - signedBasis q)| ≤ ((M : ℝ) + 1) * (1 / (2 * ((M : ℝ) + 2))) * |a j| := by
    rw [strongDual_pi_apply_eq_sum]
    calc |∑ i, (p q - signedBasis q) i * a i| ≤ ∑ i, |(p q - signedBasis q) i * a i| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _i : Fin (M + 1), (1 / (2 * ((M : ℝ) + 2))) * |a j| := by
          refine Finset.sum_le_sum fun i _ => ?_
          rw [abs_mul]
          refine mul_le_mul ((norm_le_pi_norm (p q - signedBasis q) i).trans (hp q)) (hj i
            (Finset.mem_univ _)) (abs_nonneg _) (by positivity)
      _ = ((M : ℝ) + 1) * (1 / (2 * ((M : ℝ) + 2))) * |a j| := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
          push_cast; ring
  have hsplit : f (p q) = f (signedBasis q) + f (p q - signedBasis q) := by
    rw [map_sub]; ring
  have hfac : ((M : ℝ) + 1) * (1 / (2 * ((M : ℝ) + 2))) ≤ 1 := by
    rw [mul_one_div, div_le_one (by positivity)]; linarith
  have hle : f (p q) ≤ 0 := by
    rw [hsplit, hsb]
    have := (le_abs_self _).trans herr
    nlinarith [abs_nonneg (a j)]
  linarith

/-! ### Perturbation and assembly -/

theorem arcFreq_le_arcFreq {m n : ℕ} (h : m ≤ n) : arcFreq m ≤ arcFreq n := by
  unfold arcFreq
  have : (m : ℝ) ≤ n := by exact_mod_cast h
  have := Real.pi_pos
  nlinarith

/-- The filtered moment vectors are uniformly close to the Whittaker vectors. -/
theorem norm_filteredSineMomentVec_sub_le {K : ℝ} (hK : 0 < K) (N : ℕ) (u : ArcParam) :
    ‖filteredSineMomentVec N K u - arcSineMomentVec N u‖ ≤
      4 * Real.sqrt (Real.pi / 2) * Real.sqrt (arcFreq N) *
        (2 * Real.exp (-(K / 4)) + Real.exp (-(K / 2))) := by
  refine (pi_norm_le_iff_of_nonneg (by positivity)).mpr fun i => ?_
  rw [Real.norm_eq_abs]
  simp only [Pi.sub_apply, filteredSineMomentVec, arcSineMomentVec]
  refine (abs_integral_filteredArcDeriv_mul_sin_sub_le hK u (arcFreq_pos _)).trans ?_
  gcongr
  exact arcFreq_le_arcFreq (by omega)

theorem norm_linearCombination_sub_le {N : ℕ} {V W : ArcParam → (Fin N → ℝ)} {ε : ℝ}
    (hVW : ∀ u, ‖V u - W u‖ ≤ ε) {L : ArcParam →₀ ℝ} (hL : ∀ u, 0 ≤ L u) :
    ‖Finsupp.linearCombination ℝ V L - Finsupp.linearCombination ℝ W L‖ ≤
      (L.sum fun _ a => a) * ε := by
  rw [Finsupp.linearCombination_apply, Finsupp.linearCombination_apply, Finsupp.sum, Finsupp.sum,
    Finsupp.sum, ← Finset.sum_sub_distrib, Finset.sum_mul]
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun u _ => ?_)
  rw [← smul_sub, norm_smul, Real.norm_of_nonneg (hL u)]
  exact mul_le_mul_of_nonneg_left (hVW u) (hL u)

theorem exists_pos_filterError_lt (B : ℝ) {η : ℝ} (hη : 0 < η) :
    ∃ K : ℝ, 0 < K ∧ B * (2 * Real.exp (-(K / 4)) + Real.exp (-(K / 2))) < η := by
  have h4 : Tendsto (fun K : ℝ => Real.exp (-(K / 4))) atTop (𝓝 0) :=
    Real.tendsto_exp_neg_atTop_nhds_zero.comp (tendsto_id.atTop_div_const (by norm_num))
  have h2 : Tendsto (fun K : ℝ => Real.exp (-(K / 2))) atTop (𝓝 0) :=
    Real.tendsto_exp_neg_atTop_nhds_zero.comp (tendsto_id.atTop_div_const (by norm_num))
  have ht : Tendsto (fun K : ℝ => B * (2 * Real.exp (-(K / 4)) + Real.exp (-(K / 2)))) atTop
      (𝓝 (B * (2 * 0 + 0))) := (h4.const_mul 2 |>.add h2).const_mul B
  rw [mul_zero, zero_add, mul_zero] at ht
  exact ((ht.eventually (gt_mem_nhds hη)).and (eventually_gt_atTop 0)).exists.imp
    fun K hK => ⟨hK.2, hK.1⟩

/-- **A nonnegative combination of filtered generators with vanishing moments.** -/
theorem exists_filteredCombination (M : ℕ) :
    ∃ K : ℝ, 0 < K ∧ ∃ L : ArcParam →₀ ℝ, (∀ u, 0 ≤ L u) ∧ L ≠ 0 ∧
      Finsupp.linearCombination ℝ (filteredSineMomentVec (M + 1) K) L = 0 := by
  set ε : ℝ := 1 / (2 * ((M : ℝ) + 2)) with hε
  have hε0 : 0 < ε := by positivity
  have hε1 : ε < 1 := by rw [hε, div_lt_one (by positivity)]; linarith [(M.cast_nonneg : (0:ℝ) ≤ M)]
  have happrox : ∀ q : Fin (M + 1) × Bool, ∃ L : ArcParam →₀ ℝ, (∀ u, 0 ≤ L u) ∧
      ‖Finsupp.linearCombination ℝ (arcSineMomentVec (M + 1)) L - signedBasis q‖ < ε / 2 := by
    intro q
    have hmem : signedBasis q ∈ closure (momentCone (arcSineMomentVec (M + 1))) := by
      rw [closure_momentCone_arcSineMomentVec]; trivial
    obtain ⟨b, ⟨L, hL0, hLb⟩, hdist⟩ := Metric.mem_closure_iff.mp hmem (ε / 2) (by positivity)
    refine ⟨L, hL0, ?_⟩
    rw [hLb, ← dist_eq_norm, dist_comm]
    exact hdist
  choose Lq hLq0 hLq using happrox
  set mass : ℝ := ∑ q, (Lq q).sum fun _ a => a with hmass
  have hmass_q : ∀ q, (Lq q).sum (fun _ a => a) ≤ mass := fun q => by
    rw [hmass]
    refine Finset.single_le_sum (f := fun q => (Lq q).sum fun _ a => a) (fun q' _ => ?_)
      (Finset.mem_univ q)
    exact Finset.sum_nonneg fun u _ => hLq0 q' u
  have hmass0 : 0 ≤ mass := (Finset.sum_nonneg fun u _ => hLq0 _ u).trans (hmass_q (0, true))
  set B : ℝ := 4 * Real.sqrt (Real.pi / 2) * Real.sqrt (arcFreq (M + 1)) with hB
  obtain ⟨K, hK, hKerr⟩ := exists_pos_filterError_lt B
    (show 0 < ε / 2 / (mass + 1) by positivity)
  refine ⟨K, hK, ?_⟩
  set p : Fin (M + 1) × Bool → (Fin (M + 1) → ℝ) := fun q =>
    Finsupp.linearCombination ℝ (filteredSineMomentVec (M + 1) K) (Lq q) with hp
  set err := B * (2 * Real.exp (-(K / 4)) + Real.exp (-(K / 2))) with herr
  have herr0 : 0 ≤ err := by rw [herr, hB]; positivity
  have hpq : ∀ q, ‖p q - signedBasis q‖ ≤ ε := by
    intro q
    have h1 := norm_linearCombination_sub_le (V := filteredSineMomentVec (M + 1) K)
      (W := arcSineMomentVec (M + 1)) (ε := err)
      (fun u => norm_filteredSineMomentVec_sub_le hK (M + 1) u) (hLq0 q)
    have h2 : ((Lq q).sum fun _ a => a) * err ≤ (mass + 1) * err :=
      mul_le_mul_of_nonneg_right (by linarith [hmass_q q]) herr0
    have h3 : (mass + 1) * err < ε / 2 := by
      rw [lt_div_iff₀ (by positivity)] at hKerr; linarith
    calc ‖p q - signedBasis q‖ = ‖(p q - Finsupp.linearCombination ℝ (arcSineMomentVec (M + 1))
          (Lq q)) + (Finsupp.linearCombination ℝ (arcSineMomentVec (M + 1)) (Lq q) -
            signedBasis q)‖ := by congr 1; abel
      _ ≤ ‖p q - Finsupp.linearCombination ℝ (arcSineMomentVec (M + 1)) (Lq q)‖ +
          ‖Finsupp.linearCombination ℝ (arcSineMomentVec (M + 1)) (Lq q) - signedBasis q‖ :=
          norm_add_le _ _
      _ ≤ ε := by linarith [hLq q]
  obtain ⟨ι, _, w, z, hw0, hw1, hz, hsum⟩ :=
    mem_convexHull_iff_exists_fintype.mp (zero_mem_convexHull_of_near_signedBasis p hpq)
  choose qi hqi using hz
  refine ⟨∑ i, w i • Lq (qi i), fun u => ?_, ?_, ?_⟩
  · rw [Finsupp.finsetSum_apply]
    exact Finset.sum_nonneg fun i _ => by
      rw [Finsupp.smul_apply, smul_eq_mul]; exact mul_nonneg (hw0 i) (hLq0 _ u)
  · intro hL
    obtain ⟨i₀, -, hi₀⟩ := Finset.exists_ne_zero_of_sum_ne_zero (s := Finset.univ) (f := w)
      (by rw [hw1]; norm_num)
    have hwpos : 0 < w i₀ := lt_of_le_of_ne (hw0 i₀) (Ne.symm hi₀)
    have hzero : Lq (qi i₀) = 0 := by
      ext u
      have h := congrArg (fun L : ArcParam →₀ ℝ => L u) hL
      simp only [Finsupp.finsetSum_apply, Finsupp.smul_apply, smul_eq_mul,
        Finsupp.coe_zero, Pi.zero_apply] at h
      have hall := (Finset.sum_eq_zero_iff_of_nonneg fun i _ =>
        mul_nonneg (hw0 i) (hLq0 (qi i) u)).mp h i₀ (Finset.mem_univ _)
      simpa [hwpos.ne'] using hall
    have hp0 : p (qi i₀) = 0 := by rw [hp]; simp only [hzero, map_zero]
    have := hpq (qi i₀)
    rw [hp0, zero_sub, norm_neg, norm_signedBasis] at this
    linarith
  · rw [map_sum]
    simp only [map_smul]
    rw [← hsum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [← hqi i]

/-! ### The witness -/

/-- The combination `h = Σ_u L(u) h_{K,u}`. -/
def filteredCombVector (K : ℝ) (L : ArcParam →₀ ℝ) (x : ℝ) : ℝ :=
  L.sum fun u a => a * filteredArcVector K u x

/-- Its derivative. -/
def filteredCombDeriv (K : ℝ) (L : ArcParam →₀ ℝ) (x : ℝ) : ℝ :=
  L.sum fun u a => a * filteredArcDeriv K u x

theorem integrable_cos_mul_filteredArcProfile {K : ℝ} (hK : 0 < K) (u : ArcParam) (τ : ℝ) :
    Integrable fun v => Real.cos (τ * v) * filteredArcProfile K u v := by
  have hb : Integrable fun v : ℝ =>
      (8 + 10 * filterEdgeMass K) * Real.exp (-(3 / 2 * |v|)) :=
    (integrable_rexp_neg_mul_abs (by norm_num : (0:ℝ) < 3 / 2)).const_mul _
  refine hb.mono' ((by fun_prop : Continuous fun v : ℝ => Real.cos (τ * v)).mul
    (continuous_filteredArcProfile hK u)).aestronglyMeasurable (Eventually.of_forall fun v => ?_)
  rw [Real.norm_eq_abs, abs_mul, show 3 / 2 * |v| = 3 * |v| / 2 by ring]
  calc |Real.cos (τ * v)| * |filteredArcProfile K u v|
      ≤ 1 * ((8 + 10 * filterEdgeMass K) * Real.exp (-(3 * |v| / 2))) :=
        mul_le_mul (Real.abs_cos_le_one _) (abs_filteredArcProfile_le hK u v) (abs_nonneg _)
          zero_le_one
    _ = _ := one_mul _

/-- **Decay-class line witnesses blind at every finite level.** -/
theorem exists_decayClass_lineWitness (N : ℕ) :
    ∃ h h' : ℝ → ℝ, (∀ x, HasDerivAt h (h' x) x) ∧ Integrable h ∧ Integrable h' ∧
      (∀ x, h (-x) = h x) ∧ (∀ x, x ≠ 0 → h (1 / x) = |x| * h x) ∧ ∫ x, h x = 0 ∧
      (∃ C, ∀ v, |Real.exp (v / 2) * h (Real.exp v)| ≤ C * Real.exp (-(3 * |v| / 2))) ∧
      (∀ n < N, ∫ x, h' x * Real.sin (arcFreq (n + 1) * x) = 0) ∧
      ∀ τ : ℝ, 0 < ∫ v, Real.cos (τ * v) * (Real.exp (v / 2) * h (Real.exp v)) := by
  obtain ⟨K, hK, L, hL0, hL, hmom⟩ := exists_filteredCombination N
  refine ⟨filteredCombVector K L, filteredCombDeriv K L, fun x => ?_, ?_, ?_, fun x => ?_,
    fun x hx => ?_, ?_, ⟨(L.sum fun _ a => a) * (8 + 10 * filterEdgeMass K), fun v => ?_⟩,
    fun n hn => ?_, fun τ => ?_⟩
  · unfold filteredCombVector filteredCombDeriv Finsupp.sum
    exact HasDerivAt.fun_sum fun u _ => (hasDerivAt_filteredArcVector hK u x).const_mul (L u)
  · unfold filteredCombVector Finsupp.sum
    exact integrable_finsetSum _ fun u _ => (integrable_filteredArcVector hK u).const_mul (L u)
  · unfold filteredCombDeriv Finsupp.sum
    exact integrable_finsetSum _ fun u _ => (integrable_filteredArcDeriv hK u).const_mul (L u)
  · unfold filteredCombVector Finsupp.sum
    exact Finset.sum_congr rfl fun u _ => by dsimp only; rw [filteredArcVector_neg]
  · unfold filteredCombVector Finsupp.sum
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun u _ => by dsimp only; rw [filteredArcVector_inv K u hx]; ring
  · unfold filteredCombVector Finsupp.sum
    rw [integral_finsetSum _ fun u _ => (integrable_filteredArcVector hK u).const_mul (L u)]
    exact Finset.sum_eq_zero fun u _ => by
      rw [integral_const_mul, integral_filteredArcVector_eq_zero hK u, mul_zero]
  · unfold filteredCombVector Finsupp.sum
    rw [Finset.mul_sum, Finset.sum_mul, Finset.sum_mul]
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun u _ => ?_)
    rw [show Real.exp (v / 2) * (L u * filteredArcVector K u (Real.exp v)) =
      L u * (Real.exp (v / 2) * filteredArcVector K u (Real.exp v)) by ring,
      exp_half_mul_filteredArcVector, abs_mul, abs_of_nonneg (hL0 u), mul_assoc]
    exact mul_le_mul_of_nonneg_left (abs_filteredArcProfile_le hK u v) (hL0 u)
  · have h := congrArg (fun x : Fin (N + 1) → ℝ => x ⟨n, by omega⟩) hmom
    simp only [Finsupp.linearCombination_apply, Finsupp.sum, Finset.sum_apply, Pi.smul_apply,
      smul_eq_mul, Pi.zero_apply, filteredSineMomentVec] at h
    unfold filteredCombDeriv Finsupp.sum
    simp_rw [Finset.sum_mul]
    rw [integral_finsetSum _ fun u _ => ?_]
    · rw [← h]
      exact Finset.sum_congr rfl fun u _ => by
        simp_rw [mul_assoc]; rw [integral_const_mul]
    · simp_rw [mul_assoc]
      exact ((integrable_filteredArcDeriv hK u).mul_bdd (by fun_prop)
        (Eventually.of_forall fun x => by
          rw [Real.norm_eq_abs]; exact Real.abs_sin_le_one _)).const_mul (L u)
  · have e : ∀ v, Real.cos (τ * v) * (Real.exp (v / 2) * filteredCombVector K L (Real.exp v)) =
        ∑ u ∈ L.support, L u * (Real.cos (τ * v) * filteredArcProfile K u v) := fun v => by
      unfold filteredCombVector Finsupp.sum
      rw [Finset.mul_sum, Finset.mul_sum]
      exact Finset.sum_congr rfl fun u _ => by
        rw [← exp_half_mul_filteredArcVector]; ring
    simp_rw [e]
    rw [integral_finsetSum _ fun u _ => (integrable_cos_mul_filteredArcProfile hK u τ).const_mul _]
    refine Finset.sum_pos (fun u hu => ?_) (Finsupp.support_nonempty_iff.mpr hL)
    rw [integral_const_mul]
    exact mul_pos (lt_of_le_of_ne (hL0 u) (Ne.symm (Finsupp.mem_support_iff.mp hu)))
      (integral_cos_mul_filteredArcProfile_pos hK u τ)

end

