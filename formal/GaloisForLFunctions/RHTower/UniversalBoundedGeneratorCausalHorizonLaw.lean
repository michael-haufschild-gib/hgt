import GaloisForLFunctions.RHTower.OptimalLocalFutureEnergyLaw

open scoped BigOperators

noncomputable section

namespace RHTower.ParityForecast

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
  [CompleteSpace E]

/-- Entire orbit generated by an arbitrary bounded linear operator on a
complete complex normed space.  No inner product, self-adjointness, or
finite-dimensionality is assumed. -/
def boundedGeneratorOrbit
    (A : E →L[ℂ] E) (z : ℂ) (x : E) : E :=
  (NormedSpace.exp (z • A)) x

theorem boundedGeneratorOrbit_series_hasSum
    (A : E →L[ℂ] E) (z : ℂ) (x : E) :
    HasSum
      (fun m : ℕ => (z ^ m / m.factorial : ℂ) • ((A ^ m) x))
      (boundedGeneratorOrbit A z x) := by
  let φ : (E →L[ℂ] E) →L[ℂ] E :=
    (ContinuousLinearMap.apply ℂ E) x
  have hs :=
    (NormedSpace.exp_series_hasSum_exp'
      (𝕂 := ℂ) (z • A)).map φ φ.continuous
  unfold boundedGeneratorOrbit
  convert hs using 1
  funext m
  unfold φ
  simp only [Function.comp_apply, ContinuousLinearMap.apply_apply,
    smul_pow, ContinuousLinearMap.smul_apply]
  rw [div_eq_mul_inv]
  module

omit [CompleteSpace E] in
theorem boundedGenerator_pow_apply_norm_le
    (A : E →L[ℂ] E) (x : E) (m : ℕ) :
    ‖(A ^ m) x‖ ≤ ‖A‖ ^ m * ‖x‖ := by
  by_cases hm : m = 0
  · subst m
    simp
  exact (A ^ m).le_opNorm x |>.trans
    (by
      gcongr
      exact norm_pow_le' A (Nat.pos_of_ne_zero hm))

omit [CompleteSpace E] in
theorem boundedGenerator_pow_sub_norm_le
    {A B : E →L[ℂ] E} {Λ : ℝ}
    (hA : ‖A‖ ≤ Λ) (hB : ‖B‖ ≤ Λ)
    (x : E) (m : ℕ) :
    ‖(A ^ m) x - (B ^ m) x‖ ≤
      2 * Λ ^ m * ‖x‖ := by
  have hAm : ‖A‖ ^ m ≤ Λ ^ m := by gcongr
  have hBm : ‖B‖ ^ m ≤ Λ ^ m := by gcongr
  calc
    ‖(A ^ m) x - (B ^ m) x‖
        ≤ ‖(A ^ m) x‖ + ‖(B ^ m) x‖ := norm_sub_le _ _
    _ ≤ ‖A‖ ^ m * ‖x‖ + ‖B‖ ^ m * ‖x‖ :=
      add_le_add
        (boundedGenerator_pow_apply_norm_le A x m)
        (boundedGenerator_pow_apply_norm_le B x m)
    _ ≤ Λ ^ m * ‖x‖ + Λ ^ m * ‖x‖ := by gcongr
    _ = 2 * Λ ^ m * ‖x‖ := by ring

/--
If two bounded generators have identical Krylov data through order `N-1`,
their orbit difference is exactly the exponential-series tail beginning at
order `N`.
-/
theorem boundedGeneratorOrbit_difference_eq_tail
    {A B : E →L[ℂ] E} (z : ℂ) (x : E) (N : ℕ)
    (hprefix : ∀ m < N, (A ^ m) x = (B ^ m) x) :
    boundedGeneratorOrbit A z x -
        boundedGeneratorOrbit B z x =
      ∑' j : ℕ,
        (z ^ (j + N) / (j + N).factorial : ℂ) •
          ((A ^ (j + N)) x - (B ^ (j + N)) x) := by
  let fA : ℕ → E := fun m =>
    (z ^ m / m.factorial : ℂ) • ((A ^ m) x)
  let fB : ℕ → E := fun m =>
    (z ^ m / m.factorial : ℂ) • ((B ^ m) x)
  have hsA : Summable fA :=
    (boundedGeneratorOrbit_series_hasSum A z x).summable
  have hsB : Summable fB :=
    (boundedGeneratorOrbit_series_hasSum B z x).summable
  have hhead :
      (∑ m ∈ Finset.range N, fA m) =
        ∑ m ∈ Finset.range N, fB m := by
    apply Finset.sum_congr rfl
    intro m hm
    unfold fA fB
    rw [hprefix m (Finset.mem_range.mp hm)]
  have hsplitA := hsA.sum_add_tsum_nat_add N
  have hsplitB := hsB.sum_add_tsum_nat_add N
  rw [← (boundedGeneratorOrbit_series_hasSum A z x).tsum_eq,
    ← (boundedGeneratorOrbit_series_hasSum B z x).tsum_eq]
  change (∑' m, fA m) - ∑' m, fB m = _
  rw [← hsplitA, ← hsplitB, hhead, add_sub_add_left_eq_sub]
  have hsAtail : Summable (fun j : ℕ => fA (j + N)) :=
    hsA.comp_injective (by
      intro a b h
      exact Nat.add_right_cancel h)
  have hsBtail : Summable (fun j : ℕ => fB (j + N)) :=
    hsB.comp_injective (by
      intro a b h
      exact Nat.add_right_cancel h)
  rw [← hsAtail.tsum_sub hsBtail]
  apply tsum_congr
  intro j
  unfold fA fB
  module

/--
**Universal bounded-generator causal horizon.**

For any two bounded generators on any complete complex normed state space,
agreement of one initial Krylov orbit through order `N-1` forces their
entire orbits at complex parameter `z` to differ by at most the explicit
factorial remainder below.  This is dimension-free and requires neither
unitarity nor self-adjointness.
-/
theorem boundedGeneratorOrbit_difference_norm_le
    {A B : E →L[ℂ] E} {Λ : ℝ}
    (hΛ : 0 ≤ Λ) (hA : ‖A‖ ≤ Λ) (hB : ‖B‖ ≤ Λ)
    (z : ℂ) (x : E) (N : ℕ)
    (hprefix : ∀ m < N, (A ^ m) x = (B ^ m) x) :
    ‖boundedGeneratorOrbit A z x -
        boundedGeneratorOrbit B z x‖ ≤
      2 * ‖x‖ * (((‖z‖ * Λ) ^ N / N.factorial) *
        Real.exp (‖z‖ * Λ)) := by
  rw [boundedGeneratorOrbit_difference_eq_tail z x N hprefix]
  let r : ℝ := ‖z‖ * Λ
  let d : ℕ → E := fun j =>
    (z ^ (j + N) / (j + N).factorial : ℂ) •
      ((A ^ (j + N)) x - (B ^ (j + N)) x)
  let g : ℕ → ℝ := fun j =>
    2 * ‖x‖ * (r ^ (j + N) / (j + N).factorial)
  have hr : 0 ≤ r := mul_nonneg (norm_nonneg z) hΛ
  have hsExp : Summable (fun m : ℕ => r ^ m / m.factorial) :=
    Real.summable_pow_div_factorial r
  have hsG : Summable g := by
    unfold g
    exact (((summable_nat_add_iff N).2 hsExp).mul_left (2 * ‖x‖))
  have hterm (j : ℕ) : ‖d j‖ ≤ g j := by
    unfold d g r
    rw [norm_smul, norm_div, norm_pow, RCLike.norm_natCast]
    calc
      ‖z‖ ^ (j + N) / ((j + N).factorial : ℝ) *
          ‖(A ^ (j + N)) x - (B ^ (j + N)) x‖
          ≤ ‖z‖ ^ (j + N) / ((j + N).factorial : ℝ) *
              (2 * Λ ^ (j + N) * ‖x‖) := by
            gcongr
            exact boundedGenerator_pow_sub_norm_le hA hB x (j + N)
      _ = 2 * ‖x‖ * ((‖z‖ * Λ) ^ (j + N) /
            ((j + N).factorial : ℝ)) := by
        rw [mul_pow]
        ring
  have hsDnorm : Summable (fun j : ℕ => ‖d j‖) :=
    Summable.of_nonneg_of_le (fun _ => norm_nonneg _) hterm hsG
  have hsum : (∑' m : ℕ, r ^ m / m.factorial) = Real.exp r := by
    simpa only [Real.exp_eq_exp_ℝ] using
      (NormedSpace.expSeries_div_hasSum_exp r).tsum_eq
  have hsplit := hsExp.sum_add_tsum_nat_add N
  have htail :
      (∑' j : ℕ, r ^ (j + N) / (j + N).factorial) =
        Real.exp r -
          ∑ m ∈ Finset.range N, r ^ m / m.factorial := by
    rw [← hsum]
    linarith
  change ‖∑' j : ℕ, d j‖ ≤ _
  calc
    ‖∑' j : ℕ, d j‖ ≤ ∑' j : ℕ, ‖d j‖ :=
      norm_tsum_le_tsum_norm hsDnorm
    _ ≤ ∑' j : ℕ, g j := hsDnorm.tsum_le_tsum hterm hsG
    _ = 2 * ‖x‖ * (Real.exp r -
          ∑ m ∈ Finset.range N, r ^ m / m.factorial) := by
      unfold g
      rw [tsum_mul_left, htail]
    _ ≤ 2 * ‖x‖ * ((r ^ N / N.factorial) * Real.exp r) := by
      gcongr
      exact real_exp_sub_sum_le_factorial_tail r hr N
    _ = 2 * ‖x‖ * (((‖z‖ * Λ) ^ N / N.factorial) *
          Real.exp (‖z‖ * Λ)) := by rfl

/-- Scalar response of a continuous probe to a bounded-generator orbit. -/
def boundedGeneratorResponse
    (φ : E →L[ℂ] ℂ) (A : E →L[ℂ] E)
    (z : ℂ) (x : E) : ℂ :=
  φ (boundedGeneratorOrbit A z x)

/--
Every continuous linear probe obeys the same factorial causal horizon, with
only the unavoidable probe and initial-state norm prefactor.
-/
theorem boundedGeneratorResponse_difference_norm_le
    {A B : E →L[ℂ] E} {Λ : ℝ}
    (hΛ : 0 ≤ Λ) (hA : ‖A‖ ≤ Λ) (hB : ‖B‖ ≤ Λ)
    (φ : E →L[ℂ] ℂ) (z : ℂ) (x : E) (N : ℕ)
    (hprefix : ∀ m < N, (A ^ m) x = (B ^ m) x) :
    ‖boundedGeneratorResponse φ A z x -
        boundedGeneratorResponse φ B z x‖ ≤
      2 * ‖φ‖ * ‖x‖ *
        (((‖z‖ * Λ) ^ N / N.factorial) *
          Real.exp (‖z‖ * Λ)) := by
  unfold boundedGeneratorResponse
  rw [← map_sub]
  calc
    ‖φ (boundedGeneratorOrbit A z x -
        boundedGeneratorOrbit B z x)‖
        ≤ ‖φ‖ * ‖boundedGeneratorOrbit A z x -
            boundedGeneratorOrbit B z x‖ :=
      φ.le_opNorm _
    _ ≤ ‖φ‖ * (2 * ‖x‖ *
          (((‖z‖ * Λ) ^ N / N.factorial) *
            Real.exp (‖z‖ * Λ))) := by
      gcongr
      exact boundedGeneratorOrbit_difference_norm_le
        hΛ hA hB z x N hprefix
    _ = 2 * ‖φ‖ * ‖x‖ *
          (((‖z‖ * Λ) ^ N / N.factorial) *
            Real.exp (‖z‖ * Λ)) := by ring

/-- Power-series expansion of any continuous scalar response. -/
theorem boundedGeneratorResponse_series_hasSum
    (φ : E →L[ℂ] ℂ) (A : E →L[ℂ] E) (z : ℂ) (x : E) :
    HasSum
      (fun m : ℕ =>
        (z ^ m / m.factorial : ℂ) * φ ((A ^ m) x))
      (boundedGeneratorResponse φ A z x) := by
  have hs :=
    (boundedGeneratorOrbit_series_hasSum A z x).map φ φ.continuous
  unfold boundedGeneratorResponse
  convert hs using 1
  funext m
  simp

/--
Equality of the first `N` scalar response coefficients cancels the complete
head of the response series; equality of the underlying Krylov vectors is
not required.
-/
theorem boundedGeneratorResponse_difference_eq_tail_of_prefix
    (φ : E →L[ℂ] ℂ) {A B : E →L[ℂ] E}
    (z : ℂ) (x : E) (N : ℕ)
    (hprefix : ∀ m < N, φ ((A ^ m) x) = φ ((B ^ m) x)) :
    boundedGeneratorResponse φ A z x -
        boundedGeneratorResponse φ B z x =
      ∑' j : ℕ,
        (z ^ (j + N) / (j + N).factorial : ℂ) *
          (φ ((A ^ (j + N)) x) - φ ((B ^ (j + N)) x)) := by
  let fA : ℕ → ℂ := fun m =>
    (z ^ m / m.factorial : ℂ) * φ ((A ^ m) x)
  let fB : ℕ → ℂ := fun m =>
    (z ^ m / m.factorial : ℂ) * φ ((B ^ m) x)
  have hsA : Summable fA :=
    (boundedGeneratorResponse_series_hasSum φ A z x).summable
  have hsB : Summable fB :=
    (boundedGeneratorResponse_series_hasSum φ B z x).summable
  have hhead :
      (∑ m ∈ Finset.range N, fA m) =
        ∑ m ∈ Finset.range N, fB m := by
    apply Finset.sum_congr rfl
    intro m hm
    unfold fA fB
    rw [hprefix m (Finset.mem_range.mp hm)]
  have hsplitA := hsA.sum_add_tsum_nat_add N
  have hsplitB := hsB.sum_add_tsum_nat_add N
  rw [← (boundedGeneratorResponse_series_hasSum φ A z x).tsum_eq,
    ← (boundedGeneratorResponse_series_hasSum φ B z x).tsum_eq]
  change (∑' m, fA m) - ∑' m, fB m = _
  rw [← hsplitA, ← hsplitB, hhead, add_sub_add_left_eq_sub]
  have hsAtail : Summable (fun j : ℕ => fA (j + N)) :=
    hsA.comp_injective (by
      intro a b h
      exact Nat.add_right_cancel h)
  have hsBtail : Summable (fun j : ℕ => fB (j + N)) :=
    hsB.comp_injective (by
      intro a b h
      exact Nat.add_right_cancel h)
  rw [← hsAtail.tsum_sub hsBtail]
  apply tsum_congr
  intro j
  unfold fA fB
  ring

/--
Without exact prefix equality, the response difference splits into one
finite observed head and the complete unobserved tail.
-/
theorem boundedGeneratorResponse_difference_eq_prefix_add_tail
    (φ : E →L[ℂ] ℂ) (A B : E →L[ℂ] E)
    (z : ℂ) (x : E) (N : ℕ) :
    boundedGeneratorResponse φ A z x -
        boundedGeneratorResponse φ B z x =
      (∑ m ∈ Finset.range N,
        (z ^ m / m.factorial : ℂ) *
          (φ ((A ^ m) x) - φ ((B ^ m) x))) +
      ∑' j : ℕ,
        (z ^ (j + N) / (j + N).factorial : ℂ) *
          (φ ((A ^ (j + N)) x) - φ ((B ^ (j + N)) x)) := by
  let fA : ℕ → ℂ := fun m =>
    (z ^ m / m.factorial : ℂ) * φ ((A ^ m) x)
  let fB : ℕ → ℂ := fun m =>
    (z ^ m / m.factorial : ℂ) * φ ((B ^ m) x)
  have hsA : Summable fA :=
    (boundedGeneratorResponse_series_hasSum φ A z x).summable
  have hsB : Summable fB :=
    (boundedGeneratorResponse_series_hasSum φ B z x).summable
  have hsplitA := hsA.sum_add_tsum_nat_add N
  have hsplitB := hsB.sum_add_tsum_nat_add N
  have hsAtail : Summable (fun j : ℕ => fA (j + N)) :=
    hsA.comp_injective (by
      intro a b h
      exact Nat.add_right_cancel h)
  have hsBtail : Summable (fun j : ℕ => fB (j + N)) :=
    hsB.comp_injective (by
      intro a b h
      exact Nat.add_right_cancel h)
  rw [← (boundedGeneratorResponse_series_hasSum φ A z x).tsum_eq,
    ← (boundedGeneratorResponse_series_hasSum φ B z x).tsum_eq]
  change (∑' m, fA m) - ∑' m, fB m = _
  calc
    (∑' m, fA m) - ∑' m, fB m =
        (∑ m ∈ Finset.range N, fA m -
          ∑ m ∈ Finset.range N, fB m) +
        ((∑' j : ℕ, fA (j + N)) -
          ∑' j : ℕ, fB (j + N)) := by
      rw [← hsplitA, ← hsplitB]
      abel
    _ = (∑ m ∈ Finset.range N, (fA m - fB m)) +
        ∑' j : ℕ, (fA (j + N) - fB (j + N)) := by
      rw [Finset.sum_sub_distrib, hsAtail.tsum_sub hsBtail]
    _ = _ := by
      congr 1
      · apply Finset.sum_congr rfl
        intro m _hm
        unfold fA fB
        ring
      · apply tsum_congr
        intro j
        unfold fA fB
        ring

/--
**Universal scalar-record causal horizon.**

For arbitrary bounded generators, equality of only the first `N` observed
response coefficients forces the same dimension-free factorial bound.
-/
theorem boundedGeneratorResponse_difference_norm_le_of_prefix
    {A B : E →L[ℂ] E} {Λ : ℝ}
    (hΛ : 0 ≤ Λ) (hA : ‖A‖ ≤ Λ) (hB : ‖B‖ ≤ Λ)
    (φ : E →L[ℂ] ℂ) (z : ℂ) (x : E) (N : ℕ)
    (hprefix : ∀ m < N, φ ((A ^ m) x) = φ ((B ^ m) x)) :
    ‖boundedGeneratorResponse φ A z x -
        boundedGeneratorResponse φ B z x‖ ≤
      2 * ‖φ‖ * ‖x‖ *
        (((‖z‖ * Λ) ^ N / N.factorial) *
          Real.exp (‖z‖ * Λ)) := by
  rw [boundedGeneratorResponse_difference_eq_tail_of_prefix
    φ z x N hprefix]
  let r : ℝ := ‖z‖ * Λ
  let d : ℕ → ℂ := fun j =>
    (z ^ (j + N) / (j + N).factorial : ℂ) *
      (φ ((A ^ (j + N)) x) - φ ((B ^ (j + N)) x))
  let g : ℕ → ℝ := fun j =>
    2 * ‖φ‖ * ‖x‖ * (r ^ (j + N) / (j + N).factorial)
  have hr : 0 ≤ r := mul_nonneg (norm_nonneg z) hΛ
  have hsExp : Summable (fun m : ℕ => r ^ m / m.factorial) :=
    Real.summable_pow_div_factorial r
  have hsG : Summable g := by
    unfold g
    exact (((summable_nat_add_iff N).2 hsExp).mul_left
      (2 * ‖φ‖ * ‖x‖))
  have hprobe (m : ℕ) :
      ‖φ ((A ^ m) x) - φ ((B ^ m) x)‖ ≤
        ‖φ‖ * (2 * Λ ^ m * ‖x‖) := by
    rw [← map_sub]
    exact (φ.le_opNorm _).trans (by
      gcongr
      exact boundedGenerator_pow_sub_norm_le hA hB x m)
  have hterm (j : ℕ) : ‖d j‖ ≤ g j := by
    unfold d g r
    rw [norm_mul, norm_div, norm_pow, RCLike.norm_natCast]
    calc
      ‖z‖ ^ (j + N) / ((j + N).factorial : ℝ) *
          ‖φ ((A ^ (j + N)) x) - φ ((B ^ (j + N)) x)‖
          ≤ ‖z‖ ^ (j + N) / ((j + N).factorial : ℝ) *
              (‖φ‖ * (2 * Λ ^ (j + N) * ‖x‖)) := by
            gcongr
            exact hprobe (j + N)
      _ = 2 * ‖φ‖ * ‖x‖ *
          ((‖z‖ * Λ) ^ (j + N) /
            ((j + N).factorial : ℝ)) := by
        rw [mul_pow]
        ring
  have hsDnorm : Summable (fun j : ℕ => ‖d j‖) :=
    Summable.of_nonneg_of_le (fun _ => norm_nonneg _) hterm hsG
  have hsum : (∑' m : ℕ, r ^ m / m.factorial) = Real.exp r := by
    simpa only [Real.exp_eq_exp_ℝ] using
      (NormedSpace.expSeries_div_hasSum_exp r).tsum_eq
  have hsplit := hsExp.sum_add_tsum_nat_add N
  have htail :
      (∑' j : ℕ, r ^ (j + N) / (j + N).factorial) =
        Real.exp r -
          ∑ m ∈ Finset.range N, r ^ m / m.factorial := by
    rw [← hsum]
    linarith
  change ‖∑' j : ℕ, d j‖ ≤ _
  calc
    ‖∑' j : ℕ, d j‖ ≤ ∑' j : ℕ, ‖d j‖ :=
      norm_tsum_le_tsum_norm hsDnorm
    _ ≤ ∑' j : ℕ, g j := hsDnorm.tsum_le_tsum hterm hsG
    _ = 2 * ‖φ‖ * ‖x‖ * (Real.exp r -
          ∑ m ∈ Finset.range N, r ^ m / m.factorial) := by
      unfold g
      rw [tsum_mul_left, htail]
    _ ≤ 2 * ‖φ‖ * ‖x‖ *
          ((r ^ N / N.factorial) * Real.exp r) := by
      gcongr
      exact real_exp_sub_sum_le_factorial_tail r hr N
    _ = 2 * ‖φ‖ * ‖x‖ *
          (((‖z‖ * Λ) ^ N / N.factorial) *
            Real.exp (‖z‖ * Λ)) := by rfl

/--
Exact-tail universal scalar-response law.  Retaining the complete
exponential tail makes the estimate informative at linearly growing action.
-/
theorem boundedGeneratorResponse_difference_norm_le_of_prefix_exactTail
    {A B : E →L[ℂ] E} {Λ : ℝ}
    (hΛ : 0 ≤ Λ) (hA : ‖A‖ ≤ Λ) (hB : ‖B‖ ≤ Λ)
    (φ : E →L[ℂ] ℂ) (z : ℂ) (x : E) (N : ℕ)
    (hprefix : ∀ m < N, φ ((A ^ m) x) = φ ((B ^ m) x)) :
    ‖boundedGeneratorResponse φ A z x -
        boundedGeneratorResponse φ B z x‖ ≤
      2 * ‖φ‖ * ‖x‖ *
        (Real.exp (‖z‖ * Λ) -
          ∑ m ∈ Finset.range N,
            (‖z‖ * Λ) ^ m / m.factorial) := by
  rw [boundedGeneratorResponse_difference_eq_tail_of_prefix
    φ z x N hprefix]
  let r : ℝ := ‖z‖ * Λ
  let d : ℕ → ℂ := fun j =>
    (z ^ (j + N) / (j + N).factorial : ℂ) *
      (φ ((A ^ (j + N)) x) - φ ((B ^ (j + N)) x))
  let g : ℕ → ℝ := fun j =>
    2 * ‖φ‖ * ‖x‖ * (r ^ (j + N) / (j + N).factorial)
  have hr : 0 ≤ r := mul_nonneg (norm_nonneg z) hΛ
  have hsExp : Summable (fun m : ℕ => r ^ m / m.factorial) :=
    Real.summable_pow_div_factorial r
  have hsG : Summable g := by
    unfold g
    exact (((summable_nat_add_iff N).2 hsExp).mul_left
      (2 * ‖φ‖ * ‖x‖))
  have hprobe (m : ℕ) :
      ‖φ ((A ^ m) x) - φ ((B ^ m) x)‖ ≤
        ‖φ‖ * (2 * Λ ^ m * ‖x‖) := by
    rw [← map_sub]
    exact (φ.le_opNorm _).trans (by
      gcongr
      exact boundedGenerator_pow_sub_norm_le hA hB x m)
  have hterm (j : ℕ) : ‖d j‖ ≤ g j := by
    unfold d g r
    rw [norm_mul, norm_div, norm_pow, RCLike.norm_natCast]
    calc
      ‖z‖ ^ (j + N) / ((j + N).factorial : ℝ) *
          ‖φ ((A ^ (j + N)) x) - φ ((B ^ (j + N)) x)‖
          ≤ ‖z‖ ^ (j + N) / ((j + N).factorial : ℝ) *
              (‖φ‖ * (2 * Λ ^ (j + N) * ‖x‖)) := by
            gcongr
            exact hprobe (j + N)
      _ = 2 * ‖φ‖ * ‖x‖ *
          ((‖z‖ * Λ) ^ (j + N) /
            ((j + N).factorial : ℝ)) := by
        rw [mul_pow]
        ring
  have hsDnorm : Summable (fun j : ℕ => ‖d j‖) :=
    Summable.of_nonneg_of_le (fun _ => norm_nonneg _) hterm hsG
  have hsum : (∑' m : ℕ, r ^ m / m.factorial) = Real.exp r := by
    simpa only [Real.exp_eq_exp_ℝ] using
      (NormedSpace.expSeries_div_hasSum_exp r).tsum_eq
  have hsplit := hsExp.sum_add_tsum_nat_add N
  have htail :
      (∑' j : ℕ, r ^ (j + N) / (j + N).factorial) =
        Real.exp r -
          ∑ m ∈ Finset.range N, r ^ m / m.factorial := by
    rw [← hsum]
    linarith
  change ‖∑' j : ℕ, d j‖ ≤ _
  calc
    ‖∑' j : ℕ, d j‖ ≤ ∑' j : ℕ, ‖d j‖ :=
      norm_tsum_le_tsum_norm hsDnorm
    _ ≤ ∑' j : ℕ, g j := hsDnorm.tsum_le_tsum hterm hsG
    _ = 2 * ‖φ‖ * ‖x‖ * (Real.exp r -
          ∑ m ∈ Finset.range N, r ^ m / m.factorial) := by
      unfold g
      rw [tsum_mul_left, htail]
    _ = 2 * ‖φ‖ * ‖x‖ *
          (Real.exp (‖z‖ * Λ) -
            ∑ m ∈ Finset.range N,
              (‖z‖ * Λ) ^ m / m.factorial) := by rfl

/--
**Stable universal scalar-record causal horizon.**

Every observed coefficient may have its own calibration-error budget.  The
finite weighted error head is exposed exactly, while all unobserved orders
remain controlled by the universal generator tail.
-/
theorem boundedGeneratorResponse_difference_norm_le_of_approx_prefix
    {A B : E →L[ℂ] E} {Λ : ℝ}
    (hΛ : 0 ≤ Λ) (hA : ‖A‖ ≤ Λ) (hB : ‖B‖ ≤ Λ)
    (φ : E →L[ℂ] ℂ) (z : ℂ) (x : E) (N : ℕ)
    (η : ℕ → ℝ)
    (hη : ∀ m < N,
      ‖φ ((A ^ m) x) - φ ((B ^ m) x)‖ ≤ η m) :
    ‖boundedGeneratorResponse φ A z x -
        boundedGeneratorResponse φ B z x‖ ≤
      (∑ m ∈ Finset.range N,
        ‖z‖ ^ m / m.factorial * η m) +
      2 * ‖φ‖ * ‖x‖ *
        (Real.exp (‖z‖ * Λ) -
          ∑ m ∈ Finset.range N,
            (‖z‖ * Λ) ^ m / m.factorial) := by
  rw [boundedGeneratorResponse_difference_eq_prefix_add_tail
    φ A B z x N]
  let head : ℂ :=
    ∑ m ∈ Finset.range N,
      (z ^ m / m.factorial : ℂ) *
        (φ ((A ^ m) x) - φ ((B ^ m) x))
  let tail : ℂ :=
    ∑' j : ℕ,
      (z ^ (j + N) / (j + N).factorial : ℂ) *
        (φ ((A ^ (j + N)) x) - φ ((B ^ (j + N)) x))
  change ‖head + tail‖ ≤ _
  have hhead :
      ‖head‖ ≤
        ∑ m ∈ Finset.range N,
          ‖z‖ ^ m / m.factorial * η m := by
    unfold head
    calc
      ‖∑ m ∈ Finset.range N,
          (z ^ m / m.factorial : ℂ) *
            (φ ((A ^ m) x) - φ ((B ^ m) x))‖ ≤
          ∑ m ∈ Finset.range N,
            ‖(z ^ m / m.factorial : ℂ) *
              (φ ((A ^ m) x) - φ ((B ^ m) x))‖ :=
        norm_sum_le _ _
      _ ≤ ∑ m ∈ Finset.range N,
          ‖z‖ ^ m / m.factorial * η m := by
        apply Finset.sum_le_sum
        intro m hm
        rw [norm_mul, norm_div, norm_pow, RCLike.norm_natCast]
        exact mul_le_mul_of_nonneg_left
          (hη m (Finset.mem_range.mp hm)) (by positivity)
  let r : ℝ := ‖z‖ * Λ
  let d : ℕ → ℂ := fun j =>
    (z ^ (j + N) / (j + N).factorial : ℂ) *
      (φ ((A ^ (j + N)) x) - φ ((B ^ (j + N)) x))
  let g : ℕ → ℝ := fun j =>
    2 * ‖φ‖ * ‖x‖ * (r ^ (j + N) / (j + N).factorial)
  have hr : 0 ≤ r := mul_nonneg (norm_nonneg z) hΛ
  have hsExp : Summable (fun m : ℕ => r ^ m / m.factorial) :=
    Real.summable_pow_div_factorial r
  have hsG : Summable g := by
    unfold g
    exact (((summable_nat_add_iff N).2 hsExp).mul_left
      (2 * ‖φ‖ * ‖x‖))
  have hprobe (m : ℕ) :
      ‖φ ((A ^ m) x) - φ ((B ^ m) x)‖ ≤
        ‖φ‖ * (2 * Λ ^ m * ‖x‖) := by
    rw [← map_sub]
    exact (φ.le_opNorm _).trans (by
      gcongr
      exact boundedGenerator_pow_sub_norm_le hA hB x m)
  have hterm (j : ℕ) : ‖d j‖ ≤ g j := by
    unfold d g r
    rw [norm_mul, norm_div, norm_pow, RCLike.norm_natCast]
    calc
      ‖z‖ ^ (j + N) / ((j + N).factorial : ℝ) *
          ‖φ ((A ^ (j + N)) x) - φ ((B ^ (j + N)) x)‖
          ≤ ‖z‖ ^ (j + N) / ((j + N).factorial : ℝ) *
              (‖φ‖ * (2 * Λ ^ (j + N) * ‖x‖)) := by
            gcongr
            exact hprobe (j + N)
      _ = 2 * ‖φ‖ * ‖x‖ *
          ((‖z‖ * Λ) ^ (j + N) /
            ((j + N).factorial : ℝ)) := by
        rw [mul_pow]
        ring
  have hsDnorm : Summable (fun j : ℕ => ‖d j‖) :=
    Summable.of_nonneg_of_le (fun _ => norm_nonneg _) hterm hsG
  have hsum : (∑' m : ℕ, r ^ m / m.factorial) = Real.exp r := by
    simpa only [Real.exp_eq_exp_ℝ] using
      (NormedSpace.expSeries_div_hasSum_exp r).tsum_eq
  have hsplit := hsExp.sum_add_tsum_nat_add N
  have htailSum :
      (∑' j : ℕ, r ^ (j + N) / (j + N).factorial) =
        Real.exp r -
          ∑ m ∈ Finset.range N, r ^ m / m.factorial := by
    rw [← hsum]
    linarith
  have htail :
      ‖tail‖ ≤
        2 * ‖φ‖ * ‖x‖ *
          (Real.exp (‖z‖ * Λ) -
            ∑ m ∈ Finset.range N,
              (‖z‖ * Λ) ^ m / m.factorial) := by
    change ‖∑' j : ℕ, d j‖ ≤ _
    calc
      ‖∑' j : ℕ, d j‖ ≤ ∑' j : ℕ, ‖d j‖ :=
        norm_tsum_le_tsum_norm hsDnorm
      _ ≤ ∑' j : ℕ, g j := hsDnorm.tsum_le_tsum hterm hsG
      _ = 2 * ‖φ‖ * ‖x‖ * (Real.exp r -
            ∑ m ∈ Finset.range N, r ^ m / m.factorial) := by
        unfold g
        rw [tsum_mul_left, htailSum]
      _ = 2 * ‖φ‖ * ‖x‖ *
            (Real.exp (‖z‖ * Λ) -
              ∑ m ∈ Finset.range N,
                (‖z‖ * Λ) ^ m / m.factorial) := by rfl
  exact (norm_add_le head tail).trans (add_le_add hhead htail)

/--
**Critical universal scalar-record causal horizon.**

At action at most `N / exp(1)`, agreement of the first `N` observed
coefficients forces an inverse-square-root response discrepancy on every
complete complex normed space.
-/
theorem boundedGeneratorResponse_critical_bound
    {A B : E →L[ℂ] E} {Λ : ℝ}
    (φ : E →L[ℂ] ℂ) (z : ℂ) (x : E) (N : ℕ)
    (hN : 0 < N) (hΛ : 0 ≤ Λ)
    (hA : ‖A‖ ≤ Λ) (hB : ‖B‖ ≤ Λ)
    (hprefix : ∀ m < N, φ ((A ^ m) x) = φ ((B ^ m) x))
    (hcritical : ‖z‖ * Λ ≤ (N : ℝ) / Real.exp 1) :
    ‖boundedGeneratorResponse φ A z x -
        boundedGeneratorResponse φ B z x‖ ≤
      4 * ‖φ‖ * ‖x‖ /
        Real.sqrt (2 * Real.pi * (N : ℝ)) := by
  calc
    _ ≤ 2 * ‖φ‖ * ‖x‖ *
          (Real.exp (‖z‖ * Λ) -
            ∑ m ∈ Finset.range N,
              (‖z‖ * Λ) ^ m / m.factorial) :=
      boundedGeneratorResponse_difference_norm_le_of_prefix_exactTail
        hΛ hA hB φ z x N hprefix
    _ ≤ 2 * ‖φ‖ * ‖x‖ *
          (2 / Real.sqrt (2 * Real.pi * (N : ℝ))) := by
      apply mul_le_mul_of_nonneg_left
      · exact real_exp_sub_sum_le_inv_sqrt_critical
          N hN (‖z‖ * Λ)
          (mul_nonneg (norm_nonneg z) hΛ) hcritical
      · positivity
    _ = 4 * ‖φ‖ * ‖x‖ /
          Real.sqrt (2 * Real.pi * (N : ℝ)) := by ring

/--
Critical stable law with an arbitrary finite calibration-error profile.
-/
theorem boundedGeneratorResponse_approx_prefix_critical_bound
    {A B : E →L[ℂ] E} {Λ : ℝ}
    (φ : E →L[ℂ] ℂ) (z : ℂ) (x : E) (N : ℕ)
    (hN : 0 < N) (hΛ : 0 ≤ Λ)
    (hA : ‖A‖ ≤ Λ) (hB : ‖B‖ ≤ Λ)
    (η : ℕ → ℝ)
    (hη : ∀ m < N,
      ‖φ ((A ^ m) x) - φ ((B ^ m) x)‖ ≤ η m)
    (hcritical : ‖z‖ * Λ ≤ (N : ℝ) / Real.exp 1) :
    ‖boundedGeneratorResponse φ A z x -
        boundedGeneratorResponse φ B z x‖ ≤
      (∑ m ∈ Finset.range N,
        ‖z‖ ^ m / m.factorial * η m) +
      4 * ‖φ‖ * ‖x‖ /
        Real.sqrt (2 * Real.pi * (N : ℝ)) := by
  calc
    _ ≤ (∑ m ∈ Finset.range N,
          ‖z‖ ^ m / m.factorial * η m) +
        2 * ‖φ‖ * ‖x‖ *
          (Real.exp (‖z‖ * Λ) -
            ∑ m ∈ Finset.range N,
              (‖z‖ * Λ) ^ m / m.factorial) :=
      boundedGeneratorResponse_difference_norm_le_of_approx_prefix
        hΛ hA hB φ z x N η hη
    _ ≤ (∑ m ∈ Finset.range N,
          ‖z‖ ^ m / m.factorial * η m) +
        2 * ‖φ‖ * ‖x‖ *
          (2 / Real.sqrt (2 * Real.pi * (N : ℝ))) := by
      gcongr
      exact real_exp_sub_sum_le_inv_sqrt_critical
        N hN (‖z‖ * Λ)
        (mul_nonneg (norm_nonneg z) hΛ) hcritical
    _ = (∑ m ∈ Finset.range N,
          ‖z‖ ^ m / m.factorial * η m) +
        4 * ‖φ‖ * ‖x‖ /
          Real.sqrt (2 * Real.pi * (N : ℝ)) := by ring

/-- Exact critical action scale for the universal scalar-record law. -/
def generatorCausalCriticalThreshold (N : ℕ) : ℝ :=
  (N : ℝ) / Real.exp 1

/-- Geometric form of the factorial tail below its explicit linear scale. -/
theorem factorialTail_le_exp_three_pow
    (N : ℕ) (hN : 0 < N) (x : ℝ) (hx0 : 0 ≤ x)
    (hx : x ≤ (N : ℝ) / (3 * Real.exp 1)) :
    (x ^ N / N.factorial) * Real.exp x ≤
      (Real.exp 1 / 3) ^ N := by
  have h := factorialTail_linear_bound_exp_three N hN x hx0 hx
  linarith

/-- Explicit universal scale below which a hidden order-`N` response
separation is forced to vanish geometrically. -/
def generatorCausalLinearThreshold (N : ℕ) : ℝ :=
  (N : ℝ) / (3 * Real.exp 1)

/--
Below the linear energy--parameter threshold, every bounded-generator
response discrepancy is geometrically small in the length of the common
Krylov prefix.
-/
theorem boundedGeneratorResponse_linear_bound
    {A B : E →L[ℂ] E} {Λ : ℝ}
    (hΛ : 0 ≤ Λ) (hA : ‖A‖ ≤ Λ) (hB : ‖B‖ ≤ Λ)
    (φ : E →L[ℂ] ℂ) (z : ℂ) (x : E) (N : ℕ) (hN : 0 < N)
    (hprefix : ∀ m < N, φ ((A ^ m) x) = φ ((B ^ m) x))
    (hthreshold : ‖z‖ * Λ ≤ generatorCausalLinearThreshold N) :
    ‖boundedGeneratorResponse φ A z x -
        boundedGeneratorResponse φ B z x‖ ≤
      2 * ‖φ‖ * ‖x‖ * (Real.exp 1 / 3) ^ N := by
  have htail :
      (((‖z‖ * Λ) ^ N / N.factorial) *
          Real.exp (‖z‖ * Λ)) ≤
        (Real.exp 1 / 3) ^ N := by
    exact factorialTail_le_exp_three_pow N hN (‖z‖ * Λ)
      (mul_nonneg (norm_nonneg z) hΛ) hthreshold
  exact (boundedGeneratorResponse_difference_norm_le_of_prefix
    hΛ hA hB φ z x N hprefix).trans (by gcongr)

/--
**Universal linear necessity.**

Along any cofinal sequence of exactly shared Krylov prefixes, a response gap
bounded below by one positive constant eventually forces the dimensionless
generator scale `‖z‖ Λ` to exceed a fixed positive multiple of the prefix
length.  This holds for arbitrary bounded, possibly non-normal generators
on arbitrary complete complex normed state spaces.
-/
theorem persistentBoundedGeneratorSeparation_forces_linear_scale
    (N : ℕ → ℕ) (hN : ∀ k, 0 < N k)
    (hNtop : Filter.Tendsto N Filter.atTop Filter.atTop)
    (A B : ℕ → E →L[ℂ] E) (Λ : ℕ → ℝ)
    (φ : E →L[ℂ] ℂ) (z : ℂ) (x : E)
    (ε : ℝ) (hε : 0 < ε)
    (hΛ : ∀ k, 0 ≤ Λ k)
    (hA : ∀ k, ‖A k‖ ≤ Λ k)
    (hB : ∀ k, ‖B k‖ ≤ Λ k)
    (hprefix : ∀ k m, m < N k →
      φ (((A k) ^ m) x) = φ (((B k) ^ m) x))
    (hgap : ∀ k, ε ≤
      ‖boundedGeneratorResponse φ (A k) z x -
        boundedGeneratorResponse φ (B k) z x‖) :
    ∀ᶠ k : ℕ in Filter.atTop,
      generatorCausalLinearThreshold (N k) < ‖z‖ * Λ k := by
  have hgeo :
      Filter.Tendsto
        (fun k : ℕ =>
          2 * ‖φ‖ * ‖x‖ * (Real.exp 1 / 3) ^ N k)
        Filter.atTop (nhds 0) := by
    simpa using
      ((tendsto_pow_atTop_nhds_zero_of_lt_one
          (by positivity : (0 : ℝ) ≤ Real.exp 1 / 3)
          (by
            rw [div_lt_one (by norm_num : (0 : ℝ) < 3)]
            exact Real.exp_one_lt_three)).comp hNtop).const_mul
        (2 * ‖φ‖ * ‖x‖)
  have heventually :
      ∀ᶠ k : ℕ in Filter.atTop,
        2 * ‖φ‖ * ‖x‖ * (Real.exp 1 / 3) ^ N k < ε :=
    (tendsto_order.1 hgeo).2 ε hε
  filter_upwards [heventually] with k hsmall
  by_contra hnot
  have hthreshold :
      ‖z‖ * Λ k ≤ generatorCausalLinearThreshold (N k) :=
    le_of_not_gt hnot
  have hcausal :=
    boundedGeneratorResponse_linear_bound
      (hΛ k) (hA k) (hB k) φ z x (N k) (hN k)
      (hprefix k) hthreshold
  exact (not_lt_of_ge ((hgap k).trans hcausal)) hsmall

/--
**Critical universal linear necessity.**

Along any cofinal sequence of exactly shared scalar response prefixes, a
fixed positive response separation eventually forces action strictly above
`N / exp(1)`.  The estimate at equality decays as `N⁻¹ᐟ²`.
-/
theorem persistentBoundedGeneratorSeparation_forces_critical_scale
    (N : ℕ → ℕ) (hN : ∀ k, 0 < N k)
    (hNtop : Filter.Tendsto N Filter.atTop Filter.atTop)
    (A B : ℕ → E →L[ℂ] E) (Λ : ℕ → ℝ)
    (φ : E →L[ℂ] ℂ) (z : ℂ) (x : E)
    (ε : ℝ) (hε : 0 < ε)
    (hΛ : ∀ k, 0 ≤ Λ k)
    (hA : ∀ k, ‖A k‖ ≤ Λ k)
    (hB : ∀ k, ‖B k‖ ≤ Λ k)
    (hprefix : ∀ k m, m < N k →
      φ (((A k) ^ m) x) = φ (((B k) ^ m) x))
    (hgap : ∀ k, ε ≤
      ‖boundedGeneratorResponse φ (A k) z x -
        boundedGeneratorResponse φ (B k) z x‖) :
    ∀ᶠ k : ℕ in Filter.atTop,
      generatorCausalCriticalThreshold (N k) < ‖z‖ * Λ k := by
  have hNreal :
      Filter.Tendsto (fun k : ℕ => (N k : ℝ))
        Filter.atTop Filter.atTop :=
    tendsto_natCast_atTop_atTop.comp hNtop
  have hinside :
      Filter.Tendsto
        (fun k : ℕ => 2 * Real.pi * (N k : ℝ))
        Filter.atTop Filter.atTop :=
    Filter.Tendsto.const_mul_atTop (by positivity) hNreal
  have hsqrt :
      Filter.Tendsto
        (fun k : ℕ => Real.sqrt (2 * Real.pi * (N k : ℝ)))
        Filter.atTop Filter.atTop :=
    Real.tendsto_sqrt_atTop.comp hinside
  have hcriticalBound :
      Filter.Tendsto
        (fun k : ℕ =>
          4 * ‖φ‖ * ‖x‖ /
            Real.sqrt (2 * Real.pi * (N k : ℝ)))
        Filter.atTop (nhds 0) :=
    Filter.Tendsto.div_atTop tendsto_const_nhds hsqrt
  have heventually :
      ∀ᶠ k : ℕ in Filter.atTop,
        4 * ‖φ‖ * ‖x‖ /
            Real.sqrt (2 * Real.pi * (N k : ℝ)) < ε :=
    (tendsto_order.1 hcriticalBound).2 ε hε
  filter_upwards [heventually] with k hsmall
  by_contra hnot
  have hthreshold :
      ‖z‖ * Λ k ≤ (N k : ℝ) / Real.exp 1 := by
    exact le_of_not_gt (by
      simpa [generatorCausalCriticalThreshold] using hnot)
  have hcausal :=
    boundedGeneratorResponse_critical_bound
      φ z x (N k) (hN k) (hΛ k) (hA k) (hB k)
      (hprefix k) hthreshold
  exact (not_lt_of_ge ((hgap k).trans hcausal)) hsmall

