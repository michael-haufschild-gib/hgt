import GaloisForLFunctions.RHTower.XiUpperEndHypertranscendence
import GaloisForLFunctions.HTGeometry.AffineFirstOrderDifferentialAlgebraicity
import GaloisForLFunctions.HTGeometry.ExponentialLinearIndependence

/-!
# Exact relations in exponentially marked Xi

The actual upper-end germs `xi(-I*z) * exp(a*z)` have precisely the polynomial relations obtained
by grouping monomials with equal total degree and equal sum of exponential parameters. The proof
embeds the additive group algebra of complex parameters in the field of exponential germs and
uses unconditional Xi hypertranscendence after differential-algebraic coefficient-field extension.

For parameters `I * log p`, unique prime factorization separates all monomials. Consequently the
whole prime-indexed source family is algebraically independent. Any two distinct complex
parameters also give an algebraically independent pair. These are identities of function germs;
no assertion about independence of values at an individual Xi zero is made.
-/

open Filter Set
open GaloisForLFunctions GaloisForLFunctions.HTGeometry
open scoped Differential UpperEndDifferentialInstances UpperEndComplexTowerInstances

noncomputable section
namespace RHTower.XiExponentialSourceRelations

/-- The entire function `exp(a*z)`, viewed as an upper-end analytic germ. -/
def expAnalytic (a : ℂ) : upperEndAnalyticSubring :=
  ⟨((fun z : ℂ => Complex.exp (a * z)) : Germ upperEndFilter ℂ),
    ⟨_, 0, by intro z hz; fun_prop, rfl⟩⟩

/-- The same exponential in the actual upper-end meromorphic field. -/
def expMero (a : ℂ) : upperEndMeroField :=
  algebraMap upperEndAnalyticSubring upperEndMeroField (expAnalytic a)

/-- The exact first-order equation in the analytic carrier. -/
theorem deriv_expAnalytic (a : ℂ) :
    upperEndAnalyticDeriv (expAnalytic a) =
      upperEndPolyToAnalytic (Polynomial.C a) * expAnalytic a := by
  apply Subtype.ext
  change upperEndGermDeriv ((fun z : ℂ => Complex.exp (a * z)) : Germ upperEndFilter ℂ) =
    ((fun z : ℂ => (Polynomial.C a).eval z) : Germ upperEndFilter ℂ) *
      ((fun z : ℂ => Complex.exp (a * z)) : Germ upperEndFilter ℂ)
  rw [upperEndGermDeriv_coe]
  have hf : deriv (fun z : ℂ => Complex.exp (a * z)) =
      fun z : ℂ => a * Complex.exp (a * z) := by
    funext z
    simpa only [mul_one, id_eq, mul_comm] using ((hasDerivAt_id z).const_mul a).cexp.deriv
  rw [hf]
  simp only [Polynomial.eval_C]
  rfl

/-- The exact first-order equation in the meromorphic carrier. -/
theorem deriv_expMero (a : ℂ) :
    (expMero a)′ = algebraMap ℂ upperEndMeroField a * expMero a := by
  unfold expMero
  rw [upperEndMeroFieldDifferential_algebraMap, deriv_expAnalytic, map_mul]
  rfl

/-- Addition of parameters is multiplication of exponential germs. -/
theorem expMero_add (a b : ℂ) : expMero (a + b) = expMero a * expMero b := by
  unfold expMero
  rw [← map_mul]
  congr 1
  apply Subtype.ext
  change ((fun z : ℂ => Complex.exp ((a + b) * z)) : Germ upperEndFilter ℂ) = _
  have hf : (fun z : ℂ => Complex.exp ((a + b) * z)) =
      fun z : ℂ => Complex.exp (a * z) * Complex.exp (b * z) := by
    funext z
    rw [add_mul, Complex.exp_add]
  rw [hf]
  rfl

/-- The zero parameter represents the constant unit. -/
theorem expMero_zero : expMero 0 = 1 := by
  unfold expMero
  rw [← map_one (algebraMap upperEndAnalyticSubring upperEndMeroField)]
  congr 1
  apply Subtype.ext
  change ((fun z : ℂ => Complex.exp (0 * z)) : Germ upperEndFilter ℂ) = 1
  have hf : (fun z : ℂ => Complex.exp (0 * z)) = (1 : ℂ → ℂ) := by
    funext z
    simp
  rw [hf]
  exact (Germ.coeRingHom upperEndFilter).map_one

/-- Every exponential germ has an inverse. -/
theorem expMero_ne_zero (a : ℂ) : expMero a ≠ 0 := by
  have h : expMero a * expMero (-a) = 1 := by rw [← expMero_add, add_neg_cancel, expMero_zero]
  exact left_ne_zero_of_mul_eq_one h

/-- Each exponential is differentially algebraic over the complex constants. -/
theorem expMero_differentialAlgebraic (a : ℂ) :
    DifferentialAlgebraicOver ℂ (expMero a) :=
  differentialAlgebraicOver_of_deriv_eq_base_mul a (deriv_expMero a)

/-- The differential field generated by all complex exponential germs. -/
def expField : IntermediateField ℂ upperEndMeroField :=
  differentialAdjoin ℂ (Set.range expMero)

/-- Actual Xi remains hypertranscendental after adjoining every exponential germ. -/
theorem xi_hypertranscendental_expField :
    HypertranscendentalOver expField RHTower.xiRotatedUpperEndCarrier := by
  apply (hypertranscendentalOver_differentialAdjoin_iff ?_).2
  · rw [hypertranscendentalOver_iff_differentialIndependent_singleton]
    exact DifferentialIndependent.restrictScalars
      ((hypertranscendentalOver_iff_differentialIndependent_singleton _ _).1
        RHTower.xiRotatedUpperEndCarrier_hypertranscendentalOver)
  · rintro _ ⟨a, rfl⟩
    exact expMero_differentialAlgebraic a

/-- In particular, Xi is transcendental over the full exponential coefficient field. -/
theorem xi_transcendental_expField : Transcendental expField RHTower.xiRotatedUpperEndCarrier :=
  ((hypertranscendentalOver_iff_differentialIndependent_singleton _ _).1
    xi_hypertranscendental_expField).algebraicIndependent.transcendental ()

/-- Distinct exponential germs are linearly independent by constant-field Artin shortening. -/
theorem expMero_linearIndependent : LinearIndependent ℂ expMero := by
  classical
  rw [linearIndependent_iff_finset_linearIndependent]
  intro s
  rw [Fintype.linearIndependent_iff]
  intro c hc
  let F := (algebraMap ℂ upperEndMeroField).fieldRange
  have hconst : ∀ x ∈ F, x′ = 0 := by
    rintro _ ⟨a, rfl⟩
    exact upperEndMero_deriv_complexConstant a
  have h := eq_zero_of_sum_expLike_eq_zero F
    (fun a ha => by rw [hconst a ha]; exact F.zero_mem)
    (fun j : s => expMero j) (fun j : s => algebraMap ℂ upperEndMeroField j)
    (fun j => expMero_ne_zero j) (fun j => deriv_expMero j)
    (fun j => ⟨j, rfl⟩) ?_ (fun j => algebraMap ℂ upperEndMeroField (c j))
    (fun j => ⟨c j, rfl⟩) ?_
  · intro j
    exact (algebraMap ℂ upperEndMeroField).injective (by simpa using h j)
  · intro i j hij x hx hx0
    rw [hconst x hx]
    exact Ne.symm (mul_ne_zero
      (sub_ne_zero.mpr (fun heq => hij (Subtype.ext
        ((algebraMap ℂ upperEndMeroField).injective heq)))) hx0)
  · simpa only [Algebra.smul_def, Function.comp_apply] using hc

/-- The additive parameter group maps multiplicatively into the exponential field. -/
def expFieldHom : Multiplicative ℂ →* expField where
  toFun a := ⟨expMero a.toAdd, subset_differentialAdjoin ℂ _ (Set.mem_range_self _)⟩
  map_one' := Subtype.ext expMero_zero
  map_mul' a b := Subtype.ext (expMero_add a.toAdd b.toAdd)

/-- Evaluation of the additive group algebra in the exponential field. -/
def expAlgebra : AddMonoidAlgebra ℂ ℂ →ₐ[ℂ] expField :=
  AddMonoidAlgebra.lift ℂ expField ℂ expFieldHom

/-- Exponential evaluation faithfully embeds the entire group algebra. -/
theorem expAlgebra_injective : Function.Injective expAlgebra := by
  apply (injective_iff_map_eq_zero _).2
  intro f hf
  apply AddMonoidAlgebra.coeff_injective
  have hsum : (Finsupp.linearCombination ℂ expMero) f.coeff = 0 := by
    have h := congrArg (fun x : expField => (x : upperEndMeroField)) hf
    simpa [expAlgebra, AddMonoidAlgebra.lift_apply, expFieldHom,
      Finsupp.linearCombination_apply, Finsupp.sum] using h
  simpa using (linearIndependent_iff.1 expMero_linearIndependent) f.coeff hsum

/-- Evaluate the polynomial variable at actual Xi and group-algebra coefficients at exponentials. -/
def xiPolynomialEvaluation : Polynomial (AddMonoidAlgebra ℂ ℂ) →ₐ[ℂ] upperEndMeroField :=
  ((Polynomial.aeval RHTower.xiRotatedUpperEndCarrier).restrictScalars ℂ).comp
    (Polynomial.mapAlgHom expAlgebra)

/-- Xi introduces no polynomial relations over the exponential group algebra. -/
theorem xiPolynomialEvaluation_injective : Function.Injective xiPolynomialEvaluation :=
  (transcendental_iff_injective.1 xi_transcendental_expField).comp
    (Polynomial.map_injective expAlgebra.toRingHom expAlgebra_injective)


/-- The actual exponentially marked Xi carrier, represented by `xi(-I*z) * exp(a(i)*z)`. -/
def source {ι : Type*} (a : ι → ℂ) (i : ι) : upperEndMeroField :=
  RHTower.xiRotatedUpperEndCarrier * expMero (a i)

/-- Replace each marked source by the formal monomial `T * [a(i)]`. -/
def normalForm {ι : Type*} (a : ι → ℂ) :
    MvPolynomial ι ℂ →ₐ[ℂ] Polynomial (AddMonoidAlgebra ℂ ℂ) :=
  MvPolynomial.aeval (fun i => Polynomial.monomial 1 (AddMonoidAlgebra.single (a i) 1))

/-- Evaluation of one formal degree-parameter monomial. -/
theorem xiPolynomialEvaluation_monomial (d : ℕ) (a c : ℂ) :
    xiPolynomialEvaluation (Polynomial.monomial d (AddMonoidAlgebra.single a c)) =
      algebraMap ℂ upperEndMeroField c * expMero a * RHTower.xiRotatedUpperEndCarrier ^ d := by
  simp [xiPolynomialEvaluation, Polynomial.aeval_def, expAlgebra,
    AddMonoidAlgebra.lift_single, expFieldHom, Algebra.smul_def]

/-- Actual source evaluation factors through the formal degree-parameter algebra. -/
theorem source_evaluation_factorization {ι : Type*} (a : ι → ℂ) :
    MvPolynomial.aeval (source a) = xiPolynomialEvaluation.comp (normalForm a) := by
  apply MvPolynomial.algHom_ext
  intro i
  simp [normalForm, xiPolynomialEvaluation_monomial, source, mul_comm]

/-- A source relation vanishes exactly when its formal normal form vanishes. -/
theorem source_relation_iff_normalForm_zero {ι : Type*} (a : ι → ℂ)
    (P : MvPolynomial ι ℂ) :
    MvPolynomial.aeval (source a) P = 0 ↔ normalForm a P = 0 := by
  rw [source_evaluation_factorization]
  exact (map_eq_zero_iff _ xiPolynomialEvaluation_injective)

/-- Total degree of a finitely supported monomial exponent vector. -/
def degree {ι : Type*} (m : ι →₀ ℕ) : ℕ := m.sum fun _ n => n

/-- Sum of the exponential parameters, counted with monomial multiplicity. -/
def weight {ι : Type*} (a : ι → ℂ) (m : ι →₀ ℕ) : ℂ := m.sum fun i n => n • a i

/-- Total degree is additive. -/
theorem degree_add {ι : Type*} (m n : ι →₀ ℕ) : degree (m + n) = degree m + degree n :=
  Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl)

/-- Degree of a single-variable power. -/
theorem degree_single {ι : Type*} (i : ι) (n : ℕ) : degree (Finsupp.single i n) = n := by
  simp [degree]

/-- The summed parameter is additive. -/
theorem weight_add {ι : Type*} (a : ι → ℂ) (m n : ι →₀ ℕ) :
    weight a (m + n) = weight a m + weight a n :=
  Finsupp.sum_add_index' (fun _ => zero_nsmul _) (fun _ _ _ => add_nsmul _ _ _)

/-- Parameter of a single-variable power. -/
theorem weight_single {ι : Type*} (a : ι → ℂ) (i : ι) (n : ℕ) :
    weight a (Finsupp.single i n) = n • a i := by
  simp [weight]

/-- Every monomial has exactly one degree-parameter normal form. -/
theorem normalForm_monomial {ι : Type*} (a : ι → ℂ) (m : ι →₀ ℕ) (c : ℂ) :
    normalForm a (MvPolynomial.monomial m c) =
      Polynomial.monomial (degree m) (AddMonoidAlgebra.single (weight a m) c) := by
  classical
  induction m using Finsupp.induction with
  | zero =>
      simp [normalForm, degree, weight]
  | @single_add i n m hi hn ih =>
      rw [MvPolynomial.monomial_single_add, map_mul, map_pow, ih]
      simp [normalForm, degree_add, degree_single, weight_add, weight_single,
        Polynomial.monomial_pow, Polynomial.monomial_mul_monomial,
        AddMonoidAlgebra.single_pow]


/-- Normal-form coefficients are precisely the sums over degree-parameter collisions. -/
theorem normalForm_coefficient {ι : Type*} (a : ι → ℂ) (P : MvPolynomial ι ℂ)
    (d : ℕ) (b : ℂ) :
    ((normalForm a P).coeff d).coeff b =
      ∑ m ∈ P.support, if degree m = d ∧ weight a m = b then MvPolynomial.coeff m P else 0 := by
  classical
  conv_lhs => rw [P.as_sum]
  simp only [map_sum, Polynomial.finsetSum_coeff, normalForm_monomial]
  rw [AddMonoidAlgebra.coeff_sum, Finsupp.finsetSum_apply]
  apply Finset.sum_congr rfl
  intro m hm
  by_cases hd : degree m = d <;> by_cases hb : weight a m = b <;>
    simp [Polynomial.coeff_monomial, hd, hb, AddMonoidAlgebra.coeff_single]

/-- The complete polynomial-relation test for arbitrary exponentially marked Xi sources. -/
theorem source_relation_iff_grouped_coefficients {ι : Type*} (a : ι → ℂ)
    (P : MvPolynomial ι ℂ) :
    MvPolynomial.aeval (source a) P = 0 ↔
      ∀ d b, (∑ m ∈ P.support,
        if degree m = d ∧ weight a m = b then MvPolynomial.coeff m P else 0) = 0 := by
  classical
  rw [source_relation_iff_normalForm_zero]
  simp_rw [← normalForm_coefficient]
  constructor
  · intro h d b
    simp [h]
  · intro h
    apply Polynomial.ext
    intro d
    apply AddMonoidAlgebra.coeff_injective
    apply Finsupp.ext
    intro b
    simpa using h d b

/-- Distinct degree-parameter tags force algebraic independence of the marked source family. -/
theorem source_algebraicIndependent_of_tag_injective {ι : Type*} (a : ι → ℂ)
    (ha : Function.Injective (fun m : ι →₀ ℕ => (degree m, weight a m))) :
    AlgebraicIndependent ℂ (source a) := by
  classical
  rw [algebraicIndependent_iff]
  intro P hP
  have h := (source_relation_iff_grouped_coefficients a P).1 hP
  apply MvPolynomial.ext
  intro m
  have hm := h (degree m) (weight a m)
  have heq : (∑ k ∈ P.support,
      if degree k = degree m ∧ weight a k = weight a m then MvPolynomial.coeff k P else 0) =
      MvPolynomial.coeff m P := by
    rw [Finset.sum_eq_single m]
    · simp
    · intro k hk hkm
      rw [if_neg (fun h => hkm (ha (Prod.ext h.1 h.2)))]
    · intro hm
      simp [MvPolynomial.notMem_support_iff.mp hm]
  simpa only [heq, MvPolynomial.coeff_zero] using hm

/-- Rotated parameter representing `p^(-s)` when `s = -I*z`. -/
def primeParameter (p : Nat.Primes) : ℂ := Complex.I * (Real.log (p : ℕ) : ℂ)

/-- Prime parameters recover the logarithm of the unique-factorization monomial. -/
theorem weight_primeParameter (m : Nat.Primes →₀ ℕ) :
    weight primeParameter m =
      Complex.I * ((m.sum fun p k => (k : ℝ) * Real.log (p : ℕ) : ℝ) : ℂ) := by
  classical
  simp only [weight, primeParameter, Finsupp.sum, Complex.ofReal_sum,
    Complex.ofReal_mul, Complex.ofReal_natCast, Finset.mul_sum, nsmul_eq_mul]
  apply Finset.sum_congr rfl
  intro p hp
  ring

/-- The actual prime-indexed Xi source family is algebraically independent over the constants. -/
theorem prime_source_algebraicIndependent : AlgebraicIndependent ℂ (source primeParameter) := by
  apply source_algebraicIndependent_of_tag_injective
  intro m n h
  apply log_prime_nat_relation_eq
  have hw := congrArg Prod.snd h
  change weight primeParameter m = weight primeParameter n at hw
  rw [weight_primeParameter, weight_primeParameter] at hw
  exact Complex.ofReal_injective (mul_left_cancel₀ Complex.I_ne_zero hw)

/-- Two distinct exponential parameters always give an algebraically independent Xi source pair. -/
theorem source_pair_algebraicIndependent (a b : ℂ) (hab : a ≠ b) :
    AlgebraicIndependent ℂ (source ![a, b]) := by
  apply source_algebraicIndependent_of_tag_injective
  intro m n h
  have hdN : m 0 + m 1 = n 0 + n 1 := by
    simpa [degree, Finsupp.sum_fintype, Fin.sum_univ_two] using congrArg Prod.fst h
  have hd : (m 0 : ℂ) + m 1 = (n 0 : ℂ) + n 1 := by exact_mod_cast hdN
  have hw : (m 0 : ℂ) * a + (m 1 : ℂ) * b = (n 0 : ℂ) * a + (n 1 : ℂ) * b := by
    simpa [weight, Finsupp.sum_fintype, Fin.sum_univ_two, nsmul_eq_mul] using congrArg Prod.snd h
  have hz : ((m 0 : ℂ) - n 0) * (a - b) = 0 := by
    linear_combination hw - b * hd
  have h0 : m 0 = n 0 := by
    exact_mod_cast sub_eq_zero.mp ((mul_eq_zero.mp hz).resolve_right (sub_ne_zero.mpr hab))
  have h1 : m 1 = n 1 := by omega
  ext i
  fin_cases i <;> assumption


end RHTower.XiExponentialSourceRelations
