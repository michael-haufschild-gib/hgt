import GaloisForLFunctions.HeckeLFunctions.HeckeCharactersSplitIntoFiniteCharactersAndRealParities

/-!
# Residue characters trivial on units are Hecke characters of a principal ring

Let `𝓞_K` be a principal ideal domain. Every ray class is then the class of a principal ideal
`(α)`, `α ∈ K_𝔪`, and `(α)` lies in `P_𝔪` iff `α` is a global unit times an element of the ray
group `K^{𝔪,1}_+`. So a character `φ` of `(𝓞_K/𝔪₀)ˣ × {±1}^{𝔪∞}` that is trivial on the residues
and signs of global units is the residue character of exactly one ray class character:
`ψ((α)) = φ(α mod 𝔪₀, signs of α)` (`heckeOfResidue`, `heckeOfResidue_rayClassOfElt`,
`rayResidueCharacter_heckeOfResidue`).
-/

noncomputable section

open NumberField FractionalIdeal
open scoped Classical nonZeroDivisors

namespace GaloisForLFunctions.HeckeLFunctions

variable {K : Type*} [Field K] [NumberField K] (𝔪 : Modulus K)

/-- With trivial class group, every ray class is the class of a principal ideal. -/
theorem rayResidueClass_surjective [IsPrincipalIdealRing (𝓞 K)] :
    Function.Surjective (rayResidueClass 𝔪) := by
  intro c
  have hc : c ∈ (toClassGroup 𝔪).ker := by
    haveI := IsGCDMonoid.subsingleton_classGroup (R := 𝓞 K)
    exact Subsingleton.elim _ _
  rw [← range_rayResidueClass] at hc
  exact hc

/-- A principal ideal in `P_𝔪` is generated by a ray element times a global unit. -/
theorem exists_globalUnit_of_rayClassOfElt_eq_one {α : primeToUnits 𝔪}
    (hα : rayClassOfElt 𝔪 α = 1) :
    ∃ γ ∈ (rayHom 𝔪).ker, ∃ u : (𝓞 K)ˣ, α = γ * globalUnitPrimeTo 𝔪 u := by
  rw [rayClassOfElt, MonoidHom.comp_apply, rayClass, QuotientGroup.mk'_apply,
    QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf] at hα
  obtain ⟨β, hβ, hβα⟩ := hα
  obtain ⟨γ, hγ, rfl⟩ := hβ
  have hβα' : toPrincipalIdeal (𝓞 K) K (γ : Kˣ) = toPrincipalIdeal (𝓞 K) K (α : Kˣ) := hβα
  have hspan : spanSingleton (𝓞 K)⁰ ((γ : Kˣ) : K) = spanSingleton (𝓞 K)⁰ ((α : Kˣ) : K) := by
    have h := congrArg Units.val hβα'
    rwa [coe_toPrincipalIdeal, coe_toPrincipalIdeal] at h
  obtain ⟨u, hu⟩ := (spanSingleton_eq_spanSingleton (S := (𝓞 K)⁰)).mp hspan
  refine ⟨γ, hγ, u, Subtype.ext (Units.ext ?_)⟩
  rw [← hu, Subgroup.coe_mul, Units.val_mul, Units.smul_def, Algebra.smul_def, mul_comm]
  rfl

/-- The kernel of the principal ray class map lies in the kernel of a residue character that is
trivial on global units. -/
theorem ker_rayResidueClass_le
    (φ : (𝓞 K ⧸ 𝔪.fin)ˣ × (𝔪.inf → ℤˣ) →* ℂˣ)
    (hφ : ∀ u : (𝓞 K)ˣ, φ (rayHom 𝔪 (globalUnitPrimeTo 𝔪 u)) = 1) :
    (rayResidueClass 𝔪).ker ≤ (φ.comp (rayHom 𝔪).range.subtype).ker := by
  rintro ⟨g, α, rfl⟩ hg
  rw [MonoidHom.mem_ker, rayResidueClass_apply] at hg
  obtain ⟨γ, hγ, u, hα⟩ := exists_globalUnit_of_rayClassOfElt_eq_one 𝔪 hg
  change φ (rayHom 𝔪 α) = 1
  rw [hα, map_mul, (MonoidHom.mem_ker).mp hγ, one_mul, hφ u]

variable [IsPrincipalIdealRing (𝓞 K)]

/-- **The Hecke character of a residue character trivial on global units.** -/
def heckeOfResidue (φ : (𝓞 K ⧸ 𝔪.fin)ˣ × (𝔪.inf → ℤˣ) →* ℂˣ)
    (hφ : ∀ u : (𝓞 K)ˣ, φ (rayHom 𝔪 (globalUnitPrimeTo 𝔪 u)) = 1) : HeckeCharacter 𝔪 :=
  (QuotientGroup.lift _ (φ.comp (rayHom 𝔪).range.subtype) (ker_rayResidueClass_le 𝔪 φ hφ)).comp
    (QuotientGroup.quotientKerEquivOfSurjective _ (rayResidueClass_surjective 𝔪)).symm.toMonoidHom

theorem heckeOfResidue_rayResidueClass (φ : (𝓞 K ⧸ 𝔪.fin)ˣ × (𝔪.inf → ℤˣ) →* ℂˣ)
    (hφ : ∀ u : (𝓞 K)ˣ, φ (rayHom 𝔪 (globalUnitPrimeTo 𝔪 u)) = 1) (g : (rayHom 𝔪).range) :
    heckeOfResidue 𝔪 φ hφ (rayResidueClass 𝔪 g) = φ g := by
  have h : (QuotientGroup.quotientKerEquivOfSurjective _ (rayResidueClass_surjective 𝔪)).symm
      (rayResidueClass 𝔪 g) = (g : (rayHom 𝔪).range ⧸ (rayResidueClass 𝔪).ker) := by
    rw [MulEquiv.symm_apply_eq]
    rfl
  rw [heckeOfResidue, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, h, QuotientGroup.lift_mk]
  rfl

/-- **Values on principal ideals**: `ψ((α)) = φ(α mod 𝔪₀, signs of α)`. -/
theorem heckeOfResidue_rayClassOfElt (φ : (𝓞 K ⧸ 𝔪.fin)ˣ × (𝔪.inf → ℤˣ) →* ℂˣ)
    (hφ : ∀ u : (𝓞 K)ˣ, φ (rayHom 𝔪 (globalUnitPrimeTo 𝔪 u)) = 1) (α : primeToUnits 𝔪) :
    heckeOfResidue 𝔪 φ hφ (rayClassOfElt 𝔪 α) = φ (rayHom 𝔪 α) := by
  rw [← rayResidueClass_apply, heckeOfResidue_rayResidueClass]

/-- The residue character of `heckeOfResidue φ` is `φ`. -/
theorem rayResidueCharacter_heckeOfResidue (φ : (𝓞 K ⧸ 𝔪.fin)ˣ × (𝔪.inf → ℤˣ) →* ℂˣ)
    (hφ : ∀ u : (𝓞 K)ˣ, φ (rayHom 𝔪 (globalUnitPrimeTo 𝔪 u)) = 1) :
    rayResidueCharacter 𝔪 (heckeOfResidue 𝔪 φ hφ) = φ := by
  ext g
  obtain ⟨α, rfl⟩ := rayHom_surjective 𝔪 g
  rw [rayResidueCharacter, MonoidHom.comp_apply, fullRayResidueClass_rayHom,
    heckeOfResidue_rayClassOfElt]

/-- The finite residue character of `heckeOfResidue φ` is `φ` with trivial signs. -/
theorem finiteResidueCharacter_heckeOfResidue
    (φ : (𝓞 K ⧸ 𝔪.fin)ˣ × (𝔪.inf → ℤˣ) →* ℂˣ)
    (hφ : ∀ u : (𝓞 K)ˣ, φ (rayHom 𝔪 (globalUnitPrimeTo 𝔪 u)) = 1) (x : (𝓞 K ⧸ 𝔪.fin)ˣ) :
    finiteResidueCharacter 𝔪 (heckeOfResidue 𝔪 φ hφ) x = φ (x, 1) := by
  rw [finiteResidueCharacter, MonoidHom.comp_apply, rayResidueCharacter_heckeOfResidue]
  rfl

end GaloisForLFunctions.HeckeLFunctions
