import GaloisForLFunctions.HTGeometry.UnramifiedRadicalCriterion

/-!
# The Kummer field of the quintic point sees the conductor

The point of `y² + y = x⁵` attached to a triple `a + b = c` has `y = b/a` and
`x⁵ = m = y² + y = bc/a²`, so it is defined over the Kummer field `K(m^{1/5})`.  Since
`m · a^{10} = b c a⁸`, this is the field generated by a fifth root of the integer `b c a⁸`.
The discriminant of this field is bounded by the conductor `N(a, b, c)` and `5`, because only those
primes ramify.

Conversely, the corpus radical criterion (`HTGeometry.not_exists_radical_root_of_not_dvd`) shows
that the conductor is really seen: for coprime `a, b` and a prime `p` dividing one of `a`, `b`,
`a + b` to an exponent prime to `5`, the integer `b(a + b)a⁸` has no fifth root in any discrete
valuation ring in which `p` is a uniformizer.  So the Kummer field is ramified at every such prime.
-/

noncomputable section

open IsDiscreteValuationRing

namespace GaloisForLFunctions.KodairaParshinAbc

/-- `m = bc/a²` and `b c a⁸` differ by the fifth power `a^{10}`. -/
theorem quintic_radicand {F : Type*} [Field F] {a b c : F} (ha : a ≠ 0) :
    (b * c / a ^ 2) * (a ^ 2) ^ 5 = b * c * a ^ 8 := by
  field_simp

section DVR

variable {B : Type*} [CommRing B] [IsDomain B] [IsDiscreteValuationRing B] [Algebra ℤ B]

/-- If `p` is a uniformizer of `B`, every integer prime to `p` is a unit of `B`. -/
theorem addVal_intCast_eq_zero {p : ℕ} (hp : p.Prime) (hpB : addVal B (algebraMap ℤ B p) = 1)
    {q : ℤ} (hq : ¬ (p : ℤ) ∣ q) : addVal B (algebraMap ℤ B q) = 0 := by
  have hpz : Prime (p : ℤ) := Nat.prime_iff_prime_int.mp hp
  obtain ⟨u, v, huv⟩ := (hpz.coprime_iff_not_dvd).mpr hq
  have h1 : algebraMap ℤ B u * algebraMap ℤ B p + algebraMap ℤ B v * algebraMap ℤ B q = 1 := by
    rw [← map_mul, ← map_mul, ← map_add, huv, map_one]
  rcases IsLocalRing.isUnit_or_isUnit_of_add_one h1 with hu | hv
  · have hP : IsUnit (algebraMap ℤ B p) := isUnit_of_mul_isUnit_right hu
    have := addVal_eq_zero_of_unit hP.unit
    rw [IsUnit.unit_spec] at this
    rw [hpB] at this
    exact absurd this one_ne_zero
  · have hQ : IsUnit (algebraMap ℤ B q) := isUnit_of_mul_isUnit_right hv
    have := addVal_eq_zero_of_unit hQ.unit
    rwa [IsUnit.unit_spec] at this

/-- **Primes of `b` ramify in the quintic Kummer field.**  Let `a, b` be coprime and
`b = p^k b₁` with `p ∤ b₁` and `5 ∤ k`.  Then `b(a + b)a⁸` has no fifth root in a discrete
valuation ring with uniformizer `p`. -/
theorem not_exists_fifth_root_of_dvd_b {a b : ℤ} (h : IsCoprime a b) {p : ℕ} (hp : p.Prime)
    {k : ℕ} {b₁ : ℤ} (hb : b = (p : ℤ) ^ k * b₁) (hb₁ : ¬ (p : ℤ) ∣ b₁) (hk : ¬ 5 ∣ k)
    (hpB : addVal B (algebraMap ℤ B p) = 1) :
    ¬ ∃ z : B, z ^ 5 = algebraMap ℤ B (b * (a + b) * a ^ 8) := by
  have hpz : Prime (p : ℤ) := Nat.prime_iff_prime_int.mp hp
  have hk0 : k ≠ 0 := by rintro rfl; exact hk (dvd_zero 5)
  have hpb : (p : ℤ) ∣ b := hb ▸ dvd_mul_of_dvd_left (dvd_pow_self _ hk0) _
  have hpa : ¬ (p : ℤ) ∣ a := fun hpa => hpz.not_unit (h.isUnit_of_dvd' hpa hpb)
  have hpc : ¬ (p : ℤ) ∣ a + b := fun hpc =>
    hpa (by simpa using dvd_sub hpc hpb)
  have hcof : ¬ (p : ℤ) ∣ b₁ * (a + b) * a ^ 8 := by
    intro hd
    rcases hpz.dvd_mul.mp hd with hd | hd
    · rcases hpz.dvd_mul.mp hd with hd | hd
      · exact hb₁ hd
      · exact hpc hd
    · exact hpa (hpz.dvd_of_dvd_pow hd)
  exact HTGeometry.not_exists_radical_root_of_not_dvd (R := ℤ) (p := (p : ℤ))
    (b := b₁ * (a + b) * a ^ 8) (k := k) (r := 5) (by exact_mod_cast hpB)
    (addVal_intCast_eq_zero hp hpB hcof) (by rw [hb]; ring) hk

/-- **Primes of `a` ramify in the quintic Kummer field.**  If `a = p^k a₁` with `p ∤ a₁` and
`5 ∤ k`, the exponent of `p` in `b(a + b)a⁸` is `8k`, prime to `5`. -/
theorem not_exists_fifth_root_of_dvd_a {a b : ℤ} (h : IsCoprime a b) {p : ℕ} (hp : p.Prime)
    {k : ℕ} {a₁ : ℤ} (ha : a = (p : ℤ) ^ k * a₁) (ha₁ : ¬ (p : ℤ) ∣ a₁) (hk : ¬ 5 ∣ k)
    (hpB : addVal B (algebraMap ℤ B p) = 1) :
    ¬ ∃ z : B, z ^ 5 = algebraMap ℤ B (b * (a + b) * a ^ 8) := by
  have hpz : Prime (p : ℤ) := Nat.prime_iff_prime_int.mp hp
  have hk0 : k ≠ 0 := by rintro rfl; exact hk (dvd_zero 5)
  have hpa : (p : ℤ) ∣ a := ha ▸ dvd_mul_of_dvd_left (dvd_pow_self _ hk0) _
  have hpb : ¬ (p : ℤ) ∣ b := fun hpb => hpz.not_unit (h.isUnit_of_dvd' hpa hpb)
  have hpc : ¬ (p : ℤ) ∣ a + b := fun hpc => hpb (by simpa using dvd_sub hpc hpa)
  have hcof : ¬ (p : ℤ) ∣ b * (a + b) * a₁ ^ 8 := by
    intro hd
    rcases hpz.dvd_mul.mp hd with hd | hd
    · rcases hpz.dvd_mul.mp hd with hd | hd
      · exact hpb hd
      · exact hpc hd
    · exact ha₁ (hpz.dvd_of_dvd_pow hd)
  have h8 : ¬ 5 ∣ 8 * k := by omega
  exact HTGeometry.not_exists_radical_root_of_not_dvd (R := ℤ) (p := (p : ℤ))
    (b := b * (a + b) * a₁ ^ 8) (k := 8 * k) (r := 5) (by exact_mod_cast hpB)
    (addVal_intCast_eq_zero hp hpB hcof) (by rw [ha]; ring) h8

/-- **Primes of `c = a + b` ramify in the quintic Kummer field.** -/
theorem not_exists_fifth_root_of_dvd_c {a b : ℤ} (h : IsCoprime a b) {p : ℕ} (hp : p.Prime)
    {k : ℕ} {c₁ : ℤ} (hc : a + b = (p : ℤ) ^ k * c₁) (hc₁ : ¬ (p : ℤ) ∣ c₁) (hk : ¬ 5 ∣ k)
    (hpB : addVal B (algebraMap ℤ B p) = 1) :
    ¬ ∃ z : B, z ^ 5 = algebraMap ℤ B (b * (a + b) * a ^ 8) := by
  have hpz : Prime (p : ℤ) := Nat.prime_iff_prime_int.mp hp
  have hk0 : k ≠ 0 := by rintro rfl; exact hk (dvd_zero 5)
  have hpc : (p : ℤ) ∣ a + b := hc ▸ dvd_mul_of_dvd_left (dvd_pow_self _ hk0) _
  have hpa : ¬ (p : ℤ) ∣ a := fun hpa =>
    hpz.not_unit (h.isUnit_of_dvd' hpa (by simpa using dvd_sub hpc hpa))
  have hpb : ¬ (p : ℤ) ∣ b := fun hpb => hpa (by simpa using dvd_sub hpc hpb)
  have hcof : ¬ (p : ℤ) ∣ b * c₁ * a ^ 8 := by
    intro hd
    rcases hpz.dvd_mul.mp hd with hd | hd
    · rcases hpz.dvd_mul.mp hd with hd | hd
      · exact hpb hd
      · exact hc₁ hd
    · exact hpa (hpz.dvd_of_dvd_pow hd)
  exact HTGeometry.not_exists_radical_root_of_not_dvd (R := ℤ) (p := (p : ℤ))
    (b := b * c₁ * a ^ 8) (k := k) (r := 5) (by exact_mod_cast hpB)
    (addVal_intCast_eq_zero hp hpB hcof) (by rw [hc]; ring) hk

end DVR

end GaloisForLFunctions.KodairaParshinAbc
