import Mathlib.Algebra.Polynomial.Derivative
import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
import Mathlib.Tactic.Ring

/-!
# Symmetric squares of polynomial differential operators

The symmetric-square formulas in §3.3 of Huq-Kuruvilla--Schultz,
arXiv:2611.13126, admit integral identities before imposing a differential
equation. These identities retain the singular locus and work in every
characteristic. They give the product equation, Abel's identity, the cubic
Wronskian law, and the vanishing Wilczynski invariant.
-/

noncomputable section

namespace GaloisForLFunctions.KodairaParshinAbc.Periods

open Polynomial

variable {R : Type*} [CommRing R]

/-- A second-order operator with polynomial coefficients. -/
def secondOrder (a b c f : R[X]) : R[X] :=
  a * f.derivative.derivative + b * f.derivative + c * f

/-- The symmetric square after clearing the square of the leading coefficient. -/
def symmetricSquare (a b c f : R[X]) : R[X] :=
  a ^ 2 * f.derivative.derivative.derivative +
    3 * a * b * f.derivative.derivative +
    (a * b.derivative + 2 * b ^ 2 - a.derivative * b + 4 * a * c) * f.derivative +
    (2 * a * c.derivative + 4 * b * c - 2 * a.derivative * c) * f

/-- The exact product defect proves the symmetric-square equation without division. -/
theorem symmetricSquare_product (a b c f g : R[X]) :
    symmetricSquare a b c (f * g) =
      a * f * (secondOrder a b c g).derivative +
      a * g * (secondOrder a b c f).derivative +
      (3 * a * f.derivative + (2 * b - a.derivative) * f) * secondOrder a b c g +
      (3 * a * g.derivative + (2 * b - a.derivative) * g) * secondOrder a b c f := by
  simp only [symmetricSquare, secondOrder, derivative_add, derivative_mul]
  ring

/-- The square defect is generated by the original equation and its derivative. -/
theorem symmetricSquare_square (a b c f : R[X]) :
    symmetricSquare a b c (f ^ 2) =
      2 * a * f * (secondOrder a b c f).derivative +
      (6 * a * f.derivative + (4 * b - 2 * a.derivative) * f) *
        secondOrder a b c f := by
  rw [pow_two, symmetricSquare_product]
  ring

/-- Wronskian with columns `f,g`. -/
def wronskian (f g : R[X]) : R[X] := f * g.derivative - f.derivative * g

/-- Abel's identity with the two differential-equation defects retained. -/
theorem wronskian_defect (a b c f g : R[X]) :
    a * (wronskian f g).derivative + b * wronskian f g =
      f * secondOrder a b c g - g * secondOrder a b c f := by
  simp only [wronskian, secondOrder, derivative_sub, derivative_mul]
  ring

/-- The period-ratio derivative acquires precisely the square of the first period. -/
theorem wronskian_square_product (f g : R[X]) :
    wronskian (f ^ 2) (f * g) = f ^ 2 * wronskian f g := by
  simp only [wronskian, pow_two, derivative_mul]
  ring

/-- The three product periods lie on the Veronese conic. -/
theorem product_period_conic (f g : R[X]) :
    f ^ 2 * g ^ 2 - (f * g) ^ 2 = 0 := by ring

/-- The Wronskian of the three product periods is twice the cube of the original Wronskian. -/
theorem product_period_wronskian (f g : R[X]) :
    Matrix.det
      (!![f ^ 2, f * g, g ^ 2;
          (f ^ 2).derivative, (f * g).derivative, (g ^ 2).derivative;
          (f ^ 2).derivative.derivative, (f * g).derivative.derivative,
            (g ^ 2).derivative.derivative] : Matrix (Fin 3) (Fin 3) R[X]) =
      2 * wronskian f g ^ 3 := by
  simp [Matrix.det_fin_three, wronskian, pow_two, derivative_mul]
  ring

/-- Twenty-seven times the first third-order Wilczynski invariant. -/
def wilczynskiNumerator (b₂ b₁ b₀ : R[X]) : R[X] :=
  -54 * b₀ + 18 * b₁ * b₂ - 4 * b₂ ^ 3 - 9 * b₂.derivative.derivative +
    27 * b₁.derivative - 18 * b₂.derivative * b₂

/-- Every monic symmetric square has zero Wilczynski invariant, integrally. -/
theorem wilczynski_symmetricSquare (b c : R[X]) :
    wilczynskiNumerator (3 * b) (b.derivative + 2 * b ^ 2 + 4 * c)
      (2 * c.derivative + 4 * b * c) = 0 := by
  simp only [wilczynskiNumerator, pow_two, derivative_add, derivative_mul,
    derivative_ofNat, zero_mul, zero_add]
  ring

/-- Passing to the symmetric square preserves the period ratio, including the zero denominator. -/
theorem product_period_ratio {K : Type*} [Field K] (f g : K) :
    (f * g) / f ^ 2 = g / f := by
  by_cases hf : f = 0
  · simp only [hf, zero_mul, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true,
      zero_pow, div_zero]
  · rw [pow_two, mul_div_mul_left _ _ hf]

end GaloisForLFunctions.KodairaParshinAbc.Periods

