import Mathlib.RingTheory.PowerSeries.Derivative
import Mathlib.Tactic.Ring

/-!
# Symmetric squares for an arbitrary derivation

The integral product-defect identity for a second-order equation uses only
the Leibniz rule. This form applies to formal power series and rational
functions as well as polynomials, without any division by the leading
coefficient or any characteristic restriction.
-/

noncomputable section

namespace GaloisForLFunctions.KodairaParshinAbc.Periods

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]

def secondOrderD (δ : Derivation R A A) (a b c f : A) : A :=
  a * δ (δ f) + b * δ f + c * f

def symmetricSquareD (δ : Derivation R A A) (a b c f : A) : A :=
  a ^ 2 * δ (δ (δ f)) + 3 * a * b * δ (δ f) +
    (a * δ b + 2 * b ^ 2 - δ a * b + 4 * a * c) * δ f +
    (2 * a * δ c + 4 * b * c - 2 * δ a * c) * f

/-- The product equation, with the original two equation defects retained. -/
theorem symmetricSquareD_product (δ : Derivation R A A) (a b c f g : A) :
    symmetricSquareD δ a b c (f * g) =
      a * f * δ (secondOrderD δ a b c g) +
      a * g * δ (secondOrderD δ a b c f) +
      (3 * a * δ f + (2 * b - δ a) * f) * secondOrderD δ a b c g +
      (3 * a * δ g + (2 * b - δ a) * g) * secondOrderD δ a b c f := by
  simp only [symmetricSquareD, secondOrderD, map_add, Derivation.leibniz, smul_eq_mul]
  ring

/-- The symmetric-square defect is generated by one equation and its derivative. -/
theorem symmetricSquareD_square (δ : Derivation R A A) (a b c f : A) :
    symmetricSquareD δ a b c (f ^ 2) =
      2 * a * f * δ (secondOrderD δ a b c f) +
      (6 * a * δ f + (4 * b - 2 * δ a) * f) * secondOrderD δ a b c f := by
  rw [pow_two, symmetricSquareD_product]
  ring

end GaloisForLFunctions.KodairaParshinAbc.Periods

#print axioms GaloisForLFunctions.KodairaParshinAbc.Periods.symmetricSquareD_product
#print axioms GaloisForLFunctions.KodairaParshinAbc.Periods.symmetricSquareD_square
