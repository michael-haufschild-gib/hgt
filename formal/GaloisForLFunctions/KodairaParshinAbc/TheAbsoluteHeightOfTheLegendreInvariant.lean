import GaloisForLFunctions.KodairaParshinAbc.TheHeightOfTheLegendreInvariant
import GaloisForLFunctions.RHTower.Deninger.DeningerAbsoluteHeight

/-!
# The absolute height of the Legendre invariant

The height comparison `H(j, 1) ≪ H(λ, 1-λ, 1)⁶` is used over a field `k(j, λ)` that moves with the
discriminant, so its constant must not depend on the field.  Place by place, with
`M_v = max(|λ|_v, 1)`, the Legendre invariant `J(λ) = 256 (λ² - λ + 1)³ / (λ(λ-1))²` satisfies

* `max(|256 (λ² - λ + 1)³|_v, |(λ(λ-1))²|_v) ≤ 6912 M_v⁶` at every archimedean place
  (`|λ² - λ + 1| ≤ 3 M²`, `|λ(λ - 1)| ≤ 2 M²`),
* `max(...) ≤ M_v⁶` at every nonarchimedean place,

so `H(J(λ)) ≤ 6912^{[K:ℚ]} H(λ)⁶` over every field with admissible absolute values, and for the
absolute logarithmic Weil height of the corpus (`RHTower.deningerAbsHeight`) on any algebraic
extension of `ℚ`:

  `h(J(α)) ≤ log 6912 + 6 h(α)`  for every algebraic number `α`,

with a constant independent of the field generated by `α`.
-/

noncomputable section

open Height AdmissibleAbsValues Real

namespace GaloisForLFunctions.KodairaParshinAbc

/-! ## Local bounds -/

section Local

variable {K : Type*} [Field K]

theorem absoluteValue_natCast_le (v : AbsoluteValue K ℝ) (n : ℕ) : v n ≤ n := by
  induction n with
  | zero => simp
  | succ n ih =>
    push_cast
    calc v ((n : K) + 1) ≤ v n + v 1 := v.add_le _ _
      _ ≤ n + 1 := by rw [map_one]; linarith

/-- **Archimedean bound**: both sextics are at most `6912 M⁶`, `M = max(v λ, 1)`. -/
theorem legendre_local_le (v : AbsoluteValue K ℝ) (w : K) :
    v (256 * (w ^ 2 - w + 1) ^ 3) ≤ 6912 * max (v w) 1 ^ 6 ∧
      v ((w * (w - 1)) ^ 2) ≤ 6912 * max (v w) 1 ^ 6 := by
  set M := max (v w) 1 with hMdef
  have hM1 : 1 ≤ M := le_max_right _ _
  have hvw : v w ≤ M := le_max_left _ _
  have hv0 : 0 ≤ v w := v.nonneg w
  have h256 : v 256 ≤ 256 := by
    have := absoluteValue_natCast_le v 256
    exact_mod_cast this
  have hs : v (w ^ 2 - w + 1) ≤ 3 * M ^ 2 := by
    have e : w ^ 2 - w + 1 = w ^ 2 + -w + 1 := by ring
    calc v (w ^ 2 - w + 1) ≤ v (w ^ 2 + -w) + v 1 := by rw [e]; exact v.add_le _ _
      _ ≤ v (w ^ 2) + v (-w) + v 1 := by gcongr; exact v.add_le _ _
      _ = v w ^ 2 + v w + 1 := by rw [map_pow, map_neg_eq_map, map_one]
      _ ≤ 3 * M ^ 2 := by nlinarith
  have hw1 : v (w - 1) ≤ 2 * M := by
    calc v (w - 1) ≤ v w + v 1 := by
          rw [sub_eq_add_neg]
          exact (v.add_le _ _).trans (by rw [map_neg_eq_map])
      _ ≤ 2 * M := by rw [map_one]; linarith
  constructor
  · rw [map_mul, map_pow]
    have hs0 : 0 ≤ v (w ^ 2 - w + 1) := v.nonneg _
    calc v 256 * v (w ^ 2 - w + 1) ^ 3 ≤ 256 * (3 * M ^ 2) ^ 3 :=
          mul_le_mul h256 (pow_le_pow_left₀ hs0 hs 3) (by positivity) (by norm_num)
      _ = 6912 * M ^ 6 := by ring
  · rw [map_pow, map_mul]
    have h0 : 0 ≤ v w * v (w - 1) := mul_nonneg hv0 (v.nonneg _)
    calc (v w * v (w - 1)) ^ 2 ≤ (M * (2 * M)) ^ 2 :=
          pow_le_pow_left₀ h0 (mul_le_mul hvw hw1 (v.nonneg _) (by linarith)) 2
      _ ≤ 6912 * M ^ 6 := by nlinarith [pow_le_pow_right₀ hM1 (show 4 ≤ 6 by norm_num)]

/-- **Nonarchimedean bound**: both sextics are at most `M⁶`. -/
theorem legendre_local_le_of_isNonarchimedean {v : AbsoluteValue K ℝ} (hv : IsNonarchimedean v)
    (w : K) :
    v (256 * (w ^ 2 - w + 1) ^ 3) ≤ max (v w) 1 ^ 6 ∧
      v ((w * (w - 1)) ^ 2) ≤ max (v w) 1 ^ 6 := by
  set M := max (v w) 1 with hMdef
  have hM1 : 1 ≤ M := le_max_right _ _
  have hvw : v w ≤ M := le_max_left _ _
  have h256 : v 256 ≤ 1 := by
    have := hv.apply_intCast_le_one (n := 256)
    exact_mod_cast this
  have hs : v (w ^ 2 - w + 1) ≤ M ^ 2 := by
    have e : w ^ 2 - w + 1 = w ^ 2 + -w + 1 := by ring
    rw [e]
    refine (hv _ _).trans (max_le ((hv _ _).trans (max_le ?_ ?_)) ?_)
    · rw [map_pow]; exact pow_le_pow_left₀ (v.nonneg w) hvw 2
    · rw [map_neg_eq_map]; nlinarith
    · rw [map_one]; nlinarith
  have hw1 : v (w - 1) ≤ M := by
    rw [sub_eq_add_neg]
    refine (hv _ _).trans (max_le hvw ?_)
    rw [map_neg_eq_map, map_one]
    exact hM1
  constructor
  · rw [map_mul, map_pow]
    have hs0 : 0 ≤ v (w ^ 2 - w + 1) := v.nonneg _
    calc v 256 * v (w ^ 2 - w + 1) ^ 3 ≤ 1 * (M ^ 2) ^ 3 :=
          mul_le_mul h256 (pow_le_pow_left₀ hs0 hs 3) (by positivity) (by norm_num)
      _ = M ^ 6 := by ring
  · rw [map_pow, map_mul]
    have h0 : 0 ≤ v w * v (w - 1) := mul_nonneg (v.nonneg _) (v.nonneg _)
    calc (v w * v (w - 1)) ^ 2 ≤ (M * M) ^ 2 :=
          pow_le_pow_left₀ h0 (mul_le_mul hvw hw1 (v.nonneg _) (by linarith)) 2
      _ ≤ M ^ 6 := by nlinarith [pow_le_pow_right₀ hM1 (show 4 ≤ 6 by norm_num)]

end Local

/-! ## The global bound -/

section Global

variable {K : Type*} [Field K] [AdmissibleAbsValues K]

omit [AdmissibleAbsValues K] in
theorem legendreInvariant_eq_div_sq (w : K) :
    legendreInvariant w = 256 * (w ^ 2 - w + 1) ^ 3 / (w * (w - 1)) ^ 2 := by
  unfold legendreInvariant
  ring

/-- **`H(J(λ)) ≤ 6912^{[K:ℚ]} H(λ)⁶`.** -/
theorem mulHeight₁_legendreInvariant_le (w : K) :
    mulHeight₁ (legendreInvariant w) ≤ 6912 ^ totalWeight K * mulHeight₁ w ^ 6 := by
  rw [legendreInvariant_eq_div_sq, mulHeight₁_div_eq_mulHeight]
  set x : Fin 2 → K := ![256 * (w ^ 2 - w + 1) ^ 3, (w * (w - 1)) ^ 2] with hxdef
  have hR : 1 ≤ 6912 ^ totalWeight K * mulHeight₁ w ^ 6 :=
    one_le_mul_of_one_le_of_one_le (one_le_pow₀ (by norm_num))
      (one_le_pow₀ (one_le_mulHeight₁ w))
  by_cases hx : x = 0
  · rw [hx, mulHeight_zero]
    exact hR
  rw [mulHeight_eq hx, mulHeight₁_eq, mul_pow]
  have harch : (archAbsVal.map fun v ↦ ⨆ i, v (x i)).prod ≤
      6912 ^ totalWeight K * (archAbsVal.map fun v ↦ max (v w) 1).prod ^ 6 := by
    calc (archAbsVal.map fun v ↦ ⨆ i, v (x i)).prod
        ≤ (archAbsVal.map fun v : AbsoluteValue K ℝ ↦ 6912 * max (v w) 1 ^ 6).prod := by
          refine Multiset.prod_map_le_prod_map₀ _ _
            (fun v _ => Real.iSup_nonneg_of_nonnegHomClass v _) fun v _ => ?_
          refine ciSup_le fun i => ?_
          obtain ⟨h1, h2⟩ := legendre_local_le v w
          fin_cases i
          · exact h1
          · exact h2
      _ = 6912 ^ totalWeight K * (archAbsVal.map fun v ↦ max (v w) 1).prod ^ 6 := by
          rw [Multiset.prod_map_mul, Multiset.prod_map_pow, Multiset.map_const',
            Multiset.prod_replicate, totalWeight]
  have hnon : ∏ᶠ v : nonarchAbsVal, ⨆ i, v.val (x i) ≤
      (∏ᶠ v : nonarchAbsVal, max (v.val w) 1) ^ 6 := by
    rw [finprod_pow (by fun_prop)]
    refine finprod_le_finprod (by fun_prop (disch := assumption))
      (fun v => Real.iSup_nonneg_of_nonnegHomClass v.val _) (by fun_prop) fun v => ?_
    refine ciSup_le fun i => ?_
    obtain ⟨h1, h2⟩ := legendre_local_le_of_isNonarchimedean (isNonarchimedean _ v.prop) w
    fin_cases i
    · exact h1
    · exact h2
  have hA0 : 0 ≤ (archAbsVal.map fun v ↦ ⨆ i, v (x i)).prod :=
    Multiset.prod_map_nonneg fun v _ => Real.iSup_nonneg_of_nonnegHomClass v _
  have hN0 : 0 ≤ (∏ᶠ v : nonarchAbsVal, max (v.val w) 1) ^ 6 :=
    pow_nonneg (finprod_nonneg fun v => by positivity) 6
  calc (archAbsVal.map fun v ↦ ⨆ i, v (x i)).prod * ∏ᶠ v : nonarchAbsVal, ⨆ i, v.val (x i)
      ≤ (6912 ^ totalWeight K * (archAbsVal.map fun v ↦ max (v w) 1).prod ^ 6) *
          (∏ᶠ v : nonarchAbsVal, max (v.val w) 1) ^ 6 :=
        mul_le_mul harch hnon (finprod_nonneg fun v => Real.iSup_nonneg_of_nonnegHomClass _ _)
          (le_trans hA0 harch)
    _ = 6912 ^ totalWeight K * ((archAbsVal.map fun v ↦ max (v w) 1).prod ^ 6 *
          (∏ᶠ v : nonarchAbsVal, max (v.val w) 1) ^ 6) := by ring

/-- **`h(J(λ)) ≤ [K:ℚ] log 6912 + 6 h(λ)`** (unnormalized logarithmic heights). -/
theorem logHeight₁_legendreInvariant_le (w : K) :
    logHeight₁ (legendreInvariant w) ≤ totalWeight K * Real.log 6912 + 6 * logHeight₁ w := by
  have h := Real.log_le_log (mulHeight₁_pos _) (mulHeight₁_legendreInvariant_le w)
  rw [Real.log_mul (by positivity) (by positivity [mulHeight₁_pos w]), Real.log_pow,
    Real.log_pow] at h
  simpa [logHeight₁_eq_log_mulHeight₁] using h

end Global

/-! ## The absolute height on algebraic numbers -/

/-- In a number field, the degree-normalized height satisfies `h(J(λ)) ≤ log 6912 + 6 h(λ)`. -/
theorem deningerNormalizedHeight_legendreInvariant_le (K : Type*) [Field K] [NumberField K]
    (w : K) :
    RHTower.deningerNormalizedHeight K (legendreInvariant w) ≤
      Real.log 6912 + 6 * RHTower.deningerNormalizedHeight K w := by
  have h := logHeight₁_legendreInvariant_le w
  rw [NumberField.totalWeight_eq_finrank] at h
  have hd : (0 : ℝ) < Module.finrank ℚ K := by exact_mod_cast Module.finrank_pos
  unfold RHTower.deningerNormalizedHeight
  rw [div_le_iff₀ hd]
  calc Height.logHeight₁ (legendreInvariant w)
      ≤ (Module.finrank ℚ K : ℝ) * Real.log 6912 + 6 * Height.logHeight₁ w := h
    _ = (Real.log 6912 + 6 * (Height.logHeight₁ w / Module.finrank ℚ K)) *
          Module.finrank ℚ K := by field_simp

/-- The Legendre invariant commutes with field homomorphisms. -/
theorem map_legendreInvariant {F₁ F₂ : Type*} [Field F₁] [Field F₂] (φ : F₁ →+* F₂) (w : F₁) :
    φ (legendreInvariant w) = legendreInvariant (φ w) := by
  unfold legendreInvariant
  simp [map_div₀, map_mul, map_pow, map_sub, map_add, map_one, map_ofNat]

/-- **The uniform degree-six bound for the absolute height**: for every algebraic number `α`,
`h(J(α)) ≤ log 6912 + 6 h(α)`. -/
theorem deningerAbsHeight_legendreInvariant_le {F : Type*} [Field F] [Algebra ℚ F]
    [Algebra.IsAlgebraic ℚ F] (α : F) :
    RHTower.deningerAbsHeight (legendreInvariant α) ≤
      Real.log 6912 + 6 * RHTower.deningerAbsHeight α := by
  set E : IntermediateField ℚ F := IntermediateField.adjoin ℚ {α}
  set g : E := IntermediateField.AdjoinSimple.gen ℚ α
  have hg : (g : F) = α := IntermediateField.AdjoinSimple.algebraMap_gen ℚ α
  have hcoe : ((legendreInvariant g : E) : F) = legendreInvariant α := by
    rw [← hg]
    exact map_legendreInvariant (algebraMap E F) g
  have hmem : legendreInvariant α ∈ E := hcoe ▸ (legendreInvariant g).2
  rw [RHTower.deningerAbsHeight_intermediateField E hmem]
  have hsub : (⟨legendreInvariant α, hmem⟩ : E) = legendreInvariant g := Subtype.ext hcoe.symm
  rw [hsub]
  exact deningerNormalizedHeight_legendreInvariant_le E g

end GaloisForLFunctions.KodairaParshinAbc
