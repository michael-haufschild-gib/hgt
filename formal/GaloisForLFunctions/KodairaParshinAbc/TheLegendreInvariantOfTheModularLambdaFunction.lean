import GaloisForLFunctions.KodairaParshinAbc.TheLegendreInvariantOfAnAbcTriple
import GaloisForLFunctions.Bottcher.ModularLambdaCovering
import GaloisForLFunctions.Bottcher.ModularLambdaUnconditional
import Mathlib.AlgebraicGeometry.EllipticCurve.IsomOfJ
import Mathlib.Analysis.Complex.Polynomial.Basic
import Mathlib.FieldTheory.IsSepClosed

/-!
# The Legendre invariant of the modular lambda function

The Legendre invariant `J(w) = 256 (w² - w + 1)³ / (w² (w - 1)²)` is the modular invariant of
`y² = x(x-1)(x-w)`.  It is invariant under the anharmonic group generated by `w ↦ 1 - w` and
`w ↦ w/(w - 1)`.  Composed with the modular lambda function `λ = (θ₂/θ₃)⁴`, whose values move by
exactly these two maps under `S` and `T` (`Bottcher.lambdaPunct_smul_S`, `lambdaPunct_smul_T`),
it becomes a function on `ℍ` invariant under all of `SL(2, ℤ)`:

  `J(λ(γ τ)) = J(λ(τ))`  for every `γ ∈ SL(2, ℤ)`,

with `J(λ(i)) = J(1/2) = 1728`.  Since `J(λ(τ))` is the Weierstrass `j`-invariant of the
Legendre curve `E_{λ(τ)}`, every `SL(2, ℤ)`-translate `E_{λ(γ τ)}` is isomorphic over `ℂ` to
`E_{λ(τ)}`.
-/

noncomputable section

open Complex UpperHalfPlane Bottcher
open scoped MatrixGroups

namespace GaloisForLFunctions.KodairaParshinAbc

open GaloisForLFunctions.HTGeometry

/-- The Legendre invariant `256 (w² - w + 1)³ / (w² (w - 1)²)`. -/
def legendreInvariant {F : Type*} [Field F] (w : F) : F :=
  256 * (w ^ 2 - w + 1) ^ 3 / (w ^ 2 * (w - 1) ^ 2)

section Field

variable {F : Type*} [Field F]

theorem legendreInvariant_one_sub (w : F) : legendreInvariant (1 - w) = legendreInvariant w := by
  unfold legendreInvariant
  congr 1 <;> ring

/-- `J(w/(w-1)) = J(w)`, including the degenerate values `w = 0, 1` where both sides are `0`. -/
theorem legendreInvariant_div_sub_one (w : F) :
    legendreInvariant (w / (w - 1)) = legendreInvariant w := by
  by_cases h1 : w - 1 = 0
  · rw [sub_eq_zero.mp h1]
    simp [legendreInvariant]
  by_cases h0 : w = 0
  · subst h0
    simp [legendreInvariant]
  have hsub : w / (w - 1) - 1 = 1 / (w - 1) := by field_simp; ring
  unfold legendreInvariant
  rw [hsub]
  field_simp
  ring

theorem legendreInvariant_inv (w : F) : legendreInvariant w⁻¹ = legendreInvariant w := by
  by_cases h0 : w = 0
  · simp [h0]
  by_cases h1 : w - 1 = 0
  · rw [sub_eq_zero.mp h1]
    simp
  have hsub : w⁻¹ - 1 = (1 - w) / w := by field_simp
  have h1' : 1 - w ≠ 0 := by intro h; exact h1 (by linear_combination -h)
  unfold legendreInvariant
  rw [hsub]
  field_simp
  ring

end Field

/-! ## Invariance under the anharmonic group -/

/-- **`J` is constant on anharmonic orbits**: `J(φ w) = J(w)` for every `φ` in the anharmonic
group acting on `ℂ ∖ {0, 1}`. -/
theorem legendreInvariant_anharmonic {φ : Equiv.Perm Punctured} (hφ : φ ∈ anharmonicGroup)
    (w : Punctured) : legendreInvariant ((φ w : Punctured) : ℂ) = legendreInvariant (w : ℂ) := by
  induction hφ using Subgroup.closure_induction generalizing w with
  | mem g hg =>
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
    rcases hg with rfl | rfl
    · rw [anharmS_apply, legendreInvariant_one_sub]
    · rw [anharmT_apply, legendreInvariant_div_sub_one]
  | one => rfl
  | mul x y _ _ hx hy => rw [Equiv.Perm.coe_mul, Function.comp_apply, hx, hy]
  | inv x _ hx =>
    have := hx (x⁻¹ w)
    rw [show x (x⁻¹ w) = w from Equiv.apply_symm_apply x w] at this
    exact this.symm

/-- The six anharmonic values `w, 1-w, 1/w, 1/(1-w), w/(w-1), (w-1)/w` share one Legendre
invariant. -/
theorem legendreInvariant_of_mem_anharmonicOrbit {w u : ℂ} (hu : u ∈ anharmonicOrbit w) :
    legendreInvariant u = legendreInvariant w := by
  simp only [anharmonicOrbit, Set.mem_insert_iff, Set.mem_singleton_iff] at hu
  rcases hu with rfl | rfl | rfl | rfl | rfl | rfl
  · rfl
  · exact legendreInvariant_one_sub w
  · rw [one_div, legendreInvariant_inv]
  · rw [one_div, legendreInvariant_inv, legendreInvariant_one_sub]
  · exact legendreInvariant_div_sub_one w
  · have : (w - 1) / w = (w / (w - 1))⁻¹ := by rw [inv_div]
    rw [this, legendreInvariant_inv, legendreInvariant_div_sub_one]

/-! ## The modular function `J ∘ λ` -/

/-- The Legendre invariant of the modular lambda function. -/
def lambdaInvariant (τ : ℍ) : ℂ := legendreInvariant (modularLambda (τ : ℂ))

theorem lambdaInvariant_smul_S (τ : ℍ) :
    lambdaInvariant (ModularGroup.S • τ) = lambdaInvariant τ := by
  have h := congrArg Subtype.val (lambdaPunct_smul_S τ)
  rw [anharmS_apply] at h
  unfold lambdaInvariant
  rw [show modularLambda ((ModularGroup.S • τ : ℍ) : ℂ) = (lambdaPunct (ModularGroup.S • τ) : ℂ)
    from rfl, h, legendreInvariant_one_sub]
  rfl

theorem lambdaInvariant_smul_T (τ : ℍ) :
    lambdaInvariant (ModularGroup.T • τ) = lambdaInvariant τ := by
  have h := congrArg Subtype.val (lambdaPunct_smul_T τ)
  rw [anharmT_apply] at h
  unfold lambdaInvariant
  rw [show modularLambda ((ModularGroup.T • τ : ℍ) : ℂ) = (lambdaPunct (ModularGroup.T • τ) : ℂ)
    from rfl, h, legendreInvariant_div_sub_one]
  rfl

/-- **`J ∘ λ` is a modular function of level one**: `J(λ(γ τ)) = J(λ(τ))` for all
`γ ∈ SL(2, ℤ)`. -/
theorem lambdaInvariant_smul (γ : SL(2, ℤ)) (τ : ℍ) :
    lambdaInvariant (γ • τ) = lambdaInvariant τ := by
  have hγ : γ ∈ Subgroup.closure {ModularGroup.S, ModularGroup.T} := by
    rw [SpecialLinearGroup.SL2Z_generators]; trivial
  induction hγ using Subgroup.closure_induction generalizing τ with
  | mem g hg =>
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
    rcases hg with rfl | rfl
    · exact lambdaInvariant_smul_S τ
    · exact lambdaInvariant_smul_T τ
  | one => rw [one_smul]
  | mul x y _ _ hx hy => rw [mul_smul, hx, hy]
  | inv x _ hx =>
    have := hx (x⁻¹ • τ)
    rw [smul_inv_smul] at this
    exact this.symm

/-- **`J(λ(i)) = 1728`**, from `λ(i) = 1/2`. -/
theorem lambdaInvariant_I : lambdaInvariant UpperHalfPlane.I = 1728 := by
  unfold lambdaInvariant legendreInvariant
  rw [UpperHalfPlane.coe_I, modularLambda_at_I']
  norm_num

/-! ## The Legendre curves `E_{λ(τ)}` -/

theorem modularLambda_ne_zero_ne_one (τ : ℍ) :
    modularLambda (τ : ℂ) ≠ 0 ∧ modularLambda (τ : ℂ) ≠ 1 :=
  mem_compl01.mp (lambdaPunct τ).2

instance legendreCurve_isElliptic (τ : ℍ) :
    WeierstrassCurve.IsElliptic (LegendreDoubling.curve (modularLambda (τ : ℂ))) :=
  (legendre_isElliptic_iff _).mpr (modularLambda_ne_zero_ne_one τ)

/-- The Weierstrass `j`-invariant of the Legendre curve `E_{λ(τ)}` is `J(λ(τ))`. -/
theorem j_legendreCurve (τ : ℍ) :
    WeierstrassCurve.j (LegendreDoubling.curve (modularLambda (τ : ℂ))) = lambdaInvariant τ := by
  rw [legendre_j]
  rfl

/-- **`SL(2, ℤ)` moves `E_{λ(τ)}` inside its isomorphism class**: for every `γ ∈ SL(2, ℤ)` there is
a change of variables over `ℂ` carrying `E_{λ(τ)}` to `E_{λ(γ τ)}`. -/
theorem exists_variableChange_legendreCurve_smul (γ : SL(2, ℤ)) (τ : ℍ) :
    ∃ C : WeierstrassCurve.VariableChange ℂ,
      C • LegendreDoubling.curve (modularLambda (τ : ℂ)) =
        LegendreDoubling.curve (modularLambda ((γ • τ : ℍ) : ℂ)) :=
  WeierstrassCurve.exists_variableChange_of_j_eq _ _ (by
    rw [j_legendreCurve, j_legendreCurve, lambdaInvariant_smul])

end GaloisForLFunctions.KodairaParshinAbc
