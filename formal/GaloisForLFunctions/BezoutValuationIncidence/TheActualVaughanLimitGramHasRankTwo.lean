import GaloisForLFunctions.BezoutValuationIncidence.UniformHalfDampingVaughanGramsHaveAnActualLimit
import GaloisForLFunctions.BezoutValuationIncidence.UpperHalfVaughanGramsHaveAnActualLimit
import GaloisForLFunctions.HTGeometry.MatrixRankSubadditive
import Mathlib.Analysis.Matrix.Order

/-!
At and above half damping, summable actual Vaughan rows define a positive
semidefinite infinite Gram. A quantitative two-cell minor and an outer-product
decomposition give its exact rank two.
-/

open Finset Filter RHTower
open GaloisForLFunctions.TransHorizonIncidenceMechanics
open GaloisForLFunctions.BiScaleUncertainty
open scoped BigOperators Topology
noncomputable section
namespace GaloisForLFunctions.BezoutValuationIncidence
set_option autoImplicit false

/-- At and above half damping all actual limiting-row pairings are summable. -/
theorem summable_pmPronicVaughanLimitGram_terms_of_half_le
    {ε : ℝ} (hε : 1 / 2 ≤ ε) (i j : Fin 5) :
    Summable (fun n : ℕ => pmPronicVaughanLimitFrame ε i n *
      pmPronicVaughanLimitFrame ε j n / (pronicSeq n : ℝ)) := by
  rcases eq_or_lt_of_le hε with h | h
  · subst ε
    exact summable_pmPronicVaughanHalfLimitGram_terms i j
  · exact summable_pmPronicVaughanLimitGram_terms_of_half_lt h i j

/-- Finite pairings of the actual limiting rows converge to their infinite Gram. -/
theorem tendsto_sum_pmPronicVaughanLimitGram_terms
    {ε : ℝ} (hε : 1 / 2 ≤ ε) (i j : Fin 5) :
    Tendsto (fun T : ℕ => ∑ n ∈ Icc 1 T,
      pmPronicVaughanLimitFrame ε i n * pmPronicVaughanLimitFrame ε j n /
        (pronicSeq n : ℝ)) atTop (𝓝 (pmPronicVaughanLimitGram ε i j)) := by
  have hs := summable_pmPronicVaughanLimitGram_terms_of_half_le hε i j
  exact HTGeometry.tendsto_sum_Icc_at_moving_horizon_of_summable_bound
    tendsto_id hs.abs (fun n => abs_nonneg _)
    (by simp only [pronicSeq, Nat.cast_zero, zero_mul, div_zero])
    (fun _ _ => le_rfl) (fun _ => tendsto_const_nhds)

/-- The actual limiting pronic Gram is symmetric. -/
theorem pmPronicVaughanLimitGram_symm (ε : ℝ) (i j : Fin 5) :
    pmPronicVaughanLimitGram ε i j = pmPronicVaughanLimitGram ε j i := by
  apply tsum_congr
  intro n
  rw [mul_comm]

/-- Every quadratic combination of the actual infinite Gram is nonnegative. -/
theorem sum_sum_mul_pmPronicVaughanLimitGram_nonneg
    {ε : ℝ} (hε : 1 / 2 ≤ ε) (x : Fin 5 → ℝ) :
    0 ≤ ∑ i : Fin 5, ∑ j : Fin 5, x i * x j * pmPronicVaughanLimitGram ε i j := by
  have hterm (i j : Fin 5) : HasSum (fun n : ℕ => x i * x j *
      (pmPronicVaughanLimitFrame ε i n * pmPronicVaughanLimitFrame ε j n /
        (pronicSeq n : ℝ))) (x i * x j * pmPronicVaughanLimitGram ε i j) :=
    (summable_pmPronicVaughanLimitGram_terms_of_half_le hε i j).hasSum.mul_left _
  have hsum := hasSum_sum fun i (_hi : i ∈ (univ : Finset (Fin 5))) =>
    hasSum_sum fun j (_hj : j ∈ (univ : Finset (Fin 5))) => hterm i j
  apply hsum.nonneg
  intro n
  have heq : (∑ i : Fin 5, ∑ j : Fin 5, x i * x j *
      (pmPronicVaughanLimitFrame ε i n * pmPronicVaughanLimitFrame ε j n /
        (pronicSeq n : ℝ))) =
      (∑ i : Fin 5, x i * pmPronicVaughanLimitFrame ε i n) ^ 2 /
        (pronicSeq n : ℝ) := by
    rw [pow_two, sum_mul_sum, sum_div]
    apply sum_congr rfl
    intro i _
    rw [sum_div]
    exact sum_congr rfl fun j _ => by ring
  rw [heq]
  positivity

/-- The coefficient direction of the limiting actual prefix row. -/
def pmPronicVaughanLimitPrefixDirection : Fin 5 → ℝ := ![1, 1, -1, 0, 0]

/-- The coefficient direction of the limiting centered pole row. -/
def pmPronicVaughanLimitPoleDirection : Fin 5 → ℝ := ![0, 0, 0, 0, 1]

/-- Every limiting row is generated by the actual prefix and centered pole rows. -/
theorem pmPronicVaughanLimitGram_eq_two_outer_products (ε : ℝ) :
    pmPronicVaughanLimitGram ε =
      Matrix.vecMulVec pmPronicVaughanLimitPrefixDirection (pmPronicVaughanLimitGram ε 0) +
        Matrix.vecMulVec pmPronicVaughanLimitPoleDirection (pmPronicVaughanLimitGram ε 4) := by
  funext i j
  fin_cases i <;>
    simp [pmPronicVaughanLimitGram, pmPronicVaughanLimitFrame,
      pmPronicVaughanLimitPrefixDirection, pmPronicVaughanLimitPoleDirection,
      Matrix.vecMulVec_apply, Matrix.add_apply, neg_mul, tsum_neg]

/-- The limiting Gram has at most two independent coefficient directions. -/
theorem rank_pmPronicVaughanLimitGram_le_two (ε : ℝ) :
    Matrix.rank (pmPronicVaughanLimitGram ε) ≤ 2 := by
  rw [pmPronicVaughanLimitGram_eq_two_outer_products]
  have h := HTGeometry.rank_add_le_rank_add_rank
    (Matrix.vecMulVec pmPronicVaughanLimitPrefixDirection (pmPronicVaughanLimitGram ε 0))
    (Matrix.vecMulVec pmPronicVaughanLimitPoleDirection (pmPronicVaughanLimitGram ε 4))
  exact h.trans (by
    have h₁ := Matrix.rank_vecMulVec_le pmPronicVaughanLimitPrefixDirection
      (pmPronicVaughanLimitGram ε 0)
    have h₂ := Matrix.rank_vecMulVec_le pmPronicVaughanLimitPoleDirection
      (pmPronicVaughanLimitGram ε 4)
    omega)

/-- Two arithmetic cells give a positive minor in every actual infinite Gram at or above half damping. -/
theorem pmPronicVaughanLimitGram_prefix_pole_minor_lower
    {ε : ℝ} (hε : 1 / 2 ≤ ε) :
    ((2 : ℝ) ^ (-ε)) ^ 4 / 15552 ≤
      pmPronicVaughanLimitGram ε 0 0 * pmPronicVaughanLimitGram ε 4 4 -
        pmPronicVaughanLimitGram ε 0 4 ^ 2 := by
  have hlim := ((tendsto_sum_pmPronicVaughanLimitGram_terms hε 0 0).mul
    (tendsto_sum_pmPronicVaughanLimitGram_terms hε 4 4)).sub
      ((tendsto_sum_pmPronicVaughanLimitGram_terms hε 0 4).pow 2)
  apply le_of_tendsto hlim
  filter_upwards [eventually_ge_atTop 2] with T hT
  have h := pmPowerDampedPrefix_pole_pronic_gram_determinant_lower
    (ε := ε) (by linarith only [hε]) hT
  change ((2 : ℝ) ^ (-ε)) ^ 4 / 15552 ≤
    (∑ n ∈ Icc 1 T, pmPowerDampedCenteredDivisorPrefix ε n *
      pmPowerDampedCenteredDivisorPrefix ε n / (pronicSeq n : ℝ)) *
    (∑ n ∈ Icc 1 T, (-addDiff (pmActiveSawtoothComponent ε) n) *
      (-addDiff (pmActiveSawtoothComponent ε) n) / (pronicSeq n : ℝ)) -
    (∑ n ∈ Icc 1 T, pmPowerDampedCenteredDivisorPrefix ε n *
      (-addDiff (pmActiveSawtoothComponent ε) n) / (pronicSeq n : ℝ)) ^ 2
  simpa only [pow_two] using h

/-- The first pole cell gives a positive lower bound for its infinite energy. -/
theorem pmPronicVaughanLimitGram_pole_lower {ε : ℝ} (hε : 1 / 2 ≤ ε) :
    ((2 : ℝ) ^ (-ε)) ^ 2 / 32 ≤ pmPronicVaughanLimitGram ε 4 4 := by
  apply le_of_tendsto (tendsto_sum_pmPronicVaughanLimitGram_terms hε 4 4)
  filter_upwards [eventually_ge_atTop 1] with T hT
  have h := pmActivePairPronicEnergy_lower ε hT
  change ((2 : ℝ) ^ (-ε)) ^ 2 / 32 ≤ ∑ n ∈ Icc 1 T,
    (-addDiff (pmActiveSawtoothComponent ε) n) *
      (-addDiff (pmActiveSawtoothComponent ε) n) / (pronicSeq n : ℝ)
  simpa only [pmActivePairPronicEnergy, neg_mul_neg, pow_two] using h

/-- The actual infinite Gram is positive semidefinite throughout the admitted damping range. -/
theorem pmPronicVaughanLimitGram_posSemidef {ε : ℝ} (hε : 1 / 2 ≤ ε) :
    Matrix.PosSemidef (pmPronicVaughanLimitGram ε) := by
  apply Matrix.posSemidef_iff_dotProduct_mulVec.mpr
  constructor
  · ext i j
    simpa only [Matrix.conjTranspose_apply, star_trivial] using
      pmPronicVaughanLimitGram_symm ε j i
  · intro x
    simpa only [dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, mul_sum,
      mul_assoc, mul_left_comm, mul_comm] using
      sum_sum_mul_pmPronicVaughanLimitGram_nonneg hε x

/-- The actual prefix and pole have a positive-definite two-by-two infinite Gram. -/
theorem pmPronicVaughanLimitGram_prefix_pole_posDef {ε : ℝ} (hε : 1 / 2 ≤ ε) :
    Matrix.PosDef ((pmPronicVaughanLimitGram ε).submatrix
      (![0, 4] : Fin 2 → Fin 5) (![0, 4] : Fin 2 → Fin 5)) := by
  let e : Fin 2 → Fin 5 := ![0, 4]
  have hdet : (Matrix.submatrix (pmPronicVaughanLimitGram ε) e e).det =
      pmPronicVaughanLimitGram ε 0 0 * pmPronicVaughanLimitGram ε 4 4 -
        pmPronicVaughanLimitGram ε 0 4 ^ 2 := by
    rw [Matrix.det_fin_two]
    change pmPronicVaughanLimitGram ε 0 0 * pmPronicVaughanLimitGram ε 4 4 -
      pmPronicVaughanLimitGram ε 0 4 * pmPronicVaughanLimitGram ε 4 0 = _
    rw [pmPronicVaughanLimitGram_symm ε 4 0, pow_two]
  have hdet0 : 0 < (Matrix.submatrix (pmPronicVaughanLimitGram ε) e e).det := by
    rw [hdet]
    exact (by positivity : 0 < ((2 : ℝ) ^ (-ε)) ^ 4 / 15552).trans_le
      (pmPronicVaughanLimitGram_prefix_pole_minor_lower hε)
  exact ((pmPronicVaughanLimitGram_posSemidef hε).submatrix e).posDef_iff_det_ne_zero.mpr
    hdet0.ne'

/-- The actual infinite limiting Gram has rank exactly two at and above half damping. -/
theorem rank_pmPronicVaughanLimitGram {ε : ℝ} (hε : 1 / 2 ≤ ε) :
    Matrix.rank (pmPronicVaughanLimitGram ε) = 2 := by
  let e : Fin 2 → Fin 5 := ![0, 4]
  have hu : IsUnit (Matrix.submatrix (pmPronicVaughanLimitGram ε) e e) :=
    (pmPronicVaughanLimitGram_prefix_pole_posDef hε).isUnit
  have hr := Matrix.rank_of_isUnit _ hu
  have hle := Matrix.rank_submatrix_le (pmPronicVaughanLimitGram ε) e e
  have hupper := rank_pmPronicVaughanLimitGram_le_two ε
  simp only [Fintype.card_fin] at hr
  omega

