import GaloisForLFunctions.BiScaleUncertainty.UniversalRamanujanCovarianceAndBiScaleRigidity
import GaloisForLFunctions.RHTower.PMRamanujanPeriodDiagonal

/-!
# Finite generation of the multi-lag covariance cone

The complete-period covariance of a row at lag `j` is `Cov(j) = Σ_{2 ≤ e ≤ N} c_e(j) Y(e)²` with the
Ramanujan sum `c_e(j)`. So the vectors `(Cov(0), …, Cov(h))` of all rows at all cutoffs form the
convex cone spanned by the mode vectors `v_e = (c_e(0), …, c_e(h))`, `e ≥ 2`. This cone is finitely
generated by explicit modes, for every lag horizon `h`.

Split a mode as `e = g r` with `g` its `h`-smooth part and `r` coprime to `h!`. Lags `j ≤ h` see
`r` only through `μ(r)`: `c_e(j) = μ(r) c_g(j)` for `1 ≤ j ≤ h`, while `c_e(0) = φ(g) φ(r)`. A
smooth part not dividing `(h!)²` is invisible to every lag `1 ≤ j ≤ h`, since `e / gcd(e, j)` is
then not squarefree. With `p_h < p_h'` the first two primes beyond `h`, every mode vector is a
nonnegative combination of the vectors of

`G_h = {g ≥ 2 : g ∣ (h!)²} ∪ {g p_h : g ∣ (h!)²} ∪ {p_h p_h'}`:

the rough part is absorbed by `v_e = a v_g + b v_{g p_h}` with `b = (φ(r) - μ(r))/p_h`,
`a = μ(r) + b`, both nonnegative because every prime factor of `r` is at least `p_h`.

Consequently a linear inequality `Σ_{j ≤ h} α_j Cov(j) ≥ 0` holds for every row at every cutoff
exactly when it holds on the finitely many generators, and the generators are realized once the
cutoff contains them. For `h = 1` the generators are `{2, 6}` and the criterion is `α₀ ≥ α₁`,
`2α₀ + α₁ ≥ 0`; for `h = 2` the generators contain the five modes `{2, 3, 4, 6, 12}`.
-/

open Finset ArithmeticFunction GaloisForLFunctions.BiScaleUncertainty
open scoped BigOperators ArithmeticFunction.Moebius

namespace GaloisForLFunctions.BezoutValuationIncidence
noncomputable section
set_option autoImplicit false

/-! ## §1. The Ramanujan lag weight is multiplicative in the mode -/

theorem isMultiplicative_divisibilityIndicatorArith (h : ℕ) :
    (divisibilityIndicatorArith h).IsMultiplicative := by
  refine ⟨by simp, fun {a b} hab => ?_⟩
  rcases Nat.eq_zero_or_pos a with rfl | ha
  · simp
  rcases Nat.eq_zero_or_pos b with rfl | hb
  · simp
  rw [divisibilityIndicatorArith_apply (Nat.mul_pos ha hb), divisibilityIndicatorArith_apply ha,
    divisibilityIndicatorArith_apply hb]
  by_cases hah : a ∣ h <;> by_cases hbh : b ∣ h
  · rw [if_pos (hab.mul_dvd_of_dvd_of_dvd hah hbh), if_pos hah, if_pos hbh]
    push_cast
    ring
  · rw [if_neg (fun h' => hbh (dvd_of_mul_left_dvd h')), if_neg hbh]
    simp
  · rw [if_neg (fun h' => hah (dvd_of_mul_right_dvd h')), if_neg hah]
    simp
  · rw [if_neg (fun h' => hah (dvd_of_mul_right_dvd h')), if_neg hah]
    simp

theorem ramanujanLagWeight_mul_of_coprime (j : ℕ) {g r : ℕ} (hgr : g.Coprime r) :
    ramanujanLagWeight j (g * r) = ramanujanLagWeight j g * ramanujanLagWeight j r :=
  ((isMultiplicative_divisibilityIndicatorArith j).mul
    isMultiplicative_moebius.intCast).map_mul_of_coprime hgr

/-- A mode is invisible to the lag `j` once `e / gcd(e, j)` is not squarefree. -/
theorem ramanujanLagWeight_eq_zero_of_not_squarefree {e j : ℕ}
    (hsq : ¬ Squarefree (e / Nat.gcd e j)) : ramanujanLagWeight j e = 0 := by
  rw [ramanujanLagWeight_eq_sum_divisors]
  refine sum_eq_zero fun d hd => ?_
  by_cases hdj : d ∣ j
  · have hde : d ∣ e := Nat.dvd_of_mem_divisors hd
    have he0 : e ≠ 0 := (Nat.mem_divisors.mp hd).2
    have hd0 : 0 < d := Nat.pos_of_mem_divisors hd
    set G := Nat.gcd e j with hG
    have hG0 : 0 < G := Nat.gcd_pos_of_pos_left _ (Nat.pos_of_ne_zero he0)
    obtain ⟨m, hm⟩ : d ∣ G := Nat.dvd_gcd hde hdj
    obtain ⟨k, hk⟩ : G ∣ e := Nat.gcd_dvd_left e j
    have hdiv : e / G ∣ e / d := by
      refine ⟨m, ?_⟩
      have h1 : e / G = k := by rw [hk, Nat.mul_div_cancel_left k hG0]
      have h2 : e / d = m * k := by
        rw [hk, hm, Nat.mul_assoc, Nat.mul_div_cancel_left _ hd0]
      rw [h1, h2, Nat.mul_comm]
    rw [if_pos hdj, moebius_eq_zero_of_not_squarefree fun h' => hsq (h'.squarefree_of_dvd hdiv)]
    simp
  · rw [if_neg hdj]
    simp

/-! ## §2. The `h`-smooth part of a mode -/

/-- The `h`-smooth part of `e`: the largest divisor of `e` built from primes `≤ h`. -/
def lagSmoothPart (h e : ℕ) : ℕ := Nat.gcd e (h.factorial ^ e)

theorem lagSmoothPart_dvd (h e : ℕ) : lagSmoothPart h e ∣ e := Nat.gcd_dvd_left _ _

theorem lagSmoothPart_pos {h e : ℕ} (he : e ≠ 0) : 0 < lagSmoothPart h e :=
  Nat.gcd_pos_of_pos_left _ (Nat.pos_of_ne_zero he)

/-- The rough part `e / g` shares no prime with `h!`. -/
theorem coprime_div_lagSmoothPart {h e : ℕ} (he : e ≠ 0) :
    Nat.Coprime (e / lagSmoothPart h e) h.factorial := by
  refine Nat.coprime_of_dvd fun p hp hpr hph => ?_
  have hpow0 : h.factorial ^ e ≠ 0 := pow_ne_zero _ (Nat.factorial_ne_zero h)
  have hg := lagSmoothPart_dvd h e
  have hr0 : e / lagSmoothPart h e ≠ 0 :=
    (Nat.div_pos (Nat.le_of_dvd (Nat.pos_of_ne_zero he) hg) (lagSmoothPart_pos he)).ne'
  have hpos := hp.factorization_pos_of_dvd hr0 hpr
  rw [Nat.factorization_div hg, lagSmoothPart, Nat.factorization_gcd he hpow0,
    Nat.factorization_pow] at hpos
  have hfac : 1 ≤ h.factorial.factorization p :=
    hp.factorization_pos_of_dvd (Nat.factorial_ne_zero h) hph
  have hlt := Nat.factorization_lt p he
  simp only [Finsupp.tsub_apply, Finsupp.inf_apply, Finsupp.smul_apply, smul_eq_mul] at hpos
  have : e.factorization p ≤ e * h.factorial.factorization p := by nlinarith
  rw [inf_eq_left.mpr this] at hpos
  omega

theorem coprime_lagSmoothPart_div {h e : ℕ} (he : e ≠ 0) :
    Nat.Coprime (lagSmoothPart h e) (e / lagSmoothPart h e) :=
  ((coprime_div_lagSmoothPart he).pow_right e).symm.coprime_dvd_left (Nat.gcd_dvd_right _ _)

theorem lagSmoothPart_mul_div {h e : ℕ} : lagSmoothPart h e * (e / lagSmoothPart h e) = e :=
  Nat.mul_div_cancel' (lagSmoothPart_dvd h e)

/-- A smooth part deeper than `(h!)²` is invisible to every lag `1 ≤ j ≤ h`. -/
theorem ramanujanLagWeight_eq_zero_of_deep {h e j : ℕ} (he : e ≠ 0)
    (hdeep : ¬ lagSmoothPart h e ∣ h.factorial ^ 2) (hj1 : 1 ≤ j) (hjh : j ≤ h) :
    ramanujanLagWeight j e = 0 := by
  apply ramanujanLagWeight_eq_zero_of_not_squarefree
  have hg0 := (lagSmoothPart_pos (h := h) he).ne'
  have hF0 : h.factorial ^ 2 ≠ 0 := pow_ne_zero _ (Nat.factorial_ne_zero h)
  rw [← Nat.factorization_le_iff_dvd hg0 hF0, Finsupp.le_def] at hdeep
  push Not at hdeep
  obtain ⟨p, hp⟩ := hdeep
  rw [Nat.factorization_pow] at hp
  simp only [Finsupp.smul_apply, smul_eq_mul] at hp
  have hpos : 0 < (lagSmoothPart h e).factorization p := by omega
  have hprime : p.Prime := Nat.prime_of_mem_primeFactors (Finsupp.mem_support_iff.mpr hpos.ne')
  have hpg : p ∣ lagSmoothPart h e := Nat.dvd_of_mem_primeFactors
    (Finsupp.mem_support_iff.mpr hpos.ne')
  have hph : p ∣ h.factorial :=
    hprime.dvd_of_dvd_pow ((hpg.trans (Nat.gcd_dvd_right _ _)))
  have hfac : 1 ≤ h.factorial.factorization p :=
    hprime.factorization_pos_of_dvd (Nat.factorial_ne_zero h) hph
  have hge : (lagSmoothPart h e).factorization p ≤ e.factorization p :=
    (Nat.factorization_le_iff_dvd hg0 he).mpr (lagSmoothPart_dvd h e) p
  have hj0 : j ≠ 0 := by omega
  have hjF : j.factorization p ≤ h.factorial.factorization p :=
    (Nat.factorization_le_iff_dvd hj0 (Nat.factorial_ne_zero h)).mpr
      (Nat.dvd_factorial (by omega) hjh) p
  have hgcd0 : Nat.gcd e j ≠ 0 := (Nat.gcd_pos_of_pos_right _ (by omega)).ne'
  have hgcdF : (Nat.gcd e j).factorization p ≤ j.factorization p :=
    (Nat.factorization_le_iff_dvd hgcd0 hj0).mpr (Nat.gcd_dvd_right _ _) p
  have hq : 2 ≤ (e / Nat.gcd e j).factorization p := by
    rw [Nat.factorization_div (Nat.gcd_dvd_left _ _)]
    simp only [Finsupp.tsub_apply]
    omega
  intro hsq
  have hdiv : p * p ∣ e / Nat.gcd e j := by
    rw [← pow_two]
    exact (hprime.pow_dvd_iff_le_factorization
      (Nat.div_pos (Nat.le_of_dvd (Nat.pos_of_ne_zero he) (Nat.gcd_dvd_left _ _))
        (Nat.pos_of_ne_zero hgcd0)).ne').mpr hq
  exact hprime.one_lt.ne' (Nat.isUnit_iff.mp (hsq p hdiv))

/-! ## §3. The first two primes beyond the lag horizon -/

/-- The least prime exceeding `h`. -/
def firstPrimeAbove (h : ℕ) : ℕ := Nat.find (Nat.exists_infinite_primes (h + 1))

theorem firstPrimeAbove_spec (h : ℕ) : h < firstPrimeAbove h ∧ (firstPrimeAbove h).Prime := by
  have := Nat.find_spec (Nat.exists_infinite_primes (h + 1))
  exact ⟨this.1, this.2⟩

theorem firstPrimeAbove_le {h q : ℕ} (hq : q.Prime) (hhq : h < q) : firstPrimeAbove h ≤ q :=
  Nat.find_min' (Nat.exists_infinite_primes (h + 1)) ⟨hhq, hq⟩

/-- The second prime beyond `h`. -/
def secondPrimeAbove (h : ℕ) : ℕ := firstPrimeAbove (firstPrimeAbove h)

theorem secondPrimeAbove_spec (h : ℕ) :
    firstPrimeAbove h < secondPrimeAbove h ∧ (secondPrimeAbove h).Prime :=
  firstPrimeAbove_spec _

/-- A mode coprime to `h!` is at least `p_h - 1` in totient once it is `≥ 2`. -/
private theorem rough_minFac {h r : ℕ} (hr : 2 ≤ r) (hcop : Nat.Coprime r h.factorial) :
    h < r.minFac := by
  by_contra hle
  push Not at hle
  have hmin := Nat.minFac_prime (by omega : r ≠ 1)
  have hd := Nat.dvd_gcd (Nat.minFac_dvd r) (Nat.dvd_factorial hmin.pos hle)
  rw [hcop.gcd_eq_one] at hd
  exact hmin.one_lt.ne' (Nat.dvd_one.mp hd)

theorem totient_rough_ge {h r : ℕ} (hr : 2 ≤ r) (hcop : Nat.Coprime r h.factorial) :
    (firstPrimeAbove h : ℝ) - 1 ≤ (r.totient : ℝ) := by
  have hmin := Nat.minFac_prime (by omega : r ≠ 1)
  have hle := firstPrimeAbove_le hmin (rough_minFac hr hcop)
  have hdvd := Nat.le_of_dvd (Nat.totient_pos.mpr (by omega)) (Nat.totient_dvd_of_dvd (Nat.minFac_dvd r))
  rw [Nat.totient_prime hmin] at hdvd
  have : (firstPrimeAbove h : ℝ) ≤ r.minFac := by exact_mod_cast hle
  have h1 : ((r.minFac - 1 : ℕ) : ℝ) = r.minFac - 1 := by
    rw [Nat.cast_sub hmin.one_lt.le, Nat.cast_one]
  have h2 : ((r.minFac - 1 : ℕ) : ℝ) ≤ r.totient := by exact_mod_cast hdvd
  linarith

/-- A rough mode with `μ = 1` has two distinct prime factors beyond `h`. -/
theorem totient_rough_ge_two_primes {h r : ℕ} (hr : 2 ≤ r) (hcop : Nat.Coprime r h.factorial)
    (hμ : μ r = 1) :
    ((firstPrimeAbove h : ℝ) - 1) * ((secondPrimeAbove h : ℝ) - 1) ≤ (r.totient : ℝ) := by
  have hsq : Squarefree r := by
    by_contra hns
    rw [moebius_eq_zero_of_not_squarefree hns] at hμ
    norm_num at hμ
  set p := r.minFac with hpdef
  have hp := Nat.minFac_prime (by omega : r ≠ 1)
  obtain ⟨s, hs⟩ := Nat.minFac_dvd r
  -- the cofactor is not one, else `r` would be a prime with `μ = -1`
  have hs2 : 2 ≤ s := by
    rcases Nat.lt_or_ge s 2 with hlt | hge
    · interval_cases s
      · omega
      · rw [mul_one] at hs
        rw [hs, moebius_apply_prime hp] at hμ
        norm_num at hμ
    · exact hge
  have hcop_s : Nat.Coprime s h.factorial :=
    hcop.coprime_dvd_left ⟨p, by rw [hs]; ring⟩
  set q := s.minFac with hqdef
  have hq := Nat.minFac_prime (by omega : s ≠ 1)
  have hpq : p ≠ q := by
    intro heq
    have hdvd : p * p ∣ r := by
      rw [hs]
      exact Nat.mul_dvd_mul_left p (heq ▸ Nat.minFac_dvd s)
    exact hp.one_lt.ne' (Nat.isUnit_iff.mp (hsq p hdvd))
  have hph : h < p := rough_minFac hr hcop
  have hqh : h < q := rough_minFac hs2 hcop_s
  have hpqdvd : p * q ∣ r := by
    rw [hs]
    exact Nat.mul_dvd_mul_left p (Nat.minFac_dvd s)
  have hφ := Nat.le_of_dvd (Nat.totient_pos.mpr (by omega)) (Nat.totient_dvd_of_dvd hpqdvd)
  rw [Nat.totient_mul ((Nat.coprime_primes hp hq).mpr hpq), Nat.totient_prime hp,
    Nat.totient_prime hq] at hφ
  have hφR : ((p : ℝ) - 1) * ((q : ℝ) - 1) ≤ r.totient := by
    have h1 : (((p - 1) * (q - 1) : ℕ) : ℝ) ≤ r.totient := by exact_mod_cast hφ
    rwa [Nat.cast_mul, Nat.cast_sub hp.one_lt.le, Nat.cast_sub hq.one_lt.le, Nat.cast_one] at h1
  -- one of the two primes is at least `p_h`, the other at least `p_h'`
  have hP := firstPrimeAbove_spec h
  have hfp : firstPrimeAbove h ≤ p := firstPrimeAbove_le hp hph
  have hfq : firstPrimeAbove h ≤ q := firstPrimeAbove_le hq hqh
  have hsec : ∀ t : ℕ, t.Prime → firstPrimeAbove h < t → secondPrimeAbove h ≤ t :=
    fun t ht hlt => firstPrimeAbove_le ht hlt
  have hp1 : (1 : ℝ) ≤ (firstPrimeAbove h : ℝ) - 1 := by
    have : 2 ≤ firstPrimeAbove h := hP.2.two_le
    have : (2 : ℝ) ≤ firstPrimeAbove h := by exact_mod_cast this
    linarith
  rcases lt_or_ge p q with hlt | hge
  · have hsq' : secondPrimeAbove h ≤ q := hsec q hq (lt_of_le_of_lt hfp hlt)
    have a1 : (firstPrimeAbove h : ℝ) - 1 ≤ p - 1 := by
      have : (firstPrimeAbove h : ℝ) ≤ p := by exact_mod_cast hfp
      linarith
    have a2 : (secondPrimeAbove h : ℝ) - 1 ≤ q - 1 := by
      have : (secondPrimeAbove h : ℝ) ≤ q := by exact_mod_cast hsq'
      linarith
    have a3 : (0 : ℝ) ≤ (secondPrimeAbove h : ℝ) - 1 := by
      have := (firstPrimeAbove_spec (firstPrimeAbove h)).2.one_lt
      have : (1 : ℝ) < secondPrimeAbove h := by exact_mod_cast this
      linarith
    nlinarith
  · have hgt : q < p := lt_of_le_of_ne hge (Ne.symm hpq)
    have hsp' : secondPrimeAbove h ≤ p := hsec p hp (lt_of_le_of_lt hfq hgt)
    have a1 : (firstPrimeAbove h : ℝ) - 1 ≤ q - 1 := by
      have : (firstPrimeAbove h : ℝ) ≤ q := by exact_mod_cast hfq
      linarith
    have a2 : (secondPrimeAbove h : ℝ) - 1 ≤ p - 1 := by
      have : (secondPrimeAbove h : ℝ) ≤ p := by exact_mod_cast hsp'
      linarith
    have a3 : (0 : ℝ) ≤ (secondPrimeAbove h : ℝ) - 1 := by
      have := (firstPrimeAbove_spec (firstPrimeAbove h)).2.one_lt
      have : (1 : ℝ) < secondPrimeAbove h := by exact_mod_cast this
      linarith
    nlinarith

/-! ## §4. The generators and the cone -/

/-- The finite generator set `G_h`. -/
def lagConeGenerators (h : ℕ) : Finset ℕ :=
  ((h.factorial ^ 2).divisors.filter (fun g => 2 ≤ g)) ∪
    ((h.factorial ^ 2).divisors.image (fun g => g * firstPrimeAbove h)) ∪
      {firstPrimeAbove h * secondPrimeAbove h}

/-- `v` lies in the cone spanned by the generator mode vectors on lags `0, …, h`. -/
def InLagCovarianceCone (h : ℕ) (v : ℕ → ℝ) : Prop :=
  ∃ w : ℕ → ℝ, (∀ g, 0 ≤ w g) ∧
    ∀ j ≤ h, v j = ∑ g ∈ lagConeGenerators h, w g * ramanujanLagWeight j g

theorem InLagCovarianceCone.add {h : ℕ} {v u : ℕ → ℝ} (hv : InLagCovarianceCone h v)
    (hu : InLagCovarianceCone h u) : InLagCovarianceCone h (fun j => v j + u j) := by
  obtain ⟨w, hw, hv⟩ := hv
  obtain ⟨w', hw', hu⟩ := hu
  refine ⟨fun g => w g + w' g, fun g => add_nonneg (hw g) (hw' g), fun j hj => ?_⟩
  dsimp only
  rw [hv j hj, hu j hj, ← sum_add_distrib]
  exact sum_congr rfl fun g _ => by ring

theorem InLagCovarianceCone.smul {h : ℕ} {v : ℕ → ℝ} (hv : InLagCovarianceCone h v) {t : ℝ}
    (ht : 0 ≤ t) : InLagCovarianceCone h (fun j => t * v j) := by
  obtain ⟨w, hw, hv⟩ := hv
  refine ⟨fun g => t * w g, fun g => mul_nonneg ht (hw g), fun j hj => ?_⟩
  dsimp only
  rw [hv j hj, mul_sum]
  exact sum_congr rfl fun g _ => by ring

theorem InLagCovarianceCone.congr {h : ℕ} {v u : ℕ → ℝ} (hv : InLagCovarianceCone h v)
    (heq : ∀ j ≤ h, u j = v j) : InLagCovarianceCone h u := by
  obtain ⟨w, hw, hv⟩ := hv
  exact ⟨w, hw, fun j hj => (heq j hj).trans (hv j hj)⟩

theorem inLagCovarianceCone_generator {h g : ℕ} (hg : g ∈ lagConeGenerators h) :
    InLagCovarianceCone h (fun j => ramanujanLagWeight j g) := by
  classical
  refine ⟨fun g' => if g' = g then 1 else 0, fun g' => by dsimp only; split_ifs <;> norm_num,
    fun j _ => ?_⟩
  rw [sum_eq_single_of_mem g hg fun b _ hb => by simp [hb]]
  simp

theorem firstPrimeAbove_mem (h : ℕ) : firstPrimeAbove h ∈ lagConeGenerators h := by
  unfold lagConeGenerators
  refine mem_union_left _ (mem_union_right _ (mem_image.mpr ⟨1, ?_, one_mul _⟩))
  exact Nat.mem_divisors.mpr ⟨one_dvd _, pow_ne_zero _ (Nat.factorial_ne_zero h)⟩

theorem twoPrimes_mem (h : ℕ) :
    firstPrimeAbove h * secondPrimeAbove h ∈ lagConeGenerators h :=
  mem_union_right _ (mem_singleton_self _)

/-- Lags `1, …, h` see the rough part only through `μ`. -/
theorem ramanujanLagWeight_smooth_mul_rough {h g r j : ℕ} (hgr : g.Coprime r)
    (hr : Nat.Coprime r h.factorial) (hj1 : 1 ≤ j) (hjh : j ≤ h) :
    ramanujanLagWeight j (g * r) = (μ r : ℝ) * ramanujanLagWeight j g := by
  rw [ramanujanLagWeight_mul_of_coprime j hgr,
    ramanujanLagWeight_of_coprime (hr.coprime_dvd_right (Nat.dvd_factorial hj1 hjh)), mul_comm]

/-- The pure variance direction `(1, 0, …, 0)` lies in the cone. -/
theorem inLagCovarianceCone_variance (h : ℕ) :
    InLagCovarianceCone h (fun j => if j = 0 then 1 else 0) := by
  have hP := firstPrimeAbove_spec h
  have hQ := secondPrimeAbove_spec h
  set P := firstPrimeAbove h
  set Q := secondPrimeAbove h
  have hPQ : P.Coprime Q := (Nat.coprime_primes hP.2 hQ.2).mpr (ne_of_lt hQ.1)
  have hsum := (inLagCovarianceCone_generator (firstPrimeAbove_mem h)).add
    (inLagCovarianceCone_generator (twoPrimes_mem h))
  have hden : (0 : ℝ) < ((P : ℝ) - 1) * Q := by
    have h1 : (1 : ℝ) < P := by exact_mod_cast hP.2.one_lt
    have h2 : (0 : ℝ) < Q := by exact_mod_cast hQ.2.pos
    nlinarith
  refine (hsum.smul (inv_nonneg.mpr hden.le)).congr fun j hj => ?_
  rcases Nat.eq_zero_or_pos j with rfl | hj1
  · simp only [if_true, ramanujanLagWeight_zero_left]
    rw [Nat.totient_mul hPQ, Nat.totient_prime hP.2, Nat.totient_prime hQ.2]
    push_cast [Nat.cast_sub hP.2.one_lt.le, Nat.cast_sub hQ.2.one_lt.le]
    rw [show ((P : ℝ) - 1) + ((P : ℝ) - 1) * ((Q : ℝ) - 1) = ((P : ℝ) - 1) * Q by ring,
      inv_mul_cancel₀ hden.ne']
  · have hPh := hP.1
    have hQP := hQ.1
    have hPj : Nat.Coprime P j := hP.2.coprime_iff_not_dvd.mpr fun hd => by
      have := Nat.le_of_dvd hj1 hd
      omega
    have hQj : Nat.Coprime Q j := hQ.2.coprime_iff_not_dvd.mpr fun hd => by
      have := Nat.le_of_dvd hj1 hd
      omega
    rw [if_neg (by omega), ramanujanLagWeight_mul_of_coprime j hPQ,
      ramanujanLagWeight_of_coprime hPj, ramanujanLagWeight_of_coprime hQj,
      moebius_apply_prime hP.2, moebius_apply_prime hQ.2]
    simp

/-- A smooth generator `g ≥ 2` absorbs a squarefree rough part:
`v_{g r} = (μ(r) + b) v_g + b v_{g p_h}` with `b = (φ(r) - μ(r)) / p_h`. -/
theorem inLagCovarianceCone_smooth_mul_rough {h g r : ℕ} (hg2 : 2 ≤ g)
    (hgdiv : g ∈ (h.factorial ^ 2).divisors) (hgr : g.Coprime r)
    (hrh : Nat.Coprime r h.factorial) (hr2 : 2 ≤ r) (hμ : μ r = 1 ∨ μ r = -1) :
    InLagCovarianceCone h (fun j => ramanujanLagWeight j (g * r)) := by
  set P := firstPrimeAbove h
  have hP := firstPrimeAbove_spec h
  have hPh : Nat.Coprime P h.factorial := hP.2.coprime_iff_not_dvd.mpr fun hd => by
    have := (Nat.Prime.dvd_factorial hP.2).mp hd
    have := hP.1
    omega
  have hgP : g.Coprime P :=
    ((hPh.pow_right 2).symm).coprime_dvd_left (Nat.dvd_of_mem_divisors hgdiv)
  have hgen : g ∈ lagConeGenerators h :=
    mem_union_left _ (mem_union_left _ (mem_filter.mpr ⟨hgdiv, hg2⟩))
  have hgenP : g * P ∈ lagConeGenerators h :=
    mem_union_left _ (mem_union_right _ (mem_image.mpr ⟨g, hgdiv, rfl⟩))
  have hφr := totient_rough_ge hr2 hrh
  have hP0 : (0 : ℝ) < P := by exact_mod_cast hP.2.pos
  set m : ℝ := (μ r : ℝ) with hmdef
  have hm : m = 1 ∨ m = -1 := by
    rcases hμ with h1 | h1
    · left
      rw [hmdef, h1]
      norm_num
    · right
      rw [hmdef, h1]
      norm_num
  set b : ℝ := ((r.totient : ℝ) - m) / P with hbdef
  have hb0 : 0 ≤ b := by
    have h1 : (1 : ℝ) ≤ r.totient := by exact_mod_cast Nat.totient_pos.mpr (by omega)
    rcases hm with h | h <;> rw [hbdef, h] <;> apply div_nonneg _ hP0.le <;> linarith
  have ha0 : 0 ≤ m + b := by
    rcases hm with h1 | h1
    · rw [h1]
      linarith
    · rw [hbdef, h1, show (-1 : ℝ) + ((r.totient : ℝ) - -1) / P =
          ((r.totient : ℝ) + 1 - P) / P by field_simp; ring]
      exact div_nonneg (by linarith) hP0.le
  refine (((inLagCovarianceCone_generator hgen).smul ha0).add
    ((inLagCovarianceCone_generator hgenP).smul hb0)).congr fun j hj => ?_
  rcases Nat.eq_zero_or_pos j with rfl | hj1
  · simp only [ramanujanLagWeight_zero_left]
    rw [Nat.totient_mul hgr, Nat.totient_mul hgP, Nat.totient_prime hP.2, hbdef]
    push_cast [Nat.cast_sub hP.2.one_lt.le]
    field_simp
    ring
  · rw [ramanujanLagWeight_smooth_mul_rough hgr hrh hj1 hj,
      ramanujanLagWeight_smooth_mul_rough hgP hPh hj1 hj, moebius_apply_prime hP.2]
    rw [← hmdef]
    push_cast
    ring

/-- **Finite generation.** Every mode vector `(c_e(0), …, c_e(h))`, `e ≥ 2`, lies in the cone of
the generator set `G_h`. -/
theorem inLagCovarianceCone_mode (h : ℕ) {e : ℕ} (he : 2 ≤ e) :
    InLagCovarianceCone h (fun j => ramanujanLagWeight j e) := by
  have he0 : e ≠ 0 := by omega
  set g := lagSmoothPart h e with hgdef
  set r := e / g with hrdef
  have hg0 : 0 < g := lagSmoothPart_pos he0
  have hgr : g.Coprime r := coprime_lagSmoothPart_div he0
  have hrh : Nat.Coprime r h.factorial := coprime_div_lagSmoothPart he0
  have hger : g * r = e := lagSmoothPart_mul_div
  have hvar := inLagCovarianceCone_variance h
  -- the variance multiple `φ(e) e₀`
  have hpure : (∀ j, 1 ≤ j → j ≤ h → ramanujanLagWeight j e = 0) →
      InLagCovarianceCone h (fun j => ramanujanLagWeight j e) := fun hzero =>
    (hvar.smul (Nat.cast_nonneg e.totient)).congr fun j hj => by
      rcases Nat.eq_zero_or_pos j with rfl | hj1
      · simp [ramanujanLagWeight_zero_left]
      · rw [hzero j hj1 hj, if_neg (by omega), mul_zero]
  by_cases hdeep : g ∣ h.factorial ^ 2
  swap
  · exact hpure fun j hj1 hjh => ramanujanLagWeight_eq_zero_of_deep he0 hdeep hj1 hjh
  have hgdiv : g ∈ (h.factorial ^ 2).divisors :=
    Nat.mem_divisors.mpr ⟨hdeep, pow_ne_zero _ (Nat.factorial_ne_zero h)⟩
  rcases Nat.lt_or_ge r 2 with hr1 | hr2
  · -- no rough part: `e` is itself a smooth generator
    have hr1' : r = 1 := by
      have : 0 < r := Nat.div_pos (Nat.le_of_dvd (by omega) (lagSmoothPart_dvd h e)) hg0
      omega
    have hge : g = e := by rw [← hger, hr1', mul_one]
    have hmem : e ∈ lagConeGenerators h :=
      mem_union_left _ (mem_union_left _ (mem_filter.mpr ⟨hge ▸ hgdiv, he⟩))
    exact inLagCovarianceCone_generator hmem
  -- the rough part is at least `p_h`
  have hφr := totient_rough_ge hr2 hrh
  have hP := firstPrimeAbove_spec h
  have hP1 : (1 : ℝ) < firstPrimeAbove h := by exact_mod_cast hP.2.one_lt
  have hlag : ∀ j, 1 ≤ j → j ≤ h →
      ramanujanLagWeight j e = (μ r : ℝ) * ramanujanLagWeight j g := fun j hj1 hjh => by
    rw [← hger]
    exact ramanujanLagWeight_smooth_mul_rough hgr hrh hj1 hjh
  have hzero : ramanujanLagWeight 0 e = (g.totient : ℝ) * r.totient := by
    rw [ramanujanLagWeight_zero_left, ← hger, Nat.totient_mul hgr]
    push_cast
    ring
  rcases moebius_eq_or r with hμ | hμ | hμ
  · -- non-squarefree rough part: pure variance
    exact hpure fun j hj1 hjh => by rw [hlag j hj1 hjh, hμ]; simp
  all_goals
    rcases Nat.lt_or_ge g 2 with hg1 | hg2
    swap
    · rw [← hger]
      exact inLagCovarianceCone_smooth_mul_rough hg2 hgdiv hgr hrh hr2 (by simp [hμ])
  · -- `g = 1`, `μ(r) = 1`: the two-prime generator plus a variance multiple
    have hg1' : g = 1 := by omega
    have hφ2 := totient_rough_ge_two_primes hr2 hrh hμ
    have hQ := secondPrimeAbove_spec h
    set P := firstPrimeAbove h
    set Q := secondPrimeAbove h
    have hPQ : P.Coprime Q := (Nat.coprime_primes hP.2 hQ.2).mpr (ne_of_lt hQ.1)
    have hbase := inLagCovarianceCone_generator (twoPrimes_mem h)
    have hextra := hvar.smul (sub_nonneg.mpr hφ2)
    refine (hbase.add hextra).congr fun j hj => ?_
    rcases Nat.eq_zero_or_pos j with rfl | hj1
    · rw [hzero, hg1', ramanujanLagWeight_zero_left, Nat.totient_mul hPQ, Nat.totient_prime hP.2,
        Nat.totient_prime hQ.2]
      push_cast [Nat.cast_sub hP.2.one_lt.le, Nat.cast_sub hQ.2.one_lt.le]
      simp
    · have hPh := hP.1
      have hQP := hQ.1
      have hPj : Nat.Coprime P j := hP.2.coprime_iff_not_dvd.mpr fun hd => by
        have := Nat.le_of_dvd hj1 hd
        omega
      have hQj : Nat.Coprime Q j := hQ.2.coprime_iff_not_dvd.mpr fun hd => by
        have := Nat.le_of_dvd hj1 hd
        omega
      rw [hlag j hj1 hj, hμ, hg1', ramanujanLagWeight_mul_of_coprime j hPQ,
        ramanujanLagWeight_of_coprime hPj, ramanujanLagWeight_of_coprime hQj,
        moebius_apply_prime hP.2, moebius_apply_prime hQ.2, if_neg (by omega),
        ramanujanLagWeight_of_coprime (Nat.coprime_one_left j)]
      simp
  · -- `g = 1`, `μ(r) = -1`: the first prime generator plus a variance multiple
    have hg1' : g = 1 := by omega
    set P := firstPrimeAbove h
    have hbase := inLagCovarianceCone_generator (firstPrimeAbove_mem h)
    have hextra := hvar.smul (sub_nonneg.mpr hφr)
    refine (hbase.add hextra).congr fun j hj => ?_
    rcases Nat.eq_zero_or_pos j with rfl | hj1
    · rw [hzero, hg1', ramanujanLagWeight_zero_left, Nat.totient_prime hP.2]
      push_cast [Nat.cast_sub hP.2.one_lt.le]
      simp
    · have hPh := hP.1
      have hPj : Nat.Coprime P j := hP.2.coprime_iff_not_dvd.mpr fun hd => by
        have := Nat.le_of_dvd hj1 hd
        omega
      rw [hlag j hj1 hj, hμ, hg1', ramanujanLagWeight_of_coprime hPj, moebius_apply_prime hP.2,
        if_neg (by omega), ramanujanLagWeight_of_coprime (Nat.coprime_one_left j)]
      simp

/-! ## §5. Covariance profiles of rows and finite certificates -/

theorem inLagCovarianceCone_zero (h : ℕ) : InLagCovarianceCone h (fun _ => 0) :=
  ⟨fun _ => 0, fun _ => le_rfl, fun j _ => by simp⟩

theorem InLagCovarianceCone.sum {h : ℕ} {ι : Type*} (s : Finset ι) {v : ι → ℕ → ℝ}
    (hv : ∀ i ∈ s, InLagCovarianceCone h (v i)) :
    InLagCovarianceCone h (fun j => ∑ i ∈ s, v i j) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using inLagCovarianceCone_zero h
  | insert a s ha ih =>
    refine ((hv a (mem_insert_self a s)).add (ih fun i hi => hv i (mem_insert_of_mem hi))).congr
      fun j _ => ?_
    rw [sum_insert ha]

/-- **The covariance cone.** At every cutoff, the lag covariances `Cov(0), …, Cov(h)` of every row
form a vector of the finitely generated cone. -/
theorem periodCovariance_mem_lagCovarianceCone (h N : ℕ) (c : ℕ → ℝ) :
    InLagCovarianceCone h (fun j => TwoLagSieve.periodCovariance N c j) := by
  have hsum := InLagCovarianceCone.sum (h := h) (Icc 2 N)
    (v := fun e j => selbergMultiplesCoord N c e ^ 2 * ramanujanLagWeight j e)
    fun e he => (inLagCovarianceCone_mode h (mem_Icc.mp he).1).smul (sq_nonneg _)
  refine hsum.congr fun j _ => ?_
  rw [periodCovariance_eq_ramanujanLagWeight_diagonal]
  exact sum_congr rfl fun e _ => by ring

/-- Every generator mode is realized by a row once the cutoff contains it. -/
theorem exists_row_periodCovariance_eq_generator {N g : ℕ} (hg : g ∈ Icc 2 N) :
    ∃ c : ℕ → ℝ, ∀ j, TwoLagSieve.periodCovariance N c j = ramanujanLagWeight j g := by
  classical
  set a : ℕ → ℝ := fun e => if e = g then 1 else 0
  refine ⟨RHTower.pmRamanujanResidueCoeff a N, fun j => ?_⟩
  rw [periodCovariance_eq_ramanujanLagWeight_diagonal]
  have hY : ∀ e ∈ Icc 2 N, selbergMultiplesCoord N (RHTower.pmRamanujanResidueCoeff a N) e = a e :=
    fun e he => RHTower.pmRamanujanResidueCoeff_multiples a (by have := (mem_Icc.mp he).1; omega)
      (mem_Icc.mp he).2
  rw [sum_congr rfl fun e he => by rw [hY e he], sum_eq_single_of_mem g hg fun e _ he => by
    simp [a, he]]
  simp [a]

/-- **Finite certificate for universal lag inequalities.** A linear inequality in the lag
covariances `0, …, h` holds for every row at every cutoff if it holds on the generators; at a
cutoff containing the generators the converse holds. -/
theorem lagCovariance_inequality_of_generators (h : ℕ) (α : ℕ → ℝ)
    (hgen : ∀ g ∈ lagConeGenerators h, 0 ≤ ∑ j ∈ range (h + 1), α j * ramanujanLagWeight j g)
    (N : ℕ) (c : ℕ → ℝ) :
    0 ≤ ∑ j ∈ range (h + 1), α j * TwoLagSieve.periodCovariance N c j := by
  obtain ⟨w, hw, hcov⟩ := periodCovariance_mem_lagCovarianceCone h N c
  have hcov' : ∀ j ≤ h, TwoLagSieve.periodCovariance N c j =
      ∑ g ∈ lagConeGenerators h, w g * ramanujanLagWeight j g := hcov
  rw [sum_congr rfl fun j hj => by rw [hcov' j (by have := mem_range.mp hj; omega)]]
  simp_rw [mul_sum]
  rw [sum_comm]
  refine sum_nonneg fun g hg => ?_
  rw [show (∑ j ∈ range (h + 1), α j * (w g * ramanujanLagWeight j g)) =
      w g * ∑ j ∈ range (h + 1), α j * ramanujanLagWeight j g by
    rw [mul_sum]
    exact sum_congr rfl fun j _ => by ring]
  exact mul_nonneg (hw g) (hgen g hg)

theorem lagCovariance_inequality_iff_generators (h : ℕ) (α : ℕ → ℝ) {N : ℕ}
    (hN : lagConeGenerators h ⊆ Icc 2 N) :
    (∀ c : ℕ → ℝ, 0 ≤ ∑ j ∈ range (h + 1), α j * TwoLagSieve.periodCovariance N c j) ↔
      ∀ g ∈ lagConeGenerators h, 0 ≤ ∑ j ∈ range (h + 1), α j * ramanujanLagWeight j g := by
  constructor
  · intro hall g hg
    obtain ⟨c, hc⟩ := exists_row_periodCovariance_eq_generator (hN hg)
    simpa [hc] using hall c
  · exact fun hgen c => lagCovariance_inequality_of_generators h α hgen N c

/-! ## §6. The lag-one cone -/

theorem firstPrimeAbove_one : firstPrimeAbove 1 = 2 := by
  unfold firstPrimeAbove
  rw [Nat.find_eq_iff]
  refine ⟨⟨le_rfl, Nat.prime_two⟩, fun n hn hpn => ?_⟩
  omega

theorem secondPrimeAbove_one : secondPrimeAbove 1 = 3 := by
  unfold secondPrimeAbove
  rw [firstPrimeAbove_one]
  unfold firstPrimeAbove
  rw [Nat.find_eq_iff]
  refine ⟨⟨le_rfl, Nat.prime_three⟩, fun n hn hpn => ?_⟩
  omega

theorem lagConeGenerators_one : lagConeGenerators 1 = {2, 6} := by
  unfold lagConeGenerators
  rw [firstPrimeAbove_one, secondPrimeAbove_one]
  decide

/-- At lag horizon one the certificate is exactly `α₀ ≥ α₁` and `2 α₀ + α₁ ≥ 0`. -/
theorem lagOne_inequality_iff {N : ℕ} (hN : 6 ≤ N) (α₀ α₁ : ℝ) :
    (∀ c : ℕ → ℝ, 0 ≤ α₀ * TwoLagSieve.periodCovariance N c 0 +
        α₁ * TwoLagSieve.periodCovariance N c 1) ↔ (α₁ ≤ α₀ ∧ 0 ≤ 2 * α₀ + α₁) := by
  have hsub : lagConeGenerators 1 ⊆ Icc 2 N := by
    rw [lagConeGenerators_one]
    intro g hg
    simp only [mem_insert, mem_singleton] at hg
    rcases hg with rfl | rfl <;> exact mem_Icc.mpr ⟨by omega, by omega⟩
  have h := lagCovariance_inequality_iff_generators 1 (fun j => if j = 0 then α₀ else α₁) hsub
  have key : ∀ f : ℕ → ℝ, (∑ j ∈ range (1 + 1), (if j = 0 then α₀ else α₁) * f j) =
      α₀ * f 0 + α₁ * f 1 := by
    intro f
    rw [Finset.sum_range_succ, Finset.sum_range_one]
    simp
  simp only [key, lagConeGenerators_one, mem_insert, mem_singleton, forall_eq_or_imp,
    forall_eq] at h
  rw [h, ramanujanLagWeight_zero_left, ramanujanLagWeight_zero_left, ramanujanLagWeight_one_left,
    ramanujanLagWeight_one_left, moebius_apply_prime Nat.prime_two,
    show (6 : ℕ) = 2 * 3 from rfl, isMultiplicative_moebius.map_mul_of_coprime (by norm_num),
    moebius_apply_prime Nat.prime_two, moebius_apply_prime Nat.prime_three,
    Nat.totient_prime Nat.prime_two, show Nat.totient (2 * 3) = 2 from rfl]
  push_cast
  constructor
  · rintro ⟨h1, h2⟩
    exact ⟨by linarith, by linarith⟩
  · rintro ⟨h1, h2⟩
    exact ⟨by linarith, by linarith⟩

end

