import GaloisForLFunctions.BezoutValuationIncidence.TheActualVaughanLimitGramHasRankTwo

/-!
The actual half-damping infinite Gram has rank two. Specializing the shared
two-cell estimates gives explicit positive lower bounds for its prefix-pole
minor and pole energy.
-/

open Finset Filter RHTower
open GaloisForLFunctions.TransHorizonIncidenceMechanics
open GaloisForLFunctions.BiScaleUncertainty
open scoped BigOperators Topology
noncomputable section
namespace GaloisForLFunctions.BezoutValuationIncidence
set_option autoImplicit false

/-- Finite pronic pairings of the limiting rows converge to their actual infinite Gram. -/
theorem tendsto_sum_pmPronicVaughanHalfLimitGram_terms (i j : Fin 5) :
    Tendsto (fun T : ℕ => ∑ n ∈ Icc 1 T,
      pmPronicVaughanLimitFrame (1 / 2) i n *
        pmPronicVaughanLimitFrame (1 / 2) j n / (pronicSeq n : ℝ))
      atTop (𝓝 (pmPronicVaughanHalfLimitGram i j)) := by
  exact tendsto_sum_pmPronicVaughanLimitGram_terms le_rfl i j

/-- The limiting pronic Gram is symmetric. -/
theorem pmPronicVaughanHalfLimitGram_symm (i j : Fin 5) :
    pmPronicVaughanHalfLimitGram i j = pmPronicVaughanHalfLimitGram j i := by
  exact pmPronicVaughanLimitGram_symm (1 / 2) i j

/-- Every quadratic combination of the actual infinite limiting Gram is nonnegative. -/
theorem sum_sum_mul_pmPronicVaughanHalfLimitGram_nonneg (x : Fin 5 → ℝ) :
    0 ≤ ∑ i : Fin 5, ∑ j : Fin 5, x i * x j * pmPronicVaughanHalfLimitGram i j := by
  exact sum_sum_mul_pmPronicVaughanLimitGram_nonneg le_rfl x

/-- The two nonzero source directions supporting the limiting Gram. -/
abbrev pmPronicVaughanHalfPrefixDirection := pmPronicVaughanLimitPrefixDirection

/-- The pole direction supporting the limiting Gram. -/
abbrev pmPronicVaughanHalfPoleDirection := pmPronicVaughanLimitPoleDirection

/-- Every limiting row is generated by the actual prefix row and the centered pole row. -/
theorem pmPronicVaughanHalfLimitGram_eq_two_outer_products :
    pmPronicVaughanHalfLimitGram =
      Matrix.vecMulVec pmPronicVaughanHalfPrefixDirection (pmPronicVaughanHalfLimitGram 0) +
        Matrix.vecMulVec pmPronicVaughanHalfPoleDirection (pmPronicVaughanHalfLimitGram 4) := by
  exact pmPronicVaughanLimitGram_eq_two_outer_products (1 / 2)

/-- The endpoint limiting Gram has at most two independent directions. -/
theorem rank_pmPronicVaughanHalfLimitGram_le_two :
    Matrix.rank pmPronicVaughanHalfLimitGram ≤ 2 := by
  exact rank_pmPronicVaughanLimitGram_le_two (1 / 2)

/-- The first two arithmetic cells force a quantitative positive minor in the infinite endpoint Gram. -/
theorem pmPronicVaughanHalfLimitGram_prefix_pole_minor_lower :
    (1 : ℝ) / 62208 ≤
      pmPronicVaughanHalfLimitGram 0 0 * pmPronicVaughanHalfLimitGram 4 4 -
        pmPronicVaughanHalfLimitGram 0 4 ^ 2 := by
  have h := pmPronicVaughanLimitGram_prefix_pole_minor_lower (ε := (1 / 2 : ℝ)) le_rfl
  have hp : ((2 : ℝ) ^ (-(1 / 2 : ℝ))) ^ 4 = 1 / 4 := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
    norm_num
  rw [hp] at h
  norm_num only [div_div, mul_comm (4 : ℝ) 15552,
    show (15552 : ℝ) * 4 = 62208 by norm_num] at h
  exact h

/-- The positive first pole cell survives in the actual infinite endpoint limit. -/
theorem pmPronicVaughanHalfLimitGram_pole_lower :
    (1 : ℝ) / 64 ≤ pmPronicVaughanHalfLimitGram 4 4 := by
  have h := pmPronicVaughanLimitGram_pole_lower (ε := (1 / 2 : ℝ)) le_rfl
  have hp : ((2 : ℝ) ^ (-(1 / 2 : ℝ))) ^ 2 = 1 / 2 := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
    norm_num
  rw [hp] at h
  norm_num only [div_div, show (2 : ℝ) * 32 = 64 by norm_num] at h
  exact h

/-- The actual endpoint limit is a positive semidefinite matrix. -/
theorem pmPronicVaughanHalfLimitGram_posSemidef :
    Matrix.PosSemidef pmPronicVaughanHalfLimitGram := by
  exact pmPronicVaughanLimitGram_posSemidef le_rfl

/-- The actual endpoint prefix and pole have a positive-definite two-by-two Gram. -/
theorem pmPronicVaughanHalfLimitGram_prefix_pole_posDef :
    Matrix.PosDef (pmPronicVaughanHalfLimitGram.submatrix
      (![0, 4] : Fin 2 → Fin 5) (![0, 4] : Fin 2 → Fin 5)) := by
  exact pmPronicVaughanLimitGram_prefix_pole_posDef le_rfl

/-- The actual infinite endpoint Gram has rank exactly two. -/
theorem rank_pmPronicVaughanHalfLimitGram : Matrix.rank pmPronicVaughanHalfLimitGram = 2 := by
  exact rank_pmPronicVaughanLimitGram le_rfl

