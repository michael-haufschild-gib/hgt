import GaloisForLFunctions.CriticalArithmeticCorrelationTheory.CyclotomicNormGivesAConductorUniformCurvatureFloor
import Mathlib.RingTheory.Polynomial.Cyclotomic.Roots

/-!
# Cyclotomic energy of arbitrary polynomial observables

Primitive-root evaluation gives a positive quadratic form whose kernel is
exactly the cyclotomic ideal. For integer coefficients its nonzero values
have mean square at least one, by the norm of a cyclotomic integer.
-/

noncomputable section
open Finset Polynomial NumberField
namespace GaloisForLFunctions.CriticalArithmeticCorrelationTheory
open ArithmeticIntersectionTheory

/-- Squared evaluation norm on all primitive roots of a fixed conductor. -/
def primitivePolynomialEnergy (n : ℕ) (P : ℂ[X]) : ℝ :=
  ∑ ζ ∈ primitiveRoots n ℂ, Complex.normSq (P.eval ζ)

theorem primitivePolynomialEnergy_nonneg (n : ℕ) (P : ℂ[X]) :
    0 ≤ primitivePolynomialEnergy n P :=
  sum_nonneg fun _ _ => Complex.normSq_nonneg _

/-- The evaluation energy vanishes precisely when every primitive evaluation vanishes. -/
theorem primitivePolynomialEnergy_eq_zero_iff (n : ℕ) (P : ℂ[X]) :
    primitivePolynomialEnergy n P = 0 ↔ ∀ ζ ∈ primitiveRoots n ℂ, P.eval ζ = 0 := by
  rw [primitivePolynomialEnergy, sum_eq_zero_iff_of_nonneg (fun _ _ => Complex.normSq_nonneg _)]
  simp only [Complex.normSq_eq_zero]

/-- The nullspace is exactly the ideal generated by the cyclotomic polynomial. -/
theorem primitivePolynomialEnergy_zero_iff_cyclotomic_dvd (n : ℕ) (P : ℂ[X]) :
    primitivePolynomialEnergy (n + 1) P = 0 ↔ cyclotomic (n + 1) ℂ ∣ P := by
  rw [primitivePolynomialEnergy_eq_zero_iff]
  constructor
  · intro h
    rw [cyclotomic_eq_prod_X_sub_primitiveRoots (Complex.isPrimitiveRoot_exp (n + 1) (by omega))]
    apply Finset.prod_dvd_of_coprime
    · intro a _ b _ hab
      exact Polynomial.pairwise_coprime_X_sub_C Function.injective_id hab
    · intro ζ hζ
      exact Polynomial.dvd_iff_isRoot.mpr (h ζ hζ)
  · rintro ⟨Q, hQ⟩ ζ hζ
    rw [hQ, eval_mul, ((mem_primitiveRoots (by omega : 0 < n + 1)).mp hζ).isRoot_cyclotomic
      (by omega), zero_mul]

private theorem card_le_sum_of_norm_product {ι : Type*} [Fintype ι] (f : ι → ℂ)
    (hf : ∀ i, f i ≠ 0) (hp : 1 ≤ ∏ i, ‖f i‖) :
    (Fintype.card ι : ℝ) ≤ ∑ i, Complex.normSq (f i) := by
  have hp2 : 1 ≤ ∏ i, Complex.normSq (f i) := by
    simp_rw [← Complex.sq_norm]
    rw [prod_pow]
    nlinarith only [hp]
  have hpos i : 0 < Complex.normSq (f i) := Complex.normSq_pos.mpr (hf i)
  have hl : 0 ≤ ∑ i, Real.log (Complex.normSq (f i)) := by
    rw [← Real.log_prod (fun i _ => (hpos i).ne')]
    exact Real.log_nonneg hp2
  have hb := sum_le_sum (s := univ) (fun i _ => Real.log_le_sub_one_of_pos (hpos i))
  rw [sum_sub_distrib, sum_const, card_univ, nsmul_eq_mul, mul_one] at hb
  linarith only [hl, hb]

/-- Integer polynomial observables have either zero energy or a conductor-uniform mean-square gap. -/
theorem primitivePolynomialEnergy_integral_gap (n : ℕ) (P : ℤ[X]) :
    primitivePolynomialEnergy (n + 1) (P.map (Int.castRingHom ℂ)) = 0 ∨
      ((n + 1).totient : ℝ) ≤ primitivePolynomialEnergy (n + 1) (P.map (Int.castRingHom ℂ)) := by
  let m := n + 1
  have hm : 0 < m := by dsimp [m]; omega
  letI : NeZero m := ⟨hm.ne'⟩
  let K := CyclotomicField m ℚ
  letI : IsCyclotomicExtension {m} ℚ K := CyclotomicField.isCyclotomicExtension m ℚ
  let β : 𝓞 K := P.eval₂ (Int.castRingHom (𝓞 K)) (zetaN_spec m).toInteger
  have hemb (σ : K →+* ℂ) :
      σ (β : K) = (P.map (Int.castRingHom ℂ)).eval (σ (zetaN m)) := by
    change σ ((algebraMap (𝓞 K) K) β) = _
    simp only [β, Polynomial.hom_eval₂, Polynomial.eval_map]
    congr 1
    ext k
    simp
  let e : (K →+* ℂ) ≃ primitiveRoots m ℂ :=
    (RingHom.equivRatAlgHom (R := K) (S := ℂ)).trans
      ((zetaN_spec m).embeddingsEquivPrimitiveRoots ℂ (cyclotomic.irreducible_rat hm))
  have heval (σ : K →+* ℂ) :
      σ (β : K) = (P.map (Int.castRingHom ℂ)).eval (e σ : ℂ) := by
    rw [hemb]
    rfl
  have henergy : primitivePolynomialEnergy m (P.map (Int.castRingHom ℂ)) =
      ∑ σ : K →+* ℂ, Complex.normSq (σ (β : K)) := by
    rw [primitivePolynomialEnergy, ← sum_coe_sort]
    exact (Fintype.sum_equiv e _ _ (fun σ => congrArg Complex.normSq (heval σ))).symm
  change primitivePolynomialEnergy m _ = 0 ∨ (m.totient : ℝ) ≤ primitivePolynomialEnergy m _
  rw [henergy]
  by_cases hβ : β = 0
  · left
    simp only [hβ, map_zero, ZeroMemClass.coe_zero, Complex.normSq_zero, sum_const_zero]
  · right
    have hβK : (β : K) ≠ 0 := by exact_mod_cast hβ
    have hb := card_le_sum_of_norm_product (fun σ : K →+* ℂ => σ (β : K))
      (fun σ => map_ne_zero hβK) (HTGeometry.one_le_prod_norm_embeddings β hβ)
    have hcard : Fintype.card (K →+* ℂ) = m.totient := by
      rw [Fintype.card_congr e, Fintype.card_coe]
      exact (Complex.isPrimitiveRoot_exp m hm.ne').card_primitiveRoots
    simpa only [hcard] using hb

end GaloisForLFunctions.CriticalArithmeticCorrelationTheory

#print axioms GaloisForLFunctions.CriticalArithmeticCorrelationTheory.primitivePolynomialEnergy_zero_iff_cyclotomic_dvd
#print axioms GaloisForLFunctions.CriticalArithmeticCorrelationTheory.primitivePolynomialEnergy_integral_gap
