import Mathlib.RingTheory.Coprime.Lemmas
import Mathlib.RingTheory.Ideal.Span

/-!
# Membership in a principal ideal generated by a product of pairwise-coprime factors

The reverse inclusion of the Barnes multiple-gamma translation-annihilator theorem states that the
annihilator `Ann_DA(Psi_N) = (x_1 x_2 ... x_N)` is principal, generated by the product of the
pairwise-coprime ladder operators `x_j = T_j - 1`.  Its algebraic backbone is the following
elementary but not-quite-in-mathlib biconditional: for a finite family of pairwise-coprime
elements, the product divides `P` iff every factor divides `P`, hence `P` lies in the principal
ideal generated by the product iff each factor divides `P`.  This is exactly the "choose `j` with
`x_j` not dividing `P`" step of the reverse inclusion, isolated from the analytic input.
-/

namespace GaloisForLFunctions

open Finset

variable {R : Type*} [CommMonoidWithZero R] [DecompositionMonoid R]
variable {ι : Type*} {s : Finset ι} {f : ι → R} {P : R}

/-- For a finite family of pairwise-coprime elements, the product divides `P` iff every factor
divides `P`. -/
theorem prod_dvd_iff_forall_dvd_of_pairwise_isRelPrime
    (h : (s : Set ι).Pairwise (Function.onFun IsRelPrime f)) :
    (∏ i ∈ s, f i) ∣ P ↔ ∀ i ∈ s, f i ∣ P := by
  constructor
  · intro hdvd i hi
    exact (Finset.dvd_prod_of_mem f hi).trans hdvd
  · exact fun hall => prod_dvd_of_isRelPrime h hall

/-- Membership in the principal ideal generated by a product of pairwise-coprime factors is
equivalent to divisibility by every factor.  This is the reverse-inclusion criterion of the Barnes
annihilator theorem: `P ∈ (x_1 ⋯ x_N)` iff each ladder operator `x_j` divides `P`. -/
theorem mem_span_prod_iff_forall_dvd_of_pairwise_isRelPrime {R : Type*} [CommRing R]
    [DecompositionMonoid R] {ι : Type*} {s : Finset ι} {f : ι → R} {P : R}
    (h : (s : Set ι).Pairwise (Function.onFun IsRelPrime f)) :
    P ∈ Ideal.span {∏ i ∈ s, f i} ↔ ∀ i ∈ s, f i ∣ P := by
  rw [Ideal.mem_span_singleton]
  exact prod_dvd_iff_forall_dvd_of_pairwise_isRelPrime h

end GaloisForLFunctions
