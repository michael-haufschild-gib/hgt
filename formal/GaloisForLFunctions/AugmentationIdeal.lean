import Mathlib

/-!
# The evaluation kernel is the ideal of coordinate differences

For a point `a : σ → R`, the kernel of the evaluation homomorphism `eval a` on
`MvPolynomial σ R` is the ideal generated by the coordinate differences `X i - C (a i)`
(`ker_eval_eq_span_X_sub_C`).  Translating by the point sends `eval a` to the constant
coefficient, a polynomial with vanishing constant term lies in the ideal of the variables,
and translating back carries that ideal to the coordinate-difference ideal.

Specialized at the all-ones point this is the augmentation-ideal characterization: a
polynomial lies in `(X i - 1)` exactly when the sum of its coefficients — its value under
`eval 1` — is zero (`mem_augmentation_ideal_iff`).  Reading the exponents of a finite family
of commuting shift operators as such a polynomial, this says a finite integer combination of
translates lies in the shift-difference ideal exactly when its total exponent vanishes.
-/

open MvPolynomial

namespace GaloisForLFunctions

/-- A polynomial with vanishing constant coefficient lies in the ideal generated by the
variables. -/
theorem mem_span_X_of_constantCoeff_zero {σ R : Type*} [CommRing R]
    {Q : MvPolynomial σ R} (h : constantCoeff Q = 0) :
    Q ∈ Ideal.span (Set.range (X : σ → MvPolynomial σ R)) := by
  rw [← Set.image_univ, mem_ideal_span_X_image]
  intro m hm
  by_contra hcon
  push Not at hcon
  have hm0 : m = 0 := by ext i; exact hcon i (Set.mem_univ i)
  rw [MvPolynomial.mem_support_iff, hm0] at hm
  rw [MvPolynomial.constantCoeff_eq] at h
  exact hm h

/-- Applying the point translation to the evaluation homomorphism yields the constant
coefficient. -/
theorem constantCoeff_aeval_add_C {σ R : Type*} [CommRing R] (a : σ → R)
    (P : MvPolynomial σ R) :
    constantCoeff (aeval (fun i => X i + C (a i)) P) = eval a P := by
  rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_comp_left constantCoeff
    (algebraMap R (MvPolynomial σ R)) (fun i => X i + C (a i)) P]
  congr 1
  · ext r; simp
  · ext i; simp

/-- **The evaluation kernel is the coordinate-difference ideal.**  The kernel of `eval a` is
generated by the differences `X i - C (a i)`. -/
theorem ker_eval_eq_span_X_sub_C {σ R : Type*} [CommRing R] (a : σ → R) :
    RingHom.ker (eval a) = Ideal.span (Set.range fun i => X i - C (a i)) := by
  apply le_antisymm
  · intro P hP
    rw [RingHom.mem_ker] at hP
    have hQ : constantCoeff (aeval (fun i => X i + C (a i)) P) = 0 := by
      rw [constantCoeff_aeval_add_C]; exact hP
    have hmem := mem_span_X_of_constantCoeff_zero hQ
    have hback : (aeval (fun i => X i - C (a i)) :
        MvPolynomial σ R →ₐ[R] MvPolynomial σ R).toRingHom
        (aeval (fun i => X i + C (a i)) P) = P := by
      show aeval (fun i => X i - C (a i)) (aeval (fun i => X i + C (a i)) P) = P
      rw [← AlgHom.comp_apply, comp_aeval]; simp
    have himg := Ideal.mem_map_of_mem
      (aeval (fun i => X i - C (a i)) : MvPolynomial σ R →ₐ[R] MvPolynomial σ R).toRingHom
      hmem
    rw [hback, Ideal.map_span] at himg
    have hset : (⇑(aeval (fun i => X i - C (a i)) :
        MvPolynomial σ R →ₐ[R] MvPolynomial σ R).toRingHom) ''
        Set.range (X : σ → MvPolynomial σ R)
        = Set.range (fun i => X i - C (a i)) := by
      rw [← Set.range_comp]
      congr 1
      ext i
      simp
    rwa [hset] at himg
  · rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, eval_X, eval_C, sub_self]

/-- **Augmentation-ideal characterization.**  A polynomial lies in the ideal generated by the
`X i - 1` exactly when the sum of its coefficients — its evaluation at the all-ones point —
vanishes. -/
theorem mem_augmentation_ideal_iff {σ R : Type*} [CommRing R] (P : MvPolynomial σ R) :
    P ∈ Ideal.span (Set.range fun i => (X i : MvPolynomial σ R) - 1) ↔
      eval (fun _ => 1) P = 0 := by
  have h1 : (Set.range fun i => (X i : MvPolynomial σ R) - 1)
      = Set.range fun i => X i - C (1 : R) := by simp
  rw [h1, ← ker_eval_eq_span_X_sub_C (fun _ => (1 : R)), RingHom.mem_ker]

end GaloisForLFunctions
