import GaloisForLFunctions.ExclusionOfTheCriticalState.Pick.ProbePhaseGeometry
import Mathlib.Analysis.SpecialFunctions.ExpDeriv

/-!
# Real-time dynamics of the Weil sector phase action

The orbital circle representation differentiates to multiplication by `i`
on the negative reflection sector. Its Hilbert speed is constant and
measures exactly the mass in that sector.
-/

noncomputable section
namespace GaloisForLFunctions.ExclusionOfTheCriticalState.ProbeWalk

/-- The orbital circle action parametrized by real time. -/
def timePhase (t : ℝ) (x : ZeroSpace) : ZeroSpace := phaseRotate (Circle.exp t) x

/-- Real-time evolution is generated by multiplication by `i` on the negative sector. -/
theorem timePhase_hasDerivAt (t : ℝ) (x : ZeroSpace) :
    HasDerivAt (fun s : ℝ => timePhase s x)
      (Complex.I • negativePart (timePhase t x)) t := by
  have h := ((Complex.hasDerivAt_ofReal t).mul_const Complex.I).cexp
  have hg := (h.smul_const (negativePart x)).const_add (positivePart x)
  unfold timePhase
  rw [negativePart_phaseRotate, Circle.coe_exp, smul_smul]
  convert hg using 1 <;> try rfl
  congr 1
  ring

/-- The squared Hilbert speed is the conserved negative-sector mass. -/
theorem timePhase_speed (t : ℝ) (x : ZeroSpace) :
    ‖deriv (fun s : ℝ => timePhase s x) t‖ ^ 2 = negativeMass x := by
  rw [(timePhase_hasDerivAt t x).deriv, norm_smul, Complex.norm_I, one_mul,
    timePhase, negativePart_phaseRotate, norm_smul, Circle.norm_coe, one_mul]
  rfl

/-- Real-time translations form the same exact orbital representation. -/
theorem timePhase_add (t s : ℝ) (x : ZeroSpace) :
    timePhase (t + s) x = timePhase t (timePhase s x) := by
  rw [timePhase, Circle.exp_add, ← phaseRotate_mul]
  rfl

#print axioms timePhase_hasDerivAt
#print axioms timePhase_speed
#print axioms timePhase_add
end GaloisForLFunctions.ExclusionOfTheCriticalState.ProbeWalk
