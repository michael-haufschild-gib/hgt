/-! ### 1. Elementary arctan and discrete Poisson/Cauchy sum estimates -/

private theorem arctan_sub_mem_Icc_of_nonneg (x y : ℝ) (hx : 0 ≤ x) (hxy : x ≤ y) :
    (y - x) / (1 + y ^ 2) ≤ Real.arctan y - Real.arctan x ∧
      Real.arctan y - Real.arctan x ≤ (y - x) / (1 + x ^ 2) := by
  rcases eq_or_lt_of_le hxy with rfl | hlt
  · simp
  · obtain ⟨c, hc_mem, hc_eq⟩ :=
      exists_hasDerivAt_eq_slope Real.arctan (fun t => 1 / (1 + t ^ 2)) hlt
        Real.continuous_arctan.continuousOn (fun t _ => Real.hasDerivAt_arctan t)
    have hc_lo : x < c := hc_mem.1
    have hc_hi : c < y := hc_mem.2
    have hyx : 0 < y - x := sub_pos.mpr hlt
    have hdiff : Real.arctan y - Real.arctan x = (y - x) / (1 + c ^ 2) := by
      have hmul : 1 / (1 + c ^ 2) * (y - x) = Real.arctan y - Real.arctan x :=
        (eq_div_iff hyx.ne').mp hc_eq
      linarith [one_div_mul_eq_div (1 + c ^ 2) (y - x)]
    rw [hdiff]
    refine ⟨?_, ?_⟩
    · exact div_le_div_of_nonneg_left hyx.le (by positivity) (by nlinarith)
    · exact div_le_div_of_nonneg_left hyx.le (by positivity) (by nlinarith)

private theorem pi_div_two_sub_inv_le_arctan (x : ℝ) (hx : 0 < x) :
    Real.pi / 2 - 1 / x ≤ Real.arctan x := by
  have hinv_pos : 0 < x⁻¹ := inv_pos.mpr hx
  have hle : Real.arctan x⁻¹ ≤ x⁻¹ := by
    have h := (arctan_sub_mem_Icc_of_nonneg 0 x⁻¹ le_rfl hinv_pos.le).2
    simpa using h
  have hident := Real.arctan_inv_of_pos hx
  rw [one_div]
  linarith

private theorem sum_range_telescope (g : ℕ → ℝ) (n : ℕ) :
    ∑ i ∈ Finset.range n, (g (i + 1) - g i) = g n - g 0 := by
  induction n with
  | zero => simp
  | succ n ih => rw [Finset.sum_range_succ, ih]; ring

private theorem sum_Icc_int_split (n : ℕ) (g : ℤ → ℝ) :
    ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), g s =
      g 0 + (∑ k ∈ Finset.range n, g ((k + 1 : ℕ) : ℤ)) +
        ∑ k ∈ Finset.range n, g (-((k + 1 : ℕ) : ℤ)) := by
  induction n with
  | zero => simp
  | succ n ih =>
    have hset : Finset.Icc (-((n + 1 : ℕ) : ℤ)) ((n + 1 : ℕ) : ℤ) =
        insert (-((n + 1 : ℕ) : ℤ))
          (insert ((n + 1 : ℕ) : ℤ) (Finset.Icc (-(n : ℤ)) (n : ℤ))) := by
      ext s
      simp only [Finset.mem_Icc, Finset.mem_insert]
      omega
    have hnot1 : (-((n + 1 : ℕ) : ℤ)) ∉
        insert ((n + 1 : ℕ) : ℤ) (Finset.Icc (-(n : ℤ)) (n : ℤ)) := by
      simp only [Finset.mem_insert, Finset.mem_Icc]
      omega
    have hnot2 : ((n + 1 : ℕ) : ℤ) ∉ Finset.Icc (-(n : ℤ)) (n : ℤ) := by
      simp only [Finset.mem_Icc]
      omega
    rw [hset, Finset.sum_insert hnot1, Finset.sum_insert hnot2, ih,
        Finset.sum_range_succ, Finset.sum_range_succ]
    ring

private theorem sum_Icc_int_neg (n : ℕ) (g : ℤ → ℝ) :
    ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), g (-s) =
      ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), g s := by
  rw [sum_Icc_int_split n (fun s => g (-s)), sum_Icc_int_split n g]
  simp only [neg_zero, neg_neg]
  ring

/-- Upper bound for the discrete Poisson/Cauchy sum of the `s = 1` pole along `h ℤ`:
`h ∑_{|s| ≤ n} δ / (δ² + (s h)²) ≤ h / δ + π`. -/
private theorem cauchy_pole_int_sum_le (δ h : ℝ) (hδ : 0 < δ) (hh : 0 < h) (n : ℕ) :
    h * (∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), δ / (δ ^ 2 + ((s : ℝ) * h) ^ 2)) ≤
      h / δ + Real.pi := by
  let u : ℝ := h / δ
  let g : ℤ → ℝ := fun s => δ / (δ ^ 2 + ((s : ℝ) * h) ^ 2)
  have hu : 0 < u := div_pos hh hδ
  have hpos_sum : h * (∑ k ∈ Finset.range n, g ((k + 1 : ℕ) : ℤ)) ≤ Real.pi / 2 := by
    rw [Finset.mul_sum]
    have hterm : ∀ k : ℕ,
        h * g ((k + 1 : ℕ) : ℤ) ≤
          Real.arctan (u * ((k + 1 : ℕ) : ℝ)) - Real.arctan (u * (k : ℝ)) := by
      intro k
      have heq : h * g ((k + 1 : ℕ) : ℤ) =
          (u * ((k + 1 : ℕ) : ℝ) - u * (k : ℝ)) / (1 + (u * ((k + 1 : ℕ) : ℝ)) ^ 2) := by
        dsimp only [g, u]
        have hcast : (((k + 1 : ℕ) : ℤ) : ℝ) = (k : ℝ) + 1 := by push_cast; ring
        have hcast2 : ((k + 1 : ℕ) : ℝ) = (k : ℝ) + 1 := by push_cast; ring
        rw [hcast, hcast2]
        have hδ_ne : δ ≠ 0 := hδ.ne'
        field_simp
        ring
      rw [heq]
      refine (arctan_sub_mem_Icc_of_nonneg (u * (k : ℝ)) (u * ((k + 1 : ℕ) : ℝ))
        (by positivity) ?_).1
      have hk_le : (k : ℝ) ≤ ((k + 1 : ℕ) : ℝ) := by exact_mod_cast Nat.le_succ k
      exact mul_le_mul_of_nonneg_left hk_le hu.le
    calc ∑ k ∈ Finset.range n, h * g ((k + 1 : ℕ) : ℤ)
        ≤ ∑ k ∈ Finset.range n,
            (Real.arctan (u * ((k + 1 : ℕ) : ℝ)) - Real.arctan (u * (k : ℝ))) :=
          Finset.sum_le_sum fun k _ => hterm k
      _ = Real.arctan (u * (n : ℝ)) - Real.arctan (u * (0 : ℕ)) :=
          sum_range_telescope (fun k => Real.arctan (u * (k : ℝ))) n
      _ ≤ Real.pi / 2 := by
          simp only [Nat.cast_zero, mul_zero, Real.arctan_zero, sub_zero]
          exact (Real.arctan_lt_pi_div_two _).le
  have hg_neg : ∀ s : ℤ, g (-s) = g s := fun s => by
    dsimp only [g]
    rw [Int.cast_neg, neg_mul, neg_sq]
  have hzero : h * g 0 = h / δ := by
    dsimp only [g]
    simp only [Int.cast_zero, zero_mul, sq, add_zero]
    have hδ_ne : δ ≠ 0 := hδ.ne'
    field_simp
  change h * (∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), g s) ≤ h / δ + Real.pi
  rw [sum_Icc_int_split n g]
  simp_rw [hg_neg]
  rw [mul_add, mul_add, hzero]
  linarith [hpos_sum]

/-- Lower bound for a shifted discrete Poisson/Cauchy sum around `γ ∈ [q h, (q + 1) h]`:
`2 (arctan(L h / a) − h / a) ≤ h ∑_{|t| ≤ L} a / (a² + ((q + t) h − γ)²)`. -/
private theorem cauchy_shifted_int_sum_ge (a h γ : ℝ) (ha : 0 < a) (hh : 0 < h)
    (q L : ℕ) (hq_lo : (q : ℝ) * h ≤ γ) (hq_hi : γ ≤ (q : ℝ) * h + h) :
    2 * (Real.arctan (((L : ℝ) * h) / a) - h / a) ≤
      h * ∑ t ∈ Finset.Icc (-(L : ℤ)) (L : ℤ),
        a / (a ^ 2 + ((((q : ℤ) + t : ℤ) : ℝ) * h - γ) ^ 2) := by
  set ξ : ℝ := γ - (q : ℝ) * h
  have hξ0 : 0 ≤ ξ := sub_nonneg.mpr hq_lo
  have hξh : ξ ≤ h := by dsimp only [ξ]; linarith
  let g : ℤ → ℝ := fun t => a / (a ^ 2 + ((((q : ℤ) + t : ℤ) : ℝ) * h - γ) ^ 2)
  have hg_nn : ∀ t : ℤ, 0 ≤ g t := fun t => by dsimp only [g]; positivity
  let ePos : ℕ → ℤ := fun m => ((m + 1 : ℕ) : ℤ)
  let eNeg : ℕ → ℤ := fun m => -(m : ℤ)
  let SPos : Finset ℤ := (Finset.range L).image ePos
  let SNeg : Finset ℤ := (Finset.range L).image eNeg
  have hSPos_sub : SPos ⊆ Finset.Icc (-(L : ℤ)) (L : ℤ) := by
    intro t ht
    obtain ⟨m, hm, rfl⟩ := Finset.mem_image.mp ht
    rw [Finset.mem_range] at hm
    simp only [ePos, Finset.mem_Icc]
    omega
  have hSNeg_sub : SNeg ⊆ Finset.Icc (-(L : ℤ)) (L : ℤ) := by
    intro t ht
    obtain ⟨m, hm, rfl⟩ := Finset.mem_image.mp ht
    rw [Finset.mem_range] at hm
    simp only [eNeg, Finset.mem_Icc]
    omega
  have hdisj : Disjoint SPos SNeg := by
    rw [Finset.disjoint_left]
    intro t ht1 ht2
    obtain ⟨m₁, _, rfl⟩ := Finset.mem_image.mp ht1
    obtain ⟨m₂, _, heq⟩ := Finset.mem_image.mp ht2
    simp only [ePos, eNeg] at heq
    omega
  have hinj_pos : Set.InjOn ePos ↑(Finset.range L) := fun m₁ _ m₂ _ h => by
    simp only [ePos] at h; omega
  have hinj_neg : Set.InjOn eNeg ↑(Finset.range L) := fun m₁ _ m₂ _ h => by
    simp only [eNeg] at h; omega
  have hsplit_le : (∑ m ∈ Finset.range L, g (ePos m)) + (∑ m ∈ Finset.range L, g (eNeg m)) ≤
      ∑ t ∈ Finset.Icc (-(L : ℤ)) (L : ℤ), g t := by
    rw [← Finset.sum_image hinj_pos, ← Finset.sum_image hinj_neg, ← Finset.sum_union hdisj]
    exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.union_subset hSPos_sub hSNeg_sub)
      fun t _ _ => hg_nn t
  have hpos_term : ∀ m ∈ Finset.range L,
      a / (a ^ 2 + (((m + 1 : ℕ) : ℝ) * h) ^ 2) ≤ g (ePos m) := by
    intro m _
    dsimp only [g, ePos]
    have harg : (((q : ℤ) + ((m + 1 : ℕ) : ℤ) : ℤ) : ℝ) * h - γ =
        ((m + 1 : ℕ) : ℝ) * h - ξ := by
      dsimp only [ξ]; push_cast; ring
    rw [harg]
    have hm1 : (1 : ℝ) ≤ ((m + 1 : ℕ) : ℝ) := by exact_mod_cast Nat.succ_pos m
    have hlo : 0 ≤ ((m + 1 : ℕ) : ℝ) * h - ξ := by nlinarith
    have hhi : ((m + 1 : ℕ) : ℝ) * h - ξ ≤ ((m + 1 : ℕ) : ℝ) * h := by linarith
    exact div_le_div_of_nonneg_left ha.le (by positivity) (by nlinarith)
  have hneg_term : ∀ m ∈ Finset.range L,
      a / (a ^ 2 + (((m + 1 : ℕ) : ℝ) * h) ^ 2) ≤ g (eNeg m) := by
    intro m _
    dsimp only [g, eNeg]
    have harg : ((((q : ℤ) + -(m : ℤ) : ℤ) : ℝ) * h - γ) ^ 2 =
        ((m : ℝ) * h + ξ) ^ 2 := by
      dsimp only [ξ]; push_cast; ring
    rw [harg]
    have hm_nn : (0 : ℝ) ≤ (m : ℝ) := Nat.cast_nonneg m
    have hm1 : ((m + 1 : ℕ) : ℝ) = (m : ℝ) + 1 := by push_cast; ring
    have hlo : 0 ≤ (m : ℝ) * h + ξ := by positivity
    have hhi : (m : ℝ) * h + ξ ≤ ((m + 1 : ℕ) : ℝ) * h := by rw [hm1]; nlinarith
    exact div_le_div_of_nonneg_left ha.le (by positivity) (by nlinarith)
  set u : ℝ := h / a
  have hu : 0 < u := div_pos hh ha
  have half_tail : Real.arctan (((L : ℝ) * h) / a) - h / a ≤
      h * ∑ m ∈ Finset.range L, a / (a ^ 2 + (((m + 1 : ℕ) : ℝ) * h) ^ 2) := by
    have hstep : ∀ k : ℕ,
        Real.arctan (u * ((k + 1 : ℕ) : ℝ)) - Real.arctan (u * (k : ℝ)) ≤
          u / (1 + (u * (k : ℝ)) ^ 2) := by
      intro k
      have hk_le : (k : ℝ) ≤ ((k + 1 : ℕ) : ℝ) := by exact_mod_cast Nat.le_succ k
      have h := (arctan_sub_mem_Icc_of_nonneg (u * (k : ℝ)) (u * ((k + 1 : ℕ) : ℝ))
        (by positivity) (mul_le_mul_of_nonneg_left hk_le hu.le)).2
      have hnum : u * ((k + 1 : ℕ) : ℝ) - u * (k : ℝ) = u := by push_cast; ring
      rwa [hnum] at h
    have htel : Real.arctan (u * ((L + 1 : ℕ) : ℝ)) ≤
        ∑ k ∈ Finset.range (L + 1), u / (1 + (u * (k : ℝ)) ^ 2) := by
      calc Real.arctan (u * ((L + 1 : ℕ) : ℝ))
          = Real.arctan (u * ((L + 1 : ℕ) : ℝ)) - Real.arctan (u * (0 : ℕ)) := by simp
        _ = ∑ k ∈ Finset.range (L + 1),
              (Real.arctan (u * ((k + 1 : ℕ) : ℝ)) - Real.arctan (u * (k : ℝ))) :=
            (sum_range_telescope (fun k => Real.arctan (u * (k : ℝ))) (L + 1)).symm
        _ ≤ ∑ k ∈ Finset.range (L + 1), u / (1 + (u * (k : ℝ)) ^ 2) :=
            Finset.sum_le_sum fun k _ => hstep k
    have hsplit_all : ∀ M : ℕ, ∑ k ∈ Finset.range (M + 1), u / (1 + (u * (k : ℝ)) ^ 2) =
        u + ∑ m ∈ Finset.range M, h * (a / (a ^ 2 + (((m + 1 : ℕ) : ℝ) * h) ^ 2)) := by
      intro M
      induction M with
      | zero => simp
      | succ L' ih =>
        rw [Finset.sum_range_succ (fun k => u / (1 + (u * (k : ℝ)) ^ 2)) (L' + 1), ih,
            Finset.sum_range_succ]
        have hterm_eq : u / (1 + (u * ((L' + 1 : ℕ) : ℝ)) ^ 2) =
            h * (a / (a ^ 2 + (((L' + 1 : ℕ) : ℝ) * h) ^ 2)) := by
          dsimp only [u]
          have ha_ne : a ≠ 0 := ha.ne'
          field_simp
        rw [hterm_eq, add_assoc]
    have hsplit_range := hsplit_all L
    have hmono_atan : Real.arctan (((L : ℝ) * h) / a) ≤ Real.arctan (u * ((L + 1 : ℕ) : ℝ)) := by
      refine Real.arctan_mono ?_
      dsimp only [u]
      have hle : (L : ℝ) ≤ ((L + 1 : ℕ) : ℝ) := by exact_mod_cast Nat.le_succ L
      calc ((L : ℝ) * h) / a = (h / a) * (L : ℝ) := by ring
        _ ≤ (h / a) * ((L + 1 : ℕ) : ℝ) := mul_le_mul_of_nonneg_left hle hu.le
    rw [Finset.mul_sum]
    dsimp only [u] at hsplit_range
    linarith [htel, hsplit_range, hmono_atan]
  have h1 : ∑ m ∈ Finset.range L, a / (a ^ 2 + (((m + 1 : ℕ) : ℝ) * h) ^ 2) ≤
      ∑ m ∈ Finset.range L, g (ePos m) := Finset.sum_le_sum hpos_term
  have h2 : ∑ m ∈ Finset.range L, a / (a ^ 2 + (((m + 1 : ℕ) : ℝ) * h) ^ 2) ≤
      ∑ m ∈ Finset.range L, g (eNeg m) := Finset.sum_le_sum hneg_term
  have hcomb : 2 * (h * ∑ m ∈ Finset.range L, a / (a ^ 2 + (((m + 1 : ℕ) : ℝ) * h) ^ 2)) ≤
      h * ∑ t ∈ Finset.Icc (-(L : ℤ)) (L : ℤ), g t := by
    have hsum_le : 2 * ∑ m ∈ Finset.range L, a / (a ^ 2 + (((m + 1 : ℕ) : ℝ) * h) ^ 2) ≤
        ∑ t ∈ Finset.Icc (-(L : ℤ)) (L : ℤ), g t := by linarith [h1, h2, hsplit_le]
    nlinarith [hh]
  linarith [half_tail, hcomb]

/-! ### 2. Iterated positive-box convolution and opaque smoothed wavepacket -/

private theorem sum_comp_le_sum_of_injOn {α β : Type*} [DecidableEq β]
    {s : Finset α} {t : Finset β} (e : α → β) (g : β → ℝ)
    (he : ∀ a ∈ s, e a ∈ t) (hinj : Set.InjOn e ↑s)
    (hg : ∀ b ∈ t, 0 ≤ g b) :
    ∑ a ∈ s, g (e a) ≤ ∑ b ∈ t, g b := by
  rw [← Finset.sum_image hinj]
  exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.image_subset_iff.mpr he)
    fun b hb _ => hg b hb

private theorem sum_comp_eq_sum_of_injOn_eq_zero {α β : Type*} [DecidableEq β]
    {s : Finset α} {t : Finset β} (e : α → β) (g : β → ℝ)
    (he : ∀ a ∈ s, e a ∈ t) (hinj : Set.InjOn e ↑s)
    (hzero : ∀ b ∈ t, (∀ a ∈ s, e a ≠ b) → g b = 0) :
    ∑ a ∈ s, g (e a) = ∑ b ∈ t, g b := by
  rw [← Finset.sum_image hinj]
  exact Finset.sum_subset (Finset.image_subset_iff.mpr he) fun b hb hnot =>
    hzero b hb fun a ha heq => hnot (Finset.mem_image.mpr ⟨a, ha, heq⟩)

private theorem sum_fin_eq_sum_Ico (n : ℕ) (g : ℤ → ℝ) :
    ∑ j : Fin n, g (j : ℤ) = ∑ m ∈ Finset.Ico (0 : ℤ) (n : ℤ), g m := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Fin.sum_univ_castSucc]
    simp only [Fin.val_castSucc, Fin.val_last]
    rw [ih]
    have hset : Finset.Ico (0 : ℤ) ((n + 1 : ℕ) : ℤ) =
        insert (n : ℤ) (Finset.Ico (0 : ℤ) (n : ℤ)) := by
      ext m
      simp only [Finset.mem_Ico, Finset.mem_insert]
      omega
    have hnot : (n : ℤ) ∉ Finset.Ico (0 : ℤ) (n : ℤ) := by simp
    rw [hset, Finset.sum_insert hnot]
    simp [add_comm]

private theorem sum_Ico_zero_nat_const (N : ℕ) (c : ℝ) :
    ∑ _m ∈ Finset.Ico (0 : ℤ) (N : ℤ), c = (N : ℝ) * c := by
  rw [← sum_fin_eq_sum_Ico N (fun _ => c), Finset.sum_const, Finset.card_univ, Fintype.card_fin,
      nsmul_eq_mul]

/-- Support predicate `H(m) = 0` outside `[0, B)`. -/
private def SuppIn (B : ℕ) (H : ℤ → ℝ) : Prop :=
  ∀ m : ℤ, (m < 0 ∨ (B : ℤ) ≤ m) → H m = 0

private theorem suppIn_mono {B₁ B₂ : ℕ} {H : ℤ → ℝ} (hle : B₁ ≤ B₂) (hH : SuppIn B₁ H) :
    SuppIn B₂ H := by
  intro m hm
  apply hH m
  rcases hm with hlt | hge
  · exact Or.inl hlt
  · exact Or.inr (le_trans (by exact_mod_cast hle) hge)

/-- Discrete box-convolution operator `(boxConv A step H)(m) = ∑_{0 ≤ u < A} H(m − u · step)`. -/
private def boxConv (A : ℕ) (step : ℤ) (H : ℤ → ℝ) (m : ℤ) : ℝ :=
  ∑ u ∈ Finset.range A, H (m - (u : ℤ) * step)

private theorem boxConv_nonneg (A : ℕ) (step : ℤ) {H : ℤ → ℝ} (hH : ∀ m, 0 ≤ H m) :
    ∀ m, 0 ≤ boxConv A step H m :=
  fun m => Finset.sum_nonneg fun u _ => hH (m - (u : ℤ) * step)

private theorem boxConv_comm (A₁ : ℕ) (s₁ : ℤ) (A₂ : ℕ) (s₂ : ℤ) (H : ℤ → ℝ) :
    boxConv A₁ s₁ (boxConv A₂ s₂ H) = boxConv A₂ s₂ (boxConv A₁ s₁ H) := by
  funext m
  dsimp only [boxConv]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun u₂ _ => Finset.sum_congr rfl fun u₁ _ => ?_
  congr 1
  ring

private theorem boxConv_suppIn {B A s : ℕ} {H : ℤ → ℝ} (hH : SuppIn B H) :
    SuppIn (B + A * s) (boxConv A (s : ℤ) H) := by
  intro m hm
  dsimp only [boxConv]
  refine Finset.sum_eq_zero fun u hu => hH _ ?_
  rw [Finset.mem_range] at hu
  rcases hm with hlt | hge
  · left
    have hus : 0 ≤ (u : ℤ) * (s : ℤ) := by positivity
    omega
  · right
    have hus : (u : ℤ) * (s : ℤ) ≤ (A : ℤ) * (s : ℤ) :=
      mul_le_mul_of_nonneg_right (by omega) (by positivity)
    have hB : (B : ℤ) + (A : ℤ) * (s : ℤ) ≤ m := by exact_mod_cast hge
    omega

private theorem sum_Ico_shift_eq {B D s : ℕ} {H : ℤ → ℝ} (hH : SuppIn B H) (hs : s ≤ D)
    (φ : ℝ → ℝ) (hφ0 : φ 0 = 0) :
    ∑ m ∈ Finset.Ico (0 : ℤ) ((B + D : ℕ) : ℤ), φ (H (m - (s : ℤ))) =
      ∑ m ∈ Finset.Ico (0 : ℤ) (B : ℤ), φ (H m) := by
  symm
  have hcongr : ∑ m ∈ Finset.Ico (0 : ℤ) (B : ℤ), φ (H m) =
      ∑ m ∈ Finset.Ico (0 : ℤ) (B : ℤ), φ (H ((m + (s : ℤ)) - (s : ℤ))) :=
    Finset.sum_congr rfl fun m _ => by rw [add_sub_cancel_right]
  rw [hcongr]
  refine sum_comp_eq_sum_of_injOn_eq_zero (fun m : ℤ => m + (s : ℤ))
    (fun b : ℤ => φ (H (b - (s : ℤ)))) ?_ ?_ ?_
  · intro m hm
    rw [Finset.mem_Ico] at hm ⊢
    omega
  · intro m₁ _ m₂ _ h
    dsimp only at h
    omega
  · intro b hb hnot
    rw [Finset.mem_Ico] at hb
    have hout : b - (s : ℤ) < 0 ∨ (B : ℤ) ≤ b - (s : ℤ) := by
      by_contra hmem
      push Not at hmem
      exact hnot (b - (s : ℤ)) (Finset.mem_Ico.mpr hmem) (by omega)
    rw [hH _ hout, hφ0]

private theorem boxConv_sum_eq {B A s : ℕ} {H : ℤ → ℝ} (hH : SuppIn B H) :
    ∑ m ∈ Finset.Ico (0 : ℤ) ((B + A * s : ℕ) : ℤ), boxConv A (s : ℤ) H m =
      (A : ℝ) * ∑ m ∈ Finset.Ico (0 : ℤ) (B : ℤ), H m := by
  dsimp only [boxConv]
  rw [Finset.sum_comm]
  have hinner : ∀ u ∈ Finset.range A,
      ∑ m ∈ Finset.Ico (0 : ℤ) ((B + A * s : ℕ) : ℤ), H (m - (u : ℤ) * (s : ℤ)) =
        ∑ m ∈ Finset.Ico (0 : ℤ) (B : ℤ), H m := by
    intro u hu
    rw [Finset.mem_range] at hu
    have hus : u * s ≤ A * s := Nat.mul_le_mul_right s hu.le
    have hcast : ∀ m : ℤ, m - (u : ℤ) * (s : ℤ) = m - ((u * s : ℕ) : ℤ) := fun m => by
      push_cast; rfl
    simp_rw [hcast]
    exact sum_Ico_shift_eq hH hus id rfl
  rw [Finset.sum_congr rfl hinner, Finset.sum_const, Finset.card_range, nsmul_eq_mul]

/-- Pointwise telescoping identity `(boxConv A step H)(m − step) − (boxConv A step H)(m) =
H(m − A · step) − H(m)`. -/
private theorem boxConv_shift_sub (A : ℕ) (step : ℤ) (H : ℤ → ℝ) (m : ℤ) :
    boxConv A step H (m - step) - boxConv A step H m = H (m - (A : ℤ) * step) - H m := by
  dsimp only [boxConv]
  rw [← Finset.sum_sub_distrib]
  have hcongr : ∑ u ∈ Finset.range A, (H (m - step - (u : ℤ) * step) - H (m - (u : ℤ) * step)) =
      ∑ u ∈ Finset.range A,
        (H (m - ((u + 1 : ℕ) : ℤ) * step) - H (m - (u : ℤ) * step)) := by
    refine Finset.sum_congr rfl fun u _ => ?_
    congr 2
    push_cast
    ring
  rw [hcongr, sum_range_telescope (fun u => H (m - (u : ℤ) * step)) A]
  simp

/-- Superadditivity of `ℓ²` mass under nonnegative `boxConv`:
`A ∑ H² ≤ ∑ (boxConv A s H)²`. -/
private theorem mul_sum_sq_le_boxConv_sq {B A s : ℕ} {H : ℤ → ℝ}
    (hH_nn : ∀ m, 0 ≤ H m) :
    (A : ℝ) * ∑ m ∈ Finset.Ico (0 : ℤ) (B : ℤ), (H m) ^ 2 ≤
      ∑ m ∈ Finset.Ico (0 : ℤ) ((B + A * s : ℕ) : ℤ), (boxConv A (s : ℤ) H m) ^ 2 := by
  have hpt : ∀ m : ℤ,
      ∑ u ∈ Finset.range A, (H (m - (u : ℤ) * (s : ℤ))) ^ 2 ≤ (boxConv A (s : ℤ) H m) ^ 2 := by
    intro m
    have hle : ∀ u ∈ Finset.range A,
        (H (m - (u : ℤ) * (s : ℤ))) ^ 2 ≤
          H (m - (u : ℤ) * (s : ℤ)) * boxConv A (s : ℤ) H m := by
      intro u hu
      rw [sq]
      refine mul_le_mul_of_nonneg_left ?_ (hH_nn _)
      dsimp only [boxConv]
      exact Finset.single_le_sum (f := fun v : ℕ => H (m - (v : ℤ) * (s : ℤ)))
        (fun v _ => hH_nn _) hu
    calc ∑ u ∈ Finset.range A, (H (m - (u : ℤ) * (s : ℤ))) ^ 2
        ≤ ∑ u ∈ Finset.range A, H (m - (u : ℤ) * (s : ℤ)) * boxConv A (s : ℤ) H m :=
          Finset.sum_le_sum hle
      _ = (boxConv A (s : ℤ) H m) ^ 2 := by
          rw [← Finset.sum_mul, sq]; rfl
  have hswap : (A : ℝ) * ∑ m ∈ Finset.Ico (0 : ℤ) (B : ℤ), (H m) ^ 2 ≤
      ∑ m ∈ Finset.Ico (0 : ℤ) ((B + A * s : ℕ) : ℤ),
        ∑ u ∈ Finset.range A, (H (m - (u : ℤ) * (s : ℤ))) ^ 2 := by
    rw [Finset.sum_comm]
    have hu_le : ∀ u ∈ Finset.range A,
        ∑ m' ∈ Finset.Ico (0 : ℤ) (B : ℤ), (H m') ^ 2 ≤
          ∑ m ∈ Finset.Ico (0 : ℤ) ((B + A * s : ℕ) : ℤ),
            (H (m - (u : ℤ) * (s : ℤ))) ^ 2 := by
      intro u hu
      rw [Finset.mem_range] at hu
      have hcongr : ∑ m' ∈ Finset.Ico (0 : ℤ) (B : ℤ), (H m') ^ 2 =
          ∑ m' ∈ Finset.Ico (0 : ℤ) (B : ℤ),
            (H ((m' + (u : ℤ) * (s : ℤ)) - (u : ℤ) * (s : ℤ))) ^ 2 :=
        Finset.sum_congr rfl fun m' _ => by rw [add_sub_cancel_right]
      rw [hcongr]
      refine sum_comp_le_sum_of_injOn (fun m' : ℤ => m' + (u : ℤ) * (s : ℤ))
        (fun b : ℤ => (H (b - (u : ℤ) * (s : ℤ))) ^ 2) ?_ ?_ (fun _ _ => sq_nonneg _)
      · intro m' hm'
        rw [Finset.mem_Ico] at hm' ⊢
        have hus0 : 0 ≤ (u : ℤ) * (s : ℤ) := mul_nonneg (Nat.cast_nonneg u) (Nat.cast_nonneg s)
        refine ⟨by omega, ?_⟩
        rcases eq_or_ne s 0 with rfl | hs0
        · simp; omega
        · have hus : (u : ℤ) * (s : ℤ) ≤ (A : ℤ) * (s : ℤ) :=
            mul_le_mul_of_nonneg_right (by omega) (by positivity)
          have htarget : (B : ℤ) + (A : ℤ) * (s : ℤ) = ((B + A * s : ℕ) : ℤ) := by push_cast; rfl
          omega
      · intro m₁ _ m₂ _ h
        dsimp only at h
        omega
    calc (A : ℝ) * ∑ m ∈ Finset.Ico (0 : ℤ) (B : ℤ), (H m) ^ 2
        = ∑ _u ∈ Finset.range A, ∑ m ∈ Finset.Ico (0 : ℤ) (B : ℤ), (H m) ^ 2 := by
          rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
      _ ≤ ∑ u ∈ Finset.range A,
            ∑ m ∈ Finset.Ico (0 : ℤ) ((B + A * s : ℕ) : ℤ),
              (H (m - (u : ℤ) * (s : ℤ))) ^ 2 :=
          Finset.sum_le_sum hu_le
  exact hswap.trans (Finset.sum_le_sum fun m _ => hpt m)

/-- Fundamental `ℓ²` shift-stability bound for `F = boxConv A s H`:
`A ∑_m (F(m − s) − F(m))² ≤ 2 ∑_m F(m)²`. -/
private theorem boxConv_shift_sq_le {B n A s : ℕ} {H : ℤ → ℝ}
    (hH_nn : ∀ m, 0 ≤ H m) (hH_supp : SuppIn B H) (hn : B + A * s ≤ n) :
    (A : ℝ) * ∑ m ∈ Finset.Ico (0 : ℤ) ((n + s : ℕ) : ℤ),
        (boxConv A (s : ℤ) H (m - (s : ℤ)) - boxConv A (s : ℤ) H m) ^ 2 ≤
      2 * ∑ m ∈ Finset.Ico (0 : ℤ) (n : ℤ), (boxConv A (s : ℤ) H m) ^ 2 := by
  have hdiff_le : ∑ m ∈ Finset.Ico (0 : ℤ) ((n + s : ℕ) : ℤ),
        (boxConv A (s : ℤ) H (m - (s : ℤ)) - boxConv A (s : ℤ) H m) ^ 2 ≤
      2 * ∑ m ∈ Finset.Ico (0 : ℤ) (B : ℤ), (H m) ^ 2 := by
    have hpt : ∀ m : ℤ,
        (boxConv A (s : ℤ) H (m - (s : ℤ)) - boxConv A (s : ℤ) H m) ^ 2 ≤
          (H (m - ((A * s : ℕ) : ℤ))) ^ 2 + (H m) ^ 2 := by
      intro m
      rw [boxConv_shift_sub]
      have hcast : (A : ℤ) * (s : ℤ) = ((A * s : ℕ) : ℤ) := by push_cast; rfl
      rw [hcast]
      nlinarith [mul_nonneg (hH_nn (m - ((A * s : ℕ) : ℤ))) (hH_nn m)]
    have hext_eq : ((n + s : ℕ) : ℤ) = ((B + (n + s - B) : ℕ) : ℤ) := by omega
    have hs1 : ∑ m ∈ Finset.Ico (0 : ℤ) ((n + s : ℕ) : ℤ), (H (m - ((A * s : ℕ) : ℤ))) ^ 2 =
        ∑ m ∈ Finset.Ico (0 : ℤ) (B : ℤ), (H m) ^ 2 := by
      rw [hext_eq]
      exact sum_Ico_shift_eq hH_supp (by omega) (fun x => x ^ 2) (by norm_num)
    have hs2 : ∑ m ∈ Finset.Ico (0 : ℤ) ((n + s : ℕ) : ℤ), (H m) ^ 2 =
        ∑ m ∈ Finset.Ico (0 : ℤ) (B : ℤ), (H m) ^ 2 := by
      rw [hext_eq]
      simpa using sum_Ico_shift_eq (s := 0) hH_supp (Nat.zero_le _) (fun x => x ^ 2) (by norm_num)
    calc ∑ m ∈ Finset.Ico (0 : ℤ) ((n + s : ℕ) : ℤ),
            (boxConv A (s : ℤ) H (m - (s : ℤ)) - boxConv A (s : ℤ) H m) ^ 2
        ≤ ∑ m ∈ Finset.Ico (0 : ℤ) ((n + s : ℕ) : ℤ),
            ((H (m - ((A * s : ℕ) : ℤ))) ^ 2 + (H m) ^ 2) :=
          Finset.sum_le_sum fun m _ => hpt m
      _ = 2 * ∑ m ∈ Finset.Ico (0 : ℤ) (B : ℤ), (H m) ^ 2 := by
          rw [Finset.sum_add_distrib, hs1, hs2]; ring
  have hsub_n : Finset.Ico (0 : ℤ) ((B + A * s : ℕ) : ℤ) ⊆ Finset.Ico (0 : ℤ) (n : ℤ) := by
    intro m hm
    rw [Finset.mem_Ico] at hm ⊢
    omega
  have hnorm_ge : (A : ℝ) * ∑ m ∈ Finset.Ico (0 : ℤ) (B : ℤ), (H m) ^ 2 ≤
      ∑ m ∈ Finset.Ico (0 : ℤ) (n : ℤ), (boxConv A (s : ℤ) H m) ^ 2 :=
    (mul_sum_sq_le_boxConv_sq hH_nn).trans
      (Finset.sum_le_sum_of_subset_of_nonneg hsub_n fun _ _ _ => sq_nonneg _)
  have hA_nn : (0 : ℝ) ≤ A := Nat.cast_nonneg A
  calc (A : ℝ) * ∑ m ∈ Finset.Ico (0 : ℤ) ((n + s : ℕ) : ℤ),
          (boxConv A (s : ℤ) H (m - (s : ℤ)) - boxConv A (s : ℤ) H m) ^ 2
      ≤ (A : ℝ) * (2 * ∑ m ∈ Finset.Ico (0 : ℤ) (B : ℤ), (H m) ^ 2) :=
        mul_le_mul_of_nonneg_left hdiff_le hA_nn
    _ = 2 * ((A : ℝ) * ∑ m ∈ Finset.Ico (0 : ℤ) (B : ℤ), (H m) ^ 2) := by ring
    _ ≤ 2 * ∑ m ∈ Finset.Ico (0 : ℤ) (n : ℤ), (boxConv A (s : ℤ) H m) ^ 2 :=
        mul_le_mul_of_nonneg_left hnorm_ge (by norm_num)

/-- Window Lipschitz `ℓ²` bound for `F = boxConv (E * L) 1 G` across any small step `1 ≤ u ≤ L`:
`(E : ℝ) ∑_m (F(m − u) − F(m))² ≤ 2 ∑_m F(m)²`. -/
private theorem boxConv_window_shift_sq_le {B_G n E L u : ℕ} {G : ℤ → ℝ}
    (hG_nn : ∀ m, 0 ≤ G m) (hG_supp : SuppIn B_G G)
    (hu1 : 1 ≤ u) (huL : u ≤ L) (hn : B_G + E * L ≤ n) :
    (E : ℝ) * ∑ m ∈ Finset.Ico (0 : ℤ) ((n + u : ℕ) : ℤ),
        (boxConv (E * L) 1 G (m - (u : ℤ)) - boxConv (E * L) 1 G m) ^ 2 ≤
      2 * ∑ m ∈ Finset.Ico (0 : ℤ) (n : ℤ), (boxConv (E * L) 1 G m) ^ 2 := by
  set N : ℕ := E * L
  let H_u : ℤ → ℝ := boxConv u 1 G
  have hHu_nn : ∀ m, 0 ≤ H_u m := boxConv_nonneg u 1 hG_nn
  have hHu_supp : SuppIn (B_G + u) H_u := by
    dsimp only [H_u]
    simpa only [mul_one, Nat.cast_one] using boxConv_suppIn (s := 1) hG_supp
  have hF_supp : SuppIn n (boxConv N 1 G) := by
    refine suppIn_mono hn ?_
    simpa only [mul_one, Nat.cast_one] using boxConv_suppIn (A := N) (s := 1) hG_supp
  have hdiff_eq : ∀ m : ℤ,
      boxConv N 1 G (m - (u : ℤ)) - boxConv N 1 G m = H_u (m - (N : ℤ)) - H_u m := by
    intro m
    calc boxConv N 1 G (m - (u : ℤ)) - boxConv N 1 G m
        = ∑ v ∈ Finset.range u,
            (boxConv N 1 G (m - ((v + 1 : ℕ) : ℤ)) - boxConv N 1 G (m - (v : ℤ))) := by
          rw [sum_range_telescope (fun v => boxConv N 1 G (m - (v : ℤ))) u]
          simp
      _ = ∑ v ∈ Finset.range u, (G ((m - (N : ℤ)) - (v : ℤ) * 1) - G (m - (v : ℤ) * 1)) := by
          refine Finset.sum_congr rfl fun v _ => ?_
          have hstep := boxConv_shift_sub N 1 G (m - (v : ℤ))
          have e1 : m - (v : ℤ) - 1 = m - ((v + 1 : ℕ) : ℤ) := by push_cast; ring
          have e2 : m - (v : ℤ) - (N : ℤ) * 1 = (m - (N : ℤ)) - (v : ℤ) * 1 := by ring
          rw [e1, e2] at hstep
          rw [hstep]
          simp only [mul_one]
      _ = H_u (m - (N : ℤ)) - H_u m := Finset.sum_sub_distrib _ _
  have hdiff_le : ∑ m ∈ Finset.Ico (0 : ℤ) ((n + u : ℕ) : ℤ),
        (boxConv N 1 G (m - (u : ℤ)) - boxConv N 1 G m) ^ 2 ≤
      2 * ∑ m ∈ Finset.Ico (0 : ℤ) ((B_G + u : ℕ) : ℤ), (H_u m) ^ 2 := by
    have hpt : ∀ m : ℤ,
        (boxConv N 1 G (m - (u : ℤ)) - boxConv N 1 G m) ^ 2 ≤
          (H_u (m - (N : ℤ))) ^ 2 + (H_u m) ^ 2 := by
      intro m
      rw [hdiff_eq m]
      nlinarith [mul_nonneg (hHu_nn (m - (N : ℤ))) (hHu_nn m)]
    have hext_eq : ((n + u : ℕ) : ℤ) = (((B_G + u) + (n - B_G) : ℕ) : ℤ) := by omega
    have hs1 : ∑ m ∈ Finset.Ico (0 : ℤ) ((n + u : ℕ) : ℤ), (H_u (m - (N : ℤ))) ^ 2 =
        ∑ m ∈ Finset.Ico (0 : ℤ) ((B_G + u : ℕ) : ℤ), (H_u m) ^ 2 := by
      rw [hext_eq]
      exact sum_Ico_shift_eq hHu_supp (by omega) (fun x => x ^ 2) (by norm_num)
    have hs2 : ∑ m ∈ Finset.Ico (0 : ℤ) ((n + u : ℕ) : ℤ), (H_u m) ^ 2 =
        ∑ m ∈ Finset.Ico (0 : ℤ) ((B_G + u : ℕ) : ℤ), (H_u m) ^ 2 := by
      rw [hext_eq]
      simpa using sum_Ico_shift_eq (s := 0) hHu_supp (Nat.zero_le _) (fun x => x ^ 2) (by norm_num)
    calc ∑ m ∈ Finset.Ico (0 : ℤ) ((n + u : ℕ) : ℤ),
            (boxConv N 1 G (m - (u : ℤ)) - boxConv N 1 G m) ^ 2
        ≤ ∑ m ∈ Finset.Ico (0 : ℤ) ((n + u : ℕ) : ℤ),
            ((H_u (m - (N : ℤ))) ^ 2 + (H_u m) ^ 2) :=
          Finset.sum_le_sum fun m _ => hpt m
      _ = 2 * ∑ m ∈ Finset.Ico (0 : ℤ) ((B_G + u : ℕ) : ℤ), (H_u m) ^ 2 := by
          rw [Finset.sum_add_distrib, hs1, hs2]; ring
  set p : ℕ := N / u
  have hp_mul_le : p * u ≤ N := Nat.div_mul_le_self N u
  have hE_le_p : E ≤ p := by
    by_contra hlt
    rw [not_le] at hlt
    have hdiv := Nat.div_add_mod N u
    have hmod : N % u < u := Nat.mod_lt N hu1
    have hp1 : p + 1 ≤ E := hlt
    have h1 : (p + 1) * u ≤ E * L :=
      le_trans (Nat.mul_le_mul_right u hp1) (Nat.mul_le_mul_left E huL)
    dsimp only [p, N] at hdiv hmod h1
    nlinarith
  have htile_pt : ∀ m : ℤ, boxConv p (u : ℤ) H_u m ≤ boxConv N 1 G m := by
    intro m
    dsimp only [boxConv, H_u]
    have hprod : ∑ a ∈ Finset.range p, ∑ b ∈ Finset.range u,
          G (m - (a : ℤ) * (u : ℤ) - (b : ℤ) * 1) =
        ∑ x ∈ (Finset.univ : Finset (Fin p × Fin u)),
          G (m - ((x.1.1 * u + x.2.1 : ℕ) : ℤ) * 1) := by
      simp_rw [← Fin.sum_univ_eq_sum_range]
      rw [← Fintype.sum_prod_type']
      refine Finset.sum_congr rfl fun x _ => ?_
      congr 1
      push_cast
      ring
    rw [hprod]
    refine sum_comp_le_sum_of_injOn (fun x : Fin p × Fin u => x.1.1 * u + x.2.1)
      (fun w : ℕ => G (m - (w : ℤ) * 1)) ?_ ?_ (fun w _ => hG_nn _)
    · intro x _
      rw [Finset.mem_range]
      have ha1 : x.1.1 + 1 ≤ p := x.1.2
      have hb : x.2.1 < u := x.2.2
      nlinarith
    · intro x₁ _ x₂ _ heq
      dsimp only at heq
      have h1_eq : x₁.1.1 = x₂.1.1 := by
        by_contra hne
        rcases lt_or_gt_of_ne hne with hlt | hgt
        · have : x₁.1.1 + 1 ≤ x₂.1.1 := hlt
          have hb1 : x₁.2.1 < u := x₁.2.2
          nlinarith
        · have : x₂.1.1 + 1 ≤ x₁.1.1 := hgt
          have hb2 : x₂.2.1 < u := x₂.2.2
          nlinarith
      have h2_eq : x₁.2.1 = x₂.2.1 := by rw [h1_eq] at heq; omega
      exact Prod.ext (Fin.ext h1_eq) (Fin.ext h2_eq)
  set D_tile : ℕ := (B_G + u) + p * u
  have hnorm_ge : (E : ℝ) * ∑ m ∈ Finset.Ico (0 : ℤ) ((B_G + u : ℕ) : ℤ), (H_u m) ^ 2 ≤
      ∑ m ∈ Finset.Ico (0 : ℤ) (n : ℤ), (boxConv N 1 G m) ^ 2 := by
    have hE_p_real : (E : ℝ) ≤ (p : ℝ) := by exact_mod_cast hE_le_p
    have hsq_nn : 0 ≤ ∑ m ∈ Finset.Ico (0 : ℤ) ((B_G + u : ℕ) : ℤ), (H_u m) ^ 2 :=
      Finset.sum_nonneg fun _ _ => sq_nonneg _
    have hsub_ext : Finset.Ico (0 : ℤ) (D_tile : ℤ) ⊆
        Finset.Ico (0 : ℤ) ((n + D_tile : ℕ) : ℤ) := by
      intro m hm; rw [Finset.mem_Ico] at hm ⊢; omega
    have htrunc : ∑ m ∈ Finset.Ico (0 : ℤ) ((n + D_tile : ℕ) : ℤ), (boxConv N 1 G m) ^ 2 =
        ∑ m ∈ Finset.Ico (0 : ℤ) (n : ℤ), (boxConv N 1 G m) ^ 2 := by
      simpa using sum_Ico_shift_eq (s := 0) hF_supp (Nat.zero_le _) (fun x => x ^ 2) (by norm_num)
    calc (E : ℝ) * ∑ m ∈ Finset.Ico (0 : ℤ) ((B_G + u : ℕ) : ℤ), (H_u m) ^ 2
        ≤ (p : ℝ) * ∑ m ∈ Finset.Ico (0 : ℤ) ((B_G + u : ℕ) : ℤ), (H_u m) ^ 2 :=
          mul_le_mul_of_nonneg_right hE_p_real hsq_nn
      _ ≤ ∑ m ∈ Finset.Ico (0 : ℤ) (D_tile : ℤ), (boxConv p (u : ℤ) H_u m) ^ 2 :=
          mul_sum_sq_le_boxConv_sq hHu_nn
      _ ≤ ∑ m ∈ Finset.Ico (0 : ℤ) (D_tile : ℤ), (boxConv N 1 G m) ^ 2 := by
          refine Finset.sum_le_sum fun m _ => ?_
          have h0 : 0 ≤ boxConv p (u : ℤ) H_u m := boxConv_nonneg p (u : ℤ) hHu_nn m
          have hle := htile_pt m
          nlinarith
      _ ≤ ∑ m ∈ Finset.Ico (0 : ℤ) ((n + D_tile : ℕ) : ℤ), (boxConv N 1 G m) ^ 2 :=
          Finset.sum_le_sum_of_subset_of_nonneg hsub_ext fun _ _ _ => sq_nonneg _
      _ = ∑ m ∈ Finset.Ico (0 : ℤ) (n : ℤ), (boxConv N 1 G m) ^ 2 := htrunc
  have hE_nn : (0 : ℝ) ≤ E := Nat.cast_nonneg E
  calc (E : ℝ) * ∑ m ∈ Finset.Ico (0 : ℤ) ((n + u : ℕ) : ℤ),
          (boxConv N 1 G (m - (u : ℤ)) - boxConv N 1 G m) ^ 2
      ≤ (E : ℝ) * (2 * ∑ m ∈ Finset.Ico (0 : ℤ) ((B_G + u : ℕ) : ℤ), (H_u m) ^ 2) :=
        mul_le_mul_of_nonneg_left hdiff_le hE_nn
    _ = 2 * ((E : ℝ) * ∑ m ∈ Finset.Ico (0 : ℤ) ((B_G + u : ℕ) : ℤ), (H_u m) ^ 2) := by ring
    _ ≤ 2 * ∑ m ∈ Finset.Ico (0 : ℤ) (n : ℤ), (boxConv N 1 G m) ^ 2 :=
        mul_le_mul_of_nonneg_left hnorm_ge (by norm_num)

private def delta0 (m : ℤ) : ℝ := if m = 0 then 1 else 0

private theorem delta0_nonneg : ∀ m : ℤ, 0 ≤ delta0 m := fun m => by
  dsimp only [delta0]; split_ifs <;> norm_num

private theorem delta0_suppIn : SuppIn 1 delta0 := by
  intro m hm
  dsimp only [delta0]
  rw [if_neg]
  omega

private theorem boxConv_one_delta0_eq_one {N : ℕ} {m : ℤ} (hm0 : 0 ≤ m) (hmN : m < (N : ℤ)) :
    boxConv N 1 delta0 m = 1 := by
  dsimp only [boxConv]
  rw [Finset.sum_eq_single m.toNat]
  · simp only [delta0, mul_one]
    rw [if_pos (by omega)]
  · intro u hu hne
    rw [Finset.mem_range] at hu
    simp only [delta0, mul_one]
    rw [if_neg (by omega)]
  · intro hnot
    exfalso
    exact hnot (Finset.mem_range.mpr (by omega))

private theorem boxConv_one_delta0_sum (N : ℕ) :
    ∑ m ∈ Finset.Ico (0 : ℤ) ((1 + N : ℕ) : ℤ), boxConv N 1 delta0 m = (N : ℝ) := by
  have hd : ∑ m ∈ Finset.Ico (0 : ℤ) (1 : ℤ), delta0 m = 1 := by
    have hset : Finset.Ico (0 : ℤ) (1 : ℤ) = {0} := by
      ext m; simp only [Finset.mem_Ico, Finset.mem_singleton]; omega
    rw [hset, Finset.sum_singleton]
    simp [delta0]
  have hb := boxConv_sum_eq (A := N) (s := 1) delta0_suppIn
  simpa only [mul_one, Nat.cast_one, hd] using hb

/-- Iterated box convolution across `k` step sizes `qNat 0, …, qNat (k − 1)`. -/
private def iterBoxConv : ℕ → (ℕ → ℕ) → ℕ → (ℤ → ℝ) → (ℤ → ℝ)
  | 0, _, _, H => H
  | k + 1, qNat, K, H => boxConv K (qNat k : ℤ) (iterBoxConv k qNat K H)

private theorem iterBoxConv_nonneg (k : ℕ) (qNat : ℕ → ℕ) (K : ℕ) {H : ℤ → ℝ}
    (hH : ∀ m, 0 ≤ H m) : ∀ m, 0 ≤ iterBoxConv k qNat K H m := by
  induction k with
  | zero => exact hH
  | succ k ih => exact boxConv_nonneg K (qNat k : ℤ) ih

private theorem iterBoxConv_suppIn {k : ℕ} {qNat : ℕ → ℕ} {K Q B : ℕ} {H : ℤ → ℝ}
    (hq : ∀ i < k, qNat i ≤ Q) (hH : SuppIn B H) :
    SuppIn (B + k * (K * Q)) (iterBoxConv k qNat K H) := by
  induction k with
  | zero => simpa [iterBoxConv] using hH
  | succ k ih =>
    simp only [iterBoxConv]
    have hprev := ih (fun i hi => hq i (Nat.lt_succ_of_lt hi))
    have hstep := boxConv_suppIn (A := K) (s := qNat k) hprev
    refine suppIn_mono ?_ hstep
    have hqk : K * qNat k ≤ K * Q := Nat.mul_le_mul_left K (hq k (Nat.lt_succ_self k))
    nlinarith

private theorem boxConv_iterBoxConv_comm (A : ℕ) (s : ℤ) (k : ℕ) (qNat : ℕ → ℕ) (K : ℕ)
    (H : ℤ → ℝ) :
    boxConv A s (iterBoxConv k qNat K H) = iterBoxConv k qNat K (boxConv A s H) := by
  induction k with
  | zero => rfl
  | succ k ih =>
    simp only [iterBoxConv]
    rw [boxConv_comm, ih]

private theorem iterBoxConv_sum_eq {k : ℕ} {qNat : ℕ → ℕ} {K Q B : ℕ} {H : ℤ → ℝ}
    (hq : ∀ i < k, qNat i ≤ Q) (hH : SuppIn B H) :
    ∑ m ∈ Finset.Ico (0 : ℤ) ((B + k * (K * Q) : ℕ) : ℤ), iterBoxConv k qNat K H m =
      (K : ℝ) ^ k * ∑ m ∈ Finset.Ico (0 : ℤ) (B : ℤ), H m := by
  induction k with
  | zero => simp [iterBoxConv]
  | succ k ih =>
    simp only [iterBoxConv]
    have hprev_supp := iterBoxConv_suppIn (K := K) (fun i hi => hq i (Nat.lt_succ_of_lt hi)) hH
    have hstep_supp : SuppIn ((B + k * (K * Q)) + K * qNat k)
        (boxConv K (qNat k : ℤ) (iterBoxConv k qNat K H)) := boxConv_suppIn hprev_supp
    have hle_top : (B + k * (K * Q)) + K * qNat k ≤ B + (k + 1) * (K * Q) := by
      have hqk : K * qNat k ≤ K * Q := Nat.mul_le_mul_left K (hq k (Nat.lt_succ_self k))
      nlinarith
    have hext_eq : ((B + (k + 1) * (K * Q) : ℕ) : ℤ) =
        ((((B + k * (K * Q)) + K * qNat k) +
          ((B + (k + 1) * (K * Q)) - ((B + k * (K * Q)) + K * qNat k)) : ℕ) : ℤ) := by omega
    rw [hext_eq]
    have htrunc := sum_Ico_shift_eq
      (D := (B + (k + 1) * (K * Q)) - ((B + k * (K * Q)) + K * qNat k))
      (s := 0) hstep_supp (Nat.zero_le _) id rfl
    simp only [Nat.cast_zero, sub_zero, id_eq] at htrunc
    rw [htrunc, boxConv_sum_eq hprev_supp, ih (fun i hi => hq i (Nat.lt_succ_of_lt hi)), pow_succ]
    ring

private theorem iterBoxConv_ge_self (k : ℕ) (qNat : ℕ → ℕ) {K : ℕ} (hK : 1 ≤ K)
    {H : ℤ → ℝ} (hH : ∀ m, 0 ≤ H m) (m : ℤ) :
    H m ≤ iterBoxConv k qNat K H m := by
  induction k with
  | zero => exact le_rfl
  | succ k ih =>
    simp only [iterBoxConv, boxConv]
    have h0_mem : 0 ∈ Finset.range K := Finset.mem_range.mpr hK
    have hsingle := Finset.single_le_sum
      (f := fun u : ℕ => iterBoxConv k qNat K H (m - (u : ℤ) * (qNat k : ℤ)))
      (fun u _ => iterBoxConv_nonneg k qNat K hH (m - (u : ℤ) * (qNat k : ℤ))) h0_mem
    simp only [Nat.cast_zero, zero_mul, sub_zero] at hsingle
    exact ih.trans hsingle

private theorem iterBoxConv_extract {k : ℕ} {qNat : ℕ → ℕ} {K Q B : ℕ} {H : ℤ → ℝ}
    (hq : ∀ j < k, qNat j ≤ Q) (hH_nn : ∀ m, 0 ≤ H m) (hH_supp : SuppIn B H) :
    ∀ i < k, ∃ (B_i : ℕ) (H_i : ℤ → ℝ),
      (∀ m, 0 ≤ H_i m) ∧ SuppIn B_i H_i ∧ B_i + K * qNat i ≤ B + k * (K * Q) ∧
      iterBoxConv k qNat K H = boxConv K (qNat i : ℤ) H_i := by
  induction k with
  | zero => intro i hi; omega
  | succ k ih =>
    intro i hi
    have hqk : K * qNat k ≤ K * Q := Nat.mul_le_mul_left K (hq k (Nat.lt_succ_self k))
    rcases eq_or_lt_of_le (Nat.lt_succ_iff.mp hi) with hik | hlt
    · subst hik
      refine ⟨B + i * (K * Q), iterBoxConv i qNat K H,
        iterBoxConv_nonneg i qNat K hH_nn,
        iterBoxConv_suppIn (fun j hj => hq j (Nat.lt_succ_of_lt hj)) hH_supp,
        by nlinarith, rfl⟩
    · obtain ⟨B', H', hH'_nn, hH'_supp, hB'_le, heq⟩ :=
        ih (fun j hj => hq j (Nat.lt_succ_of_lt hj)) i hlt
      refine ⟨B' + K * qNat k, boxConv K (qNat k : ℤ) H',
        boxConv_nonneg K (qNat k : ℤ) hH'_nn,
        boxConv_suppIn hH'_supp, by nlinarith, ?_⟩
      simp only [iterBoxConv, heq]
      exact boxConv_comm K (qNat k : ℤ) K (qNat i : ℤ) H'

/-- **Opaque smoothed additive-cube wavepacket.**
Given `r` quantized steps `q : Fin r → ℕ` bounded by `Q`, multiplicity scale `M ≥ 1`, and window
half-width `L ≥ 1`, returns an explicit height-grid dimension `n = 1 + 16 M r Q + 512 M² L`,
nonnegative amplitudes `c : Fin n → ℝ`, and even normalized autocorrelation `R : ℤ → ℝ` with:
- `R(q_ℓ + t) ≥ 1 − 1 / (8 M)` for every `ℓ : Fin r` and `|t| ≤ L`,
- `∑_{|s| ≤ n} R(s) ≤ (16 M)^{2r} (512 M² L)`, and
- exact diagonal-grouping identity converting `Fin n × Fin n` Gram sums into `Icc (-n) n` sums. -/
private theorem exists_smoothed_box_config {r M L Q : ℕ} (hM1 : 1 ≤ M) (hL1 : 1 ≤ L)
    (q : Fin r → ℕ) (hq : ∀ ℓ, q ℓ ≤ Q) :
    ∃ (n : ℕ) (S2 : ℝ) (c : Fin n → ℝ) (R : ℤ → ℝ),
      n = 1 + 16 * M * r * Q + 512 * M ^ 2 * L ∧
      (∀ j, 0 ≤ c j) ∧
      0 < S2 ∧
      (∀ s : ℤ, R (-s) = R s) ∧
      (∀ s : ℤ, 0 ≤ R s ∧ R s ≤ 1) ∧
      ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s ≤
        (((16 * M) ^ (2 * r) * (512 * M ^ 2 * L) : ℕ) : ℝ) ∧
      (∀ (ℓ : Fin r) (t : ℤ), t.natAbs ≤ L →
        1 - 1 / (8 * (M : ℝ)) ≤ R ((q ℓ : ℤ) + t)) ∧
      (∀ ψ : ℤ → ℝ,
        ∑ j : Fin n, ∑ i : Fin n, c j * c i * ψ ((j : ℤ) - (i : ℤ)) =
          S2 * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * ψ s) := by
  classical
  set K : ℕ := 16 * M
  set E : ℕ := 512 * M ^ 2
  set N : ℕ := E * L
  have hK1 : 1 ≤ K := by dsimp only [K]; omega
  have hE1 : 1 ≤ E := by dsimp only [E]; nlinarith
  have hN1 : 1 ≤ N := Nat.mul_le_mul hE1 hL1
  set n : ℕ := (1 + N) + r * (K * Q)
  have hn_eq : n = 1 + 16 * M * r * Q + 512 * M ^ 2 * L := by
    dsimp only [n, K, E, N]; ring
  let qNat : ℕ → ℕ := fun i => if hi : i < r then q ⟨i, hi⟩ else 0
  have hqNat : ∀ i < r, qNat i ≤ Q := fun i hi => by simp only [qNat, dif_pos hi]; exact hq ⟨i, hi⟩
  let base : ℤ → ℝ := boxConv N 1 delta0
  have hbase_nn : ∀ m, 0 ≤ base m := boxConv_nonneg N 1 delta0_nonneg
  have hbase_supp : SuppIn (1 + N) base := by
    dsimp only [base]
    simpa only [mul_one, Nat.cast_one] using boxConv_suppIn (A := N) (s := 1) delta0_suppIn
  let f : ℤ → ℝ := iterBoxConv r qNat K base
  have hf_nn : ∀ m, 0 ≤ f m := iterBoxConv_nonneg r qNat K hbase_nn
  have hf_supp : SuppIn n f := iterBoxConv_suppIn hqNat hbase_supp
  let c : Fin n → ℝ := fun j => f (j : ℤ)
  set S2 : ℝ := ∑ j : Fin n, (c j) ^ 2
  have hS2_Ico : S2 = ∑ m ∈ Finset.Ico (0 : ℤ) (n : ℤ), (f m) ^ 2 :=
    sum_fin_eq_sum_Ico n (fun m => (f m) ^ 2)
  have hN_le_S2 : (N : ℝ) ≤ S2 := by
    rw [hS2_Ico]
    have hsub : Finset.Ico (0 : ℤ) (N : ℤ) ⊆ Finset.Ico (0 : ℤ) (n : ℤ) := by
      intro m hm; rw [Finset.mem_Ico] at hm ⊢; omega
    have hge1 : ∀ m ∈ Finset.Ico (0 : ℤ) (N : ℤ), (1 : ℝ) ≤ (f m) ^ 2 := by
      intro m hm
      rw [Finset.mem_Ico] at hm
      have hb1 : base m = 1 := boxConv_one_delta0_eq_one hm.1 hm.2
      have hfm : 1 ≤ f m := by rw [← hb1]; exact iterBoxConv_ge_self r qNat hK1 hbase_nn m
      nlinarith
    calc (N : ℝ) = ∑ _m ∈ Finset.Ico (0 : ℤ) (N : ℤ), (1 : ℝ) := by
          rw [sum_Ico_zero_nat_const, mul_one]
      _ ≤ ∑ m ∈ Finset.Ico (0 : ℤ) (N : ℤ), (f m) ^ 2 := Finset.sum_le_sum hge1
      _ ≤ ∑ m ∈ Finset.Ico (0 : ℤ) (n : ℤ), (f m) ^ 2 :=
          Finset.sum_le_sum_of_subset_of_nonneg hsub fun _ _ _ => sq_nonneg _
  have hS2_pos : 0 < S2 := lt_of_lt_of_le (by exact_mod_cast hN1) hN_le_S2
  let R : ℤ → ℝ := fun s => (∑ j : Fin n, c j * f ((j : ℤ) - s)) / S2
  -- Diagonal-grouping identity first (used for evenness and total `R`-sum).
  have hdiag : ∀ ψ : ℤ → ℝ,
      ∑ j : Fin n, ∑ i : Fin n, c j * c i * ψ ((j : ℤ) - (i : ℤ)) =
        S2 * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * ψ s := by
    intro ψ
    have hrow : ∀ j : Fin n,
        ∑ i : Fin n, c j * c i * ψ ((j : ℤ) - (i : ℤ)) =
          ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), c j * f ((j : ℤ) - s) * ψ s := by
      intro j
      have hcongr : ∑ i : Fin n, c j * c i * ψ ((j : ℤ) - (i : ℤ)) =
          ∑ i ∈ (Finset.univ : Finset (Fin n)),
            c j * f ((j : ℤ) - ((j : ℤ) - (i : ℤ))) * ψ ((j : ℤ) - (i : ℤ)) :=
        Finset.sum_congr rfl fun i _ => by rw [sub_sub_cancel]
      rw [hcongr]
      refine sum_comp_eq_sum_of_injOn_eq_zero (fun i : Fin n => (j : ℤ) - (i : ℤ))
        (fun s : ℤ => c j * f ((j : ℤ) - s) * ψ s) ?_ ?_ ?_
      · intro i _
        rw [Finset.mem_Icc]
        omega
      · intro i₁ _ i₂ _ h
        dsimp only at h
        exact Fin.ext (by omega)
      · intro s hs hnot
        have hout : (j : ℤ) - s < 0 ∨ (n : ℤ) ≤ (j : ℤ) - s := by
          by_contra hmem
          push Not at hmem
          let i₀ : Fin n := ⟨((j : ℤ) - s).toNat, by omega⟩
          exact hnot i₀ (Finset.mem_univ i₀) (by dsimp only [i₀]; omega)
        rw [hf_supp _ hout, mul_zero, zero_mul]
    simp_rw [hrow]
    rw [Finset.sum_comm, Finset.mul_sum]
    refine Finset.sum_congr rfl fun s _ => ?_
    dsimp only [R]
    rw [← Finset.sum_mul, ← mul_assoc, mul_div_cancel₀ _ hS2_pos.ne']
  -- Evenness `R (-s) = R s`.
  have hR_even : ∀ s : ℤ, R (-s) = R s := by
    intro s
    by_cases hs : s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ)
    · have hns : -s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ) := by
        rw [Finset.mem_Icc] at hs ⊢; omega
      have h1 := hdiag (fun w => if w = s then 1 else 0)
      have h2 := hdiag (fun w => if w = -s then 1 else 0)
      have hr1 : ∑ w ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R w * (if w = s then 1 else 0) = R s := by
        rw [Finset.sum_eq_single s]
        · simp
        · intro w _ hne; simp [hne]
        · intro hnot; exact absurd hs hnot
      have hr2 : ∑ w ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R w * (if w = -s then 1 else 0) = R (-s) := by
        rw [Finset.sum_eq_single (-s)]
        · simp
        · intro w _ hne; simp [hne]
        · intro hnot; exact absurd hns hnot
      rw [hr1] at h1
      rw [hr2] at h2
      have hl_eq : (∑ j : Fin n, ∑ i : Fin n, c j * c i * (if (j : ℤ) - (i : ℤ) = -s then 1 else 0)) =
          ∑ j : Fin n, ∑ i : Fin n, c j * c i * (if (j : ℤ) - (i : ℤ) = s then 1 else 0) := by
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun i _ => ?_
        have hiff : ((i : ℤ) - (j : ℤ) = -s) ↔ ((j : ℤ) - (i : ℤ) = s) := by omega
        simp only [hiff]
        ring
      have hmul_eq : S2 * R (-s) = S2 * R s := by linarith [h1, h2, hl_eq]
      exact mul_left_cancel₀ hS2_pos.ne' hmul_eq
    · rw [Finset.mem_Icc] at hs
      have hz1 : ∑ j : Fin n, c j * f ((j : ℤ) - s) = 0 := by
        refine Finset.sum_eq_zero fun j _ => ?_
        rw [hf_supp _ (by omega), mul_zero]
      have hz2 : ∑ j : Fin n, c j * f ((j : ℤ) - (-s)) = 0 := by
        refine Finset.sum_eq_zero fun j _ => ?_
        rw [hf_supp _ (by omega), mul_zero]
      dsimp only [R]
      rw [hz1, hz2]
  -- Shifted `ℓ²` bound `∑_{k ∈ S} (f (k + s))² ≤ S2` for any finite `S : Finset ℤ` and `s : ℤ`.
  have hshift_sq_le_S2 : ∀ (S : Finset ℤ) (s : ℤ),
      ∑ k ∈ S, (f (k + s)) ^ 2 ≤ S2 := by
    intro S s
    rw [hS2_Ico]
    let S_in : Finset ℤ := S.filter fun k => 0 ≤ k + s ∧ k + s < (n : ℤ)
    have hfilt : ∑ k ∈ S, (f (k + s)) ^ 2 = ∑ k ∈ S_in, (f (k + s)) ^ 2 := by
      symm
      refine Finset.sum_subset (Finset.filter_subset _ _) fun k hk hnot => ?_
      rw [Finset.mem_filter] at hnot
      have hnot' : ¬(0 ≤ k + s ∧ k + s < (n : ℤ)) := fun h => hnot ⟨hk, h⟩
      have hout : k + s < 0 ∨ (n : ℤ) ≤ k + s := by omega
      rw [hf_supp _ hout]
      norm_num
    rw [hfilt]
    refine sum_comp_le_sum_of_injOn (fun k : ℤ => k + s) (fun m : ℤ => (f m) ^ 2) ?_ ?_
      (fun _ _ => sq_nonneg _)
    · intro k hk
      rw [Finset.mem_filter] at hk
      exact Finset.mem_Ico.mpr hk.2
    · intro k₁ _ k₂ _ h
      dsimp only at h
      omega
  -- Bounds `0 ≤ R s ∧ R s ≤ 1`.
  have hR_bounds : ∀ s : ℤ, 0 ≤ R s ∧ R s ≤ 1 := by
    intro s
    refine ⟨div_nonneg (Finset.sum_nonneg fun j _ => mul_nonneg (hf_nn _) (hf_nn _)) hS2_pos.le, ?_⟩
    dsimp only [R]
    rw [div_le_one hS2_pos]
    have hIco : ∑ j : Fin n, c j * f ((j : ℤ) - s) =
        ∑ m ∈ Finset.Ico (0 : ℤ) (n : ℤ), f m * f (m - s) :=
      sum_fin_eq_sum_Ico n (fun m => f m * f (m - s))
    rw [hIco]
    have hpt : ∀ m ∈ Finset.Ico (0 : ℤ) (n : ℤ),
        2 * (f m * f (m - s)) ≤ (f m) ^ 2 + (f (m - s)) ^ 2 :=
      fun m _ => by nlinarith [sq_nonneg (f m - f (m - s))]
    have hsum2 := Finset.sum_le_sum hpt
    rw [← Finset.mul_sum, Finset.sum_add_distrib, ← hS2_Ico] at hsum2
    have hsh := hshift_sq_le_S2 (Finset.Ico (0 : ℤ) (n : ℤ)) (-s)
    simp_rw [← sub_eq_add_neg] at hsh
    linarith
  -- Total `R`-sum bound `∑_{|s| ≤ n} R s ≤ K^{2r} N`.
  have hR_sum : ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s ≤
      (((16 * M) ^ (2 * r) * (512 * M ^ 2 * L) : ℕ) : ℝ) := by
    have h1 := hdiag (fun _ => 1)
    simp only [mul_one] at h1
    have hlhs : ∑ j : Fin n, ∑ i : Fin n, c j * c i = (∑ j : Fin n, c j) ^ 2 := by
      simp_rw [← Finset.mul_sum, ← Finset.sum_mul, sq]
    have hc_sum : ∑ j : Fin n, c j = (K : ℝ) ^ r * (N : ℝ) := by
      rw [sum_fin_eq_sum_Ico n f, iterBoxConv_sum_eq hqNat hbase_supp, boxConv_one_delta0_sum]
    rw [hlhs, hc_sum] at h1
    have hmul_le : (N : ℝ) * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s ≤
        ((K : ℝ) ^ r * (N : ℝ)) ^ 2 := by
      have hR_sum_nn : 0 ≤ ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s :=
        Finset.sum_nonneg fun s _ => (hR_bounds s).1
      calc (N : ℝ) * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s
          ≤ S2 * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s :=
            mul_le_mul_of_nonneg_right hN_le_S2 hR_sum_nn
        _ = ((K : ℝ) ^ r * (N : ℝ)) ^ 2 := h1.symm
    have hN_pos_r : (0 : ℝ) < N := by exact_mod_cast hN1
    have hcast_rhs : (((16 * M) ^ (2 * r) * (512 * M ^ 2 * L) : ℕ) : ℝ) * (N : ℝ) =
        ((K : ℝ) ^ r * (N : ℝ)) ^ 2 := by
      have hnat : (16 * M) ^ (2 * r) * (512 * M ^ 2 * L) = K ^ (2 * r) * N := rfl
      rw [hnat]
      push_cast
      rw [mul_comm 2 r, pow_mul]
      ring
    nlinarith
  -- Step 1 of `R(q_ℓ + t)` lower bound: `1 − R(q_ℓ) ≤ 1 / (16 M)`.
  have hR_gen : ∀ ℓ : Fin r, 1 - 1 / (16 * (M : ℝ)) ≤ R (q ℓ : ℤ) := by
    intro ℓ
    obtain ⟨B_ℓ, H_ℓ, hHℓ_nn, hHℓ_supp, hBℓ_le, hf_eq_ℓ⟩ :=
      iterBoxConv_extract hqNat hbase_nn hbase_supp ℓ.1 ℓ.2
    have hqℓ_eq : qNat ℓ.1 = q ℓ := by simp [qNat, ℓ.2]
    rw [hqℓ_eq] at hBℓ_le hf_eq_ℓ
    have hshift_le := boxConv_shift_sq_le hHℓ_nn hHℓ_supp hBℓ_le
    rw [← hf_eq_ℓ, ← hS2_Ico] at hshift_le
    -- Expand `∑_{Ico 0 (n + q ℓ)} (f (m − q ℓ) − f m)² = 2 (1 − R(q ℓ)) S2`.
    have hs1 : ∑ m ∈ Finset.Ico (0 : ℤ) ((n + q ℓ : ℕ) : ℤ), (f (m - (q ℓ : ℤ))) ^ 2 = S2 := by
      rw [hS2_Ico]
      exact sum_Ico_shift_eq hf_supp le_rfl (fun x => x ^ 2) (by norm_num)
    have hs2 : ∑ m ∈ Finset.Ico (0 : ℤ) ((n + q ℓ : ℕ) : ℤ), (f m) ^ 2 = S2 := by
      rw [hS2_Ico]
      simpa using sum_Ico_shift_eq (s := 0) hf_supp (Nat.zero_le _) (fun x => x ^ 2) (by norm_num)
    have hcross : ∑ m ∈ Finset.Ico (0 : ℤ) ((n + q ℓ : ℕ) : ℤ), f m * f (m - (q ℓ : ℤ)) =
        S2 * R (q ℓ : ℤ) := by
      have hsub : Finset.Ico (0 : ℤ) (n : ℤ) ⊆ Finset.Ico (0 : ℤ) ((n + q ℓ : ℕ) : ℤ) := by
        intro m hm; rw [Finset.mem_Ico] at hm ⊢; omega
      have htr : ∑ m ∈ Finset.Ico (0 : ℤ) ((n + q ℓ : ℕ) : ℤ), f m * f (m - (q ℓ : ℤ)) =
          ∑ m ∈ Finset.Ico (0 : ℤ) (n : ℤ), f m * f (m - (q ℓ : ℤ)) := by
        symm
        refine Finset.sum_subset hsub fun m hm hnot => ?_
        rw [Finset.mem_Ico] at hm hnot
        rw [hf_supp m (by omega), zero_mul]
      rw [htr, ← sum_fin_eq_sum_Ico n (fun m => f m * f (m - (q ℓ : ℤ)))]
      dsimp only [R, c]
      rw [mul_div_cancel₀ _ hS2_pos.ne']
    have hexp : ∑ m ∈ Finset.Ico (0 : ℤ) ((n + q ℓ : ℕ) : ℤ),
          (f (m - (q ℓ : ℤ)) - f m) ^ 2 = 2 * (1 - R (q ℓ : ℤ)) * S2 := by
      have hcongr : ∑ m ∈ Finset.Ico (0 : ℤ) ((n + q ℓ : ℕ) : ℤ), (f (m - (q ℓ : ℤ)) - f m) ^ 2 =
          ∑ m ∈ Finset.Ico (0 : ℤ) ((n + q ℓ : ℕ) : ℤ),
            (((f (m - (q ℓ : ℤ))) ^ 2 + (f m) ^ 2) - 2 * (f m * f (m - (q ℓ : ℤ)))) :=
        Finset.sum_congr rfl fun m _ => by ring
      rw [hcongr, Finset.sum_sub_distrib, Finset.sum_add_distrib, ← Finset.mul_sum,
          hs1, hs2, hcross]
      ring
    rw [hexp] at hshift_le
    have hK_real : (K : ℝ) = 16 * (M : ℝ) := by dsimp only [K]; push_cast; rfl
    rw [hK_real] at hshift_le
    have hM_pos : (0 : ℝ) < M := by exact_mod_cast hM1
    have h16M_le : (16 * (M : ℝ)) * (1 - R (q ℓ : ℤ)) ≤ 1 := by
      nlinarith [hshift_le, hS2_pos]
    have hdiv := (le_div_iff₀ (by positivity : (0 : ℝ) < 16 * (M : ℝ))).mpr
      (by linarith : (1 - R (q ℓ : ℤ)) * (16 * (M : ℝ)) ≤ 1)
    linarith
  -- Step 2 of `R(q_ℓ + t)` lower bound: `|R(s + u) − R(s)| ≤ 1 / (16 M)` for `u ≤ L`.
  have hR_lip_nat : ∀ (s : ℤ) (u : ℕ), u ≤ L →
      |R (s + (u : ℤ)) - R s| ≤ 1 / (16 * (M : ℝ)) := by
    intro s u huL
    rcases eq_or_ne u 0 with rfl | hu0
    · simp
    have hu1 : 1 ≤ u := Nat.pos_of_ne_zero hu0
    let G_iter : ℤ → ℝ := iterBoxConv r qNat K delta0
    have hG_nn : ∀ m, 0 ≤ G_iter m := iterBoxConv_nonneg r qNat K delta0_nonneg
    have hG_supp : SuppIn (1 + r * (K * Q)) G_iter := iterBoxConv_suppIn hqNat delta0_suppIn
    have hf_eq_win : f = boxConv (E * L) 1 G_iter :=
      (boxConv_iterBoxConv_comm (E * L) 1 r qNat K delta0).symm
    have hn_win : (1 + r * (K * Q)) + E * L ≤ n := by dsimp only [n, N]; omega
    have hwin_sq := boxConv_window_shift_sq_le hG_nn hG_supp hu1 huL hn_win
    rw [← hf_eq_win, ← hS2_Ico] at hwin_sq
    -- Identify `S2 * (R (s + u) − R s)` with `∑_{k ∈ Ico 0 (n + u)} f (k + s) (f (k − u) − f k)`.
    let I_ext : Finset ℤ := Finset.Ico (0 : ℤ) ((n + u : ℕ) : ℤ)
    have hdiff_S2 : S2 * (R (s + (u : ℤ)) - R s) =
        ∑ k ∈ I_ext, f (k + s) * (f (k - (u : ℤ)) - f k) := by
      have hlhs : S2 * (R (s + (u : ℤ)) - R s) =
          ∑ m ∈ Finset.Ico (0 : ℤ) (n : ℤ), f m * (f ((m - s) - (u : ℤ)) - f (m - s)) := by
        dsimp only [R]
        rw [mul_sub, mul_div_cancel₀ _ hS2_pos.ne', mul_div_cancel₀ _ hS2_pos.ne',
            ← Finset.sum_sub_distrib,
            sum_fin_eq_sum_Ico n (fun m => f m * f (m - (s + (u : ℤ))) - f m * f (m - s))]
        refine Finset.sum_congr rfl fun m _ => ?_
        have he : m - (s + (u : ℤ)) = (m - s) - (u : ℤ) := by ring
        rw [he, mul_sub]
      rw [hlhs]
      let S_in : Finset ℤ := (Finset.Ico (0 : ℤ) (n : ℤ)).filter
        fun m => 0 ≤ m - s ∧ m - s < ((n + u : ℕ) : ℤ)
      have hfilt : ∑ m ∈ Finset.Ico (0 : ℤ) (n : ℤ), f m * (f ((m - s) - (u : ℤ)) - f (m - s)) =
          ∑ m ∈ S_in, f m * (f ((m - s) - (u : ℤ)) - f (m - s)) := by
        symm
        refine Finset.sum_subset (Finset.filter_subset _ _) fun m hm_in hnot => ?_
        rw [Finset.mem_filter] at hnot
        have hout1 : (m - s) - (u : ℤ) < 0 ∨ (n : ℤ) ≤ (m - s) - (u : ℤ) := by
          by_contra h1; push Not at h1
          exact hnot ⟨hm_in, by omega⟩
        have hout2 : m - s < 0 ∨ (n : ℤ) ≤ m - s := by
          by_contra h2; push Not at h2
          exact hnot ⟨hm_in, by omega⟩
        rw [hf_supp _ hout1, hf_supp _ hout2]
        ring
      have hcongr_in : ∑ m ∈ S_in, f m * (f ((m - s) - (u : ℤ)) - f (m - s)) =
          ∑ m ∈ S_in, f ((m - s) + s) * (f ((m - s) - (u : ℤ)) - f (m - s)) :=
        Finset.sum_congr rfl fun m _ => by rw [sub_add_cancel]
      rw [hfilt, hcongr_in]
      refine sum_comp_eq_sum_of_injOn_eq_zero (fun m : ℤ => m - s)
        (fun k : ℤ => f (k + s) * (f (k - (u : ℤ)) - f k)) ?_ ?_ ?_
      · intro m hm
        rw [Finset.mem_filter] at hm
        exact Finset.mem_Ico.mpr hm.2
      · intro m₁ _ m₂ _ h
        dsimp only at h
        omega
      · intro k hk hnot
        have hout : k + s < 0 ∨ (n : ℤ) ≤ k + s := by
          by_contra hmem; push Not at hmem
          exact hnot (k + s)
            (Finset.mem_filter.mpr ⟨Finset.mem_Ico.mpr hmem, by
              rw [Finset.mem_Ico] at hk; omega⟩)
            (by omega)
        rw [hf_supp _ hout, zero_mul]
    have hcs := Finset.sum_mul_sq_le_sq_mul_sq I_ext (fun k => f (k + s))
      (fun k => f (k - (u : ℤ)) - f k)
    rw [← hdiff_S2] at hcs
    have hsh_S2 : ∑ k ∈ I_ext, (f (k + s)) ^ 2 ≤ S2 := hshift_sq_le_S2 I_ext s
    have hdiff_nn : 0 ≤ ∑ k ∈ I_ext, (f (k - (u : ℤ)) - f k) ^ 2 :=
      Finset.sum_nonneg fun _ _ => sq_nonneg _
    have hE_real : (E : ℝ) = 512 * (M : ℝ) ^ 2 := by dsimp only [E]; push_cast; rfl
    have hsq_bound : ((16 * (M : ℝ)) * (R (s + (u : ℤ)) - R s)) ^ 2 ≤ 1 := by
      have h1 : (S2 * (R (s + (u : ℤ)) - R s)) ^ 2 ≤
          S2 * ∑ k ∈ I_ext, (f (k - (u : ℤ)) - f k) ^ 2 :=
        hcs.trans (mul_le_mul_of_nonneg_right hsh_S2 hdiff_nn)
      have h2 : (E : ℝ) * (S2 * (R (s + (u : ℤ)) - R s)) ^ 2 ≤ 2 * S2 ^ 2 := by
        calc (E : ℝ) * (S2 * (R (s + (u : ℤ)) - R s)) ^ 2
            ≤ (E : ℝ) * (S2 * ∑ k ∈ I_ext, (f (k - (u : ℤ)) - f k) ^ 2) :=
              mul_le_mul_of_nonneg_left h1 (Nat.cast_nonneg E)
          _ = S2 * ((E : ℝ) * ∑ k ∈ I_ext, (f (k - (u : ℤ)) - f k) ^ 2) := by ring
          _ ≤ S2 * (2 * S2) := mul_le_mul_of_nonneg_left hwin_sq hS2_pos.le
          _ = 2 * S2 ^ 2 := by ring
      rw [hE_real] at h2
      have hS2_sq_pos : 0 < S2 ^ 2 := sq_pos_of_pos hS2_pos
      have h3 : 2 * S2 ^ 2 * ((16 * (M : ℝ)) * (R (s + (u : ℤ)) - R s)) ^ 2 =
          (512 * (M : ℝ) ^ 2) * (S2 * (R (s + (u : ℤ)) - R s)) ^ 2 := by ring
      nlinarith [h2, h3, hS2_sq_pos]
    have habs_mul : |(16 * (M : ℝ)) * (R (s + (u : ℤ)) - R s)| ≤ 1 := by
      have hsq_abs : |(16 * (M : ℝ)) * (R (s + (u : ℤ)) - R s)| ^ 2 ≤ 1 := by
        rwa [sq_abs]
      nlinarith [abs_nonneg ((16 * (M : ℝ)) * (R (s + (u : ℤ)) - R s)), hsq_abs]
    have hM_pos : (0 : ℝ) < M := by exact_mod_cast hM1
    rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 16 * (M : ℝ))] at habs_mul
    exact (le_div_iff₀ (by positivity : (0 : ℝ) < 16 * (M : ℝ))).mpr
      (by linarith : |R (s + (u : ℤ)) - R s| * (16 * (M : ℝ)) ≤ 1)
  refine ⟨n, S2, c, R, hn_eq, fun j => hf_nn _, hS2_pos, hR_even, hR_bounds, hR_sum, ?_, hdiag⟩
  intro ℓ t htL
  have hgen := hR_gen ℓ
  have hlip : |R ((q ℓ : ℤ) + t) - R (q ℓ : ℤ)| ≤ 1 / (16 * (M : ℝ)) := by
    rcases le_or_gt 0 t with ht0 | ht_neg
    · have ht_eq : t = (t.natAbs : ℤ) := (Int.natAbs_of_nonneg ht0).symm
      rw [ht_eq]
      exact hR_lip_nat (q ℓ : ℤ) t.natAbs htL
    · have ht_eq : (q ℓ : ℤ) = ((q ℓ : ℤ) + t) + (t.natAbs : ℤ) := by omega
      have h := hR_lip_nat ((q ℓ : ℤ) + t) t.natAbs htL
      rw [← ht_eq, abs_sub_comm] at h
      exact h
  have hlo := (abs_le.mp hlip).1
  have hM_pos : (0 : ℝ) < M := by exact_mod_cast hM1
  have hfrac : 1 / (16 * (M : ℝ)) + 1 / (16 * (M : ℝ)) = 1 / (8 * (M : ℝ)) := by
    have hM_ne : (M : ℝ) ≠ 0 := hM_pos.ne'
    field_simp
    ring
  linarith [hgen, hlo, hfrac]

/-! ### 3. Fundamental-domain dihedral orbit extraction (without ordinate separation) -/

private theorem re_one_div_nonneg_of_re_le' {s z : ℂ} (hz : z.re ≤ s.re) :
    0 ≤ (1 / (s - z)).re := by
  rw [one_div, Complex.inv_re, Complex.sub_re]
  exact div_nonneg (sub_nonneg.mpr hz) (Complex.normSq_nonneg _)

private theorem orbit_re_im_invariants {z w : ℂ} (hre : 1 / 2 < z.re) (him : 0 < z.im)
    (hw : w ∈ ({z, starRingEnd ℂ z, 1 - z, 1 - starRingEnd ℂ z} : Finset ℂ)) :
    |w.re - 1 / 2| = z.re - 1 / 2 ∧ |w.im| = z.im := by
  have hd_pos : 0 < z.re - 1 / 2 := by linarith
  simp only [Finset.mem_insert, Finset.mem_singleton] at hw
  rcases hw with rfl | rfl | rfl | rfl
  · exact ⟨abs_of_pos hd_pos, abs_of_pos him⟩
  · have h1 : (starRingEnd ℂ z).re - 1 / 2 = z.re - 1 / 2 := by simp
    have h2 : (starRingEnd ℂ z).im = -z.im := by simp
    rw [h1, h2, abs_neg]
    exact ⟨abs_of_pos hd_pos, abs_of_pos him⟩
  · have h1 : (1 - z).re - 1 / 2 = -(z.re - 1 / 2) := by simp; ring
    have h2 : (1 - z).im = -z.im := by simp
    rw [h1, h2, abs_neg, abs_neg]
    exact ⟨abs_of_pos hd_pos, abs_of_pos him⟩
  · have h1 : (1 - starRingEnd ℂ z).re - 1 / 2 = -(z.re - 1 / 2) := by simp; ring
    have h2 : (1 - starRingEnd ℂ z).im = z.im := by simp
    rw [h1, h2, abs_neg]
    exact ⟨abs_of_pos hd_pos, abs_of_pos him⟩

/-- **Fundamental-domain dihedral orbit extraction.**
Because `{z ∈ ℂ : Re z > 1/2, Im z > 0}` is a strict fundamental domain for `⟨z ↦ 1 − z, z ↦ z̄⟩`,
any injective tuple `ρ : Fin r → ℂ` with `0 < Im ρ_ℓ` and `1/2 < Re ρ_ℓ` (whenever `1 ≤ m_ℓ`) has
pairwise disjoint four-element dihedral orbits in Hadamard's zero-pair expansion, requiring **no**
distinct-ordinate or `Δ`-separation hypothesis. -/
theorem sum_right_half_orbit_resolvent_le_re_logDeriv {κ d : ℕ} {F Λ : ℂ → ℂ}
    (hS : CompletedPositiveSystem κ d F Λ) {r : ℕ} (ρ : Fin r → ℂ) (m : Fin r → ℕ)
    (hinj : Function.Injective ρ)
    (him : ∀ ℓ, 1 ≤ m ℓ → 0 < (ρ ℓ).im)
    (hre : ∀ ℓ, 1 ≤ m ℓ → 1 / 2 < (ρ ℓ).re)
    (hm : ∀ ℓ, m ℓ ≤ (analyticOrderAt Λ (ρ ℓ)).toNat)
    {s : ℂ} (hs : 1 < s.re) :
    ∑ ℓ, (m ℓ : ℝ) * ((1 / (s - ρ ℓ)).re + (1 / (s - starRingEnd ℂ (ρ ℓ))).re) ≤
      (logDeriv Λ s).re := by
  classical
  set f : ℂ → ℂ := fun z => Λ (z + 2) with hfdef
  have hfd : Differentiable ℂ f := hS.entire_Λ.comp (differentiable_id.add_const 2)
  have hf : AnalyticOnNhd ℂ f univ := hfd.differentiableOn.analyticOnNhd isOpen_univ
  obtain ⟨C, hC, hgrow⟩ := hS.orderOne_Λ
  have hsum_c : HasSum (fun q : ZeroCopy f =>
      (1 / 2 : ℂ) * gPair (zeroCopyPoint f q + 2) s) (logDeriv Λ s) :=
    hasSum_logDeriv_zeroPairs hS.entire_Λ one_ne_zero
      (fun w => by rw [hS.sym_Λ w, one_mul]) hC.le
      (fun w => by simpa only [orderOneWeight] using hgrow w)
      hS.two_ne_zero (hS.ne_zero_of_one_lt_re hs)
  set term : ZeroCopy f → ℝ := fun q => ((1 / 2 : ℂ) * gPair (zeroCopyPoint f q + 2) s).re
  have hsum_re : HasSum term (logDeriv Λ s).re := hsum_c.mapL Complex.reCLM
  have hterm_nonneg : ∀ q : ZeroCopy f, 0 ≤ term q := by
    intro q
    have hzq0 : Λ (zeroCopyPoint f q + 2) = 0 := by simpa [hfdef] using apply_zeroCopyPoint hf q
    obtain ⟨h0, h1⟩ := hS.zero_re_mem_Icc hzq0
    simp only [term, gPair]
    have ha : 0 ≤ (1 / (s - (zeroCopyPoint f q + 2))).re :=
      re_one_div_nonneg_of_re_le' (h1.trans hs.le)
    have hb : 0 ≤ (1 / (s - (1 - (zeroCopyPoint f q + 2)))).re :=
      re_one_div_nonneg_of_re_le' (by rw [Complex.sub_re, Complex.one_re]; linarith)
    have hre_eq : ((1 / 2 : ℂ) * (1 / (s - (zeroCopyPoint f q + 2)) +
        1 / (s - (1 - (zeroCopyPoint f q + 2))))).re =
        ((1 / (s - (zeroCopyPoint f q + 2))).re +
          (1 / (s - (1 - (zeroCopyPoint f q + 2)))).re) / 2 := by
      have e : (1 / 2 : ℂ) * (1 / (s - (zeroCopyPoint f q + 2)) +
          1 / (s - (1 - (zeroCopyPoint f q + 2)))) =
          (1 / (s - (zeroCopyPoint f q + 2)) +
            1 / (s - (1 - (zeroCopyPoint f q + 2)))) / 2 := by ring
      rw [e, Complex.div_ofNat_re, Complex.add_re]
    rw [hre_eq]
    linarith
  have hdiv_toNat : ∀ w : ℂ,
      ((MeromorphicOn.divisor f univ) (w - 2)).toNat = (analyticOrderAt Λ w).toNat := by
    intro w
    have hg_an : AnalyticAt ℂ (fun z : ℂ => z + 2) (w - 2) := by fun_prop
    have hg_d : deriv (fun z : ℂ => z + 2) (w - 2) ≠ 0 := by
      have hd : HasDerivAt (fun z : ℂ => z + 2) 1 (w - 2) := (hasDerivAt_id' (w - 2)).add_const 2
      rw [hd.deriv]; exact one_ne_zero
    have hcomp := analyticOrderAt_comp_of_deriv_ne_zero (f := Λ) hg_an hg_d
    have hfeq : Λ ∘ (fun z : ℂ => z + 2) = f := rfl
    rw [hfeq, sub_add_cancel] at hcomp
    rw [divisor_univ_eq_analyticOrder hf, hcomp]
    obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp (hS.orderAt_ne_top w)
    rw [← hn]; simp
  obtain ⟨copiesAt, hcopies_pt, hcopies_disj, hcopies_sum⟩ :
      ∃ copiesAt : ℂ → ℕ → Finset (ZeroCopy f),
        (∀ w k q, q ∈ copiesAt w k → zeroCopyPoint f q + 2 = w) ∧
        (∀ w₁ w₂ k₁ k₂, w₁ ≠ w₂ → Disjoint (copiesAt w₁ k₁) (copiesAt w₂ k₂)) ∧
        (∀ w k, 1 ≤ k → k ≤ (analyticOrderAt Λ w).toNat →
          ∑ q ∈ copiesAt w k, term q = (k : ℝ) * ((1 / 2 : ℂ) * gPair w s).re) := by
    let cAt : ℂ → ℕ → Finset (ZeroCopy f) := fun w k =>
      if hk : 1 ≤ k ∧ k ≤ ((MeromorphicOn.divisor f univ) (w - 2)).toNat then
        have hsupp : w - 2 ∈ (MeromorphicOn.divisor f univ).support := by
          intro h0; rw [h0] at hk; simp at hk; omega
        Finset.univ.map ⟨fun j : Fin k => ⟨⟨w - 2, hsupp⟩, ⟨j.1, j.2.trans_le hk.2⟩⟩,
          fun j₁ j₂ heq => by
            simp only [Sigma.mk.injEq, heq_eq_eq, Fin.mk.injEq] at heq
            exact Fin.ext heq.2⟩
      else ∅
    have hc_pt : ∀ w k q, q ∈ cAt w k → zeroCopyPoint f q + 2 = w := by
      intro w k q hq
      dsimp only [cAt] at hq
      split_ifs at hq with hk
      · obtain ⟨j, _, rfl⟩ := Finset.mem_map.mp hq
        change (w - 2) + 2 = w
        ring
      · simp at hq
    refine ⟨cAt, hc_pt, ?_, ?_⟩
    · intro w₁ w₂ k₁ k₂ hne
      rw [Finset.disjoint_left]
      intro q h1 h2
      exact hne ((hc_pt w₁ k₁ q h1).symm.trans (hc_pt w₂ k₂ q h2))
    · intro w k hk1 hkle
      have hk : 1 ≤ k ∧ k ≤ ((MeromorphicOn.divisor f univ) (w - 2)).toNat :=
        ⟨hk1, by rwa [hdiv_toNat]⟩
      have hmem_iff : ∀ q ∈ cAt w k, term q = ((1 / 2 : ℂ) * gPair w s).re :=
        fun q hq => by
          rw [show term q = ((1 / 2 : ℂ) * gPair (zeroCopyPoint f q + 2) s).re from rfl,
              hc_pt w k q hq]
      have hcard : (cAt w k).card = k := by
        simp only [cAt, dif_pos hk, Finset.card_map, Finset.card_univ, Fintype.card_fin]
      rw [Finset.sum_congr rfl hmem_iff, Finset.sum_const, hcard, nsmul_eq_mul]
  let orbPts : Fin r → Finset ℂ := fun ℓ =>
    {ρ ℓ, starRingEnd ℂ (ρ ℓ), 1 - ρ ℓ, 1 - starRingEnd ℂ (ρ ℓ)}
  let orbCopies : Fin r → Finset (ZeroCopy f) := fun ℓ =>
    if m ℓ = 0 then ∅ else (orbPts ℓ).biUnion (fun w => copiesAt w (m ℓ))
  -- Strict quadrant separation of `{ρ_ℓ, ρ̄_ℓ, 1 − ρ_ℓ, 1 − ρ̄_ℓ}` when `Re ρ_ℓ > 1/2, Im ρ_ℓ > 0`.
  have horbPts_eq : ∀ {ℓ ℓ' : Fin r} {w : ℂ},
      1 ≤ m ℓ → 1 ≤ m ℓ' → w ∈ orbPts ℓ → w ∈ orbPts ℓ' → ℓ = ℓ' := by
    intro ℓ ℓ' w hm1 hm1' hw1 hw2
    obtain ⟨hre1, him1⟩ := orbit_re_im_invariants (hre ℓ hm1) (him ℓ hm1) hw1
    obtain ⟨hre2, him2⟩ := orbit_re_im_invariants (hre ℓ' hm1') (him ℓ' hm1') hw2
    exact hinj (Complex.ext (by linarith) (by linarith))
  have horbPts_ord : ∀ ℓ w, w ∈ orbPts ℓ →
      (analyticOrderAt Λ w).toNat = (analyticOrderAt Λ (ρ ℓ)).toNat := by
    intro ℓ w hw
    simp only [orbPts, Finset.mem_insert, Finset.mem_singleton] at hw
    rcases hw with rfl | rfl | rfl | rfl
    · rfl
    · rw [hS.orderAt_conj]
    · rw [hS.orderAt_one_sub]
    · rw [hS.orderAt_one_sub, hS.orderAt_conj]
  have horb_disj : Pairwise (fun ℓ ℓ' => Disjoint (orbCopies ℓ) (orbCopies ℓ')) := by
    intro ℓ ℓ' hne
    rw [Finset.disjoint_left]
    intro q h1 h2
    dsimp only [orbCopies] at h1 h2
    split_ifs at h1 with hm1
    · simp at h1
    split_ifs at h2 with hm2
    · simp at h2
    obtain ⟨w₁, hw₁, hq₁⟩ := Finset.mem_biUnion.mp h1
    obtain ⟨w₂, hw₂, hq₂⟩ := Finset.mem_biUnion.mp h2
    have hp := (hcopies_pt w₁ (m ℓ) q hq₁).symm.trans (hcopies_pt w₂ (m ℓ') q hq₂)
    exact hne (horbPts_eq (Nat.pos_of_ne_zero hm1) (Nat.pos_of_ne_zero hm2) hw₁ (hp ▸ hw₂))
  have horb_le : ∀ ℓ,
      (m ℓ : ℝ) * ((1 / (s - ρ ℓ)).re + (1 / (s - starRingEnd ℂ (ρ ℓ))).re) ≤
        ∑ q ∈ orbCopies ℓ, term q := by
    intro ℓ
    rcases eq_or_ne (m ℓ) 0 with hm0 | hm0
    · simp [orbCopies, hm0]
    have hm1 : 1 ≤ m ℓ := Nat.pos_of_ne_zero hm0
    have hbi : ∑ q ∈ orbCopies ℓ, term q =
        ∑ w ∈ orbPts ℓ, ∑ q ∈ copiesAt w (m ℓ), term q := by
      simp only [orbCopies, if_neg hm0]
      exact Finset.sum_biUnion fun w₁ _ w₂ _ hne => hcopies_disj w₁ w₂ (m ℓ) (m ℓ) hne
    rw [hbi]
    have hinner : ∑ w ∈ orbPts ℓ, ∑ q ∈ copiesAt w (m ℓ), term q =
        ∑ w ∈ orbPts ℓ, (m ℓ : ℝ) * ((1 / 2 : ℂ) * gPair w s).re := by
      refine Finset.sum_congr rfl fun w hw => hcopies_sum w (m ℓ) hm1 ?_
      rw [horbPts_ord ℓ w hw]
      exact hm ℓ
    rw [hinner, ← Finset.mul_sum]
    refine mul_le_mul_of_nonneg_left ?_ (Nat.cast_nonneg _)
    have h0 := him ℓ hm1
    have hr := hre ℓ hm1
    have hne_conj : ρ ℓ ≠ starRingEnd ℂ (ρ ℓ) := fun h => by
      have := congrArg Complex.im h; simp at this; linarith
    have hne13 : ρ ℓ ≠ 1 - ρ ℓ := fun h => by
      have := congrArg Complex.im h; simp at this; linarith
    have hne14 : ρ ℓ ≠ 1 - starRingEnd ℂ (ρ ℓ) := fun h => by
      have := congrArg Complex.re h; simp at this; linarith
    have hne23 : starRingEnd ℂ (ρ ℓ) ≠ 1 - ρ ℓ := fun h => by
      have := congrArg Complex.re h; simp at this; linarith
    have hne24 : starRingEnd ℂ (ρ ℓ) ≠ 1 - starRingEnd ℂ (ρ ℓ) := fun h => by
      have := congrArg Complex.im h; simp at this; linarith
    have hne34 : 1 - ρ ℓ ≠ 1 - starRingEnd ℂ (ρ ℓ) := fun h =>
      hne_conj (by linear_combination -h)
    have hm1' : ρ ℓ ∉ ({starRingEnd ℂ (ρ ℓ), 1 - ρ ℓ, 1 - starRingEnd ℂ (ρ ℓ)} : Finset ℂ) := by
      simp [hne_conj, hne13, hne14]
    have hm2' : starRingEnd ℂ (ρ ℓ) ∉ ({1 - ρ ℓ, 1 - starRingEnd ℂ (ρ ℓ)} : Finset ℂ) := by
      simp [hne23, hne24]
    have hm3' : 1 - ρ ℓ ∉ ({1 - starRingEnd ℂ (ρ ℓ)} : Finset ℂ) := by simp [hne34]
    simp only [orbPts]
    rw [Finset.sum_insert hm1', Finset.sum_insert hm2', Finset.sum_insert hm3',
      Finset.sum_singleton]
    have hρ_zero : Λ (ρ ℓ) = 0 := hS.eq_zero_of_one_le_order_toNat (hm1.trans (hm ℓ))
    obtain ⟨_, hre_le1⟩ := hS.zero_re_mem_Icc hρ_zero
    have hnn1 : 0 ≤ (1 / (s - (1 - ρ ℓ))).re :=
      re_one_div_nonneg_of_re_le' (by simp; linarith)
    have hnn2 : 0 ≤ (1 / (s - (1 - starRingEnd ℂ (ρ ℓ)))).re :=
      re_one_div_nonneg_of_re_le' (by simp; linarith)
    have hsum4 : ((1 / 2 : ℂ) * gPair (ρ ℓ) s).re +
        (((1 / 2 : ℂ) * gPair (starRingEnd ℂ (ρ ℓ)) s).re +
          (((1 / 2 : ℂ) * gPair (1 - ρ ℓ) s).re +
            ((1 / 2 : ℂ) * gPair (1 - starRingEnd ℂ (ρ ℓ)) s).re)) =
        (1 / (s - ρ ℓ)).re + (1 / (s - starRingEnd ℂ (ρ ℓ))).re +
          (1 / (s - (1 - ρ ℓ))).re + (1 / (s - (1 - starRingEnd ℂ (ρ ℓ)))).re := by
      have e : (1 / 2 : ℂ) * gPair (ρ ℓ) s +
          ((1 / 2 : ℂ) * gPair (starRingEnd ℂ (ρ ℓ)) s +
            ((1 / 2 : ℂ) * gPair (1 - ρ ℓ) s +
              (1 / 2 : ℂ) * gPair (1 - starRingEnd ℂ (ρ ℓ)) s)) =
          1 / (s - ρ ℓ) + 1 / (s - starRingEnd ℂ (ρ ℓ)) +
            1 / (s - (1 - ρ ℓ)) + 1 / (s - (1 - starRingEnd ℂ (ρ ℓ))) := by
        simp only [gPair, sub_sub_cancel]; ring
      have := congrArg Complex.re e
      simpa only [Complex.add_re] using this
    linarith
  have htotal : ∑ ℓ, ∑ q ∈ orbCopies ℓ, term q =
      ∑ q ∈ Finset.univ.biUnion orbCopies, term q :=
    (Finset.sum_biUnion fun ℓ _ ℓ' _ hne => horb_disj hne).symm
  calc ∑ ℓ, (m ℓ : ℝ) * ((1 / (s - ρ ℓ)).re + (1 / (s - starRingEnd ℂ (ρ ℓ))).re)
      ≤ ∑ ℓ, ∑ q ∈ orbCopies ℓ, term q := Finset.sum_le_sum fun ℓ _ => horb_le ℓ
    _ = ∑ q ∈ Finset.univ.biUnion orbCopies, term q := htotal
    _ ≤ (logDeriv Λ s).re := sum_le_hasSum (Finset.univ.biUnion orbCopies)
          (fun q _ => hterm_nonneg q) hsum_re

/-- Coupled Gram forcing law on `{Re z > 1/2, Im z > 0}` without ordinate separation. -/
private theorem coupled_right_half_pole_zero_forcing {κ d : ℕ} {F Λ : ℂ → ℂ}
    (hS : CompletedPositiveSystem κ d F Λ) {r : ℕ} (ρ : Fin r → ℂ) (m : Fin r → ℕ)
    (hinj : Function.Injective ρ)
    (him : ∀ ℓ, 1 ≤ m ℓ → 0 < (ρ ℓ).im)
    (hre : ∀ ℓ, 1 ≤ m ℓ → 1 / 2 < (ρ ℓ).re)
    (hm : ∀ ℓ, m ℓ ≤ (analyticOrderAt Λ (ρ ℓ)).toNat)
    {n : ℕ} (x c : Fin n → ℝ) (hc : ∀ j, 0 ≤ c j) {δ : ℝ} (hδ : 0 < δ) :
    ∑ ℓ, (m ℓ : ℝ) * ∑ j, ∑ k, c j * c k *
        ((1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - ρ ℓ)).re +
          (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - starRingEnd ℂ (ρ ℓ))).re) ≤
      (κ : ℝ) * ∑ j, ∑ k, c j * c k *
          (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I) +
            1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - 1)).re +
        (d : ℝ) * ∑ j, ∑ k, c j * c k *
          (logDeriv Complex.Gammaℝ (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re := by
  have hσ : 1 < 1 + δ := by linarith
  have hgram : 0 ≤ ∑ j, ∑ k, c j * c k *
      (-logDeriv F (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re :=
    (hS.posDef_neg_logDeriv hσ).posDef n x c
  have hpt : ∀ j k : Fin n,
      c j * c k *
        (∑ ℓ, (m ℓ : ℝ) *
          ((1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - ρ ℓ)).re +
            (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - starRingEnd ℂ (ρ ℓ))).re)) ≤
      c j * c k *
        ((κ : ℝ) * (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I) +
            1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - 1)).re +
          (d : ℝ) * (logDeriv Complex.Gammaℝ
            (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re -
          (-logDeriv F (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re) := by
    intro j k
    refine mul_le_mul_of_nonneg_left ?_ (mul_nonneg (hc j) (hc k))
    set s : ℂ := ((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I
    have hs : 1 < s.re := by simp [s]; linarith
    have horb := sum_right_half_orbit_resolvent_le_re_logDeriv hS ρ m hinj him hre hm hs
    have hdecomp := congrArg Complex.re (hS.neg_logDeriv_F_eq hs)
    have hre_eq : ((κ : ℂ) * (1 / s + 1 / (s - 1)) +
        (d : ℂ) * logDeriv Complex.Gammaℝ s - logDeriv Λ s).re =
        (κ : ℝ) * (1 / s + 1 / (s - 1)).re +
          (d : ℝ) * (logDeriv Complex.Gammaℝ s).re - (logDeriv Λ s).re := by
      rw [Complex.sub_re, Complex.add_re, ← Complex.ofReal_natCast, Complex.re_ofReal_mul,
          ← Complex.ofReal_natCast, Complex.re_ofReal_mul]
    rw [hre_eq] at hdecomp
    linarith
  have hsum := Finset.sum_le_sum (s := Finset.univ) fun j _ =>
    Finset.sum_le_sum (s := Finset.univ) fun k _ => hpt j k
  have hlhs : (∑ ℓ, (m ℓ : ℝ) * ∑ j, ∑ k, c j * c k *
        ((1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - ρ ℓ)).re +
          (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - starRingEnd ℂ (ρ ℓ))).re)) =
      ∑ j, ∑ k, c j * c k * ∑ ℓ, (m ℓ : ℝ) *
        ((1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - ρ ℓ)).re +
          (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - starRingEnd ℂ (ρ ℓ))).re) := by
    simp_rw [Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun ℓ _ => ?_
    ring
  have hrhs : (∑ j, ∑ k, c j * c k *
        ((κ : ℝ) * (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I) +
            1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - 1)).re +
          (d : ℝ) * (logDeriv Complex.Gammaℝ
            (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re -
          (-logDeriv F (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re)) =
      (κ : ℝ) * (∑ j, ∑ k, c j * c k *
          (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I) +
            1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - 1)).re) +
        (d : ℝ) * (∑ j, ∑ k, c j * c k *
          (logDeriv Complex.Gammaℝ (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re) -
        ∑ j, ∑ k, c j * c k *
          (-logDeriv F (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re := by
    simp_rw [Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun k _ => ?_
    ring
  rw [hlhs]
  linarith [hsum, hrhs, hgram]

/-! ### 4. Quantitative finite-height half-pole collar forcing -/

private theorem re_inv_cauchy_eq (a u : ℝ) :
    (1 / ((a : ℂ) + (u : ℂ) * I)).re = a / (a ^ 2 + u ^ 2) := by
  rw [one_div, Complex.inv_re]
  have hre : ((a : ℂ) + (u : ℂ) * I).re = a := by simp
  have hnsq : Complex.normSq ((a : ℂ) + (u : ℂ) * I) = a ^ 2 + u ^ 2 := by
    rw [Complex.normSq_apply]; simp; ring
  rw [hre, hnsq]

private theorem re_one_div_le_one' {δ u : ℝ} (hδ : 0 < δ) :
    (1 / (((1 + δ : ℝ) : ℂ) + (u : ℂ) * I)).re ≤ 1 := by
  rw [re_inv_cauchy_eq (1 + δ) u, div_le_one (by nlinarith [sq_nonneg u])]
  nlinarith [sq_nonneg u]

/-- Explicit finite-height collar depth for `r` zero channels of total multiplicity `M` up to
ordinate `T`, in a system of pole budget `κ` and archimedean degree `d`. -/
def collarDepth (κ d r M : ℕ) (T : ℝ) : ℝ :=
  let K : ℕ := 16 * M
  let E : ℕ := 512 * M ^ 2
  let X_max : ℝ := ((K * r : ℕ) : ℝ) * (max T 1 + 1) + (E : ℝ) + 1
  let G_0 : ℝ := (κ : ℝ) + (d : ℝ) * (Real.log (3 + X_max) / 2 + 1 / 4)
  let ε : ℝ := min 1 (1 / (((K ^ (2 * r) * E : ℕ) : ℝ) * G_0))
  ε / (32 * (M : ℝ))

theorem collarDepth_pos {κ d r M : ℕ} (hd : 1 ≤ d) (hM : 1 ≤ M) (T : ℝ) :
    0 < collarDepth κ d r M T := by
  unfold collarDepth
  dsimp only
  have hK1 : 1 ≤ 16 * M := by omega
  have hE1 : 1 ≤ 512 * M ^ 2 := Nat.mul_pos (by decide) (Nat.pow_pos hM)
  have hKE_pos : (0 : ℝ) < (((16 * M) ^ (2 * r) * (512 * M ^ 2) : ℕ) : ℝ) := by
    exact_mod_cast Nat.mul_pos (Nat.pow_pos hK1) hE1
  have hT1 : 0 ≤ max T 1 + 1 := by linarith [le_max_right T 1]
  have hX_nn : 0 ≤ ((16 * M * r : ℕ) : ℝ) * (max T 1 + 1) + ((512 * M ^ 2 : ℕ) : ℝ) + 1 :=
    add_nonneg (add_nonneg (mul_nonneg (Nat.cast_nonneg _) hT1) (Nat.cast_nonneg _)) zero_le_one
  have hlog_nn :
      0 ≤ Real.log (3 + (((16 * M * r : ℕ) : ℝ) * (max T 1 + 1) + ((512 * M ^ 2 : ℕ) : ℝ) + 1)) :=
    Real.log_nonneg (by linarith [hX_nn])
  have hd_pos : (0 : ℝ) < d := by exact_mod_cast hd
  have harch_pos :
      0 < Real.log (3 + (((16 * M * r : ℕ) : ℝ) * (max T 1 + 1) + ((512 * M ^ 2 : ℕ) : ℝ) + 1)) /
            2 + 1 / 4 := by
    linarith [hlog_nn]
  have hG0_pos :
      0 < (κ : ℝ) + (d : ℝ) *
        (Real.log (3 + (((16 * M * r : ℕ) : ℝ) * (max T 1 + 1) + ((512 * M ^ 2 : ℕ) : ℝ) + 1)) /
          2 + 1 / 4) :=
    add_pos_of_nonneg_of_pos (Nat.cast_nonneg κ) (mul_pos hd_pos harch_pos)
  have hM32_pos : (0 : ℝ) < 32 * (M : ℝ) := mul_pos (by norm_num) (by exact_mod_cast hM)
  exact div_pos (lt_min zero_lt_one (div_pos one_pos (mul_pos hKE_pos hG0_pos))) hM32_pos

/-- Monotonicity of `collarDepth` as the number of distinct zero channels `r` decreases. -/
private theorem collarDepth_anti_r {κ d r₁ r₂ M : ℕ} (hd : 1 ≤ d) (hM : 1 ≤ M)
    (hr : r₁ ≤ r₂) (T : ℝ) :
    collarDepth κ d r₂ M T ≤ collarDepth κ d r₁ M T := by
  unfold collarDepth
  dsimp only
  have hK1 : 1 ≤ 16 * M := by omega
  have hE1 : 1 ≤ 512 * M ^ 2 := Nat.mul_pos (by decide) (Nat.pow_pos hM)
  obtain ⟨X₁, hX₁_eq⟩ : ∃ X₁ : ℝ,
      X₁ = ((16 * M * r₁ : ℕ) : ℝ) * (max T 1 + 1) + ((512 * M ^ 2 : ℕ) : ℝ) + 1 := ⟨_, rfl⟩
  obtain ⟨X₂, hX₂_eq⟩ : ∃ X₂ : ℝ,
      X₂ = ((16 * M * r₂ : ℕ) : ℝ) * (max T 1 + 1) + ((512 * M ^ 2 : ℕ) : ℝ) + 1 := ⟨_, rfl⟩
  rw [← hX₁_eq, ← hX₂_eq]
  have hT_pos : 0 ≤ max T 1 + 1 := by linarith [le_max_right T 1]
  have hX1_nn : 0 ≤ X₁ := by
    rw [hX₁_eq]
    exact add_nonneg (add_nonneg (mul_nonneg (Nat.cast_nonneg _) hT_pos) (Nat.cast_nonneg _))
      zero_le_one
  have hX_le : X₁ ≤ X₂ := by
    rw [hX₁_eq, hX₂_eq]
    have hKr : ((16 * M * r₁ : ℕ) : ℝ) ≤ ((16 * M * r₂ : ℕ) : ℝ) := by
      exact_mod_cast Nat.mul_le_mul_left (16 * M) hr
    have hm := mul_le_mul_of_nonneg_right hKr hT_pos
    linarith [hm]
  obtain ⟨G₁, hG₁_eq⟩ : ∃ G₁ : ℝ, G₁ = (κ : ℝ) + (d : ℝ) * (Real.log (3 + X₁) / 2 + 1 / 4) :=
    ⟨_, rfl⟩
  obtain ⟨G₂, hG₂_eq⟩ : ∃ G₂ : ℝ, G₂ = (κ : ℝ) + (d : ℝ) * (Real.log (3 + X₂) / 2 + 1 / 4) :=
    ⟨_, rfl⟩
  rw [← hG₁_eq, ← hG₂_eq]
  have hd_pos : (0 : ℝ) < d := by exact_mod_cast hd
  have hG1_pos : 0 < G₁ := by
    rw [hG₁_eq]
    have hlog1 : 0 ≤ Real.log (3 + X₁) := Real.log_nonneg (by linarith [hX1_nn])
    have ha : 0 < Real.log (3 + X₁) / 2 + 1 / 4 := by linarith [hlog1]
    exact add_pos_of_nonneg_of_pos (Nat.cast_nonneg κ) (mul_pos hd_pos ha)
  have hG_le : G₁ ≤ G₂ := by
    rw [hG₁_eq, hG₂_eq]
    have hlog_le : Real.log (3 + X₁) ≤ Real.log (3 + X₂) :=
      Real.log_le_log (by linarith [hX1_nn]) (by linarith [hX1_nn, hX_le])
    have hm := mul_le_mul_of_nonneg_left
      (show Real.log (3 + X₁) / 2 + 1 / 4 ≤ Real.log (3 + X₂) / 2 + 1 / 4 by linarith [hlog_le])
      hd_pos.le
    linarith [hm]
  obtain ⟨P₁, hP₁_eq⟩ : ∃ P₁ : ℝ, P₁ = (((16 * M) ^ (2 * r₁) * (512 * M ^ 2) : ℕ) : ℝ) := ⟨_, rfl⟩
  obtain ⟨P₂, hP₂_eq⟩ : ∃ P₂ : ℝ, P₂ = (((16 * M) ^ (2 * r₂) * (512 * M ^ 2) : ℕ) : ℝ) := ⟨_, rfl⟩
  rw [← hP₁_eq, ← hP₂_eq]
  have hpow_le : P₁ ≤ P₂ := by
    rw [hP₁_eq, hP₂_eq]
    exact_mod_cast Nat.mul_le_mul_right (512 * M ^ 2) (Nat.pow_le_pow_right hK1 (by omega))
  have hKE1_pos : 0 < P₁ := by
    rw [hP₁_eq]
    exact_mod_cast Nat.mul_pos (Nat.pow_pos hK1) hE1
  have hden_le : P₁ * G₁ ≤ P₂ * G₂ :=
    mul_le_mul hpow_le hG_le hG1_pos.le (hKE1_pos.le.trans hpow_le)
  have hinv_le : 1 / (P₂ * G₂) ≤ 1 / (P₁ * G₁) :=
    one_div_le_one_div_of_le (mul_pos hKE1_pos hG1_pos) hden_le
  have hmin_le : min 1 (1 / (P₂ * G₂)) ≤ min 1 (1 / (P₁ * G₁)) :=
    min_le_min le_rfl hinv_le
  have hM_nn : (0 : ℝ) ≤ 32 * (M : ℝ) := mul_nonneg (by norm_num) (Nat.cast_nonneg M)
  exact div_le_div_of_nonneg_right hmin_le hM_nn

private def gridPt (δ h : ℝ) (s : ℤ) : ℂ :=
  ((1 + δ : ℝ) : ℂ) + (((s : ℝ) * h : ℝ) : ℂ) * I

private def zeroGridKer (δ h : ℝ) (z : ℂ) (s : ℤ) : ℝ :=
  (1 / (gridPt δ h s - z)).re + (1 / (gridPt δ h s - starRingEnd ℂ z)).re

private def poleGridKer (δ h : ℝ) (s : ℤ) : ℝ :=
  (1 / gridPt δ h s + 1 / (gridPt δ h s - 1)).re

private def archGridKer (δ h : ℝ) (s : ℤ) : ℝ :=
  (logDeriv Complex.Gammaℝ (gridPt δ h s)).re

private def cauchyGridKer (a h b : ℝ) (s : ℤ) : ℝ :=
  a / (a ^ 2 + ((s : ℝ) * h - b) ^ 2)

private def gridChan (h : ℝ) (n : ℕ) (j : Fin n) : ℝ :=
  (j : ℝ) * h

private theorem gridChan_sub (h : ℝ) (n : ℕ) (j i : Fin n) :
    gridChan h n j - gridChan h n i = (((j : ℤ) - (i : ℤ) : ℤ) : ℝ) * h := by
  unfold gridChan
  push_cast
  ring

/-- Opaque scale witness for `collective_half_pole_collar_forcing`, isolating `collarDepth`,
`min`, `max`, `log`, and exponential factor `(16 M)^{2r}` from downstream arithmetic tactics. -/
private theorem exists_collar_scales (κ d r M : ℕ) (T : ℝ)
    (hd : 1 ≤ d) (hM1 : 1 ≤ M) :
    ∃ (L : ℕ) (X_max G_0 ε δ h : ℝ),
      1 ≤ L ∧
      (∀ (Q : ℕ) (q t : ℤ), 0 ≤ q → q ≤ (Q : ℤ) → 1 ≤ r → t.natAbs ≤ L →
        q + t ∈ Finset.Icc (-((1 + 16 * M * r * Q + 512 * M ^ 2 * L : ℕ) : ℤ))
          ((1 + 16 * M * r * Q + 512 * M ^ 2 * L : ℕ) : ℤ)) ∧
      0 ≤ X_max ∧
      G_0 = (κ : ℝ) + (d : ℝ) * (Real.log (3 + X_max) / 2 + 1 / 4) ∧
      0 < G_0 ∧
      0 < ε ∧ ε ≤ 1 ∧
      δ = collarDepth κ d r M T ∧
      0 < δ ∧ δ ≤ 1 / 32 ∧
      2 * δ = ε / (16 * (M : ℝ)) ∧
      0 < h ∧ h ≤ 1 ∧
      (L : ℝ) * h = ε ∧
      h / δ = 1 / (32 * (M : ℝ) * ((κ : ℝ) + 1)) ∧
      (∀ S_R : ℝ, S_R ≤ (((16 * M) ^ (2 * r) * (512 * M ^ 2 * L) : ℕ) : ℝ) →
        (h * S_R) * G_0 ≤ 1) ∧
      ∀ (Q : ℕ), (Q : ℝ) * h ≤ max T 1 + 1 →
        ((1 + 16 * M * r * Q + 512 * M ^ 2 * L : ℕ) : ℝ) * h ≤ X_max := by
  let K : ℕ := 16 * M
  let E : ℕ := 512 * M ^ 2
  let L : ℕ := 1024 * M ^ 2 * (κ + 1)
  have hK1 : 1 ≤ K := by dsimp only [K]; omega
  have hE1 : 1 ≤ E := Nat.mul_pos (by decide) (Nat.pow_pos hM1)
  have hL1 : 1 ≤ L := Nat.mul_pos (Nat.mul_pos (by decide) (Nat.pow_pos hM1)) (Nat.succ_pos κ)
  have hM_pos : (0 : ℝ) < M := by exact_mod_cast hM1
  have hL_pos : (0 : ℝ) < L := by exact_mod_cast hL1
  obtain ⟨X_max, hX_def⟩ : ∃ X_max : ℝ,
      X_max = ((K * r : ℕ) : ℝ) * (max T 1 + 1) + (E : ℝ) + 1 := ⟨_, rfl⟩
  have hT1 : 0 ≤ max T 1 + 1 := by linarith [le_max_right T 1]
  have hX_nn : 0 ≤ X_max := by
    rw [hX_def]
    exact add_nonneg (add_nonneg (mul_nonneg (Nat.cast_nonneg _) hT1) (Nat.cast_nonneg _))
      zero_le_one
  obtain ⟨G_0, hG0_def⟩ : ∃ G_0 : ℝ,
      G_0 = (κ : ℝ) + (d : ℝ) * (Real.log (3 + X_max) / 2 + 1 / 4) := ⟨_, rfl⟩
  have hd_pos : (0 : ℝ) < d := by exact_mod_cast hd
  have hG0_pos : 0 < G_0 := by
    rw [hG0_def]
    have hlog_nn : 0 ≤ Real.log (3 + X_max) := Real.log_nonneg (by linarith [hX_nn])
    have ha : 0 < Real.log (3 + X_max) / 2 + 1 / 4 := by linarith [hlog_nn]
    exact add_pos_of_nonneg_of_pos (Nat.cast_nonneg κ) (mul_pos hd_pos ha)
  obtain ⟨P, hP_def⟩ : ∃ P : ℝ, P = ((K ^ (2 * r) * E : ℕ) : ℝ) := ⟨_, rfl⟩
  have hP_pos : 0 < P := by
    rw [hP_def]; exact_mod_cast Nat.mul_pos (Nat.pow_pos hK1) hE1
  obtain ⟨ε, hε_def⟩ : ∃ ε : ℝ, ε = min 1 (1 / (P * G_0)) := ⟨_, rfl⟩
  have hε_pos : 0 < ε := by
    rw [hε_def]; exact lt_min zero_lt_one (div_pos one_pos (mul_pos hP_pos hG0_pos))
  have hε_le1 : ε ≤ 1 := by rw [hε_def]; exact min_le_left _ _
  have hε_prod_le1 : (P * G_0) * ε ≤ 1 := by
    have hle : ε ≤ 1 / (P * G_0) := by rw [hε_def]; exact min_le_right _ _
    have hpos : 0 < P * G_0 := mul_pos hP_pos hG0_pos
    calc (P * G_0) * ε ≤ (P * G_0) * (1 / (P * G_0)) := mul_le_mul_of_nonneg_left hle hpos.le
      _ = 1 := mul_one_div_cancel hpos.ne'
  obtain ⟨δ, hδ_def⟩ : ∃ δ : ℝ, δ = ε / (32 * (M : ℝ)) := ⟨_, rfl⟩
  have hδ_collar : δ = collarDepth κ d r M T := by
    rw [hδ_def, hε_def, hP_def, hG0_def, hX_def]
    rfl
  have hδ_pos : 0 < δ := by
    rw [hδ_def]; exact div_pos hε_pos (mul_pos (by norm_num) hM_pos)
  have hδ_le_32 : δ ≤ 1 / 32 := by
    rw [hδ_def, div_le_div_iff₀ (mul_pos (by norm_num) hM_pos) (by norm_num)]
    have hM1_r : (1 : ℝ) ≤ M := by exact_mod_cast hM1
    nlinarith [hε_le1, hM1_r]
  have h2δ_eq : 2 * δ = ε / (16 * (M : ℝ)) := by
    rw [hδ_def]
    have hM_ne : (M : ℝ) ≠ 0 := hM_pos.ne'
    field_simp
    ring
  obtain ⟨h, hh_def⟩ : ∃ h : ℝ, h = ε / (L : ℝ) := ⟨_, rfl⟩
  have hh_pos : 0 < h := by rw [hh_def]; exact div_pos hε_pos hL_pos
  have hLh_eq : (L : ℝ) * h = ε := by rw [hh_def]; exact mul_div_cancel₀ ε hL_pos.ne'
  have hh_le1 : h ≤ 1 := by
    rw [hh_def]
    have hL1_r : (1 : ℝ) ≤ L := by exact_mod_cast hL1
    calc ε / (L : ℝ) ≤ 1 / 1 := div_le_div₀ zero_le_one hε_le1 zero_lt_one hL1_r
      _ = 1 := div_one 1
  have hh_div_δ : h / δ = 1 / (32 * (M : ℝ) * ((κ : ℝ) + 1)) := by
    rw [hh_def, hδ_def]
    have hL_cast : (L : ℝ) = 1024 * (M : ℝ) ^ 2 * ((κ : ℝ) + 1) := by
      dsimp only [L]; push_cast; rfl
    rw [hL_cast]
    have hε_ne : ε ≠ 0 := hε_pos.ne'
    have hM_ne : (M : ℝ) ≠ 0 := hM_pos.ne'
    have hκ_ne : (κ : ℝ) + 1 ≠ 0 := by positivity
    field_simp
    ring
  have hbg_bound : ∀ S_R : ℝ, S_R ≤ (((16 * M) ^ (2 * r) * (512 * M ^ 2 * L) : ℕ) : ℝ) →
      (h * S_R) * G_0 ≤ 1 := by
    intro S_R hSR
    have hnat_assoc : (16 * M) ^ (2 * r) * (512 * M ^ 2 * L) = (K ^ (2 * r) * E) * L :=
      (Nat.mul_assoc (K ^ (2 * r)) E L).symm
    rw [hnat_assoc, Nat.cast_mul, ← hP_def] at hSR
    have hhSR : h * S_R ≤ P * ε := by
      calc h * S_R ≤ h * (P * (L : ℝ)) := mul_le_mul_of_nonneg_left hSR hh_pos.le
        _ = P * ((L : ℝ) * h) := by ring
        _ = P * ε := by rw [hLh_eq]
    calc (h * S_R) * G_0 ≤ (P * ε) * G_0 := mul_le_mul_of_nonneg_right hhSR hG0_pos.le
      _ = (P * G_0) * ε := by ring
      _ ≤ 1 := hε_prod_le1
  have hwin_mem : ∀ (Q : ℕ) (q t : ℤ), 0 ≤ q → q ≤ (Q : ℤ) → 1 ≤ r → t.natAbs ≤ L →
      q + t ∈ Finset.Icc (-((1 + 16 * M * r * Q + 512 * M ^ 2 * L : ℕ) : ℤ))
        ((1 + 16 * M * r * Q + 512 * M ^ 2 * L : ℕ) : ℤ) := by
    intro Q q t hq0 hqQ hr1 ht
    rw [Finset.mem_Icc]
    have hKrQ : Q ≤ 16 * M * r * Q :=
      Nat.le_mul_of_pos_left Q (Nat.mul_pos (by omega) hr1)
    have hEL : L ≤ 512 * M ^ 2 * L := Nat.le_mul_of_pos_left L hE1
    omega
  have hspan : ∀ (Q : ℕ), (Q : ℝ) * h ≤ max T 1 + 1 →
      ((1 + 16 * M * r * Q + 512 * M ^ 2 * L : ℕ) : ℝ) * h ≤ X_max := by
    intro Q hQh
    have hNh_le : ((512 * M ^ 2 * L : ℕ) : ℝ) * h ≤ (E : ℝ) := by
      calc ((512 * M ^ 2 * L : ℕ) : ℝ) * h = (E : ℝ) * ((L : ℝ) * h) := by
            dsimp only [E]; push_cast; ring
        _ = (E : ℝ) * ε := by rw [hLh_eq]
        _ ≤ (E : ℝ) * 1 := mul_le_mul_of_nonneg_left hε_le1 (Nat.cast_nonneg E)
        _ = (E : ℝ) := mul_one _
    have hn_cast : ((1 + 16 * M * r * Q + 512 * M ^ 2 * L : ℕ) : ℝ) * h =
        h + ((K * r : ℕ) : ℝ) * ((Q : ℝ) * h) + ((512 * M ^ 2 * L : ℕ) : ℝ) * h := by
      dsimp only [K]; push_cast; ring
    rw [hn_cast, hX_def]
    have hKr_mul : ((K * r : ℕ) : ℝ) * ((Q : ℝ) * h) ≤ ((K * r : ℕ) : ℝ) * (max T 1 + 1) :=
      mul_le_mul_of_nonneg_left hQh (Nat.cast_nonneg _)
    linarith [hh_le1, hKr_mul, hNh_le]
  exact ⟨L, X_max, G_0, ε, δ, h, hL1, hwin_mem, hX_nn, hG0_def, hG0_pos, hε_pos, hε_le1,
    hδ_collar, hδ_pos, hδ_le_32, h2δ_eq, hh_pos, hh_le1, hLh_eq, hh_div_δ, hbg_bound, hspan⟩

/-- Opaque ordinate quantization witness on the `h`-lattice. -/
private theorem exists_quantized_ordinates {r L : ℕ} {T ε h : ℝ}
    (ρ : Fin r → ℂ) (m : Fin r → ℕ)
    (hL1 : 1 ≤ L) (hε_pos : 0 < ε) (hε_le1 : ε ≤ 1) (hh_pos : 0 < h)
    (hLh_eq : (L : ℝ) * h = ε)
    (him_pos : ∀ ℓ, 1 ≤ m ℓ → 0 < (ρ ℓ).im)
    (him_le : ∀ ℓ, 1 ≤ m ℓ → (ρ ℓ).im ≤ T) :
    ∃ (Q : ℕ) (q : Fin r → ℕ),
      (∀ ℓ, q ℓ ≤ Q) ∧
      (Q : ℝ) * h ≤ max T 1 + 1 ∧
      ∀ ℓ, 1 ≤ m ℓ → (q ℓ : ℝ) * h ≤ (ρ ℓ).im ∧ (ρ ℓ).im ≤ (q ℓ : ℝ) * h + h := by
  have hL_pos : (0 : ℝ) < L := by exact_mod_cast hL1
  obtain ⟨T_pos, hT_def⟩ : ∃ T_pos : ℝ, T_pos = max T 1 := ⟨_, rfl⟩
  have hT_pos0 : 0 < T_pos := by rw [hT_def]; linarith [le_max_right T 1]
  let Q : ℕ := (Nat.floor (T_pos / ε) + 1) * L
  let q : Fin r → ℕ := fun ℓ => if 1 ≤ m ℓ then Nat.floor ((ρ ℓ).im / h) else 0
  have hq_le_Q : ∀ ℓ : Fin r, q ℓ ≤ Q := by
    intro ℓ
    dsimp only [q]
    split_ifs with hm1
    · have him0 : 0 < (ρ ℓ).im := him_pos ℓ hm1
      have himT : (ρ ℓ).im ≤ T_pos := by rw [hT_def]; exact (him_le ℓ hm1).trans (le_max_left T 1)
      have hdiv_le : (ρ ℓ).im / h ≤ (Q : ℝ) := by
        have hfl_lt : T_pos / ε < (Nat.floor (T_pos / ε) : ℝ) + 1 :=
          Nat.lt_floor_add_one (T_pos / ε)
        have h1 : (ρ ℓ).im / h ≤ (T_pos / ε) * (L : ℝ) := by
          have hh_eq : h = ε / (L : ℝ) := (eq_div_iff hL_pos.ne').mpr (by linarith [hLh_eq])
          rw [hh_eq, div_div_eq_mul_div, mul_div_right_comm]
          exact mul_le_mul_of_nonneg_right
            (div_le_div_of_nonneg_right himT hε_pos.le) hL_pos.le
        have h2 : (T_pos / ε) * (L : ℝ) ≤ (Q : ℝ) := by
          dsimp only [Q]; push_cast
          exact mul_le_mul_of_nonneg_right hfl_lt.le hL_pos.le
        exact h1.trans h2
      by_contra hgt
      rw [not_le] at hgt
      have hfl_le : (Nat.floor ((ρ ℓ).im / h) : ℝ) ≤ (ρ ℓ).im / h :=
        Nat.floor_le (div_nonneg him0.le hh_pos.le)
      have hQ1 : (Q : ℝ) + 1 ≤ (Nat.floor ((ρ ℓ).im / h) : ℝ) := by exact_mod_cast hgt
      linarith
    · exact Nat.zero_le Q
  have hQh_le : (Q : ℝ) * h ≤ max T 1 + 1 := by
    rw [← hT_def]
    have hfl_le : (Nat.floor (T_pos / ε) : ℝ) ≤ T_pos / ε :=
      Nat.floor_le (div_nonneg hT_pos0.le hε_pos.le)
    calc (Q : ℝ) * h = ((Nat.floor (T_pos / ε) : ℝ) + 1) * ((L : ℝ) * h) := by
          dsimp only [Q]; push_cast; ring
      _ = ((Nat.floor (T_pos / ε) : ℝ) + 1) * ε := by rw [hLh_eq]
      _ ≤ (T_pos / ε + 1) * ε := mul_le_mul_of_nonneg_right (by linarith) hε_pos.le
      _ = T_pos + ε := by rw [add_mul, div_mul_cancel₀ _ hε_pos.ne', one_mul]
      _ ≤ T_pos + 1 := by linarith
  refine ⟨Q, q, hq_le_Q, hQh_le, fun ℓ hm1 => ?_⟩
  have hq_def : q ℓ = Nat.floor ((ρ ℓ).im / h) := by simp [q, hm1]
  rw [hq_def]
  refine ⟨?_, ?_⟩
  · have hfl := Nat.floor_le (div_nonneg (him_pos ℓ hm1).le hh_pos.le)
    exact (le_div_iff₀ hh_pos).mp hfl
  · have hlt := (div_lt_iff₀ hh_pos).mp (Nat.lt_floor_add_one ((ρ ℓ).im / h))
    linarith

private theorem collar_rhs_bound {κ d M n : ℕ} {X_max G_0 δ h : ℝ} {R : ℤ → ℝ}
    (hM1 : 1 ≤ M) (hδ_pos : 0 < δ) (hδ_le_32 : δ ≤ 1 / 32) (hh_pos : 0 < h)
    (hnh_le : (n : ℝ) * h ≤ X_max)
    (hG0_def : G_0 = (κ : ℝ) + (d : ℝ) * (Real.log (3 + X_max) / 2 + 1 / 4))
    (hh_div_δ : h / δ = 1 / (32 * (M : ℝ) * ((κ : ℝ) + 1)))
    (hR_bounds : ∀ s : ℤ, 0 ≤ R s ∧ R s ≤ 1)
    (hbg_le1 : (h * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s) * G_0 ≤ 1) :
    (κ : ℝ) * (h * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * poleGridKer δ h s) +
      (d : ℝ) * (h * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * archGridKer δ h s) ≤
    (κ : ℝ) * Real.pi + 33 / 32 := by
  have hM_pos : (0 : ℝ) < M := by exact_mod_cast hM1
  have hpole_pt : ∀ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ),
      R s * poleGridKer δ h s ≤ R s + δ / (δ ^ 2 + ((s : ℝ) * h) ^ 2) := by
    intro s _
    obtain ⟨hR0, hR1⟩ := hR_bounds s
    unfold poleGridKer gridPt
    rw [Complex.add_re]
    have h1 : (1 / (((1 + δ : ℝ) : ℂ) + (((s : ℝ) * h : ℝ) : ℂ) * I)).re ≤ 1 :=
      re_one_div_le_one' hδ_pos
    have hz_sub : ((1 + δ : ℝ) : ℂ) + (((s : ℝ) * h : ℝ) : ℂ) * I - 1 =
        (δ : ℂ) + (((s : ℝ) * h : ℝ) : ℂ) * I := by push_cast; ring
    rw [hz_sub, re_inv_cauchy_eq δ ((s : ℝ) * h)]
    have hcauchy_nn : 0 ≤ δ / (δ ^ 2 + ((s : ℝ) * h) ^ 2) :=
      div_nonneg hδ_pos.le (add_nonneg (sq_nonneg _) (sq_nonneg _))
    nlinarith [hR0, hR1, h1, hcauchy_nn]
  have harch_pt : ∀ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ),
      R s * archGridKer δ h s ≤ R s * (Real.log (3 + X_max) / 2 + 1 / 4) := by
    intro s hs
    obtain ⟨hR0, _⟩ := hR_bounds s
    unfold archGridKer gridPt
    have hgam := re_logDeriv_Gammaℝ_le_all_heights (σ := 1 + δ) (t := (s : ℝ) * h)
      (by linarith [hδ_pos]) (by linarith [hδ_le_32])
    rw [Finset.mem_Icc] at hs
    have habs_s : |(s : ℝ)| ≤ (n : ℝ) := by
      rw [abs_le]
      exact ⟨by exact_mod_cast hs.1, by exact_mod_cast hs.2⟩
    have habs_t : |(s : ℝ) * h| ≤ X_max := by
      rw [abs_mul, abs_of_pos hh_pos]
      exact (mul_le_mul_of_nonneg_right habs_s hh_pos.le).trans hnh_le
    have hlog_le : Real.log (3 + |(s : ℝ) * h|) ≤ Real.log (3 + X_max) :=
      Real.log_le_log (by positivity) (by linarith [habs_t])
    exact mul_le_mul_of_nonneg_left (by linarith [hgam, hlog_le]) hR0
  have hpole_sum : h * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * poleGridKer δ h s ≤
      h * (∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s) + (h / δ + Real.pi) := by
    have hsum_le := Finset.sum_le_sum hpole_pt
    rw [Finset.sum_add_distrib] at hsum_le
    have hmul_le := mul_le_mul_of_nonneg_left hsum_le hh_pos.le
    rw [mul_add] at hmul_le
    linarith [hmul_le, cauchy_pole_int_sum_le δ h hδ_pos hh_pos n]
  have harch_sum : h * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * archGridKer δ h s ≤
      (h * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s) *
        (Real.log (3 + X_max) / 2 + 1 / 4) := by
    have hsum_le := Finset.sum_le_sum harch_pt
    rw [← Finset.sum_mul] at hsum_le
    have hmul_le := mul_le_mul_of_nonneg_left hsum_le hh_pos.le
    rwa [← mul_assoc] at hmul_le
  have hκ_hd_le : (κ : ℝ) * (h / δ) ≤ 1 / 32 := by
    rw [hh_div_δ]
    have h1 : (κ : ℝ) ≤ (κ : ℝ) + 1 := by linarith
    have hM1_r : (1 : ℝ) ≤ M := by exact_mod_cast hM1
    have hκ_pos : (0 : ℝ) < (κ : ℝ) + 1 := by positivity
    calc (κ : ℝ) * (1 / (32 * (M : ℝ) * ((κ : ℝ) + 1)))
        ≤ ((κ : ℝ) + 1) * (1 / (32 * (M : ℝ) * ((κ : ℝ) + 1))) :=
          mul_le_mul_of_nonneg_right h1 (by positivity)
      _ = 1 / (32 * (M : ℝ)) := by
          have hM_ne : (M : ℝ) ≠ 0 := hM_pos.ne'
          have hκ_ne : (κ : ℝ) + 1 ≠ 0 := hκ_pos.ne'
          field_simp
      _ ≤ 1 / 32 := by
          rw [div_le_div_iff₀ (by positivity) (by norm_num)]
          linarith
  have hκ_nn : (0 : ℝ) ≤ κ := Nat.cast_nonneg κ
  have hd_nn : (0 : ℝ) ≤ d := Nat.cast_nonneg d
  have hcomb1 := mul_le_mul_of_nonneg_left hpole_sum hκ_nn
  have hcomb2 := mul_le_mul_of_nonneg_left harch_sum hd_nn
  have hG0_ident : (κ : ℝ) * (h * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s) +
      (d : ℝ) * ((h * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s) *
        (Real.log (3 + X_max) / 2 + 1 / 4)) =
      (h * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s) * G_0 := by
    rw [hG0_def]; ring
  linarith [hcomb1, hcomb2, hG0_ident, hbg_le1, hκ_hd_le]

private theorem collar_zero_channel_ge {κ M L n q : ℕ} {ε δ h : ℝ} {z : ℂ} {R : ℤ → ℝ}
    (hM1 : 1 ≤ M) (hδ_pos : 0 < δ) (h2δ_eq : 2 * δ = ε / (16 * (M : ℝ)))
    (hh_pos : 0 < h) (hLh_eq : (L : ℝ) * h = ε)
    (hh_div_δ : h / δ = 1 / (32 * (M : ℝ) * ((κ : ℝ) + 1)))
    (hR_even : ∀ s : ℤ, R (-s) = R s)
    (hR_bounds : ∀ s : ℤ, 0 ≤ R s ∧ R s ≤ 1)
    (hwin_sub : ∀ t ∈ Finset.Icc (-(L : ℤ)) (L : ℤ),
      (q : ℤ) + t ∈ Finset.Icc (-(n : ℤ)) (n : ℤ))
    (hR_win : ∀ t : ℤ, t.natAbs ≤ L → 1 - 1 / (8 * (M : ℝ)) ≤ R ((q : ℤ) + t))
    (hz_le1 : z.re ≤ 1) (hz_gt : 1 - δ < z.re)
    (hq_lo : (q : ℝ) * h ≤ z.im) (hq_hi : z.im ≤ (q : ℝ) * h + h) :
    2 * (1 - 1 / (8 * (M : ℝ))) * (Real.pi - 3 / (16 * (M : ℝ))) ≤
      h * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * zeroGridKer δ h z s := by
  have hM_pos : (0 : ℝ) < M := by exact_mod_cast hM1
  obtain ⟨a, ha_def⟩ : ∃ a : ℝ, a = 1 + δ - z.re := ⟨_, rfl⟩
  have ha_lo : δ ≤ a := by rw [ha_def]; linarith [hz_le1]
  have ha_hi : a < 2 * δ := by rw [ha_def]; linarith [hz_gt]
  have ha_pos : 0 < a := lt_of_lt_of_le hδ_pos ha_lo
  have hker_split : ∀ s : ℤ,
      zeroGridKer δ h z s =
        cauchyGridKer a h z.im s + cauchyGridKer a h (-z.im) s := by
    intro s
    unfold zeroGridKer gridPt cauchyGridKer
    have e1 : ((1 + δ : ℝ) : ℂ) + (((s : ℝ) * h : ℝ) : ℂ) * I - z =
        (a : ℂ) + ((((s : ℝ) * h - z.im : ℝ)) : ℂ) * I := by
      rw [ha_def]; apply Complex.ext <;> simp
    have e2 : ((1 + δ : ℝ) : ℂ) + (((s : ℝ) * h : ℝ) : ℂ) * I - starRingEnd ℂ z =
        (a : ℂ) + ((((s : ℝ) * h - -z.im : ℝ)) : ℂ) * I := by
      rw [ha_def]; apply Complex.ext <;> simp
    rw [e1, e2, re_inv_cauchy_eq a ((s : ℝ) * h - z.im),
        re_inv_cauchy_eq a ((s : ℝ) * h - -z.im)]
  have hminus_eq_plus :
      ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * cauchyGridKer a h (-z.im) s =
        ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * cauchyGridKer a h z.im s := by
    rw [← sum_Icc_int_neg n (fun s => R s * cauchyGridKer a h (-z.im) s)]
    refine Finset.sum_congr rfl fun s _ => ?_
    rw [hR_even s]
    congr 1
    unfold cauchyGridKer
    congr 2
    push_cast
    ring
  have hsum_two : ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * zeroGridKer δ h z s =
      2 * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * cauchyGridKer a h z.im s := by
    simp_rw [hker_split, mul_add]
    rw [Finset.sum_add_distrib, hminus_eq_plus]
    ring
  have hker_nn : ∀ s : ℤ, 0 ≤ cauchyGridKer a h z.im s := fun s =>
    div_nonneg ha_pos.le (add_nonneg (sq_nonneg _) (sq_nonneg _))
  have hsub_sum : ∑ t ∈ Finset.Icc (-(L : ℤ)) (L : ℤ),
        R ((q : ℤ) + t) * cauchyGridKer a h z.im ((q : ℤ) + t) ≤
      ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * cauchyGridKer a h z.im s :=
    sum_comp_le_sum_of_injOn (fun t : ℤ => (q : ℤ) + t)
      (fun s : ℤ => R s * cauchyGridKer a h z.im s)
      hwin_sub (fun t₁ _ t₂ _ heq => by dsimp only at heq; omega)
      (fun s _ => mul_nonneg (hR_bounds s).1 (hker_nn s))
  have hR_win_pt : ∀ t ∈ Finset.Icc (-(L : ℤ)) (L : ℤ),
      (1 - 1 / (8 * (M : ℝ))) * cauchyGridKer a h z.im ((q : ℤ) + t) ≤
        R ((q : ℤ) + t) * cauchyGridKer a h z.im ((q : ℤ) + t) := by
    intro t ht
    rw [Finset.mem_Icc] at ht
    have ht_abs : t.natAbs ≤ L := by omega
    exact mul_le_mul_of_nonneg_right (hR_win t ht_abs) (hker_nn _)
  have hcauchy_ge : 2 * (Real.arctan (((L : ℝ) * h) / a) - h / a) ≤
      h * ∑ t ∈ Finset.Icc (-(L : ℤ)) (L : ℤ), cauchyGridKer a h z.im ((q : ℤ) + t) :=
    cauchy_shifted_int_sum_ge a h z.im ha_pos hh_pos q L hq_lo hq_hi
  have hε_div_a : 16 * (M : ℝ) ≤ ((L : ℝ) * h) / a := by
    rw [hLh_eq]
    have ha_lt : a ≤ ε / (16 * (M : ℝ)) := by linarith [ha_hi, h2δ_eq]
    rw [le_div_iff₀ ha_pos]
    have hmul := (le_div_iff₀ (by positivity : (0 : ℝ) < 16 * (M : ℝ))).mp ha_lt
    linarith
  have hatan_ge : Real.pi / 2 - 1 / (16 * (M : ℝ)) ≤ Real.arctan (((L : ℝ) * h) / a) :=
    (pi_div_two_sub_inv_le_arctan (16 * (M : ℝ)) (by positivity)).trans
      (Real.arctan_mono hε_div_a)
  have hha_le : h / a ≤ 1 / (32 * (M : ℝ)) := by
    have h1 : h / a ≤ h / δ := div_le_div_of_nonneg_left hh_pos.le hδ_pos ha_lo
    rw [hh_div_δ] at h1
    refine h1.trans ?_
    rw [div_le_div_iff₀ (by positivity) (by positivity)]
    have hκ_ge1 : (1 : ℝ) ≤ (κ : ℝ) + 1 := by linarith [Nat.cast_nonneg (α := ℝ) κ]
    nlinarith [hM_pos, hκ_ge1]
  have hwin_lower : Real.pi - 3 / (16 * (M : ℝ)) ≤
      h * ∑ t ∈ Finset.Icc (-(L : ℤ)) (L : ℤ), cauchyGridKer a h z.im ((q : ℤ) + t) := by
    have h3 : 2 * (Real.pi / 2 - 1 / (16 * (M : ℝ)) - 1 / (32 * (M : ℝ))) =
        Real.pi - 3 / (16 * (M : ℝ)) := by
      have hM_ne : (M : ℝ) ≠ 0 := hM_pos.ne'
      field_simp
      ring
    linarith [hcauchy_ge, hatan_ge, hha_le, h3]
  have hfac_nn : 0 ≤ 1 - 1 / (8 * (M : ℝ)) := by
    have hM1_r : (1 : ℝ) ≤ M := by exact_mod_cast hM1
    have h8 : 1 / (8 * (M : ℝ)) ≤ 1 / 8 := by
      rw [div_le_div_iff₀ (by positivity) (by norm_num)]; linarith [hM1_r]
    linarith [h8]
  have hplus_ge : (1 - 1 / (8 * (M : ℝ))) * (Real.pi - 3 / (16 * (M : ℝ))) ≤
      h * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * cauchyGridKer a h z.im s := by
    calc (1 - 1 / (8 * (M : ℝ))) * (Real.pi - 3 / (16 * (M : ℝ)))
        ≤ (1 - 1 / (8 * (M : ℝ))) *
            (h * ∑ t ∈ Finset.Icc (-(L : ℤ)) (L : ℤ),
              cauchyGridKer a h z.im ((q : ℤ) + t)) :=
          mul_le_mul_of_nonneg_left hwin_lower hfac_nn
      _ = h * ∑ t ∈ Finset.Icc (-(L : ℤ)) (L : ℤ),
            (1 - 1 / (8 * (M : ℝ))) * cauchyGridKer a h z.im ((q : ℤ) + t) := by
          rw [← Finset.mul_sum]; ring
      _ ≤ h * ∑ t ∈ Finset.Icc (-(L : ℤ)) (L : ℤ),
            R ((q : ℤ) + t) * cauchyGridKer a h z.im ((q : ℤ) + t) :=
          mul_le_mul_of_nonneg_left (Finset.sum_le_sum hR_win_pt) hh_pos.le
      _ ≤ h * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * cauchyGridKer a h z.im s :=
          mul_le_mul_of_nonneg_left hsub_sum hh_pos.le
  rw [hsum_two]
  linarith [hplus_ge]

/-- **Quantitative finite-height half-pole collar forcing.**
For any `CompletedPositiveSystem κ d F Λ`, any injective tuple `ρ : Fin r → ℂ` of upper-half-plane
points up to height `T`, and integer multiplicities `m ℓ ≤ ord_{ρ_ℓ}(Λ)` satisfying
`κ < 2 * ∑ ℓ, m ℓ`, at least one `ℓ` with `1 ≤ m ℓ` is forced to interior depth
`Re ρ_ℓ ≤ 1 − collarDepth κ d r (∑ ℓ, m ℓ) T`. Requires **no** ordinate separation or low-height
cutoff. -/
theorem collective_half_pole_collar_forcing {κ d : ℕ} {F Λ : ℂ → ℂ}
    (hS : CompletedPositiveSystem κ d F Λ) {r : ℕ} (ρ : Fin r → ℂ) (m : Fin r → ℕ) {T : ℝ}
    (hinj : Function.Injective ρ)
    (him_pos : ∀ ℓ, 1 ≤ m ℓ → 0 < (ρ ℓ).im)
    (him_le : ∀ ℓ, 1 ≤ m ℓ → (ρ ℓ).im ≤ T)
    (hm : ∀ ℓ, m ℓ ≤ (analyticOrderAt Λ (ρ ℓ)).toNat)
    (hbudget : κ < 2 * ∑ ℓ, m ℓ) :
    ∃ ℓ : Fin r, 1 ≤ m ℓ ∧ (ρ ℓ).re ≤ 1 - collarDepth κ d r (∑ ℓ, m ℓ) T := by
  by_contra hall
  push Not at hall
  obtain ⟨M, hM_eq, hM1⟩ : ∃ M : ℕ, M = ∑ ℓ, m ℓ ∧ 1 ≤ M := ⟨∑ ℓ, m ℓ, rfl, by omega⟩
  have hr1 : 1 ≤ r := by
    rcases eq_or_ne r 0 with rfl | hr0
    · simp at hbudget
    · exact Nat.pos_of_ne_zero hr0
  have hM_pos : (0 : ℝ) < M := by exact_mod_cast hM1
  have h2M_ge : (κ : ℝ) + 1 ≤ 2 * (M : ℝ) := by
    have : κ + 1 ≤ 2 * M := by omega
    exact_mod_cast this
  obtain ⟨L, X_max, G_0, ε, δ, h, hL1, hwin_mem, _, hG0_def, _, hε_pos, hε_le1,
    hδ_eq, hδ_pos, hδ_le_32, h2δ_eq, hh_pos, _, hLh_eq, hh_div_δ, hbg_bound, hspan⟩ :=
    exists_collar_scales κ d r M T hS.degree_pos hM1
  have hall_δ : ∀ ℓ : Fin r, 1 ≤ m ℓ → 1 - δ < (ρ ℓ).re := by
    intro ℓ hm1
    have hgt := hall ℓ hm1
    rwa [← hM_eq, ← hδ_eq] at hgt
  have hre_half : ∀ ℓ : Fin r, 1 ≤ m ℓ → 1 / 2 < (ρ ℓ).re := by
    intro ℓ hm1
    have hgt := hall_δ ℓ hm1
    linarith [hδ_le_32]
  obtain ⟨Q, q, hq_le_Q, hQh_le, hq_bounds⟩ :=
    exists_quantized_ordinates ρ m hL1 hε_pos hε_le1 hh_pos hLh_eq him_pos him_le
  obtain ⟨n, S2, c, R, hn_eq, hc_nn, hS2_pos, hR_even, hR_bounds, hR_sum, hR_win, hdiag⟩ :=
    exists_smoothed_box_config hM1 hL1 q hq_le_Q
  have hnh_le : (n : ℝ) * h ≤ X_max := by
    rw [hn_eq]
    exact hspan Q hQh_le
  have hcoupled :=
    coupled_right_half_pole_zero_forcing hS ρ m hinj him_pos hre_half hm (gridChan h n) c hc_nn
      hδ_pos
  have hrow_zero : ∀ ℓ : Fin r,
      ∑ j : Fin n, ∑ i : Fin n, c j * c i *
        ((1 / (((1 + δ : ℝ) : ℂ) + ((gridChan h n j - gridChan h n i : ℝ) : ℂ) * I - ρ ℓ)).re +
          (1 / (((1 + δ : ℝ) : ℂ) + ((gridChan h n j - gridChan h n i : ℝ) : ℂ) * I -
            starRingEnd ℂ (ρ ℓ))).re) =
      S2 * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * zeroGridKer δ h (ρ ℓ) s := by
    intro ℓ
    simp_rw [gridChan_sub]
    exact hdiag (zeroGridKer δ h (ρ ℓ))
  have hlhs_diag : (∑ ℓ, (m ℓ : ℝ) * ∑ j, ∑ i, c j * c i *
        ((1 / (((1 + δ : ℝ) : ℂ) + ((gridChan h n j - gridChan h n i : ℝ) : ℂ) * I - ρ ℓ)).re +
          (1 / (((1 + δ : ℝ) : ℂ) + ((gridChan h n j - gridChan h n i : ℝ) : ℂ) * I -
            starRingEnd ℂ (ρ ℓ))).re)) =
      S2 * ∑ ℓ, (m ℓ : ℝ) * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * zeroGridKer δ h (ρ ℓ) s := by
    simp_rw [hrow_zero]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun ℓ _ => by ring
  have hrhs_pole_diag : ∑ j : Fin n, ∑ i : Fin n, c j * c i *
        (1 / (((1 + δ : ℝ) : ℂ) + ((gridChan h n j - gridChan h n i : ℝ) : ℂ) * I) +
          1 / (((1 + δ : ℝ) : ℂ) + ((gridChan h n j - gridChan h n i : ℝ) : ℂ) * I - 1)).re =
      S2 * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * poleGridKer δ h s := by
    simp_rw [gridChan_sub]
    exact hdiag (poleGridKer δ h)
  have hrhs_arch_diag : ∑ j : Fin n, ∑ i : Fin n, c j * c i *
        (logDeriv Complex.Gammaℝ (((1 + δ : ℝ) : ℂ) +
          ((gridChan h n j - gridChan h n i : ℝ) : ℂ) * I)).re =
      S2 * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * archGridKer δ h s := by
    simp_rw [gridChan_sub]
    exact hdiag (archGridKer δ h)
  rw [hlhs_diag, hrhs_pole_diag, hrhs_arch_diag] at hcoupled
  have hreduced : h * (∑ ℓ, (m ℓ : ℝ) *
        ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * zeroGridKer δ h (ρ ℓ) s) ≤
      (κ : ℝ) * (h * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * poleGridKer δ h s) +
        (d : ℝ) * (h * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * archGridKer δ h s) := by
    have hdiv_S2 : ∑ ℓ, (m ℓ : ℝ) *
          ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * zeroGridKer δ h (ρ ℓ) s ≤
        (κ : ℝ) * (∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * poleGridKer δ h s) +
          (d : ℝ) * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * archGridKer δ h s := by
      nlinarith [hcoupled, hS2_pos]
    nlinarith [hdiv_S2, hh_pos]
  have hrhs_bound :=
    collar_rhs_bound hM1 hδ_pos hδ_le_32 hh_pos hnh_le hG0_def hh_div_δ hR_bounds
      (hbg_bound _ hR_sum)
  have hzero_unit : ∀ ℓ : Fin r,
      (m ℓ : ℝ) * (2 * (1 - 1 / (8 * (M : ℝ))) * (Real.pi - 3 / (16 * (M : ℝ)))) ≤
        (m ℓ : ℝ) * (h * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * zeroGridKer δ h (ρ ℓ) s) := by
    intro ℓ
    rcases eq_or_ne (m ℓ) 0 with hm0 | hm0
    · simp [hm0]
    have hm1 : 1 ≤ m ℓ := Nat.pos_of_ne_zero hm0
    refine mul_le_mul_of_nonneg_left ?_ (Nat.cast_nonneg _)
    have hρ_zero : Λ (ρ ℓ) = 0 := hS.eq_zero_of_one_le_order_toNat (hm1.trans (hm ℓ))
    obtain ⟨_, hρ_le1⟩ := hS.zero_re_mem_Icc hρ_zero
    obtain ⟨hq_lo, hq_hi⟩ := hq_bounds ℓ hm1
    have hwin_sub : ∀ t ∈ Finset.Icc (-(L : ℤ)) (L : ℤ),
        (q ℓ : ℤ) + t ∈ Finset.Icc (-(n : ℤ)) (n : ℤ) := by
      intro t ht
      rw [Finset.mem_Icc] at ht
      rw [hn_eq]
      exact hwin_mem Q (q ℓ : ℤ) t (Nat.cast_nonneg _) (by exact_mod_cast hq_le_Q ℓ) hr1 (by omega)
    exact collar_zero_channel_ge hM1 hδ_pos h2δ_eq hh_pos hLh_eq hh_div_δ hR_even hR_bounds
      hwin_sub (hR_win ℓ) hρ_le1 (hall_δ ℓ hm1) hq_lo hq_hi
  have hlhs_lower :
      (M : ℝ) * (2 * (1 - 1 / (8 * (M : ℝ))) * (Real.pi - 3 / (16 * (M : ℝ)))) ≤
        h * ∑ ℓ, (m ℓ : ℝ) * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ),
          R s * zeroGridKer δ h (ρ ℓ) s := by
    have hsum_ℓ := Finset.sum_le_sum fun ℓ (_ : ℓ ∈ Finset.univ) => hzero_unit ℓ
    rw [← Finset.sum_mul] at hsum_ℓ
    have hM_cast : (∑ ℓ : Fin r, (m ℓ : ℝ)) = (M : ℝ) := by
      rw [hM_eq]; push_cast; rfl
    rw [hM_cast] at hsum_ℓ
    have hrw : (∑ ℓ : Fin r, (m ℓ : ℝ) *
          (h * ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * zeroGridKer δ h (ρ ℓ) s)) =
        h * ∑ ℓ : Fin r, (m ℓ : ℝ) *
          ∑ s ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), R s * zeroGridKer δ h (ρ ℓ) s := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun ℓ _ => by ring
    linarith [hsum_ℓ, hrw]
  have hprod_expand :
      (M : ℝ) * (2 * (1 - 1 / (8 * (M : ℝ))) * (Real.pi - 3 / (16 * (M : ℝ)))) =
        2 * (M : ℝ) * Real.pi - Real.pi / 4 - 3 / 8 + 3 / (64 * (M : ℝ)) := by
    have hM_ne : (M : ℝ) ≠ 0 := hM_pos.ne'
    field_simp
    ring
  have h3_pos : (0 : ℝ) < 3 / (64 * (M : ℝ)) := by positivity
  have h2M_pi : ((κ : ℝ) + 1) * Real.pi ≤ 2 * (M : ℝ) * Real.pi :=
    mul_le_mul_of_nonneg_right h2M_ge Real.pi_pos.le
  linarith [hreduced, hrhs_bound, hlhs_lower, hprod_expand, h3_pos, h2M_pi, Real.pi_gt_three]

/-! ### 5. Greedy multiplicity extraction and sharp `⌊κ / 2⌋` finite-height collar sparsity -/

private theorem exists_subset_and_mult_sum_eq (Z : Finset ℂ) (ord : ℂ → ℕ) :
    ∀ {B : ℕ}, B ≤ ∑ z ∈ Z, ord z →
      ∃ (Z₀ : Finset ℂ) (m : ℂ → ℕ),
        Z₀ ⊆ Z ∧ Z₀.card ≤ B ∧ (∀ z ∈ Z₀, 1 ≤ m z ∧ m z ≤ ord z) ∧ ∑ z ∈ Z₀, m z = B := by
  classical
  induction Z using Finset.induction_on with
  | empty =>
    intro B hB
    simp only [Finset.sum_empty, Nat.le_zero] at hB
    subst hB
    exact ⟨∅, fun _ => 0, Finset.Subset.refl _, le_rfl, fun _ h => absurd h (Finset.notMem_empty _),
      Finset.sum_empty⟩
  | @insert a s ha ih =>
    intro B hB
    rw [Finset.sum_insert ha] at hB
    rcases le_or_gt B (∑ z ∈ s, ord z) with hle_s | hgt_s
    · obtain ⟨Z₀, m, hsub, hcard, hm, hsum⟩ := ih hle_s
      exact ⟨Z₀, m, hsub.trans (Finset.subset_insert a s), hcard, hm, hsum⟩
    · obtain ⟨Z₁, m₁, hsub₁, hcard₁, hm₁, hsum₁⟩ := ih (le_refl (∑ z ∈ s, ord z))
      have ha_not : a ∉ Z₁ := fun hmem => ha (hsub₁ hmem)
      let m : ℂ → ℕ := Function.update m₁ a (B - ∑ z ∈ s, ord z)
      refine ⟨insert a Z₁, m, Finset.insert_subset_insert a hsub₁, ?_, ?_, ?_⟩
      · rw [Finset.card_insert_of_notMem ha_not]
        omega
      · intro z hz
        rcases Finset.mem_insert.mp hz with rfl | hz₁
        · simp only [m, Function.update_self]
          omega
        · have hne : z ≠ a := fun h => ha_not (h ▸ hz₁)
          simp only [m, Function.update_of_ne hne]
          exact hm₁ z hz₁
      · rw [Finset.sum_insert ha_not]
        have hcongr : ∑ z ∈ Z₁, m z = ∑ z ∈ Z₁, m₁ z :=
          Finset.sum_congr rfl fun z hz => by
            have hne : z ≠ a := fun h => ha_not (h ▸ hz)
            simp [m, Function.update_of_ne hne]
        simp only [m, Function.update_self, hcongr, hsum₁]
        omega

/-- **Canonical sharp half-pole collar width** up to height `T` for pole budget `κ` and archimedean
degree `d`, independent of the zero configuration `Z`. -/
def sharpCollarWidth (κ d : ℕ) (T : ℝ) : ℝ :=
  collarDepth κ d (κ / 2 + 1) (κ / 2 + 1) T

theorem sharpCollarWidth_pos {κ d : ℕ} (hd : 1 ≤ d) (T : ℝ) :
    0 < sharpCollarWidth κ d T :=
  collarDepth_pos hd (Nat.succ_pos _) T

/-- Explicit `κ`-only constant in the `≍_κ 1 / (d log(3 + max T 0))` lower bound for
`sharpCollarWidth κ d T`. -/
def sharpCollarConst (κ : ℕ) : ℝ :=
  let M₀ : ℕ := κ / 2 + 1
  let K₀ : ℕ := 16 * M₀
  let E₀ : ℕ := 512 * M₀ ^ 2
  let C_box : ℝ := ((K₀ ^ (2 * M₀) * E₀ : ℕ) : ℝ)
  let B_arch : ℝ := (κ : ℝ) + Real.log (560 * (M₀ : ℝ) ^ 2) + 1
  min 1 (1 / (C_box * B_arch)) / (32 * (M₀ : ℝ))

theorem sharpCollarConst_pos (κ : ℕ) : 0 < sharpCollarConst κ := by
  unfold sharpCollarConst
  dsimp only
  obtain ⟨M₀, hM0_eq, hM0⟩ : ∃ M₀ : ℕ, M₀ = κ / 2 + 1 ∧ 1 ≤ M₀ := ⟨κ / 2 + 1, rfl, Nat.succ_pos _⟩
  rw [← hM0_eq]
  have hK0 : 1 ≤ 16 * M₀ := by omega
  have hE0 : 1 ≤ 512 * M₀ ^ 2 := Nat.mul_pos (by decide) (Nat.pow_pos hM0)
  obtain ⟨C_box, hC_eq⟩ : ∃ C_box : ℝ,
      C_box = (((16 * M₀) ^ (2 * M₀) * (512 * M₀ ^ 2) : ℕ) : ℝ) := ⟨_, rfl⟩
  rw [← hC_eq]
  have hC_pos : 0 < C_box := by
    rw [hC_eq]; exact_mod_cast Nat.mul_pos (Nat.pow_pos hK0) hE0
  have hM0_r : (1 : ℝ) ≤ M₀ := by exact_mod_cast hM0
  have h560 : (1 : ℝ) ≤ 560 * (M₀ : ℝ) ^ 2 := by nlinarith [hM0_r]
  have hlog_nn : 0 ≤ Real.log (560 * (M₀ : ℝ) ^ 2) := Real.log_nonneg h560
  have hB_pos : 0 < (κ : ℝ) + Real.log (560 * (M₀ : ℝ) ^ 2) + 1 := by
    linarith [Nat.cast_nonneg (α := ℝ) κ, hlog_nn]
  have hM32_pos : (0 : ℝ) < 32 * (M₀ : ℝ) := mul_pos (by norm_num) (by linarith [hM0_r])
  exact div_pos (lt_min zero_lt_one (div_pos one_pos (mul_pos hC_pos hB_pos))) hM32_pos

private theorem sharpCollarWidth_ge_aux {κ d M₀ : ℕ} {C_box : ℝ}
    (hd : 1 ≤ d) (hM0 : 1 ≤ M₀) (hC_pos : 0 < C_box) (T : ℝ) :
    (min 1 (1 / (C_box * ((κ : ℝ) + Real.log (560 * (M₀ : ℝ) ^ 2) + 1))) /
        (32 * (M₀ : ℝ))) /
      ((d : ℝ) * Real.log (3 + max T 0)) ≤
    min 1 (1 / (C_box * ((κ : ℝ) + (d : ℝ) *
      (Real.log (3 + (((16 * M₀ * M₀ : ℕ) : ℝ) * (max T 1 + 1) +
        ((512 * M₀ ^ 2 : ℕ) : ℝ) + 1)) / 2 + 1 / 4)))) /
      (32 * (M₀ : ℝ)) := by
  have hM0_r : (1 : ℝ) ≤ M₀ := by exact_mod_cast hM0
  have hd_r : (1 : ℝ) ≤ d := by exact_mod_cast hd
  obtain ⟨B_arch, hB_eq⟩ : ∃ B_arch : ℝ,
      B_arch = (κ : ℝ) + Real.log (560 * (M₀ : ℝ) ^ 2) + 1 := ⟨_, rfl⟩
  obtain ⟨X_max, hX_eq⟩ : ∃ X_max : ℝ,
      X_max = ((16 * M₀ * M₀ : ℕ) : ℝ) * (max T 1 + 1) + ((512 * M₀ ^ 2 : ℕ) : ℝ) + 1 :=
    ⟨_, rfl⟩
  obtain ⟨G_0, hG_eq⟩ : ∃ G_0 : ℝ,
      G_0 = (κ : ℝ) + (d : ℝ) * (Real.log (3 + X_max) / 2 + 1 / 4) := ⟨_, rfl⟩
  obtain ⟨L_T, hL_eq⟩ : ∃ L_T : ℝ, L_T = Real.log (3 + max T 0) := ⟨_, rfl⟩
  rw [← hB_eq, ← hX_eq, ← hG_eq, ← hL_eq]
  -- `1 ≤ log(3 + max T 0)` since `e < 3 ≤ 3 + max T 0`.
  have hLT_ge1 : 1 ≤ L_T := by
    rw [hL_eq]
    have hexp1 : Real.exp 1 ≤ 3 + max T 0 := by
      linarith [Real.exp_one_lt_d9, le_max_right T 0]
    have hlog := Real.log_le_log (Real.exp_pos 1) hexp1
    rwa [Real.log_exp] at hlog
  have hdLT_ge1 : 1 ≤ (d : ℝ) * L_T := by nlinarith [hd_r, hLT_ge1]
  have hdLT_pos : 0 < (d : ℝ) * L_T := by linarith [hdLT_ge1]
  -- Bound `3 + X_max ≤ (560 M₀²) * (3 + max T 0)`.
  have hX_prod : 3 + X_max ≤ (560 * (M₀ : ℝ) ^ 2) * (3 + max T 0) := by
    rw [hX_eq]
    push_cast
    have hmax1 : max T 1 ≤ 1 + max T 0 := by
      rcases le_or_gt T 1 with hT1 | hT1
      · rw [max_eq_right hT1]; linarith [le_max_right T 0]
      · rw [max_eq_left hT1.le, max_eq_left (by linarith : (0 : ℝ) ≤ T)]; linarith
    have hM2_ge1 : (1 : ℝ) ≤ (M₀ : ℝ) ^ 2 := by nlinarith [hM0_r]
    have hT0_nn : 0 ≤ max T 0 := le_max_right T 0
    nlinarith [hmax1, hM2_ge1, hT0_nn]
  have hX_pos : 0 < 3 + X_max := by
    rw [hX_eq]
    have hT1 : 0 ≤ max T 1 + 1 := by linarith [le_max_right T 1]
    have hX0 : 0 ≤ ((16 * M₀ * M₀ : ℕ) : ℝ) * (max T 1 + 1) + ((512 * M₀ ^ 2 : ℕ) : ℝ) + 1 :=
      add_nonneg (add_nonneg (mul_nonneg (Nat.cast_nonneg _) hT1) (Nat.cast_nonneg _)) zero_le_one
    linarith [hX0]
  have hlog_X : Real.log (3 + X_max) ≤ Real.log (560 * (M₀ : ℝ) ^ 2) + L_T := by
    rw [hL_eq]
    calc Real.log (3 + X_max)
        ≤ Real.log ((560 * (M₀ : ℝ) ^ 2) * (3 + max T 0)) :=
          Real.log_le_log hX_pos hX_prod
      _ = Real.log (560 * (M₀ : ℝ) ^ 2) + Real.log (3 + max T 0) :=
          Real.log_mul (by positivity) (by linarith [le_max_right T 0])
  have h560 : (1 : ℝ) ≤ 560 * (M₀ : ℝ) ^ 2 := by nlinarith [hM0_r]
  have hlog560_nn : 0 ≤ Real.log (560 * (M₀ : ℝ) ^ 2) := Real.log_nonneg h560
  have hG0_le : G_0 ≤ B_arch * ((d : ℝ) * L_T) := by
    rw [hG_eq, hB_eq]
    have hκ_le : (κ : ℝ) ≤ (κ : ℝ) * ((d : ℝ) * L_T) :=
      le_mul_of_one_le_right (Nat.cast_nonneg κ) hdLT_ge1
    have harch_part : Real.log (3 + X_max) / 2 + 1 / 4 ≤
        (Real.log (560 * (M₀ : ℝ) ^ 2) + 1) * L_T := by
      nlinarith [hlog_X, hLT_ge1, hlog560_nn]
    have hd_arch : (d : ℝ) * (Real.log (3 + X_max) / 2 + 1 / 4) ≤
        (Real.log (560 * (M₀ : ℝ) ^ 2) + 1) * ((d : ℝ) * L_T) := by
      have hm := mul_le_mul_of_nonneg_left harch_part (Nat.cast_nonneg d)
      linarith [hm, show (d : ℝ) * ((Real.log (560 * (M₀ : ℝ) ^ 2) + 1) * L_T) =
        (Real.log (560 * (M₀ : ℝ) ^ 2) + 1) * ((d : ℝ) * L_T) by ring]
    linarith [hκ_le, hd_arch]
  have hG0_pos : 0 < G_0 := by
    rw [hG_eq]
    have hlog_nn : 0 ≤ Real.log (3 + X_max) := Real.log_nonneg (by
      rw [hX_eq]
      have hT1 : 0 ≤ max T 1 + 1 := by linarith [le_max_right T 1]
      have hX0 : 0 ≤ ((16 * M₀ * M₀ : ℕ) : ℝ) * (max T 1 + 1) + ((512 * M₀ ^ 2 : ℕ) : ℝ) + 1 :=
        add_nonneg (add_nonneg (mul_nonneg (Nat.cast_nonneg _) hT1) (Nat.cast_nonneg _)) zero_le_one
      linarith [hX0])
    have ha : 0 < Real.log (3 + X_max) / 2 + 1 / 4 := by linarith [hlog_nn]
    have hd_pos : (0 : ℝ) < d := by linarith [hd_r]
    exact add_pos_of_nonneg_of_pos (Nat.cast_nonneg κ) (mul_pos hd_pos ha)
  have hmin_ge : min 1 (1 / (C_box * B_arch)) / ((d : ℝ) * L_T) ≤
      min 1 (1 / (C_box * G_0)) := by
    refine le_min ?_ ?_
    · rw [div_le_one hdLT_pos]
      exact (min_le_left _ _).trans hdLT_ge1
    · have h1 : min 1 (1 / (C_box * B_arch)) ≤ 1 / (C_box * B_arch) := min_le_right _ _
      calc min 1 (1 / (C_box * B_arch)) / ((d : ℝ) * L_T)
          ≤ (1 / (C_box * B_arch)) / ((d : ℝ) * L_T) :=
            div_le_div_of_nonneg_right h1 hdLT_pos.le
        _ = 1 / (C_box * (B_arch * ((d : ℝ) * L_T))) := by
            rw [div_div, mul_assoc]
        _ ≤ 1 / (C_box * G_0) :=
            one_div_le_one_div_of_le (mul_pos hC_pos hG0_pos)
              (mul_le_mul_of_nonneg_left hG0_le hC_pos.le)
  rw [div_right_comm]
  exact div_le_div_of_nonneg_right hmin_ge (by positivity)

/-- **Explicit `1 / (d log(3 + max T 0))` scaling of `sharpCollarWidth`.**
For every `κ : ℕ`, `d ≥ 1`, and `T : ℝ`,
`sharpCollarConst κ / (d * log(3 + max T 0)) ≤ sharpCollarWidth κ d T`. -/
theorem sharpCollarWidth_ge {κ d : ℕ} (hd : 1 ≤ d) (T : ℝ) :
    sharpCollarConst κ / ((d : ℝ) * Real.log (3 + max T 0)) ≤ sharpCollarWidth κ d T := by
  unfold sharpCollarConst sharpCollarWidth collarDepth
  dsimp only
  have hM0 : 1 ≤ κ / 2 + 1 := Nat.succ_pos _
  have hK0 : 1 ≤ 16 * (κ / 2 + 1) := by omega
  have hE0 : 1 ≤ 512 * (κ / 2 + 1) ^ 2 := Nat.mul_pos (by decide) (Nat.pow_pos hM0)
  have hC_pos :
      (0 : ℝ) < (((16 * (κ / 2 + 1)) ^ (2 * (κ / 2 + 1)) * (512 * (κ / 2 + 1) ^ 2) : ℕ) : ℝ) := by
    exact_mod_cast Nat.mul_pos (Nat.pow_pos hK0) hE0
  exact sharpCollarWidth_ge_aux hd hM0 hC_pos T

/-- **Sharp `⌊κ / 2⌋` finite-height collar multiplicity theorem (`2 * ∑ ord ≤ κ`).**
For any `CompletedPositiveSystem κ d F Λ`, any `T : ℝ`, and any finite set `Z : Finset ℂ` of points
in the collar `{z ∈ ℂ : 0 < Im z ≤ T, Re z > 1 − sharpCollarWidth κ d T}`,
`2 * ∑ z ∈ Z, (analyticOrderAt Λ z).toNat ≤ κ`.
Requires **no** `Δ`-separation and **no** low-ordinate cutoff, and achieves the exact boundary-limit
constant `κ / 2` (shown sharp by `exists_completedPositiveSystem_boundary_zeros_at_half_pole`). -/
theorem two_mul_sum_order_collar_zeros_le_poleOrder {κ d : ℕ} {F Λ : ℂ → ℂ}
    (hS : CompletedPositiveSystem κ d F Λ) {T : ℝ} (Z : Finset ℂ)
    (him_pos : ∀ z ∈ Z, 0 < z.im)
    (him_le : ∀ z ∈ Z, z.im ≤ T)
    (hre_gt : ∀ z ∈ Z, 1 - sharpCollarWidth κ d T < z.re) :
    2 * ∑ z ∈ Z, (analyticOrderAt Λ z).toNat ≤ κ := by
  classical
  by_contra hgt
  rw [not_le] at hgt
  set M₀ : ℕ := κ / 2 + 1
  have hM0_le : M₀ ≤ ∑ z ∈ Z, (analyticOrderAt Λ z).toNat := by omega
  obtain ⟨Z₀, m₀, hZ0_sub, hZ0_card, hm0_bounds, hm0_sum⟩ :=
    exists_subset_and_mult_sum_eq Z (fun z => (analyticOrderAt Λ z).toNat) hM0_le
  set r : ℕ := Z₀.card
  let e : Fin r ≃ Z₀ := Z₀.equivFin.symm
  let ρ : Fin r → ℂ := fun ℓ => (e ℓ : ℂ)
  let m : Fin r → ℕ := fun ℓ => m₀ (e ℓ : ℂ)
  have hinj : Function.Injective ρ := fun ℓ₁ ℓ₂ h => e.injective (Subtype.ext h)
  have hm_sum : ∑ ℓ : Fin r, m ℓ = M₀ := by
    have hbij : ∑ ℓ : Fin r, m₀ (e ℓ : ℂ) = ∑ z ∈ Z₀, m₀ z := by
      rw [← Finset.sum_attach Z₀]
      exact Fintype.sum_equiv e (fun ℓ => m₀ (e ℓ : ℂ)) (fun z => m₀ (z : ℂ)) (fun _ => rfl)
    exact hbij.trans hm0_sum
  have hbudget : κ < 2 * ∑ ℓ : Fin r, m ℓ := by
    rw [hm_sum]; omega
  obtain ⟨ℓ, _, hρ_le⟩ :=
    collective_half_pole_collar_forcing hS ρ m hinj
      (fun ℓ _ => him_pos (e ℓ : ℂ) (hZ0_sub (e ℓ).2))
      (fun ℓ _ => him_le (e ℓ : ℂ) (hZ0_sub (e ℓ).2))
      (fun ℓ => (hm0_bounds (e ℓ : ℂ) (e ℓ).2).2)
      hbudget
  rw [hm_sum] at hρ_le
  have hw_mono : sharpCollarWidth κ d T ≤ collarDepth κ d r M₀ T :=
    collarDepth_anti_r hS.degree_pos (Nat.succ_pos _) hZ0_card T
  have hρ_gt := hre_gt (e ℓ : ℂ) (hZ0_sub (e ℓ).2)
  change 1 - sharpCollarWidth κ d T < (ρ ℓ).re at hρ_gt
  linarith [hρ_le, hw_mono, hρ_gt]

/-- **Sharp `⌊κ / 2⌋` collar multiplicity corollary.** -/
theorem sum_order_collar_zeros_le_half_poleOrder {κ d : ℕ} {F Λ : ℂ → ℂ}
    (hS : CompletedPositiveSystem κ d F Λ) {T : ℝ} (Z : Finset ℂ)
    (him_pos : ∀ z ∈ Z, 0 < z.im)
    (him_le : ∀ z ∈ Z, z.im ≤ T)
    (hre_gt : ∀ z ∈ Z, 1 - sharpCollarWidth κ d T < z.re) :
    ∑ z ∈ Z, (analyticOrderAt Λ z).toNat ≤ κ / 2 := by
  have h := two_mul_sum_order_collar_zeros_le_poleOrder hS Z him_pos him_le hre_gt
  omega

/-- **Sharp `⌊κ / 2⌋` collar zero-count corollary (eliminating `κ²` and `Δ`-separation).**
Every finite set `Z` of zeros of `Λ` in `{z ∈ ℂ : 0 < Im z ≤ T, Re z > 1 − sharpCollarWidth κ d T}`
satisfies `Z.card ≤ κ / 2`. -/
theorem card_collar_zeros_le_half_poleOrder {κ d : ℕ} {F Λ : ℂ → ℂ}
    (hS : CompletedPositiveSystem κ d F Λ) {T : ℝ} (Z : Finset ℂ)
    (hzeros : ∀ z ∈ Z, Λ z = 0)
    (him_pos : ∀ z ∈ Z, 0 < z.im)
    (him_le : ∀ z ∈ Z, z.im ≤ T)
    (hre_gt : ∀ z ∈ Z, 1 - sharpCollarWidth κ d T < z.re) :
    Z.card ≤ κ / 2 := by
  have hcard_le : Z.card ≤ ∑ z ∈ Z, (analyticOrderAt Λ z).toNat := by
    calc Z.card = ∑ _z ∈ Z, 1 := by simp
      _ ≤ ∑ z ∈ Z, (analyticOrderAt Λ z).toNat :=
          Finset.sum_le_sum fun z hz => hS.one_le_order_toNat_of_eq_zero (hzeros z hz)
  exact hcard_le.trans (sum_order_collar_zeros_le_half_poleOrder hS Z him_pos him_le hre_gt)

/-- **Exception-free `κ = 1` zero-free collar across all ordinates `|Im z| ≤ T`.**
Combining `two_mul_sum_order_collar_zeros_le_poleOrder` at `κ = 1` (`⌊1 / 2⌋ = 0` upper/lower
half-plane zeros) with real-axis nonvanishing `ne_zero_ofReal_of_completedPositiveSystem_one`
certifies `Λ z ≠ 0` across the entire collar `{z ∈ ℂ : |Im z| ≤ T, Re z > 1 − sharpCollarWidth 1 d T}`
with **no** exceptional Siegel zero and **no** low-ordinate gap. -/
theorem ne_zero_of_mem_sharpCollar_one {d : ℕ} {F Λ : ℂ → ℂ}
    (hS : CompletedPositiveSystem 1 d F Λ) {T : ℝ} {z : ℂ}
    (him : |z.im| ≤ T) (hre : 1 - sharpCollarWidth 1 d T < z.re) :
    Λ z ≠ 0 := by
  rcases lt_trichotomy z.im 0 with hlt | hzero | hgt
  · intro hz0
    let w : ℂ := starRingEnd ℂ z
    have hw0 : Λ w = 0 := by dsimp only [w]; rw [hS.conj_Λ, hz0, map_zero]
    have hw_im_pos : 0 < w.im := by simp [w]; linarith
    have hw_im_le : w.im ≤ T := by
      have habs : |z.im| = -z.im := abs_of_neg hlt
      simp [w]; linarith
    have hw_re : 1 - sharpCollarWidth 1 d T < w.re := by simpa [w] using hre
    have hcard := card_collar_zeros_le_half_poleOrder hS {w}
      (fun u hu => by simp only [Finset.mem_singleton] at hu; subst hu; exact hw0)
      (fun u hu => by simp only [Finset.mem_singleton] at hu; subst hu; exact hw_im_pos)
      (fun u hu => by simp only [Finset.mem_singleton] at hu; subst hu; exact hw_im_le)
      (fun u hu => by simp only [Finset.mem_singleton] at hu; subst hu; exact hw_re)
    simp at hcard
  · have hz_real : z = (z.re : ℂ) := by apply Complex.ext <;> simp [hzero]
    rw [hz_real]
    exact ne_zero_ofReal_of_completedPositiveSystem_one hS z.re
  · intro hz0
    have hz_im_le : z.im ≤ T := (le_abs_self z.im).trans him
    have hcard := card_collar_zeros_le_half_poleOrder hS {z}
      (fun u hu => by simp only [Finset.mem_singleton] at hu; subst hu; exact hz0)
      (fun u hu => by simp only [Finset.mem_singleton] at hu; subst hu; exact hgt)
      (fun u hu => by simp only [Finset.mem_singleton] at hu; subst hu; exact hz_im_le)
      (fun u hu => by simp only [Finset.mem_singleton] at hu; subst hu; exact hre)
    simp at hcard

end GaloisForLFunctions.StripBochnerWeilForcing

