                (1 / (((1 + δ : ℝ) : ℂ) + ((x p.1 - x p.2 : ℝ) : ℂ) * I - ρ ℓ)).re := by
              refine Finset.sum_le_sum fun p hp => ?_
              obtain ⟨y, _, rfl⟩ := Finset.mem_map.mp hp
