/-! ### 1. Completed positive systems and finite-order envelope upgrade -/

/-- A **completed positive system** of pole budget `κ` and archimedean degree `d ≥ 1`:
`F` is holomorphic and nonvanishing on `{Re s > 1}` with even positive-definite vertical sections
`u ↦ Re(−F'/F)(σ + iu)` for every `σ > 1`, and `Λ(s) = (s(s − 1))^κ Γ_ℝ(s)^d F(s)` extends to an
entire function in the order-one growth envelope satisfying `Λ(1 − s) = Λ(s)` and
`Λ(s̄) = conj(Λ(s))`. -/
structure CompletedPositiveSystem (κ d : ℕ) (F Λ : ℂ → ℂ) : Prop where
  degree_pos : 1 ≤ d
  diffOn_F : DifferentiableOn ℂ F {s : ℂ | 1 < s.re}
  ne_zero_F : ∀ s : ℂ, 1 < s.re → F s ≠ 0
  posDef_neg_logDeriv : ∀ {σ : ℝ}, 1 < σ →
    IsEvenPosDef (fun u : ℝ => (-logDeriv F ((σ : ℂ) + (u : ℂ) * I)).re)
  entire_Λ : Differentiable ℂ Λ
  orderOne_Λ : OrderOneEnvelope Λ
  sym_Λ : ∀ s : ℂ, Λ (1 - s) = Λ s
  conj_Λ : ∀ s : ℂ, Λ (starRingEnd ℂ s) = starRingEnd ℂ (Λ s)
  completed_eq : ∀ s : ℂ, 1 < s.re →
    Λ s = (s * (s - 1)) ^ κ * Complex.Gammaℝ s ^ d * F s

private theorem ne_zero_and_sub_one_of_one_lt_re {s : ℂ} (hs : 1 < s.re) :
    s ≠ 0 ∧ s - 1 ≠ 0 :=
  ⟨fun h => by rw [h, Complex.zero_re] at hs; linarith,
    sub_ne_zero.mpr fun h => by rw [h, Complex.one_re] at hs; linarith⟩

namespace CompletedPositiveSystem

/-- Any finite-order entire completion `Λ` whose uncompleted factor `F` is bounded on `{Re s ≥ 2}`
automatically lies in `OrderOneEnvelope`, via Phragmén–Lindelöf on `−1 ≤ Re s ≤ 2` and Stirling's
envelope on `Re s ≥ 2`. -/
theorem ofFiniteOrder {κ d : ℕ} {F Λ : ℂ → ℂ}
    (hd : 1 ≤ d)
    (hF : DifferentiableOn ℂ F {s : ℂ | 1 < s.re})
    (hFnz : ∀ s : ℂ, 1 < s.re → F s ≠ 0)
    (hFbdd : ∃ S : ℝ, ∀ s : ℂ, 2 ≤ s.re → ‖F s‖ ≤ S)
    (hpos : ∀ {σ : ℝ}, 1 < σ →
      IsEvenPosDef (fun u : ℝ => (-logDeriv F ((σ : ℂ) + (u : ℂ) * I)).re))
    (hΛ : Differentiable ℂ Λ)
    (hfin : ∃ ρ C₀ : ℝ, ∀ s : ℂ, ‖Λ s‖ ≤ C₀ * Real.exp (‖s‖ ^ ρ))
    (hsym : ∀ s : ℂ, Λ (1 - s) = Λ s)
    (hconj : ∀ s : ℂ, Λ (starRingEnd ℂ s) = starRingEnd ℂ (Λ s))
    (hcomp : ∀ s : ℂ, 1 < s.re → Λ s = (s * (s - 1)) ^ κ * Complex.Gammaℝ s ^ d * F s) :
    CompletedPositiveSystem κ d F Λ := by
  refine ⟨hd, hF, hFnz, hpos, hΛ, ?_, hsym, hconj, hcomp⟩
  obtain ⟨ρ, C₀, hfin'⟩ := hfin
  obtain ⟨S₀, hS₀⟩ := hFbdd
  set S : ℝ := max S₀ 0
  have hS_nonneg : 0 ≤ S := le_max_right _ _
  have hFb : ∀ s : ℂ, 2 ≤ s.re → ‖F s‖ ≤ S := fun s hs => (hS₀ s hs).trans (le_max_left _ _)
  have hflip : ∀ s : ℂ, ‖Λ s‖ = ‖Λ (1 - s)‖ := fun s => by
    have h := hsym (1 - s); rw [sub_sub_cancel] at h; rw [h]
  obtain ⟨B₁, hB₁0, hB₁⟩ := RHTower.TwinRigidity.exists_bound_completionFactor_pole
    (m := 1) le_rfl κ hd
  have hline : ∀ z : ℂ, z.re = 2 → ‖Λ z‖ ≤ B₁ * S := by
    intro z hz
    have hz' : z = (((2 * 1 : ℕ) : ℂ) + (z.im : ℂ) * I) := by
      apply Complex.ext <;> simp [hz]
    rw [hcomp z (by linarith), norm_mul]
    refine mul_le_mul ?_ (hFb z hz.ge) (norm_nonneg _) hB₁0
    rw [hz']
    exact hB₁ z.im
  have hstrip : ∀ z : ℂ, 1 - (2 : ℝ) ≤ z.re → z.re ≤ 2 → ‖Λ z‖ ≤ B₁ * S := fun z h1 h2 =>
    PhragmenLindelof.vertical_strip hΛ.diffContOnCl
      (RHTower.CompletionGrowth.isBigO_strip_of_finiteOrder_at hfin' (by norm_num))
      (fun w hw => by rw [hflip]; exact hline (1 - w) (by simp [hw])) hline h1 h2
  obtain ⟨C₁, hC₁0, hC₁⟩ := RHTower.CompletionGrowth.le_exp_envelope (A := S) (M := d)
    (Nat.cast_nonneg d) (2 * κ)
  have hright : ∀ s : ℂ, 2 ≤ s.re →
      ‖Λ s‖ ≤ Real.exp (C₁ * (1 + ‖s‖) * Real.log (2 + ‖s‖)) := by
    intro s hs
    refine le_trans ?_ (hC₁ ‖s‖ (norm_nonneg s))
    rw [hcomp s (by linarith), norm_mul, norm_mul, norm_pow, norm_pow, norm_mul]
    have h1 : ‖s‖ ≤ 1 + ‖s‖ := by linarith
    have h2 : ‖s - 1‖ ≤ 1 + ‖s‖ := by
      calc ‖s - 1‖ ≤ ‖s‖ + ‖(1 : ℂ)‖ := norm_sub_le _ _
        _ = 1 + ‖s‖ := by simp; ring
    have hG := RHTower.CompletionGrowth.norm_Gammaℝ_le (s := s) (by linarith)
    calc (‖s‖ * ‖s - 1‖) ^ κ * ‖Complex.Gammaℝ s‖ ^ d * ‖F s‖
        ≤ ((1 + ‖s‖) * (1 + ‖s‖)) ^ κ * Real.exp (‖s‖ * Real.log (2 + ‖s‖)) ^ d * S := by
          gcongr
          exact hFb s hs
      _ = S * (1 + ‖s‖) ^ (2 * κ) * Real.exp (d * ‖s‖ * Real.log (2 + ‖s‖)) := by
          rw [← Real.exp_nat_mul, ← pow_two, ← pow_mul]
          ring_nf
  obtain ⟨C₂, hC₂0, hC₂⟩ := RHTower.CompletionGrowth.le_exp_envelope (A := B₁ * S) (M := 0)
    le_rfl 0
  set C : ℝ := 4 * C₁ + C₂ + 1
  refine ⟨C, by positivity, fun s => ?_⟩
  have hmono : ∀ C' : ℝ, C' ≤ C →
      Real.exp (C' * (1 + ‖s‖) * Real.log (2 + ‖s‖)) ≤ Real.exp (orderOneWeight C s) := by
    intro C' hC'
    rw [orderOneWeight, Real.exp_le_exp]
    exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hC' (by positivity))
      (Real.log_nonneg (by linarith [norm_nonneg s]))
  rcases le_or_gt 2 s.re with h2 | h2
  · exact (hright s h2).trans (hmono C₁ (by simp only [C]; linarith))
  rcases le_or_gt (-1) s.re with h1 | h1
  · have h0 := hC₂ ‖s‖ (norm_nonneg s)
    simp only [pow_zero, mul_one, zero_mul, Real.exp_zero] at h0
    exact ((hstrip s (by linarith) h2.le).trans h0).trans (hmono C₂ (by simp only [C]; linarith))
  · rw [hflip]
    have hre : 2 ≤ (1 - s).re := by simp; linarith
    refine (hright (1 - s) hre).trans ?_
    refine le_trans ?_ (hmono (4 * C₁) (by simp only [C]; linarith))
    rw [Real.exp_le_exp]
    have hn : ‖1 - s‖ ≤ 1 + ‖s‖ := by
      calc ‖1 - s‖ ≤ ‖(1 : ℂ)‖ + ‖s‖ := norm_sub_le _ _
        _ = 1 + ‖s‖ := by simp
    have hx := norm_nonneg s
    have hl : Real.log (2 + ‖1 - s‖) ≤ 2 * Real.log (2 + ‖s‖) := by
      rw [← Real.log_rpow (by positivity)]
      refine Real.log_le_log (by positivity) ?_
      norm_num
      nlinarith
    have hl0 : 0 ≤ Real.log (2 + ‖1 - s‖) := Real.log_nonneg (by linarith [norm_nonneg (1 - s)])
    calc C₁ * (1 + ‖1 - s‖) * Real.log (2 + ‖1 - s‖)
        ≤ C₁ * (2 * (1 + ‖s‖)) * (2 * Real.log (2 + ‖s‖)) :=
          mul_le_mul (mul_le_mul_of_nonneg_left (by linarith) hC₁0) hl hl0 (by positivity)
      _ = 4 * C₁ * (1 + ‖s‖) * Real.log (2 + ‖s‖) := by ring

variable {κ d : ℕ} {F Λ : ℂ → ℂ}

theorem ne_zero_of_one_lt_re (hS : CompletedPositiveSystem κ d F Λ) {s : ℂ} (hs : 1 < s.re) :
    Λ s ≠ 0 := by
  rw [hS.completed_eq s hs]
  obtain ⟨hs0, hs1⟩ := ne_zero_and_sub_one_of_one_lt_re hs
  have hΓ : Complex.Gammaℝ s ≠ 0 := Complex.Gammaℝ_ne_zero_of_re_pos (by linarith)
  exact mul_ne_zero (mul_ne_zero (pow_ne_zero κ (mul_ne_zero hs0 hs1)) (pow_ne_zero d hΓ))
    (hS.ne_zero_F s hs)

theorem two_ne_zero (hS : CompletedPositiveSystem κ d F Λ) : Λ 2 ≠ 0 :=
  hS.ne_zero_of_one_lt_re (by norm_num)

/-- Every zero of `Λ` lies in the closed critical strip `0 ≤ Re ρ ≤ 1`. -/
theorem zero_re_mem_Icc (hS : CompletedPositiveSystem κ d F Λ) {ρ : ℂ} (hρ : Λ ρ = 0) :
    0 ≤ ρ.re ∧ ρ.re ≤ 1 := by
  refine ⟨?_, ?_⟩
  · by_contra hlt
    rw [not_le] at hlt
    have h1 : 1 < (1 - ρ).re := by simp; linarith
    exact hS.ne_zero_of_one_lt_re h1 (by rw [hS.sym_Λ, hρ])
  · by_contra hgt
    rw [not_le] at hgt
    exact hS.ne_zero_of_one_lt_re hgt hρ

theorem analyticOnNhd_univ (hS : CompletedPositiveSystem κ d F Λ) : AnalyticOnNhd ℂ Λ univ :=
  hS.entire_Λ.differentiableOn.analyticOnNhd isOpen_univ

theorem orderAt_ne_top (hS : CompletedPositiveSystem κ d F Λ) (z : ℂ) :
    analyticOrderAt Λ z ≠ ⊤ :=
  hS.analyticOnNhd_univ.analyticOrderAt_ne_top_of_isPreconnected isPreconnected_univ
    (mem_univ 2) (mem_univ z)
    (by rw [(hS.analyticOnNhd_univ 2 (mem_univ 2)).analyticOrderAt_eq_zero.mpr hS.two_ne_zero]
        exact ENat.zero_ne_top)

theorem one_le_order_toNat_of_eq_zero (hS : CompletedPositiveSystem κ d F Λ) {ρ : ℂ}
    (hρ : Λ ρ = 0) : 1 ≤ (analyticOrderAt Λ ρ).toNat := by
  have hne0 : analyticOrderAt Λ ρ ≠ 0 := fun hz =>
    ((hS.analyticOnNhd_univ ρ (mem_univ ρ)).analyticOrderAt_eq_zero.mp hz) hρ
  obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp (hS.orderAt_ne_top ρ)
  rcases eq_or_ne m 0 with rfl | hm0
  · exact absurd hm.symm hne0
  · rw [← hm, ENat.toNat_coe]
    omega

theorem eq_zero_of_one_le_order_toNat (hS : CompletedPositiveSystem κ d F Λ) {ρ : ℂ}
    (hm : 1 ≤ (analyticOrderAt Λ ρ).toNat) : Λ ρ = 0 := by
  by_contra hnz
  rw [(hS.analyticOnNhd_univ ρ (mem_univ ρ)).analyticOrderAt_eq_zero.mpr hnz] at hm
  simp at hm

theorem orderAt_one_sub (hS : CompletedPositiveSystem κ d F Λ) (z : ℂ) :
    analyticOrderAt Λ (1 - z) = analyticOrderAt Λ z := by
  have h := RHTower.analyticOrderAt_comp_one_sub hS.entire_Λ z
  rwa [show (fun w => Λ (1 - w)) = Λ from funext hS.sym_Λ] at h

theorem orderAt_conj (hS : CompletedPositiveSystem κ d F Λ) (z : ℂ) :
    analyticOrderAt Λ (starRingEnd ℂ z) = analyticOrderAt Λ z :=
  RHTower.analyticOrderAt_conj_of_conjEquivariant hS.conj_Λ
    (hS.analyticOnNhd_univ z (mem_univ z))
    (hS.analyticOnNhd_univ (starRingEnd ℂ z) (mem_univ _))

/-- Logarithmic derivative decomposition on `Re s > 1`:
`-F'/F(s) = κ(1/s + 1/(s − 1)) + d(Γ_ℝ'/Γ_ℝ)(s) − (Λ'/Λ)(s)`. -/
theorem neg_logDeriv_F_eq (hS : CompletedPositiveSystem κ d F Λ) {s : ℂ} (hs : 1 < s.re) :
    -logDeriv F s =
      (κ : ℂ) * (1 / s + 1 / (s - 1)) + (d : ℂ) * logDeriv Complex.Gammaℝ s - logDeriv Λ s := by
  have hopen : IsOpen {w : ℂ | 1 < w.re} := isOpen_lt continuous_const Complex.continuous_re
  have hev : Λ =ᶠ[𝓝 s] fun w => (w * (w - 1)) ^ κ * Complex.Gammaℝ w ^ d * F w :=
    Filter.eventuallyEq_of_mem (hopen.mem_nhds hs) fun w hw => hS.completed_eq w hw
  have hΛ_ld : logDeriv Λ s =
      logDeriv (fun w => (w * (w - 1)) ^ κ * Complex.Gammaℝ w ^ d * F w) s := by
    rw [logDeriv_apply, logDeriv_apply, hev.deriv_eq, hev.eq_of_nhds]
  obtain ⟨hs0, hs1⟩ := ne_zero_and_sub_one_of_one_lt_re hs
  have hq0 : s * (s - 1) ≠ 0 := mul_ne_zero hs0 hs1
  have hΓ0 : Complex.Gammaℝ s ≠ 0 := Complex.Gammaℝ_ne_zero_of_re_pos (by linarith)
  have hF0 : F s ≠ 0 := hS.ne_zero_F s hs
  have hqd : DifferentiableAt ℂ (fun w : ℂ => w * (w - 1)) s :=
    differentiableAt_id.mul (differentiableAt_id.sub_const 1)
  have hΓd : DifferentiableAt ℂ Complex.Gammaℝ s :=
    GaloisForLFunctions.differentiableAt_Gammaℝ (by linarith)
  have hFd : DifferentiableAt ℂ F s := (hS.diffOn_F s hs).differentiableAt (hopen.mem_nhds hs)
  rw [hΛ_ld,
    logDeriv_mul (f := fun w => (w * (w - 1)) ^ κ * Complex.Gammaℝ w ^ d) (g := F) s
      (mul_ne_zero (pow_ne_zero κ hq0) (pow_ne_zero d hΓ0)) hF0
      ((hqd.fun_pow κ).mul (hΓd.fun_pow d)) hFd,
    logDeriv_mul (f := fun w => (w * (w - 1)) ^ κ) (g := fun w => Complex.Gammaℝ w ^ d) s
      (pow_ne_zero κ hq0) (pow_ne_zero d hΓ0) (hqd.fun_pow κ) (hΓd.fun_pow d),
    logDeriv_fun_pow hqd κ, logDeriv_fun_pow hΓd d]
  have hq_ld : logDeriv (fun w : ℂ => w * (w - 1)) s = 1 / s + 1 / (s - 1) := by
    have hsub : DifferentiableAt ℂ (fun w : ℂ => w - 1) s := differentiableAt_id.sub_const 1
    rw [logDeriv_mul (f := fun w : ℂ => w) (g := fun w : ℂ => w - 1) s hs0 hs1
      differentiableAt_id hsub]
    congr 1
    · rw [logDeriv_apply, deriv_id'', one_div]
    · rw [logDeriv_apply, deriv_sub_const, deriv_id'', one_div]
  rw [hq_ld]
  ring

end CompletedPositiveSystem

/-! ### 2. Dihedral orbit multiplicity extraction and coupled strip forcing -/

private theorem re_one_div_nonneg_of_re_le {s z : ℂ} (hz : z.re ≤ s.re) :
    0 ≤ (1 / (s - z)).re := by
  rw [one_div, Complex.inv_re, Complex.sub_re]
  exact div_nonneg (sub_nonneg.mpr hz) (Complex.normSq_nonneg _)

/-- **Orbit multiplicity extraction.** For any `r` upper-half-plane points `ρ₁, …, ρ_r` with
pairwise distinct positive ordinates `Im ρ_ℓ > 0` and integer multiplicities
`m_ℓ ≤ (analyticOrderAt Λ ρ_ℓ).toNat`, extracting the disjoint `{ρ_ℓ, ρ̄_ℓ, 1 − ρ_ℓ, 1 − ρ̄_ℓ}`
multiplicity copies from Hadamard's zero-pair expansion yields on `Re s > 1`:
`∑_ℓ m_ℓ (Re 1/(s − ρ_ℓ) + Re 1/(s − ρ̄_ℓ)) ≤ Re(Λ'/Λ)(s)`. -/
theorem sum_orbit_resolvent_le_re_logDeriv {κ d : ℕ} {F Λ : ℂ → ℂ}
    (hS : CompletedPositiveSystem κ d F Λ) {r : ℕ} (ρ : Fin r → ℂ) (m : Fin r → ℕ)
    (him : ∀ ℓ, 0 < (ρ ℓ).im)
    (hdist : ∀ ℓ ℓ', ℓ ≠ ℓ' → (ρ ℓ).im ≠ (ρ ℓ').im)
    (hm : ∀ ℓ, m ℓ ≤ (analyticOrderAt Λ (ρ ℓ)).toNat)
    {s : ℂ} (hs : 1 < s.re) :
    ∑ ℓ, (m ℓ : ℝ) * ((1 / (s - ρ ℓ)).re + (1 / (s - starRingEnd ℂ (ρ ℓ))).re) ≤
      (logDeriv Λ s).re := by
  classical
  set f : ℂ → ℂ := fun z => Λ (z + 2) with hfdef
  have hfd : Differentiable ℂ f := hS.entire_Λ.comp (differentiable_id.add_const 2)
  have hf : AnalyticOnNhd ℂ f univ := hfd.differentiableOn.analyticOnNhd isOpen_univ
  obtain ⟨C, hC, hgrow⟩ := hS.orderOne_Λ
  have hsum_c : HasSum (fun q : ZeroCopy f =>
      (1 / 2 : ℂ) * gPair (zeroCopyPoint f q + 2) s) (logDeriv Λ s) :=
    hasSum_logDeriv_zeroPairs hS.entire_Λ one_ne_zero
      (fun w => by rw [hS.sym_Λ w, one_mul]) hC.le
      (fun w => by simpa only [orderOneWeight] using hgrow w)
      hS.two_ne_zero (hS.ne_zero_of_one_lt_re hs)
  set term : ZeroCopy f → ℝ := fun q => ((1 / 2 : ℂ) * gPair (zeroCopyPoint f q + 2) s).re
  have hsum_re : HasSum term (logDeriv Λ s).re := hsum_c.mapL Complex.reCLM
  have hterm_nonneg : ∀ q : ZeroCopy f, 0 ≤ term q := by
    intro q
    have hzq0 : Λ (zeroCopyPoint f q + 2) = 0 := by simpa [hfdef] using apply_zeroCopyPoint hf q
    obtain ⟨h0, h1⟩ := hS.zero_re_mem_Icc hzq0
    simp only [term, gPair]
    have ha : 0 ≤ (1 / (s - (zeroCopyPoint f q + 2))).re :=
      re_one_div_nonneg_of_re_le (h1.trans hs.le)
    have hb : 0 ≤ (1 / (s - (1 - (zeroCopyPoint f q + 2)))).re :=
      re_one_div_nonneg_of_re_le (by rw [Complex.sub_re, Complex.one_re]; linarith)
    have hre : ((1 / 2 : ℂ) * (1 / (s - (zeroCopyPoint f q + 2)) +
        1 / (s - (1 - (zeroCopyPoint f q + 2))))).re =
        ((1 / (s - (zeroCopyPoint f q + 2))).re +
          (1 / (s - (1 - (zeroCopyPoint f q + 2)))).re) / 2 := by
      have : (1 / 2 : ℂ) * (1 / (s - (zeroCopyPoint f q + 2)) +
          1 / (s - (1 - (zeroCopyPoint f q + 2)))) =
          (1 / (s - (zeroCopyPoint f q + 2)) +
            1 / (s - (1 - (zeroCopyPoint f q + 2)))) / 2 := by ring
      rw [this, Complex.div_ofNat_re, Complex.add_re]
    rw [hre]
    linarith
  -- Analytic order of `f` at `w - 2` matches analytic order of `Λ` at `w`.
  have hdiv_toNat : ∀ w : ℂ,
      ((MeromorphicOn.divisor f univ) (w - 2)).toNat = (analyticOrderAt Λ w).toNat := by
    intro w
    have hg_an : AnalyticAt ℂ (fun z : ℂ => z + 2) (w - 2) := by fun_prop
    have hg_d : deriv (fun z : ℂ => z + 2) (w - 2) ≠ 0 := by
      have hd : HasDerivAt (fun z : ℂ => z + 2) 1 (w - 2) := (hasDerivAt_id' (w - 2)).add_const 2
      rw [hd.deriv]; exact one_ne_zero
    have hcomp := analyticOrderAt_comp_of_deriv_ne_zero (f := Λ) hg_an hg_d
    have hfeq : Λ ∘ (fun z : ℂ => z + 2) = f := rfl
    rw [hfeq, sub_add_cancel] at hcomp
    rw [divisor_univ_eq_analyticOrder hf, hcomp]
    obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp (hS.orderAt_ne_top w)
    rw [← hn]; simp
  -- Explicit Finset of `k` copies in `ZeroCopy f` over `w - 2`.
  let copiesAt : ℂ → ℕ → Finset (ZeroCopy f) := fun w k =>
    if hk : 1 ≤ k ∧ k ≤ ((MeromorphicOn.divisor f univ) (w - 2)).toNat then
      have hsupp : w - 2 ∈ (MeromorphicOn.divisor f univ).support := by
        intro h0; rw [h0] at hk; simp at hk; omega
      Finset.univ.map ⟨fun j : Fin k => ⟨⟨w - 2, hsupp⟩, ⟨j.1, j.2.trans_le hk.2⟩⟩,
        fun j₁ j₂ heq => by
          simp only [Sigma.mk.injEq, heq_eq_eq, Fin.mk.injEq] at heq
          exact Fin.ext heq.2⟩
    else ∅
  have hcopies_pt : ∀ w k q, q ∈ copiesAt w k → zeroCopyPoint f q + 2 = w := by
    intro w k q hq
    dsimp only [copiesAt] at hq
    split_ifs at hq with hk
    · obtain ⟨j, _, rfl⟩ := Finset.mem_map.mp hq
      change (w - 2) + 2 = w
      ring
    · simp at hq
  have hcopies_disj : ∀ w₁ w₂ k₁ k₂, w₁ ≠ w₂ → Disjoint (copiesAt w₁ k₁) (copiesAt w₂ k₂) := by
    intro w₁ w₂ k₁ k₂ hne
    rw [Finset.disjoint_left]
    intro q h1 h2
    exact hne ((hcopies_pt w₁ k₁ q h1).symm.trans (hcopies_pt w₂ k₂ q h2))
  have hcopies_sum : ∀ w k, 1 ≤ k → k ≤ (analyticOrderAt Λ w).toNat →
      ∑ q ∈ copiesAt w k, term q = (k : ℝ) * ((1 / 2 : ℂ) * gPair w s).re := by
    intro w k hk1 hkle
    have hk : 1 ≤ k ∧ k ≤ ((MeromorphicOn.divisor f univ) (w - 2)).toNat :=
      ⟨hk1, by rwa [hdiv_toNat]⟩
    have hmem_iff : ∀ q ∈ copiesAt w k, term q = ((1 / 2 : ℂ) * gPair w s).re := by
      intro q hq
      simp only [term, hcopies_pt w k q hq]
    have hcard : (copiesAt w k).card = k := by
      simp only [copiesAt, dif_pos hk, Finset.card_map, Finset.card_univ, Fintype.card_fin]
    rw [Finset.sum_congr rfl hmem_iff, Finset.sum_const, hcard, nsmul_eq_mul]
  -- Dihedral orbit points for each `ℓ`.
  let orbPts : Fin r → Finset ℂ := fun ℓ =>
    {ρ ℓ, starRingEnd ℂ (ρ ℓ), 1 - ρ ℓ, 1 - starRingEnd ℂ (ρ ℓ)}
  let orbCopies : Fin r → Finset (ZeroCopy f) := fun ℓ =>
    if m ℓ = 0 then ∅ else (orbPts ℓ).biUnion (fun w => copiesAt w (m ℓ))
  have horbPts_im : ∀ ℓ w, w ∈ orbPts ℓ → |w.im| = (ρ ℓ).im := by
    intro ℓ w hw
    have h0 := him ℓ
    simp only [orbPts, Finset.mem_insert, Finset.mem_singleton] at hw
    rcases hw with rfl | rfl | rfl | rfl <;> simp [abs_of_pos h0]
  have horbPts_ord : ∀ ℓ w, w ∈ orbPts ℓ →
      (analyticOrderAt Λ w).toNat = (analyticOrderAt Λ (ρ ℓ)).toNat := by
    intro ℓ w hw
    simp only [orbPts, Finset.mem_insert, Finset.mem_singleton] at hw
    rcases hw with rfl | rfl | rfl | rfl
    · rfl
    · rw [hS.orderAt_conj]
    · rw [hS.orderAt_one_sub]
    · rw [hS.orderAt_one_sub, hS.orderAt_conj]
  have horb_disj : Pairwise (fun ℓ ℓ' => Disjoint (orbCopies ℓ) (orbCopies ℓ')) := by
    intro ℓ ℓ' hne
    rw [Finset.disjoint_left]
    intro q h1 h2
    dsimp only [orbCopies] at h1 h2
    split_ifs at h1 with hm1
    · simp at h1
    split_ifs at h2 with hm2
    · simp at h2
    obtain ⟨w₁, hw₁, hq₁⟩ := Finset.mem_biUnion.mp h1
    obtain ⟨w₂, hw₂, hq₂⟩ := Finset.mem_biUnion.mp h2
    have hp := (hcopies_pt w₁ (m ℓ) q hq₁).symm.trans (hcopies_pt w₂ (m ℓ') q hq₂)
    exact hdist ℓ ℓ' hne ((horbPts_im ℓ w₁ hw₁).symm.trans (hp ▸ horbPts_im ℓ' w₂ hw₂))
  -- Lower bound on each orbit's contribution.
  have horb_le : ∀ ℓ,
      (m ℓ : ℝ) * ((1 / (s - ρ ℓ)).re + (1 / (s - starRingEnd ℂ (ρ ℓ))).re) ≤
        ∑ q ∈ orbCopies ℓ, term q := by
    intro ℓ
    rcases eq_or_ne (m ℓ) 0 with hm0 | hm0
    · simp [orbCopies, hm0]
    have hm1 : 1 ≤ m ℓ := Nat.pos_of_ne_zero hm0
    have hbi : ∑ q ∈ orbCopies ℓ, term q =
        ∑ w ∈ orbPts ℓ, ∑ q ∈ copiesAt w (m ℓ), term q := by
      simp only [orbCopies, if_neg hm0]
      exact Finset.sum_biUnion fun w₁ _ w₂ _ hne => hcopies_disj w₁ w₂ (m ℓ) (m ℓ) hne
    rw [hbi]
    have hinner : ∑ w ∈ orbPts ℓ, ∑ q ∈ copiesAt w (m ℓ), term q =
        ∑ w ∈ orbPts ℓ, (m ℓ : ℝ) * ((1 / 2 : ℂ) * gPair w s).re := by
      refine Finset.sum_congr rfl fun w hw => hcopies_sum w (m ℓ) hm1 ?_
      rw [horbPts_ord ℓ w hw]
      exact hm ℓ
    rw [hinner, ← Finset.mul_sum]
    refine mul_le_mul_of_nonneg_left ?_ (Nat.cast_nonneg _)
    have h0 := him ℓ
    have hne_conj : ρ ℓ ≠ starRingEnd ℂ (ρ ℓ) := fun h => by
      have := congrArg Complex.im h; simp at this; linarith
    by_cases hcrit : (ρ ℓ).re = 1 / 2
    · -- Critical zero: `1 - ρ_ℓ = conj ρ_ℓ`, so `orbPts ℓ = {ρ_ℓ, conj ρ_ℓ}`.
      have hc1 : 1 - ρ ℓ = starRingEnd ℂ (ρ ℓ) := by
        (apply Complex.ext <;> simp); linarith
      have hc2 : 1 - starRingEnd ℂ (ρ ℓ) = ρ ℓ := by
        (apply Complex.ext <;> simp); linarith
      have hset : orbPts ℓ = {ρ ℓ, starRingEnd ℂ (ρ ℓ)} := by
        ext z
        simp only [orbPts, hc1, hc2, Finset.mem_insert, Finset.mem_singleton]
        tauto
      rw [hset, Finset.sum_pair hne_conj]
      have hg1 : gPair (ρ ℓ) s = 1 / (s - ρ ℓ) + 1 / (s - starRingEnd ℂ (ρ ℓ)) := by
        simp only [gPair, hc1]
      have hg2 : gPair (starRingEnd ℂ (ρ ℓ)) s =
          1 / (s - starRingEnd ℂ (ρ ℓ)) + 1 / (s - ρ ℓ) := by
        simp only [gPair, hc2]
      rw [hg1, hg2]
      have hre_calc : ((1 / 2 : ℂ) * (1 / (s - ρ ℓ) + 1 / (s - starRingEnd ℂ (ρ ℓ)))).re +
          ((1 / 2 : ℂ) * (1 / (s - starRingEnd ℂ (ρ ℓ)) + 1 / (s - ρ ℓ))).re =
          (1 / (s - ρ ℓ)).re + (1 / (s - starRingEnd ℂ (ρ ℓ))).re := by
        have e : (1 / 2 : ℂ) * (1 / (s - ρ ℓ) + 1 / (s - starRingEnd ℂ (ρ ℓ))) +
            (1 / 2 : ℂ) * (1 / (s - starRingEnd ℂ (ρ ℓ)) + 1 / (s - ρ ℓ)) =
            1 / (s - ρ ℓ) + 1 / (s - starRingEnd ℂ (ρ ℓ)) := by ring
        have := congrArg Complex.re e
        simpa only [Complex.add_re] using this
      linarith
    · -- Off-critical zero: `orbPts ℓ` has 4 distinct elements.
      have hne13 : ρ ℓ ≠ 1 - ρ ℓ := fun h => by
        have := congrArg Complex.im h; simp at this; linarith
      have hne14 : ρ ℓ ≠ 1 - starRingEnd ℂ (ρ ℓ) := fun h => by
        have := congrArg Complex.re h; simp at this; apply hcrit; linarith
      have hne23 : starRingEnd ℂ (ρ ℓ) ≠ 1 - ρ ℓ := fun h => by
        have := congrArg Complex.re h; simp at this; apply hcrit; linarith
      have hne24 : starRingEnd ℂ (ρ ℓ) ≠ 1 - starRingEnd ℂ (ρ ℓ) := fun h => by
        have := congrArg Complex.im h; simp at this; linarith
      have hne34 : 1 - ρ ℓ ≠ 1 - starRingEnd ℂ (ρ ℓ) := fun h =>
        hne_conj (by linear_combination -h)
      have hm1' : ρ ℓ ∉ ({starRingEnd ℂ (ρ ℓ), 1 - ρ ℓ, 1 - starRingEnd ℂ (ρ ℓ)} : Finset ℂ) := by
        simp [hne_conj, hne13, hne14]
      have hm2' : starRingEnd ℂ (ρ ℓ) ∉ ({1 - ρ ℓ, 1 - starRingEnd ℂ (ρ ℓ)} : Finset ℂ) := by
        simp [hne23, hne24]
      have hm3' : 1 - ρ ℓ ∉ ({1 - starRingEnd ℂ (ρ ℓ)} : Finset ℂ) := by simp [hne34]
      simp only [orbPts]
      rw [Finset.sum_insert hm1', Finset.sum_insert hm2', Finset.sum_insert hm3',
        Finset.sum_singleton]
      have hρ_zero : Λ (ρ ℓ) = 0 :=
        hS.eq_zero_of_one_le_order_toNat (hm1.trans (hm ℓ))
      obtain ⟨hre0, _⟩ := hS.zero_re_mem_Icc hρ_zero
      have hnn1 : 0 ≤ (1 / (s - (1 - ρ ℓ))).re :=
        re_one_div_nonneg_of_re_le (by simp; linarith)
      have hnn2 : 0 ≤ (1 / (s - (1 - starRingEnd ℂ (ρ ℓ)))).re :=
        re_one_div_nonneg_of_re_le (by simp; linarith)
      have hsum4 : ((1 / 2 : ℂ) * gPair (ρ ℓ) s).re +
          (((1 / 2 : ℂ) * gPair (starRingEnd ℂ (ρ ℓ)) s).re +
            (((1 / 2 : ℂ) * gPair (1 - ρ ℓ) s).re +
              ((1 / 2 : ℂ) * gPair (1 - starRingEnd ℂ (ρ ℓ)) s).re)) =
          (1 / (s - ρ ℓ)).re + (1 / (s - starRingEnd ℂ (ρ ℓ))).re +
            (1 / (s - (1 - ρ ℓ))).re + (1 / (s - (1 - starRingEnd ℂ (ρ ℓ)))).re := by
        have e : (1 / 2 : ℂ) * gPair (ρ ℓ) s +
            ((1 / 2 : ℂ) * gPair (starRingEnd ℂ (ρ ℓ)) s +
              ((1 / 2 : ℂ) * gPair (1 - ρ ℓ) s +
                (1 / 2 : ℂ) * gPair (1 - starRingEnd ℂ (ρ ℓ)) s)) =
            1 / (s - ρ ℓ) + 1 / (s - starRingEnd ℂ (ρ ℓ)) +
              1 / (s - (1 - ρ ℓ)) + 1 / (s - (1 - starRingEnd ℂ (ρ ℓ))) := by
          simp only [gPair, sub_sub_cancel]; ring
        have := congrArg Complex.re e
        simpa only [Complex.add_re] using this
      linarith
  have htotal : ∑ ℓ, ∑ q ∈ orbCopies ℓ, term q =
      ∑ q ∈ Finset.univ.biUnion orbCopies, term q :=
    (Finset.sum_biUnion fun ℓ _ ℓ' _ hne => horb_disj hne).symm
  calc ∑ ℓ, (m ℓ : ℝ) * ((1 / (s - ρ ℓ)).re + (1 / (s - starRingEnd ℂ (ρ ℓ))).re)
      ≤ ∑ ℓ, ∑ q ∈ orbCopies ℓ, term q := Finset.sum_le_sum fun ℓ _ => horb_le ℓ
    _ = ∑ q ∈ Finset.univ.biUnion orbCopies, term q := htotal
    _ ≤ (logDeriv Λ s).re := sum_le_hasSum (Finset.univ.biUnion orbCopies)
          (fun q _ => hterm_nonneg q) hsum_re

/-- **Master coupled strip pole–zero forcing law.** Evaluating multiplicative Gram positivity on
any finite height configuration `x : Fin n → ℝ` with nonnegative channel amplitudes
`c : Fin n → ℝ` (`c_j ≥ 0`) at `s_{j,k} = (1 + δ) + i(x_j − x_k)` (`δ > 0`) bounds the collective
zero-resolvent Gram form by the `κ`-pole and `d`-archimedean Gram forms. -/
theorem coupled_strip_pole_zero_forcing {κ d : ℕ} {F Λ : ℂ → ℂ}
    (hS : CompletedPositiveSystem κ d F Λ) {r : ℕ} (ρ : Fin r → ℂ) (m : Fin r → ℕ)
    (him : ∀ ℓ, 0 < (ρ ℓ).im)
    (hdist : ∀ ℓ ℓ', ℓ ≠ ℓ' → (ρ ℓ).im ≠ (ρ ℓ').im)
    (hm : ∀ ℓ, m ℓ ≤ (analyticOrderAt Λ (ρ ℓ)).toNat)
    {n : ℕ} (x c : Fin n → ℝ) (hc : ∀ j, 0 ≤ c j) {δ : ℝ} (hδ : 0 < δ) :
    ∑ ℓ, (m ℓ : ℝ) * ∑ j, ∑ k, c j * c k *
        ((1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - ρ ℓ)).re +
          (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - starRingEnd ℂ (ρ ℓ))).re) ≤
      (κ : ℝ) * ∑ j, ∑ k, c j * c k *
          (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I) +
            1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - 1)).re +
        (d : ℝ) * ∑ j, ∑ k, c j * c k *
          (logDeriv Complex.Gammaℝ (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re := by
  have hσ : 1 < 1 + δ := by linarith
  have hgram : 0 ≤ ∑ j, ∑ k, c j * c k *
      (-logDeriv F (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re :=
    (hS.posDef_neg_logDeriv hσ).posDef n x c
  -- Pointwise bound at each channel pair `(j, k)`.
  have hpt : ∀ j k : Fin n,
      c j * c k *
        (∑ ℓ, (m ℓ : ℝ) *
          ((1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - ρ ℓ)).re +
            (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - starRingEnd ℂ (ρ ℓ))).re)) ≤
      c j * c k *
        ((κ : ℝ) * (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I) +
            1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - 1)).re +
          (d : ℝ) * (logDeriv Complex.Gammaℝ
            (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re -
          (-logDeriv F (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re) := by
    intro j k
    refine mul_le_mul_of_nonneg_left ?_ (mul_nonneg (hc j) (hc k))
    set s : ℂ := ((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I
    have hs : 1 < s.re := by simp [s]; linarith
    have horb := sum_orbit_resolvent_le_re_logDeriv hS ρ m him hdist hm hs
    have hdecomp := congrArg Complex.re (hS.neg_logDeriv_F_eq hs)
    have hre_eq : ((κ : ℂ) * (1 / s + 1 / (s - 1)) +
        (d : ℂ) * logDeriv Complex.Gammaℝ s - logDeriv Λ s).re =
        (κ : ℝ) * (1 / s + 1 / (s - 1)).re +
          (d : ℝ) * (logDeriv Complex.Gammaℝ s).re - (logDeriv Λ s).re := by
      rw [Complex.sub_re, Complex.add_re]
      have h1 : ((κ : ℂ) * (1 / s + 1 / (s - 1))).re = (κ : ℝ) * (1 / s + 1 / (s - 1)).re := by
        rw [← Complex.ofReal_natCast, Complex.re_ofReal_mul]
      have h2 : ((d : ℂ) * logDeriv Complex.Gammaℝ s).re =
          (d : ℝ) * (logDeriv Complex.Gammaℝ s).re := by
        rw [← Complex.ofReal_natCast, Complex.re_ofReal_mul]
      rw [h1, h2]
    rw [hre_eq] at hdecomp
    linarith
  -- Sum over `(j, k)` and rearrange finite sums.
  have hsum := Finset.sum_le_sum (s := Finset.univ) fun j _ =>
    Finset.sum_le_sum (s := Finset.univ) fun k _ => hpt j k
  have hlhs : (∑ ℓ, (m ℓ : ℝ) * ∑ j, ∑ k, c j * c k *
        ((1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - ρ ℓ)).re +
          (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - starRingEnd ℂ (ρ ℓ))).re)) =
      ∑ j, ∑ k, c j * c k * ∑ ℓ, (m ℓ : ℝ) *
        ((1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - ρ ℓ)).re +
          (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - starRingEnd ℂ (ρ ℓ))).re) := by
    simp_rw [Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun ℓ _ => ?_
    ring
  have hrhs : (∑ j, ∑ k, c j * c k *
        ((κ : ℝ) * (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I) +
            1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - 1)).re +
          (d : ℝ) * (logDeriv Complex.Gammaℝ
            (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re -
          (-logDeriv F (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re)) =
      (κ : ℝ) * (∑ j, ∑ k, c j * c k *
          (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I) +
            1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - 1)).re) +
        (d : ℝ) * (∑ j, ∑ k, c j * c k *
          (logDeriv Complex.Gammaℝ (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re) -
        ∑ j, ∑ k, c j * c k *
          (-logDeriv F (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re := by
    simp_rw [Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun k _ => ?_
    ring
  rw [hlhs]
  linarith [hsum, hrhs, hgram]

/-! ### 3. Uniform archimedean bound and restricted width extraction -/

/-- **All-height archimedean real-part bound.** For every `σ ∈ [1, 2]` and EVERY height `t ∈ ℝ`
(including `|t| < 4`), shifting `ψ(s/2)` twice via `ψ(z + 1) = ψ(z) + 1/z` into `Re ≥ 5/2` and
applying the first-order digamma asymptotic yields
`Re(Γ_ℝ'/Γ_ℝ)(σ + it) ≤ log(3 + |t|) / 2 + 1 / 4`. -/
theorem re_logDeriv_Gammaℝ_le_all_heights {σ t : ℝ} (hσ1 : 1 ≤ σ) (hσ2 : σ ≤ 2) :
    (logDeriv Complex.Gammaℝ ((σ : ℂ) + (t : ℂ) * I)).re ≤ Real.log (3 + |t|) / 2 + 1 / 4 := by
  set s : ℂ := (σ : ℂ) + (t : ℂ) * I with hsdef
  set z : ℂ := s / 2 with hzdef
  have hsre : s.re = σ := by simp [hsdef]
  have hsim : s.im = t := by simp [hsdef]
  have hzre : z.re = σ / 2 := by rw [hzdef, Complex.div_ofNat_re, hsre]
  have hzim : z.im = t / 2 := by rw [hzdef, Complex.div_ofNat_im, hsim]
  have hne0 : ∀ m : ℕ, z ≠ -(m : ℂ) := by
    intro m hm
    have hc := congrArg Complex.re hm
    simp only [hzre, Complex.neg_re, Complex.natCast_re] at hc
    have : (0 : ℝ) ≤ m := Nat.cast_nonneg m
    linarith
  have hne1 : ∀ m : ℕ, z + 1 ≠ -(m : ℂ) := by
    intro m hm
    have hc := congrArg Complex.re hm
    simp only [Complex.add_re, hzre, Complex.one_re, Complex.neg_re, Complex.natCast_re] at hc
    have : (0 : ℝ) ≤ m := Nat.cast_nonneg m
    linarith
  have hd1 := congrArg Complex.re (Complex.digamma_apply_add_one z hne0)
  have hd2 := congrArg Complex.re (Complex.digamma_apply_add_one (z + 1) hne1)
  rw [Complex.add_re] at hd1 hd2
  have hinv0 : 0 ≤ (z⁻¹).re := by
    rw [Complex.inv_re]; exact div_nonneg (by linarith) (Complex.normSq_nonneg _)
  have hinv1 : 0 ≤ ((z + 1)⁻¹).re := by
    rw [Complex.inv_re, Complex.add_re, Complex.one_re]
    exact div_nonneg (by linarith) (Complex.normSq_nonneg _)
  set w : ℂ := z + 1 + 1
  have hwre : w.re = σ / 2 + 2 := by simp [w, hzre]; ring
  have hwim : w.im = t / 2 := by simp [w, hzim]
  have hwnorm_lo : (5 / 2 : ℝ) ≤ ‖w‖ := by
    calc (5 / 2 : ℝ) ≤ σ / 2 + 2 := by linarith
      _ = w.re := hwre.symm
      _ ≤ ‖w‖ := Complex.re_le_norm w
  have hwnorm_hi : ‖w‖ ≤ 3 + |t| := by
    calc ‖w‖ ≤ |w.re| + |w.im| := Complex.norm_le_abs_re_add_abs_im w
      _ = (σ / 2 + 2) + |t| / 2 := by
          rw [hwre, abs_of_pos (by linarith), hwim, abs_div, abs_two]
      _ ≤ 3 + |t| := by linarith [abs_nonneg t]
  have hstir := norm_digamma_sub_log_le_of_re_pos (z := w) (by rw [hwre]; linarith)
    (by linarith)
  have hwpos : 0 < ‖w‖ := by linarith
  have hpsi_w : (Complex.digamma w).re ≤ Real.log (3 + |t|) + 6 / 5 := by
    have hle : (Complex.digamma w - Complex.log w).re ≤ 3 / ‖w‖ :=
      (Complex.re_le_norm _).trans hstir
    rw [Complex.sub_re, Complex.log_re] at hle
    have hlog_le : Real.log ‖w‖ ≤ Real.log (3 + |t|) := Real.log_le_log hwpos hwnorm_hi
    have hdiv_le : 3 / ‖w‖ ≤ 6 / 5 := by
      rw [div_le_div_iff₀ hwpos (by norm_num)]
      linarith
    linarith
  have hpi : (1 : ℝ) ≤ Real.log Real.pi := by
    have h3 : Real.exp 1 < Real.pi := lt_trans (by linarith [Real.exp_one_lt_d9]) Real.pi_gt_three
    have h := Real.log_lt_log (Real.exp_pos 1) h3
    rw [Real.log_exp] at h
    exact h.le
  have hG : logDeriv Complex.Gammaℝ s =
      Complex.digamma z / 2 - ((Real.log Real.pi : ℝ) : ℂ) / 2 :=
    RHTower.logDeriv_Gammaℝ_digamma (by rw [hsre]; linarith)
  rw [hG]
  simp only [Complex.sub_re, Complex.div_ofNat_re, Complex.ofReal_re]
  linarith [hd1, hd2, hinv0, hinv1, hpsi_w, hpi]

/-- **Restricted pole–growth width extraction.** Whenever `0 ≤ A < B`, `0 < G`, `A ≤ G`, `0 ≤ η`,
and `B / (δ + η) ≤ A / δ + G` holds for every `δ ∈ (0, 1]`, the zero depth satisfies
`min 1 ((√B − √A)² / G) ≤ η`. Works uniformly for both `A = 0` (`κ = 0`) and `A > 0` (`κ ≥ 1`). -/
theorem width_ge_of_pole_growth_bound {A B G η : ℝ} (hA : 0 ≤ A) (hAB : A < B) (hG : 0 < G)
    (hAG : A ≤ G) (hη : 0 ≤ η)
    (hbound : ∀ δ : ℝ, 0 < δ → δ ≤ 1 → B / (δ + η) ≤ A / δ + G) :
    min 1 ((Real.sqrt B - Real.sqrt A) ^ 2 / G) ≤ η := by
  by_contra hlt
  rw [not_le] at hlt
  have hη1 : η < 1 := lt_of_lt_of_le hlt (min_le_left _ _)
  have hηw : η < (Real.sqrt B - Real.sqrt A) ^ 2 / G := lt_of_lt_of_le hlt (min_le_right _ _)
  have hB0 : 0 < B := lt_of_le_of_lt hA hAB
  rcases eq_or_lt_of_le hA with rfl | hA_pos
  · -- Case `A = 0`: `B / (δ + η) ≤ G` fails as `δ ↓ 0` since `G η < B`.
    rw [Real.sqrt_zero, sub_zero, Real.sq_sqrt hB0.le] at hηw
    have hGη : G * η < B := by linarith [(lt_div_iff₀ hG).mp hηw]
    set δ := min 1 ((B - G * η) / (2 * G))
    have hδ0 : 0 < δ := lt_min zero_lt_one (div_pos (by linarith) (by positivity))
    have hδ1 : δ ≤ 1 := min_le_left _ _
    have hδ2 : δ ≤ (B - G * η) / (2 * G) := min_le_right _ _
    have hb := hbound δ hδ0 hδ1
    rw [zero_div, zero_add] at hb
    have hmul : B ≤ G * (δ + η) := (div_le_iff₀ (by linarith)).mp hb
    have hGδ : G * δ ≤ (B - G * η) / 2 := by
      have := mul_le_mul_of_nonneg_left hδ2 hG.le
      have he : G * ((B - G * η) / (2 * G)) = (B - G * η) / 2 := by field_simp
      linarith
    linarith
  · -- Case `A > 0`: first rule out `η = 0`, then apply `exclusion_at_geometric_mean`.
    rcases eq_or_lt_of_le hη with rfl | hη_pos
    · set δ := min 1 ((B - A) / (2 * G))
      have hδ0 : 0 < δ := lt_min zero_lt_one (div_pos (by linarith) (by positivity))
      have hδ1 : δ ≤ 1 := min_le_left _ _
      have hδ2 : δ ≤ (B - A) / (2 * G) := min_le_right _ _
      have hb := hbound δ hδ0 hδ1
      rw [add_zero] at hb
      have hmul : B ≤ A + G * δ := by
        have := mul_le_mul_of_nonneg_right hb hδ0.le
        rwa [div_mul_cancel₀ _ hδ0.ne', add_mul, div_mul_cancel₀ _ hδ0.ne'] at this
      have hGδ : G * δ ≤ (B - A) / 2 := by
        have := mul_le_mul_of_nonneg_left hδ2 hG.le
        have he : G * ((B - A) / (2 * G)) = (B - A) / 2 := by field_simp
        linarith
      linarith
    · have hsAB : Real.sqrt A < Real.sqrt B := Real.sqrt_lt_sqrt hA_pos.le hAB
      have hGη : G * η < (Real.sqrt B - Real.sqrt A) ^ 2 := by
        have := (lt_div_iff₀ hG).mp hηw; linarith
      have hsqrt_lt : Real.sqrt (G * η) < Real.sqrt B - Real.sqrt A := by
        rw [← Real.sqrt_sq (sub_nonneg.mpr hsAB.le)]
        exact Real.sqrt_lt_sqrt (by positivity) hGη
      have hcond : Real.sqrt A + Real.sqrt (G * η) < Real.sqrt B := by linarith
      set δ := Real.sqrt A * Real.sqrt (G * η) / G
      have hδ0 : 0 < δ := by positivity
      have hδ1 : δ ≤ 1 := by
        have hsq : (Real.sqrt A * Real.sqrt (G * η)) ^ 2 ≤ G ^ 2 := by
          rw [mul_pow, Real.sq_sqrt hA_pos.le, Real.sq_sqrt (by positivity)]
          calc A * (G * η) = (A * η) * G := by ring
            _ ≤ (G * 1) * G :=
              mul_le_mul_of_nonneg_right (mul_le_mul hAG hη1.le hη_pos.le hG.le) hG.le
            _ = G ^ 2 := by ring
        have hle : Real.sqrt A * Real.sqrt (G * η) ≤ G := by
          nlinarith [sq_nonneg (Real.sqrt A * Real.sqrt (G * η) - G),
            mul_pos (Real.sqrt_pos.mpr hA_pos) (Real.sqrt_pos.mpr (mul_pos hG hη_pos)), hG]
        exact (div_le_one hG).mpr hle
      have hexcl := exclusion_at_geometric_mean hA_pos hB0.le hG hη_pos hcond
      have hb := hbound δ hδ0 hδ1
      dsimp only [δ] at hb
      linarith [hb, hexcl]

/-! ### 4. Elementary resolvent estimates on `Re s = 1 + δ` -/

private theorem re_one_div_ofReal (x : ℝ) : (1 / (x : ℂ)).re = 1 / x := by
  rw [← Complex.ofReal_one, ← Complex.ofReal_div, Complex.ofReal_re]

private theorem re_one_div_le_one {δ u : ℝ} (hδ : 0 < δ) :
    (1 / (((1 + δ : ℝ) : ℂ) + (u : ℂ) * I)).re ≤ 1 := by
  set s : ℂ := ((1 + δ : ℝ) : ℂ) + (u : ℂ) * I
  have hsre : s.re = 1 + δ := by simp [s]
  have hnsq : (1 + δ) ^ 2 ≤ Complex.normSq s := by
    rw [Complex.normSq_apply]; simp [s]; nlinarith [sq_nonneg u]
  rw [one_div, Complex.inv_re, hsre]
  rw [div_le_one (by nlinarith)]
  nlinarith

private theorem re_pole_one_eq_of_zero {δ : ℝ} (_hδ : 0 < δ) :
    (1 / (((1 + δ : ℝ) : ℂ) + ((0 : ℝ) : ℂ) * I - 1)).re = 1 / δ := by
  have he : ((1 + δ : ℝ) : ℂ) + ((0 : ℝ) : ℂ) * I - 1 = (δ : ℂ) := by push_cast; ring
  rw [he, re_one_div_ofReal]

private theorem re_pole_one_le_inv_sq {δ u : ℝ} (_hδ0 : 0 < δ) (_hδ1 : δ ≤ 1) (hu : u ≠ 0) :
    (1 / (((1 + δ : ℝ) : ℂ) + (u : ℂ) * I - 1)).re ≤ 1 / u ^ 2 := by
  have he : ((1 + δ : ℝ) : ℂ) + (u : ℂ) * I - 1 = (δ : ℂ) + (u : ℂ) * I := by push_cast; ring
  have hu2 : 0 < u ^ 2 := sq_pos_of_ne_zero hu
  rw [he, one_div, Complex.inv_re]
  have hre : ((δ : ℂ) + (u : ℂ) * I).re = δ := by simp
  have hnsq : Complex.normSq ((δ : ℂ) + (u : ℂ) * I) = δ ^ 2 + u ^ 2 := by
    rw [Complex.normSq_apply]; simp; ring
  rw [hre, hnsq, div_le_div_iff₀ (by positivity) hu2]
  nlinarith [sq_nonneg δ]

private theorem re_zero_resonant_ge {δ η : ℝ} (hδ : 0 < δ) {ρ : ℂ}
    (hρ1 : ρ.re ≤ 1) (hη : 1 - ρ.re ≤ η) :
    1 / (δ + η) ≤
      (1 / (((1 + δ : ℝ) : ℂ) + ((ρ.im : ℝ) : ℂ) * I - ρ)).re := by
  have he : ((1 + δ : ℝ) : ℂ) + ((ρ.im : ℝ) : ℂ) * I - ρ = ((δ + (1 - ρ.re) : ℝ) : ℂ) := by
    (apply Complex.ext <;> simp); ring
  rw [he, re_one_div_ofReal]
  exact one_div_le_one_div_of_le (by linarith) (by linarith)

private theorem re_conj_zero_resonant_ge {δ η : ℝ} (hδ : 0 < δ) {ρ : ℂ}
    (hρ1 : ρ.re ≤ 1) (hη : 1 - ρ.re ≤ η) :
    1 / (δ + η) ≤
      (1 / (((1 + δ : ℝ) : ℂ) + ((-(ρ.im) : ℝ) : ℂ) * I - starRingEnd ℂ ρ)).re := by
  have he : ((1 + δ : ℝ) : ℂ) + ((-(ρ.im) : ℝ) : ℂ) * I - starRingEnd ℂ ρ =
      ((δ + (1 - ρ.re) : ℝ) : ℂ) := by
    (apply Complex.ext <;> simp); ring
  rw [he, re_one_div_ofReal]
  exact one_div_le_one_div_of_le (by linarith) (by linarith)

/-! ### 5. Sharp collective half-pole interior forcing (`κ < 2 * ∑ ℓ, m ℓ`) -/

/-- Slow-doubling Følner Finset in the nonnegative height semigroup generated by `γ : Fin r → ℝ`
(`γ ℓ > 0`): since `|{0, …, k}^r| = (k + 1)^r` grows polynomially while `(1 + 1/(4M))^k` grows
exponentially, some scale `k` has shift-overlap `≥ (1 − 1/(4M)) |A|` simultaneously for all `r`
shifts `γ ℓ`. -/
private theorem exists_folner_height_finset {r M : ℕ} (hM1 : 1 ≤ M) (γ : Fin r → ℝ)
    (hγ : ∀ ℓ, 0 < γ ℓ) :
    ∃ (A : Finset ℝ) (H : ℝ),
      1 ≤ A.card ∧ 0 ≤ H ∧ (∀ a ∈ A, 0 ≤ a ∧ a ≤ H) ∧
      ∀ ℓ : Fin r,
        (1 - 1 / (4 * (M : ℝ))) * (A.card : ℝ) ≤
          ((A.filter fun y => y + γ ℓ ∈ A).card : ℝ) := by
  classical
  let box : ℕ → Finset (Fin r → ℕ) := fun k => Fintype.piFinset fun _ => Finset.range (k + 1)
  let val : (Fin r → ℕ) → ℝ := fun v => ∑ ℓ, (v ℓ : ℝ) * γ ℓ
  let S : ℕ → Finset ℝ := fun k => (box k).image val
  have h0_mem : ∀ k, (0 : ℝ) ∈ S k := by
    intro k
    refine Finset.mem_image.mpr ⟨fun _ => 0, ?_, by simp [val]⟩
    simp [box, Fintype.mem_piFinset]
  have hS_pos : ∀ k, 1 ≤ (S k).card := fun k => Finset.card_pos.mpr ⟨0, h0_mem k⟩
  have hS_upper : ∀ k, (S k).card ≤ (k + 1) ^ r := by
    intro k
    calc (S k).card ≤ (box k).card := Finset.card_image_le
      _ = (k + 1) ^ r := by simp [box, Fintype.card_piFinset, Finset.card_range]
  have hS_mono : ∀ k, S k ⊆ S (k + 1) := by
    intro k x hx
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hx
    refine Finset.mem_image.mpr ⟨v, ?_, rfl⟩
    rw [Fintype.mem_piFinset] at hv ⊢
    intro ℓ
    exact Finset.mem_range.mpr (lt_trans (Finset.mem_range.mp (hv ℓ)) (Nat.lt_succ_self _))
  have hS_shift : ∀ k ℓ x, x ∈ S k → x + γ ℓ ∈ S (k + 1) := by
    intro k ℓ x hx
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hx
    rw [Fintype.mem_piFinset] at hv
    refine Finset.mem_image.mpr ⟨Function.update v ℓ (v ℓ + 1), ?_, ?_⟩
    · rw [Fintype.mem_piFinset]
      intro i
      rcases eq_or_ne i ℓ with rfl | hne
      · simp only [Function.update_self, Finset.mem_range]
        have := Finset.mem_range.mp (hv i); omega
      · simp only [Function.update_of_ne hne]
        exact Finset.mem_range.mpr (lt_trans (Finset.mem_range.mp (hv i)) (Nat.lt_succ_self _))
    · have hdiff : val (Function.update v ℓ (v ℓ + 1)) - val v = γ ℓ := by
        simp only [val, ← Finset.sum_sub_distrib, ← sub_mul]
        rw [Finset.sum_eq_single ℓ]
        · simp [Function.update_self]
        · intro i _ hne; simp [Function.update_of_ne hne]
        · intro hnot; exact absurd (Finset.mem_univ ℓ) hnot
      linarith
  have hS_bounds : ∀ k x, x ∈ S k → 0 ≤ x ∧ x ≤ (k : ℝ) * ∑ ℓ, γ ℓ := by
    intro k x hx
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hx
    rw [Fintype.mem_piFinset] at hv
    refine ⟨Finset.sum_nonneg fun ℓ _ => mul_nonneg (Nat.cast_nonneg _) (hγ ℓ).le, ?_⟩
    rw [Finset.mul_sum]
    refine Finset.sum_le_sum fun ℓ _ => mul_le_mul_of_nonneg_right ?_ (hγ ℓ).le
    have hlt := Finset.mem_range.mp (hv ℓ)
    exact_mod_cast Nat.lt_succ_iff.mp hlt
  set q : ℝ := 1 + 1 / (4 * (M : ℝ))
  have hM_pos_r : (0 : ℝ) < M := by exact_mod_cast hM1
  have hq1 : 1 < q := lt_add_of_pos_right 1 (by positivity)
  obtain ⟨k, hk_slow⟩ : ∃ k : ℕ, ((S (k + 1)).card : ℝ) ≤ q * ((S k).card : ℝ) := by
    by_contra hall
    push Not at hall
    have hgeom : ∀ n : ℕ, q ^ n ≤ ((S n).card : ℝ) := by
      intro n
      have hg := geom_le (u := fun j => ((S j).card : ℝ)) (zero_le_one.trans hq1.le) n
        (fun j _ => (hall j).le)
      have h0 : (1 : ℝ) ≤ ((S 0).card : ℝ) := by exact_mod_cast hS_pos 0
      nlinarith [pow_nonneg (zero_le_one.trans hq1.le) n]
    have htend := (tendsto_pow_const_div_const_pow_of_one_lt r hq1).eventually
      (gt_mem_nhds (by positivity : (0 : ℝ) < 1 / q))
    obtain ⟨N, hN⟩ := eventually_atTop.mp htend
    have hlt := hN (N + 1) (Nat.le_succ N)
    have hge : 1 / q ≤ (((N + 1 : ℕ) : ℝ) ^ r) / q ^ (N + 1) := by
      have h1 : q ^ N ≤ (((N + 1 : ℕ) : ℝ) ^ r) :=
        (hgeom N).trans (by exact_mod_cast hS_upper N)
      have hqpos : 0 < q ^ (N + 1) := pow_pos (zero_lt_one.trans hq1) _
      rw [div_le_div_iff₀ (zero_lt_one.trans hq1) hqpos, one_mul, pow_succ]
      exact mul_le_mul_of_nonneg_right h1 (zero_le_one.trans hq1.le)
    linarith [hlt, hge]
  refine ⟨S k, (k : ℝ) * ∑ ℓ, γ ℓ, hS_pos k,
    mul_nonneg (Nat.cast_nonneg k) (Finset.sum_nonneg fun ℓ _ => (hγ ℓ).le),
    fun x hx => hS_bounds k x hx, fun ℓ => ?_⟩
  set Tℓ : Finset ℝ := (S k).filter fun y => y + γ ℓ ∈ S k
  have hsub_compl : ((S k \ Tℓ).image fun y => y + γ ℓ) ⊆ S (k + 1) \ S k := by
    intro z hz
    obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hz
    rw [Finset.mem_sdiff, Finset.mem_filter] at hy
    exact Finset.mem_sdiff.mpr ⟨hS_shift k ℓ y hy.1, fun hmem => hy.2 ⟨hy.1, hmem⟩⟩
  have hinj : Set.InjOn (fun y : ℝ => y + γ ℓ) ↑(S k \ Tℓ) := fun y₁ _ y₂ _ h => by linarith
  have hcard_le : (S k \ Tℓ).card ≤ (S (k + 1) \ S k).card := by
    rw [← Finset.card_image_of_injOn hinj]
    exact Finset.card_le_card hsub_compl
  have hT_sub : Tℓ ⊆ S k := Finset.filter_subset _ _
  have hs1 : (S k \ Tℓ).card = (S k).card - Tℓ.card := by
    rw [Finset.card_sdiff, Finset.inter_eq_left.mpr hT_sub]
  have hs2 : (S (k + 1) \ S k).card = (S (k + 1)).card - (S k).card := by
    rw [Finset.card_sdiff, Finset.inter_eq_left.mpr (hS_mono k)]
  have hle1 : Tℓ.card ≤ (S k).card := Finset.card_le_card hT_sub
  have hle2 : (S k).card ≤ (S (k + 1)).card := Finset.card_le_card (hS_mono k)
  have hnat : (S k).card - Tℓ.card ≤ (S (k + 1)).card - (S k).card := by rwa [← hs1, ← hs2]
  have hreal : ((S k).card : ℝ) - (Tℓ.card : ℝ) ≤ ((S (k + 1)).card : ℝ) - ((S k).card : ℝ) := by
    have : (S k).card + (S k).card ≤ (S (k + 1)).card + Tℓ.card := by omega
    have hr : ((S k).card : ℝ) + ((S k).card : ℝ) ≤
        ((S (k + 1)).card : ℝ) + (Tℓ.card : ℝ) := by exact_mod_cast this
    linarith
  dsimp only [q] at hk_slow
  linarith [hk_slow, hreal]

/-- Indexed channel configuration extracted from `exists_folner_height_finset`, packaging the
injective height tuple `x : Fin n → ℝ` and the `+γ_ℓ` / `−γ_ℓ` resonant index-pair Finsets so no
combinatorial definitions unfold during analytic Gram estimates. -/
private theorem exists_folner_channel_config {r M : ℕ} (hM1 : 1 ≤ M) (γ : Fin r → ℝ)
    (hγ : ∀ ℓ, 0 < γ ℓ) :
    ∃ (n : ℕ) (x : Fin n → ℝ) (H : ℝ),
      1 ≤ n ∧ 0 ≤ H ∧ Function.Injective x ∧ (∀ j, 0 ≤ x j ∧ x j ≤ H) ∧
      ∀ ℓ : Fin r,
        (∃ P : Finset (Fin n × Fin n),
          (1 - 1 / (4 * (M : ℝ))) * (n : ℝ) ≤ (P.card : ℝ) ∧
          ∀ p ∈ P, x p.1 - x p.2 = γ ℓ) ∧
        (∃ Q : Finset (Fin n × Fin n),
          (1 - 1 / (4 * (M : ℝ))) * (n : ℝ) ≤ (Q.card : ℝ) ∧
          ∀ q ∈ Q, x q.1 - x q.2 = -γ ℓ) := by
  classical
  obtain ⟨A, H, hA1, hH0, hAb, hT⟩ := exists_folner_height_finset hM1 γ hγ
  let e : Fin A.card ≃ A := A.equivFin.symm
  refine ⟨A.card, fun j => (e j : ℝ), H, hA1, hH0, ?_, fun j => hAb (e j) (e j).2, fun ℓ => ?_⟩
  · intro j₁ j₂ h
    exact e.injective (Subtype.ext h)
  · set Tℓ : Finset ℝ := A.filter fun y => y + γ ℓ ∈ A
    have hcard_Tℓ : ((Finset.univ : Finset {y : ℝ // y ∈ Tℓ}).card : ℝ) = (Tℓ.card : ℝ) := by
      rw [Finset.card_univ, Fintype.card_coe]
    let embPlus : {y : ℝ // y ∈ Tℓ} ↪ Fin A.card × Fin A.card :=
      ⟨fun y => (e.symm ⟨y.1 + γ ℓ, (Finset.mem_filter.mp y.2).2⟩,
          e.symm ⟨y.1, (Finset.mem_filter.mp y.2).1⟩),
        fun y₁ y₂ heq => by
          have h2 := congrArg (fun p : Fin A.card × Fin A.card => (e p.2 : ℝ)) heq
          simp only [Equiv.apply_symm_apply] at h2
          exact Subtype.ext h2⟩
    let embMinus : {y : ℝ // y ∈ Tℓ} ↪ Fin A.card × Fin A.card :=
      ⟨fun y => (e.symm ⟨y.1, (Finset.mem_filter.mp y.2).1⟩,
          e.symm ⟨y.1 + γ ℓ, (Finset.mem_filter.mp y.2).2⟩),
        fun y₁ y₂ heq => by
          have h1 := congrArg (fun p : Fin A.card × Fin A.card => (e p.1 : ℝ)) heq
          simp only [Equiv.apply_symm_apply] at h1
          exact Subtype.ext h1⟩
    refine ⟨⟨Finset.univ.map embPlus, ?_, ?_⟩, ⟨Finset.univ.map embMinus, ?_, ?_⟩⟩
    · rw [Finset.card_map, hcard_Tℓ]; exact hT ℓ
    · intro p hp
      obtain ⟨y, _, rfl⟩ := Finset.mem_map.mp hp
      simp only [embPlus, Equiv.apply_symm_apply, Function.Embedding.coeFn_mk]
      ring
    · rw [Finset.card_map, hcard_Tℓ]; exact hT ℓ
    · intro q hq
      obtain ⟨y, _, rfl⟩ := Finset.mem_map.mp hq
      simp only [embMinus, Equiv.apply_symm_apply, Function.Embedding.coeFn_mk]
      ring

private def uniformChannelWeight (n : ℕ) : Fin n → ℝ := fun _ => 1 / Real.sqrt n

private def folnerOffDiag {n : ℕ} (x : Fin n → ℝ) : ℝ :=
  ∑ j : Fin n, ∑ j' ∈ Finset.univ.erase j, 1 / (x j - x j') ^ 2

private def folnerGrowth (κ d n : ℕ) (x : Fin n → ℝ) (H : ℝ) : ℝ :=
  (κ : ℝ) * ((n : ℝ) + folnerOffDiag x / (n : ℝ)) +
    (n : ℝ) * (d : ℝ) * (Real.log (3 + H) / 2 + 1 / 4)

/-- **Collective half-pole interior forcing law.** Let `(κ, d, F, Λ)` be any completed positive
system and `ρ₁, …, ρ_r` be upper-half-plane zeros of `Λ` with pairwise distinct positive ordinates
and positive integer multiplicities `1 ≤ m_ℓ ≤ ord_{ρ_ℓ}(Λ)`. Whenever the collective multiplicity
beats half the pole order (`κ < 2 * ∑_ℓ m_ℓ`), multi-channel coupling over a slow-doubling Følner
Finset in the height subgroup generated by `(Im ρ_1, …, Im ρ_r)` forces at least one zero strictly
into the interior `Re ρ_ℓ ≤ 1 − w` (`w > 0`), with no linear-independence or separation hypothesis
on the ordinates. -/
theorem collective_half_pole_interior_forcing {κ d : ℕ} {F Λ : ℂ → ℂ}
    (hS : CompletedPositiveSystem κ d F Λ) {r : ℕ} (ρ : Fin r → ℂ) (m : Fin r → ℕ)
    (him : ∀ ℓ, 0 < (ρ ℓ).im)
    (hdist : ∀ ℓ ℓ', ℓ ≠ ℓ' → (ρ ℓ).im ≠ (ρ ℓ').im)
    (hm_pos : ∀ ℓ, 1 ≤ m ℓ)
    (hm : ∀ ℓ, m ℓ ≤ (analyticOrderAt Λ (ρ ℓ)).toNat)
    (hM : κ < 2 * ∑ ℓ, m ℓ) :
    ∃ w : ℝ, 0 < w ∧ ∃ ℓ : Fin r, (ρ ℓ).re ≤ 1 - w := by
  classical
  have hM1 : 1 ≤ ∑ ℓ, m ℓ := by omega
  have hr_pos : 0 < r := by
    rcases Nat.eq_zero_or_pos r with rfl | hpos
    · simp at hM1
    · exact hpos
  haveI : Nonempty (Fin r) := Fin.pos_iff_nonempty.mp hr_pos
  have hρ_strip : ∀ ℓ, 0 ≤ (ρ ℓ).re ∧ (ρ ℓ).re ≤ 1 := fun ℓ =>
    hS.zero_re_mem_Icc (hS.eq_zero_of_one_le_order_toNat ((hm_pos ℓ).trans (hm ℓ)))
  set η : ℝ := Finset.univ.sup' Finset.univ_nonempty (fun ℓ => 1 - (ρ ℓ).re)
  have hη_ge : ∀ ℓ, 1 - (ρ ℓ).re ≤ η := fun ℓ =>
    Finset.le_sup' (fun i => 1 - (ρ i).re) (mem_univ ℓ)
  obtain ⟨ℓ_max, _, hη_eq⟩ := Finset.exists_mem_eq_sup' Finset.univ_nonempty (fun ℓ => 1 - (ρ ℓ).re)
  have hη_nonneg : 0 ≤ η := by linarith [(hρ_strip ℓ_max).2, hη_ge ℓ_max]
  obtain ⟨n, x, H, hn1, hH_nn, hx_inj, hx_bounds, hres⟩ :=
    exists_folner_channel_config hM1 (fun ℓ => (ρ ℓ).im) him
  have hn_pos : (0 : ℝ) < n := by exact_mod_cast hn1
  have hn_ge1 : (1 : ℝ) ≤ n := by exact_mod_cast hn1
  have hinv_n_nn : (0 : ℝ) ≤ 1 / (n : ℝ) := one_div_nonneg.mpr hn_pos.le
  have hc_nn : ∀ j, 0 ≤ uniformChannelWeight n j := fun _ =>
    one_div_nonneg.mpr (Real.sqrt_nonneg _)
  have hcc : ∀ i j, uniformChannelWeight n i * uniformChannelWeight n j = 1 / (n : ℝ) :=
    fun _ _ => by
      simp only [uniformChannelWeight, one_div, ← mul_inv, Real.mul_self_sqrt hn_pos.le]
  have hoff_nn : 0 ≤ folnerOffDiag x := Finset.sum_nonneg fun j _ =>
    Finset.sum_nonneg fun j' _ => by positivity
  have hlog_nn : 0 ≤ Real.log (3 + H) := Real.log_nonneg (by linarith)
  have hd_ge1 : (1 : ℝ) ≤ d := by exact_mod_cast hS.degree_pos
  have hG_pos : 0 < folnerGrowth κ d n x H := by
    unfold folnerGrowth
    have h1 : (0 : ℝ) ≤ (κ : ℝ) * ((n : ℝ) + folnerOffDiag x / (n : ℝ)) :=
      mul_nonneg (Nat.cast_nonneg κ) (add_nonneg hn_pos.le (div_nonneg hoff_nn hn_pos.le))
    have h2 : (0 : ℝ) < (n : ℝ) * (d : ℝ) * (Real.log (3 + H) / 2 + 1 / 4) := by positivity
    linarith
  have hAG : (κ : ℝ) ≤ folnerGrowth κ d n x H := by
    unfold folnerGrowth
    have h1 : (κ : ℝ) ≤ (κ : ℝ) * ((n : ℝ) + folnerOffDiag x / (n : ℝ)) :=
      le_mul_of_one_le_right (Nat.cast_nonneg κ) (by linarith [div_nonneg hoff_nn hn_pos.le])
    have h2 : (0 : ℝ) ≤ (n : ℝ) * (d : ℝ) * (Real.log (3 + H) / 2 + 1 / 4) := by positivity
    linarith
  have hM_pos_r : (0 : ℝ) < ((∑ ℓ, m ℓ : ℕ) : ℝ) := by exact_mod_cast hM1
  have hmain_δ : ∀ δ : ℝ, 0 < δ → δ ≤ 1 →
      (2 * (((∑ ℓ, m ℓ : ℕ) : ℝ)) - 1 / 2) / (δ + η) ≤
        (κ : ℝ) / δ + folnerGrowth κ d n x H := by
    intro δ hδ0 hδ1
    have hforce := coupled_strip_pole_zero_forcing hS ρ m him hdist hm x
      (uniformChannelWeight n) hc_nn hδ0
    have hlhs_ℓ : ∀ ℓ,
        2 * (1 - 1 / (4 * (((∑ i, m i : ℕ) : ℝ)))) / (δ + η) ≤
          ∑ j, ∑ j', uniformChannelWeight n j * uniformChannelWeight n j' *
            ((1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I - ρ ℓ)).re +
              (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I -
                starRingEnd ℂ (ρ ℓ))).re) := by
      intro ℓ
      obtain ⟨⟨P, hP_card, hP_diff⟩, ⟨Q, hQ_card, hQ_diff⟩⟩ := hres ℓ
      have hterm_nn : ∀ j j' : Fin n,
          0 ≤ (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I - ρ ℓ)).re ∧
            0 ≤ (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I -
              starRingEnd ℂ (ρ ℓ))).re := fun j j' =>
        ⟨re_one_div_nonneg_of_re_le (by simp; linarith [(hρ_strip ℓ).2]),
          re_one_div_nonneg_of_re_le (by simp; linarith [(hρ_strip ℓ).2])⟩
      have hsplit : (∑ j, ∑ j', uniformChannelWeight n j * uniformChannelWeight n j' *
            ((1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I - ρ ℓ)).re +
              (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I -
                starRingEnd ℂ (ρ ℓ))).re)) =
          (1 / (n : ℝ)) * (∑ p ∈ (Finset.univ ×ˢ Finset.univ : Finset (Fin n × Fin n)),
            (1 / (((1 + δ : ℝ) : ℂ) + ((x p.1 - x p.2 : ℝ) : ℂ) * I - ρ ℓ)).re) +
          (1 / (n : ℝ)) * (∑ p ∈ (Finset.univ ×ˢ Finset.univ : Finset (Fin n × Fin n)),
            (1 / (((1 + δ : ℝ) : ℂ) + ((x p.1 - x p.2 : ℝ) : ℂ) * I -
              starRingEnd ℂ (ρ ℓ))).re) := by
        simp_rw [hcc, mul_add, Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.sum_product']
      rw [hsplit]
      have hsub1 : (P.card : ℝ) / (δ + η) ≤
          ∑ p ∈ (Finset.univ ×ˢ Finset.univ : Finset (Fin n × Fin n)),
            (1 / (((1 + δ : ℝ) : ℂ) + ((x p.1 - x p.2 : ℝ) : ℂ) * I - ρ ℓ)).re := by
        calc (P.card : ℝ) / (δ + η)
            = ∑ _p ∈ P, 1 / (δ + η) := by rw [Finset.sum_const, nsmul_eq_mul, mul_one_div]
          _ ≤ ∑ p ∈ P,
                (1 / (((1 + δ : ℝ) : ℂ) + ((x p.1 - x p.2 : ℝ) : ℂ) * I - ρ ℓ)).re := by
              refine Finset.sum_le_sum fun p hp => ?_
              rw [hP_diff p hp]
              exact re_zero_resonant_ge hδ0 (hρ_strip ℓ).2 (hη_ge ℓ)
          _ ≤ ∑ p ∈ (Finset.univ ×ˢ Finset.univ : Finset (Fin n × Fin n)),
                (1 / (((1 + δ : ℝ) : ℂ) + ((x p.1 - x p.2 : ℝ) : ℂ) * I - ρ ℓ)).re :=
              Finset.sum_le_sum_of_subset_of_nonneg (fun p _ => by simp)
                fun p _ _ => (hterm_nn p.1 p.2).1
      have hsub2 : (Q.card : ℝ) / (δ + η) ≤
          ∑ p ∈ (Finset.univ ×ˢ Finset.univ : Finset (Fin n × Fin n)),
            (1 / (((1 + δ : ℝ) : ℂ) + ((x p.1 - x p.2 : ℝ) : ℂ) * I -
              starRingEnd ℂ (ρ ℓ))).re := by
        calc (Q.card : ℝ) / (δ + η)
            = ∑ _q ∈ Q, 1 / (δ + η) := by rw [Finset.sum_const, nsmul_eq_mul, mul_one_div]
          _ ≤ ∑ q ∈ Q,
                (1 / (((1 + δ : ℝ) : ℂ) + ((x q.1 - x q.2 : ℝ) : ℂ) * I -
                  starRingEnd ℂ (ρ ℓ))).re := by
              refine Finset.sum_le_sum fun q hq => ?_
              rw [hQ_diff q hq]
              exact re_conj_zero_resonant_ge hδ0 (hρ_strip ℓ).2 (hη_ge ℓ)
          _ ≤ ∑ p ∈ (Finset.univ ×ˢ Finset.univ : Finset (Fin n × Fin n)),
                (1 / (((1 + δ : ℝ) : ℂ) + ((x p.1 - x p.2 : ℝ) : ℂ) * I -
                  starRingEnd ℂ (ρ ℓ))).re :=
              Finset.sum_le_sum_of_subset_of_nonneg (fun p _ => by simp)
                fun p _ _ => (hterm_nn p.1 p.2).2
      have hP_div : (1 - 1 / (4 * (((∑ i, m i : ℕ) : ℝ)))) / (δ + η) ≤
          (1 / (n : ℝ)) * ((P.card : ℝ) / (δ + η)) := by
        have h1 : 1 - 1 / (4 * (((∑ i, m i : ℕ) : ℝ))) ≤ (1 / (n : ℝ)) * (P.card : ℝ) := by
          rw [one_div_mul_eq_div, le_div_iff₀ hn_pos]; exact hP_card
        have h2 := div_le_div_of_nonneg_right h1 (by linarith : (0 : ℝ) ≤ δ + η)
        rwa [mul_div_assoc] at h2
      have hQ_div : (1 - 1 / (4 * (((∑ i, m i : ℕ) : ℝ)))) / (δ + η) ≤
          (1 / (n : ℝ)) * ((Q.card : ℝ) / (δ + η)) := by
        have h1 : 1 - 1 / (4 * (((∑ i, m i : ℕ) : ℝ))) ≤ (1 / (n : ℝ)) * (Q.card : ℝ) := by
          rw [one_div_mul_eq_div, le_div_iff₀ hn_pos]; exact hQ_card
        have h2 := div_le_div_of_nonneg_right h1 (by linarith : (0 : ℝ) ≤ δ + η)
        rwa [mul_div_assoc] at h2
      have hm1 := mul_le_mul_of_nonneg_left hsub1 hinv_n_nn
      have hm2 := mul_le_mul_of_nonneg_left hsub2 hinv_n_nn
      have htwo : 2 * (1 - 1 / (4 * (((∑ i, m i : ℕ) : ℝ)))) / (δ + η) =
          (1 - 1 / (4 * (((∑ i, m i : ℕ) : ℝ)))) / (δ + η) +
            (1 - 1 / (4 * (((∑ i, m i : ℕ) : ℝ)))) / (δ + η) := by ring
      linarith
    have hlhs : (2 * (((∑ ℓ, m ℓ : ℕ) : ℝ)) - 1 / 2) / (δ + η) ≤
        ∑ ℓ, (m ℓ : ℝ) * ∑ j, ∑ j', uniformChannelWeight n j * uniformChannelWeight n j' *
          ((1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I - ρ ℓ)).re +
            (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I -
              starRingEnd ℂ (ρ ℓ))).re) := by
      have hsum_m : (∑ ℓ, (m ℓ : ℝ)) = (((∑ ℓ, m ℓ : ℕ) : ℝ)) := by push_cast; rfl
      have halg : (((∑ ℓ, m ℓ : ℕ) : ℝ)) *
          (2 * (1 - 1 / (4 * (((∑ i, m i : ℕ) : ℝ)))) / (δ + η)) =
          (2 * (((∑ ℓ, m ℓ : ℕ) : ℝ)) - 1 / 2) / (δ + η) := by
        have hMne : (((∑ i, m i : ℕ) : ℝ)) ≠ 0 := hM_pos_r.ne'
        field_simp; ring
      calc (2 * (((∑ ℓ, m ℓ : ℕ) : ℝ)) - 1 / 2) / (δ + η)
          = (∑ ℓ, (m ℓ : ℝ)) *
              (2 * (1 - 1 / (4 * (((∑ i, m i : ℕ) : ℝ)))) / (δ + η)) := by
              rw [hsum_m]; exact halg.symm
        _ = ∑ ℓ, (m ℓ : ℝ) *
              (2 * (1 - 1 / (4 * (((∑ i, m i : ℕ) : ℝ)))) / (δ + η)) := Finset.sum_mul _ _ _
        _ ≤ ∑ ℓ, (m ℓ : ℝ) * ∑ j, ∑ j', uniformChannelWeight n j * uniformChannelWeight n j' *
              ((1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I - ρ ℓ)).re +
                (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I -
                  starRingEnd ℂ (ρ ℓ))).re) :=
            Finset.sum_le_sum fun ℓ _ => mul_le_mul_of_nonneg_left (hlhs_ℓ ℓ) (Nat.cast_nonneg _)
    have hpole_bound :
        ∑ j, ∑ j', uniformChannelWeight n j * uniformChannelWeight n j' *
          (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I) +
            1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I - 1)).re ≤
        1 / δ + (n : ℝ) + folnerOffDiag x / (n : ℝ) := by
      have hsplit_pole :
          (∑ j, ∑ j', uniformChannelWeight n j * uniformChannelWeight n j' *
            (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I) +
              1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I - 1)).re) =
          (1 / (n : ℝ)) * (∑ j : Fin n, ∑ j' : Fin n,
            (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I)).re) +
          (1 / (n : ℝ)) * (∑ j : Fin n,
            ((1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j : ℝ) : ℂ) * I - 1)).re +
              ∑ j' ∈ Finset.univ.erase j,
                (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I - 1)).re)) := by
        calc ∑ j, ∑ j', uniformChannelWeight n j * uniformChannelWeight n j' *
              (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I) +
                1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I - 1)).re
            = (1 / (n : ℝ)) * (∑ j : Fin n, ∑ j' : Fin n,
                (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I)).re) +
              (1 / (n : ℝ)) * (∑ j : Fin n, ∑ j' : Fin n,
                (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I - 1)).re) := by
              simp_rw [hcc, Complex.add_re, mul_add, Finset.sum_add_distrib, ← Finset.mul_sum]
          _ = (1 / (n : ℝ)) * (∑ j : Fin n, ∑ j' : Fin n,
                (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I)).re) +
              (1 / (n : ℝ)) * (∑ j : Fin n,
                ((1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j : ℝ) : ℂ) * I - 1)).re +
                  ∑ j' ∈ Finset.univ.erase j,
                    (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I - 1)).re)) := by
              congr 2
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [← Finset.add_sum_erase _ _ (Finset.mem_univ j)]
      rw [hsplit_pole]
      have h0_pole : (1 / (n : ℝ)) * (∑ j : Fin n, ∑ j' : Fin n,
          (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I)).re) ≤ (n : ℝ) := by
        have hb : ∑ j : Fin n, ∑ j' : Fin n,
            (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I)).re ≤ (n : ℝ) * (n : ℝ) := by
          calc ∑ j : Fin n, ∑ j' : Fin n,
                (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I)).re
              ≤ ∑ _j : Fin n, ∑ _j' : Fin n, (1 : ℝ) :=
                Finset.sum_le_sum fun j _ => Finset.sum_le_sum fun j' _ => re_one_div_le_one hδ0
            _ = (n : ℝ) * (n : ℝ) := by simp
        have := mul_le_mul_of_nonneg_left hb hinv_n_nn
        have he : (1 / (n : ℝ)) * ((n : ℝ) * (n : ℝ)) = (n : ℝ) := by field_simp
        linarith
      have h1_pole : (1 / (n : ℝ)) * (∑ j : Fin n,
            ((1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j : ℝ) : ℂ) * I - 1)).re +
              ∑ j' ∈ Finset.univ.erase j,
                (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I - 1)).re)) ≤
          1 / δ + folnerOffDiag x / (n : ℝ) := by
        have hdiag : ∀ j : Fin n,
            (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j : ℝ) : ℂ) * I - 1)).re = 1 / δ := by
          intro j; rw [sub_self]; exact re_pole_one_eq_of_zero hδ0
        have hoff : ∀ j : Fin n, ∀ j' ∈ Finset.univ.erase j,
            (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I - 1)).re ≤
              1 / (x j - x j') ^ 2 := by
          intro j j' hj'
          have hne_idx : j' ≠ j := (Finset.mem_erase.mp hj').1
          have hne_x : x j - x j' ≠ 0 := sub_ne_zero.mpr fun h => hne_idx.symm (hx_inj h)
          exact re_pole_one_le_inv_sq hδ0 hδ1 hne_x
        have hsum_le : ∑ j : Fin n,
            ((1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j : ℝ) : ℂ) * I - 1)).re +
              ∑ j' ∈ Finset.univ.erase j,
                (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I - 1)).re) ≤
            (n : ℝ) * (1 / δ) + folnerOffDiag x := by
          rw [Finset.sum_add_distrib]
          refine add_le_add ?_ (Finset.sum_le_sum fun j _ => Finset.sum_le_sum (hoff j))
          simp_rw [hdiag]
          simp
        have hm' := mul_le_mul_of_nonneg_left hsum_le hinv_n_nn
        have he' : (1 / (n : ℝ)) * ((n : ℝ) * (1 / δ) + folnerOffDiag x) =
            1 / δ + folnerOffDiag x / (n : ℝ) := by field_simp
        linarith
      linarith
    have harch_bound :
        ∑ j, ∑ j', uniformChannelWeight n j * uniformChannelWeight n j' *
          (logDeriv Complex.Gammaℝ (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I)).re ≤
        (n : ℝ) * (Real.log (3 + H) / 2 + 1 / 4) := by
      have hpt_arch : ∀ j j' : Fin n,
          (logDeriv Complex.Gammaℝ (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I)).re ≤
            Real.log (3 + H) / 2 + 1 / 4 := by
        intro j j'
        have hb1 := hx_bounds j
        have hb2 := hx_bounds j'
        have habs : |x j - x j'| ≤ H := abs_le.mpr ⟨by linarith, by linarith⟩
        have hlog_le : Real.log (3 + |x j - x j'|) ≤ Real.log (3 + H) :=
          Real.log_le_log (by positivity) (by linarith)
        have hg := re_logDeriv_Gammaℝ_le_all_heights (σ := 1 + δ) (t := x j - x j')
          (by linarith) (by linarith)
        linarith
      calc ∑ j, ∑ j', uniformChannelWeight n j * uniformChannelWeight n j' *
            (logDeriv Complex.Gammaℝ (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I)).re
          ≤ ∑ _j : Fin n, ∑ _j' : Fin n,
              (1 / (n : ℝ)) * (Real.log (3 + H) / 2 + 1 / 4) := by
            refine Finset.sum_le_sum fun j _ => Finset.sum_le_sum fun j' _ => ?_
            rw [hcc]
            exact mul_le_mul_of_nonneg_left (hpt_arch j j') hinv_n_nn
        _ = (n : ℝ) * (Real.log (3 + H) / 2 + 1 / 4) := by
            simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
            field_simp
    have hkp := mul_le_mul_of_nonneg_left hpole_bound (Nat.cast_nonneg κ)
    have hda := mul_le_mul_of_nonneg_left harch_bound (Nat.cast_nonneg d)
    have hG_expand : (κ : ℝ) * (1 / δ + (n : ℝ) + folnerOffDiag x / (n : ℝ)) +
        (d : ℝ) * ((n : ℝ) * (Real.log (3 + H) / 2 + 1 / 4)) =
        (κ : ℝ) / δ + folnerGrowth κ d n x H := by
      unfold folnerGrowth
      ring
    linarith [hlhs, hforce, hkp, hda, hG_expand]
  have hAB : (κ : ℝ) < 2 * (((∑ ℓ, m ℓ : ℕ) : ℝ)) - 1 / 2 := by
    have hnat : κ + 1 ≤ 2 * ∑ ℓ, m ℓ := by omega
    have hr : (κ : ℝ) + 1 ≤ 2 * (((∑ ℓ, m ℓ : ℕ) : ℝ)) := by exact_mod_cast hnat
    linarith
  have hw_le := width_ge_of_pole_growth_bound (Nat.cast_nonneg κ) hAB hG_pos hAG hη_nonneg hmain_δ
  have hs_lt : Real.sqrt κ < Real.sqrt (2 * (((∑ ℓ, m ℓ : ℕ) : ℝ)) - 1 / 2) :=
    Real.sqrt_lt_sqrt (Nat.cast_nonneg κ) hAB
  have hw_pos : 0 < min 1 ((Real.sqrt (2 * (((∑ ℓ, m ℓ : ℕ) : ℝ)) - 1 / 2) - Real.sqrt κ) ^ 2 /
      folnerGrowth κ d n x H) :=
    lt_min zero_lt_one (div_pos (sq_pos_of_pos (sub_pos.mpr hs_lt)) hG_pos)
  exact ⟨_, hw_pos, ℓ_max, by linarith [hw_le, hη_eq]⟩

/-! ### 6. Uniform `(r + 1)`-channel star collar forcing and `κ²` collar sparsity -/

/-- Explicit growth constant for the `(r + 1)`-channel star `(0, Im ρ_1, …, Im ρ_r)` on ordinates
in `[Δ, T]` with pairwise ordinate separation `Δ > 0`. -/
def starCollarGrowth (κ d r : ℕ) (Δ T : ℝ) : ℝ :=
  (3 * packConstant / (2 * Δ ^ 2)) * (κ : ℝ) +
    2 * (r : ℝ) * ((κ : ℝ) + (d : ℝ) * (Real.log (3 + T) / 2 + 1 / 4))

theorem starCollarGrowth_pos {κ d r : ℕ} (hd : 1 ≤ d) (hr : 1 ≤ r) {Δ T : ℝ}
    (hΔ : 0 < Δ) (hT : 0 ≤ T) :
    0 < starCollarGrowth κ d r Δ T := by
  unfold starCollarGrowth
  have hp := packConstant_pos
  have hd' : (1 : ℝ) ≤ d := by exact_mod_cast hd
  have hr' : (1 : ℝ) ≤ r := by exact_mod_cast hr
  have hlog : 0 ≤ Real.log (3 + T) := Real.log_nonneg (by linarith)
  have h1 : 0 ≤ (3 * packConstant / (2 * Δ ^ 2)) * (κ : ℝ) := by positivity
  have h2 : 0 < 2 * (r : ℝ) * ((κ : ℝ) + (d : ℝ) * (Real.log (3 + T) / 2 + 1 / 4)) := by positivity
  linarith

/-- **Quantitative `(r + 1)`-channel star collar forcing.** Coupling `0` with weight `√r` against
`r ≥ 1` `Δ`-separated upper-half-plane zeros in `[Δ, T]` with unit weights gives explicit collar
repulsion whenever `√r · κ < ∑_ℓ m_ℓ`. Unlike single-zero certificates (which fail whenever
`κ ≥ 2`), increasing `r` beats any pole budget `κ` with explicit height dependence
`1 / (d log(3 + T))`. -/
theorem collective_star_collar_forcing {κ d : ℕ} {F Λ : ℂ → ℂ}
    (hS : CompletedPositiveSystem κ d F Λ) {r : ℕ} (hr : 1 ≤ r)
    (ρ : Fin r → ℂ) (m : Fin r → ℕ) {Δ T : ℝ} (hΔ : 0 < Δ)
    (him_lo : ∀ ℓ, Δ ≤ (ρ ℓ).im)
    (him_hi : ∀ ℓ, (ρ ℓ).im ≤ T)
    (hsep : ∀ ℓ ℓ', ℓ ≠ ℓ' → Δ ≤ |(ρ ℓ).im - (ρ ℓ').im|)
    (hm_pos : ∀ ℓ, 1 ≤ m ℓ)
    (hm : ∀ ℓ, m ℓ ≤ (analyticOrderAt Λ (ρ ℓ)).toNat)
    (hM : Real.sqrt r * (κ : ℝ) < ∑ ℓ, (m ℓ : ℝ)) :
    ∃ ℓ : Fin r, (ρ ℓ).re ≤ 1 -
      min 1 ((Real.sqrt ((∑ i, (m i : ℝ)) / Real.sqrt r) - Real.sqrt κ) ^ 2 /
        starCollarGrowth κ d r Δ T) := by
  classical
  haveI : Nonempty (Fin r) := Fin.pos_iff_nonempty.mp hr
  have hr_pos : (0 : ℝ) < r := by exact_mod_cast hr
  have hr_ge1 : (1 : ℝ) ≤ r := by exact_mod_cast hr
  have hsqr_pos : 0 < Real.sqrt r := Real.sqrt_pos.mpr hr_pos
  have hsqr_le_r : Real.sqrt r ≤ (r : ℝ) := by
    nlinarith [Real.sq_sqrt hr_pos.le, sq_nonneg (Real.sqrt r - 1), hsqr_pos]
  have hT_nn : 0 ≤ T := hΔ.le.trans ((him_lo ⟨0, hr⟩).trans (him_hi ⟨0, hr⟩))
  have him : ∀ ℓ, 0 < (ρ ℓ).im := fun ℓ => lt_of_lt_of_le hΔ (him_lo ℓ)
  have hdist : ∀ ℓ ℓ', ℓ ≠ ℓ' → (ρ ℓ).im ≠ (ρ ℓ').im := fun ℓ ℓ' hne heq => by
    have := hsep ℓ ℓ' hne; rw [heq, sub_self, abs_zero] at this; linarith
  have hρ_strip : ∀ ℓ, 0 ≤ (ρ ℓ).re ∧ (ρ ℓ).re ≤ 1 := fun ℓ =>
    hS.zero_re_mem_Icc (hS.eq_zero_of_one_le_order_toNat ((hm_pos ℓ).trans (hm ℓ)))
  set η : ℝ := Finset.univ.sup' Finset.univ_nonempty (fun ℓ => 1 - (ρ ℓ).re)
  have hη_ge : ∀ ℓ, 1 - (ρ ℓ).re ≤ η := fun ℓ => Finset.le_sup' (fun i => 1 - (ρ i).re) (mem_univ ℓ)
  obtain ⟨ℓ_max, _, hη_eq⟩ := Finset.exists_mem_eq_sup' Finset.univ_nonempty (fun ℓ => 1 - (ρ ℓ).re)
  have hη_nn : 0 ≤ η := by linarith [(hρ_strip ℓ_max).2, hη_ge ℓ_max]
  set M_r : ℝ := ∑ ℓ, (m ℓ : ℝ)
  set G : ℝ := starCollarGrowth κ d r Δ T
  have hG_pos : 0 < G := starCollarGrowth_pos hS.degree_pos hr hΔ hT_nn
  have hAG : (κ : ℝ) ≤ G := by
    unfold G starCollarGrowth
    have hp := packConstant_pos
    have hd' : (1 : ℝ) ≤ d := by exact_mod_cast hS.degree_pos
    have hlog : 0 ≤ Real.log (3 + T) := Real.log_nonneg (by linarith)
    have h1 : 0 ≤ (3 * packConstant / (2 * Δ ^ 2)) * (κ : ℝ) := by positivity
    have h2 : 0 ≤ (d : ℝ) * (Real.log (3 + T) / 2 + 1 / 4) := by positivity
    nlinarith [Nat.cast_nonneg (α := ℝ) κ]
  -- Star configuration on `Fin (r + 1)`: index `0` at height `0` with weight `√r`,
  -- indices `ℓ.succ` at height `(ρ ℓ).im` with weight `1`.
  let x : Fin (r + 1) → ℝ := Fin.cases 0 (fun ℓ => (ρ ℓ).im)
  let c : Fin (r + 1) → ℝ := Fin.cases (Real.sqrt r) (fun _ => 1)
  have hc_nn : ∀ j, 0 ≤ c j := Fin.cases hsqr_pos.le (fun _ => zero_le_one)
  have hx_bounds : ∀ j, 0 ≤ x j ∧ x j ≤ T :=
    Fin.cases ⟨le_rfl, hT_nn⟩ (fun ℓ => ⟨(him ℓ).le, him_hi ℓ⟩)
  -- Separated inverse-square bounds via `sum_inv_sq_le_of_separated`.
  have hinj_im : Function.Injective (fun ℓ : Fin r => (ρ ℓ).im) := fun ℓ ℓ' h => by
    by_contra hne; exact hdist ℓ ℓ' hne h
  have hpack_zero : ∑ ℓ : Fin r, 1 / ((ρ ℓ).im) ^ 2 ≤ packConstant / Δ ^ 2 := by
    let P : Finset ℝ := Finset.univ.image (fun ℓ : Fin r => (ρ ℓ).im)
    have hP_sep : ∀ p ∈ P, ∀ p' ∈ P, p ≠ p' → Δ ≤ |p - p'| := by
      intro p hp p' hp' hne
      obtain ⟨ℓ, _, rfl⟩ := Finset.mem_image.mp hp
      obtain ⟨ℓ', _, rfl⟩ := Finset.mem_image.mp hp'
      exact hsep ℓ ℓ' (fun h => hne (by rw [h]))
    have hP_far : ∀ p ∈ P, Δ ≤ ‖(0 : ℂ) - p‖ := by
      intro p hp
      obtain ⟨ℓ, _, rfl⟩ := Finset.mem_image.mp hp
      rw [zero_sub, norm_neg, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (him ℓ)]
      exact him_lo ℓ
    have hpack := sum_inv_sq_le_of_separated hΔ P hP_sep 0 hP_far
    have hsum_eq : ∑ p ∈ P, 1 / ‖(0 : ℂ) - (p : ℂ)‖ ^ 2 = ∑ ℓ : Fin r, 1 / ((ρ ℓ).im) ^ 2 := by
      rw [Finset.sum_image (fun ℓ _ ℓ' _ h => hinj_im h)]
      refine Finset.sum_congr rfl fun ℓ _ => ?_
      rw [zero_sub, norm_neg, Complex.norm_real, Real.norm_eq_abs, sq_abs]
    linarith
  have hpack_pair : ∀ j : Fin r,
      ∑ k ∈ Finset.univ.erase j, 1 / ((ρ j).im - (ρ k).im) ^ 2 ≤ packConstant / Δ ^ 2 := by
    intro j
    let Pj : Finset ℝ := (Finset.univ.erase j).image (fun k : Fin r => (ρ k).im)
    have hPj_sep : ∀ p ∈ Pj, ∀ p' ∈ Pj, p ≠ p' → Δ ≤ |p - p'| := by
      intro p hp p' hp' hne
      obtain ⟨k, _, rfl⟩ := Finset.mem_image.mp hp
      obtain ⟨k', _, rfl⟩ := Finset.mem_image.mp hp'
      exact hsep k k' (fun h => hne (by rw [h]))
    have hPj_far : ∀ p ∈ Pj, Δ ≤ ‖((ρ j).im : ℂ) - p‖ := by
      intro p hp
      obtain ⟨k, hk, rfl⟩ := Finset.mem_image.mp hp
      have hkj : k ≠ j := (Finset.mem_erase.mp hk).1
      rw [← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs]
      exact hsep j k hkj.symm
    have hpack := sum_inv_sq_le_of_separated hΔ Pj hPj_sep ((ρ j).im : ℂ) hPj_far
    have hsum_eq : ∑ p ∈ Pj, 1 / ‖((ρ j).im : ℂ) - (p : ℂ)‖ ^ 2 =
        ∑ k ∈ Finset.univ.erase j, 1 / ((ρ j).im - (ρ k).im) ^ 2 := by
      rw [Finset.sum_image (fun k _ k' _ h => hinj_im h)]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs, sq_abs]
    linarith
  -- Main inequality for every `δ ∈ (0, 1]`.
  have hmain_δ : ∀ δ : ℝ, 0 < δ → δ ≤ 1 →
      (M_r / Real.sqrt r) / (δ + η) ≤ (κ : ℝ) / δ + G := by
    intro δ hδ0 hδ1
    have hforce := coupled_strip_pole_zero_forcing hS ρ m him hdist hm x c hc_nn hδ0
    -- Lower bound LHS by keeping `(ℓ.succ, 0)` and `(0, ℓ.succ)`.
    have hlhs_ℓ : ∀ ℓ : Fin r,
        2 * Real.sqrt r / (δ + η) ≤
          ∑ j, ∑ k, c j * c k *
            ((1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - ρ ℓ)).re +
              (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - starRingEnd ℂ (ρ ℓ))).re) := by
      intro ℓ
      have hnn : ∀ j k : Fin (r + 1),
          0 ≤ c j * c k *
            ((1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - ρ ℓ)).re +
              (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - starRingEnd ℂ (ρ ℓ))).re) := by
        intro j k
        refine mul_nonneg (mul_nonneg (hc_nn j) (hc_nn k)) (add_nonneg ?_ ?_)
        · exact re_one_div_nonneg_of_re_le (by simp; linarith [(hρ_strip ℓ).2])
        · exact re_one_div_nonneg_of_re_le (by simp; linarith [(hρ_strip ℓ).2])
      rw [← Finset.sum_product']
      have hne_pair : (ℓ.succ, (0 : Fin (r + 1))) ≠ (0, ℓ.succ) := fun h =>
        Fin.succ_ne_zero ℓ (Prod.mk.inj h).1
      have hsub := Finset.sum_le_sum_of_subset_of_nonneg
        (s := {(ℓ.succ, (0 : Fin (r + 1))), ((0 : Fin (r + 1)), ℓ.succ)})
        (t := Finset.univ ×ˢ Finset.univ)
        (fun p _ => by simp) (fun p _ _ => hnn p.1 p.2)
      rw [Finset.sum_pair hne_pair] at hsub
      have ht1 : Real.sqrt r / (δ + η) ≤
          c ℓ.succ * c 0 *
            ((1 / (((1 + δ : ℝ) : ℂ) + ((x ℓ.succ - x 0 : ℝ) : ℂ) * I - ρ ℓ)).re +
              (1 / (((1 + δ : ℝ) : ℂ) + ((x ℓ.succ - x 0 : ℝ) : ℂ) * I -
                starRingEnd ℂ (ρ ℓ))).re) := by
        have hcc1 : c ℓ.succ * c 0 = Real.sqrt r := by simp [c]
        have hx1 : x ℓ.succ - x 0 = (ρ ℓ).im := by simp [x]
        rw [hcc1, hx1]
        have hr1 := re_zero_resonant_ge hδ0 (hρ_strip ℓ).2 (hη_ge ℓ)
        have hr2 : 0 ≤ (1 / (((1 + δ : ℝ) : ℂ) + (((ρ ℓ).im : ℝ) : ℂ) * I -
            starRingEnd ℂ (ρ ℓ))).re :=
          re_one_div_nonneg_of_re_le (by simp; linarith [(hρ_strip ℓ).2])
        have := mul_le_mul_of_nonneg_left (le_add_of_le_of_nonneg hr1 hr2) hsqr_pos.le
        rwa [mul_one_div] at this
      have ht2 : Real.sqrt r / (δ + η) ≤
          c 0 * c ℓ.succ *
            ((1 / (((1 + δ : ℝ) : ℂ) + ((x 0 - x ℓ.succ : ℝ) : ℂ) * I - ρ ℓ)).re +
              (1 / (((1 + δ : ℝ) : ℂ) + ((x 0 - x ℓ.succ : ℝ) : ℂ) * I -
                starRingEnd ℂ (ρ ℓ))).re) := by
        have hcc2 : c 0 * c ℓ.succ = Real.sqrt r := by simp [c]
        have hx2 : x 0 - x ℓ.succ = -((ρ ℓ).im) := by simp [x]
        rw [hcc2, hx2]
        have hr1 : 0 ≤ (1 / (((1 + δ : ℝ) : ℂ) + ((-((ρ ℓ).im) : ℝ) : ℂ) * I - ρ ℓ)).re :=
          re_one_div_nonneg_of_re_le (by simp; linarith [(hρ_strip ℓ).2])
        have hr2 := re_conj_zero_resonant_ge hδ0 (hρ_strip ℓ).2 (hη_ge ℓ)
        have := mul_le_mul_of_nonneg_left (le_add_of_nonneg_of_le hr1 hr2) hsqr_pos.le
        rwa [mul_one_div] at this
      have he : 2 * Real.sqrt r / (δ + η) = Real.sqrt r / (δ + η) + Real.sqrt r / (δ + η) := by
        ring
      linarith
    have hlhs : 2 * Real.sqrt r * M_r / (δ + η) ≤
        ∑ ℓ, (m ℓ : ℝ) * ∑ j, ∑ k, c j * c k *
          ((1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - ρ ℓ)).re +
            (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - starRingEnd ℂ (ρ ℓ))).re) := by
      have he : 2 * Real.sqrt r * M_r / (δ + η) =
          M_r * (2 * Real.sqrt r / (δ + η)) := by ring
      rw [he, show M_r = ∑ ℓ, (m ℓ : ℝ) from rfl, Finset.sum_mul]
      exact Finset.sum_le_sum fun ℓ _ => mul_le_mul_of_nonneg_left (hlhs_ℓ ℓ) (Nat.cast_nonneg _)
    -- Total channel weight sum `∑ j, ∑ k, c j * c k ≤ 4 * r ^ 2`.
    have hweight_sum : ∑ j, ∑ k, c j * c k ≤ 4 * (r : ℝ) ^ 2 := by
      have hcsum : ∑ j, c j = Real.sqrt r + (r : ℝ) := by
        rw [Fin.sum_univ_succ]; simp [c]
      rw [← Finset.sum_mul_sum, hcsum]
      nlinarith [hsqr_le_r, hsqr_pos]
    -- Upper bound `1 / s_{j,k}` and `logDeriv Gammaℝ s_{j,k}` terms.
    have hpole0_bound :
        ∑ j, ∑ k, c j * c k *
          (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re ≤ 4 * (r : ℝ) ^ 2 := by
      calc ∑ j, ∑ k, c j * c k *
            (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re
          ≤ ∑ j, ∑ k, c j * c k * 1 := Finset.sum_le_sum fun j _ => Finset.sum_le_sum fun k _ =>
              mul_le_mul_of_nonneg_left (re_one_div_le_one hδ0) (mul_nonneg (hc_nn j) (hc_nn k))
        _ = ∑ j, ∑ k, c j * c k := by simp
        _ ≤ 4 * (r : ℝ) ^ 2 := hweight_sum
    have harch_bound :
        ∑ j, ∑ k, c j * c k *
          (logDeriv Complex.Gammaℝ (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re ≤
        4 * (r : ℝ) ^ 2 * (Real.log (3 + T) / 2 + 1 / 4) := by
      have hlog_nn : 0 ≤ Real.log (3 + T) / 2 + 1 / 4 := by
        have := Real.log_nonneg (show (1 : ℝ) ≤ 3 + T by linarith); positivity
      calc ∑ j, ∑ k, c j * c k *
            (logDeriv Complex.Gammaℝ (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re
          ≤ ∑ j, ∑ k, c j * c k * (Real.log (3 + T) / 2 + 1 / 4) := by
            refine Finset.sum_le_sum fun j _ => Finset.sum_le_sum fun k _ =>
              mul_le_mul_of_nonneg_left ?_ (mul_nonneg (hc_nn j) (hc_nn k))
            have hb1 := hx_bounds j; have hb2 := hx_bounds k
            have habs : |x j - x k| ≤ T := abs_le.mpr ⟨by linarith, by linarith⟩
            have hlog_le : Real.log (3 + |x j - x k|) ≤ Real.log (3 + T) :=
              Real.log_le_log (by positivity) (by linarith)
            have hg := re_logDeriv_Gammaℝ_le_all_heights (σ := 1 + δ) (t := x j - x k)
              (by linarith) (by linarith)
            linarith
        _ = (∑ j, ∑ k, c j * c k) * (Real.log (3 + T) / 2 + 1 / 4) := by
            simp_rw [← Finset.sum_mul]
        _ ≤ 4 * (r : ℝ) ^ 2 * (Real.log (3 + T) / 2 + 1 / 4) :=
            mul_le_mul_of_nonneg_right hweight_sum hlog_nn
    -- Upper bound `1 / (s_{j,k} - 1)` pole sum by `2 r / δ + 3 r packConstant / Δ^2`.
    have hpole1_bound :
        ∑ j, ∑ k, c j * c k *
          (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - 1)).re ≤
        2 * (r : ℝ) / δ + 3 * (r : ℝ) * (packConstant / Δ ^ 2) := by
      let P1 : Fin (r + 1) → Fin (r + 1) → ℝ := fun j k =>
        c j * c k * (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - 1)).re
      change ∑ j, ∑ k, P1 j k ≤ _
      rw [Fin.sum_univ_succ]
      have hrow0 : ∑ k, P1 0 k ≤ (r : ℝ) / δ + (r : ℝ) * (packConstant / Δ ^ 2) := by
        rw [Fin.sum_univ_succ]
        have h00 : P1 0 0 = (r : ℝ) / δ := by
          simp only [P1, c, x, Fin.cases_zero, sub_self, re_pole_one_eq_of_zero hδ0,
            Real.mul_self_sqrt hr_pos.le, mul_one_div]
        have h0s : ∑ k : Fin r, P1 0 k.succ ≤ (r : ℝ) * (packConstant / Δ ^ 2) := by
          calc ∑ k : Fin r, P1 0 k.succ
              ≤ ∑ k : Fin r, Real.sqrt r * (1 / ((ρ k).im) ^ 2) := by
                refine Finset.sum_le_sum fun k _ => ?_
                simp only [P1, c, x, Fin.cases_zero, Fin.cases_succ, mul_one, zero_sub]
                refine mul_le_mul_of_nonneg_left ?_ hsqr_pos.le
                have := re_pole_one_le_inv_sq hδ0 hδ1 (neg_ne_zero.mpr (him k).ne')
                rwa [neg_sq] at this
            _ = Real.sqrt r * ∑ k : Fin r, 1 / ((ρ k).im) ^ 2 := (Finset.mul_sum _ _ _).symm
            _ ≤ (r : ℝ) * (packConstant / Δ ^ 2) :=
                mul_le_mul hsqr_le_r hpack_zero
                  (Finset.sum_nonneg fun _ _ => by positivity) hr_pos.le
        linarith
      have hrows : ∑ j : Fin r, ∑ k, P1 j.succ k ≤
          (r : ℝ) / δ + 2 * (r : ℝ) * (packConstant / Δ ^ 2) := by
        have hsplit_rows : ∑ j : Fin r, ∑ k, P1 j.succ k =
            (∑ j : Fin r, P1 j.succ 0) + ∑ j : Fin r, ∑ k : Fin r, P1 j.succ k.succ := by
          simp_rw [Fin.sum_univ_succ, Finset.sum_add_distrib]
        rw [hsplit_rows]
        have hcol0 : ∑ j : Fin r, P1 j.succ 0 ≤ (r : ℝ) * (packConstant / Δ ^ 2) := by
          calc ∑ j : Fin r, P1 j.succ 0
              ≤ ∑ j : Fin r, Real.sqrt r * (1 / ((ρ j).im) ^ 2) := by
                refine Finset.sum_le_sum fun j _ => ?_
                simp only [P1, c, x, Fin.cases_zero, Fin.cases_succ, one_mul, sub_zero]
                exact mul_le_mul_of_nonneg_left
                  (re_pole_one_le_inv_sq hδ0 hδ1 (him j).ne') hsqr_pos.le
            _ = Real.sqrt r * ∑ j : Fin r, 1 / ((ρ j).im) ^ 2 := (Finset.mul_sum _ _ _).symm
            _ ≤ (r : ℝ) * (packConstant / Δ ^ 2) :=
                mul_le_mul hsqr_le_r hpack_zero
                  (Finset.sum_nonneg fun _ _ => by positivity) hr_pos.le
        have hblock : ∑ j : Fin r, ∑ k : Fin r, P1 j.succ k.succ ≤
            (r : ℝ) / δ + (r : ℝ) * (packConstant / Δ ^ 2) := by
          have hinner_j : ∀ j : Fin r, ∑ k : Fin r, P1 j.succ k.succ ≤
              1 / δ + packConstant / Δ ^ 2 := by
            intro j
            rw [← Finset.add_sum_erase _ _ (Finset.mem_univ j)]
            have hdiag : P1 j.succ j.succ = 1 / δ := by
              simp only [P1, c, x, Fin.cases_succ, mul_one, one_mul, sub_self,
                re_pole_one_eq_of_zero hδ0]
            have hoff : ∑ k ∈ Finset.univ.erase j, P1 j.succ k.succ ≤ packConstant / Δ ^ 2 := by
              calc ∑ k ∈ Finset.univ.erase j, P1 j.succ k.succ
                  ≤ ∑ k ∈ Finset.univ.erase j, 1 / ((ρ j).im - (ρ k).im) ^ 2 := by
                    refine Finset.sum_le_sum fun k hk => ?_
                    simp only [P1, c, x, Fin.cases_succ, one_mul]
                    have hkj : k ≠ j := (Finset.mem_erase.mp hk).1
                    exact re_pole_one_le_inv_sq hδ0 hδ1
                      (sub_ne_zero.mpr (hdist j k hkj.symm))
                _ ≤ packConstant / Δ ^ 2 := hpack_pair j
            linarith
          calc ∑ j : Fin r, ∑ k : Fin r, P1 j.succ k.succ
              ≤ ∑ _j : Fin r, (1 / δ + packConstant / Δ ^ 2) :=
                Finset.sum_le_sum fun j _ => hinner_j j
            _ = (r : ℝ) / δ + (r : ℝ) * (packConstant / Δ ^ 2) := by
                simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
                ring
        linarith
      have h2r : (r : ℝ) / δ + (r : ℝ) / δ = 2 * (r : ℝ) / δ := by ring
      linarith
    -- Assemble and divide by `2 * r > 0`.
    have hpole_tot : ∑ j, ∑ k, c j * c k *
        (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I) +
          1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - 1)).re ≤
        2 * (r : ℝ) / δ + 3 * (r : ℝ) * (packConstant / Δ ^ 2) + 4 * (r : ℝ) ^ 2 := by
      have hsp : (∑ j, ∑ k, c j * c k *
          (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I) +
            1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - 1)).re) =
          (∑ j, ∑ k, c j * c k *
            (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re) +
          (∑ j, ∑ k, c j * c k *
            (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - 1)).re) := by
        simp_rw [Complex.add_re, mul_add, Finset.sum_add_distrib]
      linarith
    have hkp := mul_le_mul_of_nonneg_left hpole_tot (Nat.cast_nonneg κ)
    have hda := mul_le_mul_of_nonneg_left harch_bound (Nat.cast_nonneg d)
    have h2r_mul : 2 * (r : ℝ) * ((M_r / Real.sqrt r) / (δ + η)) ≤
        2 * (r : ℝ) * ((κ : ℝ) / δ + G) := by
      have hlhs_eq : 2 * (r : ℝ) * ((M_r / Real.sqrt r) / (δ + η)) =
          2 * Real.sqrt r * M_r / (δ + η) := by
        have h1 : (r : ℝ) * (M_r / Real.sqrt r) = Real.sqrt r * M_r := by
          calc (r : ℝ) * (M_r / Real.sqrt r)
              = M_r / Real.sqrt r * (Real.sqrt r * Real.sqrt r) := by
                  rw [Real.mul_self_sqrt hr_pos.le, mul_comm]
            _ = M_r * Real.sqrt r := by rw [← mul_assoc, div_mul_cancel₀ _ hsqr_pos.ne']
            _ = Real.sqrt r * M_r := mul_comm _ _
        rw [← mul_div_assoc, mul_assoc 2, h1, ← mul_assoc]
      have hrhs_eq : 2 * (r : ℝ) * ((κ : ℝ) / δ + G) =
          (κ : ℝ) * (2 * (r : ℝ) / δ + 3 * (r : ℝ) * (packConstant / Δ ^ 2) + 4 * (r : ℝ) ^ 2) +
            (d : ℝ) * (4 * (r : ℝ) ^ 2 * (Real.log (3 + T) / 2 + 1 / 4)) := by
        unfold G starCollarGrowth
        field_simp
        ring
      linarith [hlhs, hforce, hkp, hda, hlhs_eq, hrhs_eq]
    exact le_of_mul_le_mul_left h2r_mul (by positivity)
  have hAB : (κ : ℝ) < M_r / Real.sqrt r := (lt_div_iff₀ hsqr_pos).mpr (by linarith)
  have hw := width_ge_of_pole_growth_bound (Nat.cast_nonneg κ) hAB hG_pos hAG hη_nn hmain_δ
  exact ⟨ℓ_max, by linarith [hw, hη_eq]⟩

/-- Explicit collar width at the critical star multiplicity `r = κ² + 1`, scaling as
`≍_{κ, Δ} 1 / (d log(3 + T))` uniformly across heights `T ≥ Δ > 0`. -/
def collarWidth (κ d : ℕ) (Δ T : ℝ) : ℝ :=
  min 1 ((Real.sqrt (Real.sqrt (((κ ^ 2 + 1 : ℕ) : ℝ))) - Real.sqrt κ) ^ 2 /
    starCollarGrowth κ d (κ ^ 2 + 1) Δ T)

theorem collarWidth_pos {κ d : ℕ} (hd : 1 ≤ d) {Δ T : ℝ} (hΔ : 0 < Δ) (hT : 0 ≤ T) :
    0 < collarWidth κ d Δ T := by
  unfold collarWidth
  have hg : 0 < starCollarGrowth κ d (κ ^ 2 + 1) Δ T :=
    starCollarGrowth_pos hd (by omega) hΔ hT
  have hk1 : (κ : ℝ) ^ 2 < (((κ ^ 2 + 1 : ℕ) : ℝ)) := by push_cast; linarith
  have hk2 : (κ : ℝ) < Real.sqrt (((κ ^ 2 + 1 : ℕ) : ℝ)) := by
    rw [← Real.sqrt_sq (Nat.cast_nonneg κ)]
    exact Real.sqrt_lt_sqrt (sq_nonneg _) hk1
  have hk3 : Real.sqrt κ < Real.sqrt (Real.sqrt (((κ ^ 2 + 1 : ℕ) : ℝ))) :=
    Real.sqrt_lt_sqrt (Nat.cast_nonneg κ) hk2
  exact lt_min zero_lt_one (div_pos (sq_pos_of_pos (sub_pos.mpr hk3)) hg)

/-- **Uniform `κ²` collar sparsity across heights.** In any completed positive system
`(κ, d, F, Λ)`, at most `κ²` zeros of `Λ` with ordinates in `[Δ, T]` and pairwise ordinate
separation `≥ Δ` can enter the explicit collar `Re ρ > 1 − collarWidth κ d Δ T`.
For `κ = 0` this gives `0` collar zeros; for `κ = 1` at most `1` (Landau–Page sparsity). -/
theorem card_separated_collar_zeros_le_sq_poleOrder {κ d : ℕ} {F Λ : ℂ → ℂ}
    (hS : CompletedPositiveSystem κ d F Λ) {Δ T : ℝ} (hΔ : 0 < Δ) (Z : Finset ℂ)
    (hzero : ∀ z ∈ Z, Λ z = 0)
    (him_lo : ∀ z ∈ Z, Δ ≤ z.im)
    (him_hi : ∀ z ∈ Z, z.im ≤ T)
    (hsep : ∀ z ∈ Z, ∀ w ∈ Z, z ≠ w → Δ ≤ |z.im - w.im|)
    (hcollar : ∀ z ∈ Z, 1 - collarWidth κ d Δ T < z.re) :
    Z.card ≤ κ ^ 2 := by
  by_contra hgt
  rw [not_le] at hgt
  set r₀ : ℕ := κ ^ 2 + 1
  have hr₀ : 1 ≤ r₀ := by omega
  have hcard : r₀ ≤ Z.card := hgt
  let eZ : Fin Z.card ≃ Z := Z.equivFin.symm
  let ρ : Fin r₀ → ℂ := fun ℓ => (eZ ⟨ℓ.1, ℓ.2.trans_le hcard⟩ : ℂ)
  have hρ_mem : ∀ ℓ, ρ ℓ ∈ Z := fun ℓ => (eZ ⟨ℓ.1, ℓ.2.trans_le hcard⟩).2
  have hρ_inj : ∀ ℓ ℓ', ℓ ≠ ℓ' → ρ ℓ ≠ ρ ℓ' := by
    intro ℓ ℓ' hne heq
    apply hne
    have hsub : eZ ⟨ℓ.1, ℓ.2.trans_le hcard⟩ = eZ ⟨ℓ'.1, ℓ'.2.trans_le hcard⟩ := Subtype.ext heq
    have hfin := eZ.injective hsub
    exact Fin.ext (Fin.mk.inj hfin)
  let m : Fin r₀ → ℕ := fun _ => 1
  have hm_sum : (∑ _i : Fin r₀, (1 : ℝ)) = (r₀ : ℝ) := by simp
  have hM : Real.sqrt r₀ * (κ : ℝ) < ∑ ℓ : Fin r₀, (m ℓ : ℝ) := by
    simp only [m, Nat.cast_one]
    rw [hm_sum]
    have hr₀_pos : (0 : ℝ) < r₀ := by positivity
    have hk_lt : (κ : ℝ) < Real.sqrt r₀ := by
      rw [← Real.sqrt_sq (Nat.cast_nonneg κ)]
      exact Real.sqrt_lt_sqrt (sq_nonneg _)
        (show (κ : ℝ) ^ 2 < (((κ ^ 2 + 1 : ℕ) : ℝ)) by push_cast; linarith)
    calc Real.sqrt r₀ * (κ : ℝ) < Real.sqrt r₀ * Real.sqrt r₀ :=
          mul_lt_mul_of_pos_left hk_lt (Real.sqrt_pos.mpr hr₀_pos)
      _ = (r₀ : ℝ) := Real.mul_self_sqrt hr₀_pos.le
  obtain ⟨ℓ, hℓ⟩ := collective_star_collar_forcing hS hr₀ ρ m hΔ
    (fun i => him_lo _ (hρ_mem i))
    (fun i => him_hi _ (hρ_mem i))
    (fun i j hij => hsep _ (hρ_mem i) _ (hρ_mem j) (hρ_inj i j hij))
    (fun _ => le_rfl)
    (fun i => hS.one_le_order_toNat_of_eq_zero (hzero _ (hρ_mem i)))
    hM
  have hdiv_sqrt : (∑ _i : Fin r₀, (1 : ℝ)) / Real.sqrt r₀ = Real.sqrt r₀ := by
    rw [hm_sum]
    have hr₀_pos : (0 : ℝ) < r₀ := by positivity
    have hsq := Real.mul_self_sqrt hr₀_pos.le
    have hne : Real.sqrt r₀ ≠ 0 := (Real.sqrt_pos.mpr hr₀_pos).ne'
    exact (div_eq_iff hne).mpr hsq.symm
  simp only [m, Nat.cast_one, hdiv_sqrt] at hℓ
  have hlt := hcollar _ (hρ_mem ℓ)
  unfold collarWidth at hlt
  linarith

/-! ### 7. Canonical `ζ` instance and exact sharpness at `2M = κ − 1` -/

/-- The Riemann zeta function with completion `2 ξ(s) = s(s − 1) Γ_ℝ(s) ζ(s)` forms a canonical
`CompletedPositiveSystem` of pole budget `κ = 1` and degree `d = 1`. -/
theorem completedPositiveSystem_riemannZeta :
    CompletedPositiveSystem 1 1 riemannZeta (fun s => 2 * RHTower.xi s) where
  degree_pos := le_rfl
  diffOn_F s hs := by
    have hs1 : s ≠ 1 := sub_ne_zero.mp (ne_zero_and_sub_one_of_one_lt_re hs).2
    exact (differentiableAt_riemannZeta hs1).differentiableWithinAt
  ne_zero_F _ hs := riemannZeta_ne_zero_of_one_lt_re hs
  posDef_neg_logDeriv {σ} hσ := by
    have heq : (fun u : ℝ => (-logDeriv riemannZeta ((σ : ℂ) + (u : ℂ) * I)).re) =
        fun u : ℝ => ArithmeticCastelnuovoSeveri.zetaRealLogDeriv σ u := by
      funext u
      unfold ArithmeticCastelnuovoSeveri.zetaRealLogDeriv
      rw [logDeriv_apply, neg_div]
    rw [heq]
    exact zetaRealLogDeriv_isEvenPosDef hσ
  entire_Λ := RHTower.xi_differentiable.const_mul 2
  orderOne_Λ := OrderOneEnvelope.const_mul 2 RHTower.orderOneEnvelope_xi
  sym_Λ s := by rw [RHTower.xi_one_sub]
  conj_Λ s := by rw [map_mul, map_ofNat, RHTower.xi_conj]
  completed_eq s hs := by
    obtain ⟨hs0, hs1'⟩ := ne_zero_and_sub_one_of_one_lt_re hs
    have hs1 : s ≠ 1 := sub_ne_zero.mp hs1'
    have hΓ : Complex.Gammaℝ s ≠ 0 := Complex.Gammaℝ_ne_zero_of_re_pos (by linarith)
    rw [RHTower.xi_eq_half_mul hs0 hs1, riemannZeta_def_of_ne_zero hs0, pow_one, pow_one]
    field_simp

private theorem isEvenPosDef_add {φ ψ : ℝ → ℝ} (hφ : IsEvenPosDef φ) (hψ : IsEvenPosDef ψ) :
    IsEvenPosDef (fun u => φ u + ψ u) where
  even u := by rw [hφ.even, hψ.even]
  posDef n x c := by
    have h : (∑ i, ∑ j, c i * c j * (φ (x i - x j) + ψ (x i - x j))) =
        (∑ i, ∑ j, c i * c j * φ (x i - x j)) + ∑ i, ∑ j, c i * c j * ψ (x i - x j) := by
      simp_rw [mul_add, Finset.sum_add_distrib]
    rw [h]
    exact add_nonneg (hφ.posDef n x c) (hψ.posDef n x c)

/-- Elementary Laplace identity on `Ioi 0`: for `a > 0` and `b ∈ ℝ`,
`Re(1 / (a + ib)) = ∫_{t > 0} e^{−at} cos(bt) dt`. -/
private theorem re_one_div_eq_laplace_cos {a : ℝ} (ha : 0 < a) (b : ℝ) :
    (1 / ((a : ℂ) + (b : ℂ) * I)).re =
      ∫ t : ℝ in Ioi 0, Real.exp (-a * t) * Real.cos (b * t) := by
  set w : ℂ := -((a : ℂ) + (b : ℂ) * I)
  have hw_re : w.re < 0 := by simp [w]; linarith
  have hint_c : IntegrableOn (fun t : ℝ => Complex.exp (w * t)) (Ioi 0) :=
    integrableOn_exp_mul_complex_Ioi hw_re 0
  have hval := integral_exp_mul_complex_Ioi hw_re 0
  have hrhs_eq : -Complex.exp (w * (0 : ℝ)) / w = 1 / ((a : ℂ) + (b : ℂ) * I) := by
    rw [Complex.ofReal_zero, mul_zero, Complex.exp_zero]
    dsimp only [w]
    rw [div_neg, neg_div, neg_neg]
  rw [hrhs_eq] at hval
  rw [← hval]
  have hre_int : (∫ t : ℝ in Ioi 0, Complex.exp (w * t)).re =
      ∫ t : ℝ in Ioi 0, (Complex.exp (w * t)).re :=
    (Complex.reCLM.integral_comp_comm hint_c).symm
  rw [hre_int]
  refine setIntegral_congr_fun measurableSet_Ioi fun t _ => ?_
  have hw_t_re : (w * (t : ℂ)).re = -a * t := by simp [w]
  have hw_t_im : (w * (t : ℂ)).im = -(b * t) := by simp [w]
  rw [Complex.exp_re, hw_t_re, hw_t_im, Real.cos_neg]

/-- The real resolvent second difference
`Re(2/(a + iu) − 1/(a + i(u − γ)) − 1/(a + i(u + γ)))` is even positive definite for every `a > 0`
and `γ ∈ ℝ`, with nonnegative Laplace density `2 e^{−at} (1 − cos(γ t)) ≥ 0` on `(0, ∞)`. -/
private def resolventSecondDiff (a γ u : ℝ) : ℝ :=
  (2 / ((a : ℂ) + (u : ℂ) * I) -
    1 / ((a : ℂ) + ((u - γ : ℝ) : ℂ) * I) -
    1 / ((a : ℂ) + ((u + γ : ℝ) : ℂ) * I)).re

private theorem isEvenPosDef_resolventSecondDiff {a : ℝ} (ha : 0 < a) (γ : ℝ) :
    IsEvenPosDef (resolventSecondDiff a γ) := by
  have hint_exp : IntegrableOn (fun t : ℝ => Real.exp (-a * t)) (Ioi 0) :=
    integrableOn_exp_mul_Ioi (by linarith) 0
  have hint_cos : ∀ b : ℝ, IntegrableOn (fun t : ℝ => Real.exp (-a * t) * Real.cos (b * t)) (Ioi 0) := by
    intro b
    refine Integrable.mono' hint_exp ?_ (Eventually.of_forall fun t => ?_)
    · exact (Continuous.aestronglyMeasurable (by fun_prop)).restrict
    · rw [Real.norm_eq_abs, abs_mul, abs_of_pos (Real.exp_pos _)]
      exact mul_le_of_le_one_right (Real.exp_pos _).le (Real.abs_cos_le_one _)
  have hrep : ∀ u : ℝ, resolventSecondDiff a γ u =
      ∫ t : ℝ in Ioi 0, (2 * Real.exp (-a * t) * (1 - Real.cos (γ * t))) * Real.cos (t * u) := by
    intro u
    have h2 : (2 / ((a : ℂ) + (u : ℂ) * I)).re = 2 * (1 / ((a : ℂ) + (u : ℂ) * I)).re := by
      have : (2 : ℂ) / ((a : ℂ) + (u : ℂ) * I) = ((2 : ℝ) : ℂ) * (1 / ((a : ℂ) + (u : ℂ) * I)) := by
        push_cast; ring
      rw [this, Complex.re_ofReal_mul]
    have hker_eq : ∀ t : ℝ,
        (2 * Real.exp (-a * t) * (1 - Real.cos (γ * t))) * Real.cos (t * u) =
          (2 * (Real.exp (-a * t) * Real.cos (u * t)) -
            Real.exp (-a * t) * Real.cos ((u - γ) * t)) -
            Real.exp (-a * t) * Real.cos ((u + γ) * t) := fun t => by
      rw [sub_mul, add_mul, Real.cos_sub, Real.cos_add, mul_comm t u]
      ring
    symm
    calc ∫ t : ℝ in Ioi 0, (2 * Real.exp (-a * t) * (1 - Real.cos (γ * t))) * Real.cos (t * u)
        = ∫ t : ℝ in Ioi 0,
            ((2 * (Real.exp (-a * t) * Real.cos (u * t)) -
              Real.exp (-a * t) * Real.cos ((u - γ) * t)) -
              Real.exp (-a * t) * Real.cos ((u + γ) * t)) :=
          setIntegral_congr_fun measurableSet_Ioi fun t _ => hker_eq t
      _ = (∫ t : ℝ in Ioi 0,
            (2 * (Real.exp (-a * t) * Real.cos (u * t)) -
              Real.exp (-a * t) * Real.cos ((u - γ) * t))) -
            ∫ t : ℝ in Ioi 0, Real.exp (-a * t) * Real.cos ((u + γ) * t) :=
          integral_sub ((hint_cos u |>.const_mul 2).sub (hint_cos (u - γ))) (hint_cos (u + γ))
      _ = (2 * (∫ t : ℝ in Ioi 0, Real.exp (-a * t) * Real.cos (u * t)) -
            ∫ t : ℝ in Ioi 0, Real.exp (-a * t) * Real.cos ((u - γ) * t)) -
            ∫ t : ℝ in Ioi 0, Real.exp (-a * t) * Real.cos ((u + γ) * t) := by
          rw [integral_sub (hint_cos u |>.const_mul 2) (hint_cos (u - γ)), integral_const_mul]
      _ = resolventSecondDiff a γ u := by
          unfold resolventSecondDiff
          rw [Complex.sub_re, Complex.sub_re, h2,
            re_one_div_eq_laplace_cos ha u,
            re_one_div_eq_laplace_cos ha (u - γ),
            re_one_div_eq_laplace_cos ha (u + γ)]
  have hint_ker : ∀ u : ℝ, IntegrableOn
      (fun t : ℝ => (2 * Real.exp (-a * t) * (1 - Real.cos (γ * t))) * Real.cos (t * u)) (Ioi 0) := by
    intro u
    refine Integrable.mono' (hint_exp.const_mul 4) ?_ (Eventually.of_forall fun t => ?_)
    · exact (Continuous.aestronglyMeasurable (by fun_prop)).restrict
    · have hc1 : -1 ≤ Real.cos (γ * t) := Real.neg_one_le_cos _
      have hc2 : Real.cos (γ * t) ≤ 1 := Real.cos_le_one _
      have hpos : 0 ≤ 2 * Real.exp (-a * t) * (1 - Real.cos (γ * t)) :=
        mul_nonneg (by positivity) (by linarith)
      rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg hpos]
      have h1 : 2 * Real.exp (-a * t) * (1 - Real.cos (γ * t)) ≤ 4 * Real.exp (-a * t) := by
        nlinarith [Real.exp_pos (-a * t)]
      exact (mul_le_of_le_one_right hpos (Real.abs_cos_le_one _)).trans h1
  refine ⟨fun u => ?_, fun n x c => ?_⟩
  · rw [hrep (-u), hrep u]
    refine setIntegral_congr_fun measurableSet_Ioi fun t _ => ?_
    rw [mul_neg, Real.cos_neg]
  · have hsum_int : ∑ i, ∑ j, c i * c j * resolventSecondDiff a γ (x i - x j) =
        ∫ t : ℝ in Ioi 0, (2 * Real.exp (-a * t) * (1 - Real.cos (γ * t))) *
          ∑ i, ∑ j, c i * c j * Real.cos (t * (x i - x j)) := by
      simp_rw [hrep, ← integral_const_mul]
      have h1 : ∀ i : Fin n,
          ∑ j : Fin n, ∫ t : ℝ in Ioi 0, c i * c j *
            ((2 * Real.exp (-a * t) * (1 - Real.cos (γ * t))) * Real.cos (t * (x i - x j))) =
          ∫ t : ℝ in Ioi 0, ∑ j : Fin n, c i * c j *
            ((2 * Real.exp (-a * t) * (1 - Real.cos (γ * t))) * Real.cos (t * (x i - x j))) :=
        fun i => (integral_finsetSum Finset.univ fun j _ =>
          (hint_ker (x i - x j)).const_mul (c i * c j)).symm
      simp_rw [h1]
      rw [← integral_finsetSum Finset.univ fun i _ =>
        integrable_finsetSum Finset.univ fun j _ =>
          (hint_ker (x i - x j)).const_mul (c i * c j)]
      refine setIntegral_congr_fun measurableSet_Ioi fun t _ => ?_
      simp_rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
      ring
    rw [hsum_int]
    refine integral_nonneg fun t => mul_nonneg ?_ ?_
    · exact mul_nonneg (by positivity) (sub_nonneg.mpr (Real.cos_le_one _))
    · rw [gram_cos_eq]
      positivity

/-- Symmetric degree-`4` polynomial `((s − 1)² + γ²)(s² + γ²)` placing boundary zeros at
`1 ± iγ` and `± iγ`. -/
def boundaryTwistPoly (γ : ℝ) (s : ℂ) : ℂ :=
  ((s - 1) ^ 2 + (γ : ℂ) ^ 2) * (s ^ 2 + (γ : ℂ) ^ 2)

/-- Uncompleted rational boundary twist factor `((s − 1)² + γ²)(s² + γ²) / (s(s − 1))²`. -/
def boundaryTwistFactor (γ : ℝ) (s : ℂ) : ℂ :=
  boundaryTwistPoly γ s / (s * (s - 1)) ^ 2

private theorem boundaryTwistPoly_factor (γ : ℝ) (s : ℂ) :
    boundaryTwistPoly γ s =
      (s - 1 - (γ : ℂ) * I) * (s - 1 + (γ : ℂ) * I) * (s - (γ : ℂ) * I) * (s + (γ : ℂ) * I) := by
  unfold boundaryTwistPoly
  have hI : (I : ℂ) ^ 2 = -1 := I_sq
  have h1 : (s - 1 - (γ : ℂ) * I) * (s - 1 + (γ : ℂ) * I) = (s - 1) ^ 2 + (γ : ℂ) ^ 2 := by
    calc (s - 1 - (γ : ℂ) * I) * (s - 1 + (γ : ℂ) * I)
        = (s - 1) ^ 2 - (γ : ℂ) ^ 2 * I ^ 2 := by ring
      _ = (s - 1) ^ 2 + (γ : ℂ) ^ 2 := by rw [hI]; ring
  have h2 : (s - (γ : ℂ) * I) * (s + (γ : ℂ) * I) = s ^ 2 + (γ : ℂ) ^ 2 := by
    calc (s - (γ : ℂ) * I) * (s + (γ : ℂ) * I)
        = s ^ 2 - (γ : ℂ) ^ 2 * I ^ 2 := by ring
      _ = s ^ 2 + (γ : ℂ) ^ 2 := by rw [hI]; ring
  calc boundaryTwistPoly γ s = ((s - 1) ^ 2 + (γ : ℂ) ^ 2) * (s ^ 2 + (γ : ℂ) ^ 2) := rfl
    _ = ((s - 1 - (γ : ℂ) * I) * (s - 1 + (γ : ℂ) * I)) *
          ((s - (γ : ℂ) * I) * (s + (γ : ℂ) * I)) := by rw [h1, h2]
    _ = (s - 1 - (γ : ℂ) * I) * (s - 1 + (γ : ℂ) * I) *
          (s - (γ : ℂ) * I) * (s + (γ : ℂ) * I) := by ring

private theorem orderOneEnvelope_boundaryTwistPoly (γ : ℝ) :
    OrderOneEnvelope (boundaryTwistPoly γ) := by
  have hid := RHTower.orderOneEnvelope_id
  have hs1 : OrderOneEnvelope (fun s : ℂ => s - 1) :=
    (hid.add (orderOneEnvelope_const (-1))).congr fun s => by ring
  have hsq1 : OrderOneEnvelope (fun s : ℂ => (s - 1) ^ 2 + (γ : ℂ) ^ 2) :=
    ((hs1.mul hs1).add (orderOneEnvelope_const ((γ : ℂ) ^ 2))).congr fun s => by ring
  have hsq0 : OrderOneEnvelope (fun s : ℂ => s ^ 2 + (γ : ℂ) ^ 2) :=
    ((hid.mul hid).add (orderOneEnvelope_const ((γ : ℂ) ^ 2))).congr fun s => by ring
  exact hsq1.mul hsq0

private theorem neg_logDeriv_boundaryTwistFactor_re (γ : ℝ) {σ : ℝ} (hσ : 1 < σ) (u : ℝ) :
    (-logDeriv (boundaryTwistFactor γ) ((σ : ℂ) + (u : ℂ) * I)).re =
      resolventSecondDiff (σ - 1) γ u + resolventSecondDiff σ γ u := by
  set s : ℂ := (σ : ℂ) + (u : ℂ) * I
  have hsre : s.re = σ := by simp [s]
  have hs0 : s ≠ 0 := fun h => by rw [h] at hsre; simp at hsre; linarith
  have hs1 : s - 1 ≠ 0 := sub_ne_zero.mpr fun h => by rw [h] at hsre; simp at hsre; linarith
  have hn1 : s - 1 - (γ : ℂ) * I ≠ 0 := fun h => by
    have := congrArg Complex.re h; simp [hsre] at this; linarith
  have hn2 : s - 1 + (γ : ℂ) * I ≠ 0 := fun h => by
    have := congrArg Complex.re h; simp [hsre] at this; linarith
  have hn3 : s - (γ : ℂ) * I ≠ 0 := fun h => by
    have := congrArg Complex.re h; simp [hsre] at this; linarith
  have hn4 : s + (γ : ℂ) * I ≠ 0 := fun h => by
    have := congrArg Complex.re h; simp [hsre] at this; linarith
  have hd_lin : ∀ c : ℂ, logDeriv (fun z : ℂ => z - c) s = 1 / (s - c) := fun c => by
    rw [logDeriv_apply, deriv_sub_const, deriv_id'', one_div]
  have hf_eq : boundaryTwistFactor γ =
      fun z : ℂ => ((z - (1 + (γ : ℂ) * I)) * (z - (1 - (γ : ℂ) * I)) *
        (z - (γ : ℂ) * I) * (z - (-(γ : ℂ) * I))) / (z ^ 2 * (z - 1) ^ 2) := by
    funext z
    unfold boundaryTwistFactor
    rw [boundaryTwistPoly_factor, mul_pow]
    congr 1; ring
  have hnum_ne : ((s - (1 + (γ : ℂ) * I)) * (s - (1 - (γ : ℂ) * I)) *
      (s - (γ : ℂ) * I) * (s - (-(γ : ℂ) * I))) ≠ 0 := by
    refine mul_ne_zero (mul_ne_zero (mul_ne_zero ?_ ?_) hn3) ?_
    · convert hn1 using 1; ring
    · convert hn2 using 1; ring
    · convert hn4 using 1; ring
  have hden_ne : s ^ 2 * (s - 1) ^ 2 ≠ 0 := mul_ne_zero (pow_ne_zero 2 hs0) (pow_ne_zero 2 hs1)
  have hd1 : DifferentiableAt ℂ (fun z : ℂ => z - (1 + (γ : ℂ) * I)) s :=
    differentiableAt_id.sub_const _
  have hd2 : DifferentiableAt ℂ (fun z : ℂ => z - (1 - (γ : ℂ) * I)) s :=
    differentiableAt_id.sub_const _
  have hd3 : DifferentiableAt ℂ (fun z : ℂ => z - (γ : ℂ) * I) s :=
    differentiableAt_id.sub_const _
  have hd4 : DifferentiableAt ℂ (fun z : ℂ => z - (-(γ : ℂ) * I)) s :=
    differentiableAt_id.sub_const _
  have hds0 : DifferentiableAt ℂ (fun z : ℂ => z) s := differentiableAt_id
  have hds1 : DifferentiableAt ℂ (fun z : ℂ => z - 1) s := differentiableAt_id.sub_const 1
  have hld_num : logDeriv (fun z : ℂ => (z - (1 + (γ : ℂ) * I)) * (z - (1 - (γ : ℂ) * I)) *
      (z - (γ : ℂ) * I) * (z - (-(γ : ℂ) * I))) s =
      1 / (s - (1 + (γ : ℂ) * I)) + 1 / (s - (1 - (γ : ℂ) * I)) +
        1 / (s - (γ : ℂ) * I) + 1 / (s - (-(γ : ℂ) * I)) := by
    have p12_ne : (s - (1 + (γ : ℂ) * I)) * (s - (1 - (γ : ℂ) * I)) ≠ 0 :=
      mul_ne_zero (by convert hn1 using 1; ring) (by convert hn2 using 1; ring)
    have p123_ne : (s - (1 + (γ : ℂ) * I)) * (s - (1 - (γ : ℂ) * I)) * (s - (γ : ℂ) * I) ≠ 0 :=
      mul_ne_zero p12_ne hn3
    have p4_ne : s - (-(γ : ℂ) * I) ≠ 0 := by convert hn4 using 1; ring
    rw [logDeriv_mul (f := fun z => (z - (1 + (γ : ℂ) * I)) * (z - (1 - (γ : ℂ) * I)) *
          (z - (γ : ℂ) * I)) (g := fun z => z - (-(γ : ℂ) * I)) s
          p123_ne p4_ne ((hd1.mul hd2).mul hd3) hd4,
      logDeriv_mul (f := fun z => (z - (1 + (γ : ℂ) * I)) * (z - (1 - (γ : ℂ) * I)))
        (g := fun z => z - (γ : ℂ) * I) s p12_ne hn3 (hd1.mul hd2) hd3,
      logDeriv_mul (f := fun z => z - (1 + (γ : ℂ) * I)) (g := fun z => z - (1 - (γ : ℂ) * I)) s
        (by convert hn1 using 1; ring) (by convert hn2 using 1; ring) hd1 hd2,
      hd_lin, hd_lin, hd_lin, hd_lin]
  have hld_den : logDeriv (fun z : ℂ => z ^ 2 * (z - 1) ^ 2) s =
      2 / s + 2 / (s - 1) := by
    rw [logDeriv_mul (f := fun z : ℂ => z ^ 2) (g := fun z : ℂ => (z - 1) ^ 2) s
          (pow_ne_zero 2 hs0) (pow_ne_zero 2 hs1) (hds0.fun_pow 2) (hds1.fun_pow 2),
      logDeriv_fun_pow hds0 2, logDeriv_fun_pow hds1 2]
    have h0' : logDeriv (fun z : ℂ => z) s = 1 / s := by rw [logDeriv_apply, deriv_id'', one_div]
    rw [h0', hd_lin 1]
    push_cast; ring
  have hld : -logDeriv (boundaryTwistFactor γ) s =
      (2 / (((σ - 1 : ℝ) : ℂ) + (u : ℂ) * I) -
        1 / (((σ - 1 : ℝ) : ℂ) + ((u - γ : ℝ) : ℂ) * I) -
        1 / (((σ - 1 : ℝ) : ℂ) + ((u + γ : ℝ) : ℂ) * I)) +
      (2 / ((σ : ℂ) + (u : ℂ) * I) -
        1 / ((σ : ℂ) + ((u - γ : ℝ) : ℂ) * I) -
        1 / ((σ : ℂ) + ((u + γ : ℝ) : ℂ) * I)) := by
    rw [hf_eq,
      logDeriv_div
        (f := fun z : ℂ => (z - (1 + (γ : ℂ) * I)) * (z - (1 - (γ : ℂ) * I)) *
          (z - (γ : ℂ) * I) * (z - (-(γ : ℂ) * I)))
        (g := fun z : ℂ => z ^ 2 * (z - 1) ^ 2)
        s hnum_ne hden_ne (((hd1.mul hd2).mul hd3).mul hd4)
        ((hds0.fun_pow 2).mul (hds1.fun_pow 2)),
      hld_num, hld_den]
    have e1 : s - 1 = ((σ - 1 : ℝ) : ℂ) + (u : ℂ) * I := by simp [s]; ring
    have e2 : s - (1 + (γ : ℂ) * I) = ((σ - 1 : ℝ) : ℂ) + ((u - γ : ℝ) : ℂ) * I := by
      simp [s]; ring
    have e3 : s - (1 - (γ : ℂ) * I) = ((σ - 1 : ℝ) : ℂ) + ((u + γ : ℝ) : ℂ) * I := by
      simp [s]; ring
    have e4 : s - (γ : ℂ) * I = (σ : ℂ) + ((u - γ : ℝ) : ℂ) * I := by
      simp [s]; ring
    have e5 : s - (-(γ : ℂ) * I) = (σ : ℂ) + ((u + γ : ℝ) : ℂ) * I := by
      simp [s]; ring
    rw [e1, e2, e3, e4, e5]
    simp only [s]
    ring
  rw [hld, Complex.add_re]
  rfl

/-- Twisting any `CompletedPositiveSystem κ d F Λ` by `boundaryTwistFactor γ` produces a
`CompletedPositiveSystem (κ + 2) d` whose completion vanishes at `1 + iγ` while preserving every
existing zero of `Λ`. -/
theorem CompletedPositiveSystem.twistBoundaryZero {κ d : ℕ} {F Λ : ℂ → ℂ}
    (hS : CompletedPositiveSystem κ d F Λ) (γ : ℝ) :
    CompletedPositiveSystem (κ + 2) d
      (fun s => F s * boundaryTwistFactor γ s)
      (fun s => Λ s * boundaryTwistPoly γ s) ∧
    (Λ (1 + (γ : ℂ) * I) * boundaryTwistPoly γ (1 + (γ : ℂ) * I) = 0) := by
  have hpoly_zero : boundaryTwistPoly γ (1 + (γ : ℂ) * I) = 0 := by
    rw [boundaryTwistPoly_factor]
    have : (1 + (γ : ℂ) * I) - 1 - (γ : ℂ) * I = 0 := by ring
    rw [this]; simp
  refine ⟨?_, by rw [hpoly_zero, mul_zero]⟩
  have htf_nz : ∀ s : ℂ, 1 < s.re → boundaryTwistFactor γ s ≠ 0 := by
    intro s hs
    obtain ⟨hs0, hs1⟩ := ne_zero_and_sub_one_of_one_lt_re hs
    have hp_nz : boundaryTwistPoly γ s ≠ 0 := by
      rw [boundaryTwistPoly_factor]
      have n1 : s - 1 - (γ : ℂ) * I ≠ 0 := fun h => by
        have := congrArg Complex.re h; simp at this; linarith
      have n2 : s - 1 + (γ : ℂ) * I ≠ 0 := fun h => by
        have := congrArg Complex.re h; simp at this; linarith
      have n3 : s - (γ : ℂ) * I ≠ 0 := fun h => by
        have := congrArg Complex.re h; simp at this; linarith
      have n4 : s + (γ : ℂ) * I ≠ 0 := fun h => by
        have := congrArg Complex.re h; simp at this; linarith
      exact mul_ne_zero (mul_ne_zero (mul_ne_zero n1 n2) n3) n4
    exact div_ne_zero hp_nz (pow_ne_zero 2 (mul_ne_zero hs0 hs1))
  have htf_diffOn : DifferentiableOn ℂ (boundaryTwistFactor γ) {s : ℂ | 1 < s.re} := by
    intro s hs
    change 1 < s.re at hs
    obtain ⟨hs0, hs1⟩ := ne_zero_and_sub_one_of_one_lt_re hs
    have hden : (s * (s - 1)) ^ 2 ≠ 0 := pow_ne_zero 2 (mul_ne_zero hs0 hs1)
    have hpd : DifferentiableAt ℂ (boundaryTwistPoly γ) s := by unfold boundaryTwistPoly; fun_prop
    have hdd : DifferentiableAt ℂ (fun z : ℂ => (z * (z - 1)) ^ 2) s := by fun_prop
    exact (hpd.div hdd hden).differentiableWithinAt
  refine
    { degree_pos := hS.degree_pos
      diffOn_F := hS.diffOn_F.mul htf_diffOn
      ne_zero_F := fun s hs => mul_ne_zero (hS.ne_zero_F s hs) (htf_nz s hs)
      posDef_neg_logDeriv := ?_
      entire_Λ := hS.entire_Λ.mul (by unfold boundaryTwistPoly; fun_prop)
      orderOne_Λ := hS.orderOne_Λ.mul (orderOneEnvelope_boundaryTwistPoly γ)
      sym_Λ := fun s => by
        rw [hS.sym_Λ]
        congr 1
        unfold boundaryTwistPoly
        ring
      conj_Λ := fun s => by
        rw [map_mul, hS.conj_Λ]
        congr 1
        unfold boundaryTwistPoly
        simp only [map_mul, map_add, map_pow, map_sub, map_one, Complex.conj_ofReal]
      completed_eq := fun s hs => by
        obtain ⟨hs0, hs1⟩ := ne_zero_and_sub_one_of_one_lt_re hs
        have hden : (s * (s - 1)) ^ 2 ≠ 0 := pow_ne_zero 2 (mul_ne_zero hs0 hs1)
        unfold boundaryTwistFactor
        rw [hS.completed_eq s hs, pow_add]
        have hmul : (s * (s - 1)) ^ 2 * (boundaryTwistPoly γ s / (s * (s - 1)) ^ 2) =
            boundaryTwistPoly γ s := mul_div_cancel₀ _ hden
        symm
        calc (s * (s - 1)) ^ κ * (s * (s - 1)) ^ 2 * Complex.Gammaℝ s ^ d *
              (F s * (boundaryTwistPoly γ s / (s * (s - 1)) ^ 2))
            = (s * (s - 1)) ^ κ * Complex.Gammaℝ s ^ d * F s *
                ((s * (s - 1)) ^ 2 * (boundaryTwistPoly γ s / (s * (s - 1)) ^ 2)) := by ring
          _ = (s * (s - 1)) ^ κ * Complex.Gammaℝ s ^ d * F s * boundaryTwistPoly γ s := by
              rw [hmul] }
  -- Prove `posDef_neg_logDeriv` for `F * boundaryTwistFactor γ`.
  intro σ hσ
  have hopen : IsOpen {w : ℂ | 1 < w.re} := isOpen_lt continuous_const Complex.continuous_re
  have heq : (fun u : ℝ =>
      (-logDeriv (fun s => F s * boundaryTwistFactor γ s) ((σ : ℂ) + (u : ℂ) * I)).re) =
      fun u : ℝ => (-logDeriv F ((σ : ℂ) + (u : ℂ) * I)).re +
        (resolventSecondDiff (σ - 1) γ u + resolventSecondDiff σ γ u) := by
    funext u
    set s : ℂ := (σ : ℂ) + (u : ℂ) * I
    have hs : 1 < s.re := by simp [s]; exact hσ
    have hFd : DifferentiableAt ℂ F s := (hS.diffOn_F s hs).differentiableAt (hopen.mem_nhds hs)
    have htd : DifferentiableAt ℂ (boundaryTwistFactor γ) s :=
      (htf_diffOn s hs).differentiableAt (hopen.mem_nhds hs)
    rw [logDeriv_mul s (hS.ne_zero_F s hs) (htf_nz s hs) hFd htd, neg_add, Complex.add_re,
      neg_logDeriv_boundaryTwistFactor_re γ hσ u]
  rw [heq]
  exact isEvenPosDef_add (hS.posDef_neg_logDeriv hσ)
    (isEvenPosDef_add (isEvenPosDef_resolventSecondDiff (by linarith) γ)
      (isEvenPosDef_resolventSecondDiff (by linarith) γ))

/-- **Exact sharpness of the half-pole threshold `2M > κ`.** For every `r ∈ ℕ` and any `r`
ordinates `γ : Fin r → ℝ`, iterating `twistBoundaryZero` `r` times on `ζ` constructs an explicit
`CompletedPositiveSystem (2 * r + 1) 1 F Λ` whose completion vanishes on the boundary line `Re s = 1`
at all `r` points `1 + i γ_ℓ` (`2 r = κ − 1 ≤ κ`, zero interior depth). Consequently, the strict
inequality `κ < 2 * ∑_ℓ m_ℓ` in `collective_half_pole_interior_forcing` cannot be weakened for any
`r ∈ ℕ`. -/
theorem exists_completedPositiveSystem_boundary_zeros_at_half_pole (r : ℕ) (γ : Fin r → ℝ) :
    ∃ F Λ : ℂ → ℂ,
      CompletedPositiveSystem (2 * r + 1) 1 F Λ ∧
      ∀ ℓ : Fin r, Λ (1 + (γ ℓ : ℂ) * I) = 0 := by
  induction r with
  | zero =>
    exact ⟨riemannZeta, fun s => 2 * RHTower.xi s, completedPositiveSystem_riemannZeta,
      fun ℓ => Fin.elim0 ℓ⟩
  | succ r ih =>
    obtain ⟨F₀, Λ₀, hS₀, hzeros₀⟩ := ih (fun i => γ i.castSucc)
    obtain ⟨hS₁, hzero_last⟩ := hS₀.twistBoundaryZero (γ (Fin.last r))
    have hκ : 2 * r + 1 + 2 = 2 * (r + 1) + 1 := by omega
    rw [hκ] at hS₁
    refine ⟨_, _, hS₁, fun ℓ => ?_⟩
    rcases Fin.eq_castSucc_or_eq_last ℓ with ⟨i, rfl⟩ | rfl
    · simp [hzeros₀ i]
    · exact hzero_last

end GaloisForLFunctions.StripBochnerWeilForcing
