          _ ≤ ∑ p ∈ (Finset.univ ×ˢ Finset.univ : Finset (Fin n × Fin n)),
                (1 / (((1 + δ : ℝ) : ℂ) + ((x p.1 - x p.2 : ℝ) : ℂ) * I - ρ ℓ)).re :=
