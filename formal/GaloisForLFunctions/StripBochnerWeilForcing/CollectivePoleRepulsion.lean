      rw [hcard_minus] at hsub2
      have hT_div : (1 - 1 / (4 * (M : ℝ))) / (δ + η) ≤ (1 / (n : ℝ)) * (((T ℓ).card : ℝ) / (δ + η)) := by
        have h1 : (1 - 1 / (4 * (M : ℝ))) ≤ (1 / (n : ℝ)) * ((T ℓ).card : ℝ) := by
