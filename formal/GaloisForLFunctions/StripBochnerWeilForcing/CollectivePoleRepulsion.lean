        have hMne : (M : ℝ) ≠ 0 := hM_pos_r.ne'
        field_simp; ring
      rw [← halg, ← hsum_m, Finset.sum_mul]
      exact Finset.sum_le_sum fun ℓ _ => mul_le_mul_of_nonneg_left (hlhs_ℓ ℓ) (Nat.cast_nonneg _)
