/-! ### 1. Completed positive systems and finite-order envelope upgrade -/

/-- A **completed positive system** of pole budget `κ` and archimedean degree `d ≥ 1`:
`F` is holomorphic and nonvanishing on `{Re s > 1}` with even positive-definite vertical sections
`u ↦ Re(−F'/F)(σ + iu)` for every `σ > 1`, and `Λ(s) = (s(s − 1))^κ Γ_ℝ(s)^d F(s)` extends to an
entire function in the order-one growth envelope satisfying `Λ(1 − s) = Λ(s)` and
`Λ(s̄) = conj(Λ(s))`. -/
structure CompletedPositiveSystem (κ d : ℕ) (F Λ : ℂ → ℂ) : Prop where
  degree_pos : 1 ≤ d
  diffOn_F : DifferentiableOn ℂ F {s : ℂ | 1 < s.re}
  ne_zero_F : ∀ s : ℂ, 1 < s.re → F s ≠ 0
  posDef_neg_logDeriv : ∀ {σ : ℝ}, 1 < σ →
    IsEvenPosDef (fun u : ℝ => (-logDeriv F ((σ : ℂ) + (u : ℂ) * I)).re)
  entire_Λ : Differentiable ℂ Λ
  orderOne_Λ : OrderOneEnvelope Λ
  sym_Λ : ∀ s : ℂ, Λ (1 - s) = Λ s
  conj_Λ : ∀ s : ℂ, Λ (starRingEnd ℂ s) = starRingEnd ℂ (Λ s)
  completed_eq : ∀ s : ℂ, 1 < s.re →
    Λ s = (s * (s - 1)) ^ κ * Complex.Gammaℝ s ^ d * F s

namespace CompletedPositiveSystem

/-- Any finite-order entire completion `Λ` whose uncompleted factor `F` is bounded on `{Re s ≥ 2}`
automatically lies in `OrderOneEnvelope`, via Phragmén–Lindelöf on `−1 ≤ Re s ≤ 2` and Stirling's
envelope on `Re s ≥ 2`. -/
theorem ofFiniteOrder {κ d : ℕ} {F Λ : ℂ → ℂ}
    (hd : 1 ≤ d)
    (hF : DifferentiableOn ℂ F {s : ℂ | 1 < s.re})
    (hFnz : ∀ s : ℂ, 1 < s.re → F s ≠ 0)
    (hFbdd : ∃ S : ℝ, ∀ s : ℂ, 2 ≤ s.re → ‖F s‖ ≤ S)
    (hpos : ∀ {σ : ℝ}, 1 < σ →
      IsEvenPosDef (fun u : ℝ => (-logDeriv F ((σ : ℂ) + (u : ℂ) * I)).re))
    (hΛ : Differentiable ℂ Λ)
    (hfin : ∃ ρ C₀ : ℝ, ∀ s : ℂ, ‖Λ s‖ ≤ C₀ * Real.exp (‖s‖ ^ ρ))
    (hsym : ∀ s : ℂ, Λ (1 - s) = Λ s)
    (hconj : ∀ s : ℂ, Λ (starRingEnd ℂ s) = starRingEnd ℂ (Λ s))
    (hcomp : ∀ s : ℂ, 1 < s.re → Λ s = (s * (s - 1)) ^ κ * Complex.Gammaℝ s ^ d * F s) :
    CompletedPositiveSystem κ d F Λ := by
  refine ⟨hd, hF, hFnz, hpos, hΛ, ?_, hsym, hconj, hcomp⟩
  obtain ⟨ρ, C₀, hfin'⟩ := hfin
  obtain ⟨S₀, hS₀⟩ := hFbdd
  set S : ℝ := max S₀ 0
  have hS_nonneg : 0 ≤ S := le_max_right _ _
  have hFb : ∀ s : ℂ, 2 ≤ s.re → ‖F s‖ ≤ S := fun s hs => (hS₀ s hs).trans (le_max_left _ _)
  have hflip : ∀ s : ℂ, ‖Λ s‖ = ‖Λ (1 - s)‖ := fun s => by
    have h := hsym (1 - s); rw [sub_sub_cancel] at h; rw [h]
  obtain ⟨B₁, hB₁0, hB₁⟩ := RHTower.TwinRigidity.exists_bound_completionFactor_pole
    (m := 1) le_rfl κ hd
  have hline : ∀ z : ℂ, z.re = 2 → ‖Λ z‖ ≤ B₁ * S := by
    intro z hz
    have hz' : z = (((2 * 1 : ℕ) : ℂ) + (z.im : ℂ) * I) := by
      apply Complex.ext <;> simp [hz]
    rw [hcomp z (by linarith), norm_mul]
    refine mul_le_mul ?_ (hFb z hz.ge) (norm_nonneg _) hB₁0
    rw [hz']
    exact hB₁ z.im
  have hstrip : ∀ z : ℂ, -1 ≤ z.re → z.re ≤ 2 → ‖Λ z‖ ≤ B₁ * S := fun z h1 h2 =>
    PhragmenLindelof.vertical_strip hΛ.diffContOnCl
      (RHTower.CompletionGrowth.isBigO_strip_of_finiteOrder_at hfin' (by norm_num))
      (fun w hw => by rw [hflip]; exact hline (1 - w) (by simp [hw]; ring)) hline h1 h2
  obtain ⟨C₁, hC₁0, hC₁⟩ := RHTower.CompletionGrowth.le_exp_envelope (A := S) (M := d)
    (Nat.cast_nonneg d) (2 * κ)
  have hright : ∀ s : ℂ, 2 ≤ s.re →
      ‖Λ s‖ ≤ Real.exp (C₁ * (1 + ‖s‖) * Real.log (2 + ‖s‖)) := by
    intro s hs
    refine le_trans ?_ (hC₁ ‖s‖ (norm_nonneg s))
    rw [hcomp s (by linarith), norm_mul, norm_mul, norm_pow, norm_pow, norm_mul]
    have h1 : ‖s‖ ≤ 1 + ‖s‖ := by linarith
    have h2 : ‖s - 1‖ ≤ 1 + ‖s‖ := by
      calc ‖s - 1‖ ≤ ‖s‖ + ‖(1 : ℂ)‖ := norm_sub_le _ _
        _ = 1 + ‖s‖ := by simp; ring
    have hG := RHTower.CompletionGrowth.norm_Gammaℝ_le (s := s) (by linarith)
    calc (‖s‖ * ‖s - 1‖) ^ κ * ‖Complex.Gammaℝ s‖ ^ d * ‖F s‖
        ≤ ((1 + ‖s‖) * (1 + ‖s‖)) ^ κ * Real.exp (‖s‖ * Real.log (2 + ‖s‖)) ^ d * S := by
          gcongr
          exact hFb s hs
      _ = S * (1 + ‖s‖) ^ (2 * κ) * Real.exp (d * ‖s‖ * Real.log (2 + ‖s‖)) := by
          rw [← Real.exp_nat_mul, ← pow_two, ← pow_mul]
          ring_nf
  obtain ⟨C₂, hC₂0, hC₂⟩ := RHTower.CompletionGrowth.le_exp_envelope (A := B₁ * S) (M := 0)
    le_rfl 0
  set C : ℝ := 4 * C₁ + C₂ + 1
  refine ⟨C, by positivity, fun s => ?_⟩
  have hmono : ∀ C' : ℝ, C' ≤ C →
      Real.exp (C' * (1 + ‖s‖) * Real.log (2 + ‖s‖)) ≤ Real.exp (orderOneWeight C s) := by
    intro C' hC'
    rw [orderOneWeight, Real.exp_le_exp]
    exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hC' (by positivity))
      (Real.log_nonneg (by linarith [norm_nonneg s]))
  rcases le_or_gt 2 s.re with h2 | h2
  · exact (hright s h2).trans (hmono C₁ (by simp only [C]; linarith))
  rcases le_or_gt (-1) s.re with h1 | h1
  · have h0 := hC₂ ‖s‖ (norm_nonneg s)
    simp only [pow_zero, mul_one, zero_mul, Real.exp_zero] at h0
    exact ((hstrip s h1 h2.le).trans h0).trans (hmono C₂ (by simp only [C]; linarith))
  · rw [hflip]
    have hre : 2 ≤ (1 - s).re := by simp; linarith
    refine (hright (1 - s) hre).trans ?_
    refine le_trans ?_ (hmono (4 * C₁) (by simp only [C]; linarith))
    rw [Real.exp_le_exp]
    have hn : ‖1 - s‖ ≤ 1 + ‖s‖ := by
      calc ‖1 - s‖ ≤ ‖(1 : ℂ)‖ + ‖s‖ := norm_sub_le _ _
        _ = 1 + ‖s‖ := by simp
    have hx := norm_nonneg s
    have hl : Real.log (2 + ‖1 - s‖) ≤ 2 * Real.log (2 + ‖s‖) := by
      rw [← Real.log_rpow (by positivity)]
      refine Real.log_le_log (by positivity) ?_
      norm_num
      nlinarith
    have hl0 : 0 ≤ Real.log (2 + ‖1 - s‖) := Real.log_nonneg (by linarith [norm_nonneg (1 - s)])
    calc C₁ * (1 + ‖1 - s‖) * Real.log (2 + ‖1 - s‖)
        ≤ C₁ * (2 * (1 + ‖s‖)) * (2 * Real.log (2 + ‖s‖)) :=
          mul_le_mul (mul_le_mul_of_nonneg_left (by linarith) hC₁0) hl hl0 (by positivity)
      _ = 4 * C₁ * (1 + ‖s‖) * Real.log (2 + ‖s‖) := by ring

variable {κ d : ℕ} {F Λ : ℂ → ℂ}

theorem ne_zero_of_one_lt_re (hS : CompletedPositiveSystem κ d F Λ) {s : ℂ} (hs : 1 < s.re) :
    Λ s ≠ 0 := by
  rw [hS.completed_eq s hs]
  have hs0 : s ≠ 0 := fun h => by rw [h] at hs; simp at hs
  have hs1 : s - 1 ≠ 0 := sub_ne_zero.mpr fun h => by rw [h] at hs; simp at hs
  have hΓ : Complex.Gammaℝ s ≠ 0 := Complex.Gammaℝ_ne_zero_of_re_pos (by linarith)
  exact mul_ne_zero (mul_ne_zero (pow_ne_zero κ (mul_ne_zero hs0 hs1)) (pow_ne_zero d hΓ))
    (hS.ne_zero_F s hs)

theorem two_ne_zero (hS : CompletedPositiveSystem κ d F Λ) : Λ 2 ≠ 0 :=
  hS.ne_zero_of_one_lt_re (by norm_num)

/-- Every zero of `Λ` lies in the closed critical strip `0 ≤ Re ρ ≤ 1`. -/
theorem zero_re_mem_Icc (hS : CompletedPositiveSystem κ d F Λ) {ρ : ℂ} (hρ : Λ ρ = 0) :
    0 ≤ ρ.re ∧ ρ.re ≤ 1 := by
  refine ⟨?_, ?_⟩
  · by_contra hlt
    rw [not_le] at hlt
    have h1 : 1 < (1 - ρ).re := by simp; linarith
    exact hS.ne_zero_of_one_lt_re h1 (by rw [hS.sym_Λ, hρ])
  · by_contra hgt
    rw [not_le] at hgt
    exact hS.ne_zero_of_one_lt_re hgt hρ

theorem analyticOnNhd_univ (hS : CompletedPositiveSystem κ d F Λ) : AnalyticOnNhd ℂ Λ univ :=
  hS.entire_Λ.differentiableOn.analyticOnNhd isOpen_univ

theorem orderAt_ne_top (hS : CompletedPositiveSystem κ d F Λ) (z : ℂ) :
    analyticOrderAt Λ z ≠ ⊤ :=
  hS.analyticOnNhd_univ.analyticOrderAt_ne_top_of_isPreconnected isPreconnected_univ
    (mem_univ 2) (mem_univ z)
    (by rw [(hS.analyticOnNhd_univ 2 (mem_univ 2)).analyticOrderAt_eq_zero.mpr hS.two_ne_zero]
        exact ENat.zero_ne_top)

theorem one_le_order_toNat_of_eq_zero (hS : CompletedPositiveSystem κ d F Λ) {ρ : ℂ}
    (hρ : Λ ρ = 0) : 1 ≤ (analyticOrderAt Λ ρ).toNat := by
  have hne0 : analyticOrderAt Λ ρ ≠ 0 := fun hz =>
    ((hS.analyticOnNhd_univ ρ (mem_univ ρ)).analyticOrderAt_eq_zero.mp hz) hρ
  obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp (hS.orderAt_ne_top ρ)
  rcases eq_or_ne m 0 with rfl | hm0
  · exact absurd hm.symm hne0
  · rw [← hm, ENat.toNat_coe]
    omega

theorem eq_zero_of_one_le_order_toNat (hS : CompletedPositiveSystem κ d F Λ) {ρ : ℂ}
    (hm : 1 ≤ (analyticOrderAt Λ ρ).toNat) : Λ ρ = 0 := by
  by_contra hnz
  rw [(hS.analyticOnNhd_univ ρ (mem_univ ρ)).analyticOrderAt_eq_zero.mpr hnz] at hm
  simp at hm

theorem orderAt_one_sub (hS : CompletedPositiveSystem κ d F Λ) (z : ℂ) :
    analyticOrderAt Λ (1 - z) = analyticOrderAt Λ z := by
  have h := RHTower.analyticOrderAt_comp_one_sub hS.entire_Λ z
  rwa [show (fun w => Λ (1 - w)) = Λ from funext hS.sym_Λ] at h

theorem orderAt_conj (hS : CompletedPositiveSystem κ d F Λ) (z : ℂ) :
    analyticOrderAt Λ (starRingEnd ℂ z) = analyticOrderAt Λ z :=
  RHTower.analyticOrderAt_conj_of_conjEquivariant hS.conj_Λ
    (hS.analyticOnNhd_univ z (mem_univ z))
    (hS.analyticOnNhd_univ (starRingEnd ℂ z) (mem_univ _))

/-- Logarithmic derivative decomposition on `Re s > 1`:
`-F'/F(s) = κ(1/s + 1/(s − 1)) + d(Γ_ℝ'/Γ_ℝ)(s) − (Λ'/Λ)(s)`. -/
theorem neg_logDeriv_F_eq (hS : CompletedPositiveSystem κ d F Λ) {s : ℂ} (hs : 1 < s.re) :
    -logDeriv F s =
      (κ : ℂ) * (1 / s + 1 / (s - 1)) + (d : ℂ) * logDeriv Complex.Gammaℝ s - logDeriv Λ s := by
  have hopen : IsOpen {w : ℂ | 1 < w.re} := isOpen_lt continuous_const Complex.continuous_re
  have hev : Λ =ᶠ[𝓝 s] fun w => (w * (w - 1)) ^ κ * Complex.Gammaℝ w ^ d * F w :=
    Filter.eventuallyEq_of_mem (hopen.mem_nhds hs) fun w hw => hS.completed_eq w hw
  have hΛ_ld : logDeriv Λ s =
      logDeriv (fun w => (w * (w - 1)) ^ κ * Complex.Gammaℝ w ^ d * F w) s := by
    rw [logDeriv_apply, logDeriv_apply, hev.deriv_eq, hev.eq_of_nhds]
  have hs0 : s ≠ 0 := fun h => by rw [h] at hs; simp at hs
  have hs1 : s - 1 ≠ 0 := sub_ne_zero.mpr fun h => by rw [h] at hs; simp at hs
  have hq0 : s * (s - 1) ≠ 0 := mul_ne_zero hs0 hs1
  have hΓ0 : Complex.Gammaℝ s ≠ 0 := Complex.Gammaℝ_ne_zero_of_re_pos (by linarith)
  have hF0 : F s ≠ 0 := hS.ne_zero_F s hs
  have hqd : DifferentiableAt ℂ (fun w : ℂ => w * (w - 1)) s :=
    differentiableAt_id.mul (differentiableAt_id.sub_const 1)
  have hΓd : DifferentiableAt ℂ Complex.Gammaℝ s :=
    GaloisForLFunctions.differentiableAt_Gammaℝ (by linarith)
  have hFd : DifferentiableAt ℂ F s := (hS.diffOn_F s hs).differentiableAt (hopen.mem_nhds hs)
  rw [hΛ_ld,
    logDeriv_mul (f := fun w => (w * (w - 1)) ^ κ * Complex.Gammaℝ w ^ d) (g := F) s
      (mul_ne_zero (pow_ne_zero κ hq0) (pow_ne_zero d hΓ0)) hF0
      ((hqd.fun_pow κ).mul (hΓd.fun_pow d)) hFd,
    logDeriv_mul (f := fun w => (w * (w - 1)) ^ κ) (g := fun w => Complex.Gammaℝ w ^ d) s
      (pow_ne_zero κ hq0) (pow_ne_zero d hΓ0) (hqd.fun_pow κ) (hΓd.fun_pow d),
    logDeriv_fun_pow hqd κ, logDeriv_fun_pow hΓd d]
  have hq_ld : logDeriv (fun w : ℂ => w * (w - 1)) s = 1 / s + 1 / (s - 1) := by
    have hsub : DifferentiableAt ℂ (fun w : ℂ => w - 1) s := differentiableAt_id.sub_const 1
    rw [logDeriv_mul (f := fun w : ℂ => w) (g := fun w : ℂ => w - 1) s hs0 hs1
      differentiableAt_id hsub]
    congr 1
    · rw [logDeriv_apply, deriv_id'', one_div]
    · rw [logDeriv_apply, deriv_sub_const, deriv_id'', one_div]
  rw [hq_ld]
  ring

end CompletedPositiveSystem

/-! ### 2. Dihedral orbit multiplicity extraction and coupled strip forcing -/

private theorem re_one_div_nonneg_of_re_le {s z : ℂ} (hz : z.re ≤ s.re) :
    0 ≤ (1 / (s - z)).re := by
  rw [one_div, Complex.inv_re, Complex.sub_re]
  exact div_nonneg (sub_nonneg.mpr hz) (Complex.normSq_nonneg _)

/-- **Orbit multiplicity extraction.** For any `r` upper-half-plane points `ρ₁, …, ρ_r` with
pairwise distinct positive ordinates `Im ρ_ℓ > 0` and integer multiplicities
`m_ℓ ≤ (analyticOrderAt Λ ρ_ℓ).toNat`, extracting the disjoint `{ρ_ℓ, ρ̄_ℓ, 1 − ρ_ℓ, 1 − ρ̄_ℓ}`
multiplicity copies from Hadamard's zero-pair expansion yields on `Re s > 1`:
`∑_ℓ m_ℓ (Re 1/(s − ρ_ℓ) + Re 1/(s − ρ̄_ℓ)) ≤ Re(Λ'/Λ)(s)`. -/
theorem sum_orbit_resolvent_le_re_logDeriv {κ d : ℕ} {F Λ : ℂ → ℂ}
    (hS : CompletedPositiveSystem κ d F Λ) {r : ℕ} (ρ : Fin r → ℂ) (m : Fin r → ℕ)
    (him : ∀ ℓ, 0 < (ρ ℓ).im)
    (hdist : ∀ ℓ ℓ', ℓ ≠ ℓ' → (ρ ℓ).im ≠ (ρ ℓ').im)
    (hm : ∀ ℓ, m ℓ ≤ (analyticOrderAt Λ (ρ ℓ)).toNat)
    {s : ℂ} (hs : 1 < s.re) :
    ∑ ℓ, (m ℓ : ℝ) * ((1 / (s - ρ ℓ)).re + (1 / (s - starRingEnd ℂ (ρ ℓ))).re) ≤
      (logDeriv Λ s).re := by
  classical
  set f : ℂ → ℂ := fun z => Λ (z + 2) with hfdef
  have hfd : Differentiable ℂ f := hS.entire_Λ.comp (differentiable_id.add_const 2)
  have hf : AnalyticOnNhd ℂ f univ := hfd.differentiableOn.analyticOnNhd isOpen_univ
  obtain ⟨C, hC, hgrow⟩ := hS.orderOne_Λ
  have hsum_c : HasSum (fun q : ZeroCopy f =>
      (1 / 2 : ℂ) * gPair (zeroCopyPoint f q + 2) s) (logDeriv Λ s) :=
    hasSum_logDeriv_zeroPairs hS.entire_Λ one_ne_zero
      (fun w => by rw [hS.sym_Λ w, one_mul]) hC.le
      (fun w => by simpa only [orderOneWeight] using hgrow w)
      hS.two_ne_zero (hS.ne_zero_of_one_lt_re hs)
  set term : ZeroCopy f → ℝ := fun q => ((1 / 2 : ℂ) * gPair (zeroCopyPoint f q + 2) s).re
  have hsum_re : HasSum term (logDeriv Λ s).re := hsum_c.mapL Complex.reCLM
  have hterm_nonneg : ∀ q : ZeroCopy f, 0 ≤ term q := by
    intro q
    have hzq0 : Λ (zeroCopyPoint f q + 2) = 0 := by simpa [hfdef] using apply_zeroCopyPoint hf q
    obtain ⟨h0, h1⟩ := hS.zero_re_mem_Icc hzq0
    simp only [term, gPair]
    have ha : 0 ≤ (1 / (s - (zeroCopyPoint f q + 2))).re :=
      re_one_div_nonneg_of_re_le (h1.trans hs.le)
    have hb : 0 ≤ (1 / (s - (1 - (zeroCopyPoint f q + 2)))).re :=
      re_one_div_nonneg_of_re_le (by simp; linarith)
    have hre : ((1 / 2 : ℂ) * (1 / (s - (zeroCopyPoint f q + 2)) +
        1 / (s - (1 - (zeroCopyPoint f q + 2))))).re =
        ((1 / (s - (zeroCopyPoint f q + 2))).re +
          (1 / (s - (1 - (zeroCopyPoint f q + 2)))).re) / 2 := by
      have : (1 / 2 : ℂ) * (1 / (s - (zeroCopyPoint f q + 2)) +
          1 / (s - (1 - (zeroCopyPoint f q + 2)))) =
          (1 / (s - (zeroCopyPoint f q + 2)) +
            1 / (s - (1 - (zeroCopyPoint f q + 2)))) / 2 := by ring
      rw [this, Complex.div_ofNat_re, Complex.add_re]
    rw [hre]
    linarith
  -- Analytic order of `f` at `w - 2` matches analytic order of `Λ` at `w`.
  have hdiv_toNat : ∀ w : ℂ,
      ((MeromorphicOn.divisor f univ) (w - 2)).toNat = (analyticOrderAt Λ w).toNat := by
    intro w
    have hg_an : AnalyticAt ℂ (fun z : ℂ => z + 2) (w - 2) := by fun_prop
    have hg_d : deriv (fun z : ℂ => z + 2) (w - 2) ≠ 0 := by
      have hd : HasDerivAt (fun z : ℂ => z + 2) 1 (w - 2) := (hasDerivAt_id' (w - 2)).add_const 2
      rw [hd.deriv]; exact one_ne_zero
    have hcomp := analyticOrderAt_comp_of_deriv_ne_zero (f := Λ) hg_an hg_d
    have hfeq : Λ ∘ (fun z : ℂ => z + 2) = f := rfl
    rw [hfeq, sub_add_cancel] at hcomp
    rw [divisor_univ_eq_analyticOrder hf, hcomp]
    obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp (hS.orderAt_ne_top w)
    rw [← hn]; simp
  -- Explicit Finset of `k` copies in `ZeroCopy f` over `w - 2`.
  let copiesAt : ℂ → ℕ → Finset (ZeroCopy f) := fun w k =>
    if hk : 1 ≤ k ∧ k ≤ ((MeromorphicOn.divisor f univ) (w - 2)).toNat then
      have hsupp : w - 2 ∈ (MeromorphicOn.divisor f univ).support := by
        intro h0; rw [h0] at hk; simp at hk; omega
      Finset.univ.map ⟨fun j : Fin k => ⟨⟨w - 2, hsupp⟩, ⟨j.1, j.2.trans_le hk.2⟩⟩,
        fun j₁ j₂ heq => by
          simp only [Sigma.mk.injEq, heq_eq_eq, Fin.mk.injEq] at heq
          exact Fin.ext heq.2⟩
    else ∅
  have hcopies_pt : ∀ w k q, q ∈ copiesAt w k → zeroCopyPoint f q + 2 = w := by
    intro w k q hq
    dsimp only [copiesAt] at hq
    split_ifs at hq with hk
    · obtain ⟨j, _, rfl⟩ := Finset.mem_map.mp hq
      change (w - 2) + 2 = w
      ring
    · simp at hq
  have hcopies_disj : ∀ w₁ w₂ k₁ k₂, w₁ ≠ w₂ → Disjoint (copiesAt w₁ k₁) (copiesAt w₂ k₂) := by
    intro w₁ w₂ k₁ k₂ hne
    rw [Finset.disjoint_left]
    intro q h1 h2
    exact hne ((hcopies_pt w₁ k₁ q h1).symm.trans (hcopies_pt w₂ k₂ q h2))
  have hcopies_sum : ∀ w k, 1 ≤ k → k ≤ (analyticOrderAt Λ w).toNat →
      ∑ q ∈ copiesAt w k, term q = (k : ℝ) * ((1 / 2 : ℂ) * gPair w s).re := by
    intro w k hk1 hkle
    have hk : 1 ≤ k ∧ k ≤ ((MeromorphicOn.divisor f univ) (w - 2)).toNat :=
      ⟨hk1, by rwa [hdiv_toNat]⟩
    have hmem_iff : ∀ q ∈ copiesAt w k, term q = ((1 / 2 : ℂ) * gPair w s).re := by
      intro q hq
      simp only [term, hcopies_pt w k q hq]
    have hcard : (copiesAt w k).card = k := by
      simp only [copiesAt, dif_pos hk, Finset.card_map, Finset.card_univ, Fintype.card_fin]
    rw [Finset.sum_congr rfl hmem_iff, Finset.sum_const, hcard, nsmul_eq_mul]
  -- Dihedral orbit points for each `ℓ`.
  let orbPts : Fin r → Finset ℂ := fun ℓ =>
    {ρ ℓ, starRingEnd ℂ (ρ ℓ), 1 - ρ ℓ, 1 - starRingEnd ℂ (ρ ℓ)}
  let orbCopies : Fin r → Finset (ZeroCopy f) := fun ℓ =>
    if m ℓ = 0 then ∅ else (orbPts ℓ).biUnion (fun w => copiesAt w (m ℓ))
  have horbPts_im : ∀ ℓ w, w ∈ orbPts ℓ → |w.im| = (ρ ℓ).im := by
    intro ℓ w hw
    have h0 := him ℓ
    simp only [orbPts, Finset.mem_insert, Finset.mem_singleton] at hw
    rcases hw with rfl | rfl | rfl | rfl <;> simp [abs_of_pos h0]
  have horbPts_ord : ∀ ℓ w, w ∈ orbPts ℓ →
      (analyticOrderAt Λ w).toNat = (analyticOrderAt Λ (ρ ℓ)).toNat := by
    intro ℓ w hw
    simp only [orbPts, Finset.mem_insert, Finset.mem_singleton] at hw
    rcases hw with rfl | rfl | rfl | rfl
    · rfl
    · rw [hS.orderAt_conj]
    · rw [hS.orderAt_one_sub]
    · rw [hS.orderAt_one_sub, hS.orderAt_conj]
  have horb_disj : Pairwise (fun ℓ ℓ' => Disjoint (orbCopies ℓ) (orbCopies ℓ')) := by
    intro ℓ ℓ' hne
    rw [Finset.disjoint_left]
    intro q h1 h2
    dsimp only [orbCopies] at h1 h2
    split_ifs at h1 with hm1
    · simp at h1
    split_ifs at h2 with hm2
    · simp at h2
    obtain ⟨w₁, hw₁, hq₁⟩ := Finset.mem_biUnion.mp h1
    obtain ⟨w₂, hw₂, hq₂⟩ := Finset.mem_biUnion.mp h2
    have hp := (hcopies_pt w₁ (m ℓ) q hq₁).symm.trans (hcopies_pt w₂ (m ℓ') q hq₂)
    exact hdist ℓ ℓ' hne ((horbPts_im ℓ w₁ hw₁).symm.trans (hp ▸ horbPts_im ℓ' w₂ hw₂))
  -- Lower bound on each orbit's contribution.
  have horb_le : ∀ ℓ,
      (m ℓ : ℝ) * ((1 / (s - ρ ℓ)).re + (1 / (s - starRingEnd ℂ (ρ ℓ))).re) ≤
        ∑ q ∈ orbCopies ℓ, term q := by
    intro ℓ
    rcases eq_or_ne (m ℓ) 0 with hm0 | hm0
    · simp [orbCopies, hm0]
    have hm1 : 1 ≤ m ℓ := Nat.pos_of_ne_zero hm0
    have hbi : ∑ q ∈ orbCopies ℓ, term q =
        ∑ w ∈ orbPts ℓ, ∑ q ∈ copiesAt w (m ℓ), term q := by
      simp only [orbCopies, if_neg hm0]
      exact Finset.sum_biUnion fun w₁ _ w₂ _ hne => hcopies_disj w₁ w₂ (m ℓ) (m ℓ) hne
    rw [hbi]
    have hinner : ∑ w ∈ orbPts ℓ, ∑ q ∈ copiesAt w (m ℓ), term q =
        ∑ w ∈ orbPts ℓ, (m ℓ : ℝ) * ((1 / 2 : ℂ) * gPair w s).re := by
      refine Finset.sum_congr rfl fun w hw => hcopies_sum w (m ℓ) hm1 ?_
      rw [horbPts_ord ℓ w hw]
      exact hm ℓ
    rw [hinner, ← Finset.mul_sum]
    refine mul_le_mul_of_nonneg_left ?_ (Nat.cast_nonneg _)
    have h0 := him ℓ
    have hne_conj : ρ ℓ ≠ starRingEnd ℂ (ρ ℓ) := fun h => by
      have := congrArg Complex.im h; simp at this; linarith
    by_cases hcrit : (ρ ℓ).re = 1 / 2
    · -- Critical zero: `1 - ρ_ℓ = conj ρ_ℓ`, so `orbPts ℓ = {ρ_ℓ, conj ρ_ℓ}`.
      have hc1 : 1 - ρ ℓ = starRingEnd ℂ (ρ ℓ) := by
        apply Complex.ext <;> simp <;> linarith
      have hc2 : 1 - starRingEnd ℂ (ρ ℓ) = ρ ℓ := by
        apply Complex.ext <;> simp <;> linarith
      have hset : orbPts ℓ = {ρ ℓ, starRingEnd ℂ (ρ ℓ)} := by
        ext z
        simp only [orbPts, hc1, hc2, Finset.mem_insert, Finset.mem_singleton]
        tauto
      rw [hset, Finset.sum_pair hne_conj]
      have hg1 : gPair (ρ ℓ) s = 1 / (s - ρ ℓ) + 1 / (s - starRingEnd ℂ (ρ ℓ)) := by
        simp only [gPair, hc1]
      have hg2 : gPair (starRingEnd ℂ (ρ ℓ)) s =
          1 / (s - starRingEnd ℂ (ρ ℓ)) + 1 / (s - ρ ℓ) := by
        simp only [gPair, hc2]
      rw [hg1, hg2]
      have hre_calc : ((1 / 2 : ℂ) * (1 / (s - ρ ℓ) + 1 / (s - starRingEnd ℂ (ρ ℓ)))).re +
          ((1 / 2 : ℂ) * (1 / (s - starRingEnd ℂ (ρ ℓ)) + 1 / (s - ρ ℓ))).re =
          (1 / (s - ρ ℓ)).re + (1 / (s - starRingEnd ℂ (ρ ℓ))).re := by
        have e : (1 / 2 : ℂ) * (1 / (s - ρ ℓ) + 1 / (s - starRingEnd ℂ (ρ ℓ))) +
            (1 / 2 : ℂ) * (1 / (s - starRingEnd ℂ (ρ ℓ)) + 1 / (s - ρ ℓ)) =
            1 / (s - ρ ℓ) + 1 / (s - starRingEnd ℂ (ρ ℓ)) := by ring
        have := congrArg Complex.re e
        simpa only [Complex.add_re] using this
      linarith
    · -- Off-critical zero: `orbPts ℓ` has 4 distinct elements.
      have hne13 : ρ ℓ ≠ 1 - ρ ℓ := fun h => by
        have := congrArg Complex.im h; simp at this; linarith
      have hne14 : ρ ℓ ≠ 1 - starRingEnd ℂ (ρ ℓ) := fun h => by
        have := congrArg Complex.re h; simp at this; apply hcrit; linarith
      have hne23 : starRingEnd ℂ (ρ ℓ) ≠ 1 - ρ ℓ := fun h => by
        have := congrArg Complex.re h; simp at this; apply hcrit; linarith
      have hne24 : starRingEnd ℂ (ρ ℓ) ≠ 1 - starRingEnd ℂ (ρ ℓ) := fun h => by
        have := congrArg Complex.im h; simp at this; linarith
      have hne34 : 1 - ρ ℓ ≠ 1 - starRingEnd ℂ (ρ ℓ) := fun h =>
        hne_conj (by linear_combination -h)
      have hm1' : ρ ℓ ∉ ({starRingEnd ℂ (ρ ℓ), 1 - ρ ℓ, 1 - starRingEnd ℂ (ρ ℓ)} : Finset ℂ) := by
        simp [hne_conj, hne13, hne14]
      have hm2' : starRingEnd ℂ (ρ ℓ) ∉ ({1 - ρ ℓ, 1 - starRingEnd ℂ (ρ ℓ)} : Finset ℂ) := by
        simp [hne23, hne24]
      have hm3' : 1 - ρ ℓ ∉ ({1 - starRingEnd ℂ (ρ ℓ)} : Finset ℂ) := by simp [hne34]
      simp only [orbPts]
      rw [Finset.sum_insert hm1', Finset.sum_insert hm2', Finset.sum_insert hm3',
        Finset.sum_singleton]
      have hρ_zero : Λ (ρ ℓ) = 0 :=
        hS.eq_zero_of_one_le_order_toNat (hm1.trans (hm ℓ))
      obtain ⟨hre0, _⟩ := hS.zero_re_mem_Icc hρ_zero
      have hnn1 : 0 ≤ (1 / (s - (1 - ρ ℓ))).re :=
        re_one_div_nonneg_of_re_le (by simp; linarith)
      have hnn2 : 0 ≤ (1 / (s - (1 - starRingEnd ℂ (ρ ℓ)))).re :=
        re_one_div_nonneg_of_re_le (by simp; linarith)
      have hsum4 : ((1 / 2 : ℂ) * gPair (ρ ℓ) s).re +
          (((1 / 2 : ℂ) * gPair (starRingEnd ℂ (ρ ℓ)) s).re +
            (((1 / 2 : ℂ) * gPair (1 - ρ ℓ) s).re +
              ((1 / 2 : ℂ) * gPair (1 - starRingEnd ℂ (ρ ℓ)) s).re)) =
          (1 / (s - ρ ℓ)).re + (1 / (s - starRingEnd ℂ (ρ ℓ))).re +
            (1 / (s - (1 - ρ ℓ))).re + (1 / (s - (1 - starRingEnd ℂ (ρ ℓ)))).re := by
        have e : (1 / 2 : ℂ) * gPair (ρ ℓ) s +
            ((1 / 2 : ℂ) * gPair (starRingEnd ℂ (ρ ℓ)) s +
              ((1 / 2 : ℂ) * gPair (1 - ρ ℓ) s +
                (1 / 2 : ℂ) * gPair (1 - starRingEnd ℂ (ρ ℓ)) s)) =
            1 / (s - ρ ℓ) + 1 / (s - starRingEnd ℂ (ρ ℓ)) +
              1 / (s - (1 - ρ ℓ)) + 1 / (s - (1 - starRingEnd ℂ (ρ ℓ))) := by
          simp only [gPair, sub_sub_cancel]; ring
        have := congrArg Complex.re e
        simpa only [Complex.add_re] using this
      linarith
  have htotal : ∑ ℓ, ∑ q ∈ orbCopies ℓ, term q =
      ∑ q ∈ Finset.univ.biUnion orbCopies, term q :=
    (Finset.sum_biUnion fun ℓ _ ℓ' _ hne => horb_disj hne).symm
  calc ∑ ℓ, (m ℓ : ℝ) * ((1 / (s - ρ ℓ)).re + (1 / (s - starRingEnd ℂ (ρ ℓ))).re)
      ≤ ∑ ℓ, ∑ q ∈ orbCopies ℓ, term q := Finset.sum_le_sum fun ℓ _ => horb_le ℓ
    _ = ∑ q ∈ Finset.univ.biUnion orbCopies, term q := htotal
    _ ≤ (logDeriv Λ s).re := hsum_re.sum_le fun q _ => hterm_nonneg q

/-- **Master coupled strip pole–zero forcing law.** Evaluating multiplicative Gram positivity on
any finite height configuration `x : Fin n → ℝ` with nonnegative channel amplitudes
`c : Fin n → ℝ` (`c_j ≥ 0`) at `s_{j,k} = (1 + δ) + i(x_j − x_k)` (`δ > 0`) bounds the collective
zero-resolvent Gram form by the `κ`-pole and `d`-archimedean Gram forms. -/
theorem coupled_strip_pole_zero_forcing {κ d : ℕ} {F Λ : ℂ → ℂ}
    (hS : CompletedPositiveSystem κ d F Λ) {r : ℕ} (ρ : Fin r → ℂ) (m : Fin r → ℕ)
    (him : ∀ ℓ, 0 < (ρ ℓ).im)
    (hdist : ∀ ℓ ℓ', ℓ ≠ ℓ' → (ρ ℓ).im ≠ (ρ ℓ').im)
    (hm : ∀ ℓ, m ℓ ≤ (analyticOrderAt Λ (ρ ℓ)).toNat)
    {n : ℕ} (x c : Fin n → ℝ) (hc : ∀ j, 0 ≤ c j) {δ : ℝ} (hδ : 0 < δ) :
    ∑ ℓ, (m ℓ : ℝ) * ∑ j, ∑ k, c j * c k *
        ((1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - ρ ℓ)).re +
          (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - starRingEnd ℂ (ρ ℓ))).re) ≤
      (κ : ℝ) * ∑ j, ∑ k, c j * c k *
          (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I) +
            1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - 1)).re +
        (d : ℝ) * ∑ j, ∑ k, c j * c k *
          (logDeriv Complex.Gammaℝ (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re := by
  have hσ : 1 < 1 + δ := by linarith
  have hgram : 0 ≤ ∑ j, ∑ k, c j * c k *
      (-logDeriv F (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re :=
    (hS.posDef_neg_logDeriv hσ).posDef n x c
  -- Pointwise bound at each channel pair `(j, k)`.
  have hpt : ∀ j k : Fin n,
      c j * c k *
        (∑ ℓ, (m ℓ : ℝ) *
          ((1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - ρ ℓ)).re +
            (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - starRingEnd ℂ (ρ ℓ))).re)) ≤
      c j * c k *
        ((κ : ℝ) * (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I) +
            1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - 1)).re +
          (d : ℝ) * (logDeriv Complex.Gammaℝ
            (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re -
          (-logDeriv F (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re) := by
    intro j k
    refine mul_le_mul_of_nonneg_left ?_ (mul_nonneg (hc j) (hc k))
    set s : ℂ := ((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I
    have hs : 1 < s.re := by simp [s]; linarith
    have horb := sum_orbit_resolvent_le_re_logDeriv hS ρ m him hdist hm hs
    have hdecomp := congrArg Complex.re (hS.neg_logDeriv_F_eq hs)
    have hre_eq : ((κ : ℂ) * (1 / s + 1 / (s - 1)) +
        (d : ℂ) * logDeriv Complex.Gammaℝ s - logDeriv Λ s).re =
        (κ : ℝ) * (1 / s + 1 / (s - 1)).re +
          (d : ℝ) * (logDeriv Complex.Gammaℝ s).re - (logDeriv Λ s).re := by
      rw [Complex.sub_re, Complex.add_re]
      have h1 : ((κ : ℂ) * (1 / s + 1 / (s - 1))).re = (κ : ℝ) * (1 / s + 1 / (s - 1)).re := by
        rw [← Complex.ofReal_natCast, Complex.re_ofReal_mul]
      have h2 : ((d : ℂ) * logDeriv Complex.Gammaℝ s).re =
          (d : ℝ) * (logDeriv Complex.Gammaℝ s).re := by
        rw [← Complex.ofReal_natCast, Complex.re_ofReal_mul]
      rw [h1, h2]
    rw [hre_eq] at hdecomp
    linarith
  -- Sum over `(j, k)` and rearrange finite sums.
  have hsum := Finset.sum_le_sum fun j _ => Finset.sum_le_sum fun k _ => hpt j k
  have hlhs : (∑ ℓ, (m ℓ : ℝ) * ∑ j, ∑ k, c j * c k *
        ((1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - ρ ℓ)).re +
          (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - starRingEnd ℂ (ρ ℓ))).re)) =
      ∑ j, ∑ k, c j * c k * ∑ ℓ, (m ℓ : ℝ) *
        ((1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - ρ ℓ)).re +
          (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - starRingEnd ℂ (ρ ℓ))).re) := by
    simp_rw [Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun ℓ _ => ?_
    ring
  have hrhs : (∑ j, ∑ k, c j * c k *
        ((κ : ℝ) * (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I) +
            1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - 1)).re +
          (d : ℝ) * (logDeriv Complex.Gammaℝ
            (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re -
          (-logDeriv F (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re)) =
      (κ : ℝ) * (∑ j, ∑ k, c j * c k *
          (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I) +
            1 / (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I - 1)).re) +
        (d : ℝ) * (∑ j, ∑ k, c j * c k *
          (logDeriv Complex.Gammaℝ (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re) -
        ∑ j, ∑ k, c j * c k *
          (-logDeriv F (((1 + δ : ℝ) : ℂ) + ((x j - x k : ℝ) : ℂ) * I)).re := by
    simp_rw [Finset.mul_sum, ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun k _ => ?_
    ring
  rw [hlhs]
  linarith [hsum, hrhs, hgram]

/-! ### 3. Uniform archimedean bound and restricted width extraction -/

/-- **All-height archimedean real-part bound.** For every `σ ∈ [1, 2]` and EVERY height `t ∈ ℝ`
(including `|t| < 4`), shifting `ψ(s/2)` twice via `ψ(z + 1) = ψ(z) + 1/z` into `Re ≥ 5/2` and
applying the first-order digamma asymptotic yields
`Re(Γ_ℝ'/Γ_ℝ)(σ + it) ≤ log(3 + |t|) / 2 + 1 / 4`. -/
theorem re_logDeriv_Gammaℝ_le_all_heights {σ t : ℝ} (hσ1 : 1 ≤ σ) (hσ2 : σ ≤ 2) :
    (logDeriv Complex.Gammaℝ ((σ : ℂ) + (t : ℂ) * I)).re ≤ Real.log (3 + |t|) / 2 + 1 / 4 := by
  set s : ℂ := (σ : ℂ) + (t : ℂ) * I with hsdef
  set z : ℂ := s / 2 with hzdef
  have hsre : s.re = σ := by simp [hsdef]
  have hsim : s.im = t := by simp [hsdef]
  have hzre : z.re = σ / 2 := by rw [hzdef, Complex.div_ofNat_re, hsre]
  have hzim : z.im = t / 2 := by rw [hzdef, Complex.div_ofNat_im, hsim]
  have hne0 : ∀ m : ℕ, z ≠ -(m : ℂ) := by
    intro m hm
    have hc := congrArg Complex.re hm
    simp only [hzre, Complex.neg_re, Complex.natCast_re] at hc
    have : (0 : ℝ) ≤ m := Nat.cast_nonneg m
    linarith
  have hne1 : ∀ m : ℕ, z + 1 ≠ -(m : ℂ) := by
    intro m hm
    have hc := congrArg Complex.re hm
    simp only [Complex.add_re, hzre, Complex.one_re, Complex.neg_re, Complex.natCast_re] at hc
    have : (0 : ℝ) ≤ m := Nat.cast_nonneg m
    linarith
  have hd1 := congrArg Complex.re (Complex.digamma_apply_add_one z hne0)
  have hd2 := congrArg Complex.re (Complex.digamma_apply_add_one (z + 1) hne1)
  rw [Complex.add_re] at hd1 hd2
  have hinv0 : 0 ≤ (z⁻¹).re := by
    rw [Complex.inv_re]; exact div_nonneg (by linarith) (Complex.normSq_nonneg _)
  have hinv1 : 0 ≤ ((z + 1)⁻¹).re := by
    rw [Complex.inv_re, Complex.add_re, Complex.one_re]
    exact div_nonneg (by linarith) (Complex.normSq_nonneg _)
  set w : ℂ := z + 1 + 1
  have hwre : w.re = σ / 2 + 2 := by simp [w, hzre]; ring
  have hwim : w.im = t / 2 := by simp [w, hzim]
  have hwnorm_lo : (5 / 2 : ℝ) ≤ ‖w‖ := by
    calc (5 / 2 : ℝ) ≤ σ / 2 + 2 := by linarith
      _ = w.re := hwre.symm
      _ ≤ ‖w‖ := Complex.re_le_norm w
  have hwnorm_hi : ‖w‖ ≤ 3 + |t| := by
    calc ‖w‖ ≤ |w.re| + |w.im| := Complex.norm_le_abs_re_add_abs_im w
      _ = (σ / 2 + 2) + |t| / 2 := by
          rw [hwre, abs_of_pos (by linarith), hwim, abs_div, abs_two]
      _ ≤ 3 + |t| := by linarith [abs_nonneg t]
  have hstir := norm_digamma_sub_log_le_of_re_pos (z := w) (by rw [hwre]; linarith)
    (by linarith)
  have hwpos : 0 < ‖w‖ := by linarith
  have hpsi_w : (Complex.digamma w).re ≤ Real.log (3 + |t|) + 6 / 5 := by
    have hle : (Complex.digamma w - Complex.log w).re ≤ 3 / ‖w‖ :=
      (Complex.re_le_norm _).trans hstir
    rw [Complex.sub_re, Complex.log_re] at hle
    have hlog_le : Real.log ‖w‖ ≤ Real.log (3 + |t|) := Real.log_le_log hwpos hwnorm_hi
    have hdiv_le : 3 / ‖w‖ ≤ 6 / 5 := by
      rw [div_le_div_iff₀ hwpos (by norm_num)]
      linarith
    linarith
  have hpi : (1 : ℝ) ≤ Real.log Real.pi := by
    have h3 : Real.exp 1 < Real.pi := lt_trans (by linarith [Real.exp_one_lt_d9]) Real.pi_gt_three
    have h := Real.log_lt_log (Real.exp_pos 1) h3
    rwa [Real.log_exp] at h ⊢; exact h.le
  -- Re-check `hpi` cleanly:
  have hG : logDeriv Complex.Gammaℝ s =
      Complex.digamma z / 2 - ((Real.log Real.pi : ℝ) : ℂ) / 2 :=
    GaloisForLFunctions.logDeriv_Gammaℝ_digamma (by rw [hsre]; linarith)
  rw [hG]
  simp only [Complex.sub_re, Complex.div_ofNat_re, Complex.ofReal_re]
  linarith [hd1, hd2, hinv0, hinv1, hpsi_w, hpi]

/-- **Restricted pole–growth width extraction.** Whenever `0 ≤ A < B`, `0 < G`, `A ≤ G`, `0 ≤ η`,
and `B / (δ + η) ≤ A / δ + G` holds for every `δ ∈ (0, 1]`, the zero depth satisfies
`min 1 ((√B − √A)² / G) ≤ η`. Works uniformly for both `A = 0` (`κ = 0`) and `A > 0` (`κ ≥ 1`). -/
theorem width_ge_of_pole_growth_bound {A B G η : ℝ} (hA : 0 ≤ A) (hAB : A < B) (hG : 0 < G)
    (hAG : A ≤ G) (hη : 0 ≤ η)
    (hbound : ∀ δ : ℝ, 0 < δ → δ ≤ 1 → B / (δ + η) ≤ A / δ + G) :
    min 1 ((Real.sqrt B - Real.sqrt A) ^ 2 / G) ≤ η := by
  by_contra hlt
  rw [not_le] at hlt
  have hη1 : η < 1 := lt_of_lt_of_le hlt (min_le_left _ _)
  have hηw : η < (Real.sqrt B - Real.sqrt A) ^ 2 / G := lt_of_lt_of_le hlt (min_le_right _ _)
  have hB0 : 0 < B := lt_of_le_of_lt hA hAB
  rcases eq_or_lt_of_le hA with rfl | hA_pos
  · -- Case `A = 0`: `B / (δ + η) ≤ G` fails as `δ ↓ 0` since `G η < B`.
    rw [Real.sqrt_zero, sub_zero, Real.sq_sqrt hB0.le] at hηw
    have hGη : G * η < B := (lt_div_iff₀ hG).mp hηw
    set δ := min 1 ((B - G * η) / (2 * G))
    have hδ0 : 0 < δ := lt_min zero_lt_one (div_pos (by linarith) (by positivity))
    have hδ1 : δ ≤ 1 := min_le_left _ _
    have hδ2 : δ ≤ (B - G * η) / (2 * G) := min_le_right _ _
    have hb := hbound δ hδ0 hδ1
    rw [zero_div, zero_add] at hb
    have hmul : B ≤ G * (δ + η) := (div_le_iff₀ (by linarith)).mp hb
    have hGδ : G * δ ≤ (B - G * η) / 2 := by
      have := mul_le_mul_of_nonneg_left hδ2 hG.le
      have he : G * ((B - G * η) / (2 * G)) = (B - G * η) / 2 := by field_simp
      linarith
    linarith
  · -- Case `A > 0`: first rule out `η = 0`, then apply `exclusion_at_geometric_mean`.
    rcases eq_or_lt_of_le hη with rfl | hη_pos
    · set δ := min 1 ((B - A) / (2 * G))
      have hδ0 : 0 < δ := lt_min zero_lt_one (div_pos (by linarith) (by positivity))
      have hδ1 : δ ≤ 1 := min_le_left _ _
      have hδ2 : δ ≤ (B - A) / (2 * G) := min_le_right _ _
      have hb := hbound δ hδ0 hδ1
      rw [add_zero] at hb
      have hmul : B ≤ A + G * δ := by
        have := mul_le_mul_of_nonneg_right hb hδ0.le
        rwa [div_mul_cancel₀ _ hδ0.ne', add_mul, div_mul_cancel₀ _ hδ0.ne', mul_comm δ G] at this
      have hGδ : G * δ ≤ (B - A) / 2 := by
        have := mul_le_mul_of_nonneg_left hδ2 hG.le
        have he : G * ((B - A) / (2 * G)) = (B - A) / 2 := by field_simp
        linarith
      linarith
    · have hsAB : Real.sqrt A < Real.sqrt B := Real.sqrt_lt_sqrt hA_pos.le hAB
      have hGη : G * η < (Real.sqrt B - Real.sqrt A) ^ 2 := by
        have := (lt_div_iff₀ hG).mp hηw; linarith
      have hsqrt_lt : Real.sqrt (G * η) < Real.sqrt B - Real.sqrt A := by
        rw [← Real.sqrt_sq (sub_nonneg.mpr hsAB.le)]
        exact Real.sqrt_lt_sqrt (by positivity) hGη
      have hcond : Real.sqrt A + Real.sqrt (G * η) < Real.sqrt B := by linarith
      set δ := Real.sqrt A * Real.sqrt (G * η) / G
      have hδ0 : 0 < δ := by positivity
      have hδ1 : δ ≤ 1 := by
        have hsq : (Real.sqrt A * Real.sqrt (G * η)) ^ 2 ≤ G ^ 2 := by
          rw [mul_pow, Real.sq_sqrt hA_pos.le, Real.sq_sqrt (by positivity)]
          nlinarith [hAG, hη1]
        have hle : Real.sqrt A * Real.sqrt (G * η) ≤ G := by
          nlinarith [sq_nonneg (Real.sqrt A * Real.sqrt (G * η) - G),
            mul_pos (Real.sqrt_pos.mpr hA_pos) (Real.sqrt_pos.mpr (mul_pos hG hη_pos)), hG]
        exact (div_le_one hG).mpr hle
      have hexcl := exclusion_at_geometric_mean hA_pos hB0.le hG hη_pos hcond
      linarith [hbound δ hδ0 hδ1, hexcl]

/-! ### 4. Elementary resolvent estimates on `Re s = 1 + δ` -/

private theorem re_one_div_le_one {δ u : ℝ} (hδ : 0 < δ) :
    (1 / (((1 + δ : ℝ) : ℂ) + (u : ℂ) * I)).re ≤ 1 := by
  set s : ℂ := ((1 + δ : ℝ) : ℂ) + (u : ℂ) * I
  have hsre : s.re = 1 + δ := by simp [s]
  have hnsq : (1 + δ) ^ 2 ≤ Complex.normSq s := by
    rw [Complex.normSq_apply]; simp [s]; nlinarith [sq_nonneg u]
  rw [one_div, Complex.inv_re, hsre]
  rw [div_le_one (by nlinarith)]
  nlinarith

private theorem re_pole_one_eq_of_zero {δ : ℝ} (hδ : 0 < δ) :
    (1 / (((1 + δ : ℝ) : ℂ) + ((0 : ℝ) : ℂ) * I - 1)).re = 1 / δ := by
  have he : ((1 + δ : ℝ) : ℂ) + ((0 : ℝ) : ℂ) * I - 1 = (δ : ℂ) := by push_cast; ring
  rw [he, one_div, Complex.inv_re, Complex.ofReal_re, Complex.normSq_ofReal]
  field_simp

private theorem re_pole_one_le_inv_sq {δ u : ℝ} (hδ0 : 0 < δ) (hδ1 : δ ≤ 1) (hu : u ≠ 0) :
    (1 / (((1 + δ : ℝ) : ℂ) + (u : ℂ) * I - 1)).re ≤ 1 / u ^ 2 := by
  have he : ((1 + δ : ℝ) : ℂ) + (u : ℂ) * I - 1 = (δ : ℂ) + (u : ℂ) * I := by push_cast; ring
  have hu2 : 0 < u ^ 2 := sq_pos_of_ne_zero hu
  rw [he, one_div, Complex.inv_re]
  have hre : ((δ : ℂ) + (u : ℂ) * I).re = δ := by simp
  have hnsq : Complex.normSq ((δ : ℂ) + (u : ℂ) * I) = δ ^ 2 + u ^ 2 := by
    rw [Complex.normSq_apply]; simp; ring
  rw [hre, hnsq, div_le_div_iff₀ (by positivity) hu2]
  nlinarith [sq_nonneg δ]

private theorem re_zero_resonant_ge {δ η : ℝ} (hδ : 0 < δ) {ρ : ℂ}
    (hρ1 : ρ.re ≤ 1) (hη : 1 - ρ.re ≤ η) :
    1 / (δ + η) ≤
      (1 / (((1 + δ : ℝ) : ℂ) + ((ρ.im : ℝ) : ℂ) * I - ρ)).re := by
  have he : ((1 + δ : ℝ) : ℂ) + ((ρ.im : ℝ) : ℂ) * I - ρ = ((δ + (1 - ρ.re) : ℝ) : ℂ) := by
    apply Complex.ext <;> simp <;> ring
  have hpos : 0 < δ + (1 - ρ.re) := by linarith
  rw [he, one_div, Complex.inv_re, Complex.ofReal_re, Complex.normSq_ofReal]
  have hd : (δ + (1 - ρ.re)) / ((δ + (1 - ρ.re)) * (δ + (1 - ρ.re))) =
      1 / (δ + (1 - ρ.re)) := by field_simp
  rw [hd]
  exact one_div_le_one_div_of_le hpos (by linarith)

private theorem re_conj_zero_resonant_ge {δ η : ℝ} (hδ : 0 < δ) {ρ : ℂ}
    (hρ1 : ρ.re ≤ 1) (hη : 1 - ρ.re ≤ η) :
    1 / (δ + η) ≤
      (1 / (((1 + δ : ℝ) : ℂ) + ((-(ρ.im) : ℝ) : ℂ) * I - starRingEnd ℂ ρ)).re := by
  have he : ((1 + δ : ℝ) : ℂ) + ((-(ρ.im) : ℝ) : ℂ) * I - starRingEnd ℂ ρ =
      ((δ + (1 - ρ.re) : ℝ) : ℂ) := by
    apply Complex.ext <;> simp <;> ring
  have hpos : 0 < δ + (1 - ρ.re) := by linarith
  rw [he, one_div, Complex.inv_re, Complex.ofReal_re, Complex.normSq_ofReal]
  have hd : (δ + (1 - ρ.re)) / ((δ + (1 - ρ.re)) * (δ + (1 - ρ.re))) =
      1 / (δ + (1 - ρ.re)) := by field_simp
  rw [hd]
  exact one_div_le_one_div_of_le hpos (by linarith)

/-! ### 5. Sharp collective half-pole interior forcing (`κ < 2 * ∑ ℓ, m ℓ`) -/

/-- **Collective half-pole interior forcing law.** Let `(κ, d, F, Λ)` be any completed positive
system and `ρ₁, …, ρ_r` be upper-half-plane zeros of `Λ` with pairwise distinct positive ordinates
and positive integer multiplicities `1 ≤ m_ℓ ≤ ord_{ρ_ℓ}(Λ)`. Whenever the collective multiplicity
beats half the pole order (`κ < 2 * ∑_ℓ m_ℓ`), multi-channel coupling over a slow-doubling Følner
Finset in the height subgroup generated by `(Im ρ_1, …, Im ρ_r)` forces at least one zero strictly
into the interior `Re ρ_ℓ ≤ 1 − w` (`w > 0`), with no linear-independence or separation hypothesis
on the ordinates. -/
theorem collective_half_pole_interior_forcing {κ d : ℕ} {F Λ : ℂ → ℂ}
    (hS : CompletedPositiveSystem κ d F Λ) {r : ℕ} (ρ : Fin r → ℂ) (m : Fin r → ℕ)
    (him : ∀ ℓ, 0 < (ρ ℓ).im)
    (hdist : ∀ ℓ ℓ', ℓ ≠ ℓ' → (ρ ℓ).im ≠ (ρ ℓ').im)
    (hm_pos : ∀ ℓ, 1 ≤ m ℓ)
    (hm : ∀ ℓ, m ℓ ≤ (analyticOrderAt Λ (ρ ℓ)).toNat)
    (hM : κ < 2 * ∑ ℓ, m ℓ) :
    ∃ w : ℝ, 0 < w ∧ ∃ ℓ : Fin r, (ρ ℓ).re ≤ 1 - w := by
  classical
  set M : ℕ := ∑ ℓ, m ℓ with hMdef
  have hM1 : 1 ≤ M := by omega
  have hr_pos : 0 < r := by
    rcases Nat.eq_zero_or_pos r with rfl | hpos
    · simp [M] at hM1
    · exact hpos
  haveI : Nonempty (Fin r) := Fin.pos_iff_nonempty.mp hr_pos
  have hρ_strip : ∀ ℓ, 0 ≤ (ρ ℓ).re ∧ (ρ ℓ).re ≤ 1 := fun ℓ =>
    hS.zero_re_mem_Icc (hS.eq_zero_of_one_le_order_toNat ((hm_pos ℓ).trans (hm ℓ)))
  set η : ℝ := Finset.univ.sup' Finset.univ_nonempty (fun ℓ => 1 - (ρ ℓ).re) with hηdef
  have hη_ge : ∀ ℓ, 1 - (ρ ℓ).re ≤ η := fun ℓ => Finset.le_sup' (fun i => 1 - (ρ i).re) (mem_univ ℓ)
  obtain ⟨ℓ_max, _, hη_eq⟩ := Finset.exists_mem_eq_sup' Finset.univ_nonempty (fun ℓ => 1 - (ρ ℓ).re)
  have hη_nonneg : 0 ≤ η := by linarith [(hρ_strip ℓ_max).2, hη_ge ℓ_max]
  -- Build Følner Finsets `S k ⊂ ℝ` inside the subgroup generated by `γ ℓ = Im (ρ ℓ)`.
  let γ : Fin r → ℝ := fun ℓ => (ρ ℓ).im
  let box : ℕ → Finset (Fin r → ℕ) := fun k => Fintype.piFinset fun _ => Finset.range (k + 1)
  let val : (Fin r → ℕ) → ℝ := fun v => ∑ ℓ, (v ℓ : ℝ) * γ ℓ
  let S : ℕ → Finset ℝ := fun k => (box k).image val
  have h0_mem : ∀ k, (0 : ℝ) ∈ S k := by
    intro k
    refine Finset.mem_image.mpr ⟨fun _ => 0, ?_, by simp [val]⟩
    simp [box, Fintype.mem_piFinset]
  have hS_pos : ∀ k, 1 ≤ (S k).card := fun k => Finset.card_pos.mpr ⟨0, h0_mem k⟩
  have hS_upper : ∀ k, (S k).card ≤ (k + 1) ^ r := by
    intro k
    calc (S k).card ≤ (box k).card := Finset.card_image_le
      _ = (k + 1) ^ r := by simp [box, Fintype.card_piFinset, Finset.card_range]
  have hS_mono : ∀ k, S k ⊆ S (k + 1) := by
    intro k x hx
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hx
    refine Finset.mem_image.mpr ⟨v, ?_, rfl⟩
    rw [Fintype.mem_piFinset] at hv ⊢
    intro ℓ
    exact Finset.mem_range.mpr (lt_trans (Finset.mem_range.mp (hv ℓ)) (Nat.lt_succ_self _))
  have hS_shift : ∀ k ℓ x, x ∈ S k → x + γ ℓ ∈ S (k + 1) := by
    intro k ℓ x hx
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hx
    rw [Fintype.mem_piFinset] at hv
    refine Finset.mem_image.mpr ⟨Function.update v ℓ (v ℓ + 1), ?_, ?_⟩
    · rw [Fintype.mem_piFinset]
      intro i
      rcases eq_or_ne i ℓ with rfl | hne
      · simp only [Function.update_self, Finset.mem_range]
        have := Finset.mem_range.mp (hv i); omega
      · simp only [Function.update_of_ne hne]
        exact Finset.mem_range.mpr (lt_trans (Finset.mem_range.mp (hv i)) (Nat.lt_succ_self _))
    · have hdiff : val (Function.update v ℓ (v ℓ + 1)) - val v = γ ℓ := by
        simp only [val, ← Finset.sum_sub_distrib, ← sub_mul]
        rw [Finset.sum_eq_single ℓ]
        · simp [Function.update_self]; ring
        · intro i _ hne; simp [Function.update_of_ne hne]
        · intro hnot; exact absurd (Finset.mem_univ ℓ) hnot
      linarith
  have hS_bounds : ∀ k x, x ∈ S k → 0 ≤ x ∧ x ≤ (k : ℝ) * ∑ ℓ, γ ℓ := by
    intro k x hx
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hx
    rw [Fintype.mem_piFinset] at hv
    refine ⟨Finset.sum_nonneg fun ℓ _ => mul_nonneg (Nat.cast_nonneg _) (him ℓ).le, ?_⟩
    rw [Finset.mul_sum]
    refine Finset.sum_le_sum fun ℓ _ => mul_le_mul_of_nonneg_right ?_ (him ℓ).le
    have hlt := Finset.mem_range.mp (hv ℓ)
    exact_mod_cast Nat.lt_succ_iff.mp hlt
  -- Find a slow-doubling scale `k` with `|S(k+1)| ≤ (1 + 1/(4M)) |S(k)|`.
  set q : ℝ := 1 + 1 / (4 * (M : ℝ))
  have hM_pos_r : (0 : ℝ) < M := by exact_mod_cast hM1
  have hq1 : 1 < q := by simp only [q]; positivity
  obtain ⟨k, hk_slow⟩ : ∃ k : ℕ, ((S (k + 1)).card : ℝ) ≤ q * ((S k).card : ℝ) := by
    by_contra hall
    push Not at hall
    have hgeom : ∀ n : ℕ, q ^ n ≤ ((S n).card : ℝ) := by
      intro n
      have hg := geom_le (u := fun j => ((S j).card : ℝ)) (zero_le_one.trans hq1.le) n
        (fun j _ => (hall j).le)
      have h0 : (1 : ℝ) ≤ ((S 0).card : ℝ) := by exact_mod_cast hS_pos 0
      nlinarith [pow_nonneg (zero_le_one.trans hq1.le) n]
    have htend := (tendsto_pow_const_div_const_pow_of_one_lt r hq1).eventually
      (gt_mem_nhds (by positivity : (0 : ℝ) < 1 / q))
    obtain ⟨N, hN⟩ := eventually_atTop.mp htend
    have hlt := hN (N + 1) (Nat.le_succ N)
    have hge : 1 / q ≤ (((N + 1 : ℕ) : ℝ) ^ r) / q ^ (N + 1) := by
      have h1 : q ^ N ≤ (((N + 1 : ℕ) : ℝ) ^ r) :=
        (hgeom N).trans (by exact_mod_cast hS_upper N)
      have hqpos : 0 < q ^ (N + 1) := pow_pos (zero_lt_one.trans hq1) _
      rw [div_le_div_iff₀ (zero_lt_one.trans hq1) hqpos]
      calc 1 * q ^ N * q = q * q ^ N := by ring
        _ ≤ q * (((N + 1 : ℕ) : ℝ) ^ r) := mul_le_mul_of_nonneg_left h1 (zero_le_one.trans hq1.le)
    -- Wait: check `div_le_div_iff₀` above (`1 * q ^ (N + 1) ≤ ((N + 1) ^ r) * q`)!
    have hge' : 1 / q ≤ (((N + 1 : ℕ) : ℝ) ^ r) / q ^ (N + 1) := by
      have h1 : q ^ N ≤ (((N + 1 : ℕ) : ℝ) ^ r) :=
        (hgeom N).trans (by exact_mod_cast hS_upper N)
      have hqpos : 0 < q ^ (N + 1) := pow_pos (zero_lt_one.trans hq1) _
      rw [div_le_div_iff₀ (zero_lt_one.trans hq1) hqpos, one_mul, pow_succ]
      exact mul_le_mul_of_nonneg_right h1 (zero_le_one.trans hq1.le)
    linarith [hlt, hge']
  -- Index `S k` by `e : Fin n ≃ S k` with uniform weights `c j = 1 / √n`.
  set n : ℕ := (S k).card
  have hn1 : 1 ≤ n := hS_pos k
  have hn_pos : (0 : ℝ) < n := by exact_mod_cast hn1
  let e : Fin n ≃ S k := (S k).equivFin.symm
  let x : Fin n → ℝ := fun j => (e j : ℝ)
  let c : Fin n → ℝ := fun _ => 1 / Real.sqrt n
  have hc_nn : ∀ j, 0 ≤ c j := fun _ => by positivity
  have hcc : ∀ i j, c i * c j = 1 / (n : ℝ) := fun _ _ => by
    simp only [c, one_div, ← mul_inv, Real.mul_self_sqrt hn_pos.le]
  -- Overlap sets `T ℓ := {y ∈ S k | y + γ ℓ ∈ S k}` have cardinality `≥ (1 - 1/(4M)) n`.
  let T : Fin r → Finset ℝ := fun ℓ => (S k).filter fun y => y + γ ℓ ∈ S k
  have hT_card : ∀ ℓ, (1 - 1 / (4 * (M : ℝ))) * (n : ℝ) ≤ ((T ℓ).card : ℝ) := by
    intro ℓ
    have hsub_compl : ((S k \ T ℓ).image fun y => y + γ ℓ) ⊆ S (k + 1) \ S k := by
      intro z hz
      obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hz
      rw [Finset.mem_sdiff, Finset.mem_filter] at hy
      exact Finset.mem_sdiff.mpr ⟨hS_shift k ℓ y hy.1, fun hmem => hy.2 ⟨hy.1, hmem⟩⟩
    have hinj : Set.InjOn (fun y : ℝ => y + γ ℓ) ↑(S k \ T ℓ) := fun y₁ _ y₂ _ h => by linarith
    have hcard_le : (S k \ T ℓ).card ≤ (S (k + 1) \ S k).card := by
      rw [← Finset.card_image_of_injOn hinj]
      exact Finset.card_le_card hsub_compl
    have hT_sub : T ℓ ⊆ S k := Finset.filter_subset _ _
    have hs1 : (S k \ T ℓ).card = n - (T ℓ).card := Finset.card_sdiff hT_sub
    have hs2 : (S (k + 1) \ S k).card = (S (k + 1)).card - n := Finset.card_sdiff (hS_mono k)
    have hle1 : (T ℓ).card ≤ n := Finset.card_le_card hT_sub
    have hle2 : n ≤ (S (k + 1)).card := Finset.card_le_card (hS_mono k)
    have hnat : n - (T ℓ).card ≤ (S (k + 1)).card - n := by rwa [← hs1, ← hs2]
    have hreal : (n : ℝ) - ((T ℓ).card : ℝ) ≤ ((S (k + 1)).card : ℝ) - (n : ℝ) := by
      have : n + n ≤ (S (k + 1)).card + (T ℓ).card := by omega
      have hr : (n : ℝ) + (n : ℝ) ≤ ((S (k + 1)).card : ℝ) + ((T ℓ).card : ℝ) := by exact_mod_cast this
      linarith
    linarith [hk_slow, hreal]
  -- Define the scale-`k` off-diagonal pole sum and archimedean height cap.
  let offDiag : ℝ := ∑ j : Fin n, ∑ j' ∈ Finset.univ.erase j, 1 / (x j - x j') ^ 2
  have hoff_nn : 0 ≤ offDiag := Finset.sum_nonneg fun j _ =>
    Finset.sum_nonneg fun j' _ => by positivity
  let H_k : ℝ := (k : ℝ) * ∑ ℓ, γ ℓ
  have hHk_nn : 0 ≤ H_k := mul_nonneg (Nat.cast_nonneg k)
    (Finset.sum_nonneg fun ℓ _ => (him ℓ).le)
  let G_k : ℝ := (κ : ℝ) * (1 + offDiag / (n : ℝ)) +
      (n : ℝ) * (d : ℝ) * (Real.log (3 + H_k) / 2 + 1 / 4)
  -- Check positivity and `κ ≤ G_k` for `width_ge_of_pole_growth_bound`.
  have hlog_nn : 0 ≤ Real.log (3 + H_k) := Real.log_nonneg (by linarith)
  have hd_pos_r : (1 : ℝ) ≤ d := by exact_mod_cast hS.degree_pos
  have hGk_pos : 0 < G_k := by
    have h1 : (0 : ℝ) ≤ (κ : ℝ) * (1 + offDiag / (n : ℝ)) := by positivity
    have h2 : (0 : ℝ) < (n : ℝ) * (d : ℝ) * (Real.log (3 + H_k) / 2 + 1 / 4) := by positivity
    simp only [G_k]; linarith
  have hAGk : (κ : ℝ) ≤ G_k := by
    have h1 : (κ : ℝ) ≤ (κ : ℝ) * (1 + offDiag / (n : ℝ)) :=
      le_mul_of_one_le_right (Nat.cast_nonneg κ) (by positivity)
    have h2 : (0 : ℝ) ≤ (n : ℝ) * (d : ℝ) * (Real.log (3 + H_k) / 2 + 1 / 4) := by positivity
    simp only [G_k]; linarith
  -- Apply `coupled_strip_pole_zero_forcing` for every `δ ∈ (0, 1]`.
  have hmain_δ : ∀ δ : ℝ, 0 < δ → δ ≤ 1 →
      (2 * (M : ℝ) - 1 / 2) / (δ + η) ≤ (κ : ℝ) / δ + G_k := by
    intro δ hδ0 hδ1
    have hforce := coupled_strip_pole_zero_forcing hS ρ m him hdist hm x c hc_nn hδ0
    -- Lower bound LHS of `hforce` using `T ℓ` resonant pairs.
    have hlhs_ℓ : ∀ ℓ,
        2 * (1 - 1 / (4 * (M : ℝ))) / (δ + η) ≤
          ∑ j, ∑ j', c j * c j' *
            ((1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I - ρ ℓ)).re +
              (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I - starRingEnd ℂ (ρ ℓ))).re) := by
      intro ℓ
      have hterm_nn : ∀ j j' : Fin n,
          0 ≤ (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I - ρ ℓ)).re ∧
            0 ≤ (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I - starRingEnd ℂ (ρ ℓ))).re := by
        intro j j'
        exact ⟨re_one_div_nonneg_of_re_le (by simp; linarith [(hρ_strip ℓ).2]),
          re_one_div_nonneg_of_re_le (by simp; linarith [(hρ_strip ℓ).2])⟩
      have hsplit : (∑ j, ∑ j', c j * c j' *
            ((1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I - ρ ℓ)).re +
              (1 / (((1 + δ : ℝ) : ℂ) + ((x j - x j' : ℝ) : ℂ) * I - starRingEnd ℂ (ρ ℓ))).re)) =
          (1 / (n : ℝ)) * (∑ p ∈ (Finset.univ ×ˢ Finset.univ : Finset (Fin n × Fin n)),
            (1 / (((1 + δ : ℝ) : ℂ) + ((x p.1 - x p.2 : ℝ) : ℂ) * I - ρ ℓ)).re) +
          (1 / (n : ℝ)) * (∑ p ∈ (Finset.univ ×ˢ Finset.univ : Finset (Fin n × Fin n)),
            (1 / (((1 + δ : ℝ) : ℂ) + ((x p.1 - x p.2 : ℝ) : ℂ) * I - starRingEnd ℂ (ρ ℓ))).re) := by
        simp_rw [hcc, mul_add, Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_product]
      rw [hsplit]
      -- Embed `T ℓ` into `Fin n × Fin n` for `+γ ℓ` and `-γ ℓ`.
      let embPlus : {y : ℝ // y ∈ T ℓ} ↪ Fin n × Fin n :=
        ⟨fun y => (e.symm ⟨y.1 + γ ℓ, (Finset.mem_filter.mp y.2).2⟩,
            e.symm ⟨y.1, (Finset.mem_filter.mp y.2).1⟩),
          fun y₁ y₂ heq => by
            have h2 := congrArg (fun p : Fin n × Fin n => (e p.2 : ℝ)) heq
            simp only [Equiv.apply_symm_apply] at h2
            exact Subtype.ext h2⟩
      let embMinus : {y : ℝ // y ∈ T ℓ} ↪ Fin n × Fin n :=
        ⟨fun y => (e.symm ⟨y.1, (Finset.mem_filter.mp y.2).1⟩,
            e.symm ⟨y.1 + γ ℓ, (Finset.mem_filter.mp y.2).2⟩),
          fun y₁ y₂ heq => by
            have h1 := congrArg (fun p : Fin n × Fin n => (e p.1 : ℝ)) heq
            simp only [Equiv.apply_symm_apply] at h1
            exact Subtype.ext h1⟩
      have hsub1 : (Finset.univ.map embPlus).card / (δ + η) ≤
          ∑ p ∈ (Finset.univ ×ˢ Finset.univ : Finset (Fin n × Fin n)),
            (1 / (((1 + δ : ℝ) : ℂ) + ((x p.1 - x p.2 : ℝ) : ℂ) * I - ρ ℓ)).re := by
        calc ((Finset.univ.map embPlus).card : ℝ) / (δ + η)
            = ∑ _p ∈ Finset.univ.map embPlus, 1 / (δ + η) := by
                rw [Finset.sum_const, nsmul_eq_mul, mul_one_div]
