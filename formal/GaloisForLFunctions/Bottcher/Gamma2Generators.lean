/-
# Generators of the principal congruence subgroup Γ(2)

`Γ(2) = closure {T², R, −I}` where `T² = [[1,2],[0,1]]`, `R = [[1,0],[2,1]]`, `−I`. This is the
group-theoretic input that — via mathlib's `SlashInvariantForm.slash_action_generators` — promotes the
two generator slash-invariances of the quartic defect `F` (`quarticDefect_add_two`,
`quarticDefect_lowerTri`) to `F ∈ SlashInvariantForm Γ(2) 2`, the first step of the `NormTrace`-to-
level-one route to the Jacobi quartic identity.

This file: the generators, their membership in `Γ(2)`, and the easy inclusion `closure ≤ Γ(2)`.
-/
import Mathlib

open Matrix ModularGroup CongruenceSubgroup
open scoped MatrixGroups

namespace Bottcher

/-- The lower-triangular generator `R = [[1,0],[2,1]]` of `Γ(2)`. -/
def Rgen : SL(2, ℤ) := ⟨!![1, 0; 2, 1], by norm_num [Matrix.det_fin_two_of]⟩

@[simp] theorem Rgen_apply : (Rgen : Matrix (Fin 2) (Fin 2) ℤ) = !![1, 0; 2, 1] := rfl

theorem Tsq_coe : ((ModularGroup.T ^ 2 : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) = !![1, 2; 0, 1] := by
  rw [← zpow_natCast, ModularGroup.coe_T_zpow]; norm_num

theorem Tsq_mem_Gamma2 : ModularGroup.T ^ 2 ∈ Gamma 2 := by
  rw [Gamma_mem]; simp only [Tsq_coe]; refine ⟨?_, ?_, ?_, ?_⟩ <;> decide

theorem Rgen_mem_Gamma2 : Rgen ∈ Gamma 2 := by
  rw [Gamma_mem]; refine ⟨?_, ?_, ?_, ?_⟩ <;> · simp only [Rgen]; decide

theorem negOne_mem_Gamma2 : (-1 : SL(2, ℤ)) ∈ Gamma 2 := by
  rw [Gamma_mem]; decide

/-- Easy inclusion: the subgroup generated by `{T², R, −I}` is contained in `Γ(2)`. -/
theorem closure_le_Gamma2 :
    Subgroup.closure ({ModularGroup.T ^ 2, Rgen, -1} : Set SL(2, ℤ)) ≤ Gamma 2 := by
  rw [Subgroup.closure_le]
  intro x hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl | rfl
  · exact Tsq_mem_Gamma2
  · exact Rgen_mem_Gamma2
  · exact negOne_mem_Gamma2


/-- Entry form of the power `Rⁿ = [[1,0],[2n,1]]` (needed for the reduction algorithm). -/
theorem Rgen_pow_val (n : ℕ) : (Rgen ^ n).val = !![1, 0; 2 * (n : ℤ), 1] := by
  induction n with
  | zero => ext i j; fin_cases i <;> fin_cases j <;> simp
  | succ k ih =>
    rw [pow_succ]; show (Rgen ^ k).val * Rgen.val = _
    rw [ih]; show !![1, 0; 2 * (k : ℤ), 1] * !![1, 0; 2, 1] = _
    rw [Matrix.mul_fin_two]; ext i j
    fin_cases i <;> fin_cases j <;> simp <;> push_cast <;> ring

/-- Entry form of the power `(T²)ⁿ = [[1,2n],[0,1]]` (needed for the reduction algorithm). -/
theorem Tsq_pow_val (n : ℕ) : ((ModularGroup.T ^ 2) ^ n).val = !![1, 2 * (n : ℤ); 0, 1] := by
  induction n with
  | zero => ext i j; fin_cases i <;> fin_cases j <;> simp
  | succ k ih =>
    rw [pow_succ]; show ((ModularGroup.T ^ 2) ^ k).val * (ModularGroup.T ^ 2).val = _
    rw [ih, show (ModularGroup.T ^ 2).val = !![1, 2; 0, 1] from Tsq_coe, Matrix.mul_fin_two]
    ext i j; fin_cases i <;> fin_cases j <;> simp <;> push_cast <;> ring


/-! ## Toward the reverse inclusion `Γ(2) ≤ closure{T²,R,−I}` (the reduction algorithm). -/

local notation "H₂" => Subgroup.closure ({ModularGroup.T ^ 2, Rgen, -1} : Set SL(2, ℤ))

theorem Tsq_zpow_mem_H (n : ℤ) : (ModularGroup.T ^ 2) ^ n ∈ H₂ :=
  zpow_mem (Subgroup.subset_closure (by simp)) n

theorem Rgen_zpow_mem_H (n : ℤ) : Rgen ^ n ∈ H₂ :=
  zpow_mem (Subgroup.subset_closure (by simp)) n

theorem negOne_mem_H : (-1 : SL(2, ℤ)) ∈ H₂ := Subgroup.subset_closure (by simp)

/-- `T^(2m) = (T²)^m ∈ H` for any integer `m` (even powers of `T`). -/
theorem T_even_zpow_mem_H (m : ℤ) : ModularGroup.T ^ (2 * m) ∈ H₂ := by
  rw [show ModularGroup.T ^ (2 * m) = (ModularGroup.T ^ 2) ^ m by
    rw [← zpow_natCast ModularGroup.T 2, ← _root_.zpow_mul]; norm_num]
  exact Tsq_zpow_mem_H m

/-- **Base case of the Γ(2) reduction**: `γ ∈ Γ(2)` with lower-left entry `γ 1 0 = 0` lies in the
closure. Then `det = a·d = 1` with `a,d ∈ {±1}` and `b = γ 0 1` even, so `γ = T^(2m)` (if `a=1`) or
`γ = (−I)·T^(−2m)` (if `a=−1`), both in `closure{T²,R,−I}`. -/
theorem mem_H_of_col_zero (γ : SL(2, ℤ)) (hγ : γ ∈ Gamma 2) (hc : γ.val 1 0 = 0) : γ ∈ H₂ := by
  have hdet : γ.val 0 0 * γ.val 1 1 - γ.val 0 1 * γ.val 1 0 = 1 := by
    have := γ.property; rwa [Matrix.det_fin_two] at this
  rw [hc, mul_zero, sub_zero] at hdet
  obtain ⟨m, hm⟩ : (2 : ℤ) ∣ γ.val 0 1 := by
    have h := (Gamma_mem.mp hγ).2.1
    rw [ZMod.intCast_zmod_eq_zero_iff_dvd] at h; exact_mod_cast h
  rcases Int.mul_eq_one_iff_eq_one_or_neg_one.mp hdet with ⟨ha, hd⟩ | ⟨ha, hd⟩
  · have hval : γ.val = !![1, 2 * m; 0, 1] := by
      ext i j; fin_cases i <;> fin_cases j <;> simp_all
    have hγeq : γ = ModularGroup.T ^ (2 * m) :=
      Subtype.ext (by rw [hval, ModularGroup.coe_T_zpow])
    rw [hγeq]; exact T_even_zpow_mem_H m
  · have hprodval : ((-1 : SL(2, ℤ)) * ModularGroup.T ^ (-(2 * m))).val = !![-1, 2 * m; 0, -1] := by
      show (-1 : SL(2, ℤ)).val * (ModularGroup.T ^ (-(2 * m))).val = _
      rw [ModularGroup.coe_T_zpow]
      ext i j; fin_cases i <;> fin_cases j <;> simp [SpecialLinearGroup.coe_neg]
    have hval : γ.val = !![(-1 : ℤ), 2 * m; 0, -1] := by
      ext i j; fin_cases i <;> fin_cases j <;> simp_all
    have hγeq : γ = (-1 : SL(2, ℤ)) * ModularGroup.T ^ (-(2 * m)) :=
      Subtype.ext (by rw [hval, hprodval])
    rw [hγeq]
    refine mul_mem negOne_mem_H ?_
    rw [show -(2 * m) = 2 * (-m) by ring]; exact T_even_zpow_mem_H (-m)


/-! ## ℤ-power entry-forms (the reduction multiplies by `R^k`, `(T²)^k` for `k : ℤ`). -/

theorem Rgen_inv_val : (Rgen⁻¹).val = !![1, 0; -2, 1] := by
  rw [Matrix.SpecialLinearGroup.coe_inv, Rgen_apply, Matrix.adjugate_fin_two]; norm_num

theorem Tsq_inv_val : ((ModularGroup.T ^ 2)⁻¹).val = !![1, -2; 0, 1] := by
  rw [Matrix.SpecialLinearGroup.coe_inv,
    show ((ModularGroup.T ^ 2 : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) = !![1, 2; 0, 1] from Tsq_coe,
    Matrix.adjugate_fin_two]; norm_num

theorem Rgen_zpow_val (n : ℤ) : (Rgen ^ n).val = !![1, 0; 2 * n, 1] := by
  refine Int.induction_on n ?_ ?_ ?_
  · ext i j; fin_cases i <;> fin_cases j <;> simp
  · intro k ih
    rw [_root_.zpow_add_one]; show (Rgen ^ (k : ℤ)).val * Rgen.val = _
    rw [ih]; show !![1, 0; 2 * (k : ℤ), 1] * !![1, 0; 2, 1] = _
    rw [Matrix.mul_fin_two]; ext i j; fin_cases i <;> fin_cases j <;> simp <;> push_cast <;> ring
  · intro k ih
    rw [_root_.zpow_sub_one]; show (Rgen ^ (-(k : ℤ))).val * (Rgen⁻¹).val = _
    rw [ih, Rgen_inv_val, Matrix.mul_fin_two]
    ext i j; fin_cases i <;> fin_cases j <;> simp <;> push_cast <;> ring

theorem Tsq_zpow_val (n : ℤ) : ((ModularGroup.T ^ 2) ^ n).val = !![1, 2 * n; 0, 1] := by
  refine Int.induction_on n ?_ ?_ ?_
  · ext i j; fin_cases i <;> fin_cases j <;> simp
  · intro k ih
    rw [_root_.zpow_add_one]
    show ((ModularGroup.T ^ 2) ^ (k : ℤ)).val * (ModularGroup.T ^ 2).val = _
    rw [ih, show ((ModularGroup.T ^ 2 : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) = !![1, 2; 0, 1] from Tsq_coe,
      Matrix.mul_fin_two]
    ext i j; fin_cases i <;> fin_cases j <;> simp <;> push_cast <;> ring
  · intro k ih
    rw [_root_.zpow_sub_one]
    show ((ModularGroup.T ^ 2) ^ (-(k : ℤ))).val * ((ModularGroup.T ^ 2)⁻¹).val = _
    rw [ih, Tsq_inv_val, Matrix.mul_fin_two]
    ext i j; fin_cases i <;> fin_cases j <;> simp <;> push_cast <;> ring

theorem Rk_mul_00 (k : ℤ) (γ : SL(2, ℤ)) : (Rgen ^ k * γ).val 0 0 = γ.val 0 0 := by
  show ((Rgen ^ k).val * γ.val) 0 0 = _
  rw [Rgen_zpow_val, Matrix.mul_apply, Fin.sum_univ_two]; simp

theorem Rk_mul_10 (k : ℤ) (γ : SL(2, ℤ)) :
    (Rgen ^ k * γ).val 1 0 = 2 * k * γ.val 0 0 + γ.val 1 0 := by
  show ((Rgen ^ k).val * γ.val) 1 0 = _
  rw [Rgen_zpow_val, Matrix.mul_apply, Fin.sum_univ_two]; simp

theorem Tk_mul_00 (k : ℤ) (γ : SL(2, ℤ)) :
    ((ModularGroup.T ^ 2) ^ k * γ).val 0 0 = 2 * k * γ.val 1 0 + γ.val 0 0 := by
  show (((ModularGroup.T ^ 2) ^ k).val * γ.val) 0 0 = _
  rw [Tsq_zpow_val, Matrix.mul_apply, Fin.sum_univ_two]; simp; ring

theorem Tk_mul_10 (k : ℤ) (γ : SL(2, ℤ)) :
    ((ModularGroup.T ^ 2) ^ k * γ).val 1 0 = γ.val 1 0 := by
  show (((ModularGroup.T ^ 2) ^ k).val * γ.val) 1 0 = _
  rw [Tsq_zpow_val, Matrix.mul_apply, Fin.sum_univ_two]; simp

theorem exists_reduce (a c : ℤ) (ha : a ≠ 0) : ∃ k : ℤ, |2 * k * a + c| ≤ |a| := by
  have habs : 0 < |a| := abs_pos.mpr ha
  have hd : (0 : ℤ) < 2 * |a| := by linarith
  set q := c / (2 * |a|) with hq
  set r := c % (2 * |a|) with hr
  have hr0 : 0 ≤ r := Int.emod_nonneg c (by linarith)
  have hrlt : r < 2 * |a| := Int.emod_lt_of_pos c hd
  have hcq : c = 2 * |a| * q + r := (Int.ediv_add_emod c (2 * |a|)).symm
  have hsa : (a.sign : ℤ) * a = |a| := by
    rcases lt_trichotomy a 0 with h | h | h
    · rw [Int.sign_eq_neg_one_of_neg h]; simp [abs_of_neg h]
    · exact absurd h ha
    · rw [Int.sign_eq_one_of_pos h]; simp [abs_of_pos h]
  by_cases hcase : r ≤ |a|
  · refine ⟨-a.sign * q, ?_⟩
    have hval : 2 * (-a.sign * q) * a + c = r := by
      have : 2 * (-a.sign * q) * a = -(2 * q * (a.sign * a)) := by ring
      rw [this, hsa, hcq]; ring
    rw [hval, abs_of_nonneg hr0]; exact hcase
  · refine ⟨-a.sign * (q + 1), ?_⟩
    have hval : 2 * (-a.sign * (q + 1)) * a + c = r - 2 * |a| := by
      have : 2 * (-a.sign * (q + 1)) * a = -(2 * (q + 1) * (a.sign * a)) := by ring
      rw [this, hsa, hcq]; ring
    rw [hval, abs_of_neg (by linarith)]; linarith

/-- **Reverse inclusion: `Γ(2) ≤ closure{T²,R,−I}`.** Euclidean reduction on the first column. -/
theorem mem_H_of_mem_Gamma2 (γ : SL(2, ℤ)) (hγ : γ ∈ Gamma 2) : γ ∈ H₂ := by
  suffices H : ∀ N, ∀ δ : SL(2, ℤ), δ ∈ Gamma 2 →
      (δ.val 0 0).natAbs + (δ.val 1 0).natAbs = N → δ ∈ H₂ from H _ γ hγ rfl
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
    intro δ hδ hN
    by_cases hc0 : δ.val 1 0 = 0
    · exact mem_H_of_col_zero δ hδ hc0
    · have haodd : ¬ (2 : ℤ) ∣ δ.val 0 0 := by
        intro hdvd
        have hz : ((δ.val 0 0 : ℤ) : ZMod 2) = 0 := by
          rw [ZMod.intCast_zmod_eq_zero_iff_dvd]; exact_mod_cast hdvd
        exact one_ne_zero ((Gamma_mem.mp hδ).1.symm.trans hz)
      have hceven : (2 : ℤ) ∣ δ.val 1 0 := by
        have h := (Gamma_mem.mp hδ).2.2.1
        rw [ZMod.intCast_zmod_eq_zero_iff_dvd] at h; exact_mod_cast h
      have ha0 : δ.val 0 0 ≠ 0 := by rintro h; exact haodd (h ▸ dvd_zero 2)
      have hne : (δ.val 0 0).natAbs ≠ (δ.val 1 0).natAbs := by
        intro he
        apply haodd
        have h2c : (2 : ℕ) ∣ (δ.val 1 0).natAbs := by
          have := Int.natAbs_dvd_natAbs.mpr hceven; simpa using this
        rw [← he] at h2c
        have := Int.natAbs_dvd_natAbs.mp (by simpa using h2c : (2 : ℤ).natAbs ∣ (δ.val 0 0).natAbs)
        exact this
      rcases lt_or_gt_of_ne hne with hlt | hgt
      · -- |a| < |c|: reduce c with R^k
        obtain ⟨k, hk⟩ := exists_reduce (δ.val 0 0) (δ.val 1 0) ha0
        set δ' := Rgen ^ k * δ with hδ'
        have h00 : δ'.val 0 0 = δ.val 0 0 := Rk_mul_00 k δ
        have h10 : δ'.val 1 0 = 2 * k * δ.val 0 0 + δ.val 1 0 := Rk_mul_10 k δ
        have hδ'mem : δ' ∈ Gamma 2 := mul_mem (zpow_mem (Rgen_mem_Gamma2) k) hδ
        have hmlt : (δ'.val 0 0).natAbs + (δ'.val 1 0).natAbs < N := by
          rw [h00, h10, ← hN]
          have : (2 * k * δ.val 0 0 + δ.val 1 0).natAbs ≤ (δ.val 0 0).natAbs := by
            have h := hk; rw [Int.abs_eq_natAbs, Int.abs_eq_natAbs] at h; exact_mod_cast h
          omega
        have hin : δ' ∈ H₂ := ih _ hmlt δ' hδ'mem rfl
        have : δ = Rgen ^ (-k) * δ' := by
          rw [hδ', ← mul_assoc, ← _root_.zpow_add, neg_add_cancel, zpow_zero, one_mul]
        rw [this]; exact mul_mem (Rgen_zpow_mem_H _) hin
      · -- |c| < |a|: reduce a with (T²)^k
        obtain ⟨k, hk⟩ := exists_reduce (δ.val 1 0) (δ.val 0 0) hc0
        set δ' := (ModularGroup.T ^ 2) ^ k * δ with hδ'
        have h00 : δ'.val 0 0 = 2 * k * δ.val 1 0 + δ.val 0 0 := Tk_mul_00 k δ
        have h10 : δ'.val 1 0 = δ.val 1 0 := Tk_mul_10 k δ
        have hδ'mem : δ' ∈ Gamma 2 := mul_mem (zpow_mem (Tsq_mem_Gamma2) k) hδ
        have hmlt : (δ'.val 0 0).natAbs + (δ'.val 1 0).natAbs < N := by
          rw [h00, h10, ← hN]
          have : (2 * k * δ.val 1 0 + δ.val 0 0).natAbs ≤ (δ.val 1 0).natAbs := by
            have h := hk; rw [Int.abs_eq_natAbs, Int.abs_eq_natAbs] at h; exact_mod_cast h
          omega
        have hin : δ' ∈ H₂ := ih _ hmlt δ' hδ'mem rfl
        have : δ = (ModularGroup.T ^ 2) ^ (-k) * δ' := by
          rw [hδ', ← mul_assoc, ← _root_.zpow_add, neg_add_cancel, zpow_zero, one_mul]
        rw [this]; exact mul_mem (Tsq_zpow_mem_H _) hin

/-- **Γ(2) is generated by `T²`, `R = [[1,0],[2,1]]`, and `−I`.** Both inclusions: `closure ≤ Γ(2)`
(generators lie in `Γ(2)`) and `Γ(2) ≤ closure` (the Euclidean reduction `mem_H_of_mem_Gamma2`). This
is the group-theoretic input for promoting the quartic defect's generator slash-invariances to
`F ∈ SlashInvariantForm Γ(2) 2` (via mathlib's `slash_action_generators`). -/
theorem Gamma2_eq_closure :
    Gamma 2 = Subgroup.closure ({ModularGroup.T ^ 2, Rgen, -1} : Set SL(2, ℤ)) :=
  le_antisymm (fun x hx => mem_H_of_mem_Gamma2 x hx) closure_le_Gamma2

end Bottcher
