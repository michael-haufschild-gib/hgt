/-
# `ℍ → ℍ/PΓ(2)` is a covering map

The last topological brick (`#35`) of the modular-curve covering lane. mathlib's quotient-covering
theorem `isQuotientCoveringMap_quotientMk_of_properlyDiscontinuousSMul` gives `IsCoveringMap (Quotient.mk
(orbitRel G ℍ))` from **four** inputs on the acting group `G`: a continuous, properly discontinuous,
**free** (`IsCancelSMul`) action on the locally-compact Hausdorff `ℍ`. The catch: `Γ(2)` is **not** free —
`-I ∈ Γ(2)` acts trivially, so *every* stabiliser is `{±I} ≠ ⊥`. The honest fix is to pass to the
projective group

  `PΓ(2) := Γ(2) ⧸ {±I}`,

which **does** act freely (`Gamma2FreeAction.gamma2_fix_eq_one_or_neg_one`: the only `Γ(2)`-elements fixing
a point are `±I`). This file constructs that quotient action and supplies all four typeclass inputs:

* `instMulActionPGamma2` — the descended action `[γ] • z = γ • z`, built by lifting the permutation
  representation `Γ(2) →* Equiv.Perm ℍ` across `{±I} ≤ ker` (the trivial-action subgroup);
* `instContinuousConstSMulPGamma2` — continuity, transported through `castSL2R` to the `SL(2,ℝ)`-action;
* `instProperlyDiscontinuousSMulPGamma2` — proper discontinuity, by `properlyDiscontinuousSMul_of_surjective`
  from `ProperlyDiscontinuousSMul (Γ(2)) ℍ` (`Gamma2ProperAction`) along the quotient surjection;
* `instIsCancelSMulPGamma2` — freeness, the deep input, from `gamma2_fix_eq_one_or_neg_one`.

Conclusion `isCoveringMap_quotientMk_pgamma2 : IsCoveringMap (Quotient.mk (orbitRel PΓ(2) ℍ))`. Composed
with the homeomorphism `λ̄ : ℍ/PΓ(2) ≃ₜ ℂ∖{0,1}` (the analytic half, separate), this makes
`λ : ℍ → ℂ∖{0,1}` a covering map — the input the three-value Montel lift (`#30`) consumes.
-/
import Mathlib.Tactic
import Mathlib.Topology.Covering.Quotient
import GaloisForLFunctions.Bottcher.Gamma2FreeAction
import GaloisForLFunctions.Bottcher.Gamma2ProperAction

open UpperHalfPlane CongruenceSubgroup MulAction Matrix
open scoped MatrixGroups

namespace Bottcher

/-! ### The projective congruence group `PΓ(2) = Γ(2) ⧸ {±I}` -/

/-- `-I` lies in `Γ(2)` (its entries are `≡ I (mod 2)`). -/
theorem negI_mem_gamma2 : (-1 : SL(2, ℤ)) ∈ Gamma 2 := by rw [Gamma_mem]; decide

/-- The element `-I` of `Γ(2)`, the lone nontrivial point-stabiliser. -/
def nI : (Gamma 2) := ⟨-1, negI_mem_gamma2⟩

/-- `-I` is central in `Γ(2)` (it is central in `SL(2,ℤ)`: `g·(-1) = -g = (-1)·g`). -/
theorem nI_mem_center : nI ∈ Subgroup.center (Gamma 2) := by
  rw [Subgroup.mem_center_iff]
  intro g
  apply Subtype.ext
  show (g : SL(2, ℤ)) * (-1) = (-1) * (g : SL(2, ℤ))
  rw [mul_neg_one, neg_one_mul]

/-- The order-two central subgroup `{±I} = ⟨-I⟩ ≤ Γ(2)`. -/
def projKer : Subgroup (Gamma 2) := Subgroup.zpowers nI

/-- A subgroup contained in the centre is normal. -/
theorem normal_of_le_center {G : Type*} [Group G] (H : Subgroup G)
    (h : H ≤ Subgroup.center G) : H.Normal where
  conj_mem n hn g := by
    have hc := (Subgroup.mem_center_iff.mp (h hn)) g
    have hconj : g * n * g⁻¹ = n := by rw [hc]; group
    rw [hconj]; exact hn

instance : (projKer).Normal :=
  normal_of_le_center projKer (by rw [projKer, Subgroup.zpowers_le]; exact nI_mem_center)

/-- `-I` acts trivially on `ℍ`: `(-I) • z = (-z)/(-1) = z`. -/
theorem nI_smul (z : ℍ) : nI • z = z := by
  show ((-1 : SL(2, ℤ))) • z = z
  apply UpperHalfPlane.ext
  rw [UpperHalfPlane.specialLinearGroup_apply]
  norm_num [show ((-1 : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) 0 0 = -1 from by decide,
            show ((-1 : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) 0 1 = 0 from by decide,
            show ((-1 : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) 1 0 = 0 from by decide,
            show ((-1 : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) 1 1 = -1 from by decide]

/-- `{±I}` lies in the kernel of the permutation representation `Γ(2) →* Equiv.Perm ℍ`: every element
acts as the identity (it is generated by the trivially-acting `-I`). -/
theorem projKer_le_ker : projKer ≤ (MulAction.toPermHom (Gamma 2) ℍ).ker := by
  rw [projKer, Subgroup.zpowers_le, MonoidHom.mem_ker]
  refine Equiv.ext (fun z => ?_)
  exact nI_smul z

/-- The descended permutation representation of `PΓ(2) = Γ(2) ⧸ {±I}` on `ℍ`. -/
noncomputable def liftPerm : (Gamma 2 ⧸ projKer) →* Equiv.Perm ℍ :=
  QuotientGroup.lift projKer (MulAction.toPermHom (Gamma 2) ℍ) projKer_le_ker

/-- The action of `PΓ(2)` on `ℍ`, descended from the `Γ(2)`-action since `±I` acts trivially. -/
noncomputable instance instMulActionPGamma2 : MulAction (Gamma 2 ⧸ projKer) ℍ :=
  MulAction.compHom ℍ liftPerm

/-- The defining property of the descended action: `[γ] • z = γ • z`. -/
theorem mk_smul (g : Gamma 2) (z : ℍ) : (QuotientGroup.mk g : Gamma 2 ⧸ projKer) • z = g • z := by
  show liftPerm (QuotientGroup.mk g) z = g • z
  rw [liftPerm, QuotientGroup.lift_mk, MulAction.toPermHom_apply, MulAction.toPerm_apply]

/-! ### The four typeclass inputs for the quotient-covering theorem -/

/-- Continuity of the `PΓ(2)`-action: each `[γ] • ·` equals `castSL2R γ • ·`, continuous as a restriction
of the (jointly continuous) `SL(2,ℝ)`-action. -/
instance instContinuousConstSMulPGamma2 : ContinuousConstSMul (Gamma 2 ⧸ projKer) ℍ where
  continuous_const_smul q := by
    obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective q
    have hfun : ((QuotientGroup.mk g : Gamma 2 ⧸ projKer) • · : ℍ → ℍ)
        = (castSL2R (g : SL(2, ℤ)) • ·) := by
      funext z; rw [mk_smul]; rfl
    rw [hfun]; exact continuous_const_smul _

/-- Proper discontinuity of the `PΓ(2)`-action, pushed from `ProperlyDiscontinuousSMul (Γ(2)) ℍ`
(`Gamma2ProperAction`) along the surjection `Γ(2) ↠ PΓ(2)`. -/
instance instProperlyDiscontinuousSMulPGamma2 :
    ProperlyDiscontinuousSMul (Gamma 2 ⧸ projKer) ℍ :=
  properlyDiscontinuousSMul_of_surjective
    (QuotientGroup.mk : (Gamma 2) → Gamma 2 ⧸ projKer)
    QuotientGroup.mk_surjective (fun g z => mk_smul g z)

/-- **Freeness of the `PΓ(2)`-action** — the deep input. `[α] • z = [β] • z` forces `α⁻¹β` to fix `z`,
hence (`gamma2_fix_eq_one_or_neg_one`) `α⁻¹β = ±I ∈ {±I}`, i.e. `[α] = [β]`. Left cancellation is automatic
(a group acts by bijections). -/
instance instIsCancelSMulPGamma2 : IsCancelSMul (Gamma 2 ⧸ projKer) ℍ where
  left_cancel' a b c h := MulAction.injective a h
  right_cancel' a b z h := by
    obtain ⟨α, rfl⟩ := QuotientGroup.mk_surjective a
    obtain ⟨β, rfl⟩ := QuotientGroup.mk_surjective b
    rw [mk_smul, mk_smul] at h
    rw [QuotientGroup.eq]
    have hfix : (α⁻¹ * β) • z = z := by rw [mul_smul, ← h, inv_smul_smul]
    rcases gamma2_fix_eq_one_or_neg_one (α⁻¹ * β).2 hfix with h1 | h1
    · have he : α⁻¹ * β = 1 := Subtype.ext h1
      rw [he]; exact projKer.one_mem
    · have he : α⁻¹ * β = nI := Subtype.ext h1
      rw [he, projKer]; exact Subgroup.mem_zpowers nI

/-! ### The covering map -/

/-- **`ℍ → ℍ/PΓ(2)` is a covering map.** All four hypotheses of mathlib's quotient-covering theorem
now hold for `PΓ(2) = Γ(2) ⧸ {±I}` acting on `ℍ`: continuous, properly discontinuous, free, on a
locally-compact Hausdorff space. This is brick `#35`: the topological half of `IsCoveringMap λ`. -/
theorem isCoveringMap_quotientMk_pgamma2 :
    IsCoveringMap (Quotient.mk (MulAction.orbitRel (Gamma 2 ⧸ projKer) ℍ)) :=
  (isQuotientCoveringMap_quotientMk_of_properlyDiscontinuousSMul
    (G := Gamma 2 ⧸ projKer) (E := ℍ)).isCoveringMap

end Bottcher
