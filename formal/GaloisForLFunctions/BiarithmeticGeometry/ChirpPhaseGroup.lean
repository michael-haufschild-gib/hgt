import GaloisForLFunctions.RHTower.SimultaneousPhaseRecurrence
import Mathlib.Topology.Algebra.Group.Basic

/-!
# The compact phase group of logarithmic chirps

The flow at a positive integer cofactor is its logarithmic circle
character. Its closure in the countable product of circles is an actual
compact group. The cofactor identities extend from the flow by closedness,
so no multiplicative phase law is assumed.
-/

noncomputable section
open Set Topology
namespace GaloisForLFunctions.BiarithmeticGeometry

/-- The simultaneous logarithmic phase flow on positive integer cofactors. -/
def logarithmicChirpPhaseOrbit (t : ℝ) (j : ℕ+) : Circle :=
  Circle.exp (-2 * t * Real.log (j : ℝ))

theorem continuous_logarithmicChirpPhaseOrbit : Continuous logarithmicChirpPhaseOrbit := by
  apply continuous_pi
  intro j
  exact Circle.exp.continuous.comp (by fun_prop)

theorem logarithmicChirpPhaseOrbit_add (s t : ℝ) :
    logarithmicChirpPhaseOrbit (s + t) =
      logarithmicChirpPhaseOrbit s * logarithmicChirpPhaseOrbit t := by
  funext j
  change Circle.exp (-2 * (s + t) * Real.log (j : ℝ)) = _
  rw [show -2 * (s + t) * Real.log (j : ℝ) =
    -2 * s * Real.log (j : ℝ) + -2 * t * Real.log (j : ℝ) by ring, Circle.exp_add]
  rfl

theorem logarithmicChirpPhaseOrbit_zero : logarithmicChirpPhaseOrbit 0 = 1 := by
  funext j
  simp only [logarithmicChirpPhaseOrbit, mul_zero, zero_mul, Circle.exp_zero, Pi.one_apply]

/-- The phase flow as a homomorphism from the additive real line. -/
def logarithmicChirpPhaseHom : Multiplicative ℝ →* (ℕ+ → Circle) where
  toFun t := logarithmicChirpPhaseOrbit (Multiplicative.toAdd t)
  map_one' := logarithmicChirpPhaseOrbit_zero
  map_mul' s t := logarithmicChirpPhaseOrbit_add (Multiplicative.toAdd s) (Multiplicative.toAdd t)

/-- The actual closed phase group generated by the real logarithmic flow. -/
def logarithmicChirpPhaseGroup : Subgroup (ℕ+ → Circle) :=
  logarithmicChirpPhaseHom.range.topologicalClosure

theorem logarithmicChirpPhaseGroup_carrier :
    (logarithmicChirpPhaseGroup : Set (ℕ+ → Circle)) =
      closure (Set.range logarithmicChirpPhaseOrbit) := by
  rw [logarithmicChirpPhaseGroup, Subgroup.topologicalClosure_coe]
  congr 1

instance logarithmicChirpPhaseGroup_isClosed :
    IsClosed (logarithmicChirpPhaseGroup : Set (ℕ+ → Circle)) :=
  Subgroup.isClosed_topologicalClosure logarithmicChirpPhaseHom.range

/-- The phase parameter space is compact with its inherited group topology. -/
instance logarithmicChirpPhaseGroup_compactSpace : CompactSpace logarithmicChirpPhaseGroup :=
  isCompact_iff_compactSpace.mp logarithmicChirpPhaseGroup_isClosed.isCompact

theorem logarithmicChirpPhaseOrbit_one (t : ℝ) : logarithmicChirpPhaseOrbit t 1 = 1 := by
  simp only [logarithmicChirpPhaseOrbit, show ((1 : ℕ+) : ℝ) = 1 by norm_num,
    Real.log_one, mul_zero, Circle.exp_zero]

theorem logarithmicChirpPhaseOrbit_mul (t : ℝ) (j k : ℕ+) :
    logarithmicChirpPhaseOrbit t (j * k) =
      logarithmicChirpPhaseOrbit t j * logarithmicChirpPhaseOrbit t k := by
  have hj : (j : ℝ) ≠ 0 := (show (0 : ℝ) < j by exact_mod_cast j.property).ne'
  have hk : (k : ℝ) ≠ 0 := (show (0 : ℝ) < k by exact_mod_cast k.property).ne'
  have hcast : ((j * k : ℕ+) : ℝ) = (j : ℝ) * (k : ℝ) := by norm_cast
  unfold logarithmicChirpPhaseOrbit
  rw [hcast, Real.log_mul hj hk, mul_add, Circle.exp_add]

/-- Every phase in the actual flow closure has unit value at the unit cofactor. -/
theorem logarithmicChirpPhase_one (z : logarithmicChirpPhaseGroup) : z.val 1 = 1 := by
  have hz : z.val ∈ closure (Set.range logarithmicChirpPhaseOrbit) := by
    rw [← logarithmicChirpPhaseGroup_carrier]
    exact z.property
  apply closure_minimal (t := {w : ℕ+ → Circle | w 1 = 1}) _
    (isClosed_eq (continuous_apply 1) continuous_const) hz
  rintro w ⟨t, rfl⟩
  exact logarithmicChirpPhaseOrbit_one t

/-- Complete multiplicativity follows from closed identities on the phase orbit. -/
theorem logarithmicChirpPhase_mul (z : logarithmicChirpPhaseGroup) (j k : ℕ+) :
    z.val (j * k) = z.val j * z.val k := by
  have hz : z.val ∈ closure (Set.range logarithmicChirpPhaseOrbit) := by
    rw [← logarithmicChirpPhaseGroup_carrier]
    exact z.property
  apply closure_minimal (t := {w : ℕ+ → Circle | w (j * k) = w j * w k}) _
    (isClosed_eq (continuous_apply (j * k)) ((continuous_apply j).mul (continuous_apply k))) hz
  rintro w ⟨t, rfl⟩
  exact logarithmicChirpPhaseOrbit_mul t j k

/-- An orbit phase as an element of its actual compact closure group. -/
def logarithmicChirpOrbitPoint (t : ℝ) : logarithmicChirpPhaseGroup :=
  ⟨logarithmicChirpPhaseOrbit t,
    logarithmicChirpPhaseHom.range.le_topologicalClosure ⟨Multiplicative.ofAdd t, rfl⟩⟩

end GaloisForLFunctions.BiarithmeticGeometry

