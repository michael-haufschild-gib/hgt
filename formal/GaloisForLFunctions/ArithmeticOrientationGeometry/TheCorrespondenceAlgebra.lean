import GaloisForLFunctions.ArithmeticOrientationGeometry.ScalingDataAndWeilPlanes

/-!
# The correspondence algebra of a scaling datum

Weil's second proof of the Riemann hypothesis for curves works in the ring of correspondences:
the Rosati involution `ξ ↦ ξ′` is positive, `Tr(ξ ξ′) > 0` for `ξ ≠ 0`, and Frobenius satisfies
`π π′ = q`. On a scaling datum the correspondences generated by the scales are the finitely
supported real measures `ξ : G →₀ ℝ` (`Correspondence`), acting by `ξ · x = Σ_g ξ(g) ψ_g x`.

* **Action** (`corr_conv`). Convolution of measures is composition of correspondences.
* **Rosati involution** (`rosati`, `ξ′(g) = ξ(−g)`). It is the adjoint for the defect:
  `δ(ξ · x, η · x) = τ_x(ξ ⋆ η′)` with the **trace at `x`**, `τ_x(ξ) = δ(ξ · x, x)`
  (`defect_corr_corr`). The trace of a point mass is the orbit correlation, `τ_x([g]) = c_x(g)`.
* **Rosati positivity is the orbit Hodge index** (`rosatiPositive_iff_orbitHodgeIndex`):
  `τ_x(ξ ⋆ ξ′) ≥ 0` for every correspondence iff the defect is nonnegative on the orbit of `x`.
* **Hecke graphs** (`heckeGraph`, `T_g = e^{s(g)/2} ψ_g`). Two graphs meet through the Lefschetz
  number of the difference, `Γ_g · Γ_h = e^{s(h)} L(x, g − h)` (`pair_heckeGraph`); the adjunction
  formula is `Γ_g² = e^{s(g)} x²` (`pair_heckeGraph_self`); and `T_g T_g′ = e^{s(g)}`, Weil's
  relation `π π′ = q` (`heckeGraph_rosati`). Over `ℤ` these are the Hecke cycles of Arithmetic
  Castelnuovo–Severi.

Nothing here is positive: every identity holds on the golden curve datum, which violates the
Hasse–Weil bound. The positivity input of Weil's proof is the Rosati positivity of the trace, and
on a scaling datum it is exactly the orbit Hodge index.
-/

noncomputable section

open Finset

namespace GaloisForLFunctions.ArithmeticOrientationGeometry

open ArithmeticCastelnuovoSeveri

/-- Correspondences of a scaling datum: finitely supported real measures on the scale group. -/
abbrev Correspondence (G : Type*) := G →₀ ℝ

namespace ScalingDatum

variable {G : Type*} [AddCommGroup G] {E : Type*} [AddCommGroup E] [Module ℝ E]
variable (D : ScalingDatum G E)

/-- The action `ξ · x = Σ_g ξ(g) ψ_g x` of a correspondence on a cycle. -/
def corr (ξ : Correspondence G) (x : E) : E := ξ.sum fun g a => a • D.act g x

theorem corr_single (g : G) (a : ℝ) (x : E) : D.corr (Finsupp.single g a) x = a • D.act g x := by
  rw [corr, Finsupp.sum_single_index (by simp)]

theorem corr_add (ξ η : Correspondence G) (x : E) :
    D.corr (ξ + η) x = D.corr ξ x + D.corr η x := by
  simp only [corr]
  rw [Finsupp.sum_add_index']
  · intro; simp
  · intros; simp [add_smul]

theorem corr_zero (x : E) : D.corr 0 x = 0 := by simp [corr]

/-- The action is linear in the cycle. -/
theorem corr_add_right (ξ : Correspondence G) (x y : E) :
    D.corr ξ (x + y) = D.corr ξ x + D.corr ξ y := by
  simp only [corr, map_add, smul_add, Finsupp.sum_add]

theorem corr_smul_right (ξ : Correspondence G) (c : ℝ) (x : E) :
    D.corr ξ (c • x) = c • D.corr ξ x := by
  simp only [corr, map_smul, Finsupp.smul_sum, smul_comm c]

theorem corr_act (ξ : Correspondence G) (h : G) (x : E) :
    D.corr ξ (D.act h x) = ξ.sum fun g a => a • D.act (g + h) x := by
  simp only [corr, D.act_add]

/-- The convolution of two correspondences. -/
def conv (ξ η : Correspondence G) : Correspondence G :=
  ξ.sum fun g a => η.sum fun h b => Finsupp.single (g + h) (a * b)

/-- **Convolution is composition.** -/
theorem corr_conv (ξ η : Correspondence G) (x : E) :
    D.corr (conv ξ η) x = D.corr ξ (D.corr η x) := by
  induction ξ using Finsupp.induction_linear with
  | zero => simp [conv, corr]
  | add ξ₁ ξ₂ h₁ h₂ =>
    rw [conv, Finsupp.sum_add_index' (fun _ => by simp) (fun g a b => by
      simp only [add_mul, Finsupp.single_add, Finsupp.sum_add]), ← conv, ← conv, D.corr_add,
      h₁, h₂, D.corr_add]
  | single g a =>
    rw [conv, Finsupp.sum_single_index (by simp), D.corr_single]
    induction η using Finsupp.induction_linear with
    | zero => simp [corr]
    | add η₁ η₂ k₁ k₂ =>
      rw [Finsupp.sum_add_index' (fun _ => by simp) (fun h b c => by
        rw [mul_add, Finsupp.single_add]), D.corr_add, k₁, k₂, D.corr_add, map_add, smul_add]
    | single h b =>
      rw [Finsupp.sum_single_index (by simp), D.corr_single, D.corr_single, map_smul,
        D.act_add, smul_smul]

/-- The **Rosati involution** `ξ′(g) = ξ(−g)`. -/
def rosati (ξ : Correspondence G) : Correspondence G := Finsupp.mapDomain (fun g => -g) ξ

theorem rosati_single (g : G) (a : ℝ) : rosati (Finsupp.single g a) = Finsupp.single (-g) a := by
  rw [rosati, Finsupp.mapDomain_single]

theorem rosati_add (ξ η : Correspondence G) : rosati (ξ + η) = rosati ξ + rosati η :=
  Finsupp.mapDomain_add

/-- The **trace at a cycle**: `τ_x(ξ) = δ(ξ · x, x)`. -/
def traceAt (x : E) (ξ : Correspondence G) : ℝ := D.defect (D.corr ξ x) x

/-- The trace of a point mass is the orbit correlation. -/
theorem traceAt_single (x : E) (g : G) : D.traceAt x (Finsupp.single g 1) = D.orbitCorr x g := by
  rw [traceAt, D.corr_single, one_smul, orbitCorr]

theorem traceAt_add (x : E) (ξ η : Correspondence G) :
    D.traceAt x (ξ + η) = D.traceAt x ξ + D.traceAt x η := by
  rw [traceAt, D.corr_add, D.defect_add_left, traceAt, traceAt]

theorem traceAt_single_smul (x : E) (g : G) (a : ℝ) :
    D.traceAt x (Finsupp.single g a) = a * D.orbitCorr x g := by
  rw [traceAt, D.corr_single, D.defect_smul_left, orbitCorr]

/-- The trace as a sum over the support: `τ_x(ξ) = Σ_g ξ(g) c_x(g)`. -/
theorem traceAt_eq_sum (x : E) (ξ : Correspondence G) :
    D.traceAt x ξ = ξ.sum fun g a => a * D.orbitCorr x g := by
  induction ξ using Finsupp.induction_linear with
  | zero => simp [traceAt, corr_zero, PolarSurface.defect, PolarSurface.polar]
  | add ξ η hξ hη =>
    rw [D.traceAt_add, hξ, hη, Finsupp.sum_add_index' (fun _ => zero_mul _) (fun _ _ _ => add_mul _ _ _)]
  | single g a => rw [D.traceAt_single_smul, Finsupp.sum_single_index (zero_mul _)]

/-- **The Rosati involution is the adjoint for the defect.**
`δ(ξ · x, η · x) = τ_x(ξ ⋆ η′)`. -/
theorem defect_corr_corr (x : E) (ξ η : Correspondence G) :
    D.defect (D.corr ξ x) (D.corr η x) = D.traceAt x (conv ξ (rosati η)) := by
  induction η using Finsupp.induction_linear with
  | zero =>
    simp [corr_zero, rosati, conv, traceAt, PolarSurface.defect, PolarSurface.polar]
  | add η₁ η₂ h₁ h₂ =>
    have hconv : conv ξ (rosati (η₁ + η₂)) = conv ξ (rosati η₁) + conv ξ (rosati η₂) := by
      rw [rosati_add, conv, conv, conv, ← Finsupp.sum_add]
      refine Finsupp.sum_congr fun g _ => ?_
      rw [Finsupp.sum_add_index' (fun _ => by simp) (fun h b c => by
        rw [mul_add, Finsupp.single_add])]
    rw [D.corr_add, D.defect_add_right, h₁, h₂, hconv, D.traceAt_add]
  | single h b =>
    rw [rosati_single, D.corr_single, D.defect_smul_right]
    induction ξ using Finsupp.induction_linear with
    | zero =>
      simp [corr_zero, conv, traceAt, PolarSurface.defect, PolarSurface.polar]
    | add ξ₁ ξ₂ k₁ k₂ =>
      have hconv : conv (ξ₁ + ξ₂) (Finsupp.single (-h) b) =
          conv ξ₁ (Finsupp.single (-h) b) + conv ξ₂ (Finsupp.single (-h) b) := by
        rw [conv, Finsupp.sum_add_index' (fun _ => by simp) (fun g a c => by
          simp only [add_mul, Finsupp.single_add, Finsupp.sum_add]), ← conv, ← conv]
      rw [D.corr_add, D.defect_add_left, mul_add, k₁, k₂, hconv, D.traceAt_add]
    | single g a =>
      rw [conv, Finsupp.sum_single_index (by simp), Finsupp.sum_single_index (by simp),
        D.traceAt_single_smul, D.corr_single, D.defect_smul_left, D.defect_act_act,
        ← sub_eq_add_neg, orbitCorr]
      ring

/-- **Rosati positivity at `x`**: `τ_x(ξ ⋆ ξ′) ≥ 0` for every correspondence. -/
def RosatiPositive (x : E) : Prop := ∀ ξ : Correspondence G, 0 ≤ D.traceAt x (conv ξ (rosati ξ))

/-- Every finite orbit combination is the action of a correspondence. -/
theorem orbitComb_eq_corr [DecidableEq G] (x : E) (S : Finset G) (c : G → ℝ) :
    D.orbitComb x S c = D.corr (∑ g ∈ S, Finsupp.single g (c g)) x := by
  induction S using Finset.induction_on with
  | empty => simp [orbitComb, corr_zero]
  | insert a S ha ih =>
    rw [orbitComb, sum_insert ha, sum_insert ha, D.corr_add, D.corr_single, ← orbitComb, ih]

/-- Every correspondence acts as a finite orbit combination. -/
theorem corr_eq_orbitComb (x : E) (ξ : Correspondence G) :
    D.corr ξ x = D.orbitComb x ξ.support ξ := rfl

/-- **Rosati positivity is the orbit Hodge index.** Weil's positivity of the trace on the ring of
correspondences, read at the diagonal `x`, is the nonnegativity of the defect on the orbit of
`x`. -/
theorem rosatiPositive_iff_orbitHodgeIndex (x : E) :
    D.RosatiPositive x ↔ D.OrbitHodgeIndex x := by
  classical
  rw [orbitHodgeIndex_iff_defect_nonneg, RosatiPositive]
  constructor
  · intro h S c
    rw [orbitComb_eq_corr, defect_corr_corr]
    exact h _
  · intro h ξ
    rw [← defect_corr_corr, corr_eq_orbitComb]
    exact h _ _

/-! ### Hecke graphs: Lefschetz, adjunction and Weil's relation `π π′ = q` -/

/-- The **Hecke graph** `Γ_g = T_g x = e^{s(g)/2} ψ_g x`, the analogue of `(F^m × id)_* Δ`. -/
def heckeGraph (x : E) (g : G) : E := Real.exp (D.scale g / 2) • D.act g x

theorem pair_act_act (g h : G) (x y : E) :
    D.pair (D.act g x) (D.act h y) = D.pair (D.act (g - h) x) y := by
  rw [← D.pair_act (-h), ← D.act_add, D.act_neg_act, neg_add_eq_sub]

/-- **Pullback identity.** `Γ_g · Γ_h = e^{s(h)} L(x, g − h)`; over `𝔽_q`,
`Γ_k · Γ_l = q^l N_{k − l}`. -/
theorem pair_heckeGraph (x : E) (g h : G) :
    D.pair (D.heckeGraph x g) (D.heckeGraph x h) = Real.exp (D.scale h) * D.lefschetz x (g - h) := by
  simp only [heckeGraph, map_smul, LinearMap.smul_apply, smul_eq_mul, D.pair_act_act, lefschetz,
    map_sub]
  rw [← mul_assoc, ← mul_assoc, ← Real.exp_add, ← Real.exp_add]
  ring_nf

/-- **Adjunction.** `Γ_g² = e^{s(g)} x²`; over `𝔽_q`, `Γ_m² = q^m (2 − 2g)`. -/
theorem pair_heckeGraph_self (x : E) (g : G) :
    D.pair (D.heckeGraph x g) (D.heckeGraph x g) = Real.exp (D.scale g) * D.pair x x := by
  rw [pair_heckeGraph, sub_self, lefschetz, map_zero, zero_div, Real.exp_zero, one_mul, D.act_zero]

/-- The graph meets the diagonal in the Lefschetz number. -/
theorem pair_heckeGraph_diag (x : E) (g : G) :
    D.pair (D.heckeGraph x g) x = D.lefschetz x g := by
  simp only [heckeGraph, map_smul, LinearMap.smul_apply, smul_eq_mul, lefschetz]

/-- The transposed graph `T_g′ = e^{s(g)/2} ψ_{−g}`. -/
def heckeGraphRosati (x : E) (g : G) : E := Real.exp (D.scale g / 2) • D.act (-g) x

/-- **Weil's relation `π π′ = q`.** `T_g T_g′ = e^{s(g)}`. -/
theorem heckeGraph_rosati (x : E) (g : G) :
    Real.exp (D.scale g / 2) • D.act g (D.heckeGraphRosati x g) = Real.exp (D.scale g) • x := by
  rw [heckeGraphRosati, map_smul, D.act_act_neg, smul_smul, ← Real.exp_add]
  ring_nf

end ScalingDatum

end GaloisForLFunctions.ArithmeticOrientationGeometry
