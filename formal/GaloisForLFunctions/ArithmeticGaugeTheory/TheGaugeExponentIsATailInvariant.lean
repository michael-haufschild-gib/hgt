import GaloisForLFunctions.ArithmeticGaugeTheory.TheGaugeExponent

/-!
# The gauge exponent is a tail invariant

Changing a gauge point at finitely many primes does not change its Möbius exponent. Finite prime
information therefore never decides typicality: the class of the trivial point contains every
finite flip, and RH is a property of the tail of the gauge point.

* **Splitting off one prime** (`moebiusGaugeSum_eq_split`). With `A_y(N)` the twisted Möbius sum
  over the integers prime to `p` (`coprimeMoebiusSum`),
  `S_y(N) = A_y(N) − χ_y(p) A_y(⌊N/p⌋)`: a multiple `pm` of `p` is squarefree only if `p ∤ m`, and
  then `μ(pm) χ(pm) = −χ(p) μ(m) χ(m)`.
* **Inversion** (`coprimeMoebiusSum_eq_sum`). `A_y(N) = Σ_k χ_y(p)^k S_y(⌊N/p^k⌋)`.
* **The coprime part forgets `p`** (`coprimeMoebiusSum_congr`). `A_y` only reads the primes other
  than `p`.
* **Bounds transfer** (`norm_coprimeMoebiusSum_le`). A bound `|S_y(M)| ≤ C (M + 1)^θ`, `θ > 0`, gives
  `|A_y(N)| ≤ C 2^θ (1 − p^{−θ})^{−1} (N + 1)^θ`, by summing a geometric series in `p^{−θ}`.
* **One prime** (`gaugeExponent_moebius_eq_of_agree_off`). Two gauge points that agree at every
  prime other than `p` have the same Möbius exponent.
* **Finitely many primes** (`gaugeExponent_moebius_eq_of_agree_off_finset`,
  `gaugeExponent_moebius_finiteFlip`). Every gauge point that is trivial outside a finite set of
  primes, every finite flip of the trivial point among them, has Möbius exponent `Θ`.

With the archimedean invariance (`gaugeExponent_add_verticalShift`) the exponent `Θ` is shared by the
whole class of the trivial point generated by finite modifications and vertical shifts. If RH failed,
this dense class would lie in the Haar-null exceptional set.
-/

open MeasureTheory Finset Filter Topology
open scoped ArithmeticFunction.Moebius

noncomputable section

namespace GaloisForLFunctions.ArithmeticGaugeTheory

open ArithmeticCorrelationGeometry

/-! ### Twists read prime coordinates -/

/-- The twist at `0` is one. -/
theorem twist_at_zero (y : GaugeTorus) : twist y 0 = 1 := by
  have h0 : expVec 0 = 0 := by
    ext p
    simp [expVec_apply]
  rw [twist, h0, HTGeometry.torusCharacter_zero]

/-- At a prime the twist reads exactly that coordinate. -/
theorem twist_prime_apply (y : GaugeTorus) {q : ℕ} (hq : q.Prime) :
    twist y q = fourier 1 (y q) := by
  have hv : expVec q = Finsupp.single q 1 := by
    rw [expVec, hq.factorization, Finsupp.mapRange_single, Nat.cast_one]
  rw [twist, hv, HTGeometry.torusCharacter_apply, Finsupp.support_single _ one_ne_zero,
    prod_singleton, Finsupp.single_eq_same]

/-- Two gauge points that agree at the primes dividing `n` agree at `n`. -/
theorem twist_eq_of_primes {x x' : GaugeTorus} {n : ℕ} (hn : n ≠ 0)
    (h : ∀ q, q.Prime → q ∣ n → twist x' q = twist x q) : twist x' n = twist x n := by
  induction n using Nat.recOnMul with
  | zero => exact absurd rfl hn
  | one => rw [twist_one, twist_one]
  | prime q hq => exact h q hq dvd_rfl
  | mul a b ha hb =>
    have ha0 := left_ne_zero_of_mul hn
    have hb0 := right_ne_zero_of_mul hn
    rw [twist_mul x' ha0 hb0, twist_mul x ha0 hb0,
      ha ha0 fun q hq hqa => h q hq (hqa.trans (dvd_mul_right a b)),
      hb hb0 fun q hq hqb => h q hq (hqb.trans (dvd_mul_left b a))]

/-! ### Splitting off one prime -/

/-- The twisted Möbius sum over the integers in `[1, N]` prime to `p`. -/
def coprimeMoebiusSum (p : ℕ) (y : GaugeTorus) (N : ℕ) : ℂ :=
  ∑ n ∈ (Icc 1 N).filter (fun n => ¬ p ∣ n), ((μ n : ℤ) : ℂ) * twist y n

/-- `μ(pm) = −μ(m)` when `p ∤ m`, and `0` when `p ∣ m`. -/
theorem moebius_prime_mul {p m : ℕ} (hp : p.Prime) :
    ((μ (p * m) : ℤ) : ℂ) = if p ∣ m then 0 else -((μ m : ℤ) : ℂ) := by
  split_ifs with h
  · have hns : ¬ Squarefree (p * m) := fun hsq =>
      hp.not_isUnit (hsq p (mul_dvd_mul_left p h))
    rw [ArithmeticFunction.moebius_eq_zero_of_not_squarefree hns, Int.cast_zero]
  · have hcop : Nat.Coprime p m := (Nat.Prime.coprime_iff_not_dvd hp).mpr h
    rw [ArithmeticFunction.isMultiplicative_moebius.map_mul_of_coprime hcop,
      ArithmeticFunction.moebius_apply_prime hp]
    push_cast
    ring

/-- The multiples of `p` in `[1, N]` are `p · [1, ⌊N/p⌋]`. -/
theorem image_mul_Icc {p : ℕ} (hp : 0 < p) (N : ℕ) :
    (Icc 1 (N / p)).image (fun m => p * m) = (Icc 1 N).filter (fun n => p ∣ n) := by
  ext n
  simp only [mem_image, mem_Icc, mem_filter]
  constructor
  · rintro ⟨m, ⟨hm1, hmN⟩, rfl⟩
    refine ⟨⟨Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero hp.ne' (by omega)), ?_⟩, dvd_mul_right p m⟩
    rw [mul_comm]
    exact (Nat.le_div_iff_mul_le hp).mp hmN
  · rintro ⟨⟨hn1, hnN⟩, m, rfl⟩
    refine ⟨m, ⟨Nat.one_le_iff_ne_zero.mpr fun hm => by simp [hm] at hn1, ?_⟩, rfl⟩
    rw [Nat.le_div_iff_mul_le hp, mul_comm]
    exact hnN

/-- **Splitting off one prime.** `S_y(N) = A_y(N) − χ_y(p) A_y(⌊N/p⌋)`. -/
theorem moebiusGaugeSum_eq_split {p : ℕ} (hp : p.Prime) (y : GaugeTorus) (N : ℕ) :
    moebiusGaugeSum N y = coprimeMoebiusSum p y N - twist y p * coprimeMoebiusSum p y (N / p) := by
  classical
  have hmult : ∑ n ∈ (Icc 1 N).filter (fun n => p ∣ n), ((μ n : ℤ) : ℂ) * twist y n =
      -(twist y p * coprimeMoebiusSum p y (N / p)) := by
    rw [← image_mul_Icc hp.pos, sum_image fun a _ b _ hab => Nat.eq_of_mul_eq_mul_left hp.pos hab,
      coprimeMoebiusSum, sum_filter, mul_sum, ← sum_neg_distrib]
    refine sum_congr rfl fun m hm => ?_
    have hm0 : m ≠ 0 := Nat.one_le_iff_ne_zero.mp (mem_Icc.mp hm).1
    rw [moebius_prime_mul hp, twist_mul y hp.ne_zero hm0]
    split_ifs <;> ring
  rw [moebiusGaugeSum, ← sum_filter_add_sum_filter_not (Icc 1 N) (fun n => p ∣ n), hmult]
  unfold coprimeMoebiusSum
  ring

/-- **Inversion.** `A_y(N) = Σ_{k < K} χ_y(p)^k S_y(⌊N/p^k⌋) + χ_y(p)^K A_y(⌊N/p^K⌋)` for every
`K`. -/
theorem coprimeMoebiusSum_eq_partial {p : ℕ} (hp : p.Prime) (y : GaugeTorus) (N : ℕ) :
    ∀ K : ℕ, coprimeMoebiusSum p y N = ∑ k ∈ range K, twist y p ^ k * moebiusGaugeSum (N / p ^ k) y +
      twist y p ^ K * coprimeMoebiusSum p y (N / p ^ K) := by
  intro K
  induction K with
  | zero => simp
  | succ K ih =>
    have hsplit := moebiusGaugeSum_eq_split hp y (N / p ^ K)
    rw [Nat.div_div_eq_div_mul, ← pow_succ] at hsplit
    rw [ih, Finset.sum_range_succ, pow_succ]
    linear_combination (-(twist y p ^ K)) * hsplit

/-- The coprime sum at `0` vanishes. -/
@[simp] theorem coprimeMoebiusSum_zero (p : ℕ) (y : GaugeTorus) : coprimeMoebiusSum p y 0 = 0 := by
  simp [coprimeMoebiusSum]

/-- **Inversion**, closed form: `A_y(N) = Σ_{k ≤ N} χ_y(p)^k S_y(⌊N/p^k⌋)`. -/
theorem coprimeMoebiusSum_eq_sum {p : ℕ} (hp : p.Prime) (y : GaugeTorus) (N : ℕ) :
    coprimeMoebiusSum p y N = ∑ k ∈ range (N + 1), twist y p ^ k * moebiusGaugeSum (N / p ^ k) y := by
  have hlt : N < p ^ (N + 1) :=
    (Nat.lt_pow_self hp.one_lt (n := N)).trans (Nat.pow_lt_pow_right hp.one_lt (Nat.lt_succ_self N))
  rw [coprimeMoebiusSum_eq_partial hp y N (N + 1), Nat.div_eq_of_lt hlt, coprimeMoebiusSum_zero,
    mul_zero, add_zero]

/-- **The coprime part forgets `p`.** -/
theorem coprimeMoebiusSum_congr {p : ℕ} {x x' : GaugeTorus}
    (h : ∀ q, q.Prime → q ≠ p → twist x' q = twist x q) (N : ℕ) :
    coprimeMoebiusSum p x' N = coprimeMoebiusSum p x N := by
  refine sum_congr rfl fun n hn => ?_
  obtain ⟨hnI, hpn⟩ := mem_filter.mp hn
  have hn0 : n ≠ 0 := Nat.one_le_iff_ne_zero.mp (mem_Icc.mp hnI).1
  rw [twist_eq_of_primes hn0 fun q hq hqn => h q hq fun hqp => hpn (hqp ▸ hqn)]

/-! ### Bounds -/

/-- The twisted Möbius sum at `0` vanishes. -/
@[simp] theorem moebiusGaugeSum_zero (y : GaugeTorus) : moebiusGaugeSum 0 y = 0 := by
  simp [moebiusGaugeSum]

/-- A single term of the inversion is geometric in `p^{−θ}`. -/
theorem norm_moebiusGaugeSum_div_pow_le {p : ℕ} (hp : p.Prime) {y : GaugeTorus} {C θ : ℝ}
    (hθ : 0 < θ) (hC : 0 ≤ C) (hS : ∀ M, ‖moebiusGaugeSum M y‖ ≤ C * ((M : ℝ) + 1) ^ θ)
    (N k : ℕ) :
    ‖moebiusGaugeSum (N / p ^ k) y‖ ≤
      C * 2 ^ θ * ((N : ℝ) + 1) ^ θ * ((p : ℝ) ^ (-θ)) ^ k := by
  have hp0 : (0 : ℝ) < p := by exact_mod_cast hp.pos
  have hpk : (0 : ℝ) < (p : ℝ) ^ k := pow_pos hp0 k
  have hrhs : 0 ≤ C * 2 ^ θ * ((N : ℝ) + 1) ^ θ * ((p : ℝ) ^ (-θ)) ^ k := by positivity
  rcases Nat.eq_zero_or_pos (N / p ^ k) with hM | hM
  · rw [hM, moebiusGaugeSum_zero, norm_zero]
    exact hrhs
  · set M := N / p ^ k with hMdef
    have hM1 : (1 : ℝ) ≤ M := by exact_mod_cast hM
    -- `M + 1 ≤ 2M ≤ 2(N + 1)/p^k`.
    have hMle : (M : ℝ) ≤ ((N : ℝ) + 1) / (p : ℝ) ^ k := by
      have h1 : (M : ℝ) ≤ (N : ℝ) / ((p ^ k : ℕ) : ℝ) := Nat.cast_div_le
      have h2 : (N : ℝ) / ((p ^ k : ℕ) : ℝ) ≤ ((N : ℝ) + 1) / (p : ℝ) ^ k := by
        push_cast
        exact div_le_div_of_nonneg_right (by linarith) hpk.le
      linarith
    have hbase : (M : ℝ) + 1 ≤ 2 * (((N : ℝ) + 1) / (p : ℝ) ^ k) := by linarith
    have hpow : ((M : ℝ) + 1) ^ θ ≤ (2 * (((N : ℝ) + 1) / (p : ℝ) ^ k)) ^ θ :=
      Real.rpow_le_rpow (by positivity) hbase hθ.le
    have hsplit : (2 * (((N : ℝ) + 1) / (p : ℝ) ^ k)) ^ θ =
        2 ^ θ * ((N : ℝ) + 1) ^ θ * ((p : ℝ) ^ (-θ)) ^ k := by
      rw [Real.mul_rpow (by norm_num) (by positivity), Real.div_rpow (by positivity) hpk.le,
        Real.rpow_neg hp0.le, inv_pow, ← Real.rpow_pow_comm hp0.le]
      field_simp
    calc ‖moebiusGaugeSum M y‖ ≤ C * ((M : ℝ) + 1) ^ θ := hS M
      _ ≤ C * (2 * (((N : ℝ) + 1) / (p : ℝ) ^ k)) ^ θ := mul_le_mul_of_nonneg_left hpow hC
      _ = C * 2 ^ θ * ((N : ℝ) + 1) ^ θ * ((p : ℝ) ^ (-θ)) ^ k := by rw [hsplit]; ring

/-- **Bounds transfer to the coprime part.** -/
theorem norm_coprimeMoebiusSum_le {p : ℕ} (hp : p.Prime) {y : GaugeTorus} {C θ : ℝ}
    (hθ : 0 < θ) (hC : 0 ≤ C) (hS : ∀ M, ‖moebiusGaugeSum M y‖ ≤ C * ((M : ℝ) + 1) ^ θ)
    (N : ℕ) :
    ‖coprimeMoebiusSum p y N‖ ≤ C * 2 ^ θ * (1 - (p : ℝ) ^ (-θ))⁻¹ * ((N : ℝ) + 1) ^ θ := by
  have hp1 : (1 : ℝ) < p := by exact_mod_cast hp.one_lt
  set r : ℝ := (p : ℝ) ^ (-θ) with hr
  have hr0 : 0 ≤ r := Real.rpow_nonneg (by linarith) _
  have hr1 : r < 1 := Real.rpow_lt_one_of_one_lt_of_neg hp1 (by linarith)
  have hgeom : ∑ k ∈ range (N + 1), r ^ k ≤ (1 - r)⁻¹ := by
    rw [geom_sum_eq hr1.ne, div_le_iff_of_neg (by linarith : r - 1 < 0)]
    have hne : (1 : ℝ) - r ≠ 0 := by linarith
    have hm : (1 - r)⁻¹ * (r - 1) = -1 := by
      rw [show r - 1 = -(1 - r) by ring, mul_neg, inv_mul_cancel₀ hne]
    rw [hm]
    linarith [pow_nonneg hr0 (N + 1)]
  rw [coprimeMoebiusSum_eq_sum hp y N]
  have hK : 0 ≤ C * 2 ^ θ * ((N : ℝ) + 1) ^ θ := by positivity
  calc ‖∑ k ∈ range (N + 1), twist y p ^ k * moebiusGaugeSum (N / p ^ k) y‖
      ≤ ∑ k ∈ range (N + 1), ‖twist y p ^ k * moebiusGaugeSum (N / p ^ k) y‖ := norm_sum_le _ _
    _ ≤ ∑ k ∈ range (N + 1), C * 2 ^ θ * ((N : ℝ) + 1) ^ θ * r ^ k := by
        refine sum_le_sum fun k _ => ?_
        rw [norm_mul, norm_pow, norm_twist, one_pow, one_mul]
        exact norm_moebiusGaugeSum_div_pow_le hp hθ hC hS N k
    _ = C * 2 ^ θ * ((N : ℝ) + 1) ^ θ * ∑ k ∈ range (N + 1), r ^ k := by rw [mul_sum]
    _ ≤ C * 2 ^ θ * ((N : ℝ) + 1) ^ θ * (1 - r)⁻¹ := mul_le_mul_of_nonneg_left hgeom hK
    _ = C * 2 ^ θ * (1 - r)⁻¹ * ((N : ℝ) + 1) ^ θ := by ring

/-! ### Invariance -/

/-- Power bounds in `range` form are power bounds of `moebiusGaugeSum`. -/
theorem gaugePowerBound_moebius_iff {y : GaugeTorus} {θ : ℝ} :
    GaugePowerBound moebiusSource y θ ↔
      ∃ C : ℝ, 0 ≤ C ∧ ∀ N : ℕ, ‖moebiusGaugeSum N y‖ ≤ C * ((N : ℝ) + 1) ^ θ := by
  simp only [GaugePowerBound, sum_range_moebiusSource]

/-- **One prime.** A power bound of positive exponent survives a change of the gauge point at one
prime. -/
theorem gaugePowerBound_moebius_of_agree_off {p : ℕ} (hp : p.Prime) {x x' : GaugeTorus}
    (h : ∀ q, q.Prime → q ≠ p → twist x' q = twist x q) {θ : ℝ} (hθ : 0 < θ)
    (hb : GaugePowerBound moebiusSource x θ) : GaugePowerBound moebiusSource x' θ := by
  rw [gaugePowerBound_moebius_iff] at hb ⊢
  obtain ⟨C, hC, hS⟩ := hb
  set D := C * 2 ^ θ * (1 - (p : ℝ) ^ (-θ))⁻¹ with hD
  have hr1 : (p : ℝ) ^ (-θ) < 1 :=
    Real.rpow_lt_one_of_one_lt_of_neg (by exact_mod_cast hp.one_lt) (by linarith)
  have hD0 : 0 ≤ D := by
    have : 0 ≤ (1 - (p : ℝ) ^ (-θ))⁻¹ := inv_nonneg.mpr (by linarith)
    positivity
  refine ⟨2 * D, by positivity, fun N => ?_⟩
  rw [moebiusGaugeSum_eq_split hp, coprimeMoebiusSum_congr h, coprimeMoebiusSum_congr h]
  have hA := norm_coprimeMoebiusSum_le hp hθ hC hS N
  have hA' := norm_coprimeMoebiusSum_le hp hθ hC hS (N / p)
  have hNp : ((N / p : ℕ) : ℝ) + 1 ≤ (N : ℝ) + 1 := by
    have : (N / p : ℕ) ≤ N := Nat.div_le_self N p
    have : ((N / p : ℕ) : ℝ) ≤ N := by exact_mod_cast this
    linarith
  have hpow : (((N / p : ℕ) : ℝ) + 1) ^ θ ≤ ((N : ℝ) + 1) ^ θ :=
    Real.rpow_le_rpow (by positivity) hNp hθ.le
  calc ‖coprimeMoebiusSum p x N - twist x' p * coprimeMoebiusSum p x (N / p)‖
      ≤ ‖coprimeMoebiusSum p x N‖ + ‖twist x' p * coprimeMoebiusSum p x (N / p)‖ := norm_sub_le _ _
    _ ≤ D * ((N : ℝ) + 1) ^ θ + D * ((N : ℝ) + 1) ^ θ := by
        rw [norm_mul, norm_twist, one_mul]
        exact add_le_add hA (hA'.trans (mul_le_mul_of_nonneg_left hpow hD0))
    _ = 2 * D * ((N : ℝ) + 1) ^ θ := by ring

/-- **One prime does not move the exponent.** -/
theorem gaugeExponent_moebius_eq_of_agree_off {p : ℕ} (hp : p.Prime) {x x' : GaugeTorus}
    (h : ∀ q, q.Prime → q ≠ p → twist x' q = twist x q) :
    gaugeExponent moebiusSource x' = gaugeExponent moebiusSource x := by
  have hle : ∀ {y y' : GaugeTorus}, (∀ q, q.Prime → q ≠ p → twist y' q = twist y q) →
      gaugeExponent moebiusSource y' ≤ gaugeExponent moebiusSource y := by
    intro y y' hyy
    refine le_of_forall_gt fun θ hθ => ?_
    obtain ⟨θ', hθ'1, hθ'2⟩ := exists_between hθ
    have hθ'0 : 0 < θ' := lt_of_le_of_lt (gaugeExponent_nonneg norm_moebiusSource_le) hθ'1
    exact lt_of_le_of_lt (gaugeExponent_le hθ'0.le (gaugePowerBound_moebius_of_agree_off hp hyy
      hθ'0 (gaugePowerBound_of_gaugeExponent_lt norm_moebiusSource_le hθ'1))) hθ'2
  exact le_antisymm (hle h) (hle fun q hq hqp => (h q hq hqp).symm)

/-- **Finitely many primes do not move the exponent.** -/
theorem gaugeExponent_moebius_eq_of_agree_off_finset (F : Finset ℕ) :
    ∀ {x x' : GaugeTorus}, (∀ q, q.Prime → q ∉ F → twist x' q = twist x q) →
      gaugeExponent moebiusSource x' = gaugeExponent moebiusSource x := by
  classical
  induction F using Finset.induction_on with
  | empty =>
    intro x x' h
    have hall : ∀ n, twist x' n = twist x n := by
      intro n
      rcases Nat.eq_zero_or_pos n with rfl | hn
      · rw [twist_at_zero, twist_at_zero]
      · exact twist_eq_of_primes hn.ne' fun q hq _ => h q hq (Finset.notMem_empty q)
    unfold gaugeExponent exponentSet
    congr 1
    ext θ
    simp only [Set.mem_setOf_eq, GaugePowerBound, hall]
  | insert p F hpF ih =>
    intro x x' h
    -- Move `x'` to `x` at the coordinate `p` first.
    set z : GaugeTorus := Function.update x' p (x p) with hz
    have hzx : ∀ q, q.Prime → q ∉ F → twist z q = twist x q := by
      intro q hq hqF
      by_cases hqp : q = p
      · subst hqp
        rw [twist_prime_apply z hq, twist_prime_apply x hq, hz, Function.update_self]
      · rw [twist_prime_apply z hq, hz, Function.update_of_ne hqp, ← twist_prime_apply x' hq]
        exact h q hq (by simp [hqp, hqF])
    have hzx' : gaugeExponent moebiusSource x' = gaugeExponent moebiusSource z := by
      by_cases hp : p.Prime
      · refine gaugeExponent_moebius_eq_of_agree_off hp fun q hq hqp => ?_
        rw [twist_prime_apply z hq, twist_prime_apply x' hq, hz, Function.update_of_ne hqp]
      · -- If `p` is not prime, the two points agree at every prime.
        have hagree : ∀ q, q.Prime → q ∉ (∅ : Finset ℕ) → twist x' q = twist z q := by
          intro q hq _
          have hqp : q ≠ p := fun hqp => hp (hqp ▸ hq)
          rw [twist_prime_apply z hq, twist_prime_apply x' hq, hz, Function.update_of_ne hqp]
        have hall : ∀ n, twist x' n = twist z n := by
          intro n
          rcases Nat.eq_zero_or_pos n with rfl | hn
          · rw [twist_at_zero, twist_at_zero]
          · exact twist_eq_of_primes hn.ne' fun q hq _ => hagree q hq (Finset.notMem_empty q)
        unfold gaugeExponent exponentSet
        congr 1
        ext θ
        simp only [Set.mem_setOf_eq, GaugePowerBound, hall]
    rw [hzx', ih hzx]

/-- **Finite flips of the trivial point.** Every gauge point that is trivial at all primes outside
a finite set has Möbius exponent `Θ`. -/
theorem gaugeExponent_moebius_finiteFlip (F : Finset ℕ) {x : GaugeTorus}
    (h : ∀ q, q.Prime → q ∉ F → twist x q = 1) :
    gaugeExponent moebiusSource x = RHTower.zetaZeroAbscissa := by
  rw [gaugeExponent_moebius_eq_of_agree_off_finset F (x := 0) fun q hq hqF => by
    rw [h q hq hqF, twist_zero], gaugeExponent_moebius_trivial]

end GaloisForLFunctions.ArithmeticGaugeTheory
