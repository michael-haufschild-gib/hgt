import GaloisForLFunctions.ArithmeticGaugeTheory.TheGaugeExponentIsATailInvariant

/-!
# The Liouville points have exponent one

A twin tail keeps finitely many coordinates of a gauge point and puts the Liouville sign `−1` at
every other prime (`ArithmeticCorrelationGeometry.twinTail`). Its twisted Möbius sums grow linearly
with a nonzero slope (`tendsto_moebiusGaugeSum_twinTail_div`, `sum_tailWeight_div_ne_zero`): the
twisted series carries the pole of `ζ(s)/ζ(2s)`.

* **Twin tails** (`gaugeExponent_moebius_twinTail`). Every twin tail has Möbius exponent exactly
  `1`, the largest value for a bounded source.
* **The Liouville point** (`gaugeExponent_moebius_liouville`). Every gauge point with `χ(p) = −1` at
  all primes has exponent `1`.
* **Two dense classes** (`gaugeExponent_moebius_extremes`). The twin tails, which are dense, have
  exponent `1`; the class of the trivial point, generated by finite modifications and vertical
  shifts, has exponent `Θ`. Under RH the exponent therefore takes both extreme values `1/2` and `1` on
  dense sets.

* **Finitely determined certificates** (`one_le_of_cylinder_bound`). A bound on the exponent that
  reads only finitely many coordinates is at least `1` everywhere.

In the Diophantine analogy the twin tails are the Liouville numbers of the gauge torus: they agree
with a given point on finitely many primes and are then as far from typical as a bounded source
can be.
-/

open MeasureTheory Finset Filter Topology

noncomputable section

namespace GaloisForLFunctions.ArithmeticGaugeTheory

open ArithmeticCorrelationGeometry

/-- **Twin tails have exponent one.** -/
theorem gaugeExponent_moebius_twinTail (I : Finset ℕ) (x₀ : GaugeTorus) :
    gaugeExponent moebiusSource (twinTail I x₀) = 1 := by
  refine le_antisymm (gaugeExponent_le_one norm_moebiusSource_le) ?_
  by_contra hlt
  push Not at hlt
  obtain ⟨θ, hθ1, hθ2⟩ := exists_between hlt
  obtain ⟨C, hC, hb⟩ := (gaugePowerBound_moebius_iff).mp
    (gaugePowerBound_of_gaugeExponent_lt norm_moebiusSource_le hθ1)
  set L := (BezoutValuationIncidence.coprimeSquarefreeDensity (tailModulus I) : ℂ) *
    ∑ d ∈ (tailModulus I).divisors, tailWeight x₀ d / (d : ℂ)
  have hdens : 0 < BezoutValuationIncidence.coprimeSquarefreeDensity (tailModulus I) := by
    rw [BezoutValuationIncidence.coprimeSquarefreeDensity]
    refine mul_pos (by rw [RHTower.Sieve.squarefreeDensity_eq]; positivity)
      (prod_pos fun p hp => div_pos (by exact_mod_cast (Nat.prime_of_mem_primeFactors hp).pos)
        (by positivity))
  have hL : L ≠ 0 := mul_ne_zero (by exact_mod_cast hdens.ne') (sum_tailWeight_div_ne_zero I x₀)
  have hLpos : 0 < ‖L‖ := norm_pos_iff.mpr hL
  have hlim := tendsto_moebiusGaugeSum_twinTail_div I x₀
  -- Eventually `‖S_N‖ ≥ ‖L‖ N / 2`, while `‖S_N‖ ≤ C (N + 1)^θ` with `θ < 1`.
  have hgrow : Tendsto (fun N : ℕ => ((N : ℝ) + 1) ^ (1 - θ)) atTop atTop :=
    (tendsto_rpow_atTop (by linarith)).comp
      (tendsto_atTop_add_const_right _ 1 tendsto_natCast_atTop_atTop)
  obtain ⟨N, hN1, hN2, hN3⟩ := ((hlim.eventually (Metric.ball_mem_nhds L (half_pos hLpos))).and
    ((hgrow.eventually_gt_atTop (4 * (C + 1) / ‖L‖)).and (eventually_ge_atTop 1))).exists
  have hN0 : (0 : ℝ) < N := by exact_mod_cast hN3
  rw [dist_eq_norm] at hN1
  have hq : ‖L‖ / 2 ≤ ‖moebiusGaugeSum N (twinTail I x₀)‖ / N := by
    have h := norm_sub_norm_le L (moebiusGaugeSum N (twinTail I x₀) / (N : ℂ))
    rw [norm_div, Complex.norm_natCast, norm_sub_rev] at h
    linarith
  have hS := hb N
  have hX : (0 : ℝ) < (N : ℝ) + 1 := by linarith
  -- `(N + 1)^θ (N + 1)^{1−θ} = N + 1 ≤ 2N`.
  have hsplit : ((N : ℝ) + 1) ^ θ * ((N : ℝ) + 1) ^ (1 - θ) = (N : ℝ) + 1 := by
    rw [← Real.rpow_add hX, add_sub_cancel, Real.rpow_one]
  have hlow : ‖L‖ / 2 * N ≤ C * ((N : ℝ) + 1) ^ θ := by
    rw [le_div_iff₀ hN0] at hq
    linarith
  have hpowpos : 0 < ((N : ℝ) + 1) ^ θ := Real.rpow_pos_of_pos hX θ
  have hbig : 4 * (C + 1) < ‖L‖ * ((N : ℝ) + 1) ^ (1 - θ) := by
    rw [div_lt_iff₀ hLpos] at hN2
    linarith
  have hkey : ‖L‖ * ((N : ℝ) + 1) ≤ 4 * C * ((N : ℝ) + 1) ^ θ := by
    have : (N : ℝ) + 1 ≤ 2 * N := by
      have : (1 : ℝ) ≤ N := by exact_mod_cast hN3
      linarith
    nlinarith
  have h3 : 4 * (C + 1) * ((N : ℝ) + 1) ^ θ < ‖L‖ * ((N : ℝ) + 1) := by
    calc 4 * (C + 1) * ((N : ℝ) + 1) ^ θ
        < ‖L‖ * ((N : ℝ) + 1) ^ (1 - θ) * ((N : ℝ) + 1) ^ θ := mul_lt_mul_of_pos_right hbig hpowpos
      _ = ‖L‖ * (((N : ℝ) + 1) ^ θ * ((N : ℝ) + 1) ^ (1 - θ)) := by ring
      _ = ‖L‖ * ((N : ℝ) + 1) := by rw [hsplit]
  nlinarith

/-- **The Liouville point has exponent one.** -/
theorem gaugeExponent_moebius_liouville {y : GaugeTorus}
    (hy : ∀ p, p.Prime → twist y p = -1) : gaugeExponent moebiusSource y = 1 := by
  rw [gaugeExponent_moebius_eq_of_agree_off_finset ∅ (x := twinTail ∅ 0) fun q hq _ => ?_,
    gaugeExponent_moebius_twinTail]
  have hcoord : twinTail ∅ 0 q = ((1 / 2 : ℝ) : UnitAddCircle) := by simp [twinTail, hq]
  rw [hy q hq, twist_prime_apply _ hq, hcoord, fourier_one_half]

/-- **Two dense classes with extreme exponents.** Twin tails have exponent `1`; the class of the
trivial point has exponent `Θ`. -/
theorem gaugeExponent_moebius_extremes (I F : Finset ℕ) (x₀ x : GaugeTorus)
    (hx : ∀ q, q.Prime → q ∉ F → twist x q = 1) :
    gaugeExponent moebiusSource (twinTail I x₀) = 1 ∧
      gaugeExponent moebiusSource x = RHTower.zetaZeroAbscissa :=
  ⟨gaugeExponent_moebius_twinTail I x₀, gaugeExponent_moebius_finiteFlip F hx⟩

/-- A twin tail keeps the coordinates of its finite set. -/
theorem twinTail_apply_of_mem {I : Finset ℕ} (x₀ : GaugeTorus) {i : ℕ} (hi : i ∈ I) :
    twinTail I x₀ i = x₀ i := by
  simp [twinTail, hi]

/-- **Finitely determined certificates are useless.** A bound on the Möbius exponent that depends
only on the coordinates in a finite set `I` is at least `1` at every point: the twin tail of the
point agrees with it on `I` and has exponent `1`. -/
theorem one_le_of_cylinder_bound (I : Finset ℕ) (Φ : GaugeTorus → ℝ)
    (hΦ : ∀ x y : GaugeTorus, (∀ i ∈ I, x i = y i) → Φ x = Φ y)
    (hb : ∀ x : GaugeTorus, gaugeExponent moebiusSource x ≤ Φ x) (x : GaugeTorus) : 1 ≤ Φ x := by
  have hagree : Φ (twinTail I x) = Φ x :=
    hΦ _ _ fun i hi => twinTail_apply_of_mem x hi
  have := hb (twinTail I x)
  rw [gaugeExponent_moebius_twinTail, hagree] at this
  exact this

end GaloisForLFunctions.ArithmeticGaugeTheory
