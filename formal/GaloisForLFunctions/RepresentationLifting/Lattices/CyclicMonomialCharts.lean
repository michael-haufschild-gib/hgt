import Mathlib.Algebra.MvPolynomial.Equiv
import Mathlib.Algebra.Group.Submonoid.Membership
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.Ring

/-!
# Smooth cyclic quotient charts from monomial borders

For the cyclic weights `(1,a,b)` modulo `n`, take the monomial graph
`1,x,...,x^(n-1)`. Its discrepancy semigroup is freely generated by
`x^n`, `y/x^a`, and `z/x^b`. Integer division gives explicit nonnegative
coordinates for every discrepancy. Consequently the chart algebra is a
three-variable polynomial algebra over every commutative coefficient semiring.

The semigroup is also exactly the invariant character lattice intersected
with its three defining nonnegative half-spaces; in particular it is saturated.
This applies the border-generation and chart-algebra mechanisms of Kaijima,
*G-Hilbert schemes of canonical abelian quotient threefolds*, Lemmas 2.6–2.7,
to all cyclic weights with a faithful first coordinate.
-/

noncomputable section
namespace GaloisForLFunctions.RepresentationLifting.CyclicChart

variable (n : ℕ) (a b : Fin n)

/-- Difference between a monomial exponent and its representative among powers of x. -/
def defect (u : Fin 3 → ℕ) : Fin 3 → ℤ :=
  ![(u 0 : ℤ) - ((u 0 + a.val * u 1 + b.val * u 2) % n : ℕ), u 1, u 2]

/-- The semigroup of invariant discrepancies of the monomial graph. -/
def semigroup : AddSubmonoid (Fin 3 → ℤ) := AddSubmonoid.closure (Set.range (defect n a b))

/-- Coordinates in the three border generators x^n, y/x^a, and z/x^b. -/
def coordinates : (Fin 3 → ℕ) →+ (Fin 3 → ℤ) where
  toFun c := ![(n : ℤ) * c 0 - (a.val : ℤ) * c 1 - (b.val : ℤ) * c 2, c 1, c 2]
  map_zero' := by ext i; fin_cases i <;> simp
  map_add' c d := by ext i; fin_cases i <;> simp; ring

/-- Division by the character modulus gives nonnegative border coordinates. -/
theorem defect_coordinates (u : Fin 3 → ℕ) :
    defect n a b u =
      coordinates n a b ![(u 0 + a.val * u 1 + b.val * u 2) / n, u 1, u 2] := by
  have h := Nat.div_add_mod (u 0 + a.val * u 1 + b.val * u 2) n
  have hz : (n : ℤ) * ((u 0 + a.val * u 1 + b.val * u 2) / n : ℕ) +
      ((u 0 + a.val * u 1 + b.val * u 2) % n : ℕ) =
      (u 0 : ℤ) + (a.val : ℤ) * u 1 + (b.val : ℤ) * u 2 := by exact_mod_cast h
  ext i
  fin_cases i
  · change (u 0 : ℤ) - ((u 0 + a.val * u 1 + b.val * u 2) % n : ℕ) =
      (n : ℤ) * ((u 0 + a.val * u 1 + b.val * u 2) / n : ℕ) -
        (a.val : ℤ) * u 1 - (b.val : ℤ) * u 2
    linarith only [hz]
  · rfl
  · rfl

private theorem generator_zero_mem : coordinates n a b ![1, 0, 0] ∈ semigroup n a b := by
  have h : defect n a b ![n, 0, 0] = coordinates n a b ![1, 0, 0] := by
    ext i; fin_cases i <;> simp [defect, coordinates]
  rw [← h]
  exact AddSubmonoid.subset_closure ⟨_, rfl⟩

private theorem generator_one_mem : coordinates n a b ![0, 1, 0] ∈ semigroup n a b := by
  have h : defect n a b ![0, 1, 0] = coordinates n a b ![0, 1, 0] := by
    ext i; fin_cases i <;> simp [defect, coordinates, Nat.mod_eq_of_lt a.isLt]
  rw [← h]
  exact AddSubmonoid.subset_closure ⟨_, rfl⟩

private theorem generator_two_mem : coordinates n a b ![0, 0, 1] ∈ semigroup n a b := by
  have h : defect n a b ![0, 0, 1] = coordinates n a b ![0, 0, 1] := by
    ext i; fin_cases i <;> simp [defect, coordinates, Nat.mod_eq_of_lt b.isLt]
  rw [← h]
  exact AddSubmonoid.subset_closure ⟨_, rfl⟩

/-- Every nonnegative border combination belongs to the discrepancy semigroup. -/
theorem coordinates_mem (c : Fin 3 → ℕ) : coordinates n a b c ∈ semigroup n a b := by
  have hc : coordinates n a b c = c 0 • coordinates n a b ![1, 0, 0] +
      c 1 • coordinates n a b ![0, 1, 0] + c 2 • coordinates n a b ![0, 0, 1] := by
    ext i; fin_cases i <;> simp [coordinates]; ring
  rw [hc]
  exact (semigroup n a b).add_mem
    ((semigroup n a b).add_mem
      ((semigroup n a b).nsmul_mem (generator_zero_mem n a b) (c 0))
      ((semigroup n a b).nsmul_mem (generator_one_mem n a b) (c 1)))
    ((semigroup n a b).nsmul_mem (generator_two_mem n a b) (c 2))

/-- The finite border generates every discrepancy, with no cone-dimension assumption. -/
theorem semigroup_eq_range : semigroup n a b = AddMonoidHom.mrange (coordinates n a b) := by
  apply le_antisymm
  · apply AddSubmonoid.closure_le.mpr
    rintro _ ⟨u, rfl⟩
    exact ⟨_, (defect_coordinates n a b u).symm⟩
  · rintro _ ⟨c, rfl⟩
    exact coordinates_mem n a b c

/-- Border coordinates are unique. -/
theorem coordinates_injective : Function.Injective (coordinates n a b) := by
  intro c d h
  have h0 := congrFun h 0
  have h1 : (c 1 : ℤ) = (d 1 : ℤ) := congrFun h 1
  have h2 : (c 2 : ℤ) = (d 2 : ℤ) := congrFun h 2
  have hc1 : c 1 = d 1 := Int.ofNat_inj.mp h1
  have hc2 : c 2 = d 2 := Int.ofNat_inj.mp h2
  have hn : (n : ℤ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt (lt_of_le_of_lt (Nat.zero_le a.val) a.isLt))
  have hc0 : c 0 = d 0 := by
    change (n : ℤ) * c 0 - (a.val : ℤ) * c 1 - (b.val : ℤ) * c 2 =
      (n : ℤ) * d 0 - (a.val : ℤ) * d 1 - (b.val : ℤ) * d 2 at h0
    rw [hc1, hc2] at h0
    have hm : (n : ℤ) * c 0 = (n : ℤ) * d 0 := by linarith only [h0]
    exact Int.ofNat_inj.mp (mul_left_cancel₀ hn hm)
  ext i
  fin_cases i <;> assumption

/-- The semigroup is exactly the nonnegative cone inside the invariant character lattice. -/
theorem mem_semigroup_iff (x : Fin 3 → ℤ) :
    x ∈ semigroup n a b ↔ 0 ≤ x 1 ∧ 0 ≤ x 2 ∧
      0 ≤ x 0 + a.val * x 1 + b.val * x 2 ∧
      (n : ℤ) ∣ x 0 + a.val * x 1 + b.val * x 2 := by
  rw [semigroup_eq_range]
  constructor
  · rintro ⟨c, rfl⟩
    change 0 ≤ (c 1 : ℤ) ∧ 0 ≤ (c 2 : ℤ) ∧
      0 ≤ ((n : ℤ) * c 0 - a.val * c 1 - b.val * c 2) + a.val * c 1 + b.val * c 2 ∧
      (n : ℤ) ∣ ((n : ℤ) * c 0 - a.val * c 1 - b.val * c 2) + a.val * c 1 + b.val * c 2
    have he : ((n : ℤ) * c 0 - a.val * c 1 - b.val * c 2) + a.val * c 1 + b.val * c 2 =
        (n : ℤ) * c 0 := by ring
    rw [he]
    exact ⟨Int.natCast_nonneg _, Int.natCast_nonneg _,
      mul_nonneg (Int.natCast_nonneg _) (Int.natCast_nonneg _), dvd_mul_right _ _⟩
  · rintro ⟨h1, h2, hw, q, hq⟩
    have hn : (0 : ℤ) < n := by exact_mod_cast (lt_of_le_of_lt (Nat.zero_le a.val) a.isLt)
    have hq0 : 0 ≤ q := by nlinarith only [hw, hq, hn]
    refine ⟨![q.toNat, (x 1).toNat, (x 2).toNat], ?_⟩
    ext i
    fin_cases i
    · change (n : ℤ) * (q.toNat : ℤ) - a.val * ((x 1).toNat : ℤ) -
        b.val * ((x 2).toNat : ℤ) = x 0
      rw [Int.toNat_of_nonneg hq0, Int.toNat_of_nonneg h1, Int.toNat_of_nonneg h2]
      linarith only [hq]
    · exact Int.toNat_of_nonneg h1
    · exact Int.toNat_of_nonneg h2

/-- No lattice holes appear after taking a positive multiple. -/
theorem saturated (x : Fin 3 → ℤ) (q : ℕ) (hq : 0 < q)
    (hx : (n : ℤ) ∣ x 0 + a.val * x 1 + b.val * x 2) :
    q • x ∈ semigroup n a b ↔ x ∈ semigroup n a b := by
  constructor
  · intro h
    obtain ⟨h1, h2, hw, _⟩ := (mem_semigroup_iff n a b (q • x)).mp h
    have hqZ : (0 : ℤ) < q := by exact_mod_cast hq
    simp only [Pi.smul_apply, nsmul_eq_mul] at h1 h2 hw
    apply (mem_semigroup_iff n a b x).mpr
    refine ⟨nonneg_of_mul_nonneg_right h1 hqZ, nonneg_of_mul_nonneg_right h2 hqZ, ?_, hx⟩
    have he : (q : ℤ) * (x 0 + a.val * x 1 + b.val * x 2) =
        (q : ℤ) * x 0 + a.val * ((q : ℤ) * x 1) + b.val * ((q : ℤ) * x 2) := by ring
    rw [← he] at hw
    exact nonneg_of_mul_nonneg_right hw hqZ
  · intro h
    exact (semigroup n a b).nsmul_mem h q

/-- Border coordinates valued in the actual discrepancy semigroup. -/
def coordinatesInto : (Fin 3 → ℕ) →+ semigroup n a b where
  toFun c := ⟨coordinates n a b c, coordinates_mem n a b c⟩
  map_zero' := Subtype.ext (map_zero (coordinates n a b))
  map_add' c d := Subtype.ext (map_add (coordinates n a b) c d)

/-- The cyclic monomial chart has a free additive semigroup on three generators. -/
def coordinatesEquiv : (Fin 3 → ℕ) ≃+ semigroup n a b :=
  AddEquiv.ofBijective (coordinatesInto n a b) ⟨fun _ _ h =>
    coordinates_injective n a b (congrArg Subtype.val h), fun x => by
    have hx : (x : Fin 3 → ℤ) ∈ AddMonoidHom.mrange (coordinates n a b) := by
      rw [← semigroup_eq_range]
      exact x.property
    obtain ⟨c, hc⟩ := hx
    exact ⟨c, Subtype.ext hc⟩⟩

/-- The semigroup chart algebra is an actual three-variable polynomial algebra. -/
def polynomialChart (K : Type*) [CommSemiring K] :
    AddMonoidAlgebra K (semigroup n a b) ≃ₐ[K] MvPolynomial (Fin 3) K :=
  AddMonoidAlgebra.domCongr K K ((coordinatesEquiv n a b).symm.trans
    (Finsupp.linearEquivFunOnFinite ℕ ℕ (Fin 3)).toAddEquiv.symm)

#print axioms mem_semigroup_iff
#print axioms saturated
#print axioms coordinatesEquiv
#print axioms polynomialChart
#print axioms semigroup_eq_range
#print axioms coordinates_injective
end GaloisForLFunctions.RepresentationLifting.CyclicChart
