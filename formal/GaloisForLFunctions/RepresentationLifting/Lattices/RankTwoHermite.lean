import GaloisForLFunctions.HTGeometry.SingularIntegralCokernel
import GaloisForLFunctions.HTGeometry.SmithNormalFormMatrix

/-!
# Rank-two Hermite lattices

A finite-index sublattice of `ℤ²` has positive generators `a,d` for its
horizontal intersection and vertical projection. A lift of `d`, reduced
modulo `a`, gives the unique offset `0 ≤ b < a`. Thus its basis matrix is
`[[a,b],[0,d]]`, its index is `ad`, and index `m` leaves `a` offsets for each
divisor `a` of `m`. This is the lattice count in Section 6 of
Kurnosov–Ríos Ortiz, https://arxiv.org/abs/2611.01210.
-/

open scoped Matrix BigOperators
noncomputable section
namespace GaloisForLFunctions.RepresentationLifting.RankTwoHermite

/-- Positive triangular periods and the reduced horizontal offset. -/
structure Coordinates where
  a : ℕ
  d : ℕ
  a_pos : 0 < a
  d_pos : 0 < d
  b : Fin a

/-- The canonical basis matrix with columns `(a,0)` and `(b,d)`. -/
def matrix (c : Coordinates) : Matrix (Fin 2) (Fin 2) ℤ :=
  fun i j => if i = 0 then (if j = 0 then (c.a : ℤ) else (c.b.val : ℤ))
    else (if j = 0 then 0 else (c.d : ℤ))

/-- The sublattice generated by the canonical triangular basis. -/
def lattice (c : Coordinates) : Submodule ℤ (Fin 2 → ℤ) :=
  LinearMap.range (matrix c).mulVecLin

theorem det_matrix (c : Coordinates) : (matrix c).det = (c.a : ℤ) * (c.d : ℤ) := by
  rw [Matrix.det_fin_two]
  simp [matrix]

/-- The existing determinant-index formula gives the index of a triangular lattice. -/
theorem card_quotient (c : Coordinates) :
    Nat.card ((Fin 2 → ℤ) ⧸ lattice c) = c.a * c.d := by
  rw [lattice, LinearMap.card_quotient_range_eq_natAbs_det_all]
  have hdet : LinearMap.det (matrix c).mulVecLin = (matrix c).det := by
    rw [← LinearMap.det_toMatrix (Pi.basisFun ℤ (Fin 2))]
    congr 1
    rw [LinearMap.toMatrix_eq_toMatrix']
    exact (LinearEquiv.eq_symm_apply LinearMap.toMatrix').mp rfl
  simp [hdet, det_matrix, Int.natAbs_mul]

def vec (x y : ℤ) : Fin 2 → ℤ := ![x, y]

@[simp] theorem vec_zero (x y : ℤ) : vec x y 0 = x := rfl
@[simp] theorem vec_one (x y : ℤ) : vec x y 1 = y := rfl

def axis : ℤ →ₗ[ℤ] (Fin 2 → ℤ) where
  toFun x := vec x 0
  map_add' x y := by ext i; fin_cases i <;> simp [vec]
  map_smul' r x := by ext i; fin_cases i <;> simp [vec]

/-- Intersection with the horizontal coordinate axis. -/
def horizontal (L : Submodule ℤ (Fin 2 → ℤ)) : Ideal ℤ := L.comap axis

/-- Projection onto the vertical coordinate. -/
def vertical (L : Submodule ℤ (Fin 2 → ℤ)) : Ideal ℤ := L.map (LinearMap.proj 1)

/-- The nonnegative generator of an integral ideal. -/
def period (I : Ideal ℤ) : ℕ := (Submodule.IsPrincipal.generator I).natAbs

theorem mem_period (I : Ideal ℤ) (x : ℤ) : x ∈ I ↔ (period I : ℤ) ∣ x := by
  rw [Submodule.IsPrincipal.mem_iff_generator_dvd, period, Int.natCast_natAbs, abs_dvd]

theorem period_mem (I : Ideal ℤ) : (period I : ℤ) ∈ I :=
  (mem_period I _).mpr (dvd_refl _)

theorem period_pos (I : Ideal ℤ) {x : ℤ} (hx : x ∈ I) (h : x ≠ 0) : 0 < period I := by
  apply Nat.pos_of_ne_zero
  intro hz
  have hd := (mem_period I x).mp hx
  rw [hz, Nat.cast_zero, zero_dvd_iff] at hd
  exact h hd

theorem card_smul_mem (L : Submodule ℤ (Fin 2 → ℤ)) (v : Fin 2 → ℤ) :
    (Nat.card ((Fin 2 → ℤ) ⧸ L) : ℤ) • v ∈ L := by
  apply (Submodule.Quotient.mk_eq_zero L).mp
  change L.mkQ ((Nat.card ((Fin 2 → ℤ) ⧸ L) : ℤ) • v) = 0
  rw [map_smul]
  simp

theorem periods_pos (L : Submodule ℤ (Fin 2 → ℤ))
    (hm : Nat.card ((Fin 2 → ℤ) ⧸ L) ≠ 0) :
    0 < period (horizontal L) ∧ 0 < period (vertical L) := by
  let m := Nat.card ((Fin 2 → ℤ) ⧸ L)
  have hmz : (m : ℤ) ≠ 0 := Int.natCast_ne_zero.mpr hm
  constructor
  · apply period_pos (horizontal L) (x := m) ?_ hmz
    change vec (m : ℤ) 0 ∈ L
    convert card_smul_mem L (vec 1 0) using 1
    ext i
    fin_cases i <;> simp [vec, m]
  · apply period_pos (vertical L) (x := m) ?_ hmz
    exact ⟨(m : ℤ) • vec 0 1, card_smul_mem L (vec 0 1), by simp [vec]⟩

private theorem matrix_apply (c : Coordinates) (v : Fin 2 → ℤ) :
    (matrix c).mulVecLin v = vec ((c.a : ℤ) * v 0 + (c.b.val : ℤ) * v 1)
      ((c.d : ℤ) * v 1) := by
  ext i
  fin_cases i <;> simp [Matrix.mulVec, dotProduct,
    Fin.sum_univ_two, matrix, vec]

theorem mem_lattice (c : Coordinates) (v : Fin 2 → ℤ) :
    v ∈ lattice c ↔ ∃ x y : ℤ,
      v = vec ((c.a : ℤ) * x + (c.b.val : ℤ) * y) ((c.d : ℤ) * y) := by
  constructor
  · rintro ⟨w, rfl⟩
    exact ⟨w 0, w 1, matrix_apply c w⟩
  · rintro ⟨x, y, rfl⟩
    exact ⟨vec x y, matrix_apply c (vec x y)⟩

private theorem lattice_eq_of_generators (L : Submodule ℤ (Fin 2 → ℤ)) (c : Coordinates)
    (ha : ∀ x : ℤ, vec x 0 ∈ L ↔ (c.a : ℤ) ∣ x)
    (hd : ∀ v ∈ L, (c.d : ℤ) ∣ v 1)
    (hb : vec (c.b.val : ℤ) (c.d : ℤ) ∈ L) : L = lattice c := by
  ext v
  rw [mem_lattice]
  constructor
  · intro hv
    obtain ⟨y, hy⟩ := hd v hv
    have hr : vec (v 0 - y * (c.b.val : ℤ)) 0 ∈ L := by
      have h := L.sub_mem hv (L.smul_mem y hb)
      convert h using 1
      ext i
      fin_cases i <;> simp [vec, hy, mul_comm]
    obtain ⟨x, hx⟩ := (ha _).mp hr
    refine ⟨x, y, ?_⟩
    ext i
    fin_cases i
    · change v 0 = (c.a : ℤ) * x + (c.b.val : ℤ) * y
      linear_combination hx
    · exact hy
  · rintro ⟨x, y, rfl⟩
    have h := L.add_mem (L.smul_mem x ((ha (c.a : ℤ)).mpr (dvd_refl _)))
      (L.smul_mem y hb)
    convert h using 1
    ext i
    fin_cases i <;> simp [vec, mul_comm]

/-- Positive-index sublattices have normalized triangular integral coordinates. -/
theorem exists_coordinates (L : Submodule ℤ (Fin 2 → ℤ))
    (hm : Nat.card ((Fin 2 → ℤ) ⧸ L) ≠ 0) : ∃ c : Coordinates, L = lattice c := by
  obtain ⟨ha, hd⟩ := periods_pos L hm
  let a := period (horizontal L)
  let d := period (vertical L)
  have hax : vec (a : ℤ) 0 ∈ L := period_mem (horizontal L)
  obtain ⟨w, hw, hwd⟩ := period_mem (vertical L)
  change w 1 = (d : ℤ) at hwd
  have haz : 0 < (a : ℤ) := Int.natCast_pos.mpr ha
  have hr0 : 0 ≤ w 0 % (a : ℤ) := Int.emod_nonneg _ haz.ne'
  have hra : w 0 % (a : ℤ) < (a : ℤ) := Int.emod_lt_of_pos _ haz
  let b : Fin a := ⟨(w 0 % (a : ℤ)).toNat, by omega⟩
  have hbcast : (b.val : ℤ) = w 0 % (a : ℤ) := Int.toNat_of_nonneg hr0
  let c : Coordinates := ⟨a, d, ha, hd, b⟩
  refine ⟨c, lattice_eq_of_generators L c (fun x => mem_period (horizontal L) x) ?_ ?_⟩
  · intro v hv
    exact (mem_period (vertical L) (v 1)).mp ⟨v, hv, rfl⟩
  · have h := L.sub_mem hw (L.smul_mem (w 0 / (a : ℤ)) hax)
    convert h using 1
    ext i
    fin_cases i
    · change (b.val : ℤ) = w 0 - (w 0 / (a : ℤ)) * (a : ℤ)
      rw [hbcast, Int.emod_def]
      ring
    · change (d : ℤ) = w 1 - (w 0 / (a : ℤ)) * 0
      rw [mul_zero, sub_zero, hwd]

@[ext] theorem Coordinates.ext {c e : Coordinates}
    (ha : c.a = e.a) (hd : c.d = e.d) (hb : c.b.val = e.b.val) : c = e := by
  cases c with
  | mk a d ha0 hd0 b =>
    cases e with
    | mk a' d' ha' hd' b' =>
      dsimp only at ha hd hb
      subst a'
      subst d'
      have hb' : b = b' := Fin.ext hb
      subst b'
      rfl

theorem horizontal_lattice (c : Coordinates) (t : ℤ) :
    vec t 0 ∈ lattice c ↔ (c.a : ℤ) ∣ t := by
  rw [mem_lattice]
  constructor
  · rintro ⟨x, y, h⟩
    have h₁ := congrFun h 1
    change 0 = (c.d : ℤ) * y at h₁
    have hy : y = 0 := (mul_eq_zero.mp h₁.symm).resolve_left
      (Int.natCast_ne_zero.mpr c.d_pos.ne')
    have h₀ := congrFun h 0
    change t = (c.a : ℤ) * x + (c.b.val : ℤ) * y at h₀
    exact ⟨x, by simpa only [hy, mul_zero, add_zero] using h₀⟩
  · rintro ⟨x, rfl⟩
    exact ⟨x, 0, by simp [vec]⟩

theorem vertical_lattice (c : Coordinates) (t : ℤ) :
    t ∈ vertical (lattice c) ↔ (c.d : ℤ) ∣ t := by
  constructor
  · rintro ⟨v, hv, h⟩
    obtain ⟨x, y, rfl⟩ := (mem_lattice c v).mp hv
    exact ⟨y, h.symm⟩
  · rintro ⟨y, rfl⟩
    refine ⟨vec ((c.b.val : ℤ) * y) ((c.d : ℤ) * y), ?_, rfl⟩
    exact (mem_lattice c _).mpr ⟨0, y, by simp⟩

theorem first_generator_mem (c : Coordinates) : vec (c.a : ℤ) 0 ∈ lattice c :=
  (horizontal_lattice c _).mpr (dvd_refl _)

theorem second_generator_mem (c : Coordinates) :
    vec (c.b.val : ℤ) (c.d : ℤ) ∈ lattice c :=
  (mem_lattice c _).mpr ⟨0, 1, by simp⟩

/-- The horizontal intersection, vertical projection, and reduced offset determine the lattice. -/
theorem lattice_injective : Function.Injective lattice := by
  intro c e h
  have ha : c.a = e.a := by
    apply Nat.dvd_antisymm
    · apply Int.natCast_dvd_natCast.mp
      apply (horizontal_lattice c _).mp
      rw [h]
      exact first_generator_mem e
    · apply Int.natCast_dvd_natCast.mp
      apply (horizontal_lattice e _).mp
      rw [← h]
      exact first_generator_mem c
  have hd : c.d = e.d := by
    apply Nat.dvd_antisymm
    · apply Int.natCast_dvd_natCast.mp
      apply (vertical_lattice c _).mp
      rw [h]
      exact (vertical_lattice e _).mpr (dvd_refl _)
    · apply Int.natCast_dvd_natCast.mp
      apply (vertical_lattice e _).mp
      rw [← h]
      exact (vertical_lattice c _).mpr (dvd_refl _)
  apply Coordinates.ext ha hd
  have hm : vec (c.b.val : ℤ) (c.d : ℤ) ∈ lattice e := h ▸ second_generator_mem c
  obtain ⟨x, y, he⟩ := (mem_lattice e _).mp hm
  have hy : y = 1 := by
    have he₁ := congrFun he 1
    change (c.d : ℤ) = (e.d : ℤ) * y at he₁
    rw [hd] at he₁
    exact (mul_left_cancel₀ (Int.natCast_ne_zero.mpr e.d_pos.ne')
      (he₁.symm.trans (mul_one _).symm))
  have he₀ := congrFun he 0
  change (c.b.val : ℤ) = (e.a : ℤ) * x + (e.b.val : ℤ) * y at he₀
  rw [hy, mul_one] at he₀
  have hmod : (c.b.val : ℤ) % (e.a : ℤ) = (e.b.val : ℤ) % (e.a : ℤ) := by
    rw [he₀, Int.add_emod]
    simp
  have hc0 : 0 ≤ (c.b.val : ℤ) := Int.natCast_nonneg _
  have he0 : 0 ≤ (e.b.val : ℤ) := Int.natCast_nonneg _
  have hca : (c.b.val : ℤ) < (e.a : ℤ) := by
    have hlt : c.b.val < e.a := by rw [← ha]; exact c.b.isLt
    exact_mod_cast hlt
  have hea : (e.b.val : ℤ) < (e.a : ℤ) := by exact_mod_cast e.b.isLt
  rw [Int.emod_eq_of_lt hc0 hca, Int.emod_eq_of_lt he0 hea] at hmod
  exact_mod_cast hmod

/-- One residue for each horizontal period dividing the total index. -/
def Parameters (m : ℕ) := Σ a : {a : ℕ // a ∈ m.divisors}, Fin a.val

def coordinatesOfParameter (n : ℕ) (p : Parameters (n + 1)) : Coordinates := by
  have hdvd : p.1.val ∣ n + 1 := (Nat.mem_divisors.mp p.1.property).1
  have ha : 0 < p.1.val := Nat.pos_of_ne_zero (by
    intro h
    rw [h, zero_dvd_iff] at hdvd
    omega)
  have hprod : p.1.val * ((n + 1) / p.1.val) = n + 1 := Nat.mul_div_cancel' hdvd
  have hd : 0 < (n + 1) / p.1.val := Nat.pos_of_ne_zero (by
    intro h
    rw [h, mul_zero] at hprod
    omega)
  exact ⟨p.1.val, (n + 1) / p.1.val, ha, hd, p.2⟩

theorem coordinatesOfParameter_index (n : ℕ) (p : Parameters (n + 1)) :
    (coordinatesOfParameter n p).a * (coordinatesOfParameter n p).d = n + 1 :=
  Nat.mul_div_cancel' (Nat.mem_divisors.mp p.1.property).1

/-- Fixed-index triangular lattices are parameterized by divisors and bounded offsets. -/
def parametersEquiv (n : ℕ) :
    Parameters (n + 1) ≃ {c : Coordinates // c.a * c.d = n + 1} where
  toFun p := ⟨coordinatesOfParameter n p, coordinatesOfParameter_index n p⟩
  invFun c := ⟨⟨c.val.a, Nat.mem_divisors.mpr ⟨⟨c.val.d, c.property.symm⟩,
    Nat.succ_ne_zero n⟩⟩, c.val.b⟩
  left_inv p := by cases p; rfl
  right_inv c := by
    apply Subtype.ext
    apply Coordinates.ext
    · rfl
    · change (n + 1) / c.val.a = c.val.d
      calc
        (n + 1) / c.val.a = (c.val.a * c.val.d) / c.val.a :=
          congrArg (fun k : ℕ => k / c.val.a) c.property.symm
        _ = c.val.d := Nat.mul_div_cancel_left _ c.val.a_pos
    · rfl

def latticeOfIndex (n : ℕ) : {c : Coordinates // c.a * c.d = n + 1} →
    {L : Submodule ℤ (Fin 2 → ℤ) // Nat.card ((Fin 2 → ℤ) ⧸ L) = n + 1} :=
  fun c => ⟨lattice c.val, (card_quotient c.val).trans c.property⟩

theorem latticeOfIndex_bijective (n : ℕ) : Function.Bijective (latticeOfIndex n) := by
  constructor
  · intro c e h
    exact Subtype.ext (lattice_injective (congrArg Subtype.val h))
  · intro L
    have hm : Nat.card ((Fin 2 → ℤ) ⧸ L.val) ≠ 0 := by rw [L.property]; omega
    obtain ⟨c, hc⟩ := exists_coordinates L.val hm
    have hi : c.a * c.d = n + 1 := by rw [← card_quotient, ← hc, L.property]
    exact ⟨⟨c, hi⟩, Subtype.ext hc.symm⟩

/-- Canonical triangular coordinates classify every sublattice of the given index. -/
def latticeEquiv (n : ℕ) : {c : Coordinates // c.a * c.d = n + 1} ≃
    {L : Submodule ℤ (Fin 2 → ℤ) // Nat.card ((Fin 2 → ℤ) ⧸ L) = n + 1} :=
  Equiv.ofBijective _ (latticeOfIndex_bijective n)

/-- The number of sublattices of positive index is the sum of its divisors. -/
theorem card_sublattices (n : ℕ) :
    Nat.card {L : Submodule ℤ (Fin 2 → ℤ) //
      Nat.card ((Fin 2 → ℤ) ⧸ L) = n + 1} = ∑ a ∈ (n + 1).divisors, a := by
  let e := (parametersEquiv n).trans (latticeEquiv n)
  rw [← Nat.card_congr e]
  change Nat.card (Σ a : {a : ℕ // a ∈ (n + 1).divisors}, Fin a.val) = _
  rw [Nat.card_eq_fintype_card, Fintype.card_sigma]
  simp only [Fintype.card_fin]
  exact Finset.sum_coe_sort (n + 1).divisors (fun a : ℕ => a)

#print axioms exists_coordinates
#print axioms lattice_injective
#print axioms latticeEquiv
#print axioms card_sublattices
end GaloisForLFunctions.RepresentationLifting.RankTwoHermite
