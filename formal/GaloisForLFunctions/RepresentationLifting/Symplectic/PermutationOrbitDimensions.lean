import GaloisForLFunctions.RepresentationLifting.Symplectic.RealConstraintSymplectic
import GaloisForLFunctions.RepresentationLifting.Actions.TransitiveAbelianActions
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
import Mathlib.Logic.Relation

/-!
# Orbit dimensions of permutation-fixed zero-sum sectors

Functions fixed by a family of permutations are precisely functions on its
orbit quotient. On a nonempty finite set, summation is a surjective linear
functional, so its kernel has dimension one less than the number of orbits.
The real-defined symplectic sector therefore has twice the zero-sum dimension.
This extends the fixed-space count in Theorem 6.2 of Kurnosov–Ríos Ortiz,
https://arxiv.org/abs/2611.01210, to arbitrary permutation families.
-/

noncomputable section
open scoped BigOperators
namespace GaloisForLFunctions.RepresentationLifting
variable {ι : Type*}

/-- Functions constant on each equivalence class. -/
def classConstant (s : Setoid ι) : Submodule ℂ (ι → ℂ) where
  carrier := {v | ∀ i j, Quotient.mk s i = Quotient.mk s j → v i = v j}
  zero_mem' := by intro i j _; rfl
  add_mem' := by
    intro v w hv hw i j hij
    change v i + w i = v j + w j
    rw [hv i j hij, hw i j hij]
  smul_mem' := by
    intro c v hv i j hij
    change c * v i = c * v j
    rw [hv i j hij]

/-- Pullback identifies quotient functions with functions constant on each class. -/
def classFunctionsEquiv (s : Setoid ι) : (Quotient s → ℂ) ≃ₗ[ℂ] classConstant s where
  toFun f := ⟨fun i => f (Quotient.mk s i), fun i j h => congrArg f h⟩
  invFun v := fun q => v.val q.out
  left_inv f := by
    funext q
    exact congrArg f (Quotient.out_eq' q)
  right_inv v := by
    apply Subtype.ext
    funext i
    exact v.property _ _ (Quotient.out_eq _)
  map_add' f g := rfl
  map_smul' c f := rfl

section Finite
variable [Fintype ι]

theorem classConstant_finrank (s : Setoid ι) :
    Module.finrank ℂ (classConstant s) = Nat.card (Quotient s) := by
  letI : Fintype (Quotient s) := Fintype.ofFinite _
  calc
    _ = Module.finrank ℂ (Quotient s → ℂ) := (classFunctionsEquiv s).finrank_eq.symm
    _ = Fintype.card (Quotient s) := Module.finrank_fintype_fun_eq_card ℂ
    _ = Nat.card (Quotient s) := Nat.card_eq_fintype_card.symm

/-- Coordinate summation restricted to class-constant functions. -/
def classSum (s : Setoid ι) : classConstant s →ₗ[ℂ] ℂ where
  toFun v := ∑ i, v.val i
  map_add' v w := by simp [Finset.sum_add_distrib]
  map_smul' c v := by
    change (∑ i, c * v.val i) = c * ∑ i, v.val i
    rw [Finset.mul_sum]

theorem classSum_surjective [Nonempty ι] (s : Setoid ι) : Function.Surjective (classSum s) := by
  intro c
  have hn : (Fintype.card ι : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr Fintype.card_ne_zero
  refine ⟨⟨fun _ => c / (Fintype.card ι : ℂ), fun _ _ _ => rfl⟩, ?_⟩
  change (∑ _ : ι, c / (Fintype.card ι : ℂ)) = c
  rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
  field_simp

theorem classSum_kernel_finrank [Nonempty ι] (s : Setoid ι) :
    Module.finrank ℂ (classSum s).ker = Nat.card (Quotient s) - 1 := by
  have h := LinearMap.finrank_range_add_finrank_ker (classSum s)
  have hr : (classSum s).range = ⊤ := LinearMap.range_eq_top.mpr (classSum_surjective s)
  rw [hr, finrank_top, Module.finrank_self, classConstant_finrank] at h
  omega

end Finite

/-- Orbit equivalence generated by an arbitrary family of permutations. -/
def permutationOrbit {κ : Type*} (σ : κ → Equiv.Perm ι) : Setoid ι :=
  Relation.EqvGen.setoid (fun i j => ∃ g, σ g i = j)

/-- Invariance under the generators is equivalent to constancy on their orbits. -/
theorem classConstant_iff_fixed {κ : Type*} (σ : κ → Equiv.Perm ι) (v : ι → ℂ) :
    v ∈ classConstant (permutationOrbit σ) ↔ ∀ g i, v (σ g i) = v i := by
  constructor
  · intro h g i
    apply h
    exact Quotient.sound (Relation.EqvGen.symm _ _ (Relation.EqvGen.rel _ _ ⟨g, rfl⟩))
  · intro h i j hij
    have hrel : Relation.EqvGen (fun i j => ∃ g, σ g i = j) i j := Quotient.exact hij
    clear hij
    induction hrel with
    | rel i j hij =>
      obtain ⟨g, rfl⟩ := hij
      exact (h g i).symm
    | refl i => rfl
    | symm i j hij ih => exact ih.symm
    | trans i j k hij hjk ihij ihjk => exact ihij.trans ihjk


/-- The sum map on orbit-constant functions has exactly the constrained kernel. -/
def classSumKernelEquivMoving {κ : Type*} {m : ℕ}
    (σ : κ → Equiv.Perm (Fin m)) :
    (classSum (permutationOrbit σ)).ker ≃ₗ[ℂ]
      realConstraintKernel (permutationMovingConstraints σ) where
  toFun v := ⟨v.val.val, (mem_permutationMovingKernel_iff σ v.val.val).mpr
    ⟨v.property, (classConstant_iff_fixed σ v.val.val).mp v.val.property⟩⟩
  invFun v := ⟨⟨v.val, (classConstant_iff_fixed σ v.val).mpr
    ((mem_permutationMovingKernel_iff σ v.val).mp v.property).2⟩,
    ((mem_permutationMovingKernel_iff σ v.val).mp v.property).1⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- Each orbit contributes one constant; the zero-sum equation removes one dimension. -/
theorem permutationMoving_finrank {κ : Type*} {m : ℕ}
    (σ : κ → Equiv.Perm (Fin m)) :
    Module.finrank ℂ (realConstraintKernel (permutationMovingConstraints σ)) =
      Nat.card (Quotient (permutationOrbit σ)) - 1 := by
  cases m with
  | zero =>
    rw [Module.finrank_zero_of_subsingleton]
    have h : Nat.card (Quotient (permutationOrbit σ)) = 0 := Nat.card_eq_zero.mpr (Or.inl inferInstance)
    rw [h, Nat.zero_sub]
  | succ n =>
    rw [← (classSumKernelEquivMoving σ).finrank_eq]
    exact classSum_kernel_finrank _

/-- The symplectic fixed sector has twice the zero-sum orbit dimension. -/
theorem permutationMoving_double_finrank {κ : Type*} {m : ℕ}
    (σ : κ → Equiv.Perm (Fin m)) :
    Module.finrank ℂ (realConstraintKernel (permutationMovingConstraints σ) ×
      realConstraintKernel (permutationMovingConstraints σ)) =
      2 * (Nat.card (Quotient (permutationOrbit σ)) - 1) := by
  rw [Module.finrank_prod, permutationMoving_finrank]
  omega

/-- A transitive abelian action leaves no nonzero vector in the zero-sum sector. -/
theorem transitiveAction_movingKernel_eq_bot {A : Type*} [AddCommGroup A] (n : ℕ)
    (ρ : TransitiveActions.Transitive A (Fin (n + 1)) 0) :
    realConstraintKernel (permutationMovingConstraints (fun a => (ρ.val a).toMul)) = ⊥ := by
  apply le_antisymm _ bot_le
  intro v hv
  obtain ⟨hsum, hfix⟩ :=
    (mem_permutationMovingKernel_iff (fun a => (ρ.val a).toMul) v).mp hv
  have hc (i : Fin (n + 1)) : v i = v 0 := by
    obtain ⟨a, ha⟩ := ρ.property i
    change (ρ.val a).toMul 0 = i at ha
    rw [← ha]
    exact hfix a 0
  have hz : v 0 = 0 := by
    have hs : ((n + 1 : ℕ) : ℂ) * v 0 = 0 := by
      simpa only [hc, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        using hsum
    exact (mul_eq_zero.mp hs).resolve_left (Nat.cast_ne_zero.mpr (Nat.succ_ne_zero n))
  change v = 0
  funext i
  exact (hc i).trans hz

#print axioms permutationMoving_finrank
#print axioms permutationMoving_double_finrank
#print axioms transitiveAction_movingKernel_eq_bot

end GaloisForLFunctions.RepresentationLifting
