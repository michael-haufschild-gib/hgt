import GaloisForLFunctions.RHTower.Artin.ArtinInducedSpanIsAnIdeal
import GaloisForLFunctions.RepresentationLifting.KTheory.FieldGrothendieckGroup
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Virtual characters acting on field K-zero

The concrete virtual characters generated by actual complex representations
form a ring under pointwise multiplication. Evaluation at the identity is
integer-valued and gives its dimension augmentation. Tensoring underlying
vector spaces induces the corresponding action on actual field K-zero;
the augmentation ideal is exactly the annihilator of this action.
-/

noncomputable section
namespace GaloisForLFunctions.RepresentationLifting
open CategoryTheory
variable (G : Type*) [Group G]

/-- The concrete ring of virtual character functions generated by actual `FDRep` objects. -/
def virtualRepresentationSubring : Subring (G → ℂ) where
  carrier := virtualCharacterGroup G
  zero_mem' := (virtualCharacterGroup G).zero_mem
  add_mem' := (virtualCharacterGroup G).add_mem
  neg_mem' := (virtualCharacterGroup G).neg_mem
  one_mem' := AddSubgroup.subset_closure one_mem_fdCharacterSet
  mul_mem' := mul_mem_virtualCharacterGroup

abbrev VirtualRepresentationRing := virtualRepresentationSubring G

def fdRepVirtual (V : FDRep ℂ G) : VirtualRepresentationRing G :=
  ⟨V.character, AddSubgroup.subset_closure ⟨V, rfl⟩⟩

def virtualRepresentationDegree (χ : VirtualRepresentationRing G) : ℤ :=
  (VirtualCharacter.one_eq_intCast G ⟨χ.val, χ.property⟩).choose

theorem virtualRepresentationDegree_cast (χ : VirtualRepresentationRing G) :
    (virtualRepresentationDegree G χ : ℂ) = χ.val 1 :=
  (VirtualCharacter.one_eq_intCast G ⟨χ.val, χ.property⟩).choose_spec.symm

/-- The integer dimension augmentation of the virtual-character ring. -/
def virtualRepresentationAugmentation : VirtualRepresentationRing G →+* ℤ where
  toFun := virtualRepresentationDegree G
  map_zero' := by
    apply Int.cast_injective (α := ℂ)
    rw [virtualRepresentationDegree_cast, Int.cast_zero]
    rfl
  map_one' := by
    apply Int.cast_injective (α := ℂ)
    rw [virtualRepresentationDegree_cast, Int.cast_one]
    rfl
  map_add' χ ψ := by
    apply Int.cast_injective (α := ℂ)
    rw [virtualRepresentationDegree_cast, Int.cast_add,
      virtualRepresentationDegree_cast, virtualRepresentationDegree_cast]
    rfl
  map_mul' χ ψ := by
    apply Int.cast_injective (α := ℂ)
    rw [virtualRepresentationDegree_cast, Int.cast_mul,
      virtualRepresentationDegree_cast, virtualRepresentationDegree_cast]
    rfl

theorem virtualRepresentationAugmentation_fdRep (V : FDRep ℂ G) :
    virtualRepresentationAugmentation G (fdRepVirtual G V) = (Module.finrank ℂ V : ℤ) := by
  apply Int.cast_injective (α := ℂ)
  change (virtualRepresentationDegree G (fdRepVirtual G V) : ℂ) = _
  rw [virtualRepresentationDegree_cast, Int.cast_natCast]
  exact FDRep.char_one V

def virtualRepresentationAugmentationIdeal : Ideal (VirtualRepresentationRing G) :=
  RingHom.ker (virtualRepresentationAugmentation G)

theorem virtualRepresentationAugmentation_surjective :
    Function.Surjective (virtualRepresentationAugmentation G) := by
  intro z
  exact ⟨z, map_intCast _ z⟩

/-- Quotienting virtual characters by dimension-zero characters gives the integers. -/
def virtualRepresentationAugmentationQuotient :
    VirtualRepresentationRing G ⧸ virtualRepresentationAugmentationIdeal G ≃+* ℤ :=
  RingHom.quotientKerEquivOfSurjective (virtualRepresentationAugmentation_surjective G)

def virtualRepresentationFieldK0 : VirtualRepresentationRing G →+ FieldK0 ℂ :=
  (integerToFieldK0 ℂ).comp (virtualRepresentationAugmentation G).toAddMonoidHom

instance : Module (VirtualRepresentationRing G) (FieldK0 ℂ) :=
  Module.compHom (FieldK0 ℂ) (virtualRepresentationAugmentation G)

theorem virtualRepresentationFieldK0_fdRep (V : FDRep ℂ G) :
    virtualRepresentationFieldK0 G (fdRepVirtual G V) =
      fieldK0Class ℂ (FGModuleCat.of ℂ V) := by
  change integerToFieldK0 ℂ (virtualRepresentationAugmentation G (fdRepVirtual G V)) = _
  apply (fieldK0EquivInt ℂ).injective
  change fieldK0Rank ℂ (integerToFieldK0 ℂ
    (virtualRepresentationAugmentation G (fdRepVirtual G V))) =
      fieldK0Rank ℂ (fieldK0Class ℂ (FGModuleCat.of ℂ V))
  rw [fieldK0Rank_rightInverse, virtualRepresentationAugmentation_fdRep, fieldK0Rank_class]

def virtualRepresentationK0Action (χ : VirtualRepresentationRing G) (x : FieldK0 ℂ) : FieldK0 ℂ :=
  virtualRepresentationAugmentation G χ • x

/-- The dimension action agrees with tensoring by the underlying actual representation. -/
theorem virtualRepresentationK0Action_tensor (V : FDRep ℂ G) (W : FGModuleCat ℂ) :
    virtualRepresentationK0Action G (fdRepVirtual G V) (fieldK0Class ℂ W) =
      fieldK0Class ℂ (FGModuleCat.of ℂ (TensorProduct ℂ V W)) := by
  apply (fieldK0EquivInt ℂ).injective
  change fieldK0Rank ℂ (virtualRepresentationAugmentation G (fdRepVirtual G V) •
    fieldK0Class ℂ W) = fieldK0Rank ℂ (fieldK0Class ℂ (FGModuleCat.of ℂ (TensorProduct ℂ V W)))
  rw [map_zsmul, virtualRepresentationAugmentation_fdRep, fieldK0Rank_class, fieldK0Rank_class]
  rw [zsmul_eq_mul]
  change (Module.finrank ℂ V : ℤ) * (Module.finrank ℂ W : ℤ) =
    (Module.finrank ℂ (TensorProduct ℂ V W) : ℤ)
  exact_mod_cast (Module.finrank_tensorProduct (R := ℂ) (S := ℂ) (M := V) (M' := W)).symm

/-- The augmentation ideal is exactly the kernel of the action on field K-zero. -/
theorem virtualRepresentationK0Action_zero_iff (χ : VirtualRepresentationRing G) :
    (∀ x : FieldK0 ℂ, virtualRepresentationK0Action G χ x = 0) ↔
      χ ∈ virtualRepresentationAugmentationIdeal G := by
  change (∀ x : FieldK0 ℂ, virtualRepresentationAugmentation G χ • x = 0) ↔
    virtualRepresentationAugmentation G χ = 0
  constructor
  · intro h
    have hh := congrArg (fieldK0Rank ℂ) (h (fieldK0Class ℂ (FGModuleCat.of ℂ ℂ)))
    rw [map_zsmul, fieldK0Rank_class, map_zero] at hh
    simpa using hh
  · intro h x
    rw [h, zero_smul]

/-- The actual module annihilator of field K-zero is precisely the dimension augmentation ideal. -/
theorem virtualRepresentationFieldK0_annihilator :
    Module.annihilator (VirtualRepresentationRing G) (FieldK0 ℂ) =
      virtualRepresentationAugmentationIdeal G := by
  ext χ
  rw [Module.mem_annihilator]
  exact virtualRepresentationK0Action_zero_iff G χ

end GaloisForLFunctions.RepresentationLifting
