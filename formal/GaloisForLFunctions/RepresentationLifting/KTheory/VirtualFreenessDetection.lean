import GaloisForLFunctions.RepresentationLifting.KTheory.VirtualCharacterK0
import GaloisForLFunctions.RHTower.Artin.ArtinVirtualCharacterPairing

/-!
# Nonidentity traces detect virtual freeness

The regular-character obstruction in §2.5 of https://arxiv.org/abs/2610.40335
has an exact converse for concrete complex virtual characters.
An integer multiple of the regular character is precisely a virtual character
supported at the identity. Integrality of the trivial-character pairing proves
the converse. The regular ideal and the dimension augmentation ideal annihilate
each other, so dimension alone loses every nonzero degree-zero obstruction.
-/

open scoped BigOperators Classical
noncomputable section
namespace GaloisForLFunctions.RepresentationLifting

variable (G : Type*) [Group G] [Fintype G]

/-- The actual left regular representation as a concrete virtual character. -/
def regularVirtualRepresentation : VirtualRepresentationRing G :=
  ⟨(Representation.leftRegular ℂ G).character,
    AddSubgroup.subset_closure
      (representation_character_mem_fdCharacterSet G (Representation.leftRegular ℂ G))⟩

/-- The regular trace counts the fixed basis vectors of left translation. -/
theorem regularVirtualRepresentation_apply (g : G) :
    (regularVirtualRepresentation G).val g = if g = 1 then (Fintype.card G : ℂ) else 0 := by
  classical
  change LinearMap.trace ℂ (MonoidAlgebra ℂ G) (Representation.leftRegular ℂ G g) = _
  rw [LinearMap.trace_eq_matrix_trace ℂ (MonoidAlgebra.basis G ℂ)]
  change (∑ x : G, (LinearMap.toMatrix (MonoidAlgebra.basis G ℂ)
    (MonoidAlgebra.basis G ℂ) (Representation.leftRegular ℂ G g)) x x) = _
  have hdiag (x : G) : (LinearMap.toMatrix (MonoidAlgebra.basis G ℂ)
      (MonoidAlgebra.basis G ℂ) (Representation.leftRegular ℂ G g)) x x =
      if g = 1 then 1 else 0 := by
    rw [LinearMap.toMatrix_apply, MonoidAlgebra.basis_apply]
    change (Representation.ofMulAction ℂ G G g (MonoidAlgebra.single x 1)).coeff x = _
    rw [Representation.ofMulAction_single, MonoidAlgebra.coeff_single]
    simp only [Finsupp.single_apply, smul_eq_mul, mul_eq_right]
  simp only [hdiag, Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
  split_ifs <;> simp

/-- The ideal generated by the regular representation, written as integer multiples. -/
def IsVirtuallyFree (χ : VirtualRepresentationRing G) : Prop :=
  ∃ m : ℤ, χ = m • regularVirtualRepresentation G

/-- Virtual freeness is exactly vanishing of every nonidentity trace. -/
theorem isVirtuallyFree_iff (χ : VirtualRepresentationRing G) :
    IsVirtuallyFree G χ ↔ ∀ g : G, g ≠ 1 → χ.val g = 0 := by
  classical
  constructor
  · rintro ⟨m, rfl⟩ g hg
    change m • (regularVirtualRepresentation G).val g = 0
    rw [regularVirtualRepresentation_apply, if_neg hg, smul_zero]
  · intro hχ
    let trivial : VirtualCharacter G := ⟨1, AddSubgroup.subset_closure one_mem_fdCharacterSet⟩
    obtain ⟨m, hm⟩ := virtualCharacterPairing_eq_intCast G trivial ⟨χ.val, χ.property⟩
    have hsum : ∑ g : G, χ.val g = χ.val 1 :=
      Finset.sum_eq_single 1 (fun g _ hg => hχ g hg) (fun h => (h (Finset.mem_univ 1)).elim)
    have hm' : (Fintype.card G : ℂ)⁻¹ * χ.val 1 = (m : ℂ) := by
      simpa only [characterPairing, trivial, Pi.one_apply, mul_one, hsum,
        Nat.card_eq_fintype_card] using hm
    have hc : (Fintype.card G : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr Fintype.card_ne_zero
    refine ⟨m, Subtype.ext (funext fun g => ?_)⟩
    change χ.val g = m • (regularVirtualRepresentation G).val g
    rw [regularVirtualRepresentation_apply, zsmul_eq_mul]
    by_cases hg : g = 1
    · subst g
      rw [if_pos rfl]
      have := congrArg (fun z : ℂ => (Fintype.card G : ℂ) * z) hm'
      simpa only [← mul_assoc, mul_inv_cancel₀ hc, one_mul, mul_comm] using this
    · rw [if_neg hg, mul_zero, hχ g hg]

/-- A nonfree virtual character always has a nonzero trace away from the identity. -/
theorem not_isVirtuallyFree_iff (χ : VirtualRepresentationRing G) :
    ¬ IsVirtuallyFree G χ ↔ ∃ g : G, g ≠ 1 ∧ χ.val g ≠ 0 := by
  rw [isVirtuallyFree_iff]
  push Not
  rfl

/-- Tensoring the regular class by any virtual class only remembers its dimension. -/
theorem regularVirtualRepresentation_mul (χ : VirtualRepresentationRing G) :
    regularVirtualRepresentation G * χ =
      virtualRepresentationAugmentation G χ • regularVirtualRepresentation G := by
  classical
  apply Subtype.ext
  funext g
  change (regularVirtualRepresentation G).val g * χ.val g =
    virtualRepresentationAugmentation G χ • (regularVirtualRepresentation G).val g
  rw [zsmul_eq_mul]
  change (regularVirtualRepresentation G).val g * χ.val g =
    (virtualRepresentationDegree G χ : ℂ) * (regularVirtualRepresentation G).val g
  rw [virtualRepresentationDegree_cast, regularVirtualRepresentation_apply]
  by_cases hg : g = 1
  · subst g; ring
  · rw [if_neg hg, zero_mul, mul_zero]

/-- A regular multiple of degree zero vanishes; no dimension-zero obstruction is virtually free. -/
theorem isVirtuallyFree_and_degree_zero_iff (χ : VirtualRepresentationRing G) :
    (IsVirtuallyFree G χ ∧ virtualRepresentationAugmentation G χ = 0) ↔ χ = 0 := by
  constructor
  · rintro ⟨hfree, hdeg⟩
    apply Subtype.ext
    funext g
    change χ.val g = 0
    by_cases hg : g = 1
    · subst g
      have h := virtualRepresentationDegree_cast G χ
      change (virtualRepresentationAugmentation G χ : ℂ) = χ.val 1 at h
      simpa only [hdeg, Int.cast_zero] using h.symm
    · exact (isVirtuallyFree_iff G χ).mp hfree g hg
  · rintro rfl
    exact ⟨⟨0, (zero_smul ℤ _).symm⟩, map_zero _⟩

/-- Multiplication by the regular class has exactly the dimension augmentation ideal as kernel. -/
theorem regularVirtualRepresentation_mul_eq_zero_iff (χ : VirtualRepresentationRing G) :
    regularVirtualRepresentation G * χ = 0 ↔
      χ ∈ virtualRepresentationAugmentationIdeal G := by
  change _ ↔ virtualRepresentationAugmentation G χ = 0
  constructor
  · intro h
    have hv := congrArg (fun θ : VirtualRepresentationRing G => θ.val 1) h
    change (regularVirtualRepresentation G).val 1 * χ.val 1 = 0 at hv
    rw [regularVirtualRepresentation_apply, if_pos rfl] at hv
    have hc : (Fintype.card G : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr Fintype.card_ne_zero
    have hz := (mul_eq_zero.mp hv).resolve_left hc
    apply Int.cast_injective (α := ℂ)
    change (virtualRepresentationDegree G χ : ℂ) = ((0 : ℤ) : ℂ)
    rw [Int.cast_zero, virtualRepresentationDegree_cast, hz]
  · intro h
    rw [regularVirtualRepresentation_mul, h, zero_smul]

/-- A virtually free class invisible to the field K-zero action is zero. -/
theorem isVirtuallyFree_and_K0Action_zero_iff (χ : VirtualRepresentationRing G) :
    (IsVirtuallyFree G χ ∧ ∀ x : FieldK0 ℂ, virtualRepresentationK0Action G χ x = 0) ↔
      χ = 0 := by
  rw [virtualRepresentationK0Action_zero_iff]
  exact isVirtuallyFree_and_degree_zero_iff G χ

#print axioms isVirtuallyFree_iff
#print axioms not_isVirtuallyFree_iff
#print axioms isVirtuallyFree_and_degree_zero_iff
#print axioms regularVirtualRepresentation_mul_eq_zero_iff
#print axioms isVirtuallyFree_and_K0Action_zero_iff

end GaloisForLFunctions.RepresentationLifting
