import Mathlib.LinearAlgebra.Semisimple
import Mathlib.Algebra.Algebra.Subalgebra.Lattice

/-!
# Semisimple algebras generated by commuting operators

Over a perfect field, a commuting family of semisimple endomorphisms generates
a reduced finite-dimensional algebra, hence a semisimple ring. In particular,
invertible scalar-square relations suffice when two is nonzero.

This supplies the algebraic step in the central-character argument of
arXiv:2611.20896, Lemma 2.2.
-/

noncomputable section
namespace GaloisForLFunctions.RepresentationLifting
variable {K V : Type*} [Field K] [PerfectField K] [AddCommGroup V]
  [Module K V] [FiniteDimensional K V]

omit [PerfectField K] [FiniteDimensional K V] in
private theorem adjoin_commute {S : Set (Module.End K V)}
    (hS : ∀ x ∈ S, ∀ y ∈ S, Commute x y) {a b : Module.End K V}
    (ha : a ∈ Algebra.adjoin K S) (hb : b ∈ Algebra.adjoin K S) : Commute a b := by
  have hc : S ⊆ Subalgebra.centralizer K S := by
    intro x hx
    exact (Subalgebra.mem_centralizer_iff K).mpr (fun y hy => hS y hy x hx)
  exact ((Subalgebra.mem_centralizer_iff K).mp
    (Algebra.adjoin_le_centralizer_centralizer K S ha) b (Algebra.adjoin_le hc hb)).symm

/-- A commuting family of semisimple operators generates only semisimple operators over a perfect field. -/
theorem semisimple_of_mem_commuting_adjoin (S : Set (Module.End K V))
    (hcomm : ∀ x ∈ S, ∀ y ∈ S, Commute x y)
    (hss : ∀ x ∈ S, Module.End.IsSemisimple x) {a : Module.End K V}
    (ha : a ∈ Algebra.adjoin K S) : a.IsSemisimple := by
  induction ha using Algebra.adjoin_induction with
  | mem x hx => exact hss x hx
  | algebraMap r =>
    change Module.End.IsSemisimple (r • (LinearMap.id : Module.End K V))
    exact Module.End.IsSemisimple_smul r Module.End.isSemisimple_id
  | add x y hx hy ihx ihy => exact Module.End.IsSemisimple.add_of_commute (adjoin_commute hcomm hx hy) ihx ihy
  | mul x y hx hy ihx ihy => exact Module.End.IsSemisimple.mul_of_commute (adjoin_commute hcomm hx hy) ihx ihy

/-- The finite-dimensional algebra generated by commuting semisimple operators has no radical. -/
theorem commuting_adjoin_isSemisimpleRing (S : Set (Module.End K V))
    (hcomm : ∀ x ∈ S, ∀ y ∈ S, Commute x y)
    (hss : ∀ x ∈ S, Module.End.IsSemisimple x) :
    IsSemisimpleRing (Algebra.adjoin K S) := by
  letI : CommRing (Algebra.adjoin K S) :=
    { (inferInstance : Ring (Algebra.adjoin K S)) with
      mul_comm := fun a b => Subtype.ext (adjoin_commute hcomm a.property b.property) }
  letI : IsReduced (Algebra.adjoin K S) := ⟨fun a ha => by
    apply Subtype.ext
    apply Module.End.eq_zero_of_isNilpotent_isSemisimple
    · exact ha.map (Algebra.adjoin K S).val.toRingHom
    · exact semisimple_of_mem_commuting_adjoin S hcomm hss a.property⟩
  letI : IsArtinianRing (Algebra.adjoin K S) := .of_finite K _
  exact IsArtinianRing.isSemisimpleRing_of_isReduced (Algebra.adjoin K S)

omit [PerfectField K] [FiniteDimensional K V] in
/-- A scalar-square relation in odd characteristic is a separable annihilating polynomial. -/
theorem semisimple_of_square_scalar [NeZero (2 : K)] (T : Module.End K V)
    (c : Kˣ) (hT : T ^ 2 = (c : K) • 1) : T.IsSemisimple := by
  apply Module.End.isSemisimple_of_squarefree_aeval_eq_zero
    (Polynomial.separable_X_pow_sub_C (c : K) (NeZero.ne (2 : K)) c.ne_zero).squarefree
  simp only [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C,
    Algebra.algebraMap_eq_smul_one, hT, sub_self]

/-- Commuting invertible operators whose squares are scalars generate a semisimple action algebra. -/
theorem scalarSquare_adjoin_isSemisimpleRing [NeZero (2 : K)] {ι : Type*}
    (T : ι → Module.End K V) (c : ι → Kˣ)
    (hcomm : ∀ i j, Commute (T i) (T j))
    (hT : ∀ i, T i ^ 2 = (c i : K) • 1) :
    IsSemisimpleRing (Algebra.adjoin K (Set.range T)) := by
  apply commuting_adjoin_isSemisimpleRing
  · rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩
    exact hcomm i j
  · rintro _ ⟨i, rfl⟩
    exact semisimple_of_square_scalar (T i) (c i) (hT i)

#print axioms commuting_adjoin_isSemisimpleRing
#print axioms scalarSquare_adjoin_isSemisimpleRing
end GaloisForLFunctions.RepresentationLifting
