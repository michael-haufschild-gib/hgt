import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.LinearAlgebra.Quotient.Basic
import Mathlib.LinearAlgebra.Dimension.Constructions

/-!
# Cyclic Hom spaces over noncommutative algebras

For an algebra R over a field K, evaluation at one identifies
Hom_R(R/Rr,M) with the K-linear kernel of the action of r on M.
The quotient uses the actual left ideal generated by r. Neither r
nor R is assumed commutative; only the coefficient field acts centrally.
-/

noncomputable section
namespace GaloisForLFunctions.RepresentationLifting.OperatorKernels

variable {K R M : Type*} [Field K] [Ring R] [Algebra K R]
  [AddCommGroup M] [Module R M] [Module K M] [IsScalarTower K R M]

/-- A cyclic left module with its relation imposed by a genuine quotient. -/
abbrev CyclicLeftQuotient (r : R) := R ⧸ Submodule.span R ({r} : Set R)

/-- The action of a possibly noncentral algebra element is coefficient-field linear. -/
def algebraAction (r : R) : M →ₗ[K] M where
  toFun v := r • v
  map_add' := smul_add r
  map_smul' c v := smul_comm r c v

/-- The canonical generator of the cyclic left quotient. -/
def cyclicLeftGenerator (r : R) : CyclicLeftQuotient r :=
  (Submodule.span R ({r} : Set R)).mkQ 1

theorem cyclicLeftGenerator_relation (r : R) : r • cyclicLeftGenerator r = 0 := by
  change r • (Submodule.span R ({r} : Set R)).mkQ 1 = 0
  rw [← map_smul, smul_eq_mul, mul_one]
  apply LinearMap.mem_ker.mp
  rw [Submodule.ker_mkQ]
  exact Submodule.subset_span (Set.mem_singleton r)

/-- The left-linear map determined by an arbitrary generator image. -/
private def leftGeneratorLift (v : M) : R →ₗ[R] M where
  toFun a := a • v
  map_add' a b := add_smul a b v
  map_smul' a b := mul_smul a b v

private theorem left_relation_le_kernel (r : R)
    (v : LinearMap.ker (algebraAction (K := K) (M := M) r)) :
    Submodule.span R ({r} : Set R) ≤ (leftGeneratorLift v.val).ker := by
  apply Submodule.span_le.mpr
  intro a ha
  rw [Set.mem_singleton_iff] at ha
  subst a
  exact v.property

/-- Exact cyclic generator correspondence over every noncommutative K-algebra. -/
def cyclicLeftHomEquiv (r : R) :
    (CyclicLeftQuotient r →ₗ[R] M) ≃ₗ[K] LinearMap.ker (algebraAction (K := K) (M := M) r) where
  toFun f := ⟨f (cyclicLeftGenerator r), by
    change r • f (cyclicLeftGenerator r) = 0
    rw [← map_smul, cyclicLeftGenerator_relation, map_zero]⟩
  invFun v := (Submodule.span R ({r} : Set R)).liftQ
    (leftGeneratorLift v.val) (left_relation_le_kernel r v)
  left_inv f := by
    apply LinearMap.ext
    intro q
    obtain ⟨a, rfl⟩ := (Submodule.span R ({r} : Set R)).mkQ_surjective q
    change a • f (cyclicLeftGenerator r) = f ((Submodule.span R ({r} : Set R)).mkQ a)
    rw [← map_smul]
    congr 1
    change a • (Submodule.span R ({r} : Set R)).mkQ 1 = _
    rw [← map_smul, smul_eq_mul, mul_one]
  right_inv v := by
    apply Subtype.ext
    change (1 : R) • v.val = v.val
    exact one_smul R v.val
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The cyclic Hom dimension is exactly the nullity of the noncentral relation. -/
theorem finrank_cyclicLeftHom (r : R) :
    Module.finrank K (CyclicLeftQuotient r →ₗ[R] M) =
      Module.finrank K (LinearMap.ker (algebraAction (K := K) (M := M) r)) :=
  (cyclicLeftHomEquiv (K := K) (M := M) r).finrank_eq

section Endomorphisms
variable {V : Type*} [AddCommGroup V] [Module K V]

/-- In the full endomorphism algebra, the annihilator is the original operator kernel. -/
def endCyclicHomEquiv (T : Module.End K V) :
    (CyclicLeftQuotient T →ₗ[Module.End K V] V) ≃ₗ[K] LinearMap.ker T :=
  cyclicLeftHomEquiv (K := K) (M := V) T

/-- Exact multiplicity of the defining representation in a cyclic operator quotient. -/
theorem finrank_endCyclicHom (T : Module.End K V) :
    Module.finrank K (CyclicLeftQuotient T →ₗ[Module.End K V] V) =
      Module.finrank K (LinearMap.ker T) :=
  (endCyclicHomEquiv T).finrank_eq

end Endomorphisms

end GaloisForLFunctions.RepresentationLifting.OperatorKernels

#print axioms GaloisForLFunctions.RepresentationLifting.OperatorKernels.cyclicLeftHomEquiv
#print axioms GaloisForLFunctions.RepresentationLifting.OperatorKernels.finrank_cyclicLeftHom
#print axioms GaloisForLFunctions.RepresentationLifting.OperatorKernels.endCyclicHomEquiv

