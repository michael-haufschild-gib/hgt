import GaloisForLFunctions.RepresentationLifting.Hecke.PermutationKernel

/-!
# The algebra generated by the Hecke kernel action

Four short words span the full matrix algebra off the exact exceptional divisor. The common commutant remains scalar at every specialization.
-/

noncomputable section
open Matrix
namespace GaloisForLFunctions.RepresentationLifting.Hecke

/-- The common commutant is scalar at every parameter, including reducible specializations. -/
theorem kernel_commutant_iff (t : ℂ) (U : Matrix (Fin 2) (Fin 2) ℂ) :
    (U * kernelLeft t = kernelLeft t * U ∧ U * kernelRight t = kernelRight t * U) ↔
      U = U 0 0 • 1 := by
  constructor
  · rintro ⟨hL, hR⟩
    have hL00 := congrFun (congrFun hL 0) 0
    have hL01 := congrFun (congrFun hL 0) 1
    have hR00 := congrFun (congrFun hR 0) 0
    have hR01 := congrFun (congrFun hR 0) 1
    simp [kernelLeft, kernelRight, Matrix.mul_apply, Fin.sum_univ_two] at hL00 hL01 hR00 hR01
    have hb : U 0 1 = 0 := by
      linear_combination -hR00 + (t - 1) * hR01
    have hc : U 1 0 = 0 := by linear_combination -hL00 + t * hb
    have hd : U 1 1 = U 0 0 := by linear_combination -hL01 - (t - 1) * hb
    ext i j
    fin_cases i <;> fin_cases j <;> simp [hb, hc, hd]
  · intro h
    rw [h]
    simp only [Matrix.smul_mul, Matrix.mul_smul, Matrix.one_mul, Matrix.mul_one, and_self]

/-- The four short words in the two-dimensional Hecke action. -/
def kernelWords (t : ℂ) : (Fin 4 → ℂ) →ₗ[ℂ] Matrix (Fin 2) (Fin 2) ℂ where
  toFun c := c 0 • 1 + c 1 • kernelLeft t + c 2 • kernelRight t + c 3 • (kernelLeft t * kernelRight t)
  map_add' c d := by simp [Pi.add_apply, add_smul]; module
  map_smul' a c := by simp [Pi.smul_apply, smul_add, smul_smul]

/-- Explicit matrix entries of the short-word synthesis. -/
theorem kernelWords_apply (t : ℂ) (c : Fin 4 → ℂ) :
    kernelWords t c = !![
      c 0 + (t - 1) * c 1 + t * c 2 - t * c 3, c 1 - c 3;
      t * c 1 - t ^ 2 * c 2 + t ^ 2 * c 3, c 0 - c 2] := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [kernelWords, kernelLeft, kernelRight] <;> ring

/-- The exceptional divisor is the exact failure of independence of the four short words. -/
theorem kernelWords_exceptional_relation (t : ℂ) :
    kernelWords t ![1, t + 1, 1, t + 1] = !![0, 0; t * (t ^ 2 + t + 1), 0] := by
  rw [kernelWords_apply]
  ext i j
  fin_cases i <;> fin_cases j <;> simp <;> ring

/-- The short words are independent exactly away from the zero and cubic specialization divisors. -/
theorem kernelWords_injective_iff (t : ℂ) :
    Function.Injective (kernelWords t) ↔ t * (t ^ 2 + t + 1) ≠ 0 := by
  constructor
  · intro hi hz
    have h := kernelWords_exceptional_relation t
    rw [hz] at h
    have hzero : kernelWords t ![1, t + 1, 1, t + 1] = kernelWords t 0 := by
      rw [map_zero]
      refine h.trans ?_
      ext i j
      fin_cases i <;> fin_cases j <;> rfl
    have hc := congrFun (hi hzero) 0
    exact one_ne_zero hc
  · intro ht
    rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
    intro c hc
    have h : kernelWords t c = 0 := hc
    rw [kernelWords_apply] at h
    have h00 := congrFun (congrFun h 0) 0
    have h01 := congrFun (congrFun h 0) 1
    have h10 := congrFun (congrFun h 1) 0
    have h11 := congrFun (congrFun h 1) 1
    simp at h00 h01 h10 h11
    have h2 : c 2 = 0 := by
      apply (mul_eq_zero.mp (show t * (t ^ 2 + t + 1) * c 2 = 0 by
        linear_combination h10 + t * (t + 1) * h00 - t * (t + 1) * h11 - t ^ 3 * h01)).resolve_left ht
    have h0 : c 0 = 0 := by linear_combination h11 + h2
    have h1 : c 1 = 0 := by linear_combination -h00 + h11 + t * h01 + (t + 1) * h2
    have h3 : c 3 = 0 := by linear_combination h1 - h01
    funext i
    fin_cases i <;> assumption

/-- Away from the exceptional divisor, every matrix is an explicit linear combination of the four short words. -/
theorem kernelWords_surjective (t : ℂ) (ht : t * (t ^ 2 + t + 1) ≠ 0) :
    Function.Surjective (kernelWords t) := by
  intro U
  let b := (U 1 0 - t ^ 3 * U 0 1 - t * (t + 1) * (U 1 1 - U 0 0)) /
    (t * (t ^ 2 + t + 1))
  let a := (t + 1) * b + t * U 0 1 + U 1 1 - U 0 0
  have hb : t * (t ^ 2 + t + 1) * b =
      U 1 0 - t ^ 3 * U 0 1 - t * (t + 1) * (U 1 1 - U 0 0) := by
    dsimp only [b]
    exact (mul_comm _ _).trans (div_mul_cancel₀ _ ht)
  refine ⟨![U 1 1 + b, a, b, a - U 0 1], ?_⟩
  rw [kernelWords_apply]
  ext i j
  fin_cases i <;> fin_cases j
  · simp [a]
    ring
  · simp [a]
  · simp [a]
    linear_combination hb
  · simp

/-- A genuine matrix-algebra basis on the nonexceptional specialization locus. -/
def kernelWordEquiv (t : ℂ) (ht : t * (t ^ 2 + t + 1) ≠ 0) :
    (Fin 4 → ℂ) ≃ₗ[ℂ] Matrix (Fin 2) (Fin 2) ℂ :=
  LinearEquiv.ofBijective (kernelWords t)
    ⟨(kernelWords_injective_iff t).mpr ht, kernelWords_surjective t ht⟩

#print axioms kernel_commutant_iff
#print axioms kernelWords_injective_iff
#print axioms kernelWordEquiv
end GaloisForLFunctions.RepresentationLifting.Hecke
