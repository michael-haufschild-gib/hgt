import GaloisForLFunctions.RepresentationLifting.TruncatedPolynomialAlgebra
import Mathlib.Algebra.Homology.ShortComplex.ModuleCat
import Mathlib.Algebra.Category.ModuleCat.Abelian
import Mathlib.Algebra.Category.ModuleCat.Projective
import Mathlib.CategoryTheory.Preadditive.Projective.Resolution

/-!
# The rank-one periodic complex of a truncated polynomial algebra

For `A = R[x]/(xⁿ⁺²)`, alternate multiplication by `x` and `xⁿ⁺¹`.
Every positive chain degree is exact, and the augmentation is the quotient
by `x`. Thus the coefficient residue module has an explicit free resolution.
-/

noncomputable section

namespace GaloisForLFunctions.RepresentationLifting

open CategoryTheory

variable (R : Type*) [CommRing R]

/-- The exponent of the differential from degree `q + 1` to degree `q`. -/
def truncatedPeriodicExponent (n q : ℕ) : ℕ := if q % 2 = 0 then 1 else n + 1

theorem truncatedPeriodicExponent_add (n q : ℕ) :
    truncatedPeriodicExponent n q + truncatedPeriodicExponent n (q + 1) = n + 2 := by
  unfold truncatedPeriodicExponent
  split <;> split <;> omega

/-- Every term is free of rank one over the truncated polynomial algebra. -/
abbrev TruncatedPeriodicTerm (n : ℕ) :=
  ModuleCat.of (TruncatedPolynomialAlgebra R (n + 2)) (TruncatedPolynomialAlgebra R (n + 2))

def truncatedPeriodicDifferential (n q : ℕ) :
    TruncatedPeriodicTerm R n ⟶ TruncatedPeriodicTerm R n :=
  ModuleCat.ofHom (truncatedRootMul R (n + 2) (truncatedPeriodicExponent n q))

theorem truncatedPeriodicDifferential_comp (n q : ℕ) :
    truncatedPeriodicDifferential R n (q + 1) ≫ truncatedPeriodicDifferential R n q = 0 := by
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro v
  change truncatedRoot R (n + 2) ^ truncatedPeriodicExponent n q *
    (truncatedRoot R (n + 2) ^ truncatedPeriodicExponent n (q + 1) * v) = 0
  rw [← mul_assoc, ← pow_add, truncatedPeriodicExponent_add, truncatedRoot_pow_horizon, zero_mul]

/-- The actual infinite chain complex, with the displayed alternating differentials. -/
def truncatedPeriodicComplex (n : ℕ) :
    ChainComplex (ModuleCat (TruncatedPolynomialAlgebra R (n + 2))) ℕ :=
  ChainComplex.of (fun _ => TruncatedPeriodicTerm R n)
    (truncatedPeriodicDifferential R n) (truncatedPeriodicDifferential_comp R n)

@[simp] theorem truncatedPeriodicComplex_d (n q : ℕ) :
    (truncatedPeriodicComplex R n).d (q + 1) q = truncatedPeriodicDifferential R n q := by
  simp [truncatedPeriodicComplex]

theorem truncatedPeriodicDifferential_range_eq_ker (n q : ℕ) :
    LinearMap.range (truncatedPeriodicDifferential R n (q + 1)).hom =
      LinearMap.ker (truncatedPeriodicDifferential R n q).hom := by
  have h := truncatedRootMul_periodic_exact R (n + 1)
  by_cases hq : q % 2 = 0
  · have hq' : (q + 1) % 2 ≠ 0 := by omega
    simpa only [truncatedPeriodicDifferential, ModuleCat.hom_ofHom,
      truncatedPeriodicExponent, if_pos hq, if_neg hq'] using h.2
  · have hq' : (q + 1) % 2 = 0 := by omega
    simpa only [truncatedPeriodicDifferential, ModuleCat.hom_ofHom,
      truncatedPeriodicExponent, if_neg hq, if_pos hq'] using h.1

/-- No homology remains in positive degrees. -/
theorem truncatedPeriodicComplex_exactAt_succ (n q : ℕ) :
    (truncatedPeriodicComplex R n).ExactAt (q + 1) := by
  rw [HomologicalComplex.exactAt_iff' _ (q + 2) (q + 1) q (by simp) (by simp)]
  rw [ShortComplex.moduleCat_exact_iff_range_eq_ker]
  change LinearMap.range ((truncatedPeriodicComplex R n).d (q + 2) (q + 1)).hom =
    LinearMap.ker ((truncatedPeriodicComplex R n).d (q + 1) q).hom
  rw [truncatedPeriodicComplex_d, truncatedPeriodicComplex_d]
  exact truncatedPeriodicDifferential_range_eq_ker R n q

instance truncatedPeriodicTerm_projective (n : ℕ) : Projective (TruncatedPeriodicTerm R n) :=
  ModuleCat.projective_of_free (Module.Basis.singleton Unit _)

/-- The augmentation ideal generated by the residue of `x`. -/
def truncatedAugmentationIdeal (n : ℕ) : Ideal (TruncatedPolynomialAlgebra R (n + 2)) :=
  Ideal.span {truncatedRoot R (n + 2)}

/-- The coefficient residue module. -/
abbrev TruncatedResidue (n : ℕ) :=
  TruncatedPolynomialAlgebra R (n + 2) ⧸ truncatedAugmentationIdeal R n

def truncatedAugmentation (n : ℕ) :
    TruncatedPeriodicTerm R n ⟶
      ModuleCat.of (TruncatedPolynomialAlgebra R (n + 2)) (TruncatedResidue R n) :=
  ModuleCat.ofHom (truncatedAugmentationIdeal R n).mkQ

/-- The augmentation has exactly the image of the first differential as its kernel. -/
theorem truncatedAugmentation_range_eq_ker (n : ℕ) :
    LinearMap.range (truncatedPeriodicDifferential R n 0).hom =
      LinearMap.ker (truncatedAugmentation R n).hom := by
  change LinearMap.range (truncatedRootMul R (n + 2) 1) =
    LinearMap.ker (truncatedAugmentationIdeal R n).mkQ
  rw [Submodule.ker_mkQ]
  ext v
  rw [truncatedAugmentationIdeal, Ideal.mem_span_singleton]
  change (∃ w, truncatedRoot R (n + 2) ^ 1 * w = v) ↔ truncatedRoot R (n + 2) ∣ v
  simp only [pow_one, dvd_def, eq_comm]

theorem truncatedAugmentation_surjective (n : ℕ) : Function.Surjective (truncatedAugmentation R n) :=
  (truncatedAugmentationIdeal R n).mkQ_surjective

theorem truncatedAugmentation_comp (n : ℕ) :
    truncatedPeriodicDifferential R n 0 ≫ truncatedAugmentation R n = 0 := by
  apply ModuleCat.hom_ext
  exact LinearMap.range_le_ker_iff.mp (truncatedAugmentation_range_eq_ker R n).le

/-- The chain map augmenting the periodic complex to its coefficient residue module. -/
def truncatedPeriodicAugmentation (n : ℕ) :
    truncatedPeriodicComplex R n ⟶
      (ChainComplex.single₀ (ModuleCat (TruncatedPolynomialAlgebra R (n + 2)))).obj
        (ModuleCat.of (TruncatedPolynomialAlgebra R (n + 2)) (TruncatedResidue R n)) :=
  (ChainComplex.toSingle₀Equiv _ _).symm ⟨truncatedAugmentation R n, by
    rw [truncatedPeriodicComplex_d]
    exact truncatedAugmentation_comp R n⟩

@[simp] theorem truncatedPeriodicAugmentation_f_zero (n : ℕ) :
    (truncatedPeriodicAugmentation R n).f 0 = truncatedAugmentation R n :=
  ChainComplex.toSingle₀Equiv_symm_apply_f_zero _ _

/-- Exactness and surjectivity of the augmentation identify the zeroth homology. -/
instance truncatedPeriodicAugmentation_quasiIso (n : ℕ) :
    QuasiIso (truncatedPeriodicAugmentation R n) := by
  constructor
  intro q
  cases q with
  | zero =>
    rw [ChainComplex.quasiIsoAt₀_iff]
    rw [ShortComplex.quasiIso_iff_of_zeros' _ (by simp; rfl) (by simp; rfl) (by simp; rfl)]
    constructor
    · rw [ShortComplex.moduleCat_exact_iff_range_eq_ker]
      change LinearMap.range ((truncatedPeriodicComplex R n).d 1 0).hom =
        LinearMap.ker ((truncatedPeriodicAugmentation R n).f 0).hom
      rw [truncatedPeriodicComplex_d, truncatedPeriodicAugmentation_f_zero]
      exact truncatedAugmentation_range_eq_ker R n
    · change Epi ((truncatedPeriodicAugmentation R n).f 0)
      rw [truncatedPeriodicAugmentation_f_zero]
      exact (ModuleCat.epi_iff_surjective _).mpr (truncatedAugmentation_surjective R n)
  | succ q =>
    apply (quasiIsoAt_iff_exactAt' _ _
      (ChainComplex.exactAt_succ_single_obj _ q)).mpr
    exact truncatedPeriodicComplex_exactAt_succ R n q

/-- The explicit two-periodic projective resolution, with every term free of rank one. -/
def truncatedProjectiveResolution (n : ℕ) :
    ProjectiveResolution
      (ModuleCat.of (TruncatedPolynomialAlgebra R (n + 2)) (TruncatedResidue R n)) where
  complex := truncatedPeriodicComplex R n
  projective _ := truncatedPeriodicTerm_projective R n
  π := truncatedPeriodicAugmentation R n

end GaloisForLFunctions.RepresentationLifting

#print axioms GaloisForLFunctions.RepresentationLifting.truncatedPeriodicComplex_exactAt_succ
#print axioms GaloisForLFunctions.RepresentationLifting.truncatedAugmentation_range_eq_ker
#print axioms GaloisForLFunctions.RepresentationLifting.truncatedProjectiveResolution
