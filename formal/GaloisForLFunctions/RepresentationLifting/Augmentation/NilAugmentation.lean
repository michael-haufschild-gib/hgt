import GaloisForLFunctions.HTGeometry.GroupAlgebras.FirstJet
import Mathlib.Algebra.CharP.Lemmas
import Mathlib.RingTheory.Nilpotent.Lemmas

/-!
# Nil augmentation ideals of primary torsion groups

The augmentation ideal of an abelian group algebra is generated by the
differences `[g] - 1`. In characteristic `p`, a label killed by `p^n`
gives a difference whose `p^n`-th power vanishes. Thus a primary torsion
group has a nil augmentation ideal, without any finiteness assumption
on the group or any uniform bound on its element orders.
-/

noncomputable section
namespace GaloisForLFunctions.RepresentationLifting
open HTGeometry.GroupAlgebraFirstJet
variable {R G : Type*} [CommRing R] [CommGroup G]

/-- The coefficient inclusion and augmentation force the same characteristic on the group algebra. -/
theorem groupAlgebra_charP (p : ℕ) [CharP R p] : CharP (MonoidAlgebra R G) p where
  cast_eq_zero_iff n := by
    constructor
    · intro hn
      have h := congrArg (augmentation R G) hn
      simp only [map_natCast, map_zero] at h
      exact (CharP.cast_eq_zero_iff R p n).mp h
    · intro hn
      have h := congrArg (algebraMap R (MonoidAlgebra R G))
        ((CharP.cast_eq_zero_iff R p n).mpr hn)
      simpa only [map_natCast, map_zero] using h

/-- Differences of group labels from the identity generate the augmentation ideal. -/
theorem augmentationIdeal_eq_span_roots :
    augmentationIdeal R G = Ideal.span (Set.range fun g => MonoidAlgebra.of R G g - 1) := by
  let J : Ideal (MonoidAlgebra R G) :=
    Ideal.span (Set.range fun g => MonoidAlgebra.of R G g - 1)
  let q := Ideal.Quotient.mkₐ R J
  have hq : q.toLinearMap =
      ((Algebra.ofId R (MonoidAlgebra R G ⧸ J)).comp (augmentation R G)).toLinearMap := by
    apply (MonoidAlgebra.basis G R).ext
    intro g
    change q (MonoidAlgebra.of R G g) =
      algebraMap R (MonoidAlgebra R G ⧸ J) (augmentation R G (MonoidAlgebra.of R G g))
    rw [augmentation_of, map_one]
    have hz : q (MonoidAlgebra.of R G g - 1) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨g, rfl⟩)
    rw [map_sub, map_one] at hz
    exact sub_eq_zero.mp hz
  apply le_antisymm
  · intro x hx
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change q x = 0
    have he := LinearMap.congr_fun hq x
    change q x = algebraMap R (MonoidAlgebra R G ⧸ J) (augmentation R G x) at he
    rw [show augmentation R G x = 0 from hx, map_zero] at he
    exact he
  · apply Ideal.span_le.mpr
    rintro _ ⟨g, rfl⟩
    exact root_mem R G g

/-- A primary torsion label gives a nilpotent augmentation generator. -/
theorem augmentation_root_isNilpotent (p : ℕ) [Fact p.Prime] [CharP R p]
    (g : G) (hg : ∃ n : ℕ, g ^ (p ^ n) = 1) :
    IsNilpotent (MonoidAlgebra.of R G g - 1) := by
  letI := groupAlgebra_charP (R := R) (G := G) p
  obtain ⟨n, hn⟩ := hg
  refine ⟨p ^ n, ?_⟩
  rw [sub_pow_char_pow, ← map_pow, hn, map_one, one_pow, sub_self]

/-- Every element of the augmentation ideal of an abelian primary torsion group is nilpotent. -/
theorem augmentationIdeal_le_nilradical (p : ℕ) [Fact p.Prime] [CharP R p]
    (hG : ∀ g : G, ∃ n : ℕ, g ^ (p ^ n) = 1) :
    augmentationIdeal R G ≤ nilradical (MonoidAlgebra R G) := by
  rw [augmentationIdeal_eq_span_roots]
  apply Ideal.span_le.mpr
  rintro _ ⟨g, rfl⟩
  exact mem_nilradical.mpr (augmentation_root_isNilpotent p g (hG g))

/-- Over reduced coefficients, the primary augmentation ideal is exactly the nilradical. -/
theorem augmentationIdeal_eq_nilradical [IsReduced R]
    (p : ℕ) [Fact p.Prime] [CharP R p]
    (hG : ∀ g : G, ∃ n : ℕ, g ^ (p ^ n) = 1) :
    augmentationIdeal R G = nilradical (MonoidAlgebra R G) := by
  apply le_antisymm (augmentationIdeal_le_nilradical p hG)
  intro x hx
  change augmentation R G x = 0
  exact ((mem_nilradical.mp hx).map (augmentation R G)).eq_zero

#print axioms augmentationIdeal_eq_span_roots
#print axioms augmentationIdeal_le_nilradical
#print axioms augmentationIdeal_eq_nilradical

end GaloisForLFunctions.RepresentationLifting
