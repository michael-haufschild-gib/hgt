import GaloisForLFunctions.RHTower.SquarefreeDiscrepancyZeroCascade
import GaloisForLFunctions.RHTower.WeightMismatchRefutation
import GaloisForLFunctions.RHTower.ZetaZeroOrderReflection
import GaloisForLFunctions.RHTower.XiCanonicalProduct
import GaloisForLFunctions.MetaplecticMobiusDescent.Detector.QuasiRiemannHypothesis

/-!
# The closed configurations of halving and doubling

Every off-line zero `ρ` of `ζ` (`Re ρ > ½`) satisfies `½ < Re ρ ≤ 7/8` and `Im ρ ≠ 0`, and forces
its four-element symmetric quartet `Q(ρ) = {ρ, ρ̄, 1 − ρ, 1 − ρ̄}` with identical analytic and
meromorphic multiplicities (`zeta_offLine_quartet`).

This module classifies all strip configurations closed under the zero-transport laws induced by
`ζ(s)^m / ζ(ks)` (`k ≥ 2`, specializing at `k = 2` to `ζ(s)/ζ(2s)` and `ζ(s)²/ζ(2s)`) and by
`ζ(2s)/ζ(s)`, combined with functional-equation symmetry:

* **`k`-fold descent (`z ↦ z / k`, `k ≥ 2`).** For any locally finite quartet-symmetric
  configuration `Z ⊆ {0 < Re s < 1}`:
  - `Z` is closed under full-strip descent (`∀ z ∈ Z, z / k ∈ Z`) iff `Z = ∅`
    (`closed_full_descent_iff_empty`).
  - `Z` is closed under right-zero descent (`∀ z ∈ Z, ½ < Re z → z / k ∈ Z`) iff every point of
    `Z` with `Re z > ½` equals the real fixed point `k / (k + 1)`
    (`closed_right_descent_iff`).
  - When `Z` has no real zeros (`∀ z ∈ Z, Im z ≠ 0`, which holds unconditionally for `ζ`), `Z` is
    closed under right-zero descent iff every point of `Z` lies on the critical line `Re z = ½`
    (`closed_right_descent_no_real_iff_onLine`).
  - Adding one off-line quartet `Q(ρ)` (`½ < Re ρ < 1`, `Im ρ ≠ 0`) to any locally finite
    critical-line configuration is never closed under right-zero `k`-descent
    (`not_closed_right_descent_union_quartet`).
* **Doubling (`z ↦ 2z`).** For any quartet-symmetric configuration `Z ⊆ {0 < Re s < 1}`:
  - `Z` is closed under full-strip doubling (`∀ z ∈ Z, 2z ∈ Z`) iff `Z = ∅`
    (`closed_full_doubling_iff_empty`).
  - `Z` is closed under right-zero doubling (`∀ z ∈ Z, ½ < Re z → 2z ∈ Z`) iff every point of `Z`
    lies on `Re z = ½` (`closed_right_doubling_iff_onLine`).
  - Under left-zero doubling (`∀ z ∈ Z, Re z < ½ → 2z ∈ Z`), an off-line zero at depth
    `δ = Re ρ − ½ ∈ (0, ½)` cascades along `(δ, γ) ↦ (|2δ − ½|, 2γ)`. The tent map
    `T(δ) = |2δ − ½|` reaches `0` in `k + 1` steps iff `δ = (2m + 1) / 2^{k + 2}` for `m < 2^k`
    (`tentMap_iterate_eq_zero_iff`). Consequently, every real-zero-free configuration with finite
    off-line support closed under left-zero doubling has all right-hand depths at odd dyadic
    rationals `(2m + 1) / 2^{k + 2}` terminating at critical-line partners `½ + 2^{k + 1} i Im ρ`
    (`odd_dyadic_depth_of_closed_left_doubling`).
  - A single off-line quartet `Q(ρ)` with no partner is never closed under left-zero doubling
    (`not_closed_left_doubling_quartet`), and `Z_crit ∪ Q(ρ)` is closed iff `Re ρ = 3/4` and
    `½ + 2i Im ρ ∈ Z_crit` (`closed_left_doubling_union_quartet_iff`).
-/

noncomputable section

open Complex Set Filter Topology

namespace GaloisForLFunctions.ZeroForcingCalculus

/-! ### 1. The unconditional quartet of an off-line zero of `ζ` -/

/-- `ζ` has no real zeros in the open critical strip `(0, 1)`: `(x − 1)ζ(x) > 0` for all `x > 0`. -/
theorem riemannZeta_ne_zero_of_im_eq_zero_of_mem_strip {s : ℂ} (h0 : 0 < s.re) (h1 : s.re < 1)
    (him : s.im = 0) : riemannZeta s ≠ 0 := by
  obtain ⟨r, hr, hZ⟩ := RHTower.exists_zetaResidueUnit_ofReal_eq_pos h0
  intro hz
  have hs : (s.re : ℂ) = s := Complex.ext rfl him.symm
  rw [hs] at hZ
  have hne1 : s ≠ 1 := fun h => by
    rw [h, Complex.one_re] at h1
    exact lt_irrefl 1 h1
  rw [RHTower.zetaResidueUnit, Function.update_of_ne hne1, hz, mul_zero] at hZ
  exact (by exact_mod_cast hr.ne' : (r : ℂ) ≠ 0) hZ.symm

/-- The four-point symmetric quartet `{ρ, ρ̄, 1 − ρ, 1 − ρ̄}` generated by Schwarz reflection and the
functional equation. -/
def zeroQuartet (ρ : ℂ) : Finset ℂ :=
  {ρ, starRingEnd ℂ ρ, 1 - ρ, 1 - starRingEnd ℂ ρ}

@[simp]
theorem mem_zeroQuartet {z ρ : ℂ} :
    z ∈ zeroQuartet ρ ↔
      z = ρ ∨ z = starRingEnd ℂ ρ ∨ z = 1 - ρ ∨ z = 1 - starRingEnd ℂ ρ := by
  simp [zeroQuartet]

/-- Off the critical line and off the real axis, the quartet consists of four distinct points. -/
theorem card_zeroQuartet_eq_four {ρ : ℂ} (hre : ρ.re ≠ 1 / 2) (him : ρ.im ≠ 0) :
    (zeroQuartet ρ).card = 4 := by
  have h12 : ρ ≠ starRingEnd ℂ ρ := fun h => by
    have hi := congrArg Complex.im h
    rw [Complex.conj_im] at hi
    exact him (by linarith)
  have h13 : ρ ≠ 1 - ρ := fun h => by
    have hr := congrArg Complex.re h
    rw [Complex.sub_re, Complex.one_re] at hr
    exact hre (by linarith)
  have h14 : ρ ≠ 1 - starRingEnd ℂ ρ := fun h => by
    have hr := congrArg Complex.re h
    rw [Complex.sub_re, Complex.one_re, Complex.conj_re] at hr
    exact hre (by linarith)
  have h23 : starRingEnd ℂ ρ ≠ 1 - ρ := fun h => by
    have hr := congrArg Complex.re h
    rw [Complex.conj_re, Complex.sub_re, Complex.one_re] at hr
    exact hre (by linarith)
  have h24 : starRingEnd ℂ ρ ≠ 1 - starRingEnd ℂ ρ := fun h => by
    have hr := congrArg Complex.re h
    rw [Complex.conj_re, Complex.sub_re, Complex.one_re, Complex.conj_re] at hr
    exact hre (by linarith)
  have h34 : (1 : ℂ) - ρ ≠ 1 - starRingEnd ℂ ρ := fun h =>
    h12 (by linear_combination -h)
  rw [zeroQuartet, Finset.card_insert_of_notMem, Finset.card_insert_of_notMem,
    Finset.card_insert_of_notMem, Finset.card_singleton]
  · simp [h34]
  · simp [h23, h24]
  · simp [h12, h13, h14]

private theorem analyticAt_riemannZeta_of_ne_one {z : ℂ} (hz : z ≠ 1) :
    AnalyticAt ℂ riemannZeta z := by
  have hd : DifferentiableOn ℂ riemannZeta {w : ℂ | w ≠ 1} := fun w hw =>
    (differentiableAt_riemannZeta hw).differentiableWithinAt
  exact hd.analyticAt (isOpen_ne.mem_nhds hz)

/-- **Unconditional off-line quartet theorem.** Every zero `ρ` of `ζ` strictly right of the
critical line lies in `(½, 7/8]` with nonzero ordinate and forces four pairwise distinct zeros
`{ρ, ρ̄, 1 − ρ, 1 − ρ̄}` of equal analytic and meromorphic multiplicity. -/
theorem zeta_offLine_quartet {ρ : ℂ} (hre : 1 / 2 < ρ.re) (hz : riemannZeta ρ = 0) :
    ρ.re ≤ 7 / 8 ∧ ρ.im ≠ 0 ∧ (zeroQuartet ρ).card = 4 ∧
      ∀ z ∈ zeroQuartet ρ,
        0 < z.re ∧ z.re < 1 ∧ riemannZeta z = 0 ∧
          analyticOrderAt riemannZeta z = analyticOrderAt riemannZeta ρ ∧
          meromorphicOrderAt riemannZeta z = meromorphicOrderAt riemannZeta ρ := by
  have h0 : 0 < ρ.re := by linarith
  have h78 : ρ.re ≤ 7 / 8 :=
    (GaloisForLFunctions.MetaplecticMobiusDescent.CubicEisenstein.riemannZeta_zero_mem_quasiRH_strip
      h0 hz).2
  have h1 : ρ.re < 1 := by linarith
  have him : ρ.im ≠ 0 := fun him0 =>
    riemannZeta_ne_zero_of_im_eq_zero_of_mem_strip h0 h1 him0 hz
  have hcard : (zeroQuartet ρ).card = 4 :=
    card_zeroQuartet_eq_four (by linarith) him
  refine ⟨h78, him, hcard, fun z hzQ => ?_⟩
  have hzstrip : 0 < z.re ∧ z.re < 1 := by
    rcases mem_zeroQuartet.mp hzQ with rfl | rfl | rfl | rfl
    · exact ⟨h0, h1⟩
    · rw [Complex.conj_re]
      exact ⟨h0, h1⟩
    · rw [Complex.sub_re, Complex.one_re]
      exact ⟨by linarith, by linarith⟩
    · rw [Complex.sub_re, Complex.one_re, Complex.conj_re]
      exact ⟨by linarith, by linarith⟩
  have haord : analyticOrderAt riemannZeta z = analyticOrderAt riemannZeta ρ := by
    have hxi_z := RHTower.xi_analyticOrderAt_eq_riemannZeta_of_mem_strip hzstrip
    have hxi_ρ := RHTower.xi_analyticOrderAt_eq_riemannZeta_of_mem_strip ⟨h0, h1⟩
    obtain ⟨hq1, hq2, hq3⟩ := RHTower.xi_orderAt_quadruple_eq ρ
    rw [← hxi_z, ← hxi_ρ]
    rcases mem_zeroQuartet.mp hzQ with rfl | rfl | rfl | rfl
    · rfl
    · exact hq2
    · exact hq1
    · exact hq3
  have hzne1 : z ≠ 1 := fun h => by
    rw [h, Complex.one_re] at hzstrip
    exact lt_irrefl 1 hzstrip.2
  have hρne1 : ρ ≠ 1 := fun h => by
    rw [h, Complex.one_re] at h1
    exact lt_irrefl 1 h1
  have hmord : meromorphicOrderAt riemannZeta z = meromorphicOrderAt riemannZeta ρ := by
    rw [(analyticAt_riemannZeta_of_ne_one hzne1).meromorphicOrderAt_eq,
      (analyticAt_riemannZeta_of_ne_one hρne1).meromorphicOrderAt_eq, haord]
  have hzz : riemannZeta z = 0 := by
    rcases mem_zeroQuartet.mp hzQ with rfl | rfl | rfl | rfl
    · exact hz
    · rw [riemannZeta_conj, hz, map_zero]
    · exact (RHTower.riemannZeta_one_sub_eq_zero_iff h0 h1).mpr hz
    · have hc : riemannZeta (starRingEnd ℂ ρ) = 0 := by
        rw [riemannZeta_conj, hz, map_zero]
      exact (RHTower.riemannZeta_one_sub_eq_zero_iff
        (by rw [Complex.conj_re]; exact h0)
        (by rw [Complex.conj_re]; exact h1)).mpr hc
  exact ⟨hzstrip.1, hzstrip.2, hzz, haord, hmord⟩

/-! ### 2. Strip symmetry and closed configurations of `k`-fold descent -/

/-- A subset of the open critical strip `{0 < Re s < 1}` symmetric under conjugation and
functional reflection `z ↦ 1 − z`. -/
structure IsQuartetSymmetric (Z : Set ℂ) : Prop where
  strip : ∀ z ∈ Z, 0 < z.re ∧ z.re < 1
  conj_mem : ∀ z ∈ Z, starRingEnd ℂ z ∈ Z
  reflect_mem : ∀ z ∈ Z, 1 - z ∈ Z

/-- Local finiteness on compact subsets of the open critical strip. -/
def IsStripLocallyFinite (Z : Set ℂ) : Prop :=
  ∀ K : Set ℂ, IsCompact K → K ⊆ {z : ℂ | 0 < z.re ∧ z.re < 1} → (Z ∩ K).Finite

theorem IsQuartetSymmetric.mirror_mem {Z : Set ℂ} (hZ : IsQuartetSymmetric Z) {z : ℂ}
    (hz : z ∈ Z) : 1 - starRingEnd ℂ z ∈ Z :=
  hZ.reflect_mem _ (hZ.conj_mem z hz)

/-- The nontrivial zero locus of `ζ` is quartet-symmetric. -/
theorem isQuartetSymmetric_zetaStripZeros :
    IsQuartetSymmetric {s : ℂ | 0 < s.re ∧ s.re < 1 ∧ riemannZeta s = 0} where
  strip _ hz := ⟨hz.1, hz.2.1⟩
  conj_mem z hz := by
    refine ⟨by rw [Complex.conj_re]; exact hz.1, by rw [Complex.conj_re]; exact hz.2.1, ?_⟩
    rw [riemannZeta_conj, hz.2.2, map_zero]
  reflect_mem z hz := by
    refine ⟨by rw [Complex.sub_re, Complex.one_re]; linarith [hz.2.1],
      by rw [Complex.sub_re, Complex.one_re]; linarith [hz.1], ?_⟩
    exact (RHTower.riemannZeta_one_sub_eq_zero_iff hz.1 hz.2.1).mpr hz.2.2

/-- The nontrivial zero locus of `ζ` is locally finite on compact subsets of the open strip. -/
theorem isStripLocallyFinite_zetaStripZeros :
    IsStripLocallyFinite {s : ℂ | 0 < s.re ∧ s.re < 1 ∧ riemannZeta s = 0} := by
  intro K hK _hKsub
  have hloc : LocallyFiniteSupport
      (fun z : ℂ => MeromorphicOn.divisor RHTower.xi Set.univ z) := fun z =>
    (MeromorphicOn.divisor RHTower.xi Set.univ).supportLocallyFiniteWithinDomain' z (Set.mem_univ z)
  have hfinI : {i : RHTower.XiDivisorSupport | ({(i : ℂ)} ∩ K).Nonempty}.Finite :=
    hloc.locallyFinite_support.finite_nonempty_inter_compact hK
  refine (hfinI.image Subtype.val).subset ?_
  intro z ⟨⟨h0, h1, hz⟩, hzK⟩
  have hne1 : z ≠ 1 := fun h => by
    rw [h, Complex.one_re] at h1
    exact lt_irrefl 1 h1
  have hxi : RHTower.xi z = 0 := (RHTower.xi_eq_zero_iff h0 hne1).mpr hz
  exact ⟨⟨z, RHTower.mem_xi_divisor_support_of_eq_zero hxi⟩, ⟨z, rfl, hzK⟩, rfl⟩

/-- The `k`-fold descent-reflection step `z ↦ 1 − z / k`, with fixed point `k / (k + 1)`. -/
def descentReflectStep (k : ℕ) (z : ℂ) : ℂ := 1 - z / (k : ℂ)

theorem descentReflectStep_iterate_eq (k : ℕ) (hk : 1 ≤ k) (z : ℂ) (n : ℕ) :
    (descentReflectStep k)^[n] z =
      (k : ℂ) / ((k : ℂ) + 1) +
        (-(1 / (k : ℂ))) ^ n * (z - (k : ℂ) / ((k : ℂ) + 1)) := by
  have hk0 : (k : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  have hk1 : (k : ℂ) + 1 ≠ 0 := by exact_mod_cast Nat.succ_ne_zero k
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Function.iterate_succ_apply', ih, descentReflectStep, pow_succ]
    field_simp
    ring

private theorem isCompact_stripBox (a b M : ℝ) :
    IsCompact {z : ℂ | a ≤ z.re ∧ z.re ≤ b ∧ |z.im| ≤ M} := by
  rw [Metric.isCompact_iff_isClosed_bounded]
  refine ⟨?_, ?_⟩
  · exact (isClosed_le continuous_const Complex.continuous_re).inter
      ((isClosed_le Complex.continuous_re continuous_const).inter
        (isClosed_le (continuous_abs.comp Complex.continuous_im) continuous_const))
  · rw [Metric.isBounded_iff_subset_closedBall 0]
    refine ⟨max |a| |b| + |M|, fun z ⟨hza, hzb, hzim⟩ => ?_⟩
    rw [Metric.mem_closedBall, dist_zero_right]
    have hre_abs : |z.re| ≤ max |a| |b| := by
      rcases le_or_gt 0 z.re with h0 | h0
      · rw [abs_of_nonneg h0]
        exact (hzb.trans (le_abs_self b)).trans (le_max_right _ _)
      · rw [abs_of_neg h0]
        have : -z.re ≤ |a| := (neg_le_neg hza).trans (neg_le_abs a)
        exact this.trans (le_max_left _ _)
    have him_abs : |z.im| ≤ |M| := hzim.trans (le_abs_self M)
    calc ‖z‖ ≤ |z.re| + |z.im| := Complex.norm_le_abs_re_add_abs_im z
      _ ≤ max |a| |b| + |M| := add_le_add hre_abs him_abs

/-- **Classification of right-zero `k`-descent.** For `k ≥ 2`, a locally finite quartet-symmetric
configuration `Z` is closed under right-zero `k`-descent (`∀ z ∈ Z, ½ < Re z → z / k ∈ Z`) if and
only if its strict right half-strip `Z ∩ {Re z > ½}` lies inside `{k / (k + 1)}`. -/
theorem closed_right_descent_iff {Z : Set ℂ} (hZ : IsQuartetSymmetric Z)
    (hfin : IsStripLocallyFinite Z) {k : ℕ} (hk : 2 ≤ k) :
    (∀ z ∈ Z, 1 / 2 < z.re → z / (k : ℂ) ∈ Z) ↔
      ∀ z ∈ Z, 1 / 2 < z.re → z = (k : ℂ) / ((k : ℂ) + 1) := by
  have hkR : (2 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk
  have hk0 : (0 : ℝ) < (k : ℝ) := by linarith
  have hkC0 : (k : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  have hk1C : (k : ℂ) + 1 ≠ 0 := by exact_mod_cast Nat.succ_ne_zero k
  constructor
  · intro hdesc z hz hre
    by_contra hne
    -- Every iterate of `z ↦ 1 − z / k` stays in `Z` with real part in `(½, 1)`
    have horb : ∀ n : ℕ, (descentReflectStep k)^[n] z ∈ Z ∧
        1 / 2 < ((descentReflectStep k)^[n] z).re ∧
        ((descentReflectStep k)^[n] z).re < 1 ∧
        |((descentReflectStep k)^[n] z).im| ≤ |z.im| := by
      intro n
      induction n with
      | zero => exact ⟨hz, hre, (hZ.strip z hz).2, le_rfl⟩
      | succ n ih =>
        rw [Function.iterate_succ_apply']
        obtain ⟨hmem, hlo, hhi, him⟩ := ih
        have hdiv : ((descentReflectStep k)^[n] z) / (k : ℂ) ∈ Z := hdesc _ hmem hlo
        have hrefl : descentReflectStep k ((descentReflectStep k)^[n] z) ∈ Z :=
          hZ.reflect_mem _ hdiv
        have hdiv_re : (((descentReflectStep k)^[n] z) / (k : ℂ)).re =
            ((descentReflectStep k)^[n] z).re / (k : ℝ) := by
          rw [show ((k : ℂ)) = ((k : ℝ) : ℂ) by norm_cast, div_eq_mul_inv,
            ← Complex.ofReal_inv, mul_comm, Complex.re_ofReal_mul]
          ring
        have hdiv_im : (((descentReflectStep k)^[n] z) / (k : ℂ)).im =
            ((descentReflectStep k)^[n] z).im / (k : ℝ) := by
          rw [show ((k : ℂ)) = ((k : ℝ) : ℂ) by norm_cast, div_eq_mul_inv,
            ← Complex.ofReal_inv, mul_comm, Complex.im_ofReal_mul]
          ring
        have hstep_re : (descentReflectStep k ((descentReflectStep k)^[n] z)).re =
            1 - ((descentReflectStep k)^[n] z).re / (k : ℝ) := by
          rw [descentReflectStep, Complex.sub_re, Complex.one_re, hdiv_re]
        have hstep_im : (descentReflectStep k ((descentReflectStep k)^[n] z)).im =
            -(((descentReflectStep k)^[n] z).im / (k : ℝ)) := by
          rw [descentReflectStep, Complex.sub_im, Complex.one_im, zero_sub, hdiv_im]
        have hlt_half : ((descentReflectStep k)^[n] z).re / (k : ℝ) < 1 / 2 := by
          calc ((descentReflectStep k)^[n] z).re / (k : ℝ)
              < 1 / (k : ℝ) := div_lt_div_of_pos_right hhi hk0
            _ ≤ 1 / 2 := one_div_le_one_div_of_le (by norm_num) hkR
        have hpos_div : 0 < ((descentReflectStep k)^[n] z).re / (k : ℝ) :=
          div_pos (by linarith) hk0
        refine ⟨hrefl, by linarith [hstep_re, hlt_half], by linarith [hstep_re, hpos_div], ?_⟩
        rw [hstep_im, abs_neg, abs_div, abs_of_pos hk0]
        calc |((descentReflectStep k)^[n] z).im| / (k : ℝ)
            ≤ |((descentReflectStep k)^[n] z).im| / 1 :=
              div_le_div_of_nonneg_left (abs_nonneg _) zero_lt_one (by linarith)
          _ = |((descentReflectStep k)^[n] z).im| := div_one _
          _ ≤ |z.im| := him
    -- For `n ≥ 1`, the real parts lie in the compact box `[½, 1 − 1 / (2k)]`
    let K : Set ℂ := {w : ℂ | 1 / 2 ≤ w.re ∧ w.re ≤ 1 - 1 / (2 * (k : ℝ)) ∧ |w.im| ≤ |z.im|}
    have hKcomp : IsCompact K := isCompact_stripBox _ _ _
    have hKsub : K ⊆ {w : ℂ | 0 < w.re ∧ w.re < 1} := by
      intro w ⟨hw1, hw2, _⟩
      have hpos2k : 0 < 1 / (2 * (k : ℝ)) := by positivity
      exact ⟨by linarith, by linarith⟩
    have hfK : (Z ∩ K).Finite := hfin K hKcomp hKsub
    let f : ℕ → ↥(Z ∩ K) := fun n => ⟨(descentReflectStep k)^[n + 1] z, by
      obtain ⟨hmem1, hlo1, _, him1⟩ := horb (n + 1)
      obtain ⟨_, hlo0, _, _⟩ := horb n
      refine ⟨hmem1, hlo1.le, ?_, him1⟩
      have hdiv_re : (((descentReflectStep k)^[n] z) / (k : ℂ)).re =
          ((descentReflectStep k)^[n] z).re / (k : ℝ) := by
        rw [show ((k : ℂ)) = ((k : ℝ) : ℂ) by norm_cast, div_eq_mul_inv,
          ← Complex.ofReal_inv, mul_comm, Complex.re_ofReal_mul]
        ring
      have hstep_re : ((descentReflectStep k)^[n + 1] z).re =
          1 - ((descentReflectStep k)^[n] z).re / (k : ℝ) := by
        rw [Function.iterate_succ_apply', descentReflectStep, Complex.sub_re, Complex.one_re,
          hdiv_re]
      have hge : 1 / (2 * (k : ℝ)) ≤ ((descentReflectStep k)^[n] z).re / (k : ℝ) := by
        rw [show (1 : ℝ) / (2 * (k : ℝ)) = (1 / 2) / (k : ℝ) by ring]
        exact div_le_div_of_nonneg_right hlo0.le hk0.le
      linarith⟩
    have hinj : Function.Injective f := by
      intro a b hab
      have heq : (descentReflectStep k)^[a + 1] z = (descentReflectStep k)^[b + 1] z :=
        congrArg Subtype.val hab
      rw [descentReflectStep_iterate_eq k (by omega) z (a + 1),
        descentReflectStep_iterate_eq k (by omega) z (b + 1)] at heq
      have hsub_ne : z - (k : ℂ) / ((k : ℂ) + 1) ≠ 0 := sub_ne_zero.mpr hne
      have hpow : (-(1 / (k : ℂ))) ^ (a + 1) = (-(1 / (k : ℂ))) ^ (b + 1) :=
        mul_right_cancel₀ hsub_ne (add_left_cancel heq)
      rw [one_div, neg_inv, inv_pow, inv_pow, inv_inj] at hpow
      have hnorm := congrArg Norm.norm hpow
      simp only [norm_pow, norm_neg, Complex.norm_natCast] at hnorm
      have hnat : k ^ (a + 1) = k ^ (b + 1) := by exact_mod_cast hnorm
      have hab1 : a + 1 = b + 1 := Nat.pow_right_injective hk hnat
      omega
    haveI : Finite ↥(Z ∩ K) := hfK
    exact not_injective_infinite_finite f hinj
  · intro hsub z hz hre
    have heq := hsub z hz hre
    rw [heq]
    have hdiv : ((k : ℂ) / ((k : ℂ) + 1)) / (k : ℂ) = 1 - (k : ℂ) / ((k : ℂ) + 1) := by
      field_simp
      ring
    rw [hdiv]
    exact hZ.reflect_mem _ (heq ▸ hz)

/-- **Classification of full-strip `k`-descent.** For `k ≥ 2`, the empty configuration is the unique
locally finite quartet-symmetric configuration closed under `∀ z ∈ Z, z / k ∈ Z`. -/
theorem closed_full_descent_iff_empty {Z : Set ℂ} (hZ : IsQuartetSymmetric Z)
    (hfin : IsStripLocallyFinite Z) {k : ℕ} (hk : 2 ≤ k) :
    (∀ z ∈ Z, z / (k : ℂ) ∈ Z) ↔ Z = ∅ := by
  constructor
  · intro hfull
    ext z
    simp only [Set.mem_empty_iff_false, iff_false]
    intro hz
    have hright : ∀ w ∈ Z, 1 / 2 < w.re → w = (k : ℂ) / ((k : ℂ) + 1) :=
      (closed_right_descent_iff hZ hfin hk).mp fun w hw _ => hfull w hw
    have hkR : (2 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk
    have hk0 : (0 : ℝ) < (k : ℝ) := by linarith
    -- `w₁ = 1 − z / k ∈ Z` already lies strictly right of `½`
    have hzdiv : z / (k : ℂ) ∈ Z := hfull z hz
    have hw1_mem : 1 - z / (k : ℂ) ∈ Z := hZ.reflect_mem _ hzdiv
    have hz_lt1 : z.re < 1 := (hZ.strip z hz).2
    have hzdiv_re : (z / (k : ℂ)).re = z.re / (k : ℝ) := by
      rw [show ((k : ℂ)) = ((k : ℝ) : ℂ) by norm_cast, div_eq_mul_inv,
        ← Complex.ofReal_inv, mul_comm, Complex.re_ofReal_mul]
      ring
    have hw1_re : (1 - z / (k : ℂ)).re > 1 / 2 := by
      rw [Complex.sub_re, Complex.one_re, hzdiv_re]
      have : z.re / (k : ℝ) < 1 / 2 :=
        (div_lt_div_of_pos_right hz_lt1 hk0).trans_le
          (one_div_le_one_div_of_le (by norm_num) hkR)
      linarith
    have hw1_eq : 1 - z / (k : ℂ) = (k : ℂ) / ((k : ℂ) + 1) := hright _ hw1_mem hw1_re
    -- Apply full descent once more to `z / k ∈ Z`, then reflect
    have hzdiv2 : (z / (k : ℂ)) / (k : ℂ) ∈ Z := hfull _ hzdiv
    have hw2_mem : 1 - (z / (k : ℂ)) / (k : ℂ) ∈ Z := hZ.reflect_mem _ hzdiv2
    have hzdiv_lt1 : (z / (k : ℂ)).re < 1 := (hZ.strip _ hzdiv).2
    have hzdiv2_re : ((z / (k : ℂ)) / (k : ℂ)).re = (z / (k : ℂ)).re / (k : ℝ) := by
      rw [show ((k : ℂ)) = ((k : ℝ) : ℂ) by norm_cast, div_eq_mul_inv,
        ← Complex.ofReal_inv, mul_comm, Complex.re_ofReal_mul]
      ring
    have hw2_re : (1 - (z / (k : ℂ)) / (k : ℂ)).re > 1 / 2 := by
      rw [Complex.sub_re, Complex.one_re, hzdiv2_re]
      have : (z / (k : ℂ)).re / (k : ℝ) < 1 / 2 :=
        (div_lt_div_of_pos_right hzdiv_lt1 hk0).trans_le
          (one_div_le_one_div_of_le (by norm_num) hkR)
      linarith
    have hw2_eq : 1 - (z / (k : ℂ)) / (k : ℂ) = (k : ℂ) / ((k : ℂ) + 1) :=
      hright _ hw2_mem hw2_re
    have hkC0 : (k : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
    have hk1C : (k : ℂ) + 1 ≠ 0 := by exact_mod_cast Nat.succ_ne_zero k
    have hzk : z / (k : ℂ) = 1 / ((k : ℂ) + 1) := by
      have : z / (k : ℂ) = 1 - (k : ℂ) / ((k : ℂ) + 1) := by linear_combination -hw1_eq
      rw [this]
      field_simp
      ring
    rw [hzk] at hw2_eq
    have hcontra : (k : ℂ) = 1 := by
      field_simp at hw2_eq
      linear_combination hw2_eq
    have hk_eq1 : k = 1 := by exact_mod_cast hcontra
    omega
  · rintro rfl z hz
    exact False.elim hz

/-- **Real-zero-free right-zero `k`-descent.** When `Z` has no real zeros (`∀ z ∈ Z, Im z ≠ 0`),
`Z` is closed under right-zero `k`-descent (`k ≥ 2`) if and only if every point of `Z` lies on the
critical line `Re z = ½`. -/
theorem closed_right_descent_no_real_iff_onLine {Z : Set ℂ} (hZ : IsQuartetSymmetric Z)
    (hfin : IsStripLocallyFinite Z) (hnoreal : ∀ z ∈ Z, z.im ≠ 0) {k : ℕ} (hk : 2 ≤ k) :
    (∀ z ∈ Z, 1 / 2 < z.re → z / (k : ℂ) ∈ Z) ↔ ∀ z ∈ Z, z.re = 1 / 2 := by
  rw [closed_right_descent_iff hZ hfin hk]
  constructor
  · intro hsub z hz
    by_contra hne
    rcases lt_or_gt_of_ne hne with hlt | hgt
    · have hgt' : 1 / 2 < (1 - z).re := by
        rw [Complex.sub_re, Complex.one_re]
        linarith
      have heq := hsub (1 - z) (hZ.reflect_mem z hz) hgt'
      have him0 : (1 - z).im = 0 := by
        rw [heq, show ((k : ℂ) / ((k : ℂ) + 1)) = (((k : ℝ) / ((k : ℝ) + 1) : ℝ) : ℂ) by
          push_cast; rfl, Complex.ofReal_im]
      exact hnoreal (1 - z) (hZ.reflect_mem z hz) him0
    · have heq := hsub z hz hgt
      have him0 : z.im = 0 := by
        rw [heq, show ((k : ℂ) / ((k : ℂ) + 1)) = (((k : ℝ) / ((k : ℝ) + 1) : ℝ) : ℂ) by
          push_cast; rfl, Complex.ofReal_im]
      exact hnoreal z hz him0
  · intro hon z hz hgt
    linarith [hon z hz]

/-- **Single-quartet exclusion for `k`-fold descent.** Adding one off-line quartet `Q(ρ)`
(`½ < Re ρ < 1`, `Im ρ ≠ 0`) to any locally finite critical-line set `Z_crit ⊆ {Re s = ½}` is never
closed under right-zero `k`-descent (`k ≥ 2`). -/
theorem not_closed_right_descent_union_quartet {Z_crit : Set ℂ}
    (hcrit : ∀ z ∈ Z_crit, z.re = 1 / 2)
    (hconj : ∀ z ∈ Z_crit, starRingEnd ℂ z ∈ Z_crit)
    (hfin : IsStripLocallyFinite Z_crit) {ρ : ℂ} (hlo : 1 / 2 < ρ.re) (hhi : ρ.re < 1)
    (him : ρ.im ≠ 0) {k : ℕ} (hk : 2 ≤ k) :
    ¬ (∀ z ∈ Z_crit ∪ (zeroQuartet ρ : Set ℂ), 1 / 2 < z.re → z / (k : ℂ) ∈
        Z_crit ∪ (zeroQuartet ρ : Set ℂ)) := by
  have hsym : IsQuartetSymmetric (Z_crit ∪ (zeroQuartet ρ : Set ℂ)) := by
    refine ⟨?_, ?_, ?_⟩
    · rintro z (hz | hz)
      · rw [hcrit z hz]
        exact ⟨by norm_num, by norm_num⟩
      · rcases mem_zeroQuartet.mp hz with rfl | rfl | rfl | rfl
        · exact ⟨by linarith, hhi⟩
        · rw [Complex.conj_re]; exact ⟨by linarith, hhi⟩
        · rw [Complex.sub_re, Complex.one_re]; exact ⟨by linarith, by linarith⟩
        · rw [Complex.sub_re, Complex.one_re, Complex.conj_re]; exact ⟨by linarith, by linarith⟩
    · rintro z (hz | hz)
      · exact Or.inl (hconj z hz)
      · refine Or.inr (mem_zeroQuartet.mpr ?_)
        rcases mem_zeroQuartet.mp hz with rfl | rfl | rfl | rfl
        · exact Or.inr (Or.inl rfl)
        · rw [Complex.conj_conj]; exact Or.inl rfl
        · rw [map_sub, map_one]; exact Or.inr (Or.inr (Or.inr rfl))
        · rw [map_sub, map_one, Complex.conj_conj]; exact Or.inr (Or.inr (Or.inl rfl))
    · rintro z (hz | hz)
      · refine Or.inl ?_
        have h1 : (1 : ℂ) - z = starRingEnd ℂ z := by
          apply Complex.ext
          · rw [Complex.sub_re, Complex.one_re, Complex.conj_re, hcrit z hz]; ring
          · rw [Complex.sub_im, Complex.one_im, zero_sub, Complex.conj_im]
        rw [h1]
        exact hconj z hz
      · refine Or.inr (mem_zeroQuartet.mpr ?_)
        rcases mem_zeroQuartet.mp hz with rfl | rfl | rfl | rfl
        · exact Or.inr (Or.inr (Or.inl rfl))
        · exact Or.inr (Or.inr (Or.inr rfl))
        · rw [sub_sub_cancel]; exact Or.inl rfl
        · rw [sub_sub_cancel]; exact Or.inr (Or.inl rfl)
  have hfinU : IsStripLocallyFinite (Z_crit ∪ (zeroQuartet ρ : Set ℂ)) := fun K hK hKsub => by
    rw [Set.union_inter_distrib_right]
    exact (hfin K hK hKsub).union ((zeroQuartet ρ).finite_toSet.inter_of_left K)
  rw [closed_right_descent_iff hsym hfinU hk]
  intro hsub
  have heq := hsub ρ (Or.inr (mem_zeroQuartet.mpr (Or.inl rfl))) hlo
  have him0 : ρ.im = 0 := by
    rw [heq, show ((k : ℂ) / ((k : ℂ) + 1)) = (((k : ℝ) / ((k : ℝ) + 1) : ℝ) : ℂ) by
      push_cast; rfl, Complex.ofReal_im]
  exact him him0

/-! ### 3. Closed configurations of doubling (`ζ(2s)/ζ(s)`) and the dyadic tent map -/

/-- **Classification of full-strip doubling.** Any subset of `{0 < Re s < 1}` closed under
`z ↦ 2z` is empty. -/
theorem closed_full_doubling_iff_empty {Z : Set ℂ} (hstrip : ∀ z ∈ Z, 0 < z.re ∧ z.re < 1) :
    (∀ z ∈ Z, 2 * z ∈ Z) ↔ Z = ∅ := by
  constructor
  · intro hdouble
    ext z
    simp only [Set.mem_empty_iff_false, iff_false]
    intro hz
    have horb : ∀ n : ℕ, ((2 : ℂ) ^ n) * z ∈ Z := by
      intro n
      induction n with
      | zero => simpa using hz
      | succ n ih =>
        rw [pow_succ', mul_assoc]
        exact hdouble _ ih
    have hn_le_pow : ∀ m : ℕ, (m : ℝ) ≤ (2 : ℝ) ^ m := fun m => by
      induction m with
      | zero => norm_num
      | succ j ihj =>
        push_cast
        have h1 : (1 : ℝ) ≤ (2 : ℝ) ^ j := one_le_pow₀ (by norm_num)
        rw [pow_succ]
        linarith
    obtain ⟨hpos, _⟩ := hstrip z hz
    obtain ⟨n, hn⟩ := exists_lt_nsmul hpos 1
    have hmem := horb n
    have hre : (((2 : ℂ) ^ n) * z).re = ((2 : ℝ) ^ n) * z.re := by
      rw [show ((2 : ℂ) ^ n) = (((2 : ℝ) ^ n : ℝ) : ℂ) by push_cast; rfl, Complex.re_ofReal_mul]
    have hlt1 : (((2 : ℂ) ^ n) * z).re < 1 := (hstrip _ hmem).2
    rw [nsmul_eq_mul] at hn
    have hge : (n : ℝ) * z.re ≤ ((2 : ℝ) ^ n) * z.re :=
      mul_le_mul_of_nonneg_right (hn_le_pow n) hpos.le
    linarith
  · rintro rfl z hz
    exact False.elim hz

/-- **Classification of right-zero doubling.** A quartet-symmetric configuration is closed under
`∀ z ∈ Z, ½ < Re z → 2z ∈ Z` if and only if every point of `Z` lies on the critical line. -/
theorem closed_right_doubling_iff_onLine {Z : Set ℂ} (hZ : IsQuartetSymmetric Z) :
    (∀ z ∈ Z, 1 / 2 < z.re → 2 * z ∈ Z) ↔ ∀ z ∈ Z, z.re = 1 / 2 := by
  constructor
  · intro hdouble z hz
    by_contra hne
    have hex : ∃ w ∈ Z, 1 / 2 < w.re := by
      rcases lt_or_gt_of_ne hne with hlt | hgt
      · refine ⟨1 - z, hZ.reflect_mem z hz, ?_⟩
        rw [Complex.sub_re, Complex.one_re]
        linarith
      · exact ⟨z, hz, hgt⟩
    obtain ⟨w, hw, hwre⟩ := hex
    have h2w := hdouble w hw hwre
    have hlt1 : (2 * w).re < 1 := (hZ.strip _ h2w).2
    have h2re : (2 * w).re = 2 * w.re := by
      rw [show (2 : ℂ) = ((2 : ℝ) : ℂ) by norm_num, Complex.re_ofReal_mul]
    linarith
  · intro hon z hz hgt
    linarith [hon z hz]

/-- The critical-distance tent map `T(δ) = |2δ − ½|` governing left-zero doubling `z ↦ 2z` after
reflection `ρ ↦ 1 − ρ̄`. -/
def tentMap (δ : ℝ) : ℝ := |2 * δ - 1 / 2|

theorem tentMap_lt_half {δ : ℝ} (h0 : 0 < δ) (h1 : δ < 1 / 2) : tentMap δ < 1 / 2 := by
  rw [tentMap, abs_lt]
  constructor <;> linarith

/-- **Exact odd-dyadic characterization of terminating tent-map orbits.** For `δ ∈ (0, ½)` and
`k : ℕ`, the orbit of `T(δ) = |2δ − ½|` stays strictly positive for `k` steps and hits `0` at step
`k + 1` if and only if `δ = (2m + 1) / 2^{k + 2}` for some natural number `m < 2^k`. -/
theorem tentMap_iterate_eq_zero_iff (k : ℕ) {δ : ℝ} (h0 : 0 < δ) (h1 : δ < 1 / 2) :
    ((∀ j ≤ k, 0 < tentMap^[j] δ) ∧ tentMap^[k + 1] δ = 0) ↔
      ∃ m : ℕ, m < 2 ^ k ∧ δ = (2 * (m : ℝ) + 1) / (2 : ℝ) ^ (k + 2) := by
  induction k generalizing δ with
  | zero =>
    simp only [Nat.le_zero, forall_eq, Function.iterate_zero, id_eq, Function.iterate_one,
      pow_zero, Nat.lt_one_iff, exists_eq_left, Nat.cast_zero, mul_zero, zero_add]
    rw [tentMap, abs_eq_zero]
    constructor
    · rintro ⟨_, h⟩
      norm_num
      linarith
    · intro h
      refine ⟨h0, ?_⟩
      norm_num at h ⊢
      linarith
  | succ k ih =>
    constructor
    · rintro ⟨hpos, hzero⟩
      have hd0 : 0 < tentMap δ := by
        simpa using hpos 1 (by omega)
      have hd1 : tentMap δ < 1 / 2 := tentMap_lt_half h0 h1
      have hpos' : ∀ j ≤ k, 0 < tentMap^[j] (tentMap δ) := fun j hj => by
        rw [← Function.iterate_succ_apply]
        exact hpos (j + 1) (by omega)
      have hzero' : tentMap^[k + 1] (tentMap δ) = 0 := by
        rwa [← Function.iterate_succ_apply]
      obtain ⟨m', hm', heq⟩ := (ih hd0 hd1).mp ⟨hpos', hzero'⟩
      rw [tentMap] at heq
      have hpow_ne : ((2 : ℝ) ^ (k + 2)) ≠ 0 := by positivity
      rcases le_or_gt (1 / 2 : ℝ) (2 * δ) with hge | hlt
      · rw [abs_of_nonneg (by linarith)] at heq
        refine ⟨2 ^ k + m', by omega, ?_⟩
        push_cast
        have hcalc : 2 * δ = (2 * ((2 : ℝ) ^ k + (m' : ℝ)) + 1) / (2 : ℝ) ^ (k + 2) := by
          have : 2 * δ = 1 / 2 + (2 * (m' : ℝ) + 1) / (2 : ℝ) ^ (k + 2) := by linarith
          rw [this]
          field_simp
          ring
        rw [pow_succ _ (k + 2)]
        linarith [show δ = (2 * δ) / 2 by ring,
          show ((2 * ((2 : ℝ) ^ k + (m' : ℝ)) + 1) / (2 : ℝ) ^ (k + 2)) / 2 =
            (2 * ((2 : ℝ) ^ k + (m' : ℝ)) + 1) / ((2 : ℝ) ^ (k + 2) * 2) by ring]
      · rw [abs_of_neg (by linarith)] at heq
        refine ⟨2 ^ k - 1 - m', by omega, ?_⟩
        have hsub : ((2 ^ k - 1 - m' : ℕ) : ℝ) = (2 : ℝ) ^ k - 1 - (m' : ℝ) := by
          have hle1 : 1 ≤ 2 ^ k := Nat.one_le_two_pow
          have hle2 : m' ≤ 2 ^ k - 1 := by omega
          rw [Nat.cast_sub hle2, Nat.cast_sub hle1]
          push_cast
          rfl
        rw [hsub]
        have hcalc : 2 * δ = (2 * ((2 : ℝ) ^ k - 1 - (m' : ℝ)) + 1) / (2 : ℝ) ^ (k + 2) := by
          have : 2 * δ = 1 / 2 - (2 * (m' : ℝ) + 1) / (2 : ℝ) ^ (k + 2) := by linarith
          rw [this]
          field_simp
          ring
        rw [pow_succ _ (k + 2)]
        linarith [show δ = (2 * δ) / 2 by ring,
          show ((2 * ((2 : ℝ) ^ k - 1 - (m' : ℝ)) + 1) / (2 : ℝ) ^ (k + 2)) / 2 =
            (2 * ((2 : ℝ) ^ k - 1 - (m' : ℝ)) + 1) / ((2 : ℝ) ^ (k + 2) * 2) by ring]
    · rintro ⟨m, hm, rfl⟩
      have hpow : (0 : ℝ) < (2 : ℝ) ^ (k + 2) := by positivity
      -- Determine `tentMap δ` according to whether `m < 2^k` or `2^k ≤ m`
      have hstep : ∃ m' : ℕ, m' < 2 ^ k ∧
          tentMap ((2 * (m : ℝ) + 1) / (2 : ℝ) ^ (k + 1 + 2)) =
            (2 * (m' : ℝ) + 1) / (2 : ℝ) ^ (k + 2) := by
        rcases lt_or_ge m (2 ^ k) with hlt | hge
        · refine ⟨2 ^ k - 1 - m, by omega, ?_⟩
          have hsub : ((2 ^ k - 1 - m : ℕ) : ℝ) = (2 : ℝ) ^ k - 1 - (m : ℝ) := by
            have hle1 : 1 ≤ 2 ^ k := Nat.one_le_two_pow
            have hle2 : m ≤ 2 ^ k - 1 := by omega
            rw [Nat.cast_sub hle2, Nat.cast_sub hle1]
            push_cast
            rfl
          rw [tentMap, hsub]
          have hdiff : 2 * ((2 * (m : ℝ) + 1) / (2 : ℝ) ^ (k + 1 + 2)) - 1 / 2 =
              -((2 * ((2 : ℝ) ^ k - 1 - (m : ℝ)) + 1) / (2 : ℝ) ^ (k + 2)) := by
            rw [show k + 1 + 2 = (k + 2) + 1 by omega, pow_succ]
            field_simp
            ring
          rw [hdiff, abs_neg, abs_of_pos]
          have hmR : (m : ℝ) ≤ (2 : ℝ) ^ k - 1 := by
            have hle1 : 1 ≤ 2 ^ k := Nat.one_le_two_pow
            have : (m : ℝ) ≤ ((2 ^ k - 1 : ℕ) : ℝ) := by exact_mod_cast (by omega : m ≤ 2 ^ k - 1)
            rwa [Nat.cast_sub hle1, Nat.cast_pow, Nat.cast_ofNat, Nat.cast_one] at this
          exact div_pos (by linarith) hpow
        · refine ⟨m - 2 ^ k, by omega, ?_⟩
          have hsub : ((m - 2 ^ k : ℕ) : ℝ) = (m : ℝ) - (2 : ℝ) ^ k := by
            rw [Nat.cast_sub hge]
            push_cast
            rfl
          rw [tentMap, hsub]
          have hdiff : 2 * ((2 * (m : ℝ) + 1) / (2 : ℝ) ^ (k + 1 + 2)) - 1 / 2 =
              (2 * ((m : ℝ) - (2 : ℝ) ^ k) + 1) / (2 : ℝ) ^ (k + 2) := by
            rw [show k + 1 + 2 = (k + 2) + 1 by omega, pow_succ]
            field_simp
            ring
          rw [hdiff, abs_of_pos]
          have hmR : (2 : ℝ) ^ k ≤ (m : ℝ) := by exact_mod_cast hge
          exact div_pos (by linarith) hpow
      obtain ⟨m', hm', hT⟩ := hstep
      have hd0 : 0 < (2 * (m' : ℝ) + 1) / (2 : ℝ) ^ (k + 2) := div_pos (by positivity) hpow
      have hd1 : (2 * (m' : ℝ) + 1) / (2 : ℝ) ^ (k + 2) < 1 / 2 := by
        rw [div_lt_iff₀ hpow]
        have hm'R : (m' : ℝ) + 1 ≤ (2 : ℝ) ^ k := by
          exact_mod_cast (by omega : m' + 1 ≤ 2 ^ k)
        have hpow2 : (2 : ℝ) ^ (k + 2) = 4 * (2 : ℝ) ^ k := by ring
        linarith
      obtain ⟨hpos', hzero'⟩ := (ih (hT ▸ hd0) (hT ▸ hd1)).mpr ⟨m', hm', hT⟩
      refine ⟨fun j hj => ?_, ?_⟩
      · rcases Nat.eq_zero_or_pos j with rfl | hjpos
        · simpa using h0
        · obtain ⟨i, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hjpos.ne'
          rw [Function.iterate_succ_apply]
          exact hpos' i (by omega)
      · rw [Function.iterate_succ_apply]
        exact hzero'

/-- Right-normalized left-doubling step: reflect `w` across `½` to `1 − w̄`, double to
`2(1 − w̄)`, and if the result falls left of `½`, mirror back to `1 − conj(2(1 − w̄))`. -/
private def leftDoublingRightStep (w : ℂ) : ℂ :=
  let u := 2 * (1 - starRingEnd ℂ w)
  if u.re < 1 / 2 then 1 - starRingEnd ℂ u else u

private theorem leftDoublingRightStep_mem {Z : Set ℂ} (hZ : IsQuartetSymmetric Z)
    (hdouble : ∀ z ∈ Z, z.re < 1 / 2 → 2 * z ∈ Z) {w : ℂ} (hw : w ∈ Z) (hgt : 1 / 2 < w.re) :
    leftDoublingRightStep w ∈ Z ∧
      (leftDoublingRightStep w).re = 1 / 2 + tentMap (w.re - 1 / 2) ∧
      (leftDoublingRightStep w).im = 2 * w.im := by
  have hmir : 1 - starRingEnd ℂ w ∈ Z := hZ.mirror_mem hw
  have hmir_re : (1 - starRingEnd ℂ w).re < 1 / 2 := by
    rw [Complex.sub_re, Complex.one_re, Complex.conj_re]
    linarith
  have hu : 2 * (1 - starRingEnd ℂ w) ∈ Z := hdouble _ hmir hmir_re
  have hu_re : (2 * (1 - starRingEnd ℂ w)).re = 2 - 2 * w.re := by
    rw [show (2 : ℂ) = ((2 : ℝ) : ℂ) by norm_num, Complex.re_ofReal_mul,
      Complex.sub_re, Complex.one_re, Complex.conj_re]
    ring
  have hu_im : (2 * (1 - starRingEnd ℂ w)).im = 2 * w.im := by
    rw [show (2 : ℂ) = ((2 : ℝ) : ℂ) by norm_num, Complex.im_ofReal_mul,
      Complex.sub_im, Complex.one_im, zero_sub, Complex.conj_im, neg_neg]
  dsimp only [leftDoublingRightStep]
  split_ifs with hlt
  · refine ⟨hZ.mirror_mem hu, ?_, ?_⟩
    · rw [Complex.sub_re, Complex.one_re, Complex.conj_re, hu_re, tentMap]
      rw [hu_re] at hlt
      rw [abs_of_pos (by linarith)]
      ring
    · rw [Complex.sub_im, Complex.one_im, zero_sub, Complex.conj_im, neg_neg, hu_im]
  · refine ⟨hu, ?_, hu_im⟩
    rw [hu_re, tentMap]
    rw [hu_re] at hlt
    rw [abs_of_nonpos (by linarith)]
    ring

/-- **Finite-off-line classification of left-zero doubling.** Let `Z` be a quartet-symmetric
configuration without real zeros (`∀ z ∈ Z, Im z ≠ 0`) whose off-line subset
`Z \ {Re z = ½}` is finite. If `Z` is closed under left-zero doubling
(`∀ z ∈ Z, Re z < ½ → 2z ∈ Z`), then every right-hand zero `ρ ∈ Z` (`Re ρ > ½`) sits at an odd
dyadic abscissa `Re ρ = ½ + (2m + 1) / 2^{k + 2}` (`m < 2^k`) and `Z` contains the critical-line
partner `½ + 2^{k + 1} i Im ρ`. -/
theorem odd_dyadic_depth_of_closed_left_doubling {Z : Set ℂ} (hZ : IsQuartetSymmetric Z)
    (hnoreal : ∀ z ∈ Z, z.im ≠ 0) (hoff : (Z \ {z : ℂ | z.re = 1 / 2}).Finite)
    (hdouble : ∀ z ∈ Z, z.re < 1 / 2 → 2 * z ∈ Z) {ρ : ℂ} (hρ : ρ ∈ Z) (hgt : 1 / 2 < ρ.re) :
    ∃ k m : ℕ, m < 2 ^ k ∧
      ρ.re = 1 / 2 + (2 * (m : ℝ) + 1) / (2 : ℝ) ^ (k + 2) ∧
      ((1 / 2 : ℂ) + (((2 : ℝ) ^ (k + 1) * ρ.im : ℝ) : ℂ) * Complex.I) ∈ Z := by
  classical
  set δ : ℝ := ρ.re - 1 / 2 with hδ_def
  have hδ0 : 0 < δ := by rw [hδ_def]; linarith
  have hδ1 : δ < 1 / 2 := by rw [hδ_def]; linarith [(hZ.strip ρ hρ).2]
  have him0 : ρ.im ≠ 0 := hnoreal ρ hρ
  -- Helper: as long as `tentMap^[j] δ > 0` for `j < n`, the `n`-th iterate is in `Z` with exact
  -- real and imaginary parts.
  have horb : ∀ n : ℕ, (∀ j < n, 0 < tentMap^[j] δ) →
      leftDoublingRightStep^[n] ρ ∈ Z ∧
      (leftDoublingRightStep^[n] ρ).re = 1 / 2 + tentMap^[n] δ ∧
      (leftDoublingRightStep^[n] ρ).im = (2 : ℝ) ^ n * ρ.im := by
    intro n
    induction n with
    | zero =>
      intro _
      exact ⟨hρ, by simp [hδ_def], by simp⟩
    | succ n ihn =>
      intro hpos
      obtain ⟨hmem, hre, him⟩ := ihn fun j hj => hpos j (by omega)
      have hgt_n : 1 / 2 < (leftDoublingRightStep^[n] ρ).re := by
        rw [hre]
        linarith [hpos n (by omega)]
      obtain ⟨hmem', hre', him'⟩ := leftDoublingRightStep_mem hZ hdouble hmem hgt_n
      rw [Function.iterate_succ_apply']
      refine ⟨hmem', ?_, ?_⟩
      · rw [hre', show (leftDoublingRightStep^[n] ρ).re - 1 / 2 = tentMap^[n] δ by linarith,
          ← Function.iterate_succ_apply' tentMap n δ]
      · rw [him', him, pow_succ']
        ring
  -- The orbit cannot stay strictly off-line forever because `Z \ {Re = ½}` is finite and `2^n Im ρ`
  -- separates all iterates.
  have hex_zero : ∃ n : ℕ, tentMap^[n] δ = 0 := by
    by_contra hall_ne
    push Not at hall_ne
    have hall_pos : ∀ n : ℕ, 0 < tentMap^[n] δ := by
      intro n
      rcases Nat.eq_zero_or_pos n with rfl | hnpos
      · simpa using hδ0
      · obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hnpos.ne'
        rw [Function.iterate_succ_apply', tentMap]
        exact abs_pos.mpr (by
          intro h0
          apply hall_ne (j + 1)
          rw [Function.iterate_succ_apply', tentMap, h0, abs_zero])
    let g : ℕ → ↥(Z \ {z : ℂ | z.re = 1 / 2}) := fun n =>
      ⟨leftDoublingRightStep^[n] ρ, (horb n fun j _ => hall_pos j).1, by
        simp only [Set.mem_setOf_eq]
        rw [(horb n fun j _ => hall_pos j).2.1]
        linarith [hall_pos n]⟩
    have hinj : Function.Injective g := by
      intro a b hab
      have him_eq : (leftDoublingRightStep^[a] ρ).im = (leftDoublingRightStep^[b] ρ).im :=
        congrArg (fun x : ↥(Z \ {z : ℂ | z.re = 1 / 2}) => x.1.im) hab
      rw [(horb a fun j _ => hall_pos j).2.2, (horb b fun j _ => hall_pos j).2.2] at him_eq
      have hpow : (2 : ℝ) ^ a = (2 : ℝ) ^ b := mul_right_cancel₀ him0 him_eq
      have hpowN : (2 : ℕ) ^ a = (2 : ℕ) ^ b := by exact_mod_cast hpow
      exact Nat.pow_right_injective (by norm_num) hpowN
    haveI : Finite ↥(Z \ {z : ℂ | z.re = 1 / 2}) := hoff
    exact not_injective_infinite_finite g hinj
  let n₀ : ℕ := Nat.find hex_zero
  have hn₀_spec : tentMap^[n₀] δ = 0 := Nat.find_spec hex_zero
  have hn₀_pos : 0 < n₀ := by
    by_contra h0
    have h0' : n₀ = 0 := by omega
    rw [h0', Function.iterate_zero, id_eq] at hn₀_spec
    linarith
  obtain ⟨k, hk_eq⟩ := Nat.exists_eq_succ_of_ne_zero hn₀_pos.ne'
  have hpos_k : ∀ j ≤ k, 0 < tentMap^[j] δ := by
    intro j hj
    have hne : tentMap^[j] δ ≠ 0 := Nat.find_min hex_zero (by omega)
    rcases Nat.eq_zero_or_pos j with rfl | hjpos
    · simpa using hδ0
    · obtain ⟨i, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hjpos.ne'
      rw [Function.iterate_succ_apply', tentMap] at hne ⊢
      exact lt_of_le_of_ne (abs_nonneg _) hne.symm
  rw [hk_eq] at hn₀_spec
  obtain ⟨m, hm, hδ_eq⟩ := (tentMap_iterate_eq_zero_iff k hδ0 hδ1).mp ⟨hpos_k, hn₀_spec⟩
  obtain ⟨hmem_end, hre_end, him_end⟩ := horb (k + 1) fun j hj => hpos_k j (by omega)
  rw [hn₀_spec, add_zero] at hre_end
  have hend_eq : leftDoublingRightStep^[k + 1] ρ =
      (1 / 2 : ℂ) + (((2 : ℝ) ^ (k + 1) * ρ.im : ℝ) : ℂ) * Complex.I := by
    apply Complex.ext
    · rw [hre_end, Complex.add_re, Complex.re_ofReal_mul, Complex.I_re, mul_zero, add_zero]
      norm_num
    · rw [him_end, Complex.add_im, Complex.im_ofReal_mul, Complex.I_im, mul_one]
      norm_num
  rw [hδ_def] at hδ_eq
  refine ⟨k, m, hm, by linarith [hδ_eq], hend_eq ▸ hmem_end⟩

/-- **Single-quartet exclusion for left-zero doubling.** For any `ρ` with `½ < Re ρ < 1` and
`Im ρ ≠ 0`, the quartet `Q(ρ)` alone is never closed under `∀ z ∈ Q(ρ), Re z < ½ → 2z ∈ Q(ρ)`. -/
theorem not_closed_left_doubling_quartet {ρ : ℂ} (hlo : 1 / 2 < ρ.re) (_hhi : ρ.re < 1)
    (him : ρ.im ≠ 0) :
    ¬ (∀ z ∈ (zeroQuartet ρ : Set ℂ), z.re < 1 / 2 → 2 * z ∈ (zeroQuartet ρ : Set ℂ)) := by
  intro hdouble
  have hmem : 1 - starRingEnd ℂ ρ ∈ (zeroQuartet ρ : Set ℂ) :=
    mem_zeroQuartet.mpr (Or.inr (Or.inr (Or.inr rfl)))
  have hlt : (1 - starRingEnd ℂ ρ).re < 1 / 2 := by
    rw [Complex.sub_re, Complex.one_re, Complex.conj_re]
    linarith
  have h2 := hdouble _ hmem hlt
  have h2im : (2 * (1 - starRingEnd ℂ ρ)).im = 2 * ρ.im := by
    rw [show (2 : ℂ) = ((2 : ℝ) : ℂ) by norm_num, Complex.im_ofReal_mul,
      Complex.sub_im, Complex.one_im, zero_sub, Complex.conj_im, neg_neg]
  rcases mem_zeroQuartet.mp h2 with h | h | h | h
  · have hi := congrArg Complex.im h
    exact him (by linarith [h2im, hi])
  · have hi := congrArg Complex.im h
    rw [Complex.conj_im] at hi
    exact him (by linarith [h2im, hi])
  · have hi := congrArg Complex.im h
    rw [Complex.sub_im, Complex.one_im, zero_sub] at hi
    exact him (by linarith [h2im, hi])
  · have hi := congrArg Complex.im h
    rw [Complex.sub_im, Complex.one_im, zero_sub, Complex.conj_im, neg_neg] at hi
    exact him (by linarith [h2im, hi])

/-- **Characterization of `Z_crit ∪ Q(ρ)` under left-zero doubling.** For a conjugation-symmetric
critical-line set `Z_crit ⊆ {Re s = ½}` and `½ < Re ρ < 1` with `Im ρ ≠ 0`, `Z_crit ∪ Q(ρ)` is
closed under `∀ z ∈ Z, Re z < ½ → 2z ∈ Z` if and only if `Re ρ = 3/4` and
`½ + 2i Im ρ ∈ Z_crit`. -/
theorem closed_left_doubling_union_quartet_iff {Z_crit : Set ℂ}
    (hcrit : ∀ z ∈ Z_crit, z.re = 1 / 2)
    (hconj : ∀ z ∈ Z_crit, starRingEnd ℂ z ∈ Z_crit)
    {ρ : ℂ} (hlo : 1 / 2 < ρ.re) (_hhi : ρ.re < 1) (him : ρ.im ≠ 0) :
    (∀ z ∈ Z_crit ∪ (zeroQuartet ρ : Set ℂ), z.re < 1 / 2 →
      2 * z ∈ Z_crit ∪ (zeroQuartet ρ : Set ℂ)) ↔
      ρ.re = 3 / 4 ∧ ((1 / 2 : ℂ) + ((2 * ρ.im : ℝ) : ℂ) * Complex.I) ∈ Z_crit := by
  constructor
  · intro hdouble
    have hmem : 1 - starRingEnd ℂ ρ ∈ Z_crit ∪ (zeroQuartet ρ : Set ℂ) :=
      Or.inr (mem_zeroQuartet.mpr (Or.inr (Or.inr (Or.inr rfl))))
    have hlt : (1 - starRingEnd ℂ ρ).re < 1 / 2 := by
      rw [Complex.sub_re, Complex.one_re, Complex.conj_re]
      linarith
    have h2re : (2 * (1 - starRingEnd ℂ ρ)).re = 2 - 2 * ρ.re := by
      rw [show (2 : ℂ) = ((2 : ℝ) : ℂ) by norm_num, Complex.re_ofReal_mul,
        Complex.sub_re, Complex.one_re, Complex.conj_re]
      ring
    have h2im : (2 * (1 - starRingEnd ℂ ρ)).im = 2 * ρ.im := by
      rw [show (2 : ℂ) = ((2 : ℝ) : ℂ) by norm_num, Complex.im_ofReal_mul,
        Complex.sub_im, Complex.one_im, zero_sub, Complex.conj_im, neg_neg]
    rcases hdouble _ hmem hlt with hZ | hQ
    · have hre_half : (2 * (1 - starRingEnd ℂ ρ)).re = 1 / 2 := hcrit _ hZ
      have hρ34 : ρ.re = 3 / 4 := by linarith [h2re, hre_half]
      have heq : 2 * (1 - starRingEnd ℂ ρ) =
          (1 / 2 : ℂ) + ((2 * ρ.im : ℝ) : ℂ) * Complex.I := by
        apply Complex.ext
        · simp [hre_half]
        · simp [h2im]
      exact ⟨hρ34, heq ▸ hZ⟩
    · exfalso
      rcases mem_zeroQuartet.mp hQ with h | h | h | h
      · have hi := congrArg Complex.im h; exact him (by linarith [h2im, hi])
      · have hi := congrArg Complex.im h; rw [Complex.conj_im] at hi
        exact him (by linarith [h2im, hi])
      · have hi := congrArg Complex.im h; rw [Complex.sub_im, Complex.one_im, zero_sub] at hi
        exact him (by linarith [h2im, hi])
      · have hi := congrArg Complex.im h
        rw [Complex.sub_im, Complex.one_im, zero_sub, Complex.conj_im, neg_neg] at hi
        exact him (by linarith [h2im, hi])
  · rintro ⟨hρ34, hpartner⟩ z hz hlt
    rcases hz with hzC | hzQ
    · linarith [hcrit z hzC]
    · rcases mem_zeroQuartet.mp hzQ with rfl | rfl | rfl | rfl
      · linarith
      · rw [Complex.conj_re] at hlt; linarith
      · refine Or.inl ?_
        have heq : 2 * (1 - ρ) =
            starRingEnd ℂ ((1 / 2 : ℂ) + ((2 * ρ.im : ℝ) : ℂ) * Complex.I) := by
          apply Complex.ext
          · simp [hρ34]; ring
          · simp
        rw [heq]
        exact hconj _ hpartner
      · refine Or.inl ?_
        have heq : 2 * (1 - starRingEnd ℂ ρ) =
            (1 / 2 : ℂ) + ((2 * ρ.im : ℝ) : ℂ) * Complex.I := by
          apply Complex.ext
          · simp [hρ34]; ring
          · simp
        rw [heq]
        exact hpartner

end GaloisForLFunctions.ZeroForcingCalculus

