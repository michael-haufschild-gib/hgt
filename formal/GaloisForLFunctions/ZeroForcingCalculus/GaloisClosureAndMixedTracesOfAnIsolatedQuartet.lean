import GaloisForLFunctions.GaloisTheoryOfZeros.AnOrbitLeavesItsQuartetOnlyThroughAnotherOffLineQuartetOfTheSameOrdinate
import GaloisForLFunctions.GaloisTheoryOfZeros.TheReflectionRadicalsOfOneHeightCarryTheParityOfItsZeros
import GaloisForLFunctions.GaloisTheoryOfZeros.TheMixedPrimeTracesSatisfyTheFunctionalEquation

/-!
# Galois closure and mixed prime traces of an isolated off-line quartet

Let `B = primeTraceField` be the field generated by all paired ordinate prime-divisor traces
`T_t(m) = ∑_{Im ρ = ±t} m_ρ n_m^ρ`, `E = primeTraceExtension` the prime spectral field, and
`G = Gal(E/B)`. Every zero `ρ = β + i t` of `ξ` determines at each prime `p` its ordinate value
`u_p(ρ) = 2 cos(2 t log p)` and its width value `v_p(ρ) = p^{2β - 1} + p^{1 - 2β}`.

This module establishes the universal multiplicity-weighted height-trace formula and resolves the
exact Galois and mixed-trace invariants of an isolated off-line quartet
`Q(ρ) = {ρ, ρ̄, 1 - ρ, 1 - ρ̄}` (`β ≠ 1/2`) in both critical-parity regimes at height `t = Im ρ`:

1. **Multiplicity-weighted height trace** (`primeDivisorTrace_eq_sum_primeUpperFibre`,
   `xiSupportMult_mirror`): for every `t : ℝ` and `m : Nat.Primes →₀ ℤ`,
   `T_t(m) = ∑_{ρ ∈ U_t} mult(ρ) (n_m^ρ + n_m^{ρ̄})`, and `mult(1 - ρ̄) = mult(ρ)`.
2. **Regime A — pure off-line height** (`1/2 + i t` not a zero, `U_t = {ρ, 1 - ρ̄}`):
   - `A_{t,p} = p (u_p(ρ) - v_p(ρ))` is real and strictly negative for every prime `p`
     (`isolated_quartet_heightReflectionProduct_eq`,
     `isolated_quartet_heightReflectionProduct_neg`), so `A_{t,p}² ∈ B` is strictly positive
     for every prime `p` (`isolated_quartet_radicand_square_pos`), opposite in sign to critical
     heights where `A_{t,p}² < 0`.
   - `A_{t,p}²` is a square in `B` iff `A_{t,p} ∈ B` iff `u_p(ρ) ∈ B` iff `v_p(ρ) ∈ B` iff
     `Gal(E/B)` contains no partial flip `σ(ρ̄) = 1 - conj(σ ρ)`
     (`isolated_quartet_square_iff_no_partialFlip`).
   - Every mixed trace factors symmetrically as
     `T_t(m) = mult(ρ) e^{L/2} (e^{a L} + e^{-a L}) (e^{i t L} + e^{-i t L})`
     with `a = β - 1/2` and `L = ∑_p m_p log p` (`isolated_quartet_primeDivisorTrace_factorization`),
     exhibiting the exact swap symmetry `a ↔ i t` responsible for the quadratic ambiguity between
     `u_p(ρ)` and `v_p(ρ)`.
3. **Regime B — shared ordinate with a critical zero** (`1/2 + i t` is a zero):
   - Any critical zero at ordinate `±t` places `u_p(ρ) ∈ B` at every prime `p` and eliminates all
     partial flips (`critical_ordinate_eliminates_partialFlip`).
   - When `Q(ρ)` is the unique off-line quartet at ordinate `±t`, `U_t = {ρ₀, ρ, 1 - ρ̄}` has
     `T_t(2 e_p) = p (mult(ρ₀) u_p(ρ) + mult(ρ) u_p(ρ) v_p(ρ))`
     (`shared_critical_and_isolated_quartet_trace_single_two`), both `u_p(ρ) ∈ B` and
     `v_p(ρ) ∈ B` hold for every prime `p`, and `Gal(E/B)` acts on `Q(ρ)` strictly through the
     Klein four-group `{1, c, r, cr}` (`shared_critical_and_isolated_quartet_klein_action`).
-/

noncomputable section
set_option autoImplicit false

open Complex Set RHTower GaloisForLFunctions.GaloisTheoryOfZeros
open scoped BigOperators Classical

namespace GaloisForLFunctions.ZeroForcingCalculus

local notation "B" => primeTraceField
local notation "E" => primeTraceExtension
local notation "G" => (E ≃ₐ[B] E)
local instance : IsGalois B E := ⟨⟩

/-! ## 1. Divisor multiplicities and the universal height-trace formula -/

/-- Positive integer divisor multiplicity of a `ξ`-zero support point. -/
abbrev xiSupportMult (ρ : XiDivisorSupport) : ℕ :=
  ((MeromorphicOn.divisor xi Set.univ) (ρ : ℂ)).toNat

theorem xiSupportMult_pos (ρ : XiDivisorSupport) : 0 < xiSupportMult ρ := by
  have h := xi_divisor_pos_on_support ρ
  change 0 < ((MeromorphicOn.divisor xi Set.univ) (ρ : ℂ)).toNat
  omega

theorem xiSupportMult_conj (ρ : XiDivisorSupport) :
    xiSupportMult (xiZeroConjEquiv ρ) = xiSupportMult ρ := by
  change ((MeromorphicOn.divisor xi Set.univ) (starRingEnd ℂ (ρ : ℂ))).toNat = _
  rw [xi_divisor_conj]

theorem xiSupportMult_reflect (ρ : XiDivisorSupport) :
    xiSupportMult (xiZeroReflectEquiv ρ) = xiSupportMult ρ := by
  change ((MeromorphicOn.divisor xi Set.univ) (1 - (ρ : ℂ))).toNat = _
  rw [xi_divisor_one_sub]

/-- Functional-conjugate mirror `ρ ↦ 1 - ρ̄` preserves the `ξ`-divisor multiplicity. -/
theorem xiSupportMult_mirror (ρ : XiDivisorSupport) :
    xiSupportMult (xiZeroMirror ρ) = xiSupportMult ρ := by
  rw [xiZeroMirror, xiSupportMult_reflect, xiSupportMult_conj]

/-- The multiplicity copies of ordinate `t` decompose as the sigma finset over `primeUpperFibre t`. -/
theorem ordinateFibreCopies_eq_sigma (t : ℝ) :
    ordinateFibreCopies t =
      (primeUpperFibre t).sigma fun ρ =>
        (Finset.univ : Finset (Fin (xiSupportMult ρ))) := by
  ext q
  rw [mem_ordinateFibreCopies, Finset.mem_sigma, xiSpectralPoint_re_eq_im, mem_primeUpperFibre]
  exact ⟨fun h => ⟨h, Finset.mem_univ _⟩, fun h => h.1⟩

theorem sum_ordinateFibreCopies (t : ℝ) (f : XiDivisorSupport → ℂ) :
    (∑ x : ↥(ordinateFibreCopies t), f (x : XiZeroCopy).1) =
      ∑ ρ ∈ primeUpperFibre t, (xiSupportMult ρ : ℂ) * f ρ := by
  rw [Finset.univ_eq_attach, Finset.sum_attach (ordinateFibreCopies t) (fun q => f q.1),
    ordinateFibreCopies_eq_sigma, Finset.sum_sigma]
  refine Finset.sum_congr rfl fun ρ _ => ?_
  dsimp only
  rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]

theorem sum_primeUpperFibre_neg (t : ℝ) (f : XiDivisorSupport → ℂ) :
    ∑ ρ ∈ primeUpperFibre (-t), f ρ =
      ∑ ρ ∈ primeUpperFibre t, f (xiZeroConjEquiv ρ) := by
  refine Finset.sum_nbij' xiZeroConjEquiv xiZeroConjEquiv ?_ ?_ ?_ ?_ fun ρ _ =>
    congrArg f (Subtype.ext (Complex.conj_conj (ρ : ℂ))).symm
  · intro ρ hρ
    rw [mem_primeUpperFibre] at hρ ⊢
    change (starRingEnd ℂ (ρ : ℂ)).im = t
    rw [Complex.conj_im, hρ, neg_neg]
  · intro ρ hρ
    rw [mem_primeUpperFibre] at hρ ⊢
    change (starRingEnd ℂ (ρ : ℂ)).im = -t
    rw [Complex.conj_im, hρ]
  · intro ρ _
    exact Subtype.ext (Complex.conj_conj (ρ : ℂ))
  · intro ρ _
    exact Subtype.ext (Complex.conj_conj (ρ : ℂ))

/-- **Universal height-trace formula.** Every paired ordinate trace `T_t(m)` sums
`mult(ρ) (n_m^ρ + n_m^{ρ̄})` over the support zeros `ρ ∈ U_t` of ordinate `t`. -/
theorem primeDivisorTrace_eq_sum_primeUpperFibre (t : ℝ) (m : Nat.Primes →₀ ℤ) :
    primeDivisorTrace t m =
      ∑ ρ ∈ primeUpperFibre t, (xiSupportMult ρ : ℂ) *
        (primeRelationValue (ρ : ℂ) m + primeRelationValue (starRingEnd ℂ (ρ : ℂ)) m) := by
  unfold primeDivisorTrace
  rw [Fintype.sum_sum_type]
  change (∑ x : ↥(ordinateFibreCopies t), primeRelationValue ((x : XiZeroCopy).1 : ℂ) m) +
      (∑ x : ↥(ordinateFibreCopies (-t)), primeRelationValue ((x : XiZeroCopy).1 : ℂ) m) = _
  rw [sum_ordinateFibreCopies t (fun ρ => primeRelationValue (ρ : ℂ) m),
    sum_ordinateFibreCopies (-t) (fun ρ => primeRelationValue (ρ : ℂ) m),
    sum_primeUpperFibre_neg, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun ρ _ => ?_
  rw [xiSupportMult_conj, ← mul_add]
  rfl

/-! ## 2. Regime A: pure off-line quartet height (`1/2 + i t` absent) -/

theorem xiZeroMirror_ne_self_of_re_ne_half {ρ : XiDivisorSupport} (hβ : (ρ : ℂ).re ≠ 1 / 2) :
    xiZeroMirror ρ ≠ ρ := by
  intro h
  have hr := congrArg (fun z : XiDivisorSupport => (z : ℂ).re) h
  rw [xiZeroMirror_re] at hr
  exact hβ (by linarith only [hr])

/-- For an off-line zero `ρ`, the upper height fibre `U_{Im ρ}` equals `{ρ, 1 - ρ̄}` iff every zero
of absolute ordinate `|Im ρ|` has real part `Re ρ` or `1 - Re ρ` (so neither `1/2 + i Im ρ` nor a
second off-line quartet occurs at that height). -/
theorem isolated_quartet_primeUpperFibre_eq {ρ : XiDivisorSupport} (hβ : (ρ : ℂ).re ≠ 1 / 2) :
    primeUpperFibre (ρ : ℂ).im = {ρ, xiZeroMirror ρ} ↔
      ∀ ρ' : XiDivisorSupport, |(ρ' : ℂ).im| = |(ρ : ℂ).im| →
        (ρ' : ℂ).re = (ρ : ℂ).re ∨ (ρ' : ℂ).re = 1 - (ρ : ℂ).re := by
  constructor
  · intro hU ρ' hi
    rcases abs_eq_abs.1 hi with him | him
    · have hm : ρ' ∈ ({ρ, xiZeroMirror ρ} : Finset XiDivisorSupport) :=
        hU ▸ mem_primeUpperFibre.2 him
      rcases Finset.mem_insert.1 hm with rfl | hm
      · exact Or.inl rfl
      · rw [Finset.mem_singleton.1 hm, xiZeroMirror_re]
        exact Or.inr rfl
    · have hm : xiZeroConjEquiv ρ' ∈ ({ρ, xiZeroMirror ρ} : Finset XiDivisorSupport) := by
        rw [← hU, mem_primeUpperFibre]
        change (starRingEnd ℂ (ρ' : ℂ)).im = _
        rw [Complex.conj_im, him, neg_neg]
      have hre : (xiZeroConjEquiv ρ' : ℂ).re = (ρ' : ℂ).re := Complex.conj_re (ρ' : ℂ)
      rcases Finset.mem_insert.1 hm with he | hm
      · exact Or.inl (hre.symm.trans (congrArg (fun z : XiDivisorSupport => (z : ℂ).re) he))
      · rw [Finset.mem_singleton] at hm
        exact Or.inr (hre.symm.trans
          ((congrArg (fun z : XiDivisorSupport => (z : ℂ).re) hm).trans (xiZeroMirror_re ρ)))
  · intro hu
    ext ρ'
    rw [mem_primeUpperFibre, Finset.mem_insert, Finset.mem_singleton]
    constructor
    · intro him
      rcases hu ρ' (congrArg abs him) with hr | hr
      · exact Or.inl (Subtype.ext (Complex.ext hr him))
      · exact Or.inr (Subtype.ext (Complex.ext (hr.trans (xiZeroMirror_re ρ).symm)
          (him.trans (xiZeroMirror_im ρ).symm)))
    · rintro (rfl | rfl)
      · rfl
      · exact xiZeroMirror_im ρ

/-- **Height reflection product of an isolated quartet.** On a pure off-line quartet height
`U_{Im ρ} = {ρ, 1 - ρ̄}`, the reflection-radical product is `A_{t,p} = p (u_p(ρ) - v_p(ρ))`. -/
theorem isolated_quartet_heightReflectionProduct_eq (p : Nat.Primes) {ρ : XiDivisorSupport}
    (hβ : (ρ : ℂ).re ≠ 1 / 2) (hU : primeUpperFibre (ρ : ℂ).im = {ρ, xiZeroMirror ρ}) :
    primeHeightReflectionProduct p (ρ : ℂ).im =
      (p : ℕ) * (primeOrdinateValue p ρ - primeWidthValue p ρ) := by
  have hne : ρ ≠ xiZeroMirror ρ := (xiZeroMirror_ne_self_of_re_ne_half hβ).symm
  rw [primeHeightReflectionProduct, hU, Finset.prod_pair hne]
  apply Subtype.ext
  change (primeReflectionDifference p ρ : ℂ) *
      (primeReflectionDifference p (xiZeroMirror ρ) : ℂ) =
    (p : ℂ) * ((primeOrdinateValue p ρ : ℂ) - (primeWidthValue p ρ : ℂ))
  have hord : (primeOrdinateValue p ρ : ℂ) =
      Complex.exp ((Real.log (p : ℕ) : ℂ) * ((ρ : ℂ) - starRingEnd ℂ (ρ : ℂ))) +
        Complex.exp ((Real.log (p : ℕ) : ℂ) * (-((ρ : ℂ) - starRingEnd ℂ (ρ : ℂ)))) := rfl
  have hwid : (primeWidthValue p ρ : ℂ) =
      Complex.exp ((Real.log (p : ℕ) : ℂ) * ((ρ : ℂ) - (1 - starRingEnd ℂ (ρ : ℂ)))) +
        Complex.exp ((Real.log (p : ℕ) : ℂ) * (-((ρ : ℂ) - (1 - starRingEnd ℂ (ρ : ℂ))))) := rfl
  have hdiff1 : (primeReflectionDifference p ρ : ℂ) =
      Complex.exp ((Real.log (p : ℕ) : ℂ) * (ρ : ℂ)) -
        Complex.exp ((Real.log (p : ℕ) : ℂ) * (1 - (ρ : ℂ))) := by
    change (primeResidueValue p ρ : ℂ) - (primeResidueValue p (xiZeroReflectEquiv ρ) : ℂ) = _
    rw [primeResidueValue_coe, primeResidueValue_coe, xiZeroReflectEquiv_apply]
  have hdiff2 : (primeReflectionDifference p (xiZeroMirror ρ) : ℂ) =
      Complex.exp ((Real.log (p : ℕ) : ℂ) * (1 - starRingEnd ℂ (ρ : ℂ))) -
        Complex.exp ((Real.log (p : ℕ) : ℂ) * starRingEnd ℂ (ρ : ℂ)) := by
    change (primeResidueValue p (xiZeroMirror ρ) : ℂ) -
        (primeResidueValue p (xiZeroReflectEquiv (xiZeroMirror ρ)) : ℂ) = _
    rw [primeResidueValue_coe, primeResidueValue_coe, xiZeroReflectEquiv_apply, xiZeroMirror_coe]
    congr 2
    ring
  rw [hdiff1, hdiff2, hord, hwid,
    ← GaloisForLFunctions.RHTower.SixExponentials.exp_log_nat p.2.pos]
  set lp : ℂ := (Real.log (p : ℕ) : ℂ)
  set z : ℂ := (ρ : ℂ)
  set zb : ℂ := starRingEnd ℂ (ρ : ℂ)
  have e1 : Complex.exp (lp * (1 - z)) = Complex.exp lp * Complex.exp (lp * (-z)) := by
    rw [← Complex.exp_add]; congr 1; ring
  have e2 : Complex.exp (lp * (1 - zb)) = Complex.exp lp * Complex.exp (lp * (-zb)) := by
    rw [← Complex.exp_add]; congr 1; ring
  have e3 : Complex.exp (lp * (z - zb)) = Complex.exp (lp * z) * Complex.exp (lp * (-zb)) := by
    rw [← Complex.exp_add]; congr 1; ring
  have e4 : Complex.exp (lp * (-(z - zb))) = Complex.exp (lp * (-z)) * Complex.exp (lp * zb) := by
    rw [← Complex.exp_add]; congr 1; ring
  have e5 : Complex.exp lp * Complex.exp (lp * (z - (1 - zb))) =
      Complex.exp (lp * z) * Complex.exp (lp * zb) := by
    rw [← Complex.exp_add, ← Complex.exp_add]; congr 1; ring
  have e6 : Complex.exp lp * Complex.exp (lp * (-(z - (1 - zb)))) =
      Complex.exp lp * Complex.exp (lp * (-z)) * (Complex.exp lp * Complex.exp (lp * (-zb))) := by
    rw [← Complex.exp_add, ← Complex.exp_add, ← Complex.exp_add, ← Complex.exp_add]; congr 1; ring
  calc (Complex.exp (lp * z) - Complex.exp (lp * (1 - z))) *
        (Complex.exp (lp * (1 - zb)) - Complex.exp (lp * zb))
      = Complex.exp lp * (Complex.exp (lp * z) * Complex.exp (lp * (-zb)) +
          Complex.exp (lp * (-z)) * Complex.exp (lp * zb)) -
        Complex.exp (lp * z) * Complex.exp (lp * zb) -
        Complex.exp lp * Complex.exp (lp * (-z)) * (Complex.exp lp * Complex.exp (lp * (-zb))) := by
        rw [e1, e2]; ring
    _ = Complex.exp lp * ((Complex.exp (lp * (z - zb)) + Complex.exp (lp * (-(z - zb)))) -
          (Complex.exp (lp * (z - (1 - zb))) + Complex.exp (lp * (-(z - (1 - zb)))))) := by
        rw [e3, e4, ← e5, ← e6]; ring

/-- At every prime `p`, the height reflection product `A_{t,p}` of an isolated off-line quartet is
real and strictly negative (`2 cos(2 t log p) ≤ 2 < p^{2β - 1} + p^{1 - 2β}`). -/
theorem isolated_quartet_heightReflectionProduct_neg (p : Nat.Primes) {ρ : XiDivisorSupport}
    (hβ : (ρ : ℂ).re ≠ 1 / 2) (hU : primeUpperFibre (ρ : ℂ).im = {ρ, xiZeroMirror ρ}) :
    (primeHeightReflectionProduct p (ρ : ℂ).im : ℂ).im = 0 ∧
      (primeHeightReflectionProduct p (ρ : ℂ).im : ℂ).re < 0 := by
  have hA := congrArg (fun x : E => (x : ℂ))
    (isolated_quartet_heightReflectionProduct_eq p hβ hU)
  change (primeHeightReflectionProduct p (ρ : ℂ).im : ℂ) =
    (p : ℂ) * ((primeOrdinateValue p ρ : ℂ) - (primeWidthValue p ρ : ℂ)) at hA
  rw [primeOrdinateValue_coe, primeWidthValue_coe] at hA
  have hp1 : (1 : ℝ) < ((p : ℕ) : ℝ) := by exact_mod_cast p.2.one_lt
  have hp0 : (0 : ℝ) < ((p : ℕ) : ℝ) := by linarith
  set x : ℝ := ((p : ℕ) : ℝ) ^ (2 * (ρ : ℂ).re - 1)
  have hx0 : 0 < x := Real.rpow_pos_of_pos hp0 _
  have hx1 : x ≠ 1 := by
    intro hx
    have hl := congrArg Real.log hx
    rw [Real.log_rpow hp0, Real.log_one] at hl
    rcases mul_eq_zero.1 hl with h1 | h2
    · exact hβ (by linarith only [h1])
    · exact (Real.log_pos hp1).ne' h2
  have hxinv : ((p : ℕ) : ℝ) ^ (1 - 2 * (ρ : ℂ).re) = x⁻¹ := by
    rw [show 1 - 2 * (ρ : ℂ).re = -(2 * (ρ : ℂ).re - 1) by ring, Real.rpow_neg hp0.le]
  have hgt2 : 2 < x + x⁻¹ := by
    have hsq : 0 < (x - 1) ^ 2 / x := div_pos (sq_pos_of_ne_zero (sub_ne_zero.2 hx1)) hx0
    have hid : (x - 1) ^ 2 / x = x + x⁻¹ - 2 := by field_simp; ring
    linarith only [hsq, hid]
  have hcos : 2 * Real.cos (2 * (ρ : ℂ).im * Real.log ((p : ℕ) : ℝ)) ≤ 2 := by
    linarith [Real.cos_le_one (2 * (ρ : ℂ).im * Real.log ((p : ℕ) : ℝ))]
  have hreal : (primeHeightReflectionProduct p (ρ : ℂ).im : ℂ) =
      ((((p : ℕ) : ℝ) * (2 * Real.cos (2 * (ρ : ℂ).im * Real.log ((p : ℕ) : ℝ)) -
        (x + x⁻¹)) : ℝ) : ℂ) := by
    rw [hA, hxinv]
    push_cast
    ring
  rw [hreal, Complex.ofReal_im, Complex.ofReal_re]
  exact ⟨rfl, mul_neg_of_pos_of_neg hp0 (by linarith only [hcos, hgt2])⟩

/-- **Sign reversal of the height radicand product.** Unlike critical heights (where some prime has
`A_{t,p}² < 0`), a pure off-line quartet height has `A_{t,p}² ∈ B` strictly positive at **every**
prime `p`: `A_{t,p}² = p² (u_p(ρ) - v_p(ρ))² > 0` is `p²` times the discriminant of the quartet
quadratic `(X - u_p(ρ))(X - v_p(ρ)) ∈ B[X]`. -/
theorem isolated_quartet_radicand_square_pos (p : Nat.Primes) {ρ : XiDivisorSupport}
    (hβ : (ρ : ℂ).re ≠ 1 / 2) (hU : primeUpperFibre (ρ : ℂ).im = {ρ, xiZeroMirror ρ}) :
    ((primeHeightReflectionProduct p (ρ : ℂ).im *
        primeHeightReflectionProduct p (ρ : ℂ).im : E) : ℂ) ∈ B ∧
      ((primeHeightReflectionProduct p (ρ : ℂ).im *
        primeHeightReflectionProduct p (ρ : ℂ).im : E) : ℂ).im = 0 ∧
      0 < ((primeHeightReflectionProduct p (ρ : ℂ).im *
        primeHeightReflectionProduct p (ρ : ℂ).im : E) : ℂ).re := by
  obtain ⟨him, hre⟩ := isolated_quartet_heightReflectionProduct_neg p hβ hU
  refine ⟨heightReflectionProduct_mul_self_mem p (ρ : ℂ).im, ?_, ?_⟩
  · exact primeTraceField_real _ (heightReflectionProduct_mul_self_mem p (ρ : ℂ).im)
  · change 0 < ((primeHeightReflectionProduct p (ρ : ℂ).im : ℂ) *
      (primeHeightReflectionProduct p (ρ : ℂ).im : ℂ)).re
    rw [Complex.mul_re, him, mul_zero, sub_zero]
    exact mul_pos_of_neg_of_neg hre hre

/-- **Square-class and partial-flip criterion for an isolated quartet.** On a pure off-line quartet
height `U_{Im ρ} = {ρ, 1 - ρ̄}`, the positive element `A_{t,p}² ∈ B` is a square in `B` if and only
if `u_p(ρ) ∈ B`, if and only if `v_p(ρ) ∈ B`, if and only if `Gal(E/B)` contains no partial flip
`σ(ρ̄) = 1 - conj(σ ρ)`. In particular, squareness of `A_{t,p}²` in `B` is independent of `p`. -/
theorem isolated_quartet_square_iff_no_partialFlip (p : Nat.Primes) {ρ : XiDivisorSupport}
    (hβ : (ρ : ℂ).re ≠ 1 / 2) (hU : primeUpperFibre (ρ : ℂ).im = {ρ, xiZeroMirror ρ}) :
    ((∃ b : E, (b : ℂ) ∈ B ∧ b * b = primeHeightReflectionProduct p (ρ : ℂ).im *
        primeHeightReflectionProduct p (ρ : ℂ).im) ↔ (primeOrdinateValue p ρ : ℂ) ∈ B) ∧
    ((primeOrdinateValue p ρ : ℂ) ∈ B ↔ (primeWidthValue p ρ : ℂ) ∈ B) ∧
    ((primeOrdinateValue p ρ : ℂ) ∈ B ↔
      ¬ ∃ σ : G, primeTraceZeroMap σ (xiZeroConjEquiv ρ) =
        xiZeroReflectEquiv (xiZeroConjEquiv (primeTraceZeroMap σ ρ))) := by
  have hu_all := (isolated_quartet_primeUpperFibre_eq hβ).1 hU
  have hu_off : ∀ ρ' : XiDivisorSupport, |(ρ' : ℂ).im| = |(ρ : ℂ).im| → (ρ' : ℂ).re ≠ 1 / 2 →
      (ρ' : ℂ).re = (ρ : ℂ).re ∨ (ρ' : ℂ).re = 1 - (ρ : ℂ).re :=
    fun ρ' hi _ => hu_all ρ' hi
  have hquart : ∀ σ : G, (primeTraceZeroMap σ ρ : ℂ).re = (ρ : ℂ).re ∨
      (primeTraceZeroMap σ ρ : ℂ).re = 1 - (ρ : ℂ).re :=
    fun σ => (mem_quartet_iff_re σ ρ).1 (mem_quartet_of_offLine_unique ρ hu_off σ)
  have hsum : (primeOrdinateValue p ρ : ℂ) + (primeWidthValue p ρ : ℂ) ∈ B :=
    (sum_prod_mem_of_offLine_unique p ρ hu_off).1
  have hu_iff_v := primeOrdinateValue_mem_iff_width_mem p ρ hquart
  have hflip := exists_partialFlip_iff p ρ hquart hβ
  have hAeq : (primeHeightReflectionProduct p (ρ : ℂ).im : ℂ) =
      (p : ℂ) * ((primeOrdinateValue p ρ : ℂ) - (primeWidthValue p ρ : ℂ)) := by
    simpa using congrArg (fun x : E => (x : ℂ))
      (isolated_quartet_heightReflectionProduct_eq p hβ hU)
  refine ⟨?_, hu_iff_v, ?_⟩
  · constructor
    · rintro ⟨b, hb, hbb⟩
      have h0 : (b - primeHeightReflectionProduct p (ρ : ℂ).im) *
          (b + primeHeightReflectionProduct p (ρ : ℂ).im) = 0 := by
        linear_combination hbb
      have hAmem : (primeHeightReflectionProduct p (ρ : ℂ).im : ℂ) ∈ B := by
        rcases mul_eq_zero.1 h0 with h1 | h1
        · rwa [← sub_eq_zero.1 h1]
        · rw [eq_neg_of_add_eq_zero_right h1]
          exact primeTraceField.neg_mem hb
      have hpB : (p : ℂ) ∈ B := natCast_mem B (p : ℕ)
      have hp0 : (p : ℂ) ≠ 0 := Nat.cast_ne_zero.2 p.2.ne_zero
      have hdiff : (primeOrdinateValue p ρ : ℂ) - (primeWidthValue p ρ : ℂ) ∈ B := by
        have hmul := primeTraceField.mul_mem (primeTraceField.inv_mem hpB) hAmem
        rwa [hAeq, ← mul_assoc, inv_mul_cancel₀ hp0, one_mul] at hmul
      have h2B : (2 : ℂ) ∈ B := by exact_mod_cast natCast_mem B 2
      have h2u : (2 : ℂ) * (primeOrdinateValue p ρ : ℂ) ∈ B := by
        have hadd := primeTraceField.add_mem hsum hdiff
        convert hadd using 1
        ring
      have huB := primeTraceField.mul_mem (primeTraceField.inv_mem h2B) h2u
      rwa [← mul_assoc, inv_mul_cancel₀ two_ne_zero, one_mul] at huB
    · intro huB
      have hvB : (primeWidthValue p ρ : ℂ) ∈ B := hu_iff_v.1 huB
      refine ⟨primeHeightReflectionProduct p (ρ : ℂ).im, ?_, rfl⟩
      rw [hAeq]
      exact primeTraceField.mul_mem (natCast_mem B (p : ℕ))
        (primeTraceField.sub_mem huB hvB)
  · constructor
    · intro huB hex
      exact (hflip.1 hex) huB
    · intro hno
      by_contra huB
      exact hno (hflip.2 huB)

/-- **Symmetric trace factorization of an isolated quartet.** On a pure off-line quartet height
`U_{Im ρ} = {ρ, 1 - ρ̄}`, every mixed prime trace factors as
`T_t(m) = mult(ρ) e^{L/2} (e^{a L} + e^{-a L}) (e^{i t L} + e^{-i t L})`
with `a = Re ρ - 1/2`, `t = Im ρ`, and `L = primeRelationFrequency m`. Every trace in `B` from this
height is invariant under exchanging `a` and `i t` (`u_p(ρ) ↔ v_p(ρ)`). -/
theorem isolated_quartet_primeDivisorTrace_factorization {ρ : XiDivisorSupport}
    (hβ : (ρ : ℂ).re ≠ 1 / 2) (hU : primeUpperFibre (ρ : ℂ).im = {ρ, xiZeroMirror ρ})
    (m : Nat.Primes →₀ ℤ) :
    primeDivisorTrace (ρ : ℂ).im m =
      (xiSupportMult ρ : ℂ) * Complex.exp ((1 / 2 : ℂ) * (primeRelationFrequency m : ℂ)) *
        (Complex.exp ((((ρ : ℂ).re - 1 / 2 : ℝ) : ℂ) * (primeRelationFrequency m : ℂ)) +
          Complex.exp (-((((ρ : ℂ).re - 1 / 2 : ℝ) : ℂ) * (primeRelationFrequency m : ℂ)))) *
        (Complex.exp ((I * ((ρ : ℂ).im : ℂ)) * (primeRelationFrequency m : ℂ)) +
          Complex.exp (-((I * ((ρ : ℂ).im : ℂ)) * (primeRelationFrequency m : ℂ)))) := by
  have hne : ρ ≠ xiZeroMirror ρ := (xiZeroMirror_ne_self_of_re_ne_half hβ).symm
  rw [primeDivisorTrace_eq_sum_primeUpperFibre, hU, Finset.sum_pair hne, xiSupportMult_mirror]
  simp only [primeRelationValue]
  set L : ℂ := (primeRelationFrequency m : ℂ)
  set a : ℂ := (((ρ : ℂ).re - 1 / 2 : ℝ) : ℂ)
  set b : ℂ := I * ((ρ : ℂ).im : ℂ)
  have hz1 : (ρ : ℂ) * L = (1 / 2 : ℂ) * L + a * L + b * L := by
    have hρ : (ρ : ℂ) = 1 / 2 + a + b := by
      apply Complex.ext
      · simp [a, b]
      · simp [a, b]
    rw [hρ]; ring
  have hz2 : starRingEnd ℂ (ρ : ℂ) * L = (1 / 2 : ℂ) * L + a * L + -(b * L) := by
    have hρ : starRingEnd ℂ (ρ : ℂ) = 1 / 2 + a - b := by
      apply Complex.ext
      · simp [a, b]
      · simp [a, b]
    rw [hρ]; ring
  have hz3 : (xiZeroMirror ρ : ℂ) * L = (1 / 2 : ℂ) * L + -(a * L) + b * L := by
    have hρ : (xiZeroMirror ρ : ℂ) = 1 / 2 - a + b := by
      rw [xiZeroMirror_coe]
      apply Complex.ext
      · simp [a, b]; ring
      · simp [a, b]
    rw [hρ]; ring
  have hz4 : starRingEnd ℂ (xiZeroMirror ρ : ℂ) * L = (1 / 2 : ℂ) * L + -(a * L) + -(b * L) := by
    have hρ : starRingEnd ℂ (xiZeroMirror ρ : ℂ) = 1 / 2 - a - b := by
      rw [xiZeroMirror_coe]
      apply Complex.ext
      · simp [a, b]; ring
      · simp [a, b]
    rw [hρ]; ring
  rw [hz1, hz2, hz3, hz4]
  simp only [Complex.exp_add]
  ring

/-! ## 3. Regime B: shared ordinate with a critical zero (`1/2 + i t` present) -/

/-- **Any critical zero at ordinate `±Im ρ` eliminates partial flips at `ρ`.** Because
`u_p(ρ₀) = 2 cos(2 Im ρ₀ log p) ∈ B` for every critical zero `ρ₀`, sharing `|Im ρ| = |Im ρ₀|`
forces `u_p(ρ) = u_p(ρ₀) ∈ B` for every prime `p` and makes conjugation commute with every
`σ ∈ Gal(E/B)` on `ρ`. -/
theorem critical_ordinate_eliminates_partialFlip {ρ₀ ρ : XiDivisorSupport}
    (hρ₀ : (ρ₀ : ℂ).re = 1 / 2) (him : |(ρ₀ : ℂ).im| = |(ρ : ℂ).im|) :
    (∀ p : Nat.Primes, (primeOrdinateValue p ρ : ℂ) ∈ B) ∧
      ∀ σ : G, primeTraceZeroMap σ (xiZeroConjEquiv ρ) =
        xiZeroConjEquiv (primeTraceZeroMap σ ρ) := by
  have huB : ∀ p : Nat.Primes, (primeOrdinateValue p ρ : ℂ) ∈ B := by
    intro p
    have heq : (primeOrdinateValue p ρ : ℂ) = (primeOrdinateValue p ρ₀ : ℂ) := by
      rw [primeOrdinateValue_coe, primeOrdinateValue_coe]
      rcases abs_eq_abs.1 him with h | h
      · rw [h]
      · rw [h, show 2 * -(ρ : ℂ).im * Real.log ((p : ℕ) : ℝ) =
            -(2 * (ρ : ℂ).im * Real.log ((p : ℕ) : ℝ)) by ring, Real.cos_neg]
    rw [heq]
    exact primeOrdinateValue_mem_of_critical p ρ₀ hρ₀
  exact ⟨huB, (primeOrdinateValue_mem_iff_conj ⟨2, Nat.prime_two⟩ ρ).1
    (huB ⟨2, Nat.prime_two⟩)⟩

/-- **Klein-four Galois action for an off-line quartet sharing an ordinate with a critical zero.**
If `1/2 ± i Im ρ` is a zero and `Q(ρ)` is the unique off-line quartet at ordinate `±Im ρ`, then
both `u_p(ρ) ∈ B` and `v_p(ρ) ∈ B` at every prime `p`, and every `σ ∈ Gal(E/B)` restricts to `Q(ρ)`
as one of the four commuting involutions `{1, c, r, cr}`. -/
theorem shared_critical_and_isolated_quartet_klein_action {ρ₀ ρ : XiDivisorSupport}
    (hρ₀ : (ρ₀ : ℂ).re = 1 / 2) (him : |(ρ₀ : ℂ).im| = |(ρ : ℂ).im|)
    (_hβ : (ρ : ℂ).re ≠ 1 / 2)
    (hu : ∀ ρ' : XiDivisorSupport, |(ρ' : ℂ).im| = |(ρ : ℂ).im| → (ρ' : ℂ).re ≠ 1 / 2 →
      (ρ' : ℂ).re = (ρ : ℂ).re ∨ (ρ' : ℂ).re = 1 - (ρ : ℂ).re) :
    (∀ p : Nat.Primes, (primeOrdinateValue p ρ : ℂ) ∈ B ∧ (primeWidthValue p ρ : ℂ) ∈ B) ∧
      ∀ σ : G,
        (primeTraceZeroMap σ ρ = ρ ∧
            primeTraceZeroMap σ (xiZeroConjEquiv ρ) = xiZeroConjEquiv ρ) ∨
          (primeTraceZeroMap σ ρ = xiZeroConjEquiv ρ ∧
            primeTraceZeroMap σ (xiZeroConjEquiv ρ) = ρ) ∨
          (primeTraceZeroMap σ ρ = xiZeroReflectEquiv ρ ∧
            primeTraceZeroMap σ (xiZeroConjEquiv ρ) =
              xiZeroReflectEquiv (xiZeroConjEquiv ρ)) ∨
          (primeTraceZeroMap σ ρ = xiZeroReflectEquiv (xiZeroConjEquiv ρ) ∧
            primeTraceZeroMap σ (xiZeroConjEquiv ρ) = xiZeroReflectEquiv ρ) := by
  obtain ⟨huB, hconj⟩ := critical_ordinate_eliminates_partialFlip hρ₀ him
  have hquart : ∀ σ : G, (primeTraceZeroMap σ ρ : ℂ).re = (ρ : ℂ).re ∨
      (primeTraceZeroMap σ ρ : ℂ).re = 1 - (ρ : ℂ).re :=
    fun σ => (mem_quartet_iff_re σ ρ).1 (mem_quartet_of_offLine_unique ρ hu σ)
  have hvB : ∀ p : Nat.Primes, (primeWidthValue p ρ : ℂ) ∈ B :=
    fun p => (primeOrdinateValue_mem_iff_width_mem p ρ hquart).1 (huB p)
  refine ⟨fun p => ⟨huB p, hvB p⟩, fun σ => ?_⟩
  have hc := hconj σ
  rcases mem_quartet_of_offLine_unique ρ hu σ with h1 | h2 | h3 | h4
  · exact Or.inl ⟨h1, by rw [hc, h1]⟩
  · refine Or.inr (Or.inl ⟨h2, ?_⟩)
    rw [hc, h2]
    exact Subtype.ext (Complex.conj_conj (ρ : ℂ))
  · refine Or.inr (Or.inr (Or.inl ⟨h3, ?_⟩))
    rw [hc, h3]
    apply Subtype.ext
    change starRingEnd ℂ (1 - (ρ : ℂ)) = 1 - starRingEnd ℂ (ρ : ℂ)
    rw [map_sub, map_one]
  · refine Or.inr (Or.inr (Or.inr ⟨h4, ?_⟩))
    rw [hc, h4]
    apply Subtype.ext
    change starRingEnd ℂ (1 - starRingEnd ℂ (ρ : ℂ)) = 1 - (ρ : ℂ)
    rw [map_sub, map_one, Complex.conj_conj]

/-- **Explicit second-power prime trace in Regime B.** When a critical zero `ρ₀` (`Re ρ₀ = 1/2`)
shares the ordinate `Im ρ₀ = Im ρ` of the unique off-line quartet `Q(ρ)` at that height, the upper
fibre is `U_{Im ρ} = {ρ₀, ρ, 1 - ρ̄}` and
`T_{Im ρ}(2 e_p) = p (mult(ρ₀) u_p(ρ) + mult(ρ) u_p(ρ) v_p(ρ))`. -/
theorem shared_critical_and_isolated_quartet_trace_single_two (p : Nat.Primes)
    {ρ₀ ρ : XiDivisorSupport} (hρ₀ : (ρ₀ : ℂ).re = 1 / 2) (him : (ρ₀ : ℂ).im = (ρ : ℂ).im)
    (hβ : (ρ : ℂ).re ≠ 1 / 2)
    (hu : ∀ ρ' : XiDivisorSupport, |(ρ' : ℂ).im| = |(ρ : ℂ).im| → (ρ' : ℂ).re ≠ 1 / 2 →
      (ρ' : ℂ).re = (ρ : ℂ).re ∨ (ρ' : ℂ).re = 1 - (ρ : ℂ).re) :
    primeUpperFibre (ρ : ℂ).im = insert ρ₀ {ρ, xiZeroMirror ρ} ∧
      primeDivisorTrace (ρ : ℂ).im (Finsupp.single p 2) =
        (p : ℂ) * ((xiSupportMult ρ₀ : ℂ) * (primeOrdinateValue p ρ : ℂ) +
          (xiSupportMult ρ : ℂ) * ((primeOrdinateValue p ρ * primeWidthValue p ρ : E) : ℂ)) := by
  have hU : primeUpperFibre (ρ : ℂ).im = insert ρ₀ {ρ, xiZeroMirror ρ} := by
    ext ρ'
    rw [mem_primeUpperFibre, Finset.mem_insert, Finset.mem_insert, Finset.mem_singleton]
    constructor
    · intro him'
      by_cases hc : (ρ' : ℂ).re = 1 / 2
      · exact Or.inl (Subtype.ext (Complex.ext (hc.trans hρ₀.symm) (him'.trans him.symm)))
      · rcases hu ρ' (congrArg abs him') hc with hr | hr
        · exact Or.inr (Or.inl (Subtype.ext (Complex.ext hr him')))
        · exact Or.inr (Or.inr (Subtype.ext (Complex.ext (hr.trans (xiZeroMirror_re ρ).symm)
            (him'.trans (xiZeroMirror_im ρ).symm))))
    · rintro (rfl | rfl | rfl)
      · exact him
      · rfl
      · exact xiZeroMirror_im ρ
  have hne01 : ρ₀ ≠ ρ := fun e => hβ (e ▸ hρ₀)
  have hne02 : ρ₀ ≠ xiZeroMirror ρ := by
    intro e
    have hr := congrArg (fun z : XiDivisorSupport => (z : ℂ).re) e
    rw [hρ₀, xiZeroMirror_re] at hr
    exact hβ (by linarith only [hr])
  have hne12 : ρ ≠ xiZeroMirror ρ := (xiZeroMirror_ne_self_of_re_ne_half hβ).symm
  have hnotMem : ρ₀ ∉ ({ρ, xiZeroMirror ρ} : Finset XiDivisorSupport) := by
    rw [Finset.mem_insert, Finset.mem_singleton]
    rintro (h | h)
    · exact hne01 h
    · exact hne02 h
  refine ⟨hU, ?_⟩
  rw [primeDivisorTrace_eq_sum_primeUpperFibre, hU, Finset.sum_insert hnotMem,
    Finset.sum_pair hne12, xiSupportMult_mirror]
  have hsingle : ∀ z : ℂ, primeRelationValue z (Finsupp.single p 2) =
      Complex.exp ((Real.log (p : ℕ) : ℂ) * (2 * z)) := by
    intro z
    rw [primeRelationValue_single, zpow_two, ← Complex.exp_add]
    congr 1
    ring
  simp only [hsingle]
  have hord : (primeOrdinateValue p ρ : ℂ) =
      Complex.exp ((Real.log (p : ℕ) : ℂ) * ((ρ : ℂ) - starRingEnd ℂ (ρ : ℂ))) +
        Complex.exp ((Real.log (p : ℕ) : ℂ) * (-((ρ : ℂ) - starRingEnd ℂ (ρ : ℂ)))) := rfl
  have hwid : (primeWidthValue p ρ : ℂ) =
      Complex.exp ((Real.log (p : ℕ) : ℂ) * ((ρ : ℂ) - (1 - starRingEnd ℂ (ρ : ℂ)))) +
        Complex.exp ((Real.log (p : ℕ) : ℂ) * (-((ρ : ℂ) - (1 - starRingEnd ℂ (ρ : ℂ))))) := rfl
  change _ = (p : ℂ) * ((xiSupportMult ρ₀ : ℂ) * (primeOrdinateValue p ρ : ℂ) +
    (xiSupportMult ρ : ℂ) * ((primeOrdinateValue p ρ : ℂ) * (primeWidthValue p ρ : ℂ)))
  rw [hord, hwid, ← GaloisForLFunctions.RHTower.SixExponentials.exp_log_nat p.2.pos]
  set lp : ℂ := (Real.log (p : ℕ) : ℂ)
  have h2ρ0 : 2 * (ρ₀ : ℂ) = 1 + ((ρ : ℂ) - starRingEnd ℂ (ρ : ℂ)) := by
    apply Complex.ext
    · simp [hρ₀, him]
    · simp [hρ₀, him]; ring
  have h2ρ0c : 2 * starRingEnd ℂ (ρ₀ : ℂ) = 1 + -((ρ : ℂ) - starRingEnd ℂ (ρ : ℂ)) := by
    apply Complex.ext
    · simp [hρ₀, him]
    · simp [hρ₀, him]; ring
  rw [h2ρ0, h2ρ0c, xiZeroMirror_coe, map_sub, map_one, Complex.conj_conj]
  have c1 : Complex.exp (lp * (1 + ((ρ : ℂ) - starRingEnd ℂ (ρ : ℂ)))) =
      Complex.exp lp * Complex.exp (lp * ((ρ : ℂ) - starRingEnd ℂ (ρ : ℂ))) := by
    rw [← Complex.exp_add]; congr 1; ring
  have c2 : Complex.exp (lp * (1 + -((ρ : ℂ) - starRingEnd ℂ (ρ : ℂ)))) =
      Complex.exp lp * Complex.exp (lp * (-((ρ : ℂ) - starRingEnd ℂ (ρ : ℂ)))) := by
    rw [← Complex.exp_add]; congr 1; ring
  have q1 : Complex.exp lp * Complex.exp (lp * ((ρ : ℂ) - starRingEnd ℂ (ρ : ℂ))) *
      Complex.exp (lp * ((ρ : ℂ) - (1 - starRingEnd ℂ (ρ : ℂ)))) =
      Complex.exp (lp * (2 * (ρ : ℂ))) := by
    rw [← Complex.exp_add, ← Complex.exp_add]; congr 1; ring
  have q2 : Complex.exp lp * Complex.exp (lp * (-((ρ : ℂ) - starRingEnd ℂ (ρ : ℂ)))) *
      Complex.exp (lp * ((ρ : ℂ) - (1 - starRingEnd ℂ (ρ : ℂ)))) =
      Complex.exp (lp * (2 * starRingEnd ℂ (ρ : ℂ))) := by
    rw [← Complex.exp_add, ← Complex.exp_add]; congr 1; ring
  have q3 : Complex.exp lp * Complex.exp (lp * ((ρ : ℂ) - starRingEnd ℂ (ρ : ℂ))) *
      Complex.exp (lp * (-((ρ : ℂ) - (1 - starRingEnd ℂ (ρ : ℂ))))) =
      Complex.exp (lp * (2 * (1 - starRingEnd ℂ (ρ : ℂ)))) := by
    rw [← Complex.exp_add, ← Complex.exp_add]; congr 1; ring
  have q4 : Complex.exp lp * Complex.exp (lp * (-((ρ : ℂ) - starRingEnd ℂ (ρ : ℂ)))) *
      Complex.exp (lp * (-((ρ : ℂ) - (1 - starRingEnd ℂ (ρ : ℂ))))) =
      Complex.exp (lp * (2 * (1 - (ρ : ℂ)))) := by
    rw [← Complex.exp_add, ← Complex.exp_add]; congr 1; ring
  rw [c1, c2]
  linear_combination -(xiSupportMult ρ : ℂ) * (q1 + q2 + q3 + q4)

