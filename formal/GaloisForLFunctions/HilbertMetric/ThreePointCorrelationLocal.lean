import GaloisForLFunctions.HilbertMetric.ThreePointCorrelation
import Mathlib.Analysis.Convex.Deriv
import Mathlib.Analysis.Matrix.Order

/-!
# Local three-point correlation chambers

This module isolates the exact second-jet mechanism behind an asymmetric local chamber of a
three-point correlation determinant.  It contains no spectral assumption and no numerical input.
-/

open Matrix Set Filter Topology

namespace HilbertMetric

/-- Determinant along the ordered three-point path `0,x,x+y` generated by a radial profile `f`. -/
def threePointCorrelationDeterminantPath (f : ℝ → ℝ) (y x : ℝ) : ℝ :=
  threePointCorrelationDeterminant (f 0) (f x) (f y) (f (x + y))

/-- The literal first derivative of `threePointCorrelationDeterminantPath`. -/
def threePointCorrelationDeterminantPathFirstJet
    (f f' : ℝ → ℝ) (y x : ℝ) : ℝ :=
  2 * f' x * f y * f (x + y) + 2 * f x * f y * f' (x + y) -
    2 * f 0 * (f x * f' x + f (x + y) * f' (x + y))

/-- The literal second derivative of `threePointCorrelationDeterminantPath`. -/
def threePointCorrelationDeterminantPathSecondJet
    (f f' f'' : ℝ → ℝ) (y x : ℝ) : ℝ :=
  2 * (f'' x * f y * f (x + y) + 2 * f' x * f y * f' (x + y) +
    f x * f y * f'' (x + y)) -
  2 * f 0 * (f' x ^ (2 : ℕ) + f x * f'' x + f' (x + y) ^ (2 : ℕ) +
    f (x + y) * f'' (x + y))

theorem hasDerivAt_threePointCorrelationDeterminantPath
    {f f' : ℝ → ℝ} (hf : ∀ x, HasDerivAt f (f' x) x) (y x : ℝ) :
    HasDerivAt (threePointCorrelationDeterminantPath f y)
      (threePointCorrelationDeterminantPathFirstJet f f' y x) x := by
  have hx := hf x
  have hxy : HasDerivAt (fun z => f (z + y)) (f' (x + y)) x := by
    simpa only [Function.comp_def, id_eq, mul_one] using
      (hf (x + y)).comp x ((hasDerivAt_id x).add_const y)
  have hmain := (((hx.const_mul 2).mul_const (f y)).mul hxy)
  have hsquares := ((hx.mul hx).add_const (f y ^ (2 : ℕ))).add (hxy.mul hxy)
  have h := (hmain.sub (hsquares.const_mul (f 0))).add_const (f 0 ^ (3 : ℕ))
  apply (h.congr_deriv (by
    unfold threePointCorrelationDeterminantPathFirstJet
    ring)).congr_of_eventuallyEq
  filter_upwards with z
  unfold threePointCorrelationDeterminantPath threePointCorrelationDeterminant
  simp only [Pi.mul_apply, Pi.add_apply, Pi.sub_apply]
  ring

theorem hasDerivAt_threePointCorrelationDeterminantPathFirstJet
    {f f' f'' : ℝ → ℝ}
    (hf : ∀ x, HasDerivAt f (f' x) x)
    (hf' : ∀ x, HasDerivAt f' (f'' x) x) (y x : ℝ) :
    HasDerivAt (threePointCorrelationDeterminantPathFirstJet f f' y)
      (threePointCorrelationDeterminantPathSecondJet f f' f'' y x) x := by
  have hx := hf x
  have hx' := hf' x
  have hxy : HasDerivAt (fun z => f (z + y)) (f' (x + y)) x := by
    simpa only [Function.comp_def, id_eq, mul_one] using
      (hf (x + y)).comp x ((hasDerivAt_id x).add_const y)
  have hxy' : HasDerivAt (fun z => f' (z + y)) (f'' (x + y)) x := by
    simpa only [Function.comp_def, id_eq, mul_one] using
      (hf' (x + y)).comp x ((hasDerivAt_id x).add_const y)
  have hA := (((hx'.const_mul 2).mul_const (f y)).mul hxy)
  have hB := (((hx.const_mul 2).mul_const (f y)).mul hxy')
  have hC := ((hx.mul hx').add (hxy.mul hxy')).const_mul (2 * f 0)
  have h := (hA.add hB).sub hC
  apply (h.congr_deriv (by
    unfold threePointCorrelationDeterminantPathSecondJet
    ring)).congr_of_eventuallyEq
  filter_upwards with z
  unfold threePointCorrelationDeterminantPathFirstJet
  simp only [Pi.mul_apply, Pi.add_apply, Pi.sub_apply]

/-- If a twice differentiable path has zero value and first jet at the left endpoint and a
strictly positive second jet throughout an interval, then it is strictly positive inside that
interval. -/
theorem pos_right_of_secondJet_posOn
    {F F' F'' : ℝ → ℝ}
    (hF : ∀ x, HasDerivAt F (F' x) x)
    (hF' : ∀ x, HasDerivAt F' (F'' x) x)
    (hzero : F 0 = 0) (hfirst : F' 0 = 0)
    {ε : ℝ} (hε : 0 < ε)
    (hsecond : ∀ x ∈ interior (Icc (0 : ℝ) ε), 0 < F'' x) :
    ∀ x, 0 < x → x < ε → 0 < F x := by
  have hF'cont : Continuous F' :=
    continuous_iff_continuousAt.mpr fun x => (hF' x).continuousAt
  have hFcont : Continuous F :=
    continuous_iff_continuousAt.mpr fun x => (hF x).continuousAt
  have hF'strict : StrictMonoOn F' (Icc (0 : ℝ) ε) :=
    strictMonoOn_of_hasDerivWithinAt_pos (convex_Icc 0 ε) hF'cont.continuousOn
      (fun x _ => (hF' x).hasDerivWithinAt) hsecond
  have hfirst_pos : ∀ x ∈ interior (Icc (0 : ℝ) ε), 0 < F' x := by
    intro x hx
    have hxIoo : x ∈ Ioo (0 : ℝ) ε := by simpa [interior_Icc, hε.ne'] using hx
    have hlt := hF'strict (by exact ⟨le_rfl, hε.le⟩)
      ⟨hxIoo.1.le, hxIoo.2.le⟩ hxIoo.1
    simpa [hfirst] using hlt
  have hFstrict : StrictMonoOn F (Icc (0 : ℝ) ε) :=
    strictMonoOn_of_hasDerivWithinAt_pos (convex_Icc 0 ε) hFcont.continuousOn
      (fun x _ => (hF x).hasDerivWithinAt) hfirst_pos
  intro x hx0 hxε
  have hlt := hFstrict (by exact ⟨le_rfl, hε.le⟩) ⟨hx0.le, hxε.le⟩ hx0
  simpa [hzero] using hlt

/-- A twice differentiable path with zero value and first jet, positive second jet, and continuous
second derivative is strictly positive immediately to the right of the base point. -/
theorem exists_pos_right_of_secondJet_pos
    {F F' F'' : ℝ → ℝ}
    (hF : ∀ x, HasDerivAt F (F' x) x)
    (hF' : ∀ x, HasDerivAt F' (F'' x) x)
    (hF'' : Continuous F'')
    (hzero : F 0 = 0) (hfirst : F' 0 = 0) (hsecond : 0 < F'' 0) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ x, 0 < x → x < ε → 0 < F x := by
  have hopen : IsOpen {x : ℝ | 0 < F'' x} :=
    isOpen_lt continuous_const hF''
  have hn : {x : ℝ | 0 < F'' x} ∈ 𝓝 0 := hopen.mem_nhds hsecond
  rcases Metric.mem_nhds_iff.mp hn with ⟨δ, hδ, hball⟩
  let ε := δ / 2
  have hε : 0 < ε := div_pos hδ (by norm_num)
  have hsecond_pos : ∀ x ∈ interior (Icc (0 : ℝ) ε), 0 < F'' x := by
    intro x hx
    have hxIoo : x ∈ Ioo (0 : ℝ) ε := by simpa [interior_Icc, hε.ne'] using hx
    apply hball
    rw [Metric.mem_ball, dist_zero_right, Real.norm_eq_abs]
    have hx0 : 0 ≤ x := hxIoo.1.le
    rw [abs_of_nonneg hx0]
    exact lt_trans hxIoo.2 (by dsimp [ε]; linarith)
  have hF'cont : Continuous F' :=
    continuous_iff_continuousAt.mpr fun x => (hF' x).continuousAt
  have hFcont : Continuous F :=
    continuous_iff_continuousAt.mpr fun x => (hF x).continuousAt
  have hF'strict : StrictMonoOn F' (Icc (0 : ℝ) ε) :=
    strictMonoOn_of_hasDerivWithinAt_pos (convex_Icc 0 ε) hF'cont.continuousOn
      (fun x _ => (hF' x).hasDerivWithinAt) hsecond_pos
  have hfirst_pos : ∀ x ∈ interior (Icc (0 : ℝ) ε), 0 < F' x := by
    intro x hx
    have hxIoo : x ∈ Ioo (0 : ℝ) ε := by simpa [interior_Icc, hε.ne'] using hx
    have hlt := hF'strict (by exact ⟨le_rfl, hε.le⟩)
      ⟨hxIoo.1.le, hxIoo.2.le⟩ hxIoo.1
    simpa [hfirst] using hlt
  have hFstrict : StrictMonoOn F (Icc (0 : ℝ) ε) :=
    strictMonoOn_of_hasDerivWithinAt_pos (convex_Icc 0 ε) hFcont.continuousOn
      (fun x _ => (hF x).hasDerivWithinAt) hfirst_pos
  refine ⟨ε, hε, fun x hx0 hxε => ?_⟩
  have hlt := hFstrict (by exact ⟨le_rfl, hε.le⟩) ⟨hx0.le, hxε.le⟩ hx0
  simpa [hzero] using hlt

/-- Exact local determinant theorem.  The displayed scalar is the surviving second jet after the
value and first derivative cancel at the coalesced three-point configuration. -/
theorem exists_threePointCorrelationDeterminantPath_pos_right
    {f f' f'' : ℝ → ℝ}
    (hf : ∀ x, HasDerivAt f (f' x) x)
    (hf' : ∀ x, HasDerivAt f' (f'' x) x)
    (hf'' : Continuous f'')
    (hfirst_zero : f' 0 = 0) {y : ℝ}
    (hwall : 0 < (-f'' 0) * (f 0 ^ (2 : ℕ) - f y ^ (2 : ℕ)) - f 0 * f' y ^ (2 : ℕ)) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ x, 0 < x → x < ε →
      0 < threePointCorrelationDeterminantPath f y x := by
  let D := threePointCorrelationDeterminantPath f y
  let D' := threePointCorrelationDeterminantPathFirstJet f f' y
  let D'' := threePointCorrelationDeterminantPathSecondJet f f' f'' y
  have hD : ∀ x, HasDerivAt D (D' x) x := fun x =>
    hasDerivAt_threePointCorrelationDeterminantPath hf y x
  have hD' : ∀ x, HasDerivAt D' (D'' x) x := fun x =>
    hasDerivAt_threePointCorrelationDeterminantPathFirstJet hf hf' y x
  have hfcont : Continuous f :=
    continuous_iff_continuousAt.mpr fun x => (hf x).continuousAt
  have hf'cont : Continuous f' :=
    continuous_iff_continuousAt.mpr fun x => (hf' x).continuousAt
  have hD'' : Continuous D'' := by
    change Continuous (fun x =>
      2 * (f'' x * f y * f (x + y) + 2 * f' x * f y * f' (x + y) +
        f x * f y * f'' (x + y)) -
      2 * f 0 * (f' x ^ (2 : ℕ) + f x * f'' x + f' (x + y) ^ (2 : ℕ) +
        f (x + y) * f'' (x + y)))
    fun_prop
  have hDzero : D 0 = 0 := by
    simp [D, threePointCorrelationDeterminantPath,
      threePointCorrelationDeterminant]
    ring
  have hD'zero : D' 0 = 0 := by
    simp [D', threePointCorrelationDeterminantPathFirstJet, hfirst_zero]
    ring
  have hD''zero : D'' 0 =
      2 * ((-f'' 0) * (f 0 ^ (2 : ℕ) - f y ^ (2 : ℕ)) - f 0 * f' y ^ (2 : ℕ)) := by
    simp [D'', threePointCorrelationDeterminantPathSecondJet, hfirst_zero]
    ring
  apply exists_pos_right_of_secondJet_pos hD hD' hD'' hDzero hD'zero
  rw [hD''zero]
  exact mul_pos (by norm_num) hwall

/-- A radial profile with negative center curvature and vanishing first two tail jets has a
uniform coalescing-node determinant chamber for every sufficiently remote second gap. -/
theorem exists_uniform_threePointCorrelationDeterminantPath_pos_right_atTop
    {f f' f'' : ℝ → ℝ}
    (hf : ∀ x, HasDerivAt f (f' x) x)
    (hf' : ∀ x, HasDerivAt f' (f'' x) x)
    (hf'' : Continuous f'')
    (hfirst_zero : f' 0 = 0)
    (hcenter_pos : 0 < f 0) (hcenter_second_neg : f'' 0 < 0)
    (htail : Tendsto f atTop (nhds 0))
    (htail' : Tendsto f' atTop (nhds 0))
    (htail'' : Tendsto f'' atTop (nhds 0)) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ᶠ y : ℝ in atTop, ∀ x : ℝ, 0 < x → x < ε →
      0 < threePointCorrelationDeterminantPath f y x := by
  let l : Filter (ℝ × ℝ) := atTop ×ˢ nhds 0
  have hy : Tendsto (fun p : ℝ × ℝ => p.1) l atTop := tendsto_fst
  have hx : Tendsto (fun p : ℝ × ℝ => p.2) l (nhds 0) := tendsto_snd
  have hyx : Tendsto (fun p : ℝ × ℝ => p.1 + p.2) l atTop := hy.atTop_add hx
  have hfx : Tendsto (fun p : ℝ × ℝ => f p.2) l (nhds (f 0)) :=
    Filter.Tendsto.comp (hf 0).continuousAt hx
  have hfx' : Tendsto (fun p : ℝ × ℝ => f' p.2) l (nhds (f' 0)) :=
    Filter.Tendsto.comp (hf' 0).continuousAt hx
  have hfx'' : Tendsto (fun p : ℝ × ℝ => f'' p.2) l (nhds (f'' 0)) :=
    Filter.Tendsto.comp hf''.continuousAt hx
  have hfy : Tendsto (fun p : ℝ × ℝ => f p.1) l (nhds 0) := htail.comp hy
  have hfxy : Tendsto (fun p : ℝ × ℝ => f (p.2 + p.1)) l (nhds 0) := by
    simpa only [Function.comp_apply, add_comm] using! htail.comp hyx
  have hf'xy : Tendsto (fun p : ℝ × ℝ => f' (p.2 + p.1)) l (nhds 0) := by
    simpa only [Function.comp_apply, add_comm] using! htail'.comp hyx
  have hf''xy : Tendsto (fun p : ℝ × ℝ => f'' (p.2 + p.1)) l (nhds 0) := by
    simpa only [Function.comp_apply, add_comm] using! htail''.comp hyx
  have hleft := (((hfx''.mul hfy).mul hfxy).add
      (((hfx'.mul hfy).mul hf'xy).const_mul 2) |>.add
        ((hfx.mul hfy).mul hf''xy)).const_mul 2
  have hright := ((((hfx'.pow 2).add (hfx.mul hfx'')).add (hf'xy.pow 2)).add
      (hfxy.mul hf''xy)).const_mul (2 * f 0)
  have hlimRaw := hleft.sub hright
  have hlim : Tendsto (fun p : ℝ × ℝ =>
      threePointCorrelationDeterminantPathSecondJet f f' f'' p.1 p.2) l
      (nhds (-2 * f 0 ^ (2 : ℕ) * f'' 0)) := by
    unfold threePointCorrelationDeterminantPathSecondJet
    convert hlimRaw using 1
    · funext p
      ring
    · congr 1
      rw [hfirst_zero]
      ring
  have hlimit_pos : 0 < -2 * f 0 ^ (2 : ℕ) * f'' 0 := by
    have hsquare : 0 < f 0 ^ (2 : ℕ) := sq_pos_of_pos hcenter_pos
    exact mul_pos_of_neg_of_neg (mul_neg_of_neg_of_pos (by norm_num) hsquare)
      hcenter_second_neg
  have hpos : ∀ᶠ p : ℝ × ℝ in l,
      0 < threePointCorrelationDeterminantPathSecondJet f f' f'' p.1 p.2 :=
    hlim.eventually (Ioi_mem_nhds hlimit_pos)
  rcases eventually_prod_iff.mp hpos with ⟨py, hpy, px, hpx, hrect⟩
  rcases Metric.mem_nhds_iff.mp hpx with ⟨δ, hδ, hball⟩
  let ε := δ / 2
  have hε : 0 < ε := div_pos hδ (by norm_num)
  refine ⟨ε, hε, ?_⟩
  filter_upwards [hpy] with y hy_mem
  let D := threePointCorrelationDeterminantPath f y
  let D' := threePointCorrelationDeterminantPathFirstJet f f' y
  let D'' := threePointCorrelationDeterminantPathSecondJet f f' f'' y
  have hD : ∀ x, HasDerivAt D (D' x) x := fun x =>
    hasDerivAt_threePointCorrelationDeterminantPath hf y x
  have hD' : ∀ x, HasDerivAt D' (D'' x) x := fun x =>
    hasDerivAt_threePointCorrelationDeterminantPathFirstJet hf hf' y x
  have hDzero : D 0 = 0 := by
    simp [D, threePointCorrelationDeterminantPath, threePointCorrelationDeterminant]
    ring
  have hD'zero : D' 0 = 0 := by
    simp [D', threePointCorrelationDeterminantPathFirstJet, hfirst_zero]
    ring
  have hD''pos : ∀ x ∈ interior (Icc (0 : ℝ) ε), 0 < D'' x := by
    intro x hx_mem
    have hxIoo : x ∈ Ioo (0 : ℝ) ε := by
      simpa [interior_Icc, hε.ne'] using hx_mem
    apply hrect hy_mem
    apply hball
    rw [Metric.mem_ball, dist_zero_right, Real.norm_eq_abs, abs_of_nonneg hxIoo.1.le]
    exact lt_trans hxIoo.2 (by dsimp [ε]; linarith)
  exact pos_right_of_secondJet_posOn hD hD' hDzero hD'zero hε hD''pos

theorem det_threePointCorrelationMatrix (d p q r : ℝ) :
    (threePointCorrelationMatrix d p q r).det =
      threePointCorrelationDeterminant d p q r := by
  simp [threePointCorrelationMatrix, threePointCorrelationDeterminant, Matrix.det_fin_three]
  ring

/-- In the nondegenerate chamber, the strict cubic inequality is exactly positive definiteness. -/
theorem threePointCorrelationMatrix_posDef_iff
    {d p q r : ℝ} (hd : 0 < d) (hp0 : 0 ≤ p) (hp : p < d) :
    Matrix.PosDef (threePointCorrelationMatrix d p q r) ↔
      0 < threePointCorrelationDeterminant d p q r := by
  constructor
  · intro h
    rw [← det_threePointCorrelationMatrix]
    exact h.det_pos
  · intro hdet
    have hpsd := (threePointCorrelationMatrix_posSemidef_iff hd hp0 hp).2 hdet.le
    apply hpsd.posDef_iff_det_ne_zero.mpr
    rw [det_threePointCorrelationMatrix]
    exact hdet.ne'

end HilbertMetric
