import GaloisForLFunctions.HilbertMetric.QuantumInformation.CauchyDephasing
import GaloisForLFunctions.HTGeometry.HalfLineExponentialPacketGram

/-!
# Laplace representation of inverse Jordan evolution

Positive exponential rates define an integrable two-sided heat flow.
Its coefficientwise Laplace integral is the inverse Jordan operator;
differentiation recovers the Jordan generator and its semigroup law.
-/
noncomputable section
open Matrix MeasureTheory Set
open scoped ComplexConjugate
namespace GaloisForLFunctions.HilbertMetric.CauchyJordan

/-- Positive diagonal heat evolution generated by the constructed exponential rates. -/
def rateHeat {n : ℕ} (r : Fin n → ℝ) (t : ℝ) : Matrix (Fin n) (Fin n) ℂ :=
  diagonal fun i => Complex.exp (-(rate r i : ℂ) * (t : ℂ))

/-- The two-sided decaying matrix whose Laplace integral solves Jordan inversion. -/
def heatSandwich {n : ℕ} (r : Fin n → ℝ) (A : Matrix (Fin n) (Fin n) ℂ)
    (t : ℝ) : Matrix (Fin n) (Fin n) ℂ := rateHeat r t * A * rateHeat r t

private theorem heatSandwich_apply {n : ℕ} (r : Fin n → ℝ)
    (A : Matrix (Fin n) (Fin n) ℂ) (t : ℝ) (i j : Fin n) :
    heatSandwich r A t i j = A i j *
      (Complex.exp (-(rate r i : ℂ) * (t : ℂ)) *
        Complex.exp (-(rate r j : ℂ) * (t : ℂ))) := by
  simp only [heatSandwich, rateHeat, Matrix.mul_diagonal, Matrix.diagonal_mul]
  ring

/-- Every matrix coefficient of the constructed heat sandwich is integrable. -/
theorem heatSandwich_integrableOn {n : ℕ} (r : Fin n → ℝ)
    (A : Matrix (Fin n) (Fin n) ℂ) (i j : Fin n) :
    IntegrableOn (fun t : ℝ => heatSandwich r A t i j) (Ioi 0) := by
  simp_rw [heatSandwich_apply]
  exact (HTGeometry.integrableOn_exp_atom_mul
    (show 0 < (rate r i : ℂ).re from Real.exp_pos _)
    (show 0 < (rate r j : ℂ).re from Real.exp_pos _)).const_mul (A i j)

/-- Jordan inversion is exactly twice the entrywise Laplace integral of positive-rate heat. -/
theorem inverseJordan_eq_laplace {n : ℕ} (r : Fin n → ℝ)
    (A : Matrix (Fin n) (Fin n) ℂ) :
    inverseJordan r A = fun i j =>
      2 * ∫ t : ℝ in Ioi 0, heatSandwich r A t i j := by
  ext i j
  simp_rw [heatSandwich_apply]
  rw [integral_const_mul, HTGeometry.integral_exp_atom_mul
    (show 0 < (rate r i : ℂ).re from Real.exp_pos _)
    (show 0 < (rate r j : ℂ).re from Real.exp_pos _)]
  simp only [inverseJordan, div_eq_mul_inv]
  ring

/-- Each actual heat coefficient solves the Jordan evolution equation. -/
theorem heatSandwich_hasDerivAt {n : ℕ} (r : Fin n → ℝ)
    (A : Matrix (Fin n) (Fin n) ℂ) (t : ℝ) (i j : Fin n) :
    HasDerivAt (fun s : ℝ => heatSandwich r A s i j)
      (-2 * jordan r (heatSandwich r A t) i j) t := by
  have hi := ((Complex.hasDerivAt_ofReal t).const_mul (-(rate r i : ℂ))).cexp
  have hj := ((Complex.hasDerivAt_ofReal t).const_mul (-(rate r j : ℂ))).cexp
  have h := (hi.mul hj).const_mul (A i j)
  rw [jordan_apply]
  convert h using 1
  · funext s
    exact heatSandwich_apply r A s i j
  · rw [heatSandwich_apply]
    ring

/-- Heat evolution has the exact additive semigroup law. -/
theorem rateHeat_add {n : ℕ} (r : Fin n → ℝ) (s t : ℝ) :
    rateHeat r (s + t) = rateHeat r s * rateHeat r t := by
  ext i j
  by_cases h : i = j
  · subst j
    simp only [rateHeat, Matrix.diagonal_mul_diagonal, Matrix.diagonal_apply_eq]
    rw [Complex.ofReal_add, mul_add, Complex.exp_add]
  · simp only [rateHeat, Matrix.diagonal_mul_diagonal, Matrix.diagonal_apply, if_neg h]

/-- The heat-sandwich trajectories compose by adding their times. -/
theorem heatSandwich_add {n : ℕ} (r : Fin n → ℝ)
    (A : Matrix (Fin n) (Fin n) ℂ) (s t : ℝ) :
    heatSandwich r A (s + t) = heatSandwich r (heatSandwich r A t) s := by
  have hcomm : rateHeat r s * rateHeat r t = rateHeat r t * rateHeat r s := by
    rw [← rateHeat_add, ← rateHeat_add, add_comm]
  unfold heatSandwich
  rw [rateHeat_add]
  calc
    _ = rateHeat r s * (rateHeat r t * A) * (rateHeat r s * rateHeat r t) := by
      simp only [mul_assoc]
    _ = _ := by rw [hcomm]; simp only [mul_assoc]

#print axioms heatSandwich_integrableOn
#print axioms inverseJordan_eq_laplace
#print axioms heatSandwich_hasDerivAt
#print axioms rateHeat_add
#print axioms heatSandwich_add
end GaloisForLFunctions.HilbertMetric.CauchyJordan
