    have hi_sh : ∀ a b : ℝ, IntervalIntegrable (fun u => oddClampWitnessFun u * Real.sinh (u / 2)) volume a b :=
      fun a b => (hc_f.mul (by fun_prop)).intervalIntegrable a b
    rw [← intervalIntegral.integral_add_adjacent_intervals (hi_sh 0 radiusQ2A) (hi_sh radiusQ2A B)]
    have htail0 : (∫ u in radiusQ2A..B, oddClampWitnessFun u * Real.sinh (u / 2)) = 0 := by
      rw [intervalIntegral_congr_Ioo (g := fun _ => 0) (by dsimp [B]; norm_num) fun u hu _ => by
        rw [oddClampWitnessFun_eq_zero_of_lt (by rw [abs_of_pos (by norm_num [radiusQ2A] at hu; linarith)]; exact hu), zero_mul]]
      simp
