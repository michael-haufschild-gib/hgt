/-! ## Section 2: Hyperbolic Maclaurin Bounds, Universal Clamp Splines, and Flipped Atom `2` -/

/-- Partial Maclaurin remainders of `cosh` and `sinh`. -/
def coshMaclaurinRem (k : ℕ) (u : ℝ) : ℝ :=
  Real.cosh u - ∑ m ∈ Finset.range k, u ^ (2 * m) / (2 * m).factorial

def sinhMaclaurinRem (k : ℕ) (u : ℝ) : ℝ :=
  Real.sinh u - ∑ m ∈ Finset.range k, u ^ (2 * m + 1) / (2 * m + 1).factorial

private theorem hasDerivAt_sinhMaclaurinRem (k : ℕ) (u : ℝ) :
    HasDerivAt (sinhMaclaurinRem k) (coshMaclaurinRem k u) u := by
  unfold sinhMaclaurinRem coshMaclaurinRem
  have hsum : HasDerivAt
      (fun x : ℝ => ∑ m ∈ Finset.range k, x ^ (2 * m + 1) / (2 * m + 1).factorial)
      (∑ m ∈ Finset.range k, u ^ (2 * m) / (2 * m).factorial) u := by
    have hd := HasDerivAt.fun_sum fun m (_ : m ∈ Finset.range k) =>
      (hasDerivAt_pow (2 * m + 1) u).div_const ((2 * m + 1).factorial : ℝ)
    refine hd.congr_deriv (Finset.sum_congr rfl fun m _ => ?_)
    have hfac : ((2 * m + 1).factorial : ℝ) = ((2 * m + 1 : ℕ) : ℝ) * (2 * m).factorial := by
      rw [Nat.factorial_succ]; push_cast; ring
    have hpos : ((2 * m + 1 : ℕ) : ℝ) ≠ 0 := by positivity
    have hfac0 : ((2 * m).factorial : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
    rw [hfac, show 2 * m + 1 - 1 = 2 * m by omega]
    field_simp
  exact (Real.hasDerivAt_sinh u).sub hsum

private theorem hasDerivAt_coshMaclaurinRem_succ (k : ℕ) (u : ℝ) :
    HasDerivAt (coshMaclaurinRem (k + 1)) (sinhMaclaurinRem k u) u := by
  have hsplit : ∀ x : ℝ, coshMaclaurinRem (k + 1) x =
      (Real.cosh x - 1) -
        ∑ m ∈ Finset.range k, x ^ (2 * (m + 1)) / (2 * (m + 1)).factorial :=
    fun x => by
      unfold coshMaclaurinRem
      rw [Finset.sum_range_succ']
      simp [Nat.factorial]
      ring
  have hsum : HasDerivAt
      (fun x : ℝ => ∑ m ∈ Finset.range k, x ^ (2 * (m + 1)) / (2 * (m + 1)).factorial)
      (∑ m ∈ Finset.range k, u ^ (2 * m + 1) / (2 * m + 1).factorial) u := by
    have hd := HasDerivAt.fun_sum fun m (_ : m ∈ Finset.range k) =>
      (hasDerivAt_pow (2 * (m + 1)) u).div_const ((2 * (m + 1)).factorial : ℝ)
    refine hd.congr_deriv (Finset.sum_congr rfl fun m _ => ?_)
    have h2m : 2 * (m + 1) = (2 * m + 1) + 1 := by omega
    rw [h2m, Nat.factorial_succ, show (2 * m + 1) + 1 - 1 = 2 * m + 1 by omega]
    push_cast
    have hpos : ((2 * m + 1 + 1 : ℕ) : ℝ) ≠ 0 := by positivity
    have hfac0 : ((2 * m + 1).factorial : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
    field_simp
  have hd := (((Real.hasDerivAt_cosh u).sub (hasDerivAt_const u (1 : ℝ))).sub hsum).congr_of_eventuallyEq
    (Eventually.of_forall hsplit)
  refine hd.congr_deriv ?_
  unfold sinhMaclaurinRem
  ring

/-- Nonnegativity on `[0, ∞)` and remainder upper bounds on `[0, 1]` for all `cosh` and `sinh`
Maclaurin partial sums. -/
theorem cosh_sinh_maclaurin_rem_bounds (k : ℕ) :
    (∀ {u : ℝ}, 0 ≤ u → 0 ≤ coshMaclaurinRem k u ∧ 0 ≤ sinhMaclaurinRem k u) ∧
      (∀ {u : ℝ}, 0 ≤ u → u ≤ 1 →
        coshMaclaurinRem k u ≤ 2 * u ^ (2 * k) / (2 * k).factorial ∧
          sinhMaclaurinRem k u ≤ 2 * u ^ (2 * k + 1) / (2 * k + 1).factorial) := by
  induction k with
  | zero =>
    have hch_pos : ∀ s : ℝ, 0 ≤ coshMaclaurinRem 0 s := fun s => by
      simp [coshMaclaurinRem, (Real.cosh_pos s).le]
    have hch_le : ∀ {s : ℝ}, 0 ≤ s → s ≤ 1 → coshMaclaurinRem 0 s ≤ 2 := fun {s} hs0 hs1 => by
      unfold coshMaclaurinRem
      simp only [Finset.sum_range_zero, sub_zero]
      have he1 : Real.exp s ≤ 3 :=
        (Real.exp_le_exp.mpr hs1).trans (by linarith [Real.exp_one_lt_d9])
      have he2 : Real.exp (-s) ≤ 1 := by simpa using Real.exp_le_exp.mpr (by linarith : -s ≤ 0)
      rw [Real.cosh_eq]
      linarith
    refine ⟨fun {u} hu => ⟨hch_pos u, ?_⟩, fun {u} hu0 hu1 => ⟨?_, ?_⟩⟩
    · have hmono : MonotoneOn (sinhMaclaurinRem 0) (Ici 0) :=
        monotoneOn_of_deriv_nonneg (convex_Ici 0)
          (by unfold sinhMaclaurinRem; fun_prop)
          (fun s _ => (hasDerivAt_sinhMaclaurinRem 0 s).differentiableAt.differentiableWithinAt)
          (fun s _ => by rw [(hasDerivAt_sinhMaclaurinRem 0 s).deriv]; exact hch_pos s)
      have h0 := hmono self_mem_Ici hu hu
      have hz : sinhMaclaurinRem 0 0 = 0 := by simp [sinhMaclaurinRem]
      linarith
    · simpa using hch_le hu0 hu1
    · let g : ℝ → ℝ := fun s => 2 * s - sinhMaclaurinRem 0 s
      have hg : ∀ s : ℝ, HasDerivAt g (2 - coshMaclaurinRem 0 s) s := fun s =>
        (((hasDerivAt_id' s).const_mul 2).sub (hasDerivAt_sinhMaclaurinRem 0 s)).congr_deriv (by ring)
      have hmono : MonotoneOn g (Icc 0 1) :=
        monotoneOn_of_deriv_nonneg (convex_Icc 0 1)
          (by dsimp [g, sinhMaclaurinRem]; fun_prop)
          (fun s _ => (hg s).differentiableAt.differentiableWithinAt)
          (fun s hs => by
            have hs' := interior_subset hs
            rw [(hg s).deriv]; linarith [hch_le hs'.1 hs'.2])
      have h0 := hmono ⟨le_rfl, zero_le_one⟩ ⟨hu0, hu1⟩ hu0
      have hz : g 0 = 0 := by simp [g, sinhMaclaurinRem]
      dsimp [g] at h0
      norm_num
      linarith
  | succ k ih =>
    have hcos_nn : ∀ {v : ℝ}, 0 ≤ v → 0 ≤ coshMaclaurinRem (k + 1) v := fun {v} hv => by
      have hmono : MonotoneOn (coshMaclaurinRem (k + 1)) (Ici 0) :=
        monotoneOn_of_deriv_nonneg (convex_Ici 0)
          (by unfold coshMaclaurinRem; fun_prop)
          (fun s _ => (hasDerivAt_coshMaclaurinRem_succ k s).differentiableAt.differentiableWithinAt)
          (fun s hs => by rw [(hasDerivAt_coshMaclaurinRem_succ k s).deriv]; exact (ih.1 (interior_subset hs)).2)
      have h0 := hmono self_mem_Ici hv hv
      have hz : coshMaclaurinRem (k + 1) 0 = 0 := by
        unfold coshMaclaurinRem
        rw [Finset.sum_range_succ', Finset.sum_eq_zero fun m _ => by
          simp [zero_pow (by omega : 2 * (m + 1) ≠ 0)]]
        simp
      linarith
    have hcos_ub : ∀ {v : ℝ}, 0 ≤ v → v ≤ 1 →
        coshMaclaurinRem (k + 1) v ≤ 2 * v ^ (2 * (k + 1)) / (2 * (k + 1)).factorial :=
      fun {v} hv0 hv1 => by
        let g : ℝ → ℝ := fun s =>
          2 * s ^ (2 * k + 2) / (2 * k + 2).factorial - coshMaclaurinRem (k + 1) s
        have hg : ∀ s : ℝ, HasDerivAt g
            (2 * s ^ (2 * k + 1) / (2 * k + 1).factorial - sinhMaclaurinRem k s) s := fun s => by
          have hd := (((hasDerivAt_pow (2 * k + 2) s).const_mul 2).div_const
            ((2 * k + 2).factorial : ℝ)).sub (hasDerivAt_coshMaclaurinRem_succ k s)
          refine hd.congr_deriv ?_
          have hfac : ((2 * k + 2).factorial : ℝ) = ((2 * k + 2 : ℕ) : ℝ) * (2 * k + 1).factorial := by
            rw [Nat.factorial_succ]; push_cast; ring
          have hpos : ((2 * k + 2 : ℕ) : ℝ) ≠ 0 := by positivity
          have hfac0 : ((2 * k + 1).factorial : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
          rw [hfac, show 2 * k + 2 - 1 = 2 * k + 1 by omega]
          field_simp
        have hmono : MonotoneOn g (Icc 0 1) :=
          monotoneOn_of_deriv_nonneg (convex_Icc 0 1)
            (by dsimp [g, coshMaclaurinRem]; fun_prop)
            (fun s _ => (hg s).differentiableAt.differentiableWithinAt)
            (fun s hs => by
              have hs' := interior_subset hs
              rw [(hg s).deriv]; linarith [(ih.2 hs'.1 hs'.2).2])
        have h0 := hmono ⟨le_rfl, zero_le_one⟩ ⟨hv0, hv1⟩ hv0
        have hz : g 0 = 0 := by
          dsimp [g, coshMaclaurinRem]
          rw [Finset.sum_range_succ', Finset.sum_eq_zero fun m _ => by
            simp [zero_pow (by omega : 2 * (m + 1) ≠ 0)], zero_pow (by omega : 2 * k + 2 ≠ 0)]
          simp
        dsimp [g] at h0
        rw [show 2 * (k + 1) = 2 * k + 2 by omega]
        linarith
    refine ⟨fun {u} hu => ⟨hcos_nn hu, ?_⟩, fun {u} hu0 hu1 => ⟨hcos_ub hu0 hu1, ?_⟩⟩
    · have hmono : MonotoneOn (sinhMaclaurinRem (k + 1)) (Ici 0) :=
        monotoneOn_of_deriv_nonneg (convex_Ici 0)
          (by unfold sinhMaclaurinRem; fun_prop)
          (fun s _ => (hasDerivAt_sinhMaclaurinRem (k + 1) s).differentiableAt.differentiableWithinAt)
          (fun s hs => by rw [(hasDerivAt_sinhMaclaurinRem (k + 1) s).deriv]; exact hcos_nn (interior_subset hs))
      have h0 := hmono self_mem_Ici hu hu
      have hz : sinhMaclaurinRem (k + 1) 0 = 0 := by
        unfold sinhMaclaurinRem
        rw [Finset.sum_eq_zero fun m _ => by simp [zero_pow (by omega : 2 * m + 1 ≠ 0)]]
        simp
      linarith
    · let g2 : ℝ → ℝ := fun s =>
        2 * s ^ (2 * k + 3) / (2 * k + 3).factorial - sinhMaclaurinRem (k + 1) s
      have hg2 : ∀ s : ℝ, HasDerivAt g2
          (2 * s ^ (2 * (k + 1)) / (2 * (k + 1)).factorial - coshMaclaurinRem (k + 1) s) s := fun s => by
        have hd := (((hasDerivAt_pow (2 * k + 3) s).const_mul 2).div_const
          ((2 * k + 3).factorial : ℝ)).sub (hasDerivAt_sinhMaclaurinRem (k + 1) s)
        refine hd.congr_deriv ?_
        have hfac : ((2 * k + 3).factorial : ℝ) = ((2 * k + 3 : ℕ) : ℝ) * (2 * (k + 1)).factorial := by
          rw [show 2 * k + 3 = 2 * (k + 1) + 1 by omega, Nat.factorial_succ]; push_cast; ring
        have hpos : ((2 * k + 3 : ℕ) : ℝ) ≠ 0 := by positivity
        have hfac0 : ((2 * (k + 1)).factorial : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
        rw [hfac, show 2 * k + 3 - 1 = 2 * (k + 1) by omega]
        field_simp
      have hmono2 : MonotoneOn g2 (Icc 0 1) :=
        monotoneOn_of_deriv_nonneg (convex_Icc 0 1)
          (by dsimp [g2, sinhMaclaurinRem]; fun_prop)
          (fun s _ => (hg2 s).differentiableAt.differentiableWithinAt)
          (fun s hs => by
            have hs' := interior_subset hs
            rw [(hg2 s).deriv]; linarith [hcos_ub hs'.1 hs'.2])
      have h0 := hmono2 ⟨le_rfl, zero_le_one⟩ ⟨hu0, hu1⟩ hu0
      have hz : g2 0 = 0 := by
        dsimp [g2, sinhMaclaurinRem]
        rw [Finset.sum_eq_zero fun m _ => by simp [zero_pow (by omega : 2 * m + 1 ≠ 0)],
          zero_pow (by omega : 2 * k + 3 ≠ 0)]
        simp
      dsimp [g2] at h0
      rw [show 2 * (k + 1) + 1 = 2 * k + 3 by omega]
      linarith

/-- The von Mangoldt weight with only the prime atom at `n = 2` sign-flipped (`w(2) = −log 2`,
`w(n) = Λ(n)` for `n ≠ 2`). -/
def flippedTwoVonMangoldt (n : ℕ) : ℝ :=
  if n = 2 then -Real.log 2 else (ArithmeticFunction.vonMangoldt n : ℝ)

theorem flippedTwoVonMangoldt_two : flippedTwoVonMangoldt 2 = -Real.log 2 := if_pos rfl

/-- Below `log 3`, `flippedTwoVonMangoldt` and `liouvilleTwistedVonMangoldt` have identical Weil
functionals because both equal `−log 2` at `n = 2`. -/
theorem weilFullFunctional_flippedTwo_eq_liouvilleTwist {k : ℝ → ℂ} {B : ℝ}
    (hk : tsupport k ⊆ Icc (-B) B) (hB : B < Real.log 3) :
    weilFullFunctional flippedTwoVonMangoldt k =
      weilFullFunctional liouvilleTwistedVonMangoldt k := by
  refine weilFullFunctional_eq_of_eqOn hk fun n hn hlog => ?_
  have hn2 : n = 2 := by
    by_contra hne
    have h3 : (3 : ℝ) ≤ n := by exact_mod_cast (show 3 ≤ n by omega)
    have := Real.log_le_log (by norm_num) h3
    linarith
  subst hn2
  rw [flippedTwoVonMangoldt_two, liouvilleTwistedVonMangoldt_two]

/-- Odd piecewise-linear clamp `(|x + a| − |x − a|) / 2`, equal to `max (−a) (min a x)` for `0 ≤ a`. -/
def oddClamp (a x : ℝ) : ℝ := (|x + a| - |x - a|) / 2

@[fun_prop]
theorem continuous_oddClamp (a : ℝ) : Continuous (oddClamp a) := by
  unfold oddClamp
  fun_prop

theorem oddClamp_neg (a x : ℝ) : oddClamp a (-x) = -oddClamp a x := by
  unfold oddClamp
  rw [show -x + a = -(x - a) by ring, show -x - a = -(x + a) by ring, abs_neg, abs_neg]
  ring

theorem oddClamp_of_ge {a x : ℝ} (ha : 0 ≤ a) (hx : a ≤ x) : oddClamp a x = a := by
  unfold oddClamp
  rw [abs_of_nonneg (by linarith), abs_of_nonneg (by linarith)]
  ring

theorem oddClamp_of_le_neg {a x : ℝ} (ha : 0 ≤ a) (hx : x ≤ -a) : oddClamp a x = -a := by
  unfold oddClamp
  rw [abs_of_nonpos (by linarith), abs_of_nonpos (by linarith)]
  ring

theorem oddClamp_of_abs_le {a x : ℝ} (hx : |x| ≤ a) : oddClamp a x = x := by
  have hx' := abs_le.mp hx
  unfold oddClamp
  rw [abs_of_nonneg (by linarith), abs_of_nonpos (by linarith)]
  ring

theorem abs_oddClamp_le {a : ℝ} (ha : 0 ≤ a) (x : ℝ) : |oddClamp a x| ≤ a := by
  rcases le_total a x with hx | hx
  · rw [oddClamp_of_ge ha hx, abs_of_nonneg ha]
  · rcases le_total x (-a) with hx2 | hx2
    · rw [oddClamp_of_le_neg ha hx2, abs_neg, abs_of_nonneg ha]
    · rw [oddClamp_of_abs_le (abs_le.mpr ⟨hx2, hx⟩)]
      exact abs_le.mpr ⟨hx2, hx⟩

theorem abs_oddClamp_sub_le (a u v : ℝ) : |oddClamp a u - oddClamp a v| ≤ |u - v| := by
  unfold oddClamp
  have h1 := abs_abs_sub_abs_le_abs_sub (u + a) (v + a)
  have h2 := abs_abs_sub_abs_le_abs_sub (u - a) (v - a)
  rw [show (u + a) - (v + a) = u - v by ring] at h1
  rw [show (u - a) - (v - a) = u - v by ring] at h2
  have htri : |(|u + a| - |u - a|) - (|v + a| - |v - a|)| ≤
      |(|u + a| - |v + a|)| + |(|u - a| - |v - a|)| := by
    simpa [Real.norm_eq_abs, show (|u + a| - |u - a|) - (|v + a| - |v - a|) =
      (|u + a| - |v + a|) - (|u - a| - |v - a|) by ring] using
      norm_sub_le (|u + a| - |v + a|) (|u - a| - |v - a|)
  rw [show (|u + a| - |u - a|) / 2 - (|v + a| - |v - a|) / 2 =
    ((|u + a| - |u - a|) - (|v + a| - |v - a|)) / 2 by ring, abs_div]
  norm_num
  linarith

/-- Closed-form integral of `|u − α| |u − β|` on `[−B, B]` when `α, β ∈ [−B, B]`. -/
theorem integral_abs_sub_mul_abs_sub {α β B : ℝ}
    (hα1 : -B ≤ α) (hα2 : α ≤ B) (hβ1 : -B ≤ β) (hβ2 : β ≤ B) :
    (∫ u in (-B)..B, |u - α| * |u - β|) =
      2 / 3 * B ^ 3 + 2 * α * β * B + |α - β| ^ 3 / 3 := by
  wlog hle : α ≤ β generalizing α β
  · have hsym := this hβ1 hβ2 hα1 hα2 (le_of_not_ge hle)
    have hcongr : (∫ u in (-B)..B, |u - α| * |u - β|) = ∫ u in (-B)..B, |u - β| * |u - α| :=
      intervalIntegral.integral_congr fun u _ => mul_comm _ _
    rw [hcongr, hsym, abs_sub_comm]
    ring
  have hcont : Continuous fun u : ℝ => |u - α| * |u - β| := by fun_prop
  have hs1 := intervalIntegral.integral_add_adjacent_intervals
    (hcont.intervalIntegrable (μ := volume) (-B) α) (hcont.intervalIntegrable (μ := volume) α B)
  have hs2 := intervalIntegral.integral_add_adjacent_intervals
    (hcont.intervalIntegrable (μ := volume) α β) (hcont.intervalIntegrable (μ := volume) β B)
  rw [← hs1, ← hs2]
  let Q : ℝ → ℝ := fun u => u ^ 3 / 3 - (α + β) * u ^ 2 / 2 + α * β * u
  have hQ : ∀ u : ℝ, HasDerivAt Q ((u - α) * (u - β)) u := fun u => by
    have hd := (((hasDerivAt_pow 3 u).div_const 3).sub
      (((hasDerivAt_pow 2 u).const_mul (α + β)).div_const 2)).add
      ((hasDerivAt_id' u).const_mul (α * β))
    exact (hd.congr_of_eventuallyEq (Eventually.of_forall fun _ => rfl)).congr_deriv
      (by push_cast; ring)
  have hQneg : ∀ u : ℝ, HasDerivAt (fun x => -Q x) (-((u - α) * (u - β))) u :=
    fun u => (hQ u).neg
  have hi1 : (∫ u in (-B)..α, |u - α| * |u - β|) = Q α - Q (-B) := by
    rw [intervalIntegral.integral_congr fun u hu => by
      have hu' : u ≤ α := (Set.uIcc_of_le hα1 ▸ hu).2
      change |u - α| * |u - β| = (u - α) * (u - β)
      rw [abs_of_nonpos (by linarith), abs_of_nonpos (by linarith)]; ring]
    exact intervalIntegral.integral_eq_sub_of_hasDerivAt (fun x _ => hQ x)
      ((by fun_prop : Continuous fun u => (u - α) * (u - β)).intervalIntegrable _ _)
  have hi2 : (∫ u in α..β, |u - α| * |u - β|) = -Q β - -Q α := by
    rw [intervalIntegral.integral_congr fun u hu => by
      have hu' := Set.uIcc_of_le hle ▸ hu
      change |u - α| * |u - β| = -((u - α) * (u - β))
      rw [abs_of_nonneg (by linarith [hu'.1]), abs_of_nonpos (by linarith [hu'.2])]; ring]
    exact intervalIntegral.integral_eq_sub_of_hasDerivAt (fun x _ => hQneg x)
      ((by fun_prop : Continuous fun u => -((u - α) * (u - β))).intervalIntegrable _ _)
  have hi3 : (∫ u in β..B, |u - α| * |u - β|) = Q B - Q β := by
    rw [intervalIntegral.integral_congr fun u hu => by
      have hu' : β ≤ u := (Set.uIcc_of_le hβ2 ▸ hu).1
      change |u - α| * |u - β| = (u - α) * (u - β)
      rw [abs_of_nonneg (by linarith), abs_of_nonneg (by linarith)]]
    exact intervalIntegral.integral_eq_sub_of_hasDerivAt (fun x _ => hQ x)
      ((by fun_prop : Continuous fun u => (u - α) * (u - β)).intervalIntegrable _ _)
  rw [hi1, hi2, hi3, abs_of_nonpos (by linarith : α - β ≤ 0)]
  dsimp [Q]
  ring

private theorem integral_oddClamp_mul_shift {a b t B : ℝ}
    (ha0 : 0 ≤ a) (haR : a ≤ B) (hb0 : 0 ≤ b) (hbB : |t| + b ≤ B) :
    (∫ u in (-B)..B, oddClamp a u * oddClamp b (u + t)) =
      2 * a * b * B -
        1 / 12 * (|t + a + b| ^ 3 + |t - a - b| ^ 3 -
          |t + a - b| ^ 3 - |t - a + b| ^ 3) := by
  have ht : -B + b ≤ t ∧ t ≤ B - b := by
    have := abs_le.mp (show |t| ≤ B - b by linarith)
    exact ⟨by linarith [this.1], this.2⟩
  have hexp : ∀ u : ℝ, oddClamp a u * oddClamp b (u + t) =
      1 / 4 * ((|u - -a| * |u - (-t - b)| - |u - -a| * |u - (-t + b)|) -
        (|u - a| * |u - (-t - b)| - |u - a| * |u - (-t + b)|)) := fun u => by
    unfold oddClamp
    rw [show u - -a = u + a by ring, show u - (-t - b) = u + t + b by ring,
      show u - (-t + b) = u + t - b by ring]
    ring
  simp_rw [hexp]
  have hint (α β : ℝ) : IntervalIntegrable (fun u => |u - α| * |u - β|) volume (-B) B :=
    (by fun_prop : Continuous fun u => |u - α| * |u - β|).intervalIntegrable _ _
  rw [intervalIntegral.integral_const_mul,
    intervalIntegral.integral_sub ((hint _ _).sub (hint _ _)) ((hint _ _).sub (hint _ _)),
    intervalIntegral.integral_sub (hint _ _) (hint _ _),
    intervalIntegral.integral_sub (hint _ _) (hint _ _),
    integral_abs_sub_mul_abs_sub (by linarith) (by linarith) (by linarith) (by linarith),
    integral_abs_sub_mul_abs_sub (by linarith) (by linarith) (by linarith) (by linarith),
    integral_abs_sub_mul_abs_sub (by linarith) (by linarith) (by linarith) (by linarith),
    integral_abs_sub_mul_abs_sub (by linarith) (by linarith) (by linarith) (by linarith)]
  have e1 : |-a - (-t - b)| = |t - a + b| := by congr 1; ring
  have e2 : |-a - (-t + b)| = |t - a - b| := by congr 1; ring
  have e3 : |a - (-t - b)| = |t + a + b| := by congr 1; ring
  have e4 : |a - (-t + b)| = |t + a - b| := by congr 1; ring
  rw [e1, e2, e3, e4]
  ring

/-- Universal cubic autocorrelation formula for any compactly balanced odd clamp combination
`f(x) = ∑ c_j oddClamp(a_j, x)` (`∑ c_j a_j = 0`). -/
theorem autocorr_oddClampCombo_eq {N : ℕ} (a c : Fin N → ℝ) {R : ℝ} (hR : 0 ≤ R)
    (ha : ∀ j, 0 ≤ a j ∧ a j ≤ R) (hbal : ∑ j, c j * a j = 0)
    {t : ℝ} (ht : |t| ≤ 2 * R) :
    acorr (fun x => ∑ j, c j * oddClamp (a j) x) t =
      -∑ j, ∑ k, c j * c k / 12 *
        (|t + a j + a k| ^ 3 + |t - a j - a k| ^ 3 -
          |t + a j - a k| ^ 3 - |t - a j + a k| ^ 3) := by
  let f : ℝ → ℝ := fun x => ∑ j, c j * oddClamp (a j) x
  have hf_supp : ∀ x, R < |x| → f x = 0 := fun x hx => by
    dsimp [f]
    rcases lt_or_gt_of_ne (by intro h; rw [h, abs_zero] at hx; linarith : x ≠ 0) with hneg | hpos
    · rw [abs_of_neg hneg] at hx
      have hle : ∀ j, oddClamp (a j) x = -a j := fun j =>
        oddClamp_of_le_neg (ha j).1 (by linarith [(ha j).2])
      simp_rw [hle, mul_neg, Finset.sum_neg_distrib, hbal, neg_zero]
    · rw [abs_of_pos hpos] at hx
      have hge : ∀ j, oddClamp (a j) x = a j := fun j =>
        oddClamp_of_ge (ha j).1 (by linarith [(ha j).2])
      simp_rw [hge]
      exact hbal
  have hf_cont : Continuous f := by dsimp [f]; fun_prop
  set B : ℝ := 3 * R + 1
  have hvan : ∀ u, u ∉ Ioc (-B) B → f u * f (u + t) = 0 := fun u hu => by
    have hRlt : R < |u| := by
      by_contra hle
      push Not at hle
      have hu' := abs_le.mp hle
      dsimp [B] at hu
      exact hu ⟨by linarith [hu'.1], by linarith [hu'.2]⟩
    rw [hf_supp u hRlt, zero_mul]
  change (∫ u, f u * f (u + t)) = _
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero hvan,
    ← intervalIntegral.integral_of_le (by dsimp [B]; linarith : -B ≤ B)]
  have hexp : ∀ u : ℝ, f u * f (u + t) =
      ∑ j, ∑ k, c j * c k * (oddClamp (a j) u * oddClamp (a k) (u + t)) := fun u => by
    dsimp [f]
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun k _ => by ring
  simp_rw [hexp]
  rw [intervalIntegral.integral_finsetSum fun j _ =>
    (by fun_prop : Continuous fun u =>
      ∑ k, c j * c k * (oddClamp (a j) u * oddClamp (a k) (u + t))).intervalIntegrable _ _]
  have hinner : ∀ j : Fin N,
      (∫ u in (-B)..B, ∑ k, c j * c k * (oddClamp (a j) u * oddClamp (a k) (u + t))) =
      ∑ k, c j * c k * (2 * a j * a k * B -
        1 / 12 * (|t + a j + a k| ^ 3 + |t - a j - a k| ^ 3 -
          |t + a j - a k| ^ 3 - |t - a j + a k| ^ 3)) := fun j => by
    rw [intervalIntegral.integral_finsetSum fun k _ =>
      (by fun_prop : Continuous fun u =>
        c j * c k * (oddClamp (a j) u * oddClamp (a k) (u + t))).intervalIntegrable _ _]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [intervalIntegral.integral_const_mul,
      integral_oddClamp_mul_shift (ha j).1 (by dsimp [B]; linarith [(ha j).2])
        (ha k).1 (by dsimp [B]; linarith [(ha k).2])]
  simp_rw [hinner]
  have hbal_sq : (∑ j, ∑ k, c j * c k * (2 * a j * a k * B)) = 0 := by
    have : (∑ j, ∑ k, c j * c k * (2 * a j * a k * B)) =
        (∑ j, c j * a j) * ∑ k, 2 * B * (c k * a k) := by
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl fun k _ => by ring
    rw [this, hbal, zero_mul]
  calc (∑ j, ∑ k, c j * c k * (2 * a j * a k * B -
        1 / 12 * (|t + a j + a k| ^ 3 + |t - a j - a k| ^ 3 -
          |t + a j - a k| ^ 3 - |t - a j + a k| ^ 3)))
      = (∑ j, ∑ k, c j * c k * (2 * a j * a k * B)) -
          ∑ j, ∑ k, c j * c k / 12 *
            (|t + a j + a k| ^ 3 + |t - a j - a k| ^ 3 -
              |t + a j - a k| ^ 3 - |t - a j + a k| ^ 3) := by
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [← Finset.sum_sub_distrib]
        exact Finset.sum_congr rfl fun k _ => by ring
    _ = _ := by rw [hbal_sq, zero_sub]

/-- Global upper envelope `archLevySinhWeight x ≤ 1/x + 1/2 − x/24 − x²/16 + x³/576 + x⁴/128`
for all `x > 0`, obtained from `e^{x/2}/sinh x = 1/(2 sinh(x/2)) + 1/(2 cosh(x/2))`. -/
theorem archLevySinhWeight_le_quartic {x : ℝ} (hx : 0 < x) :
    archLevySinhWeight x ≤
      1 / x + 1 / 2 - x / 24 - x ^ 2 / 16 + x ^ 3 / 576 + x ^ 4 / 128 := by
  unfold archLevySinhWeight
  set u : ℝ := x / 2
  have hu : 0 < u := half_pos hx
  have hsh_pos : 0 < Real.sinh u := Real.sinh_pos_iff.mpr hu
  have hch_pos : 0 < Real.cosh u := Real.cosh_pos u
  have hsplit : Real.exp (x / 2) / Real.sinh x = 1 / (2 * Real.sinh u) + 1 / (2 * Real.cosh u) := by
    have h2u : x = 2 * u := by dsimp [u]; ring
    rw [show x / 2 = u from rfl, h2u, Real.sinh_two_mul, ← Real.cosh_add_sinh u]
    field_simp [hsh_pos.ne', hch_pos.ne']
  rw [hsplit]
  have hm2 := (cosh_sinh_maclaurin_rem_bounds 2).1 hu.le
  unfold coshMaclaurinRem sinhMaclaurinRem at hm2
  simp only [Finset.sum_range_succ, Finset.sum_range_zero] at hm2
  norm_num at hm2
  have h2sh_sharp : x + x ^ 3 / 24 ≤ 2 * Real.sinh u := by
    dsimp [u] at hm2 ⊢
    linarith [hm2.2]
  have h2ch_sharp : 2 + x ^ 2 / 4 ≤ 2 * Real.cosh u := by
    dsimp [u] at hm2 ⊢
    linarith [hm2.1]
  have hb1 : 1 / (2 * Real.sinh u) ≤ 1 / x - x / 24 + x ^ 3 / 576 := by
    refine (one_div_le_one_div_of_le (by positivity) h2sh_sharp).trans ?_
    rw [div_le_iff₀ (by positivity)]
    have : (1 / x - x / 24 + x ^ 3 / 576) * (x + x ^ 3 / 24) = 1 + x ^ 6 / 13824 := by
      field_simp [hx.ne']
      ring
    linarith [show 0 ≤ x ^ 6 / 13824 by positivity]
  have hb2 : 1 / (2 * Real.cosh u) ≤ 1 / 2 - x ^ 2 / 16 + x ^ 4 / 128 := by
    refine (one_div_le_one_div_of_le (by positivity) h2ch_sharp).trans ?_
    rw [div_le_iff₀ (by positivity)]
    have : (1 / 2 - x ^ 2 / 16 + x ^ 4 / 128) * (2 + x ^ 2 / 4) = 1 + x ^ 6 / 512 := by ring
    linarith [show 0 ≤ x ^ 6 / 512 by positivity]
  linarith

/-- Quarter-turn `arctan` upper bound `arctan u ≤ π/4 − (v − v³/3 + v⁵/5 − v⁷/7)` for `0 ≤ u < 1`
with `v = (1 − u)/(1 + u)`. -/
theorem arctan_le_pi_div_four_sub {u : ℝ} (hu0 : 0 ≤ u) (hu1 : u < 1) :
    Real.arctan u ≤ Real.pi / 4 -
      (((1 - u) / (1 + u)) - ((1 - u) / (1 + u)) ^ 3 / 3 +
        ((1 - u) / (1 + u)) ^ 5 / 5 - ((1 - u) / (1 + u)) ^ 7 / 7) := by
  have hsum_eq : Real.arctan u + Real.arctan ((1 - u) / (1 + u)) = Real.pi / 4 := by
    let F : ℝ → ℝ := fun t => Real.arctan t + Real.arctan ((1 - t) / (1 + t))
    have hderiv : ∀ t ∈ Ici (0 : ℝ), HasDerivAt F 0 t := fun t ht => by
      have ht1 : (1 : ℝ) + t ≠ 0 := by linarith [mem_Ici.mp ht]
      have hq : HasDerivAt (fun s => (1 - s) / (1 + s))
          (((0 - 1) * (1 + t) - (1 - t) * (0 + 1)) / (1 + t) ^ 2) t :=
        ((hasDerivAt_const t (1 : ℝ)).sub (hasDerivAt_id' t)).div
          ((hasDerivAt_const t (1 : ℝ)).add (hasDerivAt_id' t)) ht1
      have hd := (Real.hasDerivAt_arctan t).add hq.arctan
      refine hd.congr_deriv ?_
      field_simp [ht1]
      ring
    have hcontF : ContinuousOn F (Ici 0) := by
      dsimp [F]
      refine ContinuousOn.add Real.continuous_arctan.continuousOn
        (Real.continuous_arctan.comp_continuousOn ?_)
      exact ContinuousOn.div (by fun_prop) (by fun_prop) fun s hs => by linarith [mem_Ici.mp hs]
    have hconst : ∀ t ∈ Ici (0 : ℝ), F t = F 0 := fun t ht => by
      have hle := monotoneOn_of_deriv_nonneg (convex_Ici 0) hcontF
        (fun s hs => (hderiv s (interior_subset hs)).differentiableAt.differentiableWithinAt)
        (fun s hs => by rw [(hderiv s (interior_subset hs)).deriv])
      have hge := antitoneOn_of_deriv_nonpos (convex_Ici 0) hcontF
        (fun s hs => (hderiv s (interior_subset hs)).differentiableAt.differentiableWithinAt)
        (fun s hs => by rw [(hderiv s (interior_subset hs)).deriv])
      exact le_antisymm (hge self_mem_Ici ht ht) (hle self_mem_Ici ht ht)
    have h0 := hconst u hu0
    dsimp [F] at h0
    simpa [Real.arctan_zero, Real.arctan_one] using h0
  set v : ℝ := (1 - u) / (1 + u)
  have hv0 : 0 ≤ v := div_nonneg (by linarith) (by linarith)
  let G : ℝ → ℝ := fun s => Real.arctan s - (s - s ^ 3 / 3 + s ^ 5 / 5 - s ^ 7 / 7)
  have hG_deriv : ∀ s : ℝ, HasDerivAt G (s ^ 8 / (1 + s ^ 2)) s := fun s => by
    have hd := (Real.hasDerivAt_arctan s).sub
      ((((hasDerivAt_id' s).sub ((hasDerivAt_pow 3 s).div_const 3)).add
        ((hasDerivAt_pow 5 s).div_const 5)).sub ((hasDerivAt_pow 7 s).div_const 7))
    refine hd.congr_deriv ?_
    have : (1 : ℝ) + s ^ 2 ≠ 0 := by positivity
    field_simp
    ring
  have hmonoG : MonotoneOn G (Ici 0) :=
    monotoneOn_of_deriv_nonneg (convex_Ici 0)
      (by dsimp [G]; fun_prop)
      (fun s _ => (hG_deriv s).differentiableAt.differentiableWithinAt)
      (fun s _ => by rw [(hG_deriv s).deriv]; positivity)
  have hGv := hmonoG self_mem_Ici hv0 hv0
  dsimp [G] at hGv
  rw [Real.arctan_zero] at hGv
  linarith

/-- Odd monomial moment of a balanced odd clamp combination on `[0, R]`. -/
theorem integral_oddClampCombo_mul_odd_pow {N : ℕ} (a c : Fin N → ℝ) {R : ℝ}
    (ha : ∀ j, 0 ≤ a j ∧ a j ≤ R) (hbal : ∑ j, c j * a j = 0) (p : ℕ) :
    (∫ x in (0 : ℝ)..R, (∑ j, c j * oddClamp (a j) x) * x ^ (2 * p + 1)) =
      -∑ j, c j * a j ^ (2 * p + 3) / (((2 * p + 2 : ℕ) : ℝ) * ((2 * p + 3 : ℕ) : ℝ)) := by
  have hexp : ∀ x : ℝ, (∑ j, c j * oddClamp (a j) x) * x ^ (2 * p + 1) =
      ∑ j, c j * (oddClamp (a j) x * x ^ (2 * p + 1)) := fun x => by
    rw [Finset.sum_mul]
    exact Finset.sum_congr rfl fun j _ => by ring
  simp_rw [hexp]
  rw [intervalIntegral.integral_finsetSum fun j _ =>
    (by fun_prop : Continuous fun x => c j * (oddClamp (a j) x * x ^ (2 * p + 1))).intervalIntegrable _ _]
  simp_rw [intervalIntegral.integral_const_mul]
  have hsingle : ∀ j, (∫ x in (0 : ℝ)..R, oddClamp (a j) x * x ^ (2 * p + 1)) =
      a j * R ^ (2 * p + 2) / ((2 * p + 2 : ℕ) : ℝ) -
        a j ^ (2 * p + 3) / (((2 * p + 2 : ℕ) : ℝ) * ((2 * p + 3 : ℕ) : ℝ)) := fun j => by
    have hcont : Continuous fun x : ℝ => oddClamp (a j) x * x ^ (2 * p + 1) := by fun_prop
    rw [← intervalIntegral.integral_add_adjacent_intervals
      (hcont.intervalIntegrable 0 (a j)) (hcont.intervalIntegrable (a j) R)]
    have hi1 : (∫ x in (0 : ℝ)..a j, oddClamp (a j) x * x ^ (2 * p + 1)) =
        a j ^ (2 * p + 3) / ((2 * p + 3 : ℕ) : ℝ) := by
      rw [intervalIntegral.integral_congr fun x hx => by
        have hx' := mem_Icc.mp (Set.uIcc_of_le (ha j).1 ▸ hx)
        change oddClamp (a j) x * x ^ (2 * p + 1) = x ^ (2 * p + 2)
        rw [oddClamp_of_abs_le (abs_le.mpr ⟨by linarith [hx'.1], hx'.2⟩), mul_comm, ← pow_succ]
      rw [integral_pow]
      simp only [zero_pow (by omega : 2 * p + 2 + 1 ≠ 0), sub_zero]
      push_cast
      ring
    have hi2 : (∫ x in a j..R, oddClamp (a j) x * x ^ (2 * p + 1)) =
        a j * (R ^ (2 * p + 2) - a j ^ (2 * p + 2)) / ((2 * p + 2 : ℕ) : ℝ) := by
      rw [intervalIntegral.integral_congr fun x hx => by
        have hx' := mem_Icc.mp (Set.uIcc_of_le (ha j).2 ▸ hx)
        change oddClamp (a j) x * x ^ (2 * p + 1) = a j * x ^ (2 * p + 1)
        rw [oddClamp_of_ge (ha j).1 hx'.1]]
      rw [intervalIntegral.integral_const_mul, integral_pow]
      push_cast
      ring
    rw [hi1, hi2]
    have h1 : ((2 * p + 2 : ℕ) : ℝ) ≠ 0 := by positivity
    have h2 : ((2 * p + 3 : ℕ) : ℝ) ≠ 0 := by positivity
    have hpow : a j * a j ^ (2 * p + 2) = a j ^ (2 * p + 3) := by rw [mul_comm, ← pow_succ]
    field_simp
    push_cast
    linear_combination -(2 * (p : ℝ) + 3) * hpow
  simp_rw [hsingle]
  have hbalR : (∑ j, c j * (a j * R ^ (2 * p + 2) / ((2 * p + 2 : ℕ) : ℝ))) = 0 := by
    have : (∑ j, c j * (a j * R ^ (2 * p + 2) / ((2 * p + 2 : ℕ) : ℝ))) =
        (R ^ (2 * p + 2) / ((2 * p + 2 : ℕ) : ℝ)) * ∑ j, c j * a j := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl fun j _ => by ring
    rw [this, hbal, mul_zero]
  calc (∑ j, c j * (a j * R ^ (2 * p + 2) / ((2 * p + 2 : ℕ) : ℝ) -
        a j ^ (2 * p + 3) / (((2 * p + 2 : ℕ) : ℝ) * ((2 * p + 3 : ℕ) : ℝ))))
      = (∑ j, c j * (a j * R ^ (2 * p + 2) / ((2 * p + 2 : ℕ) : ℝ))) -
          ∑ j, c j * a j ^ (2 * p + 3) / (((2 * p + 2 : ℕ) : ℝ) * ((2 * p + 3 : ℕ) : ℝ)) := by
        rw [← Finset.sum_sub_distrib]
        exact Finset.sum_congr rfl fun j _ => by ring
    _ = _ := by rw [hbalR, zero_sub]

/-! ## Section 3: Trigonometric Maclaurin, Digamma Telescoping, Envelope Builders, Legendre, and `LDLᵀ` -/

/-- Partial Maclaurin remainders of `cos` and `sin`. -/
def cosMaclaurinRem (k : ℕ) (u : ℝ) : ℝ :=
  Real.cos u - ∑ m ∈ Finset.range k, (-1 : ℝ) ^ m * u ^ (2 * m) / (2 * m).factorial

def sinMaclaurinRem (k : ℕ) (u : ℝ) : ℝ :=
  Real.sin u - ∑ m ∈ Finset.range k, (-1 : ℝ) ^ m * u ^ (2 * m + 1) / (2 * m + 1).factorial

private theorem hasDerivAt_sinMaclaurinRem (k : ℕ) (u : ℝ) :
    HasDerivAt (sinMaclaurinRem k) (cosMaclaurinRem k u) u := by
  unfold sinMaclaurinRem cosMaclaurinRem
  have hsum : HasDerivAt
      (fun x : ℝ => ∑ m ∈ Finset.range k, (-1 : ℝ) ^ m * x ^ (2 * m + 1) / (2 * m + 1).factorial)
      (∑ m ∈ Finset.range k, (-1 : ℝ) ^ m * u ^ (2 * m) / (2 * m).factorial) u := by
    have hd := HasDerivAt.fun_sum fun m (_ : m ∈ Finset.range k) =>
      (((hasDerivAt_pow (2 * m + 1) u).const_mul ((-1 : ℝ) ^ m)).div_const
        ((2 * m + 1).factorial : ℝ))
    refine hd.congr_deriv (Finset.sum_congr rfl fun m _ => ?_)
    have hfac : ((2 * m + 1).factorial : ℝ) = ((2 * m + 1 : ℕ) : ℝ) * (2 * m).factorial := by
      rw [Nat.factorial_succ]; push_cast; ring
    have hpos : ((2 * m + 1 : ℕ) : ℝ) ≠ 0 := by positivity
    have hfac0 : ((2 * m).factorial : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
    rw [hfac, show 2 * m + 1 - 1 = 2 * m by omega]
    field_simp
  exact (Real.hasDerivAt_sin u).sub hsum

private theorem hasDerivAt_cosMaclaurinRem_succ (k : ℕ) (u : ℝ) :
    HasDerivAt (cosMaclaurinRem (k + 1)) (-sinMaclaurinRem k u) u := by
  have hsplit : ∀ x : ℝ, cosMaclaurinRem (k + 1) x =
      (Real.cos x - 1) -
        ∑ m ∈ Finset.range k, (-1 : ℝ) ^ (m + 1) * x ^ (2 * (m + 1)) / (2 * (m + 1)).factorial :=
    fun x => by
      unfold cosMaclaurinRem
      rw [Finset.sum_range_succ']
      simp [Nat.factorial]
      ring
  have hsum : HasDerivAt
      (fun x : ℝ =>
        ∑ m ∈ Finset.range k, (-1 : ℝ) ^ (m + 1) * x ^ (2 * (m + 1)) / (2 * (m + 1)).factorial)
      (-(∑ m ∈ Finset.range k, (-1 : ℝ) ^ m * u ^ (2 * m + 1) / (2 * m + 1).factorial)) u := by
    have hd := HasDerivAt.fun_sum fun m (_ : m ∈ Finset.range k) =>
      (((hasDerivAt_pow (2 * (m + 1)) u).const_mul ((-1 : ℝ) ^ (m + 1))).div_const
        ((2 * (m + 1)).factorial : ℝ))
    refine hd.congr_deriv ?_
    rw [← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun m _ => ?_
    have h2m : 2 * (m + 1) = (2 * m + 1) + 1 := by omega
    rw [h2m, Nat.factorial_succ, show (2 * m + 1) + 1 - 1 = 2 * m + 1 by omega, pow_succ (-1 : ℝ)]
    push_cast
    have hpos : ((2 * m + 1 + 1 : ℕ) : ℝ) ≠ 0 := by positivity
    have hfac0 : ((2 * m + 1).factorial : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
    field_simp
  have hd := (((Real.hasDerivAt_cos u).sub (hasDerivAt_const u (1 : ℝ))).sub hsum).congr_of_eventuallyEq
    (Eventually.of_forall hsplit)
  refine hd.congr_deriv ?_
  unfold sinMaclaurinRem
  ring

/-- Alternating Maclaurin sign law for `cos` and `sin` on `[0, ∞)` (`k ≥ 1`). -/
theorem alternating_sincos_rem_nonneg (k : ℕ) :
    ∀ {u : ℝ}, 0 ≤ u →
      0 ≤ (-1 : ℝ) ^ (k + 1) * cosMaclaurinRem (k + 1) u ∧
        0 ≤ (-1 : ℝ) ^ (k + 1) * sinMaclaurinRem (k + 1) u := by
  induction k with
  | zero =>
    intro u hu
    have hcos : ∀ s : ℝ, 0 ≤ (-1 : ℝ) ^ 1 * cosMaclaurinRem 1 s := fun s => by
      unfold cosMaclaurinRem
      simp only [Finset.sum_range_one, pow_zero, mul_zero, Nat.factorial_zero, Nat.cast_one,
        div_one, mul_one, pow_one]
      linarith [Real.cos_le_one s]
    refine ⟨hcos u, ?_⟩
    let g : ℝ → ℝ := fun s => (-1 : ℝ) ^ 1 * sinMaclaurinRem 1 s
    have hg : ∀ s : ℝ, HasDerivAt g ((-1 : ℝ) ^ 1 * cosMaclaurinRem 1 s) s :=
      fun s => (hasDerivAt_sinMaclaurinRem 1 s).const_mul _
    have hmono : MonotoneOn g (Ici 0) :=
      monotoneOn_of_deriv_nonneg (convex_Ici 0)
        (by dsimp [g, sinMaclaurinRem]; fun_prop)
        (fun s _ => (hg s).differentiableAt.differentiableWithinAt)
        (fun s _ => by rw [(hg s).deriv]; exact hcos s)
    have h0 := hmono self_mem_Ici hu hu
    have hg0 : g 0 = 0 := by simp [g, sinMaclaurinRem]
    exact hg0 ▸ h0
  | succ k ih =>
    intro u hu
    have hcos_all : ∀ {v : ℝ}, 0 ≤ v →
        0 ≤ (-1 : ℝ) ^ (k + 2) * cosMaclaurinRem (k + 2) v := by
      intro v hv
      let g : ℝ → ℝ := fun s => (-1 : ℝ) ^ (k + 2) * cosMaclaurinRem (k + 2) s
      have hg : ∀ s : ℝ, HasDerivAt g ((-1 : ℝ) ^ (k + 1) * sinMaclaurinRem (k + 1) s) s :=
        fun s => ((hasDerivAt_cosMaclaurinRem_succ (k + 1) s).const_mul _).congr_deriv
          (by rw [pow_succ (-1 : ℝ) (k + 1)]; ring)
      have hmono : MonotoneOn g (Ici 0) :=
        monotoneOn_of_deriv_nonneg (convex_Ici 0)
          (by dsimp [g, cosMaclaurinRem]; fun_prop)
          (fun s _ => (hg s).differentiableAt.differentiableWithinAt)
          (fun s hs => by rw [(hg s).deriv]; exact (ih (interior_subset hs)).2)
      have h0 := hmono self_mem_Ici hv hv
      have hg0 : g 0 = 0 := by
        dsimp [g, cosMaclaurinRem]
        rw [Finset.sum_range_succ', Finset.sum_eq_zero fun m _ => by
          simp [zero_pow (by omega : 2 * (m + 1) ≠ 0)]]
        simp
      dsimp [g] at h0 hg0
      linarith
    refine ⟨hcos_all hu, ?_⟩
    let g2 : ℝ → ℝ := fun s => (-1 : ℝ) ^ (k + 2) * sinMaclaurinRem (k + 2) s
    have hg2 : ∀ s : ℝ, HasDerivAt g2 ((-1 : ℝ) ^ (k + 2) * cosMaclaurinRem (k + 2) s) s :=
      fun s => (hasDerivAt_sinMaclaurinRem (k + 2) s).const_mul _
    have hmono2 : MonotoneOn g2 (Ici 0) :=
      monotoneOn_of_deriv_nonneg (convex_Ici 0)
        (by dsimp [g2, sinMaclaurinRem]; fun_prop)
        (fun s _ => (hg2 s).differentiableAt.differentiableWithinAt)
        (fun s hs => by rw [(hg2 s).deriv]; exact hcos_all (interior_subset hs))
    have h0 := hmono2 self_mem_Ici hu hu
    have hg20 : g2 0 = 0 := by
      dsimp [g2, sinMaclaurinRem]
      rw [Finset.sum_eq_zero fun m _ => by simp [zero_pow (by omega : 2 * m + 1 ≠ 0)]]
      simp
    dsimp [g2] at h0 hg20
    linarith

/-- Global degree-`2*K` cosine Taylor bound `|cos u − ∑_{m ≤ K} (−1)^m u^{2m}/(2m)!| ≤ |u|^{2K+2}/(2K+2)!`. -/
theorem abs_cos_sub_maclaurin_le (K : ℕ) (u : ℝ) :
    |Real.cos u - ∑ m ∈ Finset.range (K + 1), (-1 : ℝ) ^ m * u ^ (2 * m) / (2 * m).factorial| ≤
      |u| ^ (2 * K + 2) / (2 * K + 2).factorial := by
  have heven : cosMaclaurinRem (K + 1) u = cosMaclaurinRem (K + 1) (|u|) := by
    unfold cosMaclaurinRem
    rw [Real.cos_abs]
    congr 1
    refine Finset.sum_congr rfl fun m _ => ?_
    rw [pow_mul, pow_mul, sq_abs]
  change |cosMaclaurinRem (K + 1) u| ≤ _
  rw [heven]
  set v : ℝ := |u|
  have hv : 0 ≤ v := abs_nonneg u
  have h1 := (alternating_sincos_rem_nonneg K hv).1
  have h2 := (alternating_sincos_rem_nonneg (K + 1) hv).1
  have hstep : cosMaclaurinRem (K + 2) v =
      cosMaclaurinRem (K + 1) v - (-1 : ℝ) ^ (K + 1) * (v ^ (2 * K + 2) / (2 * K + 2).factorial) := by
    unfold cosMaclaurinRem
    rw [Finset.sum_range_succ]
    ring
  rw [hstep] at h2
  have hnn : 0 ≤ v ^ (2 * K + 2) / ((2 * K + 2).factorial : ℝ) := by positivity
  rcases Nat.even_or_odd K with ⟨j, rfl⟩ | ⟨j, rfl⟩
  · have hp1 : (-1 : ℝ) ^ (j + j + 1) = -1 := by
      rw [show j + j + 1 = 2 * j + 1 by omega, pow_add, pow_mul]; norm_num
    have hp2 : (-1 : ℝ) ^ (j + j + 1 + 1) = 1 := by
      rw [show j + j + 1 + 1 = 2 * (j + 1) by omega, pow_mul]; norm_num
    rw [hp1] at h1 h2
    rw [hp2] at h2
    rw [abs_le]
    exact ⟨by linarith, by linarith⟩
  · have hp1 : (-1 : ℝ) ^ (2 * j + 1 + 1) = 1 := by
      rw [show 2 * j + 1 + 1 = 2 * (j + 1) by omega, pow_mul]; norm_num
    have hp2 : (-1 : ℝ) ^ (2 * j + 1 + 1 + 1) = -1 := by
      rw [show 2 * j + 1 + 1 + 1 = 2 * (j + 1) + 1 by omega, pow_add, pow_mul]; norm_num
    rw [hp1] at h1 h2
    rw [hp2] at h2
    rw [abs_le]
    exact ⟨by linarith, by linarith⟩

/-- Global degree-`2*K+1` sine Taylor bound `|sin u − ∑_{m ≤ K} (−1)^m u^{2m+1}/(2m+1)!| ≤ |u|^{2K+3}/(2K+3)!`. -/
theorem abs_sin_sub_maclaurin_le (K : ℕ) (u : ℝ) :
    |Real.sin u - ∑ m ∈ Finset.range (K + 1),
        (-1 : ℝ) ^ m * u ^ (2 * m + 1) / (2 * m + 1).factorial| ≤
      |u| ^ (2 * K + 3) / (2 * K + 3).factorial := by
  have hodd : ∀ x : ℝ, sinMaclaurinRem (K + 1) (-x) = -sinMaclaurinRem (K + 1) x := fun x => by
    unfold sinMaclaurinRem
    rw [Real.sin_neg]
    have hs : (∑ m ∈ Finset.range (K + 1),
        (-1 : ℝ) ^ m * (-x) ^ (2 * m + 1) / (2 * m + 1).factorial) =
        -(∑ m ∈ Finset.range (K + 1),
          (-1 : ℝ) ^ m * x ^ (2 * m + 1) / (2 * m + 1).factorial) := by
      rw [← Finset.sum_neg_distrib]
      refine Finset.sum_congr rfl fun m _ => ?_
      rw [Odd.neg_pow ⟨m, rfl⟩ x]
      ring
    rw [hs]
    ring
  have habs_eq : |sinMaclaurinRem (K + 1) u| = |sinMaclaurinRem (K + 1) (|u|)| := by
    rcases le_total 0 u with hu | hu
    · rw [abs_of_nonneg hu]
    · rw [abs_of_nonpos hu, hodd, abs_neg]
  change |sinMaclaurinRem (K + 1) u| ≤ _
  rw [habs_eq]
  set v : ℝ := |u|
  have hv : 0 ≤ v := abs_nonneg u
  have h1 := (alternating_sincos_rem_nonneg K hv).2
  have h2 := (alternating_sincos_rem_nonneg (K + 1) hv).2
  have hstep : sinMaclaurinRem (K + 2) v =
      sinMaclaurinRem (K + 1) v - (-1 : ℝ) ^ (K + 1) * (v ^ (2 * K + 3) / (2 * K + 3).factorial) := by
    unfold sinMaclaurinRem
    rw [Finset.sum_range_succ, show 2 * (K + 1) + 1 = 2 * K + 3 by omega]
    ring
  rw [hstep] at h2
  have hnn : 0 ≤ v ^ (2 * K + 3) / ((2 * K + 3).factorial : ℝ) := by positivity
  rcases Nat.even_or_odd K with ⟨j, rfl⟩ | ⟨j, rfl⟩
  · have hp1 : (-1 : ℝ) ^ (j + j + 1) = -1 := by
      rw [show j + j + 1 = 2 * j + 1 by omega, pow_add, pow_mul]; norm_num
    have hp2 : (-1 : ℝ) ^ (j + j + 1 + 1) = 1 := by
      rw [show j + j + 1 + 1 = 2 * (j + 1) by omega, pow_mul]; norm_num
    rw [hp1] at h1 h2
    rw [hp2] at h2
    rw [abs_le]
    exact ⟨by linarith, by linarith⟩
  · have hp1 : (-1 : ℝ) ^ (2 * j + 1 + 1) = 1 := by
      rw [show 2 * j + 1 + 1 = 2 * (j + 1) by omega, pow_mul]; norm_num
    have hp2 : (-1 : ℝ) ^ (2 * j + 1 + 1 + 1) = -1 := by
      rw [show 2 * j + 1 + 1 + 1 = 2 * (j + 1) + 1 by omega, pow_add, pow_mul]; norm_num
    rw [hp1] at h1 h2
    rw [hp2] at h2
    rw [abs_le]
    exact ⟨by linarith, by linarith⟩

/-- Degree-8 upper bound `cos u ≤ ∑_{m ≤ 4} (−1)^m u^{2m}/(2m)!` for all `u ∈ ℝ`. -/
theorem cos_le_maclaurin_four (u : ℝ) :
    Real.cos u ≤ ∑ m ∈ Finset.range 5, (-1 : ℝ) ^ m * u ^ (2 * m) / (2 * m).factorial := by
  have heven : cosMaclaurinRem 5 u = cosMaclaurinRem 5 (|u|) := by
    unfold cosMaclaurinRem
    rw [Real.cos_abs]
    congr 1
    refine Finset.sum_congr rfl fun m _ => ?_
    rw [pow_mul, pow_mul, sq_abs]
  have h := (alternating_sincos_rem_nonneg 4 (abs_nonneg u)).1
  have hp : (-1 : ℝ) ^ 5 = -1 := by norm_num
  rw [hp, ← heven] at h
  unfold cosMaclaurinRem at h
  linarith

/-! ### Algebraic Digamma Tail Telescoping -/

private theorem log_div_le_sub_div_sqrt {A B : ℝ} (hA : 0 < A) (hAB : A ≤ B) :
    Real.log (B / A) ≤ (B - A) / Real.sqrt (A * B) := by
  have hB : 0 < B := hA.trans_le hAB
  have hBA : 1 ≤ B / A := (one_le_div hA).mpr hAB
  set u : ℝ := Real.log (B / A) / 2
  have hu : 0 ≤ u := div_nonneg (Real.log_nonneg hBA) (by norm_num)
  have hu_sh : u ≤ Real.sinh u := by
    have h1 := (cosh_sinh_maclaurin_rem_bounds 1).1 hu
    unfold sinhMaclaurinRem at h1
    simp only [Finset.sum_range_one, mul_zero, zero_add, pow_one, Nat.factorial_one,
      Nat.cast_one, div_one] at h1
    linarith [h1.2]
  have hexp_u : Real.exp u = Real.sqrt (B / A) := by
    rw [Real.sqrt_eq_rpow, Real.rpow_def_of_pos (div_pos hB hA)]
    dsimp [u]
    congr 1
    ring
  have h2sh : 2 * Real.sinh u = (B - A) / Real.sqrt (A * B) := by
    rw [Real.sinh_eq, Real.exp_neg, hexp_u, Real.sqrt_div hB.le, Real.sqrt_mul hA.le]
    have hsA : 0 < Real.sqrt A := Real.sqrt_pos.mpr hA
    have hsB : 0 < Real.sqrt B := Real.sqrt_pos.mpr hB
    field_simp [hsA.ne', hsB.ne']
    rw [Real.sq_sqrt hB.le, Real.sq_sqrt hA.le]
  have : Real.log (B / A) = 2 * u := by dsimp [u]; ring
  linarith

private theorem gauss_step_ge_half_log_diff {v : ℝ} (hv : 0 < v) (r : ℝ) :
    1 / 2 * Real.log (1 + r ^ 2 / v ^ 2) - 1 / 2 * Real.log (1 + r ^ 2 / (v + 2) ^ 2) ≤
      r ^ 2 / (v * (v ^ 2 + r ^ 2)) + r ^ 2 / ((v + 2) * ((v + 2) ^ 2 + r ^ 2)) := by
  rcases eq_or_ne r 0 with rfl | hr
  · simp
  have hr2 : 0 < r ^ 2 := sq_pos_of_ne_zero hr
  set A : ℝ := v ^ 2 * ((v + 2) ^ 2 + r ^ 2)
  set B : ℝ := (v ^ 2 + r ^ 2) * (v + 2) ^ 2
  have hA : 0 < A := by dsimp [A]; positivity
  have hAB : A ≤ B := by
    dsimp [A, B]
    nlinarith
  have hlog_eq : Real.log (1 + r ^ 2 / v ^ 2) - Real.log (1 + r ^ 2 / (v + 2) ^ 2) =
      Real.log (B / A) := by
    have hv2 : v ^ 2 ≠ 0 := by positivity
    have hv22 : (v + 2) ^ 2 ≠ 0 := by positivity
    have h1 : 1 + r ^ 2 / v ^ 2 = (v ^ 2 + r ^ 2) / v ^ 2 := by field_simp
    have h2 : 1 + r ^ 2 / (v + 2) ^ 2 = ((v + 2) ^ 2 + r ^ 2) / (v + 2) ^ 2 := by field_simp
    rw [h1, h2, ← Real.log_div (by positivity) (by positivity)]
    congr 1
    dsimp [A, B]
    field_simp
  have hlg := log_div_le_sub_div_sqrt hA hAB
  rw [show 1 / 2 * Real.log (1 + r ^ 2 / v ^ 2) - 1 / 2 * Real.log (1 + r ^ 2 / (v + 2) ^ 2) =
    1 / 2 * (Real.log (1 + r ^ 2 / v ^ 2) - Real.log (1 + r ^ 2 / (v + 2) ^ 2)) by ring, hlog_eq]
  refine (mul_le_mul_of_nonneg_left hlg (by norm_num)).trans ?_
  have hBA : B - A = 4 * r ^ 2 * (v + 1) := by dsimp [A, B]; ring
  have hsqrt_AB : Real.sqrt (A * B) =
      v * (v + 2) * Real.sqrt ((v ^ 2 + r ^ 2) * ((v + 2) ^ 2 + r ^ 2)) := by
    have hrew : A * B = (v * (v + 2)) ^ 2 * ((v ^ 2 + r ^ 2) * ((v + 2) ^ 2 + r ^ 2)) := by
      dsimp [A, B]; ring
    rw [hrew, Real.sqrt_mul (by positivity), Real.sqrt_sq (by positivity)]
  rw [hBA, hsqrt_AB]
  set S : ℝ := Real.sqrt ((v ^ 2 + r ^ 2) * ((v + 2) ^ 2 + r ^ 2))
  have hS_pos : 0 < S := Real.sqrt_pos.mpr (by positivity)
  have hS_sq : S ^ 2 = (v ^ 2 + r ^ 2) * ((v + 2) ^ 2 + r ^ 2) :=
    Real.sq_sqrt (by positivity)
  have hrhs : r ^ 2 / (v * (v ^ 2 + r ^ 2)) + r ^ 2 / ((v + 2) * ((v + 2) ^ 2 + r ^ 2)) =
      r ^ 2 * ((v + 2) * ((v + 2) ^ 2 + r ^ 2) + v * (v ^ 2 + r ^ 2)) /
        (v * (v + 2) * S ^ 2) := by
    rw [hS_sq]
    field_simp
  rw [hrhs, show 1 / 2 * (4 * r ^ 2 * (v + 1) / (v * (v + 2) * S)) =
    r ^ 2 * (2 * (v + 1)) / (v * (v + 2) * S) by ring]
  rw [div_le_div_iff₀ (by positivity) (by positivity)]
  have hkey : 2 * (v + 1) * S ≤ (v + 2) * ((v + 2) ^ 2 + r ^ 2) + v * (v ^ 2 + r ^ 2) := by
    rw [← Real.sqrt_sq (show 0 ≤ (v + 2) * ((v + 2) ^ 2 + r ^ 2) + v * (v ^ 2 + r ^ 2) by positivity),
      ← Real.sqrt_sq (show 0 ≤ 2 * (v + 1) by positivity), ← Real.sqrt_mul (by positivity)]
    refine Real.sqrt_le_sqrt ?_
    have hid : ((v + 2) * ((v + 2) ^ 2 + r ^ 2) + v * (v ^ 2 + r ^ 2)) ^ 2 -
        (2 * (v + 1)) ^ 2 * ((v ^ 2 + r ^ 2) * ((v + 2) ^ 2 + r ^ 2)) =
        16 * (v + 1) ^ 2 * (2 * (v + 1) ^ 2 + 2 + r ^ 2) := by ring
    linarith [show 0 ≤ 16 * (v + 1) ^ 2 * (2 * (v + 1) ^ 2 + 2 + r ^ 2) by positivity]
  have hm := mul_le_mul_of_nonneg_left hkey (show 0 ≤ r ^ 2 * (v * (v + 2) * S) by positivity)
  linarith [show r ^ 2 * (2 * (v + 1)) * (v * (v + 2) * S ^ 2) =
      r ^ 2 * (v * (v + 2) * S) * (2 * (v + 1) * S) by ring,
    show r ^ 2 * (v * (v + 2) * S) * ((v + 2) * ((v + 2) ^ 2 + r ^ 2) + v * (v ^ 2 + r ^ 2)) =
      r ^ 2 * ((v + 2) * ((v + 2) ^ 2 + r ^ 2) + v * (v ^ 2 + r ^ 2)) * (v * (v + 2) * S) by ring]

/-- Trapezoidal Gauss-digamma lower bound for `EF.gammaBracket r` on all `r ∈ ℝ`. -/
theorem gammaBracket_ge_gauss_eight_add_log (r : ℝ) :
    EF.gammaBracket 0 +
        (∑ m ∈ Finset.range 8,
          2 * r ^ 2 / (((4 * (m : ℝ) + 1) / 2) * (((4 * (m : ℝ) + 1) / 2) ^ 2 + r ^ 2))) +
        1 / 2 * Real.log (1 + r ^ 2 / (33 / 2) ^ 2) +
        r ^ 2 / ((33 / 2) * ((33 / 2) ^ 2 + r ^ 2)) ≤
      EF.gammaBracket r := by
  have hhs0 := RHTower.hasSum_re_digamma_vertical_sub (a := (1 / 4 : ℝ)) (by norm_num) (r / 2)
  have e1 : (1 / 4 : ℂ) + I * (r : ℂ) / 2 = ((1 / 4 : ℝ) : ℂ) + ((r / 2 : ℝ) : ℂ) * I := by
    push_cast; ring
  have e0 : (1 / 4 : ℂ) + I * ((0 : ℝ) : ℂ) / 2 = ((1 / 4 : ℝ) : ℂ) := by push_cast; ring
  have hgb : (Complex.digamma ((1 / 4 : ℝ) + (r / 2 : ℝ) * I)).re -
      (Complex.digamma (1 / 4 : ℝ)).re = EF.gammaBracket r - EF.gammaBracket 0 := by
    unfold EF.gammaBracket
    rw [e1, e0]
    ring
  rw [hgb] at hhs0
  have hhs : HasSum
      (fun m : ℕ => 2 * r ^ 2 / (((4 * (m : ℝ) + 1) / 2) * (((4 * (m : ℝ) + 1) / 2) ^ 2 + r ^ 2)))
      (EF.gammaBracket r - EF.gammaBracket 0) := by
    refine hhs0.congr_fun fun m => ?_
    have hp : (1 / 4 : ℝ) + m ≠ 0 := by positivity
    have hq : ((1 / 4 : ℝ) + m) ^ 2 + (r / 2) ^ 2 ≠ 0 := by positivity
    have hp2 : (4 * (m : ℝ) + 1) / 2 ≠ 0 := by positivity
    have hq2 : ((4 * (m : ℝ) + 1) / 2) ^ 2 + r ^ 2 ≠ 0 := by positivity
    field_simp
    ring
  have htail : HasSum
      (fun j : ℕ => 2 * r ^ 2 / (((33 / 2 : ℝ) + 2 * j) * (((33 / 2 : ℝ) + 2 * j) ^ 2 + r ^ 2)))
      ((EF.gammaBracket r - EF.gammaBracket 0) -
        ∑ m ∈ Finset.range 8,
          2 * r ^ 2 / (((4 * (m : ℝ) + 1) / 2) * (((4 * (m : ℝ) + 1) / 2) ^ 2 + r ^ 2))) := by
    refine ((hasSum_nat_add_iff' 8).mpr hhs).congr_fun fun j => ?_
    congr 1
    push_cast
    ring
  set f : ℕ → ℝ := fun j =>
    r ^ 2 / (((33 / 2 : ℝ) + 2 * j) * (((33 / 2 : ℝ) + 2 * j) ^ 2 + r ^ 2))
  set L : ℕ → ℝ := fun j => 1 / 2 * Real.log (1 + r ^ 2 / ((33 / 2 : ℝ) + 2 * j) ^ 2)
  have htel : ∀ N : ℕ, L 0 - L N + f 0 - f N ≤ ∑ j ∈ Finset.range N, 2 * f j := fun N => by
    induction N with
    | zero => simp
    | succ N ih =>
      rw [Finset.sum_range_succ]
      have hstep := gauss_step_ge_half_log_diff (v := (33 / 2 : ℝ) + 2 * N) (by positivity) r
      have hv_next : (33 / 2 : ℝ) + 2 * N + 2 = (33 / 2 : ℝ) + 2 * ((N + 1 : ℕ) : ℝ) := by
        push_cast; ring
      dsimp [f, L] at ih ⊢
      rw [hv_next] at hstep
      linarith
  have hv_top : Tendsto (fun N : ℕ => (33 / 2 : ℝ) + 2 * N) atTop atTop :=
    tendsto_const_nhds.add_atTop (tendsto_natCast_atTop_atTop.const_mul_atTop (by norm_num))
  have hv2_top : Tendsto (fun N : ℕ => ((33 / 2 : ℝ) + 2 * N) ^ 2) atTop atTop :=
    (tendsto_pow_atTop (by norm_num)).comp hv_top
  have hLN : Tendsto L atTop (nhds 0) := by
    have hdiv : Tendsto (fun N : ℕ => r ^ 2 / ((33 / 2 : ℝ) + 2 * N) ^ 2) atTop (nhds 0) :=
      tendsto_const_nhds.div_atTop hv2_top
    have h1div : Tendsto (fun N : ℕ => 1 + r ^ 2 / ((33 / 2 : ℝ) + 2 * N) ^ 2) atTop (nhds 1) := by
      simpa using (tendsto_const_nhds (x := (1 : ℝ))).add hdiv
    have h1 := ((Real.continuousAt_log one_ne_zero).tendsto.comp h1div).const_mul (1 / 2 : ℝ)
    simpa [L] using h1
  have hfN : Tendsto f atTop (nhds 0) := by
    refine squeeze_zero (fun N => by dsimp [f]; positivity) (fun N => ?_)
      (tendsto_const_nhds (x := r ^ 2).div_atTop hv2_top)
    dsimp [f]
    refine div_le_div_of_nonneg_left (sq_nonneg r) (by positivity) ?_
    nlinarith [(Nat.cast_nonneg N : (0 : ℝ) ≤ N), sq_nonneg r]
  have hlim_lhs : Tendsto (fun N : ℕ => L 0 - L N + f 0 - f N) atTop (nhds (L 0 + f 0)) := by
    simpa using (((tendsto_const_nhds (x := L 0)).sub hLN).add (tendsto_const_nhds (x := f 0))).sub hfN
  have hlim_rhs : Tendsto (fun N : ℕ => ∑ j ∈ Finset.range N, 2 * f j) atTop
      (nhds ((EF.gammaBracket r - EF.gammaBracket 0) -
        ∑ m ∈ Finset.range 8,
          2 * r ^ 2 / (((4 * (m : ℝ) + 1) / 2) * (((4 * (m : ℝ) + 1) / 2) ^ 2 + r ^ 2)))) :=
    htail.tendsto_sum_nat.congr fun N => Finset.sum_congr rfl fun j _ => by dsimp [f]; ring
  have hbound := le_of_tendsto_of_tendsto hlim_lhs hlim_rhs (Eventually.of_forall htel)
  dsimp [L, f] at hbound
  simp only [Nat.cast_zero, mul_zero, add_zero] at hbound
  linarith

private theorem gammaBracket_neg_eq (r : ℝ) : EF.gammaBracket (-r) = EF.gammaBracket r := by
  have hhs1 := RHTower.hasSum_re_digamma_vertical_sub (a := (1 / 4 : ℝ)) (by norm_num) (r / 2)
  have hhs2 := RHTower.hasSum_re_digamma_vertical_sub (a := (1 / 4 : ℝ)) (by norm_num) (-r / 2)
  have e0 : (1 / 4 : ℂ) + I * ((0 : ℝ) : ℂ) / 2 = ((1 / 4 : ℝ) : ℂ) := by push_cast; ring
  have e1 : (1 / 4 : ℂ) + I * (r : ℂ) / 2 = ((1 / 4 : ℝ) : ℂ) + ((r / 2 : ℝ) : ℂ) * I := by
    push_cast; ring
  have e2 : (1 / 4 : ℂ) + I * ((-r : ℝ) : ℂ) / 2 = ((1 / 4 : ℝ) : ℂ) + ((-r / 2 : ℝ) : ℂ) * I := by
    push_cast; ring
  have hgb1 : (Complex.digamma ((1 / 4 : ℝ) + (r / 2 : ℝ) * I)).re -
      (Complex.digamma (1 / 4 : ℝ)).re = EF.gammaBracket r - EF.gammaBracket 0 := by
    unfold EF.gammaBracket; rw [e1, e0]; ring
  have hgb2 : (Complex.digamma ((1 / 4 : ℝ) + (-r / 2 : ℝ) * I)).re -
      (Complex.digamma (1 / 4 : ℝ)).re = EF.gammaBracket (-r) - EF.gammaBracket 0 := by
    unfold EF.gammaBracket; rw [e2, e0]; ring
  rw [hgb1] at hhs1
  rw [hgb2] at hhs2
  have heq : (fun n : ℕ => (-r / 2) ^ 2 / ((1 / 4 + (n : ℝ)) * ((1 / 4 + (n : ℝ)) ^ 2 + (-r / 2) ^ 2))) =
      fun n : ℕ => (r / 2) ^ 2 / ((1 / 4 + (n : ℝ)) * ((1 / 4 + (n : ℝ)) ^ 2 + (r / 2) ^ 2)) := by
    funext n; congr 1 <;> ring
  rw [heq] at hhs2
  linarith [hhs2.unique hhs1]

/-! ### Interval Envelope Builders on `[0, 69/2]` -/

/-- Quartic upper bound on a single negated Gauss term `−r² / (u(u² + r²))` for `0 ≤ a ≤ r`. -/
theorem gaussSingle_neg_le_quartic {u s0 a r D w : ℝ} (hu : 0 < u) (hs0 : 0 ≤ s0)
    (ha : 0 ≤ a) (har : a ≤ r) (hD_eq : D = u ^ 2 + s0) (hw_eq : w = (r ^ 2 - s0) / D) :
    -(r ^ 2 / (u * (u ^ 2 + r ^ 2))) ≤
      -1 / u + u / D * (1 - w + w ^ 2 - w ^ 3 + D / (u ^ 2 + a ^ 2) * w ^ 4) := by
  subst hD_eq; subst hw_eq
  set D : ℝ := u ^ 2 + s0
  set w : ℝ := (r ^ 2 - s0) / D
  have hD : 0 < D := by dsimp [D]; positivity
  have hur : 0 < u ^ 2 + r ^ 2 := by positivity
  have hua : 0 < u ^ 2 + a ^ 2 := by positivity
  have h1w : 1 + w = (u ^ 2 + r ^ 2) / D := by dsimp [w, D]; field_simp; ring
  have h1w_pos : 0 < 1 + w := by rw [h1w]; positivity
  have hrew : -(r ^ 2 / (u * (u ^ 2 + r ^ 2))) =
      -1 / u + u / D * (1 - w + w ^ 2 - w ^ 3 + w ^ 4 / (1 + w)) := by
    have : 1 - w + w ^ 2 - w ^ 3 + w ^ 4 / (1 + w) = 1 / (1 + w) := by
      field_simp [h1w_pos.ne']
      ring
    rw [this, h1w]
    field_simp [hu.ne', hD.ne', hur.ne']
    ring
  rw [hrew]
  have har2 : a ^ 2 ≤ r ^ 2 := pow_le_pow_left₀ ha har 2
  have hw4 : w ^ 4 / (1 + w) ≤ D / (u ^ 2 + a ^ 2) * w ^ 4 := by
    rw [h1w, div_div_eq_mul_div, show D / (u ^ 2 + a ^ 2) * w ^ 4 = w ^ 4 * D / (u ^ 2 + a ^ 2) by ring]
    exact div_le_div_of_nonneg_left (by positivity) hua (by linarith [har2])
  have huD : 0 ≤ u / D := by positivity
  nlinarith

/-- Quartic upper bound on `−(1/2) log(1 + r²/u_M²)` on `[a, b]` (`s0 = (a² + b²)/2`). -/
theorem neg_half_log_one_add_le_quartic {uM a b r c0 s0 DM w : ℝ} (huM : 0 < uM) (ha : 0 ≤ a)
    (hab : a ≤ b) (har : a ≤ r)
    (hc0 : c0 ≤ 1 / 2 * Real.log (1 + ((a ^ 2 + b ^ 2) / 2) / uM ^ 2))
    (hs0_eq : s0 = (a ^ 2 + b ^ 2) / 2) (hDM_eq : DM = uM ^ 2 + s0)
    (hw_eq : w = (r ^ 2 - s0) / DM) :
    -(1 / 2 * Real.log (1 + r ^ 2 / uM ^ 2)) ≤
      -c0 - 1 / 2 * (w - w ^ 2 / 2 + w ^ 3 / 3 - DM / (uM ^ 2 + a ^ 2) * (1 / 4) * w ^ 4) := by
  subst hs0_eq; subst hDM_eq; subst hw_eq
  set s0 : ℝ := (a ^ 2 + b ^ 2) / 2
  set DM : ℝ := uM ^ 2 + s0
  set w : ℝ := (r ^ 2 - s0) / DM
  have hs0 : 0 ≤ s0 := by dsimp [s0]; positivity
  have hDM : 0 < DM := by dsimp [DM]; positivity
  have hua : 0 < uM ^ 2 + a ^ 2 := by positivity
  have h1w : 1 + w = (uM ^ 2 + r ^ 2) / DM := by dsimp [w, DM]; field_simp; ring
  have hprod : 1 + r ^ 2 / uM ^ 2 = (1 + s0 / uM ^ 2) * (1 + w) := by
    rw [h1w]
    dsimp [DM]
    field_simp [huM.ne', hDM.ne']
  have hlog_split : Real.log (1 + r ^ 2 / uM ^ 2) =
      Real.log (1 + s0 / uM ^ 2) + Real.log (1 + w) := by
    rw [hprod, Real.log_mul (by positivity) (by rw [h1w]; positivity)]
  set wmin : ℝ := (a ^ 2 - s0) / DM
  have hwmin_le0 : wmin ≤ 0 := by
    dsimp [wmin, s0]
    exact div_nonpos_of_nonpos_of_nonneg (by nlinarith [pow_le_pow_left₀ ha hab 2]) hDM.le
  have h1wmin : 1 + wmin = (uM ^ 2 + a ^ 2) / DM := by dsimp [wmin, DM]; field_simp; ring
  have h1wmin_pos : 0 < 1 + wmin := by rw [h1wmin]; positivity
  have hwmin_le_w : wmin ≤ w := by
    dsimp [wmin, w]
    exact div_le_div_of_nonneg_right (by linarith [pow_le_pow_left₀ ha har 2]) hDM.le
  let g : ℝ → ℝ := fun t =>
    Real.log (1 + t) - (t - t ^ 2 / 2 + t ^ 3 / 3) + t ^ 4 / (4 * (1 + wmin))
  have hg_deriv : ∀ t : ℝ, wmin ≤ t →
      HasDerivAt g (t ^ 3 * (t - wmin) / ((1 + t) * (1 + wmin))) t := fun t ht => by
    have h1t : 0 < 1 + t := by linarith
    have hd := (((((hasDerivAt_const t (1 : ℝ)).add (hasDerivAt_id' t)).log h1t.ne').sub
      (((hasDerivAt_id' t).sub ((hasDerivAt_pow 2 t).div_const 2)).add
        ((hasDerivAt_pow 3 t).div_const 3))).add
      ((hasDerivAt_pow 4 t).div_const (4 * (1 + wmin))))
    refine hd.congr_deriv ?_
    dsimp only [Pi.add_apply, Pi.sub_apply]
    field_simp [h1t.ne', h1wmin_pos.ne']
    push_cast
    ring
  have hgw : 0 ≤ g w := by
    have hg0 : g 0 = 0 := by simp [g]
    rcases le_total w 0 with hw0 | hw0
    · have hant : AntitoneOn g (Icc wmin 0) :=
        antitoneOn_of_deriv_nonpos (convex_Icc wmin 0)
          (by
            dsimp [g]
            refine ContinuousOn.add (ContinuousOn.sub ?_ (by fun_prop)) (by fun_prop)
            exact ContinuousOn.log (by fun_prop) fun t ht => by linarith [ht.1])
          (fun t ht => (hg_deriv t (interior_subset ht).1).differentiableAt.differentiableWithinAt)
          (fun t ht => by
            have ht' := interior_subset ht
            rw [(hg_deriv t ht'.1).deriv]
            refine div_nonpos_of_nonpos_of_nonneg ?_ (mul_nonneg (by linarith [ht'.1]) h1wmin_pos.le)
            have ht3 : t ^ 3 ≤ 0 := Odd.pow_nonpos ⟨1, rfl⟩ ht'.2
            exact mul_nonpos_of_nonpos_of_nonneg ht3 (by linarith [ht'.1]))
      have := hant ⟨hwmin_le_w, hw0⟩ ⟨hwmin_le0, le_rfl⟩ hw0
      linarith
    · have hmon : MonotoneOn g (Ici 0) :=
        monotoneOn_of_deriv_nonneg (convex_Ici 0)
          (by
            dsimp [g]
            refine ContinuousOn.add (ContinuousOn.sub ?_ (by fun_prop)) (by fun_prop)
            exact ContinuousOn.log (by fun_prop) fun t ht => by linarith [mem_Ici.mp ht])
          (fun t ht =>
            (hg_deriv t (hwmin_le0.trans (interior_subset ht))).differentiableAt.differentiableWithinAt)
          (fun t ht => by
            have ht0 : 0 ≤ t := interior_subset ht
            rw [(hg_deriv t (hwmin_le0.trans ht0)).deriv]
            exact div_nonneg (mul_nonneg (pow_nonneg ht0 3) (by linarith))
              (mul_nonneg (by linarith) h1wmin_pos.le))
      have := hmon self_mem_Ici hw0 hw0
      linarith
  have hinv : w ^ 4 / (4 * (1 + wmin)) = DM / (uM ^ 2 + a ^ 2) * (1 / 4) * w ^ 4 := by
    rw [h1wmin]
    field_simp [hDM.ne', hua.ne']
  dsimp [g] at hgw
  rw [hinv] at hgw
  rw [hlog_split]
  linarith

/-- Cosine shift reduction at integer multiples of `π / 2`. -/
theorem cos_nat_mul_pi_div_two_add (k : ℕ) (u : ℝ) :
    Real.cos ((k : ℝ) * (Real.pi / 2) + u) =
      if k % 4 = 0 then Real.cos u
      else if k % 4 = 1 then -Real.sin u
      else if k % 4 = 2 then -Real.cos u
      else Real.sin u := by
  have hdiv : k = 4 * (k / 4) + k % 4 := (Nat.div_add_mod k 4).symm
  set q : ℕ := k / 4
  set m : ℕ := k % 4
  have hm4 : m < 4 := Nat.mod_lt k (by norm_num)
  have hk_eq : (k : ℝ) * (Real.pi / 2) + u =
      ((m : ℝ) * (Real.pi / 2) + u) + (q : ℤ) * (2 * Real.pi) := by
    have h1 : (k : ℝ) = 4 * (q : ℝ) + (m : ℝ) := by exact_mod_cast hdiv
    rw [h1, Int.cast_natCast]
    ring
  rw [hk_eq, Real.cos_add_int_mul_two_pi]
  interval_cases m
  · simp
  · simp [add_comm (Real.pi / 2) u, Real.cos_add_pi_div_two]
  · simp [show (2 : ℝ) * (Real.pi / 2) + u = u + Real.pi by ring, Real.cos_add_pi]
  · simp [show (3 : ℝ) * (Real.pi / 2) + u = (u + Real.pi) + Real.pi / 2 by ring,
      Real.cos_add_pi_div_two, Real.sin_add_pi]

/-- Certified rational-argument reduction for `√2 log 2 cos(r log 2)` on `[0, 69/2]` (`k ≤ 16`). -/
theorem trig_term_le_on_Icc {r : ℝ} (hr0 : 0 ≤ r) (hrT : r ≤ 69 / 2) (k : ℕ) (hk : k ≤ 16) :
    Real.sqrt 2 * Real.log 2 * Real.cos (r * Real.log 2) ≤
      (98025814 / 100000000 : ℝ) * (1 / 10000000) +
        ((98025815 / 100000000 : ℝ) - (98025814 / 100000000 : ℝ)) +
        (98025814 / 100000000 : ℝ) *
          Real.cos ((k : ℝ) * (Real.pi / 2) +
            (r * (6931471805 / 10000000000 : ℝ) - (k : ℝ) * (1570796327 / 1000000000 : ℝ))) := by
  have hl2_lo := Real.log_two_gt_d9
  have hl2_hi := Real.log_two_lt_d9
  have hpi_lo := Real.pi_gt_d20
  have hpi_hi := Real.pi_lt_d20
  norm_num at hl2_lo hl2_hi hpi_lo hpi_hi
  have hl2_err : |Real.log 2 - (6931471805 / 10000000000 : ℝ)| ≤ 3 / 10000000000 :=
    abs_le.mpr ⟨by linarith, by linarith⟩
  have hhp_err : |Real.pi / 2 - (1570796327 / 1000000000 : ℝ)| ≤ 3 / 10000000000 :=
    abs_le.mpr ⟨by linarith, by linarith⟩
  set θ : ℝ := (k : ℝ) * (Real.pi / 2) +
    (r * (6931471805 / 10000000000 : ℝ) - (k : ℝ) * (1570796327 / 1000000000 : ℝ))
  have harg_err : |r * Real.log 2 - θ| ≤ 1 / 10000000 := by
    have hrew : r * Real.log 2 - θ =
        r * (Real.log 2 - (6931471805 / 10000000000 : ℝ)) -
          (k : ℝ) * (Real.pi / 2 - (1570796327 / 1000000000 : ℝ)) := by
      dsimp [θ]; ring
    rw [hrew]
    have hk_r : (k : ℝ) ≤ 16 := by exact_mod_cast hk
    have hk0 : (0 : ℝ) ≤ k := Nat.cast_nonneg k
    have h1 : |r * (Real.log 2 - (6931471805 / 10000000000 : ℝ))| ≤ (69 / 2) * (3 / 10000000000) := by
      rw [abs_mul, abs_of_nonneg hr0]
      exact mul_le_mul hrT hl2_err (abs_nonneg _) (by norm_num)
    have h2 : |(k : ℝ) * (Real.pi / 2 - (1570796327 / 1000000000 : ℝ))| ≤ 16 * (3 / 10000000000) := by
      rw [abs_mul, abs_of_nonneg hk0]
      exact mul_le_mul hk_r hhp_err (abs_nonneg _) (by norm_num)
    have htri := abs_sub (r * (Real.log 2 - (6931471805 / 10000000000 : ℝ)))
      ((k : ℝ) * (Real.pi / 2 - (1570796327 / 1000000000 : ℝ)))
    linarith
  have hcos_lip : Real.cos (r * Real.log 2) ≤ Real.cos θ + 1 / 10000000 := by
    have := (abs_le.mp ((Real.abs_cos_sub_cos_le (r * Real.log 2) θ).trans harg_err)).2
    linarith
  obtain ⟨hs_lo, hs_hi⟩ := sqrt_two_mul_log_two_sharp_bounds
  have hsplit : Real.sqrt 2 * Real.log 2 * Real.cos (r * Real.log 2) =
      (98025814 / 100000000 : ℝ) * Real.cos (r * Real.log 2) +
        (Real.sqrt 2 * Real.log 2 - (98025814 / 100000000 : ℝ)) * Real.cos (r * Real.log 2) := by
    ring
  have hrem_cos : (Real.sqrt 2 * Real.log 2 - (98025814 / 100000000 : ℝ)) * Real.cos (r * Real.log 2) ≤
      (98025815 / 100000000 : ℝ) - (98025814 / 100000000 : ℝ) := by
    have hc1 := Real.cos_le_one (r * Real.log 2)
    nlinarith
  linarith

/-- Centered polynomial rounding lemma on `[a, b]`. -/
theorem poly_centered_round_le (M : ℕ) (c c' : ℕ → ℝ) {a b r : ℝ}
    (ha : a ≤ r) (hb : r ≤ b)
    (herr : ∑ d ∈ Finset.Icc 1 M, |c d - c' d| * ((b - a) / 2) ^ d ≤ c' 0 - c 0) :
    c 0 + ∑ d ∈ Finset.Icc 1 M, c d * (r - (a + b) / 2) ^ d ≤
      c' 0 + ∑ d ∈ Finset.Icc 1 M, c' d * (r - (a + b) / 2) ^ d := by
  have habs : |r - (a + b) / 2| ≤ (b - a) / 2 := abs_le.mpr ⟨by linarith, by linarith⟩
  have hdiff : (∑ d ∈ Finset.Icc 1 M, c d * (r - (a + b) / 2) ^ d) -
      (∑ d ∈ Finset.Icc 1 M, c' d * (r - (a + b) / 2) ^ d) ≤
      ∑ d ∈ Finset.Icc 1 M, |c d - c' d| * ((b - a) / 2) ^ d := by
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_le_sum fun d _ => ?_
    rw [← sub_mul]
    refine (le_abs_self _).trans ?_
    rw [abs_mul, abs_pow]
    exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (abs_nonneg _) habs d) (abs_nonneg _)
  linarith

/-! ### Legendre Polynomial Basis on `[−1, 1]` -/

/-- Legendre polynomials `P_n(u)` defined by Bonnet's three-term recurrence. -/
def legP : ℕ → ℝ → ℝ
  | 0, _ => 1
  | 1, u => u
  | n + 2, u => ((2 * (n : ℝ) + 3) * u * legP (n + 1) u - ((n : ℝ) + 1) * legP n u) / ((n : ℝ) + 2)

theorem legP_zero (u : ℝ) : legP 0 u = 1 := rfl
theorem legP_one (u : ℝ) : legP 1 u = u := rfl
theorem legP_succ_succ (n : ℕ) (u : ℝ) :
    legP (n + 2) u =
      ((2 * (n : ℝ) + 3) * u * legP (n + 1) u - ((n : ℝ) + 1) * legP n u) / ((n : ℝ) + 2) := rfl

theorem legP_bonnet (n : ℕ) (u : ℝ) :
    ((n : ℝ) + 2) * legP (n + 2) u =
      (2 * (n : ℝ) + 3) * u * legP (n + 1) u - ((n : ℝ) + 1) * legP n u := by
  rw [legP_succ_succ]
  have hpos : (n : ℝ) + 2 ≠ 0 := by positivity
  field_simp

theorem continuous_legP (n : ℕ) : Continuous (legP n) := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    rcases n with _ | _ | n
    · exact continuous_const
    · exact continuous_id
    · have heq : legP (n + 2) = fun u =>
          ((2 * (n : ℝ) + 3) * u * legP (n + 1) u - ((n : ℝ) + 1) * legP n u) / ((n : ℝ) + 2) :=
        funext (legP_succ_succ n)
      rw [heq]
      have c1 := ih (n + 1) (by omega)
      have c0 := ih n (by omega)
      fun_prop

theorem legP_neg : ∀ (n : ℕ) (u : ℝ), legP n (-u) = (-1 : ℝ) ^ n * legP n u
  | 0, _ => by simp [legP]
  | 1, u => by simp [legP]
  | n + 2, u => by
    rw [legP_succ_succ, legP_succ_succ, legP_neg (n + 1) u, legP_neg n u,
      pow_succ (-1 : ℝ) (n + 1), pow_succ (-1 : ℝ) n]
    ring

/-- Formal derivative sequence `P_n'(u)` of Legendre polynomials. -/
def legP' : ℕ → ℝ → ℝ
  | 0, _ => 0
  | 1, _ => 1
  | n + 2, u => (2 * (n : ℝ) + 3) * legP (n + 1) u + legP' n u

private theorem legP'_identities :
    ∀ (n : ℕ) (u : ℝ),
      legP' (n + 1) u = ((n : ℝ) + 1) * legP n u + u * legP' n u ∧
        u * legP' (n + 1) u - legP' n u = ((n : ℝ) + 1) * legP (n + 1) u := by
  intro n
  induction n with
  | zero =>
    intro u
    simp [legP, legP']
  | succ n ih =>
    intro u
    obtain ⟨ih1, ih2⟩ := ih u
    have hbonnet := legP_bonnet n u
    have hp' : legP' (n + 2) u = (2 * (n : ℝ) + 3) * legP (n + 1) u + legP' n u := rfl
    push_cast
    constructor
    · rw [hp']
      linarith
    · rw [hp']
      linarith [hbonnet, congrArg (u * ·) ih1]

theorem hasDerivAt_legP : ∀ (n : ℕ) (u : ℝ), HasDerivAt (legP n) (legP' n u) u := by
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    rcases n with _ | _ | n
    · intro u; exact hasDerivAt_const u (1 : ℝ)
    · intro u; exact hasDerivAt_id' u
    · intro u
      have d1 := ih (n + 1) (by omega) u
      have d0 := ih n (by omega) u
      have heq : legP (n + 2) = fun x =>
          ((2 * (n : ℝ) + 3) * (x * legP (n + 1) x) - ((n : ℝ) + 1) * legP n x) / ((n : ℝ) + 2) :=
        funext fun x => by rw [legP_succ_succ]; ring
      have hd : HasDerivAt (legP (n + 2))
          (((2 * (n : ℝ) + 3) * (1 * legP (n + 1) u + u * legP' (n + 1) u) -
            ((n : ℝ) + 1) * legP' n u) / ((n : ℝ) + 2)) u := by
        rw [heq]
        exact (((((hasDerivAt_id' u).mul d1).const_mul (2 * (n : ℝ) + 3)).sub
          (d0.const_mul ((n : ℝ) + 1))).div_const ((n : ℝ) + 2))
      refine hd.congr_deriv ?_
      have hid2 := (legP'_identities n u).2
      change _ = (2 * (n : ℝ) + 3) * legP (n + 1) u + legP' n u
      have hpos : (n : ℝ) + 2 ≠ 0 := by positivity
      field_simp
      linarith [congrArg ((2 * (n : ℝ) + 3) * ·) hid2]

private theorem hasDerivAt_one_sub_sq_mul_legP' (m : ℕ) (u : ℝ) :
    HasDerivAt (fun x => (1 - x ^ 2) * legP' m x)
      (-(m : ℝ) * ((m : ℝ) + 1) * legP m u) u := by
  rcases m with _ | n
  · simp only [legP', mul_zero, Nat.cast_zero, neg_zero, zero_mul]
    exact hasDerivAt_const u 0
  · have hfn : (fun x : ℝ => (1 - x ^ 2) * legP' (n + 1) x) =
        fun x => ((n : ℝ) + 1) * (legP n x - x * legP (n + 1) x) := by
      funext x
      obtain ⟨h1, h2⟩ := legP'_identities n x
      linarith [congrArg (x * ·) h2]
    rw [hfn]
    have hd := ((hasDerivAt_legP n u).sub
      ((hasDerivAt_id' u).mul (hasDerivAt_legP (n + 1) u))).const_mul ((n : ℝ) + 1)
    refine hd.congr_deriv ?_
    have h2 := (legP'_identities n u).2
    push_cast
    linarith [congrArg (((n : ℝ) + 1) * ·) h2]

/-- Legendre polynomial orthogonality on `[−1, 1]`: `∫_{-1}^1 P_m(u) P_n(u) du = 0` for `m ≠ n`. -/
theorem legP_orthog {m n : ℕ} (hmn : m ≠ n) :
    (∫ u in (-1 : ℝ)..1, legP m u * legP n u) = 0 := by
  let W : ℝ → ℝ := fun u =>
    ((1 - u ^ 2) * legP' m u) * legP n u - ((1 - u ^ 2) * legP' n u) * legP m u
  have hW : ∀ u : ℝ, HasDerivAt W
      (((n : ℝ) * ((n : ℝ) + 1) - (m : ℝ) * ((m : ℝ) + 1)) * (legP m u * legP n u)) u := fun u => by
    have dA := (hasDerivAt_one_sub_sq_mul_legP' m u).mul (hasDerivAt_legP n u)
    have dB := (hasDerivAt_one_sub_sq_mul_legP' n u).mul (hasDerivAt_legP m u)
    exact (dA.sub dB).congr_deriv (by ring)
  have hint : (∫ u in (-1 : ℝ)..1,
      ((n : ℝ) * ((n : ℝ) + 1) - (m : ℝ) * ((m : ℝ) + 1)) * (legP m u * legP n u)) =
      W 1 - W (-1) :=
    intervalIntegral.integral_eq_sub_of_hasDerivAt (fun u _ => hW u)
      (Continuous.intervalIntegrable
        (continuous_const.mul ((continuous_legP m).mul (continuous_legP n))) _ _)
  have hW0 : W 1 - W (-1) = 0 := by dsimp [W]; ring
  rw [hW0, intervalIntegral.integral_const_mul] at hint
  have hne : (n : ℝ) * ((n : ℝ) + 1) - (m : ℝ) * ((m : ℝ) + 1) ≠ 0 := by
    rcases lt_or_gt_of_ne hmn with hlt | hgt
    · have hm_lt : (m : ℝ) + 1 ≤ n := by exact_mod_cast hlt
      have hm0 : (0 : ℝ) ≤ m := Nat.cast_nonneg m
      nlinarith
    · have hn_lt : (n : ℝ) + 1 ≤ m := by exact_mod_cast hgt
      have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
      nlinarith
  exact (mul_eq_zero.mp hint).resolve_left hne

/-- Legendre polynomial `L²` norm on `[−1, 1]`: `∫_{-1}^1 P_n(u)² du = 2 / (2n + 1)`. -/
theorem legP_sq_integral (n : ℕ) :
    (∫ u in (-1 : ℝ)..1, legP n u ^ 2) = 2 / (2 * (n : ℝ) + 1) := by
  have hu_step : ∀ k : ℕ, (∫ u in (-1 : ℝ)..1, u * legP (k + 1) u * legP k u) =
      ((k : ℝ) + 1) / (2 * (k : ℝ) + 3) * (∫ u in (-1 : ℝ)..1, legP k u ^ 2) := fun k => by
    have hb2 : ∀ u : ℝ, ((k : ℝ) + 2) * (legP (k + 2) u * legP k u) =
        (2 * (k : ℝ) + 3) * (u * legP (k + 1) u * legP k u) - ((k : ℝ) + 1) * legP k u ^ 2 :=
      fun u => by linear_combination legP k u * legP_bonnet k u
    have hi_cross : ((k : ℝ) + 2) * (∫ u in (-1 : ℝ)..1, legP (k + 2) u * legP k u) = 0 := by
      rw [legP_orthog (by omega), mul_zero]
    have hi_b2 : ((k : ℝ) + 2) * (∫ u in (-1 : ℝ)..1, legP (k + 2) u * legP k u) =
        (2 * (k : ℝ) + 3) * (∫ u in (-1 : ℝ)..1, u * legP (k + 1) u * legP k u) -
          ((k : ℝ) + 1) * (∫ u in (-1 : ℝ)..1, legP k u ^ 2) := by
      rw [← intervalIntegral.integral_const_mul,
        intervalIntegral.integral_congr fun u _ => hb2 u,
        intervalIntegral.integral_sub
          (f := fun u => (2 * (k : ℝ) + 3) * (u * legP (k + 1) u * legP k u))
          (g := fun u => ((k : ℝ) + 1) * legP k u ^ 2)
          (Continuous.intervalIntegrable (continuous_const.mul
            ((continuous_id.mul (continuous_legP (k + 1))).mul (continuous_legP k))) _ _)
          (Continuous.intervalIntegrable (continuous_const.mul ((continuous_legP k).pow 2)) _ _),
        intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul]
    have hpos : 2 * (k : ℝ) + 3 ≠ 0 := by positivity
    rw [div_mul_eq_mul_div, eq_div_iff hpos]
    linarith
  induction n with
  | zero =>
    simp only [legP_zero]
    norm_num
  | succ n ih =>
    rcases n with _ | m
    · rw [show 0 + 1 = 1 from rfl]
      simp_rw [legP_one]
      rw [integral_pow]
      norm_num
    · rw [show m + 1 + 1 = m + 2 from rfl]
      have hb1 : ∀ u : ℝ, ((m : ℝ) + 2) * legP (m + 2) u ^ 2 =
          (2 * (m : ℝ) + 3) * (u * legP (m + 2) u * legP (m + 1) u) -
            ((m : ℝ) + 1) * (legP m u * legP (m + 2) u) :=
        fun u => by linear_combination legP (m + 2) u * legP_bonnet m u
      have hi_orth : (∫ u in (-1 : ℝ)..1, legP m u * legP (m + 2) u) = 0 :=
        legP_orthog (by omega)
      have hi_b1 : ((m : ℝ) + 2) * (∫ u in (-1 : ℝ)..1, legP (m + 2) u ^ 2) =
          (2 * (m : ℝ) + 3) * (∫ u in (-1 : ℝ)..1, u * legP (m + 2) u * legP (m + 1) u) := by
        rw [← intervalIntegral.integral_const_mul,
          intervalIntegral.integral_congr fun u _ => hb1 u,
          intervalIntegral.integral_sub
            (f := fun u => (2 * (m : ℝ) + 3) * (u * legP (m + 2) u * legP (m + 1) u))
            (g := fun u => ((m : ℝ) + 1) * (legP m u * legP (m + 2) u))
            (Continuous.intervalIntegrable (continuous_const.mul
              ((continuous_id.mul (continuous_legP (m + 2))).mul (continuous_legP (m + 1)))) _ _)
            (Continuous.intervalIntegrable (continuous_const.mul
              ((continuous_legP m).mul (continuous_legP (m + 2)))) _ _),
          intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul,
          hi_orth, mul_zero, sub_zero]
      have hu_m := hu_step (m + 1)
      rw [show m + 1 + 1 = m + 2 from rfl] at hu_m
      push_cast at hu_m ih ⊢
      rw [hu_m, ih] at hi_b1
      have hpos2 : (m : ℝ) + 2 ≠ 0 := by positivity
      have hpos5 : 2 * ((m : ℝ) + 2) + 1 ≠ 0 := by positivity
      have hpos5' : 2 * ((m : ℝ) + 1) + 3 ≠ 0 := by positivity
      have hpos3' : 2 * ((m : ℝ) + 1) + 1 ≠ 0 := by positivity
      rw [eq_div_iff hpos5]
      apply mul_left_cancel₀ (mul_ne_zero hpos2 hpos3')
      field_simp at hi_b1
      linear_combination hi_b1

/-- If an even continuous function `g` on `[−1, 1]` is orthogonal to `P_0, P_2, …, P_{2K}`, then it
is orthogonal to every even monomial `u^{2m}` for `0 ≤ m ≤ K`. -/
theorem legP_perp_even_pow_orthog {g : ℝ → ℝ} (hg : Continuous g) (heven : ∀ u, g (-u) = g u)
    (K : ℕ) (horth : ∀ k ≤ K, (∫ u in (-1 : ℝ)..1, g u * legP (2 * k) u) = 0) :
    ∀ m ≤ K, (∫ u in (-1 : ℝ)..1, g u * u ^ (2 * m)) = 0 := by
  have hall : ∀ j ≤ 2 * K + 1, (∫ u in (-1 : ℝ)..1, g u * legP j u) = 0 := by
    intro j hj
    rcases Nat.even_or_odd j with ⟨k, rfl⟩ | ⟨k, rfl⟩
    · rw [show k + k = 2 * k by omega]
      exact horth k (by omega)
    · have hodd_int : ∀ u : ℝ, g (-u) * legP (2 * k + 1) (-u) = -(g u * legP (2 * k + 1) u) :=
        fun u => by
          rw [heven u, legP_neg, pow_add, pow_mul]
          norm_num
      have hneg : (∫ u in (-1 : ℝ)..1, g (-u) * legP (2 * k + 1) (-u)) =
          ∫ u in (-1 : ℝ)..1, g u * legP (2 * k + 1) u := by
        simpa using (intervalIntegral.integral_comp_neg (a := (-1 : ℝ)) (b := 1)
          (fun u => g u * legP (2 * k + 1) u))
      rw [intervalIntegral.integral_congr fun u _ => hodd_int u,
        intervalIntegral.integral_neg] at hneg
      linarith
  have hind : ∀ r : ℕ, ∀ d : ℕ, r + d ≤ 2 * K + 1 →
      (∫ u in (-1 : ℝ)..1, g u * u ^ r * legP d u) = 0 := by
    intro r
    induction r with
    | zero =>
      intro d hd
      simpa using hall d (by omega)
    | succ r ih =>
      intro d hd
      rcases d with _ | j
      · have h0 : ∀ u : ℝ, g u * u ^ (r + 1) * legP 0 u = g u * u ^ r * legP 1 u :=
          fun u => by simp [legP]; ring
        rw [intervalIntegral.integral_congr fun u _ => h0 u]
        exact ih 1 (by omega)
      · have hstep : ∀ u : ℝ, g u * u ^ (r + 1) * legP (j + 1) u =
            ((j : ℝ) + 2) / (2 * (j : ℝ) + 3) * (g u * u ^ r * legP (j + 2) u) +
              ((j : ℝ) + 1) / (2 * (j : ℝ) + 3) * (g u * u ^ r * legP j u) := fun u => by
          have hbon := legP_bonnet j u
          have hden : 2 * (j : ℝ) + 3 ≠ 0 := by positivity
          field_simp
          linear_combination g u * u ^ r * (-hbon)
        rw [intervalIntegral.integral_congr fun u _ => hstep u,
          intervalIntegral.integral_add
            (f := fun u => ((j : ℝ) + 2) / (2 * (j : ℝ) + 3) * (g u * u ^ r * legP (j + 2) u))
            (g := fun u => ((j : ℝ) + 1) / (2 * (j : ℝ) + 3) * (g u * u ^ r * legP j u))
            (Continuous.intervalIntegrable (continuous_const.mul
              ((hg.mul (continuous_pow r)).mul (continuous_legP (j + 2)))) _ _)
            (Continuous.intervalIntegrable (continuous_const.mul
              ((hg.mul (continuous_pow r)).mul (continuous_legP j))) _ _),
          intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul,
          ih (j + 2) (by omega), ih j (by omega), mul_zero, mul_zero, add_zero]
  intro m hm
  simpa [legP] using hind (2 * m) 0 (by omega)

/-- Symmetric diagonally dominant matrices + nonnegative `LDLᵀ` splits define PSD quadratic forms. -/
theorem ldl_gershgorin_quadratic_nonneg {N : ℕ} (H L : Fin N → Fin N → ℝ) (D : Fin N → ℝ)
    (hH_symm : ∀ i j, H i j = H j i)
    (hD_nonneg : ∀ s, 0 ≤ D s)
    (hdom : ∀ i,
      (H i i - ∑ s, L i s * D s * L i s) ≥
        ∑ j ∈ Finset.univ.erase i, |H i j - ∑ s, L i s * D s * L j s|)
    (c : Fin N → ℝ) :
    0 ≤ ∑ i, ∑ j, c i * H i j * c j := by
  let R : Fin N → Fin N → ℝ := fun i j => H i j - ∑ s, L i s * D s * L j s
  have hR_symm : ∀ i j, R i j = R j i := fun i j => by
    dsimp [R]
    rw [hH_symm i j]
    congr 1
    exact Finset.sum_congr rfl fun s _ => by ring
  have hsplit : (∑ i, ∑ j, c i * H i j * c j) =
      (∑ s, D s * (∑ i, L i s * c i) ^ 2) + ∑ i, ∑ j, c i * R i j * c j := by
    have h1 : (∑ s, D s * (∑ i, L i s * c i) ^ 2) =
        ∑ i, ∑ j, c i * (∑ s, L i s * D s * L j s) * c j := by
      simp_rw [sq, Finset.sum_mul, Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Finset.sum_mul]
      exact Finset.sum_congr rfl fun s _ => by ring
    rw [h1, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j _ => ?_
    dsimp [R]
    ring
  rw [hsplit]
  refine add_nonneg (Finset.sum_nonneg fun s _ => mul_nonneg (hD_nonneg s) (sq_nonneg _)) ?_
  have hdiag_split : (∑ i, ∑ j, c i * R i j * c j) =
      (∑ i, c i ^ 2 * R i i) + ∑ i, ∑ j ∈ Finset.univ.erase i, c i * R i j * c j := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    have := (Finset.add_sum_erase Finset.univ (fun j => c i * R i j * c j) (Finset.mem_univ i)).symm
    refine this.trans ?_
    congr 1
    ring
  have hoff_ge : -(∑ i, c i ^ 2 * ∑ j ∈ Finset.univ.erase i, |R i j|) ≤
      ∑ i, ∑ j ∈ Finset.univ.erase i, c i * R i j * c j := by
    have hterm : ∀ i (j : Fin N),
        -(|R i j| * c i ^ 2 + |R i j| * c j ^ 2) ≤ 2 * (c i * R i j * c j) := fun i j => by
      have habs : -(2 * |c i| * |c j| * |R i j|) ≤ 2 * (c i * R i j * c j) := by
        have := neg_abs_le (c i * R i j * c j)
        rw [abs_mul, abs_mul] at this
        linarith
      have hsq : 2 * |c i| * |c j| ≤ c i ^ 2 + c j ^ 2 := by
        have := sq_nonneg (|c i| - |c j|)
        rw [sub_sq, sq_abs, sq_abs] at this
        linarith
      have hm := mul_le_mul_of_nonneg_right hsq (abs_nonneg (R i j))
      linarith
    have h2 : -((∑ i, ∑ j ∈ Finset.univ.erase i, |R i j| * c i ^ 2) +
          ∑ i, ∑ j ∈ Finset.univ.erase i, |R i j| * c j ^ 2) ≤
        2 * ∑ i, ∑ j ∈ Finset.univ.erase i, c i * R i j * c j := by
      rw [← Finset.sum_add_distrib, ← Finset.sum_neg_distrib, Finset.mul_sum]
      refine Finset.sum_le_sum fun i _ => ?_
      rw [← Finset.sum_add_distrib, ← Finset.sum_neg_distrib, Finset.mul_sum]
      exact Finset.sum_le_sum fun j _ => hterm i j
    have hsym_sum : (∑ i, ∑ j ∈ Finset.univ.erase i, |R i j| * c j ^ 2) =
        ∑ i, ∑ j ∈ Finset.univ.erase i, |R i j| * c i ^ 2 := by
      have he1 : ∀ i, (∑ j ∈ Finset.univ.erase i, |R i j| * c j ^ 2) =
          ∑ j, (if j = i then 0 else |R i j| * c j ^ 2) := fun i => by
        have := Finset.add_sum_erase Finset.univ
          (fun j => if j = i then 0 else |R i j| * c j ^ 2) (Finset.mem_univ i)
        rw [if_pos rfl, zero_add] at this
        exact (Finset.sum_congr rfl fun j hj =>
          (if_neg (Finset.ne_of_mem_erase hj)).symm).trans this
      have he2 : ∀ i, (∑ j ∈ Finset.univ.erase i, |R i j| * c i ^ 2) =
          ∑ j, (if j = i then 0 else |R i j| * c i ^ 2) := fun i => by
        have := Finset.add_sum_erase Finset.univ
          (fun j => if j = i then 0 else |R i j| * c i ^ 2) (Finset.mem_univ i)
        rw [if_pos rfl, zero_add] at this
        exact (Finset.sum_congr rfl fun j hj =>
          (if_neg (Finset.ne_of_mem_erase hj)).symm).trans this
      simp_rw [he1, he2]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun i _ => ?_
      by_cases hij : i = j
      · subst hij; simp
      · have hji : j ≠ i := Ne.symm hij
        rw [if_neg hji, if_neg hij, hR_symm j i]
    have hpull : (∑ i, ∑ j ∈ Finset.univ.erase i, |R i j| * c i ^ 2) =
        ∑ i, c i ^ 2 * ∑ j ∈ Finset.univ.erase i, |R i j| :=
      Finset.sum_congr rfl fun i _ => by
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl fun j _ => mul_comm _ _
    linarith
  have hdiag_ge : (∑ i, c i ^ 2 * ∑ j ∈ Finset.univ.erase i, |R i j|) ≤ ∑ i, c i ^ 2 * R i i :=
    Finset.sum_le_sum fun i _ => mul_le_mul_of_nonneg_left (hdom i) (sq_nonneg (c i))
  linarith

/-! ## Section 4: Even `fullZeroForm` Spectral Bridge and Selectivity Witness -/

/-- For an even real compactly supported function `F`, `paperFT (↑F)` on the real axis is the real
cosine transform `∫ x, F x * cos(r * x)`. -/
theorem paperFT_ofReal_even_eq_cos_integral {F : ℝ → ℝ} (hF : Continuous F)
    (hFc : HasCompactSupport F) (heven : ∀ x, F (-x) = F x) (r : ℝ) :
    paperFT (fun x => (F x : ℂ)) (r : ℂ) = ((∫ x, F x * Real.cos (r * x) : ℝ) : ℂ) := by
  unfold paperFT
  have hi1 : Integrable fun x : ℝ => F x * Real.cos (r * x) :=
    (hF.mul (by fun_prop)).integrable_of_hasCompactSupport hFc.mul_right
  have hi2 : Integrable fun x : ℝ => F x * Real.sin (r * x) :=
    (hF.mul (by fun_prop)).integrable_of_hasCompactSupport hFc.mul_right
  have hodd : (∫ x, F x * Real.sin (r * x)) = 0 := by
    have h := MeasureTheory.integral_neg_eq_self (fun x => F x * Real.sin (r * x)) volume
    have hneg : (fun x : ℝ => F (-x) * Real.sin (r * (-x))) =
        fun x => -(F x * Real.sin (r * x)) := by
      funext x
      rw [heven x, mul_neg, Real.sin_neg]
      ring
    rw [hneg, integral_neg] at h
    linarith
  have hexp : ∀ x : ℝ, (F x : ℂ) * Complex.exp (I * (r : ℂ) * (x : ℂ)) =
      ((F x * Real.cos (r * x) : ℝ) : ℂ) + I * ((F x * Real.sin (r * x) : ℝ) : ℂ) := fun x => by
    rw [show I * (r : ℂ) * (x : ℂ) = ((r * x : ℝ) : ℂ) * I by push_cast; ring,
      Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin]
    push_cast
    ring
  have hi1c : Integrable (fun u : ℝ => ((F u * Real.cos (r * u) : ℝ) : ℂ)) volume := hi1.ofReal
  have hi2c : Integrable (fun u : ℝ => I * ((F u * Real.sin (r * u) : ℝ) : ℂ)) volume :=
    hi2.ofReal.const_mul I
  simp_rw [hexp]
  rw [integral_add hi1c hi2c, integral_const_mul,
    integral_complex_ofReal, integral_complex_ofReal, hodd]
  simp

theorem intervalIntegral_congr_Ioo {a b : ℝ} (hab : a ≤ b) {f g : ℝ → ℝ}
    (h : ∀ x, a < x → x < b → f x = g x) :
    (∫ x in a..b, f x) = ∫ x in a..b, g x := by
  refine intervalIntegral.integral_congr_ae ?_
  have hne : ∀ᵐ x : ℝ ∂volume, x ≠ b := by
    rw [ae_iff]
    simp
  filter_upwards [hne] with x hxb hx
  rw [Set.uIoc_of_le hab] at hx
  exact h x hx.1 (lt_of_le_of_ne hx.2 hxb)

/-- Spectral lower bound for `π * fullZeroForm F` on any even `F ∈ C²_c([−181/500, 181/500])`
from an upper envelope `W` of `577/800 − (γ(r) − √2 log 2 cos(r log 2))` supported on `[0, 69/2]`. -/
theorem pi_mul_fullZeroForm_even_ge_of_envelope {F W : ℝ → ℝ}
    (hF : ContDiff ℝ 2 F) (hFc : HasCompactSupport F)
    (heven : ∀ x, F (-x) = F x) (hsupp : ∀ x, 181 / 500 < |x| → F x = 0)
    (hW_meas : Measurable W)
    (hW_bdd : ∀ r, |W r| ≤ 15 / 2)
    (hW_supp : ∀ r, 69 / 2 < r → W r = 0)
    (hW_env : ∀ r, 0 ≤ r →
      577 / 800 - W r ≤ EF.gammaBracket r - Real.sqrt 2 * Real.log 2 * Real.cos (r * Real.log 2)) :
    2 * Real.pi * evenPoleMoment F ^ 2 +
        (577 / 800) * Real.pi * (∫ x, F x ^ 2) -
        (∫ r in (0 : ℝ)..(69 / 2), (∫ x, F x * Real.cos (r * x)) ^ 2 * W r) ≤
      Real.pi * fullZeroForm F := by
  let Fc : ℝ → ℂ := fun x => (F x : ℂ)
  have hFd : ContDiff ℝ 2 Fc := Complex.ofRealCLM.contDiff.comp hF
  have hFc' : HasCompactSupport Fc := hFc.comp_left Complex.ofReal_zero
  have hsupp_c : tsupport Fc ⊆ Icc (-(181 / 500)) (181 / 500) := by
    refine closure_minimal (fun x hx => ?_) isClosed_Icc
    by_contra hxI
    have hx' : 181 / 500 < |x| := by
      rw [mem_Icc, not_and_or, not_le, not_le] at hxI
      rcases hxI with h | h
      · rw [abs_of_neg (by linarith)]; linarith
      · rw [abs_of_pos (by linarith)]; exact h
    exact hx (by simp [Fc, hsupp x hx'])
  have hk_supp : tsupport (EF.weilTest Fc Fc) ⊆ Icc (-(181 / 500 + 181 / 500)) (181 / 500 + 181 / 500) :=
    tsupport_weilTest_subset_add hsupp_c hsupp_c
  have hB3 : (181 / 500 + 181 / 500 : ℝ) < Real.log 3 := by
    rw [Real.lt_log_iff_exp_lt (by norm_num)]
    have he1 := Real.exp_le_exp.mpr (by norm_num : (181 / 500 + 181 / 500 : ℝ) ≤ 1)
    linarith [Real.exp_one_lt_d9]
  have hodd0 : oddPoleMoment F = 0 := by
    unfold oddPoleMoment
    have h := MeasureTheory.integral_neg_eq_self (fun x => F x * Real.sinh (x / 2)) volume
    have hneg : (fun x : ℝ => F (-x) * Real.sinh (-x / 2)) =
        fun x => -(F x * Real.sinh (x / 2)) := by
      funext x
      rw [heven x, show -x / 2 = -(x / 2) by ring, Real.sinh_neg]
      ring
    rw [hneg, integral_neg] at h
    linarith
  have hplanch := integral_norm_paperFT_sq hFd hsupp_c
  have hcos2 := integral_normSq_paperFT_mul_cos_eq hFd hsupp_c (Real.log 2)
  have hintcos2 := integrable_normSq_paperFT_mul_cos hFd hsupp_c (Real.log 2)
  have hsq : Integrable fun r : ℝ => ‖paperFT Fc r‖ ^ 2 := by
    simpa using integrable_normSq_paperFT_mul_cos hFd hsupp_c 0
  have hint_gb := LebesgueAtomWeil.integrable_paperFT_weilTest_mul_gammaBracket hFd hFc' hFd hFc'
  have hreal_gb : ∀ r : ℝ, paperFT (EF.weilTest Fc Fc) r * (EF.gammaBracket r : ℂ) =
      ((‖paperFT Fc r‖ ^ 2 * EF.gammaBracket r : ℝ) : ℂ) := fun r => by
    rw [paperFT_weilTest_self_ofReal hFd.continuous hFc' r]
    push_cast
    ring
  have hintR_gb : Integrable fun r : ℝ => ‖paperFT Fc r‖ ^ 2 * EF.gammaBracket r :=
    hint_gb.re.congr (Eventually.of_forall fun r => by simp only; rw [hreal_gb r]; exact Complex.ofReal_re _)
  have h0_eq : (weilFullFunctional 0 (EF.weilTest Fc Fc)).re =
      (weilPoleTerm (EF.weilTest Fc Fc)).re +
        (1 / (2 * Real.pi)) * ∫ r : ℝ, ‖paperFT Fc r‖ ^ 2 * EF.gammaBracket r := by
    unfold weilFullFunctional weilPoleTerm
    have hts : (∑' n : ℕ, ((if 2 ≤ n then (0 : ℕ → ℝ) n / Real.sqrt n else 0 : ℝ) : ℂ) *
        (EF.weilTest Fc Fc (Real.log n) + EF.weilTest Fc Fc (-Real.log n))) = 0 := by
      simp [zero_div]
    have hint_eq : (∫ r : ℝ, paperFT (EF.weilTest Fc Fc) r * (EF.gammaBracket r : ℂ)) =
        ((∫ r : ℝ, ‖paperFT Fc r‖ ^ 2 * EF.gammaBracket r : ℝ) : ℂ) := by
      simp_rw [hreal_gb]
      exact integral_complex_ofReal
    rw [hts, sub_zero, hint_eq, Complex.add_re]
    congr 1
    have hc : (1 / (2 * (Real.pi : ℂ))) *
        ((∫ r : ℝ, ‖paperFT Fc r‖ ^ 2 * EF.gammaBracket r : ℝ) : ℂ) =
        (((1 / (2 * Real.pi)) * ∫ r : ℝ, ‖paperFT Fc r‖ ^ 2 * EF.gammaBracket r : ℝ) : ℂ) := by
      push_cast; ring
    rw [hc, Complex.ofReal_re]
  have hsub2 := congrArg Complex.re
    (weilFullFunctional_sub_eq_atom_two hk_supp hB3
      (fun n => (ArithmeticFunction.vonMangoldt n : ℝ)) 0)
  rw [Complex.sub_re, Complex.re_ofReal_mul, h0_eq,
    weilPoleTerm_ofReal_eq_lorentz_moments hF.continuous hFc, hodd0] at hsub2
  have hΛ2 : ((0 : ℕ → ℝ) 2 - (ArithmeticFunction.vonMangoldt 2 : ℝ)) / Real.sqrt 2 =
      -(Real.log 2 / Real.sqrt 2) := by
    rw [Pi.zero_apply, ArithmeticFunction.vonMangoldt_apply_prime Nat.prime_two]
    ring
  rw [hΛ2] at hsub2
  have hpi_ne : (Real.pi : ℝ) ≠ 0 := Real.pi_ne_zero
  have hpi_pos : (0 : ℝ) < Real.pi := Real.pi_pos
  have hk2_eq : -(Real.log 2 / Real.sqrt 2) *
      (EF.weilTest Fc Fc (Real.log 2) + EF.weilTest Fc Fc (-Real.log 2)).re =
      -(1 / (2 * Real.pi)) *
        ∫ r : ℝ, ‖paperFT Fc r‖ ^ 2 * (Real.sqrt 2 * Real.log 2 * Real.cos (r * Real.log 2)) := by
    have hmul : (∫ r : ℝ, ‖paperFT Fc r‖ ^ 2 * (Real.sqrt 2 * Real.log 2 * Real.cos (r * Real.log 2))) =
        (Real.sqrt 2 * Real.log 2) * ∫ r : ℝ, ‖paperFT Fc r‖ ^ 2 * Real.cos (r * Real.log 2) := by
      rw [← integral_const_mul]
      exact integral_congr_ae (Eventually.of_forall fun r => by ring)
    rw [hmul, hcos2]
    have hs2 : Real.sqrt 2 ≠ 0 := by positivity
    field_simp [hpi_ne, hs2]
    rw [Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)]
    ring
  have hfzf_eq : Real.pi * fullZeroForm F =
      2 * Real.pi * evenPoleMoment F ^ 2 +
        1 / 2 * ∫ r : ℝ, ‖paperFT Fc r‖ ^ 2 *
          (EF.gammaBracket r - Real.sqrt 2 * Real.log 2 * Real.cos (r * Real.log 2)) := by
    rw [fullZeroForm_eq_re_weilFullFunctional hF.continuous hFc]
    have hint_trig : Integrable fun r : ℝ =>
        ‖paperFT Fc r‖ ^ 2 * (Real.sqrt 2 * Real.log 2 * Real.cos (r * Real.log 2)) := by
      refine (hintcos2.const_mul (Real.sqrt 2 * Real.log 2)).congr (Eventually.of_forall fun r => ?_)
      simp only; ring
    have hint_diff : (∫ r : ℝ, ‖paperFT Fc r‖ ^ 2 * EF.gammaBracket r) -
        (∫ r : ℝ, ‖paperFT Fc r‖ ^ 2 * (Real.sqrt 2 * Real.log 2 * Real.cos (r * Real.log 2))) =
        ∫ r : ℝ, ‖paperFT Fc r‖ ^ 2 *
          (EF.gammaBracket r - Real.sqrt 2 * Real.log 2 * Real.cos (r * Real.log 2)) := by
      rw [← integral_sub hintR_gb hint_trig]
      exact integral_congr_ae (Eventually.of_forall fun r => by ring)
    have h1 : (weilFullFunctional (fun n => (ArithmeticFunction.vonMangoldt n : ℝ))
        (EF.weilTest Fc Fc)).re =
        2 * evenPoleMoment F ^ 2 +
          (1 / (2 * Real.pi)) * ∫ r : ℝ, ‖paperFT Fc r‖ ^ 2 *
            (EF.gammaBracket r - Real.sqrt 2 * Real.log 2 * Real.cos (r * Real.log 2)) := by
      have hcomb : (1 / (2 * Real.pi)) * (∫ r : ℝ, ‖paperFT Fc r‖ ^ 2 * EF.gammaBracket r) -
          (1 / (2 * Real.pi)) *
            (∫ r : ℝ, ‖paperFT Fc r‖ ^ 2 * (Real.sqrt 2 * Real.log 2 * Real.cos (r * Real.log 2))) =
          (1 / (2 * Real.pi)) * ∫ r : ℝ, ‖paperFT Fc r‖ ^ 2 *
            (EF.gammaBracket r - Real.sqrt 2 * Real.log 2 * Real.cos (r * Real.log 2)) := by
        rw [← mul_sub, hint_diff]
      linarith [hsub2, hk2_eq, hcomb]
    rw [h1]
    set Jspec : ℝ := ∫ r : ℝ, ‖paperFT Fc r‖ ^ 2 *
      (EF.gammaBracket r - Real.sqrt 2 * Real.log 2 * Real.cos (r * Real.log 2))
    field_simp [hpi_ne]
  have hW_abs_meas : AEStronglyMeasurable (fun r : ℝ => W (|r|)) volume :=
    (hW_meas.comp continuous_abs.measurable).aestronglyMeasurable
  have hint_Wabs : Integrable fun r : ℝ => ‖paperFT Fc r‖ ^ 2 * W (|r|) := by
    refine Integrable.mono' (hsq.mul_const (15 / 2))
      (hsq.aestronglyMeasurable.mul hW_abs_meas) (Eventually.of_forall fun r => ?_)
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (sq_nonneg _)]
    exact mul_le_mul_of_nonneg_left (hW_bdd (|r|)) (sq_nonneg _)
  have hint_sym : Integrable fun r : ℝ =>
      ‖paperFT Fc r‖ ^ 2 * (EF.gammaBracket r - Real.sqrt 2 * Real.log 2 * Real.cos (r * Real.log 2)) := by
    have hint_trig : Integrable fun r : ℝ =>
        ‖paperFT Fc r‖ ^ 2 * (Real.sqrt 2 * Real.log 2 * Real.cos (r * Real.log 2)) :=
      (hintcos2.const_mul (Real.sqrt 2 * Real.log 2)).congr
        (Eventually.of_forall fun r => by simp only; ring)
    exact (hintR_gb.sub hint_trig).congr (Eventually.of_forall fun r => by dsimp only [Pi.sub_apply]; ring)
  have hpt_all : ∀ r : ℝ,
      ‖paperFT Fc r‖ ^ 2 * (577 / 800 - W (|r|)) ≤
        ‖paperFT Fc r‖ ^ 2 *
          (EF.gammaBracket r - Real.sqrt 2 * Real.log 2 * Real.cos (r * Real.log 2)) := fun r => by
    refine mul_le_mul_of_nonneg_left ?_ (sq_nonneg _)
    have hgb_even : EF.gammaBracket (|r|) = EF.gammaBracket r := by
      rcases le_total 0 r with hr | hr
      · rw [abs_of_nonneg hr]
      · rw [abs_of_nonpos hr, gammaBracket_neg_eq]
    have hcos_even : Real.cos (|r| * Real.log 2) = Real.cos (r * Real.log 2) := by
      rw [← abs_of_pos (Real.log_pos one_lt_two), ← abs_mul, Real.cos_abs, abs_of_pos (Real.log_pos one_lt_two)]
    rw [← hgb_even, ← hcos_even]
    exact hW_env (|r|) (abs_nonneg r)
  have hint_low : Integrable fun r : ℝ => ‖paperFT Fc r‖ ^ 2 * (577 / 800 - W (|r|)) :=
    ((hsq.mul_const (577 / 800)).sub hint_Wabs).congr
      (Eventually.of_forall fun r => by dsimp only [Pi.sub_apply]; ring)
  have hmono := integral_mono hint_low hint_sym hpt_all
  have hlow_split : (∫ r : ℝ, ‖paperFT Fc r‖ ^ 2 * (577 / 800 - W (|r|))) =
      (577 / 800) * (2 * Real.pi * ∫ x, F x ^ 2) - ∫ r : ℝ, ‖paperFT Fc r‖ ^ 2 * W (|r|) := by
    have hnormF : (∫ x, ‖Fc x‖ ^ 2) = ∫ x, F x ^ 2 :=
      integral_congr_ae (Eventually.of_forall fun x => by simp [Fc, Real.norm_eq_abs, sq_abs])
    have heq : (fun r : ℝ => ‖paperFT Fc r‖ ^ 2 * (577 / 800 - W (|r|))) =
        fun r : ℝ => ‖paperFT Fc r‖ ^ 2 * (577 / 800) - ‖paperFT Fc r‖ ^ 2 * W (|r|) := by
      funext r; ring
    rw [heq, integral_sub (hsq.mul_const _) hint_Wabs, integral_mul_const, hplanch, hnormF]
    ring
  have hFT_sq : ∀ r : ℝ, ‖paperFT Fc r‖ ^ 2 = (∫ x, F x * Real.cos (r * x)) ^ 2 := fun r => by
    rw [paperFT_ofReal_even_eq_cos_integral hF.continuous hFc heven r, Complex.norm_real,
      Real.norm_eq_abs, sq_abs]
  have hfold_W : (∫ r : ℝ, ‖paperFT Fc r‖ ^ 2 * W (|r|)) =
      2 * ∫ r in (0 : ℝ)..(69 / 2), (∫ x, F x * Real.cos (r * x)) ^ 2 * W r := by
    set B : ℝ := 69 / 2 + 1
    have hvan : ∀ r : ℝ, r ∉ Ioc (-B) B → ‖paperFT Fc r‖ ^ 2 * W (|r|) = 0 := fun r hr => by
      have hgt : 69 / 2 < |r| := by
        by_contra hle
        push Not at hle
        have hr' := abs_le.mp hle
        dsimp [B] at hr
        exact hr ⟨by linarith [hr'.1], by linarith [hr'.2]⟩
      rw [hW_supp (|r|) hgt, mul_zero]
    rw [← setIntegral_eq_integral_of_forall_compl_eq_zero hvan,
      ← intervalIntegral.integral_of_le (by dsimp [B]; norm_num : -B ≤ B)]
    have hi_int : ∀ a b : ℝ, IntervalIntegrable (fun r => ‖paperFT Fc r‖ ^ 2 * W (|r|)) volume a b :=
      fun a b => hint_Wabs.intervalIntegrable
    rw [← intervalIntegral.integral_add_adjacent_intervals (hi_int (-B) 0) (hi_int 0 B)]
    have hneg_half : (∫ r in (-B)..0, ‖paperFT Fc r‖ ^ 2 * W (|r|)) =
        ∫ r in (0 : ℝ)..B, ‖paperFT Fc r‖ ^ 2 * W (|r|) := by
      have hc := intervalIntegral.integral_comp_neg (a := -B) (b := 0)
        (fun r => ‖paperFT Fc r‖ ^ 2 * W (|r|))
      simp only [neg_zero, neg_neg] at hc
      rw [← hc]
      refine intervalIntegral.integral_congr fun r _ => ?_
      simp only [hFT_sq, abs_neg]
      congr 2
      exact integral_congr_ae (Eventually.of_forall fun x => by
        change F x * Real.cos (r * x) = F x * Real.cos (-r * x)
        rw [neg_mul, Real.cos_neg])
    rw [hneg_half, ← two_mul,
      ← intervalIntegral.integral_add_adjacent_intervals (hi_int 0 (69 / 2)) (hi_int (69 / 2) B)]
    have htail0 : (∫ r in (69 / 2 : ℝ)..B, ‖paperFT Fc r‖ ^ 2 * W (|r|)) = 0 := by
      rw [intervalIntegral_congr_Ioo (g := fun _ => 0) (by dsimp [B]; norm_num) fun r hr _ => by
        rw [abs_of_pos (by linarith), hW_supp r hr, mul_zero]]
      simp
    rw [htail0, add_zero]
    congr 1
    refine intervalIntegral.integral_congr fun r hr => ?_
    have hr0 : 0 ≤ r := (Set.uIcc_of_le (by norm_num : (0 : ℝ) ≤ 69 / 2) ▸ hr).1
    rw [hFT_sq, abs_of_nonneg hr0]
  rw [hlow_split, hfold_W] at hmono
  rw [hfzf_eq]
  linarith

/-- Smooth even two-bump test `narrowBump 50 (x + (log 2)/2) + narrowBump 50 (x − (log 2)/2)`,
supported in `[−181/500, 181/500]` with strictly positive autocorrelation at `log 2`. -/
def evenShiftedBumpWitness (x : ℝ) : ℝ :=
  WeilOneSided.narrowBump 50 (x + Real.log 2 / 2) + WeilOneSided.narrowBump 50 (x - Real.log 2 / 2)

theorem evenShiftedBumpWitness_properties :
    ContDiff ℝ 2 evenShiftedBumpWitness ∧
      HasCompactSupport evenShiftedBumpWitness ∧
      (∀ x, evenShiftedBumpWitness (-x) = evenShiftedBumpWitness x) ∧
      (∀ x, 181 / 500 < |x| → evenShiftedBumpWitness x = 0) ∧
      0 < ∫ x, evenShiftedBumpWitness x ^ 2 ∧
      0 < (EF.weilTest (fun x => (evenShiftedBumpWitness x : ℂ))
            (fun x => (evenShiftedBumpWitness x : ℂ)) (Real.log 2) +
          EF.weilTest (fun x => (evenShiftedBumpWitness x : ℂ))
            (fun x => (evenShiftedBumpWitness x : ℂ)) (-Real.log 2)).re := by
  have hb_cd : ContDiff ℝ 2 (WeilOneSided.narrowBump 50) :=
    (WeilOneSided.narrowBump 50).contDiff.of_le (by norm_cast)
  have hb_cs : HasCompactSupport (WeilOneSided.narrowBump 50) :=
    (WeilOneSided.narrowBump 50).hasCompactSupport
  have hb_even : ∀ t : ℝ, WeilOneSided.narrowBump 50 (-t) = WeilOneSided.narrowBump 50 t :=
    fun t => ContDiffBump.neg (WeilOneSided.narrowBump 50) t
  have hb_nonneg : ∀ t : ℝ, 0 ≤ WeilOneSided.narrowBump 50 t :=
    fun t => (WeilOneSided.narrowBump 50).nonneg' t
  have hb_zero : ∀ {t : ℝ}, 1 / 204 < |t| → WeilOneSided.narrowBump 50 t = 0 := fun {t} ht => by
    refine (WeilOneSided.narrowBump 50).zero_of_le_dist ?_
    rw [Real.dist_eq, sub_zero]
    change 1 / (4 * ((50 : ℝ) + 1)) ≤ |t|
    norm_num
    exact ht.le
  have hcd : ContDiff ℝ 2 evenShiftedBumpWitness := by
    unfold evenShiftedBumpWitness
    exact (hb_cd.comp (contDiff_id.add contDiff_const)).add
      (hb_cd.comp (contDiff_id.sub contDiff_const))
  have hsupp : ∀ x, 181 / 500 < |x| → evenShiftedBumpWitness x = 0 := fun x hx => by
    have hl2_lo := Real.log_two_gt_d9
    have hl2_hi := Real.log_two_lt_d9
    norm_num at hl2_lo hl2_hi
    unfold evenShiftedBumpWitness
    have h1 : 1 / 204 < |x + Real.log 2 / 2| := by
      rcases lt_or_gt_of_ne (by intro h; rw [h, abs_zero] at hx; linarith : x ≠ 0) with hn | hp
      · rw [abs_of_neg hn] at hx
        rw [abs_of_neg (by linarith)]
        linarith
      · rw [abs_of_pos hp] at hx
        rw [abs_of_pos (by linarith)]
        linarith
    have h2 : 1 / 204 < |x - Real.log 2 / 2| := by
      rcases lt_or_gt_of_ne (by intro h; rw [h, abs_zero] at hx; linarith : x ≠ 0) with hn | hp
      · rw [abs_of_neg hn] at hx
        rw [abs_of_neg (by linarith)]
        linarith
      · rw [abs_of_pos hp] at hx
        rw [abs_of_pos (by linarith)]
        linarith
    rw [hb_zero h1, hb_zero h2, add_zero]
  have hcs : HasCompactSupport evenShiftedBumpWitness :=
    HasCompactSupport.intro (isCompact_closedBall 0 (181 / 500)) fun x hx =>
      hsupp x (by rw [Metric.mem_closedBall, dist_zero_right, Real.norm_eq_abs, not_le] at hx; exact hx)
  have heven : ∀ x, evenShiftedBumpWitness (-x) = evenShiftedBumpWitness x := fun x => by
    unfold evenShiftedBumpWitness
    rw [show -x + Real.log 2 / 2 = -(x - Real.log 2 / 2) by ring,
      show -x - Real.log 2 / 2 = -(x + Real.log 2 / 2) by ring, hb_even, hb_even, add_comm]
  have hsq_pos : 0 < ∫ x, evenShiftedBumpWitness x ^ 2 := by
    refine (hcd.continuous.pow 2).integral_pos_of_hasCompactSupport_nonneg_nonzero
      (hasCompactSupport_sq hcs)
      (fun x => sq_nonneg _) (x := Real.log 2 / 2) ?_
    unfold evenShiftedBumpWitness
    rw [sub_self, (WeilOneSided.narrowBump 50).one_of_mem_closedBall
      (Metric.mem_closedBall_self (WeilOneSided.narrowBump 50).rIn_pos.le)]
    have h0 := hb_nonneg (Real.log 2 / 2 + Real.log 2 / 2)
    have hpos1 : ∀ u : ℝ, 0 ≤ u → (u + 1) ^ 2 ≠ 0 := fun u hu => by positivity
    exact hpos1 _ h0
  refine ⟨hcd, hcs, heven, hsupp, hsq_pos, ?_⟩
  have hwt_acorr : ∀ y : ℝ,
      (EF.weilTest (fun x => (evenShiftedBumpWitness x : ℂ))
        (fun x => (evenShiftedBumpWitness x : ℂ)) y).re =
      acorr evenShiftedBumpWitness y := fun y => by
    have h := (_root_.RHTower.ArchimedeanExactForm.autocorr_eq_weilTest evenShiftedBumpWitness (-y)).symm
    rw [neg_neg, _root_.RHTower.ArchimedeanExactForm.autocorr_neg] at h
    exact (congrArg Complex.re h).trans (Complex.ofReal_re _)
  rw [Complex.add_re, hwt_acorr (Real.log 2), hwt_acorr (-Real.log 2)]
  change 0 < (∫ x, evenShiftedBumpWitness x * evenShiftedBumpWitness (x + Real.log 2)) +
      ∫ x, evenShiftedBumpWitness x * evenShiftedBumpWitness (x + -Real.log 2)
  have hprod_ge : ∀ u v w : ℝ, 0 ≤ u → 0 ≤ v → 0 ≤ w → v ^ 2 ≤ (u + v) * (v + w) :=
    fun u v w hu hv hw => by nlinarith
  have hcs_b2 : HasCompactSupport fun x : ℝ => (WeilOneSided.narrowBump 50 (x - Real.log 2 / 2)) ^ 2 := by
    refine HasCompactSupport.intro (isCompact_closedBall 0 1) fun x hx => ?_
    rw [Metric.mem_closedBall, dist_zero_right, Real.norm_eq_abs, not_le] at hx
    have hl2_lo := Real.log_two_gt_d9
    have hl2_hi := Real.log_two_lt_d9
    norm_num at hl2_lo hl2_hi
    have hgt : 1 / 204 < |x - Real.log 2 / 2| := by
      rcases lt_or_gt_of_ne (by intro h; rw [h, abs_zero] at hx; linarith : x ≠ 0) with hn | hp
      · rw [abs_of_neg hn] at hx; rw [abs_of_neg (by linarith)]; linarith
      · rw [abs_of_pos hp] at hx; rw [abs_of_pos (by linarith)]; linarith
    simp [hb_zero hgt]
  have hint_b2 : Integrable fun x : ℝ => (WeilOneSided.narrowBump 50 (x - Real.log 2 / 2)) ^ 2 :=
    (((WeilOneSided.narrowBump 50).continuous.comp (continuous_id.sub continuous_const)).pow 2).integrable_of_hasCompactSupport
      hcs_b2
  have hge1 : 0 ≤ ∫ x, evenShiftedBumpWitness x * evenShiftedBumpWitness (x + Real.log 2) :=
    integral_nonneg fun x => mul_nonneg
      (add_nonneg (hb_nonneg _) (hb_nonneg _)) (add_nonneg (hb_nonneg _) (hb_nonneg _))
  have hint_w2 : Integrable fun x : ℝ =>
      evenShiftedBumpWitness x * evenShiftedBumpWitness (x + -Real.log 2) :=
    (hcd.continuous.mul (hcd.continuous.comp (continuous_id.add continuous_const))).integrable_of_hasCompactSupport
      hcs.mul_right
  have hge2 : (∫ t, (WeilOneSided.narrowBump 50 t) ^ 2) ≤
      ∫ x, evenShiftedBumpWitness x * evenShiftedBumpWitness (x + -Real.log 2) := by
    have hshift : (∫ x, (WeilOneSided.narrowBump 50 (x - Real.log 2 / 2)) ^ 2) =
        ∫ t, (WeilOneSided.narrowBump 50 t) ^ 2 :=
      integral_sub_right_eq_self (fun t => (WeilOneSided.narrowBump 50 t) ^ 2) (Real.log 2 / 2)
    rw [← hshift]
    refine integral_mono hint_b2 hint_w2 fun x => ?_
    change (WeilOneSided.narrowBump 50 (x - Real.log 2 / 2)) ^ 2 ≤
      (WeilOneSided.narrowBump 50 (x + Real.log 2 / 2) +
        WeilOneSided.narrowBump 50 (x - Real.log 2 / 2)) *
      (WeilOneSided.narrowBump 50 ((x + -Real.log 2) + Real.log 2 / 2) +
        WeilOneSided.narrowBump 50 ((x + -Real.log 2) - Real.log 2 / 2))
    rw [show (x + -Real.log 2) + Real.log 2 / 2 = x - Real.log 2 / 2 by ring]
    exact hprod_ge _ _ _ (hb_nonneg _) (hb_nonneg _) (hb_nonneg _)
  have hpos_int := WeilOneSided.integral_narrowBump_sq_pos 50
  linarith


/-! ## Section 5: Refutation of the Liouville-Twisted Odd Window on `[−181/500, 181/500]` -/

/-- Nine positive rational knots inside `[0, 180999/500000]` for the odd clamp witness. -/
def knotsQ2A : Fin 9 → ℝ
  | ⟨0, _⟩ => (3 / 25 : ℝ)
  | ⟨1, _⟩ => (6 / 25 : ℝ)
  | ⟨2, _⟩ => (207 / 625 : ℝ)
  | ⟨3, _⟩ => (3497 / 10000 : ℝ)
  | ⟨4, _⟩ => (3571 / 10000 : ℝ)
  | ⟨5, _⟩ => (9 / 25 : ℝ)
  | ⟨6, _⟩ => (903 / 2500 : ℝ)
  | ⟨7, _⟩ => (4521 / 12500 : ℝ)
  | ⟨8, _⟩ => (180999 / 500000 : ℝ)

/-- Balanced rational weights (`∑ c_j a_j = 0`) for the odd clamp witness. -/
def coeffsQ2A : Fin 9 → ℝ
  | ⟨0, _⟩ => (61 / 250 : ℝ)
  | ⟨1, _⟩ => (77 / 250 : ℝ)
  | ⟨2, _⟩ => (-83 / 1000 : ℝ)
  | ⟨3, _⟩ => (311 / 250 : ℝ)
  | ⟨4, _⟩ => (127 / 500 : ℝ)
  | ⟨5, _⟩ => (347 / 125 : ℝ)
  | ⟨6, _⟩ => (-1288 / 125 : ℝ)
  | ⟨7, _⟩ => (59257 / 500 : ℝ)
  | ⟨8, _⟩ => (-8705799 / 77350 : ℝ)

/-- Unsmoothed witness support radius `180999 / 500000 < 181 / 500`. -/
def radiusQ2A : ℝ := (180999 / 500000 : ℝ)

/-- Piecewise-linear odd clamp witness supported in `[−radiusQ2A, radiusQ2A]`. -/
def oddClampWitnessFun (x : ℝ) : ℝ := ∑ j : Fin 9, coeffsQ2A j * oddClamp (knotsQ2A j) x

private theorem sum_fin9 (f : Fin 9 → ℝ) :
    (∑ i : Fin 9, f i) = f ⟨0, by omega⟩ + f ⟨1, by omega⟩ + f ⟨2, by omega⟩ + f ⟨3, by omega⟩ + f ⟨4, by omega⟩ + f ⟨5, by omega⟩ + f ⟨6, by omega⟩ + f ⟨7, by omega⟩ + f ⟨8, by omega⟩ := by
  simp only [Fin.sum_univ_succ, Fin.sum_univ_zero, add_zero, ← add_assoc]
  rfl

private theorem knotsQ2A_bounds (j : Fin 9) : 0 ≤ knotsQ2A j ∧ knotsQ2A j ≤ radiusQ2A := by
  fin_cases j <;> simp [knotsQ2A, radiusQ2A] <;> norm_num

private theorem coeffsQ2A_balanced : ∑ j : Fin 9, coeffsQ2A j * knotsQ2A j = 0 := by
  rw [sum_fin9]
  dsimp [coeffsQ2A, knotsQ2A]
  norm_num

private theorem oddClampWitnessFun_neg (x : ℝ) : oddClampWitnessFun (-x) = -oddClampWitnessFun x := by
  unfold oddClampWitnessFun
  simp_rw [oddClamp_neg, mul_neg, Finset.sum_neg_distrib]

private theorem oddClampWitnessFun_eq_zero_of_lt {x : ℝ} (hx : radiusQ2A < |x|) :
    oddClampWitnessFun x = 0 := by
  unfold oddClampWitnessFun
  rcases lt_or_gt_of_ne (by intro h; rw [h, abs_zero] at hx; norm_num [radiusQ2A] at hx : x ≠ 0) with hneg | hpos
  · rw [abs_of_neg hneg] at hx
    have hle : ∀ j : Fin 9, oddClamp (knotsQ2A j) x = -knotsQ2A j := fun j =>
      oddClamp_of_le_neg (knotsQ2A_bounds j).1 (by linarith [(knotsQ2A_bounds j).2])
    simp_rw [hle, mul_neg, Finset.sum_neg_distrib, coeffsQ2A_balanced, neg_zero]
  · rw [abs_of_pos hpos] at hx
    have hge : ∀ j : Fin 9, oddClamp (knotsQ2A j) x = knotsQ2A j := fun j =>
      oddClamp_of_ge (knotsQ2A_bounds j).1 (by linarith [(knotsQ2A_bounds j).2])
    simp_rw [hge]
    exact coeffsQ2A_balanced

private theorem abs_oddClampWitnessFun_le (x : ℝ) : |oddClampWitnessFun x| ≤ (1112310843 / 12500000 : ℝ) := by
  unfold oddClampWitnessFun
  refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
  have hterm : ∀ j : Fin 9, |coeffsQ2A j * oddClamp (knotsQ2A j) x| ≤ |coeffsQ2A j| * knotsQ2A j := fun j => by
    rw [abs_mul]
    exact mul_le_mul_of_nonneg_left (abs_oddClamp_le (knotsQ2A_bounds j).1 x) (abs_nonneg _)
  refine (Finset.sum_le_sum fun j _ => hterm j).trans ?_
  rw [sum_fin9]
  dsimp [coeffsQ2A, knotsQ2A]
  norm_num

private theorem lipschitz_oddClampWitnessFun (u v : ℝ) :
    |oddClampWitnessFun u - oddClampWitnessFun v| ≤ (380991649 / 1547000 : ℝ) * |u - v| := by
  unfold oddClampWitnessFun
  rw [← Finset.sum_sub_distrib]
  refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
  have hterm : ∀ j : Fin 9, |coeffsQ2A j * oddClamp (knotsQ2A j) u - coeffsQ2A j * oddClamp (knotsQ2A j) v| ≤
      |coeffsQ2A j| * |u - v| := fun j => by
    rw [← mul_sub, abs_mul]
    exact mul_le_mul_of_nonneg_left (abs_oddClamp_sub_le (knotsQ2A j) u v) (abs_nonneg _)
  refine (Finset.sum_le_sum fun j _ => hterm j).trans_eq ?_
  rw [← Finset.sum_mul, sum_fin9]
  dsimp [coeffsQ2A]
  norm_num

/-- Compactly supported continuous witness source `oddClampWitnessSource : C_c(ℝ, ℝ)`. -/
def oddClampWitnessSource : C_c(ℝ, ℝ) :=
  ⟨⟨oddClampWitnessFun, by unfold oddClampWitnessFun; fun_prop⟩,
    HasCompactSupport.intro (isCompact_closedBall 0 radiusQ2A) fun x hx =>
      oddClampWitnessFun_eq_zero_of_lt (by
        rw [Metric.mem_closedBall, dist_zero_right, Real.norm_eq_abs, not_le] at hx; exact hx)⟩

private theorem autocorr_oddClampWitness_zero : acorr oddClampWitnessSource 0 = (1316162282962954799227 / 725156250000000000000000 : ℝ) := by
  change acorr oddClampWitnessFun 0 = _
  unfold oddClampWitnessFun
  rw [autocorr_oddClampCombo_eq knotsQ2A coeffsQ2A (by norm_num [radiusQ2A]) knotsQ2A_bounds
    coeffsQ2A_balanced (by norm_num [radiusQ2A])]
  simp_rw [sum_fin9]
  dsimp [coeffsQ2A, knotsQ2A]
  norm_num

private theorem autocorr_l2_row_0 {x : ℝ}
    (hx_lo : (6931471803 / 10000000000 : ℝ) ≤ x) :
    -(∑ k : Fin 9, coeffsQ2A ⟨0, by omega⟩ * coeffsQ2A k / 12 *
      (|x + knotsQ2A ⟨0, by omega⟩ + knotsQ2A k| ^ 3 +
        |x - knotsQ2A ⟨0, by omega⟩ - knotsQ2A k| ^ 3 -
        |x + knotsQ2A ⟨0, by omega⟩ - knotsQ2A k| ^ 3 -
        |x - knotsQ2A ⟨0, by omega⟩ + knotsQ2A k| ^ 3)) =
      (0 : ℝ) + (0 : ℝ) * x + (0 : ℝ) * x ^ 2 + (0 : ℝ) * x ^ 3 := by
  have ha_0_0 : |x + (3 / 25 : ℝ) + (3 / 25 : ℝ)| = x + (3 / 25 : ℝ) + (3 / 25 : ℝ) := abs_of_pos (by linarith only [hx_lo])
  have ha_0_1 : |x - (3 / 25 : ℝ) - (3 / 25 : ℝ)| = x - (3 / 25 : ℝ) - (3 / 25 : ℝ) := abs_of_pos (by linarith only [hx_lo])
  have ha_0_2 : |x + (3 / 25 : ℝ) - (3 / 25 : ℝ)| = x + (3 / 25 : ℝ) - (3 / 25 : ℝ) := abs_of_pos (by linarith only [hx_lo])
  have ha_0_3 : |x - (3 / 25 : ℝ) + (3 / 25 : ℝ)| = x - (3 / 25 : ℝ) + (3 / 25 : ℝ) := abs_of_pos (by linarith only [hx_lo])
  have ha_1_0 : |x + (3 / 25 : ℝ) + (6 / 25 : ℝ)| = x + (3 / 25 : ℝ) + (6 / 25 : ℝ) := abs_of_pos (by linarith only [hx_lo])
  have ha_1_1 : |x - (3 / 25 : ℝ) - (6 / 25 : ℝ)| = x - (3 / 25 : ℝ) - (6 / 25 : ℝ) := abs_of_pos (by linarith only [hx_lo])
  have ha_1_2 : |x + (3 / 25 : ℝ) - (6 / 25 : ℝ)| = x + (3 / 25 : ℝ) - (6 / 25 : ℝ) := abs_of_pos (by linarith only [hx_lo])
  have ha_1_3 : |x - (3 / 25 : ℝ) + (6 / 25 : ℝ)| = x - (3 / 25 : ℝ) + (6 / 25 : ℝ) := abs_of_pos (by linarith only [hx_lo])
  have ha_2_0 : |x + (3 / 25 : ℝ) + (207 / 625 : ℝ)| = x + (3 / 25 : ℝ) + (207 / 625 : ℝ) := abs_of_pos (by linarith only [hx_lo])
  have ha_2_1 : |x - (3 / 25 : ℝ) - (207 / 625 : ℝ)| = x - (3 / 25 : ℝ) - (207 / 625 : ℝ) := abs_of_pos (by linarith only [hx_lo])
  have ha_2_2 : |x + (3 / 25 : ℝ) - (207 / 625 : ℝ)| = x + (3 / 25 : ℝ) - (207 / 625 : ℝ) := abs_of_pos (by linarith only [hx_lo])
