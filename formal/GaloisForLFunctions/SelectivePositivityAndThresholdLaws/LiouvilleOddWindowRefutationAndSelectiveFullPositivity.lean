private theorem bEx_err_row_0 (m2 : Fin 23) :
    |bEx ⟨0, by omega⟩ m2 - bMid ⟨0, by omega⟩ m2| ≤ bRad ⟨0, by omega⟩ m2 := by
  refine dot23_vec_err_le
    (fun m1 => qtEx ⟨0, by omega⟩ m1)
    (fun m1 => jNormEx (m1.1 + m2.1))
    (fun m1 => qtMid ⟨0, by omega⟩ m1)
    (fun m1 => qtRad ⟨0, by omega⟩ m1)
    (fun m1 => jMid (m1.1 + m2.1))
    (fun _ => (1 / 10000000000000000 : ℝ))
    (bMid ⟨0, by omega⟩ m2) (bRad ⟨0, by omega⟩ m2)
    (fun m1 => qtEx_err_row_0 m1)
    (fun m1 => jNorm_err_le (m1.1 + m2.1) (by omega)) ?_
  rw [sum_fin23, sum_fin23]
  fin_cases m2 <;>
    (unfold qtMid qtRad jMid bMid bRad; dsimp; norm_num [qtMidRow_0, bMidRow_0, bRadRow_0])

