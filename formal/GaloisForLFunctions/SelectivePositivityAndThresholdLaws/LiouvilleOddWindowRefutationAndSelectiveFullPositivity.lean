  let G2 : ℝ → ℝ := fun x =>
    2 / 3 * x ^ 3 + 6 * s ^ 2 * x - 2 * s ^ 3 * Real.log x +
      (-s ^ 3 * x + (3 * s ^ 2 + s ^ 3 / 12) * x ^ 2 / 2 +
        (-s ^ 2 / 4 + s ^ 3 / 8) * x ^ 3 / 3 +
        (1 - 3 * s ^ 2 / 8 - s ^ 3 / 288) * x ^ 4 / 4 +
        (-1 / 12 + s ^ 2 / 96 - s ^ 3 / 64) * x ^ 5 / 5 +
        (-1 / 8 + 3 * s ^ 2 / 64) * x ^ 6 / 6 +
        (1 / 288) * x ^ 7 / 7 + (1 / 64) * x ^ 8 / 8)
  have hG2 : ∀ x ∈ Set.uIcc s B, HasDerivAt G2 (deltaKerRight s x) x := fun x hx => by
    have hx' := Set.uIcc_of_le hsB ▸ hx
    have hxpos : 0 < x := hs.trans_le hx'.1
    have hdA := (((hasDerivAt_pow 3 x).const_mul (2 / 3 : ℝ)).add
      ((hasDerivAt_id' x).const_mul (6 * s ^ 2))).sub ((Real.hasDerivAt_log hxpos.ne').const_mul (2 * s ^ 3))
    have hdB := (((((((((hasDerivAt_id' x).const_mul (-s ^ 3)).add
      (((hasDerivAt_pow 2 x).const_mul (3 * s ^ 2 + s ^ 3 / 12)).div_const 2)).add
      (((hasDerivAt_pow 3 x).const_mul (-s ^ 2 / 4 + s ^ 3 / 8)).div_const 3)).add
      (((hasDerivAt_pow 4 x).const_mul (1 - 3 * s ^ 2 / 8 - s ^ 3 / 288)).div_const 4)).add
      (((hasDerivAt_pow 5 x).const_mul (-1 / 12 + s ^ 2 / 96 - s ^ 3 / 64)).div_const 5)).add
      (((hasDerivAt_pow 6 x).const_mul (-1 / 8 + 3 * s ^ 2 / 64)).div_const 6)).add
      (((hasDerivAt_pow 7 x).const_mul (1 / 288 : ℝ)).div_const 7)).add
      (((hasDerivAt_pow 8 x).const_mul (1 / 64 : ℝ)).div_const 8))
    refine ((hdA.add hdB).congr_of_eventuallyEq (Eventually.of_forall fun _ => rfl)).congr_deriv ?_
    unfold deltaKerRight
    field_simp [hxpos.ne']
    ring
  have hcR_int : IntervalIntegrable (deltaKerRight s) volume s B :=
    (hcR.mono (by rw [Set.uIcc_of_le hsB])).intervalIntegrable
  have hint2 : (∫ x in s..B, deltaKerRight s x) = G2 B - G2 s :=
    intervalIntegral.integral_eq_sub_of_hasDerivAt hG2 hcR_int
  rw [hint1, hint2]
  have hlog : Real.log B - Real.log s = Real.log (B / s) :=
    (Real.log_div (hs.trans_le hsB).ne' hs.ne').symm
  dsimp [G1, G2, deltaKerPolyPart]
  linarith [congrArg (2 * s ^ 3 * ·) hlog]

private theorem log_dyadic_bounds {y : ℝ} (q : ℕ) (hz1 : 1 ≤ y / (2 : ℝ) ^ q)
    (hz2 : y / (2 : ℝ) ^ q ≤ 2) :
    (q : ℝ) * (6931471803 / 10000000000) +
        (∑ k ∈ Finset.range 7, 2 * ((y / (2 : ℝ) ^ q - 1) / (y / (2 : ℝ) ^ q + 1)) ^ (2 * k + 1) / (2 * k + 1)) ≤
      Real.log y ∧
    Real.log y ≤
      (q : ℝ) * (6931471808 / 10000000000) +
        (∑ k ∈ Finset.range 7, 2 * ((y / (2 : ℝ) ^ q - 1) / (y / (2 : ℝ) ^ q + 1)) ^ (2 * k + 1) / (2 * k + 1)) +
        1 / 6 * ((y / (2 : ℝ) ^ q - 1) / (y / (2 : ℝ) ^ q + 1)) ^ 15 := by
  set z : ℝ := y / (2 : ℝ) ^ q
  have hy_eq : y = (2 : ℝ) ^ q * z := by dsimp [z]; field_simp
  have hl_eq : Real.log y = (q : ℝ) * Real.log 2 + Real.log z := by
    rw [hy_eq, Real.log_mul (by positivity) (by linarith), Real.log_pow]
  obtain ⟨hlo, hhi⟩ := log_pade_bounds hz1 7
  set t : ℝ := (z - 1) / (z + 1)
  have ht0 : 0 ≤ t := div_nonneg (by linarith) (by linarith)
  have ht3 : t ≤ 1 / 3 := by dsimp [t]; rw [div_le_iff₀ (by linarith)]; linarith
  have ht2 : t ^ 2 ≤ 1 / 9 := by nlinarith
  have hrem : 2 / (2 * (7 : ℝ) + 1) * t ^ (2 * 7 + 1) / (1 - t ^ 2) ≤ 1 / 6 * t ^ 15 := by
    rw [show 2 * 7 + 1 = 15 by omega, div_le_iff₀ (by linarith)]
    nlinarith [pow_nonneg ht0 15]
  have hl2_lo := Real.log_two_gt_d9
  have hl2_hi := Real.log_two_lt_d9
  have hq0 : (0 : ℝ) ≤ q := Nat.cast_nonneg q
  norm_num at hl2_lo hl2_hi
  exact ⟨by nlinarith, by nlinarith⟩

