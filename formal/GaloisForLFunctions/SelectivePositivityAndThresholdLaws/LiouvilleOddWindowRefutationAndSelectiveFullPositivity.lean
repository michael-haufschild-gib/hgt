/-! ## Section 1: Padé Logarithm Bounds and Sharp Constants -/

/-- Hyperbolic-arctanh series bounds for `Real.log y` (`1 ≤ y`) with parameter `t = (y − 1)/(y + 1)`. -/
theorem log_pade_bounds {y : ℝ} (hy : 1 ≤ y) (N : ℕ) :
    (∑ k ∈ Finset.range N, 2 * ((y - 1) / (y + 1)) ^ (2 * k + 1) / (2 * k + 1)) ≤ Real.log y ∧
      Real.log y ≤
        (∑ k ∈ Finset.range N, 2 * ((y - 1) / (y + 1)) ^ (2 * k + 1) / (2 * k + 1)) +
          2 / (2 * (N : ℝ) + 1) * ((y - 1) / (y + 1)) ^ (2 * N + 1) /
            (1 - ((y - 1) / (y + 1)) ^ 2) := by
  set t : ℝ := (y - 1) / (y + 1)
  rcases eq_or_lt_of_le hy with rfl | hy'
  · have ht0 : t = 0 := by simp [t]
    rw [ht0, Real.log_one]
    have hsum0 : (∑ k ∈ Finset.range N, 2 * (0 : ℝ) ^ (2 * k + 1) / (2 * k + 1)) = 0 :=
      Finset.sum_eq_zero fun k _ => by simp [zero_pow (Nat.succ_ne_zero _)]
    rw [hsum0, zero_pow (Nat.succ_ne_zero _)]
    norm_num
  · set m : ℝ := 1 / (y - 1)
    have hm : 0 < m := div_pos one_pos (sub_pos.mpr hy')
    have hmy : 1 + m⁻¹ = y := by
      simp only [m, one_div, inv_inv]
      ring
    have hmt : 1 / (2 * m + 1) = t := by
      have hy1 : y - 1 ≠ 0 := (sub_pos.mpr hy').ne'
      have hyplus : y + 1 ≠ 0 := by linarith
      dsimp [m, t]
      field_simp
      ring
    have ht_pos : 0 < t := div_pos (sub_pos.mpr hy') (by linarith)
    have ht_lt1 : t < 1 := by
      dsimp [t]
      rw [div_lt_one (by linarith)]
      linarith
    have ht2_lt1 : t ^ 2 < 1 := by nlinarith
    have hhs := Real.hasSum_log_one_add_inv hm
    rw [hmy, hmt] at hhs
    have hhs' : HasSum (fun k : ℕ => 2 * t ^ (2 * k + 1) / (2 * k + 1)) (Real.log y) :=
      hhs.congr_fun fun _ => by ring
    constructor
    · exact sum_le_hasSum (Finset.range N) (fun k _ => by positivity) hhs'
    · have htail : HasSum (fun j : ℕ => 2 * t ^ (2 * (j + N) + 1) / (2 * ((j + N : ℕ) : ℝ) + 1))
          (Real.log y - ∑ k ∈ Finset.range N, 2 * t ^ (2 * k + 1) / (2 * k + 1)) :=
        (hasSum_nat_add_iff' N).mpr hhs'
      have hgeom : HasSum (fun j : ℕ =>
          (2 / (2 * (N : ℝ) + 1) * t ^ (2 * N + 1)) * (t ^ 2) ^ j)
          ((2 / (2 * (N : ℝ) + 1) * t ^ (2 * N + 1)) * (1 - t ^ 2)⁻¹) :=
        (hasSum_geometric_of_lt_one (sq_nonneg t) ht2_lt1).mul_left _
      have hle := hasSum_le (fun j => ?_) htail hgeom
      · rw [← div_eq_mul_inv] at hle
        linarith
      · have hpow : t ^ (2 * (j + N) + 1) = t ^ (2 * N + 1) * (t ^ 2) ^ j := by
          rw [← pow_mul, ← pow_add]
          congr 1
          omega
        have hden : 2 * (N : ℝ) + 1 ≤ 2 * ((j + N : ℕ) : ℝ) + 1 := by
          push_cast
          linarith
        rw [hpow]
        calc 2 * (t ^ (2 * N + 1) * (t ^ 2) ^ j) / (2 * ((j + N : ℕ) : ℝ) + 1)
            = (2 * t ^ (2 * N + 1) * (t ^ 2) ^ j) / (2 * ((j + N : ℕ) : ℝ) + 1) := by ring
          _ ≤ (2 * t ^ (2 * N + 1) * (t ^ 2) ^ j) / (2 * (N : ℝ) + 1) :=
              div_le_div_of_nonneg_left (by positivity) (by positivity) hden
          _ = 2 / (2 * (N : ℝ) + 1) * t ^ (2 * N + 1) * (t ^ 2) ^ j := by ring

/-- Second-order lower Euler–Maclaurin approximant `H_n − log n − 1/(2n) + 1/(12n² + 6)`. -/
def eulerMascheroniSecondLower (n : ℕ) : ℝ :=
  if n = 0 then 0 else
    Real.eulerMascheroniSeq' n - 1 / (2 * (n : ℝ)) + 1 / (12 * (n : ℝ) ^ 2 + 6)

private theorem log_one_add_inv_le_third_order {m : ℝ} (hm : 0 < m) :
    Real.log (1 + m⁻¹) ≤
      2 / (2 * m + 1) + 2 / (3 * (2 * m + 1) ^ 3) +
        1 / (10 * m * (m + 1) * (2 * m + 1) ^ 3) := by
  have hy : 1 ≤ 1 + m⁻¹ := by linarith [inv_pos.mpr hm]
  have hb := (log_pade_bounds hy 2).2
  have ht : (1 + m⁻¹ - 1) / (1 + m⁻¹ + 1) = 1 / (2 * m + 1) := by
    field_simp
    ring
  rw [ht] at hb
  simp only [Finset.sum_range_succ, Finset.sum_range_zero] at hb
  norm_num at hb
  have h2m1 : 2 * m + 1 ≠ 0 := by positivity
  have hsub : 1 - ((2 * m + 1) ^ 2)⁻¹ = 4 * m * (m + 1) / (2 * m + 1) ^ 2 := by
    field_simp
    ring
  rw [hsub] at hb
  refine hb.trans_eq ?_
  field_simp
  ring

private theorem second_lower_gap_gt {m : ℝ} (hm : 0 < m) :
    2 / (2 * m + 1) + 2 / (3 * (2 * m + 1) ^ 3) +
        1 / (10 * m * (m + 1) * (2 * m + 1) ^ 3) <
      1 / (2 * m) + 1 / (2 * (m + 1)) - 1 / (12 * m ^ 2 + 6) +
        1 / (12 * (m + 1) ^ 2 + 6) := by
  rw [← sub_pos]
  have key :
      (1 / (2 * m) + 1 / (2 * (m + 1)) - 1 / (12 * m ^ 2 + 6) +
          1 / (12 * (m + 1) ^ 2 + 6)) -
        (2 / (2 * m + 1) + 2 / (3 * (2 * m + 1) ^ 3) +
          1 / (10 * m * (m + 1) * (2 * m + 1) ^ 3)) =
      (16 * (2 * m + 1) ^ 4 + 47 * (2 * m + 1) ^ 2 + 9) /
        (60 * m * (m + 1) * (2 * m + 1) ^ 3 * (2 * m ^ 2 + 1) * (2 * (m + 1) ^ 2 + 1)) := by
    field_simp
    ring
  rw [key]
  positivity

private theorem eulerMascheroniSecondLower_lt_succ {n : ℕ} (hn : 1 ≤ n) :
    eulerMascheroniSecondLower n < eulerMascheroniSecondLower (n + 1) := by
  have hn0 : n ≠ 0 := by omega
  have hx0 : (0 : ℝ) < n := by exact_mod_cast hn
  have hlog : Real.log ((n : ℝ) + 1) - Real.log n = Real.log (1 + (n : ℝ)⁻¹) := by
    rw [← Real.log_div (by positivity) hx0.ne']
    congr 1
    field_simp
  have hL := log_one_add_inv_le_third_order hx0
  have hS := second_lower_gap_gt hx0
  simp only [eulerMascheroniSecondLower, Real.eulerMascheroniSeq', hn0, Nat.succ_ne_zero,
    if_false, harmonic_succ]
  push_cast
  have hdiff :
      ((harmonic n : ℝ) + ((n : ℝ) + 1)⁻¹ - Real.log ((n : ℝ) + 1) -
          1 / (2 * ((n : ℝ) + 1)) + 1 / (12 * ((n : ℝ) + 1) ^ 2 + 6)) -
        ((harmonic n : ℝ) - Real.log n - 1 / (2 * (n : ℝ)) +
          1 / (12 * (n : ℝ) ^ 2 + 6)) =
      (1 / (2 * (n : ℝ)) + 1 / (2 * ((n : ℝ) + 1)) - 1 / (12 * (n : ℝ) ^ 2 + 6) +
          1 / (12 * ((n : ℝ) + 1) ^ 2 + 6)) - Real.log (1 + (n : ℝ)⁻¹) := by
    rw [← hlog]
    field_simp
    ring
  linarith

/-- Certified six-decimal lower bound `577215 / 1000000 < γ` from the increasing second-order
Euler–Maclaurin sequence at `n = 16`. -/
theorem eulerMascheroniConstant_gt_577215_div_1000000 :
    (577215 / 1000000 : ℝ) < Real.eulerMascheroniConstant := by
  have hmono : StrictMono fun k : ℕ => eulerMascheroniSecondLower (k + 1) :=
    strictMono_nat_of_lt_succ fun k => eulerMascheroniSecondLower_lt_succ (by omega)
  have h2 : Tendsto (fun n : ℕ => 1 / (2 * (n : ℝ))) atTop (nhds 0) :=
    tendsto_const_nhds.div_atTop (tendsto_natCast_atTop_atTop.const_mul_atTop (by norm_num))
  have h12 : Tendsto (fun n : ℕ => 1 / (12 * (n : ℝ) ^ 2 + 6)) atTop (nhds 0) :=
    tendsto_const_nhds.div_atTop
      (((tendsto_pow_atTop (by norm_num)).comp tendsto_natCast_atTop_atTop |>.const_mul_atTop
        (by norm_num)).atTop_add tendsto_const_nhds)
  have hlim0 : Tendsto eulerMascheroniSecondLower atTop (nhds Real.eulerMascheroniConstant) := by
    have hmain := (Real.tendsto_eulerMascheroniSeq'.sub h2).add h12
    rw [sub_zero, add_zero] at hmain
    refine hmain.congr' ?_
    filter_upwards [eventually_ne_atTop 0] with n hn
    simp [eulerMascheroniSecondLower, hn]
  have hlim : Tendsto (fun k : ℕ => eulerMascheroniSecondLower (k + 1)) atTop
      (nhds Real.eulerMascheroniConstant) :=
    hlim0.comp (tendsto_add_atTop_nat 1)
  have h16_lt : eulerMascheroniSecondLower 16 < Real.eulerMascheroniConstant :=
    lt_of_lt_of_le (hmono (Nat.lt_succ_self 15)) (hmono.monotone.ge_of_tendsto hlim 16)
  refine lt_trans ?_ h16_lt
  have hH : harmonic 16 = 2436559 / 720720 := by
    rw [show (16 : ℕ) = 8 + 8 from rfl, RHTower.harmonic_add_eq_add_sum]
    norm_num [harmonic, Finset.sum_range_succ]
  have hlog : Real.log ((16 : ℕ) : ℝ) = 4 * Real.log 2 := by
    rw [show ((16 : ℕ) : ℝ) = 2 ^ (4 : ℕ) by norm_num, Real.log_pow]
    norm_num
  have h2lt := Real.log_two_lt_d9
  rw [eulerMascheroniSecondLower, if_neg (by norm_num), Real.eulerMascheroniSeq',
    if_neg (by norm_num), hH, hlog]
  norm_num at h2lt ⊢
  linarith

