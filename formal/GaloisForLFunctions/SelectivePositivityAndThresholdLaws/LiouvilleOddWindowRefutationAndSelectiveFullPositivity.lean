def levyUpperQuartic (x : ℝ) : ℝ :=
  1 / x + 1 / 2 - x / 24 - x ^ 2 / 16 + x ^ 3 / 576 + x ^ 4 / 128

def deltaKerFun (s x : ℝ) : ℝ := (|x + s| ^ 3 + |x - s| ^ 3 - 2 * s ^ 3) * levyUpperQuartic x

def deltaKerLeft (s x : ℝ) : ℝ :=
  6 * s * (x + x ^ 2 / 2 - x ^ 3 / 24 - x ^ 4 / 16 + x ^ 5 / 576 + x ^ 6 / 128)

def deltaKerRight (s x : ℝ) : ℝ :=
  2 * x ^ 2 + 6 * s ^ 2 - 2 * s ^ 3 / x +
    (2 * x ^ 3 + 6 * s ^ 2 * x - 2 * s ^ 3) *
      (1 / 2 - x / 24 - x ^ 2 / 16 + x ^ 3 / 576 + x ^ 4 / 128)

def deltaKerPolyPart (B s : ℝ) : ℝ :=
  6 * s * (s ^ 2 / 2 + s ^ 3 / 6 - s ^ 4 / 96 - s ^ 5 / 80 + s ^ 6 / 3456 + s ^ 7 / 896) +
    (2 / 3 * (B ^ 3 - s ^ 3) + 6 * s ^ 2 * (B - s)) +
    ((-s ^ 3 * (B - s) + (3 * s ^ 2 + s ^ 3 / 12) * (B ^ 2 - s ^ 2) / 2 +
        (-s ^ 2 / 4 + s ^ 3 / 8) * (B ^ 3 - s ^ 3) / 3 +
        (1 - 3 * s ^ 2 / 8 - s ^ 3 / 288) * (B ^ 4 - s ^ 4) / 4 +
        (-1 / 12 + s ^ 2 / 96 - s ^ 3 / 64) * (B ^ 5 - s ^ 5) / 5 +
        (-1 / 8 + 3 * s ^ 2 / 64) * (B ^ 6 - s ^ 6) / 6 +
        (1 / 288) * (B ^ 7 - s ^ 7) / 7 +
        (1 / 64) * (B ^ 8 - s ^ 8) / 8))

private theorem deltaKerFun_eq_left {s x : ℝ} (hx0 : 0 < x) (hxs : x ≤ s) :
    deltaKerFun s x = deltaKerLeft s x := by
  unfold deltaKerFun deltaKerLeft levyUpperQuartic
  rw [abs_of_nonneg (by linarith), abs_of_nonpos (by linarith)]
  field_simp [hx0.ne']
  ring

private theorem deltaKerFun_eq_right {s x : ℝ} (hs0 : 0 ≤ s) (hsx : s < x) :
    deltaKerFun s x = deltaKerRight s x := by
  have hx0 : 0 < x := hs0.trans_lt hsx
  unfold deltaKerFun deltaKerRight levyUpperQuartic
  rw [abs_of_nonneg (by linarith), abs_of_nonneg (by linarith)]
  field_simp [hx0.ne']
