private def cosShiftApprox (k : ℕ) (u : ℝ) : ℝ :=
  if k % 4 = 0 then cosMac8 u
  else if k % 4 = 1 then -sinMac7 u
  else if k % 4 = 2 then -cosMac8 u
  else sinMac7 u

private def sinShiftApprox (k : ℕ) (u : ℝ) : ℝ :=
  if k % 4 = 0 then sinMac7 u
  else if k % 4 = 1 then cosMac8 u
  else if k % 4 = 2 then -sinMac7 u
  else -cosMac8 u

private theorem mid_cos_sin_bounds {mid u0 cm sm : ℝ} (k : ℕ)
    (hmid0 : 0 ≤ mid) (hmidT : mid ≤ 69 / 2) (hk : k ≤ 16) (hu0_abs : |u0| ≤ 4 / 5)
    (hu0_err : |(mid * (6931471805 / 10000000000 : ℝ) - (k : ℝ) * (1570796327 / 1000000000 : ℝ)) - u0| ≤ 1 / 1000000)
    (hcm_err : |cosShiftApprox k u0 - cm| ≤ 1 / 10000000)
    (hsm_err : |sinShiftApprox k u0 - sm| ≤ 1 / 10000000) :
    |Real.cos (mid * Real.log 2) - cm| ≤ 2 / 1000000 ∧
      |Real.sin (mid * Real.log 2) - sm| ≤ 2 / 1000000 := by
  have hl2_lo := Real.log_two_gt_d9
  have hl2_hi := Real.log_two_lt_d9
  have hpi_lo := Real.pi_gt_d20
  have hpi_hi := Real.pi_lt_d20
  norm_num at hl2_lo hl2_hi hpi_lo hpi_hi
  have hl2_err : |Real.log 2 - (6931471805 / 10000000000 : ℝ)| ≤ 3 / 10000000000 := abs_le.mpr ⟨by linarith, by linarith⟩
  have hhp_err : |Real.pi / 2 - (1570796327 / 1000000000 : ℝ)| ≤ 3 / 10000000000 := abs_le.mpr ⟨by linarith, by linarith⟩
  set θ : ℝ := (k : ℝ) * (Real.pi / 2) + u0
  have harg_err : |mid * Real.log 2 - θ| ≤ 102 / 100000000 := by
    have hrew : mid * Real.log 2 - θ =
        (mid * (Real.log 2 - (6931471805 / 10000000000 : ℝ)) -
          (k : ℝ) * (Real.pi / 2 - (1570796327 / 1000000000 : ℝ))) +
        ((mid * (6931471805 / 10000000000 : ℝ) - (k : ℝ) * (1570796327 / 1000000000 : ℝ)) - u0) := by
      dsimp [θ]; ring
    rw [hrew]
    have hk_r : (k : ℝ) ≤ 16 := by exact_mod_cast hk
    have h1 : |mid * (Real.log 2 - (6931471805 / 10000000000 : ℝ))| ≤ (69 / 2) * (3 / 10000000000) := by
      rw [abs_mul, abs_of_nonneg hmid0]; exact mul_le_mul hmidT hl2_err (abs_nonneg _) (by norm_num)
