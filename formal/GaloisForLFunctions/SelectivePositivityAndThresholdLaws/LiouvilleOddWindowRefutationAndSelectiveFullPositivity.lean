    change (∫ u, Real.exp (u / 2) * oddClampWitnessFun u) = _
    rw [← setIntegral_eq_integral_of_forall_compl_eq_zero hvan,
      ← intervalIntegral.integral_of_le (by dsimp [B]; norm_num [radiusQ2A] : -B ≤ B)]
    have hi_exp : ∀ a b : ℝ, IntervalIntegrable (fun u => Real.exp (u / 2) * oddClampWitnessFun u) volume a b :=
