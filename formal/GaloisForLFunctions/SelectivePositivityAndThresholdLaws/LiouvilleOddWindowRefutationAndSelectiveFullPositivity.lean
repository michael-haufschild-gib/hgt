  simp only [hΛ2, liouvilleTwistedVonMangoldt_two, _root_.RHTower.ArchimedeanExactForm.autocorr_neg,
    ← Complex.ofReal_add, ← Complex.ofReal_mul, Complex.ofReal_re] at hre_diff
