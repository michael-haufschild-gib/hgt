private theorem integrableOn_deltaKerFun {s B : ℝ} (hs : 0 ≤ s) (hsB : s ≤ B) :
    IntegrableOn (deltaKerFun s) (Ioc 0 B) := by
  rcases eq_or_lt_of_le hs with rfl | hs_pos
  · have hcont : Continuous fun x : ℝ =>
        2 * (x ^ 2 + x ^ 3 / 2 - x ^ 4 / 24 - x ^ 5 / 16 + x ^ 6 / 576 + x ^ 7 / 128) := by fun_prop
    refine hcont.integrableOn_Ioc.congr_fun (fun x hx => ?_) measurableSet_Ioc
    dsimp [deltaKerFun, levyUpperQuartic]; rw [add_zero, sub_zero, abs_of_pos hx.1]; field_simp [hx.1.ne']; ring
  · have hiL : IntegrableOn (deltaKerFun s) (Ioc 0 s) := by
      have hcL : Continuous (deltaKerLeft s) := by unfold deltaKerLeft; fun_prop
      exact hcL.integrableOn_Ioc.congr_fun (fun x hx => (deltaKerFun_eq_left hx.1 hx.2).symm) measurableSet_Ioc
    have hiR : IntegrableOn (deltaKerFun s) (Ioc s B) := by
      have hcR : ContinuousOn (deltaKerRight s) (Icc s B) := by
        unfold deltaKerRight
        refine ContinuousOn.add (ContinuousOn.sub (by fun_prop) ?_) (by fun_prop)
        exact ContinuousOn.div continuousOn_const continuousOn_id fun x hx => (hs_pos.trans_le hx.1).ne'
      exact (hcR.integrableOn_Icc.mono_set Ioc_subset_Icc_self).congr_fun
        (fun x hx => (deltaKerFun_eq_right hs_pos.le hx.1).symm) measurableSet_Ioc
    rw [← Ioc_union_Ioc_eq_Ioc hs_pos.le hsB]
    exact hiL.union hiR

private theorem integral_deltaKerFun_zero {B : ℝ} (hB : 0 ≤ B) :
    (∫ x in Ioc 0 B, deltaKerFun 0 x) =
      2 * (B ^ 3 / 3 + B ^ 4 / 8 - B ^ 5 / 120 - B ^ 6 / 96 + B ^ 7 / 4032 + B ^ 8 / 1024) := by
