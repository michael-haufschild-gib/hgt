        change CHMDDoobGraph.mollifier k (-t) * f (-x - -t) =
          -(CHMDDoobGraph.mollifier k t * f (x - t))
        rw [mollifier_even, show -x - -t = -(x - t) by ring, hodd]; ring
    _ = -(∫ t, CHMDDoobGraph.mollifier k t * f (x - t)) := integral_neg _

private theorem smooth_eq_zero_of_radius {f : ℝ → ℝ} {R : ℝ} (hf : ∀ x, R < |x| → f x = 0)
    (k : ℕ) {x : ℝ} (hx : R + 1 / (4 * ((k : ℝ) + 1)) < |x|) :
    CHMDDoobGraph.smooth f k x = 0 := by
  change (∫ t, CHMDDoobGraph.mollifier k t * f (x - t)) = 0
  have h0 : ∀ t, CHMDDoobGraph.mollifier k t * f (x - t) = 0 := fun t => by
    by_cases ht : 1 / (4 * ((k : ℝ) + 1)) < |t|
    · have hm0 : CHMDDoobGraph.mollifier k t = 0 := by
        apply Function.notMem_support.mp
        rw [CHMDDoobGraph.mollifier, ContDiffBump.support_normed_eq, Metric.mem_ball,
          dist_zero_right, Real.norm_eq_abs]
        change ¬ |t| < 1 / (4 * ((k : ℝ) + 1))
        linarith
      rw [hm0, zero_mul]
    · push Not at ht
      have hxt : R < |x - t| := by
        have := abs_sub_abs_le_abs_sub x t; linarith
      rw [hf _ hxt, mul_zero]
  simp only [h0, integral_zero]

/-- **Refutation of the Liouville-Twisted Odd Window on `[−181/500, 181/500]`:**
There exists an odd `F ∈ C²_c(ℝ)` supported in `[−181/500, 181/500]` with `0 < ∫ F²` such that
`(1 / 1000) ∫ F² ≤ Re W_ζ(F ⋆ F̃)` while simultaneously
`Re W_{λΛ}(F ⋆ F̃) < −(1 / 1000) ∫ F² < 0`. -/
theorem exists_odd_smooth_threeHundredSixtyTwoThousandths_zeta_pos_liouville_neg :
    ∃ F : ℝ → ℝ, ContDiff ℝ 2 F ∧ HasCompactSupport F ∧
      (∀ x, F (-x) = -F x) ∧ (∀ x, 181 / 500 < |x| → F x = 0) ∧ 0 < (∫ x, F x ^ 2) ∧
      1 / 1000 * (∫ x, F x ^ 2) ≤
        (weilFullFunctional (fun n => (ArithmeticFunction.vonMangoldt n : ℝ))
          (EF.weilTest (fun x => (F x : ℂ)) (fun x => (F x : ℂ)))).re ∧
      (weilFullFunctional liouvilleTwistedVonMangoldt
        (EF.weilTest (fun x => (F x : ℂ)) (fun x => (F x : ℂ)))).re <
        -(1 / 1000 : ℝ) * (∫ x, F x ^ 2) := by
  let f := oddClampWitnessSource
  have hfc : Continuous (f : ℝ → ℝ) := map_continuous f
  have hM : ∀ x, |f x| ≤ (1112310843 / 12500000 : ℝ) := abs_oddClampWitnessFun_le
  have hfR : ∀ x, radiusQ2A < |x| → f x = 0 := fun _ hx => oddClampWitnessFun_eq_zero_of_lt hx
  have hf2 : MemLp (f : ℝ → ℝ) 2 volume := hfc.memLp_of_hasCompactSupport f.hasCompactSupport
  have hJ := integrableOn_levy_of_lipschitz f lipschitz_oddClampWitnessFun
  have hac0_pos : 0 < acorr f 0 := by
    change 0 < acorr oddClampWitnessSource 0
    rw [autocorr_oddClampWitness_zero]; norm_num
  have h2R_f : 2 * radiusQ2A < Real.log 3 := by
    have := two_mul_threeHundredSixtyTwoThousandths_lt_log_three
    dsimp [radiusQ2A]; linarith
  have hliouv_f := re_weilFullFunctional_liouville_eq_add_atom_two f (by norm_num [radiusQ2A]) h2R_f hfR
  have ht_ac0 := autocorr_smooth_tendsto hfc hM hfR 0
  have ht_ac2 := autocorr_smooth_tendsto hfc hM hfR (Real.log 2)
  have ht_zeta := re_weilFullFunctional_smooth_tendsto f hJ
  have ht_liouv : Tendsto (fun k : ℕ =>
      (weilFullFunctional (fun n => (ArithmeticFunction.vonMangoldt n : ℝ))
        (EF.weilTest (fun u => (smooth f k u : ℂ)) (fun u => (smooth f k u : ℂ)))).re +
        2 * ((Real.sqrt 2 * Real.log 2) * acorr (smooth f k) (Real.log 2))) atTop
      (𝓝 ((weilFullFunctional liouvilleTwistedVonMangoldt
        (EF.weilTest (fun u => (f u : ℂ)) (fun u => (f u : ℂ)))).re)) := by
    rw [hliouv_f]
    exact ht_zeta.add (((ht_ac2.const_mul (Real.sqrt 2 * Real.log 2)).const_mul 2))
  have hev_norm : ∀ᶠ k : ℕ in atTop, 0 < acorr (smooth f k) 0 :=
    ht_ac0.eventually (Ioi_mem_nhds hac0_pos)
  have hev_liouv : ∀ᶠ k : ℕ in atTop,
      (weilFullFunctional (fun n => (ArithmeticFunction.vonMangoldt n : ℝ))
        (EF.weilTest (fun u => (smooth f k u : ℂ)) (fun u => (smooth f k u : ℂ)))).re +
        2 * ((Real.sqrt 2 * Real.log 2) * acorr (smooth f k) (Real.log 2)) <
        -(1 / 1000 : ℝ) * acorr (smooth f k) 0 := by
    have hdiff := ht_liouv.sub (ht_ac0.const_mul (-(1 / 1000 : ℝ)))
    have hneg : (weilFullFunctional liouvilleTwistedVonMangoldt
        (EF.weilTest (fun u => (f u : ℂ)) (fun u => (f u : ℂ)))).re -
        (-(1 / 1000 : ℝ) * acorr f 0) < 0 := sub_neg.mpr unsmoothed_oddClampWitness_liouville_lt
    exact (hdiff.eventually (Iio_mem_nhds hneg)).mono fun _ hk => sub_neg.mp hk
  obtain ⟨k, hk_ge, hknorm, hkliouv⟩ :=
    ((eventually_ge_atTop 125000).and (hev_norm.and hev_liouv)).exists
  have hk_supp : ∀ x : ℝ, 181 / 500 < |x| → smooth f k x = 0 := fun x hx => by
    apply smooth_eq_zero_of_radius hfR k
