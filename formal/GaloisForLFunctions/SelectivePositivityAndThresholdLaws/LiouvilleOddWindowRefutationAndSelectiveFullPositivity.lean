private theorem deg4_round_le {Δ δ2 : ℝ} (hΔ : |Δ| ≤ δ2)
    (c0 c1 c2 c3 c4 d0 d1 d2 d3 d4 : ℝ)
    (herr : |c1 - d1| * δ2 + |c2 - d2| * δ2 ^ 2 + |c3 - d3| * δ2 ^ 3 + |c4 - d4| * δ2 ^ 4 ≤ d0 - c0) :
    c0 + c1 * Δ + c2 * Δ ^ 2 + c3 * Δ ^ 3 + c4 * Δ ^ 4 ≤
      d0 + d1 * Δ + d2 * Δ ^ 2 + d3 * Δ ^ 3 + d4 * Δ ^ 4 := by
  have hp1 : |(c1 - d1) * Δ ^ 1| ≤ |c1 - d1| * δ2 ^ 1 := by
    rw [abs_mul, abs_pow]; exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (abs_nonneg Δ) hΔ 1) (abs_nonneg _)
  have h1 : (c1 - d1) * Δ ^ 1 ≤ |c1 - d1| * δ2 ^ 1 := (le_abs_self _).trans hp1
  have hp2 : |(c2 - d2) * Δ ^ 2| ≤ |c2 - d2| * δ2 ^ 2 := by
    rw [abs_mul, abs_pow]; exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (abs_nonneg Δ) hΔ 2) (abs_nonneg _)
  have h2 : (c2 - d2) * Δ ^ 2 ≤ |c2 - d2| * δ2 ^ 2 := (le_abs_self _).trans hp2
  have hp3 : |(c3 - d3) * Δ ^ 3| ≤ |c3 - d3| * δ2 ^ 3 := by
    rw [abs_mul, abs_pow]; exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (abs_nonneg Δ) hΔ 3) (abs_nonneg _)
  have h3 : (c3 - d3) * Δ ^ 3 ≤ |c3 - d3| * δ2 ^ 3 := (le_abs_self _).trans hp3
  have hp4 : |(c4 - d4) * Δ ^ 4| ≤ |c4 - d4| * δ2 ^ 4 := by
    rw [abs_mul, abs_pow]; exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (abs_nonneg Δ) hΔ 4) (abs_nonneg _)
  have h4 : (c4 - d4) * Δ ^ 4 ≤ |c4 - d4| * δ2 ^ 4 := (le_abs_self _).trans hp4
  rw [pow_one] at h1
  linarith

private theorem gauss_two_neg_le_delta_round {u u2 s0 a r δ2 : ℝ}
    (hu : 0 < u) (hu2 : u ^ 2 = u2) (hs0 : 0 ≤ s0)
    (ha : 0 ≤ a) (har : a ≤ r) (hΔ : |r ^ 2 - s0| ≤ δ2)
    (d0 d1 d2 d3 d4 : ℝ)
    (herr :
      |-2 * u / (u2 + s0) ^ 2 - d1| * δ2 +
      |2 * u / (u2 + s0) ^ 3 - d2| * δ2 ^ 2 +
      |-2 * u / (u2 + s0) ^ 4 - d3| * δ2 ^ 3 +
      |2 * u / ((u2 + a ^ 2) * (u2 + s0) ^ 4) - d4| * δ2 ^ 4 ≤
      d0 - 2 * (-1 / u + u / (u2 + s0))) :
    -(2 * r ^ 2 / (u * (u2 + r ^ 2))) ≤
      d0 + d1 * (r ^ 2 - s0) + d2 * (r ^ 2 - s0) ^ 2 +
        d3 * (r ^ 2 - s0) ^ 3 + d4 * (r ^ 2 - s0) ^ 4 := by
  subst hu2
  have hs := gaussSingle_neg_le_quartic hu hs0 ha har (D := u ^ 2 + s0) (w := (r ^ 2 - s0) / (u ^ 2 + s0)) rfl rfl
  have h2 := mul_le_mul_of_nonneg_left hs (by norm_num : (0 : ℝ) ≤ 2)
  have hD : u ^ 2 + s0 ≠ 0 := by positivity
  have hua : u ^ 2 + a ^ 2 ≠ 0 := by positivity
  have hlhs : 2 * -(r ^ 2 / (u * (u ^ 2 + r ^ 2))) = -(2 * r ^ 2 / (u * (u ^ 2 + r ^ 2))) := by ring
  have hrhs : 2 * (-1 / u + u / (u ^ 2 + s0) *
      (1 - (r ^ 2 - s0) / (u ^ 2 + s0) + ((r ^ 2 - s0) / (u ^ 2 + s0)) ^ 2 -
        ((r ^ 2 - s0) / (u ^ 2 + s0)) ^ 3 +
        (u ^ 2 + s0) / (u ^ 2 + a ^ 2) * ((r ^ 2 - s0) / (u ^ 2 + s0)) ^ 4)) =
      2 * (-1 / u + u / (u ^ 2 + s0)) +
        (-2 * u / (u ^ 2 + s0) ^ 2) * (r ^ 2 - s0) +
        (2 * u / (u ^ 2 + s0) ^ 3) * (r ^ 2 - s0) ^ 2 +
        (-2 * u / (u ^ 2 + s0) ^ 4) * (r ^ 2 - s0) ^ 3 +
        (2 * u / ((u ^ 2 + a ^ 2) * (u ^ 2 + s0) ^ 4)) * (r ^ 2 - s0) ^ 4 := by
    field_simp [hu.ne', hD, hua]; ring
  rw [hlhs, hrhs] at h2
  exact h2.trans (deg4_round_le hΔ _ _ _ _ _ d0 d1 d2 d3 d4 herr)

private theorem gauss_one_neg_le_delta_round {u u2 s0 a r δ2 : ℝ}
    (hu : 0 < u) (hu2 : u ^ 2 = u2) (hs0 : 0 ≤ s0)
    (ha : 0 ≤ a) (har : a ≤ r) (hΔ : |r ^ 2 - s0| ≤ δ2)
    (d0 d1 d2 d3 d4 : ℝ)
    (herr :
      |-u / (u2 + s0) ^ 2 - d1| * δ2 +
      |u / (u2 + s0) ^ 3 - d2| * δ2 ^ 2 +
      |-u / (u2 + s0) ^ 4 - d3| * δ2 ^ 3 +
      |u / ((u2 + a ^ 2) * (u2 + s0) ^ 4) - d4| * δ2 ^ 4 ≤
      d0 - (-1 / u + u / (u2 + s0))) :
    -(r ^ 2 / (u * (u2 + r ^ 2))) ≤
      d0 + d1 * (r ^ 2 - s0) + d2 * (r ^ 2 - s0) ^ 2 +
        d3 * (r ^ 2 - s0) ^ 3 + d4 * (r ^ 2 - s0) ^ 4 := by
  subst hu2
  have hs := gaussSingle_neg_le_quartic hu hs0 ha har (D := u ^ 2 + s0) (w := (r ^ 2 - s0) / (u ^ 2 + s0)) rfl rfl
  have hD : u ^ 2 + s0 ≠ 0 := by positivity
  have hua : u ^ 2 + a ^ 2 ≠ 0 := by positivity
  have hrhs : -1 / u + u / (u ^ 2 + s0) *
      (1 - (r ^ 2 - s0) / (u ^ 2 + s0) + ((r ^ 2 - s0) / (u ^ 2 + s0)) ^ 2 -
        ((r ^ 2 - s0) / (u ^ 2 + s0)) ^ 3 +
        (u ^ 2 + s0) / (u ^ 2 + a ^ 2) * ((r ^ 2 - s0) / (u ^ 2 + s0)) ^ 4) =
      (-1 / u + u / (u ^ 2 + s0)) +
        (-u / (u ^ 2 + s0) ^ 2) * (r ^ 2 - s0) +
        (u / (u ^ 2 + s0) ^ 3) * (r ^ 2 - s0) ^ 2 +
        (-u / (u ^ 2 + s0) ^ 4) * (r ^ 2 - s0) ^ 3 +
        (u / ((u ^ 2 + a ^ 2) * (u ^ 2 + s0) ^ 4)) * (r ^ 2 - s0) ^ 4 := by
    field_simp [hu.ne', hD, hua]; ring
  rw [hrhs] at hs
  exact hs.trans (deg4_round_le hΔ _ _ _ _ _ d0 d1 d2 d3 d4 herr)

private theorem neg_half_log_le_delta_round {uM u2 a b r c0 s0 δ2 : ℝ}
    (huM : 0 < uM) (hu2 : uM ^ 2 = u2) (ha : 0 ≤ a) (hab : a ≤ b) (har : a ≤ r)
    (hc0 : c0 ≤ 1 / 2 * Real.log (1 + ((a ^ 2 + b ^ 2) / 2) / uM ^ 2))
    (hs0_eq : s0 = (a ^ 2 + b ^ 2) / 2) (hΔ : |r ^ 2 - s0| ≤ δ2)
    (d0 d1 d2 d3 d4 : ℝ)
    (herr :
      |-1 / (2 * (u2 + s0)) - d1| * δ2 +
      |1 / (4 * (u2 + s0) ^ 2) - d2| * δ2 ^ 2 +
      |-1 / (6 * (u2 + s0) ^ 3) - d3| * δ2 ^ 3 +
      |1 / (8 * (u2 + a ^ 2) * (u2 + s0) ^ 3) - d4| * δ2 ^ 4 ≤
      d0 - (-c0)) :
    -(1 / 2 * Real.log (1 + r ^ 2 / u2)) ≤
      d0 + d1 * (r ^ 2 - s0) + d2 * (r ^ 2 - s0) ^ 2 +
        d3 * (r ^ 2 - s0) ^ 3 + d4 * (r ^ 2 - s0) ^ 4 := by
  subst hu2
  have hs0_nn : 0 ≤ s0 := by rw [hs0_eq]; positivity
  have hl := neg_half_log_one_add_le_quartic huM ha hab har hc0 hs0_eq (DM := uM ^ 2 + s0) (w := (r ^ 2 - s0) / (uM ^ 2 + s0)) rfl rfl
  have hDM : uM ^ 2 + s0 ≠ 0 := by positivity
  have hua : uM ^ 2 + a ^ 2 ≠ 0 := by positivity
  have hrhs : -c0 - 1 / 2 *
      ((r ^ 2 - s0) / (uM ^ 2 + s0) - ((r ^ 2 - s0) / (uM ^ 2 + s0)) ^ 2 / 2 +
        ((r ^ 2 - s0) / (uM ^ 2 + s0)) ^ 3 / 3 -
        (uM ^ 2 + s0) / (uM ^ 2 + a ^ 2) * (1 / 4) * ((r ^ 2 - s0) / (uM ^ 2 + s0)) ^ 4) =
      (-c0) +
        (-1 / (2 * (uM ^ 2 + s0))) * (r ^ 2 - s0) +
        (1 / (4 * (uM ^ 2 + s0) ^ 2)) * (r ^ 2 - s0) ^ 2 +
        (-1 / (6 * (uM ^ 2 + s0) ^ 3)) * (r ^ 2 - s0) ^ 3 +
        (1 / (8 * (uM ^ 2 + a ^ 2) * (uM ^ 2 + s0) ^ 3)) * (r ^ 2 - s0) ^ 4 := by
    field_simp [hDM, hua]; ring
  rw [hrhs] at hl
  exact hl.trans (deg4_round_le hΔ _ _ _ _ _ d0 d1 d2 d3 d4 herr)

private theorem abs_sin_le_one' (x : ℝ) : |Real.sin x| ≤ 1 := by
  have h : Real.sin x = -Real.cos (x + Real.pi / 2) := by linarith [Real.cos_add_pi_div_two x]
  rw [h, abs_neg]
  exact Real.abs_cos_le_one _

private theorem abs_sin_sub_sin_le' (x y : ℝ) : |Real.sin x - Real.sin y| ≤ |x - y| := by
  have hx : Real.sin x = -Real.cos (x + Real.pi / 2) := by linarith [Real.cos_add_pi_div_two x]
  have hy : Real.sin y = -Real.cos (y + Real.pi / 2) := by linarith [Real.cos_add_pi_div_two y]
  rw [hx, hy, show -Real.cos (x + Real.pi / 2) - -Real.cos (y + Real.pi / 2) =
      -(Real.cos (x + Real.pi / 2) - Real.cos (y + Real.pi / 2)) by ring, abs_neg]
  simpa [add_sub_add_right_eq_sub] using Real.abs_cos_sub_cos_le (x + Real.pi / 2) (y + Real.pi / 2)

private theorem sin_nat_mul_pi_div_two_add (k : ℕ) (u : ℝ) :
    Real.sin ((k : ℝ) * (Real.pi / 2) + u) =
      if k % 4 = 0 then Real.sin u
      else if k % 4 = 1 then Real.cos u
      else if k % 4 = 2 then -Real.sin u
      else -Real.cos u := by
  have h1 : Real.sin ((k : ℝ) * (Real.pi / 2) + u) =
      -Real.cos (((k + 1 : ℕ) : ℝ) * (Real.pi / 2) + u) := by
    have hc := Real.cos_add_pi_div_two ((k : ℝ) * (Real.pi / 2) + u)
    have harg : ((k : ℝ) * (Real.pi / 2) + u) + Real.pi / 2 =
        ((k + 1 : ℕ) : ℝ) * (Real.pi / 2) + u := by push_cast; ring
    linarith [harg ▸ hc]
  rw [h1, cos_nat_mul_pi_div_two_add (k + 1) u]
  rcases (by omega : k % 4 = 0 ∨ k % 4 = 1 ∨ k % 4 = 2 ∨ k % 4 = 3) with h0 | h1' | h2 | h3
  · have hk1 : (k + 1) % 4 = 1 := by omega
    rw [h0, hk1]; norm_num
  · have hk1 : (k + 1) % 4 = 2 := by omega
    rw [h1', hk1]; norm_num
  · have hk1 : (k + 1) % 4 = 3 := by omega
    rw [h2, hk1]; norm_num
  · have hk1 : (k + 1) % 4 = 0 := by omega
    rw [h3, hk1]; norm_num

private def cosMac8 (u : ℝ) : ℝ := 1 - u ^ 2 / 2 + u ^ 4 / 24 - u ^ 6 / 720 + u ^ 8 / 40320
private def sinMac7 (u : ℝ) : ℝ := u - u ^ 3 / 6 + u ^ 5 / 120 - u ^ 7 / 5040

private theorem abs_cos_sub_cosMac8_le (u : ℝ) : |Real.cos u - cosMac8 u| ≤ |u| ^ 10 / 3628800 := by
  have hmac := abs_cos_sub_maclaurin_le 4 u
  have hpoly : (∑ m ∈ Finset.range (4 + 1), (-1 : ℝ) ^ m * u ^ (2 * m) / (2 * m).factorial) = cosMac8 u := by
    simp only [Finset.sum_range_succ, Finset.sum_range_zero, Nat.factorial]
    unfold cosMac8; push_cast; ring
  have hfac : ((2 * 4 + 2).factorial : ℝ) = 3628800 := by norm_num [Nat.factorial]
  rw [hpoly, hfac, show 2 * 4 + 2 = 10 by omega] at hmac
  exact hmac

private theorem abs_sin_sub_sinMac7_le (u : ℝ) : |Real.sin u - sinMac7 u| ≤ |u| ^ 9 / 362880 := by
  have hmac := abs_sin_sub_maclaurin_le 3 u
  have hpoly : (∑ m ∈ Finset.range (3 + 1), (-1 : ℝ) ^ m * u ^ (2 * m + 1) / (2 * m + 1).factorial) = sinMac7 u := by
    simp only [Finset.sum_range_succ, Finset.sum_range_zero, Nat.factorial]
    unfold sinMac7; push_cast; ring
  have hfac : ((2 * 3 + 3).factorial : ℝ) = 362880 := by norm_num [Nat.factorial]
  rw [hpoly, hfac, show 2 * 3 + 3 = 9 by omega] at hmac
  exact hmac

private def cosHPoly (h : ℝ) : ℝ :=
  1 + (-6005663 / 25000000 : ℝ) * h ^ 2 + (961813 / 100000000 : ℝ) * h ^ 4 +
    (-30807 / 200000000 : ℝ) * h ^ 6 + (661 / 500000000 : ℝ) * h ^ 8

private def sinHPoly (h : ℝ) : ℝ :=
  (433217 / 625000 : ℝ) * h + (-55504113 / 1000000000 : ℝ) * h ^ 3 +
    (333339 / 250000000 : ℝ) * h ^ 5 + (-15253 / 1000000000 : ℝ) * h ^ 7

private theorem abs_cos_h_mul_log_two_sub_cosHPoly_le {h : ℝ} (hh : |h| ≤ 3 / 4) :
    |Real.cos (h * Real.log 2) - cosHPoly h| ≤ (3 / 100000000 : ℝ) := by
  have hl2_lo := Real.log_two_gt_d9
  have hl2_hi := Real.log_two_lt_d9
  norm_num at hl2_lo hl2_hi
  have hl2_err : |Real.log 2 - (433217 / 625000 : ℝ)| ≤ 2 / 100000000 := abs_le.mpr ⟨by linarith, by linarith⟩
  set u : ℝ := h * (433217 / 625000 : ℝ)
  have hlip : |Real.cos (h * Real.log 2) - Real.cos u| ≤ (3 / 4) * (2 / 100000000) := by
    refine (Real.abs_cos_sub_cos_le _ _).trans ?_
    rw [show h * Real.log 2 - u = h * (Real.log 2 - (433217 / 625000 : ℝ)) by dsimp [u]; ring, abs_mul]
    exact mul_le_mul hh hl2_err (abs_nonneg _) (by norm_num)
  have hu_le : |u| ≤ 21 / 40 := by
    dsimp [u]; rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < (433217 / 625000 : ℝ))]
    exact (mul_le_mul_of_nonneg_right hh (by norm_num)).trans (by norm_num)
  have hp10 : |u| ^ 10 / (3628800 : ℝ) ≤ (21 / 40 : ℝ) ^ 10 / 3628800 :=
    div_le_div_of_nonneg_right (pow_le_pow_left₀ (abs_nonneg u) hu_le 10) (by norm_num)
  have hmac' : |Real.cos u - cosMac8 u| ≤ (21 / 40 : ℝ) ^ 10 / 3628800 :=
    (abs_cos_sub_cosMac8_le u).trans hp10
  have hrd : |cosMac8 u - cosHPoly h| ≤
      |-(433217 / 625000 : ℝ) ^ 2 / 2 - (-6005663 / 25000000 : ℝ)| * (3 / 4) ^ 2 +
      |(433217 / 625000 : ℝ) ^ 4 / 24 - (961813 / 100000000 : ℝ)| * (3 / 4) ^ 4 +
      |-(433217 / 625000 : ℝ) ^ 6 / 720 - (-30807 / 200000000 : ℝ)| * (3 / 4) ^ 6 +
      |(433217 / 625000 : ℝ) ^ 8 / 40320 - (661 / 500000000 : ℝ)| * (3 / 4) ^ 8 := by
    have hid : cosMac8 u - cosHPoly h =
        (0 : ℝ) + (0 : ℝ) * h + (-(433217 / 625000 : ℝ) ^ 2 / 2 - (-6005663 / 25000000 : ℝ)) * h ^ 2 +
        (0 : ℝ) * h ^ 3 + ((433217 / 625000 : ℝ) ^ 4 / 24 - (961813 / 100000000 : ℝ)) * h ^ 4 +
        (0 : ℝ) * h ^ 5 + (-(433217 / 625000 : ℝ) ^ 6 / 720 - (-30807 / 200000000 : ℝ)) * h ^ 6 +
        (0 : ℝ) * h ^ 7 + ((433217 / 625000 : ℝ) ^ 8 / 40320 - (661 / 500000000 : ℝ)) * h ^ 8 := by
      dsimp [u, cosMac8, cosHPoly]; ring
    rw [hid]
    exact abs_deg8_le hh _ _ _ _ _ _ _ _ _ _ (by simp only [abs_zero, zero_mul, zero_add, add_zero]; exact le_rfl)
  have htri1 := norm_add_le (Real.cos (h * Real.log 2) - Real.cos u) (Real.cos u - cosMac8 u)
  have htri2 := norm_add_le (Real.cos (h * Real.log 2) - cosMac8 u) (cosMac8 u - cosHPoly h)
  simp only [Real.norm_eq_abs, sub_add_sub_cancel] at htri1 htri2
  norm_num at hlip hmac' hrd
  linarith

private theorem abs_sin_h_mul_log_two_sub_sinHPoly_le {h : ℝ} (hh : |h| ≤ 3 / 4) :
    |Real.sin (h * Real.log 2) - sinHPoly h| ≤ (3 / 100000000 : ℝ) := by
  have hl2_lo := Real.log_two_gt_d9
  have hl2_hi := Real.log_two_lt_d9
  norm_num at hl2_lo hl2_hi
  have hl2_err : |Real.log 2 - (433217 / 625000 : ℝ)| ≤ 2 / 100000000 := abs_le.mpr ⟨by linarith, by linarith⟩
  set u : ℝ := h * (433217 / 625000 : ℝ)
  have hlip : |Real.sin (h * Real.log 2) - Real.sin u| ≤ (3 / 4) * (2 / 100000000) := by
    refine (abs_sin_sub_sin_le' _ _).trans ?_
    rw [show h * Real.log 2 - u = h * (Real.log 2 - (433217 / 625000 : ℝ)) by dsimp [u]; ring, abs_mul]
    exact mul_le_mul hh hl2_err (abs_nonneg _) (by norm_num)
  have hu_le : |u| ≤ 21 / 40 := by
    dsimp [u]; rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < (433217 / 625000 : ℝ))]
    exact (mul_le_mul_of_nonneg_right hh (by norm_num)).trans (by norm_num)
  have hp9 : |u| ^ 9 / (362880 : ℝ) ≤ (21 / 40 : ℝ) ^ 9 / 362880 :=
    div_le_div_of_nonneg_right (pow_le_pow_left₀ (abs_nonneg u) hu_le 9) (by norm_num)
  have hmac' : |Real.sin u - sinMac7 u| ≤ (21 / 40 : ℝ) ^ 9 / 362880 :=
    (abs_sin_sub_sinMac7_le u).trans hp9
  have hrd : |sinMac7 u - sinHPoly h| ≤
      |(433217 / 625000 : ℝ) - (433217 / 625000 : ℝ)| * (3 / 4) +
      |-(433217 / 625000 : ℝ) ^ 3 / 6 - (-55504113 / 1000000000 : ℝ)| * (3 / 4) ^ 3 +
      |(433217 / 625000 : ℝ) ^ 5 / 120 - (333339 / 250000000 : ℝ)| * (3 / 4) ^ 5 +
      |-(433217 / 625000 : ℝ) ^ 7 / 5040 - (-15253 / 1000000000 : ℝ)| * (3 / 4) ^ 7 := by
    have hid : sinMac7 u - sinHPoly h =
        (0 : ℝ) + ((433217 / 625000 : ℝ) - (433217 / 625000 : ℝ)) * h + (0 : ℝ) * h ^ 2 +
        (-(433217 / 625000 : ℝ) ^ 3 / 6 - (-55504113 / 1000000000 : ℝ)) * h ^ 3 + (0 : ℝ) * h ^ 4 +
        ((433217 / 625000 : ℝ) ^ 5 / 120 - (333339 / 250000000 : ℝ)) * h ^ 5 + (0 : ℝ) * h ^ 6 +
        (-(433217 / 625000 : ℝ) ^ 7 / 5040 - (-15253 / 1000000000 : ℝ)) * h ^ 7 + (0 : ℝ) * h ^ 8 := by
      dsimp [u, sinMac7, sinHPoly]; ring
    rw [hid]
    exact abs_deg8_le hh _ _ _ _ _ _ _ _ _ _ (by simp only [abs_zero, zero_mul, zero_add, add_zero]; exact le_rfl)
  have htri1 := norm_add_le (Real.sin (h * Real.log 2) - Real.sin u) (Real.sin u - sinMac7 u)
  have htri2 := norm_add_le (Real.sin (h * Real.log 2) - sinMac7 u) (sinMac7 u - sinHPoly h)
  simp only [Real.norm_eq_abs, sub_add_sub_cancel] at htri1 htri2
  norm_num at hlip hmac' hrd
