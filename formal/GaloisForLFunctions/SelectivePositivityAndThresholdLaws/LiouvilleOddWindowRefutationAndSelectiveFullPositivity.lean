  let G1 : ℝ → ℝ := fun x => 6 * s * (x ^ 2 / 2 + x ^ 3 / 6 - x ^ 4 / 96 - x ^ 5 / 80 + x ^ 6 / 3456 + x ^ 7 / 896)
