def diagMultFast : ℝ := (45304427648909 / 20000000000000 : ℝ)

def hEx (i j : Fin 23) : ℝ :=
  2 * Real.pi * vPoleEx i * vPoleEx j - mEx i j +
    if i.1 = j.1 then diagMultFast * (2 * (181 / 500 : ℝ) / (4 * (i.1 : ℝ) + 1)) else 0

private theorem hEx_symm (i j : Fin 23) : hEx i j = hEx j i := by
  unfold hEx
  rw [mEx_symm i j]
  by_cases hij : i.1 = j.1
  · rw [if_pos hij, if_pos hij.symm, hij]
    ring
  · have hji : j.1 ≠ i.1 := Ne.symm hij
    rw [if_neg hij, if_neg hji]
    ring

def hLo (i j : Fin 23) : ℝ :=
  2 * (3141592653 / 1000000000 : ℝ) * vpLo i * vpLo j - (mMid i j + mRad i j) +
    if i.1 = j.1 then diagMultFast * (2 * (181 / 500 : ℝ) / (4 * (i.1 : ℝ) + 1)) else 0

def hHi (i j : Fin 23) : ℝ :=
  2 * (1570796327 / 500000000 : ℝ) * vpHi i * vpHi j - (mMid i j - mRad i j) +
    if i.1 = j.1 then diagMultFast * (2 * (181 / 500 : ℝ) / (4 * (i.1 : ℝ) + 1)) else 0

private theorem hEx_bounds (i j : Fin 23) : hLo i j ≤ hEx i j ∧ hEx i j ≤ hHi i j := by
  obtain ⟨hpi_lo, hpi_hi⟩ := pi_d9_bounds
  obtain ⟨hvi0, hvi_lo, hvi_hi⟩ := vPoleEx_bounds i
  obtain ⟨hvj0, hvj_lo, hvj_hi⟩ := vPoleEx_bounds j
  obtain ⟨hm_lo, hm_hi⟩ := abs_le.mp (mEx_err_le i j)
  have h2pi_lo : 2 * (3141592653 / 1000000000 : ℝ) ≤ 2 * Real.pi := by linarith
  have h2pi_hi : 2 * Real.pi ≤ 2 * (3141592654 / 1000000000 : ℝ) := by linarith
  have hp1_lo : 2 * (3141592653 / 1000000000 : ℝ) * vpLo i ≤ 2 * Real.pi * vPoleEx i :=
    mul_le_mul h2pi_lo hvi_lo hvi0 (by positivity)
  have hp2_lo : 2 * (3141592653 / 1000000000 : ℝ) * vpLo i * vpLo j ≤
      2 * Real.pi * vPoleEx i * vPoleEx j :=
    mul_le_mul hp1_lo hvj_lo hvj0 (mul_nonneg (by positivity) ( hvi0.trans hvi_lo ))
  have hp1_hi : 2 * Real.pi * vPoleEx i ≤ 2 * (3141592654 / 1000000000 : ℝ) * vpHi i :=
    mul_le_mul h2pi_hi hvi_hi (hvi0.trans hvi_lo) (by norm_num)
  have hp2_hi : 2 * Real.pi * vPoleEx i * vPoleEx j ≤
      2 * (3141592654 / 1000000000 : ℝ) * vpHi i * vpHi j :=
    mul_le_mul hp1_hi hvj_hi (hvj0.trans hvj_lo) (mul_nonneg (by norm_num) ((hvi0.trans hvi_lo).trans hvi_hi))
  unfold hLo hEx hHi
  exact ⟨by linarith, by linarith⟩

