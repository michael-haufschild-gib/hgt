      ((by fun_prop : Continuous fun u => Real.exp (-(u / 2))).mul hc_f).intervalIntegrable 0 B
    rw [hneg_part, neg_add_eq_sub, ← intervalIntegral.integral_sub (hi_exp 0 B) hi_em]
    have hsh_eq : ∀ u : ℝ, Real.exp (u / 2) * oddClampWitnessFun u - Real.exp (-(u / 2)) * oddClampWitnessFun u =
        2 * (oddClampWitnessFun u * Real.sinh (u / 2)) := fun u => by rw [Real.sinh_eq]; ring
