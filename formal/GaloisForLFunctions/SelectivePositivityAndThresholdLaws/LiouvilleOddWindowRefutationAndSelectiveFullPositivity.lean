def mMid (j k : Fin 23) : ℝ :=
  (69 / 2 : ℝ) * (if j.1 ≤ k.1 then mDotUpperMid j k else mDotUpperMid k j)

def mRad (j k : Fin 23) : ℝ :=
  (69 / 2 : ℝ) * (if j.1 ≤ k.1 then mDotUpperRad j k else mDotUpperRad k j)

private theorem mMid_symm (j k : Fin 23) : mMid j k = mMid k j := by
  unfold mMid
  rcases lt_trichotomy j.1 k.1 with hlt | heq | hgt
  · rw [if_pos hlt.le, if_neg (not_le.mpr hlt)]
  · have hjk : j = k := Fin.ext heq; subst hjk; rfl
  · rw [if_neg (not_le.mpr hgt), if_pos hgt.le]

private theorem mRad_symm (j k : Fin 23) : mRad j k = mRad k j := by
  unfold mRad
  rcases lt_trichotomy j.1 k.1 with hlt | heq | hgt
  · rw [if_pos hlt.le, if_neg (not_le.mpr hlt)]
  · have hjk : j = k := Fin.ext heq; subst hjk; rfl
  · rw [if_neg (not_le.mpr hgt), if_pos hgt.le]

private theorem mEx_err_upper_0 (k : Fin 23) (hjk : 0 ≤ k.1) :
    |mEx ⟨0, by omega⟩ k - mMid ⟨0, by omega⟩ k| ≤ mRad ⟨0, by omega⟩ k := by
  have hdot : |(∑ m2 : Fin 23, bEx ⟨0, by omega⟩ m2 * qtEx k m2) -
      mDotUpperMid ⟨0, by omega⟩ k| ≤ mDotUpperRad ⟨0, by omega⟩ k := by
    refine dot23_vec_err_le
      (fun m2 => bEx ⟨0, by omega⟩ m2)
      (fun m2 => qtEx k m2)
      (fun m2 => bMid ⟨0, by omega⟩ m2)
      (fun m2 => bRad ⟨0, by omega⟩ m2)
      (fun m2 => qtMid k m2)
      (fun m2 => qtRad k m2)
      (mDotUpperMid ⟨0, by omega⟩ k) (mDotUpperRad ⟨0, by omega⟩ k)
      (fun m2 => bEx_err_row_0 m2)
      (fun m2 => qtEx_err_le k m2) ?_
    rw [sum_fin23, sum_fin23]
    fin_cases k
    · unfold bMid bRad qtMid qtRad mDotUpperMid mDotUpperRad; dsimp
      norm_num [bMidRow_0, bRadRow_0, qtMidRow_0, mDotUpperMidRow_0, mDotUpperRadRow_0]
    · unfold bMid bRad qtMid qtRad mDotUpperMid mDotUpperRad; dsimp
      norm_num [bMidRow_0, bRadRow_0, qtMidRow_1, mDotUpperMidRow_0, mDotUpperRadRow_0]
    · unfold bMid bRad qtMid qtRad mDotUpperMid mDotUpperRad; dsimp
      norm_num [bMidRow_0, bRadRow_0, qtMidRow_2, mDotUpperMidRow_0, mDotUpperRadRow_0]
    · unfold bMid bRad qtMid qtRad mDotUpperMid mDotUpperRad; dsimp
