private theorem two_pi_mul_evenPoleMoment_sq_ge {F : ℝ → ℝ} (hF : Continuous F)
    (hFc : HasCompactSupport F) (heven : ∀ x, F (-x) = F x)
    (hsupp : ∀ x, 181 / 500 < |x| → F x = 0) :
    2 * Real.pi * (∑ k : Fin 23, evenLegCoeff F k * vPoleEx k) ^ 2 -
        (1 / 1000000 : ℝ) * (∫ x, F x ^ 2) ≤
      2 * Real.pi * evenPoleMoment F ^ 2 := by
  set E : ℝ := ∫ x, F x ^ 2
  have hE_nn : 0 ≤ E := integral_nonneg fun x => sq_nonneg _
  set Vp : ℝ := ∑ k : Fin 23, evenLegCoeff F k * vPoleEx k
  have hVp_eq : Vp = ∫ x, F x * ∑ m ∈ Finset.range 9, (x / 2) ^ (2 * m) / ((2 * m).factorial : ℝ) := by
    dsimp [Vp]; unfold vPoleEx
    simp_rw [Finset.mul_sum]
    rw [Finset.sum_comm]
    have hm_step : ∀ m ∈ Finset.range 9,
        (∑ k : Fin 23, evenLegCoeff F k * (muEx k.1 m / ((4 : ℝ) ^ m * ((2 * m).factorial : ℝ)))) =
        (1 / ((4 : ℝ) ^ m * ((2 * m).factorial : ℝ))) * (∫ x, F x * x ^ (2 * m)) := fun m hm => by
      rw [integral_even_mul_even_pow_eq_sum_legCoeff hF heven hsupp
        (by have := Finset.mem_range.mp hm; omega), Finset.mul_sum]
      exact Finset.sum_congr rfl fun k _ => by ring
    rw [Finset.sum_congr rfl hm_step]
    have hi_pow : ∀ m : ℕ, Integrable fun x : ℝ =>
        (1 / ((4 : ℝ) ^ m * ((2 * m).factorial : ℝ))) * (F x * x ^ (2 * m)) := fun m =>
      ((hF.mul (continuous_pow _)).integrable_of_hasCompactSupport hFc.mul_right).const_mul _
    have hsum_int : (∑ m ∈ Finset.range 9,
        (1 / ((4 : ℝ) ^ m * ((2 * m).factorial : ℝ))) * (∫ x, F x * x ^ (2 * m))) =
        ∫ x, ∑ m ∈ Finset.range 9,
          (1 / ((4 : ℝ) ^ m * ((2 * m).factorial : ℝ))) * (F x * x ^ (2 * m)) := by
      rw [integral_finsetSum _ fun m _ => hi_pow m]
      exact Finset.sum_congr rfl fun m _ => (integral_const_mul _ _).symm
    rw [hsum_int]
    refine integral_congr_ae (Eventually.of_forall fun x => ?_)
    dsimp only; rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun m _ => ?_
    rw [div_pow, show (2 : ℝ) ^ (2 * m) = (4 : ℝ) ^ m by rw [pow_mul]; norm_num]
    ring
  have hch_bdd : ∀ x : ℝ, |x| ≤ 181 / 500 → |Real.cosh (x / 2)| ≤ 2 := fun x hx => by
    rw [abs_of_pos (Real.cosh_pos _), ← Real.cosh_abs]
    have hu1 : |x / 2| ≤ 1 := by rw [abs_div]; norm_num; linarith
    have hb0 := ((cosh_sinh_maclaurin_rem_bounds 0).2 (abs_nonneg _) hu1).1
    unfold coshMaclaurinRem at hb0
    simpa using hb0
  have hM_bdd : |evenPoleMoment F| ≤ (18 / 10 : ℝ) * Real.sqrt E := by
    unfold evenPoleMoment
    refine (abs_integral_mul_le_nine_tenths_norm hF hsupp (by fun_prop) (by norm_num) hch_bdd).trans_eq ?_
    ring
  have hrem_ch : ∀ x : ℝ, |x| ≤ 181 / 500 →
      |Real.cosh (x / 2) - ∑ m ∈ Finset.range 9, (x / 2) ^ (2 * m) / ((2 * m).factorial : ℝ)| ≤
      2 * (1 / 5 : ℝ) ^ 18 / ((18).factorial : ℝ) := fun x hx => by
    have hu_fifth : |x / 2| ≤ 1 / 5 := by rw [abs_div]; norm_num; linarith
    have hu1 : |x / 2| ≤ 1 := hu_fifth.trans (by norm_num)
    have hnn9 := ((cosh_sinh_maclaurin_rem_bounds 9).1 (abs_nonneg (x / 2))).1
    have hub9 := ((cosh_sinh_maclaurin_rem_bounds 9).2 (abs_nonneg (x / 2)) hu1).1
    have hev_rem : coshMaclaurinRem 9 (|x / 2|) =
        Real.cosh (x / 2) - ∑ m ∈ Finset.range 9, (x / 2) ^ (2 * m) / ((2 * m).factorial : ℝ) := by
      unfold coshMaclaurinRem
      rw [Real.cosh_abs]
      congr 1; refine Finset.sum_congr rfl fun m _ => ?_
      rw [pow_mul, pow_mul, sq_abs]
    rw [← hev_rem, abs_of_nonneg hnn9, show 2 * 9 = 18 by omega] at hub9 ⊢
    have hp18 : |x / 2| ^ 18 ≤ (1 / 5 : ℝ) ^ 18 := pow_le_pow_left₀ (abs_nonneg _) hu_fifth 18
    exact hub9.trans (div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hp18 (by norm_num)) (by positivity))
  have hdiff_eq : evenPoleMoment F - Vp =
      ∫ x, F x * (Real.cosh (x / 2) - ∑ m ∈ Finset.range 9, (x / 2) ^ (2 * m) / ((2 * m).factorial : ℝ)) := by
    unfold evenPoleMoment; rw [hVp_eq]
    rw [← integral_sub
      ((hF.mul (by fun_prop)).integrable_of_hasCompactSupport hFc.mul_right)
      ((hF.mul (by fun_prop)).integrable_of_hasCompactSupport hFc.mul_right)]
    exact integral_congr_ae (Eventually.of_forall fun x => by dsimp only; ring)
  have hdiff_bdd : |evenPoleMoment F - Vp| ≤ (1 / 1000000000000000000 : ℝ) * Real.sqrt E := by
    rw [hdiff_eq]
    refine (abs_integral_mul_le_nine_tenths_norm hF hsupp (by fun_prop) (by positivity) hrem_ch).trans ?_
    refine mul_le_mul_of_nonneg_right ?_ (Real.sqrt_nonneg E)
    norm_num [Nat.factorial]
  have hVp_bdd : |Vp| ≤ ((18 / 10 : ℝ) + 1 / 1000000000000000000) * Real.sqrt E := by
    have h := norm_add_le (evenPoleMoment F) (Vp - evenPoleMoment F)
    rw [add_sub_cancel, Real.norm_eq_abs, Real.norm_eq_abs, Real.norm_eq_abs, abs_sub_comm] at h
    linarith
  have hsq_diff : Vp ^ 2 - evenPoleMoment F ^ 2 ≤
      (1 / 1000000000000000000 : ℝ) * (2 * (18 / 10 : ℝ) + 1 / 1000000000000000000) * E := by
    refine (le_abs_self _).trans ?_
    rw [sq_sub_sq, abs_mul, abs_sub_comm]
    have hsum_abs : |Vp + evenPoleMoment F| ≤ (2 * (18 / 10 : ℝ) + 1 / 1000000000000000000) * Real.sqrt E := by
      have h := norm_add_le Vp (evenPoleMoment F)
      rw [Real.norm_eq_abs, Real.norm_eq_abs, Real.norm_eq_abs] at h; linarith
    calc |Vp + evenPoleMoment F| * |evenPoleMoment F - Vp|
        ≤ ((2 * (18 / 10 : ℝ) + 1 / 1000000000000000000) * Real.sqrt E) *
            ((1 / 1000000000000000000 : ℝ) * Real.sqrt E) :=
          mul_le_mul hsum_abs hdiff_bdd (abs_nonneg _) (by positivity)
      _ = (1 / 1000000000000000000 : ℝ) * (2 * (18 / 10 : ℝ) + 1 / 1000000000000000000) * (Real.sqrt E ^ 2) := by ring
      _ = _ := by rw [Real.sq_sqrt hE_nn]
  have hpi_hi := pi_d9_bounds.2
  have hpi_pos : (0 : ℝ) < Real.pi := Real.pi_pos
  have h2pi_diff : 2 * Real.pi * (Vp ^ 2 - evenPoleMoment F ^ 2) ≤ (1 / 1000000 : ℝ) * E := by
    have hm1 := mul_le_mul_of_nonneg_left hsq_diff (by positivity : 0 ≤ 2 * Real.pi)
    have hm2 : 2 * Real.pi * ((1 / 1000000000000000000 : ℝ) * (2 * (18 / 10 : ℝ) + 1 / 1000000000000000000) * E) ≤
        2 * (3141592654 / 1000000000 : ℝ) *
          ((1 / 1000000000000000000 : ℝ) * (2 * (18 / 10 : ℝ) + 1 / 1000000000000000000) * E) :=
      mul_le_mul_of_nonneg_right (by linarith) (by positivity)
    have hm3 : 2 * (3141592654 / 1000000000 : ℝ) *
        ((1 / 1000000000000000000 : ℝ) * (2 * (18 / 10 : ℝ) + 1 / 1000000000000000000) * E) ≤
        (1 / 1000000 : ℝ) * E := by
      rw [show 2 * (3141592654 / 1000000000 : ℝ) *
        ((1 / 1000000000000000000 : ℝ) * (2 * (18 / 10 : ℝ) + 1 / 1000000000000000000) * E) =
        (2 * (3141592654 / 1000000000 : ℝ) * (1 / 1000000000000000000) *
          (2 * (18 / 10) + 1 / 1000000000000000000)) * E by ring]
      exact mul_le_mul_of_nonneg_right (by norm_num) hE_nn
    linarith
  linarith

/-- **Coercive Even-Sector Weil Positivity Past `½ log 2` (`[−181/500, 181/500]`):**
Every even `F ∈ C²_c(ℝ)` supported in `[−181/500, 181/500]` satisfies
`fullZeroForm F ≥ (1 / 5000) ∫ F²`. -/
theorem fullZeroForm_ge_of_even_support_le_threeHundredSixtyTwoThousandths {F : ℝ → ℝ}
    (hF : ContDiff ℝ 2 F) (hFc : HasCompactSupport F)
    (heven : ∀ x, F (-x) = F x) (hsupp : ∀ x, 181 / 500 < |x| → F x = 0) :
    1 / 5000 * ∫ x, F x ^ 2 ≤ fullZeroForm F := by
  have henv := pi_mul_fullZeroForm_even_ge_of_envelope hF hFc heven hsupp
    measurable_evenEnvW abs_evenEnvW_le (fun _ hr => evenEnvW_eq_zero_of_gt hr)
    (fun _ hr => evenEnvW_valid hr)
  have hft := integral_cos_ft_sq_mul_evenEnvW_le hF.continuous hFc heven hsupp
  have hpole := two_pi_mul_evenPoleMoment_sq_ge hF.continuous hFc heven hsupp
  have hbessel := integral_sq_even_ge_sum_legCoeff hF.continuous hsupp
  set E : ℝ := ∫ x, F x ^ 2
  have hE_nn : 0 ≤ E := integral_nonneg fun x => sq_nonneg _
  obtain ⟨hpi_lo, hpi_hi⟩ := pi_d9_bounds
  have hdiag_E : diagMultFast * E ≤ ((577 / 800 : ℝ) * Real.pi - 24 / 1000000 - (1 / 5000 : ℝ) * Real.pi) * E := by
    refine mul_le_mul_of_nonneg_right ?_ hE_nn
    unfold diagMultFast
    linarith
  have hdiag_sum : (∑ i : Fin 23, diagMultFast * (2 * (181 / 500 : ℝ) / (4 * (i.1 : ℝ) + 1)) *
      (evenLegCoeff F i) ^ 2) ≤ diagMultFast * E := by
    have hdm_pos : 0 ≤ diagMultFast := by unfold diagMultFast; norm_num
    have hm := mul_le_mul_of_nonneg_left hbessel hdm_pos
    refine (le_of_eq ?_).trans hm
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun i _ => by ring
  have hquad_eq : 2 * Real.pi * (∑ k : Fin 23, evenLegCoeff F k * vPoleEx k) ^ 2 -
      (∑ i : Fin 23, ∑ j : Fin 23, evenLegCoeff F i * mEx i j * evenLegCoeff F j) +
      (∑ i : Fin 23, diagMultFast * (2 * (181 / 500 : ℝ) / (4 * (i.1 : ℝ) + 1)) * (evenLegCoeff F i) ^ 2) =
      ∑ i : Fin 23, ∑ j : Fin 23, evenLegCoeff F i * hEx i j * evenLegCoeff F j := by
    have hp_sq : 2 * Real.pi * (∑ k : Fin 23, evenLegCoeff F k * vPoleEx k) ^ 2 =
        ∑ i : Fin 23, ∑ j : Fin 23, evenLegCoeff F i * (2 * Real.pi * vPoleEx i * vPoleEx j) * evenLegCoeff F j := by
      rw [sq, Finset.sum_mul, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Finset.mul_sum, Finset.mul_sum]
      exact Finset.sum_congr rfl fun j _ => by ring
    have hd_sq : (∑ i : Fin 23, diagMultFast * (2 * (181 / 500 : ℝ) / (4 * (i.1 : ℝ) + 1)) * (evenLegCoeff F i) ^ 2) =
        ∑ i : Fin 23, ∑ j : Fin 23, evenLegCoeff F i *
          (if i.1 = j.1 then diagMultFast * (2 * (181 / 500 : ℝ) / (4 * (i.1 : ℝ) + 1)) else 0) *
          evenLegCoeff F j := by
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Finset.sum_eq_single i (fun j _ hji => by
          rw [if_neg (fun h => hji (Fin.ext h).symm)]; ring)
        (fun hi => absurd (Finset.mem_univ i) hi), if_pos rfl]
      ring
    rw [hp_sq, hd_sq, ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j _ => ?_
    unfold hEx; ring
  have hpsd := hEx_quadratic_nonneg (evenLegCoeff F)
  have hpi_diff : 0 ≤ Real.pi * fullZeroForm F - Real.pi * (1 / 5000 * E) := by
    linarith [henv, hft, hpole, hdiag_E, hdiag_sum, hquad_eq, hpsd]
  have hmul : Real.pi * (1 / 5000 * E) ≤ Real.pi * fullZeroForm F := by linarith
  exact le_of_mul_le_mul_left hmul Real.pi_pos


