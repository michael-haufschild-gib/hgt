sign-flipped (`flippedTwoVonMangoldt`, `liouvilleTwistedVonMangoldt`) or inflated
(`shiftedPairVonMangoldt`). -/
theorem re_weilFullFunctional_ge_of_full_window_of_atom_two_eq (w : ℕ → ℝ)
    (hw2 : w 2 = Real.log 2) {f : ℝ → ℂ} (hf : ContDiff ℝ 2 f)
    (hfs : tsupport f ⊆ Icc (-(181 / 500)) (181 / 500)) :
    1 / 5000 * ∫ x, ‖f x‖ ^ 2 ≤ (weilFullFunctional w (EF.weilTest f f)).re := by
  have hfc : HasCompactSupport f :=
    HasCompactSupport.of_support_subset_isCompact isCompact_Icc ((subset_tsupport f).trans hfs)
  have hk := tsupport_weilTest_subset_add hfs hfs
  have hB3 : (181 / 500 + 181 / 500 : ℝ) < Real.log 3 := by
    linarith [two_mul_threeHundredSixtyTwoThousandths_lt_log_three]
  have h2 : Real.log 2 = (ArithmeticFunction.vonMangoldt 2 : ℝ) :=
    (ArithmeticFunction.vonMangoldt_apply_prime Nat.prime_two).symm
  rw [weilFullFunctional_eq_of_eqOn hk (w' := fun n => (ArithmeticFunction.vonMangoldt n : ℝ))
    (fun n hn hlog => ?_), ← zeta_W_eq_weilFullFunctional hf hfc]
  · exact zetaZeroConfig_re_W_ge_of_aperture_le_threeHundredSixtyTwoThousandths hf hfs
  · have hn2 : n = 2 := by
      by_contra hne
      have h3 : (3 : ℝ) ≤ n := by exact_mod_cast (show 3 ≤ n by omega)
      have := Real.log_le_log (by norm_num) h3
      linarith
    subst hn2
    rw [hw2, h2]

private theorem natCast_le_two_pow : ∀ N : ℕ, (N : ℝ) ≤ (2 : ℝ) ^ N
  | 0 => by norm_num
  | N + 1 => by
    push_cast
    rw [pow_succ]
    have h1 : (1 : ℝ) ≤ (2 : ℝ) ^ N := one_le_pow₀ (by norm_num)
    linarith [natCast_le_two_pow N]

/-- **Non-Tempered Selectivity on `[−181/500, 181/500]`:**
There exist a non-zero shift `a ≠ 0` (so `shiftedZetaPair a` has off-line zeros) and an even
`F ∈ C²_c(ℝ)` supported in `[−181/500, 181/500]` with `0 < ∫ F²` such that
`(1 / 5000) ∫ F² ≤ Re W_ζ(F ⋆ F̃)` while `Re W_{Λ_a}(F ⋆ F̃) < −(1 / 5000) ∫ F² < 0`. -/
theorem exists_even_smooth_threeHundredSixtyTwoThousandths_zeta_pos_shiftedPair_neg :
    ∃ (a : ℝ) (F : ℝ → ℝ), a ≠ 0 ∧ ContDiff ℝ 2 F ∧ HasCompactSupport F ∧
      (∀ x, F (-x) = F x) ∧ (∀ x, 181 / 500 < |x| → F x = 0) ∧ 0 < (∫ x, F x ^ 2) ∧
      1 / 5000 * (∫ x, F x ^ 2) ≤
        (weilFullFunctional (fun n => (ArithmeticFunction.vonMangoldt n : ℝ))
          (EF.weilTest (fun x => (F x : ℂ)) (fun x => (F x : ℂ)))).re ∧
      (weilFullFunctional (shiftedPairVonMangoldt a)
        (EF.weilTest (fun x => (F x : ℂ)) (fun x => (F x : ℂ)))).re <
        -(1 / 5000 : ℝ) * (∫ x, F x ^ 2) := by
  obtain ⟨hcd, hcs, heven, hsupp, hsq_pos, hK2_pos⟩ := evenShiftedBumpWitness_properties
  let F := evenShiftedBumpWitness
  let Fc : ℝ → ℂ := fun x => (F x : ℂ)
  have hsupp_c : tsupport Fc ⊆ Icc (-(181 / 500)) (181 / 500) := by
    refine closure_minimal (fun x hx => ?_) isClosed_Icc
    by_contra hxI
    have hx' : 181 / 500 < |x| := by
      rw [mem_Icc, not_and_or, not_le, not_le] at hxI
      rcases hxI with h | h
      · rw [abs_of_neg (by linarith)]; linarith
      · rw [abs_of_pos (by linarith)]; exact h
    exact hx (by simp [Fc, hsupp x hx'])
  have hk_supp := tsupport_weilTest_subset_add hsupp_c hsupp_c
  have hB3 : (181 / 500 + 181 / 500 : ℝ) < Real.log 3 := by
    linarith [two_mul_threeHundredSixtyTwoThousandths_lt_log_three]
  have hzeta_ge : 1 / 5000 * (∫ x, F x ^ 2) ≤
      (weilFullFunctional (fun n => (ArithmeticFunction.vonMangoldt n : ℝ)) (EF.weilTest Fc Fc)).re := by
    rw [← fullZeroForm_eq_re_weilFullFunctional hcd.continuous hcs]
    exact fullZeroForm_ge_of_even_support_le_threeHundredSixtyTwoThousandths hcd hcs heven hsupp
  set W0 : ℝ := (weilFullFunctional (fun n => (ArithmeticFunction.vonMangoldt n : ℝ)) (EF.weilTest Fc Fc)).re
  set K2 : ℝ := (EF.weilTest Fc Fc (Real.log 2) + EF.weilTest Fc Fc (-Real.log 2)).re
  set c2 : ℝ := Real.log 2 / Real.sqrt 2 * K2
  have hc2_pos : 0 < c2 := by
    dsimp [c2]; exact mul_pos (div_pos (Real.log_pos one_lt_two) (by positivity)) hK2_pos
  set M_target : ℝ := (|W0| + 1 / 5000 * (∫ x, F x ^ 2) + c2 + 1) / c2
  set N : ℕ := Nat.ceil M_target + 1
  have hN_ne : ((N : ℕ) : ℝ) ≠ 0 := by positivity
  have hN_gt : M_target < (N : ℝ) := by
    dsimp [N]; push_cast; linarith [Nat.le_ceil M_target]
  have h2pow : M_target < (2 : ℝ) ^ ((N : ℕ) : ℝ) := by
    rw [Real.rpow_natCast]
    exact hN_gt.trans_le (natCast_le_two_pow N)
  refine ⟨(N : ℝ), F, hN_ne, hcd, hcs, heven, hsupp, hsq_pos, hzeta_ge, ?_⟩
  have hdiff := congrArg Complex.re
    (weilFullFunctional_sub_eq_atom_two hk_supp hB3
      (shiftedPairVonMangoldt (N : ℝ)) (fun n => (ArithmeticFunction.vonMangoldt n : ℝ)))
  rw [Complex.sub_re, Complex.re_ofReal_mul] at hdiff
  have hΛ2 : (ArithmeticFunction.vonMangoldt 2 : ℝ) = Real.log 2 :=
    ArithmeticFunction.vonMangoldt_apply_prime Nat.prime_two
  have hsp2 : shiftedPairVonMangoldt (N : ℝ) 2 =
      Real.log 2 * ((2 : ℝ) ^ ((N : ℕ) : ℝ) + (2 : ℝ) ^ (-((N : ℕ) : ℝ))) := by
    unfold shiftedPairVonMangoldt; rw [hΛ2]; norm_num
  have hrew : ((ArithmeticFunction.vonMangoldt 2 : ℝ) - shiftedPairVonMangoldt (N : ℝ) 2) / Real.sqrt 2 * K2 =
      c2 * (1 - (2 : ℝ) ^ ((N : ℕ) : ℝ) - (2 : ℝ) ^ (-((N : ℕ) : ℝ))) := by
    rw [hΛ2, hsp2]; dsimp [c2]; ring
  change (weilFullFunctional (shiftedPairVonMangoldt (N : ℝ)) (EF.weilTest Fc Fc)).re - W0 =
    ((ArithmeticFunction.vonMangoldt 2 : ℝ) - shiftedPairVonMangoldt (N : ℝ) 2) / Real.sqrt 2 * K2 at hdiff
  rw [hrew] at hdiff
  have hinv_nn : 0 ≤ (2 : ℝ) ^ (-((N : ℕ) : ℝ)) := Real.rpow_nonneg (by norm_num) _
  have hmul_gt : |W0| + 1 / 5000 * (∫ x, F x ^ 2) + c2 + 1 < c2 * (2 : ℝ) ^ ((N : ℕ) : ℝ) := by
    have := (div_lt_iff₀ hc2_pos).mp h2pow
    linarith [show (2 : ℝ) ^ ((N : ℕ) : ℝ) * c2 = c2 * (2 : ℝ) ^ ((N : ℕ) : ℝ) by ring]
  have hW0_le : W0 ≤ |W0| := le_abs_self W0
  nlinarith

/-- **Two-Sided Selectivity Battery Past `½ log 2` (`[−181/500, 181/500]`):**
1. The aperture `181 / 500` strictly crosses the prime-free horizon `(log 2) / 2`;
2. Every weight `w` with `w(2) = log 2` (in particular `ζ`) has full-sector coercive
   positivity `Re W_w(f ⋆ f̃) ≥ (1 / 5000) ∫ ‖f‖²` for all `f ∈ C²_c([−181/500, 181/500])`;
3. Flipping `w(2)` to `−log 2` (`liouvilleTwistedVonMangoldt` and `flippedTwoVonMangoldt`)
   breaks positivity on an odd `F ∈ C²_c([−181/500, 181/500])`;
4. Inflating `w(2)` via the non-tempered shifted pair `shiftedPairVonMangoldt a` (`a ≠ 0`)
   breaks positivity on an even `F ∈ C²_c([−181/500, 181/500])`. -/
theorem threeHundredSixtyTwoThousandths_selectivity_battery :
    Real.log 2 / 2 < (181 / 500 : ℝ) ∧
    (∀ (w : ℕ → ℝ), w 2 = Real.log 2 → ∀ f : ℝ → ℂ, ContDiff ℝ 2 f →
      tsupport f ⊆ Icc (-(181 / 500)) (181 / 500) →
      1 / 5000 * ∫ x, ‖f x‖ ^ 2 ≤ (weilFullFunctional w (EF.weilTest f f)).re) ∧
    (∃ F : ℝ → ℝ, ContDiff ℝ 2 F ∧ HasCompactSupport F ∧
      (∀ x, F (-x) = -F x) ∧ (∀ x, 181 / 500 < |x| → F x = 0) ∧ 0 < (∫ x, F x ^ 2) ∧
      (weilFullFunctional liouvilleTwistedVonMangoldt
        (EF.weilTest (fun x => (F x : ℂ)) (fun x => (F x : ℂ)))).re <
        -(1 / 1000 : ℝ) * (∫ x, F x ^ 2) ∧
      (weilFullFunctional flippedTwoVonMangoldt
        (EF.weilTest (fun x => (F x : ℂ)) (fun x => (F x : ℂ)))).re <
        -(1 / 1000 : ℝ) * (∫ x, F x ^ 2)) ∧
    (∃ (a : ℝ) (F : ℝ → ℝ), a ≠ 0 ∧ ContDiff ℝ 2 F ∧ HasCompactSupport F ∧
      (∀ x, F (-x) = F x) ∧ (∀ x, 181 / 500 < |x| → F x = 0) ∧ 0 < (∫ x, F x ^ 2) ∧
      (weilFullFunctional (shiftedPairVonMangoldt a)
        (EF.weilTest (fun x => (F x : ℂ)) (fun x => (F x : ℂ)))).re <
        -(1 / 5000 : ℝ) * (∫ x, F x ^ 2)) := by
  refine ⟨half_log_two_lt_threeHundredSixtyTwoThousandths,
    fun w hw2 f hf hfs => re_weilFullFunctional_ge_of_full_window_of_atom_two_eq w hw2 hf hfs, ?_, ?_⟩
  · obtain ⟨F, hF, hFc, hodd, hsupp, hpos, _, hneg⟩ :=
      exists_odd_smooth_threeHundredSixtyTwoThousandths_zeta_pos_liouville_neg
    have hsupp_c : tsupport (fun x => (F x : ℂ)) ⊆ Icc (-(181 / 500)) (181 / 500) := by
      refine closure_minimal (fun x hx => ?_) isClosed_Icc
      by_contra hxI
      have hx' : 181 / 500 < |x| := by
        rw [mem_Icc, not_and_or, not_le, not_le] at hxI
        rcases hxI with h | h
        · rw [abs_of_neg (by linarith)]; linarith
        · rw [abs_of_pos (by linarith)]; exact h
      exact hx (by simp [hsupp x hx'])
    have hk_supp := tsupport_weilTest_subset_add hsupp_c hsupp_c
    have hB3 : (181 / 500 + 181 / 500 : ℝ) < Real.log 3 := by
      linarith [two_mul_threeHundredSixtyTwoThousandths_lt_log_three]
    refine ⟨F, hF, hFc, hodd, hsupp, hpos, hneg, ?_⟩
    rw [weilFullFunctional_flippedTwo_eq_liouvilleTwist hk_supp hB3]
    exact hneg
  · obtain ⟨a, F, ha, hF, hFc, heven, hsupp, hpos, _, hneg⟩ :=
      exists_even_smooth_threeHundredSixtyTwoThousandths_zeta_pos_shiftedPair_neg
    exact ⟨a, F, ha, hF, hFc, heven, hsupp, hpos, hneg⟩


end
