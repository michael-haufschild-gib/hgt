  have hk_cd : ContDiff ℝ 2 (smooth f k) := (smooth_contDiff hf2 k).of_le (by norm_num)
  have hk_cs : HasCompactSupport (smooth f k) := smooth_compact f.hasCompactSupport k
  have hk_odd : ∀ x, smooth f k (-x) = -smooth f k x := smooth_odd_of_odd oddClampWitnessFun_neg k
  have hΛ2 : (ArithmeticFunction.vonMangoldt 2 : ℝ) = Real.log 2 :=
