private theorem polar_oddClampWitness_le :
    2 * (∫ x in Ici (0 : ℝ), polarDensity x * acorr oddClampWitnessSource x) ≤ (-793881 / 31250000000 : ℝ) := by
  have hc_f : Continuous (oddClampWitnessSource : ℝ → ℝ) := oddClampWitnessSource.continuous
