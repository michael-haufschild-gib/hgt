/-! ### Elementary `L¹`–`L²`, Legendre Moment Identity, and Taylor Remainder Control -/

private theorem integral_eq_intervalIntegral_window {g : ℝ → ℝ} (hg : Continuous g)
    (hsupp : ∀ x, 181 / 500 < |x| → g x = 0) :
    (∫ x, g x) = ∫ x in -(181 / 500 : ℝ)..(181 / 500), g x := by
  have hvan : ∀ x : ℝ, x ∉ Ioc (-1 : ℝ) 1 → g x = 0 := fun x hx => by
    apply hsupp
    by_contra hle; push Not at hle; have hx' := abs_le.mp hle
    exact hx ⟨by linarith [hx'.1], by linarith [hx'.2]⟩
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero hvan,
    ← intervalIntegral.integral_of_le (by norm_num : (-1 : ℝ) ≤ 1)]
  have hi : ∀ a b : ℝ, IntervalIntegrable g volume a b := fun a b => hg.intervalIntegrable a b
  rw [← intervalIntegral.integral_add_adjacent_intervals (hi (-1) (-(181 / 500))) (hi (-(181 / 500)) 1),
    ← intervalIntegral.integral_add_adjacent_intervals (hi (-(181 / 500)) (181 / 500)) (hi (181 / 500) 1)]
  have hL : (∫ x in (-1 : ℝ)..-(181 / 500), g x) = 0 := by
    rw [intervalIntegral_congr_Ioo (g := fun _ => 0) (by norm_num) fun x _ hx2 =>
      hsupp x (by rw [abs_of_neg (by linarith)]; linarith)]
    simp
  have hR : (∫ x in (181 / 500 : ℝ)..1, g x) = 0 := by
    rw [intervalIntegral_congr_Ioo (g := fun _ => 0) (by norm_num) fun x hx1 _ =>
      hsupp x (by rw [abs_of_pos (by linarith)]; exact hx1)]
    simp
  rw [hL, hR, zero_add, add_zero]

private theorem window_scale_integral_eq {g : ℝ → ℝ} (hg : Continuous g)
    (hsupp : ∀ x, 181 / 500 < |x| → g x = 0) :
    (181 / 500 : ℝ) * (∫ u in (-1 : ℝ)..1, g ((181 / 500 : ℝ) * u)) = ∫ x, g x := by
  rw [intervalIntegral.integral_comp_mul_left g (by norm_num : (181 / 500 : ℝ) ≠ 0), smul_eq_mul]
  rw [show (181 / 500 : ℝ) * -1 = -(181 / 500 : ℝ) by ring,
    show (181 / 500 : ℝ) * 1 = (181 / 500 : ℝ) by ring,
    ← integral_eq_intervalIntegral_window hg hsupp]
  field_simp

private theorem integral_abs_le_nine_tenths_sqrt {F : ℝ → ℝ} (hF : Continuous F)
    (hsupp : ∀ x, 181 / 500 < |x| → F x = 0) :
    (∫ x in -(181 / 500 : ℝ)..(181 / 500), |F x|) ≤ (9 / 10 : ℝ) * Real.sqrt (∫ x, F x ^ 2) := by
  set A : ℝ := 181 / 500
  set I1 : ℝ := ∫ x in (-A)..A, |F x|
  set E : ℝ := ∫ x, F x ^ 2
  have hE_eq : E = ∫ x in (-A)..A, F x ^ 2 :=
    integral_eq_intervalIntegral_window (hF.pow 2) fun x hx => by simp [hsupp x hx]
  have hE_nn : 0 ≤ E := integral_nonneg fun x => sq_nonneg _
  have hI1_nn : 0 ≤ I1 := intervalIntegral.integral_nonneg (by dsimp [A]; norm_num) fun _ _ => abs_nonneg _
  set s : ℝ := I1 / (2 * A)
  have hnn : 0 ≤ ∫ x in (-A)..A, (|F x| - s) ^ 2 :=
    intervalIntegral.integral_nonneg (by dsimp [A]; norm_num) fun _ _ => sq_nonneg _
  have hexp_fn : ∀ x : ℝ, (|F x| - s) ^ 2 = (F x ^ 2 - 2 * s * |F x|) + s ^ 2 := fun x => by
    rw [sub_sq, sq_abs]
  simp_rw [hexp_fn] at hnn
  rw [intervalIntegral.integral_add
    (((hF.pow 2).sub ((hF.abs).const_mul _)).intervalIntegrable _ _)
    (continuous_const.intervalIntegrable _ _),
    intervalIntegral.integral_sub ((hF.pow 2).intervalIntegrable _ _)
      (((hF.abs).const_mul _).intervalIntegrable _ _),
    intervalIntegral.integral_const_mul, intervalIntegral.integral_const, smul_eq_mul,
    ← hE_eq] at hnn
  change 0 ≤ E - 2 * s * I1 + (A - -A) * s ^ 2 at hnn
  have h2A : 2 * A ≠ 0 := by dsimp [A]; norm_num
  have halg : E - 2 * s * I1 + (A - -A) * s ^ 2 = E - I1 ^ 2 / (2 * A) := by
    dsimp [s]; field_simp [h2A]; ring
  rw [halg] at hnn
  have hI1_sq : I1 ^ 2 ≤ 2 * A * E := by
    have hpos : (0 : ℝ) < 2 * A := by dsimp [A]; norm_num
    have := (sub_nonneg.mp hnn)
    rwa [div_le_iff₀ hpos, mul_comm E (2 * A)] at this
  have hsq_le : I1 ^ 2 ≤ ((9 / 10 : ℝ) * Real.sqrt E) ^ 2 := by
    rw [mul_pow, Real.sq_sqrt hE_nn]
    dsimp [A] at hI1_sq
    linarith
  simpa [Real.sqrt_sq (by positivity : 0 ≤ (9 / 10 : ℝ) * Real.sqrt E)] using Real.le_sqrt_of_sq_le hsq_le

private theorem abs_integral_mul_le_nine_tenths_norm {F g : ℝ → ℝ} {M : ℝ}
    (hF : Continuous F) (hsupp : ∀ x, 181 / 500 < |x| → F x = 0)
    (hg : Continuous g) (hM0 : 0 ≤ M) (hg_bdd : ∀ x, |x| ≤ 181 / 500 → |g x| ≤ M) :
    |∫ x, F x * g x| ≤ M * (9 / 10 : ℝ) * Real.sqrt (∫ x, F x ^ 2) := by
  rw [integral_eq_intervalIntegral_window (hF.mul hg) fun x hx => by rw [hsupp x hx, zero_mul]]
  have hA : -(181 / 500 : ℝ) ≤ 181 / 500 := by norm_num
  have hpt : ∀ x ∈ Icc (-(181 / 500 : ℝ)) (181 / 500), |F x * g x| ≤ M * |F x| := fun x hx => by
    rw [abs_mul, mul_comm M |F x|]
    exact mul_le_mul_of_nonneg_left (hg_bdd x (abs_le.mpr hx)) (abs_nonneg _)
  have hhi := intervalIntegral.integral_mono_on hA ((hF.mul hg).intervalIntegrable _ _)
    (((hF.abs).const_mul M).intervalIntegrable _ _) fun x hx => (le_abs_self _).trans (hpt x hx)
  have hlo := intervalIntegral.integral_mono_on hA (((hF.abs).const_mul (-M)).intervalIntegrable _ _)
    ((hF.mul hg).intervalIntegrable _ _) fun x hx => by
      have := neg_le_of_abs_le (hpt x hx); linarith
  rw [intervalIntegral.integral_const_mul] at hhi hlo
  have habs_int : |∫ x in -(181 / 500 : ℝ)..(181 / 500), F x * g x| ≤
      M * ∫ x in -(181 / 500 : ℝ)..(181 / 500), |F x| := abs_le.mpr ⟨by linarith, hhi⟩
  exact habs_int.trans ((mul_le_mul_of_nonneg_left
    (integral_abs_le_nine_tenths_sqrt hF hsupp) hM0).trans_eq (by ring))

def evenLegCoeff (F : ℝ → ℝ) (k : Fin 23) : ℝ :=
  (4 * (k.1 : ℝ) + 1) / 2 * ∫ u in (-1 : ℝ)..1, F ((181 / 500 : ℝ) * u) * legP (2 * k.1) u

private theorem evenLeg_residual_orthog {F : ℝ → ℝ} (hF : Continuous F) (j : Fin 23) :
    (∫ u in (-1 : ℝ)..1,
      (F ((181 / 500 : ℝ) * u) - ∑ k : Fin 23, evenLegCoeff F k * legP (2 * k.1) u) *
        legP (2 * j.1) u) = 0 := by
  have hf1 : Continuous fun u : ℝ => F ((181 / 500 : ℝ) * u) := hF.comp (by fun_prop)
  have hS : Continuous fun u : ℝ => ∑ k : Fin 23, evenLegCoeff F k * legP (2 * k.1) u :=
    continuous_finset_sum _ fun k _ => continuous_const.mul (continuous_legP _)
  have hsub : ∀ u : ℝ,
      (F ((181 / 500 : ℝ) * u) - ∑ k : Fin 23, evenLegCoeff F k * legP (2 * k.1) u) * legP (2 * j.1) u =
      F ((181 / 500 : ℝ) * u) * legP (2 * j.1) u -
        ∑ k : Fin 23, evenLegCoeff F k * (legP (2 * k.1) u * legP (2 * j.1) u) := fun u => by
    rw [sub_mul, Finset.sum_mul]
    congr 1
    exact Finset.sum_congr rfl fun k _ => by ring
  simp_rw [hsub]
  rw [intervalIntegral.integral_sub
    ((hf1.mul (continuous_legP _)).intervalIntegrable _ _)
    ((continuous_finset_sum _ fun k _ => continuous_const.mul
      ((continuous_legP _).mul (continuous_legP _))).intervalIntegrable _ _),
    intervalIntegral.integral_finsetSum fun k _ =>
      (continuous_const.mul ((continuous_legP _).mul (continuous_legP _))).intervalIntegrable _ _]
  simp_rw [intervalIntegral.integral_const_mul]
  rw [Finset.sum_eq_single j (fun k _ hkj => by
      have hne : 2 * k.1 ≠ 2 * j.1 := fun h => hkj (Fin.ext (by omega))
      rw [legP_orthog hne, mul_zero])
    (fun hj => absurd (Finset.mem_univ j) hj)]
  rw [legP_sq_integral (2 * j.1)]
  unfold evenLegCoeff
  have hden : 4 * (j.1 : ℝ) + 1 ≠ 0 := by positivity
  have hcast : 2 * ((2 * j.1 : ℕ) : ℝ) + 1 = 4 * (j.1 : ℝ) + 1 := by push_cast; ring
  rw [hcast]
  field_simp [hden]

private theorem integral_sq_even_ge_sum_legCoeff {F : ℝ → ℝ} (hF : Continuous F)
    (hsupp : ∀ x, 181 / 500 < |x| → F x = 0) :
    (∑ k : Fin 23, (2 * (181 / 500 : ℝ) / (4 * (k.1 : ℝ) + 1)) * (evenLegCoeff F k) ^ 2) ≤
      ∫ x, F x ^ 2 := by
  let f1 : ℝ → ℝ := fun u => F ((181 / 500 : ℝ) * u)
  let S : ℝ → ℝ := fun u => ∑ k : Fin 23, evenLegCoeff F k * legP (2 * k.1) u
  let g : ℝ → ℝ := fun u => f1 u - S u
  have hf1 : Continuous f1 := hF.comp (by fun_prop)
  have hS : Continuous S := continuous_finset_sum _ fun k _ => continuous_const.mul (continuous_legP _)
  have hg : Continuous g := hf1.sub hS
  have hgS : (∫ u in (-1 : ℝ)..1, g u * S u) = 0 := by
    have hexp : ∀ u : ℝ, g u * S u = ∑ j : Fin 23, evenLegCoeff F j * (g u * legP (2 * j.1) u) := fun u => by
      dsimp [S]; rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun j _ => by ring
    simp_rw [hexp]
    rw [intervalIntegral.integral_finsetSum fun j _ =>
      (continuous_const.mul (hg.mul (continuous_legP _))).intervalIntegrable _ _]
    refine Finset.sum_eq_zero fun j _ => ?_
    rw [intervalIntegral.integral_const_mul, evenLeg_residual_orthog hF j, mul_zero]
  have hSS : (∫ u in (-1 : ℝ)..1, S u ^ 2) =
      ∑ j : Fin 23, (2 / (4 * (j.1 : ℝ) + 1)) * (evenLegCoeff F j) ^ 2 := by
    have hexp : ∀ u : ℝ, S u ^ 2 = ∑ j : Fin 23, evenLegCoeff F j * (S u * legP (2 * j.1) u) := fun u => by
      rw [sq]; dsimp [S]; rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun j _ => by ring
    simp_rw [hexp]
    rw [intervalIntegral.integral_finsetSum fun j _ =>
      (continuous_const.mul (hS.mul (continuous_legP _))).intervalIntegrable _ _]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [intervalIntegral.integral_const_mul]
    have horth := evenLeg_residual_orthog hF j
    have hsub_int : (∫ u in (-1 : ℝ)..1, f1 u * legP (2 * j.1) u) -
        (∫ u in (-1 : ℝ)..1, S u * legP (2 * j.1) u) = 0 := by
      rw [← intervalIntegral.integral_sub ((hf1.mul (continuous_legP _)).intervalIntegrable _ _)
        ((hS.mul (continuous_legP _)).intervalIntegrable _ _)]
      simpa [g, sub_mul] using horth
    have hSP : (∫ u in (-1 : ℝ)..1, S u * legP (2 * j.1) u) =
        (2 / (4 * (j.1 : ℝ) + 1)) * evenLegCoeff F j := by
      rw [← sub_eq_zero.mp hsub_int]
      unfold evenLegCoeff
      have hden : 4 * (j.1 : ℝ) + 1 ≠ 0 := by positivity
      change _ = (2 / (4 * (j.1 : ℝ) + 1)) * ((4 * (j.1 : ℝ) + 1) / 2 * ∫ u in (-1 : ℝ)..1, f1 u * legP (2 * j.1) u)
      field_simp [hden]
    rw [hSP]; ring
  have hpyth : (∫ u in (-1 : ℝ)..1, f1 u ^ 2) =
      (∫ u in (-1 : ℝ)..1, g u ^ 2) + (∫ u in (-1 : ℝ)..1, S u ^ 2) := by
    have hfn : ∀ u : ℝ, f1 u ^ 2 = (g u ^ 2 + S u ^ 2) + 2 * (g u * S u) := fun u => by
      dsimp [g]; ring
    simp_rw [hfn]
    rw [intervalIntegral.integral_add
      (((hg.pow 2).add (hS.pow 2)).intervalIntegrable _ _)
      (((hg.mul hS).const_mul 2).intervalIntegrable _ _),
      intervalIntegral.integral_add ((hg.pow 2).intervalIntegrable _ _) ((hS.pow 2).intervalIntegrable _ _),
      intervalIntegral.integral_const_mul, hgS, mul_zero, add_zero]
  have hgg : 0 ≤ ∫ u in (-1 : ℝ)..1, g u ^ 2 :=
    intervalIntegral.integral_nonneg (by norm_num) fun _ _ => sq_nonneg _
  have hscale := window_scale_integral_eq (g := fun x => F x ^ 2) (hF.pow 2) fun x hx => by simp [hsupp x hx]
  change (181 / 500 : ℝ) * (∫ u in (-1 : ℝ)..1, f1 u ^ 2) = ∫ x, F x ^ 2 at hscale
  have hle_u : (∑ j : Fin 23, (2 / (4 * (j.1 : ℝ) + 1)) * (evenLegCoeff F j) ^ 2) ≤
      ∫ u in (-1 : ℝ)..1, f1 u ^ 2 := by linarith
  have hm := mul_le_mul_of_nonneg_left hle_u (by norm_num : (0 : ℝ) ≤ 181 / 500)
  rw [hscale, Finset.mul_sum] at hm
  refine (le_of_eq ?_).trans hm
  exact Finset.sum_congr rfl fun k _ => by ring

private theorem integral_even_mul_even_pow_eq_sum_legCoeff {F : ℝ → ℝ} (hF : Continuous F)
    (heven : ∀ x, F (-x) = F x) (hsupp : ∀ x, 181 / 500 < |x| → F x = 0)
    {m : ℕ} (hm : m ≤ 22) :
    (∫ x, F x * x ^ (2 * m)) = ∑ k : Fin 23, evenLegCoeff F k * muEx k.1 m := by
  let f1 : ℝ → ℝ := fun u => F ((181 / 500 : ℝ) * u)
  let S : ℝ → ℝ := fun u => ∑ k : Fin 23, evenLegCoeff F k * legP (2 * k.1) u
  let g : ℝ → ℝ := fun u => f1 u - S u
  have hf1 : Continuous f1 := hF.comp (by fun_prop)
  have hS : Continuous S := continuous_finset_sum _ fun k _ => continuous_const.mul (continuous_legP _)
  have hg_cont : Continuous g := hf1.sub hS
  have hg_even : ∀ u, g (-u) = g u := fun u => by
    dsimp [g, f1, S]
    rw [mul_neg, heven]
    congr 1
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [legP_neg, pow_mul]; norm_num
  have horth_g : ∀ k ≤ 22, (∫ u in (-1 : ℝ)..1, g u * legP (2 * k) u) = 0 := fun k hk =>
    evenLeg_residual_orthog hF ⟨k, by omega⟩
  have hgm := legP_perp_even_pow_orthog hg_cont hg_even 22 horth_g m hm
  have hf1_eq : (∫ u in (-1 : ℝ)..1, f1 u * u ^ (2 * m)) =
      ∑ k : Fin 23, evenLegCoeff F k * (∫ u in (-1 : ℝ)..1, legP (2 * k.1) u * u ^ (2 * m)) := by
    have hsub : (∫ u in (-1 : ℝ)..1, f1 u * u ^ (2 * m)) -
        (∫ u in (-1 : ℝ)..1, S u * u ^ (2 * m)) = 0 := by
      rw [← intervalIntegral.integral_sub ((hf1.mul (continuous_pow _)).intervalIntegrable _ _)
        ((hS.mul (continuous_pow _)).intervalIntegrable _ _)]
      simpa [g, sub_mul] using hgm
    rw [sub_eq_zero.mp hsub]
    have hexp : ∀ u : ℝ, S u * u ^ (2 * m) =
        ∑ k : Fin 23, evenLegCoeff F k * (legP (2 * k.1) u * u ^ (2 * m)) := fun u => by
      dsimp [S]; rw [Finset.sum_mul]; exact Finset.sum_congr rfl fun k _ => by ring
    simp_rw [hexp]
    rw [intervalIntegral.integral_finsetSum fun k _ =>
      (continuous_const.mul ((continuous_legP _).mul (continuous_pow _))).intervalIntegrable _ _]
    exact Finset.sum_congr rfl fun k _ => intervalIntegral.integral_const_mul _ _
  have hscale := window_scale_integral_eq (g := fun x => F x * x ^ (2 * m))
    (hF.mul (continuous_pow _)) fun x hx => by rw [hsupp x hx, zero_mul]
  rw [← hscale]
  have hpull : (181 / 500 : ℝ) * (∫ u in (-1 : ℝ)..1, F ((181 / 500 : ℝ) * u) * ((181 / 500 : ℝ) * u) ^ (2 * m)) =
      (181 / 500 : ℝ) ^ (2 * m + 1) * (∫ u in (-1 : ℝ)..1, f1 u * u ^ (2 * m)) := by
    have hfn : ∀ u : ℝ, F ((181 / 500 : ℝ) * u) * ((181 / 500 : ℝ) * u) ^ (2 * m) =
        (181 / 500 : ℝ) ^ (2 * m) * (f1 u * u ^ (2 * m)) := fun u => by dsimp [f1]; rw [mul_pow]; ring
    simp_rw [hfn]
    rw [intervalIntegral.integral_const_mul, pow_succ]; ring
  rw [hpull, hf1_eq, Finset.mul_sum]
  refine Finset.sum_congr rfl fun k _ => ?_
  unfold muEx; ring

private theorem intervalIntegrable_sum_fn {ι : Type*} (s : Finset ι) {f : ι → ℝ → ℝ} {a b : ℝ}
    (hf : ∀ i ∈ s, IntervalIntegrable (f i) volume a b) :
    IntervalIntegrable (fun r => ∑ i ∈ s, f i r) volume a b := by
  simpa only [Finset.sum_apply] using IntervalIntegrable.sum s hf

def cosT44 (F : ℝ → ℝ) (r : ℝ) : ℝ :=
  ∑ m : Fin 23, (-1 : ℝ) ^ m.1 / ((2 * m.1).factorial : ℝ) * r ^ (2 * m.1) *
    (∫ x, F x * x ^ (2 * m.1))

private theorem integral_cosT44_sq_mul_evenEnvW_eq {F : ℝ → ℝ} (hF : Continuous F)
    (heven : ∀ x, F (-x) = F x) (hsupp : ∀ x, 181 / 500 < |x| → F x = 0) :
    (∫ r in (0 : ℝ)..(69 / 2), (cosT44 F r) ^ 2 * evenEnvW r) =
      ∑ j : Fin 23, ∑ k : Fin 23, evenLegCoeff F j * mEx j k * evenLegCoeff F k := by
  have hT_rew : ∀ r : ℝ, cosT44 F r =
      ∑ k : Fin 23, evenLegCoeff F k * ∑ m : Fin 23, qtEx k m * (r / (69 / 2 : ℝ)) ^ (2 * m.1) := fun r => by
    unfold cosT44
    have hm_eq : ∀ m : Fin 23, (∫ x, F x * x ^ (2 * m.1)) =
        ∑ k : Fin 23, evenLegCoeff F k * muEx k.1 m.1 := fun m =>
      integral_even_mul_even_pow_eq_sum_legCoeff hF heven hsupp (by omega)
    simp_rw [hm_eq, Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun m _ => ?_
    unfold qtEx
    rw [div_pow]
    have hT_ne : (69 / 2 : ℝ) ^ (2 * m.1) ≠ 0 := by positivity
    have hfac_ne : ((2 * m.1).factorial : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
    field_simp [hT_ne, hfac_ne]; ring
  have hsq_rew : ∀ r : ℝ, (cosT44 F r) ^ 2 * evenEnvW r =
      ∑ j : Fin 23, ∑ k : Fin 23, evenLegCoeff F j * evenLegCoeff F k *
        ∑ m2 : Fin 23, ∑ m1 : Fin 23, qtEx j m1 * qtEx k m2 *
          (evenEnvW r * (r / (69 / 2 : ℝ)) ^ (2 * (m1.1 + m2.1))) := fun r => by
    rw [hT_rew r, sq, Finset.sum_mul, Finset.sum_mul]
    refine Finset.sum_congr rfl fun j _ => ?_
    simp_rw [Finset.mul_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl fun k _ => ?_
    simp_rw [Finset.mul_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun m2 _ => ?_
    simp_rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun m1 _ => ?_
    rw [show 2 * (m1.1 + m2.1) = 2 * m1.1 + 2 * m2.1 by omega, pow_add]
    ring
  simp_rw [hsq_rew]
  have hint_m : ∀ n : ℕ, IntervalIntegrable (fun r => evenEnvW r * (r / (69 / 2 : ℝ)) ^ (2 * n))
      volume (0 : ℝ) (69 / 2) := fun n =>
    intervalIntegrable_evenEnvW_mul_cont (by fun_prop) _ _
  have hval_m : ∀ n : ℕ, (∫ r in (0 : ℝ)..(69 / 2), evenEnvW r * (r / (69 / 2 : ℝ)) ^ (2 * n)) =
      (69 / 2 : ℝ) * jNormEx n := fun n => by
    have hfn : ∀ r : ℝ, evenEnvW r * (r / (69 / 2 : ℝ)) ^ (2 * n) =
        (1 / (69 / 2 : ℝ) ^ (2 * n)) * (evenEnvW r * r ^ (2 * n)) := fun r => by
      rw [div_pow]; ring
    simp_rw [hfn]
    rw [intervalIntegral.integral_const_mul]
    unfold jNormEx
    rw [pow_succ]
    have hT_ne : (69 / 2 : ℝ) ^ (2 * n) ≠ 0 := by positivity
    field_simp [hT_ne]
  rw [intervalIntegral.integral_finsetSum fun j _ => intervalIntegrable_sum_fn _ fun k _ =>
    (intervalIntegrable_sum_fn _ fun m2 _ => intervalIntegrable_sum_fn _ fun m1 _ =>
      (hint_m (m1.1 + m2.1)).const_mul (qtEx j m1 * qtEx k m2)).const_mul (evenLegCoeff F j * evenLegCoeff F k)]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [intervalIntegral.integral_finsetSum fun k _ =>
    (intervalIntegrable_sum_fn _ fun m2 _ => intervalIntegrable_sum_fn _ fun m1 _ =>
      (hint_m (m1.1 + m2.1)).const_mul (qtEx j m1 * qtEx k m2)).const_mul (evenLegCoeff F j * evenLegCoeff F k)]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [intervalIntegral.integral_const_mul,
    intervalIntegral.integral_finsetSum fun m2 _ => intervalIntegrable_sum_fn _ fun m1 _ =>
      (hint_m (m1.1 + m2.1)).const_mul (qtEx j m1 * qtEx k m2)]
  have hm2_eq : ∀ m2 : Fin 23,
      (∫ r in (0 : ℝ)..(69 / 2), ∑ m1 : Fin 23, qtEx j m1 * qtEx k m2 *
        (evenEnvW r * (r / (69 / 2 : ℝ)) ^ (2 * (m1.1 + m2.1)))) =
      (69 / 2 : ℝ) * (bEx j m2 * qtEx k m2) := fun m2 => by
    rw [intervalIntegral.integral_finsetSum fun m1 _ => (hint_m (m1.1 + m2.1)).const_mul _]
    simp_rw [intervalIntegral.integral_const_mul, hval_m]
    unfold bEx
    rw [Finset.sum_mul, Finset.mul_sum]
    exact Finset.sum_congr rfl fun m1 _ => by ring
  simp_rw [hm2_eq, ← Finset.mul_sum]
  unfold mEx
  ring

private theorem integral_cos_ft_sq_mul_evenEnvW_le {F : ℝ → ℝ} (hF : Continuous F)
    (hFc : HasCompactSupport F) (heven : ∀ x, F (-x) = F x)
    (hsupp : ∀ x, 181 / 500 < |x| → F x = 0) :
    (∫ r in (0 : ℝ)..(69 / 2), (∫ x, F x * Real.cos (r * x)) ^ 2 * evenEnvW r) ≤
      (∑ j : Fin 23, ∑ k : Fin 23, evenLegCoeff F j * mEx j k * evenLegCoeff F k) +
        (23 / 1000000 : ℝ) * (∫ x, F x ^ 2) := by
  set E : ℝ := ∫ x, F x ^ 2
  have hE_nn : 0 ≤ E := integral_nonneg fun x => sq_nonneg _
  have hFT_cont : Continuous fun r : ℝ => ∫ x, F x * Real.cos (r * x) := by
    have h := (continuous_paperFT_of_hasCompactSupport (f := fun x => (F x : ℂ))
      (Complex.ofRealCLM.continuous.comp hF) (hFc.comp_left Complex.ofReal_zero)).comp
      Complex.continuous_ofReal
    have hre := Complex.continuous_re.comp h
    refine hre.congr fun r => ?_
    dsimp
    rw [paperFT_ofReal_even_eq_cos_integral hF hFc heven r, Complex.ofReal_re]
  have hP_cont : Continuous (cosT44 F) := by unfold cosT44; fun_prop
  have hpt_err : ∀ r ∈ Icc (0 : ℝ) (69 / 2),
      (∫ x, F x * Real.cos (r * x)) ^ 2 * evenEnvW r - (cosT44 F r) ^ 2 * evenEnvW r ≤
        (15 / 2 : ℝ) * (48 / 1000000000 : ℝ) * (2 * (9 / 10 : ℝ) + 48 / 1000000000) * E := fun r hr => by
    have hft_bdd : |∫ x, F x * Real.cos (r * x)| ≤ (9 / 10 : ℝ) * Real.sqrt E := by
      simpa using abs_integral_mul_le_nine_tenths_norm hF hsupp
        (Real.continuous_cos.comp (continuous_const.mul continuous_id)) zero_le_one
        (fun x _ => Real.abs_cos_le_one _)
    have hdiff_eq : (∫ x, F x * Real.cos (r * x)) - cosT44 F r =
        ∫ x, F x * (Real.cos (r * x) - ∑ m ∈ Finset.range 23,
          (-1 : ℝ) ^ m * (r * x) ^ (2 * m) / ((2 * m).factorial : ℝ)) := by
      unfold cosT44
      have hfin_eq : (∑ m : Fin 23, (-1 : ℝ) ^ m.1 / ((2 * m.1).factorial : ℝ) * r ^ (2 * m.1) *
          (∫ x, F x * x ^ (2 * m.1))) =
          ∑ m ∈ Finset.range 23, (-1 : ℝ) ^ m / ((2 * m).factorial : ℝ) * r ^ (2 * m) *
            (∫ x, F x * x ^ (2 * m)) :=
        (Fin.sum_univ_eq_sum_range (fun m => (-1 : ℝ) ^ m / ((2 * m).factorial : ℝ) * r ^ (2 * m) *
          (∫ x, F x * x ^ (2 * m))) 23)
      rw [hfin_eq]
      have hi_cos : Integrable fun x : ℝ => F x * Real.cos (r * x) :=
        (hF.mul (by fun_prop)).integrable_of_hasCompactSupport hFc.mul_right
      have hi_pow : ∀ m : ℕ, Integrable fun x : ℝ =>
          (-1 : ℝ) ^ m / ((2 * m).factorial : ℝ) * r ^ (2 * m) * (F x * x ^ (2 * m)) := fun m =>
        ((hF.mul (continuous_pow _)).integrable_of_hasCompactSupport hFc.mul_right).const_mul _
      have hsum_int : (∑ m ∈ Finset.range 23, (-1 : ℝ) ^ m / ((2 * m).factorial : ℝ) * r ^ (2 * m) *
          (∫ x, F x * x ^ (2 * m))) =
          ∫ x, ∑ m ∈ Finset.range 23, (-1 : ℝ) ^ m / ((2 * m).factorial : ℝ) * r ^ (2 * m) *
            (F x * x ^ (2 * m)) := by
        rw [integral_finsetSum _ fun m _ => hi_pow m]
        exact Finset.sum_congr rfl fun m _ => (integral_const_mul _ _).symm
      rw [hsum_int, ← integral_sub hi_cos (integrable_finset_sum _ fun m _ => hi_pow m)]
      refine integral_congr_ae (Eventually.of_forall fun x => ?_)
      dsimp only
      rw [mul_sub, Finset.mul_sum]
      congr 1
      refine Finset.sum_congr rfl fun m _ => ?_
      rw [mul_pow]; ring
    have hrem_cos : ∀ x : ℝ, |x| ≤ 181 / 500 →
        |Real.cos (r * x) - ∑ m ∈ Finset.range 23,
          (-1 : ℝ) ^ m * (r * x) ^ (2 * m) / ((2 * m).factorial : ℝ)| ≤
        (25 / 2 : ℝ) ^ 46 / ((46).factorial : ℝ) := fun x hx => by
      have hmac := abs_cos_sub_maclaurin_le 22 (r * x)
      have hrx : |r * x| ≤ 25 / 2 := by
        rw [abs_mul, abs_of_nonneg hr.1]
        calc r * |x| ≤ (69 / 2) * (181 / 500) := mul_le_mul hr.2 hx (abs_nonneg _) (by norm_num)
          _ ≤ 25 / 2 := by norm_num
      have hp46 : |r * x| ^ 46 ≤ (25 / 2 : ℝ) ^ 46 := pow_le_pow_left₀ (abs_nonneg _) hrx 46
      rw [show 2 * 22 + 2 = 46 by omega, show 22 + 1 = 23 by omega] at hmac
      exact hmac.trans (div_le_div_of_nonneg_right hp46 (by positivity))
    have hdiff_bdd : |(∫ x, F x * Real.cos (r * x)) - cosT44 F r| ≤ (48 / 1000000000 : ℝ) * Real.sqrt E := by
      rw [hdiff_eq]
      refine (abs_integral_mul_le_nine_tenths_norm hF hsupp (by fun_prop) (by positivity) hrem_cos).trans ?_
      refine mul_le_mul_of_nonneg_right ?_ (Real.sqrt_nonneg E)
      norm_num [Nat.factorial]
    have hP_bdd : |cosT44 F r| ≤ ((9 / 10 : ℝ) + 48 / 1000000000) * Real.sqrt E := by
      have htri : |cosT44 F r| ≤ |∫ x, F x * Real.cos (r * x)| +
          |(∫ x, F x * Real.cos (r * x)) - cosT44 F r| := by
        have h := norm_add_le (∫ x, F x * Real.cos (r * x)) (cosT44 F r - ∫ x, F x * Real.cos (r * x))
        rw [add_sub_cancel, Real.norm_eq_abs, Real.norm_eq_abs, Real.norm_eq_abs, abs_sub_comm] at h
        exact h
      linarith
    have hsq_diff : |(∫ x, F x * Real.cos (r * x)) ^ 2 - (cosT44 F r) ^ 2| ≤
        (48 / 1000000000 : ℝ) * (2 * (9 / 10 : ℝ) + 48 / 1000000000) * E := by
      rw [sq_sub_sq, abs_mul]
      have hsum_abs : |(∫ x, F x * Real.cos (r * x)) + cosT44 F r| ≤
          (2 * (9 / 10 : ℝ) + 48 / 1000000000) * Real.sqrt E := by
        have h := norm_add_le (∫ x, F x * Real.cos (r * x)) (cosT44 F r)
        rw [Real.norm_eq_abs, Real.norm_eq_abs, Real.norm_eq_abs] at h
        linarith
      calc |(∫ x, F x * Real.cos (r * x)) + cosT44 F r| * |(∫ x, F x * Real.cos (r * x)) - cosT44 F r|
          ≤ ((2 * (9 / 10 : ℝ) + 48 / 1000000000) * Real.sqrt E) * ((48 / 1000000000 : ℝ) * Real.sqrt E) :=
            mul_le_mul hsum_abs hdiff_bdd (abs_nonneg _) (by positivity)
        _ = (48 / 1000000000 : ℝ) * (2 * (9 / 10 : ℝ) + 48 / 1000000000) * (Real.sqrt E ^ 2) := by ring
        _ = _ := by rw [Real.sq_sqrt hE_nn]
    have hprod : ((∫ x, F x * Real.cos (r * x)) ^ 2 - (cosT44 F r) ^ 2) * evenEnvW r ≤
        |(∫ x, F x * Real.cos (r * x)) ^ 2 - (cosT44 F r) ^ 2| * |evenEnvW r| := by
      rw [← abs_mul]; exact le_abs_self _
    have hw_le := abs_evenEnvW_le r
    calc (∫ x, F x * Real.cos (r * x)) ^ 2 * evenEnvW r - (cosT44 F r) ^ 2 * evenEnvW r
        = ((∫ x, F x * Real.cos (r * x)) ^ 2 - (cosT44 F r) ^ 2) * evenEnvW r := by ring
      _ ≤ |(∫ x, F x * Real.cos (r * x)) ^ 2 - (cosT44 F r) ^ 2| * |evenEnvW r| := hprod
      _ ≤ ((48 / 1000000000 : ℝ) * (2 * (9 / 10 : ℝ) + 48 / 1000000000) * E) * (15 / 2 : ℝ) :=
          mul_le_mul hsq_diff hw_le (abs_nonneg _) (by positivity)
      _ = _ := by ring
  have hi1 : IntervalIntegrable (fun r => (∫ x, F x * Real.cos (r * x)) ^ 2 * evenEnvW r)
      volume (0 : ℝ) (69 / 2) := by
    simpa only [mul_comm _ (evenEnvW _)] using
      intervalIntegrable_evenEnvW_mul_cont (hFT_cont.pow 2) (0 : ℝ) (69 / 2)
  have hi2 : IntervalIntegrable (fun r => (cosT44 F r) ^ 2 * evenEnvW r) volume (0 : ℝ) (69 / 2) := by
    simpa only [mul_comm _ (evenEnvW _)] using
      intervalIntegrable_evenEnvW_mul_cont (hP_cont.pow 2) (0 : ℝ) (69 / 2)
  have hmono := intervalIntegral.integral_mono_on (by norm_num : (0 : ℝ) ≤ 69 / 2)
    (hi1.sub hi2) (continuous_const.intervalIntegrable _ _) hpt_err
  rw [intervalIntegral.integral_sub hi1 hi2, intervalIntegral.integral_const, smul_eq_mul,
    integral_cosT44_sq_mul_evenEnvW_eq hF heven hsupp] at hmono
  have hloss : (69 / 2 - 0 : ℝ) *
      ((15 / 2 : ℝ) * (48 / 1000000000 : ℝ) * (2 * (9 / 10 : ℝ) + 48 / 1000000000) * E) ≤
      (23 / 1000000 : ℝ) * E := by
    rw [show (69 / 2 - 0 : ℝ) *
      ((15 / 2 : ℝ) * (48 / 1000000000 : ℝ) * (2 * (9 / 10 : ℝ) + 48 / 1000000000) * E) =
      ((69 / 2 : ℝ) * (15 / 2) * (48 / 1000000000) * (2 * (9 / 10) + 48 / 1000000000)) * E by ring]
    exact mul_le_mul_of_nonneg_right (by norm_num) hE_nn
