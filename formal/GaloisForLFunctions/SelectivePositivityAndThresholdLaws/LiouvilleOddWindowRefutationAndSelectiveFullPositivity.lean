private theorem mEx_err_le (j k : Fin 23) : |mEx j k - mMid j k| ≤ mRad j k := by
  rcases le_total j.1 k.1 with hjk | hkj
  · fin_cases j
    · exact mEx_err_upper_0 k hjk
    · exact mEx_err_upper_1 k hjk
