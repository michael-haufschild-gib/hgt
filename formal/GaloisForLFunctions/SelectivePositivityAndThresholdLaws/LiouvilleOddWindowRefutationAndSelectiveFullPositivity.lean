/-! ### Certified `23 × 23` Legendre Quadratic Form and `LDLᵀ` Factorization -/

private theorem pi_d9_bounds :
    (3141592653 / 1000000000 : ℝ) ≤ Real.pi ∧ Real.pi ≤ (3141592654 / 1000000000 : ℝ) := by
  have hlo := Real.pi_gt_d20
  have hhi := Real.pi_lt_d20
  norm_num at hlo hhi
  exact ⟨by linarith, by linarith⟩

private theorem sum_fin23 (f : Fin 23 → ℝ) :
    (∑ i : Fin 23, f i) = f ⟨0, by omega⟩ + f ⟨1, by omega⟩ + f ⟨2, by omega⟩ + f ⟨3, by omega⟩ + f ⟨4, by omega⟩ + f ⟨5, by omega⟩ + f ⟨6, by omega⟩ + f ⟨7, by omega⟩ + f ⟨8, by omega⟩ + f ⟨9, by omega⟩ + f ⟨10, by omega⟩ + f ⟨11, by omega⟩ + f ⟨12, by omega⟩ + f ⟨13, by omega⟩ + f ⟨14, by omega⟩ + f ⟨15, by omega⟩ + f ⟨16, by omega⟩ + f ⟨17, by omega⟩ + f ⟨18, by omega⟩ + f ⟨19, by omega⟩ + f ⟨20, by omega⟩ + f ⟨21, by omega⟩ + f ⟨22, by omega⟩ := by
  simp only [Fin.sum_univ_succ, Fin.sum_univ_zero, add_zero, ← add_assoc]
  rfl

private theorem sum_fin23_erase (f : Fin 23 → ℝ) (i : Fin 23) :
    (∑ j ∈ Finset.univ.erase i, f j) = (∑ j : Fin 23, f j) - f i := by
  linarith [Finset.add_sum_erase Finset.univ f (Finset.mem_univ i)]

private theorem dot23_vec_err_le (x y xm rx ym ry : Fin 23 → ℝ) (target err : ℝ)
    (hx : ∀ i, |x i - xm i| ≤ rx i) (hy : ∀ i, |y i - ym i| ≤ ry i)
    (herr : |(∑ i : Fin 23, xm i * ym i) - target| +
      (∑ i : Fin 23, (rx i * |ym i| + |xm i| * ry i + rx i * ry i)) ≤ err) :
    |(∑ i : Fin 23, x i * y i) - target| ≤ err := by
  have hterm : ∀ i : Fin 23,
      |x i * y i - xm i * ym i| ≤ rx i * |ym i| + |xm i| * ry i + rx i * ry i := fun i => by
    have hid : x i * y i - xm i * ym i =
        (x i - xm i) * ym i + (xm i * (y i - ym i) + (x i - xm i) * (y i - ym i)) := by ring
    rw [hid]
    have hrx0 : 0 ≤ rx i := (abs_nonneg _).trans (hx i)
    have ht1 : |(x i - xm i) * ym i| ≤ rx i * |ym i| := by
      rw [abs_mul]; exact mul_le_mul_of_nonneg_right (hx i) (abs_nonneg _)
    have ht2 : |xm i * (y i - ym i)| ≤ |xm i| * ry i := by
      rw [abs_mul]; exact mul_le_mul_of_nonneg_left (hy i) (abs_nonneg _)
    have ht3 : |(x i - xm i) * (y i - ym i)| ≤ rx i * ry i := by
      rw [abs_mul]; exact mul_le_mul (hx i) (hy i) (abs_nonneg _) hrx0
    have ha1 : |(x i - xm i) * ym i + (xm i * (y i - ym i) + (x i - xm i) * (y i - ym i))| ≤
        |(x i - xm i) * ym i| + |xm i * (y i - ym i) + (x i - xm i) * (y i - ym i)| := by
      simpa [Real.norm_eq_abs] using norm_add_le ((x i - xm i) * ym i)
        (xm i * (y i - ym i) + (x i - xm i) * (y i - ym i))
    have ha2 : |xm i * (y i - ym i) + (x i - xm i) * (y i - ym i)| ≤
        |xm i * (y i - ym i)| + |(x i - xm i) * (y i - ym i)| := by
      simpa [Real.norm_eq_abs] using norm_add_le (xm i * (y i - ym i)) ((x i - xm i) * (y i - ym i))
    linarith
  have hsum_diff : |(∑ i : Fin 23, x i * y i) - (∑ i : Fin 23, xm i * ym i)| ≤
      ∑ i : Fin 23, (rx i * |ym i| + |xm i| * ry i + rx i * ry i) := by
    rw [← Finset.sum_sub_distrib]
    exact (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i _ => hterm i)
  have htri : |(∑ i : Fin 23, x i * y i) - target| ≤
      |(∑ i : Fin 23, x i * y i) - (∑ i : Fin 23, xm i * ym i)| +
        |(∑ i : Fin 23, xm i * ym i) - target| := by
    have h := norm_add_le ((∑ i : Fin 23, x i * y i) - (∑ i : Fin 23, xm i * ym i))
      ((∑ i : Fin 23, xm i * ym i) - target)
    simpa only [Real.norm_eq_abs, sub_add_sub_cancel] using h
  linarith

def muEx (k m : ℕ) : ℝ :=
  (181 / 500 : ℝ) ^ (2 * m + 1) * ∫ u in (-1 : ℝ)..1, legP (2 * k) u * u ^ (2 * m)

def qtEx (k m : Fin 23) : ℝ :=
  (-1 : ℝ) ^ m.1 * muEx k.1 m.1 * (69 / 2 : ℝ) ^ (2 * m.1) / ((2 * m.1).factorial : ℝ)

