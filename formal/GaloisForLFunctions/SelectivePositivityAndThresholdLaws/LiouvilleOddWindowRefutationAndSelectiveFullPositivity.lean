    (hsupp : ∀ x, 181 / 500 < |x| → F x = 0) :
    1 / 5000 * ∫ x, F x ^ 2 ≤ fullZeroForm F := by
  have hse : ∀ x, 181 / 500 < |x| → evenPartReal F x = 0 := fun x hx => by
    unfold evenPartReal
    rw [hsupp x hx, hsupp (-x) (by rwa [abs_neg])]
    norm_num
  have hso : ∀ x, 181 / 500 < |x| → oddPartReal F x = 0 := fun x hx => by
    unfold oddPartReal
