import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.TheGenusIsTheApertureOfTheRadical

/-!
# Numerical equivalence on a curve is the Frobenius ideal

On `C × C` the classes of the Frobenius span satisfy `P(F) ≡ 0` modulo numerical equivalence, with
`P` the characteristic polynomial: the span is `ℤ[F]/(P(F))`. This file proves the exact analog on
the scaling surface of a curve datum, with compactly supported tests as cycles and the tower
`T_q g = g(· − log q)` as Frobenius:

  **a `C²` test is numerically trivial — its transform vanishes at every zero — iff it is
  `P(T_q) g` for a `C²` test `g`** (`radical_iff_eq_frobPolyTest`),

where `P = ∏_b (z − b)` runs over the distinct eigenvalues (`frobPoly`). One direction is
Cayley–Hamilton (`paperFT_frobPolyTest_zero`). For the other:

* Poisson summation along the period of an eigenvalue `b` turns the vanishing at its zeros into
  `Σ_j f(s + j log q) b^j = 0` for every `s` (`tsum_sample_mul_pow_eq_zero`).
* **Division by one factor** (`exists_div_tower_sub`): such an `f` supported in `[−a, a]` is
  `g(· − L) − b·g` for a `C²` test `g` supported in `[−a, a]`. The candidate
  `g_N = −b⁻¹ Σ_{i<N} b^{−i} f(· − iL)` telescopes to `f` up to a far copy `b^{−N} f(· − NL)`, and
  vanishes on `[a, a + L)` by the sample identity; a smooth cutoff there removes the copy.
* The quotient keeps the vanishing at the other eigenvalues (`tsum_sample_sub_tower`), so the
  factors divide one at a time (`exists_div_prod_tower`), and the transforms `P(e^{izL}) ĝ`
  identify the result with `P(T_q) g` by Fourier injectivity.

So numerical equivalence on the scaling surface of a curve is the principal ideal generated by the
Frobenius polynomial of the tower — the finite-genus counterpart of `InfiniteGenusLaw`, where the
ideal is zero.
-/

open Complex MeasureTheory Finset Polynomial
open scoped Real ComplexConjugate
open Zeta23 GaloisForLFunctions.HTGeometry

noncomputable section

namespace GaloisForLFunctions.ArithmeticCastelnuovoSeveri

/-! ### Samples along a lattice -/

/-- The samples `f(s + jL)` of a test supported in `[−a, a]` are finitely many. -/
theorem summable_sample_mul_pow {f : ℝ → ℂ} (hf : Continuous f) {a L : ℝ} (hL : 0 < L)
    (hfs : tsupport f ⊆ Set.Icc (-a) a) (s : ℝ) (b : ℂ) :
    Summable fun j : ℤ => f (s + j * L) * b ^ j := by
  refine summable_of_hasFiniteSupport ((Set.finite_Icc (⌈(-a - s) / L⌉)
    (⌈(-a - s) / L⌉ + ⌈2 * a / L⌉₊)).subset fun j hj => ?_)
  have hfj : f (s + j * L) ≠ 0 := fun h => hj (by simp [h])
  obtain ⟨h1, h2⟩ := window_of_support hf hL hfs s hfj
  exact ⟨h1, h2.le⟩

/-- **The quotient keeps the vanishing.** If `f = g(· − L) − b₀ g`, then
`Σ_j f(s + jL) b^j = (b − b₀) Σ_j g(s + jL) b^j`. -/
theorem tsum_sample_sub_tower {f g : ℝ → ℂ} (hg : Continuous g) {a L : ℝ} (hL : 0 < L)
    (hgs : tsupport g ⊆ Set.Icc (-a) a) {b₀ : ℂ} (hfg : ∀ u, f u = g (u - L) - b₀ * g u) (s : ℝ)
    {b : ℂ} (hb : b ≠ 0) :
    ∑' j : ℤ, f (s + j * L) * b ^ j = (b - b₀) * ∑' j : ℤ, g (s + j * L) * b ^ j := by
  have hS := summable_sample_mul_pow hg hL hgs s b
  have hshift : ∑' j : ℤ, g (s + j * L - L) * b ^ j = b * ∑' j : ℤ, g (s + j * L) * b ^ j := by
    rw [← (Equiv.addRight (1 : ℤ)).tsum_eq, ← tsum_mul_left]
    refine tsum_congr fun j => ?_
    simp only [Equiv.coe_addRight]
    rw [zpow_add_one₀ hb, show s + ((j + 1 : ℤ) : ℝ) * L - L = s + j * L by push_cast; ring]
    ring
  have hS' : Summable fun j : ℤ => g (s + j * L - L) * b ^ j := by
    have h := (summable_sample_mul_pow hg hL hgs s b).mul_left b
    rw [← (Equiv.addRight (1 : ℤ)).summable_iff]
    refine h.congr fun j => ?_
    simp only [Function.comp_apply, Equiv.coe_addRight]
    rw [zpow_add_one₀ hb, show s + ((j + 1 : ℤ) : ℝ) * L - L = s + j * L by push_cast; ring]
    ring
  have e : ∀ j : ℤ, f (s + j * L) * b ^ j =
      g (s + j * L - L) * b ^ j - b₀ * (g (s + j * L) * b ^ j) := fun j => by
    rw [hfg]; ring
  rw [tsum_congr e, hS'.tsum_sub (hS.mul_left b₀), tsum_mul_left, hshift]
  ring

/-! ### Division by one factor -/

/-- A smooth cutoff, `1` on `(−∞, c]` and `0` on `[c + δ, ∞)`. -/
def cutoff (c δ : ℝ) (u : ℝ) : ℝ := Real.smoothTransition ((c + δ - u) / δ)

theorem cutoff_contDiff (c δ : ℝ) : ContDiff ℝ 2 (cutoff c δ) :=
  Real.smoothTransition.contDiff.comp ((contDiff_const.sub contDiff_id).div_const δ)

theorem cutoff_eq_one {c δ : ℝ} (hδ : 0 < δ) {u : ℝ} (hu : u ≤ c) : cutoff c δ u = 1 :=
  Real.smoothTransition.one_of_one_le (by rw [le_div_iff₀ hδ]; linarith)

theorem cutoff_eq_zero {c δ : ℝ} (hδ : 0 < δ) {u : ℝ} (hu : c + δ ≤ u) : cutoff c δ u = 0 :=
  Real.smoothTransition.zero_of_nonpos (div_nonpos_of_nonpos_of_nonneg (by linarith) hδ.le)

/-- **Division by `T_L − b`.** A `C²` test supported in `[−a, a]` whose samples satisfy
`Σ_j f(s + jL) b^j = 0` for every `s` is `g(· − L) − b·g` for a `C²` test `g` supported in
`[−a, a]`. -/
theorem exists_div_tower_sub {f : ℝ → ℂ} (hf : ContDiff ℝ 2 f) {a L : ℝ} (hL : 0 < L)
    (hfs : tsupport f ⊆ Set.Icc (-a) a) {b : ℂ} (hb : b ≠ 0)
    (hvan : ∀ s, ∑' j : ℤ, f (s + j * L) * b ^ j = 0) :
    ∃ g : ℝ → ℂ, ContDiff ℝ 2 g ∧ tsupport g ⊆ Set.Icc (-a) a ∧
      ∀ u, f u = g (u - L) - b * g u := by
  have hfz : ∀ u, f u ≠ 0 → -a < u ∧ u < a := fun u hu =>
    mem_Ioo_of_ne_zero hf.continuous hfs hu
  set N : ℕ := ⌈2 * a / L⌉₊ + 1 with hN
  have hNL : 2 * a + L ≤ N * L := by
    have := Nat.le_ceil (2 * a / L)
    rw [div_le_iff₀ hL] at this
    rw [hN]
    push_cast
    nlinarith
  -- the telescoping candidate `g_N = −b⁻¹ Σ_{i<N} b^{−i} f(· − iL)`
  set A : ℝ → ℕ → ℂ := fun u i => b ^ (-(i : ℤ)) * f (u - i * L) with hA
  set gN : ℝ → ℂ := fun u => -(b⁻¹ * ∑ i ∈ range N, A u i) with hgN
  have hshiftA : ∀ u (i : ℕ), b⁻¹ * A (u - L) i = A u (i + 1) := fun u i => by
    simp only [hA]
    rw [← mul_assoc, show b⁻¹ * b ^ (-(i : ℤ)) = b ^ (-((i + 1 : ℕ) : ℤ)) by
      rw [← zpow_neg_one, ← zpow_add₀ hb]; push_cast; ring_nf]
    congr 2
    push_cast
    ring
  have htel : ∀ u, gN (u - L) - b * gN u = f u - b ^ (-(N : ℤ)) * f (u - N * L) := by
    intro u
    have h1 : gN (u - L) = -∑ i ∈ range N, A u (i + 1) := by
      simp only [hgN, Finset.mul_sum, hshiftA]
    have h2 : b * gN u = -∑ i ∈ range N, A u i := by
      simp only [hgN]
      rw [mul_neg, ← mul_assoc, mul_inv_cancel₀ hb, one_mul]
    have h3 := Finset.sum_range_sub (A u) N
    rw [h1, h2]
    have hA0 : A u 0 = f u := by simp [hA]
    have hAN : A u N = b ^ (-(N : ℤ)) * f (u - N * L) := rfl
    rw [Finset.sum_sub_distrib] at h3
    rw [← hA0, ← hAN]
    linear_combination -h3
  -- `g_N` vanishes on `[a, a + L)`
  have hgN0 : ∀ v, a ≤ v → v < a + L → gN v = 0 := by
    intro v hv1 hv2
    have hsum : ∑ i ∈ range N, A v i = ∑' j : ℤ, f (v + j * L) * b ^ j := by
      rw [tsum_eq_sum (s := (range N).image fun i : ℕ => -(i : ℤ)) fun j hj => ?_]
      · rw [Finset.sum_image fun i _ i' _ h => by simpa using h]
        refine Finset.sum_congr rfl fun i _ => ?_
        simp only [hA]
        rw [show v + ((-(i : ℤ) : ℤ) : ℝ) * L = v - i * L by push_cast; ring]
        ring
      · by_contra hne
        have hfj : f (v + j * L) ≠ 0 := fun h => hne (by rw [h, zero_mul])
        obtain ⟨h1, h2⟩ := hfz _ hfj
        have hjneg : (j : ℝ) * L < 0 := by linarith
        have hj0 : j < 0 := by
          by_contra h; push Not at h
          have : (0 : ℝ) ≤ j := by exact_mod_cast h
          nlinarith
        have hjN : -(N : ℝ) < j := by
          by_contra h; push Not at h
          have : (j : ℝ) * L ≤ -(N : ℝ) * L := mul_le_mul_of_nonneg_right h hL.le
          linarith
        apply hj
        refine Finset.mem_image.mpr ⟨(-j).toNat, Finset.mem_range.mpr ?_, ?_⟩
        · have : -j < (N : ℤ) := by
            have : (-j : ℝ) < N := by linarith
            exact_mod_cast this
          omega
        · omega
    simp only [hgN, hsum, hvan v, mul_zero, neg_zero]
  -- the cutoff quotient
  set g : ℝ → ℂ := fun u => (cutoff (a + L / 3) (L / 3) u : ℂ) * gN u with hg
  have hL3 : 0 < L / 3 := by positivity
  have hgeq : ∀ v, v ≤ a + L / 3 → g v = gN v := fun v hv => by
    simp only [hg, cutoff_eq_one hL3 hv, Complex.ofReal_one, one_mul]
  have hgz : ∀ v, a ≤ v → g v = 0 := by
    intro v hv
    simp only [hg]
    rcases lt_or_ge v (a + L) with h | h
    · rw [hgN0 v hv h, mul_zero]
    · rw [cutoff_eq_zero hL3 (by linarith), Complex.ofReal_zero, zero_mul]
  have hgzl : ∀ v, v < -a → g v = 0 := by
    intro v hv
    have : gN v = 0 := by
      simp only [hgN]
      rw [Finset.sum_eq_zero fun i _ => ?_, mul_zero, neg_zero]
      simp only [hA]
      have : f (v - i * L) = 0 := by
        by_contra hne
        have := (hfz _ hne).1
        have : (0 : ℝ) ≤ i * L := mul_nonneg (Nat.cast_nonneg i) hL.le
        linarith
      rw [this, mul_zero]
    simp only [hg, this, mul_zero]
  refine ⟨g, ?_, ?_, ?_⟩
  · -- `C²`: a cutoff times a finite combination of translates
    have hgNc : ContDiff ℝ 2 gN := by
      simp only [hgN, hA]
      exact (contDiff_const.mul (ContDiff.sum fun i _ => contDiff_const.mul
        (hf.comp (contDiff_id.sub contDiff_const)))).neg
    exact (Complex.ofRealCLM.contDiff.comp (cutoff_contDiff _ _)).mul hgNc
  · refine closure_minimal (fun v hv => ?_) isClosed_Icc
    by_contra hout
    rw [Set.mem_Icc, not_and_or, not_le, not_le] at hout
    rcases hout with h | h
    · exact hv (hgzl v h)
    · exact hv (hgz v h.le)
  · intro u
    have hfar : f (u - N * L) = 0 ∨ a < u := by
      by_cases hu : a < u
      · exact Or.inr hu
      · left
        by_contra hne
        have := (hfz _ hne).1
        push Not at hu
        linarith
    rcases le_or_gt u a with hu | hu
    · rw [hgeq (u - L) (by linarith), hgeq u (by linarith), htel u]
      rcases hfar with h | h
      · rw [h, mul_zero, sub_zero]
      · exact absurd h (not_lt.mpr hu)
    · have hfu : f u = 0 := by
        by_contra hne
        exact absurd (hfz u hne).2 (not_lt.mpr hu.le)
      rw [hfu, hgz u hu.le, mul_zero, sub_zero]
      rcases le_or_gt a (u - L) with h | h
      · rw [hgz (u - L) h]
      · rw [hgeq (u - L) (by linarith)]
        have hu' : u < a + L := by linarith
        have := htel u
        rw [hgN0 u hu.le hu', mul_zero, sub_zero, hfu, zero_sub] at this
        have hfN : f (u - N * L) = 0 := by
          by_contra hne
          have := (hfz _ hne).1
          linarith
        rw [this, hfN, mul_zero, neg_zero]

/-- **Division by a product of factors.** A `C²` test supported in `[−a, a]` whose samples satisfy
`Σ_j f(s + jL) b^j = 0` for every `s` and every `b` in a finite set `B ∌ 0` has transform
`∏_{b ∈ B} (e^{izL} − b) · ĝ(z)` for a `C²` test `g` supported in `[−a, a]`. -/
theorem exists_div_prod_tower {L : ℝ} (hL : 0 < L) (B : Finset ℂ) (hB : ∀ b ∈ B, b ≠ 0) :
    ∀ {a : ℝ} {f : ℝ → ℂ}, ContDiff ℝ 2 f → tsupport f ⊆ Set.Icc (-a) a →
      (∀ b ∈ B, ∀ s, ∑' j : ℤ, f (s + j * L) * b ^ j = 0) →
      ∃ g : ℝ → ℂ, ContDiff ℝ 2 g ∧ tsupport g ⊆ Set.Icc (-a) a ∧
        ∀ z : ℂ, paperFT f z = (∏ b ∈ B, (cexp (I * z * L) - b)) * paperFT g z := by
  classical
  induction B using Finset.induction_on with
  | empty =>
    intro a f hf hfs _
    exact ⟨f, hf, hfs, fun z => by simp⟩
  | insert b₀ B hb₀ ih =>
    intro a f hf hfs hvan
    have hB' : ∀ b ∈ B, b ≠ 0 := fun b hb => hB b (Finset.mem_insert_of_mem hb)
    obtain ⟨g₁, hg₁, hg₁s, hfg⟩ := exists_div_tower_sub hf hL hfs (hB b₀ (Finset.mem_insert_self _ _))
      (hvan b₀ (Finset.mem_insert_self _ _))
    have hvan₁ : ∀ b ∈ B, ∀ s, ∑' j : ℤ, g₁ (s + j * L) * b ^ j = 0 := by
      intro b hb s
      have h := tsum_sample_sub_tower hg₁.continuous hL hg₁s hfg s (hB' b hb)
      rw [hvan b (Finset.mem_insert_of_mem hb) s] at h
      have hne : b - b₀ ≠ 0 := sub_ne_zero.mpr fun h' => hb₀ (h' ▸ hb)
      exact ((mul_eq_zero.mp h.symm).resolve_left hne)
    obtain ⟨g, hg, hgs, hFT⟩ := ih hB' hg₁ hg₁s hvan₁
    refine ⟨g, hg, hgs, fun z => ?_⟩
    have hg₁c : HasCompactSupport g₁ := RHTower.hasCompactSupport_of_tsupport_subset_Icc hg₁s
    have hfeq : f = translate L g₁ + (-b₀) • g₁ := by
      funext u
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, translate, hfg u]
      ring
    rw [hfeq, paperFT_add (show Continuous (translate L g₁) from
        hg₁.continuous.comp (continuous_sub_right _))
      (translate_hasCompactSupport hg₁c _) (hg₁.continuous.const_smul _) hg₁c.smul_left,
      paperFT_smul, paperFT_translate, Finset.prod_insert hb₀, hFT z]
    ring

namespace CurveDatum

variable {ι : Type*} [Fintype ι] (D : CurveDatum ι) (hD : ∀ i, ‖D.β i‖ ≤ D.sqrtq)

/-- **Numerical equivalence on the scaling surface of a curve is the Frobenius ideal.** A `C²`
compactly supported test has transform vanishing at every zero of the curve iff it is
`P(T_q) g = Σ_k c_k g(· − k log q)` for a `C²` compactly supported test `g`, `P` the Frobenius
polynomial of the distinct eigenvalues. -/
theorem radical_iff_eq_frobPolyTest {f : ℝ → ℂ} (hf : ContDiff ℝ 2 f)
    (hfc : HasCompactSupport f) :
    (∀ ρ ∈ (D.curveConfig hD).carrier, paperFT f (gammaOf ρ) = 0) ↔
      ∃ g : ℝ → ℂ, ContDiff ℝ 2 g ∧ HasCompactSupport g ∧ f = D.frobPolyTest g := by
  have hL := D.log_q_pos
  constructor
  · intro hvan
    obtain ⟨a, ha0, ha⟩ :=
      GaloisForLFunctions.SquareRootThreshold.exists_radius_of_hasCompactSupport hfc
    have hfs : tsupport f ⊆ Set.Icc (-a) a := by
      refine closure_minimal (fun u hu => ?_) isClosed_Icc
      by_contra hout
      apply hu
      apply ha
      rw [Set.mem_Icc, not_and_or, not_le, not_le] at hout
      rcases hout with h | h
      · rw [abs_of_neg (by linarith)]; linarith
      · rw [abs_of_pos (by linarith)]; exact h
    obtain ⟨g, hg, hgs, hFT⟩ := exists_div_prod_tower hL D.spectrum
      (fun b hb => D.ne_zero_of_mem_spectrum hb) hf hfs (fun b hb s => by
        obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hb
        exact D.tsum_sample_mul_pow_eq_zero hD hf hfc hvan i s)
    have hgc : HasCompactSupport g := RHTower.hasCompactSupport_of_tsupport_subset_Icc hgs
    refine ⟨g, hg, hgc, ?_⟩
    -- the transforms agree, so the tests agree
    have hdiff : ∀ s : ℝ, paperFT (f + (-1 : ℂ) • D.frobPolyTest g) (s : ℂ) = 0 := by
      intro s
      rw [paperFT_add hf.continuous hfc ((D.frobPolyTest_contDiff hg).continuous.const_smul _)
        (D.frobPolyTest_hasCompactSupport hgc).smul_left, paperFT_smul,
        D.paperFT_frobPolyTest hg.continuous hgc, hFT, frobPoly, eval_prod]
      simp only [eval_sub, eval_X, eval_C]
      ring
    have h0 := eq_zero_of_paperFT_real_eq_zero (hf.continuous.add
      ((D.frobPolyTest_contDiff hg).continuous.const_smul _))
      (hfc.add (D.frobPolyTest_hasCompactSupport hgc).smul_left) hdiff
    funext u
    have := h0 u
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul] at this
    linear_combination this
  · rintro ⟨g, hg, hgc, rfl⟩ ρ hρ
    exact D.paperFT_frobPolyTest_zero hD hg.continuous hgc hρ

end CurveDatum

end GaloisForLFunctions.ArithmeticCastelnuovoSeveri
