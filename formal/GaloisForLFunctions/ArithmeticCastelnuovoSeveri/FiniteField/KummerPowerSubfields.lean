import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FiniteField.KummerBranchIrreducibility
import GaloisForLFunctions.HTGeometry.RadicalDegreeExact
import Mathlib.FieldTheory.KummerPolynomial

/-!
# Power-generated subfields of a Kummer function field

If `z^N=f(y)` has a simple branch point, then adjoining `z^d` gives a
subfield of degree `N/gcd(N,d)`, and the remaining extension has degree
`gcd(N,d)`. Bézout reduces arbitrary powers to divisor powers; Eisenstein
irreducibility proves their degrees without separability assumptions.
-/

noncomputable section

namespace GaloisForLFunctions.ArithmeticCastelnuovoSeveri

open Polynomial
open scoped IntermediateField

/-- Bézout identifies power-generated fields whenever one power is in the base. -/
theorem adjoin_power_eq_gcd {F L : Type*} [Field F] [Field L] [Algebra F L]
    {z : L} (hz : z ≠ 0) (N d : ℕ) (a : F) (hN : z ^ N = algebraMap F L a) :
    F⟮z ^ d⟯ = F⟮z ^ Nat.gcd N d⟯ := by
  apply le_antisymm
  · apply IntermediateField.adjoin_simple_le_iff.mpr
    obtain ⟨j, hj⟩ := Nat.gcd_dvd_right N d
    have he : (z ^ Nat.gcd N d) ^ j = z ^ d := by rw [← pow_mul, ← hj]
    exact he ▸ pow_mem (IntermediateField.mem_adjoin_simple_self F (z ^ Nat.gcd N d)) j
  · apply IntermediateField.adjoin_simple_le_iff.mpr
    have hg : z ^ Nat.gcd N d = (z ^ N) ^ Nat.gcdA N d * (z ^ d) ^ Nat.gcdB N d := by
      rw [← zpow_natCast, Nat.gcd_eq_gcd_ab, zpow_add₀ hz,
        zpow_mul, zpow_mul, zpow_natCast, zpow_natCast]
    rw [hg, hN]
    exact (F⟮z ^ d⟯).mul_mem
      ((F⟮z ^ d⟯).pow_mem ((F⟮z ^ d⟯).algebraMap_mem a) _)
      ((F⟮z ^ d⟯).pow_mem (IntermediateField.mem_adjoin_simple_self F (z ^ d)) _)

variable {K : Type*} [Field K]

/-- The radical generator is nonzero because the branch polynomial is nonzero. -/
theorem kummerBranchField_root_ne_zero (c : Kˣ) (b R n : ℕ) :
    AdjoinRoot.root (kummerBranchFieldPolynomial c b R n) ≠ 0 := by
  apply root_X_pow_sub_C_ne_zero' (Nat.succ_pos n)
  apply (map_ne_zero_iff _ (IsFractionRing.injective K[X] (FractionRing K[X]))).mpr
  intro h
  have hc := congrArg (fun f : K[X] => f.coeff 1) h
  rw [kummerBranch_coeff_one, coeff_zero] at hc
  exact Units.ne_zero c hc

/-- The actual intermediate field generated by a power of the canonical radical. -/
def kummerPowerSubfield (c : Kˣ) (b R n d : ℕ) :
    IntermediateField (FractionRing K[X]) (KummerBranchField c b R n) :=
  (FractionRing K[X])⟮(AdjoinRoot.root (kummerBranchFieldPolynomial c b R n)) ^ d⟯

/-- Only the gcd of the power and the full degree affects the generated field. -/
theorem kummerPowerSubfield_eq_gcd (c : Kˣ) (b R n d : ℕ) :
    kummerPowerSubfield c b R n d = kummerPowerSubfield c b R n (Nat.gcd (n + 1) d) :=
  adjoin_power_eq_gcd (kummerBranchField_root_ne_zero c b R n) (n + 1) d _
    (kummerBranchField_root_pow c b R n)

/-- A divisor power satisfies the expected quotient Kummer equation. -/
theorem kummerPowerSubfield_equation (c : Kˣ) (b R n d : ℕ) (hd : d ∣ n + 1) :
    ((AdjoinRoot.root (kummerBranchFieldPolynomial c b R n)) ^ d) ^ ((n + 1) / d) =
      algebraMap (FractionRing K[X]) (KummerBranchField c b R n)
        (algebraMap K[X] (FractionRing K[X]) (kummerBranch c b R)) := by
  rw [← pow_mul, Nat.mul_div_cancel' hd, kummerBranchField_root_pow]

/-- The quotient equation remains Eisenstein, so its root generates the full predicted degree. -/
theorem kummerPowerSubfield_finrank_of_dvd (c : Kˣ) (b R n d : ℕ) (hd : d ∣ n + 1) :
    Module.finrank (FractionRing K[X]) (kummerPowerSubfield c b R n d) = (n + 1) / d := by
  have hq : 0 < (n + 1) / d :=
    Nat.div_pos (Nat.le_of_dvd (Nat.succ_pos n) hd) (Nat.pos_of_dvd_of_pos hd (Nat.succ_pos n))
  have hi := kummerBranch_fraction_irreducible c b R ((n + 1) / d - 1)
  rw [Nat.sub_add_cancel (show 1 ≤ (n + 1) / d from hq)] at hi
  exact GaloisForLFunctions.HTGeometry.finrank_adjoin_of_irreducible hq hi
    (kummerPowerSubfield_equation c b R n d hd)

/-- Every power has the exact gcd-controlled subfield degree, including power zero. -/
theorem kummerPowerSubfield_finrank (c : Kˣ) (b R n d : ℕ) :
    Module.finrank (FractionRing K[X]) (kummerPowerSubfield c b R n d) =
      (n + 1) / Nat.gcd (n + 1) d := by
  rw [kummerPowerSubfield_eq_gcd]
  exact kummerPowerSubfield_finrank_of_dvd c b R n _ (Nat.gcd_dvd_left (n + 1) d)

/-- The complementary field degree is precisely the gcd. -/
theorem kummerPowerSubfield_relative_finrank (c : Kˣ) (b R n d : ℕ) :
    Module.finrank (kummerPowerSubfield c b R n d) (KummerBranchField c b R n) =
      Nat.gcd (n + 1) d := by
  have ht := Module.finrank_mul_finrank (FractionRing K[X])
    (kummerPowerSubfield c b R n d) (KummerBranchField c b R n)
  rw [kummerPowerSubfield_finrank, kummerBranchField_finrank] at ht
  have hd := Nat.gcd_dvd_left (n + 1) d
  have hq : 0 < (n + 1) / Nat.gcd (n + 1) d :=
    Nat.div_pos (Nat.le_of_dvd (Nat.succ_pos n) hd) (Nat.gcd_pos_of_pos_left d (Nat.succ_pos n))
  exact Nat.mul_left_cancel hq (ht.trans (Nat.div_mul_cancel hd).symm)

end GaloisForLFunctions.ArithmeticCastelnuovoSeveri
