import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FiniteField.KummerCyclicCovers
import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FiniteField.KummerPowerSubfields
import GaloisForLFunctions.HTGeometry.CyclicSubgroupUnique

/-!
# All intermediate fields of a cyclic Kummer cover

Every intermediate field between a square-field Kummer cover and its rational
base is generated by a power of the radical. The exponent is its relative
degree in the full cover. This identifies the fixed field of every subgroup,
using the uniqueness of subgroups of a given order in a cyclic group.
-/

noncomputable section

namespace GaloisForLFunctions.ArithmeticCastelnuovoSeveri

open Polynomial

variable (p : ℕ) [Fact p.Prime] (s : ℕ)
variable (c : (SquareConstantField p s)ˣ) (b R : ℕ)

/-- The subgroup fixing a radical power has the gcd-predicted order. -/
theorem squareKummer_fixingSubgroup_card (d : ℕ) :
    Nat.card (kummerPowerSubfield c b R (p ^ (s + 1)) d).fixingSubgroup =
      Nat.gcd (p ^ (s + 1) + 1) d := by
  letI := squareKummer_isGalois p s c b R
  rw [IsGalois.card_fixingSubgroup_eq_finrank]
  exact kummerPowerSubfield_relative_finrank c b R (p ^ (s + 1)) d

/-- Every intermediate field is generated by the radical raised to its relative degree. -/
theorem squareKummer_intermediate_eq_power
    (E : IntermediateField (FractionRing (SquareConstantField p s)[X])
      (SquareKummerField p s c b R)) :
    E = kummerPowerSubfield c b R (p ^ (s + 1))
      (Module.finrank E (SquareKummerField p s c b R)) := by
  classical
  letI := squareKummer_isGalois p s c b R
  letI := squareKummer_isCyclic p s c b R
  letI : Fintype (SquareKummerField p s c b R ≃ₐ[FractionRing (SquareConstantField p s)[X]]
      SquareKummerField p s c b R) := Fintype.ofFinite _
  let d := Module.finrank E (SquareKummerField p s c b R)
  let P := kummerPowerSubfield c b R (p ^ (s + 1)) d
  have hd : d ∣ p ^ (s + 1) + 1 := by
    refine ⟨Module.finrank (FractionRing (SquareConstantField p s)[X]) E, ?_⟩
    have ht := Module.finrank_mul_finrank (FractionRing (SquareConstantField p s)[X])
      E (SquareKummerField p s c b R)
    rw [kummerBranchField_finrank] at ht
    exact ht.symm.trans (Nat.mul_comm _ _)
  have hcard : Nat.card E.fixingSubgroup = Nat.card P.fixingSubgroup := by
    rw [IsGalois.card_fixingSubgroup_eq_finrank]
    change d = Nat.card (kummerPowerSubfield c b R (p ^ (s + 1)) d).fixingSubgroup
    rw [squareKummer_fixingSubgroup_card, Nat.gcd_eq_right hd]
  have hgroups : E.fixingSubgroup = P.fixingSubgroup :=
    GaloisForLFunctions.HTGeometry.subgroup_eq_of_card_eq
      (by simpa only [Nat.card_eq_fintype_card] using hcard)
  calc
    E = IntermediateField.fixedField E.fixingSubgroup :=
      (IsGalois.fixedField_fixingSubgroup E).symm
    _ = IntermediateField.fixedField P.fixingSubgroup := congrArg IntermediateField.fixedField hgroups
    _ = P := IsGalois.fixedField_fixingSubgroup P

/-- A subgroup of order `d` fixes precisely the field generated by `z^d`. -/
theorem squareKummer_fixedField_eq_power
    (H : Subgroup (SquareKummerField p s c b R ≃ₐ[FractionRing (SquareConstantField p s)[X]]
      SquareKummerField p s c b R)) :
    IntermediateField.fixedField H =
      kummerPowerSubfield c b R (p ^ (s + 1)) (Nat.card H) := by
  have he := squareKummer_intermediate_eq_power p s c b R (IntermediateField.fixedField H)
  rwa [IntermediateField.finrank_fixedField_eq_card] at he

/-- Thus the fixed field is itself given by the quotient Kummer equation. -/
theorem squareKummer_fixedField_generator_equation
    (H : Subgroup (SquareKummerField p s c b R ≃ₐ[FractionRing (SquareConstantField p s)[X]]
      SquareKummerField p s c b R)) :
    ((AdjoinRoot.root (kummerBranchFieldPolynomial c b R (p ^ (s + 1)))) ^ Nat.card H) ^
        ((p ^ (s + 1) + 1) / Nat.card H) =
      algebraMap (FractionRing (SquareConstantField p s)[X]) (SquareKummerField p s c b R)
        (algebraMap (SquareConstantField p s)[X] (FractionRing (SquareConstantField p s)[X])
          (kummerBranch c b R)) := by
  apply kummerPowerSubfield_equation
  have hd := H.card_subgroup_dvd_card
  rwa [squareKummer_card_aut] at hd

end GaloisForLFunctions.ArithmeticCastelnuovoSeveri
