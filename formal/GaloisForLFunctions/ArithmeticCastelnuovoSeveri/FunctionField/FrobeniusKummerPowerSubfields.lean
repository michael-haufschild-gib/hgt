import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FunctionField.FrobeniusKummerFields
import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FiniteField.KummerPowerSubfields

/-!
# Power subfields of the Frobenius radical family

Bézout reduces a radical power to the gcd of its exponent and the full
covering degree. The branch polynomial's simple origin zero makes each
quotient equation Eisenstein, giving both field degrees exactly.
-/

noncomputable section
namespace GaloisForLFunctions.ArithmeticCastelnuovoSeveri
open Polynomial
open scoped IntermediateField
variable {K : Type*} [Field K]

/-- The actual intermediate field generated by a power of the canonical radical. -/
def frobeniusKummerPowerSubfield (c : Kˣ) (b R n d : ℕ) :
    IntermediateField (FractionRing K[X]) (FrobeniusKummerField c b R n) :=
  (FractionRing K[X])⟮(AdjoinRoot.root (frobeniusKummerFieldPolynomial c b R n)) ^ d⟯

/-- Only the gcd of the power and the full degree affects the generated field. -/
theorem frobeniusKummerPowerSubfield_eq_gcd (c : Kˣ) (b R n d : ℕ) :
    frobeniusKummerPowerSubfield c b R n d = frobeniusKummerPowerSubfield c b R n (Nat.gcd (n + 1) d) :=
  adjoin_power_eq_gcd (frobeniusKummerField_root_ne_zero c b R n) (n + 1) d _
    (frobeniusKummerField_root_pow c b R n)

/-- A divisor power satisfies the expected quotient Kummer equation. -/
theorem frobeniusKummerPowerSubfield_equation (c : Kˣ) (b R n d : ℕ) (hd : d ∣ n + 1) :
    ((AdjoinRoot.root (frobeniusKummerFieldPolynomial c b R n)) ^ d) ^ ((n + 1) / d) =
      algebraMap (FractionRing K[X]) (FrobeniusKummerField c b R n)
        (algebraMap K[X] (FractionRing K[X]) (frobeniusKummerBranch c b R)) := by
  rw [← pow_mul, Nat.mul_div_cancel' hd, frobeniusKummerField_root_pow]

/-- The quotient equation remains Eisenstein, so its root generates the full predicted degree. -/
theorem frobeniusKummerPowerSubfield_finrank_of_dvd (c : Kˣ) (b R n d : ℕ) (hd : d ∣ n + 1) :
    Module.finrank (FractionRing K[X]) (frobeniusKummerPowerSubfield c b R n d) = (n + 1) / d := by
  have hq : 0 < (n + 1) / d :=
    Nat.div_pos (Nat.le_of_dvd (Nat.succ_pos n) hd) (Nat.pos_of_dvd_of_pos hd (Nat.succ_pos n))
  have hi := frobeniusKummerBranch_fraction_irreducible c b R ((n + 1) / d - 1)
  rw [Nat.sub_add_cancel (show 1 ≤ (n + 1) / d from hq)] at hi
  exact GaloisForLFunctions.HTGeometry.finrank_adjoin_of_irreducible hq hi
    (frobeniusKummerPowerSubfield_equation c b R n d hd)

/-- Every power has the exact gcd-controlled subfield degree, including power zero. -/
theorem frobeniusKummerPowerSubfield_finrank (c : Kˣ) (b R n d : ℕ) :
    Module.finrank (FractionRing K[X]) (frobeniusKummerPowerSubfield c b R n d) =
      (n + 1) / Nat.gcd (n + 1) d := by
  rw [frobeniusKummerPowerSubfield_eq_gcd]
  exact frobeniusKummerPowerSubfield_finrank_of_dvd c b R n _ (Nat.gcd_dvd_left (n + 1) d)

/-- The complementary field degree is precisely the gcd. -/
theorem frobeniusKummerPowerSubfield_relative_finrank (c : Kˣ) (b R n d : ℕ) :
    Module.finrank (frobeniusKummerPowerSubfield c b R n d) (FrobeniusKummerField c b R n) =
      Nat.gcd (n + 1) d := by
  have ht := Module.finrank_mul_finrank (FractionRing K[X])
    (frobeniusKummerPowerSubfield c b R n d) (FrobeniusKummerField c b R n)
  rw [frobeniusKummerPowerSubfield_finrank, frobeniusKummerField_finrank] at ht
  have hd := Nat.gcd_dvd_left (n + 1) d
  have hq : 0 < (n + 1) / Nat.gcd (n + 1) d :=
    Nat.div_pos (Nat.le_of_dvd (Nat.succ_pos n) hd) (Nat.gcd_pos_of_pos_left d (Nat.succ_pos n))
  exact Nat.mul_left_cancel hq (ht.trans (Nat.div_mul_cancel hd).symm)

end GaloisForLFunctions.ArithmeticCastelnuovoSeveri
