import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FunctionField.KummerPoleSemigroup
import GaloisForLFunctions.ArithmeticHarmonicAnalysis.FiniteGroup.ReducedResidueTwoGenerators
import GaloisForLFunctions.ArithmeticHarmonicAnalysis.FiniteField.KummerSmallDivisors
import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FiniteField.KummerParameterCardinality

/-!
# Explicit two-generator infinity semigroups

Length one has pole semigroup generated by `N` and `q`. At length two
with odd covering exponent, normalization supplies the smaller pole
order `N/(q+1)`; together with `q²` it generates every pole order.
Both statements concern actual functions regular away from infinity.
-/

noncomputable section
namespace GaloisForLFunctions.ArithmeticCastelnuovoSeveri
open Polynomial ArithmeticHarmonicAnalysis

private theorem divisor_exponent_poles
    (p : ℕ) [Fact p.Prime] (s : ℕ) (c : (SquareConstantField p s)ˣ) (d r M : ℕ)
    (hd : kummerExponent (p ^ (d + 1)) r ∣ p ^ (s + 1) + 1) :
    (∃ x : SquareKummerField p s c (p ^ (d + 1) - 2) (kummerExponent (p ^ (d + 1)) r),
      IsIntegral (SquareConstantField p s)[X] x ∧
      squareKummerInfinityValuation p s c d r x = WithZero.exp (M : ℤ)) ↔
      ∃ a b : ℕ, ((p ^ (s + 1) + 1) / kummerExponent (p ^ (d + 1)) r) * a +
        (p ^ (d + 1)) ^ r * b = M := by
  let N := p ^ (s + 1) + 1
  let R := kummerExponent (p ^ (d + 1)) r
  let A := N / R
  have hfactor : A * R = N := Nat.div_mul_cancel hd
  have hA : 0 < A := by
    apply Nat.pos_of_ne_zero
    intro hz
    rw [hz, zero_mul] at hfactor
    exact Nat.succ_ne_zero _ hfactor.symm
  have hR : 0 < R := by
    apply Nat.pos_of_ne_zero
    intro hz
    rw [hz, mul_zero] at hfactor
    exact Nat.succ_ne_zero _ hfactor.symm
  have hq : 2 ≤ p ^ (d + 1) := Nat.one_lt_pow (Nat.succ_ne_zero d) (Fact.out : p.Prime).one_lt
  have hdegree := kummerInfinity_primePower_poleDegree p d r
  rw [show p ^ (d + 1) - 2 + 1 = p ^ (d + 1) - 1 by omega] at hdegree
  have h := reducedResidue_two_generator_iff A R (p ^ (d + 1) - 1) M hA hR
  rw [hfactor, hdegree] at h
  rw [squareKummer_exists_integral_pole_iff]
  exact h

/-- At geometric length one, all infinity pole orders form the semigroup generated by the covering degree and the small prime power. -/
theorem squareKummerInfinity_length_one_poles
    (p : ℕ) [Fact p.Prime] (s : ℕ) (c : (SquareConstantField p s)ˣ) (d M : ℕ) :
    (∃ x : SquareKummerField p s c (p ^ (d + 1) - 2) (kummerExponent (p ^ (d + 1)) 1),
      IsIntegral (SquareConstantField p s)[X] x ∧
      squareKummerInfinityValuation p s c d 1 x = WithZero.exp (M : ℤ)) ↔
      ∃ a b : ℕ, (p ^ (s + 1) + 1) * a + p ^ (d + 1) * b = M := by
  have hR : kummerExponent (p ^ (d + 1)) 1 = 1 := by
    simp only [kummerExponent, Finset.sum_range_succ, Finset.range_zero,
      Finset.sum_empty, pow_zero, zero_add]
  have hd : kummerExponent (p ^ (d + 1)) 1 ∣ p ^ (s + 1) + 1 := by rw [hR]; exact one_dvd _
  simpa only [hR, Nat.div_one, pow_one] using divisor_exponent_poles p s c d 1 M hd

/-- At geometric length two and odd covering exponent, normalization gives the exact pole semigroup generated by `N/(q+1)` and `q²`. -/
theorem primePowerKummerInfinity_length_two_odd_poles
    (p : ℕ) [Fact p.Prime] (d n : ℕ)
    (c : (SquareConstantField p (kummerSquareIndex d (2 * n)))ˣ) (M : ℕ) :
    (∃ x : SquareKummerField p (kummerSquareIndex d (2 * n)) c
        (p ^ (d + 1) - 2) (kummerExponent (p ^ (d + 1)) 2),
      IsIntegral (SquareConstantField p (kummerSquareIndex d (2 * n)))[X] x ∧
      squareKummerInfinityValuation p (kummerSquareIndex d (2 * n)) c d 2 x =
        WithZero.exp (M : ℤ)) ↔
      ∃ a b : ℕ, ((p ^ (kummerSquareIndex d (2 * n) + 1) + 1) / (p ^ (d + 1) + 1)) * a +
        (p ^ (d + 1)) ^ 2 * b = M := by
  have hq : 2 ≤ p ^ (d + 1) := Nat.one_lt_pow (Nat.succ_ne_zero d) (Fact.out : p.Prime).one_lt
  have hd : kummerExponent (p ^ (d + 1)) 2 ∣ p ^ (kummerSquareIndex d (2 * n) + 1) + 1 := by
    rw [kummerSquareIndex_succ, pow_mul]
    exact (kummerExponent_dvd_cover_iff (p ^ (d + 1)) (2 * n + 1) 2 hq
      (Nat.succ_pos _) (Nat.zero_lt_succ 1)).mpr (Or.inr ⟨rfl, ⟨n, by ring⟩⟩)
  have hR : kummerExponent (p ^ (d + 1)) 2 = p ^ (d + 1) + 1 := by
    simp only [kummerExponent, Finset.sum_range_succ, Finset.range_zero,
      Finset.sum_empty, pow_zero, pow_one, zero_add, add_comm]
  simpa only [hR] using divisor_exponent_poles p (kummerSquareIndex d (2 * n)) c d 2 M hd

end GaloisForLFunctions.ArithmeticCastelnuovoSeveri
