import Mathlib.LinearAlgebra.Quotient.Pi
import Mathlib.LinearAlgebra.Finsupp.LinearCombination
import Mathlib.LinearAlgebra.Dimension.Constructions
import Mathlib.RingTheory.AdjoinRoot

/-!
# Quotients by polynomial multiples of a basis

If a submodule is generated by `fᵢ bᵢ` in a finite basis `bᵢ`, its quotient
is the product of the scalar quotients by `(fᵢ)`. Over a polynomial ring,
nonzero factors give a finite-dimensional quotient of dimension `∑ deg fᵢ`.
This identifies normalization defects when an affine order and its integral
closure differ by explicit factors in an integral basis.
-/

noncomputable section
open scoped BigOperators Classical

namespace GaloisForLFunctions.ArithmeticCastelnuovoSeveri

section Ring
variable {R M ι : Type*} [CommRing R] [AddCommGroup M] [Module R M] [Fintype ι]

/-- The submodule generated by specified scalar multiples of a basis. -/
def basisMultipleSubmodule (b : Module.Basis ι R M) (f : ι → R) : Submodule R M :=
  Submodule.span R (Set.range fun i => f i • b i)

/-- Membership in a diagonal basis submodule is coordinatewise divisibility. -/
theorem mem_basisMultipleSubmodule_iff (b : Module.Basis ι R M) (f : ι → R) (x : M) :
    x ∈ basisMultipleSubmodule b f ↔ ∀ i, f i ∣ b.repr x i := by
  rw [basisMultipleSubmodule, Submodule.mem_span_range_iff_exists_fun]
  constructor
  · rintro ⟨c, rfl⟩ i
    refine ⟨c i, ?_⟩
    simp only [smul_smul, Module.Basis.repr_sum_self]
    exact mul_comm _ _
  · intro h
    choose c hc using h
    refine ⟨c, b.ext_elem fun i => ?_⟩
    simp only [smul_smul, Module.Basis.repr_sum_self]
    rw [hc i, mul_comm]

/-- Basis coordinates identify the diagonal submodule with the product of its principal ideals. -/
theorem basisMultipleSubmodule_map (b : Module.Basis ι R M) (f : ι → R) :
    Submodule.map b.equivFun.toLinearMap (basisMultipleSubmodule b f) =
      Submodule.pi Set.univ (fun i => (Ideal.span {f i} : Submodule R R)) := by
  ext y
  simp only [Submodule.mem_map, Submodule.mem_pi, Set.mem_univ, forall_true_left,
    Ideal.mem_span_singleton, LinearEquiv.coe_coe]
  constructor
  · rintro ⟨x, hx, rfl⟩
    simpa only [Module.Basis.equivFun_apply] using (mem_basisMultipleSubmodule_iff b f x).mp hx
  · intro hy
    refine ⟨b.equivFun.symm y, ?_, b.equivFun.apply_symm_apply y⟩
    apply (mem_basisMultipleSubmodule_iff b f _).mpr
    intro i
    have he : b.repr (b.equivFun.symm y) i = y i := by
      change b.equivFun (b.equivFun.symm y) i = y i
      rw [b.equivFun.apply_symm_apply]
    rw [he]
    exact hy i

/-- The quotient by a diagonal basis submodule splits into the corresponding scalar quotients. -/
def basisMultipleQuotientEquiv [DecidableEq ι] (b : Module.Basis ι R M) (f : ι → R) :
    (M ⧸ basisMultipleSubmodule b f) ≃ₗ[R] ∀ i, R ⧸ Ideal.span {f i} :=
  (Submodule.Quotient.equiv _ _ b.equivFun (basisMultipleSubmodule_map b f)).trans
    (Submodule.quotientPi (fun i => (Ideal.span {f i} : Submodule R R)))

end Ring

section Polynomial
open Polynomial
variable {K M ι : Type*} [Field K] [AddCommGroup M] [Module K[X] M]
  [Module K M] [IsScalarTower K K[X] M] [Fintype ι]

/-- Nonzero polynomial factors give a finite-dimensional defect quotient. -/
theorem basisPolynomialQuotient_finite (b : Module.Basis ι K[X] M)
    (f : ι → K[X]) (hf : ∀ i, f i ≠ 0) :
    Module.Finite K (M ⧸ basisMultipleSubmodule b f) := by
  classical
  letI (i : ι) : Module.Finite K (K[X] ⧸ Ideal.span {f i}) :=
    Module.Finite.of_basis (AdjoinRoot.powerBasisAux (hf i))
  exact Module.Finite.equiv ((basisMultipleQuotientEquiv b f).restrictScalars K).symm

/-- The defect dimension is the sum of the degrees of the diagonal polynomial factors. -/
theorem basisPolynomialQuotient_finrank (b : Module.Basis ι K[X] M)
    (f : ι → K[X]) (hf : ∀ i, f i ≠ 0) :
    Module.finrank K (M ⧸ basisMultipleSubmodule b f) = ∑ i, (f i).natDegree := by
  classical
  letI (i : ι) : Module.Finite K (K[X] ⧸ Ideal.span {f i}) :=
    Module.Finite.of_basis (AdjoinRoot.powerBasisAux (hf i))
  rw [((basisMultipleQuotientEquiv b f).restrictScalars K).finrank_eq, Module.finrank_pi_fintype]
  exact Finset.sum_congr rfl (fun _ _ => finrank_quotient_span_eq_natDegree)

#print axioms basisPolynomialQuotient_finrank

end Polynomial
end GaloisForLFunctions.ArithmeticCastelnuovoSeveri
