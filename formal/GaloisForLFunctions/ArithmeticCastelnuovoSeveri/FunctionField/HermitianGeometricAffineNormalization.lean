import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FunctionField.HermitianGeometricFields
import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FunctionField.SquareKummerExtensionNormalizationCoordinates

/-!
# The geometric Hermitian affine ring is already normal

Every reduced radical basis denominator is trivial when the branch
exponent is one. Consequently the actual polynomial normalization is
generated by the polynomial coordinate and the canonical radical.
-/

noncomputable section
namespace GaloisForLFunctions.ArithmeticCastelnuovoSeveri
open Polynomial
variable (p : ℕ) [Fact p.Prime] (s : ℕ)
local notation "Q" => p ^ (s + 1)
local notation "E" => HermitianGeometricConstants p s
local notation "H" => HermitianGeometricField p s
local notation "η" => hermitianExtensionTraceConstant p s E
local notation "z" => hermitianExtensionRadicalCoordinate p s E

/-- Every integral function is a polynomial combination of radical powers below the covering degree. -/
theorem hermitianGeometric_integral_power_expansion (x : H) (hx : IsIntegral E[X] x) :
    ∃ a : Fin (Q + 1) → E[X], x = ∑ i, algebraMap E[X] H (a i) * z ^ i.val := by
  classical
  let B := kummerIntegralMonomialBasis η⁻¹ (Q - 2) 1 Q
  have hc (i : Fin (Q + 1)) :=
    squareKummerExtension_integral_basis_coordinate p s s E η⁻¹ 1 x hx i
  let a : Fin (Q + 1) → E[X] := fun i => (hc i).choose
  refine ⟨a, ?_⟩
  rw [← B.sum_repr x]
  apply Finset.sum_congr rfl
  intro i _
  have ha : algebraMap E[X] (FractionRing E[X]) (a i) = B.repr x i := (hc i).choose_spec
  rw [Algebra.smul_def]
  change algebraMap (FractionRing E[X]) H (B.repr x i) * B i = _
  rw [← ha, ← IsScalarTower.algebraMap_apply E[X] (FractionRing E[X]) H,
    kummerIntegralMonomialBasis_apply, kummerIntegralMonomial,
    mul_one, Nat.div_eq_of_lt i.isLt, pow_zero, div_one]
  rfl

/-- The actual geometric normalization equals the affine algebra generated by the radical. -/
theorem hermitianGeometric_integralClosure_eq_adjoin :
    integralClosure E[X] H = Algebra.adjoin E[X] ({z} : Set H) := by
  classical
  apply le_antisymm
  · intro x hx
    obtain ⟨a, ha⟩ := hermitianGeometric_integral_power_expansion p s x hx
    rw [ha]
    exact sum_mem fun i _ => mul_mem
      ((Algebra.adjoin E[X] ({z} : Set H)).algebraMap_mem (a i))
      (pow_mem (Algebra.subset_adjoin (Set.mem_singleton z)) i.val)
  · refine Algebra.adjoin_le ?_
    rintro x hx
    rw [Set.mem_singleton_iff] at hx
    subst x
    exact kummerBranchField_root_integral η⁻¹ (Q - 2) 1 Q

end GaloisForLFunctions.ArithmeticCastelnuovoSeveri
