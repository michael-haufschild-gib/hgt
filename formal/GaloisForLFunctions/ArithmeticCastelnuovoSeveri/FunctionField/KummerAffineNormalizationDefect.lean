import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FunctionField.DiagonalPolynomialDefect
import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FunctionField.KummerIntegralBasis
import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FunctionField.KummerDifferentialCutoffs
import GaloisForLFunctions.ArithmeticHarmonicAnalysis.FiniteGroup.MultiplicationFloorSum

/-!
# The affine normalization defect of Kummer models

The coordinate ring generated by the radical sits diagonally inside the
explicit normalization basis. Its diagonal factors are powers of the
nonlinear branch polynomial. The quotient therefore has dimension equal
to the branch degree times a floor sum. This realizes the affine defect
in Ma–Wang, Lemma 3.1 (arXiv:2611.14073), on the actual Kummer normalization.
-/

noncomputable section
open scoped BigOperators Classical

namespace GaloisForLFunctions.ArithmeticCastelnuovoSeveri
open Polynomial

/-- Multiplying a reduced integral monomial by its branch denominator recovers the raw power. -/
theorem kummerIntegralMonomial_clear_denominator {K : Type*} [Field K]
    (c : Kˣ) (b R n i : ℕ) :
    algebraMap K[X] (KummerBranchField c b R n)
      ((1 - X ^ (b + 1)) ^ (i * R / (n + 1))) *
        kummerIntegralMonomial c b R n i =
      AdjoinRoot.root (kummerBranchFieldPolynomial c b R n) ^ i := by
  have hinj : Function.Injective (algebraMap K[X] (KummerBranchField c b R n)) := by
    rw [IsScalarTower.algebraMap_eq K[X] (FractionRing K[X]) (KummerBranchField c b R n)]
    exact (algebraMap (FractionRing K[X]) _).injective.comp (IsFractionRing.injective K[X] _)
  have hg : algebraMap K[X] (KummerBranchField c b R n) (1 - X ^ (b + 1)) ≠ 0 :=
    fun h => kummerBranchFactor_ne_zero (K := K) b (hinj (h.trans (map_zero _).symm))
  rw [kummerIntegralMonomial, map_pow, mul_div_cancel₀ _ (pow_ne_zero _ hg)]

/-- The branch polynomial has its expected positive degree. -/
theorem kummerBranchFactor_natDegree {K : Type*} [Field K] (b : ℕ) :
    (1 - X ^ (b + 1) : K[X]).natDegree = b + 1 := by
  rw [← natDegree_neg, neg_sub, ← map_one C, natDegree_X_pow_sub_C]

variable (p : ℕ) [Fact p.Prime] (s d : ℕ) (c : (SquareConstantField p s)ˣ) (R : ℕ)

/-- The original affine coordinate algebra, embedded in its integral closure. -/
def squareKummerAffineOrder :
    Subalgebra (SquareConstantField p s)[X]
      (SquareKummerNormalization p s c (p ^ (d + 1) - 2) R) :=
  Algebra.adjoin (SquareConstantField p s)[X]
    {squareKummerIntegralRoot p s c (p ^ (d + 1) - 2) R}

/-- The raw radical powers below the covering degree span the original affine order. -/
theorem squareKummerAffineOrder_span :
    (squareKummerAffineOrder p s d c R).toSubmodule =
      Submodule.span (SquareConstantField p s)[X]
        (Set.range fun i : Fin (p ^ (s + 1) + 1) =>
          squareKummerIntegralRoot p s c (p ^ (d + 1) - 2) R ^ i.val) := by
  have hroot : aeval (squareKummerIntegralRoot p s c (p ^ (d + 1) - 2) R)
      (X ^ (p ^ (s + 1) + 1) - C (kummerBranch c (p ^ (d + 1) - 2) R)) = 0 := by
    simp only [map_sub, map_pow, aeval_X, aeval_C, squareKummerIntegralRoot_pow, sub_self]
  have hspan := Submodule.span_range_natDegree_eq_adjoin
    (monic_X_pow_sub_C (kummerBranch c (p ^ (d + 1) - 2) R) (Nat.succ_ne_zero _)) hroot
  rw [natDegree_X_pow_sub_C] at hspan
  simp only [Nat.succ_eq_add_one, Finset.coe_image, Finset.coe_range] at hspan
  have hset : (fun i => squareKummerIntegralRoot p s c (p ^ (d + 1) - 2) R ^ i) ''
      Set.Iio (p ^ (s + 1) + 1) =
      Set.range (fun i : Fin (p ^ (s + 1) + 1) =>
        squareKummerIntegralRoot p s c (p ^ (d + 1) - 2) R ^ i.val) := by
    ext z
    constructor
    · intro hz
      obtain ⟨i, hi, rfl⟩ := hz
      exact ⟨⟨i, hi⟩, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨i.val, i.isLt, rfl⟩
  rw [hset] at hspan
  exact hspan.symm

/-- The normalization basis differs from raw radical powers by explicit polynomial factors. -/
theorem squareKummerNormalizationBasis_clear_denominator (i : Fin (p ^ (s + 1) + 1)) :
    ((1 - X ^ (p ^ (d + 1) - 2 + 1)) ^
      (i.val * R / (p ^ (s + 1) + 1)) : (SquareConstantField p s)[X]) •
        squareKummerNormalizationBasis p s d c R i =
      squareKummerIntegralRoot p s c (p ^ (d + 1) - 2) R ^ i.val := by
  rw [squareKummerNormalizationBasis_apply]
  apply Subtype.ext
  simp only [Subalgebra.coe_pow, Algebra.smul_def]
  change algebraMap (SquareConstantField p s)[X]
      (SquareKummerField p s c (p ^ (d + 1) - 2) R)
      ((1 - X ^ (p ^ (d + 1) - 2 + 1)) ^ (i.val * R / (p ^ (s + 1) + 1))) *
        kummerIntegralMonomial c (p ^ (d + 1) - 2) R (p ^ (s + 1)) i.val = _
  exact kummerIntegralMonomial_clear_denominator c (p ^ (d + 1) - 2) R (p ^ (s + 1)) i.val

/-- In normalization coordinates, the affine order is a diagonal polynomial submodule. -/
theorem squareKummerAffineOrder_toSubmodule :
    (squareKummerAffineOrder p s d c R).toSubmodule =
      basisMultipleSubmodule (squareKummerNormalizationBasis p s d c R)
        (fun i => (1 - X ^ (p ^ (d + 1) - 2 + 1)) ^
          (i.val * R / (p ^ (s + 1) + 1))) := by
  rw [squareKummerAffineOrder_span, basisMultipleSubmodule]
  simp only [squareKummerNormalizationBasis_clear_denominator]

/-- The affine defect is the quotient of the actual normalization by the original coordinate ring. -/
abbrev SquareKummerAffineDefect :=
  SquareKummerNormalization p s c (p ^ (d + 1) - 2) R ⧸
    (squareKummerAffineOrder p s d c R).toSubmodule

/-- Each radical character contributes one cyclic polynomial quotient to the affine defect. -/
def squareKummerAffineDefectEquiv :
    SquareKummerAffineDefect p s d c R ≃ₗ[(SquareConstantField p s)[X]]
      ∀ i : Fin (p ^ (s + 1) + 1), (SquareConstantField p s)[X] ⧸
        Ideal.span {((1 - X ^ (p ^ (d + 1) - 2 + 1)) ^
          (i.val * R / (p ^ (s + 1) + 1)) : (SquareConstantField p s)[X])} := by
  unfold SquareKummerAffineDefect
  rw [squareKummerAffineOrder_toSubmodule]
  exact basisMultipleQuotientEquiv _ _

/-- The affine normalization defect is finite-dimensional over the constant field. -/
theorem squareKummerAffineDefect_finite :
    Module.Finite (SquareConstantField p s) (SquareKummerAffineDefect p s d c R) := by
  change Module.Finite (SquareConstantField p s)
    (SquareKummerNormalization p s c (p ^ (d + 1) - 2) R ⧸ _)
  rw [squareKummerAffineOrder_toSubmodule]
  exact basisPolynomialQuotient_finite _ _
    (fun _ => pow_ne_zero _ (kummerBranchFactor_ne_zero _))

/-- Exact affine defect: branch degree times the sum of removed branch powers. -/
theorem squareKummerAffineDefect_finrank :
    Module.finrank (SquareConstantField p s) (SquareKummerAffineDefect p s d c R) =
      (p ^ (d + 1) - 1) *
        ∑ i : Fin (p ^ (s + 1) + 1), i.val * R / (p ^ (s + 1) + 1) := by
  change Module.finrank (SquareConstantField p s)
    (SquareKummerNormalization p s c (p ^ (d + 1) - 2) R ⧸ _) = _
  rw [squareKummerAffineOrder_toSubmodule,
    basisPolynomialQuotient_finrank _ _ (fun _ => pow_ne_zero _ (kummerBranchFactor_ne_zero _))]
  simp only [natDegree_pow, kummerBranchFactor_natDegree]
  have hq : 2 ≤ p ^ (d + 1) :=
    Nat.one_lt_pow (Nat.succ_ne_zero d) (Fact.out : p.Prime).one_lt
  rw [show p ^ (d + 1) - 2 + 1 = p ^ (d + 1) - 1 by omega, ← Finset.sum_mul, mul_comm]

#print axioms squareKummerAffineOrder_toSubmodule
#print axioms squareKummerAffineDefect_finrank

/-- The affine defect has a closed formula involving only the two exponents and their gcd. -/
theorem squareKummerAffineDefect_finrank_twice :
    2 * Module.finrank (SquareConstantField p s) (SquareKummerAffineDefect p s d c R) +
        (p ^ (d + 1) - 1) * (p ^ (s + 1) + 1) =
      (p ^ (d + 1) - 1) *
        (R * p ^ (s + 1) + Nat.gcd (p ^ (s + 1) + 1) R) := by
  have hf := ArithmeticHarmonicAnalysis.two_mul_sum_mul_div_add
    (p ^ (s + 1) + 1) R (Nat.succ_pos _)
  rw [← Fin.sum_univ_eq_sum_range] at hf
  simp only [Nat.add_sub_cancel, Nat.mul_comm R] at hf
  rw [squareKummerAffineDefect_finrank]
  calc
    _ = (p ^ (d + 1) - 1) *
        (2 * (∑ i : Fin (p ^ (s + 1) + 1), i.val * R / (p ^ (s + 1) + 1)) +
          (p ^ (s + 1) + 1)) := by ring
    _ = _ := by rw [hf, Nat.mul_comm (p ^ (s + 1)) R]

/-- The normalization adds no affine functions precisely for branch exponent zero or one. -/
theorem squareKummerAffineDefect_finrank_eq_zero_iff :
    Module.finrank (SquareConstantField p s) (SquareKummerAffineDefect p s d c R) = 0 ↔
      R ≤ 1 := by
  have hq : 2 ≤ p ^ (d + 1) :=
    Nat.one_lt_pow (Nat.succ_ne_zero d) (Fact.out : p.Prime).one_lt
  have hN : 2 ≤ p ^ (s + 1) + 1 := by
    have := Nat.one_le_pow (s + 1) p (Fact.out : p.Prime).pos
    omega
  rw [squareKummerAffineDefect_finrank, Nat.mul_eq_zero]
  simp only [show p ^ (d + 1) - 1 ≠ 0 by omega, false_or]
  rw [Fin.sum_univ_eq_sum_range
    (fun i : ℕ => i * R / (p ^ (s + 1) + 1)) (p ^ (s + 1) + 1)]
  simpa only [Nat.mul_comm R] using
    ArithmeticHarmonicAnalysis.sum_mul_div_eq_zero_iff (p ^ (s + 1) + 1) R hN

/-- The raw affine coordinate algebra equals its normalization exactly for exponent zero or one. -/
theorem squareKummerAffineOrder_eq_top_iff :
    squareKummerAffineOrder p s d c R = ⊤ ↔ R ≤ 1 := by
  letI := squareKummerAffineDefect_finite p s d c R
  have hzero := Module.finrank_eq_zero_iff_of_free (SquareConstantField p s)
    (SquareKummerAffineDefect p s d c R)
  rw [Submodule.Quotient.subsingleton_iff, Algebra.toSubmodule_eq_top] at hzero
  exact hzero.symm.trans (squareKummerAffineDefect_finrank_eq_zero_iff p s d c R)

/-- Affine normalization defect and the differential cutoffs partition the total pole-degree count. -/
theorem squareKummerAffineDefect_add_cutoffs (r : ℕ) :
    2 * Module.finrank (SquareConstantField p s)
        (SquareKummerAffineDefect p s d c
          (ArithmeticHarmonicAnalysis.kummerExponent (p ^ (d + 1)) r)) +
      2 * (∑ i ∈ Finset.range (p ^ (s + 1) + 1), kummerDifferentialCutoff p s d r i) =
        p ^ (s + 1) * ((p ^ (d + 1)) ^ r - 1) := by
  let R := ArithmeticHarmonicAnalysis.kummerExponent (p ^ (d + 1)) r
  have hq : 1 ≤ p ^ (d + 1) := Nat.one_le_pow _ _ (Fact.out : p.Prime).pos
  have hdegree : (p ^ (d + 1) - 1) * R = (p ^ (d + 1)) ^ r - 1 := by
    have h := ArithmeticHarmonicAnalysis.kummerExponent_mul_add (p ^ (d + 1) - 1) r
    rw [Nat.sub_add_cancel hq] at h
    change R * (p ^ (d + 1) - 1) + 1 = (p ^ (d + 1)) ^ r at h
    rw [Nat.mul_comm R] at h
    omega
  have hg : Nat.gcd (p ^ (s + 1) + 1) R ≤ p ^ (s + 1) + 1 :=
    Nat.le_of_dvd (Nat.succ_pos _) (Nat.gcd_dvd_left _ _)
  have hcut :
      2 * (∑ i ∈ Finset.range (p ^ (s + 1) + 1), kummerDifferentialCutoff p s d r i) +
        (p ^ (d + 1) - 1) * Nat.gcd (p ^ (s + 1) + 1) R =
          (p ^ (d + 1) - 1) * (p ^ (s + 1) + 1) := by
    rw [kummerDifferentialCutoff_sum_twice, ← mul_add, Nat.sub_add_cancel hg]
  have hdef := squareKummerAffineDefect_finrank_twice p s d c R
  have hright : (p ^ (d + 1) - 1) *
      (R * p ^ (s + 1) + Nat.gcd (p ^ (s + 1) + 1) R) =
        p ^ (s + 1) * ((p ^ (d + 1)) ^ r - 1) +
          (p ^ (d + 1) - 1) * Nat.gcd (p ^ (s + 1) + 1) R := by
    rw [mul_add, ← mul_assoc, hdegree, mul_comm ((p ^ (d + 1)) ^ r - 1)]
  rw [hright] at hdef
  change 2 * Module.finrank (SquareConstantField p s) (SquareKummerAffineDefect p s d c R) +
    2 * (∑ i ∈ Finset.range (p ^ (s + 1) + 1), kummerDifferentialCutoff p s d r i) = _
  omega

#print axioms squareKummerAffineDefectEquiv
#print axioms squareKummerAffineDefect_finrank_twice
#print axioms squareKummerAffineDefect_finrank_eq_zero_iff
#print axioms squareKummerAffineOrder_eq_top_iff
#print axioms squareKummerAffineDefect_add_cutoffs

end GaloisForLFunctions.ArithmeticCastelnuovoSeveri
