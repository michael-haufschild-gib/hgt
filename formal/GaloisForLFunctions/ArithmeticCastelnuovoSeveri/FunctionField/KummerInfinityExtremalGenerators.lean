import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FunctionField.KummerInfinityExtremal
import GaloisForLFunctions.ArithmeticHarmonicAnalysis.FiniteGroup.ReducedResidueTwoGenerators

/-!
# Two generators for the extremal infinity semigroups

When the nonzero reduced branch exponent `D` divides the covering degree
`N`, all infinity pole orders are generated by `N/D` and `1+(q-1)D`.
Combined with the conductor criterion, this gives an explicit semigroup
for every positive-genus member whose last gap is `2g-1`.
-/

noncomputable section
namespace GaloisForLFunctions.ArithmeticCastelnuovoSeveri
open Polynomial ArithmeticHarmonicAnalysis
variable (p : ℕ) [Fact p.Prime] (s : ℕ) (c : (SquareConstantField p s)ˣ) (d r : ℕ)
local notation "K" => SquareConstantField p s
local notation "N" => p ^ (s + 1) + 1
local notation "q" => p ^ (d + 1)
local notation "R" => kummerExponent q r
local notation "L" => SquareKummerField p s c (q - 2) R
local notation "g" => Module.finrank K (globalRegularDifferentials K L)

/-- A reduced branch exponent dividing the covering degree gives two explicit generators for every actual infinity pole order. -/
theorem squareKummerInfinity_reduced_divisor_poles (m : ℕ) (hd : R % N ∣ N) :
    (∃ x : L, IsIntegral K[X] x ∧
      squareKummerInfinityValuation p s c d r x = WithZero.exp (m : ℤ)) ↔
      ∃ a b : ℕ, (N / (R % N)) * a + (1 + (q - 1) * (R % N)) * b = m := by
  let A := N / (R % N)
  have hfactor : A * (R % N) = N := Nat.div_mul_cancel hd
  have hA : 0 < A := by
    apply Nat.pos_of_ne_zero
    intro hz
    rw [hz, zero_mul] at hfactor
    exact Nat.succ_ne_zero _ hfactor.symm
  have hD : 0 < R % N := by
    apply Nat.pos_of_ne_zero
    intro hz
    rw [hz, mul_zero] at hfactor
    exact Nat.succ_ne_zero _ hfactor.symm
  have h := reducedResidue_two_generator_iff A (R % N) (q - 1) m hA hD
  rw [hfactor] at h
  rw [squareKummer_exists_integral_pole_iff]
  simpa only [Nat.mul_mod, Nat.mod_mod] using h

/-- Positive genus with the last possible gap is equivalent to the small-divisor condition together with its complete two-generator pole description. -/
theorem squareKummerInfinity_extremal_generators_iff :
    (g ≠ 0 ∧ ¬ ∃ x : L, IsIntegral K[X] x ∧
      squareKummerInfinityValuation p s c d r x = WithZero.exp ((2 * g - 1 : ℕ) : ℤ)) ↔
      R % N ∣ N ∧ ∀ m : ℕ,
        (∃ x : L, IsIntegral K[X] x ∧
          squareKummerInfinityValuation p s c d r x = WithZero.exp (m : ℤ)) ↔
          ∃ a b : ℕ, (N / (R % N)) * a + (1 + (q - 1) * (R % N)) * b = m := by
  rw [squareKummerInfinity_positive_genus_last_gap_iff]
  constructor
  · intro hd
    exact ⟨hd, fun m => squareKummerInfinity_reduced_divisor_poles p s c d r m hd⟩
  · exact And.left

end GaloisForLFunctions.ArithmeticCastelnuovoSeveri
