import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FunctionField.KummerThreePointCyclic
import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FunctionField.KummerNormalization

/-!
# Three-point Kummer fields after extension of constants

The cyclic degree remains fixed when the constant field grows. Primitive
roots from the original square constant field embed into every extension,
so the same radical equation is still irreducible and Galois. Its actual
polynomial normalization is finite free and Dedekind over the new constants.
-/

noncomputable section
namespace GaloisForLFunctions.ArithmeticCastelnuovoSeveri
open Polynomial
variable (p : ℕ) [Fact p.Prime] (d n : ℕ)
    (E : Type*) [Field E] [Algebra (SquareConstantField p (kummerSquareIndex d n)) E]
local notation "K" => SquareConstantField p (kummerSquareIndex d n)
local notation "M" => primePowerKummerCyclicDegree p d n

/-- The fixed cyclic degree has the successor index used by the radical construction. -/
theorem primePowerThreePointExtension_index : M - 1 + 1 = M :=
  Nat.sub_add_cancel (primePowerKummerCyclicDegree_pos p d n)

/-- Extending constants retains the primitive roots of the original cyclic covering degree. -/
theorem primePowerThreePointExtension_primitiveRoots : (primitiveRoots (M - 1 + 1) E).Nonempty := by
  rw [primePowerThreePointExtension_index]
  obtain ⟨ζ, hζ⟩ := squareConstantField_threePoint_primitiveRoots p d n
  have hM := primePowerKummerCyclicDegree_pos p d n
  exact ⟨algebraMap K E ζ, (mem_primitiveRoots hM).mpr
    (((mem_primitiveRoots hM).mp hζ).map_of_injective (algebraMap K E).injective)⟩

private theorem extensionRationalPrimitiveRoots :
    (primitiveRoots (M - 1 + 1) (FractionRing E[X])).Nonempty := by
  obtain ⟨ζ, hζ⟩ := primePowerThreePointExtension_primitiveRoots p d n E
  exact ⟨algebraMap E (FractionRing E[X]) ζ, (mem_primitiveRoots (Nat.succ_pos _)).mpr
    (((mem_primitiveRoots (Nat.succ_pos _)).mp hζ).map_of_injective
      (algebraMap E (FractionRing E[X])).injective)⟩

/-- The literal three-point radical field over the larger constants, with unchanged cyclic degree. -/
abbrev PrimePowerThreePointExtensionField (c : Eˣ) (a : ℕ) :=
  KummerBranchField c 0 a (M - 1)

variable (c : Eˣ) (a : ℕ)
local notation "L" => PrimePowerThreePointExtensionField p d n E c a
local notation "F" => FractionRing E[X]

/-- The radical equation gives a finite extension after any extension of constants. -/
instance primePowerThreePointExtension_finiteDimensional : FiniteDimensional F L :=
  (monic_X_pow_sub_C _ (Nat.succ_ne_zero (M - 1))).finite_adjoinRoot

omit [Algebra (SquareConstantField p (kummerSquareIndex d n)) E] in
/-- The original covering degree remains the exact field degree over the new rational base. -/
theorem primePowerThreePointExtension_finrank : Module.finrank F L = M := by
  rw [kummerBranchField_finrank, primePowerThreePointExtension_index]

/-- The field generated by one radical already contains all roots of its defining polynomial. -/
theorem primePowerThreePointExtension_isSplittingField :
    IsSplittingField F L (X ^ (M - 1 + 1) - C (algebraMap E[X] F (kummerBranch c 0 a))) :=
  isSplittingField_AdjoinRoot_X_pow_sub_C (extensionRationalPrimitiveRoots p d n E)
    (kummerBranch_fraction_irreducible c 0 a (M - 1))

/-- The fixed-degree three-point equation remains Galois over every extension of the constants. -/
theorem primePowerThreePointExtension_isGalois : IsGalois F L := by
  letI := primePowerThreePointExtension_isSplittingField p d n E c a
  exact isGalois_of_isSplittingField_X_pow_sub_C (extensionRationalPrimitiveRoots p d n E)
    (kummerBranch_fraction_irreducible c 0 a (M - 1)) _

/-- All relative automorphisms are the original-degree roots of unity in the larger constants. -/
def primePowerThreePointExtensionAutEquiv :
    rootsOfUnity (M - 1 + 1) E ≃* (L ≃ₐ[F] L) :=
  (rootsOfUnityEquivOfPrimitiveRoots (algebraMap E F).injective
    (primePowerThreePointExtension_primitiveRoots p d n E)).trans
    (autAdjoinRootXPowSubCEquiv (extensionRationalPrimitiveRoots p d n E)
      (kummerBranch_fraction_irreducible c 0 a (M - 1)))

/-- The relative action multiplies the radical by its constant root of unity. -/
theorem primePowerThreePointExtensionAutEquiv_root (ζ : rootsOfUnity (M - 1 + 1) E) :
    primePowerThreePointExtensionAutEquiv p d n E c a ζ
      (AdjoinRoot.root (kummerBranchFieldPolynomial c 0 a (M - 1))) =
        algebraMap E L (ζ : Eˣ) * AdjoinRoot.root (kummerBranchFieldPolynomial c 0 a (M - 1)) := by
  change autAdjoinRootXPowSubC (M - 1 + 1)
    (algebraMap E[X] F (kummerBranch c 0 a)) _ _ = _
  erw [autAdjoinRootXPowSubC_root, Algebra.smul_def]
  change algebraMap F L
      ((rootsOfUnityEquivOfPrimitiveRoots (algebraMap E F).injective
        (primePowerThreePointExtension_primitiveRoots p d n E) ζ : Fˣ) : F) *
        AdjoinRoot.root (kummerBranchFieldPolynomial c 0 a (M - 1)) = _
  rw [val_rootsOfUnityEquivOfPrimitiveRoots_apply_coe,
    ← IsScalarTower.algebraMap_apply E F L]

/-- The actual integral closure of the new polynomial base in the fixed-degree radical field. -/
abbrev PrimePowerThreePointExtensionNormalization := integralClosure E[X] L
local notation "B" => PrimePowerThreePointExtensionNormalization p d n E c a

/-- The normalization is Dedekind because the explicit radical extension is separable. -/
instance primePowerThreePointExtensionNormalization_dedekind : IsDedekindDomain B := by
  letI := primePowerThreePointExtension_isGalois p d n E c a
  infer_instance

/-- The normalization is finite over the new polynomial base. -/
instance primePowerThreePointExtensionNormalization_finite : Module.Finite E[X] B := by
  letI := primePowerThreePointExtension_isGalois p d n E c a
  exact IsIntegralClosure.finite E[X] F L _

/-- Torsion-freeness over the polynomial PID makes the normalization free. -/
instance primePowerThreePointExtensionNormalization_free : Module.Free E[X] B := by
  letI := primePowerThreePointExtension_isGalois p d n E c a
  exact IsIntegralClosure.module_free E[X] F L _

/-- The normalized ring has the actual fixed-degree Kummer field as its fraction field. -/
instance primePowerThreePointExtensionNormalization_fractionRing : IsFractionRing B L :=
  IsIntegralClosure.isFractionRing_of_finite_extension E[X] F L _

/-- The normalization rank is the unchanged cyclic covering degree. -/
theorem primePowerThreePointExtensionNormalization_finrank : Module.finrank E[X] B = M := by
  letI := primePowerThreePointExtension_isGalois p d n E c a
  rw [IsIntegralClosure.rank E[X] F L]
  exact primePowerThreePointExtension_finrank p d n E c a

/-- The canonical radical lies in the actual normalization. -/
def primePowerThreePointExtensionIntegralRoot : B :=
  ⟨AdjoinRoot.root (kummerBranchFieldPolynomial c 0 a (M - 1)),
    kummerBranchField_root_integral c 0 a (M - 1)⟩

omit [Fact p.Prime] [Algebra (SquareConstantField p (kummerSquareIndex d n)) E] in
/-- The normalized radical satisfies its literal three-point power equation. -/
theorem primePowerThreePointExtensionIntegralRoot_pow :
    primePowerThreePointExtensionIntegralRoot p d n E c a ^ (M - 1 + 1) =
      algebraMap E[X] B (kummerBranch c 0 a) := by
  apply Subtype.ext
  exact (kummerBranchField_root_pow c 0 a (M - 1)).trans
    (IsScalarTower.algebraMap_apply _ _ _ _).symm

omit [Fact p.Prime] [Algebra (SquareConstantField p (kummerSquareIndex d n)) E] in
/-- The canonical integral radical is nonzero. -/
theorem primePowerThreePointExtensionIntegralRoot_ne_zero :
    primePowerThreePointExtensionIntegralRoot p d n E c a ≠ 0 := by
  intro h
  exact kummerBranchField_root_ne_zero c 0 a (M - 1) (congrArg Subtype.val h)

end GaloisForLFunctions.ArithmeticCastelnuovoSeveri
