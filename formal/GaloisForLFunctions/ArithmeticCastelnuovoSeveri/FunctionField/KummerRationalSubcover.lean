import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FunctionField.KummerBranchUnit
import GaloisForLFunctions.HTGeometry.FracXTranscendental
import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FiniteField.KummerPowerSubfields


/-!
# A rational subcover of degree gcd

The quotient radical `u` satisfies `u^gcd(N,R)=c y`, so the original
coordinate belongs to `K(u)`. The field generated by `u` over `K(y)`
is the corresponding divisor-power subfield, of degree `gcd(N,R)`.
It is explicitly isomorphic over constants to a rational function field;
the remaining radical extension has degree `N/gcd(N,R)`.
-/

noncomputable section
namespace GaloisForLFunctions.ArithmeticCastelnuovoSeveri
open Polynomial
open scoped IntermediateField
/-- Dividing a generator by a nonzero base scalar does not change its simple field extension. -/
theorem adjoin_div_algebraMap_eq {F L : Type*} [Field F] [Field L] [Algebra F L]
    (x : L) (a : F) (ha : a ≠ 0) : F⟮x / algebraMap F L a⟯ = F⟮x⟯ := by
  have hmap : algebraMap F L a ≠ 0 :=
    fun h => ha ((algebraMap F L).injective (h.trans (map_zero _).symm))
  apply le_antisymm
  · apply IntermediateField.adjoin_simple_le_iff.mpr
    exact div_mem (IntermediateField.mem_adjoin_simple_self F x)
      ((F⟮x⟯).algebraMap_mem a)
  · apply IntermediateField.adjoin_simple_le_iff.mpr
    have hmem : (x / algebraMap F L a) * algebraMap F L a ∈ F⟮x / algebraMap F L a⟯ :=
      mul_mem (IntermediateField.mem_adjoin_simple_self F _)
        ((F⟮x / algebraMap F L a⟯).algebraMap_mem a)
    simpa only [div_mul_cancel₀ x hmap] using hmem

variable {K : Type*} [Field K] (c : Kˣ) (b R n : ℕ)

/-- The actual intermediate extension generated over the rational base by the quotient radical. -/
def kummerBranchUnitSubfield : IntermediateField (FractionRing K[X]) (KummerBranchField c b R n) :=
  (FractionRing K[X])⟮kummerBranchUnitRoot c b R n⟯

/-- The quotient-radical subfield is the divisor-power subfield of degree `gcd(N,R)`. -/
theorem kummerBranchUnitSubfield_eq :
    kummerBranchUnitSubfield c b R n =
      kummerPowerSubfield c b R n ((n + 1) / Nat.gcd (n + 1) R) := by
  let F := FractionRing K[X]
  let t : F := algebraMap K[X] F (1 - X ^ (b + 1))
  have ht : t ≠ 0 := fun h => kummerBranchFactor_ne_zero (K := K) b
    (IsFractionRing.injective K[X] F (h.trans (map_zero _).symm))
  have h := adjoin_div_algebraMap_eq
    (AdjoinRoot.root (kummerBranchFieldPolynomial c b R n) ^ ((n + 1) / Nat.gcd (n + 1) R))
    (t ^ (R / Nat.gcd (n + 1) R)) (pow_ne_zero _ ht)
  rw [map_pow, ← IsScalarTower.algebraMap_apply] at h
  exact h

/-- The quotient radical gives a subcover of degree `gcd(N,R)` over the original base. -/
theorem kummerBranchUnitSubfield_finrank :
    Module.finrank (FractionRing K[X]) (kummerBranchUnitSubfield c b R n) = Nat.gcd (n + 1) R := by
  let δ := Nat.gcd (n + 1) R
  let D := (n + 1) / δ
  have hδ : δ ∣ n + 1 := Nat.gcd_dvd_left _ _
  have hD : D ∣ n + 1 := Nat.div_dvd_of_dvd hδ
  have hDpos : 0 < D := Nat.div_pos (Nat.le_of_dvd (Nat.succ_pos n) hδ)
    (Nat.gcd_pos_of_pos_left R (Nat.succ_pos n))
  rw [kummerBranchUnitSubfield_eq, kummerPowerSubfield_finrank_of_dvd c b R n D hD]
  apply Nat.eq_of_mul_eq_mul_left hDpos
  rw [Nat.mul_div_cancel' hD]
  exact (Nat.div_mul_cancel hδ).symm

/-- The remaining extension above the rational subcover has degree `N/gcd(N,R)`. -/
theorem kummerBranchUnitSubfield_relative_finrank :
    Module.finrank (kummerBranchUnitSubfield c b R n) (KummerBranchField c b R n) =
      (n + 1) / Nat.gcd (n + 1) R := by
  rw [kummerBranchUnitSubfield_eq, kummerPowerSubfield_relative_finrank,
    Nat.gcd_eq_right (Nat.div_dvd_of_dvd (Nat.gcd_dvd_left _ _))]

/-- The original rational coordinate is a polynomial in the quotient radical. -/
theorem kummerBranchUnitRoot_coordinate :
    algebraMap K[X] (KummerBranchField c b R n) X =
      algebraMap K (KummerBranchField c b R n) (c⁻¹ : Kˣ) *
        kummerBranchUnitRoot c b R n ^ Nat.gcd (n + 1) R := by
  rw [kummerBranchUnitRoot_pow, ← mul_assoc, ← map_mul]
  simp only [Units.val_inv_eq_inv_val, inv_mul_cancel₀ (Units.ne_zero c), map_one, one_mul]

/-- Evaluating at the polynomial coordinate is the canonical polynomial embedding. -/
theorem kummerBranchField_aeval_coordinate :
    Polynomial.aeval (algebraMap K[X] (KummerBranchField c b R n) X) =
      IsScalarTower.toAlgHom K K[X] (KummerBranchField c b R n) := by
  apply Polynomial.algHom_ext
  rw [Polynomial.aeval_X]
  rfl

/-- The polynomial coordinate remains transcendental in the radical extension. -/
theorem kummerBranchField_coordinate_transcendental :
    Transcendental K (algebraMap K[X] (KummerBranchField c b R n) X) := by
  let L := KummerBranchField c b R n
  have hinj : Function.Injective (algebraMap K[X] L) := by
    rw [IsScalarTower.algebraMap_eq K[X] (FractionRing K[X]) L]
    exact (algebraMap (FractionRing K[X]) L).injective.comp (IsFractionRing.injective K[X] _)
  rw [transcendental_iff]
  intro f hf
  rw [kummerBranchField_aeval_coordinate] at hf
  exact hinj (hf.trans (map_zero _).symm)

/-- The quotient radical is a transcendental parameter over the constants. -/
theorem kummerBranchUnitRoot_transcendental : Transcendental K (kummerBranchUnitRoot c b R n) := by
  intro h
  apply kummerBranchField_coordinate_transcendental c b R n
  rw [kummerBranchUnitRoot_coordinate]
  exact (isAlgebraic_algebraMap (R := K) (A := KummerBranchField c b R n) _).mul
    (h.pow _)

/-- The quotient radical generates an actual rational function field inside the Kummer field. -/
def kummerRationalSubcoverEquiv : FractionRing K[X] ≃ₐ[K]
    K⟮kummerBranchUnitRoot c b R n⟯ :=
  GaloisForLFunctions.HTGeometry.fracRealizeEquiv
    (kummerBranchUnitRoot_transcendental c b R n)

/-- The rational subcover contains the original base coordinate. -/
theorem kummerRationalSubcover_coordinate_mem :
    algebraMap K[X] (KummerBranchField c b R n) X ∈ K⟮kummerBranchUnitRoot c b R n⟯ := by
  rw [kummerBranchUnitRoot_coordinate]
  exact mul_mem ((K⟮kummerBranchUnitRoot c b R n⟯).algebraMap_mem _)
    (pow_mem (IntermediateField.mem_adjoin_simple_self K _) _)

/-- Every rational function in the original coordinate lies in the quotient-radical rational field. -/
theorem kummerRationalSubcover_base_mem (x : FractionRing K[X]) :
    algebraMap (FractionRing K[X]) (KummerBranchField c b R n) x ∈
      K⟮kummerBranchUnitRoot c b R n⟯ := by
  let L := KummerBranchField c b R n
  have hp : ∀ f : K[X], algebraMap K[X] L f ∈ K⟮kummerBranchUnitRoot c b R n⟯ := by
    intro f
    change (IsScalarTower.toAlgHom K K[X] L) f ∈ _
    rw [← kummerBranchField_aeval_coordinate]
    apply (IntermediateField.adjoin_simple_le_iff.mpr (kummerRationalSubcover_coordinate_mem c b R n))
    exact IntermediateField.algebra_adjoin_le_adjoin K _
      (Polynomial.aeval_mem_adjoin_singleton K (algebraMap K[X] L X))
  obtain ⟨f, g, _, rfl⟩ := IsFractionRing.div_surjective (A := K[X]) x
  rw [map_div₀, ← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply]
  exact div_mem (hp f) (hp g)

/-- The intermediate field over the original rational base is the same rational field over constants. -/
theorem kummerBranchUnitSubfield_restrictScalars :
    (kummerBranchUnitSubfield c b R n).restrictScalars K = K⟮kummerBranchUnitRoot c b R n⟯ := by
  apply le_antisymm
  · intro x hx
    change x ∈ (FractionRing K[X])⟮kummerBranchUnitRoot c b R n⟯ at hx
    induction hx using IntermediateField.adjoin_induction with
    | mem x hx =>
        obtain rfl := Set.mem_singleton_iff.mp hx
        exact IntermediateField.mem_adjoin_simple_self K _
    | algebraMap x => exact kummerRationalSubcover_base_mem c b R n x
    | add x y hx hy hx' hy' => exact add_mem hx' hy'
    | inv x hx hx' => exact inv_mem hx'
    | mul x y hx hy hx' hy' => exact mul_mem hx' hy'
  · apply IntermediateField.adjoin_simple_le_iff.mpr
    exact IntermediateField.mem_adjoin_simple_self (FractionRing K[X]) _

/-- The degree-`gcd(N,R)` intermediate field is explicitly a rational function field over the constants. -/
def kummerBranchUnitSubfield_rationalEquiv : FractionRing K[X] ≃ₐ[K]
    kummerBranchUnitSubfield c b R n :=
  (kummerRationalSubcoverEquiv c b R n).trans
    (IntermediateField.equivOfEq (kummerBranchUnitSubfield_restrictScalars c b R n).symm)

end GaloisForLFunctions.ArithmeticCastelnuovoSeveri
