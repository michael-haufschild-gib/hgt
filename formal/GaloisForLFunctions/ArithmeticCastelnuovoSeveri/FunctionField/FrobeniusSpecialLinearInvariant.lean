import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FunctionField.FrobeniusSpecialLinearAutomorphisms

/-!
# The rational invariant of determinant-one radical substitutions

The Dickson factor and the appropriate radical power have the same
projective denominator. Their quotient is therefore fixed by every
constructed determinant-one automorphism. Its covering-degree power
is an explicit rational function of the original coordinate.
-/

noncomputable section
namespace GaloisForLFunctions.ArithmeticCastelnuovoSeveri
open Polynomial Matrix ArithmeticHarmonicAnalysis
open scoped IntermediateField
variable (K E : Type*) [Field K] [Fintype K] [Field E] [Algebra K E]
    (γ : Eˣ) (R : ℕ)
local notation "q" => Fintype.card K
local notation "k" => q ^ 2 - q
local notation "n" => k * R + q
local notation "L" => FrobeniusSpecialLinearField K E γ R
local notation "x" => algebraMap E[X] L X
local notation "z" => AdjoinRoot.root (frobeniusKummerFieldPolynomial γ (q - 2) R n)

private theorem quotientPower_cancel {H : Type*} [Field H] (g A B : H) (i j ℓ : ℕ)
    (hg : g ≠ 0) (hA : A ≠ 0) (hB : B ≠ 0) :
    (B ^ (j * ℓ) * B ^ i) / (g ^ ℓ * A ^ ℓ * B ^ (j * ℓ)) =
      g⁻¹ ^ ℓ * B ^ i / A ^ ℓ := by
  field_simp [hg, hA, hB]
  simp only [one_div, ← mul_pow, mul_inv_cancel₀ hg, one_pow]

/-- The quotient of the two factors with equal projective denominator weight. -/
def frobeniusSpecialLinearInvariant : L :=
  (1 + (x ^ q - x) ^ (q - 1)) / z ^ k

/-- Every constructed determinant-one automorphism fixes the explicit invariant. -/
theorem frobeniusSpecialLinearAut_fixes_invariant (M : SpecialLinearGroup (Fin 2) K) :
    frobeniusSpecialLinearAut K E γ R M (frobeniusSpecialLinearInvariant K E γ R) =
      frobeniusSpecialLinearInvariant K E γ R := by
  let D := frobeniusSpecialLinearDenominator K E γ R M
  let u := frobeniusSpecialLinearCoordinate K E γ R M
  let B : L := 1 + (x ^ q - x) ^ (q - 1)
  letI : Algebra K L := Algebra.compHom L (algebraMap K E)
  have hdet : M 0 0 * M 1 1 - M 0 1 * M 1 0 ≠ 0 := by
    have he : M 0 0 * M 1 1 - M 0 1 * M 1 0 = 1 := by
      simpa only [Matrix.det_fin_two] using M.property
    rw [he]
    exact one_ne_zero
  have hB : 1 + (u ^ q - u) ^ (q - 1) = B / D ^ k :=
    finiteField_mobius_dicksonFactor (M 0 0) (M 0 1) (M 1 0) (M 1 1) x hdet
      (frobeniusSpecialLinearField_additive_ne_zero K E γ R)
      (frobeniusSpecialLinearDenominator_ne_zero K E γ R M)
  change frobeniusSpecialLinearHom K E γ R M (B / z ^ k) = B / z ^ k
  change frobeniusSpecialLinearHom K E γ R M
    ((1 + (x ^ q - x) ^ (q - 1)) / z ^ k) = _
  rw [map_div₀, map_add, map_one, map_pow, map_sub, map_pow,
    frobeniusSpecialLinearHom_coordinate, map_pow, frobeniusSpecialLinearHom_root, div_pow]
  change (1 + (u ^ q - u) ^ (q - 1)) / (z ^ k / D ^ k) = B / z ^ k
  rw [hB]
  have hD : D ≠ 0 := frobeniusSpecialLinearDenominator_ne_zero K E γ R M
  exact div_div_div_cancel_right₀ (pow_ne_zero k hD) _ _

omit [Algebra K E] in
/-- The covering-degree power of the invariant is an explicit reduced Dickson quotient. -/
theorem frobeniusSpecialLinearInvariant_pow :
    frobeniusSpecialLinearInvariant K E γ R ^ (n + 1) =
      (algebraMap E L γ)⁻¹ ^ k * (1 + (x ^ q - x) ^ (q - 1)) ^ (q + 1) /
        (x ^ q - x) ^ k := by
  let A : L := x ^ q - x
  let B : L := 1 + A ^ (q - 1)
  let g : L := algebraMap E L γ
  have hA : A ≠ 0 := frobeniusSpecialLinearField_additive_ne_zero K E γ R
  have hg : g ≠ 0 := (map_ne_zero (algebraMap E L)).mpr γ.ne_zero
  have hz : z ^ (n + 1) = g * A * B ^ R := frobeniusSpecialLinearField_root_equation K E γ R
  have hp : (z ^ k) ^ (n + 1) = (z ^ (n + 1)) ^ k :=
    (pow_mul z k (n + 1)).symm.trans
      ((congrArg (fun j : ℕ => z ^ j) (Nat.mul_comm k (n + 1))).trans (pow_mul z (n + 1) k))
  have hBpow : B ^ (n + 1) = B ^ (R * k) * B ^ (q + 1) :=
    (congrArg (fun j : ℕ => B ^ j) (show n + 1 = R * k + (q + 1) by ring)).trans
      (pow_add B (R * k) (q + 1))
  change (B / z ^ k) ^ (n + 1) = g⁻¹ ^ k * B ^ (q + 1) / A ^ k
  by_cases hB : B = 0
  · rw [hB, zero_div, zero_pow (Nat.succ_ne_zero _), zero_pow (Nat.succ_ne_zero _),
      mul_zero, zero_div]
  · rw [div_pow, hp, hz, mul_pow, mul_pow, ← pow_mul B R k, hBpow]
    exact quotientPower_cancel g A B (q + 1) R k hg hA hB

/-- The actual intermediate field generated by the invariant over the stated constants. -/
def frobeniusSpecialLinearInvariantField : IntermediateField E L :=
  E⟮frobeniusSpecialLinearInvariant K E γ R⟯

private theorem invariantField_fixed (M : SpecialLinearGroup (Fin 2) K)
    (a : L) (ha : a ∈ frobeniusSpecialLinearInvariantField K E γ R) :
    frobeniusSpecialLinearAut K E γ R M a = a := by
  let σ := frobeniusSpecialLinearAut K E γ R M
  change a ∈ E⟮frobeniusSpecialLinearInvariant K E γ R⟯ at ha
  change σ a = a
  induction ha using IntermediateField.adjoin_induction with
  | mem a ha =>
      rw [Set.mem_singleton_iff.mp ha]
      exact frobeniusSpecialLinearAut_fixes_invariant K E γ R M
  | algebraMap a => exact σ.commutes a
  | add a b _ _ ha hb => rw [map_add, ha, hb]
  | mul a b _ _ ha hb => rw [map_mul, ha, hb]
  | inv a _ ha => rw [map_inv₀, ha]

/-- The determinant-one automorphisms fix the full actual invariant subfield. -/
def frobeniusSpecialLinearRelativeAut (M : SpecialLinearGroup (Fin 2) K) :
    L ≃ₐ[frobeniusSpecialLinearInvariantField K E γ R] L :=
  { (frobeniusSpecialLinearAut K E γ R M).toRingEquiv with
    commutes' := fun a => invariantField_fixed K E γ R M a.val a.property }

end GaloisForLFunctions.ArithmeticCastelnuovoSeveri
