import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FunctionField.FrobeniusSpecialLinearInvariant
import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FunctionField.FrobeniusRationalBaseDegree
import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FunctionField.FrobeniusDicksonCoordinateDegree
import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FunctionField.RationalPolynomialSubfields

/-!
# The exact degree over the determinant-one invariant

The covering-degree power of the invariant is a Dickson quotient of
index `q(q²-1)` in the original rational coordinate field. Comparing
the towers through these two rational fields cancels the radical
degree and gives the invariant-field degree exactly.
-/

noncomputable section
namespace GaloisForLFunctions.ArithmeticCastelnuovoSeveri
open Polynomial Matrix
open scoped IntermediateField
variable (K E : Type*) [Field K] [Fintype K] [Field E]
    (γ : Eˣ) (R : ℕ)
local notation "q" => Fintype.card K
local notation "k" => q ^ 2 - q
local notation "n" => k * R + q
local notation "L" => FrobeniusSpecialLinearField K E γ R
local notation "x" => algebraMap E[X] L X
local notation "w" => frobeniusSpecialLinearInvariant K E γ R

private theorem group_order_pos : 0 < q * (q ^ 2 - 1) := by
  have hq : 1 < q := Fintype.one_lt_card
  have hpow : 1 < q ^ 2 := Nat.one_lt_pow (Nat.succ_ne_zero 1) hq
  exact Nat.mul_pos (lt_trans Nat.zero_lt_one hq) (by omega)

/-- The power of the invariant has the Dickson quotient index in the original rational base. -/
theorem frobeniusSpecialLinearInvariant_power_relfinrank :
    E⟮w ^ (n + 1)⟯.relfinrank E⟮x⟯ = q * (q ^ 2 - 1) := by
  have hx := frobeniusKummerField_coordinate_transcendental γ (q - 2) R n
  have h := frobeniusDicksonCoordinate_relfinrank hx q Fintype.one_lt_card (γ⁻¹ ^ k)
  have hk : k = q * (q - 1) := by
    rw [Nat.mul_sub_left_distrib, Nat.mul_one, pow_two]
  have hAk : (x ^ q - x) ^ k = (x ^ q - x) ^ (q * (q - 1)) :=
    congrArg (fun j : ℕ => (x ^ q - x) ^ j) hk
  have hc : algebraMap E L ((γ⁻¹ ^ k : Eˣ) : E) = (algebraMap E L γ)⁻¹ ^ k := by
    rw [Units.val_pow_eq_pow_val, Units.val_inv_eq_inv_val, map_pow, map_inv₀]
  have he := frobeniusSpecialLinearInvariant_pow K E γ R
  rw [hAk, ← hc] at he
  rwa [← he] at h

private theorem invariant_power_le_coordinate : E⟮w ^ (n + 1)⟯ ≤ E⟮x⟯ := by
  apply IntermediateField.adjoin_simple_le_iff.mpr
  rw [frobeniusSpecialLinearInvariant_pow]
  let B := E⟮x⟯
  have hx : x ∈ B := IntermediateField.mem_adjoin_simple_self E x
  have hA : x ^ q - x ∈ B := B.sub_mem (pow_mem hx q) hx
  have hB : 1 + (x ^ q - x) ^ (q - 1) ∈ B := B.add_mem B.one_mem (pow_mem hA _)
  exact B.div_mem
    (B.mul_mem (pow_mem (B.inv_mem (B.algebraMap_mem (γ : E))) _) (pow_mem hB _))
    (pow_mem hA _)

/-- The full field has degree `q(q²-1)N` over the field generated by the `N`th power of the invariant. -/
theorem frobeniusSpecialLinearInvariant_power_finrank :
    Module.finrank E⟮w ^ (n + 1)⟯ L = q * (q ^ 2 - 1) * (n + 1) := by
  have h := IntermediateField.relfinrank_mul_finrank_top
    (invariant_power_le_coordinate K E γ R)
  rw [frobeniusSpecialLinearInvariant_power_relfinrank,
    frobeniusKummerField_coordinate_finrank] at h
  exact h.symm

/-- The explicit invariant is transcendental over the stated constant field. -/
theorem frobeniusSpecialLinearInvariant_transcendental : Transcendental E w := by
  intro hw
  let A := E⟮w ^ (n + 1)⟯
  letI : FiniteDimensional A L := FiniteDimensional.of_finrank_pos (by
    change 0 < Module.finrank E⟮w ^ (n + 1)⟯ L
    rw [frobeniusSpecialLinearInvariant_power_finrank]
    exact Nat.mul_pos (group_order_pos K) (Nat.succ_pos _))
  letI : FiniteDimensional E A := (IntermediateField.adjoin.powerBasis (hw.isIntegral.pow (n + 1))).finite
  letI : FiniteDimensional E L := FiniteDimensional.trans E A L
  exact frobeniusKummerField_coordinate_transcendental γ (q - 2) R n
    (Algebra.IsAlgebraic.isAlgebraic (R := E) x)

/-- The actual invariant subfield has exact index `q(q²-1)` in the radical function field. -/
theorem frobeniusSpecialLinearInvariant_finrank :
    Module.finrank (frobeniusSpecialLinearInvariantField K E γ R) L = q * (q ^ 2 - 1) := by
  let A := E⟮w ^ (n + 1)⟯
  let J := E⟮w⟯
  have hAJ : A.relfinrank J = n + 1 := by
    have h := polynomialCoordinate_relfinrank
      (frobeniusSpecialLinearInvariant_transcendental K E γ R) (X ^ (n + 1))
    simpa only [map_pow, aeval_X, natDegree_X_pow] using h
  have hle : A ≤ J := IntermediateField.adjoin_simple_le_iff.mpr
    (pow_mem (IntermediateField.mem_adjoin_simple_self E w) (n + 1))
  have h := IntermediateField.relfinrank_mul_finrank_top hle
  rw [hAJ, frobeniusSpecialLinearInvariant_power_finrank] at h
  apply Nat.eq_of_mul_eq_mul_left (Nat.succ_pos n)
  change (n + 1) * Module.finrank J L = (n + 1) * (q * (q ^ 2 - 1))
  exact h.trans (Nat.mul_comm _ _)

/-- The invariant inclusion is a finite extension of its exact positive degree. -/
instance frobeniusSpecialLinearInvariant_finiteDimensional :
    FiniteDimensional (frobeniusSpecialLinearInvariantField K E γ R) L :=
  FiniteDimensional.of_finrank_pos (by
    rw [frobeniusSpecialLinearInvariant_finrank]
    exact group_order_pos K)

end GaloisForLFunctions.ArithmeticCastelnuovoSeveri
