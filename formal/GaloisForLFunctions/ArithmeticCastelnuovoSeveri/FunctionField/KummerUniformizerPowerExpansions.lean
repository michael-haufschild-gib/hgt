import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FunctionField.KummerFrobeniusDegree
import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FunctionField.ValuationPowerCoordinates


/-!
# Frobenius power expansions in a local parameter

Every uniformizer generates the Kummer field over its Frobenius subfield.
Its first `p` powers form a basis, so every function is uniquely a sum of
`p`th powers times those powers. Distinct valuation classes force all
coefficients to be integral whenever the function is integral.
-/

noncomputable section
namespace GaloisForLFunctions.ArithmeticCastelnuovoSeveri
open scoped IntermediateField
variable (p : ℕ) [Fact p.Prime] (s : ℕ) (c : (SquareConstantField p s)ˣ) (b R : ℕ)
    (v : Valuation (SquareKummerField p s c b R) (WithZero (Multiplicative ℤ)))
    (π : SquareKummerField p s c b R) (hπ : v π = WithZero.exp (-1 : ℤ))

include v hπ

/-- The field generated by a uniformizer over the Frobenius field is the whole Kummer field. -/
def squareKummerUniformizerAdjoinEquiv :
    (SquareKummerFrobeniusField p s c b R)⟮π⟯ ≃ₐ[SquareKummerFrobeniusField p s c b R]
      SquareKummerField p s c b R := by
  refine AlgEquiv.ofBijective
    (IntermediateField.val ((SquareKummerFrobeniusField p s c b R)⟮π⟯)) ⟨?_, ?_⟩
  · intro x y h
    exact Subtype.ext h
  · intro x
    refine ⟨⟨x, ?_⟩, rfl⟩
    rw [squareKummer_frobenius_adjoin_uniformizer p s c b R v π hπ]
    trivial

/-- The first `p` uniformizer powers form a basis over the Frobenius subfield. -/
def squareKummerUniformizerBasis :
    Module.Basis (Fin p) (SquareKummerFrobeniusField p s c b R) (SquareKummerField p s c b R) := by
  let K := SquareConstantField p s
  let L := SquareKummerField p s c b R
  let P := SquareKummerFrobeniusField p s c b R
  have hint : IsIntegral P π := GaloisForLFunctions.HTGeometry.isIntegral_of_pow_mem (Fact.out : p.Prime).pos
    (show π ^ p = algebraMap P L (frobeniusPowerElement K L p π) from rfl)
  let pb := IntermediateField.adjoin.powerBasis hint
  have hd : pb.dim = p := pb.finrank.symm.trans
    (frobeniusPowerField_adjoin_finrank K L p π
      (frobeniusPowerField_uniformizer_notMem K L p v π hπ))
  exact (pb.basis.map (squareKummerUniformizerAdjoinEquiv p s c b R v π hπ).toLinearEquiv).reindex
    (finCongr hd)

/-- The uniformizer basis is the literal sequence of powers. -/
theorem squareKummerUniformizerBasis_apply (i : Fin p) :
    squareKummerUniformizerBasis p s c b R v π hπ i = π ^ i.val := by
  dsimp only [squareKummerUniformizerBasis]
  simp only [Module.Basis.reindex_apply, Module.Basis.map_apply,
    PowerBasis.basis_eq_pow, AlgEquiv.toLinearEquiv_apply, map_pow,
    IntermediateField.adjoin.powerBasis_gen, finCongr_symm, finCongr_apply, Fin.val_cast]; rfl

/-- Every function has a Frobenius power expansion in a uniformizer. -/
theorem squareKummer_uniformizer_power_expansion (x : SquareKummerField p s c b R) :
    ∃ a : Fin p → SquareKummerField p s c b R,
      x = ∑ i : Fin p, a i ^ p * π ^ i.val := by
  classical
  let B := squareKummerUniformizerBasis p s c b R v π hπ
  have hc : ∀ i : Fin p, ∃ a : SquareKummerField p s c b R, a ^ p = (B.repr x i : SquareKummerField p s c b R) :=
    fun i => (B.repr x i).property
  choose a ha using hc
  refine ⟨a, ?_⟩
  calc
    x = ∑ i : Fin p, B.repr x i • B i := (B.sum_repr x).symm
    _ = ∑ i : Fin p, a i ^ p * π ^ i.val := by
      apply Finset.sum_congr rfl
      intro i _
      rw [squareKummerUniformizerBasis_apply, Algebra.smul_def]
      change (B.repr x i : SquareKummerField p s c b R) * π ^ i.val = a i ^ p * π ^ i.val
      rw [ha i]

/-- An integral function has a uniformizer power expansion with every Frobenius root integral. -/
theorem squareKummer_uniformizer_integral_power_expansion
    (x : SquareKummerField p s c b R) (hx : v x ≤ 1) :
    ∃ a : Fin p → SquareKummerField p s c b R,
      (∀ i, v (a i) ≤ 1) ∧ x = ∑ i : Fin p, a i ^ p * π ^ i.val := by
  obtain ⟨a, ha⟩ := squareKummer_uniformizer_power_expansion p s c b R v π hπ x
  refine ⟨a, ?_, ha⟩
  apply valuation_powerCoordinates_le_one v π hπ p a
  rw [← ha]
  exact hx

end GaloisForLFunctions.ArithmeticCastelnuovoSeveri
