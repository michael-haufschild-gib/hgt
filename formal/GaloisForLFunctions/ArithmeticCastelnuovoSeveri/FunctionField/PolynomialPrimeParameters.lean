import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FunctionField.RationalPlaceValuations
import Mathlib.FieldTheory.Perfect

/-!
# Parameters and derivatives at polynomial places

Every finite polynomial place has an irreducible generator, which is
a uniformizer at that place.
Perfectness makes its derivative coprime to it, hence a valuation unit.
These two values transfer polynomial ramification to differential orders.
-/

noncomputable section
namespace GaloisForLFunctions.ArithmeticCastelnuovoSeveri
open Polynomial IsDedekindDomain
variable {K : Type*} [Field K]

/-- Every height-one polynomial prime is generated by an irreducible polynomial. -/
theorem polynomial_heightOne_exists_irreducible (w : HeightOneSpectrum K[X]) :
    ∃ π : K[X], ∃ hπ : Irreducible π,
      w = GaloisForLFunctions.HTGeometry.polyPlace hπ := by
  let π := Submodule.IsPrincipal.generator w.asIdeal
  have hspan : Ideal.span {π} = w.asIdeal := Ideal.span_singleton_generator w.asIdeal
  have hπ0 : π ≠ 0 := by
    intro h
    apply w.ne_bot
    rw [← hspan, h, Ideal.span_singleton_zero]
  have hprime : Prime π := (Ideal.span_singleton_prime hπ0).mp (hspan.symm ▸ w.isPrime)
  exact ⟨π, hprime.irreducible, HeightOneSpectrum.ext hspan.symm⟩

/-- The irreducible generator has normalized order one at its polynomial place. -/
theorem polynomial_irreduciblePlace_parameter {π : K[X]} (hπ : Irreducible π) :
    (GaloisForLFunctions.HTGeometry.polyPlace hπ).valuation (FractionRing K[X])
      (algebraMap K[X] (FractionRing K[X]) π) = WithZero.exp (-1 : ℤ) := by
  rw [polynomial_irreduciblePlace_valuation hπ π hπ.ne_zero, multiplicity_self, Nat.cast_one]

/-- Over perfect constants, an irreducible polynomial does not divide its derivative. -/
theorem polynomial_irreducible_not_dvd_derivative [PerfectField K]
    {π : K[X]} (hπ : Irreducible π) : ¬ π ∣ π.derivative := by
  intro h
  have hc : IsCoprime π π.derivative := PerfectField.separable_of_irreducible hπ
  exact hπ.not_isUnit (hc.isUnit_of_dvd h)

/-- The derivative of an irreducible polynomial is a unit at its base place over perfect constants. -/
theorem polynomial_irreduciblePlace_derivative [PerfectField K]
    {π : K[X]} (hπ : Irreducible π) :
    (GaloisForLFunctions.HTGeometry.polyPlace hπ).valuation (FractionRing K[X])
      (algebraMap K[X] (FractionRing K[X]) π.derivative) = 1 := by
  have hnot := polynomial_irreducible_not_dvd_derivative hπ
  have hder : π.derivative ≠ 0 := by
    intro h
    apply hnot
    rw [h]
    exact dvd_zero _
  rw [polynomial_irreduciblePlace_valuation hπ π.derivative hder,
    multiplicity_eq_zero.mpr hnot, Nat.cast_zero, neg_zero, WithZero.exp_zero]

end GaloisForLFunctions.ArithmeticCastelnuovoSeveri
