import GaloisForLFunctions.RHTower.Deninger.DeningerBigWittFrobeniusRingEndomorphism
import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.Zeta.PolynomialCountEulerFactors

/-!
# Polynomial-count Euler factors in the big Witt ring

Evaluation at a Teichmüller representative realizes all extension counts as ghost
coordinates. Substitution into power series recovers the normalized local factor.
-/

namespace GaloisForLFunctions.ArithmeticCastelnuovoSeveri
open _root_.RHTower PowerSeries
noncomputable section
variable {A B : Type*} [CommRing A] [CommRing B]

/-- Evaluation of the count polynomial at the Teichmüller representative
takes disjoint union to Witt addition and products to Witt multiplication. -/
def countWittHom (q : A) : Polynomial ℤ →+* DeningerBigWittRing A :=
  Polynomial.eval₂RingHom (Int.castRingHom _) (deningerBigWittRingTeichmuller q)

theorem countWitt_ghost (P : Polynomial ℤ) (q : A) (k : ℕ+) :
    deningerBigWittGhostComponent k.val k.property (countWittHom q P) =
      P.eval₂ (Int.castRingHom A) (q^k.val) := by
  change _ (P.eval₂ (Int.castRingHom _) _) = _
  rw [Polynomial.ringHom_eval₂_intCastRingHom,deningerBigWittGhostComponent_teichmuller]

/-- Naturality in the coefficient ring includes reductions in positive characteristic. -/
theorem countWitt_natural (f : A →+* B) (P : Polynomial ℤ) (q : A) :
    deningerBigWittRingMap f (countWittHom q P) = countWittHom (f q) P := by
  change _ (P.eval₂ (Int.castRingHom _) _) = _
  rw [Polynomial.ringHom_eval₂_intCastRingHom,deningerBigWittRingMap_teichmuller]
  rfl

/-- Frobenius on a counting polynomial is field-size squaring, even over
rings where ghost components fail to distinguish Witt vectors. -/
theorem countWitt_frobenius (P : Polynomial ℤ) (q : A) :
    deningerBigWittFrobeniusTwoRingHom (countWittHom q P) = countWittHom (q^2) P := by
  change _ (P.eval₂ (Int.castRingHom _) _) = _
  rw [Polynomial.ringHom_eval₂_intCastRingHom,deningerBigWittFrobeniusTwoRingHom_teichmuller]
  rfl

/-- The Teichmüller representative of every integer at least two satisfies no
nonzero integral polynomial in the integral big-Witt ring. -/
theorem countWitt_injective_integer (q : ℕ) : Function.Injective (countWittHom ((q:ℤ)+2)) := by
  let b : ℤ := (q:ℤ)+2
  intro P Q h
  apply Polynomial.eq_of_infinite_eval_eq
  have hb : 1 < b := by dsimp [b]; omega
  have hi : Function.Injective fun n : ℕ => b^(n+1) :=
    (pow_right_strictMono₀ hb).injective.comp Nat.succ_injective
  apply (Set.infinite_range_of_injective hi).mono
  rintro _ ⟨n,rfl⟩
  let k : ℕ+ := ⟨n+1,Nat.succ_pos _⟩
  have he := congrArg (deningerBigWittGhostComponent k.val k.property (A := ℤ)) h
  rw [countWitt_ghost P b k,countWitt_ghost Q b k] at he
  simpa [Polynomial.eval,Int.castRingHom,k,b] using he

/-- The local zeta factor is the literal big-Witt series of the additive
negative of the Tate class, accounting for the negative logarithmic
derivative convention of the integral big-Witt ring. -/
theorem polynomialCountZeta_eq_wittSeries (P : Polynomial ℤ) (q : ℂ) :
    polynomialCountZeta P q = deningerBigWittSeries (Additive.toMul (-(countWittHom q P)).additiveVal) := by
  let w := -(countWittHom q P)
  let u := Additive.toMul w.additiveVal
  have he : deningerBigWittGhostSeries u = -polynomialCountSeries P q := by
    ext k
    by_cases hk : k = 0
    · subst k
      simp [deningerBigWittGhostSeries,polynomialCountSeries]
    · let j : ℕ+ := ⟨k,Nat.pos_of_ne_zero hk⟩
      have hh := map_neg (deningerBigWittGhostComponent k j.property) (countWittHom q P)
      change PowerSeries.coeff k (deningerBigWittGhostSeries u) = _ at hh
      rw [countWitt_ghost P q j] at hh
      simpa only [map_neg,polynomialCountSeries,coeff_mk,if_neg hk] using hh
  symm
  apply (polynomialCountZeta_eq_iff _ _ _).mpr
  refine ⟨deningerBigWittSeries_constantCoeff _,?_⟩
  have h := deningerBigWittLogGhost_mul_self (deningerBigWittSeries u) (deningerBigWittSeries_constantCoeff u)
  change deningerBigWittGhostSeries u * deningerBigWittSeries u = _ at h
  rw [he,neg_mul,neg_inj] at h
  exact h.symm.trans (mul_comm _ _)

/-- In the integral Witt subring generated by the field size, labelled
coordinate arrangements agree exactly upon agreement of the full dimension profile. -/
theorem countWittArrangement_eq_iff {ι κ : Type*} [Fintype ι] [Fintype κ]
    (q : ℕ) (K : Finset (Finset ι)) (L : Finset (Finset κ)) :
    countWittHom ((q:ℤ)+2) (ArithmeticHarmonicAnalysis.Codes.arrangementPolynomial K) =
      countWittHom ((q:ℤ)+2) (ArithmeticHarmonicAnalysis.Codes.arrangementPolynomial L) ↔
      ∀ d, (K.filter fun s : Finset ι => Fintype.card ι-s.card=d).card =
        (L.filter fun s : Finset κ => Fintype.card κ-s.card=d).card :=
  (countWitt_injective_integer q).eq_iff.trans
    (ArithmeticHarmonicAnalysis.Codes.arrangementPolynomial_eq_iff K L)
/-- Multiplication of the count polynomial by a Tate monomial rescales the
actual local power series, in all degrees at once. -/
theorem polynomialCountZeta_shift (P : Polynomial ℤ) (q : ℂ) (r : ℕ) :
    polynomialCountZeta (Polynomial.X^r * P) q = rescale (q^r) (polynomialCountZeta P q) := by
  let Z := polynomialCountZeta P q
  have hG : polynomialCountSeries (Polynomial.X^r*P) q = rescale (q^r) (polynomialCountSeries P q) := by
    ext n
    by_cases hn : n=0
    · simp [hn,polynomialCountSeries,coeff_rescale]
    · simp only [polynomialCountSeries,coeff_mk,if_neg hn,coeff_rescale,Polynomial.eval₂_mul,
        Polynomial.eval₂_pow,Polynomial.eval₂_X,← pow_mul,Nat.mul_comm n r]
  symm
  apply (polynomialCountZeta_eq_iff _ _ _).mpr
  constructor
  · rw [← coeff_zero_eq_constantCoeff,coeff_rescale,pow_zero,one_mul,coeff_zero_eq_constantCoeff,
      polynomialCountZeta_constant]
  · rw [hG]
    have hh := congrArg (rescale (q^r)) (polynomialCountZeta_hasGhost P q)
    unfold HasGhost at hh ⊢
    rw [map_mul,map_mul,rescale_X] at hh
    rw [deningerPowerSeriesDerivative_rescale]
    exact (by ac_rfl : X*(C (q^r)*rescale (q^r) (derivative ℂ Z)) =
      (C (q^r)*X)*rescale (q^r) (derivative ℂ Z)).trans hh

end
end GaloisForLFunctions.ArithmeticCastelnuovoSeveri
