import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.TheHodgeDefectCountsTheRightZeros
import GaloisForLFunctions.RHTower.EvenSectorFullPositivity
import GaloisForLFunctions.RHTower.GelfondSchneider
import GaloisForLFunctions.HTGeometry.EntireNonzeroPathConnected
import GaloisForLFunctions.SquareRootThreshold.GroundEnergyAbscissaAndLagGridAttainmentBridge
import Mathlib.Topology.Instances.AddCircle.DenseSubgroup

/-!
# The Hodge defect is cyclic: one Hecke orbit sees every zero right of the line

Weil's proof never uses all of `C × C`. It works on the span of the Frobenius graphs
`Γ_k = (F^k × 1)_* Δ`, the orbit of one cycle (the diagonal) under Frobenius, and there the
Castelnuovo–Severi defect already counts every eigenvalue off the circle (`pontryagin_law_curve`).
This file proves the same for the scaling surface of `ℤ`: the whole Hodge defect lives on the
Hecke orbit of a single cycle.

The Hecke correspondences act on tests by translation `T_v g = g(· − v)` (`translate`); on the
zero side `T_v` multiplies the coordinate at `τ` by `e^{(τ − ½)v}` (`zeroCoord_translate`). A test
is **spectrally generic** for a configuration if its transform vanishes at no zero
(`SpectrallyGeneric`); a modulated bump is generic for every configuration
(`exists_spectrallyGeneric`), because the zeros of its transform are countable.

* **Cyclic density** (`orthogonal_translates`). For a generic test `g` and a set `D` of shifts dense
  in `[0, ∞)`, only `0` is orthogonal in `ℓ²(Z)` to the coordinates of the translates `T_d g`,
  `d ∈ D`. A vector orthogonal to all of them gives an absolutely convergent exponential sum
  `Σ_τ q_τ e^{(τ̄ − ½)v}` vanishing on `D`, hence on `[0, ∞)` by continuity, hence `q = 0`
  (`eq_zero_of_tsum_exp_eq_zero`).
* **Cyclic Pontryagin law** (`cyclic_pontryagin_law`). For a tempered configuration and a generic
  test, the Weil form has `n` negative squares on the translates of `g` by some finite set of
  shifts in `D` iff there are at least `n` zeros right of the line. The Gram matrix of translates is
  the kernel `W(T_s g, T_t g)`, a function of `s − t` alone; congruence by a rectangular matrix
  never raises an inertia index (`hermNegIndex_mul_mul_conjTranspose_le`), so negative squares
  found in the span of the translates are negative squares of their Gram matrix.
* **Two Hecke orbits of `ζ`** (`zeta_cyclic_hodgeDefect_iff`,
  `riemannHypothesis_iff_ratHecke_negIndex_eq_zero`, `riemannHypothesis_iff_twoPrime_negIndex_eq_zero`).
  For `ζ` the translates by `log r`, `r ∈ ℚ_{>0}` (the rational Hecke orbit), and already by
  `k log p + l log q` for two distinct primes (`log q / log p` is irrational, so the group is dense),
  carry the full Hodge defect. RH holds iff the Weil Gram matrices of these translates of one
  generic test are all positive semidefinite.

So the λ-ring structure constrains the defect beyond the signature law: its negative squares are
generated by the Hecke orbit of any single generic cycle, as over `𝔽_q` they are generated by the
Frobenius orbit of the diagonal. A rank-two Hecke orbit suffices; a single prime tower is the
period quotient of the curve case, where distinct zeros may share one eigenvalue `p^{ρ − ½}`.
-/

open Complex Matrix Finset
open scoped ComplexConjugate lp
open Zeta23 GaloisForLFunctions.HTGeometry
open GaloisForLFunctions.SquareRootThreshold (TemperedConfig temperedConfig_zetaZeroConfig
  carrier_countable)

noncomputable section

namespace GaloisForLFunctions.ArithmeticCastelnuovoSeveri

/-! ### Congruence by rectangular matrices -/

/-- **Congruence by a rectangular matrix does not raise the positive index**: a positive-definite
subspace of `C H Cᴴ` is carried injectively by `Cᴴ` onto a positive-definite subspace of `H`. -/
theorem hermPosIndex_mul_mul_conjTranspose_le {κ ι : Type*} [Fintype κ] [Fintype ι]
    (C : Matrix κ ι ℂ) (H : Matrix ι ι ℂ) : hermPosIndex (C * H * Cᴴ) ≤ hermPosIndex H := by
  obtain ⟨W, hrank, hW⟩ := exists_isPosDefOn_finrank_eq_posIndex (C * H * Cᴴ)
  have hq : ∀ x, hermQuad (C * H * Cᴴ) x = hermQuad H (Cᴴ *ᵥ x) := fun x => by
    simp only [hermQuad]
    congr 1
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec,
      Matrix.star_mulVec, Matrix.conjTranspose_conjTranspose]
  set L := Cᴴ.mulVecLin
  have hker : LinearMap.ker (L.domRestrict W) = ⊥ := by
    rw [LinearMap.ker_eq_bot']
    intro x hx
    by_contra hx0
    have h1 := hW x x.2 (fun h => hx0 (Subtype.ext h))
    have h2 : Cᴴ *ᵥ (x : κ → ℂ) = 0 := hx
    rw [hq, h2] at h1
    simp [hermQuad] at h1
  have hrange := LinearMap.finrank_range_of_inj (LinearMap.ker_eq_bot.mp hker)
  rw [LinearMap.range_domRestrict] at hrange
  have hpos : IsPosDefOn H (W.map L) := by
    rintro y ⟨x, hx, rfl⟩ hy0
    have hx0 : x ≠ 0 := fun h => hy0 (by simp [h])
    have := hW x hx hx0
    rwa [hq] at this
  calc hermPosIndex (C * H * Cᴴ) = Module.finrank ℂ W := hrank.symm
    _ = Module.finrank ℂ (W.map L) := hrange.symm
    _ ≤ hermPosIndex H := finrank_le_posIndex hpos

/-- Congruence by a rectangular matrix does not raise the negative index. -/
theorem hermNegIndex_mul_mul_conjTranspose_le {κ ι : Type*} [Fintype κ] [Fintype ι]
    (C : Matrix κ ι ℂ) (H : Matrix ι ι ℂ) : hermNegIndex (C * H * Cᴴ) ≤ hermNegIndex H := by
  unfold hermNegIndex
  rw [show -(C * H * Cᴴ) = C * (-H) * Cᴴ by rw [Matrix.mul_neg, Matrix.neg_mul]]
  exact hermPosIndex_mul_mul_conjTranspose_le C (-H)

/-! ### Hecke translates -/

/-- The Hecke translate `T_v g = g(· − v)`: the scaling flow acting on a test. -/
def translate (v : ℝ) (g : ℝ → ℂ) : ℝ → ℂ := fun u => g (u - v)

theorem translate_contDiff {g : ℝ → ℂ} (hg : ContDiff ℝ 2 g) (v : ℝ) :
    ContDiff ℝ 2 (translate v g) :=
  hg.comp (contDiff_id.sub contDiff_const)

theorem translate_hasCompactSupport {g : ℝ → ℂ} (hgc : HasCompactSupport g) (v : ℝ) :
    HasCompactSupport (translate v g) :=
  hgc.comp_homeomorph (Homeomorph.subRight v)

/-- **Translation multiplies the transform by a phase**: `h_{T_v g}(z) = e^{izv} h_g(z)`. -/
theorem paperFT_translate (v : ℝ) (g : ℝ → ℂ) (z : ℂ) :
    paperFT (translate v g) z = cexp (I * z * v) * paperFT g z := by
  set G : ℝ → ℂ := fun w => g w * cexp (I * z * w) * cexp (I * z * v)
  have h1 : (fun u => translate v g u * cexp (I * z * u)) = fun u => G (u - v) := by
    funext u
    simp only [translate, G]
    conv_rhs => rw [mul_assoc, ← Complex.exp_add]
    congr 2
    push_cast; ring
  rw [paperFT, h1, MeasureTheory.integral_sub_right_eq_self, paperFT]
  simp only [G]
  rw [MeasureTheory.integral_mul_const, mul_comm]

/-- On the zero side `T_v` multiplies the coordinate at `τ` by `e^{(τ − ½)v}`. -/
theorem zeroCoord_translate (Z : ZeroConfig) (v : ℝ) (g : ℝ → ℂ) (τ : Z.carrier) :
    zeroCoord Z (translate v g) τ = cexp (I * gammaOf τ * v) * zeroCoord Z g τ := by
  simp only [zeroCoord, paperFT_translate]
  ring

/-- The translate `T_v g` as an element of the test space. -/
def translateTest {g : ℝ → ℂ} (hg : ContDiff ℝ 2 g) (hgc : HasCompactSupport g) (v : ℝ) :
    testSpace :=
  ⟨translate v g, translate_contDiff hg v, translate_hasCompactSupport hgc v⟩

/-! ### Spectrally generic tests -/

/-- A test is **spectrally generic** for `Z` if its transform vanishes at no point of `Z`. -/
def SpectrallyGeneric (Z : ZeroConfig) (g : ℝ → ℂ) : Prop :=
  ∀ τ ∈ Z.carrier, paperFT g (gammaOf τ) ≠ 0

theorem zeroCoord_ne_zero {Z : ZeroConfig} {g : ℝ → ℂ} (hgen : SpectrallyGeneric Z g)
    (τ : Z.carrier) : zeroCoord Z g τ ≠ 0 := by
  have hm : (0 : ℝ) < Z.mult τ := by exact_mod_cast Z.one_le_mult _ τ.2
  exact mul_ne_zero (Complex.ofReal_ne_zero.mpr (Real.sqrt_pos.mpr hm).ne') (hgen τ τ.2)

/-- **Generic tests exist.** A short bump modulated by a suitable frequency `s` has transform
nonvanishing at every point of `Z`: the frequencies killing it at some zero form a countable set. -/
theorem exists_spectrallyGeneric (Z : ZeroConfig) :
    ∃ g : ℝ → ℂ, ContDiff ℝ 2 g ∧ HasCompactSupport g ∧ SpectrallyGeneric Z g := by
  set φ := bumpTest (1 / 2) (by norm_num) 0
  have hφd : Differentiable ℂ (paperFT φ) :=
    RHTower.EvenSector.differentiable_paperFT_of_compact (bumpTest_contDiff _ 0).continuous
      (bumpTest_hasCompactSupport _ 0)
  have hφ0 : paperFT φ 0 ≠ 0 := paperFT_bumpTest_zero_ne_zero _ (by norm_num)
  have hcount := countable_zeros_of_entire_nonzero hφd hφ0
  set B : Set ℝ := ⋃ τ ∈ Z.carrier, (fun s : ℝ => gammaOf τ + s) ⁻¹' {t | paperFT φ t = 0}
  have hB : B.Countable := (carrier_countable Z).biUnion fun τ _ =>
    hcount.preimage fun a b h => by simpa using h
  obtain ⟨s, hs⟩ : ∃ s, s ∉ B := by
    by_contra h
    push Not at h
    exact Cardinal.not_countable_real (hB.mono fun s _ => h s)
  refine ⟨probe s 0, probe_contDiff s 0, probe_hasCompactSupport s 0, fun τ hτ h0 => hs ?_⟩
  rw [paperFT_probe, Complex.ofReal_zero, mul_zero, Complex.exp_zero, one_mul] at h0
  exact Set.mem_biUnion hτ h0

/-! ### Cyclic density -/

/-- Shift sets dense in `[0, ∞)`. -/
def DenseShifts (D : Set ℝ) : Prop := ∀ v : ℝ, 0 ≤ v → ∀ ε : ℝ, 0 < ε → ∃ d ∈ D, |d - v| < ε

/-- **Cyclic density.** For a spectrally generic test and shifts dense in `[0, ∞)`, only `0` is
orthogonal to the zero-side coordinates of all translates. -/
theorem eq_zero_of_orthogonal_translates (Z : ZeroConfig) (hZ : TemperedConfig Z) {g : ℝ → ℂ}
    (hg : ContDiff ℝ 2 g) (hgc : HasCompactSupport g) (hgen : SpectrallyGeneric Z g)
    {D : Set ℝ} (hD : DenseShifts D) (a : ℓ²(Z.carrier, ℂ))
    (ha : ∀ d ∈ D, ∑' τ, conj (zeroCoord Z (translate d g) τ) * a τ = 0) : a = 0 := by
  set q : Z.carrier → ℂ := fun τ => conj (zeroCoord Z g τ) * a τ with hq
  have hqs : Summable fun τ => ‖q τ‖ := by
    have h1 := (memℓp_zeroCoord Z hZ hg hgc).summable
      (by norm_num : (0 : ℝ) < (2 : ENNReal).toReal)
    have h2 := (lp.memℓp a).summable (by norm_num : (0 : ℝ) < (2 : ENNReal).toReal)
    simp only [ENNReal.toReal_ofNat, Real.rpow_two] at h1 h2
    refine Summable.of_nonneg_of_le (fun τ => norm_nonneg _) (fun τ => ?_) ((h1.add h2).div_const 2)
    simp only [hq, norm_mul, Complex.norm_conj]
    nlinarith [sq_nonneg (‖zeroCoord Z g τ‖ - ‖a τ‖)]
  -- the exponential sum `F(v) = Σ_τ q_τ e^{(τ̄ − ½)v}`
  set F : ℝ → ℂ := fun v => ∑' τ, q τ * cexp ((conj (τ : ℂ) - 1 / 2) * v) with hF
  have hterm : ∀ (v : ℝ) (τ : Z.carrier), conj (zeroCoord Z (translate v g) τ) * a τ =
      q τ * cexp ((conj (τ : ℂ) - 1 / 2) * v) := fun v τ => by
    have h := conj_I_mul_gammaOf_add (τ : ℂ) 0 v
    simp only [Complex.ofReal_zero, add_zero, mul_zero, zero_mul, neg_zero] at h
    rw [zeroCoord_translate, map_mul, ← Complex.exp_conj, h]
    simp only [hq]
    ring
  have hFD : ∀ d ∈ D, F d = 0 := fun d hd => by
    simp only [hF, ← hterm]
    exact ha d hd
  -- `F` is continuous: the series converges locally uniformly
  have hFc : Continuous F := by
    refine continuous_iff_continuousAt.mpr fun v₀ => ?_
    have hon : ContinuousOn F (Set.Icc (v₀ - 1) (v₀ + 1)) := by
      refine continuousOn_tsum (u := fun τ => ‖q τ‖ * Real.exp (|v₀| + 1)) (fun τ => ?_)
        (hqs.mul_right _) (fun τ v hv => ?_)
      · exact (continuous_const.mul (Complex.continuous_exp.comp
          (continuous_const.mul Complex.continuous_ofReal))).continuousOn
      · rw [norm_mul, Complex.norm_exp]
        refine mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr ?_) (norm_nonneg _)
        have hre : ((conj (τ : ℂ) - 1 / 2) * (v : ℂ)).re = ((τ : ℂ).re - 1 / 2) * v := by
          simp [Complex.mul_re]
        rw [hre]
        have hstrip := Z.strip _ τ.2
        have hx : |(τ : ℂ).re - 1 / 2| ≤ 1 := by rw [abs_le]; constructor <;> linarith
        have hv' : |v| ≤ |v₀| + 1 := by
          rw [abs_le]; constructor <;> linarith [hv.1, hv.2, le_abs_self v₀, neg_abs_le v₀]
        calc ((τ : ℂ).re - 1 / 2) * v ≤ |((τ : ℂ).re - 1 / 2) * v| := le_abs_self _
          _ = |(τ : ℂ).re - 1 / 2| * |v| := abs_mul _ _
          _ ≤ 1 * (|v₀| + 1) := mul_le_mul hx hv' (abs_nonneg _) zero_le_one
          _ = |v₀| + 1 := one_mul _
    exact hon.continuousAt (Icc_mem_nhds (by linarith) (by linarith))
  -- `F` vanishes on `[0, ∞)`
  have hF0 : ∀ v : ℝ, 0 ≤ v → F v = 0 := by
    intro v hv
    by_contra hne
    have hpos : 0 < ‖F v‖ := norm_pos_iff.mpr hne
    obtain ⟨δ, hδ, hδF⟩ := Metric.continuous_iff.mp hFc v (‖F v‖) hpos
    obtain ⟨d, hdD, hdv⟩ := hD v hv δ hδ
    have h := hδF d (by rwa [Real.dist_eq])
    rw [hFD d hdD, dist_eq_norm, zero_sub, norm_neg] at h
    exact lt_irrefl _ h
  ext τ
  rw [lp.coeFn_zero, Pi.zero_apply]
  have h := eq_zero_of_tsum_exp_eq_zero Z hqs hF0 τ
  simp only [hq] at h
  exact (mul_eq_zero.mp h).resolve_left ((map_ne_zero _).mpr (zeroCoord_ne_zero hgen τ))

/-- The zero-side coordinates of the translate `T_v g`. -/
def heckeVec (Z : ZeroConfig) (hZ : TemperedConfig Z) {g : ℝ → ℂ} (hg : ContDiff ℝ 2 g)
    (hgc : HasCompactSupport g) (v : ℝ) : ℓ²(Z.carrier, ℂ) :=
  zeroMap Z hZ (translateTest hg hgc v)

/-- **Every vector of `ℓ²(Z)` is approximated by a finite combination of translates** of a generic
test by shifts in `D`. -/
theorem exists_translates_near (Z : ZeroConfig) (hZ : TemperedConfig Z) {g : ℝ → ℂ}
    (hg : ContDiff ℝ 2 g) (hgc : HasCompactSupport g) (hgen : SpectrallyGeneric Z g)
    {D : Set ℝ} (hD : DenseShifts D) (x : ℓ²(Z.carrier, ℂ)) {ε : ℝ} (hε : 0 < ε) :
    ∃ l : ℝ →₀ ℂ, (↑l.support ⊆ D) ∧
      ‖(∑ s ∈ l.support, l s • heckeVec Z hZ hg hgc s) - x‖ < ε := by
  set K := Submodule.span ℂ (heckeVec Z hZ hg hgc '' D)
  have hK : Kᗮ = ⊥ := by
    rw [Submodule.eq_bot_iff]
    intro a ha
    refine eq_zero_of_orthogonal_translates Z hZ hg hgc hgen hD a fun d hd => ?_
    have h := (Submodule.mem_orthogonal _ a).mp ha (heckeVec Z hZ hg hgc d)
      (Submodule.subset_span ⟨d, hd, rfl⟩)
    rw [lp.inner_eq_tsum] at h
    simpa only [RCLike.inner_apply', heckeVec, zeroMap_apply, translateTest] using h
  have hx : x ∈ K.topologicalClosure := by
    rw [(Submodule.topologicalClosure_eq_top_iff (K := K)).mpr hK]
    trivial
  rw [← SetLike.mem_coe, Submodule.topologicalClosure_coe, Metric.mem_closure_iff] at hx
  obtain ⟨y, hyK, hy⟩ := hx ε hε
  obtain ⟨l, hlD, rfl⟩ := (Finsupp.mem_span_image_iff_linearCombination ℂ).mp hyK
  refine ⟨l, hlD, ?_⟩
  rw [dist_comm, dist_eq_norm, Finsupp.linearCombination_apply, Finsupp.sum] at hy
  exact hy

/-! ### Gram matrices of combinations -/

/-- The reflection of zero-side coordinates as a linear map. -/
def reflectLin (Z : ZeroConfig) : ℓ²(Z.carrier, ℂ) →ₗ[ℂ] ℓ²(Z.carrier, ℂ) where
  toFun := reflectVec Z
  map_add' := reflectVec_add Z
  map_smul' c x := by
    ext τ
    simp [reflectVec_apply]

/-- **Gram matrices of combinations.** If `f_k = Σ_i C_{ki} t_i`, the Weil Gram matrix of `f` is
`C G Cᴴ` with `G` the Gram matrix of `t`. -/
theorem zeroGram_comb (Z : ZeroConfig) (hZ : TemperedConfig Z) {κ ι : Type*} [Fintype κ]
    [Fintype ι] (t : ι → testSpace) (C : Matrix κ ι ℂ) :
    zeroGram Z (fun k => ((∑ i, C k i • t i : testSpace) : ℝ → ℂ)) =
      C * zeroGram Z (fun i => (t i : ℝ → ℂ)) * Cᴴ := by
  obtain ⟨c, rfl⟩ : ∃ c : κ → ι → ℂ, Matrix.of c = C := ⟨C, rfl⟩
  ext k l
  simp only [zeroGram, Matrix.mul_apply, Matrix.conjTranspose_apply, Matrix.of_apply]
  rw [W_eq_inner Z hZ]
  have hR : ∀ x, reflectVec Z x = reflectLin Z x := fun _ => rfl
  simp only [hR, map_sum, map_smul, sum_inner, inner_sum, inner_smul_left, inner_smul_right]
  simp only [← hR, ← W_eq_inner Z hZ, Finset.mul_sum, Finset.sum_mul, RCLike.star_def]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun i _ => ?_
  ring

/-! ### The cyclic Pontryagin law -/

/-- **Attainment on one Hecke orbit.** For finitely many distinct zeros right of the line there is a
finite set `S ⊆ D` of shifts such that the Weil Gram matrix of the translates `T_s g`, `s ∈ S`, has
at least that many negative squares. -/
theorem exists_translates_negIndex_ge (Z : ZeroConfig) (hZ : TemperedConfig Z) {g : ℝ → ℂ}
    (hg : ContDiff ℝ 2 g) (hgc : HasCompactSupport g) (hgen : SpectrallyGeneric Z g)
    {D : Set ℝ} (hD : DenseShifts D) {ι : Type*} [Fintype ι] [DecidableEq ι] (ρ : ι → ℂ)
    (hρ : Function.Injective ρ) (hR : ∀ i, ρ i ∈ rightZeros Z) :
    ∃ S : Finset ℝ, ↑S ⊆ D ∧
      Fintype.card ι ≤ hermNegIndex (zeroGram Z fun s : S => translate s g) := by
  classical
  set r : ι → Z.carrier := fun i => ⟨ρ i, (hR i).1⟩ with hr
  -- the negative vectors `e_ρ − e_{1−ρ̄}` of the Krein form
  set w : ι → ℓ²(Z.carrier, ℂ) := fun i =>
    lp.single 2 (r i) (1 : ℂ) - lp.single 2 (reflectCarrier Z (r i)) 1 with hw
  have hne : ∀ i j, reflectCarrier Z (r j) ≠ r i := fun i j h => by
    have := congrArg (fun t : Z.carrier => (t : ℂ).re) h
    simp only [reflectCarrier, hr, reflect, Complex.sub_re, Complex.one_re, Complex.conj_re] at this
    linarith [(hR i).2, (hR j).2]
  have hrr : ∀ i j, r j = r i ↔ i = j := fun i j =>
    ⟨fun h => (hρ (congrArg Subtype.val h)).symm, fun h => h ▸ rfl⟩
  have hRr : ∀ i j, reflectCarrier Z (r j) = reflectCarrier Z (r i) ↔ i = j := fun i j =>
    ⟨fun h => (hrr i j).mp ((reflectEquiv Z).injective h), fun h => h ▸ rfl⟩
  have hRw : ∀ i j, inner ℂ (reflectVec Z (w j)) (w i) = if i = j then -2 else 0 := by
    intro i j
    simp only [hw, reflectVec_sub, reflectVec_single, reflectCarrier_reflectCarrier, inner_sub_left,
      inner_sub_right, inner_single_single, if_neg (hne i j), if_neg (Ne.symm (hne j i)), hrr,
      hRr]
    split_ifs <;> ring
  have hnw : ∀ i, ‖w i‖ ≤ 2 := fun i => by
    refine (norm_sub_le _ _).trans ?_
    rw [lp.norm_single (by norm_num), lp.norm_single (by norm_num), norm_one]
    norm_num
  -- approximants of the negative vectors by combinations of translates
  set k := Fintype.card ι with hk
  set ε : ℝ := 1 / (5 * ((k : ℝ) + 1)) with hε
  have hε0 : 0 < ε := by positivity
  have hε1 : ε ≤ 1 := by
    rw [hε, div_le_one (by positivity)]
    have : (0 : ℝ) ≤ k := Nat.cast_nonneg _
    linarith
  choose l hlD hl using fun i => exists_translates_near Z hZ hg hgc hgen hD (w i) hε0
  -- the common shift set and the coefficient matrix
  set S : Finset ℝ := Finset.univ.biUnion fun i => (l i).support with hS
  have hSD : ↑S ⊆ D := by
    intro s hs
    obtain ⟨i, -, his⟩ := Finset.mem_biUnion.mp hs
    exact hlD i his
  refine ⟨S, hSD, ?_⟩
  set t : S → testSpace := fun s => translateTest hg hgc s with ht
  set C : Matrix ι S ℂ := fun i s => l i s with hC
  set f : ι → testSpace := fun i => ∑ s, C i s • t s with hf
  -- the combination of row `i` has coordinates `Σ_s l_i(s) X(T_s g)`
  have hfX : ∀ i, zeroMap Z hZ (f i) = ∑ s ∈ (l i).support, l i s • heckeVec Z hZ hg hgc s := by
    intro i
    simp only [hf, map_sum, map_smul, hC, ht]
    rw [Finset.sum_coe_sort S (fun s => l i s • zeroMap Z hZ (translateTest hg hgc s))]
    refine (Finset.sum_subset (fun s hs => Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, hs⟩)
      fun s _ hs => ?_).symm
    rw [Finsupp.notMem_support_iff.mp hs, zero_smul]
  have hentry : ∀ i j, ‖zeroGram Z (fun i => (f i : ℝ → ℂ)) i j - (if i = j then -2 else 0)‖ ≤
      5 * ε := by
    intro i j
    have hGij : zeroGram Z (fun i => (f i : ℝ → ℂ)) i j =
        inner ℂ (reflectVec Z (zeroMap Z hZ (f j))) (zeroMap Z hZ (f i)) := W_eq_inner Z hZ (f i) (f j)
    have hdi : zeroMap Z hZ (f i) = w i + (zeroMap Z hZ (f i) - w i) := by abel
    have hdj : zeroMap Z hZ (f j) = w j + (zeroMap Z hZ (f j) - w j) := by abel
    set ei := zeroMap Z hZ (f i) - w i
    set ej := zeroMap Z hZ (f j) - w j
    have hei : ‖ei‖ < ε := by simp only [ei, hfX]; exact hl i
    have hej : ‖ej‖ < ε := by simp only [ej, hfX]; exact hl j
    rw [hGij, hdi, hdj, reflectVec_add, inner_add_left, inner_add_right, inner_add_right, hRw i j]
    have h1 := (norm_inner_le_norm (𝕜 := ℂ) (reflectVec Z (w j)) ei).trans_eq
      (by rw [norm_reflectVec])
    have h2 := (norm_inner_le_norm (𝕜 := ℂ) (reflectVec Z ej) (w i)).trans_eq
      (by rw [norm_reflectVec])
    have h3 := (norm_inner_le_norm (𝕜 := ℂ) (reflectVec Z ej) ei).trans_eq
      (by rw [norm_reflectVec])
    calc ‖(if i = j then -2 else 0) + inner ℂ (reflectVec Z (w j)) ei +
          (inner ℂ (reflectVec Z ej) (w i) + inner ℂ (reflectVec Z ej) ei) -
            (if i = j then -2 else 0)‖
        = ‖inner ℂ (reflectVec Z (w j)) ei + inner ℂ (reflectVec Z ej) (w i) +
            inner ℂ (reflectVec Z ej) ei‖ := by congr 1; ring
      _ ≤ ‖w j‖ * ‖ei‖ + ‖ej‖ * ‖w i‖ + ‖ej‖ * ‖ei‖ :=
        norm_add₃_le.trans (add_le_add (add_le_add h1 h2) h3)
      _ ≤ 2 * ε + ε * 2 + ε * ε := by
        have := hnw i; have := hnw j
        gcongr
      _ ≤ 5 * ε := by nlinarith
  have hη : 5 * ε * (Fintype.card ι : ℝ) ≤ 1 := by
    rw [← hk, hε]
    have : (0 : ℝ) ≤ k := Nat.cast_nonneg _
    rw [show 5 * (1 / (5 * ((k : ℝ) + 1))) * k = k / (k + 1) by field_simp,
      div_le_one (by positivity)]
    linarith
  have hpd : IsPosDefOn (-(zeroGram Z fun i => (f i : ℝ → ℂ))) ⊤ := fun x _ hx0 => by
    rw [hermQuad_neg]
    obtain ⟨i, hi⟩ := Function.ne_iff.mp hx0
    have hpos : 0 < ∑ i, ‖x i‖ ^ 2 :=
      lt_of_lt_of_le (pow_pos (norm_pos_iff.mpr hi) 2) (Finset.single_le_sum
        (f := fun i => ‖x i‖ ^ 2) (fun i _ => by positivity) (Finset.mem_univ i))
    linarith [hermQuad_le_of_near _ hη hentry x]
  have h1 := finrank_le_posIndex hpd
  rw [finrank_top, Module.finrank_fintype_fun_eq_card] at h1
  have hcomb : zeroGram Z (fun i => (f i : ℝ → ℂ)) =
      C * zeroGram Z (fun s : S => translate s g) * Cᴴ := zeroGram_comb Z hZ t C
  calc Fintype.card ι ≤ hermNegIndex (zeroGram Z fun i => (f i : ℝ → ℂ)) := h1
    _ = hermNegIndex (C * zeroGram Z (fun s : S => translate s g) * Cᴴ) := by rw [hcomb]
    _ ≤ hermNegIndex (zeroGram Z fun s : S => translate s g) :=
      hermNegIndex_mul_mul_conjTranspose_le C _

/-- **The cyclic Pontryagin law.** For a tempered configuration, a spectrally generic test `g` and
shifts `D` dense in `[0, ∞)`, the Weil form has `n` negative squares on the translates of `g` by
some finite set of shifts in `D` iff the configuration has at least `n` zeros right of the line. -/
theorem cyclic_pontryagin_law (Z : ZeroConfig) (hZ : TemperedConfig Z) {g : ℝ → ℂ}
    (hg : ContDiff ℝ 2 g) (hgc : HasCompactSupport g) (hgen : SpectrallyGeneric Z g)
    {D : Set ℝ} (hD : DenseShifts D) (n : ℕ) :
    (∃ S : Finset ℝ, ↑S ⊆ D ∧ n ≤ hermNegIndex (zeroGram Z fun s : S => translate s g)) ↔
      (n : ℕ∞) ≤ (rightZeros Z).encard := by
  classical
  constructor
  · rintro ⟨S, -, hn⟩
    exact (ENat.coe_le_coe.mpr hn).trans (negIndex_zeroGram_le_of_tempered Z hZ _
      (fun s => translate_contDiff hg s) (fun s => translate_hasCompactSupport hgc s))
  · intro hn
    obtain ⟨T, hTs, hTn⟩ := Set.exists_subset_encard_eq hn
    have hTf : T.Finite := Set.finite_of_encard_eq_coe hTn
    have hcard : hTf.toFinset.card = n := by
      have h := hTf.encard_eq_coe_toFinset_card
      rw [hTn] at h
      exact_mod_cast h.symm
    set e := hTf.toFinset.equivFin
    set ρ : Fin n → ℂ := fun i => (e.symm (Fin.cast hcard.symm i) : ℂ) with hρdef
    have hρ : Function.Injective ρ := fun i j h =>
      Fin.cast_injective _ (e.symm.injective (Subtype.ext h))
    have hR : ∀ i, ρ i ∈ rightZeros Z := fun i =>
      hTs ((Set.Finite.mem_toFinset hTf).mp (e.symm (Fin.cast hcard.symm i)).2)
    obtain ⟨S, hSD, hge⟩ := exists_translates_negIndex_ge Z hZ hg hgc hgen hD ρ hρ hR
    exact ⟨S, hSD, by simpa using hge⟩

/-! ### Two Hecke orbits of `ζ` -/

/-- The rational Hecke shifts `log r`, `r ∈ ℚ_{>0}`. -/
def ratHeckeShifts : Set ℝ := {v | ∃ r : ℚ, 0 < r ∧ Real.log r = v}

theorem denseShifts_ratHecke : DenseShifts ratHeckeShifts := by
  intro v _ ε hε
  obtain ⟨r, hr1, hr2⟩ := exists_rat_btwn (Real.exp_lt_exp.mpr (lt_add_of_pos_right v hε))
  have hr0 : (0 : ℝ) < r := (Real.exp_pos v).trans hr1
  refine ⟨Real.log r, ⟨r, by exact_mod_cast hr0, rfl⟩, ?_⟩
  have h1 : v < Real.log r := by rw [Real.lt_log_iff_exp_lt hr0]; exact hr1
  have h2 : Real.log r < v + ε := by rw [Real.log_lt_iff_lt_exp hr0]; exact hr2
  rw [abs_lt]; constructor <;> linarith

/-- The two-prime Hecke shifts `k log p + l log q`, `k, l ∈ ℤ`. -/
def twoPrimeShifts (p q : ℕ) : Set ℝ :=
  (AddSubgroup.closure {Real.log p, Real.log q} : Set ℝ)

/-- **Two primes suffice**: the shifts `k log p + l log q` are dense, since `log q / log p` is
irrational. -/
theorem denseShifts_twoPrime {p q : ℕ} (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q) :
    DenseShifts (twoPrimeShifts p q) := by
  have hdense : Dense (twoPrimeShifts p q) := by
    have h := dense_addSubgroupClosure_pair_iff.mpr (RHTower.irrational_log_ratio hp hq hpq)
    rw [twoPrimeShifts, Set.pair_comm]
    rwa [Set.pair_comm] at h ⊢
  intro v _ ε hε
  obtain ⟨d, hd, hdv⟩ := Metric.dense_iff.mp hdense v ε hε
  exact ⟨d, hdv, by rw [Metric.mem_ball, Real.dist_eq] at hd; exact hd⟩

theorem rightZeros_zeta_eq_empty_iff : rightZeros zetaZeroConfig = ∅ ↔ RiemannHypothesis := by
  rw [GaloisForLFunctions.SquareRootThreshold.riemannHypothesis_iff_zetaZeroConfig_onLine,
    Set.eq_empty_iff_forall_notMem]
  constructor
  · intro h ρ hρ
    have h1 : ¬ 1 / 2 < ρ.re := fun hgt => h ρ ⟨hρ, hgt⟩
    have h2 : ¬ 1 / 2 < (reflect ρ).re := fun hgt => h _ ⟨zetaZeroConfig.reflect_mem ρ hρ, hgt⟩
    simp only [reflect, Complex.sub_re, Complex.one_re, Complex.conj_re, not_lt] at h1 h2
    linarith
  · intro h ρ ⟨hρ, hgt⟩
    linarith [h ρ hρ]

/-- **The Hodge defect of `ζ` lives on one Hecke orbit.** For a spectrally generic test `g` and
shifts dense in `[0, ∞)`, the intersection form of the scaling surface has `1 + n` positive squares
on the pole plane and the translates of `g` by some finite set of shifts in `D` iff `ζ` has at least
`n` zeros right of the line. -/
theorem zeta_cyclic_hodgeDefect_iff {g : ℝ → ℂ} (hg : ContDiff ℝ 2 g) (hgc : HasCompactSupport g)
    (hgen : SpectrallyGeneric zetaZeroConfig g) {D : Set ℝ} (hD : DenseShifts D) (n : ℕ) :
    (∃ S : Finset ℝ, ↑S ⊆ D ∧ 1 + n ≤ hermPosIndex
        (intersectionGram (fun k => (ArithmeticFunction.vonMangoldt k : ℝ))
          fun s : S => translate s g)) ↔
      (n : ℕ∞) ≤ (rightZeros zetaZeroConfig).encard := by
  classical
  rw [← cyclic_pontryagin_law zetaZeroConfig temperedConfig_zetaZeroConfig hg hgc hgen hD n]
  refine exists_congr fun S => and_congr_right fun _ => ?_
  rw [posIndex_intersectionGram, weilGram_eq_zeroGram (fun s : S => translate s g)
    (fun s => translate_contDiff hg s) (fun s => translate_hasCompactSupport hgc s)]
  omega

/-- **RH is Weil positivity on one Hecke orbit.** For a spectrally generic test `g` and shifts dense
in `[0, ∞)`, RH holds iff the Weil Gram matrix of the translates of `g` by every finite set of
shifts in `D` has no negative square. -/
theorem riemannHypothesis_iff_translates_negIndex_eq_zero {g : ℝ → ℂ} (hg : ContDiff ℝ 2 g)
    (hgc : HasCompactSupport g) (hgen : SpectrallyGeneric zetaZeroConfig g) {D : Set ℝ}
    (hD : DenseShifts D) :
    RiemannHypothesis ↔ ∀ S : Finset ℝ, ↑S ⊆ D →
      hermNegIndex (weilGram (fun k => (ArithmeticFunction.vonMangoldt k : ℝ))
        fun s : S => translate s g) = 0 := by
  classical
  have hW : ∀ S : Finset ℝ, weilGram (fun k => (ArithmeticFunction.vonMangoldt k : ℝ))
      (fun s : S => translate s g) = zeroGram zetaZeroConfig fun s : S => translate s g :=
    fun S => weilGram_eq_zeroGram _ (fun s => translate_contDiff hg s)
      (fun s => translate_hasCompactSupport hgc s)
  rw [← rightZeros_zeta_eq_empty_iff]
  constructor
  · intro hE S _
    rw [hW]
    have h := negIndex_zeroGram_le_of_tempered zetaZeroConfig temperedConfig_zetaZeroConfig
      (fun s : S => translate s g) (fun s => translate_contDiff hg s)
      (fun s => translate_hasCompactSupport hgc s)
    rw [hE, Set.encard_empty] at h
    exact_mod_cast nonpos_iff_eq_zero.mp h
  · intro h
    by_contra hne
    obtain ⟨ρ, hρ⟩ := Set.nonempty_iff_ne_empty.mpr hne
    have h1 : ((1 : ℕ) : ℕ∞) ≤ (rightZeros zetaZeroConfig).encard := by
      simpa using Set.one_le_encard_iff_nonempty.mpr ⟨ρ, hρ⟩
    obtain ⟨S, hSD, hge⟩ := (cyclic_pontryagin_law zetaZeroConfig temperedConfig_zetaZeroConfig
      hg hgc hgen hD 1).mpr h1
    rw [← hW, h S hSD] at hge
    omega

/-- **RH on the rational Hecke orbit**: translates by `log r`, `r ∈ ℚ_{>0}`. -/
theorem riemannHypothesis_iff_ratHecke_negIndex_eq_zero {g : ℝ → ℂ} (hg : ContDiff ℝ 2 g)
    (hgc : HasCompactSupport g) (hgen : SpectrallyGeneric zetaZeroConfig g) :
    RiemannHypothesis ↔ ∀ S : Finset ℝ, ↑S ⊆ ratHeckeShifts →
      hermNegIndex (weilGram (fun k => (ArithmeticFunction.vonMangoldt k : ℝ))
        fun s : S => translate s g) = 0 :=
  riemannHypothesis_iff_translates_negIndex_eq_zero hg hgc hgen denseShifts_ratHecke

/-- **RH on a rank-two Hecke orbit**: translates by `k log p + l log q` for two distinct primes. -/
theorem riemannHypothesis_iff_twoPrime_negIndex_eq_zero {p q : ℕ} (hp : p.Prime) (hq : q.Prime)
    (hpq : p ≠ q) {g : ℝ → ℂ} (hg : ContDiff ℝ 2 g) (hgc : HasCompactSupport g)
    (hgen : SpectrallyGeneric zetaZeroConfig g) :
    RiemannHypothesis ↔ ∀ S : Finset ℝ, ↑S ⊆ twoPrimeShifts p q →
      hermNegIndex (weilGram (fun k => (ArithmeticFunction.vonMangoldt k : ℝ))
        fun s : S => translate s g) = 0 :=
  riemannHypothesis_iff_translates_negIndex_eq_zero hg hgc hgen (denseShifts_twoPrime hp hq hpq)

