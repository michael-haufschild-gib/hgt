import GaloisForLFunctions.CollectiveDiophantineGeometry.AllDeterminantsOfACongruenceLattice

/-!
# Vertical frequencies of a two-row integer lattice

The second coordinate of an integral combination whose first coordinate
vanishes forms a subgroup of the integers. Its step is determined by
the two-by-two minors divided by the content of the first row. Pairwise
balanced combinations generate the exact subgroup, even when no pair
of first-row entries is coprime.
-/

noncomputable section
open Matrix Finset
namespace GaloisForLFunctions.CollectiveDiophantineGeometry.Simplex

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Determinant of the two columns indexed by i,j. -/
def minorColumn (q b : ι → ℤ) (e : ι × ι) := q e.1*b e.2-q e.2*b e.1

/-- Frequencies attainable under the integer constraint c·q=0. -/
def vertical (q b : ι → ℤ) : AddSubgroup ℤ where
  carrier := {d | ∃ c : ι → ℤ, c ⬝ᵥ q=0 ∧ c ⬝ᵥ b=d}
  zero_mem' := ⟨0,by simp,by simp⟩
  add_mem' := by
    rintro d d' ⟨u,hu,rfl⟩ ⟨v,hv,rfl⟩
    exact ⟨u+v,by rw [add_dotProduct,hu,hv,add_zero],add_dotProduct ..⟩
  neg_mem' := by
    rintro d ⟨u,hu,rfl⟩
    exact ⟨-u,by rw [neg_dotProduct,hu,neg_zero],neg_dotProduct ..⟩

omit [DecidableEq ι] in
private theorem polarization (q b u c : ι → ℤ) :
    (u ⬝ᵥ q)*(c ⬝ᵥ b)-(c ⬝ᵥ q)*(u ⬝ᵥ b) =
      ∑ i, ∑ j, (u i*c j)*minorColumn q b (i,j) := by
  rw [mul_comm (c ⬝ᵥ q) (u ⬝ᵥ b)]
  simp only [dotProduct,sum_mul_sum,← sum_sub_distrib]
  apply sum_congr rfl
  intro i _
  apply sum_congr rfl
  intro j _
  unfold minorColumn
  ring

omit [DecidableEq ι] in
theorem minors_divide_vertical (q b : ι → ℤ) {d : ℤ} (hd : d∈vertical q b) :
    content (minorColumn q b) ∣ content q*d := by
  obtain ⟨c,hc,rfl⟩ := hd
  obtain ⟨u,hu⟩ := (dot_range q (content q)).2 dvd_rfl
  have he := polarization q b u c
  rw [hc,zero_mul,sub_zero,hu] at he
  rw [he]
  exact dvd_sum fun i _ => dvd_sum fun j _ =>
    dvd_mul_of_dvd_right (gcd_dvd (mem_univ (i,j))) _

/-- Any two columns give a balanced combination after dividing their
first row by its common content. -/
theorem normalized_minor_mem {q w : ι → ℤ} (b : ι → ℤ) (g : ℤ) (hq : q=g • w)
    (i j : ι) : minorColumn w b (i,j) ∈ vertical q b := by
  refine ⟨Pi.single j (w i) - Pi.single i (w j),?_,?_⟩
  · rw [sub_dotProduct,single_dotProduct,single_dotProduct,hq]
    change w i*(g*w j)-w j*(g*w i)=0
    ring
  · simp only [sub_dotProduct,single_dotProduct,minorColumn]

omit [DecidableEq ι] in
private theorem normalized_coordinates {q w : ι → ℤ} (b : ι → ℤ) (g : ℤ)
    (hg : g≠0) (hq : q=g • w) (f : ι × ι → ℤ) {d : ℤ} (hf : f ⬝ᵥ minorColumn q b=g*d) :
    (∑ i, f i*minorColumn w b i)=d := by
  apply mul_left_cancel₀ hg
  rw [← hf,mul_sum]
  apply sum_congr rfl
  rintro ⟨i,j⟩ _
  rw [hq]
  change g*(f (i,j)*(w i*b j-w j*b i))=f (i,j)*((g*w i)*b j-(g*w j)*b i)
  ring

/-- The two-by-two determinantal divisor tests exactly which frequencies
occur. The zero first row leaves one ordinary content condition. -/
theorem vertical_iff (q b : ι → ℤ) (d : ℤ) :
    d∈vertical q b ↔ if q=0 then content b ∣ d else content (minorColumn q b)∣content q*d := by
  classical
  by_cases hz : q=0
  · subst q
    simp only [ite_true]
    change (∃ c : ι → ℤ, c ⬝ᵥ 0=0 ∧ c ⬝ᵥ b=d) ↔ _
    simpa only [dotProduct_zero,true_and] using dot_range b d
  rw [if_neg hz]
  refine ⟨minors_divide_vertical q b,fun hd => ?_⟩
  obtain ⟨w,u,hq,_⟩ := primitive_direction q hz
  have hg : content q ≠ 0 := fun he => hz (by simpa only [he,zero_smul] using hq)
  obtain ⟨f,hf⟩ := (dot_range (minorColumn q b) (content q*d)).2 hd
  rw [← normalized_coordinates b (content q) hg hq f hf]
  refine (vertical q b).sum_mem fun i _ => ?_
  exact (vertical q b).zsmul_mem (normalized_minor_mem b _ hq i.1 i.2) (f i)

/-- A nonzero first row leaves precisely the subgroup generated by its
normalized pairwise minors, without a choice of Bézout coefficients. -/
theorem normalized_minors_generate (q b : ι → ℤ) (hq₀ : q≠0) (w : ι → ℤ)
    (hw : q=content q • w) (d : ℤ) :
    d∈vertical q b ↔ ∃ c : ι × ι → ℤ, c ⬝ᵥ minorColumn w b=d := by
  constructor
  · intro hd
    have hg : content q ≠ 0 := fun he => hq₀ (by simpa only [he,zero_smul] using hw)
    obtain ⟨c,hc⟩ := (dot_range (minorColumn q b) _).2 (minors_divide_vertical q b hd)
    exact ⟨c,normalized_coordinates b _ hg hw c hc⟩
  · rintro ⟨c,rfl⟩
    exact (vertical q b).sum_mem fun i _ =>
      (vertical q b).zsmul_mem (normalized_minor_mem b _ hw i.1 i.2) (c i)

/-- With nonzero first row, a vanishing two-by-two determinantal divisor
forces every balanced second displacement to vanish, and conversely. -/
theorem vertical_trivial_iff (q b : ι → ℤ) (hq₀ : q≠0) :
    vertical q b=⊥ ↔ ∀ i j, minorColumn q b (i,j)=0 := by
  obtain ⟨w,_,hw,_⟩ := primitive_direction q hq₀
  constructor
  · intro h i j
    have hm := normalized_minor_mem b _ hw i j
    rw [h,AddSubgroup.mem_bot] at hm
    calc
      minorColumn q b (i,j) = content q*minorColumn w b (i,j) := by
        change q i*b j-q j*b i=_
        rw [congrFun hw i,congrFun hw j]
        change content q*w i*b j-content q*w j*b i=content q*(w i*b j-w j*b i)
        ring
      _ = 0 := by rw [hm,mul_zero]
  · intro h
    have hm : minorColumn q b=0 := funext fun i => h i.1 i.2
    have hg : content q ≠ 0 := fun he => hq₀ (by simpa only [he,zero_smul] using hw)
    apply bot_unique
    intro d hd
    have hd' := minors_divide_vertical q b hd
    rw [hm,content,Finset.gcd_eq_zero_iff.mpr (by simp),zero_dvd_iff,mul_eq_zero] at hd'
    exact AddSubgroup.mem_bot.mpr (hd'.resolve_left hg)

end GaloisForLFunctions.CollectiveDiophantineGeometry.Simplex

#print axioms GaloisForLFunctions.CollectiveDiophantineGeometry.Simplex.minors_divide_vertical
#print axioms GaloisForLFunctions.CollectiveDiophantineGeometry.Simplex.normalized_minor_mem
#print axioms GaloisForLFunctions.CollectiveDiophantineGeometry.Simplex.vertical_iff
#print axioms GaloisForLFunctions.CollectiveDiophantineGeometry.Simplex.normalized_minors_generate
#print axioms GaloisForLFunctions.CollectiveDiophantineGeometry.Simplex.vertical_trivial_iff
