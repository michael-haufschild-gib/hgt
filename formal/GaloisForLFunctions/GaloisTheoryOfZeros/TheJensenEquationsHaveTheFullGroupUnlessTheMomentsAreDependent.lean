import GaloisForLFunctions.GaloisTheoryOfZeros.AFoldedEquationWithIndependentCoefficientsHasTheFullSignedPermutationGroup
import GaloisForLFunctions.GaloisTheoryOfZeros.CenteredJensenDiscriminantField

/-!
# The Jensen equations have the full group unless the moments are dependent

The centred Jensen equation of `ξ` of degree `2n` is the folded equation `E_n(X²)`. The
coefficients of `E_n` are nonzero rational multiples of the normalized moments
`μ₂/μ₀, …, μ₂ₙ/μ₀`, in reversed order (`jensenCoeff_eq`). So

* the Jensen equation is the folded equation of its coefficient family
  (`foldedEquation_jensenCoeff`), an equation over the field `ℚ(μ₂/μ₀, …, μ₂ₙ/μ₀)`;
* its coefficients are algebraically independent over `ℚ` exactly when the first `n` normalized
  moments are (`algebraicIndependent_jensenCoeff_iff`);
* its group over the field of its coefficients is the full group `C₂ ≀ S_n` of signed permutations
  of the `n` pairs of roots, or the first `n` normalized moments satisfy a polynomial relation over
  `ℚ` (`jensenGal_full_or_exists_moment_relation`).

The group of one Jensen equation is thereby reduced to a transcendence statement on the moments
of the Riemann kernel.
-/

namespace GaloisForLFunctions.GaloisTheoryOfZeros

noncomputable section
set_option autoImplicit false

/-- The coefficients of the even quotient equation `E_n` below the leading one. -/
def jensenCoeff (n : ℕ) (k : Fin n) : ℝ := (evenCenteredQuotient n).coeff k

/-- The normalized moments `μ₂/μ₀, …, μ₂ₙ/μ₀`. -/
def normalizedMomentFamily (n : ℕ) (j : Fin n) : ℝ := normalizedEvenMoment ((j : ℕ) + 1)

/-- The rational factor `(−1)^{n−k} C(2n, 2(n−k))` between a coefficient of `E_n` and its
moment. -/
def jensenCoeffFactor (n : ℕ) (k : Fin n) : ℚ :=
  (-1) ^ (n - (k : ℕ)) *
    (((2 * n).descFactorial (2 * (n - (k : ℕ))) : ℚ) / ((2 * (n - (k : ℕ))).factorial : ℚ))

theorem jensenCoeffFactor_ne_zero (n : ℕ) (k : Fin n) : jensenCoeffFactor n k ≠ 0 := by
  refine mul_ne_zero (pow_ne_zero _ (by norm_num)) (div_ne_zero ?_ ?_)
  · refine Nat.cast_ne_zero.2 fun h => ?_
    have := Nat.descFactorial_eq_zero_iff_lt.1 h
    omega
  · exact Nat.cast_ne_zero.2 (Nat.factorial_pos _).ne'

/-- **The coefficients of `E_n` are rational multiples of the moments, in reversed order.** -/
theorem jensenCoeff_eq (n : ℕ) (k : Fin n) :
    jensenCoeff n k =
      algebraMap ℚ ℝ (jensenCoeffFactor n k) * (normalizedMomentFamily n ∘ Fin.rev) k := by
  have hk := k.2
  have hrev : ((Fin.rev k : Fin n) : ℕ) + 1 = n - (k : ℕ) := by
    rw [Fin.val_rev]
    omega
  rw [jensenCoeff, evenCenteredQuotient_coeff n k (le_of_lt hk), Function.comp_apply,
    normalizedMomentFamily, hrev, jensenCoeffFactor]
  simp only [eq_ratCast, Rat.cast_mul, Rat.cast_pow, Rat.cast_neg, Rat.cast_one, Rat.cast_div,
    Rat.cast_natCast]

/-- **The Jensen equation of degree `2n` is the folded equation of the coefficients of `E_n`.** -/
theorem foldedEquation_jensenCoeff (n : ℕ) :
    foldedEquation (jensenCoeff n) = monicCenteredJensen (2 * n) := by
  have hE := (evenCenteredQuotient_monic n).as_sum
  rw [evenCenteredQuotient_natDegree] at hE
  rw [← evenCenteredQuotient_factor, ← Polynomial.expand_eq_comp_X_pow, foldedEquation]
  conv_rhs => rw [hE]
  rw [map_add, map_pow, Polynomial.expand_X, ← pow_mul, map_sum, Finset.sum_range]
  congr 1
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [map_mul, Polynomial.expand_C, map_pow, Polynomial.expand_X, ← pow_mul]
  rfl

/-- **The coefficients of a Jensen equation are algebraically independent exactly when the
normalized moments are.** -/
theorem algebraicIndependent_jensenCoeff_iff (n : ℕ) :
    AlgebraicIndependent ℚ (jensenCoeff n) ↔
      AlgebraicIndependent ℚ (normalizedMomentFamily n) := by
  constructor
  · intro h
    have h1 := algebraicIndependent_const_mul (h.comp Fin.rev Fin.rev_injective)
      (fun j : Fin n => (jensenCoeffFactor n (Fin.rev j))⁻¹)
      fun j => inv_ne_zero (jensenCoeffFactor_ne_zero n _)
    have hfun : (fun j : Fin n => algebraMap ℚ ℝ (jensenCoeffFactor n (Fin.rev j))⁻¹ *
        (jensenCoeff n ∘ Fin.rev) j) = normalizedMomentFamily n := by
      funext j
      rw [Function.comp_apply, jensenCoeff_eq, Function.comp_apply, Fin.rev_rev, ← mul_assoc,
        ← map_mul, inv_mul_cancel₀ (jensenCoeffFactor_ne_zero n _), map_one, one_mul]
    rw [← hfun]
    exact h1
  · intro h
    have h1 := algebraicIndependent_const_mul (h.comp Fin.rev Fin.rev_injective)
      (jensenCoeffFactor n) (jensenCoeffFactor_ne_zero n)
    have hfun : (fun k : Fin n => algebraMap ℚ ℝ (jensenCoeffFactor n k) *
        (normalizedMomentFamily n ∘ Fin.rev) k) = jensenCoeff n :=
      funext fun k => (jensenCoeff_eq n k).symm
    rw [← hfun]
    exact h1

/-- The Jensen equation of degree `2n` over the field generated by its coefficients. -/
def jensenEquationOver (n : ℕ) :
    Polynomial (IntermediateField.adjoin ℚ (Set.range (jensenCoeff n))) :=
  foldedEquationOver ℚ (jensenCoeff n)

theorem map_jensenEquationOver (n : ℕ) :
    (jensenEquationOver n).map
        (algebraMap (IntermediateField.adjoin ℚ (Set.range (jensenCoeff n))) ℝ) =
      monicCenteredJensen (2 * n) := by
  rw [jensenEquationOver, map_foldedEquationOver_algebraMap, foldedEquation_jensenCoeff]

/-- **The group of a Jensen equation is full, or the moments are dependent.** Over the field of
its coefficients the Jensen equation of degree `2n` has the group of all signed permutations of
its `n` pairs of roots, unless `μ₂/μ₀, …, μ₂ₙ/μ₀` satisfy a polynomial relation over `ℚ`. -/
theorem jensenGal_full_or_exists_moment_relation (n : ℕ) :
    Nonempty (FibreSignedPerm (Fin n) ≃* (jensenEquationOver n).Gal) ∨
      ∃ P : MvPolynomial (Fin n) ℚ, P ≠ 0 ∧
        MvPolynomial.aeval (normalizedMomentFamily n) P = 0 := by
  by_cases h : AlgebraicIndependent ℚ (normalizedMomentFamily n)
  · exact Or.inl ⟨foldedGaloisEquivOfAlgebraicIndependent
      ((algebraicIndependent_jensenCoeff_iff n).2 h)⟩
  · right
    by_contra hno
    refine h (algebraicIndependent_iff.2 fun P hP => ?_)
    by_contra hP0
    exact hno ⟨P, hP0, hP⟩

/-- A Jensen equation whose group over its coefficients does not have order `2ⁿ n!` gives a
polynomial relation over `ℚ` among the normalized moments. -/
theorem exists_moment_relation_of_card_jensenGal_ne (n : ℕ)
    (h : Nat.card (jensenEquationOver n).Gal ≠ n.factorial * 2 ^ n) :
    ∃ P : MvPolynomial (Fin n) ℚ, P ≠ 0 ∧
      MvPolynomial.aeval (normalizedMomentFamily n) P = 0 := by
  rcases jensenGal_full_or_exists_moment_relation n with ⟨⟨e⟩⟩ | hrel
  · exact absurd ((Nat.card_congr e.toEquiv).symm.trans FibreSignedPerm.natCard) h
  · exact hrel

end

end GaloisForLFunctions.GaloisTheoryOfZeros
