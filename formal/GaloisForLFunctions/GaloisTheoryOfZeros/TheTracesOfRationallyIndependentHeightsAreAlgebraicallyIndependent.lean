import GaloisForLFunctions.GaloisTheoryOfZeros.TheTracesOfDistinctHeightsAreLinearlyIndependent
import GaloisForLFunctions.GaloisTheoryOfZeros.TheMixedPrimeTracesSatisfyTheFunctionalEquation

/-!
# The traces of rationally independent heights are algebraically independent

The prime trace field `B` is generated by the values of the trace functions
`T_t(m) = Σ_{Im q = ±t} n_m^q` (copies with multiplicity) of the prime vector `m`. Traces of
distinct heights satisfy no linear relation. This module treats algebraic relations.

* **Algebraic independence** (`primeTraceFunction_algebraicIndependent`). If finitely many
  occupied heights `t_1, …, t_k` are linearly independent over `ℤ` (equivalently over `ℚ`), the
  trace functions `T_{t_1}, …, T_{t_k}` are algebraically independent over `ℂ`.

So an algebraic relation among the traces of different heights forces a rational linear relation
among those heights: relations across heights are reduced to the arithmetic of the ordinates,
and the linear independence of the ordinates over `ℚ` would exclude all of them.

Proof. The trace functions are the images, under the injective map from the group algebra
`ℂ[ℂ]` of exponents to functions (Dedekind independence of characters), of the sums `Σ [q]` of
the copies. Taking imaginary parts sends the sum of height `t` to `N_t ([t] + [−t])`. For
`ℤ`-independent heights the group they span is free, so these are the images of
`N_i (X_i + X_i⁻¹)` in a Laurent ring, which are algebraically independent: evaluating at a
point `X_i = a_i` with `N_i (a_i + a_i⁻¹) = b_i` reaches every `b ∈ ℂ^k`.
-/

noncomputable section
set_option autoImplicit false
open Complex Set RHTower
open scoped BigOperators Classical
namespace GaloisForLFunctions.GaloisTheoryOfZeros

/-- The multiplicative group of integer prime vectors. -/
abbrev PrimeVectorGroup := Multiplicative (Nat.Primes →₀ ℤ)

/-- The trace function `m ↦ T_t(m)` of a height. -/
def primeTraceFunction (t : ℝ) : PrimeVectorGroup → ℂ :=
  fun g => primeDivisorTrace t (Multiplicative.toAdd g)

/-! ## A Laurent lemma -/

section Laurent

variable {ι : Type*} [Fintype ι]

/-- `X_i^n` in the Laurent ring `ℂ[ℤ^ι]`. -/
def laurentVar (i : ι) (n : ℤ) : AddMonoidAlgebra ℂ (ι →₀ ℤ) :=
  AddMonoidAlgebra.single (Finsupp.single i n) 1

/-- The character `v ↦ ∏ a_i^{v_i}` of `ℤ^ι` at a point of the torus. -/
def laurentEvalChar (a : ι → ℂ) (ha : ∀ i, a i ≠ 0) : Multiplicative (ι →₀ ℤ) →* ℂ where
  toFun v := ∏ i, a i ^ (Multiplicative.toAdd v i)
  map_one' := by simp
  map_mul' v w := by
    simp only [toAdd_mul, Finsupp.add_apply]
    rw [← Finset.prod_mul_distrib]
    exact Finset.prod_congr rfl fun i _ => zpow_add₀ (ha i) _ _

/-- Evaluation of Laurent polynomials at a point of the torus. -/
def laurentEval (a : ι → ℂ) (ha : ∀ i, a i ≠ 0) : AddMonoidAlgebra ℂ (ι →₀ ℤ) →ₐ[ℂ] ℂ :=
  AddMonoidAlgebra.lift ℂ ℂ (ι →₀ ℤ) (laurentEvalChar a ha)

theorem laurentEval_var (a : ι → ℂ) (ha : ∀ i, a i ≠ 0) (i : ι) (n : ℤ) :
    laurentEval a ha (laurentVar i n) = a i ^ n := by
  rw [laurentEval, laurentVar, AddMonoidAlgebra.lift_single, one_smul]
  show ∏ j, a j ^ ((Finsupp.single i n) j) = a i ^ n
  rw [Finset.prod_eq_single i]
  · rw [Finsupp.single_eq_same]
  · intro j _ hj
    rw [Finsupp.single_eq_of_ne hj, zpow_zero]
  · intro h
    exact (h (Finset.mem_univ i)).elim

/-- Every `c ∈ ℂ` is `N (a + a⁻¹)` for some `a ≠ 0`, when `N ≠ 0`. -/
theorem exists_ne_zero_mul_add_inv (N : ℂ) (hN : N ≠ 0) (c : ℂ) :
    ∃ a : ℂ, a ≠ 0 ∧ N * (a + a⁻¹) = c := by
  obtain ⟨s, hs⟩ := IsAlgClosed.exists_pow_nat_eq ((c / N) ^ 2 - 4) two_pos
  -- `a = (c/N + s)/2` solves `a² − (c/N) a + 1 = 0`
  set a := (c / N + s) / 2 with ha_def
  have hq : a ^ 2 - c / N * a + 1 = 0 := by
    rw [ha_def]
    linear_combination hs / 4
  have ha0 : a ≠ 0 := by
    intro h
    rw [h] at hq
    norm_num at hq
  have hinv : a + a⁻¹ = c / N := by
    have h2 : a * (a + a⁻¹) = a * (c / N) := by
      rw [mul_add, mul_inv_cancel₀ ha0]
      linear_combination hq
    exact mul_left_cancel₀ ha0 h2
  refine ⟨a, ha0, ?_⟩
  rw [hinv]
  field_simp

/-- The elements `N_i (X_i + X_i⁻¹)` of the Laurent ring are algebraically independent. -/
theorem laurent_algebraicIndependent (N : ι → ℂ) (hN : ∀ i, N i ≠ 0) :
    AlgebraicIndependent ℂ fun i => N i • (laurentVar i 1 + laurentVar i (-1)) := by
  rw [algebraicIndependent_iff_injective_aeval, injective_iff_map_eq_zero]
  intro P hP
  apply MvPolynomial.funext
  intro b
  choose a ha0 ha using fun i => exists_ne_zero_mul_add_inv (N i) (hN i) (b i)
  have h := congrArg (laurentEval a ha0) hP
  rw [map_zero, ← AlgHom.comp_apply, MvPolynomial.comp_aeval] at h
  have hb : b = fun i => laurentEval a ha0 (N i • (laurentVar i 1 + laurentVar i (-1))) := by
    funext i
    rw [map_smul, map_add, laurentEval_var, laurentEval_var, zpow_one, zpow_neg_one, smul_eq_mul]
    exact (ha i).symm
  rw [map_zero, ← MvPolynomial.coe_aeval_eq_eval, hb]
  exact h

end Laurent

/-! ## From exponents to trace functions -/

/-- The characters `m ↦ n_m^z` of the exponents `z ∈ ℂ`. -/
def primeExponentCharacters : Multiplicative ℂ →* (PrimeVectorGroup → ℂ) where
  toFun z := ⇑(primeTraceCharacter (Multiplicative.toAdd z))
  map_one' := by
    funext g
    show primeRelationValue 0 (Multiplicative.toAdd g) = 1
    simp [primeRelationValue]
  map_mul' z w := by
    funext g
    show primeRelationValue (Multiplicative.toAdd z + Multiplicative.toAdd w)
        (Multiplicative.toAdd g) =
      primeRelationValue (Multiplicative.toAdd z) (Multiplicative.toAdd g) *
        primeRelationValue (Multiplicative.toAdd w) (Multiplicative.toAdd g)
    simp only [primeRelationValue, add_mul, Complex.exp_add]

/-- The group algebra of the exponents maps to functions of the prime vector. -/
def primeExponentAlgHom : AddMonoidAlgebra ℂ ℂ →ₐ[ℂ] (PrimeVectorGroup → ℂ) :=
  AddMonoidAlgebra.lift ℂ (PrimeVectorGroup → ℂ) ℂ primeExponentCharacters

theorem primeExponentAlgHom_eq (f : AddMonoidAlgebra ℂ ℂ) :
    primeExponentAlgHom f =
      Finsupp.linearCombination ℂ (fun z : ℂ => ⇑(primeTraceCharacter z)) f.coeff := by
  induction f using AddMonoidAlgebra.induction_linear with
  | zero => rw [map_zero, AddMonoidAlgebra.coeff_zero, map_zero]
  | add f g hf hg => rw [map_add, AddMonoidAlgebra.coeff_add, map_add, hf, hg]
  | single z c =>
    rw [AddMonoidAlgebra.coeff_single, Finsupp.linearCombination_single, primeExponentAlgHom,
      AddMonoidAlgebra.lift_single]
    rfl

/-- Distinct exponents give linearly independent characters (Dedekind), so the map is
injective. -/
theorem primeExponentAlgHom_injective : Function.Injective primeExponentAlgHom := by
  have hli : LinearIndependent ℂ (fun z : ℂ => ⇑(primeTraceCharacter z)) :=
    (linearIndependent_monoidHom PrimeVectorGroup ℂ).comp primeTraceCharacter
      primeTraceCharacter_injective
  intro f g h
  apply AddMonoidAlgebra.coeff_injective
  apply hli.finsuppLinearCombination_injective
  rw [← primeExponentAlgHom_eq, ← primeExponentAlgHom_eq, h]

/-- The exponents of the copies of ordinate `±t` in the group algebra. -/
def primeTraceExponentSum (t : ℝ) : AddMonoidAlgebra ℂ ℂ :=
  ∑ i : PrimeTraceCopies t, AddMonoidAlgebra.single ((primeTraceCopy t i).1 : ℂ) 1

theorem primeExponentAlgHom_traceExponentSum (t : ℝ) :
    primeExponentAlgHom (primeTraceExponentSum t) = primeTraceFunction t := by
  rw [primeTraceExponentSum, map_sum]
  funext g
  rw [Finset.sum_apply, primeTraceFunction, primeDivisorTrace]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [primeExponentAlgHom, AddMonoidAlgebra.lift_single, one_smul]
  rfl

/-! ## Imaginary parts -/

/-- Taking imaginary parts of the exponents. -/
def imagExponentAlgHom : AddMonoidAlgebra ℂ ℂ →ₐ[ℂ] AddMonoidAlgebra ℂ ℝ :=
  AddMonoidAlgebra.mapDomainAlgHom ℂ ℂ Complex.imAddGroupHom

theorem imagExponentAlgHom_single_copy {t : ℝ} {q : XiZeroCopy} (hq : q ∈ ordinateFibreCopies t) :
    imagExponentAlgHom (AddMonoidAlgebra.single (q.1 : ℂ) 1) = AddMonoidAlgebra.single t 1 := by
  rw [imagExponentAlgHom, AddMonoidAlgebra.mapDomainAlgHom_apply, AddMonoidAlgebra.mapDomain_single]
  congr 1
  have h := (mem_ordinateFibreCopies t q).1 hq
  rw [xiSpectralPoint_re_eq_im] at h
  exact h

/-- The imaginary parts of the copies of ordinate `±t`: `N_t ([t] + [−t])`. -/
theorem imagExponentAlgHom_traceExponentSum (t : ℝ) :
    imagExponentAlgHom (primeTraceExponentSum t) =
      (Fintype.card ↥(ordinateFibreCopies t) : ℂ) •
        (AddMonoidAlgebra.single t 1 + AddMonoidAlgebra.single (-t) 1) := by
  rw [primeTraceExponentSum, map_sum, Fintype.sum_sum_type]
  rw [Finset.sum_congr rfl fun q _ => imagExponentAlgHom_single_copy (t := t) q.2,
    Finset.sum_congr rfl fun q _ => imagExponentAlgHom_single_copy (t := -t) q.2,
    Finset.sum_const, Finset.sum_const, Finset.card_univ, Finset.card_univ,
    ← Fintype.card_congr (ordinateFibreReflect (s := -t) rfl), smul_add,
    Nat.cast_smul_eq_nsmul, Nat.cast_smul_eq_nsmul]

/-! ## Algebraic independence -/

/-- **Algebraic independence.** The trace functions of finitely many occupied heights that are
linearly independent over `ℤ` are algebraically independent over `ℂ`. -/
theorem primeTraceFunction_algebraicIndependent {k : ℕ} (t : Fin k → ℝ)
    (ht : LinearIndependent ℤ t) (hocc : ∀ i, ∃ ρ : XiDivisorSupport, (ρ : ℂ).im = t i) :
    AlgebraicIndependent ℂ fun i => primeTraceFunction (t i) := by
  let N : Fin k → ℂ := fun i => (Fintype.card ↥(ordinateFibreCopies (t i)) : ℂ)
  have hN : ∀ i, N i ≠ 0 := by
    intro i
    obtain ⟨ρ, hρ⟩ := hocc i
    have hpos : 0 < Fintype.card ↥(ordinateFibreCopies (t i)) :=
      Fintype.card_pos_iff.2 ⟨⟨primeTraceSupportCopy ρ, (mem_ordinateFibreCopies _ _).2 (by
        rw [xiSpectralPoint_re_eq_im]
        exact hρ)⟩⟩
    show (Fintype.card ↥(ordinateFibreCopies (t i)) : ℂ) ≠ 0
    exact_mod_cast hpos.ne'
  -- the heights span a free group: the Laurent ring embeds by `v ↦ Σ v_i t_i`
  let θ : AddMonoidAlgebra ℂ (Fin k →₀ ℤ) →ₐ[ℂ] AddMonoidAlgebra ℂ ℝ :=
    AddMonoidAlgebra.mapDomainAlgHom ℂ ℂ (Finsupp.linearCombination ℤ t).toAddMonoidHom
  have hθ : Function.Injective θ := by
    intro f g h
    simp only [θ, AddMonoidAlgebra.mapDomainAlgHom_apply] at h
    exact AddMonoidAlgebra.mapDomain_injective ht h
  have hy := (laurent_algebraicIndependent N hN).map' hθ
  have hcomp : (θ ∘ fun i => N i • (laurentVar i 1 + laurentVar i (-1))) =
      imagExponentAlgHom ∘ fun i => primeTraceExponentSum (t i) := by
    funext i
    simp only [Function.comp, imagExponentAlgHom_traceExponentSum, map_smul, map_add, laurentVar,
      θ, AddMonoidAlgebra.mapDomainAlgHom_apply, AddMonoidAlgebra.mapDomain_single,
      LinearMap.toAddMonoidHom_coe, Finsupp.linearCombination_single, one_smul, neg_one_smul, N]
  rw [hcomp] at hy
  have hT := (AlgebraicIndependent.of_comp imagExponentAlgHom hy).map'
    primeExponentAlgHom_injective
  convert hT using 1
  funext i
  exact (primeExponentAlgHom_traceExponentSum (t i)).symm

end GaloisForLFunctions.GaloisTheoryOfZeros
