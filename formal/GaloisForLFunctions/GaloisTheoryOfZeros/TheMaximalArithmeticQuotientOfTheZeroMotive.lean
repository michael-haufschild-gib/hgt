import GaloisForLFunctions.GaloisTheoryOfZeros.TheIntegralZeroMotive
import GaloisForLFunctions.RHTower.SixExponentials.PrimePowers
import GaloisForLFunctions.RHTower.CentralReciprocalMoments

/-!
# The maximal arithmetic quotient of the zero motive

A complex exponent has algebraic values at three distinct prime times exactly
when it is rational. Applied to the full integer zero group `Δ`, this identifies
`Δ ∩ ℚ` as the maximal character subgroup with algebraic prime-time values.
It contains the unit weight, is saturated of rational rank one, and is proper.

Restriction onto its complex character group is surjective. Its kernel is
exactly the character group of `Δ/(Δ ∩ ℚ)` and contains an injective real family
of ordinate characters. All admissible character restrictions factor uniquely
through this quotient. Algebraicity refers to the character basis, equivalently
to the canonical rational group-algebra form.
-/

noncomputable section
set_option autoImplicit false
open Complex Set RHTower
namespace GaloisForLFunctions.GaloisTheoryOfZeros

/-- Three algebraic prime exponentials force the exponent itself to be rational. -/
theorem rational_of_three_prime_exponentials {z : ℂ} {p q r : ℕ}
    (hp : p.Prime) (hq : q.Prime) (hr : r.Prime)
    (hpq : p ≠ q) (hpr : p ≠ r) (hqr : q ≠ r)
    (hap : IsAlgebraic ℚ (Complex.exp (z*(Real.log p : ℂ))))
    (haq : IsAlgebraic ℚ (Complex.exp (z*(Real.log q : ℂ))))
    (har : IsAlgebraic ℚ (Complex.exp (z*(Real.log r : ℂ)))) :
    ∃ a : ℚ, z = (a : ℂ) := by
  by_contra hz
  have hx : ∀ a b : ℤ, (a : ℂ)*1+(b : ℂ)*z = 0 → a = 0 ∧ b = 0 := by
    intro a b h
    by_cases hb : b = 0
    · subst b
      have ha : (a : ℂ) = 0 := by simpa only [Int.cast_zero,zero_mul,add_zero,mul_one] using h
      exact ⟨by exact_mod_cast ha,rfl⟩
    · exfalso
      apply hz
      refine ⟨-(a : ℚ)/(b : ℚ),?_⟩
      have hbC : (b : ℂ) ≠ 0 := by exact_mod_cast hb
      push_cast
      apply (eq_div_iff hbC).mpr
      linear_combination h
  have hy := fun m₀ m₁ m₂ h =>
    GaloisForLFunctions.RHTower.SixExponentials.prime_logs_independent
      hp hq hr hpq hpr hqr m₀ m₁ m₂ h
  apply GaloisForLFunctions.RHTower.SixExponentials.six_exponentials hx hy
  intro i j
  fin_cases i <;> fin_cases j <;> simp only [Matrix.cons_val_zero,Matrix.cons_val_one,
    Matrix.head_cons,Matrix.cons_val_two,Matrix.tail_cons,one_mul,Fin.mk_one,Fin.isValue,
    Fin.reduceFinMk]
  · rw [GaloisForLFunctions.RHTower.SixExponentials.exp_log_nat hp.pos]
    exact isAlgebraic_nat p
  · rw [GaloisForLFunctions.RHTower.SixExponentials.exp_log_nat hq.pos]
    exact isAlgebraic_nat q
  · rw [GaloisForLFunctions.RHTower.SixExponentials.exp_log_nat hr.pos]
    exact isAlgebraic_nat r
  · exact hap
  · exact haq
  · exact har

/-- Every prime exponential of a rational exponent is algebraic. -/
theorem rational_prime_exponential_algebraic (a : ℚ) {p : ℕ} (hp : 0 < p) :
    IsAlgebraic ℚ (Complex.exp ((a : ℂ)*(Real.log p : ℂ))) := by
  apply IsAlgebraic.of_pow (Nat.pos_of_ne_zero a.den_ne_zero)
  rw [← Complex.exp_nat_mul]
  have ha : (a.den : ℂ)*(a : ℂ) = (a.num : ℂ) := by
    rw [Rat.cast_def]
    have hd : (a.den : ℂ) ≠ 0 := by exact_mod_cast a.den_ne_zero
    field_simp
  rw [← mul_assoc,ha,Complex.exp_int_mul,
    GaloisForLFunctions.RHTower.SixExponentials.exp_log_nat hp]
  have he : (p : ℂ)^a.num = algebraMap ℚ ℂ ((p : ℚ)^a.num) := by simp
  rw [he]
  exact isAlgebraic_algebraMap _

/-- Algebraicity at three distinct prime times detects exactly the rational exponents. -/
theorem three_prime_exponentials_algebraic_iff {z : ℂ} {p q r : ℕ}
    (hp : p.Prime) (hq : q.Prime) (hr : r.Prime)
    (hpq : p ≠ q) (hpr : p ≠ r) (hqr : q ≠ r) :
    (IsAlgebraic ℚ (Complex.exp (z*(Real.log p : ℂ))) ∧
      IsAlgebraic ℚ (Complex.exp (z*(Real.log q : ℂ))) ∧
      IsAlgebraic ℚ (Complex.exp (z*(Real.log r : ℂ)))) ↔
      ∃ a : ℚ, z = (a : ℂ) := by
  constructor
  · rintro ⟨hap,haq,har⟩
    exact rational_of_three_prime_exponentials hp hq hr hpq hpr hqr hap haq har
  · rintro ⟨a,rfl⟩
    exact ⟨rational_prime_exponential_algebraic a hp.pos,
      rational_prime_exponential_algebraic a hq.pos,
      rational_prime_exponential_algebraic a hr.pos⟩

/-- The rational characters inside the full original integer zero group. -/
def rationalZeroSubgroup : AddSubgroup rawZeroRelationGroup :=
  ((algebraMap ℚ ℂ).toAddMonoidHom.range).comap rawZeroRelationGroup.subtype

/-- Membership retains precisely the rational complex values actually generated by the zeros. -/
theorem mem_rationalZeroSubgroup (z : rawZeroRelationGroup) :
    z ∈ rationalZeroSubgroup ↔ ∃ a : ℚ, (z : ℂ) = (a : ℂ) := by
  constructor
  · rintro ⟨a,ha⟩
    exact ⟨a,ha.symm⟩
  · rintro ⟨a,ha⟩
    exact ⟨a,ha.symm⟩

/-- The universal rational character is nonzero and belongs to the arithmetic quotient. -/
def rationalZeroOne : rationalZeroSubgroup :=
  ⟨⟨1,one_mem_rawZeroRelationGroup⟩,(mem_rationalZeroSubgroup _).mpr ⟨1,by norm_num⟩⟩

theorem rationalZeroOne_ne_zero : rationalZeroOne ≠ 0 := by
  intro h
  have hc := congrArg (fun z : rationalZeroSubgroup => ((z : rawZeroRelationGroup) : ℂ)) h
  exact one_ne_zero hc

/-- Every rational zero character has a positive integer multiple equal to an integer weight. -/
theorem rationalZero_denominator (z : rationalZeroSubgroup) :
    ∃ n : ℕ, 0 < n ∧ ∃ m : ℤ, n • z = m • rationalZeroOne := by
  obtain ⟨a,ha⟩ := (mem_rationalZeroSubgroup z).mp z.property
  refine ⟨a.den,Nat.pos_of_ne_zero a.den_ne_zero,a.num,?_⟩
  apply Subtype.ext
  apply Subtype.ext
  change (a.den : ℕ) • ((z : rawZeroRelationGroup) : ℂ) = (a.num : ℤ) • (1 : ℂ)
  rw [ha]
  simp only [nsmul_eq_mul,zsmul_eq_mul,mul_one,Rat.cast_def]
  have hd : (a.den : ℂ) ≠ 0 := by exact_mod_cast a.den_ne_zero
  field_simp


/-- Rationality is saturated inside the full integer zero group. -/
theorem rationalZeroSubgroup_saturated {n : ℕ} (hn : 0 < n)
    {z : rawZeroRelationGroup} (h : n • z ∈ rationalZeroSubgroup) :
    z ∈ rationalZeroSubgroup := by
  obtain ⟨a,ha⟩ := (mem_rationalZeroSubgroup (n • z)).mp h
  apply (mem_rationalZeroSubgroup z).mpr
  refine ⟨a / n,?_⟩
  have hnC : (n : ℂ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hn)
  change (n : ℕ) • (z : ℂ) = (a : ℂ) at ha
  rw [nsmul_eq_mul] at ha
  push_cast
  apply (eq_div_iff hnC).mpr
  simpa only [mul_comm] using ha

/-- Removing the rational characters leaves no nonzero torsion character exponent. -/
theorem arithmeticRelationQuotient_torsionFree (n : ℕ)
    (z : rawZeroRelationGroup ⧸ rationalZeroSubgroup) (hn : 0 < n) :
    n • z = 0 → z = 0 := by
  obtain ⟨x,rfl⟩ := QuotientAddGroup.mk'_surjective rationalZeroSubgroup z
  intro h
  rw [← map_nsmul] at h
  apply (QuotientAddGroup.eq_zero_iff x).mpr
  exact rationalZeroSubgroup_saturated hn ((QuotientAddGroup.eq_zero_iff (n • x)).mp h)

/-- Algebraic prime-time values on an entire character subgroup. -/
def AlgebraicPrimeTime (p : ℕ) (H : AddSubgroup rawZeroRelationGroup) : Prop :=
  ∀ z : rawZeroRelationGroup, z ∈ H →
    IsAlgebraic ℚ (Complex.exp ((z : ℂ)*(Real.log p : ℂ)))

/-- The rational subgroup is the largest character group supporting three algebraic prime-time points. -/
theorem threePrimeAlgebraic_iff_rational (H : AddSubgroup rawZeroRelationGroup) {p q r : ℕ}
    (hp : p.Prime) (hq : q.Prime) (hr : r.Prime)
    (hpq : p ≠ q) (hpr : p ≠ r) (hqr : q ≠ r) :
    (AlgebraicPrimeTime p H ∧ AlgebraicPrimeTime q H ∧ AlgebraicPrimeTime r H) ↔
      H ≤ rationalZeroSubgroup := by
  constructor
  · rintro ⟨hap,haq,har⟩ z hz
    apply (mem_rationalZeroSubgroup z).mpr
    exact (three_prime_exponentials_algebraic_iff hp hq hr hpq hpr hqr).mp
      ⟨hap z hz,haq z hz,har z hz⟩
  · intro h
    have ha {s : ℕ} (hs : s.Prime) : AlgebraicPrimeTime s H := by
      intro z hz
      obtain ⟨a,he⟩ := (mem_rationalZeroSubgroup z).mp (h hz)
      rw [he]
      exact rational_prime_exponential_algebraic a hs.pos
    exact ⟨ha hp,ha hq,ha hr⟩

/-- The primes two, three and five already test the maximal arithmetic quotient. -/
theorem arithmeticZeroQuotient_maximal (H : AddSubgroup rawZeroRelationGroup) :
    (AlgebraicPrimeTime 2 H ∧ AlgebraicPrimeTime 3 H ∧ AlgebraicPrimeTime 5 H) ↔
      H ≤ rationalZeroSubgroup :=
  threePrimeAlgebraic_iff_rational H Nat.prime_two Nat.prime_three Nat.prime_five
    (by norm_num) (by norm_num) (by norm_num)

/-- Algebraicity at every prime is equivalent to the same rational character condition. -/
theorem allPrimeAlgebraic_iff_rational (H : AddSubgroup rawZeroRelationGroup) :
    (∀ p : ℕ, p.Prime → AlgebraicPrimeTime p H) ↔ H ≤ rationalZeroSubgroup := by
  constructor
  · intro h
    exact (arithmeticZeroQuotient_maximal H).mp
      ⟨h 2 Nat.prime_two,h 3 Nat.prime_three,h 5 Nat.prime_five⟩
  · intro h p hp z hz
    obtain ⟨a,he⟩ := (mem_rationalZeroSubgroup z).mp (h hz)
    rw [he]
    exact rational_prime_exponential_algebraic a hp.pos


/-- Complex points of the maximal quotient with algebraic prime-time values. -/
abbrev RationalZeroMotivePoint := rationalZeroSubgroup →+ Additive ℂˣ

/-- The full zero motive maps to its arithmetic quotient by restricting characters. -/
def arithmeticMotiveProjection : RawZeroMotivePoint →+ RationalZeroMotivePoint where
  toFun χ := χ.comp rationalZeroSubgroup.subtype
  map_zero' := by apply AddMonoidHom.ext; intro z; rfl
  map_add' χ ψ := by apply AddMonoidHom.ext; intro z; rfl

/-- Every complex point of the arithmetic quotient lifts to the original zero motive. -/
theorem arithmeticMotiveProjection_surjective : Function.Surjective arithmeticMotiveProjection := by
  intro χ
  letI := deningerDivisibleByInt ℂˣ
  exact (Module.Baer.of_divisible (Additive ℂˣ)).extension_property_addMonoidHom
    rationalZeroSubgroup.subtype Subtype.val_injective χ

/-- Characters of the quotient relation group are exactly the kernel points. -/
abbrev ArithmeticMotiveKernelPoint :=
  (rawZeroRelationGroup ⧸ rationalZeroSubgroup) →+ Additive ℂˣ

/-- Pullback of quotient characters to the original integer relation group. -/
def arithmeticMotiveKernelInclusion : ArithmeticMotiveKernelPoint →+ RawZeroMotivePoint where
  toFun χ := χ.comp (QuotientAddGroup.mk' rationalZeroSubgroup)
  map_zero' := by apply AddMonoidHom.ext; intro z; rfl
  map_add' χ ψ := by apply AddMonoidHom.ext; intro z; rfl

theorem arithmeticMotiveKernelInclusion_injective : Function.Injective arithmeticMotiveKernelInclusion := by
  intro χ ψ h
  apply AddMonoidHom.ext
  intro z
  induction z using QuotientAddGroup.induction_on with
  | H x => exact DFunLike.congr_fun h x

/-- The arithmetic quotient has the exact kernel given by characters of `Δ/(Δ∩ℚ)`. -/
theorem arithmeticMotiveProjection_kernel_iff (χ : RawZeroMotivePoint) :
    arithmeticMotiveProjection χ = 0 ↔
      ∃! ψ : ArithmeticMotiveKernelPoint, arithmeticMotiveKernelInclusion ψ = χ := by
  constructor
  · intro h
    have hk : rationalZeroSubgroup ≤ χ.ker := by
      intro z hz
      exact DFunLike.congr_fun h ⟨z,hz⟩
    refine ⟨QuotientAddGroup.lift rationalZeroSubgroup χ hk,rfl,?_⟩
    intro ψ hψ
    apply arithmeticMotiveKernelInclusion_injective
    exact hψ
  · rintro ⟨ψ,rfl,_⟩
    apply AddMonoidHom.ext
    intro z
    change ψ (QuotientAddGroup.mk' rationalZeroSubgroup (z : rawZeroRelationGroup)) = 0
    rw [show QuotientAddGroup.mk' rationalZeroSubgroup (z : rawZeroRelationGroup) = 0 from
      (QuotientAddGroup.eq_zero_iff _).mpr z.property,map_zero]

private def rationalSubgroupInclusion (H : AddSubgroup rawZeroRelationGroup)
    (hH : H ≤ rationalZeroSubgroup) : H →+ rationalZeroSubgroup where
  toFun z := ⟨z,hH z.property⟩
  map_zero' := rfl
  map_add' _ _ := rfl

/-- Character restriction to any subgroup of the rational characters. -/
def arithmeticMotiveFurtherProjection (H : AddSubgroup rawZeroRelationGroup)
    (hH : H ≤ rationalZeroSubgroup) : RationalZeroMotivePoint →+ (H →+ Additive ℂˣ) where
  toFun χ := χ.comp (rationalSubgroupInclusion H hH)
  map_zero' := by apply AddMonoidHom.ext; intro z; rfl
  map_add' χ ψ := by apply AddMonoidHom.ext; intro z; rfl

/-- Every admissible quotient factors uniquely through the maximal arithmetic quotient on complex points. -/
theorem arithmeticMotiveProjection_universal (H : AddSubgroup rawZeroRelationGroup)
    (hH : H ≤ rationalZeroSubgroup) :
    ∃! f : RationalZeroMotivePoint →+ (H →+ Additive ℂˣ),
      ∀ χ : RawZeroMotivePoint, f (arithmeticMotiveProjection χ) = χ.comp H.subtype := by
  refine ⟨arithmeticMotiveFurtherProjection H hH,?_,?_⟩
  · intro χ
    rfl
  · intro f hf
    apply AddMonoidHom.ext
    intro ψ
    obtain ⟨χ,rfl⟩ := arithmeticMotiveProjection_surjective ψ
    exact hf χ

/-- No original zero belongs to the rational character subgroup. -/
theorem rawZeroRoot_not_rational (q : XiZeroCopy) :
    rawZeroRelationRoot q ∉ rationalZeroSubgroup := by
  intro h
  obtain ⟨a,ha⟩ := (mem_rationalZeroSubgroup _).mp h
  have him := congrArg Complex.im ha
  change (q.1 : ℂ).im = (a : ℂ).im at him
  have hz : (q.1 : ℂ).im = 0 := by simpa only [Complex.ratCast_im] using him
  exact xi_divisor_support_im_ne_zero q.1 hz

private theorem zeroCopy_nonempty : Nonempty XiZeroCopy := by
  obtain ⟨ρ,hρ⟩ := xiDivisorSupport_infinite.nonempty
  refine ⟨⟨⟨ρ,hρ⟩,⟨0,?_⟩⟩⟩
  have hp := xi_divisor_pos_on_support ⟨ρ,hρ⟩
  omega

/-- The maximal arithmetic quotient is proper even though it retains the nonzero unit weight. -/
theorem rationalZeroSubgroup_ne_top : rationalZeroSubgroup ≠ ⊤ := by
  intro h
  obtain ⟨q⟩ := zeroCopy_nonempty
  exact rawZeroRoot_not_rational q (by rw [h]; trivial)

/-- The entire original motive cannot have three algebraic prime-time points. -/
theorem rawMotive_not_three_algebraic_prime_times {p q r : ℕ}
    (hp : p.Prime) (hq : q.Prime) (hr : r.Prime)
    (hpq : p ≠ q) (hpr : p ≠ r) (hqr : q ≠ r) :
    ¬ (AlgebraicPrimeTime p ⊤ ∧ AlgebraicPrimeTime q ⊤ ∧ AlgebraicPrimeTime r ⊤) := by
  intro h
  have ht := (threePrimeAlgebraic_iff_rational ⊤ hp hq hr hpq hpr hqr).mp h
  exact rationalZeroSubgroup_ne_top (le_antisymm le_top ht)

private def ordinateKernelCharacter (u : ℝ) : RawZeroMotivePoint where
  toFun z := Additive.ofMul (Units.mk0 (Complex.exp ((u*(z : ℂ).im : ℝ) : ℂ))
    (Complex.exp_ne_zero _))
  map_zero' := by
    apply Additive.toMul.injective
    apply Units.ext
    change Complex.exp ((u*(0 : ℂ).im : ℝ) : ℂ) = 1
    simp only [Complex.zero_im,mul_zero,Complex.ofReal_zero,Complex.exp_zero]
  map_add' z w := by
    apply Additive.toMul.injective
    apply Units.ext
    change Complex.exp ((u*((z : ℂ)+(w : ℂ)).im : ℝ) : ℂ) =
      Complex.exp ((u*(z : ℂ).im : ℝ) : ℂ)*Complex.exp ((u*(w : ℂ).im : ℝ) : ℂ)
    rw [Complex.add_im,mul_add,Complex.ofReal_add,Complex.exp_add]

/-- A real family of ordinate characters lies in the kernel of the maximal arithmetic quotient. -/
def arithmeticMotiveOrdinateKernel : ℝ →+ RawZeroMotivePoint where
  toFun := ordinateKernelCharacter
  map_zero' := by
    apply AddMonoidHom.ext
    intro z
    apply Additive.toMul.injective
    apply Units.ext
    change Complex.exp (((0 : ℝ)*(z : ℂ).im : ℝ) : ℂ) = 1
    rw [zero_mul,Complex.ofReal_zero,Complex.exp_zero]
  map_add' u v := by
    apply AddMonoidHom.ext
    intro z
    apply Additive.toMul.injective
    apply Units.ext
    change Complex.exp (((u+v)*(z : ℂ).im : ℝ) : ℂ) =
      Complex.exp ((u*(z : ℂ).im : ℝ) : ℂ)*Complex.exp ((v*(z : ℂ).im : ℝ) : ℂ)
    rw [add_mul,Complex.ofReal_add,Complex.exp_add]

/-- The arithmetic quotient annihilates every member of the ordinate family. -/
theorem arithmeticMotiveOrdinateKernel_trivial (u : ℝ) :
    arithmeticMotiveProjection (arithmeticMotiveOrdinateKernel u) = 0 := by
  apply AddMonoidHom.ext
  intro z
  obtain ⟨a,ha⟩ := (mem_rationalZeroSubgroup z).mp z.property
  apply Additive.toMul.injective
  apply Units.ext
  change Complex.exp ((u*((z : rawZeroRelationGroup) : ℂ).im : ℝ) : ℂ) = 1
  rw [ha,Complex.ratCast_im,mul_zero,Complex.ofReal_zero,Complex.exp_zero]

/-- Distinct real parameters give distinct kernel points, witnessed by any actual zero. -/
theorem arithmeticMotiveOrdinateKernel_injective : Function.Injective arithmeticMotiveOrdinateKernel := by
  intro u v h
  obtain ⟨q⟩ := zeroCopy_nonempty
  have he := congrArg (fun χ : RawZeroMotivePoint =>
    ((χ (rawZeroRelationRoot q)).toMul : ℂ)) h
  change Complex.exp ((u*(q.1 : ℂ).im : ℝ) : ℂ) =
    Complex.exp ((v*(q.1 : ℂ).im : ℝ) : ℂ) at he
  rw [← Complex.ofReal_exp,← Complex.ofReal_exp] at he
  have hr := Real.exp_injective (Complex.ofReal_injective he)
  exact (mul_right_cancel₀ (xi_divisor_support_im_ne_zero q.1)) hr

