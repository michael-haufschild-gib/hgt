import GaloisForLFunctions.GaloisTheoryOfZeros.TheKummerRelationsOfTheZeroWidths

/-!
# Arithmetic classes of additive zero relations

Let `D` be the field generated by the source and every squared zero width.
Nonzero imaginary offsets have the same `Gal(L/D)` character exactly when
their radicands have the same square class in `D`. Such offsets are
`D`-proportional; offsets in distinct classes are `D`-linearly independent.

Applying all Galois automorphisms and using Dedekind independence splits
any additive offset relation into its arithmetic classes. Conjugation then
separates an arbitrary centered-zero relation into its ordinate part and
these class components. The integer specialization covers the full zero
divisor, including multiplicities and zero widths, without a height cutoff.
-/

noncomputable section
set_option autoImplicit false
open Complex Set RHTower
open scoped IntermediateField
attribute [local instance] Classical.propDecidable
namespace GaloisForLFunctions.GaloisTheoryOfZeros

private theorem square_root_in_base_iff {K L : Type*} [Field K] [Field L] [Algebra K L]
    (b : L) (a : K) (hs : b^2 = algebraMap K L a) :
    (∃ k : K, algebraMap K L k = b) ↔ IsSquare a := by
  constructor
  · rintro ⟨k,hk⟩
    refine ⟨k,?_⟩
    apply (algebraMap K L).injective
    rw [map_mul,hk,← pow_two,hs]
  · rintro ⟨k,hk⟩
    have he : b^2 = (algebraMap K L k)^2 := by rw [hs,hk,map_mul,pow_two]
    rcases sq_eq_sq_iff_eq_or_eq_neg.mp he with he | he
    · exact ⟨k,he.symm⟩
    · exact ⟨-k,by rw [map_neg]; exact he.symm⟩

/-- Equal radical characters are exactly nonzero source-scalar proportionality. -/
theorem sourceRootSign_eq_iff_proportional {K L : Type*}
    [Field K] [Field L] [CharZero L] [Algebra K L] [IsGalois K L]
    (b c : L) (a d : K) (hb : b ≠ 0) (hc : c ≠ 0)
    (hsb : b^2 = algebraMap K L a) (hsc : c^2 = algebraMap K L d) :
    sourceRootSign b a hsb hb = sourceRootSign c d hsc hc ↔
      ∃ u : K, c = algebraMap K L u*b := by
  constructor
  · intro h
    have hfix : ∀ σ : L ≃ₐ[K] L, σ (c/b) = c/b := by
      intro σ
      rw [map_div₀,sourceRootSign_action c d hsc hc σ,sourceRootSign_action b a hsb hb σ,h]
      rcases Int.units_eq_one_or (sourceRootSign c d hsc hc σ) with he | he <;>
        rw [he] <;> norm_num
    obtain ⟨u,hu⟩ := (InfiniteGalois.mem_range_algebraMap_iff_fixed (c/b)).mpr hfix
    exact ⟨u,by rw [hu,div_mul_cancel₀ _ hb]⟩
  · rintro ⟨u,hu⟩
    apply Eq.symm
    apply sourceRootSign_eq_of_action c d hsc hc (sourceRootSign b a hsb hb)
    intro σ
    rw [hu,map_mul,σ.commutes,sourceRootSign_action b a hsb hb σ]
    ring

/-- The arithmetic test for two radical characters to coincide is a product-square relation. -/
theorem sourceRootSign_eq_iff_square {K L : Type*}
    [Field K] [Field L] [CharZero L] [Algebra K L] [IsGalois K L]
    (b c : L) (a d : K) (hb : b ≠ 0) (hc : c ≠ 0)
    (hsb : b^2 = algebraMap K L a) (hsc : c^2 = algebraMap K L d) :
    sourceRootSign b a hsb hb = sourceRootSign c d hsc hc ↔ IsSquare (a*d) := by
  have hp : (b*c)^2 = algebraMap K L (a*d) := by rw [mul_pow,hsb,hsc,map_mul]
  rw [sourceRootSign_eq_iff_proportional b c a d hb hc hsb hsc]
  constructor
  · rintro ⟨u,hu⟩
    apply (square_root_in_base_iff (b*c) (a*d) hp).mp
    refine ⟨u*a,?_⟩
    rw [map_mul,← hsb,hu]
    ring
  · intro h
    obtain ⟨k,hk⟩ := (square_root_in_base_iff (b*c) (a*d) hp).mpr h
    refine ⟨k/a,?_⟩
    rw [map_div₀,hk,← hsb]
    field_simp [hb]

/-- Dedekind independence separates every finite sum by its multiplicative character. -/
theorem character_sum_component {G L ι : Type*} [MulOneClass G] [Field L]
    (χ : ι → G →* L) (v : ι → L) (S : Finset ι)
    (h : ∀ g, ∑ i ∈ S, v i * χ i g = 0) (η : G →* L) :
    ∑ i ∈ S with χ i = η, v i = 0 := by
  classical
  let d : (G →* L) →₀ L := ∑ i ∈ S, Finsupp.single (χ i) (v i)
  have hd : Finsupp.linearCombination L (fun f : G →* L => (f : G → L)) d = 0 := by
    simp only [d,map_sum,Finsupp.linearCombination_single]
    ext g
    simpa only [Finset.sum_apply,Pi.smul_apply,smul_eq_mul,Pi.zero_apply] using h g
  have hz : d = 0 := (linearIndependent_monoidHom G L)
    (hd.trans (map_zero _).symm)
  have he := congrArg (fun f : (G →* L) →₀ L => f η) hz
  simpa only [d,Finsupp.finsetSum_apply,Finsupp.single_apply,Finsupp.zero_apply,
    Finset.sum_filter] using he

/-- A relation among Galois eigenvectors vanishes separately in each character. -/
theorem eigenvector_relation_component {K L ι : Type*} [Field K] [Field L]
    [Algebra K L] (b : ι → L) (χ : ι → (L ≃ₐ[K] L) →* L)
    (ha : ∀ σ i, σ (b i) = χ i σ*b i) (S : Finset ι) (c : ι → K)
    (h : ∑ i ∈ S, algebraMap K L (c i)*b i = 0) (η : (L ≃ₐ[K] L) →* L) :
    ∑ i ∈ S with χ i = η, algebraMap K L (c i)*b i = 0 := by
  apply character_sum_component χ (fun i => algebraMap K L (c i)*b i) S _ η
  intro σ
  have he := congrArg σ h
  rw [map_sum,map_zero] at he
  convert he using 1
  apply Finset.sum_congr rfl
  intro i _
  rw [map_mul,σ.commutes,ha]
  ring

private theorem sum_zero_of_class_components {ι κ L : Type*} [AddCommMonoid L]
    (f : ι → κ) (v : ι → L) (S : Finset ι)
    (h : ∀ j, ∑ i ∈ S with f i = f j, v i = 0) : ∑ i ∈ S, v i = 0 := by
  classical
  have hf : S.filter (fun i => f i ∈ S.image f) = S :=
    Finset.filter_eq_self.mpr (fun i hi => Finset.mem_image_of_mem f hi)
  have he := Finset.sum_fiberwise_eq_sum_filter S (S.image f) f v
  rw [hf] at he
  rw [← he]
  apply Finset.sum_eq_zero
  intro η hη
  obtain ⟨j,_,rfl⟩ := Finset.mem_image.mp hη
  exact h j

private def sourceRadicalCharacter {K L : Type*} [Field K] [Field L] [CharZero L]
    [Algebra K L] (b : L) (a : K) (hs : b^2 = algebraMap K L a) (hb : b ≠ 0) :
    (L ≃ₐ[K] L) →* L :=
  (Int.castRingHom L).toMonoidHom.comp ((Units.coeHom ℤ).comp (sourceRootSign b a hs hb))

private theorem sourceRadicalCharacter_eq_iff {K L : Type*}
    [Field K] [Field L] [CharZero L] [Algebra K L]
    (b c : L) (a d : K) (hb : b ≠ 0) (hc : c ≠ 0)
    (hsb : b^2 = algebraMap K L a) (hsc : c^2 = algebraMap K L d) :
    sourceRadicalCharacter b a hsb hb = sourceRadicalCharacter c d hsc hc ↔
      sourceRootSign b a hsb hb = sourceRootSign c d hsc hc := by
  constructor
  · intro h
    apply MonoidHom.ext
    intro σ
    apply Units.ext
    exact Int.cast_injective (DFunLike.congr_fun h σ :
      ((sourceRootSign b a hsb hb σ : ℤ) : L) = ((sourceRootSign c d hsc hc σ : ℤ) : L))
  · intro h
    simp only [sourceRadicalCharacter,h]

/-- Every linear relation among nonzero square roots splits exactly by source square class. -/
theorem radical_relation_iff_square_components {K L ι : Type*}
    [Field K] [Field L] [CharZero L] [Algebra K L] [IsGalois K L]
    (b : ι → L) (a : ι → K) (hs : ∀ i, b i^2 = algebraMap K L (a i))
    (hb : ∀ i, b i ≠ 0) (S : Finset ι) (c : ι → K) :
    (∑ i ∈ S, algebraMap K L (c i)*b i = 0) ↔
      ∀ j, ∑ i ∈ S with IsSquare (a i*a j), algebraMap K L (c i)*b i = 0 := by
  classical
  let χ := fun i => sourceRadicalCharacter (b i) (a i) (hs i) (hb i)
  have he (i j : ι) : χ i = χ j ↔ IsSquare (a i*a j) :=
    (sourceRadicalCharacter_eq_iff (b i) (b j) (a i) (a j) (hb i) (hb j) (hs i) (hs j)).trans
      (sourceRootSign_eq_iff_square (b i) (b j) (a i) (a j) (hb i) (hb j) (hs i) (hs j))
  have ha (σ : L ≃ₐ[K] L) (i : ι) : σ (b i) = χ i σ*b i :=
    sourceRootSign_action (b i) (a i) (hs i) (hb i) σ
  constructor
  · intro h j
    simpa only [he] using eigenvector_relation_component b χ ha S c h (χ j)
  · intro h
    apply sum_zero_of_class_components χ (fun i => algebraMap K L (c i)*b i) S
    intro j
    simpa only [he] using h j

/-- Nonzero radicals are independent exactly when their source square classes are distinct. -/
theorem radical_linearIndependent_iff {K L ι : Type*}
    [Field K] [Field L] [CharZero L] [Algebra K L] [IsGalois K L]
    (b : ι → L) (a : ι → K) (hs : ∀ i, b i^2 = algebraMap K L (a i))
    (hb : ∀ i, b i ≠ 0) :
    LinearIndependent K b ↔ Pairwise (fun i j => ¬ IsSquare (a i*a j)) := by
  classical
  constructor
  · intro h i j hij hsquare
    have he := (sourceRootSign_eq_iff_square (b i) (b j) (a i) (a j)
      (hb i) (hb j) (hs i) (hs j)).mpr hsquare
    obtain ⟨u,hu⟩ := (sourceRootSign_eq_iff_proportional (b i) (b j) (a i) (a j)
      (hb i) (hb j) (hs i) (hs j)).mp he
    have hl : Finsupp.linearCombination K b (Finsupp.single j 1) =
        Finsupp.linearCombination K b (Finsupp.single i u) := by
      simpa only [Finsupp.linearCombination_single,one_smul,Algebra.smul_def,map_one,one_mul] using hu
    have hc := congrArg (fun f : ι →₀ K => f j) (h hl)
    simp only [Finsupp.single_apply,ite_true,if_neg hij,one_ne_zero] at hc
  · intro h
    apply linearIndependent_iff'.mpr
    intro S c hc i hi
    have hrel : ∑ j ∈ S, algebraMap K L (c j)*b j = 0 := by
      simpa only [Algebra.smul_def] using hc
    have hclass := (radical_relation_iff_square_components b a hs hb S c).mp hrel i
    have hfilter : S.filter (fun j => IsSquare (a j*a i)) = {i} := by
      ext j
      simp only [Finset.mem_filter,Finset.mem_singleton]
      constructor
      · rintro ⟨_,hj⟩
        by_contra hji
        exact h hji hj
      · intro hji
        subst j
        exact ⟨hi,⟨a i,rfl⟩⟩
    rw [hfilter,Finset.sum_singleton] at hclass
    apply (algebraMap K L).injective
    simpa only [map_zero] using (mul_eq_zero.mp hclass).resolve_right (hb i)

/-- Zero radicals contribute nothing; all other terms split by their source square classes. -/
theorem radical_relation_iff_nonzero_square_components {K L ι : Type*}
    [Field K] [Field L] [CharZero L] [Algebra K L] [IsGalois K L]
    (b : ι → L) (a : ι → K) (hs : ∀ i, b i^2 = algebraMap K L (a i))
    (S : Finset ι) (c : ι → K) :
    (∑ i ∈ S, algebraMap K L (c i)*b i = 0) ↔
      ∀ j, b j ≠ 0 → ∑ i ∈ S with IsSquare (a i*a j), algebraMap K L (c i)*b i = 0 := by
  classical
  let χ : ι → (L ≃ₐ[K] L) →* L := fun i =>
    if hi : b i = 0 then 1 else sourceRadicalCharacter (b i) (a i) (hs i) hi
  have ha (σ : L ≃ₐ[K] L) (i : ι) : σ (b i) = χ i σ*b i := by
    by_cases hi : b i = 0
    · simp only [hi,map_zero,mul_zero]
    · simp only [χ,dif_neg hi]
      exact sourceRootSign_action (b i) (a i) (hs i) hi σ
  have hfilter (j : ι) (hj : b j ≠ 0) :
      (∑ i ∈ S with χ i = χ j, algebraMap K L (c i)*b i) =
        ∑ i ∈ S with IsSquare (a i*a j), algebraMap K L (c i)*b i := by
    simp only [Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro i _
    by_cases hi : b i = 0
    · simp only [hi,mul_zero,ite_self]
    · have he : χ i = χ j ↔ IsSquare (a i*a j) := by
        simp only [χ,dif_neg hi,dif_neg hj]
        exact (sourceRadicalCharacter_eq_iff (b i) (b j) (a i) (a j) hi hj (hs i) (hs j)).trans
          (sourceRootSign_eq_iff_square (b i) (b j) (a i) (a j) hi hj (hs i) (hs j))
      rw [he]
  constructor
  · intro h j hj
    rw [← hfilter j hj]
    exact eigenvector_relation_component b χ ha S c h (χ j)
  · intro h
    apply sum_zero_of_class_components χ (fun i => algebraMap K L (c i)*b i) S
    intro j
    by_cases he : ∃ k, b k ≠ 0 ∧ χ k = χ j
    · obtain ⟨k,hk,hχ⟩ := he
      rw [← hχ,hfilter k hk]
      exact h k hk
    · apply Finset.sum_eq_zero
      intro i hi
      have hb : b i = 0 := by
        by_contra hb
        exact he ⟨i,hb,(Finset.mem_filter.mp hi).2⟩
      rw [hb,mul_zero]

private theorem zeroOffset_zero_iff (q : XiZeroCopy) :
    zeroOffsetInExtension q = 0 ↔ zeroWidth q = 0 := by
  constructor
  · intro h
    have he := congrArg (fun z : fullFibreZeroExtension => (z : ℂ)) h
    change zeroImaginaryOffset q = 0 at he
    rw [zeroImaginaryOffset_eq] at he
    exact (mul_eq_zero.mp he).resolve_left I_ne_zero
  · intro h
    apply Subtype.ext
    change zeroImaginaryOffset q = 0
    rw [zeroImaginaryOffset_eq,h,mul_zero]

private theorem widthRadical_nonzero (q : NonzeroWidthZero) : widthSignRadical q ≠ 0 :=
  fun h => q.property ((zeroOffset_zero_iff q.val).mp h)

/-- Arithmetic classes of imaginary offsets, over the field of all squared widths. -/
def SameWidthSquareClass (q r : NonzeroWidthZero) : Prop :=
  IsSquare (widthSignRadicand q*widthSignRadicand r)

/-- Two nonzero offsets lie in the same arithmetic class exactly when they are source-proportional. -/
theorem sameWidthSquareClass_iff_proportional (q r : NonzeroWidthZero) :
    SameWidthSquareClass q r ↔ ∃ u : widthSquareField,
      widthSignRadical r = algebraMap widthSquareField fullFibreZeroExtension u*widthSignRadical q := by
  rw [SameWidthSquareClass,← sourceRootSign_eq_iff_square
    (widthSignRadical q) (widthSignRadical r) (widthSignRadicand q) (widthSignRadicand r)
    (widthRadical_nonzero q) (widthRadical_nonzero r) rfl rfl]
  exact sourceRootSign_eq_iff_proportional
    (widthSignRadical q) (widthSignRadical r) (widthSignRadicand q) (widthSignRadicand r)
    (widthRadical_nonzero q) (widthRadical_nonzero r) rfl rfl

/-- The arithmetic width classes form an equivalence relation on all nonzero divisor copies. -/
theorem sameWidthSquareClass_equivalence : Equivalence SameWidthSquareClass := by
  have he (q r : NonzeroWidthZero) : SameWidthSquareClass q r ↔
      sourceRootSign (widthSignRadical q) (widthSignRadicand q) rfl (widthRadical_nonzero q) =
      sourceRootSign (widthSignRadical r) (widthSignRadicand r) rfl (widthRadical_nonzero r) :=
    (sourceRootSign_eq_iff_square (widthSignRadical q) (widthSignRadical r)
      (widthSignRadicand q) (widthSignRadicand r)
      (widthRadical_nonzero q) (widthRadical_nonzero r) rfl rfl).symm
  refine ⟨fun q => (he q q).mpr rfl,?_,?_⟩
  · intro q r h
    exact (he r q).mpr ((he q r).mp h).symm
  · intro q r s hqr hrs
    exact (he q s).mpr (((he q r).mp hqr).trans ((he r s).mp hrs))

/-- Any family of actual nonzero offsets is independent precisely across distinct arithmetic classes. -/
theorem widthRadicals_linearIndependent_iff {ι : Type*} (q : ι → NonzeroWidthZero) :
    LinearIndependent widthSquareField (fun i => widthSignRadical (q i)) ↔
      Pairwise (fun i j => ¬ SameWidthSquareClass (q i) (q j)) :=
  radical_linearIndependent_iff (fun i => widthSignRadical (q i))
    (fun i => widthSignRadicand (q i)) (fun _ => rfl) (fun i => widthRadical_nonzero (q i))

/-- The radicand of any divisor copy, including copies on the critical line. -/
def zeroOffsetRadicand (q : XiZeroCopy) : widthSquareField :=
  ⟨zeroOffsetInExtension q^2,IntermediateField.subset_adjoin _ _ ⟨q,rfl⟩⟩

/-- Every additive offset relation over the squared-width source splits into its arithmetic classes. -/
theorem zeroOffset_relation_iff_square_components
    (S : Finset XiZeroCopy) (c : XiZeroCopy → widthSquareField) :
    (∑ q ∈ S, algebraMap widthSquareField fullFibreZeroExtension (c q)*zeroOffsetInExtension q = 0) ↔
      ∀ r : NonzeroWidthZero, ∑ q ∈ S with IsSquare (zeroOffsetRadicand q*widthSignRadicand r),
        algebraMap widthSquareField fullFibreZeroExtension (c q)*zeroOffsetInExtension q = 0 := by
  rw [radical_relation_iff_nonzero_square_components zeroOffsetInExtension zeroOffsetRadicand
    (fun _ => rfl) S c]
  constructor
  · intro h r
    exact h r.val (widthRadical_nonzero r)
  · intro h q hq
    exact h ⟨q,fun he => hq ((zeroOffset_zero_iff q).mpr he)⟩

/-- The ordinate of a centered zero, in the squared-width source. -/
def zeroOrdinateInSquareField (q : XiZeroCopy) : widthSquareField :=
  algebraMap fullFibreSourceField widthSquareField
    ⟨((xiSpectralPoint q).re : ℂ),ordinate_mem_fullFibreSourceField q⟩

private theorem centered_zero_decomposition (q : XiZeroCopy) :
    centeredZeroInFibreExtension q =
      algebraMap widthSquareField fullFibreZeroExtension (zeroOrdinateInSquareField q) +
        zeroOffsetInExtension q := by
  apply Subtype.ext
  change xiSpectralPoint q = ((xiSpectralPoint q).re : ℂ)+zeroImaginaryOffset q
  rw [zeroImaginaryOffset]
  ring

private theorem zeroOffset_conjugation (q : XiZeroCopy) :
    widthSquareConjugation (zeroOffsetInExtension q) = -zeroOffsetInExtension q := by
  apply Subtype.ext
  change (starRingEnd ℂ) (zeroImaginaryOffset q) = -zeroImaginaryOffset q
  rw [zeroImaginaryOffset_eq]
  simp only [zeroWidth,map_mul,Complex.conj_ofReal,Complex.conj_I,neg_mul]

private theorem centered_relation_real_imaginary
    (S : Finset XiZeroCopy) (c : XiZeroCopy → widthSquareField) :
    (∑ q ∈ S, algebraMap widthSquareField fullFibreZeroExtension (c q)*centeredZeroInFibreExtension q = 0) ↔
      (∑ q ∈ S, c q*zeroOrdinateInSquareField q = 0) ∧
      (∑ q ∈ S, algebraMap widthSquareField fullFibreZeroExtension (c q)*zeroOffsetInExtension q = 0) := by
  let A := ∑ q ∈ S, c q*zeroOrdinateInSquareField q
  let B := ∑ q ∈ S, algebraMap widthSquareField fullFibreZeroExtension (c q)*zeroOffsetInExtension q
  have hd : (∑ q ∈ S, algebraMap widthSquareField fullFibreZeroExtension (c q)*centeredZeroInFibreExtension q) =
      algebraMap widthSquareField fullFibreZeroExtension A+B := by
    simp only [A,B,map_sum,map_mul,← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro q _
    rw [centered_zero_decomposition,mul_add]
  have hb : widthSquareConjugation B = -B := by
    simp only [B,map_sum,map_mul,widthSquareConjugation.commutes,zeroOffset_conjugation,
      mul_neg,Finset.sum_neg_distrib]
  rw [hd]
  change (algebraMap widthSquareField fullFibreZeroExtension A+B = 0) ↔ A = 0 ∧ B = 0
  constructor
  · intro h
    have hc := congrArg widthSquareConjugation h
    rw [map_add,widthSquareConjugation.commutes,hb,map_zero] at hc
    have ha : algebraMap widthSquareField fullFibreZeroExtension A = 0 := by
      linear_combination (1/2 : fullFibreZeroExtension)*h+(1/2 : fullFibreZeroExtension)*hc
    refine ⟨(algebraMap widthSquareField fullFibreZeroExtension).injective ?_,?_⟩
    · simpa only [map_zero] using ha
    · simpa only [ha,zero_add] using h
  · rintro ⟨ha,hb⟩
    rw [ha,hb,map_zero,add_zero]

/-- Full centered-zero relations split into their ordinate part and each arithmetic width class. -/
theorem centeredZero_relation_iff_arithmetic_components
    (S : Finset XiZeroCopy) (c : XiZeroCopy → widthSquareField) :
    (∑ q ∈ S, algebraMap widthSquareField fullFibreZeroExtension (c q)*centeredZeroInFibreExtension q = 0) ↔
      (∑ q ∈ S, c q*zeroOrdinateInSquareField q = 0) ∧
      ∀ r : NonzeroWidthZero, ∑ q ∈ S with IsSquare (zeroOffsetRadicand q*widthSignRadicand r),
        algebraMap widthSquareField fullFibreZeroExtension (c q)*zeroOffsetInExtension q = 0 := by
  rw [centered_relation_real_imaginary,zeroOffset_relation_iff_square_components]

private theorem int_sum_complex_iff {F ι : Type*} [Field F] [Algebra F ℂ]
    (S : Finset ι) (n : ι → ℤ) (b : ι → F) :
    (∑ i ∈ S, (n i : ℂ)*algebraMap F ℂ (b i) = 0) ↔
      (∑ i ∈ S, (n i : F)*b i = 0) := by
  have he : algebraMap F ℂ (∑ i ∈ S, (n i : F)*b i) =
      ∑ i ∈ S, (n i : ℂ)*algebraMap F ℂ (b i) := by
    simp only [map_sum,map_mul,map_intCast]
  rw [← he,← (algebraMap F ℂ).map_zero]
  exact (algebraMap F ℂ).injective.eq_iff

/-- Every integer relation among actual centered spectral zeros decomposes by arithmetic width class. -/
theorem centeredZero_integer_relation_iff
    (S : Finset XiZeroCopy) (n : XiZeroCopy → ℤ) :
    (∑ q ∈ S, (n q : ℂ)*xiSpectralPoint q = 0) ↔
      (∑ q ∈ S, (n q : ℂ)*((xiSpectralPoint q).re : ℂ) = 0) ∧
      ∀ r : NonzeroWidthZero, ∑ q ∈ S with IsSquare (zeroOffsetRadicand q*widthSignRadicand r),
        (n q : ℂ)*zeroImaginaryOffset q = 0 := by
  change (∑ q ∈ S, (n q : ℂ)*algebraMap fullFibreZeroExtension ℂ (centeredZeroInFibreExtension q) = 0) ↔
    (∑ q ∈ S, (n q : ℂ)*algebraMap widthSquareField ℂ (zeroOrdinateInSquareField q) = 0) ∧
    ∀ r : NonzeroWidthZero, ∑ q ∈ S with IsSquare (zeroOffsetRadicand q*widthSignRadicand r),
      (n q : ℂ)*algebraMap fullFibreZeroExtension ℂ (zeroOffsetInExtension q) = 0
  simp only [int_sum_complex_iff]
  simpa only [map_intCast] using
    centeredZero_relation_iff_arithmetic_components S (fun q => (n q : widthSquareField))

end GaloisForLFunctions.GaloisTheoryOfZeros
