import GaloisForLFunctions.GaloisTheoryOfZeros.TheReflectionRadicalsOfOneHeightCarryTheParityOfItsZeros

/-!
# The traces of distinct heights are linearly independent

The prime trace field `B` is generated by the traces `T_t(m) = Σ_{Im q = ±t} n_m^q` (copies with
multiplicity). Within one height they obey the functional equation `T_t(m) = n_m T_t(−m)` and
`T_{−t} = T_t`. Across heights there is no linear relation at all: as functions of the prime
vector `m`, the traces of distinct nonnegative heights are linearly independent over `ℂ`.

* **Independence of heights** (`trace_coeff_eq_zero`). If `Σ_{t ∈ S} a_t T_t(m) = 0` for every
  prime vector `m`, with `S` a finite set of nonnegative heights, then `a_t = 0` at every height
  `t ∈ S` that carries a zero.

Proof. Each `T_t` is the sum of the characters `m ↦ n_m^q` of its copies; distinct zeros give
distinct characters (two primes separate exponents), and distinct characters are linearly
independent (Dedekind). The character of a zero `ρ` of height `t` occurs only in `T_t`, with a
positive multiplicity.
-/

noncomputable section
set_option autoImplicit false
open Complex Set RHTower
open scoped BigOperators Classical
namespace GaloisForLFunctions.GaloisTheoryOfZeros

/-- **Independence of heights.** A linear relation among the trace functions of finitely many
distinct nonnegative heights has zero coefficient at every occupied height. -/
theorem trace_coeff_eq_zero (S : Finset ℝ) (hS : ∀ t ∈ S, 0 ≤ t) (a : ℝ → ℂ)
    (h : ∀ m : Nat.Primes →₀ ℤ, ∑ t ∈ S, a t * primeDivisorTrace t m = 0)
    {ρ : XiDivisorSupport} (hρ : (ρ : ℂ).im ∈ S) : a (ρ : ℂ).im = 0 := by
  let χ : XiZeroCopy → (Multiplicative (Nat.Primes →₀ ℤ) →* ℂ) := fun q =>
    primeTraceCharacter (q.1 : ℂ)
  have hχ : ∀ q : XiZeroCopy, χ q = primeTraceCharacter (ρ : ℂ) ↔ q.1 = ρ := fun q =>
    ⟨fun e => Subtype.ext (primeTraceCharacter_injective e), fun e => by simp only [χ, e]⟩
  -- the relation as a finitely supported combination of characters
  let F : (Multiplicative (Nat.Primes →₀ ℤ) →* ℂ) →₀ ℂ :=
    ∑ t ∈ S, ∑ i : PrimeTraceCopies t, Finsupp.single (χ (primeTraceCopy t i)) (a t)
  have hF : F = 0 := by
    apply (linearIndependent_monoidHom _ ℂ).finsuppLinearCombination_injective
    rw [map_zero]
    simp only [F, map_sum, Finsupp.linearCombination_single]
    funext g
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
    rw [← h (Multiplicative.toAdd g)]
    refine Finset.sum_congr rfl fun t _ => ?_
    rw [primeDivisorTrace, Finset.mul_sum]
    rfl
  -- the coefficient of the character of `ρ`
  have hval : F (primeTraceCharacter (ρ : ℂ)) =
      ((Finset.univ.filter fun i : PrimeTraceCopies (ρ : ℂ).im =>
        (primeTraceCopy (ρ : ℂ).im i).1 = ρ).card : ℂ) * a (ρ : ℂ).im := by
    simp only [F, Finsupp.coe_finsetSum, Finset.sum_apply, Finsupp.single_apply, hχ]
    rw [Finset.sum_eq_single (ρ : ℂ).im]
    · rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
    · intro t ht hne
      refine Finset.sum_eq_zero fun i _ => if_neg fun e => hne ?_
      have hpos : 0 < (ρ : ℂ).im :=
        lt_of_le_of_ne (hS (ρ : ℂ).im hρ) (xi_divisor_support_im_ne_zero ρ).symm
      rcases primeTraceCopy_height t i with hi | hi <;>
        rw [xiSpectralPoint_re_eq_im, e] at hi
      · exact hi.symm
      · linarith only [hi, hpos, hS t ht]
    · exact fun hn => (hn hρ).elim
  have hcard : 0 < (Finset.univ.filter fun i : PrimeTraceCopies (ρ : ℂ).im =>
      (primeTraceCopy (ρ : ℂ).im i).1 = ρ).card := by
    refine Finset.card_pos.2 ⟨.inl ⟨primeTraceSupportCopy ρ,
      (mem_ordinateFibreCopies (ρ : ℂ).im _).2 ?_⟩, Finset.mem_filter.2 ⟨Finset.mem_univ _, rfl⟩⟩
    rw [xiSpectralPoint_re_eq_im]
    rfl
  rw [hF, Finsupp.coe_zero, Pi.zero_apply] at hval
  exact (mul_eq_zero.1 hval.symm).resolve_left (by exact_mod_cast hcard.ne')

end GaloisForLFunctions.GaloisTheoryOfZeros
