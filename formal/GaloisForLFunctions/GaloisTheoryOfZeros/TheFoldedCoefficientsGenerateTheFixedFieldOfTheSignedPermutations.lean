import GaloisForLFunctions.GaloisTheoryOfZeros.TheGenericFoldedEquationHasTheFullSignedPermutationGroup
import Mathlib.FieldTheory.Galois.Basic
import Mathlib.FieldTheory.Separable
import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra

/-!
# The folded coefficients generate the fixed field of the signed permutations

The generic folded equation is `∏ (X² − x_i²) = X^{2n} + Σ_k γ_k X^{2k}`, where the `γ_k` are the
coefficients of the quotient equation `∏ (Y − x_i²)`. The group of signed permutations fixes the
`γ_k`. This file proves the converse: a rational function fixed by every signed permutation is a
rational function of the `γ_k`.

* An automorphism of `K(x)` over `K(γ)` carries each `x_i` to a root `± x_j` of the folded
  equation. The roots `± x_j` are pairwise distinct, so the automorphism is a signed permutation
  of the variables (`exists_signed_smul_eq`). Hence `Gal(K(x)/K(γ))` is the group of signed
  permutations (`foldedCoeffGaloisEquiv`).
* `K(x)` is the splitting field over `K(γ)` of the folded equation, which is separable. So the
  extension is Galois, and its fixed field `K(γ)` is the fixed field of the signed permutations
  (`foldedPartField_eq_foldedCoeffField`).

The generic folded equation is thereby an equation over the field generated by its own
coefficients, which is the form in which it specializes.
-/

namespace GaloisForLFunctions.GaloisTheoryOfZeros

open MvPolynomial
open GaloisForLFunctions.HTGeometry (SymmetricRationalField)
open FibreSignedPerm

noncomputable section
set_option autoImplicit false

/-! ## Folded equations -/

/-- The folded equation `X^{2n} + Σ_k c_k X^{2k}` with the coefficient family `c`. -/
def foldedEquation {M : Type*} [CommRing M] {n : ℕ} (c : Fin n → M) : Polynomial M :=
  Polynomial.X ^ (2 * n) + ∑ k : Fin n, Polynomial.C (c k) * Polynomial.X ^ (2 * (k : ℕ))

theorem map_foldedEquation {M N : Type*} [CommRing M] [CommRing N] (f : M →+* N) {n : ℕ}
    (c : Fin n → M) : (foldedEquation c).map f = foldedEquation fun k => f (c k) := by
  simp only [foldedEquation, Polynomial.map_add, Polynomial.map_pow, Polynomial.map_X,
    Polynomial.map_sum, Polynomial.map_mul, Polynomial.map_C]

variable {K : Type*} [Field K] {n : ℕ}

/-! ## The signed roots are distinct -/

theorem foldedRoot_injective : Function.Injective (foldedRoot K n) := by
  intro i j h
  have h' : algebraMap (MvPolynomial (Fin n) K) (SymmetricRationalField K n) (X i) =
      algebraMap (MvPolynomial (Fin n) K) (SymmetricRationalField K n) (X j) := h
  exact MvPolynomial.X_injective (IsFractionRing.injective _ _ h')

theorem foldedRoot_ne_neg [NeZero (2 : K)] (i j : Fin n) :
    foldedRoot K n i ≠ -foldedRoot K n j := by
  intro h
  have h1 : algebraMap (MvPolynomial (Fin n) K) (SymmetricRationalField K n) (X i + X j) =
      algebraMap (MvPolynomial (Fin n) K) (SymmetricRationalField K n) 0 := by
    rw [map_add, map_zero]
    exact eq_neg_iff_add_eq_zero.1 h
  have h2 := congrArg (MvPolynomial.eval fun _ : Fin n => (1 : K))
    (IsFractionRing.injective (MvPolynomial (Fin n) K) (SymmetricRationalField K n) h1)
  rw [map_add, eval_X, eval_X, map_zero, one_add_one_eq_two] at h2
  exact NeZero.ne (2 : K) h2

/-- The `2n` roots `± x_i` of the generic folded equation are pairwise distinct. -/
theorem signedRoot_inj [NeZero (2 : K)] {s t : ℤˣ} {i j : Fin n}
    (h : ((s : ℤ) : SymmetricRationalField K n) * foldedRoot K n i =
      ((t : ℤ) : SymmetricRationalField K n) * foldedRoot K n j) : i = j ∧ s = t := by
  rcases Int.units_eq_one_or s with rfl | rfl <;> rcases Int.units_eq_one_or t with rfl | rfl
  · simp only [Units.val_one, Int.cast_one, one_mul] at h
    exact ⟨foldedRoot_injective h, rfl⟩
  · simp only [Units.val_one, Units.val_neg, Int.cast_one, Int.cast_neg, one_mul, neg_mul] at h
    exact absurd h (foldedRoot_ne_neg i j)
  · simp only [Units.val_one, Units.val_neg, Int.cast_one, Int.cast_neg, one_mul, neg_mul] at h
    exact absurd h.symm (foldedRoot_ne_neg j i)
  · simp only [Units.val_one, Units.val_neg, Int.cast_one, Int.cast_neg, one_mul, neg_mul,
      neg_inj] at h
    exact ⟨foldedRoot_injective h, rfl⟩

theorem eval_genericFoldedF_eq_zero_iff {z : SymmetricRationalField K n} :
    Polynomial.eval z (genericFoldedF K n) = 0 ↔
      ∃ (i : Fin n) (s : ℤˣ), z = ((s : ℤ) : SymmetricRationalField K n) * foldedRoot K n i := by
  rw [genericFoldedF, Polynomial.eval_prod, Finset.prod_eq_zero_iff]
  constructor
  · rintro ⟨i, -, hi⟩
    rw [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C,
      sub_eq_zero, sq_eq_sq_iff_eq_or_eq_neg] at hi
    rcases hi with h | h
    · exact ⟨i, 1, by rw [h, Units.val_one, Int.cast_one, one_mul]⟩
    · exact ⟨i, -1, by
        rw [h, Units.val_neg, Units.val_one, Int.cast_neg, Int.cast_one, neg_one_mul]⟩
  · rintro ⟨i, s, rfl⟩
    refine ⟨i, Finset.mem_univ i, ?_⟩
    have hs : ((s : ℤ) : SymmetricRationalField K n) ^ 2 = 1 := by
      rcases Int.units_eq_one_or s with rfl | rfl <;> simp
    rw [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C, mul_pow,
      hs, one_mul, sub_self]

theorem eval_foldedRoot (i : Fin n) :
    Polynomial.eval (foldedRoot K n i) (genericFoldedF K n) = 0 :=
  eval_genericFoldedF_eq_zero_iff.2 ⟨i, 1, by rw [Units.val_one, Int.cast_one, one_mul]⟩

/-- The generic folded equation is separable away from characteristic two. -/
theorem separable_genericFoldedF [NeZero (2 : K)] : (genericFoldedF K n).Separable := by
  have hprod : genericFoldedF K n = ∏ t : Fin n × ℤˣ, (Polynomial.X -
      Polynomial.C (((t.2 : ℤ) : SymmetricRationalField K n) * foldedRoot K n t.1)) := by
    rw [genericFoldedF_eq_prod, Fintype.prod_prod_type]
    refine Finset.prod_congr rfl fun i _ => ?_
    rw [UnitsInt.univ, Finset.prod_pair (by decide)]
    simp only [Units.val_one, Units.val_neg, Int.cast_one, Int.cast_neg, one_mul, neg_mul,
      map_neg, sub_neg_eq_add]
  rw [hprod, Polynomial.separable_prod_X_sub_C_iff]
  rintro ⟨i, s⟩ ⟨j, t⟩ h
  obtain ⟨hij, hst⟩ := signedRoot_inj h
  exact Prod.ext hij hst

/-! ## The quotient equation and the field of its coefficients -/

/-- The quotient equation `∏ (Y − x_i²)` of the generic folded equation. -/
def foldedQuotientF (K : Type*) [Field K] (n : ℕ) : Polynomial (SymmetricRationalField K n) :=
  ∏ i : Fin n, (Polynomial.X - Polynomial.C (foldedRoot K n i ^ 2))

theorem genericFoldedF_eq_expand_quotient :
    genericFoldedF K n =
      Polynomial.expand (SymmetricRationalField K n) 2 (foldedQuotientF K n) :=
  genericFoldedF_eq_expand

theorem monic_foldedQuotientF : (foldedQuotientF K n).Monic :=
  Polynomial.monic_prod_of_monic _ _ fun _ _ => Polynomial.monic_X_sub_C _

theorem natDegree_foldedQuotientF : (foldedQuotientF K n).natDegree = n := by
  rw [foldedQuotientF, Polynomial.natDegree_prod_of_monic _ _ fun _ _ =>
    Polynomial.monic_X_sub_C _,
    Finset.sum_congr rfl fun i _ => Polynomial.natDegree_X_sub_C _, Finset.sum_const,
    Finset.card_univ, Fintype.card_fin, smul_eq_mul, mul_one]

/-- The folded coefficients `γ_k`: the coefficients of the quotient equation below the leading
one. -/
def foldedCoeff (K : Type*) [Field K] (n : ℕ) (k : Fin n) : SymmetricRationalField K n :=
  (foldedQuotientF K n).coeff k

theorem foldedCoeff_mem_foldedPart (k : Fin n) : foldedCoeff K n k ∈ foldedPart K n := by
  have h := coeff_genericFoldedF_mem (K := K) (n := n) ((k : ℕ) * 2)
  rw [genericFoldedF_eq_expand_quotient, Polynomial.coeff_expand_mul (by norm_num)] at h
  exact h

/-- **The generic folded equation is the folded equation of its coefficients.** -/
theorem genericFoldedF_eq_foldedEquation :
    genericFoldedF K n = foldedEquation (foldedCoeff K n) := by
  have hQ := (monic_foldedQuotientF (K := K) (n := n)).as_sum
  rw [natDegree_foldedQuotientF] at hQ
  rw [genericFoldedF_eq_expand_quotient, foldedEquation]
  conv_lhs => rw [hQ]
  rw [map_add, map_pow, Polynomial.expand_X, ← pow_mul, map_sum, Finset.sum_range]
  congr 1
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [map_mul, Polynomial.expand_C, map_pow, Polynomial.expand_X, ← pow_mul]
  rfl

/-- The field `K(γ)` generated over the constants by the folded coefficients. -/
def foldedCoeffField (K : Type*) [Field K] (n : ℕ) :
    IntermediateField K (SymmetricRationalField K n) :=
  IntermediateField.adjoin K (Set.range (foldedCoeff K n))

/-- The fixed field of the signed permutations, as an intermediate field over the constants. -/
def foldedPartField (K : Type*) [Field K] (n : ℕ) :
    IntermediateField K (SymmetricRationalField K n) where
  __ := foldedPart K n
  algebraMap_mem' := fun c => algebraMap_mem_foldedPart c

theorem mem_foldedPartField_iff {z : SymmetricRationalField K n} :
    z ∈ foldedPartField K n ↔ z ∈ foldedPart K n := Iff.rfl

theorem foldedCoeffField_le_foldedPartField : foldedCoeffField K n ≤ foldedPartField K n := by
  rw [foldedCoeffField, IntermediateField.adjoin_le_iff]
  rintro _ ⟨k, rfl⟩
  exact foldedCoeff_mem_foldedPart k

/-- Signed permutations fix the field of the folded coefficients. -/
theorem signed_smul_of_mem_foldedCoeffField (a : FibreSignedPerm (Fin n))
    {z : SymmetricRationalField K n} (hz : z ∈ foldedCoeffField K n) : a • z = z := by
  have h : z ∈ MulAction.fixedPoints (FibreSignedPerm (Fin n)) (SymmetricRationalField K n) :=
    foldedCoeffField_le_foldedPartField hz
  exact h a

/-- The folded coefficients as elements of the field they generate. -/
def foldedCoeffIn (K : Type*) [Field K] (n : ℕ) (k : Fin n) : foldedCoeffField K n :=
  ⟨foldedCoeff K n k, IntermediateField.subset_adjoin K _ ⟨k, rfl⟩⟩

/-- The generic folded equation over the field of its coefficients. -/
def genericFoldedOver (K : Type*) [Field K] (n : ℕ) : Polynomial (foldedCoeffField K n) :=
  foldedEquation (foldedCoeffIn K n)

theorem map_genericFoldedOver :
    (genericFoldedOver K n).map
        (algebraMap (foldedCoeffField K n) (SymmetricRationalField K n)) =
      genericFoldedF K n := by
  rw [genericFoldedOver, map_foldedEquation, genericFoldedF_eq_foldedEquation]
  rfl

theorem aeval_genericFoldedOver (z : SymmetricRationalField K n) :
    Polynomial.aeval z (genericFoldedOver K n) = Polynomial.eval z (genericFoldedF K n) := by
  rw [← map_genericFoldedOver, Polynomial.aeval_def, Polynomial.eval₂_eq_eval_map]

theorem genericFoldedOver_ne_zero : genericFoldedOver K n ≠ 0 := by
  intro hcon
  have h := map_genericFoldedOver (K := K) (n := n)
  rw [hcon, Polynomial.map_zero] at h
  exact (monic_genericFoldedF (K := K) (n := n)).ne_zero h.symm

private theorem algebraMap_C_eq (c : K) :
    algebraMap (MvPolynomial (Fin n) K) (SymmetricRationalField K n) (C c) =
      algebraMap (foldedCoeffField K n) (SymmetricRationalField K n)
        (algebraMap K (foldedCoeffField K n) c) := by
  rw [← IsScalarTower.algebraMap_apply K (foldedCoeffField K n) (SymmetricRationalField K n),
    IsScalarTower.algebraMap_apply K (MvPolynomial (Fin n) K) (SymmetricRationalField K n)]
  rfl

/-! ## Automorphisms over the coefficients are signed permutations -/

/-- **Every automorphism over the folded coefficients is a signed permutation of the
variables.** It carries each `x_i` to a root `± x_j`, and the signed roots are distinct. -/
theorem exists_signed_smul_eq [NeZero (2 : K)]
    (σ : SymmetricRationalField K n ≃ₐ[foldedCoeffField K n] SymmetricRationalField K n) :
    ∃ a : FibreSignedPerm (Fin n), ∀ z, σ z = a • z := by
  classical
  have hroot : ∀ i, ∃ (j : Fin n) (s : ℤˣ), σ (foldedRoot K n i) =
      ((s : ℤ) : SymmetricRationalField K n) * foldedRoot K n j := by
    intro i
    refine eval_genericFoldedF_eq_zero_iff.1 ?_
    have h := Polynomial.aeval_algHom_apply σ (foldedRoot K n i) (genericFoldedOver K n)
    rw [aeval_genericFoldedOver, aeval_genericFoldedOver, eval_foldedRoot, map_zero] at h
    exact h
  choose π ε hπ using hroot
  have hinj : Function.Injective π := by
    intro i j hij
    have h1 : σ (((ε j : ℤ) : SymmetricRationalField K n) * foldedRoot K n i) =
        σ (((ε i : ℤ) : SymmetricRationalField K n) * foldedRoot K n j) := by
      rw [map_mul, map_mul, map_intCast, map_intCast, hπ i, hπ j, hij]
      ring
    exact (signedRoot_inj (σ.injective h1)).1
  let e : Equiv.Perm (Fin n) :=
    Equiv.ofBijective π ⟨hinj, Finite.injective_iff_surjective.1 hinj⟩
  let a : FibreSignedPerm (Fin n) := ⟨e, fun x => ε (e.symm x)⟩
  have hX : ∀ i, σ (foldedRoot K n i) = a • foldedRoot K n i := by
    intro i
    rw [signed_smul_foldedRoot, hπ i]
    show _ = (((ε (e.symm (e i)) : ℤˣ) : ℤ) : SymmetricRationalField K n) *
      foldedRoot K n (e i)
    rw [Equiv.symm_apply_apply]
    rfl
  have hhom : σ.toRingEquiv.toRingHom =
      MulSemiringAction.toRingHom (FibreSignedPerm (Fin n)) (SymmetricRationalField K n) a := by
    refine IsLocalization.ringHom_ext (nonZeroDivisors (MvPolynomial (Fin n) K)) ?_
    refine MvPolynomial.ringHom_ext (fun r => ?_) (fun i => ?_)
    · show σ (algebraMap (MvPolynomial (Fin n) K) (SymmetricRationalField K n) (C r)) =
        a • algebraMap (MvPolynomial (Fin n) K) (SymmetricRationalField K n) (C r)
      rw [← algebraMap_signed_smul, signed_smul_C, algebraMap_C_eq, σ.commutes]
    · exact hX i
  exact ⟨a, fun z => RingHom.congr_fun hhom z⟩

/-- A signed permutation as an automorphism over the field of the folded coefficients. -/
def signedCoeffAut (a : FibreSignedPerm (Fin n)) :
    SymmetricRationalField K n ≃ₐ[foldedCoeffField K n] SymmetricRationalField K n :=
  AlgEquiv.ofRingEquiv
    (f := MulSemiringAction.toRingEquiv (FibreSignedPerm (Fin n)) (SymmetricRationalField K n) a)
    fun y => signed_smul_of_mem_foldedCoeffField a y.2

@[simp]
theorem signedCoeffAut_apply (a : FibreSignedPerm (Fin n)) (z : SymmetricRationalField K n) :
    signedCoeffAut a z = a • z := rfl

/-- **The group of the rational function field over the field of the folded coefficients is the
group of signed permutations.** -/
def foldedCoeffGaloisEquiv (K : Type*) [Field K] [NeZero (2 : K)] (n : ℕ) :
    FibreSignedPerm (Fin n) ≃*
      (SymmetricRationalField K n ≃ₐ[foldedCoeffField K n] SymmetricRationalField K n) :=
  MulEquiv.ofBijective
    ({ toFun := signedCoeffAut
       map_one' := AlgEquiv.ext fun z => one_smul (FibreSignedPerm (Fin n)) z
       map_mul' := fun a b => AlgEquiv.ext fun z => mul_smul a b z } :
      FibreSignedPerm (Fin n) →*
        (SymmetricRationalField K n ≃ₐ[foldedCoeffField K n] SymmetricRationalField K n))
    ⟨fun a b h => FaithfulSMul.eq_of_smul_eq_smul fun z : SymmetricRationalField K n =>
        DFunLike.congr_fun h z,
      fun σ => by
        obtain ⟨a, ha⟩ := exists_signed_smul_eq σ
        exact ⟨a, AlgEquiv.ext fun z => (ha z).symm⟩⟩

@[simp]
theorem foldedCoeffGaloisEquiv_apply (K : Type*) [Field K] [NeZero (2 : K)] (n : ℕ)
    (a : FibreSignedPerm (Fin n)) (z : SymmetricRationalField K n) :
    foldedCoeffGaloisEquiv K n a z = a • z := rfl

/-! ## The splitting field over the coefficients -/

theorem splits_genericFoldedOver :
    ((genericFoldedOver K n).map
      (algebraMap (foldedCoeffField K n) (SymmetricRationalField K n))).Splits := by
  rw [map_genericFoldedOver, genericFoldedF_eq_prod]
  exact Polynomial.Splits.prod fun _ _ =>
    (Polynomial.Splits.X_sub_C _).mul (Polynomial.Splits.X_add_C _)

theorem map_genericFoldedOver_ne_zero :
    (genericFoldedOver K n).map
      (algebraMap (foldedCoeffField K n) (SymmetricRationalField K n)) ≠ 0 := by
  rw [map_genericFoldedOver]
  exact (monic_genericFoldedF (K := K) (n := n)).ne_zero

theorem foldedRoot_mem_rootSet_over (i : Fin n) :
    foldedRoot K n i ∈ (genericFoldedOver K n).rootSet (SymmetricRationalField K n) := by
  rw [Polynomial.mem_rootSet', aeval_genericFoldedOver]
  exact ⟨map_genericFoldedOver_ne_zero, eval_foldedRoot i⟩

/-- **The roots generate the rational function field over the folded coefficients.** The roots are
algebraic, so the algebra they generate is a field; it contains the variables and the constants. -/
theorem adjoin_rootSet_genericFoldedOver :
    Algebra.adjoin (foldedCoeffField K n)
      ((genericFoldedOver K n).rootSet (SymmetricRationalField K n)) = ⊤ := by
  have halg : ∀ x ∈ (genericFoldedOver K n).rootSet (SymmetricRationalField K n),
      IsAlgebraic (foldedCoeffField K n) x := by
    intro x hx
    rw [Polynomial.mem_rootSet'] at hx
    exact ⟨genericFoldedOver K n, genericFoldedOver_ne_zero, hx.2⟩
  have htop : IntermediateField.adjoin (foldedCoeffField K n)
      ((genericFoldedOver K n).rootSet (SymmetricRationalField K n)) = ⊤ := by
    refine eq_top_iff.2 fun z _ => ?_
    have hpoly : ∀ p : MvPolynomial (Fin n) K,
        algebraMap (MvPolynomial (Fin n) K) (SymmetricRationalField K n) p ∈
          IntermediateField.adjoin (foldedCoeffField K n)
            ((genericFoldedOver K n).rootSet (SymmetricRationalField K n)) := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C c =>
          rw [algebraMap_C_eq]
          exact IntermediateField.algebraMap_mem _ _
      | add p q hp hq =>
          rw [map_add]
          exact add_mem hp hq
      | mul_X p i hp =>
          rw [map_mul]
          exact mul_mem hp (IntermediateField.subset_adjoin _ _ (foldedRoot_mem_rootSet_over i))
    obtain ⟨p, q, -, hz⟩ := IsFractionRing.div_surjective
      (A := MvPolynomial (Fin n) K) (K := SymmetricRationalField K n) z
    rw [← hz]
    exact div_mem (hpoly p) (hpoly q)
  rw [← IntermediateField.adjoin_toSubalgebra_of_isAlgebraic halg, htop,
    IntermediateField.top_toSubalgebra]

instance isSplittingField_genericFoldedOver (K : Type*) [Field K] (n : ℕ) :
    Polynomial.IsSplittingField (foldedCoeffField K n) (SymmetricRationalField K n)
      (genericFoldedOver K n) :=
  ⟨splits_genericFoldedOver, adjoin_rootSet_genericFoldedOver⟩

theorem separable_genericFoldedOver [NeZero (2 : K)] : (genericFoldedOver K n).Separable := by
  rw [← Polynomial.separable_map
    (algebraMap (foldedCoeffField K n) (SymmetricRationalField K n)), map_genericFoldedOver]
  exact separable_genericFoldedF

theorem isGalois_foldedCoeffField (K : Type*) [Field K] [NeZero (2 : K)] (n : ℕ) :
    IsGalois (foldedCoeffField K n) (SymmetricRationalField K n) :=
  IsGalois.of_separable_splitting_field (p := genericFoldedOver K n) separable_genericFoldedOver

/-! ## The fundamental theorem -/

/-- **The fundamental theorem for signed permutations.** A rational function invariant under all
signed permutations of the variables is a rational function of the folded coefficients: it is fixed
by the whole Galois group over `K(γ)`. -/
theorem foldedPartField_eq_foldedCoeffField (K : Type*) [Field K] [NeZero (2 : K)] (n : ℕ) :
    foldedPartField K n = foldedCoeffField K n := by
  refine le_antisymm (fun z hz => ?_) foldedCoeffField_le_foldedPartField
  haveI := isGalois_foldedCoeffField K n
  haveI : FiniteDimensional (foldedCoeffField K n) (SymmetricRationalField K n) :=
    Polynomial.IsSplittingField.finiteDimensional _ (genericFoldedOver K n)
  have hz' : z ∈ MulAction.fixedPoints (FibreSignedPerm (Fin n))
      (SymmetricRationalField K n) := hz
  have hfix : ∀ σ : SymmetricRationalField K n ≃ₐ[foldedCoeffField K n]
      SymmetricRationalField K n, σ z = z := by
    intro σ
    obtain ⟨a, ha⟩ := exists_signed_smul_eq σ
    rw [ha]
    exact hz' a
  obtain ⟨y, hy⟩ := (IsGalois.mem_range_algebraMap_iff_fixed z).2 hfix
  rw [← hy]
  exact y.2

/-- The rational function field has degree `2ⁿ n!` over the field of the folded coefficients. -/
theorem finrank_foldedCoeffField (K : Type*) [Field K] [NeZero (2 : K)] (n : ℕ) :
    Module.finrank (foldedCoeffField K n) (SymmetricRationalField K n) =
      n.factorial * 2 ^ n := by
  haveI := isGalois_foldedCoeffField K n
  haveI : FiniteDimensional (foldedCoeffField K n) (SymmetricRationalField K n) :=
    Polynomial.IsSplittingField.finiteDimensional _ (genericFoldedOver K n)
  rw [← IsGalois.card_aut_eq_finrank, ← Nat.card_congr (foldedCoeffGaloisEquiv K n).toEquiv,
    natCard]

end

end GaloisForLFunctions.GaloisTheoryOfZeros
