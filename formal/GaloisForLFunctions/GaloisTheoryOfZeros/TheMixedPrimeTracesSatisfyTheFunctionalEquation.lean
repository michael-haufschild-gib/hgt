import GaloisForLFunctions.GaloisTheoryOfZeros.ThePrimeTraceGaloisGroupOfTheZeros

/-!
# The mixed prime traces satisfy the functional equation

The prime trace field `B` is generated by the mixed traces
`T_t(m) = Σ n_m^ρ` over the zeros `ρ` (with multiplicity) of ordinate `±t`, where `m` is an integer
prime vector and `n_m = ∏ p^{m_p}` the positive rational number it encodes. The functional equation
`ρ ↦ 1 − ρ` exchanges the fibres at `t` and `−t`, which gives relations among the generators.

* **Functional equation** (`primeDivisorTrace_reflect`). `T_t(m) = n_m · T_t(−m)`, i.e.
  `T_t(n) = n · T_t(1/n)`.
* **Evenness** (`primeDivisorTrace_neg`). `T_{−t}(m) = T_t(m)`.
* **Count** (`primeDivisorTrace_zero`). `T_t(0)` is the number of zeros of ordinate `±t`, twice
  the number of zeros of ordinate `t`.
* **Rational weights** (`primeRelationValue_one_rational`). `n_m` is a positive rational number.
* **Half the generators** (`primeTraceField_eq_closure_half`). `B` is generated by the traces
  with `t ≥ 0` and `n_m ≥ 1`.
-/

noncomputable section
set_option autoImplicit false
open Complex Set RHTower
open scoped BigOperators
namespace GaloisForLFunctions.GaloisTheoryOfZeros

/-! ## Reflection of the copies -/

/-- The functional equation carries the copies of ordinate `t` to those of ordinate `s = −t`. -/
def ordinateFibreReflect {s t : ℝ} (h : s = -t) :
    ↥(ordinateFibreCopies t) ≃ ↥(ordinateFibreCopies s) :=
  xiZeroCopyReflectEquiv.subtypeEquiv fun q => by
    rw [mem_ordinateFibreCopies, mem_ordinateFibreCopies, xiSpectralPoint_reflect,
      Complex.neg_re, h, neg_inj]

/-- The functional equation on the copies of ordinate `±t`. -/
def primeTraceReflectEquiv (t : ℝ) : PrimeTraceCopies t ≃ PrimeTraceCopies t :=
  (Equiv.sumCongr (ordinateFibreReflect rfl) (ordinateFibreReflect (neg_neg t).symm)).trans
    (Equiv.sumComm _ _)

theorem primeTraceCopy_reflect (t : ℝ) (i : PrimeTraceCopies t) :
    ((primeTraceCopy t (primeTraceReflectEquiv t i)).1 : ℂ) =
      1 - ((primeTraceCopy t i).1 : ℂ) := by
  cases i <;> rfl

/-! ## The relations -/

/-- **Functional equation of the traces.** `T_t(m) = n_m · T_t(−m)`, `n_m = e^{Σ m_p log p}`. -/
theorem primeDivisorTrace_reflect (t : ℝ) (m : Nat.Primes →₀ ℤ) :
    primeDivisorTrace t m = primeRelationValue 1 m * primeDivisorTrace t (-m) := by
  unfold primeDivisorTrace
  rw [Finset.mul_sum]
  refine ((primeTraceReflectEquiv t).sum_comp _).symm.trans (Finset.sum_congr rfl fun i _ => ?_)
  rw [primeTraceCopy_reflect]
  simp only [primeRelationValue, map_neg, Complex.ofReal_neg, ← Complex.exp_add]
  congr 1
  ring

/-- **Evenness.** The traces at `t` and `−t` agree. -/
theorem primeDivisorTrace_neg (t : ℝ) (m : Nat.Primes →₀ ℤ) :
    primeDivisorTrace (-t) m = primeDivisorTrace t m := by
  have key : ∀ s : ℝ, s = t → (∑ x : ↥(ordinateFibreCopies s),
      primeRelationValue ((x : XiZeroCopy).1 : ℂ) m) =
      ∑ x : ↥(ordinateFibreCopies t), primeRelationValue ((x : XiZeroCopy).1 : ℂ) m := by
    rintro s rfl
    rfl
  simp only [primeDivisorTrace, Fintype.sum_sum_type, primeTraceCopy]
  rw [key (-(-t)) (neg_neg t), add_comm]

/-- **Count.** `T_t(0)` is the number of copies of ordinate `±t`. -/
theorem primeDivisorTrace_zero (t : ℝ) :
    primeDivisorTrace t 0 = Fintype.card (PrimeTraceCopies t) := by
  simp [primeDivisorTrace, primeRelationValue_zero]

/-- The two fibres have the same number of copies, so `T_t(0)` is even. -/
theorem card_primeTraceCopies (t : ℝ) :
    Fintype.card (PrimeTraceCopies t) = 2 * Fintype.card ↥(ordinateFibreCopies t) := by
  rw [Fintype.card_sum, ← Fintype.card_congr (ordinateFibreReflect (s := -t) rfl), two_mul]

/-- **Rational weights.** `n_m = e^{Σ m_p log p}` is a positive rational number. -/
theorem primeRelationValue_one_rational (m : Nat.Primes →₀ ℤ) :
    ∃ r : ℚ, 0 < r ∧ primeRelationValue 1 m = (r : ℂ) := by
  induction m using Finsupp.induction_linear with
  | zero => exact ⟨1, one_pos, by rw [primeRelationValue_zero, Rat.cast_one]⟩
  | add m n hm hn =>
    obtain ⟨r, hr, hm⟩ := hm
    obtain ⟨s, hs, hn⟩ := hn
    exact ⟨r * s, mul_pos hr hs, by rw [primeRelationValue_add, hm, hn, Rat.cast_mul]⟩
  | single p n =>
    have hp : (0 : ℚ) < (p : ℕ) := by exact_mod_cast p.2.pos
    refine ⟨((p : ℕ) : ℚ) ^ n, zpow_pos hp n, ?_⟩
    rw [primeRelationValue_single, one_mul, Rat.cast_zpow, Rat.cast_natCast,
      ← Complex.ofReal_exp, Real.exp_log (by exact_mod_cast p.2.pos), Complex.ofReal_natCast]

/-! ## Half the generators -/

/-- **Half the generators.** `B` is generated by the traces at heights `t ≥ 0` and prime vectors
with `n_m ≥ 1`. -/
theorem primeTraceField_eq_closure_half :
    primeTraceField = Subfield.closure {x | ∃ t : ℝ, ∃ m : Nat.Primes →₀ ℤ, 0 ≤ t ∧
      0 ≤ primeRelationFrequency m ∧ x = primeDivisorTrace t m} := by
  apply le_antisymm
  · unfold primeTraceField
    apply Subfield.closure_le.2
    rintro x ⟨⟨t, m⟩, rfl⟩
    -- reduce to `t ≥ 0`
    obtain ⟨t', ht', he⟩ : ∃ t' : ℝ, 0 ≤ t' ∧ primeDivisorTrace t m = primeDivisorTrace t' m := by
      rcases le_total 0 t with h | h
      · exact ⟨t, h, rfl⟩
      · exact ⟨-t, neg_nonneg.2 h, (primeDivisorTrace_neg t m).symm⟩
    change primeDivisorTrace t m ∈ _
    rw [he]
    rcases le_total 0 (primeRelationFrequency m) with h | h
    · exact Subfield.subset_closure ⟨t', m, ht', h, rfl⟩
    · obtain ⟨r, -, hr⟩ := primeRelationValue_one_rational m
      rw [primeDivisorTrace_reflect, hr]
      refine Subfield.mul_mem _ (SubfieldClass.ratCast_mem _ r) (Subfield.subset_closure ?_)
      exact ⟨t', -m, ht', by rw [map_neg]; exact neg_nonneg.2 h, rfl⟩
  · apply Subfield.closure_le.2
    rintro x ⟨t, m, -, -, rfl⟩
    exact primeDivisorTrace_mem t m

end GaloisForLFunctions.GaloisTheoryOfZeros
