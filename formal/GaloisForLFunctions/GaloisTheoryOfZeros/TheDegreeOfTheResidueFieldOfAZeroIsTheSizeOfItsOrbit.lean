import GaloisForLFunctions.GaloisTheoryOfZeros.TheOrbitOfAZeroIsItsConjugatePairIffItsWeightLiesInThePrimeTraceField

/-!
# The degree of the residue field of a zero is the size of its orbit

`E` is the field of the prime values `p^ρ` of the zeros, `B` the prime trace field,
`G = Gal(E/B)` acting on the zeros, and `F_ρ = B(p^ρ : p prime)` the residue field of a zero.

* **Stabilizer** (`primeResidueField_stabilizer`). The stabilizer of `ρ` is `Gal(E/F_ρ)`.
* **Orbit and degree** (`finrank_primeResidueField`). `[F_ρ : B] = |G·ρ|`. `F_ρ = B(2^ρ, 3^ρ)` is
  finite over `B`, so every orbit is finite.
* **Even degree** (`even_finrank_primeResidueField`). Conjugation keeps every orbit and moves
  every zero, so `[F_ρ : B]` is even.
* **Degree two** (`finrank_primeResidueField_eq_two_iff`). `[F_ρ : B] = 2` iff `p^{2 Re ρ} ∈ B`,
  for any one prime `p`; in particular at every zero with rational real part.

Proof. Infinite Galois theory: `[F : B]` is the index of `Gal(E/F)`; the index of a stabilizer is
the size of the orbit. The orbit is the union of its zeros in the upper half-plane and their
conjugates.
-/

noncomputable section
set_option autoImplicit false
open Complex Set RHTower
open scoped BigOperators
namespace GaloisForLFunctions.GaloisTheoryOfZeros

local notation "B" => primeTraceField
local notation "E" => primeTraceExtension
local notation "G" => (E ≃ₐ[B] E)
local instance : IsGalois B E := ⟨⟩

/-- The arithmetic group acts on the zeros. -/
instance primeTraceMulAction : MulAction G XiDivisorSupport :=
  MulAction.compHom XiDivisorSupport primeTraceGaloisAction

theorem primeTrace_smul_def (σ : G) (ρ : XiDivisorSupport) : σ • ρ = primeTraceZeroMap σ ρ :=
  rfl

/-! ## Stabilizers and degrees -/

/-- The stabilizer of a zero is the group of its residue field. -/
theorem primeResidueField_stabilizer (ρ : XiDivisorSupport) :
    MulAction.stabilizer G ρ = (primeResidueField ρ).fixingSubgroup := by
  ext σ
  rw [MulAction.mem_stabilizer_iff, primeResidueField_fixing]
  exact Iff.rfl

/-- **Orbit and degree.** The degree of the residue field over `B` is the size of the orbit. -/
theorem finrank_primeResidueField (ρ : XiDivisorSupport) :
    Module.finrank B (primeResidueField ρ) = (MulAction.orbit G ρ).ncard := by
  rw [IntermediateField.finrank_eq_fixingSubgroup_index, ← primeResidueField_stabilizer,
    MulAction.index_stabilizer]

/-- The residue field is generated by the two prime values `2^ρ, 3^ρ`, algebraic over `B`. -/
instance primeResidueField_finiteDimensional (ρ : XiDivisorSupport) :
    FiniteDimensional B (primeResidueField ρ) := by
  rw [primeResidueField_two_generators ⟨2, Nat.prime_two⟩ ⟨3, Nat.prime_three⟩ (by decide) ρ]
  exact IntermediateField.finiteDimensional_adjoin_pair (Algebra.IsSeparable.isIntegral B _)
    (Algebra.IsSeparable.isIntegral B _)

/-- Every orbit is finite. -/
theorem primeTraceOrbit_finite (ρ : XiDivisorSupport) : (MulAction.orbit G ρ).Finite :=
  Set.finite_of_ncard_pos (by rw [← finrank_primeResidueField]; exact Module.finrank_pos)

theorem primeTraceZeroMap_range_finite (ρ : XiDivisorSupport) :
    (Set.range fun σ : G => primeTraceZeroMap σ ρ).Finite :=
  primeTraceOrbit_finite ρ

/-! ## Conjugation and the parity of the degree -/

theorem xiZeroConjEquiv_conj (x : XiDivisorSupport) : xiZeroConjEquiv (xiZeroConjEquiv x) = x :=
  Subtype.ext (Complex.conj_conj (x : ℂ))

/-- Conjugation keeps every orbit. -/
theorem xiZeroConjEquiv_mem_orbit {ρ x : XiDivisorSupport} (hx : x ∈ MulAction.orbit G ρ) :
    xiZeroConjEquiv x ∈ MulAction.orbit G ρ := by
  obtain ⟨σ, rfl⟩ := hx
  refine ⟨primeTraceConjugation * σ, ?_⟩
  change primeTraceZeroMap (primeTraceConjugation * σ) ρ = xiZeroConjEquiv (primeTraceZeroMap σ ρ)
  rw [primeTraceZeroMap_mul, primeTraceZeroMap_conjugation]

/-- **Even degree.** The orbit is the disjoint union of its zeros in the upper half-plane and
their conjugates. -/
theorem even_finrank_primeResidueField (ρ : XiDivisorSupport) :
    Even (Module.finrank B (primeResidueField ρ)) := by
  rw [finrank_primeResidueField]
  let U : Set XiDivisorSupport := {x | x ∈ MulAction.orbit G ρ ∧ 0 < (x : ℂ).im}
  have hsplit : MulAction.orbit G ρ = U ∪ xiZeroConjEquiv '' U := by
    ext x
    constructor
    · intro hx
      rcases lt_or_gt_of_ne (xi_divisor_support_im_ne_zero x) with h | h
      · refine Or.inr ⟨xiZeroConjEquiv x, ⟨xiZeroConjEquiv_mem_orbit hx, ?_⟩,
          xiZeroConjEquiv_conj x⟩
        change 0 < (starRingEnd ℂ (x : ℂ)).im
        rw [Complex.conj_im]
        linarith only [h]
      · exact Or.inl ⟨hx, h⟩
    · rintro (⟨hx, -⟩ | ⟨y, ⟨hy, -⟩, rfl⟩)
      · exact hx
      · exact xiZeroConjEquiv_mem_orbit hy
  have hdisj : Disjoint U (xiZeroConjEquiv '' U) := by
    rw [Set.disjoint_left]
    rintro x ⟨-, hx⟩ ⟨y, ⟨-, hy⟩, rfl⟩
    change 0 < (starRingEnd ℂ (y : ℂ)).im at hx
    rw [Complex.conj_im] at hx
    linarith only [hx, hy]
  have hU : U.Finite := (primeTraceOrbit_finite ρ).subset fun x hx => hx.1
  rw [hsplit, Set.ncard_union_eq hdisj hU (hU.image _),
    Set.ncard_image_of_injective _ xiZeroConjEquiv.injective]
  exact ⟨_, rfl⟩

/-! ## Degree two -/

/-- **Degree two.** For any one prime `p`: `[F_ρ : B] = 2` iff `p^{2 Re ρ} ∈ B`. -/
theorem finrank_primeResidueField_eq_two_iff (p : Nat.Primes) (ρ : XiDivisorSupport) :
    Module.finrank B (primeResidueField ρ) = 2 ↔ (primeWeightValue p ρ : ℂ) ∈ B := by
  rw [finrank_primeResidueField, primeWeightValue_mem_iff_orbit p ρ]
  have hne : ρ ≠ xiZeroConjEquiv ρ := by
    intro e
    have hi := congrArg (fun z : XiDivisorSupport => (z : ℂ).im) e
    change (ρ : ℂ).im = (starRingEnd ℂ (ρ : ℂ)).im at hi
    rw [Complex.conj_im] at hi
    exact xi_divisor_support_im_ne_zero ρ (by linarith only [hi])
  have hsub : ({ρ, xiZeroConjEquiv ρ} : Set XiDivisorSupport) ⊆ MulAction.orbit G ρ := by
    rintro x (rfl | rfl)
    · exact MulAction.mem_orbit_self x
    · exact xiZeroConjEquiv_mem_orbit (MulAction.mem_orbit_self ρ)
  constructor
  · intro h σ
    have heq : ({ρ, xiZeroConjEquiv ρ} : Set XiDivisorSupport) = MulAction.orbit G ρ :=
      Set.eq_of_subset_of_ncard_le hsub (le_of_eq (by rw [h, Set.ncard_pair hne]))
        (primeTraceOrbit_finite ρ)
    have hm : primeTraceZeroMap σ ρ ∈ MulAction.orbit G ρ := ⟨σ, rfl⟩
    rw [← heq] at hm
    exact hm
  · intro h
    have heq : MulAction.orbit G ρ = {ρ, xiZeroConjEquiv ρ} := by
      refine le_antisymm ?_ hsub
      rintro x ⟨σ, rfl⟩
      exact h σ
    rw [heq, Set.ncard_pair hne]

/-- A zero with rational real part, in particular a zero on the critical line, has a residue
field of degree two over `B`. -/
theorem finrank_primeResidueField_of_rational (ρ : XiDivisorSupport)
    (hr : ∃ r : ℚ, (ρ : ℂ).re = (r : ℝ)) : Module.finrank B (primeResidueField ρ) = 2 :=
  (finrank_primeResidueField_eq_two_iff ⟨2, Nat.prime_two⟩ ρ).2
    (primeWeightValue_mem_of_rational _ ρ hr)

end GaloisForLFunctions.GaloisTheoryOfZeros
