import GaloisForLFunctions.GaloisTheoryOfZeros.TheRationalWeightsOfPrimeZeroOrbits
import GaloisForLFunctions.HTGeometry.QuadraticRootConjugation
import GaloisForLFunctions.RHTower.XiRightDiscAdjointSeamSupremum

/-!
# The even-product field of all original centered zeros

Over the rationals, the field of every centered zero is generated over its
full even-product field by any single centered zero. The degree is at most
two. Functional reflection lifts to a rational field automorphism exactly
when this quadratic step has not collapsed; its lift is unique and fixes
precisely the even-product field.

Ordinary conjugation preserves both fields. An existing critical zero gives
a nonzero imaginary anchor, proving that reality of the even-product field
is equivalent to critical-line purity. The ground field here is defined from
zero products; no prime-source description or purity assumption is supplied.
-/

noncomputable section
set_option autoImplicit false
open Complex Polynomial Set RHTower
open scoped IntermediateField
namespace GaloisForLFunctions.GaloisTheoryOfZeros

/-- The original zero coordinate centered at the functional-equation midpoint. -/
def centeredZeroCoordinate (ρ : XiDivisorSupport) : ℂ := (ρ : ℂ)-1/2

private theorem centered_coordinate_im (ρ : XiDivisorSupport) :
    (centeredZeroCoordinate ρ).im=(ρ : ℂ).im := by
  simp [centeredZeroCoordinate]

private theorem centered_coordinate_ne_zero (ρ : XiDivisorSupport) : centeredZeroCoordinate ρ ≠ 0 := by
  intro h
  have hi := congrArg Complex.im h
  rw [centered_coordinate_im,Complex.zero_im] at hi
  exact xi_divisor_support_im_ne_zero ρ hi

private theorem centered_coordinate_conj (ρ : XiDivisorSupport) :
    centeredZeroCoordinate (xiZeroConjEquiv ρ)=starRingEnd ℂ (centeredZeroCoordinate ρ) := by
  change starRingEnd ℂ (ρ : ℂ)-(1/2 : ℂ)=starRingEnd ℂ ((ρ : ℂ)-(1/2 : ℂ))
  rw [map_sub,map_div₀,map_one,map_ofNat]

/-- The field over the rationals generated by all original centered zeros. -/
def centeredZeroField : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ (Set.range centeredZeroCoordinate)

/-- The field generated by every product of two actual centered zeros. -/
def centeredEvenProductField : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ (Set.range fun q : XiDivisorSupport × XiDivisorSupport =>
    centeredZeroCoordinate q.1*centeredZeroCoordinate q.2)

local notation "K" => centeredEvenProductField

theorem centeredZeroCoordinate_mem (ρ : XiDivisorSupport) : centeredZeroCoordinate ρ ∈ centeredZeroField :=
  IntermediateField.subset_adjoin ℚ _ ⟨ρ,rfl⟩

theorem centeredProduct_mem (ρ τ : XiDivisorSupport) :
    centeredZeroCoordinate ρ*centeredZeroCoordinate τ ∈ K :=
  IntermediateField.subset_adjoin ℚ _ ⟨(ρ,τ),rfl⟩

theorem centeredEvenProductField_le : K ≤ centeredZeroField := by
  apply IntermediateField.adjoin_le_iff.mpr
  rintro x ⟨⟨ρ,τ⟩,rfl⟩
  exact centeredZeroField.mul_mem (centeredZeroCoordinate_mem ρ) (centeredZeroCoordinate_mem τ)

/-- The complete centered-zero field viewed over its actual even-product subfield. -/
def centeredZeroExtension : IntermediateField K ℂ :=
  IntermediateField.extendScalars centeredEvenProductField_le

local notation "L" => centeredZeroExtension

/-- Each actual centered zero in the full extension. -/
def centeredZeroValue (ρ : XiDivisorSupport) : L := ⟨centeredZeroCoordinate ρ,centeredZeroCoordinate_mem ρ⟩

/-- Any centered zero generates the full extension over all even products. -/
theorem centeredZeroExtension_eq_adjoin (ρ : XiDivisorSupport) :
    L=IntermediateField.adjoin K {centeredZeroCoordinate ρ} := by
  let A := IntermediateField.adjoin K {centeredZeroCoordinate ρ}
  have hle : centeredZeroField ≤ A.restrictScalars ℚ := by
    apply IntermediateField.adjoin_le_iff.mpr
    rintro x ⟨τ,rfl⟩
    have hp : centeredZeroCoordinate τ*centeredZeroCoordinate ρ ∈ A :=
      A.algebraMap_mem ⟨_,centeredProduct_mem τ ρ⟩
    have ha : centeredZeroCoordinate ρ ∈ A := IntermediateField.mem_adjoin_simple_self K _
    have he : centeredZeroCoordinate τ =
        (centeredZeroCoordinate τ*centeredZeroCoordinate ρ)/centeredZeroCoordinate ρ :=
      (mul_div_cancel_right₀ _ (centered_coordinate_ne_zero ρ)).symm
    rw [he]
    exact A.div_mem hp ha
  apply le_antisymm
  · exact fun x hx => hle hx
  · exact IntermediateField.adjoin_simple_le_iff.mpr (centeredZeroCoordinate_mem ρ)

/-- The same generator equality in the original rational-coordinate field. -/
theorem centeredZeroField_eq_even_adjoin (ρ : XiDivisorSupport) :
    centeredZeroField=(IntermediateField.adjoin K {centeredZeroCoordinate ρ}).restrictScalars ℚ := by
  have h := congrArg (IntermediateField.restrictScalars ℚ) (centeredZeroExtension_eq_adjoin ρ)
  exact h

private def centeredSquare (ρ : XiDivisorSupport) : K :=
  ⟨centeredZeroCoordinate ρ*centeredZeroCoordinate ρ,centeredProduct_mem ρ ρ⟩

private theorem centered_square_value (ρ : XiDivisorSupport) :
    centeredZeroCoordinate ρ*centeredZeroCoordinate ρ=algebraMap K ℂ (centeredSquare ρ) := rfl

private theorem centered_mem_bot_iff (ρ : XiDivisorSupport) :
    centeredZeroCoordinate ρ ∈ (⊥ : IntermediateField K ℂ) ↔ centeredZeroCoordinate ρ ∈ K := by
  rw [IntermediateField.mem_bot]
  exact ⟨fun ⟨a,ha⟩ => ha ▸ a.property,fun h => ⟨⟨_,h⟩,rfl⟩⟩

instance centeredZeroExtension_finite : FiniteDimensional K L := by
  obtain ⟨z,hz⟩ := xiDivisorSupport_infinite.nonempty
  let ρ : XiDivisorSupport := ⟨z,hz⟩
  rw [centeredZeroExtension_eq_adjoin ρ]
  exact IntermediateField.adjoin.finiteDimensional
    (HTGeometry.isIntegral_of_sq_mem_bot (centered_square_value ρ))

/-- The entire centered-zero extension has degree at most two over its even products. -/
theorem centeredZeroExtension_degree_le_two : Module.finrank K L ≤ 2 := by
  obtain ⟨z,hz⟩ := xiDivisorSupport_infinite.nonempty
  let ρ : XiDivisorSupport := ⟨z,hz⟩
  rw [centeredZeroExtension_eq_adjoin ρ,IntermediateField.adjoin.finrank
    (HTGeometry.isIntegral_of_sq_mem_bot (centered_square_value ρ))]
  have hd : minpoly K (centeredZeroCoordinate ρ) ∣ X^2-C (centeredSquare ρ) := by
    apply minpoly.dvd
    rw [map_sub,map_pow,Polynomial.aeval_X,Polynomial.aeval_C,pow_two,centered_square_value,sub_self]
  have hm := Polynomial.monic_X_pow_sub_C (centeredSquare ρ) (by decide : (2 : ℕ) ≠ 0)
  have h := Polynomial.natDegree_le_of_dvd hd hm.ne_zero
  simpa only [Polynomial.natDegree_sub_C,Polynomial.natDegree_X_pow] using h

/-- The quadratic alternative occurs exactly when one, hence every, centered zero is outside the even field. -/
theorem centeredZeroExtension_degree_two_iff (ρ : XiDivisorSupport) :
    Module.finrank K L=2 ↔ centeredZeroCoordinate ρ ∉ K := by
  constructor
  · intro hd hm
    have he : IntermediateField.adjoin K {centeredZeroCoordinate ρ} = ⊥ := by
      apply le_antisymm _ bot_le
      exact IntermediateField.adjoin_simple_le_iff.mpr ((centered_mem_bot_iff ρ).mpr hm)
    have h1 : Module.finrank K L=1 := by
      apply IntermediateField.finrank_eq_one_iff.mpr
      rw [centeredZeroExtension_eq_adjoin ρ,he]
    omega
  · intro hn
    rw [centeredZeroExtension_eq_adjoin ρ]
    exact HTGeometry.finrank_adjoin_eq_two (centered_square_value ρ)
      (fun hm => hn ((centered_mem_bot_iff ρ).mp hm))

private theorem centered_square_not_square (ρ : XiDivisorSupport)
    (hρ : centeredZeroCoordinate ρ ∉ K) : ¬ IsSquare (centeredSquare ρ) := by
  rintro ⟨a,ha⟩
  have hs : centeredZeroCoordinate ρ ^ 2=(a : ℂ)^2 := by
    have he := congrArg (fun b : K => (b : ℂ)) ha
    change centeredZeroCoordinate ρ*centeredZeroCoordinate ρ=(a : ℂ)*(a : ℂ) at he
    simpa only [pow_two] using he
  rcases sq_eq_sq_iff_eq_or_eq_neg.mp hs with h | h
  · apply hρ
    rw [h]
    exact a.property
  · apply hρ
    rw [h]
    exact (K).neg_mem a.property

/-- The quadratic reflection on the actual centered-zero field whenever its anchor lies outside the even field. -/
def centeredQuadraticReflection (ρ : XiDivisorSupport) (hρ : centeredZeroCoordinate ρ ∉ K) : L ≃ₐ[K] L :=
  let e := IntermediateField.equivOfEq (centeredZeroExtension_eq_adjoin ρ)
  e.trans ((HTGeometry.quadraticRootConjugation (centered_square_value ρ)
    (centered_square_not_square ρ hρ)).trans e.symm)

private theorem centered_reflection_anchor (ρ : XiDivisorSupport) (hρ : centeredZeroCoordinate ρ ∉ K) :
    centeredQuadraticReflection ρ hρ (centeredZeroValue ρ) = -centeredZeroValue ρ := by
  change (IntermediateField.equivOfEq (centeredZeroExtension_eq_adjoin ρ)).symm
    (HTGeometry.quadraticRootConjugation (centered_square_value ρ) (centered_square_not_square ρ hρ)
      ⟨centeredZeroCoordinate ρ,IntermediateField.mem_adjoin_simple_self K _⟩) = _
  rw [HTGeometry.quadraticRootConjugation_gen]
  rfl

/-- Negation of the centered coordinate is the actual functional-equation reflection. -/
theorem centeredZeroValue_reflection (ρ : XiDivisorSupport) :
    centeredZeroValue (xiZeroReflectEquiv ρ) = -centeredZeroValue ρ := by
  apply Subtype.ext
  change (1-(ρ : ℂ))-1/2 = -((ρ : ℂ)-1/2)
  ring

private theorem centered_value_ratio (ρ τ : XiDivisorSupport) :
    centeredZeroValue τ =
      algebraMap K L (⟨centeredZeroCoordinate τ*centeredZeroCoordinate ρ,centeredProduct_mem τ ρ⟩ : K)/
        centeredZeroValue ρ := by
  apply Subtype.ext
  exact (mul_div_cancel_right₀ _ (centered_coordinate_ne_zero ρ)).symm

/-- The quadratic automorphism is the functional-equation reflection on every actual zero. -/
theorem centeredQuadraticReflection_all (ρ : XiDivisorSupport) (hρ : centeredZeroCoordinate ρ ∉ K)
    (τ : XiDivisorSupport) : centeredQuadraticReflection ρ hρ (centeredZeroValue τ) = -centeredZeroValue τ := by
  rw [centered_value_ratio ρ τ,map_div₀,(centeredQuadraticReflection ρ hρ).commutes,
    centered_reflection_anchor,div_neg]

private theorem centered_negation_fixes_even (σ : L ≃ₐ[ℚ] L)
    (hσ : ∀ τ : XiDivisorSupport, σ (centeredZeroValue τ) = -centeredZeroValue τ) :
    ∀ a : K, σ (algebraMap K L a)=algebraMap K L a := by
  have hext := IntermediateField.algHom_ext_of_eq_adjoin ℚ (S := K) rfl
    (φ₁ := σ.toAlgHom.comp (IsScalarTower.toAlgHom ℚ K L))
    (φ₂ := IsScalarTower.toAlgHom ℚ K L)
    (by
      rintro x ⟨⟨ρ,τ⟩,rfl⟩
      change σ (centeredZeroValue ρ*centeredZeroValue τ)=centeredZeroValue ρ*centeredZeroValue τ
      rw [map_mul,hσ,hσ,neg_mul_neg])
  intro a
  exact DFunLike.congr_fun hext a

private theorem centered_element_repr (ρ : XiDivisorSupport) (z : L) :
    ∃ a b : K, z=algebraMap K L a+algebraMap K L b*centeredZeroValue ρ := by
  have hz : (z : ℂ) ∈ IntermediateField.adjoin K {centeredZeroCoordinate ρ} := by
    rw [← centeredZeroExtension_eq_adjoin ρ]
    exact z.property
  obtain ⟨a,b,he⟩ := HTGeometry.exists_repr_of_mem_adjoin_sqrt (centered_square_value ρ) hz
  exact ⟨a,b,Subtype.ext he⟩

/-- Any field automorphism realizing functional reflection fixes exactly the even-product field. -/
theorem centeredNegation_fixed_iff (σ : L ≃ₐ[ℚ] L)
    (hσ : ∀ τ : XiDivisorSupport, σ (centeredZeroValue τ) = -centeredZeroValue τ) (z : L) :
    σ z=z ↔ ∃ a : K, algebraMap K L a=z := by
  obtain ⟨w,hw⟩ := xiDivisorSupport_infinite.nonempty
  let ρ : XiDivisorSupport := ⟨w,hw⟩
  obtain ⟨a,b,he⟩ := centered_element_repr ρ z
  have hf := centered_negation_fixes_even σ hσ
  constructor
  · intro hz
    have hm : algebraMap K L b*centeredZeroValue ρ=0 := by
      have hh : σ z=algebraMap K L a-algebraMap K L b*centeredZeroValue ρ := by
        rw [he,map_add,map_mul,hf,hf,hσ]
        ring
      linear_combination (1/2 : L)*(hh-hz-he)
    have hv : centeredZeroValue ρ ≠ 0 := by
      intro h
      exact centered_coordinate_ne_zero ρ (congrArg (fun x : L => (x : ℂ)) h)
    have hb : algebraMap K L b=0 := (mul_eq_zero.mp hm).resolve_right hv
    refine ⟨a,?_⟩
    rw [he,hb,zero_mul,add_zero]
  · rintro ⟨a,rfl⟩
    exact hf a

/-- A field lift exists exactly when the actual quadratic step has not collapsed. -/
theorem centeredFunctionalReflection_lifts_iff (ρ : XiDivisorSupport) :
    (∃ σ : L ≃ₐ[ℚ] L, ∀ τ : XiDivisorSupport, σ (centeredZeroValue τ) = -centeredZeroValue τ) ↔
      centeredZeroCoordinate ρ ∉ K := by
  constructor
  · rintro ⟨σ,hσ⟩ hm
    let a : K := ⟨centeredZeroCoordinate ρ,hm⟩
    have hf := centered_negation_fixes_even σ hσ a
    change σ (centeredZeroValue ρ)=centeredZeroValue ρ at hf
    have he := hσ ρ
    have hz : centeredZeroValue ρ=0 := by linear_combination (1/2 : L)*(he-hf)
    exact centered_coordinate_ne_zero ρ (congrArg (fun x : L => (x : ℂ)) hz)
  · intro hρ
    exact ⟨(centeredQuadraticReflection ρ hρ).restrictScalars ℚ,centeredQuadraticReflection_all ρ hρ⟩

/-- The action on the entire centered zero set determines a field lift uniquely. -/
theorem centeredFunctionalReflection_unique (σ τ : L ≃ₐ[ℚ] L)
    (hσ : ∀ ρ : XiDivisorSupport, σ (centeredZeroValue ρ) = -centeredZeroValue ρ)
    (hτ : ∀ ρ : XiDivisorSupport, τ (centeredZeroValue ρ) = -centeredZeroValue ρ) : σ=τ := by
  obtain ⟨w,hw⟩ := xiDivisorSupport_infinite.nonempty
  let ρ : XiDivisorSupport := ⟨w,hw⟩
  apply AlgEquiv.ext
  intro z
  obtain ⟨a,b,rfl⟩ := centered_element_repr ρ z
  rw [map_add,map_add,map_mul,map_mul,centered_negation_fixes_even σ hσ,
    centered_negation_fixes_even σ hσ,centered_negation_fixes_even τ hτ,
    centered_negation_fixes_even τ hτ,hσ,hτ]

private theorem centered_field_conj_mem {z : ℂ} (hz : z ∈ centeredZeroField) :
    starRingEnd ℂ z ∈ centeredZeroField := by
  induction hz using IntermediateField.adjoin_induction ℚ with
  | mem x hx =>
    obtain ⟨ρ,rfl⟩ := hx
    rw [← centered_coordinate_conj]
    exact centeredZeroCoordinate_mem _
  | algebraMap a =>
    rw [show starRingEnd ℂ (algebraMap ℚ ℂ a)=algebraMap ℚ ℂ a from
      primeSpectralScalarConjugation.commutes a]
    exact centeredZeroField.algebraMap_mem a
  | add x y _ _ hx hy => rw [map_add]; exact centeredZeroField.add_mem hx hy
  | inv x _ hx => rw [map_inv₀]; exact centeredZeroField.inv_mem hx
  | mul x y _ _ hx hy => rw [map_mul]; exact centeredZeroField.mul_mem hx hy

private theorem centered_even_conj_mem {z : ℂ} (hz : z ∈ K) : starRingEnd ℂ z ∈ K := by
  induction hz using IntermediateField.adjoin_induction ℚ with
  | mem x hx =>
    obtain ⟨⟨ρ,τ⟩,rfl⟩ := hx
    rw [map_mul,← centered_coordinate_conj,← centered_coordinate_conj]
    exact centeredProduct_mem _ _
  | algebraMap a =>
    rw [show starRingEnd ℂ (algebraMap ℚ ℂ a)=algebraMap ℚ ℂ a from
      primeSpectralScalarConjugation.commutes a]
    exact (K).algebraMap_mem a
  | add x y _ _ hx hy => rw [map_add]; exact (K).add_mem hx hy
  | inv x _ hx => rw [map_inv₀]; exact (K).inv_mem hx
  | mul x y _ _ hx hy => rw [map_mul]; exact (K).mul_mem hx hy

/-- Complex conjugation preserves the field of all original centered zeros. -/
theorem centeredZeroField_conjugation (z : ℂ) :
    starRingEnd ℂ z ∈ centeredZeroField ↔ z ∈ centeredZeroField := by
  constructor
  · intro h
    simpa only [Complex.conj_conj] using centered_field_conj_mem h
  · exact centered_field_conj_mem

/-- Complex conjugation preserves the full even-product field, without assuming it is real. -/
theorem centeredEvenProductField_conjugation (z : ℂ) : starRingEnd ℂ z ∈ K ↔ z ∈ K := by
  constructor
  · intro h
    simpa only [Complex.conj_conj] using centered_even_conj_mem h
  · exact centered_even_conj_mem

private theorem exists_centered_critical_anchor :
    ∃ ρ : XiDivisorSupport, (centeredZeroCoordinate ρ).re=0 := by
  obtain ⟨z,hz,hzero⟩ := XiSeamSupremum.exists_xi_zero_on_line
  let ρ : XiDivisorSupport := ⟨z,mem_xi_divisor_support_of_eq_zero hzero⟩
  refine ⟨ρ,?_⟩
  change (z-(1/2 : ℂ)).re=0
  have hh : (1/2 : ℂ).re=(1/2 : ℝ) := by norm_num
  rw [Complex.sub_re,hh,hz,sub_self]

/-- Reality of the complete even-product field is exactly critical-line purity of the actual zeros. -/
theorem centeredEvenProductField_real_iff :
    (∀ z ∈ K, z.im=0) ↔ ∀ ρ : XiDivisorSupport, (ρ : ℂ).re=1/2 := by
  constructor
  · intro h ρ
    obtain ⟨τ,ht⟩ := exists_centered_critical_anchor
    have hp := h _ (centeredProduct_mem ρ τ)
    rw [Complex.mul_im,ht,mul_zero,add_zero] at hp
    have hn : (centeredZeroCoordinate τ).im ≠ 0 := by
      rw [centered_coordinate_im]
      exact xi_divisor_support_im_ne_zero τ
    have hr := (mul_eq_zero.mp hp).resolve_right hn
    change ((ρ : ℂ)-(1/2 : ℂ)).re=0 at hr
    have hh : (1/2 : ℂ).re=(1/2 : ℝ) := by norm_num
    rw [Complex.sub_re,hh] at hr
    exact sub_eq_zero.mp hr
  · intro h
    have hr (ρ : XiDivisorSupport) : (centeredZeroCoordinate ρ).re=0 := by
      change ((ρ : ℂ)-(1/2 : ℂ)).re=0
      have hh : (1/2 : ℂ).re=(1/2 : ℝ) := by norm_num
      rw [Complex.sub_re,hh,h,sub_self]
    intro z hz
    induction hz using IntermediateField.adjoin_induction ℚ with
    | mem x hx =>
      obtain ⟨⟨ρ,τ⟩,rfl⟩ := hx
      rw [Complex.mul_im,hr,hr,zero_mul,mul_zero,zero_add]
    | algebraMap a => exact Complex.ratCast_im a
    | add x y _ _ hx hy => rw [Complex.add_im,hx,hy,zero_add]
    | inv x _ hx => rw [Complex.inv_im,hx,neg_zero,zero_div]
    | mul x y _ _ hx hy => rw [Complex.mul_im,hx,hy,mul_zero,zero_mul,zero_add]

end GaloisForLFunctions.GaloisTheoryOfZeros

