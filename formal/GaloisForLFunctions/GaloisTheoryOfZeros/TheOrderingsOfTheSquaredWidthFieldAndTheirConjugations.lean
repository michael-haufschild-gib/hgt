import GaloisForLFunctions.GaloisTheoryOfZeros.TheKummerRelationsOfTheZeroWidths

/-!
# The orderings of the squared-width field and the conjugations they define

The zero field `L` is generated over the squared-width field `D` by the square roots of the
radicands `a_q = −δ_q²`. An ordering `Q` of `D` gives every radicand a sign. The signs respect
every square relation among the radicands, so by Kummer theory exactly one automorphism `σ_Q` of
`L/D` fixes `√a_q` when `a_q` is positive and negates it when `a_q` is negative
(`orderingConjugation`). It is the conjugation defined by `Q`; the ordering induced by the real
numbers defines complex conjugation (`orderingConjugation_real`).

The Artin–Schreier extension theorem (`exists_isOrdering_neg_mem`: an element outside a
preordering of a field is negative in an ordering that contains the preordering) turns
statements on all orderings into statements on sums of squares
(`isSumSq_iff_forall_isOrdering_mem`):

* every ordering of `D` defines complex conjugation iff every squared width is a sum of squares
  in `D` (`forall_orderingConjugation_eq_conjugation_iff`);
* no ordering of `D` defines an automorphism other than the identity and complex conjugation iff
  every product of two radicands is a sum of squares in `D`
  (`forall_orderingConjugation_eq_one_or_conjugation_iff`).

A relation `a_q a_r ∈ D²` forces equal signs at `q` and `r` under every automorphism of `L/D`;
a relation `a_q a_r ∈ ΣD²` forces equal signs under the conjugations of orderings.
-/

noncomputable section
set_option autoImplicit false
open Complex Set RHTower
namespace GaloisForLFunctions.GaloisTheoryOfZeros

/-! ## The Artin–Schreier extension theorem -/

section ArtinSchreier

variable {F : Type*} [Field F]

/-- The preordering `P − aP` generated by a preordering `P` and `−a`, for `a` outside `P`. -/
def adjoinNeg (P : RingPreordering F) (a : F) (ha : a ∉ P) : RingPreordering F :=
  RingPreordering.mk' {z | ∃ x ∈ P, ∃ y ∈ P, z = x - a * y}
    (@fun u v hu hv => by
      obtain ⟨x, hx, y, hy, rfl⟩ := hu
      obtain ⟨x', hx', y', hy', rfl⟩ := hv
      exact ⟨x + x', add_mem hx hx', y + y', add_mem hy hy', by ring⟩)
    (@fun u v hu hv => by
      obtain ⟨x, hx, y, hy, rfl⟩ := hu
      obtain ⟨x', hx', y', hy', rfl⟩ := hv
      exact ⟨x * x' + a * a * (y * y'),
        add_mem (mul_mem hx hx') (mul_mem (P.mul_self_mem a) (mul_mem hy hy')),
        x * y' + x' * y, add_mem (mul_mem hx hy') (mul_mem hx' hy), by ring⟩)
    (fun z => ⟨z * z, P.mul_self_mem z, 0, zero_mem P, by ring⟩)
    (by
      rintro ⟨x, hx, y, hy, h⟩
      by_cases hy0 : y = 0
      · rw [hy0, mul_zero, sub_zero] at h
        exact P.neg_one_notMem (by rw [h]; exact hx)
      · -- `a y = 1 + x` with `y ≠ 0` puts `a = (1 + x) y (y⁻¹)²` in `P`
        have h2 : a * y = 1 + x := by linear_combination h
        have h3 : a = (1 + x) * y⁻¹ := by rw [← h2, mul_assoc, mul_inv_cancel₀ hy0, mul_one]
        exact ha (by
          rw [h3]
          exact mul_mem (add_mem (one_mem P) hx) (RingPreordering.inv_mem hy)))

theorem le_adjoinNeg (P : RingPreordering F) (a : F) (ha : a ∉ P) : P ≤ adjoinNeg P a ha :=
  fun x hx => ⟨x, hx, 0, zero_mem P, by ring⟩

theorem neg_mem_adjoinNeg (P : RingPreordering F) (a : F) (ha : a ∉ P) :
    -a ∈ adjoinNeg P a ha :=
  ⟨0, zero_mem P, 1, one_mem P, by ring⟩

/-- Every preordering of a field lies in a maximal one: the union of a chain of preorderings is
a preordering. -/
theorem exists_isMax_ge (P : RingPreordering F) : ∃ Q : RingPreordering F, P ≤ Q ∧ IsMax Q := by
  refine zorn_le_nonempty_Ici₀ P (fun c _ hchain Q₀ hQ₀ => ?_) P le_rfl
  refine ⟨RingPreordering.mk' {x | ∃ Q ∈ c, x ∈ Q} (@fun x z hx hz => ?_)
    (@fun x z hx hz => ?_) (fun x => ⟨Q₀, hQ₀, Q₀.mul_self_mem x⟩) ?_,
    fun Q hQ x hx => ⟨Q, hQ, hx⟩⟩
  · obtain ⟨Q₁, h₁, hx⟩ := hx
    obtain ⟨Q₂, h₂, hz⟩ := hz
    rcases hchain.total h₁ h₂ with h | h
    · exact ⟨Q₂, h₂, add_mem (h hx) hz⟩
    · exact ⟨Q₁, h₁, add_mem hx (h hz)⟩
  · obtain ⟨Q₁, h₁, hx⟩ := hx
    obtain ⟨Q₂, h₂, hz⟩ := hz
    rcases hchain.total h₁ h₂ with h | h
    · exact ⟨Q₂, h₂, mul_mem (h hx) hz⟩
    · exact ⟨Q₁, h₁, mul_mem hx (h hz)⟩
  · rintro ⟨Q, -, hQ⟩
    exact Q.neg_one_notMem hQ

/-- A maximal preordering of a field is an ordering. -/
theorem isOrdering_of_isMax {Q : RingPreordering F} (hQ : IsMax Q) : Q.IsOrdering := by
  have key : ∀ a : F, a ∉ Q → -a ∈ Q := fun a ha =>
    hQ (le_adjoinNeg Q a ha) (neg_mem_adjoinNeg Q a ha)
  rw [RingPreordering.isOrdering_iff]
  intro a b hab
  by_contra hcon
  rw [not_or] at hcon
  have h3 : a * b ∈ Q := by
    have h := mul_mem (key a hcon.1) (key b hcon.2)
    rwa [neg_mul_neg] at h
  rcases mul_eq_zero.1 (RingPreordering.eq_zero_of_mem_of_neg_mem h3 hab) with h | h
  · exact hcon.1 (by rw [h]; exact zero_mem Q)
  · exact hcon.2 (by rw [h]; exact zero_mem Q)

/-- **Artin–Schreier.** An element outside a preordering of a field is negative in an ordering
that contains the preordering. -/
theorem exists_isOrdering_neg_mem (P : RingPreordering F) {a : F} (ha : a ∉ P) :
    ∃ Q : RingPreordering F, Q.IsOrdering ∧ P ≤ Q ∧ -a ∈ Q := by
  obtain ⟨Q, hle, hmax⟩ := exists_isMax_ge (adjoinNeg P a ha)
  exact ⟨Q, isOrdering_of_isMax hmax, (le_adjoinNeg P a ha).trans hle,
    hle (neg_mem_adjoinNeg P a ha)⟩

/-- The sums of squares of a field that has a preordering form a preordering. -/
def sumSqPreordering (P₀ : RingPreordering F) : RingPreordering F :=
  RingPreordering.mk' {x | IsSumSq x} (@fun _ _ hx hy => IsSumSq.add hx hy)
    (@fun _ _ hx hy => IsSumSq.mul hx hy) IsSumSq.mul_self
    fun h => P₀.neg_one_notMem (RingPreordering.mem_of_isSumSq h)

/-- **Artin.** In a field with a preordering the sums of squares are the elements that lie in
every ordering. -/
theorem isSumSq_iff_forall_isOrdering_mem (P₀ : RingPreordering F) (x : F) :
    IsSumSq x ↔ ∀ Q : RingPreordering F, Q.IsOrdering → x ∈ Q := by
  refine ⟨fun h Q _ => RingPreordering.mem_of_isSumSq h, fun h => ?_⟩
  by_contra hx
  obtain ⟨Q, hQ, -, hneg⟩ := exists_isOrdering_neg_mem (sumSqPreordering P₀) (a := x)
    (fun h' => hx (RingPreordering.mem_mk'.1 h'))
  have h0 : x = 0 := RingPreordering.eq_zero_of_mem_of_neg_mem (h Q hQ) hneg
  exact hx (by rw [h0]; exact IsSumSq.zero)

/-! ## Signs in an ordering -/

open Classical in
/-- The sign of an element in an ordering: `1` on the ordering and `-1` off it. -/
def orderingSign (Q : RingPreordering F) (x : F) : ℤˣ := if x ∈ Q then 1 else -1

theorem orderingSign_of_mem {Q : RingPreordering F} {x : F} (h : x ∈ Q) :
    orderingSign Q x = 1 := by
  rw [orderingSign, if_pos h]

theorem orderingSign_of_notMem {Q : RingPreordering F} {x : F} (h : x ∉ Q) :
    orderingSign Q x = -1 := by
  rw [orderingSign, if_neg h]

theorem orderingSign_eq_one_iff {Q : RingPreordering F} {x : F} :
    orderingSign Q x = 1 ↔ x ∈ Q := by
  refine ⟨fun h => ?_, orderingSign_of_mem⟩
  by_contra hx
  rw [orderingSign_of_notMem hx] at h
  exact absurd h (by decide)

/-- The sign is multiplicative on nonzero elements. -/
theorem orderingSign_mul (Q : RingPreordering F) [Q.IsOrdering] {x y : F} (hx : x ≠ 0)
    (hy : y ≠ 0) : orderingSign Q (x * y) = orderingSign Q x * orderingSign Q y := by
  have hneg : ∀ {z : F}, z ∉ Q → -z ∈ Q := fun {z} hz => (mem_or_neg_mem Q z).resolve_left hz
  by_cases h1 : x ∈ Q <;> by_cases h2 : y ∈ Q
  · rw [orderingSign_of_mem (mul_mem h1 h2), orderingSign_of_mem h1, orderingSign_of_mem h2,
      one_mul]
  · have h3 : x * y ∉ Q := fun h => mul_ne_zero hx hy
      (RingPreordering.eq_zero_of_mem_of_neg_mem h (by
        have h4 := mul_mem h1 (hneg h2)
        rwa [mul_neg] at h4))
    rw [orderingSign_of_notMem h3, orderingSign_of_mem h1, orderingSign_of_notMem h2, one_mul]
  · have h3 : x * y ∉ Q := fun h => mul_ne_zero hx hy
      (RingPreordering.eq_zero_of_mem_of_neg_mem h (by
        have h4 := mul_mem (hneg h1) h2
        rwa [neg_mul] at h4))
    rw [orderingSign_of_notMem h3, orderingSign_of_notMem h1, orderingSign_of_mem h2, mul_one]
  · have h3 : x * y ∈ Q := by
      have h4 := mul_mem (hneg h1) (hneg h2)
      rwa [neg_mul_neg] at h4
    rw [orderingSign_of_mem h3, orderingSign_of_notMem h1, orderingSign_of_notMem h2,
      neg_mul_neg, one_mul]

theorem orderingSign_prod (Q : RingPreordering F) [Q.IsOrdering] {ι : Type*} (S : Finset ι)
    (f : ι → F) (hf : ∀ i, f i ≠ 0) :
    orderingSign Q (∏ i ∈ S, f i) = ∏ i ∈ S, orderingSign Q (f i) := by
  classical
  induction S using Finset.induction_on with
  | empty =>
      rw [Finset.prod_empty, Finset.prod_empty]
      exact orderingSign_of_mem (one_mem Q)
  | insert i S hi ih =>
      rw [Finset.prod_insert hi, Finset.prod_insert hi,
        orderingSign_mul Q (hf i) (Finset.prod_ne_zero_iff.2 fun j _ => hf j), ih]

/-! ## Orderings from real embeddings -/

/-- The ordering of a field defined by an embedding in the real numbers. -/
def embeddingOrdering (φ : F →+* ℝ) : RingPreordering F :=
  RingPreordering.mk' {a | 0 ≤ φ a}
    (@fun x y hx hy => by
      show 0 ≤ φ (x + y)
      rw [map_add]
      exact add_nonneg hx hy)
    (@fun x y hx hy => by
      show 0 ≤ φ (x * y)
      rw [map_mul]
      exact mul_nonneg hx hy)
    (fun x => by
      show 0 ≤ φ (x * x)
      rw [map_mul]
      exact mul_self_nonneg _)
    (fun h => by
      have h1 : (0 : ℝ) ≤ φ (-1) := h
      rw [map_neg, map_one] at h1
      linarith)

theorem mem_embeddingOrdering {φ : F →+* ℝ} {a : F} : a ∈ embeddingOrdering φ ↔ 0 ≤ φ a :=
  Iff.rfl

instance isOrdering_embeddingOrdering (φ : F →+* ℝ) : (embeddingOrdering φ).IsOrdering := by
  rw [RingPreordering.isOrdering_iff]
  intro a b h
  rw [mem_embeddingOrdering, map_neg, map_mul] at h
  by_contra hcon
  rw [not_or, mem_embeddingOrdering, mem_embeddingOrdering, not_le, not_le] at hcon
  linarith [mul_pos_of_neg_of_neg hcon.1 hcon.2]

end ArtinSchreier

/-! ## The radicands in the squared-width field -/

theorem coe_widthSignRadicand (q : NonzeroWidthZero) :
    (((widthSignRadicand q : widthSquareField) : fullFibreZeroExtension) : ℂ) =
      -(zeroWidth q.val ^ 2) := by
  change zeroImaginaryOffset q.val ^ 2 = -(zeroWidth q.val ^ 2)
  rw [zeroImaginaryOffset_eq, mul_pow, Complex.I_sq, neg_one_mul]

theorem widthSignRadicand_ne_zero (q : NonzeroWidthZero) : widthSignRadicand q ≠ 0 := by
  intro h
  have h1 : (((widthSignRadicand q : widthSquareField) : fullFibreZeroExtension) : ℂ) = 0 := by
    rw [h]
    rfl
  rw [coe_widthSignRadicand, neg_eq_zero] at h1
  exact q.property ((pow_eq_zero_iff two_ne_zero).1 h1)

theorem widthSignRadical_ne_zero (q : NonzeroWidthZero) : widthSignRadical q ≠ 0 := by
  intro h
  apply widthSignRadicand_ne_zero q
  apply Subtype.ext
  change widthSignRadical q ^ 2 = 0
  rw [h, zero_pow two_ne_zero]

theorem widthSquareField_im (a : widthSquareField) :
    ((a : fullFibreZeroExtension) : ℂ).im = 0 := by
  obtain ⟨r, hr⟩ := evenWidthField_le_real (widthSquareField_le_even a.property)
  change (r : ℂ) = ((a : fullFibreZeroExtension) : ℂ) at hr
  rw [← hr]
  exact Complex.ofReal_im r

/-- The embedding of the squared-width field in the real numbers. -/
def widthSquareRealEmbedding : widthSquareField →+* ℝ where
  toFun a := ((a : fullFibreZeroExtension) : ℂ).re
  map_one' := Complex.one_re
  map_mul' a b := by
    change (((a : fullFibreZeroExtension) : ℂ) * ((b : fullFibreZeroExtension) : ℂ)).re = _
    rw [Complex.mul_re, widthSquareField_im a, zero_mul, sub_zero]
  map_zero' := Complex.zero_re
  map_add' a b := Complex.add_re _ _

/-- In the real embedding every radicand `−δ_q²` is negative. -/
theorem widthSquareRealEmbedding_radicand_neg (q : NonzeroWidthZero) :
    widthSquareRealEmbedding (widthSignRadicand q) < 0 := by
  have h : widthSquareRealEmbedding (widthSignRadicand q) =
      -((xiSpectralPoint q.val).im ^ 2) := by
    change (((widthSignRadicand q : widthSquareField) : fullFibreZeroExtension) : ℂ).re = _
    rw [coe_widthSignRadicand, zeroWidth, ← Complex.ofReal_pow, ← Complex.ofReal_neg,
      Complex.ofReal_re]
  have hne : (xiSpectralPoint q.val).im ≠ 0 := fun h0 =>
    q.property (by rw [zeroWidth, h0, Complex.ofReal_zero])
  rw [h, neg_lt_zero]
  exact lt_of_le_of_ne (sq_nonneg _) (pow_ne_zero 2 hne).symm

/-! ## The conjugation of an ordering -/

theorem widthKernelSignAction_injective : Function.Injective widthKernelSignAction :=
  fun _ _ h => widthKernelSignCoordinates_bijective.1 (Subtype.ext h)

/-- The signs that an ordering of the squared-width field gives to the radicands `−δ_q²`. -/
def orderingWidthSigns (Q : RingPreordering widthSquareField) : NonzeroWidthZero → ℤˣ :=
  fun q => orderingSign Q (widthSignRadicand q)

/-- The signs of an ordering respect every square relation among the radicands. -/
theorem orderingWidthSigns_admissible (Q : RingPreordering widthSquareField) [Q.IsOrdering]
    (S : Finset NonzeroWidthZero) (hS : IsSquare (∏ q ∈ S, widthSignRadicand q)) :
    ∏ q ∈ S, orderingWidthSigns Q q = 1 := by
  change ∏ q ∈ S, orderingSign Q (widthSignRadicand q) = 1
  rw [← orderingSign_prod Q S widthSignRadicand widthSignRadicand_ne_zero]
  exact orderingSign_of_mem (Q.mem_of_isSquare hS)

theorem existsUnique_orderingConjugation (Q : RingPreordering widthSquareField)
    [Q.IsOrdering] :
    ∃! σ : fullFibreZeroExtension ≃ₐ[widthSquareField] fullFibreZeroExtension,
      widthKernelSignAction σ = orderingWidthSigns Q :=
  (widthKernelSignAction_unique_extension (orderingWidthSigns Q)).2
    (orderingWidthSigns_admissible Q)

/-- **The conjugation defined by an ordering.** The automorphism of the zero field over the
squared-width field that fixes `√a_q` when the radicand `a_q` is positive in the ordering and
negates it when `a_q` is negative. -/
def orderingConjugation (Q : RingPreordering widthSquareField) [Q.IsOrdering] :
    fullFibreZeroExtension ≃ₐ[widthSquareField] fullFibreZeroExtension :=
  (existsUnique_orderingConjugation Q).exists.choose

theorem widthKernelSignAction_orderingConjugation (Q : RingPreordering widthSquareField)
    [Q.IsOrdering] : widthKernelSignAction (orderingConjugation Q) = orderingWidthSigns Q :=
  (existsUnique_orderingConjugation Q).exists.choose_spec

theorem orderingConjugation_eq_iff (Q : RingPreordering widthSquareField) [Q.IsOrdering]
    (σ : fullFibreZeroExtension ≃ₐ[widthSquareField] fullFibreZeroExtension) :
    orderingConjugation Q = σ ↔ widthKernelSignAction σ = orderingWidthSigns Q := by
  rw [← widthKernelSignAction_orderingConjugation Q]
  exact ⟨fun h => by rw [h], fun h => widthKernelSignAction_injective h.symm⟩

/-- The conjugation of an ordering multiplies `√a_q` by the sign of `a_q`. -/
theorem orderingConjugation_radical (Q : RingPreordering widthSquareField) [Q.IsOrdering]
    (q : NonzeroWidthZero) :
    orderingConjugation Q (widthSignRadical q) =
      ((orderingSign Q (widthSignRadicand q) : ℤ) : fullFibreZeroExtension) *
        widthSignRadical q := by
  have h := congrFun (widthKernelSignAction_orderingConjugation Q) q
  change sourceRootSign (widthSignRadical q) (widthSignRadicand q) rfl
    (widthSignRadical_ne_zero q) (orderingConjugation Q) =
      orderingSign Q (widthSignRadicand q) at h
  rw [← h]
  exact sourceRootSign_action (widthSignRadical q) (widthSignRadicand q) rfl
    (widthSignRadical_ne_zero q) (orderingConjugation Q)

/-- It fixes `√a_q` exactly when `a_q` is positive in the ordering. -/
theorem orderingConjugation_radical_eq_iff (Q : RingPreordering widthSquareField)
    [Q.IsOrdering] (q : NonzeroWidthZero) :
    orderingConjugation Q (widthSignRadical q) = widthSignRadical q ↔
      widthSignRadicand q ∈ Q := by
  have h := congrFun (widthKernelSignAction_orderingConjugation Q) q
  change sourceRootSign (widthSignRadical q) (widthSignRadicand q) rfl
    (widthSignRadical_ne_zero q) (orderingConjugation Q) =
      orderingSign Q (widthSignRadicand q) at h
  rw [← sourceRootSign_eq_one_iff (widthSignRadical q) (widthSignRadicand q) rfl
    (widthSignRadical_ne_zero q), h, orderingSign_eq_one_iff]

/-- The conjugation of an ordering is the identity or an involution. -/
theorem orderingConjugation_mul_self (Q : RingPreordering widthSquareField) [Q.IsOrdering] :
    orderingConjugation Q * orderingConjugation Q = 1 := by
  apply widthKernelSignAction_injective
  rw [map_mul, map_one]
  funext q
  change widthKernelSignAction (orderingConjugation Q) q *
    widthKernelSignAction (orderingConjugation Q) q = 1
  rcases Int.units_eq_one_or (widthKernelSignAction (orderingConjugation Q) q) with h | h <;>
    rw [h] <;> decide

/-- It is complex conjugation exactly when every squared width is positive in the ordering. -/
theorem orderingConjugation_eq_conjugation_iff (Q : RingPreordering widthSquareField)
    [Q.IsOrdering] :
    orderingConjugation Q = widthSquareConjugation ↔ ∀ q, widthSignRadicand q ∉ Q := by
  rw [orderingConjugation_eq_iff, widthKernelSignAction_conjugation]
  constructor
  · intro h q hq
    have h1 := congrFun h q
    change (-1 : ℤˣ) = orderingSign Q (widthSignRadicand q) at h1
    rw [orderingSign_of_mem hq] at h1
    exact absurd h1 (by decide)
  · intro h
    funext q
    exact (orderingSign_of_notMem (h q)).symm

/-- It is the identity exactly when every squared width is negative in the ordering. -/
theorem orderingConjugation_eq_one_iff (Q : RingPreordering widthSquareField) [Q.IsOrdering] :
    orderingConjugation Q = 1 ↔ ∀ q, widthSignRadicand q ∈ Q := by
  rw [orderingConjugation_eq_iff, map_one]
  constructor
  · intro h q
    have h1 := congrFun h q
    change (1 : ℤˣ) = orderingSign Q (widthSignRadicand q) at h1
    exact orderingSign_eq_one_iff.1 h1.symm
  · intro h
    funext q
    exact (orderingSign_of_mem (h q)).symm

/-- **The ordering induced by the real numbers defines complex conjugation.** -/
theorem orderingConjugation_real :
    orderingConjugation (embeddingOrdering widthSquareRealEmbedding) =
      widthSquareConjugation := by
  rw [orderingConjugation_eq_conjugation_iff]
  intro q hq
  exact absurd (mem_embeddingOrdering.1 hq) (not_le.2 (widthSquareRealEmbedding_radicand_neg q))

/-- An ordering in which two squared widths have different signs defines an automorphism of the
zero field over the squared-width field other than the identity and complex conjugation. -/
theorem orderingConjugation_ne_of_mem_of_notMem (Q : RingPreordering widthSquareField)
    [Q.IsOrdering] {q r : NonzeroWidthZero} (hq : widthSignRadicand q ∈ Q)
    (hr : widthSignRadicand r ∉ Q) :
    orderingConjugation Q ≠ 1 ∧ orderingConjugation Q ≠ widthSquareConjugation :=
  ⟨fun h => hr ((orderingConjugation_eq_one_iff Q).1 h r),
    fun h => (orderingConjugation_eq_conjugation_iff Q).1 h q hq⟩

/-! ## All orderings -/

/-- **Every ordering of the squared-width field defines complex conjugation iff every squared
width is a sum of squares in that field.** -/
theorem forall_orderingConjugation_eq_conjugation_iff :
    (∀ (Q : RingPreordering widthSquareField) [Q.IsOrdering],
        orderingConjugation Q = widthSquareConjugation) ↔
      ∀ q : NonzeroWidthZero, IsSumSq (-widthSignRadicand q) := by
  constructor
  · intro h q
    rw [isSumSq_iff_forall_isOrdering_mem (embeddingOrdering widthSquareRealEmbedding)]
    intro Q hQ
    haveI := hQ
    exact (mem_or_neg_mem Q (widthSignRadicand q)).resolve_left
      ((orderingConjugation_eq_conjugation_iff Q).1 (h Q) q)
  · intro h Q _
    rw [orderingConjugation_eq_conjugation_iff]
    intro q hq
    exact widthSignRadicand_ne_zero q
      (RingPreordering.eq_zero_of_mem_of_neg_mem hq (RingPreordering.mem_of_isSumSq (h q)))

/-- **No ordering of the squared-width field defines an automorphism other than the identity and
complex conjugation iff every product of two radicands is a sum of squares in that field.** -/
theorem forall_orderingConjugation_eq_one_or_conjugation_iff :
    (∀ (Q : RingPreordering widthSquareField) [Q.IsOrdering],
        orderingConjugation Q = 1 ∨ orderingConjugation Q = widthSquareConjugation) ↔
      ∀ q r : NonzeroWidthZero, IsSumSq (widthSignRadicand q * widthSignRadicand r) := by
  constructor
  · intro h q r
    rw [isSumSq_iff_forall_isOrdering_mem (embeddingOrdering widthSquareRealEmbedding)]
    intro Q hQ
    haveI := hQ
    rcases h Q with h1 | h1
    · exact mul_mem ((orderingConjugation_eq_one_iff Q).1 h1 q)
        ((orderingConjugation_eq_one_iff Q).1 h1 r)
    · have hq := (mem_or_neg_mem Q (widthSignRadicand q)).resolve_left
        ((orderingConjugation_eq_conjugation_iff Q).1 h1 q)
      have hr := (mem_or_neg_mem Q (widthSignRadicand r)).resolve_left
        ((orderingConjugation_eq_conjugation_iff Q).1 h1 r)
      have hqr := mul_mem hq hr
      rwa [neg_mul_neg] at hqr
  · intro h Q _
    by_cases hall : ∀ q, widthSignRadicand q ∈ Q
    · exact Or.inl ((orderingConjugation_eq_one_iff Q).2 hall)
    · right
      rw [orderingConjugation_eq_conjugation_iff]
      obtain ⟨q₀, hq₀⟩ := not_forall.1 hall
      intro q hq
      -- `a_q > 0 > a_{q₀}` contradicts `a_q a_{q₀} ≥ 0`
      have hs := orderingSign_mul Q (widthSignRadicand_ne_zero q) (widthSignRadicand_ne_zero q₀)
      rw [orderingSign_of_mem (RingPreordering.mem_of_isSumSq (h q q₀)), orderingSign_of_mem hq,
        orderingSign_of_notMem hq₀] at hs
      exact absurd hs (by decide)

end GaloisForLFunctions.GaloisTheoryOfZeros
