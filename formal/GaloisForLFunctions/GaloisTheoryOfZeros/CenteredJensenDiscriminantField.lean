import GaloisForLFunctions.GaloisTheoryOfZeros.CenteredJensenDiscriminant
import Mathlib.Algebra.Field.Subfield.Basic
import Mathlib.Algebra.Polynomial.Lifts

/-!
# The coefficient field and discriminant extension of centered Jensen equations

The field generated by all normalized even Riemann-kernel moments is exactly
the coefficient field of the even quotient family. Both quotient families
and their discriminants descend to this field.

The full monic discriminants are moment factors times squares in that exact
field. Adjoining their square roots at every degree gives a real extension,
on which conjugation is trivial. This includes collisions and degree zero;
it supplies no nonvanishing assertion or action on limiting ξ zeros.
-/

noncomputable section
set_option autoImplicit false
open Polynomial Complex FiniteFreeProbability RHTower
namespace GaloisForLFunctions.GaloisTheoryOfZeros

/-- The even Riemann-kernel moment divided by its zeroth mass. -/
def normalizedEvenMoment (n : ℕ) : ℝ := xiMoment (1/2) (2*n) / xiMoment (1/2) 0

/-- The field generated over ℚ by the entire normalized moment sequence. -/
def normalizedMomentField : Subfield ℝ :=
  Subfield.closure (Set.range normalizedEvenMoment)

theorem normalizedEvenMoment_mem (n : ℕ) : normalizedEvenMoment n ∈ normalizedMomentField :=
  Subfield.subset_closure ⟨n, rfl⟩

private theorem centered_even_coeff (d j k : ℕ) (hj : j ≤ d) (hk : d-j = 2*k) :
    (monicCenteredJensen d).coeff j =
      (-1)^k * ((d.descFactorial (2*k) : ℝ) / ((2*k).factorial : ℝ)) *
        normalizedEvenMoment k := by
  have hmap : (xiJensenReal d).map Complex.ofRealHom = xiJensen (1/2) d := by
    rw [xiJensen, mk_xiShiftCoeff_half, jensenRev_xiSeries]
    rfl
  have hc := congrArg (fun p : ℂ[X] => p.coeff j) hmap
  rw [coeff_map, xiJensen, coeff_jensenRev _ _ hj, hk,
    PowerSeries.coeff_mk, xiShiftCoeff_eq_moment, pow_mul, I_sq] at hc
  change ((xiJensenReal d).coeff j : ℂ) =
    (-1)^k * (xiMoment (1/2) (2*k) : ℂ) / ((2*k).factorial : ℂ) *
      (d.descFactorial (2*k) : ℂ) at hc
  apply Complex.ofReal_injective
  rw [monicCenteredJensen, coeff_mul_C]
  unfold normalizedEvenMoment
  push_cast
  rw [hc]
  simp only [div_eq_mul_inv]
  ring

private theorem centered_even_coeff_mem (d j k : ℕ) (hj : j ≤ d) (hk : d-j = 2*k) :
    (monicCenteredJensen d).coeff j ∈ normalizedMomentField := by
  rw [centered_even_coeff d j k hj hk]
  exact normalizedMomentField.mul_mem
    (normalizedMomentField.mul_mem
      (normalizedMomentField.pow_mem (normalizedMomentField.neg_mem
        normalizedMomentField.one_mem) k)
      (normalizedMomentField.div_mem (natCast_mem _ _) (natCast_mem _ _)))
    (normalizedEvenMoment_mem k)

/-- Every even quotient coefficient descends to the normalized moment field. -/
theorem evenCenteredQuotient_coeff_mem (n j : ℕ) :
    (evenCenteredQuotient n).coeff j ∈ normalizedMomentField := by
  by_cases hj : j ≤ n
  · rw [evenCenteredQuotient, squareQuotient, coeff_contract (by decide : 2 ≠ 0)]
    exact centered_even_coeff_mem (2*n) (j*2) (n-j) (by omega) (by omega)
  · rw [coeff_eq_zero_of_natDegree_lt (by rw [evenCenteredQuotient_natDegree]; omega)]
    exact normalizedMomentField.zero_mem

/-- Every odd quotient coefficient descends to the same field. -/
theorem oddCenteredQuotient_coeff_mem (n j : ℕ) :
    (oddCenteredQuotient n).coeff j ∈ normalizedMomentField := by
  by_cases hj : j ≤ n
  · rw [oddCenteredQuotient, squareQuotient, coeff_contract (by decide : 2 ≠ 0), coeff_divX]
    exact centered_even_coeff_mem (2*n+1) (j*2+1) (n-j) (by omega) (by omega)
  · rw [coeff_eq_zero_of_natDegree_lt (by rw [oddCenteredQuotient_natDegree]; omega)]
    exact normalizedMomentField.zero_mem

/-- The field generated by the coefficients of all even quotient equations. -/
def evenQuotientCoefficientField : Subfield ℝ :=
  Subfield.closure {a : ℝ | ∃ n j : ℕ, a = (evenCenteredQuotient n).coeff j}

/-- The normalized moment field is exactly the coefficient field of the full quotient family. -/
theorem evenQuotientCoefficientField_eq_normalizedMomentField :
    evenQuotientCoefficientField = normalizedMomentField := by
  apply le_antisymm
  · apply Subfield.closure_le.mpr
    rintro a ⟨n, j, rfl⟩
    exact evenCenteredQuotient_coeff_mem n j
  · apply Subfield.closure_le.mpr
    rintro a ⟨n, rfl⟩
    have hc : (evenCenteredQuotient n).coeff 0 ∈ evenQuotientCoefficientField :=
      Subfield.subset_closure ⟨n, 0, rfl⟩
    rw [evenCenteredQuotient_coeff_zero] at hc
    have hs : ((-1:ℝ)^n) * ((-1)^n) = 1 := by rw [← mul_pow]; norm_num
    have h := evenQuotientCoefficientField.mul_mem
      (evenQuotientCoefficientField.pow_mem
        (evenQuotientCoefficientField.neg_mem evenQuotientCoefficientField.one_mem) n) hc
    change normalizedEvenMoment n ∈ evenQuotientCoefficientField
    simpa only [← mul_assoc, hs, one_mul, normalizedEvenMoment] using h

private theorem discr_mem_of_coeff_mem (K : Subfield ℝ) (P : ℝ[X])
    (hm : P.Monic) (hc : ∀ j, P.coeff j ∈ K) : P.discr ∈ K := by
  have hlift : P ∈ Polynomial.lifts (algebraMap K ℝ) := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro j
    exact ⟨⟨P.coeff j, hc j⟩, rfl⟩
  obtain ⟨Q, hQ⟩ := hlift
  change Polynomial.map (algebraMap K ℝ) Q = P at hQ
  have hmonic : Q.Monic := Polynomial.monic_map_iff.mp (hQ.symm ▸ hm)
  have hd := GaloisForLFunctions.HTGeometry.map_discr_of_monic (algebraMap K ℝ) hmonic
  rw [hQ] at hd
  rw [← hd]
  exact Q.discr.property

theorem evenCenteredQuotient_discr_mem (n : ℕ) :
    (evenCenteredQuotient n).discr ∈ normalizedMomentField :=
  discr_mem_of_coeff_mem _ _ (evenCenteredQuotient_monic n)
    (evenCenteredQuotient_coeff_mem n)

theorem oddCenteredQuotient_discr_mem (n : ℕ) :
    (oddCenteredQuotient n).discr ∈ normalizedMomentField :=
  discr_mem_of_coeff_mem _ _ (oddCenteredQuotient_monic n)
    (oddCenteredQuotient_coeff_mem n)

/-- The even full discriminant differs from its normalized moment by a square in the base field. -/
theorem even_discr_moment_square (n : ℕ) :
    ∃ s ∈ normalizedMomentField,
      (monicCenteredJensen (2*n)).discr = normalizedEvenMoment n * s^2 := by
  refine ⟨2^n * (evenCenteredQuotient n).discr,
    normalizedMomentField.mul_mem (normalizedMomentField.pow_mem (natCast_mem _ 2) _)
      (evenCenteredQuotient_discr_mem n), ?_⟩
  rw [discr_even_monicCenteredJensen]
  change 4^n * normalizedEvenMoment n * (evenCenteredQuotient n).discr^2 = _
  have hpow : (4:ℝ)^n = (2^n)^2 := by rw [← pow_mul, Nat.mul_comm n 2, pow_mul]; norm_num
  rw [hpow]
  ring

/-- The odd square class has the additional rational factor `2n+1`. -/
theorem odd_discr_moment_square (n : ℕ) :
    ∃ s ∈ normalizedMomentField,
      (monicCenteredJensen (2*n+1)).discr =
        ((2*n+1 : ℕ) : ℝ) * normalizedEvenMoment n * s^2 := by
  let b : ℝ := ((2*n+1 : ℕ) : ℝ) * normalizedEvenMoment n
  have hb : b ∈ normalizedMomentField :=
    normalizedMomentField.mul_mem (natCast_mem _ _) (normalizedEvenMoment_mem n)
  refine ⟨2^n * b * (oddCenteredQuotient n).discr,
    normalizedMomentField.mul_mem
      (normalizedMomentField.mul_mem (normalizedMomentField.pow_mem (natCast_mem _ 2) _) hb)
      (oddCenteredQuotient_discr_mem n), ?_⟩
  rw [discr_odd_monicCenteredJensen]
  have hb' : (((2*n : ℕ)+1 : ℝ) * xiMoment (1/2) (2*n) / xiMoment (1/2) 0) = b := by
    dsimp [b, normalizedEvenMoment]
    push_cast
    ring
  rw [hb']
  change 4^n * b^3 * (oddCenteredQuotient n).discr^2 = b * _
  have hpow : (4:ℝ)^n = (2^n)^2 := by rw [← pow_mul, Nat.mul_comm n 2, pow_mul]; norm_num
  rw [hpow]
  ring

/-- The full normalized discriminants lie in the exact quotient coefficient field. -/
theorem monicCenteredJensen_discr_mem (d : ℕ) :
    (monicCenteredJensen d).discr ∈ normalizedMomentField := by
  obtain ⟨n, rfl | rfl⟩ : ∃ n : ℕ, d = 2*n ∨ d = 2*n+1 := ⟨d/2, by omega⟩
  · obtain ⟨s, hs, heq⟩ := even_discr_moment_square n
    rw [heq]
    exact normalizedMomentField.mul_mem (normalizedEvenMoment_mem n)
      (normalizedMomentField.pow_mem hs 2)
  · obtain ⟨s, hs, heq⟩ := odd_discr_moment_square n
    rw [heq]
    exact normalizedMomentField.mul_mem
      (normalizedMomentField.mul_mem (natCast_mem _ _) (normalizedEvenMoment_mem n))
      (normalizedMomentField.pow_mem hs 2)

/-- Adjoin every normalized discriminant square root to the moment field at once. -/
def normalizedDiscriminantField : Subfield ℂ :=
  Subfield.closure
    ({z : ℂ | ∃ x : ℝ, x ∈ normalizedMomentField ∧ z = (x : ℂ)} ∪
      {z : ℂ | ∃ d : ℕ, z^2 = ((monicCenteredJensen d).discr : ℂ)})

private theorem squareRoot_real_of_nonneg {a : ℝ} (ha : 0 ≤ a)
    {z : ℂ} (hz : z^2 = (a : ℂ)) : z.im = 0 := by
  have hr := congrArg Complex.re hz
  have hi := congrArg Complex.im hz
  simp only [pow_two, Complex.mul_re, Complex.mul_im, Complex.ofReal_re,
    Complex.ofReal_im] at hr hi
  have hprod : z.re*z.im = 0 := by linarith only [hi]
  rcases mul_eq_zero.mp hprod with hre | him
  · rw [hre, zero_mul] at hr
    nlinarith only [hr, ha, sq_nonneg z.im]
  · exact him

/-- The entire quadratic discriminant extension is real, uniformly in degree. -/
theorem normalizedDiscriminantField_le_real :
    normalizedDiscriminantField ≤ Complex.ofRealHom.fieldRange := by
  apply Subfield.closure_le.mpr
  intro z hz
  rcases hz with ⟨x, hx, rfl⟩ | ⟨d, hz⟩
  · exact ⟨x, rfl⟩
  · have hi := squareRoot_real_of_nonneg (monicCenteredJensen_discr_nonneg d) hz
    change ∃ x : ℝ, (x : ℂ) = z
    refine ⟨z.re, ?_⟩
    apply Complex.ext
    · rfl
    · simpa only [Complex.ofReal_im] using hi.symm

/-- Conjugation is trivial on the full discriminant extension of the moment field. -/
theorem conj_fixes_normalizedDiscriminantField (z : normalizedDiscriminantField) :
    star (z : ℂ) = (z : ℂ) := by
  obtain ⟨x, hx⟩ := normalizedDiscriminantField_le_real z.property
  rw [← hx]
  simp

end GaloisForLFunctions.GaloisTheoryOfZeros

#print axioms GaloisForLFunctions.GaloisTheoryOfZeros.evenQuotientCoefficientField_eq_normalizedMomentField
#print axioms GaloisForLFunctions.GaloisTheoryOfZeros.even_discr_moment_square
#print axioms GaloisForLFunctions.GaloisTheoryOfZeros.odd_discr_moment_square
#print axioms GaloisForLFunctions.GaloisTheoryOfZeros.conj_fixes_normalizedDiscriminantField
