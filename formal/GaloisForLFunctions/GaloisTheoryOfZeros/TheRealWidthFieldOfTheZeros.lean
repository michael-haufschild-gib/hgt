import GaloisForLFunctions.GaloisTheoryOfZeros.TheGaussianExtensionOfTheZeroField
import GaloisForLFunctions.GaloisTheoryOfZeros.TheMaximalRealSubfieldOfTheZeroField

/-!
# The real width field and ordinary conjugation

The full original-coordinate zero field is the Gaussian extension of the real
field generated by all signed widths. This identifies its maximal real subfield
and separates ordinary conjugation from the remaining width action.
-/

noncomputable section
set_option autoImplicit false
open Complex Set RHTower
open scoped IntermediateField
namespace GaloisForLFunctions.GaloisTheoryOfZeros

/-- Every signed width belongs to the field of all zeros and the Gaussian unit. -/
theorem realWidthField_le_gaussian : realWidthField ≤ gaussianZeroExtension := by
  apply IntermediateField.adjoin_le_iff.mpr
  rintro z ⟨q, rfl⟩
  have he : zeroWidth q = -I*zeroImaginaryOffset q := by
    rw [zeroImaginaryOffset_eq, ← mul_assoc, neg_mul, I_mul_I]
    ring
  rw [he]
  exact gaussianZeroExtension.mul_mem
    (gaussianZeroExtension.neg_mem gaussianUnit.property)
    (zeroExtension_le_gaussian (zeroImaginaryOffset_mem q))

/-- The infinite original-coordinate zero field is the Gaussian extension of its width field. -/
theorem gaussianZeroExtension_eq_realWidth_adjoin :
    gaussianZeroExtension = (realWidthField⟮I⟯).restrictScalars fullFibreSourceField := by
  apply le_antisymm
  · rw [gaussianZeroExtension_eq_adjoin]
    apply IntermediateField.adjoin_le_iff.mpr
    rintro z (rfl | ⟨q, rfl⟩)
    · change I ∈ realWidthField⟮I⟯
      exact IntermediateField.mem_adjoin_simple_self realWidthField I
    · have hw : zeroWidth q ∈ realWidthField⟮I⟯ :=
        IntermediateField.algebraMap_mem (realWidthField⟮I⟯)
          (⟨_, zeroWidth_mem_realWidthField q⟩ : realWidthField)
      have ht : ((xiSpectralPoint q).re : ℂ) ∈ realWidthField⟮I⟯ :=
        IntermediateField.algebraMap_mem (realWidthField⟮I⟯)
          (algebraMap fullFibreSourceField realWidthField
            ⟨_, ordinate_mem_fullFibreSourceField q⟩)
      have he : xiSpectralPoint q = ((xiSpectralPoint q).re : ℂ)+I*zeroWidth q := by
        rw [← zeroImaginaryOffset_eq]
        dsimp only [zeroImaginaryOffset]
        ring
      change xiSpectralPoint q ∈ realWidthField⟮I⟯
      rw [he]
      exact (realWidthField⟮I⟯).add_mem ht
        ((realWidthField⟮I⟯).mul_mem (IntermediateField.mem_adjoin_simple_self realWidthField I) hw)
  · rw [IntermediateField.restrictScalars_adjoin_eq_sup]
    exact sup_le realWidthField_le_gaussian
      (IntermediateField.adjoin_simple_le_iff.mpr gaussianUnit.property)

/-- Every element has real width-field coordinates in the basis `1,i`. -/
theorem gaussian_element_realWidth_repr (z : gaussianZeroExtension) :
    ∃ a b : realWidthField, (z : ℂ) = (a : ℂ)+(b : ℂ)*I := by
  have hz : (z : ℂ) ∈ realWidthField⟮I⟯ := by
    have hmem (x : ℂ) : x ∈ gaussianZeroExtension ↔ x ∈ realWidthField⟮I⟯ := by
      rw [gaussianZeroExtension_eq_realWidth_adjoin]
      rfl
    exact (hmem (z : ℂ)).mp z.property
  exact HTGeometry.exists_repr_of_mem_adjoin_sqrt
    (show I*I = algebraMap realWidthField ℂ (-1) by simp only [I_mul_I, map_neg, map_one]) hz

/-- The width field is exactly the maximal real subfield of the full Gaussian zero field. -/
theorem realWidthField_eq_real_part :
    realWidthField.toSubfield = gaussianZeroExtension.toSubfield ⊓ Complex.ofRealHom.fieldRange := by
  apply le_antisymm
  · exact fun z hz => ⟨realWidthField_le_gaussian hz, realWidthField_le_real hz⟩
  · intro z hz
    obtain ⟨a,b,hab⟩ := gaussian_element_realWidth_repr ⟨z,hz.1⟩
    obtain ⟨ar,har⟩ := realWidthField_le_real a.property
    obtain ⟨br,hbr⟩ := realWidthField_le_real b.property
    obtain ⟨zr,hzr⟩ := hz.2
    have him := congrArg Complex.im hab
    change z.im = (a : ℂ).im + ((b : ℂ)*I).im at him
    rw [← har, ← hbr, ← hzr] at him
    have hb0 : br = 0 := by simpa using him.symm
    change z = (a : ℂ)+(b : ℂ)*I at hab
    rw [← hbr, hb0] at hab
    have haz : z = (a : ℂ) := by simpa only [map_zero, zero_mul, add_zero] using hab
    rw [haz]
    exact a.property

/-- The central subgroup generated by ordinary complex conjugation. -/
def gaussianConjugationSubgroup : Subgroup
    (gaussianZeroExtension ≃ₐ[fullFibreSourceField] gaussianZeroExtension) :=
  Subgroup.zpowers gaussianZeroConjugation

instance gaussianConjugationSubgroup_normal : gaussianConjugationSubgroup.Normal := by
  have hc : gaussianZeroConjugation ∈ Subgroup.center
      (gaussianZeroExtension ≃ₐ[fullFibreSourceField] gaussianZeroExtension) := by
    apply Subgroup.mem_center_iff.mpr
    intro σ
    exact gaussianZeroConjugation_central σ
  have hH : gaussianConjugationSubgroup ≤ Subgroup.center
      (gaussianZeroExtension ≃ₐ[fullFibreSourceField] gaussianZeroExtension) :=
    Subgroup.zpowers_le.mpr hc
  refine ⟨fun a ha b => ?_⟩
  have hcomm := Subgroup.mem_center_iff.mp (hH ha) b
  simpa [hcomm] using ha

/-- Ordinary conjugation fixes precisely the entire width field. -/
theorem realWidthField_comap_eq_fixedField :
    realWidthField.comap (IntermediateField.val gaussianZeroExtension) =
      IntermediateField.fixedField gaussianConjugationSubgroup := by
  ext z
  rw [IntermediateField.mem_fixedField_iff]
  change (z : ℂ) ∈ realWidthField.toSubfield ↔ _
  rw [realWidthField_eq_real_part]
  constructor
  · intro hz
    obtain ⟨r,hr⟩ := hz.2
    have hc : gaussianZeroConjugation z = z := by
      apply Subtype.ext
      change (starRingEnd ℂ) (z : ℂ) = (z : ℂ)
      rw [← hr]
      simp
    have hsub : gaussianConjugationSubgroup ≤ MulAction.stabilizer
        (gaussianZeroExtension ≃ₐ[fullFibreSourceField] gaussianZeroExtension) z :=
      Subgroup.zpowers_le.mpr hc
    exact fun σ hσ => hsub hσ
  · intro h
    have hc := h gaussianZeroConjugation (Subgroup.mem_zpowers _)
    have him := congrArg (fun x : gaussianZeroExtension => (x : ℂ).im) hc
    change -(z : ℂ).im = (z : ℂ).im at him
    refine ⟨z.property, (z : ℂ).re, ?_⟩
    apply Complex.ext
    · rfl
    · change 0 = (z : ℂ).im
      linarith only [him]

/-- The whole real width field is algebraic and normal over the source field. -/
instance realWidthField_normal : Normal fullFibreSourceField realWidthField := by
  letI : IsGalois fullFibreSourceField gaussianZeroExtension := ⟨⟩
  have hn : Normal fullFibreSourceField
      (IntermediateField.fixedField gaussianConjugationSubgroup) := inferInstance
  rw [← realWidthField_comap_eq_fixedField] at hn
  letI := hn
  exact Normal.of_algEquiv (HTGeometry.comapValEquiv realWidthField_le_gaussian)


private theorem inclusion_algebraMap_coe (K : Subfield ℂ)
    (A B : IntermediateField K ℂ) (h : A ≤ B) (a : A) :
    letI : Algebra A B := (IntermediateField.inclusion h).toRingHom.toAlgebra
    (algebraMap A B a : ℂ) = (a : ℂ) := rfl

private theorem inclusion_complex_tower (K : Subfield ℂ)
    (A B : IntermediateField K ℂ) (h : A ≤ B) :
    letI : Algebra A B := (IntermediateField.inclusion h).toRingHom.toAlgebra
    IsScalarTower A B ℂ := by
  letI : Algebra A B := (IntermediateField.inclusion h).toRingHom.toAlgebra
  exact IsScalarTower.of_algebraMap_eq fun a => (inclusion_algebraMap_coe K A B h a).symm

private theorem prod_snd_apply {G H J A : Type*} [MulOneClass G] [MulOneClass H]
    [MulOneClass J] [MulOneClass A] (f : G →* H) (g : G →* J × A) (x : G) :
    ((f.prod ((MonoidHom.snd J A).comp g)) x).2 = (g x).2 := rfl

instance realWidthField_gaussianAlgebra : Algebra realWidthField gaussianZeroExtension :=
  (IntermediateField.inclusion realWidthField_le_gaussian).toRingHom.toAlgebra

instance realWidthField_gaussianSourceTower :
    IsScalarTower fullFibreSourceField realWidthField gaussianZeroExtension :=
  IsScalarTower.of_algebraMap_eq fun _ => rfl

private theorem realWidth_gaussian_map_coe (a : realWidthField) :
    (algebraMap realWidthField gaussianZeroExtension a : ℂ) = (a : ℂ) :=
  inclusion_algebraMap_coe fullFibreSourceField realWidthField gaussianZeroExtension
    realWidthField_le_gaussian a

instance realWidthField_gaussianComplexTower :
    IsScalarTower realWidthField gaussianZeroExtension ℂ :=
  inclusion_complex_tower fullFibreSourceField realWidthField gaussianZeroExtension
    realWidthField_le_gaussian

private theorem gaussian_conjugation_coe (z : gaussianZeroExtension) :
    (gaussianZeroConjugation z : ℂ) = (starRingEnd ℂ) (z : ℂ) := rfl

/-- Restriction to the real widths and sign on `i` are the two arithmetic coordinates. -/
def realWidthActionCoordinates :
    (gaussianZeroExtension ≃ₐ[fullFibreSourceField] gaussianZeroExtension) →*
      (realWidthField ≃ₐ[fullFibreSourceField] realWidthField) × ℤˣ :=
  (AlgEquiv.restrictNormalHom realWidthField).prod
    ((MonoidHom.snd _ _).comp gaussianActionCoordinates)

private theorem realWidthActionCoordinates_sign
    (σ : gaussianZeroExtension ≃ₐ[fullFibreSourceField] gaussianZeroExtension) :
    (realWidthActionCoordinates σ).2 = (gaussianActionCoordinates σ).2 :=
  prod_snd_apply (AlgEquiv.restrictNormalHom realWidthField) gaussianActionCoordinates σ

private theorem realWidthActionCoordinates_unit
    (σ : gaussianZeroExtension ≃ₐ[fullFibreSourceField] gaussianZeroExtension) :
    σ gaussianUnit = (((realWidthActionCoordinates σ).2 : ℤ) : gaussianZeroExtension)*gaussianUnit := by
  rw [realWidthActionCoordinates_sign]
  exact gaussianActionCoordinates_unit σ

private theorem gaussianConjugation_realWidth (a : realWidthField) :
    gaussianZeroConjugation (algebraMap realWidthField gaussianZeroExtension a) =
      algebraMap realWidthField gaussianZeroExtension a := by
  apply Subtype.ext
  rw [gaussian_conjugation_coe, realWidth_gaussian_map_coe]
  obtain ⟨r,hr⟩ := realWidthField_le_real a.property
  rw [← hr]
  simp

private theorem gaussianConjugation_restrict_realWidth :
    gaussianZeroConjugation.restrictNormal realWidthField = 1 := by
  apply AlgEquiv.ext
  intro a
  apply (algebraMap realWidthField gaussianZeroExtension).injective
  rw [AlgEquiv.restrictNormal_commutes, gaussianConjugation_realWidth]
  rfl

/-- Ordinary conjugation occupies exactly the independent Gaussian factor. -/
theorem realWidth_conjugation_coordinates :
    realWidthActionCoordinates gaussianZeroConjugation = (1,-1) := by
  apply Prod.ext
  · exact gaussianConjugation_restrict_realWidth
  · change (realWidthActionCoordinates gaussianZeroConjugation).2 = -1
    rw [realWidthActionCoordinates_sign]
    have h := congrArg Prod.snd gaussian_conjugation_coordinates
    exact h

private theorem realWidthActionCoordinates_injective :
    Function.Injective realWidthActionCoordinates := by
  intro σ τ he
  have hbase : ∀ a : realWidthField,
      σ (algebraMap realWidthField gaussianZeroExtension a) =
        τ (algebraMap realWidthField gaussianZeroExtension a) := by
    intro a
    rw [← AlgEquiv.restrictNormal_commutes σ realWidthField,
      ← AlgEquiv.restrictNormal_commutes τ realWidthField]
    exact congrArg (fun η : realWidthField ≃ₐ[fullFibreSourceField] realWidthField =>
      algebraMap realWidthField gaussianZeroExtension (η a)) (congrArg Prod.fst he)
  have hI : σ gaussianUnit = τ gaussianUnit := by
    rw [realWidthActionCoordinates_unit, realWidthActionCoordinates_unit]
    have hs := congrArg Prod.snd he
    exact congrArg (fun ε : ℤˣ => ((ε : ℤ) : gaussianZeroExtension)*gaussianUnit) hs
  apply AlgEquiv.ext
  intro z
  obtain ⟨a,b,hab⟩ := gaussian_element_realWidth_repr z
  have hz : z = algebraMap realWidthField gaussianZeroExtension a +
      algebraMap realWidthField gaussianZeroExtension b * gaussianUnit := by
    apply Subtype.ext
    change (z : ℂ) = (algebraMap realWidthField gaussianZeroExtension a : ℂ) +
      (algebraMap realWidthField gaussianZeroExtension b : ℂ)*I
    rw [realWidth_gaussian_map_coe, realWidth_gaussian_map_coe]
    exact hab
  rw [hz, map_add, map_mul, map_add, map_mul, hbase a, hbase b, hI]

private theorem realWidthActionCoordinates_surjective :
    Function.Surjective realWidthActionCoordinates := by
  classical
  rintro ⟨τ,ε⟩
  obtain ⟨σ,hσ⟩ := AlgEquiv.restrictNormalHom_surjective
    (F := fullFibreSourceField) (K₁ := realWidthField) gaussianZeroExtension τ
  let η := (realWidthActionCoordinates σ).2
  have hcoord : realWidthActionCoordinates σ = (τ,η) := Prod.ext hσ rfl
  by_cases he : η = ε
  · exact ⟨σ, by rw [hcoord, he]⟩
  · refine ⟨gaussianZeroConjugation * σ, ?_⟩
    rw [map_mul, realWidth_conjugation_coordinates, hcoord]
    apply Prod.ext
    · exact one_mul τ
    · change (-1 : ℤˣ)*η = ε
      rcases Int.units_eq_one_or η with hη | hη <;>
        rcases Int.units_eq_one_or ε with hε | hε <;>
        simp [hη,hε] at he ⊢

/-- Unconditionally, the infinite Galois group is the real width group times `C₂`. -/
def realWidthGaloisProduct :
    (gaussianZeroExtension ≃ₐ[fullFibreSourceField] gaussianZeroExtension) ≃*
      (realWidthField ≃ₐ[fullFibreSourceField] realWidthField) × ℤˣ :=
  MulEquiv.ofBijective realWidthActionCoordinates
    ⟨realWidthActionCoordinates_injective, realWidthActionCoordinates_surjective⟩


/-- The signed width as an element of the complete real width field. -/
def zeroWidthInField (q : XiZeroCopy) : realWidthField :=
  ⟨zeroWidth q,zeroWidth_mem_realWidthField q⟩

private def sourceOrdinate (q : XiZeroCopy) : fullFibreSourceField :=
  ⟨((xiSpectralPoint q).re : ℂ),ordinate_mem_fullFibreSourceField q⟩

private theorem gaussian_width_formula (q : XiZeroCopy) :
    algebraMap realWidthField gaussianZeroExtension (zeroWidthInField q) =
      -gaussianUnit * (centeredZeroInGaussianExtension q -
        algebraMap fullFibreSourceField gaussianZeroExtension (sourceOrdinate q)) := by
  apply Subtype.ext
  change zeroWidth q = -I * zeroImaginaryOffset q
  rw [zeroImaginaryOffset_eq, ← mul_assoc, neg_mul, I_mul_I]
  ring

private theorem originalZero_width_formula (q : XiZeroCopy) :
    originalZeroInGaussianExtension q =
      1/2 - algebraMap realWidthField gaussianZeroExtension (zeroWidthInField q) +
        gaussianUnit * algebraMap fullFibreSourceField gaussianZeroExtension (sourceOrdinate q) := by
  apply Subtype.ext
  change 1/2+I*xiSpectralPoint q =
    1/2-zeroWidth q+I*((xiSpectralPoint q).re : ℂ)
  have h := zeroImaginaryOffset_eq q
  dsimp only [zeroImaginaryOffset] at h
  have hI : I*I = (-1 : ℂ) := I_mul_I
  linear_combination I*h + zeroWidth q*hI

private theorem width_negation_gives_reflection
    (τ : realWidthField ≃ₐ[fullFibreSourceField] realWidthField)
    (hτ : ∀ q, τ (zeroWidthInField q) = -zeroWidthInField q) :
    ∃ σ : gaussianZeroExtension ≃ₐ[fullFibreSourceField] gaussianZeroExtension,
      ∀ q, σ (originalZeroInGaussianExtension q) = 1-originalZeroInGaussianExtension q := by
  obtain ⟨σ,hσ⟩ := realWidthActionCoordinates_surjective (τ,-1)
  have hb := congrArg Prod.fst hσ
  have hs := congrArg Prod.snd hσ
  have hI : σ gaussianUnit = -gaussianUnit := by
    have h := realWidthActionCoordinates_unit σ
    rw [hs] at h
    simpa only [Units.val_neg, Units.val_one, Int.cast_neg, Int.cast_one, neg_one_mul] using h
  have hw (q : XiZeroCopy) :
      σ (algebraMap realWidthField gaussianZeroExtension (zeroWidthInField q)) =
        -algebraMap realWidthField gaussianZeroExtension (zeroWidthInField q) := by
    rw [← AlgEquiv.restrictNormal_commutes σ realWidthField]
    change algebraMap realWidthField gaussianZeroExtension
      ((realWidthActionCoordinates σ).1 (zeroWidthInField q)) = _
    rw [hb,hτ,map_neg]
  refine ⟨σ,fun q => ?_⟩
  rw [originalZero_width_formula, map_add, map_sub, map_div₀, map_one, map_ofNat,
    map_mul, hw, hI, σ.commutes]
  ring

private theorem reflection_gives_width_negation
    (σ : gaussianZeroExtension ≃ₐ[fullFibreSourceField] gaussianZeroExtension)
    (hσ : ∀ q, σ (originalZeroInGaussianExtension q) = 1-originalZeroInGaussianExtension q) :
    ∃ τ : realWidthField ≃ₐ[fullFibreSourceField] realWidthField,
      ∀ q, τ (zeroWidthInField q) = -zeroWidthInField q := by
  refine ⟨σ.restrictNormal realWidthField,fun q => ?_⟩
  apply (algebraMap realWidthField gaussianZeroExtension).injective
  rw [AlgEquiv.restrictNormal_commutes, map_neg]
  rw [gaussian_width_formula, map_mul, map_neg, map_sub,
    gaussian_reflection_forces_flip σ hσ, gaussian_reflection_fixes_centered σ hσ,
    σ.commutes]
  ring

/-- The simultaneous width-negation action is equivalent to the functional-equation lift. -/
theorem realWidth_negation_iff_functional_equation :
    (∃ τ : realWidthField ≃ₐ[fullFibreSourceField] realWidthField,
      ∀ q, τ (zeroWidthInField q) = -zeroWidthInField q) ↔
    (∃ σ : gaussianZeroExtension ≃ₐ[fullFibreSourceField] gaussianZeroExtension,
      ∀ q, σ (originalZeroInGaussianExtension q) = 1-originalZeroInGaussianExtension q) :=
  ⟨fun ⟨τ,hτ⟩ => width_negation_gives_reflection τ hτ,
    fun ⟨σ,hσ⟩ => reflection_gives_width_negation σ hσ⟩

/-- A simultaneous signed-width reversal exists exactly in the Gaussian product regime. -/
theorem realWidth_negation_iff :
    (∃ τ : realWidthField ≃ₐ[fullFibreSourceField] realWidthField,
      ∀ q, τ (zeroWidthInField q) = -zeroWidthInField q) ↔ I ∉ fullFibreZeroExtension := by
  rw [realWidth_negation_iff_functional_equation, functional_equation_lift_iff]

/-- A nonzero width obstructs its own negation precisely when it already lies in the even field. -/
theorem realWidth_negation_iff_anchor (q : XiZeroCopy) (hq : zeroWidth q ≠ 0) :
    (∃ τ : realWidthField ≃ₐ[fullFibreSourceField] realWidthField,
      ∀ r, τ (zeroWidthInField r) = -zeroWidthInField r) ↔ zeroWidth q ∉ evenWidthField := by
  rw [realWidth_negation_iff, gaussianUnit_mem_zeroExtension_iff_width_mem q hq]

/-- The global width reversal, when it exists, is unique. -/
theorem realWidth_negation_unique
    (σ τ : realWidthField ≃ₐ[fullFibreSourceField] realWidthField)
    (hσ : ∀ q, σ (zeroWidthInField q) = -zeroWidthInField q)
    (hτ : ∀ q, τ (zeroWidthInField q) = -zeroWidthInField q) : σ = τ := by
  have heq := IntermediateField.algHom_ext_of_eq_adjoin fullFibreSourceField
    (S := realWidthField) rfl (φ₁ := σ.toAlgHom) (φ₂ := τ.toAlgHom)
    (by rintro z ⟨q,rfl⟩; exact (hσ q).trans (hτ q).symm)
  exact AlgEquiv.ext fun z => DFunLike.congr_fun heq z

end GaloisForLFunctions.GaloisTheoryOfZeros

