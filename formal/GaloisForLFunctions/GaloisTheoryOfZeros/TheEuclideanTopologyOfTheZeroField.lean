import GaloisForLFunctions.GaloisTheoryOfZeros.TheQuadraticCharactersOfConjugation

/-!
# Euclidean regularity of the zero-field action

Let `K` be the complete-fibre source field, `L` the centered zero field,
and `E = L ∩ ℝ`. The subgroup fixing `E` consists of identity and centered
conjugation. These are exactly the Euclidean-continuous source automorphisms,
and exactly those bounded on the whole field's unit ball. Every other action
amplifies arbitrarily small elements of `E` without bound.

All source automorphisms nevertheless move each centered zero by less than one.
Individual Krull orbit maps are continuous; joint Krull-by-Euclidean continuity
of the full action is equivalent to `E = K`.
-/

noncomputable section
set_option autoImplicit false
open Complex Set RHTower
open scoped IntermediateField
namespace GaloisForLFunctions.GaloisTheoryOfZeros

/-- A moved real element and rational approximation produce unbounded amplification near zero. -/
private theorem real_point_amplification {A : Type*} [Field A] [CharZero A]
    (v f : A →+* ℂ) (a : A) (r : ℝ) (ha : v a = (r : ℂ)) (hm : f a ≠ v a)
    (ε M : ℝ) (hε : 0 < ε) (hM : 0 < M) :
    ∃ (n : ℕ) (q : ℚ), ‖v ((n : A)*(a-(q : A)))‖ < ε ∧
      M < ‖f ((n : A)*(a-(q : A)))‖ := by
  let D := ‖f a-v a‖
  have hD : 0 < D := norm_pos_iff.mpr (sub_ne_zero.mpr hm)
  obtain ⟨n,hn⟩ := exists_nat_gt (2*M/D)
  have hn0 : (0 : ℝ) < n := (div_pos (mul_pos (by norm_num) hM) hD).trans hn
  have hnM : M < (n : ℝ)*(D/2) := by
    have h := (div_lt_iff₀ hD).mp hn
    nlinarith only [h]
  let δ := min (ε/(n : ℝ)) (D/2)
  have hδ : 0 < δ := lt_min (div_pos hε hn0) (half_pos hD)
  -- Approximate the original value, retaining a fixed separation from its image.
  obtain ⟨q,hql,hqr⟩ := exists_rat_btwn (show r-δ < r+δ by linarith only [hδ])
  have hq : |r-(q : ℝ)| < δ := by
    rw [abs_lt]
    constructor <;> linarith only [hql,hqr]
  have hqε : |r-(q : ℝ)| < ε/(n : ℝ) := hq.trans_le (min_le_left _ _)
  have hqD : |r-(q : ℝ)| < D/2 := hq.trans_le (min_le_right _ _)
  have hnC : ‖(n : ℂ)‖ = (n : ℝ) := by simp
  have hqC : (q : ℂ) = ((q : ℝ) : ℂ) := (map_ratCast Complex.ofRealHom q).symm
  have hva : ‖v a-(q : ℂ)‖ = |r-(q : ℝ)| := by
    rw [ha,hqC,← Complex.ofReal_sub,Complex.norm_real,Real.norm_eq_abs]
  have htri : D ≤ ‖f a-(q : ℂ)‖+|r-(q : ℝ)| := by
    calc
      D = ‖(f a-(q : ℂ))-(v a-(q : ℂ))‖ := congrArg norm (by ring)
      _ ≤ ‖f a-(q : ℂ)‖+‖v a-(q : ℂ)‖ := norm_sub_le _ _
      _ = _ := by rw [hva]
  have hfa : D/2 < ‖f a-(q : ℂ)‖ := by linarith only [htri,hqD]
  refine ⟨n,q,?_,?_⟩
  · rw [map_mul,map_sub,map_natCast,map_ratCast,norm_mul,hnC,hva]
    calc
      (n : ℝ)*|r-(q : ℝ)| < (n : ℝ)*(ε/(n : ℝ)) := mul_lt_mul_of_pos_left hqε hn0
      _ = ε := by field_simp
  · rw [map_mul,map_sub,map_natCast,map_ratCast,norm_mul,hnC]
    exact hnM.trans (mul_lt_mul_of_pos_left hfa hn0)

private theorem involution_zpowers {G : Type*} [Group G] (c : G) (hc : c*c = 1) (g : G) :
    g ∈ Subgroup.zpowers c ↔ g = 1 ∨ g = c := by
  have hci : c⁻¹ = c := by
    calc
      c⁻¹ = c⁻¹*(c*c) := by rw [hc,mul_one]
      _ = c := by rw [← mul_assoc,inv_mul_cancel,one_mul]
  let H : Subgroup G :=
    { carrier := {x | x = 1 ∨ x = c}
      one_mem' := Or.inl rfl
      mul_mem' := by
        intro x y hx hy
        rcases hx with hx | hx <;> rcases hy with hy | hy
        · rw [hx,hy]; exact Or.inl (one_mul 1)
        · rw [hx,hy]; exact Or.inr (one_mul c)
        · rw [hx,hy]; exact Or.inr (mul_one c)
        · rw [hx,hy]; exact Or.inl hc
      inv_mem' := by
        intro x hx
        rcases hx with hx | hx
        · rw [hx]; exact Or.inl inv_one
        · rw [hx]; exact Or.inr hci }
  constructor
  · intro hg
    exact (Subgroup.zpowers_le.mpr (show c ∈ H from Or.inr rfl)) hg
  · intro hg
    rcases hg with hg | hg
    · rw [hg]; exact Subgroup.one_mem _
    · rw [hg]; exact Subgroup.mem_zpowers c

private theorem centered_conjugation_mul_self :
    fullFibreZeroConjugation*fullFibreZeroConjugation = 1 := by
  apply AlgEquiv.ext
  intro z
  apply Subtype.ext
  exact star_star (z : ℂ)

/-- The subgroup generated by centered conjugation consists exactly of its two possible actions. -/
theorem centeredConjugationSubgroup_mem_iff
    (σ : fullFibreZeroExtension ≃ₐ[fullFibreSourceField] fullFibreZeroExtension) :
    σ ∈ centeredConjugationSubgroup ↔ σ = 1 ∨ σ = fullFibreZeroConjugation :=
  involution_zpowers fullFibreZeroConjugation centered_conjugation_mul_self σ

/-- The full subgroup fixing the real part has at most two elements, even for the infinite extension. -/
theorem evenWidthInCentered_fixingSubgroup :
    evenWidthInCentered.fixingSubgroup = centeredConjugationSubgroup := by
  letI : IsGalois fullFibreSourceField fullFibreZeroExtension := ⟨⟩
  have hf : (centeredConjugationSubgroup : Set
      (fullFibreZeroExtension ≃ₐ[fullFibreSourceField] fullFibreZeroExtension)).Finite := by
    apply ((Set.finite_singleton fullFibreZeroConjugation).insert 1).subset
    intro σ hσ
    simpa only [Set.mem_insert_iff,Set.mem_singleton_iff] using
      (centeredConjugationSubgroup_mem_iff σ).mp hσ
  -- Finite conjugation subgroup is closed, so infinite Galois correspondence is exact.
  let H : ClosedSubgroup
      (fullFibreZeroExtension ≃ₐ[fullFibreSourceField] fullFibreZeroExtension) :=
    ⟨centeredConjugationSubgroup,hf.isClosed⟩
  change (evenWidthField.comap (IntermediateField.val fullFibreZeroExtension)).fixingSubgroup = _
  rw [evenWidthField_comap_eq_fixedField]
  exact InfiniteGalois.fixingSubgroup_fixedField H

/-- Fixing all real elements is equivalent to being identity or centered conjugation. -/
theorem source_aut_fixes_real_iff
    (σ : fullFibreZeroExtension ≃ₐ[fullFibreSourceField] fullFibreZeroExtension) :
    (∀ a : evenWidthInCentered, σ (a : fullFibreZeroExtension) = a) ↔
      σ = 1 ∨ σ = fullFibreZeroConjugation := by
  have hmem : σ ∈ evenWidthInCentered.fixingSubgroup ↔
      ∀ a : evenWidthInCentered, σ (a : fullFibreZeroExtension) = a := by
    rw [IntermediateField.mem_fixingSubgroup_iff]
    constructor
    · intro h a
      exact h a a.property
    · intro h z hz
      exact h ⟨z,hz⟩
  rw [← hmem,evenWidthInCentered_fixingSubgroup,centeredConjugationSubgroup_mem_iff]

/-- Every other source automorphism has arbitrarily large amplification on arbitrarily small real elements. -/
theorem source_aut_amplification
    (σ : fullFibreZeroExtension ≃ₐ[fullFibreSourceField] fullFibreZeroExtension)
    (hσ : σ ≠ 1) (hc : σ ≠ fullFibreZeroConjugation)
    (ε M : ℝ) (hε : 0 < ε) (hM : 0 < M) :
    ∃ z : evenWidthInCentered, ‖((z : fullFibreZeroExtension) : ℂ)‖ < ε ∧
      M < ‖(σ (z : fullFibreZeroExtension) : ℂ)‖ := by
  obtain ⟨a,ha⟩ : ∃ a : evenWidthInCentered, σ (a : fullFibreZeroExtension) ≠ a := by
    by_contra! h
    exact ((source_aut_fixes_real_iff σ).mp h).elim hσ hc
  obtain ⟨r,hr⟩ := evenWidthField_le_real a.property
  let v := (IntermediateField.val fullFibreZeroExtension).toRingHom
  let f := v.comp σ.toRingHom
  have hv : v (a : fullFibreZeroExtension) = (r : ℂ) := hr.symm
  have hm : f (a : fullFibreZeroExtension) ≠ v (a : fullFibreZeroExtension) :=
    fun h => ha (Subtype.ext h)
  obtain ⟨n,q,hsmall,hlarge⟩ := real_point_amplification v f
    (a : fullFibreZeroExtension) r hv hm ε M hε hM
  let z : evenWidthInCentered :=
    ⟨(n : fullFibreZeroExtension)*((a : fullFibreZeroExtension)-(q : fullFibreZeroExtension)),
      evenWidthInCentered.mul_mem (evenWidthInCentered.natCast_mem n)
        (evenWidthInCentered.sub_mem a.property (by simpa only [map_ratCast] using
          (evenWidthInCentered.algebraMap_mem (q : fullFibreSourceField))))⟩
  exact ⟨z,hsmall,hlarge⟩

/-- Euclidean continuity of the field action singles out identity and centered conjugation. -/
theorem source_aut_euclidean_continuous_iff
    (σ : fullFibreZeroExtension ≃ₐ[fullFibreSourceField] fullFibreZeroExtension) :
    Continuous (fun z : fullFibreZeroExtension => (σ z : ℂ)) ↔
      σ = 1 ∨ σ = fullFibreZeroConjugation := by
  constructor
  · intro hcont
    by_contra! h
    obtain ⟨ε,hε,hball⟩ := (Metric.continuousAt_iff.mp
      (hcont.continuousAt (x := (0 : fullFibreZeroExtension)))) 1 zero_lt_one
    obtain ⟨z,hsmall,hlarge⟩ := source_aut_amplification σ h.1 h.2 ε 1 hε zero_lt_one
    have hz : dist (z : fullFibreZeroExtension) 0 < ε := by simpa using hsmall
    have himage : ‖(σ (z : fullFibreZeroExtension) : ℂ)‖ < 1 := by simpa using hball hz
    exact (not_lt_of_ge himage.le) hlarge
  · rintro (rfl | rfl)
    · exact continuous_subtype_val
    · change Continuous (fun z : fullFibreZeroExtension => (starRingEnd ℂ) (z : ℂ))
      exact continuous_star.comp continuous_subtype_val

/-- A bound on the whole field's unit ball has the same exact rigidity as continuity. -/
theorem source_aut_bounded_iff
    (σ : fullFibreZeroExtension ≃ₐ[fullFibreSourceField] fullFibreZeroExtension) :
    (∃ B : ℝ, ∀ z : fullFibreZeroExtension, ‖(z : ℂ)‖ ≤ 1 → ‖(σ z : ℂ)‖ ≤ B) ↔
      σ = 1 ∨ σ = fullFibreZeroConjugation := by
  constructor
  · rintro ⟨B,hB⟩
    by_contra! h
    obtain ⟨z,hsmall,hlarge⟩ := source_aut_amplification σ h.1 h.2 1 (|B|+1)
      zero_lt_one (by positivity)
    have hle := hB (z : fullFibreZeroExtension) hsmall.le
    linarith only [hlarge,hle,le_abs_self B]
  · rintro (rfl | rfl)
    · exact ⟨1,fun z hz => hz⟩
    · refine ⟨1,fun z hz => ?_⟩
      change ‖star (z : ℂ)‖ ≤ 1
      simpa only [norm_star] using hz

/-- Every source automorphism is Euclidean-continuous exactly when the real part equals the source. -/
theorem all_source_auts_euclidean_continuous_iff :
    (∀ σ : fullFibreZeroExtension ≃ₐ[fullFibreSourceField] fullFibreZeroExtension,
      Continuous (fun z : fullFibreZeroExtension => (σ z : ℂ))) ↔
      evenWidthField.toSubfield = fullFibreSourceField := by
  letI : IsGalois fullFibreSourceField fullFibreZeroExtension := ⟨⟩
  constructor
  · intro hall
    apply le_antisymm
    · intro z hz
      let a : evenWidthInCentered := ⟨⟨z,evenWidthField_le_zeroExtension hz⟩,hz⟩
      have hfix : ∀ σ : fullFibreZeroExtension ≃ₐ[fullFibreSourceField] fullFibreZeroExtension,
          σ (a : fullFibreZeroExtension) = a := fun σ =>
        (source_aut_fixes_real_iff σ).mpr ((source_aut_euclidean_continuous_iff σ).mp (hall σ)) a
      obtain ⟨k,hk⟩ := (InfiniteGalois.mem_range_algebraMap_iff_fixed
        (a : fullFibreZeroExtension)).mpr hfix
      have he : (k : ℂ) = z := congrArg (fun x : fullFibreZeroExtension => (x : ℂ)) hk
      exact he ▸ k.property
    · intro z hz
      exact evenWidthField.algebraMap_mem (⟨z,hz⟩ : fullFibreSourceField)
  · intro hE σ
    apply (source_aut_euclidean_continuous_iff σ).mpr
    apply (source_aut_fixes_real_iff σ).mp
    intro a
    have ha : ((a : fullFibreZeroExtension) : ℂ) ∈ fullFibreSourceField :=
      (congrArg (fun E : Subfield ℂ => ((a : fullFibreZeroExtension) : ℂ) ∈ E) hE).mp a.property
    let k : fullFibreSourceField := ⟨((a : fullFibreZeroExtension) : ℂ),ha⟩
    exact σ.commutes k

/-- Every source automorphism has uniformly bounded displacement on the entire zero carrier. -/
theorem source_aut_zero_displacement_lt_one
    (σ : fullFibreZeroExtension ≃ₐ[fullFibreSourceField] fullFibreZeroExtension) (q : XiZeroCopy) :
    ‖(σ (centeredZeroInFibreExtension q) : ℂ)-xiSpectralPoint q‖ < 1 := by
  obtain ⟨q',hq',he⟩ := fullFibre_aut_preserves_ordinate σ q
  have hre := (mem_ordinateFibreCopies _ _).mp hq'
  have him := xiSpectralPoint_im_mem_openHalf q
  have him' := xiSpectralPoint_im_mem_openHalf q'
  rw [he]
  have hd : xiSpectralPoint q'-xiSpectralPoint q =
      (((xiSpectralPoint q').im-(xiSpectralPoint q).im : ℝ) : ℂ)*I := by
    apply Complex.ext <;> simp [hre]
  rw [hd,norm_mul,Complex.norm_real,Real.norm_eq_abs,Complex.norm_I,mul_one,abs_lt]
  constructor <;> linarith only [him.1,him.2,him'.1,him'.2]

/-- Every individual orbit map is continuous in the Krull topology, even when the field action is discontinuous. -/
theorem source_aut_orbit_continuous (z : fullFibreZeroExtension) :
    Continuous (fun σ : fullFibreZeroExtension ≃ₐ[fullFibreSourceField] fullFibreZeroExtension =>
      (σ z : ℂ)) := by
  apply continuous_iff_continuousAt.mpr
  intro σ
  have hopen : IsOpen {τ : fullFibreZeroExtension ≃ₐ[fullFibreSourceField] fullFibreZeroExtension |
      (σ⁻¹*τ) z = z} :=
    (stabilizer_isOpen_of_isIntegral (K := fullFibreSourceField) (L := fullFibreZeroExtension) z).preimage
      (continuous_const.mul continuous_id)
  have hmem : (σ⁻¹*σ) z = z := by rw [inv_mul_cancel]; rfl
  have hevent : ∀ᶠ τ in nhds σ, (σ⁻¹*τ) z = z := hopen.mem_nhds hmem
  apply tendsto_const_nhds.congr'
  filter_upwards [hevent] with τ hτ
  have he := congrArg σ hτ
  change σ (σ.symm (τ z)) = σ z at he
  rw [σ.apply_symm_apply] at he
  exact (congrArg (fun x : fullFibreZeroExtension => (x : ℂ)) he).symm

/-- Joint continuity of the Krull-by-Euclidean action is exactly real-source saturation. -/
theorem source_aut_joint_continuous_iff :
    Continuous (fun p :
      (fullFibreZeroExtension ≃ₐ[fullFibreSourceField] fullFibreZeroExtension) ×
        fullFibreZeroExtension => (p.1 p.2 : ℂ)) ↔
      evenWidthField.toSubfield = fullFibreSourceField := by
  constructor
  · intro h
    apply all_source_auts_euclidean_continuous_iff.mp
    intro σ
    exact h.comp (continuous_const.prodMk continuous_id)
  · intro hE
    have hall := all_source_auts_euclidean_continuous_iff.mpr hE
    have hfin : (Set.univ : Set
        (fullFibreZeroExtension ≃ₐ[fullFibreSourceField] fullFibreZeroExtension)).Finite := by
      apply ((Set.finite_singleton fullFibreZeroConjugation).insert 1).subset
      intro σ _
      simpa only [Set.mem_insert_iff,Set.mem_singleton_iff] using
        (source_aut_euclidean_continuous_iff σ).mp (hall σ)
    letI : Finite (fullFibreZeroExtension ≃ₐ[fullFibreSourceField] fullFibreZeroExtension) :=
      Set.finite_univ_iff.mp hfin
    exact continuous_prod_of_discrete_left.mpr hall

