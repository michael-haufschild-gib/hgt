import GaloisForLFunctions.GaloisTheoryOfZeros.TheMonodromyOverAUnionOfTwoRegionsComesFromTheRegions
import GaloisForLFunctions.GaloisTheoryOfZeros.TheTurnAroundAForwardBranchTimeIsANontrivialForwardMonodromy

/-!
# The turns generate the forward monodromy group

A *lasso* at the base time `b` is a forward path `δ` from `b` (the tail), a loop at the end of
`δ` (the head), and `δ` reversed. Its transport is the transport of the head conjugated by the
transport along the tail.

* `LassosIn D C b N`: every lasso with tail inside `D` and head inside `C` has its transport
  in the subgroup `N` of the permutations of the fibre over `b`.
* `TurnsIn D b N`: around every branch time of `D` there are arbitrarily small turns whose
  lassos with tail inside `D` have their transports in `N`.
* **Generation over a convex region** (`loopsIn_of_turnsIn`). Let `D` be a convex open set of
  forward times. If `TurnsIn D b N`, every forward loop inside `D` based at `b` has its
  transport in `N`.

  Proof. The loop lies in a bounded convex open part `C` of `D`, which contains finitely many
  branch times. Induction on their number. Without branch times the transports are trivial.
  With one branch time `p`, three open half-planes with `p` on the boundary cover
  `C ∖ {p}`; the first two glue to a region with trivial monodromy, and in the gluing with the
  third the two ways around `p` differ by the turn. With two branch times, a strip between
  two parallel lines without branch times separates them, and the two sides overlap in the
  strip.
* **Generation** (`forwardMonodromy_eq_closure_turnLassos`). The forward monodromy group at
  `b` is generated by the lassos whose heads are turns around the forward branch times.
-/

open Complex Set Metric
open RHTower

namespace GaloisForLFunctions.GaloisTheoryOfZeros

noncomputable section
set_option autoImplicit false

variable {b : ℂ}

/-! ## Lassos -/

/-- The permutations of the fibre over the end of the tail `δ` whose conjugates by the
transport along `δ` lie in `N`. -/
def tailComap {δ : ℝ → ℂ} (hδ : IsForwardPath δ) {y : ℂ} (d0 : δ 0 = b) (d1 : δ 1 = y)
    (N : Subgroup (Equiv.Perm (Fibre b))) : Subgroup (Equiv.Perm (Fibre y)) :=
  N.comap (hδ.fibreEquiv d0 d1).symm.permCongrHom.toMonoidHom

theorem mem_tailComap {δ : ℝ → ℂ} (hδ : IsForwardPath δ) {y : ℂ} (d0 : δ 0 = b) (d1 : δ 1 = y)
    {N : Subgroup (Equiv.Perm (Fibre b))} {σ : Equiv.Perm (Fibre y)} :
    σ ∈ tailComap hδ d0 d1 N ↔
      ((hδ.fibreEquiv d0 d1).trans σ).trans (hδ.fibreEquiv d0 d1).symm ∈ N := by
  rw [tailComap, Subgroup.mem_comap]
  rfl

/-- Every lasso from `b` with tail inside `D` and head inside `C` has its transport in `N`. -/
def LassosIn (D C : Set ℂ) (b : ℂ) (N : Subgroup (Equiv.Perm (Fibre b))) : Prop :=
  ∀ (δ : ℝ → ℂ) (hδ : IsForwardPath δ) (d0 : δ 0 = b) (y : ℂ) (d1 : δ 1 = y),
    (∀ s ∈ Icc (0 : ℝ) 1, δ s ∈ D) → LoopsIn C y (tailComap hδ d0 d1 N)

theorem LassosIn.mono_offBranch {D C C' : Set ℂ} {N : Subgroup (Equiv.Perm (Fibre b))}
    (h : LassosIn D C' b N) (hsub : ∀ τ ∈ C, τ ∉ branchTimes → τ ∈ C') : LassosIn D C b N :=
  fun δ hδ d0 y d1 hδD γ hγ g0 g1 hγC =>
    h δ hδ d0 y d1 hδD γ hγ g0 g1 fun s hs => hsub _ (hγC s hs) (hγ.simple s hs)

theorem lassosIn_of_convex {D U : Set ℂ} (hU : Convex ℝ U) (hpos : ∀ τ ∈ U, 0 < τ.re)
    (hb : ∀ τ ∈ U, τ ∉ branchTimes) (N : Subgroup (Equiv.Perm (Fibre b))) : LassosIn D U b N :=
  fun _ _ _ y _ _ => loopsIn_of_convex hU hpos hb y _

/-- **Gluing of lassos.** The tail is prolonged to a common time `x₀` of the two regions, and
the head is conjugated to a loop at `x₀`. -/
theorem lassosIn_union {D C₁ C₂ : Set ℂ} {N : Subgroup (Equiv.Perm (Fibre b))}
    (hC₁ : IsOpen C₁) (hC₂ : IsOpen C₂) (hD₁ : C₁ ⊆ D) (hD₂ : C₂ ⊆ D)
    (h₁ : LassosIn D C₁ b N) (h₂ : LassosIn D C₂ b N) {x₀ : ℂ} (hc₁ : JoinedIn C₁ x₀)
    (hc₂ : JoinedIn C₂ x₀)
    (hJ : ∀ (δ : ℝ → ℂ) (hδ : IsForwardPath δ) (d0 : δ 0 = b) (d1 : δ 1 = x₀),
      (∀ s ∈ Icc (0 : ℝ) 1, δ s ∈ D) → Junction C₁ C₂ x₀ (tailComap hδ d0 d1 N)) :
    LassosIn D (C₁ ∪ C₂) b N := by
  intro δ hδ d0 y d1 hδD γ hγ g0 g1 hγC
  have h00 : (0 : ℝ) ∈ Icc (0 : ℝ) 1 := ⟨le_rfl, zero_le_one⟩
  have hy : y ∈ C₁ ∪ C₂ := g0 ▸ hγC 0 h00
  have hypos : 0 < y.re := g0 ▸ hγ.re_pos 0 h00
  have hyb : y ∉ branchTimes := g0 ▸ hγ.simple 0 h00
  -- a path from the common time to the base of the head
  obtain ⟨θ, hθ, θ0, θ1, hθC⟩ : ∃ θ, IsForwardPath θ ∧ θ 0 = x₀ ∧ θ 1 = y ∧
      ∀ s ∈ Icc (0 : ℝ) 1, θ s ∈ C₁ ∪ C₂ := by
    rcases hy with hy | hy
    · obtain ⟨θ, hθ, θ0, θ1, hθC⟩ := hc₁ y hy hypos hyb
      exact ⟨θ, hθ, θ0, θ1, fun s hs => Or.inl (hθC s hs)⟩
    · obtain ⟨θ, hθ, θ0, θ1, hθC⟩ := hc₂ y hy hypos hyb
      exact ⟨θ, hθ, θ0, θ1, fun s hs => Or.inr (hθC s hs)⟩
  have hCD : C₁ ∪ C₂ ⊆ D := union_subset hD₁ hD₂
  have r0 : pathRev θ 0 = y := (pathRev_zero θ).trans θ1
  have r1 : pathRev θ 1 = x₀ := (pathRev_one θ).trans θ0
  -- the prolonged tail
  have hδ' : IsForwardPath (pathJoin δ (pathRev θ)) := hδ.join hθ.reverse (d1.trans r0.symm)
  have e0 : pathJoin δ (pathRev θ) 0 = b := (pathJoin_zero _ _).trans d0
  have e1 : pathJoin δ (pathRev θ) 1 = x₀ := (pathJoin_one _ _).trans r1
  have hδ'D : ∀ s ∈ Icc (0 : ℝ) 1, pathJoin δ (pathRev θ) s ∈ D :=
    pathJoin_mem hδD (pathRev_mem fun s hs => hCD (hθC s hs))
  -- the head conjugated to the common time
  have hθγ : IsForwardPath (pathJoin θ γ) := hθ.join hγ (θ1.trans g0.symm)
  have m0 : pathJoin θ γ 0 = x₀ := (pathJoin_zero _ _).trans θ0
  have m1 : pathJoin θ γ 1 = y := (pathJoin_one _ _).trans g1
  have hμ : IsForwardPath (pathJoin (pathJoin θ γ) (pathRev θ)) :=
    hθγ.join hθ.reverse (m1.trans r0.symm)
  have μ0 : pathJoin (pathJoin θ γ) (pathRev θ) 0 = x₀ := (pathJoin_zero _ _).trans m0
  have μ1 : pathJoin (pathJoin θ γ) (pathRev θ) 1 = x₀ := (pathJoin_one _ _).trans r1
  have hglue := loopsIn_union hC₁ hC₂ (h₁ _ hδ' e0 x₀ e1 hδ'D) (h₂ _ hδ' e0 x₀ e1 hδ'D) hc₁ hc₂
    (hJ _ hδ' e0 e1 hδ'D)
  have := hglue _ hμ μ0 μ1 (pathJoin_mem (pathJoin_mem hθC hγC) (pathRev_mem hθC))
  rw [mem_tailComap, hθγ.fibreEquiv_join hθ.reverse m0 m1 r0 r1 hμ μ0 μ1,
    hθ.fibreEquiv_join hγ θ0 θ1 g0 g1 hθγ m0 m1,
    hδ.fibreEquiv_join hθ.reverse d0 d1 r0 r1 hδ' e0 e1,
    hθ.fibreEquiv_reverse θ0 θ1 hθ.reverse r0 r1] at this
  rw [mem_tailComap]
  convert this using 1
  exact Equiv.ext fun q => by simp

/-! ## Paths inside a convex region -/

/-- Two times of a convex open set of forward times with finitely many branch times are
joined, off the branch times, by a forward path inside the set: the arcs between them meet
only at their ends, and the low arcs stay in the set. -/
theorem exists_isForwardPath_mem_convex {C : Set ℂ} (hC : Convex ℝ C) (hCo : IsOpen C)
    (hpos : ∀ τ ∈ C, 0 < τ.re) (hfin : (C ∩ branchTimes).Finite) {x y : ℂ} (hx : x ∈ C)
    (hy : y ∈ C) (hbx : x ∉ branchTimes) (hby : y ∉ branchTimes) :
    ∃ η, IsForwardPath η ∧ η 0 = x ∧ η 1 = y ∧ ∀ s ∈ Icc (0 : ℝ) 1, η s ∈ C := by
  rcases eq_or_ne x y with rfl | hne
  · exact ⟨fun _ => x, IsForwardPath.const (hpos x hx) hbx, rfl, rfl, fun _ _ => hx⟩
  have hdn : 0 < ‖y - x‖ := norm_pos_iff.2 (sub_ne_zero.2 (Ne.symm hne))
  -- the segment is compact inside the open set
  have hsegC : ∀ s ∈ Icc (0 : ℝ) 1, x + (y - x) * (s : ℂ) ∈ C := fun s hs => by
    have := hC.add_smul_sub_mem hx hy hs
    rwa [Complex.real_smul, mul_comm] at this
  obtain ⟨ρ, hρ, hthick⟩ := (isCompact_Icc.image
    (by fun_prop : Continuous fun s : ℝ => x + (y - x) * (s : ℂ))).exists_thickening_subset_open
    hCo (by
      rintro _ ⟨s, hs, rfl⟩
      exact hsegC s hs)
  have hη₀ : 0 < ρ / (2 * ‖y - x‖) := by positivity
  have harc : ∀ η ∈ Ioc (0 : ℝ) (ρ / (2 * ‖y - x‖)), ∀ s ∈ Icc (0 : ℝ) 1,
      arcPath x y η s ∈ C := by
    intro η hη s hs
    refine hthick (mem_thickening_iff.2 ⟨x + (y - x) * (s : ℂ), mem_image_of_mem _ hs, ?_⟩)
    have hdiff : arcPath x y η s - (x + (y - x) * (s : ℂ)) =
        (y - x) * (I * ((η * (s * (1 - s)) : ℝ) : ℂ)) := by
      unfold arcPath
      ring
    have hs1 : 0 ≤ s * (1 - s) := mul_nonneg hs.1 (sub_nonneg.2 hs.2)
    have hs2 : s * (1 - s) ≤ 1 := by nlinarith [hs.1, hs.2]
    rw [dist_eq_norm, hdiff, norm_mul, norm_mul, Complex.norm_I, one_mul, Complex.norm_real,
      Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hη.1.le hs1)]
    have h1 : η * (s * (1 - s)) ≤ ρ / (2 * ‖y - x‖) :=
      (mul_le_of_le_one_right hη.1.le hs2).trans hη.2
    have h2 : ‖y - x‖ * (ρ / (2 * ‖y - x‖)) = ρ / 2 := by
      field_simp
    nlinarith [mul_le_mul_of_nonneg_left h1 hdn.le]
  have hex : ∃ η ∈ Ioc (0 : ℝ) (ρ / (2 * ‖y - x‖)),
      ∀ s ∈ Icc (0 : ℝ) 1, arcPath x y η s ∉ branchTimes := by
    by_contra hcon
    push Not at hcon
    choose! σ hσ using hcon
    have hmaps : MapsTo (fun η => arcPath x y η (σ η)) (Ioc (0 : ℝ) (ρ / (2 * ‖y - x‖)))
        (C ∩ branchTimes) :=
      fun η hη => ⟨harc η hη _ (hσ η hη).1, (hσ η hη).2⟩
    have hinj : InjOn (fun η => arcPath x y η (σ η)) (Ioc (0 : ℝ) (ρ / (2 * ‖y - x‖))) := by
      intro η hη η' _ hff
      obtain ⟨hs, hc⟩ := arcPath_inj hne hff
      rw [← hs] at hc
      have h2 : (η - η') * (σ η * (1 - σ η)) = 0 := by linear_combination hc
      rcases mul_eq_zero.1 h2 with h | h
      · linarith
      · exfalso
        have hmem := (hσ η hη).2
        rcases mul_eq_zero.1 h with h0 | h1
        · rw [h0, arcPath_zero] at hmem
          exact hbx hmem
        · rw [show σ η = 1 by linarith, arcPath_one] at hmem
          exact hby hmem
    exact Set.infinite_of_injOn_mapsTo hinj hmaps (Ioc_infinite hη₀) hfin
  obtain ⟨η, hη, hgood⟩ := hex
  exact ⟨arcPath x y η, ⟨(continuous_arcPath x y η).continuousOn,
    fun s hs => hpos _ (harc η hη s hs), hgood⟩, arcPath_zero x y η, arcPath_one x y η,
    harc η hη⟩

theorem joinedIn_of_convex {C : Set ℂ} (hC : Convex ℝ C) (hCo : IsOpen C)
    (hpos : ∀ τ ∈ C, 0 < τ.re) (hfin : (C ∩ branchTimes).Finite) {x₀ : ℂ} (hx₀ : x₀ ∈ C)
    (hb₀ : x₀ ∉ branchTimes) : JoinedIn C x₀ :=
  fun _ hx _ hbx => exists_isForwardPath_mem_convex hC hCo hpos hfin hx₀ hx hb₀ hbx

/-- Two regions whose intersection is convex and free of branch times: one path inside the
intersection serves both. -/
theorem junction_of_convex_inter {C₁ C₂ : Set ℂ} (hconv : Convex ℝ (C₁ ∩ C₂))
    (hopen : IsOpen (C₁ ∩ C₂)) (hpos : ∀ τ ∈ C₁ ∩ C₂, 0 < τ.re)
    (hfree : ∀ τ ∈ C₁ ∩ C₂, τ ∉ branchTimes) {x₀ : ℂ} (hx₀ : x₀ ∈ C₁ ∩ C₂)
    (N' : Subgroup (Equiv.Perm (Fibre x₀))) : Junction C₁ C₂ x₀ N' := by
  intro x hx _ hbx
  obtain ⟨η, hη, η0, η1, hin⟩ := exists_isForwardPath_mem_convex hconv hopen hpos
    (finite_empty.subset fun τ hτ => absurd hτ.2 (hfree τ hτ.1)) hx₀ hx (hfree x₀ hx₀) hbx
  refine ⟨η, η, hη, hη, η0, η1, η0, η1, fun s hs => (hin s hs).1, fun s hs => (hin s hs).2, ?_⟩
  rw [Equiv.self_trans_symm]
  exact N'.one_mem

/-! ## Half-planes -/

/-- The open half-plane `c < ⟨τ, v⟩`, with the real inner product of `ℂ`. -/
def halfPlane (v : ℂ) (c : ℝ) : Set ℂ := {τ | c < τ.re * v.re + τ.im * v.im}

theorem convex_halfPlane (v : ℂ) (c : ℝ) : Convex ℝ (halfPlane v c) := by
  intro x hx y hy s t hs ht hst
  simp only [halfPlane, mem_setOf_eq] at hx hy ⊢
  have hre : (s • x + t • y).re = s * x.re + t * y.re := by simp
  have him : (s • x + t • y).im = s * x.im + t * y.im := by simp
  rw [hre, him]
  have key : (s * x.re + t * y.re) * v.re + (s * x.im + t * y.im) * v.im - c =
      s * (x.re * v.re + x.im * v.im - c) + t * (y.re * v.re + y.im * v.im - c) := by
    linear_combination c * hst
  have h1 : 0 ≤ s * (x.re * v.re + x.im * v.im - c) := mul_nonneg hs (sub_pos.2 hx).le
  have h2 : 0 ≤ t * (y.re * v.re + y.im * v.im - c) := mul_nonneg ht (sub_pos.2 hy).le
  rcases hs.eq_or_lt with h0 | hspos
  · have ht1 : t = 1 := by linarith
    rw [← h0, ht1]
    simpa only [zero_mul, zero_add, one_mul] using hy
  · linarith [mul_pos hspos (sub_pos.2 hx)]

theorem isOpen_halfPlane (v : ℂ) (c : ℝ) : IsOpen (halfPlane v c) :=
  isOpen_lt continuous_const
    ((Complex.continuous_re.mul continuous_const).add (Complex.continuous_im.mul continuous_const))

/-- The half-plane with `p` on its boundary in the direction of the angle `θ`. -/
def sector (p : ℂ) (θ : ℝ) : Set ℂ :=
  halfPlane ⟨Real.cos θ, Real.sin θ⟩ (p.re * Real.cos θ + p.im * Real.sin θ)

theorem not_mem_sector_self (p : ℂ) (θ : ℝ) : p ∉ sector p θ :=
  fun h => lt_irrefl (p.re * Real.cos θ + p.im * Real.sin θ) h

/-- A time other than `p` lies in one of three half-planes with `p` on the boundary. -/
theorem mem_sector_of_ne {p τ : ℂ} (h : τ ≠ p) :
    τ ∈ sector p (Real.pi / 3) ∨ τ ∈ sector p Real.pi ∨ τ ∈ sector p (-(Real.pi / 3)) := by
  simp only [sector, halfPlane, mem_setOf_eq, Real.cos_neg, Real.sin_neg, Real.cos_pi_div_three,
    Real.sin_pi_div_three, Real.cos_pi, Real.sin_pi]
  by_contra hcon
  push Not at hcon
  obtain ⟨h1, h2, h3⟩ := hcon
  have h3pos : (0 : ℝ) < √3 := Real.sqrt_pos.2 (by norm_num)
  have hre : τ.re = p.re := by linarith
  have ha : (τ.im - p.im) * √3 ≤ 0 := by linarith
  have hb : 0 ≤ (τ.im - p.im) * √3 := by linarith
  rcases mul_eq_zero.1 (le_antisymm ha hb) with h0 | h0
  · exact h (Complex.ext hre (by linarith))
  · exact h3pos.ne' h0

/-! ## The circle in the three half-planes -/

theorem turnPath_eq (p : ℂ) (r s : ℝ) :
    turnPath p r s = p + ((r ^ 2 * Real.cos (2 * Real.pi * s) : ℝ) : ℂ) +
      ((r ^ 2 * Real.sin (2 * Real.pi * s) : ℝ) : ℂ) * I := by
  have h : cexp (((Real.pi * s : ℝ) : ℂ) * I) ^ 2 = cexp (((2 * Real.pi * s : ℝ) : ℂ) * I) := by
    rw [← Complex.exp_nat_mul]
    congr 1
    push_cast
    ring
  rw [turnPath, turnRoot, mul_pow, h, Complex.exp_mul_I, ← Complex.ofReal_cos,
    ← Complex.ofReal_sin]
  push_cast
  ring

theorem turnPath_re (p : ℂ) (r s : ℝ) :
    (turnPath p r s).re = p.re + r ^ 2 * Real.cos (2 * Real.pi * s) := by
  rw [turnPath_eq]
  simp only [Complex.add_re, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, Complex.I_re,
    Complex.I_im, mul_zero, zero_mul, sub_zero, add_zero]

theorem turnPath_im (p : ℂ) (r s : ℝ) :
    (turnPath p r s).im = p.im + r ^ 2 * Real.sin (2 * Real.pi * s) := by
  rw [turnPath_eq]
  simp only [Complex.add_im, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, Complex.I_re,
    Complex.I_im, add_zero, mul_one, mul_zero]

theorem turnPath_mem_sector {p : ℂ} {r : ℝ} (hr : 0 < r) {θ s : ℝ}
    (h : 0 < Real.cos (2 * Real.pi * s - θ)) : turnPath p r s ∈ sector p θ := by
  show p.re * Real.cos θ + p.im * Real.sin θ <
    (turnPath p r s).re * Real.cos θ + (turnPath p r s).im * Real.sin θ
  rw [turnPath_re, turnPath_im]
  have := mul_pos (pow_pos hr 2) h
  rw [Real.cos_sub] at this
  linarith

theorem turnPath_mem_sector_one {p : ℂ} {r : ℝ} (hr : 0 < r) {s : ℝ}
    (hs : s ∈ Icc (0 : ℝ) (1 / 3)) : turnPath p r s ∈ sector p (Real.pi / 3) :=
  turnPath_mem_sector hr (Real.cos_pos_of_mem_Ioo
    ⟨by nlinarith [Real.pi_pos, mul_nonneg Real.pi_pos.le hs.1],
      by nlinarith [Real.pi_pos, mul_nonneg Real.pi_pos.le (sub_nonneg.2 hs.2)]⟩)

theorem turnPath_mem_sector_two {p : ℂ} {r : ℝ} (hr : 0 < r) {s : ℝ}
    (hs : s ∈ Icc (1 / 3 : ℝ) (2 / 3)) : turnPath p r s ∈ sector p Real.pi :=
  turnPath_mem_sector hr (Real.cos_pos_of_mem_Ioo
    ⟨by nlinarith [Real.pi_pos, mul_nonneg Real.pi_pos.le (sub_nonneg.2 hs.1)],
      by nlinarith [Real.pi_pos, mul_nonneg Real.pi_pos.le (sub_nonneg.2 hs.2)]⟩)

theorem turnPath_mem_sector_three {p : ℂ} {r : ℝ} (hr : 0 < r) {s : ℝ}
    (hs : s ∈ Icc (2 / 3 : ℝ) 1) : turnPath p r s ∈ sector p (-(Real.pi / 3)) := by
  refine turnPath_mem_sector hr ?_
  rw [show 2 * Real.pi * s - -(Real.pi / 3) = 2 * Real.pi * s - 5 * Real.pi / 3 + 2 * Real.pi by
    ring, Real.cos_add_two_pi]
  exact Real.cos_pos_of_mem_Ioo
    ⟨by nlinarith [Real.pi_pos, mul_nonneg Real.pi_pos.le (sub_nonneg.2 hs.1)],
      by nlinarith [Real.pi_pos, mul_nonneg Real.pi_pos.le (sub_nonneg.2 hs.2)]⟩

/-! ## One branch time -/

/-- **A convex region with one branch time.** If the lassos whose head is one turn around the
branch time have their transports in `N`, so have all lassos with head in the region. -/
theorem lassosIn_of_one_branchTime {D C : Set ℂ} {N : Subgroup (Equiv.Perm (Fibre b))}
    (hC : Convex ℝ C) (hCo : IsOpen C) (hCD : C ⊆ D) (hpos : ∀ τ ∈ C, 0 < τ.re) {p : ℂ}
    (hpb : p ∈ branchTimes) (hp : ∀ τ ∈ C, τ ∈ branchTimes → τ = p) {r : ℝ} (hr : 0 < r)
    (hball : closedBall p (r ^ 2) ⊆ C)
    (hturn : ∀ (δ : ℝ → ℂ) (hδ : IsForwardPath δ) (d0 : δ 0 = b) (d1 : δ 1 = p + (r : ℂ) ^ 2),
      (∀ s ∈ Icc (0 : ℝ) 1, δ s ∈ D) → ∀ hT : IsForwardPath (turnPath p r),
        hT.fibreEquiv (turnPath_zero p r) (turnPath_one p r) ∈ tailComap hδ d0 d1 N) :
    LassosIn D C b N := by
  have h00 : (0 : ℝ) ∈ Icc (0 : ℝ) 1 := ⟨le_rfl, zero_le_one⟩
  have h11 : (1 : ℝ) ∈ Icc (0 : ℝ) 1 := ⟨zero_le_one, le_rfl⟩
  have h13 : (1 / 3 : ℝ) ∈ Icc (0 : ℝ) 1 := ⟨by norm_num, by norm_num⟩
  have h23 : (2 / 3 : ℝ) ∈ Icc (0 : ℝ) 1 := ⟨by norm_num, by norm_num⟩
  -- the circle lies in `C` and is a forward path
  have hcirc : ∀ s, turnPath p r s ∈ C := fun s => hball (by
    rw [mem_closedBall, dist_eq_norm, norm_turnPath_sub])
  have hT : IsForwardPath (turnPath p r) :=
    ⟨(continuous_turnPath p r).continuousOn, fun s _ => hpos _ (hcirc s), fun s _ hbr => by
      have h2 := norm_turnPath_sub p r s
      rw [hp _ (hcirc s) hbr, sub_self, norm_zero] at h2
      exact (pow_pos hr 2).ne h2⟩
  -- the three parts of `C`
  have hSconv : ∀ θ, Convex ℝ (C ∩ sector p θ) := fun θ => hC.inter (convex_halfPlane _ _)
  have hSopen : ∀ θ, IsOpen (C ∩ sector p θ) := fun θ => hCo.inter (isOpen_halfPlane _ _)
  have hSpos : ∀ θ, ∀ τ ∈ C ∩ sector p θ, 0 < τ.re := fun θ τ hτ => hpos τ hτ.1
  have hSfree : ∀ θ, ∀ τ ∈ C ∩ sector p θ, τ ∉ branchTimes := fun θ τ hτ hbr => by
    have h2 := hτ.2
    rw [hp τ hτ.1 hbr] at h2
    exact not_mem_sector_self p θ h2
  have hSD : ∀ θ, C ∩ sector p θ ⊆ D := fun θ τ hτ => hCD hτ.1
  have hSL : ∀ θ, LassosIn D (C ∩ sector p θ) b N := fun θ =>
    lassosIn_of_convex (hSconv θ) (hSpos θ) (hSfree θ) N
  have hSfin : ∀ θ, ((C ∩ sector p θ) ∩ branchTimes).Finite := fun θ =>
    finite_empty.subset fun τ hτ => absurd hτ.2 (hSfree θ τ hτ.1)
  have hIconv : ∀ θ θ', Convex ℝ ((C ∩ sector p θ) ∩ (C ∩ sector p θ')) := fun θ θ' =>
    (hSconv θ).inter (hSconv θ')
  have hIopen : ∀ θ θ', IsOpen ((C ∩ sector p θ) ∩ (C ∩ sector p θ')) := fun θ θ' =>
    (hSopen θ).inter (hSopen θ')
  -- three points of the circle
  have hy₁1 : turnPath p r (1 / 3) ∈ C ∩ sector p (Real.pi / 3) :=
    ⟨hcirc _, turnPath_mem_sector_one hr ⟨by norm_num, le_rfl⟩⟩
  have hy₁2 : turnPath p r (1 / 3) ∈ C ∩ sector p Real.pi :=
    ⟨hcirc _, turnPath_mem_sector_two hr ⟨le_rfl, by norm_num⟩⟩
  have hy₂2 : turnPath p r (2 / 3) ∈ C ∩ sector p Real.pi :=
    ⟨hcirc _, turnPath_mem_sector_two hr ⟨by norm_num, le_rfl⟩⟩
  have hy₂3 : turnPath p r (2 / 3) ∈ C ∩ sector p (-(Real.pi / 3)) :=
    ⟨hcirc _, turnPath_mem_sector_three hr ⟨le_rfl, by norm_num⟩⟩
  have hx₀1 : p + (r : ℂ) ^ 2 ∈ C ∩ sector p (Real.pi / 3) := by
    rw [← turnPath_zero]
    exact ⟨hcirc _, turnPath_mem_sector_one hr ⟨le_rfl, by norm_num⟩⟩
  have hx₀3 : p + (r : ℂ) ^ 2 ∈ C ∩ sector p (-(Real.pi / 3)) := by
    rw [← turnPath_one]
    exact ⟨hcirc _, turnPath_mem_sector_three hr ⟨by norm_num, le_rfl⟩⟩
  have hy₁b : turnPath p r (1 / 3) ∉ branchTimes := hT.simple _ h13
  have hy₂b : turnPath p r (2 / 3) ∉ branchTimes := hT.simple _ h23
  have hx₀b : p + (r : ℂ) ^ 2 ∉ branchTimes := hSfree _ _ hx₀1
  -- the first two half-planes
  have hU : LassosIn D ((C ∩ sector p (Real.pi / 3)) ∪ (C ∩ sector p Real.pi)) b N :=
    lassosIn_union (hSopen _) (hSopen _) (hSD _) (hSD _) (hSL _) (hSL _)
      (joinedIn_of_convex (hSconv _) (hSopen _) (hSpos _) (hSfin _) hy₁1 hy₁b)
      (joinedIn_of_convex (hSconv _) (hSopen _) (hSpos _) (hSfin _) hy₁2 hy₁b)
      fun δ hδ d0 d1 _ => junction_of_convex_inter (hIconv _ _) (hIopen _ _)
        (fun τ hτ => hpos τ hτ.1.1) (fun τ hτ => hSfree _ τ hτ.1) ⟨hy₁1, hy₁2⟩ _
  -- the third half-plane
  have hc₁ : JoinedIn ((C ∩ sector p (Real.pi / 3)) ∪ (C ∩ sector p Real.pi))
      (p + (r : ℂ) ^ 2) := by
    intro x hx _ hxb
    rcases hx with hx | hx
    · obtain ⟨η, hη, η0, η1, hin⟩ :=
        exists_isForwardPath_mem_convex (hSconv _) (hSopen _) (hSpos _) (hSfin _) hx₀1 hx hx₀b hxb
      exact ⟨η, hη, η0, η1, fun s hs => Or.inl (hin s hs)⟩
    · obtain ⟨η₁, hη₁, a0, a1, hin₁⟩ := exists_isForwardPath_mem_convex (hSconv _) (hSopen _)
        (hSpos _) (hSfin _) hx₀1 hy₁1 hx₀b hy₁b
      obtain ⟨η₂, hη₂, b0, b1, hin₂⟩ := exists_isForwardPath_mem_convex (hSconv _) (hSopen _)
        (hSpos _) (hSfin _) hy₁2 hx hy₁b hxb
      exact ⟨pathJoin η₁ η₂, hη₁.join hη₂ (a1.trans b0.symm), (pathJoin_zero _ _).trans a0,
        (pathJoin_one _ _).trans b1,
        pathJoin_mem (fun s hs => Or.inl (hin₁ s hs)) fun s hs => Or.inr (hin₂ s hs)⟩
  have hJ : ∀ (δ : ℝ → ℂ) (hδ : IsForwardPath δ) (d0 : δ 0 = b) (d1 : δ 1 = p + (r : ℂ) ^ 2),
      (∀ s ∈ Icc (0 : ℝ) 1, δ s ∈ D) →
      Junction ((C ∩ sector p (Real.pi / 3)) ∪ (C ∩ sector p Real.pi))
        (C ∩ sector p (-(Real.pi / 3))) (p + (r : ℂ) ^ 2) (tailComap hδ d0 d1 N) := by
    intro δ hδ d0 d1 hδD x hx hxpos hxb
    obtain ⟨hxU, hx3⟩ := hx
    rcases hxU with hx1 | hx2
    · -- one path inside the first and the third half-plane
      obtain ⟨η₁, η₂, hη₁, hη₂, a0, a1, b0, b1, hin₁, hin₂, hmem⟩ :=
        junction_of_convex_inter (hIconv _ _) (hIopen _ _) (fun τ hτ => hpos τ hτ.1.1)
          (fun τ hτ => hSfree _ τ hτ.1) ⟨hx₀1, hx₀3⟩ (tailComap hδ d0 d1 N) x ⟨hx1, hx3⟩ hxpos hxb
      exact ⟨η₁, η₂, hη₁, hη₂, a0, a1, b0, b1, fun s hs => Or.inl (hin₁ s hs), hin₂, hmem⟩
    · -- the two ways around the branch time differ by the turn
      obtain ⟨ξ, hξ, ξ0, ξ1, hξin⟩ := exists_isForwardPath_mem_convex (hIconv _ _) (hIopen _ _)
        (fun τ hτ => hpos τ hτ.1.1)
        (finite_empty.subset fun τ hτ => absurd hτ.2 (hSfree _ τ hτ.1.1))
        ⟨hy₂2, hy₂3⟩ ⟨hx2, hx3⟩ hy₂b hxb
      have hl := hT.sub h00 h23
      have hrr := hT.sub h23 h11
      have l0 : subPath (turnPath p r) 0 (2 / 3) 0 = p + (r : ℂ) ^ 2 :=
        (subPath_zero _ _ _).trans (turnPath_zero p r)
      have l1 : subPath (turnPath p r) 0 (2 / 3) 1 = turnPath p r (2 / 3) := subPath_one _ _ _
      have c0 : subPath (turnPath p r) (2 / 3) 1 0 = turnPath p r (2 / 3) := subPath_zero _ _ _
      have c1 : subPath (turnPath p r) (2 / 3) 1 1 = p + (r : ℂ) ^ 2 :=
        (subPath_one _ _ _).trans (turnPath_one p r)
      have v0 : pathRev (subPath (turnPath p r) (2 / 3) 1) 0 = p + (r : ℂ) ^ 2 :=
        (pathRev_zero _).trans c1
      have v1 : pathRev (subPath (turnPath p r) (2 / 3) 1) 1 = turnPath p r (2 / 3) :=
        (pathRev_one _).trans c0
      have hη₁ := hl.join hξ (l1.trans ξ0.symm)
      have hη₂ := hrr.reverse.join hξ (v1.trans ξ0.symm)
      have a0 := (pathJoin_zero (subPath (turnPath p r) 0 (2 / 3)) ξ).trans l0
      have a1 := (pathJoin_one (subPath (turnPath p r) 0 (2 / 3)) ξ).trans ξ1
      have b0 := (pathJoin_zero (pathRev (subPath (turnPath p r) (2 / 3) 1)) ξ).trans v0
      have b1 := (pathJoin_one (pathRev (subPath (turnPath p r) (2 / 3) 1)) ξ).trans ξ1
      refine ⟨_, _, hη₁, hη₂, a0, a1, b0, b1, ?_, ?_, ?_⟩
      · refine pathJoin_mem (subPath_mem (by norm_num) fun s hs => ?_)
          fun s hs => Or.inr (hξin s hs).1
        rcases le_total s (1 / 3) with h | h
        · exact Or.inl ⟨hcirc s, turnPath_mem_sector_one hr ⟨hs.1, h⟩⟩
        · exact Or.inr ⟨hcirc s, turnPath_mem_sector_two hr ⟨h, hs.2⟩⟩
      · exact pathJoin_mem (pathRev_mem (subPath_mem (by norm_num) fun s hs =>
          ⟨hcirc s, turnPath_mem_sector_three hr hs⟩)) fun s hs => (hξin s hs).2
      · have := hturn δ hδ d0 d1 hδD hT
        rw [hT.fibreEquiv_cut h23 (turnPath_zero p r) (turnPath_one p r) hl l0 l1 hrr c0 c1]
          at this
        rw [hl.fibreEquiv_join hξ l0 l1 ξ0 ξ1 hη₁ a0 a1,
          hrr.reverse.fibreEquiv_join hξ v0 v1 ξ0 ξ1 hη₂ b0 b1,
          hrr.fibreEquiv_reverse c0 c1 hrr.reverse v0 v1]
        convert this using 1
        exact Equiv.ext fun q => by simp
  have hUS := lassosIn_union ((hSopen _).union (hSopen _)) (hSopen _)
    (union_subset (hSD _) (hSD _)) (hSD _) hU (hSL _) hc₁
    (joinedIn_of_convex (hSconv _) (hSopen _) (hSpos _) (hSfin _) hx₀3 hx₀b) hJ
  refine hUS.mono_offBranch fun τ hτ hbr => ?_
  have hne : τ ≠ p := fun h => hbr (h ▸ hpb)
  rcases mem_sector_of_ne hne with h | h | h
  exacts [Or.inl (Or.inl ⟨hτ, h⟩), Or.inl (Or.inr ⟨hτ, h⟩), Or.inr ⟨hτ, h⟩]

/-! ## Two branch times -/

/-- **A convex region with two branch times** is the union of two convex regions with fewer
branch times, which overlap in a strip without branch times. -/
theorem lassosIn_of_two_branchTimes {D C : Set ℂ} {N : Subgroup (Equiv.Perm (Fibre b))}
    (hC : Convex ℝ C) (hCo : IsOpen C) (hCD : C ⊆ D) (hpos : ∀ τ ∈ C, 0 < τ.re)
    (hfin : (C ∩ branchTimes).Finite) {p₁ p₂ : ℂ} (h₁ : p₁ ∈ C ∩ branchTimes)
    (h₂ : p₂ ∈ C ∩ branchTimes) (hne : p₁ ≠ p₂)
    (ih : ∀ C' : Set ℂ, Convex ℝ C' → IsOpen C' → C' ⊆ C →
      (C' ∩ branchTimes).ncard < (C ∩ branchTimes).ncard → LassosIn D C' b N) :
    LassosIn D C b N := by
  -- the functional `φ τ = ⟨τ, p₂ − p₁⟩` separates the two branch times
  obtain ⟨φ, hφdef⟩ : ∃ φ : ℂ → ℝ, ∀ τ : ℂ,
      φ τ = τ.re * (p₂.re - p₁.re) + τ.im * (p₂.im - p₁.im) := ⟨_, fun _ => rfl⟩
  have hφ12 : φ p₁ < φ p₂ := by
    have hsq : φ p₂ - φ p₁ = (p₂.re - p₁.re) ^ 2 + (p₂.im - p₁.im) ^ 2 := by
      rw [hφdef, hφdef]
      ring
    have hnn : 0 ≤ (p₂.re - p₁.re) ^ 2 + (p₂.im - p₁.im) ^ 2 := by positivity
    rcases hnn.eq_or_lt with h0 | hlt
    · exfalso
      have hre : (p₂.re - p₁.re) ^ 2 = 0 := by
        linarith [sq_nonneg (p₂.re - p₁.re), sq_nonneg (p₂.im - p₁.im)]
      have him : (p₂.im - p₁.im) ^ 2 = 0 := by
        linarith [sq_nonneg (p₂.re - p₁.re), sq_nonneg (p₂.im - p₁.im)]
      exact hne (Complex.ext (by linarith [(pow_eq_zero_iff two_ne_zero).1 hre])
        (by linarith [(pow_eq_zero_iff two_ne_zero).1 him]))
    · linarith
  -- a level between the two values that no branch time of `C` takes, and a strip around it
  have hFfin : (φ '' (C ∩ branchTimes)).Finite := hfin.image φ
  obtain ⟨c, hcI, hcF⟩ := (Ioo_infinite hφ12).exists_notMem_finite hFfin
  obtain ⟨ε, hε, hballε⟩ := Metric.isOpen_iff.1 hFfin.isClosed.isOpen_compl c hcF
  have hstrip : ∀ τ ∈ C, τ ∈ branchTimes → c - ε < φ τ → φ τ < c + ε → False := by
    intro τ hτ hbr hlo hhi
    have hmemb : φ τ ∈ ball c ε := by
      rw [mem_ball, Real.dist_eq, abs_lt]
      constructor <;> linarith
    exact hballε hmemb (mem_image_of_mem _ ⟨hτ, hbr⟩)
  -- the two sides
  have hmem₁ : ∀ τ, τ ∈ halfPlane (-(p₂ - p₁)) (-(c + ε)) ↔ φ τ < c + ε := fun τ => by
    rw [hφdef]
    simp only [halfPlane, mem_setOf_eq, Complex.neg_re, Complex.neg_im, Complex.sub_re,
      Complex.sub_im]
    constructor <;> intro h <;> linarith
  have hmem₂ : ∀ τ, τ ∈ halfPlane (p₂ - p₁) (c - ε) ↔ c - ε < φ τ := fun τ => by
    rw [hφdef]
    simp only [halfPlane, mem_setOf_eq, Complex.sub_re, Complex.sub_im]
  have hlt₁ : ((C ∩ halfPlane (-(p₂ - p₁)) (-(c + ε))) ∩ branchTimes).ncard <
      (C ∩ branchTimes).ncard := by
    refine Set.ncard_lt_ncard ⟨fun τ hτ => ⟨hτ.1.1, hτ.2⟩, fun hsub => ?_⟩ hfin
    have h := (hmem₁ p₂).1 (hsub h₂).1.2
    exact hstrip p₂ h₂.1 h₂.2 (by linarith [hcI.2]) h
  have hlt₂ : ((C ∩ halfPlane (p₂ - p₁) (c - ε)) ∩ branchTimes).ncard <
      (C ∩ branchTimes).ncard := by
    refine Set.ncard_lt_ncard ⟨fun τ hτ => ⟨hτ.1.1, hτ.2⟩, fun hsub => ?_⟩ hfin
    have h := (hmem₂ p₁).1 (hsub h₁).1.2
    exact hstrip p₁ h₁.1 h₁.2 h (by linarith [hcI.1])
  have hconv₁ := hC.inter (convex_halfPlane (-(p₂ - p₁)) (-(c + ε)))
  have hconv₂ := hC.inter (convex_halfPlane (p₂ - p₁) (c - ε))
  have hopen₁ := hCo.inter (isOpen_halfPlane (-(p₂ - p₁)) (-(c + ε)))
  have hopen₂ := hCo.inter (isOpen_halfPlane (p₂ - p₁) (c - ε))
  have hL₁ := ih _ hconv₁ hopen₁ inter_subset_left hlt₁
  have hL₂ := ih _ hconv₂ hopen₂ inter_subset_left hlt₂
  -- a time of the strip on the segment between the two branch times
  have hden : 0 < φ p₂ - φ p₁ := sub_pos.2 hφ12
  obtain ⟨x₀, hx₀C, hx₀φ⟩ : ∃ x₀ ∈ C, φ x₀ = c := by
    refine ⟨p₁ + ((c - φ p₁) / (φ p₂ - φ p₁)) • (p₂ - p₁), hC.add_smul_sub_mem h₁.1 h₂.1
      ⟨div_nonneg (sub_nonneg.2 hcI.1.le) hden.le, (div_le_one hden).2 (by linarith [hcI.2])⟩, ?_⟩
    have hlin : ∀ t : ℝ, φ (p₁ + t • (p₂ - p₁)) = φ p₁ + t * (φ p₂ - φ p₁) := fun t => by
      simp only [hφdef, Complex.add_re, Complex.add_im, Complex.smul_re, Complex.smul_im,
        Complex.sub_re, Complex.sub_im, smul_eq_mul]
      ring
    rw [hlin, div_mul_cancel₀ _ hden.ne']
    ring
  have hx₀1 : x₀ ∈ C ∩ halfPlane (-(p₂ - p₁)) (-(c + ε)) :=
    ⟨hx₀C, (hmem₁ x₀).2 (by linarith)⟩
  have hx₀2 : x₀ ∈ C ∩ halfPlane (p₂ - p₁) (c - ε) := ⟨hx₀C, (hmem₂ x₀).2 (by linarith)⟩
  have hx₀b : x₀ ∉ branchTimes := fun hbr =>
    hstrip x₀ hx₀C hbr (by linarith) (by linarith)
  have hUS := lassosIn_union hopen₁ hopen₂ (inter_subset_left.trans hCD)
    (inter_subset_left.trans hCD) hL₁ hL₂
    (joinedIn_of_convex hconv₁ hopen₁ (fun τ hτ => hpos τ hτ.1)
      (hfin.subset fun τ hτ => ⟨hτ.1.1, hτ.2⟩) hx₀1 hx₀b)
    (joinedIn_of_convex hconv₂ hopen₂ (fun τ hτ => hpos τ hτ.1)
      (hfin.subset fun τ hτ => ⟨hτ.1.1, hτ.2⟩) hx₀2 hx₀b)
    fun δ hδ d0 d1 _ => junction_of_convex_inter (hconv₁.inter hconv₂) (hopen₁.inter hopen₂)
      (fun τ hτ => hpos τ hτ.1.1)
      (fun τ hτ hbr => hstrip τ hτ.1.1 hbr ((hmem₂ τ).1 hτ.2.2) ((hmem₁ τ).1 hτ.1.2))
      ⟨hx₀1, hx₀2⟩ _
  refine hUS.mono_offBranch fun τ hτ _ => ?_
  rcases lt_or_ge (φ τ) (c + ε) with h | h
  · exact Or.inl ⟨hτ, (hmem₁ τ).2 h⟩
  · exact Or.inr ⟨hτ, (hmem₂ τ).2 (by linarith)⟩

/-! ## Generation -/

/-- Around every branch time of `D` there are arbitrarily small turns whose lassos with tail
inside `D` have their transports in `N`. -/
def TurnsIn (D : Set ℂ) (b : ℂ) (N : Subgroup (Equiv.Perm (Fibre b))) : Prop :=
  ∀ p ∈ D, p ∈ branchTimes → ∀ ε > (0 : ℝ), ∃ r : ℝ, 0 < r ∧ r < ε ∧
    ∀ (δ : ℝ → ℂ) (hδ : IsForwardPath δ) (d0 : δ 0 = b) (d1 : δ 1 = p + (r : ℂ) ^ 2),
      (∀ s ∈ Icc (0 : ℝ) 1, δ s ∈ D) → ∀ hT : IsForwardPath (turnPath p r),
        hT.fibreEquiv (turnPath_zero p r) (turnPath_one p r) ∈ tailComap hδ d0 d1 N

/-- Induction on the number of branch times of a bounded convex part of `D`. -/
theorem lassosIn_of_turnsIn {D : Set ℂ} {N : Subgroup (Equiv.Perm (Fibre b))}
    (hT : TurnsIn D b N) : ∀ (n : ℕ) (C : Set ℂ), Convex ℝ C → IsOpen C → C ⊆ D →
      (∀ τ ∈ C, 0 < τ.re) → (C ∩ branchTimes).Finite → (C ∩ branchTimes).ncard = n →
      LassosIn D C b N := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro C hC hCo hCD hpos hfin hcard
    subst hcard
    rcases Nat.lt_or_ge 1 (C ∩ branchTimes).ncard with hn | hn
    · obtain ⟨p₁, h₁, p₂, h₂, hne⟩ := (Set.one_lt_ncard hfin).1 hn
      exact lassosIn_of_two_branchTimes hC hCo hCD hpos hfin h₁ h₂ hne
        fun C' hC' hCo' hsub hlt => ih _ hlt C' hC' hCo' (hsub.trans hCD)
          (fun τ hτ => hpos τ (hsub hτ)) (hfin.subset fun τ hτ => ⟨hsub hτ.1, hτ.2⟩) rfl
    · rcases Nat.le_one_iff_eq_zero_or_eq_one.1 hn with h0 | h1
      · have hempty := (Set.ncard_eq_zero hfin).1 h0
        refine lassosIn_of_convex hC hpos (fun τ hτ hbr => ?_) N
        have : τ ∈ C ∩ branchTimes := ⟨hτ, hbr⟩
        rw [hempty] at this
        exact (Set.mem_empty_iff_false τ).1 this
      · obtain ⟨p, hp⟩ := Set.ncard_eq_one.1 h1
        have hpC : p ∈ C ∩ branchTimes := by
          rw [hp]
          exact mem_singleton p
        obtain ⟨ρ, hρ, hρC⟩ := Metric.isOpen_iff.1 hCo p hpC.1
        obtain ⟨r, hr, hrlt, hturn⟩ := hT p (hCD hpC.1) hpC.2 (min 1 ρ) (lt_min one_pos hρ)
        have hr1 : r < 1 := hrlt.trans_le (min_le_left _ _)
        have hrρ : r < ρ := hrlt.trans_le (min_le_right _ _)
        refine lassosIn_of_one_branchTime hC hCo hCD hpos hpC.2 (fun τ hτ hbr => ?_) hr
          (fun τ hτ => hρC ?_) hturn
        · have : τ ∈ C ∩ branchTimes := ⟨hτ, hbr⟩
          rw [hp] at this
          exact mem_singleton_iff.1 this
        · rw [mem_closedBall] at hτ
          rw [mem_ball]
          nlinarith [mul_pos hr (sub_pos.2 hr1)]

/-- **Generation over a convex region.** Let `D` be a convex open set of forward times. If
the small turns around the branch times of `D`, conjugated to `b` inside `D`, have their
transports in `N`, then every forward loop inside `D` based at `b` has its transport in `N`. -/
theorem loopsIn_of_turnsIn {D : Set ℂ} (hD : Convex ℝ D) (hDo : IsOpen D)
    (hDpos : ∀ τ ∈ D, 0 < τ.re) {N : Subgroup (Equiv.Perm (Fibre b))} (hT : TurnsIn D b N) :
    LoopsIn D b N := by
  intro γ hγ g0 g1 hγD
  have h00 : (0 : ℝ) ∈ Icc (0 : ℝ) 1 := ⟨le_rfl, zero_le_one⟩
  -- a bounded convex part of `D` around the loop, away from the imaginary axis
  obtain ⟨s₀, hs₀, hmin⟩ := isCompact_Icc.exists_isMinOn (nonempty_Icc.2 zero_le_one)
    (Complex.continuous_re.comp_continuousOn hγ.continuousOn)
  obtain ⟨T, hTb⟩ := isCompact_Icc.exists_bound_of_continuousOn hγ.continuousOn
  have ht₀ : 0 < (γ s₀).re / 2 := half_pos (hγ.re_pos s₀ hs₀)
  have hmemH : ∀ τ : ℂ, τ ∈ halfPlane 1 ((γ s₀).re / 2) ↔ (γ s₀).re / 2 < τ.re := fun τ => by
    simp [halfPlane]
  have hγC : ∀ s ∈ Icc (0 : ℝ) 1,
      γ s ∈ (D ∩ halfPlane 1 ((γ s₀).re / 2)) ∩ ball (0 : ℂ) (T + 1) := by
    intro s hs
    refine ⟨⟨hγD s hs, (hmemH _).2 ?_⟩, ?_⟩
    · have : (γ s₀).re ≤ (γ s).re := isMinOn_iff.1 hmin s hs
      linarith
    · rw [mem_ball_zero_iff]
      linarith [hTb s hs]
  have hfin : (((D ∩ halfPlane 1 ((γ s₀).re / 2)) ∩ ball (0 : ℂ) (T + 1)) ∩ branchTimes).Finite :=
    (finite_branchTimes_box (T + 1) ht₀).subset fun τ hτ =>
      ⟨hτ.2, ((hmemH τ).1 hτ.1.1.2).le, (mem_ball_zero_iff.1 hτ.1.2).le⟩
  have hL := lassosIn_of_turnsIn hT _ _
    ((hD.inter (convex_halfPlane 1 _)).inter (convex_ball (0 : ℂ) (T + 1)))
    ((hDo.inter (isOpen_halfPlane 1 _)).inter isOpen_ball)
    (fun τ hτ => hτ.1.1) (fun τ hτ => hDpos τ hτ.1.1) hfin rfl
  -- the lasso with the constant tail
  have hbD : b ∈ D := g0 ▸ hγD 0 h00
  have hc := IsForwardPath.const (τ := b) (g0 ▸ hγ.re_pos 0 h00) (g0 ▸ hγ.simple 0 h00)
  have := hL (fun _ => b) hc rfl b rfl (fun _ _ => hbD) γ hγ g0 g1 hγC
  rw [mem_tailComap] at this
  convert this using 1
  refine Equiv.ext fun q => Subtype.ext ?_
  have e : hc.fibreEquiv rfl rfl q = q := Subtype.ext (hc.fibreEquiv_const_apply rfl rfl q)
  rw [Equiv.trans_apply, Equiv.trans_apply, hc.fibreEquiv_const_symm_apply, e]

/-- The lassos at `b` whose heads are turns around the forward branch times. -/
def turnLassos (b : ℂ) : Set (Equiv.Perm (Fibre b)) :=
  {σ | ∃ (p : ℂ) (r : ℝ) (δ : ℝ → ℂ) (hδ : IsForwardPath δ) (d0 : δ 0 = b)
      (d1 : δ 1 = p + (r : ℂ) ^ 2) (hT : IsForwardPath (turnPath p r)), p ∈ branchTimes ∧
      σ = ((hδ.fibreEquiv d0 d1).trans
        (hT.fibreEquiv (turnPath_zero p r) (turnPath_one p r))).trans (hδ.fibreEquiv d0 d1).symm}

/-- **The turns generate the forward monodromy group.** The group at `b` is generated by the
turns around the forward branch times, conjugated to `b` by forward paths. -/
theorem forwardMonodromy_eq_closure_turnLassos (hb₀ : 0 < b.re) (hb : b ∉ branchTimes) :
    forwardMonodromy b hb₀ hb = Subgroup.closure (turnLassos b) := by
  apply le_antisymm
  · rintro σ ⟨γ, hγ, g0, g1, hσ⟩
    have hσeq : σ = hγ.fibreEquiv g0 g1 :=
      Equiv.ext fun q => (hγ.fibreEquiv_eq g0 g1 (hσ q)).symm
    rw [hσeq]
    refine loopsIn_of_turnsIn (D := {τ : ℂ | 0 < τ.re}) (convex_halfSpace_re_gt 0)
      (isOpen_lt continuous_const Complex.continuous_re) (fun _ h => h) ?_ γ hγ g0 g1 hγ.re_pos
    intro p _ hpb ε hε
    refine ⟨ε / 2, half_pos hε, half_lt_self hε, fun δ hδ d0 d1 _ hT => ?_⟩
    rw [mem_tailComap]
    exact Subgroup.subset_closure ⟨p, ε / 2, δ, hδ, d0, d1, hT, hpb, rfl⟩
  · rw [Subgroup.closure_le]
    rintro σ ⟨p, r, δ, hδ, d0, d1, hT, -, rfl⟩
    rw [SetLike.mem_coe, mem_forwardMonodromy]
    have r0 : pathRev δ 0 = p + (r : ℂ) ^ 2 := (pathRev_zero δ).trans d1
    have r1 : pathRev δ 1 = b := (pathRev_one δ).trans d0
    have hδT := hδ.join hT (d1.trans (turnPath_zero p r).symm)
    have hloop := hδT.join hδ.reverse (((pathJoin_one _ _).trans (turnPath_one p r)).trans r0.symm)
    refine ⟨_, hloop, (pathJoin_zero _ _).trans ((pathJoin_zero _ _).trans d0),
      (pathJoin_one _ _).trans r1, fun q => ?_⟩
    rw [Equiv.trans_apply, Equiv.trans_apply]
    refine ((hδ.transports_fibreEquiv d0 d1 q).trans
      (hT.transports_fibreEquiv (turnPath_zero p r) (turnPath_one p r) _)).trans ?_
    have := (hδ.transports_fibreEquiv d0 d1 ((hδ.fibreEquiv d0 d1).symm
      (hT.fibreEquiv (turnPath_zero p r) (turnPath_one p r) (hδ.fibreEquiv d0 d1 q)))).symm
    rwa [Equiv.apply_symm_apply] at this

end

end GaloisForLFunctions.GaloisTheoryOfZeros
