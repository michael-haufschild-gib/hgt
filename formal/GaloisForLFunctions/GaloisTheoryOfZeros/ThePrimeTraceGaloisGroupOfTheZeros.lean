import GaloisForLFunctions.GaloisTheoryOfZeros.TheAlgebraicPrimeRelationsOfTheZeros

/-!
# The prime-source trace Galois group of the zeros

Pair the two complete ordinate fibres and retain every mixed prime-translation
trace, with analytic multiplicity. Their real ground field is equally the field
of paired full-width germs of the continued prime--archimedean source, tested
against entire exponential weights. The full prime spectral field is algebraic
and normal over this concrete ground field.

Dedekind independence of prime characters reconstructs the whole character
divisor from its mixed traces. Thus every ground-field embedding transports each
zero's entire prime pattern to one actual zero of the same absolute height.
No prior spectral-compatibility condition is assumed. The resulting Galois
action on the complete zero support is faithful.

Ordinary conjugation is a nonidentity arithmetic automorphism. Every arithmetic
symmetry commutes with functional reflection on zeros, but a field lift of
functional reflection and centrality of conjugation remain undetermined. The
real ground field is itself transcendental over the rationals and strictly
smaller than the full spectral field. No purity conclusion follows here.
-/

noncomputable section
set_option autoImplicit false
open Complex Set RHTower
open scoped BigOperators
namespace GaloisForLFunctions.GaloisTheoryOfZeros

/-- A zero's joint prime values are a character of the full free prime group. -/
def primeTraceCharacter (z : ℂ) : Multiplicative (Nat.Primes →₀ ℤ) →* ℂ where
  toFun m := primeRelationValue z m.toAdd
  map_one' := primeRelationValue_zero z
  map_mul' m n := primeRelationValue_add z m.toAdd n.toAdd

theorem primeTraceCharacter_single (z : ℂ) (p : Nat.Primes) :
    primeTraceCharacter z (Multiplicative.ofAdd (Finsupp.single p 1)) =
      Complex.exp (z*(Real.log (p : ℕ) : ℂ)) := by
  exact (primeRelationValue_single z p 1).trans (zpow_one _)

/-- Two prime coordinates already separate the characters of all complex exponents. -/
theorem primeTraceCharacter_injective : Function.Injective primeTraceCharacter := by
  intro z w h
  have hp (p : Nat.Primes) : Complex.exp (z*(Real.log (p : ℕ) : ℂ)) =
      Complex.exp (w*(Real.log (p : ℕ) : ℂ)) :=
    (primeTraceCharacter_single z p).symm.trans
      ((DFunLike.congr_fun h (Multiplicative.ofAdd (Finsupp.single p 1))).trans
        (primeTraceCharacter_single w p))
  apply two_prime_exponential_injective Nat.prime_two Nat.prime_three (by norm_num)
  exact Prod.ext (by simpa only [mul_comm] using hp ⟨2,Nat.prime_two⟩)
    (by simpa only [mul_comm] using hp ⟨3,Nat.prime_three⟩)

/-- Copies in the two complete ordinate fibres, retaining every analytic multiplicity. -/
abbrev PrimeTraceCopies (t : ℝ) :=
  Sum ↥(ordinateFibreCopies t) ↥(ordinateFibreCopies (-t))

def primeTraceCopy (t : ℝ) : PrimeTraceCopies t → XiZeroCopy
  | .inl q => q.1
  | .inr q => q.1

theorem primeTraceCopy_height (t : ℝ) (i : PrimeTraceCopies t) :
    (xiSpectralPoint (primeTraceCopy t i)).re = t ∨
      (xiSpectralPoint (primeTraceCopy t i)).re = -t := by
  cases i with
  | inl q => exact Or.inl ((mem_ordinateFibreCopies t q.1).mp q.2)
  | inr q => exact Or.inr ((mem_ordinateFibreCopies (-t) q.1).mp q.2)

def primeTraceCopyOfZero (q : XiZeroCopy) : PrimeTraceCopies (xiSpectralPoint q).re :=
  .inl ⟨q,(mem_ordinateFibreCopies _ q).mpr rfl⟩

/-- The mixed trace of a finite product of prime translations on a complete paired fibre. -/
def primeDivisorTrace (t : ℝ) (m : Nat.Primes →₀ ℤ) : ℂ :=
  ∑ i : PrimeTraceCopies t, primeRelationValue ((primeTraceCopy t i).1 : ℂ) m

/-- The ground field generated by all mixed traces at all occupied heights. -/
def primeTraceField : Subfield ℂ :=
  Subfield.closure (Set.range fun tm : ℝ × (Nat.Primes →₀ ℤ) => primeDivisorTrace tm.1 tm.2)

theorem primeDivisorTrace_mem (t : ℝ) (m : Nat.Primes →₀ ℤ) :
    primeDivisorTrace t m ∈ primeTraceField := Subfield.subset_closure ⟨(t,m),rfl⟩

theorem primeRelationValue_mem_spectralField (z : rawZeroRelationGroup) (m : Nat.Primes →₀ ℤ) :
    primeRelationValue (z : ℂ) m ∈ primeSpectralField := by
  classical
  induction m using Finsupp.induction_linear with
  | zero => rw [primeRelationValue_zero]; exact primeSpectralField.one_mem
  | add m n hm hn => rw [primeRelationValue_add]; exact primeSpectralField.mul_mem hm hn
  | single p n =>
    rw [primeRelationValue_single]
    apply primeSpectralField.zpow_mem
    simpa only [zeroPrimeEigenvalue,mul_comm] using primeEigenvalue_mem_spectralField p p.2 z

/-- The trace ground field lies in the field of the entire prime spectrum. -/
theorem primeTraceField_le_spectralField : primeTraceField ≤ primeSpectralField := by
  apply Subfield.closure_le.mpr
  rintro x ⟨⟨t,m⟩,rfl⟩
  apply primeSpectralField.sum_mem
  intro i _
  exact primeRelationValue_mem_spectralField (rawZeroRelationRoot (primeTraceCopy t i)) m

/-- The actual prime spectral field over its trace ground field. -/
def primeTraceExtension : IntermediateField primeTraceField ℂ where
  __ := primeSpectralField
  algebraMap_mem' x := primeTraceField_le_spectralField x.property

theorem primeTraceExtension_toSubfield : primeTraceExtension.toSubfield = primeSpectralField := rfl

/-- Every original prime monomial is an element of the trace extension. -/
def primeTraceValue (q : XiZeroCopy) (m : Nat.Primes →₀ ℤ) : primeTraceExtension :=
  ⟨primeRelationValue (q.1 : ℂ) m,
    primeRelationValue_mem_spectralField (rawZeroRelationRoot q) m⟩

/-- The joint character with values in the arithmetic trace extension. -/
def primeTraceExtensionCharacter (q : XiZeroCopy) :
    Multiplicative (Nat.Primes →₀ ℤ) →* primeTraceExtension where
  toFun m := primeTraceValue q m.toAdd
  map_one' := Subtype.ext (primeRelationValue_zero (q.1 : ℂ))
  map_mul' m n := Subtype.ext (primeRelationValue_add (q.1 : ℂ) m.toAdd n.toAdd)

/-- Finite atomic measures on characters are determined by all their traces. -/
theorem character_traces_determine_multiplicities {G : Type*} [Monoid G]
    {ι : Type*} [Fintype ι] (a b : ι → (G →* ℂ))
    (h : ∀ g : G, ∑ i, a i g = ∑ i, b i g) :
    (∑ i, Finsupp.single (a i) (1 : ℂ)) = ∑ i, Finsupp.single (b i) (1 : ℂ) := by
  classical
  apply (linearIndependent_monoidHom G ℂ).finsuppLinearCombination_injective
  simp only [map_sum,Finsupp.linearCombination_single,one_smul]
  funext g
  simpa only [Finset.sum_apply] using h g

/-- An embedding fixing the mixed traces preserves their entire character divisor. -/
theorem primeTraceEmbedding_character_divisor
    (σ : primeTraceExtension →ₐ[primeTraceField] ℂ) (t : ℝ) :
    (∑ i : PrimeTraceCopies t,
      Finsupp.single (σ.toMonoidHom.comp (primeTraceExtensionCharacter (primeTraceCopy t i)))
        (1 : ℂ)) =
      ∑ i : PrimeTraceCopies t,
        Finsupp.single (primeTraceCharacter ((primeTraceCopy t i).1 : ℂ)) (1 : ℂ) := by
  apply character_traces_determine_multiplicities
  intro m
  have hsum : (∑ i : PrimeTraceCopies t, primeTraceValue (primeTraceCopy t i) m.toAdd) =
      algebraMap primeTraceField primeTraceExtension
        ⟨primeDivisorTrace t m.toAdd,primeDivisorTrace_mem t m.toAdd⟩ := by
    apply (IntermediateField.val primeTraceExtension).injective
    rw [map_sum]
    rfl
  have h := congrArg σ hsum
  rw [map_sum,σ.commutes] at h
  exact h

/-- The multiplicity of each character is an integer recovered by its trace measure. -/
theorem character_trace_multiplicity {G : Type*} [Monoid G]
    {ι : Type*} [Fintype ι] (a b : ι → (G →* ℂ))
    (h : (∑ i, Finsupp.single (a i) (1 : ℂ)) = ∑ i, Finsupp.single (b i) (1 : ℂ))
    (χ : G →* ℂ) :
    (by classical exact (Finset.univ.filter (fun i => a i = χ)).card =
      (Finset.univ.filter (fun i => b i = χ)).card) := by
  classical
  have hc := congrArg (fun f : (G →* ℂ) →₀ ℂ => f χ) h
  apply Nat.cast_injective (R := ℂ)
  simpa [Finset.sum_apply,Finsupp.single_apply,Finset.sum_filter,eq_comm] using hc

/-- A nonzero atom in either trace measure occurs in the other, at the same character. -/
theorem character_trace_support {G : Type*} [Monoid G]
    {ι : Type*} [Fintype ι] (a b : ι → (G →* ℂ))
    (h : (∑ i, Finsupp.single (a i) (1 : ℂ)) = ∑ i, Finsupp.single (b i) (1 : ℂ))
    (i : ι) : ∃ j : ι, a i = b j := by
  classical
  have hpos : 0 < (Finset.univ.filter (fun j => a j = a i)).card :=
    Finset.card_pos.mpr ⟨i,Finset.mem_filter.mpr ⟨Finset.mem_univ _,rfl⟩⟩
  rw [character_trace_multiplicity a b h] at hpos
  obtain ⟨j,hj⟩ := Finset.card_pos.mp hpos
  exact ⟨j,(Finset.mem_filter.mp hj).2.symm⟩

/-- Every trace-field embedding sends a zero's entire prime pattern to one actual zero. -/
theorem primeTraceEmbedding_zero_image
    (σ : primeTraceExtension →ₐ[primeTraceField] ℂ) (q : XiZeroCopy) :
    ∃ q' : XiZeroCopy,
      ((xiSpectralPoint q').re = (xiSpectralPoint q).re ∨
        (xiSpectralPoint q').re = -(xiSpectralPoint q).re) ∧
      ∀ m : Nat.Primes →₀ ℤ, σ (primeTraceValue q m) = primeRelationValue (q'.1 : ℂ) m := by
  let t := (xiSpectralPoint q).re
  obtain ⟨j,hj⟩ := character_trace_support _ _ (primeTraceEmbedding_character_divisor σ t)
    (primeTraceCopyOfZero q)
  refine ⟨primeTraceCopy t j,primeTraceCopy_height t j,?_⟩
  intro m
  exact DFunLike.congr_fun hj (Multiplicative.ofAdd m)

/-- Every target zero pattern also has a source: the embedding preserves the entire divisor. -/
theorem primeTraceEmbedding_zero_preimage
    (σ : primeTraceExtension →ₐ[primeTraceField] ℂ) (q : XiZeroCopy) :
    ∃ q' : XiZeroCopy,
      ((xiSpectralPoint q').re = (xiSpectralPoint q).re ∨
        (xiSpectralPoint q').re = -(xiSpectralPoint q).re) ∧
      ∀ m : Nat.Primes →₀ ℤ, σ (primeTraceValue q' m) = primeRelationValue (q.1 : ℂ) m := by
  let t := (xiSpectralPoint q).re
  obtain ⟨j,hj⟩ := character_trace_support _ _ (primeTraceEmbedding_character_divisor σ t).symm
    (primeTraceCopyOfZero q)
  refine ⟨primeTraceCopy t j,primeTraceCopy_height t j,?_⟩
  intro m
  exact (DFunLike.congr_fun hj (Multiplicative.ofAdd m)).symm

private theorem primeTrace_conj_ordinate (q : XiZeroCopy) :
    (xiSpectralPoint (xiZeroCopyConjEquiv q)).re = -(xiSpectralPoint q).re := by
  change (((starRingEnd ℂ) (q.1 : ℂ)-1/2)*(-I)).re =
    -(((q.1 : ℂ)-1/2)*(-I)).re
  simp [Complex.mul_re]

private def primeTraceConjCopy (t : ℝ) : PrimeTraceCopies t → PrimeTraceCopies t
  | .inl q => .inr ⟨xiZeroCopyConjEquiv q.1,(mem_ordinateFibreCopies (-t) _).mpr (by
      rw [primeTrace_conj_ordinate,(mem_ordinateFibreCopies t q.1).mp q.2])⟩
  | .inr q => .inl ⟨xiZeroCopyConjEquiv q.1,(mem_ordinateFibreCopies t _).mpr (by
      rw [primeTrace_conj_ordinate,(mem_ordinateFibreCopies (-t) q.1).mp q.2,neg_neg])⟩

private theorem primeTraceConjCopy_square (t : ℝ) (i : PrimeTraceCopies t) :
    primeTraceConjCopy t (primeTraceConjCopy t i) = i := by
  cases i with
  | inl q => simp only [primeTraceConjCopy,xiZeroCopyConjEquiv_apply_apply]
  | inr q => simp only [primeTraceConjCopy,xiZeroCopyConjEquiv_apply_apply]

private def primeTraceConjEquiv (t : ℝ) : PrimeTraceCopies t ≃ PrimeTraceCopies t where
  toFun := primeTraceConjCopy t
  invFun := primeTraceConjCopy t
  left_inv := primeTraceConjCopy_square t
  right_inv := primeTraceConjCopy_square t

private theorem primeTraceCopy_conj (t : ℝ) (i : PrimeTraceCopies t) :
    ((primeTraceCopy t (primeTraceConjEquiv t i)).1 : ℂ) =
      starRingEnd ℂ ((primeTraceCopy t i).1 : ℂ) := by
  cases i <;> rfl

/-- Pairing both signs of the ordinate makes every joint prime trace real. -/
theorem primeDivisorTrace_conjugation (t : ℝ) (m : Nat.Primes →₀ ℤ) :
    starRingEnd ℂ (primeDivisorTrace t m) = primeDivisorTrace t m := by
  rw [primeDivisorTrace,map_sum]
  calc
    (∑ i : PrimeTraceCopies t, starRingEnd ℂ (primeRelationValue ((primeTraceCopy t i).1 : ℂ) m)) =
        ∑ i : PrimeTraceCopies t,
          primeRelationValue ((primeTraceCopy t (primeTraceConjEquiv t i)).1 : ℂ) m := by
      apply Finset.sum_congr rfl
      intro i _
      rw [primeTraceCopy_conj,primeRelationValue_conjugation]
    _ = primeDivisorTrace t m := (primeTraceConjEquiv t).sum_comp
      (fun i => primeRelationValue ((primeTraceCopy t i).1 : ℂ) m)

/-- Ordinary conjugation fixes the entire prime trace ground field pointwise. -/
theorem primeTraceField_conjugation (x : ℂ) (hx : x ∈ primeTraceField) :
    starRingEnd ℂ x = x := by
  induction hx using Subfield.closure_induction with
  | mem x hx =>
    obtain ⟨⟨t,m⟩,rfl⟩ := hx
    exact primeDivisorTrace_conjugation t m
  | one => exact map_one _
  | add x y _ _ hx hy => rw [map_add,hx,hy]
  | neg x _ hx => rw [map_neg,hx]
  | inv x _ hx => rw [map_inv₀,hx]
  | mul x y _ _ hx hy => rw [map_mul,hx,hy]

theorem primeTraceField_real (x : ℂ) (hx : x ∈ primeTraceField) : x.im = 0 :=
  Complex.conj_eq_iff_im.mp (primeTraceField_conjugation x hx)

/-- Conjugation is an arithmetic automorphism over the mixed trace ground field. -/
def primeTraceConjugation : primeTraceExtension ≃ₐ[primeTraceField] primeTraceExtension where
  toFun z := ⟨starRingEnd ℂ z.1,
    allPrimeScalar_preserves_field primeSpectralScalarConjugation
      allPrimeSpectrum_conjugation z.1 z.2⟩
  invFun z := ⟨starRingEnd ℂ z.1,
    allPrimeScalar_preserves_field primeSpectralScalarConjugation
      allPrimeSpectrum_conjugation z.1 z.2⟩
  left_inv z := Subtype.ext (star_star z.1)
  right_inv z := Subtype.ext (star_star z.1)
  map_mul' x y := Subtype.ext (map_mul (starRingEnd ℂ) x.1 y.1)
  map_add' x y := Subtype.ext (map_add (starRingEnd ℂ) x.1 y.1)
  commutes' x := Subtype.ext (primeTraceField_conjugation x.1 x.2)

open Polynomial Finset

/-- Newton's identities descend every elementary symmetric coefficient to
the field containing the power traces. -/
private theorem primeTrace_esymm_mem {n : ℕ} (K : Subfield ℂ) (f : Fin n → ℂ)
    (hp : ∀ k, (univ.val.map (fun i => f i ^ k)).sum ∈ K) :
    ∀ k, (univ.val.map f).esymm k ∈ K := by
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ih =>
    rcases Nat.eq_zero_or_pos k with hk | hk
    · subst k
      simp [Multiset.esymm]
    · have hn := GaloisForLFunctions.multiset_newton f k hk
      have hsum : (∑ a ∈ {a ∈ antidiagonal k | a.1 ∈ Set.Ioo 0 k},
          (-1:ℂ)^a.1 * (univ.val.map f).esymm a.1 *
            (univ.val.map (fun i => f i^a.2)).sum) ∈ K := by
        apply K.sum_mem
        intro a ha
        have halt : a.1 < k := (Finset.mem_filter.mp ha).2.2
        exact K.mul_mem
          (K.mul_mem (K.pow_mem (K.neg_mem K.one_mem) a.1) (ih a.1 halt)) (hp a.2)
      have hlead : (-1:ℂ)^(k+1)*(k:ℂ)*(univ.val.map f).esymm k ∈ K := by
        have h := K.add_mem (hp k) hsum
        rw [hn, sub_add_cancel] at h
        exact h
      have hc : (-1:ℂ)^(k+1)*(k:ℂ) ∈ K :=
        K.mul_mem (K.pow_mem (K.neg_mem K.one_mem) _) (natCast_mem K k)
      have hc0 : (-1:ℂ)^(k+1)*(k:ℂ) ≠ 0 :=
        mul_ne_zero (pow_ne_zero _ (by norm_num)) (Nat.cast_ne_zero.mpr hk.ne')
      have h := K.mul_mem (K.inv_mem hc) hlead
      simpa only [← mul_assoc, inv_mul_cancel₀ hc0, one_mul] using h

/-- The complete root polynomial has coefficients in the field of its power traces. -/
private theorem primeTrace_coeff_mem {n : ℕ}
    (K : Subfield ℂ) (f : Fin n → ℂ)
    (hp : ∀ k, (univ.val.map (fun i => f i ^ k)).sum ∈ K) (j : ℕ) :
    (((univ.val.map f).map (fun z => X-C z)).prod).coeff j ∈ K := by
  have hcard : (univ.val.map f).card = n := by simp
  by_cases hj : j ≤ n
  · rw [Multiset.prod_X_sub_C_coeff _ (by simpa only [hcard] using hj), hcard]
    exact K.mul_mem (K.pow_mem (K.neg_mem K.one_mem) _)
      (primeTrace_esymm_mem K f hp _)
  · rw [coeff_eq_zero_of_natDegree_lt
      (by rw [natDegree_multiset_prod_X_sub_C_eq_card, hcard]; omega)]
    exact K.zero_mem

private def primeTraceEnumeration (t : ℝ) : Fin (Fintype.card (PrimeTraceCopies t)) → XiZeroCopy :=
  fun i => primeTraceCopy t ((Fintype.equivFin (PrimeTraceCopies t)).symm i)

private theorem primeTraceEnumeration_powerSum (t : ℝ) (m : Nat.Primes →₀ ℤ) (k : ℕ) :
    (univ.val.map (fun i => primeRelationValue ((primeTraceEnumeration t i).1 : ℂ) m ^ k)).sum =
      primeDivisorTrace t (k • m) := by
  simp_rw [← primeRelationValue_nsmul]
  exact (Fintype.equivFin (PrimeTraceCopies t)).symm.sum_comp
    (fun i => primeRelationValue ((primeTraceCopy t i).1 : ℂ) (k • m))

private def primeTracePolynomialComplex (t : ℝ) (m : Nat.Primes →₀ ℤ) : ℂ[X] :=
  ((univ.val.map (fun i => primeRelationValue ((primeTraceEnumeration t i).1 : ℂ) m)).map
    (fun z => X-C z)).prod

private theorem primeTracePolynomial_lifts (t : ℝ) (m : Nat.Primes →₀ ℤ) :
    ∃ Q : primeTraceField[X], Q.map (algebraMap primeTraceField ℂ) =
      primeTracePolynomialComplex t m := by
  change primeTracePolynomialComplex t m ∈ Polynomial.lifts (algebraMap primeTraceField ℂ)
  rw [Polynomial.lifts_iff_coeff_lifts]
  intro j
  refine ⟨⟨(primeTracePolynomialComplex t m).coeff j,?_⟩,rfl⟩
  apply primeTrace_coeff_mem
  intro k
  rw [primeTraceEnumeration_powerSum]
  exact primeDivisorTrace_mem t (k • m)

/-- The exact equation of a mixed prime monomial over the trace ground field. -/
def primeTracePolynomial (t : ℝ) (m : Nat.Primes →₀ ℤ) : primeTraceField[X] :=
  Classical.choose (primeTracePolynomial_lifts t m)

private theorem primeTracePolynomial_map (t : ℝ) (m : Nat.Primes →₀ ℤ) :
    (primeTracePolynomial t m).map (algebraMap primeTraceField ℂ) =
      primeTracePolynomialComplex t m := Classical.choose_spec (primeTracePolynomial_lifts t m)

/-- The equation retains every analytic-multiplicity copy in both ordinate fibres. -/
theorem primeTracePolynomial_map_eq_prod (t : ℝ) (m : Nat.Primes →₀ ℤ) :
    (primeTracePolynomial t m).map (algebraMap primeTraceField ℂ) =
      ∏ i : PrimeTraceCopies t, (X-C (primeRelationValue ((primeTraceCopy t i).1 : ℂ) m)) := by
  rw [primeTracePolynomial_map,primeTracePolynomialComplex,Multiset.map_map]
  exact (Fintype.equivFin (PrimeTraceCopies t)).symm.prod_comp
    (fun i => (X-C (primeRelationValue ((primeTraceCopy t i).1 : ℂ) m) : ℂ[X]))

theorem primeTracePolynomial_monic (t : ℝ) (m : Nat.Primes →₀ ℤ) :
    (primeTracePolynomial t m).Monic := by
  have hm : ((primeTracePolynomial t m).map (algebraMap primeTraceField ℂ)).Monic := by
    rw [primeTracePolynomial_map]
    exact monic_multisetProd_X_sub_C _
  exact Polynomial.monic_map_iff.mp hm

/-- Roots of the trace equation are exactly the actual mixed-prime values in that paired fibre. -/
theorem primeTracePolynomial_rootSet (t : ℝ) (m : Nat.Primes →₀ ℤ) (z : ℂ) :
    z ∈ (primeTracePolynomial t m).rootSet ℂ ↔
      ∃ i : PrimeTraceCopies t, primeRelationValue ((primeTraceCopy t i).1 : ℂ) m = z := by
  rw [Polynomial.mem_rootSet',primeTracePolynomial_map]
  rw [Polynomial.aeval_def,← Polynomial.eval_map,primeTracePolynomial_map]
  change primeTracePolynomialComplex t m ≠ 0 ∧
    (primeTracePolynomialComplex t m).IsRoot z ↔ _
  rw [← Polynomial.mem_roots',primeTracePolynomialComplex,roots_multiset_prod_X_sub_C]
  constructor
  · intro hz
    obtain ⟨j,_,hj⟩ := Multiset.mem_map.mp hz
    exact ⟨(Fintype.equivFin (PrimeTraceCopies t)).symm j,hj⟩
  · rintro ⟨i,hi⟩
    refine Multiset.mem_map.mpr ⟨(Fintype.equivFin (PrimeTraceCopies t)) i,by simp,?_⟩
    simpa only [primeTraceEnumeration,Equiv.symm_apply_apply] using hi

/-- All finite prime trace equations together generate the full infinite spectral field. -/
theorem primeTraceExtension_eq_iSup :
    primeTraceExtension = ⨆ tm : ℝ × (Nat.Primes →₀ ℤ),
      IntermediateField.adjoin primeTraceField ((primeTracePolynomial tm.1 tm.2).rootSet ℂ) := by
  classical
  let U : IntermediateField primeTraceField ℂ := ⨆ tm : ℝ × (Nat.Primes →₀ ℤ),
    IntermediateField.adjoin primeTraceField ((primeTracePolynomial tm.1 tm.2).rootSet ℂ)
  apply le_antisymm
  · intro x hx
    change x ∈ primeSpectralField at hx
    rw [primeSpectralField_eq_rootField] at hx
    change x ∈ U
    induction hx using Subfield.closure_induction with
    | mem x hx =>
      obtain ⟨⟨p,q⟩,rfl⟩ := hx
      let t := (xiSpectralPoint q).re
      let m : Nat.Primes →₀ ℤ := Finsupp.single p 1
      apply (le_iSup (fun tm : ℝ × (Nat.Primes →₀ ℤ) =>
        IntermediateField.adjoin primeTraceField ((primeTracePolynomial tm.1 tm.2).rootSet ℂ)) (t,m))
      apply IntermediateField.subset_adjoin
      apply (primeTracePolynomial_rootSet t m _).mpr
      refine ⟨primeTraceCopyOfZero q,?_⟩
      simp only [m,primeTraceCopyOfZero,primeTraceCopy,primeRelationValue_single,zpow_one,
        zeroPrimeEigenvalue]
      change Complex.exp ((q.1 : ℂ)*(Real.log (p : ℕ) : ℂ)) =
        Complex.exp ((Real.log (p : ℕ) : ℂ)*(q.1 : ℂ))
      rw [mul_comm]
    | one => exact U.one_mem
    | add x y _ _ hx hy => exact U.add_mem hx hy
    | neg x _ hx => exact U.neg_mem hx
    | inv x _ hx => exact U.inv_mem hx
    | mul x y _ _ hx hy => exact U.mul_mem hx hy
  · apply iSup_le
    intro tm
    apply IntermediateField.adjoin_le_iff.mpr
    intro x hx
    obtain ⟨i,rfl⟩ := (primeTracePolynomial_rootSet tm.1 tm.2 x).mp hx
    exact primeRelationValue_mem_spectralField (rawZeroRelationRoot (primeTraceCopy tm.1 i)) tm.2

/-- The whole prime spectral field is algebraic and normal over its mixed trace field. -/
instance primeTraceExtension_normal : Normal primeTraceField primeTraceExtension := by
  have hn (tm : ℝ × (Nat.Primes →₀ ℤ)) : Normal primeTraceField
      (IntermediateField.adjoin primeTraceField ((primeTracePolynomial tm.1 tm.2).rootSet ℂ)) := by
    letI := IntermediateField.adjoin_rootSet_isSplittingField
      (IsAlgClosed.splits ((primeTracePolynomial tm.1 tm.2).map (algebraMap primeTraceField ℂ)))
    exact Normal.of_isSplittingField (primeTracePolynomial tm.1 tm.2)
  letI := hn
  rw [primeTraceExtension_eq_iSup]
  infer_instance

/-- Actual prime monomials are algebraic over this concrete trace ground field. -/
theorem primeTraceValue_isAlgebraic (q : XiZeroCopy) (m : Nat.Primes →₀ ℤ) :
    IsAlgebraic primeTraceField (primeRelationValue (q.1 : ℂ) m) :=
  IsAlgebraic.algHom (IntermediateField.val primeTraceExtension)
    (Algebra.IsAlgebraic.isAlgebraic (primeTraceValue q m))


/-- The first multiplicity copy of an actual zero; its value does not depend on this choice. -/
def primeTraceSupportCopy (q : XiDivisorSupport) : XiZeroCopy :=
  ⟨q,⟨0,by have h := xi_divisor_pos_on_support q; omega⟩⟩

def primeTraceRootValue (q : XiDivisorSupport) (m : Nat.Primes →₀ ℤ) : primeTraceExtension :=
  primeTraceValue (primeTraceSupportCopy q) m

/-- Joint prime values recover the actual zero, including among all complex exponents. -/
theorem primeTraceRootValue_ext {q r : XiDivisorSupport}
    (h : ∀ m : Nat.Primes →₀ ℤ, primeTraceRootValue q m = primeTraceRootValue r m) : q=r := by
  apply Subtype.ext
  apply primeTraceCharacter_injective
  apply MonoidHom.ext
  intro m
  exact congrArg (fun x : primeTraceExtension => (x : ℂ)) (h m.toAdd)

/-- The actual zero selected by a trace-field embedding, with no spectral-compatibility premise. -/
def primeTraceEmbeddingZero (σ : primeTraceExtension →ₐ[primeTraceField] ℂ)
    (q : XiDivisorSupport) : XiDivisorSupport :=
  (Classical.choose (primeTraceEmbedding_zero_image σ (primeTraceSupportCopy q))).1

theorem primeTraceEmbeddingZero_value (σ : primeTraceExtension →ₐ[primeTraceField] ℂ)
    (q : XiDivisorSupport) (m : Nat.Primes →₀ ℤ) :
    σ (primeTraceRootValue q m) = primeRelationValue (primeTraceEmbeddingZero σ q : ℂ) m :=
  (Classical.choose_spec (primeTraceEmbedding_zero_image σ (primeTraceSupportCopy q))).2 m

/-- The arithmetic action preserves the absolute ordinate of every actual zero. -/
theorem primeTraceEmbeddingZero_height (σ : primeTraceExtension →ₐ[primeTraceField] ℂ)
    (q : XiDivisorSupport) :
    |(primeTraceEmbeddingZero σ q : ℂ).im| = |(q : ℂ).im| := by
  let r : XiZeroCopy := Classical.choose
    (primeTraceEmbedding_zero_image σ (primeTraceSupportCopy q))
  have h : (xiSpectralPoint r).re = (xiSpectralPoint (primeTraceSupportCopy q)).re ∨
      (xiSpectralPoint r).re = -(xiSpectralPoint (primeTraceSupportCopy q)).re :=
    (Classical.choose_spec (primeTraceEmbedding_zero_image σ (primeTraceSupportCopy q))).1
  have hr (s : XiZeroCopy) : (xiSpectralPoint s).re = (s.1 : ℂ).im := by
    simp [xiSpectralPoint,Complex.mul_re]
  rw [hr r,hr (primeTraceSupportCopy q)] at h
  change |(r.1 : ℂ).im| = |((primeTraceSupportCopy q).1 : ℂ).im|
  rcases h with h | h
  · exact congrArg abs h
  · simpa only [abs_neg] using congrArg abs h

/-- Every trace-field embedding acts injectively on the actual zero support. -/
theorem primeTraceEmbeddingZero_injective (σ : primeTraceExtension →ₐ[primeTraceField] ℂ) :
    Function.Injective (primeTraceEmbeddingZero σ) := by
  intro q r h
  apply primeTraceRootValue_ext
  intro m
  apply σ.injective
  change σ (primeTraceRootValue q m) = σ (primeTraceRootValue r m)
  rw [primeTraceEmbeddingZero_value,primeTraceEmbeddingZero_value,h]

/-- The zero map attached to a Galois automorphism of the full prime trace extension. -/
def primeTraceZeroMap (σ : primeTraceExtension ≃ₐ[primeTraceField] primeTraceExtension) :
    XiDivisorSupport → XiDivisorSupport :=
  primeTraceEmbeddingZero ((IntermediateField.val primeTraceExtension).comp σ.toAlgHom)

theorem primeTraceZeroMap_value (σ : primeTraceExtension ≃ₐ[primeTraceField] primeTraceExtension)
    (q : XiDivisorSupport) (m : Nat.Primes →₀ ℤ) :
    primeTraceRootValue (primeTraceZeroMap σ q) m = σ (primeTraceRootValue q m) := by
  apply Subtype.ext
  exact (primeTraceEmbeddingZero_value
    ((IntermediateField.val primeTraceExtension).comp σ.toAlgHom) q m).symm

theorem primeTraceZeroMap_one (q : XiDivisorSupport) : primeTraceZeroMap 1 q = q := by
  apply primeTraceRootValue_ext
  intro m
  exact primeTraceZeroMap_value 1 q m

theorem primeTraceZeroMap_mul (σ τ : primeTraceExtension ≃ₐ[primeTraceField] primeTraceExtension)
    (q : XiDivisorSupport) : primeTraceZeroMap (σ*τ) q = primeTraceZeroMap σ (primeTraceZeroMap τ q) := by
  apply primeTraceRootValue_ext
  intro m
  rw [primeTraceZeroMap_value,primeTraceZeroMap_value,primeTraceZeroMap_value]
  rfl

/-- The full arithmetic group acts on all zeros at once, not separately at each prime. -/
def primeTraceZeroPermutation (σ : primeTraceExtension ≃ₐ[primeTraceField] primeTraceExtension) :
    Equiv.Perm XiDivisorSupport where
  toFun := primeTraceZeroMap σ
  invFun := primeTraceZeroMap σ⁻¹
  left_inv q := by rw [← primeTraceZeroMap_mul,inv_mul_cancel,primeTraceZeroMap_one]
  right_inv q := by rw [← primeTraceZeroMap_mul,mul_inv_cancel,primeTraceZeroMap_one]

/-- The arithmetic permutation representation of the entire prime spectral field. -/
def primeTraceGaloisAction :
    (primeTraceExtension ≃ₐ[primeTraceField] primeTraceExtension) →* Equiv.Perm XiDivisorSupport where
  toFun := primeTraceZeroPermutation
  map_one' := Equiv.ext primeTraceZeroMap_one
  map_mul' σ τ := Equiv.ext (primeTraceZeroMap_mul σ τ)

private theorem primeTrace_embedding_ext
    (σ τ : primeTraceExtension →ₐ[primeTraceField] ℂ)
    (h : ∀ q : XiDivisorSupport, ∀ m : Nat.Primes →₀ ℤ,
      σ (primeTraceRootValue q m) = τ (primeTraceRootValue q m)) : σ=τ := by
  apply AlgHom.ext
  intro x
  have hx : (x : ℂ) ∈ primeRootSpectralField := by
    rw [← primeSpectralField_eq_rootField]
    exact x.2
  have he : ∀ y ∈ primeRootSpectralField,
      ∀ hy : y ∈ primeTraceExtension, σ ⟨y,hy⟩ = τ ⟨y,hy⟩ := by
    intro y hy
    induction hy using Subfield.closure_induction with
    | mem y hy =>
      obtain ⟨⟨p,q⟩,rfl⟩ := hy
      intro hq
      have hv : (⟨zeroPrimeEigenvalue p (rawZeroRelationRoot q),hq⟩ : primeTraceExtension) =
          primeTraceRootValue q.1 (Finsupp.single p 1) := by
        apply Subtype.ext
        simp only [primeTraceRootValue,primeTraceValue,primeTraceSupportCopy,
          primeRelationValue_single,zpow_one,zeroPrimeEigenvalue]
        change Complex.exp ((Real.log (p : ℕ) : ℂ)*(q.1 : ℂ)) =
          Complex.exp ((q.1 : ℂ)*(Real.log (p : ℕ) : ℂ))
        rw [mul_comm]
      rw [hv]
      exact h q.1 _
    | one => intro hy; exact (map_one σ).trans (map_one τ).symm
    | add y z hy hz ihy ihz =>
      intro hyz
      have hyE : y ∈ primeTraceExtension := by
        change y ∈ primeSpectralField; rwa [primeSpectralField_eq_rootField]
      have hzE : z ∈ primeTraceExtension := by
        change z ∈ primeSpectralField; rwa [primeSpectralField_eq_rootField]
      change σ (⟨y,hyE⟩+⟨z,hzE⟩) = τ (⟨y,hyE⟩+⟨z,hzE⟩)
      rw [map_add,map_add,ihy hyE,ihz hzE]
    | neg y hy ih =>
      intro hny
      have hyE : y ∈ primeTraceExtension := by
        change y ∈ primeSpectralField; rwa [primeSpectralField_eq_rootField]
      change σ (-⟨y,hyE⟩) = τ (-⟨y,hyE⟩)
      rw [map_neg,map_neg,ih hyE]
    | inv y hy ih =>
      intro hiy
      have hyE : y ∈ primeTraceExtension := by
        change y ∈ primeSpectralField; rwa [primeSpectralField_eq_rootField]
      change σ ((⟨y,hyE⟩ : primeTraceExtension)⁻¹) = τ ((⟨y,hyE⟩ : primeTraceExtension)⁻¹)
      rw [map_inv₀,map_inv₀,ih hyE]
    | mul y z hy hz ihy ihz =>
      intro hyz
      have hyE : y ∈ primeTraceExtension := by
        change y ∈ primeSpectralField; rwa [primeSpectralField_eq_rootField]
      have hzE : z ∈ primeTraceExtension := by
        change z ∈ primeSpectralField; rwa [primeSpectralField_eq_rootField]
      change σ (⟨y,hyE⟩*⟨z,hzE⟩) = τ (⟨y,hyE⟩*⟨z,hzE⟩)
      rw [map_mul,map_mul,ihy hyE,ihz hzE]
  exact he x hx x.2

/-- The entire prime trace Galois group is detected faithfully on actual zeros. -/
theorem primeTraceGaloisAction_injective : Function.Injective primeTraceGaloisAction := by
  intro σ τ h
  have he : ((IntermediateField.val primeTraceExtension).comp σ.toAlgHom) =
      ((IntermediateField.val primeTraceExtension).comp τ.toAlgHom) := by
    apply primeTrace_embedding_ext
    intro q m
    have hq : primeTraceZeroMap σ q = primeTraceZeroMap τ q := DFunLike.congr_fun h q
    have hv := congrArg (fun r => primeTraceRootValue r m) hq
    rw [primeTraceZeroMap_value,primeTraceZeroMap_value] at hv
    exact congrArg (fun x : primeTraceExtension => (x : ℂ)) hv
  apply AlgEquiv.ext
  intro x
  apply Subtype.ext
  exact DFunLike.congr_fun he x


/-- Unit-weight monomials are rational products of primes and lie in the trace field. -/
theorem primeRelationValue_one_mem_traceField (m : Nat.Primes →₀ ℤ) :
    primeRelationValue 1 m ∈ primeTraceField := by
  classical
  induction m using Finsupp.induction_linear with
  | zero => rw [primeRelationValue_zero]; exact primeTraceField.one_mem
  | add m n hm hn => rw [primeRelationValue_add]; exact primeTraceField.mul_mem hm hn
  | single p n =>
    rw [primeRelationValue_single,one_mul,
      GaloisForLFunctions.RHTower.SixExponentials.exp_log_nat p.2.pos]
    exact primeTraceField.zpow_mem (natCast_mem primeTraceField (p : ℕ)) n

private theorem primeTraceRootValue_reflection (q : XiDivisorSupport) (m : Nat.Primes →₀ ℤ) :
    primeTraceRootValue (xiZeroReflectEquiv q) m =
      algebraMap primeTraceField primeTraceExtension
        ⟨primeRelationValue 1 m,primeRelationValue_one_mem_traceField m⟩ /
      primeTraceRootValue q m := by
  apply Subtype.ext
  exact primeRelationValue_reflection (q : ℂ) m

/-- Every arithmetic symmetry commutes with functional reflection on the actual zeros.
This does not assert that functional reflection itself lifts to a field automorphism. -/
theorem primeTraceZeroMap_reflection
    (σ : primeTraceExtension ≃ₐ[primeTraceField] primeTraceExtension) (q : XiDivisorSupport) :
    primeTraceZeroMap σ (xiZeroReflectEquiv q) = xiZeroReflectEquiv (primeTraceZeroMap σ q) := by
  apply primeTraceRootValue_ext
  intro m
  rw [primeTraceZeroMap_value,primeTraceRootValue_reflection,map_div₀,σ.commutes,
    primeTraceRootValue_reflection,primeTraceZeroMap_value]

/-- The distinguished arithmetic conjugation acts as ordinary conjugation on every zero. -/
theorem primeTraceZeroMap_conjugation (q : XiDivisorSupport) :
    primeTraceZeroMap primeTraceConjugation q = xiZeroConjEquiv q := by
  apply primeTraceRootValue_ext
  intro m
  rw [primeTraceZeroMap_value]
  apply Subtype.ext
  exact (primeRelationValue_conjugation (q : ℂ) m).symm

/-- Ordinary conjugation is nontrivial in this actual arithmetic Galois group. -/
theorem primeTraceConjugation_ne_one : primeTraceConjugation ≠ 1 := by
  intro h
  obtain ⟨ρ,hρ⟩ := xiDivisorSupport_infinite.nonempty
  let q : XiDivisorSupport := ⟨ρ,hρ⟩
  have he : xiZeroConjEquiv q = q := by
    rw [← primeTraceZeroMap_conjugation,h,primeTraceZeroMap_one]
  have hi := congrArg (fun r : XiDivisorSupport => (r : ℂ).im) he
  change -(q : ℂ).im = (q : ℂ).im at hi
  exact xi_divisor_support_im_ne_zero q (by linarith only [hi])

/-- The real mixed trace field is strictly smaller than the full prime spectral field. -/
theorem primeTraceField_ne_spectralField : primeTraceField ≠ primeSpectralField := by
  intro he
  apply primeTraceConjugation_ne_one
  apply AlgEquiv.ext
  intro x
  apply Subtype.ext
  exact primeTraceField_conjugation x.1 ((le_of_eq he.symm) x.2)

open RHTower.SlabGermResidueTransport RHTower.SlabFullWidthAdmissibility

/-- The continued prime--archimedean source tested against an entire weight. -/
def analyticFibreSourceContour (g : ℂ → ℂ) (t h c : ℝ) : ℂ :=
  (2*Real.pi*I : ℂ)⁻¹ *
    rectIntegral (fun z => g z * continuedPrimeArchSourceRelativeTrace z)
      (slabLower t h c) (slabUpper t h c)

/-- The full-width germ of the source contour, with uniform narrow-slab stability. -/
def FullFibreAnalyticSourceGerm (t : ℝ) (g : ℂ → ℂ) (a : ℂ) : Prop :=
  ∃ c₀ h₀ : ℝ, 0<c₀ ∧ c₀<1/2 ∧ 0<h₀ ∧
    ∀ c : ℝ, c₀<c → c<1/2 → ∀ h : ℝ, 0<h → h≤h₀ →
      analyticFibreSourceContour g t h c = a

private theorem fullFibreAnalyticSourceGerm_unique {t : ℝ} {g : ℂ → ℂ} {a b : ℂ}
    (ha : FullFibreAnalyticSourceGerm t g a) (hb : FullFibreAnalyticSourceGerm t g b) : a=b := by
  obtain ⟨c₀,h₀,hc₀0,hc₀,hh₀,ha⟩ := ha
  obtain ⟨c₁,h₁,hc₁0,hc₁,hh₁,hb⟩ := hb
  let c := (max c₀ c₁+1/2)/2
  have hc : c<1/2 := by dsimp [c]; linarith [max_lt hc₀ hc₁]
  have hca : c₀<c := by dsimp [c]; linarith [le_max_left c₀ c₁,max_lt hc₀ hc₁]
  have hcb : c₁<c := by dsimp [c]; linarith [le_max_right c₀ c₁,max_lt hc₀ hc₁]
  exact (ha c hca hc (min h₀ h₁) (lt_min hh₀ hh₁) (min_le_left _ _)).symm.trans
    (hb c hcb hc (min h₀ h₁) (lt_min hh₀ hh₁) (min_le_right _ _))

/-- Every entire weight has its exact full-fibre source germ, including analytic multiplicity. -/
theorem fullFibreAnalyticSourceGerm_sum (t : ℝ) (g : ℂ → ℂ)
    (hg : AnalyticOnNhd ℂ g Set.univ) :
    FullFibreAnalyticSourceGerm t g (∑ q ∈ ordinateFibreCopies t, g (xiSpectralPoint q)) := by
  obtain ⟨c₀, h₁, hc₀, hc₀half, _, hfibre, _⟩ := exists_slabAdmissible_family t
  obtain ⟨h₀, hh₀, _, hgap⟩ := exists_slabGap t (1/2) (by norm_num)
  refine ⟨c₀, h₀, hc₀, hc₀half, hh₀, ?_⟩
  intro c hcc₀ hchalf h hh hh₀'
  have hc : 0 < c := hc₀.trans hcc₀
  -- The full-width gap excludes every zero with a different ordinate.
  have hfull {z : ℂ} (hre : t-h ≤ z.re ∧ z.re ≤ t+h)
      (him : -c ≤ z.im ∧ z.im ≤ c) (hz : XiC z = 0) :
      z.re = t ∧ -c₀ ≤ z.im ∧ z.im ≤ c₀ := by
    have hzfull : z ∈ slabPacket t h (1/2) :=
      (mem_slabPacket hh.le (by norm_num)).mpr
        ⟨⟨hre, ⟨by linarith [him.1], by linarith [him.2]⟩⟩, hz⟩
    rw [hgap h hh hh₀', ← hfibre] at hzfull
    exact ⟨((mem_heightFiber hc₀.le).mp hzfull).1,
      ((mem_heightFiber hc₀.le).mp hzfull).2.1⟩
  have hpacket : slabPacket t h c = heightFiber t (1/2) := by
    ext z
    rw [mem_slabPacket hh.le hc.le, mem_heightFiber (by norm_num : (0:ℝ) ≤ 1/2)]
    constructor
    · rintro ⟨⟨hre, him⟩, hz⟩
      exact ⟨(hfull hre him hz).1, ⟨by linarith [him.1], by linarith [him.2]⟩, hz⟩
    · rintro ⟨hre, him, hz⟩
      have hzfull : z ∈ heightFiber t (1/2) :=
        (mem_heightFiber (by norm_num)).mpr ⟨hre, him, hz⟩
      rw [← hfibre] at hzfull
      have him₀ := ((mem_heightFiber hc₀.le).mp hzfull).2.1
      exact ⟨⟨⟨by linarith, by linarith⟩,
        ⟨by linarith [him₀.1], by linarith [him₀.2]⟩⟩, hz⟩
  -- Each boundary lies beyond the offsets of the complete fibre.
  have hadm : SlabAdmissible t h c := by
    apply slabAdmissible_of_slabEdgeNonvanishing hc.le hchalf
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro x hx hz
      rw [uIcc_of_le (by linarith : t-h ≤ t+h)] at hx
      have hf := hfull (z := (x:ℂ) + (-c:ℝ)*I)
        (by simpa using hx) (by simp; linarith) hz
      have hb : -c₀ ≤ -c := by simpa using hf.2.1
      linarith
    · intro x hx hz
      rw [uIcc_of_le (by linarith : t-h ≤ t+h)] at hx
      have hf := hfull (z := (x:ℂ) + (c:ℝ)*I)
        (by simpa using hx) (by simp; linarith) hz
      have hb : c ≤ c₀ := by simpa using hf.2.2
      linarith
    · intro y hy hz
      rw [uIcc_of_le (by linarith : -c ≤ c)] at hy
      have hf := hfull (z := ((t+h:ℝ):ℂ) + (y:ℝ)*I)
        (by simp; linarith) (by simpa using hy) hz
      have hr : t+h = t := by simpa using hf.1
      linarith
    · intro y hy hz
      rw [uIcc_of_le (by linarith : -c ≤ c)] at hy
      have hf := hfull (z := ((t-h:ℝ):ℂ) + (y:ℝ)*I)
        (by simp; linarith) (by simpa using hy) hz
      have hr : t-h = t := by simpa using hf.1
      linarith
  have hcopies : xiZeroCopyClosedRectangle (slabLower t h c) (slabUpper t h c) =
      ordinateFibreCopies t := by
    apply Finset.ext
    intro q
    rw [mem_xiZeroCopyClosedRectangle,Complex.mem_reProdIm,
      slabLower_re,slabUpper_re,slabLower_im,slabUpper_im,
      uIcc_of_le (by linarith : t-h ≤ t+h),uIcc_of_le (by linarith : -c ≤ c),
      mem_ordinateFibreCopies]
    constructor
    · intro hq
      have hp : xiSpectralPoint q ∈ slabPacket t h c :=
        (mem_slabPacket hh.le hc.le).mpr ⟨hq,XiC_xiSpectralPoint_eq_zero q⟩
      rw [hpacket] at hp
      exact ((mem_heightFiber (by norm_num : (0 : ℝ) ≤ 1/2)).mp hp).1
    · intro hq
      have hi := xiSpectralPoint_im_mem_openHalf q
      have hp : xiSpectralPoint q ∈ heightFiber t (1/2) :=
        (mem_heightFiber (by norm_num : (0 : ℝ) ≤ 1/2)).mpr
          ⟨hq,⟨by linarith only [hi.1],hi.2.le⟩,XiC_xiSpectralPoint_eq_zero q⟩
      rw [← hpacket] at hp
      exact ((mem_slabPacket hh.le hc.le).mp hp).1
  have hrect := rectIntegral_continuedPrimeArchSourceRelativeTrace_eq_xiZeroCopyClosedRectangleSum hg
    (z₁ := slabLower t h c) (z₂ := slabUpper t h c)
    (by simp only [slabLower_re,slabUpper_re]; linarith)
    (by simp only [slabLower_im,slabUpper_im]; linarith)
    (by simpa only [slabLower_re,slabUpper_re,slabLower_im] using hadm.bottom)
    (by simpa only [slabLower_re,slabUpper_re,slabUpper_im] using hadm.top)
    (by simpa only [slabLower_im,slabUpper_im,slabUpper_re] using hadm.right)
    (by simpa only [slabLower_im,slabUpper_im,slabLower_re] using hadm.left)
  rw [analyticFibreSourceContour,hrect,hcopies,← mul_assoc,
    inv_mul_cancel₀ (mul_ne_zero (mul_ne_zero (by norm_num)
      (by exact_mod_cast Real.pi_ne_zero)) I_ne_zero),one_mul]

/-- Full-width source germs determine the entire weighted fibre trace exactly. -/
theorem fullFibreAnalyticSourceGerm_iff (t : ℝ) (g : ℂ → ℂ)
    (hg : AnalyticOnNhd ℂ g Set.univ) (a : ℂ) :
    FullFibreAnalyticSourceGerm t g a ↔
      a = ∑ q ∈ ordinateFibreCopies t, g (xiSpectralPoint q) := by
  constructor
  · intro ha
    exact fullFibreAnalyticSourceGerm_unique ha (fullFibreAnalyticSourceGerm_sum t g hg)
  · rintro rfl
    exact fullFibreAnalyticSourceGerm_sum t g hg

/-- The entire source test for a joint prime translation, in the centered coordinate. -/
def primeTraceSourceWeight (m : Nat.Primes →₀ ℤ) (w : ℂ) : ℂ :=
  Complex.exp (((1/2 : ℂ)+w*I)*(primeRelationFrequency m : ℂ))

theorem primeTraceSourceWeight_analytic (m : Nat.Primes →₀ ℤ) :
    AnalyticOnNhd ℂ (primeTraceSourceWeight m) Set.univ := by
  have h : Differentiable ℂ (primeTraceSourceWeight m) := by
    unfold primeTraceSourceWeight
    fun_prop
  exact h.differentiableOn.analyticOnNhd isOpen_univ

theorem primeTraceSourceWeight_zero (m : Nat.Primes →₀ ℤ) (q : XiZeroCopy) :
    primeTraceSourceWeight m (xiSpectralPoint q) = primeRelationValue (q.1 : ℂ) m := by
  have he : (1/2 : ℂ)+xiSpectralPoint q*I = (q.1 : ℂ) := by
    simp [xiSpectralPoint,mul_assoc]
  rw [primeTraceSourceWeight,he]
  rfl

/-- Pair the two source germs before forming the real arithmetic ground field. -/
def PairedPrimeSourceTrace (t : ℝ) (m : Nat.Primes →₀ ℤ) (a : ℂ) : Prop :=
  ∃ b c : ℂ, FullFibreAnalyticSourceGerm t (primeTraceSourceWeight m) b ∧
    FullFibreAnalyticSourceGerm (-t) (primeTraceSourceWeight m) c ∧ a=b+c

/-- The mixed prime divisor trace is exactly the paired continued-source germ. -/
theorem pairedPrimeSourceTrace_iff (t : ℝ) (m : Nat.Primes →₀ ℤ) (a : ℂ) :
    PairedPrimeSourceTrace t m a ↔ a=primeDivisorTrace t m := by
  have he : primeDivisorTrace t m =
      (∑ q ∈ ordinateFibreCopies t, primeTraceSourceWeight m (xiSpectralPoint q)) +
      ∑ q ∈ ordinateFibreCopies (-t), primeTraceSourceWeight m (xiSpectralPoint q) := by
    simp only [primeDivisorTrace,Fintype.sum_sum_type,primeTraceCopy,
      primeTraceSourceWeight_zero,Finset.univ_eq_attach]
    rw [Finset.sum_attach (ordinateFibreCopies t)
      (fun q : XiZeroCopy => primeRelationValue (q.1 : ℂ) m),
      Finset.sum_attach (ordinateFibreCopies (-t))
      (fun q : XiZeroCopy => primeRelationValue (q.1 : ℂ) m)]
  rw [PairedPrimeSourceTrace]
  simp only [fullFibreAnalyticSourceGerm_iff t _ (primeTraceSourceWeight_analytic m),
    fullFibreAnalyticSourceGerm_iff (-t) _ (primeTraceSourceWeight_analytic m)]
  constructor
  · rintro ⟨b,c,rfl,rfl,ha⟩
    exact ha.trans he.symm
  · intro ha
    exact ⟨_,_,rfl,rfl,ha.trans he⟩

/-- The same ground field defined entirely by paired continued prime-side source germs. -/
def primeTraceSourceField : Subfield ℂ :=
  Subfield.closure {a : ℂ | ∃ t : ℝ, ∃ m : Nat.Primes →₀ ℤ, PairedPrimeSourceTrace t m a}

/-- Prime-side source germs and full joint spectral traces define exactly one field. -/
theorem primeTraceSourceField_eq_traceField : primeTraceSourceField = primeTraceField := by
  unfold primeTraceSourceField primeTraceField
  congr 1
  ext a
  constructor
  · rintro ⟨t,m,ha⟩
    exact ⟨(t,m),(pairedPrimeSourceTrace_iff t m a).mp ha |>.symm⟩
  · rintro ⟨⟨t,m⟩,rfl⟩
    exact ⟨t,m,(pairedPrimeSourceTrace_iff t m _).mpr rfl⟩


/-- An ambient scalar embedding fixing the source field restricts to a trace-field embedding. -/
def primeTraceScalarEmbedding (σ : ℂ →ₐ[ℚ] ℂ)
    (hσ : ∀ x ∈ primeTraceField, σ x=x) : primeTraceExtension →ₐ[primeTraceField] ℂ where
  toFun x := σ (x : ℂ)
  map_zero' := map_zero σ
  map_one' := map_one σ
  map_add' x y := map_add σ (x : ℂ) (y : ℂ)
  map_mul' x y := map_mul σ (x : ℂ) (y : ℂ)
  commutes' x := hσ x.1 x.2

/-- Fixing the concrete prime-source trace field forces full prime-spectrum compatibility. -/
theorem primeTraceField_fixed_preserves_spectrum (σ : ℂ →ₐ[ℚ] ℂ)
    (hσ : ∀ x ∈ primeTraceField, σ x=x) : PreservesAllPrimeZeroSpectrum σ := by
  have hroot (q : XiZeroCopy) : ∃ q' : XiZeroCopy, ∀ p : ℕ, p.Prime →
      σ (zeroPrimeEigenvalue p (rawZeroRelationRoot q)) =
        zeroPrimeEigenvalue p (rawZeroRelationRoot q') := by
    obtain ⟨q',_,hq'⟩ := primeTraceEmbedding_zero_image (primeTraceScalarEmbedding σ hσ) q
    refine ⟨q',?_⟩
    intro p hp
    have he := hq' (Finsupp.single ⟨p,hp⟩ 1)
    change σ (primeRelationValue (q.1 : ℂ) (Finsupp.single ⟨p,hp⟩ 1)) =
      primeRelationValue (q'.1 : ℂ) (Finsupp.single ⟨p,hp⟩ 1) at he
    simp only [primeRelationValue_single,zpow_one] at he
    change σ (Complex.exp ((Real.log p : ℂ)*(q.1 : ℂ))) =
      Complex.exp ((Real.log p : ℂ)*(q'.1 : ℂ))
    simpa only [mul_comm] using he
  have h : ∀ z : ℂ, z ∈ rawZeroRelationGroup → ∃ w : rawZeroRelationGroup,
      ∀ p : ℕ, p.Prime → Complex.exp ((Real.log p : ℂ)*(w : ℂ)) =
        σ (Complex.exp ((Real.log p : ℂ)*z)) := by
    intro z hz
    induction hz using AddSubgroup.closure_induction with
    | mem z hz =>
      obtain ⟨q,rfl⟩ := hz
      obtain ⟨q',hq'⟩ := hroot q
      exact ⟨rawZeroRelationRoot q',fun p hp => (hq' p hp).symm⟩
    | zero =>
      refine ⟨0,?_⟩
      intro p hp
      simp only [AddSubgroup.coe_zero,mul_zero,Complex.exp_zero,map_one]
    | add z w _ _ hz hw =>
      obtain ⟨u,hu⟩ := hz
      obtain ⟨v,hv⟩ := hw
      refine ⟨u+v,?_⟩
      intro p hp
      simp only [AddSubgroup.coe_add,mul_add,Complex.exp_add,map_mul,hu p hp,hv p hp]
    | neg z _ hz =>
      obtain ⟨w,hw⟩ := hz
      refine ⟨-w,?_⟩
      intro p hp
      simp only [AddSubgroup.coe_neg,mul_neg,Complex.exp_neg,map_inv₀,hw p hp]
  intro z
  exact h z z.2

/-- The induced exponent action sends every actual zero to a zero of the same absolute height. -/
theorem primeTraceField_fixed_zero_image (σ : ℂ →ₐ[ℚ] ℂ)
    (hσ : ∀ x ∈ primeTraceField, σ x=x) (q : XiZeroCopy) :
    ∃ q' : XiZeroCopy,
      ((xiSpectralPoint q').re = (xiSpectralPoint q).re ∨
        (xiSpectralPoint q').re = -(xiSpectralPoint q).re) ∧
      allPrimeExponentHom σ (primeTraceField_fixed_preserves_spectrum σ hσ)
        (rawZeroRelationRoot q) = rawZeroRelationRoot q' := by
  obtain ⟨q',hh,hq'⟩ := primeTraceEmbedding_zero_image (primeTraceScalarEmbedding σ hσ) q
  refine ⟨q',hh,?_⟩
  apply zeroPrimeEigenvalue_pair_injective
  have hp (p : ℕ) (hp : p.Prime) :
      zeroPrimeEigenvalue p
        (allPrimeExponentHom σ (primeTraceField_fixed_preserves_spectrum σ hσ) (rawZeroRelationRoot q)) =
      zeroPrimeEigenvalue p (rawZeroRelationRoot q') := by
    rw [allPrimeExponentHom_eigenvalue σ (primeTraceField_fixed_preserves_spectrum σ hσ)
      p hp (rawZeroRelationRoot q)]
    have he := hq' (Finsupp.single ⟨p,hp⟩ 1)
    change σ (primeRelationValue (q.1 : ℂ) (Finsupp.single ⟨p,hp⟩ 1)) =
      primeRelationValue (q'.1 : ℂ) (Finsupp.single ⟨p,hp⟩ 1) at he
    simp only [primeRelationValue_single,zpow_one] at he
    change σ (Complex.exp ((Real.log p : ℂ)*(q.1 : ℂ))) =
      Complex.exp ((Real.log p : ℂ)*(q'.1 : ℂ))
    simpa only [mul_comm] using he
  exact Prod.ext (hp 2 Nat.prime_two) (hp 3 Nat.prime_three)

/-- The real prime-source ground field already contains a transcendental number. -/
theorem primeTraceField_has_transcendental :
    ∃ x : ℂ, x ∈ primeTraceField ∧ ¬ IsAlgebraic ℚ x := by
  by_contra h
  push Not at h
  letI : Algebra.IsAlgebraic ℚ primeTraceField := ⟨fun x =>
    (isAlgebraic_algebraMap_iff (algebraMap primeTraceField ℂ).injective).mp (h x.1 x.2)⟩
  obtain ⟨x,hx⟩ := primeSpectralField_has_transcendental
  let y : primeTraceExtension := ⟨x.1,x.2⟩
  have hy : IsAlgebraic primeTraceField (x : ℂ) :=
    IsAlgebraic.algHom (IntermediateField.val primeTraceExtension)
      (Algebra.IsAlgebraic.isAlgebraic y)
  exact hx (hy.restrictScalars ℚ)

