import GaloisForLFunctions.GaloisTheoryOfZeros.TheCentreValueIsTheEquationOfTheSignBranchPoints
import GaloisForLFunctions.RHTower.EvenOrderOnePartialFractionZeroCount

/-!
# The trace of a fibre of the heat cover

The fibre of the heat cover over a time `τ` is the zero set of `H_τ`. Its symmetric functions are
single-valued functions of the time, and they are determined by one function, the centre value
`c(τ) = H_τ(0)`.

* **The cover is the equation of the jets of `c`.** By the heat equation the even derivatives of
  `H_τ` at the centre are the time derivatives of `c`:
  `H_τ(z) = Σ_k (−1)^k c^{(k)}(τ) z^{2k}/(2k)!` (`hasSum_complexHeat_jets`). Over each time the
  coefficient field of the fibre is generated by the jet of `c`.
* **Order one.** For every complex time `‖H_τ(z)‖ ≤ exp(C(1+‖z‖)log(2+‖z‖))`
  (`exists_norm_complexHeat_le`), so `H_τ` has a genus-one product over its zeros.
* **The trace.** If `c(τ) ≠ 0`, the inverse squares of the zeros of `H_τ`, counted with
  multiplicity, sum to the logarithmic derivative of the centre value:
  `Σ 1/z² = c'(τ)/c(τ)` (`hasSum_inv_sq_zeros_complexHeat`).
* **The residue.** At a centre time where `k` pairs `±z` collide, `(τ − τ₀) Σ 1/z² → k`
  (`tendsto_sub_mul_tsum_inv_sq_zeros`): the trace of the fibre is a meromorphic function of the
  time, its poles are the branch points at which the reflection `z ↦ −z` is the monodromy, and
  the residue is the number of sign changes.
-/

open Complex MeasureTheory Filter Topology Set Metric
open RHTower RHTower.DeBruijn GaloisForLFunctions.HTGeometry
open GaloisForLFunctions.EntireZeroDivisor

namespace GaloisForLFunctions.GaloisTheoryOfZeros

noncomputable section
set_option autoImplicit false

/-! ## The jets of the centre value -/

/-- **The heat cover is the equation of the jets of the centre value.** -/
theorem hasSum_complexHeat_jets (τ z : ℂ) :
    HasSum (fun k : ℕ =>
      (-1) ^ k * iteratedDeriv k centreValue τ / ((2 * k).factorial : ℂ) * z ^ (2 * k))
      (complexHeat τ z) := by
  have h := Complex.hasSum_taylorSeries_of_entire (differentiable_complexHeat τ) 0 z
  simp only [sub_zero, smul_eq_mul] at h
  have hinj : Function.Injective fun k : ℕ => 2 * k := fun a b hab => by
    have h2 : 2 * a = 2 * b := hab
    omega
  have hzero : ∀ n ∉ Set.range (fun k : ℕ => 2 * k),
      ((n.factorial : ℂ))⁻¹ * (z ^ n * iteratedDeriv n (complexHeat τ) 0) = 0 := by
    intro n hn
    have hodd : Odd n := by
      obtain ⟨m, rfl | rfl⟩ := Nat.even_or_odd' n
      · exact absurd ⟨m, rfl⟩ hn
      · exact ⟨m, rfl⟩
    rw [iteratedDeriv_complexHeat_center_odd τ hodd, mul_zero, mul_zero]
  have hfun : (fun k : ℕ =>
      (-1) ^ k * iteratedDeriv k centreValue τ / ((2 * k).factorial : ℂ) * z ^ (2 * k)) =
      (fun n : ℕ => ((n.factorial : ℂ))⁻¹ * (z ^ n * iteratedDeriv n (complexHeat τ) 0)) ∘
        fun k : ℕ => 2 * k := by
    funext k
    have hk : (-1 : ℂ) ^ k * iteratedDeriv k centreValue τ =
        iteratedDeriv (2 * k) (complexHeat τ) 0 := by
      rw [iteratedDeriv_centreValue, ← mul_assoc, ← mul_pow]
      norm_num
    rw [Function.comp_apply, hk]
    ring
  rw [hfun]
  exact (hinj.hasSum_iff hzero).2 h

/-! ## Growth in the place -/

/-- A linear term is absorbed by an exponential at the cost `(1 + y) log (2 + y)`: beyond
`u = (2/b) log (E₀ (2 + y))` the exponential dominates. -/
private theorem exists_mul_le_exp_add {β b : ℝ} (hβ : 0 < β) (hb : 0 < b) :
    ∃ M : ℝ, 0 ≤ M ∧ ∀ y u : ℝ, 0 ≤ y → 0 ≤ u →
      y * u ≤ β * Real.exp (b * u) + M * ((1 + y) * Real.log (2 + y)) := by
  set E₀ : ℝ := 1 + 2 / (β * b) with hE₀
  have hβb : 0 < β * b := mul_pos hβ hb
  have hE₀1 : 1 ≤ E₀ := by
    have h : 0 < 2 / (β * b) := by positivity
    rw [hE₀]
    linarith
  have hlogE : 0 ≤ Real.log E₀ := Real.log_nonneg hE₀1
  have hl2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hkey : 1 ≤ β * (b / 2) * E₀ := by
    have h : β * (b / 2) * E₀ = β * b / 2 + 1 := by
      rw [hE₀]
      field_simp
    rw [h]
    linarith [half_pos hβb]
  have hM0 : 0 ≤ 2 / b * (Real.log E₀ / Real.log 2 + 1) :=
    mul_nonneg (by positivity) (add_nonneg (div_nonneg hlogE hl2.le) zero_le_one)
  refine ⟨2 / b * (Real.log E₀ / Real.log 2 + 1), hM0, fun y u hy hu => ?_⟩
  have h2y : 0 < 2 + y := by linarith
  have hL : Real.log 2 ≤ Real.log (2 + y) := Real.log_le_log (by norm_num) (by linarith)
  have hL0 : 0 < Real.log (2 + y) := lt_of_lt_of_le hl2 hL
  have hG0 : 0 ≤ 2 / b * (Real.log E₀ / Real.log 2 + 1) * ((1 + y) * Real.log (2 + y)) :=
    mul_nonneg hM0 (mul_nonneg (by linarith) hL0.le)
  rcases le_or_gt (b * u / 2) (Real.log (E₀ * (2 + y))) with h | h
  · have hu' : u ≤ 2 / b * Real.log (E₀ * (2 + y)) := by
      rw [div_mul_eq_mul_div, le_div_iff₀ hb]
      linarith
    have hlogmul : Real.log (E₀ * (2 + y)) = Real.log E₀ + Real.log (2 + y) :=
      Real.log_mul (by linarith) h2y.ne'
    have h1 : y * u ≤ y * (2 / b * (Real.log E₀ + Real.log (2 + y))) := by
      rw [← hlogmul]
      exact mul_le_mul_of_nonneg_left hu' hy
    have h2 : y * (Real.log E₀ + Real.log (2 + y)) ≤
        (Real.log E₀ / Real.log 2 + 1) * ((1 + y) * Real.log (2 + y)) := by
      have h3 : Real.log E₀ ≤ Real.log E₀ / Real.log 2 * Real.log (2 + y) := by
        rw [div_mul_eq_mul_div, le_div_iff₀ hl2]
        exact mul_le_mul_of_nonneg_left hL hlogE
      have h4 : y * Real.log E₀ ≤
          (1 + y) * (Real.log E₀ / Real.log 2 * Real.log (2 + y)) :=
        mul_le_mul (by linarith) h3 hlogE (by linarith)
      have h5 : y * Real.log (2 + y) ≤ (1 + y) * Real.log (2 + y) :=
        mul_le_mul_of_nonneg_right (by linarith) hL0.le
      linarith
    have h6 := mul_le_mul_of_nonneg_left h2 (by positivity : (0 : ℝ) ≤ 2 / b)
    have h7 : 0 ≤ β * Real.exp (b * u) := mul_nonneg hβ.le (Real.exp_pos _).le
    calc y * u ≤ y * (2 / b * (Real.log E₀ + Real.log (2 + y))) := h1
      _ = 2 / b * (y * (Real.log E₀ + Real.log (2 + y))) := by ring
      _ ≤ 2 / b * ((Real.log E₀ / Real.log 2 + 1) * ((1 + y) * Real.log (2 + y))) := h6
      _ = 2 / b * (Real.log E₀ / Real.log 2 + 1) * ((1 + y) * Real.log (2 + y)) := by ring
      _ ≤ β * Real.exp (b * u) +
          2 / b * (Real.log E₀ / Real.log 2 + 1) * ((1 + y) * Real.log (2 + y)) :=
        le_add_of_nonneg_left h7
  · have hEpos : 0 < E₀ * (2 + y) := mul_pos (by linarith) h2y
    have h1 : E₀ * (2 + y) < Real.exp (b * u / 2) := (Real.log_lt_iff_lt_exp hEpos).1 h
    have h2 : b * u / 2 ≤ Real.exp (b * u / 2) := by
      linarith [Real.add_one_le_exp (b * u / 2)]
    have h3 : Real.exp (b * u) = Real.exp (b * u / 2) * Real.exp (b * u / 2) := by
      rw [← Real.exp_add]
      congr 1
      ring
    have hbu : 0 ≤ b * u / 2 := by positivity
    have h4 : E₀ * (2 + y) * (b * u / 2) ≤ Real.exp (b * u) := by
      rw [h3]
      exact mul_le_mul h1.le h2 hbu (Real.exp_pos _).le
    have h5 : (2 + y) * u ≤ β * (E₀ * (2 + y) * (b * u / 2)) := by
      have h : β * (E₀ * (2 + y) * (b * u / 2)) = β * (b / 2) * E₀ * ((2 + y) * u) := by ring
      rw [h]
      exact le_mul_of_one_le_left (mul_nonneg h2y.le hu) hkey
    have h6 : β * (E₀ * (2 + y) * (b * u / 2)) ≤ β * Real.exp (b * u) :=
      mul_le_mul_of_nonneg_left h4 hβ.le
    linarith

/-- At every time the weight is below a double exponential: `T x² ≤ κ x⁴ + T²/(4κ)` and
`κ x⁴ ≤ (B/2) e^{b|x|}`. -/
theorem exists_norm_complexWeight_le (τ : ℂ) :
    ∃ M B b : ℝ, 0 ≤ M ∧ 0 < B ∧ 0 < b ∧
      ∀ x : ℝ, ‖complexWeight τ x‖ ≤ M * Real.exp (-(B * Real.exp (b * |x|))) := by
  obtain ⟨A, B, b, c, hA, hB, hb, hc, hdecay⟩ := riemannKernel_superExp.decay
  set T : ℝ := c + ‖τ‖ with hT
  set κ : ℝ := B / 2 * b ^ 4 / 24 with hκ
  have hκpos : 0 < κ := by positivity
  have hκne : κ ≠ 0 := hκpos.ne'
  refine ⟨A * Real.exp (T ^ 2 / (4 * κ)), B / 2, b, mul_nonneg hA (Real.exp_pos _).le,
    half_pos hB, hb, fun x => ?_⟩
  have hpos := riemannKernelReal_pos x
  have hw : ‖heatWeight ‖τ‖ x‖ = riemannKernelReal x * Real.exp (‖τ‖ * x ^ 2) := by
    rw [heatWeight, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos (mul_pos hpos (Real.exp_pos _))]
  have hexp : κ * x ^ 4 ≤ B / 2 * Real.exp (b * |x|) := by
    have h4 := Real.pow_div_factorial_le_exp (b * |x|) (by positivity) 4
    have h24 : ((4 : ℕ).factorial : ℝ) = 24 := by norm_num [Nat.factorial]
    rw [h24] at h4
    have hx4 : |x| ^ 4 = x ^ 4 := by
      rw [show (4 : ℕ) = 2 * 2 from rfl, pow_mul, pow_mul, sq_abs]
    rw [show κ * x ^ 4 = B / 2 * ((b * |x|) ^ 4 / 24) by rw [hκ, mul_pow, hx4]; ring]
    exact mul_le_mul_of_nonneg_left h4 (by positivity)
  have hquad : T * x ^ 2 ≤ κ * x ^ 4 + T ^ 2 / (4 * κ) := by
    rw [← sub_nonneg]
    have h : κ * x ^ 4 + T ^ 2 / (4 * κ) - T * x ^ 2 = (2 * κ * x ^ 2 - T) ^ 2 / (4 * κ) := by
      field_simp
      ring
    rw [h]
    positivity
  have hTx : T * x ^ 2 = c * x ^ 2 + ‖τ‖ * x ^ 2 := by
    rw [hT]
    ring
  calc ‖complexWeight τ x‖ ≤ riemannKernelReal x * Real.exp (‖τ‖ * x ^ 2) :=
        (norm_complexWeight_le τ x).trans hw.le
    _ ≤ A * Real.exp (-(B * Real.exp (b * |x|)) + c * x ^ 2) * Real.exp (‖τ‖ * x ^ 2) :=
        mul_le_mul_of_nonneg_right (hdecay x) (Real.exp_pos _).le
    _ = A * Real.exp (-(B * Real.exp (b * |x|)) + c * x ^ 2 + ‖τ‖ * x ^ 2) := by
        rw [mul_assoc, ← Real.exp_add]
    _ ≤ A * Real.exp (T ^ 2 / (4 * κ) + -(B / 2 * Real.exp (b * |x|))) :=
        mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr (by linarith)) hA
    _ = A * Real.exp (T ^ 2 / (4 * κ)) * Real.exp (-(B / 2 * Real.exp (b * |x|))) := by
        rw [Real.exp_add, mul_assoc]

/-- **Every member of the family has order one of logarithmic type in the place.** -/
theorem exists_norm_complexHeat_le (τ : ℂ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ z : ℂ,
      ‖complexHeat τ z‖ ≤ Real.exp (C * (1 + ‖z‖) * Real.log (2 + ‖z‖)) := by
  obtain ⟨M, B, b, hM, hB, hb, hw⟩ := exists_norm_complexWeight_le τ
  obtain ⟨M₁, hM₁, habs⟩ := exists_mul_le_exp_add (half_pos hB) hb
  have hβpos : 0 < B * b ^ 2 / 4 := by positivity
  have hgauss : Integrable fun x : ℝ => Real.exp (-(B * b ^ 2 / 4) * x ^ 2) :=
    integrable_exp_neg_mul_sq hβpos
  set J : ℝ := ∫ x : ℝ, Real.exp (-(B * b ^ 2 / 4) * x ^ 2) with hJ
  have hJ0 : 0 ≤ J := integral_nonneg fun x => (Real.exp_pos _).le
  have hl2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hMJ0 : 0 ≤ M * J := mul_nonneg hM hJ0
  refine ⟨M₁ + M * J / Real.log 2, add_nonneg hM₁ (div_nonneg hMJ0 hl2.le), fun z => ?_⟩
  have hz0 := norm_nonneg z
  have hy0 : 0 ≤ |z.im| := abs_nonneg _
  have hyz : |z.im| ≤ ‖z‖ := Complex.abs_im_le_norm z
  have hlogz : Real.log 2 ≤ Real.log (2 + ‖z‖) := Real.log_le_log (by norm_num) (by linarith)
  set G : ℝ := (1 + ‖z‖) * Real.log (2 + ‖z‖) with hG
  have hG2 : Real.log 2 ≤ G := by
    calc Real.log 2 ≤ Real.log (2 + ‖z‖) := hlogz
      _ = 1 * Real.log (2 + ‖z‖) := (one_mul _).symm
      _ ≤ (1 + ‖z‖) * Real.log (2 + ‖z‖) :=
        mul_le_mul_of_nonneg_right (by linarith) (hl2.le.trans hlogz)
  have hGy : (1 + |z.im|) * Real.log (2 + |z.im|) ≤ G :=
    mul_le_mul (by linarith) (Real.log_le_log (by linarith) (by linarith))
      (Real.log_nonneg (by linarith)) (by linarith)
  have hpt : ∀ x : ℝ, ‖complexWeight τ x * cexp (I * z * x)‖ ≤
      M * Real.exp (M₁ * G) * Real.exp (-(B * b ^ 2 / 4) * x ^ 2) := by
    intro x
    have h3 := habs |z.im| |x| hy0 (abs_nonneg x)
    have h4 := exp_neg_half_doubleExp_le hB hb x
    have h5 : Real.exp (-(B * Real.exp (b * |x|))) * Real.exp (|z.im| * |x|) ≤
        Real.exp (M₁ * G) * Real.exp (-(B / 2 * Real.exp (b * |x|))) := by
      rw [← Real.exp_add, ← Real.exp_add]
      apply Real.exp_le_exp.mpr
      have h6 := mul_le_mul_of_nonneg_left hGy hM₁
      linarith
    calc ‖complexWeight τ x * cexp (I * z * x)‖
        = ‖complexWeight τ x‖ * ‖cexp (I * z * x)‖ := norm_mul _ _
      _ ≤ M * Real.exp (-(B * Real.exp (b * |x|))) * Real.exp (|z.im| * |x|) :=
          mul_le_mul (hw x) (norm_exp_I_mul_le z x) (norm_nonneg _)
            (mul_nonneg hM (Real.exp_pos _).le)
      _ = M * (Real.exp (-(B * Real.exp (b * |x|))) * Real.exp (|z.im| * |x|)) :=
          mul_assoc _ _ _
      _ ≤ M * (Real.exp (M₁ * G) * Real.exp (-(B / 2 * Real.exp (b * |x|)))) :=
          mul_le_mul_of_nonneg_left h5 hM
      _ ≤ M * (Real.exp (M₁ * G) * Real.exp (-(B * b ^ 2 / 4) * x ^ 2)) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left h4 (Real.exp_pos _).le) hM
      _ = M * Real.exp (M₁ * G) * Real.exp (-(B * b ^ 2 / 4) * x ^ 2) :=
          (mul_assoc _ _ _).symm
  have hnorm : ‖complexHeat τ z‖ ≤ M * Real.exp (M₁ * G) * J := by
    rw [complexHeat_eq_expTransform, expTransform]
    calc ‖∫ x : ℝ, complexWeight τ x * cexp (I * z * x)‖
        ≤ ∫ x : ℝ, M * Real.exp (M₁ * G) * Real.exp (-(B * b ^ 2 / 4) * x ^ 2) :=
          norm_integral_le_of_norm_le (hgauss.const_mul _) (Eventually.of_forall hpt)
      _ = M * Real.exp (M₁ * G) * J := by rw [integral_const_mul]
  have hMJ : M * J ≤ Real.exp (M * J / Real.log 2 * G) := by
    have h1 : M * J ≤ M * J / Real.log 2 * G := by
      rw [div_mul_eq_mul_div, le_div_iff₀ hl2]
      exact mul_le_mul_of_nonneg_left hG2 hMJ0
    linarith [Real.add_one_le_exp (M * J / Real.log 2 * G)]
  calc ‖complexHeat τ z‖ ≤ M * Real.exp (M₁ * G) * J := hnorm
    _ = M * J * Real.exp (M₁ * G) := by ring
    _ ≤ Real.exp (M * J / Real.log 2 * G) * Real.exp (M₁ * G) :=
        mul_le_mul_of_nonneg_right hMJ (Real.exp_pos _).le
    _ = Real.exp ((M₁ + M * J / Real.log 2) * (1 + ‖z‖) * Real.log (2 + ‖z‖)) := by
        rw [← Real.exp_add, hG]
        congr 1
        ring

theorem analyticOnNhd_complexHeat (τ : ℂ) : AnalyticOnNhd ℂ (complexHeat τ) univ :=
  fun z _ => (differentiable_complexHeat τ).analyticAt z

/-! ## The inverse-square sum of an even function of order one -/

/-- For an even entire function of order one with `f 0 ≠ 0`, the inverse squares of the zeros,
counted with multiplicity, sum to `−f''(0)/f(0)`: divide the partial fraction of `f'/f` by `z` and
let `z → 0`. -/
theorem hasSum_inv_sq_zeroCopyPoint_of_even {f : ℂ → ℂ} {C : ℝ} (hC : 0 ≤ C)
    (hf : AnalyticOnNhd ℂ f univ) (hf0 : f 0 ≠ 0) (heven : ∀ z, f (-z) = f z)
    (hbound : ∀ z : ℂ, ‖f z‖ ≤ Real.exp (C * (1 + ‖z‖) * Real.log (2 + ‖z‖))) :
    HasSum (fun q : ZeroCopy f => (zeroCopyPoint f q ^ 2)⁻¹)
      (-(iteratedDeriv 2 f 0 / f 0)) := by
  have hane : ∀ q, zeroCopyPoint f q ≠ 0 := zeroCopyPoint_ne_zero hf hf0
  have hbase : Summable (fun q : ZeroCopy f => 1 / ‖zeroCopyPoint f q‖ ^ (2 : ℕ)) :=
    OrderOneHadamard.summable_inv_sq_zeroCopyPoint hC hf hf0 hbound
  have hsummable : Summable (fun q : ZeroCopy f => (zeroCopyPoint f q ^ 2)⁻¹) := by
    refine Summable.of_norm (hbase.congr fun q => ?_)
    rw [norm_inv, norm_pow, one_div]
  -- the zeros stay away from the origin
  have hcont : ContinuousAt f 0 := (hf 0 (mem_univ 0)).continuousAt
  obtain ⟨r, hr, hball⟩ := Metric.eventually_nhds_iff.1 (hcont.eventually_ne hf0)
  have hfar : ∀ q, r ≤ ‖zeroCopyPoint f q‖ := by
    intro q
    by_contra hlt
    rw [not_le] at hlt
    exact hball (by rwa [dist_zero_right]) (RHTower.DeBruijn.apply_zeroCopyPoint hf q)
  -- the limit of `f'(z)/z/f(z)` at the origin, from the Taylor expansion
  have hd0 : deriv f 0 = 0 := by
    have h := deriv_comp_neg f 0
    rw [show (fun x => f (-x)) = f from funext heven, neg_zero] at h
    linear_combination (1 / 2 : ℂ) * h
  have hderiv : HasDerivAt (deriv f) (iteratedDeriv 2 f 0) 0 := by
    rw [iteratedDeriv_succ, iteratedDeriv_one]
    exact (hf 0 (mem_univ 0)).deriv.differentiableAt.hasDerivAt
  have hslope : Tendsto (fun z : ℂ => deriv f z / z) (𝓝[≠] 0) (𝓝 (iteratedDeriv 2 f 0)) := by
    refine (hasDerivAt_iff_tendsto_slope.1 hderiv).congr fun z => ?_
    rw [slope_def_field, hd0, sub_zero, sub_zero]
  have hL : Tendsto (fun z : ℂ => deriv f z / z / f z) (𝓝[≠] 0)
      (𝓝 (iteratedDeriv 2 f 0 / f 0)) :=
    hslope.div (hcont.tendsto.mono_left nhdsWithin_le_nhds) hf0
  -- the limit of the partial fraction, by dominated convergence
  have hR : Tendsto
      (fun z : ℂ => ∑' q : ZeroCopy f, -(zeroCopyPoint f q * (zeroCopyPoint f q - z))⁻¹)
      (𝓝[≠] 0) (𝓝 (∑' q : ZeroCopy f, -(zeroCopyPoint f q * (zeroCopyPoint f q - 0))⁻¹)) := by
    refine tendsto_tsum_of_dominated_convergence
      (bound := fun q => 2 * (1 / ‖zeroCopyPoint f q‖ ^ (2 : ℕ))) (hbase.mul_left 2)
      (fun q => ?_) ?_
    · have hc : ContinuousAt
          (fun z : ℂ => -(zeroCopyPoint f q * (zeroCopyPoint f q - z))⁻¹) 0 := by
        refine ContinuousAt.neg (ContinuousAt.inv₀ ?_ ?_)
        · exact continuousAt_const.mul (continuousAt_const.sub continuousAt_id)
        · rw [sub_zero]
          exact mul_ne_zero (hane q) (hane q)
      exact hc.tendsto.mono_left nhdsWithin_le_nhds
    · have hsmall : ∀ᶠ z : ℂ in 𝓝[≠] 0, ‖z‖ < r / 2 := by
        refine eventually_nhdsWithin_of_eventually_nhds ?_
        filter_upwards [Metric.ball_mem_nhds (0 : ℂ) (half_pos hr)] with z hz
        rwa [mem_ball, dist_zero_right] at hz
      filter_upwards [hsmall] with z hz q
      have ha := hfar q
      have ha0 : 0 < ‖zeroCopyPoint f q‖ := lt_of_lt_of_le hr ha
      have hdiff : ‖zeroCopyPoint f q‖ / 2 ≤ ‖zeroCopyPoint f q - z‖ := by
        have hrev := norm_sub_norm_le (zeroCopyPoint f q) z
        linarith
      have hden : ‖zeroCopyPoint f q‖ ^ (2 : ℕ) / 2 ≤
          ‖zeroCopyPoint f q‖ * ‖zeroCopyPoint f q - z‖ := by
        nlinarith [mul_le_mul_of_nonneg_left hdiff ha0.le]
      have hpos : 0 < ‖zeroCopyPoint f q‖ ^ (2 : ℕ) / 2 := by positivity
      rw [norm_neg, norm_inv, norm_mul]
      calc (‖zeroCopyPoint f q‖ * ‖zeroCopyPoint f q - z‖)⁻¹
          ≤ (‖zeroCopyPoint f q‖ ^ (2 : ℕ) / 2)⁻¹ := inv_anti₀ hpos hden
        _ = 2 * (1 / ‖zeroCopyPoint f q‖ ^ (2 : ℕ)) := by rw [inv_div, mul_one_div]
  -- the two functions agree near the origin
  have heq : ∀ᶠ z : ℂ in 𝓝[≠] 0, deriv f z / z / f z =
      ∑' q : ZeroCopy f, -(zeroCopyPoint f q * (zeroCopyPoint f q - z))⁻¹ := by
    have hne : ∀ᶠ z : ℂ in 𝓝[≠] 0, f z ≠ 0 :=
      eventually_nhdsWithin_of_eventually_nhds (hcont.eventually_ne hf0)
    filter_upwards [hne, self_mem_nhdsWithin] with z hz hz0
    have hz0' : z ≠ 0 := hz0
    have hlog := logDeriv_eq_tsum_of_even hC hf hf0 heven hbound hz
    rw [logDeriv_apply] at hlog
    rw [div_right_comm, hlog, ← tsum_div_const]
    refine tsum_congr fun q => ?_
    rw [neg_div, neg_div, div_right_comm, div_self hz0', one_div]
  have hlim := tendsto_nhds_unique (hL.congr' heq) hR
  have hval : ∑' q : ZeroCopy f, (zeroCopyPoint f q ^ 2)⁻¹ = -(iteratedDeriv 2 f 0 / f 0) := by
    rw [hlim, ← tsum_neg]
    refine tsum_congr fun q => ?_
    rw [sub_zero, neg_neg, sq]
  rw [← hval]
  exact hsummable.hasSum

/-! ## The trace of a fibre -/

/-- **The trace of a fibre of the heat cover.** At a time with `c(τ) ≠ 0` the inverse squares of
the zeros of `H_τ`, counted with multiplicity, sum to `c'(τ)/c(τ)`. -/
theorem hasSum_inv_sq_zeros_complexHeat {τ : ℂ} (hτ : centreValue τ ≠ 0) :
    HasSum (fun q : ZeroCopy (complexHeat τ) => (zeroCopyPoint (complexHeat τ) q ^ 2)⁻¹)
      (logDeriv centreValue τ) := by
  obtain ⟨C, hC, hbound⟩ := exists_norm_complexHeat_le τ
  have h := hasSum_inv_sq_zeroCopyPoint_of_even hC (analyticOnNhd_complexHeat τ) hτ
    (complexHeat_neg τ) hbound
  have hd : deriv centreValue τ = -iteratedDeriv 2 (complexHeat τ) 0 := by
    have h1 := iteratedDeriv_centreValue 1 τ
    simp only [iteratedDeriv_one, pow_one, mul_one, neg_one_mul] at h1
    exact h1
  rw [logDeriv_apply, hd, neg_div]
  exact h

/-- The logarithmic derivative has a simple pole at a zero of order `k`, with residue `k`. -/
theorem tendsto_sub_mul_logDeriv {g : ℂ → ℂ} {τ₀ : ℂ} {k : ℕ} (hg : AnalyticAt ℂ g τ₀)
    (hk : analyticOrderAt g τ₀ = (k : ℕ∞)) :
    Tendsto (fun τ => (τ - τ₀) * logDeriv g τ) (𝓝[≠] τ₀) (𝓝 (k : ℂ)) := by
  obtain ⟨φ, hφ, hφ0, hfac⟩ := hg.analyticOrderAt_eq_natCast.1 hk
  have hev : ∀ᶠ τ in 𝓝[≠] τ₀,
      (τ - τ₀) * logDeriv g τ = (k : ℂ) + (τ - τ₀) * (deriv φ τ / φ τ) := by
    have h1 : ∀ᶠ τ in 𝓝 τ₀, deriv g τ = deriv (fun w => (w - τ₀) ^ k • φ w) τ :=
      hfac.eventually_nhds.mono fun τ hτ => Filter.EventuallyEq.deriv_eq hτ
    have h2 : ∀ᶠ τ in 𝓝 τ₀, φ τ ≠ 0 := hφ.continuousAt.eventually_ne hφ0
    filter_upwards [eventually_nhdsWithin_of_eventually_nhds h1,
      eventually_nhdsWithin_of_eventually_nhds h2,
      eventually_nhdsWithin_of_eventually_nhds hφ.eventually_analyticAt,
      eventually_nhdsWithin_of_eventually_nhds hfac, self_mem_nhdsWithin]
      with τ hd hφτ han hgτ hne
    have hne' : τ - τ₀ ≠ 0 := sub_ne_zero.2 hne
    have hpow : HasDerivAt (fun w : ℂ => (w - τ₀) ^ k) ((k : ℂ) * (τ - τ₀) ^ (k - 1)) τ := by
      have h := (hasDerivAt_pow k (τ - τ₀)).comp τ ((hasDerivAt_id τ).sub_const τ₀)
      rw [mul_one] at h
      exact h
    have hd' : deriv g τ =
        (k : ℂ) * (τ - τ₀) ^ (k - 1) * φ τ + (τ - τ₀) ^ k * deriv φ τ := by
      rw [hd]
      exact (hpow.mul han.differentiableAt.hasDerivAt).deriv
    have hk1 : (τ - τ₀) * (τ - τ₀) ^ (k - 1) * (k : ℂ) = (k : ℂ) * (τ - τ₀) ^ k := by
      rcases Nat.eq_zero_or_pos k with rfl | hkpos
      · simp
      · rw [← pow_succ', Nat.sub_add_cancel hkpos]
        ring
    have hP : (τ - τ₀) ^ k ≠ 0 := pow_ne_zero k hne'
    have hφ' : (τ - τ₀) * (deriv φ τ / φ τ) * φ τ = (τ - τ₀) * deriv φ τ := by
      field_simp
    rw [logDeriv_apply, hd', hgτ, smul_eq_mul, mul_div_assoc', div_eq_iff (mul_ne_zero hP hφτ)]
    linear_combination φ τ * hk1 - (τ - τ₀) ^ k * hφ'
  have hlim : Tendsto (fun τ => (k : ℂ) + (τ - τ₀) * (deriv φ τ / φ τ)) (𝓝[≠] τ₀)
      (𝓝 ((k : ℂ) + (τ₀ - τ₀) * (deriv φ τ₀ / φ τ₀))) := by
    have hc : ContinuousAt (fun τ => (k : ℂ) + (τ - τ₀) * (deriv φ τ / φ τ)) τ₀ :=
      continuousAt_const.add ((continuousAt_id.sub continuousAt_const).mul
        (hφ.deriv.continuousAt.div hφ.continuousAt hφ0))
    exact hc.tendsto.mono_left nhdsWithin_le_nhds
  rw [sub_self, zero_mul, add_zero] at hlim
  exact hlim.congr' (hev.mono fun τ h => h.symm)

/-- **The number of pairs that collide at the centre is the residue of the trace.** At a time
`τ₀` where `2k` zeros collide at the centre, `(τ − τ₀) Σ 1/z²` tends to `k`. -/
theorem tendsto_sub_mul_tsum_inv_sq_zeros {τ₀ : ℂ} {k : ℕ} (hc : IsCollision τ₀ 0 (2 * k)) :
    Tendsto (fun τ => (τ - τ₀) *
        ∑' q : ZeroCopy (complexHeat τ), (zeroCopyPoint (complexHeat τ) q ^ 2)⁻¹)
      (𝓝[≠] τ₀) (𝓝 (k : ℂ)) := by
  have hk : analyticOrderAt centreValue τ₀ = (k : ℕ∞) := isCollision_center_iff.1 hc
  have hg : AnalyticAt ℂ centreValue τ₀ := differentiable_centreValue.analyticAt τ₀
  have hne : ∀ᶠ τ in 𝓝[≠] τ₀, centreValue τ ≠ 0 := by
    obtain ⟨φ, hφ, hφ0, hfac⟩ := hg.analyticOrderAt_eq_natCast.1 hk
    filter_upwards [eventually_nhdsWithin_of_eventually_nhds hfac,
      eventually_nhdsWithin_of_eventually_nhds (hφ.continuousAt.eventually_ne hφ0),
      self_mem_nhdsWithin] with τ h1 h2 h3
    rw [h1]
    exact smul_ne_zero (pow_ne_zero k (sub_ne_zero.2 h3)) h2
  refine (tendsto_sub_mul_logDeriv hg hk).congr' (hne.mono fun τ hτ => ?_)
  beta_reduce
  rw [(hasSum_inv_sq_zeros_complexHeat hτ).tsum_eq]

end

