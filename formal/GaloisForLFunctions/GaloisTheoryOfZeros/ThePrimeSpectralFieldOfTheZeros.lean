import GaloisForLFunctions.GaloisTheoryOfZeros.TheScalarDescentOfPrimeTranslations
import GaloisForLFunctions.GaloisTheoryOfZeros.TheRealStructureOfPrimeTranslations
import GaloisForLFunctions.GaloisTheoryOfZeros.TheMaximalArithmeticQuotientOfTheZeroMotive

/-!
# The prime spectral field of the zeros

The field generated by every prime value on the entire integer zero group is
already generated by the prime values of the original zeros. Every compatible
scalar embedding preserves it, and agreement on this field is exactly agreement
of the induced exponent actions. Pointwise fixing of this field is the exact
scalar kernel invisible on exponents.

The unit weight forces every rational exponent to be fixed. Its prime values
generate a real algebraic subfield fixed by all compatible scalar embeddings.
The full spectral field contains transcendental elements and carries nontrivial
ordinary conjugation. Its arithmetic stabilizer and mixed-prime relations are
not determined here.

Compatibility with the infinite prime spectrum is equivalent to a unique pointed
endomorphism commuting with every prime translation. Two primes reconstruct
the exponent map; the remaining primes retain their full compatibility conditions.
-/

noncomputable section
set_option autoImplicit false
open Complex Set RHTower
namespace GaloisForLFunctions.GaloisTheoryOfZeros

/-- Compatibility with every prime value uses one common target exponent. -/
def PreservesAllPrimeZeroSpectrum (σ : ℂ →ₐ[ℚ] ℂ) : Prop :=
  ∀ z : rawZeroRelationGroup, ∃ w : rawZeroRelationGroup,
    ∀ p : ℕ, p.Prime → zeroPrimeEigenvalue p w = σ (zeroPrimeEigenvalue p z)

/-- Full prime compatibility contains the two-prime reconstruction datum. -/
theorem allPrimeSpectrum_to_two (σ : ℂ →ₐ[ℚ] ℂ) (hσ : PreservesAllPrimeZeroSpectrum σ) :
    PreservesPrimeZeroSpectrum σ := by
  intro z
  obtain ⟨w,hw⟩ := hσ z
  exact ⟨w,hw 2 Nat.prime_two,hw 3 Nat.prime_three⟩

/-- The uniquely reconstructed action on the entire integer zero group. -/
def allPrimeExponentHom (σ : ℂ →ₐ[ℚ] ℂ) (hσ : PreservesAllPrimeZeroSpectrum σ) :
    rawZeroRelationGroup →+ rawZeroRelationGroup :=
  primeSpectrumExponentHom σ (allPrimeSpectrum_to_two σ hσ)

/-- The exponent selected by two primes transports every prime value. -/
theorem allPrimeExponentHom_eigenvalue (σ : ℂ →ₐ[ℚ] ℂ) (hσ : PreservesAllPrimeZeroSpectrum σ)
    (p : ℕ) (hp : p.Prime) (z : rawZeroRelationGroup) :
    zeroPrimeEigenvalue p (allPrimeExponentHom σ hσ z) = σ (zeroPrimeEigenvalue p z) := by
  obtain ⟨w,hw⟩ := hσ z
  have he : allPrimeExponentHom σ hσ z = w := by
    apply zeroPrimeEigenvalue_pair_injective
    exact Prod.ext
      ((primeSpectrumExponent_pair σ (allPrimeSpectrum_to_two σ hσ) z).1.trans
        (hw 2 Nat.prime_two).symm)
      ((primeSpectrumExponent_pair σ (allPrimeSpectrum_to_two σ hσ) z).2.trans
        (hw 3 Nat.prime_three).symm)
  rw [he]
  exact hw p hp

theorem allPrimeExponentHom_injective (σ : ℂ →ₐ[ℚ] ℂ) (hσ : PreservesAllPrimeZeroSpectrum σ) :
    Function.Injective (allPrimeExponentHom σ hσ) :=
  primeSpectrumExponentHom_injective σ (allPrimeSpectrum_to_two σ hσ)

/-- Every actual prime value on every integer zero relation. -/
def primeSpectralGenerators : Set ℂ :=
  Set.range fun d : Nat.Primes × rawZeroRelationGroup => zeroPrimeEigenvalue d.1 d.2

/-- The coefficient field generated by the full prime spectrum. -/
def primeSpectralField : Subfield ℂ := Subfield.closure primeSpectralGenerators

/-- Prime values of individual zeros generate the same field. -/
def primeRootSpectralField : Subfield ℂ := Subfield.closure
  (Set.range fun d : Nat.Primes × XiZeroCopy => zeroPrimeEigenvalue d.1 (rawZeroRelationRoot d.2))

theorem primeEigenvalue_mem_spectralField (p : ℕ) (hp : p.Prime) (z : rawZeroRelationGroup) :
    zeroPrimeEigenvalue p z ∈ primeSpectralField :=
  Subfield.subset_closure ⟨(⟨p,hp⟩,z),rfl⟩

private theorem primeEigenvalue_mem_rootField (p : ℕ) (hp : p.Prime) (z : rawZeroRelationGroup) :
    zeroPrimeEigenvalue p z ∈ primeRootSpectralField := by
  have h : ∀ w : ℂ, w ∈ rawZeroRelationGroup →
      Complex.exp ((Real.log p : ℂ)*w) ∈ primeRootSpectralField := by
    intro w hw
    induction hw using AddSubgroup.closure_induction with
    | mem w hw =>
      obtain ⟨q,rfl⟩ := hw
      exact Subfield.subset_closure ⟨(⟨p,hp⟩,q),rfl⟩
    | zero =>
      rw [mul_zero,Complex.exp_zero]
      exact primeRootSpectralField.one_mem
    | add w v _ _ hw hv =>
      rw [mul_add,Complex.exp_add]
      exact primeRootSpectralField.mul_mem hw hv
    | neg w _ hw =>
      rw [mul_neg,Complex.exp_neg]
      exact primeRootSpectralField.inv_mem hw
  exact h z z.property

/-- Passing from individual zeros to their entire relation group adds no prime-value coefficients. -/
theorem primeSpectralField_eq_rootField : primeSpectralField = primeRootSpectralField := by
  apply le_antisymm
  · apply Subfield.closure_le.mpr
    rintro x ⟨⟨p,z⟩,rfl⟩
    exact primeEigenvalue_mem_rootField p p.property z
  · apply Subfield.closure_le.mpr
    rintro x ⟨⟨p,q⟩,rfl⟩
    exact primeEigenvalue_mem_spectralField p p.property (rawZeroRelationRoot q)

/-- Agreement on every prime generator is agreement on the whole spectral field. -/
theorem primeSpectralField_hom_ext (σ τ : ℂ →ₐ[ℚ] ℂ)
    (h : ∀ p : ℕ, p.Prime → ∀ z : rawZeroRelationGroup,
      σ (zeroPrimeEigenvalue p z) = τ (zeroPrimeEigenvalue p z)) :
    ∀ x ∈ primeSpectralField, σ x = τ x := by
  intro x hx
  induction hx using Subfield.closure_induction with
  | mem x hx =>
    obtain ⟨⟨p,z⟩,rfl⟩ := hx
    exact h p p.property z
  | one => rw [map_one,map_one]
  | add x y _ _ hx hy => rw [map_add,map_add,hx,hy]
  | neg x _ hx => rw [map_neg,map_neg,hx]
  | inv x _ hx => rw [map_inv₀,map_inv₀,hx]
  | mul x y _ _ hx hy => rw [map_mul,map_mul,hx,hy]

/-- Every compatible scalar embedding preserves the prime spectral field. -/
theorem allPrimeScalar_preserves_field (σ : ℂ →ₐ[ℚ] ℂ) (hσ : PreservesAllPrimeZeroSpectrum σ) :
    ∀ x ∈ primeSpectralField, σ x ∈ primeSpectralField := by
  intro x hx
  induction hx using Subfield.closure_induction with
  | mem x hx =>
    obtain ⟨⟨p,z⟩,rfl⟩ := hx
    rw [← allPrimeExponentHom_eigenvalue σ hσ p p.property z]
    exact primeEigenvalue_mem_spectralField p p.property _
  | one => rw [map_one]; exact primeSpectralField.one_mem
  | add x y _ _ hx hy => rw [map_add]; exact primeSpectralField.add_mem hx hy
  | neg x _ hx => rw [map_neg]; exact primeSpectralField.neg_mem hx
  | inv x _ hx => rw [map_inv₀]; exact primeSpectralField.inv_mem hx
  | mul x y _ _ hx hy => rw [map_mul]; exact primeSpectralField.mul_mem hx hy

/-- Restriction of a compatible scalar embedding to its canonical coefficient field. -/
def primeSpectralFieldMap (σ : ℂ →ₐ[ℚ] ℂ) (hσ : PreservesAllPrimeZeroSpectrum σ) :
    primeSpectralField →ₐ[ℚ] primeSpectralField where
  toFun x := ⟨σ x,allPrimeScalar_preserves_field σ hσ x x.property⟩
  map_one' := Subtype.ext (map_one σ)
  map_zero' := Subtype.ext (map_zero σ)
  map_add' x y := Subtype.ext (map_add σ (x : ℂ) (y : ℂ))
  map_mul' x y := Subtype.ext (map_mul σ (x : ℂ) (y : ℂ))
  commutes' a := Subtype.ext (σ.commutes a)

/-- Agreement on the spectral field is exactly agreement on the full exponent group. -/
theorem primeSpectralField_agreement_iff_exponents
    (σ τ : ℂ →ₐ[ℚ] ℂ) (hσ : PreservesAllPrimeZeroSpectrum σ) (hτ : PreservesAllPrimeZeroSpectrum τ) :
    (∀ x ∈ primeSpectralField, σ x = τ x) ↔ allPrimeExponentHom σ hσ = allPrimeExponentHom τ hτ := by
  constructor
  · intro h
    apply AddMonoidHom.ext
    intro z
    apply zeroPrimeEigenvalue_pair_injective
    exact Prod.ext
      (((allPrimeExponentHom_eigenvalue σ hσ 2 Nat.prime_two z).trans
        (h _ (primeEigenvalue_mem_spectralField 2 Nat.prime_two z))).trans
          (allPrimeExponentHom_eigenvalue τ hτ 2 Nat.prime_two z).symm)
      (((allPrimeExponentHom_eigenvalue σ hσ 3 Nat.prime_three z).trans
        (h _ (primeEigenvalue_mem_spectralField 3 Nat.prime_three z))).trans
          (allPrimeExponentHom_eigenvalue τ hτ 3 Nat.prime_three z).symm)
  · intro h
    apply primeSpectralField_hom_ext
    intro p hp z
    rw [← allPrimeExponentHom_eigenvalue σ hσ p hp z,
      ← allPrimeExponentHom_eigenvalue τ hτ p hp z,h]

/-- The identity scalar action preserves every prime value. -/
theorem allPrimeSpectrum_id : PreservesAllPrimeZeroSpectrum (AlgHom.id ℚ ℂ) :=
  fun z => ⟨z,fun _ _ => rfl⟩

private theorem allPrimeExponentHom_id :
    allPrimeExponentHom (AlgHom.id ℚ ℂ) allPrimeSpectrum_id = AddMonoidHom.id rawZeroRelationGroup := by
  apply AddMonoidHom.ext
  intro z
  apply zeroPrimeEigenvalue_pair_injective
  exact Prod.ext (allPrimeExponentHom_eigenvalue _ _ 2 Nat.prime_two z)
    (allPrimeExponentHom_eigenvalue _ _ 3 Nat.prime_three z)

/-- The exact invisible scalar kernel is pointwise fixing of the prime spectral field. -/
theorem allPrimeExponent_kernel_iff
    (σ : ℂ →ₐ[ℚ] ℂ) (hσ : PreservesAllPrimeZeroSpectrum σ) :
    allPrimeExponentHom σ hσ = AddMonoidHom.id rawZeroRelationGroup ↔
      ∀ x ∈ primeSpectralField, σ x = x := by
  rw [← allPrimeExponentHom_id]
  exact (primeSpectralField_agreement_iff_exponents σ (AlgHom.id ℚ ℂ) hσ allPrimeSpectrum_id).symm

/-- The effective exponent action is faithful on restricted scalar maps. -/
theorem primeSpectralFieldMap_eq_iff_exponents
    (σ τ : ℂ →ₐ[ℚ] ℂ) (hσ : PreservesAllPrimeZeroSpectrum σ) (hτ : PreservesAllPrimeZeroSpectrum τ) :
    primeSpectralFieldMap σ hσ = primeSpectralFieldMap τ hτ ↔
      allPrimeExponentHom σ hσ = allPrimeExponentHom τ hτ := by
  rw [← primeSpectralField_agreement_iff_exponents σ τ hσ hτ]
  constructor
  · intro h x hx
    exact congrArg (fun z : primeSpectralField => (z : ℂ)) (DFunLike.congr_fun h ⟨x,hx⟩)
  · intro h
    apply AlgHom.ext
    intro x
    exact Subtype.ext (h x x.property)

/-- A scalar automorphism compatible in both directions descends to the entire spectral field. -/
def primeSpectralFieldEquiv (σ : ℂ ≃ₐ[ℚ] ℂ)
    (hσ : PreservesAllPrimeZeroSpectrum σ.toAlgHom)
    (hσinv : PreservesAllPrimeZeroSpectrum σ.symm.toAlgHom) :
    primeSpectralField ≃ₐ[ℚ] primeSpectralField where
  __ := primeSpectralFieldMap σ.toAlgHom hσ
  invFun := primeSpectralFieldMap σ.symm.toAlgHom hσinv
  left_inv x := Subtype.ext (σ.symm_apply_apply (x : ℂ))
  right_inv x := Subtype.ext (σ.apply_symm_apply (x : ℂ))

private theorem allPrimeExponent_comp_inverse
    (σ τ : ℂ →ₐ[ℚ] ℂ) (hσ : PreservesAllPrimeZeroSpectrum σ) (hτ : PreservesAllPrimeZeroSpectrum τ)
    (hστ : σ.comp τ = AlgHom.id ℚ ℂ) (z : rawZeroRelationGroup) :
    allPrimeExponentHom σ hσ (allPrimeExponentHom τ hτ z) = z := by
  apply zeroPrimeEigenvalue_pair_injective
  have hp (p : ℕ) (hp : p.Prime) :
      zeroPrimeEigenvalue p (allPrimeExponentHom σ hσ (allPrimeExponentHom τ hτ z)) =
        zeroPrimeEigenvalue p z := by
    rw [allPrimeExponentHom_eigenvalue σ hσ p hp,allPrimeExponentHom_eigenvalue τ hτ p hp]
    exact DFunLike.congr_fun hστ (zeroPrimeEigenvalue p z)
  exact Prod.ext (hp 2 Nat.prime_two) (hp 3 Nat.prime_three)

/-- Compatible scalar automorphisms act by genuine automorphisms on all integer zero relations. -/
def allPrimeExponentEquiv (σ : ℂ ≃ₐ[ℚ] ℂ)
    (hσ : PreservesAllPrimeZeroSpectrum σ.toAlgHom)
    (hσinv : PreservesAllPrimeZeroSpectrum σ.symm.toAlgHom) :
    rawZeroRelationGroup ≃+ rawZeroRelationGroup where
  __ := allPrimeExponentHom σ.toAlgHom hσ
  invFun := allPrimeExponentHom σ.symm.toAlgHom hσinv
  left_inv z := allPrimeExponent_comp_inverse _ _ hσinv hσ (by
    apply AlgHom.ext
    intro a
    exact σ.symm_apply_apply a) z
  right_inv z := allPrimeExponent_comp_inverse _ _ hσ hσinv (by
    apply AlgHom.ext
    intro a
    exact σ.apply_symm_apply a) z

private theorem primeEigenvalue_unit (p : ℕ) (hp : p.Prime) :
    zeroPrimeEigenvalue p (rationalZeroOne : rawZeroRelationGroup) = (p : ℂ) := by
  change Complex.exp ((Real.log p : ℂ)*1) = (p : ℂ)
  rw [mul_one]
  exact GaloisForLFunctions.RHTower.SixExponentials.exp_log_nat hp.pos

/-- Rational scalars force preservation of the unit weight recovered from functional pairing. -/
theorem allPrimeExponentHom_one (σ : ℂ →ₐ[ℚ] ℂ) (hσ : PreservesAllPrimeZeroSpectrum σ) :
    allPrimeExponentHom σ hσ (rationalZeroOne : rawZeroRelationGroup) = rationalZeroOne := by
  apply zeroPrimeEigenvalue_pair_injective
  have hp (p : ℕ) (hp : p.Prime) :
      zeroPrimeEigenvalue p (allPrimeExponentHom σ hσ rationalZeroOne) =
        zeroPrimeEigenvalue p rationalZeroOne := by
    rw [allPrimeExponentHom_eigenvalue σ hσ p hp]
    simp only [primeEigenvalue_unit p hp,map_natCast]
  exact Prod.ext (hp 2 Nat.prime_two) (hp 3 Nat.prime_three)

/-- Every rational exponent in the actual integer zero group is fixed, including all its denominators. -/
theorem allPrimeExponentHom_rational (σ : ℂ →ₐ[ℚ] ℂ) (hσ : PreservesAllPrimeZeroSpectrum σ)
    (z : rationalZeroSubgroup) : allPrimeExponentHom σ hσ (z : rawZeroRelationGroup) = z := by
  obtain ⟨n,hn,m,he⟩ := rationalZero_denominator z
  have hrel : n • (z : rawZeroRelationGroup) = m • (rationalZeroOne : rawZeroRelationGroup) :=
    congrArg (fun x : rationalZeroSubgroup => (x : rawZeroRelationGroup)) he
  have ht : n • allPrimeExponentHom σ hσ (z : rawZeroRelationGroup) = n • (z : rawZeroRelationGroup) := by
    calc
      n • allPrimeExponentHom σ hσ (z : rawZeroRelationGroup) =
          allPrimeExponentHom σ hσ (n • (z : rawZeroRelationGroup)) := (map_nsmul _ n _).symm
      _ = allPrimeExponentHom σ hσ (m • (rationalZeroOne : rawZeroRelationGroup)) := by rw [hrel]
      _ = m • (rationalZeroOne : rawZeroRelationGroup) := by rw [map_zsmul,allPrimeExponentHom_one]
      _ = n • (z : rawZeroRelationGroup) := hrel.symm
  apply Subtype.ext
  have hc := congrArg (fun w : rawZeroRelationGroup => (w : ℂ)) ht
  change n • ((allPrimeExponentHom σ hσ (z : rawZeroRelationGroup)) : ℂ) =
    n • ((z : rawZeroRelationGroup) : ℂ) at hc
  simp only [nsmul_eq_mul] at hc
  exact mul_left_cancel₀ (by exact_mod_cast Nat.ne_of_gt hn) hc

/-- The field generated by prime powers of rational exponents actually present in the zero group. -/
def rationalPrimeSpectralField : Subfield ℂ := Subfield.closure
  (Set.range fun d : Nat.Primes × rationalZeroSubgroup =>
    zeroPrimeEigenvalue d.1 (d.2 : rawZeroRelationGroup))

/-- The radical field is a canonical subfield of the full prime spectral field. -/
theorem rationalPrimeSpectralField_le : rationalPrimeSpectralField ≤ primeSpectralField := by
  apply Subfield.closure_le.mpr
  rintro x ⟨⟨p,z⟩,rfl⟩
  exact primeEigenvalue_mem_spectralField p p.property z

/-- Every prime-compatible scalar embedding fixes the entire rational-exponent radical field. -/
theorem allPrimeScalar_fixes_rationalField
    (σ : ℂ →ₐ[ℚ] ℂ) (hσ : PreservesAllPrimeZeroSpectrum σ) :
    ∀ x ∈ rationalPrimeSpectralField, σ x = x := by
  intro x hx
  induction hx using Subfield.closure_induction with
  | mem x hx =>
    obtain ⟨⟨p,z⟩,rfl⟩ := hx
    rw [← allPrimeExponentHom_eigenvalue σ hσ p p.property z,allPrimeExponentHom_rational]
  | one => exact map_one σ
  | add x y _ _ hx hy => rw [map_add,hx,hy]
  | neg x _ hx => rw [map_neg,hx]
  | inv x _ hx => rw [map_inv₀,hx]
  | mul x y _ _ hx hy => rw [map_mul,hx,hy]

/-- Every element of the rational-exponent radical field is algebraic over the rationals. -/
theorem rationalPrimeSpectralField_algebraic :
    ∀ x ∈ rationalPrimeSpectralField, IsAlgebraic ℚ x := by
  intro x hx
  induction hx using Subfield.closure_induction with
  | mem x hx =>
    obtain ⟨⟨p,z⟩,rfl⟩ := hx
    obtain ⟨a,ha⟩ := (mem_rationalZeroSubgroup z).mp z.property
    change IsAlgebraic ℚ (Complex.exp ((Real.log (p : ℕ) : ℂ)*((z : rawZeroRelationGroup) : ℂ)))
    rw [ha,mul_comm]
    exact rational_prime_exponential_algebraic a p.property.pos
  | one => exact isAlgebraic_one
  | add x y _ _ hx hy => exact hx.add hy
  | neg x _ hx => exact hx.neg
  | inv x _ hx => exact hx.inv
  | mul x y _ _ hx hy => exact hx.mul hy

/-- The full spectral field contains a transcendental element and is not algebraic over ℚ. -/
theorem primeSpectralField_has_transcendental :
    ∃ x : primeSpectralField, ¬ IsAlgebraic ℚ (x : ℂ) := by
  by_contra! h
  have hp (p : ℕ) (hp : p.Prime) : AlgebraicPrimeTime p ⊤ := by
    intro z _
    have ha := h ⟨zeroPrimeEigenvalue p z,primeEigenvalue_mem_spectralField p hp z⟩
    change IsAlgebraic ℚ (Complex.exp ((Real.log p : ℂ)*(z : ℂ))) at ha
    simpa only [mul_comm] using ha
  exact rawMotive_not_three_algebraic_prime_times Nat.prime_two Nat.prime_three Nat.prime_five
    (by norm_num) (by norm_num) (by norm_num) ⟨hp 2 Nat.prime_two,hp 3 Nat.prime_three,hp 5 Nat.prime_five⟩

/-- The fixed radical field is strictly smaller than the full prime spectral field. -/
theorem rationalPrimeSpectralField_ne_full : rationalPrimeSpectralField ≠ primeSpectralField := by
  intro h
  obtain ⟨x,hx⟩ := primeSpectralField_has_transcendental
  exact hx (rationalPrimeSpectralField_algebraic x (h.symm ▸ x.property))

/-- Ordinary conjugation regarded over the rational ground field. -/
def primeSpectralScalarConjugation : ℂ →ₐ[ℚ] ℂ :=
  Complex.conjAe.toAlgHom.restrictScalars ℚ

/-- Conjugation transports every prime value through ordinary conjugation of its exponent. -/
theorem primeEigenvalue_conjugation (p : ℕ) (z : rawZeroRelationGroup) :
    zeroPrimeEigenvalue p (rawZeroConjugation z) = (starRingEnd ℂ) (zeroPrimeEigenvalue p z) := by
  change Complex.exp ((Real.log p : ℂ)*(starRingEnd ℂ) (z : ℂ)) =
    (starRingEnd ℂ) (Complex.exp ((Real.log p : ℂ)*(z : ℂ)))
  rw [← Complex.exp_conj,map_mul,Complex.conj_ofReal]

/-- Ordinary conjugation is compatible with the entire prime spectrum. -/
theorem allPrimeSpectrum_conjugation : PreservesAllPrimeZeroSpectrum primeSpectralScalarConjugation :=
  fun z => ⟨rawZeroConjugation z,fun p _ => primeEigenvalue_conjugation p z⟩

/-- The exponent action recovered from conjugation is actual conjugation of all zero relations. -/
theorem allPrimeExponentHom_conjugation :
    allPrimeExponentHom primeSpectralScalarConjugation allPrimeSpectrum_conjugation =
      rawZeroConjugation.toAddMonoidHom := by
  apply AddMonoidHom.ext
  intro z
  apply zeroPrimeEigenvalue_pair_injective
  exact Prod.ext
    ((allPrimeExponentHom_eigenvalue _ _ 2 Nat.prime_two z).trans (primeEigenvalue_conjugation 2 z).symm)
    ((allPrimeExponentHom_eigenvalue _ _ 3 Nat.prime_three z).trans (primeEigenvalue_conjugation 3 z).symm)

/-- Ordinary conjugation descends to the canonical prime-value coefficient field. -/
def primeSpectralConjugation : primeSpectralField ≃ₐ[ℚ] primeSpectralField where
  __ := primeSpectralFieldMap primeSpectralScalarConjugation allPrimeSpectrum_conjugation
  invFun := primeSpectralFieldMap primeSpectralScalarConjugation allPrimeSpectrum_conjugation
  left_inv x := Subtype.ext (star_star (x : ℂ))
  right_inv x := Subtype.ext (star_star (x : ℂ))

/-- Every actual zero has a nonreal prime value already at two or three. -/
theorem rawZero_nonreal_prime_value (q : XiZeroCopy) :
    (starRingEnd ℂ) (zeroPrimeEigenvalue 2 (rawZeroRelationRoot q)) ≠
        zeroPrimeEigenvalue 2 (rawZeroRelationRoot q) ∨
      (starRingEnd ℂ) (zeroPrimeEigenvalue 3 (rawZeroRelationRoot q)) ≠
        zeroPrimeEigenvalue 3 (rawZeroRelationRoot q) := by
  by_contra! h
  have he : rawZeroConjugation (rawZeroRelationRoot q) = rawZeroRelationRoot q := by
    apply zeroPrimeEigenvalue_pair_injective
    exact Prod.ext ((primeEigenvalue_conjugation 2 _).trans h.1)
      ((primeEigenvalue_conjugation 3 _).trans h.2)
  have hc := congrArg (fun z : rawZeroRelationGroup => (z : ℂ).im) he
  change -(q.1 : ℂ).im = (q.1 : ℂ).im at hc
  have hz : (q.1 : ℂ).im = 0 := by linarith only [hc]
  exact xi_divisor_support_im_ne_zero q.1 hz

/-- The real structure is nontrivial on the actual prime spectral field. -/
theorem primeSpectralConjugation_ne_id :
    primeSpectralConjugation ≠ 1 := by
  intro h
  obtain ⟨ρ,hρ⟩ := xiDivisorSupport_infinite.nonempty
  let q : XiZeroCopy := ⟨⟨ρ,hρ⟩,⟨0,by
    have hp := xi_divisor_pos_on_support ⟨ρ,hρ⟩
    omega⟩⟩
  have hp (p : ℕ) (hp : p.Prime) :
      (starRingEnd ℂ) (zeroPrimeEigenvalue p (rawZeroRelationRoot q)) =
        zeroPrimeEigenvalue p (rawZeroRelationRoot q) := by
    have he := DFunLike.congr_fun h
      (⟨zeroPrimeEigenvalue p (rawZeroRelationRoot q),
        primeEigenvalue_mem_spectralField p hp (rawZeroRelationRoot q)⟩ : primeSpectralField)
    exact congrArg (fun x : primeSpectralField => (x : ℂ)) he
  exact (rawZero_nonreal_prime_value q).elim (fun h₂ => h₂ (hp 2 Nat.prime_two))
    (fun h₃ => h₃ (hp 3 Nat.prime_three))

/-- Arithmetic compatibility retains every prime translation on the full coordinate algebra. -/
def RationalCommutesWithAllPrimeTranslations
    (F : ZeroMotiveAlgebra →ₐ[ℚ] ZeroMotiveAlgebra) : Prop :=
  ∀ p : ℕ, p.Prime → ∀ f, F (zeroMotivePrimeTranslation p f) = zeroMotivePrimeTranslation p (F f)

private theorem allPrimeCommutant_to_two
    (F : ZeroMotiveAlgebra →ₐ[ℚ] ZeroMotiveAlgebra)
    (hF : RationalCommutesWithAllPrimeTranslations F) : RationalCommutesWithPrimeTranslations F :=
  ⟨hF 2 Nat.prime_two,hF 3 Nat.prime_three⟩

/-- A pointed map commuting with every prime induces a scalar embedding preserving their joint spectrum. -/
theorem allPrimePointed_scalar_preserves_spectrum
    (F : ZeroMotiveAlgebra →ₐ[ℚ] ZeroMotiveAlgebra)
    (hF : RationalCommutesWithAllPrimeTranslations F)
    (hpoint : RationalPreservesZeroMotiveIdentity F) :
    PreservesAllPrimeZeroSpectrum (zeroMotiveRationalScalarAction F) := by
  intro z
  have htwo := allPrimeCommutant_to_two F hF
  obtain ⟨w,_,_,hw⟩ := rationalPointedPrime_basis F htwo hpoint z
  refine ⟨w,?_⟩
  intro p hp
  have he : zeroMotivePrimeTranslation p (F (AddMonoidAlgebra.single z 1)) =
      zeroMotiveRationalScalarAction F (zeroPrimeEigenvalue p z) • F (AddMonoidAlgebra.single z 1) := by
    rw [← hF p hp,zeroMotivePrimeTranslation_basis,rationalPrimeCommutant_smul F htwo]
  rw [hw] at he
  have hc := congrArg (fun f : ZeroMotiveAlgebra => f.coeff w) he
  rw [zeroMotivePrimeTranslation_coeff] at hc
  change zeroPrimeEigenvalue p w*(AddMonoidAlgebra.single w (1 : ℂ)).coeff w =
    zeroMotiveRationalScalarAction F (zeroPrimeEigenvalue p z)*(AddMonoidAlgebra.single w (1 : ℂ)).coeff w at hc
  simpa only [AddMonoidAlgebra.coeff_single,Finsupp.single_eq_same,mul_one] using hc

private theorem spectralAlgHom_ext {F G : ZeroMotiveAlgebra →ₐ[ℚ] ZeroMotiveAlgebra}
    (h : ∀ z : rawZeroRelationGroup, ∀ a : ℂ,
      F (AddMonoidAlgebra.single z a) = G (AddMonoidAlgebra.single z a)) : F = G := by
  apply AddMonoidAlgebra.algHom_ext
  · intro z
    exact h z 1
  · apply AlgHom.ext
    intro a
    exact h 0 a

private theorem primeSpectralTranslation_single (p : ℕ) (z : rawZeroRelationGroup) (a : ℂ) :
    zeroMotivePrimeTranslation p (AddMonoidAlgebra.single z a) =
      AddMonoidAlgebra.single z (a*zeroPrimeEigenvalue p z) := by
  rw [zeroMotivePrimeTranslation,zeroMotiveTranslation_single]
  rfl

/-- The canonical two-prime lift commutes with all primes precisely as prescribed by the full spectrum. -/
theorem allPrimeScalarLift_commutes (σ : ℂ →ₐ[ℚ] ℂ) (hσ : PreservesAllPrimeZeroSpectrum σ) :
    RationalCommutesWithAllPrimeTranslations (zeroMotiveScalarLift σ (allPrimeSpectrum_to_two σ hσ)) := by
  intro p hp f
  let H := zeroMotiveScalarLift σ (allPrimeSpectrum_to_two σ hσ)
  have he : H.comp ((zeroMotivePrimeTranslation p).restrictScalars ℚ) =
      ((zeroMotivePrimeTranslation p).restrictScalars ℚ).comp H := by
    apply spectralAlgHom_ext
    intro z a
    change zeroMotiveScalarLift σ (allPrimeSpectrum_to_two σ hσ)
      (zeroMotivePrimeTranslation p (AddMonoidAlgebra.single z a)) =
      zeroMotivePrimeTranslation p (zeroMotiveScalarLift σ (allPrimeSpectrum_to_two σ hσ)
        (AddMonoidAlgebra.single z a))
    rw [primeSpectralTranslation_single,zeroMotiveScalarLift_single,zeroMotiveScalarLift_single,
      primeSpectralTranslation_single,map_mul]
    change AddMonoidAlgebra.single _ (σ a*σ (zeroPrimeEigenvalue p z)) =
      AddMonoidAlgebra.single _ (σ a*zeroPrimeEigenvalue p (allPrimeExponentHom σ hσ z))
    rw [allPrimeExponentHom_eigenvalue σ hσ p hp]
  exact DFunLike.congr_fun he f

/-- Exact extension criterion for the entire family of prime translations, with no finite-prime replacement. -/
theorem allPrimeSpectrum_scalar_extension_iff (σ : ℂ →ₐ[ℚ] ℂ) :
    PreservesAllPrimeZeroSpectrum σ ↔
      ∃! F : ZeroMotiveAlgebra →ₐ[ℚ] ZeroMotiveAlgebra,
        RationalCommutesWithAllPrimeTranslations F ∧ RationalPreservesZeroMotiveIdentity F ∧
          zeroMotiveRationalScalarAction F = σ := by
  constructor
  · intro hσ
    let htwo := allPrimeSpectrum_to_two σ hσ
    refine ⟨zeroMotiveScalarLift σ htwo,
      ⟨allPrimeScalarLift_commutes σ hσ,zeroMotiveScalarLift_pointed σ htwo,
        zeroMotiveScalarLift_scalar σ htwo⟩,?_⟩
    intro F hF
    exact rationalPointedPrime_scalar_faithful F _ (allPrimeCommutant_to_two F hF.1)
      (zeroMotiveScalarLift_commutes σ htwo) hF.2.1 (zeroMotiveScalarLift_pointed σ htwo)
      (hF.2.2.trans (zeroMotiveScalarLift_scalar σ htwo).symm)
  · rintro ⟨F,⟨hF,hpoint,hscalar⟩,_⟩
    rw [← hscalar]
    exact allPrimePointed_scalar_preserves_spectrum F hF hpoint

/-- Fixing the spectral field supplies full prime compatibility without any additional condition. -/
theorem allPrimeSpectrum_of_fixes_field (σ : ℂ →ₐ[ℚ] ℂ)
    (h : ∀ x ∈ primeSpectralField, σ x = x) : PreservesAllPrimeZeroSpectrum σ := by
  intro z
  refine ⟨z,?_⟩
  intro p hp
  exact (h _ (primeEigenvalue_mem_spectralField p hp z)).symm

/-- The full invisible scalar kernel is exactly pointwise fixing of the spectral field. -/
theorem primeSpectralField_fixed_iff_trivial_exponent_action (σ : ℂ →ₐ[ℚ] ℂ) :
    (∀ x ∈ primeSpectralField, σ x = x) ↔
      ∃ hσ : PreservesAllPrimeZeroSpectrum σ,
        allPrimeExponentHom σ hσ = AddMonoidHom.id rawZeroRelationGroup := by
  constructor
  · intro h
    exact ⟨allPrimeSpectrum_of_fixes_field σ h,(allPrimeExponent_kernel_iff σ _).mpr h⟩
  · rintro ⟨hσ,h⟩
    exact (allPrimeExponent_kernel_iff σ hσ).mp h

/-- The fixed radical subfield is real as well as algebraic. -/
theorem rationalPrimeSpectralField_real :
    ∀ x ∈ rationalPrimeSpectralField, x.im = 0 := by
  intro x hx
  apply Complex.conj_eq_iff_im.mp
  exact allPrimeScalar_fixes_rationalField primeSpectralScalarConjugation allPrimeSpectrum_conjugation x hx

