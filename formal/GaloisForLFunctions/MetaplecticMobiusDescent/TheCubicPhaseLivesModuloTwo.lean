import GaloisForLFunctions.MetaplecticMobiusDescent.MobiusBecomesACubicGaussCoefficient
import GaloisForLFunctions.MetaplecticMobiusDescent.CubicReciprocityFromFrobenius

/-!
# The cubic conversion phase depends only on the class modulo two

The ideal generated by two is prime: a maximal ideal above it has norm dividing
four and contains three distinct cubic roots of unity, forcing norm four.
Cubic reciprocity then replaces the sextic value at four by a fixed cubic
character modulo two. This remains true after multiplying the prime factors.
The resulting formula separates the cubic ray factor from the quadratic Gauss sum.
-/

noncomputable section
open scoped BigOperators
namespace GaloisForLFunctions.MetaplecticMobiusDescent.Eisenstein

/-- The inert rational prime has primary generator minus two. -/
theorem neg_two_primary : lambda ^ 2 ∣ (-2 : O) - 1 := by
  have hrel : omega ^ 2 + omega + 1 = 0 := by
    simpa only [IsCyclotomicExtension.Rat.Three.coe_eta, omega] using
      (IsCyclotomicExtension.Rat.Three.eta_sq_add_eta_add_one
        (IsCyclotomicExtension.zeta_spec 3 ℚ K))
  have hlam : lambda ^ 2 = -3 * omega := by
    dsimp [lambda]
    linear_combination hrel
  refine ⟨omega ^ 2, ?_⟩
  calc
    (-2 : O) - 1 = -3 * omega ^ 3 := by rw [omega_primitive.pow_eq_one]; ring
    _ = lambda ^ 2 * omega ^ 2 := by rw [hlam]; ring

/-- A prime dividing a primary element is away from three. -/
theorem primary_maximal_divisor_good (t : O) (ht : lambda ^ 2 ∣ t - 1)
    (P : Ideal O) [P.IsMaximal] (htP : t ∈ P) : lambda ∉ P := by
  intro hlam
  have hlam2 : lambda ^ 2 ∈ P := by
    simpa only [pow_two] using P.mul_mem_left lambda hlam
  have hsub : t - 1 ∈ P := Ideal.mem_of_dvd P ht hlam2
  have hone : (1 : O) ∈ P := by simpa using P.sub_mem htP hsub
  exact (Ideal.IsMaximal.ne_top (inferInstance : P.IsMaximal))
    ((Ideal.eq_top_iff_one _).mpr hone)

/-- The inert prime above two. -/
def cubicTwoIdeal : Ideal O := Ideal.span {(-2 : O)}

/-- The inert prime has norm four. -/
theorem cubicTwoIdeal_absNorm : Ideal.absNorm cubicTwoIdeal = 4 := by
  have hn : Algebra.norm ℤ (-2 : O) = 4 := by
    apply (Int.cast_injective : Function.Injective (Int.cast : ℤ → O))
    rw [norm_int_eq_mul_conjO]
    rw [map_neg, map_ofNat]
    norm_num
  rw [cubicTwoIdeal, Ideal.absNorm_span_singleton, hn]
  rfl

/-- A prime above two has norm dividing four and containing the cubic roots,
so its norm is four and it equals the ideal generated by two. -/
instance cubicTwoIdeal_isMaximal : cubicTwoIdeal.IsMaximal := by
  have hnt : cubicTwoIdeal ≠ ⊤ := by
    intro h
    have hn := cubicTwoIdeal_absNorm
    rw [h, Ideal.absNorm_top] at hn
    contradiction
  obtain ⟨P, hP, hle⟩ := Ideal.exists_le_maximal cubicTwoIdeal hnt
  letI := hP
  have hm : (-2 : O) ∈ P := hle (Ideal.subset_span (by simp))
  have hg := primary_maximal_divisor_good (-2) neg_two_primary P hm
  have hdiv : Nat.card (O ⧸ P) ∣ 4 := by
    have h := Ideal.absNorm_dvd_absNorm_of_le hle
    rwa [cubicTwoIdeal_absNorm] at h
  have hge : 1 < Nat.card (O ⧸ P) := by
    rw [Nat.card_eq_fintype_card]
    exact Fintype.one_lt_card
  have hle4 : Nat.card (O ⧸ P) ≤ 4 := Nat.le_of_dvd (by decide) hdiv
  have hthree := card_sub_one_div_three P hg
  have hcard : Nat.card (O ⧸ P) = 4 := by omega
  obtain ⟨Q, hQ⟩ := (Ideal.dvd_iff_le).mpr hle
  have hnorm : Ideal.absNorm Q = 1 := by
    have h := congrArg Ideal.absNorm hQ
    rw [cubicTwoIdeal_absNorm, map_mul] at h
    change 4 = Nat.card (O ⧸ P) * Ideal.absNorm Q at h
    rw [hcard] at h
    omega
  have heq : cubicTwoIdeal = P := by
    rw [hQ, Ideal.absNorm_eq_one_iff.mp hnorm, ← Ideal.one_eq_top, mul_one]
  exact heq ▸ hP

theorem cubicTwoIdeal_good : lambda ∉ cubicTwoIdeal := by
  apply primary_maximal_divisor_good (-2) neg_two_primary
  exact Ideal.subset_span (by simp)

theorem cubicTwoIdeal_residue_char : ringChar (O ⧸ cubicTwoIdeal) = 2 := by
  have hmem : (2 : O) ∈ cubicTwoIdeal := by
    rw [cubicTwoIdeal, Ideal.span_singleton_neg]
    exact Ideal.subset_span (by simp)
  have hz : (2 : O ⧸ cubicTwoIdeal) = 0 := by
    simpa only [map_ofNat] using Ideal.Quotient.eq_zero_iff_mem.mpr hmem
  exact (Nat.prime_dvd_prime_iff_eq (CharP.char_is_prime (O ⧸ cubicTwoIdeal) _)
    Nat.prime_two).mp ((ringChar.spec (O ⧸ cubicTwoIdeal) 2).mp hz)

/-- The sextic value at four is a fixed cubic character modulo two. -/
theorem complexSextic_four_eq_fixed_two
    (P : Ideal O) [P.IsMaximal] (hgood : lambda ∉ P)
    (hchar : ringChar (O ⧸ P) ≠ 2) :
    complexSexticChar P hgood (4 : O ⧸ P) =
      ringComplex (cubicChar cubicTwoIdeal cubicTwoIdeal_good
        (Ideal.Quotient.mk cubicTwoIdeal (primaryGenerator P hgood))) := by
  have hfour : (4 : O ⧸ P) = (Ideal.Quotient.mk P (-2 : O)) ^ 2 := by
    simp only [map_ofNat, map_neg]
    ring
  rw [hfour, map_pow, ← MulChar.pow_apply' _ (by decide : (2 : ℕ) ≠ 0),
    (complexSexticChar_powers P hgood).1]
  change ringComplex (cubicChar P hgood (Ideal.Quotient.mk P (-2 : O))) = _
  congr 1
  exact cubic_reciprocity_distinct_residue_char P cubicTwoIdeal hgood cubicTwoIdeal_good
    (by rw [cubicTwoIdeal_residue_char]; exact hchar.symm)
    (primaryGenerator P hgood) (-2) (primaryGenerator_spec P hgood).1 rfl
    (primaryGenerator_spec P hgood).2 neg_two_primary

/-- Products of sextic values at four depend only on the primary product modulo two. -/
theorem complexSextic_four_prod_eq_fixed_two
    {ι : Type*} (s : Finset ι) (P : ι → Ideal O) [∀ i, (P i).IsMaximal]
    (hgood : ∀ i, lambda ∉ P i) (hchar : ∀ i, ringChar (O ⧸ P i) ≠ 2) :
    (∏ i ∈ s, complexSexticChar (P i) (hgood i) (4 : O ⧸ P i)) =
      ringComplex (cubicChar cubicTwoIdeal cubicTwoIdeal_good
        (Ideal.Quotient.mk cubicTwoIdeal (∏ i ∈ s, primaryGenerator (P i) (hgood i)))) := by
  simp only [map_prod]
  exact Finset.prod_congr rfl (fun i _ => complexSextic_four_eq_fixed_two (P i) (hgood i) (hchar i))

/-- The cubic ray factor is trivial on the class one modulo two. -/
theorem complexSextic_four_prod_eq_one
    {ι : Type*} (s : Finset ι) (P : ι → Ideal O) [∀ i, (P i).IsMaximal]
    (hgood : ∀ i, lambda ∉ P i) (hchar : ∀ i, ringChar (O ⧸ P i) ≠ 2)
    (hmod : (2 : O) ∣ (∏ i ∈ s, primaryGenerator (P i) (hgood i)) - 1) :
    (∏ i ∈ s, complexSexticChar (P i) (hgood i) (4 : O ⧸ P i)) = 1 := by
  have hmem : (∏ i ∈ s, primaryGenerator (P i) (hgood i)) - 1 ∈ cubicTwoIdeal := by
    rw [cubicTwoIdeal, Ideal.span_singleton_neg]
    exact Ideal.mem_span_singleton.mpr hmod
  have heq : Ideal.Quotient.mk cubicTwoIdeal (∏ i ∈ s, primaryGenerator (P i) (hgood i)) = 1 := by
    have hz := Ideal.Quotient.eq_zero_iff_mem.mpr hmem
    simpa only [map_sub, map_one, sub_eq_zero] using hz
  rw [complexSextic_four_prod_eq_fixed_two s P hgood hchar, heq, map_one, map_one]

/-- The remaining conversion factor contains only the primary product and the
quadratic Gauss sum once the cubic ray character is extracted. -/
theorem compositeConversionFactor_eq_rayFactor
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (P : ι → Ideal O) [∀ i, (P i).IsMaximal] (hinj : Function.Injective P)
    (hgood : ∀ i, lambda ∉ P i) (hchar : ∀ i, ringChar (O ⧸ P i) ≠ 2)
    (ψ : AddChar (O ⧸ ∏ i, P i) ℂ) :
    compositeConversionFactor P hinj hgood ψ =
      ringComplex (cubicChar cubicTwoIdeal cubicTwoIdeal_good
        (Ideal.Quotient.mk cubicTwoIdeal (∏ i, primaryGenerator (P i) (hgood i)))) *
      (∏ i, (Fintype.card (O ⧸ P i) : ℂ)) /
      (ringComplex (∏ i, primaryGenerator (P i) (hgood i)) *
        sexticResidueGauss P hinj hgood 3 ψ) := by
  unfold compositeConversionFactor gaussConversionFactor
  rw [Finset.prod_div_distrib, Finset.prod_mul_distrib, Finset.prod_mul_distrib]
  rw [complexSextic_four_prod_eq_fixed_two Finset.univ P hgood hchar]
  simp only [map_prod]
  congr 2
  rw [sexticResidueGauss, residueGauss_factorization]
  apply Finset.prod_congr rfl
  intro i _
  rw [(complexSexticChar_powers (P i) (hgood i)).2.1]

end GaloisForLFunctions.MetaplecticMobiusDescent.Eisenstein

#print axioms GaloisForLFunctions.MetaplecticMobiusDescent.Eisenstein.cubicTwoIdeal_isMaximal
#print axioms GaloisForLFunctions.MetaplecticMobiusDescent.Eisenstein.complexSextic_four_eq_fixed_two
#print axioms GaloisForLFunctions.MetaplecticMobiusDescent.Eisenstein.complexSextic_four_prod_eq_one
#print axioms GaloisForLFunctions.MetaplecticMobiusDescent.Eisenstein.compositeConversionFactor_eq_rayFactor
