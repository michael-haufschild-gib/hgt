import GaloisForLFunctions.MetaplecticMobiusDescent.MobiusBecomesACubicGaussCoefficient
import GaloisForLFunctions.HeckeLFunctions.HeckeFiniteFourierCoefficientsAreGaussSums
import Mathlib.RingTheory.DedekindDomain.Different

/-!
# The different normalizes the actual trace character

The derivative of `X²+X+1` identifies the different with `(1+2ω)`.
Consequently the trace dual of `(c)` is generated by `1/(c(1+2ω))`.
The resulting residue character is primitive for every nonzero `c`.

This fixes the analytic additive character in the composite Möbius-to-cubic
Gauss conversion, including its unit-modulus conversion factor.
-/

noncomputable section
open scoped BigOperators
namespace GaloisForLFunctions.MetaplecticMobiusDescent.Eisenstein

local instance : Algebra ℤ K := Ring.toIntAlgebra K

private instance intTowerO :
    @IsScalarTower ℤ O K (Algebra.toSMul : SMul ℤ O) (Algebra.toSMul : SMul O K) (Algebra.toSMul : SMul ℤ K) :=
  IsScalarTower.of_algebraMap_eq' (by ext n; simp)

private instance intTowerQ :
    @IsScalarTower ℤ ℚ K (Algebra.toSMul : SMul ℤ ℚ) (Algebra.toSMul : SMul ℚ K) (Algebra.toSMul : SMul ℤ K) :=
  IsScalarTower.of_algebraMap_eq' (by ext n; simp)

private instance : IsCyclotomicExtension {3} ℚ K :=
  CyclotomicField.isCyclotomicExtension 3 ℚ

private theorem omega_integral_adjoin : Algebra.adjoin ℤ {omega} = ⊤ := by
  simpa only [IsPrimitiveRoot.integralPowerBasis_gen, omega] using
    (IsCyclotomicExtension.zeta_spec 3 ℚ K).integralPowerBasis.adjoin_gen_eq_top

private theorem omega_field_adjoin : Algebra.adjoin ℚ {algebraMap O K omega} = ⊤ := by
  change Algebra.adjoin ℚ {IsCyclotomicExtension.zeta 3 ℚ K} = ⊤
  simpa only [IsPrimitiveRoot.powerBasis_gen] using
    ((IsCyclotomicExtension.zeta_spec 3 ℚ K).powerBasis ℚ).adjoin_gen_eq_top

private theorem omega_minpoly : minpoly ℤ omega = Polynomial.cyclotomic 3 ℤ := by
  have hmap := minpoly.algHom_eq (algebraMap O K).toIntAlgHom
    NumberField.RingOfIntegers.coe_injective omega
  rw [← hmap]
  exact (Polynomial.cyclotomic_eq_minpoly
    (IsCyclotomicExtension.zeta_spec 3 ℚ K) (by decide)).symm

/-- The derivative of the integral cyclotomic polynomial generates the different. -/
theorem different_eq_traceLambda : differentIdeal ℤ O = Ideal.span {traceLambda} := by
  have h := conductor_mul_differentIdeal ℤ ℚ K omega omega_field_adjoin
  rw [conductor_eq_top_of_adjoin_eq_top omega_integral_adjoin,
    ← Ideal.one_eq_top, one_mul, omega_minpoly] at h
  rw [h]
  congr 1
  simp only [Polynomial.cyclotomic_three, Polynomial.derivative_add,
    Polynomial.derivative_X_pow, Polynomial.derivative_X, Polynomial.derivative_one,
    Polynomial.aeval_add, Polynomial.aeval_C, map_mul, map_pow, Polynomial.aeval_X,
    map_one, add_zero, traceLambda]
  congr 1
  norm_num
  ring

local notation "FI" => FractionalIdeal (nonZeroDivisors O) K

/-- The codifferent is generated by the inverse of the trace denominator. -/
theorem traceDual_one : FractionalIdeal.dual ℤ ℚ (1 : FI) =
    FractionalIdeal.spanSingleton (nonZeroDivisors O) (algebraMap O K traceLambda)⁻¹ := by
  have h := coeIdeal_differentIdeal ℤ ℚ K O
  rw [different_eq_traceLambda, FractionalIdeal.coeIdeal_span_singleton] at h
  have hi := congrArg Inv.inv h
  simpa only [inv_inv, FractionalIdeal.spanSingleton_inv] using hi.symm

/-- Dividing the codifferent by a principal modulus gives its full trace dual. -/
theorem traceDual_principal (c : O) :
    FractionalIdeal.dual ℤ ℚ ((Ideal.span {c} : Ideal O) : FI) =
      FractionalIdeal.spanSingleton (nonZeroDivisors O)
        (algebraMap O K traceLambda * algebraMap O K c)⁻¹ := by
  rw [FractionalIdeal.dual_eq_mul_inv, traceDual_one,
    FractionalIdeal.coeIdeal_span_singleton, FractionalIdeal.spanSingleton_inv,
    FractionalIdeal.spanSingleton_mul_spanSingleton, mul_inv]

theorem traceLambda_ne_zero : traceLambda ≠ 0 := by
  have hrel : omega ^ 2 + omega + 1 = 0 := by
    simpa only [IsCyclotomicExtension.Rat.Three.coe_eta, omega] using
      (IsCyclotomicExtension.Rat.Three.eta_sq_add_eta_add_one
        (IsCyclotomicExtension.zeta_spec 3 ℚ K))
  have hs : traceLambda ^ 2 = (-3 : O) := by
    dsimp [traceLambda]
    linear_combination 4 * hrel
  intro hz
  rw [hz, zero_pow (by decide : (2 : ℕ) ≠ 0)] at hs
  norm_num at hs

open GaloisForLFunctions.HeckeLFunctions

/-- The finite principal modulus, with no real-place conditions. -/
def principalModulus (c : O) (hc : c ≠ 0) : Modulus K where
  fin := Ideal.span {c}
  fin_ne_bot := by
    intro h
    exact hc (Ideal.span_singleton_eq_bot.mp h)
  inf := ∅

/-- The inverse of the modulus times the different generator is a trace-dual frequency. -/
def principalTraceFrequency (c : O) (hc : c ≠ 0) :
    FractionalIdeal.dual ℤ ℚ (((principalModulus c hc).fin * ⊤ : Ideal O) : FI) :=
  ⟨(algebraMap O K traceLambda * algebraMap O K c)⁻¹, by
    dsimp only [principalModulus]
    rw [← Ideal.one_eq_top, mul_one, traceDual_principal]
    exact FractionalIdeal.mem_spanSingleton_self _ _⟩

/-- The analytic trace character on the actual principal residue ring. -/
def principalTraceChar (c : O) (hc : c ≠ 0) : AddChar (O ⧸ Ideal.span {c}) ℂ :=
  heckeResidueTraceCharacter (principalModulus c hc) (b := ⊤)
    (by simp) top_ne_bot (principalTraceFrequency c hc)

/-- The representative-independent phase is exp(2πi Tr(x/(c(1+2ω)))). -/
theorem principalTraceChar_apply (c : O) (hc : c ≠ 0) (x : O) :
    principalTraceChar c hc (Ideal.Quotient.mk (Ideal.span {c}) x) =
      Complex.exp ((Algebra.trace ℚ K
        ((algebraMap O K x) / (algebraMap O K traceLambda * algebraMap O K c)) : ℂ) *
          (2 * Real.pi * Complex.I)) := by
  have h := numberFieldTracePhase_eq_of_quotient_eq
    (principalModulus c hc) (b := ⊤) (by simp) top_ne_bot (principalTraceFrequency c hc)
    (residueRep_mem (by simp : (⊤ : Ideal O) ⊔ (principalModulus c hc).fin = ⊤)
      (Ideal.Quotient.mk (Ideal.span {c}) x))
    (show x ∈ (⊤ : Ideal O) from trivial)
    (mk_residueRep (by simp : (⊤ : Ideal O) ⊔ (principalModulus c hc).fin = ⊤) _)
  change numberFieldTracePhase _ _ = _ at h
  change numberFieldTracePhase _ _ = _
  rw [h, numberFieldTracePhase_eq_exp]
  simp only [principalTraceFrequency, NumberField.RingOfIntegers.coe_eq_algebraMap, div_eq_mul_inv]

/-- The different normalization gives a primitive character for every nonzero modulus. -/
theorem principalTraceChar_primitive (c : O) (hc : c ≠ 0) :
    (principalTraceChar c hc).IsPrimitive := by
  apply (heckeResidueTraceCharacter_isPrimitive_iff
    (principalModulus c hc) (b := ⊤) (by simp) top_ne_bot (principalTraceFrequency c hc)).mpr
  intro r hr
  have hr' : (algebraMap O K r) * (algebraMap O K traceLambda * algebraMap O K c)⁻¹ ∈
      FractionalIdeal.dual ℤ ℚ (1 : FI) := by
    simpa only [principalTraceFrequency, FractionalIdeal.coeIdeal_top,
      NumberField.RingOfIntegers.coe_eq_algebraMap] using hr
  rw [traceDual_one, FractionalIdeal.mem_spanSingleton] at hr'
  obtain ⟨z, hz⟩ := hr'
  change algebraMap O K z * (algebraMap O K traceLambda)⁻¹ =
    algebraMap O K r * (algebraMap O K traceLambda * algebraMap O K c)⁻¹ at hz
  have hd : algebraMap O K traceLambda ≠ 0 :=
    fun h => traceLambda_ne_zero (NumberField.RingOfIntegers.coe_injective h)
  have hcK : algebraMap O K c ≠ 0 :=
    fun h => hc (NumberField.RingOfIntegers.coe_injective h)
  have hzr : algebraMap O K z * algebraMap O K c = algebraMap O K r := by
    calc
      _ = (algebraMap O K z * (algebraMap O K traceLambda)⁻¹) *
          (algebraMap O K traceLambda * algebraMap O K c) := by field_simp [hd, hcK]
      _ = (algebraMap O K r * (algebraMap O K traceLambda * algebraMap O K c)⁻¹) *
          (algebraMap O K traceLambda * algebraMap O K c) := by rw [hz]
      _ = algebraMap O K r := by field_simp [hd, hcK]
  apply Ideal.mem_span_singleton.mpr
  refine ⟨z, ?_⟩
  apply NumberField.RingOfIntegers.coe_injective
  simpa only [map_mul, mul_comm] using hzr.symm

/-- Canonical primary generators are nonzero. -/
theorem primaryGenerator_ne_zero (P : Ideal O) [P.IsMaximal] (hgood : lambda ∉ P) :
    primaryGenerator P hgood ≠ 0 := by
  have hpos : 0 < ‖ringComplex (primaryGenerator P hgood)‖ := by
    rw [norm_primaryGenerator]
    exact Real.sqrt_pos.mpr (Nat.cast_pos.mpr Fintype.card_pos)
  intro hp
  rw [hp, map_zero, norm_zero] at hpos
  exact lt_irrefl _ hpos

section Composite
variable {ι : Type*} [Fintype ι]
    (P : ι → Ideal O) [∀ i, (P i).IsMaximal] (hgood : ∀ i, lambda ∉ P i)

theorem primeProduct_eq_span_primaryProduct :
    (∏ i, P i) = Ideal.span {∏ i, primaryGenerator (P i) (hgood i)} := by
  rw [← Ideal.prod_span_singleton]
  exact Finset.prod_congr rfl (fun i _ => (primaryGenerator_spec (P i) (hgood i)).1)

/-- The analytic trace character on a product of prime ideals, normalized by
its canonical primary generator and the different. -/
def analyticCompositeAddChar [DecidableEq ι] : AddChar (O ⧸ ∏ i, P i) ℂ :=
  (principalTraceChar (∏ i, primaryGenerator (P i) (hgood i))
    (Finset.prod_ne_zero_iff.mpr (fun i _ => primaryGenerator_ne_zero (P i) (hgood i)))).compAddMonoidHom
    (Ideal.quotEquivOfEq (primeProduct_eq_span_primaryProduct P hgood)).toAddMonoidHom

theorem analyticCompositeAddChar_primitive [DecidableEq ι] : (analyticCompositeAddChar P hgood).IsPrimitive :=
  ProductGauss.primitive_comp_ringEquiv _ _ (principalTraceChar_primitive _ _)

/-- The composite character evaluates the actual field-trace phase. -/
theorem analyticCompositeAddChar_apply [DecidableEq ι] (x : O) :
    analyticCompositeAddChar P hgood (Ideal.Quotient.mk (∏ i, P i) x) =
      Complex.exp ((Algebra.trace ℚ K
        ((algebraMap O K x) / (algebraMap O K traceLambda *
          algebraMap O K (∏ i, primaryGenerator (P i) (hgood i)))) : ℂ) *
            (2 * Real.pi * Complex.I)) := by
  simp only [analyticCompositeAddChar, AddChar.compAddMonoidHom_apply,
    RingEquiv.toAddMonoidHom, RingHom.toAddMonoidHom_eq_coe,
    RingEquiv.toRingHom_eq_coe, AddMonoidHom.coe_coe, RingHom.coe_coe, Ideal.quotEquivOfEq_mk]
  exact principalTraceChar_apply _ _ x

/-- Möbius conversion with the analytic trace normalization, including the
unit norm of the explicit conversion factor. -/
theorem analytic_moebius_conversion [DecidableEq ι] (hinj : Function.Injective P)
    (hchar : ∀ i, ringChar (O ⧸ P i) ≠ 2) :
    (UniqueFactorizationMonoid.moebius (∏ i, P i) : ℂ) *
        star (sexticResidueGauss P hinj hgood 1 (analyticCompositeAddChar P hgood)) =
      compositeConversionFactor P hinj hgood (analyticCompositeAddChar P hgood) *
        sexticResidueGauss P hinj hgood 2 (analyticCompositeAddChar P hgood) ∧
    ‖compositeConversionFactor P hinj hgood (analyticCompositeAddChar P hgood)‖ = 1 :=
  ⟨moebius_star_sexticGauss_eq_cubic P hinj hgood hchar _
      (analyticCompositeAddChar_primitive P hgood),
    norm_compositeConversionFactor P hinj hgood hchar _
      (analyticCompositeAddChar_primitive P hgood)⟩

end Composite
end GaloisForLFunctions.MetaplecticMobiusDescent.Eisenstein

