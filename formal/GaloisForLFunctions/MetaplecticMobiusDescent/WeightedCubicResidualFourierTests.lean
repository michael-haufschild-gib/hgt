  intro X Y Z hX hY hZ a B H i ha haTop hB hH0 hH hbin
  have hZ0 : 0< Z := by linarith
  let k := fun σ p=> continuedRowOnLines S hS hmax P hPS η u W0 W1 X Y Z σ (1-a-6*e) (17/50) p
  let E : Set HeightSpace := {t | |t.1.1|≤ H}
