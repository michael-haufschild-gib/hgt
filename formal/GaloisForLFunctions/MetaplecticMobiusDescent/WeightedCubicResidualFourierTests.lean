lemma height_slab_integral_wzx (f : HeightSpace→ℂ) (H : ℝ) (hH : 0≤ H)
    (hf : IntegrableOn f {t : HeightSpace | |t.1.1|≤ H} heightMeasure) :
    (∫p : HeightSpace in {t : HeightSpace | |t.1.1|≤ H},f p ∂heightMeasure)=
      ∫w : ℝ,∫z : ℝ,∫x : ℝ in -H..H,f ((x,z),w) := by
