theorem selected_V_ne_zero (P : HeckeIdealSeries.PrimeIdeal) (hQ : (4:ℝ)≤ P.val.absNorm) (z : ℂ)
    (hz : (4/25:ℝ)≤ z.re) : 1-coordV P.val.absNorm z≠0 := by
  apply ProbeLocal.one_sub_ne_zero_of_norm_le_half
