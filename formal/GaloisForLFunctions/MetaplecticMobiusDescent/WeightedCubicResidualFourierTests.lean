        fixedBadMask (cubicIdealGenerator s.puncture) 1 z fixedBadMask_ne_zero
        (cubicIdealGenerator_ne_zero _ s.puncture_ne_zero) one_ne_zero hn
        (dvd_mul_right _ _) (dvd_mul_left _ _)).mpr hunit)

