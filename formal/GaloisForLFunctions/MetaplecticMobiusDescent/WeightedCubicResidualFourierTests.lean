  have hprod : 0≤∏P:T,A P := Finset.prod_nonneg (fun P _=> hA P)
  refine ⟨L*R*Cn*(Ch*N)*(∏P:T,A P),by dsimp [N];positivity,?_⟩
  intro a B H i ha ha1 hB hH hbin x w z hxl hxr hxi hw hz
