    convert hh using 1 <;> first
    | rfl
    | rw [←Real.rpow_add hZ]; congr 1; ring
  · have hh := (div_le_iff₀ (Real.rpow_pos_of_pos hZ (1+ell))).mp hhi
    convert hh using 1 <;> first
    | rfl
    | rw [←Real.rpow_add hZ]; congr 1; ring

