  have hB : 0≤ B := by
    apply mul_nonneg
    · exact Finset.prod_nonneg (fun i _=> Real.rpow_nonneg (by unfold elementNorm; positivity) _)
    · exact Real.rpow_nonneg (by unfold elementNorm; positivity) _
