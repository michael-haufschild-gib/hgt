lemma outer_source_vertical_inverse (W : SchwartzMap ℝ ℂ) (a b : ℝ) (ha : 0< a)
    (hW : Function.support W⊆Set.Icc a b) (σ r : ℝ) (hr : 0< r) :
    W r=verticalIntegral σ (fun w=>(r:ℂ)^(-w)*mellin W w) := by
