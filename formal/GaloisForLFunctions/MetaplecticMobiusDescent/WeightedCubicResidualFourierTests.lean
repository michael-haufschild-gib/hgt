theorem dyadic_to_common_ball {α : Type*} (S : Finset α) (a : α→O)
    (ha : ∀i,Supported (Ideal.span {a i})) (coeff : α→ℂ)
    (Z d K0 c sigma δ reserve : ℝ) (hZ : 1< Z) (hsigma : 0≤ sigma) (hδ : 0≤δ)
