    _=∑h : O⧸Ideal.span {9*c},∑B : Finset (FreeReflection.pool R Q Q0),
        FreeReflection.reflectionInactiveStratumWeight R F Q Q0 B*
          (fourier J h*cuspStratumValue _ _ _ _ _ _ _ _ _ _ (A J B)) := by
      apply Finset.sum_congr rfl
