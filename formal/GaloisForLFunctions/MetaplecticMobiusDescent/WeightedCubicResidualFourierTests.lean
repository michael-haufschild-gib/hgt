      D⊆C∪cubePrincipalSupport b.support b.leftExponent b.rightExponent b.leftBit b.rightBit →
      f≠0 → 0≤ E → 0≤ G₁ → 0≤ G₂ → 1≤ Z → 0≤ M → M≤ Mmax →
