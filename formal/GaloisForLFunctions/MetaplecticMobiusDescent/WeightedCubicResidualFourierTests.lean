    intro hzero
    exact hnon (by unfold sourceSummand;rw [hzero,mul_zero])
  have hb:=first_profile_live_products W Φ K (b*X) _ hq hW hprof
  constructor
  · change 1 ≤ X / (dyadScale (dyadIndex (leftNorm p x)) *
