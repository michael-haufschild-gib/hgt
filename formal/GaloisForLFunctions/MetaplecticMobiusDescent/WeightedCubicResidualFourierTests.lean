  refine ⟨hZ.1,?_⟩
  intro Q hQM
  rw [width_zero,loss_zero]
  constructor
  · intro s hQ hwidth p t X₁ X₂ hX₁ hX₂ _ _
    have hh:=hzero (internalQ Q η₀) Z hZ.1.le s hQ hwidth p t X₁ X₂ hX₁ hX₂
    have hp:=control_mono p (Finset.subset_union_left (s₁:=Szero) (s₂:=Spositive))
