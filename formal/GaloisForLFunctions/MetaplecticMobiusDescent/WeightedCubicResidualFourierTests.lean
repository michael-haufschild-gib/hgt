  constructor
  · exact fun h=> hc.dvd_of_dvd_mul_left h
  · exact fun h=> h.trans (dvd_mul_left _ _)

theorem nonunitPartitionSet_eq_actual (C D : Ideal O) (U : Finset (CommonIndex C D))
    (w : O) (hpart : canonicalPartition C D U w) :
