 theorem zero_all_lengths_floor (a b:ℝ)(ha:0< a):
    ∃S:Finset (ℕ×ℕ),∃C:ℝ,0< C ∧
    ∀(W₁ W₂:SchwartzMap ℝ ℂ),Function.support (W₁:ℝ→ℂ)⊆Set.Icc a b→
      Function.support (W₂:ℝ→ℂ)⊆Set.Icc a b→
    ∀(η:Character)(mask A:O)(r:Radial)(χ:O→Character),
