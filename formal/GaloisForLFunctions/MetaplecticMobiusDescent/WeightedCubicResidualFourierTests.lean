theorem rowTwistedSum_absolute (η : Character) (m A z : O) (W : ℝ→ℂ)
    (b M t X : ℝ) (hb : 0≤ b) (hM : 0≤ M) (hX : 0< X)
    (hs : Function.support W⊆Set.Iic b) (hW : ∀x,‖W x‖≤ M) :
    ‖rowTwistedSum η m A z W t X‖≤(128*b*M)*X := by
