    (hmax : ∀P∈S,P.IsMaximal) (P : Fin K→ HeckeIdealSeries.PrimeIdeal) (hPS : ∀i,(P i).val∉S)
    (η : Character) (u : FreeRow) (W0 W1 : SchwartzMap ℝ ℂ) (X Y Z a e H : ℝ) : ℂ :=
