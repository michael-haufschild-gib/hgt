    ∃H : Finset (ℕ×ℕ),∃C D : ℝ,0< C ∧ 0< D ∧ ∀ᶠ Z : ℝ in atTop,1< Z ∧
      ∀{ι : Type}[Fintype ι],∀(G : ι→𝓢(ℝ,ℂ))(χ : ι→Character)(P : ι→ℂ)(omega : ι→ℝ)
