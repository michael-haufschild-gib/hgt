lemma norm_le_of_squared (x:ℂ) (H V d M:ℝ) (hH:0≤ H) (hV:0≤ V) (hd:0< d) (hM:0< M)
    (hb:‖x‖^2≤ H^2*V/(d^2*M^2)):
