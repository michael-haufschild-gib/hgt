/-- Pass the uniform finite-frequency estimate to the full nonzero contribution. -/
theorem original_energy_nonzero_bound (δ ε : ℝ) (hδ : 0<δ) (hδ1 : δ<1)
    (hε : 0<ε) (hε1 : ε<1/6) (a b M₀ : ℝ) (ha : 0< a) (hab : a< b) (hM₀ : 0≤ M₀)
