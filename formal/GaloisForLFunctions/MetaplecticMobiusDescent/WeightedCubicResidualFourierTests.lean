theorem exists_central_loss_parameters (R ε : ℝ) (hR : 0≤ R) (hε : 0<ε) :
    ∃ e₀ κ η : ℝ, 0< e₀ ∧ e₀≤1/1000 ∧ 0<κ ∧ κ≤1 ∧ 0<η ∧
      ∀ e : ℝ, 0< e → e< e₀ → 12*e*(R+2)+8*κ+2*η≤ε/2 := by
  let e₀ : ℝ := min (1/1000) (ε/(96*(R+2)))
  let κ : ℝ := min (1/2) (ε/64)
