      (slots : Set σ).PairwiseDisjoint lists → (∀ i∈slots,∀ k∈lists i,‖a i k‖≤1) →
      ∀ (test₁ test₂ : Finset ι→ℂ) (W : 𝓢(ℝ,ℂ)) (E G₁ G₂ L K : ℝ),
      0≤ E → 0≤ G₁ → 0≤ G₂ → 0≤ L → primeProductNorm p extra₁≤ E → primeProductNorm p extra₂≤ E →
      (∀ U,‖test₁ U‖≤ G₁) → (∀ U,‖test₂ U‖≤ G₂) →
