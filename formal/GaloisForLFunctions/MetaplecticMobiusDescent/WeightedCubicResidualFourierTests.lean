    rw [←hspan,idealRowHom_prime u.val (Ideal.span {p}) hg.1]
  rw [he]
  exact Complex.norm_eq_one_of_pow_eq_one (complexSexticChar_unit_six p u.val hg.1 hg.2 hu) (by decide)

