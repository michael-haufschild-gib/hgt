        (c * jLabel p B v ε₁ ε₂) d (firstCoreTest H V y negative t D)
        (if negative then -z else z) :=
  inputConjugateRow_fixed_pool p (fun i => complexSexticChar (Ideal.span {p i}) (hg i)) hinj F D _ _ _ _ _ _

