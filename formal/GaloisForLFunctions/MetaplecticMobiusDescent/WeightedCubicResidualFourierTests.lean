    2*((a-1/2)*(1-m)+6*e*(2-m)+4*κ+η)≤(2*a-1)*(1-m)+ε := by
  have hEr : e*r≤ e*R := mul_le_mul_of_nonneg_left hr he
  have hEm : 0≤ e*m := mul_nonneg he hm
  have hER : 0≤ e*R := mul_nonneg he hR
