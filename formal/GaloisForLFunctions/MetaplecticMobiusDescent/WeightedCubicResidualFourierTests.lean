    (B J : ℕ) (hB : 2≤ B) :
    ∃H : Finset (ℕ×ℕ),∃C : ℝ,0< C ∧ ∀ᶠ Z : ℝ in atTop,1< Z ∧
      ∀{ι : Type}[Fintype ι],∀(G : ι→𝓢(ℝ,ℂ))(χ ψ : ι→Character)(P : ι→ℂ)(omega : ι→ℝ)
        (Wshort : ℝ→ℂ)(c d M along bshort D E Rcap : ℝ),
