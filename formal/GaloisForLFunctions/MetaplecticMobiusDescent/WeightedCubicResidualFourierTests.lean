      ∀(pool:α→Finset (Ideal O))(β:α→Ideal O→ℂ)(P:α→ℝ)
        (t X₁ X₂ E p:ℝ),
      (∀i,∀I∈pool i,Prime I) → (∀i,0< P i) →
      (∀i,∀I∈pool i,‖β i I‖≤ M i) →
      (∀i,∀I∈pool i,β i I≠0 → (I.absNorm:ℝ)≤ bslot i*P i) →
      0< X₁ → 0< X₂ → 0≤ E → p≤1 →
      (∀D₁∈(CubicEisenstein.primeSupport s.puncture).powerset,
       ∀D₂∈(CubicEisenstein.primeSupport s.puncture).powerset,
