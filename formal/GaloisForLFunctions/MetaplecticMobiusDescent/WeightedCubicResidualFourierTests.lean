theorem central_squared_exponents (R a e κ η ε r m : ℝ)
    (hR : 0≤ R) (he : 0≤ e) (hκ : 0≤κ) (_hη : 0≤η)
    (hr : r≤ R) (hm : 0≤ m)
    (hbudget : 12*e*(R+2)+8*κ+2*η≤ε) :
