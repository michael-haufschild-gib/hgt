    have hkl : keyNorms p k 0*keyNorms p k 2*keyNorms p k 3≤ L := by
      simpa [←hk',keyNorms,sourceKey] using hleft x hx
    have hkr : keyNorms p k 0*keyNorms p k 2*keyNorms p k 4≤ L := by
