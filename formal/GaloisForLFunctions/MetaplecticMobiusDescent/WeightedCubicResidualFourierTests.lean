  have hpow {x y:ℝ}(h:x≤ y):Z^x≤ Z^y:=Real.rpow_le_rpow_of_exponent_le hZ.1.le h
  have hRC:((R*C).absNorm:ℝ)≤ Z^(P+Ccap):=by
