lemma support_zero (W:ℝ→ℂ)(a b:ℝ)(ha:0<a)
    (hs:Function.support W⊆Set.Icc a b):W 0=0:=by
  by_contra hn
  exact (not_le_of_gt ha) (hs hn).1

