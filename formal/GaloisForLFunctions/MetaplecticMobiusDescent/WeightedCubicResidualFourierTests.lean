theorem contourTupleOutside {K : ℕ} (S : Finset (Ideal O)) (P : Fin K→HeckeIdealSeries.PrimeIdeal)
    (hPS : ∀i,(P i).val∉S) : ∀Q∈Finset.univ.image P,Q.val∉S := by
