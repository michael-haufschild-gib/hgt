/-!
# Height-weighted Fourier tests of the residual cubic family

Bounded continuous height weights give bounded `L²` Fourier pairings on
every compact positive height interval. Analytic continuation identifies
the actual residual Fourier modes with their cubic Bessel profiles.
The bounds are uniform in the lattice frequency. Moving the interval
towards height zero gives subexponential growth of the coefficients.
Exponential Bessel decay then reconstructs a continuous Fourier series.
Fourier completeness identifies it with the actual residue and upgrades
the cubic character law to pointwise automorphy. Ramified phase periodicity
and Chinese remainders give a finite unramified Gauss-series decomposition.
Finite rational averaging is contractive on the quotient Hilbert space.
Primitive trace characters determine the local Gauss factors and their
prime-power lifting laws. Rational pullbacks preserve the completed energy
graph. Finite-trace unfolding proves residual orthogonality from zero cusp
means. Exact prime-cube phase sums cancel these means on a common cover,
forcing the cube eigenrelation. Fourier transport removes primary cube
factors and determines the unramified prime-power residue table.
-/
noncomputable section
open MeasureTheory Set Filter
open scoped BigOperators Classical Topology InnerProductSpace ComplexConjugate MatrixGroups ENNReal
namespace GaloisForLFunctions.MetaplecticMobiusDescent.CubicEisenstein
open Eisenstein CubicJacobi CubicKubota CubicRamified

def cuspWeightedFourierPhase (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (w : HyperbolicSpace) : ℂ :=
  ρ (hyperbolicHeight w)*cuspFourierPhase h w

lemma cuspWeightedFourierPhase_continuous (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) :
    Continuous (cuspWeightedFourierPhase ρ h) :=
  (ρ.continuous.comp hyperbolicHeight_continuous).mul (cuspFourierPhase_continuous h)

lemma cuspWeightedFourierPhase_bound (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (w : HyperbolicSpace) :
    ‖cuspWeightedFourierPhase ρ h w‖≤‖ρ‖ := by
  rw [cuspWeightedFourierPhase,norm_mul,cuspFourierPhase_norm,mul_one]
  exact ρ.norm_coe_le_norm _

lemma cuspWeightedFourierTest_memLp (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) :
    MemLp (fun w => star (cuspWeightedFourierPhase ρ h w)) 2
      (hyperbolicVolume.restrict (cuspPeriodStrip 5 6)) := by
  apply MemLp.of_bound (cuspWeightedFourierPhase_continuous ρ h).star.aestronglyMeasurable ‖ρ‖
  exact Eventually.of_forall (fun w => by rw [norm_star]; exact cuspWeightedFourierPhase_bound ρ h w)

def cuspWeightedFourierTestL2 (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) : CuspStripL2 :=
  (cuspWeightedFourierTest_memLp ρ h).toLp (fun w => star (cuspWeightedFourierPhase ρ h w))

def kernelCuspWeightedFourier (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) : KernelQuotientL2→L[ℂ]ℂ :=
  (innerSL ℂ (cuspWeightedFourierTestL2 ρ h)).comp kernelCuspPullback

lemma kernelCuspWeightedFourier_integral (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (F : KernelQuotientL2) :
    kernelCuspWeightedFourier ρ h F=∫w in cuspPeriodStrip 5 6,
      F (integralOrbitProjection globalKubotaKernel w)*cuspWeightedFourierPhase ρ h w∂hyperbolicVolume := by
  change inner ℂ (cuspWeightedFourierTestL2 ρ h) (kernelCuspPullback F)=_
  rw [L2.inner_def]
  apply integral_congr_ae
  filter_upwards [MemLp.coeFn_toLp (cuspWeightedFourierTest_memLp ρ h),kernelCuspPullback_ae_eq F] with w hw hp
  rw [RCLike.inner_apply,cuspWeightedFourierTestL2,hw,hp]
  simp only [starRingEnd_apply,star_star]

lemma kernelCuspWeightedFourier_restrict (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (F : KernelQuotientL2) :
    kernelCuspWeightedFourier ρ h (kernelMassRestrictionCLM kernelCuspAverageCompact
      kernelCuspAverageCompact_isCompact.measurableSet F)=kernelCuspWeightedFourier ρ h F := by
  rw [kernelCuspWeightedFourier_integral,kernelCuspWeightedFourier_integral]
  have hm := kernelProjection_cuspPeriodStrip_measurePreserving 5 6 (by norm_num)
  have he := hm.quasiMeasurePreserving.ae_eq_comp (ae_restrict_of_ae
    (kernelMassRestriction_coe kernelCuspAverageCompact kernelCuspAverageCompact_isCompact.measurableSet F)
    (s := kernelCuspStripSet))
  apply integral_congr_ae
  filter_upwards [he,ae_restrict_mem (cuspPeriodStrip_measurable 5 6)] with w hw hwm
  exact congrArg (fun z : ℂ => z*cuspWeightedFourierPhase ρ h w)
    (hw.trans (Set.indicator_of_mem (kernelCuspStripSet_subset_compact ⟨w,hwm,rfl⟩) _))

def kernelCuspWeightedFourierFamily (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (s : ℂ) : ℂ :=
  kernelCuspWeightedFourier ρ h
    (kernelLocalCorrectedSeed kernelCuspAverageCompact kernelCuspAverageCompact_isCompact
      2 3 (by norm_num) (by norm_num) s)

lemma kernelCuspWeightedFourierFamily_meromorphicAt (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) :
    MeromorphicAt (kernelCuspWeightedFourierFamily ρ h) (4/3:ℂ) :=
  meromorphicAt_clm (kernelCuspWeightedFourier ρ h)
    (kernelLocalCorrectedSeed_meromorphicAt kernelCuspAverageCompact kernelCuspAverageCompact_isCompact
      2 3 (by norm_num) (by norm_num))

lemma kernelCuspWeightedFourierFamily_analyticAt_nonreal (ρ : BoundedContinuousFunction ℝ ℂ) (h : O)
    (s : ℂ) (hs : s.re≠1) (hi : s.im≠0) :
    AnalyticAt ℂ (kernelCuspWeightedFourierFamily ρ h) s := by
  exact (ContinuousLinearMap.analyticAt (𝕜 := ℂ) (E := KernelQuotientL2) (F := ℂ)
    (kernelCuspWeightedFourier ρ h) _).comp_of_eq
      (kernelLocalCorrectedSeed_analyticAt_nonreal kernelCuspAverageCompact
        kernelCuspAverageCompact_isCompact 2 3 (by norm_num) (by norm_num) s hs hi) rfl

lemma kernelCuspWeightedFourierFamily_residue_limit (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) :
    Tendsto (fun s : ℂ => (s-4/3)*kernelCuspWeightedFourierFamily ρ h s)
      (𝓝[≠] (4/3:ℂ)) (𝓝 (kernelCuspWeightedFourier ρ h cubicEisensteinResidue)) := by
  have hh := (kernelCuspWeightedFourier ρ h).continuous.continuousAt.tendsto.comp
    (cubicEisensteinResidue_local_limit kernelCuspAverageCompact kernelCuspAverageCompact_isCompact)
  simpa only [Function.comp_def,map_smul,smul_eq_mul,kernelCuspWeightedFourier_restrict,
    kernelCuspWeightedFourierFamily] using hh

lemma kernelCuspWeightedFourierFamily_initial (ρ : BoundedContinuousFunction ℝ ℂ) (h : O)
    (s : ℂ) (hs : 4<s.re) (hi : 0<s.im) :
    kernelCuspWeightedFourierFamily ρ h s=∫w in cuspPeriodStrip 5 6,
      hyperbolicEisenstein s w*cuspWeightedFourierPhase ρ h w∂hyperbolicVolume := by
  rw [kernelCuspWeightedFourierFamily,kernelCuspWeightedFourier_integral]
  have hm := kernelProjection_cuspPeriodStrip_measurePreserving 5 6 (by norm_num)
  have he := hm.quasiMeasurePreserving.ae_eq_comp (ae_restrict_of_ae
    (cubicEisensteinLocalFamily_initial_ae kernelCuspAverageCompact kernelCuspAverageCompact_isCompact s hs hi)
    (s := kernelCuspStripSet))
  apply integral_congr_ae
  filter_upwards [he,ae_restrict_mem (cuspPeriodStrip_measurable 5 6)] with w hw hwm
  dsimp only [Function.comp_def] at hw
  rw [hw,Set.indicator_of_mem (kernelCuspStripSet_subset_compact ⟨w,hwm,rfl⟩),
    kernelQuotientEisenstein_mk]

def cuspWeightedWhittakerHeightFactor (ρ : BoundedContinuousFunction ℝ ℂ) (s : ℂ) (h : O) : ℂ :=
  ∫v in Set.Icc (5:ℝ) 6,ρ v*((v:ℂ)^(-s-1)*sourceFourierKernel s (cuspFrequency h*v))

lemma hyperbolicEisenstein_cusp_weighted_fourier_nonzero (ρ : BoundedContinuousFunction ℝ ℂ)
    (s : ℂ) (hs : 2<s.re) (h : O) (hh : h≠0) :
    (∫w in cuspPeriodStrip 5 6,hyperbolicEisenstein s w*cuspWeightedFourierPhase ρ h w∂hyperbolicVolume)=
      ((9*Real.sqrt 3/2:ℝ):ℂ)*scatteringCoefficient s h*cuspWeightedWhittakerHeightFactor ρ s h := by
  let g : HyperbolicSpace→ℂ := fun w => hyperbolicEisenstein s w*cuspWeightedFourierPhase ρ h w
  have hg : Continuous g := (hyperbolicEisenstein_continuous s hs).mul (cuspWeightedFourierPhase_continuous ρ h)
  rw [cuspPeriodStrip_integral_coordinates g hg.aestronglyMeasurable (cuspCoordinateLift_weighted_integrable g hg)]
  have hexp : ∀v∈Set.Icc (5:ℝ) 6,
      ((∫z in periodDomain,g (cuspCoordinateLift (v,z)))/(v:ℂ)^3)=
        (((9*Real.sqrt 3/2:ℝ):ℂ)*scatteringCoefficient s h)*
          (ρ v*((v:ℂ)^(-s-1)*sourceFourierKernel s (cuspFrequency h*v))) := by
    intro v hv
    have hpos : 0<v := lt_of_lt_of_le (by norm_num) hv.1
    have hinner : (∫z in periodDomain,g (cuspCoordinateLift (v,z)))=
        ρ v*(eisensteinFourierCoefficient v hpos s h*((9*Real.sqrt 3/2:ℝ):ℂ)) := by
      simp_rw [g,cuspCoordinateLift_positive v _ hpos,hyperbolicEisenstein_upperPoint,
        cuspWeightedFourierPhase,hyperbolicHeight_upperPoint,cuspFourierPhase,hyperbolicHorizontal_upperPoint]
      have hrearr : (∫z in periodDomain,upperEisenstein z v hpos s*
          (ρ v*tracePhase (-cuspFrequency h*z)))=
          ρ v*(∫z in periodDomain,upperEisenstein z v hpos s*tracePhase (-cuspFrequency h*z)) := by
        rw [←integral_const_mul]
        apply integral_congr_ae
        exact Eventually.of_forall (fun z => by ring)
      rw [hrearr,eisensteinFourierCoefficient]
      congr 1
      exact (div_mul_cancel₀ _ cusp_volume_ne_zero).symm
    rw [hinner,eisensteinFourierCoefficient_formula v hpos s hs h,if_neg hh,zero_add]
    have hv0 : (v:ℂ)≠0 := Complex.ofReal_ne_zero.mpr hpos.ne'
    have hp : (v:ℂ)^(-s-1)=(v:ℂ)^(2-s)/(v:ℂ)^3 := by
      rw [show -s-1=(2-s)-3 by ring,Complex.cpow_sub _ _ hv0]
      congr 1
      exact Complex.cpow_natCast _ 3
    rw [hp]
    ring
  calc
    _ = ∫v in Set.Icc (5:ℝ) 6,(((9*Real.sqrt 3/2:ℝ):ℂ)*scatteringCoefficient s h)*
        (ρ v*((v:ℂ)^(-s-1)*sourceFourierKernel s (cuspFrequency h*v))) :=
      setIntegral_congr_fun measurableSet_Icc hexp
    _ = _ := integral_const_mul _ _

lemma kernelCuspWeightedFourierFamily_initial_factor (ρ : BoundedContinuousFunction ℝ ℂ)
    (h : O) (hh : h≠0) (s : ℂ) (hs : 4<s.re) (hi : 0<s.im) :
    kernelCuspWeightedFourierFamily ρ h s=
      ((9*Real.sqrt 3/2:ℝ):ℂ)*scatteringCoefficient s h*cuspWeightedWhittakerHeightFactor ρ s h := by
  rw [kernelCuspWeightedFourierFamily_initial ρ h s hs hi,
    hyperbolicEisenstein_cusp_weighted_fourier_nonzero ρ s (by linarith) h hh]


lemma cuspWeightedWhittakerHeightFactor_analyticAt
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (s : ℂ) (hs : 1 < s.re) :
    AnalyticAt ℂ (fun w => cuspWeightedWhittakerHeightFactor ρ w h) s := by
  apply Complex.analyticAt_iff_eventually_differentiableAt.mpr
  filter_upwards [(isOpen_lt continuous_const Complex.continuous_re).mem_nhds hs] with w hw
  simpa only [cuspWeightedWhittakerHeightFactor, mul_assoc] using
    cuspWeightedWhittakerAverage_differentiableAt ρ (cuspFrequency h) w hw

/-- Cross multiplication continues the weighted Fourier identity without
dividing by a Whittaker factor that might vanish away from the residue. -/
theorem kernelCuspWeightedFourierFamily_cross_identity
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (hh : h ≠ 0) :
    Set.EqOn
      (fun s => kernelCuspWeightedFourierFamily ρ h s * cuspWhittakerHeightFactor s h)
      (fun s => kernelCuspFourierFamily h 2 3 (by norm_num) (by norm_num) s *
        cuspWeightedWhittakerHeightFactor ρ s h)
      {s : ℂ | 1 < s.re ∧ 0 < s.im} := by
  have hconvex : Convex ℝ {s : ℂ | 1 < s.re ∧ 0 < s.im} :=
    ((convex_Ioi (1 : ℝ)).linear_preimage Complex.reCLM.toLinearMap).inter
      ((convex_Ioi (0 : ℝ)).linear_preimage Complex.imCLM.toLinearMap)
  have hl : AnalyticOnNhd ℂ
      (fun s => kernelCuspWeightedFourierFamily ρ h s * cuspWhittakerHeightFactor s h)
      {s : ℂ | 1 < s.re ∧ 0 < s.im} := fun s hs =>
    (kernelCuspWeightedFourierFamily_analyticAt_nonreal ρ h s hs.1.ne' hs.2.ne').mul
      (cuspWhittakerHeightFactor_analyticAt h s hs.1)
  have hr : AnalyticOnNhd ℂ
      (fun s => kernelCuspFourierFamily h 2 3 (by norm_num) (by norm_num) s *
        cuspWeightedWhittakerHeightFactor ρ s h)
      {s : ℂ | 1 < s.re ∧ 0 < s.im} := fun s hs =>
    (kernelCuspFourierFamily_analyticAt_nonreal h 2 3 (by norm_num) (by norm_num)
      s hs.1.ne' hs.2.ne').mul (cuspWeightedWhittakerHeightFactor_analyticAt ρ h s hs.1)
  apply hl.eqOn_of_preconnected_of_eventuallyEq hr hconvex.isPreconnected
    (show (5 + Complex.I : ℂ) ∈ {s : ℂ | 1 < s.re ∧ 0 < s.im} by norm_num)
  have hopen : IsOpen {s : ℂ | 4 < s.re ∧ 0 < s.im} :=
    (isOpen_lt continuous_const Complex.continuous_re).inter
      (isOpen_lt continuous_const Complex.continuous_im)
  filter_upwards [hopen.mem_nhds (by norm_num : (5 + Complex.I : ℂ) ∈
    {s : ℂ | 4 < s.re ∧ 0 < s.im})] with s hs
  rw [kernelCuspWeightedFourierFamily_initial_factor ρ h hh s hs.1 hs.2,
    cubicEisensteinFourierFamily_initial h hh s hs.1 hs.2]
  ring

/-- Every bounded height weight detects the same scattering residue. -/
theorem kernelCuspWeightedFourier_residue
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (hh : h ≠ 0) :
    kernelCuspWeightedFourier ρ h cubicEisensteinResidue =
      ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * nonzeroScatteringResidue h *
        cuspWeightedWhittakerHeightFactor ρ (4 / 3) h := by
  have hbase := (cuspWhittakerHeightFactor_analyticAt h (4 / 3) (by norm_num)).continuousAt.tendsto.mono_left
    (show 𝓝[≠] (4 / 3 : ℂ) ≤ 𝓝 (4 / 3 : ℂ) from nhdsWithin_le_nhds)
  have hweight := (cuspWeightedWhittakerHeightFactor_analyticAt ρ h (4 / 3)
    (by norm_num)).continuousAt.tendsto.mono_left
      (show 𝓝[≠] (4 / 3 : ℂ) ≤ 𝓝 (4 / 3 : ℂ) from nhdsWithin_le_nhds)
  have hl := ((kernelCuspWeightedFourierFamily_residue_limit ρ h).mul hbase).comp
    thetaApproach_tendsto_complex_punctured
  have hr := ((kernelCuspFourierFamily_residue_limit h 2 3 (by norm_num) (by norm_num)).mul
    hweight).comp thetaApproach_tendsto_complex_punctured
  have hevent :
      (fun t : ℝ =>
        (((4 / 3 : ℂ) + t + t * Complex.I - 4 / 3) *
          kernelCuspWeightedFourierFamily ρ h ((4 / 3 : ℂ) + t + t * Complex.I)) *
            cuspWhittakerHeightFactor ((4 / 3 : ℂ) + t + t * Complex.I) h)
        =ᶠ[𝓝[>] (0 : ℝ)]
      (fun t : ℝ =>
        (((4 / 3 : ℂ) + t + t * Complex.I - 4 / 3) *
          kernelCuspFourierFamily h 2 3 (by norm_num) (by norm_num)
            ((4 / 3 : ℂ) + t + t * Complex.I)) *
              cuspWeightedWhittakerHeightFactor ρ ((4 / 3 : ℂ) + t + t * Complex.I) h) := by
    filter_upwards [self_mem_nhdsWithin] with t ht
    change 0 < t at ht
    have hs : (4 / 3 : ℂ) + t + t * Complex.I ∈ {s : ℂ | 1 < s.re ∧ 0 < s.im} := by
      constructor
      · norm_num
        linarith
      · simpa using ht
    simpa only [mul_assoc] using congrArg
      (fun z : ℂ => ((4 / 3 : ℂ) + t + t * Complex.I - 4 / 3) * z)
      (kernelCuspWeightedFourierFamily_cross_identity ρ h hh hs)
  have heq : kernelCuspWeightedFourier ρ h cubicEisensteinResidue *
      cuspWhittakerHeightFactor (4 / 3) h =
        kernelCuspFourier h cubicEisensteinResidue *
          cuspWeightedWhittakerHeightFactor ρ (4 / 3) h :=
    tendsto_nhds_unique_of_eventuallyEq hl hr hevent
  apply mul_right_cancel₀ (cuspWhittakerHeightFactor_center_ne_zero h)
  rw [heq, nonzeroScatteringResidue]
  field_simp [cusp_volume_ne_zero, cuspWhittakerHeightFactor_center_ne_zero h]

/-- Normalization converting the scattering residue to the coefficient of
the height profile `v K_{1/3}(4π|frequency|v)`. -/
def cubicResidualFourierCoefficient (h : O) : ℂ :=
  nonzeroScatteringResidue h *
    ((2 * Real.pi : ℂ) / Complex.Gamma (4 / 3) *
      (2 * Real.pi * ‖cuspFrequency h‖ : ℂ) ^ (1 / 3 : ℂ))

lemma sourceFourierKernel_residual_height (h : O) (hh : h ≠ 0) (v : ℝ) (hv : 0 < v) :
    (v : ℂ) ^ (-(4 / 3 : ℂ) - 1) * sourceFourierKernel (4 / 3) (cuspFrequency h * v) =
      ((2 * Real.pi : ℂ) / Complex.Gamma (4 / 3) *
        (2 * Real.pi * ‖cuspFrequency h‖ : ℂ) ^ (1 / 3 : ℂ)) *
          (schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) / (v : ℂ) ^ 2) := by
  have hv0 : (v : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hv.ne'
  rw [sourceFourierKernel_four_thirds _ (mul_ne_zero (cuspFrequency_ne_zero h hh) hv0),
    norm_mul, Complex.norm_of_nonneg hv.le]
  simp only [Complex.ofReal_mul, ← mul_assoc]
  have hsplit : (2 * Real.pi * ‖cuspFrequency h‖ * v : ℂ) ^ (1 / 3 : ℂ) =
      (2 * Real.pi * ‖cuspFrequency h‖ : ℂ) ^ (1 / 3 : ℂ) * (v : ℂ) ^ (1 / 3 : ℂ) := by
    simpa only [Complex.ofReal_mul, Complex.ofReal_ofNat] using
      Complex.mul_cpow_ofReal_nonneg
        (show 0 ≤ 2 * Real.pi * ‖cuspFrequency h‖ by positivity) hv.le (1 / 3 : ℂ)
  rw [hsplit]
  have hpower : (v : ℂ) ^ (-(4 / 3 : ℂ) - 1) * (v : ℂ) ^ (1 / 3 : ℂ) *
      (v : ℂ) ^ 2 = 1 := by
    rw [← Complex.cpow_natCast (v : ℂ) 2, ← Complex.cpow_add _ _ hv0,
      ← Complex.cpow_add _ _ hv0]
    norm_num
  calc
    _ = ((2 * Real.pi : ℂ) / Complex.Gamma (4 / 3) *
        (2 * Real.pi * ‖cuspFrequency h‖ : ℂ) ^ (1 / 3 : ℂ) *
          schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v)) / (v : ℂ) ^ 2 := by
      apply (eq_div_iff (pow_ne_zero 2 hv0)).mpr
      linear_combination
        ((2 * Real.pi : ℂ) / Complex.Gamma (4 / 3) *
          (2 * Real.pi * ‖cuspFrequency h‖ : ℂ) ^ (1 / 3 : ℂ) *
            schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v)) * hpower
    _ = _ := by ring

/-- The actual residual vector has the cubic Bessel height profile, tested
against every bounded continuous weight on the cusp strip. -/
theorem kernelCuspWeightedFourier_residue_bessel
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (hh : h ≠ 0) :
    kernelCuspWeightedFourier ρ h cubicEisensteinResidue =
      ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * cubicResidualFourierCoefficient h *
        (∫ v in Set.Icc (5 : ℝ) 6,
          ρ v * (schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) / (v : ℂ) ^ 2)) := by
  rw [kernelCuspWeightedFourier_residue ρ h hh, cuspWeightedWhittakerHeightFactor,
    cubicResidualFourierCoefficient]
  have hfactor :
      (∫ v in Set.Icc (5 : ℝ) 6,
        ρ v * ((v : ℂ) ^ (-(4 / 3 : ℂ) - 1) * sourceFourierKernel (4 / 3) (cuspFrequency h * v))) =
      ((2 * Real.pi : ℂ) / Complex.Gamma (4 / 3) *
        (2 * Real.pi * ‖cuspFrequency h‖ : ℂ) ^ (1 / 3 : ℂ)) *
          (∫ v in Set.Icc (5 : ℝ) 6,
            ρ v * (schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) / (v : ℂ) ^ 2)) := by
    rw [← integral_const_mul]
    apply setIntegral_congr_fun measurableSet_Icc
    intro v hv
    dsimp only
    rw [sourceFourierKernel_residual_height h hh v (lt_of_lt_of_le (by norm_num) hv.1)]
    ring
  rw [hfactor]
  ring

/-- The weighted Fourier bounds are uniform in the lattice frequency. -/
theorem kernelCuspWeightedFourier_uniform_bound :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (F : KernelQuotientL2),
      ‖kernelCuspWeightedFourier ρ h F‖ ≤ C * ‖ρ‖ * ‖F‖ := by
  let mass : ℝ :=
    (measureUnivNNReal (hyperbolicVolume.restrict (cuspPeriodStrip 5 6)) : ℝ) ^
      (2 : ℝ≥0∞).toReal⁻¹
  have hmass : 0 ≤ mass := Real.rpow_nonneg (by positivity) _
  refine ⟨mass * ‖kernelCuspPullback‖, mul_nonneg hmass (norm_nonneg _), ?_⟩
  intro ρ h F
  have htest : ‖cuspWeightedFourierTestL2 ρ h‖ ≤ mass * ‖ρ‖ := by
    apply Lp.norm_le_of_ae_bound (norm_nonneg ρ)
    filter_upwards [MemLp.coeFn_toLp (cuspWeightedFourierTest_memLp ρ h)] with w hw
    change ‖cuspWeightedFourierTestL2 ρ h w‖ ≤ ‖ρ‖
    rw [cuspWeightedFourierTestL2, hw, norm_star]
    exact cuspWeightedFourierPhase_bound ρ h w
  change ‖inner ℂ (cuspWeightedFourierTestL2 ρ h) (kernelCuspPullback F)‖ ≤ _
  calc
    _ ≤ ‖cuspWeightedFourierTestL2 ρ h‖ * ‖kernelCuspPullback F‖ := norm_inner_le_norm _ _
    _ ≤ (mass * ‖ρ‖) * (‖kernelCuspPullback‖ * ‖F‖) :=
      mul_le_mul htest (kernelCuspPullback.le_opNorm F) (norm_nonneg _)
        (mul_nonneg hmass (norm_nonneg _))
    _ = _ := by ring

/-- A compact coordinate hull of any positive-height period strip. -/
def cuspIntervalHull (a b : ℝ) : Set HyperbolicSpace :=
  cuspCoordinateLift '' (Set.Icc a b ×ˢ Metric.closedBall (0 : ℂ) (∑ i, ‖periodBasis i‖))

lemma cuspIntervalHull_isCompact (a b : ℝ) (ha : 0 < a) : IsCompact (cuspIntervalHull a b) :=
  (isCompact_Icc.prod (isCompact_closedBall _ _)).image_of_continuousOn
    (fun q hq => (cuspCoordinateLift_continuousAt q (ha.trans_le hq.1.1)).continuousWithinAt)

lemma cuspPeriodStrip_subset_intervalHull (a b : ℝ) :
    cuspPeriodStrip a b ⊆ cuspIntervalHull a b := by
  intro w hw
  obtain ⟨z, v, hv, rfl⟩ := upperPoint_surjective w
  have hz : z ∈ periodDomain := by simpa only [hyperbolicHorizontal_upperPoint] using hw.1
  have hvab : v ∈ Set.Icc a b := by simpa only [hyperbolicHeight_upperPoint] using hw.2
  refine ⟨(v, z), ⟨hvab, ?_⟩, cuspCoordinateLift_positive v z hv⟩
  simpa only [Metric.mem_closedBall, dist_zero_right] using norm_mem_periodDomain z hz

lemma kernelCuspInterval_projection_bound (a b : ℝ) (ha : 0 < a) :
    Measure.map (integralOrbitProjection globalKubotaKernel)
      (hyperbolicVolume.restrict (cuspPeriodStrip a b)) ≤
        (kernelCompactMultiplicity (cuspIntervalHull a b) (cuspIntervalHull_isCompact a b ha) : ℝ≥0∞) •
          integralQuotientVolume globalKubotaKernel := by
  apply le_trans _ (kernelCompactMultiplicity_spec _ (cuspIntervalHull_isCompact a b ha))
  apply Measure.map_mono _ (measurable_integralOrbitProjection _)
  apply Measure.le_iff.mpr
  intro S hS
  rw [Measure.restrict_apply hS, Measure.restrict_apply hS]
  exact measure_mono (fun w hw => ⟨hw.1, cuspPeriodStrip_subset_intervalHull a b hw.2⟩)

lemma kernelCuspInterval_projection_quasiMeasurePreserving (a b : ℝ) (ha : 0 < a) :
    Measure.QuasiMeasurePreserving (integralOrbitProjection globalKubotaKernel)
      (hyperbolicVolume.restrict (cuspPeriodStrip a b))
      (integralQuotientVolume globalKubotaKernel) :=
  ⟨measurable_integralOrbitProjection _,
    Measure.absolutelyContinuous_of_le_smul (kernelCuspInterval_projection_bound a b ha)⟩

lemma cuspInterval_measure_ne_top (a b : ℝ) (ha : 0 < a) :
    hyperbolicVolume (cuspPeriodStrip a b) ≠ (⊤ : ℝ≥0∞) := by
  have hb := kernelCuspInterval_projection_bound a b ha Set.univ
  rw [Measure.map_apply (measurable_integralOrbitProjection _) MeasurableSet.univ,
    Set.preimage_univ, Measure.restrict_apply_univ, Measure.smul_apply] at hb
  exact ne_top_of_le_ne_top (ENNReal.mul_ne_top (by simp) (measure_ne_top _ _)) hb

def kernelCuspIntervalPullback (a b : ℝ) (ha : 0 < a) :
    KernelQuotientL2 →L[ℂ] Lp ℂ 2 (hyperbolicVolume.restrict (cuspPeriodStrip a b)) :=
  (Lp.compMeasurePreservingₗᵢ ℂ (integralOrbitProjection globalKubotaKernel)
    ⟨measurable_integralOrbitProjection _, rfl⟩).toContinuousLinearMap.comp
      (dominatedComplexL2 (by simp) (kernelCuspInterval_projection_bound a b ha))

lemma kernelCuspIntervalPullback_ae (a b : ℝ) (ha : 0 < a) (F : KernelQuotientL2) :
    kernelCuspIntervalPullback a b ha F =ᵐ[hyperbolicVolume.restrict (cuspPeriodStrip a b)]
      fun w => F (integralOrbitProjection globalKubotaKernel w) := by
  have hm : MeasurePreserving (integralOrbitProjection globalKubotaKernel)
      (hyperbolicVolume.restrict (cuspPeriodStrip a b))
      (Measure.map (integralOrbitProjection globalKubotaKernel)
        (hyperbolicVolume.restrict (cuspPeriodStrip a b))) :=
    ⟨measurable_integralOrbitProjection _, rfl⟩
  exact (Lp.coeFn_compMeasurePreserving _ hm).trans
    (hm.quasiMeasurePreserving.ae_eq_comp
      (dominatedComplexL2_ae (by simp) (kernelCuspInterval_projection_bound a b ha) F))

def kernelCuspIntervalCompact (a b : ℝ) : Set KernelQuotient :=
  integralOrbitProjection globalKubotaKernel '' cuspIntervalHull a b

lemma kernelCuspIntervalCompact_isCompact (a b : ℝ) (ha : 0 < a) :
    IsCompact (kernelCuspIntervalCompact a b) :=
  (cuspIntervalHull_isCompact a b ha).image (continuous_integralOrbitProjection _)

lemma cuspIntervalWeightedFourier_memLp (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) :
    MemLp (fun w => star (cuspWeightedFourierPhase ρ h w)) 2
      (hyperbolicVolume.restrict (cuspPeriodStrip a b)) := by
  letI : IsFiniteMeasure (hyperbolicVolume.restrict (cuspPeriodStrip a b)) :=
    isFiniteMeasure_restrict.mpr (cuspInterval_measure_ne_top a b ha)
  apply MemLp.of_bound (cuspWeightedFourierPhase_continuous ρ h).star.aestronglyMeasurable ‖ρ‖
  exact Eventually.of_forall (fun w => by rw [norm_star]; exact cuspWeightedFourierPhase_bound ρ h w)

/-- Fourier pairing on any compact positive height interval; bounded
multiplicity replaces the injective high-cusp chart. -/
def kernelCuspIntervalFourier (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) : KernelQuotientL2 →L[ℂ] ℂ :=
  (innerSL ℂ ((cuspIntervalWeightedFourier_memLp a b ha ρ h).toLp
    (fun w => star (cuspWeightedFourierPhase ρ h w)))).comp (kernelCuspIntervalPullback a b ha)

lemma kernelCuspIntervalFourier_integral (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (F : KernelQuotientL2) :
    kernelCuspIntervalFourier a b ha ρ h F = ∫ w in cuspPeriodStrip a b,
      F (integralOrbitProjection globalKubotaKernel w) * cuspWeightedFourierPhase ρ h w ∂hyperbolicVolume := by
  change inner ℂ _ (kernelCuspIntervalPullback a b ha F) = _
  rw [L2.inner_def]
  apply integral_congr_ae
  filter_upwards [MemLp.coeFn_toLp (cuspIntervalWeightedFourier_memLp a b ha ρ h),
    kernelCuspIntervalPullback_ae a b ha F] with w hw hp
  rw [RCLike.inner_apply, hw, hp]
  simp only [starRingEnd_apply, star_star]

lemma kernelCuspIntervalFourier_restrict (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (F : KernelQuotientL2) :
    kernelCuspIntervalFourier a b ha ρ h
      (kernelMassRestrictionCLM (kernelCuspIntervalCompact a b)
        (kernelCuspIntervalCompact_isCompact a b ha).measurableSet F) =
      kernelCuspIntervalFourier a b ha ρ h F := by
  rw [kernelCuspIntervalFourier_integral, kernelCuspIntervalFourier_integral]
  have he := (kernelCuspInterval_projection_quasiMeasurePreserving a b ha).ae_eq_comp
    (kernelMassRestriction_coe _ (kernelCuspIntervalCompact_isCompact a b ha).measurableSet F)
  apply integral_congr_ae
  filter_upwards [he, ae_restrict_mem (cuspPeriodStrip_measurable a b)] with w hw hwm
  dsimp only [Function.comp_def] at hw
  have hm : integralOrbitProjection globalKubotaKernel w ∈ kernelCuspIntervalCompact a b :=
    Set.mem_image_of_mem _ (cuspPeriodStrip_subset_intervalHull a b hwm)
  rw [hw, Set.indicator_of_mem hm]

def kernelCuspIntervalFourierFamily (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (s : ℂ) : ℂ :=
  kernelCuspIntervalFourier a b ha ρ h
    (kernelLocalCorrectedSeed (kernelCuspIntervalCompact a b) (kernelCuspIntervalCompact_isCompact a b ha)
      2 3 (by norm_num) (by norm_num) s)

lemma kernelCuspIntervalFourierFamily_residue_limit (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) :
    Tendsto (fun s : ℂ => (s - 4 / 3) * kernelCuspIntervalFourierFamily a b ha ρ h s)
      (𝓝[≠] (4 / 3 : ℂ)) (𝓝 (kernelCuspIntervalFourier a b ha ρ h cubicEisensteinResidue)) := by
  have ht := (kernelCuspIntervalFourier a b ha ρ h).continuous.continuousAt.tendsto.comp
    (cubicEisensteinResidue_local_limit _ (kernelCuspIntervalCompact_isCompact a b ha))
  simpa only [Function.comp_def, map_smul, smul_eq_mul, kernelCuspIntervalFourier_restrict,
    kernelCuspIntervalFourierFamily] using ht

lemma kernelCuspIntervalFourierFamily_analyticAt (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (s : ℂ) (hs : 1 < s.re) (hi : 0 < s.im) :
    AnalyticAt ℂ (kernelCuspIntervalFourierFamily a b ha ρ h) s :=
  (ContinuousLinearMap.analyticAt (𝕜 := ℂ) (E := KernelQuotientL2) (F := ℂ)
    (kernelCuspIntervalFourier a b ha ρ h) _).comp_of_eq
      (kernelLocalCorrectedSeed_analyticAt_nonreal _ (kernelCuspIntervalCompact_isCompact a b ha)
        2 3 (by norm_num) (by norm_num) s hs.ne' hi.ne') rfl

lemma cuspInterval_integral_coordinates (a b : ℝ) (ha : 0 < a) (g : HyperbolicSpace → ℂ)
    (hg : AEStronglyMeasurable g hyperbolicVolume)
    (hint : IntegrableOn (fun q : ℝ × ℂ => g (cuspCoordinateLift q) / (q.1 : ℂ) ^ 3)
      (Set.Icc a b ×ˢ periodDomain) volume) :
    (∫ w in cuspPeriodStrip a b, g w ∂hyperbolicVolume) =
      ∫ v in Set.Icc a b, (∫ z in periodDomain, g (cuspCoordinateLift (v, z))) / (v : ℂ) ^ 3 := by
  let S := spatialComplexSplit ⁻¹' (Set.Icc a b ×ˢ periodDomain)
  have hS : MeasurableSet S := spatialComplexSplit.measurable
    (measurableSet_Icc.prod periodDomain_measurable)
  have hpos : S ⊆ euclideanUpperHalf := fun p hp => ha.trans_le hp.1.1
  have hpre : hyperbolicEuclideanCoordinates ⁻¹' S = cuspPeriodStrip a b := by
    ext w
    change spatialComplexSplit (hyperbolicEuclideanCoordinates w) ∈ (Set.Icc a b ×ˢ periodDomain) ↔ _
    rw [spatialComplexSplit_coordinates]
    exact and_comm
  have hm := euclideanToHyperbolic_measurePreserving_on S hS
  rw [hpre] at hm
  have hh := hg.mono_measure (Measure.restrict_le_self (s := cuspPeriodStrip a b))
  have he : (∫ w in cuspPeriodStrip a b, g w ∂hyperbolicVolume) =
      ∫ p in S, g (euclideanToHyperbolic p) ∂hyperbolicEuclideanVolume := by
    rw [← hm.map_eq] at hh ⊢
    exact integral_map hm.measurable.aemeasurable hh
  rw [he, hyperbolicEuclidean_setIntegral_complex S hS hpos]
  have hsplit := spatialComplexSplit.measurableEmbedding.setIntegral_map
    (fun q : ℝ × ℂ => g (cuspCoordinateLift q) / (q.1 : ℂ) ^ 3)
    (Set.Icc a b ×ˢ periodDomain) («μ» := (volume : Measure EuclideanSpatial))
  rw [spatialComplexSplit_preserves_volume.map_eq] at hsplit
  have heq : (∫ p in S, g (euclideanToHyperbolic p) / (p 2 : ℂ) ^ 3) =
      ∫ q in Set.Icc a b ×ˢ periodDomain, g (cuspCoordinateLift q) / (q.1 : ℂ) ^ 3 := by
    rw [hsplit]
    simp only [S, cuspCoordinateLift, spatialComplexSplit.symm_apply_apply, spatialComplexSplit_fst]
  rw [heq]
  change (∫ q in Set.Icc a b ×ˢ periodDomain,
    g (cuspCoordinateLift q) / (q.1 : ℂ) ^ 3 ∂((volume : Measure ℝ).prod volume)) = _
  rw [setIntegral_prod _ hint]
  congr 1
  ext v
  exact integral_div ((v : ℂ) ^ 3) (fun z => g (cuspCoordinateLift (v, z)))

lemma cuspInterval_continuous_integrable (a b : ℝ) (ha : 0 < a)
    (g : HyperbolicSpace → ℂ) (hg : Continuous g) :
    IntegrableOn (fun q : ℝ × ℂ => g (cuspCoordinateLift q) / (q.1 : ℂ) ^ 3)
      (Set.Icc a b ×ˢ periodDomain) volume := by
  have hc : ContinuousOn (fun q : ℝ × ℂ => g (cuspCoordinateLift q) / (q.1 : ℂ) ^ 3)
      (Set.Icc a b ×ˢ Metric.closedBall (0 : ℂ) (∑ i, ‖periodBasis i‖)) := by
    intro q hq
    have hpos := ha.trans_le hq.1.1
    exact ((hg.continuousAt.comp (cuspCoordinateLift_continuousAt q hpos)).div
      ((Complex.continuous_ofReal.comp continuous_fst).continuousAt.pow 3)
      (pow_ne_zero _ (Complex.ofReal_ne_zero.mpr hpos.ne'))).continuousWithinAt
  apply (hc.integrableOn_compact (isCompact_Icc.prod (isCompact_closedBall _ _))).mono_set
  intro q hq
  refine ⟨hq.1, ?_⟩
  simpa only [Metric.mem_closedBall, dist_zero_right] using norm_mem_periodDomain q.2 hq.2

lemma kernelCuspIntervalFourierFamily_initial (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (s : ℂ) (hs : 4 < s.re) (hi : 0 < s.im) :
    kernelCuspIntervalFourierFamily a b ha ρ h s = ∫ w in cuspPeriodStrip a b,
      hyperbolicEisenstein s w * cuspWeightedFourierPhase ρ h w ∂hyperbolicVolume := by
  rw [kernelCuspIntervalFourierFamily, kernelCuspIntervalFourier_integral]
  have he := (kernelCuspInterval_projection_quasiMeasurePreserving a b ha).ae_eq_comp
    (cubicEisensteinLocalFamily_initial_ae _ (kernelCuspIntervalCompact_isCompact a b ha) s hs hi)
  apply integral_congr_ae
  filter_upwards [he, ae_restrict_mem (cuspPeriodStrip_measurable a b)] with w hw hwm
  dsimp only [Function.comp_def] at hw
  have hm : integralOrbitProjection globalKubotaKernel w ∈ kernelCuspIntervalCompact a b :=
    Set.mem_image_of_mem _ (cuspPeriodStrip_subset_intervalHull a b hwm)
  rw [hw, Set.indicator_of_mem hm, kernelQuotientEisenstein_mk]

def cuspIntervalWhittakerFactor (a b : ℝ) (ρ : BoundedContinuousFunction ℝ ℂ)
    (s : ℂ) (h : O) : ℂ :=
  ∫ v in Set.Icc a b, ρ v * ((v : ℂ) ^ (-s - 1) * sourceFourierKernel s (cuspFrequency h * v))

lemma cuspIntervalWhittakerFactor_analyticAt (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (s : ℂ) (hs : 1 < s.re) :
    AnalyticAt ℂ (fun w => cuspIntervalWhittakerFactor a b ρ w h) s := by
  apply Complex.analyticAt_iff_eventually_differentiableAt.mpr
  filter_upwards [(isOpen_lt continuous_const Complex.continuous_re).mem_nhds hs] with w hw
  simpa only [cuspIntervalWhittakerFactor, mul_assoc] using
    cuspWeightedWhittakerInterval_differentiableAt ρ a b ha (cuspFrequency h) w hw

lemma kernelCuspIntervalFourierFamily_initial_factor (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (hh : h ≠ 0)
    (s : ℂ) (hs : 4 < s.re) (hi : 0 < s.im) :
    kernelCuspIntervalFourierFamily a b ha ρ h s =
      ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * scatteringCoefficient s h *
        cuspIntervalWhittakerFactor a b ρ s h := by
  rw [kernelCuspIntervalFourierFamily_initial a b ha ρ h s hs hi]
  let g : HyperbolicSpace → ℂ := fun w => hyperbolicEisenstein s w * cuspWeightedFourierPhase ρ h w
  have hg : Continuous g := (hyperbolicEisenstein_continuous s (by linarith)).mul
    (cuspWeightedFourierPhase_continuous ρ h)
  rw [cuspInterval_integral_coordinates a b ha g hg.aestronglyMeasurable
    (cuspInterval_continuous_integrable a b ha g hg)]
  have hinner (v : ℝ) (hv : 0 < v) :
      (∫ z in periodDomain, g (cuspCoordinateLift (v, z))) =
        ρ v * (eisensteinFourierCoefficient v hv s h * ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ)) := by
    simp_rw [g, cuspCoordinateLift_positive v _ hv, hyperbolicEisenstein_upperPoint,
      cuspWeightedFourierPhase, hyperbolicHeight_upperPoint, cuspFourierPhase, hyperbolicHorizontal_upperPoint]
    have he : (∫ z in periodDomain, upperEisenstein z v hv s *
        (ρ v * tracePhase (-cuspFrequency h * z))) =
        ρ v * (∫ z in periodDomain, upperEisenstein z v hv s * tracePhase (-cuspFrequency h * z)) := by
      rw [← integral_const_mul]
      apply integral_congr_ae
      exact Eventually.of_forall (fun z => by ring)
    rw [he, eisensteinFourierCoefficient]
    congr 1
    exact (div_mul_cancel₀ _ cusp_volume_ne_zero).symm
  rw [cuspIntervalWhittakerFactor, ← integral_const_mul]
  apply setIntegral_congr_fun measurableSet_Icc
  intro v hv
  dsimp only
  have hpos := ha.trans_le hv.1
  have hv0 := Complex.ofReal_ne_zero.mpr hpos.ne'
  rw [hinner v hpos, eisensteinFourierCoefficient_formula v hpos s (by linarith) h,
    if_neg hh, zero_add]
  have hp : (v : ℂ) ^ (-s - 1) = (v : ℂ) ^ (2 - s) / (v : ℂ) ^ 3 := by
    rw [show -s - 1 = (2 - s) - 3 by ring, Complex.cpow_sub _ _ hv0]
    congr 1
    exact Complex.cpow_natCast _ 3
  rw [hp]
  ring

theorem kernelCuspIntervalFourierFamily_cross_identity (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (hh : h ≠ 0) :
    Set.EqOn
      (fun s => kernelCuspIntervalFourierFamily a b ha ρ h s * cuspWhittakerHeightFactor s h)
      (fun s => kernelCuspFourierFamily h 2 3 (by norm_num) (by norm_num) s *
        cuspIntervalWhittakerFactor a b ρ s h)
      {s : ℂ | 1 < s.re ∧ 0 < s.im} := by
  have hconvex : Convex ℝ {s : ℂ | 1 < s.re ∧ 0 < s.im} :=
    ((convex_Ioi (1 : ℝ)).linear_preimage Complex.reCLM.toLinearMap).inter
      ((convex_Ioi (0 : ℝ)).linear_preimage Complex.imCLM.toLinearMap)
  have hl : AnalyticOnNhd ℂ
      (fun s => kernelCuspIntervalFourierFamily a b ha ρ h s * cuspWhittakerHeightFactor s h)
      {s : ℂ | 1 < s.re ∧ 0 < s.im} := fun s hs =>
    (kernelCuspIntervalFourierFamily_analyticAt a b ha ρ h s hs.1 hs.2).mul
      (cuspWhittakerHeightFactor_analyticAt h s hs.1)
  have hr : AnalyticOnNhd ℂ
      (fun s => kernelCuspFourierFamily h 2 3 (by norm_num) (by norm_num) s *
        cuspIntervalWhittakerFactor a b ρ s h)
      {s : ℂ | 1 < s.re ∧ 0 < s.im} := fun s hs =>
    (kernelCuspFourierFamily_analyticAt_nonreal h 2 3 (by norm_num) (by norm_num)
      s hs.1.ne' hs.2.ne').mul (cuspIntervalWhittakerFactor_analyticAt a b ha ρ h s hs.1)
  apply hl.eqOn_of_preconnected_of_eventuallyEq hr hconvex.isPreconnected
    (show (5 + Complex.I : ℂ) ∈ {s : ℂ | 1 < s.re ∧ 0 < s.im} by norm_num)
  have hopen : IsOpen {s : ℂ | 4 < s.re ∧ 0 < s.im} :=
    (isOpen_lt continuous_const Complex.continuous_re).inter
      (isOpen_lt continuous_const Complex.continuous_im)
  filter_upwards [hopen.mem_nhds (by norm_num : (5 + Complex.I : ℂ) ∈
    {s : ℂ | 4 < s.re ∧ 0 < s.im})] with s hs
  rw [kernelCuspIntervalFourierFamily_initial_factor a b ha ρ h hh s hs.1 hs.2,
    cubicEisensteinFourierFamily_initial h hh s hs.1 hs.2]
  ring

/-- The same arithmetic residue controls Fourier tests at every positive
height, including strips where the quotient projection is not injective. -/
theorem kernelCuspIntervalFourier_residue (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (hh : h ≠ 0) :
    kernelCuspIntervalFourier a b ha ρ h cubicEisensteinResidue =
      ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * nonzeroScatteringResidue h *
        cuspIntervalWhittakerFactor a b ρ (4 / 3) h := by
  have hbase := (cuspWhittakerHeightFactor_analyticAt h (4 / 3) (by norm_num)).continuousAt.tendsto.mono_left
    (show 𝓝[≠] (4 / 3 : ℂ) ≤ 𝓝 (4 / 3 : ℂ) from nhdsWithin_le_nhds)
  have hweight := (cuspIntervalWhittakerFactor_analyticAt a b ha ρ h (4 / 3)
    (by norm_num)).continuousAt.tendsto.mono_left
      (show 𝓝[≠] (4 / 3 : ℂ) ≤ 𝓝 (4 / 3 : ℂ) from nhdsWithin_le_nhds)
  have hl := ((kernelCuspIntervalFourierFamily_residue_limit a b ha ρ h).mul hbase).comp
    thetaApproach_tendsto_complex_punctured
  have hr := ((kernelCuspFourierFamily_residue_limit h 2 3 (by norm_num) (by norm_num)).mul
    hweight).comp thetaApproach_tendsto_complex_punctured
  have hevent :
      (fun t : ℝ =>
        (((4 / 3 : ℂ) + t + t * Complex.I - 4 / 3) *
          kernelCuspIntervalFourierFamily a b ha ρ h ((4 / 3 : ℂ) + t + t * Complex.I)) *
            cuspWhittakerHeightFactor ((4 / 3 : ℂ) + t + t * Complex.I) h)
        =ᶠ[𝓝[>] (0 : ℝ)]
      (fun t : ℝ =>
        (((4 / 3 : ℂ) + t + t * Complex.I - 4 / 3) *
          kernelCuspFourierFamily h 2 3 (by norm_num) (by norm_num)
            ((4 / 3 : ℂ) + t + t * Complex.I)) *
              cuspIntervalWhittakerFactor a b ρ ((4 / 3 : ℂ) + t + t * Complex.I) h) := by
    filter_upwards [self_mem_nhdsWithin] with t ht
    change 0 < t at ht
    have hs : (4 / 3 : ℂ) + t + t * Complex.I ∈ {s : ℂ | 1 < s.re ∧ 0 < s.im} := by
      constructor
      · norm_num
        linarith
      · simpa using ht
    simpa only [mul_assoc] using congrArg
      (fun z : ℂ => ((4 / 3 : ℂ) + t + t * Complex.I - 4 / 3) * z)
      (kernelCuspIntervalFourierFamily_cross_identity a b ha ρ h hh hs)
  have heq : kernelCuspIntervalFourier a b ha ρ h cubicEisensteinResidue *
      cuspWhittakerHeightFactor (4 / 3) h =
        kernelCuspFourier h cubicEisensteinResidue *
          cuspIntervalWhittakerFactor a b ρ (4 / 3) h :=
    tendsto_nhds_unique_of_eventuallyEq hl hr hevent
  apply mul_right_cancel₀ (cuspWhittakerHeightFactor_center_ne_zero h)
  rw [heq, nonzeroScatteringResidue]
  field_simp [cusp_volume_ne_zero, cuspWhittakerHeightFactor_center_ne_zero h]

theorem kernelCuspIntervalFourier_residue_bessel (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (hh : h ≠ 0) :
    kernelCuspIntervalFourier a b ha ρ h cubicEisensteinResidue =
      ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * cubicResidualFourierCoefficient h *
        (∫ v in Set.Icc a b,
          ρ v * (schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) / (v : ℂ) ^ 2)) := by
  rw [kernelCuspIntervalFourier_residue a b ha ρ h hh, cuspIntervalWhittakerFactor,
    cubicResidualFourierCoefficient]
  have hfactor :
      (∫ v in Set.Icc a b,
        ρ v * ((v : ℂ) ^ (-(4 / 3 : ℂ) - 1) * sourceFourierKernel (4 / 3) (cuspFrequency h * v))) =
      ((2 * Real.pi : ℂ) / Complex.Gamma (4 / 3) *
        (2 * Real.pi * ‖cuspFrequency h‖ : ℂ) ^ (1 / 3 : ℂ)) *
          (∫ v in Set.Icc a b,
            ρ v * (schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) / (v : ℂ) ^ 2)) := by
    rw [← integral_const_mul]
    apply setIntegral_congr_fun measurableSet_Icc
    intro v hv
    dsimp only
    rw [sourceFourierKernel_residual_height h hh v (ha.trans_le hv.1)]
    ring
  rw [hfactor]
  ring

theorem kernelCuspIntervalFourier_uniform_bound (a b : ℝ) (ha : 0 < a) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (F : KernelQuotientL2),
      ‖kernelCuspIntervalFourier a b ha ρ h F‖ ≤ C * ‖ρ‖ * ‖F‖ := by
  letI : IsFiniteMeasure (hyperbolicVolume.restrict (cuspPeriodStrip a b)) :=
    isFiniteMeasure_restrict.mpr (cuspInterval_measure_ne_top a b ha)
  let mass : ℝ :=
    (measureUnivNNReal (hyperbolicVolume.restrict (cuspPeriodStrip a b)) : ℝ) ^
      (2 : ℝ≥0∞).toReal⁻¹
  have hmass : 0 ≤ mass := Real.rpow_nonneg (by positivity) _
  refine ⟨mass * ‖kernelCuspIntervalPullback a b ha‖, mul_nonneg hmass (norm_nonneg _), ?_⟩
  intro ρ h F
  have htest : ‖(cuspIntervalWeightedFourier_memLp a b ha ρ h).toLp
      (fun w => star (cuspWeightedFourierPhase ρ h w))‖ ≤ mass * ‖ρ‖ := by
    apply Lp.norm_le_of_ae_bound (norm_nonneg ρ)
    filter_upwards [MemLp.coeFn_toLp (cuspIntervalWeightedFourier_memLp a b ha ρ h)] with w hw
    rw [hw, norm_star]
    exact cuspWeightedFourierPhase_bound ρ h w
  change ‖inner ℂ _ (kernelCuspIntervalPullback a b ha F)‖ ≤ _
  calc
    _ ≤ ‖(cuspIntervalWeightedFourier_memLp a b ha ρ h).toLp _‖ *
        ‖kernelCuspIntervalPullback a b ha F‖ := norm_inner_le_norm _ _
    _ ≤ (mass * ‖ρ‖) * (‖kernelCuspIntervalPullback a b ha‖ * ‖F‖) :=
      mul_le_mul htest ((kernelCuspIntervalPullback a b ha).le_opNorm F) (norm_nonneg _)
        (mul_nonneg hmass (norm_nonneg _))
    _ = _ := by ring

lemma cubicResidualFourierCoefficient_interval_bound (a b : ℝ) (ha : 0 < a) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖cubicResidualFourierCoefficient h‖ *
        ‖∫ v in Set.Icc a b,
          schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) / (v : ℂ) ^ 2‖ ≤ C := by
  obtain ⟨C, hC, hbound⟩ := kernelCuspIntervalFourier_uniform_bound a b ha
  let area : ℂ := ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ)
  have harea : 0 < ‖area‖ := norm_pos_iff.mpr cusp_volume_ne_zero
  refine ⟨C * ‖BoundedContinuousFunction.const ℝ (1 : ℂ)‖ *
    ‖cubicEisensteinResidue‖ / ‖area‖, by positivity, ?_⟩
  intro h hh
  have hb := hbound (BoundedContinuousFunction.const ℝ (1 : ℂ)) h cubicEisensteinResidue
  rw [kernelCuspIntervalFourier_residue_bessel a b ha _ h hh] at hb
  simp only [BoundedContinuousFunction.const_apply, one_mul, norm_mul] at hb
  apply (le_div_iff₀ harea).mpr
  calc
    _ = ‖area‖ * ‖cubicResidualFourierCoefficient h‖ *
        ‖∫ v in Set.Icc a b,
          schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) / (v : ℂ) ^ 2‖ := by ring
    _ ≤ _ := hb

def cubicSchlafliDensity (x t : ℝ) : ℝ :=
  t ^ (-(2 : ℝ) / 3) * Real.exp (-t - x ^ 2 / (4 * t))

lemma cubicSchlafliDensity_eq (x t : ℝ) (ht : 0 < t) :
    ((t : ℂ) ^ ((1 / 3 : ℂ) - 1) *
      Complex.exp (-(t : ℂ) - (x : ℂ) ^ 2 / (4 * t))).re = cubicSchlafliDensity x t := by
  have he := congrArg Complex.re (schlafliIntegrand_real (1 / 3) x t ht)
  norm_num only [Complex.ofReal_div, Complex.ofReal_one, Complex.ofReal_ofNat,
    Complex.ofReal_re] at he
  convert he using 1 <;> norm_num [cubicSchlafliDensity]

lemma cubicSchlafliDensity_integrable (x : ℝ) :
    IntegrableOn (cubicSchlafliDensity x) (Set.Ioi 0) := by
  apply (schlafliIntegral_integrable (1 / 3) x (by norm_num)).re.congr
  filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
  exact cubicSchlafliDensity_eq x t ht

lemma cubicSchlafliIntegral_re (x : ℝ) :
    (schlafliIntegral (1 / 3) x).re = ∫ t in Set.Ioi 0, cubicSchlafliDensity x t := by
  unfold schlafliIntegral
  have hre := integral_re (schlafliIntegral_integrable (1 / 3) x (by norm_num))
  change (∫ t : ℝ in Set.Ioi 0, ((t : ℂ) ^ ((1 / 3 : ℂ) - 1) *
    Complex.exp (-(t : ℂ) - (x : ℂ) ^ 2 / (4 * t))).re) =
    (∫ t : ℝ in Set.Ioi 0, (t : ℂ) ^ ((1 / 3 : ℂ) - 1) *
      Complex.exp (-(t : ℂ) - (x : ℂ) ^ 2 / (4 * t))).re at hre
  rw [← hre]
  apply integral_congr_ae
  filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
  exact cubicSchlafliDensity_eq x t ht

lemma schlafliBesselK_one_third_re (x : ℝ) (hx : 0 < x) :
    (schlafliBesselK (1 / 3) x).re =
      (1 / 2 : ℝ) * (x / 2) ^ (-(1 : ℝ) / 3) *
        ∫ t in Set.Ioi 0, cubicSchlafliDensity x t := by
  have hp := (Complex.ofReal_cpow (show 0 ≤ x / 2 by positivity) (-(1 : ℝ) / 3)).symm
  push_cast at hp
  simp only [neg_div] at hp
  rw [schlafliBesselK, hp]
  simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, mul_zero, sub_zero]
  rw [cubicSchlafliIntegral_re]
  norm_num

/-- A positive interval of the Schläfli integral gives an exponential lower
bound with a constant independent of its argument. -/
theorem schlafliBesselK_one_third_exp_lower :
    ∃ c : ℝ, 0 < c ∧ ∀ x : ℝ, 0 < x →
      c * Real.exp (-9 * x / 4) ≤ (schlafliBesselK (1 / 3) x).re := by
  let c : ℝ := (1 / 2) * (1 / 2 : ℝ) ^ (-(1 : ℝ) / 3) * (2 : ℝ) ^ (-(2 : ℝ) / 3)
  refine ⟨c, by dsimp [c]; positivity, ?_⟩
  intro x hx
  have hsub : Set.Icc x (2 * x) ⊆ Set.Ioi 0 := fun t ht => hx.trans_le ht.1
  have hi := cubicSchlafliDensity_integrable x
  have hlower (t : ℝ) (ht : t ∈ Set.Icc x (2 * x)) :
      (2 * x) ^ (-(2 : ℝ) / 3) * Real.exp (-9 * x / 4) ≤ cubicSchlafliDensity x t := by
    have ht0 := hx.trans_le ht.1
    have hp := Real.rpow_le_rpow_of_nonpos ht0 ht.2 (by norm_num : -(2 : ℝ) / 3 ≤ 0)
    have hfrac : x ^ 2 / (4 * t) ≤ x / 4 :=
      (div_le_iff₀ (by positivity : 0 < 4 * t)).mpr
        (by nlinarith only [mul_nonneg hx.le (sub_nonneg.mpr ht.1)])
    exact mul_le_mul hp (Real.exp_le_exp.mpr (by linarith [ht.2]))
      (Real.exp_pos _).le (Real.rpow_nonneg ht0.le _)
  have hmono := setIntegral_mono_on
    (integrableOn_const (hs := isCompact_Icc.measure_ne_top) :
      IntegrableOn (fun _ : ℝ => (2 * x) ^ (-(2 : ℝ) / 3) * Real.exp (-9 * x / 4))
        (Set.Icc x (2 * x)))
    (hi.mono_set hsub) measurableSet_Icc hlower
  have hextend : (∫ t in Set.Icc x (2 * x), cubicSchlafliDensity x t) ≤
      ∫ t in Set.Ioi 0, cubicSchlafliDensity x t := by
    apply setIntegral_mono_set hi
    · filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
      exact mul_nonneg (Real.rpow_nonneg ht.le _) (Real.exp_pos _).le
    · exact Eventually.of_forall hsub
  rw [setIntegral_const, Real.volume_real_Icc_of_le (by linarith), smul_eq_mul,
    show 2 * x - x = x by ring] at hmono
  have hscaled := mul_le_mul_of_nonneg_left (hmono.trans hextend)
    (show 0 ≤ (1 / 2 : ℝ) * (x / 2) ^ (-(1 : ℝ) / 3) by positivity)
  rw [← schlafliBesselK_one_third_re x hx] at hscaled
  have hhalf : (x / 2) ^ (-(1 : ℝ) / 3) = (1 / 2 : ℝ) ^ (-(1 : ℝ) / 3) * x ^ (-(1 : ℝ) / 3) := by
    rw [show x / 2 = (1 / 2) * x by ring, Real.mul_rpow (by norm_num) hx.le]
  have htwo : (2 * x) ^ (-(2 : ℝ) / 3) = (2 : ℝ) ^ (-(2 : ℝ) / 3) * x ^ (-(2 : ℝ) / 3) :=
    Real.mul_rpow (by norm_num) hx.le
  have hpower : x ^ (-(1 : ℝ) / 3) * x * x ^ (-(2 : ℝ) / 3) = 1 := by
    calc
      _ = x ^ (-(1 : ℝ) / 3) * x ^ (1 : ℝ) * x ^ (-(2 : ℝ) / 3) := by rw [Real.rpow_one]
      _ = x ^ ((-(1 : ℝ) / 3 + 1) + (-(2 : ℝ) / 3)) := by
        rw [← Real.rpow_add hx, ← Real.rpow_add hx]
      _ = 1 := by norm_num
  have hnormalize : (1 / 2 : ℝ) * (x / 2) ^ (-(1 : ℝ) / 3) *
      (x * ((2 * x) ^ (-(2 : ℝ) / 3) * Real.exp (-9 * x / 4))) = c * Real.exp (-9 * x / 4) := by
    rw [hhalf, htwo]
    calc
      _ = c * (x ^ (-(1 : ℝ) / 3) * x * x ^ (-(2 : ℝ) / 3)) * Real.exp (-9 * x / 4) := by
        dsimp [c]
        ring
      _ = _ := by rw [hpower, mul_one]
  rwa [hnormalize] at hscaled

lemma cubicResidualBesselDensity_integrable (a b : ℝ) (ha : 0 < a) (h : O) (hh : h ≠ 0) :
    IntegrableOn (fun v : ℝ =>
      schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) / (v : ℂ) ^ 2)
      (Set.Icc a b) := by
  let B : ℂ := (2 * Real.pi : ℂ) / Complex.Gamma (4 / 3) *
    (2 * Real.pi * ‖cuspFrequency h‖ : ℂ) ^ (1 / 3 : ℂ)
  have hB : B ≠ 0 := by
    apply mul_ne_zero
    · exact div_ne_zero (mul_ne_zero (by norm_num) (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero))
        (Complex.Gamma_ne_zero_of_re_pos (by norm_num))
    · apply Complex.cpow_ne_zero_iff.mpr
      exact Or.inl (mul_ne_zero
        (mul_ne_zero (by norm_num) (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero))
        (Complex.ofReal_ne_zero.mpr (norm_ne_zero_iff.mpr (cuspFrequency_ne_zero h hh))))
  have hsource : IntegrableOn (fun v : ℝ => (v : ℂ) ^ (-(4 / 3 : ℂ) - 1) *
      sourceFourierKernel (4 / 3) (cuspFrequency h * v)) (Set.Icc a b) := by
    apply ContinuousOn.integrableOn_Icc
    intro v hv
    have hpos := ha.trans_le hv.1
    exact ((Complex.continuousAt_ofReal_cpow_const v (-(4 / 3 : ℂ) - 1) (Or.inr hpos.ne')).mul
      ((sourceFourierKernel_continuous_freq (4 / 3) (by norm_num)).continuousAt.comp
        ((Complex.continuous_ofReal.const_mul (cuspFrequency h)).continuousAt))).continuousWithinAt
  apply (hsource.div_const B).congr
  filter_upwards [ae_restrict_mem measurableSet_Icc] with v hv
  apply (div_eq_iff hB).mpr
  simpa only [B, mul_comm] using sourceFourierKernel_residual_height h hh v (ha.trans_le hv.1)

/-- Bounds on every positive height interval force subexponential coefficient growth. -/
theorem cubicBesselCoefficient_subexponential (coeff : O → ℂ)
    (hinterval : ∀ a b : ℝ, 0 < a → ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖coeff h‖ * ‖∫ v in Set.Icc a b,
        schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) / (v : ℂ) ^ 2‖ ≤ C)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖coeff h‖ ≤ C * Real.exp (ε * ‖cuspFrequency h‖) := by
  obtain ⟨c, hc, hK⟩ := schlafliBesselK_one_third_exp_lower
  let b : ℝ := ε / (9 * Real.pi)
  let a : ℝ := b / 2
  have hb : 0 < b := div_pos hε (by positivity)
  have ha : 0 < a := half_pos hb
  have hab : a < b := by dsimp [a]; linarith
  obtain ⟨C, hC, hbound⟩ := hinterval a b ha
  let D : ℝ := (b - a) * c / b ^ 2
  have hD : 0 < D := div_pos (mul_pos (sub_pos.mpr hab) hc) (sq_pos_of_pos hb)
  refine ⟨C / D, div_nonneg hC hD.le, ?_⟩
  intro h hh
  have hr : 0 < ‖cuspFrequency h‖ := norm_pos_iff.mpr (cuspFrequency_ne_zero h hh)
  have hi := cubicResidualBesselDensity_integrable a b ha h hh
  let L : ℝ := c * Real.exp (-(ε * ‖cuspFrequency h‖)) / b ^ 2
  have hpoint (v : ℝ) (hv : v ∈ Set.Icc a b) :
      L ≤ (schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) / (v : ℂ) ^ 2).re := by
    have hvp := ha.trans_le hv.1
    have hscale : 9 * Real.pi * b = ε := by dsimp [b]; field_simp
    have hexponent : -(ε * ‖cuspFrequency h‖) ≤ -9 * (4 * Real.pi * ‖cuspFrequency h‖ * v) / 4 := by
      have hm := mul_le_mul_of_nonneg_left hv.2 (show 0 ≤ 9 * Real.pi * ‖cuspFrequency h‖ by positivity)
      nlinarith only [hm, congrArg (fun z : ℝ => z * ‖cuspFrequency h‖) hscale]
    have hnum := (mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr hexponent) hc.le).trans
      (hK (4 * Real.pi * ‖cuspFrequency h‖ * v) (by positivity))
    rw [← Complex.ofReal_pow, Complex.div_ofReal_re]
    exact (div_le_div_of_nonneg_left (by positivity) (sq_pos_of_pos hvp)
      ((sq_le_sq₀ hvp.le hb.le).mpr hv.2)).trans
        (div_le_div_of_nonneg_right hnum (sq_nonneg v))
  have hire : IntegrableOn (fun v : ℝ =>
      (schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) / (v : ℂ) ^ 2).re)
      (Set.Icc a b) := hi.re
  have hre := integral_re hi
  change (∫ v in Set.Icc a b,
    (schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) / (v : ℂ) ^ 2).re) =
    (∫ v in Set.Icc a b,
      schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) / (v : ℂ) ^ 2).re at hre
  have hmono := setIntegral_mono_on
    (integrableOn_const (hs := isCompact_Icc.measure_ne_top) :
      IntegrableOn (fun _ : ℝ => L) (Set.Icc a b)) hire measurableSet_Icc hpoint
  rw [setIntegral_const, Real.volume_real_Icc_of_le hab.le, smul_eq_mul, hre] at hmono
  have hlow : D * Real.exp (-(ε * ‖cuspFrequency h‖)) ≤
      ‖∫ v in Set.Icc a b,
        schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) / (v : ℂ) ^ 2‖ := by
    calc
      D * Real.exp (-(ε * ‖cuspFrequency h‖)) = (b - a) * L := by dsimp only [D, L]; ring
      _ ≤ (∫ v in Set.Icc a b,
          schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) / (v : ℂ) ^ 2).re := hmono
      _ ≤ _ := Complex.re_le_norm _
  have hmul := (mul_le_mul_of_nonneg_left hlow (norm_nonneg (coeff h))).trans
    (hbound h hh)
  calc
    _ ≤ C / (D * Real.exp (-(ε * ‖cuspFrequency h‖))) :=
      (le_div_iff₀ (mul_pos hD (Real.exp_pos _))).mpr hmul
    _ = (C / D) * Real.exp (ε * ‖cuspFrequency h‖) := by
      rw [Real.exp_neg]
      field_simp

/-- Arbitrarily low compact cusp strips force subexponential growth of the actual scattering residues. -/
theorem cubicResidualFourierCoefficient_subexponential (ε : ℝ) (hε : 0 < ε) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖cubicResidualFourierCoefficient h‖ ≤ C * Real.exp (ε * ‖cuspFrequency h‖) :=
  cubicBesselCoefficient_subexponential cubicResidualFourierCoefficient
    cubicResidualFourierCoefficient_interval_bound ε hε


lemma cubicSchlafliIntegral_ofReal (x : ℝ) :
    schlafliIntegral (1 / 3) x = ((∫ t in Set.Ioi 0, cubicSchlafliDensity x t : ℝ) : ℂ) := by
  unfold schlafliIntegral
  calc
    _ = ∫ t in Set.Ioi (0 : ℝ), ((cubicSchlafliDensity x t : ℝ) : ℂ) := by
      apply setIntegral_congr_fun measurableSet_Ioi
      intro t ht
      have he := schlafliIntegrand_real (1 / 3) x t ht
      norm_num only [Complex.ofReal_div, Complex.ofReal_one, Complex.ofReal_ofNat] at he
      convert he using 1 <;> norm_num [cubicSchlafliDensity]
    _ = _ := integral_ofReal

lemma schlafliBesselK_one_third_norm (x : ℝ) (hx : 0 < x) :
    ‖schlafliBesselK (1 / 3) x‖ =
      (1 / 2 : ℝ) * (x / 2) ^ (-(1 : ℝ) / 3) *
        ∫ t in Set.Ioi 0, cubicSchlafliDensity x t := by
  have hp := (Complex.ofReal_cpow (show 0 ≤ x / 2 by positivity) (-(1 : ℝ) / 3)).symm
  push_cast at hp
  simp only [neg_div] at hp
  have hnonneg : 0 ≤ ∫ t in Set.Ioi 0, cubicSchlafliDensity x t := by
    apply integral_nonneg_of_ae
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    exact mul_nonneg (Real.rpow_nonneg ht.le _) (Real.exp_pos _).le
  rw [schlafliBesselK, hp, cubicSchlafliIntegral_ofReal]
  have he : (1 / 2 : ℂ) * ((x / 2) ^ (-(1 : ℝ) / 3) : ℝ) *
      ((∫ t in Set.Ioi 0, cubicSchlafliDensity x t : ℝ) : ℂ) =
      (((1 / 2 : ℝ) * (x / 2) ^ (-(1 : ℝ) / 3) *
        ∫ t in Set.Ioi 0, cubicSchlafliDensity x t : ℝ) : ℂ) := by push_cast; rfl
  simp only [neg_div] at he ⊢
  rw [he, Complex.norm_of_nonneg (mul_nonneg (by positivity) hnonneg)]

/-- The Schläfli exponential absorbs half its argument uniformly away
from zero; the remaining integrand is an integrable Gamma density. -/
theorem schlafliBesselK_one_third_exp_upper (δ : ℝ) (hδ : 0 < δ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ, δ ≤ x →
      ‖schlafliBesselK (1 / 3) x‖ ≤ C * Real.exp (-x / 2) := by
  let g : ℝ → ℝ := fun t => t ^ (-(2 : ℝ) / 3) * Real.exp (-t / 2)
  have hg : IntegrableOn g (Set.Ioi 0) := by
    have hh := integrableOn_rpow_mul_exp_neg_mul_rpow
      (s := -(2 : ℝ) / 3) (p := (1 : ℝ)) (b := (1 / 2 : ℝ))
      (by norm_num) (by norm_num) (by norm_num)
    simpa only [g, Real.rpow_one, show ∀ t : ℝ, -(1 / 2) * t = -t / 2 by intro t; ring] using hh
  have hg0 : 0 ≤ ∫ t in Set.Ioi 0, g t := by
    apply integral_nonneg_of_ae
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    exact mul_nonneg (Real.rpow_nonneg ht.le _) (Real.exp_pos _).le
  refine ⟨(1 / 2) * (δ / 2) ^ (-(1 : ℝ) / 3) * ∫ t in Set.Ioi 0, g t,
    mul_nonneg (by positivity) hg0, ?_⟩
  intro x hx
  have hxp := hδ.trans_le hx
  have hpoint (t : ℝ) (ht : 0 < t) :
      cubicSchlafliDensity x t ≤ Real.exp (-x / 2) * g t := by
    have hfrac : x / 2 - t / 2 ≤ x ^ 2 / (4 * t) :=
      (le_div_iff₀ (by positivity : 0 < 4 * t)).mpr
        (by nlinarith only [sq_nonneg (x - t), sq_nonneg t])
    calc
      _ ≤ t ^ (-(2 : ℝ) / 3) * Real.exp (-x / 2 + -t / 2) :=
        mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr (by linarith only [hfrac]))
          (Real.rpow_nonneg ht.le _)
      _ = _ := by rw [Real.exp_add]; dsimp [g]; ring
  have hb := setIntegral_mono_on (cubicSchlafliDensity_integrable x)
    (hg.const_mul (Real.exp (-x / 2))) measurableSet_Ioi hpoint
  rw [integral_const_mul] at hb
  have hp : (x / 2) ^ (-(1 : ℝ) / 3) ≤ (δ / 2) ^ (-(1 : ℝ) / 3) :=
    Real.rpow_le_rpow_of_nonpos (by positivity) (by linarith only [hx]) (by norm_num)
  rw [schlafliBesselK_one_third_norm x hxp]
  calc
    _ ≤ (1 / 2 : ℝ) * (x / 2) ^ (-(1 : ℝ) / 3) *
        (Real.exp (-x / 2) * ∫ t in Set.Ioi 0, g t) :=
      mul_le_mul_of_nonneg_left hb (by positivity)
    _ ≤ (1 / 2 : ℝ) * (δ / 2) ^ (-(1 : ℝ) / 3) *
        (Real.exp (-x / 2) * ∫ t in Set.Ioi 0, g t) :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hp (by norm_num))
        (mul_nonneg (Real.exp_pos _).le hg0)
    _ = _ := by ring

lemma exp_neg_mul_le_inverse_cube (ε r : ℝ) (hε : 0 < ε) (hr : 0 < r) :
    Real.exp (-ε * r) ≤ (6 / ε ^ 3) * r ^ (-3 : ℝ) := by
  have hp := Real.pow_div_factorial_le_exp (ε * r) (mul_pos hε hr).le 3
  norm_num only [Nat.factorial] at hp
  have hi := one_div_le_one_div_of_le (by positivity : (0 : ℝ) < (ε * r) ^ 3 / 6) hp
  rw [one_div, ← Real.exp_neg] at hi
  rw [Real.rpow_neg hr.le]
  norm_num only [Real.rpow_ofNat]
  have he : (6 / ε ^ 3) * (r ^ 3)⁻¹ = ((ε * r) ^ 3 / 6)⁻¹ := by field_simp
  rw [he]
  simpa only [neg_mul, one_div] using hi

lemma summable_exp_neg_ringComplex_norm (ε : ℝ) (hε : 0 < ε) :
    Summable (fun h : O => Real.exp (-ε * ‖ringComplex h‖)) := by
  have hs := (summable_embedding_rpow (-3) (by norm_num)).mul_left (6 / ε ^ 3)
  have hz : Summable (fun h : O => if h = 0 then (1 : ℝ) else 0) :=
    (hasSum_ite_eq 0 (1 : ℝ)).summable
  apply Summable.of_nonneg_of_le (fun h => (Real.exp_pos _).le) _ (hz.add hs)
  intro h
  by_cases hh : h = 0
  · subst h
    norm_num [Pi.add_apply]
  · simpa only [Pi.add_apply, if_neg hh, zero_add] using
      exp_neg_mul_le_inverse_cube ε ‖ringComplex h‖ hε (norm_pos_iff.mpr (ringComplex_ne_zero hh))

lemma summable_exp_neg_cuspFrequency_norm (ε : ℝ) (hε : 0 < ε) :
    Summable (fun h : O => Real.exp (-ε * ‖cuspFrequency h‖)) := by
  have hd : 0 < ‖(3 : ℂ) * ringComplex traceLambda‖ := norm_pos_iff.mpr
    (mul_ne_zero (by norm_num) (ringComplex_ne_zero traceLambda_ne_zero))
  apply (summable_exp_neg_ringComplex_norm (ε / ‖(3 : ℂ) * ringComplex traceLambda‖)
    (div_pos hε hd)).congr
  intro h
  congr 1
  rw [cuspFrequency, norm_div]
  ring

lemma cuspFrequency_norm_lower (h : O) (hh : h ≠ 0) :
    ‖(3 : ℂ) * ringComplex traceLambda‖⁻¹ ≤ ‖cuspFrequency h‖ := by
  have hn := one_le_normSq_embedding h hh
  rw [Complex.normSq_eq_norm_sq] at hn
  have hr : 1 ≤ ‖ringComplex h‖ := by nlinarith only [hn, norm_nonneg (ringComplex h)]
  rw [cuspFrequency, norm_div, inv_eq_one_div]
  exact div_le_div_of_nonneg_right hr (norm_nonneg _)

/-- The nonconstant residual Fourier mode, expressed using the native
Fourier kernel so that continuity requires no Bessel regularity theorem. -/
def cubicResidualNonzeroTerm (h : O) (p : ℝ × ℂ) : ℂ :=
  if h = 0 then 0 else nonzeroScatteringResidue h * (p.1 : ℂ) ^ (2 / 3 : ℂ) *
    sourceFourierKernel (4 / 3) (cuspFrequency h * p.1) * tracePhase (cuspFrequency h * p.2)

lemma cubicResidualNonzeroTerm_bessel (h : O) (hh : h ≠ 0) (v : ℝ) (hv : 0 < v) (z : ℂ) :
    cubicResidualNonzeroTerm h (v, z) = cubicResidualFourierCoefficient h * (v : ℂ) *
      schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) * tracePhase (cuspFrequency h * z) := by
  rw [cubicResidualNonzeroTerm, if_neg hh]
  have hv0 : (v : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hv.ne'
  have hp : (v : ℂ) ^ 3 * (v : ℂ) ^ (-(4 / 3 : ℂ) - 1) = (v : ℂ) ^ (2 / 3 : ℂ) := by
    rw [← Complex.cpow_ofNat (v : ℂ) 3, ← Complex.cpow_add _ _ hv0]
    congr 1
    ring
  calc
    _ = nonzeroScatteringResidue h * (v : ℂ) ^ 3 *
        ((v : ℂ) ^ (-(4 / 3 : ℂ) - 1) * sourceFourierKernel (4 / 3) (cuspFrequency h * v)) *
          tracePhase (cuspFrequency h * z) := by rw [← hp]; ring
    _ = _ := by
      rw [sourceFourierKernel_residual_height h hh v hv, cubicResidualFourierCoefficient]
      field_simp

lemma cubicResidualNonzeroTerm_continuousOn (h : O) :
    ContinuousOn (cubicResidualNonzeroTerm h) {p : ℝ × ℂ | 0 < p.1} := by
  unfold cubicResidualNonzeroTerm
  by_cases hh : h = 0
  · simp only [if_pos hh]
    exact continuousOn_const
  simp only [if_neg hh]
  intro p hp
  have hpow : ContinuousAt (fun q : ℝ × ℂ => (q.1 : ℂ) ^ (2 / 3 : ℂ)) p :=
    (Complex.continuousAt_ofReal_cpow_const p.1 (2 / 3 : ℂ) (Or.inr hp.ne')).comp continuousAt_fst
  have hsource : ContinuousAt (fun q : ℝ × ℂ => sourceFourierKernel (4 / 3) (cuspFrequency h * q.1)) p :=
    (sourceFourierKernel_continuous_freq (4 / 3) (by norm_num)).continuousAt.comp (by fun_prop)
  have hphase : Continuous (fun q : ℝ × ℂ => tracePhase (cuspFrequency h * q.2)) := by
    change Continuous (fun q : ℝ × ℂ => Complex.exp (2 * Real.pi * Complex.I *
      ((cuspFrequency h * q.2) + starRingEnd ℂ (cuspFrequency h * q.2))))
    fun_prop
  exact (((continuousAt_const.mul hpow).mul hsource).mul hphase.continuousAt).continuousWithinAt

/-- Subexponential residues and exponential Bessel decay leave a summable
majorant uniform in the horizontal coordinate and in compact height strips. -/
theorem cubicBesselCoefficient_strip_bound (c : O → ℂ)
    (hsub : ∀ ε : ℝ, 0 < ε → ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖c h‖ ≤ C * Real.exp (ε * ‖cuspFrequency h‖)) (a b : ℝ) (ha : 0 < a) (hab : a ≤ b) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (h : O), h ≠ 0 → ∀ v : ℝ, v ∈ Set.Icc a b →
      ‖c h * (v : ℂ) * schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v)‖ ≤ C * Real.exp (-(Real.pi * a) * ‖cuspFrequency h‖) := by
  have hb : 0 < b := ha.trans_le hab
  let δ : ℝ := 4 * Real.pi * a * ‖(3 : ℂ) * ringComplex traceLambda‖⁻¹
  have hd : 0 < ‖(3 : ℂ) * ringComplex traceLambda‖ := norm_pos_iff.mpr
    (mul_ne_zero (by norm_num) (ringComplex_ne_zero traceLambda_ne_zero))
  have hδ : 0 < δ := by dsimp [δ]; positivity
  obtain ⟨B, hB, hBessel⟩ := schlafliBesselK_one_third_exp_upper δ hδ
  obtain ⟨A, hA, hcoeff⟩ := hsub (Real.pi * a) (mul_pos Real.pi_pos ha)
  refine ⟨A * b * B, by positivity, ?_⟩
  intro h hh v hp
  have hv : 0 < v := ha.trans_le hp.1
  have hx : δ ≤ 4 * Real.pi * ‖cuspFrequency h‖ * v := by
    have hm := mul_le_mul (cuspFrequency_norm_lower h hh) hp.1 ha.le (norm_nonneg _)
    have hm' := mul_le_mul_of_nonneg_left hm (show 0 ≤ 4 * Real.pi by positivity)
    dsimp [δ]
    nlinarith only [hm']
  rw [norm_mul, norm_mul, Complex.norm_of_nonneg hv.le]
  calc
    _ ≤ (A * Real.exp ((Real.pi * a) * ‖cuspFrequency h‖)) * b *
        (B * Real.exp (-(4 * Real.pi * ‖cuspFrequency h‖ * v) / 2)) :=
      mul_le_mul (mul_le_mul (hcoeff h hh) hp.2 hv.le (by positivity))
        (hBessel _ hx) (norm_nonneg _) (by positivity)
    _ = (A * b * B) * Real.exp ((Real.pi * a) * ‖cuspFrequency h‖ +
        -(4 * Real.pi * ‖cuspFrequency h‖ * v) / 2) := by rw [Real.exp_add]; ring
    _ ≤ _ := by
      apply mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr ?_) (by positivity)
      have hm := mul_le_mul_of_nonneg_left hp.1
        (show 0 ≤ 2 * Real.pi * ‖cuspFrequency h‖ by positivity)
      nlinarith only [hm]

theorem cubicResidualNonzeroTerm_strip_bound (a b : ℝ) (ha : 0 < a) (hab : a ≤ b) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (h : O) (p : ℝ × ℂ), p.1 ∈ Set.Icc a b →
      ‖cubicResidualNonzeroTerm h p‖ ≤ C * Real.exp (-(Real.pi * a) * ‖cuspFrequency h‖) := by
  obtain ⟨C, hC, hb⟩ := cubicBesselCoefficient_strip_bound cubicResidualFourierCoefficient
    cubicResidualFourierCoefficient_subexponential a b ha hab
  refine ⟨C, hC, ?_⟩
  intro h p hp
  by_cases hh : h = 0
  · simp only [cubicResidualNonzeroTerm, if_pos hh, norm_zero]
    positivity
  rw [show p = (p.1, p.2) from rfl, cubicResidualNonzeroTerm_bessel h hh _ (ha.trans_le hp.1),
    norm_mul, tracePhase_norm, mul_one]
  exact hb h hh p.1 hp

theorem cubicResidualNonzeroTerm_summable_norm (p : ℝ × ℂ) (hp : 0 < p.1) :
    Summable (fun h : O => ‖cubicResidualNonzeroTerm h p‖) := by
  obtain ⟨C, hC, hbound⟩ := cubicResidualNonzeroTerm_strip_bound p.1 p.1 hp le_rfl
  exact Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun h => hbound h p ⟨le_rfl, le_rfl⟩)
    ((summable_exp_neg_cuspFrequency_norm (Real.pi * p.1) (mul_pos Real.pi_pos hp)).mul_left C)

def cubicResidualNonzeroSeries (p : ℝ × ℂ) : ℂ := ∑' h : O, cubicResidualNonzeroTerm h p

lemma cubicResidualNonzeroSeries_continuousOn_strip (a b : ℝ) (ha : 0 < a) (hab : a ≤ b) :
    ContinuousOn cubicResidualNonzeroSeries {p : ℝ × ℂ | p.1 ∈ Set.Icc a b} := by
  obtain ⟨C, hC, hbound⟩ := cubicResidualNonzeroTerm_strip_bound a b ha hab
  exact continuousOn_tsum
    (fun h => (cubicResidualNonzeroTerm_continuousOn h).mono (fun p hp => ha.trans_le hp.1))
    ((summable_exp_neg_cuspFrequency_norm (Real.pi * a) (mul_pos Real.pi_pos ha)).mul_left C)
    hbound

theorem cubicResidualNonzeroSeries_continuousOn :
    ContinuousOn cubicResidualNonzeroSeries {p : ℝ × ℂ | 0 < p.1} := by
  intro p hp
  change 0 < p.1 at hp
  have ha : 0 < p.1 / 2 := half_pos hp
  have hab : p.1 / 2 ≤ 2 * p.1 := by linarith only [hp]
  have hnhds : {q : ℝ × ℂ | q.1 ∈ Set.Icc (p.1 / 2) (2 * p.1)} ∈ 𝓝 p :=
    continuousAt_fst.preimage_mem_nhds (Icc_mem_nhds (by linarith only [hp]) (by linarith only [hp]))
  exact ((cubicResidualNonzeroSeries_continuousOn_strip _ _ ha hab).continuousAt hnhds).continuousWithinAt


/-- The Mellin transform of a bounded height weight on a positive compact
interval is entire; compactness bounds its logarithmic derivative. -/
def cuspIntervalMellin (a b : ℝ) (ρ : BoundedContinuousFunction ℝ ℂ) (s : ℂ) : ℂ :=
  ∫ v in Set.Icc a b, ρ v * (v : ℂ) ^ s

lemma cuspIntervalMellin_integrable (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (s : ℂ) :
    IntegrableOn (fun v : ℝ => ρ v * (v : ℂ) ^ s) (Set.Icc a b) := by
  apply ContinuousOn.integrableOn_Icc
  apply ρ.continuous.continuousOn.mul
  intro v hv
  exact (Complex.continuousAt_ofReal_cpow_const v s (Or.inr (ha.trans_le hv.1).ne')).continuousWithinAt

theorem cuspIntervalMellin_differentiable (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) : Differentiable ℂ (cuspIntervalMellin a b ρ) := by
  let L : ℝ → ℂ := fun v => (Real.log (max a v) : ℂ)
  have hL : Continuous L := Complex.continuous_ofReal.comp
    ((continuous_const.max continuous_id).log (fun v => (ha.trans_le (le_max_left a v)).ne'))
  let F : ℂ → ℝ → ℂ := fun s v => ρ v * Complex.exp (L v * s)
  let D : ℂ → ℝ → ℂ := fun s v => ρ v * (Complex.exp (L v * s) * L v)
  have hF (s : ℂ) : Continuous (F s) := ρ.continuous.mul ((hL.mul_const s).cexp)
  have hD : Continuous (fun p : ℂ × ℝ => D p.1 p.2) :=
    (ρ.continuous.comp continuous_snd).mul
      ((((hL.comp continuous_snd).mul continuous_fst).cexp).mul (hL.comp continuous_snd))
  have hder (s : ℂ) (v : ℝ) : HasDerivAt (fun w => F w v) (D s v) s := by
    simpa only [F, D, id_eq, mul_one] using
      (((hasDerivAt_id s).const_mul (L v)).cexp).const_mul (ρ v)
  have heq : cuspIntervalMellin a b ρ = fun s => ∫ v in Set.Icc a b, F s v := by
    funext s
    apply setIntegral_congr_fun measurableSet_Icc
    intro v hv
    dsimp only [cuspIntervalMellin, F, L]
    rw [max_eq_right hv.1, Complex.ofReal_log (ha.trans_le hv.1).le,
      Complex.cpow_def_of_ne_zero (Complex.ofReal_ne_zero.mpr (ha.trans_le hv.1).ne')]
  rw [heq]
  intro s
  obtain ⟨C, hC⟩ := ((isCompact_closedBall s (1 : ℝ)).prod
    (isCompact_Icc : IsCompact (Set.Icc a b))).exists_bound_of_continuousOn hD.continuousOn
  have hd := hasDerivAt_integral_of_dominated_loc_of_deriv_le
    («μ» := volume.restrict (Set.Icc a b)) (F := F) (F' := D) (bound := fun _ => C)
    (Metric.ball_mem_nhds s (by norm_num : (0 : ℝ) < 1))
    (Eventually.of_forall (fun w => (hF w).aestronglyMeasurable))
    ((hF s).continuousOn.integrableOn_Icc)
    ((hD.comp (continuous_const.prodMk continuous_id)).aestronglyMeasurable)
    (by
      filter_upwards [ae_restrict_mem measurableSet_Icc] with v hv w hw
      exact hC (w, v) ⟨Metric.ball_subset_closedBall hw, hv⟩)
    (integrable_const C) (Eventually.of_forall (fun v w _ => hder w v))
  exact hd.2.differentiableAt

lemma cuspIntervalMellin_analyticAt (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (s : ℂ) :
    AnalyticAt ℂ (cuspIntervalMellin a b ρ) s :=
  (cuspIntervalMellin_differentiable a b ha ρ).analyticAt s

lemma kernelCuspIntervalFourierFamily_zero_initial (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (s : ℂ) (hs : 4 < s.re) (hi : 0 < s.im) :
    kernelCuspIntervalFourierFamily a b ha ρ 0 s =
      ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) *
        (cuspIntervalMellin a b ρ (s - 3) +
          ((Real.pi : ℂ) / (s - 1)) * scatteringCoefficient s 0 * cuspIntervalMellin a b ρ (-s - 1)) := by
  let g : HyperbolicSpace → ℂ := fun w => hyperbolicEisenstein s w * cuspWeightedFourierPhase ρ 0 w
  have hg : Continuous g := (hyperbolicEisenstein_continuous s (by linarith)).mul
    (cuspWeightedFourierPhase_continuous ρ 0)
  rw [kernelCuspIntervalFourierFamily_initial a b ha ρ 0 s hs hi,
    cuspInterval_integral_coordinates a b ha g hg.aestronglyMeasurable
      (cuspInterval_continuous_integrable a b ha g hg)]
  have hpoint (v : ℝ) (hv : v ∈ Set.Icc a b) :
      (∫ z in periodDomain, g (cuspCoordinateLift (v, z))) / (v : ℂ) ^ 3 =
        ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) *
          (ρ v * (v : ℂ) ^ (s - 3) + (((Real.pi : ℂ) / (s - 1)) * scatteringCoefficient s 0) *
            (ρ v * (v : ℂ) ^ (-s - 1))) := by
    have hpos := ha.trans_le hv.1
    have hinner : (∫ z in periodDomain, g (cuspCoordinateLift (v, z))) =
        ρ v * (eisensteinFourierCoefficient v hpos s 0 * ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ)) := by
      simp_rw [g, cuspCoordinateLift_positive v _ hpos, hyperbolicEisenstein_upperPoint,
        cuspWeightedFourierPhase, hyperbolicHeight_upperPoint, cuspFourierPhase, hyperbolicHorizontal_upperPoint]
      have he : (∫ z in periodDomain, upperEisenstein z v hpos s * (ρ v * tracePhase (-cuspFrequency 0 * z))) =
          ρ v * ∫ z in periodDomain, upperEisenstein z v hpos s * tracePhase (-cuspFrequency 0 * z) := by
        rw [← integral_const_mul]
        apply integral_congr_ae
        exact Eventually.of_forall (fun z => by ring)
      rw [he, eisensteinFourierCoefficient]
      congr 1
      exact (div_mul_cancel₀ _ cusp_volume_ne_zero).symm
    rw [hinner, eisensteinConstantCoefficient_formula v hpos s (by linarith)]
    have hv0 : (v : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hpos.ne'
    have hout : (v : ℂ) ^ (-s - 1) = (v : ℂ) ^ (2 - s) / (v : ℂ) ^ 3 := by
      rw [show -s - 1 = (2 - s) - 3 by ring, Complex.cpow_sub _ _ hv0]
      congr 1
      exact Complex.cpow_natCast _ 3
    have hin : (v : ℂ) ^ (s - 3) = (v : ℂ) ^ s / (v : ℂ) ^ 3 := by
      rw [Complex.cpow_sub _ _ hv0]
      congr 1
      exact Complex.cpow_natCast _ 3
    rw [hout, hin]
    ring
  rw [setIntegral_congr_fun measurableSet_Icc hpoint, integral_const_mul,
    integral_add (cuspIntervalMellin_integrable a b ha ρ _)
      ((cuspIntervalMellin_integrable a b ha ρ _).const_mul _), integral_const_mul]
  rfl

/-- Subtract the entire incoming mode before comparing constant Fourier
coefficients at different heights. -/
def cuspIntervalOutgoingFamily (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (s : ℂ) : ℂ :=
  kernelCuspIntervalFourierFamily a b ha ρ 0 s -
    ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * cuspIntervalMellin a b ρ (s - 3)

lemma cuspIntervalOutgoingFamily_analyticAt (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (s : ℂ) (hs : 1 < s.re) (hi : 0 < s.im) :
    AnalyticAt ℂ (cuspIntervalOutgoingFamily a b ha ρ) s :=
  (kernelCuspIntervalFourierFamily_analyticAt a b ha ρ 0 s hs hi).sub
    (analyticAt_const.mul ((cuspIntervalMellin_analyticAt a b ha ρ _).comp_of_eq
      (analyticAt_id.sub analyticAt_const) rfl))

theorem cuspIntervalOutgoingFamily_cross_identity (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (c d : ℝ) (hc : 0 < c)
    (η : BoundedContinuousFunction ℝ ℂ) :
    Set.EqOn
      (fun s => cuspIntervalOutgoingFamily a b ha ρ s * cuspIntervalMellin c d η (-s - 1))
      (fun s => cuspIntervalOutgoingFamily c d hc η s * cuspIntervalMellin a b ρ (-s - 1))
      {s : ℂ | 1 < s.re ∧ 0 < s.im} := by
  have hconvex : Convex ℝ {s : ℂ | 1 < s.re ∧ 0 < s.im} :=
    ((convex_Ioi (1 : ℝ)).linear_preimage Complex.reCLM.toLinearMap).inter
      ((convex_Ioi (0 : ℝ)).linear_preimage Complex.imCLM.toLinearMap)
  have hl : AnalyticOnNhd ℂ
      (fun s => cuspIntervalOutgoingFamily a b ha ρ s * cuspIntervalMellin c d η (-s - 1))
      {s : ℂ | 1 < s.re ∧ 0 < s.im} := fun s hs =>
    (cuspIntervalOutgoingFamily_analyticAt a b ha ρ s hs.1 hs.2).mul
      ((cuspIntervalMellin_analyticAt c d hc η _).comp_of_eq (analyticAt_id.neg.sub analyticAt_const) rfl)
  have hr : AnalyticOnNhd ℂ
      (fun s => cuspIntervalOutgoingFamily c d hc η s * cuspIntervalMellin a b ρ (-s - 1))
      {s : ℂ | 1 < s.re ∧ 0 < s.im} := fun s hs =>
    (cuspIntervalOutgoingFamily_analyticAt c d hc η s hs.1 hs.2).mul
      ((cuspIntervalMellin_analyticAt a b ha ρ _).comp_of_eq (analyticAt_id.neg.sub analyticAt_const) rfl)
  apply hl.eqOn_of_preconnected_of_eventuallyEq hr hconvex.isPreconnected
    (show (5 + Complex.I : ℂ) ∈ {s : ℂ | 1 < s.re ∧ 0 < s.im} by norm_num)
  have hopen : IsOpen {s : ℂ | 4 < s.re ∧ 0 < s.im} :=
    (isOpen_lt continuous_const Complex.continuous_re).inter
      (isOpen_lt continuous_const Complex.continuous_im)
  filter_upwards [hopen.mem_nhds (by norm_num : (5 + Complex.I : ℂ) ∈
    {s : ℂ | 4 < s.re ∧ 0 < s.im})] with s hs
  simp only [cuspIntervalOutgoingFamily,
    kernelCuspIntervalFourierFamily_zero_initial a b ha ρ s hs.1 hs.2,
    kernelCuspIntervalFourierFamily_zero_initial c d hc η s hs.1 hs.2]
  ring

lemma cuspIntervalOutgoingFamily_residue_limit (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) :
    Tendsto (fun s : ℂ => (s - 4 / 3) * cuspIntervalOutgoingFamily a b ha ρ s)
      (𝓝[≠] (4 / 3 : ℂ)) (𝓝 (kernelCuspIntervalFourier a b ha ρ 0 cubicEisensteinResidue)) := by
  have hlin : Tendsto (fun s : ℂ => s - 4 / 3) (𝓝[≠] (4 / 3 : ℂ)) (𝓝 (0 : ℂ)) := by
    simpa only [id_eq, sub_self] using (tendsto_id.sub_const (4 / 3 : ℂ)).mono_left
      (show 𝓝[≠] (4 / 3 : ℂ) ≤ 𝓝 (4 / 3 : ℂ) from nhdsWithin_le_nhds)
  have hcont : ContinuousAt (fun s : ℂ => ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) *
      cuspIntervalMellin a b ρ (s - 3)) (4 / 3) := continuousAt_const.mul
    ((cuspIntervalMellin_differentiable a b ha ρ).continuous.continuousAt.comp (continuousAt_id.sub_const 3))
  have hz := hlin.mul (hcont.tendsto.mono_left nhdsWithin_le_nhds)
  simpa only [cuspIntervalOutgoingFamily, mul_sub, zero_mul, sub_zero] using
    (kernelCuspIntervalFourierFamily_residue_limit a b ha ρ 0).sub hz

/-- The constant residual mode is fixed by the arithmetic constant-term
residue, for every bounded height weight and every positive height strip. -/
theorem kernelCuspIntervalFourier_zero_residue (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) :
    kernelCuspIntervalFourier a b ha ρ 0 cubicEisensteinResidue =
      ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * (3 * (Real.pi : ℂ)) * constantArithmeticResidue *
        cuspIntervalMellin a b ρ (-(4 / 3 : ℂ) - 1) := by
  let η := BoundedContinuousFunction.const ℝ (1 : ℂ)
  have hmellin : cuspIntervalMellin 5 6 η (-(4 / 3 : ℂ) - 1) =
      cuspScatterHeightFactor (4 / 3) := by
    simp only [cuspIntervalMellin, η, BoundedContinuousFunction.const_apply, one_mul]
    exact cuspScatterHeightFactor_integral (4 / 3) (by norm_num)
  have havg : kernelCuspIntervalFourier 5 6 (by norm_num) η 0 cubicEisensteinResidue =
      cuspConstantAverageResidue := by
    rw [← cubicEisensteinResidue_cusp_average, kernelCuspIntervalFourier_integral,
      kernelCuspStripAverage_hyperbolic]
    simp only [cuspWeightedFourierPhase, η, BoundedContinuousFunction.const_apply,
      cuspFourierPhase, cuspFrequency, map_zero, zero_div, neg_zero, zero_mul,
      AddChar.map_zero_eq_one, mul_one]
  have hweight (c d : ℝ) (hc : 0 < c) (ξ : BoundedContinuousFunction ℝ ℂ) :
      Tendsto (fun s : ℂ => cuspIntervalMellin c d ξ (-s - 1)) (𝓝[≠] (4 / 3 : ℂ))
        (𝓝 (cuspIntervalMellin c d ξ (-(4 / 3 : ℂ) - 1))) :=
    ((cuspIntervalMellin_differentiable c d hc ξ).continuous.continuousAt.comp
      (continuousAt_id.neg.sub_const 1)).tendsto.mono_left nhdsWithin_le_nhds
  have hl := ((cuspIntervalOutgoingFamily_residue_limit a b ha ρ).mul
    (hweight 5 6 (by norm_num) η)).comp thetaApproach_tendsto_complex_punctured
  have hr := ((cuspIntervalOutgoingFamily_residue_limit 5 6 (by norm_num) η).mul
    (hweight a b ha ρ)).comp thetaApproach_tendsto_complex_punctured
  have hevent :
      (fun t : ℝ => (((4 / 3 : ℂ) + t + t * Complex.I - 4 / 3) *
        cuspIntervalOutgoingFamily a b ha ρ ((4 / 3 : ℂ) + t + t * Complex.I)) *
          cuspIntervalMellin 5 6 η (-((4 / 3 : ℂ) + t + t * Complex.I) - 1))
        =ᶠ[𝓝[>] (0 : ℝ)]
      (fun t : ℝ => (((4 / 3 : ℂ) + t + t * Complex.I - 4 / 3) *
        cuspIntervalOutgoingFamily 5 6 (by norm_num) η ((4 / 3 : ℂ) + t + t * Complex.I)) *
          cuspIntervalMellin a b ρ (-((4 / 3 : ℂ) + t + t * Complex.I) - 1)) := by
    filter_upwards [self_mem_nhdsWithin] with t ht
    change 0 < t at ht
    have hs : (4 / 3 : ℂ) + t + t * Complex.I ∈ {s : ℂ | 1 < s.re ∧ 0 < s.im} := by
      constructor
      · norm_num
        linarith
      · simpa using ht
    simpa only [mul_assoc] using congrArg
      (fun z : ℂ => ((4 / 3 : ℂ) + t + t * Complex.I - 4 / 3) * z)
      (cuspIntervalOutgoingFamily_cross_identity a b ha ρ 5 6 (by norm_num) η hs)
  have heq : kernelCuspIntervalFourier a b ha ρ 0 cubicEisensteinResidue *
      cuspIntervalMellin 5 6 η (-(4 / 3 : ℂ) - 1) =
      kernelCuspIntervalFourier 5 6 (by norm_num) η 0 cubicEisensteinResidue *
        cuspIntervalMellin a b ρ (-(4 / 3 : ℂ) - 1) :=
    tendsto_nhds_unique_of_eventuallyEq hl hr hevent
  rw [hmellin, havg] at heq
  have hne : cuspScatterHeightFactor (4 / 3 : ℂ) ≠ 0 := by
    intro he
    have hpos := cuspScatterHeightFactor_center_re_pos
    rw [he, Complex.zero_re] at hpos
    exact lt_irrefl 0 hpos
  apply mul_right_cancel₀ hne
  rw [heq, cuspConstantAverageResidue]
  ring

def cubicResidualFullModeAmplitude (v : ℝ) (h : O) : ℂ :=
  if h = 0 then (3 * (Real.pi : ℂ)) * constantArithmeticResidue * (v : ℂ) ^ (2 / 3 : ℂ)
  else cubicResidualFourierCoefficient h * (v : ℂ) *
    schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v)

lemma cubicResidualFullModeAmplitude_zero_density (v : ℝ) (hv : 0 < v) :
    cubicResidualFullModeAmplitude v 0 / (v : ℂ) ^ 3 =
      (3 * (Real.pi : ℂ)) * constantArithmeticResidue * (v : ℂ) ^ (-(4 / 3 : ℂ) - 1) := by
  have hv0 : (v : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hv.ne'
  have hp : (v : ℂ) ^ (-(4 / 3 : ℂ) - 1) = (v : ℂ) ^ (2 / 3 : ℂ) / (v : ℂ) ^ 3 := by
    rw [show -(4 / 3 : ℂ) - 1 = (2 / 3 : ℂ) - 3 by ring, Complex.cpow_sub _ _ hv0]
    congr 1
    exact Complex.cpow_natCast _ 3
  rw [cubicResidualFullModeAmplitude, if_pos rfl, hp]
  ring

lemma cubicResidualFullModeAmplitude_nonzero_density (v : ℝ) (hv : 0 < v) (h : O) (hh : h ≠ 0) :
    cubicResidualFullModeAmplitude v h / (v : ℂ) ^ 3 = cubicResidualFourierCoefficient h *
      (schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) / (v : ℂ) ^ 2) := by
  rw [cubicResidualFullModeAmplitude, if_neg hh]
  have hv0 : (v : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hv.ne'
  field_simp

theorem kernelCuspIntervalFourier_residue_full (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) :
    kernelCuspIntervalFourier a b ha ρ h cubicEisensteinResidue =
      ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) *
        ∫ v in Set.Icc a b, ρ v * (cubicResidualFullModeAmplitude v h / (v : ℂ) ^ 3) := by
  by_cases hh : h = 0
  · subst h
    rw [kernelCuspIntervalFourier_zero_residue a b ha ρ, ← mul_assoc,
      cuspIntervalMellin, ← integral_const_mul, ← integral_const_mul]
    apply setIntegral_congr_fun measurableSet_Icc
    intro v hv
    dsimp only
    rw [cubicResidualFullModeAmplitude_zero_density v (ha.trans_le hv.1)]
    ring
  · rw [kernelCuspIntervalFourier_residue_bessel a b ha ρ h hh,
      ← integral_const_mul, ← integral_const_mul]
    apply setIntegral_congr_fun measurableSet_Icc
    intro v hv
    dsimp only
    rw [cubicResidualFullModeAmplitude_nonzero_density v (ha.trans_le hv.1) h hh]
    ring


def cubicResidualNonzeroAmplitude (v : ℝ) (h : O) : ℂ :=
  if h = 0 then 0 else cubicResidualFullModeAmplitude v h

lemma cubicResidualNonzeroTerm_eq_amplitude (v : ℝ) (hv : 0 < v) (h : O) (z : ℂ) :
    cubicResidualNonzeroTerm h (v, z) = cubicResidualNonzeroAmplitude v h * tracePhase (cuspFrequency h * z) := by
  by_cases hh : h = 0
  · simp only [cubicResidualNonzeroTerm, cubicResidualNonzeroAmplitude, if_pos hh, zero_mul]
  · rw [cubicResidualNonzeroTerm_bessel h hh v hv z, cubicResidualNonzeroAmplitude,
      if_neg hh, cubicResidualFullModeAmplitude, if_neg hh]

lemma integral_cusp_character_product (h k : O) :
    (∫ z in periodDomain, tracePhase (cuspFrequency h * z) * tracePhase (-cuspFrequency k * z)) =
      if h = k then ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) else 0 := by
  have hphase (z : ℂ) : tracePhase (cuspFrequency h * z) * tracePhase (-cuspFrequency k * z) =
      tracePhase (-cuspFrequency (k - h) * z) := by
    rw [← AddChar.map_add_eq_mul]
    congr 1
    unfold cuspFrequency
    rw [map_sub]
    ring
  simp_rw [hphase]
  simpa only [sub_eq_zero, eq_comm] using integral_cusp_character (k - h)

/-- Normal convergence permits coefficient extraction term by term. -/
theorem cubicResidualNonzeroSeries_fourier (v : ℝ) (hv : 0 < v) (k : O) :
    (∫ z in periodDomain, cubicResidualNonzeroSeries (v, z) * tracePhase (-cuspFrequency k * z)) =
      ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * cubicResidualNonzeroAmplitude v k := by
  letI : Countable O := Coordinates.coordinateEquiv.injective.countable
  letI : IsFiniteMeasure (volume.restrict periodDomain) := isFiniteMeasure_restrict.mpr (by
    rw [periodDomain_volume]
    exact ENNReal.ofReal_ne_top)
  let f : O → ℂ → ℂ := fun h z => cubicResidualNonzeroAmplitude v h *
    tracePhase (cuspFrequency h * z) * tracePhase (-cuspFrequency k * z)
  have hc (h : O) : Continuous (f h) := by
    change Continuous (fun z : ℂ => cubicResidualNonzeroAmplitude v h *
      Complex.exp (2 * Real.pi * Complex.I * ((cuspFrequency h * z) + starRingEnd ℂ (cuspFrequency h * z))) *
      Complex.exp (2 * Real.pi * Complex.I * ((-cuspFrequency k * z) + starRingEnd ℂ (-cuspFrequency k * z))))
    fun_prop
  obtain ⟨C, hC, hbound⟩ := cubicResidualNonzeroTerm_strip_bound v v hv le_rfl
  have hb (h : O) (z : ℂ) : ‖f h z‖ ≤ C * Real.exp (-(Real.pi * v) * ‖cuspFrequency h‖) := by
    dsimp only [f]
    rw [← cubicResidualNonzeroTerm_eq_amplitude v hv h z, norm_mul, tracePhase_norm, mul_one]
    exact hbound h (v, z) ⟨le_rfl, le_rfl⟩
  have hi (h : O) : IntegrableOn (f h) periodDomain :=
    (integrable_const (C * Real.exp (-(Real.pi * v) * ‖cuspFrequency h‖))).mono'
      (hc h).aestronglyMeasurable (Eventually.of_forall (hb h))
  have hnorm (h : O) : (∫ z in periodDomain, ‖f h z‖) ≤
      volume.real periodDomain * (C * Real.exp (-(Real.pi * v) * ‖cuspFrequency h‖)) := by
    simpa only [setIntegral_const, smul_eq_mul] using
      integral_mono_ae (hi h).norm (integrable_const (C * Real.exp (-(Real.pi * v) * ‖cuspFrequency h‖)))
        (Eventually.of_forall (hb h))
  have hsum : Summable (fun h : O => ∫ z in periodDomain, ‖f h z‖) :=
    Summable.of_nonneg_of_le (fun h => integral_nonneg (fun z => norm_nonneg _)) hnorm
      (((summable_exp_neg_cuspFrequency_norm (Real.pi * v) (mul_pos Real.pi_pos hv)).mul_left C).mul_left
        (volume.real periodDomain))
  have hterm (h : O) : (∫ z in periodDomain, f h z) =
      if h = k then ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * cubicResidualNonzeroAmplitude v h else 0 := by
    dsimp only [f]
    simp_rw [mul_assoc]
    rw [integral_const_mul, integral_cusp_character_product]
    split_ifs <;> ring
  calc
    _ = ∫ z in periodDomain, ∑' h : O, f h z := by
      apply integral_congr_ae
      exact Eventually.of_forall (fun z => by
        change (∑' h : O, cubicResidualNonzeroTerm h (v, z)) * tracePhase (-cuspFrequency k * z) = _
        rw [← tsum_mul_right]
        exact tsum_congr (fun h => by rw [cubicResidualNonzeroTerm_eq_amplitude v hv h z]))
    _ = ∑' h : O, ∫ z in periodDomain, f h z := (integral_tsum_of_summable_integral_norm hi hsum).symm
    _ = ∑' h : O, if h = k then ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * cubicResidualNonzeroAmplitude v h else 0 :=
      tsum_congr hterm
    _ = _ := by simp

/-- The continuous Fourier reconstruction with its arithmetic constant mode. -/
def cubicResidualFunction (w : HyperbolicSpace) : ℂ :=
  (3 * (Real.pi : ℂ)) * constantArithmeticResidue * (hyperbolicHeight w : ℂ) ^ (2 / 3 : ℂ) +
    cubicResidualNonzeroSeries (hyperbolicHeight w, hyperbolicHorizontal w)

theorem cubicResidualFunction_continuous : Continuous cubicResidualFunction := by
  apply continuous_iff_continuousAt.mpr
  intro w
  have hpower := (Complex.continuousAt_ofReal_cpow_const (hyperbolicHeight w) (2 / 3 : ℂ)
    (Or.inr (hyperbolicHeight_pos w).ne')).comp hyperbolicHeight_continuous.continuousAt
  have hseries := (cubicResidualNonzeroSeries_continuousOn.continuousAt
    ((isOpen_lt continuous_const continuous_fst).mem_nhds (hyperbolicHeight_pos w))).comp
      (hyperbolicHeight_continuous.continuousAt.prodMk hyperbolicHorizontal_continuous.continuousAt)
  exact (continuousAt_const.mul hpower).add hseries

lemma periodDomain_continuous_integrable (f : ℂ → ℂ) (hf : Continuous f) :
    IntegrableOn f periodDomain := by
  apply (hf.continuousOn.integrableOn_compact
    (isCompact_closedBall (0 : ℂ) (∑ i, ‖periodBasis i‖))).mono_set
  intro z hz
  simpa only [Metric.mem_closedBall, dist_zero_right] using norm_mem_periodDomain z hz

lemma cubicResidualNonzeroSeries_height_continuous (v : ℝ) (hv : 0 < v) :
    Continuous (fun z : ℂ => cubicResidualNonzeroSeries (v, z)) := by
  apply continuous_iff_continuousAt.mpr
  intro z
  exact (cubicResidualNonzeroSeries_continuousOn.continuousAt
    ((isOpen_lt continuous_const continuous_fst).mem_nhds hv)).comp
      (f := fun z : ℂ => (v, z)) (by fun_prop)

theorem cubicResidualFunction_fourier (v : ℝ) (hv : 0 < v) (k : O) :
    (∫ z in periodDomain, cubicResidualFunction (upperPoint z v hv) * tracePhase (-cuspFrequency k * z)) =
      ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * cubicResidualFullModeAmplitude v k := by
  have hphase : Continuous (fun z : ℂ => tracePhase (-cuspFrequency k * z)) := by
    change Continuous (fun z : ℂ => Complex.exp (2 * Real.pi * Complex.I *
      ((-cuspFrequency k * z) + starRingEnd ℂ (-cuspFrequency k * z))))
    fun_prop
  simp only [cubicResidualFunction, hyperbolicHeight_upperPoint, hyperbolicHorizontal_upperPoint, add_mul]
  have hconstant : IntegrableOn (fun z : ℂ =>
      3 * (Real.pi : ℂ) * constantArithmeticResidue * (v : ℂ) ^ (2 / 3 : ℂ) *
        tracePhase (-cuspFrequency k * z)) periodDomain :=
    periodDomain_continuous_integrable _ (continuous_const.mul hphase)
  have hseries : IntegrableOn (fun z : ℂ =>
      cubicResidualNonzeroSeries (v, z) * tracePhase (-cuspFrequency k * z)) periodDomain := by
    simpa only [Pi.mul_def] using periodDomain_continuous_integrable _
      ((cubicResidualNonzeroSeries_height_continuous v hv).mul hphase)
  rw [integral_add hconstant hseries,
    integral_const_mul, integral_cusp_character, cubicResidualNonzeroSeries_fourier v hv k]
  by_cases hk : k = 0
  · simp only [hk, cubicResidualNonzeroAmplitude, cubicResidualFullModeAmplitude,
      ite_true, mul_zero, add_zero]
    ring
  · simp only [if_neg hk, cubicResidualNonzeroAmplitude, mul_zero, zero_add]

theorem cubicResidualFunction_weightedFourier (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) :
    (∫ w in cuspPeriodStrip a b, cubicResidualFunction w * cuspWeightedFourierPhase ρ h w ∂hyperbolicVolume) =
      ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) *
        ∫ v in Set.Icc a b, ρ v * (cubicResidualFullModeAmplitude v h / (v : ℂ) ^ 3) := by
  let g : HyperbolicSpace → ℂ := fun w => cubicResidualFunction w * cuspWeightedFourierPhase ρ h w
  have hg : Continuous g := cubicResidualFunction_continuous.mul (cuspWeightedFourierPhase_continuous ρ h)
  rw [cuspInterval_integral_coordinates a b ha g hg.aestronglyMeasurable
    (cuspInterval_continuous_integrable a b ha g hg), ← integral_const_mul]
  apply setIntegral_congr_fun measurableSet_Icc
  intro v hv
  have hvp := ha.trans_le hv.1
  dsimp only
  simp_rw [g, cuspCoordinateLift_positive v _ hvp, cuspWeightedFourierPhase,
    hyperbolicHeight_upperPoint, cuspFourierPhase, hyperbolicHorizontal_upperPoint]
  have hinner : (∫ z in periodDomain, cubicResidualFunction (upperPoint z v hvp) *
      (ρ v * tracePhase (-cuspFrequency h * z))) =
      ρ v * ∫ z in periodDomain, cubicResidualFunction (upperPoint z v hvp) * tracePhase (-cuspFrequency h * z) := by
    rw [← integral_const_mul]
    apply integral_congr_ae
    exact Eventually.of_forall (fun z => by ring)
  rw [hinner, cubicResidualFunction_fourier v hvp h]
  ring

theorem cubicEisensteinResidue_weightedFourier_eq (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) :
    kernelCuspIntervalFourier a b ha ρ h cubicEisensteinResidue =
      ∫ w in cuspPeriodStrip a b, cubicResidualFunction w * cuspWeightedFourierPhase ρ h w ∂hyperbolicVolume := by
  rw [kernelCuspIntervalFourier_residue_full, cubicResidualFunction_weightedFourier a b ha]

lemma kernelCuspCoordinates_memLp (a b : ℝ) (ha : 0 < a) (F : KernelQuotientL2) :
    MemLp (fun q : ℝ × ℂ => F (integralOrbitProjection globalKubotaKernel (cuspCoordinateLift q))) 2
      ((volume.restrict (Set.Icc a b)).prod (volume.restrict periodDomain)) := by
  let S := spatialComplexSplit ⁻¹' (Set.Icc a b ×ˢ periodDomain)
  have hS : MeasurableSet S := spatialComplexSplit.measurable
    (measurableSet_Icc.prod periodDomain_measurable)
  have hpos : S ⊆ euclideanUpperHalf := fun p hp => ha.trans_le hp.1.1
  have hpre : hyperbolicEuclideanCoordinates ⁻¹' S = cuspPeriodStrip a b := by
    ext w
    change spatialComplexSplit (hyperbolicEuclideanCoordinates w) ∈ (Set.Icc a b ×ˢ periodDomain) ↔ _
    rw [spatialComplexSplit_coordinates]
    exact and_comm
  have hm := euclideanToHyperbolic_measurePreserving_on S hS
  rw [hpre] at hm
  have hF := (MemLp.ae_eq (kernelCuspIntervalPullback_ae a b ha F)
    (MeasureTheory.Lp.memLp (kernelCuspIntervalPullback a b ha F))).comp_measurePreserving hm
  have hvol := euclideanVolume_le_heightCube_hyperbolic S hS hpos (max 1 b) (by positivity)
    (fun p hp => hp.1.2.trans (le_max_right 1 b))
  have hFE := (hF.smul_measure (c := ENNReal.ofReal ((max 1 b) ^ 3)) ENNReal.ofReal_ne_top).mono_measure hvol
  have hsplit := spatialComplexSplit_preserves_volume.restrict_preimage
    (s := Set.Icc a b ×ˢ periodDomain) (measurableSet_Icc.prod periodDomain_measurable)
  have hpull := hFE.comp_measurePreserving hsplit.symm
  simpa only [Measure.prod_restrict, Measure.volume_eq_prod, Function.comp_def, S, cuspCoordinateLift] using hpull

lemma kernelCuspSections_memLp (a b : ℝ) (ha : 0 < a) (F : KernelQuotientL2) :
    ∀ᵐ v ∂volume.restrict (Set.Icc a b),
      MemLp (fun z : ℂ => F (integralOrbitProjection globalKubotaKernel (cuspCoordinateLift (v, z)))) 2
        (volume.restrict periodDomain) := by
  have hf := kernelCuspCoordinates_memLp a b ha F
  filter_upwards [hf.aestronglyMeasurable.prodMk_left, hf.norm.integrable_sq.prod_right_ae] with v hv hi
  exact (memLp_two_iff_integrable_sq_norm hv).mpr hi

lemma kernelCuspFourierCoordinate_integrable (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (F : KernelQuotientL2) :
    IntegrableOn (fun q : ℝ × ℂ =>
      (F (integralOrbitProjection globalKubotaKernel (cuspCoordinateLift q)) *
        cuspWeightedFourierPhase ρ h (cuspCoordinateLift q)) / (q.1 : ℂ) ^ 3)
      (Set.Icc a b ×ˢ periodDomain) := by
  letI : IsFiniteMeasure (volume.restrict periodDomain) := isFiniteMeasure_restrict.mpr (by
    rw [periodDomain_volume]
    exact ENNReal.ofReal_ne_top)
  have hF := (kernelCuspCoordinates_memLp a b ha F).integrable (by norm_num : (1 : ℝ≥0∞) ≤ 2)
  have hcoord : Measurable cuspCoordinateLift :=
    euclideanToHyperbolic_measurable.comp spatialComplexSplit.symm.measurable
  have hm : Measurable (fun q : ℝ × ℂ =>
      cuspWeightedFourierPhase ρ h (cuspCoordinateLift q) / (q.1 : ℂ) ^ 3) :=
    ((cuspWeightedFourierPhase_continuous ρ h).measurable.comp hcoord).div (by fun_prop)
  have hb : ∀ᵐ q ∂((volume.restrict (Set.Icc a b)).prod (volume.restrict periodDomain)),
      ‖cuspWeightedFourierPhase ρ h (cuspCoordinateLift q) / (q.1 : ℂ) ^ 3‖ ≤ ‖ρ‖ / a ^ 3 := by
    rw [Measure.prod_restrict, ← Measure.volume_eq_prod]
    filter_upwards [ae_restrict_mem (measurableSet_Icc.prod periodDomain_measurable)] with q hq
    have hpos : 0 < q.1 := ha.trans_le hq.1.1
    rw [norm_div, norm_pow, Complex.norm_of_nonneg hpos.le]
    exact (div_le_div_of_nonneg_right (cuspWeightedFourierPhase_bound ρ h (cuspCoordinateLift q))
      (by positivity)).trans (div_le_div_of_nonneg_left (norm_nonneg _) (by positivity)
        (pow_le_pow_left₀ ha.le hq.1.1 3))
  simpa only [IntegrableOn, Measure.prod_restrict, ← Measure.volume_eq_prod, mul_div_assoc] using
    hF.mul_bdd hm.aestronglyMeasurable hb

/-- The slice coefficient includes the hyperbolic height density. -/
def kernelCuspSliceCoefficient (F : KernelQuotientL2) (h : O) (v : ℝ) : ℂ :=
  (∫ z in periodDomain, F (integralOrbitProjection globalKubotaKernel (cuspCoordinateLift (v, z))) *
    tracePhase (-cuspFrequency h * z)) / (v : ℂ) ^ 3

lemma kernelCuspIntervalFourier_eq_slice_integral (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (F : KernelQuotientL2) :
    kernelCuspIntervalFourier a b ha ρ h F =
      ∫ v in Set.Icc a b, ρ v * kernelCuspSliceCoefficient F h v := by
  rw [kernelCuspIntervalFourier_integral]
  have hg : StronglyMeasurable (fun w =>
      F (integralOrbitProjection globalKubotaKernel w) * cuspWeightedFourierPhase ρ h w) :=
    ((MeasureTheory.Lp.stronglyMeasurable F).comp_measurable (measurable_integralOrbitProjection _)).mul
      (cuspWeightedFourierPhase_continuous ρ h).stronglyMeasurable
  rw [cuspInterval_integral_coordinates a b ha _ hg.aestronglyMeasurable
    (kernelCuspFourierCoordinate_integrable a b ha ρ h F)]
  apply setIntegral_congr_fun measurableSet_Icc
  intro v hv
  have hpos := ha.trans_le hv.1
  simp only [kernelCuspSliceCoefficient]
  rw [← mul_div_assoc]
  congr 1
  rw [← integral_const_mul]
  apply integral_congr_ae
  exact Eventually.of_forall (fun z => by
    dsimp only
    rw [cuspWeightedFourierPhase, cuspFourierPhase, cuspCoordinateLift_positive v z hpos,
      hyperbolicHeight_upperPoint, hyperbolicHorizontal_upperPoint]
    ring)

lemma kernelCuspSliceCoefficient_integrable (a b : ℝ) (ha : 0 < a)
    (h : O) (F : KernelQuotientL2) :
    IntegrableOn (kernelCuspSliceCoefficient F h) (Set.Icc a b) := by
  have hi := kernelCuspFourierCoordinate_integrable a b ha (BoundedContinuousFunction.const ℝ 1) h F
  rw [IntegrableOn, Measure.volume_eq_prod, ← Measure.prod_restrict] at hi
  apply hi.integral_prod_left.congr
  filter_upwards [ae_restrict_mem measurableSet_Icc] with v hv
  have hpos := ha.trans_le hv.1
  rw [integral_div, kernelCuspSliceCoefficient]
  apply congrArg (fun c : ℂ => c / (v : ℂ) ^ 3)
  apply integral_congr_ae
  exact Eventually.of_forall (fun z => by
    dsimp only
    rw [cuspWeightedFourierPhase, cuspFourierPhase, cuspCoordinateLift_positive v z hpos,
      hyperbolicHeight_upperPoint, hyperbolicHorizontal_upperPoint]
    simp only [BoundedContinuousFunction.const_apply, one_mul])

lemma interval_ae_eq_of_boundedContinuous_tests (a b : ℝ) (f g : ℝ → ℂ)
    (hf : IntegrableOn f (Set.Icc a b)) (hg : IntegrableOn g (Set.Icc a b))
    (heq : ∀ ρ : BoundedContinuousFunction ℝ ℂ,
      (∫ v in Set.Icc a b, ρ v * f v) = ∫ v in Set.Icc a b, ρ v * g v) :
    f =ᵐ[volume.restrict (Set.Icc a b)] g := by
  apply ae_eq_of_integral_contDiff_smul_eq hf.locallyIntegrable hg.locallyIntegrable
  intro test htest hsupp
  obtain ⟨C, hC⟩ := hsupp.exists_bound_of_continuous htest.continuous
  let ρ : BoundedContinuousFunction ℝ ℂ :=
    BoundedContinuousFunction.ofNormedAddCommGroup (fun v => (test v : ℂ))
      (Complex.continuous_ofReal.comp htest.continuous) C (fun v => by
        simpa only [Complex.norm_real, Real.norm_eq_abs] using hC v)
  have hh := heq ρ
  change (∫ v in Set.Icc a b, (test v : ℂ) * f v) = ∫ v in Set.Icc a b, (test v : ℂ) * g v at hh
  simpa only [Complex.real_smul] using hh

lemma cubicResidualFullMode_density_integrable (a b : ℝ) (ha : 0 < a) (h : O) :
    IntegrableOn (fun v : ℝ => cubicResidualFullModeAmplitude v h / (v : ℂ) ^ 3) (Set.Icc a b) := by
  by_cases hh : h = 0
  · subst h
    have hi : IntegrableOn (fun v : ℝ => (3 * (Real.pi : ℂ)) * constantArithmeticResidue *
        (v : ℂ) ^ (-(4 / 3 : ℂ) - 1)) (Set.Icc a b) := by
      apply ContinuousOn.integrableOn_Icc
      intro v hv
      exact (continuousAt_const.mul (Complex.continuousAt_ofReal_cpow_const v _
        (Or.inr (ha.trans_le hv.1).ne'))).continuousWithinAt
    apply hi.congr
    filter_upwards [ae_restrict_mem measurableSet_Icc] with v hv
    exact (cubicResidualFullModeAmplitude_zero_density v (ha.trans_le hv.1)).symm
  · apply ((cubicResidualBesselDensity_integrable a b ha h hh).const_mul
      (cubicResidualFourierCoefficient h)).congr
    filter_upwards [ae_restrict_mem measurableSet_Icc] with v hv
    exact (cubicResidualFullModeAmplitude_nonzero_density v (ha.trans_le hv.1) h hh).symm

theorem cubicEisensteinResidue_slice_coefficient_ae (a b : ℝ) (ha : 0 < a) (h : O) :
    kernelCuspSliceCoefficient cubicEisensteinResidue h =ᵐ[volume.restrict (Set.Icc a b)]
      (fun v => ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * (cubicResidualFullModeAmplitude v h / (v : ℂ) ^ 3)) := by
  apply interval_ae_eq_of_boundedContinuous_tests a b _ _
    (kernelCuspSliceCoefficient_integrable a b ha h cubicEisensteinResidue)
    ((cubicResidualFullMode_density_integrable a b ha h).const_mul _)
  intro ρ
  rw [← kernelCuspIntervalFourier_eq_slice_integral a b ha ρ h cubicEisensteinResidue,
    kernelCuspIntervalFourier_residue_full, ← integral_const_mul]
  apply integral_congr_ae
  exact Eventually.of_forall (fun v => by ring)

theorem cubicEisensteinResidue_all_fourier_integrals_ae (a b : ℝ) (ha : 0 < a) :
    ∀ᵐ v ∂volume.restrict (Set.Icc a b), ∀ h : O,
      (∫ z in periodDomain, cubicEisensteinResidue
        (integralOrbitProjection globalKubotaKernel (cuspCoordinateLift (v, z))) * tracePhase (-cuspFrequency h * z)) =
        ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * cubicResidualFullModeAmplitude v h := by
  letI : Countable O := Coordinates.coordinateEquiv.injective.countable
  have hall := ae_all_iff.mpr (fun h => cubicEisensteinResidue_slice_coefficient_ae a b ha h)
  filter_upwards [hall, ae_restrict_mem measurableSet_Icc] with v hv hvmem
  intro h
  have hv0 : (v : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ha.trans_le hvmem.1).ne'
  have he := hv h
  unfold kernelCuspSliceCoefficient at he
  rw [← mul_div_assoc] at he
  exact (div_left_inj' (pow_ne_zero 3 hv0)).mp he

open scoped NNReal Pointwise

/-- Real coordinates for the cusp lattice and its dual characters. -/
def periodVector : (Fin 2 → ℝ) ≃L[ℝ] ℂ := periodBasis.equivFunL.symm

def periodTorus (z : ℂ) : UnitAddTorus (Fin 2) :=
  fun i => (periodBasis.equivFunL z i : UnitAddCircle)

def periodFrequencyEquiv : (Fin 2 → ℤ) ≃ O :=
  (finTwoArrowEquiv ℤ).trans
    (({ toFun := fun z => (z.1 + z.2, z.1)
        invFun := fun z => (z.2, z.1 - z.2)
        left_inv := by rintro ⟨k, l⟩; simp
        right_inv := by rintro ⟨k, l⟩; simp } : (ℤ × ℤ) ≃ (ℤ × ℤ)).trans
      Coordinates.coordinateEquiv.symm)

lemma periodVector_apply (x : Fin 2 → ℝ) :
    periodVector x = 3 * ((x 0 : ℂ) + (x 1 : ℂ) * ringComplex omega) := by
  change periodBasis.equivFun.symm x = _
  rw [Module.Basis.equivFun_symm_apply, Fin.sum_univ_two, periodBasis_zero, periodBasis_one]
  simp only [Complex.real_smul]
  ring

lemma periodTorus_periodVector (x : Fin 2 → ℝ) :
    periodTorus (periodVector x) = fun i => (x i : UnitAddCircle) := by
  change (fun i => ((periodBasis.equivFunL (periodBasis.equivFunL.symm x)) i : UnitAddCircle)) = _
  rw [periodBasis.equivFunL.apply_symm_apply]

lemma periodVector_character (n : Fin 2 → ℤ) (x : Fin 2 → ℝ) :
    tracePhase (cuspFrequency (periodFrequencyEquiv n) * periodVector x) =
      Complex.exp (2 * Real.pi * Complex.I *
        ((n 0 : ℂ) * (x 0 : ℂ) + (n 1 : ℂ) * (x 1 : ℂ))) := by
  have hd : ringComplex traceLambda ≠ 0 := ringComplex_ne_zero traceLambda_ne_zero
  have harg : cuspFrequency (periodFrequencyEquiv n) * periodVector x =
      (((n 0 + n 1 : ℤ) : ℂ) + (n 0 : ℂ) * ringComplex omega) *
        ((x 0 : ℂ) + (x 1 : ℂ) * ringComplex omega) / ringComplex traceLambda := by
    change cuspFrequency (Coordinates.eval (n 0 + n 1) (n 0)) * periodVector x = _
    rw [cuspFrequency, periodVector_apply, ringComplex_eval]
    field_simp
  rw [harg]
  change Complex.exp (2 * Real.pi * Complex.I * (_ + starRingEnd ℂ _)) = _
  congr 1
  rw [map_div₀, complex_traceLambda_conjugate]
  simp only [map_add, map_mul, map_intCast, Complex.conj_ofReal, complex_omega_conjugate]
  field_simp [hd]
  simp only [traceLambda, map_add, map_mul, map_one, map_ofNat]
  push_cast
  ring

lemma periodTorus_mFourier (n : Fin 2 → ℤ) (z : ℂ) :
    UnitAddTorus.mFourier n (periodTorus z) =
      tracePhase (cuspFrequency (periodFrequencyEquiv n) * z) := by
  obtain ⟨x, rfl⟩ := periodVector.surjective z
  rw [periodTorus_periodVector, periodVector_character]
  simp only [UnitAddTorus.mFourier, ContinuousMap.coe_mk, Fin.prod_univ_two,
    fourier_coe_apply, Complex.ofReal_one, div_one]
  rw [← Complex.exp_add]
  congr 1
  ring

lemma periodFrequencyEquiv_neg (n : Fin 2 → ℤ) :
    periodFrequencyEquiv (-n) = -periodFrequencyEquiv n := by
  apply ringComplex_injective
  change ringComplex (Coordinates.eval (-n 0 + -n 1) (-n 0)) =
    ringComplex (-Coordinates.eval (n 0 + n 1) (n 0))
  rw [map_neg, ringComplex_eval, ringComplex_eval]
  push_cast
  ring

/-- Haar uniqueness supplies the positive coordinate density; its value is irrelevant to uniqueness. -/
def periodCovolumeDensity : ℝ≥0 :=
  Measure.addHaarScalarFactor (Measure.map periodVector volume) (volume : Measure ℂ)

lemma periodCovolumeDensity_pos : 0 < periodCovolumeDensity :=
  Measure.addHaarScalarFactor_pos_of_isAddHaarMeasure _ _

lemma periodVector_map_volume :
    Measure.map periodVector volume = (periodCovolumeDensity : ℝ≥0∞) • volume :=
  Measure.isAddLeftInvariant_eq_smul _ _

def periodCube : Set (Fin 2 → ℝ) := {x | ∀ i, x i ∈ Set.Ico 0 1}

def periodIocCube : Set (Fin 2 → ℝ) := {x | ∀ i, x i ∈ Set.Ioc 0 (0 + 1)}

lemma periodVector_preimage_domain : periodVector ⁻¹' periodDomain = periodCube := by
  ext x
  change (∀ i, periodBasis.repr (periodBasis.equivFun.symm x) i ∈ Set.Ico 0 1) ↔ _
  simp only [← Module.Basis.equivFun_apply, periodBasis.equivFun.apply_symm_apply]
  rfl

lemma periodDomain_integral_coordinates (f : ℂ → ℂ) :
    (periodCovolumeDensity : ℝ) • (∫ z in periodDomain, f z) =
      ∫ x in periodCube, f (periodVector x) := by
  have h := periodVector.toHomeomorph.toMeasurableEquiv.measurableEmbedding.setIntegral_map
    f periodDomain (μ := (volume : Measure (Fin 2 → ℝ)))
  change (∫ z in periodDomain, f z ∂Measure.map periodVector volume) =
    ∫ x in periodVector ⁻¹' periodDomain, f (periodVector x) at h
  rw [periodVector_map_volume, Measure.restrict_smul, integral_smul_measure,
    ENNReal.coe_toReal, periodVector_preimage_domain] at h
  exact h

lemma periodIocCube_measurable : MeasurableSet periodIocCube :=
  MeasurableSet.univ_pi' (fun _ => measurableSet_Ioc)

lemma periodCube_ae_Ioc : periodCube =ᵐ[volume] periodIocCube := by
  rw [volume_pi]
  have h := Measure.ae_eq_set_pi (μ := fun _ : Fin 2 => (volume : Measure ℝ))
    (I := Set.univ) (s := fun _ => Set.Ico (0 : ℝ) 1) (t := fun _ => Set.Ioc (0 : ℝ) 1)
    (fun _ _ => Ico_ae_eq_Ioc)
  simpa only [Set.pi, Set.mem_univ, forall_true_left, periodCube, periodIocCube, zero_add] using h

section PeriodFourierCompleteness

local instance : MeasureSpace UnitAddCircle := ⟨AddCircle.haarAddCircle⟩
local instance : Measure.IsAddHaarMeasure (volume : Measure UnitAddCircle) :=
  inferInstanceAs (Measure.IsAddHaarMeasure AddCircle.haarAddCircle)
local instance : IsProbabilityMeasure (volume : Measure UnitAddCircle) :=
  inferInstanceAs (IsProbabilityMeasure AddCircle.haarAddCircle)

lemma periodTorus_integral (f : UnitAddTorus (Fin 2) → ℂ) :
    (∫ t, f t) = (periodCovolumeDensity : ℝ) • (∫ z in periodDomain, f (periodTorus z)) := by
  rw [periodDomain_integral_coordinates, UnitAddTorus.integral_preimage f (fun _ => 0)]
  simp only [periodTorus_periodVector]
  exact setIntegral_congr_set periodCube_ae_Ioc.symm

lemma periodTorus_fourierCoeff (f : UnitAddTorus (Fin 2) → ℂ) (n : Fin 2 → ℤ) :
    UnitAddTorus.mFourierCoeff f n = (periodCovolumeDensity : ℝ) •
      (∫ z in periodDomain, f (periodTorus z) *
        tracePhase (-cuspFrequency (periodFrequencyEquiv n) * z)) := by
  rw [UnitAddTorus.mFourierCoeff, periodTorus_integral]
  congr 1
  apply integral_congr_ae
  exact Eventually.of_forall (fun z => by
    dsimp only
    rw [periodTorus_mFourier, periodFrequencyEquiv_neg]
    simp only [cuspFrequency, map_neg, neg_div, smul_eq_mul]
    exact mul_comm _ _)

/-- A measurable choice of representatives transports arbitrary L² functions to the torus. -/
def periodSection (t : UnitAddTorus (Fin 2)) : ℂ :=
  periodVector ((UnitAddTorus.measurableEquivPiIoc (fun _ : Fin 2 => (0 : ℝ)) t).val)

lemma periodSection_measurableEmbedding : MeasurableEmbedding periodSection :=
  periodVector.toHomeomorph.toMeasurableEquiv.measurableEmbedding.comp
    ((MeasurableEmbedding.subtype_coe periodIocCube_measurable).comp
      (UnitAddTorus.measurableEquivPiIoc (fun _ : Fin 2 => (0 : ℝ))).measurableEmbedding)

lemma periodTorus_measurable : Measurable periodTorus := by
  apply measurable_pi_iff.mpr
  intro i
  exact AddCircle.measurable_mk'.comp
    ((measurable_pi_apply i).comp periodBasis.equivFunL.continuous.measurable)

lemma periodTorus_section (t : UnitAddTorus (Fin 2)) : periodTorus (periodSection t) = t := by
  rw [periodSection, periodTorus_periodVector]
  exact (UnitAddTorus.measurableEquivPiIoc (fun _ : Fin 2 => (0 : ℝ))).symm_apply_apply t

lemma periodSection_measurePreserving :
    MeasurePreserving periodSection volume
      ((periodCovolumeDensity : ℝ≥0∞) • volume.restrict periodDomain) := by
  have hvector : MeasurePreserving periodVector (volume.restrict periodIocCube)
      ((periodCovolumeDensity : ℝ≥0∞) • volume.restrict periodDomain) := by
    refine ⟨periodVector.continuous.measurable, ?_⟩
    rw [← Measure.restrict_congr_set periodCube_ae_Ioc, ← periodVector_preimage_domain,
      ← Measure.restrict_map periodVector.continuous.measurable periodDomain_measurable,
      periodVector_map_volume, Measure.restrict_smul]
  exact hvector.comp ((measurePreserving_subtype_coe periodIocCube_measurable).comp
    (UnitAddTorus.measurePreserving_equivPiIoc (fun _ : Fin 2 => (0 : ℝ))))

lemma periodTorus_measurePreserving :
    MeasurePreserving periodTorus ((periodCovolumeDensity : ℝ≥0∞) • volume.restrict periodDomain) volume := by
  refine ⟨periodTorus_measurable, ?_⟩
  rw [← periodSection_measurePreserving.map_eq,
    Measure.map_map periodTorus_measurable periodSection_measurableEmbedding.measurable]
  have he : periodTorus ∘ periodSection = id := funext periodTorus_section
  rw [he, Measure.map_id]

lemma periodSection_torus_ae :
    (fun z => periodSection (periodTorus z)) =ᵐ[volume.restrict periodDomain] (fun z : ℂ => z) := by
  have hc : (periodCovolumeDensity : ℝ≥0∞) ≠ 0 := by
    exact_mod_cast periodCovolumeDensity_pos.ne'
  apply (Measure.ae_ennreal_smul_measure_iff hc).mp
  rw [← periodSection_measurePreserving.map_eq]
  apply periodSection_measurableEmbedding.ae_map_iff.mpr
  exact Eventually.of_forall (fun t => by dsimp only; rw [periodTorus_section])

lemma periodSection_memLp (f : ℂ → ℂ) (hf : MemLp f 2 (volume.restrict periodDomain)) :
    MemLp (f ∘ periodSection) 2 (volume : Measure (UnitAddTorus (Fin 2))) :=
  (hf.smul_measure (c := (periodCovolumeDensity : ℝ≥0∞)) (by simp)).comp_measurePreserving
    periodSection_measurePreserving

def periodTorusL2Lift (f : ℂ → ℂ) (hf : MemLp f 2 (volume.restrict periodDomain)) :
    Lp ℂ 2 (volume : Measure (UnitAddTorus (Fin 2))) :=
  (periodSection_memLp f hf).toLp (f ∘ periodSection)

lemma periodTorusL2Lift_pullback (f : ℂ → ℂ) (hf : MemLp f 2 (volume.restrict periodDomain)) :
    (fun z => periodTorusL2Lift f hf (periodTorus z)) =ᵐ[volume.restrict periodDomain] f := by
  have hc : (periodCovolumeDensity : ℝ≥0∞) ≠ 0 := by
    exact_mod_cast periodCovolumeDensity_pos.ne'
  have he := periodTorus_measurePreserving.quasiMeasurePreserving.ae_eq_comp
    (MemLp.coeFn_toLp (periodSection_memLp f hf))
  have he' := (Measure.ae_ennreal_smul_measure_iff hc).mp he
  filter_upwards [he', periodSection_torus_ae] with z hz hsec
  change periodTorusL2Lift f hf (periodTorus z) = f (periodSection (periodTorus z)) at hz
  rwa [hsec] at hz

/-- All cusp-lattice Fourier coefficients determine an L² function on one period cell. -/
theorem periodDomain_L2_ext (f g : ℂ → ℂ)
    (hf : MemLp f 2 (volume.restrict periodDomain))
    (hg : MemLp g 2 (volume.restrict periodDomain))
    (heq : ∀ h : O,
      (∫ z in periodDomain, f z * tracePhase (-cuspFrequency h * z)) =
        ∫ z in periodDomain, g z * tracePhase (-cuspFrequency h * z)) :
    f =ᵐ[volume.restrict periodDomain] g := by
  have hlift : periodTorusL2Lift f hf = periodTorusL2Lift g hg := by
    apply UnitAddTorus.mFourierBasis.repr.injective
    ext n
    rw [UnitAddTorus.mFourierBasis_repr, UnitAddTorus.mFourierBasis_repr,
      periodTorus_fourierCoeff, periodTorus_fourierCoeff]
    congr 1
    calc
      _ = ∫ z in periodDomain, f z * tracePhase (-cuspFrequency (periodFrequencyEquiv n) * z) :=
        integral_congr_ae ((periodTorusL2Lift_pullback f hf).mul (Eventually.of_forall (fun _ => rfl)))
      _ = ∫ z in periodDomain, g z * tracePhase (-cuspFrequency (periodFrequencyEquiv n) * z) := heq _
      _ = _ := integral_congr_ae
        ((periodTorusL2Lift_pullback g hg).symm.mul (Eventually.of_forall (fun _ => rfl)))
  filter_upwards [periodTorusL2Lift_pullback f hf, periodTorusL2Lift_pullback g hg] with z hz hz'
  rw [← hz, ← hz', hlift]

end PeriodFourierCompleteness

lemma cubicResidualFunction_height_continuous (v : ℝ) (hv : 0 < v) :
    Continuous (fun z : ℂ => cubicResidualFunction (upperPoint z v hv)) := by
  simpa only [cubicResidualFunction, hyperbolicHeight_upperPoint, hyperbolicHorizontal_upperPoint,
    Pi.add_def] using
    continuous_const.add (cubicResidualNonzeroSeries_height_continuous v hv)

lemma cubicResidualFunction_height_memLp (v : ℝ) (hv : 0 < v) :
    MemLp (fun z : ℂ => cubicResidualFunction (cuspCoordinateLift (v, z))) 2
      (volume.restrict periodDomain) := by
  simp_rw [cuspCoordinateLift_positive v _ hv]
  have hc := cubicResidualFunction_height_continuous v hv
  apply (memLp_two_iff_integrable_sq_norm hc.aestronglyMeasurable).mpr
  apply (((hc.norm.pow 2).continuousOn).integrableOn_compact
    (isCompact_closedBall (0 : ℂ) (∑ i, ‖periodBasis i‖))).mono_set
  intro z hz
  simpa only [Metric.mem_closedBall, dist_zero_right] using norm_mem_periodDomain z hz

/-- Weighted tests determine the residue on almost every positive-height period cell. -/
theorem cubicEisensteinResidue_cell_slices_ae (a b : ℝ) (ha : 0 < a) :
    ∀ᵐ v ∂volume.restrict (Set.Icc a b),
      (fun z : ℂ => cubicEisensteinResidue
        (integralOrbitProjection globalKubotaKernel (cuspCoordinateLift (v, z))))
      =ᵐ[volume.restrict periodDomain] (fun z => cubicResidualFunction (cuspCoordinateLift (v, z))) := by
  filter_upwards [cubicEisensteinResidue_all_fourier_integrals_ae a b ha,
    kernelCuspSections_memLp a b ha cubicEisensteinResidue,
    ae_restrict_mem measurableSet_Icc] with v hfour hL hv
  have hpos := ha.trans_le hv.1
  apply periodDomain_L2_ext _ _ hL (cubicResidualFunction_height_memLp v hpos)
  intro h
  rw [hfour h]
  symm
  simpa only [cuspCoordinateLift_positive v _ hpos] using cubicResidualFunction_fourier v hpos h

lemma cubicResidualFunction_period (v : ℝ) (hv : 0 < v) (z : ℂ) (n : O) :
    cubicResidualFunction (upperPoint (z + 3 * ringComplex n) v hv) =
      cubicResidualFunction (upperPoint z v hv) := by
  simp only [cubicResidualFunction, hyperbolicHeight_upperPoint, hyperbolicHorizontal_upperPoint]
  congr 1
  apply tsum_congr
  intro h
  simp only [cubicResidualNonzeroTerm]
  split_ifs
  · rfl
  · rw [mul_add, AddChar.map_add_eq_mul, cuspFrequency_period, mul_one]

lemma integralTranslation_three_mem_kernel (n : O) : integralTranslation (3 * n) ∈ globalKubotaKernel := by
  have h3 : Ideal.Quotient.mk (Ideal.span {(3 : O)}) (3 : O) = 0 :=
    (Ideal.Quotient.eq_zero_iff_mem).mpr (Ideal.subset_span (by simp))
  have hlevel : integralTranslation (3 * n) ∈ levelThree := by
    change Matrix.SpecialLinearGroup.map (n := Fin 2)
      (Ideal.Quotient.mk (Ideal.span {(3 : O)})) (integralTranslation (3 * n)) = 1
    ext i j
    change (Ideal.Quotient.mk (Ideal.span {(3 : O)})) ((integralTranslation (3 * n)) i j) =
      (1 : Matrix (Fin 2) (Fin 2) (O ⧸ Ideal.span {(3 : O)})) i j
    fin_cases i <;> fin_cases j <;> simp [integralTranslation, h3]
  apply (globalKubotaKernel_mem _).mpr
  refine ⟨hlevel, ?_⟩
  change ringComplex (value ⟨integralTranslation (3 * n), hlevel⟩) = 1
  rw [value_zero_lower_left _ (by rfl), map_one]

lemma kernelProjection_upper_period (v : ℝ) (hv : 0 < v) (z : ℂ) (n : O) :
    integralOrbitProjection globalKubotaKernel (upperPoint (z + 3 * ringComplex n) v hv) =
      integralOrbitProjection globalKubotaKernel (upperPoint z v hv) := by
  let M : globalKubotaKernel := ⟨integralTranslation (3 * n), integralTranslation_three_mem_kernel n⟩
  have ha : integralComplexMatrix (M : SL(2, O)) • upperPoint z v hv =
      upperPoint (z + 3 * ringComplex n) v hv := by
    simpa only [M, map_mul, map_ofNat] using integralTranslation_action (3 * n) z v hv
  rw [← ha, integralOrbitProjection_eq]

/-- A periodic null set is null on the plane once it is null on one period cell. -/
lemma ae_eq_of_periodDomain_eq (f g : ℂ → ℂ)
    (hf : ∀ (n : O) (z : ℂ), f (z + 3 * ringComplex n) = f z)
    (hg : ∀ (n : O) (z : ℂ), g (z + 3 * ringComplex n) = g z)
    (he : f =ᵐ[volume.restrict periodDomain] g) : f =ᵐ[volume] g := by
  have hp (p : periodLattice) (z : ℂ) : f (p +ᵥ z) = f z ∧ g (p +ᵥ z) = g z := by
    obtain ⟨n, rfl⟩ := periodEquiv.surjective p
    change f (3 * ringComplex n + z) = f z ∧ g (3 * ringComplex n + z) = g z
    rw [add_comm]
    exact ⟨hf n z, hg n z⟩
  have hi : ∀ p : periodLattice, p +ᵥ {z : ℂ | f z ≠ g z} = {z : ℂ | f z ≠ g z} := by
    intro p
    ext z
    rw [Set.mem_vadd_set_iff_neg_vadd_mem]
    change (f ((-p) +ᵥ z) ≠ g ((-p) +ᵥ z)) ↔ f z ≠ g z
    rw [(hp (-p) z).1, (hp (-p) z).2]
  have hz : volume ({z : ℂ | f z ≠ g z} ∩ periodDomain) = 0 := by
    change ∀ᵐ z ∂volume.restrict periodDomain, f z = g z at he
    rw [ae_restrict_iff' periodDomain_measurable, ae_iff] at he
    have hs : {z : ℂ | f z ≠ g z} ∩ periodDomain =
        {z : ℂ | ¬(z ∈ periodDomain → f z = g z)} := by
      ext z
      simp only [Set.mem_setOf_eq, Set.mem_inter_iff]
      tauto
    rw [hs]
    exact he
  rw [Filter.EventuallyEq, ae_iff]
  exact periodDomain_fundamental.measure_zero_of_invariant _ hi hz

lemma positive_height_interval_cover :
    Set.Ioi (0 : ℝ) = ⋃ n : ℕ, Set.Icc (1 / ((n : ℝ) + 1)) ((n : ℝ) + 1) := by
  ext v
  constructor
  · intro hv
    obtain ⟨n, hn⟩ := exists_nat_gt (max v (1 / v))
    have hN : 0 < (n : ℝ) + 1 := by positivity
    have hvN : v ≤ (n : ℝ) + 1 := by linarith only [hn, le_max_left v (1 / v)]
    have hinv : 1 / v ≤ (n : ℝ) + 1 := by linarith only [hn, le_max_right v (1 / v)]
    have hlow : 1 / ((n : ℝ) + 1) ≤ v := by
      apply (div_le_iff₀ hN).mpr
      simpa only [mul_comm] using (div_le_iff₀ (show 0 < v from hv)).mp hinv
    exact Set.mem_iUnion.mpr ⟨n, hlow, hvN⟩
  · intro hv
    obtain ⟨n, hn⟩ := Set.mem_iUnion.mp hv
    exact lt_of_lt_of_le (by positivity : 0 < (1 : ℝ) / ((n : ℝ) + 1)) hn.1

lemma cuspCoordinateLift_measurable : Measurable cuspCoordinateLift :=
  euclideanToHyperbolic_measurable.comp spatialComplexSplit.symm.measurable

/-- Coordinate null sets remain null after inserting the hyperbolic volume density. -/
lemma hyperbolic_ae_of_coordinate_ae (f g : HyperbolicSpace → ℂ)
    (hf : Measurable f) (hg : Measurable g)
    (he : ∀ᵐ q ∂(volume.restrict (Set.Ioi (0 : ℝ))).prod (volume : Measure ℂ),
      f (cuspCoordinateLift q) = g (cuspCoordinateLift q)) : f =ᵐ[hyperbolicVolume] g := by
  have hm := spatialComplexSplit_preserves_volume.restrict_preimage
    (s := Set.Ioi (0 : ℝ) ×ˢ (Set.univ : Set ℂ)) (measurableSet_Ioi.prod MeasurableSet.univ)
  have htarget : (volume : Measure (ℝ × ℂ)).restrict (Set.Ioi 0 ×ˢ (Set.univ : Set ℂ)) =
      (volume.restrict (Set.Ioi (0 : ℝ))).prod (volume : Measure ℂ) := by
    rw [Measure.volume_eq_prod, ← Measure.prod_restrict, Measure.restrict_univ]
  have hsource : spatialComplexSplit ⁻¹' (Set.Ioi (0 : ℝ) ×ˢ (Set.univ : Set ℂ)) = euclideanUpperHalf := by
    ext p
    simp only [Set.mem_preimage, Set.mem_prod, Set.mem_univ, and_true, Set.mem_Ioi,
      spatialComplexSplit_fst, euclideanUpperHalf, Set.mem_setOf_eq]
  rw [htarget, hsource] at hm
  have heuc := hm.quasiMeasurePreserving.ae he
  have heuc' : ∀ᵐ p ∂volume.restrict euclideanUpperHalf,
      f (euclideanToHyperbolic p) = g (euclideanToHyperbolic p) := by
    simpa only [cuspCoordinateLift, spatialComplexSplit.symm_apply_apply] using heuc
  have hweighted : ∀ᵐ p ∂hyperbolicEuclideanVolume,
      f (euclideanToHyperbolic p) = g (euclideanToHyperbolic p) :=
    heuc'.filter_mono (withDensity_absolutelyContinuous
      (volume.restrict euclideanUpperHalf) hyperbolicDensity).ae_le
  change ∀ᵐ w ∂Measure.map euclideanToHyperbolic hyperbolicEuclideanVolume, f w = g w
  exact (ae_map_iff euclideanToHyperbolic_measurable.aemeasurable (measurableSet_eq_fun hf hg)).mpr hweighted

/-- The convergent Fourier series is the actual residual vector almost everywhere. -/
theorem cubicEisensteinResidue_continuous_representative :
    (fun w => cubicEisensteinResidue (integralOrbitProjection globalKubotaKernel w))
      =ᵐ[hyperbolicVolume] cubicResidualFunction := by
  have hplanes (a b : ℝ) (ha : 0 < a) : ∀ᵐ v ∂volume.restrict (Set.Icc a b),
      ∀ᵐ z ∂volume, cubicEisensteinResidue
        (integralOrbitProjection globalKubotaKernel (cuspCoordinateLift (v, z))) =
          cubicResidualFunction (cuspCoordinateLift (v, z)) := by
    filter_upwards [cubicEisensteinResidue_cell_slices_ae a b ha,
      ae_restrict_mem measurableSet_Icc] with v hv hvm
    have hvp := ha.trans_le hvm.1
    apply ae_eq_of_periodDomain_eq _ _ _ _ hv
    · intro n z
      simp only [cuspCoordinateLift_positive v _ hvp, kernelProjection_upper_period]
    · intro n z
      simpa only [cuspCoordinateLift_positive v _ hvp] using cubicResidualFunction_period v hvp z n
  have hheights : ∀ᵐ v ∂volume.restrict (Set.Ioi (0 : ℝ)),
      ∀ᵐ z ∂volume, cubicEisensteinResidue
        (integralOrbitProjection globalKubotaKernel (cuspCoordinateLift (v, z))) =
          cubicResidualFunction (cuspCoordinateLift (v, z)) := by
    rw [positive_height_interval_cover, ae_restrict_iUnion_iff]
    intro n
    exact hplanes _ _ (by positivity)
  have hf := (MeasureTheory.Lp.stronglyMeasurable cubicEisensteinResidue).measurable.comp
    (measurable_integralOrbitProjection globalKubotaKernel)
  apply hyperbolic_ae_of_coordinate_ae _ _ hf cubicResidualFunction_continuous.measurable
  exact (Measure.ae_prod_iff_ae_ae (measurableSet_eq_fun
    (hf.comp cuspCoordinateLift_measurable)
    (cubicResidualFunction_continuous.measurable.comp cuspCoordinateLift_measurable))).mpr hheights

lemma kernelProjection_quasiMeasurePreserving :
    Measure.QuasiMeasurePreserving (integralOrbitProjection globalKubotaKernel)
      hyperbolicVolume (integralQuotientVolume globalKubotaKernel) := by
  let proj := integralOrbitProjection globalKubotaKernel
  have hp : Measurable proj := measurable_integralOrbitProjection _
  refine ⟨hp, Measure.AbsolutelyContinuous.mk fun S hS hzero => ?_⟩
  rw [Measure.map_apply hp hS]
  have hd : hyperbolicVolume ((proj ⁻¹' S) ∩ hyperbolicFundamentalSet globalKubotaKernel) = 0 := by
    simpa only [integralQuotientVolume, proj,
      Measure.map_apply (measurable_integralOrbitProjection _) hS,
      Measure.restrict_apply ((measurable_integralOrbitProjection _) hS)] using hzero
  have hinv : ∀ M : globalKubotaKernel, M • (proj ⁻¹' S) = proj ⁻¹' S := by
    intro M
    ext w
    constructor
    · rintro ⟨u, hu, rfl⟩
      change proj (M • u) ∈ S
      change proj u ∈ S at hu
      rwa [show proj (M • u) = proj u from integralOrbitProjection_eq _ M u]
    · intro hw
      refine ⟨M⁻¹ • w, ?_, smul_inv_smul M w⟩
      change proj (M⁻¹ • w) ∈ S
      rwa [show proj (M⁻¹ • w) = proj w from integralOrbitProjection_eq _ M⁻¹ w]
  exact (globalKubotaKernel_isFundamentalDomain hyperbolicVolume).measure_zero_of_invariant _ hinv hd

/-- Continuity upgrades the residual L² transformation law to pointwise automorphy. -/
theorem cubicResidualFunction_automorphy (M : levelThree) (w : HyperbolicSpace) :
    cubicResidualFunction (complexMatrix M • w) = complexCharacter M * cubicResidualFunction w := by
  have he : (fun q => cubicEisensteinResidue (kernelLevelAction M q))
      =ᵐ[integralQuotientVolume globalKubotaKernel]
        (fun q => complexCharacter M * cubicEisensteinResidue q) := by
    filter_upwards [kernelLevelPullback_ae_eq M cubicEisensteinResidue,
      Lp.coeFn_smul (complexCharacter M) cubicEisensteinResidue] with q hq hs
    rw [cubicEisensteinResidue_character M] at hq
    exact hq.symm.trans hs
  have hl := kernelProjection_quasiMeasurePreserving.ae_eq_comp he
  have hrep := cubicEisensteinResidue_continuous_representative
  have hcomp := (measurePreserving_smul (complexMatrix M)
    hyperbolicVolume).quasiMeasurePreserving.ae_eq_comp hrep
  have hae : (fun p : HyperbolicSpace => cubicResidualFunction (complexMatrix M • p))
      =ᵐ[hyperbolicVolume] (fun p => complexCharacter M * cubicResidualFunction p) := by
    filter_upwards [hcomp, hl, hrep] with p hp hc hr
    simp only [Function.comp_def, kernelLevelAction_mk] at hc
    exact hp.symm.trans (hc.trans (congrArg (fun z => complexCharacter M * z) hr))
  exact congrFun (Measure.eq_of_ae_eq hae
    (cubicResidualFunction_continuous.comp (continuous_hyperbolic_action (complexMatrix M)))
    (continuous_const.mul cubicResidualFunction_continuous)) w

/-- The trace pairing in the real Eisenstein basis is independent of embedding orientation. -/
lemma complexTrace_real_basis_product (a b u v : ℝ) :
    (((a : ℂ) + (b : ℂ) * ringComplex omega) *
        ((u : ℂ) + (v : ℂ) * ringComplex omega) / ringComplex traceLambda) +
      starRingEnd ℂ (((a : ℂ) + (b : ℂ) * ringComplex omega) *
        ((u : ℂ) + (v : ℂ) * ringComplex omega) / ringComplex traceLambda) =
      ((a * v + b * u - b * v : ℝ) : ℂ) := by
  have hd := ringComplex_ne_zero traceLambda_ne_zero
  rw [map_div₀, complex_traceLambda_conjugate]
  simp only [map_mul, map_add, Complex.conj_ofReal, complex_omega_conjugate]
  field_simp [hd]
  simp only [traceLambda, map_add, map_mul, map_one, map_ofNat]
  push_cast
  ring

lemma exp_two_pi_real_eq_one (t : ℝ)
    (h : Complex.exp (2 * Real.pi * Complex.I * (t : ℂ)) = 1) : ∃ n : ℤ, t = n := by
  obtain ⟨n, hn⟩ := Complex.exp_eq_one_iff.mp h
  refine ⟨n, ?_⟩
  have hc : (2 * Real.pi * Complex.I : ℂ) ≠ 0 := by
    exact mul_ne_zero (mul_ne_zero (by norm_num) (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero)) Complex.I_ne_zero
  have he : (t : ℂ) = (n : ℂ) := mul_left_cancel₀ hc (hn.trans (mul_comm _ _))
  exact_mod_cast he

/-- Triviality of every normalized trace character characterizes the integral lattice. -/
theorem tracePhase_dual_lattice (z : ℂ)
    (h : ∀ n : O, tracePhase (z * ringComplex n / ringComplex traceLambda) = 1) :
    ∃ q : O, ringComplex q = z := by
  obtain ⟨x, hx⟩ := periodVector.surjective (3 * z)
  rw [periodVector_apply] at hx
  have hz : z = (x 0 : ℂ) + (x 1 : ℂ) * ringComplex omega :=
    (mul_left_cancel₀ (by norm_num : (3 : ℂ) ≠ 0) hx).symm
  have htest (u v : ℤ) :
      Complex.exp (2 * Real.pi * Complex.I *
        ((x 0 * v + x 1 * u - x 1 * v : ℝ) : ℂ)) = 1 := by
    have hh := h (Coordinates.eval u v)
    rw [hz, ringComplex_eval] at hh
    change Complex.exp (2 * Real.pi * Complex.I * (_ + starRingEnd ℂ _)) = 1 at hh
    convert hh using 2
    congr 1
    simpa only [Complex.ofReal_intCast] using
      (complexTrace_real_basis_product (x 0) (x 1) u v).symm
  have hb : Complex.exp (2 * Real.pi * Complex.I * (x 1 : ℂ)) = 1 := by
    simpa only [Int.cast_one, Int.cast_zero, mul_one, mul_zero, zero_add, sub_zero] using htest 1 0
  have ha : Complex.exp (2 * Real.pi * Complex.I * ((x 0 - x 1 : ℝ) : ℂ)) = 1 := by
    simpa only [Int.cast_one, Int.cast_zero, mul_one, mul_zero, add_zero] using htest 0 1
  obtain ⟨b, hb'⟩ := exp_two_pi_real_eq_one (x 1) hb
  obtain ⟨a, ha'⟩ := exp_two_pi_real_eq_one (x 0 - x 1) ha
  refine ⟨Coordinates.eval (a + b) b, ?_⟩
  rw [ringComplex_eval, hz, hb', show x 0 = (a : ℝ) + b by linarith only [ha', hb']]
  push_cast
  rfl

def residueAdditive (h c d : O) : ℂ :=
  tracePhase (cuspFrequency h * ringComplex d / ringComplex c)

lemma residueAdditive_add (h c d e : O) :
    residueAdditive h c (d + e) = residueAdditive h c d * residueAdditive h c e := by
  unfold residueAdditive
  rw [map_add, mul_add, add_div, AddChar.map_add_eq_mul]

lemma residueAdditive_congr (h c d e : O) (hc : c ≠ 0) (hde : 3 * c ∣ d - e) :
    residueAdditive h c d = residueAdditive h c e := by
  obtain ⟨n, hn⟩ := hde
  have hd : d = e + 3 * c * n := by linear_combination hn
  rw [hd, residueAdditive_add]
  have hphase : residueAdditive h c (3 * c * n) = 1 := by
    have hcn := ringComplex_ne_zero hc
    have he : cuspFrequency h * ringComplex (3 * c * n) / ringComplex c =
        ringComplex (h * n) / ringComplex traceLambda := by
      simp only [cuspFrequency, map_mul, map_ofNat]
      field_simp
    rw [residueAdditive, he, tracePhase_embedding_div_traceLambda]
  rw [hphase, mul_one]

lemma ramifiedElement_ne_zero (u : Oˣ) (n : ℕ) : (u : O) * lambda ^ n ≠ 0 :=
by
  have hl : lambda ≠ 0 := by
    intro hz
    have hh := lambda_sq_dvd_three
    simp only [hz, zero_pow (by decide : (2 : ℕ) ≠ 0), zero_dvd_iff] at hh
    norm_num at hh
  exact mul_ne_zero u.ne_zero (pow_ne_zero _ hl)

lemma ramifiedElement_level (u : Oˣ) (n : ℕ) (hn : 2 ≤ n) : (3 : O) ∣ (u : O) * lambda ^ n :=
  dvd_mul_of_dvd_right (three_dvd_lambda_sq.trans (pow_dvd_pow lambda hn)) _

lemma ramified_denominator_condition (u : Oˣ) (n : ℕ) (d : O)
    (hd : (3 : O) ∣ d - 1) : denominatorCondition ((u : O) * lambda ^ n) d := by
  have hu : IsCoprime (u : O) d := ⟨↑u⁻¹, 0, by simp⟩
  have hl3 : lambda ∣ (3 : O) := (dvd_pow_self lambda (by decide : (2 : ℕ) ≠ 0)).trans lambda_sq_dvd_three
  have hld : IsCoprime lambda d := coprime_of_dvd_sub_one lambda d (hl3.trans hd)
  exact ⟨hu.mul_left hld.pow_left, hd⟩

lemma ramified_symbol_congr_mod_nine (u : Oˣ) (n : ℕ) (d e : O)
    (hd : (3 : O) ∣ d - 1) (he : (3 : O) ∣ e - 1) (hde : (9 : O) ∣ d - e) :
    symbol ((u : O) * lambda ^ n) d = symbol ((u : O) * lambda ^ n) e := by
  have hdp := lambda_sq_dvd_three.trans hd
  have hep := lambda_sq_dvd_three.trans he
  rw [symbol_mul_numerator _ _ d, symbol_mul_numerator _ _ e,
    symbol_pow_numerator _ d hdp, symbol_pow_numerator _ e hep,
    symbol_unit_congr_mod_nine u.val d e u.isUnit hdp hep hde,
    symbol_lambda_congr_mod_nine d e hdp hep hde]

lemma primary_add_nine (d w : O) (hd : (3 : O) ∣ d - 1) : (3 : O) ∣ d + 9 * w - 1 := by
  convert dvd_add hd (show (3 : O) ∣ 9 * w from ⟨3 * w, by ring⟩) using 1
  ring

lemma denominatorRep_mk_congr (c d : O) :
    3 * c ∣ denominatorRep c (Ideal.Quotient.mk (Ideal.span {3 * c}) d) - d := by
  apply Ideal.mem_span_singleton.mp
  apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp
  exact denominatorRep_spec c _

def ramifiedResidueAdd (u : Oˣ) (n : ℕ) (w : O)
    (r : AdmissibleResidue ((u : O) * lambda ^ n)) : AdmissibleResidue ((u : O) * lambda ^ n) :=
  let c := (u : O) * lambda ^ n
  let d := denominatorRep c r.1 + 9 * w
  ⟨Ideal.Quotient.mk (Ideal.span {3 * c}) d,
    (denominatorCondition_congr c _ d (denominatorRep_mk_congr c d)).mpr
      (ramified_denominator_condition u n d (primary_add_nine _ _ r.2.2))⟩

lemma ramifiedResidueAdd_injective (u : Oˣ) (n : ℕ) (w : O) :
    Function.Injective (ramifiedResidueAdd u n w) := by
  intro r q heq
  have hh := congrArg Subtype.val heq
  change Ideal.Quotient.mk (Ideal.span {3 * ((u : O) * lambda ^ n)}) (denominatorRep _ r.1 + 9 * w) =
    Ideal.Quotient.mk (Ideal.span {3 * ((u : O) * lambda ^ n)}) (denominatorRep _ q.1 + 9 * w) at hh
  simp only [map_add, denominatorRep_spec] at hh
  exact Subtype.ext (add_right_cancel hh)

/-- Translation by nine fixes the cubic symbol and diagonalizes the additive phase. -/
theorem ramified_arithmetic_additive_eigen (h : O) (u : Oˣ) (n : ℕ) (hn : 2 ≤ n) (w : O) :
    residueAdditive h ((u : O) * lambda ^ n) (9 * w) * arithmeticResidueSum h ((u : O) * lambda ^ n) =
      arithmeticResidueSum h ((u : O) * lambda ^ n) := by
  let c := (u : O) * lambda ^ n
  have hc : c ≠ 0 := ramifiedElement_ne_zero u n
  have hlevel : (3 : O) ∣ c := ramifiedElement_level u n hn
  letI : Finite (AdmissibleResidue c) := finite_admissibleResidue c hc
  let e : AdmissibleResidue c ≃ AdmissibleResidue c := Equiv.ofBijective (ramifiedResidueAdd u n w)
    ⟨ramifiedResidueAdd_injective u n w, Finite.surjective_of_injective (ramifiedResidueAdd_injective u n w)⟩
  change _ = ∑' r : AdmissibleResidue c, ringComplex (symbol c (denominatorRep c r.1)) *
    residueAdditive h c (denominatorRep c r.1)
  rw [← e.tsum_eq]
  rw [arithmeticResidueSum, ← tsum_mul_left]
  apply tsum_congr
  intro r
  let d := denominatorRep c r.1
  have hrep : 3 * c ∣ denominatorRep c (ramifiedResidueAdd u n w r).1 - (d + 9 * w) :=
    denominatorRep_mk_congr c (d + 9 * w)
  have hdp := primary_add_nine d w r.2.2
  have hchar : symbol c (denominatorRep c (ramifiedResidueAdd u n w r).1) = symbol c d := by
    rw [row_symbol_congr_modulus c _ (d + 9 * w) hlevel hdp hrep]
    exact ramified_symbol_congr_mod_nine u n (d + 9 * w) d hdp r.2.2 ⟨w, by ring⟩
  change _ = ringComplex (symbol c (denominatorRep c (ramifiedResidueAdd u n w r).1)) *
    residueAdditive h c (denominatorRep c (ramifiedResidueAdd u n w r).1)
  rw [hchar, residueAdditive_congr h c _ (d + 9 * w) hc hrep, residueAdditive_add]
  change residueAdditive h c (9 * w) * (ringComplex (symbol c d) * residueAdditive h c d) = _
  ring

/-- Only finitely many ramified powers can contribute at a fixed nonzero frequency. -/
theorem ramified_arithmetic_support (h : O) (u : Oˣ) (n : ℕ) (hn : 2 ≤ n)
    (hA : arithmeticResidueSum h ((u : O) * lambda ^ n) ≠ 0) : (u : O) * lambda ^ n ∣ 3 * h := by
  let c := (u : O) * lambda ^ n
  have hc := ringComplex_ne_zero (ramifiedElement_ne_zero u n)
  change ringComplex c ≠ 0 at hc
  have hp (w : O) : residueAdditive h c (9 * w) = 1 := by
    apply mul_right_cancel₀ hA
    rw [ramified_arithmetic_additive_eigen h u n hn w, one_mul]
  obtain ⟨q, hq⟩ := tracePhase_dual_lattice (ringComplex (3 * h) / ringComplex c) (by
    intro w
    convert hp w using 1
    unfold residueAdditive cuspFrequency
    simp only [map_mul, map_ofNat]
    congr 1
    field_simp
    ring)
  refine ⟨q, ?_⟩
  apply ringComplex_injective
  rw [map_mul ringComplex c q, hq]
  field_simp [hc]

abbrev CubicUnitResidue (b : O) := {r : O ⧸ Ideal.span {b} // IsUnit r}

/-- Coprime CRT separates the primary denominator condition from the unramified unit condition. -/
def denominatorCRTMap (a b : O) (r : AdmissibleResidue (a * b)) :
    AdmissibleResidue a × CubicUnitResidue b :=
  let d := denominatorRep (a * b) r.1
  (⟨Ideal.Quotient.mk (Ideal.span {3 * a}) d,
      (denominatorCondition_congr a _ d (denominatorRep_mk_congr a d)).mpr
        ⟨r.2.1.of_mul_left_left, r.2.2⟩⟩,
   ⟨Ideal.Quotient.mk (Ideal.span {b}) d,
      (isUnit_quotient_span_iff b d).mpr r.2.1.of_mul_left_right⟩)

lemma denominatorCRTMap_bijective (a b : O) (hab : IsCoprime (3 * a) b) :
    Function.Bijective (denominatorCRTMap a b) := by
  constructor
  · intro r t he
    have h1 := congrArg (fun z : AdmissibleResidue a × CubicUnitResidue b => z.1.1) he
    have h2 := congrArg (fun z : AdmissibleResidue a × CubicUnitResidue b => z.2.1) he
    change Ideal.Quotient.mk (Ideal.span {3 * a}) (denominatorRep (a * b) r.1) =
      Ideal.Quotient.mk (Ideal.span {3 * a}) (denominatorRep (a * b) t.1) at h1
    change Ideal.Quotient.mk (Ideal.span {b}) (denominatorRep (a * b) r.1) =
      Ideal.Quotient.mk (Ideal.span {b}) (denominatorRep (a * b) t.1) at h2
    have hdiv : 3 * (a * b) ∣ denominatorRep (a * b) r.1 - denominatorRep (a * b) t.1 := by
      simpa only [mul_assoc] using hab.mul_dvd
        (Ideal.mem_span_singleton.mp ((Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp h1))
        (Ideal.mem_span_singleton.mp ((Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp h2))
    apply Subtype.ext
    rw [← denominatorRep_spec (a * b) r.1, ← denominatorRep_spec (a * b) t.1]
    exact (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr (Ideal.mem_span_singleton.mpr hdiv)
  · rintro ⟨r, t⟩
    obtain ⟨u, v, huv⟩ := hab
    let delta := denominatorRep a r.1
    let xi := principalResidueRep b t.1
    let d := v * b * delta + u * (3 * a) * xi
    have hda : 3 * a ∣ d - delta := by
      refine ⟨u * (xi - delta), ?_⟩
      dsimp [d]
      linear_combination delta * huv
    have hdb : b ∣ d - xi := by
      refine ⟨v * (delta - xi), ?_⟩
      dsimp [d]
      linear_combination xi * huv
    have hxi : IsCoprime b xi := by
      apply (isUnit_quotient_span_iff b xi).mp
      simpa only [xi, principalResidueRep_spec] using t.2
    have had := (denominatorCondition_congr a d delta hda).mpr r.2
    have hbd : IsCoprime b d := by
      obtain ⟨k, hk⟩ := hdb
      have hd : d = xi + b * k := by linear_combination hk
      rwa [hd, IsCoprime.add_mul_left_right_iff]
    have hd : denominatorCondition (a * b) d := ⟨had.1.mul_left hbd, had.2⟩
    let q : AdmissibleResidue (a * b) := ⟨Ideal.Quotient.mk (Ideal.span {3 * (a * b)}) d,
      (denominatorCondition_congr (a * b) _ d (denominatorRep_mk_congr (a * b) d)).mpr hd⟩
    refine ⟨q, Prod.ext (Subtype.ext ?_) (Subtype.ext ?_)⟩
    · change Ideal.Quotient.mk (Ideal.span {3 * a}) (denominatorRep (a * b) q.1) = r.1
      rw [← denominatorRep_spec a r.1]
      apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr
      apply Ideal.mem_span_singleton.mpr
      have hh : 3 * a ∣ denominatorRep (a * b) q.1 - d :=
        (show 3 * a ∣ 3 * (a * b) from ⟨b, by ring⟩).trans (denominatorRep_mk_congr (a * b) d)
      simpa only [sub_add_sub_cancel] using dvd_add hh hda
    · change Ideal.Quotient.mk (Ideal.span {b}) (denominatorRep (a * b) q.1) = t.1
      rw [← principalResidueRep_spec b t.1]
      apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr
      apply Ideal.mem_span_singleton.mpr
      have hh : b ∣ denominatorRep (a * b) q.1 - d :=
        (show b ∣ 3 * (a * b) from ⟨3 * a, by ring⟩).trans (denominatorRep_mk_congr (a * b) d)
      simpa only [sub_add_sub_cancel] using dvd_add hh hdb

def denominatorCRTEquiv (a b : O) (hab : IsCoprime (3 * a) b) :
    AdmissibleResidue (a * b) ≃ AdmissibleResidue a × CubicUnitResidue b :=
  Equiv.ofBijective (denominatorCRTMap a b) (denominatorCRTMap_bijective a b hab)

/-- The finite cubic Gauss sum at the primitive trace normalization. -/
def cubicUnitGaussSum (h b : O) : ℂ :=
  ∑' r : CubicUnitResidue b, ringComplex (symbol (principalResidueRep b r.1) b) *
    residueAdditive (3 * h) b (principalResidueRep b r.1)

lemma residueAdditive_three_congr (h b d e : O) (hb : b ≠ 0) (hde : b ∣ d - e) :
    residueAdditive (3 * h) b d = residueAdditive (3 * h) b e := by
  obtain ⟨n, hn⟩ := hde
  have hd : d = e + b * n := by linear_combination hn
  have he := ringComplex_ne_zero hb
  rw [hd, residueAdditive_add]
  have hp : residueAdditive (3 * h) b (b * n) = 1 := by
    have harg : cuspFrequency (3 * h) * ringComplex (b * n) / ringComplex b =
        cuspFrequency h * (3 * ringComplex n) := by
      simp only [cuspFrequency, map_mul, map_ofNat]
      field_simp
    rw [residueAdditive, harg, cuspFrequency_period]
  rw [hp, mul_one]

lemma residueAdditive_crt (h a b alpha beta d : O) (ha : a ≠ 0) (hb : b ≠ 0)
    (hbez : alpha * b + beta * (3 * a) = 1) :
    residueAdditive h (a * b) d =
      residueAdditive (h * alpha) a d * residueAdditive (3 * (h * beta)) b d := by
  unfold residueAdditive
  rw [← AddChar.map_add_eq_mul]
  congr 1
  have hae := ringComplex_ne_zero ha
  have hbe := ringComplex_ne_zero hb
  have hbeq := congrArg ringComplex hbez
  simp only [map_add, map_mul, map_one, map_ofNat] at hbeq
  simp only [cuspFrequency, map_mul, map_ofNat]
  field_simp [hae, hbe, ringComplex_ne_zero traceLambda_ne_zero]
  linear_combination -(ringComplex h * ringComplex d) * hbeq

lemma arithmetic_crt_summand (h a b alpha beta : O)
    (ha : a ≠ 0) (hb : b ≠ 0) (halevel : (3 : O) ∣ a)
    (hbprimary : lambda ^ 2 ∣ b - 1) (hbez : alpha * b + beta * (3 * a) = 1)
    (r : AdmissibleResidue (a * b)) :
    ringComplex (symbol (a * b) (denominatorRep (a * b) r.1)) *
      residueAdditive h (a * b) (denominatorRep (a * b) r.1) =
      (ringComplex (symbol a (denominatorRep a (denominatorCRTMap a b r).1.1)) *
        residueAdditive (h * alpha) a (denominatorRep a (denominatorCRTMap a b r).1.1)) *
      (ringComplex (symbol (principalResidueRep b (denominatorCRTMap a b r).2.1) b) *
        residueAdditive (3 * (h * beta)) b (principalResidueRep b (denominatorCRTMap a b r).2.1)) := by
  let d := denominatorRep (a * b) r.1
  let delta := denominatorRep a (denominatorCRTMap a b r).1.1
  let xi := principalResidueRep b (denominatorCRTMap a b r).2.1
  have hdprimary := lambda_sq_dvd_three.trans r.2.2
  have hdelta : 3 * a ∣ delta - d := denominatorRep_mk_congr a d
  have hxi : b ∣ xi - d := by
    apply Ideal.mem_span_singleton.mp
    apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp
    exact principalResidueRep_spec b _
  have hchar : symbol (a * b) d = symbol a delta * symbol xi b := by
    rw [symbol_mul_numerator a b d, symbol_reciprocity b d hbprimary hdprimary,
      ← symbol_congr hxi, ← row_symbol_congr_modulus a delta d halevel r.2.2 hdelta]
  change ringComplex (symbol (a * b) d) * residueAdditive h (a * b) d =
    (ringComplex (symbol a delta) * residueAdditive (h * alpha) a delta) *
      (ringComplex (symbol xi b) * residueAdditive (3 * (h * beta)) b xi)
  rw [hchar, map_mul, residueAdditive_crt h a b alpha beta d ha hb hbez,
    residueAdditive_congr (h * alpha) a delta d ha hdelta,
    residueAdditive_three_congr (h * beta) b xi d hb hxi]
  ring

/-- CRT and cubic reciprocity factor the actual residue sum into ramified and unramified sums. -/
theorem arithmeticResidueSum_crt (h a b alpha beta : O)
    (ha : a ≠ 0) (hb : b ≠ 0) (halevel : (3 : O) ∣ a)
    (hbprimary : lambda ^ 2 ∣ b - 1) (hbez : alpha * b + beta * (3 * a) = 1) :
    arithmeticResidueSum h (a * b) =
      arithmeticResidueSum (h * alpha) a * cubicUnitGaussSum (h * beta) b := by
  have hab : IsCoprime (3 * a) b := ⟨beta, alpha, by linear_combination hbez⟩
  let f : AdmissibleResidue a → ℂ := fun r =>
    ringComplex (symbol a (denominatorRep a r.1)) * residueAdditive (h * alpha) a (denominatorRep a r.1)
  let g : CubicUnitResidue b → ℂ := fun r =>
    ringComplex (symbol (principalResidueRep b r.1) b) *
      residueAdditive (3 * (h * beta)) b (principalResidueRep b r.1)
  have heq : arithmeticResidueSum h (a * b) =
      ∑' r : AdmissibleResidue (a * b), f (denominatorCRTEquiv a b hab r).1 * g (denominatorCRTEquiv a b hab r).2 :=
    tsum_congr (arithmetic_crt_summand h a b alpha beta ha hb halevel hbprimary hbez)
  rw [heq, (denominatorCRTEquiv a b hab).tsum_eq (fun r => f r.1 * g r.2)]
  letI : Finite (AdmissibleResidue a) := finite_admissibleResidue a ha
  letI : Finite (O ⧸ Ideal.span {b}) := (Ideal.span {b}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr hb)
  letI : Fintype (AdmissibleResidue a) := Fintype.ofFinite _
  letI : Fintype (CubicUnitResidue b) := Fintype.ofFinite _
  change (∑' r : AdmissibleResidue a × CubicUnitResidue b, f r.1 * g r.2) =
    (∑' r : AdmissibleResidue a, f r) * (∑' t : CubicUnitResidue b, g t)
  simp only [tsum_fintype, Fintype.sum_prod_type, Finset.mul_sum, Finset.sum_mul]
  exact Finset.sum_comm

lemma residueAdditive_mul (h c t d : O) :
    residueAdditive h c (t * d) = residueAdditive (h * t) c d := by
  unfold residueAdditive cuspFrequency
  simp only [map_mul]
  congr 1
  ring

lemma residueAdditive_swap (h c d : O) : residueAdditive h c d = residueAdditive d c h := by
  unfold residueAdditive cuspFrequency
  congr 1
  ring

lemma arithmeticResidueSum_frequency_congr (h k c : O) (hc : c ≠ 0)
    (hh : 3 * c ∣ h - k) : arithmeticResidueSum h c = arithmeticResidueSum k c := by
  apply tsum_congr
  intro r
  congr 1
  change residueAdditive h c (denominatorRep c r.1) = residueAdditive k c (denominatorRep c r.1)
  rw [residueAdditive_swap h, residueAdditive_swap k]
  exact residueAdditive_congr _ c h k hc hh

/-- Multiplication by an admissible denominator twists the frequency by its cubic character. -/
theorem arithmeticResidueSum_frequency_twist (h c t : O) (hc : c ≠ 0)
    (hlevel : (3 : O) ∣ c) (ht : denominatorCondition c t) :
    ringComplex (symbol c t) * arithmeticResidueSum (h * t) c = arithmeticResidueSum h c := by
  have heq := (residueMultiplicationEquiv c hc t ht).tsum_eq
    (fun r : AdmissibleResidue c => ringComplex (symbol c (denominatorRep c r.1)) *
      residueAdditive h c (denominatorRep c r.1))
  calc
    _ = ∑' r : AdmissibleResidue c, ringComplex (symbol c t) *
        (ringComplex (symbol c (denominatorRep c r.1)) * residueAdditive (h * t) c (denominatorRep c r.1)) := by
      rw [tsum_mul_left]
      rfl
    _ = ∑' r : AdmissibleResidue c,
        ringComplex (symbol c (denominatorRep c (residueMultiplicationEquiv c hc t ht r).1)) *
          residueAdditive h c (denominatorRep c (residueMultiplicationEquiv c hc t ht r).1) := by
      apply tsum_congr
      intro r
      change _ = ringComplex (symbol c (denominatorRep c (residueMultiplication c t ht r).1)) *
        residueAdditive h c (denominatorRep c (residueMultiplication c t ht r).1)
      rw [residueMultiplication_phase c hlevel t ht r, map_mul]
      dsimp only [residueMultiplication]
      rw [residueAdditive_congr h c _ (t * denominatorRep c r.1) hc
        (denominatorRep_product_congr c t r.1), residueAdditive_mul]
      ring
    _ = _ := heq

lemma cubicUnitGaussSum_frequency_congr (h k b : O) (hb : b ≠ 0)
    (hh : b ∣ h - k) : cubicUnitGaussSum h b = cubicUnitGaussSum k b := by
  apply tsum_congr
  intro r
  congr 1
  have he (u : O) : residueAdditive (3 * u) b (principalResidueRep b r.1) =
      residueAdditive (3 * principalResidueRep b r.1) b u := by
    unfold residueAdditive cuspFrequency
    simp only [map_mul, map_ofNat]
    congr 1
    ring
  rw [he h, he k]
  exact residueAdditive_three_congr _ b h k hb hh

def cubicUnitResidueMul (b t : O) (ht : IsCoprime b t) (r : CubicUnitResidue b) : CubicUnitResidue b :=
  ⟨Ideal.Quotient.mk (Ideal.span {b}) t * r.1, ((isUnit_quotient_span_iff b t).mpr ht).mul r.2⟩

lemma cubicUnitResidueMul_injective (b t : O) (ht : IsCoprime b t) :
    Function.Injective (cubicUnitResidueMul b t ht) := by
  intro r q heq
  apply Subtype.ext
  exact ((isUnit_quotient_span_iff b t).mpr ht).mul_left_cancel (congrArg Subtype.val heq)

def cubicUnitResidueMulEquiv (b t : O) (hb : b ≠ 0) (ht : IsCoprime b t) :
    CubicUnitResidue b ≃ CubicUnitResidue b := by
  letI : Finite (O ⧸ Ideal.span {b}) := (Ideal.span {b}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr hb)
  exact Equiv.ofBijective (cubicUnitResidueMul b t ht)
    ⟨cubicUnitResidueMul_injective b t ht, Finite.surjective_of_injective (cubicUnitResidueMul_injective b t ht)⟩

lemma cubicUnitResidueMul_rep_congr (b t : O) (ht : IsCoprime b t) (r : CubicUnitResidue b) :
    b ∣ principalResidueRep b (cubicUnitResidueMul b t ht r).1 - t * principalResidueRep b r.1 := by
  apply Ideal.mem_span_singleton.mp
  apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp
  rw [principalResidueRep_spec, map_mul, principalResidueRep_spec]
  rfl

theorem cubicUnitGaussSum_frequency_twist (h b t : O) (hb : b ≠ 0)
    (ht : IsCoprime b t) :
    ringComplex (symbol t b) * cubicUnitGaussSum (h * t) b = cubicUnitGaussSum h b := by
  have heq := (cubicUnitResidueMulEquiv b t hb ht).tsum_eq
    (fun r : CubicUnitResidue b => ringComplex (symbol (principalResidueRep b r.1) b) *
      residueAdditive (3 * h) b (principalResidueRep b r.1))
  calc
    _ = ∑' r : CubicUnitResidue b, ringComplex (symbol t b) *
        (ringComplex (symbol (principalResidueRep b r.1) b) *
          residueAdditive (3 * (h * t)) b (principalResidueRep b r.1)) := by
      rw [tsum_mul_left]
      rfl
    _ = ∑' r : CubicUnitResidue b,
        ringComplex (symbol (principalResidueRep b (cubicUnitResidueMulEquiv b t hb ht r).1) b) *
          residueAdditive (3 * h) b (principalResidueRep b (cubicUnitResidueMulEquiv b t hb ht r).1) := by
      apply tsum_congr
      intro r
      change _ = ringComplex (symbol (principalResidueRep b (cubicUnitResidueMul b t ht r).1) b) *
        residueAdditive (3 * h) b (principalResidueRep b (cubicUnitResidueMul b t ht r).1)
      rw [symbol_congr (cubicUnitResidueMul_rep_congr b t ht r), symbol_mul_numerator, map_mul,
        residueAdditive_three_congr h b _ (t * principalResidueRep b r.1) hb
          (cubicUnitResidueMul_rep_congr b t ht r), residueAdditive_mul]
      rw [show (3 * h) * t = 3 * (h * t) by ring]
      ring
    _ = _ := heq

/-- Frequency twists remove the auxiliary Bezout coefficients from CRT factorization. -/
theorem arithmeticResidueSum_coprime_product (h a b : O)
    (ha : a ≠ 0) (hb : b ≠ 0) (halevel : (3 : O) ∣ a)
    (hbprimary : lambda ^ 2 ∣ b - 1) (hab : IsCoprime (3 * a) b) :
    arithmeticResidueSum h (a * b) = ringComplex (symbol a b) * ringComplex (symbol (3 * a) b) *
      arithmeticResidueSum h a * cubicUnitGaussSum h b := by
  obtain ⟨beta, alpha, hbez⟩ := hab
  have hbez' : alpha * b + beta * (3 * a) = 1 := by linear_combination hbez
  have hab' : IsCoprime (3 * a) b := ⟨beta, alpha, hbez⟩
  have hbt : denominatorCondition a b := ⟨hab'.of_mul_left_right, three_dvd_lambda_sq.trans hbprimary⟩
  have hA := arithmeticResidueSum_frequency_twist (h * alpha) a b ha halevel hbt
  have hAf : 3 * a ∣ (h * alpha) * b - h := ⟨-h * beta, by linear_combination h * hbez'⟩
  rw [arithmeticResidueSum_frequency_congr _ h a ha hAf] at hA
  have hB := cubicUnitGaussSum_frequency_twist (h * beta) b (3 * a) hb hab'.symm
  have hBf : b ∣ (h * beta) * (3 * a) - h := ⟨-h * alpha, by linear_combination h * hbez'⟩
  rw [cubicUnitGaussSum_frequency_congr _ h b hb hBf] at hB
  rw [arithmeticResidueSum_crt h a b alpha beta ha hb halevel hbprimary hbez', ← hA, ← hB]
  ring

lemma ramified_primary_coprime (u : Oˣ) (n : ℕ) (b : O)
    (hb : lambda ^ 2 ∣ b - 1) : IsCoprime (3 * ((u : O) * lambda ^ n)) b := by
  have hl : IsCoprime lambda b := coprime_of_dvd_sub_one lambda b
    ((dvd_pow_self lambda (by decide : (2 : ℕ) ≠ 0)).trans hb)
  have hu : IsCoprime (u : O) b := ⟨↑u⁻¹, 0, by simp⟩
  exact ((primary_coprime_three b hb).symm).mul_left (hu.mul_left hl.pow_left)

theorem arithmeticResidueSum_ramified_split (h : O) (u : Oˣ) (n : ℕ) (hn : 2 ≤ n)
    (b : O) (hb : lambda ^ 2 ∣ b - 1) :
    arithmeticResidueSum h (((u : O) * lambda ^ n) * b) =
      ringComplex (symbol ((u : O) * lambda ^ n) b) *
        ringComplex (symbol (3 * ((u : O) * lambda ^ n)) b) *
        arithmeticResidueSum h ((u : O) * lambda ^ n) * cubicUnitGaussSum h b :=
  arithmeticResidueSum_coprime_product h _ b (ramifiedElement_ne_zero u n)
    (primary_ne_zero b hb) (ramifiedElement_level u n hn) hb (ramified_primary_coprime u n b hb)

lemma ramifiedElement_absNorm (u : Oˣ) (n : ℕ) :
    Ideal.absNorm (Ideal.span {(u : O) * lambda ^ n}) = 3 ^ n := by
  have hu : Ideal.span {(u : O)} = (1 : Ideal O) := by
    rw [Ideal.one_eq_top]
    exact Ideal.span_singleton_eq_top.mpr u.isUnit
  rw [← Ideal.span_singleton_mul_span_singleton, map_mul, hu, map_one, one_mul,
    ← Ideal.span_singleton_pow, map_pow, absNorm_span_lambda]

lemma cubic_three_absNorm : Ideal.absNorm (Ideal.span {(3 : O)}) = 9 := by
  have he : (3 : O) = Coordinates.eval 3 0 := by simp [Coordinates.eval]
  rw [he, Ideal.absNorm_span_singleton, Coordinates.norm_eval]
  norm_num

/-- The ramified support has an explicit frequency-dependent norm bound. -/
theorem ramified_arithmetic_norm_bound (h : O) (hh : h ≠ 0) (u : Oˣ)
    (n : ℕ) (hn : 2 ≤ n) (hA : arithmeticResidueSum h ((u : O) * lambda ^ n) ≠ 0) :
    3 ^ n ≤ 9 * Ideal.absNorm (Ideal.span {h}) := by
  have hI : (Ideal.span {h} : Ideal O) ≠ 0 := Ideal.span_singleton_eq_bot.not.mpr hh
  have hN : 0 < Ideal.absNorm (Ideal.span {h}) :=
    Nat.pos_of_ne_zero (fun hz => hI (Ideal.absNorm_eq_zero_iff.mp hz))
  apply Nat.le_of_dvd (by positivity)
  obtain ⟨v, hv⟩ := ramified_arithmetic_support h u n hn hA
  refine ⟨Ideal.absNorm (Ideal.span {v}), ?_⟩
  calc
    _ = Ideal.absNorm (Ideal.span {(3 : O) * h}) := by
      rw [← Ideal.span_singleton_mul_span_singleton, map_mul, cubic_three_absNorm]
    _ = Ideal.absNorm (Ideal.span {((u : O) * lambda ^ n) * v}) := by rw [hv]
    _ = _ := by rw [← Ideal.span_singleton_mul_span_singleton, map_mul, ramifiedElement_absNorm]

/-- The exponent cutoff forced by the ramified additive character. -/
def ramifiedFrequencyBound (h : O) : ℕ := Nat.log 3 (9 * Ideal.absNorm (Ideal.span {h}))

theorem arithmeticResidueSum_ramified_index_bound (h : O) (hh : h ≠ 0)
    (u : Oˣ) (n : ℕ) (hn : 2 ≤ n) (b : O) (hb : lambda ^ 2 ∣ b - 1)
    (hA : arithmeticResidueSum h (((u : O) * lambda ^ n) * b) ≠ 0) :
    n ≤ ramifiedFrequencyBound h := by
  have ha : arithmeticResidueSum h ((u : O) * lambda ^ n) ≠ 0 := by
    intro hz
    apply hA
    rw [arithmeticResidueSum_ramified_split h u n hn b hb, hz, mul_zero, zero_mul]
  exact Nat.le_log_of_pow_le (by decide) (ramified_arithmetic_norm_bound h hh u n hn ha)

lemma arithmeticDirichletTerm_ramified_vanish (s : ℂ) (h : O) (hh : h ≠ 0)
    (u : Oˣ) (n : ℕ) (hn : 2 ≤ n) (b : O) (hb : lambda ^ 2 ∣ b - 1)
    (hout : ramifiedFrequencyBound h < n) :
    arithmeticDirichletTerm s h
      ⟨((u : O) * lambda ^ n) * b, dvd_mul_of_dvd_left (ramifiedElement_level u n hn) b⟩ = 0 := by
  have hA : arithmeticResidueSum h (((u : O) * lambda ^ n) * b) = 0 := by
    by_contra hA
    exact (not_le_of_gt hout) (arithmeticResidueSum_ramified_index_bound h hh u n hn b hb hA)
  simp only [arithmeticDirichletTerm, hA, mul_zero, ite_self]

abbrev NonzeroLevelLower := {c : LevelLower // c.1 ≠ 0}

/-- Unit, ramified power, and canonical unramified ideal generator of a nonzero level-three modulus. -/
def ramifiedLower (u : Oˣ) (n : ℕ) (I : GoodIdeal) : O :=
  ((u : O) * lambda ^ (n + 2)) * primaryIdealGenerator I.1

lemma ramifiedLower_ne_zero (u : Oˣ) (n : ℕ) (I : GoodIdeal) : ramifiedLower u n I ≠ 0 :=
  mul_ne_zero (ramifiedElement_ne_zero u (n + 2)) I.2

lemma ramifiedLower_level (u : Oˣ) (n : ℕ) (I : GoodIdeal) : (3 : O) ∣ ramifiedLower u n I :=
  dvd_mul_of_dvd_left (ramifiedElement_level u (n + 2) (by omega)) _

lemma ramifiedLower_span (u : Oˣ) (n : ℕ) (I : GoodIdeal) :
    Ideal.span {ramifiedLower u n I} = ramifiedIdeal ^ (n + 2) * I.1 := by
  unfold ramifiedLower
  rw [mul_assoc, Ideal.span_singleton_mul_left_unit u.isUnit, lambdaFactor_generator_span]

def ramifiedLowerMap (p : Oˣ × ℕ × GoodIdeal) : NonzeroLevelLower :=
  ⟨⟨ramifiedLower p.1 p.2.1 p.2.2, ramifiedLower_level _ _ _⟩, ramifiedLower_ne_zero _ _ _⟩

lemma ramifiedLowerMap_bijective : Function.Bijective ramifiedLowerMap := by
  constructor
  · rintro ⟨u, n, I⟩ ⟨v, m, J⟩ h
    have hc : ramifiedLower u n I = ramifiedLower v m J := congrArg (fun c : NonzeroLevelLower => c.1.1) h
    have hs := congrArg (fun x : O => Ideal.span {x}) hc
    rw [ramifiedLower_span, ramifiedLower_span] at hs
    have he := lambdaFactorMap_bijective.1 (show lambdaFactorMap (n + 2, I) =
      lambdaFactorMap (m + 2, J) from Subtype.ext hs)
    have hnm : n = m := Nat.add_right_cancel (congrArg Prod.fst he)
    have hIJ : I = J := congrArg Prod.snd he
    subst m
    subst J
    have hl : lambda ^ (n + 2) ≠ 0 := by simpa only [Units.val_one, one_mul] using ramifiedElement_ne_zero 1 (n + 2)
    have huv : u = v := by
      apply Units.ext
      apply mul_right_cancel₀ (mul_ne_zero hl I.2)
      simpa only [ramifiedLower, mul_assoc] using hc
    subst v
    rfl
  · intro c
    let C : NonzeroIdeal := ⟨Ideal.span {c.1.1}, Ideal.span_singleton_eq_bot.not.mpr c.2⟩
    obtain ⟨⟨k, I⟩, hCI⟩ := lambdaFactorMap_bijective.2 C
    have hfact : ramifiedIdeal ^ k * I.1 = Ideal.span {c.1.1} := congrArg Subtype.val hCI
    have hp2 : ramifiedIdeal ^ 2 ∣ ramifiedIdeal ^ k * I.1 := by
      rw [hfact]
      change (Ideal.span {lambda} : Ideal O) ^ 2 ∣ _
      rw [Ideal.span_singleton_pow, Ideal.dvd_iff_le, Ideal.span_singleton_le_span_singleton]
      exact lambda_sq_dvd_three.trans c.1.2
    have hk : 2 ≤ k := by
      by_contra hh
      have hnot := (goodIdeal_iff_not_ramified I.1).mp I.2
      have hcases : k = 0 ∨ k = 1 := by omega
      rcases hcases with rfl | rfl
      · simp only [pow_zero, one_mul] at hp2
        exact hnot ((dvd_pow_self ramifiedIdeal (by decide : (2 : ℕ) ≠ 0)).trans hp2)
      · rw [pow_one, pow_two] at hp2
        exact hnot ((mul_dvd_mul_iff_left ramifiedIdeal_prime.ne_zero).mp hp2)
    obtain ⟨n, hn⟩ := Nat.exists_eq_add_of_le hk
    have hk' : k = n + 2 := by omega
    subst k
    have hspan : Ideal.span {lambda ^ (n + 2) * primaryIdealGenerator I.1} = Ideal.span {c.1.1} :=
      (lambdaFactor_generator_span (n + 2) I).trans (by simpa only [Nat.add_comm] using hfact)
    obtain ⟨u, hu⟩ := Ideal.span_singleton_eq_span_singleton.mp hspan
    refine ⟨(u, n, I), Subtype.ext (Subtype.ext ?_)⟩
    change ramifiedLower u n I = c.1.1
    simpa only [ramifiedLower, mul_assoc, mul_comm, mul_left_comm] using hu

def ramifiedLowerEquiv : Oˣ × ℕ × GoodIdeal ≃ NonzeroLevelLower :=
  Equiv.ofBijective ramifiedLowerMap ramifiedLowerMap_bijective

lemma arithmeticDirichlet_support_nonzero (s : ℂ) (h : O) :
    Function.support (arithmeticDirichletTerm s h) ⊆ {c : LevelLower | c.1 ≠ 0} := by
  intro c hc hz
  exact hc (by simp only [arithmeticDirichletTerm, hz, ite_true])

theorem arithmeticDirichletSeries_ramified_reindex (s : ℂ) (hs : 2 < s.re) (h : O) :
    arithmeticDirichletSeries s h = ∑' u : Oˣ, ∑' n : ℕ, ∑' I : GoodIdeal,
      arithmeticDirichletTerm s h (ramifiedLowerMap (u, n, I)).1 := by
  have hsum := (arithmeticDirichletTerm_summable_norm s hs h).of_norm
  have hsub : Summable (fun c : NonzeroLevelLower => arithmeticDirichletTerm s h c.1) := hsum.subtype _
  have hp := ramifiedLowerEquiv.summable_iff.mpr hsub
  change Summable (fun p : Oˣ × ℕ × GoodIdeal => arithmeticDirichletTerm s h (ramifiedLowerMap p).1) at hp
  calc
    _ = ∑' c : NonzeroLevelLower, arithmeticDirichletTerm s h c.1 :=
      (tsum_subtype_eq_of_support_subset (arithmeticDirichlet_support_nonzero s h)).symm
    _ = ∑' p : Oˣ × ℕ × GoodIdeal, arithmeticDirichletTerm s h (ramifiedLowerMap p).1 :=
      (ramifiedLowerEquiv.tsum_eq _).symm
    _ = _ := by
      rw [hp.tsum_prod]
      exact tsum_congr (fun u => (hp.prod_factor u).tsum_prod)

/-- At nonzero frequency the ramified index in the scattering series is a finite sum. -/
theorem arithmeticDirichletSeries_finite_ramified (s : ℂ) (hs : 2 < s.re) (h : O) (hh : h ≠ 0) :
    arithmeticDirichletSeries s h =
      ∑' u : Oˣ, ∑ n ∈ Finset.range (ramifiedFrequencyBound h + 1), ∑' I : GoodIdeal,
        arithmeticDirichletTerm s h (ramifiedLowerMap (u, n, I)).1 := by
  rw [arithmeticDirichletSeries_ramified_reindex s hs h]
  apply tsum_congr
  intro u
  apply tsum_eq_sum
  intro n hn
  have hout : ramifiedFrequencyBound h < n + 2 := by
    have hnot : ¬ n < ramifiedFrequencyBound h + 1 := by simpa only [Finset.mem_range] using hn
    omega
  have hzero (I : GoodIdeal) : arithmeticDirichletTerm s h (ramifiedLowerMap (u, n, I)).1 = 0 :=
    arithmeticDirichletTerm_ramified_vanish s h hh u (n + 2) (by omega)
      (primaryIdealGenerator I.1) (primaryIdealGenerator_spec I.1 I.2).2 hout
  simp only [hzero, tsum_zero]

/-- The scattering series is a finite ramified combination of unramified cubic Gauss series. -/
theorem arithmeticDirichletSeries_gauss_expansion (s : ℂ) (hs : 2 < s.re) (h : O) (hh : h ≠ 0) :
    arithmeticDirichletSeries s h =
      ∑' u : Oˣ, ∑ n ∈ Finset.range (ramifiedFrequencyBound h + 1), ∑' I : GoodIdeal,
        ((‖ringComplex (ramifiedLower u n I)‖ ^ 2 : ℝ) : ℂ) ^ (-s) *
          (ringComplex (symbol ((u : O) * lambda ^ (n + 2)) (primaryIdealGenerator I.1)) *
           ringComplex (symbol (3 * ((u : O) * lambda ^ (n + 2))) (primaryIdealGenerator I.1)) *
           arithmeticResidueSum h ((u : O) * lambda ^ (n + 2)) * cubicUnitGaussSum h (primaryIdealGenerator I.1)) := by
  rw [arithmeticDirichletSeries_finite_ramified s hs h hh]
  apply tsum_congr
  intro u
  apply Finset.sum_congr rfl
  intro n hn
  apply tsum_congr
  intro I
  change arithmeticDirichletTerm s h ⟨ramifiedLower u n I, ramifiedLower_level u n I⟩ = _
  rw [arithmeticDirichletTerm, if_neg (ramifiedLower_ne_zero u n I)]
  dsimp only [ramifiedLower]
  rw [arithmeticResidueSum_ramified_split h u (n + 2) (by omega)
    (primaryIdealGenerator I.1) (primaryIdealGenerator_spec I.1 I.2).2]

lemma principalAddChar_congr (c : O) (χ : AddChar O ℂ)
    (hχ : ∀ x ∈ Ideal.span {c}, χ x = 1) (x y : O) (hxy : c ∣ x - y) : χ x = χ y := by
  calc
    χ x = χ ((x - y) + y) := by rw [sub_add_cancel]
    _ = χ (x - y) * χ y := AddChar.map_add_eq_mul χ _ _
    _ = χ y := by rw [hχ _ (Ideal.mem_span_singleton.mpr hxy), one_mul]

/-- Descent of an additive character trivial on a principal ideal. -/
def principalQuotientAddChar (c : O) (χ : AddChar O ℂ)
    (hχ : ∀ x ∈ Ideal.span {c}, χ x = 1) : AddChar (O ⧸ Ideal.span {c}) ℂ where
  toFun x := χ (principalResidueRep c x)
  map_zero_eq_one' := hχ _ (Ideal.Quotient.eq_zero_iff_mem.mp (principalResidueRep_spec c 0))
  map_add_eq_mul' x y := by
    rw [← AddChar.map_add_eq_mul]
    apply principalAddChar_congr c χ hχ
    apply Ideal.mem_span_singleton.mp
    apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp
    simp only [principalResidueRep_spec, map_add]

lemma principalQuotientAddChar_mk (c : O) (χ : AddChar O ℂ)
    (hχ : ∀ x ∈ Ideal.span {c}, χ x = 1) (x : O) :
    principalQuotientAddChar c χ hχ (Ideal.Quotient.mk (Ideal.span {c}) x) = χ x := by
  apply principalAddChar_congr c χ hχ
  apply Ideal.mem_span_singleton.mp
  apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp
  exact principalResidueRep_spec c _

/-- The normalized trace phase as an additive character of the integral lattice. -/
def residueTraceLinearChar (h c : O) : AddChar O ℂ where
  toFun x := residueAdditive (3 * h) c x
  map_zero_eq_one' := by
    simp only [residueAdditive, map_zero, mul_zero, zero_div, AddChar.map_zero_eq_one]
  map_add_eq_mul' := residueAdditive_add (3 * h) c

lemma residueTraceLinearChar_period (h c : O) (hc : c ≠ 0) (x : O) (hx : x ∈ Ideal.span {c}) :
    residueTraceLinearChar h c x = 1 := by
  have he := residueAdditive_three_congr h c x 0 hc
    (by simpa only [sub_zero] using Ideal.mem_span_singleton.mp hx)
  change residueAdditive (3 * h) c x = 1
  simpa only [residueAdditive, map_zero, mul_zero, zero_div,
    AddChar.map_zero_eq_one] using he

def residueTraceQuotientChar (h c : O) (hc : c ≠ 0) : AddChar (O ⧸ Ideal.span {c}) ℂ :=
  principalQuotientAddChar c (residueTraceLinearChar h c) (residueTraceLinearChar_period h c hc)

lemma residueTraceQuotientChar_mk (h c : O) (hc : c ≠ 0) (x : O) :
    residueTraceQuotientChar h c hc (Ideal.Quotient.mk (Ideal.span {c}) x) = residueAdditive (3 * h) c x :=
  principalQuotientAddChar_mk c _ _ x

/-- The geometric dual-lattice identity proves primitivity at every nonzero modulus. -/
theorem residueTraceQuotientChar_primitive (c : O) (hc : c ≠ 0) :
    (residueTraceQuotientChar 1 c hc).IsPrimitive := by
  intro r hr he
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective r
  have hc' := ringComplex_ne_zero hc
  obtain ⟨q, hq⟩ := tracePhase_dual_lattice (ringComplex a / ringComplex c) (by
    intro w
    have hh := congrArg (fun ψ : AddChar (O ⧸ Ideal.span {c}) ℂ => ψ (Ideal.Quotient.mk _ w)) he
    simp only [AddChar.mulShift_apply, ← map_mul, residueTraceQuotientChar_mk,
      AddChar.one_apply] at hh
    convert hh using 1
    unfold residueAdditive cuspFrequency
    simp only [map_mul, map_ofNat, mul_one]
    congr 1
    field_simp)
  apply hr
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  apply Ideal.mem_span_singleton.mpr
  refine ⟨q, ?_⟩
  apply ringComplex_injective
  rw [map_mul, hq]
  field_simp [hc']

/-- The ramified cubic phase is additive on the affine primary coordinates modulo three. -/
def ramifiedLinearChar (u : Oˣ) (n : ℕ) : AddChar O ℂ where
  toFun x := ringComplex (symbol ((u : O) * lambda ^ n) (1 + 3 * x))
  map_zero_eq_one' := by simp
  map_add_eq_mul' x y := by
    have hp (z : O) : (3 : O) ∣ 1 + 3 * z - 1 := ⟨z, by ring⟩
    have hprod : (3 : O) ∣ (1 + 3 * x) * (1 + 3 * y) - 1 := ⟨x + y + 3 * x * y, by ring⟩
    rw [ramified_symbol_congr_mod_nine u n (1 + 3 * (x + y))
      ((1 + 3 * x) * (1 + 3 * y)) (hp _) hprod ⟨-x * y, by ring⟩,
      symbol_mul_denominator, map_mul]

lemma ramifiedLinearChar_period (u : Oˣ) (n : ℕ) (x : O) (hx : x ∈ Ideal.span {(3 : O)}) :
    ramifiedLinearChar u n x = 1 := by
  obtain ⟨w, rfl⟩ := Ideal.mem_span_singleton.mp hx
  change ringComplex (symbol ((u : O) * lambda ^ n) (1 + 3 * (3 * w))) = 1
  rw [ramified_symbol_congr_mod_nine u n _ 1 ⟨3 * w, by ring⟩ (by simp) ⟨w, by ring⟩]
  simp

def ramifiedQuotientChar (u : Oˣ) (n : ℕ) : AddChar (O ⧸ Ideal.span {(3 : O)}) ℂ :=
  principalQuotientAddChar 3 (ramifiedLinearChar u n) (ramifiedLinearChar_period u n)

def ramifiedFrequencyChar (k : O) (u : Oˣ) (n : ℕ) : AddChar (O ⧸ Ideal.span {(3 : O)}) ℂ :=
  ramifiedQuotientChar u n * residueTraceQuotientChar k 3 (by norm_num)

lemma ramifiedFrequencyChar_rep (k : O) (u : Oˣ) (n : ℕ) (x : O ⧸ Ideal.span {(3 : O)}) :
    ramifiedFrequencyChar k u n x =
      ringComplex (symbol ((u : O) * lambda ^ n) (1 + 3 * principalResidueRep 3 x)) *
        residueAdditive k 3 (3 * principalResidueRep 3 x) := by
  change ringComplex (symbol ((u : O) * lambda ^ n) (1 + 3 * principalResidueRep 3 x)) *
    residueAdditive (3 * k) 3 (principalResidueRep 3 x) = _
  rw [residueAdditive_mul, mul_comm k 3]

def ramifiedNineSum (k : O) (u : Oˣ) (n : ℕ) : ℂ :=
  ∑' x : O ⧸ Ideal.span {(3 : O)},
    ringComplex (symbol ((u : O) * lambda ^ n) (1 + 3 * principalResidueRep 3 x)) *
      residueAdditive k 3 (1 + 3 * principalResidueRep 3 x)

/-- Orthogonality reduces the nine residue classes to a single character test. -/
theorem ramifiedNineSum_eq_character_test (k : O) (u : Oˣ) (n : ℕ) :
    ramifiedNineSum k u n =
      if ramifiedFrequencyChar k u n = 1 then 9 * residueAdditive k 3 1 else 0 := by
  letI : Finite (O ⧸ Ideal.span {(3 : O)}) := (Ideal.span {(3 : O)}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr (by norm_num))
  letI : Fintype (O ⧸ Ideal.span {(3 : O)}) := Fintype.ofFinite _
  have hcard : (Fintype.card (O ⧸ Ideal.span {(3 : O)}) : ℂ) = 9 := by
    have hh := cubic_three_absNorm
    change Nat.card (O ⧸ Ideal.span {(3 : O)}) = 9 at hh
    exact_mod_cast (show Fintype.card (O ⧸ Ideal.span {(3 : O)}) = 9 by
      simpa only [Nat.card_eq_fintype_card] using hh)
  have he : ramifiedNineSum k u n =
      residueAdditive k 3 1 * ∑' x : O ⧸ Ideal.span {(3 : O)}, ramifiedFrequencyChar k u n x := by
    rw [ramifiedNineSum, ← tsum_mul_left]
    apply tsum_congr
    intro x
    rw [ramifiedFrequencyChar_rep, residueAdditive_add]
    ring
  rw [he, tsum_fintype]
  split_ifs with hchar
  · rw [AddChar.sum_eq_card_of_eq_one hchar, hcard]
    ring
  · rw [AddChar.sum_eq_zero_of_ne_one hchar, mul_zero]

lemma ramified_affine_isUnit (u : Oˣ) (n : ℕ)
    (x : O ⧸ Ideal.span {(u : O) * lambda ^ n}) : IsUnit (1 + 3 * x) := by
  obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective x
  have hd := ramified_denominator_condition u n (1 + 3 * d) ⟨d, by ring⟩
  simpa only [map_add, map_one, map_mul, map_ofNat] using
    (isUnit_quotient_span_iff _ _).mpr hd.1

/-- All affine primary classes are units at the ramified prime. -/
def ramifiedAffineEquiv (u : Oˣ) (n : ℕ) :
    (O ⧸ Ideal.span {(u : O) * lambda ^ n}) ≃ AdmissibleResidue ((u : O) * lambda ^ n) :=
  (Equiv.subtypeUnivEquiv (ramified_affine_isUnit u n)).symm.trans (affineResidueEquiv _)

lemma ramified_arithmetic_affine (h : O) (u : Oˣ) (n : ℕ) (hn : 2 ≤ n) :
    arithmeticResidueSum h ((u : O) * lambda ^ n) =
      ∑' x : O ⧸ Ideal.span {(u : O) * lambda ^ n},
        ringComplex (symbol ((u : O) * lambda ^ n) (1 + 3 * principalResidueRep _ x)) *
          residueAdditive h ((u : O) * lambda ^ n) (1 + 3 * principalResidueRep _ x) := by
  rw [arithmeticResidueSum, ← (ramifiedAffineEquiv u n).tsum_eq]
  apply tsum_congr
  intro x
  have hrep : 3 * ((u : O) * lambda ^ n) ∣
      denominatorRep _ ((ramifiedAffineEquiv u n) x).1 -
        (1 + 3 * principalResidueRep ((u : O) * lambda ^ n) x) :=
    denominatorRep_mk_congr _ _
  change ringComplex (symbol ((u : O) * lambda ^ n)
    (denominatorRep _ ((ramifiedAffineEquiv u n) x).1)) *
      residueAdditive h _ (denominatorRep _ ((ramifiedAffineEquiv u n) x).1) = _
  rw [row_symbol_congr_modulus _ _ _ (ramifiedElement_level u n hn) ⟨_, by ring⟩ hrep,
    residueAdditive_congr h _ _ _ (ramifiedElement_ne_zero u n) hrep]

/-- Reduction from a ramified modulus divisible by three to the nine-element residue ring. -/
def ramifiedReduction (u : Oˣ) (n : ℕ) (hn : 2 ≤ n) :
    (O ⧸ Ideal.span {(u : O) * lambda ^ n}) →+* (O ⧸ Ideal.span {(3 : O)}) :=
  Ideal.Quotient.factor (Ideal.span_singleton_le_span_singleton.mpr (ramifiedElement_level u n hn))

lemma ramifiedReduction_surjective (u : Oˣ) (n : ℕ) (hn : 2 ≤ n) :
    Function.Surjective (ramifiedReduction u n hn) := Ideal.Quotient.factor_surjective _

lemma ramifiedReduction_rep (u : Oˣ) (n : ℕ) (hn : 2 ≤ n)
    (x : O ⧸ Ideal.span {(u : O) * lambda ^ n}) :
    (3 : O) ∣ principalResidueRep ((u : O) * lambda ^ n) x -
      principalResidueRep 3 (ramifiedReduction u n hn x) := by
  apply Ideal.mem_span_singleton.mp
  apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp
  rw [principalResidueRep_spec]
  exact congrArg (ramifiedReduction u n hn) (principalResidueRep_spec _ x)

lemma residueAdditive_ramified_scale (h k a d : O) (ha : a ≠ 0) (hk : 3 * h = a * k) :
    residueAdditive h a d = residueAdditive k 3 d := by
  have he := congrArg ringComplex hk
  simp only [map_mul, map_ofNat] at he
  have ha' := ringComplex_ne_zero ha
  have hl := ringComplex_ne_zero traceLambda_ne_zero
  unfold residueAdditive cuspFrequency
  simp only [map_ofNat]
  congr 1
  field_simp [ha', hl]
  linear_combination ringComplex d * he

/-- On its divisibility support, a ramified sum is a complete additive-character sum. -/
theorem ramified_arithmetic_character_test (h k : O) (u : Oˣ) (n : ℕ) (hn : 2 ≤ n)
    (hk : 3 * h = ((u : O) * lambda ^ n) * k) :
    arithmeticResidueSum h ((u : O) * lambda ^ n) =
      if ramifiedFrequencyChar k u n = 1 then ((3 ^ n : ℕ) : ℂ) * residueAdditive k 3 1 else 0 := by
  let a : O := (u : O) * lambda ^ n
  let f := ramifiedReduction u n hn
  let ψ : AddChar (O ⧸ Ideal.span {a}) ℂ :=
    { toFun := fun x => ramifiedFrequencyChar k u n (f x)
      map_zero_eq_one' := by rw [map_zero, AddChar.map_zero_eq_one]
      map_add_eq_mul' := fun x y => by rw [map_add, AddChar.map_add_eq_mul] }
  have htrivial : ψ = 1 ↔ ramifiedFrequencyChar k u n = 1 := by
    constructor
    · intro he
      ext x
      obtain ⟨y, rfl⟩ := ramifiedReduction_surjective u n hn x
      exact congrArg (fun χ : AddChar (O ⧸ Ideal.span {a}) ℂ => χ y) he
    · intro he
      ext x
      change ramifiedFrequencyChar k u n (f x) = 1
      rw [he, AddChar.one_apply]
  have hpoint (x : O ⧸ Ideal.span {a}) :
      ringComplex (symbol a (1 + 3 * principalResidueRep a x)) *
        residueAdditive h a (1 + 3 * principalResidueRep a x) = residueAdditive k 3 1 * ψ x := by
    let d := 1 + 3 * principalResidueRep a x
    let e := 1 + 3 * principalResidueRep 3 (f x)
    have hd : (3 : O) ∣ d - 1 := ⟨_, by dsimp [d]; ring⟩
    have he : (3 : O) ∣ e - 1 := ⟨_, by dsimp [e]; ring⟩
    have h9 : (9 : O) ∣ d - e := by
      obtain ⟨w, hw⟩ := ramifiedReduction_rep u n hn x
      refine ⟨w, ?_⟩
      dsimp [d, e, f, a]
      linear_combination 3 * hw
    change ringComplex (symbol a d) * residueAdditive h a d = _
    rw [ramified_symbol_congr_mod_nine u n d e hd he h9,
      residueAdditive_ramified_scale h k a d (ramifiedElement_ne_zero u n) hk,
      residueAdditive_congr k 3 d e (by norm_num) (by convert h9 using 1; norm_num)]
    change ringComplex (symbol a e) * residueAdditive k 3 e =
      residueAdditive k 3 1 * ramifiedFrequencyChar k u n (f x)
    rw [ramifiedFrequencyChar_rep]
    dsimp [e]
    rw [residueAdditive_add]
    ring
  letI : Finite (O ⧸ Ideal.span {a}) := (Ideal.span {a}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr (ramifiedElement_ne_zero u n))
  letI : Fintype (O ⧸ Ideal.span {a}) := Fintype.ofFinite _
  have hcard : (Fintype.card (O ⧸ Ideal.span {a}) : ℂ) = ((3 ^ n : ℕ) : ℂ) := by
    have hc := ramifiedElement_absNorm u n
    change Nat.card (O ⧸ Ideal.span {a}) = 3 ^ n at hc
    exact_mod_cast (show Fintype.card (O ⧸ Ideal.span {a}) = 3 ^ n by
      simpa only [Nat.card_eq_fintype_card] using hc)
  rw [ramified_arithmetic_affine h u n hn]
  have hsum : (∑' x : O ⧸ Ideal.span {a},
      ringComplex (symbol a (1 + 3 * principalResidueRep a x)) *
        residueAdditive h a (1 + 3 * principalResidueRep a x)) =
      residueAdditive k 3 1 * ∑' x, ψ x := by
    rw [← tsum_mul_left]
    exact tsum_congr hpoint
  rw [hsum, tsum_fintype]
  by_cases hchar : ramifiedFrequencyChar k u n = 1
  · rw [AddChar.sum_eq_card_of_eq_one (htrivial.mpr hchar), hcard, if_pos hchar]
    exact mul_comm _ _
  · rw [AddChar.sum_eq_zero_of_ne_one (fun hh => hchar (htrivial.mp hh)), mul_zero, if_neg hchar]


namespace RationalSource
open CubicJacobi CubicRamified
private instance : IsCyclotomicExtension {3} ℚ K := CyclotomicField.isCyclotomicExtension 3 ℚ

/-- The integral special linear group embedded in the Eisenstein group. -/
def rationalEmbedding : SL(2,ℤ)→*SL(2,O) :=
  Matrix.SpecialLinearGroup.map (Int.castRingHom O)

def levelThreeConjugate (g : SL(2,O)) (M : levelThree) : levelThree :=
  ⟨g*(M:SL(2,O))*g⁻¹,by
    change Matrix.SpecialLinearGroup.map (n:=Fin 2)
      (Ideal.Quotient.mk (Ideal.span {(3:O)})) _=1
    rw [map_mul,map_mul,map_inv,M.property,mul_one,mul_inv_cancel]⟩

lemma levelThree_bottom_primary (M : levelThree) : lambda^2∣(M:SL(2,O)) 1 1-1 :=
  lambda_sq_dvd_three.trans (by simpa using levelThree_entry M 1 1)

lemma value_inverse_formula (M : levelThree) :
    value M⁻¹=symbol ((M:SL(2,O)) 1 0) ((M:SL(2,O)) 1 1) := by
  have hd := levelThree_bottom_primary M
  change symbol (((M:SL(2,O))⁻¹) 1 0) (((M:SL(2,O))⁻¹) 0 0)=_
  simp only [Matrix.SpecialLinearGroup.coe_inv,Matrix.adjugate_fin_two]
  exact symbol_neg_numerator _ _ hd

/-- The determinant relation reads the multiplier from the upper-right and lower-right entries. -/
lemma value_upper_formula (M : levelThree) :
    value M=symbol ((M:SL(2,O)) 0 1) ((M:SL(2,O)) 1 1) := by
  have hd := levelThree_bottom_primary M
  have hdet : (M:SL(2,O)) 0 0*(M:SL(2,O)) 1 1-
      (M:SL(2,O)) 0 1*(M:SL(2,O)) 1 0=1 := by
    simpa only [Matrix.det_fin_two] using (M:SL(2,O)).property
  have hprod : symbol ((M:SL(2,O)) 0 1) ((M:SL(2,O)) 1 1)*
      symbol ((M:SL(2,O)) 1 0) ((M:SL(2,O)) 1 1)=1 := by
    rw [←symbol_mul_numerator _ _ _]
    calc
      _ = symbol (-1) ((M:SL(2,O)) 1 1) := by
        apply symbol_congr
        refine ⟨(M:SL(2,O)) 0 0,?_⟩
        linear_combination -hdet
      _ = 1 := symbol_neg_one _ hd
  have hinv : value M*symbol ((M:SL(2,O)) 1 0) ((M:SL(2,O)) 1 1)=1 := by
    rw [←value_inverse_formula,←value_mul,mul_inv_cancel,value_one]
  calc
    value M = value M*1 := by rw [mul_one]
    _ = value M*(symbol ((M:SL(2,O)) 0 1) ((M:SL(2,O)) 1 1)*
      symbol ((M:SL(2,O)) 1 0) ((M:SL(2,O)) 1 1)) := by rw [hprod]
    _ = symbol ((M:SL(2,O)) 0 1) ((M:SL(2,O)) 1 1)*
      (value M*symbol ((M:SL(2,O)) 1 0) ((M:SL(2,O)) 1 1)) := by ring
    _ = _ := by rw [hinv,mul_one]

theorem value_conjugate_S (M : levelThree) :
    value (levelThreeConjugate (rationalEmbedding ModularGroup.S) M)=value M := by
  rw [value_upper_formula M]
  change symbol (((rationalEmbedding ModularGroup.S)*(M:SL(2,O))*(rationalEmbedding ModularGroup.S)⁻¹) 1 0)
    (((rationalEmbedding ModularGroup.S)*(M:SL(2,O))*(rationalEmbedding ModularGroup.S)⁻¹) 0 0)=_
  simp only [rationalEmbedding,Matrix.SpecialLinearGroup.coe_mul,Matrix.SpecialLinearGroup.map_apply_coe,
    Matrix.SpecialLinearGroup.coe_inv,ModularGroup.coe_S,Matrix.adjugate_fin_two,
    Matrix.mul_apply,Fin.sum_univ_two]
  simpa using symbol_neg_numerator ((M:SL(2,O)) 0 1) ((M:SL(2,O)) 1 1) (levelThree_bottom_primary M)

theorem complexCharacter_conjugate_S (M : levelThree) :
    complexCharacter (levelThreeConjugate (rationalEmbedding ModularGroup.S) M)=complexCharacter M :=
  congrArg ringComplex (value_conjugate_S M)


open CubicRamified
theorem symbol_shift_by_self (c a : O) (ha : lambda^2∣a-1) (hc : (3:O)∣c) :
    symbol c (a+c)=symbol c a := by
  have hA : lambda^2∣a+c-1 := by
    convert dvd_add ha (lambda_sq_dvd_three.trans hc) using 1 ; ring
  calc
    symbol c (a+c)=symbol (-a) (a+c) := by
      apply symbol_congr
      refine ⟨1,?_⟩
      ring
    _ = symbol a (a+c) := symbol_neg_numerator a (a+c) hA
    _ = symbol (a+c) a := symbol_reciprocity a (a+c) ha hA
    _ = symbol c a := by
      apply symbol_congr
      refine ⟨1,?_⟩
      ring

open CubicJacobi CubicRamified
theorem value_conjugate_T (M : levelThree) :
    value (levelThreeConjugate (rationalEmbedding ModularGroup.T) M)=value M := by
  change symbol (((rationalEmbedding ModularGroup.T)*(M:SL(2,O))*(rationalEmbedding ModularGroup.T)⁻¹) 1 0)
    (((rationalEmbedding ModularGroup.T)*(M:SL(2,O))*(rationalEmbedding ModularGroup.T)⁻¹) 0 0)=_
  simp only [rationalEmbedding,Matrix.SpecialLinearGroup.coe_mul,Matrix.SpecialLinearGroup.map_apply_coe,
    Matrix.SpecialLinearGroup.coe_inv,ModularGroup.coe_T,Matrix.adjugate_fin_two,
    Matrix.mul_apply,Fin.sum_univ_two]
  simpa [value] using symbol_shift_by_self ((M:SL(2,O)) 1 0) ((M:SL(2,O)) 0 0)
    (levelThree_primary M) (levelThree_lower M)

lemma levelThreeConjugate_one (M : levelThree) : levelThreeConjugate 1 M=M := by
  apply Subtype.ext
  simp [levelThreeConjugate]

lemma levelThreeConjugate_mul (g h : SL(2,O)) (M : levelThree) :
    levelThreeConjugate (g*h) M=levelThreeConjugate g (levelThreeConjugate h M) := by
  apply Subtype.ext
  simp [levelThreeConjugate,mul_assoc]

def characterConjugationStabilizer : Subgroup (SL(2,O)) where
  carrier g := ∀M : levelThree,value (levelThreeConjugate g M)=value M
  one_mem' M := by rw [levelThreeConjugate_one]
  mul_mem' hg hh M := by rw [levelThreeConjugate_mul,hg,hh]
  inv_mem' {g} hg M := by
    have h := hg (levelThreeConjugate g⁻¹ M)
    rw [←levelThreeConjugate_mul,mul_inv_cancel,levelThreeConjugate_one] at h
    exact h.symm

/-- Invariance under the rational generators extends to every rational matrix. -/
theorem value_conjugate_rational (g : SL(2,ℤ)) (M : levelThree) :
    value (levelThreeConjugate (rationalEmbedding g) M)=value M := by
  have htop : characterConjugationStabilizer.comap rationalEmbedding=⊤ := by
    apply top_unique
    rw [←SpecialLinearGroup.SL2Z_generators]
    apply (Subgroup.closure_le _).mpr
    intro g hg
    rcases hg with (rfl|rfl)
    · exact value_conjugate_S
    · exact value_conjugate_T
  have hg : g∈characterConjugationStabilizer.comap rationalEmbedding := by rw [htop];trivial
  exact hg M

theorem complexCharacter_conjugate_rational (g : SL(2,ℤ)) (M : levelThree) :
    complexCharacter (levelThreeConjugate (rationalEmbedding g) M)=complexCharacter M :=
  congrArg ringComplex (value_conjugate_rational g M)


open CubicRamified
/-- Choose the primary sign of a rational integer away from three. -/
def rationalPrimary (n : ℕ) : O := if n%3=1 then (n:O) else -(n:O)

lemma rationalPrimary_coord (n : ℕ) (hn : ¬3∣n) : ∃A : ℤ,rationalPrimary n=primaryCoord A 0 := by
  have hm : n%3=1 ∨ n%3=2 := by
    have hl := Nat.mod_lt n (by decide : 0<3)
    have h0 : n%3≠0 := fun h => hn (Nat.dvd_of_mod_eq_zero h)
    omega
  rcases hm with hm|hm
  · refine ⟨(n/3:ℕ),?_⟩
    have he : n=1+3*(n/3) := by omega
    rw [rationalPrimary,if_pos hm,primaryCoord_eq]
    conv_lhs => rw [he]
    simp only [Int.cast_natCast,
      Nat.cast_add,Nat.cast_mul,Nat.cast_ofNat,]
    ring
  · refine ⟨-((n/3:ℕ):ℤ)-1,?_⟩
    have he : n=2+3*(n/3) := by omega
    rw [rationalPrimary,if_neg (by omega),primaryCoord_eq]
    conv_lhs => rw [he]
    simp only [Int.cast_sub,Int.cast_neg,Int.cast_natCast,
      Nat.cast_add,Nat.cast_mul,Nat.cast_ofNat,]
    ring

lemma rationalPrimary_primary (n : ℕ) (hn : ¬3∣n) : lambda^2∣rationalPrimary n-1 := by
  obtain ⟨A,hA⟩ := rationalPrimary_coord n hn
  rw [hA]
  exact primaryCoord_primary A 0

lemma rationalPrimary_denominator (x : O) (n : ℕ) : symbol x (rationalPrimary n)=symbol x (n:O) := by
  unfold rationalPrimary
  split_ifs
  · rfl
  · simp only [symbol,Ideal.span_singleton_neg]

lemma rationalPrimary_numerator (m n : ℕ) (hn : ¬3∣n) :
    symbol (rationalPrimary m) (rationalPrimary n)=symbol (m:O) (rationalPrimary n) := by
  change symbol (if m%3=1 then (m:O) else -(m:O)) (rationalPrimary n)=_
  split_ifs
  · rfl
  · exact symbol_neg_numerator _ _ (rationalPrimary_primary n hn)

lemma rational_symbol_mul (a b n : ℕ) :
    symbol ((a*b : ℕ) : O) (n : O) = symbol (a : O) (n : O) * symbol (b : O) (n : O) := by
  rw [Nat.cast_mul]
  exact symbol_mul_numerator _ _ _

lemma rational_symbol_three (n : ℕ) (hn : ¬3∣n) : symbol (3:O) (n:O)=1 := by
  rw [←rationalPrimary_denominator _ n]
  obtain ⟨A,hA⟩ := rationalPrimary_coord n hn
  rw [hA]
  have hprimary := primaryCoord_primary A 0
  have hthree : (3:O)=-((1+2*omega)^2) := by
    have hw : omega^2=-omega-1 := by
      change (IsCyclotomicExtension.zeta_spec 3 ℚ K).toInteger^2=
        -(IsCyclotomicExtension.zeta_spec 3 ℚ K).toInteger-1
      exact IsCyclotomicExtension.Rat.Three.eta_sq (IsCyclotomicExtension.zeta_spec 3 ℚ K)
    linear_combination 4*hw
  have htrace := symbol_traceLambda_eq_linearRay (primaryCoord A 0) hprimary
  change symbol (1+2*omega) (primaryCoord A 0)=_ at htrace
  rw [hthree,symbol_neg_numerator _ _ hprimary,symbol_pow_numerator _ _ hprimary,
    htrace,linearRay_primaryCoord]
  simp

lemma rational_symbol_reciprocity (m n : ℕ) (hm : ¬3∣m) (hn : ¬3∣n) :
    symbol (m:O) (n:O)=symbol (n:O) (m:O) := by
  calc
    _ = symbol (rationalPrimary m) (rationalPrimary n) := by
      rw [rationalPrimary_numerator m n hn,rationalPrimary_denominator]
    _ = symbol (rationalPrimary n) (rationalPrimary m) :=
      symbol_reciprocity _ _ (rationalPrimary_primary m hm) (rationalPrimary_primary n hn)
    _ = _ := by rw [rationalPrimary_numerator n m hm,rationalPrimary_denominator]

lemma rational_symbol_mod (m n : ℕ) : symbol (m:O) (n:O)=symbol ((m%n:ℕ):O) (n:O) := by
  apply symbol_congr
  refine ⟨(m/n:ℕ),?_⟩
  have he : m=m%n+n*(m/n) := (Nat.mod_add_div m n).symm
  have hh : (m:O)=(m%n:ℕ)+ (n:O)*(m/n:ℕ) := by exact_mod_cast he
  linear_combination hh

/-- Euclidean reduction and the supplementary law make coprime rational cubic symbols trivial. -/
theorem rational_symbol_eq_one (n : ℕ) (hn : ¬3∣n) (m : ℕ) (hmn : Nat.Coprime m n) :
    symbol (m:O) (n:O)=1 := by
  induction n using Nat.strong_induction_on generalizing m with
  | h n ih =>
    by_cases hn1 : n=1
    · subst n
      simpa only [Nat.cast_one] using symbol_one (m:O)
    have hn0 : 0<n := Nat.pos_of_ne_zero (fun h => hn (by rw [h];exact dvd_zero 3))
    have hsmall : ∀r : ℕ,r<n → Nat.Coprime r n → symbol (r:O) (n:O)=1 := by
      intro r
      induction r using Nat.strong_induction_on with
      | h r ihr =>
        intro hrn hcop
        by_cases hr0 : r=0
        · subst r
          have : n=1 := by simpa using hcop
          exact False.elim (hn1 this)
        by_cases hr3 : 3∣r
        · have hquot : r/3<r := Nat.div_lt_self (Nat.pos_of_ne_zero hr0) (by decide)
          have hfactor : r=3*(r/3) := (Nat.mul_div_cancel' hr3).symm
          have hqc : Nat.Coprime (r/3) n := hcop.of_dvd_left (Nat.div_dvd_of_dvd hr3)
          rw [hfactor,rational_symbol_mul _ _ n]
          norm_num only [Nat.cast_ofNat]
          rw [rational_symbol_three n hn,one_mul]
          exact ihr (r/3) hquot (lt_trans hquot hrn) hqc
        · rw [rational_symbol_reciprocity r n hr3 hn]
          exact ih r hrn hr3 n hcop.symm
    rw [rational_symbol_mod]
    apply hsmall (m%n) (Nat.mod_lt m hn0)
    change Nat.gcd (m%n) n=1
    rw [←Nat.gcd_rec n m]
    exact hmn.symm


lemma primary_int_natAbs_not_three (a : ℤ) (ha : lambda^2∣(a:O)-1) : ¬3∣a.natAbs := by
  intro h
  have hInt : (3:ℤ)∣a := Int.natCast_dvd.mpr h
  have hO : (3:O)∣(a:O) := by
    rcases hInt with ⟨b,hb⟩
    refine ⟨(b:O),?_⟩
    simpa only [Int.cast_mul,Int.cast_ofNat] using congrArg (fun z : ℤ => (z:O)) hb
  have hL2 : lambda∣lambda^2 := dvd_pow_self _ (by decide : (2:ℕ)≠0)
  have hLa := (hL2.trans lambda_sq_dvd_three).trans hO
  have hLa1 := hL2.trans ha
  have h1 : lambda∣(1:O) := by
    convert dvd_sub hLa hLa1 using 1 ; ring
  exact lambda_not_dvd_two (h1.trans (one_dvd 2))

/-- Signs do not affect a rational cubic symbol with primary denominator. -/
theorem integer_symbol_eq_one (c a : ℤ) (ha : lambda^2∣(a:O)-1)
    (hcop : Nat.Coprime c.natAbs a.natAbs) : symbol (c:O) (a:O)=1 := by
  have hnum : symbol (c:O) (a:O)=symbol (c.natAbs:O) (a:O) := by
    rcases Int.natAbs_eq c with h|h
    · have he : (c:O)=(c.natAbs:O) := by
        simpa only [Int.cast_natCast] using congrArg (fun z : ℤ => (z:O)) h
      exact congrArg (fun z : O => symbol z (a:O)) he
    · have he : (c:O)=-(c.natAbs:O) := by
        simpa only [Int.cast_neg,Int.cast_natCast] using congrArg (fun z : ℤ => (z:O)) h
      exact (congrArg (fun z : O => symbol z (a:O)) he).trans
        (symbol_neg_numerator _ _ ha)
  rw [hnum]
  have hden : symbol (c.natAbs:O) (a:O)=symbol (c.natAbs:O) (a.natAbs:O) := by
    rcases Int.natAbs_eq a with h|h
    · have he : (a:O)=(a.natAbs:O) := by
        simpa only [Int.cast_natCast] using congrArg (fun z : ℤ => (z:O)) h
      exact congrArg (symbol (c.natAbs:O)) he
    · have he : (a:O)=-(a.natAbs:O) := by
        simpa only [Int.cast_neg,Int.cast_natCast] using congrArg (fun z : ℤ => (z:O)) h
      rw [he]
      simp only [symbol,Ideal.span_singleton_neg]
  rw [hden]
  exact rational_symbol_eq_one a.natAbs (primary_int_natAbs_not_three a ha) c.natAbs hcop

open CubicJacobi CubicRamified
theorem value_rational_intersection (g : SL(2,ℤ)) (hg : rationalEmbedding g∈levelThree) :
    value ⟨rationalEmbedding g,hg⟩=1 := by
  have hdet : g 0 0*g 1 1-g 0 1*g 1 0=1 := by
    simpa only [Matrix.det_fin_two] using g.property
  have hcop : IsCoprime (g 1 0) (g 0 0) := by
    refine ⟨-(g 0 1),g 1 1,?_⟩
    linear_combination hdet
  have hp := levelThree_primary ⟨rationalEmbedding g,hg⟩
  change lambda^2∣((g 0 0:ℤ):O)-1 at hp
  change symbol ((g 1 0:ℤ):O) ((g 0 0:ℤ):O)=1
  exact integer_symbol_eq_one (g 1 0) (g 0 0) hp (Int.isCoprime_iff_nat_coprime.mp hcop)

theorem complexCharacter_rational_intersection (g : SL(2,ℤ)) (hg : rationalEmbedding g∈levelThree) :
    complexCharacter ⟨rationalEmbedding g,hg⟩=1 := by
  change ringComplex (value ⟨rationalEmbedding g,hg⟩)=1
  rw [value_rational_intersection g hg,map_one]

/-- The product subgroup `Γ(3) · SL₂(ℤ)`. -/
def rationalExtension : Subgroup (SL(2,O)) where
  carrier g := ∃n : levelThree,∃r : SL(2,ℤ),(n:SL(2,O))*rationalEmbedding r=g
  one_mem' := ⟨1,1,by simp⟩
  mul_mem' := by
    rintro g h ⟨n,r,rfl⟩ ⟨m,s,rfl⟩
    refine ⟨n*levelThreeConjugate (rationalEmbedding r) m,r*s,?_⟩
    simp [levelThreeConjugate,map_mul,mul_assoc]
  inv_mem' := by
    rintro g ⟨n,r,rfl⟩
    refine ⟨levelThreeConjugate (rationalEmbedding r⁻¹) n⁻¹,r⁻¹,?_⟩
    simp [levelThreeConjugate,map_inv,mul_assoc]

lemma levelThree_le_rationalExtension : levelThree≤rationalExtension := by
  intro g hg
  exact ⟨⟨g,hg⟩,1,by simp⟩

lemma rational_mem_rationalExtension (r : SL(2,ℤ)) : rationalEmbedding r∈rationalExtension :=
  ⟨1,r,by simp⟩

lemma rationalExtension_eq_sup : rationalExtension=levelThree⊔rationalEmbedding.range := by
  apply le_antisymm
  · rintro g ⟨n,r,rfl⟩
    exact Subgroup.mul_mem _
      ((show levelThree≤levelThree⊔rationalEmbedding.range from le_sup_left) n.property)
      ((show rationalEmbedding.range≤levelThree⊔rationalEmbedding.range from le_sup_right) ⟨r,rfl⟩)
  · apply sup_le levelThree_le_rationalExtension
    rintro g ⟨r,rfl⟩
    exact rational_mem_rationalExtension r

/-- Triviality on the rational intersection makes the extension independent of decomposition. -/
lemma complexCharacter_product_well_defined (n m : levelThree) (r s : SL(2,ℤ))
    (h : (n:SL(2,O))*rationalEmbedding r=(m:SL(2,O))*rationalEmbedding s) :
    complexCharacter n=complexCharacter m := by
  have he : ((m⁻¹*n:levelThree):SL(2,O))=rationalEmbedding (s*r⁻¹) := by
    have hh := congrArg (fun g : SL(2,O)=>(m:SL(2,O))⁻¹*g*(rationalEmbedding r)⁻¹) h
    simpa [map_mul,map_inv,mul_assoc] using hh
  have hm : rationalEmbedding (s*r⁻¹)∈levelThree := he ▸ (m⁻¹*n).property
  have hv : complexCharacter (m⁻¹*n)=1 := by
    have he' : (m⁻¹*n:levelThree)=⟨rationalEmbedding (s*r⁻¹),hm⟩ := Subtype.ext he
    rw [he']
    exact complexCharacter_rational_intersection (s*r⁻¹) hm
  calc
    complexCharacter n=complexCharacter (m*(m⁻¹*n)) := by rw [mul_inv_cancel_left]
    _ = complexCharacter m*complexCharacter (m⁻¹*n) := map_mul _ _ _
    _ = complexCharacter m := by rw [hv,mul_one]

def rationalExtensionLeft (g : rationalExtension) : levelThree := g.property.choose

def rationalExtensionRight (g : rationalExtension) : SL(2,ℤ) := g.property.choose_spec.choose

lemma rationalExtension_product (g : rationalExtension) :
    (rationalExtensionLeft g:SL(2,O))*rationalEmbedding (rationalExtensionRight g)=(g:SL(2,O)) :=
  g.property.choose_spec.choose_spec

def rationalExtensionValue (g : rationalExtension) : ℂ := complexCharacter (rationalExtensionLeft g)

lemma rationalExtensionValue_of_product (g : rationalExtension) (n : levelThree) (r : SL(2,ℤ))
    (h : (n:SL(2,O))*rationalEmbedding r=(g:SL(2,O))) : rationalExtensionValue g=complexCharacter n :=
  complexCharacter_product_well_defined (rationalExtensionLeft g) n (rationalExtensionRight g) r
    ((rationalExtension_product g).trans h.symm)

/-- The extended cubic character, trivial on rational matrices. -/
def extendedComplexCharacter : rationalExtension→*ℂ where
  toFun := rationalExtensionValue
  map_one' := by
    rw [rationalExtensionValue_of_product 1 1 1 (by simp),map_one]
  map_mul' g h := by
    have hp :
        ((rationalExtensionLeft g*levelThreeConjugate (rationalEmbedding (rationalExtensionRight g)) (rationalExtensionLeft h):levelThree):SL(2,O))*
          rationalEmbedding (rationalExtensionRight g*rationalExtensionRight h)=((g*h:rationalExtension):SL(2,O)) := by
      simp only [Subgroup.coe_mul,levelThreeConjugate,map_mul]
      simp only [mul_assoc,inv_mul_cancel_left]
      rw [←rationalExtension_product g,←rationalExtension_product h]
      group
    rw [rationalExtensionValue_of_product (g*h) _ _ hp,map_mul,complexCharacter_conjugate_rational]
    rfl

lemma extendedComplexCharacter_restrict (n : levelThree) :
    extendedComplexCharacter ⟨(n:SL(2,O)),levelThree_le_rationalExtension n.property⟩=complexCharacter n := by
  exact rationalExtensionValue_of_product _ n 1 (by simp)

lemma extendedComplexCharacter_rational (r : SL(2,ℤ)) :
    extendedComplexCharacter ⟨rationalEmbedding r,rational_mem_rationalExtension r⟩=1 := by
  exact (rationalExtensionValue_of_product _ 1 r (by simp)).trans (map_one _)

lemma extendedComplexCharacter_cube (g : rationalExtension) : extendedComplexCharacter g^3=1 :=
  complexCharacter_cube (rationalExtensionLeft g)

lemma norm_extendedComplexCharacter (g : rationalExtension) : ‖extendedComplexCharacter g‖=1 :=
  norm_complexCharacter (rationalExtensionLeft g)

/-- The rational extension normalizes the integral metaplectic kernel. -/
theorem globalKubotaKernel_conjugate (g : rationalExtension) (k : SL(2,O))
    (hk : k∈globalKubotaKernel) :
    (g:SL(2,O))*k*(g:SL(2,O))⁻¹∈globalKubotaKernel := by
  obtain ⟨hk3,hkv⟩ := (globalKubotaKernel_mem k).mp hk
  let n : levelThree := ⟨k,hk3⟩
  let n2 : rationalExtension := ⟨k,levelThree_le_rationalExtension hk3⟩
  let cn := levelThreeConjugate (g:SL(2,O)) n
  refine (globalKubotaKernel_mem _).mpr ⟨cn.property,?_⟩
  change complexCharacter cn=1
  rw [←extendedComplexCharacter_restrict cn]
  have he : (⟨(cn:SL(2,O)),levelThree_le_rationalExtension cn.property⟩:rationalExtension)=g*n2*g⁻¹ :=
    Subtype.ext rfl
  rw [he,map_mul,map_mul]
  have hn : extendedComplexCharacter n2=1 :=
    (extendedComplexCharacter_restrict n).trans hkv
  rw [hn,mul_one,←map_mul,mul_inv_cancel,map_one]

end RationalSource

open RationalSource

/-- The level-three subgroup inside its rational extension. -/
def levelThreeInRationalExtension : Subgroup rationalExtension :=
  levelThree.comap rationalExtension.subtype

instance levelThreeInRationalExtension_normal : levelThreeInRationalExtension.Normal where
  conj_mem n hn g := (levelThreeConjugate (g : SL(2, O)) ⟨(n : SL(2, O)), hn⟩).property

instance levelThreeInRationalExtension_finiteIndex : levelThreeInRationalExtension.FiniteIndex := by
  letI : levelThree.FiniteIndex := levelThree_finiteIndex
  change (levelThree.subgroupOf rationalExtension).FiniteIndex
  infer_instance

def rationalSourceLift : SL(2, ℤ) →* rationalExtension where
  toFun r := ⟨rationalEmbedding r, rational_mem_rationalExtension r⟩
  map_one' := Subtype.ext (map_one _)
  map_mul' _ _ := Subtype.ext (map_mul _ _ _)

def rationalSourceQuotient : SL(2, ℤ) →* (rationalExtension ⧸ levelThreeInRationalExtension) :=
  (QuotientGroup.mk' levelThreeInRationalExtension).comp rationalSourceLift

lemma rationalSourceQuotient_surjective : Function.Surjective rationalSourceQuotient := by
  intro q
  obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective levelThreeInRationalExtension q
  obtain ⟨n, r, hr⟩ := g.property
  refine ⟨r, ?_⟩
  let n' : rationalExtension := ⟨(n : SL(2, O)), levelThree_le_rationalExtension n.property⟩
  have hg : g = n' * rationalSourceLift r := Subtype.ext hr.symm
  have hn : QuotientGroup.mk' levelThreeInRationalExtension n' = 1 :=
    (QuotientGroup.eq_one_iff n').mpr n.property
  change QuotientGroup.mk' levelThreeInRationalExtension (rationalSourceLift r) = _
  rw [hg, map_mul, hn, one_mul]

instance rationalSourceQuotientFintype : Fintype (rationalExtension ⧸ levelThreeInRationalExtension) :=
  Fintype.ofFinite _

/-- Every source coset has a rational representative, on which the character is trivial. -/
def rationalSourceSection (q : rationalExtension ⧸ levelThreeInRationalExtension) : SL(2, ℤ) :=
  (rationalSourceQuotient_surjective q).choose

lemma rationalSourceSection_spec (q : rationalExtension ⧸ levelThreeInRationalExtension) :
    rationalSourceQuotient (rationalSourceSection q) = q :=
  (rationalSourceQuotient_surjective q).choose_spec

lemma extendedComplexCharacter_sourceLift (r : SL(2, ℤ)) :
    extendedComplexCharacter (rationalSourceLift r) = 1 := extendedComplexCharacter_rational r

/-- Normalized finite averaging transfers the cubic character to the rational extension. -/
def rationalSourceProjection (f : HyperbolicSpace → ℂ) (w : HyperbolicSpace) : ℂ :=
  (Fintype.card (rationalExtension ⧸ levelThreeInRationalExtension) : ℂ)⁻¹ *
    ∑ q : rationalExtension ⧸ levelThreeInRationalExtension,
      f (integralComplexMatrix (rationalEmbedding (rationalSourceSection q)) • w)

lemma rationalSourceSection_translate (f : HyperbolicSpace → ℂ)
    (hf : ∀ n : levelThree, ∀ w, f (complexMatrix n • w) = complexCharacter n * f w)
    (q : rationalExtension ⧸ levelThreeInRationalExtension) (g : rationalExtension) (w : HyperbolicSpace) :
    f (integralComplexMatrix (rationalEmbedding (rationalSourceSection q)) •
      (integralComplexMatrix (g : SL(2, O)) • w)) = extendedComplexCharacter g *
      f (integralComplexMatrix (rationalEmbedding (rationalSourceSection
        (q * QuotientGroup.mk' levelThreeInRationalExtension g))) • w) := by
  let r := rationalSourceSection q
  let s := rationalSourceSection (q * QuotientGroup.mk' levelThreeInRationalExtension g)
  let m : rationalExtension := rationalSourceLift r * g * (rationalSourceLift s)⁻¹
  have hm : m ∈ levelThreeInRationalExtension := by
    apply (QuotientGroup.eq_one_iff (N := levelThreeInRationalExtension) m).mp
    change QuotientGroup.mk' levelThreeInRationalExtension
      (rationalSourceLift r * g * (rationalSourceLift s)⁻¹) = 1
    rw [map_mul, map_mul, map_inv]
    change rationalSourceQuotient r * QuotientGroup.mk' levelThreeInRationalExtension g *
      (rationalSourceQuotient s)⁻¹ = 1
    rw [rationalSourceSection_spec, rationalSourceSection_spec, mul_inv_cancel]
  let n : levelThree := ⟨(m : SL(2, O)), hm⟩
  have hchar : complexCharacter n = extendedComplexCharacter g := by
    rw [← extendedComplexCharacter_restrict n]
    change extendedComplexCharacter (rationalSourceLift r * g * (rationalSourceLift s)⁻¹) = _
    rw [map_mul, map_mul, ← map_inv rationalSourceLift,
      extendedComplexCharacter_sourceLift, extendedComplexCharacter_sourceLift, one_mul, mul_one]
  have he : rationalEmbedding r * (g : SL(2, O)) = (n : SL(2, O)) * rationalEmbedding s := by
    change _ = (rationalEmbedding r * (g : SL(2, O)) * (rationalEmbedding s)⁻¹) * rationalEmbedding s
    group
  change f (integralComplexMatrix (rationalEmbedding r) •
    (integralComplexMatrix (g : SL(2, O)) • w)) =
      extendedComplexCharacter g * f (integralComplexMatrix (rationalEmbedding s) • w)
  rw [← mul_smul, ← map_mul, he, map_mul, integralComplexMatrix_levelThree, mul_smul, hf, hchar]

theorem rationalSourceProjection_automorphy (f : HyperbolicSpace → ℂ)
    (hf : ∀ n : levelThree, ∀ w, f (complexMatrix n • w) = complexCharacter n * f w)
    (g : rationalExtension) (w : HyperbolicSpace) :
    rationalSourceProjection f (integralComplexMatrix (g : SL(2, O)) • w) =
      extendedComplexCharacter g * rationalSourceProjection f w := by
  unfold rationalSourceProjection
  simp_rw [rationalSourceSection_translate f hf]
  rw [← Finset.mul_sum]
  rw [Function.Bijective.sum_comp
    (Group.mulRight_bijective (QuotientGroup.mk' levelThreeInRationalExtension g))
    (fun q => f (integralComplexMatrix (rationalEmbedding (rationalSourceSection q)) • w))]
  ring

lemma rationalSourceProjection_fixed (f : HyperbolicSpace → ℂ)
    (hf : ∀ g : rationalExtension, ∀ w,
      f (integralComplexMatrix (g : SL(2, O)) • w) = extendedComplexCharacter g * f w)
    (w : HyperbolicSpace) : rationalSourceProjection f w = f w := by
  have he (q : rationalExtension ⧸ levelThreeInRationalExtension) :
      f (integralComplexMatrix (rationalEmbedding (rationalSourceSection q)) • w) = f w := by
    have h := hf (rationalSourceLift (rationalSourceSection q)) w
    rw [extendedComplexCharacter_sourceLift, one_mul] at h
    exact h
  have hc : (Fintype.card (rationalExtension ⧸ levelThreeInRationalExtension) : ℂ) ≠ 0 :=
    Nat.cast_ne_zero.mpr Fintype.card_ne_zero
  simp only [rationalSourceProjection, he, Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
  exact inv_mul_cancel_left₀ hc _

lemma rationalSourceProjection_idempotent (f : HyperbolicSpace → ℂ)
    (hf : ∀ n : levelThree, ∀ w, f (complexMatrix n • w) = complexCharacter n * f w) :
    rationalSourceProjection (rationalSourceProjection f) = rationalSourceProjection f := by
  funext w
  exact rationalSourceProjection_fixed _ (rationalSourceProjection_automorphy f hf) w

lemma rationalSourceProjection_continuous (f : HyperbolicSpace → ℂ) (hf : Continuous f) :
    Continuous (rationalSourceProjection f) := by
  apply continuous_const.mul
  apply continuous_finsetSum
  intro q hq
  exact hf.comp (continuous_hyperbolic_action _)

/-- The residual vector projected to the rational extension of the cubic group. -/
def cubicSourceResidualFunction : HyperbolicSpace → ℂ := rationalSourceProjection cubicResidualFunction

lemma cubicSourceResidualFunction_continuous : Continuous cubicSourceResidualFunction :=
  rationalSourceProjection_continuous _ cubicResidualFunction_continuous

theorem cubicSourceResidualFunction_automorphy (g : rationalExtension) (w : HyperbolicSpace) :
    cubicSourceResidualFunction (integralComplexMatrix (g : SL(2, O)) • w) =
      extendedComplexCharacter g * cubicSourceResidualFunction w :=
  rationalSourceProjection_automorphy _ cubicResidualFunction_automorphy g w

theorem cubicSourceResidualFunction_rational (r : SL(2, ℤ)) (w : HyperbolicSpace) :
    cubicSourceResidualFunction (integralComplexMatrix (rationalEmbedding r) • w) =
      cubicSourceResidualFunction w := by
  have h := cubicSourceResidualFunction_automorphy (rationalSourceLift r) w
  rw [extendedComplexCharacter_sourceLift, one_mul] at h
  exact h

/-- Conjugation by the rational extension preserves the metaplectic kernel. -/
def kernelRationalConjugate (g : rationalExtension) : globalKubotaKernel ≃* globalKubotaKernel where
  toFun n := ⟨(g : SL(2, O)) * (n : SL(2, O)) * (g : SL(2, O))⁻¹,
    globalKubotaKernel_conjugate g n n.property⟩
  invFun n := ⟨(g⁻¹ : rationalExtension) * (n : SL(2, O)) * (g⁻¹ : rationalExtension)⁻¹,
    globalKubotaKernel_conjugate g⁻¹ n n.property⟩
  left_inv n := by apply Subtype.ext; simp only [Subgroup.coe_inv, inv_inv]; group
  right_inv n := by apply Subtype.ext; simp only [Subgroup.coe_inv, inv_inv]; group
  map_mul' n m := by apply Subtype.ext; simp only [Subgroup.coe_mul]; group

lemma rational_action_respects_kernel (g : rationalExtension) (u v : HyperbolicSpace)
    (h : (integralOrbitRel globalKubotaKernel).r u v) :
    (integralOrbitRel globalKubotaKernel).r
      (integralComplexMatrix (g : SL(2, O)) • u) (integralComplexMatrix (g : SL(2, O)) • v) := by
  obtain ⟨n, hn⟩ := h
  refine ⟨kernelRationalConjugate g n, ?_⟩
  change integralComplexMatrix ((g : SL(2, O)) * (n : SL(2, O)) * (g : SL(2, O))⁻¹) •
    (integralComplexMatrix (g : SL(2, O)) • u) = integralComplexMatrix (g : SL(2, O)) • v
  rw [map_mul, map_mul, map_inv, mul_smul, mul_smul, inv_smul_smul, hn]

def kernelRationalAction (g : rationalExtension) : KernelQuotient → KernelQuotient :=
  Quotient.map' (fun w => integralComplexMatrix (g : SL(2, O)) • w) (rational_action_respects_kernel g)

lemma kernelRationalAction_mk (g : rationalExtension) (w : HyperbolicSpace) :
    kernelRationalAction g (integralOrbitProjection globalKubotaKernel w) =
      integralOrbitProjection globalKubotaKernel (integralComplexMatrix (g : SL(2, O)) • w) := rfl

lemma kernelRationalAction_continuous (g : rationalExtension) : Continuous (kernelRationalAction g) :=
  (continuous_hyperbolic_action (integralComplexMatrix (g : SL(2, O)))).quotient_map'
    (rational_action_respects_kernel g)

lemma kernelRationalAction_fundamentalDomain (g : rationalExtension) :
    IsFundamentalDomain globalKubotaKernel
      ((fun w : HyperbolicSpace => integralComplexMatrix (g : SL(2, O)) • w) ''
        hyperbolicFundamentalSet globalKubotaKernel) hyperbolicVolume := by
  apply (hyperbolicFundamentalSet_isFundamentalDomain globalKubotaKernel
    globalKubotaKernel_le_levelThree hyperbolicVolume).image_of_equiv
    (MulAction.toPerm (integralComplexMatrix (g : SL(2, O))))
    (show Measure.QuasiMeasurePreserving (MulAction.toPerm (integralComplexMatrix (g : SL(2, O)))).symm
      hyperbolicVolume hyperbolicVolume from
      (measurePreserving_smul (integralComplexMatrix (g : SL(2, O)))⁻¹ hyperbolicVolume).quasiMeasurePreserving)
    (kernelRationalConjugate g⁻¹).toEquiv
  intro n w
  change integralComplexMatrix (g : SL(2, O)) •
    (integralComplexMatrix ((g⁻¹ : rationalExtension) * (n : SL(2, O)) * (g⁻¹ : rationalExtension)⁻¹) • w) =
      integralComplexMatrix (n : SL(2, O)) • (integralComplexMatrix (g : SL(2, O)) • w)
  simp only [Subgroup.coe_inv, map_mul, map_inv, inv_inv, mul_smul, smul_inv_smul]

/-- The finite rational action preserves quotient volume, hence its pullback is an isometry. -/
lemma kernelRationalAction_measurePreserving (g : rationalExtension) :
    MeasurePreserving (kernelRationalAction g) (integralQuotientVolume globalKubotaKernel)
      (integralQuotientVolume globalKubotaKernel) := by
  refine ⟨(kernelRationalAction_continuous g).measurable, ?_⟩
  let act : HyperbolicSpace → HyperbolicSpace := fun w => integralComplexMatrix (g : SL(2, O)) • w
  have hmap := (measurePreserving_smul (integralComplexMatrix (g : SL(2, O))) hyperbolicVolume).restrict_image_emb
    (measurableEmbedding_const_smul _) (hyperbolicFundamentalSet globalKubotaKernel)
  have heq : kernelRationalAction g ∘ integralOrbitProjection globalKubotaKernel =
      integralOrbitProjection globalKubotaKernel ∘ act := rfl
  change Measure.map (kernelRationalAction g)
    (Measure.map (integralOrbitProjection globalKubotaKernel)
      (hyperbolicVolume.restrict (hyperbolicFundamentalSet globalKubotaKernel))) = _
  rw [Measure.map_map (kernelRationalAction_continuous g).measurable
    (measurable_integralOrbitProjection _), heq,
    ← Measure.map_map (measurable_integralOrbitProjection _) (continuous_hyperbolic_action _).measurable]
  change Measure.map (integralOrbitProjection globalKubotaKernel)
    (Measure.map act (hyperbolicVolume.restrict (hyperbolicFundamentalSet globalKubotaKernel))) = _
  rw [hmap.map_eq]
  exact integralQuotientVolume_independent globalKubotaKernel globalKubotaKernel_le_levelThree _
    (kernelRationalAction_fundamentalDomain g)

def kernelRationalPullback (g : rationalExtension) : KernelQuotientL2 →ₗᵢ[ℂ] KernelQuotientL2 :=
  Lp.compMeasurePreservingₗᵢ ℂ (kernelRationalAction g) (kernelRationalAction_measurePreserving g)

lemma kernelRationalPullback_ae (g : rationalExtension) (F : KernelQuotientL2) :
    kernelRationalPullback g F =ᵐ[integralQuotientVolume globalKubotaKernel]
      fun q => F (kernelRationalAction g q) :=
  Lp.coeFn_compMeasurePreserving F (kernelRationalAction_measurePreserving g)

/-- The same rational average on the actual quotient Hilbert space. -/
def kernelRationalSourceProjection : KernelQuotientL2 →L[ℂ] KernelQuotientL2 :=
  (Fintype.card (rationalExtension ⧸ levelThreeInRationalExtension) : ℂ)⁻¹ •
    ∑ q : rationalExtension ⧸ levelThreeInRationalExtension,
      (kernelRationalPullback (rationalSourceLift (rationalSourceSection q))).toContinuousLinearMap

lemma kernelRationalSourceProjection_apply (F : KernelQuotientL2) :
    kernelRationalSourceProjection F =
      (Fintype.card (rationalExtension ⧸ levelThreeInRationalExtension) : ℂ)⁻¹ •
        ∑ q : rationalExtension ⧸ levelThreeInRationalExtension,
          kernelRationalPullback (rationalSourceLift (rationalSourceSection q)) F := by
  simp only [kernelRationalSourceProjection, smul_apply, _root_.sum_apply]
  rfl

lemma kernelRationalSourceProjection_ae (F : KernelQuotientL2) :
    kernelRationalSourceProjection F =ᵐ[integralQuotientVolume globalKubotaKernel]
      fun x => (Fintype.card (rationalExtension ⧸ levelThreeInRationalExtension) : ℂ)⁻¹ *
        ∑ q : rationalExtension ⧸ levelThreeInRationalExtension,
          F (kernelRationalAction (rationalSourceLift (rationalSourceSection q)) x) := by
  let c : ℂ := (Fintype.card (rationalExtension ⧸ levelThreeInRationalExtension) : ℂ)⁻¹
  let A (q : rationalExtension ⧸ levelThreeInRationalExtension) : KernelQuotientL2 :=
    kernelRationalPullback (rationalSourceLift (rationalSourceSection q)) F
  have he : kernelRationalSourceProjection F = c • ∑ q, A q := kernelRationalSourceProjection_apply F
  rw [he]
  have hall := ae_all_iff.mpr (fun q => kernelRationalPullback_ae
    (rationalSourceLift (rationalSourceSection q)) F)
  filter_upwards [Lp.coeFn_smul c (∑ q, A q), Lp.coeFn_fun_finsetSum Finset.univ A, hall] with x hc hs hx
  rw [hc, Pi.smul_apply, smul_eq_mul, hs]
  change c * ∑ q, A q x = _
  congr 1
  exact Finset.sum_congr rfl (fun q _ => hx q)

lemma rationalSourceProjection_congr_ae (f g : HyperbolicSpace → ℂ)
    (h : f =ᵐ[hyperbolicVolume] g) :
    rationalSourceProjection f =ᵐ[hyperbolicVolume] rationalSourceProjection g := by
  have hall := ae_all_iff.mpr (fun q : rationalExtension ⧸ levelThreeInRationalExtension =>
    (measurePreserving_smul (integralComplexMatrix (rationalEmbedding (rationalSourceSection q)))
      hyperbolicVolume).quasiMeasurePreserving.ae_eq_comp h)
  filter_upwards [hall] with w hw
  unfold rationalSourceProjection
  congr 1
  exact Finset.sum_congr rfl (fun q _ => hw q)

lemma kernelRationalSourceProjection_representative (F : KernelQuotientL2) (f : HyperbolicSpace → ℂ)
    (hf : (fun w => F (integralOrbitProjection globalKubotaKernel w)) =ᵐ[hyperbolicVolume] f) :
    (fun w => kernelRationalSourceProjection F (integralOrbitProjection globalKubotaKernel w))
      =ᵐ[hyperbolicVolume] rationalSourceProjection f := by
  have he := kernelProjection_quasiMeasurePreserving.ae_eq_comp (kernelRationalSourceProjection_ae F)
  change (fun w => kernelRationalSourceProjection F (integralOrbitProjection globalKubotaKernel w))
    =ᵐ[hyperbolicVolume] rationalSourceProjection (fun w => F (integralOrbitProjection globalKubotaKernel w)) at he
  exact he.trans (rationalSourceProjection_congr_ae _ _ hf)

theorem cubicSourceResidualFunction_represents_projection :
    (fun w => kernelRationalSourceProjection cubicEisensteinResidue
      (integralOrbitProjection globalKubotaKernel w)) =ᵐ[hyperbolicVolume] cubicSourceResidualFunction :=
  kernelRationalSourceProjection_representative _ _ cubicEisensteinResidue_continuous_representative

/-- Finite averaging of isometries is a contraction on the actual quotient space. -/
theorem kernelRationalSourceProjection_norm_le (F : KernelQuotientL2) :
    ‖kernelRationalSourceProjection F‖ ≤ ‖F‖ := by
  have hc : 0 < (Fintype.card (rationalExtension ⧸ levelThreeInRationalExtension) : ℝ) :=
    Nat.cast_pos.mpr Fintype.card_pos
  rw [kernelRationalSourceProjection_apply, norm_smul, norm_inv, Complex.norm_natCast]
  calc
    _ ≤ (Fintype.card (rationalExtension ⧸ levelThreeInRationalExtension) : ℝ)⁻¹ *
        ∑ q : rationalExtension ⧸ levelThreeInRationalExtension,
          ‖kernelRationalPullback (rationalSourceLift (rationalSourceSection q)) F‖ :=
      mul_le_mul_of_nonneg_left (norm_sum_le _ _) (inv_nonneg.mpr hc.le)
    _ = ‖F‖ := by
      simp only [LinearIsometry.norm_map, Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
      exact inv_mul_cancel_left₀ hc.ne' _

/-- Rational upper translations act on the actual cusp rows by conjugation. -/
def rationalUnipotent (t : ℤ) : SL(2, ℤ) := ⟨!![1, t; 0, 1], by simp [Matrix.det_fin_two]⟩

lemma rationalUnipotent_neg (t : ℤ) : rationalUnipotent (-t) = (rationalUnipotent t)⁻¹ := by
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  fin_cases i <;> fin_cases j <;>
    simp [rationalUnipotent, Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]

lemma rationalUnipotent_embedding (t : ℤ) :
    (rationalEmbedding (rationalUnipotent t) : Matrix (Fin 2) (Fin 2) O) = !![1, (t : O); 0, 1] := by
  apply Matrix.ext
  intro i j
  change (Int.castRingHom O) ((!![1, t; 0, 1] : Matrix (Fin 2) (Fin 2) ℤ) i j) = _
  fin_cases i <;> fin_cases j <;> simp

lemma row_unipotent_conjugate (t : ℤ) (M : levelThree) :
    row (levelThreeConjugate (rationalEmbedding (rationalUnipotent (-t))) M) =
      Matrix.vecMul (row M) (rationalEmbedding (rationalUnipotent t) : SL(2, O)) := by
  change ((rationalEmbedding (rationalUnipotent (-t)) * (M : SL(2, O)) *
      (rationalEmbedding (rationalUnipotent (-t)))⁻¹ : SL(2, O)) : Matrix (Fin 2) (Fin 2) O) 1 = _
  simp only [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_inv,
    rationalUnipotent_embedding, Matrix.adjugate_fin_two]
  funext j
  fin_cases j <;> simp [row, Matrix.mul_apply, Matrix.vecMul, dotProduct, Fin.sum_univ_two]

def cuspUnipotentTranslate (t : ℤ) : CuspCosets → CuspCosets :=
  Quotient.map (fun M => levelThreeConjugate (rationalEmbedding (rationalUnipotent (-t))) M) (by
    intro M N h
    change row (levelThreeConjugate _ M) = row (levelThreeConjugate _ N)
    rw [row_unipotent_conjugate, row_unipotent_conjugate, show row M = row N from h])

lemma cuspUnipotentTranslate_inverse (t : ℤ) (x : CuspCosets) :
    cuspUnipotentTranslate (-t) (cuspUnipotentTranslate t x) = x := by
  induction x using Quotient.inductionOn with
  | _ M =>
    change cosetOf (levelThreeConjugate (rationalEmbedding (rationalUnipotent (- -t)))
      (levelThreeConjugate (rationalEmbedding (rationalUnipotent (-t))) M)) = cosetOf M
    rw [neg_neg, rationalUnipotent_neg, map_inv, ← levelThreeConjugate_mul,
      mul_inv_cancel, levelThreeConjugate_one]

def cuspUnipotentEquiv (t : ℤ) : CuspCosets ≃ CuspCosets where
  toFun := cuspUnipotentTranslate t
  invFun := cuspUnipotentTranslate (-t)
  left_inv := cuspUnipotentTranslate_inverse t
  right_inv x := by simpa only [neg_neg] using cuspUnipotentTranslate_inverse (-t) x

lemma cosetRow_cuspUnipotentEquiv (t : ℤ) (x : CuspCosets) :
    cosetRow (cuspUnipotentEquiv t x) =
      Matrix.vecMul (cosetRow x) (rationalEmbedding (rationalUnipotent t) : SL(2, O)) := by
  induction x using Quotient.inductionOn with
  | _ M => exact row_unipotent_conjugate t M

lemma cosetCharacter_cuspUnipotentEquiv (t : ℤ) (x : CuspCosets) :
    cosetCharacter (cuspUnipotentEquiv t x) = cosetCharacter x := by
  induction x using Quotient.inductionOn with
  | _ M => exact complexCharacter_conjugate_rational (rationalUnipotent (-t)) M

lemma embeddedRow_cuspUnipotentEquiv (t : ℤ) (x : CuspCosets) :
    embeddedRow (cuspUnipotentEquiv t x) = Matrix.vecMul (embeddedRow x)
      (integralComplexMatrix (rationalEmbedding (rationalUnipotent t)) : SL(2, ℂ)) := by
  funext j
  simp only [embeddedRow, Function.comp_def, cosetRow_cuspUnipotentEquiv,
    Matrix.vecMul, dotProduct, map_sum, map_mul]
  rfl

/-- Integral horizontal translation reindexes the series, without a convergence hypothesis. -/
theorem eisenstein_unipotent (t : ℤ) (g : SL(2, ℂ)) (s : ℂ) :
    eisenstein (integralComplexMatrix (rationalEmbedding (rationalUnipotent t)) * g) s = eisenstein g s := by
  have he (x : CuspCosets) :
      summand (integralComplexMatrix (rationalEmbedding (rationalUnipotent t)) * g) s x =
        summand g s (cuspUnipotentEquiv t x) := by
    rw [summand, summand, cosetCharacter_cuspUnipotentEquiv,
      embeddedRow_cuspUnipotentEquiv, ← rowOperator_apply, rowOperator_mul]
  unfold eisenstein
  simp_rw [he]
  exact (cuspUnipotentEquiv t).tsum_eq _

theorem hyperbolicEisenstein_unipotent (t : ℤ) (s : ℂ) (w : HyperbolicSpace) :
    hyperbolicEisenstein s (integralComplexMatrix (rationalEmbedding (rationalUnipotent t)) • w) =
      hyperbolicEisenstein s w := by
  induction w using Quotient.inductionOn with
  | _ g => exact eisenstein_unipotent t g s

/-- The trivial bound counts the invertible residue classes. -/
lemma cubicUnitGaussSum_norm_le (h c : O) (hc : c ≠ 0) (hp : lambda ^ 2 ∣ c - 1) :
    ‖cubicUnitGaussSum h c‖ ≤ (Ideal.absNorm (Ideal.span {c}) : ℝ) := by
  letI : Finite (O ⧸ Ideal.span {c}) := (Ideal.span {c}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr hc)
  letI : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
  letI : Fintype (CubicUnitResidue c) := Fintype.ofFinite _
  have hnorm (r : CubicUnitResidue c) :
      ‖ringComplex (symbol (principalResidueRep c r.1) c) *
        residueAdditive (3 * h) c (principalResidueRep c r.1)‖ = 1 := by
    have hu : IsUnit (Ideal.Quotient.mk (Ideal.span {c}) (principalResidueRep c r.1)) := by
      rw [principalResidueRep_spec]
      exact r.2
    rw [norm_mul, symbol_norm_one _ c hp ((isUnit_quotient_span_iff c _).mp hu).symm]
    simp only [residueAdditive, tracePhase_norm, one_mul]
  rw [cubicUnitGaussSum, tsum_fintype]
  calc
    _ ≤ ∑ r : CubicUnitResidue c,
        ‖ringComplex (symbol (principalResidueRep c r.1) c) *
          residueAdditive (3 * h) c (principalResidueRep c r.1)‖ := norm_sum_le _ _
    _ = (Fintype.card (CubicUnitResidue c) : ℝ) := by simp only [hnorm, Finset.sum_const,
      Finset.card_univ, nsmul_eq_mul, mul_one]
    _ ≤ (Fintype.card (O ⧸ Ideal.span {c}) : ℝ) := by exact_mod_cast Fintype.card_subtype_le (IsUnit : (O ⧸ Ideal.span {c}) → Prop)
    _ = _ := by
      change (Fintype.card (O ⧸ Ideal.span {c}) : ℝ) = (Nat.card (O ⧸ Ideal.span {c}) : ℝ)
      rw [Nat.card_eq_fintype_card]

/-- The unramified Dirichlet series with the normalized trace phase. -/
def unramifiedCubicGaussSeries (s : ℂ) (h : O) : ℂ :=
  ∑' I : GoodIdeal, unramifiedNormWeight s I.1 * cubicUnitGaussSum h (primaryIdealGenerator I.1)

lemma unramifiedNormWeight_mul_norm (s : ℂ) (I : GoodIdeal) :
    ‖unramifiedNormWeight s I.1‖ * (Ideal.absNorm I.1 : ℝ) =
      ‖unramifiedNormWeight (s - 1) I.1‖ := by
  have hn : 0 < ‖ringComplex (primaryIdealGenerator I.1)‖ :=
    norm_pos_iff.mpr (ringComplex_ne_zero I.2)
  rw [norm_unramifiedNormWeight, norm_unramifiedNormWeight,
    ← primaryIdealGenerator_norm_sq I.1 I.2, ← Real.rpow_natCast _ 2,
    ← Real.rpow_add hn]
  congr 1
  simp only [Complex.sub_re, Complex.one_re, Nat.cast_ofNat]
  ring

/-- Absolute convergence holds in the same half-plane as the Eisenstein source. -/
theorem unramifiedCubicGaussSeries_summable_norm (s : ℂ) (hs : 2 < s.re) (h : O) :
    Summable (fun I : GoodIdeal =>
      ‖unramifiedNormWeight s I.1 * cubicUnitGaussSum h (primaryIdealGenerator I.1)‖) := by
  have hsum := (unramifiedNormWeight_summable_norm (s - 1) (by
    simp only [Complex.sub_re, Complex.one_re]; linarith)).subtype
      (fun I : Ideal O => primaryIdealGenerator I ≠ 0)
  apply hsum.of_nonneg_of_le (fun _ => norm_nonneg _)
  intro I
  rw [norm_mul]
  calc
    _ ≤ ‖unramifiedNormWeight s I.1‖ * (Ideal.absNorm I.1 : ℝ) := by
      apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
      have hb := cubicUnitGaussSum_norm_le h (primaryIdealGenerator I.1) I.2
        (primaryIdealGenerator_spec I.1 I.2).2
      simpa only [(primaryIdealGenerator_spec I.1 I.2).1] using hb
    _ = _ := unramifiedNormWeight_mul_norm s I

/-- Cubic frequency factors disappear away from the modulus. -/
theorem cubicUnitGaussSum_cube_shift (h c t : O) (hc : c ≠ 0)
    (hp : lambda ^ 2 ∣ c - 1) (ht : IsCoprime c t) :
    cubicUnitGaussSum (h * t ^ 3) c = cubicUnitGaussSum h c := by
  have he := cubicUnitGaussSum_frequency_twist h c (t ^ 3) hc ht.pow_right
  rw [symbol_pow_numerator t c hp, symbol_cube_of_isCoprime t c hp ht.symm,
    map_one, one_mul] at he
  exact he

/-- CRT on invertible classes, with no choice of compatible representatives. -/
def cubicUnitCRTEquiv (a b : O) (hab : IsCoprime a b) :
    CubicUnitResidue (a * b) ≃ CubicUnitResidue a × CubicUnitResidue b :=
  ((quotientProductEquiv a b hab).toEquiv.subtypeEquiv (fun q => by
    rw [← MulEquiv.isUnit_map (quotientProductEquiv a b hab) (x := q), Prod.isUnit_iff]
    rfl)).trans
      Equiv.subtypeProdEquivProd

lemma cubicUnitCRT_rep_left (a b : O) (hab : IsCoprime a b) (r : CubicUnitResidue (a * b)) :
    a ∣ principalResidueRep (a * b) r.1 - principalResidueRep a (cubicUnitCRTEquiv a b hab r).1.1 := by
  apply Ideal.mem_span_singleton.mp
  apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp
  rw [principalResidueRep_spec]
  exact congrArg (fun x => (quotientProductEquiv a b hab x).1) (principalResidueRep_spec (a * b) r.1)

lemma cubicUnitCRT_rep_right (a b : O) (hab : IsCoprime a b) (r : CubicUnitResidue (a * b)) :
    b ∣ principalResidueRep (a * b) r.1 - principalResidueRep b (cubicUnitCRTEquiv a b hab r).2.1 := by
  apply Ideal.mem_span_singleton.mp
  apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp
  rw [principalResidueRep_spec]
  exact congrArg (fun x => (quotientProductEquiv a b hab x).2) (principalResidueRep_spec (a * b) r.1)

lemma residueAdditive_unit_crt (h a b α β d : O) (ha : a ≠ 0) (hb : b ≠ 0)
    (hbez : α * b + β * a = 1) :
    residueAdditive (3 * h) (a * b) d =
      residueAdditive (3 * (h * α)) a d * residueAdditive (3 * (h * β)) b d := by
  unfold residueAdditive
  rw [← AddChar.map_add_eq_mul]
  congr 1
  have hae := ringComplex_ne_zero ha
  have hbe := ringComplex_ne_zero hb
  have he := congrArg ringComplex hbez
  simp only [map_add, map_mul, map_one] at he
  simp only [cuspFrequency, map_mul, map_ofNat]
  field_simp [hae, hbe, ringComplex_ne_zero traceLambda_ne_zero]
  linear_combination -(ringComplex h * ringComplex d) * he

lemma cubicUnitGaussSum_crt (h a b α β : O) (ha : a ≠ 0) (hb : b ≠ 0)
    (hbez : α * b + β * a = 1) :
    cubicUnitGaussSum h (a * b) = cubicUnitGaussSum (h * α) a * cubicUnitGaussSum (h * β) b := by
  have hab : IsCoprime a b := ⟨β, α, by linear_combination hbez⟩
  letI : Finite (O ⧸ Ideal.span {a}) := (Ideal.span {a}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr ha)
  letI : Finite (O ⧸ Ideal.span {b}) := (Ideal.span {b}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr hb)
  letI : Finite (O ⧸ Ideal.span {a * b}) := (Ideal.span {a * b}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr (mul_ne_zero ha hb))
  letI : Fintype (CubicUnitResidue a) := Fintype.ofFinite _
  letI : Fintype (CubicUnitResidue b) := Fintype.ofFinite _
  letI : Fintype (CubicUnitResidue (a * b)) := Fintype.ofFinite _
  have hpoint (r : CubicUnitResidue (a * b)) :
      ringComplex (symbol (principalResidueRep (a * b) r.1) (a * b)) *
        residueAdditive (3 * h) (a * b) (principalResidueRep (a * b) r.1) =
      (ringComplex (symbol (principalResidueRep a (cubicUnitCRTEquiv a b hab r).1.1) a) *
        residueAdditive (3 * (h * α)) a (principalResidueRep a (cubicUnitCRTEquiv a b hab r).1.1)) *
      (ringComplex (symbol (principalResidueRep b (cubicUnitCRTEquiv a b hab r).2.1) b) *
        residueAdditive (3 * (h * β)) b (principalResidueRep b (cubicUnitCRTEquiv a b hab r).2.1)) := by
    rw [symbol_mul_denominator, map_mul, residueAdditive_unit_crt h a b α β _ ha hb hbez,
      symbol_congr (cubicUnitCRT_rep_left a b hab r), symbol_congr (cubicUnitCRT_rep_right a b hab r),
      residueAdditive_three_congr (h * α) a _ _ ha (cubicUnitCRT_rep_left a b hab r),
      residueAdditive_three_congr (h * β) b _ _ hb (cubicUnitCRT_rep_right a b hab r)]
    ring
  rw [cubicUnitGaussSum, cubicUnitGaussSum, cubicUnitGaussSum]
  calc
    _ = ∑' r : CubicUnitResidue (a * b),
        (ringComplex (symbol (principalResidueRep a (cubicUnitCRTEquiv a b hab r).1.1) a) *
          residueAdditive (3 * (h * α)) a (principalResidueRep a (cubicUnitCRTEquiv a b hab r).1.1)) *
        (ringComplex (symbol (principalResidueRep b (cubicUnitCRTEquiv a b hab r).2.1) b) *
          residueAdditive (3 * (h * β)) b (principalResidueRep b (cubicUnitCRTEquiv a b hab r).2.1)) := tsum_congr hpoint
    _ = ∑' r : CubicUnitResidue a × CubicUnitResidue b,
        (ringComplex (symbol (principalResidueRep a r.1.1) a) *
          residueAdditive (3 * (h * α)) a (principalResidueRep a r.1.1)) *
        (ringComplex (symbol (principalResidueRep b r.2.1) b) *
          residueAdditive (3 * (h * β)) b (principalResidueRep b r.2.1)) :=
      (cubicUnitCRTEquiv a b hab).tsum_eq (fun r : CubicUnitResidue a × CubicUnitResidue b =>
        (ringComplex (symbol (principalResidueRep a r.1.1) a) *
          residueAdditive (3 * (h * α)) a (principalResidueRep a r.1.1)) *
        (ringComplex (symbol (principalResidueRep b r.2.1) b) *
          residueAdditive (3 * (h * β)) b (principalResidueRep b r.2.1)))
    _ = _ := by
      simp only [tsum_fintype, Fintype.sum_prod_type]
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro r hr
      rw [Finset.mul_sum]

/-- Coprime Gauss factors carry exactly the reciprocal cubic-symbol twist. -/
theorem cubicUnitGaussSum_coprime_product (h a b : O) (ha : a ≠ 0) (hb : b ≠ 0)
    (hab : IsCoprime a b) :
    cubicUnitGaussSum h (a * b) =
      ringComplex (symbol b a) * ringComplex (symbol a b) * cubicUnitGaussSum h a * cubicUnitGaussSum h b := by
  obtain ⟨β, α, hbez⟩ := hab
  have hbez' : α * b + β * a = 1 := by linear_combination hbez
  have hab' : IsCoprime a b := ⟨β, α, hbez⟩
  have hleft := cubicUnitGaussSum_frequency_twist (h * α) a b ha hab'
  have hright := cubicUnitGaussSum_frequency_twist (h * β) b a hb hab'.symm
  have hA : a ∣ (h * α) * b - h := ⟨-h * β, by linear_combination h * hbez'⟩
  have hB : b ∣ (h * β) * a - h := ⟨-h * α, by linear_combination h * hbez'⟩
  rw [cubicUnitGaussSum_frequency_congr _ h a ha hA] at hleft
  rw [cubicUnitGaussSum_frequency_congr _ h b hb hB] at hright
  rw [cubicUnitGaussSum_crt h a b α β ha hb hbez', ← hleft, ← hright]
  ring

/-- A reciprocal cubic twist is absorbed by the frequency `9ah`. -/
lemma cubicUnitGaussSum_ramified_twist (h a b : O) (hb : b ≠ 0)
    (hp : lambda ^ 2 ∣ b - 1) (hab : IsCoprime (3 * a) b) :
    ringComplex (symbol a b) * ringComplex (symbol (3 * a) b) * cubicUnitGaussSum h b =
      cubicUnitGaussSum (9 * h * a) b := by
  have ht : IsCoprime b (9 * a) := by
    have h3 := hab.of_mul_left_left
    have ha := hab.of_mul_left_right
    have hn : (9 : O) = 3 * 3 := by norm_num
    rw [hn]
    exact ((h3.mul_left h3).mul_left ha).symm
  have he := cubicUnitGaussSum_frequency_twist h b (9 * a) hb ht
  have hc : ringComplex (symbol a b) * ringComplex (symbol (3 * a) b) *
      ringComplex (symbol (9 * a) b) = 1 := by
    rw [← map_mul, ← map_mul, ← symbol_mul_numerator, ← symbol_mul_numerator]
    rw [show a * (3 * a) * (9 * a) = (3 * a) ^ 3 by ring,
      symbol_pow_numerator _ b hp, symbol_cube_of_isCoprime _ b hp hab, map_one]
  calc
    _ = (ringComplex (symbol a b) * ringComplex (symbol (3 * a) b)) *
        (ringComplex (symbol (9 * a) b) * cubicUnitGaussSum (h * (9 * a)) b) := by rw [he]
    _ = cubicUnitGaussSum (h * (9 * a)) b := by rw [← mul_assoc, hc, one_mul]
    _ = _ := by rw [show h * (9 * a) = 9 * h * a by ring]

/-- The ramified arithmetic factor changes only the unramified frequency. -/
theorem arithmeticResidueSum_ramified_gauss (h : O) (u : Oˣ) (n : ℕ) (hn : 2 ≤ n)
    (b : O) (hb : lambda ^ 2 ∣ b - 1) :
    arithmeticResidueSum h (((u : O) * lambda ^ n) * b) =
      arithmeticResidueSum h ((u : O) * lambda ^ n) *
        cubicUnitGaussSum (9 * h * ((u : O) * lambda ^ n)) b := by
  rw [arithmeticResidueSum_ramified_split h u n hn b hb]
  have he := cubicUnitGaussSum_ramified_twist h ((u : O) * lambda ^ n) b
    (primary_ne_zero b hb) hb (ramified_primary_coprime u n b hb)
  rw [← he]
  ring

lemma ramifiedLower_norm_sq (u : Oˣ) (n : ℕ) (I : GoodIdeal) :
    ‖ringComplex (ramifiedLower u n I)‖ ^ 2 = ((3 ^ (n + 2) * Ideal.absNorm I.1 : ℕ) : ℝ) := by
  rw [ringComplex_norm_sq_eq_absNorm_span]
  unfold ramifiedLower
  rw [← Ideal.span_singleton_mul_span_singleton, map_mul, ramifiedElement_absNorm,
    (primaryIdealGenerator_spec I.1 I.2).1]

lemma arithmeticDirichletTerm_ramified_gauss (s : ℂ) (h : O) (u : Oˣ) (n : ℕ) (I : GoodIdeal) :
    arithmeticDirichletTerm s h (ramifiedLowerMap (u, n, I)).1 =
      (((3 ^ (n + 2) : ℕ) : ℂ) ^ (-s) * arithmeticResidueSum h ((u : O) * lambda ^ (n + 2))) *
        (unramifiedNormWeight s I.1 *
          cubicUnitGaussSum (9 * h * ((u : O) * lambda ^ (n + 2))) (primaryIdealGenerator I.1)) := by
  change arithmeticDirichletTerm s h ⟨ramifiedLower u n I, ramifiedLower_level u n I⟩ = _
  rw [arithmeticDirichletTerm, if_neg (ramifiedLower_ne_zero u n I)]
  have hweight : ((‖ringComplex (ramifiedLower u n I)‖ ^ 2 : ℝ) : ℂ) ^ (-s) =
      ((3 ^ (n + 2) : ℕ) : ℂ) ^ (-s) * unramifiedNormWeight s I.1 := by
    rw [unramifiedNormWeight_of_good s I.1 I.2, ramifiedLower_norm_sq, Complex.ofReal_natCast, Nat.cast_mul]
    exact Complex.natCast_mul_natCast_cpow _ _ _
  dsimp only at *
  rw [hweight]
  dsimp only [ramifiedLower]
  rw [arithmeticResidueSum_ramified_gauss h u (n + 2) (by omega) _ (primaryIdealGenerator_spec I.1 I.2).2]
  ring

/-- Exact finite Gauss-series decomposition of each nonconstant scattering mode. -/
theorem arithmeticDirichletSeries_finite_gauss (s : ℂ) (hs : 2 < s.re) (h : O) (hh : h ≠ 0) :
    arithmeticDirichletSeries s h =
      ∑' u : Oˣ, ∑ n ∈ Finset.range (ramifiedFrequencyBound h + 1),
        (((3 ^ (n + 2) : ℕ) : ℂ) ^ (-s) * arithmeticResidueSum h ((u : O) * lambda ^ (n + 2))) *
          unramifiedCubicGaussSeries s (9 * h * ((u : O) * lambda ^ (n + 2))) := by
  rw [arithmeticDirichletSeries_finite_ramified s hs h hh]
  apply tsum_congr
  intro u
  apply Finset.sum_congr rfl
  intro n hn
  rw [unramifiedCubicGaussSeries, ← tsum_mul_left]
  exact tsum_congr (fun I => arithmeticDirichletTerm_ramified_gauss s h u n I)

/-- Translation by a multiple of the base preserves units modulo every positive power. -/
def cubicUnitPowerShift (p : O) (n : ℕ) (w : O)
    (r : CubicUnitResidue (p ^ (n + 1))) : CubicUnitResidue (p ^ (n + 1)) :=
  ⟨Ideal.Quotient.mk (Ideal.span {p ^ (n + 1)}) (principalResidueRep _ r.1 + p * w), by
    apply (isUnit_quotient_span_iff _ _).mpr
    have hcop : IsCoprime (p ^ (n + 1)) (principalResidueRep _ r.1) := by
      apply (isUnit_quotient_span_iff _ _).mp
      rw [principalResidueRep_spec]
      exact r.2
    obtain ⟨a, b, hab⟩ := hcop
    have hbase : IsCoprime p (principalResidueRep (p ^ (n + 1)) r.1 + p * w) := by
      refine ⟨a * p ^ n - b * w, b, ?_⟩
      linear_combination hab - a * (pow_succ p n)
    exact hbase.pow_left⟩

lemma cubicUnitPowerShift_injective (p : O) (n : ℕ) (w : O) :
    Function.Injective (cubicUnitPowerShift p n w) := by
  intro r t hrt
  apply Subtype.ext
  have he := congrArg Subtype.val hrt
  change Ideal.Quotient.mk (Ideal.span {p ^ (n + 1)}) (principalResidueRep _ r.1 + p * w) =
    Ideal.Quotient.mk (Ideal.span {p ^ (n + 1)}) (principalResidueRep _ t.1 + p * w) at he
  simp only [map_add, principalResidueRep_spec] at he
  exact add_right_cancel he

lemma cubicUnitPowerShift_rep (p : O) (n : ℕ) (w : O) (r : CubicUnitResidue (p ^ (n + 1))) :
    p ^ (n + 1) ∣ principalResidueRep _ (cubicUnitPowerShift p n w r).1 -
      (principalResidueRep _ r.1 + p * w) := by
  apply Ideal.mem_span_singleton.mp
  apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp
  exact principalResidueRep_spec _ _

lemma cubicUnitGaussSum_power_eigen (h p : O) (hp : p ≠ 0) (n : ℕ) (w : O) :
    residueAdditive (3 * h) (p ^ (n + 1)) (p * w) * cubicUnitGaussSum h (p ^ (n + 1)) =
      cubicUnitGaussSum h (p ^ (n + 1)) := by
  letI : Finite (O ⧸ Ideal.span {p ^ (n + 1)}) := (Ideal.span {p ^ (n + 1)}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr (pow_ne_zero _ hp))
  let e : CubicUnitResidue (p ^ (n + 1)) ≃ CubicUnitResidue (p ^ (n + 1)) :=
    Equiv.ofBijective (cubicUnitPowerShift p n w)
      ⟨cubicUnitPowerShift_injective p n w, Finite.surjective_of_injective (cubicUnitPowerShift_injective p n w)⟩
  have hrep (r : CubicUnitResidue (p ^ (n + 1))) :
      p ^ (n + 1) ∣ principalResidueRep _ (e r).1 - (principalResidueRep _ r.1 + p * w) :=
    cubicUnitPowerShift_rep p n w r
  have hs (r : CubicUnitResidue (p ^ (n + 1))) :
      symbol (principalResidueRep _ (e r).1) (p ^ (n + 1)) =
        symbol (principalResidueRep _ r.1) (p ^ (n + 1)) := by
    rw [symbol_congr (hrep r), symbol_pow_denominator, symbol_pow_denominator]
    congr 1
    exact symbol_congr ⟨w, by ring⟩
  unfold cubicUnitGaussSum
  rw [← tsum_mul_left]
  calc
    _ = ∑' r : CubicUnitResidue (p ^ (n + 1)),
        ringComplex (symbol (principalResidueRep _ (e r).1) (p ^ (n + 1))) *
          residueAdditive (3 * h) (p ^ (n + 1)) (principalResidueRep _ (e r).1) := by
      apply tsum_congr
      intro r
      rw [hs, residueAdditive_three_congr h _ _ _ (pow_ne_zero _ hp) (hrep r),
        residueAdditive_add]
      ring
    _ = _ := e.tsum_eq (fun r : CubicUnitResidue (p ^ (n + 1)) =>
      ringComplex (symbol (principalResidueRep _ r.1) (p ^ (n + 1))) *
        residueAdditive (3 * h) (p ^ (n + 1)) (principalResidueRep _ r.1))

/-- A Gauss sum modulo `p^(n+1)` is supported on frequencies divisible by `p^n`. -/
theorem cubicUnitGaussSum_power_support (h p : O) (hp : p ≠ 0) (n : ℕ)
    (hG : cubicUnitGaussSum h (p ^ (n + 1)) ≠ 0) : p ^ n ∣ h := by
  have hp' := ringComplex_ne_zero hp
  have hphase (w : O) : residueAdditive (3 * h) (p ^ (n + 1)) (p * w) = 1 :=
    mul_right_cancel₀ hG ((cubicUnitGaussSum_power_eigen h p hp n w).trans (one_mul _).symm)
  obtain ⟨q, hq⟩ := tracePhase_dual_lattice (ringComplex h / ringComplex (p ^ n)) (by
    intro w
    convert hphase w using 1
    unfold residueAdditive cuspFrequency
    simp only [map_mul, map_pow, map_ofNat, pow_succ]
    congr 1
    field_simp)
  refine ⟨q, ?_⟩
  apply ringComplex_injective
  rw [map_mul, hq]
  field_simp [ringComplex_ne_zero (pow_ne_zero n hp)]

lemma cubicUnitGaussSum_power_vanish (h p : O) (hp : p ≠ 0) (n : ℕ) (hh : ¬ p ^ n ∣ h) :
    cubicUnitGaussSum h (p ^ (n + 1)) = 0 := by
  by_contra hG
  exact hh (cubicUnitGaussSum_power_support h p hp n hG)

lemma residueTraceQuotientChar_mulShift (h c : O) (hc : c ≠ 0) :
    residueTraceQuotientChar h c hc =
      (residueTraceQuotientChar 1 c hc).mulShift (Ideal.Quotient.mk (Ideal.span {c}) h) := by
  ext x
  obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [AddChar.mulShift_apply, ← map_mul, residueTraceQuotientChar_mk, residueTraceQuotientChar_mk]
  unfold residueAdditive cuspFrequency
  simp only [map_mul, map_ofNat, map_one]
  congr 1
  ring

/-- The actual prime cubic character, embedded in the complex numbers. -/
def primeCubicMulChar (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1) :
    MulChar (O ⧸ Ideal.span {p}) ℂ := by
  letI : (Ideal.span {p} : Ideal O).IsMaximal :=
    PrincipalIdealRing.isMaximal_of_irreducible hp.irreducible
  have hg : lambda ∉ (Ideal.span {p} : Ideal O) :=
    primary_maximal_divisor_good p hprimary _ (Ideal.subset_span (by simp))
  exact (cubicChar (Ideal.span {p}) hg).ringHomComp ringComplex

lemma primeCubicMulChar_mk (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1) (d : O) :
    primeCubicMulChar p hp hprimary (Ideal.Quotient.mk (Ideal.span {p}) d) = ringComplex (symbol d p) := by
  letI : (Ideal.span {p} : Ideal O).IsMaximal :=
    PrincipalIdealRing.isMaximal_of_irreducible hp.irreducible
  have hg : lambda ∉ (Ideal.span {p} : Ideal O) :=
    primary_maximal_divisor_good p hprimary _ (Ideal.subset_span (by simp))
  rw [symbol_prime p hp hprimary, primeValue_eq _ hg]
  rfl

/-- The prime Gauss factors use the same geometric trace phase as the scattering series. -/
def primeCubicGauss (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1) (e : ℕ) (h : O) : ℂ :=
  ∑' x : O ⧸ Ideal.span {p}, (primeCubicMulChar p hp hprimary ^ e) x * residueTraceQuotientChar h p hp.ne_zero x

lemma primeCubicGauss_one_eq (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1) (h : O) :
    primeCubicGauss p hp hprimary 1 h = cubicUnitGaussSum h p := by
  let F : (O ⧸ Ideal.span {p}) → ℂ := fun x =>
    primeCubicMulChar p hp hprimary x * residueTraceQuotientChar h p hp.ne_zero x
  have hsup : Function.support F ⊆ {x | IsUnit x} := by
    intro x hx
    by_contra hn
    exact hx (by dsimp [F]; rw [MulChar.map_nonunit _ hn, zero_mul])
  change (∑' x : O ⧸ Ideal.span {p}, (primeCubicMulChar p hp hprimary ^ 1) x *
    residueTraceQuotientChar h p hp.ne_zero x) = _
  rw [pow_one]
  change (∑' x, F x) = _
  rw [← tsum_subtype_eq_of_support_subset hsup, cubicUnitGaussSum]
  apply tsum_congr
  intro x
  have hx := principalResidueRep_spec p x.1
  conv_lhs => rw [← hx]
  change primeCubicMulChar p hp hprimary (Ideal.Quotient.mk _ (principalResidueRep p x.1)) *
    residueTraceQuotientChar h p hp.ne_zero (Ideal.Quotient.mk _ (principalResidueRep p x.1)) = _
  rw [primeCubicMulChar_mk, residueTraceQuotientChar_mk]

/-- Cubing the geometric prime Gauss sum erases every invertible frequency twist. -/
theorem cubicUnitGaussSum_prime_cube (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hph : ¬ p ∣ h) :
    cubicUnitGaussSum h p ^ 3 = -ringComplex p * (Ideal.absNorm (Ideal.span {p}) : ℂ) := by
  letI : (Ideal.span {p} : Ideal O).IsMaximal :=
    PrincipalIdealRing.isMaximal_of_irreducible hp.irreducible
  letI : Field (O ⧸ Ideal.span {p}) := Ideal.Quotient.field _
  letI : Finite (O ⧸ Ideal.span {p}) := (Ideal.span {p}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr hp.ne_zero)
  letI : Fintype (O ⧸ Ideal.span {p}) := Fintype.ofFinite _
  have hg : lambda ∉ (Ideal.span {p} : Ideal O) :=
    primary_maximal_divisor_good p hprimary _ (Ideal.subset_span (by simp))
  have hu : IsUnit (Ideal.Quotient.mk (Ideal.span {p}) h) := by
    apply isUnit_iff_ne_zero.mpr
    intro hz
    exact hph (Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp hz))
  have hshift : residueTraceQuotientChar h p hp.ne_zero =
      (residueTraceQuotientChar 1 p hp.ne_zero).mulShift hu.unit := by
    rw [residueTraceQuotientChar_mulShift, hu.unit_spec]
  have he : cubicUnitGaussSum h p =
      gaussSum ((cubicChar (Ideal.span {p}) hg).ringHomComp ringComplex)
        (residueTraceQuotientChar h p hp.ne_zero) := by
    rw [← primeCubicGauss_one_eq p hp hprimary h]
    simp only [primeCubicGauss, pow_one, tsum_fintype, gaussSum]
    rfl
  rw [he, hshift]
  exact (cubicGauss_cube_mulShift ringComplex (Ideal.span {p}) hg
    (residueTraceQuotientChar 1 p hp.ne_zero) hu.unit).trans
      (cubicGauss_cube ringComplex ringComplex_injective (Ideal.span {p}) hg p rfl hprimary
        (residueTraceQuotientChar 1 p hp.ne_zero) (residueTraceQuotientChar_primitive p hp.ne_zero))

lemma finite_tsum_comp_addHom {R S : Type*} [AddGroup R] [AddGroup S] [Finite R] [Finite S]
    (f : R →+ S) (hf : Function.Surjective f) (F : S → ℂ) :
    (∑' x : R, F (f x)) = (Nat.card f.ker : ℂ) * ∑' y : S, F y := by
  letI : Fintype R := Fintype.ofFinite _
  letI : Fintype S := Fintype.ofFinite _
  letI : Fintype f.ker := Fintype.ofFinite _
  rw [tsum_fintype, tsum_fintype, ← Fintype.sum_fiberwise' f F]
  have hc (y : S) : Fintype.card {x : R // f x = y} = Fintype.card f.ker :=
    Fintype.card_congr (AddMonoidHom.fiberEquivKerOfSurjective hf y)
  simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, hc, Nat.card_eq_fintype_card]
  rw [Finset.mul_sum]

/-- Reduction of a principal modulus to a divisor. -/
def conductorReduction (a b : O) : (O ⧸ Ideal.span {a * b}) →+* (O ⧸ Ideal.span {a}) :=
  Ideal.Quotient.factor (Ideal.span_singleton_le_span_singleton.mpr (dvd_mul_right a b))

lemma conductorReduction_surjective (a b : O) : Function.Surjective (conductorReduction a b) :=
  Ideal.Quotient.factor_surjective _

lemma conductorReduction_kernel_card (a b : O) (ha : a ≠ 0) :
    Nat.card (conductorReduction a b).toAddMonoidHom.ker = Ideal.absNorm (Ideal.span {b}) := by
  have hc := card_ring_eq_card_mul_kernel (conductorReduction a b) (conductorReduction_surjective a b)
  change Ideal.absNorm (Ideal.span {a * b}) =
    Ideal.absNorm (Ideal.span {a}) * Nat.card (conductorReduction a b).toAddMonoidHom.ker at hc
  have hnorm : Ideal.absNorm (Ideal.span {a * b}) =
      Ideal.absNorm (Ideal.span {a}) * Ideal.absNorm (Ideal.span {b}) := by
    rw [← Ideal.span_singleton_mul_span_singleton, map_mul]
  rw [hnorm] at hc
  exact Nat.eq_of_mul_eq_mul_left
    (Nat.pos_of_ne_zero (Ideal.absNorm_eq_zero_iff.not.mpr (Ideal.span_singleton_eq_bot.not.mpr ha))) hc.symm

/-- Finite Fourier transform of a weight whose conductor divides the modulus. -/
def conductorTraceSum (a b : O) (ha : a ≠ 0) (hb : b ≠ 0)
    (F : (O ⧸ Ideal.span {a}) → ℂ) (h : O) : ℂ :=
  ∑' x : O ⧸ Ideal.span {a * b}, F (conductorReduction a b x) *
    residueTraceQuotientChar h (a * b) (mul_ne_zero ha hb) x

lemma residueTraceQuotientChar_conductor_lift (a b k : O) (ha : a ≠ 0) (hb : b ≠ 0)
    (x : O ⧸ Ideal.span {a * b}) :
    residueTraceQuotientChar (b * k) (a * b) (mul_ne_zero ha hb) x =
      residueTraceQuotientChar k a ha (conductorReduction a b x) := by
  obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective x
  change residueTraceQuotientChar (b * k) (a * b) _ (Ideal.Quotient.mk _ d) =
    residueTraceQuotientChar k a ha (Ideal.Quotient.mk _ d)
  rw [residueTraceQuotientChar_mk, residueTraceQuotientChar_mk]
  unfold residueAdditive cuspFrequency
  simp only [map_mul, map_ofNat]
  congr 1
  field_simp [ringComplex_ne_zero ha, ringComplex_ne_zero hb]

/-- Lifting a frequency multiplies its finite Fourier transform by the kernel cardinality. -/
theorem conductorTraceSum_lift (a b : O) (ha : a ≠ 0) (hb : b ≠ 0)
    (F : (O ⧸ Ideal.span {a}) → ℂ) (k : O) :
    conductorTraceSum a b ha hb F (b * k) =
      (Ideal.absNorm (Ideal.span {b}) : ℂ) *
        ∑' x : O ⧸ Ideal.span {a}, F x * residueTraceQuotientChar k a ha x := by
  letI : Finite (O ⧸ Ideal.span {a}) := (Ideal.span {a}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr ha)
  letI : Finite (O ⧸ Ideal.span {a * b}) := (Ideal.span {a * b}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr (mul_ne_zero ha hb))
  have he := finite_tsum_comp_addHom (conductorReduction a b).toAddMonoidHom
    (conductorReduction_surjective a b) (fun x => F x * residueTraceQuotientChar k a ha x)
  rw [conductorReduction_kernel_card a b ha] at he
  calc
    _ = ∑' x : O ⧸ Ideal.span {a * b}, F (conductorReduction a b x) *
        residueTraceQuotientChar k a ha (conductorReduction a b x) := by
      apply tsum_congr
      intro x
      exact congrArg (fun z => F (conductorReduction a b x) * z)
        (residueTraceQuotientChar_conductor_lift a b k ha hb x)
    _ = _ := he

lemma conductorReduction_power_unit (p : O) (n : ℕ) (x : O ⧸ Ideal.span {p * p ^ n}) :
    IsUnit (conductorReduction p (p ^ n) x) ↔ IsUnit x := by
  obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective x
  change IsUnit (Ideal.Quotient.mk (Ideal.span {p}) d) ↔
    IsUnit (Ideal.Quotient.mk (Ideal.span {p * p ^ n}) d)
  rw [isUnit_quotient_span_iff, isUnit_quotient_span_iff]
  constructor
  · intro h
    rw [← pow_succ']
    exact h.pow_left
  · rintro ⟨a, b, hab⟩
    refine ⟨a * p ^ n, b, ?_⟩
    linear_combination hab

lemma cubicUnitGaussSum_prime_power_conductor (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (n : ℕ) (h : O) :
    cubicUnitGaussSum h (p ^ (n + 1)) =
      conductorTraceSum p (p ^ n) hp.ne_zero (pow_ne_zero _ hp.ne_zero)
        (fun x => (primeCubicMulChar p hp hprimary ^ (n + 1)) x) h := by
  let χ := primeCubicMulChar p hp hprimary
  let F : (O ⧸ Ideal.span {p * p ^ n}) → ℂ := fun x =>
    (χ ^ (n + 1)) (conductorReduction p (p ^ n) x) *
      residueTraceQuotientChar h (p * p ^ n) (mul_ne_zero hp.ne_zero (pow_ne_zero _ hp.ne_zero)) x
  have hsup : Function.support F ⊆ {x | IsUnit x} := by
    intro x hx
    by_contra hn
    have hh : ¬ IsUnit (conductorReduction p (p ^ n) x) :=
      fun hh => hn ((conductorReduction_power_unit p n x).mp hh)
    exact hx (by dsimp [F]; rw [MulChar.map_nonunit _ hh, zero_mul])
  rw [pow_succ' p n]
  change cubicUnitGaussSum h (p * p ^ n) = ∑' x, F x
  rw [← tsum_subtype_eq_of_support_subset hsup, cubicUnitGaussSum]
  apply tsum_congr
  intro x
  let d := principalResidueRep (p * p ^ n) x.1
  have hd : Ideal.Quotient.mk (Ideal.span {p * p ^ n}) d = x.1 := principalResidueRep_spec _ _
  change ringComplex (symbol d (p * p ^ n)) * residueAdditive (3 * h) (p * p ^ n) d = F x.1
  rw [← hd]
  change _ = (χ ^ (n + 1)) (Ideal.Quotient.mk (Ideal.span {p}) d) *
    residueTraceQuotientChar h (p * p ^ n) _ (Ideal.Quotient.mk _ d)
  rw [MulChar.pow_apply' _ (Nat.succ_ne_zero n), primeCubicMulChar_mk,
    residueTraceQuotientChar_mk, ← pow_succ' p n, symbol_pow_denominator, map_pow]

/-- Prime-power Gauss sums reduce exactly to a residue-field sum with the correct character power. -/
theorem cubicUnitGaussSum_prime_power_lift (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (n : ℕ) (h : O) :
    cubicUnitGaussSum (p ^ n * h) (p ^ (n + 1)) =
      (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ n * primeCubicGauss p hp hprimary (n + 1) h := by
  rw [cubicUnitGaussSum_prime_power_conductor p hp hprimary n,
    conductorTraceSum_lift p (p ^ n) hp.ne_zero (pow_ne_zero _ hp.ne_zero)]
  rw [← Ideal.span_singleton_pow, map_pow, Nat.cast_pow]
  rfl

lemma primeCubicMulChar_cube (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1) :
    primeCubicMulChar p hp hprimary ^ 3 = 1 := by
  letI : (Ideal.span {p} : Ideal O).IsMaximal :=
    PrincipalIdealRing.isMaximal_of_irreducible hp.irreducible
  have hg : lambda ∉ (Ideal.span {p} : Ideal O) :=
    primary_maximal_divisor_good p hprimary _ (Ideal.subset_span (by simp))
  change ((cubicChar (Ideal.span {p}) hg).ringHomComp ringComplex) ^ 3 = 1
  rw [MulChar.ringHomComp_pow, cubicChar_pow_three, MulChar.ringHomComp_one]

lemma primeCubicGauss_mod_three (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1)
    (e : ℕ) (h : O) :
    primeCubicGauss p hp hprimary e h = primeCubicGauss p hp hprimary (e % 3) h := by
  have he : primeCubicMulChar p hp hprimary ^ e = primeCubicMulChar p hp hprimary ^ (e % 3) := by
    calc
      _ = primeCubicMulChar p hp hprimary ^ (e % 3 + 3 * (e / 3)) := by rw [Nat.mod_add_div]
      _ = _ := by rw [pow_add, pow_mul, primeCubicMulChar_cube, one_pow, mul_one]
  unfold primeCubicGauss
  rw [he]

/-- The cubic identity gives the exact square-root size at a nonzero prime frequency. -/
theorem cubicUnitGaussSum_prime_norm (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hph : ¬ p ∣ h) :
    ‖cubicUnitGaussSum h p‖ = ‖ringComplex p‖ := by
  have hc := congrArg norm (cubicUnitGaussSum_prime_cube p hp hprimary h hph)
  simp only [norm_pow, norm_mul, norm_neg, Complex.norm_natCast] at hc
  rw [← ringComplex_norm_sq_eq_absNorm_span] at hc
  have hp' : 0 < ‖ringComplex p‖ := norm_pos_iff.mpr (ringComplex_ne_zero hp.ne_zero)
  have hg : 0 ≤ ‖cubicUnitGaussSum h p‖ := norm_nonneg _
  have hpos : 0 < ‖cubicUnitGaussSum h p‖ ^ 2 +
      ‖cubicUnitGaussSum h p‖ * ‖ringComplex p‖ + ‖ringComplex p‖ ^ 2 := by positivity
  have he : (‖cubicUnitGaussSum h p‖ - ‖ringComplex p‖) *
      (‖cubicUnitGaussSum h p‖ ^ 2 + ‖cubicUnitGaussSum h p‖ * ‖ringComplex p‖ + ‖ringComplex p‖ ^ 2) = 0 := by
    nlinarith only [hc]
  exact sub_eq_zero.mp ((mul_eq_zero.mp he).resolve_right hpos.ne')

lemma primeCubicMulChar_ne_one (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1) :
    primeCubicMulChar p hp hprimary ≠ 1 := by
  letI : (Ideal.span {p} : Ideal O).IsMaximal :=
    PrincipalIdealRing.isMaximal_of_irreducible hp.irreducible
  have hg : lambda ∉ (Ideal.span {p} : Ideal O) :=
    primary_maximal_divisor_good p hprimary _ (Ideal.subset_span (by simp))
  change (cubicChar (Ideal.span {p}) hg).ringHomComp ringComplex ≠ 1
  exact (MulChar.ringHomComp_ne_one_iff ringComplex_injective).mpr (cubicChar_ne_one _ hg)

lemma primeCubicMulChar_order (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1) :
    orderOf (primeCubicMulChar p hp hprimary) = 3 := by
  have hd := orderOf_dvd_of_pow_eq_one (primeCubicMulChar_cube p hp hprimary)
  rcases (Nat.dvd_prime Nat.prime_three).mp hd with h1 | h3
  · exact False.elim (primeCubicMulChar_ne_one p hp hprimary (orderOf_eq_one_iff.mp h1))
  · exact h3

lemma primeCubicMulChar_pow_eq_one (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1) (e : ℕ) :
    primeCubicMulChar p hp hprimary ^ e = 1 ↔ 3 ∣ e := by
  rw [← orderOf_dvd_iff_pow_eq_one, primeCubicMulChar_order]

lemma primeCubicGauss_eq_gaussSum (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1)
    (e : ℕ) (h : O) [Fintype (O ⧸ Ideal.span {p})] :
    primeCubicGauss p hp hprimary e h =
      gaussSum (primeCubicMulChar p hp hprimary ^ e) (residueTraceQuotientChar h p hp.ne_zero) := by
  simp only [primeCubicGauss, tsum_fintype, gaussSum]

lemma residueTraceQuotientChar_ne_one (c h : O) (hc : c ≠ 0) (hh : ¬ c ∣ h) :
    residueTraceQuotientChar h c hc ≠ 1 := by
  rw [residueTraceQuotientChar_mulShift]
  apply residueTraceQuotientChar_primitive c hc
  intro hz
  exact hh (Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp hz))

/-- At zero frequency only the trivial character power survives. -/
theorem primeCubicGauss_of_dvd (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1)
    (e : ℕ) (h : O) (hph : p ∣ h) :
    primeCubicGauss p hp hprimary e h =
      if 3 ∣ e then (Ideal.absNorm (Ideal.span {p}) : ℂ) - 1 else 0 := by
  letI : (Ideal.span {p} : Ideal O).IsMaximal :=
    PrincipalIdealRing.isMaximal_of_irreducible hp.irreducible
  letI : Field (O ⧸ Ideal.span {p}) := Ideal.Quotient.field _
  letI : Finite (O ⧸ Ideal.span {p}) := (Ideal.span {p}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr hp.ne_zero)
  letI : Fintype (O ⧸ Ideal.span {p}) := Fintype.ofFinite _
  have hh : Ideal.Quotient.mk (Ideal.span {p}) h = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton.mpr hph)
  rw [primeCubicGauss_eq_gaussSum, residueTraceQuotientChar_mulShift, hh, AddChar.mulShift_zero]
  split_ifs with he
  · rw [(primeCubicMulChar_pow_eq_one p hp hprimary e).mpr he, gaussSum_one_one,
      Nat.card_units, Nat.cast_sub (Nat.succ_le_of_lt Nat.card_pos), Nat.cast_one]
    rfl
  · exact gaussSum_one_right (fun hχ => he ((primeCubicMulChar_pow_eq_one p hp hprimary e).mp hχ))

lemma primeCubicGauss_trivial_nonzero (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1)
    (e : ℕ) (he : 3 ∣ e) (h : O) (hph : ¬ p ∣ h) : primeCubicGauss p hp hprimary e h = -1 := by
  letI : (Ideal.span {p} : Ideal O).IsMaximal :=
    PrincipalIdealRing.isMaximal_of_irreducible hp.irreducible
  letI : Field (O ⧸ Ideal.span {p}) := Ideal.Quotient.field _
  letI : Finite (O ⧸ Ideal.span {p}) := (Ideal.span {p}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr hp.ne_zero)
  letI : Fintype (O ⧸ Ideal.span {p}) := Fintype.ofFinite _
  rw [primeCubicGauss_eq_gaussSum, (primeCubicMulChar_pow_eq_one p hp hprimary e).mpr he]
  exact gaussSum_one_left (residueTraceQuotientChar_ne_one p h hp.ne_zero hph)

/-- The two nontrivial cubic Gauss factors multiply to the residue-field cardinality. -/
theorem primeCubicGauss_one_mul_two (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1)
    (h : O) (hph : ¬ p ∣ h) :
    primeCubicGauss p hp hprimary 1 h * primeCubicGauss p hp hprimary 2 h =
      (Ideal.absNorm (Ideal.span {p}) : ℂ) := by
  letI : (Ideal.span {p} : Ideal O).IsMaximal :=
    PrincipalIdealRing.isMaximal_of_irreducible hp.irreducible
  letI : Field (O ⧸ Ideal.span {p}) := Ideal.Quotient.field _
  letI : Finite (O ⧸ Ideal.span {p}) := (Ideal.span {p}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr hp.ne_zero)
  letI : Fintype (O ⧸ Ideal.span {p}) := Fintype.ofFinite _
  have hψ : (residueTraceQuotientChar h p hp.ne_zero).IsPrimitive :=
    AddChar.IsPrimitive.of_ne_one (residueTraceQuotientChar_ne_one p h hp.ne_zero hph)
  have he := gaussSum_mul_gaussSum_pow_orderOf_sub_one (primeCubicMulChar_ne_one p hp hprimary) hψ
  rw [primeCubicMulChar_order] at he
  have hm := MulChar.val_neg_one_eq_one_of_odd_order (by decide : Odd 3) (primeCubicMulChar_cube p hp hprimary)
  rw [hm, one_mul] at he
  change _ = (Nat.card (O ⧸ Ideal.span {p}) : ℂ)
  simpa only [primeCubicGauss_eq_gaussSum, pow_one, Nat.reduceSub, Nat.card_eq_fintype_card] using he

lemma cubicUnitGaussSum_frequency_dvd (h c : O) (hc : c ≠ 0) (hh : c ∣ h) :
    cubicUnitGaussSum h c = cubicUnitGaussSum 0 c :=
  cubicUnitGaussSum_frequency_congr h 0 c hc (by simpa only [sub_zero] using hh)

lemma cubicUnitGaussSum_prime_power_zero (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1) (n : ℕ) :
    cubicUnitGaussSum 0 (p ^ (n + 1)) =
      if 3 ∣ n + 1 then (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ n *
        ((Ideal.absNorm (Ideal.span {p}) : ℂ) - 1) else 0 := by
  have he := cubicUnitGaussSum_prime_power_lift p hp hprimary n 0
  simp only [mul_zero] at he
  rw [he, primeCubicGauss_of_dvd p hp hprimary (n + 1) 0 (dvd_zero _)]
  split_ifs <;> ring

/-- Reciprocity absorbs the coprime cubic twist into one frequency. -/
theorem cubicUnitGaussSum_primary_product (h a b : O) (ha : a ≠ 0) (hb : b ≠ 0)
    (hpa : lambda ^ 2 ∣ a - 1) (hpb : lambda ^ 2 ∣ b - 1) (hab : IsCoprime a b) :
    cubicUnitGaussSum h (a * b) = cubicUnitGaussSum h a * cubicUnitGaussSum (h * a) b := by
  have ht := cubicUnitGaussSum_frequency_twist h b a hb hab.symm
  have hc : ringComplex (symbol a b) ^ 3 = 1 := by
    rw [← map_pow, symbol_cube_of_isCoprime a b hpb hab, map_one]
  rw [cubicUnitGaussSum_coprime_product h a b ha hb hab, symbol_reciprocity b a hpb hpa,
    ← ht]
  calc
    _ = ringComplex (symbol a b) ^ 3 *
        (cubicUnitGaussSum h a * cubicUnitGaussSum (h * a) b) := by ring
    _ = _ := by rw [hc, one_mul]

/-- Unramified ideals with the chosen prime factor removed. -/
abbrev PrimeDeletedIdeal (p : O) := {I : GoodIdeal // ¬ (Ideal.span {p} : Ideal O) ∣ I.1}

def unramifiedPrimeDeletedSeries (p : O) (s : ℂ) (h : O) : ℂ :=
  ∑' I : PrimeDeletedIdeal p,
    unramifiedNormWeight s I.1.1 * cubicUnitGaussSum h (primaryIdealGenerator I.1.1)

lemma primaryIdealGenerator_pow (I : Ideal O) (n : ℕ) :
    primaryIdealGenerator (I ^ n) = primaryIdealGenerator I ^ n := map_pow primaryIdealGeneratorHom I n

lemma gaussPrimeIdeal_prime (p : O) (hp : Prime p) : Prime (Ideal.span {p} : Ideal O) :=
  Ideal.prime_of_isPrime (Ideal.span_singleton_eq_bot.not.mpr hp.ne_zero)
    ((Ideal.span_singleton_prime hp.ne_zero).mpr hp)

def gaussPrimeFactorMap (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1)
    (q : ℕ × PrimeDeletedIdeal p) : GoodIdeal :=
  ⟨(Ideal.span {p}) ^ q.1 * q.2.1.1, by
    rw [primaryIdealGenerator_mul, primaryIdealGenerator_pow,
      primaryIdealGenerator_span p hp.ne_zero hprimary]
    exact mul_ne_zero (pow_ne_zero _ hp.ne_zero) q.2.1.2⟩

lemma gaussPrimeFactorMap_bijective (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1) :
    Function.Bijective (gaussPrimeFactorMap p hp hprimary) := by
  let P : Ideal O := Ideal.span {p}
  have hP : Prime P := gaussPrimeIdeal_prime p hp
  constructor
  · rintro ⟨n, I⟩ ⟨m, J⟩ heq
    have he : P ^ n * I.1.1 = P ^ m * J.1.1 := congrArg Subtype.val heq
    have hn : n = m := by
      have hm := congrArg (multiplicity P) he
      rw [prime_power_remainder_multiplicity hP I.2,
        prime_power_remainder_multiplicity hP J.2] at hm
      exact hm
    subst m
    have hIJ : I = J := Subtype.ext (Subtype.ext (mul_left_cancel₀ (pow_ne_zero n hP.ne_zero) he))
    subst J
    rfl
  · intro I
    obtain ⟨J, hJ, hnot⟩ := (FiniteMultiplicity.of_prime_left hP
      (primaryIdealGenerator_ne_zero_ideal I.1 I.2)).exists_eq_pow_mul_and_not_dvd
    have hgood : primaryIdealGenerator J ≠ 0 := by
      intro hz
      apply I.2
      rw [hJ, primaryIdealGenerator_mul, hz, mul_zero]
    exact ⟨(multiplicity P I.1, ⟨⟨J, hgood⟩, hnot⟩), Subtype.ext hJ.symm⟩

def gaussPrimeFactorEquiv (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1) :
    ℕ × PrimeDeletedIdeal p ≃ GoodIdeal :=
  Equiv.ofBijective (gaussPrimeFactorMap p hp hprimary) (gaussPrimeFactorMap_bijective p hp hprimary)

lemma primeDeleted_generator_coprime (p : O) (hp : Prime p) (I : PrimeDeletedIdeal p) :
    IsCoprime p (primaryIdealGenerator I.1.1) := by
  apply hp.coprime_iff_not_dvd.mpr
  intro hd
  apply I.2
  rw [Ideal.dvd_iff_le, ← (primaryIdealGenerator_spec I.1.1 I.1.2).1,
    Ideal.span_singleton_le_span_singleton]
  exact hd

lemma primary_pow_congruence (p : O) (hprimary : lambda ^ 2 ∣ p - 1) (n : ℕ) :
    lambda ^ 2 ∣ p ^ n - 1 := by
  simpa only [one_pow] using hprimary.trans (sub_dvd_pow_sub_pow p 1 n)

lemma gaussPrimeFactor_term (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1)
    (s : ℂ) (h : O) (n : ℕ) (I : PrimeDeletedIdeal p) :
    unramifiedNormWeight s (gaussPrimeFactorMap p hp hprimary (n, I)).1 *
        cubicUnitGaussSum h (primaryIdealGenerator (gaussPrimeFactorMap p hp hprimary (n, I)).1) =
      unramifiedNormWeight s (Ideal.span {p}) ^ n * cubicUnitGaussSum h (p ^ n) *
        (unramifiedNormWeight s I.1.1 * cubicUnitGaussSum (h * p ^ n) (primaryIdealGenerator I.1.1)) := by
  change unramifiedNormWeight s ((Ideal.span {p}) ^ n * I.1.1) *
    cubicUnitGaussSum h (primaryIdealGenerator ((Ideal.span {p}) ^ n * I.1.1)) = _
  rw [primaryIdealGenerator_mul, primaryIdealGenerator_pow,
    primaryIdealGenerator_span p hp.ne_zero hprimary,
    cubicUnitGaussSum_primary_product h (p ^ n) (primaryIdealGenerator I.1.1)
      (pow_ne_zero _ hp.ne_zero) I.1.2 (primary_pow_congruence p hprimary n)
      (primaryIdealGenerator_spec I.1.1 I.1.2).2 (primeDeleted_generator_coprime p hp I).pow_left,
    map_mul, map_pow]
  ring

/-- Splitting off one prime gives its exact local expansion, with an absolutely convergent remainder. -/
theorem unramifiedCubicGaussSeries_prime_reindex (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (s : ℂ) (hs : 2 < s.re) (h : O) :
    unramifiedCubicGaussSeries s h =
      ∑' n : ℕ, unramifiedNormWeight s (Ideal.span {p}) ^ n * cubicUnitGaussSum h (p ^ n) *
        unramifiedPrimeDeletedSeries p s (h * p ^ n) := by
  let F : GoodIdeal → ℂ := fun I =>
    unramifiedNormWeight s I.1 * cubicUnitGaussSum h (primaryIdealGenerator I.1)
  have hsum : Summable F := (unramifiedCubicGaussSeries_summable_norm s hs h).of_norm
  let e := gaussPrimeFactorEquiv p hp hprimary
  have hpull : Summable (fun q : ℕ × PrimeDeletedIdeal p => F (e q)) := e.summable_iff.mpr hsum
  change (∑' I, F I) = _
  rw [← e.tsum_eq F, hpull.tsum_prod]
  apply tsum_congr
  intro n
  change (∑' I : PrimeDeletedIdeal p,
    unramifiedNormWeight s (gaussPrimeFactorMap p hp hprimary (n, I)).1 *
      cubicUnitGaussSum h (primaryIdealGenerator (gaussPrimeFactorMap p hp hprimary (n, I)).1)) = _
  simp_rw [gaussPrimeFactor_term p hp hprimary s h n]
  exact tsum_mul_left

lemma unramifiedPrimeDeletedSeries_cube_shift (p : O) (hp : Prime p) (s : ℂ) (h : O) :
    unramifiedPrimeDeletedSeries p s (h * p ^ 3) = unramifiedPrimeDeletedSeries p s h := by
  apply tsum_congr
  intro I
  congr 1
  exact cubicUnitGaussSum_cube_shift h _ p I.1.2
    (primaryIdealGenerator_spec I.1.1 I.1.2).2 (primeDeleted_generator_coprime p hp I).symm

@[simp] lemma cubicUnitGaussSum_one (h : O) : cubicUnitGaussSum h 1 = 1 := by
  letI : Subsingleton (O ⧸ Ideal.span {(1 : O)}) :=
    Ideal.Quotient.subsingleton_iff.mpr (by simp)
  let r : CubicUnitResidue (1 : O) := ⟨1, isUnit_one⟩
  rw [cubicUnitGaussSum, tsum_eq_single r (fun b hb => False.elim (hb (Subsingleton.elim b r)))]
  rw [symbol_one, map_one, one_mul,
    residueAdditive_three_congr h 1 _ 0 one_ne_zero (one_dvd _)]
  simp only [residueAdditive, map_zero, mul_zero, zero_div, AddChar.map_zero_eq_one]

lemma cubicUnitGaussSum_prime_power_too_large (p : O) (hp : Prime p)
    (h : O) (hph : ¬ p ∣ h) (a k : ℕ) (hk : a + 1 < k) :
    cubicUnitGaussSum (h * p ^ a) (p ^ k) = 0 := by
  by_contra hG
  cases k with
  | zero => omega
  | succ n =>
    have hd := cubicUnitGaussSum_power_support (h * p ^ a) p hp.ne_zero n hG
    have hd' : p ^ (a + 1) ∣ p ^ a * h := by
      rw [mul_comm]
      exact (pow_dvd_pow p (by omega : a + 1 ≤ n)).trans hd
    rw [pow_succ] at hd'
    exact hph ((mul_dvd_mul_iff_left (pow_ne_zero _ hp.ne_zero)).mp hd')

lemma unramifiedPrimeDeletedSeries_pow_mod (p : O) (hp : Prime p) (s : ℂ) (h : O) (n : ℕ) :
    unramifiedPrimeDeletedSeries p s (h * p ^ n) =
      unramifiedPrimeDeletedSeries p s (h * p ^ (n % 3)) := by
  apply tsum_congr
  intro I
  congr 1
  have he : p ^ n = p ^ (n % 3) * (p ^ (n / 3)) ^ 3 := by
    rw [← pow_mul, ← pow_add]
    congr 1
    omega
  rw [he, ← mul_assoc]
  exact cubicUnitGaussSum_cube_shift _ _ _ I.1.2
    (primaryIdealGenerator_spec I.1.1 I.1.2).2 (primeDeleted_generator_coprime p hp I).symm.pow_right

/-- At a frequency of valuation `a`, the prime expansion ends at exponent `a+1`. -/
theorem unramifiedCubicGaussSeries_prime_finite (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (s : ℂ) (hs : 2 < s.re) (h : O) (hph : ¬ p ∣ h) (a : ℕ) :
    unramifiedCubicGaussSeries s (h * p ^ a) =
      ∑ k ∈ Finset.range (a + 2), unramifiedNormWeight s (Ideal.span {p}) ^ k *
        cubicUnitGaussSum (h * p ^ a) (p ^ k) * unramifiedPrimeDeletedSeries p s (h * p ^ a * p ^ k) := by
  rw [unramifiedCubicGaussSeries_prime_reindex p hp hprimary s hs]
  apply tsum_eq_sum
  intro k hk
  have hk' : a + 1 < k := by
    have hh : a + 2 ≤ k := by simpa only [Finset.mem_range, not_lt] using hk
    omega
  rw [cubicUnitGaussSum_prime_power_too_large p hp h hph a k hk', mul_zero, zero_mul]

/-- The local recurrence follows from the four supported Gauss factors and cubic periodicity. -/
theorem unramifiedCubicGaussSeries_prime_recurrence (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (s : ℂ) (hs : 2 < s.re) (h : O) (hph : ¬ p ∣ h) :
    unramifiedCubicGaussSeries s (h * p ^ 3) =
      (1 + (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 * unramifiedNormWeight s (Ideal.span {p}) ^ 3) *
        unramifiedCubicGaussSeries s h -
      unramifiedNormWeight s (Ideal.span {p}) * primeCubicGauss p hp hprimary 1 h *
        unramifiedCubicGaussSeries s (h * p) := by
  let q : ℂ := Ideal.absNorm (Ideal.span {p})
  have hg0 (k : ℕ) (hk : k ≤ 3) :
      cubicUnitGaussSum (h * p ^ 3) (p ^ k) = cubicUnitGaussSum 0 (p ^ k) :=
    cubicUnitGaussSum_frequency_dvd _ _ (pow_ne_zero _ hp.ne_zero)
      ((pow_dvd_pow p hk).trans (dvd_mul_left (p ^ 3) h))
  have hg1 : cubicUnitGaussSum (h * p ^ 3) p = 0 := by
    have he := hg0 1 (by omega)
    simp only [pow_one] at he
    rw [he]
    simpa using cubicUnitGaussSum_prime_power_zero p hp hprimary 0
  have hg2 : cubicUnitGaussSum (h * p ^ 3) (p ^ 2) = 0 := by
    rw [hg0 2 (by omega)]
    simpa using cubicUnitGaussSum_prime_power_zero p hp hprimary 1
  have hg3 : cubicUnitGaussSum (h * p ^ 3) (p ^ 3) = q ^ 2 * (q - 1) := by
    rw [hg0 3 le_rfl]
    simpa only [Nat.reduceAdd, dvd_refl, ite_true] using cubicUnitGaussSum_prime_power_zero p hp hprimary 2
  have hg4 : cubicUnitGaussSum (h * p ^ 3) (p ^ 4) = q ^ 3 * primeCubicGauss p hp hprimary 1 h := by
    have he := cubicUnitGaussSum_prime_power_lift p hp hprimary 3 h
    rw [primeCubicGauss_mod_three p hp hprimary 4] at he
    simpa only [mul_comm (p ^ 3) h, Nat.reduceMod] using he
  have hj1 : cubicUnitGaussSum (h * p) p = 0 := by
    rw [cubicUnitGaussSum_frequency_dvd _ p hp.ne_zero (dvd_mul_left p h)]
    simpa using cubicUnitGaussSum_prime_power_zero p hp hprimary 0
  have hj2 : cubicUnitGaussSum (h * p) (p ^ 2) = q * primeCubicGauss p hp hprimary 2 h := by
    simpa only [pow_one, mul_comm p h] using cubicUnitGaussSum_prime_power_lift p hp hprimary 1 h
  have e0 := unramifiedCubicGaussSeries_prime_finite p hp hprimary s hs h hph 0
  have e1 := unramifiedCubicGaussSeries_prime_finite p hp hprimary s hs h hph 1
  have e3 := unramifiedCubicGaussSeries_prime_finite p hp hprimary s hs h hph 3
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, zero_add, pow_zero, pow_one,
    cubicUnitGaussSum_one, mul_one, one_mul, hg1, hg2, hg3, hg4, hj1, hj2,
    mul_zero, zero_mul, add_zero] at e0 e1 e3
  rw [show h * p * p ^ 2 = h * p ^ 3 by ring, unramifiedPrimeDeletedSeries_cube_shift p hp] at e1
  rw [unramifiedPrimeDeletedSeries_cube_shift p hp,
    show h * p ^ 3 * p ^ 3 = h * p ^ 6 by ring,
    show h * p ^ 3 * p ^ 4 = h * p ^ 7 by ring,
    unramifiedPrimeDeletedSeries_pow_mod p hp s h 6,
    unramifiedPrimeDeletedSeries_pow_mod p hp s h 7] at e3
  simp only [Nat.reduceMod, pow_zero, pow_one, mul_one] at e3
  rw [e3, e0, e1, ← primeCubicGauss_one_eq p hp hprimary h]
  have hg := primeCubicGauss_one_mul_two p hp hprimary h hph
  change _ = q at hg
  change _ = (1 + q ^ 3 * _) * _ - _
  linear_combination unramifiedNormWeight s (Ideal.span {p}) ^ 3 * q *
    unramifiedPrimeDeletedSeries p s h * hg

lemma primeCubicGauss_add_three (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1)
    (e : ℕ) (h : O) : primeCubicGauss p hp hprimary (e + 3) h = primeCubicGauss p hp hprimary e h := by
  unfold primeCubicGauss
  rw [pow_add, primeCubicMulChar_cube, mul_one]

/-- Increasing both conductor and frequency by a cube scales every positive conductor term by `N(p)^3`. -/
lemma cubicUnitGaussSum_prime_cube_shift_pos (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (n : ℕ) (h : O) :
    cubicUnitGaussSum (h * p ^ 3) (p ^ (n + 4)) =
      (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 * cubicUnitGaussSum h (p ^ (n + 1)) := by
  by_cases hd : p ^ n ∣ h
  · obtain ⟨r, rfl⟩ := hd
    rw [show p ^ n * r * p ^ 3 = p ^ (n + 3) * r by rw [pow_add]; ring,
      show n + 4 = (n + 3) + 1 by omega,
      cubicUnitGaussSum_prime_power_lift p hp hprimary (n + 3) r,
      cubicUnitGaussSum_prime_power_lift p hp hprimary n r,
      show n + 3 + 1 = (n + 1) + 3 by omega, primeCubicGauss_add_three, pow_add]
    ring
  · have hlow := cubicUnitGaussSum_power_vanish h p hp.ne_zero n hd
    have hhigh : cubicUnitGaussSum (h * p ^ 3) (p ^ (n + 4)) = 0 := by
      rw [show n + 4 = (n + 3) + 1 by omega]
      apply cubicUnitGaussSum_power_vanish _ p hp.ne_zero (n + 3)
      intro hh
      have he : p ^ 3 * p ^ n ∣ p ^ 3 * h := by
        simpa only [pow_add, mul_comm, mul_left_comm, mul_assoc] using hh
      exact hd ((mul_dvd_mul_iff_left (pow_ne_zero 3 hp.ne_zero)).mp he)
    rw [hhigh, hlow, mul_zero]

lemma cubicUnitGaussSum_prime_cube_shift (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (k : ℕ) (h : O) :
    cubicUnitGaussSum (h * p ^ 3) (p ^ (k + 3)) =
      (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 * cubicUnitGaussSum h (p ^ k) -
        if k = 0 then (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 2 else 0 := by
  cases k with
  | zero =>
    rw [Nat.zero_add, cubicUnitGaussSum_frequency_dvd _ _ (pow_ne_zero _ hp.ne_zero)
      (dvd_mul_left (p ^ 3) h)]
    have he := cubicUnitGaussSum_prime_power_zero p hp hprimary 2
    simp only [Nat.reduceAdd, dvd_refl, ite_true] at he
    rw [he]
    simp only [pow_zero, cubicUnitGaussSum_one, mul_one, ite_true]
    ring
  | succ n =>
    simpa only [show n + 1 + 3 = n + 4 by omega, Nat.succ_ne_zero, ite_false, sub_zero] using
      cubicUnitGaussSum_prime_cube_shift_pos p hp hprimary n h

/-- Compact support needed to test the continued source at a rationally translated cusp. -/
def rationalCuspCompact (g : rationalExtension) : Set KernelQuotient :=
  kernelRationalAction g '' kernelCuspAverageCompact

lemma rationalCuspCompact_isCompact (g : rationalExtension) : IsCompact (rationalCuspCompact g) :=
  kernelCuspAverageCompact_isCompact.image (kernelRationalAction_continuous g)

def rationalCuspFourier (h : O) (g : rationalExtension) : KernelQuotientL2 →L[ℂ] ℂ :=
  (kernelCuspFourier h).comp (kernelRationalPullback g).toContinuousLinearMap

lemma rationalCuspFourier_integral (h : O) (g : rationalExtension) (F : KernelQuotientL2) :
    rationalCuspFourier h g F = ∫ w in cuspPeriodStrip 5 6,
      F (kernelRationalAction g (integralOrbitProjection globalKubotaKernel w)) *
        cuspFourierPhase h w ∂hyperbolicVolume := by
  rw [rationalCuspFourier, ContinuousLinearMap.comp_apply, kernelCuspFourier_integral]
  have hm := kernelProjection_cuspPeriodStrip_measurePreserving 5 6 (by norm_num)
  have he := hm.quasiMeasurePreserving.ae_eq_comp
    (ae_restrict_of_ae (kernelRationalPullback_ae g F) (s := kernelCuspStripSet))
  apply integral_congr_ae
  filter_upwards [he] with w hw
  exact congrArg (fun z : ℂ => z * cuspFourierPhase h w) hw

lemma rationalCuspFourier_restrict (h : O) (g : rationalExtension) (F : KernelQuotientL2) :
    rationalCuspFourier h g (kernelMassRestrictionCLM (rationalCuspCompact g)
      (rationalCuspCompact_isCompact g).measurableSet F) = rationalCuspFourier h g F := by
  rw [rationalCuspFourier_integral, rationalCuspFourier_integral]
  have hsource := (kernelRationalAction_measurePreserving g).quasiMeasurePreserving.ae_eq_comp
    (kernelMassRestriction_coe (rationalCuspCompact g) (rationalCuspCompact_isCompact g).measurableSet F)
  have hm := kernelProjection_cuspPeriodStrip_measurePreserving 5 6 (by norm_num)
  have he := hm.quasiMeasurePreserving.ae_eq_comp (ae_restrict_of_ae hsource (s := kernelCuspStripSet))
  apply integral_congr_ae
  filter_upwards [he, ae_restrict_mem (cuspPeriodStrip_measurable 5 6)] with w hw hwm
  have hmem : kernelRationalAction g (integralOrbitProjection globalKubotaKernel w) ∈ rationalCuspCompact g :=
    ⟨_, kernelCuspStripSet_subset_compact ⟨w, hwm, rfl⟩, rfl⟩
  exact congrArg (fun z : ℂ => z * cuspFourierPhase h w) (hw.trans (Set.indicator_of_mem hmem _))

/-- The continued scalar source tested at an arbitrary cusp in the rational extension. -/
def rationalCuspFamily (h : O) (g : rationalExtension)
    (a b : ℝ) (ha : 0 < a) (hab : a < b) (s : ℂ) : ℂ :=
  rationalCuspFourier h g
    (kernelLocalCorrectedSeed (rationalCuspCompact g) (rationalCuspCompact_isCompact g) a b ha hab s)

lemma rationalCuspFamily_meromorphicAt (h : O) (g : rationalExtension)
    (a b : ℝ) (ha : 0 < a) (hab : a < b) :
    MeromorphicAt (rationalCuspFamily h g a b ha hab) (4 / 3 : ℂ) :=
  meromorphicAt_clm (rationalCuspFourier h g)
    (kernelLocalCorrectedSeed_meromorphicAt _ (rationalCuspCompact_isCompact g) a b ha hab)

lemma rationalCuspFamily_analyticAt_nonreal (h : O) (g : rationalExtension)
    (a b : ℝ) (ha : 0 < a) (hab : a < b) (s : ℂ) (hs : s.re ≠ 1) (hi : s.im ≠ 0) :
    AnalyticAt ℂ (rationalCuspFamily h g a b ha hab) s :=
  (ContinuousLinearMap.analyticAt (𝕜 := ℂ) (E := KernelQuotientL2) (F := ℂ)
    (rationalCuspFourier h g) _).comp_of_eq
      (kernelLocalCorrectedSeed_analyticAt_nonreal _ (rationalCuspCompact_isCompact g) a b ha hab s hs hi) rfl

lemma rationalCuspFamily_residue_limit (h : O) (g : rationalExtension)
    (a b : ℝ) (ha : 0 < a) (hab : a < b) :
    Tendsto (fun s : ℂ => (s - 4 / 3) * rationalCuspFamily h g a b ha hab s)
      (𝓝[≠] (4 / 3 : ℂ)) (𝓝 (rationalCuspFourier h g (kernelEisensteinResidueVector a b ha hab))) := by
  have he := (rationalCuspFourier h g).continuous.continuousAt.tendsto.comp
    (kernelLocalCorrectedSeed_residue_limit _ (rationalCuspCompact_isCompact g) a b ha hab)
  simpa only [Function.comp_def, map_smul, smul_eq_mul, rationalCuspFourier_restrict,
    rationalCuspFamily] using he

lemma rationalCuspFamily_actual_integral (h : O) (g : rationalExtension)
    (a b : ℝ) (ha : 0 < a) (hab : a < b) (s : ℂ) :
    rationalCuspFamily h g a b ha hab s = ∫ w in cuspPeriodStrip 5 6,
      kernelCorrectedSeed a b ha hab s (kernelRationalAction g (integralOrbitProjection globalKubotaKernel w)) *
        cuspFourierPhase h w ∂hyperbolicVolume := by
  rw [rationalCuspFamily, rationalCuspFourier_integral]
  have hsource := (kernelRationalAction_measurePreserving g).quasiMeasurePreserving.ae_eq_comp
    (kernelLocalCorrectedSeed_ae_eq _ (rationalCuspCompact_isCompact g) a b ha hab s)
  have hm := kernelProjection_cuspPeriodStrip_measurePreserving 5 6 (by norm_num)
  have he := hm.quasiMeasurePreserving.ae_eq_comp (ae_restrict_of_ae hsource (s := kernelCuspStripSet))
  apply integral_congr_ae
  filter_upwards [he, ae_restrict_mem (cuspPeriodStrip_measurable 5 6)] with w hw hwm
  have hmem : kernelRationalAction g (integralOrbitProjection globalKubotaKernel w) ∈ rationalCuspCompact g :=
    ⟨_, kernelCuspStripSet_subset_compact ⟨w, hwm, rfl⟩, rfl⟩
  exact congrArg (fun z : ℂ => z * cuspFourierPhase h w) (hw.trans (Set.indicator_of_mem hmem _))

theorem rationalCuspFamily_initial (h : O) (g : rationalExtension)
    (a b : ℝ) (ha : 0 < a) (hab : a < b) (ha1 : 1 < a) (s : ℂ) (hs : 4 < s.re) (hi : 0 < s.im) :
    rationalCuspFamily h g a b ha hab s = ∫ w in cuspPeriodStrip 5 6,
      hyperbolicEisenstein s (integralComplexMatrix (g : SL(2, O)) • w) *
        cuspFourierPhase h w ∂hyperbolicVolume := by
  have hcorrected : kernelCorrectedSeed a b ha hab s =ᵐ[integralQuotientVolume globalKubotaKernel]
      kernelQuotientEisenstein s (by linarith) := by
    filter_upwards [kernelEisensteinL2Correction_initial_overlap a b ha1 hab s hs hi] with q hq
    change kernelQuotientSeed a b s q + kernelEisensteinL2Correction a b ha hab s q = _
    rw [hq]
    ring
  have hsource := (kernelRationalAction_measurePreserving g).quasiMeasurePreserving.ae_eq_comp hcorrected
  have hm := kernelProjection_cuspPeriodStrip_measurePreserving 5 6 (by norm_num)
  have he := hm.quasiMeasurePreserving.ae_eq_comp (ae_restrict_of_ae hsource (s := kernelCuspStripSet))
  rw [rationalCuspFamily_actual_integral]
  apply integral_congr_ae
  filter_upwards [he] with w hw
  exact congrArg (fun z : ℂ => z * cuspFourierPhase h w)
    (hw.trans (by dsimp only [Function.comp_def]; rw [kernelRationalAction_mk, kernelQuotientEisenstein_mk]))

/-- Rows at the opposite cusp, indexed directly by their unramified denominator ideal. -/
abbrev OppositeData := Σ I : GoodIdeal, {x : O // IsCoprime (primaryIdealGenerator I.1) x}

def oppositeDataToPrimitive (q : OppositeData) : PrimitiveRow :=
  ⟨![-3 * q.2.1, primaryIdealGenerator q.1.1], by
    change IsCoprime (-3 * q.2.1) (primaryIdealGenerator q.1.1) ∧
      (3 : O) ∣ -3 * q.2.1 ∧ (3 : O) ∣ primaryIdealGenerator q.1.1 - 1
    have hp := (primaryIdealGenerator_spec q.1.1 q.1.2).2
    refine ⟨?_, ⟨-q.2.1, by ring⟩, three_dvd_primary_sub_one _ hp⟩
    simpa only [neg_mul] using ((primary_coprime_three _ hp).mul_right q.2.2).symm.neg_left⟩

lemma oppositeDataToPrimitive_bijective : Function.Bijective oppositeDataToPrimitive := by
  constructor
  · rintro ⟨I, x⟩ ⟨J, y⟩ he
    have hr := congrArg Subtype.val he
    have hI : I = J := primaryIdealGenerator_injective_good (congrFun hr 1)
    subst J
    have hx : x = y := by
      apply Subtype.ext
      exact mul_left_cancel₀ (by norm_num : -(3 : O) ≠ 0) (congrFun hr 0)
    subst y
    rfl
  · intro r
    obtain ⟨t, ht⟩ := r.2.2.1
    have hp : lambda ^ 2 ∣ r.1 1 - 1 := lambda_sq_dvd_three.trans r.2.2.2
    have hd := primary_ne_zero (r.1 1) hp
    let I : GoodIdeal := ⟨Ideal.span {r.1 1}, by
      rw [primaryIdealGenerator_span _ hd hp]
      exact hd⟩
    have hI : primaryIdealGenerator I.1 = r.1 1 := primaryIdealGenerator_span _ hd hp
    have hc : IsCoprime (primaryIdealGenerator I.1) (-t) := by
      rw [hI]
      have he : IsCoprime (r.1 1) (3 * t) := by simpa only [ht] using r.2.1.symm
      exact he.of_mul_right_right.neg_right
    refine ⟨⟨I, ⟨-t, hc⟩⟩, Subtype.ext ?_⟩
    funext i
    fin_cases i
    · change -3 * (-t) = r.1 0
      rw [ht]
      ring
    · exact hI

def oppositeDataEquiv : OppositeData ≃ PrimitiveRow :=
  Equiv.ofBijective oppositeDataToPrimitive oppositeDataToPrimitive_bijective

def oppositeMatrix : SL(2, ℂ) := ⟨!![0, -1; 1, 0], by simp [Matrix.det_fin_two]⟩

lemma rowOperator_opposite (v : Fin 2 → ℂ) : rowOperator oppositeMatrix v = ![v 1, -v 0] := by
  rw [rowOperator_apply]
  funext i
  fin_cases i <;> simp [oppositeMatrix, Matrix.vecMul, dotProduct, Fin.sum_univ_two]

def oppositeEisenstein (z : ℂ) (v : ℝ) (hv : 0 < v) (s : ℂ) : ℂ :=
  eisenstein (oppositeMatrix * upperSection z v hv) s

lemma rowHeight_eq_shiftedHeightKernel (z : ℂ) (v : ℝ) (hv : 0 < v) (s : ℂ)
    (c d : O) (hc : c ≠ 0) :
    ((v / (‖ringComplex c * z + ringComplex d‖ ^ 2 + ‖ringComplex c‖ ^ 2 * v ^ 2) : ℝ) : ℂ) ^ s =
      ((‖ringComplex c‖ ^ 2 : ℝ) : ℂ) ^ (-s) *
        shiftedHeightKernel v s (ringComplex d / ringComplex c) z := by
  have hc' := ringComplex_ne_zero hc
  have hn : 0 < ‖ringComplex c‖ ^ 2 := sq_pos_of_pos (norm_pos_iff.mpr hc')
  have hfac : ringComplex c * z + ringComplex d = ringComplex c * (z + ringComplex d / ringComplex c) := by
    field_simp
  have he : v / (‖ringComplex c * z + ringComplex d‖ ^ 2 + ‖ringComplex c‖ ^ 2 * v ^ 2) =
      ((‖ringComplex c‖ ^ 2 * v) * (1 + ‖(z + ringComplex d / ringComplex c) / (v : ℂ)‖ ^ 2))⁻¹ := by
    rw [hfac, norm_mul, mul_pow, norm_div, Complex.norm_real, Real.norm_of_nonneg hv.le]
    field_simp
    ring
  unfold shiftedHeightKernel hyperbolicKernel
  rw [he, Complex.ofReal_inv, inv_cpow_ofReal_nonneg (by positivity), ← Complex.cpow_neg,
    Complex.ofReal_mul, Complex.mul_cpow_ofReal_nonneg (mul_nonneg hn.le hv.le) (by positivity),
    Complex.ofReal_mul, Complex.mul_cpow_ofReal_nonneg hn.le hv.le]
  ring

def oppositeTerm (z : ℂ) (v : ℝ) (s : ℂ) (c x : O) : ℂ :=
  ringComplex (symbol (3 * x) c) *
    ((v / (‖ringComplex c * z + ringComplex (3 * x)‖ ^ 2 + ‖ringComplex c‖ ^ 2 * v ^ 2) : ℝ) : ℂ) ^ s

lemma oppositeTerm_eq_shifted (z : ℂ) (v : ℝ) (hv : 0 < v) (s : ℂ)
    (c x : O) (hc : c ≠ 0) :
    oppositeTerm z v s c x =
      (ringComplex (symbol (3 * x) c) * ((‖ringComplex c‖ ^ 2 : ℝ) : ℂ) ^ (-s)) *
        shiftedHeightKernel v s (ringComplex (3 * x) / ringComplex c) z := by
  rw [oppositeTerm, rowHeight_eq_shiftedHeightKernel z v hv s c (3 * x) hc]
  ring

lemma opposite_summand (z : ℂ) (v : ℝ) (hv : 0 < v) (s : ℂ) (q : OppositeData) :
    summand (oppositeMatrix * upperSection z v hv) s (primitiveRowEquiv.symm (oppositeDataEquiv q)) =
      oppositeTerm z v s (primaryIdealGenerator q.1.1) q.2.1 := by
  let r : Fin 2 → ℂ := ![ringComplex (primaryIdealGenerator q.1.1), ringComplex (3 * q.2.1)]
  have hr : rowOperator oppositeMatrix (embeddedRow (primitiveRowEquiv.symm (oppositeDataEquiv q))) = r := by
    rw [embeddedRow, primitiveRowEquiv_symm_row, rowOperator_opposite]
    funext i
    fin_cases i <;> simp [oppositeDataEquiv, Equiv.ofBijective_apply, oppositeDataToPrimitive, r, map_mul]
  have hr0 : r ≠ 0 := by
    intro he
    exact ringComplex_ne_zero q.1.2 (congrFun he 0)
  have hp := heightDenominator_pos z v hv r hr0
  have hphase : (cosetCharacter (primitiveRowEquiv.symm (oppositeDataEquiv q)))⁻¹ =
      ringComplex (symbol (3 * q.2.1) (primaryIdealGenerator q.1.1)) := by
    rw [inverse_cosetCharacter_eq_row_symbol, primitiveRowEquiv_symm_row]
    change ringComplex (symbol (-3 * q.2.1) (primaryIdealGenerator q.1.1)) = _
    rw [neg_mul, symbol_neg_numerator _ _ (primaryIdealGenerator_spec q.1.1 q.1.2).2]
  rw [summand, ← rowOperator_mul, hr, rowEnergy_upperSection, hphase]
  change _ = ringComplex (symbol (3 * q.2.1) (primaryIdealGenerator q.1.1)) *
    ((v / heightDenominator z v r : ℝ) : ℂ) ^ s
  have hi : ((v / heightDenominator z v r : ℝ) : ℂ) = (((heightDenominator z v r / v : ℝ) : ℂ))⁻¹ := by
    simp only [Complex.ofReal_div, inv_div]
  rw [hi, inv_cpow_ofReal_nonneg (div_nonneg hp.le hv.le), Complex.cpow_neg]

theorem oppositeEisenstein_eq_rows (z : ℂ) (v : ℝ) (hv : 0 < v) (s : ℂ) :
    oppositeEisenstein z v hv s = ∑' q : OppositeData,
      oppositeTerm z v s (primaryIdealGenerator q.1.1) q.2.1 := by
  let e := oppositeDataEquiv.trans primitiveRowEquiv.symm
  change (∑' x : CuspCosets, summand (oppositeMatrix * upperSection z v hv) s x) = _
  rw [← e.tsum_eq (fun x => summand (oppositeMatrix * upperSection z v hv) s x)]
  exact tsum_congr (opposite_summand z v hv s)

abbrev CoprimeElement (c : O) := {x : O // IsCoprime c x}

def cubicResidueElementMap (c : O) (q : CubicUnitResidue c × O) : CoprimeElement c :=
  ⟨principalResidueRep c q.1.1 + c * q.2, by
    apply (isUnit_quotient_span_iff c _).mp
    have hc : Ideal.Quotient.mk (Ideal.span {c}) c = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
    simpa only [map_add, map_mul, hc, zero_mul, add_zero, principalResidueRep_spec] using q.1.2⟩

lemma cubicResidueElementMap_bijective (c : O) (hc : c ≠ 0) :
    Function.Bijective (cubicResidueElementMap c) := by
  have hmod (r : CubicUnitResidue c) (n : O) :
      Ideal.Quotient.mk (Ideal.span {c}) (principalResidueRep c r.1 + c * n) = r.1 := by
    have hz : Ideal.Quotient.mk (Ideal.span {c}) c = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
    rw [map_add, map_mul, hz, zero_mul, add_zero, principalResidueRep_spec]
  constructor
  · rintro ⟨r, n⟩ ⟨t, m⟩ he
    have he' := congrArg Subtype.val he
    change principalResidueRep c r.1 + c * n = principalResidueRep c t.1 + c * m at he'
    have hr : r = t := Subtype.ext (by
      simpa only [hmod] using congrArg (Ideal.Quotient.mk (Ideal.span {c})) he')
    subst t
    have hn : n = m := mul_left_cancel₀ hc (add_left_cancel he')
    subst m
    rfl
  · intro x
    let r : CubicUnitResidue c := ⟨Ideal.Quotient.mk (Ideal.span {c}) x.1,
      (isUnit_quotient_span_iff c x.1).mpr x.2⟩
    have hd : c ∣ x.1 - principalResidueRep c r.1 :=
      Ideal.mem_span_singleton.mp ((Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp
        (principalResidueRep_spec c r.1).symm)
    obtain ⟨n, hn⟩ := hd
    refine ⟨(r, n), Subtype.ext ?_⟩
    change principalResidueRep c r.1 + c * n = x.1
    linear_combination -hn

def cubicResidueElementEquiv (c : O) (hc : c ≠ 0) : CubicUnitResidue c × O ≃ CoprimeElement c :=
  Equiv.ofBijective (cubicResidueElementMap c) (cubicResidueElementMap_bijective c hc)

lemma oppositeTerm_shift (z : ℂ) (v : ℝ) (s : ℂ) (c x n : O) :
    oppositeTerm z v s c (x + c * n) = oppositeTerm (z + 3 * ringComplex n) v s c x := by
  have hs : symbol (3 * (x + c * n)) c = symbol (3 * x) c := symbol_congr ⟨3 * n, by ring⟩
  have he : ringComplex c * z + ringComplex (3 * (x + c * n)) =
      ringComplex c * (z + 3 * ringComplex n) + ringComplex (3 * x) := by
    simp only [map_mul, map_add, map_ofNat]
    ring
  rw [oppositeTerm, oppositeTerm, hs, he]

def oppositeGaussSum (h c : O) : ℂ :=
  ∑' r : CubicUnitResidue c, ringComplex (symbol (3 * principalResidueRep c r.1) c) *
    residueAdditive h c (3 * principalResidueRep c r.1)

lemma oppositeGaussSum_eq (h c : O) (hc : c ≠ 0) (hp : lambda ^ 2 ∣ c - 1) :
    oppositeGaussSum h c = cubicUnitGaussSum (9 * h) c := by
  have he : oppositeGaussSum h c = ringComplex (symbol 3 c) * cubicUnitGaussSum h c := by
    rw [oppositeGaussSum, cubicUnitGaussSum, ← tsum_mul_left]
    apply tsum_congr
    intro r
    rw [symbol_mul_numerator, map_mul]
    have ht : residueAdditive h c (3 * principalResidueRep c r.1) =
        residueAdditive (3 * h) c (principalResidueRep c r.1) := by
      unfold residueAdditive cuspFrequency
      simp only [map_mul, map_ofNat]
      congr 1
      ring
    rw [ht]
    ring
  rw [he]
  have ht := cubicUnitGaussSum_ramified_twist h 1 c hc hp
    (by simpa only [mul_one] using (primary_coprime_three c hp).symm)
  simpa only [symbol_one_numerator c hp, map_one, one_mul, mul_one] using ht

lemma continuous_inverse_fixed_left_operator (a : SL(2, ℂ)) (v : ℝ) (hv : 0 < v) :
    Continuous (fun z : ℂ => rowOperator (a * upperSection z v hv)⁻¹) := by
  have he (z : ℂ) : rowOperator (a * upperSection z v hv)⁻¹ =
      (rowOperator a⁻¹).comp (rowOperator (upperSection z v hv)⁻¹) := by
    ext u
    simp only [mul_inv_rev, ContinuousLinearMap.comp_apply, rowOperator_mul]
  simp_rw [he]
  exact continuous_const.clm_comp (continuous_inverse_upper_operator v hv)

lemma exists_fixed_left_rowBound (a : SL(2, ℂ)) (v : ℝ) (hv : 0 < v) :
    ∃ C : ℝ, 0 < C ∧ ∀ z ∈ periodDomain, rowBound (a * upperSection z v hv) ≤ C := by
  have hc : Continuous (fun z : ℂ => rowBound (a * upperSection z v hv)) :=
    continuous_const.mul (continuous_const.add (continuous_inverse_fixed_left_operator a v hv).norm)
  let R : ℝ := ∑ i : Fin 2, ‖periodBasis i‖
  obtain ⟨C, hC⟩ := (isCompact_closedBall (0 : ℂ) R).bddAbove_image hc.continuousOn
  refine ⟨max 1 C, lt_of_lt_of_le (by norm_num) (le_max_left _ _), ?_⟩
  intro z hz
  apply (hC ?_).trans (le_max_right _ _)
  exact ⟨z, by simpa only [Metric.mem_closedBall, dist_zero_right] using norm_mem_periodDomain z hz, rfl⟩

lemma continuous_fixed_left_summand (a : SL(2, ℂ)) (v : ℝ) (hv : 0 < v) (s : ℂ) (x : CuspCosets) :
    Continuous (fun z : ℂ => summand (a * upperSection z v hv) s x) := by
  simp_rw [summand, ← rowOperator_mul, rowEnergy_upperSection]
  apply continuous_const.mul
  apply Continuous.cpow
  · apply Complex.continuous_ofReal.comp
    unfold heightDenominator
    fun_prop
  · exact continuous_const
  · intro z
    apply Complex.ofReal_mem_slitPlane.mpr
    exact div_pos (heightDenominator_pos z v hv _ (rowOperator_ne_zero a _ (embeddedRow_ne_zero x))) hv

/-- A fixed change of cusp preserves the summable integral-row majorant. -/
lemma fixed_left_summable_majorant (a : SL(2, ℂ)) (v : ℝ) (hv : 0 < v) (s : ℂ) (hs : 2 < s.re) :
    ∃ M : CuspCosets → ℝ, Summable M ∧ (∀ x, 0 ≤ M x) ∧
      ∀ z ∈ periodDomain, ∀ x, ‖summand (a * upperSection z v hv) s x‖ ≤ M x := by
  obtain ⟨C, hC, hbound⟩ := exists_fixed_left_rowBound a v hv
  refine ⟨fun x => C ^ (2 * s.re) * ‖rowCoordinates (cosetRow x)‖ ^ (-(2 * s.re)), ?_, ?_, ?_⟩
  · exact ((summable_integer_four_rpow (2 * s.re) (by linarith)).comp_injective
      (rowCoordinates_injective.comp cosetRow_injective)).mul_left _
  · intro x
    positivity
  · intro z hz x
    apply (norm_summand_bound (a * upperSection z v hv) s (by linarith) x).trans
    exact mul_le_mul_of_nonneg_right
      (Real.rpow_le_rpow (rowBound_pos _).le (hbound z hz) (by linarith)) (by positivity)

theorem hasSum_integral_fixed_left_Eisenstein (a : SL(2, ℂ)) (v : ℝ) (hv : 0 < v)
    (s freq : ℂ) (hs : 2 < s.re) :
    HasSum (fun x : CuspCosets => ∫ z in periodDomain,
      summand (a * upperSection z v hv) s x * tracePhase (-freq * z))
      (∫ z in periodDomain, eisenstein (a * upperSection z v hv) s * tracePhase (-freq * z)) := by
  letI : Countable CuspCosets := (rowCoordinates_injective.comp cosetRow_injective).countable
  letI := periodDomain_finiteMeasure
  obtain ⟨M, hM, _, hbound⟩ := fixed_left_summable_majorant a v hv s hs
  have hchar : Continuous (fun z : ℂ => tracePhase (-freq * z)) := by
    change Continuous (fun z : ℂ => Complex.exp (2 * Real.pi * Complex.I *
      ((-freq * z) + starRingEnd ℂ (-freq * z))))
    fun_prop
  exact hasSum_integral_of_dominated_convergence (μ := volume.restrict periodDomain)
    (fun (x : CuspCosets) (_ : ℂ) => M x)
    (fun x => ((continuous_fixed_left_summand a v hv s x).mul hchar).aestronglyMeasurable.restrict)
    (fun x => (ae_restrict_mem periodDomain_measurable).mono fun z hz => by
      simpa only [Pi.mul_apply, norm_mul, tracePhase_norm, mul_one] using hbound z hz x)
    (Eventually.of_forall fun _ => hM) (integrable_const (∑' x, M x))
    (Eventually.of_forall fun z => (summable_summand (a * upperSection z v hv) s hs).hasSum.mul_right
      (tracePhase (-freq * z)))

def oppositeIntegral (v : ℝ) (s freq : ℂ) (c x : O) : ℂ :=
  ∫ z in periodDomain, oppositeTerm z v s c x * tracePhase (-freq * z)

theorem hasSum_oppositeIntegrals (v : ℝ) (hv : 0 < v) (s freq : ℂ) (hs : 2 < s.re) :
    HasSum (fun q : OppositeData => oppositeIntegral v s freq (primaryIdealGenerator q.1.1) q.2.1)
      (∫ z in periodDomain, oppositeEisenstein z v hv s * tracePhase (-freq * z)) := by
  have he := (oppositeDataEquiv.trans primitiveRowEquiv.symm).hasSum_iff.mpr
    (hasSum_integral_fixed_left_Eisenstein oppositeMatrix v hv s freq hs)
  apply he.congr_fun
  intro q
  apply integral_congr_ae
  exact Eventually.of_forall fun z => by
    dsimp only [Equiv.trans_apply]
    rw [opposite_summand]

lemma oppositeTerm_integrable (v : ℝ) (hv : 0 < v) (s : ℂ) (hs : 1 < s.re)
    (c x : O) (hc : c ≠ 0) : Integrable (fun z => oppositeTerm z v s c x) := by
  simp_rw [oppositeTerm_eq_shifted _ v hv s c x hc]
  exact (shiftedHeightKernel_integrable v hv s _ hs).const_mul _

lemma oppositeIntegral_sum_translate (v : ℝ) (hv : 0 < v) (s : ℂ) (hs : 1 < s.re)
    (h c x : O) (hc : c ≠ 0) :
    (∑' n : O, oppositeIntegral v s (cuspFrequency h) c (x + c * n)) =
      ∫ z : ℂ, oppositeTerm z v s c x * tracePhase (-cuspFrequency h * z) := by
  have hi := trace_mul_integrable (fun z => oppositeTerm z v s c x)
    (oppositeTerm_integrable v hv s hs c x hc) (cuspFrequency h)
  rw [integral_eq_period_integrals _ hi]
  apply tsum_congr
  intro n
  apply integral_congr_ae
  exact Eventually.of_forall fun z => by
    dsimp only [oppositeIntegral]
    rw [oppositeTerm_shift, cuspFrequency_negative_period]

lemma oppositeTerm_fourier_integral (v : ℝ) (hv : 0 < v) (s freq : ℂ)
    (c x : O) (hc : c ≠ 0) :
    (∫ z : ℂ, oppositeTerm z v s c x * tracePhase (-freq * z)) =
      ((v : ℂ) ^ (2 - s) * sourceFourierKernel s (freq * v)) * ((‖ringComplex c‖ ^ 2 : ℝ) : ℂ) ^ (-s) *
        (ringComplex (symbol (3 * x) c) * tracePhase (freq * ringComplex (3 * x) / ringComplex c)) := by
  simp_rw [oppositeTerm_eq_shifted _ v hv s c x hc, mul_assoc]
  rw [integral_const_mul, integral_const_mul,
    traceIntegral_shiftedHeightKernel v hv s (ringComplex (3 * x) / ringComplex c) freq]
  ring_nf

lemma oppositeDenominator_integral_formula (v : ℝ) (hv : 0 < v) (s : ℂ) (hs : 2 < s.re)
    (h : O) (I : GoodIdeal) :
    (∑' x : CoprimeElement (primaryIdealGenerator I.1),
      oppositeIntegral v s (cuspFrequency h) (primaryIdealGenerator I.1) x.1) =
      ((v : ℂ) ^ (2 - s) * sourceFourierKernel s (cuspFrequency h * v)) *
        (unramifiedNormWeight s I.1 * cubicUnitGaussSum (9 * h) (primaryIdealGenerator I.1)) := by
  let c := primaryIdealGenerator I.1
  let F : CoprimeElement c → ℂ := fun x => oppositeIntegral v s (cuspFrequency h) c x.1
  have hf : Summable F := (hasSum_oppositeIntegrals v hv s (cuspFrequency h) hs).summable.sigma_factor I
  let e := cubicResidueElementEquiv c I.2
  have hsum : Summable (fun q : CubicUnitResidue c × O => F (e q)) := e.summable_iff.mpr hf
  change (∑' x, F x) = _
  rw [← e.tsum_eq F, hsum.tsum_prod]
  change (∑' r : CubicUnitResidue c, ∑' n : O,
    oppositeIntegral v s (cuspFrequency h) c (principalResidueRep c r.1 + c * n)) = _
  simp_rw [oppositeIntegral_sum_translate v hv s (by linarith) h c _ I.2,
    oppositeTerm_fourier_integral v hv s (cuspFrequency h) c _ I.2]
  have he : ((‖ringComplex c‖ ^ 2 : ℝ) : ℂ) ^ (-s) = unramifiedNormWeight s I.1 := by
    rw [unramifiedNormWeight_of_good s I.1 I.2, primaryIdealGenerator_norm_sq I.1 I.2,
      Complex.ofReal_natCast]
  rw [he, ← oppositeGaussSum_eq h c I.2 (primaryIdealGenerator_spec I.1 I.2).2]
  change (∑' r : CubicUnitResidue c, _ *
    (ringComplex (symbol (3 * principalResidueRep c r.1) c) * residueAdditive h c (3 * principalResidueRep c r.1))) = _
  rw [tsum_mul_left]
  unfold oppositeGaussSum
  ring

lemma unramifiedCubicGaussSeries_twentySeven (s : ℂ) (h : O) :
    unramifiedCubicGaussSeries s (27 * h) = unramifiedCubicGaussSeries s h := by
  apply tsum_congr
  intro I
  congr 1
  have hp := (primaryIdealGenerator_spec I.1 I.2).2
  simpa only [show (3 : O) ^ 3 = 27 by norm_num, mul_comm h 27] using
    cubicUnitGaussSum_cube_shift h (primaryIdealGenerator I.1) 3 I.2 hp (primary_coprime_three _ hp)

/-- Fourier unfolding at the opposite cusp gives the ordinary unramified Gauss series. -/
theorem oppositeEisenstein_fourier (v : ℝ) (hv : 0 < v) (s : ℂ) (hs : 2 < s.re) (h : O) :
    (∫ z in periodDomain, oppositeEisenstein z v hv s * tracePhase (-cuspFrequency h * z)) =
      ((v : ℂ) ^ (2 - s) * sourceFourierKernel s (cuspFrequency h * v)) *
        unramifiedCubicGaussSeries s (9 * h) := by
  have he := hasSum_oppositeIntegrals v hv s (cuspFrequency h) hs
  rw [← he.tsum_eq, he.summable.tsum_sigma]
  simp_rw [oppositeDenominator_integral_formula v hv s hs h]
  exact tsum_mul_left

def primeExpansionTerm (p : O) (s : ℂ) (h : O) (k : ℕ) : ℂ :=
  unramifiedNormWeight s (Ideal.span {p}) ^ k * cubicUnitGaussSum h (p ^ k) *
    unramifiedPrimeDeletedSeries p s (h * p ^ k)

lemma primeExpansionTerm_summable (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1)
    (s : ℂ) (hs : 2 < s.re) (h : O) : Summable (primeExpansionTerm p s h) := by
  let F : GoodIdeal → ℂ := fun I =>
    unramifiedNormWeight s I.1 * cubicUnitGaussSum h (primaryIdealGenerator I.1)
  have hf : Summable F := (unramifiedCubicGaussSeries_summable_norm s hs h).of_norm
  let e := gaussPrimeFactorEquiv p hp hprimary
  have he : Summable (fun q : ℕ × PrimeDeletedIdeal p => F (e q)) := e.summable_iff.mpr hf
  apply he.prod.congr
  intro n
  change (∑' I : PrimeDeletedIdeal p,
    unramifiedNormWeight s (gaussPrimeFactorMap p hp hprimary (n, I)).1 *
      cubicUnitGaussSum h (primaryIdealGenerator (gaussPrimeFactorMap p hp hprimary (n, I)).1)) = _
  simp_rw [gaussPrimeFactor_term p hp hprimary s h n]
  exact tsum_mul_left

lemma primeExpansionTerm_cube_shift (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1)
    (s : ℂ) (h : O) (k : ℕ) :
    primeExpansionTerm p s (h * p ^ 3) (k + 3) =
      (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 * unramifiedNormWeight s (Ideal.span {p}) ^ 3 *
        primeExpansionTerm p s h k -
      if k = 0 then (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 2 * unramifiedNormWeight s (Ideal.span {p}) ^ 3 *
        unramifiedPrimeDeletedSeries p s h else 0 := by
  have hv : unramifiedPrimeDeletedSeries p s (h * p ^ 3 * p ^ (k + 3)) =
      unramifiedPrimeDeletedSeries p s (h * p ^ k) := by
    rw [show h * p ^ 3 * p ^ (k + 3) = (h * p ^ k * p ^ 3) * p ^ 3 by rw [pow_add]; ring,
      unramifiedPrimeDeletedSeries_cube_shift p hp, unramifiedPrimeDeletedSeries_cube_shift p hp]
  unfold primeExpansionTerm
  rw [cubicUnitGaussSum_prime_cube_shift p hp hprimary k h, hv, pow_add]
  split_ifs with hk
  · subst k
    simp only [pow_zero, mul_one, cubicUnitGaussSum_one]
    ring
  · ring

/-- The conductor shift gives a cubic recurrence at every frequency, including zero. -/
theorem unramifiedCubicGaussSeries_cube_step (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (s : ℂ) (hs : 2 < s.re) (h : O) :
    unramifiedCubicGaussSeries s (h * p ^ 3) =
      (1 - (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 2 * unramifiedNormWeight s (Ideal.span {p}) ^ 3) *
        unramifiedPrimeDeletedSeries p s h +
      (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 * unramifiedNormWeight s (Ideal.span {p}) ^ 3 *
        unramifiedCubicGaussSeries s h := by
  have hzero (k : ℕ) (hk : k ≤ 3) :
      cubicUnitGaussSum (h * p ^ 3) (p ^ k) = cubicUnitGaussSum 0 (p ^ k) :=
    cubicUnitGaussSum_frequency_dvd _ _ (pow_ne_zero _ hp.ne_zero)
      ((pow_dvd_pow p hk).trans (dvd_mul_left (p ^ 3) h))
  have hg1 : cubicUnitGaussSum (h * p ^ 3) p = 0 := by
    have he := hzero 1 (by omega)
    simp only [pow_one] at he
    rw [he]
    simpa using cubicUnitGaussSum_prime_power_zero p hp hprimary 0
  have hg2 : cubicUnitGaussSum (h * p ^ 3) (p ^ 2) = 0 := by
    rw [hzero 2 (by omega)]
    simpa using cubicUnitGaussSum_prime_power_zero p hp hprimary 1
  have hsmall : (∑ k ∈ Finset.range 3, primeExpansionTerm p s (h * p ^ 3) k) =
      unramifiedPrimeDeletedSeries p s h := by
    simp only [Finset.sum_range_succ, Finset.sum_range_zero, primeExpansionTerm,
      pow_zero, pow_one, cubicUnitGaussSum_one, mul_one, one_mul, zero_add, hg1, hg2,
      mul_zero, zero_mul, add_zero]
    exact unramifiedPrimeDeletedSeries_cube_shift p hp s h
  have hsum := primeExpansionTerm_summable p hp hprimary s hs h
  have hsum' := primeExpansionTerm_summable p hp hprimary s hs (h * p ^ 3)
  rw [unramifiedCubicGaussSeries_prime_reindex p hp hprimary s hs (h * p ^ 3)]
  change (∑' k, primeExpansionTerm p s (h * p ^ 3) k) = _
  rw [← hsum'.sum_add_tsum_nat_add 3, hsmall]
  simp_rw [primeExpansionTerm_cube_shift p hp hprimary s h]
  rw [(hsum.mul_left _).tsum_sub (hasSum_ite_eq (0 : ℕ)
      ((Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 2 * unramifiedNormWeight s (Ideal.span {p}) ^ 3 *
        unramifiedPrimeDeletedSeries p s h)).summable,
    tsum_mul_left, tsum_ite_eq]
  have he : (∑' k, primeExpansionTerm p s h k) = unramifiedCubicGaussSeries s h :=
    (unramifiedCubicGaussSeries_prime_reindex p hp hprimary s hs h).symm
  rw [he]
  ring

theorem unramifiedCubicGaussSeries_cube_recurrence (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (s : ℂ) (hs : 2 < s.re) (h : O) :
    unramifiedCubicGaussSeries s (h * p ^ 6) =
      (1 + (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 * unramifiedNormWeight s (Ideal.span {p}) ^ 3) *
        unramifiedCubicGaussSeries s (h * p ^ 3) -
      (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 * unramifiedNormWeight s (Ideal.span {p}) ^ 3 *
        unramifiedCubicGaussSeries s h := by
  have hfirst := unramifiedCubicGaussSeries_cube_step p hp hprimary s hs h
  have hsecond := unramifiedCubicGaussSeries_cube_step p hp hprimary s hs (h * p ^ 3)
  rw [unramifiedPrimeDeletedSeries_cube_shift p hp,
    show h * p ^ 3 * p ^ 3 = h * p ^ 6 by ring] at hsecond
  linear_combination hsecond - hfirst

def oppositeSource : rationalExtension := rationalSourceLift ModularGroup.S

lemma oppositeSource_matrix : integralComplexMatrix (oppositeSource : SL(2, O)) = oppositeMatrix := by
  apply Subtype.ext
  apply Matrix.ext
  intro i j
  fin_cases i <;> fin_cases j <;>
    simp [oppositeSource, rationalSourceLift, rationalEmbedding, integralComplexMatrix,
      Matrix.SpecialLinearGroup.map_apply_coe, ModularGroup.coe_S, oppositeMatrix]

lemma hyperbolicEisenstein_opposite_upper (s : ℂ) (z : ℂ) (v : ℝ) (hv : 0 < v) :
    hyperbolicEisenstein s (integralComplexMatrix (oppositeSource : SL(2, O)) • upperPoint z v hv) =
      oppositeEisenstein z v hv s := by
  rw [oppositeSource_matrix]
  rfl

theorem opposite_cusp_fourier_average (s : ℂ) (hs : 2 < s.re) (h : O) :
    (∫ w in cuspPeriodStrip 5 6,
      hyperbolicEisenstein s (integralComplexMatrix (oppositeSource : SL(2, O)) • w) *
        cuspFourierPhase h w ∂hyperbolicVolume) =
      unramifiedCubicGaussSeries s (9 * h) * cuspWhittakerHeightFactor s h := by
  let g : HyperbolicSpace → ℂ := fun w =>
    hyperbolicEisenstein s (integralComplexMatrix (oppositeSource : SL(2, O)) • w) * cuspFourierPhase h w
  have hg : Continuous g := ((hyperbolicEisenstein_continuous s hs).comp
    (continuous_hyperbolic_action _)).mul (cuspFourierPhase_continuous h)
  rw [cuspPeriodStrip_integral_coordinates g hg.aestronglyMeasurable (cuspCoordinateLift_weighted_integrable g hg)]
  have he : (∫ v in Set.Icc (5 : ℝ) 6,
      (∫ z in periodDomain, g (cuspCoordinateLift (v, z))) / (v : ℂ) ^ 3) =
      ∫ v in Set.Icc (5 : ℝ) 6, unramifiedCubicGaussSeries s (9 * h) *
        ((v : ℂ) ^ (-s - 1) * sourceFourierKernel s (cuspFrequency h * v)) := by
    apply setIntegral_congr_fun measurableSet_Icc
    intro v hv
    have hv0 : 0 < v := lt_of_lt_of_le (by norm_num) hv.1
    have hvz : (v : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hv0.ne'
    have hslice : (∫ z in periodDomain, g (cuspCoordinateLift (v, z))) =
        ((v : ℂ) ^ (2 - s) * sourceFourierKernel s (cuspFrequency h * v)) *
          unramifiedCubicGaussSeries s (9 * h) := by
      simp_rw [g, cuspCoordinateLift_positive v _ hv0, hyperbolicEisenstein_opposite_upper,
        cuspFourierPhase, hyperbolicHorizontal_upperPoint]
      exact oppositeEisenstein_fourier v hv0 s hs h
    have hp : (v : ℂ) ^ (-s - 1) = (v : ℂ) ^ (2 - s) / (v : ℂ) ^ 3 := by
      rw [show -s - 1 = (2 - s) - 3 by ring, Complex.cpow_sub _ _ hvz]
      congr 1
      exact Complex.cpow_natCast _ 3
    dsimp only
    rw [hslice, hp]
    ring
  rw [he, integral_const_mul]
  rfl

lemma rationalCuspFamily_opposite_initial (h : O) (s : ℂ) (hs : 4 < s.re) (hi : 0 < s.im) :
    rationalCuspFamily (3 * h) oppositeSource 2 3 (by norm_num) (by norm_num) s =
      unramifiedCubicGaussSeries s h * cuspWhittakerHeightFactor s (3 * h) := by
  rw [rationalCuspFamily_initial (3 * h) oppositeSource 2 3
    (by norm_num) (by norm_num) (by norm_num) s hs hi,
    opposite_cusp_fourier_average s (by linarith),
    show (9 : O) * (3 * h) = 27 * h by ring, unramifiedCubicGaussSeries_twentySeven]

/-- Meromorphic continuation supplied by the opposite-cusp test of the actual resolvent. -/
def continuedUnramifiedGauss (h : O) (s : ℂ) : ℂ :=
  rationalCuspFamily (3 * h) oppositeSource 2 3 (by norm_num) (by norm_num) s /
    cuspWhittakerHeightFactor s (3 * h)

def unramifiedGaussResidue (h : O) : ℂ :=
  rationalCuspFourier (3 * h) oppositeSource cubicEisensteinResidue /
    cuspWhittakerHeightFactor (4 / 3 : ℂ) (3 * h)

theorem continuedUnramifiedGauss_meromorphicAt_center (h : O) :
    MeromorphicAt (continuedUnramifiedGauss h) (4 / 3 : ℂ) :=
  (rationalCuspFamily_meromorphicAt (3 * h) oppositeSource 2 3 (by norm_num) (by norm_num)).div
    (cuspWhittakerHeightFactor_analyticAt (3 * h) (4 / 3) (by norm_num)).meromorphicAt

theorem continuedUnramifiedGauss_meromorphicOn_upper (h : O) :
    MeromorphicOn (continuedUnramifiedGauss h) {s : ℂ | 1 < s.re ∧ 0 < s.im} := by
  intro s hs
  exact (rationalCuspFamily_analyticAt_nonreal (3 * h) oppositeSource 2 3
    (by norm_num) (by norm_num) s hs.1.ne' hs.2.ne').meromorphicAt.div
      (cuspWhittakerHeightFactor_analyticAt (3 * h) s hs.1).meromorphicAt

theorem continuedUnramifiedGauss_residue_limit (h : O) :
    Tendsto (fun s : ℂ => (s - 4 / 3) * continuedUnramifiedGauss h s)
      (𝓝[≠] (4 / 3 : ℂ)) (𝓝 (unramifiedGaussResidue h)) := by
  have hd : Tendsto (fun s : ℂ => cuspWhittakerHeightFactor s (3 * h))
      (𝓝[≠] (4 / 3 : ℂ)) (𝓝 (cuspWhittakerHeightFactor (4 / 3 : ℂ) (3 * h))) :=
    (cuspWhittakerHeightFactor_analyticAt (3 * h) (4 / 3) (by norm_num)).continuousAt.tendsto.mono_left
      nhdsWithin_le_nhds
  have he := (rationalCuspFamily_residue_limit (3 * h) oppositeSource 2 3
    (by norm_num) (by norm_num)).div hd (cuspWhittakerHeightFactor_center_ne_zero (3 * h))
  convert he using 1
  · funext s
    simp only [continuedUnramifiedGauss, Pi.div_apply]
    ring
  · rfl

theorem continuedUnramifiedGauss_initial (h : O) (s : ℂ) (hs : 4 < s.re) (hi : 0 < s.im)
    (hH : cuspWhittakerHeightFactor s (3 * h) ≠ 0) :
    continuedUnramifiedGauss h s = unramifiedCubicGaussSeries s h := by
  rw [continuedUnramifiedGauss, rationalCuspFamily_opposite_initial h s hs hi, mul_div_cancel_right₀ _ hH]

lemma unramifiedCubicGaussSeries_prime_two_power (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (s : ℂ) (hs : 2 < s.re) (h : O) (hph : ¬ p ∣ h) :
    unramifiedCubicGaussSeries s (h * p ^ 2) =
      (1 - (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 2 * unramifiedNormWeight s (Ideal.span {p}) ^ 3) *
        unramifiedPrimeDeletedSeries p s (h * p ^ 2) := by
  have he := unramifiedCubicGaussSeries_prime_finite p hp hprimary s hs h hph 2
  have hg1 : cubicUnitGaussSum (h * p ^ 2) p = 0 := by
    rw [cubicUnitGaussSum_frequency_dvd _ p hp.ne_zero
      ((dvd_pow_self p (by decide : (2 : ℕ) ≠ 0)).trans (dvd_mul_left (p ^ 2) h))]
    simpa using cubicUnitGaussSum_prime_power_zero p hp hprimary 0
  have hg2 : cubicUnitGaussSum (h * p ^ 2) (p ^ 2) = 0 := by
    rw [cubicUnitGaussSum_frequency_dvd _ (p ^ 2) (pow_ne_zero _ hp.ne_zero) (dvd_mul_left (p ^ 2) h)]
    simpa using cubicUnitGaussSum_prime_power_zero p hp hprimary 1
  have hg3 : cubicUnitGaussSum (h * p ^ 2) (p ^ 3) = -(Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 2 := by
    have hh := cubicUnitGaussSum_prime_power_lift p hp hprimary 2 h
    rw [primeCubicGauss_trivial_nonzero p hp hprimary 3 (dvd_refl 3) h hph] at hh
    simpa only [mul_comm (p ^ 2) h, mul_neg_one] using hh
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, zero_add, pow_zero, pow_one,
    cubicUnitGaussSum_one, mul_one, one_mul, hg1, hg2, hg3, mul_zero, zero_mul, add_zero] at he
  rw [unramifiedPrimeDeletedSeries_cube_shift p hp] at he
  exact he.trans (by ring)

lemma unramifiedCubicGaussSeries_square_cube (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (s : ℂ) (hs : 2 < s.re) (h : O) (hph : ¬ p ∣ h) :
    unramifiedCubicGaussSeries s (h * p ^ 5) =
      (1 + (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 * unramifiedNormWeight s (Ideal.span {p}) ^ 3) *
        unramifiedCubicGaussSeries s (h * p ^ 2) := by
  have he := unramifiedCubicGaussSeries_cube_step p hp hprimary s hs (h * p ^ 2)
  rw [← unramifiedCubicGaussSeries_prime_two_power p hp hprimary s hs h hph,
    show h * p ^ 2 * p ^ 3 = h * p ^ 5 by ring] at he
  exact he.trans (by ring)

/-- Clearing analytic height factors transfers a scalar relation from the initial half-plane to residues. -/
theorem cuspScalarResidue_relation {ι : Type*} (T H : ι → ℂ → ℂ) (R : ι → ℂ)
    (hT : ∀ i, AnalyticOnNhd ℂ (T i) {s : ℂ | 1 < s.re ∧ 0 < s.im})
    (hH : ∀ i, AnalyticOnNhd ℂ (H i) {s : ℂ | 1 < s.re ∧ 0 < s.im})
    (hHc : ∀ i, ContinuousAt (H i) (4 / 3 : ℂ))
    (hR : ∀ i, Tendsto (fun s : ℂ => (s - 4 / 3) * T i s) (𝓝[≠] (4 / 3 : ℂ)) (𝓝 (R i)))
    (hHne : ∀ i, H i (4 / 3) ≠ 0) (i0 i1 i2 : ι) (A B : ℂ → ℂ)
    (hA : AnalyticOnNhd ℂ A {s : ℂ | 1 < s.re ∧ 0 < s.im})
    (hB : AnalyticOnNhd ℂ B {s : ℂ | 1 < s.re ∧ 0 < s.im})
    (hAc : ContinuousAt A (4 / 3 : ℂ)) (hBc : ContinuousAt B (4 / 3 : ℂ))
    (hrel : ∀ s : ℂ, 4 < s.re → 0 < s.im →
      T i0 s * H i1 s * H i2 s =
        A s * T i1 s * H i0 s * H i2 s + B s * T i2 s * H i0 s * H i1 s) :
    R i0 / H i0 (4 / 3) = A (4 / 3) * (R i1 / H i1 (4 / 3)) +
      B (4 / 3) * (R i2 / H i2 (4 / 3)) := by
  let D : Set ℂ := {s | 1 < s.re ∧ 0 < s.im}
  let f : ℂ → ℂ := fun s => T i0 s * H i1 s * H i2 s
  let g : ℂ → ℂ := fun s => A s * T i1 s * H i0 s * H i2 s + B s * T i2 s * H i0 s * H i1 s
  have hf : AnalyticOnNhd ℂ f D := fun s hs => ((hT i0 s hs).mul (hH i1 s hs)).mul (hH i2 s hs)
  have hg : AnalyticOnNhd ℂ g D := fun s hs =>
    ((((hA s hs).mul (hT i1 s hs)).mul (hH i0 s hs)).mul (hH i2 s hs)).add
      ((((hB s hs).mul (hT i2 s hs)).mul (hH i0 s hs)).mul (hH i1 s hs))
  have hconvex : Convex ℝ D :=
    ((convex_Ioi (1 : ℝ)).linear_preimage Complex.reCLM.toLinearMap).inter
      ((convex_Ioi (0 : ℝ)).linear_preimage Complex.imCLM.toLinearMap)
  have hopen : IsOpen {s : ℂ | 4 < s.re ∧ 0 < s.im} :=
    (isOpen_lt continuous_const Complex.continuous_re).inter
      (isOpen_lt continuous_const Complex.continuous_im)
  have hev : f =ᶠ[𝓝 (5 + Complex.I : ℂ)] g := by
    filter_upwards [hopen.mem_nhds (by norm_num)] with s hs
    exact hrel s hs.1 hs.2
  have heq := hf.eqOn_of_preconnected_of_eventuallyEq hg hconvex.isPreconnected
    (by norm_num [D] : (5 + Complex.I : ℂ) ∈ D) hev
  have hlimH (i : ι) : Tendsto (H i) (𝓝[≠] (4 / 3 : ℂ)) (𝓝 (H i (4 / 3))) :=
    (hHc i).tendsto.mono_left nhdsWithin_le_nhds
  have hl := (((hR i0).mul (hlimH i1)).mul (hlimH i2)).comp thetaApproach_tendsto_complex_punctured
  have hrightA := (((hAc.tendsto.mono_left nhdsWithin_le_nhds).mul (hR i1)).mul (hlimH i0)).mul (hlimH i2)
  have hrightB := (((hBc.tendsto.mono_left nhdsWithin_le_nhds).mul (hR i2)).mul (hlimH i0)).mul (hlimH i1)
  have hr := (hrightA.add hrightB).comp thetaApproach_tendsto_complex_punctured
  have hcross : R i0 * H i1 (4 / 3) * H i2 (4 / 3) =
      A (4 / 3) * R i1 * H i0 (4 / 3) * H i2 (4 / 3) +
      B (4 / 3) * R i2 * H i0 (4 / 3) * H i1 (4 / 3) := by
    apply tendsto_nhds_unique_of_eventuallyEq hl hr
    filter_upwards [self_mem_nhdsWithin] with t ht
    change 0 < t at ht
    have htD : (4 / 3 : ℂ) + (t : ℂ) + (t : ℂ) * Complex.I ∈ D := by
      constructor
      · norm_num
        linarith
      · simpa using ht
    have hc := heq htD
    dsimp only [Function.comp_def, f, g] at *
    linear_combination (((4 / 3 : ℂ) + (t : ℂ) + (t : ℂ) * Complex.I) - 4 / 3) * hc
  field_simp [hHne i0, hHne i1, hHne i2]
  linear_combination hcross

/-- Analytic uniqueness transfers an initial Gauss-series relation to the actual residues.
Multiplying by the three Whittaker factors avoids dividing at their possible zeros. -/
theorem unramifiedGaussResidue_of_initial_relation (h0 h1 h2 : O) (A B : ℂ → ℂ)
    (hA : AnalyticOnNhd ℂ A {s : ℂ | 1 < s.re ∧ 0 < s.im})
    (hB : AnalyticOnNhd ℂ B {s : ℂ | 1 < s.re ∧ 0 < s.im})
    (hAc : ContinuousAt A (4 / 3 : ℂ)) (hBc : ContinuousAt B (4 / 3 : ℂ))
    (hrel : ∀ s : ℂ, 4 < s.re → 0 < s.im → unramifiedCubicGaussSeries s h0 =
      A s * unramifiedCubicGaussSeries s h1 + B s * unramifiedCubicGaussSeries s h2) :
    unramifiedGaussResidue h0 = A (4 / 3) * unramifiedGaussResidue h1 +
      B (4 / 3) * unramifiedGaussResidue h2 := by
  unfold unramifiedGaussResidue
  apply cuspScalarResidue_relation
    (fun h => rationalCuspFamily (3 * h) oppositeSource 2 3 (by norm_num) (by norm_num))
    (fun h s => cuspWhittakerHeightFactor s (3 * h))
    (fun h => rationalCuspFourier (3 * h) oppositeSource cubicEisensteinResidue)
    (fun h s hs => rationalCuspFamily_analyticAt_nonreal (3 * h) oppositeSource 2 3
      (by norm_num) (by norm_num) s hs.1.ne' hs.2.ne')
    (fun h s hs => cuspWhittakerHeightFactor_analyticAt (3 * h) s hs.1)
    (fun h => (cuspWhittakerHeightFactor_analyticAt (3 * h) (4 / 3) (by norm_num)).continuousAt)
    (fun h => rationalCuspFamily_residue_limit (3 * h) oppositeSource 2 3 (by norm_num) (by norm_num))
    (fun h => cuspWhittakerHeightFactor_center_ne_zero (3 * h)) h0 h1 h2 A B hA hB hAc hBc
  intro s hs hi
  rw [rationalCuspFamily_opposite_initial h0 s hs hi,
    rationalCuspFamily_opposite_initial h1 s hs hi,
    rationalCuspFamily_opposite_initial h2 s hs hi, hrel s hs hi]
  ring

lemma gaussPrimeWeight_analytic (p : O) (hp : Prime p) (s : ℂ) :
    AnalyticAt ℂ (fun z : ℂ => (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-z)) s := by
  apply Complex.analyticAt_iff_eventually_differentiableAt.mpr
  exact Eventually.of_forall fun z => (differentiableAt_id.neg).const_cpow (Or.inl
    (Nat.cast_ne_zero.mpr (Ideal.absNorm_eq_zero_iff.not.mpr (Ideal.span_singleton_eq_bot.not.mpr hp.ne_zero))))

lemma gaussPrimeWeight_center (p : O) (hp : Prime p) :
    (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 *
      ((Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-(4 / 3 : ℂ))) ^ 3 =
      (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ := by
  have hq : (Ideal.absNorm (Ideal.span {p}) : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr
    (Ideal.absNorm_eq_zero_iff.not.mpr (Ideal.span_singleton_eq_bot.not.mpr hp.ne_zero))
  rw [← Complex.cpow_nat_mul, ← Complex.cpow_natCast _ 3, ← Complex.cpow_add _ _ hq]
  convert Complex.cpow_neg_one (Ideal.absNorm (Ideal.span {p}) : ℂ) using 1
  congr 1
  norm_num

/-- The residue satisfies the exact prime recurrence with coefficient `1+N(p)⁻¹`. -/
theorem unramifiedGaussResidue_prime_recurrence (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hph : ¬ p ∣ h) :
    unramifiedGaussResidue (h * p ^ 3) =
      (1 + (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹) * unramifiedGaussResidue h -
      (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-(4 / 3 : ℂ)) * primeCubicGauss p hp hprimary 1 h *
        unramifiedGaussResidue (h * p) := by
  let A : ℂ → ℂ := fun s => 1 + (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 *
    ((Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-s)) ^ 3
  let B : ℂ → ℂ := fun s => -((Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-s) * primeCubicGauss p hp hprimary 1 h)
  have hA (s : ℂ) : AnalyticAt ℂ A s := analyticAt_const.add
    (analyticAt_const.mul ((gaussPrimeWeight_analytic p hp s).pow 3))
  have hB (s : ℂ) : AnalyticAt ℂ B s := ((gaussPrimeWeight_analytic p hp s).mul analyticAt_const).neg
  have hgood : primaryIdealGenerator (Ideal.span {p}) ≠ 0 := by
    rw [primaryIdealGenerator_span p hp.ne_zero hprimary]
    exact hp.ne_zero
  have he := unramifiedGaussResidue_of_initial_relation (h * p ^ 3) h (h * p) A B
    (fun s _ => hA s) (fun s _ => hB s) (hA _).continuousAt (hB _).continuousAt (by
      intro s hs hi
      have hh := unramifiedCubicGaussSeries_prime_recurrence p hp hprimary s (by linarith) h hph
      rw [unramifiedNormWeight_of_good s _ hgood] at hh
      simpa only [A, B, neg_mul, sub_eq_add_neg] using hh)
  dsimp only [A, B] at he
  rw [gaussPrimeWeight_center p hp] at he
  simpa only [neg_mul, sub_eq_add_neg] using he

theorem unramifiedGaussResidue_cube_recurrence (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) :
    unramifiedGaussResidue (h * p ^ 6) =
      (1 + (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹) * unramifiedGaussResidue (h * p ^ 3) -
      (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ * unramifiedGaussResidue h := by
  let A : ℂ → ℂ := fun s => 1 + (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 *
    ((Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-s)) ^ 3
  let B : ℂ → ℂ := fun s => -((Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 *
    ((Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-s)) ^ 3)
  have hA (s : ℂ) : AnalyticAt ℂ A s := analyticAt_const.add
    (analyticAt_const.mul ((gaussPrimeWeight_analytic p hp s).pow 3))
  have hB (s : ℂ) : AnalyticAt ℂ B s :=
    (analyticAt_const.mul ((gaussPrimeWeight_analytic p hp s).pow 3)).neg
  have hgood : primaryIdealGenerator (Ideal.span {p}) ≠ 0 := by
    rw [primaryIdealGenerator_span p hp.ne_zero hprimary]
    exact hp.ne_zero
  have he := unramifiedGaussResidue_of_initial_relation (h * p ^ 6) (h * p ^ 3) h A B
    (fun s _ => hA s) (fun s _ => hB s) (hA _).continuousAt (hB _).continuousAt (by
      intro s hs hi
      have hh := unramifiedCubicGaussSeries_cube_recurrence p hp hprimary s (by linarith) h
      rw [unramifiedNormWeight_of_good s _ hgood] at hh
      simpa only [A, B, neg_mul, sub_eq_add_neg] using hh)
  dsimp only [A, B] at he
  rw [gaussPrimeWeight_center p hp] at he
  simpa only [neg_mul, sub_eq_add_neg] using he

theorem unramifiedGaussResidue_square_cube (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hph : ¬ p ∣ h) :
    unramifiedGaussResidue (h * p ^ 5) =
      (1 + (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹) * unramifiedGaussResidue (h * p ^ 2) := by
  let A : ℂ → ℂ := fun s => 1 + (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 *
    ((Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-s)) ^ 3
  have hA (s : ℂ) : AnalyticAt ℂ A s := analyticAt_const.add
    (analyticAt_const.mul ((gaussPrimeWeight_analytic p hp s).pow 3))
  have hgood : primaryIdealGenerator (Ideal.span {p}) ≠ 0 := by
    rw [primaryIdealGenerator_span p hp.ne_zero hprimary]
    exact hp.ne_zero
  have he := unramifiedGaussResidue_of_initial_relation (h * p ^ 5) (h * p ^ 2) 0 A (fun _ => 0)
    (fun s _ => hA s) (fun _ _ => analyticAt_const) (hA _).continuousAt continuousAt_const (by
      intro s hs hi
      have hh := unramifiedCubicGaussSeries_square_cube p hp hprimary s (by linarith) h hph
      rw [unramifiedNormWeight_of_good s _ hgood] at hh
      simpa only [A, zero_mul, add_zero] using hh)
  dsimp only [A] at he
  rw [gaussPrimeWeight_center p hp] at he
  simpa only [zero_mul, add_zero] using he

/-- An admissible cube has trivial cubic character in the ramified Fourier sum. -/
lemma arithmeticResidueSum_frequency_cube (h c t : O) (hc : c ≠ 0) (hlevel : (3 : O) ∣ c)
    (ht : lambda ^ 2 ∣ t - 1) (hct : IsCoprime c t) :
    arithmeticResidueSum (h * t ^ 3) c = arithmeticResidueSum h c := by
  have he := arithmeticResidueSum_frequency_twist h c (t ^ 3) hc hlevel
    ⟨hct.pow_right, three_dvd_primary_sub_one _ (primary_pow_congruence t ht 3)⟩
  rw [symbol_pow_denominator, symbol_cube_of_isCoprime c t ht hct, map_one, one_mul] at he
  exact he

lemma ramified_prime_frequency_not_dvd (h p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (hph : ¬ p ∣ h) (u : Oˣ) (n : ℕ) :
    ¬ p ∣ 9 * h * ((u : O) * lambda ^ n) := by
  have hc := ramified_primary_coprime u n p hprimary
  have h9 : IsCoprime (9 * ((u : O) * lambda ^ n)) p := by
    rw [show (9 : O) = 3 * 3 by norm_num]
    exact (hc.of_mul_left_left.mul_left hc.of_mul_left_left).mul_left hc.of_mul_left_right
  have hn := hp.coprime_iff_not_dvd.mp h9.symm
  rw [show 9 * h * ((u : O) * lambda ^ n) = (9 * ((u : O) * lambda ^ n)) * h by ring]
  intro hd
  exact (hp.dvd_mul.mp hd).elim hn hph

/-- Any common cutoff above the ramified support can be used in the finite decomposition. -/
theorem arithmeticDirichletSeries_finite_gauss_of_bound (s : ℂ) (hs : 2 < s.re)
    (h : O) (hh : h ≠ 0) (N : ℕ) (hN : ramifiedFrequencyBound h + 1 ≤ N) :
    arithmeticDirichletSeries s h =
      ∑' u : Oˣ, ∑ n ∈ Finset.range N,
        (((3 ^ (n + 2) : ℕ) : ℂ) ^ (-s) * arithmeticResidueSum h ((u : O) * lambda ^ (n + 2))) *
          unramifiedCubicGaussSeries s (9 * h * ((u : O) * lambda ^ (n + 2))) := by
  rw [arithmeticDirichletSeries_ramified_reindex s hs h]
  apply tsum_congr
  intro u
  have hz (n : ℕ) (hn : n ∉ Finset.range N) :
      (∑' I : GoodIdeal, arithmeticDirichletTerm s h (ramifiedLowerMap (u, n, I)).1) = 0 := by
    have hlarge : ramifiedFrequencyBound h < n + 2 := by
      simp only [Finset.mem_range, not_lt] at hn
      omega
    have he (I : GoodIdeal) : arithmeticDirichletTerm s h (ramifiedLowerMap (u, n, I)).1 = 0 :=
      arithmeticDirichletTerm_ramified_vanish s h hh u (n + 2) (by omega)
        (primaryIdealGenerator I.1) (primaryIdealGenerator_spec I.1 I.2).2 hlarge
    simp only [he, tsum_zero]
  rw [tsum_eq_sum hz]
  apply Finset.sum_congr rfl
  intro n hn
  rw [unramifiedCubicGaussSeries, ← tsum_mul_left]
  exact tsum_congr (fun I => arithmeticDirichletTerm_ramified_gauss s h u n I)

lemma cubic_units_finite : Finite Oˣ := by
  letI : Fintype {z : O // ‖ringComplex z‖ ≤ 1} := (finite_norm_sublevel 1).fintype
  have hn (u : Oˣ) : ‖ringComplex (u : O)‖ ≤ 1 := by
    have he := ramifiedElement_absNorm u 0
    simp only [pow_zero, mul_one] at he
    have hs := ringComplex_norm_sq_eq_absNorm_span (u : O)
    rw [he, Nat.cast_one] at hs
    nlinarith only [hs, norm_nonneg (ringComplex (u : O))]
  exact Finite.of_injective (fun u : Oˣ => (⟨u, hn u⟩ : {z : O // ‖ringComplex z‖ ≤ 1}))
    (fun u v h => Units.ext (congrArg Subtype.val h))

def ramifiedGaussTerm (s : ℂ) (h : O) (u : Oˣ) (n : ℕ) : ℂ :=
  (((3 ^ (n + 2) : ℕ) : ℂ) ^ (-s) * arithmeticResidueSum h ((u : O) * lambda ^ (n + 2))) *
    unramifiedCubicGaussSeries s (9 * h * ((u : O) * lambda ^ (n + 2)))

/-- The ramified character cancels the frequency twist in the unramified prime factor. -/
lemma ramifiedGaussTerm_prime_recurrence (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1)
    (s : ℂ) (hs : 2 < s.re) (h : O) (hph : ¬ p ∣ h) (u : Oˣ) (n : ℕ) :
    ramifiedGaussTerm s (h * p ^ 3) u n =
      (1 + (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 * unramifiedNormWeight s (Ideal.span {p}) ^ 3) *
        ramifiedGaussTerm s h u n -
      unramifiedNormWeight s (Ideal.span {p}) * cubicUnitGaussSum (9 * h) p *
        ramifiedGaussTerm s (h * p) u n := by
  let c : O := (u : O) * lambda ^ (n + 2)
  have hc : c ≠ 0 := ramifiedElement_ne_zero u (n + 2)
  have hlevel : (3 : O) ∣ c := ramifiedElement_level u (n + 2) (by omega)
  have hcop : IsCoprime c p := (ramified_primary_coprime u (n + 2) p hprimary).of_mul_left_right
  have ha := arithmeticResidueSum_frequency_cube h c p hc hlevel hprimary hcop
  have ht := arithmeticResidueSum_frequency_twist h c p hc hlevel
    ⟨hcop, three_dvd_primary_sub_one p hprimary⟩
  have hg := cubicUnitGaussSum_frequency_twist (9 * h) p c hp.ne_zero hcop.symm
  have hcub := unramifiedCubicGaussSeries_prime_recurrence p hp hprimary s hs (9 * h * c)
    (ramified_prime_frequency_not_dvd h p hp hprimary hph u (n + 2))
  rw [primeCubicGauss_one_eq] at hcub
  have hcancel : arithmeticResidueSum h c * cubicUnitGaussSum (9 * h * c) p =
      cubicUnitGaussSum (9 * h) p * arithmeticResidueSum (h * p) c := by
    rw [← ht]
    calc
      _ = (ringComplex (symbol c p) * cubicUnitGaussSum (9 * h * c) p) *
          arithmeticResidueSum (h * p) c := by ring
      _ = _ := by rw [hg]
  change (_ * arithmeticResidueSum (h * p ^ 3) c) * unramifiedCubicGaussSeries s (9 * (h * p ^ 3) * c) =
    _ * ((_ * arithmeticResidueSum h c) * unramifiedCubicGaussSeries s (9 * h * c)) -
    _ * ((_ * arithmeticResidueSum (h * p) c) * unramifiedCubicGaussSeries s (9 * (h * p) * c))
  rw [ha, show 9 * (h * p ^ 3) * c = (9 * h * c) * p ^ 3 by ring, hcub,
    show 9 * (h * p) * c = (9 * h * c) * p by ring]
  linear_combination -unramifiedNormWeight s (Ideal.span {p}) * ((3 ^ (n + 2) : ℕ) : ℂ) ^ (-s) *
    unramifiedCubicGaussSeries s ((9 * h * c) * p) * hcancel

theorem arithmeticDirichletSeries_prime_recurrence (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (s : ℂ) (hs : 2 < s.re) (h : O) (hph : ¬ p ∣ h) :
    arithmeticDirichletSeries s (h * p ^ 3) =
      (1 + (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 * unramifiedNormWeight s (Ideal.span {p}) ^ 3) *
        arithmeticDirichletSeries s h -
      unramifiedNormWeight s (Ideal.span {p}) * cubicUnitGaussSum (9 * h) p *
        arithmeticDirichletSeries s (h * p) := by
  letI : Finite Oˣ := cubic_units_finite
  letI : Fintype Oˣ := Fintype.ofFinite _
  have hh : h ≠ 0 := fun hz => hph (hz ▸ dvd_zero p)
  let N := max (ramifiedFrequencyBound (h * p ^ 3) + 1)
    (max (ramifiedFrequencyBound h + 1) (ramifiedFrequencyBound (h * p) + 1))
  rw [arithmeticDirichletSeries_finite_gauss_of_bound s hs (h * p ^ 3)
      (mul_ne_zero hh (pow_ne_zero _ hp.ne_zero)) N (le_max_left _ _),
    arithmeticDirichletSeries_finite_gauss_of_bound s hs h hh N ((le_max_left _ _).trans (le_max_right _ _)),
    arithmeticDirichletSeries_finite_gauss_of_bound s hs (h * p)
      (mul_ne_zero hh hp.ne_zero) N ((le_max_right _ _).trans (le_max_right _ _))]
  change (∑' u : Oˣ, ∑ n ∈ Finset.range N, ramifiedGaussTerm s (h * p ^ 3) u n) =
    _ * (∑' u : Oˣ, ∑ n ∈ Finset.range N, ramifiedGaussTerm s h u n) -
    _ * (∑' u : Oˣ, ∑ n ∈ Finset.range N, ramifiedGaussTerm s (h * p) u n)
  simp_rw [ramifiedGaussTerm_prime_recurrence p hp hprimary s hs h hph,
    Finset.sum_sub_distrib, ← Finset.mul_sum]
  simp only [tsum_fintype, Finset.sum_sub_distrib, Finset.mul_sum]

lemma ramifiedGaussTerm_cube_recurrence (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1)
    (s : ℂ) (hs : 2 < s.re) (h : O) (u : Oˣ) (n : ℕ) :
    ramifiedGaussTerm s (h * p ^ 6) u n =
      (1 + (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 * unramifiedNormWeight s (Ideal.span {p}) ^ 3) *
        ramifiedGaussTerm s (h * p ^ 3) u n -
      (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 * unramifiedNormWeight s (Ideal.span {p}) ^ 3 *
        ramifiedGaussTerm s h u n := by
  let c : O := (u : O) * lambda ^ (n + 2)
  have ha (k : O) : arithmeticResidueSum (k * p ^ 3) c = arithmeticResidueSum k c :=
    arithmeticResidueSum_frequency_cube k c p (ramifiedElement_ne_zero u (n + 2))
      (ramifiedElement_level u (n + 2) (by omega)) hprimary
      (ramified_primary_coprime u (n + 2) p hprimary).of_mul_left_right
  have ha6 : arithmeticResidueSum (h * p ^ 6) c = arithmeticResidueSum h c := by
    rw [show h * p ^ 6 = (h * p ^ 3) * p ^ 3 by ring, ha, ha]
  have he := unramifiedCubicGaussSeries_cube_recurrence p hp hprimary s hs (9 * h * c)
  change (_ * arithmeticResidueSum (h * p ^ 6) c) * unramifiedCubicGaussSeries s (9 * (h * p ^ 6) * c) =
    _ * ((_ * arithmeticResidueSum (h * p ^ 3) c) * unramifiedCubicGaussSeries s (9 * (h * p ^ 3) * c)) -
    _ * ((_ * arithmeticResidueSum h c) * unramifiedCubicGaussSeries s (9 * h * c))
  rw [ha6, ha, show 9 * (h * p ^ 6) * c = (9 * h * c) * p ^ 6 by ring,
    show 9 * (h * p ^ 3) * c = (9 * h * c) * p ^ 3 by ring, he]
  ring

theorem arithmeticDirichletSeries_cube_recurrence (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (s : ℂ) (hs : 2 < s.re) (h : O) (hh : h ≠ 0) :
    arithmeticDirichletSeries s (h * p ^ 6) =
      (1 + (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 * unramifiedNormWeight s (Ideal.span {p}) ^ 3) *
        arithmeticDirichletSeries s (h * p ^ 3) -
      (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 * unramifiedNormWeight s (Ideal.span {p}) ^ 3 *
        arithmeticDirichletSeries s h := by
  letI : Finite Oˣ := cubic_units_finite
  letI : Fintype Oˣ := Fintype.ofFinite _
  let N := max (ramifiedFrequencyBound (h * p ^ 6) + 1)
    (max (ramifiedFrequencyBound (h * p ^ 3) + 1) (ramifiedFrequencyBound h + 1))
  rw [arithmeticDirichletSeries_finite_gauss_of_bound s hs (h * p ^ 6)
      (mul_ne_zero hh (pow_ne_zero _ hp.ne_zero)) N (le_max_left _ _),
    arithmeticDirichletSeries_finite_gauss_of_bound s hs (h * p ^ 3)
      (mul_ne_zero hh (pow_ne_zero _ hp.ne_zero)) N ((le_max_left _ _).trans (le_max_right _ _)),
    arithmeticDirichletSeries_finite_gauss_of_bound s hs h hh N ((le_max_right _ _).trans (le_max_right _ _))]
  change (∑' u : Oˣ, ∑ n ∈ Finset.range N, ramifiedGaussTerm s (h * p ^ 6) u n) =
    _ * (∑' u : Oˣ, ∑ n ∈ Finset.range N, ramifiedGaussTerm s (h * p ^ 3) u n) -
    _ * (∑' u : Oˣ, ∑ n ∈ Finset.range N, ramifiedGaussTerm s h u n)
  simp_rw [ramifiedGaussTerm_cube_recurrence p hp hprimary s hs h,
    Finset.sum_sub_distrib, ← Finset.mul_sum]
  simp only [tsum_fintype, Finset.sum_sub_distrib, Finset.mul_sum]

lemma ramifiedGaussTerm_square_cube (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1)
    (s : ℂ) (hs : 2 < s.re) (h : O) (hph : ¬ p ∣ h) (u : Oˣ) (n : ℕ) :
    ramifiedGaussTerm s (h * p ^ 5) u n =
      (1 + (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 * unramifiedNormWeight s (Ideal.span {p}) ^ 3) *
        ramifiedGaussTerm s (h * p ^ 2) u n := by
  let c : O := (u : O) * lambda ^ (n + 2)
  have ha := arithmeticResidueSum_frequency_cube (h * p ^ 2) c p
    (ramifiedElement_ne_zero u (n + 2)) (ramifiedElement_level u (n + 2) (by omega)) hprimary
    (ramified_primary_coprime u (n + 2) p hprimary).of_mul_left_right
  rw [show (h * p ^ 2) * p ^ 3 = h * p ^ 5 by ring] at ha
  have he := unramifiedCubicGaussSeries_square_cube p hp hprimary s hs (9 * h * c)
    (ramified_prime_frequency_not_dvd h p hp hprimary hph u (n + 2))
  change (_ * arithmeticResidueSum (h * p ^ 5) c) * unramifiedCubicGaussSeries s (9 * (h * p ^ 5) * c) =
    _ * ((_ * arithmeticResidueSum (h * p ^ 2) c) * unramifiedCubicGaussSeries s (9 * (h * p ^ 2) * c))
  rw [ha, show 9 * (h * p ^ 5) * c = (9 * h * c) * p ^ 5 by ring,
    show 9 * (h * p ^ 2) * c = (9 * h * c) * p ^ 2 by ring, he]
  ring

theorem arithmeticDirichletSeries_square_cube (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (s : ℂ) (hs : 2 < s.re) (h : O) (hph : ¬ p ∣ h) :
    arithmeticDirichletSeries s (h * p ^ 5) =
      (1 + (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 * unramifiedNormWeight s (Ideal.span {p}) ^ 3) *
        arithmeticDirichletSeries s (h * p ^ 2) := by
  have hh : h ≠ 0 := fun hz => hph (hz ▸ dvd_zero p)
  let N := max (ramifiedFrequencyBound (h * p ^ 5) + 1) (ramifiedFrequencyBound (h * p ^ 2) + 1)
  rw [arithmeticDirichletSeries_finite_gauss_of_bound s hs (h * p ^ 5)
      (mul_ne_zero hh (pow_ne_zero _ hp.ne_zero)) N (le_max_left _ _),
    arithmeticDirichletSeries_finite_gauss_of_bound s hs (h * p ^ 2)
      (mul_ne_zero hh (pow_ne_zero _ hp.ne_zero)) N (le_max_right _ _)]
  change (∑' u : Oˣ, ∑ n ∈ Finset.range N, ramifiedGaussTerm s (h * p ^ 5) u n) =
    _ * (∑' u : Oˣ, ∑ n ∈ Finset.range N, ramifiedGaussTerm s (h * p ^ 2) u n)
  simp_rw [ramifiedGaussTerm_square_cube p hp hprimary s hs h hph, ← Finset.mul_sum]
  exact tsum_mul_left

theorem nonzeroScatteringResidue_of_initial_relation (h0 h1 h2 : O)
    (hh0 : h0 ≠ 0) (hh1 : h1 ≠ 0) (hh2 : h2 ≠ 0) (A B : ℂ → ℂ)
    (hA : AnalyticOnNhd ℂ A {s : ℂ | 1 < s.re ∧ 0 < s.im})
    (hB : AnalyticOnNhd ℂ B {s : ℂ | 1 < s.re ∧ 0 < s.im})
    (hAc : ContinuousAt A (4 / 3 : ℂ)) (hBc : ContinuousAt B (4 / 3 : ℂ))
    (hrel : ∀ s : ℂ, 4 < s.re → 0 < s.im → scatteringCoefficient s h0 =
      A s * scatteringCoefficient s h1 + B s * scatteringCoefficient s h2) :
    nonzeroScatteringResidue h0 = A (4 / 3) * nonzeroScatteringResidue h1 +
      B (4 / 3) * nonzeroScatteringResidue h2 := by
  unfold nonzeroScatteringResidue
  apply cuspScalarResidue_relation
    (ι := {h : O // h ≠ 0})
    (fun h => kernelCuspFourierFamily h.1 2 3 (by norm_num) (by norm_num))
    (fun h s => ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * cuspWhittakerHeightFactor s h.1)
    (fun h => kernelCuspFourier h.1 cubicEisensteinResidue)
    (fun h s hs => kernelCuspFourierFamily_analyticAt_nonreal h.1 2 3
      (by norm_num) (by norm_num) s hs.1.ne' hs.2.ne')
    (fun h s hs => analyticAt_const.mul (cuspWhittakerHeightFactor_analyticAt h.1 s hs.1))
    (fun h => continuousAt_const.mul
      (cuspWhittakerHeightFactor_analyticAt h.1 (4 / 3) (by norm_num)).continuousAt)
    (fun h => kernelCuspFourierFamily_residue_limit h.1 2 3 (by norm_num) (by norm_num))
    (fun h => mul_ne_zero cusp_volume_ne_zero (cuspWhittakerHeightFactor_center_ne_zero h.1))
    ⟨h0, hh0⟩ ⟨h1, hh1⟩ ⟨h2, hh2⟩ A B hA hB hAc hBc
  intro s hs hi
  rw [kernelCuspFourierFamily_eq_upper h0 hh0 ⟨by linarith, hi⟩,
    kernelCuspFourierFamily_eq_upper h1 hh1 ⟨by linarith, hi⟩,
    kernelCuspFourierFamily_eq_upper h2 hh2 ⟨by linarith, hi⟩]
  dsimp only
  rw [hrel s hs hi]
  ring

/-- The actual nonconstant scattering residues inherit the prime recurrence. -/
theorem nonzeroScatteringResidue_prime_recurrence (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hph : ¬ p ∣ h) :
    nonzeroScatteringResidue (h * p ^ 3) =
      (1 + (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹) * nonzeroScatteringResidue h -
      (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-(4 / 3 : ℂ)) * cubicUnitGaussSum (9 * h) p *
        nonzeroScatteringResidue (h * p) := by
  let A : ℂ → ℂ := fun s => 1 + (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 *
    ((Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-s)) ^ 3
  let B : ℂ → ℂ := fun s => -((Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-s) * cubicUnitGaussSum (9 * h) p)
  have hA (s : ℂ) : AnalyticAt ℂ A s := analyticAt_const.add
    (analyticAt_const.mul ((gaussPrimeWeight_analytic p hp s).pow 3))
  have hB (s : ℂ) : AnalyticAt ℂ B s := ((gaussPrimeWeight_analytic p hp s).mul analyticAt_const).neg
  have hh : h ≠ 0 := fun hz => hph (hz ▸ dvd_zero p)
  have hgood : primaryIdealGenerator (Ideal.span {p}) ≠ 0 := by
    rw [primaryIdealGenerator_span p hp.ne_zero hprimary]
    exact hp.ne_zero
  have he := nonzeroScatteringResidue_of_initial_relation (h * p ^ 3) h (h * p)
    (mul_ne_zero hh (pow_ne_zero _ hp.ne_zero)) hh (mul_ne_zero hh hp.ne_zero) A B
    (fun s _ => hA s) (fun s _ => hB s) (hA _).continuousAt (hB _).continuousAt (by
      intro s hs hi
      have hr := arithmeticDirichletSeries_prime_recurrence p hp hprimary s (by linarith) h hph
      rw [unramifiedNormWeight_of_good s _ hgood] at hr
      unfold scatteringCoefficient
      rw [hr]
      dsimp only [A, B]
      ring)
  dsimp only [A, B] at he
  rw [gaussPrimeWeight_center p hp] at he
  simpa only [neg_mul, sub_eq_add_neg] using he

theorem nonzeroScatteringResidue_cube_recurrence (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hh : h ≠ 0) :
    nonzeroScatteringResidue (h * p ^ 6) =
      (1 + (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹) * nonzeroScatteringResidue (h * p ^ 3) -
      (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ * nonzeroScatteringResidue h := by
  let A : ℂ → ℂ := fun s => 1 + (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 *
    ((Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-s)) ^ 3
  let B : ℂ → ℂ := fun s => -((Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 *
    ((Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-s)) ^ 3)
  have hA (s : ℂ) : AnalyticAt ℂ A s := analyticAt_const.add
    (analyticAt_const.mul ((gaussPrimeWeight_analytic p hp s).pow 3))
  have hB (s : ℂ) : AnalyticAt ℂ B s :=
    (analyticAt_const.mul ((gaussPrimeWeight_analytic p hp s).pow 3)).neg
  have hgood : primaryIdealGenerator (Ideal.span {p}) ≠ 0 := by
    rw [primaryIdealGenerator_span p hp.ne_zero hprimary]
    exact hp.ne_zero
  have he := nonzeroScatteringResidue_of_initial_relation (h * p ^ 6) (h * p ^ 3) h
    (mul_ne_zero hh (pow_ne_zero _ hp.ne_zero)) (mul_ne_zero hh (pow_ne_zero _ hp.ne_zero)) hh A B
    (fun s _ => hA s) (fun s _ => hB s) (hA _).continuousAt (hB _).continuousAt (by
      intro s hs hi
      have hr := arithmeticDirichletSeries_cube_recurrence p hp hprimary s (by linarith) h hh
      rw [unramifiedNormWeight_of_good s _ hgood] at hr
      unfold scatteringCoefficient
      rw [hr]
      dsimp only [A, B]
      ring)
  dsimp only [A, B] at he
  rw [gaussPrimeWeight_center p hp] at he
  simpa only [neg_mul, sub_eq_add_neg] using he

theorem nonzeroScatteringResidue_square_cube (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hph : ¬ p ∣ h) :
    nonzeroScatteringResidue (h * p ^ 5) =
      (1 + (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹) * nonzeroScatteringResidue (h * p ^ 2) := by
  let A : ℂ → ℂ := fun s => 1 + (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 *
    ((Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-s)) ^ 3
  have hA (s : ℂ) : AnalyticAt ℂ A s := analyticAt_const.add
    (analyticAt_const.mul ((gaussPrimeWeight_analytic p hp s).pow 3))
  have hh : h ≠ 0 := fun hz => hph (hz ▸ dvd_zero p)
  have hgood : primaryIdealGenerator (Ideal.span {p}) ≠ 0 := by
    rw [primaryIdealGenerator_span p hp.ne_zero hprimary]
    exact hp.ne_zero
  have he := nonzeroScatteringResidue_of_initial_relation (h * p ^ 5) (h * p ^ 2) h
    (mul_ne_zero hh (pow_ne_zero _ hp.ne_zero)) (mul_ne_zero hh (pow_ne_zero _ hp.ne_zero)) hh A (fun _ => 0)
    (fun s _ => hA s) (fun _ _ => analyticAt_const) (hA _).continuousAt continuousAt_const (by
      intro s hs hi
      have hr := arithmeticDirichletSeries_square_cube p hp hprimary s (by linarith) h hph
      rw [unramifiedNormWeight_of_good s _ hgood] at hr
      unfold scatteringCoefficient
      rw [hr]
      dsimp only [A]
      ring)
  dsimp only [A] at he
  rw [gaussPrimeWeight_center p hp] at he
  simpa only [zero_mul, add_zero] using he

/-- Rational matrices acting on hyperbolic space through the Eisenstein embedding. -/
def rationalComplex : SL(2, ℤ) →* SL(2, ℂ) := integralComplexMatrix.comp rationalEmbedding

lemma rational_translate_congr (f : HyperbolicSpace → ℂ)
    (hf : ∀ n : levelThree, ∀ w, f (complexMatrix n • w) = complexCharacter n * f w)
    (r s : SL(2, ℤ)) (he : rationalSourceQuotient r = rationalSourceQuotient s)
    (w : HyperbolicSpace) : f (rationalComplex r • w) = f (rationalComplex s • w) := by
  have hm : rationalEmbedding (r * s⁻¹) ∈ levelThree := by
    apply (QuotientGroup.eq_one_iff (N := levelThreeInRationalExtension)
      (rationalSourceLift (r * s⁻¹))).mp
    change rationalSourceQuotient (r * s⁻¹) = 1
    rw [map_mul, map_inv, he, mul_inv_cancel]
  have h := hf ⟨rationalEmbedding (r * s⁻¹), hm⟩ (rationalComplex s • w)
  rw [complexCharacter_rational_intersection, one_mul] at h
  change f (rationalComplex (r * s⁻¹) • (rationalComplex s • w)) = _ at h
  simpa only [map_mul, map_inv, mul_smul, inv_smul_smul] using h

/-- Left translation permutes the rational averaging classes. -/
lemma rationalSourceProjection_left_invariant (f : HyperbolicSpace → ℂ)
    (hf : ∀ n : levelThree, ∀ w, f (complexMatrix n • w) = complexCharacter n * f w)
    (r : SL(2, ℤ)) (w : HyperbolicSpace) :
    rationalSourceProjection (fun v => f (rationalComplex r • v)) w = rationalSourceProjection f w := by
  have he (q : rationalExtension ⧸ levelThreeInRationalExtension) :
      f (rationalComplex r • (rationalComplex (rationalSourceSection q) • w)) =
        f (rationalComplex (rationalSourceSection (rationalSourceQuotient r * q)) • w) := by
    rw [← mul_smul, ← map_mul]
    apply rational_translate_congr f hf
    rw [map_mul, rationalSourceSection_spec, rationalSourceSection_spec]
  change _ * (∑ q, f (rationalComplex r • (rationalComplex (rationalSourceSection q) • w))) =
    _ * (∑ q, f (rationalComplex (rationalSourceSection q) • w))
  simp_rw [he]
  rw [Function.Bijective.sum_comp (Group.mulLeft_bijective (rationalSourceQuotient r))
    (fun q => f (rationalComplex (rationalSourceSection q) • w))]

lemma rational_translate_automorphy (f : HyperbolicSpace → ℂ)
    (hf : ∀ n : levelThree, ∀ w, f (complexMatrix n • w) = complexCharacter n * f w)
    (r : SL(2, ℤ)) (n : levelThree) (w : HyperbolicSpace) :
    f (rationalComplex r • (complexMatrix n • w)) =
      complexCharacter n * f (rationalComplex r • w) := by
  have he : rationalEmbedding r * (n : SL(2, O)) =
      (levelThreeConjugate (rationalEmbedding r) n : SL(2, O)) * rationalEmbedding r := by
    change _ = (rationalEmbedding r * (n : SL(2, O)) * (rationalEmbedding r)⁻¹) * rationalEmbedding r
    group
  change f (integralComplexMatrix (rationalEmbedding r) •
    (integralComplexMatrix (n : SL(2, O)) • w)) = _
  rw [← mul_smul, ← map_mul, he, map_mul, integralComplexMatrix_levelThree, mul_smul,
    hf, complexCharacter_conjugate_rational]
  rfl

lemma rationalUnipotent_add (a b : ℤ) : rationalUnipotent (a + b) = rationalUnipotent a * rationalUnipotent b := by
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  fin_cases i <;> fin_cases j <;>
    simp [rationalUnipotent, Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two, add_comm]

lemma rationalUnipotent_nat (n : ℕ) : rationalUnipotent (n : ℤ) = ModularGroup.T ^ n := by
  induction n with
  | zero =>
    apply Matrix.SpecialLinearGroup.ext
    intro i j
    fin_cases i <;> fin_cases j <;> simp [rationalUnipotent]
  | succ n ih =>
    rw [Nat.cast_succ, rationalUnipotent_add, ih, pow_succ]
    rfl

lemma rational_T_cube_levelThree : rationalEmbedding (ModularGroup.T ^ 3) ∈ levelThree := by
  rw [← rationalUnipotent_nat]
  change Matrix.SpecialLinearGroup.map (n := Fin 2) (Ideal.Quotient.mk (Ideal.span {(3 : O)}))
    (rationalEmbedding (rationalUnipotent 3)) = 1
  have hz : Ideal.Quotient.mk (Ideal.span {(3 : O)}) 3 = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  simp only [Matrix.SpecialLinearGroup.map_apply_coe, rationalUnipotent_embedding]
  fin_cases i <;> fin_cases j <;> simp [hz]

lemma rational_translate_T_cube (f : HyperbolicSpace → ℂ)
    (hf : ∀ n : levelThree, ∀ w, f (complexMatrix n • w) = complexCharacter n * f w)
    (r : SL(2, ℤ)) (w : HyperbolicSpace) :
    f (rationalComplex (r * ModularGroup.T ^ 3) • w) = f (rationalComplex r • w) := by
  have he := rational_translate_automorphy f hf r
    ⟨rationalEmbedding (ModularGroup.T ^ 3), rational_T_cube_levelThree⟩ w
  rw [complexCharacter_rational_intersection, one_mul] at he
  change f (rationalComplex r • (rationalComplex (ModularGroup.T ^ 3) • w)) = _ at he
  simpa only [map_mul, mul_smul] using he

/-- The four rational cusps; translation invariance collapses each parabolic fiber. -/
def fourCuspAverage (f : HyperbolicSpace → ℂ) (w : HyperbolicSpace) : ℂ :=
  (4 : ℂ)⁻¹ * (f w + f (rationalComplex ModularGroup.S • w) +
    f (rationalComplex (ModularGroup.S * ModularGroup.T) • w) +
    f (rationalComplex (ModularGroup.S * ModularGroup.T ^ 2) • w))

lemma fourCuspAverage_automorphy (f : HyperbolicSpace → ℂ)
    (hf : ∀ n : levelThree, ∀ w, f (complexMatrix n • w) = complexCharacter n * f w)
    (n : levelThree) (w : HyperbolicSpace) :
    fourCuspAverage f (complexMatrix n • w) = complexCharacter n * fourCuspAverage f w := by
  simp only [fourCuspAverage, hf, rational_translate_automorphy f hf]
  ring

lemma fourCuspAverage_T (f : HyperbolicSpace → ℂ)
    (hf : ∀ n : levelThree, ∀ w, f (complexMatrix n • w) = complexCharacter n * f w)
    (hT : ∀ w, f (rationalComplex ModularGroup.T • w) = f w) (w : HyperbolicSpace) :
    fourCuspAverage f (rationalComplex ModularGroup.T • w) = fourCuspAverage f w := by
  have h2 : ModularGroup.S * ModularGroup.T * ModularGroup.T = ModularGroup.S * ModularGroup.T ^ 2 := by rw [pow_two, mul_assoc]
  have h3 : ModularGroup.S * ModularGroup.T ^ 2 * ModularGroup.T = ModularGroup.S * ModularGroup.T ^ 3 := by group
  simp only [fourCuspAverage, hT, ← mul_smul, ← map_mul, h2, h3, rational_translate_T_cube f hf]
  ring

lemma rational_STS : ModularGroup.S * ModularGroup.T * ModularGroup.S =
    ModularGroup.T⁻¹ * ModularGroup.S * ModularGroup.T⁻¹ := by
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  fin_cases i <;> fin_cases j <;>
    norm_num [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_inv,
      ModularGroup.coe_S, ModularGroup.coe_T, Matrix.adjugate_fin_two, Matrix.mul_apply, Fin.sum_univ_two]

lemma rational_STTS : ModularGroup.S * ModularGroup.T ^ 2 * ModularGroup.S =
    (ModularGroup.S * ModularGroup.T ^ 3 * ModularGroup.S⁻¹) *
      (ModularGroup.S ^ 2 * ModularGroup.T * ModularGroup.S * ModularGroup.T) := by
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  fin_cases i <;> fin_cases j <;>
    norm_num [pow_succ, Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_inv,
      ModularGroup.coe_S, ModularGroup.coe_T, Matrix.adjugate_fin_two, Matrix.mul_apply, Fin.sum_univ_two]

lemma fourCuspAverage_S (f : HyperbolicSpace → ℂ)
    (hf : ∀ n : levelThree, ∀ w, f (complexMatrix n • w) = complexCharacter n * f w)
    (hT : ∀ w, f (rationalComplex ModularGroup.T • w) = f w)
    (hSS : ∀ w, f (rationalComplex (ModularGroup.S ^ 2) • w) = f w) (w : HyperbolicSpace) :
    fourCuspAverage f (rationalComplex ModularGroup.S • w) = fourCuspAverage f w := by
  have hTi (v : HyperbolicSpace) : f (rationalComplex ModularGroup.T⁻¹ • v) = f v := by
    have he := hT (rationalComplex ModularGroup.T⁻¹ • v)
    simpa only [map_inv, smul_inv_smul] using he.symm
  have hSTS : f (rationalComplex (ModularGroup.S * ModularGroup.T * ModularGroup.S) • w) =
      f (rationalComplex (ModularGroup.S * ModularGroup.T ^ 2) • w) := by
    rw [rational_STS, map_mul, map_mul, mul_smul, mul_smul, hTi]
    have he := rational_translate_T_cube f hf (ModularGroup.S * ModularGroup.T⁻¹) w
    have hg : (ModularGroup.S * ModularGroup.T⁻¹) * ModularGroup.T ^ 3 =
        ModularGroup.S * ModularGroup.T ^ 2 := by group
    rw [hg] at he
    simpa only [map_mul, mul_smul] using he.symm
  have hconj : rationalEmbedding (ModularGroup.S * ModularGroup.T ^ 3 * ModularGroup.S⁻¹) ∈ levelThree := by
    simpa only [levelThreeConjugate, map_mul, map_inv] using
      (levelThreeConjugate (rationalEmbedding ModularGroup.S)
        ⟨rationalEmbedding (ModularGroup.T ^ 3), rational_T_cube_levelThree⟩).property
  have hSTTS : f (rationalComplex (ModularGroup.S * ModularGroup.T ^ 2 * ModularGroup.S) • w) =
      f (rationalComplex (ModularGroup.S * ModularGroup.T) • w) := by
    rw [rational_STTS, map_mul, mul_smul]
    have he := hf ⟨_, hconj⟩ (rationalComplex
      (ModularGroup.S ^ 2 * ModularGroup.T * ModularGroup.S * ModularGroup.T) • w)
    rw [complexCharacter_rational_intersection, one_mul] at he
    change f (rationalComplex _ • _) = _ at he
    rw [he]
    simp only [map_mul, mul_smul, hSS, hT]
  simp only [fourCuspAverage, ← mul_smul, ← map_mul,
    show ModularGroup.S * ModularGroup.S = ModularGroup.S ^ 2 by rw [pow_two], hSS, hSTS, hSTTS]
  ring

def rationalFunctionStabilizer (f : HyperbolicSpace → ℂ) : Subgroup (SL(2, ℤ)) where
  carrier r := ∀ w, f (rationalComplex r • w) = f w
  one_mem' w := by rw [map_one, one_smul]
  mul_mem' hr hs w := by rw [map_mul, mul_smul, hr, hs]
  inv_mem' {r} hr w := by
    have he := hr (rationalComplex r⁻¹ • w)
    simpa only [map_inv, smul_inv_smul] using he.symm

lemma fourCuspAverage_rational (f : HyperbolicSpace → ℂ)
    (hf : ∀ n : levelThree, ∀ w, f (complexMatrix n • w) = complexCharacter n * f w)
    (hT : ∀ w, f (rationalComplex ModularGroup.T • w) = f w)
    (hSS : ∀ w, f (rationalComplex (ModularGroup.S ^ 2) • w) = f w)
    (r : SL(2, ℤ)) (w : HyperbolicSpace) :
    fourCuspAverage f (rationalComplex r • w) = fourCuspAverage f w := by
  have htop : rationalFunctionStabilizer (fourCuspAverage f) = ⊤ := by
    apply top_unique
    rw [← SpecialLinearGroup.SL2Z_generators]
    apply (Subgroup.closure_le _).mpr
    intro g hg
    rcases hg with (rfl | rfl)
    · exact fourCuspAverage_S f hf hT hSS
    · exact fourCuspAverage_T f hf hT
  have hr : r ∈ rationalFunctionStabilizer (fourCuspAverage f) := by rw [htop]; trivial
  exact hr w

/-- Generator relations give the four-cusp formula without enumerating the finite quotient. -/
theorem rationalSourceProjection_four_cusps (f : HyperbolicSpace → ℂ)
    (hf : ∀ n : levelThree, ∀ w, f (complexMatrix n • w) = complexCharacter n * f w)
    (hT : ∀ w, f (rationalComplex ModularGroup.T • w) = f w)
    (hSS : ∀ w, f (rationalComplex (ModularGroup.S ^ 2) • w) = f w)
    (w : HyperbolicSpace) : rationalSourceProjection f w = fourCuspAverage f w := by
  have hfixed : rationalSourceProjection (fourCuspAverage f) w = fourCuspAverage f w := by
    apply rationalSourceProjection_fixed
    intro g v
    obtain ⟨n, r, hr⟩ := g.property
    rw [← hr, map_mul, integralComplexMatrix_levelThree, mul_smul,
      fourCuspAverage_automorphy f hf]
    change complexCharacter n * fourCuspAverage f (rationalComplex r • v) = _
    rw [fourCuspAverage_rational f hf hT hSS]
    have he : extendedComplexCharacter g = complexCharacter n :=
      rationalExtensionValue_of_product g n r hr
    rw [he]
  have havg : rationalSourceProjection (fourCuspAverage f) w = rationalSourceProjection f w := by
    have hS := rationalSourceProjection_left_invariant f hf ModularGroup.S w
    have hST := rationalSourceProjection_left_invariant f hf (ModularGroup.S * ModularGroup.T) w
    have hSTT := rationalSourceProjection_left_invariant f hf (ModularGroup.S * ModularGroup.T ^ 2) w
    unfold rationalSourceProjection fourCuspAverage
    rw [← Finset.mul_sum, Finset.sum_add_distrib, Finset.sum_add_distrib, Finset.sum_add_distrib]
    unfold rationalSourceProjection at hS hST hSTT
    linear_combination (1 / 4 : ℂ) * hS + (1 / 4 : ℂ) * hST + (1 / 4 : ℂ) * hSTT
  exact havg.symm.trans hfixed

lemma rationalComplex_S_sq_row (v : Fin 2 → ℂ) :
    rowOperator (rationalComplex (ModularGroup.S ^ 2)) v = -v := by
  have hS : ((ModularGroup.S ^ 2 : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) = !![-1, 0; 0, -1] := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      norm_num [pow_two, Matrix.SpecialLinearGroup.coe_mul, ModularGroup.coe_S,
        Matrix.mul_apply, Fin.sum_univ_two]
  have hC : (rationalComplex (ModularGroup.S ^ 2) : Matrix (Fin 2) (Fin 2) ℂ) = !![-1, 0; 0, -1] := by
    ext i j
    change ringComplex ((Int.castRingHom O) ((ModularGroup.S ^ 2 : SL(2, ℤ)) i j)) = _
    rw [congrFun (congrFun hS i) j]
    fin_cases i <;> fin_cases j <;> simp
  rw [rowOperator_apply, hC]
  funext j
  fin_cases j <;> simp [Matrix.vecMul, dotProduct, Fin.sum_univ_two]

lemma hyperbolicEisenstein_S_sq (s : ℂ) (w : HyperbolicSpace) :
    hyperbolicEisenstein s (rationalComplex (ModularGroup.S ^ 2) • w) = hyperbolicEisenstein s w := by
  induction w using Quotient.inductionOn with
  | _ g =>
    change eisenstein (rationalComplex (ModularGroup.S ^ 2) * g) s = eisenstein g s
    apply tsum_congr
    intro x
    unfold summand
    rw [← rowOperator_mul, rationalComplex_S_sq_row, map_neg]
    simp [rowEnergy]

lemma hyperbolicEisenstein_T_pow (s : ℂ) (n : ℕ) (w : HyperbolicSpace) :
    hyperbolicEisenstein s (rationalComplex (ModularGroup.T ^ n) • w) = hyperbolicEisenstein s w := by
  simpa only [rationalUnipotent_nat, rationalComplex, MonoidHom.comp_apply] using
    hyperbolicEisenstein_unipotent (n : ℤ) s w

/-- The Eisenstein family averaged over the rational extension of the cubic group. -/
def rationalSourceEisenstein (s : ℂ) : HyperbolicSpace → ℂ :=
  rationalSourceProjection (hyperbolicEisenstein s)

theorem rationalSourceEisenstein_four_cusps (s : ℂ) (hs : 2 < s.re) (w : HyperbolicSpace) :
    rationalSourceEisenstein s w = fourCuspAverage (hyperbolicEisenstein s) w := by
  exact rationalSourceProjection_four_cusps (hyperbolicEisenstein s)
    (fun n v => hyperbolicEisenstein_automorphy n s hs v)
    (fun v => by simpa only [pow_one] using hyperbolicEisenstein_T_pow s 1 v)
    (hyperbolicEisenstein_S_sq s) w

lemma cosetHeight_cuspUnipotentEquiv (t : ℤ) (x : CuspCosets) (w : HyperbolicSpace) :
    cosetHeight x (rationalComplex (rationalUnipotent t) • w) =
      cosetHeight (cuspUnipotentEquiv t x) w := by
  induction w using Quotient.inductionOn with
  | _ g =>
    change (rowEnergy (rowOperator (rationalComplex (rationalUnipotent t) * g) (embeddedRow x)))⁻¹ =
      (rowEnergy (rowOperator g (embeddedRow (cuspUnipotentEquiv t x))))⁻¹
    rw [embeddedRow_cuspUnipotentEquiv, ← rowOperator_apply, rowOperator_mul]
    rfl

lemma cuspCutoffCorrection_unipotent (t : ℤ) (Y : ℝ) (F : ℝ → ℂ) (w : HyperbolicSpace) :
    cuspCutoffCorrection Y F (rationalComplex (rationalUnipotent t) • w) = cuspCutoffCorrection Y F w := by
  have he (x : CuspCosets) :
      cuspCutoffTerm Y F x (rationalComplex (rationalUnipotent t) • w) =
        cuspCutoffTerm Y F (cuspUnipotentEquiv t x) w := by
    simp only [cuspCutoffTerm, cosetHeight_cuspUnipotentEquiv, cosetCharacter_cuspUnipotentEquiv]
  unfold cuspCutoffCorrection
  simp_rw [he]
  exact (cuspUnipotentEquiv t).tsum_eq (fun x => cuspCutoffTerm Y F x w)

lemma cosetHeight_S_sq (x : CuspCosets) (w : HyperbolicSpace) :
    cosetHeight x (rationalComplex (ModularGroup.S ^ 2) • w) = cosetHeight x w := by
  induction w using Quotient.inductionOn with
  | _ g =>
    change (rowEnergy (rowOperator (rationalComplex (ModularGroup.S ^ 2) * g) (embeddedRow x)))⁻¹ = _
    rw [← rowOperator_mul, rationalComplex_S_sq_row, map_neg]
    simp [rowEnergy, cosetHeight]

lemma cuspCutoffCorrection_S_sq (Y : ℝ) (F : ℝ → ℂ) (w : HyperbolicSpace) :
    cuspCutoffCorrection Y F (rationalComplex (ModularGroup.S ^ 2) • w) = cuspCutoffCorrection Y F w := by
  simp only [cuspCutoffCorrection, cuspCutoffTerm, cosetHeight_S_sq]

/-- A symmetry of the initial Eisenstein family and its cutoff survives the residue limit. -/
theorem cubicEisensteinResidue_rational_symmetry (r : SL(2, ℤ))
    (hE : ∀ s : ℂ, 2 < s.re → ∀ w,
      hyperbolicEisenstein s (rationalComplex r • w) = hyperbolicEisenstein s w)
    (hseed : ∀ s : ℂ, ∀ w,
      smoothCuspSeed 2 3 s (rationalComplex r • w) = smoothCuspSeed 2 3 s w) :
    kernelRationalPullback (rationalSourceLift r) cubicEisensteinResidue = cubicEisensteinResidue := by
  let P := kernelRationalPullback (rationalSourceLift r)
  let F := kernelEisensteinL2Correction 2 3 (by norm_num) (by norm_num)
  have hc : AnalyticOnNhd ℂ F cuspUpperParameterRegion := fun s hs =>
    kernelEisensteinL2Correction_analyticAt_nonreal 2 3 (by norm_num) (by norm_num)
      s (by linarith [hs.1]) hs.2.ne'
  have hl : AnalyticOnNhd ℂ (fun s => P (F s)) cuspUpperParameterRegion := fun s hs =>
    (ContinuousLinearMap.analyticAt (𝕜 := ℂ) P.toContinuousLinearMap _).comp_of_eq (hc s hs) rfl
  have hopen : IsOpen {s : ℂ | 4 < s.re ∧ 0 < s.im} :=
    (isOpen_lt continuous_const Complex.continuous_re).inter
      (isOpen_lt continuous_const Complex.continuous_im)
  have hev : (fun s => P (F s)) =ᶠ[𝓝 (5 + Complex.I : ℂ)] F := by
    filter_upwards [hopen.mem_nhds (by norm_num)] with s hs
    have hF := kernelEisensteinL2Correction_initial_overlap 2 3 (by norm_num) (by norm_num) s hs.1 hs.2
    have hcomp := (kernelRationalAction_measurePreserving (rationalSourceLift r)).quasiMeasurePreserving.ae_eq_comp hF
    have hpoint (q : KernelQuotient) :
        kernelQuotientEisenstein s (by linarith [hs.1]) (kernelRationalAction (rationalSourceLift r) q) -
          kernelQuotientSeed 2 3 s (kernelRationalAction (rationalSourceLift r) q) =
        kernelQuotientEisenstein s (by linarith [hs.1]) q - kernelQuotientSeed 2 3 s q := by
      induction q using Quotient.inductionOn with
      | _ w => exact congrArg₂ (fun a b : ℂ => a - b) (hE s (by linarith [hs.1]) w) (hseed s w)
    apply Lp.ext
    filter_upwards [kernelRationalPullback_ae (rationalSourceLift r) (F s), hcomp, hF] with q hp hq hf
    exact hp.trans (hq.trans ((hpoint q).trans hf.symm))
  have heq := hl.eqOn_of_preconnected_of_eventuallyEq hc cuspUpperParameterRegion_convex.isPreconnected
    (by norm_num [cuspUpperParameterRegion]) hev
  have hlim := (kernelEisensteinResidueVector_limit 2 3 (by norm_num) (by norm_num)).comp
    thetaApproach_tendsto_complex_punctured
  have hp := P.continuous.continuousAt.tendsto.comp hlim
  apply tendsto_nhds_unique_of_eventuallyEq hp hlim
  filter_upwards [self_mem_nhdsWithin] with t ht
  change 0 < t at ht
  have htD : (4 / 3 : ℂ) + (t : ℂ) + (t : ℂ) * Complex.I ∈ cuspUpperParameterRegion := by
    constructor
    · norm_num
      linarith
    · simpa using ht
  change P (_ • F _) = _ • F _
  rw [map_smul]
  exact congrArg (fun u : KernelQuotientL2 =>
    ((4 / 3 : ℂ) + (t : ℂ) + (t : ℂ) * Complex.I - 4 / 3) • u) (heq htD)

theorem cubicResidualFunction_rational_symmetry (r : SL(2, ℤ))
    (hr : kernelRationalPullback (rationalSourceLift r) cubicEisensteinResidue = cubicEisensteinResidue)
    (w : HyperbolicSpace) : cubicResidualFunction (rationalComplex r • w) = cubicResidualFunction w := by
  have he : (fun q => cubicEisensteinResidue (kernelRationalAction (rationalSourceLift r) q))
      =ᵐ[integralQuotientVolume globalKubotaKernel] cubicEisensteinResidue := by
    filter_upwards [kernelRationalPullback_ae (rationalSourceLift r) cubicEisensteinResidue] with q hq
    rw [hr] at hq
    exact hq.symm
  have hl := kernelProjection_quasiMeasurePreserving.ae_eq_comp he
  have hrep := cubicEisensteinResidue_continuous_representative
  have hcomp := (measurePreserving_smul (rationalComplex r)
    hyperbolicVolume).quasiMeasurePreserving.ae_eq_comp hrep
  have hae : (fun p : HyperbolicSpace => cubicResidualFunction (rationalComplex r • p))
      =ᵐ[hyperbolicVolume] cubicResidualFunction := by
    filter_upwards [hcomp, hl, hrep] with p hp hc hq
    exact hp.symm.trans (hc.trans hq)
  exact congrFun (Measure.eq_of_ae_eq hae
    (cubicResidualFunction_continuous.comp (continuous_hyperbolic_action (rationalComplex r)))
    cubicResidualFunction_continuous) w

lemma cubicResidualFunction_T (w : HyperbolicSpace) :
    cubicResidualFunction (rationalComplex ModularGroup.T • w) = cubicResidualFunction w := by
  apply cubicResidualFunction_rational_symmetry
  apply cubicEisensteinResidue_rational_symmetry
  · intro s hs v
    simpa only [pow_one] using hyperbolicEisenstein_T_pow s 1 v
  · intro s v
    have he : rationalUnipotent (1 : ℤ) = ModularGroup.T := by
      simpa only [Nat.cast_one, pow_one] using rationalUnipotent_nat 1
    simpa only [he, smoothCuspSeed] using cuspCutoffCorrection_unipotent 1 1 (cuspSeedProfile 2 3 s) v

lemma cubicResidualFunction_S_sq (w : HyperbolicSpace) :
    cubicResidualFunction (rationalComplex (ModularGroup.S ^ 2) • w) = cubicResidualFunction w := by
  apply cubicResidualFunction_rational_symmetry
  apply cubicEisensteinResidue_rational_symmetry
  · exact fun s _ v => hyperbolicEisenstein_S_sq s v
  · exact fun s v => cuspCutoffCorrection_S_sq 1 (cuspSeedProfile 2 3 s) v

/-- The actual residual source is the average of its four rational cusp translates. -/
theorem cubicSourceResidualFunction_four_cusps (w : HyperbolicSpace) :
    cubicSourceResidualFunction w = fourCuspAverage cubicResidualFunction w :=
  rationalSourceProjection_four_cusps cubicResidualFunction cubicResidualFunction_automorphy
    cubicResidualFunction_T cubicResidualFunction_S_sq w

lemma rationalUnipotent_action (t : ℤ) (z : ℂ) (v : ℝ) (hv : 0 < v) :
    rationalComplex (rationalUnipotent t) • upperPoint z v hv = upperPoint (z + (t : ℂ)) v hv := by
  have he : rationalEmbedding (rationalUnipotent t) = integralTranslation (t : O) := by
    apply Subtype.ext
    exact rationalUnipotent_embedding t
  change integralComplexMatrix (rationalEmbedding (rationalUnipotent t)) • upperPoint z v hv = _
  rw [he, integralTranslation_action, map_intCast]

lemma rational_T_pow_action (n : ℕ) (z : ℂ) (v : ℝ) (hv : 0 < v) :
    rationalComplex (ModularGroup.T ^ n) • upperPoint z v hv = upperPoint (z + (n : ℂ)) v hv := by
  simpa only [rationalUnipotent_nat, Int.cast_natCast] using rationalUnipotent_action (n : ℤ) z v hv

lemma rational_translate_period (f : HyperbolicSpace → ℂ)
    (hf : ∀ n : levelThree, ∀ w, f (complexMatrix n • w) = complexCharacter n * f w)
    (r : SL(2, ℤ)) (v : ℝ) (hv : 0 < v) (n : O) (z : ℂ) :
    f (rationalComplex r • upperPoint (z + 3 * ringComplex n) v hv) =
      f (rationalComplex r • upperPoint z v hv) := by
  obtain ⟨hn, hchar⟩ := (globalKubotaKernel_mem _).mp (integralTranslation_three_mem_kernel n)
  have he := rational_translate_automorphy f hf r ⟨integralTranslation (3 * n), hn⟩ (upperPoint z v hv)
  rw [hchar, one_mul] at he
  change f (rationalComplex r •
    (integralComplexMatrix (integralTranslation (3 * n)) • upperPoint z v hv)) = _ at he
  simpa only [integralTranslation_action, map_mul, map_ofNat] using he

/-- Translation of a periodic function multiplies its Fourier coefficient by the dual character. -/
lemma period_fourier_translation (f : ℂ → ℂ)
    (hf : ∀ (n : O) (z : ℂ), f (z + 3 * ringComplex n) = f z) (h : O) (b : ℂ) :
    (∫ z in periodDomain, f (z + b) * tracePhase (-cuspFrequency h * z)) =
      tracePhase (cuspFrequency h * b) * ∫ z in periodDomain, f z * tracePhase (-cuspFrequency h * z) := by
  have hperiod (n : O) (z : ℂ) :
      f (z + 3 * ringComplex n) * tracePhase (-cuspFrequency h * (z + 3 * ringComplex n)) =
        f z * tracePhase (-cuspFrequency h * z) := by
    rw [hf, cuspFrequency_negative_period]
  have he (z : ℂ) : f (z + b) * tracePhase (-cuspFrequency h * z) =
      tracePhase (cuspFrequency h * b) * (f (b + z) * tracePhase (-cuspFrequency h * (b + z))) := by
    rw [mul_left_comm, ← AddChar.map_add_eq_mul]
    rw [show cuspFrequency h * b + -cuspFrequency h * (b + z) = -cuspFrequency h * z by ring,
      add_comm b z]
  simp_rw [he]
  rw [integral_const_mul]
  exact congrArg (fun z : ℂ => tracePhase (cuspFrequency h * b) * z)
    (period_integral_translation (fun z => f z * tracePhase (-cuspFrequency h * z)) hperiod b)

def rationalCuspPhaseSum (h : O) : ℂ :=
  1 + tracePhase (cuspFrequency h) + tracePhase (cuspFrequency h * 2)

lemma fourCuspAverage_fourier (f : HyperbolicSpace → ℂ) (hc : Continuous f)
    (hf : ∀ n : levelThree, ∀ w, f (complexMatrix n • w) = complexCharacter n * f w)
    (v : ℝ) (hv : 0 < v) (h : O) :
    (∫ z in periodDomain, fourCuspAverage f (upperPoint z v hv) * tracePhase (-cuspFrequency h * z)) =
      (4 : ℂ)⁻¹ * ((∫ z in periodDomain, f (upperPoint z v hv) * tracePhase (-cuspFrequency h * z)) +
        rationalCuspPhaseSum h * ∫ z in periodDomain,
          f (rationalComplex ModularGroup.S • upperPoint z v hv) * tracePhase (-cuspFrequency h * z)) := by
  let A : ℂ → ℂ := fun z => f (upperPoint z v hv)
  let B : ℂ → ℂ := fun z => f (rationalComplex ModularGroup.S • upperPoint z v hv)
  let P : ℂ → ℂ := fun z => tracePhase (-cuspFrequency h * z)
  have hcoord : Continuous (fun z : ℂ => (⟨(z, v), hv⟩ : UpperCoordinates)) := by fun_prop
  have hu : Continuous (fun z : ℂ => upperPoint z v hv) :=
    upperCoordinatesHomeomorph.continuous.comp hcoord
  have hA : Continuous A := hc.comp hu
  have hB : Continuous B := hc.comp ((continuous_hyperbolic_action _).comp hu)
  have hP : Continuous P := tracePhase_continuous.comp (continuous_const.mul continuous_id)
  have hiA : IntegrableOn (fun z => A z * P z) periodDomain :=
    periodDomain_continuous_integrable _ (hA.mul hP)
  have hiB (b : ℂ) : IntegrableOn (fun z => B (z + b) * P z) periodDomain :=
    periodDomain_continuous_integrable _ ((hB.comp (continuous_id.add continuous_const)).mul hP)
  have hiB0 : IntegrableOn (fun z => B z * P z) periodDomain := by simpa only [add_zero] using hiB 0
  have hiAB : IntegrableOn (fun z => A z * P z + B z * P z) periodDomain := hiA.add hiB0
  have hiAB1 : IntegrableOn (fun z => A z * P z + B z * P z + B (z + 1) * P z) periodDomain :=
    hiAB.add (hiB 1)
  have hshift (b : ℂ) : (∫ z in periodDomain, B (z + b) * P z) =
      tracePhase (cuspFrequency h * b) * ∫ z in periodDomain, B z * P z :=
    period_fourier_translation B (rational_translate_period f hf ModularGroup.S v hv) h b
  have he (z : ℂ) : fourCuspAverage f (upperPoint z v hv) * P z =
      (4 : ℂ)⁻¹ * (A z * P z + B z * P z + B (z + 1) * P z + B (z + 2) * P z) := by
    have h1 := rational_T_pow_action 1 z v hv
    simp only [pow_one, Nat.cast_one] at h1
    have h2 := rational_T_pow_action 2 z v hv
    simp only [Nat.cast_ofNat] at h2
    simp only [fourCuspAverage, map_mul, mul_smul, h1, h2, A, B]
    ring
  change (∫ z in periodDomain, fourCuspAverage f (upperPoint z v hv) * P z) = _
  simp_rw [he]
  rw [integral_const_mul, integral_add hiAB1 (hiB 2),
    integral_add hiAB (hiB 1), integral_add hiA hiB0, hshift 1, hshift 2]
  dsimp only [rationalCuspPhaseSum, A, B, P]
  simp only [mul_one]
  ring

/-- The source Fourier series combines the original scattering series and the opposite-cusp Gauss series. -/
theorem rationalSourceEisenstein_fourier (v : ℝ) (hv : 0 < v) (s : ℂ) (hs : 2 < s.re) (h : O) :
    (∫ z in periodDomain, rationalSourceEisenstein s (upperPoint z v hv) * tracePhase (-cuspFrequency h * z)) =
      (4 : ℂ)⁻¹ * ((v : ℂ) ^ s * (if h = 0 then ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) else 0) +
        ((v : ℂ) ^ (2 - s) * sourceFourierKernel s (cuspFrequency h * v)) *
          (arithmeticDirichletSeries s h + rationalCuspPhaseSum h * unramifiedCubicGaussSeries s (9 * h))) := by
  simp_rw [rationalSourceEisenstein_four_cusps s hs]
  rw [fourCuspAverage_fourier _ (hyperbolicEisenstein_continuous s hs)
    (fun n w => hyperbolicEisenstein_automorphy n s hs w)]
  rw [show rationalComplex ModularGroup.S = oppositeMatrix from oppositeSource_matrix]
  change (4 : ℂ)⁻¹ * ((∫ z in periodDomain, upperEisenstein z v hv s * tracePhase (-cuspFrequency h * z)) +
    rationalCuspPhaseSum h * ∫ z in periodDomain, oppositeEisenstein z v hv s * tracePhase (-cuspFrequency h * z)) = _
  rw [integral_upperEisenstein_arithmetic v hv s hs h, oppositeEisenstein_fourier v hv s hs h]
  ring

lemma tracePhase_primary_frequency (h p k : O) (hprimary : lambda ^ 2 ∣ p - 1) :
    tracePhase (cuspFrequency (h * p) * ringComplex k) = tracePhase (cuspFrequency h * ringComplex k) := by
  obtain ⟨t, ht⟩ := three_dvd_lambda_sq.trans hprimary
  have hp : h * p = h + 3 * (h * t) := by linear_combination h * ht
  have he : cuspFrequency (h * p) * ringComplex k =
      cuspFrequency h * ringComplex k + ringComplex (h * t * k) / ringComplex traceLambda := by
    rw [hp]
    simp only [cuspFrequency, map_add, map_mul, map_ofNat]
    field_simp
  rw [he, AddChar.map_add_eq_mul, tracePhase_embedding_div_traceLambda, mul_one]

lemma rationalCuspPhaseSum_primary_mul (h p : O) (hprimary : lambda ^ 2 ∣ p - 1) :
    rationalCuspPhaseSum (h * p) = rationalCuspPhaseSum h := by
  have h1 := tracePhase_primary_frequency h p 1 hprimary
  have h2 := tracePhase_primary_frequency h p 2 hprimary
  simp only [map_one, mul_one] at h1
  simp only [map_ofNat] at h2
  rw [rationalCuspPhaseSum, rationalCuspPhaseSum, h1, h2]

/-- Arithmetic factor in the nonconstant Fourier modes of the rationally averaged source. -/
def rationalSourceArithmeticSeries (s : ℂ) (h : O) : ℂ :=
  (4 : ℂ)⁻¹ * (arithmeticDirichletSeries s h + rationalCuspPhaseSum h * unramifiedCubicGaussSeries s (9 * h))

lemma primary_prime_not_dvd_nine_frequency (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hph : ¬ p ∣ h) : ¬ p ∣ 9 * h := by
  simpa only [Units.val_one, pow_zero, mul_one] using
    ramified_prime_frequency_not_dvd h p hp hprimary hph 1 0

theorem rationalSourceArithmeticSeries_prime_recurrence (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (s : ℂ) (hs : 2 < s.re) (h : O) (hph : ¬ p ∣ h) :
    rationalSourceArithmeticSeries s (h * p ^ 3) =
      (1 + (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 * unramifiedNormWeight s (Ideal.span {p}) ^ 3) *
        rationalSourceArithmeticSeries s h -
      unramifiedNormWeight s (Ideal.span {p}) * cubicUnitGaussSum (9 * h) p *
        rationalSourceArithmeticSeries s (h * p) := by
  have hg := unramifiedCubicGaussSeries_prime_recurrence p hp hprimary s hs (9 * h)
    (primary_prime_not_dvd_nine_frequency p hp hprimary h hph)
  rw [primeCubicGauss_one_eq] at hg
  unfold rationalSourceArithmeticSeries
  rw [rationalCuspPhaseSum_primary_mul h (p ^ 3) (primary_pow_congruence p hprimary 3),
    rationalCuspPhaseSum_primary_mul h p hprimary, arithmeticDirichletSeries_prime_recurrence p hp hprimary s hs h hph,
    show 9 * (h * p ^ 3) = (9 * h) * p ^ 3 by ring, hg,
    show 9 * (h * p) = (9 * h) * p by ring]
  ring

theorem rationalSourceArithmeticSeries_cube_recurrence (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (s : ℂ) (hs : 2 < s.re) (h : O) (hh : h ≠ 0) :
    rationalSourceArithmeticSeries s (h * p ^ 6) =
      (1 + (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 * unramifiedNormWeight s (Ideal.span {p}) ^ 3) *
        rationalSourceArithmeticSeries s (h * p ^ 3) -
      (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 * unramifiedNormWeight s (Ideal.span {p}) ^ 3 *
        rationalSourceArithmeticSeries s h := by
  unfold rationalSourceArithmeticSeries
  rw [rationalCuspPhaseSum_primary_mul h (p ^ 6) (primary_pow_congruence p hprimary 6),
    rationalCuspPhaseSum_primary_mul h (p ^ 3) (primary_pow_congruence p hprimary 3),
    arithmeticDirichletSeries_cube_recurrence p hp hprimary s hs h hh,
    show 9 * (h * p ^ 6) = (9 * h) * p ^ 6 by ring,
    show 9 * (h * p ^ 3) = (9 * h) * p ^ 3 by ring,
    unramifiedCubicGaussSeries_cube_recurrence p hp hprimary s hs (9 * h)]
  ring

theorem rationalSourceArithmeticSeries_square_cube (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (s : ℂ) (hs : 2 < s.re) (h : O) (hph : ¬ p ∣ h) :
    rationalSourceArithmeticSeries s (h * p ^ 5) =
      (1 + (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 * unramifiedNormWeight s (Ideal.span {p}) ^ 3) *
        rationalSourceArithmeticSeries s (h * p ^ 2) := by
  unfold rationalSourceArithmeticSeries
  rw [rationalCuspPhaseSum_primary_mul h (p ^ 5) (primary_pow_congruence p hprimary 5),
    rationalCuspPhaseSum_primary_mul h (p ^ 2) (primary_pow_congruence p hprimary 2),
    arithmeticDirichletSeries_square_cube p hp hprimary s hs h hph,
    show 9 * (h * p ^ 5) = (9 * h) * p ^ 5 by ring,
    show 9 * (h * p ^ 2) = (9 * h) * p ^ 2 by ring,
    unramifiedCubicGaussSeries_square_cube p hp hprimary s hs (9 * h)
      (primary_prime_not_dvd_nine_frequency p hp hprimary h hph)]
  ring

/-- Compact translated support for a Fourier test on an arbitrary positive height interval. -/
def rationalIntervalCompact (a b : ℝ) (g : rationalExtension) : Set KernelQuotient :=
  kernelRationalAction g '' kernelCuspIntervalCompact a b

lemma rationalIntervalCompact_isCompact (a b : ℝ) (ha : 0 < a) (g : rationalExtension) :
    IsCompact (rationalIntervalCompact a b g) :=
  (kernelCuspIntervalCompact_isCompact a b ha).image (kernelRationalAction_continuous g)

def rationalIntervalFourier (a b : ℝ) (ha : 0 < a) (ρ : BoundedContinuousFunction ℝ ℂ)
    (h : O) (g : rationalExtension) : KernelQuotientL2 →L[ℂ] ℂ :=
  (kernelCuspIntervalFourier a b ha ρ h).comp (kernelRationalPullback g).toContinuousLinearMap

lemma rationalIntervalFourier_integral (a b : ℝ) (ha : 0 < a) (ρ : BoundedContinuousFunction ℝ ℂ)
    (h : O) (g : rationalExtension) (F : KernelQuotientL2) :
    rationalIntervalFourier a b ha ρ h g F = ∫ w in cuspPeriodStrip a b,
      F (kernelRationalAction g (integralOrbitProjection globalKubotaKernel w)) *
        cuspWeightedFourierPhase ρ h w ∂hyperbolicVolume := by
  rw [rationalIntervalFourier, ContinuousLinearMap.comp_apply, kernelCuspIntervalFourier_integral]
  have he := (kernelCuspInterval_projection_quasiMeasurePreserving a b ha).ae_eq_comp
    (kernelRationalPullback_ae g F)
  exact integral_congr_ae (he.mul (Eventually.of_forall (fun _ => rfl)))

lemma rationalIntervalFourier_restrict (a b : ℝ) (ha : 0 < a) (ρ : BoundedContinuousFunction ℝ ℂ)
    (h : O) (g : rationalExtension) (F : KernelQuotientL2) :
    rationalIntervalFourier a b ha ρ h g (kernelMassRestrictionCLM (rationalIntervalCompact a b g)
      (rationalIntervalCompact_isCompact a b ha g).measurableSet F) = rationalIntervalFourier a b ha ρ h g F := by
  rw [rationalIntervalFourier_integral, rationalIntervalFourier_integral]
  have hsource := (kernelRationalAction_measurePreserving g).quasiMeasurePreserving.ae_eq_comp
    (kernelMassRestriction_coe _ (rationalIntervalCompact_isCompact a b ha g).measurableSet F)
  have he := (kernelCuspInterval_projection_quasiMeasurePreserving a b ha).ae_eq_comp hsource
  apply integral_congr_ae
  filter_upwards [he, ae_restrict_mem (cuspPeriodStrip_measurable a b)] with w hw hwm
  have hm : kernelRationalAction g (integralOrbitProjection globalKubotaKernel w) ∈ rationalIntervalCompact a b g :=
    Set.mem_image_of_mem _ (Set.mem_image_of_mem _ (cuspPeriodStrip_subset_intervalHull a b hwm))
  exact congrArg (fun z : ℂ => z * cuspWeightedFourierPhase ρ h w)
    (hw.trans (Set.indicator_of_mem hm _))

def rationalIntervalFamily (a b : ℝ) (ha : 0 < a) (ρ : BoundedContinuousFunction ℝ ℂ)
    (h : O) (g : rationalExtension) (s : ℂ) : ℂ :=
  rationalIntervalFourier a b ha ρ h g
    (kernelLocalCorrectedSeed (rationalIntervalCompact a b g) (rationalIntervalCompact_isCompact a b ha g)
      2 3 (by norm_num) (by norm_num) s)

lemma rationalIntervalFamily_analyticAt (a b : ℝ) (ha : 0 < a) (ρ : BoundedContinuousFunction ℝ ℂ)
    (h : O) (g : rationalExtension) (s : ℂ) (hs : 1 < s.re) (hi : 0 < s.im) :
    AnalyticAt ℂ (rationalIntervalFamily a b ha ρ h g) s :=
  (ContinuousLinearMap.analyticAt (𝕜 := ℂ) (E := KernelQuotientL2) (F := ℂ)
    (rationalIntervalFourier a b ha ρ h g) _).comp_of_eq
      (kernelLocalCorrectedSeed_analyticAt_nonreal _ (rationalIntervalCompact_isCompact a b ha g)
        2 3 (by norm_num) (by norm_num) s hs.ne' hi.ne') rfl

lemma rationalIntervalFamily_residue_limit (a b : ℝ) (ha : 0 < a) (ρ : BoundedContinuousFunction ℝ ℂ)
    (h : O) (g : rationalExtension) :
    Tendsto (fun s : ℂ => (s - 4 / 3) * rationalIntervalFamily a b ha ρ h g s)
      (𝓝[≠] (4 / 3 : ℂ)) (𝓝 (rationalIntervalFourier a b ha ρ h g cubicEisensteinResidue)) := by
  have he := (rationalIntervalFourier a b ha ρ h g).continuous.continuousAt.tendsto.comp
    (cubicEisensteinResidue_local_limit _ (rationalIntervalCompact_isCompact a b ha g))
  simpa only [Function.comp_def, map_smul, smul_eq_mul, rationalIntervalFourier_restrict,
    rationalIntervalFamily] using he

lemma rationalIntervalFamily_initial (a b : ℝ) (ha : 0 < a) (ρ : BoundedContinuousFunction ℝ ℂ)
    (h : O) (g : rationalExtension) (s : ℂ) (hs : 4 < s.re) (hi : 0 < s.im) :
    rationalIntervalFamily a b ha ρ h g s = ∫ w in cuspPeriodStrip a b,
      hyperbolicEisenstein s (integralComplexMatrix (g : SL(2, O)) • w) *
        cuspWeightedFourierPhase ρ h w ∂hyperbolicVolume := by
  rw [rationalIntervalFamily, rationalIntervalFourier_integral]
  have hsource := (kernelRationalAction_measurePreserving g).quasiMeasurePreserving.ae_eq_comp
    (cubicEisensteinLocalFamily_initial_ae _ (rationalIntervalCompact_isCompact a b ha g) s hs hi)
  have he := (kernelCuspInterval_projection_quasiMeasurePreserving a b ha).ae_eq_comp hsource
  apply integral_congr_ae
  filter_upwards [he, ae_restrict_mem (cuspPeriodStrip_measurable a b)] with w hw hwm
  have hm : kernelRationalAction g (integralOrbitProjection globalKubotaKernel w) ∈ rationalIntervalCompact a b g :=
    Set.mem_image_of_mem _ (Set.mem_image_of_mem _ (cuspPeriodStrip_subset_intervalHull a b hwm))
  dsimp only [Function.comp_def] at hw
  rw [hw, Set.indicator_of_mem hm, kernelRationalAction_mk, kernelQuotientEisenstein_mk]

lemma rationalIntervalFamily_opposite_initial (a b : ℝ) (ha : 0 < a) (ρ : BoundedContinuousFunction ℝ ℂ)
    (h : O) (s : ℂ) (hs : 4 < s.re) (hi : 0 < s.im) :
    rationalIntervalFamily a b ha ρ h oppositeSource s =
      unramifiedCubicGaussSeries s (9 * h) * cuspIntervalWhittakerFactor a b ρ s h := by
  rw [rationalIntervalFamily_initial a b ha ρ h oppositeSource s hs hi]
  let g : HyperbolicSpace → ℂ := fun w =>
    hyperbolicEisenstein s (integralComplexMatrix (oppositeSource : SL(2, O)) • w) * cuspWeightedFourierPhase ρ h w
  have hg : Continuous g := ((hyperbolicEisenstein_continuous s (by linarith)).comp
    (continuous_hyperbolic_action _)).mul (cuspWeightedFourierPhase_continuous ρ h)
  rw [cuspInterval_integral_coordinates a b ha g hg.aestronglyMeasurable
    (cuspInterval_continuous_integrable a b ha g hg)]
  have hinner (v : ℝ) (hv : 0 < v) : (∫ z in periodDomain, g (cuspCoordinateLift (v, z))) =
      ρ v * (((v : ℂ) ^ (2 - s) * sourceFourierKernel s (cuspFrequency h * v)) *
        unramifiedCubicGaussSeries s (9 * h)) := by
    simp_rw [g, cuspCoordinateLift_positive v _ hv, hyperbolicEisenstein_opposite_upper,
      cuspWeightedFourierPhase, hyperbolicHeight_upperPoint, cuspFourierPhase, hyperbolicHorizontal_upperPoint]
    rw [← oppositeEisenstein_fourier v hv s (by linarith) h, ← integral_const_mul]
    exact integral_congr_ae (Eventually.of_forall (fun z => by ring))
  rw [cuspIntervalWhittakerFactor, ← integral_const_mul]
  apply setIntegral_congr_fun measurableSet_Icc
  intro v hv
  have hv0 := Complex.ofReal_ne_zero.mpr (ha.trans_le hv.1).ne'
  dsimp only
  rw [hinner v (ha.trans_le hv.1)]
  have hp : (v : ℂ) ^ (-s - 1) = (v : ℂ) ^ (2 - s) / (v : ℂ) ^ 3 := by
    rw [show -s - 1 = (2 - s) - 3 by ring, Complex.cpow_sub _ _ hv0]
    congr 1
    exact Complex.cpow_natCast _ 3
  rw [hp]
  ring

/-- Cross multiplication continues a Fourier factorization even when a weighted height factor vanishes. -/
theorem cuspScalarResidue_cross (T0 T1 H0 H1 : ℂ → ℂ) (R0 R1 : ℂ)
    (hT0 : AnalyticOnNhd ℂ T0 {s : ℂ | 1 < s.re ∧ 0 < s.im})
    (hT1 : AnalyticOnNhd ℂ T1 {s : ℂ | 1 < s.re ∧ 0 < s.im})
    (hH0 : AnalyticOnNhd ℂ H0 {s : ℂ | 1 < s.re ∧ 0 < s.im})
    (hH1 : AnalyticOnNhd ℂ H1 {s : ℂ | 1 < s.re ∧ 0 < s.im})
    (hH0c : ContinuousAt H0 (4 / 3 : ℂ)) (hH1c : ContinuousAt H1 (4 / 3 : ℂ))
    (hR0 : Tendsto (fun s : ℂ => (s - 4 / 3) * T0 s) (𝓝[≠] (4 / 3 : ℂ)) (𝓝 R0))
    (hR1 : Tendsto (fun s : ℂ => (s - 4 / 3) * T1 s) (𝓝[≠] (4 / 3 : ℂ)) (𝓝 R1))
    (hrel : ∀ s : ℂ, 4 < s.re → 0 < s.im → T0 s * H1 s = T1 s * H0 s) :
    R0 * H1 (4 / 3) = R1 * H0 (4 / 3) := by
  have hl : AnalyticOnNhd ℂ (fun s => T0 s * H1 s) {s : ℂ | 1 < s.re ∧ 0 < s.im} :=
    fun s hs => (hT0 s hs).mul (hH1 s hs)
  have hr : AnalyticOnNhd ℂ (fun s => T1 s * H0 s) {s : ℂ | 1 < s.re ∧ 0 < s.im} :=
    fun s hs => (hT1 s hs).mul (hH0 s hs)
  have hconvex : Convex ℝ {s : ℂ | 1 < s.re ∧ 0 < s.im} :=
    ((convex_Ioi (1 : ℝ)).linear_preimage Complex.reCLM.toLinearMap).inter
      ((convex_Ioi (0 : ℝ)).linear_preimage Complex.imCLM.toLinearMap)
  have hopen : IsOpen {s : ℂ | 4 < s.re ∧ 0 < s.im} :=
    (isOpen_lt continuous_const Complex.continuous_re).inter
      (isOpen_lt continuous_const Complex.continuous_im)
  have hev : (fun s => T0 s * H1 s) =ᶠ[𝓝 (5 + Complex.I : ℂ)] (fun s => T1 s * H0 s) := by
    filter_upwards [hopen.mem_nhds (by norm_num)] with s hs
    exact hrel s hs.1 hs.2
  have heq := hl.eqOn_of_preconnected_of_eventuallyEq hr hconvex.isPreconnected (by norm_num) hev
  have hlim0 := (hR0.mul (hH1c.tendsto.mono_left nhdsWithin_le_nhds)).comp thetaApproach_tendsto_complex_punctured
  have hlim1 := (hR1.mul (hH0c.tendsto.mono_left nhdsWithin_le_nhds)).comp thetaApproach_tendsto_complex_punctured
  apply tendsto_nhds_unique_of_eventuallyEq hlim0 hlim1
  filter_upwards [self_mem_nhdsWithin] with t ht
  change 0 < t at ht
  have htD : (4 / 3 : ℂ) + (t : ℂ) + (t : ℂ) * Complex.I ∈ {s : ℂ | 1 < s.re ∧ 0 < s.im} := by
    constructor
    · norm_num
      linarith
    · simpa using ht
  simpa only [Function.comp_def, mul_assoc] using congrArg
    (fun z : ℂ => ((4 / 3 : ℂ) + (t : ℂ) + (t : ℂ) * Complex.I - 4 / 3) * z) (heq htD)

lemma rationalCuspFamily_opposite_all_initial (h : O) (s : ℂ) (hs : 4 < s.re) (hi : 0 < s.im) :
    rationalCuspFamily h oppositeSource 2 3 (by norm_num) (by norm_num) s =
      unramifiedCubicGaussSeries s (9 * h) * cuspWhittakerHeightFactor s h := by
  rw [rationalCuspFamily_initial h oppositeSource 2 3
    (by norm_num) (by norm_num) (by norm_num) s hs hi, opposite_cusp_fourier_average s (by linarith)]

def oppositeCuspResidue (h : O) : ℂ :=
  rationalCuspFourier h oppositeSource cubicEisensteinResidue / cuspWhittakerHeightFactor (4 / 3) h

/-- Every positive height interval sees the same opposite-cusp residue, including the constant mode. -/
theorem rationalIntervalFourier_opposite_residue (a b : ℝ) (ha : 0 < a) (ρ : BoundedContinuousFunction ℝ ℂ)
    (h : O) : rationalIntervalFourier a b ha ρ h oppositeSource cubicEisensteinResidue =
      oppositeCuspResidue h * cuspIntervalWhittakerFactor a b ρ (4 / 3) h := by
  have he := cuspScalarResidue_cross
    (rationalIntervalFamily a b ha ρ h oppositeSource)
    (rationalCuspFamily h oppositeSource 2 3 (by norm_num) (by norm_num))
    (fun s => cuspIntervalWhittakerFactor a b ρ s h) (fun s => cuspWhittakerHeightFactor s h)
    (rationalIntervalFourier a b ha ρ h oppositeSource cubicEisensteinResidue)
    (rationalCuspFourier h oppositeSource cubicEisensteinResidue)
    (fun s hs => rationalIntervalFamily_analyticAt a b ha ρ h oppositeSource s hs.1 hs.2)
    (fun s hs => rationalCuspFamily_analyticAt_nonreal h oppositeSource 2 3
      (by norm_num) (by norm_num) s hs.1.ne' hs.2.ne')
    (fun s hs => cuspIntervalWhittakerFactor_analyticAt a b ha ρ h s hs.1)
    (fun s hs => cuspWhittakerHeightFactor_analyticAt h s hs.1)
    (cuspIntervalWhittakerFactor_analyticAt a b ha ρ h (4 / 3) (by norm_num)).continuousAt
    (cuspWhittakerHeightFactor_analyticAt h (4 / 3) (by norm_num)).continuousAt
    (rationalIntervalFamily_residue_limit a b ha ρ h oppositeSource)
    (rationalCuspFamily_residue_limit h oppositeSource 2 3 (by norm_num) (by norm_num)) (by
      intro s hs hi
      rw [rationalIntervalFamily_opposite_initial a b ha ρ h s hs hi,
        rationalCuspFamily_opposite_all_initial h s hs hi]
      ring)
  apply mul_right_cancel₀ (cuspWhittakerHeightFactor_center_ne_zero h)
  rw [he, oppositeCuspResidue]
  field_simp [cuspWhittakerHeightFactor_center_ne_zero h]

theorem oppositeCuspResidue_eq_unramified (h : O) : oppositeCuspResidue h = unramifiedGaussResidue (9 * h) := by
  have he := cuspScalarResidue_cross
    (rationalCuspFamily h oppositeSource 2 3 (by norm_num) (by norm_num))
    (rationalCuspFamily (3 * (9 * h)) oppositeSource 2 3 (by norm_num) (by norm_num))
    (fun s => cuspWhittakerHeightFactor s h) (fun s => cuspWhittakerHeightFactor s (3 * (9 * h)))
    (rationalCuspFourier h oppositeSource cubicEisensteinResidue)
    (rationalCuspFourier (3 * (9 * h)) oppositeSource cubicEisensteinResidue)
    (fun s hs => rationalCuspFamily_analyticAt_nonreal h oppositeSource 2 3
      (by norm_num) (by norm_num) s hs.1.ne' hs.2.ne')
    (fun s hs => rationalCuspFamily_analyticAt_nonreal (3 * (9 * h)) oppositeSource 2 3
      (by norm_num) (by norm_num) s hs.1.ne' hs.2.ne')
    (fun s hs => cuspWhittakerHeightFactor_analyticAt h s hs.1)
    (fun s hs => cuspWhittakerHeightFactor_analyticAt (3 * (9 * h)) s hs.1)
    (cuspWhittakerHeightFactor_analyticAt h (4 / 3) (by norm_num)).continuousAt
    (cuspWhittakerHeightFactor_analyticAt (3 * (9 * h)) (4 / 3) (by norm_num)).continuousAt
    (rationalCuspFamily_residue_limit h oppositeSource 2 3 (by norm_num) (by norm_num))
    (rationalCuspFamily_residue_limit (3 * (9 * h)) oppositeSource 2 3 (by norm_num) (by norm_num)) (by
      intro s hs hi
      rw [rationalCuspFamily_opposite_all_initial h s hs hi,
        rationalCuspFamily_opposite_initial (9 * h) s hs hi]
      ring)
  unfold oppositeCuspResidue unramifiedGaussResidue
  exact (div_eq_div_iff (cuspWhittakerHeightFactor_center_ne_zero h)
    (cuspWhittakerHeightFactor_center_ne_zero (3 * (9 * h)))).mpr he

lemma cuspIntervalWhittakerFactor_center_bessel (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (hh : h ≠ 0) :
    cuspIntervalWhittakerFactor a b ρ (4 / 3) h =
      ((2 * Real.pi : ℂ) / Complex.Gamma (4 / 3) *
        (2 * Real.pi * ‖cuspFrequency h‖ : ℂ) ^ (1 / 3 : ℂ)) *
      ∫ v in Set.Icc a b, ρ v *
        (schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) / (v : ℂ) ^ 2) := by
  rw [cuspIntervalWhittakerFactor, ← integral_const_mul]
  apply setIntegral_congr_fun measurableSet_Icc
  intro v hv
  dsimp only
  rw [sourceFourierKernel_residual_height h hh v (ha.trans_le hv.1)]
  ring

/-- Bessel coefficient of the residual function at the opposite cusp. -/
def oppositeResidualFourierCoefficient (h : O) : ℂ :=
  (oppositeCuspResidue h / ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ)) *
    ((2 * Real.pi : ℂ) / Complex.Gamma (4 / 3) *
      (2 * Real.pi * ‖cuspFrequency h‖ : ℂ) ^ (1 / 3 : ℂ))

theorem rationalIntervalFourier_opposite_bessel (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (hh : h ≠ 0) :
    rationalIntervalFourier a b ha ρ h oppositeSource cubicEisensteinResidue =
      ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * oppositeResidualFourierCoefficient h *
        ∫ v in Set.Icc a b, ρ v *
          (schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) / (v : ℂ) ^ 2) := by
  rw [rationalIntervalFourier_opposite_residue,
    cuspIntervalWhittakerFactor_center_bessel a b ha ρ h hh, oppositeResidualFourierCoefficient]
  field_simp [cusp_volume_ne_zero]

/-- Rational pullback preserves the uniform Fourier-test bound. -/
theorem rationalIntervalFourier_uniform_bound (a b : ℝ) (ha : 0 < a) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (ρ : BoundedContinuousFunction ℝ ℂ) (h : O)
      (g : rationalExtension) (F : KernelQuotientL2),
      ‖rationalIntervalFourier a b ha ρ h g F‖ ≤ C * ‖ρ‖ * ‖F‖ := by
  obtain ⟨C, hC, hbound⟩ := kernelCuspIntervalFourier_uniform_bound a b ha
  refine ⟨C, hC, ?_⟩
  intro ρ h g F
  change ‖kernelCuspIntervalFourier a b ha ρ h (kernelRationalPullback g F)‖ ≤ _
  simpa only [LinearIsometry.norm_map] using hbound ρ h (kernelRationalPullback g F)

lemma oppositeResidualFourierCoefficient_interval_bound (a b : ℝ) (ha : 0 < a) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖oppositeResidualFourierCoefficient h‖ * ‖∫ v in Set.Icc a b,
        schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) / (v : ℂ) ^ 2‖ ≤ C := by
  obtain ⟨C, hC, hbound⟩ := rationalIntervalFourier_uniform_bound a b ha
  let area : ℂ := ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ)
  have harea : 0 < ‖area‖ := norm_pos_iff.mpr cusp_volume_ne_zero
  refine ⟨C * ‖BoundedContinuousFunction.const ℝ (1 : ℂ)‖ * ‖cubicEisensteinResidue‖ / ‖area‖,
    by positivity, ?_⟩
  intro h hh
  have hb := hbound (BoundedContinuousFunction.const ℝ 1) h oppositeSource cubicEisensteinResidue
  rw [rationalIntervalFourier_opposite_bessel a b ha _ h hh] at hb
  simp only [BoundedContinuousFunction.const_apply, one_mul, norm_mul] at hb
  apply (le_div_iff₀ harea).mpr
  calc
    _ = ‖area‖ * ‖oppositeResidualFourierCoefficient h‖ * ‖∫ v in Set.Icc a b,
        schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) / (v : ℂ) ^ 2‖ := by ring
    _ ≤ _ := hb

theorem oppositeResidualFourierCoefficient_subexponential (ε : ℝ) (hε : 0 < ε) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖oppositeResidualFourierCoefficient h‖ ≤ C * Real.exp (ε * ‖cuspFrequency h‖) :=
  cubicBesselCoefficient_subexponential oppositeResidualFourierCoefficient
    oppositeResidualFourierCoefficient_interval_bound ε hε

lemma rationalCuspPhaseSum_norm_le (h : O) : ‖rationalCuspPhaseSum h‖ ≤ 3 := by
  calc
    _ ≤ ‖(1 : ℂ) + tracePhase (cuspFrequency h)‖ + ‖tracePhase (cuspFrequency h * 2)‖ := norm_add_le _ _
    _ ≤ (‖(1 : ℂ)‖ + ‖tracePhase (cuspFrequency h)‖) + ‖tracePhase (cuspFrequency h * 2)‖ :=
      add_le_add (norm_add_le (1 : ℂ) (tracePhase (cuspFrequency h))) le_rfl
    _ = 3 := by rw [norm_one, tracePhase_norm, tracePhase_norm]; norm_num

def rationalSourceResidualFourierCoefficient (h : O) : ℂ :=
  (4 : ℂ)⁻¹ * (cubicResidualFourierCoefficient h + rationalCuspPhaseSum h * oppositeResidualFourierCoefficient h)

theorem rationalSourceResidualFourierCoefficient_subexponential (ε : ℝ) (hε : 0 < ε) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖rationalSourceResidualFourierCoefficient h‖ ≤ C * Real.exp (ε * ‖cuspFrequency h‖) := by
  obtain ⟨C, hC, hboundC⟩ := cubicResidualFourierCoefficient_subexponential ε hε
  obtain ⟨D, hD, hboundD⟩ := oppositeResidualFourierCoefficient_subexponential ε hε
  refine ⟨(4 : ℝ)⁻¹ * (C + 3 * D), by positivity, ?_⟩
  intro h hh
  have hsum : ‖cubicResidualFourierCoefficient h + rationalCuspPhaseSum h * oppositeResidualFourierCoefficient h‖ ≤
      ‖cubicResidualFourierCoefficient h‖ + 3 * ‖oppositeResidualFourierCoefficient h‖ := by
    apply (norm_add_le _ _).trans
    rw [norm_mul]
    exact add_le_add le_rfl (mul_le_mul_of_nonneg_right (rationalCuspPhaseSum_norm_le h)
      (norm_nonneg (oppositeResidualFourierCoefficient h)))
  rw [rationalSourceResidualFourierCoefficient, norm_mul]
  have hnorm : ‖(4 : ℂ)⁻¹‖ = (4 : ℝ)⁻¹ := by norm_num
  rw [hnorm]
  calc
    _ ≤ (4 : ℝ)⁻¹ * (‖cubicResidualFourierCoefficient h‖ + 3 * ‖oppositeResidualFourierCoefficient h‖) :=
      mul_le_mul_of_nonneg_left hsum (by positivity)
    _ ≤ (4 : ℝ)⁻¹ * (C * Real.exp (ε * ‖cuspFrequency h‖) + 3 * (D * Real.exp (ε * ‖cuspFrequency h‖))) :=
      mul_le_mul_of_nonneg_left (add_le_add (hboundC h hh)
        (mul_le_mul_of_nonneg_left (hboundD h hh) (by norm_num))) (by positivity)
    _ = _ := by ring

lemma cuspFourier_continuous_log_height (f : HyperbolicSpace → ℂ) (hf : Continuous f) (h : O) :
    Continuous (fun t : ℝ => ∫ z in periodDomain,
      f (upperPoint z (Real.exp t) (Real.exp_pos t)) * tracePhase (-cuspFrequency h * z)) := by
  let F : ℝ → ℂ → ℂ := fun t z =>
    f (upperPoint z (Real.exp t) (Real.exp_pos t)) * tracePhase (-cuspFrequency h * z)
  have hcoord : Continuous (fun p : ℝ × ℂ =>
      (⟨(p.2, Real.exp p.1), Real.exp_pos p.1⟩ : UpperCoordinates)) := by fun_prop
  have hF : Continuous F.uncurry :=
    (hf.comp (upperCoordinatesHomeomorph.continuous.comp hcoord)).mul
      (tracePhase_continuous.comp (continuous_const.mul continuous_snd))
  let K : Set ℂ := Metric.closedBall 0 (∑ i, ‖periodBasis i‖)
  have hsub : periodDomain ⊆ K := by
    intro z hz
    simpa only [K, Metric.mem_closedBall, dist_zero_right] using norm_mem_periodDomain z hz
  have hμ : (volume.restrict periodDomain).restrict K = (volume : Measure ℂ).restrict periodDomain := by
    rw [Measure.restrict_restrict (isCompact_closedBall 0 (∑ i, ‖periodBasis i‖)).measurableSet, inter_eq_right.mpr hsub]
  letI : IsFiniteMeasure ((volume : Measure ℂ).restrict periodDomain) := isFiniteMeasure_restrict.mpr (by
    rw [periodDomain_volume]
    exact ENNReal.ofReal_ne_top)
  have hc := continuous_parametric_integral_of_continuous (μ := volume.restrict periodDomain) hF
    (isCompact_closedBall 0 (∑ i, ‖periodBasis i‖))
  change Continuous (fun t => ∫ z, F t z ∂(volume.restrict periodDomain).restrict K) at hc
  rw [hμ] at hc
  exact hc

def continuousCuspSlice (f : HyperbolicSpace → ℂ) (h : O) (v : ℝ) : ℂ :=
  (∫ z in periodDomain, f (cuspCoordinateLift (v, z)) * tracePhase (-cuspFrequency h * z)) / (v : ℂ) ^ 3

lemma continuousCuspSlice_continuousOn (f : HyperbolicSpace → ℂ) (hf : Continuous f) (h : O) :
    ContinuousOn (continuousCuspSlice f h) (Ioi 0) := by
  let J : ℝ → ℂ := fun t => ∫ z in periodDomain,
    f (upperPoint z (Real.exp t) (Real.exp_pos t)) * tracePhase (-cuspFrequency h * z)
  have hJ : Continuous J := cuspFourier_continuous_log_height f hf h
  have hc : ContinuousOn (fun v : ℝ => J (Real.log v) / (v : ℂ) ^ 3) (Ioi 0) := by
    intro v hv
    exact ((hJ.continuousAt.comp (Real.continuousAt_log hv.ne')).div
      ((Complex.continuous_ofReal.pow 3).continuousAt)
      (pow_ne_zero 3 (Complex.ofReal_ne_zero.mpr hv.ne'))).continuousWithinAt
  apply hc.congr
  intro v hv
  simp only [continuousCuspSlice, J, cuspCoordinateLift_positive v _ hv, Real.exp_log hv]

lemma continuousCuspSlice_weighted_integral (f : HyperbolicSpace → ℂ) (hf : Continuous f)
    (a b : ℝ) (ha : 0 < a) (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) :
    (∫ w in cuspPeriodStrip a b, f w * cuspWeightedFourierPhase ρ h w ∂hyperbolicVolume) =
      ∫ v in Set.Icc a b, ρ v * continuousCuspSlice f h v := by
  let g : HyperbolicSpace → ℂ := fun w => f w * cuspWeightedFourierPhase ρ h w
  have hg : Continuous g := hf.mul (cuspWeightedFourierPhase_continuous ρ h)
  rw [cuspInterval_integral_coordinates a b ha g hg.aestronglyMeasurable
    (cuspInterval_continuous_integrable a b ha g hg)]
  apply setIntegral_congr_fun measurableSet_Icc
  intro v hv
  have hpos := ha.trans_le hv.1
  change (∫ z in periodDomain, g (cuspCoordinateLift (v, z))) / (v : ℂ) ^ 3 =
    ρ v * ((∫ z in periodDomain,
      f (cuspCoordinateLift (v, z)) * tracePhase (-cuspFrequency h * z)) / (v : ℂ) ^ 3)
  rw [← mul_div_assoc]
  congr 1
  rw [← integral_const_mul]
  apply integral_congr_ae
  exact Eventually.of_forall (fun z => by
    dsimp only [g]
    rw [cuspWeightedFourierPhase, cuspFourierPhase, cuspCoordinateLift_positive v z hpos,
      hyperbolicHeight_upperPoint, hyperbolicHorizontal_upperPoint]
    ring)

/-- Continuous Fourier slices are determined at every positive height by bounded interval tests. -/
theorem continuousCuspSlice_eq_of_interval_tests (f : HyperbolicSpace → ℂ) (hf : Continuous f)
    (h : O) (D : ℝ → ℂ) (hD : ContinuousOn D (Set.Ioi 0))
    (htest : ∀ a b : ℝ, ∀ _ha : 0 < a, ∀ ρ : BoundedContinuousFunction ℝ ℂ,
      (∫ w in cuspPeriodStrip a b, f w * cuspWeightedFourierPhase ρ h w ∂hyperbolicVolume) =
        ∫ v in Set.Icc a b, ρ v * D v)
    (v : ℝ) (hv : 0 < v) : continuousCuspSlice f h v = D v := by
  let a := v / 2
  let b := 2 * v
  have ha : 0 < a := half_pos hv
  have hs : Set.Icc a b ⊆ Set.Ioi 0 := fun x hx => ha.trans_le hx.1
  have hc := (continuousCuspSlice_continuousOn f hf h).mono hs
  have hd := hD.mono hs
  have he : continuousCuspSlice f h =ᵐ[volume.restrict (Set.Icc a b)] D := by
    apply interval_ae_eq_of_boundedContinuous_tests a b _ _ hc.integrableOn_Icc hd.integrableOn_Icc
    intro ρ
    rw [← continuousCuspSlice_weighted_integral f hf a b ha ρ h]
    exact htest a b ha ρ
  have he' := ae_restrict_of_ae_restrict_of_subset Ioo_subset_Icc_self he
  exact Measure.eqOn_Ioo_of_ae_eq volume he' (hc.mono Ioo_subset_Icc_self)
    (hd.mono Ioo_subset_Icc_self) (by constructor <;> dsimp [a, b] <;> linarith)

lemma rationalIntervalFourier_residual_integral (a b : ℝ) (ha : 0 < a) (ρ : BoundedContinuousFunction ℝ ℂ)
    (h : O) (g : rationalExtension) :
    rationalIntervalFourier a b ha ρ h g cubicEisensteinResidue = ∫ w in cuspPeriodStrip a b,
      cubicResidualFunction (integralComplexMatrix (g : SL(2, O)) • w) *
        cuspWeightedFourierPhase ρ h w ∂hyperbolicVolume := by
  rw [rationalIntervalFourier_integral]
  have he := (measurePreserving_smul (integralComplexMatrix (g : SL(2, O)))
    hyperbolicVolume).quasiMeasurePreserving.ae_eq_comp cubicEisensteinResidue_continuous_representative
  apply integral_congr_ae
  filter_upwards [ae_restrict_of_ae he (s := cuspPeriodStrip a b)] with w hw
  exact congrArg (fun z : ℂ => z * cuspWeightedFourierPhase ρ h w) hw

/-- Every opposite-cusp Fourier mode is the archimedean kernel times the actual Gauss residue. -/
theorem cubicResidualFunction_opposite_fourier (v : ℝ) (hv : 0 < v) (h : O) :
    (∫ z in periodDomain, cubicResidualFunction (rationalComplex ModularGroup.S • upperPoint z v hv) *
      tracePhase (-cuspFrequency h * z)) =
      oppositeCuspResidue h * ((v : ℂ) ^ (2 / 3 : ℂ) * sourceFourierKernel (4 / 3) (cuspFrequency h * v)) := by
  let f : HyperbolicSpace → ℂ := fun w => cubicResidualFunction (rationalComplex ModularGroup.S • w)
  have hf : Continuous f := cubicResidualFunction_continuous.comp (continuous_hyperbolic_action _)
  let D : ℝ → ℂ := fun v => oppositeCuspResidue h *
    ((v : ℂ) ^ (-(4 / 3 : ℂ) - 1) * sourceFourierKernel (4 / 3) (cuspFrequency h * v))
  have hD : ContinuousOn D (Set.Ioi 0) := by
    intro v hv
    exact (continuousAt_const.mul
      ((Complex.continuousAt_ofReal_cpow_const v _ (Or.inr hv.ne')).mul
        (((sourceFourierKernel_continuous_freq (4 / 3) (by norm_num)).comp
          (Complex.continuous_ofReal.const_mul (cuspFrequency h))).continuousAt))).continuousWithinAt
  have he := continuousCuspSlice_eq_of_interval_tests f hf h D hD (by
    intro a b ha ρ
    change (∫ w in cuspPeriodStrip a b,
      cubicResidualFunction (integralComplexMatrix (oppositeSource : SL(2, O)) • w) *
        cuspWeightedFourierPhase ρ h w ∂hyperbolicVolume) = _
    rw [← rationalIntervalFourier_residual_integral a b ha ρ h oppositeSource,
      rationalIntervalFourier_opposite_residue, cuspIntervalWhittakerFactor, ← integral_const_mul]
    apply integral_congr_ae
    exact Eventually.of_forall (fun v => by dsimp only [D]; ring)) v hv
  have hv0 : (v : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hv.ne'
  have hpow : (v : ℂ) ^ (-(4 / 3 : ℂ) - 1) * (v : ℂ) ^ 3 = (v : ℂ) ^ (2 / 3 : ℂ) := by
    rw [← Complex.cpow_natCast, ← Complex.cpow_add _ _ hv0]
    congr 1
    norm_num
  dsimp only [continuousCuspSlice, f, D] at he
  simp_rw [cuspCoordinateLift_positive v _ hv] at he
  rw [div_eq_iff (pow_ne_zero 3 hv0)] at he
  rw [he]
  linear_combination oppositeCuspResidue h * sourceFourierKernel (4 / 3) (cuspFrequency h * v) * hpow

lemma oppositeResidual_whittaker_bessel (v : ℝ) (hv : 0 < v) (h : O) (hh : h ≠ 0) :
    oppositeCuspResidue h * ((v : ℂ) ^ (2 / 3 : ℂ) * sourceFourierKernel (4 / 3) (cuspFrequency h * v)) =
      ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * oppositeResidualFourierCoefficient h * (v : ℂ) *
        schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) := by
  have hv0 : (v : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hv.ne'
  have hp : (v : ℂ) ^ (-(4 / 3 : ℂ) - 1) * (v : ℂ) ^ 3 = (v : ℂ) ^ (2 / 3 : ℂ) := by
    rw [← Complex.cpow_natCast, ← Complex.cpow_add _ _ hv0]
    congr 1
    norm_num
  calc
    _ = oppositeCuspResidue h * (((v : ℂ) ^ (-(4 / 3 : ℂ) - 1) *
        sourceFourierKernel (4 / 3) (cuspFrequency h * v)) * (v : ℂ) ^ 3) := by rw [← hp]; ring
    _ = _ := by
      rw [sourceFourierKernel_residual_height h hh v hv, oppositeResidualFourierCoefficient]
      field_simp [hv0, cusp_volume_ne_zero]

theorem cubicResidualFunction_opposite_fourier_bessel (v : ℝ) (hv : 0 < v) (h : O) (hh : h ≠ 0) :
    (∫ z in periodDomain, cubicResidualFunction (rationalComplex ModularGroup.S • upperPoint z v hv) *
      tracePhase (-cuspFrequency h * z)) =
      ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * oppositeResidualFourierCoefficient h * (v : ℂ) *
        schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) := by
  rw [cubicResidualFunction_opposite_fourier, oppositeResidual_whittaker_bessel v hv h hh]

/-- The explicit source coefficient is the Fourier coefficient of the actual projected residual vector. -/
theorem cubicSourceResidualFunction_fourier_bessel (v : ℝ) (hv : 0 < v) (h : O) (hh : h ≠ 0) :
    (∫ z in periodDomain, cubicSourceResidualFunction (upperPoint z v hv) * tracePhase (-cuspFrequency h * z)) =
      ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * rationalSourceResidualFourierCoefficient h * (v : ℂ) *
        schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) := by
  simp_rw [cubicSourceResidualFunction_four_cusps]
  rw [fourCuspAverage_fourier _ cubicResidualFunction_continuous cubicResidualFunction_automorphy,
    cubicResidualFunction_fourier, cubicResidualFunction_opposite_fourier_bessel v hv h hh,
    cubicResidualFullModeAmplitude, if_neg hh, rationalSourceResidualFourierCoefficient]
  ring

/-- The two independent ramified symbol classes force both a sign and a cube exponent. -/
lemma ramified_constant_support (u : Oˣ) (n : ℕ)
    (hA : arithmeticResidueSum 0 ((u : O) * lambda ^ (n + 2)) ≠ 0) :
    (u = 1 ∨ u = -1) ∧ 3 ∣ n + 2 := by
  have he := constant_coefficient_ramified_equation _ (ramifiedElement_ne_zero u (n + 2))
    (ramifiedElement_level u (n + 2) (by omega)) hA u (n + 2) 1 one_ne_zero
    (by simp only [one_pow, mul_one])
  have hu := unit_eq_sign_of_symbol_class u (by
    simpa only [cubicExp_zero, one_pow, mul_one] using he 0 1)
  have hpow : omega ^ (n + 2) = 1 := by
    rcases hu with hu | hu
    · simpa only [hu, symbol_one_numerator _ (primaryCoord_primary 1 0), one_mul,
        cubicExp, Int.reduceMod, Int.toNat_one, pow_one] using he 1 0
    · simpa only [hu, symbol_neg_one _ (primaryCoord_primary 1 0), one_mul,
        cubicExp, Int.reduceMod, Int.toNat_one, pow_one] using he 1 0
  exact ⟨hu.imp (fun h => Units.ext h) (fun h => Units.ext h),
    (omega_primitive.pow_eq_one_iff_dvd (n + 2)).mp hpow⟩

lemma arithmeticResidueSum_zero_ramified (u : Oˣ) (n : ℕ) :
    arithmeticResidueSum 0 ((u : O) * lambda ^ (n + 2)) =
      if u = 1 ∨ u = -1 then if 3 ∣ n + 2 then ((3 ^ (n + 2) : ℕ) : ℂ) else 0 else 0 := by
  by_cases hu : u = 1 ∨ u = -1
  · rw [if_pos hu]
    by_cases hn : 3 ∣ n + 2
    · rw [if_pos hn]
      obtain ⟨j, hj⟩ := hn
      have hjpos : 0 < j := by omega
      obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hjpos.ne'
      let I : GoodIdeal := ⟨1, by rw [primaryIdealGenerator_one]; exact one_ne_zero⟩
      have hcol (b : Bool) : cubeColumn b k I = cubeSign b * lambda ^ (n + 2) := by
        rw [cubeColumn_expanded]
        simp only [I, primaryIdealGenerator_one, mul_one, cubeSign_cube]
        rw [← hj]
        exact mul_comm _ _
      have hval (b : Bool) := (congrArg (arithmeticResidueSum 0) (hcol b)).symm.trans
        (cubeColumn_arithmetic_sum b k I)
      have htot : idealTotient (1 : Ideal O) = 1 := by
        have hz (x : O ⧸ (1 : Ideal O)) : x = 0 := by
          obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (by simp)
        letI : Subsingleton (O ⧸ (1 : Ideal O)) := ⟨fun x y => (hz x).trans (hz y).symm⟩
        simp [idealTotient]
      simp only [I, map_one, one_pow, mul_one, htot] at hval
      rcases hu with rfl | rfl
      · simpa only [cubeSign, Units.val_one, one_mul, hj] using hval false
      · simpa only [cubeSign, Units.val_neg, Units.val_one, hj] using hval true
    · rw [if_neg hn]
      exact not_ne_iff.mp (fun hA => hn (ramified_constant_support u n hA).2)
  · rw [if_neg hu]
    exact not_ne_iff.mp (fun hA => hu (ramified_constant_support u n hA).1)

/-- The constant mode separates into a ramified scalar and the unramified Gauss series. -/
lemma arithmeticDirichletSeries_zero_separate (s : ℂ) (hs : 2 < s.re) :
    arithmeticDirichletSeries s 0 =
      (∑' u : Oˣ, ∑' n : ℕ, ((3 ^ (n + 2) : ℕ) : ℂ) ^ (-s) *
        arithmeticResidueSum 0 ((u : O) * lambda ^ (n + 2))) * unramifiedCubicGaussSeries s 0 := by
  rw [arithmeticDirichletSeries_ramified_reindex s hs 0, ← tsum_mul_right]
  apply tsum_congr
  intro u
  rw [← tsum_mul_right]
  apply tsum_congr
  intro n
  rw [unramifiedCubicGaussSeries, ← tsum_mul_left]
  apply tsum_congr
  intro I
  simpa only [mul_zero, zero_mul] using arithmeticDirichletTerm_ramified_gauss s 0 u n I

/-- Positive ramified cube exponents, with the level-three shift removed. -/
def ramifiedCubeExponent : ℕ ≃ {n : ℕ // 3 ∣ n + 2} :=
  Equiv.ofBijective (fun k => ⟨3 * k + 1, ⟨k + 1, by omega⟩⟩) ⟨by
    intro a b he
    have he' := congrArg Subtype.val he
    dsimp only at he'
    omega, by
    rintro ⟨n, k, hk⟩
    refine ⟨k - 1, Subtype.ext ?_⟩
    dsimp only
    omega⟩

lemma zero_ramified_geometric (s : ℂ) (hs : 1 < s.re) :
    (∑' n : ℕ, ((3 ^ (n + 2) : ℕ) : ℂ) ^ (-s) *
      (if 3 ∣ n + 2 then ((3 ^ (n + 2) : ℕ) : ℂ) else 0)) =
      ((3 : ℂ) ^ (3 * s - 3) - 1)⁻¹ := by
  let F : ℕ → ℂ := fun n => ((3 ^ (n + 2) : ℕ) : ℂ) ^ (-s) *
    (if 3 ∣ n + 2 then ((3 ^ (n + 2) : ℕ) : ℂ) else 0)
  have hsup : Function.support F ⊆ {n : ℕ | 3 ∣ n + 2} := by
    intro n hn
    by_contra h
    change ¬ 3 ∣ n + 2 at h
    exact hn (by simp only [F, if_neg h, mul_zero])
  change (∑' n, F n) = _
  rw [← tsum_subtype_eq_of_support_subset hsup]
  change (∑' n : {n : ℕ // 3 ∣ n + 2}, F n.val) = _
  rw [← ramifiedCubeExponent.tsum_eq]
  have he (k : ℕ) : F (ramifiedCubeExponent k).val = ramifiedRatio s ^ (k + 1) := by
    change ((3 ^ (3 * k + 1 + 2) : ℕ) : ℂ) ^ (-s) *
      (if 3 ∣ 3 * k + 1 + 2 then ((3 ^ (3 * k + 1 + 2) : ℕ) : ℂ) else 0) = _
    rw [if_pos (show 3 ∣ 3 * k + 1 + 2 from ⟨k + 1, by omega⟩),
      show 3 * k + 1 + 2 = 3 * (k + 1) by omega]
    simpa using cube_norm_weight_algebra s k 1 (by decide)
  simp_rw [he]
  exact ramified_geometric_sum s hs

lemma zero_ramified_factor (s : ℂ) (hs : 1 < s.re) :
    (∑' u : Oˣ, ∑' n : ℕ, ((3 ^ (n + 2) : ℕ) : ℂ) ^ (-s) *
      arithmeticResidueSum 0 ((u : O) * lambda ^ (n + 2))) =
      2 * ((3 : ℂ) ^ (3 * s - 3) - 1)⁻¹ := by
  have hne : (1 : Oˣ) ≠ -1 := by
    intro he
    have hv := congrArg Units.val he
    norm_num at hv
  rw [tsum_eq_sum (s := {1, -1}) (fun u hu => by
    have hn : ¬ (u = 1 ∨ u = -1) := by simpa only [Finset.mem_insert,
      Finset.mem_singleton] using hu
    simp only [arithmeticResidueSum_zero_ramified, if_neg hn, mul_zero, tsum_zero])]
  simp only [Finset.sum_insert, Finset.mem_singleton, hne, not_false_eq_true, Finset.sum_singleton,
    arithmeticResidueSum_zero_ramified, true_or, or_true, ite_true]
  rw [zero_ramified_geometric s hs]
  ring

theorem arithmeticDirichletSeries_zero_unramified (s : ℂ) (hs : 2 < s.re) :
    arithmeticDirichletSeries s 0 =
      (2 * ((3 : ℂ) ^ (3 * s - 3) - 1)⁻¹) * unramifiedCubicGaussSeries s 0 := by
  rw [arithmeticDirichletSeries_zero_separate s hs, zero_ramified_factor s (by linarith)]

lemma ramifiedDenominator_analytic (s : ℂ) :
    AnalyticAt ℂ (fun z : ℂ => (3 : ℂ) ^ (3 * z - 3) - 1) s := by
  apply Complex.analyticAt_iff_eventually_differentiableAt.mpr
  exact Eventually.of_forall fun z =>
    (((differentiableAt_id.const_mul 3).sub_const 3).const_cpow
      (Or.inl (by norm_num : (3 : ℂ) ≠ 0))).sub_const 1

lemma ramifiedDenominator_ne_zero (s : ℂ) (hs : 1 < s.re) :
    (3 : ℂ) ^ (3 * s - 3) - 1 ≠ 0 := by
  intro hz
  have hn := norm_ramifiedRatio_lt_one s hs
  have hi : ramifiedRatio s = ((3 : ℂ) ^ (3 * s - 3))⁻¹ := by
    rw [ramifiedRatio, ← Complex.cpow_neg]
    congr 1
    ring
  rw [hi, sub_eq_zero.mp hz, inv_one, norm_one] at hn
  exact lt_irrefl 1 hn

lemma cuspWhittakerHeightFactor_zero (s : ℂ) (hs : 1 < s.re) :
    cuspWhittakerHeightFactor s 0 = (Real.pi : ℂ) / (s - 1) *
      cuspIntervalMellin 5 6 (BoundedContinuousFunction.const ℝ 1) (-s - 1) := by
  simp only [cuspWhittakerHeightFactor, cuspFrequency, map_zero, zero_div, zero_mul,
    sourceFourierKernel_zero s hs, integral_mul_const, cuspIntervalMellin,
    BoundedContinuousFunction.const_apply, one_mul]
  exact mul_comm _ _

lemma cuspIntervalOutgoingFamily_unit_initial (s : ℂ) (hs : 4 < s.re) (hi : 0 < s.im) :
    cuspIntervalOutgoingFamily 5 6 (by norm_num) (BoundedContinuousFunction.const ℝ 1) s =
      arithmeticDirichletSeries s 0 * cuspWhittakerHeightFactor s 0 := by
  rw [cuspIntervalOutgoingFamily,
    kernelCuspIntervalFourierFamily_zero_initial 5 6 (by norm_num) _ s hs hi,
    cuspWhittakerHeightFactor_zero s (by linarith), scatteringCoefficient]
  field_simp [cusp_volume_ne_zero]
  ring

/-- The opposite cusp has the same constant residue as the original cusp. -/
theorem oppositeCuspResidue_zero : oppositeCuspResidue 0 =
    ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * constantArithmeticResidue := by
  let η := BoundedContinuousFunction.const ℝ (1 : ℂ)
  have he := cuspScalarResidue_cross
    (cuspIntervalOutgoingFamily 5 6 (by norm_num) η)
    (rationalCuspFamily 0 oppositeSource 2 3 (by norm_num) (by norm_num))
    (fun _ => 2) (fun s => (3 : ℂ) ^ (3 * s - 3) - 1)
    (kernelCuspIntervalFourier 5 6 (by norm_num) η 0 cubicEisensteinResidue)
    (rationalCuspFourier 0 oppositeSource cubicEisensteinResidue)
    (fun s hs => cuspIntervalOutgoingFamily_analyticAt 5 6 (by norm_num) η s hs.1 hs.2)
    (fun s hs => rationalCuspFamily_analyticAt_nonreal 0 oppositeSource 2 3
      (by norm_num) (by norm_num) s hs.1.ne' hs.2.ne')
    (fun _ _ => analyticAt_const) (fun s _ => ramifiedDenominator_analytic s)
    continuousAt_const (ramifiedDenominator_analytic (4 / 3)).continuousAt
    (cuspIntervalOutgoingFamily_residue_limit 5 6 (by norm_num) η)
    (rationalCuspFamily_residue_limit 0 oppositeSource 2 3 (by norm_num) (by norm_num)) (by
      intro s hs hi
      rw [cuspIntervalOutgoingFamily_unit_initial s hs hi,
        rationalCuspFamily_opposite_all_initial 0 s hs hi, mul_zero,
        arithmeticDirichletSeries_zero_unramified s (by linarith)]
      have hd := ramifiedDenominator_ne_zero s (by linarith)
      rw [show 3 * s - 3 = 3 * (s - 1) by ring] at hd ⊢
      field_simp [hd])
  norm_num at he
  rw [oppositeCuspResidue, ← he, kernelCuspIntervalFourier_zero_residue]
  apply (div_eq_iff (cuspWhittakerHeightFactor_center_ne_zero 0)).mpr
  rw [cuspWhittakerHeightFactor_zero (4 / 3) (by norm_num)]
  dsimp only [η]
  ring

theorem cubicSourceResidualFunction_fourier_zero (v : ℝ) (hv : 0 < v) :
    (∫ z in periodDomain, cubicSourceResidualFunction (upperPoint z v hv)) =
      ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * (3 * (Real.pi : ℂ)) * constantArithmeticResidue *
        (v : ℂ) ^ (2 / 3 : ℂ) := by
  have he := fourCuspAverage_fourier cubicResidualFunction cubicResidualFunction_continuous
    cubicResidualFunction_automorphy v hv 0
  simp_rw [← cubicSourceResidualFunction_four_cusps] at he
  rw [cubicResidualFunction_fourier, cubicResidualFullModeAmplitude, if_pos rfl,
    cubicResidualFunction_opposite_fourier, oppositeCuspResidue_zero] at he
  simp only [rationalCuspPhaseSum, cuspFrequency, map_zero, zero_div, zero_mul, neg_zero,
    AddChar.map_zero_eq_one, mul_one, sourceFourierKernel_zero (4 / 3) (by norm_num)] at he
  convert he using 1
  ring

theorem cubicSourceResidualFunction_ne_zero : cubicSourceResidualFunction ≠ 0 := by
  intro hz
  have he := cubicSourceResidualFunction_fourier_zero 1 (by norm_num)
  simp only [hz, Pi.zero_apply, integral_zero, Complex.ofReal_one, Complex.one_cpow, mul_one] at he
  exact (mul_ne_zero (mul_ne_zero cusp_volume_ne_zero
    (mul_ne_zero (by norm_num) (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero)))
      constantArithmeticResidue_ne_zero) he.symm

theorem kernelRationalSourceProjection_cubicEisensteinResidue_ne_zero :
    kernelRationalSourceProjection cubicEisensteinResidue ≠ 0 := by
  intro hz
  have he := cubicSourceResidualFunction_represents_projection
  rw [hz] at he
  have hae : (fun _ : HyperbolicSpace => (0 : ℂ)) =ᵐ[hyperbolicVolume] cubicSourceResidualFunction := by
    have hzero : (0 : KernelQuotientL2) =ᵐ[integralQuotientVolume globalKubotaKernel]
        (fun _ => (0 : ℂ)) := Lp.coeFn_zero ℂ 2 (integralQuotientVolume globalKubotaKernel)
    have hp := kernelProjection_quasiMeasurePreserving.ae_eq_comp hzero
    filter_upwards [hp, he] with w hw hr
    exact hw.symm.trans hr
  exact cubicSourceResidualFunction_ne_zero
    (Measure.eq_of_ae_eq hae continuous_const cubicSourceResidualFunction_continuous).symm

lemma kernelRationalAction_mul (g h : rationalExtension) (q : KernelQuotient) :
    kernelRationalAction (g * h) q = kernelRationalAction g (kernelRationalAction h q) := by
  induction q using Quotient.inductionOn with
  | _ w =>
    change integralOrbitProjection globalKubotaKernel (integralComplexMatrix ((g : SL(2, O)) * h) • w) =
      integralOrbitProjection globalKubotaKernel (integralComplexMatrix (g : SL(2, O)) •
        (integralComplexMatrix (h : SL(2, O)) • w))
    rw [map_mul, mul_smul]

lemma kernelRationalAction_one (q : KernelQuotient) : kernelRationalAction 1 q = q := by
  induction q using Quotient.inductionOn with
  | _ w =>
    change integralOrbitProjection globalKubotaKernel (integralComplexMatrix (1 : SL(2, O)) • w) = _
    rw [map_one, one_smul]
    rfl

def kernelRationalHomeomorph (g : rationalExtension) : KernelQuotient ≃ₜ KernelQuotient where
  toFun := kernelRationalAction g
  invFun := kernelRationalAction g⁻¹
  left_inv q := by rw [← kernelRationalAction_mul, inv_mul_cancel, kernelRationalAction_one]
  right_inv q := by rw [← kernelRationalAction_mul, mul_inv_cancel, kernelRationalAction_one]
  continuous_toFun := kernelRationalAction_continuous g
  continuous_invFun := kernelRationalAction_continuous g⁻¹

lemma kernelRationalPullback_comp (g h : rationalExtension) (F : KernelQuotientL2) :
    kernelRationalPullback g (kernelRationalPullback h F) = kernelRationalPullback (h * g) F := by
  apply Lp.ext
  have he := (kernelRationalAction_measurePreserving g).quasiMeasurePreserving.ae_eq_comp
    (kernelRationalPullback_ae h F)
  filter_upwards [kernelRationalPullback_ae g (kernelRationalPullback h F), he,
    kernelRationalPullback_ae (h * g) F] with q hleft hmiddle hright
  dsimp only [Function.comp_def] at hmiddle
  rw [hleft, hmiddle, hright, kernelRationalAction_mul]

lemma kernelRationalPullback_one (F : KernelQuotientL2) : kernelRationalPullback 1 F = F := by
  apply Lp.ext
  simpa only [kernelRationalAction_one] using kernelRationalPullback_ae 1 F

open scoped Manifold ContDiff

/-- The linear fractional action is smooth in the upper half-space atlas. -/
lemma hyperbolicAction_contMDiff (g : SL(2, ℂ)) :
    ContMDiff 𝓘(ℝ, SpatialCoordinates) 𝓘(ℝ, SpatialCoordinates) ∞
      (fun w : HyperbolicSpace => g • w) := by
  intro w
  rw [contMDiffAt_iff]
  refine ⟨(continuous_hyperbolic_action g).continuousAt, ?_⟩
  have hp : hyperbolicSpatialCoordinates w ∈ hyperbolicSpatialChart.target :=
    hyperbolicSpatialChart.map_source (Set.mem_univ _)
  have he : (fun p : SpatialCoordinates => hyperbolicSpatialCoordinates
      (g • hyperbolicSpatialChart.symm p)) =ᶠ[𝓝 (hyperbolicSpatialCoordinates w)] mobiusSpatial g := by
    filter_upwards [hyperbolicSpatialChart.open_target.mem_nhds hp] with p hpt
    rw [mobiusSpatial_coordinates_global]
    exact congrArg (mobiusSpatial g) (hyperbolicSpatialChart.right_inv hpt)
  have hd := ((mobiusSpatial_contDiffAt g _ (hyperbolicSpatialCoordinates_positive w)).congr_of_eventuallyEq
    he).contDiffWithinAt (s := Set.univ)
  simpa only [extChartAt_coe, extChartAt_coe_symm, modelWithCornersSelf_coe,
    modelWithCornersSelf_coe_symm, Function.id_comp, Function.comp_id, Set.preimage_id_eq,
    Set.range_id, hyperbolicSpatial_chartAt, hyperbolicSpatialChart_apply, Function.comp_def, id_eq] using hd

/-- Smoothness descends through the covering charts of the cubic quotient. -/
lemma kernel_contMDiff_of_lift (f : KernelQuotient → ℂ)
    (hf : ContMDiff 𝓘(ℝ, SpatialCoordinates) 𝓘(ℝ, ℂ) ∞
      (fun w : HyperbolicSpace => f (integralOrbitProjection globalKubotaKernel w))) :
    ContMDiff 𝓘(ℝ, SpatialCoordinates) 𝓘(ℝ, ℂ) ∞ f := by
  intro q
  have hq : q ∈ (kernelQuotientChart q).source := mem_chart_source SpatialCoordinates q
  have hp : kernelQuotientChart q q ∈ hyperbolicSpatialChart.target :=
    ((kernelQuotientChart q).map_source hq).1
  have hs : ContMDiffOn 𝓘(ℝ, SpatialCoordinates) 𝓘(ℝ, SpatialCoordinates) ∞
      hyperbolicSpatialChart.symm hyperbolicSpatialChart.target := by
    simpa only [hyperbolicSpatial_chartAt] using
      (contMDiffOn_chart_symm (I := 𝓘(ℝ, SpatialCoordinates)) (n := ∞) (x := q.out))
  have hd := (hf (hyperbolicSpatialChart.symm (kernelQuotientChart q q))).comp _
    (hs.contMDiffAt (hyperbolicSpatialChart.open_target.mem_nhds hp))
  have he : (fun p => f ((kernelQuotientChart q).symm p)) =
      (fun p => f (integralOrbitProjection globalKubotaKernel (hyperbolicSpatialChart.symm p))) := by
    funext p
    rw [kernelQuotientChart_symm]
  have hdc : ContDiffAt ℝ ∞ (fun p => f ((kernelQuotientChart q).symm p))
      (kernelQuotientChart q q) := by
    rw [he]
    exact hd.contDiffAt
  have hc : ContinuousAt f q := by
    have hc := hdc.continuousAt.comp ((kernelQuotientChart q).continuousOn.continuousAt
      ((kernelQuotientChart q).open_source.mem_nhds hq))
    apply hc.congr
    filter_upwards [(kernelQuotientChart q).open_source.mem_nhds hq] with r hr
    exact congrArg f ((kernelQuotientChart q).left_inv hr)
  rw [contMDiffAt_iff]
  refine ⟨hc, ?_⟩
  have hh := hdc.contDiffWithinAt (s := Set.univ)
  simpa only [extChartAt_coe, extChartAt_coe_symm, modelWithCornersSelf_coe,
    modelWithCornersSelf_coe_symm, Function.id_comp, Function.comp_id, Set.range_id,
    kernelSpatial_chartAt, chartAt_self_eq, OpenPartialHomeomorph.refl_apply, Function.comp_def, id_eq] using hh

lemma kernelRational_comp_contMDiff (g : rationalExtension) (f : KernelQuotient → ℂ)
    (hf : ContMDiff 𝓘(ℝ, SpatialCoordinates) 𝓘(ℝ, ℂ) ∞ f) :
    ContMDiff 𝓘(ℝ, SpatialCoordinates) 𝓘(ℝ, ℂ) ∞ (fun q => f (kernelRationalAction g q)) := by
  apply kernel_contMDiff_of_lift
  exact (hf.comp kernelProjection_contMDiff).comp (hyperbolicAction_contMDiff (integralComplexMatrix (g : SL(2, O))))

def kernelRationalTest (g : rationalExtension) (f : kernelSmoothTests) : kernelSmoothTests :=
  ⟨fun q => f.1 (kernelRationalAction g q), kernelRational_comp_contMDiff g f.1 f.2.1,
    f.2.2.comp_homeomorph (kernelRationalHomeomorph g)⟩

def kernelRationalTestLinear (g : rationalExtension) : kernelSmoothTests →ₗ[ℂ] kernelSmoothTests where
  toFun := kernelRationalTest g
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

lemma kernelRationalTest_field (g : rationalExtension) (f : kernelSmoothTests) :
    kernelTestField (kernelRationalTest g f) = kernelTestField f ∘ euclideanAction (integralComplexMatrix (g : SL(2, O))) := by
  funext p
  change f.1 (integralOrbitProjection globalKubotaKernel
      (integralComplexMatrix (g : SL(2, O)) • euclideanToHyperbolic p)) =
    f.1 (integralOrbitProjection globalKubotaKernel
      (euclideanToHyperbolic (euclideanAction (integralComplexMatrix (g : SL(2, O))) p)))
  rw [euclideanAction, euclideanToHyperbolic_coordinates]

lemma kernelRationalTest_energyDensity (g : rationalExtension) (f : kernelSmoothTests) (w : HyperbolicSpace) :
    kernelTestEnergyDensity (kernelRationalTest g f) w =
      kernelTestEnergyDensity f (integralComplexMatrix (g : SL(2, O)) • w) := by
  let A := integralComplexMatrix (g : SL(2, O))
  have he : hyperbolicEuclideanCoordinates (A • w) = euclideanAction A (hyperbolicEuclideanCoordinates w) := by
    rw [euclideanAction, euclideanToHyperbolic_coordinates]
  have hr := hyperbolic_cotangent_energy_comp A (fun p : EuclideanSpatial => (kernelTestField f p).re)
    (hyperbolicEuclideanCoordinates w) (hyperbolicHeight_pos w)
    ((kernelTestField_re_contDiffAt f _ (euclideanAction_positive _ _)).differentiableAt (by simp))
  have hi := hyperbolic_cotangent_energy_comp A (fun p : EuclideanSpatial => (kernelTestField f p).im)
    (hyperbolicEuclideanCoordinates w) (hyperbolicHeight_pos w)
    ((kernelTestField_im_contDiffAt f _ (euclideanAction_positive _ _)).differentiableAt (by simp))
  unfold kernelTestEnergyDensity euclideanScalarDirichletDensity
  rw [kernelRationalTest_field, he]
  exact congrArg₂ (fun a b : ℝ => a + b) hr hi

lemma kernelRationalTest_quotientDensity (g : rationalExtension) (f : kernelSmoothTests) (q : KernelQuotient) :
    kernelQuotientEnergyDensity (kernelRationalTest g f) q =
      kernelQuotientEnergyDensity f (kernelRationalAction g q) := by
  induction q using Quotient.inductionOn with
  | _ w => exact kernelRationalTest_energyDensity g f w

lemma kernelRationalTest_energy (g : rationalExtension) (f : kernelSmoothTests) :
    kernelDirichletEnergy (kernelRationalTest g f) = kernelDirichletEnergy f := by
  unfold kernelDirichletEnergy
  simp_rw [kernelRationalTest_quotientDensity]
  exact (kernelRationalAction_measurePreserving g).integral_comp
    (kernelRationalHomeomorph g).measurableEmbedding _

lemma kernelRationalTest_mass (g : rationalExtension) (f : kernelSmoothTests) :
    kernelSmoothTestsToL2 (kernelRationalTest g f) = kernelRationalPullback g (kernelSmoothTestsToL2 f) := by
  apply Lp.ext
  have he := (kernelRationalAction_measurePreserving g).quasiMeasurePreserving.ae_eq_comp
    (kernelSmoothTests_memLp f).coeFn_toLp
  filter_upwards [(kernelSmoothTests_memLp (kernelRationalTest g f)).coeFn_toLp,
    kernelRationalPullback_ae g (kernelSmoothTestsToL2 f), he] with q hnew hpull hbase
  exact hnew.trans (hpull.trans hbase).symm

lemma kernelRationalTest_graph_norm (g : rationalExtension) (f : kernelSmoothTests) :
    ‖kernelEnergyGraphCore (kernelRationalTest g f)‖ = ‖kernelEnergyGraphCore f‖ := by
  apply (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp
  rw [kernelEnergyGraphCore_norm_sq, kernelEnergyGraphCore_norm_sq,
    kernelRationalTest_energy, kernelRationalTest_mass, LinearIsometry.norm_map]

def kernelRationalTestEquiv (g : rationalExtension) : kernelSmoothTests ≃ₗ[ℂ] kernelSmoothTests where
  __ := kernelRationalTestLinear g
  invFun := kernelRationalTest g⁻¹
  left_inv f := by
    apply Subtype.ext
    funext q
    change f.1 (kernelRationalAction g (kernelRationalAction g⁻¹ q)) = f.1 q
    rw [← kernelRationalAction_mul, mul_inv_cancel, kernelRationalAction_one]
  right_inv f := by
    apply Subtype.ext
    funext q
    change f.1 (kernelRationalAction g⁻¹ (kernelRationalAction g q)) = f.1 q
    rw [← kernelRationalAction_mul, inv_mul_cancel, kernelRationalAction_one]

/-- Rational pullback extends isometrically from smooth tests to the completed energy graph. -/
def kernelRationalEnergyPullback (g : rationalExtension) : KernelEnergyGraph ≃ₗᵢ[ℂ] KernelEnergyGraph :=
  (kernelRationalTestEquiv g).extendOfIsometry kernelEnergyGraphCore kernelEnergyGraphCore
    kernelEnergyGraphCore_dense kernelEnergyGraphCore_dense (kernelRationalTest_graph_norm g)

lemma kernelRationalEnergyPullback_core (g : rationalExtension) (f : kernelSmoothTests) :
    kernelRationalEnergyPullback g (kernelEnergyGraphCore f) = kernelEnergyGraphCore (kernelRationalTest g f) :=
  LinearEquiv.extendOfIsometry_eq (kernelRationalTestEquiv g) kernelEnergyGraphCore kernelEnergyGraphCore
    kernelEnergyGraphCore_dense kernelEnergyGraphCore_dense (kernelRationalTest_graph_norm g) f

lemma kernelRationalEnergyPullback_mass (g : rationalExtension) (u : KernelEnergyGraph) :
    kernelEnergyMass (kernelRationalEnergyPullback g u) = kernelRationalPullback g (kernelEnergyMass u) := by
  apply congrFun (kernelEnergyGraphCore_dense.equalizer
    (kernelEnergyMass.continuous.comp (kernelRationalEnergyPullback g).continuous)
    ((kernelRationalPullback g).continuous.comp kernelEnergyMass.continuous) ?_) u
  funext f
  change kernelEnergyMass (kernelRationalEnergyPullback g (kernelEnergyGraphCore f)) =
    kernelRationalPullback g (kernelEnergyMass (kernelEnergyGraphCore f))
  rw [kernelRationalEnergyPullback_core, kernelEnergyMass_core, kernelEnergyMass_core, kernelRationalTest_mass]

theorem kernelRational_variationalSolution (g : rationalExtension) (F : KernelQuotientL2) :
    kernelRationalEnergyPullback g (kernelVariationalSolution F) =
      kernelVariationalSolution (kernelRationalPullback g F) := by
  apply kernelVariationalSolution_unique
  intro v
  obtain ⟨w, rfl⟩ := (kernelRationalEnergyPullback g).surjective v
  rw [← kernelEnergyGraph_inner, LinearIsometryEquiv.inner_map_map,
    kernelRationalEnergyPullback_mass, LinearIsometry.inner_map_map, kernelEnergyGraph_inner]
  exact kernelVariationalSolution_equation F w

theorem kernelRational_variationalResolvent (g : rationalExtension) (F : KernelQuotientL2) :
    kernelVariationalResolvent (kernelRationalPullback g F) =
      kernelRationalPullback g (kernelVariationalResolvent F) := by
  change kernelEnergyMass (kernelVariationalSolution (kernelRationalPullback g F)) =
    kernelRationalPullback g (kernelEnergyMass (kernelVariationalSolution F))
  rw [← kernelRational_variationalSolution, kernelRationalEnergyPullback_mass]

theorem kernelRational_operatorGraph (g : rationalExtension) (F G : KernelQuotientL2)
    (hFG : (F, G) ∈ kernelEnergyLaplacian.graph) :
    (kernelRationalPullback g F, kernelRationalPullback g G) ∈ kernelEnergyLaplacian.graph := by
  rw [kernelEnergyLaplacian_graph, mem_kernelLaplacianGraph] at hFG ⊢
  rw [← map_add, kernelRational_variationalResolvent, hFG]

theorem kernelRational_eigenvector (g : rationalExtension) (F : KernelQuotientL2) (z : ℂ)
    (hF : (F, z • F) ∈ kernelEnergyLaplacian.graph) :
    (kernelRationalPullback g F, z • kernelRationalPullback g F) ∈ kernelEnergyLaplacian.graph := by
  simpa only [map_smul] using kernelRational_operatorGraph g F (z • F) hF

theorem kernelRationalSourceProjection_variationalResolvent (F : KernelQuotientL2) :
    kernelVariationalResolvent (kernelRationalSourceProjection F) =
      kernelRationalSourceProjection (kernelVariationalResolvent F) := by
  simp only [kernelRationalSourceProjection_apply, map_smul, map_sum, kernelRational_variationalResolvent]

theorem kernelRationalSourceProjection_operatorGraph (F G : KernelQuotientL2)
    (hFG : (F, G) ∈ kernelEnergyLaplacian.graph) :
    (kernelRationalSourceProjection F, kernelRationalSourceProjection G) ∈ kernelEnergyLaplacian.graph := by
  rw [kernelEnergyLaplacian_graph, mem_kernelLaplacianGraph] at hFG ⊢
  rw [← map_add, kernelRationalSourceProjection_variationalResolvent, hFG]

/-- The nonzero projected residual vector retains the subcritical eigenvalue `8/9`. -/
theorem kernelRationalSourceProjection_cubicEisensteinResidue_eigenvector :
    (kernelRationalSourceProjection cubicEisensteinResidue,
      (8 / 9 : ℂ) • kernelRationalSourceProjection cubicEisensteinResidue) ∈ kernelEnergyLaplacian.graph := by
  simpa only [map_smul] using kernelRationalSourceProjection_operatorGraph
    cubicEisensteinResidue ((8 / 9 : ℂ) • cubicEisensteinResidue) cubicEisensteinResidue_eigenvector

lemma hilbertProjectionSandwich_symmetric {E G : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    [NormedAddCommGroup G] [InnerProductSpace ℂ G] [CompleteSpace G]
    (A : E →L[ℂ] G) (K : Submodule ℂ E) [K.HasOrthogonalProjection] (x y : G) :
    inner ℂ x (A (K.starProjection (A.adjoint y))) =
      inner ℂ (A (K.starProjection (A.adjoint x))) y := by
  rw [← A.adjoint_inner_left, ← A.adjoint_inner_right]
  exact (K.inner_starProjection_left_eq_right _ _).symm

/-- The mass sandwich of the orthogonal nullspace projection is symmetric. -/
lemma kernelThetaMassProjection_symmetric (F D : KernelQuotientL2) :
    inner ℂ F (kernelThetaMassProjection D) = inner ℂ (kernelThetaMassProjection F) D :=
  hilbertProjectionSandwich_symmetric kernelEnergyMass kernelThetaNull F D

lemma kernelThetaMassProjection_eigenvector (F : KernelQuotientL2)
    (hF : (F, (8 / 9 : ℂ) • F) ∈ kernelEnergyLaplacian.graph) :
    kernelThetaMassProjection F = (9 / 17 : ℂ) • F := by
  let u : kernelEnergyLaplacian.domain := ⟨F, LinearPMap.mem_domain_of_mem_graph hF⟩
  have hu : kernelEnergyLaplacian u = (8 / 9 : ℂ) • F :=
    kernelEnergyLaplacian.mem_graph_snd_inj (kernelEnergyLaplacian.mem_graph u) hF rfl
  let E : KernelEnergyGraph := kernelVariationalSolution (kernelEnergyLaplacian u + u)
  have hE : E ∈ kernelThetaNull := by
    change kernelSpectralFormOperator (8 / 9 : ℂ) E = 0
    dsimp only [E]
    rw [kernelSpectralFormOperator_of_domain, hu]
    change kernelVariationalSolution ((8 / 9 : ℂ) • F - (8 / 9 : ℂ) • F) = 0
    rw [sub_self, map_zero]
  have hmass : kernelEnergyMass E = F := kernelEnergyLaplacian_resolvent_relation u
  have hscale : kernelEnergyMass.adjoint F = (9 / 17 : ℂ) • E := by
    dsimp only [E]
    rw [hu]
    change kernelVariationalSolution F = (9 / 17 : ℂ) • kernelVariationalSolution ((8 / 9 : ℂ) • F + F)
    rw [map_add, map_smul, smul_add, smul_smul]
    module
  change kernelEnergyMass (kernelThetaNull.starProjection (kernelEnergyMass.adjoint F)) = _
  rw [hscale, map_smul, kernelThetaNull.starProjection_eq_self_iff.mpr hE, map_smul, hmass]

theorem kernelEisensteinResidueVector_pairing (a b : ℝ) (ha : 0 < a) (hab : a < b)
    (F : KernelQuotientL2) (hF : (F, (8 / 9 : ℂ) • F) ∈ kernelEnergyLaplacian.graph) :
    inner ℂ F (kernelEisensteinResidueVector a b ha hab) =
      (3 / 2 : ℂ) * inner ℂ F (kernelL2Defect a b ha hab (4 / 3)) := by
  rw [kernelEisensteinResidueVector, inner_smul_right, kernelThetaMassProjection_symmetric,
    kernelThetaMassProjection_eigenvector F hF, inner_smul_left]
  simp only [map_div₀, map_ofNat]
  ring

lemma kernelLocalCorrectedSeed_initial_eq (S : Set KernelQuotient) (hS : IsCompact S)
    (a b c d : ℝ) (ha : 1 < a) (hab : a < b) (hc : 1 < c) (hcd : c < d)
    (s : ℂ) (hs : 4 < s.re) (hi : 0 < s.im) :
    kernelLocalCorrectedSeed S hS a b (by linarith) hab s =
      kernelLocalCorrectedSeed S hS c d (by linarith) hcd s := by
  apply Lp.ext
  filter_upwards [kernelLocalCorrectedSeed_ae_eq S hS a b (by linarith) hab s,
    kernelLocalCorrectedSeed_ae_eq S hS c d (by linarith) hcd s,
    kernelEisensteinL2Correction_initial_overlap a b ha hab s hs hi,
    kernelEisensteinL2Correction_initial_overlap c d hc hcd s hs hi] with q h1 h2 h3 h4
  rw [h1, h2]
  by_cases hq : q ∈ S
  · simp only [Set.indicator_of_mem hq, kernelCorrectedSeed, h3, h4]
    ring
  · simp only [Set.indicator_of_notMem hq]

lemma kernelLocalCorrectedSeed_cutoff_eq (S : Set KernelQuotient) (hS : IsCompact S)
    (a b c d : ℝ) (ha : 1 < a) (hab : a < b) (hc : 1 < c) (hcd : c < d) :
    Set.EqOn (kernelLocalCorrectedSeed S hS a b (by linarith) hab)
      (kernelLocalCorrectedSeed S hS c d (by linarith) hcd) cuspUpperParameterRegion := by
  have h1 : AnalyticOnNhd ℂ (kernelLocalCorrectedSeed S hS a b (by linarith) hab) cuspUpperParameterRegion :=
    fun s hs => kernelLocalCorrectedSeed_analyticAt_nonreal S hS a b (by linarith) hab s
      (by linarith [hs.1]) hs.2.ne'
  have h2 : AnalyticOnNhd ℂ (kernelLocalCorrectedSeed S hS c d (by linarith) hcd) cuspUpperParameterRegion :=
    fun s hs => kernelLocalCorrectedSeed_analyticAt_nonreal S hS c d (by linarith) hcd s
      (by linarith [hs.1]) hs.2.ne'
  have hopen : IsOpen {s : ℂ | 4 < s.re ∧ 0 < s.im} :=
    (isOpen_lt continuous_const Complex.continuous_re).inter (isOpen_lt continuous_const Complex.continuous_im)
  apply h1.eqOn_of_preconnected_of_eventuallyEq h2 cuspUpperParameterRegion_convex.isPreconnected
    (by norm_num [cuspUpperParameterRegion] : (5 + Complex.I : ℂ) ∈ cuspUpperParameterRegion)
  filter_upwards [hopen.mem_nhds (by norm_num)] with s hs
  exact kernelLocalCorrectedSeed_initial_eq S hS a b c d ha hab hc hcd s hs.1 hs.2

lemma kernelEisensteinResidueVector_restrict_cutoff_eq (S : Set KernelQuotient) (hS : IsCompact S)
    (a b c d : ℝ) (ha : 1 < a) (hab : a < b) (hc : 1 < c) (hcd : c < d) :
    kernelMassRestrictionCLM S hS.measurableSet (kernelEisensteinResidueVector a b (by linarith) hab) =
      kernelMassRestrictionCLM S hS.measurableSet (kernelEisensteinResidueVector c d (by linarith) hcd) := by
  have h1 := (kernelLocalCorrectedSeed_residue_limit S hS a b (by linarith) hab).comp
    thetaApproach_tendsto_complex_punctured
  have h2 := (kernelLocalCorrectedSeed_residue_limit S hS c d (by linarith) hcd).comp
    thetaApproach_tendsto_complex_punctured
  apply tendsto_nhds_unique_of_eventuallyEq h1 h2
  filter_upwards [self_mem_nhdsWithin] with t ht
  change 0 < t at ht
  have hs : (4 / 3 : ℂ) + (t : ℂ) + (t : ℂ) * Complex.I ∈ cuspUpperParameterRegion := by
    constructor
    · norm_num
      linarith
    · simpa using ht
  exact congrArg (fun u : KernelQuotientL2 =>
    ((4 / 3 : ℂ) + (t : ℂ) + (t : ℂ) * Complex.I - 4 / 3) • u)
    (kernelLocalCorrectedSeed_cutoff_eq S hS a b c d ha hab hc hcd hs)

lemma kernelL2_eq_of_compact_restrictions (F G : KernelQuotientL2)
    (h : ∀ S : Set KernelQuotient, ∀ hS : IsCompact S,
      kernelMassRestrictionCLM S hS.measurableSet F = kernelMassRestrictionCLM S hS.measurableSet G) : F = G := by
  let S : ℕ → Set KernelQuotient := fun n => {q | kernelQuotientBarrier 2 3 q ≤ n}
  have hS (n : ℕ) : IsCompact (S n) := kernelBarrier_sublevel_isCompact n
  have he (n : ℕ) : ∀ᵐ q ∂integralQuotientVolume globalKubotaKernel, q ∈ S n → F q = G q := by
    have hi := h (S n) (hS n)
    filter_upwards [kernelMassRestriction_coe (S n) (hS n).measurableSet F,
      kernelMassRestriction_coe (S n) (hS n).measurableSet G] with q hf hg hq
    rw [Set.indicator_of_mem hq] at hf hg
    change kernelMassRestrictionCLM (S n) (hS n).measurableSet F q = F q at hf
    change kernelMassRestrictionCLM (S n) (hS n).measurableSet G q = G q at hg
    rw [hi] at hf
    exact hf.symm.trans hg
  apply Lp.ext
  filter_upwards [ae_all_iff.mpr he] with q hq
  obtain ⟨n, hn⟩ := exists_nat_ge (kernelQuotientBarrier 2 3 q)
  exact hq n hn

/-- Moving the incoming cutoff does not change the actual residual vector. -/
theorem kernelEisensteinResidueVector_cutoff_independent
    (a b c d : ℝ) (ha : 1 < a) (hab : a < b) (hc : 1 < c) (hcd : c < d) :
    kernelEisensteinResidueVector a b (by linarith) hab = kernelEisensteinResidueVector c d (by linarith) hcd :=
  kernelL2_eq_of_compact_restrictions _ _ (fun S hS =>
    kernelEisensteinResidueVector_restrict_cutoff_eq S hS a b c d ha hab hc hcd)

lemma cuspTransition_dilate (A : ℝ) (hA : A ≠ 0) :
    cuspTransition A (2 * A) = fun v => cuspTransition 1 2 (v / A) := by
  funext v
  unfold cuspTransition
  congr 1
  field_simp

lemma cuspTransition_dilate_deriv (A v : ℝ) (hA : A ≠ 0) :
    deriv (cuspTransition A (2 * A)) v = deriv (cuspTransition 1 2) (v / A) / A := by
  rw [cuspTransition_dilate A hA]
  have hd := (((cuspTransition_contDiff 1 2).differentiable (by simp) (v / A)).hasDerivAt).comp v
    ((hasDerivAt_id v).div_const A)
  simpa only [Function.comp_def, id_eq, one_div, div_eq_mul_inv, one_mul] using hd.deriv

lemma cuspTransition_dilate_second (A v : ℝ) (hA : A ≠ 0) :
    deriv (deriv (cuspTransition A (2 * A))) v = deriv (deriv (cuspTransition 1 2)) (v / A) / A ^ 2 := by
  have he : deriv (cuspTransition A (2 * A)) = fun x => deriv (cuspTransition 1 2) (x / A) / A :=
    funext (fun x => cuspTransition_dilate_deriv A x hA)
  rw [he]
  have hc := (contDiff_infty_iff_deriv.mp (cuspTransition_contDiff 1 2)).2
  have hd := (((hc.differentiable (by simp) (v / A)).hasDerivAt).comp v
    ((hasDerivAt_id v).div_const A)).div_const A
  simp only [Function.comp_def, id_eq] at hd
  convert hd.deriv using 1
  field_simp

def cuspBaseDefectFactor (s : ℂ) (x : ℝ) : ℂ :=
  (x : ℂ) ^ 2 * (deriv (deriv (cuspTransition 1 2)) x : ℝ) +
    (2 * s - 1) * (x : ℂ) * (deriv (cuspTransition 1 2) x : ℝ)

lemma cuspBaseDefectFactor_continuous (s : ℂ) : Continuous (cuspBaseDefectFactor s) := by
  have h1 := (contDiff_infty_iff_deriv.mp (cuspTransition_contDiff 1 2)).2
  have h2 := (contDiff_infty_iff_deriv.mp h1).2
  exact ((Complex.continuous_ofReal.pow 2).mul (Complex.continuous_ofReal.comp h2.continuous)).add
    ((continuous_const.mul Complex.continuous_ofReal).mul (Complex.continuous_ofReal.comp h1.continuous))

lemma cuspBaseDefectFactor_compact (s : ℂ) : HasCompactSupport (cuspBaseDefectFactor s) := by
  apply HasCompactSupport.of_support_subset_isCompact (isCompact_Icc : IsCompact (Set.Icc (1 : ℝ) 2))
  intro x hx
  by_contra hn
  have hout : x < 1 ∨ 2 < x := by simpa only [Set.mem_Icc, not_and_or, not_le] using hn
  obtain ⟨h1, h2⟩ := cuspTransition_derivatives 1 2 x (by norm_num) hout
  exact hx (by simp only [cuspBaseDefectFactor, h1, h2, Complex.ofReal_zero, mul_zero, add_zero])

lemma cuspSeedDefectProfile_dilate (A v : ℝ) (hA : A ≠ 0) (s : ℂ) :
    cuspSeedDefectProfile A (2 * A) s v = positiveHeightPower s v * cuspBaseDefectFactor s (v / A) := by
  rw [cuspSeedDefectProfile, cuspTransition_dilate_deriv A v hA, cuspTransition_dilate_second A v hA]
  unfold cuspBaseDefectFactor
  push_cast
  field_simp

/-- Dilating the transition interval gives a quadratic uniform bound on its defect. -/
theorem cuspSeedDefectProfile_dilate_bound :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ A : ℝ, 1 ≤ A → ∀ v : ℝ,
      ‖cuspSeedDefectProfile A (2 * A) (4 / 3) v‖ ≤ C * A ^ 2 := by
  obtain ⟨B, hB⟩ := (cuspBaseDefectFactor_compact (4 / 3)).exists_bound_of_continuous
    (cuspBaseDefectFactor_continuous (4 / 3))
  let C := max B 0
  have hC : 0 ≤ C := le_max_right _ _
  have hbound (x : ℝ) : ‖cuspBaseDefectFactor (4 / 3) x‖ ≤ C := (hB x).trans (le_max_left _ _)
  refine ⟨4 * C, by positivity, fun A hA v => ?_⟩
  have hApos : 0 < A := zero_lt_one.trans_le hA
  by_cases hv : v ∈ Set.Icc A (2 * A)
  · have hv1 : 1 ≤ v := hA.trans hv.1
    have hvpos : 0 < v := hApos.trans_le hv.1
    have hp : ‖positiveHeightPower (4 / 3) v‖ ≤ v ^ 2 := by
      rw [positiveHeightPower_eq_cpow _ _ hvpos, Complex.norm_cpow_eq_rpow_re_of_pos hvpos]
      norm_num
      simpa using Real.rpow_le_rpow_of_exponent_le hv1 (show (4 / 3 : ℝ) ≤ 2 by norm_num)
    rw [cuspSeedDefectProfile_dilate A v hApos.ne', norm_mul]
    calc
      _ ≤ v ^ 2 * C := mul_le_mul hp (hbound (v / A)) (norm_nonneg _) (sq_nonneg v)
      _ ≤ (2 * A) ^ 2 * C := mul_le_mul_of_nonneg_right
        ((sq_le_sq₀ hvpos.le (by positivity)).mpr hv.2) hC
      _ = (4 * C) * A ^ 2 := by ring
  · have hout : v < A ∨ 2 * A < v := by simpa only [Set.mem_Icc, not_and_or, not_le] using hv
    rw [cuspSeedDefectProfile_zero A (2 * A) (4 / 3) v (by linarith) hout, norm_zero]
    positivity

theorem smoothCuspSeedDefect_dilate_bound :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ A : ℝ, 1 ≤ A → ∀ w : HyperbolicSpace,
      ‖smoothCuspSeedDefect A (2 * A) (4 / 3) w‖ ≤ C * A ^ 2 := by
  obtain ⟨C, hC, hbound⟩ := cuspSeedDefectProfile_dilate_bound
  exact ⟨C, hC, fun A hA w => cuspCutoffCorrection_norm_le _ _ (by positivity) (hbound A hA) w⟩

lemma movingDefect_product_bound (f : KernelQuotient → ℂ) (K C : ℝ) (hK : 0 ≤ K) (hC : 0 ≤ C)
    (hdec : ∀ w : HyperbolicSpace, ∀ r : CuspCosets, 1 < cosetHeight r w →
      ‖f (integralOrbitProjection globalKubotaKernel w)‖ ≤ K / (cosetHeight r w) ^ 3)
    (hbound : ∀ A : ℝ, 1 ≤ A → ∀ w : HyperbolicSpace,
      ‖smoothCuspSeedDefect A (2 * A) (4 / 3) w‖ ≤ C * A ^ 2)
    (A : ℝ) (hA : 1 < A) (q : KernelQuotient) :
    ‖f q‖ * ‖kernelQuotientDefect A (2 * A) (4 / 3) q‖ ≤ K * C / A := by
  induction q using Quotient.inductionOn with
  | _ w =>
    change ‖f (integralOrbitProjection globalKubotaKernel w)‖ *
      ‖smoothCuspSeedDefect A (2 * A) (4 / 3) w‖ ≤ _
    have hApos : 0 < A := zero_lt_one.trans hA
    by_cases hz : smoothCuspSeedDefect A (2 * A) (4 / 3) w = 0
    · rw [hz, norm_zero, mul_zero]
      positivity
    obtain ⟨r, hr, _⟩ := smoothCuspSeedDefect_support A (2 * A) (4 / 3) (by linarith) w hz
    have hf : ‖f (integralOrbitProjection globalKubotaKernel w)‖ ≤ K / A ^ 3 :=
      (hdec w r (hA.trans_le hr)).trans (div_le_div_of_nonneg_left hK (pow_pos hApos 3)
        (pow_le_pow_left₀ hApos.le hr 3))
    calc
      _ ≤ (K / A ^ 3) * (C * A ^ 2) := mul_le_mul hf (hbound A hA.le w) (norm_nonneg _) (by positivity)
      _ = K * C / A := by field_simp

lemma movingDefect_inner_bound (F : KernelQuotientL2) (f : KernelQuotient → ℂ)
    (hrep : F =ᵐ[integralQuotientVolume globalKubotaKernel] f)
    (K C : ℝ) (hK : 0 ≤ K) (hC : 0 ≤ C)
    (hdec : ∀ w : HyperbolicSpace, ∀ r : CuspCosets, 1 < cosetHeight r w →
      ‖f (integralOrbitProjection globalKubotaKernel w)‖ ≤ K / (cosetHeight r w) ^ 3)
    (hbound : ∀ A : ℝ, 1 ≤ A → ∀ w : HyperbolicSpace,
      ‖smoothCuspSeedDefect A (2 * A) (4 / 3) w‖ ≤ C * A ^ 2)
    (A : ℝ) (hA : 1 < A) :
    ‖inner ℂ F (kernelL2Defect A (2 * A) (by linarith) (by linarith) (4 / 3))‖ ≤
      (K * C / A) * (integralQuotientVolume globalKubotaKernel).real Set.univ := by
  rw [L2.inner_def]
  apply norm_integral_le_of_norm_le_const
  filter_upwards [hrep, kernelL2Defect_ae_eq A (2 * A) (by linarith) (by linarith) (4 / 3)] with q hf hd
  rw [hf, hd, RCLike.inner_apply, norm_mul]
  simpa only [starRingEnd_apply, norm_star, mul_comm] using
    movingDefect_product_bound f K C hK hC hdec hbound A hA q

/-- A moving cutoff makes the residual pairing of a rapidly decaying eigenvector tend to zero. -/
theorem cubicEisensteinResidue_orthogonal_of_rapid_cusp_decay
    (F : KernelQuotientL2) (hF : (F, (8 / 9 : ℂ) • F) ∈ kernelEnergyLaplacian.graph)
    (f : KernelQuotient → ℂ) (hrep : F =ᵐ[integralQuotientVolume globalKubotaKernel] f)
    (K : ℝ) (hK : 0 ≤ K)
    (hdec : ∀ w : HyperbolicSpace, ∀ r : CuspCosets, 1 < cosetHeight r w →
      ‖f (integralOrbitProjection globalKubotaKernel w)‖ ≤ K / (cosetHeight r w) ^ 3) :
    inner ℂ F cubicEisensteinResidue = 0 := by
  obtain ⟨C, hC, hbound⟩ := smoothCuspSeedDefect_dilate_bound
  let B : ℝ := (3 / 2) * (K * C) * (integralQuotientVolume globalKubotaKernel).real Set.univ
  have hB : 0 ≤ B := by dsimp only [B]; positivity
  have hb (A : ℝ) (hA : 1 < A) : ‖inner ℂ F cubicEisensteinResidue‖ ≤ B / A := by
    have he : cubicEisensteinResidue = kernelEisensteinResidueVector A (2 * A) (by linarith) (by linarith) :=
      kernelEisensteinResidueVector_cutoff_independent 2 3 A (2 * A)
        (by norm_num) (by norm_num) hA (by linarith)
    rw [he, kernelEisensteinResidueVector_pairing _ _ _ _ F hF, norm_mul]
    norm_num
    calc
      _ ≤ (3 / 2) * ((K * C / A) * (integralQuotientVolume globalKubotaKernel).real Set.univ) :=
        mul_le_mul_of_nonneg_left (movingDefect_inner_bound F f hrep K C hK hC hdec hbound A hA) (by norm_num)
      _ = B / A := by dsimp only [B]; ring
  apply norm_eq_zero.mp
  by_contra hn
  have hnpos := lt_of_le_of_ne (norm_nonneg (inner ℂ F cubicEisensteinResidue)) (Ne.symm hn)
  let A := B / ‖inner ℂ F cubicEisensteinResidue‖ + 2
  have hA : 1 < A := by
    have hh := div_nonneg hB hnpos.le
    dsimp only [A]
    linarith
  have hh := (le_div_iff₀ (zero_lt_one.trans hA)).mp (hb A hA)
  have he : ‖inner ℂ F cubicEisensteinResidue‖ * A = B + 2 * ‖inner ℂ F cubicEisensteinResidue‖ := by
    dsimp only [A]
    field_simp
  rw [he] at hh
  linarith only [hh, hnpos]

lemma coset_decay_of_cusp_chart_decay (f : KernelQuotient → ℂ) (K : ℝ)
    (hdec : ∀ M : levelThree, ∀ z : ℂ, ∀ v : ℝ, ∀ hv : 0 < v, 1 < v →
      ‖f (integralOrbitProjection globalKubotaKernel (complexMatrix M • upperPoint z v hv))‖ ≤ K / v ^ 3) :
    ∀ w : HyperbolicSpace, ∀ r : CuspCosets, 1 < cosetHeight r w →
      ‖f (integralOrbitProjection globalKubotaKernel w)‖ ≤ K / (cosetHeight r w) ^ 3 := by
  intro w r
  induction r using Quotient.inductionOn with
  | _ M =>
    intro hr
    change 1 < cosetHeight (cosetOf M) w at hr
    change _ ≤ K / (cosetHeight (cosetOf M) w) ^ 3
    rw [cosetHeight_cosetOf] at hr ⊢
    obtain ⟨z, v, hv, hpt⟩ := upperPoint_surjective (complexMatrix M • w)
    have hh : hyperbolicHeight (complexMatrix M • w) = v := by rw [← hpt, hyperbolicHeight_upperPoint]
    rw [hh] at hr ⊢
    have he : complexMatrix M⁻¹ • upperPoint z v hv = w := by rw [hpt, map_inv, inv_smul_smul]
    simpa only [he] using hdec M⁻¹ z v hv hr

theorem cubicEisensteinResidue_orthogonal_of_cusp_chart_decay
    (F : KernelQuotientL2) (hF : (F, (8 / 9 : ℂ) • F) ∈ kernelEnergyLaplacian.graph)
    (f : KernelQuotient → ℂ) (hrep : F =ᵐ[integralQuotientVolume globalKubotaKernel] f)
    (K : ℝ) (hK : 0 ≤ K)
    (hdec : ∀ M : levelThree, ∀ z : ℂ, ∀ v : ℝ, ∀ hv : 0 < v, 1 < v →
      ‖f (integralOrbitProjection globalKubotaKernel (complexMatrix M • upperPoint z v hv))‖ ≤ K / v ^ 3) :
    inner ℂ F cubicEisensteinResidue = 0 :=
  cubicEisensteinResidue_orthogonal_of_rapid_cusp_decay F hF f hrep K hK
    (coset_decay_of_cusp_chart_decay f K hdec)

lemma kernelRationalPullback_pairing_inverse (g : rationalExtension) (F G : KernelQuotientL2) :
    inner ℂ F (kernelRationalPullback g G) = inner ℂ (kernelRationalPullback g⁻¹ F) G := by
  calc
    _ = inner ℂ (kernelRationalPullback g (kernelRationalPullback g⁻¹ F)) (kernelRationalPullback g G) := by
      rw [kernelRationalPullback_comp, inv_mul_cancel, kernelRationalPullback_one]
    _ = _ := LinearIsometry.inner_map_map _ _ _

lemma cubicEisensteinResidue_rational_translate_orthogonal
    (F : KernelQuotientL2) (hF : (F, (8 / 9 : ℂ) • F) ∈ kernelEnergyLaplacian.graph)
    (f : KernelQuotient → ℂ) (hrep : F =ᵐ[integralQuotientVolume globalKubotaKernel] f)
    (C : ℝ) (hC : 0 ≤ C)
    (hdec : ∀ N : SL(2, O), ∀ z : ℂ, ∀ v : ℝ, ∀ hv : 0 < v, 1 < v →
      ‖f (integralOrbitProjection globalKubotaKernel (integralComplexMatrix N • upperPoint z v hv))‖ ≤ C / v ^ 3)
    (g : rationalExtension) : inner ℂ F (kernelRationalPullback g cubicEisensteinResidue) = 0 := by
  rw [kernelRationalPullback_pairing_inverse]
  have hrepG : kernelRationalPullback g⁻¹ F =ᵐ[integralQuotientVolume globalKubotaKernel]
      fun q => f (kernelRationalAction g⁻¹ q) :=
    (kernelRationalPullback_ae g⁻¹ F).trans
      ((kernelRationalAction_measurePreserving g⁻¹).quasiMeasurePreserving.ae_eq_comp hrep)
  apply cubicEisensteinResidue_orthogonal_of_cusp_chart_decay _
    (kernelRational_eigenvector g⁻¹ F (8 / 9) hF) _ hrepG C hC
  intro N z v hv hlarge
  rw [kernelRationalAction_mk]
  have hh := hdec ((g⁻¹ : rationalExtension) * (N : SL(2, O))) z v hv hlarge
  simpa only [map_mul, mul_smul, integralComplexMatrix_levelThree] using hh

theorem cubicSourceResidue_orthogonal_of_integral_cusp_decay
    (F : KernelQuotientL2) (hF : (F, (8 / 9 : ℂ) • F) ∈ kernelEnergyLaplacian.graph)
    (f : KernelQuotient → ℂ) (hrep : F =ᵐ[integralQuotientVolume globalKubotaKernel] f)
    (C : ℝ) (hC : 0 ≤ C)
    (hdec : ∀ N : SL(2, O), ∀ z : ℂ, ∀ v : ℝ, ∀ hv : 0 < v, 1 < v →
      ‖f (integralOrbitProjection globalKubotaKernel (integralComplexMatrix N • upperPoint z v hv))‖ ≤ C / v ^ 3) :
    inner ℂ F (kernelRationalSourceProjection cubicEisensteinResidue) = 0 := by
  rw [kernelRationalSourceProjection_apply, inner_smul_right, inner_sum]
  simp only [cubicEisensteinResidue_rational_translate_orthogonal F hF f hrep C hC hdec,
    Finset.sum_const_zero, mul_zero]

/-- Adjoint orthogonality forces a finite correspondence combination of the source residue to vanish. -/
theorem commonCover_source_span_vanish {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [CompleteSpace E] {ι : Type*} [Fintype ι]
    (leg : ι → KernelQuotientL2 →L[ℂ] E) (c : ι → ℂ) (D : E)
    (hD : D = ∑ i, c i • leg i (kernelRationalSourceProjection cubicEisensteinResidue))
    (hEig : ∀ i, (ContinuousLinearMap.adjoint (leg i) D,
      (8 / 9 : ℂ) • ContinuousLinearMap.adjoint (leg i) D) ∈ kernelEnergyLaplacian.graph)
    (f : ι → KernelQuotient → ℂ)
    (hrep : ∀ i, ContinuousLinearMap.adjoint (leg i) D =ᵐ[integralQuotientVolume globalKubotaKernel] f i)
    (C : ι → ℝ) (hC : ∀ i, 0 ≤ C i)
    (hdec : ∀ i, ∀ N : SL(2, O), ∀ z : ℂ, ∀ v : ℝ, ∀ hv : 0 < v, 1 < v →
      ‖f i (integralOrbitProjection globalKubotaKernel (integralComplexMatrix N • upperPoint z v hv))‖ ≤ C i / v ^ 3) :
    D = 0 := by
  apply (inner_self_eq_zero (𝕜 := ℂ)).mp
  calc
    inner ℂ D D = inner ℂ D (∑ i, c i • leg i (kernelRationalSourceProjection cubicEisensteinResidue)) :=
      congrArg (inner ℂ D) hD
    _ = ∑ i, c i * inner ℂ D (leg i (kernelRationalSourceProjection cubicEisensteinResidue)) := by
      simp only [inner_sum, inner_smul_right]
    _ = 0 := by
      apply Finset.sum_eq_zero
      intro i _
      rw [← ContinuousLinearMap.adjoint_inner_left,
        cubicSourceResidue_orthogonal_of_integral_cusp_decay _ (hEig i) (f i) (hrep i) (C i) (hC i) (hdec i), mul_zero]

/-- Arithmetic residue of the projected source, normalized by the period area. -/
def rationalSourceScatteringResidue (h : O) : ℂ :=
  if h = 0 then constantArithmeticResidue else
    (4 : ℂ)⁻¹ * (nonzeroScatteringResidue h + rationalCuspPhaseSum h *
      oppositeCuspResidue h / ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ))

lemma rationalSourceResidualFourierCoefficient_eq (h : O) (hh : h ≠ 0) :
    rationalSourceResidualFourierCoefficient h = rationalSourceScatteringResidue h *
      ((2 * Real.pi : ℂ) / Complex.Gamma (4 / 3) * (2 * Real.pi * ‖cuspFrequency h‖ : ℂ) ^ (1 / 3 : ℂ)) := by
  rw [rationalSourceResidualFourierCoefficient, cubicResidualFourierCoefficient,
    oppositeResidualFourierCoefficient, rationalSourceScatteringResidue, if_neg hh]
  ring

lemma residue_whittaker_bessel (R : ℂ) (v : ℝ) (hv : 0 < v) (h : O) (hh : h ≠ 0) :
    R * ((v : ℂ) ^ (2 / 3 : ℂ) * sourceFourierKernel (4 / 3) (cuspFrequency h * v)) =
      (R * ((2 * Real.pi : ℂ) / Complex.Gamma (4 / 3) *
        (2 * Real.pi * ‖cuspFrequency h‖ : ℂ) ^ (1 / 3 : ℂ))) * (v : ℂ) *
        schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) := by
  have hv0 : (v : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hv.ne'
  have hp : (v : ℂ) ^ (-(4 / 3 : ℂ) - 1) * (v : ℂ) ^ 3 = (v : ℂ) ^ (2 / 3 : ℂ) := by
    rw [← Complex.cpow_natCast, ← Complex.cpow_add _ _ hv0]
    congr 1
    norm_num
  calc
    _ = R * (((v : ℂ) ^ (-(4 / 3 : ℂ) - 1) *
        sourceFourierKernel (4 / 3) (cuspFrequency h * v)) * (v : ℂ) ^ 3) := by rw [← hp]; ring
    _ = _ := by
      rw [sourceFourierKernel_residual_height h hh v hv]
      field_simp [hv0]

theorem cubicSourceResidualFunction_fourier (v : ℝ) (hv : 0 < v) (h : O) :
    (∫ z in periodDomain, cubicSourceResidualFunction (upperPoint z v hv) * tracePhase (-cuspFrequency h * z)) =
      ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * rationalSourceScatteringResidue h *
        ((v : ℂ) ^ (2 / 3 : ℂ) * sourceFourierKernel (4 / 3) (cuspFrequency h * v)) := by
  by_cases hh : h = 0
  · subst h
    simp only [cuspFrequency, map_zero, zero_div, neg_zero, zero_mul, AddChar.map_zero_eq_one, mul_one,
      rationalSourceScatteringResidue, if_true, sourceFourierKernel_zero (4 / 3) (by norm_num)]
    rw [cubicSourceResidualFunction_fourier_zero]
    ring
  · rw [cubicSourceResidualFunction_fourier_bessel v hv h hh,
      rationalSourceResidualFourierCoefficient_eq h hh]
    have he := residue_whittaker_bessel (rationalSourceScatteringResidue h) v hv h hh
    linear_combination -((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * he

theorem rationalSourceScatteringResidue_prime_recurrence (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hph : ¬ p ∣ h) :
    rationalSourceScatteringResidue (h * p ^ 3) =
      (1 + (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹) * rationalSourceScatteringResidue h -
      (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-(4 / 3 : ℂ)) * cubicUnitGaussSum (9 * h) p *
        rationalSourceScatteringResidue (h * p) := by
  have hh : h ≠ 0 := fun hz => hph (hz ▸ dvd_zero p)
  have hg := unramifiedGaussResidue_prime_recurrence p hp hprimary (9 * h)
    (primary_prime_not_dvd_nine_frequency p hp hprimary h hph)
  rw [primeCubicGauss_one_eq] at hg
  simp only [rationalSourceScatteringResidue, if_neg hh, if_neg (mul_ne_zero hh hp.ne_zero),
    if_neg (mul_ne_zero hh (pow_ne_zero 3 hp.ne_zero)), oppositeCuspResidue_eq_unramified]
  rw [rationalCuspPhaseSum_primary_mul h (p ^ 3) (primary_pow_congruence p hprimary 3),
    rationalCuspPhaseSum_primary_mul h p hprimary, nonzeroScatteringResidue_prime_recurrence p hp hprimary h hph,
    show 9 * (h * p ^ 3) = (9 * h) * p ^ 3 by ring, hg,
    show 9 * (h * p) = (9 * h) * p by ring]
  ring

theorem rationalSourceScatteringResidue_cube_recurrence (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) :
    rationalSourceScatteringResidue (h * p ^ 6) =
      (1 + (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹) * rationalSourceScatteringResidue (h * p ^ 3) -
      (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ * rationalSourceScatteringResidue h := by
  by_cases hh : h = 0
  · subst h
    simp only [zero_mul]
    ring
  simp only [rationalSourceScatteringResidue, if_neg hh,
    if_neg (mul_ne_zero hh (pow_ne_zero 3 hp.ne_zero)),
    if_neg (mul_ne_zero hh (pow_ne_zero 6 hp.ne_zero)), oppositeCuspResidue_eq_unramified]
  rw [rationalCuspPhaseSum_primary_mul h (p ^ 6) (primary_pow_congruence p hprimary 6),
    rationalCuspPhaseSum_primary_mul h (p ^ 3) (primary_pow_congruence p hprimary 3),
    nonzeroScatteringResidue_cube_recurrence p hp hprimary h hh,
    show 9 * (h * p ^ 6) = (9 * h) * p ^ 6 by ring,
    show 9 * (h * p ^ 3) = (9 * h) * p ^ 3 by ring,
    unramifiedGaussResidue_cube_recurrence p hp hprimary (9 * h)]
  ring

theorem rationalSourceScatteringResidue_square_cube (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hph : ¬ p ∣ h) :
    rationalSourceScatteringResidue (h * p ^ 5) =
      (1 + (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹) * rationalSourceScatteringResidue (h * p ^ 2) := by
  have hh : h ≠ 0 := fun hz => hph (hz ▸ dvd_zero p)
  simp only [rationalSourceScatteringResidue,
    if_neg (mul_ne_zero hh (pow_ne_zero 2 hp.ne_zero)),
    if_neg (mul_ne_zero hh (pow_ne_zero 5 hp.ne_zero)), oppositeCuspResidue_eq_unramified]
  rw [rationalCuspPhaseSum_primary_mul h (p ^ 5) (primary_pow_congruence p hprimary 5),
    rationalCuspPhaseSum_primary_mul h (p ^ 2) (primary_pow_congruence p hprimary 2),
    nonzeroScatteringResidue_square_cube p hp hprimary h hph,
    show 9 * (h * p ^ 5) = (9 * h) * p ^ 5 by ring,
    show 9 * (h * p ^ 2) = (9 * h) * p ^ 2 by ring,
    unramifiedGaussResidue_square_cube p hp hprimary (9 * h)
      (primary_prime_not_dvd_nine_frequency p hp hprimary h hph)]
  ring

/-- An absolutely convergent Fourier series on the Eisenstein period lattice. -/
def cuspCharacterSeries (a : O → ℂ) (z : ℂ) : ℂ :=
  ∑' h : O, a h * tracePhase (cuspFrequency h * z)

lemma cuspCharacterSeries_continuous (a : O → ℂ) (ha : Summable (fun h => ‖a h‖)) :
    Continuous (cuspCharacterSeries a) := by
  apply continuous_tsum (u := fun h => ‖a h‖) _ ha
  · intro h z
    simp only [norm_mul, tracePhase_norm, mul_one, le_refl]
  · intro h
    change Continuous (fun z : ℂ => a h * Complex.exp (2 * Real.pi * Complex.I *
      ((cuspFrequency h * z) + starRingEnd ℂ (cuspFrequency h * z))))
    fun_prop

lemma cuspCharacterSeries_period (a : O → ℂ) (z : ℂ) (n : O) :
    cuspCharacterSeries a (z + 3 * ringComplex n) = cuspCharacterSeries a z := by
  apply tsum_congr
  intro h
  rw [mul_add, AddChar.map_add_eq_mul, cuspFrequency_period, mul_one]

theorem cuspCharacterSeries_fourier (a : O → ℂ) (ha : Summable (fun h => ‖a h‖)) (k : O) :
    (∫ z in periodDomain, cuspCharacterSeries a z * tracePhase (-cuspFrequency k * z)) =
      ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * a k := by
  letI : Countable O := Coordinates.coordinateEquiv.injective.countable
  letI : IsFiniteMeasure (volume.restrict periodDomain) := isFiniteMeasure_restrict.mpr (by
    rw [periodDomain_volume]
    exact ENNReal.ofReal_ne_top)
  let f : O → ℂ → ℂ := fun h z => a h *
    tracePhase (cuspFrequency h * z) * tracePhase (-cuspFrequency k * z)
  have hc (h : O) : Continuous (f h) := by
    change Continuous (fun z : ℂ => a h *
      Complex.exp (2 * Real.pi * Complex.I * ((cuspFrequency h * z) + starRingEnd ℂ (cuspFrequency h * z))) *
      Complex.exp (2 * Real.pi * Complex.I * ((-cuspFrequency k * z) + starRingEnd ℂ (-cuspFrequency k * z))))
    fun_prop
  have hn (h : O) (z : ℂ) : ‖f h z‖ = ‖a h‖ := by
    simp only [f, norm_mul, tracePhase_norm, mul_one]
  have hi (h : O) : IntegrableOn (f h) periodDomain :=
    periodDomain_continuous_integrable _ (hc h)
  have hs : Summable (fun h : O => ∫ z in periodDomain, ‖f h z‖) := by
    simp only [hn, setIntegral_const, smul_eq_mul]
    exact ha.mul_left (volume.real periodDomain)
  have hterm (h : O) : (∫ z in periodDomain, f h z) =
      if h = k then ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * a h else 0 := by
    dsimp only [f]
    simp_rw [mul_assoc]
    rw [integral_const_mul, integral_cusp_character_product]
    split_ifs <;> ring
  calc
    _ = ∫ z in periodDomain, ∑' h : O, f h z := by
      apply integral_congr_ae
      exact Eventually.of_forall (fun z => by
        change (∑' h : O, a h * tracePhase (cuspFrequency h * z)) *
          tracePhase (-cuspFrequency k * z) = _
        rw [← tsum_mul_right])
    _ = ∑' h : O, ∫ z in periodDomain, f h z := (integral_tsum_of_summable_integral_norm hi hs).symm
    _ = _ := by simp only [hterm, tsum_ite_eq]

/-- A summable majorant controls the entire nonconstant Fourier remainder. -/
lemma cuspCharacterSeries_remainder_bound (a : O → ℂ) (B : O → ℝ) (hB : Summable B)
    (hB0 : ∀ h, 0 ≤ B h) (ha : ∀ h, h ≠ 0 → ‖a h‖ ≤ B h) (z : ℂ) :
    ‖cuspCharacterSeries a z - a 0‖ ≤ ∑' h, B h := by
  let b : O → ℂ := fun h => if h = 0 then 0 else a h * tracePhase (cuspFrequency h * z)
  have hb (h : O) : ‖b h‖ ≤ B h := by
    by_cases hh : h = 0
    · simpa only [b, if_pos hh, norm_zero] using hB0 h
    · simpa only [b, if_neg hh, norm_mul, tracePhase_norm, mul_one] using ha h hh
  have hbs : Summable (fun h => ‖b h‖) := Summable.of_nonneg_of_le (fun h => norm_nonneg _) hb hB
  have hz : Summable (fun h : O => if h = 0 then a 0 else 0) := (hasSum_ite_eq 0 _).summable
  have hsplit (h : O) : a h * tracePhase (cuspFrequency h * z) = (if h = 0 then a 0 else 0) + b h := by
    by_cases hh : h = 0
    · subst h
      simp only [b, if_true, cuspFrequency, map_zero, zero_div, zero_mul,
        AddChar.map_zero_eq_one, mul_one, add_zero]
    · simp only [b, if_neg hh, zero_add]
  rw [cuspCharacterSeries]
  simp_rw [hsplit]
  rw [hz.tsum_add hbs.of_norm, tsum_ite_eq, add_sub_cancel_left]
  exact (norm_tsum_le_tsum_norm hbs).trans (Summable.tsum_le_tsum hb hbs hB)

lemma periodDomain_continuous_memLp (f : ℂ → ℂ) (hf : Continuous f) :
    MemLp f 2 (volume.restrict periodDomain) := by
  apply (memLp_two_iff_integrable_sq_norm hf.aestronglyMeasurable).mpr
  apply ((hf.norm.pow 2).continuousOn.integrableOn_compact
    (isCompact_closedBall (0 : ℂ) (∑ i, ‖periodBasis i‖))).mono_set
  intro z hz
  simpa only [Metric.mem_closedBall, dist_zero_right] using norm_mem_periodDomain z hz

/-- Continuity and periodicity upgrade equality of Fourier coefficients to pointwise equality. -/
theorem periodDomain_continuous_ext (f g : ℂ → ℂ) (hf : Continuous f) (hg : Continuous g)
    (hfper : ∀ n z, f (z + 3 * ringComplex n) = f z)
    (hgper : ∀ n z, g (z + 3 * ringComplex n) = g z)
    (heq : ∀ h : O, (∫ z in periodDomain, f z * tracePhase (-cuspFrequency h * z)) =
      ∫ z in periodDomain, g z * tracePhase (-cuspFrequency h * z)) : f = g :=
  Measure.eq_of_ae_eq (ae_eq_of_periodDomain_eq f g hfper hgper
    (periodDomain_L2_ext f g (periodDomain_continuous_memLp f hf)
      (periodDomain_continuous_memLp g hg) heq)) hf hg

def rationalSourceModeAmplitude (v : ℝ) (h : O) : ℂ :=
  rationalSourceScatteringResidue h * ((v : ℂ) ^ (2 / 3 : ℂ) *
    sourceFourierKernel (4 / 3) (cuspFrequency h * v))

lemma rationalSourceModeAmplitude_bessel (v : ℝ) (hv : 0 < v) (h : O) (hh : h ≠ 0) :
    rationalSourceModeAmplitude v h = rationalSourceResidualFourierCoefficient h * (v : ℂ) *
      schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) := by
  rw [rationalSourceModeAmplitude, residue_whittaker_bessel _ v hv h hh,
    rationalSourceResidualFourierCoefficient_eq h hh]

lemma rationalSourceModeAmplitude_summable (v : ℝ) (hv : 0 < v) :
    Summable (fun h => ‖rationalSourceModeAmplitude v h‖) := by
  obtain ⟨C, hC, hb⟩ := cubicBesselCoefficient_strip_bound rationalSourceResidualFourierCoefficient
    rationalSourceResidualFourierCoefficient_subexponential v v hv le_rfl
  have hs := (summable_exp_neg_cuspFrequency_norm (Real.pi * v)
    (mul_pos Real.pi_pos hv)).mul_left C
  have hz : Summable (fun h : O => if h = 0 then ‖rationalSourceModeAmplitude v 0‖ else 0) :=
    (hasSum_ite_eq 0 _).summable
  apply Summable.of_nonneg_of_le (fun h => norm_nonneg _) _ (hz.add hs)
  intro h
  by_cases hh : h = 0
  · subst h
    simp only [if_true]
    exact le_add_of_nonneg_right (mul_nonneg hC (Real.exp_pos _).le)
  · simp only [if_neg hh, zero_add]
    rw [rationalSourceModeAmplitude_bessel v hv h hh]
    exact hb h hh v ⟨le_rfl, le_rfl⟩

lemma cubicSourceResidualFunction_period (v : ℝ) (hv : 0 < v) (z : ℂ) (n : O) :
    cubicSourceResidualFunction (upperPoint (z + 3 * ringComplex n) v hv) =
      cubicSourceResidualFunction (upperPoint z v hv) := by
  have hn := integralTranslation_three_mem_kernel n
  have he := cubicSourceResidualFunction_automorphy
    ⟨integralTranslation (3 * n), levelThree_le_rationalExtension ((globalKubotaKernel_mem _).mp hn).1⟩
      (upperPoint z v hv)
  have hchar : extendedComplexCharacter
      ⟨integralTranslation (3 * n), levelThree_le_rationalExtension ((globalKubotaKernel_mem _).mp hn).1⟩ = 1 := by
    rw [extendedComplexCharacter_restrict ⟨_, ((globalKubotaKernel_mem _).mp hn).1⟩]
    exact ((globalKubotaKernel_mem _).mp hn).2
  simpa only [hchar, one_mul, integralTranslation_action, map_mul, map_ofNat] using he

/-- The projected residual source equals its normally convergent Fourier expansion at every height. -/
theorem cubicSourceResidualFunction_fourier_expansion (v : ℝ) (hv : 0 < v) (z : ℂ) :
    cubicSourceResidualFunction (upperPoint z v hv) =
      cuspCharacterSeries (rationalSourceModeAmplitude v) z := by
  have hc : Continuous (fun z : ℂ => cubicSourceResidualFunction (upperPoint z v hv)) :=
    cubicSourceResidualFunction_continuous.comp
      (upperCoordinatesHomeomorph.continuous.comp
        (show Continuous (fun z : ℂ => (⟨(z, v), hv⟩ : UpperCoordinates)) by fun_prop))
  have hs := rationalSourceModeAmplitude_summable v hv
  have he := periodDomain_continuous_ext _ _ hc (cuspCharacterSeries_continuous _ hs)
    (fun n z => cubicSourceResidualFunction_period v hv z n)
    (fun n z => cuspCharacterSeries_period _ z n) (fun h => by
      rw [cubicSourceResidualFunction_fourier v hv h, cuspCharacterSeries_fourier _ hs h]
      exact mul_assoc _ _ _)
  exact congrFun he z

lemma height_mul_exp_neg_le_inverse_cube (ε v : ℝ) (hε : 0 < ε) (hv : 0 < v) :
    v * Real.exp (-ε * v) ≤ (24 / ε ^ 4) / v ^ 3 := by
  have hp := Real.pow_div_factorial_le_exp (ε * v) (mul_pos hε hv).le 4
  norm_num only [Nat.factorial] at hp
  have hi := one_div_le_one_div_of_le (by positivity : (0 : ℝ) < (ε * v) ^ 4 / 24) hp
  rw [one_div, ← Real.exp_neg] at hi
  calc
    _ ≤ v * (((ε * v) ^ 4 / 24)⁻¹) :=
      mul_le_mul_of_nonneg_left (by simpa only [neg_mul, one_div] using hi) hv.le
    _ = _ := by field_simp

/-- A fixed frequency gap turns exponential Bessel decay into a summable cubic height bound. -/
theorem cubicBesselCoefficient_cusp_bound (c : O → ℂ)
    (hsub : ∀ ε : ℝ, 0 < ε → ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖c h‖ ≤ C * Real.exp (ε * ‖cuspFrequency h‖)) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 → ∀ v : ℝ, 1 ≤ v →
      ‖c h * (v : ℂ) * schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v)‖ ≤
        (C / v ^ 3) * Real.exp (-(Real.pi / 2) * ‖cuspFrequency h‖) := by
  let d : ℝ := ‖(3 : ℂ) * ringComplex traceLambda‖⁻¹
  have hd : 0 < d := inv_pos.mpr (norm_pos_iff.mpr
    (mul_ne_zero (by norm_num) (ringComplex_ne_zero traceLambda_ne_zero)))
  obtain ⟨B, hB, hb⟩ := schlafliBesselK_one_third_exp_upper (4 * Real.pi * d) (by positivity)
  obtain ⟨A, hA, ha⟩ := hsub (Real.pi / 2) (by positivity)
  refine ⟨A * B * (24 / (Real.pi * d) ^ 4), by positivity, ?_⟩
  intro h hh v hv
  have hvp : 0 < v := zero_lt_one.trans_le hv
  have hgap : d ≤ ‖cuspFrequency h‖ := cuspFrequency_norm_lower h hh
  have hrv : ‖cuspFrequency h‖ ≤ ‖cuspFrequency h‖ * v := by
    simpa only [mul_one] using mul_le_mul_of_nonneg_left hv (norm_nonneg (cuspFrequency h))
  have hdv := mul_le_mul_of_nonneg_right hgap hvp.le
  have hx : 4 * Real.pi * d ≤ 4 * Real.pi * ‖cuspFrequency h‖ * v := by
    simpa only [mul_assoc] using mul_le_mul_of_nonneg_left (hgap.trans hrv)
      (show 0 ≤ 4 * Real.pi by positivity)
  have he : (Real.pi / 2) * ‖cuspFrequency h‖ -
      (4 * Real.pi * ‖cuspFrequency h‖ * v) / 2 ≤
      -(Real.pi / 2) * ‖cuspFrequency h‖ + -(Real.pi * d) * v := by
    have hm := mul_le_mul_of_nonneg_left (add_le_add hrv hdv) Real.pi_pos.le
    nlinarith only [hm]
  rw [norm_mul, norm_mul, Complex.norm_of_nonneg hvp.le]
  calc
    _ ≤ (A * Real.exp ((Real.pi / 2) * ‖cuspFrequency h‖)) * v *
        (B * Real.exp (-(4 * Real.pi * ‖cuspFrequency h‖ * v) / 2)) :=
      mul_le_mul (mul_le_mul_of_nonneg_right (ha h hh) hvp.le)
        (hb _ hx) (norm_nonneg _) (by positivity)
    _ = (A * B * v) * Real.exp ((Real.pi / 2) * ‖cuspFrequency h‖ -
        (4 * Real.pi * ‖cuspFrequency h‖ * v) / 2) := by
      rw [show -(4 * Real.pi * ‖cuspFrequency h‖ * v) / 2 =
        -((4 * Real.pi * ‖cuspFrequency h‖ * v) / 2) by ring, Real.exp_neg, Real.exp_sub]
      ring
    _ ≤ (A * B * v) * Real.exp (-(Real.pi / 2) * ‖cuspFrequency h‖ + -(Real.pi * d) * v) :=
      mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr he) (by positivity)
    _ = (A * B * Real.exp (-(Real.pi / 2) * ‖cuspFrequency h‖)) *
        (v * Real.exp (-(Real.pi * d) * v)) := by rw [Real.exp_add]; ring
    _ ≤ (A * B * Real.exp (-(Real.pi / 2) * ‖cuspFrequency h‖)) *
        ((24 / (Real.pi * d) ^ 4) / v ^ 3) :=
      mul_le_mul_of_nonneg_left (height_mul_exp_neg_le_inverse_cube _ _ (by positivity) hvp) (by positivity)
    _ = _ := by ring

lemma rationalSourceModeAmplitude_zero (v : ℝ) :
    rationalSourceModeAmplitude v 0 =
      3 * (Real.pi : ℂ) * constantArithmeticResidue * (v : ℂ) ^ (2 / 3 : ℂ) := by
  simp only [rationalSourceModeAmplitude, rationalSourceScatteringResidue, if_true,
    cuspFrequency, map_zero, zero_div, zero_mul, sourceFourierKernel_zero (4 / 3) (by norm_num)]
  ring

/-- The source's nonconstant Fourier series decays cubically, uniformly along each horosphere. -/
theorem cubicSourceResidualFunction_cusp_decay :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ v : ℝ, ∀ hv : 0 < v, 1 ≤ v → ∀ z : ℂ,
      ‖cubicSourceResidualFunction (upperPoint z v hv) -
        3 * (Real.pi : ℂ) * constantArithmeticResidue * (v : ℂ) ^ (2 / 3 : ℂ)‖ ≤ C / v ^ 3 := by
  obtain ⟨C, hC, hb⟩ := cubicBesselCoefficient_cusp_bound rationalSourceResidualFourierCoefficient
    rationalSourceResidualFourierCoefficient_subexponential
  let w : O → ℝ := fun h => Real.exp (-(Real.pi / 2) * ‖cuspFrequency h‖)
  have hw : Summable w := summable_exp_neg_cuspFrequency_norm (Real.pi / 2) (by positivity)
  refine ⟨C * ∑' h, w h, mul_nonneg hC (tsum_nonneg (fun h => (Real.exp_pos _).le)), ?_⟩
  intro v hv hlarge z
  rw [cubicSourceResidualFunction_fourier_expansion v hv z, ← rationalSourceModeAmplitude_zero]
  have he := cuspCharacterSeries_remainder_bound (rationalSourceModeAmplitude v)
    (fun h => (C / v ^ 3) * w h) (hw.mul_left _) (fun h =>
      mul_nonneg (div_nonneg hC (pow_nonneg hv.le _)) (Real.exp_pos _).le)
    (fun h hh => by rw [rationalSourceModeAmplitude_bessel v hv h hh]; exact hb h hh v hlarge) z
  rw [tsum_mul_left] at he
  convert he using 1
  ring

/-- Cubic cusp decay holds uniformly above any fixed positive height. -/
theorem cubicSourceResidualFunction_cusp_decay_from_height (a : ℝ) (ha : 0 < a) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ v : ℝ, ∀ hv : 0 < v, a ≤ v → ∀ z : ℂ,
      ‖cubicSourceResidualFunction (upperPoint z v hv) -
        3 * (Real.pi : ℂ) * constantArithmeticResidue * (v : ℂ) ^ (2 / 3 : ℂ)‖ ≤ C / v ^ 3 := by
  obtain ⟨C, hC, hc⟩ := cubicSourceResidualFunction_cusp_decay
  obtain ⟨B, hB, hb⟩ := cubicBesselCoefficient_strip_bound rationalSourceResidualFourierCoefficient
    rationalSourceResidualFourierCoefficient_subexponential a (max a 1) ha (le_max_left _ _)
  let w : O → ℝ := fun h => Real.exp (-(Real.pi * a) * ‖cuspFrequency h‖)
  have hw : Summable w := summable_exp_neg_cuspFrequency_norm (Real.pi * a) (mul_pos Real.pi_pos ha)
  let D := B * ∑' h, w h
  have hD : 0 ≤ D := mul_nonneg hB (tsum_nonneg (fun h => (Real.exp_pos _).le))
  refine ⟨C + D, add_nonneg hC hD, ?_⟩
  intro v hv hav z
  by_cases hv1 : 1 ≤ v
  · exact (hc v hv hv1 z).trans (div_le_div_of_nonneg_right (le_add_of_nonneg_right hD) (pow_nonneg hv.le _))
  have hvlt : v < 1 := lt_of_not_ge hv1
  have hbv : v ∈ Set.Icc a (max a 1) := ⟨hav, hvlt.le.trans (le_max_right _ _)⟩
  have hn : ‖cubicSourceResidualFunction (upperPoint z v hv) -
      3 * (Real.pi : ℂ) * constantArithmeticResidue * (v : ℂ) ^ (2 / 3 : ℂ)‖ ≤ D := by
    rw [cubicSourceResidualFunction_fourier_expansion v hv z, ← rationalSourceModeAmplitude_zero]
    have he := cuspCharacterSeries_remainder_bound (rationalSourceModeAmplitude v)
      (fun h => B * w h) (hw.mul_left _) (fun h => mul_nonneg hB (Real.exp_pos _).le)
      (fun h hh => by rw [rationalSourceModeAmplitude_bessel v hv h hh]; exact hb h hh v hbv) z
    simpa only [tsum_mul_left] using he
  have hv3 : v ^ 3 ≤ 1 := by simpa only [one_pow] using pow_le_pow_left₀ hv.le hvlt.le 3
  apply hn.trans
  apply (le_div_iff₀ (pow_pos hv 3)).mpr
  exact (mul_le_of_le_one_right hD hv3).trans (le_add_of_nonneg_left hC)


open scoped Matrix

lemma cusp_omega_relation : omega ^ 2 + omega + 1 = (0 : O) := by
  have h := lambda_sq_eq
  rw [lambda_def] at h
  linear_combination h

def lowerCuspMatrix (t : O) : SL(2, O) :=
  ⟨!![1, 0; t, 1], by simp [Matrix.det_fin_two]⟩

/-- Translation by three, conjugated to the lower unipotent cusp. -/
def ramifiedParabolic (t x : O) : levelThree := by
  let M : SL(2, O) := ⟨!![1 - 3 * t * x, 3 * x; -3 * t ^ 2 * x, 1 + 3 * t * x], by
    rw [Matrix.det_fin_two]
    change (1 - 3 * t * x) * (1 + 3 * t * x) - (3 * x) * (-3 * t ^ 2 * x) = 1
    ring⟩
  refine ⟨M, levelThree_of_entries M ?_⟩
  intro i j
  fin_cases i <;> fin_cases j
  · exact ⟨-t * x, by change 1 - 3 * t * x - 1 = 3 * (-t * x); ring⟩
  · exact ⟨x, by change 3 * x - 0 = 3 * x; ring⟩
  · exact ⟨-t ^ 2 * x, by change -3 * t ^ 2 * x - 0 = 3 * (-t ^ 2 * x); ring⟩
  · exact ⟨t * x, by change 1 + 3 * t * x - 1 = 3 * (t * x); ring⟩

lemma ramifiedParabolic_mul_lower (t x : O) :
    (ramifiedParabolic t x : SL(2, O)) * lowerCuspMatrix t =
      lowerCuspMatrix t * integralTranslation (3 * x) := by
  apply Subtype.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [ramifiedParabolic, lowerCuspMatrix, integralTranslation, Matrix.mul_apply, Fin.sum_univ_two] <;> ring

lemma ramifiedParabolic_character (t x : O) :
    complexCharacter (ramifiedParabolic t x) = ringComplex (symbol (-t) (1 - 3 * t * x)) := by
  simp only [complexCharacter, MonoidHom.comp_apply, character, ramifiedParabolic]
  apply congrArg ringComplex
  apply symbol_congr
  refine ⟨t, ?_⟩
  change -3 * t ^ 2 * x - (-t) = (1 - 3 * t * x) * t
  ring

lemma ramifiedParabolic_omega_character (A B : ℤ) :
    complexCharacter (ramifiedParabolic omega (Coordinates.eval A B)) =
      ringComplex (cubicExp (A + B)) := by
  rw [ramifiedParabolic_character]
  have hd : 1 - 3 * omega * Coordinates.eval A B = primaryCoord B (B - A) := by
    rw [primaryCoord_eq]
    change 1 - 3 * omega * ((A : O) + (B : O) * omega) = _
    push_cast
    linear_combination -3 * (B : O) * cusp_omega_relation
  rw [hd, symbol_neg_numerator _ _ (primaryCoord_primary _ _),
    symbol_omega_eq_linearRay _ (primaryCoord_primary _ _), linearRay_primaryCoord]
  congr 2
  ring

lemma ramifiedParabolic_omega_sq_character (A B : ℤ) :
    complexCharacter (ramifiedParabolic (omega ^ 2) (Coordinates.eval A B)) =
      ringComplex (cubicExp (-(A + B))) := by
  rw [ramifiedParabolic_character]
  have hd : 1 - 3 * omega ^ 2 * Coordinates.eval A B = primaryCoord (A - B) A := by
    rw [primaryCoord_eq]
    change 1 - 3 * omega ^ 2 * ((A : O) + (B : O) * omega) = _
    push_cast
    linear_combination -3 * ((A : O) + (B : O) * omega - (B : O)) * cusp_omega_relation
  rw [hd, symbol_neg_numerator _ _ (primaryCoord_primary _ _),
    symbol_pow_numerator _ _ (primaryCoord_primary _ _) 2,
    symbol_omega_eq_linearRay _ (primaryCoord_primary _ _), linearRay_primaryCoord]
  have he : cubicExp (2 * ((A - B) * 2 + (-1) * A)) = cubicExp (-(A + B)) := by
    apply cubicExp_eq_of_dvd_sub
    exact ⟨A - B, by ring⟩
  have hs : cubicExp ((A - B) * 2 + (-1) * A) ^ 2 = cubicExp (2 * ((A - B) * 2 + (-1) * A)) := by
    rw [pow_two, ← cubicExp_add]
    congr 1
    ring
  convert congrArg ringComplex (hs.trans he) using 1
  congr 2
  ring

def ramifiedSourceFunction (t : O) (w : HyperbolicSpace) : ℂ :=
  cubicSourceResidualFunction (integralComplexMatrix (lowerCuspMatrix t) • w)

lemma ramifiedSourceFunction_continuous (t : O) : Continuous (ramifiedSourceFunction t) :=
  cubicSourceResidualFunction_continuous.comp (continuous_hyperbolic_action _)

lemma ramifiedSourceFunction_period (t x : O) (z : ℂ) (v : ℝ) (hv : 0 < v) :
    ramifiedSourceFunction t (upperPoint (z + 3 * ringComplex x) v hv) =
      ringComplex (symbol (-t) (1 - 3 * t * x)) * ramifiedSourceFunction t (upperPoint z v hv) := by
  let n := ramifiedParabolic t x
  have he := cubicSourceResidualFunction_automorphy
    ⟨(n : SL(2, O)), levelThree_le_rationalExtension n.property⟩
      (integralComplexMatrix (lowerCuspMatrix t) • upperPoint z v hv)
  rw [extendedComplexCharacter_restrict, ramifiedParabolic_character] at he
  change cubicSourceResidualFunction (integralComplexMatrix (n : SL(2, O)) •
    (integralComplexMatrix (lowerCuspMatrix t) • upperPoint z v hv)) = _ at he
  rw [← mul_smul, ← map_mul, ramifiedParabolic_mul_lower, map_mul, mul_smul] at he
  simpa only [ramifiedSourceFunction, integralTranslation_action, map_mul, map_ofNat] using he

lemma ramifiedParabolic_three (t x : O) :
    ramifiedParabolic t (3 * x) = ramifiedParabolic t x ^ 3 := by
  apply Subtype.ext
  apply Subtype.ext
  funext i j
  fin_cases i <;> fin_cases j <;>
    simp [ramifiedParabolic, pow_succ, Matrix.mul_apply, Fin.sum_univ_two] <;> ring

lemma ramifiedSourceFunction_nine_period (t x : O) (z : ℂ) (v : ℝ) (hv : 0 < v) :
    ramifiedSourceFunction t (upperPoint (z + 9 * ringComplex x) v hv) =
      ramifiedSourceFunction t (upperPoint z v hv) := by
  have he := ramifiedSourceFunction_period t (3 * x) z v hv
  rw [← ramifiedParabolic_character, ramifiedParabolic_three, map_pow, complexCharacter_cube, one_mul] at he
  rw [map_mul, map_ofNat, show 3 * ((3 : ℂ) * ringComplex x) = 9 * ringComplex x by ring] at he
  exact he

lemma ramifiedSourceFunction_scaled_period (t : O) (v : ℝ) (hv : 0 < v) (x : O) (z : ℂ) :
    ramifiedSourceFunction t (upperPoint (3 * (z + 3 * ringComplex x)) v hv) =
      ramifiedSourceFunction t (upperPoint (3 * z) v hv) := by
  rw [show 3 * (z + 3 * ringComplex x) = 3 * z + 9 * ringComplex x by ring]
  exact ramifiedSourceFunction_nine_period t x (3 * z) v hv

/-- A nontrivial translation character annihilates the constant Fourier coefficient. -/
lemma period_integral_zero_of_character (f : ℂ → ℂ)
    (hper : ∀ (n : O) (z : ℂ), f (z + 3 * ringComplex n) = f z)
    (b χ : ℂ) (hχ : χ ≠ 1) (htranslate : ∀ z, f (z + b) = χ * f z) :
    ∫ z in periodDomain, f z = 0 := by
  have he := period_fourier_translation f hper 0 b
  simp only [cuspFrequency, map_zero, zero_div, neg_zero, zero_mul,
    AddChar.map_zero_eq_one, mul_one, one_mul] at he
  simp_rw [htranslate] at he
  rw [integral_const_mul] at he
  have hz : (χ - 1) * ∫ z in periodDomain, f z = 0 := by linear_combination he
  exact (mul_eq_zero.mp hz).resolve_left (sub_ne_zero.mpr hχ)

theorem ramifiedSourceFunction_omega_constant_zero (v : ℝ) (hv : 0 < v) :
    ∫ z in periodDomain, ramifiedSourceFunction omega (upperPoint (3 * z) v hv) = 0 := by
  apply period_integral_zero_of_character _ (ramifiedSourceFunction_scaled_period omega v hv)
    1 (ringComplex omega)
  · intro he
    have hω : omega = 1 := ringComplex_injective (by simpa only [map_one] using he)
    have h := (omega_primitive.pow_eq_one_iff_dvd 1).mp (by simpa only [pow_one] using hω)
    norm_num at h
  · intro z
    have he := ramifiedSourceFunction_period omega (Coordinates.eval 1 0) (3 * z) v hv
    rw [← ramifiedParabolic_character, ramifiedParabolic_omega_character] at he
    norm_num [Coordinates.eval, cubicExp] at he
    rw [show 3 * (z + 1) = 3 * z + (3 : ℂ) by ring]
    exact he

theorem ramifiedSourceFunction_omega_sq_constant_zero (v : ℝ) (hv : 0 < v) :
    ∫ z in periodDomain, ramifiedSourceFunction (omega ^ 2) (upperPoint (3 * z) v hv) = 0 := by
  apply period_integral_zero_of_character _ (ramifiedSourceFunction_scaled_period (omega ^ 2) v hv)
    1 (ringComplex (omega ^ 2))
  · intro he
    have hω : omega ^ 2 = 1 := ringComplex_injective (by simpa only [map_one] using he)
    have h := (omega_primitive.pow_eq_one_iff_dvd 2).mp hω
    norm_num at h
  · intro z
    have he := ramifiedSourceFunction_period (omega ^ 2) (Coordinates.eval 1 0) (3 * z) v hv
    rw [← ramifiedParabolic_character, ramifiedParabolic_omega_sq_character] at he
    norm_num [Coordinates.eval, cubicExp] at he
    rw [map_pow, show 3 * (z + 1) = 3 * z + (3 : ℂ) by ring]
    simpa only [Int.toNat] using he

/-- The quotient map induced by inclusion of integral subgroups. -/
def integralCoverMap {H K : Subgroup (SL(2, O))} (hHK : H ≤ K) :
    IntegralOrbitQuotient H → IntegralOrbitQuotient K :=
  Quotient.map' id (by
    rintro w u ⟨M, hM⟩
    exact ⟨Subgroup.inclusion hHK M, hM⟩)

lemma integralCoverMap_projection {H K : Subgroup (SL(2, O))} (hHK : H ≤ K) (w : HyperbolicSpace) :
    integralCoverMap hHK (integralOrbitProjection H w) = integralOrbitProjection K w := rfl

lemma integralCoverMap_measurable {H K : Subgroup (SL(2, O))} (hHK : H ≤ K) :
    Measurable (integralCoverMap hHK) :=
  measurable_from_quotient.mpr (measurable_integralOrbitProjection K)

lemma integralCoverMap_continuous {H K : Subgroup (SL(2, O))} (hHK : H ≤ K) :
    Continuous (integralCoverMap hHK) := continuous_id.quotient_map' _

lemma integralCoverMap_surjective {H K : Subgroup (SL(2, O))} (hHK : H ≤ K) :
    Function.Surjective (integralCoverMap hHK) := by
  intro q
  induction q using Quotient.inductionOn with
  | _ w => exact ⟨integralOrbitProjection H w, rfl⟩

abbrev IntegralCoverCosets (H K : Subgroup (SL(2, O))) := K ⧸ H.subgroupOf K

def integralCoverRep (H K : Subgroup (SL(2, O))) (q : IntegralCoverCosets H K) : K := q.out

def integralCoverSheet (H K : Subgroup (SL(2, O))) (q : IntegralCoverCosets H K) : Set HyperbolicSpace :=
  (fun w => integralCoverRep H K q • w) ⁻¹' hyperbolicFundamentalSet K

/-- Coset translates of a base fundamental domain form a domain for the covering subgroup. -/
def integralCoverDomain (H K : Subgroup (SL(2, O))) : Set HyperbolicSpace :=
  ⋃ q : IntegralCoverCosets H K, integralCoverSheet H K q

lemma integralCoverSheet_measurable (H K : Subgroup (SL(2, O))) (q : IntegralCoverCosets H K) :
    MeasurableSet (integralCoverSheet H K q) :=
  (measurable_const_smul (integralCoverRep H K q)) (hyperbolicFundamentalSet_measurable K)

lemma integralCoverDomain_measurable (H K : Subgroup (SL(2, O))) [H.IsFiniteRelIndex K] :
    MeasurableSet (integralCoverDomain H K) := by
  letI : Fintype (IntegralCoverCosets H K) := Fintype.ofFinite _
  exact MeasurableSet.iUnion (integralCoverSheet_measurable H K)

lemma fundamental_reduction_unique (K : Subgroup (SL(2, O))) (hK : K ≤ levelThree)
    (r s : K) (w : HyperbolicSpace) (hr : r • w ∈ hyperbolicFundamentalSet K)
    (hs : s • w ∈ hyperbolicFundamentalSet K) : r = s := by
  obtain ⟨m, _, hm⟩ := hyperbolicFundamentalSet_unique K hK w
  exact (hm r hr).trans (hm s hs).symm

lemma integralCoverSheet_pairwiseDisjoint (H K : Subgroup (SL(2, O))) (hK : K ≤ levelThree) :
    Pairwise (fun q r => Disjoint (integralCoverSheet H K q) (integralCoverSheet H K r)) := by
  intro q r hqr
  apply Set.disjoint_left.mpr
  intro w hwq hwr
  exact hqr (Quotient.out_injective
    (fundamental_reduction_unique K hK (integralCoverRep H K q) (integralCoverRep H K r) w hwq hwr))

lemma integralCoverRep_mul_projection {H K : Subgroup (SL(2, O))} (hHK : H ≤ K)
    (q : IntegralCoverCosets H K) (h : H) :
    ((integralCoverRep H K q * Subgroup.inclusion hHK h : K) : IntegralCoverCosets H K) = q := by
  rw [QuotientGroup.mk_mul_of_mem _ (show Subgroup.inclusion hHK h ∈ H.subgroupOf K from h.property)]
  exact QuotientGroup.out_eq' q

lemma integralCoverSheet_membership {H K : Subgroup (SL(2, O))} (hHK : H ≤ K)
    (q : IntegralCoverCosets H K) (h : H) (w : HyperbolicSpace) :
    h • w ∈ integralCoverSheet H K q ↔
      (integralCoverRep H K q * Subgroup.inclusion hHK h) • w ∈ hyperbolicFundamentalSet K := by
  rw [mul_smul]
  rfl

lemma integralCoverDomain_covers {H K : Subgroup (SL(2, O))} (hHK : H ≤ K) (w : HyperbolicSpace) :
    ∃ h : H, h • w ∈ integralCoverDomain H K := by
  obtain ⟨k, hk⟩ := hyperbolicFundamentalSet_covers K w
  let q : IntegralCoverCosets H K := k
  let r := integralCoverRep H K q
  have hr : r⁻¹ * k ∈ H.subgroupOf K := QuotientGroup.eq.mp (QuotientGroup.out_eq' q)
  let h : H := ⟨((r⁻¹ * k : K) : SL(2, O)), hr⟩
  have hin : Subgroup.inclusion hHK h = r⁻¹ * k := rfl
  refine ⟨h, Set.mem_iUnion.mpr ⟨q, ?_⟩⟩
  apply (integralCoverSheet_membership hHK q h w).mpr
  change (r * Subgroup.inclusion hHK h) • w ∈ hyperbolicFundamentalSet K
  rw [hin, mul_inv_cancel_left]
  exact hk

lemma integralCoverDomain_unique {H K : Subgroup (SL(2, O))} (hHK : H ≤ K) (hK : K ≤ levelThree)
    (w : HyperbolicSpace) (h1 h2 : H) (hh1 : h1 • w ∈ integralCoverDomain H K)
    (hh2 : h2 • w ∈ integralCoverDomain H K) : h1 = h2 := by
  obtain ⟨q1, hq1⟩ := Set.mem_iUnion.mp hh1
  obtain ⟨q2, hq2⟩ := Set.mem_iUnion.mp hh2
  have he : integralCoverRep H K q1 * Subgroup.inclusion hHK h1 =
      integralCoverRep H K q2 * Subgroup.inclusion hHK h2 :=
    fundamental_reduction_unique K hK _ _ w
      ((integralCoverSheet_membership hHK q1 h1 w).mp hq1)
      ((integralCoverSheet_membership hHK q2 h2 w).mp hq2)
  have hqeq : q1 = q2 := by
    have hproj := congrArg (fun k : K => (k : IntegralCoverCosets H K)) he
    rwa [integralCoverRep_mul_projection hHK q1 h1, integralCoverRep_mul_projection hHK q2 h2] at hproj
  subst q2
  exact (Subgroup.inclusion_injective hHK) (mul_left_cancel he)

theorem integralCoverDomain_isFundamentalDomain {H K : Subgroup (SL(2, O))}
    (hHK : H ≤ K) (hK : K ≤ levelThree) [H.IsFiniteRelIndex K] :
    IsFundamentalDomain H (integralCoverDomain H K) hyperbolicVolume := by
  apply IsFundamentalDomain.mk' (integralCoverDomain_measurable H K).nullMeasurableSet
  intro w
  obtain ⟨h, hh⟩ := integralCoverDomain_covers hHK w
  exact ⟨h, hh, fun g hg => integralCoverDomain_unique hHK hK w g h hg hh⟩

lemma integralCoverSheet_measure (H K : Subgroup (SL(2, O))) (q : IntegralCoverCosets H K)
    (S : Set (IntegralOrbitQuotient K)) (hS : MeasurableSet S) :
    hyperbolicVolume ((integralOrbitProjection K) ⁻¹' S ∩ integralCoverSheet H K q) =
      integralQuotientVolume K S := by
  have he : (integralOrbitProjection K) ⁻¹' S ∩ integralCoverSheet H K q =
      (fun w => integralCoverRep H K q • w) ⁻¹'
        ((integralOrbitProjection K) ⁻¹' S ∩ hyperbolicFundamentalSet K) := by
    ext w
    change (integralOrbitProjection K w ∈ S ∧ integralCoverRep H K q • w ∈ hyperbolicFundamentalSet K) ↔
      (integralOrbitProjection K (integralCoverRep H K q • w) ∈ S ∧
        integralCoverRep H K q • w ∈ hyperbolicFundamentalSet K)
    rw [integralSubgroup_smul, integralOrbitProjection_eq]
  rw [he, measure_preimage_smul, integralQuotientVolume,
    Measure.map_apply (measurable_integralOrbitProjection K) hS,
    Measure.restrict_apply ((measurable_integralOrbitProjection K) hS)]

/-- Quotient volume pushes forward with multiplicity equal to the covering degree. -/
theorem integralCoverMap_measure {H K : Subgroup (SL(2, O))} (hHK : H ≤ K)
    (hK : K ≤ levelThree) [H.IsFiniteRelIndex K] :
    Measure.map (integralCoverMap hHK) (integralQuotientVolume H) =
      (H.relIndex K : ℝ≥0∞) • integralQuotientVolume K := by
  letI : Fintype (IntegralCoverCosets H K) := Fintype.ofFinite _
  rw [← integralQuotientVolume_independent H (hHK.trans hK) (integralCoverDomain H K)
    (integralCoverDomain_isFundamentalDomain hHK hK),
    Measure.map_map (integralCoverMap_measurable hHK) (measurable_integralOrbitProjection H)]
  change Measure.map (integralOrbitProjection K) (hyperbolicVolume.restrict (integralCoverDomain H K)) = _
  apply Measure.ext
  intro S hS
  rw [Measure.map_apply (measurable_integralOrbitProjection K) hS,
    Measure.restrict_apply ((measurable_integralOrbitProjection K) hS), Measure.smul_apply, smul_eq_mul,
    integralCoverDomain, Set.inter_iUnion, measure_iUnion]
  · simp_rw [integralCoverSheet_measure H K _ S hS]
    rw [tsum_fintype]
    simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
    congr 1
    rw [Subgroup.relIndex, Subgroup.index, Nat.card_eq_fintype_card]
  · intro q r hqr
    exact (integralCoverSheet_pairwiseDisjoint H K hK hqr).mono Set.inter_subset_right Set.inter_subset_right
  · intro q
    exact ((measurable_integralOrbitProjection K) hS).inter (integralCoverSheet_measurable H K q)

lemma integralCoverMap_measurePreserving {H K : Subgroup (SL(2, O))} (hHK : H ≤ K)
    (hK : K ≤ levelThree) [H.IsFiniteRelIndex K] :
    MeasurePreserving (integralCoverMap hHK) (integralQuotientVolume H)
      ((H.relIndex K : ℝ≥0∞) • integralQuotientVolume K) :=
  ⟨integralCoverMap_measurable hHK, integralCoverMap_measure hHK hK⟩

abbrev IntegralQuotientL2 (H : Subgroup (SL(2, O))) := Lp ℂ 2 (integralQuotientVolume H)

def integralCoverPullback {H K : Subgroup (SL(2, O))} (hHK : H ≤ K)
    (hK : K ≤ levelThree) [H.IsFiniteRelIndex K] : IntegralQuotientL2 K →L[ℂ] IntegralQuotientL2 H :=
  (Lp.compMeasurePreservingₗᵢ ℂ (integralCoverMap hHK)
    (integralCoverMap_measurePreserving hHK hK)).toContinuousLinearMap.comp
      (dominatedComplexL2 (by simp : (H.relIndex K : ℝ≥0∞) ≠ ⊤) le_rfl)

theorem integralCoverPullback_ae {H K : Subgroup (SL(2, O))} (hHK : H ≤ K)
    (hK : K ≤ levelThree) [H.IsFiniteRelIndex K] (F : IntegralQuotientL2 K) :
    integralCoverPullback hHK hK F =ᵐ[integralQuotientVolume H] fun q => F (integralCoverMap hHK q) := by
  have hm := integralCoverMap_measurePreserving hHK hK
  have he := dominatedComplexL2_ae (by simp : (H.relIndex K : ℝ≥0∞) ≠ ⊤)
    (le_rfl : (H.relIndex K : ℝ≥0∞) • integralQuotientVolume K ≤
      (H.relIndex K : ℝ≥0∞) • integralQuotientVolume K) F
  exact (Lp.coeFn_compMeasurePreserving _ hm).trans (hm.quasiMeasurePreserving.ae_eq_comp he)

theorem integralCoverPullback_inner {H K : Subgroup (SL(2, O))} (hHK : H ≤ K)
    (hK : K ≤ levelThree) [H.IsFiniteRelIndex K] (F G : IntegralQuotientL2 K) :
    inner ℂ (integralCoverPullback hHK hK F) (integralCoverPullback hHK hK G) =
      (H.relIndex K : ℂ) * inner ℂ F G := by
  let changeMeasure : IntegralQuotientL2 K →L[ℂ] Lp ℂ 2 ((H.relIndex K : ℝ≥0∞) • integralQuotientVolume K) :=
    dominatedComplexL2 (by simp : (H.relIndex K : ℝ≥0∞) ≠ ⊤) le_rfl
  change inner ℂ ((Lp.compMeasurePreservingₗᵢ ℂ (integralCoverMap hHK)
    (integralCoverMap_measurePreserving hHK hK)) (changeMeasure F))
    ((Lp.compMeasurePreservingₗᵢ ℂ (integralCoverMap hHK)
    (integralCoverMap_measurePreserving hHK hK)) (changeMeasure G)) = _
  rw [LinearIsometry.inner_map_map, L2.inner_def, L2.inner_def]
  have hF := dominatedComplexL2_ae (by simp : (H.relIndex K : ℝ≥0∞) ≠ ⊤)
    (le_rfl : (H.relIndex K : ℝ≥0∞) • integralQuotientVolume K ≤
      (H.relIndex K : ℝ≥0∞) • integralQuotientVolume K) F
  have hG := dominatedComplexL2_ae (by simp : (H.relIndex K : ℝ≥0∞) ≠ ⊤)
    (le_rfl : (H.relIndex K : ℝ≥0∞) • integralQuotientVolume K ≤
      (H.relIndex K : ℝ≥0∞) • integralQuotientVolume K) G
  calc
    _ = ∫ q, inner ℂ (F q) (G q) ∂((H.relIndex K : ℝ≥0∞) • integralQuotientVolume K) := by
      apply integral_congr_ae
      filter_upwards [hF, hG] with q hqF hqG
      change inner ℂ (changeMeasure F q) (changeMeasure G q) = inner ℂ (F q) (G q)
      rw [show changeMeasure F q = F q from hqF, show changeMeasure G q = G q from hqG]
    _ = _ := by
      rw [integral_smul_measure]
      simp only [ENNReal.toReal_natCast, Complex.real_smul, Complex.ofReal_natCast]

def integralCoverTrace {H K : Subgroup (SL(2, O))} (hHK : H ≤ K)
    (hK : K ≤ levelThree) [H.IsFiniteRelIndex K] : IntegralQuotientL2 H →L[ℂ] IntegralQuotientL2 K :=
  ContinuousLinearMap.adjoint (integralCoverPullback hHK hK)

/-- Trace after pullback is multiplication by the finite covering degree. -/
theorem integralCoverTrace_pullback {H K : Subgroup (SL(2, O))} (hHK : H ≤ K)
    (hK : K ≤ levelThree) [H.IsFiniteRelIndex K] (F : IntegralQuotientL2 K) :
    integralCoverTrace hHK hK (integralCoverPullback hHK hK F) = (H.relIndex K : ℂ) • F := by
  apply ext_inner_left ℂ
  intro G
  rw [integralCoverTrace, ContinuousLinearMap.adjoint_inner_right,
    integralCoverPullback_inner, inner_smul_right]

/-- A coset labels one point in each fiber of an integral cover. -/
def integralCoverFiberPoint (H K : Subgroup (SL(2, O))) (q : IntegralCoverCosets H K)
    (w : HyperbolicSpace) : IntegralOrbitQuotient H :=
  Quotient.liftOn' q (fun r : K => integralOrbitProjection H (r⁻¹ • w)) (by
    intro a b hab
    have hh : b⁻¹ * a ∈ H.subgroupOf K := by
      have h := QuotientGroup.leftRel_apply.mp hab
      simpa only [mul_inv_rev, inv_inv] using (H.subgroupOf K).inv_mem h
    apply Quotient.sound
    refine ⟨⟨((b⁻¹ * a : K) : SL(2, O)), hh⟩, ?_⟩
    change (b⁻¹ * a) • (a⁻¹ • w) = b⁻¹ • w
    simp only [mul_smul, smul_inv_smul])

lemma integralCoverFiberPoint_mk (H K : Subgroup (SL(2, O))) (r : K) (w : HyperbolicSpace) :
    integralCoverFiberPoint H K r w = integralOrbitProjection H (r⁻¹ • w) := rfl

lemma integralCoverFiberPoint_rep (H K : Subgroup (SL(2, O))) (q : IntegralCoverCosets H K)
    (w : HyperbolicSpace) : integralCoverFiberPoint H K q w =
      integralOrbitProjection H ((integralCoverRep H K q)⁻¹ • w) := by
  conv_lhs => rw [← QuotientGroup.out_eq' q]
  rfl

lemma integralCoverFiberPoint_smul (H K : Subgroup (SL(2, O))) (q : IntegralCoverCosets H K)
    (k : K) (w : HyperbolicSpace) :
    integralCoverFiberPoint H K (k • q) (k • w) = integralCoverFiberPoint H K q w := by
  induction q using Quotient.inductionOn with
  | _ r =>
    change integralOrbitProjection H ((k * r)⁻¹ • (k • w)) = integralOrbitProjection H (r⁻¹ • w)
    rw [mul_inv_rev, mul_smul, inv_smul_smul]

lemma integralCoverFiberPoint_measurable (H K : Subgroup (SL(2, O))) (q : IntegralCoverCosets H K) :
    Measurable (integralCoverFiberPoint H K q) := by
  rw [show integralCoverFiberPoint H K q = fun w =>
      integralOrbitProjection H ((integralCoverRep H K q)⁻¹ • w) from
    funext (integralCoverFiberPoint_rep H K q)]
  exact (measurable_integralOrbitProjection H).comp (measurable_const_smul _)

def integralCoverTraceLift (H K : Subgroup (SL(2, O))) [H.IsFiniteRelIndex K]
    (f : IntegralOrbitQuotient H → ℂ) (w : HyperbolicSpace) : ℂ :=
  letI : Fintype (IntegralCoverCosets H K) := Fintype.ofFinite _
  ∑ q : IntegralCoverCosets H K, f (integralCoverFiberPoint H K q w)

lemma integralCoverTraceLift_smul (H K : Subgroup (SL(2, O))) [H.IsFiniteRelIndex K]
    (f : IntegralOrbitQuotient H → ℂ) (k : K) (w : HyperbolicSpace) :
    integralCoverTraceLift H K f (k • w) = integralCoverTraceLift H K f w := by
  letI : Fintype (IntegralCoverCosets H K) := Fintype.ofFinite _
  unfold integralCoverTraceLift
  rw [← (MulAction.bijective k).sum_comp (fun q => f (integralCoverFiberPoint H K q (k • w)))]
  simp only [integralCoverFiberPoint_smul]

/-- The unnormalized fiber sum, descended to the base quotient. -/
def integralCoverTraceFunction (H K : Subgroup (SL(2, O))) [H.IsFiniteRelIndex K]
    (f : IntegralOrbitQuotient H → ℂ) : IntegralOrbitQuotient K → ℂ :=
  Quotient.lift (integralCoverTraceLift H K f) (by
    rintro w u ⟨k, rfl⟩
    exact (integralCoverTraceLift_smul H K f k w).symm)

lemma integralCoverTraceFunction_projection (H K : Subgroup (SL(2, O))) [H.IsFiniteRelIndex K]
    (f : IntegralOrbitQuotient H → ℂ) (w : HyperbolicSpace) :
    integralCoverTraceFunction H K f (integralOrbitProjection K w) = integralCoverTraceLift H K f w := rfl

lemma integralCoverTraceFunction_measurable (H K : Subgroup (SL(2, O))) [H.IsFiniteRelIndex K]
    (f : IntegralOrbitQuotient H → ℂ) (hf : Measurable f) : Measurable (integralCoverTraceFunction H K f) := by
  letI : Fintype (IntegralCoverCosets H K) := Fintype.ofFinite _
  apply measurable_from_quotient.mpr
  change Measurable (integralCoverTraceLift H K f)
  unfold integralCoverTraceLift
  exact Finset.measurable_sum Finset.univ (fun q _ => hf.comp (integralCoverFiberPoint_measurable H K q))

theorem integralCoverTraceFunction_integral_cusp_decay (H K : Subgroup (SL(2, O)))
    [H.IsFiniteRelIndex K] (f : IntegralOrbitQuotient H → ℂ) (C : ℝ)
    (hdec : ∀ M : SL(2, O), ∀ z : ℂ, ∀ v : ℝ, ∀ hv : 0 < v, 1 < v →
      ‖f (integralOrbitProjection H (integralComplexMatrix M • upperPoint z v hv))‖ ≤ C / v ^ 3)
    (M : SL(2, O)) (z : ℂ) (v : ℝ) (hv : 0 < v) (hlarge : 1 < v) :
    ‖integralCoverTraceFunction H K f
      (integralOrbitProjection K (integralComplexMatrix M • upperPoint z v hv))‖ ≤
        (H.relIndex K : ℝ) * C / v ^ 3 := by
  letI : Fintype (IntegralCoverCosets H K) := Fintype.ofFinite _
  change ‖∑ q : IntegralCoverCosets H K,
    f (integralCoverFiberPoint H K q (integralComplexMatrix M • upperPoint z v hv))‖ ≤ _
  calc
    _ ≤ ∑ q : IntegralCoverCosets H K,
        ‖f (integralCoverFiberPoint H K q (integralComplexMatrix M • upperPoint z v hv))‖ := norm_sum_le _ _
    _ ≤ ∑ _q : IntegralCoverCosets H K, C / v ^ 3 := by
      apply Finset.sum_le_sum
      intro q _
      rw [integralCoverFiberPoint_rep, integralSubgroup_smul, ← mul_smul, ← map_mul]
      exact hdec _ z v hv hlarge
    _ = _ := by
      simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
      have hc : Fintype.card (IntegralCoverCosets H K) = H.relIndex K := by
        rw [Subgroup.relIndex, Subgroup.index, Nat.card_eq_fintype_card]
      rw [hc]
      ring

lemma integralCoverDomain_projection_measurePreserving {H K : Subgroup (SL(2, O))}
    (hHK : H ≤ K) (hK : K ≤ levelThree) [H.IsFiniteRelIndex K] :
    MeasurePreserving (integralOrbitProjection H)
      (hyperbolicVolume.restrict (integralCoverDomain H K)) (integralQuotientVolume H) :=
  ⟨measurable_integralOrbitProjection H, integralQuotientVolume_independent H (hHK.trans hK) _
    (integralCoverDomain_isFundamentalDomain hHK hK)⟩

lemma integralCoverSheet_measurePreserving (H K : Subgroup (SL(2, O))) (q : IntegralCoverCosets H K) :
    MeasurePreserving (fun w : HyperbolicSpace => integralCoverRep H K q • w)
      (hyperbolicVolume.restrict (integralCoverSheet H K q))
      (hyperbolicVolume.restrict (hyperbolicFundamentalSet K)) :=
  (measurePreserving_smul (integralCoverRep H K q) hyperbolicVolume).restrict_preimage
    (hyperbolicFundamentalSet_measurable K)

lemma integralCoverFiberPoint_rep_smul (H K : Subgroup (SL(2, O)))
    (q : IntegralCoverCosets H K) (w : HyperbolicSpace) :
    integralCoverFiberPoint H K q (integralCoverRep H K q • w) = integralOrbitProjection H w := by
  rw [integralCoverFiberPoint_rep, inv_smul_smul]

lemma integralCoverFiber_integrable {H K : Subgroup (SL(2, O))} (hHK : H ≤ K)
    (hK : K ≤ levelThree) [H.IsFiniteRelIndex K] (f : IntegralOrbitQuotient H → ℂ)
    (hmeas : Measurable f) (hf : Integrable f (integralQuotientVolume H)) (q : IntegralCoverCosets H K) :
    IntegrableOn (fun w => f (integralCoverFiberPoint H K q w)) (hyperbolicFundamentalSet K) hyperbolicVolume := by
  have hD := (integralCoverDomain_projection_measurePreserving hHK hK).integrable_comp_of_integrable hf
  have hS : IntegrableOn (fun w => f (integralOrbitProjection H w)) (integralCoverSheet H K q) hyperbolicVolume :=
    IntegrableOn.mono_set hD (Set.subset_iUnion (integralCoverSheet H K) q)
  apply ((integralCoverSheet_measurePreserving H K q).integrable_comp
    (hmeas.comp (integralCoverFiberPoint_measurable H K q)).aestronglyMeasurable).mp
  simpa only [IntegrableOn, Function.comp_def, integralCoverFiberPoint_rep_smul] using hS

lemma integralCoverFiber_integral (H K : Subgroup (SL(2, O))) (q : IntegralCoverCosets H K)
    (f : IntegralOrbitQuotient H → ℂ) :
    (∫ w in hyperbolicFundamentalSet K, f (integralCoverFiberPoint H K q w) ∂hyperbolicVolume) =
      ∫ w in integralCoverSheet H K q, f (integralOrbitProjection H w) ∂hyperbolicVolume := by
  have hh := (measurePreserving_smul (integralCoverRep H K q) hyperbolicVolume).setIntegral_preimage_emb
    (measurableEmbedding_const_smul (integralCoverRep H K q))
    (fun w => f (integralCoverFiberPoint H K q w)) (hyperbolicFundamentalSet K)
  simpa only [integralCoverSheet, integralCoverFiberPoint_rep_smul] using hh.symm

/-- Integrating a fiber sum over the base equals integrating over the covering quotient. -/
theorem integralCoverTraceFunction_integral {H K : Subgroup (SL(2, O))} (hHK : H ≤ K)
    (hK : K ≤ levelThree) [H.IsFiniteRelIndex K] (f : IntegralOrbitQuotient H → ℂ)
    (hmeas : Measurable f) (hf : Integrable f (integralQuotientVolume H)) :
    (∫ q, integralCoverTraceFunction H K f q ∂integralQuotientVolume K) =
      ∫ q, f q ∂integralQuotientVolume H := by
  letI : Fintype (IntegralCoverCosets H K) := Fintype.ofFinite _
  have hD := (integralCoverDomain_projection_measurePreserving hHK hK).integrable_comp_of_integrable hf
  have hS (q : IntegralCoverCosets H K) :
      IntegrableOn (fun w => f (integralOrbitProjection H w)) (integralCoverSheet H K q) hyperbolicVolume :=
    IntegrableOn.mono_set hD (Set.subset_iUnion (integralCoverSheet H K) q)
  rw [integralQuotientVolume_integral K _
    (integralCoverTraceFunction_measurable H K f hmeas).aestronglyMeasurable]
  change (∫ w in hyperbolicFundamentalSet K,
    ∑ q : IntegralCoverCosets H K, f (integralCoverFiberPoint H K q w) ∂hyperbolicVolume) = _
  rw [integral_finsetSum Finset.univ (fun q _ => integralCoverFiber_integrable hHK hK f hmeas hf q)]
  simp_rw [integralCoverFiber_integral H K]
  rw [← integral_iUnion_fintype (integralCoverSheet_measurable H K)
    (integralCoverSheet_pairwiseDisjoint H K hK) hS]
  change (∫ w in integralCoverDomain H K, f (integralOrbitProjection H w) ∂hyperbolicVolume) = _
  rw [← (integralCoverDomain_projection_measurePreserving hHK hK).map_eq]
  exact (integral_map (measurable_integralOrbitProjection H).aemeasurable hmeas.aestronglyMeasurable).symm

lemma integralCoverFiber_memLp {H K : Subgroup (SL(2, O))} (hHK : H ≤ K)
    (hK : K ≤ levelThree) [H.IsFiniteRelIndex K] (f : IntegralOrbitQuotient H → ℂ)
    (hmeas : Measurable f) (hf : MemLp f 2 (integralQuotientVolume H)) (q : IntegralCoverCosets H K) :
    MemLp (fun w => f (integralCoverFiberPoint H K q w)) 2
      (hyperbolicVolume.restrict (hyperbolicFundamentalSet K)) := by
  have hD := hf.comp_measurePreserving (integralCoverDomain_projection_measurePreserving hHK hK)
  have hS := MemLp.mono_measure
    (Measure.restrict_mono_set hyperbolicVolume (Set.subset_iUnion (integralCoverSheet H K) q)) hD
  have hm := integralCoverSheet_measurePreserving H K q
  have hi := memLp_map_measure_iff (p := 2)
    (hmeas.comp (integralCoverFiberPoint_measurable H K q)).aestronglyMeasurable hm.aemeasurable
  rw [hm.map_eq] at hi
  apply hi.mpr
  simpa only [Function.comp_def, integralCoverFiberPoint_rep_smul] using hS

theorem integralCoverTraceFunction_memLp {H K : Subgroup (SL(2, O))} (hHK : H ≤ K)
    (hK : K ≤ levelThree) [H.IsFiniteRelIndex K] (f : IntegralOrbitQuotient H → ℂ)
    (hmeas : Measurable f) (hf : MemLp f 2 (integralQuotientVolume H)) :
    MemLp (integralCoverTraceFunction H K f) 2 (integralQuotientVolume K) := by
  letI : Fintype (IntegralCoverCosets H K) := Fintype.ofFinite _
  have hm := quotient_projection_measurePreserving K
  have hi := memLp_map_measure_iff (p := 2)
    (integralCoverTraceFunction_measurable H K f hmeas).aestronglyMeasurable hm.aemeasurable
  rw [hm.map_eq] at hi
  apply hi.mpr
  change MemLp (fun w => ∑ q : IntegralCoverCosets H K, f (integralCoverFiberPoint H K q w)) 2 _
  exact memLp_finsetSum Finset.univ (fun q _ => integralCoverFiber_memLp hHK hK f hmeas hf q)

lemma integralCoverMap_fiberPoint {H K : Subgroup (SL(2, O))} (hHK : H ≤ K)
    (q : IntegralCoverCosets H K) (w : HyperbolicSpace) :
    integralCoverMap hHK (integralCoverFiberPoint H K q w) = integralOrbitProjection K w := by
  rw [integralCoverFiberPoint_rep, integralCoverMap_projection, integralSubgroup_smul, integralOrbitProjection_eq]

lemma integralCoverTraceFunction_pairing {H K : Subgroup (SL(2, O))} (hHK : H ≤ K)
    [H.IsFiniteRelIndex K] (F : IntegralOrbitQuotient K → ℂ) (f : IntegralOrbitQuotient H → ℂ)
    (q : IntegralOrbitQuotient K) :
    integralCoverTraceFunction H K (fun r => inner ℂ (F (integralCoverMap hHK r)) (f r)) q =
      inner ℂ (F q) (integralCoverTraceFunction H K f q) := by
  letI : Fintype (IntegralCoverCosets H K) := Fintype.ofFinite _
  induction q using Quotient.inductionOn with
  | _ w =>
    change (∑ r : IntegralCoverCosets H K, inner ℂ
      (F (integralCoverMap hHK (integralCoverFiberPoint H K r w))) (f (integralCoverFiberPoint H K r w))) =
      inner ℂ (F (integralOrbitProjection K w)) (∑ r : IntegralCoverCosets H K, f (integralCoverFiberPoint H K r w))
    simp only [integralCoverMap_fiberPoint, inner_sum]

/-- The Hilbert adjoint of pullback is represented by the actual finite fiber sum. -/
theorem integralCoverTrace_toLp_ae {H K : Subgroup (SL(2, O))} (hHK : H ≤ K)
    (hK : K ≤ levelThree) [H.IsFiniteRelIndex K] (f : IntegralOrbitQuotient H → ℂ)
    (hmeas : Measurable f) (hf : MemLp f 2 (integralQuotientVolume H)) :
    integralCoverTrace hHK hK (hf.toLp f) =ᵐ[integralQuotientVolume K] integralCoverTraceFunction H K f := by
  let htr := integralCoverTraceFunction_memLp hHK hK f hmeas hf
  let Tf : IntegralQuotientL2 K := htr.toLp (integralCoverTraceFunction H K f)
  have he : Tf = integralCoverTrace hHK hK (hf.toLp f) := by
    apply ext_inner_left ℂ
    intro F
    let pair : IntegralOrbitQuotient H → ℂ := fun r => inner ℂ (F (integralCoverMap hHK r)) (f r)
    have hpm : Measurable pair := by
      have hFm := (Lp.stronglyMeasurable F).measurable.comp (integralCoverMap_measurable hHK)
      have hm := hmeas.mul (continuous_star.measurable.comp hFm)
      change Measurable (fun r => f r * star (F (integralCoverMap hHK r))) at hm
      simpa only [pair, RCLike.inner_apply, starRingEnd_apply] using hm
    have hae : (fun r => inner ℂ (integralCoverPullback hHK hK F r) (hf.toLp f r))
        =ᵐ[integralQuotientVolume H] pair := by
      filter_upwards [integralCoverPullback_ae hHK hK F, hf.coeFn_toLp] with r hr hfR
      dsimp only [pair]
      rw [hr, hfR]
    have hpi : Integrable pair (integralQuotientVolume H) :=
      (L2.integrable_inner (integralCoverPullback hHK hK F) (hf.toLp f)).congr hae
    calc
      inner ℂ F Tf = ∫ q, inner ℂ (F q) (integralCoverTraceFunction H K f q) ∂integralQuotientVolume K := by
        rw [L2.inner_def]
        apply integral_congr_ae
        filter_upwards [htr.coeFn_toLp] with q hq
        change inner ℂ (F q) (htr.toLp (integralCoverTraceFunction H K f) q) = _
        rw [hq]
      _ = ∫ q, integralCoverTraceFunction H K pair q ∂integralQuotientVolume K :=
        integral_congr_ae (Eventually.of_forall (fun q => (integralCoverTraceFunction_pairing hHK F f q).symm))
      _ = ∫ r, pair r ∂integralQuotientVolume H := integralCoverTraceFunction_integral hHK hK pair hpm hpi
      _ = inner ℂ (integralCoverPullback hHK hK F) (hf.toLp f) := (integral_congr_ae hae).symm
      _ = inner ℂ F (integralCoverTrace hHK hK (hf.toLp f)) :=
        (ContinuousLinearMap.adjoint_inner_right _ _ _).symm
  rw [← he]
  exact htr.coeFn_toLp

theorem integralCoverTrace_representative {H K : Subgroup (SL(2, O))} (hHK : H ≤ K)
    (hK : K ≤ levelThree) [H.IsFiniteRelIndex K] (G : IntegralQuotientL2 H)
    (f : IntegralOrbitQuotient H → ℂ) (hmeas : Measurable f) (hrep : G =ᵐ[integralQuotientVolume H] f) :
    integralCoverTrace hHK hK G =ᵐ[integralQuotientVolume K] integralCoverTraceFunction H K f := by
  have hf : MemLp f 2 (integralQuotientVolume H) := (memLp_congr_ae hrep).mp (Lp.memLp G)
  have he : G = hf.toLp f := Lp.ext (hrep.trans hf.coeFn_toLp.symm)
  rw [he]
  exact integralCoverTrace_toLp_ae hHK hK f hmeas hf

/-- Compatibility of a subgroup isomorphism with an actual hyperbolic isometry. -/
def IntegralCoverIntertwines {H J : Subgroup (SL(2, O))} (e : H ≃* J) (g : SL(2, ℂ)) : Prop :=
  ∀ h : H, g * integralComplexMatrix (h : SL(2, O)) = integralComplexMatrix (e h : SL(2, O)) * g

lemma integralCoverIntertwines_action {H J : Subgroup (SL(2, O))} (e : H ≃* J)
    (g : SL(2, ℂ)) (he : IntegralCoverIntertwines e g) (h : H) (w : HyperbolicSpace) :
    g • (h • w) = (e h) • (g • w) := by
  rw [integralSubgroup_smul, integralSubgroup_smul, ← mul_smul, he, mul_smul]

lemma integralCoverIntertwines_inverse {H J : Subgroup (SL(2, O))} (e : H ≃* J)
    (g : SL(2, ℂ)) (he : IntegralCoverIntertwines e g) : IntegralCoverIntertwines e.symm g⁻¹ := by
  intro j
  have hh := he (e.symm j)
  rw [e.apply_symm_apply] at hh
  have hh' := congrArg (fun A : SL(2, ℂ) => g⁻¹ * A * g⁻¹) hh
  simpa only [mul_assoc, inv_mul_cancel_left, mul_inv_cancel_right, mul_inv_cancel, mul_one] using hh'.symm

def integralConjugateMap {H J : Subgroup (SL(2, O))} (e : H ≃* J)
    (g : SL(2, ℂ)) (he : IntegralCoverIntertwines e g) : IntegralOrbitQuotient H → IntegralOrbitQuotient J :=
  Quotient.map' (fun w => g • w) (by
    rintro w u ⟨h, rfl⟩
    exact ⟨e h, (integralCoverIntertwines_action e g he h w).symm⟩)

lemma integralConjugateMap_projection {H J : Subgroup (SL(2, O))} (e : H ≃* J)
    (g : SL(2, ℂ)) (he : IntegralCoverIntertwines e g) (w : HyperbolicSpace) :
    integralConjugateMap e g he (integralOrbitProjection H w) = integralOrbitProjection J (g • w) := rfl

lemma integralConjugateMap_measurable {H J : Subgroup (SL(2, O))} (e : H ≃* J)
    (g : SL(2, ℂ)) (he : IntegralCoverIntertwines e g) : Measurable (integralConjugateMap e g he) :=
  measurable_from_quotient.mpr ((measurable_integralOrbitProjection J).comp (measurable_const_smul g))

lemma integralConjugateMap_continuous {H J : Subgroup (SL(2, O))} (e : H ≃* J)
    (g : SL(2, ℂ)) (he : IntegralCoverIntertwines e g) : Continuous (integralConjugateMap e g he) :=
  (continuous_hyperbolic_action g).quotient_map' _

lemma integralConjugateMap_inverse {H J : Subgroup (SL(2, O))} (e : H ≃* J)
    (g : SL(2, ℂ)) (he : IntegralCoverIntertwines e g) (q : IntegralOrbitQuotient H) :
    integralConjugateMap e.symm g⁻¹ (integralCoverIntertwines_inverse e g he) (integralConjugateMap e g he q) = q := by
  induction q using Quotient.inductionOn with
  | _ w =>
    change integralOrbitProjection H (g⁻¹ • (g • w)) = integralOrbitProjection H w
    rw [inv_smul_smul]

def integralConjugateHomeomorph {H J : Subgroup (SL(2, O))} (e : H ≃* J)
    (g : SL(2, ℂ)) (he : IntegralCoverIntertwines e g) : IntegralOrbitQuotient H ≃ₜ IntegralOrbitQuotient J where
  toFun := integralConjugateMap e g he
  invFun := integralConjugateMap e.symm g⁻¹ (integralCoverIntertwines_inverse e g he)
  left_inv := integralConjugateMap_inverse e g he
  right_inv q := by
    induction q using Quotient.inductionOn with
    | _ w =>
      change integralOrbitProjection J (g • (g⁻¹ • w)) = integralOrbitProjection J w
      rw [smul_inv_smul]
  continuous_toFun := integralConjugateMap_continuous e g he
  continuous_invFun := integralConjugateMap_continuous e.symm g⁻¹ _

lemma integralConjugate_fundamentalDomain {H J : Subgroup (SL(2, O))} (e : H ≃* J)
    (g : SL(2, ℂ)) (he : IntegralCoverIntertwines e g) (hH : H ≤ levelThree) :
    IsFundamentalDomain J ((fun w : HyperbolicSpace => g • w) '' hyperbolicFundamentalSet H) hyperbolicVolume := by
  apply (hyperbolicFundamentalSet_isFundamentalDomain H hH hyperbolicVolume).image_of_equiv
    (MulAction.toPerm g)
    (show Measure.QuasiMeasurePreserving (MulAction.toPerm g).symm hyperbolicVolume hyperbolicVolume from
      (measurePreserving_smul g⁻¹ hyperbolicVolume).quasiMeasurePreserving) e.symm.toEquiv
  intro j w
  change g • (e.symm j • w) = j • (g • w)
  simpa only [e.apply_symm_apply] using integralCoverIntertwines_action e g he (e.symm j) w

theorem integralConjugateMap_measurePreserving {H J : Subgroup (SL(2, O))} (e : H ≃* J)
    (g : SL(2, ℂ)) (he : IntegralCoverIntertwines e g) (hH : H ≤ levelThree) (hJ : J ≤ levelThree) :
    MeasurePreserving (integralConjugateMap e g he) (integralQuotientVolume H) (integralQuotientVolume J) := by
  refine ⟨integralConjugateMap_measurable e g he, ?_⟩
  have hmap := (measurePreserving_smul g hyperbolicVolume).restrict_image_emb
    (measurableEmbedding_const_smul g) (hyperbolicFundamentalSet H)
  change Measure.map (integralConjugateMap e g he)
    (Measure.map (integralOrbitProjection H) (hyperbolicVolume.restrict (hyperbolicFundamentalSet H))) = _
  rw [Measure.map_map (integralConjugateMap_measurable e g he) (measurable_integralOrbitProjection H)]
  change Measure.map ((integralOrbitProjection J) ∘ (fun w : HyperbolicSpace => g • w))
    (hyperbolicVolume.restrict (hyperbolicFundamentalSet H)) = _
  rw [← Measure.map_map (measurable_integralOrbitProjection J) (measurable_const_smul g), hmap.map_eq]
  exact integralQuotientVolume_independent J hJ _ (integralConjugate_fundamentalDomain e g he hH)

def integralConjugatePullback {H J : Subgroup (SL(2, O))} (e : H ≃* J)
    (g : SL(2, ℂ)) (he : IntegralCoverIntertwines e g) (hH : H ≤ levelThree) (hJ : J ≤ levelThree) :
    IntegralQuotientL2 J →ₗᵢ[ℂ] IntegralQuotientL2 H :=
  Lp.compMeasurePreservingₗᵢ ℂ (integralConjugateMap e g he)
    (integralConjugateMap_measurePreserving e g he hH hJ)

lemma integralConjugatePullback_ae {H J : Subgroup (SL(2, O))} (e : H ≃* J)
    (g : SL(2, ℂ)) (he : IntegralCoverIntertwines e g) (hH : H ≤ levelThree) (hJ : J ≤ levelThree)
    (F : IntegralQuotientL2 J) : integralConjugatePullback e g he hH hJ F =ᵐ[integralQuotientVolume H]
      fun q => F (integralConjugateMap e g he q) :=
  Lp.coeFn_compMeasurePreserving F (integralConjugateMap_measurePreserving e g he hH hJ)

lemma integralConjugatePullback_inverse {H J : Subgroup (SL(2, O))} (e : H ≃* J)
    (g : SL(2, ℂ)) (he : IntegralCoverIntertwines e g) (hH : H ≤ levelThree) (hJ : J ≤ levelThree)
    (F : IntegralQuotientL2 H) :
    integralConjugatePullback e g he hH hJ
      (integralConjugatePullback e.symm g⁻¹ (integralCoverIntertwines_inverse e g he) hJ hH F) = F := by
  apply Lp.ext
  have hp := (integralConjugateMap_measurePreserving e g he hH hJ).quasiMeasurePreserving.ae_eq_comp
    (integralConjugatePullback_ae e.symm g⁻¹ (integralCoverIntertwines_inverse e g he) hJ hH F)
  filter_upwards [integralConjugatePullback_ae e g he hH hJ _, hp] with q hq hq'
  dsimp only [Function.comp_def] at hq'
  rw [hq, hq', integralConjugateMap_inverse]

lemma integralConjugatePullback_adjoint {H J : Subgroup (SL(2, O))} (e : H ≃* J)
    (g : SL(2, ℂ)) (he : IntegralCoverIntertwines e g) (hH : H ≤ levelThree) (hJ : J ≤ levelThree)
    (F : IntegralQuotientL2 H) :
    ContinuousLinearMap.adjoint (integralConjugatePullback e g he hH hJ).toContinuousLinearMap F =
      integralConjugatePullback e.symm g⁻¹ (integralCoverIntertwines_inverse e g he) hJ hH F := by
  apply ext_inner_left ℂ
  intro G
  rw [ContinuousLinearMap.adjoint_inner_right]
  calc
    _ = inner ℂ (integralConjugatePullback e g he hH hJ G)
        (integralConjugatePullback e g he hH hJ
          (integralConjugatePullback e.symm g⁻¹ (integralCoverIntertwines_inverse e g he) hJ hH F)) := by
      rw [integralConjugatePullback_inverse]
      rfl
    _ = _ := LinearIsometry.inner_map_map _ _ _

/-- One correspondence leg: lift to a finite cover, then pull back by the conjugating isometry. -/
def kernelCoverLeg {H J : Subgroup (SL(2, O))} (hHK : H ≤ globalKubotaKernel)
    (hJK : J ≤ globalKubotaKernel) [J.IsFiniteRelIndex globalKubotaKernel]
    (e : H ≃* J) (g : SL(2, ℂ)) (he : IntegralCoverIntertwines e g) :
    KernelQuotientL2 →L[ℂ] IntegralQuotientL2 H :=
  (integralConjugatePullback e g he (hHK.trans globalKubotaKernel_le_levelThree)
    (hJK.trans globalKubotaKernel_le_levelThree)).toContinuousLinearMap.comp
      (integralCoverPullback hJK globalKubotaKernel_le_levelThree)

theorem kernelCoverLeg_adjoint {H J : Subgroup (SL(2, O))} (hHK : H ≤ globalKubotaKernel)
    (hJK : J ≤ globalKubotaKernel) [J.IsFiniteRelIndex globalKubotaKernel]
    (e : H ≃* J) (g : SL(2, ℂ)) (he : IntegralCoverIntertwines e g) (D : IntegralQuotientL2 H) :
    ContinuousLinearMap.adjoint (kernelCoverLeg hHK hJK e g he) D =
      integralCoverTrace hJK globalKubotaKernel_le_levelThree
        (integralConjugatePullback e.symm g⁻¹ (integralCoverIntertwines_inverse e g he)
          (hJK.trans globalKubotaKernel_le_levelThree) (hHK.trans globalKubotaKernel_le_levelThree) D) := by
  apply ext_inner_left ℂ
  intro F
  rw [ContinuousLinearMap.adjoint_inner_right, integralCoverTrace,
    ContinuousLinearMap.adjoint_inner_right]
  change inner ℂ ((integralConjugatePullback e g he (hHK.trans globalKubotaKernel_le_levelThree)
    (hJK.trans globalKubotaKernel_le_levelThree)).toContinuousLinearMap
      (integralCoverPullback hJK globalKubotaKernel_le_levelThree F)) D = _
  rw [← ContinuousLinearMap.adjoint_inner_right, integralConjugatePullback_adjoint]

def kernelCoverLegAdjointFunction {H J : Subgroup (SL(2, O))}
    [J.IsFiniteRelIndex globalKubotaKernel] (e : H ≃* J) (g : SL(2, ℂ))
    (he : IntegralCoverIntertwines e g) (f : IntegralOrbitQuotient H → ℂ) : KernelQuotient → ℂ :=
  integralCoverTraceFunction J globalKubotaKernel
    (fun q => f (integralConjugateMap e.symm g⁻¹ (integralCoverIntertwines_inverse e g he) q))

lemma kernelCoverLegAdjointFunction_measurable {H J : Subgroup (SL(2, O))}
    [J.IsFiniteRelIndex globalKubotaKernel] (e : H ≃* J) (g : SL(2, ℂ))
    (he : IntegralCoverIntertwines e g) (f : IntegralOrbitQuotient H → ℂ) (hf : Measurable f) :
    Measurable (kernelCoverLegAdjointFunction e g he f) :=
  integralCoverTraceFunction_measurable J globalKubotaKernel _
    (hf.comp (integralConjugateMap_measurable _ _ _))

theorem kernelCoverLegAdjointFunction_represents {H J : Subgroup (SL(2, O))}
    (hHK : H ≤ globalKubotaKernel) (hJK : J ≤ globalKubotaKernel) [J.IsFiniteRelIndex globalKubotaKernel]
    (e : H ≃* J) (g : SL(2, ℂ)) (he : IntegralCoverIntertwines e g)
    (D : IntegralQuotientL2 H) (f : IntegralOrbitQuotient H → ℂ) (hf : Measurable f)
    (hrep : D =ᵐ[integralQuotientVolume H] f) :
    ContinuousLinearMap.adjoint (kernelCoverLeg hHK hJK e g he) D =ᵐ[integralQuotientVolume globalKubotaKernel]
      kernelCoverLegAdjointFunction e g he f := by
  rw [kernelCoverLeg_adjoint]
  apply integralCoverTrace_representative hJK globalKubotaKernel_le_levelThree _ _
    (hf.comp (integralConjugateMap_measurable _ _ _))
  exact (integralConjugatePullback_ae e.symm g⁻¹ (integralCoverIntertwines_inverse e g he)
    (hJK.trans globalKubotaKernel_le_levelThree) (hHK.trans globalKubotaKernel_le_levelThree) D).trans
      ((integralConjugateMap_measurePreserving e.symm g⁻¹ (integralCoverIntertwines_inverse e g he)
        (hJK.trans globalKubotaKernel_le_levelThree) (hHK.trans globalKubotaKernel_le_levelThree)).quasiMeasurePreserving.ae_eq_comp hrep)

theorem kernelCoverLegAdjointFunction_cusp_decay {H J : Subgroup (SL(2, O))}
    [J.IsFiniteRelIndex globalKubotaKernel] (e : H ≃* J) (g : SL(2, ℂ))
    (he : IntegralCoverIntertwines e g) (f : IntegralOrbitQuotient H → ℂ) (C : ℝ)
    (hdec : ∀ M : SL(2, O), ∀ z : ℂ, ∀ v : ℝ, ∀ hv : 0 < v, 1 < v →
      ‖f (integralOrbitProjection H (g⁻¹ • (integralComplexMatrix M • upperPoint z v hv)))‖ ≤ C / v ^ 3)
    (M : SL(2, O)) (z : ℂ) (v : ℝ) (hv : 0 < v) (hlarge : 1 < v) :
    ‖kernelCoverLegAdjointFunction e g he f
      (integralOrbitProjection globalKubotaKernel (integralComplexMatrix M • upperPoint z v hv))‖ ≤
        (J.relIndex globalKubotaKernel : ℝ) * C / v ^ 3 :=
  integralCoverTraceFunction_integral_cusp_decay J globalKubotaKernel _ C hdec M z v hv hlarge

/-- A primitive first column can be completed while preserving any given matrix congruence. -/
lemma primitiveColumn_congruent_completion {R : Type*} [CommRing R]
    (M : SL(2, R)) (a c r : R) (hac : IsCoprime a c)
    (ha : r ∣ a - M 0 0) (hc : r ∣ c - M 1 0) :
    ∃ N : SL(2, R), N 0 0 = a ∧ N 1 0 = c ∧ ∀ i j, r ∣ N i j - M i j := by
  obtain ⟨x, hx⟩ := ha
  obtain ⟨y, hy⟩ := hc
  obtain ⟨u, v, huv⟩ := hac
  let q := x * M 1 1 - M 0 1 * y
  have hM : M 0 0 * M 1 1 - M 0 1 * M 1 0 = 1 := by
    simpa only [Matrix.det_fin_two] using M.property
  have hdet0 : a * M 1 1 - M 0 1 * c = 1 + r * q := by
    dsimp only [q]
    linear_combination hM + M 1 1 * hx - M 0 1 * hy
  have hdet : a * (M 1 1 - r * q * u) - (M 0 1 + r * q * v) * c = 1 := by
    linear_combination hdet0 - r * q * huv
  let N : SL(2, R) := ⟨!![a, M 0 1 + r * q * v; c, M 1 1 - r * q * u], by
    rw [Matrix.det_fin_two]
    exact hdet⟩
  refine ⟨N, rfl, rfl, ?_⟩
  intro i j
  fin_cases i <;> fin_cases j
  · exact ⟨x, hx⟩
  · exact ⟨q * v, by change M 0 1 + r * q * v - M 0 1 = r * (q * v); ring⟩
  · exact ⟨y, hy⟩
  · exact ⟨-(q * u), by change M 1 1 - r * q * u - M 1 1 = r * -(q * u); ring⟩

lemma integralMatrix_congruent_levelThree (N M : SL(2, O))
    (h : ∀ i j, (3 : O) ∣ N i j - M i j) : N * M⁻¹ ∈ levelThree := by
  let reduction := Matrix.SpecialLinearGroup.map (n := Fin 2) (Ideal.Quotient.mk (Ideal.span {(3 : O)}))
  have he : reduction N = reduction M := by
    apply Subtype.ext
    funext i j
    exact (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr (Ideal.mem_span_singleton.mpr (h i j))
  change reduction (N * M⁻¹) = 1
  rw [map_mul, map_inv, he, mul_inv_cancel]

lemma exists_congruent_cusp_completion (M : SL(2, O)) (a c : O) (hac : IsCoprime a c)
    (ha : (3 : O) ∣ a - M 0 0) (hc : (3 : O) ∣ c - M 1 0) :
    ∃ N : SL(2, O), N 0 0 = a ∧ N 1 0 = c ∧ N * M⁻¹ ∈ levelThree := by
  obtain ⟨N, hN0, hN1, hN⟩ := primitiveColumn_congruent_completion M a c 3 hac ha hc
  exact ⟨N, hN0, hN1, integralMatrix_congruent_levelThree N M hN⟩

lemma integralCoverFiberPoint_continuous (H K : Subgroup (SL(2, O))) (q : IntegralCoverCosets H K) :
    Continuous (integralCoverFiberPoint H K q) := by
  rw [show integralCoverFiberPoint H K q = fun w =>
      integralOrbitProjection H ((integralCoverRep H K q)⁻¹ • w) from
    funext (integralCoverFiberPoint_rep H K q)]
  exact (continuous_integralOrbitProjection H).comp
    (continuous_hyperbolic_action (integralComplexMatrix ((integralCoverRep H K q)⁻¹ : SL(2, O))))

lemma integralCoverMap_fiber {H K : Subgroup (SL(2, O))} (hHK : H ≤ K) (w : HyperbolicSpace) :
    (integralCoverMap hHK) ⁻¹' {integralOrbitProjection K w} =
      Set.range (fun q : IntegralCoverCosets H K => integralCoverFiberPoint H K q w) := by
  ext u
  constructor
  · intro hu
    induction u using Quotient.inductionOn with
    | _ z =>
      have he : integralOrbitProjection K z = integralOrbitProjection K w := hu
      obtain ⟨k, hk⟩ := Quotient.exact he
      refine ⟨(k : IntegralCoverCosets H K), ?_⟩
      change integralCoverFiberPoint H K (k : IntegralCoverCosets H K) w = integralOrbitProjection H z
      rw [integralCoverFiberPoint_mk]
      congr 1
      rw [← hk]
      exact inv_smul_smul k z
  · rintro ⟨q, rfl⟩
    exact integralCoverMap_fiberPoint hHK q w

lemma integralCoverMap_preimage_image {H K : Subgroup (SL(2, O))} (hHK : H ≤ K)
    (S : Set (IntegralOrbitQuotient H)) :
    (integralOrbitProjection K) ⁻¹' (integralCoverMap hHK '' S) =
      ⋃ q : IntegralCoverCosets H K, (integralCoverFiberPoint H K q) ⁻¹' S := by
  ext w
  constructor
  · rintro ⟨u, hu, huw⟩
    have hh : u ∈ (integralCoverMap hHK) ⁻¹' {integralOrbitProjection K w} := huw
    rw [integralCoverMap_fiber hHK w] at hh
    obtain ⟨q, rfl⟩ := hh
    exact Set.mem_iUnion.mpr ⟨q, hu⟩
  · intro hw
    obtain ⟨q, hq⟩ := Set.mem_iUnion.mp hw
    exact ⟨integralCoverFiberPoint H K q w, hq, integralCoverMap_fiberPoint hHK q w⟩

theorem integralCoverMap_isClosedMap {H K : Subgroup (SL(2, O))} (hHK : H ≤ K)
    [H.IsFiniteRelIndex K] : IsClosedMap (integralCoverMap hHK) := by
  letI : Fintype (IntegralCoverCosets H K) := Fintype.ofFinite _
  intro S hS
  have hq : Topology.IsQuotientMap (integralOrbitProjection K) := isQuotientMap_quotient_mk'
  apply hq.isCoinducing.isClosed_preimage.mp
  rw [integralCoverMap_preimage_image]
  exact isClosed_iUnion_of_finite (fun q => hS.preimage (integralCoverFiberPoint_continuous H K q))

theorem integralCoverMap_isProperMap {H K : Subgroup (SL(2, O))} (hHK : H ≤ K)
    [H.IsFiniteRelIndex K] : IsProperMap (integralCoverMap hHK) := by
  letI : Fintype (IntegralCoverCosets H K) := Fintype.ofFinite _
  apply isProperMap_iff_isClosedMap_and_compact_fibers.mpr
  refine ⟨integralCoverMap_continuous hHK, integralCoverMap_isClosedMap hHK, ?_⟩
  intro q
  induction q using Quotient.inductionOn with
  | _ w =>
    change IsCompact ((integralCoverMap hHK) ⁻¹' {integralOrbitProjection K w})
    rw [integralCoverMap_fiber hHK w]
    exact (Set.finite_range _).isCompact

lemma integralCoverMap_hasCompactSupport {H K : Subgroup (SL(2, O))} (hHK : H ≤ K)
    [H.IsFiniteRelIndex K] (f : IntegralOrbitQuotient K → ℂ) (hf : HasCompactSupport f) :
    HasCompactSupport (fun q => f (integralCoverMap hHK q)) := by
  apply HasCompactSupport.of_support_subset_isCompact
    ((integralCoverMap_isProperMap hHK).isCompact_preimage hf.isCompact)
  intro q hq
  exact subset_tsupport f hq

lemma integralCoverTraceFunction_hasCompactSupport {H K : Subgroup (SL(2, O))} (hHK : H ≤ K)
    [H.IsFiniteRelIndex K] (f : IntegralOrbitQuotient H → ℂ) (hf : HasCompactSupport f) :
    HasCompactSupport (integralCoverTraceFunction H K f) := by
  letI : Fintype (IntegralCoverCosets H K) := Fintype.ofFinite _
  apply HasCompactSupport.of_support_subset_isCompact (hf.isCompact.image (integralCoverMap_continuous hHK))
  intro q hq
  induction q using Quotient.inductionOn with
  | _ w =>
    change (∑ r : IntegralCoverCosets H K, f (integralCoverFiberPoint H K r w)) ≠ 0 at hq
    obtain ⟨r, _, hr⟩ := Finset.exists_ne_zero_of_sum_ne_zero hq
    exact ⟨integralCoverFiberPoint H K r w, subset_tsupport f hr, integralCoverMap_fiberPoint hHK r w⟩

section CorrespondenceTests
variable {H J : Subgroup (SL(2, O))}
    (hHK : H ≤ globalKubotaKernel) (hJK : J ≤ globalKubotaKernel)
    [H.IsFiniteRelIndex globalKubotaKernel] [J.IsFiniteRelIndex globalKubotaKernel]
    (e : H ≃* J) (g : SL(2, ℂ)) (he : IntegralCoverIntertwines e g)

def kernelCorrespondenceFunction (f : KernelQuotient → ℂ) : KernelQuotient → ℂ :=
  integralCoverTraceFunction H globalKubotaKernel
    (fun q => f (integralCoverMap hJK (integralConjugateMap e g he q)))

omit [J.IsFiniteRelIndex globalKubotaKernel] in
lemma kernelCorrespondenceFunction_lift (f : KernelQuotient → ℂ) (w : HyperbolicSpace) :
    kernelCorrespondenceFunction hJK e g he f (integralOrbitProjection globalKubotaKernel w) =
      letI : Fintype (IntegralCoverCosets H globalKubotaKernel) := Fintype.ofFinite _
      ∑ q : IntegralCoverCosets H globalKubotaKernel,
        f (integralOrbitProjection globalKubotaKernel
          ((g * integralComplexMatrix (((integralCoverRep H globalKubotaKernel q)⁻¹ : globalKubotaKernel) : SL(2, O))) • w)) := by
  letI : Fintype (IntegralCoverCosets H globalKubotaKernel) := Fintype.ofFinite _
  change (∑ q : IntegralCoverCosets H globalKubotaKernel, f (integralCoverMap hJK
    (integralConjugateMap e g he (integralCoverFiberPoint H globalKubotaKernel q w)))) = _
  apply Finset.sum_congr rfl
  intro q _
  rw [integralCoverFiberPoint_rep, integralSubgroup_smul,
    integralConjugateMap_projection, integralCoverMap_projection, mul_smul]

include hHK in
lemma kernelCorrespondenceFunction_hasCompactSupport (f : KernelQuotient → ℂ)
    (hf : HasCompactSupport f) : HasCompactSupport (kernelCorrespondenceFunction hJK e g he f) := by
  apply integralCoverTraceFunction_hasCompactSupport hHK
  exact (integralCoverMap_hasCompactSupport hJK f hf).comp_homeomorph (integralConjugateHomeomorph e g he)

omit [J.IsFiniteRelIndex globalKubotaKernel] in
lemma kernelCorrespondenceFunction_contMDiff (f : KernelQuotient → ℂ)
    (hf : ContMDiff 𝓘(ℝ, SpatialCoordinates) 𝓘(ℝ, ℂ) ∞ f) :
    ContMDiff 𝓘(ℝ, SpatialCoordinates) 𝓘(ℝ, ℂ) ∞ (kernelCorrespondenceFunction hJK e g he f) := by
  letI : Fintype (IntegralCoverCosets H globalKubotaKernel) := Fintype.ofFinite _
  apply kernel_contMDiff_of_lift
  simp_rw [kernelCorrespondenceFunction_lift]
  apply ContMDiff.sum
  intro q _
  exact (hf.comp kernelProjection_contMDiff).comp
    (hyperbolicAction_contMDiff (g * integralComplexMatrix
      (((integralCoverRep H globalKubotaKernel q)⁻¹ : globalKubotaKernel) : SL(2, O))))

def kernelCorrespondenceTest (f : kernelSmoothTests) : kernelSmoothTests :=
  ⟨kernelCorrespondenceFunction hJK e g he f.1,
    kernelCorrespondenceFunction_contMDiff hJK e g he f.1 f.2.1,
    kernelCorrespondenceFunction_hasCompactSupport hHK hJK e g he f.1 f.2.2⟩

end CorrespondenceTests

lemma integralCoverMap_quasiMeasurePreserving {H K : Subgroup (SL(2, O))}
    (hHK : H ≤ K) (hK : K ≤ levelThree) [H.IsFiniteRelIndex K] :
    Measure.QuasiMeasurePreserving (integralCoverMap hHK) (integralQuotientVolume H) (integralQuotientVolume K) := by
  refine ⟨integralCoverMap_measurable hHK, ?_⟩
  rw [integralCoverMap_measure hHK hK]
  exact Measure.smul_absolutelyContinuous

lemma integralCoverTraceFunction_integrable {H K : Subgroup (SL(2, O))} (hHK : H ≤ K)
    (hK : K ≤ levelThree) [H.IsFiniteRelIndex K] (f : IntegralOrbitQuotient H → ℂ)
    (hmeas : Measurable f) (hf : Integrable f (integralQuotientVolume H)) :
    Integrable (integralCoverTraceFunction H K f) (integralQuotientVolume K) := by
  letI : Fintype (IntegralCoverCosets H K) := Fintype.ofFinite _
  apply ((quotient_projection_measurePreserving K).integrable_comp
    (integralCoverTraceFunction_measurable H K f hmeas).aestronglyMeasurable).mp
  change Integrable (fun w => ∑ q : IntegralCoverCosets H K, f (integralCoverFiberPoint H K q w)) _
  exact integrable_finsetSum Finset.univ (fun q _ => integralCoverFiber_integrable hHK hK f hmeas hf q)

lemma integralCoverPullback_norm_le {H K : Subgroup (SL(2, O))} (hHK : H ≤ K)
    (hK : K ≤ levelThree) [H.IsFiniteRelIndex K] (F : IntegralQuotientL2 K) :
    ‖integralCoverPullback hHK hK F‖ ≤ (H.relIndex K : ℝ) ^ ((1 : ℝ) / 2) * ‖F‖ := by
  change ‖Lp.compMeasurePreserving (integralCoverMap hHK) (integralCoverMap_measurePreserving hHK hK)
    (dominatedComplexL2 (by simp : (H.relIndex K : ℝ≥0∞) ≠ ⊤) le_rfl F)‖ ≤ _
  rw [Lp.norm_compMeasurePreserving]
  simpa only [ENNReal.toReal_natCast] using dominatedComplexL2_norm_le
    (by simp : (H.relIndex K : ℝ≥0∞) ≠ ⊤)
    (le_rfl : (H.relIndex K : ℝ≥0∞) • integralQuotientVolume K ≤
      (H.relIndex K : ℝ≥0∞) • integralQuotientVolume K) F

lemma integralCoverTrace_opNorm_le {H K : Subgroup (SL(2, O))} (hHK : H ≤ K)
    (hK : K ≤ levelThree) [H.IsFiniteRelIndex K] :
    ‖integralCoverTrace hHK hK‖ ≤ (H.relIndex K : ℝ) ^ ((1 : ℝ) / 2) := by
  rw [integralCoverTrace, ContinuousLinearMap.adjoint.norm_map]
  exact ContinuousLinearMap.opNorm_le_bound _ (Real.rpow_nonneg (Nat.cast_nonneg _) _)
    (integralCoverPullback_norm_le hHK hK)

section CorrespondenceOperators
variable {H J : Subgroup (SL(2, O))}
    (hHK : H ≤ globalKubotaKernel) (hJK : J ≤ globalKubotaKernel)
    [H.IsFiniteRelIndex globalKubotaKernel] [J.IsFiniteRelIndex globalKubotaKernel]
    (e : H ≃* J) (g : SL(2, ℂ)) (he : IntegralCoverIntertwines e g)

def kernelCorrespondenceL2 : KernelQuotientL2 →L[ℂ] KernelQuotientL2 :=
  (integralCoverTrace hHK globalKubotaKernel_le_levelThree).comp (kernelCoverLeg hHK hJK e g he)

lemma kernelCorrespondenceL2_representative (F : KernelQuotientL2) (f : KernelQuotient → ℂ)
    (hf : Measurable f) (hrep : F =ᵐ[integralQuotientVolume globalKubotaKernel] f) :
    kernelCorrespondenceL2 hHK hJK e g he F =ᵐ[integralQuotientVolume globalKubotaKernel]
      kernelCorrespondenceFunction hJK e g he f := by
  have hcover := (integralCoverPullback_ae hJK globalKubotaKernel_le_levelThree F).trans
    ((integralCoverMap_quasiMeasurePreserving hJK globalKubotaKernel_le_levelThree).ae_eq_comp hrep)
  have hconj := (integralConjugatePullback_ae e g he
    (hHK.trans globalKubotaKernel_le_levelThree) (hJK.trans globalKubotaKernel_le_levelThree) _).trans
    ((integralConjugateMap_measurePreserving e g he
      (hHK.trans globalKubotaKernel_le_levelThree) (hJK.trans globalKubotaKernel_le_levelThree)).quasiMeasurePreserving.ae_eq_comp hcover)
  exact integralCoverTrace_representative hHK globalKubotaKernel_le_levelThree _ _
    ((hf.comp (integralCoverMap_measurable hJK)).comp (integralConjugateMap_measurable e g he)) hconj

lemma kernelCorrespondenceTest_mass (f : kernelSmoothTests) :
    kernelSmoothTestsToL2 (kernelCorrespondenceTest hHK hJK e g he f) =
      kernelCorrespondenceL2 hHK hJK e g he (kernelSmoothTestsToL2 f) := by
  apply Lp.ext
  exact (kernelSmoothTests_memLp (kernelCorrespondenceTest hHK hJK e g he f)).coeFn_toLp.trans
    (kernelCorrespondenceL2_representative hHK hJK e g he _ f.1
      f.2.1.continuous.measurable (kernelSmoothTests_memLp f).coeFn_toLp).symm

lemma kernelCorrespondenceL2_pairing (F G : KernelQuotientL2) :
    inner ℂ (kernelCorrespondenceL2 hHK hJK e g he F) G =
      inner ℂ F (kernelCorrespondenceL2 hJK hHK e.symm g⁻¹ (integralCoverIntertwines_inverse e g he) G) := by
  change inner ℂ ((integralCoverTrace hHK globalKubotaKernel_le_levelThree)
    ((integralConjugatePullback e g he (hHK.trans globalKubotaKernel_le_levelThree)
      (hJK.trans globalKubotaKernel_le_levelThree)).toContinuousLinearMap
        (integralCoverPullback hJK globalKubotaKernel_le_levelThree F))) G = _
  rw [integralCoverTrace, ContinuousLinearMap.adjoint_inner_left,
    ← ContinuousLinearMap.adjoint_inner_right, integralConjugatePullback_adjoint]
  exact (ContinuousLinearMap.adjoint_inner_right _ _ _).symm

lemma kernelCorrespondenceL2_norm_le (F : KernelQuotientL2) :
    ‖kernelCorrespondenceL2 hHK hJK e g he F‖ ≤
      Real.sqrt ((H.relIndex globalKubotaKernel : ℝ) * (J.relIndex globalKubotaKernel : ℝ)) * ‖F‖ := by
  let C := integralConjugatePullback e g he
    (hHK.trans globalKubotaKernel_le_levelThree) (hJK.trans globalKubotaKernel_le_levelThree)
  let P := integralCoverPullback hJK globalKubotaKernel_le_levelThree
  let Tr := integralCoverTrace hHK globalKubotaKernel_le_levelThree
  have hTr := integralCoverTrace_opNorm_le hHK globalKubotaKernel_le_levelThree
  have hP := integralCoverPullback_norm_le hJK globalKubotaKernel_le_levelThree F
  rw [← Real.sqrt_eq_rpow] at hTr hP
  change ‖Tr (C (P F))‖ ≤ _
  calc
    _ ≤ ‖Tr‖ * ‖C (P F)‖ := Tr.le_opNorm _
    _ ≤ Real.sqrt (H.relIndex globalKubotaKernel : ℝ) * ‖C (P F)‖ :=
      mul_le_mul_of_nonneg_right hTr (norm_nonneg _)
    _ = Real.sqrt (H.relIndex globalKubotaKernel : ℝ) * ‖P F‖ := by rw [C.norm_map]
    _ ≤ Real.sqrt (H.relIndex globalKubotaKernel : ℝ) *
        (Real.sqrt (J.relIndex globalKubotaKernel : ℝ) * ‖F‖) :=
      mul_le_mul_of_nonneg_left hP (Real.sqrt_nonneg _)
    _ = _ := by rw [Real.sqrt_mul (Nat.cast_nonneg _)]; ring

include hHK in
lemma kernelCorrespondenceFunction_integrable (f : KernelQuotient → ℂ) (hf : Measurable f)
    (hi : Integrable f (integralQuotientVolume globalKubotaKernel)) :
    Integrable (kernelCorrespondenceFunction hJK e g he f) (integralQuotientVolume globalKubotaKernel) := by
  have hcover := (integralCoverMap_measurePreserving hJK globalKubotaKernel_le_levelThree).integrable_comp_of_integrable
    (hi.smul_measure (c := (J.relIndex globalKubotaKernel : ℝ≥0∞)) (by simp))
  have hconj := (integralConjugateMap_measurePreserving e g he
    (hHK.trans globalKubotaKernel_le_levelThree) (hJK.trans globalKubotaKernel_le_levelThree)).integrable_comp_of_integrable hcover
  exact integralCoverTraceFunction_integrable hHK globalKubotaKernel_le_levelThree _
    ((hf.comp (integralCoverMap_measurable hJK)).comp (integralConjugateMap_measurable e g he)) hconj

include hHK in
lemma kernelCorrespondenceFunction_integral (f : KernelQuotient → ℂ) (hf : Measurable f)
    (hi : Integrable f (integralQuotientVolume globalKubotaKernel)) :
    (∫ q, kernelCorrespondenceFunction hJK e g he f q ∂integralQuotientVolume globalKubotaKernel) =
      (J.relIndex globalKubotaKernel : ℂ) * ∫ q, f q ∂integralQuotientVolume globalKubotaKernel := by
  have hcover := (integralCoverMap_measurePreserving hJK globalKubotaKernel_le_levelThree).integrable_comp_of_integrable
    (hi.smul_measure (c := (J.relIndex globalKubotaKernel : ℝ≥0∞)) (by simp))
  have hm := integralConjugateMap_measurePreserving e g he
    (hHK.trans globalKubotaKernel_le_levelThree) (hJK.trans globalKubotaKernel_le_levelThree)
  have hconj := hm.integrable_comp_of_integrable hcover
  calc
    _ = ∫ q, f (integralCoverMap hJK (integralConjugateMap e g he q)) ∂integralQuotientVolume H :=
      integralCoverTraceFunction_integral hHK globalKubotaKernel_le_levelThree _
        ((hf.comp (integralCoverMap_measurable hJK)).comp (integralConjugateMap_measurable e g he)) hconj
    _ = ∫ q, f (integralCoverMap hJK q) ∂integralQuotientVolume J := by
      have hh := integral_map (μ := integralQuotientVolume H) hm.measurable.aemeasurable
        (hf.comp (integralCoverMap_measurable hJK)).aestronglyMeasurable
      rw [hm.map_eq] at hh
      exact hh.symm
    _ = ∫ q, f q ∂Measure.map (integralCoverMap hJK) (integralQuotientVolume J) :=
      (integral_map (integralCoverMap_measurable hJK).aemeasurable hf.aestronglyMeasurable).symm
    _ = _ := by
      rw [integralCoverMap_measure hJK globalKubotaKernel_le_levelThree, integral_smul_measure]
      simp only [ENNReal.toReal_natCast, Complex.real_smul, Complex.ofReal_natCast]

end CorrespondenceOperators

/-- Hyperbolic energy of a complex field in upper-half-space coordinates. -/
def coverEnergyDensity (F : EuclideanSpatial → ℂ) (p : EuclideanSpatial) : ℝ :=
  euclideanScalarDirichletDensity (fun x => (F x).re) p +
    euclideanScalarDirichletDensity (fun x => (F x).im) p

def coverGradientAt (F : EuclideanSpatial → ℂ) (p : EuclideanSpatial) : EuclideanSpace ℂ (Fin 3) :=
  WithLp.toLp 2 (fun j => (p 2 : ℂ) * fderiv ℝ F p (EuclideanSpace.basisFun (Fin 3) ℝ j))

lemma coverGradientAt_norm_sq (F : EuclideanSpatial → ℂ) (p : EuclideanSpatial)
    (hF : DifferentiableAt ℝ F p) : ‖coverGradientAt F p‖ ^ 2 = coverEnergyDensity F p := by
  have hr := (Complex.reCLM.hasFDerivAt.comp p hF.hasFDerivAt).fderiv
  have hi := (Complex.imCLM.hasFDerivAt.comp p hF.hasFDerivAt).fderiv
  change fderiv ℝ (fun x => (F x).re) p = _ at hr
  change fderiv ℝ (fun x => (F x).im) p = _ at hi
  unfold coverEnergyDensity euclideanScalarDirichletDensity
  rw [hr, hi, (EuclideanSpace.basisFun (Fin 3) ℝ).norm_dual,
    (EuclideanSpace.basisFun (Fin 3) ℝ).norm_dual, ← mul_add, ← Finset.sum_add_distrib,
    PiLp.norm_sq_eq_of_L2]
  change (∑ j : Fin 3, ‖(p 2 : ℂ) * fderiv ℝ F p (EuclideanSpace.basisFun (Fin 3) ℝ j)‖ ^ 2) = _
  simp only [norm_mul, mul_pow, Complex.norm_real, Real.norm_eq_abs, sq_abs, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j _
  congr 1
  change ‖fderiv ℝ F p (EuclideanSpace.basisFun (Fin 3) ℝ j)‖ ^ 2 =
    (fderiv ℝ F p (EuclideanSpace.basisFun (Fin 3) ℝ j)).re ^ 2 +
      (fderiv ℝ F p (EuclideanSpace.basisFun (Fin 3) ℝ j)).im ^ 2
  simpa only [Complex.normSq_apply, pow_two] using
    (Complex.normSq_eq_norm_sq (fderiv ℝ F p (EuclideanSpace.basisFun (Fin 3) ℝ j))).symm

lemma coverEnergyDensity_comp (g : SL(2, ℂ)) (F : EuclideanSpatial → ℂ)
    (p : EuclideanSpatial) (hp : 0 < p 2) (hF : DifferentiableAt ℝ F (euclideanAction g p)) :
    coverEnergyDensity (F ∘ euclideanAction g) p = coverEnergyDensity F (euclideanAction g p) :=
  congrArg₂ (fun x y : ℝ => x + y)
    (hyperbolic_cotangent_energy_comp g (fun p => (F p).re) p hp (Complex.reCLM.differentiableAt.comp _ hF))
    (hyperbolic_cotangent_energy_comp g (fun p => (F p).im) p hp (Complex.imCLM.differentiableAt.comp _ hF))

lemma coverGradientAt_sum {ι : Type*} (s : Finset ι) (F : ι → EuclideanSpatial → ℂ)
    (p : EuclideanSpatial) (hF : ∀ i ∈ s, DifferentiableAt ℝ (F i) p) :
    coverGradientAt (fun x => ∑ i ∈ s, F i x) p = ∑ i ∈ s, coverGradientAt (F i) p := by
  apply (WithLp.equiv 2 (Fin 3 → ℂ)).injective
  funext j
  simp only [coverGradientAt, fderiv_fun_sum hF, _root_.sum_apply,
    WithLp.equiv_apply, Finset.mul_sum, WithLp.ofLp_sum, Finset.sum_apply]

lemma cover_norm_sum_sq_le_card {ι E : Type*} [NormedAddCommGroup E] (s : Finset ι) (f : ι → E) :
    ‖∑ i ∈ s, f i‖ ^ 2 ≤ (s.card : ℝ) * ∑ i ∈ s, ‖f i‖ ^ 2 := by
  calc
    _ ≤ (∑ i ∈ s, ‖f i‖) ^ 2 :=
      (sq_le_sq₀ (norm_nonneg _) (Finset.sum_nonneg (fun _ _ => norm_nonneg _))).mpr (norm_sum_le _ _)
    _ ≤ _ := by
      simpa only [one_mul, one_pow, Finset.sum_const, nsmul_eq_mul, mul_one] using
        Finset.sum_mul_sq_le_sq_mul_sq s (fun _ => (1 : ℝ)) (fun i => ‖f i‖)

lemma coverEnergyDensity_sum_le {ι : Type*} (s : Finset ι) (F : ι → EuclideanSpatial → ℂ)
    (p : EuclideanSpatial) (hF : ∀ i ∈ s, DifferentiableAt ℝ (F i) p) :
    coverEnergyDensity (fun x => ∑ i ∈ s, F i x) p ≤ (s.card : ℝ) * ∑ i ∈ s, coverEnergyDensity (F i) p := by
  rw [← coverGradientAt_norm_sq _ _ (DifferentiableAt.fun_sum hF), coverGradientAt_sum s F p hF]
  calc
    _ ≤ (s.card : ℝ) * ∑ i ∈ s, ‖coverGradientAt (F i) p‖ ^ 2 :=
      cover_norm_sum_sq_le_card s (fun i => coverGradientAt (F i) p)
    _ = _ := by
      congr 1
      apply Finset.sum_congr rfl
      intro i hi
      exact coverGradientAt_norm_sq (F i) p (hF i hi)

lemma coverGradientAt_add (F G : EuclideanSpatial → ℂ) (p : EuclideanSpatial)
    (hF : DifferentiableAt ℝ F p) (hG : DifferentiableAt ℝ G p) :
    coverGradientAt (F + G) p = coverGradientAt F p + coverGradientAt G p := by
  apply (WithLp.equiv 2 (Fin 3 → ℂ)).injective
  funext j
  simp only [coverGradientAt, fderiv_add hF hG, WithLp.equiv_apply, WithLp.ofLp_add,
    Pi.add_apply, _root_.add_apply, mul_add]

lemma coverGradientAt_sub (F G : EuclideanSpatial → ℂ) (p : EuclideanSpatial)
    (hF : DifferentiableAt ℝ F p) (hG : DifferentiableAt ℝ G p) :
    coverGradientAt (F - G) p = coverGradientAt F p - coverGradientAt G p := by
  apply (WithLp.equiv 2 (Fin 3 → ℂ)).injective
  funext j
  simp only [coverGradientAt, fderiv_sub hF hG, WithLp.equiv_apply, WithLp.ofLp_sub,
    Pi.sub_apply, _root_.sub_apply, mul_sub]

lemma coverGradientAt_smul (c : ℂ) (F : EuclideanSpatial → ℂ) (p : EuclideanSpatial)
    (hF : DifferentiableAt ℝ F p) : coverGradientAt (c • F) p = c • coverGradientAt F p := by
  apply (WithLp.equiv 2 (Fin 3 → ℂ)).injective
  funext j
  simp only [coverGradientAt, fderiv_const_smul hF, WithLp.equiv_apply, WithLp.ofLp_smul,
    Pi.smul_apply, _root_.smul_apply, smul_eq_mul, mul_left_comm]

def coverDirichletPair (F G : EuclideanSpatial → ℂ) (p : EuclideanSpatial) : ℂ :=
  inner ℂ (coverGradientAt F p) (coverGradientAt G p)

lemma coverDirichletPair_polarization (F G : EuclideanSpatial → ℂ) (p : EuclideanSpatial)
    (hF : DifferentiableAt ℝ F p) (hG : DifferentiableAt ℝ G p) :
    coverDirichletPair F G p = ((coverEnergyDensity (F + G) p : ℂ) - (coverEnergyDensity (F - G) p : ℂ) +
      ((coverEnergyDensity (F - Complex.I • G) p : ℂ) - (coverEnergyDensity (F + Complex.I • G) p : ℂ)) * Complex.I) / 4 := by
  unfold coverDirichletPair
  rw [inner_eq_sum_norm_sq_div_four]
  simp only [RCLike.I_to_complex]
  rw [← coverGradientAt_add F G p hF hG, ← coverGradientAt_sub F G p hF hG,
    ← coverGradientAt_smul Complex.I G p hG,
    ← coverGradientAt_sub F (Complex.I • G) p hF (hG.const_smul _),
    ← coverGradientAt_add F (Complex.I • G) p hF (hG.const_smul _)]
  simp only [RCLike.ofReal_eq_complex_ofReal, ← Complex.ofReal_pow,
    coverGradientAt_norm_sq _ _ (hF.add hG), coverGradientAt_norm_sq _ _ (hF.sub hG),
    coverGradientAt_norm_sq _ _ (hF.sub (hG.const_smul _)), coverGradientAt_norm_sq _ _ (hF.add (hG.const_smul _))]

/-- Polarization transfers isometry invariance of scalar energy to the complex Dirichlet pairing. -/
lemma coverDirichletPair_comp (g : SL(2, ℂ)) (F G : EuclideanSpatial → ℂ)
    (p : EuclideanSpatial) (hp : 0 < p 2)
    (hF : DifferentiableAt ℝ F (euclideanAction g p)) (hG : DifferentiableAt ℝ G (euclideanAction g p)) :
    coverDirichletPair (F ∘ euclideanAction g) (G ∘ euclideanAction g) p =
      coverDirichletPair F G (euclideanAction g p) := by
  obtain ⟨der, hder, _⟩ := hyperbolicDifferentialIsometry g p hp
  rw [coverDirichletPair_polarization _ _ p (hF.comp p hder.differentiableAt) (hG.comp p hder.differentiableAt),
    coverDirichletPair_polarization F G _ hF hG]
  have ha : (F ∘ euclideanAction g) + (G ∘ euclideanAction g) = (F + G) ∘ euclideanAction g := rfl
  have hs : (F ∘ euclideanAction g) - (G ∘ euclideanAction g) = (F - G) ∘ euclideanAction g := rfl
  have hai : (F ∘ euclideanAction g) + Complex.I • (G ∘ euclideanAction g) = (F + Complex.I • G) ∘ euclideanAction g := rfl
  have hsi : (F ∘ euclideanAction g) - Complex.I • (G ∘ euclideanAction g) = (F - Complex.I • G) ∘ euclideanAction g := rfl
  rw [ha, hs, hai, hsi, coverEnergyDensity_comp g _ p hp (hF.add hG),
    coverEnergyDensity_comp g _ p hp (hF.sub hG), coverEnergyDensity_comp g _ p hp (hF.add (hG.const_smul _)),
    coverEnergyDensity_comp g _ p hp (hF.sub (hG.const_smul _))]

lemma coverDirichletPair_sum_right {ι : Type*} (s : Finset ι) (F : EuclideanSpatial → ℂ)
    (G : ι → EuclideanSpatial → ℂ) (p : EuclideanSpatial) (hG : ∀ i ∈ s, DifferentiableAt ℝ (G i) p) :
    coverDirichletPair F (fun x => ∑ i ∈ s, G i x) p = ∑ i ∈ s, coverDirichletPair F (G i) p := by
  simp only [coverDirichletPair, coverGradientAt_sum s G p hG, inner_sum]

lemma coverDirichletPair_norm_le (F G : EuclideanSpatial → ℂ) (p : EuclideanSpatial)
    (hF : DifferentiableAt ℝ F p) (hG : DifferentiableAt ℝ G p) :
    ‖coverDirichletPair F G p‖ ≤ (coverEnergyDensity F p + coverEnergyDensity G p) / 2 := by
  have hh := norm_inner_le_norm (𝕜 := ℂ) (coverGradientAt F p) (coverGradientAt G p)
  have hs := sq_nonneg (‖coverGradientAt F p‖ - ‖coverGradientAt G p‖)
  rw [← coverGradientAt_norm_sq F p hF, ← coverGradientAt_norm_sq G p hG]
  exact le_trans hh (by nlinarith only [hs])

lemma kernelDirichletPairDensity_eq_cover (f h : kernelSmoothTests) (w : HyperbolicSpace) :
    kernelDirichletPairDensity f h (integralOrbitProjection globalKubotaKernel w) =
      coverDirichletPair (kernelTestField f) (kernelTestField h) (hyperbolicEuclideanCoordinates w) := by
  rw [kernelDirichletPairDensity_coordinate]
  rfl

lemma kernelTestEnergyDensity_eq_cover (f : kernelSmoothTests) (w : HyperbolicSpace) :
    kernelTestEnergyDensity f w = coverEnergyDensity (kernelTestField f) (hyperbolicEuclideanCoordinates w) := rfl

lemma kernelTestField_comp_contDiffAt (f : kernelSmoothTests) (g : SL(2, ℂ))
    (p : EuclideanSpatial) (hp : 0 < p 2) :
    ContDiffAt ℝ ∞ (kernelTestField f ∘ euclideanAction g) p := by
  have hd := ((((f.2.1.comp kernelProjection_contMDiff).comp (hyperbolicAction_contMDiff g))
    (euclideanToHyperbolic p)).comp p (euclideanToHyperbolic_contMDiffAt p hp)).contDiffAt
  simpa only [Function.comp_def, kernelTestField, euclideanAction, euclideanToHyperbolic_coordinates] using hd

section CorrespondenceEnergy
variable {H J : Subgroup (SL(2, O))}
    (hHK : H ≤ globalKubotaKernel) (hJK : J ≤ globalKubotaKernel)
    [H.IsFiniteRelIndex globalKubotaKernel] [J.IsFiniteRelIndex globalKubotaKernel]
    (e : H ≃* J) (g : SL(2, ℂ)) (he : IntegralCoverIntertwines e g)

def kernelCorrespondenceMatrix (q : IntegralCoverCosets H globalKubotaKernel) : SL(2, ℂ) :=
  g * integralComplexMatrix (((integralCoverRep H globalKubotaKernel q)⁻¹ : globalKubotaKernel) : SL(2, O))

lemma kernelCorrespondenceTest_field (f : kernelSmoothTests) (p : EuclideanSpatial) :
    kernelTestField (kernelCorrespondenceTest hHK hJK e g he f) p =
      letI : Fintype (IntegralCoverCosets H globalKubotaKernel) := Fintype.ofFinite _
      ∑ q : IntegralCoverCosets H globalKubotaKernel,
        kernelTestField f (euclideanAction (kernelCorrespondenceMatrix g q) p) := by
  letI : Fintype (IntegralCoverCosets H globalKubotaKernel) := Fintype.ofFinite _
  change kernelCorrespondenceFunction hJK e g he f.1
    (integralOrbitProjection globalKubotaKernel (euclideanToHyperbolic p)) = _
  rw [kernelCorrespondenceFunction_lift]
  apply Finset.sum_congr rfl
  intro q _
  change f.1 (integralOrbitProjection globalKubotaKernel
    (kernelCorrespondenceMatrix g q • euclideanToHyperbolic p)) =
      f.1 (integralOrbitProjection globalKubotaKernel
        (euclideanToHyperbolic (euclideanAction (kernelCorrespondenceMatrix g q) p)))
  rw [euclideanAction, euclideanToHyperbolic_coordinates]

/-- Cauchy–Schwarz on the finite fiber bounds the energy of a trace. -/
lemma kernelCorrespondenceTest_energyDensity_le (f : kernelSmoothTests) (w : HyperbolicSpace) :
    kernelTestEnergyDensity (kernelCorrespondenceTest hHK hJK e g he f) w ≤
      (H.relIndex globalKubotaKernel : ℝ) *
        (kernelCorrespondenceFunction hJK e g he (fun q => (kernelQuotientEnergyDensity f q : ℂ))
          (integralOrbitProjection globalKubotaKernel w)).re := by
  letI : Fintype (IntegralCoverCosets H globalKubotaKernel) := Fintype.ofFinite _
  let p := hyperbolicEuclideanCoordinates w
  let A := kernelCorrespondenceMatrix (H := H) g
  have hd (q : IntegralCoverCosets H globalKubotaKernel) :
      DifferentiableAt ℝ (kernelTestField f) (euclideanAction (A q) p) :=
    (kernelTestField_contDiffAt f _ (euclideanAction_positive _ _)).differentiableAt (by simp)
  have hc (q : IntegralCoverCosets H globalKubotaKernel) :
      DifferentiableAt ℝ (kernelTestField f ∘ euclideanAction (A q)) p :=
    (kernelTestField_comp_contDiffAt f (A q) p (hyperbolicHeight_pos w)).differentiableAt (by simp)
  have hfield := funext (kernelCorrespondenceTest_field hHK hJK e g he f)
  rw [kernelTestEnergyDensity_eq_cover, hfield]
  change coverEnergyDensity (fun p => ∑ q : IntegralCoverCosets H globalKubotaKernel,
    kernelTestField f (euclideanAction (A q) p)) p ≤ _
  calc
    _ ≤ (Fintype.card (IntegralCoverCosets H globalKubotaKernel) : ℝ) *
        ∑ q : IntegralCoverCosets H globalKubotaKernel,
          coverEnergyDensity (kernelTestField f ∘ euclideanAction (A q)) p := by
      simpa only [Finset.card_univ, Function.comp_def] using
        coverEnergyDensity_sum_le Finset.univ
          (fun q : IntegralCoverCosets H globalKubotaKernel => kernelTestField f ∘ euclideanAction (A q))
          p (fun q _ => hc q)
    _ = _ := by
      have hcard : Fintype.card (IntegralCoverCosets H globalKubotaKernel) = H.relIndex globalKubotaKernel := by
        rw [Subgroup.relIndex, Subgroup.index, Nat.card_eq_fintype_card]
      rw [hcard, kernelCorrespondenceFunction_lift]
      simp only [Complex.re_sum, Complex.ofReal_re]
      congr 1
      apply Finset.sum_congr rfl
      intro q _
      rw [coverEnergyDensity_comp (A q) _ p (hyperbolicHeight_pos w) (hd q)]
      change coverEnergyDensity (kernelTestField f) (euclideanAction (A q) p) = kernelTestEnergyDensity f (A q • w)
      rw [kernelTestEnergyDensity_eq_cover]
      congr 1
      dsimp [p, euclideanAction]
      rw [euclideanToHyperbolic_coordinates]

lemma kernelCorrespondenceTest_energy_le (f : kernelSmoothTests) :
    kernelDirichletEnergy (kernelCorrespondenceTest hHK hJK e g he f) ≤
      (H.relIndex globalKubotaKernel : ℝ) * (J.relIndex globalKubotaKernel : ℝ) * kernelDirichletEnergy f := by
  let density : KernelQuotient → ℂ := fun q => (kernelQuotientEnergyDensity f q : ℂ)
  have hm : Measurable density := Complex.continuous_ofReal.measurable.comp
    (kernelQuotientEnergyDensity_continuous f).measurable
  have hi : Integrable density (integralQuotientVolume globalKubotaKernel) :=
    (kernelQuotientEnergyDensity_integrable f).ofReal
  have hTi := kernelCorrespondenceFunction_integrable hHK hJK e g he density hm hi
  have hint := kernelCorrespondenceFunction_integral hHK hJK e g he density hm hi
  have hre : (∫ q, (kernelCorrespondenceFunction hJK e g he density q).re
      ∂integralQuotientVolume globalKubotaKernel) =
        (J.relIndex globalKubotaKernel : ℝ) * kernelDirichletEnergy f := by
    have htr := integral_re hTi
    have hdf := integral_re hi
    simp only [RCLike.re_to_complex] at htr hdf
    rw [htr, hint]
    simp only [Complex.mul_re, Complex.natCast_re, Complex.natCast_im, zero_mul, sub_zero]
    rw [← hdf]
    rfl
  unfold kernelDirichletEnergy
  calc
    _ ≤ ∫ q, (H.relIndex globalKubotaKernel : ℝ) *
        (kernelCorrespondenceFunction hJK e g he density q).re
        ∂integralQuotientVolume globalKubotaKernel := by
      apply integral_mono (kernelQuotientEnergyDensity_integrable _) (hTi.re.const_mul _)
      intro q
      induction q using Quotient.inductionOn with
      | _ w => exact kernelCorrespondenceTest_energyDensity_le hHK hJK e g he f w
    _ = _ := by rw [integral_const_mul, hre]; exact (mul_assoc _ _ _).symm

def kernelCorrespondenceTestLinear : kernelSmoothTests →ₗ[ℂ] kernelSmoothTests where
  toFun := kernelCorrespondenceTest hHK hJK e g he
  map_add' f h := by
    apply Subtype.ext
    funext q
    induction q using Quotient.inductionOn with
    | _ w =>
      letI : Fintype (IntegralCoverCosets H globalKubotaKernel) := Fintype.ofFinite _
      change kernelCorrespondenceFunction hJK e g he (f + h).1 (integralOrbitProjection globalKubotaKernel w) =
        kernelCorrespondenceFunction hJK e g he f.1 (integralOrbitProjection globalKubotaKernel w) +
        kernelCorrespondenceFunction hJK e g he h.1 (integralOrbitProjection globalKubotaKernel w)
      simp only [kernelCorrespondenceFunction_lift, Submodule.coe_add, Pi.add_apply, Finset.sum_add_distrib]
  map_smul' c f := by
    apply Subtype.ext
    funext q
    induction q using Quotient.inductionOn with
    | _ w =>
      letI : Fintype (IntegralCoverCosets H globalKubotaKernel) := Fintype.ofFinite _
      change kernelCorrespondenceFunction hJK e g he (c • f).1 (integralOrbitProjection globalKubotaKernel w) =
        c • kernelCorrespondenceFunction hJK e g he f.1 (integralOrbitProjection globalKubotaKernel w)
      simp only [kernelCorrespondenceFunction_lift, Submodule.coe_smul, Pi.smul_apply, Finset.smul_sum]

lemma kernelCorrespondenceTest_graph_norm (f : kernelSmoothTests) :
    ‖kernelEnergyGraphCore (kernelCorrespondenceTest hHK hJK e g he f)‖ ≤
      Real.sqrt ((H.relIndex globalKubotaKernel : ℝ) * (J.relIndex globalKubotaKernel : ℝ)) *
        ‖kernelEnergyGraphCore f‖ := by
  have hm := kernelCorrespondenceL2_norm_le hHK hJK e g he (kernelSmoothTestsToL2 f)
  have hs := (sq_le_sq₀ (norm_nonneg _) (mul_nonneg (Real.sqrt_nonneg _) (norm_nonneg _))).mpr hm
  rw [← kernelCorrespondenceTest_mass hHK hJK e g he, mul_pow,
    Real.sq_sqrt (mul_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _))] at hs
  apply (sq_le_sq₀ (norm_nonneg _) (mul_nonneg (Real.sqrt_nonneg _) (norm_nonneg _))).mp
  rw [kernelEnergyGraphCore_norm_sq, mul_pow,
    Real.sq_sqrt (mul_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _)), kernelEnergyGraphCore_norm_sq]
  have hE := kernelCorrespondenceTest_energy_le hHK hJK e g he f
  nlinarith only [hs, hE]

/-- The finite correspondence extends continuously to the completed mass-gradient graph. -/
def kernelCorrespondenceEnergy : KernelEnergyGraph →L[ℂ] KernelEnergyGraph :=
  (kernelEnergyGraphCore.comp (kernelCorrespondenceTestLinear hHK hJK e g he)).extendOfNorm kernelEnergyGraphCore

lemma kernelCorrespondenceEnergy_core (f : kernelSmoothTests) :
    kernelCorrespondenceEnergy hHK hJK e g he (kernelEnergyGraphCore f) =
      kernelEnergyGraphCore (kernelCorrespondenceTest hHK hJK e g he f) :=
  LinearMap.extendOfNorm_eq kernelEnergyGraphCore_dense
    ⟨_, kernelCorrespondenceTest_graph_norm hHK hJK e g he⟩ f

lemma kernelCorrespondenceEnergy_mass (u : KernelEnergyGraph) :
    kernelEnergyMass (kernelCorrespondenceEnergy hHK hJK e g he u) =
      kernelCorrespondenceL2 hHK hJK e g he (kernelEnergyMass u) := by
  apply congrFun (kernelEnergyGraphCore_dense.equalizer
    (kernelEnergyMass.continuous.comp (kernelCorrespondenceEnergy hHK hJK e g he).continuous)
    ((kernelCorrespondenceL2 hHK hJK e g he).continuous.comp kernelEnergyMass.continuous) ?_) u
  funext f
  change kernelEnergyMass (kernelCorrespondenceEnergy hHK hJK e g he (kernelEnergyGraphCore f)) =
    kernelCorrespondenceL2 hHK hJK e g he (kernelEnergyMass (kernelEnergyGraphCore f))
  rw [kernelCorrespondenceEnergy_core, kernelEnergyMass_core, kernelEnergyMass_core, kernelCorrespondenceTest_mass]

end CorrespondenceEnergy

lemma coverGradientAt_lift_continuous (F : EuclideanSpatial → ℂ)
    (hF : ∀ p, 0 < p 2 → ContDiffAt ℝ ∞ F p) :
    Continuous (fun w : HyperbolicSpace => coverGradientAt F (hyperbolicEuclideanCoordinates w)) := by
  apply (PiLp.continuousLinearEquiv 2 ℂ (fun _ : Fin 3 => ℂ)).symm.continuous.comp
  apply continuous_pi
  intro j
  apply (Complex.continuous_ofReal.comp hyperbolicHeight_continuous).mul
  rw [continuous_iff_continuousAt]
  intro w
  exact (((hF _ (hyperbolicHeight_pos w)).continuousAt_fderiv (by simp)).clm_apply
    continuousAt_const).comp hyperbolicEuclideanCoordinates_continuous.continuousAt

/-- Mixed Dirichlet density on a common cover. -/
def kernelCorrespondencePairLift (g : SL(2, ℂ)) (f h : kernelSmoothTests) (w : HyperbolicSpace) : ℂ :=
  coverDirichletPair (kernelTestField f) (kernelTestField h ∘ euclideanAction g)
    (hyperbolicEuclideanCoordinates w)

lemma kernelCorrespondencePairLift_continuous (g : SL(2, ℂ)) (f h : kernelSmoothTests) :
    Continuous (kernelCorrespondencePairLift g f h) :=
  (coverGradientAt_lift_continuous _ (kernelTestField_contDiffAt f)).inner
    (coverGradientAt_lift_continuous _ (kernelTestField_comp_contDiffAt h g))

section CorrespondencePair
variable {H J : Subgroup (SL(2, O))}
    (hHK : H ≤ globalKubotaKernel) (hJK : J ≤ globalKubotaKernel)
    (e : H ≃* J) (g : SL(2, ℂ)) (he : IntegralCoverIntertwines e g)

include hHK hJK he in
lemma kernelCorrespondencePairLift_invariant (f h : kernelSmoothTests) (k : H) (w : HyperbolicSpace) :
    kernelCorrespondencePairLift g f h (k • w) = kernelCorrespondencePairLift g f h w := by
  let A := integralComplexMatrix (k : SL(2, O))
  let B := integralComplexMatrix (e k : SL(2, O))
  have hfi : kernelTestField f ∘ euclideanAction A = kernelTestField f :=
    funext (kernelTestField_invariant f ⟨(k : SL(2, O)), hHK k.property⟩)
  have hhi : (kernelTestField h ∘ euclideanAction g) ∘ euclideanAction A =
      kernelTestField h ∘ euclideanAction g := by
    rw [Function.comp_assoc, ← euclideanAction_mul, he k, euclideanAction_mul, ← Function.comp_assoc]
    have hh : kernelTestField h ∘ euclideanAction B = kernelTestField h :=
      funext (kernelTestField_invariant h ⟨(e k : SL(2, O)), hJK (e k).property⟩)
    rw [hh]
  have hh := coverDirichletPair_comp A (kernelTestField f) (kernelTestField h ∘ euclideanAction g)
    (hyperbolicEuclideanCoordinates w) (hyperbolicHeight_pos w)
    ((kernelTestField_contDiffAt f _ (euclideanAction_positive A _)).differentiableAt (by simp))
    ((kernelTestField_comp_contDiffAt h g _ (euclideanAction_positive A _)).differentiableAt (by simp))
  rw [hfi, hhi] at hh
  change _ = coverDirichletPair (kernelTestField f) (kernelTestField h ∘ euclideanAction g)
    (hyperbolicEuclideanCoordinates w)
  rw [integralSubgroup_smul]
  simpa only [kernelCorrespondencePairLift, A, euclideanAction, euclideanToHyperbolic_coordinates] using hh.symm

def kernelCorrespondencePair (f h : kernelSmoothTests) : IntegralOrbitQuotient H → ℂ :=
  Quotient.lift (kernelCorrespondencePairLift g f h) (by
    rintro w v ⟨k, rfl⟩
    exact (kernelCorrespondencePairLift_invariant hHK hJK e g he f h k w).symm)

lemma kernelCorrespondencePair_projection (f h : kernelSmoothTests) (w : HyperbolicSpace) :
    kernelCorrespondencePair hHK hJK e g he f h (integralOrbitProjection H w) =
      kernelCorrespondencePairLift g f h w := rfl

lemma kernelCorrespondencePair_measurable (f h : kernelSmoothTests) :
    Measurable (kernelCorrespondencePair hHK hJK e g he f h) :=
  measurable_from_quotient.mpr (kernelCorrespondencePairLift_continuous g f h).measurable

lemma kernelCorrespondencePair_norm_le (f h : kernelSmoothTests) (q : IntegralOrbitQuotient H) :
    ‖kernelCorrespondencePair hHK hJK e g he f h q‖ ≤
      (kernelQuotientEnergyDensity f (integralCoverMap hHK q) +
        kernelQuotientEnergyDensity h (integralCoverMap hJK (integralConjugateMap e g he q))) / 2 := by
  induction q using Quotient.inductionOn with
  | _ w =>
    have hf := (kernelTestField_contDiffAt f (hyperbolicEuclideanCoordinates w) (hyperbolicHeight_pos w)).differentiableAt (by simp)
    have hh := (kernelTestField_comp_contDiffAt h g (hyperbolicEuclideanCoordinates w) (hyperbolicHeight_pos w)).differentiableAt (by simp)
    have hb := coverDirichletPair_norm_le (kernelTestField f) (kernelTestField h ∘ euclideanAction g)
      (hyperbolicEuclideanCoordinates w) hf hh
    rw [coverEnergyDensity_comp g _ _ (hyperbolicHeight_pos w)
      ((kernelTestField_contDiffAt h _ (euclideanAction_positive g _)).differentiableAt (by simp))] at hb
    change ‖kernelCorrespondencePairLift g f h w‖ ≤ (kernelTestEnergyDensity f w + kernelTestEnergyDensity h (g • w)) / 2
    simpa only [kernelCorrespondencePairLift, kernelTestEnergyDensity_eq_cover, euclideanAction,
      euclideanToHyperbolic_coordinates] using hb

variable [H.IsFiniteRelIndex globalKubotaKernel] [J.IsFiniteRelIndex globalKubotaKernel]

lemma kernelCorrespondencePair_integrable (f h : kernelSmoothTests) :
    Integrable (kernelCorrespondencePair hHK hJK e g he f h) (integralQuotientVolume H) := by
  have hf := (integralCoverMap_measurePreserving hHK globalKubotaKernel_le_levelThree).integrable_comp_of_integrable
    ((kernelQuotientEnergyDensity_integrable f).smul_measure (c := (H.relIndex globalKubotaKernel : ℝ≥0∞)) (by simp))
  have hh := (integralCoverMap_measurePreserving hJK globalKubotaKernel_le_levelThree).integrable_comp_of_integrable
    ((kernelQuotientEnergyDensity_integrable h).smul_measure (c := (J.relIndex globalKubotaKernel : ℝ≥0∞)) (by simp))
  have hhh := (integralConjugateMap_measurePreserving e g he
    (hHK.trans globalKubotaKernel_le_levelThree) (hJK.trans globalKubotaKernel_le_levelThree)).integrable_comp_of_integrable hh
  apply ((hf.add hhh).div_const 2).mono' (kernelCorrespondencePair_measurable hHK hJK e g he f h).aestronglyMeasurable
  exact Filter.Eventually.of_forall (kernelCorrespondencePair_norm_le hHK hJK e g he f h)

end CorrespondencePair

lemma kernelCorrespondencePairLift_kernel (g : SL(2, ℂ)) (f h : kernelSmoothTests)
    (r : globalKubotaKernel) (w : HyperbolicSpace) :
    kernelCorrespondencePairLift g f h (r • w) =
      coverDirichletPair (kernelTestField f)
        (kernelTestField h ∘ euclideanAction (g * integralComplexMatrix (r : SL(2, O))))
        (hyperbolicEuclideanCoordinates w) := by
  have hf := (kernelTestField_contDiffAt f _ (euclideanAction_positive (integralComplexMatrix r) (hyperbolicEuclideanCoordinates w))).differentiableAt (by simp)
  have hh := (kernelTestField_comp_contDiffAt h g _ (euclideanAction_positive (integralComplexMatrix r) (hyperbolicEuclideanCoordinates w))).differentiableAt (by simp)
  have hp := coverDirichletPair_comp (integralComplexMatrix r) (kernelTestField f)
    (kernelTestField h ∘ euclideanAction g) (hyperbolicEuclideanCoordinates w) (hyperbolicHeight_pos w) hf hh
  have hfi : kernelTestField f ∘ euclideanAction (integralComplexMatrix r) = kernelTestField f :=
    funext (kernelTestField_invariant f r)
  rw [hfi, Function.comp_assoc, ← euclideanAction_mul] at hp
  simpa only [kernelCorrespondencePairLift, integralSubgroup_smul, euclideanAction,
    euclideanToHyperbolic_coordinates] using hp.symm

lemma kernelTestField_comp_inverse (f : kernelSmoothTests) (g : SL(2, ℂ)) :
    (kernelTestField f ∘ euclideanAction g⁻¹) ∘ euclideanAction g = kernelTestField f := by
  funext p
  simp only [Function.comp_def, kernelTestField, euclideanAction, euclideanToHyperbolic_coordinates, inv_smul_smul]

section CorrespondenceForm
variable {H J : Subgroup (SL(2, O))}
    (hHK : H ≤ globalKubotaKernel) (hJK : J ≤ globalKubotaKernel)
    [H.IsFiniteRelIndex globalKubotaKernel] [J.IsFiniteRelIndex globalKubotaKernel]
    (e : H ≃* J) (g : SL(2, ℂ)) (he : IntegralCoverIntertwines e g)

lemma kernelCorrespondencePair_trace (f h : kernelSmoothTests) (q : KernelQuotient) :
    kernelDirichletPairDensity f (kernelCorrespondenceTest hHK hJK e g he h) q =
      integralCoverTraceFunction H globalKubotaKernel (kernelCorrespondencePair hHK hJK e g he f h) q := by
  letI : Fintype (IntegralCoverCosets H globalKubotaKernel) := Fintype.ofFinite _
  induction q using Quotient.inductionOn with
  | _ w =>
    change kernelDirichletPairDensity f (kernelCorrespondenceTest hHK hJK e g he h)
      (integralOrbitProjection globalKubotaKernel w) = _
    rw [kernelDirichletPairDensity_eq_cover, funext (kernelCorrespondenceTest_field hHK hJK e g he h)]
    have hd (r : IntegralCoverCosets H globalKubotaKernel) :
        DifferentiableAt ℝ (kernelTestField h ∘ euclideanAction (kernelCorrespondenceMatrix g r))
          (hyperbolicEuclideanCoordinates w) :=
      (kernelTestField_comp_contDiffAt h _ _ (hyperbolicHeight_pos w)).differentiableAt (by simp)
    have hsum := coverDirichletPair_sum_right Finset.univ (kernelTestField f)
      (fun r => kernelTestField h ∘ euclideanAction (kernelCorrespondenceMatrix g r))
      (hyperbolicEuclideanCoordinates w) (fun r _ => hd r)
    simp only [Function.comp_apply] at hsum
    rw [hsum]
    change (∑ r : IntegralCoverCosets H globalKubotaKernel, _) =
      ∑ r : IntegralCoverCosets H globalKubotaKernel,
        kernelCorrespondencePair hHK hJK e g he f h (integralCoverFiberPoint H globalKubotaKernel r w)
    apply Finset.sum_congr rfl
    intro r _
    rw [integralCoverFiberPoint_rep, kernelCorrespondencePair_projection, kernelCorrespondencePairLift_kernel]
    rfl

lemma kernelCorrespondenceForm_integral (f h : kernelSmoothTests) :
    kernelDirichletForm f (kernelCorrespondenceTest hHK hJK e g he h) =
      ∫ q, kernelCorrespondencePair hHK hJK e g he f h q ∂integralQuotientVolume H := by
  unfold kernelDirichletForm
  simp_rw [kernelCorrespondencePair_trace]
  exact integralCoverTraceFunction_integral hHK globalKubotaKernel_le_levelThree _
    (kernelCorrespondencePair_measurable hHK hJK e g he f h)
    (kernelCorrespondencePair_integrable hHK hJK e g he f h)

omit [H.IsFiniteRelIndex globalKubotaKernel] [J.IsFiniteRelIndex globalKubotaKernel] in
lemma kernelCorrespondencePair_conjugate (f h : kernelSmoothTests) (q : IntegralOrbitQuotient H) :
    kernelCorrespondencePair hHK hJK e g he f h q =
      star (kernelCorrespondencePair hJK hHK e.symm g⁻¹ (integralCoverIntertwines_inverse e g he) h f
        (integralConjugateMap e g he q)) := by
  induction q using Quotient.inductionOn with
  | _ w =>
    change kernelCorrespondencePairLift g f h w = star (kernelCorrespondencePairLift g⁻¹ h f (g • w))
    have hf := (kernelTestField_contDiffAt h _ (euclideanAction_positive g (hyperbolicEuclideanCoordinates w))).differentiableAt (by simp)
    have hh := (kernelTestField_comp_contDiffAt f g⁻¹ _ (euclideanAction_positive g (hyperbolicEuclideanCoordinates w))).differentiableAt (by simp)
    have hc := coverDirichletPair_comp g (kernelTestField h) (kernelTestField f ∘ euclideanAction g⁻¹)
      (hyperbolicEuclideanCoordinates w) (hyperbolicHeight_pos w) hf hh
    rw [kernelTestField_comp_inverse] at hc
    have hs := congrArg star hc
    have hswap : star (inner ℂ
        (coverGradientAt (kernelTestField h ∘ euclideanAction g) (hyperbolicEuclideanCoordinates w))
        (coverGradientAt (kernelTestField f) (hyperbolicEuclideanCoordinates w))) =
        inner ℂ (coverGradientAt (kernelTestField f) (hyperbolicEuclideanCoordinates w))
          (coverGradientAt (kernelTestField h ∘ euclideanAction g) (hyperbolicEuclideanCoordinates w)) := inner_conj_symm _ _
    rw [coverDirichletPair, hswap] at hs
    simpa only [kernelCorrespondencePairLift, coverDirichletPair, euclideanAction, euclideanToHyperbolic_coordinates] using hs

/-- Reversing the finite correspondence gives its Dirichlet-form adjoint. -/
theorem kernelCorrespondenceForm_adjoint (f h : kernelSmoothTests) :
    kernelDirichletForm f (kernelCorrespondenceTest hHK hJK e g he h) =
      kernelDirichletForm (kernelCorrespondenceTest hJK hHK e.symm g⁻¹ (integralCoverIntertwines_inverse e g he) f) h := by
  let opposite := kernelCorrespondencePair hJK hHK e.symm g⁻¹ (integralCoverIntertwines_inverse e g he) h f
  have hom := kernelCorrespondencePair_measurable hJK hHK e.symm g⁻¹ (integralCoverIntertwines_inverse e g he) h f
  have hm := integralConjugateMap_measurePreserving e g he
    (hHK.trans globalKubotaKernel_le_levelThree) (hJK.trans globalKubotaKernel_le_levelThree)
  rw [kernelCorrespondenceForm_integral]
  calc
    _ = ∫ q, star (opposite (integralConjugateMap e g he q)) ∂integralQuotientVolume H :=
      integral_congr_ae (Filter.Eventually.of_forall (kernelCorrespondencePair_conjugate hHK hJK e g he f h))
    _ = ∫ q, star (opposite q) ∂integralQuotientVolume J := by
      have hh := integral_map (μ := integralQuotientVolume H) hm.measurable.aemeasurable
        (continuous_star.measurable.comp hom).aestronglyMeasurable
      rw [hm.map_eq] at hh
      exact hh.symm
    _ = star (∫ q, opposite q ∂integralQuotientVolume J) := by
      simp only [Complex.star_def]
      exact integral_conj
    _ = _ := by
      rw [← kernelCorrespondenceForm_integral hJK hHK e.symm g⁻¹
        (integralCoverIntertwines_inverse e g he), kernelDirichletForm_conj]

end CorrespondenceForm

section CorrespondenceLaplacian
variable {H J : Subgroup (SL(2, O))}
    (hHK : H ≤ globalKubotaKernel) (hJK : J ≤ globalKubotaKernel)
    [H.IsFiniteRelIndex globalKubotaKernel] [J.IsFiniteRelIndex globalKubotaKernel]
    (e : H ≃* J) (g : SL(2, ℂ)) (he : IntegralCoverIntertwines e g)

lemma kernelCorrespondenceL2_pairing_right (F G : KernelQuotientL2) :
    inner ℂ F (kernelCorrespondenceL2 hHK hJK e g he G) =
      inner ℂ (kernelCorrespondenceL2 hJK hHK e.symm g⁻¹ (integralCoverIntertwines_inverse e g he) F) G := by
  have hh := congrArg star (kernelCorrespondenceL2_pairing hHK hJK e g he G F)
  simpa only [← starRingEnd_apply, inner_conj_symm] using hh

lemma kernelCorrespondenceEnergy_pairing_core (f h : kernelSmoothTests) :
    inner ℂ (kernelEnergyGraphCore f) (kernelCorrespondenceEnergy hHK hJK e g he (kernelEnergyGraphCore h)) =
      inner ℂ (kernelCorrespondenceEnergy hJK hHK e.symm g⁻¹ (integralCoverIntertwines_inverse e g he)
        (kernelEnergyGraphCore f)) (kernelEnergyGraphCore h) := by
  rw [kernelCorrespondenceEnergy_core, kernelCorrespondenceEnergy_core,
    kernelEnergyGraph_inner, kernelEnergyGraph_inner]
  simp only [kernelEnergyMass_core, kernelEnergyGradient_core, kernelGradientToL2_inner]
  rw [kernelCorrespondenceTest_mass, kernelCorrespondenceTest_mass,
    kernelCorrespondenceL2_pairing_right, kernelCorrespondenceForm_adjoint]

theorem kernelCorrespondenceEnergy_pairing (u v : KernelEnergyGraph) :
    inner ℂ u (kernelCorrespondenceEnergy hHK hJK e g he v) =
      inner ℂ (kernelCorrespondenceEnergy hJK hHK e.symm g⁻¹ (integralCoverIntertwines_inverse e g he) u) v := by
  apply congrFun (kernelEnergyGraphCore_dense.equalizer
    (continuous_id.inner continuous_const)
    ((kernelCorrespondenceEnergy hJK hHK e.symm g⁻¹
      (integralCoverIntertwines_inverse e g he)).continuous.inner continuous_const) ?_) u
  funext f
  apply congrFun (kernelEnergyGraphCore_dense.equalizer
    (continuous_const.inner (kernelCorrespondenceEnergy hHK hJK e g he).continuous)
    (continuous_const.inner continuous_id) ?_) v
  funext h
  exact kernelCorrespondenceEnergy_pairing_core hHK hJK e g he f h

lemma kernelCorrespondenceEnergy_pairing_left (u v : KernelEnergyGraph) :
    inner ℂ (kernelCorrespondenceEnergy hHK hJK e g he u) v =
      inner ℂ u (kernelCorrespondenceEnergy hJK hHK e.symm g⁻¹ (integralCoverIntertwines_inverse e g he) v) := by
  calc
    _ = star (inner ℂ v (kernelCorrespondenceEnergy hHK hJK e g he u)) :=
      (inner_conj_symm (𝕜 := ℂ) (kernelCorrespondenceEnergy hHK hJK e g he u) v).symm
    _ = star (inner ℂ
        (kernelCorrespondenceEnergy hJK hHK e.symm g⁻¹ (integralCoverIntertwines_inverse e g he) v) u) :=
      congrArg star (kernelCorrespondenceEnergy_pairing hHK hJK e g he v u)
    _ = _ := inner_conj_symm (𝕜 := ℂ) u
      (kernelCorrespondenceEnergy hJK hHK e.symm g⁻¹ (integralCoverIntertwines_inverse e g he) v)

theorem kernelCorrespondence_variationalSolution (F : KernelQuotientL2) :
    kernelCorrespondenceEnergy hHK hJK e g he (kernelVariationalSolution F) =
      kernelVariationalSolution (kernelCorrespondenceL2 hHK hJK e g he F) := by
  apply kernelVariationalSolution_unique
  intro v
  rw [← kernelEnergyGraph_inner, kernelCorrespondenceEnergy_pairing_left,
    kernelEnergyGraph_inner, kernelVariationalSolution_equation, kernelCorrespondenceEnergy_mass]
  exact (kernelCorrespondenceL2_pairing hHK hJK e g he F (kernelEnergyMass v)).symm

/-- Finite geometric correspondences commute with the variational resolvent. -/
theorem kernelCorrespondence_variationalResolvent (F : KernelQuotientL2) :
    kernelVariationalResolvent (kernelCorrespondenceL2 hHK hJK e g he F) =
      kernelCorrespondenceL2 hHK hJK e g he (kernelVariationalResolvent F) := by
  change kernelEnergyMass (kernelVariationalSolution (kernelCorrespondenceL2 hHK hJK e g he F)) = _
  rw [← kernelCorrespondence_variationalSolution, kernelCorrespondenceEnergy_mass]
  rfl

theorem kernelCorrespondence_operatorGraph (F G : KernelQuotientL2)
    (hFG : (F, G) ∈ kernelEnergyLaplacian.graph) :
    (kernelCorrespondenceL2 hHK hJK e g he F, kernelCorrespondenceL2 hHK hJK e g he G) ∈ kernelEnergyLaplacian.graph := by
  rw [kernelEnergyLaplacian_graph, mem_kernelLaplacianGraph] at hFG ⊢
  rw [← map_add, kernelCorrespondence_variationalResolvent, hFG]

theorem kernelCorrespondence_eigenvector (F : KernelQuotientL2) (eigenvalue : ℂ)
    (hF : (F, eigenvalue • F) ∈ kernelEnergyLaplacian.graph) :
    (kernelCorrespondenceL2 hHK hJK e g he F,
      eigenvalue • kernelCorrespondenceL2 hHK hJK e g he F) ∈ kernelEnergyLaplacian.graph := by
  simpa only [map_smul] using kernelCorrespondence_operatorGraph hHK hJK e g he F (eigenvalue • F) hF

end CorrespondenceLaplacian

lemma integralCoverIntertwines_trans {H J K : Subgroup (SL(2, O))}
    (e : H ≃* J) (f : J ≃* K) (g h : SL(2, ℂ))
    (he : IntegralCoverIntertwines e g) (hf : IntegralCoverIntertwines f h) :
    IntegralCoverIntertwines (e.trans f) (h * g) := by
  intro k
  change (h * g) * integralComplexMatrix (k : SL(2, O)) =
    integralComplexMatrix (f (e k) : SL(2, O)) * (h * g)
  rw [mul_assoc, he k, ← mul_assoc, hf (e k), mul_assoc]

lemma integralConjugateMap_trans {H J K : Subgroup (SL(2, O))}
    (e : H ≃* J) (f : J ≃* K) (g h : SL(2, ℂ))
    (he : IntegralCoverIntertwines e g) (hf : IntegralCoverIntertwines f h) (q : IntegralOrbitQuotient H) :
    integralConjugateMap f h hf (integralConjugateMap e g he q) =
      integralConjugateMap (e.trans f) (h * g) (integralCoverIntertwines_trans e f g h he hf) q := by
  induction q using Quotient.inductionOn with
  | _ w =>
    change integralOrbitProjection K (h • (g • w)) = integralOrbitProjection K ((h * g) • w)
    rw [mul_smul]

lemma integralConjugatePullback_trans {H J K : Subgroup (SL(2, O))}
    (e : H ≃* J) (f : J ≃* K) (g h : SL(2, ℂ))
    (he : IntegralCoverIntertwines e g) (hf : IntegralCoverIntertwines f h)
    (hH : H ≤ levelThree) (hJ : J ≤ levelThree) (hK : K ≤ levelThree) (F : IntegralQuotientL2 K) :
    integralConjugatePullback e g he hH hJ (integralConjugatePullback f h hf hJ hK F) =
      integralConjugatePullback (e.trans f) (h * g) (integralCoverIntertwines_trans e f g h he hf) hH hK F := by
  apply Lp.ext
  have hinner := (integralConjugateMap_measurePreserving e g he hH hJ).quasiMeasurePreserving.ae_eq_comp
    (integralConjugatePullback_ae f h hf hJ hK F)
  filter_upwards [integralConjugatePullback_ae e g he hH hJ _, hinner,
    integralConjugatePullback_ae (e.trans f) (h * g) (integralCoverIntertwines_trans e f g h he hf) hH hK F] with q ho hi ht
  dsimp only [Function.comp_def] at hi
  rw [ho, hi, ht, integralConjugateMap_trans]

lemma kernelCoverLeg_representative {H J : Subgroup (SL(2, O))}
    (hHK : H ≤ globalKubotaKernel) (hJK : J ≤ globalKubotaKernel) [J.IsFiniteRelIndex globalKubotaKernel]
    (e : H ≃* J) (g : SL(2, ℂ)) (he : IntegralCoverIntertwines e g)
    (F : KernelQuotientL2) (f : KernelQuotient → ℂ)
    (hrep : F =ᵐ[integralQuotientVolume globalKubotaKernel] f) :
    kernelCoverLeg hHK hJK e g he F =ᵐ[integralQuotientVolume H]
      fun q => f (integralCoverMap hJK (integralConjugateMap e g he q)) := by
  have hc := (integralCoverPullback_ae hJK globalKubotaKernel_le_levelThree F).trans
    ((integralCoverMap_quasiMeasurePreserving hJK globalKubotaKernel_le_levelThree).ae_eq_comp hrep)
  exact (integralConjugatePullback_ae e g he
    (hHK.trans globalKubotaKernel_le_levelThree) (hJK.trans globalKubotaKernel_le_levelThree) _).trans
    ((integralConjugateMap_measurePreserving e g he
      (hHK.trans globalKubotaKernel_le_levelThree) (hJK.trans globalKubotaKernel_le_levelThree)).quasiMeasurePreserving.ae_eq_comp hc)

/-- Two legs on a common cover compose to a correspondence on the base quotient. -/
theorem kernelCoverLeg_adjoint_comp {H Ji Jj : Subgroup (SL(2, O))}
    (hHK : H ≤ globalKubotaKernel) (hiK : Ji ≤ globalKubotaKernel) (hjK : Jj ≤ globalKubotaKernel)
    [Ji.IsFiniteRelIndex globalKubotaKernel] [Jj.IsFiniteRelIndex globalKubotaKernel]
    (ei : H ≃* Ji) (ej : H ≃* Jj) (gi gj : SL(2, ℂ))
    (hei : IntegralCoverIntertwines ei gi) (hej : IntegralCoverIntertwines ej gj) :
    (ContinuousLinearMap.adjoint (kernelCoverLeg hHK hjK ej gj hej)).comp (kernelCoverLeg hHK hiK ei gi hei) =
      kernelCorrespondenceL2 hjK hiK (ej.symm.trans ei) (gi * gj⁻¹)
        (integralCoverIntertwines_trans ej.symm ei gj⁻¹ gi (integralCoverIntertwines_inverse ej gj hej) hei) := by
  apply ContinuousLinearMap.ext
  intro F
  change ContinuousLinearMap.adjoint (kernelCoverLeg hHK hjK ej gj hej) (kernelCoverLeg hHK hiK ei gi hei F) = _
  rw [kernelCoverLeg_adjoint]
  change integralCoverTrace hjK globalKubotaKernel_le_levelThree
    (integralConjugatePullback ej.symm gj⁻¹ (integralCoverIntertwines_inverse ej gj hej)
      (hjK.trans globalKubotaKernel_le_levelThree) (hHK.trans globalKubotaKernel_le_levelThree)
      (integralConjugatePullback ei gi hei
        (hHK.trans globalKubotaKernel_le_levelThree) (hiK.trans globalKubotaKernel_le_levelThree)
        (integralCoverPullback hiK globalKubotaKernel_le_levelThree F))) = _
  rw [integralConjugatePullback_trans]
  rfl

theorem kernelCoverLeg_adjoint_sum_eigenvector
    {H : Subgroup (SL(2, O))} {ι : Type*} [Fintype ι]
    (J : ι → Subgroup (SL(2, O))) (hHK : H ≤ globalKubotaKernel) (hJK : ∀ i, J i ≤ globalKubotaKernel)
    [∀ i, (J i).IsFiniteRelIndex globalKubotaKernel]
    (e : ∀ i, H ≃* J i) (g : ι → SL(2, ℂ)) (he : ∀ i, IntegralCoverIntertwines (e i) (g i))
    (F : KernelQuotientL2) (eigenvalue : ℂ) (hF : (F, eigenvalue • F) ∈ kernelEnergyLaplacian.graph)
    (c : ι → ℂ) (j : ι) :
    let D := ∑ i, c i • kernelCoverLeg hHK (hJK i) (e i) (g i) (he i) F
    (ContinuousLinearMap.adjoint (kernelCoverLeg hHK (hJK j) (e j) (g j) (he j)) D,
      eigenvalue • ContinuousLinearMap.adjoint (kernelCoverLeg hHK (hJK j) (e j) (g j) (he j)) D) ∈ kernelEnergyLaplacian.graph := by
  let traced (i : ι) := ContinuousLinearMap.adjoint (kernelCoverLeg hHK (hJK j) (e j) (g j) (he j))
    (kernelCoverLeg hHK (hJK i) (e i) (g i) (he i) F)
  have hi (i : ι) : (traced i, eigenvalue • traced i) ∈ kernelEnergyLaplacian.graph := by
    change (((ContinuousLinearMap.adjoint (kernelCoverLeg hHK (hJK j) (e j) (g j) (he j))).comp
      (kernelCoverLeg hHK (hJK i) (e i) (g i) (he i))) F,
      eigenvalue • ((ContinuousLinearMap.adjoint (kernelCoverLeg hHK (hJK j) (e j) (g j) (he j))).comp
      (kernelCoverLeg hHK (hJK i) (e i) (g i) (he i))) F) ∈ kernelEnergyLaplacian.graph
    rw [kernelCoverLeg_adjoint_comp]
    exact kernelCorrespondence_eigenvector _ _ _ _ _ F eigenvalue hF
  have hsum : (∑ i, c i • (traced i, eigenvalue • traced i)) ∈ kernelEnergyLaplacian.graph :=
    kernelEnergyLaplacian.graph.sum_mem (fun i _ => kernelEnergyLaplacian.graph.smul_mem (c i) (hi i))
  have hEq : (∑ i, c i • (traced i, eigenvalue • traced i)) =
      (∑ i, c i • traced i, eigenvalue • ∑ i, c i • traced i) := by
    apply Prod.ext <;> simp only [Prod.fst_sum, Prod.snd_sum, Prod.smul_fst, Prod.smul_snd,
      Finset.smul_sum, smul_smul, mul_comm]
  rw [hEq] at hsum
  simpa only [map_sum, map_smul] using hsum

/-- A nonzero integral diagonal matrix defines a correspondence before imposing a character kernel. -/
def integralDiagonalCorrespondence (d : O) : Subgroup (SL(2, O) × SL(2, O)) where
  carrier := {MN | (!![d, 0; 0, 1] : Matrix (Fin 2) (Fin 2) O) * MN.1.val =
    MN.2.val * !![d, 0; 0, 1]}
  one_mem' := by simp
  mul_mem' := by
    rintro ⟨M, N⟩ ⟨M', N'⟩ h h'
    change !![d, 0; 0, 1] * (M.val * M'.val) = (N.val * N'.val) * !![d, 0; 0, 1]
    rw [← Matrix.mul_assoc, h, Matrix.mul_assoc, h', ← Matrix.mul_assoc]
  inv_mem' := by
    rintro ⟨M, N⟩ h
    change !![d, 0; 0, 1] * (M⁻¹).val = (N⁻¹).val * !![d, 0; 0, 1]
    calc
      _ = ((N⁻¹).val * (N.val * !![d, 0; 0, 1])) * (M⁻¹).val := by
        simp only [← Matrix.mul_assoc, ← Matrix.SpecialLinearGroup.coe_mul,
          inv_mul_cancel, Matrix.SpecialLinearGroup.coe_one, Matrix.one_mul]
      _ = ((N⁻¹).val * (!![d, 0; 0, 1] * M.val)) * (M⁻¹).val := by rw [h]
      _ = _ := by
        simp only [Matrix.mul_assoc, ← Matrix.SpecialLinearGroup.coe_mul,
          mul_inv_cancel, Matrix.SpecialLinearGroup.coe_one, Matrix.mul_one]

def integralDiagonalLeft (d : O) : integralDiagonalCorrespondence d →* SL(2, O) :=
  (MonoidHom.fst _ _).comp (integralDiagonalCorrespondence d).subtype

def integralDiagonalRight (d : O) : integralDiagonalCorrespondence d →* SL(2, O) :=
  (MonoidHom.snd _ _).comp (integralDiagonalCorrespondence d).subtype

lemma integralDiagonal_entries (d : O) (MN : integralDiagonalCorrespondence d) :
    d * MN.1.1 0 0 = MN.1.2 0 0 * d ∧ d * MN.1.1 0 1 = MN.1.2 0 1 ∧
      MN.1.1 1 0 = MN.1.2 1 0 * d ∧ MN.1.1 1 1 = MN.1.2 1 1 := by
  have h := MN.property
  have h00 := congrArg (fun A : Matrix (Fin 2) (Fin 2) O => A 0 0) h
  have h01 := congrArg (fun A : Matrix (Fin 2) (Fin 2) O => A 0 1) h
  have h10 := congrArg (fun A : Matrix (Fin 2) (Fin 2) O => A 1 0) h
  have h11 := congrArg (fun A : Matrix (Fin 2) (Fin 2) O => A 1 1) h
  norm_num [Matrix.mul_apply, Fin.sum_univ_two] at h00 h01 h10 h11
  exact ⟨h00, h01, h10, h11⟩

lemma integralDiagonalLeft_injective (d : O) (hd : d ≠ 0) : Function.Injective (integralDiagonalLeft d) := by
  intro x y h
  have hx := integralDiagonal_entries d x
  have hy := integralDiagonal_entries d y
  have hM : x.1.1 = y.1.1 := h
  apply Subtype.ext
  refine Prod.ext hM ?_
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  fin_cases i <;> fin_cases j
  · exact mul_right_cancel₀ hd (hx.1.symm.trans (by rw [hM]; exact hy.1))
  · exact hx.2.1.symm.trans (by rw [hM]; exact hy.2.1)
  · exact mul_right_cancel₀ hd (hx.2.2.1.symm.trans (by rw [hM]; exact hy.2.2.1))
  · exact hx.2.2.2.symm.trans (by rw [hM]; exact hy.2.2.2)

lemma integralDiagonalRight_injective (d : O) (hd : d ≠ 0) : Function.Injective (integralDiagonalRight d) := by
  intro x y h
  have hx := integralDiagonal_entries d x
  have hy := integralDiagonal_entries d y
  have hN : x.1.2 = y.1.2 := h
  apply Subtype.ext
  refine Prod.ext ?_ hN
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  fin_cases i <;> fin_cases j
  · exact mul_left_cancel₀ hd (hx.1.trans (by rw [hN]; exact hy.1.symm))
  · exact mul_left_cancel₀ hd (hx.2.1.trans (by rw [hN]; exact hy.2.1.symm))
  · exact hx.2.2.1.trans (by rw [hN]; exact hy.2.2.1.symm)
  · exact hx.2.2.2.trans (by rw [hN]; exact hy.2.2.2.symm)

def integralPrincipalLevel (d : O) : Subgroup (SL(2, O)) :=
  (Matrix.SpecialLinearGroup.map (n := Fin 2) (Ideal.Quotient.mk (Ideal.span {d}))).ker

lemma integralPrincipalLevel_entry (d : O) (M : integralPrincipalLevel d) (i j : Fin 2) :
    d ∣ (M : SL(2, O)) i j - (if i = j then 1 else 0) := by
  have hm : Matrix.SpecialLinearGroup.map (n := Fin 2) (Ideal.Quotient.mk (Ideal.span {d})) (M : SL(2, O)) = 1 := M.property
  have h := congrArg (fun N : SL(2, O ⧸ Ideal.span {d}) => N i j) hm
  change Ideal.Quotient.mk (Ideal.span {d}) ((M : SL(2, O)) i j) =
    (1 : Matrix (Fin 2) (Fin 2) (O ⧸ Ideal.span {d})) i j at h
  apply Ideal.mem_span_singleton.mp
  apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp
  simpa only [Matrix.one_apply, apply_ite, map_one, map_zero] using h

lemma integralPrincipalLevel_finiteIndex (d : O) (hd : d ≠ 0) : (integralPrincipalLevel d).FiniteIndex := by
  letI : Finite (O ⧸ Ideal.span {d}) := (Ideal.span {d}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr hd)
  unfold integralPrincipalLevel
  infer_instance

lemma integralPrincipalLevel_le_diagonalLeft (d : O) : integralPrincipalLevel d ≤ (integralDiagonalLeft d).range := by
  intro M hM
  obtain ⟨c, hc⟩ : d ∣ M 1 0 := by simpa using integralPrincipalLevel_entry d ⟨M, hM⟩ 1 0
  let N : SL(2, O) := ⟨!![M 0 0, d * M 0 1; c, M 1 1], by
    have hdet := M.property
    rw [Matrix.det_fin_two, hc] at hdet
    rw [Matrix.det_fin_two_of]
    linear_combination hdet⟩
  refine ⟨⟨(M, N), ?_⟩, rfl⟩
  change !![d, 0; 0, 1] * M.val = N.val * !![d, 0; 0, 1]
  apply Matrix.ext
  intro i j
  fin_cases i <;> fin_cases j <;> simp [N, Matrix.mul_apply, Fin.sum_univ_two, hc, mul_comm]

lemma integralPrincipalLevel_le_diagonalRight (d : O) : integralPrincipalLevel d ≤ (integralDiagonalRight d).range := by
  intro N hN
  obtain ⟨b, hb⟩ : d ∣ N 0 1 := by simpa using integralPrincipalLevel_entry d ⟨N, hN⟩ 0 1
  let M : SL(2, O) := ⟨!![N 0 0, b; d * N 1 0, N 1 1], by
    have hdet := N.property
    rw [Matrix.det_fin_two, hb] at hdet
    rw [Matrix.det_fin_two_of]
    linear_combination hdet⟩
  refine ⟨⟨(M, N), ?_⟩, rfl⟩
  change !![d, 0; 0, 1] * M.val = N.val * !![d, 0; 0, 1]
  apply Matrix.ext
  intro i j
  fin_cases i <;> fin_cases j <;> simp [M, Matrix.mul_apply, Fin.sum_univ_two, hb, mul_comm]

lemma integralDiagonal_finite_covers (d : O) (hd : d ≠ 0) :
    (integralDiagonalLeft d).range.FiniteIndex ∧ (integralDiagonalRight d).range.FiniteIndex := by
  letI := integralPrincipalLevel_finiteIndex d hd
  exact ⟨Subgroup.finiteIndex_of_le (integralPrincipalLevel_le_diagonalLeft d),
    Subgroup.finiteIndex_of_le (integralPrincipalLevel_le_diagonalRight d)⟩

lemma finiteIndex_preimage {G G' : Type*} [Group G] [Group G']
    (K : Subgroup G') [K.FiniteIndex] (f : G →* G') : (K.comap f).FiniteIndex := by
  constructor
  rw [Subgroup.index_comap]
  exact fun h => (Subgroup.FiniteIndex.index_ne_zero (H := K)) (K.index_eq_zero_of_relIndex_eq_zero h)

lemma finiteIndex_image {G G' : Type*} [Group G] [Group G']
    (H : Subgroup G) [H.FiniteIndex] (f : G →* G') (hf : Function.Injective f)
    [f.range.FiniteIndex] : (H.map f).FiniteIndex := by
  constructor
  rw [Subgroup.index_map_of_injective _ hf]
  exact mul_ne_zero (Subgroup.FiniteIndex.index_ne_zero (H := H))
    (Subgroup.FiniteIndex.index_ne_zero (H := f.range))

/-- Restrict both sides to the actual multiplier kernel. Both restrictions retain finite index. -/
def integralDiagonalKernel (d : O) : Subgroup (integralDiagonalCorrespondence d) :=
  globalKubotaKernel.comap (integralDiagonalLeft d) ⊓ globalKubotaKernel.comap (integralDiagonalRight d)

def integralDiagonalKernelLeft (d : O) : integralDiagonalKernel d →* SL(2, O) :=
  (integralDiagonalLeft d).comp (integralDiagonalKernel d).subtype

def integralDiagonalKernelRight (d : O) : integralDiagonalKernel d →* SL(2, O) :=
  (integralDiagonalRight d).comp (integralDiagonalKernel d).subtype

lemma integralDiagonalKernelLeft_le (d : O) : (integralDiagonalKernelLeft d).range ≤ globalKubotaKernel := by
  rintro M ⟨x, rfl⟩
  exact x.property.1

lemma integralDiagonalKernelRight_le (d : O) : (integralDiagonalKernelRight d).range ≤ globalKubotaKernel := by
  rintro M ⟨x, rfl⟩
  exact x.property.2

lemma integralDiagonalKernelLeft_injective (d : O) (hd : d ≠ 0) : Function.Injective (integralDiagonalKernelLeft d) :=
  (integralDiagonalLeft_injective d hd).comp (integralDiagonalKernel d).subtype_injective

lemma integralDiagonalKernelRight_injective (d : O) (hd : d ≠ 0) : Function.Injective (integralDiagonalKernelRight d) :=
  (integralDiagonalRight_injective d hd).comp (integralDiagonalKernel d).subtype_injective

lemma integralDiagonalKernel_finiteIndex (d : O) : (integralDiagonalKernel d).FiniteIndex := by
  letI := globalKubotaKernel_finiteIndex
  letI := finiteIndex_preimage globalKubotaKernel (integralDiagonalLeft d)
  letI := finiteIndex_preimage globalKubotaKernel (integralDiagonalRight d)
  unfold integralDiagonalKernel
  infer_instance

lemma integralDiagonalKernel_finite_covers (d : O) (hd : d ≠ 0) :
    (integralDiagonalKernelLeft d).range.FiniteIndex ∧ (integralDiagonalKernelRight d).range.FiniteIndex := by
  letI := integralDiagonalKernel_finiteIndex d
  letI := (integralDiagonal_finite_covers d hd).1
  letI := (integralDiagonal_finite_covers d hd).2
  constructor
  · rw [integralDiagonalKernelLeft, MonoidHom.range_comp, Subgroup.range_subtype]
    exact finiteIndex_image _ _ (integralDiagonalLeft_injective d hd)
  · rw [integralDiagonalKernelRight, MonoidHom.range_comp, Subgroup.range_subtype]
    exact finiteIndex_image _ _ (integralDiagonalRight_injective d hd)

def integralDiagonalKernelEquiv (d : O) (hd : d ≠ 0) :
    (integralDiagonalKernelLeft d).range ≃* (integralDiagonalKernelRight d).range :=
  (MonoidHom.ofInjective (integralDiagonalKernelLeft_injective d hd)).symm.trans
    (MonoidHom.ofInjective (integralDiagonalKernelRight_injective d hd))

lemma integralDiagonalKernel_pair (d : O) (hd : d ≠ 0) (M : (integralDiagonalKernelLeft d).range) :
    ((M : SL(2, O)), (integralDiagonalKernelEquiv d hd M : SL(2, O))) ∈ integralDiagonalCorrespondence d := by
  let x := (MonoidHom.ofInjective (integralDiagonalKernelLeft_injective d hd)).symm M
  have hx : integralDiagonalKernelLeft d x = M := MonoidHom.apply_ofInjective_symm _ M
  change ((M : SL(2, O)), integralDiagonalKernelRight d x) ∈ integralDiagonalCorrespondence d
  rw [← hx]
  exact x.1.property

lemma integralDiagonal_complex_intertwines (d : O) (hd : d ≠ 0) (z : ℂ) (hz : z ≠ 0)
    (hsq : z ^ 2 = ringComplex d) (MN : integralDiagonalCorrespondence d) :
    complexDiagonal z hz * integralComplexMatrix MN.1.1 =
      integralComplexMatrix MN.1.2 * complexDiagonal z hz := by
  have he := integralDiagonal_entries d MN
  have ha : MN.1.1 0 0 = MN.1.2 0 0 := mul_left_cancel₀ hd (he.1.trans (mul_comm _ _))
  have h01 := congrArg ringComplex he.2.1
  have h10 := congrArg ringComplex he.2.2.1
  have h11 := congrArg ringComplex he.2.2.2
  simp only [map_mul, ← hsq] at h01 h10
  have hentry (M : SL(2, O)) (i j : Fin 2) : integralComplexMatrix M i j = ringComplex (M i j) := rfl
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two, complexDiagonal, hentry]
  · rw [ha, mul_comm]
  · rw [← h01]
    field_simp [hz]
  · rw [h10]
    field_simp [hz]
  · rw [h11, mul_comm]

lemma integralDiagonalKernel_intertwines (d : O) (hd : d ≠ 0) (z : ℂ) (hz : z ≠ 0)
    (hsq : z ^ 2 = ringComplex d) : IntegralCoverIntertwines (integralDiagonalKernelEquiv d hd) (complexDiagonal z hz) := by
  intro M
  exact integralDiagonal_complex_intertwines d hd z hz hsq
    ⟨_, integralDiagonalKernel_pair d hd M⟩

namespace FiniteCorrespondenceCover
variable {G : Type*} [Group G] {ι : Type*}

/-- Intersect finitely many conjugated source subgroups inside the base group. -/
def common (K R : Subgroup G) (a : ι → G ≃* G) : Subgroup G := K ⊓ ⨅ i, R.comap (a i).toMonoidHom

lemma common_le (K R : Subgroup G) (a : ι → G ≃* G) : common K R a ≤ K := inf_le_left

lemma common_le_preimage (K R : Subgroup G) (a : ι → G ≃* G) (i : ι) :
    common K R a ≤ R.comap (a i).toMonoidHom := inf_le_right.trans (iInf_le _ i)

lemma common_finiteIndex [Finite ι] (K R : Subgroup G) (a : ι → G ≃* G)
    [K.FiniteIndex] [R.FiniteIndex] : (common K R a).FiniteIndex := by
  letI : (⨅ i, R.comap (a i).toMonoidHom).FiniteIndex :=
    Subgroup.finiteIndex_iInf (fun i => finiteIndex_preimage R (a i).toMonoidHom)
  unfold common
  infer_instance

def toSource (K R : Subgroup G) (a : ι → G ≃* G) (i : ι) : common K R a →* R where
  toFun h := ⟨a i (h : G), common_le_preimage K R a i h.property⟩
  map_one' := Subtype.ext (map_one (a i))
  map_mul' x y := Subtype.ext (map_mul (a i) (x : G) (y : G))

lemma toSource_injective (K R : Subgroup G) (a : ι → G ≃* G) (i : ι) : Function.Injective (toSource K R a i) := by
  intro x y hxy
  apply Subtype.ext
  exact (a i).injective (congrArg (fun r : R => (r : G)) hxy)

lemma toSource_range (K R : Subgroup G) (a : ι → G ≃* G) (i : ι) :
    (toSource K R a i).range = (common K R a).comap ((a i).symm.toMonoidHom.comp R.subtype) := by
  ext r
  constructor
  · rintro ⟨h, rfl⟩
    change (a i).symm (a i (h : G)) ∈ common K R a
    simpa only [MulEquiv.symm_apply_apply] using h.property
  · intro hr
    refine ⟨⟨(a i).symm (r : G), hr⟩, ?_⟩
    apply Subtype.ext
    exact (a i).apply_symm_apply (r : G)

lemma toSource_range_finiteIndex [Finite ι] (K R : Subgroup G) (a : ι → G ≃* G)
    [K.FiniteIndex] [R.FiniteIndex] (i : ι) : (toSource K R a i).range.FiniteIndex := by
  letI := common_finiteIndex K R a
  rw [toSource_range]
  exact finiteIndex_preimage _ _

def hom (K R L : Subgroup G) (a : ι → G ≃* G) (e : R ≃* L) (i : ι) : common K R a →* G :=
  L.subtype.comp (e.toMonoidHom.comp (toSource K R a i))

lemma hom_injective (K R L : Subgroup G) (a : ι → G ≃* G) (e : R ≃* L) (i : ι) :
    Function.Injective (hom K R L a e i) := L.subtype_injective.comp (e.injective.comp (toSource_injective K R a i))

def target (K R L : Subgroup G) (a : ι → G ≃* G) (e : R ≃* L) (i : ι) : Subgroup G := (hom K R L a e i).range

lemma target_le (K R L : Subgroup G) (a : ι → G ≃* G) (e : R ≃* L) (i : ι) : target K R L a e i ≤ L := by
  rintro x ⟨h, rfl⟩
  exact (e (toSource K R a i h)).property

lemma target_finiteIndex [Finite ι] (K R L : Subgroup G) (a : ι → G ≃* G) (e : R ≃* L)
    [K.FiniteIndex] [R.FiniteIndex] [L.FiniteIndex] (i : ι) : (target K R L a e i).FiniteIndex := by
  letI := toSource_range_finiteIndex K R a i
  constructor
  rw [target, hom, MonoidHom.range_comp, MonoidHom.range_comp, Subgroup.index_map_subtype,
    Subgroup.index_map_of_bijective (f := e.toMonoidHom) e.bijective]
  exact mul_ne_zero (Subgroup.FiniteIndex.index_ne_zero (H := (toSource K R a i).range))
    (Subgroup.FiniteIndex.index_ne_zero (H := L))

def equiv (K R L : Subgroup G) (a : ι → G ≃* G) (e : R ≃* L) (i : ι) : common K R a ≃* target K R L a e i :=
  MonoidHom.ofInjective (hom_injective K R L a e i)

lemma equiv_coe (K R L : Subgroup G) (a : ι → G ≃* G) (e : R ≃* L) (i : ι) (h : common K R a) :
    (equiv K R L a e i h : G) = (e (toSource K R a i h) : G) := rfl

end FiniteCorrespondenceCover

abbrev CubeResidues (p : O) := O ⧸ Ideal.span {p ^ 3}

def cubeResidueRepresentative (p : O) (r : CubeResidues p) : O := Classical.choose (Ideal.Quotient.mk_surjective r)

lemma cubeResidueRepresentative_spec (p : O) (r : CubeResidues p) :
    Ideal.Quotient.mk (Ideal.span {p ^ 3}) (cubeResidueRepresentative p r) = r :=
  Classical.choose_spec (Ideal.Quotient.mk_surjective r)

def cubeCommonAutomorphism (p : O) (r : CubeResidues p) : SL(2, O) ≃* SL(2, O) :=
  MulAut.conj (integralTranslation (3 * cubeResidueRepresentative p r))

/-- A single integral cover supports all translated cube-dilation branches. -/
def cubeCommonCover (p : O) : Subgroup (SL(2, O)) :=
  FiniteCorrespondenceCover.common globalKubotaKernel (integralDiagonalKernelRight (p ^ 3)).range
    (cubeCommonAutomorphism p)

lemma cubeCommonCover_le (p : O) : cubeCommonCover p ≤ globalKubotaKernel :=
  FiniteCorrespondenceCover.common_le _ _ _

lemma cubeCommonCover_finiteIndex (p : O) (hp : p ≠ 0) : (cubeCommonCover p).FiniteIndex := by
  letI := globalKubotaKernel_finiteIndex
  letI : Finite (CubeResidues p) := (Ideal.span {p ^ 3}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr (pow_ne_zero 3 hp))
  letI := (integralDiagonalKernel_finite_covers (p ^ 3) (pow_ne_zero 3 hp)).2
  exact FiniteCorrespondenceCover.common_finiteIndex _ _ _

def cubeCommonTarget (p : O) (hp : p ≠ 0) (r : CubeResidues p) : Subgroup (SL(2, O)) :=
  FiniteCorrespondenceCover.target globalKubotaKernel (integralDiagonalKernelRight (p ^ 3)).range
    (integralDiagonalKernelLeft (p ^ 3)).range (cubeCommonAutomorphism p)
    (integralDiagonalKernelEquiv (p ^ 3) (pow_ne_zero 3 hp)).symm r

lemma cubeCommonTarget_le (p : O) (hp : p ≠ 0) (r : CubeResidues p) : cubeCommonTarget p hp r ≤ globalKubotaKernel :=
  (FiniteCorrespondenceCover.target_le _ _ _ _ _ r).trans (integralDiagonalKernelLeft_le (p ^ 3))

lemma cubeCommonTarget_finiteIndex (p : O) (hp : p ≠ 0) (r : CubeResidues p) :
    (cubeCommonTarget p hp r).FiniteIndex := by
  letI := globalKubotaKernel_finiteIndex
  letI : Finite (CubeResidues p) := (Ideal.span {p ^ 3}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr (pow_ne_zero 3 hp))
  letI := (integralDiagonalKernel_finite_covers (p ^ 3) (pow_ne_zero 3 hp)).1
  letI := (integralDiagonalKernel_finite_covers (p ^ 3) (pow_ne_zero 3 hp)).2
  exact FiniteCorrespondenceCover.target_finiteIndex _ _ _ _ _ r

def cubeCommonEquiv (p : O) (hp : p ≠ 0) (r : CubeResidues p) : cubeCommonCover p ≃* cubeCommonTarget p hp r :=
  FiniteCorrespondenceCover.equiv globalKubotaKernel (integralDiagonalKernelRight (p ^ 3)).range
    (integralDiagonalKernelLeft (p ^ 3)).range (cubeCommonAutomorphism p)
    (integralDiagonalKernelEquiv (p ^ 3) (pow_ne_zero 3 hp)).symm r

def cubeDilationRoot (p : O) : ℂ :=
  Classical.choose (IsAlgClosed.exists_pow_nat_eq (ringComplex (p ^ 3)) (by norm_num : 0 < 2))

lemma cubeDilationRoot_sq (p : O) : cubeDilationRoot p ^ 2 = ringComplex (p ^ 3) :=
  Classical.choose_spec (IsAlgClosed.exists_pow_nat_eq (ringComplex (p ^ 3)) (by norm_num : 0 < 2))

lemma cubeDilationRoot_ne_zero (p : O) (hp : p ≠ 0) : cubeDilationRoot p ≠ 0 := by
  intro hz
  have hs := cubeDilationRoot_sq p
  rw [hz, zero_pow (by norm_num)] at hs
  exact ringComplex_ne_zero (pow_ne_zero 3 hp) hs.symm

def cubeDilationMatrix (p : O) (hp : p ≠ 0) : SL(2, ℂ) := complexDiagonal (cubeDilationRoot p) (cubeDilationRoot_ne_zero p hp)

def cubeAverageMatrix (p : O) (hp : p ≠ 0) (q : O) : SL(2, ℂ) :=
  (cubeDilationMatrix p hp)⁻¹ * integralComplexMatrix (integralTranslation (3 * q))

lemma cubeDilation_intertwines (p : O) (hp : p ≠ 0) :
    IntegralCoverIntertwines (integralDiagonalKernelEquiv (p ^ 3) (pow_ne_zero 3 hp)) (cubeDilationMatrix p hp) :=
  integralDiagonalKernel_intertwines (p ^ 3) (pow_ne_zero 3 hp) _ (cubeDilationRoot_ne_zero p hp) (cubeDilationRoot_sq p)

/-- Every translated dilation acts between the two explicit finite-index subgroup quotients. -/
lemma cubeCommon_intertwines (p : O) (hp : p ≠ 0) (r : CubeResidues p) :
    IntegralCoverIntertwines (cubeCommonEquiv p hp r)
      (cubeAverageMatrix p hp (cubeResidueRepresentative p r)) := by
  intro h
  let T := integralTranslation (3 * cubeResidueRepresentative p r)
  let x := FiniteCorrespondenceCover.toSource globalKubotaKernel
    (integralDiagonalKernelRight (p ^ 3)).range (cubeCommonAutomorphism p) r h
  let e := integralDiagonalKernelEquiv (p ^ 3) (pow_ne_zero 3 hp)
  have hT : T * (h : SL(2, O)) = (x : SL(2, O)) * T := by
    change T * (h : SL(2, O)) = (T * (h : SL(2, O)) * T⁻¹) * T
    simp only [mul_assoc, inv_mul_cancel, mul_one]
  have hx := integralCoverIntertwines_inverse e (cubeDilationMatrix p hp) (cubeDilation_intertwines p hp) x
  change ((cubeDilationMatrix p hp)⁻¹ * integralComplexMatrix T) * integralComplexMatrix (h : SL(2, O)) =
    integralComplexMatrix (e.symm x : SL(2, O)) * ((cubeDilationMatrix p hp)⁻¹ * integralComplexMatrix T)
  rw [mul_assoc, ← map_mul, hT, map_mul, ← mul_assoc, hx, mul_assoc]

def cubeCommonLeg (p : O) (hp : p ≠ 0) (r : CubeResidues p) : KernelQuotientL2 →L[ℂ] IntegralQuotientL2 (cubeCommonCover p) := by
  letI := cubeCommonTarget_finiteIndex p hp r
  letI : (cubeCommonTarget p hp r).IsFiniteRelIndex globalKubotaKernel := Subgroup.isFiniteRelIndex_of_finiteIndex
  exact kernelCoverLeg (cubeCommonCover_le p) (cubeCommonTarget_le p hp r) (cubeCommonEquiv p hp r)
    (cubeAverageMatrix p hp (cubeResidueRepresentative p r)) (cubeCommon_intertwines p hp r)

lemma integralProjection_translates_disjoint (H : Subgroup (SL(2, O))) (hH : H ≤ levelThree)
    (S : Set HyperbolicSpace) (hinj : Set.InjOn (integralOrbitProjection H) S) :
    Pairwise (fun M N : H => Disjoint (M • S) (N • S)) := by
  letI : IsCancelSMul H HyperbolicSpace := integralSubgroupFree H hH
  intro M N hMN
  apply Set.disjoint_left.mpr
  rintro _ ⟨w, hw, rfl⟩ ⟨u, hu, he⟩
  have hwu : w = u := hinj hw hu (by
    calc
      integralOrbitProjection H w = integralOrbitProjection H (M • w) := (integralOrbitProjection_eq H M w).symm
      _ = integralOrbitProjection H (N • u) := congrArg _ he.symm
      _ = integralOrbitProjection H u := integralOrbitProjection_eq H N u)
  subst u
  exact hMN (IsCancelSMul.right_cancel M N w he.symm)

lemma integralProjection_measure_image (H : Subgroup (SL(2, O))) (hH : H ≤ levelThree)
    (S : Set HyperbolicSpace) (hS : MeasurableSet S) (hinj : Set.InjOn (integralOrbitProjection H) S) :
    integralQuotientVolume H (integralOrbitProjection H '' S) = hyperbolicVolume S := by
  have himg := hS.image_of_continuousOn_injOn (continuous_integralOrbitProjection H).continuousOn hinj
  rw [integralQuotientVolume, Measure.map_apply (measurable_integralOrbitProjection _) himg,
    Measure.restrict_apply ((measurable_integralOrbitProjection _) himg),
    integralOrbitProjection_preimage_image, Set.iUnion_inter]
  rw [measure_iUnion]
  · exact ((hyperbolicFundamentalSet_isFundamentalDomain H hH hyperbolicVolume).measure_eq_tsum S).symm
  · intro M N hMN
    exact (integralProjection_translates_disjoint H hH S hinj hMN).mono Set.inter_subset_left Set.inter_subset_left
  · intro M
    exact (hS.const_smul M).inter (hyperbolicFundamentalSet_measurable _)

/-- An injective measurable chart transports hyperbolic volume exactly to any level-three subgroup quotient. -/
theorem integralProjection_measurePreserving_on (H : Subgroup (SL(2, O))) (hH : H ≤ levelThree)
    (U : Set HyperbolicSpace) (hU : MeasurableSet U) (hinj : Set.InjOn (integralOrbitProjection H) U) :
    MeasurePreserving (integralOrbitProjection H) (hyperbolicVolume.restrict U)
      ((integralQuotientVolume H).restrict (integralOrbitProjection H '' U)) := by
  refine ⟨measurable_integralOrbitProjection _, ?_⟩
  apply Measure.ext
  intro B hB
  rw [Measure.map_apply (measurable_integralOrbitProjection _) hB,
    Measure.restrict_apply ((measurable_integralOrbitProjection _) hB), Measure.restrict_apply hB]
  have he : B ∩ (integralOrbitProjection H '' U) =
      integralOrbitProjection H '' (integralOrbitProjection H ⁻¹' B ∩ U) := by
    ext q
    constructor
    · rintro ⟨hq, w, hw, rfl⟩
      exact ⟨w, ⟨hq, hw⟩, rfl⟩
    · rintro ⟨w, ⟨hw, hu⟩, rfl⟩
      exact ⟨hw, ⟨w, hu, rfl⟩⟩
  rw [he, integralProjection_measure_image H hH _ (((measurable_integralOrbitProjection _) hB).inter hU)
    (hinj.mono Set.inter_subset_right)]

lemma integralProjection_cuspPeriodRegion_injective (H : Subgroup (SL(2, O))) (hH : H ≤ levelThree) :
    Set.InjOn (integralOrbitProjection H) cuspPeriodRegion := by
  intro u hu v hv he
  obtain ⟨M, hM⟩ := (integralOrbitProjection_eq_iff H u v).mp he
  have hMu : integralComplexMatrix (M : SL(2, O)) • v = u := hM
  have hc : (M : SL(2, O)) 1 0 = 0 := by
    by_contra hn
    have hb := integral_hyperbolicHeight_mul_le_one (M : SL(2, O)) hn v
    rw [hMu] at hb
    have hhu : 1 < hyperbolicHeight u := hu.2
    have hhv : 1 < hyperbolicHeight v := hv.2
    nlinarith only [hb, hhu, hhv, mul_pos (sub_pos.mpr hhu) (sub_pos.mpr hhv)]
  let N : levelThree := ⟨M, hH M.property⟩
  have ht := levelThree_integral_eq_translation N hc
  obtain ⟨z, t, htpos, hvrep⟩ := upperPoint_surjective v
  have hua : u = upperPoint (z + ringComplex ((M : SL(2, O)) 0 1)) t htpos := by
    rw [← hMu, ← hvrep, ht, complexTranslation_action]
  have hvl : hyperbolicHorizontal v = z := by rw [← hvrep, hyperbolicHorizontal_upperPoint]
  have hul : hyperbolicHorizontal u = z + ringComplex ((M : SL(2, O)) 0 1) := by
    rw [hua, hyperbolicHorizontal_upperPoint]
  obtain ⟨k, hk⟩ := levelThree_upper N
  have hp : ringComplex ((M : SL(2, O)) 0 1) ∈ periodLattice := by
    change ringComplex ((N : levelThree).1 0 1) ∈ periodLattice
    rw [hk, map_mul, map_ofNat]
    exact three_embedding_mem k
  have hz := periodDomain_unique_translate _ _ _ hu.1 hv.1 hp (by rw [hul, hvl])
  have hez : z + ringComplex ((M : SL(2, O)) 0 1) = z := by simpa only [hul, hvl] using hz
  rw [hua, hez, ← hvrep]

lemma integralProjection_cuspPeriodStrip_injective (H : Subgroup (SL(2, O))) (hH : H ≤ levelThree)
    (a b : ℝ) (ha : 1 < a) : Set.InjOn (integralOrbitProjection H) (cuspPeriodStrip a b) := by
  apply (integralProjection_cuspPeriodRegion_injective H hH).mono
  intro w hw
  exact ⟨hw.1, ha.trans_le hw.2.1⟩

lemma integralProjection_cuspPeriodStrip_measurePreserving (H : Subgroup (SL(2, O))) (hH : H ≤ levelThree)
    (a b : ℝ) (ha : 1 < a) :
    MeasurePreserving (integralOrbitProjection H) (hyperbolicVolume.restrict (cuspPeriodStrip a b))
      ((integralQuotientVolume H).restrict (integralOrbitProjection H '' cuspPeriodStrip a b)) := by
  apply integralProjection_measurePreserving_on H hH _ (cuspPeriodStrip_measurable a b)
  exact integralProjection_cuspPeriodStrip_injective H hH a b ha

lemma integralCoverTraceFunction_continuous (H K : Subgroup (SL(2, O))) [H.IsFiniteRelIndex K]
    (f : IntegralOrbitQuotient H → ℂ) (hf : Continuous f) : Continuous (integralCoverTraceFunction H K f) := by
  letI : Fintype (IntegralCoverCosets H K) := Fintype.ofFinite _
  have hc : Continuous (integralCoverTraceLift H K f) :=
    continuous_finsetSum Finset.univ (fun q _ => hf.comp (integralCoverFiberPoint_continuous H K q))
  exact hc.quotient_lift _

section CuspAverageOrthogonality
local instance kernelLevelFiniteCover : globalKubotaKernel.IsFiniteRelIndex levelThree := by
  letI := globalKubotaKernel_finiteIndex
  exact Subgroup.isFiniteRelIndex_of_finiteIndex

/-- Fiber trace of the pairing with a fixed compact-height defect. -/
def kernelDefectTrace (f : KernelQuotient → ℂ) : IntegralOrbitQuotient levelThree → ℂ :=
  integralCoverTraceFunction globalKubotaKernel levelThree
    (fun q => star (f q) * kernelQuotientDefect 5 6 (4 / 3) q)

lemma kernelDefectTrace_continuous (f : KernelQuotient → ℂ) (hf : Continuous f) : Continuous (kernelDefectTrace f) :=
  integralCoverTraceFunction_continuous _ _ _
    (hf.star.mul (kernelQuotientDefect_contMDiff 5 6 (4 / 3) (by norm_num) (by norm_num)).continuous)

lemma kernelDefectTrace_integral (f : KernelQuotient → ℂ) (hf : Continuous f) :
    (∫ q, kernelDefectTrace f q ∂integralQuotientVolume levelThree) =
      ∫ q, star (f q) * kernelQuotientDefect 5 6 (4 / 3) q ∂integralQuotientVolume globalKubotaKernel := by
  apply integralCoverTraceFunction_integral globalKubotaKernel_le_levelThree le_rfl
  · exact hf.star.measurable.mul (kernelQuotientDefect_measurable 5 6 (4 / 3) (by norm_num) (by norm_num))
  · apply (hf.star.mul (kernelQuotientDefect_contMDiff 5 6 (4 / 3) (by norm_num) (by norm_num)).continuous).integrable_of_hasCompactSupport
    exact (kernelQuotientDefect_hasCompactSupport 5 6 (by norm_num) (by norm_num) (4 / 3)).mul_left

lemma kernelDefectTrace_upper (f : KernelQuotient → ℂ) (z : ℂ) (v : ℝ) (hv : 0 < v) (hv1 : 1 < v) :
    kernelDefectTrace f (integralOrbitProjection levelThree (upperPoint z v hv)) =
      letI : Fintype (IntegralCoverCosets globalKubotaKernel levelThree) := Fintype.ofFinite _
      ∑ r : IntegralCoverCosets globalKubotaKernel levelThree,
        (star (f (integralOrbitProjection globalKubotaKernel
          (complexMatrix ((integralCoverRep globalKubotaKernel levelThree r)⁻¹) • upperPoint z v hv))) *
            complexCharacter ((integralCoverRep globalKubotaKernel levelThree r)⁻¹)) *
              cuspSeedDefectProfile 5 6 (4 / 3) v := by
  letI : Fintype (IntegralCoverCosets globalKubotaKernel levelThree) := Fintype.ofFinite _
  change (∑ r : IntegralCoverCosets globalKubotaKernel levelThree,
    star (f (integralCoverFiberPoint globalKubotaKernel levelThree r (upperPoint z v hv))) *
      kernelQuotientDefect 5 6 (4 / 3) (integralCoverFiberPoint globalKubotaKernel levelThree r (upperPoint z v hv))) = _
  apply Finset.sum_congr rfl
  intro r _
  rw [integralCoverFiberPoint_rep, integralSubgroup_smul, integralComplexMatrix_levelThree]
  change star (f (integralOrbitProjection globalKubotaKernel
    (complexMatrix ((integralCoverRep globalKubotaKernel levelThree r)⁻¹) • upperPoint z v hv))) *
      cuspCutoffCorrection 1 (cuspSeedDefectProfile 5 6 (4 / 3))
        (complexMatrix ((integralCoverRep globalKubotaKernel levelThree r)⁻¹) • upperPoint z v hv) = _
  rw [cuspCutoffCorrection_automorphy 1 le_rfl, cuspCutoffCorrection_upperPoint _ z v hv hv1]
  exact (mul_assoc _ _ _).symm

lemma kernelDefectTrace_average_zero (f : KernelQuotient → ℂ) (hf : Continuous f)
    (v : ℝ) (hv : 0 < v) (hv1 : 1 < v)
    (havg : ∀ M : levelThree, (∫ z in periodDomain,
      f (integralOrbitProjection globalKubotaKernel (complexMatrix M • upperPoint z v hv))) = 0) :
    (∫ z in periodDomain, kernelDefectTrace f (integralOrbitProjection levelThree (upperPoint z v hv))) = 0 := by
  letI := periodDomain_finiteMeasure
  letI : Fintype (IntegralCoverCosets globalKubotaKernel levelThree) := Fintype.ofFinite _
  have hc (M : levelThree) : Continuous (fun z : ℂ =>
      f (integralOrbitProjection globalKubotaKernel (complexMatrix M • upperPoint z v hv))) :=
    ((hf.comp (continuous_integralOrbitProjection _)).comp (continuous_hyperbolic_action _)).comp
      (upperCoordinatesHomeomorph.continuous.comp
        (show Continuous (fun z : ℂ => (⟨(z, v), hv⟩ : UpperCoordinates)) by fun_prop))
  simp_rw [kernelDefectTrace_upper f _ v hv hv1]
  have hi (r : IntegralCoverCosets globalKubotaKernel levelThree) : Integrable
      (fun z : ℂ => (star (f (integralOrbitProjection globalKubotaKernel
        (complexMatrix ((integralCoverRep globalKubotaKernel levelThree r)⁻¹) • upperPoint z v hv))) *
          complexCharacter ((integralCoverRep globalKubotaKernel levelThree r)⁻¹)) *
            cuspSeedDefectProfile 5 6 (4 / 3) v) (volume.restrict periodDomain) := by
    apply (periodDomain_continuous_memLp _ ?_).integrable (by norm_num)
    exact (((hc ((integralCoverRep globalKubotaKernel levelThree r)⁻¹)).star.mul continuous_const).mul continuous_const)
  rw [integral_finsetSum Finset.univ (fun r _ => hi r)]
  apply Finset.sum_eq_zero
  intro r _
  rw [integral_mul_const, integral_mul_const]
  have hstar : (∫ z in periodDomain,
      star (f (integralOrbitProjection globalKubotaKernel
        (complexMatrix ((integralCoverRep globalKubotaKernel levelThree r)⁻¹) • upperPoint z v hv)))) =
      star (∫ z in periodDomain, f (integralOrbitProjection globalKubotaKernel
        (complexMatrix ((integralCoverRep globalKubotaKernel levelThree r)⁻¹) • upperPoint z v hv))) := by
    simp only [Complex.star_def]
    exact integral_conj
  rw [hstar, havg, star_zero, zero_mul, zero_mul]

lemma kernelDefectTrace_strip_integral_zero (f : KernelQuotient → ℂ) (hf : Continuous f)
    (havg : ∀ M : levelThree, ∀ v : ℝ, ∀ hv : 0 < v, 1 < v →
      (∫ z in periodDomain, f (integralOrbitProjection globalKubotaKernel (complexMatrix M • upperPoint z v hv))) = 0) :
    (∫ w in cuspPeriodStrip 5 6, kernelDefectTrace f (integralOrbitProjection levelThree w) ∂hyperbolicVolume) = 0 := by
  let G : HyperbolicSpace → ℂ := fun w => kernelDefectTrace f (integralOrbitProjection levelThree w)
  have hg : Continuous G := (kernelDefectTrace_continuous f hf).comp (continuous_integralOrbitProjection _)
  change (∫ w in cuspPeriodStrip 5 6, G w ∂hyperbolicVolume) = 0
  rw [cuspPeriodStrip_integral_coordinates G hg.aestronglyMeasurable (cuspCoordinateLift_weighted_integrable G hg)]
  calc
    _ = ∫ v in Set.Icc (5 : ℝ) 6, (0 : ℂ) := by
      apply setIntegral_congr_fun measurableSet_Icc
      intro v hv
      have hp : 0 < v := lt_of_lt_of_le (by norm_num) hv.1
      have h1 : 1 < v := lt_of_lt_of_le (by norm_num) hv.1
      have hz := kernelDefectTrace_average_zero f hf v hp h1 (fun M => havg M v hp h1)
      simp only [G, cuspCoordinateLift_positive v _ hp]
      rw [hz, zero_div]
    _ = 0 := by simp only [integral_zero]

lemma periodDomain_reduction (z : ℂ) : ∃ n : O, z + 3 * ringComplex n ∈ periodDomain := by
  obtain ⟨p, hp, _⟩ := ZSpan.exist_unique_vadd_mem_fundamentalDomain periodBasis z
  obtain ⟨n, rfl⟩ := periodEquiv.surjective p
  change 3 * ringComplex n + z ∈ periodDomain at hp
  exact ⟨n, by simpa only [add_comm] using hp⟩

lemma levelProjection_mem_cuspStrip_of_height (w : HyperbolicSpace)
    (hw : hyperbolicHeight w ∈ Set.Icc (5 : ℝ) 6) :
    integralOrbitProjection levelThree w ∈ integralOrbitProjection levelThree '' cuspPeriodStrip 5 6 := by
  obtain ⟨z, v, hv, rfl⟩ := upperPoint_surjective w
  obtain ⟨n, hn⟩ := periodDomain_reduction z
  refine ⟨upperPoint (z + 3 * ringComplex n) v hv, ?_, ?_⟩
  · exact ⟨by simpa only [hyperbolicHorizontal_upperPoint] using hn,
      by simpa only [hyperbolicHeight_upperPoint] using hw⟩
  · exact congrArg (integralCoverMap globalKubotaKernel_le_levelThree)
      (kernelProjection_upper_period v hv z n)

lemma smoothCuspSeedDefect_support_levelStrip (w : HyperbolicSpace)
    (hw : smoothCuspSeedDefect 5 6 (4 / 3) w ≠ 0) :
    integralOrbitProjection levelThree w ∈ integralOrbitProjection levelThree '' cuspPeriodStrip 5 6 := by
  obtain ⟨r, hr⟩ := smoothCuspSeedDefect_support 5 6 (4 / 3) (by norm_num) w hw
  induction r using Quotient.inductionOn with
  | _ M =>
    change (5 : ℝ) ≤ cosetHeight (cosetOf M) w ∧ cosetHeight (cosetOf M) w ≤ 6 at hr
    rw [cosetHeight_cosetOf] at hr
    have hm := levelProjection_mem_cuspStrip_of_height (complexMatrix M • w) hr
    simpa only [← integralComplexMatrix_levelThree, integralOrbitProjection_eq] using hm

/-- The finite character trace is supported in one ordinary cusp strip. -/
lemma kernelDefectTrace_support (f : KernelQuotient → ℂ) (q : IntegralOrbitQuotient levelThree)
    (hq : kernelDefectTrace f q ≠ 0) :
    q ∈ integralOrbitProjection levelThree '' cuspPeriodStrip 5 6 := by
  letI : Fintype (IntegralCoverCosets globalKubotaKernel levelThree) := Fintype.ofFinite _
  induction q using Quotient.inductionOn with
  | _ w =>
    change integralOrbitProjection levelThree w ∈ integralOrbitProjection levelThree '' cuspPeriodStrip 5 6
    change (∑ r : IntegralCoverCosets globalKubotaKernel levelThree,
      star (f (integralCoverFiberPoint globalKubotaKernel levelThree r w)) *
        kernelQuotientDefect 5 6 (4 / 3) (integralCoverFiberPoint globalKubotaKernel levelThree r w)) ≠ 0 at hq
    obtain ⟨r, _, hr⟩ := Finset.exists_ne_zero_of_sum_ne_zero hq
    have hd := (mul_ne_zero_iff.mp hr).2
    rw [integralCoverFiberPoint_rep, integralSubgroup_smul, integralComplexMatrix_levelThree] at hd
    have hs := smoothCuspSeedDefect_support_levelStrip
      (complexMatrix ((integralCoverRep globalKubotaKernel levelThree r)⁻¹) • w) hd
    simpa only [← integralComplexMatrix_levelThree, integralOrbitProjection_eq] using hs

lemma kernelDefectTrace_integral_zero (f : KernelQuotient → ℂ) (hf : Continuous f)
    (havg : ∀ M : levelThree, ∀ v : ℝ, ∀ hv : 0 < v, 1 < v →
      (∫ z in periodDomain, f (integralOrbitProjection globalKubotaKernel (complexMatrix M • upperPoint z v hv))) = 0) :
    (∫ q, kernelDefectTrace f q ∂integralQuotientVolume levelThree) = 0 := by
  let S := integralOrbitProjection levelThree '' cuspPeriodStrip 5 6
  have hS : MeasurableSet S := (cuspPeriodStrip_measurable 5 6).image_of_continuousOn_injOn
    (continuous_integralOrbitProjection levelThree).continuousOn
    (integralProjection_cuspPeriodStrip_injective levelThree le_rfl 5 6 (by norm_num))
  have he : S.indicator (kernelDefectTrace f) = kernelDefectTrace f := by
    funext q
    by_cases hq : q ∈ S
    · exact Set.indicator_of_mem hq _
    · rw [Set.indicator_of_notMem hq]
      exact (not_not.mp (fun hn => hq (kernelDefectTrace_support f q hn))).symm
  calc
    _ = ∫ q in S, kernelDefectTrace f q ∂integralQuotientVolume levelThree := by
      rw [← integral_indicator hS, he]
    _ = ∫ w in cuspPeriodStrip 5 6,
        kernelDefectTrace f (integralOrbitProjection levelThree w) ∂hyperbolicVolume := by
      rw [← (integralProjection_cuspPeriodStrip_measurePreserving levelThree le_rfl 5 6 (by norm_num)).map_eq]
      exact integral_map (measurable_integralOrbitProjection _).aemeasurable
        (kernelDefectTrace_continuous f hf).aestronglyMeasurable
    _ = 0 := kernelDefectTrace_strip_integral_zero f hf havg

lemma kernelL2Defect_inner_zero_of_cusp_averages (F : KernelQuotientL2)
    (f : KernelQuotient → ℂ) (hf : Continuous f)
    (hrep : F =ᵐ[integralQuotientVolume globalKubotaKernel] f)
    (havg : ∀ M : levelThree, ∀ v : ℝ, ∀ hv : 0 < v, 1 < v →
      (∫ z in periodDomain, f (integralOrbitProjection globalKubotaKernel (complexMatrix M • upperPoint z v hv))) = 0) :
    inner ℂ F (kernelL2Defect 5 6 (by norm_num) (by norm_num) (4 / 3)) = 0 := by
  rw [L2.inner_def]
  calc
    _ = ∫ q, star (f q) * kernelQuotientDefect 5 6 (4 / 3) q ∂integralQuotientVolume globalKubotaKernel := by
      apply integral_congr_ae
      filter_upwards [hrep, kernelL2Defect_ae_eq 5 6 (by norm_num) (by norm_num) (4 / 3)] with q hq hd
      rw [hq, hd, RCLike.inner_apply, starRingEnd_apply, mul_comm]
    _ = ∫ q, kernelDefectTrace f q ∂integralQuotientVolume levelThree := (kernelDefectTrace_integral f hf).symm
    _ = 0 := kernelDefectTrace_integral_zero f hf havg

/-- Vanishing cusp averages annihilate the residue pairing at eigenvalue eight ninths. -/
theorem cubicEisensteinResidue_orthogonal_of_zero_cusp_averages
    (F : KernelQuotientL2) (hF : (F, (8 / 9 : ℂ) • F) ∈ kernelEnergyLaplacian.graph)
    (f : KernelQuotient → ℂ) (hf : Continuous f)
    (hrep : F =ᵐ[integralQuotientVolume globalKubotaKernel] f)
    (havg : ∀ M : levelThree, ∀ v : ℝ, ∀ hv : 0 < v, 1 < v →
      (∫ z in periodDomain, f (integralOrbitProjection globalKubotaKernel (complexMatrix M • upperPoint z v hv))) = 0) :
    inner ℂ F cubicEisensteinResidue = 0 := by
  have he : cubicEisensteinResidue = kernelEisensteinResidueVector 5 6 (by norm_num) (by norm_num) :=
    kernelEisensteinResidueVector_cutoff_independent 2 3 5 6 (by norm_num) (by norm_num) (by norm_num) (by norm_num)
  rw [he, kernelEisensteinResidueVector_pairing _ _ _ _ F hF,
    kernelL2Defect_inner_zero_of_cusp_averages F f hf hrep havg, mul_zero]

lemma cubicEisensteinResidue_translate_orthogonal_of_zero_averages
    (F : KernelQuotientL2) (hF : (F, (8 / 9 : ℂ) • F) ∈ kernelEnergyLaplacian.graph)
    (f : KernelQuotient → ℂ) (hf : Continuous f)
    (hrep : F =ᵐ[integralQuotientVolume globalKubotaKernel] f)
    (havg : ∀ N : SL(2, O), ∀ v : ℝ, ∀ hv : 0 < v, 1 < v →
      (∫ z in periodDomain, f (integralOrbitProjection globalKubotaKernel (integralComplexMatrix N • upperPoint z v hv))) = 0)
    (g : rationalExtension) : inner ℂ F (kernelRationalPullback g cubicEisensteinResidue) = 0 := by
  rw [kernelRationalPullback_pairing_inverse]
  have hrepG : kernelRationalPullback g⁻¹ F =ᵐ[integralQuotientVolume globalKubotaKernel]
      fun q => f (kernelRationalAction g⁻¹ q) :=
    (kernelRationalPullback_ae g⁻¹ F).trans
      ((kernelRationalAction_measurePreserving g⁻¹).quasiMeasurePreserving.ae_eq_comp hrep)
  apply cubicEisensteinResidue_orthogonal_of_zero_cusp_averages _
    (kernelRational_eigenvector g⁻¹ F (8 / 9) hF) _ (hf.comp (kernelRationalAction_continuous _)) hrepG
  intro N v hv hlarge
  simpa only [Function.comp_apply, kernelRationalAction_mk, map_mul, mul_smul, integralComplexMatrix_levelThree] using
    havg ((g⁻¹ : rationalExtension) * (N : SL(2, O))) v hv hlarge

theorem cubicSourceResidue_orthogonal_of_zero_integral_cusp_averages
    (F : KernelQuotientL2) (hF : (F, (8 / 9 : ℂ) • F) ∈ kernelEnergyLaplacian.graph)
    (f : KernelQuotient → ℂ) (hf : Continuous f)
    (hrep : F =ᵐ[integralQuotientVolume globalKubotaKernel] f)
    (havg : ∀ N : SL(2, O), ∀ v : ℝ, ∀ hv : 0 < v, 1 < v →
      (∫ z in periodDomain, f (integralOrbitProjection globalKubotaKernel (integralComplexMatrix N • upperPoint z v hv))) = 0) :
    inner ℂ F (kernelRationalSourceProjection cubicEisensteinResidue) = 0 := by
  rw [kernelRationalSourceProjection_apply, inner_smul_right, inner_sum]
  simp only [cubicEisensteinResidue_translate_orthogonal_of_zero_averages F hF f hf hrep havg,
    Finset.sum_const_zero, mul_zero]

/-- A finite correspondence combination vanishes if every adjoint has zero cusp averages. -/
theorem commonCover_source_span_vanish_of_zero_averages
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    {ι : Type*} [Fintype ι] (leg : ι → KernelQuotientL2 →L[ℂ] E) (c : ι → ℂ) (D : E)
    (hD : D = ∑ i, c i • leg i (kernelRationalSourceProjection cubicEisensteinResidue))
    (hEig : ∀ i, (ContinuousLinearMap.adjoint (leg i) D,
      (8 / 9 : ℂ) • ContinuousLinearMap.adjoint (leg i) D) ∈ kernelEnergyLaplacian.graph)
    (f : ι → KernelQuotient → ℂ) (hf : ∀ i, Continuous (f i))
    (hrep : ∀ i, ContinuousLinearMap.adjoint (leg i) D =ᵐ[integralQuotientVolume globalKubotaKernel] f i)
    (havg : ∀ i, ∀ N : SL(2, O), ∀ v : ℝ, ∀ hv : 0 < v, 1 < v →
      (∫ z in periodDomain, f i (integralOrbitProjection globalKubotaKernel (integralComplexMatrix N • upperPoint z v hv))) = 0) :
    D = 0 := by
  apply (inner_self_eq_zero (𝕜 := ℂ)).mp
  calc
    inner ℂ D D = inner ℂ D (∑ i, c i • leg i (kernelRationalSourceProjection cubicEisensteinResidue)) :=
      congrArg (inner ℂ D) hD
    _ = ∑ i, c i * inner ℂ D (leg i (kernelRationalSourceProjection cubicEisensteinResidue)) := by
      simp only [inner_sum, inner_smul_right]
    _ = 0 := by
      apply Finset.sum_eq_zero
      intro i _
      rw [← ContinuousLinearMap.adjoint_inner_left,
        cubicSourceResidue_orthogonal_of_zero_integral_cusp_averages _ (hEig i) (f i) (hf i) (hrep i) (havg i), mul_zero]

end CuspAverageOrthogonality

section PeriodAffineAverages
local instance : MeasureSpace UnitAddCircle := ⟨AddCircle.haarAddCircle⟩
local instance : Measure.IsAddHaarMeasure (volume : Measure UnitAddCircle) :=
  inferInstanceAs (Measure.IsAddHaarMeasure AddCircle.haarAddCircle)
local instance : IsProbabilityMeasure (volume : Measure UnitAddCircle) :=
  inferInstanceAs (IsProbabilityMeasure AddCircle.haarAddCircle)

/-- Integral multiplication descends to an endomorphism of the cusp torus. -/
def periodMultiplication (b : O) : UnitAddTorus (Fin 2) →+ UnitAddTorus (Fin 2) where
  toFun t := ![(Coordinates.coords b).1 • t 0 + (Coordinates.coords (b * omega)).1 • t 1,
    (Coordinates.coords b).2 • t 0 + (Coordinates.coords (b * omega)).2 • t 1]
  map_zero' := by ext i; fin_cases i <;> simp
  map_add' t u := by ext i; fin_cases i <;> simp [smul_add, add_add_add_comm]

lemma periodVector_mul (b : O) (x : Fin 2 → ℝ) :
    ringComplex b * periodVector x = periodVector
      ![(Coordinates.coords b).1 * x 0 + (Coordinates.coords (b * omega)).1 * x 1,
        (Coordinates.coords b).2 * x 0 + (Coordinates.coords (b * omega)).2 * x 1] := by
  have he (c : O) : ringComplex c = (Coordinates.coords c).1 + (Coordinates.coords c).2 * ringComplex omega := by
    conv_lhs => rw [← Coordinates.eval_coords c, ringComplex_eval]
  rw [periodVector_apply, periodVector_apply]
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one]
  push_cast
  calc
    ringComplex b * (3 * ((x 0 : ℂ) + (x 1 : ℂ) * ringComplex omega)) =
        3 * ((x 0 : ℂ) * ringComplex b + (x 1 : ℂ) * ringComplex (b * omega)) := by rw [map_mul]; ring
    _ = _ := by rw [he b, he (b * omega)]; ring

lemma periodTorus_mul (b : O) (z : ℂ) :
    periodTorus (ringComplex b * z) = periodMultiplication b (periodTorus z) := by
  obtain ⟨x, rfl⟩ := periodVector.surjective z
  rw [periodVector_mul, periodTorus_periodVector, periodTorus_periodVector]
  ext i
  fin_cases i <;> simp only [periodMultiplication, AddMonoidHom.coe_mk, ZeroHom.coe_mk,
    ← AddCircle.coe_zsmul, ← AddCircle.coe_add, zsmul_eq_mul] <;> rfl

lemma periodMultiplication_continuous (b : O) : Continuous (periodMultiplication b) := by
  apply continuous_pi
  intro i
  fin_cases i <;> change Continuous (fun t : UnitAddTorus (Fin 2) => _ • t 0 + _ • t 1) <;> fun_prop

lemma periodMultiplication_surjective (b : O) (hb : b ≠ 0) : Function.Surjective (periodMultiplication b) := by
  intro t
  refine ⟨periodTorus (periodSection t / ringComplex b), ?_⟩
  have hc : ringComplex b * (periodSection t / ringComplex b) = periodSection t := by
    field_simp [ringComplex_ne_zero hb]
  rw [← periodTorus_mul, hc, periodTorus_section]

lemma periodMultiplication_measurePreserving (b : O) (hb : b ≠ 0) :
    MeasurePreserving (periodMultiplication b) volume volume :=
  AddMonoidHom.measurePreserving (periodMultiplication_continuous b) (periodMultiplication_surjective b hb) rfl

lemma periodFunction_descends (f : ℂ → ℂ)
    (hper : ∀ (n : O) (z : ℂ), f (z + 3 * ringComplex n) = f z)
    (z w : ℂ) (he : periodTorus z = periodTorus w) : f z = f w := by
  have hs (i : Fin 2) : ((periodBasis.equivFunL (z - w) i : ℝ) : UnitAddCircle) = 0 := by
    simp only [map_sub, Pi.sub_apply, AddCircle.coe_sub]
    exact sub_eq_zero.mpr (congrFun he i)
  obtain ⟨a, ha⟩ := (AddCircle.coe_eq_zero_iff (1 : ℝ)).mp (hs 0)
  obtain ⟨b, hb⟩ := (AddCircle.coe_eq_zero_iff (1 : ℝ)).mp (hs 1)
  simp only [zsmul_eq_mul, mul_one] at ha hb
  have hx : periodBasis.equivFunL (z - w) = ![(a : ℝ), (b : ℝ)] := by
    ext i
    fin_cases i
    · exact ha.symm
    · exact hb.symm
  have hd : z - w = 3 * ringComplex (Coordinates.eval a b) := by
    calc
      z - w = periodVector (periodBasis.equivFunL (z - w)) := (periodBasis.equivFunL.symm_apply_apply _).symm
      _ = _ := by
        rw [hx, periodVector_apply, ringComplex_eval]
        simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one, Complex.ofReal_intCast]
  have hz : z = w + 3 * ringComplex (Coordinates.eval a b) := by linear_combination hd
  rw [hz, hper]

/-- A nonzero integral dilation preserves the normalized average of a periodic function. -/
theorem period_integral_eisenstein_mul (f : ℂ → ℂ) (hf : Measurable f)
    (hper : ∀ (n : O) (z : ℂ), f (z + 3 * ringComplex n) = f z) (b : O) (hb : b ≠ 0) :
    (∫ z in periodDomain, f (ringComplex b * z)) = ∫ z in periodDomain, f z := by
  let F := f ∘ periodSection
  have hF : Measurable F := hf.comp periodSection_measurableEmbedding.measurable
  have hdesc (z : ℂ) : F (periodTorus z) = f z :=
    periodFunction_descends f hper _ _ (periodTorus_section _)
  have hi : (∫ t, F (periodMultiplication b t)) = ∫ t, F t := by
    calc
      _ = ∫ t, F t ∂Measure.map (periodMultiplication b) volume :=
        (integral_map (periodMultiplication_continuous b).measurable.aemeasurable hF.aestronglyMeasurable).symm
      _ = _ := by rw [(periodMultiplication_measurePreserving b hb).map_eq]
  rw [periodTorus_integral, periodTorus_integral] at hi
  simp_rw [← periodTorus_mul, hdesc] at hi
  have hc : (periodCovolumeDensity : ℝ) ≠ 0 := by exact_mod_cast periodCovolumeDensity_pos.ne'
  have hi' := congrArg (fun x : ℂ => (periodCovolumeDensity : ℝ)⁻¹ • x) hi
  simpa only [smul_smul, inv_mul_cancel₀ hc, one_smul] using hi' 

lemma period_integral_eisenstein_affine (f : ℂ → ℂ) (hf : Measurable f)
    (hper : ∀ (n : O) (z : ℂ), f (z + 3 * ringComplex n) = f z)
    (b : O) (hb : b ≠ 0) (c : ℂ) :
    (∫ z in periodDomain, f (ringComplex b * z + c)) = ∫ z in periodDomain, f z := by
  have hshift : (∫ z in periodDomain, f (z + c)) = ∫ z in periodDomain, f z := by
    simpa only [add_comm] using period_integral_translation f hper c
  calc
    _ = ∫ z in periodDomain, f (z + c) := period_integral_eisenstein_mul _
      (hf.comp (continuous_id.add continuous_const).measurable)
      (fun n z => by simpa only [Function.comp_apply, Pi.add_apply, id_eq, add_right_comm] using hper n (z + c)) b hb
    _ = _ := hshift

end PeriodAffineAverages

lemma kernelRationalCusp_period (f : KernelQuotient → ℂ) (M : rationalExtension)
    (v : ℝ) (hv : 0 < v) (n : O) (z : ℂ) :
    f (integralOrbitProjection globalKubotaKernel
      (integralComplexMatrix (M : SL(2, O)) • upperPoint (z + 3 * ringComplex n) v hv)) =
    f (integralOrbitProjection globalKubotaKernel
      (integralComplexMatrix (M : SL(2, O)) • upperPoint z v hv)) := by
  simpa only [kernelRationalAction_mk] using
    congrArg (fun q => f (kernelRationalAction M q)) (kernelProjection_upper_period v hv z n)

lemma kernelRationalCusp_average_eq_enlarged (f : KernelQuotient → ℂ) (hf : Continuous f)
    (M : rationalExtension) (v : ℝ) (hv : 0 < v) (b : O) (hb : b ≠ 0) :
    (∫ z in periodDomain, f (integralOrbitProjection globalKubotaKernel
      (integralComplexMatrix (M : SL(2, O)) • upperPoint (ringComplex b * z) v hv))) =
    ∫ z in periodDomain, f (integralOrbitProjection globalKubotaKernel
      (integralComplexMatrix (M : SL(2, O)) • upperPoint z v hv)) := by
  refine period_integral_eisenstein_mul
    (fun z => f (integralOrbitProjection globalKubotaKernel
      (integralComplexMatrix (M : SL(2, O)) • upperPoint z v hv))) ?_
    (kernelRationalCusp_period f M v hv) b hb
  exact (((hf.comp (continuous_integralOrbitProjection _)).comp (continuous_hyperbolic_action _)).comp
    (upperCoordinatesHomeomorph.continuous.comp
      (show Continuous (fun z : ℂ => (⟨(z, v), hv⟩ : UpperCoordinates)) by fun_prop))).measurable

/-- Enlarged cusp cells suffice: integral dilations preserve the ordinary cusp average. -/
theorem cubicSourceResidue_orthogonal_of_zero_enlarged_cusp_averages
    (F : KernelQuotientL2) (hF : (F, (8 / 9 : ℂ) • F) ∈ kernelEnergyLaplacian.graph)
    (f : KernelQuotient → ℂ) (hf : Continuous f)
    (hrep : F =ᵐ[integralQuotientVolume globalKubotaKernel] f)
    (havg : ∀ N : rationalExtension, ∀ v : ℝ, ∀ hv : 0 < v, 1 < v →
      ∃ b : O, b ≠ 0 ∧ (∫ z in periodDomain, f (integralOrbitProjection globalKubotaKernel
        (integralComplexMatrix (N : SL(2, O)) • upperPoint (ringComplex b * z) v hv))) = 0) :
    inner ℂ F (kernelRationalSourceProjection cubicEisensteinResidue) = 0 := by
  have hzero (N : rationalExtension) (v : ℝ) (hv : 0 < v) (h1 : 1 < v) :
      (∫ z in periodDomain, f (integralOrbitProjection globalKubotaKernel
        (integralComplexMatrix (N : SL(2, O)) • upperPoint z v hv))) = 0 := by
    obtain ⟨b, hb, hav⟩ := havg N v hv h1
    rw [kernelRationalCusp_average_eq_enlarged f hf N v hv b hb] at hav
    exact hav
  rw [kernelRationalSourceProjection_apply, inner_smul_right, inner_sum]
  have htranslate (g : rationalExtension) : inner ℂ F (kernelRationalPullback g cubicEisensteinResidue) = 0 := by
    rw [kernelRationalPullback_pairing_inverse]
    have hrepG : kernelRationalPullback g⁻¹ F =ᵐ[integralQuotientVolume globalKubotaKernel]
        fun q => f (kernelRationalAction g⁻¹ q) :=
      (kernelRationalPullback_ae g⁻¹ F).trans
        ((kernelRationalAction_measurePreserving g⁻¹).quasiMeasurePreserving.ae_eq_comp hrep)
    apply cubicEisensteinResidue_orthogonal_of_zero_cusp_averages _
      (kernelRational_eigenvector g⁻¹ F (8 / 9) hF) _ (hf.comp (kernelRationalAction_continuous _)) hrepG
    intro N v hv hlarge
    let N' : rationalExtension := ⟨N, levelThree_le_rationalExtension N.property⟩
    simpa only [Function.comp_apply, kernelRationalAction_mk, map_mul, mul_smul,
      Subgroup.coe_mul, integralComplexMatrix_levelThree, N'] using hzero (g⁻¹ * N') v hv hlarge
  simp only [htranslate, Finset.sum_const_zero, mul_zero]

/-- Energy compatibility supplies the adjoint eigenvector property for actual common-cover legs. -/
theorem kernelCoverLeg_source_sum_vanish_of_zero_enlarged_averages
    {H : Subgroup (SL(2, O))} {ι : Type*} [Fintype ι]
    (J : ι → Subgroup (SL(2, O))) (hHK : H ≤ globalKubotaKernel) (hJK : ∀ i, J i ≤ globalKubotaKernel)
    [∀ i, (J i).IsFiniteRelIndex globalKubotaKernel]
    (e : ∀ i, H ≃* J i) (g : ι → SL(2, ℂ)) (he : ∀ i, IntegralCoverIntertwines (e i) (g i))
    (c : ι → ℂ)
    (f : ι → KernelQuotient → ℂ) (hf : ∀ i, Continuous (f i))
    (hrep : ∀ i, ContinuousLinearMap.adjoint (kernelCoverLeg hHK (hJK i) (e i) (g i) (he i))
      (∑ j, c j • kernelCoverLeg hHK (hJK j) (e j) (g j) (he j)
        (kernelRationalSourceProjection cubicEisensteinResidue)) =ᵐ[integralQuotientVolume globalKubotaKernel] f i)
    (havg : ∀ i, ∀ N : rationalExtension, ∀ v : ℝ, ∀ hv : 0 < v, 1 < v →
      ∃ b : O, b ≠ 0 ∧ (∫ z in periodDomain, f i (integralOrbitProjection globalKubotaKernel
        (integralComplexMatrix (N : SL(2, O)) • upperPoint (ringComplex b * z) v hv))) = 0) :
    (∑ i, c i • kernelCoverLeg hHK (hJK i) (e i) (g i) (he i)
      (kernelRationalSourceProjection cubicEisensteinResidue)) = 0 := by
  let D := ∑ i, c i • kernelCoverLeg hHK (hJK i) (e i) (g i) (he i)
    (kernelRationalSourceProjection cubicEisensteinResidue)
  apply (inner_self_eq_zero (𝕜 := ℂ)).mp
  change inner ℂ D D = 0
  change inner ℂ D (∑ i, c i • kernelCoverLeg hHK (hJK i) (e i) (g i) (he i)
    (kernelRationalSourceProjection cubicEisensteinResidue)) = 0
  rw [inner_sum]
  apply Finset.sum_eq_zero
  intro i _
  rw [inner_smul_right, ← ContinuousLinearMap.adjoint_inner_left]
  have heig := kernelCoverLeg_adjoint_sum_eigenvector J hHK hJK e g he
    (kernelRationalSourceProjection cubicEisensteinResidue) (8 / 9)
    kernelRationalSourceProjection_cubicEisensteinResidue_eigenvector c i
  rw [cubicSourceResidue_orthogonal_of_zero_enlarged_cusp_averages _ heig (f i) (hf i) (hrep i) (havg i), mul_zero]


/-- Extract a prime power up to a prescribed exponent, including the zero input. -/
lemma bounded_prime_power_factor (p a : O) (n : ℕ) :
    ∃ j ≤ n, ∃ b, a = p ^ j * b ∧ (j = n ∨ ¬ p ∣ b) := by
  induction n generalizing a with
  | zero => exact ⟨0, le_rfl, a, by simp, Or.inl rfl⟩
  | succ n ih =>
    by_cases h : p ∣ a
    · obtain ⟨a', rfl⟩ := h
      obtain ⟨j, hj, b, hb, hn⟩ := ih a'
      refine ⟨j + 1, Nat.succ_le_succ hj, b, ?_, ?_⟩
      · rw [hb, pow_succ]; ring
      · exact hn.elim (fun he => Or.inl (congrArg (fun k => k + 1) he)) Or.inr
    · exact ⟨0, Nat.zero_le _, a, by simp, Or.inr h⟩

lemma primary_pow_mod_three (p : O) (hp : lambda ^ 2 ∣ p - 1) (n : ℕ) :
    (3 : O) ∣ p ^ n - 1 := by
  simpa only [one_pow] using (three_dvd_primary_sub_one p hp).trans (sub_dvd_pow_sub_pow p 1 n)

/-- Primitive normalization of a translated prime-power branch preserves its cusp class modulo three. -/
theorem primePowerCusp_reduction (A : SL(2, O)) (p q : O) (n : ℕ)
    (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1) :
    ∃ j ≤ n, ∃ N : SL(2, O),
      A 0 0 + 3 * q * A 1 0 = p ^ j * N 0 0 ∧
      p ^ n * A 1 0 = p ^ j * N 1 0 ∧ N * A⁻¹ ∈ levelThree ∧
      (j = n ∨ ¬ p ∣ N 0 0) := by
  let a := A 0 0 + 3 * q * A 1 0
  have hd : A 0 0 * A 1 1 - A 0 1 * A 1 0 = 1 := by
    simpa only [Matrix.det_fin_two] using A.property
  have haC : IsCoprime a (A 1 0) := by
    refine ⟨A 1 1, -(A 0 1 + 3 * q * A 1 1), ?_⟩
    dsimp only [a]
    linear_combination hd
  obtain ⟨j, hj, b, hab, hb⟩ := bounded_prime_power_factor p a n
  have hbC : IsCoprime b (A 1 0) := by
    rw [hab] at haC
    exact haC.of_mul_left_right
  have hbY : IsCoprime b (p ^ (n - j) * A 1 0) := by
    rcases hb with h | h
    · simpa only [h, Nat.sub_self, pow_zero, one_mul] using hbC
    · exact ((hp.coprime_iff_not_dvd.mpr h).symm.pow_right).mul_right hbC
  have hbA : (3 : O) ∣ b - A 0 0 := by
    have h1 : (3 : O) ∣ a - A 0 0 := ⟨q * A 1 0, by dsimp only [a]; ring⟩
    have h2 : (3 : O) ∣ a - b := by
      rw [hab]
      convert (primary_pow_mod_three p hprimary j).mul_right b using 1 <;> ring
    convert dvd_sub h1 h2 using 1 <;> ring
  have hyC : (3 : O) ∣ p ^ (n - j) * A 1 0 - A 1 0 := by
    convert (primary_pow_mod_three p hprimary (n - j)).mul_right (A 1 0) using 1 <;> ring
  obtain ⟨N, hN0, hN1, hNA⟩ := exists_congruent_cusp_completion A b (p ^ (n - j) * A 1 0) hbY hbA hyC
  refine ⟨j, hj, N, ?_, ?_, hNA, ?_⟩
  · rw [hN0]; exact hab
  · rw [hN1, ← mul_assoc, ← pow_add, Nat.add_sub_of_le hj]
  · simpa only [hN0] using hb

/-- The inverse branch has the same congruence-preserving normalization. -/
theorem primePowerCusp_inverse_reduction (A : SL(2, O)) (p q : O) (n : ℕ)
    (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1) :
    ∃ j ≤ n, ∃ N : SL(2, O),
      p ^ n * A 0 0 - 3 * q * A 1 0 = p ^ j * N 0 0 ∧
      A 1 0 = p ^ j * N 1 0 ∧ N * A⁻¹ ∈ levelThree := by
  have hd : A 0 0 * A 1 1 - A 0 1 * A 1 0 = 1 := by
    simpa only [Matrix.det_fin_two] using A.property
  have hCA : IsCoprime (A 1 0) (A 0 0) := by
    refine ⟨-A 0 1, A 1 1, ?_⟩
    linear_combination hd
  obtain ⟨j, hj, c, hC, hc⟩ := bounded_prime_power_factor p (A 1 0) n
  have hcA : IsCoprime c (A 0 0) := by
    rw [hC] at hCA
    exact hCA.of_mul_left_right
  have hcY : IsCoprime c (p ^ (n - j) * A 0 0) := by
    rcases hc with h | h
    · simpa only [h, Nat.sub_self, pow_zero, one_mul] using hcA
    · exact ((hp.coprime_iff_not_dvd.mpr h).symm.pow_right).mul_right hcA
  let a := p ^ (n - j) * A 0 0 - 3 * q * c
  have hac : IsCoprime a c := by
    obtain ⟨u, v, huv⟩ := hcY
    refine ⟨v, u + 3 * q * v, ?_⟩
    dsimp only [a]
    linear_combination huv
  have ha : (3 : O) ∣ a - A 0 0 := by
    have h1 := (primary_pow_mod_three p hprimary (n - j)).mul_right (A 0 0)
    have h2 : (3 : O) ∣ 3 * q * c := ⟨q * c, by ring⟩
    convert dvd_sub h1 h2 using 1 <;> dsimp only [a] <;> ring
  have hc : (3 : O) ∣ c - A 1 0 := by
    rw [hC]
    convert dvd_neg.mpr ((primary_pow_mod_three p hprimary j).mul_right c) using 1 <;> ring
  obtain ⟨N, hN0, hN1, hNA⟩ := exists_congruent_cusp_completion A a c hac ha hc
  refine ⟨j, hj, N, ?_, by rw [hN1]; exact hC, hNA⟩
  rw [hN0, hC]
  dsimp only [a]
  have hpow : p ^ j * p ^ (n - j) = p ^ n := by rw [← pow_add, Nat.add_sub_of_le hj]
  linear_combination -(A 0 0) * hpow

lemma rationalExtension_of_congruent (A : rationalExtension) (N : SL(2, O))
    (hNA : N * (A : SL(2, O))⁻¹ ∈ levelThree) : N ∈ rationalExtension := by
  have h := rationalExtension.mul_mem (levelThree_le_rationalExtension hNA) A.property
  simpa only [inv_mul_cancel_right] using h

/-- The four possible common prime-power factors of a translated cube branch. -/
structure CubeCuspData (A : SL(2, O)) (p q : O) where
  exponent : Fin 4
  matrix : SL(2, O)
  first : A 0 0 + 3 * q * A 1 0 = p ^ exponent.val * matrix 0 0
  second : p ^ 3 * A 1 0 = p ^ exponent.val * matrix 1 0
  congruent : matrix * A⁻¹ ∈ levelThree

def actualCubeCuspData (A : SL(2, O)) (p q : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1) :
    CubeCuspData A p q := by
  let h := primePowerCusp_reduction A p q 3 hp hprimary
  let j := Classical.choose h
  have hj : j ≤ 3 := (Classical.choose_spec h).1
  let N := Classical.choose (Classical.choose_spec h).2
  have hN := Classical.choose_spec (Classical.choose_spec h).2
  exact ⟨⟨j, by omega⟩, N, hN.1, hN.2.1, hN.2.2.1⟩

lemma CubeCuspData.lower_eq {A : SL(2, O)} {p q : O} (d : CubeCuspData A p q) (hp : p ≠ 0) :
    d.matrix 1 0 = p ^ (3 - d.exponent.val) * A 1 0 := by
  apply mul_left_cancel₀ (pow_ne_zero d.exponent.val hp)
  rw [← d.second, ← mul_assoc, ← pow_add, Nat.add_sub_of_le (by omega : d.exponent.val ≤ 3)]

lemma CubeCuspData.rational_mem {A : rationalExtension} {p q : O}
    (d : CubeCuspData (A : SL(2, O)) p q) : d.matrix ∈ rationalExtension :=
  rationalExtension_of_congruent A d.matrix d.congruent

/-- The source constant term in any rational cusp, with its exact multiplier. -/
def rationalSourceCuspConstant (M : rationalExtension) : ℂ :=
  extendedComplexCharacter M * ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) *
    (3 * (Real.pi : ℂ)) * constantArithmeticResidue

theorem rationalSourceCusp_average_enlarged_affine (M : rationalExtension) (b : O) (hb : b ≠ 0)
    (c : ℂ) (v : ℝ) (hv : 0 < v) :
    (∫ z in periodDomain, cubicSourceResidualFunction
      (integralComplexMatrix (M : SL(2, O)) • upperPoint (ringComplex b * z + c) v hv)) =
      rationalSourceCuspConstant M * (v : ℂ) ^ (2 / 3 : ℂ) := by
  have hc : Continuous (fun z : ℂ => cubicSourceResidualFunction (upperPoint z v hv)) :=
    cubicSourceResidualFunction_continuous.comp
      (upperCoordinatesHomeomorph.continuous.comp
        (show Continuous (fun z : ℂ => (⟨(z, v), hv⟩ : UpperCoordinates)) by fun_prop))
  simp_rw [cubicSourceResidualFunction_automorphy]
  rw [integral_const_mul, period_integral_eisenstein_affine _ hc.measurable
    (fun n z => cubicSourceResidualFunction_period v hv z n) b hb c,
    cubicSourceResidualFunction_fourier_zero]
  unfold rationalSourceCuspConstant
  ring

lemma rationalExtension_entry_integer (M : rationalExtension) (i j : Fin 2) :
    ∃ r : ℤ, (3 : O) ∣ (M : SL(2, O)) i j - (r : O) := by
  obtain ⟨n, r, hr⟩ := M.property
  let red := Matrix.SpecialLinearGroup.map (n := Fin 2) (Ideal.Quotient.mk (Ideal.span {(3 : O)}))
  have hn : red (n : SL(2, O)) = 1 := n.property
  have he : red (M : SL(2, O)) = red (rationalEmbedding r) := by rw [← hr, map_mul, hn, one_mul]
  refine ⟨r i j, Ideal.mem_span_singleton.mp ((Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp ?_)⟩
  exact congrArg (fun A : SL(2, O ⧸ Ideal.span {(3 : O)}) => A i j) he

/-- A determinant-one matrix with reduced first row and lower-left entry is the identity modulo three. -/
lemma integralMatrix_levelThree_of_entries (N : SL(2, O))
    (h00 : (3 : O) ∣ N 0 0 - 1) (h01 : (3 : O) ∣ N 0 1) (h10 : (3 : O) ∣ N 1 0) : N ∈ levelThree := by
  let R := O ⧸ Ideal.span {(3 : O)}
  let red := Matrix.SpecialLinearGroup.map (n := Fin 2) (Ideal.Quotient.mk (Ideal.span {(3 : O)}))
  have ha : red N 0 0 = (1 : R) := by
    exact (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr (Ideal.mem_span_singleton.mpr h00)
  have hb : red N 0 1 = (0 : R) := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton.mpr h01)
  have hc : red N 1 0 = (0 : R) := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton.mpr h10)
  have hd : red N 1 1 = (1 : R) := by
    have hdet := (red N).property
    simpa only [Matrix.det_fin_two, ha, hb, hc, one_mul, zero_mul, sub_zero] using hdet
  change red N = 1
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  fin_cases i <;> fin_cases j
  · exact ha
  · exact hb
  · exact hc
  · exact hd

/-- On the rational extension, a primary upper-left entry reads the character from the first column. -/
theorem extendedComplexCharacter_primary (M : rationalExtension)
    (hM : lambda ^ 2 ∣ (M : SL(2, O)) 0 0 - 1) :
    extendedComplexCharacter M = ringComplex (symbol ((M : SL(2, O)) 1 0) ((M : SL(2, O)) 0 0)) := by
  obtain ⟨b, hb⟩ := rationalExtension_entry_integer M 0 1
  obtain ⟨c, hc⟩ := rationalExtension_entry_integer M 1 0
  let L : SL(2, ℤ) := ⟨!![1, 0; -c, 1], by simp [Matrix.det_fin_two]⟩
  let U := rationalUnipotent (-b)
  let L' := rationalSourceLift L
  let U' := rationalSourceLift U
  let N := L' * M * U'
  have hN00 : (N : SL(2, O)) 0 0 = (M : SL(2, O)) 0 0 := by
    simp [N, L', U', L, U, rationalSourceLift, rationalEmbedding, rationalUnipotent,
      Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two]
  have hN01 : (N : SL(2, O)) 0 1 = (M : SL(2, O)) 0 1 - (b : O) * (M : SL(2, O)) 0 0 := by
    simp [N, L', U', L, U, rationalSourceLift, rationalEmbedding, rationalUnipotent,
      Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two]
    ring
  have hN10 : (N : SL(2, O)) 1 0 = (M : SL(2, O)) 1 0 - (c : O) * (M : SL(2, O)) 0 0 := by
    simp [N, L', U', L, U, rationalSourceLift, rationalEmbedding, rationalUnipotent,
      Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two]
    ring
  have ha := three_dvd_primary_sub_one _ hM
  have hn : (N : SL(2, O)) ∈ levelThree := by
    apply integralMatrix_levelThree_of_entries
    · rwa [hN00]
    · rw [hN01]
      convert dvd_sub hb (ha.mul_left (b : O)) using 1 <;> ring
    · rw [hN10]
      convert dvd_sub hc (ha.mul_left (c : O)) using 1 <;> ring
  have hchar : extendedComplexCharacter N = extendedComplexCharacter M := by
    dsimp only [N]
    rw [map_mul, map_mul, extendedComplexCharacter_sourceLift, extendedComplexCharacter_sourceLift, one_mul, mul_one]
  have hres : extendedComplexCharacter N = complexCharacter ⟨(N : SL(2, O)), hn⟩ :=
    extendedComplexCharacter_restrict ⟨(N : SL(2, O)), hn⟩
  rw [← hchar, hres]
  change ringComplex (symbol ((N : SL(2, O)) 1 0) ((N : SL(2, O)) 0 0)) = _
  rw [hN00, hN10]
  apply congrArg ringComplex
  apply symbol_congr
  exact ⟨-(c : O), by ring⟩

lemma integer_congruence_primary_cases (c : O) (r : ℤ) (h : (3 : O) ∣ c - (r : O)) :
    (3 : O) ∣ c ∨ lambda ^ 2 ∣ c - 1 ∨ lambda ^ 2 ∣ -c - 1 := by
  have hr : (3 : ℤ) ∣ r ∨ (3 : ℤ) ∣ r - 1 ∨ (3 : ℤ) ∣ r + 1 := by omega
  rcases hr with hr | hr | hr
  · left
    obtain ⟨t, ht⟩ := hr
    have hn : (3 : O) ∣ (r : O) := ⟨(t : O), by exact_mod_cast ht⟩
    simpa only [sub_add_cancel] using dvd_add h hn
  · right; left
    obtain ⟨t, ht⟩ := hr
    have hn : (3 : O) ∣ (r : O) - 1 := ⟨(t : O), by exact_mod_cast ht⟩
    apply lambda_sq_dvd_three.trans
    simpa only [sub_add_sub_cancel] using dvd_add h hn
  · right; right
    obtain ⟨t, ht⟩ := hr
    have hn : (3 : O) ∣ (r : O) + 1 := ⟨(t : O), by exact_mod_cast ht⟩
    apply lambda_sq_dvd_three.trans
    convert dvd_neg.mpr (dvd_add h hn) using 1 <;> ring

lemma symbol_three_shift_primary (c a t : O) (hc : lambda ^ 2 ∣ c - 1) (ha : lambda ^ 2 ∣ a - 1) :
    symbol c (a + 3 * t * c) = symbol c a := by
  have hs : lambda ^ 2 ∣ a + 3 * t * c - 1 := by
    convert dvd_add ha ((lambda_sq_dvd_three.mul_right t).mul_right c) using 1 <;> ring
  rw [symbol_reciprocity c _ hc hs]
  calc
    symbol (a + 3 * t * c) c = symbol a c := symbol_congr ⟨3 * t, by ring⟩
    _ = symbol c a := symbol_reciprocity a c ha hc

lemma symbol_three_shift_integer (c a t : O) (r : ℤ)
    (ha : lambda ^ 2 ∣ a - 1) (hc : (3 : O) ∣ c - (r : O)) :
    symbol c (a + 3 * t * c) = symbol c a := by
  rcases integer_congruence_primary_cases c r hc with h | h | h
  · exact symbol_three_shift c a t ha h
  · exact symbol_three_shift_primary c a t h ha
  · have hh := symbol_three_shift_primary (-c) a (-t) h ha
    have hs : lambda ^ 2 ∣ a + 3 * t * c - 1 := by
      convert dvd_add ha ((lambda_sq_dvd_three.mul_right t).mul_right c) using 1 <;> ring
    rw [show a + 3 * (-t) * (-c) = a + 3 * t * c by ring,
      symbol_neg_numerator _ _ hs, symbol_neg_numerator _ _ ha] at hh
    exact hh


lemma principalResidueRep_mk_sub_dvd (c a : O) :
    c ∣ principalResidueRep c (Ideal.Quotient.mk (Ideal.span {c}) a) - a :=
  Ideal.mem_span_singleton.mp ((Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp (principalResidueRep_spec _ _))

/-- A residue modulo a prime cube is its exact valuation and an invertible residual factor. -/
abbrev CubeResidueStrata (p : O) := Σ j : Fin 4, CubicUnitResidue (p ^ (3 - j.val))

def cubeResidueStratumMap (p : O) (x : CubeResidueStrata p) : CubeResidues p :=
  Ideal.Quotient.mk _ (p ^ x.1.val * principalResidueRep (p ^ (3 - x.1.val)) x.2.1)

lemma cubicUnitResidue_rep_coprime (c : O) (x : CubicUnitResidue c) : IsCoprime c (principalResidueRep c x.1) := by
  apply (isUnit_quotient_span_iff _ _).mp
  simpa only [principalResidueRep_spec] using x.2

lemma cube_strata_exponents (p : O) (hp : Prime p) (j k : Fin 4) (b d : O)
    (hb : IsCoprime (p ^ (3 - j.val)) b) (he : p ^ 3 ∣ p ^ j.val * b - p ^ k.val * d) : ¬j.val < k.val := by
  intro hjk
  have hj3 : j.val + 1 ≤ 3 := by omega
  have hjk' : j.val + 1 ≤ k.val := by omega
  have h1 : p ^ (j.val + 1) ∣ p ^ j.val * b - p ^ k.val * d := (pow_dvd_pow p hj3).trans he
  have h2 : p ^ (j.val + 1) ∣ p ^ k.val * d := dvd_mul_of_dvd_left (pow_dvd_pow p hjk') d
  have h3 : p ^ (j.val + 1) ∣ p ^ j.val * b := by simpa only [sub_add_cancel] using dvd_add h1 h2
  rw [pow_succ] at h3
  have hpb : p ∣ b := (mul_dvd_mul_iff_left (pow_ne_zero j.val hp.ne_zero)).mp h3
  have hpc : IsCoprime p b := hb.of_isCoprime_of_dvd_left (dvd_pow_self p (by omega : 3 - j.val ≠ 0))
  exact (hp.coprime_iff_not_dvd.mp hpc) hpb

lemma cubeResidueStratumMap_injective (p : O) (hp : Prime p) : Function.Injective (cubeResidueStratumMap p) := by
  rintro ⟨j, b⟩ ⟨k, d⟩ he
  have hd : p ^ 3 ∣ p ^ j.val * principalResidueRep (p ^ (3 - j.val)) b.1 -
      p ^ k.val * principalResidueRep (p ^ (3 - k.val)) d.1 :=
    Ideal.mem_span_singleton.mp ((Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp he)
  have hle := cube_strata_exponents p hp j k _ _ (cubicUnitResidue_rep_coprime _ b) hd
  have hge := cube_strata_exponents p hp k j _ _ (cubicUnitResidue_rep_coprime _ d)
    (by simpa only [neg_sub] using dvd_neg.mpr hd)
  have hjk : j = k := Fin.ext (by omega)
  subst k
  have hpow : p ^ 3 = p ^ j.val * p ^ (3 - j.val) := by rw [← pow_add, Nat.add_sub_of_le (by omega : j.val ≤ 3)]
  rw [hpow, ← mul_sub] at hd
  have hrep := (mul_dvd_mul_iff_left (pow_ne_zero j.val hp.ne_zero)).mp hd
  have hbd : b = d := by
    apply Subtype.ext
    rw [← principalResidueRep_spec (p ^ (3 - j.val)) b.1,
      ← principalResidueRep_spec (p ^ (3 - j.val)) d.1]
    exact (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr (Ideal.mem_span_singleton.mpr hrep)
  subst d
  rfl

lemma cubeResidueStratumMap_surjective (p : O) (hp : Prime p) : Function.Surjective (cubeResidueStratumMap p) := by
  intro r
  let a := principalResidueRep (p ^ 3) r
  obtain ⟨j, hj, b, hab, hb⟩ := bounded_prime_power_factor p a 3
  have hcop : IsCoprime (p ^ (3 - j)) b := by
    rcases hb with h | h
    · simp only [h, Nat.sub_self, pow_zero, isCoprime_one_left]
    · exact (hp.coprime_iff_not_dvd.mpr h).pow_left
  let u : CubicUnitResidue (p ^ (3 - j)) := ⟨Ideal.Quotient.mk _ b, (isUnit_quotient_span_iff _ _).mpr hcop⟩
  refine ⟨⟨⟨j, by omega⟩, u⟩, ?_⟩
  change Ideal.Quotient.mk (Ideal.span {p ^ 3}) (p ^ j * principalResidueRep (p ^ (3 - j)) u.1) = r
  rw [← principalResidueRep_spec (p ^ 3) r]
  apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr
  apply Ideal.mem_span_singleton.mpr
  change p ^ 3 ∣ p ^ j * principalResidueRep (p ^ (3 - j)) (Ideal.Quotient.mk _ b) - a
  rw [hab, ← mul_sub, show p ^ 3 = p ^ j * p ^ (3 - j) by rw [← pow_add, Nat.add_sub_of_le hj]]
  exact mul_dvd_mul_left _ (principalResidueRep_mk_sub_dvd _ _)

def cubeResidueStrataEquiv (p : O) (hp : Prime p) : CubeResidueStrata p ≃ CubeResidues p :=
  Equiv.ofBijective (cubeResidueStratumMap p)
    ⟨cubeResidueStratumMap_injective p hp, cubeResidueStratumMap_surjective p hp⟩

/-- The cubic character on an exact valuation stratum. -/
def cubeStratumSymbol (p C : O) (j : Fin 4) (b : CubicUnitResidue (p ^ (3 - j.val))) : ℂ :=
  ringComplex (symbol (principalResidueRep (p ^ (3 - j.val)) b.1 * C) (p ^ (3 - j.val)))

lemma cubeUnitStratum_symbol_gauss (p C : O) (n : ℕ) :
    (∑' b : CubicUnitResidue (p ^ n), ringComplex (symbol (principalResidueRep (p ^ n) b.1 * C) (p ^ n))) =
      cubicUnitGaussSum 0 (p ^ n) * ringComplex (symbol C (p ^ n)) := by
  rw [cubicUnitGaussSum]
  simp only [mul_zero, residueAdditive, map_zero, cuspFrequency, zero_div, zero_mul,
    AddChar.map_zero_eq_one, mul_one]
  rw [← tsum_mul_right]
  apply tsum_congr
  intro b
  rw [symbol_mul_numerator, map_mul]

lemma cubeStratumSymbol_sum (p C : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1)
    (hC : IsCoprime C p) (j : Fin 4) :
    (∑' b : CubicUnitResidue (p ^ (3 - j.val)), cubeStratumSymbol p C j b) =
      if j = 0 then (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 2 * ((Ideal.absNorm (Ideal.span {p}) : ℂ) - 1)
      else if j = 3 then 1 else 0 := by
  have h3 : ringComplex (symbol C (p ^ 3)) = 1 := by
    rw [symbol_pow_denominator, symbol_cube_of_isCoprime C p hprimary hC, map_one]
  unfold cubeStratumSymbol
  rw [cubeUnitStratum_symbol_gauss p C (3 - j.val)]
  fin_cases j
  · have hh := cubicUnitGaussSum_prime_power_zero p hp hprimary 2
    norm_num at hh ⊢
    rw [hh, h3, mul_one]
  · have hh := cubicUnitGaussSum_prime_power_zero p hp hprimary 1
    norm_num at hh ⊢
    simp [hh]
  · have hh := cubicUnitGaussSum_prime_power_zero p hp hprimary 0
    norm_num at hh ⊢
    simp [hh]
  · simp

lemma cubeStrata_weighted_sum (p C : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1)
    (hC : IsCoprime C p) (w : Fin 4 → ℂ) :
    (∑ j : Fin 4, w j * ∑' b : CubicUnitResidue (p ^ (3 - j.val)), cubeStratumSymbol p C j b) =
      w 0 * (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 2 * ((Ideal.absNorm (Ideal.span {p}) : ℂ) - 1) + w 3 := by
  simp_rw [cubeStratumSymbol_sum p C hp hprimary hC]
  simp [Fin.sum_univ_succ] <;> ring

lemma integralMatrix_comparison_mod_three (A N : SL(2, O)) (hNA : N * A⁻¹ ∈ levelThree)
    (i j : Fin 2) : (3 : O) ∣ N i j - A i j := by
  let red := Matrix.SpecialLinearGroup.map (n := Fin 2) (Ideal.Quotient.mk (Ideal.span {(3 : O)}))
  have hh : red (N * A⁻¹) = 1 := hNA
  rw [map_mul, map_inv] at hh
  have he := congrArg (fun M : SL(2, O ⧸ Ideal.span {(3 : O)}) => M i j) (mul_inv_eq_one.mp hh)
  exact Ideal.mem_span_singleton.mp ((Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp he)

lemma integralMatrix_comparison_primary (A N : SL(2, O)) (hNA : N * A⁻¹ ∈ levelThree)
    (hA : lambda ^ 2 ∣ A 0 0 - 1) : lambda ^ 2 ∣ N 0 0 - 1 := by
  have h := lambda_sq_dvd_three.trans (integralMatrix_comparison_mod_three A N hNA 0 0)
  simpa only [sub_add_sub_cancel] using dvd_add h hA

/-- Reciprocity balances the multipliers before and after extracting the common prime power. -/
lemma rationalCusp_cube_phase_balance (A N : rationalExtension) (p q : O) (j : ℕ)
    (hp : lambda ^ 2 ∣ p - 1)
    (hA : lambda ^ 2 ∣ (A : SL(2, O)) 0 0 - 1) (hN : lambda ^ 2 ∣ (N : SL(2, O)) 0 0 - 1)
    (hx : (A : SL(2, O)) 0 0 + 3 * q * (A : SL(2, O)) 1 0 = p ^ j * (N : SL(2, O)) 0 0)
    (hc : (N : SL(2, O)) 1 0 = p ^ (3 - j) * (A : SL(2, O)) 1 0) :
    extendedComplexCharacter N * ringComplex (symbol ((A : SL(2, O)) 1 0) p) ^ j =
      extendedComplexCharacter A * ringComplex (symbol ((N : SL(2, O)) 0 0) p) ^ (3 - j) := by
  obtain ⟨r, hr⟩ := rationalExtension_entry_integer A 1 0
  have hs : symbol ((A : SL(2, O)) 1 0) ((A : SL(2, O)) 0 0) =
      symbol ((A : SL(2, O)) 1 0) p ^ j * symbol ((A : SL(2, O)) 1 0) ((N : SL(2, O)) 0 0) := by
    rw [← symbol_three_shift_integer _ _ q r hA hr, hx, symbol_mul_denominator, symbol_pow_denominator]
  rw [extendedComplexCharacter_primary N hN, extendedComplexCharacter_primary A hA, hc,
    symbol_mul_numerator, symbol_pow_numerator _ _ hN,
    symbol_reciprocity p ((N : SL(2, O)) 0 0) hp hN,
    hs, map_mul, map_pow, map_mul, map_pow]
  ring

lemma rationalCusp_comparison_character (A N : rationalExtension)
    (hNA : (N : SL(2, O)) * (A : SL(2, O))⁻¹ ∈ levelThree) :
    complexCharacter ⟨(N : SL(2, O)) * (A : SL(2, O))⁻¹, hNA⟩ * extendedComplexCharacter A =
      extendedComplexCharacter N := by
  rw [← extendedComplexCharacter_restrict ⟨(N : SL(2, O)) * (A : SL(2, O))⁻¹, hNA⟩]
  change extendedComplexCharacter (N * A⁻¹) * extendedComplexCharacter A = extendedComplexCharacter N
  rw [← map_mul, inv_mul_cancel_right]

lemma rationalCusp_cube_comparison_phase (A N : rationalExtension) (p q : O) (j : ℕ) (hj : j ≤ 3)
    (hp : lambda ^ 2 ∣ p - 1)
    (hA : lambda ^ 2 ∣ (A : SL(2, O)) 0 0 - 1) (hN : lambda ^ 2 ∣ (N : SL(2, O)) 0 0 - 1)
    (hx : (A : SL(2, O)) 0 0 + 3 * q * (A : SL(2, O)) 1 0 = p ^ j * (N : SL(2, O)) 0 0)
    (hc : (N : SL(2, O)) 1 0 = p ^ (3 - j) * (A : SL(2, O)) 1 0)
    (hC : IsCoprime ((A : SL(2, O)) 1 0) p)
    (hNA : (N : SL(2, O)) * (A : SL(2, O))⁻¹ ∈ levelThree) :
    complexCharacter ⟨(N : SL(2, O)) * (A : SL(2, O))⁻¹, hNA⟩ =
      ringComplex (symbol ((N : SL(2, O)) 0 0 * (A : SL(2, O)) 1 0) p) ^ (3 - j) := by
  let a := ringComplex (symbol ((A : SL(2, O)) 1 0) p)
  let b := ringComplex (symbol ((N : SL(2, O)) 0 0) p)
  have ha3 : a ^ 3 = 1 := by
    dsimp only [a]
    rw [← map_pow, symbol_cube_of_isCoprime _ _ hp hC, map_one]
  have hpow : a ^ j * a ^ (3 - j) = 1 := by rw [← pow_add, Nat.add_sub_of_le hj, ha3]
  have hbal := rationalCusp_cube_phase_balance A N p q j hp hA hN hx hc
  change extendedComplexCharacter N * a ^ j = extendedComplexCharacter A * b ^ (3 - j) at hbal
  have he : extendedComplexCharacter N = extendedComplexCharacter A * (b * a) ^ (3 - j) := by
    calc
      _ = extendedComplexCharacter N * (a ^ j * a ^ (3 - j)) := by rw [hpow, mul_one]
      _ = (extendedComplexCharacter N * a ^ j) * a ^ (3 - j) := (mul_assoc _ _ _).symm
      _ = (extendedComplexCharacter A * b ^ (3 - j)) * a ^ (3 - j) := by rw [hbal]
      _ = _ := by rw [mul_pow]; ring
  have hbase : extendedComplexCharacter A ≠ 0 := by
    intro hz
    have hh := extendedComplexCharacter_cube A
    rw [hz] at hh
    norm_num at hh
  rw [symbol_mul_numerator, map_mul]
  apply mul_right_cancel₀ hbase
  rw [rationalCusp_comparison_character A N hNA, he]
  ring

lemma CubeCuspData.unit_top {A : SL(2, O)} {p q : O} (d : CubeCuspData A p q) (hp : p ≠ 0) :
    IsUnit (Ideal.Quotient.mk (Ideal.span {p ^ (3 - d.exponent.val)}) (d.matrix 0 0)) := by
  apply (isUnit_quotient_span_iff _ _).mpr
  refine ⟨-d.matrix 0 1 * A 1 0, d.matrix 1 1, ?_⟩
  have hd : d.matrix 0 0 * d.matrix 1 1 - d.matrix 0 1 * d.matrix 1 0 = 1 := by
    simpa only [Matrix.det_fin_two] using d.matrix.property
  rw [d.lower_eq hp] at hd
  linear_combination hd

def CubeCuspData.stratum {A : SL(2, O)} {p q : O} (d : CubeCuspData A p q) (hp : p ≠ 0) : CubeResidueStrata p :=
  ⟨d.exponent, ⟨Ideal.Quotient.mk _ (d.matrix 0 0), d.unit_top hp⟩⟩

lemma CubeCuspData.stratum_map {A : SL(2, O)} {p q : O} (d : CubeCuspData A p q) (hp : p ≠ 0) :
    cubeResidueStratumMap p (d.stratum hp) = Ideal.Quotient.mk (Ideal.span {p ^ 3}) (A 0 0 + 3 * q * A 1 0) := by
  apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr
  apply Ideal.mem_span_singleton.mpr
  change p ^ 3 ∣ p ^ d.exponent.val * principalResidueRep (p ^ (3 - d.exponent.val))
    (Ideal.Quotient.mk _ (d.matrix 0 0)) - (A 0 0 + 3 * q * A 1 0)
  rw [d.first, ← mul_sub]
  have hpow : p ^ 3 = p ^ d.exponent.val * p ^ (3 - d.exponent.val) := by
    rw [← pow_add, Nat.add_sub_of_le (by omega : d.exponent.val ≤ 3)]
  rw [hpow]
  exact mul_dvd_mul_left _ (principalResidueRep_mk_sub_dvd _ _)

lemma CubeCuspData.comparison_phase {p q : O} (A : rationalExtension)
    (d : CubeCuspData (A : SL(2, O)) p q) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1)
    (hA : lambda ^ 2 ∣ (A : SL(2, O)) 0 0 - 1) (hC : IsCoprime ((A : SL(2, O)) 1 0) p) :
    complexCharacter ⟨d.matrix * (A : SL(2, O))⁻¹, d.congruent⟩ =
      cubeStratumSymbol p ((A : SL(2, O)) 1 0) d.exponent (d.stratum hp.ne_zero).2 := by
  let N : rationalExtension := ⟨d.matrix, d.rational_mem⟩
  have hN := integralMatrix_comparison_primary (A : SL(2, O)) d.matrix d.congruent hA
  have he := rationalCusp_cube_comparison_phase A N p q d.exponent.val
    (by omega : d.exponent.val ≤ 3) hprimary hA hN d.first (d.lower_eq hp.ne_zero) hC d.congruent
  rw [he]
  unfold cubeStratumSymbol
  rw [← map_pow, ← symbol_pow_denominator]
  apply congrArg ringComplex
  apply symbol_congr
  have hd := principalResidueRep_mk_sub_dvd (p ^ (3 - d.exponent.val)) (d.matrix 0 0)
  change p ^ (3 - d.exponent.val) ∣ d.matrix 0 0 * (A : SL(2, O)) 1 0 -
    principalResidueRep (p ^ (3 - d.exponent.val)) (Ideal.Quotient.mk _ (d.matrix 0 0)) * (A : SL(2, O)) 1 0
  convert (dvd_neg.mpr hd).mul_right ((A : SL(2, O)) 1 0) using 1 <;> ring

lemma cube_affine_coefficient_unit (p C : O) (hprimary : lambda ^ 2 ∣ p - 1) (hC : IsCoprime C p) :
    IsUnit (Ideal.Quotient.mk (Ideal.span {p ^ 3}) (3 * C)) := by
  obtain ⟨t, ht⟩ := three_dvd_primary_sub_one p hprimary
  have hp3 : IsCoprime p (3 : O) := by
    refine ⟨1, -t, ?_⟩
    linear_combination ht
  apply (isUnit_quotient_span_iff _ _).mpr
  exact hp3.pow_left.mul_right hC.symm.pow_left

def cubeCuspAffineEquiv (p A C : O) (hprimary : lambda ^ 2 ∣ p - 1) (hC : IsCoprime C p) : CubeResidues p ≃ CubeResidues p := by
  let a := Ideal.Quotient.mk (Ideal.span {p ^ 3}) A
  let u := (cube_affine_coefficient_unit p C hprimary hC).unit
  exact {
    toFun := fun r => a + (u : _) * r
    invFun := fun r => (↑u⁻¹ : _) * (r - a)
    left_inv := fun r => by simp only [add_sub_cancel_left, ← mul_assoc, Units.inv_mul, one_mul]
    right_inv := fun r => by simp only [← mul_assoc, Units.mul_inv, one_mul, add_sub_cancel] }

lemma cubeCuspAffineEquiv_mk (p A C q : O) (hprimary : lambda ^ 2 ∣ p - 1) (hC : IsCoprime C p) :
    cubeCuspAffineEquiv p A C hprimary hC (Ideal.Quotient.mk _ q) =
      Ideal.Quotient.mk (Ideal.span {p ^ 3}) (A + 3 * q * C) := by
  simp only [cubeCuspAffineEquiv, Equiv.coe_fn_mk, IsUnit.unit_spec, map_add, map_mul]
  ring

/-- Weighted multiplier sum over the actual translated cube branches. -/
def actualCubeCuspPhaseSum (A : rationalExtension) (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1)
    (w : Fin 4 → ℂ) : ℂ :=
  ∑' r : CubeResidues p,
    let d := actualCubeCuspData (A : SL(2, O)) p (cubeResidueRepresentative p r) hp hprimary
    w d.exponent * complexCharacter ⟨d.matrix * (A : SL(2, O))⁻¹, d.congruent⟩

/-- The intermediate valuation strata cancel; only the unit and zero strata remain. -/
theorem actualCubeCuspPhaseSum_coprime (A : rationalExtension) (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (hA : lambda ^ 2 ∣ (A : SL(2, O)) 0 0 - 1)
    (hC : IsCoprime ((A : SL(2, O)) 1 0) p) (w : Fin 4 → ℂ) :
    actualCubeCuspPhaseSum A p hp hprimary w =
      w 0 * (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 2 * ((Ideal.absNorm (Ideal.span {p}) : ℂ) - 1) + w 3 := by
  let e := cubeResidueStrataEquiv p hp
  let a := cubeCuspAffineEquiv p ((A : SL(2, O)) 0 0) ((A : SL(2, O)) 1 0) hprimary hC
  let d (r : CubeResidues p) := actualCubeCuspData (A : SL(2, O)) p (cubeResidueRepresentative p r) hp hprimary
  let phi (s : CubeResidueStrata p) := w s.1 * cubeStratumSymbol p ((A : SL(2, O)) 1 0) s.1 s.2
  have hpoint (r : CubeResidues p) :
      w (d r).exponent * complexCharacter ⟨(d r).matrix * (A : SL(2, O))⁻¹, (d r).congruent⟩ = phi (e.symm (a r)) := by
    rw [(d r).comparison_phase A hp hprimary hA hC]
    change phi ((d r).stratum hp.ne_zero) = phi (e.symm (a r))
    apply congrArg phi
    apply e.injective
    rw [e.apply_symm_apply]
    change cubeResidueStratumMap p ((d r).stratum hp.ne_zero) = a r
    rw [(d r).stratum_map hp.ne_zero]
    rw [← cubeCuspAffineEquiv_mk p ((A : SL(2, O)) 0 0) ((A : SL(2, O)) 1 0)
      (cubeResidueRepresentative p r) hprimary hC, cubeResidueRepresentative_spec]
  letI : ∀ j : Fin 4, Finite (O ⧸ Ideal.span {p ^ (3 - j.val)}) := fun j =>
    (Ideal.span {p ^ (3 - j.val)}).finiteQuotientOfFreeOfNeBot
      (Ideal.span_singleton_eq_bot.not.mpr (pow_ne_zero _ hp.ne_zero))
  have hphi : Summable phi := Summable.of_finite
  calc
    actualCubeCuspPhaseSum A p hp hprimary w = ∑' r, phi (e.symm (a r)) := tsum_congr hpoint
    _ = ∑' r, phi (e.symm r) := a.tsum_eq (fun r => phi (e.symm r))
    _ = ∑' s, phi s := e.symm.tsum_eq phi
    _ = ∑ j : Fin 4, w j * ∑' b : CubicUnitResidue (p ^ (3 - j.val)), cubeStratumSymbol p ((A : SL(2, O)) 1 0) j b := by
      rw [hphi.tsum_sigma, tsum_fintype]
      apply Finset.sum_congr rfl
      intro j _
      exact tsum_mul_left
        (f := fun b : CubicUnitResidue (p ^ (3 - j.val)) => cubeStratumSymbol p ((A : SL(2, O)) 1 0) j b)
        (a := w j)
    _ = _ := cubeStrata_weighted_sum p ((A : SL(2, O)) 1 0) hp hprimary hC w

lemma cube_exponent_zero_of_lower_divisible (A N : SL(2, O)) (p q : O) (j : ℕ)
    (hp : Prime p) (hC : p ∣ A 1 0) (hx : A 0 0 + 3 * q * A 1 0 = p ^ j * N 0 0) : j = 0 := by
  by_contra hj
  have hpx : p ∣ A 0 0 + 3 * q * A 1 0 := by
    rw [hx]
    exact dvd_mul_of_dvd_left (dvd_pow_self p hj) (N 0 0)
  have hpa : p ∣ A 0 0 := by
    simpa only [add_sub_cancel_right] using dvd_sub hpx (dvd_mul_of_dvd_right hC (3 * q))
  have hone : p ∣ (1 : O) := by
    have hd : A 0 0 * A 1 1 - A 0 1 * A 1 0 = 1 := by simpa only [Matrix.det_fin_two] using A.property
    rw [← hd]
    exact dvd_sub (dvd_mul_of_dvd_left hpa _) (dvd_mul_of_dvd_right hC _)
  exact hp.2.1 (isUnit_of_dvd_one hone)

lemma rationalCusp_cube_zero_phase (A N : rationalExtension) (p q : O)
    (hp : lambda ^ 2 ∣ p - 1)
    (hA : lambda ^ 2 ∣ (A : SL(2, O)) 0 0 - 1) (hN : lambda ^ 2 ∣ (N : SL(2, O)) 0 0 - 1)
    (hx : (A : SL(2, O)) 0 0 + 3 * q * (A : SL(2, O)) 1 0 = (N : SL(2, O)) 0 0)
    (hc : (N : SL(2, O)) 1 0 = p ^ 3 * (A : SL(2, O)) 1 0)
    (hNA : (N : SL(2, O)) * (A : SL(2, O))⁻¹ ∈ levelThree) :
    complexCharacter ⟨(N : SL(2, O)) * (A : SL(2, O))⁻¹, hNA⟩ = 1 := by
  have hcop : IsCoprime ((N : SL(2, O)) 0 0) p := by
    refine ⟨(N : SL(2, O)) 1 1, -(N : SL(2, O)) 0 1 * p ^ 2 * (A : SL(2, O)) 1 0, ?_⟩
    have hd : (N : SL(2, O)) 0 0 * (N : SL(2, O)) 1 1 - (N : SL(2, O)) 0 1 * (N : SL(2, O)) 1 0 = 1 := by
      simpa only [Matrix.det_fin_two] using (N : SL(2, O)).property
    rw [hc] at hd
    linear_combination hd
  have hcube : ringComplex (symbol ((N : SL(2, O)) 0 0) p) ^ 3 = 1 := by
    rw [← map_pow, symbol_cube_of_isCoprime _ _ hp hcop, map_one]
  have hb := rationalCusp_cube_phase_balance A N p q 0 hp hA hN (by simpa only [pow_zero, one_mul] using hx)
    (by simpa only [Nat.sub_zero] using hc)
  simp only [pow_zero, mul_one, Nat.sub_zero, hcube] at hb
  have hbase : extendedComplexCharacter A ≠ 0 := by
    intro he
    have hh := extendedComplexCharacter_cube A
    rw [he] at hh
    norm_num at hh
  apply mul_right_cancel₀ hbase
  rw [one_mul, rationalCusp_comparison_character A N hNA, hb]

theorem actualCubeCuspPhaseSum_dvd (A : rationalExtension) (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (hA : lambda ^ 2 ∣ (A : SL(2, O)) 0 0 - 1)
    (hC : p ∣ (A : SL(2, O)) 1 0) (w : Fin 4 → ℂ) :
    actualCubeCuspPhaseSum A p hp hprimary w = w 0 * (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 := by
  let d (r : CubeResidues p) := actualCubeCuspData (A : SL(2, O)) p (cubeResidueRepresentative p r) hp hprimary
  have hpoint (r : CubeResidues p) :
      w (d r).exponent * complexCharacter ⟨(d r).matrix * (A : SL(2, O))⁻¹, (d r).congruent⟩ = w 0 := by
    have hj : ((d r).exponent : ℕ) = 0 := cube_exponent_zero_of_lower_divisible
      (A : SL(2, O)) (d r).matrix p _ _ hp hC (d r).first
    have hj' : (d r).exponent = 0 := Fin.ext hj
    let N : rationalExtension := ⟨(d r).matrix, (d r).rational_mem⟩
    have hphase := rationalCusp_cube_zero_phase A N p (cubeResidueRepresentative p r) hprimary hA
      (integralMatrix_comparison_primary _ _ (d r).congruent hA)
      (by simpa only [hj, pow_zero, one_mul] using (d r).first)
      (by simpa only [hj, Nat.sub_zero] using (d r).lower_eq hp.ne_zero) (d r).congruent
    change w (d r).exponent * complexCharacter ⟨(N : SL(2, O)) * (A : SL(2, O))⁻¹, (d r).congruent⟩ = w 0
    rw [hphase, hj', mul_one]
  calc
    actualCubeCuspPhaseSum A p hp hprimary w = ∑' r : CubeResidues p, w 0 := tsum_congr hpoint
    _ = (Nat.card (CubeResidues p) : ℂ) * w 0 := by rw [tsum_const, nsmul_eq_mul]
    _ = _ := by
      change (Ideal.absNorm (Ideal.span {p ^ 3}) : ℂ) * w 0 = _
      rw [← Ideal.span_singleton_pow, map_pow, Nat.cast_pow]
      ring


lemma complexUpper_lowerRight_ne_zero (T : SL(2, ℂ)) (hT : T 1 0 = 0) : T 1 1 ≠ 0 := by
  intro hd
  have hdet := T.property
  simp only [Matrix.det_fin_two, hT, hd, mul_zero, sub_zero] at hdet
  exact zero_ne_one hdet

/-- Upper triangular hyperbolic isometries act affinely on each horizontal plane. -/
lemma complexUpper_action (T : SL(2, ℂ)) (hT : T 1 0 = 0) (z : ℂ) (v : ℝ) (hv : 0 < v) :
    T • upperPoint z v hv = upperPoint ((T 0 0 * z + T 0 1) / T 1 1)
      (v / ‖T 1 1‖ ^ 2) (div_pos hv (sq_pos_of_ne_zero (norm_ne_zero_iff.mpr (complexUpper_lowerRight_ne_zero T hT)))) := by
  have hdet : T 0 0 * T 1 1 = 1 := by
    simpa only [Matrix.det_fin_two, hT, mul_zero, sub_zero] using T.property
  have ha : T 0 0 ≠ 0 := by intro h; rw [h, zero_mul] at hdet; exact zero_ne_one hdet
  have hd : T 1 1 = (T 0 0)⁻¹ := by
    apply mul_left_cancel₀ ha
    rw [hdet, mul_inv_cancel₀ ha]
  have hfactor : T = complexTranslation (T 0 1 / T 1 1) * complexDiagonal (T 0 0) ha := by
    apply Matrix.SpecialLinearGroup.ext
    intro i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two, complexTranslation, complexDiagonal, hT, hd, ha]
  conv_lhs => rw [hfactor, mul_smul, complexDiagonal_action, complexTranslation_action]
  apply upperPoint_congr
  · rw [hd]
    field_simp
  · rw [hd, norm_inv, inv_pow, div_inv_eq_mul, Complex.normSq_eq_norm_sq]
    ring

lemma cubeAverageMatrix_entries (p : O) (hp : p ≠ 0) (q : O) :
    (cubeAverageMatrix p hp q : Matrix (Fin 2) (Fin 2) ℂ) =
      !![(cubeDilationRoot p)⁻¹, (cubeDilationRoot p)⁻¹ * (3 * ringComplex q); 0, cubeDilationRoot p] := by
  have hentry (M : SL(2, O)) (i j : Fin 2) : integralComplexMatrix M i j = ringComplex (M i j) := rfl
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [cubeAverageMatrix, cubeDilationMatrix, complexDiagonal,
      Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two,
      Matrix.mul_apply, Fin.sum_univ_two, hentry, integralTranslation, map_mul, map_ofNat]

def cubeCuspTriangular {A : SL(2, O)} {p q : O} (d : CubeCuspData A p q) (hp : p ≠ 0) : SL(2, ℂ) :=
  (integralComplexMatrix d.matrix)⁻¹ * cubeAverageMatrix p hp q * integralComplexMatrix A

lemma cubeCuspTriangular_factor {A : SL(2, O)} {p q : O} (d : CubeCuspData A p q) (hp : p ≠ 0) :
    cubeAverageMatrix p hp q * integralComplexMatrix A = integralComplexMatrix d.matrix * cubeCuspTriangular d hp := by
  unfold cubeCuspTriangular
  group

lemma cubeCuspTriangular_entries {A : SL(2, O)} {p q : O} (d : CubeCuspData A p q) (hp : p ≠ 0) :
    cubeCuspTriangular d hp 0 0 = (cubeDilationRoot p)⁻¹ * ringComplex p ^ d.exponent.val ∧
    cubeCuspTriangular d hp 1 0 = 0 ∧
    cubeCuspTriangular d hp 1 1 = (cubeDilationRoot p)⁻¹ * ringComplex p ^ (3 - d.exponent.val) := by
  let B := cubeAverageMatrix p hp q * integralComplexMatrix A
  have hz := cubeDilationRoot_ne_zero p hp
  have he : cubeDilationRoot p ^ 2 = ringComplex p ^ 3 := by rw [cubeDilationRoot_sq, map_pow]
  have hentry (M : SL(2, O)) (i j : Fin 2) : integralComplexMatrix M i j = ringComplex (M i j) := rfl
  have hx : ringComplex (A 0 0) + 3 * ringComplex q * ringComplex (A 1 0) =
      ringComplex p ^ d.exponent.val * ringComplex (d.matrix 0 0) := by
    simpa only [map_add, map_mul, map_pow, map_ofNat] using congrArg ringComplex d.first
  have hy : ringComplex p ^ 3 * ringComplex (A 1 0) =
      ringComplex p ^ d.exponent.val * ringComplex (d.matrix 1 0) := by
    simpa only [map_mul, map_pow] using congrArg ringComplex d.second
  have hB0 : B 0 0 = (cubeDilationRoot p)⁻¹ * ringComplex p ^ d.exponent.val * ringComplex (d.matrix 0 0) := by
    change (∑ k : Fin 2, cubeAverageMatrix p hp q 0 k * integralComplexMatrix A k 0) = _
    simp only [cubeAverageMatrix_entries, hentry, Matrix.of_apply, Fin.sum_univ_two,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one]
    linear_combination (cubeDilationRoot p)⁻¹ * hx
  have hB1 : B 1 0 = (cubeDilationRoot p)⁻¹ * ringComplex p ^ d.exponent.val * ringComplex (d.matrix 1 0) := by
    change (∑ k : Fin 2, cubeAverageMatrix p hp q 1 k * integralComplexMatrix A k 0) = _
    simp only [cubeAverageMatrix_entries, hentry, Matrix.of_apply, Fin.sum_univ_two,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one, zero_mul, zero_add]
    rw [mul_assoc, ← hy, ← he]
    field_simp
  have hT : cubeCuspTriangular d hp = (integralComplexMatrix d.matrix)⁻¹ * B := by
    dsimp only [cubeCuspTriangular, B]
    group
  have hdet : ringComplex (d.matrix 0 0) * ringComplex (d.matrix 1 1) -
      ringComplex (d.matrix 0 1) * ringComplex (d.matrix 1 0) = 1 := by
    have hd : d.matrix 0 0 * d.matrix 1 1 - d.matrix 0 1 * d.matrix 1 0 = 1 := by
      simpa only [Matrix.det_fin_two] using d.matrix.property
    simpa only [map_sub, map_mul, map_one] using congrArg ringComplex hd
  have h00 : cubeCuspTriangular d hp 0 0 = (cubeDilationRoot p)⁻¹ * ringComplex p ^ d.exponent.val := by
    rw [hT]
    simp only [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two,
      Matrix.mul_apply, Fin.sum_univ_two, hentry, Matrix.of_apply,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one, hB0, hB1]
    linear_combination (cubeDilationRoot p)⁻¹ * ringComplex p ^ d.exponent.val * hdet
  have h10 : cubeCuspTriangular d hp 1 0 = 0 := by
    rw [hT]
    simp only [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two,
      Matrix.mul_apply, Fin.sum_univ_two, hentry, Matrix.of_apply,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one, hB0, hB1]
    ring
  refine ⟨h00, h10, ?_⟩
  have hd : cubeCuspTriangular d hp 0 0 * cubeCuspTriangular d hp 1 1 = 1 := by
    simpa only [Matrix.det_fin_two, h10, mul_zero, sub_zero] using (cubeCuspTriangular d hp).property
  rw [h00] at hd
  apply mul_left_cancel₀ (mul_ne_zero (inv_ne_zero hz) (pow_ne_zero _ (ringComplex_ne_zero hp)))
  rw [hd]
  have hpow : ringComplex p ^ d.exponent.val * ringComplex p ^ (3 - d.exponent.val) = ringComplex p ^ 3 := by
    rw [← pow_add, Nat.add_sub_of_le (by omega : d.exponent.val ≤ 3)]
  calc
    1 = (cubeDilationRoot p)⁻¹ ^ 2 * ringComplex p ^ 3 := by rw [← he, inv_pow, inv_mul_cancel₀ (pow_ne_zero 2 hz)]
    _ = _ := by rw [← hpow]; ring

lemma cubeCuspTriangular_integral_scale {A : SL(2, O)} {p q : O} (d : CubeCuspData A p q) (hp : p ≠ 0) :
    (cubeCuspTriangular d hp 0 0 / cubeCuspTriangular d hp 1 1) * ringComplex (p ^ 3) =
      ringComplex (p ^ (2 * d.exponent.val)) := by
  obtain ⟨h00, _, h11⟩ := cubeCuspTriangular_entries d hp
  rw [h00, h11, map_pow, map_pow]
  have hz := cubeDilationRoot_ne_zero p hp
  have he := ringComplex_ne_zero hp
  have hpow : ringComplex p ^ 3 = ringComplex p ^ d.exponent.val * ringComplex p ^ (3 - d.exponent.val) := by
    rw [← pow_add, Nat.add_sub_of_le (by omega : d.exponent.val ≤ 3)]
  rw [hpow, show ringComplex p ^ (2 * d.exponent.val) = (ringComplex p ^ d.exponent.val) ^ 2 by
    rw [mul_comm 2 d.exponent.val, pow_mul]]
  field_simp

lemma cubeDilationRoot_norm_sq (p : O) : ‖cubeDilationRoot p‖ ^ 2 = ‖ringComplex p‖ ^ 3 := by
  rw [← norm_pow, cubeDilationRoot_sq, map_pow, norm_pow]

def cubeCuspHeightDenominator (p : O) (j : Fin 4) : ℝ :=
  (‖cubeDilationRoot p‖ ^ 2)⁻¹ * (‖ringComplex p‖ ^ (3 - j.val)) ^ 2

def cubeCuspHeightWeight (p : O) (j : Fin 4) : ℂ :=
  (cubeCuspHeightDenominator p j ^ (-2 / 3 : ℝ) : ℝ)

lemma cubeCuspHeightDenominator_pos (p : O) (hp : p ≠ 0) (j : Fin 4) : 0 < cubeCuspHeightDenominator p j := by
  have hz : 0 < ‖cubeDilationRoot p‖ := norm_pos_iff.mpr (cubeDilationRoot_ne_zero p hp)
  have hr : 0 < ‖ringComplex p‖ := norm_pos_iff.mpr (ringComplex_ne_zero hp)
  unfold cubeCuspHeightDenominator
  positivity

lemma cubeCuspTriangular_norm_sq {A : SL(2, O)} {p q : O} (d : CubeCuspData A p q) (hp : p ≠ 0) :
    ‖cubeCuspTriangular d hp 1 1‖ ^ 2 = cubeCuspHeightDenominator p d.exponent := by
  rw [(cubeCuspTriangular_entries d hp).2.2, norm_mul, norm_inv, norm_pow, mul_pow, inv_pow]
  rfl

lemma cubeCuspTriangular_height {A : SL(2, O)} {p q : O} (d : CubeCuspData A p q) (hp : p ≠ 0)
    (v : ℝ) (hv : 0 < v) :
    ((v / ‖cubeCuspTriangular d hp 1 1‖ ^ 2 : ℝ) : ℂ) ^ (2 / 3 : ℂ) =
      (v : ℂ) ^ (2 / 3 : ℂ) * cubeCuspHeightWeight p d.exponent := by
  have hD := cubeCuspHeightDenominator_pos p hp d.exponent
  rw [cubeCuspTriangular_norm_sq]
  have hc : ((2 / 3 : ℝ) : ℂ) = (2 / 3 : ℂ) := by norm_num
  rw [← hc, ← Complex.ofReal_cpow (div_pos hv hD).le, ← Complex.ofReal_cpow hv.le,
    cubeCuspHeightWeight, ← Complex.ofReal_mul]
  apply congrArg Complex.ofReal
  rw [Real.div_rpow hv.le hD.le, div_eq_mul_inv, ← Real.rpow_neg hD.le]
  congr 2 <;> ring

lemma cubeCuspHeightDenominator_zero (p : O) (hp : p ≠ 0) :
    cubeCuspHeightDenominator p 0 = ‖ringComplex p‖ ^ 3 := by
  unfold cubeCuspHeightDenominator
  rw [cubeDilationRoot_norm_sq]
  norm_num only [Fin.val_zero, Nat.sub_zero]
  have hr := norm_ne_zero_iff.mpr (ringComplex_ne_zero hp)
  field_simp <;> ring

lemma cubeCuspHeightDenominator_three (p : O) :
    cubeCuspHeightDenominator p 3 = (‖ringComplex p‖ ^ 3)⁻¹ := by
  unfold cubeCuspHeightDenominator
  rw [cubeDilationRoot_norm_sq]
  norm_num

lemma cubeCuspHeightWeight_zero (p : O) (hp : p ≠ 0) :
    cubeCuspHeightWeight p 0 = (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ := by
  have hr : 0 < ‖ringComplex p‖ := norm_pos_iff.mpr (ringComplex_ne_zero hp)
  have he : (‖ringComplex p‖ ^ 3) ^ (-2 / 3 : ℝ) = (‖ringComplex p‖ ^ 2)⁻¹ := by
    rw [← Real.rpow_natCast_mul hr.le 3, Nat.cast_ofNat]
    rw [show (3 : ℝ) * (-2 / 3) = -(2 : ℝ) by ring, Real.rpow_neg hr.le, Real.rpow_ofNat]
  rw [cubeCuspHeightWeight, cubeCuspHeightDenominator_zero p hp, he,
    ringComplex_norm_sq_eq_absNorm_span, Complex.ofReal_inv, Complex.ofReal_natCast]

lemma cubeCuspHeightWeight_three (p : O) (hp : p ≠ 0) :
    cubeCuspHeightWeight p 3 = (Ideal.absNorm (Ideal.span {p}) : ℂ) := by
  have hr : 0 < ‖ringComplex p‖ := norm_pos_iff.mpr (ringComplex_ne_zero hp)
  have he : ((‖ringComplex p‖ ^ 3)⁻¹) ^ (-2 / 3 : ℝ) = ‖ringComplex p‖ ^ 2 := by
    rw [Real.inv_rpow (pow_nonneg hr.le 3), ← Real.rpow_natCast_mul hr.le 3, Nat.cast_ofNat,
      show (3 : ℝ) * (-2 / 3) = -(2 : ℝ) by ring, Real.rpow_neg hr.le, Real.rpow_ofNat, inv_inv]
  rw [cubeCuspHeightWeight, cubeCuspHeightDenominator_three, he,
    ringComplex_norm_sq_eq_absNorm_span, Complex.ofReal_natCast]

lemma rationalSourceCuspConstant_congruent (A N : rationalExtension)
    (hNA : (N : SL(2, O)) * (A : SL(2, O))⁻¹ ∈ levelThree) :
    rationalSourceCuspConstant N = complexCharacter ⟨(N : SL(2, O)) * (A : SL(2, O))⁻¹, hNA⟩ * rationalSourceCuspConstant A := by
  unfold rationalSourceCuspConstant
  rw [← rationalCusp_comparison_character A N hNA]
  ring

/-- The average of one cube branch separates its exact height weight from its cubic multiplier. -/
theorem rationalSourceCubeBranch_average (A : rationalExtension) {p q : O}
    (d : CubeCuspData (A : SL(2, O)) p q) (hp : p ≠ 0) (v : ℝ) (hv : 0 < v) :
    (∫ z in periodDomain, cubicSourceResidualFunction
      (cubeAverageMatrix p hp q • (integralComplexMatrix (A : SL(2, O)) • upperPoint (ringComplex (p ^ 3) * z) v hv))) =
      rationalSourceCuspConstant A * (v : ℂ) ^ (2 / 3 : ℂ) *
        (cubeCuspHeightWeight p d.exponent * complexCharacter ⟨d.matrix * (A : SL(2, O))⁻¹, d.congruent⟩) := by
  let N : rationalExtension := ⟨d.matrix, d.rational_mem⟩
  let T := cubeCuspTriangular d hp
  have hT : T 1 0 = 0 := (cubeCuspTriangular_entries d hp).2.1
  have hcoord (z : ℂ) : (T 0 0 * (ringComplex (p ^ 3) * z) + T 0 1) / T 1 1 =
      ringComplex (p ^ (2 * d.exponent.val)) * z + T 0 1 / T 1 1 := by
    calc
      _ = ((T 0 0 / T 1 1) * ringComplex (p ^ 3)) * z + T 0 1 / T 1 1 := by ring
      _ = _ := by rw [cubeCuspTriangular_integral_scale d hp]
  have hact (z : ℂ) :
      cubeAverageMatrix p hp q • (integralComplexMatrix (A : SL(2, O)) •
        upperPoint (ringComplex (p ^ 3) * z) v hv) =
      integralComplexMatrix (N : SL(2, O)) • upperPoint
        (ringComplex (p ^ (2 * d.exponent.val)) * z + T 0 1 / T 1 1)
        (v / ‖T 1 1‖ ^ 2)
        (div_pos hv (sq_pos_of_ne_zero (norm_ne_zero_iff.mpr (complexUpper_lowerRight_ne_zero T hT)))) := by
    rw [← mul_smul, cubeCuspTriangular_factor d hp, mul_smul]
    change integralComplexMatrix (N : SL(2, O)) • (T • upperPoint (ringComplex (p ^ 3) * z) v hv) = _
    rw [complexUpper_action T hT, hcoord]
  simp_rw [hact]
  rw [rationalSourceCusp_average_enlarged_affine N (p ^ (2 * d.exponent.val))
    (pow_ne_zero _ hp) (T 0 1 / T 1 1) _ _,
    rationalSourceCuspConstant_congruent A N d.congruent, cubeCuspTriangular_height d hp v hv]
  ring

/-- Normalized average of the actual translated inverse cube dilations. -/
def cubeAverage (p : O) (hp : p ≠ 0) (F : HyperbolicSpace → ℂ) (w : HyperbolicSpace) : ℂ :=
  (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ ^ 3 *
    ∑' r : CubeResidues p, F (cubeAverageMatrix p hp (cubeResidueRepresentative p r) • w)

lemma cubeAverage_continuous (p : O) (hp : p ≠ 0) (F : HyperbolicSpace → ℂ) (hF : Continuous F) :
    Continuous (cubeAverage p hp F) := by
  letI : Finite (CubeResidues p) := (Ideal.span {p ^ 3}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr (pow_ne_zero 3 hp))
  letI : Fintype (CubeResidues p) := Fintype.ofFinite _
  unfold cubeAverage
  simp only [tsum_fintype]
  exact continuous_const.mul (continuous_finsetSum Finset.univ (fun r _ => hF.comp (continuous_hyperbolic_action _)))

lemma cubeAverage_cusp_integral (p : O) (hp : p ≠ 0) (F : HyperbolicSpace → ℂ) (hF : Continuous F)
    (M : SL(2, O)) (b : O) (v : ℝ) (hv : 0 < v) :
    (∫ z in periodDomain, cubeAverage p hp F (integralComplexMatrix M • upperPoint (ringComplex b * z) v hv)) =
      (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ ^ 3 *
        ∑' r : CubeResidues p, ∫ z in periodDomain,
          F (cubeAverageMatrix p hp (cubeResidueRepresentative p r) •
            (integralComplexMatrix M • upperPoint (ringComplex b * z) v hv)) := by
  letI : Finite (CubeResidues p) := (Ideal.span {p ^ 3}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr (pow_ne_zero 3 hp))
  letI : Fintype (CubeResidues p) := Fintype.ofFinite _
  letI := periodDomain_finiteMeasure
  have hi (r : CubeResidues p) : IntegrableOn
      (fun z : ℂ => F (cubeAverageMatrix p hp (cubeResidueRepresentative p r) •
        (integralComplexMatrix M • upperPoint (ringComplex b * z) v hv))) periodDomain := by
    apply (periodDomain_continuous_memLp _ ?_).integrable (by norm_num)
    exact (((hF.comp (continuous_hyperbolic_action _)).comp (continuous_hyperbolic_action _)).comp
      (upperCoordinatesHomeomorph.continuous.comp
        (show Continuous (fun z : ℂ => (⟨(ringComplex b * z, v), hv⟩ : UpperCoordinates)) by fun_prop)))
  unfold cubeAverage
  simp only [tsum_fintype]
  rw [integral_const_mul]
  congr 1
  exact integral_finsetSum Finset.univ (fun r _ => hi r)

lemma principalNorm_complex_ne_zero (p : O) (hp : p ≠ 0) : (Ideal.absNorm (Ideal.span {p}) : ℂ) ≠ 0 := by
  have hr : (Ideal.absNorm (Ideal.span {p}) : ℝ) ≠ 0 := by
    rw [← ringComplex_norm_sq_eq_absNorm_span]
    exact pow_ne_zero 2 (norm_ne_zero_iff.mpr (ringComplex_ne_zero hp))
  exact_mod_cast hr

/-- The exact height weights turn the surviving phase strata into the square of the prime norm. -/
theorem actualCubeCuspPhaseSum_height (A : rationalExtension) (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (hA : lambda ^ 2 ∣ (A : SL(2, O)) 0 0 - 1) :
    actualCubeCuspPhaseSum A p hp hprimary (cubeCuspHeightWeight p) =
      (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 2 := by
  have hn := principalNorm_complex_ne_zero p hp.ne_zero
  by_cases hC : p ∣ (A : SL(2, O)) 1 0
  · rw [actualCubeCuspPhaseSum_dvd A p hp hprimary hA hC, cubeCuspHeightWeight_zero p hp.ne_zero]
    field_simp
  · rw [actualCubeCuspPhaseSum_coprime A p hp hprimary hA (hp.coprime_iff_not_dvd.mpr hC).symm,
      cubeCuspHeightWeight_zero p hp.ne_zero, cubeCuspHeightWeight_three p hp.ne_zero]
    field_simp <;> ring

/-- Every primary rational cusp has the expected cube-average constant term. -/
theorem cubeSource_average_primary (A : rationalExtension) (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (hA : lambda ^ 2 ∣ (A : SL(2, O)) 0 0 - 1)
    (v : ℝ) (hv : 0 < v) :
    (∫ z in periodDomain, cubeAverage p hp.ne_zero cubicSourceResidualFunction
      (integralComplexMatrix (A : SL(2, O)) • upperPoint (ringComplex (p ^ 3) * z) v hv)) =
      (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ * rationalSourceCuspConstant A * (v : ℂ) ^ (2 / 3 : ℂ) := by
  rw [cubeAverage_cusp_integral p hp.ne_zero cubicSourceResidualFunction cubicSourceResidualFunction_continuous]
  have hterm (r : CubeResidues p) := rationalSourceCubeBranch_average A
    (actualCubeCuspData (A : SL(2, O)) p (cubeResidueRepresentative p r) hp hprimary) hp.ne_zero v hv
  simp_rw [hterm]
  rw [tsum_mul_left]
  change (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ ^ 3 *
    ((rationalSourceCuspConstant A * (v : ℂ) ^ (2 / 3 : ℂ)) *
      actualCubeCuspPhaseSum A p hp hprimary (cubeCuspHeightWeight p)) = _
  rw [actualCubeCuspPhaseSum_height A p hp hprimary hA]
  have hn := principalNorm_complex_ne_zero p hp.ne_zero
  field_simp <;> ring

def cubeSourceDifference (p : O) (hp : p ≠ 0) (w : HyperbolicSpace) : ℂ :=
  cubeAverage p hp cubicSourceResidualFunction w -
    (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ * cubicSourceResidualFunction w

lemma cubeSourceDifference_continuous (p : O) (hp : p ≠ 0) : Continuous (cubeSourceDifference p hp) :=
  (cubeAverage_continuous p hp cubicSourceResidualFunction cubicSourceResidualFunction_continuous).sub
    (continuous_const.mul cubicSourceResidualFunction_continuous)

lemma cubeAverageMatrix_period (p : O) (hp : p ≠ 0) (q n : O) :
    cubeAverageMatrix p hp (q + p ^ 3 * n) = complexTranslation (3 * ringComplex n) * cubeAverageMatrix p hp q := by
  have hz := cubeDilationRoot_ne_zero p hp
  have he : cubeDilationRoot p ^ 2 = ringComplex p ^ 3 := by rw [cubeDilationRoot_sq, map_pow]
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  fin_cases i <;> fin_cases j <;>
    simp [cubeAverageMatrix_entries, Matrix.SpecialLinearGroup.coe_mul,
      Matrix.mul_apply, Fin.sum_univ_two, complexTranslation, Matrix.of_apply,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one, map_add, map_mul, map_pow,
      zero_mul, mul_zero, one_mul, mul_one, zero_add, add_zero]
  field_simp
  linear_combination -(ringComplex n) * he

lemma cubeSummand_congr (p : O) (hp : p ≠ 0) (F : HyperbolicSpace → ℂ)
    (hper : ∀ n : O, ∀ w, F (complexTranslation (3 * ringComplex n) • w) = F w)
    (q r : O) (hqr : p ^ 3 ∣ q - r) (w : HyperbolicSpace) :
    F (cubeAverageMatrix p hp q • w) = F (cubeAverageMatrix p hp r • w) := by
  obtain ⟨n, hn⟩ := hqr
  have hq : q = r + p ^ 3 * n := by linear_combination hn
  rw [hq, cubeAverageMatrix_period, mul_smul, hper]

lemma cubeAverageMatrix_shift_one (p : O) (hp : p ≠ 0) (q t : O) (ht : p ^ 3 - 1 = 3 * t) :
    cubeAverageMatrix p hp q * complexTranslation 1 = complexTranslation 1 * cubeAverageMatrix p hp (q - t) := by
  have hz := cubeDilationRoot_ne_zero p hp
  have he : cubeDilationRoot p ^ 2 = ringComplex p ^ 3 := by rw [cubeDilationRoot_sq, map_pow]
  have ht' : ringComplex p ^ 3 - 1 = 3 * ringComplex t := by
    simpa only [map_sub, map_pow, map_one, map_mul, map_ofNat] using congrArg ringComplex ht
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two,
      cubeAverageMatrix_entries, complexTranslation, Matrix.of_apply, map_sub,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one,
      zero_mul, mul_zero, one_mul, mul_one, zero_add, add_zero]
  field_simp
  linear_combination -he - ht'

/-- Primary cube averages retain the source's rational translation symmetry. -/
theorem cubeAverage_period_one (p : O) (hp : p ≠ 0) (hprimary : lambda ^ 2 ∣ p - 1)
    (F : HyperbolicSpace → ℂ)
    (hper : ∀ n : O, ∀ w, F (complexTranslation (3 * ringComplex n) • w) = F w)
    (hone : ∀ w, F (complexTranslation 1 • w) = F w) (w : HyperbolicSpace) :
    cubeAverage p hp F (complexTranslation 1 • w) = cubeAverage p hp F w := by
  obtain ⟨t, ht⟩ := primary_pow_mod_three p hprimary 3
  let c := Ideal.Quotient.mk (Ideal.span {p ^ 3}) t
  let e : CubeResidues p ≃ CubeResidues p := {
    toFun := fun r => r - c
    invFun := fun r => r + c
    left_inv := fun r => sub_add_cancel r c
    right_inv := fun r => add_sub_cancel_right r c }
  have hterm (r : CubeResidues p) : F (cubeAverageMatrix p hp (cubeResidueRepresentative p r) •
      (complexTranslation 1 • w)) = F (cubeAverageMatrix p hp (cubeResidueRepresentative p (e r)) • w) := by
    rw [← mul_smul, cubeAverageMatrix_shift_one p hp _ t ht, mul_smul, hone]
    apply cubeSummand_congr p hp F hper _ _ _ w
    apply Ideal.mem_span_singleton.mp
    apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp
    simp only [map_sub, cubeResidueRepresentative_spec]
    rfl
  unfold cubeAverage
  congr 1
  calc
    _ = ∑' r : CubeResidues p, F (cubeAverageMatrix p hp (cubeResidueRepresentative p (e r)) • w) := tsum_congr hterm
    _ = _ := e.tsum_eq (fun r : CubeResidues p => F (cubeAverageMatrix p hp (cubeResidueRepresentative p r) • w))

lemma cubicSourceResidualFunction_period_one_action (w : HyperbolicSpace) :
    cubicSourceResidualFunction (complexTranslation 1 • w) = cubicSourceResidualFunction w := by
  obtain ⟨z, v, hv, rfl⟩ := upperPoint_surjective w
  rw [complexTranslation_action]
  have h := cubicSourceResidualFunction_rational (rationalUnipotent 1) (upperPoint z v hv)
  change cubicSourceResidualFunction (rationalComplex (rationalUnipotent 1) • upperPoint z v hv) = _ at h
  rw [rationalUnipotent_action] at h
  simpa only [Int.cast_one] using h

lemma cubeSourceDifference_period_one (p : O) (hp : p ≠ 0) (hprimary : lambda ^ 2 ∣ p - 1)
    (w : HyperbolicSpace) : cubeSourceDifference p hp (complexTranslation 1 • w) = cubeSourceDifference p hp w := by
  have hper (n : O) (u : HyperbolicSpace) :
      cubicSourceResidualFunction (complexTranslation (3 * ringComplex n) • u) = cubicSourceResidualFunction u := by
    obtain ⟨z, v, hv, rfl⟩ := upperPoint_surjective u
    rw [complexTranslation_action]
    exact cubicSourceResidualFunction_period v hv z n
  unfold cubeSourceDifference
  rw [cubeAverage_period_one p hp hprimary _ hper cubicSourceResidualFunction_period_one_action,
    cubicSourceResidualFunction_period_one_action]


/-- A rational cusp becomes primary after at most one integral translation and a sign. -/
lemma rationalCusp_primary_cases (A : rationalExtension) :
    (lambda ^ 2 ∣ (A : SL(2, O)) 0 0 - 1 ∨ lambda ^ 2 ∣ -(A : SL(2, O)) 0 0 - 1) ∨
    (lambda ^ 2 ∣ (A : SL(2, O)) 0 0 + (A : SL(2, O)) 1 0 - 1 ∨
      lambda ^ 2 ∣ -((A : SL(2, O)) 0 0 + (A : SL(2, O)) 1 0) - 1) := by
  obtain ⟨a, ha⟩ := rationalExtension_entry_integer A 0 0
  obtain ⟨c, hc⟩ := rationalExtension_entry_integer A 1 0
  rcases integer_congruence_primary_cases _ a ha with h0 | h1 | h1
  · right
    have hlambda : lambda ^ 2 ∣ (A : SL(2, O)) 0 0 := lambda_sq_dvd_three.trans h0
    rcases integer_congruence_primary_cases _ c hc with hC | hC | hC
    · have hd : (3 : O) ∣ (1 : O) := by
        have hdet : (A : SL(2, O)) 0 0 * (A : SL(2, O)) 1 1 -
            (A : SL(2, O)) 0 1 * (A : SL(2, O)) 1 0 = 1 := by
          simpa only [Matrix.det_fin_two] using (A : SL(2, O)).property
        rw [← hdet]
        exact dvd_sub (h0.mul_right _) (hC.mul_left _)
      have hl : lambda ∣ lambda ^ 2 := ⟨lambda, by ring⟩
      exact (lambda_not_dvd_two (hl.trans (lambda_sq_dvd_three.trans (hd.trans (one_dvd 2))))).elim
    · exact Or.inl (by convert dvd_add hlambda hC using 1 <;> ring)
    · exact Or.inr (by convert dvd_add (dvd_neg.mpr hlambda) hC using 1 <;> ring)
  · exact Or.inl (Or.inl h1)
  · exact Or.inl (Or.inr h1)

def rationalCentralSign : SL(2, ℤ) := ⟨!![-1, 0; 0, -1], by simp [Matrix.det_fin_two]⟩

lemma rationalCentralSign_action (w : HyperbolicSpace) :
    integralComplexMatrix (rationalEmbedding rationalCentralSign) • w = w := by
  have he : integralComplexMatrix (rationalEmbedding rationalCentralSign) = complexDiagonal (-1) (by norm_num) := by
    apply Matrix.SpecialLinearGroup.ext
    intro i j
    fin_cases i <;> fin_cases j <;>
      simp [rationalCentralSign, rationalEmbedding, integralComplexMatrix, complexDiagonal]
  obtain ⟨z, v, hv, rfl⟩ := upperPoint_surjective w
  rw [he, complexDiagonal_action]
  apply upperPoint_congr <;> simp

lemma rationalCentralSign_mul_entry (A : rationalExtension) :
    ((rationalSourceLift rationalCentralSign * A : rationalExtension) : SL(2, O)) 0 0 =
      -(A : SL(2, O)) 0 0 := by
  simp [rationalSourceLift, rationalCentralSign, rationalEmbedding,
    Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two]

lemma rationalUnipotent_one_mul_entry (A : rationalExtension) :
    ((rationalSourceLift (rationalUnipotent 1) * A : rationalExtension) : SL(2, O)) 0 0 =
      (A : SL(2, O)) 0 0 + (A : SL(2, O)) 1 0 := by
  simp [rationalSourceLift, rationalUnipotent, rationalEmbedding,
    Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two]

lemma rationalUnipotent_one_complex :
    integralComplexMatrix (rationalEmbedding (rationalUnipotent 1)) = complexTranslation 1 := by
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  fin_cases i <;> fin_cases j <;>
    simp [rationalEmbedding, rationalUnipotent, integralComplexMatrix, complexTranslation]

lemma rationalCusp_primary_normalization (A : rationalExtension) (F : HyperbolicSpace → ℂ)
    (hF : ∀ w, F (complexTranslation 1 • w) = F w) :
    ∃ B : rationalExtension, lambda ^ 2 ∣ (B : SL(2, O)) 0 0 - 1 ∧
      ∀ w, F (integralComplexMatrix (B : SL(2, O)) • w) = F (integralComplexMatrix (A : SL(2, O)) • w) := by
  have hsign (B : rationalExtension) (hB : lambda ^ 2 ∣ -(B : SL(2, O)) 0 0 - 1) :
      ∃ C : rationalExtension, lambda ^ 2 ∣ (C : SL(2, O)) 0 0 - 1 ∧
        ∀ w, F (integralComplexMatrix (C : SL(2, O)) • w) = F (integralComplexMatrix (B : SL(2, O)) • w) := by
    refine ⟨rationalSourceLift rationalCentralSign * B, ?_, ?_⟩
    · rwa [rationalCentralSign_mul_entry]
    · intro w
      change F (integralComplexMatrix (rationalEmbedding rationalCentralSign * (B : SL(2, O))) • w) = _
      rw [map_mul, mul_smul, rationalCentralSign_action]
  rcases rationalCusp_primary_cases A with (h | h) | h
  · exact ⟨A, h, fun _ => rfl⟩
  · exact hsign A h
  · let B := rationalSourceLift (rationalUnipotent 1) * A
    have hBA (w : HyperbolicSpace) : F (integralComplexMatrix (B : SL(2, O)) • w) =
        F (integralComplexMatrix (A : SL(2, O)) • w) := by
      change F (integralComplexMatrix (rationalEmbedding (rationalUnipotent 1) * (A : SL(2, O))) • w) = _
      rw [map_mul, mul_smul, rationalUnipotent_one_complex, hF]
    have hb : (B : SL(2, O)) 0 0 = (A : SL(2, O)) 0 0 + (A : SL(2, O)) 1 0 :=
      rationalUnipotent_one_mul_entry A
    rcases h with h | h
    · exact ⟨B, by rwa [hb], hBA⟩
    · obtain ⟨C, hC, hCB⟩ := hsign B (by rwa [hb])
      exact ⟨C, hC, fun w => (hCB w).trans (hBA w)⟩

lemma continuous_rationalCusp_affine (F : HyperbolicSpace → ℂ) (hF : Continuous F)
    (M : SL(2, O)) (b c : ℂ) (v : ℝ) (hv : 0 < v) :
    Continuous (fun z : ℂ => F (integralComplexMatrix M • upperPoint (b * z + c) v hv)) :=
  (hF.comp (continuous_hyperbolic_action _)).comp
    (upperCoordinatesHomeomorph.continuous.comp
      (show Continuous (fun z : ℂ => (⟨(b * z + c, v), hv⟩ : UpperCoordinates)) by fun_prop))

lemma integrable_rationalCusp_scaled (F : HyperbolicSpace → ℂ) (hF : Continuous F)
    (M : SL(2, O)) (b : ℂ) (v : ℝ) (hv : 0 < v) :
    IntegrableOn (fun z : ℂ => F (integralComplexMatrix M • upperPoint (b * z) v hv)) periodDomain := by
  letI := periodDomain_finiteMeasure
  apply (periodDomain_continuous_memLp _ ?_).integrable (by norm_num)
  simpa only [add_zero] using continuous_rationalCusp_affine F hF M b 0 v hv

lemma cubeSourceDifference_primary_average_zero (A : rationalExtension) (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (hA : lambda ^ 2 ∣ (A : SL(2, O)) 0 0 - 1)
    (v : ℝ) (hv : 0 < v) :
    (∫ z in periodDomain, cubeSourceDifference p hp.ne_zero
      (integralComplexMatrix (A : SL(2, O)) • upperPoint (ringComplex (p ^ 3) * z) v hv)) = 0 := by
  have hU := integrable_rationalCusp_scaled _
    (cubeAverage_continuous p hp.ne_zero _ cubicSourceResidualFunction_continuous)
    (A : SL(2, O)) (ringComplex (p ^ 3)) v hv
  have hS := integrable_rationalCusp_scaled _ cubicSourceResidualFunction_continuous
    (A : SL(2, O)) (ringComplex (p ^ 3)) v hv
  have hav := rationalSourceCusp_average_enlarged_affine A (p ^ 3) (pow_ne_zero 3 hp.ne_zero) 0 v hv
  simp only [add_zero] at hav
  unfold cubeSourceDifference
  rw [integral_sub hU (hS.const_mul _), integral_const_mul,
    cubeSource_average_primary A p hp hprimary hA, hav]
  ring

/-- Every rational cusp of the cube difference has zero mean on the same enlarged cell. -/
theorem cubeSourceDifference_rational_average_zero (A : rationalExtension) (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (v : ℝ) (hv : 0 < v) :
    (∫ z in periodDomain, cubeSourceDifference p hp.ne_zero
      (integralComplexMatrix (A : SL(2, O)) • upperPoint (ringComplex (p ^ 3) * z) v hv)) = 0 := by
  obtain ⟨B, hB, he⟩ := rationalCusp_primary_normalization A (cubeSourceDifference p hp.ne_zero)
    (cubeSourceDifference_period_one p hp.ne_zero hprimary)
  simp_rw [← he]
  exact cubeSourceDifference_primary_average_zero B p hp hprimary hB v hv

lemma cubicSourceResidualFunction_rationalCusp_period (A : rationalExtension)
    (z : ℂ) (v : ℝ) (hv : 0 < v) (n : O) :
    cubicSourceResidualFunction (integralComplexMatrix (A : SL(2, O)) • upperPoint (z + 3 * ringComplex n) v hv) =
      cubicSourceResidualFunction (integralComplexMatrix (A : SL(2, O)) • upperPoint z v hv) := by
  rw [cubicSourceResidualFunction_automorphy, cubicSourceResidualFunction_automorphy,
    cubicSourceResidualFunction_period]

lemma cubeSource_summand_rationalCusp_period {A : rationalExtension} {p q : O}
    (d : CubeCuspData (A : SL(2, O)) p q) (hp : p ≠ 0) (z : ℂ) (v : ℝ) (hv : 0 < v) (n : O) :
    cubicSourceResidualFunction (cubeAverageMatrix p hp q •
      (integralComplexMatrix (A : SL(2, O)) • upperPoint (z + 3 * ringComplex (p ^ 3 * n)) v hv)) =
    cubicSourceResidualFunction (cubeAverageMatrix p hp q •
      (integralComplexMatrix (A : SL(2, O)) • upperPoint z v hv)) := by
  let T := cubeCuspTriangular d hp
  have hT : T 1 0 = 0 := (cubeCuspTriangular_entries d hp).2.1
  let V := v / ‖T 1 1‖ ^ 2
  have hV : 0 < V := div_pos hv (sq_pos_of_ne_zero (norm_ne_zero_iff.mpr (complexUpper_lowerRight_ne_zero T hT)))
  have he (x : ℂ) : cubicSourceResidualFunction (cubeAverageMatrix p hp q •
      (integralComplexMatrix (A : SL(2, O)) • upperPoint x v hv)) =
      cubicSourceResidualFunction (integralComplexMatrix d.matrix •
        upperPoint ((T 0 0 * x + T 0 1) / T 1 1) V hV) := by
    rw [← mul_smul, cubeCuspTriangular_factor d hp, mul_smul]
    change cubicSourceResidualFunction (integralComplexMatrix d.matrix • (T • upperPoint x v hv)) = _
    rw [complexUpper_action T hT]
  have hx : (T 0 0 * (z + 3 * ringComplex (p ^ 3 * n)) + T 0 1) / T 1 1 =
      (T 0 0 * z + T 0 1) / T 1 1 + 3 * ringComplex (p ^ (2 * d.exponent.val) * n) := by
    calc
      _ = (T 0 0 * z + T 0 1) / T 1 1 + 3 * ((T 0 0 / T 1 1) * ringComplex (p ^ 3)) * ringComplex n := by
        rw [map_mul]
        ring
      _ = _ := by rw [cubeCuspTriangular_integral_scale d hp, map_mul]; ring
  rw [he, he, hx]
  exact cubicSourceResidualFunction_rationalCusp_period ⟨d.matrix, d.rational_mem⟩ _ V hV _

lemma cubeSourceDifference_rationalCusp_period (A : rationalExtension) (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (z : ℂ) (v : ℝ) (hv : 0 < v) (n : O) :
    cubeSourceDifference p hp.ne_zero
      (integralComplexMatrix (A : SL(2, O)) • upperPoint (z + 3 * ringComplex (p ^ 3 * n)) v hv) =
    cubeSourceDifference p hp.ne_zero (integralComplexMatrix (A : SL(2, O)) • upperPoint z v hv) := by
  have hU : cubeAverage p hp.ne_zero cubicSourceResidualFunction
      (integralComplexMatrix (A : SL(2, O)) • upperPoint (z + 3 * ringComplex (p ^ 3 * n)) v hv) =
      cubeAverage p hp.ne_zero cubicSourceResidualFunction
        (integralComplexMatrix (A : SL(2, O)) • upperPoint z v hv) := by
    exact congrArg (fun t : ℂ => (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ ^ 3 * t)
      (tsum_congr (fun r : CubeResidues p => cubeSource_summand_rationalCusp_period (A := A)
        (actualCubeCuspData (A : SL(2, O)) p (cubeResidueRepresentative p r) hp hprimary) hp.ne_zero z v hv n))
  exact congrArg₂ (fun a b : ℂ => a - (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ * b)
    hU (cubicSourceResidualFunction_rationalCusp_period A z v hv (p ^ 3 * n))

/-- Integral dilation and arbitrary translation preserve the cube difference's zero mean. -/
theorem cubeSourceDifference_rational_average_affine_zero (A : rationalExtension) (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (b : O) (hb : b ≠ 0) (c : ℂ) (v : ℝ) (hv : 0 < v) :
    (∫ z in periodDomain, cubeSourceDifference p hp.ne_zero
      (integralComplexMatrix (A : SL(2, O)) • upperPoint (ringComplex (p ^ 3) * (ringComplex b * z + c)) v hv)) = 0 := by
  let f := fun z : ℂ => cubeSourceDifference p hp.ne_zero
    (integralComplexMatrix (A : SL(2, O)) • upperPoint (ringComplex (p ^ 3) * z) v hv)
  have hf : Continuous f := by
    simpa only [add_zero] using continuous_rationalCusp_affine _ (cubeSourceDifference_continuous p hp.ne_zero)
      (A : SL(2, O)) (ringComplex (p ^ 3)) 0 v hv
  have hper (n : O) (z : ℂ) : f (z + 3 * ringComplex n) = f z := by
    have he : ringComplex (p ^ 3) * (z + 3 * ringComplex n) =
        ringComplex (p ^ 3) * z + 3 * ringComplex (p ^ 3 * n) := by rw [map_mul]; ring
    dsimp only [f]
    rw [he, cubeSourceDifference_rationalCusp_period A p hp hprimary]
  exact (period_integral_eisenstein_affine f hf.measurable hper b hb c).trans
    (cubeSourceDifference_rational_average_zero A p hp hprimary v hv)

/-- Primitive first-column normalization is exactly an upper triangular factorization. -/
lemma complexFirstColumnTriangular_entries (B N : SL(2, ℂ)) (s : ℂ) (hs : s ≠ 0)
    (h0 : B 0 0 = s * N 0 0) (h1 : B 1 0 = s * N 1 0) :
    (N⁻¹ * B) 0 0 = s ∧ (N⁻¹ * B) 1 0 = 0 ∧ (N⁻¹ * B) 1 1 = s⁻¹ := by
  have hd : N 0 0 * N 1 1 - N 0 1 * N 1 0 = 1 := by
    simpa only [Matrix.det_fin_two] using N.property
  have h00 : (N⁻¹ * B) 0 0 = s := by
    simp only [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two,
      Matrix.mul_apply, Fin.sum_univ_two, Matrix.of_apply,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one, h0, h1]
    linear_combination s * hd
  have h10 : (N⁻¹ * B) 1 0 = 0 := by
    simp only [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two,
      Matrix.mul_apply, Fin.sum_univ_two, Matrix.of_apply,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one, h0, h1]
    ring
  refine ⟨h00, h10, ?_⟩
  have ht : s * (N⁻¹ * B) 1 1 = 1 := by
    simpa only [Matrix.det_fin_two, h00, h10, mul_zero, sub_zero] using (N⁻¹ * B).property
  apply mul_left_cancel₀ hs
  rw [ht, mul_inv_cancel₀ hs]

/-- Every inverse branch maps a common `p^6` cell into an integral dilation of a `p^3` cell. -/
theorem cubeSourceDifference_inverse_rational_average_zero (A : rationalExtension) (p q : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (v : ℝ) (hv : 0 < v) :
    (∫ z in periodDomain, cubeSourceDifference p hp.ne_zero
      ((cubeAverageMatrix p hp.ne_zero q)⁻¹ •
        (integralComplexMatrix (A : SL(2, O)) • upperPoint (ringComplex (p ^ 6) * z) v hv))) = 0 := by
  obtain ⟨j, _, N, hx, hy, hNA⟩ := primePowerCusp_inverse_reduction (A : SL(2, O)) p q 3 hp hprimary
  let N' : rationalExtension := ⟨N, rationalExtension_of_congruent A N hNA⟩
  let B := (cubeAverageMatrix p hp.ne_zero q)⁻¹ * integralComplexMatrix (A : SL(2, O))
  let T := (integralComplexMatrix N)⁻¹ * B
  let s := (cubeDilationRoot p)⁻¹ * ringComplex p ^ j
  have hz := cubeDilationRoot_ne_zero p hp.ne_zero
  have hpC := ringComplex_ne_zero hp.ne_zero
  have hs : s ≠ 0 := mul_ne_zero (inv_ne_zero hz) (pow_ne_zero j hpC)
  have he : cubeDilationRoot p ^ 2 = ringComplex p ^ 3 := by rw [cubeDilationRoot_sq, map_pow]
  have hx' : ringComplex p ^ 3 * ringComplex ((A : SL(2, O)) 0 0) -
      3 * ringComplex q * ringComplex ((A : SL(2, O)) 1 0) = ringComplex p ^ j * ringComplex (N 0 0) := by
    simpa only [map_sub, map_mul, map_pow, map_ofNat] using congrArg ringComplex hx
  have hy' : ringComplex ((A : SL(2, O)) 1 0) = ringComplex p ^ j * ringComplex (N 1 0) := by
    simpa only [map_mul, map_pow] using congrArg ringComplex hy
  have hentry (M : SL(2, O)) (i k : Fin 2) : integralComplexMatrix M i k = ringComplex (M i k) := rfl
  have h0 : B 0 0 = s * integralComplexMatrix N 0 0 := by
    dsimp only [B]
    simp only [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two,
      cubeAverageMatrix_entries, Matrix.mul_apply, Fin.sum_univ_two, Matrix.of_apply,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one, hentry]
    change cubeDilationRoot p * ringComplex ((A : SL(2, O)) 0 0) +
      (-((cubeDilationRoot p)⁻¹ * (3 * ringComplex q))) * ringComplex ((A : SL(2, O)) 1 0) = _
    calc
      _ = (cubeDilationRoot p)⁻¹ * (ringComplex p ^ 3 * ringComplex ((A : SL(2, O)) 0 0) -
          3 * ringComplex q * ringComplex ((A : SL(2, O)) 1 0)) := by
        rw [← he]
        field_simp
        ring
      _ = _ := by rw [hx']; exact (mul_assoc _ _ _).symm
  have h1 : B 1 0 = s * integralComplexMatrix N 1 0 := by
    dsimp only [B, s]
    simp only [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two,
      cubeAverageMatrix_entries, Matrix.mul_apply, Fin.sum_univ_two, Matrix.of_apply,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one, hentry,
      neg_zero, zero_mul, zero_add, hy', mul_assoc]
  obtain ⟨h00, h10, h11⟩ := complexFirstColumnTriangular_entries B (integralComplexMatrix N) s hs h0 h1
  change T 0 0 = s at h00
  change T 1 0 = 0 at h10
  change T 1 1 = s⁻¹ at h11
  have hscale : (T 0 0 / T 1 1) * ringComplex (p ^ 3) = ringComplex (p ^ (2 * j)) := by
    rw [h00, h11, div_inv_eq_mul, map_pow, map_pow,
      show ringComplex p ^ (2 * j) = (ringComplex p ^ j) ^ 2 by rw [mul_comm 2 j, pow_mul]]
    dsimp only [s]
    rw [← he]
    field_simp
  let c := (T 0 1 / T 1 1) / ringComplex (p ^ 3)
  let V := v / ‖T 1 1‖ ^ 2
  have hV : 0 < V := div_pos hv (sq_pos_of_ne_zero (norm_ne_zero_iff.mpr (complexUpper_lowerRight_ne_zero T h10)))
  have hcoord (z : ℂ) : (T 0 0 * (ringComplex (p ^ 6) * z) + T 0 1) / T 1 1 =
      ringComplex (p ^ 3) * (ringComplex (p ^ (2 * j)) * z + c) := by
    have hpow : ringComplex (p ^ 6) = ringComplex (p ^ 3) * ringComplex (p ^ 3) := by
      rw [← map_mul, ← pow_add]
    calc
      _ = ringComplex (p ^ 3) * (((T 0 0 / T 1 1) * ringComplex (p ^ 3)) * z + c) := by
        rw [hpow]
        dsimp only [c]
        field_simp
        <;> ring
      _ = _ := by rw [hscale]
  have hact (z : ℂ) : (cubeAverageMatrix p hp.ne_zero q)⁻¹ •
      (integralComplexMatrix (A : SL(2, O)) • upperPoint (ringComplex (p ^ 6) * z) v hv) =
      integralComplexMatrix N • upperPoint (ringComplex (p ^ 3) * (ringComplex (p ^ (2 * j)) * z + c)) V hV := by
    have hfactor : B = integralComplexMatrix N * T := by dsimp only [T]; group
    rw [← mul_smul]
    change B • upperPoint (ringComplex (p ^ 6) * z) v hv = _
    rw [hfactor, mul_smul]
    change integralComplexMatrix N • (T • upperPoint (ringComplex (p ^ 6) * z) v hv) = _
    rw [complexUpper_action T h10, hcoord]
  simp_rw [hact]
  exact cubeSourceDifference_rational_average_affine_zero N' p hp hprimary (p ^ (2 * j))
    (pow_ne_zero _ hp.ne_zero) c V hV


lemma kernelCoverLegAdjointFunction_continuous {H J : Subgroup (SL(2, O))}
    [J.IsFiniteRelIndex globalKubotaKernel] (e : H ≃* J) (g : SL(2, ℂ))
    (he : IntegralCoverIntertwines e g) (f : IntegralOrbitQuotient H → ℂ) (hf : Continuous f) :
    Continuous (kernelCoverLegAdjointFunction e g he f) :=
  integralCoverTraceFunction_continuous J globalKubotaKernel _
    (hf.comp (integralConjugateMap_continuous _ _ _))

/-- A common zero-mean cell passes through every finite fiber of the actual adjoint trace. -/
theorem kernelCoverLegAdjointFunction_rational_average_zero {H J : Subgroup (SL(2, O))}
    [J.IsFiniteRelIndex globalKubotaKernel] (e : H ≃* J) (g : SL(2, ℂ))
    (he : IntegralCoverIntertwines e g) (f : IntegralOrbitQuotient H → ℂ) (hf : Continuous f)
    (b : O) (v : ℝ) (hv : 0 < v)
    (havg : ∀ M : rationalExtension, (∫ z in periodDomain,
      f (integralOrbitProjection H (g⁻¹ •
        (integralComplexMatrix (M : SL(2, O)) • upperPoint (ringComplex b * z) v hv)))) = 0)
    (A : rationalExtension) :
    (∫ z in periodDomain, kernelCoverLegAdjointFunction e g he f
      (integralOrbitProjection globalKubotaKernel
        (integralComplexMatrix (A : SL(2, O)) • upperPoint (ringComplex b * z) v hv))) = 0 := by
  letI := periodDomain_finiteMeasure
  letI : Fintype (IntegralCoverCosets J globalKubotaKernel) := Fintype.ofFinite _
  let M (r : IntegralCoverCosets J globalKubotaKernel) : rationalExtension :=
    ⟨(((integralCoverRep J globalKubotaKernel r)⁻¹ : globalKubotaKernel) : SL(2, O)) * (A : SL(2, O)),
      rationalExtension.mul_mem (levelThree_le_rationalExtension
        (globalKubotaKernel_le_levelThree ((integralCoverRep J globalKubotaKernel r)⁻¹).property)) A.property⟩
  let F (r : IntegralCoverCosets J globalKubotaKernel) (z : ℂ) :=
    f (integralOrbitProjection H (g⁻¹ • (integralComplexMatrix (M r : SL(2, O)) • upperPoint (ringComplex b * z) v hv)))
  have hi (r : IntegralCoverCosets J globalKubotaKernel) : IntegrableOn (F r) periodDomain :=
    integrable_rationalCusp_scaled _ ((hf.comp (continuous_integralOrbitProjection H)).comp
      (continuous_hyperbolic_action g⁻¹)) (M r : SL(2, O)) (ringComplex b) v hv
  have hterm (r : IntegralCoverCosets J globalKubotaKernel) (z : ℂ) :
      f (integralConjugateMap e.symm g⁻¹ (integralCoverIntertwines_inverse e g he)
        (integralCoverFiberPoint J globalKubotaKernel r
          (integralComplexMatrix (A : SL(2, O)) • upperPoint (ringComplex b * z) v hv))) = F r z := by
    rw [integralCoverFiberPoint_rep, integralSubgroup_smul, integralConjugateMap_projection]
    dsimp only [F, M]
    rw [map_mul, mul_smul]
  change (∫ z in periodDomain, ∑ r : IntegralCoverCosets J globalKubotaKernel,
    f (integralConjugateMap e.symm g⁻¹ (integralCoverIntertwines_inverse e g he)
      (integralCoverFiberPoint J globalKubotaKernel r
        (integralComplexMatrix (A : SL(2, O)) • upperPoint (ringComplex b * z) v hv)))) = 0
  simp_rw [hterm]
  rw [integral_finsetSum Finset.univ (fun r _ => hi r)]
  exact Finset.sum_eq_zero (fun r _ => havg (M r))


lemma cubicSourceResidualFunction_kernel_invariant (k : globalKubotaKernel) (w : HyperbolicSpace) :
    cubicSourceResidualFunction (k • w) = cubicSourceResidualFunction w := by
  obtain ⟨hk, hchar⟩ := (globalKubotaKernel_mem (k : SL(2, O))).mp k.property
  change cubicSourceResidualFunction (integralComplexMatrix (k : SL(2, O)) • w) = _
  rw [cubicSourceResidualFunction_automorphy ⟨(k : SL(2, O)), levelThree_le_rationalExtension hk⟩,
    extendedComplexCharacter_restrict ⟨(k : SL(2, O)), hk⟩, hchar, one_mul]

def cubicSourceQuotientFunction : KernelQuotient → ℂ :=
  Quotient.lift cubicSourceResidualFunction (by
    rintro w u ⟨k, rfl⟩
    exact (cubicSourceResidualFunction_kernel_invariant k w).symm)

lemma cubicSourceQuotientFunction_projection (w : HyperbolicSpace) :
    cubicSourceQuotientFunction (integralOrbitProjection globalKubotaKernel w) = cubicSourceResidualFunction w := rfl

lemma cubicSourceQuotientFunction_continuous : Continuous cubicSourceQuotientFunction :=
  cubicSourceResidualFunction_continuous.quotient_lift _

lemma cubicSourceQuotientFunction_represents :
    kernelRationalSourceProjection cubicEisensteinResidue =ᵐ[integralQuotientVolume globalKubotaKernel]
      cubicSourceQuotientFunction := by
  change _ =ᵐ[Measure.map (integralOrbitProjection globalKubotaKernel)
    (hyperbolicVolume.restrict (hyperbolicFundamentalSet globalKubotaKernel))] _
  apply (ae_map_iff (measurable_integralOrbitProjection _).aemeasurable
    (measurableSet_eq_fun (Lp.stronglyMeasurable _).measurable cubicSourceQuotientFunction_continuous.measurable)).mpr
  exact ae_restrict_of_ae cubicSourceResidualFunction_represents_projection

/-- The identity branch and the translated cube branches share one finite cover. -/
def cubeLegTarget (p : O) (hp : p ≠ 0) : Option (CubeResidues p) → Subgroup (SL(2, O))
  | none => cubeCommonCover p
  | some r => cubeCommonTarget p hp r

lemma cubeLegTarget_le (p : O) (hp : p ≠ 0) (i : Option (CubeResidues p)) :
    cubeLegTarget p hp i ≤ globalKubotaKernel := by
  cases i with
  | none => exact cubeCommonCover_le p
  | some r => exact cubeCommonTarget_le p hp r

lemma cubeLegTarget_finiteIndex (p : O) (hp : p ≠ 0) (i : Option (CubeResidues p)) :
    (cubeLegTarget p hp i).FiniteIndex := by
  cases i with
  | none => exact cubeCommonCover_finiteIndex p hp
  | some r => exact cubeCommonTarget_finiteIndex p hp r

def cubeLegEquiv (p : O) (hp : p ≠ 0) : ∀ i : Option (CubeResidues p), cubeCommonCover p ≃* cubeLegTarget p hp i
  | none => MulEquiv.refl _
  | some r => cubeCommonEquiv p hp r

def cubeLegMatrix (p : O) (hp : p ≠ 0) : Option (CubeResidues p) → SL(2, ℂ)
  | none => 1
  | some r => cubeAverageMatrix p hp (cubeResidueRepresentative p r)

lemma cubeLeg_intertwines (p : O) (hp : p ≠ 0) (i : Option (CubeResidues p)) :
    IntegralCoverIntertwines (cubeLegEquiv p hp i) (cubeLegMatrix p hp i) := by
  cases i with
  | none => intro h; change 1 * integralComplexMatrix (h : SL(2, O)) = integralComplexMatrix (h : SL(2, O)) * 1; simp only [one_mul, mul_one]
  | some r => exact cubeCommon_intertwines p hp r

def cubeLegCoefficient (p : O) : Option (CubeResidues p) → ℂ
  | none => -(Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹
  | some _ => (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ ^ 3

def cubeLegFunction (p : O) (hp : p ≠ 0) (i : Option (CubeResidues p)) :
    IntegralOrbitQuotient (cubeCommonCover p) → ℂ :=
  fun q => cubicSourceQuotientFunction (integralCoverMap (cubeLegTarget_le p hp i)
    (integralConjugateMap (cubeLegEquiv p hp i) (cubeLegMatrix p hp i) (cubeLeg_intertwines p hp i) q))

lemma cubeLegFunction_continuous (p : O) (hp : p ≠ 0) (i : Option (CubeResidues p)) :
    Continuous (cubeLegFunction p hp i) :=
  (cubicSourceQuotientFunction_continuous.comp (integralCoverMap_continuous _)).comp
    (integralConjugateMap_continuous _ _ _)

lemma cubeLegFunction_projection (p : O) (hp : p ≠ 0) (i : Option (CubeResidues p)) (w : HyperbolicSpace) :
    cubeLegFunction p hp i (integralOrbitProjection (cubeCommonCover p) w) =
      cubicSourceResidualFunction (cubeLegMatrix p hp i • w) := rfl

def cubeCommonDifferenceFunction (p : O) (hp : p ≠ 0) : IntegralOrbitQuotient (cubeCommonCover p) → ℂ :=
  fun q => ∑' i : Option (CubeResidues p), cubeLegCoefficient p i * cubeLegFunction p hp i q

lemma cubeCommonDifferenceFunction_continuous (p : O) (hp : p ≠ 0) :
    Continuous (cubeCommonDifferenceFunction p hp) := by
  letI : Finite (CubeResidues p) := (Ideal.span {p ^ 3}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr (pow_ne_zero 3 hp))
  letI : Fintype (CubeResidues p) := Fintype.ofFinite _
  unfold cubeCommonDifferenceFunction
  simp only [tsum_fintype]
  exact continuous_finsetSum Finset.univ (fun i _ => continuous_const.mul (cubeLegFunction_continuous p hp i))

lemma cubeCommonDifferenceFunction_projection (p : O) (hp : p ≠ 0) (w : HyperbolicSpace) :
    cubeCommonDifferenceFunction p hp (integralOrbitProjection (cubeCommonCover p) w) =
      cubeSourceDifference p hp w := by
  letI : Finite (CubeResidues p) := (Ideal.span {p ^ 3}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr (pow_ne_zero 3 hp))
  letI : Fintype (CubeResidues p) := Fintype.ofFinite _
  unfold cubeCommonDifferenceFunction cubeSourceDifference cubeAverage
  simp only [tsum_fintype, Fintype.sum_option, cubeLegFunction_projection,
    cubeLegCoefficient, cubeLegMatrix, one_smul, ← Finset.mul_sum]
  ring

lemma integralProjection_quasiMeasurePreserving (H : Subgroup (SL(2, O))) (hH : H ≤ levelThree) :
    Measure.QuasiMeasurePreserving (integralOrbitProjection H) hyperbolicVolume (integralQuotientVolume H) := by
  let proj := integralOrbitProjection H
  have hp : Measurable proj := measurable_integralOrbitProjection _
  refine ⟨hp, Measure.AbsolutelyContinuous.mk fun S hS hzero => ?_⟩
  rw [Measure.map_apply hp hS]
  have hd : hyperbolicVolume ((proj ⁻¹' S) ∩ hyperbolicFundamentalSet H) = 0 := by
    simpa only [integralQuotientVolume, proj,
      Measure.map_apply (measurable_integralOrbitProjection _) hS,
      Measure.restrict_apply ((measurable_integralOrbitProjection _) hS)] using hzero
  have hinv : ∀ M : H, M • (proj ⁻¹' S) = proj ⁻¹' S := by
    intro M
    ext w
    constructor
    · rintro ⟨u, hu, rfl⟩
      change proj (M • u) ∈ S
      change proj u ∈ S at hu
      rwa [show proj (M • u) = proj u from integralOrbitProjection_eq _ M u]
    · intro hw
      refine ⟨M⁻¹ • w, ?_, smul_inv_smul M w⟩
      change proj (M⁻¹ • w) ∈ S
      rwa [show proj (M⁻¹ • w) = proj w from integralOrbitProjection_eq _ M⁻¹ w]
  exact (hyperbolicFundamentalSet_isFundamentalDomain H hH hyperbolicVolume).measure_zero_of_invariant _ hinv hd

/-- The actual common-cover difference vanishes: every adjoint trace has zero rational cusp mean. -/
theorem cubeSourceDifference_eq_zero (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1) :
    cubeSourceDifference p hp.ne_zero = 0 := by
  letI : Finite (CubeResidues p) := (Ideal.span {p ^ 3}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr (pow_ne_zero 3 hp.ne_zero))
  letI : Fintype (CubeResidues p) := Fintype.ofFinite _
  letI : ∀ i : Option (CubeResidues p), (cubeLegTarget p hp.ne_zero i).IsFiniteRelIndex globalKubotaKernel := fun i => by
    letI := cubeLegTarget_finiteIndex p hp.ne_zero i
    exact Subgroup.isFiniteRelIndex_of_finiteIndex
  let leg (i : Option (CubeResidues p)) := kernelCoverLeg (cubeCommonCover_le p) (cubeLegTarget_le p hp.ne_zero i)
    (cubeLegEquiv p hp.ne_zero i) (cubeLegMatrix p hp.ne_zero i) (cubeLeg_intertwines p hp.ne_zero i)
  let S := kernelRationalSourceProjection cubicEisensteinResidue
  let D := ∑ i : Option (CubeResidues p), cubeLegCoefficient p i • leg i S
  let f := cubeCommonDifferenceFunction p hp.ne_zero
  have hf : Continuous f := cubeCommonDifferenceFunction_continuous p hp.ne_zero
  have hleg (i : Option (CubeResidues p)) : leg i S =ᵐ[integralQuotientVolume (cubeCommonCover p)]
      cubeLegFunction p hp.ne_zero i :=
    kernelCoverLeg_representative (cubeCommonCover_le p) (cubeLegTarget_le p hp.ne_zero i)
      (cubeLegEquiv p hp.ne_zero i) (cubeLegMatrix p hp.ne_zero i) (cubeLeg_intertwines p hp.ne_zero i)
      S cubicSourceQuotientFunction cubicSourceQuotientFunction_represents
  have hrep : D =ᵐ[integralQuotientVolume (cubeCommonCover p)] f := by
    have hs := Lp.coeFn_fun_finsetSum Finset.univ
      (fun i : Option (CubeResidues p) => cubeLegCoefficient p i • leg i S)
    have hc := ae_all_iff.mpr (fun i : Option (CubeResidues p) => Lp.coeFn_smul (cubeLegCoefficient p i) (leg i S))
    have hr := ae_all_iff.mpr hleg
    filter_upwards [hs, hc, hr] with q hsum hscale hvalue
    change (∑ i : Option (CubeResidues p), cubeLegCoefficient p i • leg i S) q =
      ∑' i : Option (CubeResidues p), cubeLegCoefficient p i * cubeLegFunction p hp.ne_zero i q
    rw [hsum, tsum_fintype]
    change (∑ i : Option (CubeResidues p), (cubeLegCoefficient p i • leg i S) q) = _
    apply Finset.sum_congr rfl
    intro i _
    rw [hscale i, Pi.smul_apply, smul_eq_mul, hvalue i]
  have hD : D = 0 := by
    apply kernelCoverLeg_source_sum_vanish_of_zero_enlarged_averages
      (cubeLegTarget p hp.ne_zero) (cubeCommonCover_le p) (cubeLegTarget_le p hp.ne_zero)
      (cubeLegEquiv p hp.ne_zero) (cubeLegMatrix p hp.ne_zero) (cubeLeg_intertwines p hp.ne_zero)
      (cubeLegCoefficient p)
      (fun i => kernelCoverLegAdjointFunction (cubeLegEquiv p hp.ne_zero i) (cubeLegMatrix p hp.ne_zero i)
        (cubeLeg_intertwines p hp.ne_zero i) f)
    · intro i
      exact kernelCoverLegAdjointFunction_continuous _ _ _ f hf
    · intro i
      exact kernelCoverLegAdjointFunction_represents (cubeCommonCover_le p) (cubeLegTarget_le p hp.ne_zero i)
        (cubeLegEquiv p hp.ne_zero i) (cubeLegMatrix p hp.ne_zero i) (cubeLeg_intertwines p hp.ne_zero i)
        D f hf.measurable hrep
    · intro i A v hv _
      refine ⟨p ^ 6, pow_ne_zero 6 hp.ne_zero, ?_⟩
      apply kernelCoverLegAdjointFunction_rational_average_zero _ _ _ f hf (p ^ 6) v hv _ A
      intro M
      simp only [f, cubeCommonDifferenceFunction_projection]
      cases i with
      | none =>
        simp only [cubeLegMatrix, inv_one, one_smul]
        have hc (z : ℂ) : ringComplex (p ^ 3) * (ringComplex (p ^ 3) * z + 0) = ringComplex (p ^ 6) * z := by
          rw [add_zero, ← mul_assoc, ← map_mul, ← pow_add]
        simpa only [hc] using cubeSourceDifference_rational_average_affine_zero M p hp hprimary
          (p ^ 3) (pow_ne_zero 3 hp.ne_zero) 0 v hv
      | some r =>
        exact cubeSourceDifference_inverse_rational_average_zero M p (cubeResidueRepresentative p r) hp hprimary v hv
  have hzero : f =ᵐ[integralQuotientVolume (cubeCommonCover p)] fun _ => (0 : ℂ) := by
    rw [hD] at hrep
    exact hrep.symm.trans (Lp.coeFn_zero ℂ 2 (integralQuotientVolume (cubeCommonCover p)))
  have hglobal := (integralProjection_quasiMeasurePreserving (cubeCommonCover p)
    ((cubeCommonCover_le p).trans globalKubotaKernel_le_levelThree)).ae_eq_comp hzero
  have he : cubeSourceDifference p hp.ne_zero =ᵐ[hyperbolicVolume] fun _ => (0 : ℂ) := by
    simpa only [Function.comp_def, f, cubeCommonDifferenceFunction_projection] using hglobal
  exact Measure.eq_of_ae_eq he (cubeSourceDifference_continuous p hp.ne_zero) continuous_const

/-- Primary prime cubes act on the residual source by the inverse prime norm. -/
theorem cubicSourceResidualFunction_cube_eigenrelation (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (w : HyperbolicSpace) :
    cubeAverage p hp.ne_zero cubicSourceResidualFunction w =
      (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ * cubicSourceResidualFunction w := by
  have h := congrFun (cubeSourceDifference_eq_zero p hp hprimary) w
  exact sub_eq_zero.mp h


lemma cuspFrequency_mul_right (h c : O) : cuspFrequency (h * c) = cuspFrequency h * ringComplex c := by
  unfold cuspFrequency
  rw [map_mul]
  ring

lemma cuspFourierCharacter_continuous (h : O) : Continuous (fun z : ℂ => tracePhase (-cuspFrequency h * z)) := by
  change Continuous (fun z : ℂ => Complex.exp
    (2 * Real.pi * Complex.I * ((-cuspFrequency h * z) + starRingEnd ℂ (-cuspFrequency h * z))))
  fun_prop

lemma cuspFourierCharacter_fractional_period (c : O) (hc : c ≠ 0) (h q : O) (z : ℂ) :
    tracePhase (-cuspFrequency (h * c) * (z + 3 * ringComplex q / ringComplex c)) =
      tracePhase (-cuspFrequency (h * c) * z) := by
  have he : -cuspFrequency (h * c) * (z + 3 * ringComplex q / ringComplex c) =
      -cuspFrequency (h * c) * z + -(cuspFrequency h * (3 * ringComplex q)) := by
    rw [cuspFrequency_mul_right]
    field_simp [ringComplex_ne_zero hc]
    <;> ring
  rw [he, AddChar.map_add_eq_mul, AddChar.map_neg_eq_inv, cuspFrequency_period, inv_one, mul_one]

lemma period_fourier_fractional_translation (f : ℂ → ℂ)
    (hper : ∀ n : O, ∀ z : ℂ, f (z + 3 * ringComplex n) = f z)
    (c : O) (hc : c ≠ 0) (h q : O) :
    (∫ z in periodDomain, f (z + 3 * ringComplex q / ringComplex c) * tracePhase (-cuspFrequency (h * c) * z)) =
      ∫ z in periodDomain, f z * tracePhase (-cuspFrequency (h * c) * z) := by
  let g := fun z : ℂ => f z * tracePhase (-cuspFrequency (h * c) * z)
  have hg (n : O) (z : ℂ) : g (z + 3 * ringComplex n) = g z := by
    dsimp only [g]
    rw [hper, cuspFrequency_negative_period]
  have hi := period_integral_translation g hg (3 * ringComplex q / ringComplex c)
  have he (z : ℂ) : g (3 * ringComplex q / ringComplex c + z) =
      f (z + 3 * ringComplex q / ringComplex c) * tracePhase (-cuspFrequency (h * c) * z) := by
    dsimp only [g]
    rw [add_comm (3 * ringComplex q / ringComplex c) z, cuspFourierCharacter_fractional_period c hc]
  simpa only [he, g] using hi

lemma cubeAverageMatrix_scaled_action (p : O) (hp : p ≠ 0) (q : O) (z : ℂ) (v : ℝ) (hv : 0 < v) :
    cubeAverageMatrix p hp q • upperPoint (ringComplex (p ^ 3) * z) v hv =
      upperPoint (z + 3 * ringComplex q / ringComplex (p ^ 3)) (v / ‖ringComplex p‖ ^ 3)
        (div_pos hv (pow_pos (norm_pos_iff.mpr (ringComplex_ne_zero hp)) 3)) := by
  have h10 : cubeAverageMatrix p hp q 1 0 = 0 := by rw [cubeAverageMatrix_entries]; rfl
  have hz := cubeDilationRoot_ne_zero p hp
  rw [complexUpper_action _ h10]
  apply upperPoint_congr
  · simp only [cubeAverageMatrix_entries, Matrix.of_apply, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_fin_one]
    rw [← cubeDilationRoot_sq]
    field_simp
  · simp only [cubeAverageMatrix_entries, Matrix.of_apply, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_fin_one, cubeDilationRoot_norm_sq]

/-- The cube eigenrelation transports Fourier frequency by `p^3` and height by `|p|^-3`. -/
theorem cubicSourceResidualFunction_fourier_cube (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (v : ℝ) (hv : 0 < v) :
    (∫ z in periodDomain, cubicSourceResidualFunction
      (upperPoint z (v / ‖ringComplex p‖ ^ 3)
        (div_pos hv (pow_pos (norm_pos_iff.mpr (ringComplex_ne_zero hp.ne_zero)) 3))) *
        tracePhase (-cuspFrequency (h * p ^ 3) * z)) =
      (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ *
        ∫ z in periodDomain, cubicSourceResidualFunction (upperPoint z v hv) * tracePhase (-cuspFrequency h * z) := by
  letI : Finite (CubeResidues p) := (Ideal.span {p ^ 3}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr (pow_ne_zero 3 hp.ne_zero))
  letI : Fintype (CubeResidues p) := Fintype.ofFinite _
  let V := v / ‖ringComplex p‖ ^ 3
  have hV : 0 < V := div_pos hv (pow_pos (norm_pos_iff.mpr (ringComplex_ne_zero hp.ne_zero)) 3)
  let f := fun z : ℂ => cubicSourceResidualFunction (upperPoint z V hV)
  let g := fun z : ℂ => cubicSourceResidualFunction (upperPoint z v hv) * tracePhase (-cuspFrequency h * z)
  have hf : Continuous f := cubicSourceResidualFunction_continuous.comp
    (upperCoordinatesHomeomorph.continuous.comp
      (show Continuous (fun z : ℂ => (⟨(z, V), hV⟩ : UpperCoordinates)) by fun_prop))
  have hg : Continuous g := (cubicSourceResidualFunction_continuous.comp
    (upperCoordinatesHomeomorph.continuous.comp
      (show Continuous (fun z : ℂ => (⟨(z, v), hv⟩ : UpperCoordinates)) by fun_prop))).mul
      (cuspFourierCharacter_continuous h)
  have hper (n : O) (z : ℂ) : g (z + 3 * ringComplex n) = g z := by
    dsimp only [g]
    rw [cubicSourceResidualFunction_period, cuspFrequency_negative_period]
  let term (r : CubeResidues p) (z : ℂ) :=
    f (z + 3 * ringComplex (cubeResidueRepresentative p r) / ringComplex (p ^ 3)) *
      tracePhase (-cuspFrequency (h * p ^ 3) * z)
  have hi (r : CubeResidues p) : IntegrableOn (term r) periodDomain :=
    periodDomain_continuous_integrable _ ((hf.comp (continuous_id.add continuous_const)).mul
      (cuspFourierCharacter_continuous (h * p ^ 3)))
  have hterm (r : CubeResidues p) : (∫ z in periodDomain, term r z) =
      ∫ z in periodDomain, f z * tracePhase (-cuspFrequency (h * p ^ 3) * z) :=
    period_fourier_fractional_translation f (fun n z => cubicSourceResidualFunction_period V hV z n)
      (p ^ 3) (pow_ne_zero 3 hp.ne_zero) h (cubeResidueRepresentative p r)
  have hphase (z : ℂ) : tracePhase (-cuspFrequency h * (ringComplex (p ^ 3) * z)) =
      tracePhase (-cuspFrequency (h * p ^ 3) * z) := by rw [cuspFrequency_mul_right]; congr 1; ring
  have he (z : ℂ) : (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ ^ 3 * (∑ r : CubeResidues p, term r z) =
      (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ * g (ringComplex (p ^ 3) * z) := by
    have hh := congrArg (fun t : ℂ => t * tracePhase (-cuspFrequency (h * p ^ 3) * z))
      (cubicSourceResidualFunction_cube_eigenrelation p hp hprimary (upperPoint (ringComplex (p ^ 3) * z) v hv))
    simp only [cubeAverage, tsum_fintype, cubeAverageMatrix_scaled_action] at hh
    simpa only [term, f, g, hphase, Finset.sum_mul, mul_assoc] using hh
  have heint := congrArg (fun k : ℂ → ℂ => ∫ z in periodDomain, k z) (funext he)
  simp only [integral_const_mul] at heint
  rw [integral_finsetSum Finset.univ (fun r _ => hi r)] at heint
  simp_rw [hterm] at heint
  rw [period_integral_eisenstein_mul g hg.measurable hper (p ^ 3) (pow_ne_zero 3 hp.ne_zero)] at heint
  have hcard : (Fintype.card (CubeResidues p) : ℂ) = (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 := by
    rw [← Nat.card_eq_fintype_card]
    change (Ideal.absNorm (Ideal.span {p ^ 3}) : ℂ) = _
    rw [← Ideal.span_singleton_pow, map_pow, Nat.cast_pow]
  have hn := principalNorm_complex_ne_zero p hp.ne_zero
  simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, hcard] at heint
  have hfactor : (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ ^ 3 * (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ 3 = 1 := by
    rw [← mul_pow, inv_mul_cancel₀ hn, one_pow]
  rw [← mul_assoc, hfactor, one_mul] at heint
  exact heint

/-- Removing a primary prime cube leaves the actual source arithmetic residue unchanged. -/
theorem rationalSourceScatteringResidue_mul_prime_cube (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) :
    rationalSourceScatteringResidue (h * p ^ 3) = rationalSourceScatteringResidue h := by
  by_cases hh : h = 0
  · subst h
    simp only [zero_mul]
  have hr : 0 < ‖ringComplex p‖ := norm_pos_iff.mpr (ringComplex_ne_zero hp.ne_zero)
  let V : ℝ := 1 / ‖ringComplex p‖ ^ 3
  have hV : 0 < V := div_pos zero_lt_one (pow_pos hr 3)
  have hfreq : ‖cuspFrequency (h * p ^ 3) * (V : ℂ)‖ = ‖cuspFrequency h‖ := by
    rw [cuspFrequency_mul_right, norm_mul, norm_mul, map_pow, norm_pow,
      Complex.norm_real, Real.norm_eq_abs, abs_of_pos hV]
    dsimp only [V]
    field_simp
  have hfreq0 : cuspFrequency (h * p ^ 3) * (V : ℂ) ≠ 0 := by
    intro he
    rw [he, norm_zero] at hfreq
    exact (norm_ne_zero_iff.mpr (cuspFrequency_ne_zero h hh)) hfreq.symm
  have hkernel : sourceFourierKernel (4 / 3) (cuspFrequency (h * p ^ 3) * (V : ℂ)) =
      sourceFourierKernel (4 / 3) (cuspFrequency h) := by
    rw [sourceFourierKernel_four_thirds _ hfreq0,
      sourceFourierKernel_four_thirds _ (cuspFrequency_ne_zero h hh), hfreq]
  have hK : sourceFourierKernel (4 / 3) (cuspFrequency h) ≠ 0 := by
    have hk : 0 < (sourceFourierKernel (4 / 3) (cuspFrequency h)).re := by
      convert sourceFourierKernel_real_re_pos (4 / 3) (by norm_num) (cuspFrequency h) using 1 <;> norm_num
    intro he
    rw [he, Complex.zero_re] at hk
    exact (lt_irrefl 0) hk
  have hheight : (V : ℂ) ^ (2 / 3 : ℂ) = (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ := by
    have he : V ^ (2 / 3 : ℝ) = (‖ringComplex p‖ ^ 3) ^ (-2 / 3 : ℝ) := by
      dsimp only [V]
      rw [one_div, Real.inv_rpow (pow_nonneg hr.le 3), ← Real.rpow_neg (pow_nonneg hr.le 3)]
      congr 1 <;> ring
    have hc : ((2 / 3 : ℝ) : ℂ) = (2 / 3 : ℂ) := by norm_num
    rw [← hc, ← Complex.ofReal_cpow hV.le, he]
    have hw := cubeCuspHeightWeight_zero p hp.ne_zero
    rw [cubeCuspHeightWeight, cubeCuspHeightDenominator_zero p hp.ne_zero] at hw
    exact hw
  have he := cubicSourceResidualFunction_fourier_cube p hp hprimary h 1 zero_lt_one
  rw [cubicSourceResidualFunction_fourier, cubicSourceResidualFunction_fourier] at he
  change ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * rationalSourceScatteringResidue (h * p ^ 3) *
      ((V : ℂ) ^ (2 / 3 : ℂ) * sourceFourierKernel (4 / 3) (cuspFrequency (h * p ^ 3) * (V : ℂ))) = _ at he
  rw [hheight, hkernel] at he
  simp only [Complex.ofReal_one, Complex.one_cpow, mul_one, one_mul] at he
  have hn := principalNorm_complex_ne_zero p hp.ne_zero
  have harea : ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (by positivity)
  apply mul_right_cancel₀ (mul_ne_zero (mul_ne_zero harea (inv_ne_zero hn)) hK)
  linear_combination he

/-- A square but no further prime factor annihilates the source residue. -/
theorem rationalSourceScatteringResidue_prime_square_zero (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hph : ¬ p ∣ h) :
    rationalSourceScatteringResidue (h * p ^ 2) = 0 := by
  have hc := rationalSourceScatteringResidue_mul_prime_cube p hp hprimary (h * p ^ 2)
  have he : (h * p ^ 2) * p ^ 3 = h * p ^ 5 := by rw [mul_assoc, ← pow_add]
  rw [he, rationalSourceScatteringResidue_square_cube p hp hprimary h hph] at hc
  have hn := principalNorm_complex_ne_zero p hp.ne_zero
  apply (mul_eq_zero.mp (show (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ *
    rationalSourceScatteringResidue (h * p ^ 2) = 0 by linear_combination hc)).resolve_left (inv_ne_zero hn)

/-- The surviving first-power residue is fixed by the actual cubic Gauss factor. -/
theorem rationalSourceScatteringResidue_prime_relation (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hph : ¬ p ∣ h) :
    (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-(4 / 3 : ℂ)) * cubicUnitGaussSum (9 * h) p *
      rationalSourceScatteringResidue (h * p) =
        (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ * rationalSourceScatteringResidue h := by
  have he := rationalSourceScatteringResidue_prime_recurrence p hp hprimary h hph
  rw [rationalSourceScatteringResidue_mul_prime_cube p hp hprimary h] at he
  linear_combination he


lemma rationalSourceScatteringResidue_prime_pow_mod (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (n : ℕ) :
    rationalSourceScatteringResidue (h * p ^ n) = rationalSourceScatteringResidue (h * p ^ (n % 3)) := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    by_cases hn : n < 3
    · rw [Nat.mod_eq_of_lt hn]
    have h3 : 3 ≤ n := by omega
    calc
      _ = rationalSourceScatteringResidue ((h * p ^ (n - 3)) * p ^ 3) := by
        rw [mul_assoc, ← pow_add, Nat.sub_add_cancel h3]
      _ = rationalSourceScatteringResidue (h * p ^ (n - 3)) :=
        rationalSourceScatteringResidue_mul_prime_cube p hp hprimary _
      _ = rationalSourceScatteringResidue (h * p ^ ((n - 3) % 3)) := ih (n - 3) (by omega)
      _ = _ := by rw [show (n - 3) % 3 = n % 3 by omega]

/-- Cube removal extends to every primary element, without a coprimality restriction. -/
theorem rationalSourceScatteringResidue_mul_primary_cube (b : O) (hb : b ≠ 0)
    (hprimary : lambda ^ 2 ∣ b - 1) (h : O) :
    rationalSourceScatteringResidue (h * b ^ 3) = rationalSourceScatteringResidue h := by
  obtain ⟨s, hs, hpr⟩ := exists_primary_prime_factorization b hb hprimary
  rw [← hs]
  clear hs hb hprimary b
  induction s using Multiset.induction_on generalizing h with
  | empty => simp only [Multiset.prod_zero, one_pow, mul_one]
  | @cons p s ih =>
    obtain ⟨hp, hprimary⟩ := hpr p (Multiset.mem_cons_self _ _)
    rw [Multiset.prod_cons, mul_pow, ← mul_assoc,
      ih (h * p ^ 3) (fun q hq => hpr q (Multiset.mem_cons_of_mem hq)),
      rationalSourceScatteringResidue_mul_prime_cube p hp hprimary h]

/-- The first-power coefficient is the second cubic Gauss sum with its exact norm weight. -/
theorem rationalSourceScatteringResidue_prime_explicit (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hph : ¬ p ∣ h) :
    rationalSourceScatteringResidue (h * p) =
      (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-2 / 3 : ℂ) *
        primeCubicGauss p hp hprimary 2 (9 * h) * rationalSourceScatteringResidue h := by
  have hn := principalNorm_complex_ne_zero p hp.ne_zero
  have hgg := primeCubicGauss_one_mul_two p hp hprimary (9 * h)
    (primary_prime_not_dvd_nine_frequency p hp hprimary h hph)
  rw [primeCubicGauss_one_eq] at hgg
  have hG : cubicUnitGaussSum (9 * h) p ≠ 0 := by
    intro hz
    rw [hz, zero_mul] at hgg
    exact hn hgg.symm
  have hweight : (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-(4 / 3 : ℂ)) ≠ 0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl hn)
  have hfactor : (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-(4 / 3 : ℂ)) *
      ((Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-2 / 3 : ℂ) * (Ideal.absNorm (Ideal.span {p}) : ℂ)) =
      (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ := by
    calc
      _ = (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-(4 / 3 : ℂ)) *
          ((Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-2 / 3 : ℂ) * (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (1 : ℂ)) := by
        rw [Complex.cpow_one]
      _ = _ := by
        rw [← Complex.cpow_add _ _ hn, ← Complex.cpow_add _ _ hn]
        convert Complex.cpow_neg_one (Ideal.absNorm (Ideal.span {p}) : ℂ) using 1
        congr 1
        norm_num
  apply mul_left_cancel₀ (mul_ne_zero hweight hG)
  calc
    _ = (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ * rationalSourceScatteringResidue h :=
      rationalSourceScatteringResidue_prime_relation p hp hprimary h hph
    _ = ((Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-(4 / 3 : ℂ)) *
        ((Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-2 / 3 : ℂ) *
          (cubicUnitGaussSum (9 * h) p * primeCubicGauss p hp hprimary 2 (9 * h)))) * rationalSourceScatteringResidue h := by
      rw [hgg, hfactor]
    _ = _ := by ring

/-- The full unramified prime-power table: only exponents zero and one modulo three survive. -/
theorem rationalSourceScatteringResidue_prime_power_table (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hph : ¬ p ∣ h) (n : ℕ) :
    rationalSourceScatteringResidue (h * p ^ n) =
      if n % 3 = 0 then rationalSourceScatteringResidue h
      else if n % 3 = 1 then (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-2 / 3 : ℂ) *
        primeCubicGauss p hp hprimary 2 (9 * h) * rationalSourceScatteringResidue h
      else 0 := by
  rw [rationalSourceScatteringResidue_prime_pow_mod p hp hprimary h n]
  by_cases h0 : n % 3 = 0
  · simp only [h0, pow_zero, mul_one, if_true]
  by_cases h1 : n % 3 = 1
  · simp only [h1, pow_one, if_true, Nat.one_ne_zero, if_false]
    exact rationalSourceScatteringResidue_prime_explicit p hp hprimary h hph
  have h2 : n % 3 = 2 := by omega
  rw [if_neg h0, if_neg h1, h2]
  exact rationalSourceScatteringResidue_prime_square_zero p hp hprimary h hph


lemma primeCubicGauss_two_eq_star (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1)
    (h : O) (hph : ¬ p ∣ h) :
    primeCubicGauss p hp hprimary 2 h = star (cubicUnitGaussSum h p) := by
  have hn := cubicUnitGaussSum_prime_norm p hp hprimary h hph
  have hG : cubicUnitGaussSum h p ≠ 0 := by
    apply norm_ne_zero_iff.mp
    rw [hn]
    exact norm_ne_zero_iff.mpr (ringComplex_ne_zero hp.ne_zero)
  have he := primeCubicGauss_one_mul_two p hp hprimary h hph
  rw [primeCubicGauss_one_eq] at he
  apply mul_left_cancel₀ hG
  rw [he, Complex.star_def, Complex.mul_conj, Complex.normSq_eq_norm_sq, hn,
    ringComplex_norm_sq_eq_absNorm_span, Complex.ofReal_natCast]

lemma cubicSymbol_star_mul (a b : O) (hb : lambda ^ 2 ∣ b - 1) (hab : IsCoprime a b) :
    star (ringComplex (symbol a b)) * ringComplex (symbol a b) = 1 := by
  rw [mul_comm]
  simpa only [Complex.star_def, Complex.normSq_eq_norm_sq, symbol_norm_one a b hb hab,
    one_pow, Complex.ofReal_one] using Complex.mul_conj (ringComplex (symbol a b))

lemma primeCubicGauss_two_twist (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1)
    (h : O) (hph : ¬ p ∣ h) :
    primeCubicGauss p hp hprimary 2 h = ringComplex (symbol h p) * primeCubicGauss p hp hprimary 2 1 := by
  have hc := hp.coprime_iff_not_dvd.mpr hph
  have hp1 : ¬ p ∣ (1 : O) := fun hd => hp.2.1 (isUnit_of_dvd_one hd)
  have he := cubicUnitGaussSum_frequency_twist 1 p h hp.ne_zero hc
  simp only [one_mul] at he
  have hs := congrArg star he
  simp only [star_mul] at hs
  rw [primeCubicGauss_two_eq_star p hp hprimary h hph, primeCubicGauss_two_eq_star p hp hprimary 1 hp1]
  calc
    _ = (star (ringComplex (symbol h p)) * ringComplex (symbol h p)) * star (cubicUnitGaussSum h p) := by
      rw [cubicSymbol_star_mul h p hprimary hc.symm, one_mul]
    _ = ringComplex (symbol h p) * (star (ringComplex (symbol h p)) * star (cubicUnitGaussSum h p)) := by ring
    _ = _ := by rw [mul_comm (star (ringComplex (symbol h p))), hs]

def sourceBesselNormalizer (h : O) : ℂ :=
  (2 * Real.pi : ℂ) / Complex.Gamma (4 / 3) * (2 * Real.pi * ‖cuspFrequency h‖ : ℂ) ^ (1 / 3 : ℂ)

lemma sourceBesselNormalizer_mul (h p : O) :
    sourceBesselNormalizer (h * p) = (‖ringComplex p‖ : ℂ) ^ (1 / 3 : ℂ) * sourceBesselNormalizer h := by
  have hf : ‖cuspFrequency (h * p)‖ = ‖cuspFrequency h‖ * ‖ringComplex p‖ := by
    rw [cuspFrequency_mul_right, norm_mul]
  have he : (2 * Real.pi * ‖cuspFrequency (h * p)‖ : ℂ) =
      (‖ringComplex p‖ : ℂ) * ((2 * Real.pi * ‖cuspFrequency h‖ : ℝ) : ℂ) := by
    rw [hf]
    push_cast
    ring
  unfold sourceBesselNormalizer
  rw [he, Complex.mul_cpow_ofReal_nonneg (norm_nonneg _) (by positivity)]
  push_cast
  ring

lemma sourcePrimeNormalizer_powers (p : O) (hp : p ≠ 0) :
    (‖ringComplex p‖ : ℂ) ^ (1 / 3 : ℂ) * (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-2 / 3 : ℂ) =
      (‖ringComplex p‖ : ℂ)⁻¹ := by
  have hr : (‖ringComplex p‖ : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (norm_ne_zero_iff.mpr (ringComplex_ne_zero hp))
  rw [← Complex.ofReal_natCast, ← ringComplex_norm_sq_eq_absNorm_span, pow_two,
    Complex.ofReal_mul, Complex.mul_cpow_ofReal_nonneg (norm_nonneg _) (norm_nonneg _),
    ← mul_assoc, ← Complex.cpow_add _ _ hr, ← Complex.cpow_add _ _ hr]
  convert Complex.cpow_neg_one (‖ringComplex p‖ : ℂ) using 1
  congr 1
  norm_num

/-- Fourier normalization converts the arithmetic prime factor to a unit-sized Gauss factor. -/
theorem rationalSourceResidualFourierCoefficient_prime_factor (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hph : ¬ p ∣ h) :
    rationalSourceResidualFourierCoefficient (h * p) =
      (primeCubicGauss p hp hprimary 2 (9 * h) / (‖ringComplex p‖ : ℂ)) * rationalSourceResidualFourierCoefficient h := by
  have hh : h ≠ 0 := fun hz => hph (hz ▸ dvd_zero p)
  rw [rationalSourceResidualFourierCoefficient_eq _ (mul_ne_zero hh hp.ne_zero),
    rationalSourceResidualFourierCoefficient_eq h hh]
  change rationalSourceScatteringResidue (h * p) * sourceBesselNormalizer (h * p) =
    (primeCubicGauss p hp hprimary 2 (9 * h) / (‖ringComplex p‖ : ℂ)) *
      (rationalSourceScatteringResidue h * sourceBesselNormalizer h)
  rw [rationalSourceScatteringResidue_prime_explicit p hp hprimary h hph, sourceBesselNormalizer_mul]
  calc
    _ = ((‖ringComplex p‖ : ℂ) ^ (1 / 3 : ℂ) * (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-2 / 3 : ℂ)) *
        primeCubicGauss p hp hprimary 2 (9 * h) * (rationalSourceScatteringResidue h * sourceBesselNormalizer h) := by ring
    _ = _ := by rw [sourcePrimeNormalizer_powers p hp.ne_zero]; ring

def normalizedCubicUnitGauss (n : O) : ℂ := cubicUnitGaussSum 1 n / (‖ringComplex n‖ : ℂ)

lemma normalizedCubicUnitGauss_one : normalizedCubicUnitGauss 1 = 1 := by
  simp [normalizedCubicUnitGauss, cubicUnitGaussSum_one]

theorem rationalSourceResidualFourierCoefficient_prime_normalized (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hph : ¬ p ∣ h) :
    rationalSourceResidualFourierCoefficient (h * p) = ringComplex (symbol (9 * h) p) *
      star (normalizedCubicUnitGauss p) * rationalSourceResidualFourierCoefficient h := by
  have hp9 := primary_prime_not_dvd_nine_frequency p hp hprimary h hph
  have hp1 : ¬ p ∣ (1 : O) := fun hd => hp.2.1 (isUnit_of_dvd_one hd)
  rw [rationalSourceResidualFourierCoefficient_prime_factor p hp hprimary h hph,
    primeCubicGauss_two_twist p hp hprimary (9 * h) hp9, primeCubicGauss_two_eq_star p hp hprimary 1 hp1,
    normalizedCubicUnitGauss, star_div₀, Complex.star_def, Complex.conj_ofReal]
  ring


lemma normalizedCubicUnitGauss_coprime_product (a b : O) (ha : a ≠ 0) (hb : b ≠ 0)
    (hap : lambda ^ 2 ∣ a - 1) (hbp : lambda ^ 2 ∣ b - 1) (hab : IsCoprime a b) :
    star (normalizedCubicUnitGauss (a * b)) = ringComplex (symbol a b) *
      star (normalizedCubicUnitGauss a) * star (normalizedCubicUnitGauss b) := by
  have hG := cubicUnitGaussSum_primary_product 1 a b ha hb hap hbp hab
  have ht := cubicUnitGaussSum_frequency_twist 1 b a hb hab.symm
  simp only [one_mul] at hG ht
  have hN : ringComplex (symbol a b) * normalizedCubicUnitGauss (a * b) =
      normalizedCubicUnitGauss a * normalizedCubicUnitGauss b := by
    unfold normalizedCubicUnitGauss
    rw [hG, map_mul, norm_mul, Complex.ofReal_mul]
    calc
      _ = cubicUnitGaussSum 1 a * (ringComplex (symbol a b) * cubicUnitGaussSum a b) /
          ((‖ringComplex a‖ : ℂ) * (‖ringComplex b‖ : ℂ)) := by ring
      _ = _ := by rw [ht]; ring
  have hs := congrArg star hN
  simp only [star_mul] at hs
  calc
    _ = (star (ringComplex (symbol a b)) * ringComplex (symbol a b)) * star (normalizedCubicUnitGauss (a * b)) := by
      rw [cubicSymbol_star_mul a b hbp hab, one_mul]
    _ = ringComplex (symbol a b) * (star (normalizedCubicUnitGauss (a * b)) * star (ringComplex (symbol a b))) := by ring
    _ = _ := by rw [hs]; ring

lemma primary_finset_product {ι : Type*} (s : Finset ι) (p : ι → O)
    (hp : ∀ i ∈ s, lambda ^ 2 ∣ p i - 1) : lambda ^ 2 ∣ (∏ i ∈ s, p i) - 1 := by
  induction s using Finset.induction_on with
  | empty => simp only [Finset.prod_empty, sub_self, dvd_zero]
  | @insert i s hi ih =>
    have h1 := hp i (Finset.mem_insert_self _ _)
    have h2 := ih (fun j hj => hp j (Finset.mem_insert_of_mem hj))
    rw [Finset.prod_insert hi]
    convert dvd_add (h1.mul_right (∏ j ∈ s, p j)) h2 using 1 <;> ring

/-- Pairwise coprime primary primes recover the composite normalized Gauss coefficient. -/
theorem rationalSourceResidualFourierCoefficient_prime_product {ι : Type*}
    (s : Finset ι) (p : ι → O) (hp : ∀ i ∈ s, Prime (p i))
    (hprimary : ∀ i ∈ s, lambda ^ 2 ∣ p i - 1)
    (hpair : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → IsCoprime (p i) (p j))
    (h : O) (hph : ∀ i ∈ s, ¬ p i ∣ h) :
    rationalSourceResidualFourierCoefficient (h * (∏ i ∈ s, p i)) =
      ringComplex (symbol (9 * h) (∏ i ∈ s, p i)) * star (normalizedCubicUnitGauss (∏ i ∈ s, p i)) *
        rationalSourceResidualFourierCoefficient h := by
  induction s using Finset.induction_on with
  | empty => simp only [Finset.prod_empty, mul_one, symbol_one, map_one, normalizedCubicUnitGauss_one, star_one, one_mul]
  | @insert i s hi ih =>
    have hpi := hp i (Finset.mem_insert_self _ _)
    have hpri := hprimary i (Finset.mem_insert_self _ _)
    have hps : ∀ j ∈ s, Prime (p j) := fun j hj => hp j (Finset.mem_insert_of_mem hj)
    have hprs : ∀ j ∈ s, lambda ^ 2 ∣ p j - 1 := fun j hj => hprimary j (Finset.mem_insert_of_mem hj)
    have hcpi : IsCoprime (p i) (∏ j ∈ s, p j) := IsCoprime.prod_right (fun j hj =>
      hpair i (Finset.mem_insert_self _ _) j (Finset.mem_insert_of_mem hj) (by intro he; subst j; exact hi hj))
    have hbs : (∏ j ∈ s, p j) ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun j hj => (hps j hj).ne_zero)
    have hpb : ¬ p i ∣ h * (∏ j ∈ s, p j) := by
      intro hd
      rcases hpi.dvd_mul.mp hd with hd | hd
      · exact hph i (Finset.mem_insert_self _ _) hd
      · exact hpi.2.1 (hcpi.isUnit_of_dvd hd)
    have hih := ih hps hprs
      (fun j hj k hk hjk => hpair j (Finset.mem_insert_of_mem hj) k (Finset.mem_insert_of_mem hk) hjk)
      (fun j hj => hph j (Finset.mem_insert_of_mem hj))
    rw [Finset.prod_insert hi, show h * (p i * (∏ j ∈ s, p j)) = (h * (∏ j ∈ s, p j)) * p i by ring,
      rationalSourceResidualFourierCoefficient_prime_normalized (p i) hpi hpri _ hpb, hih]
    rw [mul_comm (p i) (∏ j ∈ s, p j), normalizedCubicUnitGauss_coprime_product _ _ hbs hpi.ne_zero
      (primary_finset_product s p hprs) hpri hcpi.symm, symbol_mul_denominator, map_mul,
      show (9 : O) * (h * (∏ j ∈ s, p j)) = (9 * h) * (∏ j ∈ s, p j) by ring,
      symbol_mul_numerator, map_mul]
    ring

/-- The actual residual coefficient on a squarefree primary product has a single scalar normalization. -/
theorem rationalSourceResidualFourierCoefficient_primary_product {ι : Type*}
    (s : Finset ι) (p : ι → O) (hp : ∀ i ∈ s, Prime (p i))
    (hprimary : ∀ i ∈ s, lambda ^ 2 ∣ p i - 1)
    (hpair : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → IsCoprime (p i) (p j)) :
    star (rationalSourceResidualFourierCoefficient (∏ i ∈ s, p i)) =
      star (rationalSourceResidualFourierCoefficient 1) *
        star (ringComplex (symbol 9 (∏ i ∈ s, p i))) * normalizedCubicUnitGauss (∏ i ∈ s, p i) := by
  have he := rationalSourceResidualFourierCoefficient_prime_product s p hp hprimary hpair 1
    (fun i hi hd => (hp i hi).2.1 (isUnit_of_dvd_one hd))
  simp only [one_mul, mul_one] at he
  rw [he, star_mul, star_mul, star_star]
  ring

lemma sourceBesselNormalizer_mul_cube (h b : O) (hb : b ≠ 0) :
    sourceBesselNormalizer (h * b ^ 3) = (‖ringComplex b‖ : ℂ) * sourceBesselNormalizer h := by
  have hr : 0 < ‖ringComplex b‖ := norm_pos_iff.mpr (ringComplex_ne_zero hb)
  have hc : (((‖ringComplex b‖ ^ 3 : ℝ) : ℂ) ^ (1 / 3 : ℂ)) = (‖ringComplex b‖ : ℂ) := by
    have he : ((1 / 3 : ℝ) : ℂ) = (1 / 3 : ℂ) := by norm_num
    rw [← he, ← Complex.ofReal_cpow (pow_nonneg hr.le 3), ← Real.rpow_natCast_mul hr.le 3, Nat.cast_ofNat,
      show (3 : ℝ) * (1 / 3) = 1 by norm_num, Real.rpow_one]
  rw [sourceBesselNormalizer_mul, map_pow, norm_pow, hc]

theorem rationalSourceResidualFourierCoefficient_primary_cube (b : O) (hb : b ≠ 0)
    (hprimary : lambda ^ 2 ∣ b - 1) (h : O) (hh : h ≠ 0) :
    rationalSourceResidualFourierCoefficient (h * b ^ 3) =
      (‖ringComplex b‖ : ℂ) * rationalSourceResidualFourierCoefficient h := by
  rw [rationalSourceResidualFourierCoefficient_eq _ (mul_ne_zero hh (pow_ne_zero 3 hb)),
    rationalSourceResidualFourierCoefficient_eq h hh]
  change rationalSourceScatteringResidue (h * b ^ 3) * sourceBesselNormalizer (h * b ^ 3) =
    (‖ringComplex b‖ : ℂ) * (rationalSourceScatteringResidue h * sourceBesselNormalizer h)
  rw [rationalSourceScatteringResidue_mul_primary_cube b hb hprimary h, sourceBesselNormalizer_mul_cube h b hb]
  ring

lemma primaryIdealGenerator_squarefree_support (I : Ideal O) (hI : primaryIdealGenerator I ≠ 0)
    (hsq : Squarefree I) : primaryIdealGenerator I = ∏ P ∈ primeSupport I, primaryIdealPrime P := by
  have hI0 := primaryIdealGenerator_ne_zero_ideal I hI
  have hn := (UniqueFactorizationMonoid.squarefree_iff_nodup_normalizedFactors hI0).mp hsq
  have hv : (primeSupport I).val = UniqueFactorizationMonoid.normalizedFactors I := by
    simpa only [primeSupport, Multiset.toFinset_val] using hn.dedup
  rw [primaryIdealGenerator, if_neg hI0]
  change _ = ((primeSupport I).val.map primaryIdealPrime).prod
  rw [hv]

lemma primaryIdealPrime_isPrime_of_mem (I P : Ideal O) (hI : primaryIdealGenerator I ≠ 0)
    (hP : P ∈ primeSupport I) : Prime (primaryIdealPrime P) := by
  have hp0 := primaryIdealPrime_factor_ne_zero I P hI (Multiset.mem_toFinset.mp hP)
  have hs := primaryIdealPrime_spec P hp0
  letI : P.IsMaximal := hs.1
  apply (Ideal.span_singleton_prime hp0).mp
  rw [hs.2.2.1]
  infer_instance

lemma primaryIdealPrime_support_coprime (I : Ideal O) (hI : primaryIdealGenerator I ≠ 0)
    (P : Ideal O) (hP : P ∈ primeSupport I) (Q : Ideal O) (hQ : Q ∈ primeSupport I) (hne : P ≠ Q) :
    IsCoprime (primaryIdealPrime P) (primaryIdealPrime Q) := by
  have hp := primaryIdealPrime_spec P (primaryIdealPrime_factor_ne_zero I P hI (Multiset.mem_toFinset.mp hP))
  have hq := primaryIdealPrime_spec Q (primaryIdealPrime_factor_ne_zero I Q hI (Multiset.mem_toFinset.mp hQ))
  letI : P.IsMaximal := hp.1
  letI : Q.IsMaximal := hq.1
  apply (Ideal.isCoprime_span_singleton_iff _ _).mp
  rw [hp.2.2.1, hq.2.2.1]
  exact Ideal.isCoprime_of_isMaximal hne

/-- The scalar shared by all unramified squarefree Fourier coefficients. -/
def rationalSourceThetaScalar : ℂ := star (rationalSourceResidualFourierCoefficient 1)

theorem rationalSourceResidualFourierCoefficient_squarefree (I : Ideal O)
    (hI : primaryIdealGenerator I ≠ 0) (hsq : Squarefree I) :
    star (rationalSourceResidualFourierCoefficient (primaryIdealGenerator I)) =
      rationalSourceThetaScalar * star (ringComplex (symbol 9 (primaryIdealGenerator I))) *
        normalizedCubicUnitGauss (primaryIdealGenerator I) := by
  have he := rationalSourceResidualFourierCoefficient_primary_product (primeSupport I) primaryIdealPrime
    (fun P hP => primaryIdealPrime_isPrime_of_mem I P hI hP)
    (fun P hP => (primaryIdealPrime_spec P
      (primaryIdealPrime_factor_ne_zero I P hI (Multiset.mem_toFinset.mp hP))).2.2.2)
    (primaryIdealPrime_support_coprime I hI)
  rwa [← primaryIdealGenerator_squarefree_support I hI hsq] at he

/-- Cube multiplication changes only the absolute-value factor in the theta coefficient. -/
theorem rationalSourceResidualFourierCoefficient_squarefree_cube (I J : Ideal O)
    (hI : primaryIdealGenerator I ≠ 0) (hJ : primaryIdealGenerator J ≠ 0) (hsq : Squarefree I) :
    star (rationalSourceResidualFourierCoefficient (primaryIdealGenerator I * (primaryIdealGenerator J) ^ 3)) =
      rationalSourceThetaScalar * (‖ringComplex (primaryIdealGenerator J)‖ : ℂ) *
        star (ringComplex (symbol 9 (primaryIdealGenerator I))) * normalizedCubicUnitGauss (primaryIdealGenerator I) := by
  rw [rationalSourceResidualFourierCoefficient_primary_cube _ hJ (primaryIdealGenerator_spec J hJ).2 _ hI,
    star_mul, rationalSourceResidualFourierCoefficient_squarefree I hI hsq]
  simp only [Complex.star_def, Complex.conj_ofReal]
  ring

open UniqueFactorizationMonoid

/-- A nonzero unramified residue has no prime valuation congruent to two modulo three. -/
theorem rationalSourceScatteringResidue_valuation_ne_two (I P : Ideal O)
    (hI : primaryIdealGenerator I ≠ 0) (hP : P ∈ normalizedFactors I)
    (hR : rationalSourceScatteringResidue (primaryIdealGenerator I) ≠ 0) :
    (normalizedFactors I).count P % 3 ≠ 2 := by
  have hI0 := primaryIdealGenerator_ne_zero_ideal I hI
  have hprime := prime_of_normalized_factor P hP
  let p := primaryIdealPrime P
  have hp0 : p ≠ 0 := primaryIdealPrime_factor_ne_zero I P hI hP
  have hps := primaryIdealPrime_spec P hp0
  have hp : Prime p := primaryIdealPrime_isPrime_of_mem I P hI (Multiset.mem_toFinset.mpr hP)
  obtain ⟨J, hJ, hnot⟩ := (FiniteMultiplicity.of_prime_left hprime hI0).exists_eq_pow_mul_and_not_dvd
  have hgen : primaryIdealGenerator I = p ^ (multiplicity P I) * primaryIdealGenerator J := by
    calc
      _ = primaryIdealGenerator (P ^ (multiplicity P I) * J) := congrArg primaryIdealGenerator hJ
      _ = _ := by
        rw [primaryIdealGenerator_mul, primaryIdealGenerator_pow]
        have hPgen : primaryIdealGenerator P = p := by
          rw [← hps.2.2.1, primaryIdealGenerator_span p hp0 hps.2.2.2]
        rw [hPgen]
  have hgJ : primaryIdealGenerator J ≠ 0 := by
    intro hz
    exact hI (by rw [hgen, hz, mul_zero])
  have hpd : ¬ p ∣ primaryIdealGenerator J := by
    intro hd
    apply hnot
    rw [Ideal.dvd_iff_le, ← hps.2.2.1, ← (primaryIdealGenerator_spec J hgJ).1,
      Ideal.span_singleton_le_span_singleton]
    exact hd
  have hcount := multiplicity_eq_count_normalizedFactors hprime.irreducible hI0
  rw [normalize_normalized_factor P hP] at hcount
  intro hc
  have hm : (multiplicity P I) % 3 = 2 := by rwa [hcount]
  apply hR
  rw [hgen, mul_comm, rationalSourceScatteringResidue_prime_power_table p hp hps.2.2.2 _ hpd, hm]
  norm_num

/-- The squarefree factor selected by prime valuations congruent to one modulo three. -/
def thetaSquarefreePart (I : Ideal O) : Ideal O :=
  ∏ P ∈ (primeSupport I).filter (fun P => (normalizedFactors I).count P % 3 = 1), P

/-- The cube root of the maximal cubical ideal factor. -/
def thetaCubePart (I : Ideal O) : Ideal O :=
  ∏ P ∈ primeSupport I, P ^ ((normalizedFactors I).count P / 3)

lemma thetaSquarefreePart_squarefree (I : Ideal O) : Squarefree (thetaSquarefreePart I) :=
  squarefree_support_product (Finset.filter_subset _ _)

lemma thetaParts_mul_cube (I : Ideal O) (hI : I ≠ 0)
    (he : ∀ P ∈ normalizedFactors I, (normalizedFactors I).count P % 3 ≠ 2) :
    thetaSquarefreePart I * thetaCubePart I ^ 3 = I := by
  rw [thetaSquarefreePart, Finset.prod_filter, thetaCubePart, ← Finset.prod_pow, ← Finset.prod_mul_distrib]
  calc
    _ = ∏ P ∈ primeSupport I, P ^ ((normalizedFactors I).count P) := by
      apply Finset.prod_congr rfl
      intro P hP
      have hp := he P (Multiset.mem_toFinset.mp hP)
      have hm : (normalizedFactors I).count P % 3 = 0 ∨ (normalizedFactors I).count P % 3 = 1 := by omega
      rcases hm with hm | hm
      · rw [if_neg (by omega), one_mul, ← pow_mul]
        congr 1
        omega
      · rw [if_pos hm, ← pow_mul, ← pow_succ']
        congr 1
        omega
    _ = (normalizedFactors I).prod := (Finset.prod_multiset_count (normalizedFactors I)).symm
    _ = I := Ideal.prod_normalizedFactors_eq_self hI

/-- Every nonzero unramified arithmetic residue lies on squarefree times cube support. -/
theorem rationalSourceScatteringResidue_squarefree_cube_support (I : Ideal O)
    (hI : primaryIdealGenerator I ≠ 0) (hR : rationalSourceScatteringResidue (primaryIdealGenerator I) ≠ 0) :
    Squarefree (thetaSquarefreePart I) ∧ primaryIdealGenerator (thetaSquarefreePart I) ≠ 0 ∧
      primaryIdealGenerator (thetaCubePart I) ≠ 0 ∧ thetaSquarefreePart I * thetaCubePart I ^ 3 = I := by
  have he := thetaParts_mul_cube I (primaryIdealGenerator_ne_zero_ideal I hI)
    (fun P hP => rationalSourceScatteringResidue_valuation_ne_two I P hI hP hR)
  have hgen : primaryIdealGenerator I =
      primaryIdealGenerator (thetaSquarefreePart I) * (primaryIdealGenerator (thetaCubePart I)) ^ 3 := by
    calc
      _ = primaryIdealGenerator (thetaSquarefreePart I * thetaCubePart I ^ 3) := congrArg primaryIdealGenerator he.symm
      _ = _ := by rw [primaryIdealGenerator_mul, primaryIdealGenerator_pow]
  have hA : primaryIdealGenerator (thetaSquarefreePart I) ≠ 0 := by
    intro hz
    exact hI (by rw [hgen, hz, zero_mul])
  have hB : primaryIdealGenerator (thetaCubePart I) ≠ 0 := by
    intro hz
    exact hI (by rw [hgen, hz, zero_pow (by decide : (3 : ℕ) ≠ 0), mul_zero])
  exact ⟨thetaSquarefreePart_squarefree I, hA, hB, he⟩

theorem rationalSourceFourier_squarefree_cube_support (I : Ideal O)
    (hI : primaryIdealGenerator I ≠ 0) (hT : rationalSourceResidualFourierCoefficient (primaryIdealGenerator I) ≠ 0) :
    ∃ A B : Ideal O, Squarefree A ∧ primaryIdealGenerator A ≠ 0 ∧ primaryIdealGenerator B ≠ 0 ∧ A * B ^ 3 = I := by
  have hR : rationalSourceScatteringResidue (primaryIdealGenerator I) ≠ 0 := by
    intro hz
    exact hT (by rw [rationalSourceResidualFourierCoefficient_eq _ hI, hz, zero_mul])
  exact ⟨thetaSquarefreePart I, thetaCubePart I, rationalSourceScatteringResidue_squarefree_cube_support I hI hR⟩

theorem rationalSourceFourier_primary_zero_of_base_zero (hC : rationalSourceThetaScalar = 0)
    (n : O) (hprimary : lambda ^ 2 ∣ n - 1) : rationalSourceResidualFourierCoefficient n = 0 := by
  have hn : n ≠ 0 := primary_ne_zero n hprimary
  let I : Ideal O := Ideal.span {n}
  have hgen : primaryIdealGenerator I = n := primaryIdealGenerator_span n hn hprimary
  have hI : primaryIdealGenerator I ≠ 0 := by rwa [hgen]
  by_contra hT
  have hTI : rationalSourceResidualFourierCoefficient (primaryIdealGenerator I) ≠ 0 := by rwa [hgen]
  obtain ⟨A, B, hA, hAg, hBg, hAB⟩ := rationalSourceFourier_squarefree_cube_support I hI hTI
  have harg : primaryIdealGenerator A * (primaryIdealGenerator B) ^ 3 = n := by
    have he := congrArg primaryIdealGenerator hAB
    simpa only [primaryIdealGenerator_mul, primaryIdealGenerator_pow, hgen] using he
  have he := rationalSourceResidualFourierCoefficient_squarefree_cube A B hAg hBg hA
  rw [harg, hC, zero_mul, zero_mul, zero_mul] at he
  exact hT (star_eq_zero.mp he)

lemma cubicUnitGaussSum_neg_frequency (h c : O) (hc : c ≠ 0) (hprimary : lambda ^ 2 ∣ c - 1) :
    cubicUnitGaussSum (-h) c = cubicUnitGaussSum h c := by
  have he := cubicUnitGaussSum_frequency_twist h c (-1) hc ⟨0, -1, by ring⟩
  simpa only [symbol_neg_one c hprimary, map_one, one_mul, mul_neg_one] using he

lemma unramifiedCubicGaussSeries_neg (s : ℂ) (h : O) :
    unramifiedCubicGaussSeries s (-h) = unramifiedCubicGaussSeries s h := by
  apply tsum_congr
  intro I
  rw [cubicUnitGaussSum_neg_frequency h _ I.2 (primaryIdealGenerator_spec I.1 I.2).2]

lemma unramifiedGaussResidue_neg (h : O) : unramifiedGaussResidue (-h) = unramifiedGaussResidue h := by
  have he := unramifiedGaussResidue_of_initial_relation (-h) h 0 (fun _ => 1) (fun _ => 0)
    (fun _ _ => analyticAt_const) (fun _ _ => analyticAt_const) continuousAt_const continuousAt_const
    (fun s _ _ => by simpa only [one_mul, zero_mul, add_zero] using unramifiedCubicGaussSeries_neg s h)
  simpa only [one_mul, zero_mul, add_zero] using he

lemma ramifiedFrequencyChar_neg_unit (k : O) (u : Oˣ) (n : ℕ) :
    ramifiedFrequencyChar k (-u) n = ramifiedFrequencyChar k u n := by
  ext x
  rw [ramifiedFrequencyChar_rep, ramifiedFrequencyChar_rep]
  simp only [Units.val_neg, neg_mul]
  rw [symbol_neg_numerator _ _ (lambda_sq_dvd_three.trans ⟨_, by ring⟩)]

lemma arithmeticResidueSum_neg_unit (h : O) (u : Oˣ) (n : ℕ) (hn : 2 ≤ n) :
    arithmeticResidueSum (-h) ((u : O) * lambda ^ n) =
      arithmeticResidueSum h (((-u : Oˣ) : O) * lambda ^ n) := by
  by_cases hd : (u : O) * lambda ^ n ∣ 3 * (-h)
  · obtain ⟨k, hk⟩ := hd
    have hk' : 3 * h = (((-u : Oˣ) : O) * lambda ^ n) * k := by
      simp only [Units.val_neg]
      linear_combination -hk
    rw [ramified_arithmetic_character_test (-h) k u n hn hk,
      ramified_arithmetic_character_test h k (-u) n hn hk', ramifiedFrequencyChar_neg_unit]
  · have hl : arithmeticResidueSum (-h) ((u : O) * lambda ^ n) = 0 := by
      by_contra he
      exact hd (ramified_arithmetic_support (-h) u n hn he)
    have hr : arithmeticResidueSum h (((-u : Oˣ) : O) * lambda ^ n) = 0 := by
      by_contra he
      obtain ⟨k, hk⟩ := ramified_arithmetic_support h (-u) n hn he
      apply hd
      refine ⟨k, ?_⟩
      simp only [Units.val_neg] at hk
      linear_combination -hk
    rw [hl, hr]

/-- Negating the frequency is absorbed by negating the ramified unit. -/
lemma arithmeticDirichletSeries_neg (s : ℂ) (hs : 2 < s.re) (h : O) (hh : h ≠ 0) :
    arithmeticDirichletSeries s (-h) = arithmeticDirichletSeries s h := by
  let N := max (ramifiedFrequencyBound (-h) + 1) (ramifiedFrequencyBound h + 1)
  rw [arithmeticDirichletSeries_finite_gauss_of_bound s hs (-h) (neg_ne_zero.mpr hh) N (le_max_left _ _),
    arithmeticDirichletSeries_finite_gauss_of_bound s hs h hh N (le_max_right _ _)]
  have he (u : Oˣ) (n : ℕ) : ramifiedGaussTerm s (-h) u n = ramifiedGaussTerm s h (-u) n := by
    unfold ramifiedGaussTerm
    rw [arithmeticResidueSum_neg_unit h u (n + 2) (by omega)]
    congr 2
    simp only [Units.val_neg]
    ring
  change (∑' u : Oˣ, ∑ n ∈ Finset.range N, ramifiedGaussTerm s (-h) u n) =
    ∑' u : Oˣ, ∑ n ∈ Finset.range N, ramifiedGaussTerm s h u n
  simp_rw [he]
  exact (Equiv.neg Oˣ).tsum_eq (fun u : Oˣ => ∑ n ∈ Finset.range N, ramifiedGaussTerm s h u n)

lemma nonzeroScatteringResidue_neg (h : O) (hh : h ≠ 0) :
    nonzeroScatteringResidue (-h) = nonzeroScatteringResidue h := by
  have he := nonzeroScatteringResidue_of_initial_relation (-h) h h (neg_ne_zero.mpr hh) hh hh
    (fun _ => 1) (fun _ => 0) (fun _ _ => analyticAt_const) (fun _ _ => analyticAt_const)
    continuousAt_const continuousAt_const (fun s hs _ => by
      simp only [one_mul, zero_mul, add_zero, scatteringCoefficient,
        arithmeticDirichletSeries_neg s (by linarith) h hh])
  simpa only [one_mul, zero_mul, add_zero] using he

lemma cuspFrequency_neg (h : O) : cuspFrequency (-h) = -cuspFrequency h := by
  simp only [cuspFrequency, map_neg, neg_div]

lemma rationalCuspPhaseSum_neg (h : O) : rationalCuspPhaseSum (-h) = rationalCuspPhaseSum h := by
  have h3 : tracePhase (3 * cuspFrequency h) = 1 := by
    simpa only [map_one, mul_one, one_mul, mul_comm] using cuspFrequency_period h 1
  have h1 : tracePhase (-cuspFrequency h) = tracePhase (cuspFrequency h * 2) := by
    have he := AddChar.map_add_eq_mul tracePhase (-cuspFrequency h) (3 * cuspFrequency h)
    rw [h3, mul_one] at he
    convert he.symm using 1 <;> congr 1 <;> ring
  have h2 : tracePhase (-cuspFrequency h * 2) = tracePhase (cuspFrequency h) := by
    have he := AddChar.map_add_eq_mul tracePhase (-cuspFrequency h * 2) (3 * cuspFrequency h)
    rw [h3, mul_one] at he
    convert he.symm using 1 <;> congr 1 <;> ring
  rw [rationalCuspPhaseSum, rationalCuspPhaseSum, cuspFrequency_neg, h1, h2]
  ring

lemma rationalSourceScatteringResidue_neg (h : O) :
    rationalSourceScatteringResidue (-h) = rationalSourceScatteringResidue h := by
  by_cases hh : h = 0
  · simp only [hh, neg_zero]
  rw [rationalSourceScatteringResidue, rationalSourceScatteringResidue, if_neg hh, if_neg (neg_ne_zero.mpr hh),
    nonzeroScatteringResidue_neg h hh, rationalCuspPhaseSum_neg,
    oppositeCuspResidue_eq_unramified, oppositeCuspResidue_eq_unramified,
    mul_neg, unramifiedGaussResidue_neg]

theorem rationalSourceResidualFourierCoefficient_neg (h : O) :
    rationalSourceResidualFourierCoefficient (-h) = rationalSourceResidualFourierCoefficient h := by
  by_cases hh : h = 0
  · simp only [hh, neg_zero]
  rw [rationalSourceResidualFourierCoefficient_eq _ (neg_ne_zero.mpr hh),
    rationalSourceResidualFourierCoefficient_eq h hh, rationalSourceScatteringResidue_neg,
    cuspFrequency_neg, norm_neg]

/-- Full Eisenstein translation symmetry conflicts with the lower cusp's nontrivial cubic character. -/
theorem cubicSource_not_eisenstein_periodic :
    ¬ (∀ a : O, ∀ w : HyperbolicSpace,
      cubicSourceResidualFunction (complexTranslation (ringComplex a) • w) = cubicSourceResidualFunction w) := by
  intro hperiod
  have hfactor : integralComplexMatrix (lowerCuspMatrix omega) =
      integralComplexMatrix (rationalEmbedding ModularGroup.S) * complexTranslation (-ringComplex omega) *
        integralComplexMatrix (rationalEmbedding ModularGroup.S⁻¹) := by
    apply Matrix.SpecialLinearGroup.ext
    intro i j
    fin_cases i <;> fin_cases j <;>
      simp [lowerCuspMatrix, integralComplexMatrix, rationalEmbedding, complexTranslation,
        Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two, ModularGroup.S,
        Matrix.adjugate_fin_two]
  have hlow (w : HyperbolicSpace) : ramifiedSourceFunction omega w = cubicSourceResidualFunction w := by
    unfold ramifiedSourceFunction
    rw [hfactor, mul_smul, mul_smul, cubicSourceResidualFunction_rational]
    have hm := hperiod (-omega) (integralComplexMatrix (rationalEmbedding ModularGroup.S⁻¹) • w)
    simp only [map_neg] at hm
    rw [hm, cubicSourceResidualFunction_rational]
  have hchar : complexCharacter (ramifiedParabolic omega 1) = ringComplex omega := by
    have he := ramifiedParabolic_omega_character 1 0
    simpa [Coordinates.eval, cubicExp] using he
  apply cubicSourceResidualFunction_ne_zero
  funext w
  obtain ⟨z, v, hv, rfl⟩ := upperPoint_surjective w
  have he := ramifiedSourceFunction_period omega 1 z v hv
  have hp := cubicSourceResidualFunction_period v hv z 1
  simp only [map_one] at hp
  rw [← ramifiedParabolic_character, hchar, hlow, hlow, map_one,
    hp] at he
  have hz : (ringComplex omega - 1) * cubicSourceResidualFunction (upperPoint z v hv) = 0 := by
    linear_combination -he
  have hn : ringComplex omega - 1 ≠ 0 := sub_ne_zero.mpr (by
    intro h
    exact omega_primitive.ne_one (by decide) (ringComplex_injective (by simpa only [map_one] using h)))
  exact (mul_eq_zero.mp hz).resolve_left hn

lemma source_period_of_three_supported
    (hs : ∀ h : O, ¬ (3 : O) ∣ h → rationalSourceResidualFourierCoefficient h = 0)
    (a : O) (z : ℂ) (v : ℝ) (hv : 0 < v) :
    cubicSourceResidualFunction (upperPoint (z + ringComplex a) v hv) =
      cubicSourceResidualFunction (upperPoint z v hv) := by
  rw [cubicSourceResidualFunction_fourier_expansion, cubicSourceResidualFunction_fourier_expansion]
  apply tsum_congr
  intro h
  by_cases hd : (3 : O) ∣ h
  · obtain ⟨b, rfl⟩ := hd
    have hp : tracePhase (cuspFrequency (3 * b) * ringComplex a) = 1 := by
      have he : cuspFrequency (3 * b) * ringComplex a = cuspFrequency b * (3 * ringComplex a) := by
        simp only [cuspFrequency, map_mul, map_ofNat]
        ring
      rw [he, cuspFrequency_period]
    rw [mul_add, AddChar.map_add_eq_mul, hp, mul_one]
  · have hh : h ≠ 0 := fun he => hd (he ▸ dvd_zero 3)
    rw [rationalSourceModeAmplitude_bessel v hv h hh, hs h hd, zero_mul, zero_mul, zero_mul, zero_mul]

theorem exists_source_coefficient_not_three :
    ∃ h : O, ¬ (3 : O) ∣ h ∧ rationalSourceResidualFourierCoefficient h ≠ 0 := by
  by_contra hn
  have hs : ∀ h : O, ¬ (3 : O) ∣ h → rationalSourceResidualFourierCoefficient h = 0 := by
    intro h hh
    by_contra he
    exact hn ⟨h, hh, he⟩
  apply cubicSource_not_eisenstein_periodic
  intro a w
  obtain ⟨z, v, hv, rfl⟩ := upperPoint_surjective w
  rw [complexTranslation_action]
  exact source_period_of_three_supported hs a z v hv

lemma sourceFourier_phase_of_ne_zero (h : O) (hh : h ≠ 0)
    (hT : rationalSourceResidualFourierCoefficient h ≠ 0) : tracePhase (cuspFrequency h) = 1 := by
  have hR : rationalSourceScatteringResidue h ≠ 0 := by
    intro hz
    exact hT (by rw [rationalSourceResidualFourierCoefficient_eq h hh, hz, zero_mul])
  have hK : sourceFourierKernel (4 / 3) (cuspFrequency h) ≠ 0 := by
    have hk : 0 < (sourceFourierKernel (4 / 3) (cuspFrequency h)).re := by
      convert sourceFourierKernel_real_re_pos (4 / 3) (by norm_num) (cuspFrequency h) using 1 <;> norm_num
    intro he
    rw [he, Complex.zero_re] at hk
    exact (lt_irrefl 0) hk
  have hs (z : ℂ) : cubicSourceResidualFunction (upperPoint (z + 1) 1 (by norm_num)) =
      cubicSourceResidualFunction (upperPoint z 1 (by norm_num)) := by
    have he := cubicSourceResidualFunction_period_one_action (upperPoint z 1 (by norm_num))
    rwa [complexTranslation_action] at he
  have he := period_fourier_translation
    (fun z => cubicSourceResidualFunction (upperPoint z 1 (by norm_num)))
    (fun n z => cubicSourceResidualFunction_period 1 (by norm_num) z n) h 1
  simp only [hs, mul_one] at he
  rw [cubicSourceResidualFunction_fourier 1 (by norm_num) h] at he
  simp only [Complex.ofReal_one, Complex.one_cpow, mul_one, one_mul] at he
  exact mul_right_cancel₀ (mul_ne_zero (mul_ne_zero cusp_volume_ne_zero hR) hK)
    (he.symm.trans (one_mul _).symm)

lemma sourceRayPhase_coordinate (h : O) (hphase : tracePhase (cuspFrequency h) = 1) :
    (3 : ℤ) ∣ (Coordinates.coords h).2 := by
  have he := complexTrace_div_traceLambda (Coordinates.coords h).1 (Coordinates.coords h).2
  rw [Coordinates.eval_coords] at he
  have ht : cuspFrequency h + starRingEnd ℂ (cuspFrequency h) = ((Coordinates.coords h).2 : ℂ) / 3 := by
    rw [cuspFrequency, show ringComplex h / (3 * ringComplex traceLambda) =
      (ringComplex h / ringComplex traceLambda) / 3 by ring, map_div₀, map_ofNat, ← add_div, he]
  change Complex.exp (2 * Real.pi * Complex.I * (cuspFrequency h + starRingEnd ℂ (cuspFrequency h))) = 1 at hphase
  rw [ht] at hphase
  have hp : Complex.exp (2 * Real.pi * Complex.I * ((((Coordinates.coords h).2 : ℝ) / 3 : ℝ) : ℂ)) = 1 := by
    simpa only [Complex.ofReal_div, Complex.ofReal_intCast, Complex.ofReal_ofNat] using hphase
  obtain ⟨n, hn⟩ := exp_two_pi_real_eq_one (((Coordinates.coords h).2 : ℝ) / 3) hp
  refine ⟨n, ?_⟩
  have hc : ((Coordinates.coords h).2 : ℝ) = 3 * (n : ℝ) := by linarith only [hn]
  exact_mod_cast hc

lemma primary_or_negative_primary_of_source_mask (h : O) (h3 : ¬ (3 : O) ∣ h)
    (hphase : tracePhase (cuspFrequency h) = 1) : lambda ^ 2 ∣ h - 1 ∨ lambda ^ 2 ∣ -h - 1 := by
  let a : ℤ := (Coordinates.coords h).1
  let b : ℤ := (Coordinates.coords h).2
  have heval : h = (a : O) + (b : O) * omega := (Coordinates.eval_coords h).symm
  obtain ⟨B, hB⟩ := sourceRayPhase_coordinate h hphase
  have hBc : (b : O) = 3 * (B : O) := by exact_mod_cast hB
  have ha : ¬ (3 : ℤ) ∣ a := by
    rintro ⟨A, hA⟩
    apply h3
    refine ⟨(A : O) + (B : O) * omega, ?_⟩
    have hAc : (a : O) = 3 * (A : O) := by exact_mod_cast hA
    rw [heval, hAc, hBc]
    ring
  have hcases : (3 : ℤ) ∣ a - 1 ∨ (3 : ℤ) ∣ a + 1 := by omega
  rcases hcases with ⟨A, hA⟩ | ⟨A, hA⟩
  · left
    apply lambda_sq_dvd_three.trans
    refine ⟨(A : O) + (B : O) * omega, ?_⟩
    have hAc : (a : O) - 1 = 3 * (A : O) := by exact_mod_cast hA
    rw [heval, hBc]
    linear_combination hAc
  · right
    apply lambda_sq_dvd_three.trans
    refine ⟨-((A : O) + (B : O) * omega), ?_⟩
    have hAc : (a : O) + 1 = 3 * (A : O) := by exact_mod_cast hA
    rw [heval, hBc]
    linear_combination -hAc

/-- The base Fourier coefficient is nonzero: otherwise the entire source gains a forbidden period. -/
theorem rationalSourceThetaScalar_ne_zero : rationalSourceThetaScalar ≠ 0 := by
  intro hC
  obtain ⟨h, h3, hT⟩ := exists_source_coefficient_not_three
  have hh : h ≠ 0 := fun he => h3 (he ▸ dvd_zero 3)
  rcases primary_or_negative_primary_of_source_mask h h3 (sourceFourier_phase_of_ne_zero h hh hT) with hp | hp
  · exact hT (rationalSourceFourier_primary_zero_of_base_zero hC h hp)
  · exact hT ((rationalSourceResidualFourierCoefficient_neg h).symm.trans
      (rationalSourceFourier_primary_zero_of_base_zero hC (-h) hp))

/-- The frequency-nine twist is the cubic symbol of the different. -/
lemma symbol_nine_eq_traceLambda (n : O) (hn : lambda ^ 2 ∣ n - 1) :
    symbol 9 n = symbol traceLambda n := by
  have hs : traceLambda ^ 2 = (-3 : O) := by
    unfold traceLambda
    linear_combination 4 * cusp_omega_relation
  have hc3 : IsCoprime (3 : O) n := by
    simpa only [Units.val_one, pow_zero, mul_one] using ramified_primary_coprime (1 : Oˣ) 0 n hn
  have hc : IsCoprime traceLambda n := by
    have he : traceLambda * (-traceLambda) = (3 : O) := by linear_combination -hs
    rw [← he] at hc3
    exact hc3.of_mul_left_left
  have h9 : (9 : O) = traceLambda ^ 4 := by
    rw [show (4 : ℕ) = 2 * 2 by decide, pow_mul, hs]
    norm_num
  rw [h9, symbol_pow_numerator _ _ hn 4, show (4 : ℕ) = 3 + 1 by decide, pow_add,
    symbol_cube_of_isCoprime _ _ hn hc, pow_one, one_mul]

/-- The normalized residual theta coefficient has the exact different-symbol phase. -/
theorem normalized_sourceFourier_squarefree_cube (I J : Ideal O)
    (hI : primaryIdealGenerator I ≠ 0) (hJ : primaryIdealGenerator J ≠ 0) (hsq : Squarefree I) :
    rationalSourceThetaScalar⁻¹ *
      star (rationalSourceResidualFourierCoefficient (primaryIdealGenerator I * (primaryIdealGenerator J) ^ 3)) =
        (‖ringComplex (primaryIdealGenerator J)‖ : ℂ) *
          star (ringComplex (symbol traceLambda (primaryIdealGenerator I))) * normalizedCubicUnitGauss (primaryIdealGenerator I) := by
  rw [rationalSourceResidualFourierCoefficient_squarefree_cube I J hI hJ hsq,
    symbol_nine_eq_traceLambda _ (primaryIdealGenerator_spec I hI).2]
  simp only [← mul_assoc, inv_mul_cancel₀ rationalSourceThetaScalar_ne_zero, one_mul]

lemma normalizedCubicUnitGauss_prime_norm (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1) :
    ‖normalizedCubicUnitGauss p‖ = 1 := by
  have hp1 : ¬ p ∣ (1 : O) := fun hd => hp.2.1 (isUnit_of_dvd_one hd)
  rw [normalizedCubicUnitGauss, norm_div, cubicUnitGaussSum_prime_norm p hp hprimary 1 hp1,
    Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _),
    div_self (norm_ne_zero_iff.mpr (ringComplex_ne_zero hp.ne_zero))]

lemma normalizedCubicUnitGauss_coprime_norm (a b : O) (ha : a ≠ 0) (hb : b ≠ 0)
    (hap : lambda ^ 2 ∣ a - 1) (hbp : lambda ^ 2 ∣ b - 1) (hab : IsCoprime a b) :
    ‖normalizedCubicUnitGauss (a * b)‖ = ‖normalizedCubicUnitGauss a‖ * ‖normalizedCubicUnitGauss b‖ := by
  have he := congrArg norm (normalizedCubicUnitGauss_coprime_product a b ha hb hap hbp hab)
  simpa only [norm_mul, norm_star, symbol_norm_one a b hbp hab, one_mul] using he

lemma normalizedCubicUnitGauss_prime_product_norm {ι : Type*} (s : Finset ι) (p : ι → O)
    (hp : ∀ i ∈ s, Prime (p i)) (hprimary : ∀ i ∈ s, lambda ^ 2 ∣ p i - 1)
    (hpair : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → IsCoprime (p i) (p j)) :
    ‖normalizedCubicUnitGauss (∏ i ∈ s, p i)‖ = 1 := by
  induction s using Finset.induction_on with
  | empty => rw [Finset.prod_empty, normalizedCubicUnitGauss_one, norm_one]
  | @insert i s hi ih =>
    have hpi := hp i (Finset.mem_insert_self _ _)
    have hpri := hprimary i (Finset.mem_insert_self _ _)
    have hps : ∀ j ∈ s, Prime (p j) := fun j hj => hp j (Finset.mem_insert_of_mem hj)
    have hprs : ∀ j ∈ s, lambda ^ 2 ∣ p j - 1 := fun j hj => hprimary j (Finset.mem_insert_of_mem hj)
    have hc : IsCoprime (p i) (∏ j ∈ s, p j) := IsCoprime.prod_right (fun j hj =>
      hpair i (Finset.mem_insert_self _ _) j (Finset.mem_insert_of_mem hj) (by intro he; subst j; exact hi hj))
    have hbs : (∏ j ∈ s, p j) ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun j hj => (hps j hj).ne_zero)
    rw [Finset.prod_insert hi, normalizedCubicUnitGauss_coprime_norm _ _ hpi.ne_zero hbs hpri
      (primary_finset_product s p hprs) hc, normalizedCubicUnitGauss_prime_norm _ hpi hpri,
      ih hps hprs (fun j hj k hk hjk => hpair j (Finset.mem_insert_of_mem hj) k (Finset.mem_insert_of_mem hk) hjk),
      one_mul]

lemma normalizedCubicUnitGauss_squarefree_norm (I : Ideal O) (hI : primaryIdealGenerator I ≠ 0)
    (hsq : Squarefree I) : ‖normalizedCubicUnitGauss (primaryIdealGenerator I)‖ = 1 := by
  rw [primaryIdealGenerator_squarefree_support I hI hsq]
  exact normalizedCubicUnitGauss_prime_product_norm _ _
    (fun P hP => primaryIdealPrime_isPrime_of_mem I P hI hP)
    (fun P hP => (primaryIdealPrime_spec P
      (primaryIdealPrime_factor_ne_zero I P hI (Multiset.mem_toFinset.mp hP))).2.2.2)
    (primaryIdealPrime_support_coprime I hI)

/-- The coefficient size on squarefree times cube support is exactly the cube-root factor. -/
theorem sourceFourier_squarefree_cube_norm (I J : Ideal O)
    (hI : primaryIdealGenerator I ≠ 0) (hJ : primaryIdealGenerator J ≠ 0) (hsq : Squarefree I) :
    ‖rationalSourceResidualFourierCoefficient (primaryIdealGenerator I * (primaryIdealGenerator J) ^ 3)‖ =
      ‖rationalSourceThetaScalar‖ * ‖ringComplex (primaryIdealGenerator J)‖ := by
  have hp := (primaryIdealGenerator_spec I hI).2
  have hc3 : IsCoprime (3 : O) (primaryIdealGenerator I) := by
    simpa only [Units.val_one, pow_zero, mul_one] using ramified_primary_coprime (1 : Oˣ) 0 _ hp
  have hc9 : IsCoprime (9 : O) (primaryIdealGenerator I) := by
    convert hc3.mul_left hc3 using 1 <;> norm_num
  have he := congrArg norm (rationalSourceResidualFourierCoefficient_squarefree_cube I J hI hJ hsq)
  simpa only [norm_star, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _),
    symbol_norm_one _ _ hp hc9, normalizedCubicUnitGauss_squarefree_norm I hI hsq, mul_one] using he

/-- Squarefree times cube is the exact support of the unramified Fourier coefficients. -/
theorem sourceFourier_squarefree_cube_support_iff (I : Ideal O) (hI : primaryIdealGenerator I ≠ 0) :
    rationalSourceResidualFourierCoefficient (primaryIdealGenerator I) ≠ 0 ↔
      ∃ A B : Ideal O, Squarefree A ∧ primaryIdealGenerator A ≠ 0 ∧ primaryIdealGenerator B ≠ 0 ∧ A * B ^ 3 = I := by
  constructor
  · exact rationalSourceFourier_squarefree_cube_support I hI
  · rintro ⟨A, B, hA, hAg, hBg, hAB⟩
    have he := congrArg primaryIdealGenerator hAB
    rw [primaryIdealGenerator_mul, primaryIdealGenerator_pow] at he
    rw [← he]
    apply norm_pos_iff.mp
    rw [sourceFourier_squarefree_cube_norm A B hAg hBg hA]
    exact mul_pos (norm_pos_iff.mpr rationalSourceThetaScalar_ne_zero)
      (norm_pos_iff.mpr (ringComplex_ne_zero hBg))


/-- The positive Gaussian Mellin integral is a scaled Gamma integral. -/
lemma complex_gaussian_power_integrable (s : ℂ) (r : ℝ) (hs : 0 < s.re) (hr : 0 < r) :
    IntegrableOn (fun x : ℝ => (x : ℂ) ^ (s - 1) * Complex.exp (-(r : ℂ) * (x : ℂ) ^ 2)) (Ioi 0) := by
  have hs2 : 0 < (s / (2 : ℂ)).re := by simpa using half_pos hs
  have hbase : MellinConvergent (fun t : ℝ => Complex.exp (-(t : ℂ))) (s / 2) := by
    simpa only [MellinConvergent, smul_eq_mul, Complex.ofReal_exp, Complex.ofReal_neg, mul_comm]
      using Complex.GammaIntegral_convergent hs2
  have hlinear := (MellinConvergent.comp_mul_left
    (f := fun t : ℝ => Complex.exp (-(t : ℂ))) (s := s / 2) hr).mpr hbase
  have hgaussian := (MellinConvergent.comp_rpow
    (f := fun t : ℝ => Complex.exp (-((r * t : ℝ) : ℂ))) (s := s) (a := 2) (by norm_num)).mpr hlinear
  simpa only [MellinConvergent, smul_eq_mul, Real.rpow_two, Complex.ofReal_mul,
    Complex.ofReal_pow, neg_mul] using hgaussian

lemma complex_gaussian_power_integral (s : ℂ) (r : ℝ) (hs : 0 < s.re) (hr : 0 < r) :
    (∫ x : ℝ in Ioi 0, (x : ℂ) ^ (s - 1) * Complex.exp (-(r : ℂ) * (x : ℂ) ^ 2)) =
      (1 / 2 : ℂ) * ((1 / (r : ℂ)) ^ (s / 2) * Complex.Gamma (s / 2)) := by
  have hs2 : 0 < (s / (2 : ℂ)).re := by simpa using half_pos hs
  have he := mellin_comp_rpow (fun t : ℝ => Complex.exp (-((r * t : ℝ) : ℂ))) s 2
  simp only [mellin, smul_eq_mul, Real.rpow_two, Complex.ofReal_mul, Complex.ofReal_pow, Complex.real_smul] at he
  norm_num only [Complex.ofReal_ofNat] at he
  rw [Complex.integral_cpow_mul_exp_neg_mul_Ioi hs2 hr] at he
  simpa [neg_mul] using he

/-- The Schläfli mixture after multiplying by the cubic Mellin weight. -/
def cubicMellinMixture (s : ℂ) (t x : ℝ) : ℂ :=
  (t : ℂ) ^ (-(2 : ℂ) / 3) * Complex.exp (-(t : ℂ)) *
    ((x : ℂ) ^ ((s - 1 / 3) - 1) * Complex.exp (-((1 / (4 * t) : ℝ) : ℂ) * (x : ℂ) ^ 2))

lemma cubicMellinMixture_slice_integrable (s : ℂ) (hs : 1 / 3 < s.re) (t : ℝ) (ht : 0 < t) :
    IntegrableOn (cubicMellinMixture s t) (Ioi 0) := by
  exact (complex_gaussian_power_integrable (s - 1 / 3) (1 / (4 * t))
    (by norm_num; linarith) (by positivity)).const_mul _

lemma cubicMellinMixture_integral_x (s : ℂ) (hs : 1 / 3 < s.re) (t : ℝ) (ht : 0 < t) :
    (∫ x : ℝ in Ioi 0, cubicMellinMixture s t x) =
      ((1 / 2 : ℂ) * (4 : ℂ) ^ ((s - 1 / 3) / 2) * Complex.Gamma ((s - 1 / 3) / 2)) *
        ((t : ℂ) ^ ((s + 1 / 3) / 2 - 1) * Complex.exp (-(t : ℂ))) := by
  simp only [cubicMellinMixture, integral_const_mul]
  rw [complex_gaussian_power_integral (s - 1 / 3) (1 / (4 * t)) (by norm_num; linarith) (by positivity)]
  have hb : (1 / (((1 / (4 * t) : ℝ) : ℂ))) = (4 : ℂ) * (t : ℂ) := by push_cast; field_simp
  have hm : ((4 : ℂ) * (t : ℂ)) ^ ((s - 1 / 3) / 2) =
      (4 : ℂ) ^ ((s - 1 / 3) / 2) * (t : ℂ) ^ ((s - 1 / 3) / 2) := by
    simpa only [Complex.ofReal_ofNat] using
      Complex.mul_cpow_ofReal_nonneg (by norm_num : 0 ≤ (4 : ℝ)) ht.le ((s - 1 / 3) / 2)
  rw [hb, hm]
  have hp : (t : ℂ) ^ (-(2 : ℂ) / 3) * (t : ℂ) ^ ((s - 1 / 3) / 2) =
      (t : ℂ) ^ ((s + 1 / 3) / 2 - 1) := by
    rw [← Complex.cpow_add _ _ (Complex.ofReal_ne_zero.mpr ht.ne')]
    congr 1
    ring
  calc
    _ = ((1 / 2 : ℂ) * (4 : ℂ) ^ ((s - 1 / 3) / 2) * Complex.Gamma ((s - 1 / 3) / 2)) *
        (((t : ℂ) ^ (-(2 : ℂ) / 3) * (t : ℂ) ^ ((s - 1 / 3) / 2)) * Complex.exp (-(t : ℂ))) := by ring
    _ = _ := by rw [hp]

lemma cubicMellinMixture_norm (s : ℂ) (t x : ℝ) (ht : 0 < t) (hx : 0 < x) :
    ‖cubicMellinMixture s t x‖ =
      (t ^ (-(2 : ℝ) / 3) * Real.exp (-t)) *
        (x ^ ((s.re - 1 / 3) - 1) * Real.exp (-(1 / (4 * t)) * x ^ 2)) := by
  have he : -((1 / (4 * t) : ℝ) : ℂ) * (x : ℂ) ^ 2 = (-(1 / (4 * t)) * x ^ 2 : ℝ) := by
    push_cast
    rfl
  simp only [cubicMellinMixture, norm_mul, he,
    Complex.norm_cpow_eq_rpow_re_of_pos ht, Complex.norm_cpow_eq_rpow_re_of_pos hx,
    Complex.norm_exp, Complex.ofReal_re, Complex.neg_re]
  norm_num

lemma real_gaussian_power_integral (σ r : ℝ) (hs : 0 < σ) (hr : 0 < r) :
    (∫ x : ℝ in Ioi 0, x ^ (σ - 1) * Real.exp (-r * x ^ 2)) =
      r ^ (-σ / 2) * (1 / 2) * Real.Gamma (σ / 2) := by
  simpa only [Real.rpow_two, sub_add_cancel] using
    (_root_.integral_rpow_mul_exp_neg_mul_rpow (p := 2) (q := σ - 1) (b := r)
      (by norm_num) (by linarith) hr)

lemma cubicMellinMixture_integral_norm (s : ℂ) (hs : 1 / 3 < s.re) (t : ℝ) (ht : 0 < t) :
    (∫ x : ℝ in Ioi 0, ‖cubicMellinMixture s t x‖) =
      ((1 / 2 : ℝ) * (4 : ℝ) ^ ((s.re - 1 / 3) / 2) * Real.Gamma ((s.re - 1 / 3) / 2)) *
        (t ^ ((s.re + 1 / 3) / 2 - 1) * Real.exp (-t)) := by
  calc
    _ = ∫ x : ℝ in Ioi 0, (t ^ (-(2 : ℝ) / 3) * Real.exp (-t)) *
        (x ^ ((s.re - 1 / 3) - 1) * Real.exp (-(1 / (4 * t)) * x ^ 2)) :=
      setIntegral_congr_fun measurableSet_Ioi (fun x hx => cubicMellinMixture_norm s t x ht hx)
    _ = _ := by
      rw [integral_const_mul, real_gaussian_power_integral (s.re - 1 / 3) (1 / (4 * t))
        (by linarith) (by positivity)]
      have hpow : (1 / (4 * t) : ℝ) ^ (-(s.re - 1 / 3) / 2) =
          (4 : ℝ) ^ ((s.re - 1 / 3) / 2) * t ^ ((s.re - 1 / 3) / 2) := by
        rw [show -(s.re - 1 / 3) / 2 = -((s.re - 1 / 3) / 2) by ring,
          Real.rpow_neg_eq_inv_rpow, one_div, inv_inv,
          Real.mul_rpow (by norm_num : 0 ≤ (4 : ℝ)) ht.le]
      rw [hpow]
      have hp : t ^ (-(2 : ℝ) / 3) * t ^ ((s.re - 1 / 3) / 2) = t ^ ((s.re + 1 / 3) / 2 - 1) := by
        rw [← Real.rpow_add ht]
        congr 1
        ring
      calc
        _ = ((1 / 2 : ℝ) * (4 : ℝ) ^ ((s.re - 1 / 3) / 2) * Real.Gamma ((s.re - 1 / 3) / 2)) *
            ((t ^ (-(2 : ℝ) / 3) * t ^ ((s.re - 1 / 3) / 2)) * Real.exp (-t)) := by ring
        _ = _ := by rw [hp]

/-- Absolute integrability justifies exchanging the Schläfli and Mellin integrals. -/
lemma cubicMellinMixture_integrable (s : ℂ) (hs : 1 / 3 < s.re) :
    Integrable (fun p : ℝ × ℝ => cubicMellinMixture s p.1 p.2)
      ((volume.restrict (Ioi 0)).prod (volume.restrict (Ioi 0))) := by
  have hm : AEStronglyMeasurable (fun p : ℝ × ℝ => cubicMellinMixture s p.1 p.2)
      ((volume.restrict (Ioi 0)).prod (volume.restrict (Ioi 0))) := by
    unfold cubicMellinMixture
    fun_prop
  apply (integrable_prod_iff hm).mpr
  constructor
  · filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    exact cubicMellinMixture_slice_integrable s hs t ht
  · apply ((Real.GammaIntegral_convergent (show 0 < (s.re + 1 / 3) / 2 by linarith)).const_mul
      ((1 / 2 : ℝ) * (4 : ℝ) ^ ((s.re - 1 / 3) / 2) * Real.Gamma ((s.re - 1 / 3) / 2))).congr
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    rw [cubicMellinMixture_integral_norm s hs t ht]
    ring

lemma cubicMellinMixture_integral_t (s : ℂ) (x : ℝ) :
    (∫ t : ℝ in Ioi 0, cubicMellinMixture s t x) =
      (x : ℂ) ^ ((s - 1 / 3) - 1) * schlafliIntegral (1 / 3) x := by
  rw [schlafliIntegral, ← integral_const_mul]
  apply setIntegral_congr_fun measurableSet_Ioi
  intro t ht
  have he : Complex.exp (-(t : ℂ)) * Complex.exp (-((1 / (4 * t) : ℝ) : ℂ) * (x : ℂ) ^ 2) =
      Complex.exp (-(t : ℂ) - (x : ℂ) ^ 2 / (4 * t)) := by
    rw [← Complex.exp_add]
    congr 1
    push_cast
    field_simp
    ring
  rw [show (1 / 3 : ℂ) - 1 = -(2 : ℂ) / 3 by ring]
  unfold cubicMellinMixture
  linear_combination (t : ℂ) ^ (-(2 : ℂ) / 3) * (x : ℂ) ^ ((s - 1 / 3) - 1) * he

lemma schlafliBesselK_cubic_mellin_mixture (s : ℂ) (x : ℝ) (hx : 0 < x) :
    (x : ℂ) ^ (s - 1) * schlafliBesselK (1 / 3) x =
      ((1 / 2 : ℂ) * (2 : ℂ) ^ (1 / 3 : ℂ)) * (∫ t : ℝ in Ioi 0, cubicMellinMixture s t x) := by
  rw [schlafliBesselK, cubicMellinMixture_integral_t]
  have hdiv : (x / 2 : ℂ) ^ (-(1 / 3 : ℂ)) = (x : ℂ) ^ (-(1 / 3 : ℂ)) / (2 : ℂ) ^ (-(1 / 3 : ℂ)) := by
    have hm := Complex.mul_cpow_ofReal_nonneg
      (show 0 ≤ x / 2 by positivity) (by norm_num : 0 ≤ (2 : ℝ)) (-(1 / 3 : ℂ))
    have he : ((x / 2 : ℝ) : ℂ) * (2 : ℂ) = (x : ℂ) := by push_cast; ring
    norm_num only [Complex.ofReal_ofNat] at hm
    rw [he] at hm
    apply (eq_div_iff (Complex.cpow_ne_zero_iff.mpr (Or.inl (by norm_num : (2 : ℂ) ≠ 0)))).mpr
    simpa only [Complex.ofReal_div, Complex.ofReal_ofNat] using hm.symm
  rw [hdiv, Complex.cpow_neg (2 : ℂ) (1 / 3), div_inv_eq_mul]
  have hp : (x : ℂ) ^ (s - 1) * (x : ℂ) ^ (-(1 / 3 : ℂ)) = (x : ℂ) ^ ((s - 1 / 3) - 1) := by
    rw [← Complex.cpow_add _ _ (Complex.ofReal_ne_zero.mpr hx.ne')]
    congr 1
    ring
  linear_combination (1 / 2 : ℂ) * (2 : ℂ) ^ (1 / 3 : ℂ) * schlafliIntegral (1 / 3) x * hp

lemma schlafliBesselK_cubic_mellin_integrable (s : ℂ) (hs : 1 / 3 < s.re) :
    IntegrableOn (fun x : ℝ => (x : ℂ) ^ (s - 1) * schlafliBesselK (1 / 3) x) (Ioi 0) := by
  apply ((cubicMellinMixture_integrable s hs).integral_prod_right.const_mul
    ((1 / 2 : ℂ) * (2 : ℂ) ^ (1 / 3 : ℂ))).congr
  filter_upwards [ae_restrict_mem measurableSet_Ioi] with x hx
  exact (schlafliBesselK_cubic_mellin_mixture s x hx).symm

lemma cubicMellinMixture_double_integral (s : ℂ) (hs : 1 / 3 < s.re) :
    (∫ t : ℝ in Ioi 0, ∫ x : ℝ in Ioi 0, cubicMellinMixture s t x) =
      ((1 / 2 : ℂ) * (4 : ℂ) ^ ((s - 1 / 3) / 2) * Complex.Gamma ((s - 1 / 3) / 2)) *
        Complex.Gamma ((s + 1 / 3) / 2) := by
  have hB : 0 < ((s + 1 / 3) / 2).re := by norm_num; linarith
  calc
    _ = ∫ t : ℝ in Ioi 0,
        ((1 / 2 : ℂ) * (4 : ℂ) ^ ((s - 1 / 3) / 2) * Complex.Gamma ((s - 1 / 3) / 2)) *
          ((t : ℂ) ^ ((s + 1 / 3) / 2 - 1) * Complex.exp (-(t : ℂ))) :=
      setIntegral_congr_fun measurableSet_Ioi (fun t ht => cubicMellinMixture_integral_x s hs t ht)
    _ = _ := by
      rw [integral_const_mul]
      congr 1
      simpa only [Complex.GammaIntegral, Complex.ofReal_exp, Complex.ofReal_neg, mul_comm] using
        (Complex.Gamma_eq_integral hB).symm

/-- The cubic Bessel Mellin transform, including absolute convergence in its full half-plane. -/
theorem schlafliBesselK_cubic_mellin (s : ℂ) (hs : 1 / 3 < s.re) :
    (∫ x : ℝ in Ioi 0, (x : ℂ) ^ (s - 1) * schlafliBesselK (1 / 3) x) =
      (2 : ℂ) ^ (s - 2) * Complex.Gamma ((s - 1 / 3) / 2) * Complex.Gamma ((s + 1 / 3) / 2) := by
  have hmix : Integrable (Function.uncurry (cubicMellinMixture s))
      ((volume.restrict (Ioi 0)).prod (volume.restrict (Ioi 0))) := cubicMellinMixture_integrable s hs
  have hswap := (integral_integral_swap hmix).symm
  have h4 : (4 : ℂ) ^ ((s - 1 / 3) / 2) = (2 : ℂ) ^ (2 * ((s - 1 / 3) / 2)) := by
    have hh := (Complex.natCast_cpow_natCast_mul 2 2 ((s - 1 / 3) / 2)).symm
    norm_num at hh
    exact hh
  have hprod : (2 : ℂ) ^ (1 / 3 : ℂ) * (4 : ℂ) ^ ((s - 1 / 3) / 2) = (2 : ℂ) ^ s := by
    rw [h4, ← Complex.cpow_add _ _ (by norm_num : (2 : ℂ) ≠ 0)]
    congr 1
    ring
  have hscale : (1 / 4 : ℂ) * (2 : ℂ) ^ s = (2 : ℂ) ^ (s - 2) := by
    rw [Complex.cpow_sub _ _ (by norm_num : (2 : ℂ) ≠ 0)]
    norm_num
    ring
  calc
    _ = ((1 / 2 : ℂ) * (2 : ℂ) ^ (1 / 3 : ℂ)) *
        (∫ x : ℝ in Ioi 0, ∫ t : ℝ in Ioi 0, cubicMellinMixture s t x) := by
      rw [← integral_const_mul]
      exact setIntegral_congr_fun measurableSet_Ioi (fun x hx => schlafliBesselK_cubic_mellin_mixture s x hx)
    _ = ((1 / 2 : ℂ) * (2 : ℂ) ^ (1 / 3 : ℂ)) *
        (((1 / 2 : ℂ) * (4 : ℂ) ^ ((s - 1 / 3) / 2) * Complex.Gamma ((s - 1 / 3) / 2)) *
          Complex.Gamma ((s + 1 / 3) / 2)) := by rw [hswap, cubicMellinMixture_double_integral s hs]
    _ = ((1 / 4 : ℂ) * ((2 : ℂ) ^ (1 / 3 : ℂ) * (4 : ℂ) ^ ((s - 1 / 3) / 2))) *
        Complex.Gamma ((s - 1 / 3) / 2) * Complex.Gamma ((s + 1 / 3) / 2) := by ring
    _ = _ := by rw [hprod, hscale]

lemma schlafliBesselK_cubic_scaled_mellin_integrable (s : ℂ) (c : ℝ)
    (hs : 1 / 3 < s.re) (hc : 0 < c) :
    IntegrableOn (fun v : ℝ => (v : ℂ) ^ (s - 1) * schlafliBesselK (1 / 3) (c * v)) (Ioi 0) := by
  have hb : MellinConvergent (fun v => schlafliBesselK (1 / 3) v) s := by
    simpa only [MellinConvergent, smul_eq_mul] using schlafliBesselK_cubic_mellin_integrable s hs
  simpa only [MellinConvergent, smul_eq_mul] using
    (MellinConvergent.comp_mul_left (f := fun v => schlafliBesselK (1 / 3) v) (s := s) hc).mpr hb

lemma schlafliBesselK_cubic_scaled_mellin (s : ℂ) (c : ℝ) (hs : 1 / 3 < s.re) (hc : 0 < c) :
    (∫ v : ℝ in Ioi 0, (v : ℂ) ^ (s - 1) * schlafliBesselK (1 / 3) (c * v)) =
      (c : ℂ) ^ (-s) * ((2 : ℂ) ^ (s - 2) * Complex.Gamma ((s - 1 / 3) / 2) * Complex.Gamma ((s + 1 / 3) / 2)) := by
  have he := mellin_comp_mul_left (fun v => schlafliBesselK (1 / 3) v) s hc
  simp only [mellin, smul_eq_mul] at he
  rw [schlafliBesselK_cubic_mellin s hs] at he
  exact he

lemma source_cubic_bessel_mellin_integrable (s freq : ℂ) (hs : -(1 / 3) < s.re) (hfreq : freq ≠ 0) :
    IntegrableOn (fun v : ℝ => (v : ℂ) ^ (2 * s) *
      schlafliBesselK (1 / 3) (4 * Real.pi * ‖freq‖ * v)) (Ioi 0) := by
  have hc : 0 < 4 * Real.pi * ‖freq‖ := by positivity
  have ht : 1 / 3 < (2 * s + 1).re := by norm_num; linarith
  simpa only [show (2 * s + 1 : ℂ) - 1 = 2 * s by ring] using
    schlafliBesselK_cubic_scaled_mellin_integrable (2 * s + 1) (4 * Real.pi * ‖freq‖) ht hc

/-- The exact Gamma factor for each nonzero source Fourier mode. -/
theorem source_cubic_bessel_mellin (s freq : ℂ) (hs : -(1 / 3) < s.re) (hfreq : freq ≠ 0) :
    (∫ v : ℝ in Ioi 0, (v : ℂ) ^ (2 * s) * schlafliBesselK (1 / 3) (4 * Real.pi * ‖freq‖ * v)) =
      ((2 : ℂ) ^ (2 * s - 1) * Complex.Gamma (s + 1 / 3) * Complex.Gamma (s + 2 / 3)) /
        ((4 * Real.pi * ‖freq‖ : ℝ) : ℂ) ^ (2 * s + 1) := by
  have hc : 0 < 4 * Real.pi * ‖freq‖ := by positivity
  have ht : 1 / 3 < (2 * s + 1).re := by norm_num; linarith
  have he := schlafliBesselK_cubic_scaled_mellin (2 * s + 1) (4 * Real.pi * ‖freq‖) ht hc
  rw [show (2 * s + 1 : ℂ) - 1 = 2 * s by ring,
    show (2 * s + 1 : ℂ) - 2 = 2 * s - 1 by ring,
    show ((2 * s + 1 : ℂ) - 1 / 3) / 2 = s + 1 / 3 by ring,
    show ((2 * s + 1 : ℂ) + 1 / 3) / 2 = s + 2 / 3 by ring, Complex.cpow_neg] at he
  rw [he]
  ring


/-- Prime valuations determine the squarefree factor and the cube factor separately. -/
theorem squarefree_cube_decomposition_unique {A B C D : Ideal O}
    (hB : B ≠ 0) (hD : D ≠ 0) (hA : Squarefree A) (hC : Squarefree C)
    (he : A * B ^ 3 = C * D ^ 3) : A = C ∧ B = D := by
  have hf := congrArg normalizedFactors he
  rw [normalizedFactors_mul hA.ne_zero (pow_ne_zero _ hB),
    normalizedFactors_mul hC.ne_zero (pow_ne_zero _ hD),
    normalizedFactors_pow, normalizedFactors_pow] at hf
  have ha := (squarefree_iff_nodup_normalizedFactors hA.ne_zero).mp hA
  have hc := (squarefree_iff_nodup_normalizedFactors hC.ne_zero).mp hC
  have hcount (P : Ideal O) :
      (normalizedFactors A).count P = (normalizedFactors C).count P ∧
      (normalizedFactors B).count P = (normalizedFactors D).count P := by
    have hp := congrArg (Multiset.count P) hf
    simp only [Multiset.count_add, Multiset.count_nsmul] at hp
    have ha1 := Multiset.nodup_iff_count_le_one.mp ha P
    have hc1 := Multiset.nodup_iff_count_le_one.mp hc P
    omega
  constructor
  · calc
      A = (normalizedFactors A).prod := (Ideal.prod_normalizedFactors_eq_self hA.ne_zero).symm
      _ = (normalizedFactors C).prod := congrArg Multiset.prod (Multiset.ext.mpr (fun P => (hcount P).1))
      _ = C := Ideal.prod_normalizedFactors_eq_self hC.ne_zero
  · calc
      B = (normalizedFactors B).prod := (Ideal.prod_normalizedFactors_eq_self hB).symm
      _ = (normalizedFactors D).prod := congrArg Multiset.prod (Multiset.ext.mpr (fun P => (hcount P).2))
      _ = D := Ideal.prod_normalizedFactors_eq_self hD


/-- The primary element `ab³` determines both ideal factors. -/
theorem primary_squarefree_cube_injective :
    Function.Injective (fun p :
      {I : Ideal O // Squarefree I ∧ primaryIdealGenerator I ≠ 0} ×
      {J : Ideal O // primaryIdealGenerator J ≠ 0} =>
        primaryIdealGenerator p.1.val * (primaryIdealGenerator p.2.val) ^ 3) := by
  intro p q he
  have hi : p.1.val * p.2.val ^ 3 = q.1.val * q.2.val ^ 3 := by
    have hs := congrArg (fun x : O => (Ideal.span {x} : Ideal O)) he
    simpa only [← Ideal.span_singleton_mul_span_singleton, ← Ideal.span_singleton_pow,
      (primaryIdealGenerator_spec p.1.val p.1.property.2).1,
      (primaryIdealGenerator_spec p.2.val p.2.property).1,
      (primaryIdealGenerator_spec q.1.val q.1.property.2).1,
      (primaryIdealGenerator_spec q.2.val q.2.property).1] using hs
  have hd := squarefree_cube_decomposition_unique
    (primaryIdealGenerator_ne_zero_ideal _ p.2.property)
    (primaryIdealGenerator_ne_zero_ideal _ q.2.property)
    p.1.property.1 q.1.property.1 hi
  exact Prod.ext (Subtype.ext hd.1) (Subtype.ext hd.2)

lemma sourceFourier_primary_pair_preimage (x : O) (hx : lambda ^ 2 ∣ x - 1)
    (hT : rationalSourceResidualFourierCoefficient x ≠ 0) :
    ∃ p : ({I : Ideal O // Squarefree I ∧ primaryIdealGenerator I ≠ 0} ×
      {J : Ideal O // primaryIdealGenerator J ≠ 0}),
      primaryIdealGenerator p.1.val * (primaryIdealGenerator p.2.val) ^ 3 = x := by
  have hg : primaryIdealGenerator (Ideal.span {x}) = x :=
    primaryIdealGenerator_span x (primary_ne_zero x hx) hx
  have hg0 : primaryIdealGenerator (Ideal.span {x}) ≠ 0 := by rw [hg]; exact primary_ne_zero x hx
  have ht : rationalSourceResidualFourierCoefficient (primaryIdealGenerator (Ideal.span {x})) ≠ 0 := by rwa [hg]
  obtain ⟨I, J, hI, hIg, hJg, he⟩ := rationalSourceFourier_squarefree_cube_support (Ideal.span {x}) hg0 ht
  refine ⟨(⟨I, hI, hIg⟩, ⟨J, hJg⟩), ?_⟩
  simpa only [primaryIdealGenerator_mul, primaryIdealGenerator_pow, hg] using congrArg primaryIdealGenerator he

/-- Reindex a primary-supported Fourier sum by its unique squarefree and cube factors. -/
theorem sourceFourier_tsum_primary_pairs (w : O → ℂ)
    (hw : ∀ x, w x ≠ 0 → lambda ^ 2 ∣ x - 1) :
    (∑' x : O, w x * star (rationalSourceResidualFourierCoefficient x)) =
      ∑' p : ({I : Ideal O // Squarefree I ∧ primaryIdealGenerator I ≠ 0} ×
        {J : Ideal O // primaryIdealGenerator J ≠ 0}),
        w (primaryIdealGenerator p.1.val * (primaryIdealGenerator p.2.val) ^ 3) *
          star (rationalSourceResidualFourierCoefficient
            (primaryIdealGenerator p.1.val * (primaryIdealGenerator p.2.val) ^ 3)) := by
  let P := ({I : Ideal O // Squarefree I ∧ primaryIdealGenerator I ≠ 0} ×
    {J : Ideal O // primaryIdealGenerator J ≠ 0})
  let φ : P → O := fun p => primaryIdealGenerator p.1.val * (primaryIdealGenerator p.2.val) ^ 3
  let f : O → ℂ := fun x => w x * star (rationalSourceResidualFourierCoefficient x)
  change (∑' x, f x) = ∑' p : P, f (φ p)
  apply tsum_eq_tsum_of_ne_zero_bij (fun p : Function.support (fun p : P => f (φ p)) => φ p.val)
  · exact primary_squarefree_cube_injective.comp Subtype.val_injective
  · intro x hx
    have hwx : w x ≠ 0 := by intro hz; exact hx (by simp only [f, hz, zero_mul])
    have hTx : rationalSourceResidualFourierCoefficient x ≠ 0 := by
      intro hz
      exact hx (by simp only [f, hz, star_zero, mul_zero])
    obtain ⟨p, hp⟩ := sourceFourier_primary_pair_preimage x (hw x hwx) hTx
    have hφ : φ p = x := hp
    exact ⟨⟨p, by change f (φ p) ≠ 0; rwa [hφ]⟩, hφ⟩
  · intro p
    rfl

/-- The different symbol is a cubic root of unity at every primary denominator. -/
lemma traceLambda_symbol_cube (x : O) (hx : lambda ^ 2 ∣ x - 1) :
    (ringComplex (symbol traceLambda x)) ^ 3 = 1 := by
  have hs : traceLambda ^ 2 = (-3 : O) := by
    unfold traceLambda
    linear_combination 4 * cusp_omega_relation
  have hc3 : IsCoprime (3 : O) x := by
    simpa only [Units.val_one, pow_zero, mul_one] using ramified_primary_coprime (1 : Oˣ) 0 x hx
  have hc : IsCoprime traceLambda x := by
    have he : traceLambda * (-traceLambda) = (3 : O) := by linear_combination -hs
    rw [← he] at hc3
    exact hc3.of_mul_left_left
  rw [← map_pow, symbol_cube_of_isCoprime _ _ hx hc, map_one]

lemma traceLambda_symbol_norm (x : O) (hx : lambda ^ 2 ∣ x - 1) :
    ‖ringComplex (symbol traceLambda x)‖ = 1 := by
  apply (pow_left_inj₀ (norm_nonneg _) zero_le_one (by decide : (3 : ℕ) ≠ 0)).mp
  simpa only [norm_pow, norm_one, one_pow] using congrArg norm (traceLambda_symbol_cube x hx)

/-- Cubes contribute no different-symbol phase. -/
lemma traceLambda_symbol_mul_cube (a b : O) (hb : lambda ^ 2 ∣ b - 1) :
    ringComplex (symbol traceLambda (a * b ^ 3)) = ringComplex (symbol traceLambda a) := by
  rw [symbol_mul_denominator, symbol_pow_denominator, map_mul, map_pow,
    traceLambda_symbol_cube b hb, mul_one]

/-- The primary mask and different phase converting theta coefficients to cubic Gauss sums. -/
def fixedThetaTwist (Ψ : O →* ℂ) (x : O) : ℂ :=
  if lambda ^ 2 ∣ x - 1 then ringComplex (symbol traceLambda x) * Ψ x else 0

lemma fixedThetaTwist_primary (Ψ : O →* ℂ) (x : O) (hx : lambda ^ 2 ∣ x - 1) :
    fixedThetaTwist Ψ x = ringComplex (symbol traceLambda x) * Ψ x := by
  simp only [fixedThetaTwist, if_pos hx]

lemma fixedThetaTwist_support (Ψ : O →* ℂ) (x : O) (hx : fixedThetaTwist Ψ x ≠ 0) :
    lambda ^ 2 ∣ x - 1 := by
  by_contra hn
  exact hx (by simp only [fixedThetaTwist, if_neg hn])

lemma fixedThetaTwist_norm (Ψ : O →* ℂ) (x : O) :
    ‖fixedThetaTwist Ψ x‖ = if lambda ^ 2 ∣ x - 1 then ‖Ψ x‖ else 0 := by
  by_cases hx : lambda ^ 2 ∣ x - 1
  · rw [fixedThetaTwist_primary Ψ x hx, norm_mul, traceLambda_symbol_norm x hx, one_mul, if_pos hx]
  · simp only [fixedThetaTwist, if_neg hx, norm_zero]

/-- Twisting cancels the different phase, leaving the normalized cubic Gauss coefficient. -/
theorem fixedThetaTwist_source_coefficient (Ψ : O →* ℂ) (I J : Ideal O)
    (hI : primaryIdealGenerator I ≠ 0) (hJ : primaryIdealGenerator J ≠ 0) (hsq : Squarefree I) :
    rationalSourceThetaScalar⁻¹ *
      star (rationalSourceResidualFourierCoefficient (primaryIdealGenerator I * (primaryIdealGenerator J) ^ 3)) *
        fixedThetaTwist Ψ (primaryIdealGenerator I * (primaryIdealGenerator J) ^ 3) =
      (‖ringComplex (primaryIdealGenerator J)‖ : ℂ) * normalizedCubicUnitGauss (primaryIdealGenerator I) *
        Ψ (primaryIdealGenerator I) * (Ψ (primaryIdealGenerator J)) ^ 3 := by
  have hIp := (primaryIdealGenerator_spec I hI).2
  have hJp := (primaryIdealGenerator_spec J hJ).2
  have hp := primary_mul _ _ hIp (primary_pow_congruence _ hJp 3)
  rw [normalized_sourceFourier_squarefree_cube I J hI hJ hsq,
    fixedThetaTwist_primary Ψ _ hp, traceLambda_symbol_mul_cube _ _ hJp, map_mul, map_pow]
  have hu : star (ringComplex (symbol traceLambda (primaryIdealGenerator I))) *
      ringComplex (symbol traceLambda (primaryIdealGenerator I)) = 1 := by
    simpa only [Complex.star_def, traceLambda_symbol_norm _ hIp, one_pow, Complex.ofReal_one] using
      Complex.conj_mul' (ringComplex (symbol traceLambda (primaryIdealGenerator I)))
  calc
    _ = (star (ringComplex (symbol traceLambda (primaryIdealGenerator I))) *
        ringComplex (symbol traceLambda (primaryIdealGenerator I))) *
        ((‖ringComplex (primaryIdealGenerator J)‖ : ℂ) * normalizedCubicUnitGauss (primaryIdealGenerator I) *
          Ψ (primaryIdealGenerator I) * (Ψ (primaryIdealGenerator J)) ^ 3) := by ring
    _ = _ := by rw [hu, one_mul]

/-- The twisted primary Fourier sum is exactly the squarefree-times-cube Gauss series. -/
theorem fixedThetaTwist_source_tsum (Ψ : O →* ℂ) (W : O → ℂ) :
    (∑' x : O, (rationalSourceThetaScalar⁻¹ * star (rationalSourceResidualFourierCoefficient x) *
      fixedThetaTwist Ψ x) * W x) =
      ∑' p : ({I : Ideal O // Squarefree I ∧ primaryIdealGenerator I ≠ 0} ×
        {J : Ideal O // primaryIdealGenerator J ≠ 0}),
        ((‖ringComplex (primaryIdealGenerator p.2.val)‖ : ℂ) *
          normalizedCubicUnitGauss (primaryIdealGenerator p.1.val) *
          Ψ (primaryIdealGenerator p.1.val) * (Ψ (primaryIdealGenerator p.2.val)) ^ 3) *
          W (primaryIdealGenerator p.1.val * (primaryIdealGenerator p.2.val) ^ 3) := by
  let w : O → ℂ := fun x => rationalSourceThetaScalar⁻¹ * fixedThetaTwist Ψ x * W x
  have hw (x : O) (hx : w x ≠ 0) : lambda ^ 2 ∣ x - 1 := by
    apply fixedThetaTwist_support Ψ x
    intro hz
    exact hx (by simp only [w, hz, mul_zero, zero_mul])
  calc
    _ = ∑' x : O, w x * star (rationalSourceResidualFourierCoefficient x) := by
      apply tsum_congr
      intro x
      dsimp only [w]
      ring
    _ = _ := by
      rw [sourceFourier_tsum_primary_pairs w hw]
      apply tsum_congr
      intro p
      have he := fixedThetaTwist_source_coefficient Ψ p.1.val p.2.val
        p.1.property.2 p.2.property p.1.property.1
      dsimp only [w]
      linear_combination W (primaryIdealGenerator p.1.val * (primaryIdealGenerator p.2.val) ^ 3) * he

/-- A character modulo `c` acquires precisely the additional modulus nine from the different. -/
lemma fixedThetaTwist_quotient_period (c : O) (Ψ : (O ⧸ Ideal.span {c}) →* ℂ)
    (x y : O) (hxy : (9 * c : O) ∣ x - y) :
    fixedThetaTwist (Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom) x =
      fixedThetaTwist (Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom) y := by
  have h9 : (9 : O) ∣ x - y := (dvd_mul_right 9 c).trans hxy
  have hc : c ∣ x - y := (dvd_mul_left c 9).trans hxy
  have hd : lambda ^ 2 ∣ x - y := lambda_sq_dvd_three.trans ((show (3 : O) ∣ 9 from ⟨3, by norm_num⟩).trans h9)
  have hp : lambda ^ 2 ∣ x - 1 ↔ lambda ^ 2 ∣ y - 1 := by
    constructor
    · intro hx
      convert dvd_sub hx hd using 1
      ring
    · intro hy
      convert dvd_add hd hy using 1
      ring
  have he : Ideal.Quotient.mk (Ideal.span {c}) x = Ideal.Quotient.mk (Ideal.span {c}) y :=
    Ideal.Quotient.eq.mpr (Ideal.mem_span_singleton.mpr hc)
  by_cases hx : lambda ^ 2 ∣ x - 1
  · rw [fixedThetaTwist_primary _ x hx, fixedThetaTwist_primary _ y (hp.mp hx),
      symbol_traceLambda_congr_mod_nine x y hx (hp.mp hx) h9]
    change ringComplex (symbol traceLambda y) * Ψ (Ideal.Quotient.mk _ x) =
      ringComplex (symbol traceLambda y) * Ψ (Ideal.Quotient.mk _ y)
    rw [he]
  · simp only [fixedThetaTwist, if_neg hx, if_neg (fun hy => hx (hp.mpr hy))]

/-- The finite residue-class multiplier used to twist the actual residual source. -/
def finiteThetaTwist (c : O) (Ψ : (O ⧸ Ideal.span {c}) →* ℂ)
    (x : O ⧸ Ideal.span {9 * c}) : ℂ :=
  fixedThetaTwist (Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom) (Quotient.out x)

lemma finiteThetaTwist_mk (c : O) (Ψ : (O ⧸ Ideal.span {c}) →* ℂ) (x : O) :
    finiteThetaTwist c Ψ (Ideal.Quotient.mk (Ideal.span {9 * c}) x) =
      fixedThetaTwist (Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom) x := by
  apply fixedThetaTwist_quotient_period
  exact Ideal.mem_span_singleton.mp
    (Ideal.Quotient.eq.mp (Ideal.Quotient.mk_out (Ideal.Quotient.mk (Ideal.span {9 * c}) x)))



/-- Finite additive Fourier coefficients normalized for direct reconstruction. -/
def finiteAdditiveFourierCoeff {R : Type*} [CommRing R] [Fintype R]
    (ψ : AddChar R ℂ) (φ : R → ℂ) (h : R) : ℂ :=
  (∑ x, φ x * ψ (-h * x)) / (Fintype.card R : ℂ)

lemma finiteAdditiveFourier_inversion {R : Type*} [CommRing R] [Fintype R]
    (ψ : AddChar R ℂ) (hψ : ψ.IsPrimitive) (φ : R → ℂ) (x : R) :
    (∑ h, finiteAdditiveFourierCoeff ψ φ h * ψ (h * x)) = φ x := by
  have hN : (Fintype.card R : ℂ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  calc
    _ = (∑ h, ∑ y, φ y * ψ (-h * y) * ψ (h * x)) / (Fintype.card R : ℂ) := by
      simp only [finiteAdditiveFourierCoeff, div_mul_eq_mul_div, Finset.sum_mul, Finset.sum_div]
    _ = (∑ y, φ y * ∑ h, ψ (h * (x - y))) / (Fintype.card R : ℂ) := by
      rw [Finset.sum_comm]
      congr 1
      apply Finset.sum_congr rfl
      intro y hy
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro h hh
      rw [mul_assoc, ← AddChar.map_add_eq_mul]
      congr 2
      ring
    _ = (∑ y, φ y * (if x - y = 0 then (Fintype.card R : ℂ) else 0)) / (Fintype.card R : ℂ) := by
      simp only [AddChar.sum_mulShift _ hψ, apply_ite, Nat.cast_zero]
    _ = φ x := by
      have he : (∑ y, φ y * (if x - y = 0 then (Fintype.card R : ℂ) else 0)) =
          φ x * (Fintype.card R : ℂ) := by simp [sub_eq_zero]
      rw [he, mul_div_cancel_right₀ _ hN]

/-- Every Fourier coefficient is bounded by the mean absolute value of the multiplier. -/
lemma finiteAdditiveFourierCoeff_norm_le {R : Type*} [CommRing R] [Fintype R]
    (ψ : AddChar R ℂ) (φ : R → ℂ) (h : R) :
    ‖finiteAdditiveFourierCoeff ψ φ h‖ ≤ (∑ x, ‖φ x‖) / (Fintype.card R : ℝ) := by
  rw [finiteAdditiveFourierCoeff, norm_div, Complex.norm_natCast]
  apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg _)
  calc
    _ ≤ ∑ x, ‖φ x * ψ (-h * x)‖ := norm_sum_le _ _
    _ = _ := by simp only [norm_mul, AddChar.norm_apply, mul_one]


/-- Conjugation reverses the geometric trace character. -/
lemma star_tracePhase (z : ℂ) : star (tracePhase z) = tracePhase (-z) := by
  change star (Complex.exp (2 * Real.pi * Complex.I * (z + starRingEnd ℂ z))) =
    Complex.exp (2 * Real.pi * Complex.I * (-z + starRingEnd ℂ (-z)))
  rw [Complex.star_def, ← Complex.exp_conj]
  congr 1
  simp only [map_mul, map_add, map_neg, map_ofNat, Complex.conj_ofReal, Complex.conj_I,
    Complex.conj_conj]
  ring

lemma conjugate_cuspCharacterSeries (a : O → ℂ) (z : ℂ) :
    star (cuspCharacterSeries a z) =
      ∑' h : O, star (a h) * tracePhase (-cuspFrequency h * z) := by
  rw [cuspCharacterSeries, tsum_star]
  apply tsum_congr
  intro h
  rw [star_mul, star_tracePhase, neg_mul]
  ring

lemma conjugate_cuspCharacterSeries_summable (a : O → ℂ)
    (ha : Summable (fun h => ‖a h‖)) (z : ℂ) :
    Summable (fun h => star (a h) * tracePhase (-cuspFrequency h * z)) := by
  apply Summable.of_norm
  simpa only [norm_mul, norm_star, tracePhase_norm, mul_one] using ha

/-- A finite translation acts diagonally on the absolutely convergent source Fourier series. -/
theorem conjugate_cuspCharacterSeries_finite_translation {ι : Type*} [Fintype ι]
    (a : O → ℂ) (ha : Summable (fun h => ‖a h‖)) (shift weight : ι → ℂ) (z : ℂ) :
    (∑ i, weight i * star (cuspCharacterSeries a (z + shift i))) =
      ∑' h : O, (∑ i, weight i * tracePhase (-cuspFrequency h * shift i)) *
        star (a h) * tracePhase (-cuspFrequency h * z) := by
  simp only [conjugate_cuspCharacterSeries, ← tsum_mul_left]
  rw [← Summable.tsum_finsetSum (fun i _ =>
    (conjugate_cuspCharacterSeries_summable a ha (z + shift i)).mul_left (weight i))]
  apply tsum_congr
  intro h
  simp only [Finset.sum_mul, mul_add, AddChar.map_add_eq_mul]
  apply Finset.sum_congr rfl
  intro i hi
  ring

/-- These rational translations realize the primitive residue trace character. -/
def thetaFourierTranslation (c : O) (h : O ⧸ Ideal.span {c}) : ℂ :=
  -3 * ringComplex (Quotient.out h) / ringComplex c

lemma thetaFourierTranslation_phase (c : O) (hc : c ≠ 0)
    (h : O ⧸ Ideal.span {c}) (x : O) :
    tracePhase (-cuspFrequency x * thetaFourierTranslation c h) =
      residueTraceQuotientChar 1 c hc (h * Ideal.Quotient.mk _ x) := by
  have hm : h * Ideal.Quotient.mk _ x = Ideal.Quotient.mk _ (Quotient.out h * x) := by
    rw [map_mul, Ideal.Quotient.mk_out]
  rw [hm, residueTraceQuotientChar_mk]
  unfold residueAdditive cuspFrequency thetaFourierTranslation
  simp only [map_mul, map_ofNat, mul_one]
  congr 1
  field_simp

lemma thetaFourierTranslation_inversion (c : O) (hc : c ≠ 0)
    [Fintype (O ⧸ Ideal.span {c})] (φ : (O ⧸ Ideal.span {c}) → ℂ) (x : O) :
    (∑ h, finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 c hc) φ h *
      tracePhase (-cuspFrequency x * thetaFourierTranslation c h)) = φ (Ideal.Quotient.mk _ x) := by
  simp only [thetaFourierTranslation_phase c hc]
  exact finiteAdditiveFourier_inversion _ (residueTraceQuotientChar_primitive c hc) φ _

/-- The actual conjugate residual source twisted by a finite residue-class multiplier. -/
def traceTwistedConjugateSource (c : O) (hc : c ≠ 0) [Fintype (O ⧸ Ideal.span {c})]
    (φ : (O ⧸ Ideal.span {c}) → ℂ) (v : ℝ) (hv : 0 < v) (z : ℂ) : ℂ :=
  ∑ h, finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 c hc) φ h *
    star (cubicSourceResidualFunction (upperPoint (z + thetaFourierTranslation c h) v hv))

/-- Finite Fourier inversion inserts exactly the requested multiplier into every source mode. -/
theorem traceTwistedConjugateSource_fourier (c : O) (hc : c ≠ 0)
    [Fintype (O ⧸ Ideal.span {c})] (φ : (O ⧸ Ideal.span {c}) → ℂ)
    (v : ℝ) (hv : 0 < v) (z : ℂ) :
    traceTwistedConjugateSource c hc φ v hv z =
      ∑' h : O, φ (Ideal.Quotient.mk _ h) * star (rationalSourceModeAmplitude v h) *
        tracePhase (-cuspFrequency h * z) := by
  simp only [traceTwistedConjugateSource, cubicSourceResidualFunction_fourier_expansion]
  rw [conjugate_cuspCharacterSeries_finite_translation _ (rationalSourceModeAmplitude_summable v hv)]
  simp only [thetaFourierTranslation_inversion c hc]

/-- The cubic Bessel kernel is real on the positive axis. -/
lemma star_schlafliBesselK_cubic (x : ℝ) (hx : 0 < x) :
    star (schlafliBesselK (1 / 3) x) = schlafliBesselK (1 / 3) x := by
  have hp := (Complex.ofReal_cpow (show 0 ≤ x / 2 by positivity) (-(1 : ℝ) / 3)).symm
  push_cast at hp
  simp only [neg_div] at hp
  rw [schlafliBesselK, hp, cubicSchlafliIntegral_ofReal]
  simp only [Complex.star_def, map_mul, Complex.conj_ofReal, map_div₀, map_one, map_ofNat]

lemma traceTwistedConjugateSource_bessel (c : O) (hc : c ≠ 0)
    [Fintype (O ⧸ Ideal.span {c})] (φ : (O ⧸ Ideal.span {c}) → ℂ) (hφ : φ 0 = 0)
    (v : ℝ) (hv : 0 < v) :
    traceTwistedConjugateSource c hc φ v hv 0 =
      ∑' h : O, φ (Ideal.Quotient.mk _ h) * star (rationalSourceResidualFourierCoefficient h) *
        (v : ℂ) * schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) := by
  rw [traceTwistedConjugateSource_fourier]
  apply tsum_congr
  intro h
  simp only [mul_zero, AddChar.map_zero_eq_one, mul_one]
  by_cases hh : h = 0
  · subst h
    simp only [map_zero, hφ, zero_mul]
  · rw [rationalSourceModeAmplitude_bessel v hv h hh, star_mul, star_mul,
      star_schlafliBesselK_cubic _ (by
        have hf := norm_pos_iff.mpr (cuspFrequency_ne_zero h hh)
        positivity)]
    simp only [Complex.star_def, Complex.conj_ofReal]
    ring

lemma fixedThetaTwist_zero (Ψ : O →* ℂ) : fixedThetaTwist Ψ 0 = 0 := by
  by_contra hz
  exact primary_ne_zero 0 (fixedThetaTwist_support Ψ 0 hz) rfl

/-- An exact Gauss-series realization by a finite sum of translates of the actual residual source. -/
theorem finiteThetaTwist_source_bessel (c : O) (hc : c ≠ 0)
    [Fintype (O ⧸ Ideal.span {9 * c})] (Ψ : (O ⧸ Ideal.span {c}) →* ℂ)
    (v : ℝ) (hv : 0 < v) :
    rationalSourceThetaScalar⁻¹ *
      traceTwistedConjugateSource (9 * c) (mul_ne_zero (by norm_num) hc) (finiteThetaTwist c Ψ) v hv 0 =
      ∑' p : ({I : Ideal O // Squarefree I ∧ primaryIdealGenerator I ≠ 0} ×
        {J : Ideal O // primaryIdealGenerator J ≠ 0}),
        ((‖ringComplex (primaryIdealGenerator p.2.val)‖ : ℂ) *
          normalizedCubicUnitGauss (primaryIdealGenerator p.1.val) *
          Ψ (Ideal.Quotient.mk _ (primaryIdealGenerator p.1.val)) *
          (Ψ (Ideal.Quotient.mk _ (primaryIdealGenerator p.2.val))) ^ 3) *
          ((v : ℂ) * schlafliBesselK (1 / 3)
            (4 * Real.pi * ‖cuspFrequency (primaryIdealGenerator p.1.val *
              (primaryIdealGenerator p.2.val) ^ 3)‖ * v)) := by
  have hz : finiteThetaTwist c Ψ 0 = 0 := by
    rw [← map_zero (Ideal.Quotient.mk (Ideal.span {9 * c})), finiteThetaTwist_mk, fixedThetaTwist_zero]
  rw [traceTwistedConjugateSource_bessel _ _ _ hz v hv, ← tsum_mul_left]
  calc
    _ = ∑' h : O, (rationalSourceThetaScalar⁻¹ * star (rationalSourceResidualFourierCoefficient h) *
        fixedThetaTwist (Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom) h) *
        ((v : ℂ) * schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v)) := by
      apply tsum_congr
      intro h
      rw [finiteThetaTwist_mk]
      ring
    _ = _ := fixedThetaTwist_source_tsum _ _


def horizontalPhaseMultiplier (freq direction : ℂ) : ℂ :=
  (2 * Real.pi * Complex.I) * (freq * direction + star (freq * direction))

lemma tracePhase_hasDerivAt (freq z direction : ℂ) (t : ℝ) :
    HasDerivAt (fun x : ℝ => tracePhase (freq * (z + (x : ℂ) * direction)))
      (horizontalPhaseMultiplier freq direction * tracePhase (freq * (z + (t : ℂ) * direction))) t := by
  have hz : HasDerivAt (fun x : ℝ => freq * (z + (x : ℂ) * direction)) (freq * direction) t := by
    convert! (((Complex.ofRealCLM.hasDerivAt (x := t)).mul_const direction).const_add z).const_mul freq using 1 <;> norm_num
  have he := ((hz.add hz.star).const_mul (2 * Real.pi * Complex.I)).cexp
  change HasDerivAt (fun x : ℝ => Complex.exp ((2 * Real.pi * Complex.I) *
      (freq * (z + (x : ℂ) * direction) + star (freq * (z + (x : ℂ) * direction)))))
    ((2 * Real.pi * Complex.I) * (freq * direction + star (freq * direction)) *
      Complex.exp ((2 * Real.pi * Complex.I) *
        (freq * (z + (t : ℂ) * direction) + star (freq * (z + (t : ℂ) * direction))))) t
  simpa only [Pi.add_apply, mul_comm] using he

lemma horizontalPhaseMultiplier_norm (freq direction : ℂ) :
    ‖horizontalPhaseMultiplier freq direction‖ ≤ 4 * Real.pi * ‖freq‖ * ‖direction‖ := by
  have hc : ‖(2 * Real.pi * Complex.I : ℂ)‖ = 2 * Real.pi := by
    norm_num [norm_mul, abs_of_pos Real.pi_pos]
  unfold horizontalPhaseMultiplier
  rw [norm_mul, hc]
  calc
    _ ≤ (2 * Real.pi) * (‖freq * direction‖ + ‖star (freq * direction)‖) :=
      mul_le_mul_of_nonneg_left (norm_add_le _ _) (by positivity)
    _ = _ := by rw [norm_star, norm_mul]; ring

lemma horizontalPhaseMultiplier_wirtinger (freq : ℂ) :
    (1 / 2 : ℂ) * (horizontalPhaseMultiplier freq 1 +
      Complex.I * horizontalPhaseMultiplier freq Complex.I) = 2 * Real.pi * Complex.I * star freq := by
  simp only [horizontalPhaseMultiplier, mul_one, star_mul, Complex.star_def, Complex.conj_I]
  ring_nf
  norm_num [Complex.I_sq, Complex.I_pow_three]
  ring

/-- The antiholomorphic derivative expressed through the two real horizontal directions. -/
def horizontalWirtingerBar (f : ℂ → ℂ) (z : ℂ) : ℂ :=
  (1 / 2 : ℂ) * (deriv (fun t : ℝ => f (z + (t : ℂ))) 0 +
    Complex.I * deriv (fun t : ℝ => f (z + (t : ℂ) * Complex.I)) 0)

/-- One summable frequency moment permits termwise horizontal differentiation. -/
theorem traceFourierSeries_hasDerivAt {ι : Type*} (freq a : ι → ℂ)
    (ha : Summable (fun i => ‖a i‖))
    (hfa : Summable (fun i => ‖freq i‖ * ‖a i‖)) (z direction : ℂ) (t : ℝ) :
    HasDerivAt (fun x : ℝ => ∑' i, a i * tracePhase (freq i * (z + (x : ℂ) * direction)))
      (∑' i, horizontalPhaseMultiplier (freq i) direction *
        (a i * tracePhase (freq i * (z + (t : ℂ) * direction)))) t := by
  have hd (i : ι) (x : ℝ) :
      HasDerivAt (fun y : ℝ => a i * tracePhase (freq i * (z + (y : ℂ) * direction)))
        (horizontalPhaseMultiplier (freq i) direction *
          (a i * tracePhase (freq i * (z + (x : ℂ) * direction)))) x := by
    convert! (tracePhase_hasDerivAt (freq i) z direction x).const_mul (a i) using 1
    ring
  have hb (i : ι) (x : ℝ) :
      ‖horizontalPhaseMultiplier (freq i) direction *
        (a i * tracePhase (freq i * (z + (x : ℂ) * direction)))‖ ≤
      (4 * Real.pi * ‖direction‖) * (‖freq i‖ * ‖a i‖) := by
    rw [norm_mul, norm_mul, tracePhase_norm, mul_one]
    calc
      _ ≤ (4 * Real.pi * ‖freq i‖ * ‖direction‖) * ‖a i‖ :=
        mul_le_mul_of_nonneg_right (horizontalPhaseMultiplier_norm _ _) (norm_nonneg _)
      _ = _ := by ring
  have hz : Summable (fun i => a i * tracePhase (freq i * (z + (0 : ℂ) * direction))) := by
    apply Summable.of_norm
    simpa only [norm_mul, tracePhase_norm, mul_one] using ha
  exact hasDerivAt_tsum
    (𝕜 := ℝ)
    (g := fun i (x : ℝ) => a i * tracePhase (freq i * (z + (x : ℂ) * direction)))
    (g' := fun i (x : ℝ) => horizontalPhaseMultiplier (freq i) direction *
      (a i * tracePhase (freq i * (z + (x : ℂ) * direction))))
    (y₀ := 0) (hfa.mul_left (4 * Real.pi * ‖direction‖)) hd hb hz t

lemma traceFourierSeries_directional_summable {ι : Type*} (freq a : ι → ℂ)
    (hfa : Summable (fun i => ‖freq i‖ * ‖a i‖)) (z direction : ℂ) :
    Summable (fun i => horizontalPhaseMultiplier (freq i) direction *
      (a i * tracePhase (freq i * z))) := by
  apply Summable.of_norm
  apply Summable.of_nonneg_of_le (fun _ => norm_nonneg _)
    (fun i => ?_) (hfa.mul_left (4 * Real.pi * ‖direction‖))
  rw [norm_mul, norm_mul, tracePhase_norm, mul_one]
  calc
    _ ≤ (4 * Real.pi * ‖freq i‖ * ‖direction‖) * ‖a i‖ :=
      mul_le_mul_of_nonneg_right (horizontalPhaseMultiplier_norm _ _) (norm_nonneg _)
    _ = _ := by ring

theorem traceFourierSeries_wirtingerBar {ι : Type*} (freq a : ι → ℂ)
    (ha : Summable (fun i => ‖a i‖)) (hfa : Summable (fun i => ‖freq i‖ * ‖a i‖)) (z : ℂ) :
    horizontalWirtingerBar (fun w => ∑' i, a i * tracePhase (freq i * w)) z =
      ∑' i, (2 * Real.pi * Complex.I * star (freq i)) * (a i * tracePhase (freq i * z)) := by
  have h1 := (traceFourierSeries_hasDerivAt freq a ha hfa z 1 0).deriv
  have hI := (traceFourierSeries_hasDerivAt freq a ha hfa z Complex.I 0).deriv
  simp only [mul_one, Complex.ofReal_zero, zero_mul, add_zero] at h1 hI
  rw [horizontalWirtingerBar, h1, hI]
  have hs1 := traceFourierSeries_directional_summable freq a hfa z 1
  have hsI := (traceFourierSeries_directional_summable freq a hfa z Complex.I).mul_left Complex.I
  rw [← tsum_mul_left, ← hs1.tsum_add hsI, ← tsum_mul_left]
  apply tsum_congr
  intro i
  linear_combination (a i * tracePhase (freq i * z)) * horizontalPhaseMultiplier_wirtinger (freq i)


lemma frequency_exp_absorption (a r : ℝ) (ha : 0 < a) :
    r * Real.exp (-a * r) ≤ (2 / a) * Real.exp (-(a / 2) * r) := by
  have he := Real.add_one_le_exp ((a / 2) * r)
  have hr : r ≤ (2 / a) * Real.exp ((a / 2) * r) := by
    rw [div_mul_eq_mul_div]
    apply (le_div_iff₀ ha).mpr
    nlinarith only [he]
  calc
    _ ≤ ((2 / a) * Real.exp ((a / 2) * r)) * Real.exp (-a * r) :=
      mul_le_mul_of_nonneg_right hr (Real.exp_pos _).le
    _ = _ := by rw [mul_assoc, ← Real.exp_add]; congr 2; ring

lemma cuspFrequency_firstMoment_exp_summable (a : ℝ) (ha : 0 < a) :
    Summable (fun h : O => ‖cuspFrequency h‖ * Real.exp (-a * ‖cuspFrequency h‖)) := by
  apply Summable.of_nonneg_of_le (fun _ => mul_nonneg (norm_nonneg _) (Real.exp_pos _).le)
    (fun h => frequency_exp_absorption a _ ha)
  exact (summable_exp_neg_cuspFrequency_norm (a / 2) (half_pos ha)).mul_left (2 / a)

/-- The actual source amplitudes have a summable first frequency moment at every positive height. -/
lemma rationalSourceModeAmplitude_frequency_summable (v : ℝ) (hv : 0 < v) :
    Summable (fun h : O => ‖cuspFrequency h‖ * ‖rationalSourceModeAmplitude v h‖) := by
  obtain ⟨C, hC, hb⟩ := cubicBesselCoefficient_strip_bound rationalSourceResidualFourierCoefficient
    rationalSourceResidualFourierCoefficient_subexponential v v hv le_rfl
  apply Summable.of_nonneg_of_le (fun _ => mul_nonneg (norm_nonneg _) (norm_nonneg _))
    (fun h => ?_)
    ((cuspFrequency_firstMoment_exp_summable (Real.pi * v) (mul_pos Real.pi_pos hv)).mul_left C)
  by_cases hh : h = 0
  · subst h
    simp only [cuspFrequency, map_zero, zero_div, norm_zero, zero_mul, mul_zero, le_refl]
  · rw [rationalSourceModeAmplitude_bessel v hv h hh]
    calc
      _ ≤ ‖cuspFrequency h‖ * (C * Real.exp (-(Real.pi * v) * ‖cuspFrequency h‖)) :=
        mul_le_mul_of_nonneg_left (hb h hh v ⟨le_rfl, le_rfl⟩) (norm_nonneg _)
      _ = _ := by ring

lemma residueMultiplier_source_summable (c : O) [Fintype (O ⧸ Ideal.span {c})]
    (φ : (O ⧸ Ideal.span {c}) → ℂ) (v : ℝ) (hv : 0 < v) :
    Summable (fun h : O => ‖φ (Ideal.Quotient.mk _ h) * star (rationalSourceModeAmplitude v h)‖) ∧
      Summable (fun h : O => ‖-cuspFrequency h‖ *
        ‖φ (Ideal.Quotient.mk _ h) * star (rationalSourceModeAmplitude v h)‖) := by
  let C : ℝ := ∑ x, ‖φ x‖
  have hb (h : O) : ‖φ (Ideal.Quotient.mk _ h)‖ ≤ C :=
    Finset.single_le_sum (fun x _ => norm_nonneg (φ x)) (Finset.mem_univ _)
  constructor
  · apply Summable.of_nonneg_of_le (fun _ => norm_nonneg _)
      (fun h => ?_) ((rationalSourceModeAmplitude_summable v hv).mul_left C)
    rw [norm_mul, norm_star]
    exact mul_le_mul_of_nonneg_right (hb h) (norm_nonneg _)
  · apply Summable.of_nonneg_of_le (fun _ => mul_nonneg (norm_nonneg _) (norm_nonneg _))
      (fun h => ?_) ((rationalSourceModeAmplitude_frequency_summable v hv).mul_left C)
    rw [norm_neg, norm_mul, norm_star]
    calc
      _ ≤ ‖cuspFrequency h‖ * (C * ‖rationalSourceModeAmplitude v h‖) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right (hb h) (norm_nonneg _)) (norm_nonneg _)
      _ = _ := by ring

/-- The horizontal derivative of the actual finite twist is its frequency-weighted Fourier series. -/
theorem traceTwistedConjugateSource_wirtingerBar (c : O) (hc : c ≠ 0)
    [Fintype (O ⧸ Ideal.span {c})] (φ : (O ⧸ Ideal.span {c}) → ℂ)
    (v : ℝ) (hv : 0 < v) (z : ℂ) :
    horizontalWirtingerBar (traceTwistedConjugateSource c hc φ v hv) z =
      ∑' h : O, (-2 * Real.pi * Complex.I * star (cuspFrequency h)) *
        (φ (Ideal.Quotient.mk _ h) * star (rationalSourceModeAmplitude v h) *
          tracePhase (-cuspFrequency h * z)) := by
  have he : traceTwistedConjugateSource c hc φ v hv =
      (fun z : ℂ => ∑' h : O, (φ (Ideal.Quotient.mk _ h) * star (rationalSourceModeAmplitude v h)) *
        tracePhase ((-cuspFrequency h) * z)) :=
    funext (traceTwistedConjugateSource_fourier c hc φ v hv)
  obtain ⟨ha, hfa⟩ := residueMultiplier_source_summable c φ v hv
  rw [he, traceFourierSeries_wirtingerBar _ _ ha hfa z]
  apply tsum_congr
  intro h
  simp only [star_neg]
  ring

lemma traceTwistedConjugateSource_wirtingerBar_zero (c : O) (hc : c ≠ 0)
    [Fintype (O ⧸ Ideal.span {c})] (φ : (O ⧸ Ideal.span {c}) → ℂ)
    (v : ℝ) (hv : 0 < v) :
    horizontalWirtingerBar (traceTwistedConjugateSource c hc φ v hv) 0 =
      ∑' h : O, (-2 * Real.pi * Complex.I * star (cuspFrequency h)) *
        φ (Ideal.Quotient.mk _ h) * star (rationalSourceResidualFourierCoefficient h) *
        (v : ℂ) * schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) := by
  rw [traceTwistedConjugateSource_wirtingerBar]
  apply tsum_congr
  intro h
  simp only [mul_zero, AddChar.map_zero_eq_one, mul_one]
  by_cases hh : h = 0
  · subst h
    simp only [cuspFrequency, map_zero, zero_div, star_zero, mul_zero, zero_mul]
  · rw [rationalSourceModeAmplitude_bessel v hv h hh, star_mul, star_mul,
      star_schlafliBesselK_cubic _ (by
        have hf := norm_pos_iff.mpr (cuspFrequency_ne_zero h hh)
        positivity)]
    simp only [Complex.star_def, Complex.conj_ofReal]
    ring

/-- The frequency-weighted cubic Gauss series is an actual horizontal source derivative. -/
theorem finiteThetaTwist_source_wirtingerBar (c : O) (hc : c ≠ 0)
    [Fintype (O ⧸ Ideal.span {9 * c})] (Ψ : (O ⧸ Ideal.span {c}) →* ℂ)
    (v : ℝ) (hv : 0 < v) :
    rationalSourceThetaScalar⁻¹ * horizontalWirtingerBar
      (traceTwistedConjugateSource (9 * c) (mul_ne_zero (by norm_num) hc) (finiteThetaTwist c Ψ) v hv) 0 =
      ∑' p : ({I : Ideal O // Squarefree I ∧ primaryIdealGenerator I ≠ 0} ×
        {J : Ideal O // primaryIdealGenerator J ≠ 0}),
        ((‖ringComplex (primaryIdealGenerator p.2.val)‖ : ℂ) *
          normalizedCubicUnitGauss (primaryIdealGenerator p.1.val) *
          Ψ (Ideal.Quotient.mk _ (primaryIdealGenerator p.1.val)) *
          (Ψ (Ideal.Quotient.mk _ (primaryIdealGenerator p.2.val))) ^ 3) *
          ((-2 * Real.pi * Complex.I * star (cuspFrequency (primaryIdealGenerator p.1.val *
              (primaryIdealGenerator p.2.val) ^ 3))) * (v : ℂ) * schlafliBesselK (1 / 3)
            (4 * Real.pi * ‖cuspFrequency (primaryIdealGenerator p.1.val *
              (primaryIdealGenerator p.2.val) ^ 3)‖ * v)) := by
  rw [traceTwistedConjugateSource_wirtingerBar_zero, ← tsum_mul_left]
  calc
    _ = ∑' h : O, (rationalSourceThetaScalar⁻¹ * star (rationalSourceResidualFourierCoefficient h) *
        fixedThetaTwist (Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom) h) *
        ((-2 * Real.pi * Complex.I * star (cuspFrequency h)) * (v : ℂ) *
          schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v)) := by
      apply tsum_congr
      intro h
      rw [finiteThetaTwist_mk]
      ring
    _ = _ := fixedThetaTwist_source_tsum _ _

/-- A common Gamma-density majorant for the cubic Schläfli kernel and its derivative. -/
def cubicSchlafliMajorant (t : ℝ) : ℝ := t ^ (-(2 : ℝ) / 3) * Real.exp (-t / 2)

lemma cubicSchlafliMajorant_integrable : IntegrableOn cubicSchlafliMajorant (Ioi 0) := by
  have hh := integrableOn_rpow_mul_exp_neg_mul_rpow
    (s := -(2 : ℝ) / 3) (p := (1 : ℝ)) (b := (1 / 2 : ℝ))
    (by norm_num) (by norm_num) (by norm_num)
  convert! hh using 1
  congr 1
  funext t
  simp only [cubicSchlafliMajorant, Real.rpow_one]
  congr 1
  congr 1
  ring

lemma cubicSchlafliMajorant_integral_nonneg : 0 ≤ ∫ t in Ioi 0, cubicSchlafliMajorant t := by
  apply integral_nonneg_of_ae
  filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
  exact mul_nonneg (Real.rpow_nonneg ht.le _) (Real.exp_pos _).le

def cubicSchlafliDensityDeriv (x t : ℝ) : ℝ := -(x / (2 * t)) * cubicSchlafliDensity x t

lemma cubicSchlafliDensity_hasDerivAt (x t : ℝ) :
    HasDerivAt (fun y : ℝ => cubicSchlafliDensity y t) (cubicSchlafliDensityDeriv x t) x := by
  have he := ((((hasDerivAt_id x).pow 2).div_const (4 * t)).const_sub (-t)).exp.const_mul (t ^ (-(2 : ℝ) / 3))
  simp only [Pi.pow_apply, id_eq, Nat.cast_ofNat, mul_one] at he
  convert! he using 1
  unfold cubicSchlafliDensityDeriv cubicSchlafliDensity
  ring

lemma cubicSchlafliDensityDeriv_bound (δ x t : ℝ) (hδ : 0 < δ) (hx : δ ≤ x) (ht : 0 < t) :
    ‖cubicSchlafliDensityDeriv x t‖ ≤ (4 / δ) * Real.exp (-x / 2) * cubicSchlafliMajorant t := by
  have hxp := hδ.trans_le hx
  have hdamp : (x / (2 * t)) * Real.exp (-(x ^ 2 / (8 * t))) ≤ 4 / x := by
    have hy : (x ^ 2 / (8 * t)) * Real.exp (-(x ^ 2 / (8 * t))) ≤ 1 := by
      have hb : x ^ 2 / (8 * t) ≤ Real.exp (x ^ 2 / (8 * t)) := by
        linarith only [Real.add_one_le_exp (x ^ 2 / (8 * t))]
      calc
        _ ≤ Real.exp (x ^ 2 / (8 * t)) * Real.exp (-(x ^ 2 / (8 * t))) :=
          mul_le_mul_of_nonneg_right hb (Real.exp_pos _).le
        _ = 1 := by rw [← Real.exp_add, add_neg_cancel, Real.exp_zero]
    have hr : x / (2 * t) = (4 / x) * (x ^ 2 / (8 * t)) := by field_simp; ring
    rw [hr, mul_assoc]
    simpa only [mul_one] using mul_le_mul_of_nonneg_left hy (by positivity : 0 ≤ 4 / x)
  have hyoung : x / 2 - t / 2 ≤ x ^ 2 / (8 * t) :=
    (le_div_iff₀ (by positivity : 0 < 8 * t)).mpr (by nlinarith only [sq_nonneg (x - 2 * t)])
  have he : Real.exp (-t - x ^ 2 / (4 * t)) ≤
      Real.exp (-x / 2) * Real.exp (-t / 2) * Real.exp (-(x ^ 2 / (8 * t))) := by
    rw [← Real.exp_add, ← Real.exp_add]
    apply Real.exp_le_exp.mpr
    rw [show x ^ 2 / (4 * t) = 2 * (x ^ 2 / (8 * t)) by ring]
    linarith only [hyoung]
  have hn : ‖cubicSchlafliDensityDeriv x t‖ =
      (x / (2 * t)) * t ^ (-(2 : ℝ) / 3) * Real.exp (-t - x ^ 2 / (4 * t)) := by
    unfold cubicSchlafliDensityDeriv cubicSchlafliDensity
    rw [norm_mul, norm_neg, Real.norm_of_nonneg (by positivity), Real.norm_of_nonneg (by positivity)]
    ring
  rw [hn]
  calc
    _ ≤ (x / (2 * t)) * t ^ (-(2 : ℝ) / 3) *
        (Real.exp (-x / 2) * Real.exp (-t / 2) * Real.exp (-(x ^ 2 / (8 * t)))) :=
      mul_le_mul_of_nonneg_left he (by positivity)
    _ = ((x / (2 * t)) * Real.exp (-(x ^ 2 / (8 * t)))) *
        Real.exp (-x / 2) * cubicSchlafliMajorant t := by unfold cubicSchlafliMajorant; ring
    _ ≤ (4 / x) * Real.exp (-x / 2) * cubicSchlafliMajorant t := by
      exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hdamp (Real.exp_pos _).le)
        (mul_nonneg (Real.rpow_nonneg ht.le _) (Real.exp_pos _).le)
    _ ≤ _ := by
      apply mul_le_mul_of_nonneg_right _ (mul_nonneg (Real.rpow_nonneg ht.le _) (Real.exp_pos _).le)
      exact mul_le_mul_of_nonneg_right (div_le_div_of_nonneg_left (by norm_num) hδ hx) (Real.exp_pos _).le

lemma cubicSchlafliDensityDeriv_integrable (x : ℝ) (hx : 0 < x) :
    IntegrableOn (cubicSchlafliDensityDeriv x) (Ioi 0) := by
  apply (cubicSchlafliMajorant_integrable.const_mul ((4 / x) * Real.exp (-x / 2))).mono'
  · unfold cubicSchlafliDensityDeriv cubicSchlafliDensity
    fun_prop
  · filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    exact cubicSchlafliDensityDeriv_bound x x t hx le_rfl ht

/-- Local domination differentiates the Schläfli integral on the positive axis. -/
lemma cubicSchlafliIntegral_hasDerivAt (x : ℝ) (hx : 0 < x) :
    HasDerivAt (fun y : ℝ => ∫ t in Ioi 0, cubicSchlafliDensity y t)
      (∫ t in Ioi 0, cubicSchlafliDensityDeriv x t) x := by
  have hδ : 0 < x / 2 := half_pos hx
  have hU : Ioi (x / 2) ∈ 𝓝 x := Ioi_mem_nhds (by linarith only [hx])
  have hb : ∀ᵐ t ∂volume.restrict (Ioi (0 : ℝ)), ∀ y ∈ Ioi (x / 2),
      ‖cubicSchlafliDensityDeriv y t‖ ≤ (4 / (x / 2)) * cubicSchlafliMajorant t := by
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    intro y hy
    have hyp := hδ.trans hy
    calc
      _ ≤ (4 / (x / 2)) * Real.exp (-y / 2) * cubicSchlafliMajorant t :=
        cubicSchlafliDensityDeriv_bound _ y t hδ hy.le ht
      _ ≤ _ := by
        have he : Real.exp (-y / 2) ≤ 1 := Real.exp_le_one_iff.mpr (by linarith only [hyp])
        have hg : 0 ≤ cubicSchlafliMajorant t :=
          mul_nonneg (Real.rpow_nonneg ht.le _) (Real.exp_pos _).le
        simpa only [mul_one] using mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_left he (by positivity : 0 ≤ 4 / (x / 2))) hg
  exact (hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := volume.restrict (Ioi (0 : ℝ))) (F := cubicSchlafliDensity) (F' := cubicSchlafliDensityDeriv)
    (bound := fun t => (4 / (x / 2)) * cubicSchlafliMajorant t) hU
    (Eventually.of_forall (fun y => by unfold cubicSchlafliDensity; fun_prop))
    (cubicSchlafliDensity_integrable x)
    (by unfold cubicSchlafliDensityDeriv cubicSchlafliDensity; fun_prop)
    hb (cubicSchlafliMajorant_integrable.const_mul (4 / (x / 2)))
    (Eventually.of_forall (fun t y _ => cubicSchlafliDensity_hasDerivAt y t))).2

lemma schlafliBesselK_one_third_ofReal (x : ℝ) (hx : 0 < x) :
    schlafliBesselK (1 / 3) x =
      (((1 / 2 : ℝ) * (x / 2) ^ (-(1 : ℝ) / 3) * ∫ t in Ioi 0, cubicSchlafliDensity x t : ℝ) : ℂ) := by
  have hp := (Complex.ofReal_cpow (show 0 ≤ x / 2 by positivity) (-(1 : ℝ) / 3)).symm
  push_cast at hp
  simp only [neg_div] at hp
  rw [schlafliBesselK, hp, cubicSchlafliIntegral_ofReal]
  push_cast
  simp only [neg_div]

/-- The explicit derivative of the real cubic Bessel kernel. -/
def cubicBesselRealDeriv (x : ℝ) : ℝ :=
  (-(1 : ℝ) / 12) * (x / 2) ^ (-(4 : ℝ) / 3) * (∫ t in Ioi 0, cubicSchlafliDensity x t) +
    (1 / 2 : ℝ) * (x / 2) ^ (-(1 : ℝ) / 3) * (∫ t in Ioi 0, cubicSchlafliDensityDeriv x t)

lemma schlafliBesselK_cubic_hasDerivAt (x : ℝ) (hx : 0 < x) :
    HasDerivAt (fun y : ℝ => schlafliBesselK (1 / 3) y) (cubicBesselRealDeriv x : ℂ) x := by
  have hp : HasDerivAt (fun y : ℝ => (1 / 2 : ℝ) * (y / 2) ^ (-(1 : ℝ) / 3))
      ((-(1 : ℝ) / 12) * (x / 2) ^ (-(4 : ℝ) / 3)) x := by
    have hh := (((hasDerivAt_id x).div_const 2).rpow_const
      (p := -(1 : ℝ) / 3) (Or.inl (by positivity : x / 2 ≠ 0))).const_mul (1 / 2 : ℝ)
    convert! hh using 1 <;> norm_num
    ring
  have hr := hp.mul (cubicSchlafliIntegral_hasDerivAt x hx)
  have he : HasDerivAt (fun y : ℝ => (1 / 2 : ℝ) * (y / 2) ^ (-(1 : ℝ) / 3) *
      ∫ t in Ioi 0, cubicSchlafliDensity y t) (cubicBesselRealDeriv x) x := hr
  apply he.ofReal_comp.congr_of_eventuallyEq
  filter_upwards [Ioi_mem_nhds hx] with y hy
  exact schlafliBesselK_one_third_ofReal y hy

lemma cubicSchlafliDensity_majorant (x t : ℝ) (ht : 0 < t) :
    cubicSchlafliDensity x t ≤ Real.exp (-x / 2) * cubicSchlafliMajorant t := by
  have hf : x / 2 - t / 2 ≤ x ^ 2 / (4 * t) :=
    (le_div_iff₀ (by positivity : 0 < 4 * t)).mpr
      (by nlinarith only [sq_nonneg (x - t), sq_nonneg t])
  calc
    _ ≤ t ^ (-(2 : ℝ) / 3) * Real.exp (-x / 2 + -t / 2) :=
      mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr (by linarith only [hf]))
        (Real.rpow_nonneg ht.le _)
    _ = _ := by rw [Real.exp_add]; unfold cubicSchlafliMajorant; ring

lemma cubicSchlafliIntegral_norm_upper (x : ℝ) :
    ‖∫ t in Ioi 0, cubicSchlafliDensity x t‖ ≤
      Real.exp (-x / 2) * ∫ t in Ioi 0, cubicSchlafliMajorant t := by
  have hp : 0 ≤ ∫ t in Ioi 0, cubicSchlafliDensity x t := by
    apply integral_nonneg_of_ae
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    exact mul_nonneg (Real.rpow_nonneg ht.le _) (Real.exp_pos _).le
  rw [Real.norm_of_nonneg hp, ← integral_const_mul]
  exact setIntegral_mono_on (cubicSchlafliDensity_integrable x)
    (cubicSchlafliMajorant_integrable.const_mul (Real.exp (-x / 2))) measurableSet_Ioi
    (fun t ht => cubicSchlafliDensity_majorant x t ht)

lemma cubicSchlafliIntegralDeriv_norm_upper (δ x : ℝ) (hδ : 0 < δ) (hx : δ ≤ x) :
    ‖∫ t in Ioi 0, cubicSchlafliDensityDeriv x t‖ ≤
      ((4 / δ) * Real.exp (-x / 2)) * ∫ t in Ioi 0, cubicSchlafliMajorant t := by
  have hi := cubicSchlafliDensityDeriv_integrable x (hδ.trans_le hx)
  have hb := integral_mono_ae hi.norm
    (cubicSchlafliMajorant_integrable.const_mul ((4 / δ) * Real.exp (-x / 2))) (by
      filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
      exact cubicSchlafliDensityDeriv_bound δ x t hδ hx ht)
  rw [integral_const_mul] at hb
  exact (norm_integral_le_integral_norm _).trans hb

/-- The cubic Bessel derivative has uniform exponential decay away from zero. -/
theorem cubicBesselRealDeriv_exp_upper (δ : ℝ) (hδ : 0 < δ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ, δ ≤ x → ‖(cubicBesselRealDeriv x : ℂ)‖ ≤ C * Real.exp (-x / 2) := by
  let A : ℝ := ∫ t in Ioi 0, cubicSchlafliMajorant t
  have hA : 0 ≤ A := cubicSchlafliMajorant_integral_nonneg
  refine ⟨((1 / 12 : ℝ) * (δ / 2) ^ (-(4 : ℝ) / 3) +
    (1 / 2 : ℝ) * (δ / 2) ^ (-(1 : ℝ) / 3) * (4 / δ)) * A, by positivity, ?_⟩
  intro x hx
  have hxp := hδ.trans_le hx
  have hp1 : (x / 2) ^ (-(1 : ℝ) / 3) ≤ (δ / 2) ^ (-(1 : ℝ) / 3) :=
    Real.rpow_le_rpow_of_nonpos (by positivity) (by linarith only [hx]) (by norm_num)
  have hp4 : (x / 2) ^ (-(4 : ℝ) / 3) ≤ (δ / 2) ^ (-(4 : ℝ) / 3) :=
    Real.rpow_le_rpow_of_nonpos (by positivity) (by linarith only [hx]) (by norm_num)
  rw [Complex.norm_real, cubicBesselRealDeriv]
  calc
    _ ≤ ‖(-(1 : ℝ) / 12) * (x / 2) ^ (-(4 : ℝ) / 3) * (∫ t in Ioi 0, cubicSchlafliDensity x t)‖ +
        ‖(1 / 2 : ℝ) * (x / 2) ^ (-(1 : ℝ) / 3) * (∫ t in Ioi 0, cubicSchlafliDensityDeriv x t)‖ := norm_add_le _ _
    _ = (1 / 12 : ℝ) * (x / 2) ^ (-(4 : ℝ) / 3) * ‖∫ t in Ioi 0, cubicSchlafliDensity x t‖ +
        (1 / 2 : ℝ) * (x / 2) ^ (-(1 : ℝ) / 3) * ‖∫ t in Ioi 0, cubicSchlafliDensityDeriv x t‖ := by
      simp only [norm_mul, Real.norm_of_nonneg (Real.rpow_nonneg (by positivity : 0 ≤ x / 2) _)]
      norm_num
    _ ≤ (1 / 12 : ℝ) * (δ / 2) ^ (-(4 : ℝ) / 3) * (Real.exp (-x / 2) * A) +
        (1 / 2 : ℝ) * (δ / 2) ^ (-(1 : ℝ) / 3) * (((4 / δ) * Real.exp (-x / 2)) * A) := by
      apply add_le_add
      · exact mul_le_mul (mul_le_mul_of_nonneg_left hp4 (by norm_num))
          (cubicSchlafliIntegral_norm_upper x) (norm_nonneg _) (by positivity)
      · exact mul_le_mul (mul_le_mul_of_nonneg_left hp1 (by norm_num))
          (cubicSchlafliIntegralDeriv_norm_upper δ x hδ hx) (norm_nonneg _) (by positivity)
    _ = _ := by ring


/-- The real differential of the exponent of a horizontal trace character. -/
def horizontalPhaseCLM (freq : ℂ) : ℂ →L[ℝ] ℂ :=
  (2 * Real.pi * Complex.I : ℂ) •
    (freq • ContinuousLinearMap.id ℝ ℂ +
      (Complex.conjCLE : ℂ →L[ℝ] ℂ).comp (freq • ContinuousLinearMap.id ℝ ℂ))

lemma horizontalPhaseCLM_apply (freq direction : ℂ) :
    horizontalPhaseCLM freq direction =
      (2 * Real.pi * Complex.I) * (freq * direction + star (freq * direction)) := by
  simp only [horizontalPhaseCLM, ContinuousLinearMap.smul_apply, ContinuousLinearMap.add_apply,
    ContinuousLinearMap.id_apply, ContinuousLinearMap.comp_apply, smul_eq_mul]
  rfl

lemma tracePhase_hasFDerivAt (freq z : ℂ) :
    HasFDerivAt (fun w : ℂ => tracePhase (freq * w))
      (tracePhase (freq * z) • horizontalPhaseCLM freq) z := by
  have hh := (horizontalPhaseCLM freq).hasFDerivAt.cexp (x := z)
  convert! hh using 1


/-- The nonconstant Bessel amplitude associated with a Fourier coefficient sequence. -/
def cubicBesselAmplitude (c : O → ℂ) (v : ℝ) (h : O) : ℂ :=
  if h = 0 then 0 else c h * (v : ℂ) *
    schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v)

def cubicBesselAmplitudeDeriv (c : O → ℂ) (v : ℝ) (h : O) : ℂ :=
  if h = 0 then 0 else c h *
    (schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) +
      (v : ℂ) * ((4 * Real.pi * ‖cuspFrequency h‖ : ℝ) : ℂ) *
        (cubicBesselRealDeriv (4 * Real.pi * ‖cuspFrequency h‖ * v) : ℂ))

lemma cubicBesselAmplitude_hasDerivAt (c : O → ℂ) (v : ℝ) (hv : 0 < v) (h : O) :
    HasDerivAt (fun y : ℝ => cubicBesselAmplitude c y h) (cubicBesselAmplitudeDeriv c v h) v := by
  by_cases hh : h = 0
  · simp only [cubicBesselAmplitude, cubicBesselAmplitudeDeriv, if_pos hh]
    exact hasDerivAt_const v 0
  have hr := norm_pos_iff.mpr (cuspFrequency_ne_zero h hh)
  have hslope : HasDerivAt (fun y : ℝ => 4 * Real.pi * ‖cuspFrequency h‖ * y)
      (4 * Real.pi * ‖cuspFrequency h‖) v := by
    simpa only [id_eq, mul_one] using (hasDerivAt_id v).const_mul (4 * Real.pi * ‖cuspFrequency h‖)
  have hk := (schlafliBesselK_cubic_hasDerivAt (4 * Real.pi * ‖cuspFrequency h‖ * v)
    (by positivity)).scomp v hslope
  have he := ((Complex.ofRealCLM.hasDerivAt (x := v)).mul hk).const_mul (c h)
  simp only [cubicBesselAmplitude, cubicBesselAmplitudeDeriv, if_neg hh]
  convert! he using 1 <;>
    simp only [Function.comp_def, Pi.mul_apply, Complex.ofRealCLM_apply, Complex.ofReal_one,
      Complex.real_smul, mul_one, one_mul, mul_assoc]

def cubicBesselTerm (c : O → ℂ) (h : O) (p : ℝ × ℂ) : ℂ :=
  cubicBesselAmplitude c p.1 h * tracePhase (cuspFrequency h * p.2)

def cubicBesselTermFDeriv (c : O → ℂ) (h : O) (p : ℝ × ℂ) : (ℝ × ℂ) →L[ℝ] ℂ :=
  (ContinuousLinearMap.fst ℝ ℝ ℂ).smulRight
    (cubicBesselAmplitudeDeriv c p.1 h * tracePhase (cuspFrequency h * p.2)) +
      cubicBesselTerm c h p • (horizontalPhaseCLM (cuspFrequency h)).comp
        (ContinuousLinearMap.snd ℝ ℝ ℂ)

lemma cubicBesselTerm_hasFDerivAt (c : O → ℂ) (h : O) (p : ℝ × ℂ) (hp : 0 < p.1) :
    HasFDerivAt (cubicBesselTerm c h) (cubicBesselTermFDeriv c h p) p := by
  have hvd := (cubicBesselAmplitude_hasDerivAt c p.1 hp h).hasFDerivAt.comp p
    (hasFDerivAt_fst (𝕜 := ℝ) (p := p))
  have hzd := (tracePhase_hasFDerivAt (cuspFrequency h) p.2).comp p
    (hasFDerivAt_snd (𝕜 := ℝ) (p := p))
  convert! hvd.mul hzd using 1
  apply ContinuousLinearMap.ext
  intro direction
  change (direction.1 : ℂ) * (cubicBesselAmplitudeDeriv c p.1 h * tracePhase (cuspFrequency h * p.2)) +
      cubicBesselTerm c h p * horizontalPhaseCLM (cuspFrequency h) direction.2 =
    cubicBesselAmplitude c p.1 h *
      (tracePhase (cuspFrequency h * p.2) * horizontalPhaseCLM (cuspFrequency h) direction.2) +
      tracePhase (cuspFrequency h * p.2) * ((direction.1 : ℂ) * cubicBesselAmplitudeDeriv c p.1 h)
  unfold cubicBesselTerm
  ring

lemma cubicBesselTerm_strip_bound (c : O → ℂ)
    (hsub : ∀ ε : ℝ, 0 < ε → ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖c h‖ ≤ C * Real.exp (ε * ‖cuspFrequency h‖))
    (a b : ℝ) (ha : 0 < a) (hab : a ≤ b) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, ∀ p : ℝ × ℂ, p.1 ∈ Icc a b →
      ‖cubicBesselTerm c h p‖ ≤ C * Real.exp (-(Real.pi * a) * ‖cuspFrequency h‖) := by
  obtain ⟨C, hC, hb⟩ := cubicBesselCoefficient_strip_bound c hsub a b ha hab
  refine ⟨C, hC, ?_⟩
  intro h p hp
  by_cases hh : h = 0
  · simp only [cubicBesselTerm, cubicBesselAmplitude, if_pos hh, zero_mul, norm_zero]
    positivity
  · simp only [cubicBesselTerm, cubicBesselAmplitude, if_neg hh, norm_mul, tracePhase_norm, mul_one]
    simpa only [norm_mul] using hb h hh p.1 hp

lemma cubicBesselTerm_summable_norm (c : O → ℂ)
    (hsub : ∀ ε : ℝ, 0 < ε → ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖c h‖ ≤ C * Real.exp (ε * ‖cuspFrequency h‖)) (p : ℝ × ℂ) (hp : 0 < p.1) :
    Summable (fun h : O => ‖cubicBesselTerm c h p‖) := by
  obtain ⟨C, hC, hb⟩ := cubicBesselTerm_strip_bound c hsub p.1 p.1 hp le_rfl
  exact Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun h => hb h p ⟨le_rfl, le_rfl⟩)
    ((summable_exp_neg_cuspFrequency_norm (Real.pi * p.1) (mul_pos Real.pi_pos hp)).mul_left C)

/-- The frequency gap converts Bessel and Bessel-derivative decay into a common summable scale. -/
lemma cubicBesselCoefficient_weighted_bounds (c : O → ℂ)
    (hsub : ∀ ε : ℝ, 0 < ε → ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖c h‖ ≤ C * Real.exp (ε * ‖cuspFrequency h‖)) (a : ℝ) (ha : 0 < a) :
    ∃ A B : ℝ, 0 ≤ A ∧ 0 ≤ B ∧ ∀ h : O, h ≠ 0 → ∀ v : ℝ, a ≤ v →
      ‖c h‖ * ‖schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v)‖ ≤
        A * Real.exp (-(Real.pi * a) * ‖cuspFrequency h‖) ∧
      ‖c h‖ * ‖(cubicBesselRealDeriv (4 * Real.pi * ‖cuspFrequency h‖ * v) : ℂ)‖ ≤
        B * Real.exp (-(Real.pi * a) * ‖cuspFrequency h‖) := by
  have hd : 0 < ‖(3 : ℂ) * ringComplex traceLambda‖ := norm_pos_iff.mpr
    (mul_ne_zero (by norm_num) (ringComplex_ne_zero traceLambda_ne_zero))
  let δ : ℝ := 4 * Real.pi * a * ‖(3 : ℂ) * ringComplex traceLambda‖⁻¹
  have hδ : 0 < δ := by dsimp [δ]; positivity
  obtain ⟨U, hU, hu⟩ := schlafliBesselK_one_third_exp_upper δ hδ
  obtain ⟨D, hD, hd⟩ := cubicBesselRealDeriv_exp_upper δ hδ
  obtain ⟨C, hC, hc⟩ := hsub (Real.pi * a) (mul_pos Real.pi_pos ha)
  refine ⟨C * U, C * D, mul_nonneg hC hU, mul_nonneg hC hD, ?_⟩
  intro h hh v hv
  have hx : δ ≤ 4 * Real.pi * ‖cuspFrequency h‖ * v := by
    have hm := mul_le_mul (cuspFrequency_norm_lower h hh) hv ha.le (norm_nonneg _)
    have hm' := mul_le_mul_of_nonneg_left hm (by positivity : 0 ≤ 4 * Real.pi)
    dsimp [δ]
    nlinarith only [hm']
  have hcombine (y E : ℝ) (hy : 0 ≤ y) (hE : 0 ≤ E)
      (he : y ≤ E * Real.exp (-(4 * Real.pi * ‖cuspFrequency h‖ * v) / 2)) :
      ‖c h‖ * y ≤ (C * E) * Real.exp (-(Real.pi * a) * ‖cuspFrequency h‖) := by
    calc
      _ ≤ (C * Real.exp ((Real.pi * a) * ‖cuspFrequency h‖)) *
          (E * Real.exp (-(4 * Real.pi * ‖cuspFrequency h‖ * v) / 2)) :=
        mul_le_mul (hc h hh) he hy (by positivity)
      _ = (C * E) * Real.exp ((Real.pi * a) * ‖cuspFrequency h‖ +
          -(4 * Real.pi * ‖cuspFrequency h‖ * v) / 2) := by rw [Real.exp_add]; ring
      _ ≤ _ := by
        apply mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr ?_) (mul_nonneg hC hE)
        have hm := mul_le_mul_of_nonneg_left hv (by positivity : 0 ≤ 2 * Real.pi * ‖cuspFrequency h‖)
        nlinarith only [hm]
  exact ⟨hcombine _ _ (norm_nonneg _) hU (hu _ hx), hcombine _ _ (norm_nonneg _) hD (hd _ hx)⟩

lemma cubicBesselAmplitudeDeriv_norm_le (c : O → ℂ) (v : ℝ) (hv : 0 < v) (h : O) (hh : h ≠ 0) :
    ‖cubicBesselAmplitudeDeriv c v h‖ ≤
      ‖c h‖ * ‖schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v)‖ +
      (v * (4 * Real.pi * ‖cuspFrequency h‖)) *
        (‖c h‖ * ‖(cubicBesselRealDeriv (4 * Real.pi * ‖cuspFrequency h‖ * v) : ℂ)‖) := by
  rw [cubicBesselAmplitudeDeriv, if_neg hh, norm_mul]
  calc
    _ ≤ ‖c h‖ * (‖schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v)‖ +
        ‖(v : ℂ) * ((4 * Real.pi * ‖cuspFrequency h‖ : ℝ) : ℂ) *
          (cubicBesselRealDeriv (4 * Real.pi * ‖cuspFrequency h‖ * v) : ℂ)‖) :=
      mul_le_mul_of_nonneg_left (norm_add_le _ _) (norm_nonneg _)
    _ = _ := by
      rw [norm_mul, norm_mul, Complex.norm_of_nonneg hv.le,
        Complex.norm_of_nonneg (by positivity : 0 ≤ 4 * Real.pi * ‖cuspFrequency h‖)]
      ring

lemma cubicBesselTermFDeriv_norm_le (c : O → ℂ) (h : O) (p : ℝ × ℂ) :
    ‖cubicBesselTermFDeriv c h p‖ ≤ ‖cubicBesselAmplitudeDeriv c p.1 h‖ +
      ‖cubicBesselTerm c h p‖ * (4 * Real.pi * ‖cuspFrequency h‖) := by
  apply ContinuousLinearMap.opNorm_le_bound _ (by positivity)
  intro direction
  change ‖(direction.1 : ℂ) * (cubicBesselAmplitudeDeriv c p.1 h * tracePhase (cuspFrequency h * p.2)) +
    cubicBesselTerm c h p * horizontalPhaseCLM (cuspFrequency h) direction.2‖ ≤ _
  calc
    _ ≤ ‖(direction.1 : ℂ) * (cubicBesselAmplitudeDeriv c p.1 h * tracePhase (cuspFrequency h * p.2))‖ +
        ‖cubicBesselTerm c h p * horizontalPhaseCLM (cuspFrequency h) direction.2‖ := norm_add_le _ _
    _ = ‖direction.1‖ * ‖cubicBesselAmplitudeDeriv c p.1 h‖ +
        ‖cubicBesselTerm c h p‖ * ‖horizontalPhaseMultiplier (cuspFrequency h) direction.2‖ := by
      rw [norm_mul, norm_mul, Complex.norm_real, tracePhase_norm, mul_one, norm_mul, horizontalPhaseCLM_apply]
      rfl
    _ ≤ ‖direction‖ * ‖cubicBesselAmplitudeDeriv c p.1 h‖ +
        ‖cubicBesselTerm c h p‖ * ((4 * Real.pi * ‖cuspFrequency h‖) * ‖direction‖) := by
      apply add_le_add
      · exact mul_le_mul_of_nonneg_right (norm_fst_le direction) (norm_nonneg _)
      · apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
        exact (horizontalPhaseMultiplier_norm _ _).trans
          (mul_le_mul_of_nonneg_left (norm_snd_le direction) (by positivity))
    _ = _ := by ring

lemma cubicBesselTermFDeriv_strip_bound (c : O → ℂ)
    (hsub : ∀ ε : ℝ, 0 < ε → ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖c h‖ ≤ C * Real.exp (ε * ‖cuspFrequency h‖))
    (a b : ℝ) (ha : 0 < a) (hab : a ≤ b) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, ∀ p : ℝ × ℂ, p.1 ∈ Icc a b →
      ‖cubicBesselTermFDeriv c h p‖ ≤ C * ((1 + ‖cuspFrequency h‖) *
        Real.exp (-(Real.pi * a) * ‖cuspFrequency h‖)) := by
  obtain ⟨A, B, hA, hB, hweighted⟩ := cubicBesselCoefficient_weighted_bounds c hsub a ha
  obtain ⟨T, hT, ht⟩ := cubicBesselTerm_strip_bound c hsub a b ha hab
  let D := B * b * (4 * Real.pi) + T * (4 * Real.pi)
  have hb := ha.trans_le hab
  have hD : 0 ≤ D := by dsimp [D]; positivity
  refine ⟨A + D, add_nonneg hA hD, ?_⟩
  intro h p hp
  by_cases hh : h = 0
  · have hz : cubicBesselTermFDeriv c h p = 0 := by
      subst h
      apply ContinuousLinearMap.ext
      intro direction
      simp [cubicBesselTermFDeriv, cubicBesselAmplitudeDeriv, cubicBesselTerm, cubicBesselAmplitude]
    rw [hz, norm_zero]
    positivity
  have hv := ha.trans_le hp.1
  obtain ⟨hKu, hKd⟩ := hweighted h hh p.1 hp.1
  have hamp : ‖cubicBesselAmplitudeDeriv c p.1 h‖ ≤
      A * Real.exp (-(Real.pi * a) * ‖cuspFrequency h‖) +
      (b * (4 * Real.pi * ‖cuspFrequency h‖)) *
        (B * Real.exp (-(Real.pi * a) * ‖cuspFrequency h‖)) := by
    apply (cubicBesselAmplitudeDeriv_norm_le c p.1 hv h hh).trans
    apply add_le_add hKu
    exact mul_le_mul (mul_le_mul_of_nonneg_right hp.2 (by positivity)) hKd
      (mul_nonneg (norm_nonneg _) (norm_nonneg _)) (by positivity)
  calc
    _ ≤ ‖cubicBesselAmplitudeDeriv c p.1 h‖ + ‖cubicBesselTerm c h p‖ *
        (4 * Real.pi * ‖cuspFrequency h‖) := cubicBesselTermFDeriv_norm_le c h p
    _ ≤ (A * Real.exp (-(Real.pi * a) * ‖cuspFrequency h‖) +
        (b * (4 * Real.pi * ‖cuspFrequency h‖)) * (B * Real.exp (-(Real.pi * a) * ‖cuspFrequency h‖))) +
        (T * Real.exp (-(Real.pi * a) * ‖cuspFrequency h‖)) * (4 * Real.pi * ‖cuspFrequency h‖) :=
      add_le_add hamp (mul_le_mul_of_nonneg_right (ht h p hp) (by positivity))
    _ = (A + D * ‖cuspFrequency h‖) * Real.exp (-(Real.pi * a) * ‖cuspFrequency h‖) := by dsimp [D]; ring
    _ ≤ _ := by
      rw [← mul_assoc]
      apply mul_le_mul_of_nonneg_right _ (Real.exp_pos _).le
      nlinarith only [mul_nonneg hA (norm_nonneg (cuspFrequency h)), hD]

/-- Local uniform derivative bounds give joint differentiability in height and horizontal position. -/
theorem cubicBesselSeries_hasFDerivAt (c : O → ℂ)
    (hsub : ∀ ε : ℝ, 0 < ε → ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖c h‖ ≤ C * Real.exp (ε * ‖cuspFrequency h‖)) (p : ℝ × ℂ) (hp : 0 < p.1) :
    HasFDerivAt (fun q : ℝ × ℂ => ∑' h : O, cubicBesselTerm c h q)
      (∑' h : O, cubicBesselTermFDeriv c h p) p := by
  have ha : 0 < p.1 / 2 := half_pos hp
  have hab : p.1 / 2 ≤ 2 * p.1 := by linarith only [hp]
  obtain ⟨C, hC, hb⟩ := cubicBesselTermFDeriv_strip_bound c hsub _ _ ha hab
  have hs : Summable (fun h : O => (1 + ‖cuspFrequency h‖) *
      Real.exp (-(Real.pi * (p.1 / 2)) * ‖cuspFrequency h‖)) := by
    simpa only [add_mul, one_mul] using
      (summable_exp_neg_cuspFrequency_norm (Real.pi * (p.1 / 2)) (mul_pos Real.pi_pos ha)).add
        (cuspFrequency_firstMoment_exp_summable (Real.pi * (p.1 / 2)) (mul_pos Real.pi_pos ha))
  have hmem : p ∈ Ioo (p.1 / 2) (2 * p.1) ×ˢ (univ : Set ℂ) :=
    ⟨⟨by linarith only [hp], by linarith only [hp]⟩, mem_univ _⟩
  exact hasFDerivAt_tsum_of_isPreconnected
    (f := cubicBesselTerm c) (f' := cubicBesselTermFDeriv c)
    (hs.mul_left C) (isOpen_Ioo.prod isOpen_univ) (isPreconnected_Ioo.prod isPreconnected_univ)
    (fun h q hq => cubicBesselTerm_hasFDerivAt c h q (ha.trans hq.1.1))
    (fun h q hq => hb h q ⟨hq.1.1.le, hq.1.2.le⟩) hmem
    (cubicBesselTerm_summable_norm c hsub p hp).of_norm hmem


lemma positiveHeight_cpow_hasDerivAt (s : ℂ) (x : ℝ) (hx : 0 < x) :
    HasDerivAt (fun y : ℝ => (y : ℂ) ^ s) (s * (x : ℂ) ^ (s - 1)) x := by
  have he := (hasDerivAt_id' (x := (x : ℂ))).cpow_const (c := s)
    (Complex.ofReal_mem_slitPlane.mpr hx)
  simpa using he.comp_ofReal


/-- In positive cusp coordinates the actual residual source is its constant mode plus the Bessel series. -/
theorem cubicSourceResidualFunction_bessel_coordinates (p : ℝ × ℂ) (hp : 0 < p.1) :
    cubicSourceResidualFunction (cuspCoordinateLift p) =
      (3 * (Real.pi : ℂ) * constantArithmeticResidue) * (p.1 : ℂ) ^ (2 / 3 : ℂ) +
        ∑' h : O, cubicBesselTerm rationalSourceResidualFourierCoefficient h p := by
  have hs := (cubicBesselTerm_summable_norm rationalSourceResidualFourierCoefficient
    rationalSourceResidualFourierCoefficient_subexponential p hp).of_norm
  have hz : Summable (fun h : O => if h = 0 then rationalSourceModeAmplitude p.1 0 else 0) :=
    (hasSum_ite_eq 0 _).summable
  have hsplit (h : O) : rationalSourceModeAmplitude p.1 h * tracePhase (cuspFrequency h * p.2) =
      (if h = 0 then rationalSourceModeAmplitude p.1 0 else 0) +
        cubicBesselTerm rationalSourceResidualFourierCoefficient h p := by
    by_cases hh : h = 0
    · subst h
      simp only [cubicBesselTerm, cubicBesselAmplitude, if_true, zero_mul, add_zero,
        cuspFrequency, map_zero, zero_div, AddChar.map_zero_eq_one, mul_one]
    · rw [rationalSourceModeAmplitude_bessel p.1 hp h hh]
      simp only [cubicBesselTerm, cubicBesselAmplitude, if_neg hh, zero_add]
  rw [show cuspCoordinateLift p = upperPoint p.2 p.1 hp from cuspCoordinateLift_positive _ _ hp,
    cubicSourceResidualFunction_fourier_expansion, cuspCharacterSeries]
  simp_rw [hsplit]
  rw [hz.tsum_add hs, tsum_ite_eq, rationalSourceModeAmplitude_zero]

/-- The actual residual source is jointly differentiable in height and horizontal position. -/
theorem cubicSourceResidualFunction_coordinate_differentiableAt (p : ℝ × ℂ) (hp : 0 < p.1) :
    DifferentiableAt ℝ (fun q : ℝ × ℂ => cubicSourceResidualFunction (cuspCoordinateLift q)) p := by
  have hs := (cubicBesselSeries_hasFDerivAt rationalSourceResidualFourierCoefficient
    rationalSourceResidualFourierCoefficient_subexponential p hp).differentiableAt
  have hc : DifferentiableAt ℝ (fun q : ℝ × ℂ =>
      (3 * (Real.pi : ℂ) * constantArithmeticResidue) * (q.1 : ℂ) ^ (2 / 3 : ℂ)) p := by
    exact ((positiveHeight_cpow_hasDerivAt (2 / 3) p.1 hp).differentiableAt.comp p
      differentiableAt_fst).const_mul _
  apply (hc.add hs).congr_of_eventuallyEq
  filter_upwards [continuousAt_fst.tendsto.eventually (Ioi_mem_nhds hp)] with q hq
  exact cubicSourceResidualFunction_bessel_coordinates q hq

/-- The positive denominator of the hyperbolic Möbius action in cusp coordinates. -/
def mobiusCoordinateDenominator (g : SL(2, ℂ)) (p : ℝ × ℂ) : ℝ :=
  Complex.normSq (g 1 0 * p.2 + g 1 1) + Complex.normSq (g 1 0) * p.1 ^ 2

lemma mobiusCoordinateDenominator_pos (g : SL(2, ℂ)) (p : ℝ × ℂ) (hp : 0 < p.1) :
    0 < mobiusCoordinateDenominator g p := by
  simpa only [mobiusCoordinateDenominator, Complex.normSq_eq_norm_sq] using
    mobius_denominator_pos g p.2 p.1 hp

/-- Height and horizontal position under the hyperbolic Möbius action. -/
def mobiusCoordinates (g : SL(2, ℂ)) (p : ℝ × ℂ) : ℝ × ℂ :=
  (p.1 / mobiusCoordinateDenominator g p,
    ((g 0 0 * p.2 + g 0 1) * star (g 1 0 * p.2 + g 1 1) +
      g 0 0 * star (g 1 0) * (p.1 : ℂ) ^ 2) / (mobiusCoordinateDenominator g p : ℂ))

lemma mobiusCoordinates_height_pos (g : SL(2, ℂ)) (p : ℝ × ℂ) (hp : 0 < p.1) :
    0 < (mobiusCoordinates g p).1 := div_pos hp (mobiusCoordinateDenominator_pos g p hp)

lemma mobiusCoordinates_differentiableAt (g : SL(2, ℂ)) (p : ℝ × ℂ) (hp : 0 < p.1) :
    DifferentiableAt ℝ (mobiusCoordinates g) p := by
  have hd := (mobiusCoordinateDenominator_pos g p hp).ne'
  have hden : DifferentiableAt ℝ (mobiusCoordinateDenominator g) p := by
    unfold mobiusCoordinateDenominator
    simp only [Complex.normSq_apply]
    fun_prop
  have hinv := (hasDerivAt_inv hd).differentiableAt.comp p hden
  have hheight : DifferentiableAt ℝ (fun q : ℝ × ℂ => q.1 / mobiusCoordinateDenominator g q) p := by
    convert! (differentiableAt_fst (𝕜 := ℝ)).mul hinv using 1 <;>
      simp only [div_eq_mul_inv, Pi.mul_apply, Function.comp_def]
  have hnum : DifferentiableAt ℝ (fun q : ℝ × ℂ =>
    (g 0 0 * q.2 + g 0 1) * star (g 1 0 * q.2 + g 1 1) +
      g 0 0 * star (g 1 0) * (q.1 : ℂ) ^ 2) p := by fun_prop
  apply hheight.prodMk
  convert! hnum.mul (Complex.ofRealCLM.differentiableAt.comp p hinv) using 1 <;>
    simp only [Complex.ofReal_inv, div_eq_mul_inv, Pi.mul_apply, Function.comp_def,
      Complex.ofRealCLM_apply] <;> rfl

lemma mobiusCoordinates_lift (g : SL(2, ℂ)) (p : ℝ × ℂ) (hp : 0 < p.1) :
    cuspCoordinateLift (mobiusCoordinates g p) = g • cuspCoordinateLift p := by
  rw [show cuspCoordinateLift p = upperPoint p.2 p.1 hp from cuspCoordinateLift_positive _ _ hp,
    show cuspCoordinateLift (mobiusCoordinates g p) =
      upperPoint (mobiusCoordinates g p).2 (mobiusCoordinates g p).1
        (mobiusCoordinates_height_pos g p hp) from cuspCoordinateLift_positive _ _ _,
    mobius_upperPoint]
  apply upperPoint_congr
  · simp only [mobiusCoordinates, mobiusCoordinateDenominator, Complex.normSq_eq_norm_sq]
  · simp only [mobiusCoordinates, mobiusCoordinateDenominator, Complex.normSq_eq_norm_sq]

/-- Every fixed cusp translate of the actual source is jointly differentiable. -/
theorem cubicSourceResidualFunction_translate_coordinate_differentiableAt
    (g : SL(2, ℂ)) (p : ℝ × ℂ) (hp : 0 < p.1) :
    DifferentiableAt ℝ (fun q : ℝ × ℂ => cubicSourceResidualFunction (g • cuspCoordinateLift q)) p := by
  have hd := (cubicSourceResidualFunction_coordinate_differentiableAt (mobiusCoordinates g p)
    (mobiusCoordinates_height_pos g p hp)).comp p (mobiusCoordinates_differentiableAt g p hp)
  apply hd.congr_of_eventuallyEq
  filter_upwards [continuousAt_fst.tendsto.eventually (Ioi_mem_nhds hp)] with q hq
  exact congrArg cubicSourceResidualFunction (mobiusCoordinates_lift g q hq).symm

/-- Inverse cusp coordinates centered at the image of infinity. -/
def inverseCuspCoordinates (c d : ℂ) (v : ℝ) (z : ℂ) : ℝ × ℂ :=
  (v / (‖c‖ ^ 2 * (v ^ 2 + ‖z‖ ^ 2)),
    -d / c - star z / (c ^ 2 * ((v ^ 2 + ‖z‖ ^ 2 : ℝ) : ℂ)))

lemma inverseCuspCoordinates_height_pos (c d : ℂ) (v : ℝ) (z : ℂ)
    (hc : c ≠ 0) (hv : 0 < v) : 0 < (inverseCuspCoordinates c d v z).1 := by
  dsimp [inverseCuspCoordinates]
  positivity

def inverseCuspPath (c d : ℂ) (v : ℝ) (direction : ℂ) (t : ℝ) : ℝ × ℂ :=
  (v / (‖c‖ ^ 2 * (v ^ 2 + t ^ 2 * ‖direction‖ ^ 2)),
    -d / c - (t : ℂ) * star direction / (c ^ 2 * ((v ^ 2 + t ^ 2 * ‖direction‖ ^ 2 : ℝ) : ℂ)))

lemma inverseCuspCoordinates_line (c d : ℂ) (v : ℝ) (direction : ℂ) (t : ℝ) :
    inverseCuspCoordinates c d v ((t : ℂ) * direction) = inverseCuspPath c d v direction t := by
  simp only [inverseCuspCoordinates, inverseCuspPath, star_mul, Complex.star_def,
    Complex.conj_ofReal, norm_mul, Complex.norm_real, Real.norm_eq_abs, mul_pow, sq_abs, mul_comm]

lemma inverseCuspPath_zero (c d : ℂ) (v : ℝ) (direction : ℂ) (hc : c ≠ 0) (hv : 0 < v) :
    inverseCuspPath c d v direction 0 = (1 / (‖c‖ ^ 2 * v), -d / c) := by
  unfold inverseCuspPath
  simp only [Complex.ofReal_zero, zero_pow (by decide : (2 : ℕ) ≠ 0), zero_mul, add_zero, zero_div, sub_zero]
  congr 1
  field_simp [norm_ne_zero_iff.mpr hc, hv.ne']

/-- At the cusp center the vertical derivative vanishes and the horizontal derivative is conjugate-linear. -/
lemma inverseCuspPath_hasDerivAt (c d : ℂ) (v : ℝ) (direction : ℂ) (hc : c ≠ 0) (hv : 0 < v) :
    HasDerivAt (inverseCuspPath c d v direction) (0, -(star direction) / (c ^ 2 * (v : ℂ) ^ 2)) 0 := by
  have hn : ‖c‖ ≠ 0 := norm_ne_zero_iff.mpr hc
  have hvc : (v : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hv.ne'
  have hden : HasDerivAt (fun t : ℝ => v ^ 2 + t ^ 2 * ‖direction‖ ^ 2) 0 0 := by
    convert! (((hasDerivAt_id (0 : ℝ)).pow 2).mul_const (‖direction‖ ^ 2)).const_add (v ^ 2) using 1 <;> norm_num
  have hnum : HasDerivAt (fun t : ℝ => (t : ℂ) * star direction) (star direction) 0 := by
    simpa using (hasDerivAt_id (0 : ℝ)).ofReal_comp.mul_const (star direction)
  have hdenC := hden.ofReal_comp.const_mul (c ^ 2)
  have hdenR := hden.const_mul (‖c‖ ^ 2)
  have hcz : c ^ 2 * ((v ^ 2 + (0 : ℝ) ^ 2 * ‖direction‖ ^ 2 : ℝ) : ℂ) ≠ 0 := by
    simpa using mul_ne_zero (pow_ne_zero 2 hc) (pow_ne_zero 2 hvc)
  have hrz : ‖c‖ ^ 2 * (v ^ 2 + (0 : ℝ) ^ 2 * ‖direction‖ ^ 2) ≠ 0 := by positivity
  have hz : HasDerivAt (fun t : ℝ => -d / c - (t : ℂ) * star direction /
      (c ^ 2 * ((v ^ 2 + t ^ 2 * ‖direction‖ ^ 2 : ℝ) : ℂ)))
      (-(star direction) / (c ^ 2 * (v : ℂ) ^ 2)) 0 := by
    convert! (hnum.div hdenC hcz).const_sub (-d / c) using 1
    simp only [zero_pow (by decide : (2 : ℕ) ≠ 0), zero_mul, add_zero, Complex.ofReal_pow,
      Complex.ofReal_zero, mul_zero, sub_zero]
    field_simp
  have hy : HasDerivAt (fun t : ℝ => v / (‖c‖ ^ 2 * (v ^ 2 + t ^ 2 * ‖direction‖ ^ 2))) 0 0 := by
    convert! (hasDerivAt_const (0 : ℝ) v).div hdenR hrz using 1 <;> simp
  exact hy.prodMk hz

lemma inverseCuspPath_comp_hasDerivAt (c d : ℂ) (v : ℝ) (direction : ℂ) (hc : c ≠ 0) (hv : 0 < v)
    (F : ℝ × ℂ → ℂ) (A : (ℝ × ℂ) →L[ℝ] ℂ)
    (hF : HasFDerivAt F A (1 / (‖c‖ ^ 2 * v), -d / c)) :
    HasDerivAt (fun t => F (inverseCuspPath c d v direction t))
      (A (0, -(star direction) / (c ^ 2 * (v : ℂ) ^ 2))) 0 := by
  have hf : HasFDerivAt F A (inverseCuspPath c d v direction 0) := by
    rwa [inverseCuspPath_zero c d v direction hc hv]
  exact hf.comp_hasDerivAt 0 (inverseCuspPath_hasDerivAt c d v direction hc hv)

/-- The inverse hyperbolic action has the centered cusp-coordinate formula. -/
theorem inverse_cusp_action (g : SL(2, ℂ)) (hc : g 1 0 ≠ 0) (v : ℝ) (hv : 0 < v) (z : ℂ) :
    g⁻¹ • upperPoint (z + g 0 0 / g 1 0) v hv =
      upperPoint (inverseCuspCoordinates (g 1 0) (g 1 1) v z).2
        (inverseCuspCoordinates (g 1 0) (g 1 1) v z).1
        (inverseCuspCoordinates_height_pos _ _ _ _ hc hv) := by
  have hdet : g 0 0 * g 1 1 - g 0 1 * g 1 0 = 1 := by
    simpa only [Matrix.det_fin_two] using g.property
  have h00 : (g⁻¹) 0 0 = g 1 1 := by simp [Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]
  have h01 : (g⁻¹) 0 1 = -g 0 1 := by simp [Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]
  have h10 : (g⁻¹) 1 0 = -g 1 0 := by simp [Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]
  have h11 : (g⁻¹) 1 1 = g 0 0 := by simp [Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]
  have hl : (-g 1 0) * (z + g 0 0 / g 1 0) + g 0 0 = -(g 1 0 * z) := by field_simp; ring
  have ht : g 1 1 * (z + g 0 0 / g 1 0) + (-g 0 1) = g 1 1 * z + 1 / g 1 0 := by
    field_simp
    linear_combination hdet
  have hden : ‖-(g 1 0 * z)‖ ^ 2 + ‖-g 1 0‖ ^ 2 * v ^ 2 =
      ‖g 1 0‖ ^ 2 * (v ^ 2 + ‖z‖ ^ 2) := by rw [norm_neg, norm_neg, norm_mul, mul_pow]; ring
  have hnormc : ((‖g 1 0‖ ^ 2 : ℝ) : ℂ) = g 1 0 * star (g 1 0) := by
    simpa only [Complex.normSq_eq_norm_sq, Complex.star_def] using (Complex.mul_conj (g 1 0)).symm
  have hnormz : ((‖z‖ ^ 2 : ℝ) : ℂ) = z * star z := by
    simpa only [Complex.normSq_eq_norm_sq, Complex.star_def] using (Complex.mul_conj z).symm
  have hT : v ^ 2 + ‖z‖ ^ 2 ≠ 0 := by positivity
  have hTc : ((v ^ 2 + ‖z‖ ^ 2 : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hT
  have hcc : star (g 1 0) ≠ 0 := star_ne_zero.mpr hc
  rw [mobius_upperPoint]
  apply upperPoint_congr
  · rw [h00, h01, h10, h11, hl, ht, hden]
    dsimp [inverseCuspCoordinates]
    rw [Complex.ofReal_mul, hnormc]
    simp only [Complex.star_def, map_neg, map_mul]
    simp only [Complex.star_def] at hcc
    field_simp [hc, hcc, hTc]
    rw [Complex.ofReal_add, Complex.ofReal_pow, hnormz]
    simp only [Complex.star_def]
    ring
  · rw [h10, h11, hl, hden]
    rfl

def horizontalWirtingerZ (f : ℂ → ℂ) (z : ℂ) : ℂ :=
  (1 / 2 : ℂ) * (deriv (fun t : ℝ => f (z + (t : ℂ))) 0 -
    Complex.I * deriv (fun t : ℝ => f (z + (t : ℂ) * Complex.I)) 0)

lemma real_linear_horizontal_decompose (A : (ℝ × ℂ) →L[ℝ] ℂ) (z : ℂ) :
    A (0, z) = (z.re : ℂ) * A (0, 1) + (z.im : ℂ) * A (0, Complex.I) := by
  have hz : ((0, z) : ℝ × ℂ) = z.re • (0, 1) + z.im • (0, Complex.I) := by
    apply Prod.ext
    · simp
    · simpa only [Prod.snd_add, Prod.smul_snd, Complex.real_smul, mul_one] using z.re_add_im.symm
  rw [hz, map_add, map_smul, map_smul]
  simp only [Complex.real_smul]

lemma real_linear_wirtinger_swap (A : (ℝ × ℂ) →L[ℝ] ℂ) (k : ℂ) :
    (1 / 2 : ℂ) * (A (0, k) + Complex.I * A (0, -Complex.I * k)) =
      k * ((1 / 2 : ℂ) * (A (0, 1) - Complex.I * A (0, Complex.I))) := by
  rw [real_linear_horizontal_decompose A k, real_linear_horizontal_decompose A (-Complex.I * k)]
  simp only [Complex.mul_re, Complex.mul_im, Complex.neg_re, Complex.neg_im,
    Complex.I_re, Complex.I_im, zero_mul, neg_mul, one_mul, zero_add, zero_sub, Complex.ofReal_neg]
  conv_rhs => lhs; rw [← k.re_add_im]
  ring_nf
  simp only [Complex.I_sq]
  ring

lemma horizontalWirtingerZ_eq_fderiv (F : ℝ × ℂ → ℂ) (A : (ℝ × ℂ) →L[ℝ] ℂ)
    (z : ℂ) (v : ℝ) (hF : HasFDerivAt F A (v, z)) :
    horizontalWirtingerZ (fun w => F (v, w)) z =
      (1 / 2 : ℂ) * (A (0, 1) - Complex.I * A (0, Complex.I)) := by
  have hline (direction : ℂ) :
      HasDerivAt (fun t : ℝ => F (v, z + (t : ℂ) * direction)) (A (0, direction)) 0 := by
    have hz : HasDerivAt (fun t : ℝ => z + (t : ℂ) * direction) direction 0 := by
      simpa using ((hasDerivAt_id (0 : ℝ)).ofReal_comp.mul_const direction).const_add z
    have hp := (hasDerivAt_const (0 : ℝ) v).prodMk hz
    have hf : HasFDerivAt F A (v, z + (0 : ℂ) * direction) := by simpa only [zero_mul, add_zero] using hF
    exact hf.comp_hasDerivAt 0 hp
  have h1 := (hline 1).deriv
  have hI := (hline Complex.I).deriv
  simp only [mul_one] at h1
  rw [horizontalWirtingerZ, h1, hI]

/-- Inverse cusp coordinates exchange the two horizontal Wirtinger derivatives. -/
theorem inverse_cusp_wirtinger_rule (c d : ℂ) (v : ℝ) (hc : c ≠ 0) (hv : 0 < v)
    (F : ℝ × ℂ → ℂ) (A : (ℝ × ℂ) →L[ℝ] ℂ)
    (hF : HasFDerivAt F A (1 / (‖c‖ ^ 2 * v), -d / c)) :
    horizontalWirtingerBar (fun z => F (inverseCuspCoordinates c d v z)) 0 =
      (-1 / (c ^ 2 * (v : ℂ) ^ 2)) *
        horizontalWirtingerZ (fun z => F (1 / (‖c‖ ^ 2 * v), z)) (-d / c) := by
  rw [horizontalWirtingerZ_eq_fderiv F A _ _ hF]
  have h1 := (inverseCuspPath_comp_hasDerivAt c d v 1 hc hv F A hF).deriv
  have hI := (inverseCuspPath_comp_hasDerivAt c d v Complex.I hc hv F A hF).deriv
  have he1 : (fun t : ℝ => F (inverseCuspCoordinates c d v (t : ℂ))) =
      (fun t : ℝ => F (inverseCuspPath c d v 1 t)) := by
    funext t
    rw [← inverseCuspCoordinates_line, mul_one]
  have heI : (fun t : ℝ => F (inverseCuspCoordinates c d v ((t : ℂ) * Complex.I))) =
      (fun t : ℝ => F (inverseCuspPath c d v Complex.I t)) := by
    funext t
    rw [inverseCuspCoordinates_line]
  rw [horizontalWirtingerBar]
  simp only [zero_add]
  rw [he1, heI, h1, hI]
  simp only [star_one, Complex.star_def, Complex.conj_I, neg_neg]
  convert real_linear_wirtinger_swap A (-1 / (c ^ 2 * (v : ℂ) ^ 2)) using 1 <;> congr 2 <;> ring

lemma horizontalWirtingerBar_translate (f : ℂ → ℂ) (a : ℂ) :
    horizontalWirtingerBar (fun z => f (z + a)) 0 = horizontalWirtingerBar f a := by
  unfold horizontalWirtingerBar
  simp only [zero_add, add_zero, add_comm]

/-- The coordinate chain rule at a finite cusp interchanges the two Wirtinger derivatives. -/
lemma coordinate_cusp_wirtinger_rule (f : HyperbolicSpace → ℂ)
    (g : SL(2, ℂ)) (hc : g 1 0 ≠ 0) (v : ℝ) (hv : 0 < v)
    (hf : DifferentiableAt ℝ (fun q : ℝ × ℂ => f (g • cuspCoordinateLift q))
      (1 / (‖g 1 0‖ ^ 2 * v), -g 1 1 / g 1 0)) :
    horizontalWirtingerBar (fun z => f (upperPoint z v hv)) (g 0 0 / g 1 0) =
      (-1 / ((g 1 0) ^ 2 * (v : ℂ) ^ 2)) * horizontalWirtingerZ
        (fun z => f (g • upperPoint z (1 / (‖g 1 0‖ ^ 2 * v)) (by positivity)))
        (-g 1 1 / g 1 0) := by
  let F : ℝ × ℂ → ℂ := fun q => f (g • cuspCoordinateLift q)
  have hp : 0 < 1 / (‖g 1 0‖ ^ 2 * v) := by positivity
  have he (z : ℂ) : F (inverseCuspCoordinates (g 1 0) (g 1 1) v z) =
      f (upperPoint (z + g 0 0 / g 1 0) v hv) := by
    unfold F
    rw [show cuspCoordinateLift (inverseCuspCoordinates (g 1 0) (g 1 1) v z) =
      upperPoint (inverseCuspCoordinates (g 1 0) (g 1 1) v z).2
        (inverseCuspCoordinates (g 1 0) (g 1 1) v z).1
        (inverseCuspCoordinates_height_pos _ _ _ _ hc hv) from cuspCoordinateLift_positive _ _ _,
      ← inverse_cusp_action g hc v hv z, smul_inv_smul]
  have hr := inverse_cusp_wirtinger_rule (g 1 0) (g 1 1) v hc hv F _ hf.hasFDerivAt
  rw [funext he] at hr
  have hr' := (horizontalWirtingerBar_translate
    (fun z => f (upperPoint z v hv)) (g 0 0 / g 1 0)).symm.trans hr
  simpa only [F, cuspCoordinateLift_positive _ _ hp] using hr'

/-- Cusp inversion acts on the actual residual source derivative with its exact weight. -/
theorem cubicSourceResidualFunction_cusp_derivative (g : SL(2, ℂ)) (hc : g 1 0 ≠ 0)
    (v : ℝ) (hv : 0 < v) :
    horizontalWirtingerBar (fun z => cubicSourceResidualFunction (upperPoint z v hv)) (g 0 0 / g 1 0) =
      (-1 / ((g 1 0) ^ 2 * (v : ℂ) ^ 2)) * horizontalWirtingerZ
        (fun z => cubicSourceResidualFunction (g • upperPoint z (1 / (‖g 1 0‖ ^ 2 * v)) (by positivity)))
        (-g 1 1 / g 1 0) :=
  coordinate_cusp_wirtinger_rule cubicSourceResidualFunction g hc v hv
    (cubicSourceResidualFunction_translate_coordinate_differentiableAt g _ (by positivity))

/-- The same exact cusp weight applies to the conjugate source used in the Gauss twists. -/
theorem conjugate_cubicSourceResidualFunction_cusp_derivative (g : SL(2, ℂ)) (hc : g 1 0 ≠ 0)
    (v : ℝ) (hv : 0 < v) :
    horizontalWirtingerBar (fun z => star (cubicSourceResidualFunction (upperPoint z v hv)))
        (g 0 0 / g 1 0) =
      (-1 / ((g 1 0) ^ 2 * (v : ℂ) ^ 2)) * horizontalWirtingerZ
        (fun z => star (cubicSourceResidualFunction
          (g • upperPoint z (1 / (‖g 1 0‖ ^ 2 * v)) (by positivity)))) (-g 1 1 / g 1 0) := by
  apply coordinate_cusp_wirtinger_rule (fun w => star (cubicSourceResidualFunction w)) g hc v hv
  exact Complex.conjCLE.differentiableAt.comp _
    (cubicSourceResidualFunction_translate_coordinate_differentiableAt g _ (by positivity))

/-- A character has one nonzero Fourier coefficient, at its dual residue class. -/
lemma finiteAdditiveFourierCoeff_character {R : Type*} [CommRing R] [Fintype R]
    (ψ χ : AddChar R ℂ) (h : R) :
    finiteAdditiveFourierCoeff ψ χ h = if χ = ψ.mulShift h then 1 else 0 := by
  classical
  by_cases he : χ = ψ.mulShift h
  · simp only [if_pos he, he, finiteAdditiveFourierCoeff, AddChar.mulShift_apply]
    have hp (x : R) : ψ (h * x) * ψ (-h * x) = 1 := by
      rw [← AddChar.map_add_eq_mul]
      simp
    simp only [hp, Finset.sum_const, nsmul_eq_mul, mul_one]
    exact div_self (by exact_mod_cast Fintype.card_ne_zero)
  · rw [if_neg he, finiteAdditiveFourierCoeff]
    have hn : χ * ψ.mulShift (-h) ≠ 1 := by
      intro hh
      apply he
      ext x
      have hv : χ x * ψ (-h * x) = 1 := congrArg (fun φ : AddChar R ℂ => φ x) hh
      have hp : ψ (-h * x) * ψ (h * x) = 1 := by
        rw [← AddChar.map_add_eq_mul]
        simp
      change χ x = ψ (h * x)
      calc
        _ = χ x * (ψ (-h * x) * ψ (h * x)) := by rw [hp, mul_one]
        _ = _ := by rw [← mul_assoc, hv, one_mul]
    have hs := AddChar.sum_eq_zero_of_ne_one hn
    change (∑ x, χ x * ψ (-h * x)) = 0 at hs
    rw [hs, zero_div]

/-- A primitive trace character parametrizes every character of a finite ring. -/
theorem finiteAdditiveCharacter_exists_unique {R : Type*} [CommRing R] [Fintype R]
    (ψ : AddChar R ℂ) (hψ : ψ.IsPrimitive) (χ : AddChar R ℂ) :
    ∃! h : R, χ = ψ.mulShift h := by
  classical
  have hex : ∃ h : R, χ = ψ.mulShift h := by
    by_contra hn
    push_neg at hn
    have hi := finiteAdditiveFourier_inversion ψ hψ χ 0
    simp only [finiteAdditiveFourierCoeff_character, if_neg (hn _), zero_mul,
      Finset.sum_const_zero, AddChar.map_zero_eq_one] at hi
    exact zero_ne_one hi
  obtain ⟨h, hh⟩ := hex
  refine ⟨h, hh, ?_⟩
  intro k hk
  exact AddChar.to_mulShift_inj_of_isPrimitive hψ (hk.symm.trans hh)

/-- Distinct primitive Fourier frequencies cannot carry the same translation character. -/
lemma period_fourier_zero_of_character (f : ℂ → ℂ)
    (hper : ∀ (n : O) (z : ℂ), f (z + 3 * ringComplex n) = f z)
    (h : O) (b χ : ℂ) (hχ : χ ≠ tracePhase (cuspFrequency h * b))
    (htranslate : ∀ z, f (z + b) = χ * f z) :
    ∫ z in periodDomain, f z * tracePhase (-cuspFrequency h * z) = 0 := by
  have he := period_fourier_translation f hper h b
  simp only [htranslate, mul_assoc] at he
  rw [integral_const_mul] at he
  apply (mul_eq_zero.mp (show (χ - tracePhase (cuspFrequency h * b)) *
      (∫ z in periodDomain, f z * tracePhase (-cuspFrequency h * z)) = 0 by
    linear_combination he)).resolve_left (sub_ne_zero.mpr hχ)

/-- The scaled ramified row has the original cusp lattice as its period lattice. -/
def ramifiedScaledRow (t : O) (v : ℝ) (z : ℂ) : ℂ :=
  ramifiedSourceFunction t (cuspCoordinateLift (3 * v, 3 * z))

lemma ramifiedScaledRow_period (t : O) (v : ℝ) (hv : 0 < v) (n : O) (z : ℂ) :
    ramifiedScaledRow t v (z + 3 * ringComplex n) = ramifiedScaledRow t v z := by
  simp only [ramifiedScaledRow, cuspCoordinateLift_positive _ _ (show 0 < 3 * v by positivity)]
  exact ramifiedSourceFunction_scaled_period t (3 * v) (by positivity) n z

lemma ramifiedScaledRow_character (t x : O) (v : ℝ) (hv : 0 < v) (z : ℂ) :
    ramifiedScaledRow t v (z + ringComplex x) =
      complexCharacter (ramifiedParabolic t x) * ramifiedScaledRow t v z := by
  simp only [ramifiedScaledRow, cuspCoordinateLift_positive _ _ (show 0 < 3 * v by positivity)]
  rw [mul_add, ramifiedSourceFunction_period, ramifiedParabolic_character]

/-- Nonzero ramified Fourier coefficients must match every cusp translation phase. -/
theorem ramifiedScaledRow_fourier_character (t h : O) (v : ℝ) (hv : 0 < v)
    (hh : (∫ z in periodDomain, ramifiedScaledRow t v z * tracePhase (-cuspFrequency h * z)) ≠ 0)
    (x : O) :
    tracePhase (cuspFrequency h * ringComplex x) = complexCharacter (ramifiedParabolic t x) := by
  by_contra hn
  exact hh (period_fourier_zero_of_character _ (ramifiedScaledRow_period t v hv) h
    (ringComplex x) (complexCharacter (ramifiedParabolic t x)) (Ne.symm hn)
    (ramifiedScaledRow_character t x v hv))

lemma ramifiedParabolic_zero (t : O) : ramifiedParabolic t 0 = 1 := by
  apply Subtype.ext
  apply Subtype.ext
  funext i j
  fin_cases i <;> fin_cases j <;> simp [ramifiedParabolic]

lemma ramifiedParabolic_add (t x y : O) :
    ramifiedParabolic t (x + y) = ramifiedParabolic t x * ramifiedParabolic t y := by
  apply Subtype.ext
  apply Subtype.ext
  funext i j
  fin_cases i <;> fin_cases j <;>
    simp [ramifiedParabolic, Matrix.mul_apply, Fin.sum_univ_two] <;> ring

/-- The stabilizer character at a lower cusp, expressed without choosing an embedding orientation. -/
def ramifiedCuspLinearChar (t : O) : AddChar O ℂ where
  toFun x := complexCharacter (ramifiedParabolic t x)
  map_zero_eq_one' := by rw [ramifiedParabolic_zero, map_one]
  map_add_eq_mul' x y := by rw [ramifiedParabolic_add, map_mul]

lemma ramifiedCuspLinearChar_period (t x : O) (hx : x ∈ Ideal.span {(3 : O)}) :
    ramifiedCuspLinearChar t x = 1 := by
  obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton.mp hx
  change complexCharacter (ramifiedParabolic t (3 * y)) = 1
  rw [ramifiedParabolic_three, map_pow, complexCharacter_cube]

def ramifiedCuspQuotientChar (t : O) : AddChar (O ⧸ Ideal.span {(3 : O)}) ℂ :=
  principalQuotientAddChar 3 (ramifiedCuspLinearChar t) (ramifiedCuspLinearChar_period t)

lemma ramifiedCuspQuotientChar_mk (t x : O) :
    ramifiedCuspQuotientChar t (Ideal.Quotient.mk (Ideal.span {(3 : O)}) x) =
      complexCharacter (ramifiedParabolic t x) :=
  principalQuotientAddChar_mk 3 _ _ x

section
local instance : Finite (O ⧸ Ideal.span {(3 : O)}) :=
  (Ideal.span {(3 : O)}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr (by norm_num))
local instance : Fintype (O ⧸ Ideal.span {(3 : O)}) := Fintype.ofFinite _

/-- The unique residue class carrying the ramified cusp character. -/
def ramifiedCuspFrequencyClass (t : O) : O ⧸ Ideal.span {(3 : O)} :=
  Classical.choose (finiteAdditiveCharacter_exists_unique
    (residueTraceQuotientChar 1 3 (by norm_num))
    (residueTraceQuotientChar_primitive 3 (by norm_num)) (ramifiedCuspQuotientChar t))

lemma ramifiedCuspFrequencyClass_spec (t : O) :
    ramifiedCuspQuotientChar t =
      (residueTraceQuotientChar 1 3 (by norm_num)).mulShift (ramifiedCuspFrequencyClass t) :=
  (Classical.choose_spec (finiteAdditiveCharacter_exists_unique
    (residueTraceQuotientChar 1 3 (by norm_num))
    (residueTraceQuotientChar_primitive 3 (by norm_num)) (ramifiedCuspQuotientChar t))).1

end

lemma residueTraceQuotientChar_three_phase (h x : O) :
    residueTraceQuotientChar h 3 (by norm_num) (Ideal.Quotient.mk _ x) =
      tracePhase (cuspFrequency h * ringComplex x) := by
  rw [residueTraceQuotientChar_mk]
  unfold residueAdditive cuspFrequency
  simp only [map_mul, map_ofNat]
  congr 1
  ring

/-- Each ramified cusp row is supported on one intrinsic residue class modulo three. -/
theorem ramifiedScaledRow_fourier_support (t h : O) (v : ℝ) (hv : 0 < v)
    (hoff : Ideal.Quotient.mk (Ideal.span {(3 : O)}) h ≠ ramifiedCuspFrequencyClass t) :
    ∫ z in periodDomain, ramifiedScaledRow t v z * tracePhase (-cuspFrequency h * z) = 0 := by
  by_contra hn
  have he : residueTraceQuotientChar h 3 (by norm_num) = ramifiedCuspQuotientChar t := by
    ext r
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective r
    rw [residueTraceQuotientChar_three_phase, ramifiedCuspQuotientChar_mk]
    exact ramifiedScaledRow_fourier_character t h v hv hn x
  rw [residueTraceQuotientChar_mulShift, ramifiedCuspFrequencyClass_spec] at he
  exact hoff (AddChar.to_mulShift_inj_of_isPrimitive
    (residueTraceQuotientChar_primitive 3 (by norm_num)) he)

lemma ramifiedCuspFrequencyClass_ne_zero (t : O)
    (ht : complexCharacter (ramifiedParabolic t 1) ≠ 1) : ramifiedCuspFrequencyClass t ≠ 0 := by
  intro hz
  have he := ramifiedCuspFrequencyClass_spec t
  rw [hz, AddChar.mulShift_zero] at he
  have hv := congrArg (fun χ : AddChar (O ⧸ Ideal.span {(3 : O)}) ℂ => χ (Ideal.Quotient.mk _ 1)) he
  rw [ramifiedCuspQuotientChar_mk, AddChar.one_apply] at hv
  exact ht hv


section
local instance : Finite (O ⧸ Ideal.span {(3 : O)}) :=
  (Ideal.span {(3 : O)}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr (by norm_num))
local instance : Fintype (O ⧸ Ideal.span {(3 : O)}) := Fintype.ofFinite _

/-- An integral representative of the dual phase of a ramified symbol. -/
def ramifiedArithmeticPhase (u : Oˣ) (n : ℕ) : O :=
  principalResidueRep 3 (Classical.choose (finiteAdditiveCharacter_exists_unique
    (residueTraceQuotientChar 1 3 (by norm_num))
    (residueTraceQuotientChar_primitive 3 (by norm_num)) (ramifiedQuotientChar u n)))

lemma ramifiedArithmeticPhase_spec (u : Oˣ) (n : ℕ) (x : O) :
    ringComplex (symbol ((u : O) * lambda ^ n) (1 + 3 * x)) =
      tracePhase (cuspFrequency (ramifiedArithmeticPhase u n) * ringComplex x) := by
  have he := (Classical.choose_spec (finiteAdditiveCharacter_exists_unique
    (residueTraceQuotientChar 1 3 (by norm_num))
    (residueTraceQuotientChar_primitive 3 (by norm_num)) (ramifiedQuotientChar u n))).1
  have hh : ramifiedQuotientChar u n =
      residueTraceQuotientChar (ramifiedArithmeticPhase u n) 3 (by norm_num) := by
    rw [residueTraceQuotientChar_mulShift]
    simpa only [ramifiedArithmeticPhase, principalResidueRep_spec] using he
  have hv := congrArg (fun χ : AddChar (O ⧸ Ideal.span {(3 : O)}) ℂ => χ (Ideal.Quotient.mk _ x)) hh
  rw [residueTraceQuotientChar_three_phase] at hv
  exact (principalQuotientAddChar_mk 3 _ _ x).symm.trans hv

end

/-- Ramified denominator variation on a primary affine line is its additive character. -/
lemma ramified_symbol_primary_affine (u : Oˣ) (n : ℕ) (a x : O)
    (ha : lambda ^ 2 ∣ a - 1) :
    ringComplex (symbol ((u : O) * lambda ^ n) (a + 3 * x)) =
      ringComplex (symbol ((u : O) * lambda ^ n) a) *
        tracePhase (cuspFrequency (ramifiedArithmeticPhase u n) * ringComplex x) := by
  obtain ⟨A, hA⟩ := three_dvd_lambda_sq.trans ha
  have hd : (3 : O) ∣ a + 3 * x - 1 := ⟨A + x, by linear_combination hA⟩
  have he : (3 : O) ∣ a * (1 + 3 * x) - 1 := ⟨A + a * x, by linear_combination hA⟩
  have h9 : (9 : O) ∣ a + 3 * x - a * (1 + 3 * x) :=
    ⟨-x * A, by linear_combination -3 * x * hA⟩
  rw [ramified_symbol_congr_mod_nine u n _ _ hd he h9,
    symbol_mul_denominator, map_mul, ramifiedArithmeticPhase_spec]

/-- Frequency for a cusp with horizontal period nine. -/
def ninthCuspFrequency (h : O) : ℂ := cuspFrequency h / 3

lemma affineCusp_phase_identity (h h1 q a k r x : O) (ha : a ≠ 0) (hq : q ≠ 0)
    (hh : h = q * h1) (hk : 3 * k = h1 + r * a) :
    tracePhase (cuspFrequency r * ringComplex x) *
      tracePhase (ninthCuspFrequency h * ringComplex (a + 3 * x) / ringComplex (q * a)) =
      tracePhase (ninthCuspFrequency h / ringComplex q) * residueAdditive (3 * k) a x := by
  rw [← AddChar.map_add_eq_mul]
  unfold residueAdditive
  rw [← AddChar.map_add_eq_mul]
  congr 1
  have hk' := congrArg ringComplex hk
  simp only [map_mul, map_add, map_ofNat] at hk'
  simp only [ninthCuspFrequency, cuspFrequency, hh, map_mul, map_add, map_ofNat]
  rw [show ringComplex h1 = 3 * ringComplex k - ringComplex r * ringComplex a by
    linear_combination -hk']
  field_simp [ringComplex_ne_zero ha, ringComplex_ne_zero hq,
    ringComplex_ne_zero traceLambda_ne_zero] <;> ring

/-- The affine ramified summand factors into its phase and an ordinary cubic Gauss summand. -/
lemma affineCuspGaussTerm_factor (h h1 q a k x : O) (u : Oˣ) (n : ℕ)
    (ha : a ≠ 0) (hap : lambda ^ 2 ∣ a - 1) (hq : q ≠ 0)
    (hh : h = q * h1) (hk : 3 * k = h1 + ramifiedArithmeticPhase u n * a) :
    (ringComplex (symbol ((u : O) * lambda ^ n) (a + 3 * x)) *
      ringComplex (symbol (a + 3 * x) a)) *
        tracePhase (ninthCuspFrequency h * ringComplex (a + 3 * x) / ringComplex (q * a)) =
      (tracePhase (ninthCuspFrequency h / ringComplex q) *
        (ringComplex (symbol ((u : O) * lambda ^ n) a) * ringComplex (symbol 3 a))) *
          (ringComplex (symbol x a) * residueAdditive (3 * k) a x) := by
  have hs : symbol (a + 3 * x) a = symbol (3 * x) a := symbol_congr ⟨1, by ring⟩
  rw [ramified_symbol_primary_affine u n a x hap, hs, symbol_mul_numerator 3 x a,
    map_mul ringComplex (symbol 3 a) (symbol x a)]
  have he := affineCusp_phase_identity h h1 q a k (ramifiedArithmeticPhase u n) x ha hq hh hk
  calc
    _ = (ringComplex (symbol ((u : O) * lambda ^ n) a) * ringComplex (symbol 3 a) *
        ringComplex (symbol x a)) *
      (tracePhase (cuspFrequency (ramifiedArithmeticPhase u n) * ringComplex x) *
        tracePhase (ninthCuspFrequency h * ringComplex (a + 3 * x) / ringComplex (q * a))) := by ring
    _ = _ := by rw [he]; ring

/-- The two cubic symbols are absorbed into a quadratic ramified frequency factor. -/
lemma cubicUnitGaussSum_ramified_single_twist (k r a : O) (ha : a ≠ 0)
    (hap : lambda ^ 2 ∣ a - 1) (hr : IsCoprime (3 * r) a) :
    ringComplex (symbol r a) * ringComplex (symbol 3 a) * cubicUnitGaussSum k a =
      cubicUnitGaussSum (9 * r ^ 2 * k) a := by
  have hcop : IsCoprime a (9 * r ^ 2) := by
    rw [show (9 : O) = 3 * 3 by norm_num]
    exact ((hr.of_mul_left_left.mul_left hr.of_mul_left_left).mul_left
      hr.of_mul_left_right.pow_left).symm
  have ht := cubicUnitGaussSum_frequency_twist k a (9 * r ^ 2) ha hcop
  have hc : ringComplex (symbol r a) * ringComplex (symbol 3 a) *
      ringComplex (symbol (9 * r ^ 2) a) = 1 := by
    rw [← map_mul, ← map_mul, ← symbol_mul_numerator, ← symbol_mul_numerator]
    rw [show r * 3 * (9 * r ^ 2) = (3 * r) ^ 3 by ring,
      symbol_pow_numerator _ a hap, symbol_cube_of_isCoprime _ a hap hr, map_one]
  calc
    _ = (ringComplex (symbol r a) * ringComplex (symbol 3 a)) *
        (ringComplex (symbol (9 * r ^ 2) a) * cubicUnitGaussSum (k * (9 * r ^ 2)) a) := by rw [ht]
    _ = cubicUnitGaussSum (k * (9 * r ^ 2)) a := by rw [← mul_assoc, hc, one_mul]
    _ = _ := by congr 1; ring

/-- The finite affine Gauss sum at a ramified cusp branch. -/
def ramifiedAffineGauss (h q a : O) (u : Oˣ) (n : ℕ) : ℂ :=
  ∑' x : CubicUnitResidue a,
    (ringComplex (symbol ((u : O) * lambda ^ n) (a + 3 * principalResidueRep a x.1)) *
      ringComplex (symbol (a + 3 * principalResidueRep a x.1) a)) *
        tracePhase (ninthCuspFrequency h * ringComplex (a + 3 * principalResidueRep a x.1) /
          ringComplex (q * a))

/-- The intrinsic additive phase affects the support but cancels from the unramified Gauss frequency. -/
theorem ramifiedAffineGauss_eq_unramified (h h1 q a k : O) (u : Oˣ) (n : ℕ)
    (ha : a ≠ 0) (hap : lambda ^ 2 ∣ a - 1) (hq : q ≠ 0)
    (hh : h = q * h1) (hk : 3 * k = h1 + ramifiedArithmeticPhase u n * a) :
    ramifiedAffineGauss h q a u n = tracePhase (ninthCuspFrequency h / ringComplex q) *
      cubicUnitGaussSum (3 * ((u : O) * lambda ^ n) ^ 2 * h1) a := by
  have he : ramifiedAffineGauss h q a u n =
      (tracePhase (ninthCuspFrequency h / ringComplex q) *
        (ringComplex (symbol ((u : O) * lambda ^ n) a) * ringComplex (symbol 3 a))) *
          cubicUnitGaussSum k a := by
    rw [ramifiedAffineGauss, cubicUnitGaussSum, ← tsum_mul_left]
    exact tsum_congr (fun x => affineCuspGaussTerm_factor h h1 q a k
      (principalResidueRep a x.1) u n ha hap hq hh hk)
  rw [he, mul_assoc, cubicUnitGaussSum_ramified_single_twist k _ a ha hap
    (ramified_primary_coprime u n a hap)]
  congr 1
  apply cubicUnitGaussSum_frequency_congr _ _ a ha
  refine ⟨3 * ((u : O) * lambda ^ n) ^ 2 * ramifiedArithmeticPhase u n, ?_⟩
  linear_combination 3 * ((u : O) * lambda ^ n) ^ 2 * hk


/-- A unit and an elementary row operation preserve the integral level-three rows. -/
def unitLowerRowEquiv (u : Oˣ) : PrimitiveRow ≃ PrimitiveRow where
  toFun r := ⟨![(u : O) * r.1 0, r.1 1 - r.1 0], by
    change IsCoprime ((u : O) * r.1 0) (r.1 1 - r.1 0) ∧
      (3 : O) ∣ (u : O) * r.1 0 ∧ (3 : O) ∣ r.1 1 - r.1 0 - 1
    refine ⟨?_, r.2.2.1.mul_left _, ?_⟩
    · obtain ⟨a, b, hab⟩ := r.2.1
      refine ⟨(a + b) * (↑u⁻¹ : O), b, ?_⟩
      calc
        _ = (a + b) * (((↑u⁻¹ : O) * (u : O)) * r.1 0) + b * (r.1 1 - r.1 0) := by ring
        _ = (a + b) * r.1 0 + b * (r.1 1 - r.1 0) := by simp
        _ = 1 := by linear_combination hab
    · convert dvd_sub r.2.2.2 r.2.2.1 using 1 <;> ring⟩
  invFun r := ⟨![(↑u⁻¹ : O) * r.1 0, r.1 1 + (↑u⁻¹ : O) * r.1 0], by
    change IsCoprime ((↑u⁻¹ : O) * r.1 0) (r.1 1 + (↑u⁻¹ : O) * r.1 0) ∧
      (3 : O) ∣ (↑u⁻¹ : O) * r.1 0 ∧ (3 : O) ∣ r.1 1 + (↑u⁻¹ : O) * r.1 0 - 1
    refine ⟨?_, r.2.2.1.mul_left _, ?_⟩
    · obtain ⟨a, b, hab⟩ := r.2.1
      refine ⟨a * (u : O) - b, b, ?_⟩
      calc
        _ = a * (((u : O) * (↑u⁻¹ : O)) * r.1 0) + b * r.1 1 := by ring
        _ = 1 := by simpa using hab
    · convert dvd_add r.2.2.2 (r.2.2.1.mul_left (↑u⁻¹ : O)) using 1 <;> ring⟩
  left_inv r := by
    apply Subtype.ext
    funext i
    fin_cases i <;> simp [← mul_assoc]
  right_inv r := by
    apply Subtype.ext
    funext i
    fin_cases i <;> simp [← mul_assoc]

/-- Index a unit lower cusp by a primary ideal and one coprime affine coordinate. -/
def unitLowerDataEquiv (u : Oˣ) : OppositeData ≃ PrimitiveRow :=
  oppositeDataEquiv.trans (unitLowerRowEquiv u)

lemma unitLowerDataEquiv_row (u : Oˣ) (p : OppositeData) :
    (unitLowerDataEquiv u p).1 =
      ![-3 * (u : O) * p.2.1, primaryIdealGenerator p.1.1 + 3 * p.2.1] := by
  funext i
  fin_cases i <;> simp [unitLowerDataEquiv, unitLowerRowEquiv, oppositeDataEquiv,
    oppositeDataToPrimitive, Equiv.ofBijective_apply] <;> ring

lemma unitLowerDenominator_primary (p : OppositeData) :
    lambda ^ 2 ∣ primaryIdealGenerator p.1.1 + 3 * p.2.1 - 1 := by
  convert dvd_add (primaryIdealGenerator_spec p.1.1 p.1.2).2
    (lambda_sq_dvd_three.mul_right p.2.1) using 1 <;> ring

lemma unitLower_row_phase (u : Oˣ) (p : OppositeData) :
    (cosetCharacter (primitiveRowEquiv.symm (unitLowerDataEquiv u p)))⁻¹ =
      ringComplex (symbol (u : O) (primaryIdealGenerator p.1.1 + 3 * p.2.1)) *
        ringComplex (symbol (primaryIdealGenerator p.1.1 + 3 * p.2.1) (primaryIdealGenerator p.1.1)) := by
  rw [inverse_cosetCharacter_eq_row_symbol, primitiveRowEquiv_symm_row, unitLowerDataEquiv_row]
  change ringComplex (symbol (-3 * (u : O) * p.2.1) (primaryIdealGenerator p.1.1 + 3 * p.2.1)) = _
  rw [symbol_congr (show primaryIdealGenerator p.1.1 + 3 * p.2.1 ∣
    -3 * (u : O) * p.2.1 - (u : O) * primaryIdealGenerator p.1.1 from ⟨-(u : O), by ring⟩),
    symbol_mul_numerator, map_mul,
    symbol_reciprocity _ _ (primaryIdealGenerator_spec p.1.1 p.1.2).2 (unitLowerDenominator_primary p)]

lemma rowOperator_lowerCusp (t : O) (r : Fin 2 → ℂ) :
    rowOperator (integralComplexMatrix (lowerCuspMatrix t)) r = ![r 0 + ringComplex t * r 1, r 1] := by
  rw [rowOperator_apply]
  funext i
  fin_cases i <;> simp [integralComplexMatrix, lowerCuspMatrix, Matrix.vecMul,
    dotProduct, Fin.sum_univ_two, mul_comm]

/-- A primary affine branch of a lower-cusp Eisenstein series. -/
def affineLowerTerm (q r : O) (z : ℂ) (v : ℝ) (s : ℂ) (a d : O) : ℂ :=
  (ringComplex (symbol r d) * ringComplex (symbol d a)) *
    ((v / (‖ringComplex (q * a) * z + ringComplex d‖ ^ 2 +
      ‖ringComplex (q * a)‖ ^ 2 * v ^ 2) : ℝ) : ℂ) ^ s

lemma unitLower_summand (u : Oˣ) (z : ℂ) (v : ℝ) (hv : 0 < v) (s : ℂ) (p : OppositeData) :
    summand (integralComplexMatrix (lowerCuspMatrix (u : O)) * upperSection z v hv) s
      (primitiveRowEquiv.symm (unitLowerDataEquiv u p)) =
      affineLowerTerm (u : O) (u : O) z v s (primaryIdealGenerator p.1.1)
        (primaryIdealGenerator p.1.1 + 3 * p.2.1) := by
  let r : Fin 2 → ℂ := ![ringComplex ((u : O) * primaryIdealGenerator p.1.1),
    ringComplex (primaryIdealGenerator p.1.1 + 3 * p.2.1)]
  have hr : rowOperator (integralComplexMatrix (lowerCuspMatrix (u : O)))
      (embeddedRow (primitiveRowEquiv.symm (unitLowerDataEquiv u p))) = r := by
    rw [embeddedRow, primitiveRowEquiv_symm_row, unitLowerDataEquiv_row, rowOperator_lowerCusp]
    funext i
    fin_cases i <;> simp [r, map_mul, map_add] <;> ring
  have hr0 : r ≠ 0 := by
    intro hh
    exact ringComplex_ne_zero (mul_ne_zero u.ne_zero p.1.2) (congrFun hh 0)
  have hp := heightDenominator_pos z v hv r hr0
  rw [summand, ← rowOperator_mul, hr, rowEnergy_upperSection, unitLower_row_phase]
  change _ = _ * ((v / heightDenominator z v r : ℝ) : ℂ) ^ s
  rw [show ((v / heightDenominator z v r : ℝ) : ℂ) =
    (((heightDenominator z v r / v : ℝ) : ℂ))⁻¹ by simp only [Complex.ofReal_div, inv_div],
    inv_cpow_ofReal_nonneg (div_nonneg hp.le hv.le), Complex.cpow_neg]

/-- The unit cusp series is a sum of the native affine branches. -/
theorem unitLowerEisenstein_eq_rows (u : Oˣ) (z : ℂ) (v : ℝ) (hv : 0 < v) (s : ℂ) :
    eisenstein (integralComplexMatrix (lowerCuspMatrix (u : O)) * upperSection z v hv) s =
      ∑' p : OppositeData, affineLowerTerm (u : O) (u : O) z v s (primaryIdealGenerator p.1.1)
        (primaryIdealGenerator p.1.1 + 3 * p.2.1) := by
  let e := (unitLowerDataEquiv u).trans primitiveRowEquiv.symm
  change (∑' x : CuspCosets, summand _ s x) = _
  rw [← e.tsum_eq (fun x => summand _ s x)]
  exact tsum_congr (unitLower_summand u z v hv s)

lemma affineLowerTerm_eq_shifted (q r : O) (z : ℂ) (v : ℝ) (hv : 0 < v) (s : ℂ)
    (a d : O) (ha : a ≠ 0) (hq : q ≠ 0) :
    affineLowerTerm q r z v s a d =
      (ringComplex (symbol r d) * ringComplex (symbol d a) *
        ((‖ringComplex (q * a)‖ ^ 2 : ℝ) : ℂ) ^ (-s)) *
          shiftedHeightKernel v s (ringComplex d / ringComplex (q * a)) z := by
  rw [affineLowerTerm, rowHeight_eq_shiftedHeightKernel z v hv s (q * a) d (mul_ne_zero hq ha)]
  ring

lemma affineLowerTerm_integrable (q r : O) (v : ℝ) (hv : 0 < v) (s : ℂ) (hs : 1 < s.re)
    (a d : O) (ha : a ≠ 0) (hq : q ≠ 0) :
    Integrable (fun z => affineLowerTerm q r z v s a d) := by
  simp_rw [affineLowerTerm_eq_shifted q r _ v hv s a d ha hq]
  exact (shiftedHeightKernel_integrable v hv s _ hs).const_mul _

lemma affineLowerTerm_fourier_integral (q r : O) (v : ℝ) (hv : 0 < v) (s freq : ℂ)
    (a d : O) (ha : a ≠ 0) (hq : q ≠ 0) :
    (∫ z : ℂ, affineLowerTerm q r z v s a d * tracePhase (-freq * z)) =
      ((v : ℂ) ^ (2 - s) * sourceFourierKernel s (freq * v)) *
        ((‖ringComplex (q * a)‖ ^ 2 : ℝ) : ℂ) ^ (-s) *
          ((ringComplex (symbol r d) * ringComplex (symbol d a)) *
            tracePhase (freq * ringComplex d / ringComplex (q * a))) := by
  simp_rw [affineLowerTerm_eq_shifted q r _ v hv s a d ha hq, mul_assoc]
  rw [integral_const_mul, integral_const_mul, integral_const_mul,
    traceIntegral_shiftedHeightKernel v hv s (ringComplex d / ringComplex (q * a)) freq]
  ring


/-- A principal residue fiber is the affine lattice represented by its chosen residue. -/
def principalResidueFiberMap (q : O) (r : O ⧸ Ideal.span {q}) (n : O) :
    ((Ideal.Quotient.mk (Ideal.span {q})) ⁻¹' {r}) := by
  refine ⟨principalResidueRep q r + q * n, ?_⟩
  change Ideal.Quotient.mk _ (principalResidueRep q r + q * n) = r
  rw [map_add, map_mul, principalResidueRep_spec,
    show Ideal.Quotient.mk (Ideal.span {q}) q = 0 from
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton q)), zero_mul, add_zero]

def principalResidueFiberEquiv (q : O) (hq : q ≠ 0) (r : O ⧸ Ideal.span {q}) :
    O ≃ ((Ideal.Quotient.mk (Ideal.span {q})) ⁻¹' {r}) := Equiv.ofBijective
  (principalResidueFiberMap q r) (by
    constructor
    · intro m n he
      exact mul_left_cancel₀ hq (add_left_cancel (congrArg Subtype.val he))
    · rintro ⟨x, hx⟩
      change Ideal.Quotient.mk (Ideal.span {q}) x = r at hx
      have hd : q ∣ x - principalResidueRep q r := Ideal.mem_span_singleton.mp
        ((Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp (hx.trans (principalResidueRep_spec q r).symm))
      obtain ⟨n, hn⟩ := hd
      refine ⟨n, Subtype.ext ?_⟩
      change principalResidueRep q r + q * n = x
      linear_combination -hn)

lemma finite_index_period_shift (q : O) (hq : q ≠ 0) (r : O ⧸ Ideal.span {q}) (n : O) (z : ℂ) :
    z + 3 * ringComplex (principalResidueRep q r + q * n) / ringComplex q =
      (z + 3 * ringComplex n) + 3 * ringComplex (principalResidueRep q r) / ringComplex q := by
  simp only [map_add, map_mul]
  field_simp [ringComplex_ne_zero hq] <;> ring

/-- A lattice enlarged by a principal denominator covers the plane with multiplicity equal to its norm. -/
lemma finite_index_period_lintegral (q : O) (hq : q ≠ 0) (f : ℂ → ℝ≥0∞) :
    (∑' n : O, ∫⁻ z in periodDomain, f (z + 3 * ringComplex n / ringComplex q)) =
      (Ideal.absNorm (Ideal.span {q}) : ℝ≥0∞) * (∫⁻ z : ℂ, f z) := by
  letI : Finite (O ⧸ Ideal.span {q}) := (Ideal.span {q}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr hq)
  letI : Fintype (O ⧸ Ideal.span {q}) := Fintype.ofFinite _
  let I : O → ℝ≥0∞ := fun n => ∫⁻ z in periodDomain, f (z + 3 * ringComplex n / ringComplex q)
  have hinner (r : O ⧸ Ideal.span {q}) :
      (∑' n : ((Ideal.Quotient.mk (Ideal.span {q})) ⁻¹' {r}), I n.1) = ∫⁻ z : ℂ, f z := by
    rw [← (principalResidueFiberEquiv q hq r).tsum_eq]
    change (∑' n : O, ∫⁻ z in periodDomain,
      f (z + 3 * ringComplex (principalResidueRep q r + q * n) / ringComplex q)) = _
    simp_rw [finite_index_period_shift q hq]
    rw [← lintegral_eq_period_lintegrals (fun z =>
      f (z + 3 * ringComplex (principalResidueRep q r) / ringComplex q))]
    exact lintegral_add_right_eq_self f _
  change (∑' n : O, I n) = _
  rw [← ENNReal.tsum_fiberwise I (Ideal.Quotient.mk (Ideal.span {q}))]
  simp only [hinner, tsum_fintype, Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
  congr 1
  change (Fintype.card (O ⧸ Ideal.span {q}) : ℝ≥0∞) = (Nat.card (O ⧸ Ideal.span {q}) : ℝ≥0∞)
  rw [Nat.card_eq_fintype_card]

lemma finite_index_period_integrals_summable (q : O) (hq : q ≠ 0) (f : ℂ → ℂ) (hf : Integrable f) :
    Summable (fun n : O => ∫ z in periodDomain, f (z + 3 * ringComplex n / ringComplex q)) := by
  apply Summable.of_enorm
  apply ne_of_lt
  apply lt_of_le_of_lt (ENNReal.tsum_le_tsum (fun n => enorm_integral_le_lintegral_enorm _))
  rw [finite_index_period_lintegral q hq (fun z => ‖f z‖ₑ)]
  exact ENNReal.mul_lt_top (by simp) hf.hasFiniteIntegral

/-- Unfold the finite-index lattice, retaining its exact covering multiplicity. -/
theorem finite_index_period_unfold (q : O) (hq : q ≠ 0) (f : ℂ → ℂ) (hf : Integrable f) :
    (∑' n : O, ∫ z in periodDomain, f (z + 3 * ringComplex n / ringComplex q)) =
      (Ideal.absNorm (Ideal.span {q}) : ℂ) * (∫ z : ℂ, f z) := by
  letI : Finite (O ⧸ Ideal.span {q}) := (Ideal.span {q}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr hq)
  letI : Fintype (O ⧸ Ideal.span {q}) := Fintype.ofFinite _
  let I : O → ℂ := fun n => ∫ z in periodDomain, f (z + 3 * ringComplex n / ringComplex q)
  have hinner (r : O ⧸ Ideal.span {q}) :
      (∑' n : ((Ideal.Quotient.mk (Ideal.span {q})) ⁻¹' {r}), I n.1) = ∫ z : ℂ, f z := by
    rw [← (principalResidueFiberEquiv q hq r).tsum_eq]
    change (∑' n : O, ∫ z in periodDomain,
      f (z + 3 * ringComplex (principalResidueRep q r + q * n) / ringComplex q)) = _
    simp_rw [finite_index_period_shift q hq]
    rw [← integral_eq_period_integrals _ (hf.comp_add_right _)]
    exact integral_add_right_eq_self f _
  have hs := (finite_index_period_integrals_summable q hq f hf).hasSum.tsum_fiberwise
    (Ideal.Quotient.mk (Ideal.span {q}))
  change HasSum (fun r => ∑' n : ((Ideal.Quotient.mk (Ideal.span {q})) ⁻¹' {r}), I n.1) (∑' n, I n) at hs
  change (∑' n : O, I n) = _
  rw [← hs.tsum_eq]
  simp only [hinner, tsum_fintype, Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
  congr 1
  change (Fintype.card (O ⧸ Ideal.span {q}) : ℂ) = (Nat.card (O ⧸ Ideal.span {q}) : ℂ)
  rw [Nat.card_eq_fintype_card]

lemma affineCuspTwistedCoefficient_add (h h1 q a k x m : O) (u : Oˣ) (n : ℕ)
    (ha : a ≠ 0) (hap : lambda ^ 2 ∣ a - 1) (hq : q ≠ 0)
    (hh : h = q * h1) (hk : 3 * k = h1 + ramifiedArithmeticPhase u n * a) :
    (ringComplex (symbol ((u : O) * lambda ^ n) (a + 3 * (x + a * m))) *
      ringComplex (symbol (a + 3 * (x + a * m)) a)) *
        tracePhase (ninthCuspFrequency h * ringComplex (a + 3 * (x + a * m)) / ringComplex (q * a)) =
    (ringComplex (symbol ((u : O) * lambda ^ n) (a + 3 * x)) * ringComplex (symbol (a + 3 * x) a)) *
      tracePhase (ninthCuspFrequency h * ringComplex (a + 3 * x) / ringComplex (q * a)) := by
  rw [affineCuspGaussTerm_factor h h1 q a k (x + a * m) u n ha hap hq hh hk,
    affineCuspGaussTerm_factor h h1 q a k x u n ha hap hq hh hk,
    symbol_congr (show a ∣ x + a * m - x from ⟨m, by ring⟩),
    residueAdditive_three_congr k a (x + a * m) x ha ⟨m, by ring⟩]

lemma affineLowerTerm_weighted_translate (h h1 q a k x m : O) (u : Oˣ) (n : ℕ)
    (ha : a ≠ 0) (hap : lambda ^ 2 ∣ a - 1) (hq : q ≠ 0)
    (hh : h = q * h1) (hk : 3 * k = h1 + ramifiedArithmeticPhase u n * a)
    (z : ℂ) (v : ℝ) (s : ℂ) :
    affineLowerTerm q ((u : O) * lambda ^ n) z v s a (a + 3 * (x + a * m)) *
        tracePhase (-ninthCuspFrequency h * z) =
      affineLowerTerm q ((u : O) * lambda ^ n) (z + 3 * ringComplex m / ringComplex q) v s a (a + 3 * x) *
        tracePhase (-ninthCuspFrequency h * (z + 3 * ringComplex m / ringComplex q)) := by
  let c1 := ringComplex (symbol ((u : O) * lambda ^ n) (a + 3 * (x + a * m))) *
    ringComplex (symbol (a + 3 * (x + a * m)) a)
  let c0 := ringComplex (symbol ((u : O) * lambda ^ n) (a + 3 * x)) * ringComplex (symbol (a + 3 * x) a)
  let B := ninthCuspFrequency h * ringComplex (a + 3 * x) / ringComplex (q * a)
  let Q := ninthCuspFrequency h * (3 * ringComplex m / ringComplex q)
  have harg : ninthCuspFrequency h * ringComplex (a + 3 * (x + a * m)) / ringComplex (q * a) = B + Q := by
    dsimp [B, Q]
    simp only [map_add, map_mul, map_ofNat]
    field_simp [ringComplex_ne_zero hq, ringComplex_ne_zero ha] <;> ring
  have he := affineCuspTwistedCoefficient_add h h1 q a k x m u n ha hap hq hh hk
  change c1 * tracePhase (ninthCuspFrequency h * ringComplex (a + 3 * (x + a * m)) / ringComplex (q * a)) =
    c0 * tracePhase B at he
  rw [harg, AddChar.map_add_eq_mul] at he
  have heB : tracePhase B ≠ 0 := Complex.exp_ne_zero _
  have hmult : c1 * tracePhase Q = c0 := by
    apply mul_right_cancel₀ heB
    calc
      _ = c1 * (tracePhase B * tracePhase Q) := by ring
      _ = _ := he
  have hsolve : c1 = c0 * tracePhase (-Q) := by
    rw [← hmult, mul_assoc, ← AddChar.map_add_eq_mul, add_neg_cancel, AddChar.map_zero_eq_one, mul_one]
  have hrow : ringComplex (q * a) * z + ringComplex (a + 3 * (x + a * m)) =
      ringComplex (q * a) * (z + 3 * ringComplex m / ringComplex q) + ringComplex (a + 3 * x) := by
    simp only [map_add, map_mul, map_ofNat]
    field_simp [ringComplex_ne_zero hq] <;> ring
  change c1 * ((v / (‖ringComplex (q * a) * z + ringComplex (a + 3 * (x + a * m))‖ ^ 2 +
    ‖ringComplex (q * a)‖ ^ 2 * v ^ 2) : ℝ) : ℂ) ^ s * tracePhase (-ninthCuspFrequency h * z) = _
  rw [hsolve, hrow]
  unfold affineLowerTerm
  rw [show -ninthCuspFrequency h * (z + 3 * ringComplex m / ringComplex q) =
      -Q + (-ninthCuspFrequency h * z) by dsimp [Q]; ring, AddChar.map_add_eq_mul]
  dsimp only [c0]
  ring

lemma affineLowerIntegral_sum_translate (h h1 q a k x : O) (u : Oˣ) (n : ℕ)
    (ha : a ≠ 0) (hap : lambda ^ 2 ∣ a - 1) (hq : q ≠ 0)
    (hh : h = q * h1) (hk : 3 * k = h1 + ramifiedArithmeticPhase u n * a)
    (v : ℝ) (hv : 0 < v) (s : ℂ) (hs : 1 < s.re) :
    (∑' m : O, ∫ z in periodDomain,
      affineLowerTerm q ((u : O) * lambda ^ n) z v s a (a + 3 * (x + a * m)) *
        tracePhase (-ninthCuspFrequency h * z)) =
      (Ideal.absNorm (Ideal.span {q}) : ℂ) *
        ∫ z : ℂ, affineLowerTerm q ((u : O) * lambda ^ n) z v s a (a + 3 * x) *
          tracePhase (-ninthCuspFrequency h * z) := by
  have hint := trace_mul_integrable (fun z => affineLowerTerm q ((u : O) * lambda ^ n) z v s a (a + 3 * x))
    (affineLowerTerm_integrable q _ v hv s hs a (a + 3 * x) ha hq) (ninthCuspFrequency h)
  rw [← finite_index_period_unfold q hq _ hint]
  apply tsum_congr
  intro m
  apply integral_congr_ae
  exact Eventually.of_forall (fun z => affineLowerTerm_weighted_translate h h1 q a k x m u n ha hap hq hh hk z v s)


/-- Horizontal Fourier integral of an affine ramified row. -/
def affineLowerFourierTerm (q r h : O) (v : ℝ) (s : ℂ) (a x : O) : ℂ :=
  ∫ z in periodDomain, affineLowerTerm q r z v s a (a + 3 * x) * tracePhase (-ninthCuspFrequency h * z)

lemma affineCuspFrequency_lift (h1 : O) (u : Oˣ) (n : ℕ) (I : GoodIdeal)
    (hfreq : (3 : O) ∣ h1 + ramifiedArithmeticPhase u n) :
    ∃ k : O, 3 * k = h1 + ramifiedArithmeticPhase u n * primaryIdealGenerator I.1 := by
  have hd := dvd_add hfreq ((three_dvd_primary_sub_one _
    (primaryIdealGenerator_spec I.1 I.2).2).mul_left (ramifiedArithmeticPhase u n))
  have he : (3 : O) ∣ h1 + ramifiedArithmeticPhase u n * primaryIdealGenerator I.1 := by
    convert hd using 1 <;> ring
  obtain ⟨k, hk⟩ := he
  exact ⟨k, hk.symm⟩

lemma affineDenominator_fourier (h h1 q a k : O) (u : Oˣ) (n : ℕ)
    (ha : a ≠ 0) (hap : lambda ^ 2 ∣ a - 1) (hq : q ≠ 0)
    (hh : h = q * h1) (hk : 3 * k = h1 + ramifiedArithmeticPhase u n * a)
    (v : ℝ) (hv : 0 < v) (s : ℂ) (hs : 1 < s.re)
    (hsum : Summable (fun x : CoprimeElement a => affineLowerFourierTerm q ((u : O) * lambda ^ n) h v s a x.1)) :
    (∑' x : CoprimeElement a, affineLowerFourierTerm q ((u : O) * lambda ^ n) h v s a x.1) =
      (Ideal.absNorm (Ideal.span {q}) : ℂ) *
        ((v : ℂ) ^ (2 - s) * sourceFourierKernel s (ninthCuspFrequency h * v)) *
          ((‖ringComplex (q * a)‖ ^ 2 : ℝ) : ℂ) ^ (-s) * ramifiedAffineGauss h q a u n := by
  let F : CoprimeElement a → ℂ := fun x => affineLowerFourierTerm q ((u : O) * lambda ^ n) h v s a x.1
  let e := cubicResidueElementEquiv a ha
  have hp : Summable (fun p : CubicUnitResidue a × O => F (e p)) := e.summable_iff.mpr hsum
  change (∑' x, F x) = _
  rw [← e.tsum_eq F, hp.tsum_prod]
  change (∑' x : CubicUnitResidue a, ∑' m : O,
    affineLowerFourierTerm q ((u : O) * lambda ^ n) h v s a (principalResidueRep a x.1 + a * m)) = _
  have hinner (x : CubicUnitResidue a) :
      (∑' m : O, affineLowerFourierTerm q ((u : O) * lambda ^ n) h v s a
        (principalResidueRep a x.1 + a * m)) =
      ((Ideal.absNorm (Ideal.span {q}) : ℂ) *
        ((v : ℂ) ^ (2 - s) * sourceFourierKernel s (ninthCuspFrequency h * v)) *
          ((‖ringComplex (q * a)‖ ^ 2 : ℝ) : ℂ) ^ (-s)) *
        ((ringComplex (symbol ((u : O) * lambda ^ n) (a + 3 * principalResidueRep a x.1)) *
          ringComplex (symbol (a + 3 * principalResidueRep a x.1) a)) *
            tracePhase (ninthCuspFrequency h * ringComplex (a + 3 * principalResidueRep a x.1) / ringComplex (q * a))) := by
    unfold affineLowerFourierTerm
    rw [affineLowerIntegral_sum_translate h h1 q a k _ u n ha hap hq hh hk v hv s hs,
      affineLowerTerm_fourier_integral q _ v hv s _ a _ ha hq]
    ring
  simp_rw [hinner]
  rw [tsum_mul_left]
  rfl

lemma affineCusp_norm_factor (q : O) (s : ℂ) (I : GoodIdeal) :
    ((‖ringComplex (q * primaryIdealGenerator I.1)‖ ^ 2 : ℝ) : ℂ) ^ (-s) =
      ((‖ringComplex q‖ ^ 2 : ℝ) : ℂ) ^ (-s) * unramifiedNormWeight s I.1 := by
  rw [unramifiedNormWeight_of_good s _ I.2, map_mul, norm_mul, mul_pow, Complex.ofReal_mul,
    Complex.mul_cpow_ofReal_nonneg (sq_nonneg _) (sq_nonneg _),
    ringComplex_norm_sq_eq_absNorm_span (primaryIdealGenerator I.1),
    (primaryIdealGenerator_spec I.1 I.2).1, Complex.ofReal_natCast]

/-- Every active affine cusp branch is one unramified Gauss series with an explicit scale. -/
theorem affineCusp_branch_fourier (h h1 q : O) (u : Oˣ) (n : ℕ) (hq : q ≠ 0)
    (hh : h = q * h1) (hfreq : (3 : O) ∣ h1 + ramifiedArithmeticPhase u n)
    (v : ℝ) (hv : 0 < v) (s : ℂ) (hs : 1 < s.re)
    (hsum : Summable (fun p : OppositeData => affineLowerFourierTerm q ((u : O) * lambda ^ n) h v s
      (primaryIdealGenerator p.1.1) p.2.1)) :
    (∑' p : OppositeData, affineLowerFourierTerm q ((u : O) * lambda ^ n) h v s
      (primaryIdealGenerator p.1.1) p.2.1) =
      (Ideal.absNorm (Ideal.span {q}) : ℂ) * ((‖ringComplex q‖ ^ 2 : ℝ) : ℂ) ^ (-s) *
        ((v : ℂ) ^ (2 - s) * sourceFourierKernel s (ninthCuspFrequency h * v)) *
          tracePhase (ninthCuspFrequency h / ringComplex q) *
            unramifiedCubicGaussSeries s (3 * ((u : O) * lambda ^ n) ^ 2 * h1) := by
  rw [hsum.tsum_sigma]
  have hI (I : GoodIdeal) :
      (∑' x : CoprimeElement (primaryIdealGenerator I.1), affineLowerFourierTerm q ((u : O) * lambda ^ n) h v s
        (primaryIdealGenerator I.1) x.1) =
      ((Ideal.absNorm (Ideal.span {q}) : ℂ) * ((‖ringComplex q‖ ^ 2 : ℝ) : ℂ) ^ (-s) *
        ((v : ℂ) ^ (2 - s) * sourceFourierKernel s (ninthCuspFrequency h * v)) *
          tracePhase (ninthCuspFrequency h / ringComplex q)) *
        (unramifiedNormWeight s I.1 *
          cubicUnitGaussSum (3 * ((u : O) * lambda ^ n) ^ 2 * h1) (primaryIdealGenerator I.1)) := by
    obtain ⟨k, hk⟩ := affineCuspFrequency_lift h1 u n I hfreq
    rw [affineDenominator_fourier h h1 q _ k u n I.2 (primaryIdealGenerator_spec I.1 I.2).2
      hq hh hk v hv s hs (hsum.sigma_factor I),
      ramifiedAffineGauss_eq_unramified h h1 q _ k u n I.2 (primaryIdealGenerator_spec I.1 I.2).2 hq hh hk,
      affineCusp_norm_factor]
    ring
  simp_rw [hI]
  rw [tsum_mul_left]
  rfl

lemma hasSum_unitLowerIntegrals (u : Oˣ) (v : ℝ) (hv : 0 < v) (s : ℂ) (h : O) (hs : 2 < s.re) :
    HasSum (fun p : OppositeData => affineLowerFourierTerm (u : O) (u : O) h v s
      (primaryIdealGenerator p.1.1) p.2.1)
      (∫ z in periodDomain, eisenstein (integralComplexMatrix (lowerCuspMatrix (u : O)) * upperSection z v hv) s *
        tracePhase (-ninthCuspFrequency h * z)) := by
  let e := (unitLowerDataEquiv u).trans primitiveRowEquiv.symm
  have he := e.hasSum_iff.mpr (hasSum_integral_fixed_left_Eisenstein
    (integralComplexMatrix (lowerCuspMatrix (u : O))) v hv s (ninthCuspFrequency h) hs)
  apply he.congr_fun
  intro p
  apply integral_congr_ae
  exact Eventually.of_forall (fun z => by
    dsimp only [affineLowerFourierTerm, e, Equiv.trans_apply, Function.comp_apply]
    rw [unitLower_summand])

/-- The actual unit-cusp Eisenstein coefficient equals its unramified Gauss series. -/
theorem unitLowerEisenstein_fourier (u : Oˣ) (h h1 : O) (hh : h = (u : O) * h1)
    (hfreq : (3 : O) ∣ h1 + ramifiedArithmeticPhase u 0)
    (v : ℝ) (hv : 0 < v) (s : ℂ) (hs : 2 < s.re) :
    (∫ z in periodDomain, eisenstein (integralComplexMatrix (lowerCuspMatrix (u : O)) * upperSection z v hv) s *
        tracePhase (-ninthCuspFrequency h * z)) =
      ((v : ℂ) ^ (2 - s) * sourceFourierKernel s (ninthCuspFrequency h * v)) *
        tracePhase (ninthCuspFrequency h / ringComplex (u : O)) *
          unramifiedCubicGaussSeries s (3 * (u : O) ^ 2 * h1) := by
  have hsum := hasSum_unitLowerIntegrals u v hv s h hs
  rw [← hsum.tsum_eq]
  have he := affineCusp_branch_fourier h h1 (u : O) u 0 u.ne_zero hh hfreq v hv s (by linarith)
    (by simpa only [pow_zero, mul_one] using hsum.summable)
  simpa only [pow_zero, mul_one, norm_ringComplex_unit, one_pow, Complex.ofReal_one, Complex.one_cpow,
    Ideal.span_singleton_eq_top.mpr u.isUnit, Ideal.absNorm_top, Nat.cast_one, one_mul] using he

/-- The diagonal matrix of an Eisenstein unit preserves heights. -/
def unitCuspDiagonal (u : Oˣ) : SL(2, O) :=
  ⟨!![(u : O), 0; 0, (↑u⁻¹ : O)], by simp [Matrix.det_fin_two]⟩

lemma rowOperator_unitDiagonal (u : Oˣ) (r : Fin 2 → ℂ) :
    rowOperator (integralComplexMatrix (unitCuspDiagonal u)) r =
      ![ringComplex (u : O) * r 0, ringComplex (↑u⁻¹ : O) * r 1] := by
  rw [rowOperator_apply]
  funext i
  fin_cases i <;> simp [integralComplexMatrix, unitCuspDiagonal, Matrix.vecMul,
    dotProduct, Fin.sum_univ_two, mul_comm]

lemma rowEnergy_complex_smul (c : ℂ) (r : Fin 2 → ℂ) :
    rowEnergy (c • r) = ‖c‖ ^ 2 * rowEnergy r := by
  simp only [rowEnergy, Pi.smul_apply, norm_smul, mul_pow, mul_add]

/-- Absorb a unit diagonal into the cubic numerator while leaving the affine height unchanged. -/
lemma diagonal_unit_summand (u t : Oˣ) (z : ℂ) (v : ℝ) (hv : 0 < v) (s : ℂ) (p : OppositeData) :
    summand (integralComplexMatrix (unitCuspDiagonal u) *
      integralComplexMatrix (lowerCuspMatrix (t : O)) * upperSection z v hv) s
      (primitiveRowEquiv.symm (unitLowerDataEquiv (u⁻¹ ^ 2 * t) p)) =
      affineLowerTerm (t : O) ((↑u⁻¹ : O) ^ 2 * (t : O)) z v s (primaryIdealGenerator p.1.1)
        (primaryIdealGenerator p.1.1 + 3 * p.2.1) := by
  let r : Fin 2 → ℂ := ![ringComplex ((t : O) * primaryIdealGenerator p.1.1),
    ringComplex (primaryIdealGenerator p.1.1 + 3 * p.2.1)]
  have hunit : ringComplex (u : O) * ringComplex (↑u⁻¹ : O) = 1 := by
    rw [← map_mul]
    simp
  have hr : rowOperator (integralComplexMatrix (unitCuspDiagonal u) *
      integralComplexMatrix (lowerCuspMatrix (t : O)))
      (embeddedRow (primitiveRowEquiv.symm (unitLowerDataEquiv (u⁻¹ ^ 2 * t) p))) =
        ringComplex (↑u⁻¹ : O) • r := by
    rw [← rowOperator_mul, embeddedRow, primitiveRowEquiv_symm_row, unitLowerDataEquiv_row,
      rowOperator_unitDiagonal, rowOperator_lowerCusp]
    funext i
    fin_cases i
    · change ringComplex (u : O) * ringComplex (-3 * (↑(u⁻¹ ^ 2 * t) : O) * p.2.1) +
        ringComplex (t : O) * (ringComplex (↑u⁻¹ : O) *
          ringComplex (primaryIdealGenerator p.1.1 + 3 * p.2.1)) =
        ringComplex (↑u⁻¹ : O) * ringComplex ((t : O) * primaryIdealGenerator p.1.1)
      simp only [Units.val_mul, Units.val_pow_eq_pow_val, map_mul, map_pow, map_neg, map_add, map_ofNat]
      linear_combination -3 * ringComplex (↑u⁻¹ : O) * ringComplex (t : O) * ringComplex p.2.1 * hunit
    · simp [r]
  have hr0 : r ≠ 0 := by
    intro hh
    exact ringComplex_ne_zero (mul_ne_zero t.ne_zero p.1.2) (congrFun hh 0)
  have hp := heightDenominator_pos z v hv r hr0
  rw [summand, ← rowOperator_mul, hr, map_smul, rowEnergy_complex_smul,
    norm_ringComplex_unit, one_pow, one_mul, rowEnergy_upperSection, unitLower_row_phase]
  simp only [Units.val_mul, Units.val_pow_eq_pow_val]
  change _ = _ * ((v / heightDenominator z v r : ℝ) : ℂ) ^ s
  rw [show ((v / heightDenominator z v r : ℝ) : ℂ) =
    (((heightDenominator z v r / v : ℝ) : ℂ))⁻¹ by simp only [Complex.ofReal_div, inv_div],
    inv_cpow_ofReal_nonneg (div_nonneg hp.le hv.le), Complex.cpow_neg]

lemma hasSum_diagonal_unit_integrals (u t : Oˣ) (v : ℝ) (hv : 0 < v) (s : ℂ) (h : O) (hs : 2 < s.re) :
    HasSum (fun p : OppositeData => affineLowerFourierTerm (t : O) ((↑u⁻¹ : O) ^ 2 * (t : O)) h v s
      (primaryIdealGenerator p.1.1) p.2.1)
      (∫ z in periodDomain, eisenstein (integralComplexMatrix (unitCuspDiagonal u) *
        integralComplexMatrix (lowerCuspMatrix (t : O)) * upperSection z v hv) s *
          tracePhase (-ninthCuspFrequency h * z)) := by
  let e := (unitLowerDataEquiv (u⁻¹ ^ 2 * t)).trans primitiveRowEquiv.symm
  have he := e.hasSum_iff.mpr (hasSum_integral_fixed_left_Eisenstein
    (integralComplexMatrix (unitCuspDiagonal u) * integralComplexMatrix (lowerCuspMatrix (t : O)))
      v hv s (ninthCuspFrequency h) hs)
  apply he.congr_fun
  intro p
  apply integral_congr_ae
  exact Eventually.of_forall (fun z => by
    dsimp only [affineLowerFourierTerm, e, Equiv.trans_apply, Function.comp_apply]
    rw [diagonal_unit_summand])

/-- A unit diagonal changes the cubic Gauss frequency through its fourth inverse power. -/
theorem diagonal_unit_eisenstein_fourier (u t : Oˣ) (h h1 : O)
    (hh : h = (t : O) * h1) (hfreq : (3 : O) ∣ h1 + ramifiedArithmeticPhase (u⁻¹ ^ 2 * t) 0)
    (v : ℝ) (hv : 0 < v) (s : ℂ) (hs : 2 < s.re) :
    (∫ z in periodDomain, eisenstein (integralComplexMatrix (unitCuspDiagonal u) *
      integralComplexMatrix (lowerCuspMatrix (t : O)) * upperSection z v hv) s *
        tracePhase (-ninthCuspFrequency h * z)) =
      ((v : ℂ) ^ (2 - s) * sourceFourierKernel s (ninthCuspFrequency h * v)) *
        tracePhase (ninthCuspFrequency h / ringComplex (t : O)) *
          unramifiedCubicGaussSeries s (3 * ((↑u⁻¹ : O) ^ 2 * (t : O)) ^ 2 * h1) := by
  have hsum := hasSum_diagonal_unit_integrals u t v hv s h hs
  rw [← hsum.tsum_eq]
  have he := affineCusp_branch_fourier h h1 (t : O) (u⁻¹ ^ 2 * t) 0 t.ne_zero hh hfreq v hv s (by linarith)
    (by simpa only [pow_zero, mul_one, Units.val_mul, Units.val_pow_eq_pow_val] using hsum.summable)
  simpa only [pow_zero, mul_one, Units.val_mul, Units.val_pow_eq_pow_val,
    norm_ringComplex_unit, one_pow, Complex.ofReal_one, Complex.one_cpow,
    Ideal.span_singleton_eq_top.mpr t.isUnit, Ideal.absNorm_top, Nat.cast_one, one_mul] using he

/-- The six units are the signed powers of the primitive cubic root. -/
lemma unit_eq_sign_omega (u : Oˣ) :
    ∃ j : Fin 3, (u : O) = omega ^ j.val ∨ (u : O) = -(omega ^ j.val) := by
  letI : IsCyclotomicExtension {3} ℚ K := CyclotomicField.isCyclotomicExtension 3 ℚ
  let ζ := IsCyclotomicExtension.zeta_spec 3 ℚ K
  let η : Oˣ := (ζ.toInteger_isPrimitiveRoot.isUnit (by decide)).unit
  have hη : (η : O) = omega := rfl
  have hu : u ∈ ([1, -1, η, -η, η ^ 2, -η ^ 2] : List Oˣ) :=
    IsCyclotomicExtension.Rat.Three.Units.mem ζ u
  simp only [List.mem_cons, List.mem_nil_iff, or_false] at hu
  rcases hu with h | h | h | h | h | h
  · exact ⟨0, Or.inl (by simp [h])⟩
  · exact ⟨0, Or.inr (by simp [h])⟩
  · exact ⟨1, Or.inl (by simp [h, hη])⟩
  · exact ⟨1, Or.inr (by simp [h, hη])⟩
  · exact ⟨2, Or.inl (by simp [h, hη])⟩
  · exact ⟨2, Or.inr (by simp [h, hη])⟩

abbrev HalfPrimary := {b : O // lambda ∣ b - 1}

lemma halfPrimary_omega_pow (j : ℕ) : lambda ∣ omega ^ j - 1 := by
  simpa only [lambda_def, one_pow] using sub_dvd_pow_sub_pow omega (1 : O) j

lemma halfPrimary_not_negative (j : ℕ) : ¬lambda ∣ -(omega ^ j) - 1 := by
  intro h
  apply lambda_not_dvd_two
  convert dvd_neg.mpr (dvd_add h (halfPrimary_omega_pow j)) using 1 <;> ring

lemma halfPrimary_not_dvd (b : HalfPrimary) : ¬lambda ∣ b.1 := by
  intro h
  apply residue_lambda_prime.2.1
  apply isUnit_of_dvd_one
  convert dvd_sub h b.2 using 1 <;> ring

/-- Congruence modulo the ramified prime leaves exactly three primary associates. -/
def halfPrimaryFromIdeal (p : Fin 3 × GoodIdeal) : HalfPrimary :=
  ⟨omega ^ p.1.val * primaryIdealGenerator p.2.1, by
    have ha : lambda ∣ primaryIdealGenerator p.2.1 - 1 :=
      (dvd_pow_self lambda (by decide : 2 ≠ 0)).trans (primaryIdealGenerator_spec p.2.1 p.2.2).2
    convert dvd_add ((halfPrimary_omega_pow p.1.val).mul_right (primaryIdealGenerator p.2.1)) ha
      using 1 <;> ring⟩

lemma halfPrimaryFromIdeal_injective : Function.Injective halfPrimaryFromIdeal := by
  intro p q hpq
  have he : omega ^ p.1.val * primaryIdealGenerator p.2.1 =
      omega ^ q.1.val * primaryIdealGenerator q.2.1 := congrArg Subtype.val hpq
  have hunit (j : Fin 3) : IsUnit (omega ^ j.val) := (omega_primitive.isUnit (by decide)).pow _
  have hi : p.2 = q.2 := by
    apply Subtype.ext
    have hs := congrArg (fun z : O => (Ideal.span {z} : Ideal O)) he
    simpa only [Ideal.span_singleton_mul_left_unit (hunit p.1),
      Ideal.span_singleton_mul_left_unit (hunit q.1),
      (primaryIdealGenerator_spec p.2.1 p.2.2).1,
      (primaryIdealGenerator_spec q.2.1 q.2.2).1] using hs
  have hj : p.1 = q.1 := by
    apply Fin.ext
    apply omega_primitive.pow_inj p.1.isLt q.1.isLt
    rw [hi] at he
    exact mul_right_cancel₀ q.2.2 he
  exact Prod.ext hj hi

lemma halfPrimaryFromIdeal_surjective : Function.Surjective halfPrimaryFromIdeal := by
  intro b
  let I : GoodIdeal := ⟨Ideal.span {b.1},
    (primaryIdealGenerator_span_ne_zero_iff b.1).mpr (halfPrimary_not_dvd b)⟩
  have hs : Associated (primaryIdealGenerator I.1) b.1 :=
    Ideal.span_singleton_eq_span_singleton.mp (primaryIdealGenerator_spec I.1 I.2).1
  obtain ⟨u, hu⟩ := hs
  have he : (u : O) * primaryIdealGenerator I.1 = b.1 := by simpa only [mul_comm] using hu
  have hup : lambda ∣ (u : O) - 1 := by
    have ha : lambda ∣ primaryIdealGenerator I.1 - 1 :=
      (dvd_pow_self lambda (by decide : 2 ≠ 0)).trans (primaryIdealGenerator_spec I.1 I.2).2
    have hd := dvd_sub b.2 (ha.mul_left (u : O))
    rw [← he] at hd
    convert hd using 1 <;> ring
  obtain ⟨j, hj | hj⟩ := unit_eq_sign_omega u
  · exact ⟨(j, I), Subtype.ext (by simpa only [halfPrimaryFromIdeal, hj] using he)⟩
  · exact (halfPrimary_not_negative j.val (by simpa only [hj] using hup)).elim

def halfPrimaryIdealEquiv : (Fin 3 × GoodIdeal) ≃ HalfPrimary :=
  Equiv.ofBijective halfPrimaryFromIdeal
    ⟨halfPrimaryFromIdeal_injective, halfPrimaryFromIdeal_surjective⟩

/-- The once-ramified scale and its complementary divisor of three. -/
def onceCuspScale (u : Oˣ) : O := (u : O) * traceLambda

def onceCuspComplement (u : Oˣ) : O := -(↑u⁻¹ : O) * traceLambda

lemma traceLambda_square : traceLambda ^ 2 = (-3 : O) := by
  rw [traceLambda_eq_unit_mul_lambda, mul_pow, lambda_sq_eq]
  calc
    _ = -3 * omega ^ 3 := by ring
    _ = -3 := by rw [omega_primitive.pow_eq_one]; ring

lemma onceCusp_scale_complement (u : Oˣ) : onceCuspScale u * onceCuspComplement u = 3 := by
  calc
    _ = -((u : O) * (↑u⁻¹ : O)) * traceLambda ^ 2 := by
      unfold onceCuspScale onceCuspComplement
      ring
    _ = 3 := by simp [traceLambda_square]

lemma onceCusp_scale_ne_zero (u : Oˣ) : onceCuspScale u ≠ 0 := by
  intro h
  have he := onceCusp_scale_complement u
  rw [h, zero_mul] at he
  exact (by norm_num : (0 : O) ≠ 3) he

lemma onceCusp_scale_lambda (u : Oˣ) : (3 : O) ∣ onceCuspScale u * lambda := by
  refine ⟨(u : O) * omega ^ 2, ?_⟩
  calc
    _ = -(u : O) * omega * lambda ^ 2 := by
      rw [onceCuspScale, traceLambda_eq_unit_mul_lambda]
      ring
    _ = _ := by rw [lambda_sq_eq]; ring

lemma onceCusp_complement_lambda (u : Oˣ) : lambda ∣ onceCuspComplement u := by
  refine ⟨(↑u⁻¹ : O) * omega, ?_⟩
  rw [onceCuspComplement, traceLambda_eq_unit_mul_lambda]
  ring

lemma onceCusp_scale_coprime (u : Oˣ) (d : O) (hd : lambda ^ 2 ∣ d - 1) :
    IsCoprime (onceCuspScale u) d := by
  apply (isCoprime_mul_unit_left_left u.isUnit _ _).mpr
  apply (primary_coprime_three d hd).symm.of_isCoprime_of_dvd_left
  refine ⟨-traceLambda, ?_⟩
  linear_combination traceLambda_square

lemma isCoprime_right_congr_of_dvd (a b c : O) (h : a ∣ b - c) :
    IsCoprime a b ↔ IsCoprime a c := by
  obtain ⟨k, hk⟩ := h
  constructor
  · rintro ⟨r, t, ht⟩
    exact ⟨r + t * k, t, by linear_combination ht - t * hk⟩
  · rintro ⟨r, t, ht⟩
    exact ⟨r - t * k, t, by linear_combination ht + t * hk⟩

lemma unitLowerDenominator_coprime (p : OppositeData) :
    IsCoprime (primaryIdealGenerator p.1.1) (primaryIdealGenerator p.1.1 + 3 * p.2.1) := by
  apply (isCoprime_right_congr_of_dvd (primaryIdealGenerator p.1.1)
    (primaryIdealGenerator p.1.1 + 3 * p.2.1) (3 * p.2.1) ⟨1, by ring⟩).mpr
  exact (primary_coprime_three _ (primaryIdealGenerator_spec p.1.1 p.1.2).2).mul_right p.2.2

abbrev OnceRamifiedData := Fin 3 × OppositeData

/-- Each once-ramified row consists of one of three primary associates and a primary denominator. -/
def onceRamifiedToPrimitive (u : Oˣ) (p : OnceRamifiedData) : PrimitiveRow := by
  let a := primaryIdealGenerator p.2.1.1
  let b := omega ^ p.1.val * a
  let d := a + 3 * p.2.2.1
  refine ⟨![onceCuspScale u * (b - d), d], ?_⟩
  change IsCoprime (onceCuspScale u * (b - d)) d ∧
    (3 : O) ∣ onceCuspScale u * (b - d) ∧ (3 : O) ∣ d - 1
  have hd : lambda ^ 2 ∣ d - 1 := unitLowerDenominator_primary p.2
  refine ⟨?_, ?_, three_dvd_primary_sub_one d hd⟩
  · apply (onceCusp_scale_coprime u d hd).mul_left
    apply IsCoprime.symm
    apply (isCoprime_right_congr_of_dvd d (b - d) b ⟨-1, by ring⟩).mpr
    exact ((isCoprime_mul_unit_left_left ((omega_primitive.isUnit (by decide)).pow _) _ _).mpr
      (unitLowerDenominator_coprime p.2)).symm
  · have hb : lambda ∣ b - 1 := (halfPrimaryFromIdeal (p.1, p.2.1)).2
    have hd' : lambda ∣ d - 1 := (dvd_pow_self lambda (by decide : 2 ≠ 0)).trans hd
    have hbd : lambda ∣ b - d := by
      simpa only [sub_sub_sub_cancel_right] using dvd_sub hb hd'
    obtain ⟨k, hk⟩ := hbd
    rw [hk, ← mul_assoc]
    exact (onceCusp_scale_lambda u).mul_right k

lemma onceRamifiedToPrimitive_injective (u : Oˣ) : Function.Injective (onceRamifiedToPrimitive u) := by
  rintro ⟨j, I, x, hx⟩ ⟨k, J, y, hy⟩ he
  have hd : primaryIdealGenerator I.1 + 3 * x = primaryIdealGenerator J.1 + 3 * y :=
    congrFun (congrArg Subtype.val he) 1
  have hc : onceCuspScale u * (omega ^ j.val * primaryIdealGenerator I.1 -
      (primaryIdealGenerator I.1 + 3 * x)) =
      onceCuspScale u * (omega ^ k.val * primaryIdealGenerator J.1 -
        (primaryIdealGenerator J.1 + 3 * y)) := congrFun (congrArg Subtype.val he) 0
  have hb := mul_left_cancel₀ (onceCusp_scale_ne_zero u) hc
  have hi : (j, I) = (k, J) := halfPrimaryFromIdeal_injective (Subtype.ext (by
    change omega ^ j.val * primaryIdealGenerator I.1 = omega ^ k.val * primaryIdealGenerator J.1
    linear_combination hb + hd))
  obtain rfl : j = k := congrArg Prod.fst hi
  obtain rfl : I = J := congrArg Prod.snd hi
  have hxy : x = y := mul_left_cancel₀ (by norm_num : (3 : O) ≠ 0) (add_left_cancel hd)
  subst y
  rfl

lemma onceRamifiedToPrimitive_surjective (u : Oˣ) : Function.Surjective (onceRamifiedToPrimitive u) := by
  intro r
  obtain ⟨k, hk⟩ := r.2.2.1
  let d := r.1 1
  have hdp : lambda ^ 2 ∣ d - 1 := lambda_sq_dvd_three.trans r.2.2.2
  let b : HalfPrimary := ⟨onceCuspComplement u * k + d, by
    have hh := dvd_add ((onceCusp_complement_lambda u).mul_right k)
      ((dvd_pow_self lambda (by decide : 2 ≠ 0)).trans hdp)
    convert hh using 1 <;> ring⟩
  let p := halfPrimaryIdealEquiv.symm b
  have hp : omega ^ p.1.val * primaryIdealGenerator p.2.1 = b.1 :=
    congrArg Subtype.val (halfPrimaryIdealEquiv.apply_symm_apply b)
  have hr : onceCuspScale u * (b.1 - d) = r.1 0 := by
    change onceCuspScale u * (onceCuspComplement u * k + d - d) = _
    rw [add_sub_cancel_right, ← mul_assoc, onceCusp_scale_complement, ← hk]
  have had : IsCoprime (primaryIdealGenerator p.2.1) d := by
    have h0 : IsCoprime (b.1 - d) d :=
      (hr ▸ r.2.1).of_isCoprime_of_dvd_left (dvd_mul_left _ _)
    have hb : IsCoprime b.1 d := by
      apply IsCoprime.symm
      exact (isCoprime_right_congr_of_dvd d (b.1 - d) b.1 ⟨-1, by ring⟩).mp h0.symm
    rw [← hp] at hb
    exact hb.of_isCoprime_of_dvd_left (dvd_mul_left _ _)
  have hda : (3 : O) ∣ d - primaryIdealGenerator p.2.1 := by
    have hh := dvd_sub r.2.2.2
      (three_dvd_primary_sub_one _ (primaryIdealGenerator_spec p.2.1 p.2.2).2)
    simpa only [sub_sub_sub_cancel_right] using hh
  obtain ⟨x, hx⟩ := hda
  have hd : d = primaryIdealGenerator p.2.1 + 3 * x := by linear_combination hx
  have hax : IsCoprime (primaryIdealGenerator p.2.1) x := by
    have hh : IsCoprime (primaryIdealGenerator p.2.1) (3 * x) :=
      (isCoprime_right_congr_of_dvd (primaryIdealGenerator p.2.1) d (3 * x)
        ⟨1, by linear_combination hd⟩).mp had
    exact hh.of_isCoprime_of_dvd_right (dvd_mul_left _ _)
  refine ⟨(p.1, ⟨p.2, x, hax⟩), Subtype.ext ?_⟩
  funext i
  fin_cases i
  · change onceCuspScale u * (omega ^ p.1.val * primaryIdealGenerator p.2.1 -
      (primaryIdealGenerator p.2.1 + 3 * x)) = r.1 0
    rw [← hd, hp, hr]
  · exact hd.symm

def onceRamifiedDataEquiv (u : Oˣ) : OnceRamifiedData ≃ PrimitiveRow :=
  Equiv.ofBijective (onceRamifiedToPrimitive u)
    ⟨onceRamifiedToPrimitive_injective u, onceRamifiedToPrimitive_surjective u⟩

lemma onceRamified_row_phase (u : Oˣ) (p : OnceRamifiedData) :
    (cosetCharacter (primitiveRowEquiv.symm (onceRamifiedDataEquiv u p)))⁻¹ =
      ringComplex (symbol (onceCuspScale u * omega ^ p.1.val)
        (primaryIdealGenerator p.2.1.1 + 3 * p.2.2.1)) *
      ringComplex (symbol (primaryIdealGenerator p.2.1.1 + 3 * p.2.2.1)
        (primaryIdealGenerator p.2.1.1)) := by
  rw [inverse_cosetCharacter_eq_row_symbol, primitiveRowEquiv_symm_row]
  change ringComplex (symbol (onceCuspScale u *
    (omega ^ p.1.val * primaryIdealGenerator p.2.1.1 - (primaryIdealGenerator p.2.1.1 + 3 * p.2.2.1)))
    (primaryIdealGenerator p.2.1.1 + 3 * p.2.2.1)) = _
  rw [symbol_congr (show primaryIdealGenerator p.2.1.1 + 3 * p.2.2.1 ∣
      onceCuspScale u * (omega ^ p.1.val * primaryIdealGenerator p.2.1.1 -
        (primaryIdealGenerator p.2.1.1 + 3 * p.2.2.1)) -
      (onceCuspScale u * omega ^ p.1.val) * primaryIdealGenerator p.2.1.1 from
        ⟨-onceCuspScale u, by ring⟩),
    symbol_mul_numerator, map_mul,
    symbol_reciprocity _ _ (primaryIdealGenerator_spec p.2.1.1 p.2.1.2).2
      (unitLowerDenominator_primary p.2)]

/-- A diagonal unit rescales the row by a norm-one scalar. -/
lemma diagonal_once_summand (u t : Oˣ) (z : ℂ) (v : ℝ) (hv : 0 < v) (s : ℂ)
    (p : OnceRamifiedData) :
    summand (integralComplexMatrix (unitCuspDiagonal u) *
      integralComplexMatrix (lowerCuspMatrix (onceCuspScale t)) * upperSection z v hv) s
      (primitiveRowEquiv.symm (onceRamifiedDataEquiv (u⁻¹ ^ 2 * t) p)) =
      affineLowerTerm (onceCuspScale t * omega ^ p.1.val)
        ((↑u⁻¹ : O) ^ 2 * (onceCuspScale t * omega ^ p.1.val)) z v s
          (primaryIdealGenerator p.2.1.1) (primaryIdealGenerator p.2.1.1 + 3 * p.2.2.1) := by
  let r : Fin 2 → ℂ := ![ringComplex ((onceCuspScale t * omega ^ p.1.val) * primaryIdealGenerator p.2.1.1),
    ringComplex (primaryIdealGenerator p.2.1.1 + 3 * p.2.2.1)]
  have hscale : (u : O) * onceCuspScale (u⁻¹ ^ 2 * t) = (↑u⁻¹ : O) * onceCuspScale t := by
    simp [onceCuspScale, pow_two, ← mul_assoc]
  have hr : rowOperator (integralComplexMatrix (unitCuspDiagonal u) *
      integralComplexMatrix (lowerCuspMatrix (onceCuspScale t)))
      (embeddedRow (primitiveRowEquiv.symm (onceRamifiedDataEquiv (u⁻¹ ^ 2 * t) p))) =
        ringComplex (↑u⁻¹ : O) • r := by
    rw [← rowOperator_mul, embeddedRow, primitiveRowEquiv_symm_row,
      rowOperator_unitDiagonal, rowOperator_lowerCusp]
    funext i
    fin_cases i
    · change ringComplex (u : O) * ringComplex (onceCuspScale (u⁻¹ ^ 2 * t) *
        (omega ^ p.1.val * primaryIdealGenerator p.2.1.1 -
          (primaryIdealGenerator p.2.1.1 + 3 * p.2.2.1))) +
        ringComplex (onceCuspScale t) * (ringComplex (↑u⁻¹ : O) *
          ringComplex (primaryIdealGenerator p.2.1.1 + 3 * p.2.2.1)) =
        ringComplex (↑u⁻¹ : O) *
          ringComplex ((onceCuspScale t * omega ^ p.1.val) * primaryIdealGenerator p.2.1.1)
      rw [map_mul, ← mul_assoc, ← map_mul, hscale]
      simp only [map_mul, map_sub]
      ring
    · rfl
  have hr0 : r ≠ 0 := by
    intro hh
    exact ringComplex_ne_zero (mul_ne_zero (mul_ne_zero (onceCusp_scale_ne_zero t)
      (pow_ne_zero _ (omega_primitive.isUnit (by decide)).ne_zero)) p.2.1.2) (congrFun hh 0)
  have hp := heightDenominator_pos z v hv r hr0
  rw [summand, ← rowOperator_mul, hr, map_smul, rowEnergy_complex_smul,
    norm_ringComplex_unit, one_pow, one_mul, rowEnergy_upperSection, onceRamified_row_phase]
  have hphase : onceCuspScale (u⁻¹ ^ 2 * t) * omega ^ p.1.val =
      (↑u⁻¹ : O) ^ 2 * (onceCuspScale t * omega ^ p.1.val) := by
    simp only [onceCuspScale, Units.val_mul, Units.val_pow_eq_pow_val]
    ring
  rw [hphase]
  change _ = _ * ((v / heightDenominator z v r : ℝ) : ℂ) ^ s
  rw [show ((v / heightDenominator z v r : ℝ) : ℂ) =
    (((heightDenominator z v r / v : ℝ) : ℂ))⁻¹ by simp only [Complex.ofReal_div, inv_div],
    inv_cpow_ofReal_nonneg (div_nonneg hp.le hv.le), Complex.cpow_neg]

lemma hasSum_diagonal_once_integrals (u t : Oˣ) (v : ℝ) (hv : 0 < v) (s : ℂ) (h : O) (hs : 2 < s.re) :
    HasSum (fun p : OnceRamifiedData => affineLowerFourierTerm (onceCuspScale t * omega ^ p.1.val)
      ((↑u⁻¹ : O) ^ 2 * (onceCuspScale t * omega ^ p.1.val)) h v s
        (primaryIdealGenerator p.2.1.1) p.2.2.1)
      (∫ z in periodDomain, eisenstein (integralComplexMatrix (unitCuspDiagonal u) *
        integralComplexMatrix (lowerCuspMatrix (onceCuspScale t)) * upperSection z v hv) s *
          tracePhase (-ninthCuspFrequency h * z)) := by
  let e := (onceRamifiedDataEquiv (u⁻¹ ^ 2 * t)).trans primitiveRowEquiv.symm
  have he := e.hasSum_iff.mpr (hasSum_integral_fixed_left_Eisenstein
    (integralComplexMatrix (unitCuspDiagonal u) * integralComplexMatrix (lowerCuspMatrix (onceCuspScale t)))
      v hv s (ninthCuspFrequency h) hs)
  apply he.congr_fun
  intro p
  apply integral_congr_ae
  exact Eventually.of_forall (fun z => by
    dsimp only [affineLowerFourierTerm, e, Equiv.trans_apply, Function.comp_apply]
    rw [diagonal_once_summand])

def cuspOmegaUnit : Oˣ := (omega_primitive.isUnit (by decide)).unit

lemma cuspOmegaUnit_val : (cuspOmegaUnit : O) = omega :=
  (omega_primitive.isUnit (by decide)).unit_spec

/-- The unit part of the once-ramified cubic numerator. -/
def onceCuspArithmeticUnit (u t : Oˣ) (j : Fin 3) : Oˣ :=
  u⁻¹ ^ 2 * t * (-cuspOmegaUnit) * cuspOmegaUnit ^ j.val

lemma onceCuspArithmeticUnit_spec (u t : Oˣ) (j : Fin 3) :
    (onceCuspArithmeticUnit u t j : O) * lambda =
      (↑u⁻¹ : O) ^ 2 * (onceCuspScale t * omega ^ j.val) := by
  simp only [onceCuspArithmeticUnit, onceCuspScale, Units.val_mul, Units.val_pow_eq_pow_val,
    Units.val_neg, cuspOmegaUnit_val, traceLambda_eq_unit_mul_lambda]
  ring

lemma onceCusp_q_norm (t : Oˣ) (j : Fin 3) :
    ‖ringComplex (onceCuspScale t * omega ^ j.val)‖ ^ 2 = 3 := by
  have hw : ‖ringComplex omega‖ = 1 := by
    rw [← cuspOmegaUnit_val]
    exact norm_ringComplex_unit cuspOmegaUnit
  simp only [onceCuspScale, map_mul, norm_mul, norm_ringComplex_unit, one_mul,
    map_pow, norm_pow, hw, one_pow, mul_one]
  rw [← norm_pow, ← map_pow, traceLambda_square]
  norm_num [map_ofNat]

lemma onceCusp_q_absNorm (t : Oˣ) (j : Fin 3) :
    Ideal.absNorm (Ideal.span {onceCuspScale t * omega ^ j.val}) = 3 := by
  have hh := onceCusp_q_norm t j
  rw [ringComplex_norm_sq_eq_absNorm_span] at hh
  exact_mod_cast hh

/-- An active once-ramified branch has norm-three scale and one unramified Gauss series. -/
theorem diagonal_once_branch_fourier (u t : Oˣ) (j : Fin 3) (h h1 : O)
    (hh : h = (onceCuspScale t * omega ^ j.val) * h1)
    (hfreq : (3 : O) ∣ h1 + ramifiedArithmeticPhase (onceCuspArithmeticUnit u t j) 1)
    (v : ℝ) (hv : 0 < v) (s : ℂ) (hs : 2 < s.re) :
    (∑' p : OppositeData, affineLowerFourierTerm (onceCuspScale t * omega ^ j.val)
      ((↑u⁻¹ : O) ^ 2 * (onceCuspScale t * omega ^ j.val)) h v s
        (primaryIdealGenerator p.1.1) p.2.1) =
      (3 : ℂ) * (3 : ℂ) ^ (-s) *
        ((v : ℂ) ^ (2 - s) * sourceFourierKernel s (ninthCuspFrequency h * v)) *
          tracePhase (ninthCuspFrequency h / ringComplex (onceCuspScale t * omega ^ j.val)) *
            unramifiedCubicGaussSeries s (3 * ((↑u⁻¹ : O) ^ 2 * (onceCuspScale t * omega ^ j.val)) ^ 2 * h1) := by
  have hsum := (hasSum_diagonal_once_integrals u t v hv s h hs).summable.prod_factor j
  have hq := mul_ne_zero (onceCusp_scale_ne_zero t)
    (pow_ne_zero j.val (omega_primitive.isUnit (by decide)).ne_zero)
  have he := affineCusp_branch_fourier h h1 (onceCuspScale t * omega ^ j.val)
    (onceCuspArithmeticUnit u t j) 1 hq hh hfreq v hv s (by linarith)
      (by simpa only [pow_one, onceCuspArithmeticUnit_spec] using hsum)
  simpa only [pow_one, onceCuspArithmeticUnit_spec, onceCusp_q_norm, onceCusp_q_absNorm,
    Nat.cast_ofNat, Complex.ofReal_ofNat] using he

/-- Residue weights survive lattice unfolding as their finite sum. -/
theorem quotient_weighted_period_unfold (q : O) (hq : q ≠ 0)
    (ψ : (O ⧸ Ideal.span {q}) → ℂ) (f : ℂ → ℂ) (hf : Integrable f) :
    (∑' n : O, ψ (Ideal.Quotient.mk (Ideal.span {q}) n) *
      ∫ z in periodDomain, f (z + 3 * ringComplex n / ringComplex q)) =
      (∑' r : O ⧸ Ideal.span {q}, ψ r) * (∫ z : ℂ, f z) := by
  letI : Finite (O ⧸ Ideal.span {q}) := (Ideal.span {q}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr hq)
  letI : Fintype (O ⧸ Ideal.span {q}) := Fintype.ofFinite _
  let I : O → ℂ := fun n => ∫ z in periodDomain, f (z + 3 * ringComplex n / ringComplex q)
  have hs : Summable (fun n : O => ψ (Ideal.Quotient.mk (Ideal.span {q}) n) * I n) := by
    apply (((finite_index_period_integrals_summable q hq f hf).norm).mul_left ‖ψ‖).of_norm_bounded
    intro n
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_right (norm_le_pi_norm ψ _) (norm_nonneg _)
  have hinner (r : O ⧸ Ideal.span {q}) :
      (∑' n : ((Ideal.Quotient.mk (Ideal.span {q})) ⁻¹' {r}),
        ψ (Ideal.Quotient.mk (Ideal.span {q}) n.1) * I n.1) = ψ r * (∫ z : ℂ, f z) := by
    have heval (n : ((Ideal.Quotient.mk (Ideal.span {q})) ⁻¹' {r})) :
        Ideal.Quotient.mk (Ideal.span {q}) n.1 = r := n.2
    simp_rw [heval]
    rw [tsum_mul_left, ← (principalResidueFiberEquiv q hq r).tsum_eq]
    congr 1
    change (∑' n : O, ∫ z in periodDomain,
      f (z + 3 * ringComplex (principalResidueRep q r + q * n) / ringComplex q)) = _
    simp_rw [finite_index_period_shift q hq]
    rw [← integral_eq_period_integrals _ (hf.comp_add_right _)]
    exact integral_add_right_eq_self f _
  rw [← (hs.hasSum.tsum_fiberwise (Ideal.Quotient.mk (Ideal.span {q}))).tsum_eq]
  change (∑' r : O ⧸ Ideal.span {q}, ∑' n : ((Ideal.Quotient.mk (Ideal.span {q})) ⁻¹' {r}),
    ψ (Ideal.Quotient.mk (Ideal.span {q}) n.1) * I n.1) = _
  simp_rw [hinner]
  exact tsum_mul_right

theorem character_weighted_period_unfold (q : O) (hq : q ≠ 0)
    (ψ : AddChar (O ⧸ Ideal.span {q}) ℂ) (f : ℂ → ℂ) (hf : Integrable f) :
    (∑' n : O, ψ (Ideal.Quotient.mk (Ideal.span {q}) n) *
      ∫ z in periodDomain, f (z + 3 * ringComplex n / ringComplex q)) =
      if ψ = 1 then (Ideal.absNorm (Ideal.span {q}) : ℂ) * (∫ z : ℂ, f z) else 0 := by
  letI : Finite (O ⧸ Ideal.span {q}) := (Ideal.span {q}).finiteQuotientOfFreeOfNeBot
    (Ideal.span_singleton_eq_bot.not.mpr hq)
  letI : Fintype (O ⧸ Ideal.span {q}) := Fintype.ofFinite _
  rw [quotient_weighted_period_unfold q hq ψ f hf, tsum_fintype]
  split_ifs with hψ
  · rw [AddChar.sum_eq_card_of_eq_one hψ]
    congr 1
    change (Fintype.card (O ⧸ Ideal.span {q}) : ℂ) = (Nat.card (O ⧸ Ideal.span {q}) : ℂ)
    rw [Nat.card_eq_fintype_card]
  · rw [AddChar.sum_eq_zero_of_ne_one hψ, zero_mul]

lemma residueTraceQuotientChar_eq_one (q : O) (hq : q ≠ 0) (ell : O) :
    residueTraceQuotientChar ell q hq = 1 ↔ q ∣ ell := by
  constructor
  · intro he
    by_contra hn
    exact residueTraceQuotientChar_ne_one q ell hq hn he
  · intro hd
    rw [residueTraceQuotientChar_mulShift,
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton.mpr hd), AddChar.mulShift_zero]

lemma residueTraceQuotientChar_phase (q : O) (hq : q ≠ 0) (ell x : O) :
    residueTraceQuotientChar ell q hq (Ideal.Quotient.mk (Ideal.span {q}) x) =
      tracePhase (ringComplex (ell * x) / (ringComplex q * ringComplex traceLambda)) := by
  rw [residueTraceQuotientChar_mk]
  unfold residueAdditive cuspFrequency
  congr 1
  simp only [map_mul, map_ofNat]
  field_simp [ringComplex_ne_zero hq, ringComplex_ne_zero traceLambda_ne_zero] <;> ring

/-- A translated affine row acquires precisely the residue character of its combined frequency. -/
lemma affineCusp_general_weighted_translate (h q a ell x m : O) (u : Oˣ) (n : ℕ)
    (hap : lambda ^ 2 ∣ a - 1) (hq : q ≠ 0)
    (hell : 3 * ell = h + ramifiedArithmeticPhase u n * q * a) (z : ℂ) (v : ℝ) (s : ℂ) :
    affineLowerTerm q ((u : O) * lambda ^ n) z v s a (a + 3 * (x + a * m)) *
      tracePhase (-ninthCuspFrequency h * z) =
      residueTraceQuotientChar ell q hq (Ideal.Quotient.mk (Ideal.span {q}) m) *
        (affineLowerTerm q ((u : O) * lambda ^ n) (z + 3 * ringComplex m / ringComplex q) v s a (a + 3 * x) *
          tracePhase (-ninthCuspFrequency h * (z + 3 * ringComplex m / ringComplex q))) := by
  let A := cuspFrequency (ramifiedArithmeticPhase u n) * ringComplex (a * m)
  let delta := 3 * ringComplex m / ringComplex q
  have hchar : ringComplex (symbol ((u : O) * lambda ^ n) (a + 3 * (x + a * m))) =
      ringComplex (symbol ((u : O) * lambda ^ n) (a + 3 * x)) * tracePhase A := by
    have hd : lambda ^ 2 ∣ a + 3 * x - 1 := by
      convert dvd_add hap (lambda_sq_dvd_three.mul_right x) using 1 <;> ring
    convert ramified_symbol_primary_affine u n (a + 3 * x) (a * m) hd using 1 <;> ring
  have hden : symbol (a + 3 * (x + a * m)) a = symbol (a + 3 * x) a :=
    symbol_congr ⟨3 * m, by ring⟩
  have hrow : ringComplex (q * a) * z + ringComplex (a + 3 * (x + a * m)) =
      ringComplex (q * a) * (z + delta) + ringComplex (a + 3 * x) := by
    dsimp only [delta]
    simp only [map_add, map_mul, map_ofNat]
    field_simp [ringComplex_ne_zero hq] <;> ring
  have hell' : ringComplex ell =
      (ringComplex h + ringComplex (ramifiedArithmeticPhase u n) * ringComplex q * ringComplex a) / 3 := by
    apply (eq_div_iff (by norm_num : (3 : ℂ) ≠ 0)).mpr
    have he := congrArg ringComplex hell
    simp only [map_mul, map_add, map_ofNat] at he
    linear_combination he
  have harg : A + ninthCuspFrequency h * delta =
      ringComplex (ell * m) / (ringComplex q * ringComplex traceLambda) := by
    dsimp only [A, delta, ninthCuspFrequency, cuspFrequency]
    simp only [map_mul]
    rw [hell']
    field_simp [ringComplex_ne_zero hq, ringComplex_ne_zero traceLambda_ne_zero] <;> ring
  have hphase : tracePhase A * tracePhase (-ninthCuspFrequency h * z) =
      residueTraceQuotientChar ell q hq (Ideal.Quotient.mk (Ideal.span {q}) m) *
        tracePhase (-ninthCuspFrequency h * (z + delta)) := by
    rw [residueTraceQuotientChar_phase, ← harg, ← AddChar.map_add_eq_mul, ← AddChar.map_add_eq_mul]
    congr 1
    ring
  unfold affineLowerTerm
  rw [hchar, hden, hrow]
  change _ = residueTraceQuotientChar ell q hq (Ideal.Quotient.mk (Ideal.span {q}) m) *
    ((ringComplex (symbol ((u : O) * lambda ^ n) (a + 3 * x)) * ringComplex (symbol (a + 3 * x) a)) *
      ((v / (‖ringComplex (q * a) * (z + delta) + ringComplex (a + 3 * x)‖ ^ 2 +
        ‖ringComplex (q * a)‖ ^ 2 * v ^ 2) : ℝ) : ℂ) ^ s *
          tracePhase (-ninthCuspFrequency h * (z + delta)))
  linear_combination
    (ringComplex (symbol ((u : O) * lambda ^ n) (a + 3 * x)) * ringComplex (symbol (a + 3 * x) a) *
      ((v / (‖ringComplex (q * a) * (z + delta) + ringComplex (a + 3 * x)‖ ^ 2 +
        ‖ringComplex (q * a)‖ ^ 2 * v ^ 2) : ℝ) : ℂ) ^ s) * hphase

lemma affineCusp_masked_inner (h q a ell x : O) (u : Oˣ) (n : ℕ)
    (ha : a ≠ 0) (hap : lambda ^ 2 ∣ a - 1) (hq : q ≠ 0)
    (hell : 3 * ell = h + ramifiedArithmeticPhase u n * q * a)
    (v : ℝ) (hv : 0 < v) (s : ℂ) (hs : 1 < s.re) :
    (∑' m : O, ∫ z in periodDomain,
      affineLowerTerm q ((u : O) * lambda ^ n) z v s a (a + 3 * (x + a * m)) *
        tracePhase (-ninthCuspFrequency h * z)) =
      if q ∣ ell then (Ideal.absNorm (Ideal.span {q}) : ℂ) *
        (∫ z : ℂ, affineLowerTerm q ((u : O) * lambda ^ n) z v s a (a + 3 * x) *
          tracePhase (-ninthCuspFrequency h * z)) else 0 := by
  have hint := trace_mul_integrable
    (fun z => affineLowerTerm q ((u : O) * lambda ^ n) z v s a (a + 3 * x))
    (affineLowerTerm_integrable q ((u : O) * lambda ^ n) v hv s hs a (a + 3 * x) ha hq)
    (ninthCuspFrequency h)
  simp_rw [affineCusp_general_weighted_translate h q a ell x _ u n hap hq hell, integral_const_mul]
  rw [character_weighted_period_unfold q hq (residueTraceQuotientChar ell q hq) _ hint]
  simp only [residueTraceQuotientChar_eq_one]

/-- Nontrivial residue characters cancel every inactive denominator fiber. -/
lemma affineDenominator_zero (h h1 q a : O) (u : Oˣ) (n : ℕ)
    (ha : a ≠ 0) (hap : lambda ^ 2 ∣ a - 1) (hq : q ≠ 0) (hh : h = q * h1)
    (hbase : (3 : O) ∣ h + ramifiedArithmeticPhase u n * q)
    (hfreq : ¬(3 : O) ∣ h1 + ramifiedArithmeticPhase u n)
    (v : ℝ) (hv : 0 < v) (s : ℂ) (hs : 1 < s.re)
    (hsum : Summable (fun x : CoprimeElement a => affineLowerFourierTerm q ((u : O) * lambda ^ n) h v s a x.1)) :
    (∑' x : CoprimeElement a, affineLowerFourierTerm q ((u : O) * lambda ^ n) h v s a x.1) = 0 := by
  have hdiv : (3 : O) ∣ h + ramifiedArithmeticPhase u n * q * a := by
    have ht := dvd_add hbase ((three_dvd_primary_sub_one a hap).mul_left (ramifiedArithmeticPhase u n * q))
    convert ht using 1 <;> ring
  obtain ⟨ell, hell⟩ := hdiv
  have hell' : 3 * ell = h + ramifiedArithmeticPhase u n * q * a := hell.symm
  have hne : ¬q ∣ ell := by
    rintro ⟨b, hb⟩
    have he : q * (3 * b) = q * (h1 + ramifiedArithmeticPhase u n * a) := by
      rw [hb, hh] at hell'
      linear_combination hell'
    have hc := mul_left_cancel₀ hq he
    have ht : (3 : O) ∣ h1 + ramifiedArithmeticPhase u n * a := ⟨b, hc.symm⟩
    apply hfreq
    convert dvd_sub ht ((three_dvd_primary_sub_one a hap).mul_left (ramifiedArithmeticPhase u n))
      using 1 <;> ring
  let F : CoprimeElement a → ℂ := fun x => affineLowerFourierTerm q ((u : O) * lambda ^ n) h v s a x.1
  let e := cubicResidueElementEquiv a ha
  have hp : Summable (fun p : CubicUnitResidue a × O => F (e p)) := e.summable_iff.mpr hsum
  change (∑' x, F x) = 0
  rw [← e.tsum_eq F, hp.tsum_prod]
  change (∑' x : CubicUnitResidue a, ∑' m : O,
    affineLowerFourierTerm q ((u : O) * lambda ^ n) h v s a (principalResidueRep a x.1 + a * m)) = 0
  have hinner (x : CubicUnitResidue a) :
      (∑' m : O, affineLowerFourierTerm q ((u : O) * lambda ^ n) h v s a
        (principalResidueRep a x.1 + a * m)) = 0 := by
    unfold affineLowerFourierTerm
    rw [affineCusp_masked_inner h q a ell _ u n ha hap hq hell' v hv s hs, if_neg hne]
  simp only [hinner, tsum_zero]

/-- The affine Fourier formula includes exact cancellation of inactive residue classes. -/
theorem affineCusp_branch_fourier_masked (h h1 q : O) (u : Oˣ) (n : ℕ) (hq : q ≠ 0)
    (hh : h = q * h1) (hbase : (3 : O) ∣ h + ramifiedArithmeticPhase u n * q)
    (v : ℝ) (hv : 0 < v) (s : ℂ) (hs : 1 < s.re)
    (hsum : Summable (fun p : OppositeData => affineLowerFourierTerm q ((u : O) * lambda ^ n) h v s
      (primaryIdealGenerator p.1.1) p.2.1)) :
    (∑' p : OppositeData, affineLowerFourierTerm q ((u : O) * lambda ^ n) h v s
      (primaryIdealGenerator p.1.1) p.2.1) =
      if (3 : O) ∣ h1 + ramifiedArithmeticPhase u n then
        (Ideal.absNorm (Ideal.span {q}) : ℂ) * ((‖ringComplex q‖ ^ 2 : ℝ) : ℂ) ^ (-s) *
          ((v : ℂ) ^ (2 - s) * sourceFourierKernel s (ninthCuspFrequency h * v)) *
            tracePhase (ninthCuspFrequency h / ringComplex q) *
              unramifiedCubicGaussSeries s (3 * ((u : O) * lambda ^ n) ^ 2 * h1) else 0 := by
  split_ifs with hfreq
  · exact affineCusp_branch_fourier h h1 q u n hq hh hfreq v hv s hs hsum
  · rw [hsum.tsum_sigma]
    trans ∑' I : GoodIdeal, (0 : ℂ)
    · apply tsum_congr
      intro I
      exact affineDenominator_zero h h1 q _ u n I.2
        (primaryIdealGenerator_spec I.1 I.2).2 hq hh hbase hfreq v hv s hs (hsum.sigma_factor I)
    · exact tsum_zero

/-- The once-ramified cusp has exactly three affine Fourier branches. -/
theorem diagonal_once_eisenstein_fourier (u t : Oˣ) (h : O) (h1 : Fin 3 → O)
    (hh : ∀ j, h = (onceCuspScale t * omega ^ j.val) * h1 j)
    (hbase : ∀ j, (3 : O) ∣ h + ramifiedArithmeticPhase (onceCuspArithmeticUnit u t j) 1 *
      (onceCuspScale t * omega ^ j.val))
    (v : ℝ) (hv : 0 < v) (s : ℂ) (hs : 2 < s.re) :
    (∫ z in periodDomain, eisenstein (integralComplexMatrix (unitCuspDiagonal u) *
      integralComplexMatrix (lowerCuspMatrix (onceCuspScale t)) * upperSection z v hv) s *
        tracePhase (-ninthCuspFrequency h * z)) =
      ∑ j : Fin 3, if (3 : O) ∣ h1 j + ramifiedArithmeticPhase (onceCuspArithmeticUnit u t j) 1 then
        (3 : ℂ) * (3 : ℂ) ^ (-s) *
          ((v : ℂ) ^ (2 - s) * sourceFourierKernel s (ninthCuspFrequency h * v)) *
            tracePhase (ninthCuspFrequency h / ringComplex (onceCuspScale t * omega ^ j.val)) *
              unramifiedCubicGaussSeries s
                (3 * ((↑u⁻¹ : O) ^ 2 * (onceCuspScale t * omega ^ j.val)) ^ 2 * h1 j) else 0 := by
  have hsum := hasSum_diagonal_once_integrals u t v hv s h hs
  rw [← hsum.tsum_eq, hsum.summable.tsum_prod, tsum_fintype]
  apply Finset.sum_congr rfl
  intro j hj
  have hq := mul_ne_zero (onceCusp_scale_ne_zero t)
    (pow_ne_zero j.val (omega_primitive.isUnit (by decide)).ne_zero)
  have he := affineCusp_branch_fourier_masked h (h1 j) (onceCuspScale t * omega ^ j.val)
    (onceCuspArithmeticUnit u t j) 1 hq (hh j) (hbase j) v hv s (by linarith)
      (by simpa only [pow_one, onceCuspArithmeticUnit_spec] using hsum.summable.prod_factor j)
  simpa only [pow_one, onceCuspArithmeticUnit_spec, onceCusp_q_norm, onceCusp_q_absNorm,
    Nat.cast_ofNat, Complex.ofReal_ofNat] using he

/-- A continuous horizontal parametrization preserves compact domination of the Eisenstein rows. -/
theorem hasSum_integral_fixed_left_Eisenstein_comp (a : SL(2, ℂ)) (v : ℝ) (hv : 0 < v)
    (τ : ℂ → ℂ) (hτ : Continuous τ) (s freq : ℂ) (hs : 2 < s.re) :
    HasSum (fun x : CuspCosets => ∫ z in periodDomain,
      summand (a * upperSection (τ z) v hv) s x * tracePhase (-freq * z))
      (∫ z in periodDomain, eisenstein (a * upperSection (τ z) v hv) s * tracePhase (-freq * z)) := by
  letI : Countable CuspCosets := (rowCoordinates_injective.comp cosetRow_injective).countable
  letI := periodDomain_finiteMeasure
  have hc : Continuous (fun z : ℂ => rowBound (a * upperSection (τ z) v hv)) :=
    (continuous_const.mul (continuous_const.add (continuous_inverse_fixed_left_operator a v hv).norm)).comp hτ
  let R : ℝ := ∑ i : Fin 2, ‖periodBasis i‖
  obtain ⟨B, hB⟩ := (isCompact_closedBall (0 : ℂ) R).bddAbove_image hc.continuousOn
  let C := max 1 B
  have hC : 0 < C := lt_of_lt_of_le (by norm_num) (le_max_left _ _)
  have hbound (z : ℂ) (hz : z ∈ periodDomain) : rowBound (a * upperSection (τ z) v hv) ≤ C := by
    apply (hB ?_).trans (le_max_right _ _)
    exact ⟨z, by simpa only [Metric.mem_closedBall, dist_zero_right] using norm_mem_periodDomain z hz, rfl⟩
  let M : CuspCosets → ℝ := fun x => C ^ (2 * s.re) * ‖rowCoordinates (cosetRow x)‖ ^ (-(2 * s.re))
  have hM : Summable M := ((summable_integer_four_rpow (2 * s.re) (by linarith)).comp_injective
    (rowCoordinates_injective.comp cosetRow_injective)).mul_left _
  have hmajor (z : ℂ) (hz : z ∈ periodDomain) (x : CuspCosets) :
      ‖summand (a * upperSection (τ z) v hv) s x‖ ≤ M x := by
    apply (norm_summand_bound (a * upperSection (τ z) v hv) s (by linarith) x).trans
    exact mul_le_mul_of_nonneg_right
      (Real.rpow_le_rpow (rowBound_pos _).le (hbound z hz) (by linarith)) (by positivity)
  have hchar : Continuous (fun z : ℂ => tracePhase (-freq * z)) := by
    change Continuous (fun z : ℂ => Complex.exp (2 * Real.pi * Complex.I *
      ((-freq * z) + starRingEnd ℂ (-freq * z))))
    fun_prop
  exact hasSum_integral_of_dominated_convergence (μ := volume.restrict periodDomain)
    (fun (x : CuspCosets) (_ : ℂ) => M x)
    (fun x => (((continuous_fixed_left_summand a v hv s x).comp hτ).mul hchar).aestronglyMeasurable.restrict)
    (fun x => (ae_restrict_mem periodDomain_measurable).mono fun z hz => by
      simpa only [Pi.mul_apply, norm_mul, tracePhase_norm, mul_one] using hmajor z hz x)
    (Eventually.of_forall fun _ => hM) (integrable_const (∑' x, M x))
    (Eventually.of_forall fun z => (summable_summand (a * upperSection (τ z) v hv) s hs).hasSum.mul_right
      (tracePhase (-freq * z)))

lemma ninthCuspFrequency_three (h : O) : ninthCuspFrequency (3 * h) = cuspFrequency h := by
  simp only [ninthCuspFrequency, cuspFrequency, map_mul, map_ofNat]
  ring

/-- Scaling both cusp coordinates moves the factor three into the affine denominator. -/
lemma affineLowerTerm_scale_three (q r : O) (z : ℂ) (v : ℝ) (hv : 0 ≤ v) (s : ℂ) (a d : O) :
    affineLowerTerm q r (3 * z) (3 * v) s a d = (3 : ℂ) ^ s * affineLowerTerm (3 * q) r z v s a d := by
  have hq : ringComplex ((3 * q) * a) = 3 * ringComplex (q * a) := by
    simp only [map_mul, map_ofNat]
    ring
  have he : ‖ringComplex (q * a) * (3 * z) + ringComplex d‖ ^ 2 +
      ‖ringComplex (q * a)‖ ^ 2 * (3 * v) ^ 2 =
      ‖ringComplex ((3 * q) * a) * z + ringComplex d‖ ^ 2 +
        ‖ringComplex ((3 * q) * a)‖ ^ 2 * v ^ 2 := by
    rw [hq, show ringComplex (q * a) * (3 * z) = 3 * ringComplex (q * a) * z by ring]
    norm_num [norm_mul] <;> ring
  let D := ‖ringComplex ((3 * q) * a) * z + ringComplex d‖ ^ 2 +
    ‖ringComplex ((3 * q) * a)‖ ^ 2 * v ^ 2
  have hD : 0 ≤ D := by dsimp only [D]; positivity
  rw [affineLowerTerm, affineLowerTerm, he]
  change _ * (((3 * v / D : ℝ) : ℂ) ^ s) = _
  have hp : ((3 : ℂ) * ((v / D : ℝ) : ℂ)) ^ s = (3 : ℂ) ^ s * ((v / D : ℝ) : ℂ) ^ s := by
    simpa only [Complex.ofReal_ofNat] using
      Complex.mul_cpow_ofReal_nonneg (by norm_num : (0 : ℝ) ≤ 3) (div_nonneg hv hD) s
  rw [show ((3 * v / D : ℝ) : ℂ) = (3 : ℂ) * ((v / D : ℝ) : ℂ) by push_cast; ring, hp]
  ring

lemma affineDenominator_nodiv_zero (h q a : O) (u : Oˣ) (n : ℕ)
    (ha : a ≠ 0) (hap : lambda ^ 2 ∣ a - 1) (hq : q ≠ 0)
    (hbase : (3 : O) ∣ h + ramifiedArithmeticPhase u n * q) (hfreq : ¬q ∣ h)
    (v : ℝ) (hv : 0 < v) (s : ℂ) (hs : 1 < s.re)
    (hsum : Summable (fun x : CoprimeElement a => affineLowerFourierTerm q ((u : O) * lambda ^ n) h v s a x.1)) :
    (∑' x : CoprimeElement a, affineLowerFourierTerm q ((u : O) * lambda ^ n) h v s a x.1) = 0 := by
  have hdiv : (3 : O) ∣ h + ramifiedArithmeticPhase u n * q * a := by
    convert dvd_add hbase ((three_dvd_primary_sub_one a hap).mul_left (ramifiedArithmeticPhase u n * q))
      using 1 <;> ring
  obtain ⟨ell, hell⟩ := hdiv
  have hne : ¬q ∣ ell := by
    intro hqell
    apply hfreq
    have hqe : q ∣ h + ramifiedArithmeticPhase u n * q * a := by
      rw [hell]
      exact hqell.mul_left 3
    convert dvd_sub hqe (show q ∣ ramifiedArithmeticPhase u n * q * a from
      ⟨ramifiedArithmeticPhase u n * a, by ring⟩) using 1 <;> ring
  let F : CoprimeElement a → ℂ := fun x => affineLowerFourierTerm q ((u : O) * lambda ^ n) h v s a x.1
  let e := cubicResidueElementEquiv a ha
  have hp : Summable (fun p : CubicUnitResidue a × O => F (e p)) := e.summable_iff.mpr hsum
  change (∑' x, F x) = 0
  rw [← e.tsum_eq F, hp.tsum_prod]
  change (∑' x : CubicUnitResidue a, ∑' m : O,
    affineLowerFourierTerm q ((u : O) * lambda ^ n) h v s a (principalResidueRep a x.1 + a * m)) = 0
  have hinner (x : CubicUnitResidue a) :
      (∑' m : O, affineLowerFourierTerm q ((u : O) * lambda ^ n) h v s a
        (principalResidueRep a x.1 + a * m)) = 0 := by
    unfold affineLowerFourierTerm
    rw [affineCusp_masked_inner h q a ell _ u n ha hap hq hell.symm v hv s hs, if_neg hne]
  simp only [hinner, tsum_zero]

/-- All arithmetic factors of a scaled affine branch, including its exact support. -/
def scaledAffineGaussSeries (q : O) (u : Oˣ) (n : ℕ) (h : O) (s : ℂ) : ℂ :=
  if hh : q ∣ h then
    let k := Classical.choose hh
    if (3 : O) ∣ k + ramifiedArithmeticPhase u n then
      (Ideal.absNorm (Ideal.span {3 * q}) : ℂ) * ((‖ringComplex (3 * q)‖ ^ 2 : ℝ) : ℂ) ^ (-s) *
        tracePhase (cuspFrequency h / ringComplex (3 * q)) *
          unramifiedCubicGaussSeries s (3 * ((u : O) * lambda ^ n) ^ 2 * k)
    else 0
  else 0

/-- Scaling by three makes the period congruence automatic at every frequency. -/
theorem scaledAffine_branch_fourier (q : O) (u : Oˣ) (n : ℕ) (h : O) (hq : q ≠ 0)
    (v : ℝ) (hv : 0 < v) (s : ℂ) (hs : 1 < s.re)
    (hsum : Summable (fun p : OppositeData => affineLowerFourierTerm (3 * q) ((u : O) * lambda ^ n)
      (3 * h) v s (primaryIdealGenerator p.1.1) p.2.1)) :
    (∑' p : OppositeData, affineLowerFourierTerm (3 * q) ((u : O) * lambda ^ n)
      (3 * h) v s (primaryIdealGenerator p.1.1) p.2.1) =
      ((v : ℂ) ^ (2 - s) * sourceFourierKernel s (cuspFrequency h * v)) * scaledAffineGaussSeries q u n h s := by
  have h3 : (3 : O) ≠ 0 := by norm_num
  have hbase : (3 : O) ∣ 3 * h + ramifiedArithmeticPhase u n * (3 * q) :=
    ⟨h + ramifiedArithmeticPhase u n * q, by ring⟩
  by_cases hh : q ∣ h
  · rw [scaledAffineGaussSeries, dif_pos hh]
    have hk : 3 * h = (3 * q) * Classical.choose hh := by
      linear_combination 3 * Classical.choose_spec hh
    rw [affineCusp_branch_fourier_masked (3 * h) (Classical.choose hh) (3 * q) u n
      (mul_ne_zero h3 hq) hk hbase v hv s hs hsum, ninthCuspFrequency_three]
    dsimp only
    split_ifs <;> ring
  · rw [scaledAffineGaussSeries, dif_neg hh, mul_zero, hsum.tsum_sigma]
    have hn : ¬(3 * q) ∣ 3 * h := by
      rintro ⟨x, hx⟩
      apply hh
      refine ⟨x, mul_left_cancel₀ h3 ?_⟩
      linear_combination hx
    trans ∑' I : GoodIdeal, (0 : ℂ)
    · apply tsum_congr
      intro I
      exact affineDenominator_nodiv_zero (3 * h) (3 * q) _ u n I.2
        (primaryIdealGenerator_spec I.1 I.2).2 (mul_ne_zero h3 hq) hbase hn v hv s hs
          (hsum.sigma_factor I)
    · exact tsum_zero

lemma hasSum_scaled_unit_integrals (u t : Oˣ) (v : ℝ) (hv : 0 < v) (s : ℂ) (h : O) (hs : 2 < s.re) :
    HasSum (fun p : OppositeData => (3 : ℂ) ^ s *
      affineLowerFourierTerm (3 * (t : O)) ((↑u⁻¹ : O) ^ 2 * (t : O)) (3 * h) v s
        (primaryIdealGenerator p.1.1) p.2.1)
      (∫ z in periodDomain, eisenstein (integralComplexMatrix (unitCuspDiagonal u) *
        integralComplexMatrix (lowerCuspMatrix (t : O)) * upperSection (3 * z) (3 * v) (by positivity)) s *
          tracePhase (-cuspFrequency h * z)) := by
  let e := (unitLowerDataEquiv (u⁻¹ ^ 2 * t)).trans primitiveRowEquiv.symm
  have he := e.hasSum_iff.mpr (hasSum_integral_fixed_left_Eisenstein_comp
    (integralComplexMatrix (unitCuspDiagonal u) * integralComplexMatrix (lowerCuspMatrix (t : O)))
      (3 * v) (by positivity) (fun z => 3 * z) (by fun_prop) s (cuspFrequency h) hs)
  apply he.congr_fun
  intro p
  rw [affineLowerFourierTerm, ← integral_const_mul]
  apply integral_congr_ae
  exact Eventually.of_forall (fun z => by
    dsimp only [e, Equiv.trans_apply, Function.comp_apply]
    rw [diagonal_unit_summand, affineLowerTerm_scale_three _ _ z v hv.le,
      ninthCuspFrequency_three]
    ring)

lemma hasSum_scaled_once_integrals (u t : Oˣ) (v : ℝ) (hv : 0 < v) (s : ℂ) (h : O) (hs : 2 < s.re) :
    HasSum (fun p : OnceRamifiedData => (3 : ℂ) ^ s *
      affineLowerFourierTerm (3 * (onceCuspScale t * omega ^ p.1.val))
        ((↑u⁻¹ : O) ^ 2 * (onceCuspScale t * omega ^ p.1.val)) (3 * h) v s
          (primaryIdealGenerator p.2.1.1) p.2.2.1)
      (∫ z in periodDomain, eisenstein (integralComplexMatrix (unitCuspDiagonal u) *
        integralComplexMatrix (lowerCuspMatrix (onceCuspScale t)) *
          upperSection (3 * z) (3 * v) (by positivity)) s * tracePhase (-cuspFrequency h * z)) := by
  let e := (onceRamifiedDataEquiv (u⁻¹ ^ 2 * t)).trans primitiveRowEquiv.symm
  have he := e.hasSum_iff.mpr (hasSum_integral_fixed_left_Eisenstein_comp
    (integralComplexMatrix (unitCuspDiagonal u) * integralComplexMatrix (lowerCuspMatrix (onceCuspScale t)))
      (3 * v) (by positivity) (fun z => 3 * z) (by fun_prop) s (cuspFrequency h) hs)
  apply he.congr_fun
  intro p
  rw [affineLowerFourierTerm, ← integral_const_mul]
  apply integral_congr_ae
  exact Eventually.of_forall (fun z => by
    dsimp only [e, Equiv.trans_apply, Function.comp_apply]
    rw [diagonal_once_summand, affineLowerTerm_scale_three _ _ z v hv.le,
      ninthCuspFrequency_three]
    ring)

lemma summable_of_summable_const_mul {ι : Type*} (c : ℂ) (hc : c ≠ 0) (f : ι → ℂ)
    (hs : Summable (fun i => c * f i)) : Summable f := by
  have hh := hs.mul_left c⁻¹
  simpa only [← mul_assoc, inv_mul_cancel₀ hc, one_mul] using hh

/-- The scaled unit-cusp coefficient is explicit at every frequency. -/
theorem scaled_unit_eisenstein_fourier (u t : Oˣ) (v : ℝ) (hv : 0 < v) (s : ℂ) (h : O) (hs : 2 < s.re) :
    (∫ z in periodDomain, eisenstein (integralComplexMatrix (unitCuspDiagonal u) *
      integralComplexMatrix (lowerCuspMatrix (t : O)) * upperSection (3 * z) (3 * v) (by positivity)) s *
        tracePhase (-cuspFrequency h * z)) =
      (3 : ℂ) ^ s * ((v : ℂ) ^ (2 - s) * sourceFourierKernel s (cuspFrequency h * v)) *
        scaledAffineGaussSeries (t : O) (u⁻¹ ^ 2 * t) 0 h s := by
  have he := hasSum_scaled_unit_integrals u t v hv s h hs
  have h3 : (3 : ℂ) ^ s ≠ 0 := Complex.cpow_ne_zero_iff.mpr (Or.inl (by norm_num))
  have hsum := summable_of_summable_const_mul _ h3 _ he.summable
  rw [← he.tsum_eq, tsum_mul_left]
  have hf := scaledAffine_branch_fourier (t : O) (u⁻¹ ^ 2 * t) 0 h t.ne_zero v hv s
    (by linarith) (by simpa only [pow_zero, mul_one, Units.val_mul, Units.val_pow_eq_pow_val] using hsum)
  simp only [pow_zero, mul_one, Units.val_mul, Units.val_pow_eq_pow_val] at hf
  rw [hf]
  ring

/-- Three explicit Gauss series give every scaled once-ramified cusp coefficient. -/
theorem scaled_once_eisenstein_fourier (u t : Oˣ) (v : ℝ) (hv : 0 < v) (s : ℂ) (h : O) (hs : 2 < s.re) :
    (∫ z in periodDomain, eisenstein (integralComplexMatrix (unitCuspDiagonal u) *
      integralComplexMatrix (lowerCuspMatrix (onceCuspScale t)) *
        upperSection (3 * z) (3 * v) (by positivity)) s * tracePhase (-cuspFrequency h * z)) =
      (3 : ℂ) ^ s * ((v : ℂ) ^ (2 - s) * sourceFourierKernel s (cuspFrequency h * v)) *
        ∑ j : Fin 3, scaledAffineGaussSeries (onceCuspScale t * omega ^ j.val) (onceCuspArithmeticUnit u t j) 1 h s := by
  have he := hasSum_scaled_once_integrals u t v hv s h hs
  have h3 : (3 : ℂ) ^ s ≠ 0 := Complex.cpow_ne_zero_iff.mpr (Or.inl (by norm_num))
  have hsum := summable_of_summable_const_mul _ h3 _ he.summable
  rw [← he.tsum_eq, tsum_mul_left, hsum.tsum_prod, tsum_fintype]
  have hj (j : Fin 3) :
      (∑' p : OppositeData, affineLowerFourierTerm (3 * (onceCuspScale t * omega ^ j.val))
        ((↑u⁻¹ : O) ^ 2 * (onceCuspScale t * omega ^ j.val)) (3 * h) v s
          (primaryIdealGenerator p.1.1) p.2.1) =
        ((v : ℂ) ^ (2 - s) * sourceFourierKernel s (cuspFrequency h * v)) *
          scaledAffineGaussSeries (onceCuspScale t * omega ^ j.val) (onceCuspArithmeticUnit u t j) 1 h s := by
    have hq := mul_ne_zero (onceCusp_scale_ne_zero t)
      (pow_ne_zero j.val (omega_primitive.isUnit (by decide)).ne_zero)
    have hf := scaledAffine_branch_fourier (onceCuspScale t * omega ^ j.val) (onceCuspArithmeticUnit u t j) 1
      h hq v hv s (by linarith)
        (by simpa only [pow_one, onceCuspArithmeticUnit_spec] using hsum.prod_factor j)
    simpa only [pow_one, onceCuspArithmeticUnit_spec] using hf
  simp_rw [hj]
  rw [← Finset.mul_sum]
  ring

def coprimeElementShift (a k : O) : CoprimeElement a ≃ CoprimeElement a where
  toFun x := ⟨x.1 + a * k,
    (isCoprime_right_congr_of_dvd a (x.1 + a * k) x.1 ⟨k, by ring⟩).mpr x.2⟩
  invFun x := ⟨x.1 - a * k,
    (isCoprime_right_congr_of_dvd a (x.1 - a * k) x.1 ⟨-k, by ring⟩).mpr x.2⟩
  left_inv x := Subtype.ext (add_sub_cancel_right _ _)
  right_inv x := Subtype.ext (sub_add_cancel _ _)

def oppositeDataShift (k : O) : OppositeData ≃ OppositeData :=
  Equiv.sigmaCongrRight (fun I => coprimeElementShift (primaryIdealGenerator I.1) k)

lemma oppositeDataShift_fst (k : O) (p : OppositeData) : (oppositeDataShift k p).1 = p.1 := rfl

lemma oppositeDataShift_snd (k : O) (p : OppositeData) :
    (oppositeDataShift k p).2.1 = p.2.1 + primaryIdealGenerator p.1.1 * k := rfl

lemma affineLowerTerm_scaled_period (q : O) (u : Oˣ) (n : ℕ) (a x m : O)
    (hap : lambda ^ 2 ∣ a - 1) (z : ℂ) (v : ℝ) (s : ℂ) :
    affineLowerTerm (3 * q) ((u : O) * lambda ^ n) (z + 3 * ringComplex m) v s a (a + 3 * x) =
      affineLowerTerm (3 * q) ((u : O) * lambda ^ n) z v s a (a + 3 * (x + a * (3 * q * m))) := by
  have hd (y : O) : (3 : O) ∣ a + 3 * y - 1 := by
    convert dvd_add (three_dvd_primary_sub_one a hap) (dvd_mul_right (3 : O) y) using 1 <;> ring
  have hchar : symbol ((u : O) * lambda ^ n) (a + 3 * x) =
      symbol ((u : O) * lambda ^ n) (a + 3 * (x + a * (3 * q * m))) :=
    ramified_symbol_congr_mod_nine u n _ _ (hd x) (hd _) ⟨-a * q * m, by ring⟩
  have hden : symbol (a + 3 * x) a = symbol (a + 3 * (x + a * (3 * q * m))) a :=
    symbol_congr ⟨-9 * q * m, by ring⟩
  have hrow : ringComplex ((3 * q) * a) * (z + 3 * ringComplex m) + ringComplex (a + 3 * x) =
      ringComplex ((3 * q) * a) * z + ringComplex (a + 3 * (x + a * (3 * q * m))) := by
    simp only [map_add, map_mul, map_ofNat]
    ring
  simp only [affineLowerTerm, hchar, hden, hrow]

lemma affineRowSeries_scaled_period (q : O) (u : Oˣ) (n : ℕ) (z : ℂ) (v : ℝ) (s : ℂ) (m : O) :
    (∑' p : OppositeData, affineLowerTerm (3 * q) ((u : O) * lambda ^ n)
      (z + 3 * ringComplex m) v s (primaryIdealGenerator p.1.1) (primaryIdealGenerator p.1.1 + 3 * p.2.1)) =
    ∑' p : OppositeData, affineLowerTerm (3 * q) ((u : O) * lambda ^ n)
      z v s (primaryIdealGenerator p.1.1) (primaryIdealGenerator p.1.1 + 3 * p.2.1) := by
  let F : OppositeData → ℂ := fun p => affineLowerTerm (3 * q) ((u : O) * lambda ^ n)
    z v s (primaryIdealGenerator p.1.1) (primaryIdealGenerator p.1.1 + 3 * p.2.1)
  rw [← (oppositeDataShift (3 * q * m)).tsum_eq F]
  apply tsum_congr
  intro p
  exact affineLowerTerm_scaled_period q u n _ p.2.1 m (primaryIdealGenerator_spec p.1.1 p.1.2).2 z v s

lemma diagonal_unit_eisenstein_rows (u t : Oˣ) (z : ℂ) (v : ℝ) (hv : 0 < v) (s : ℂ) :
    eisenstein (integralComplexMatrix (unitCuspDiagonal u) *
      integralComplexMatrix (lowerCuspMatrix (t : O)) * upperSection z v hv) s =
      ∑' p : OppositeData, affineLowerTerm (t : O) ((↑u⁻¹ : O) ^ 2 * (t : O)) z v s
        (primaryIdealGenerator p.1.1) (primaryIdealGenerator p.1.1 + 3 * p.2.1) := by
  let e := (unitLowerDataEquiv (u⁻¹ ^ 2 * t)).trans primitiveRowEquiv.symm
  change (∑' x : CuspCosets, summand _ s x) = _
  rw [← e.tsum_eq]
  exact tsum_congr (diagonal_unit_summand u t z v hv s)

lemma scaled_unit_eisenstein_period (u t : Oˣ) (z : ℂ) (v : ℝ) (hv : 0 < v) (s : ℂ) (m : O) :
    eisenstein (integralComplexMatrix (unitCuspDiagonal u) * integralComplexMatrix (lowerCuspMatrix (t : O)) *
      upperSection (3 * (z + 3 * ringComplex m)) (3 * v) (by positivity)) s =
    eisenstein (integralComplexMatrix (unitCuspDiagonal u) * integralComplexMatrix (lowerCuspMatrix (t : O)) *
      upperSection (3 * z) (3 * v) (by positivity)) s := by
  simp_rw [diagonal_unit_eisenstein_rows, affineLowerTerm_scale_three _ _ _ v hv.le, tsum_mul_left]
  congr 1
  have he := affineRowSeries_scaled_period (t : O) (u⁻¹ ^ 2 * t) 0 z v s m
  simpa only [pow_zero, mul_one, Units.val_mul, Units.val_pow_eq_pow_val] using he

def unitCuspUpper (b : O) : SL(2, O) := ⟨!![1, b; 0, 1], by simp [Matrix.det_fin_two]⟩

lemma unitCuspUpper_section (b : O) (z : ℂ) (v : ℝ) (hv : 0 < v) :
    integralComplexMatrix (unitCuspUpper b) * upperSection z v hv =
      upperSection (z + ringComplex b) v hv := by
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  fin_cases i <;> fin_cases j <;>
    simp [unitCuspUpper, integralComplexMatrix, upperSection, Matrix.SpecialLinearGroup.coe_mul,
      Matrix.mul_apply, Fin.sum_univ_two, div_eq_mul_inv, add_mul]

/-- Bruhat factorization of a rational cusp followed by a unit lower cusp. -/
lemma rational_cusp_lower_factor (u : Oˣ) (n : ℤ) :
    rationalEmbedding ModularGroup.S * unitCuspUpper (n : O) * lowerCuspMatrix (u : O) =
      unitCuspDiagonal (-u) * lowerCuspMatrix (-(u : O) * (1 + (n : O) * (u : O))) *
        unitCuspUpper (↑u⁻¹ : O) := by
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  have hu : (u : O) * (↑u⁻¹ : O) = 1 := by simp
  fin_cases i <;> fin_cases j <;>
    simp [rationalEmbedding, ModularGroup.coe_S, unitCuspUpper, lowerCuspMatrix, unitCuspDiagonal,
      Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two] <;>
    linear_combination -(n : O) * hu

lemma rational_unipotent_upper (n : ℕ) : rationalEmbedding (ModularGroup.T ^ n) = unitCuspUpper (n : O) := by
  rw [← rationalUnipotent_nat]
  apply Subtype.ext
  rw [rationalUnipotent_embedding]
  rfl

lemma rational_cusp_lower_section (u : Oˣ) (n : ℕ) (z : ℂ) (v : ℝ) (hv : 0 < v) :
    rationalComplex ModularGroup.S * rationalComplex (ModularGroup.T ^ n) *
      integralComplexMatrix (lowerCuspMatrix (u : O)) * upperSection z v hv =
      integralComplexMatrix (unitCuspDiagonal (-u)) *
        integralComplexMatrix (lowerCuspMatrix (-(u : O) * (1 + (n : O) * (u : O)))) *
          upperSection (z + ringComplex (↑u⁻¹ : O)) v hv := by
  have hm := congrArg integralComplexMatrix (rational_cusp_lower_factor u (n : ℤ))
  simp only [map_mul, Int.cast_natCast] at hm
  have hu : integralComplexMatrix (unitCuspUpper (n : O)) = rationalComplex (ModularGroup.T ^ n) := by
    rw [← rational_unipotent_upper]
    rfl
  rw [hu] at hm
  change rationalComplex ModularGroup.S * rationalComplex (ModularGroup.T ^ n) *
    integralComplexMatrix (lowerCuspMatrix (u : O)) = _ at hm
  rw [hm, mul_assoc, unitCuspUpper_section]

def onceRamifiedDataShift (t : Oˣ) (m : O) : OnceRamifiedData ≃ OnceRamifiedData where
  toFun p := (p.1, oppositeDataShift (3 * (onceCuspScale t * omega ^ p.1.val) * m) p.2)
  invFun p := (p.1, (oppositeDataShift (3 * (onceCuspScale t * omega ^ p.1.val) * m)).symm p.2)
  left_inv p := by
    change (p.1, (oppositeDataShift _).symm (oppositeDataShift _ p.2)) = p
    rw [Equiv.symm_apply_apply]
  right_inv p := by
    change (p.1, oppositeDataShift _ ((oppositeDataShift _).symm p.2)) = p
    rw [Equiv.apply_symm_apply]

lemma diagonal_once_eisenstein_rows (u t : Oˣ) (z : ℂ) (v : ℝ) (hv : 0 < v) (s : ℂ) :
    eisenstein (integralComplexMatrix (unitCuspDiagonal u) *
      integralComplexMatrix (lowerCuspMatrix (onceCuspScale t)) * upperSection z v hv) s =
      ∑' p : OnceRamifiedData, affineLowerTerm (onceCuspScale t * omega ^ p.1.val)
        ((↑u⁻¹ : O) ^ 2 * (onceCuspScale t * omega ^ p.1.val)) z v s
          (primaryIdealGenerator p.2.1.1) (primaryIdealGenerator p.2.1.1 + 3 * p.2.2.1) := by
  let e := (onceRamifiedDataEquiv (u⁻¹ ^ 2 * t)).trans primitiveRowEquiv.symm
  change (∑' x : CuspCosets, summand _ s x) = _
  rw [← e.tsum_eq]
  exact tsum_congr (diagonal_once_summand u t z v hv s)

lemma scaled_once_eisenstein_period (u t : Oˣ) (z : ℂ) (v : ℝ) (hv : 0 < v) (s : ℂ) (m : O) :
    eisenstein (integralComplexMatrix (unitCuspDiagonal u) *
      integralComplexMatrix (lowerCuspMatrix (onceCuspScale t)) *
        upperSection (3 * (z + 3 * ringComplex m)) (3 * v) (by positivity)) s =
    eisenstein (integralComplexMatrix (unitCuspDiagonal u) *
      integralComplexMatrix (lowerCuspMatrix (onceCuspScale t)) *
        upperSection (3 * z) (3 * v) (by positivity)) s := by
  simp_rw [diagonal_once_eisenstein_rows, affineLowerTerm_scale_three _ _ _ v hv.le, tsum_mul_left]
  congr 1
  let F : OnceRamifiedData → ℂ := fun p => affineLowerTerm (3 * (onceCuspScale t * omega ^ p.1.val))
    ((↑u⁻¹ : O) ^ 2 * (onceCuspScale t * omega ^ p.1.val)) z v s
      (primaryIdealGenerator p.2.1.1) (primaryIdealGenerator p.2.1.1 + 3 * p.2.2.1)
  rw [← (onceRamifiedDataShift t m).tsum_eq F]
  apply tsum_congr
  intro p
  dsimp only [F, onceRamifiedDataShift, Equiv.coe_fn_mk]
  simp only [oppositeDataShift_fst, oppositeDataShift_snd]
  have he := affineLowerTerm_scaled_period (onceCuspScale t * omega ^ p.1.val)
    (onceCuspArithmeticUnit u t p.1) 1 _ p.2.2.1 m (primaryIdealGenerator_spec p.2.1.1 p.2.1.2).2 z v s
  simpa only [pow_one, onceCuspArithmeticUnit_spec] using he

lemma hyperbolicEisenstein_fixed_upper (g : SL(2, ℂ)) (z : ℂ) (v : ℝ) (hv : 0 < v) (s : ℂ) :
    hyperbolicEisenstein s (g • upperPoint z v hv) = eisenstein (g * upperSection z v hv) s := rfl

/-- The four projected cusps become three unit branches and one once-ramified cusp. -/
theorem rationalSourceEisenstein_primitive_lower_four (u t : Oˣ)
    (hu : (u : O) ^ 2 + (u : O) + 1 = 0) (ht : -(u : O) * (1 + 2 * (u : O)) = onceCuspScale t)
    (z : ℂ) (v : ℝ) (hv : 0 < v) (s : ℂ) (hs : 2 < s.re) :
    rationalSourceEisenstein s (integralComplexMatrix (lowerCuspMatrix (u : O)) • upperPoint z v hv) =
      (4 : ℂ)⁻¹ * (eisenstein (integralComplexMatrix (lowerCuspMatrix (u : O)) * upperSection z v hv) s +
        eisenstein (integralComplexMatrix (unitCuspDiagonal (-u)) *
          integralComplexMatrix (lowerCuspMatrix (-(u : O))) * upperSection (z + ringComplex (↑u⁻¹ : O)) v hv) s +
        eisenstein (integralComplexMatrix (unitCuspDiagonal (-u)) *
          integralComplexMatrix (lowerCuspMatrix 1) * upperSection (z + ringComplex (↑u⁻¹ : O)) v hv) s +
        eisenstein (integralComplexMatrix (unitCuspDiagonal (-u)) *
          integralComplexMatrix (lowerCuspMatrix (onceCuspScale t)) *
            upperSection (z + ringComplex (↑u⁻¹ : O)) v hv) s) := by
  have hu1 : -(u : O) * (1 + (u : O)) = 1 := by linear_combination -hu
  have h0 := rational_cusp_lower_section u 0 z v hv
  have h1 := rational_cusp_lower_section u 1 z v hv
  have h2 := rational_cusp_lower_section u 2 z v hv
  simp only [Nat.cast_zero, zero_mul, add_zero, mul_one, pow_zero, map_one] at h0
  simp only [Nat.cast_one, one_mul, pow_one, hu1] at h1
  simp only [Nat.cast_ofNat, ht] at h2
  rw [rationalSourceEisenstein_four_cusps s hs, fourCuspAverage]
  simp only [map_mul, ← mul_smul, hyperbolicEisenstein_fixed_upper, ← mul_assoc]
  rw [h0, h1, h2]

lemma unitCuspDiagonal_one : unitCuspDiagonal 1 = 1 := by
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  fin_cases i <;> fin_cases j <;> simp [unitCuspDiagonal]

lemma integrable_scaled_cusp_eisenstein (g : SL(2, ℂ)) (v : ℝ) (hv : 0 < v)
    (s : ℂ) (hs : 2 < s.re) (b : ℂ) (h : O) :
    IntegrableOn (fun z : ℂ => eisenstein (g * upperSection (3 * z + b) (3 * v) (by positivity)) s *
      tracePhase (-cuspFrequency h * z)) periodDomain := by
  have hcoord : Continuous (fun z : ℂ => (⟨(3 * z + b, 3 * v), by positivity⟩ : UpperCoordinates)) := by fun_prop
  have hu : Continuous (fun z : ℂ => upperPoint (3 * z + b) (3 * v) (by positivity)) :=
    upperCoordinatesHomeomorph.continuous.comp hcoord
  have hf := (hyperbolicEisenstein_continuous s hs).comp ((continuous_hyperbolic_action g).comp hu)
  apply periodDomain_continuous_integrable
  exact hf.mul (tracePhase_continuous.comp (continuous_const.mul continuous_id))

lemma scaled_unit_eisenstein_fourier_shift (u t : Oˣ) (v : ℝ) (hv : 0 < v) (s : ℂ) (h : O)
    (hs : 2 < s.re) (b : ℂ) :
    (∫ z in periodDomain, eisenstein (integralComplexMatrix (unitCuspDiagonal u) *
      integralComplexMatrix (lowerCuspMatrix (t : O)) * upperSection (3 * z + b) (3 * v) (by positivity)) s *
        tracePhase (-cuspFrequency h * z)) =
      tracePhase (cuspFrequency h * (b / 3)) *
        ((3 : ℂ) ^ s * ((v : ℂ) ^ (2 - s) * sourceFourierKernel s (cuspFrequency h * v)) *
          scaledAffineGaussSeries (t : O) (u⁻¹ ^ 2 * t) 0 h s) := by
  have he := period_fourier_translation
    (fun z => eisenstein (integralComplexMatrix (unitCuspDiagonal u) *
      integralComplexMatrix (lowerCuspMatrix (t : O)) * upperSection (3 * z) (3 * v) (by positivity)) s)
    (fun m z => scaled_unit_eisenstein_period u t z v hv s m) h (b / 3)
  simp_rw [show ∀ z : ℂ, 3 * (z + b / 3) = 3 * z + b by intro z; ring] at he
  rw [scaled_unit_eisenstein_fourier u t v hv s h hs] at he
  exact he

lemma scaled_once_eisenstein_fourier_shift (u t : Oˣ) (v : ℝ) (hv : 0 < v) (s : ℂ) (h : O)
    (hs : 2 < s.re) (b : ℂ) :
    (∫ z in periodDomain, eisenstein (integralComplexMatrix (unitCuspDiagonal u) *
      integralComplexMatrix (lowerCuspMatrix (onceCuspScale t)) *
        upperSection (3 * z + b) (3 * v) (by positivity)) s * tracePhase (-cuspFrequency h * z)) =
      tracePhase (cuspFrequency h * (b / 3)) *
        ((3 : ℂ) ^ s * ((v : ℂ) ^ (2 - s) * sourceFourierKernel s (cuspFrequency h * v)) *
          ∑ j : Fin 3, scaledAffineGaussSeries (onceCuspScale t * omega ^ j.val) (onceCuspArithmeticUnit u t j) 1 h s) := by
  have he := period_fourier_translation
    (fun z => eisenstein (integralComplexMatrix (unitCuspDiagonal u) *
      integralComplexMatrix (lowerCuspMatrix (onceCuspScale t)) *
        upperSection (3 * z) (3 * v) (by positivity)) s)
    (fun m z => scaled_once_eisenstein_period u t z v hv s m) h (b / 3)
  simp_rw [show ∀ z : ℂ, 3 * (z + b / 3) = 3 * z + b by intro z; ring] at he
  rw [scaled_once_eisenstein_fourier u t v hv s h hs] at he
  exact he

/-- Six unramified Gauss branches describe a projected ramified cusp. -/
def ramifiedCuspGaussSeries (u t : Oˣ) (h : O) (s : ℂ) : ℂ :=
  (4 : ℂ)⁻¹ * (scaledAffineGaussSeries (u : O) u 0 h s +
    tracePhase (cuspFrequency h * (ringComplex (↑u⁻¹ : O) / 3)) *
      (scaledAffineGaussSeries (-(u : O)) ((-u)⁻¹ ^ 2 * (-u)) 0 h s +
        scaledAffineGaussSeries 1 ((-u)⁻¹ ^ 2) 0 h s +
          ∑ j : Fin 3, scaledAffineGaussSeries (onceCuspScale t * omega ^ j.val)
            (onceCuspArithmeticUnit (-u) t j) 1 h s))

/-- Every Fourier coefficient of the scaled ramified source has an explicit six-branch factorization. -/
theorem ramifiedSourceEisenstein_scaled_fourier (u t : Oˣ)
    (hu : (u : O) ^ 2 + (u : O) + 1 = 0) (ht : -(u : O) * (1 + 2 * (u : O)) = onceCuspScale t)
    (v : ℝ) (hv : 0 < v) (s : ℂ) (hs : 2 < s.re) (h : O) :
    (∫ z in periodDomain, rationalSourceEisenstein s
      (integralComplexMatrix (lowerCuspMatrix (u : O)) • upperPoint (3 * z) (3 * v) (by positivity)) *
        tracePhase (-cuspFrequency h * z)) =
      (3 : ℂ) ^ s * ((v : ℂ) ^ (2 - s) * sourceFourierKernel s (cuspFrequency h * v)) *
        ramifiedCuspGaussSeries u t h s := by
  let b := ringComplex (↑u⁻¹ : O)
  let f0 : ℂ → ℂ := fun z => eisenstein (integralComplexMatrix (lowerCuspMatrix (u : O)) *
    upperSection (3 * z) (3 * v) (by positivity)) s * tracePhase (-cuspFrequency h * z)
  let f1 : ℂ → ℂ := fun z => eisenstein (integralComplexMatrix (unitCuspDiagonal (-u)) *
    integralComplexMatrix (lowerCuspMatrix (-(u : O))) * upperSection (3 * z + b) (3 * v) (by positivity)) s *
      tracePhase (-cuspFrequency h * z)
  let f2 : ℂ → ℂ := fun z => eisenstein (integralComplexMatrix (unitCuspDiagonal (-u)) *
    integralComplexMatrix (lowerCuspMatrix 1) * upperSection (3 * z + b) (3 * v) (by positivity)) s *
      tracePhase (-cuspFrequency h * z)
  let f3 : ℂ → ℂ := fun z => eisenstein (integralComplexMatrix (unitCuspDiagonal (-u)) *
    integralComplexMatrix (lowerCuspMatrix (onceCuspScale t)) *
      upperSection (3 * z + b) (3 * v) (by positivity)) s * tracePhase (-cuspFrequency h * z)
  have hi0 : IntegrableOn f0 periodDomain := by
    simpa only [f0, add_zero] using integrable_scaled_cusp_eisenstein
      (integralComplexMatrix (lowerCuspMatrix (u : O))) v hv s hs 0 h
  have hi1 : IntegrableOn f1 periodDomain := integrable_scaled_cusp_eisenstein _ v hv s hs b h
  have hi2 : IntegrableOn f2 periodDomain := integrable_scaled_cusp_eisenstein _ v hv s hs b h
  have hi3 : IntegrableOn f3 periodDomain := integrable_scaled_cusp_eisenstein _ v hv s hs b h
  have hpoint (z : ℂ) : rationalSourceEisenstein s
      (integralComplexMatrix (lowerCuspMatrix (u : O)) • upperPoint (3 * z) (3 * v) (by positivity)) *
        tracePhase (-cuspFrequency h * z) = (4 : ℂ)⁻¹ * (f0 z + f1 z + f2 z + f3 z) := by
    rw [rationalSourceEisenstein_primitive_lower_four u t hu ht _ _ _ s hs]
    dsimp only [f0, f1, f2, f3, b]
    ring
  simp_rw [hpoint]
  rw [integral_const_mul,
    integral_add (f := fun z => f0 z + f1 z + f2 z) (g := f3) ((hi0.add hi1).add hi2) hi3,
    integral_add (f := fun z => f0 z + f1 z) (g := f2) (hi0.add hi1) hi2,
    integral_add (f := f0) (g := f1) hi0 hi1]
  have h0 := scaled_unit_eisenstein_fourier 1 u v hv s h hs
  simp only [unitCuspDiagonal_one, map_one, one_mul, inv_one, one_pow] at h0
  have h1 := scaled_unit_eisenstein_fourier_shift (-u) (-u) v hv s h hs b
  have h2 := scaled_unit_eisenstein_fourier_shift (-u) 1 v hv s h hs b
  have h3 := scaled_once_eisenstein_fourier_shift (-u) t v hv s h hs b
  simp only [Units.val_neg] at h1
  simp only [Units.val_one, mul_one] at h2
  change (4 : ℂ)⁻¹ * ((∫ z in periodDomain, f0 z) + (∫ z in periodDomain, f1 z) +
    (∫ z in periodDomain, f2 z) + (∫ z in periodDomain, f3 z)) = _
  rw [h0, h1, h2, h3]
  unfold ramifiedCuspGaussSeries
  dsimp only [b]
  ring

/-- Compact support of a height-strip test after an arbitrary hyperbolic translation. -/
def arbitraryCuspCompact (M : SL(2, ℂ)) (a b : ℝ) : Set HyperbolicSpace :=
  (fun w => M • w) '' cuspIntervalHull a b

lemma arbitraryCuspCompact_isCompact (M : SL(2, ℂ)) (a b : ℝ) (ha : 0 < a) :
    IsCompact (arbitraryCuspCompact M a b) :=
  (cuspIntervalHull_isCompact a b ha).image (continuous_hyperbolic_action M)

lemma arbitraryCusp_projection_bound (M : SL(2, ℂ)) (a b : ℝ) (ha : 0 < a) :
    Measure.map (fun w => integralOrbitProjection globalKubotaKernel (M • w))
      (hyperbolicVolume.restrict (cuspPeriodStrip a b)) ≤
        (kernelCompactMultiplicity (arbitraryCuspCompact M a b)
          (arbitraryCuspCompact_isCompact M a b ha) : ℝ≥0∞) • integralQuotientVolume globalKubotaKernel := by
  have hmap := (measurePreserving_smul M hyperbolicVolume).restrict_image_emb
    (measurableEmbedding_const_smul M) (cuspPeriodStrip a b)
  change Measure.map ((integralOrbitProjection globalKubotaKernel) ∘ (fun w : HyperbolicSpace => M • w)) _ ≤ _
  rw [← Measure.map_map (measurable_integralOrbitProjection _) (measurable_const_smul M), hmap.map_eq]
  apply le_trans _ (kernelCompactMultiplicity_spec _ (arbitraryCuspCompact_isCompact M a b ha))
  apply Measure.map_mono _ (measurable_integralOrbitProjection _)
  exact Measure.restrict_mono_set hyperbolicVolume (Set.image_mono (cuspPeriodStrip_subset_intervalHull a b))

lemma arbitraryCusp_quasiMeasurePreserving (M : SL(2, ℂ)) (a b : ℝ) (ha : 0 < a) :
    Measure.QuasiMeasurePreserving (fun w => integralOrbitProjection globalKubotaKernel (M • w))
      (hyperbolicVolume.restrict (cuspPeriodStrip a b)) (integralQuotientVolume globalKubotaKernel) :=
  ⟨(measurable_integralOrbitProjection _).comp (measurable_const_smul M),
    Measure.absolutelyContinuous_of_le_smul (arbitraryCusp_projection_bound M a b ha)⟩

/-- Compact multiplicity gives a bounded pullback without a quotient action of the translating matrix. -/
def arbitraryCuspPullback (M : SL(2, ℂ)) (a b : ℝ) (ha : 0 < a) :
    KernelQuotientL2 →L[ℂ] Lp ℂ 2 (hyperbolicVolume.restrict (cuspPeriodStrip a b)) :=
  (Lp.compMeasurePreservingₗᵢ ℂ (fun w => integralOrbitProjection globalKubotaKernel (M • w))
    ⟨(measurable_integralOrbitProjection _).comp (measurable_const_smul M), rfl⟩).toContinuousLinearMap.comp
      (dominatedComplexL2 (by simp) (arbitraryCusp_projection_bound M a b ha))

lemma arbitraryCuspPullback_ae (M : SL(2, ℂ)) (a b : ℝ) (ha : 0 < a) (F : KernelQuotientL2) :
    arbitraryCuspPullback M a b ha F =ᵐ[hyperbolicVolume.restrict (cuspPeriodStrip a b)]
      fun w => F (integralOrbitProjection globalKubotaKernel (M • w)) := by
  have hm : MeasurePreserving (fun w => integralOrbitProjection globalKubotaKernel (M • w))
      (hyperbolicVolume.restrict (cuspPeriodStrip a b))
      (Measure.map (fun w => integralOrbitProjection globalKubotaKernel (M • w))
        (hyperbolicVolume.restrict (cuspPeriodStrip a b))) :=
    ⟨(measurable_integralOrbitProjection _).comp (measurable_const_smul M), rfl⟩
  exact (Lp.coeFn_compMeasurePreserving _ hm).trans (hm.quasiMeasurePreserving.ae_eq_comp
    (dominatedComplexL2_ae (by simp) (arbitraryCusp_projection_bound M a b ha) F))

def arbitraryCuspQuotientCompact (M : SL(2, ℂ)) (a b : ℝ) : Set KernelQuotient :=
  integralOrbitProjection globalKubotaKernel '' arbitraryCuspCompact M a b

lemma arbitraryCuspQuotientCompact_isCompact (M : SL(2, ℂ)) (a b : ℝ) (ha : 0 < a) :
    IsCompact (arbitraryCuspQuotientCompact M a b) :=
  (arbitraryCuspCompact_isCompact M a b ha).image (continuous_integralOrbitProjection _)

lemma arbitraryCusp_mem_compact (M : SL(2, ℂ)) (a b : ℝ) (w : HyperbolicSpace)
    (hw : w ∈ cuspPeriodStrip a b) :
    integralOrbitProjection globalKubotaKernel (M • w) ∈ arbitraryCuspQuotientCompact M a b :=
  ⟨M • w, ⟨w, cuspPeriodStrip_subset_intervalHull a b hw, rfl⟩, rfl⟩

def arbitraryCuspHeightFourier (M : SL(2, ℂ)) (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) : KernelQuotientL2 →L[ℂ] ℂ :=
  (innerSL ℂ ((cuspIntervalWeightedFourier_memLp a b ha ρ h).toLp
    (fun w => star (cuspWeightedFourierPhase ρ h w)))).comp (arbitraryCuspPullback M a b ha)

lemma arbitraryCuspHeightFourier_integral (M : SL(2, ℂ)) (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (F : KernelQuotientL2) :
    arbitraryCuspHeightFourier M a b ha ρ h F = ∫ w in cuspPeriodStrip a b,
      F (integralOrbitProjection globalKubotaKernel (M • w)) * cuspWeightedFourierPhase ρ h w ∂hyperbolicVolume := by
  change inner ℂ _ (arbitraryCuspPullback M a b ha F) = _
  rw [L2.inner_def]
  apply integral_congr_ae
  filter_upwards [MemLp.coeFn_toLp (cuspIntervalWeightedFourier_memLp a b ha ρ h),
    arbitraryCuspPullback_ae M a b ha F] with w hw hp
  rw [RCLike.inner_apply, hw, hp]
  simp only [starRingEnd_apply, star_star]

lemma arbitraryCuspHeightFourier_restrict (M : SL(2, ℂ)) (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (F : KernelQuotientL2) :
    arbitraryCuspHeightFourier M a b ha ρ h
      (kernelMassRestrictionCLM (arbitraryCuspQuotientCompact M a b)
        (arbitraryCuspQuotientCompact_isCompact M a b ha).measurableSet F) =
      arbitraryCuspHeightFourier M a b ha ρ h F := by
  rw [arbitraryCuspHeightFourier_integral, arbitraryCuspHeightFourier_integral]
  have he := (arbitraryCusp_quasiMeasurePreserving M a b ha).ae_eq_comp
    (kernelMassRestriction_coe _ (arbitraryCuspQuotientCompact_isCompact M a b ha).measurableSet F)
  apply integral_congr_ae
  filter_upwards [he, ae_restrict_mem (cuspPeriodStrip_measurable a b)] with w hw hwm
  exact congrArg (fun z : ℂ => z * cuspWeightedFourierPhase ρ h w)
    (hw.trans (Set.indicator_of_mem (arbitraryCusp_mem_compact M a b w hwm) _))

def arbitraryCuspHeightFamily (M : SL(2, ℂ)) (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (s : ℂ) : ℂ :=
  arbitraryCuspHeightFourier M a b ha ρ h
    (kernelLocalCorrectedSeed (arbitraryCuspQuotientCompact M a b)
      (arbitraryCuspQuotientCompact_isCompact M a b ha) 2 3 (by norm_num) (by norm_num) s)

lemma arbitraryCuspHeightFamily_analyticAt (M : SL(2, ℂ)) (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (s : ℂ) (hs : 1 < s.re) (hi : 0 < s.im) :
    AnalyticAt ℂ (arbitraryCuspHeightFamily M a b ha ρ h) s :=
  (ContinuousLinearMap.analyticAt (𝕜 := ℂ) (E := KernelQuotientL2) (F := ℂ)
    (arbitraryCuspHeightFourier M a b ha ρ h) _).comp_of_eq
      (kernelLocalCorrectedSeed_analyticAt_nonreal _ (arbitraryCuspQuotientCompact_isCompact M a b ha)
        2 3 (by norm_num) (by norm_num) s hs.ne' hi.ne') rfl

lemma arbitraryCuspHeightFamily_residue_limit (M : SL(2, ℂ)) (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) :
    Tendsto (fun s : ℂ => (s - 4 / 3) * arbitraryCuspHeightFamily M a b ha ρ h s)
      (𝓝[≠] (4 / 3 : ℂ)) (𝓝 (arbitraryCuspHeightFourier M a b ha ρ h cubicEisensteinResidue)) := by
  have he := (arbitraryCuspHeightFourier M a b ha ρ h).continuous.continuousAt.tendsto.comp
    (cubicEisensteinResidue_local_limit _ (arbitraryCuspQuotientCompact_isCompact M a b ha))
  simpa only [Function.comp_def, map_smul, smul_eq_mul, arbitraryCuspHeightFourier_restrict,
    arbitraryCuspHeightFamily] using he

lemma arbitraryCuspHeightFamily_initial (M : SL(2, ℂ)) (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (s : ℂ) (hs : 4 < s.re) (hi : 0 < s.im) :
    arbitraryCuspHeightFamily M a b ha ρ h s = ∫ w in cuspPeriodStrip a b,
      hyperbolicEisenstein s (M • w) * cuspWeightedFourierPhase ρ h w ∂hyperbolicVolume := by
  rw [arbitraryCuspHeightFamily, arbitraryCuspHeightFourier_integral]
  have he := (arbitraryCusp_quasiMeasurePreserving M a b ha).ae_eq_comp
    (cubicEisensteinLocalFamily_initial_ae _ (arbitraryCuspQuotientCompact_isCompact M a b ha) s hs hi)
  apply integral_congr_ae
  filter_upwards [he, ae_restrict_mem (cuspPeriodStrip_measurable a b)] with w hw hwm
  dsimp only [Function.comp_def] at hw
  rw [hw, Set.indicator_of_mem (arbitraryCusp_mem_compact M a b w hwm), kernelQuotientEisenstein_mk]

lemma arbitraryCuspHeightFourier_residual_integral (M : SL(2, ℂ)) (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) :
    arbitraryCuspHeightFourier M a b ha ρ h cubicEisensteinResidue = ∫ w in cuspPeriodStrip a b,
      cubicResidualFunction (M • w) * cuspWeightedFourierPhase ρ h w ∂hyperbolicVolume := by
  rw [arbitraryCuspHeightFourier_integral]
  have he := (measurePreserving_smul M hyperbolicVolume).quasiMeasurePreserving.ae_eq_comp
    cubicEisensteinResidue_continuous_representative
  apply integral_congr_ae
  filter_upwards [ae_restrict_of_ae he] with w hw
  exact congrArg (fun z : ℂ => z * cuspWeightedFourierPhase ρ h w) hw

abbrev RationalFourCusp := Unit ⊕ (Unit ⊕ (Unit ⊕ Unit))

def rationalFourCuspRep : RationalFourCusp → SL(2, ℤ)
  | .inl _ => 1
  | .inr (.inl _) => ModularGroup.S
  | .inr (.inr (.inl _)) => ModularGroup.S * ModularGroup.T
  | .inr (.inr (.inr _)) => ModularGroup.S * ModularGroup.T ^ 2

lemma fourCuspAverage_eq_sum (f : HyperbolicSpace → ℂ) (M : SL(2, ℂ)) (w : HyperbolicSpace) :
    fourCuspAverage f (M • w) =
      (4 : ℂ)⁻¹ * ∑ i : RationalFourCusp, f ((rationalComplex (rationalFourCuspRep i) * M) • w) := by
  simp only [Fintype.sum_sum_type, Fintype.sum_unique, rationalFourCuspRep, map_one, one_mul, one_smul,
    mul_smul, fourCuspAverage]
  ring

lemma cuspStrip_integrable_continuous (a b : ℝ) (ha : 0 < a)
    (f : HyperbolicSpace → ℂ) (hf : Continuous f) :
    IntegrableOn f (cuspPeriodStrip a b) hyperbolicVolume :=
  (hf.continuousOn.integrableOn_compact (cuspIntervalHull_isCompact a b ha)).mono_set
    (cuspPeriodStrip_subset_intervalHull a b)

lemma fourCuspAverage_weighted_integral (f : HyperbolicSpace → ℂ) (hf : Continuous f)
    (M : SL(2, ℂ)) (a b : ℝ) (ha : 0 < a) (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) :
    (∫ w in cuspPeriodStrip a b, fourCuspAverage f (M • w) * cuspWeightedFourierPhase ρ h w ∂hyperbolicVolume) =
      (4 : ℂ)⁻¹ * ∑ i : RationalFourCusp, ∫ w in cuspPeriodStrip a b,
        f ((rationalComplex (rationalFourCuspRep i) * M) • w) * cuspWeightedFourierPhase ρ h w ∂hyperbolicVolume := by
  have hi (i : RationalFourCusp) : IntegrableOn
      (fun w => f ((rationalComplex (rationalFourCuspRep i) * M) • w) * cuspWeightedFourierPhase ρ h w)
      (cuspPeriodStrip a b) hyperbolicVolume :=
    cuspStrip_integrable_continuous a b ha _ ((hf.comp (continuous_hyperbolic_action _)).mul
      (cuspWeightedFourierPhase_continuous ρ h))
  simp_rw [fourCuspAverage_eq_sum, mul_assoc, Finset.sum_mul]
  rw [integral_const_mul, integral_finsetSum _ (fun i _ => hi i)]

def sourceArbitraryHeightFamily (M : SL(2, ℂ)) (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (s : ℂ) : ℂ :=
  (4 : ℂ)⁻¹ * ∑ i : RationalFourCusp,
    arbitraryCuspHeightFamily (rationalComplex (rationalFourCuspRep i) * M) a b ha ρ h s

def sourceArbitraryHeightFourier (M : SL(2, ℂ)) (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) : KernelQuotientL2 →L[ℂ] ℂ :=
  (4 : ℂ)⁻¹ • ∑ i : RationalFourCusp,
    arbitraryCuspHeightFourier (rationalComplex (rationalFourCuspRep i) * M) a b ha ρ h

lemma sourceArbitraryHeightFamily_analyticAt (M : SL(2, ℂ)) (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (s : ℂ) (hs : 1 < s.re) (hi : 0 < s.im) :
    AnalyticAt ℂ (sourceArbitraryHeightFamily M a b ha ρ h) s := by
  apply analyticAt_const.mul
  apply Finset.analyticAt_fun_sum
  intro i hi'
  exact arbitraryCuspHeightFamily_analyticAt _ a b ha ρ h s hs hi

lemma sourceArbitraryHeightFamily_residue_limit (M : SL(2, ℂ)) (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) :
    Tendsto (fun s : ℂ => (s - 4 / 3) * sourceArbitraryHeightFamily M a b ha ρ h s)
      (𝓝[≠] (4 / 3 : ℂ)) (𝓝 (sourceArbitraryHeightFourier M a b ha ρ h cubicEisensteinResidue)) := by
  have he := (tendsto_finsetSum Finset.univ (fun i _ =>
    arbitraryCuspHeightFamily_residue_limit (rationalComplex (rationalFourCuspRep i) * M) a b ha ρ h)).const_mul ((4 : ℂ)⁻¹)
  convert he using 1
  · funext s
    rw [sourceArbitraryHeightFamily, ← Finset.mul_sum]
    ring
  · simp only [sourceArbitraryHeightFourier, _root_.smul_apply, _root_.sum_apply, smul_eq_mul]

lemma sourceArbitraryHeightFamily_initial (M : SL(2, ℂ)) (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (s : ℂ) (hs : 4 < s.re) (hi : 0 < s.im) :
    sourceArbitraryHeightFamily M a b ha ρ h s = ∫ w in cuspPeriodStrip a b,
      rationalSourceEisenstein s (M • w) * cuspWeightedFourierPhase ρ h w ∂hyperbolicVolume := by
  simp_rw [rationalSourceEisenstein_four_cusps s (by linarith)]
  rw [fourCuspAverage_weighted_integral _ (hyperbolicEisenstein_continuous s (by linarith)) M a b ha ρ h]
  unfold sourceArbitraryHeightFamily
  congr 1
  apply Finset.sum_congr rfl
  intro i hi'
  exact arbitraryCuspHeightFamily_initial _ a b ha ρ h s hs hi

lemma sourceArbitraryHeightFourier_residual_integral (M : SL(2, ℂ)) (a b : ℝ) (ha : 0 < a)
    (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) :
    sourceArbitraryHeightFourier M a b ha ρ h cubicEisensteinResidue = ∫ w in cuspPeriodStrip a b,
      cubicSourceResidualFunction (M • w) * cuspWeightedFourierPhase ρ h w ∂hyperbolicVolume := by
  simp_rw [cubicSourceResidualFunction_four_cusps]
  rw [fourCuspAverage_weighted_integral _ cubicResidualFunction_continuous M a b ha ρ h]
  simp only [sourceArbitraryHeightFourier, _root_.smul_apply, _root_.sum_apply, smul_eq_mul,
    arbitraryCuspHeightFourier_residual_integral]

/-- Finite Gauss-series identities pass to residues through the native scalar continuation theorem. -/
theorem finite_unramified_residue {ι : Type*} [Fintype ι] [DecidableEq ι]
    (index : ι → O) (coefficient : ι → ℂ → ℂ)
    (hc : ∀ i s, 1 < s.re → AnalyticAt ℂ (coefficient i) s)
    (f : ℂ → ℂ) (R : ℂ) (hf : ∀ s, 1 < s.re → 0 < s.im → AnalyticAt ℂ f s)
    (hlim : Tendsto (fun s : ℂ => (s - 4 / 3) * f s) (𝓝[≠] (4 / 3 : ℂ)) (𝓝 R))
    (hinit : ∀ s : ℂ, 4 < s.re → 0 < s.im →
      f s = ∑ i, coefficient i s * unramifiedCubicGaussSeries s (index i)) :
    R = ∑ i, coefficient i (4 / 3) * unramifiedGaussResidue (index i) := by
  let H : ι → ℂ → ℂ := fun i s => cuspWhittakerHeightFactor s (3 * index i)
  let G : ι → ℂ → ℂ := fun i s => rationalCuspFamily (3 * index i) oppositeSource 2 3
    (by norm_num) (by norm_num) s
  let D : ℂ → ℂ := fun s => ∏ i, H i s
  let E : ι → ℂ → ℂ := fun i s => ∏ j ∈ Finset.univ.erase i, H j s
  let Bsum : ℂ → ℂ := fun s => ∑ i, coefficient i s * G i s * E i s
  let R1 : ℂ := ∑ i, coefficient i (4 / 3) *
    rationalCuspFourier (3 * index i) oppositeSource cubicEisensteinResidue * E i (4 / 3)
  have hH (i : ι) (s : ℂ) (hs : 1 < s.re) : AnalyticAt ℂ (H i) s :=
    cuspWhittakerHeightFactor_analyticAt (3 * index i) s hs
  have hD (s : ℂ) (hs : 1 < s.re) : AnalyticAt ℂ D s :=
    Finset.analyticAt_fun_prod _ (fun i _ => hH i s hs)
  have hE (i : ι) (s : ℂ) (hs : 1 < s.re) : AnalyticAt ℂ (E i) s :=
    Finset.analyticAt_fun_prod _ (fun j _ => hH j s hs)
  have hprod (i : ι) (s : ℂ) : H i s * E i s = D s :=
    Finset.mul_prod_erase Finset.univ (fun j => H j s) (Finset.mem_univ i)
  have hT : AnalyticOnNhd ℂ Bsum {s : ℂ | 1 < s.re ∧ 0 < s.im} := by
    intro s hs
    apply Finset.analyticAt_fun_sum
    intro i hi
    exact ((hc i s hs.1).mul (rationalCuspFamily_analyticAt_nonreal (3 * index i)
      oppositeSource 2 3 (by norm_num) (by norm_num) s hs.1.ne' hs.2.ne')).mul (hE i s hs.1)
  have hTR : Tendsto (fun s : ℂ => (s - 4 / 3) * Bsum s) (𝓝[≠] (4 / 3 : ℂ)) (𝓝 R1) := by
    have hi (i : ι) := (((hc i (4 / 3) (by norm_num)).continuousAt.tendsto.mono_left nhdsWithin_le_nhds).mul
      (rationalCuspFamily_residue_limit (3 * index i) oppositeSource 2 3 (by norm_num) (by norm_num))).mul
        ((hE i (4 / 3) (by norm_num)).continuousAt.tendsto.mono_left nhdsWithin_le_nhds)
    convert tendsto_finsetSum Finset.univ (fun i _ => hi i) using 1
    · funext s
      dsimp only [Bsum]
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i hi'
      dsimp only [G]
      ring
    · rfl
  have he := cuspScalarResidue_cross f Bsum (fun _ => 1) D R R1
    (fun s hs => hf s hs.1 hs.2) hT (fun _ _ => analyticAt_const)
    (fun s hs => hD s hs.1) continuousAt_const (hD (4 / 3) (by norm_num)).continuousAt hlim hTR (by
      intro s hs hi
      rw [hinit s hs hi, Finset.sum_mul, mul_one]
      apply Finset.sum_congr rfl
      intro i hi'
      dsimp only [G]
      rw [rationalCuspFamily_opposite_initial (index i) s hs hi, ← hprod i s]
      ring)
  have hDn : D (4 / 3) ≠ 0 := Finset.prod_ne_zero_iff.mpr
    (fun i _ => cuspWhittakerHeightFactor_center_ne_zero (3 * index i))
  apply mul_right_cancel₀ hDn
  rw [he, mul_one, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro i hi
  change coefficient i (4 / 3) * rationalCuspFourier (3 * index i) oppositeSource cubicEisensteinResidue *
    E i (4 / 3) = coefficient i (4 / 3) *
      (rationalCuspFourier (3 * index i) oppositeSource cubicEisensteinResidue / H i (4 / 3)) * D (4 / 3)
  rw [← hprod i (4 / 3)]
  field_simp [show H i (4 / 3) ≠ 0 from cuspWhittakerHeightFactor_center_ne_zero (3 * index i)]

def scaledAffineGaussIndex (q : O) (u : Oˣ) (n : ℕ) (h : O) : O :=
  if hh : q ∣ h then 3 * ((u : O) * lambda ^ n) ^ 2 * Classical.choose hh else 0

def scaledAffineGaussWeight (q : O) (u : Oˣ) (n : ℕ) (h : O) (s : ℂ) : ℂ :=
  if hh : q ∣ h then
    if (3 : O) ∣ Classical.choose hh + ramifiedArithmeticPhase u n then
      (Ideal.absNorm (Ideal.span {3 * q}) : ℂ) * ((‖ringComplex (3 * q)‖ ^ 2 : ℝ) : ℂ) ^ (-s) *
        tracePhase (cuspFrequency h / ringComplex (3 * q))
    else 0
  else 0

lemma scaledAffineGaussSeries_factor (q : O) (u : Oˣ) (n : ℕ) (h : O) (s : ℂ) :
    scaledAffineGaussSeries q u n h s =
      scaledAffineGaussWeight q u n h s * unramifiedCubicGaussSeries s (scaledAffineGaussIndex q u n h) := by
  unfold scaledAffineGaussSeries scaledAffineGaussWeight scaledAffineGaussIndex
  dsimp only
  split_ifs <;> simp_all only [zero_mul]

lemma scaledAffineGaussWeight_analyticAt (q : O) (hq : q ≠ 0) (u : Oˣ) (n : ℕ) (h : O) (s : ℂ) :
    AnalyticAt ℂ (scaledAffineGaussWeight q u n h) s := by
  unfold scaledAffineGaussWeight
  split_ifs
  · apply AnalyticAt.mul _ analyticAt_const
    apply analyticAt_const.mul
    apply Complex.analyticAt_iff_eventually_differentiableAt.mpr
    apply Eventually.of_forall
    intro z
    exact differentiableAt_id.neg.const_cpow (Or.inl (Complex.ofReal_ne_zero.mpr
      (pow_ne_zero 2 (norm_ne_zero_iff.mpr (ringComplex_ne_zero (mul_ne_zero (by norm_num) hq))))))
  · exact analyticAt_const
  · exact analyticAt_const

abbrev RamifiedSixBranch := Unit ⊕ (Unit ⊕ (Unit ⊕ Fin 3))

def ramifiedSixIndex (u t : Oˣ) (h : O) : RamifiedSixBranch → O
  | .inl _ => scaledAffineGaussIndex (u : O) u 0 h
  | .inr (.inl _) => scaledAffineGaussIndex (-(u : O)) ((-u)⁻¹ ^ 2 * (-u)) 0 h
  | .inr (.inr (.inl _)) => scaledAffineGaussIndex 1 ((-u)⁻¹ ^ 2) 0 h
  | .inr (.inr (.inr j)) => scaledAffineGaussIndex (onceCuspScale t * omega ^ j.val)
      (onceCuspArithmeticUnit (-u) t j) 1 h

def ramifiedSixWeight (u t : Oˣ) (h : O) (i : RamifiedSixBranch) (s : ℂ) : ℂ :=
  let phase := tracePhase (cuspFrequency h * (ringComplex (↑u⁻¹ : O) / 3))
  match i with
  | .inl _ => (4 : ℂ)⁻¹ * scaledAffineGaussWeight (u : O) u 0 h s
  | .inr (.inl _) => (4 : ℂ)⁻¹ * phase * scaledAffineGaussWeight (-(u : O)) ((-u)⁻¹ ^ 2 * (-u)) 0 h s
  | .inr (.inr (.inl _)) => (4 : ℂ)⁻¹ * phase * scaledAffineGaussWeight 1 ((-u)⁻¹ ^ 2) 0 h s
  | .inr (.inr (.inr j)) => (4 : ℂ)⁻¹ * phase *
      scaledAffineGaussWeight (onceCuspScale t * omega ^ j.val) (onceCuspArithmeticUnit (-u) t j) 1 h s

lemma ramifiedSixWeight_analyticAt (u t : Oˣ) (h : O) (i : RamifiedSixBranch) (s : ℂ) :
    AnalyticAt ℂ (ramifiedSixWeight u t h i) s := by
  rcases i with i | i
  · exact analyticAt_const.mul (scaledAffineGaussWeight_analyticAt _ u.ne_zero _ _ _ _)
  rcases i with i | i
  · exact analyticAt_const.mul (scaledAffineGaussWeight_analyticAt _ (neg_ne_zero.mpr u.ne_zero) _ _ _ _)
  rcases i with i | j
  · exact analyticAt_const.mul (scaledAffineGaussWeight_analyticAt _ one_ne_zero _ _ _ _)
  · exact analyticAt_const.mul (scaledAffineGaussWeight_analyticAt _
      (mul_ne_zero (onceCusp_scale_ne_zero t) (pow_ne_zero _ (omega_primitive.isUnit (by decide)).ne_zero)) _ _ _ _)

lemma ramifiedCuspGaussSeries_eq_six (u t : Oˣ) (h : O) (s : ℂ) :
    ramifiedCuspGaussSeries u t h s =
      ∑ i : RamifiedSixBranch, ramifiedSixWeight u t h i s * unramifiedCubicGaussSeries s (ramifiedSixIndex u t h i) := by
  simp only [Fintype.sum_sum_type, Fintype.sum_unique, ramifiedSixWeight, ramifiedSixIndex,
    ramifiedCuspGaussSeries, scaledAffineGaussSeries_factor, Fin.sum_univ_three]
  ring

def ramifiedArithmeticResidue (u t : Oˣ) (h : O) : ℂ :=
  ∑ i : RamifiedSixBranch, ramifiedSixWeight u t h i (4 / 3) * unramifiedGaussResidue (ramifiedSixIndex u t h i)

def cuspTripleDilation : SL(2, ℂ) :=
  complexDiagonal (Real.sqrt 3 : ℂ) (Complex.ofReal_ne_zero.mpr (Real.sqrt_pos.mpr (by norm_num)).ne')

lemma cuspTripleDilation_action (z : ℂ) (v : ℝ) (hv : 0 < v) :
    cuspTripleDilation • upperPoint z v hv = upperPoint (3 * z) (3 * v) (by positivity) := by
  rw [cuspTripleDilation, complexDiagonal_action]
  have hp : (Real.sqrt 3 : ℂ) ^ 2 = 3 := by
    norm_cast
    norm_num
  have hn : Complex.normSq (Real.sqrt 3 : ℂ) = 3 := by
    simp [Complex.normSq_apply, Real.sq_sqrt]
  simp only [hp, hn]

def scaledRamifiedCuspMatrix (u : Oˣ) : SL(2, ℂ) :=
  integralComplexMatrix (lowerCuspMatrix (u : O)) * cuspTripleDilation

lemma scaledRamifiedCuspMatrix_action (u : Oˣ) (z : ℂ) (v : ℝ) (hv : 0 < v) :
    scaledRamifiedCuspMatrix u • upperPoint z v hv =
      integralComplexMatrix (lowerCuspMatrix (u : O)) • upperPoint (3 * z) (3 * v) (by positivity) := by
  rw [scaledRamifiedCuspMatrix, mul_smul, cuspTripleDilation_action]

lemma ramifiedSource_height_fourier_average (u t : Oˣ)
    (hu : (u : O) ^ 2 + (u : O) + 1 = 0) (ht : -(u : O) * (1 + 2 * (u : O)) = onceCuspScale t)
    (a b : ℝ) (ha : 0 < a) (ρ : BoundedContinuousFunction ℝ ℂ) (s : ℂ) (hs : 2 < s.re) (h : O) :
    (∫ w in cuspPeriodStrip a b, rationalSourceEisenstein s (scaledRamifiedCuspMatrix u • w) *
      cuspWeightedFourierPhase ρ h w ∂hyperbolicVolume) =
      (3 : ℂ) ^ s * ramifiedCuspGaussSeries u t h s * cuspIntervalWhittakerFactor a b ρ s h := by
  let g : HyperbolicSpace → ℂ := fun w => rationalSourceEisenstein s (scaledRamifiedCuspMatrix u • w) *
    cuspWeightedFourierPhase ρ h w
  have hg : Continuous g := ((rationalSourceProjection_continuous _
    (hyperbolicEisenstein_continuous s hs)).comp (continuous_hyperbolic_action _)).mul
      (cuspWeightedFourierPhase_continuous ρ h)
  rw [cuspInterval_integral_coordinates a b ha g hg.aestronglyMeasurable
    (cuspInterval_continuous_integrable a b ha g hg)]
  have hinner (v : ℝ) (hv : 0 < v) : (∫ z in periodDomain, g (cuspCoordinateLift (v, z))) =
      ρ v * ((3 : ℂ) ^ s * ((v : ℂ) ^ (2 - s) * sourceFourierKernel s (cuspFrequency h * v)) *
        ramifiedCuspGaussSeries u t h s) := by
    simp_rw [g, cuspCoordinateLift_positive v _ hv, scaledRamifiedCuspMatrix_action,
      cuspWeightedFourierPhase, hyperbolicHeight_upperPoint, cuspFourierPhase, hyperbolicHorizontal_upperPoint]
    rw [← ramifiedSourceEisenstein_scaled_fourier u t hu ht v hv s hs h, ← integral_const_mul]
    exact integral_congr_ae (Eventually.of_forall (fun z => by ring))
  rw [cuspIntervalWhittakerFactor, ← integral_const_mul]
  apply setIntegral_congr_fun measurableSet_Icc
  intro v hv
  have hv0 := Complex.ofReal_ne_zero.mpr (ha.trans_le hv.1).ne'
  dsimp only
  rw [hinner v (ha.trans_le hv.1)]
  have hp : (v : ℂ) ^ (-s - 1) = (v : ℂ) ^ (2 - s) / (v : ℂ) ^ 3 := by
    rw [show -s - 1 = (2 - s) - 3 by ring, Complex.cpow_sub _ _ hv0]
    congr 1
    exact Complex.cpow_natCast _ 3
  rw [hp]
  ring

/-- The six arithmetic residues determine every compact height test of the actual ramified source. -/
theorem ramifiedSource_height_residue (u t : Oˣ)
    (hu : (u : O) ^ 2 + (u : O) + 1 = 0) (ht : -(u : O) * (1 + 2 * (u : O)) = onceCuspScale t)
    (a b : ℝ) (ha : 0 < a) (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) :
    sourceArbitraryHeightFourier (scaledRamifiedCuspMatrix u) a b ha ρ h cubicEisensteinResidue =
      (3 : ℂ) ^ (4 / 3 : ℂ) * ramifiedArithmeticResidue u t h * cuspIntervalWhittakerFactor a b ρ (4 / 3) h := by
  let coeff : RamifiedSixBranch → ℂ → ℂ := fun i s =>
    (3 : ℂ) ^ s * ramifiedSixWeight u t h i s * cuspIntervalWhittakerFactor a b ρ s h
  have h3 (s : ℂ) : AnalyticAt ℂ (fun z : ℂ => (3 : ℂ) ^ z) s := by
    apply Complex.analyticAt_iff_eventually_differentiableAt.mpr
    exact Eventually.of_forall (fun z => differentiableAt_id.const_cpow (Or.inl (by norm_num)))
  have hc (i : RamifiedSixBranch) (s : ℂ) (hs : 1 < s.re) : AnalyticAt ℂ (coeff i) s :=
    ((h3 s).mul (ramifiedSixWeight_analyticAt u t h i s)).mul
      (cuspIntervalWhittakerFactor_analyticAt a b ha ρ h s hs)
  have he := finite_unramified_residue (ramifiedSixIndex u t h) coeff hc
    (sourceArbitraryHeightFamily (scaledRamifiedCuspMatrix u) a b ha ρ h)
    (sourceArbitraryHeightFourier (scaledRamifiedCuspMatrix u) a b ha ρ h cubicEisensteinResidue)
    (sourceArbitraryHeightFamily_analyticAt _ a b ha ρ h)
    (sourceArbitraryHeightFamily_residue_limit _ a b ha ρ h) (by
      intro s hs hi
      rw [sourceArbitraryHeightFamily_initial _ a b ha ρ h s hs hi,
        ramifiedSource_height_fourier_average u t hu ht a b ha ρ s (by linarith) h,
        ramifiedCuspGaussSeries_eq_six, Finset.mul_sum, Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro i hi'
      dsimp only [coeff]
      ring)
  refine he.trans ?_
  rw [ramifiedArithmeticResidue, Finset.mul_sum, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro i hi
  dsimp only [coeff]
  ring

theorem ramifiedSource_height_residue_integral (u t : Oˣ)
    (hu : (u : O) ^ 2 + (u : O) + 1 = 0) (ht : -(u : O) * (1 + 2 * (u : O)) = onceCuspScale t)
    (a b : ℝ) (ha : 0 < a) (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) :
    (∫ w in cuspPeriodStrip a b, cubicSourceResidualFunction (scaledRamifiedCuspMatrix u • w) *
      cuspWeightedFourierPhase ρ h w ∂hyperbolicVolume) =
      (3 : ℂ) ^ (4 / 3 : ℂ) * ramifiedArithmeticResidue u t h * cuspIntervalWhittakerFactor a b ρ (4 / 3) h := by
  rw [← sourceArbitraryHeightFourier_residual_integral]
  exact ramifiedSource_height_residue u t hu ht a b ha ρ h

def ramifiedResidualFourierCoefficient (u t : Oˣ) (h : O) : ℂ :=
  ((3 : ℂ) ^ (4 / 3 : ℂ) * ramifiedArithmeticResidue u t h / ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ)) *
    ((2 * Real.pi : ℂ) / Complex.Gamma (4 / 3) * (2 * Real.pi * ‖cuspFrequency h‖ : ℂ) ^ (1 / 3 : ℂ))

theorem ramifiedSource_height_bessel (u t : Oˣ)
    (hu : (u : O) ^ 2 + (u : O) + 1 = 0) (ht : -(u : O) * (1 + 2 * (u : O)) = onceCuspScale t)
    (a b : ℝ) (ha : 0 < a) (ρ : BoundedContinuousFunction ℝ ℂ) (h : O) (hh : h ≠ 0) :
    (∫ w in cuspPeriodStrip a b, cubicSourceResidualFunction (scaledRamifiedCuspMatrix u • w) *
      cuspWeightedFourierPhase ρ h w ∂hyperbolicVolume) =
      ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * ramifiedResidualFourierCoefficient u t h *
        ∫ v in Set.Icc a b, ρ v *
          (schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) / (v : ℂ) ^ 2) := by
  rw [ramifiedSource_height_residue_integral u t hu ht a b ha ρ h,
    cuspIntervalWhittakerFactor_center_bessel a b ha ρ h hh, ramifiedResidualFourierCoefficient]
  field_simp [cusp_volume_ne_zero]

lemma ramifiedResidualFourierCoefficient_interval_bound (u t : Oˣ)
    (hu : (u : O) ^ 2 + (u : O) + 1 = 0) (ht : -(u : O) * (1 + 2 * (u : O)) = onceCuspScale t)
    (a b : ℝ) (ha : 0 < a) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖ramifiedResidualFourierCoefficient u t h‖ * ‖∫ v in Set.Icc a b,
        schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) / (v : ℂ) ^ 2‖ ≤ C := by
  let f : HyperbolicSpace → ℂ := fun w => cubicSourceResidualFunction (scaledRamifiedCuspMatrix u • w)
  let B : ℝ := ∫ w in cuspPeriodStrip a b, ‖f w‖ ∂hyperbolicVolume
  have hB : 0 ≤ B := integral_nonneg (fun w => norm_nonneg (f w))
  let area : ℂ := ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ)
  have harea : 0 < ‖area‖ := norm_pos_iff.mpr cusp_volume_ne_zero
  refine ⟨B / ‖area‖, div_nonneg hB harea.le, ?_⟩
  intro h hh
  have hb := norm_integral_le_integral_norm (μ := hyperbolicVolume.restrict (cuspPeriodStrip a b)) (fun w => f w *
    cuspWeightedFourierPhase (BoundedContinuousFunction.const ℝ 1) h w)
  change ‖∫ w in cuspPeriodStrip a b, f w * cuspWeightedFourierPhase _ h w ∂hyperbolicVolume‖ ≤ _ at hb
  rw [ramifiedSource_height_bessel u t hu ht a b ha _ h hh] at hb
  simp only [BoundedContinuousFunction.const_apply, one_mul, norm_mul, cuspWeightedFourierPhase,
    cuspFourierPhase, tracePhase_norm, norm_one, mul_one] at hb
  apply (le_div_iff₀ harea).mpr
  calc
    _ = ‖area‖ * ‖ramifiedResidualFourierCoefficient u t h‖ * ‖∫ v in Set.Icc a b,
        schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) / (v : ℂ) ^ 2‖ := by ring
    _ ≤ _ := hb

/-- Arbitrarily low compact strips force subexponential growth at the ramified cusps. -/
theorem ramifiedResidualFourierCoefficient_subexponential (u t : Oˣ)
    (hu : (u : O) ^ 2 + (u : O) + 1 = 0) (ht : -(u : O) * (1 + 2 * (u : O)) = onceCuspScale t)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖ramifiedResidualFourierCoefficient u t h‖ ≤ C * Real.exp (ε * ‖cuspFrequency h‖) :=
  cubicBesselCoefficient_subexponential (ramifiedResidualFourierCoefficient u t)
    (ramifiedResidualFourierCoefficient_interval_bound u t hu ht) ε hε

theorem ramifiedSource_fourier_all_heights (u t : Oˣ)
    (hu : (u : O) ^ 2 + (u : O) + 1 = 0) (ht : -(u : O) * (1 + 2 * (u : O)) = onceCuspScale t)
    (v : ℝ) (hv : 0 < v) (h : O) :
    (∫ z in periodDomain, cubicSourceResidualFunction (scaledRamifiedCuspMatrix u • upperPoint z v hv) *
      tracePhase (-cuspFrequency h * z)) =
      ((3 : ℂ) ^ (4 / 3 : ℂ) * ramifiedArithmeticResidue u t h) *
        ((v : ℂ) ^ (2 / 3 : ℂ) * sourceFourierKernel (4 / 3) (cuspFrequency h * v)) := by
  let f : HyperbolicSpace → ℂ := fun w => cubicSourceResidualFunction (scaledRamifiedCuspMatrix u • w)
  have hf : Continuous f := cubicSourceResidualFunction_continuous.comp (continuous_hyperbolic_action _)
  let R := (3 : ℂ) ^ (4 / 3 : ℂ) * ramifiedArithmeticResidue u t h
  let D : ℝ → ℂ := fun v => R *
    ((v : ℂ) ^ (-(4 / 3 : ℂ) - 1) * sourceFourierKernel (4 / 3) (cuspFrequency h * v))
  have hD : ContinuousOn D (Set.Ioi 0) := by
    intro v hv
    exact (continuousAt_const.mul
      ((Complex.continuousAt_ofReal_cpow_const v _ (Or.inr hv.ne')).mul
        (((sourceFourierKernel_continuous_freq (4 / 3) (by norm_num)).comp
          (Complex.continuous_ofReal.const_mul (cuspFrequency h))).continuousAt))).continuousWithinAt
  have he := continuousCuspSlice_eq_of_interval_tests f hf h D hD (by
    intro a b ha ρ
    rw [ramifiedSource_height_residue_integral u t hu ht a b ha ρ h,
      cuspIntervalWhittakerFactor, ← integral_const_mul]
    apply integral_congr_ae
    exact Eventually.of_forall (fun v => by dsimp only [D, R]; ring)) v hv
  have hv0 : (v : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hv.ne'
  have hpow : (v : ℂ) ^ (-(4 / 3 : ℂ) - 1) * (v : ℂ) ^ 3 = (v : ℂ) ^ (2 / 3 : ℂ) := by
    rw [← Complex.cpow_natCast, ← Complex.cpow_add _ _ hv0]
    congr 1
    norm_num
  dsimp only [continuousCuspSlice, f, D] at he
  simp_rw [cuspCoordinateLift_positive v _ hv] at he
  rw [div_eq_iff (pow_ne_zero 3 hv0)] at he
  rw [he]
  linear_combination R * sourceFourierKernel (4 / 3) (cuspFrequency h * v) * hpow

theorem ramifiedSource_fourier_bessel (u t : Oˣ)
    (hu : (u : O) ^ 2 + (u : O) + 1 = 0) (ht : -(u : O) * (1 + 2 * (u : O)) = onceCuspScale t)
    (v : ℝ) (hv : 0 < v) (h : O) (hh : h ≠ 0) :
    (∫ z in periodDomain, cubicSourceResidualFunction (scaledRamifiedCuspMatrix u • upperPoint z v hv) *
      tracePhase (-cuspFrequency h * z)) =
      ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * ramifiedResidualFourierCoefficient u t h * (v : ℂ) *
        schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * v) := by
  rw [ramifiedSource_fourier_all_heights u t hu ht]
  have hv0 : (v : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hv.ne'
  have hp : (v : ℂ) ^ (-(4 / 3 : ℂ) - 1) * (v : ℂ) ^ 3 = (v : ℂ) ^ (2 / 3 : ℂ) := by
    rw [← Complex.cpow_natCast, ← Complex.cpow_add _ _ hv0]
    congr 1
    norm_num
  rw [← hp]
  calc
    _ = ((3 : ℂ) ^ (4 / 3 : ℂ) * ramifiedArithmeticResidue u t h) *
        (((v : ℂ) ^ (-(4 / 3 : ℂ) - 1) * sourceFourierKernel (4 / 3) (cuspFrequency h * v)) * (v : ℂ) ^ 3) := by ring
    _ = _ := by
      rw [sourceFourierKernel_residual_height h hh v hv, ramifiedResidualFourierCoefficient]
      field_simp [hv0, cusp_volume_ne_zero]

/-- The two primitive cubic cusps and their once-ramified scale units. -/
def ramifiedCuspRoot : Bool → Oˣ
  | false => cuspOmegaUnit
  | true => cuspOmegaUnit ^ 2

def ramifiedCuspScaleUnit : Bool → Oˣ
  | false => -cuspOmegaUnit
  | true => cuspOmegaUnit ^ 2

lemma ramifiedCuspRoot_relation (side : Bool) :
    (ramifiedCuspRoot side : O) ^ 2 + (ramifiedCuspRoot side : O) + 1 = 0 := by
  cases side
  · exact cusp_omega_relation
  · simp only [ramifiedCuspRoot, Units.val_pow_eq_pow_val, cuspOmegaUnit_val]
    linear_combination (omega ^ 2 - omega + 1) * cusp_omega_relation

lemma ramifiedCuspScaleUnit_spec (side : Bool) :
    -(ramifiedCuspRoot side : O) * (1 + 2 * (ramifiedCuspRoot side : O)) =
      onceCuspScale (ramifiedCuspScaleUnit side) := by
  cases side
  · simp only [ramifiedCuspRoot, ramifiedCuspScaleUnit, onceCuspScale,
      Units.val_neg, cuspOmegaUnit_val, traceLambda]
  · simp only [ramifiedCuspRoot, ramifiedCuspScaleUnit, onceCuspScale,
      Units.val_pow_eq_pow_val, cuspOmegaUnit_val, traceLambda]
    linear_combination -2 * omega ^ 2 * cusp_omega_relation

def ramifiedBesselCoefficient (side : Bool) : O → ℂ :=
  ramifiedResidualFourierCoefficient (ramifiedCuspRoot side) (ramifiedCuspScaleUnit side)

theorem ramifiedBesselCoefficient_subexponential (side : Bool) (ε : ℝ) (hε : 0 < ε) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖ramifiedBesselCoefficient side h‖ ≤ C * Real.exp (ε * ‖cuspFrequency h‖) :=
  ramifiedResidualFourierCoefficient_subexponential _ _
    (ramifiedCuspRoot_relation side) (ramifiedCuspScaleUnit_spec side) ε hε

lemma ramifiedScaledRow_continuous (t : O) (v : ℝ) (hv : 0 < v) :
    Continuous (ramifiedScaledRow t v) := by
  have hp : 0 < 3 * v := by positivity
  have he : ramifiedScaledRow t v = fun z => ramifiedSourceFunction t (upperPoint (3 * z) (3 * v) hp) := by
    funext z
    rw [ramifiedScaledRow, cuspCoordinateLift_positive _ _ hp]
  rw [he]
  exact (ramifiedSourceFunction_continuous t).comp
    (upperCoordinatesHomeomorph.continuous.comp
      (show Continuous (fun z : ℂ => (⟨(3 * z, 3 * v), hp⟩ : UpperCoordinates)) by fun_prop))

lemma ramifiedScaledRow_zero (side : Bool) (v : ℝ) (hv : 0 < v) :
    (∫ z in periodDomain, ramifiedScaledRow (ramifiedCuspRoot side : O) v z) = 0 := by
  have hp : 0 < 3 * v := by positivity
  simp only [ramifiedScaledRow, cuspCoordinateLift_positive _ _ hp]
  cases side
  · exact ramifiedSourceFunction_omega_constant_zero (3 * v) hp
  · exact ramifiedSourceFunction_omega_sq_constant_zero (3 * v) hp

theorem ramifiedScaledRow_fourier (side : Bool) (v : ℝ) (hv : 0 < v) (h : O) :
    (∫ z in periodDomain, ramifiedScaledRow (ramifiedCuspRoot side : O) v z *
      tracePhase (-cuspFrequency h * z)) =
      ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) * cubicBesselAmplitude (ramifiedBesselCoefficient side) v h := by
  by_cases hh : h = 0
  · subst h
    simp only [cuspFrequency, map_zero, zero_div, neg_zero, zero_mul,
      AddChar.map_zero_eq_one, mul_one, cubicBesselAmplitude, if_true]
    rw [ramifiedScaledRow_zero side v hv, mul_zero]
  have he := ramifiedSource_fourier_bessel _ _ (ramifiedCuspRoot_relation side)
    (ramifiedCuspScaleUnit_spec side) v hv h hh
  simp_rw [scaledRamifiedCuspMatrix_action] at he
  simpa only [ramifiedScaledRow, cuspCoordinateLift_positive _ _ (show 0 < 3 * v by positivity),
    ramifiedSourceFunction, cubicBesselAmplitude, if_neg hh, ramifiedBesselCoefficient, mul_assoc] using he

lemma cubicBesselAmplitude_summable (c : O → ℂ)
    (hsub : ∀ ε : ℝ, 0 < ε → ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖c h‖ ≤ C * Real.exp (ε * ‖cuspFrequency h‖)) (v : ℝ) (hv : 0 < v) :
    Summable (fun h => ‖cubicBesselAmplitude c v h‖) := by
  simpa only [cubicBesselTerm, norm_mul, tracePhase_norm, mul_one] using
    cubicBesselTerm_summable_norm c hsub (v, 0) hv

/-- The primitive ramified cusps have no constant mode and equal their Bessel series pointwise. -/
theorem ramifiedScaledRow_eq_bessel (side : Bool) (v : ℝ) (hv : 0 < v) (z : ℂ) :
    ramifiedScaledRow (ramifiedCuspRoot side : O) v z =
      cuspCharacterSeries (cubicBesselAmplitude (ramifiedBesselCoefficient side) v) z := by
  have hs := cubicBesselAmplitude_summable _ (ramifiedBesselCoefficient_subexponential side) v hv
  exact congrFun (periodDomain_continuous_ext _ _ (ramifiedScaledRow_continuous _ v hv)
    (cuspCharacterSeries_continuous _ hs) (ramifiedScaledRow_period _ v hv)
    (fun n z => cuspCharacterSeries_period _ z n) (fun h => by
      rw [ramifiedScaledRow_fourier side v hv h, cuspCharacterSeries_fourier _ hs h])) z

theorem ramifiedSource_bessel (side : Bool) (v : ℝ) (hv : 0 < v) (z : ℂ) :
    ramifiedSourceFunction (ramifiedCuspRoot side : O) (upperPoint z v hv) =
      ∑' h : O, cubicBesselTerm (ramifiedBesselCoefficient side) h (v / 3, z / 3) := by
  have he := ramifiedScaledRow_eq_bessel side (v / 3) (by positivity) (z / 3)
  simpa only [ramifiedScaledRow, mul_div_cancel₀ _ (by norm_num : (3 : ℝ) ≠ 0),
    show (3 : ℂ) * (z / 3) = z by ring, show 3 * (v / 3) = v by ring,
    cuspCoordinateLift_positive v z hv, cuspCharacterSeries, cubicBesselTerm] using he

theorem ramifiedSource_bessel_normal (side : Bool) (a b : ℝ) (ha : 0 < a) (hab : a ≤ b) :
    ∃ g : O → ℝ, Summable g ∧ ∀ h : O, ∀ v : ℝ, v ∈ Set.Icc a b → ∀ z : ℂ,
      ‖cubicBesselTerm (ramifiedBesselCoefficient side) h (v / 3, z / 3)‖ ≤ g h := by
  obtain ⟨C, hC, hb⟩ := cubicBesselTerm_strip_bound _ (ramifiedBesselCoefficient_subexponential side)
    (a / 3) (b / 3) (by positivity) (by linarith only [hab])
  refine ⟨fun h => C * Real.exp (-(Real.pi * (a / 3)) * ‖cuspFrequency h‖),
    (summable_exp_neg_cuspFrequency_norm _ (by positivity)).mul_left C, ?_⟩
  intro h v hv z
  exact hb h (v / 3, z / 3) ⟨by dsimp only; linarith only [hv.1], by dsimp only; linarith only [hv.2]⟩

def residualBesselDecayRate : ℝ := Real.pi * ‖(3 : ℂ) * ringComplex traceLambda‖⁻¹ / 2

lemma residualBesselDecayRate_pos : 0 < residualBesselDecayRate := by
  have hd := norm_pos_iff.mpr (mul_ne_zero (by norm_num : (3 : ℂ) ≠ 0)
    (ringComplex_ne_zero traceLambda_ne_zero))
  unfold residualBesselDecayRate
  positivity

/-- The frequency gap leaves exponential decay in height after summing all horizontal modes. -/
theorem cubicBesselAmplitude_exponential_bound (c : O → ℂ)
    (hsub : ∀ ε : ℝ, 0 < ε → ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖c h‖ ≤ C * Real.exp (ε * ‖cuspFrequency h‖)) (a : ℝ) (ha : 0 < a) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, ∀ v : ℝ, a ≤ v →
      ‖cubicBesselAmplitude c v h‖ ≤ C * Real.exp (-(Real.pi * a / 2) * ‖cuspFrequency h‖) *
        Real.exp (-residualBesselDecayRate * v) := by
  let d : ℝ := ‖(3 : ℂ) * ringComplex traceLambda‖⁻¹
  have hd : 0 < d := inv_pos.mpr (norm_pos_iff.mpr
    (mul_ne_zero (by norm_num) (ringComplex_ne_zero traceLambda_ne_zero)))
  obtain ⟨B, hB, hb⟩ := schlafliBesselK_one_third_exp_upper (4 * Real.pi * d * a) (by positivity)
  obtain ⟨A, hA, hc⟩ := hsub (Real.pi * a / 2) (by positivity)
  refine ⟨A * B * (2 / (Real.pi * d)), by positivity, ?_⟩
  intro h v hv
  by_cases hh : h = 0
  · simp only [cubicBesselAmplitude, if_pos hh, norm_zero]
    positivity
  have hvp := ha.trans_le hv
  have hgap : d ≤ ‖cuspFrequency h‖ := cuspFrequency_norm_lower h hh
  have hrv := mul_le_mul_of_nonneg_left hv (norm_nonneg (cuspFrequency h))
  have hdv := mul_le_mul_of_nonneg_right hgap hvp.le
  have hx : 4 * Real.pi * d * a ≤ 4 * Real.pi * ‖cuspFrequency h‖ * v := by
    have hm := mul_le_mul hgap hv ha.le (norm_nonneg (cuspFrequency h))
    nlinarith only [mul_le_mul_of_nonneg_left hm (by positivity : 0 ≤ 4 * Real.pi)]
  have hexp : (Real.pi * a / 2) * ‖cuspFrequency h‖ -
      (4 * Real.pi * ‖cuspFrequency h‖ * v) / 2 ≤
      -(Real.pi * a / 2) * ‖cuspFrequency h‖ + -(Real.pi * d) * v := by
    nlinarith only [mul_le_mul_of_nonneg_left (add_le_add hrv hdv) Real.pi_pos.le]
  rw [cubicBesselAmplitude, if_neg hh, norm_mul, norm_mul, Complex.norm_of_nonneg hvp.le]
  calc
    _ ≤ (A * Real.exp ((Real.pi * a / 2) * ‖cuspFrequency h‖)) * v *
        (B * Real.exp (-(4 * Real.pi * ‖cuspFrequency h‖ * v) / 2)) :=
      mul_le_mul (mul_le_mul_of_nonneg_right (hc h hh) hvp.le) (hb _ hx) (norm_nonneg _) (by positivity)
    _ = (A * B * v) * Real.exp ((Real.pi * a / 2) * ‖cuspFrequency h‖ -
        (4 * Real.pi * ‖cuspFrequency h‖ * v) / 2) := by
      rw [show -(4 * Real.pi * ‖cuspFrequency h‖ * v) / 2 =
        -((4 * Real.pi * ‖cuspFrequency h‖ * v) / 2) by ring, Real.exp_neg, Real.exp_sub]
      ring
    _ ≤ (A * B * v) * Real.exp (-(Real.pi * a / 2) * ‖cuspFrequency h‖ + -(Real.pi * d) * v) :=
      mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr hexp) (by positivity)
    _ = (A * B * Real.exp (-(Real.pi * a / 2) * ‖cuspFrequency h‖)) *
        (v * Real.exp (-(Real.pi * d) * v)) := by rw [Real.exp_add]; ring
    _ ≤ (A * B * Real.exp (-(Real.pi * a / 2) * ‖cuspFrequency h‖)) *
        ((2 / (Real.pi * d)) * Real.exp (-(Real.pi * d / 2) * v)) :=
      mul_le_mul_of_nonneg_left (frequency_exp_absorption (Real.pi * d) v (by positivity)) (by positivity)
    _ = _ := by dsimp only [residualBesselDecayRate, d]; ring

theorem cubicBesselSeries_exponential_decay (c : O → ℂ)
    (hsub : ∀ ε : ℝ, 0 < ε → ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖c h‖ ≤ C * Real.exp (ε * ‖cuspFrequency h‖)) (a : ℝ) (ha : 0 < a) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ v : ℝ, a ≤ v → ∀ z : ℂ,
      ‖∑' h : O, cubicBesselTerm c h (v, z)‖ ≤ C * Real.exp (-residualBesselDecayRate * v) := by
  obtain ⟨C, hC, hb⟩ := cubicBesselAmplitude_exponential_bound c hsub a ha
  let w : O → ℝ := fun h => Real.exp (-(Real.pi * a / 2) * ‖cuspFrequency h‖)
  have hw : Summable w := summable_exp_neg_cuspFrequency_norm _ (by positivity)
  refine ⟨C * ∑' h, w h, mul_nonneg hC (tsum_nonneg (fun h => (Real.exp_pos _).le)), ?_⟩
  intro v hv z
  have hs := cubicBesselTerm_summable_norm c hsub (v, z) (ha.trans_le hv)
  have hm (h : O) : ‖cubicBesselTerm c h (v, z)‖ ≤
      C * w h * Real.exp (-residualBesselDecayRate * v) := by
    simpa only [cubicBesselTerm, norm_mul, tracePhase_norm, mul_one] using hb h v hv
  have he := (norm_tsum_le_tsum_norm hs).trans
    (Summable.tsum_le_tsum hm hs ((hw.mul_left C).mul_right _))
  simpa only [tsum_mul_right, tsum_mul_left] using he

theorem ramifiedSource_exponential_decay (side : Bool) (a : ℝ) (ha : 0 < a) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ v : ℝ, ∀ hv : 0 < v, a ≤ v → ∀ z : ℂ,
      ‖ramifiedSourceFunction (ramifiedCuspRoot side : O) (upperPoint z v hv)‖ ≤
        C * Real.exp (-(residualBesselDecayRate / 3) * v) := by
  obtain ⟨C, hC, hb⟩ := cubicBesselSeries_exponential_decay _ (ramifiedBesselCoefficient_subexponential side)
    (a / 3) (by positivity)
  refine ⟨C, hC, ?_⟩
  intro v hv hav z
  rw [ramifiedSource_bessel side v hv z]
  convert hb (v / 3) (by linarith only [hav]) (z / 3) using 1 <;> ring

lemma cubicBesselAmplitude_firstMoment_summable (c : O → ℂ)
    (hsub : ∀ ε : ℝ, 0 < ε → ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖c h‖ ≤ C * Real.exp (ε * ‖cuspFrequency h‖)) (v : ℝ) (hv : 0 < v) :
    Summable (fun h => ‖cuspFrequency h‖ * ‖cubicBesselAmplitude c v h‖) := by
  obtain ⟨C, hC, hb⟩ := cubicBesselTerm_strip_bound c hsub v v hv le_rfl
  apply Summable.of_nonneg_of_le (fun _ => mul_nonneg (norm_nonneg _) (norm_nonneg _))
    (fun h => ?_) ((cuspFrequency_firstMoment_exp_summable (Real.pi * v) (by positivity)).mul_left C)
  have he := mul_le_mul_of_nonneg_left (hb h (v, 0) ⟨le_rfl, le_rfl⟩) (norm_nonneg (cuspFrequency h))
  simpa only [cubicBesselTerm, norm_mul, tracePhase_norm, mul_one, mul_left_comm] using he

lemma ninthCuspFrequency_eq_third (h : O) : ninthCuspFrequency h = cuspFrequency h / 3 := by
  unfold ninthCuspFrequency cuspFrequency
  ring

theorem ramifiedSource_wirtingerBar (side : Bool) (v : ℝ) (hv : 0 < v) (z : ℂ) :
    horizontalWirtingerBar (fun w => ramifiedSourceFunction (ramifiedCuspRoot side : O)
      (upperPoint w v hv)) z =
      ∑' h : O, (2 * Real.pi * Complex.I * star (ninthCuspFrequency h)) *
        cubicBesselTerm (ramifiedBesselCoefficient side) h (v / 3, z / 3) := by
  have hp : 0 < v / 3 := by positivity
  have hs := cubicBesselAmplitude_summable _ (ramifiedBesselCoefficient_subexponential side) (v / 3) hp
  have hfirst := cubicBesselAmplitude_firstMoment_summable _
    (ramifiedBesselCoefficient_subexponential side) (v / 3) hp
  have hn : Summable (fun h => ‖ninthCuspFrequency h‖ *
      ‖cubicBesselAmplitude (ramifiedBesselCoefficient side) (v / 3) h‖) := by
    simpa only [ninthCuspFrequency_eq_third, norm_div,
      show ‖(3 : ℂ)‖ = (3 : ℝ) by norm_num, div_mul_eq_mul_div] using hfirst.div_const 3
  have hphase (h : O) (w : ℂ) : cuspFrequency h * (w / 3) = ninthCuspFrequency h * w := by
    rw [ninthCuspFrequency_eq_third]
    ring
  have he : (fun w => ramifiedSourceFunction (ramifiedCuspRoot side : O) (upperPoint w v hv)) =
      fun w => ∑' h : O, cubicBesselAmplitude (ramifiedBesselCoefficient side) (v / 3) h *
        tracePhase (ninthCuspFrequency h * w) := by
    funext w
    rw [ramifiedSource_bessel side v hv w]
    simp only [cubicBesselTerm, hphase]
  rw [he, traceFourierSeries_wirtingerBar _ _ hs hn]
  simp only [cubicBesselTerm, hphase]

/-- Multiplying subexponential Fourier coefficients by a linear frequency weight preserves growth. -/
lemma cubicBesselCoefficient_linearWeight_subexponential (c m : O → ℂ)
    (hsub : ∀ ε : ℝ, 0 < ε → ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖c h‖ ≤ C * Real.exp (ε * ‖cuspFrequency h‖))
    (L : ℝ) (hL : 0 ≤ L) (hm : ∀ h : O, h ≠ 0 → ‖m h‖ ≤ L * ‖cuspFrequency h‖)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖m h * c h‖ ≤ C * Real.exp (ε * ‖cuspFrequency h‖) := by
  obtain ⟨C, hC, hc⟩ := hsub (ε / 2) (by positivity)
  refine ⟨L * C * (2 / ε), by positivity, ?_⟩
  intro h hh
  have hr : ‖cuspFrequency h‖ ≤ (2 / ε) * Real.exp ((ε / 2) * ‖cuspFrequency h‖) := by
    rw [div_mul_eq_mul_div]
    apply (le_div_iff₀ hε).mpr
    nlinarith only [Real.add_one_le_exp ((ε / 2) * ‖cuspFrequency h‖)]
  rw [norm_mul]
  calc
    _ ≤ (L * ‖cuspFrequency h‖) * (C * Real.exp ((ε / 2) * ‖cuspFrequency h‖)) :=
      mul_le_mul (hm h hh) (hc h hh) (norm_nonneg _) (mul_nonneg hL (norm_nonneg _))
    _ ≤ (L * ((2 / ε) * Real.exp ((ε / 2) * ‖cuspFrequency h‖))) *
        (C * Real.exp ((ε / 2) * ‖cuspFrequency h‖)) :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hr hL) (by positivity)
    _ = _ := by
      rw [show ε * ‖cuspFrequency h‖ = (ε / 2) * ‖cuspFrequency h‖ +
        (ε / 2) * ‖cuspFrequency h‖ by ring, Real.exp_add]
      ring

lemma cubicBesselTerm_weight (c m : O → ℂ) (h : O) (p : ℝ × ℂ) :
    cubicBesselTerm (fun k => m k * c k) h p = m h * cubicBesselTerm c h p := by
  by_cases hh : h = 0 <;> simp only [cubicBesselTerm, cubicBesselAmplitude, hh,
    if_true, if_false, zero_mul, mul_zero, mul_assoc]

def ramifiedBarBesselCoefficient (side : Bool) (h : O) : ℂ :=
  (2 * Real.pi * Complex.I * star (ninthCuspFrequency h)) * ramifiedBesselCoefficient side h

lemma ramifiedBarBesselCoefficient_subexponential (side : Bool) (ε : ℝ) (hε : 0 < ε) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖ramifiedBarBesselCoefficient side h‖ ≤ C * Real.exp (ε * ‖cuspFrequency h‖) := by
  apply cubicBesselCoefficient_linearWeight_subexponential _ _
    (ramifiedBesselCoefficient_subexponential side) (2 * Real.pi / 3) (by positivity) _ ε hε
  intro h hh
  simp only [norm_mul, norm_star, Complex.norm_I, mul_one, ninthCuspFrequency_eq_third,
    norm_div, show ‖(3 : ℂ)‖ = (3 : ℝ) by norm_num,
    show ‖(2 : ℂ)‖ = (2 : ℝ) by norm_num,
    Complex.norm_real, Real.norm_eq_abs, abs_of_pos Real.pi_pos]
  exact le_of_eq (by ring)

theorem ramifiedSource_wirtingerBar_bessel (side : Bool) (v : ℝ) (hv : 0 < v) (z : ℂ) :
    horizontalWirtingerBar (fun w => ramifiedSourceFunction (ramifiedCuspRoot side : O)
      (upperPoint w v hv)) z =
      ∑' h : O, cubicBesselTerm (ramifiedBarBesselCoefficient side) h (v / 3, z / 3) := by
  rw [ramifiedSource_wirtingerBar side v hv z]
  exact tsum_congr (fun h => (cubicBesselTerm_weight (ramifiedBesselCoefficient side)
    (fun k => 2 * Real.pi * Complex.I * star (ninthCuspFrequency k)) h (v / 3, z / 3)).symm)

/-- The differentiated ramified cusp row has the same exponential height rate. -/
theorem ramifiedSource_wirtingerBar_exponential_decay (side : Bool) (a : ℝ) (ha : 0 < a) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ v : ℝ, ∀ hv : 0 < v, a ≤ v → ∀ z : ℂ,
      ‖horizontalWirtingerBar (fun w => ramifiedSourceFunction (ramifiedCuspRoot side : O)
        (upperPoint w v hv)) z‖ ≤ C * Real.exp (-(residualBesselDecayRate / 3) * v) := by
  obtain ⟨C, hC, hb⟩ := cubicBesselSeries_exponential_decay _
    (ramifiedBarBesselCoefficient_subexponential side) (a / 3) (by positivity)
  refine ⟨C, hC, ?_⟩
  intro v hv hav z
  rw [ramifiedSource_wirtingerBar_bessel side v hv z]
  convert hb (v / 3) (by linarith only [hav]) (z / 3) using 1 <;> ring

def cuspBarProfile (f : HyperbolicSpace → ℂ) (z : ℂ) (v : ℝ) : ℂ :=
  horizontalWirtingerBar (fun w => f (cuspCoordinateLift (v, w))) z

def cuspZProfile (f : HyperbolicSpace → ℂ) (z : ℂ) (v : ℝ) : ℂ :=
  horizontalWirtingerZ (fun w => f (cuspCoordinateLift (v, w))) z

lemma cuspBarProfile_positive (f : HyperbolicSpace → ℂ) (z : ℂ) (v : ℝ) (hv : 0 < v) :
    cuspBarProfile f z v = horizontalWirtingerBar (fun w => f (upperPoint w v hv)) z := by
  simp only [cuspBarProfile, cuspCoordinateLift_positive v _ hv]

lemma cuspZProfile_positive (f : HyperbolicSpace → ℂ) (z : ℂ) (v : ℝ) (hv : 0 < v) :
    cuspZProfile f z v = horizontalWirtingerZ (fun w => f (upperPoint w v hv)) z := by
  simp only [cuspZProfile, cuspCoordinateLift_positive v _ hv]

theorem ramifiedSource_barProfile_continuousOn (side : Bool) (z : ℂ) :
    ContinuousOn (cuspBarProfile (ramifiedSourceFunction (ramifiedCuspRoot side : O)) z) (Set.Ioi 0) := by
  intro v hv
  change 0 < v at hv
  have hs := (cubicBesselSeries_hasFDerivAt _ (ramifiedBarBesselCoefficient_subexponential side)
    (v / 3, z / 3) (by positivity)).differentiableAt
  have hp : DifferentiableAt ℝ (fun y : ℝ => (y / 3, z / 3)) v := by fun_prop
  apply ContinuousAt.continuousWithinAt
  apply (hs.comp v hp).continuousAt.congr_of_eventuallyEq
  filter_upwards [Ioi_mem_nhds hv] with y hy
  rw [cuspBarProfile_positive _ _ _ hy, ramifiedSource_wirtingerBar_bessel side y hy z]
  rfl

def reflectedCuspProfile (A : ℂ) (Q : ℝ) (f : ℝ → ℂ) (v : ℝ) : ℂ :=
  A * ((v : ℂ) ^ (-2 : ℂ) * f ((Q * v)⁻¹))

/-- Inverting a finite cusp reflects its horizontal derivative profile with weight two. -/
theorem cubicSource_barProfile_reflection (g : SL(2, ℂ)) (hc : g 1 0 ≠ 0) (v : ℝ) (hv : 0 < v) :
    cuspBarProfile cubicSourceResidualFunction (g 0 0 / g 1 0) v =
      reflectedCuspProfile (-1 / (g 1 0) ^ 2) (‖g 1 0‖ ^ 2)
        (cuspZProfile (fun w => cubicSourceResidualFunction (g • w)) (-g 1 1 / g 1 0)) v := by
  have hd : 0 < (‖g 1 0‖ ^ 2 * v)⁻¹ := by positivity
  rw [cuspBarProfile_positive _ _ _ hv, reflectedCuspProfile, cuspZProfile_positive _ _ _ hd,
    cubicSourceResidualFunction_cusp_derivative g hc v hv]
  have hp : (v : ℂ) ^ (-2 : ℂ) = ((v : ℂ) ^ 2)⁻¹ := by
    rw [Complex.cpow_neg, Complex.cpow_ofNat]
  rw [hp]
  simp only [one_div]
  ring

theorem conjugateSource_barProfile_reflection (g : SL(2, ℂ)) (hc : g 1 0 ≠ 0) (v : ℝ) (hv : 0 < v) :
    cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) (g 0 0 / g 1 0) v =
      reflectedCuspProfile (-1 / (g 1 0) ^ 2) (‖g 1 0‖ ^ 2)
        (cuspZProfile (fun w => star (cubicSourceResidualFunction (g • w))) (-g 1 1 / g 1 0)) v := by
  have hd : 0 < (‖g 1 0‖ ^ 2 * v)⁻¹ := by positivity
  rw [cuspBarProfile_positive _ _ _ hv, reflectedCuspProfile, cuspZProfile_positive _ _ _ hd,
    conjugate_cubicSourceResidualFunction_cusp_derivative g hc v hv]
  have hp : (v : ℂ) ^ (-2 : ℂ) = ((v : ℂ) ^ 2)⁻¹ := by
    rw [Complex.cpow_neg, Complex.cpow_ofNat]
  rw [hp]
  simp only [one_div]
  ring

/-- Complex conjugation exchanges the two real-coordinate Wirtinger derivatives. -/
lemma horizontalWirtingerZ_conjugate (f : ℂ → ℂ) (z : ℂ) (hf : DifferentiableAt ℝ f z) :
    horizontalWirtingerZ (fun w => star (f w)) z = star (horizontalWirtingerBar f z) := by
  have hline (direction : ℂ) : DifferentiableAt ℝ
      (fun t : ℝ => f (z + (t : ℂ) * direction)) 0 := by
    have hp : DifferentiableAt ℝ (fun t : ℝ => z + (t : ℂ) * direction) 0 := by fun_prop
    have hf' : DifferentiableAt ℝ f (z + (0 : ℂ) * direction) := by simpa only [zero_mul, add_zero] using hf
    exact hf'.comp 0 hp
  have hstar (direction : ℂ) :
      deriv (fun t : ℝ => star (f (z + (t : ℂ) * direction))) 0 =
        star (deriv (fun t : ℝ => f (z + (t : ℂ) * direction)) 0) :=
    (Complex.conjCLE.hasFDerivAt.comp_hasDerivAt 0 (hline direction).hasDerivAt).deriv
  have h1 := hstar 1
  simp only [mul_one] at h1
  rw [horizontalWirtingerZ, horizontalWirtingerBar, h1, hstar Complex.I]
  have hhalf : star (1 / 2 : ℂ) = (1 / 2 : ℂ) := by norm_num
  have hI : star Complex.I = -Complex.I := Complex.conj_I
  rw [star_mul, star_add, star_mul, hhalf, hI]
  ring

lemma ramifiedSource_horizontal_differentiableAt (t : O) (v : ℝ) (hv : 0 < v) (z : ℂ) :
    DifferentiableAt ℝ (fun w => ramifiedSourceFunction t (upperPoint w v hv)) z := by
  have hf := cubicSourceResidualFunction_translate_coordinate_differentiableAt
    (integralComplexMatrix (lowerCuspMatrix t)) (v, z) hv
  have hp : DifferentiableAt ℝ (fun w : ℂ => (v, w)) z := by fun_prop
  simpa only [Function.comp_def, ramifiedSourceFunction, cuspCoordinateLift_positive v _ hv] using hf.comp z hp

lemma conjugateRamifiedSource_zProfile (side : Bool) (z : ℂ) (v : ℝ) (hv : 0 < v) :
    cuspZProfile (fun w => star (ramifiedSourceFunction (ramifiedCuspRoot side : O) w)) z v =
      star (cuspBarProfile (ramifiedSourceFunction (ramifiedCuspRoot side : O)) z v) := by
  rw [cuspZProfile_positive _ _ _ hv, cuspBarProfile_positive _ _ _ hv]
  exact horizontalWirtingerZ_conjugate _ z (ramifiedSource_horizontal_differentiableAt _ v hv z)

theorem conjugateRamifiedSource_zProfile_continuousOn (side : Bool) (z : ℂ) :
    ContinuousOn (cuspZProfile (fun w => star (ramifiedSourceFunction (ramifiedCuspRoot side : O) w)) z)
      (Set.Ioi 0) := by
  apply (ramifiedSource_barProfile_continuousOn side z).star.congr
  intro v hv
  exact conjugateRamifiedSource_zProfile side z v hv

theorem conjugateRamifiedSource_zProfile_exponential_decay (side : Bool) (a : ℝ) (ha : 0 < a) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ v : ℝ, a ≤ v → ∀ z : ℂ,
      ‖cuspZProfile (fun w => star (ramifiedSourceFunction (ramifiedCuspRoot side : O) w)) z v‖ ≤
        C * Real.exp (-(residualBesselDecayRate / 3) * v) := by
  obtain ⟨C, hC, hb⟩ := ramifiedSource_wirtingerBar_exponential_decay side a ha
  refine ⟨C, hC, ?_⟩
  intro v hv z
  rw [conjugateRamifiedSource_zProfile side z v (ha.trans_le hv), norm_star,
    cuspBarProfile_positive _ _ _ (ha.trans_le hv)]
  exact hb v (ha.trans_le hv) hv z

open Asymptotics

lemma reflectedCuspProfile_mellin (f : ℝ → ℂ) (A s : ℂ) (Q : ℝ) (hQ : 0 < Q) :
    mellin (reflectedCuspProfile A Q f) s = A * (Q : ℂ) ^ (2 - s) * mellin f (2 - s) := by
  change mellin (fun v => A • ((v : ℂ) ^ (-2 : ℂ) • f ((Q * v)⁻¹))) s = _
  rw [mellin_const_smul, mellin_cpow_smul,
    mellin_comp_mul_left (fun v => f v⁻¹) _ hQ, mellin_comp_inv]
  simp only [smul_eq_mul, show -(s + (-2 : ℂ)) = 2 - s by ring]
  ring

lemma reflectedCuspProfile_mellinConvergent (f : ℝ → ℂ) (A s : ℂ) (Q : ℝ)
    (hQ : 0 < Q) (hf : MellinConvergent f (2 - s)) :
    MellinConvergent (reflectedCuspProfile A Q f) s := by
  have hinv : MellinConvergent (fun v : ℝ => f v⁻¹) (s - 2) := by
    have he := (MellinConvergent.comp_rpow (f := f) (s := s - 2) (a := -1) (by norm_num)).mpr
      (show MellinConvergent f ((s - 2) / (-1 : ℝ)) by
        simpa only [show ((s - 2) / (-1 : ℝ) : ℂ) = 2 - s by push_cast; ring] using hf)
    simpa only [Real.rpow_neg_one] using he
  have hscale := (MellinConvergent.comp_mul_left (f := fun v : ℝ => f v⁻¹) (s := s - 2) hQ).mpr hinv
  have hpow := (MellinConvergent.cpow_smul (f := fun v : ℝ => f (Q * v)⁻¹) (s := s) (a := -2)).mpr
    (by simpa only [sub_eq_add_neg] using hscale)
  unfold reflectedCuspProfile
  convert! hpow.const_smul A using 1

def truncatedCuspProfile (a : ℝ) (f : ℝ → ℂ) (v : ℝ) : ℂ := if a < v then f v else 0

lemma truncatedCuspProfile_eventually_top (a : ℝ) (f : ℝ → ℂ) :
    truncatedCuspProfile a f =ᶠ[atTop] f := by
  filter_upwards [eventually_gt_atTop a] with v hv
  exact if_pos hv

lemma truncatedCuspProfile_eventually_zero (a : ℝ) (ha : 0 < a) (f : ℝ → ℂ) :
    truncatedCuspProfile a f =ᶠ[𝓝[>] 0] 0 := by
  filter_upwards [(eventually_lt_nhds ha).filter_mono nhdsWithin_le_nhds] with v hv
  exact if_neg (not_lt_of_ge hv.le)

lemma truncatedCuspProfile_locallyIntegrable (a : ℝ) (ha : 0 < a) (f : ℝ → ℂ)
    (hf : ContinuousOn f (Set.Ioi 0)) : LocallyIntegrable (truncatedCuspProfile a f) volume := by
  have hc : Continuous (fun v : ℝ => f (max a v)) := hf.comp_continuous
    (continuous_const.max continuous_id) (fun v => ha.trans_le (le_max_left a v))
  have he : truncatedCuspProfile a f = (Set.Ioi a).indicator (fun v : ℝ => f (max a v)) := by
    funext v
    by_cases hv : a < v
    · simp [truncatedCuspProfile, Set.indicator, hv, max_eq_right hv.le]
    · simp [truncatedCuspProfile, Set.indicator, hv]
  rw [he]
  exact hc.locallyIntegrable.indicator measurableSet_Ioi

lemma truncatedCuspProfile_mellin_entire (a decay : ℝ) (ha : 0 < a) (hd : 0 < decay)
    (f : ℝ → ℂ) (hf : ContinuousOn f (Set.Ioi 0))
    (hbound : f =O[atTop] (fun v : ℝ => Real.exp (-decay * v))) :
    (∀ s : ℂ, MellinConvergent (truncatedCuspProfile a f) s) ∧
      Differentiable ℂ (mellin (truncatedCuspProfile a f)) := by
  have hlocal := (truncatedCuspProfile_locallyIntegrable a ha f hf).locallyIntegrableOn (Set.Ioi 0)
  have htop : truncatedCuspProfile a f =O[atTop] (fun v : ℝ => Real.exp (-decay * v)) :=
    hbound.congr' (truncatedCuspProfile_eventually_top a f).symm EventuallyEq.rfl
  have hzero (b : ℝ) : truncatedCuspProfile a f =O[𝓝[>] 0] (fun v : ℝ => v ^ (-b)) :=
    (Asymptotics.isBigO_zero (fun v : ℝ => v ^ (-b)) (𝓝[>] 0)).congr'
      (truncatedCuspProfile_eventually_zero a ha f).symm EventuallyEq.rfl
  exact ⟨fun s => mellinConvergent_of_isBigO_rpow_exp hd hlocal htop (hzero (s.re - 1)) (by linarith),
    fun s => mellin_differentiableAt_of_isBigO_rpow_exp hd hlocal htop (hzero (s.re - 1)) (by linarith)⟩

/-- A cusp and its reflected cusp split into two exponentially decaying tails. -/
lemma cusp_truncation_reflection_ae (f g : ℝ → ℂ) (A : ℂ) (Q : ℝ) (hQ : 0 < Q)
    (hfg : ∀ v : ℝ, 0 < v → f v = reflectedCuspProfile A Q g v) :
    f =ᵐ[volume.restrict (Set.Ioi 0)] (fun v => truncatedCuspProfile 1 f v +
      reflectedCuspProfile A Q (truncatedCuspProfile (1 / Q) g) v) := by
  have hn : ∀ᵐ v : ℝ ∂volume.restrict (Set.Ioi 0), v ≠ 1 := ae_restrict_of_ae (Measure.ae_ne volume 1)
  filter_upwards [ae_restrict_mem measurableSet_Ioi, hn] with v hv hv1
  have hrel : 1 / Q < (Q * v)⁻¹ ↔ v < 1 := by
    rw [inv_eq_one_div, div_lt_div_iff₀ hQ (mul_pos hQ hv)]
    simp only [one_mul]
    constructor
    · intro he
      by_contra hn
      have hm := mul_le_mul_of_nonneg_left (le_of_not_gt hn) hQ.le
      linarith only [he, hm]
    · intro he
      simpa only [mul_one] using mul_lt_mul_of_pos_left he hQ
  by_cases hhi : 1 < v
  · have hlo : ¬ 1 / Q < (Q * v)⁻¹ := fun hh => not_lt_of_ge hhi.le (hrel.mp hh)
    simp only [truncatedCuspProfile, if_pos hhi, reflectedCuspProfile, if_neg hlo, mul_zero, add_zero]
  · have hlo : 1 / Q < (Q * v)⁻¹ := hrel.mpr (lt_of_le_of_ne (le_of_not_gt hhi) hv1)
    simp only [truncatedCuspProfile, if_neg hhi, reflectedCuspProfile, if_pos hlo, zero_add]
    exact hfg v hv

/-- Exponential decay at both reflected cusps gives an entire Mellin transform. -/
theorem cusp_mellin_entire (f g : ℝ → ℂ) (A : ℂ) (Q decayF decayG : ℝ)
    (hQ : 0 < Q) (hF : 0 < decayF) (hG : 0 < decayG)
    (hf : ContinuousOn f (Set.Ioi 0)) (hg : ContinuousOn g (Set.Ioi 0))
    (hfbound : f =O[atTop] (fun v : ℝ => Real.exp (-decayF * v)))
    (hgbound : g =O[atTop] (fun v : ℝ => Real.exp (-decayG * v)))
    (hfg : ∀ v : ℝ, 0 < v → f v = reflectedCuspProfile A Q g v) :
    (∀ s : ℂ, MellinConvergent f s) ∧ Differentiable ℂ (mellin f) := by
  obtain ⟨hfc, hfd⟩ := truncatedCuspProfile_mellin_entire 1 decayF (by norm_num) hF f hf hfbound
  obtain ⟨hgc, hgd⟩ := truncatedCuspProfile_mellin_entire (1 / Q) decayG (by positivity) hG g hg hgbound
  have hae := cusp_truncation_reflection_ae f g A Q hQ hfg
  have hm (s : ℂ) : HasMellin f s
      (mellin (truncatedCuspProfile 1 f) s +
        A * (Q : ℂ) ^ (2 - s) * mellin (truncatedCuspProfile (1 / Q) g) (2 - s)) := by
    have hr := reflectedCuspProfile_mellinConvergent (truncatedCuspProfile (1 / Q) g) A s Q hQ (hgc (2 - s))
    have hsum := hasMellin_add (hfc s) hr
    constructor
    · apply hsum.1.congr
      filter_upwards [hae] with v hv
      exact congrArg (fun z : ℂ => (v : ℂ) ^ (s - 1) • z) hv.symm
    · have he : mellin f s = mellin (fun v => truncatedCuspProfile 1 f v +
          reflectedCuspProfile A Q (truncatedCuspProfile (1 / Q) g) v) s := by
        unfold mellin
        apply integral_congr_ae
        filter_upwards [hae] with v hv
        rw [hv]
      rw [he, hsum.2, reflectedCuspProfile_mellin _ _ _ _ hQ]
  refine ⟨fun s => (hm s).1, ?_⟩
  have he : mellin f = fun s : ℂ => mellin (truncatedCuspProfile 1 f) s +
      A * (Q : ℂ) ^ (2 - s) * mellin (truncatedCuspProfile (1 / Q) g) (2 - s) :=
    funext (fun s => (hm s).2)
  rw [he]
  letI : NeZero (Q : ℂ) := ⟨Complex.ofReal_ne_zero.mpr hQ.ne'⟩
  have hp := (differentiable_const_cpow_of_neZero (Q : ℂ)).comp
    ((differentiable_const (2 : ℂ)).sub differentiable_id)
  exact hfd.add (((differentiable_const A).mul hp).mul
    (hgd.comp ((differentiable_const (2 : ℂ)).sub differentiable_id)))

lemma horizontalPhaseMultiplier_wirtingerZ (freq : ℂ) :
    (1 / 2 : ℂ) * (horizontalPhaseMultiplier freq 1 -
      Complex.I * horizontalPhaseMultiplier freq Complex.I) = 2 * Real.pi * Complex.I * freq := by
  simp only [horizontalPhaseMultiplier, mul_one, star_mul, Complex.star_def, Complex.conj_I]
  ring_nf
  norm_num [Complex.I_sq, Complex.I_pow_three]
  ring

theorem traceFourierSeries_wirtingerZ {ι : Type*} (freq a : ι → ℂ)
    (ha : Summable (fun i => ‖a i‖)) (hfa : Summable (fun i => ‖freq i‖ * ‖a i‖)) (z : ℂ) :
    horizontalWirtingerZ (fun w => ∑' i, a i * tracePhase (freq i * w)) z =
      ∑' i, (2 * Real.pi * Complex.I * freq i) * (a i * tracePhase (freq i * z)) := by
  have h1 := (traceFourierSeries_hasDerivAt freq a ha hfa z 1 0).deriv
  have hI := (traceFourierSeries_hasDerivAt freq a ha hfa z Complex.I 0).deriv
  simp only [mul_one, Complex.ofReal_zero, zero_mul, add_zero] at h1 hI
  rw [horizontalWirtingerZ, h1, hI]
  have hs1 := traceFourierSeries_directional_summable freq a hfa z 1
  have hsI := (traceFourierSeries_directional_summable freq a hfa z Complex.I).mul_left Complex.I
  rw [← tsum_mul_left, ← hs1.tsum_sub hsI, ← tsum_mul_left]
  apply tsum_congr
  intro i
  linear_combination (a i * tracePhase (freq i * z)) * horizontalPhaseMultiplier_wirtingerZ (freq i)

lemma horizontalWirtingerBar_conjugate (f : ℂ → ℂ) (z : ℂ) (hf : DifferentiableAt ℝ f z) :
    horizontalWirtingerBar (fun w => star (f w)) z = star (horizontalWirtingerZ f z) := by
  have he := congrArg star (horizontalWirtingerZ_conjugate (fun w => star (f w)) z
    (Complex.conjCLE.differentiableAt.comp z hf))
  simpa only [star_star] using he.symm

def sourceZBesselCoefficient (h : O) : ℂ :=
  (2 * Real.pi * Complex.I * cuspFrequency h) * rationalSourceResidualFourierCoefficient h

lemma sourceZBesselCoefficient_subexponential (ε : ℝ) (hε : 0 < ε) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖sourceZBesselCoefficient h‖ ≤ C * Real.exp (ε * ‖cuspFrequency h‖) := by
  apply cubicBesselCoefficient_linearWeight_subexponential _ _
    rationalSourceResidualFourierCoefficient_subexponential (2 * Real.pi) (by positivity) _ ε hε
  intro h hh
  exact le_of_eq (by norm_num [norm_mul, abs_of_pos Real.pi_pos])

theorem cubicSource_wirtingerZ_bessel (v : ℝ) (hv : 0 < v) (z : ℂ) :
    horizontalWirtingerZ (fun w => cubicSourceResidualFunction (upperPoint w v hv)) z =
      ∑' h : O, cubicBesselTerm sourceZBesselCoefficient h (v, z) := by
  have he : (fun w => cubicSourceResidualFunction (upperPoint w v hv)) =
      fun w => ∑' h : O, rationalSourceModeAmplitude v h * tracePhase (cuspFrequency h * w) :=
    funext (cubicSourceResidualFunction_fourier_expansion v hv)
  rw [he, traceFourierSeries_wirtingerZ _ _ (rationalSourceModeAmplitude_summable v hv)
    (rationalSourceModeAmplitude_frequency_summable v hv)]
  apply tsum_congr
  intro h
  by_cases hh : h = 0
  · subst h
    simp only [cuspFrequency, map_zero, zero_div, mul_zero, zero_mul,
      cubicBesselTerm, cubicBesselAmplitude, if_true]
  · rw [rationalSourceModeAmplitude_bessel v hv h hh]
    simp only [cubicBesselTerm, cubicBesselAmplitude, if_neg hh, sourceZBesselCoefficient, mul_assoc]

lemma cubicSource_horizontal_differentiableAt (v : ℝ) (hv : 0 < v) (z : ℂ) :
    DifferentiableAt ℝ (fun w => cubicSourceResidualFunction (upperPoint w v hv)) z := by
  have hf := cubicSourceResidualFunction_coordinate_differentiableAt (v, z) hv
  have hp : DifferentiableAt ℝ (fun w : ℂ => (v, w)) z := by fun_prop
  simpa only [Function.comp_def, cuspCoordinateLift_positive v _ hv] using hf.comp z hp

theorem cubicSource_zProfile_continuousOn (z : ℂ) :
    ContinuousOn (cuspZProfile cubicSourceResidualFunction z) (Set.Ioi 0) := by
  intro v hv
  change 0 < v at hv
  have hs := (cubicBesselSeries_hasFDerivAt sourceZBesselCoefficient
    sourceZBesselCoefficient_subexponential (v, z) hv).differentiableAt
  have hp : DifferentiableAt ℝ (fun y : ℝ => (y, z)) v := by fun_prop
  apply ContinuousAt.continuousWithinAt
  apply (hs.comp v hp).continuousAt.congr_of_eventuallyEq
  filter_upwards [Ioi_mem_nhds hv] with y hy
  rw [cuspZProfile_positive _ _ _ hy, cubicSource_wirtingerZ_bessel y hy z]
  rfl

theorem cubicSource_zProfile_exponential_decay (a : ℝ) (ha : 0 < a) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ v : ℝ, a ≤ v → ∀ z : ℂ,
      ‖cuspZProfile cubicSourceResidualFunction z v‖ ≤ C * Real.exp (-residualBesselDecayRate * v) := by
  obtain ⟨C, hC, hb⟩ := cubicBesselSeries_exponential_decay sourceZBesselCoefficient
    sourceZBesselCoefficient_subexponential a ha
  refine ⟨C, hC, ?_⟩
  intro v hv z
  rw [cuspZProfile_positive _ _ _ (ha.trans_le hv), cubicSource_wirtingerZ_bessel v (ha.trans_le hv) z]
  exact hb v hv z

lemma conjugateSource_barProfile (z : ℂ) (v : ℝ) (hv : 0 < v) :
    cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) z v =
      star (cuspZProfile cubicSourceResidualFunction z v) := by
  rw [cuspBarProfile_positive _ _ _ hv, cuspZProfile_positive _ _ _ hv]
  exact horizontalWirtingerBar_conjugate _ z (cubicSource_horizontal_differentiableAt v hv z)

theorem conjugateSource_barProfile_continuousOn (z : ℂ) :
    ContinuousOn (cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) z) (Set.Ioi 0) := by
  apply (cubicSource_zProfile_continuousOn z).star.congr
  intro v hv
  exact conjugateSource_barProfile z v hv

theorem conjugateSource_barProfile_exponential_decay (a : ℝ) (ha : 0 < a) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ v : ℝ, a ≤ v → ∀ z : ℂ,
      ‖cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) z v‖ ≤
        C * Real.exp (-residualBesselDecayRate * v) := by
  obtain ⟨C, hC, hb⟩ := cubicSource_zProfile_exponential_decay a ha
  refine ⟨C, hC, ?_⟩
  intro v hv z
  rw [conjugateSource_barProfile z v (ha.trans_le hv), norm_star]
  exact hb v hv z

theorem conjugateSource_barProfile_isBigO (z : ℂ) :
    cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) z =O[atTop]
      (fun v : ℝ => Real.exp (-residualBesselDecayRate * v)) := by
  obtain ⟨C, hC, hb⟩ := conjugateSource_barProfile_exponential_decay 1 (by norm_num)
  apply Asymptotics.IsBigO.of_bound C
  filter_upwards [eventually_ge_atTop (1 : ℝ)] with v hv
  simpa only [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)] using hb v hv z

theorem conjugateRamifiedSource_zProfile_isBigO (side : Bool) (z : ℂ) :
    cuspZProfile (fun w => star (ramifiedSourceFunction (ramifiedCuspRoot side : O) w)) z =O[atTop]
      (fun v : ℝ => Real.exp (-(residualBesselDecayRate / 3) * v)) := by
  obtain ⟨C, hC, hb⟩ := conjugateRamifiedSource_zProfile_exponential_decay side 1 (by norm_num)
  apply Asymptotics.IsBigO.of_bound C
  filter_upwards [eventually_ge_atTop (1 : ℝ)] with v hv
  simpa only [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)] using hb v hv z

/-- The two primitive ramified cusp derivative profiles have entire Mellin transforms. -/
theorem conjugateSource_primitive_cusp_mellin_entire (side : Bool) :
    (∀ s : ℂ, MellinConvergent (cuspBarProfile (fun w => star (cubicSourceResidualFunction w))
      (ringComplex (ramifiedCuspRoot side : O))⁻¹) s) ∧
    Differentiable ℂ (mellin (cuspBarProfile (fun w => star (cubicSourceResidualFunction w))
      (ringComplex (ramifiedCuspRoot side : O))⁻¹)) := by
  let g := integralComplexMatrix (lowerCuspMatrix (ramifiedCuspRoot side : O))
  have hg0 : g 0 0 = 1 := by change ringComplex 1 = 1; exact map_one _
  have hgc : g 1 0 = ringComplex (ramifiedCuspRoot side : O) := rfl
  have hc : g 1 0 ≠ 0 := by rw [hgc]; exact ringComplex_ne_zero (Units.ne_zero _)
  have he := cusp_mellin_entire
    (cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) (g 0 0 / g 1 0))
    (cuspZProfile (fun w => star (ramifiedSourceFunction (ramifiedCuspRoot side : O) w)) (-g 1 1 / g 1 0))
    (-1 / (g 1 0) ^ 2) (‖g 1 0‖ ^ 2) residualBesselDecayRate (residualBesselDecayRate / 3)
    (sq_pos_of_pos (norm_pos_iff.mpr hc)) residualBesselDecayRate_pos
    (div_pos residualBesselDecayRate_pos (by norm_num))
    (conjugateSource_barProfile_continuousOn _) (conjugateRamifiedSource_zProfile_continuousOn side _)
    (conjugateSource_barProfile_isBigO _) (conjugateRamifiedSource_zProfile_isBigO side _)
    (fun v hv => conjugateSource_barProfile_reflection g hc v hv)
  simpa only [hg0, hgc, one_div] using he

/-- Coordinates modulo three retain the nilpotent direction of the ramified residue ring. -/
def cuspResidue (x : O) : ZMod 3 × ZMod 3 :=
  ((Coordinates.coords x).1, (Coordinates.coords x).2)

def cuspResidueMul (x y : ZMod 3 × ZMod 3) : ZMod 3 × ZMod 3 :=
  (x.1 * y.1 - x.2 * y.2, x.1 * y.2 + x.2 * y.1 - x.2 * y.2)

lemma cuspResidue_eval (a b : ℤ) : cuspResidue (Coordinates.eval a b) = ((a : ZMod 3), (b : ZMod 3)) := by
  simp only [cuspResidue, Coordinates.coords_eval]

lemma cuspResidue_intCast (a : ℤ) : cuspResidue (a : O) = ((a : ZMod 3), 0) := by
  simpa only [Coordinates.eval, Int.cast_zero, zero_mul, add_zero] using cuspResidue_eval a 0

lemma cuspResidue_zero : cuspResidue (0 : O) = (0, 0) := by simpa only [Int.cast_zero] using cuspResidue_intCast 0
lemma cuspResidue_one : cuspResidue (1 : O) = (1, 0) := by simpa only [Int.cast_one] using cuspResidue_intCast 1

lemma cuspResidue_add (x y : O) : cuspResidue (x + y) =
    ((cuspResidue x).1 + (cuspResidue y).1, (cuspResidue x).2 + (cuspResidue y).2) := by
  have he : x + y = Coordinates.eval ((Coordinates.coords x).1 + (Coordinates.coords y).1)
      ((Coordinates.coords x).2 + (Coordinates.coords y).2) := by
    nth_rw 1 [← Coordinates.eval_coords x, ← Coordinates.eval_coords y]
    simp only [Coordinates.eval, Int.cast_add]
    ring
  rw [he, cuspResidue_eval]
  simp only [cuspResidue, Int.cast_add]

lemma cuspResidue_neg (x : O) : cuspResidue (-x) = (-(cuspResidue x).1, -(cuspResidue x).2) := by
  have he : -x = Coordinates.eval (-(Coordinates.coords x).1) (-(Coordinates.coords x).2) := by
    nth_rw 1 [← Coordinates.eval_coords x]
    simp only [Coordinates.eval, Int.cast_neg]
    ring
  rw [he, cuspResidue_eval]
  simp only [cuspResidue, Int.cast_neg]

lemma cuspResidue_mul (x y : O) : cuspResidue (x * y) = cuspResidueMul (cuspResidue x) (cuspResidue y) := by
  calc
    _ = cuspResidue (Coordinates.eval (Coordinates.coords x).1 (Coordinates.coords x).2 *
        Coordinates.eval (Coordinates.coords y).1 (Coordinates.coords y).2) := by rw [Coordinates.eval_coords, Coordinates.eval_coords]
    _ = _ := by
      rw [Coordinates.eval_mul, cuspResidue_eval]
      simp only [cuspResidue, cuspResidueMul, Int.cast_add, Int.cast_sub, Int.cast_mul]

def cuspResidueAugmentation (x : O) : ZMod 3 := (cuspResidue x).1 + (cuspResidue x).2

lemma cuspResidueAugmentation_add (x y : O) :
    cuspResidueAugmentation (x + y) = cuspResidueAugmentation x + cuspResidueAugmentation y := by
  simp only [cuspResidueAugmentation, cuspResidue_add]
  ring

lemma cuspResidueAugmentation_neg (x : O) : cuspResidueAugmentation (-x) = -cuspResidueAugmentation x := by
  simp only [cuspResidueAugmentation, cuspResidue_neg]
  ring

lemma cuspResidueAugmentation_mul (x y : O) :
    cuspResidueAugmentation (x * y) = cuspResidueAugmentation x * cuspResidueAugmentation y := by
  simp only [cuspResidueAugmentation, cuspResidue_mul, cuspResidueMul]
  have h3 : (3 : ZMod 3) = 0 := rfl
  linear_combination -(cuspResidue x).2 * (cuspResidue y).2 * h3

lemma cuspResidueAugmentation_one : cuspResidueAugmentation (1 : O) = 1 := by
  simp only [cuspResidueAugmentation, cuspResidue_one, add_zero]

/-- A determinant-one column stays nonzero after reduction modulo the ramified prime. -/
lemma cuspResidue_first_column_primitive (M : SL(2, O)) :
    ¬ (cuspResidueAugmentation (M 0 0) = 0 ∧ cuspResidueAugmentation (M 1 0) = 0) := by
  rintro ⟨ha, hc⟩
  have hd : M 0 0 * M 1 1 - M 0 1 * M 1 0 = 1 := by simpa only [Matrix.det_fin_two] using M.property
  have he := congrArg cuspResidueAugmentation hd
  simp only [sub_eq_add_neg, cuspResidueAugmentation_add, cuspResidueAugmentation_neg,
    cuspResidueAugmentation_mul, cuspResidueAugmentation_one, ha, hc, zero_mul, mul_zero, neg_zero, add_zero] at he
  exact zero_ne_one he

lemma cuspResidue_omega : cuspResidue omega = (0, 1) := by
  simpa only [Coordinates.eval, Int.cast_zero, Int.cast_one, zero_add, one_mul] using cuspResidue_eval 0 1

lemma cuspResidue_omega_sq : cuspResidue (omega ^ 2) = (-1, -1) := by
  rw [pow_two, cuspResidue_mul, cuspResidue_omega]
  norm_num [cuspResidueMul]

lemma cuspResidue_eq_three_dvd {x y : O} (h : cuspResidue x = cuspResidue y) : (3 : O) ∣ x - y := by
  have ha : (3 : ℤ) ∣ (Coordinates.coords x).1 - (Coordinates.coords y).1 :=
    (ZMod.intCast_eq_intCast_iff_dvd_sub (Coordinates.coords y).1 (Coordinates.coords x).1 3).mp
      (congrArg Prod.fst h).symm
  have hb : (3 : ℤ) ∣ (Coordinates.coords x).2 - (Coordinates.coords y).2 :=
    (ZMod.intCast_eq_intCast_iff_dvd_sub (Coordinates.coords y).2 (Coordinates.coords x).2 3).mp
      (congrArg Prod.snd h).symm
  obtain ⟨a, ha⟩ := ha
  obtain ⟨b, hb⟩ := hb
  refine ⟨Coordinates.eval a b, ?_⟩
  nth_rw 1 [← Coordinates.eval_coords x, ← Coordinates.eval_coords y]
  have hx : (Coordinates.coords x).1 = (Coordinates.coords y).1 + 3 * a := by omega
  have hy : (Coordinates.coords x).2 = (Coordinates.coords y).2 + 3 * b := by omega
  simp only [Coordinates.eval, hx, hy]
  push_cast
  ring

lemma cuspResidue_intCast_mul (n : ℤ) (x : O) : cuspResidue ((n : O) * x) =
    ((n : ZMod 3) * (cuspResidue x).1, (n : ZMod 3) * (cuspResidue x).2) := by
  rw [cuspResidue_mul, cuspResidue_intCast]
  simp only [cuspResidueMul, zero_mul, sub_zero, add_zero]

def cuspParameter (j : Fin 3) : O := if j = 0 then 0 else if j = 1 then omega else omega ^ 2
def cuspRepresentative (j : Fin 3) : SL(2, O) := lowerCuspMatrix (cuspParameter j)
def cuspResidueParameter (j : Fin 3) : ZMod 3 × ZMod 3 :=
  if j = 0 then (0, 0) else if j = 1 then (0, 1) else (-1, -1)

lemma cuspParameter_residue (j : Fin 3) : cuspResidue (cuspParameter j) = cuspResidueParameter j := by
  fin_cases j <;> simp [cuspParameter, cuspResidueParameter, cuspResidue_zero, cuspResidue_omega, cuspResidue_omega_sq]

def cuspNilpotentUnit (q : ZMod 3) : Oˣ := cuspOmegaUnit ^ q.val

lemma cuspNilpotentUnit_residue (q : ZMod 3) :
    cuspResidue (cuspNilpotentUnit q : O) = (1 - q, q) := by
  fin_cases q
  · change cuspResidue ((cuspOmegaUnit : O) ^ 0) = (1, 0)
    rw [pow_zero]
    exact cuspResidue_one
  · change cuspResidue ((cuspOmegaUnit : O) ^ 1) = (0, 1)
    rw [pow_one, cuspOmegaUnit_val]
    exact cuspResidue_omega
  · change cuspResidue (omega ^ 2) = _
    rw [cuspResidue_omega_sq]
    rfl

def cuspResidueColumn (g : SL(2, ZMod 3)) (j : Fin 3) (q : ZMod 3) (i : Fin 2) : ZMod 3 × ZMod 3 :=
  cuspResidueMul (g i 0 + g i 1 * (cuspResidueParameter j).1, g i 1 * (cuspResidueParameter j).2) (1 - q, q)

lemma cuspModThree_nonzero (x : ZMod 3) (hx : x ≠ 0) : x = 1 ∨ x = -1 := by
  fin_cases x
  · exact (hx rfl).elim
  · exact Or.inl rfl
  · exact Or.inr rfl

/-- The coordinate determinant gives three orbits of primitive columns modulo three. -/
theorem cuspResidue_column_classify (a c : ZMod 3 × ZMod 3)
    (hp : ¬ (a.1 + a.2 = 0 ∧ c.1 + c.2 = 0)) :
    ∃ g : SL(2, ZMod 3), ∃ j : Fin 3, ∃ q : ZMod 3,
      cuspResidueColumn g j q 0 = a ∧ cuspResidueColumn g j q 1 = c := by
  by_cases hd : a.1 * c.2 - a.2 * c.1 = 0
  · have hxy : a.1 + a.2 ≠ 0 ∨ c.1 + c.2 ≠ 0 := by
      by_cases hx : a.1 + a.2 = 0
      · exact Or.inr (fun hy => hp ⟨hx, hy⟩)
      · exact Or.inl hx
    have hcop : IsCoprime (a.1 + a.2) (c.1 + c.2) := by
      rcases hxy with hx | hy
      · exact ⟨(a.1 + a.2)⁻¹, 0, by rw [inv_mul_cancel₀ hx, zero_mul, add_zero]⟩
      · exact ⟨0, (c.1 + c.2)⁻¹, by rw [zero_mul, inv_mul_cancel₀ hy, zero_add]⟩
    obtain ⟨g, hg0, hg1, _⟩ := primitiveColumn_congruent_completion (1 : SL(2, ZMod 3))
      (a.1 + a.2) (c.1 + c.2) 1 hcop (one_dvd _) (one_dvd _)
    have hq : ∃ q : ZMod 3, (a.1 + a.2) * q = a.2 ∧ (c.1 + c.2) * q = c.2 := by
      rcases hxy with hx | hy
      · refine ⟨a.2 / (a.1 + a.2), ?_, ?_⟩
        · field_simp
        · field_simp
          linear_combination -hd
      · refine ⟨c.2 / (c.1 + c.2), ?_, ?_⟩
        · field_simp
          linear_combination hd
        · field_simp
    obtain ⟨q, hq0, hq1⟩ := hq
    refine ⟨g, 0, q, ?_, ?_⟩
    · simp only [cuspResidueColumn, cuspResidueParameter, if_true, hg0, mul_zero, add_zero,
        cuspResidueMul, zero_mul, sub_zero]
      apply Prod.ext
      · change (a.1 + a.2) * (1 - q) = a.1
        linear_combination -hq0
      · exact hq0
    · simp only [cuspResidueColumn, cuspResidueParameter, if_true, hg1, mul_zero, add_zero,
        cuspResidueMul, zero_mul, sub_zero]
      apply Prod.ext
      · change (c.1 + c.2) * (1 - q) = c.1
        linear_combination -hq1
      · exact hq1
  · rcases cuspModThree_nonzero _ hd with hdet | hdet
    · let g : SL(2, ZMod 3) := ⟨!![a.1, a.2; c.1, c.2], by
        rw [Matrix.det_fin_two]
        change a.1 * c.2 - a.2 * c.1 = 1
        exact hdet⟩
      refine ⟨g, 1, 0, ?_, ?_⟩ <;> apply Prod.ext <;>
        simp [cuspResidueColumn, cuspResidueParameter, cuspResidueMul, g]
    · let g : SL(2, ZMod 3) := ⟨!![a.1 - a.2, -a.2; c.1 - c.2, -c.2], by
        rw [Matrix.det_fin_two]
        change (a.1 - a.2) * -c.2 - -a.2 * (c.1 - c.2) = 1
        linear_combination -hdet⟩
      refine ⟨g, 2, 0, ?_, ?_⟩ <;> apply Prod.ext <;>
        simp [cuspResidueColumn, cuspResidueParameter, cuspResidueMul, g] <;> ring

lemma sameColumn_inverse_mul {R : Type*} [CommRing R] (M N : SL(2, R))
    (h0 : N 0 0 = M 0 0) (h1 : N 1 0 = M 1 0) :
    (N⁻¹ * M) 0 0 = 1 ∧ (N⁻¹ * M) 1 0 = 0 := by
  have hd : N 0 0 * N 1 1 - N 0 1 * N 1 0 = 1 := by simpa only [Matrix.det_fin_two] using N.property
  have hi00 : (N⁻¹) 0 0 = N 1 1 := by simp [Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]
  have hi01 : (N⁻¹) 0 1 = -N 0 1 := by simp [Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]
  have hi10 : (N⁻¹) 1 0 = -N 1 0 := by simp [Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]
  have hi11 : (N⁻¹) 1 1 = N 0 0 := by simp [Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]
  constructor
  · change (∑ k : Fin 2, (N⁻¹) 0 k * M k 0) = 1
    rw [Fin.sum_univ_two, hi00, hi01, ← h0, ← h1]
    linear_combination hd
  · change (∑ k : Fin 2, (N⁻¹) 1 k * M k 0) = 0
    rw [Fin.sum_univ_two, hi10, hi11, ← h0, ← h1]
    ring

def rationalReductionThree : SL(2, ℤ) →* SL(2, ZMod 3) :=
  Matrix.SpecialLinearGroup.map (Int.castRingHom (ZMod 3))

lemma rationalReductionThree_apply (r : SL(2, ℤ)) (i j : Fin 2) :
    rationalReductionThree r i j = (r i j : ZMod 3) := rfl

def rationalCuspTranslation (n : ℤ) : SL(2, ℤ) := ⟨!![1, n; 0, 1], by simp [Matrix.det_fin_two]⟩

lemma cuspModThree_unit_lift (x : ZMod 3) (hx : x ≠ 0) :
    ∃ n : ℤ, n ^ 2 = 1 ∧ (n : ZMod 3) = x := by
  rcases cuspModThree_nonzero x hx with h | h
  · exact ⟨1, by norm_num, by simpa only [Int.cast_one] using h.symm⟩
  · exact ⟨-1, by norm_num, by simpa only [Int.cast_neg, Int.cast_one] using h.symm⟩

/-- A signed lift of one nonzero entry lifts the first column; one translation lifts the matrix. -/
theorem rationalReductionThree_surjective : Function.Surjective rationalReductionThree := by
  intro g
  have hcol : ∃ r : SL(2, ℤ), rationalReductionThree r 0 0 = g 0 0 ∧
      rationalReductionThree r 1 0 = g 1 0 := by
    by_cases ha : g 0 0 = 0
    · have hc : g 1 0 ≠ 0 := by
        intro hc
        have hd := g.property
        simp only [Matrix.det_fin_two, ha, hc, zero_mul, mul_zero, sub_zero] at hd
        exact zero_ne_one hd
      obtain ⟨n, hn, hnc⟩ := cuspModThree_unit_lift _ hc
      let r : SL(2, ℤ) := ⟨!![0, -n; n, 0], by
        rw [Matrix.det_fin_two]
        change 0 * 0 - -n * n = 1
        linear_combination hn⟩
      refine ⟨r, ?_, hnc⟩
      change ((0 : ℤ) : ZMod 3) = g 0 0
      simpa only [Int.cast_zero] using ha.symm
    · obtain ⟨n, hn, hnc⟩ := cuspModThree_unit_lift _ ha
      let r : SL(2, ℤ) := ⟨!![n, 0; ((g 1 0).val : ℤ), n], by
        rw [Matrix.det_fin_two]
        change n * n - 0 * ((g 1 0).val : ℤ) = 1
        linear_combination hn⟩
      refine ⟨r, hnc, ?_⟩
      change (((g 1 0).val : ℤ) : ZMod 3) = g 1 0
      simpa only [Int.cast_natCast] using ZMod.natCast_zmod_val (g 1 0)
  obtain ⟨r, hr0, hr1⟩ := hcol
  let K : SL(2, ZMod 3) := (rationalReductionThree r)⁻¹ * g
  obtain ⟨hK0, hK1⟩ := sameColumn_inverse_mul g (rationalReductionThree r) hr0 hr1
  have hK11 : K 1 1 = 1 := by
    have h0 : K 0 0 = 1 := hK0
    have h1 : K 1 0 = 0 := hK1
    have hd : K 0 0 * K 1 1 - K 0 1 * K 1 0 = 1 := by simpa only [Matrix.det_fin_two] using K.property
    rwa [h0, h1, one_mul, mul_zero, sub_zero] at hd
  let T : SL(2, ℤ) := rationalCuspTranslation ((K 0 1).val : ℤ)
  have hT : rationalReductionThree T = K := by
    apply Matrix.SpecialLinearGroup.ext
    intro i j
    fin_cases i <;> fin_cases j
    · exact hK0.symm
    · change (((K 0 1).val : ℤ) : ZMod 3) = K 0 1
      simpa only [Int.cast_natCast] using ZMod.natCast_zmod_val (K 0 1)
    · exact hK1.symm
    · exact hK11.symm
  refine ⟨r * T, ?_⟩
  rw [map_mul, hT]
  dsimp only [K]
  group

def columnCuspRepresentative (r : SL(2, ℤ)) (j : Fin 3) (q : ZMod 3) : SL(2, O) :=
  rationalEmbedding r * cuspRepresentative j * unitCuspDiagonal (cuspNilpotentUnit q)

lemma columnCuspRepresentative_entry (r : SL(2, ℤ)) (j : Fin 3) (q : ZMod 3) (i : Fin 2) :
    columnCuspRepresentative r j q i 0 =
      ((r i 0 : O) + (r i 1 : O) * cuspParameter j) * (cuspNilpotentUnit q : O) := by
  change (((r : Matrix (Fin 2) (Fin 2) ℤ).map (Int.castRingHom O) * !![1, 0; cuspParameter j, 1]) *
    !![(cuspNilpotentUnit q : O), 0; 0, (↑(cuspNilpotentUnit q)⁻¹ : O)]) i 0 = _
  simp [Matrix.mul_apply, Fin.sum_univ_two]

lemma columnCuspRepresentative_residue (r : SL(2, ℤ)) (j : Fin 3) (q : ZMod 3) (i : Fin 2) :
    cuspResidue (columnCuspRepresentative r j q i 0) = cuspResidueColumn (rationalReductionThree r) j q i := by
  rw [columnCuspRepresentative_entry, cuspResidue_mul, cuspResidue_add, cuspResidue_intCast,
    cuspResidue_intCast_mul, cuspParameter_residue, cuspNilpotentUnit_residue]
  simp only [cuspResidueColumn, rationalReductionThree_apply, zero_add]

/-- Every integral cusp belongs to the rational class or one of the two primitive ramified classes. -/
theorem three_cusp_decomposition (M : SL(2, O)) :
    ∃ G : rationalExtension, ∃ j : Fin 3, ∃ T : SL(2, O),
      T 1 0 = 0 ∧ IsUnit (T 0 0) ∧ IsUnit (T 1 1) ∧
        M = (G : SL(2, O)) * cuspRepresentative j * T := by
  obtain ⟨g, j, q, hg0, hg1⟩ := cuspResidue_column_classify (cuspResidue (M 0 0))
    (cuspResidue (M 1 0)) (cuspResidue_first_column_primitive M)
  obtain ⟨r, hr⟩ := rationalReductionThree_surjective g
  let B := columnCuspRepresentative r j q
  have hB0 : cuspResidue (B 0 0) = cuspResidue (M 0 0) := by
    rw [columnCuspRepresentative_residue, hr]
    exact hg0
  have hB1 : cuspResidue (B 1 0) = cuspResidue (M 1 0) := by
    rw [columnCuspRepresentative_residue, hr]
    exact hg1
  have hcop : IsCoprime (M 0 0) (M 1 0) := by
    refine ⟨M 1 1, -M 0 1, ?_⟩
    have hd := M.property
    rw [Matrix.det_fin_two] at hd
    linear_combination hd
  obtain ⟨N, hN0, hN1, hNB⟩ := exists_congruent_cusp_completion B (M 0 0) (M 1 0) hcop
    (cuspResidue_eq_three_dvd hB0.symm) (cuspResidue_eq_three_dvd hB1.symm)
  let G : rationalExtension := ⟨(N * B⁻¹) * rationalEmbedding r, ⟨⟨N * B⁻¹, hNB⟩, r, rfl⟩⟩
  let T : SL(2, O) := unitCuspDiagonal (cuspNilpotentUnit q) * (N⁻¹ * M)
  have hT : T 1 0 = 0 := by
    have hz := (sameColumn_inverse_mul M N hN0 hN1).2
    change (∑ k : Fin 2, unitCuspDiagonal (cuspNilpotentUnit q) 1 k * (N⁻¹ * M) k 0) = 0
    rw [Fin.sum_univ_two]
    change 0 * (N⁻¹ * M) 0 0 + (↑(cuspNilpotentUnit q)⁻¹ : O) * (N⁻¹ * M) 1 0 = 0
    rw [hz, mul_zero, zero_mul, add_zero]
  have hd : T 0 0 * T 1 1 = 1 := by
    simpa only [Matrix.det_fin_two, hT, mul_zero, sub_zero] using T.property
  refine ⟨G, j, T, hT, IsUnit.of_mul_eq_one _ hd,
    IsUnit.of_mul_eq_one _ (show T 1 1 * T 0 0 = 1 by simpa only [mul_comm] using hd), ?_⟩
  dsimp only [G, T, B, columnCuspRepresentative]
  group

def sourceBarBesselCoefficient (h : O) : ℂ :=
  (2 * Real.pi * Complex.I * star (cuspFrequency h)) * rationalSourceResidualFourierCoefficient h

lemma sourceBarBesselCoefficient_subexponential (ε : ℝ) (hε : 0 < ε) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖sourceBarBesselCoefficient h‖ ≤ C * Real.exp (ε * ‖cuspFrequency h‖) := by
  apply cubicBesselCoefficient_linearWeight_subexponential _ _
    rationalSourceResidualFourierCoefficient_subexponential (2 * Real.pi) (by positivity) _ ε hε
  intro h hh
  exact le_of_eq (by norm_num [norm_mul, norm_star, abs_of_pos Real.pi_pos])

theorem cubicSource_wirtingerBar_bessel (v : ℝ) (hv : 0 < v) (z : ℂ) :
    horizontalWirtingerBar (fun w => cubicSourceResidualFunction (upperPoint w v hv)) z =
      ∑' h : O, cubicBesselTerm sourceBarBesselCoefficient h (v, z) := by
  have he : (fun w => cubicSourceResidualFunction (upperPoint w v hv)) =
      fun w => ∑' h : O, rationalSourceModeAmplitude v h * tracePhase (cuspFrequency h * w) :=
    funext (cubicSourceResidualFunction_fourier_expansion v hv)
  rw [he, traceFourierSeries_wirtingerBar _ _ (rationalSourceModeAmplitude_summable v hv)
    (rationalSourceModeAmplitude_frequency_summable v hv)]
  apply tsum_congr
  intro h
  by_cases hh : h = 0
  · subst h
    simp only [cuspFrequency, map_zero, zero_div, star_zero, mul_zero, zero_mul,
      cubicBesselTerm, cubicBesselAmplitude, if_true]
  · rw [rationalSourceModeAmplitude_bessel v hv h hh]
    simp only [cubicBesselTerm, cubicBesselAmplitude, if_neg hh, sourceBarBesselCoefficient, mul_assoc]

theorem cubicSource_barProfile_continuousOn (z : ℂ) :
    ContinuousOn (cuspBarProfile cubicSourceResidualFunction z) (Set.Ioi 0) := by
  intro v hv
  change 0 < v at hv
  have hs := (cubicBesselSeries_hasFDerivAt sourceBarBesselCoefficient
    sourceBarBesselCoefficient_subexponential (v, z) hv).differentiableAt
  have hp : DifferentiableAt ℝ (fun y : ℝ => (y, z)) v := by fun_prop
  apply ContinuousAt.continuousWithinAt
  apply (hs.comp v hp).continuousAt.congr_of_eventuallyEq
  filter_upwards [Ioi_mem_nhds hv] with y hy
  rw [cuspBarProfile_positive _ _ _ hy, cubicSource_wirtingerBar_bessel y hy z]
  rfl

lemma conjugateSource_zProfile (z : ℂ) (v : ℝ) (hv : 0 < v) :
    cuspZProfile (fun w => star (cubicSourceResidualFunction w)) z v =
      star (cuspBarProfile cubicSourceResidualFunction z v) := by
  rw [cuspZProfile_positive _ _ _ hv, cuspBarProfile_positive _ _ _ hv]
  exact horizontalWirtingerZ_conjugate _ z (cubicSource_horizontal_differentiableAt v hv z)

theorem conjugateSource_zProfile_continuousOn (z : ℂ) :
    ContinuousOn (cuspZProfile (fun w => star (cubicSourceResidualFunction w)) z) (Set.Ioi 0) := by
  apply (cubicSource_barProfile_continuousOn z).star.congr
  intro v hv
  exact conjugateSource_zProfile z v hv

theorem conjugateSource_zProfile_isBigO (z : ℂ) :
    cuspZProfile (fun w => star (cubicSourceResidualFunction w)) z =O[atTop]
      (fun v : ℝ => Real.exp (-residualBesselDecayRate * v)) := by
  obtain ⟨C, hC, hb⟩ := cubicBesselSeries_exponential_decay sourceBarBesselCoefficient
    sourceBarBesselCoefficient_subexponential 1 (by norm_num)
  apply Asymptotics.IsBigO.of_bound C
  filter_upwards [eventually_ge_atTop (1 : ℝ)] with v hv
  have hp : 0 < v := zero_lt_one.trans_le hv
  rw [conjugateSource_zProfile z v hp, norm_star, cuspBarProfile_positive _ _ _ hp,
    cubicSource_wirtingerBar_bessel v hp z]
  simpa only [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)] using hb v hv z

lemma horizontalWirtingerZ_const_mul (a : ℂ) (f : ℂ → ℂ) (z : ℂ) (hf : DifferentiableAt ℝ f z) :
    horizontalWirtingerZ (fun w => a * f w) z = a * horizontalWirtingerZ f z := by
  have hline (direction : ℂ) : DifferentiableAt ℝ (fun t : ℝ => f (z + (t : ℂ) * direction)) 0 := by
    have hp : DifferentiableAt ℝ (fun t : ℝ => z + (t : ℂ) * direction) 0 := by fun_prop
    have hf' : DifferentiableAt ℝ f (z + (0 : ℂ) * direction) := by simpa only [zero_mul, add_zero] using hf
    exact hf'.comp 0 hp
  have h1 := ((hline 1).hasDerivAt.const_mul a).deriv
  have hI := ((hline Complex.I).hasDerivAt.const_mul a).deriv
  simp only [mul_one] at h1
  rw [horizontalWirtingerZ, h1, hI, horizontalWirtingerZ]
  ring

lemma conjugateSource_translate_horizontal_differentiableAt (g : SL(2, ℂ))
    (v : ℝ) (hv : 0 < v) (z : ℂ) :
    DifferentiableAt ℝ (fun w => star (cubicSourceResidualFunction (g • upperPoint w v hv))) z := by
  have hf := cubicSourceResidualFunction_translate_coordinate_differentiableAt g (v, z) hv
  have hp : DifferentiableAt ℝ (fun w : ℂ => (v, w)) z := by fun_prop
  have hh := Complex.conjCLE.differentiableAt.comp z (hf.comp z hp)
  have he : (fun w => star (cubicSourceResidualFunction (g • upperPoint w v hv))) =
      fun w => Complex.conjCLE (cubicSourceResidualFunction (g • cuspCoordinateLift (v, w))) := by
    funext w
    rw [cuspCoordinateLift_positive v w hv]
    rfl
  rw [he]
  convert! hh using 1

lemma conjugateSource_zProfile_transform (G : rationalExtension) (H : SL(2, ℂ))
    (z : ℂ) (v : ℝ) (hv : 0 < v) :
    cuspZProfile (fun w => star (cubicSourceResidualFunction
      ((integralComplexMatrix (G : SL(2, O)) * H) • w))) z v =
      star (extendedComplexCharacter G) * cuspZProfile (fun w => star (cubicSourceResidualFunction (H • w))) z v := by
  rw [cuspZProfile_positive _ _ _ hv, cuspZProfile_positive _ _ _ hv]
  have he : (fun w : ℂ => star (cubicSourceResidualFunction
      ((integralComplexMatrix (G : SL(2, O)) * H) • upperPoint w v hv))) =
      fun w => star (extendedComplexCharacter G) * star (cubicSourceResidualFunction (H • upperPoint w v hv)) := by
    funext w
    rw [mul_smul, cubicSourceResidualFunction_automorphy G, star_mul]
    exact mul_comm _ _
  rw [he]
  exact horizontalWirtingerZ_const_mul (star (extendedComplexCharacter G))
    (fun w : ℂ => star (cubicSourceResidualFunction (H • upperPoint w v hv))) z
    (conjugateSource_translate_horizontal_differentiableAt H v hv z)

lemma conjugateSource_barProfile_reflection_rational (G : rationalExtension)
    (g H : SL(2, ℂ)) (hfactor : g = integralComplexMatrix (G : SL(2, O)) * H)
    (hc : g 1 0 ≠ 0) (v : ℝ) (hv : 0 < v) :
    cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) (g 0 0 / g 1 0) v =
      reflectedCuspProfile (-star (extendedComplexCharacter G) / (g 1 0) ^ 2) (‖g 1 0‖ ^ 2)
        (cuspZProfile (fun w => star (cubicSourceResidualFunction (H • w))) (-g 1 1 / g 1 0)) v := by
  have hd : 0 < (‖g 1 0‖ ^ 2 * v)⁻¹ := by positivity
  have he : cuspZProfile (fun w => star (cubicSourceResidualFunction (g • w))) (-g 1 1 / g 1 0)
      ((‖g 1 0‖ ^ 2 * v)⁻¹) = star (extendedComplexCharacter G) *
        cuspZProfile (fun w => star (cubicSourceResidualFunction (H • w))) (-g 1 1 / g 1 0)
          ((‖g 1 0‖ ^ 2 * v)⁻¹) := by
    conv_lhs => arg 1; rw [hfactor]
    exact conjugateSource_zProfile_transform G H _ _ hd
  rw [conjugateSource_barProfile_reflection g hc v hv, reflectedCuspProfile, reflectedCuspProfile, he]
  ring

lemma lowerCuspMatrix_zero : lowerCuspMatrix 0 = 1 := by
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  fin_cases i <;> fin_cases j <;> rfl

lemma conjugateSource_cuspRepresentative_zProfile_continuousOn (j : Fin 3) (z : ℂ) :
    ContinuousOn (cuspZProfile (fun w => star (cubicSourceResidualFunction
      (integralComplexMatrix (cuspRepresentative j) • w))) z) (Set.Ioi 0) := by
  fin_cases j
  · simpa [cuspRepresentative, cuspParameter, lowerCuspMatrix_zero] using conjugateSource_zProfile_continuousOn z
  · simpa [cuspRepresentative, cuspParameter, ramifiedSourceFunction, ramifiedCuspRoot, cuspOmegaUnit_val] using
      conjugateRamifiedSource_zProfile_continuousOn false z
  · simpa [cuspRepresentative, cuspParameter, ramifiedSourceFunction, ramifiedCuspRoot, cuspOmegaUnit_val] using
      conjugateRamifiedSource_zProfile_continuousOn true z

lemma conjugateSource_cuspRepresentative_zProfile_decay (j : Fin 3) (z : ℂ) :
    ∃ δ : ℝ, 0 < δ ∧ cuspZProfile (fun w => star (cubicSourceResidualFunction
      (integralComplexMatrix (cuspRepresentative j) • w))) z =O[atTop]
        (fun v : ℝ => Real.exp (-δ * v)) := by
  fin_cases j
  · refine ⟨residualBesselDecayRate, residualBesselDecayRate_pos, ?_⟩
    simpa [cuspRepresentative, cuspParameter, lowerCuspMatrix_zero] using conjugateSource_zProfile_isBigO z
  · refine ⟨residualBesselDecayRate / 3, div_pos residualBesselDecayRate_pos (by norm_num), ?_⟩
    simpa [cuspRepresentative, cuspParameter, ramifiedSourceFunction, ramifiedCuspRoot, cuspOmegaUnit_val] using
      conjugateRamifiedSource_zProfile_isBigO false z
  · refine ⟨residualBesselDecayRate / 3, div_pos residualBesselDecayRate_pos (by norm_num), ?_⟩
    simpa [cuspRepresentative, cuspParameter, ramifiedSourceFunction, ramifiedCuspRoot, cuspOmegaUnit_val] using
      conjugateRamifiedSource_zProfile_isBigO true z

theorem conjugateSource_three_cusp_mellin_entire (G : rationalExtension) (j : Fin 3)
    (g : SL(2, ℂ)) (hfactor : g = integralComplexMatrix (G : SL(2, O)) * integralComplexMatrix (cuspRepresentative j))
    (hc : g 1 0 ≠ 0) :
    (∀ s : ℂ, MellinConvergent (cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) (g 0 0 / g 1 0)) s) ∧
      Differentiable ℂ (mellin (cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) (g 0 0 / g 1 0))) := by
  obtain ⟨δ, hδ, hb⟩ := conjugateSource_cuspRepresentative_zProfile_decay j (-g 1 1 / g 1 0)
  exact cusp_mellin_entire _ _ (-star (extendedComplexCharacter G) / (g 1 0) ^ 2)
    (‖g 1 0‖ ^ 2) residualBesselDecayRate δ (sq_pos_of_pos (norm_pos_iff.mpr hc)) residualBesselDecayRate_pos hδ
    (conjugateSource_barProfile_continuousOn _) (conjugateSource_cuspRepresentative_zProfile_continuousOn j _)
    (conjugateSource_barProfile_isBigO _) hb
    (fun v hv => conjugateSource_barProfile_reflection_rational G g _ hfactor hc v hv)

lemma upperTriangular_right_cusp_ratio (g T : SL(2, ℂ)) (hT : T 1 0 = 0)
    (hc : (g * T) 1 0 ≠ 0) :
    g 1 0 ≠ 0 ∧ (g * T) 0 0 / (g * T) 1 0 = g 0 0 / g 1 0 := by
  have hcol (i : Fin 2) : (g * T) i 0 = g i 0 * T 0 0 := by
    change (∑ k : Fin 2, g i k * T k 0) = _
    rw [Fin.sum_univ_two, hT, mul_zero, add_zero]
  have hn : g 1 0 * T 0 0 ≠ 0 := by rwa [hcol] at hc
  have hg := (mul_ne_zero_iff.mp hn).1
  have ht := (mul_ne_zero_iff.mp hn).2
  refine ⟨hg, ?_⟩
  rw [hcol, hcol]
  field_simp

/-- Every integral finite cusp has an entire derivative Mellin transform. -/
theorem conjugateSource_integral_cusp_mellin_entire (M : SL(2, O)) (hc : M 1 0 ≠ 0) :
    (∀ s : ℂ, MellinConvergent (cuspBarProfile (fun w => star (cubicSourceResidualFunction w))
      (ringComplex (M 0 0) / ringComplex (M 1 0))) s) ∧
      Differentiable ℂ (mellin (cuspBarProfile (fun w => star (cubicSourceResidualFunction w))
        (ringComplex (M 0 0) / ringComplex (M 1 0)))) := by
  obtain ⟨G, j, T, hT, _, _, hM⟩ := three_cusp_decomposition M
  let g := integralComplexMatrix (G : SL(2, O)) * integralComplexMatrix (cuspRepresentative j)
  have he : integralComplexMatrix M = g * integralComplexMatrix T := by rw [hM, map_mul, map_mul]
  have ht : integralComplexMatrix T 1 0 = 0 := by
    change ringComplex (T 1 0) = 0
    rw [hT, map_zero]
  have hmc : (g * integralComplexMatrix T) 1 0 ≠ 0 := by
    rw [← he]
    exact ringComplex_ne_zero hc
  obtain ⟨hg, hratio⟩ := upperTriangular_right_cusp_ratio g (integralComplexMatrix T) ht hmc
  have hh := conjugateSource_three_cusp_mellin_entire G j g rfl hg
  rw [← hratio, ← he] at hh
  exact hh

theorem cusp_mellin_reflection_of_identity (f g : ℝ → ℂ) (A s : ℂ) (Q : ℝ) (hQ : 0 < Q)
    (hfg : ∀ v : ℝ, 0 < v → f v = reflectedCuspProfile A Q g v) :
    mellin f s = A * (Q : ℂ) ^ (2 - s) * mellin g (2 - s) := by
  rw [← reflectedCuspProfile_mellin g A s Q hQ]
  unfold mellin
  apply setIntegral_congr_fun measurableSet_Ioi
  intro v hv
  dsimp only
  rw [hfg v hv]

lemma reflectedCuspProfile_involution (f : ℝ → ℂ) (A : ℂ) (hA : A ≠ 0)
    (Q : ℝ) (hQ : 0 < Q) (v : ℝ) (hv : 0 < v) :
    reflectedCuspProfile (A⁻¹ / (Q : ℂ) ^ 2) Q (reflectedCuspProfile A Q f) v = f v := by
  have harg : (Q * (Q * v)⁻¹)⁻¹ = v := by field_simp
  have hp (t : ℝ) : (t : ℂ) ^ (-2 : ℂ) = ((t : ℂ) ^ 2)⁻¹ := by
    rw [Complex.cpow_neg, Complex.cpow_ofNat]
  rw [reflectedCuspProfile, reflectedCuspProfile, harg, hp, hp]
  simp only [Complex.ofReal_inv, Complex.ofReal_mul]
  field_simp [hA, Complex.ofReal_ne_zero.mpr hQ.ne', Complex.ofReal_ne_zero.mpr hv.ne']

theorem cusp_mellin_entire_both (f g : ℝ → ℂ) (A : ℂ) (hA : A ≠ 0) (Q decayF decayG : ℝ)
    (hQ : 0 < Q) (hF : 0 < decayF) (hG : 0 < decayG)
    (hf : ContinuousOn f (Set.Ioi 0)) (hg : ContinuousOn g (Set.Ioi 0))
    (hfbound : f =O[atTop] (fun v : ℝ => Real.exp (-decayF * v)))
    (hgbound : g =O[atTop] (fun v : ℝ => Real.exp (-decayG * v)))
    (hfg : ∀ v : ℝ, 0 < v → f v = reflectedCuspProfile A Q g v) :
    ((∀ s : ℂ, MellinConvergent f s) ∧ Differentiable ℂ (mellin f)) ∧
      ((∀ s : ℂ, MellinConvergent g s) ∧ Differentiable ℂ (mellin g)) := by
  have hgf (v : ℝ) (hv : 0 < v) : g v = reflectedCuspProfile (A⁻¹ / (Q : ℂ) ^ 2) Q f v := by
    calc
      _ = reflectedCuspProfile (A⁻¹ / (Q : ℂ) ^ 2) Q (reflectedCuspProfile A Q g) v :=
        (reflectedCuspProfile_involution g A hA Q hQ v hv).symm
      _ = _ := by
        change (A⁻¹ / (Q : ℂ) ^ 2) * ((v : ℂ) ^ (-2 : ℂ) * reflectedCuspProfile A Q g ((Q * v)⁻¹)) =
          (A⁻¹ / (Q : ℂ) ^ 2) * ((v : ℂ) ^ (-2 : ℂ) * f ((Q * v)⁻¹))
        rw [hfg _ (by positivity)]
  exact ⟨cusp_mellin_entire f g A Q decayF decayG hQ hF hG hf hg hfbound hgbound hfg,
    cusp_mellin_entire g f (A⁻¹ / (Q : ℂ) ^ 2) Q decayG decayF hQ hG hF hg hf hgbound hfbound hgf⟩

/-- Both profiles in the reflected three-cusp identity have entire Mellin transforms. -/
theorem conjugateSource_three_cusp_mellin_entire_both (G : rationalExtension) (j : Fin 3)
    (g : SL(2, ℂ)) (hfactor : g = integralComplexMatrix (G : SL(2, O)) * integralComplexMatrix (cuspRepresentative j))
    (hc : g 1 0 ≠ 0) :
    ((∀ s : ℂ, MellinConvergent (cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) (g 0 0 / g 1 0)) s) ∧
      Differentiable ℂ (mellin (cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) (g 0 0 / g 1 0)))) ∧
    ((∀ s : ℂ, MellinConvergent (cuspZProfile (fun w => star (cubicSourceResidualFunction
      (integralComplexMatrix (cuspRepresentative j) • w))) (-g 1 1 / g 1 0)) s) ∧
      Differentiable ℂ (mellin (cuspZProfile (fun w => star (cubicSourceResidualFunction
        (integralComplexMatrix (cuspRepresentative j) • w))) (-g 1 1 / g 1 0)))) := by
  have hchar : extendedComplexCharacter G ≠ 0 := by
    intro hz
    have he : extendedComplexCharacter G * extendedComplexCharacter G⁻¹ = 1 := by
      rw [← map_mul, mul_inv_cancel, map_one]
    rw [hz, zero_mul] at he
    exact zero_ne_one he
  have hA : -star (extendedComplexCharacter G) / (g 1 0) ^ 2 ≠ 0 :=
    div_ne_zero (neg_ne_zero.mpr (star_ne_zero.mpr hchar)) (pow_ne_zero 2 hc)
  obtain ⟨δ, hδ, hb⟩ := conjugateSource_cuspRepresentative_zProfile_decay j (-g 1 1 / g 1 0)
  exact cusp_mellin_entire_both _ _ (-star (extendedComplexCharacter G) / (g 1 0) ^ 2) hA
    (‖g 1 0‖ ^ 2) residualBesselDecayRate δ (sq_pos_of_pos (norm_pos_iff.mpr hc)) residualBesselDecayRate_pos hδ
    (conjugateSource_barProfile_continuousOn _) (conjugateSource_cuspRepresentative_zProfile_continuousOn j _)
    (conjugateSource_barProfile_isBigO _) hb
    (fun v hv => conjugateSource_barProfile_reflection_rational G g _ hfactor hc v hv)

theorem conjugateSource_cusp_mellin_reflection (G : rationalExtension)
    (g H : SL(2, ℂ)) (hfactor : g = integralComplexMatrix (G : SL(2, O)) * H)
    (hc : g 1 0 ≠ 0) (s : ℂ) :
    mellin (cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) (g 0 0 / g 1 0)) (2 * s) =
      (-star (extendedComplexCharacter G) / (g 1 0) ^ 2) * ((‖g 1 0‖ ^ 2 : ℝ) : ℂ) ^ (2 - 2 * s) *
        mellin (cuspZProfile (fun w => star (cubicSourceResidualFunction (H • w))) (-g 1 1 / g 1 0)) (2 - 2 * s) :=
  cusp_mellin_reflection_of_identity _ _ _ (2 * s) _ (sq_pos_of_pos (norm_pos_iff.mpr hc))
    (fun v hv => conjugateSource_barProfile_reflection_rational G g H hfactor hc v hv)

lemma exists_integral_matrix_cusp_ratio (a c : O) (hc : c ≠ 0) :
    ∃ M : SL(2, O), M 1 0 ≠ 0 ∧ ringComplex (M 0 0) / ringComplex (M 1 0) = ringComplex a / ringComplex c := by
  let d := IsBezout.gcd a c
  obtain ⟨a', ha⟩ := IsBezout.gcd_dvd_left a c
  obtain ⟨c', hcc⟩ := IsBezout.gcd_dvd_right a c
  change a = d * a' at ha
  change c = d * c' at hcc
  have hd : d ≠ 0 := by intro hz; exact hc (by rw [hcc, hz, zero_mul])
  have hc' : c' ≠ 0 := by intro hz; exact hc (by rw [hcc, hz, mul_zero])
  obtain ⟨u, v, huv⟩ := IsBezout.gcd_eq_sum a c
  change u * a + v * c = d at huv
  have hred : u * a' + v * c' = 1 := by
    apply mul_left_cancel₀ hd
    calc
      d * (u * a' + v * c') = u * a + v * c := by rw [ha, hcc]; ring
      _ = d := huv
      _ = d * 1 := (mul_one d).symm
  let M : SL(2, O) := ⟨!![a', -v; c', u], by
    rw [Matrix.det_fin_two]
    change a' * u - -v * c' = 1
    linear_combination hred⟩
  refine ⟨M, hc', ?_⟩
  change ringComplex a' / ringComplex c' = ringComplex a / ringComplex c
  rw [ha, hcc, map_mul, map_mul]
  have hde := ringComplex_ne_zero hd
  have hce := ringComplex_ne_zero hc'
  field_simp

/-- Every Eisenstein rational cusp has an entire horizontal-derivative Mellin transform. -/
theorem conjugateSource_rational_cusp_mellin_entire (a c : O) (hc : c ≠ 0) :
    (∀ s : ℂ, MellinConvergent (cuspBarProfile (fun w => star (cubicSourceResidualFunction w))
      (ringComplex a / ringComplex c)) s) ∧
      Differentiable ℂ (mellin (cuspBarProfile (fun w => star (cubicSourceResidualFunction w))
        (ringComplex a / ringComplex c))) := by
  obtain ⟨M, hM, he⟩ := exists_integral_matrix_cusp_ratio a c hc
  simpa only [he] using conjugateSource_integral_cusp_mellin_entire M hM

theorem conjugateSource_finite_twist_cusp_mellin_entire (h c : O) (hc : c ≠ 0) :
    (∀ s : ℂ, MellinConvergent (cuspBarProfile (fun w => star (cubicSourceResidualFunction w))
      (-3 * ringComplex h / ringComplex c)) s) ∧
      Differentiable ℂ (mellin (cuspBarProfile (fun w => star (cubicSourceResidualFunction w))
        (-3 * ringComplex h / ringComplex c))) := by
  simpa only [map_mul, map_neg, map_ofNat] using conjugateSource_rational_cusp_mellin_entire (-3 * h) c hc

lemma finiteMellin_linearCombination_entire {ι : Type*} [Fintype ι]
    (weight : ι → ℂ) (f : ι → ℝ → ℂ)
    (hc : ∀ i s, MellinConvergent (f i) s) (hd : ∀ i, Differentiable ℂ (mellin (f i))) :
    (∀ s : ℂ, MellinConvergent (fun v => ∑ i, weight i * f i v) s) ∧
      Differentiable ℂ (mellin (fun v => ∑ i, weight i * f i v)) := by
  have hi (i : ι) (s : ℂ) : Integrable (fun v : ℝ => (v : ℂ) ^ (s - 1) * (weight i * f i v))
      (volume.restrict (Set.Ioi 0)) := by
    have hh := (hc i s).const_smul (weight i)
    simp only [MellinConvergent, smul_eq_mul, IntegrableOn] at hh
    convert! hh using 1
  have hs (s : ℂ) : MellinConvergent (fun v => ∑ i, weight i * f i v) s := by
    unfold MellinConvergent
    simp only [smul_eq_mul, Finset.mul_sum]
    exact integrable_finset_sum _ (fun i _ => hi i s)
  have he (s : ℂ) : mellin (fun v => ∑ i, weight i * f i v) s = ∑ i, weight i * mellin (f i) s := by
    unfold mellin
    simp only [smul_eq_mul, Finset.mul_sum]
    rw [integral_finset_sum _ (fun i _ => hi i s)]
    apply Finset.sum_congr rfl
    intro i hmem
    rw [← integral_const_mul]
    exact integral_congr_ae (Eventually.of_forall (fun v => by ring))
  refine ⟨hs, ?_⟩
  rw [funext he]
  intro s
  apply AnalyticAt.differentiableAt
  apply Finset.analyticAt_fun_sum
  intro i hmem
  exact analyticAt_const.mul ((hd i).analyticAt s)

/-- The derivative profile of a finite residue-class twist, expressed at rational cusps. -/
def traceTwistedBarProfile (c : O) (hc : c ≠ 0) [Fintype (O ⧸ Ideal.span {c})]
    (φ : (O ⧸ Ideal.span {c}) → ℂ) (v : ℝ) : ℂ :=
  ∑ h, finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 c hc) φ h *
    cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) (thetaFourierTranslation c h) v

theorem traceTwistedBarProfile_mellin_entire (c : O) (hc : c ≠ 0) [Fintype (O ⧸ Ideal.span {c})]
    (φ : (O ⧸ Ideal.span {c}) → ℂ) :
    (∀ s : ℂ, MellinConvergent (traceTwistedBarProfile c hc φ) s) ∧
      Differentiable ℂ (mellin (traceTwistedBarProfile c hc φ)) := by
  apply finiteMellin_linearCombination_entire
  · intro h s
    exact (conjugateSource_finite_twist_cusp_mellin_entire (Quotient.out h) c hc).1 s
  · intro h
    exact (conjugateSource_finite_twist_cusp_mellin_entire (Quotient.out h) c hc).2

lemma horizontalWirtingerBar_finiteCombination {ι : Type*} [Fintype ι]
    (weight : ι → ℂ) (f : ι → ℂ → ℂ) (z : ℂ)
    (hf : ∀ i, DifferentiableAt ℝ (f i) z) :
    horizontalWirtingerBar (fun w => ∑ i, weight i * f i w) z =
      ∑ i, weight i * horizontalWirtingerBar (f i) z := by
  have hline (i : ι) (direction : ℂ) :
      DifferentiableAt ℝ (fun t : ℝ => f i (z + (t : ℂ) * direction)) 0 := by
    have hp : DifferentiableAt ℝ (fun t : ℝ => z + (t : ℂ) * direction) 0 := by fun_prop
    have hi : DifferentiableAt ℝ (f i) (z + (0 : ℂ) * direction) := by
      simpa only [zero_mul, add_zero] using hf i
    exact hi.comp 0 hp
  have h1 := (HasDerivAt.fun_sum (u := Finset.univ)
    (fun i _ => ((hline i 1).hasDerivAt.const_mul (weight i)))).deriv
  have hI := (HasDerivAt.fun_sum (u := Finset.univ)
    (fun i _ => ((hline i Complex.I).hasDerivAt.const_mul (weight i)))).deriv
  simp only [mul_one] at h1
  rw [horizontalWirtingerBar, h1, hI]
  simp only [Finset.mul_sum, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro i hi
  unfold horizontalWirtingerBar
  ring

lemma conjugateSource_shift_horizontal_differentiableAt (a z : ℂ) (v : ℝ) (hv : 0 < v) :
    DifferentiableAt ℝ (fun w => star (cubicSourceResidualFunction (upperPoint (w + a) v hv))) z := by
  have hf := conjugateSource_translate_horizontal_differentiableAt (complexTranslation a) v hv z
  have he : (fun w => star (cubicSourceResidualFunction (complexTranslation a • upperPoint w v hv))) =
      fun w => star (cubicSourceResidualFunction (upperPoint (w + a) v hv)) := by
    funext w
    rw [complexTranslation_action]
  rw [he] at hf
  exact hf

lemma conjugateSource_shift_barProfile (a : ℂ) (v : ℝ) (hv : 0 < v) :
    cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) a v =
      horizontalWirtingerBar (fun w => star (cubicSourceResidualFunction (upperPoint (w + a) v hv))) 0 := by
  rw [cuspBarProfile_positive _ _ _ hv]
  exact (horizontalWirtingerBar_translate
    (fun w => star (cubicSourceResidualFunction (upperPoint w v hv))) a).symm

theorem traceTwistedBarProfile_positive (c : O) (hc : c ≠ 0)
    [Fintype (O ⧸ Ideal.span {c})] (φ : (O ⧸ Ideal.span {c}) → ℂ)
    (v : ℝ) (hv : 0 < v) :
    traceTwistedBarProfile c hc φ v =
      horizontalWirtingerBar (traceTwistedConjugateSource c hc φ v hv) 0 := by
  let weight := finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 c hc) φ
  let f : (O ⧸ Ideal.span {c}) → ℂ → ℂ :=
    fun h z => star (cubicSourceResidualFunction (upperPoint (z + thetaFourierTranslation c h) v hv))
  have hd (h : O ⧸ Ideal.span {c}) : DifferentiableAt ℝ (f h) 0 :=
    conjugateSource_shift_horizontal_differentiableAt (thetaFourierTranslation c h) 0 v hv
  have he := horizontalWirtingerBar_finiteCombination weight f 0 hd
  refine Eq.trans ?_ he.symm
  apply Finset.sum_congr rfl
  intro h hh
  exact congrArg (fun q : ℂ => weight h * q)
    (conjugateSource_shift_barProfile (thetaFourierTranslation c h) v hv)

/-- The normalized theta derivative is an entire Mellin profile. -/
def finiteThetaBarProfile (c : O) (hc : c ≠ 0)
    [Fintype (O ⧸ Ideal.span {9 * c})] (Ψ : (O ⧸ Ideal.span {c}) →* ℂ) (v : ℝ) : ℂ :=
  rationalSourceThetaScalar⁻¹ *
    traceTwistedBarProfile (9 * c) (mul_ne_zero (by norm_num) hc) (finiteThetaTwist c Ψ) v

theorem finiteThetaBarProfile_mellin_entire (c : O) (hc : c ≠ 0)
    [Fintype (O ⧸ Ideal.span {9 * c})] (Ψ : (O ⧸ Ideal.span {c}) →* ℂ) :
    (∀ s : ℂ, MellinConvergent (finiteThetaBarProfile c hc Ψ) s) ∧
      Differentiable ℂ (mellin (finiteThetaBarProfile c hc Ψ)) := by
  have hf := traceTwistedBarProfile_mellin_entire (9 * c) (mul_ne_zero (by norm_num) hc) (finiteThetaTwist c Ψ)
  constructor
  · intro s
    unfold finiteThetaBarProfile
    have hh := (hf.1 s).const_smul rationalSourceThetaScalar⁻¹
    simp only [smul_eq_mul] at hh
    convert! hh using 1
  · have he : mellin (finiteThetaBarProfile c hc Ψ) =
        fun s => rationalSourceThetaScalar⁻¹ * mellin
          (traceTwistedBarProfile (9 * c) (mul_ne_zero (by norm_num) hc) (finiteThetaTwist c Ψ)) s := by
      funext s
      unfold finiteThetaBarProfile
      have hh := mellin_const_smul
        (traceTwistedBarProfile (9 * c) (mul_ne_zero (by norm_num) hc) (finiteThetaTwist c Ψ)) s
        rationalSourceThetaScalar⁻¹
      simp only [smul_eq_mul] at hh
      convert! hh using 1
    rw [he]
    exact hf.2.const_mul _

/-- The squarefree-times-cube Gauss series with its horizontal frequency weight. -/
def thetaDerivativeBesselProfile (Ψ : O →* ℂ) (v : ℝ) : ℂ :=
  ∑' p : ({I : Ideal O // Squarefree I ∧ primaryIdealGenerator I ≠ 0} ×
    {J : Ideal O // primaryIdealGenerator J ≠ 0}),
    ((‖ringComplex (primaryIdealGenerator p.2.val)‖ : ℂ) *
      normalizedCubicUnitGauss (primaryIdealGenerator p.1.val) *
      Ψ (primaryIdealGenerator p.1.val) * (Ψ (primaryIdealGenerator p.2.val)) ^ 3) *
      ((-2 * Real.pi * Complex.I * star (cuspFrequency (primaryIdealGenerator p.1.val *
        (primaryIdealGenerator p.2.val) ^ 3))) * (v : ℂ) * schlafliBesselK (1 / 3)
        (4 * Real.pi * ‖cuspFrequency (primaryIdealGenerator p.1.val *
          (primaryIdealGenerator p.2.val) ^ 3)‖ * v))

theorem finiteThetaBarProfile_eq_bessel (c : O) (hc : c ≠ 0)
    [Fintype (O ⧸ Ideal.span {9 * c})] (Ψ : (O ⧸ Ideal.span {c}) →* ℂ)
    (v : ℝ) (hv : 0 < v) :
    finiteThetaBarProfile c hc Ψ v =
      thetaDerivativeBesselProfile (Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom) v := by
  rw [finiteThetaBarProfile, traceTwistedBarProfile_positive _ _ _ _ hv]
  exact finiteThetaTwist_source_wirtingerBar c hc Ψ v hv

lemma mellin_entire_of_positive_eq (f g : ℝ → ℂ) (he : ∀ v, 0 < v → f v = g v)
    (hf : (∀ s : ℂ, MellinConvergent f s) ∧ Differentiable ℂ (mellin f)) :
    (∀ s : ℂ, MellinConvergent g s) ∧ Differentiable ℂ (mellin g) := by
  have hae : f =ᵐ[volume.restrict (Set.Ioi 0)] g := by
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with v hv
    exact he v hv
  have hm : mellin f = mellin g := by
    funext s
    apply integral_congr_ae
    filter_upwards [hae] with v hv
    rw [hv]
  refine ⟨?_, hm ▸ hf.2⟩
  intro s
  apply (hf.1 s).congr
  filter_upwards [hae] with v hv
  rw [hv]

/-- Finite arithmetic twists of the theta Gauss series have entire Mellin transforms. -/
theorem thetaDerivativeBesselProfile_mellin_entire (c : O) (hc : c ≠ 0)
    [Fintype (O ⧸ Ideal.span {9 * c})] (Ψ : (O ⧸ Ideal.span {c}) →* ℂ) :
    (∀ s : ℂ, MellinConvergent
      (thetaDerivativeBesselProfile (Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom)) s) ∧
      Differentiable ℂ (mellin
        (thetaDerivativeBesselProfile (Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom))) :=
  mellin_entire_of_positive_eq _ _ (finiteThetaBarProfile_eq_bessel c hc Ψ)
    (finiteThetaBarProfile_mellin_entire c hc Ψ)

/-- A finite cusp, its representative, and the matrix relating their coordinates. -/
structure SourceCuspDatum where
  gamma : rationalExtension
  index : Fin 3
  lower_ne_zero :
    (integralComplexMatrix (gamma : SL(2, O)) * integralComplexMatrix (cuspRepresentative index)) 1 0 ≠ 0

namespace SourceCuspDatum

def matrix (d : SourceCuspDatum) : SL(2, ℂ) :=
  integralComplexMatrix (d.gamma : SL(2, O)) * integralComplexMatrix (cuspRepresentative d.index)

def point (d : SourceCuspDatum) : ℂ := d.matrix 0 0 / d.matrix 1 0
def dualPoint (d : SourceCuspDatum) : ℂ := -d.matrix 1 1 / d.matrix 1 0
def heightScale (d : SourceCuspDatum) : ℝ := ‖d.matrix 1 0‖ ^ 2
def multiplier (d : SourceCuspDatum) : ℂ := -star (extendedComplexCharacter d.gamma) / (d.matrix 1 0) ^ 2

lemma heightScale_pos (d : SourceCuspDatum) : 0 < d.heightScale :=
  sq_pos_of_pos (norm_pos_iff.mpr d.lower_ne_zero)

lemma multiplier_norm (d : SourceCuspDatum) : ‖d.multiplier‖ = d.heightScale⁻¹ := by
  rw [multiplier, norm_div, norm_neg, norm_star, norm_extendedComplexCharacter, norm_pow, one_div]
  rfl

lemma multiplier_ne_zero (d : SourceCuspDatum) : d.multiplier ≠ 0 := by
  apply norm_ne_zero_iff.mp
  rw [d.multiplier_norm]
  exact inv_ne_zero d.heightScale_pos.ne'

end SourceCuspDatum

lemma exists_sourceCuspDatum (a c : O) (hc : c ≠ 0) :
    ∃ d : SourceCuspDatum, d.point = ringComplex a / ringComplex c := by
  obtain ⟨M, hMc, hratio⟩ := exists_integral_matrix_cusp_ratio a c hc
  obtain ⟨G, j, T, hT, _, _, hM⟩ := three_cusp_decomposition M
  let g := integralComplexMatrix (G : SL(2, O)) * integralComplexMatrix (cuspRepresentative j)
  have he : integralComplexMatrix M = g * integralComplexMatrix T := by rw [hM, map_mul, map_mul]
  have ht : integralComplexMatrix T 1 0 = 0 := by
    change ringComplex (T 1 0) = 0
    rw [hT, map_zero]
  have hmc : (g * integralComplexMatrix T) 1 0 ≠ 0 := by
    rw [← he]
    exact ringComplex_ne_zero hMc
  obtain ⟨hg, hr⟩ := upperTriangular_right_cusp_ratio g (integralComplexMatrix T) ht hmc
  refine ⟨⟨G, j, hg⟩, ?_⟩
  change g 0 0 / g 1 0 = _
  rw [← hr, ← he]
  exact hratio

def rationalSourceCusp (a c : O) (hc : c ≠ 0) : SourceCuspDatum :=
  (exists_sourceCuspDatum a c hc).choose

lemma rationalSourceCusp_point (a c : O) (hc : c ≠ 0) :
    (rationalSourceCusp a c hc).point = ringComplex a / ringComplex c :=
  (exists_sourceCuspDatum a c hc).choose_spec

def sourceCuspZFamily (j : Fin 3) (z : ℂ) : ℝ → ℂ :=
  cuspZProfile (fun w => star (cubicSourceResidualFunction
    (integralComplexMatrix (cuspRepresentative j) • w))) z

theorem SourceCuspDatum.reflection (d : SourceCuspDatum) (v : ℝ) (hv : 0 < v) :
    cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) d.point v =
      d.multiplier / (v : ℂ) ^ 2 * sourceCuspZFamily d.index d.dualPoint ((d.heightScale * v)⁻¹) := by
  have he := conjugateSource_barProfile_reflection_rational d.gamma d.matrix
    (integralComplexMatrix (cuspRepresentative d.index)) rfl d.lower_ne_zero v hv
  rw [reflectedCuspProfile, Complex.cpow_neg, Complex.cpow_ofNat] at he
  change _ = d.multiplier * (((v : ℂ) ^ 2)⁻¹ *
    sourceCuspZFamily d.index d.dualPoint ((d.heightScale * v)⁻¹)) at he
  exact he.trans (by ring)

theorem SourceCuspDatum.mellin_entire (d : SourceCuspDatum) :
    ((∀ s : ℂ, MellinConvergent
      (cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) d.point) s) ∧
      Differentiable ℂ (mellin (cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) d.point))) ∧
    ((∀ s : ℂ, MellinConvergent (sourceCuspZFamily d.index d.dualPoint) s) ∧
      Differentiable ℂ (mellin (sourceCuspZFamily d.index d.dualPoint))) :=
  conjugateSource_three_cusp_mellin_entire_both d.gamma d.index d.matrix rfl d.lower_ne_zero

theorem SourceCuspDatum.mellin_reflection (d : SourceCuspDatum) (s : ℂ) :
    mellin (cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) d.point) (2 * s) =
      d.multiplier * (d.heightScale : ℂ) ^ (2 - 2 * s) *
        mellin (sourceCuspZFamily d.index d.dualPoint) (2 - 2 * s) :=
  conjugateSource_cusp_mellin_reflection d.gamma d.matrix
    (integralComplexMatrix (cuspRepresentative d.index)) rfl d.lower_ne_zero s

def finiteTwistCusp (c : O) (hc : c ≠ 0) (h : O ⧸ Ideal.span {c}) : SourceCuspDatum :=
  rationalSourceCusp (-3 * Quotient.out h) c hc

lemma finiteTwistCusp_point (c : O) (hc : c ≠ 0) (h : O ⧸ Ideal.span {c}) :
    (finiteTwistCusp c hc h).point = thetaFourierTranslation c h := by
  rw [finiteTwistCusp, rationalSourceCusp_point, thetaFourierTranslation]
  simp only [map_mul, map_neg, map_ofNat]

/-- Every finite twist reflects into the three actual cusp profiles with exact weights. -/
theorem traceTwistedBarProfile_reflection (c : O) (hc : c ≠ 0)
    [Fintype (O ⧸ Ideal.span {c})] (φ : (O ⧸ Ideal.span {c}) → ℂ)
    (v : ℝ) (hv : 0 < v) :
    traceTwistedBarProfile c hc φ v =
      ∑ h, finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 c hc) φ h *
        ((finiteTwistCusp c hc h).multiplier / (v : ℂ) ^ 2 *
          sourceCuspZFamily (finiteTwistCusp c hc h).index (finiteTwistCusp c hc h).dualPoint
            (((finiteTwistCusp c hc h).heightScale * v)⁻¹)) := by
  unfold traceTwistedBarProfile
  apply Finset.sum_congr rfl
  intro h hh
  rw [← finiteTwistCusp_point c hc h, (finiteTwistCusp c hc h).reflection v hv]

/-- Factoring the ramified prime leaves a unit times a primary ideal generator. -/
lemma exists_unit_lambda_primary_factor (h : O) (hh : h ≠ 0) :
    ∃ (u : Oˣ) (m : ℕ) (I : Ideal O), primaryIdealGenerator I ≠ 0 ∧
      h = ((u : O) * lambda ^ m) * primaryIdealGenerator I := by
  obtain ⟨⟨m, I⟩, he⟩ := lambdaFactorEquiv.surjective
    (⟨Ideal.span {h}, Ideal.span_singleton_eq_bot.not.mpr hh⟩ : NonzeroIdeal)
  have hs : Ideal.span {lambda ^ m * primaryIdealGenerator I.val} = Ideal.span {h} :=
    (lambdaFactor_generator_span m I).trans (congrArg Subtype.val he)
  obtain ⟨x, hx⟩ := Ideal.span_singleton_le_span_singleton.mp hs.ge
  obtain ⟨y, hy⟩ := Ideal.span_singleton_le_span_singleton.mp hs.le
  have hxy : y * x = (1 : O) := by
    apply mul_left_cancel₀ hh
    calc
      h * (y * x) = (lambda ^ m * primaryIdealGenerator I.val) * x := by rw [hy]; ring
      _ = h := hx.symm
      _ = h * 1 := (mul_one h).symm
  let u : Oˣ := ⟨x, y, by simpa only [mul_comm] using hxy, hxy⟩
  refine ⟨u, m, I.val, I.property, ?_⟩
  change h = (x * lambda ^ m) * primaryIdealGenerator I.val
  rw [hx]
  ring

/-- Vanishing at prime exponents congruent to two forces squarefree-times-cube support. -/
lemma ramifiedFunction_valuation_ne_two (F : O → ℂ)
    (hzero : ∀ p : O, Prime p → lambda ^ 2 ∣ p - 1 →
      ∀ h : O, ¬ p ∣ h → ∀ k : ℕ, k % 3 = 2 → F (h * p ^ k) = 0)
    (I P : Ideal O) (hI : primaryIdealGenerator I ≠ 0) (hP : P ∈ normalizedFactors I)
    (u : Oˣ) (m : ℕ) (hF : F (((u : O) * lambda ^ m) * primaryIdealGenerator I) ≠ 0) :
    (normalizedFactors I).count P % 3 ≠ 2 := by
  have hI0 := primaryIdealGenerator_ne_zero_ideal I hI
  have hprime := prime_of_normalized_factor P hP
  let p := primaryIdealPrime P
  have hp0 : p ≠ 0 := primaryIdealPrime_factor_ne_zero I P hI hP
  have hps := primaryIdealPrime_spec P hp0
  have hp : Prime p := primaryIdealPrime_isPrime_of_mem I P hI (Multiset.mem_toFinset.mpr hP)
  obtain ⟨J, hJ, hnot⟩ := (FiniteMultiplicity.of_prime_left hprime hI0).exists_eq_pow_mul_and_not_dvd
  have hgen : primaryIdealGenerator I = p ^ (multiplicity P I) * primaryIdealGenerator J := by
    calc
      _ = primaryIdealGenerator (P ^ (multiplicity P I) * J) := congrArg primaryIdealGenerator hJ
      _ = _ := by
        rw [primaryIdealGenerator_mul, primaryIdealGenerator_pow]
        have he : primaryIdealGenerator P = p := by
          rw [← hps.2.2.1, primaryIdealGenerator_span p hp0 hps.2.2.2]
        rw [he]
  have hpd : ¬ p ∣ primaryIdealGenerator J := by
    intro hd
    have hgJ : primaryIdealGenerator J ≠ 0 := by
      intro hz
      exact hI (by rw [hgen, hz, mul_zero])
    apply hnot
    rw [Ideal.dvd_iff_le, ← hps.2.2.1, ← (primaryIdealGenerator_spec J hgJ).1,
      Ideal.span_singleton_le_span_singleton]
    exact hd
  have hbase : ¬ p ∣ ((u : O) * lambda ^ m) * primaryIdealGenerator J := by
    intro hd
    rcases hp.dvd_mul.mp hd with hd | hd
    · exact hp.2.1 ((ramified_primary_coprime u m p hps.2.2.2).of_mul_left_right.symm.isUnit_of_dvd hd)
    · exact hpd hd
  have hcount := multiplicity_eq_count_normalizedFactors hprime.irreducible hI0
  rw [normalize_normalized_factor P hP] at hcount
  intro hc
  have hm : (multiplicity P I) % 3 = 2 := by rwa [hcount]
  apply hF
  rw [hgen, show ((u : O) * lambda ^ m) * (p ^ (multiplicity P I) * primaryIdealGenerator J) =
    (((u : O) * lambda ^ m) * primaryIdealGenerator J) * p ^ (multiplicity P I) by ring]
  exact hzero p hp hps.2.2.2 _ hbase _ hm

theorem ramifiedFunction_squarefree_cube_support (F : O → ℂ)
    (hzero : ∀ p : O, Prime p → lambda ^ 2 ∣ p - 1 →
      ∀ h : O, ¬ p ∣ h → ∀ k : ℕ, k % 3 = 2 → F (h * p ^ k) = 0)
    (h : O) (hh : h ≠ 0) (hF : F h ≠ 0) :
    ∃ (u : Oˣ) (m : ℕ) (I J : Ideal O), Squarefree I ∧
      primaryIdealGenerator I ≠ 0 ∧ primaryIdealGenerator J ≠ 0 ∧
      h = ((u : O) * lambda ^ m) * primaryIdealGenerator I * (primaryIdealGenerator J) ^ 3 := by
  obtain ⟨u, m, T, hT, he⟩ := exists_unit_lambda_primary_factor h hh
  have hFT : F (((u : O) * lambda ^ m) * primaryIdealGenerator T) ≠ 0 := by rwa [← he]
  have hv : ∀ P ∈ normalizedFactors T, (normalizedFactors T).count P % 3 ≠ 2 :=
    fun P hP => ramifiedFunction_valuation_ne_two F hzero T P hT hP u m hFT
  have hparts := thetaParts_mul_cube T (primaryIdealGenerator_ne_zero_ideal T hT) hv
  have hgen : primaryIdealGenerator T = primaryIdealGenerator (thetaSquarefreePart T) *
      (primaryIdealGenerator (thetaCubePart T)) ^ 3 := by
    calc
      _ = primaryIdealGenerator (thetaSquarefreePart T * thetaCubePart T ^ 3) :=
        congrArg primaryIdealGenerator hparts.symm
      _ = _ := by rw [primaryIdealGenerator_mul, primaryIdealGenerator_pow]
  have hA : primaryIdealGenerator (thetaSquarefreePart T) ≠ 0 := by
    intro hz
    exact hT (by rw [hgen, hz, zero_mul])
  have hB : primaryIdealGenerator (thetaCubePart T) ≠ 0 := by
    intro hz
    exact hT (by rw [hgen, hz, zero_pow (by decide : (3 : ℕ) ≠ 0), mul_zero])
  refine ⟨u, m, thetaSquarefreePart T, thetaCubePart T, thetaSquarefreePart_squarefree T, hA, hB, ?_⟩
  rw [he, hgen]
  ring

lemma rationalSourceResidualFourierCoefficient_prime_power_vanish (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hph : ¬ p ∣ h) (k : ℕ) (hk : k % 3 = 2) :
    rationalSourceResidualFourierCoefficient (h * p ^ k) = 0 := by
  have hh : h ≠ 0 := fun hz => hph (hz ▸ dvd_zero p)
  rw [rationalSourceResidualFourierCoefficient_eq _ (mul_ne_zero hh (pow_ne_zero _ hp.ne_zero)),
    rationalSourceScatteringResidue_prime_power_table p hp hprimary h hph k, hk]
  norm_num

/-- All nonzero source frequencies have a unit, ramified, squarefree, and cube factorization. -/
theorem rationalSourceResidualFourierCoefficient_full_squarefree_cube_support
    (h : O) (hh : h ≠ 0) (hF : rationalSourceResidualFourierCoefficient h ≠ 0) :
    ∃ (u : Oˣ) (m : ℕ) (I J : Ideal O), Squarefree I ∧
      primaryIdealGenerator I ≠ 0 ∧ primaryIdealGenerator J ≠ 0 ∧
      h = ((u : O) * lambda ^ m) * primaryIdealGenerator I * (primaryIdealGenerator J) ^ 3 :=
  ramifiedFunction_squarefree_cube_support rationalSourceResidualFourierCoefficient
    rationalSourceResidualFourierCoefficient_prime_power_vanish h hh hF

theorem unramifiedCubicGaussSeries_lambda_pow (s : ℂ) (h : O) (n : ℕ) :
    unramifiedCubicGaussSeries s (h * lambda ^ n) =
      unramifiedCubicGaussSeries s (h * lambda ^ (n % 3)) := by
  apply tsum_congr
  intro I
  congr 1
  have hp := (primaryIdealGenerator_spec I.val I.property).2
  have hl : IsCoprime lambda (primaryIdealGenerator I.val) :=
    coprime_of_dvd_sub_one lambda _ ((show lambda ∣ lambda ^ 2 from ⟨lambda, by ring⟩).trans hp)
  have he : lambda ^ n = lambda ^ (n % 3) * (lambda ^ (n / 3)) ^ 3 := by
    rw [← pow_mul, ← pow_add]
    congr 1
    omega
  rw [he, ← mul_assoc]
  exact cubicUnitGaussSum_cube_shift _ _ _ I.property hp hl.symm.pow_right

/-- Ramified powers in the unramified Gauss residue depend only on their exponent modulo three. -/
theorem unramifiedGaussResidue_lambda_pow (h : O) (n : ℕ) :
    unramifiedGaussResidue (h * lambda ^ n) = unramifiedGaussResidue (h * lambda ^ (n % 3)) := by
  have he := unramifiedGaussResidue_of_initial_relation (h * lambda ^ n) (h * lambda ^ (n % 3)) 0
    (fun _ => 1) (fun _ => 0) (fun _ _ => analyticAt_const) (fun _ _ => analyticAt_const)
    continuousAt_const continuousAt_const (fun s _ _ => by
      simpa only [one_mul, zero_mul, add_zero] using unramifiedCubicGaussSeries_lambda_pow s h n)
  simpa only [one_mul, zero_mul, add_zero] using he

section
local instance : Finite Oˣ := cubic_units_finite
local instance : Fintype Oˣ := Fintype.ofFinite _

/-- A finite norm bound for all unit twists and ramified powers of one frequency. -/
def ramifiedResidueFamilyMass (h : O) : ℝ :=
  ∑ a : Oˣ × Fin 3, ‖unramifiedGaussResidue (h * (a.1 : O) * lambda ^ a.2.val)‖

lemma ramifiedResidueFamilyMass_nonneg (h : O) : 0 ≤ ramifiedResidueFamilyMass h :=
  Finset.sum_nonneg (fun _ _ => norm_nonneg _)

lemma unramifiedGaussResidue_family_norm_le (h : O) (u : Oˣ) (n : ℕ) :
    ‖unramifiedGaussResidue (h * (u : O) * lambda ^ n)‖ ≤ ramifiedResidueFamilyMass h := by
  rw [unramifiedGaussResidue_lambda_pow]
  exact Finset.single_le_sum (a := (u, ⟨n % 3, Nat.mod_lt _ (by norm_num)⟩))
    (s := Finset.univ) (f := fun a : Oˣ × Fin 3 =>
      ‖unramifiedGaussResidue (h * (a.1 : O) * lambda ^ a.2.val)‖)
    (fun _ _ => norm_nonneg _) (Finset.mem_univ _)

lemma unramifiedGaussResidue_unit_lambda_norm_le (u : Oˣ) (n : ℕ) :
    ‖unramifiedGaussResidue ((u : O) * lambda ^ n)‖ ≤ ramifiedResidueFamilyMass 1 := by
  simpa only [one_mul] using unramifiedGaussResidue_family_norm_le 1 u n

lemma ramifiedResidueFamilyMass_unit_lambda_le (u : Oˣ) (n : ℕ) :
    ramifiedResidueFamilyMass ((u : O) * lambda ^ n) ≤
      (Fintype.card (Oˣ × Fin 3) : ℝ) * ramifiedResidueFamilyMass 1 := by
  calc
    _ ≤ ∑ a : Oˣ × Fin 3, ramifiedResidueFamilyMass 1 := by
      apply Finset.sum_le_sum
      intro a ha
      have he : ((u : O) * lambda ^ n) * (a.1 : O) * lambda ^ a.2.val =
          ((u * a.1 : Oˣ) : O) * lambda ^ (n + a.2.val) := by
        rw [Units.val_mul, pow_add]
        ring
      rw [he]
      exact unramifiedGaussResidue_unit_lambda_norm_le _ _
    _ = _ := by simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]

end

lemma ramifiedNine_eq : (9 : O) = omega * lambda ^ 4 := by
  calc
    (9 : O) = 9 * omega ^ 3 := by rw [omega_primitive.pow_eq_one]; ring
    _ = omega * ((lambda ^ 2) ^ 2) := by rw [lambda_sq_eq]; ring
    _ = omega * lambda ^ 4 := by ring

lemma unramifiedGaussResidue_nine_norm_le (h : O) (u : Oˣ) (n : ℕ) :
    ‖unramifiedGaussResidue (9 * h * ((u : O) * lambda ^ n))‖ ≤ ramifiedResidueFamilyMass h := by
  have he : 9 * h * ((u : O) * lambda ^ n) = h * ((cuspOmegaUnit * u : Oˣ) : O) * lambda ^ (n + 4) := by
    rw [ramifiedNine_eq, Units.val_mul, cuspOmegaUnit_val, pow_add]
    ring
  rw [he]
  exact unramifiedGaussResidue_family_norm_le _ _ _

lemma rationalSourceResidualFourierCoefficient_prime_norm (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hph : ¬ p ∣ h) :
    ‖rationalSourceResidualFourierCoefficient (h * p)‖ = ‖rationalSourceResidualFourierCoefficient h‖ := by
  have hp9 := primary_prime_not_dvd_nine_frequency p hp hprimary h hph
  rw [rationalSourceResidualFourierCoefficient_prime_factor p hp hprimary h hph,
    norm_mul, norm_div, primeCubicGauss_two_eq_star p hp hprimary (9 * h) hp9, norm_star,
    cubicUnitGaussSum_prime_norm p hp hprimary (9 * h) hp9, Complex.norm_real,
    Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _),
    div_self (norm_ne_zero_iff.mpr (ringComplex_ne_zero hp.ne_zero)), one_mul]

lemma primeProduct_norm_of {ι : Type*} (F : O → ℂ)
    (hF : ∀ p : O, Prime p → lambda ^ 2 ∣ p - 1 → ∀ h : O, ¬ p ∣ h → ‖F (h * p)‖ = ‖F h‖)
    (s : Finset ι) (p : ι → O) (hp : ∀ i ∈ s, Prime (p i))
    (hprimary : ∀ i ∈ s, lambda ^ 2 ∣ p i - 1)
    (hpair : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → IsCoprime (p i) (p j))
    (h : O) (hph : ∀ i ∈ s, ¬ p i ∣ h) :
    ‖F (h * (∏ i ∈ s, p i))‖ = ‖F h‖ := by
  induction s using Finset.induction_on with
  | empty => simp only [Finset.prod_empty, mul_one]
  | @insert i s hi ih =>
    have hpi := hp i (Finset.mem_insert_self _ _)
    have hpri := hprimary i (Finset.mem_insert_self _ _)
    have hc : IsCoprime (p i) (∏ j ∈ s, p j) := IsCoprime.prod_right (fun j hj =>
      hpair i (Finset.mem_insert_self _ _) j (Finset.mem_insert_of_mem hj) (by intro he; subst j; exact hi hj))
    have hpb : ¬ p i ∣ h * (∏ j ∈ s, p j) := by
      intro hd
      rcases hpi.dvd_mul.mp hd with hd | hd
      · exact hph i (Finset.mem_insert_self _ _) hd
      · exact hpi.2.1 (hc.isUnit_of_dvd hd)
    rw [Finset.prod_insert hi, show h * (p i * (∏ j ∈ s, p j)) =
      (h * (∏ j ∈ s, p j)) * p i by ring, hF (p i) hpi hpri _ hpb]
    exact ih (fun j hj => hp j (Finset.mem_insert_of_mem hj))
      (fun j hj => hprimary j (Finset.mem_insert_of_mem hj))
      (fun j hj k hk hjk => hpair j (Finset.mem_insert_of_mem hj) k (Finset.mem_insert_of_mem hk) hjk)
      (fun j hj => hph j (Finset.mem_insert_of_mem hj))

/-- Removing the unramified squarefree part preserves coefficient norm; cubes contribute their absolute value. -/
theorem rationalSourceResidualFourierCoefficient_full_squarefree_cube_norm (I J : Ideal O)
    (hI : primaryIdealGenerator I ≠ 0) (hJ : primaryIdealGenerator J ≠ 0) (hsq : Squarefree I)
    (u : Oˣ) (m : ℕ) :
    ‖rationalSourceResidualFourierCoefficient
      (((u : O) * lambda ^ m) * primaryIdealGenerator I * (primaryIdealGenerator J) ^ 3)‖ =
      ‖ringComplex (primaryIdealGenerator J)‖ *
        ‖rationalSourceResidualFourierCoefficient ((u : O) * lambda ^ m)‖ := by
  rw [rationalSourceResidualFourierCoefficient_primary_cube _ hJ (primaryIdealGenerator_spec J hJ).2 _
    (mul_ne_zero (ramifiedElement_ne_zero u m) hI), norm_mul,
    Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
  congr 1
  rw [primaryIdealGenerator_squarefree_support I hI hsq]
  apply primeProduct_norm_of rationalSourceResidualFourierCoefficient
    rationalSourceResidualFourierCoefficient_prime_norm
  · exact fun P hP => primaryIdealPrime_isPrime_of_mem I P hI hP
  · exact fun P hP => (primaryIdealPrime_spec P
      (primaryIdealPrime_factor_ne_zero I P hI (Multiset.mem_toFinset.mp hP))).2.2.2
  · exact primaryIdealPrime_support_coprime I hI
  · intro P hP hd
    have hp := primaryIdealPrime_isPrime_of_mem I P hI hP
    have hpp := (primaryIdealPrime_spec P
      (primaryIdealPrime_factor_ne_zero I P hI (Multiset.mem_toFinset.mp hP))).2.2.2
    exact hp.2.1 ((ramified_primary_coprime u m _ hpp).of_mul_left_right.symm.isUnit_of_dvd hd)

lemma mellin_finiteLinearCombination {ι : Type*} [Fintype ι]
    (weight : ι → ℂ) (f : ι → ℝ → ℂ) (s : ℂ) (hc : ∀ i, MellinConvergent (f i) s) :
    mellin (fun v => ∑ i, weight i * f i v) s = ∑ i, weight i * mellin (f i) s := by
  have hi (i : ι) : Integrable (fun v : ℝ => (v : ℂ) ^ (s - 1) * (weight i * f i v))
      (volume.restrict (Set.Ioi 0)) := by
    have hh := (hc i).const_smul (weight i)
    simp only [MellinConvergent, smul_eq_mul, IntegrableOn] at hh
    convert! hh using 1
  unfold mellin
  simp only [smul_eq_mul, Finset.mul_sum]
  rw [integral_finsetSum _ (fun i _ => hi i)]
  apply Finset.sum_congr rfl
  intro i hi
  rw [← integral_const_mul]
  exact integral_congr_ae (Eventually.of_forall (fun v => by ring))

/-- Mellin reflection of a finite arithmetic twist, with all dual cusp transforms entire. -/
theorem traceTwistedBarProfile_mellin_reflection (c : O) (hc : c ≠ 0)
    [Fintype (O ⧸ Ideal.span {c})] (φ : (O ⧸ Ideal.span {c}) → ℂ) (s : ℂ) :
    mellin (traceTwistedBarProfile c hc φ) (2 * s) =
      ∑ h, finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 c hc) φ h *
        ((finiteTwistCusp c hc h).multiplier * ((finiteTwistCusp c hc h).heightScale : ℂ) ^ (2 - 2 * s) *
          mellin (sourceCuspZFamily (finiteTwistCusp c hc h).index (finiteTwistCusp c hc h).dualPoint) (2 - 2 * s)) := by
  change mellin (fun v => ∑ h, finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 c hc) φ h *
    cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) (thetaFourierTranslation c h) v) (2 * s) = _
  rw [mellin_finiteLinearCombination
    (finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 c hc) φ)
    (fun h => cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) (thetaFourierTranslation c h))
    (2 * s) (fun h => (conjugateSource_finite_twist_cusp_mellin_entire (Quotient.out h) c hc).1 (2 * s))]
  apply Finset.sum_congr rfl
  intro h hh
  rw [← finiteTwistCusp_point c hc h, (finiteTwistCusp c hc h).mellin_reflection s]

lemma arithmeticResidueSum_ramified_norm_le (h : O) (u : Oˣ) (n : ℕ) (hn : 2 ≤ n) :
    ‖arithmeticResidueSum h ((u : O) * lambda ^ n)‖ ≤ (3 : ℝ) ^ n := by
  by_cases hz : arithmeticResidueSum h ((u : O) * lambda ^ n) = 0
  · rw [hz, norm_zero]
    positivity
  obtain ⟨k, hk⟩ := ramified_arithmetic_support h u n hn hz
  rw [ramified_arithmetic_character_test h k u n hn hk]
  split_ifs
  · rw [norm_mul, Complex.norm_natCast]
    have he : ‖residueAdditive k 3 1‖ = 1 := tracePhase_norm _
    rw [he, mul_one, Nat.cast_pow, Nat.cast_ofNat]
  · rw [norm_zero]
    positivity

lemma arithmeticResidueSum_norm_mul_primary (h b : O) (hb : lambda ^ 2 ∣ b - 1)
    (u : Oˣ) (n : ℕ) (hn : 2 ≤ n) :
    ‖arithmeticResidueSum (h * b) ((u : O) * lambda ^ n)‖ =
      ‖arithmeticResidueSum h ((u : O) * lambda ^ n)‖ := by
  have hc : IsCoprime ((u : O) * lambda ^ n) b := (ramified_primary_coprime u n b hb).of_mul_left_right
  have he := congrArg norm (arithmeticResidueSum_frequency_twist h ((u : O) * lambda ^ n) b
    (ramifiedElement_ne_zero u n) (ramifiedElement_level u n hn) ⟨hc, three_dvd_lambda_sq.trans hb⟩)
  simpa only [norm_mul, symbol_norm_one _ b hb hc, one_mul] using he

lemma ramifiedQuotientChar_mk (u : Oˣ) (n : ℕ) (x : O) :
    ramifiedQuotientChar u n (Ideal.Quotient.mk (Ideal.span {(3 : O)}) x) =
      ringComplex (symbol ((u : O) * lambda ^ n) (1 + 3 * x)) :=
  principalQuotientAddChar_mk 3 _ _ x

lemma ramifiedQuotientChar_apply_cube (u : Oˣ) (n : ℕ) (x : O ⧸ Ideal.span {(3 : O)}) :
    (ramifiedQuotientChar u n x) ^ 3 = 1 := by
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [ramifiedQuotientChar_mk, ← map_pow,
    symbol_cube_of_isCoprime _ _ (lambda_sq_dvd_three.trans ⟨x, by ring⟩)
      (ramified_denominator_condition u n (1 + 3 * x) ⟨x, by ring⟩).1, map_one]

/-- Both signs can survive the ramified Fourier test only when the symbol character is trivial. -/
lemma ramifiedQuotientChar_eq_one_of_both_signs (h : O) (u : Oˣ) (n : ℕ) (hn : 2 ≤ n)
    (ha : arithmeticResidueSum h ((u : O) * lambda ^ n) ≠ 0)
    (hb : arithmeticResidueSum h (((-u : Oˣ) : O) * lambda ^ n) ≠ 0) :
    ramifiedQuotientChar u n = 1 := by
  obtain ⟨k, hk⟩ := ramified_arithmetic_support h u n hn ha
  have hk' : 3 * h = (((-u : Oˣ) : O) * lambda ^ n) * (-k) := by
    simp only [Units.val_neg, neg_mul, mul_neg, neg_neg]
    exact hk
  have hpos : ramifiedFrequencyChar k u n = 1 := by
    by_contra hc
    exact ha (by rw [ramified_arithmetic_character_test h k u n hn hk, if_neg hc])
  have hneg : ramifiedFrequencyChar (-k) u n = 1 := by
    by_contra hc
    exact hb (by rw [ramified_arithmetic_character_test h (-k) (-u) n hn hk',
      ramifiedFrequencyChar_neg_unit, if_neg hc])
  ext x
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
  have hp := congrArg (fun χ : AddChar (O ⧸ Ideal.span {(3 : O)}) ℂ => χ (Ideal.Quotient.mk _ x)) hpos
  have hm := congrArg (fun χ : AddChar (O ⧸ Ideal.span {(3 : O)}) ℂ => χ (Ideal.Quotient.mk _ x)) hneg
  change ramifiedQuotientChar u n (Ideal.Quotient.mk _ x) *
    residueTraceQuotientChar k 3 (by norm_num) (Ideal.Quotient.mk _ x) = 1 at hp
  change ramifiedQuotientChar u n (Ideal.Quotient.mk _ x) *
    residueTraceQuotientChar (-k) 3 (by norm_num) (Ideal.Quotient.mk _ x) = 1 at hm
  rw [residueTraceQuotientChar_three_phase] at hp hm
  rw [cuspFrequency_neg, neg_mul] at hm
  have ht : tracePhase (cuspFrequency k * ringComplex x) * tracePhase (-(cuspFrequency k * ringComplex x)) = 1 := by
    rw [← AddChar.map_add_eq_mul, add_neg_cancel, AddChar.map_zero_eq_one]
  let q := ramifiedQuotientChar u n (Ideal.Quotient.mk (Ideal.span {(3 : O)}) x)
  have hq : q ^ 2 = 1 := by
    calc
      _ = q ^ 2 * (tracePhase (cuspFrequency k * ringComplex x) * tracePhase (-(cuspFrequency k * ringComplex x))) :=
        by rw [ht, mul_one]
      _ = (q * tracePhase (cuspFrequency k * ringComplex x)) *
          (q * tracePhase (-(cuspFrequency k * ringComplex x))) := by ring
      _ = 1 := by rw [hp, hm, one_mul]
  change q = 1
  calc
    q = q ^ 2 * q := by rw [hq, one_mul]
    _ = q ^ 3 := by ring
    _ = 1 := ramifiedQuotientChar_apply_cube u n _

lemma ramifiedQuotientChar_omegaUnit_one (j n : ℕ) :
    ramifiedQuotientChar (cuspOmegaUnit ^ j) n (Ideal.Quotient.mk _ (1 : O)) =
      ringComplex ((omega ^ 2) ^ j * omega ^ n) := by
  have hp : lambda ^ 2 ∣ (1 + 3 * (1 : O)) - 1 := lambda_sq_dvd_three.trans ⟨1, by ring⟩
  have harg : 1 + 3 * (1 : O) = primaryCoord 1 0 := by rw [primaryCoord_eq]; ring
  have ho : symbol omega (1 + 3 * (1 : O)) = omega ^ 2 := by
    rw [symbol_omega_eq_linearRay _ hp]
    rw [harg, linearRay_primaryCoord]
    norm_num [cubicExp]
    rfl
  have hl : symbol lambda (1 + 3 * (1 : O)) = omega := by
    rw [symbol_lambda_eq_linearRay _ hp]
    rw [harg, linearRay_primaryCoord]
    norm_num [cubicExp]
  rw [ramifiedQuotientChar_mk, Units.val_pow_eq_pow_val, cuspOmegaUnit_val,
    symbol_mul_numerator, symbol_pow_numerator _ _ hp,
    symbol_pow_numerator _ _ hp, ho, hl]

lemma ramifiedQuotientChar_omegaUnit_omega (j n : ℕ) :
    ramifiedQuotientChar (cuspOmegaUnit ^ j) n (Ideal.Quotient.mk _ omega) =
      ringComplex ((omega ^ 2) ^ j) := by
  have hp : lambda ^ 2 ∣ (1 + 3 * omega) - 1 := lambda_sq_dvd_three.trans ⟨omega, by ring⟩
  have harg : 1 + 3 * omega = primaryCoord 0 1 := by rw [primaryCoord_eq]; ring
  have ho : symbol omega (1 + 3 * omega) = omega ^ 2 := by
    rw [symbol_omega_eq_linearRay _ hp]
    rw [harg, linearRay_primaryCoord]
    norm_num [cubicExp]
    rfl
  have hl : symbol lambda (1 + 3 * omega) = 1 := by
    rw [symbol_lambda_eq_linearRay _ hp]
    rw [harg, linearRay_primaryCoord]
    norm_num [cubicExp]
  rw [ramifiedQuotientChar_mk, Units.val_pow_eq_pow_val, cuspOmegaUnit_val,
    symbol_mul_numerator, symbol_pow_numerator _ _ hp,
    symbol_pow_numerator _ _ hp, ho, hl, one_pow, mul_one]

/-- The ramified symbol character is trivial only for a real unit and an exponent divisible by three. -/
lemma ramifiedQuotientChar_trivial_exponents (j : Fin 3) (n : ℕ)
    (hchar : ramifiedQuotientChar (cuspOmegaUnit ^ j.val) n = 1) : j = 0 ∧ n % 3 = 0 := by
  have he := congrArg (fun χ : AddChar (O ⧸ Ideal.span {(3 : O)}) ℂ => χ (Ideal.Quotient.mk _ omega)) hchar
  rw [ramifiedQuotientChar_omegaUnit_omega, AddChar.one_apply] at he
  have hpow : (omega ^ 2) ^ j.val = 1 := ringComplex_injective (by simpa only [map_one] using he)
  have hj : j = 0 := by
    fin_cases j
    · rfl
    · have hs : omega ^ 2 = 1 := by simpa only [pow_one] using hpow
      have how : omega = 1 := by
        calc
          omega = omega ^ 2 * omega := by rw [hs, one_mul]
          _ = omega ^ 3 := by ring
          _ = 1 := omega_primitive.pow_eq_one
      exact (omega_primitive.ne_one (by decide) how).elim
    · have how : omega = 1 := by
        rw [show (omega ^ 2) ^ 2 = omega ^ 3 * omega by ring,
          omega_primitive.pow_eq_one, one_mul] at hpow
        exact hpow
      exact (omega_primitive.ne_one (by decide) how).elim
  refine ⟨hj, ?_⟩
  have he1 := congrArg (fun χ : AddChar (O ⧸ Ideal.span {(3 : O)}) ℂ => χ (Ideal.Quotient.mk _ (1 : O))) hchar
  rw [ramifiedQuotientChar_omegaUnit_one, AddChar.one_apply, hj] at he1
  simp only [Fin.val_zero, pow_zero, one_mul] at he1
  have hn : omega ^ n = omega ^ 0 := ringComplex_injective (by simpa only [pow_zero, map_one] using he1)
  have hm := ((omega_primitive.isOfFinOrder (by decide)).pow_inj_mod).mp hn
  rw [← omega_primitive.eq_orderOf] at hm
  simpa only [Nat.zero_mod] using hm

lemma ramifiedQuotientChar_neg_unit (u : Oˣ) (n : ℕ) :
    ramifiedQuotientChar (-u) n = ramifiedQuotientChar u n := by
  ext x
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [ramifiedQuotientChar_mk, ramifiedQuotientChar_mk, Units.val_neg, neg_mul,
    symbol_neg_numerator _ _ (lambda_sq_dvd_three.trans ⟨x, by ring⟩)]

lemma ramifiedQuotientChar_two_ne_one (u : Oˣ) : ramifiedQuotientChar u 2 ≠ 1 := by
  obtain ⟨j, hj | hj⟩ := unit_eq_sign_omega u
  · have hu : u = cuspOmegaUnit ^ j.val := Units.ext (by simpa only [Units.val_pow_eq_pow_val, cuspOmegaUnit_val] using hj)
    rw [hu]
    intro hchar
    have hm := (ramifiedQuotientChar_trivial_exponents j 2 hchar).2
    norm_num at hm
  · have hu : u = -(cuspOmegaUnit ^ j.val) := Units.ext (by
      simpa only [Units.val_neg, Units.val_pow_eq_pow_val, cuspOmegaUnit_val] using hj)
    rw [hu, ramifiedQuotientChar_neg_unit]
    intro hchar
    have hm := (ramifiedQuotientChar_trivial_exponents j 2 hchar).2
    norm_num at hm

lemma residueTraceQuotientChar_eq_one_of_three_dvd (k : O) (hk : (3 : O) ∣ k) :
    residueTraceQuotientChar k 3 (by norm_num) = 1 := by
  rw [residueTraceQuotientChar_mulShift]
  have he : Ideal.Quotient.mk (Ideal.span {(3 : O)}) k = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton.mpr hk)
  rw [he, AddChar.mulShift_zero]

/-- At frequencies divisible by three, the smallest ramified conductor contributes nothing. -/
lemma arithmeticResidueSum_lambda_sq_zero (h : O) (hh : (3 : O) ∣ h) (u : Oˣ) :
    arithmeticResidueSum h ((u : O) * lambda ^ 2) = 0 := by
  by_contra ha
  obtain ⟨k, hk⟩ := ramified_arithmetic_support h u 2 le_rfl ha
  let t : Oˣ := -(u * cuspOmegaUnit)
  have ht : (u : O) * lambda ^ 2 = 3 * (t : O) := by
    simp only [t, lambda_sq_eq, Units.val_neg, Units.val_mul, cuspOmegaUnit_val]
    ring
  rw [ht, mul_assoc] at hk
  have he : h = (t : O) * k := mul_left_cancel₀ (by norm_num : (3 : O) ≠ 0) hk
  have hdk : (3 : O) ∣ k := by
    have hd := dvd_mul_of_dvd_right hh (↑t⁻¹ : O)
    simpa [he, ← mul_assoc] using hd
  have hchar : ramifiedFrequencyChar k u 2 = 1 := by
    by_contra hc
    apply ha
    rw [ramified_arithmetic_character_test h k u 2 le_rfl (by rw [ht, mul_assoc]; exact hk), if_neg hc]
  rw [ramifiedFrequencyChar, residueTraceQuotientChar_eq_one_of_three_dvd k hdk, mul_one] at hchar
  exact ramifiedQuotientChar_two_ne_one u hchar

def lowRamifiedFrequency (a r : Fin 3) : O := omega ^ a.val * lambda ^ (r.val + 2)

lemma lowRamifiedFrequency_ne_zero (a r : Fin 3) : lowRamifiedFrequency a r ≠ 0 := by
  simpa only [lowRamifiedFrequency, Units.val_pow_eq_pow_val, cuspOmegaUnit_val] using
    ramifiedElement_ne_zero (cuspOmegaUnit ^ a.val) (r.val + 2)

lemma lowRamifiedFrequency_absNorm (a r : Fin 3) :
    Ideal.absNorm (Ideal.span {lowRamifiedFrequency a r}) = 3 ^ (r.val + 2) := by
  simpa only [lowRamifiedFrequency, Units.val_pow_eq_pow_val, cuspOmegaUnit_val] using
    ramifiedElement_absNorm (cuspOmegaUnit ^ a.val) (r.val + 2)

lemma lowRamifiedFrequency_three_dvd (a r : Fin 3) : (3 : O) ∣ lowRamifiedFrequency a r := by
  simpa only [lowRamifiedFrequency, Units.val_pow_eq_pow_val, cuspOmegaUnit_val] using
    ramifiedElement_level (cuspOmegaUnit ^ a.val) (r.val + 2) (by omega)

lemma lowRamifiedFrequency_arithmetic_vanish (a r : Fin 3) (u : Oˣ) (k : ℕ) (hk : 5 ≤ k) :
    arithmeticResidueSum (lowRamifiedFrequency a r) ((u : O) * lambda ^ (k + 2)) = 0 := by
  by_contra hA
  have hb := ramified_arithmetic_norm_bound _ (lowRamifiedFrequency_ne_zero a r) u (k + 2) (by omega) hA
  rw [lowRamifiedFrequency_absNorm] at hb
  have hlo : (3 : ℕ) ^ 7 ≤ 3 ^ (k + 2) := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hhi : (3 : ℕ) ^ (r.val + 2) ≤ 3 ^ 4 := Nat.pow_le_pow_right (by norm_num) (by omega)
  norm_num at hlo hhi
  omega

lemma lowRamifiedFrequency_primary_vanish (a r : Fin 3) (b : O) (hb : lambda ^ 2 ∣ b - 1)
    (u : Oˣ) (k : ℕ) (hk : 5 ≤ k) :
    arithmeticResidueSum (lowRamifiedFrequency a r * b) ((u : O) * lambda ^ (k + 2)) = 0 := by
  apply norm_eq_zero.mp
  rw [arithmeticResidueSum_norm_mul_primary _ b hb u (k + 2) (by omega),
    lowRamifiedFrequency_arithmetic_vanish a r u k hk, norm_zero]

def signedOmegaUnit (p : Bool × Fin 3) : Oˣ :=
  if p.1 then -(cuspOmegaUnit ^ p.2.val) else cuspOmegaUnit ^ p.2.val

lemma omega_pow_fin_injective : Function.Injective (fun j : Fin 3 => omega ^ j.val) := by
  intro j k he
  have hm := ((omega_primitive.isOfFinOrder (by decide)).pow_inj_mod).mp he
  rw [← omega_primitive.eq_orderOf, Nat.mod_eq_of_lt j.isLt, Nat.mod_eq_of_lt k.isLt] at hm
  exact Fin.ext hm

lemma signedOmegaUnit_injective : Function.Injective signedOmegaUnit := by
  rintro ⟨s, j⟩ ⟨t, k⟩ he
  have hv := congrArg (fun u : Oˣ => (u : O)) he
  cases s <;> cases t
  · simp only [signedOmegaUnit, Bool.false_eq_true, if_false, Units.val_pow_eq_pow_val, cuspOmegaUnit_val] at hv
    exact congrArg (fun i : Fin 3 => (false, i)) (omega_pow_fin_injective hv)
  · simp only [signedOmegaUnit, Bool.false_eq_true, if_false, if_true, Units.val_neg,
      Units.val_pow_eq_pow_val, cuspOmegaUnit_val] at hv
    exact (halfPrimary_not_negative k.val (hv ▸ halfPrimary_omega_pow j.val)).elim
  · simp only [signedOmegaUnit, Bool.false_eq_true, if_false, if_true, Units.val_neg,
      Units.val_pow_eq_pow_val, cuspOmegaUnit_val] at hv
    exact (halfPrimary_not_negative j.val (hv.symm ▸ halfPrimary_omega_pow k.val)).elim
  · simp only [signedOmegaUnit, if_true, Units.val_neg, Units.val_pow_eq_pow_val, cuspOmegaUnit_val] at hv
    exact congrArg (fun i : Fin 3 => (true, i)) (omega_pow_fin_injective (neg_injective hv))

lemma signedOmegaUnit_surjective : Function.Surjective signedOmegaUnit := by
  intro u
  obtain ⟨j, hj | hj⟩ := unit_eq_sign_omega u
  · refine ⟨(false, j), Units.ext ?_⟩
    simpa only [signedOmegaUnit, Bool.false_eq_true, if_false, Units.val_pow_eq_pow_val, cuspOmegaUnit_val] using hj.symm
  · refine ⟨(true, j), Units.ext ?_⟩
    simpa only [signedOmegaUnit, if_true, Units.val_neg, Units.val_pow_eq_pow_val, cuspOmegaUnit_val] using hj.symm

def signedOmegaEquiv : Bool × Fin 3 ≃ Oˣ :=
  Equiv.ofBijective signedOmegaUnit ⟨signedOmegaUnit_injective, signedOmegaUnit_surjective⟩

lemma ramifiedQuotientChar_omegaUnit_ne_one (j : Fin 3) (n : ℕ) (hj : j ≠ 0) :
    ramifiedQuotientChar (cuspOmegaUnit ^ j.val) n ≠ 1 :=
  fun he => hj (ramifiedQuotientChar_trivial_exponents j n he).1

lemma ramifiedQuotientChar_omegaUnit_ne_one_of_mod (j : Fin 3) (n : ℕ) (hn : n % 3 ≠ 0) :
    ramifiedQuotientChar (cuspOmegaUnit ^ j.val) n ≠ 1 :=
  fun he => hn (ramifiedQuotientChar_trivial_exponents j n he).2

lemma arithmeticResidueSum_sign_pair_norm_le (h : O) (u : Oˣ) (n : ℕ) (hn : 2 ≤ n)
    (hchar : ramifiedQuotientChar u n ≠ 1) :
    ‖arithmeticResidueSum h ((u : O) * lambda ^ n)‖ +
      ‖arithmeticResidueSum h (((-u : Oˣ) : O) * lambda ^ n)‖ ≤ (3 : ℝ) ^ n := by
  by_cases ha : arithmeticResidueSum h ((u : O) * lambda ^ n) = 0
  · rw [ha, norm_zero, zero_add]
    exact arithmeticResidueSum_ramified_norm_le h (-u) n hn
  by_cases hb : arithmeticResidueSum h (((-u : Oˣ) : O) * lambda ^ n) = 0
  · rw [hb, norm_zero, add_zero]
    exact arithmeticResidueSum_ramified_norm_le h u n hn
  exact (hchar (ramifiedQuotientChar_eq_one_of_both_signs h u n hn ha hb)).elim

def ramifiedDecayRatio : ℝ := (3 : ℝ) ^ (-(1 / 3 : ℝ))

lemma ramifiedDecayRatio_pos : 0 < ramifiedDecayRatio := Real.rpow_pos_of_pos (by norm_num) _

lemma ramifiedDecayRatio_cube : ramifiedDecayRatio ^ 3 = (1 / 3 : ℝ) := by
  rw [ramifiedDecayRatio, ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 3)]
  norm_num

lemma ramifiedDecayRatio_le_seven_tenths : ramifiedDecayRatio ≤ 7 / 10 := by
  by_contra hn
  have hh : 7 / 10 < ramifiedDecayRatio := lt_of_not_ge hn
  have hp : 0 < (ramifiedDecayRatio - 7 / 10) *
      (ramifiedDecayRatio ^ 2 + (7 / 10) * ramifiedDecayRatio + 49 / 100) :=
    mul_pos (sub_pos.mpr hh) (by have := ramifiedDecayRatio_pos; positivity)
  nlinarith only [hp, ramifiedDecayRatio_cube]

lemma ramifiedWeight_norm_scalar (n : ℕ) :
    ‖((3 ^ n : ℕ) : ℂ) ^ (-(4 / 3 : ℂ))‖ * (3 : ℝ) ^ n = ramifiedDecayRatio ^ n := by
  have hcast : ((3 ^ n : ℕ) : ℂ) = (((3 : ℝ) ^ n : ℝ) : ℂ) := by norm_cast
  have hp : 0 < (3 : ℝ) ^ n := pow_pos (by norm_num) _
  rw [hcast, Complex.norm_cpow_eq_rpow_re_of_pos hp,
    show (-(4 / 3 : ℂ)).re = -(4 / 3 : ℝ) by norm_num]
  calc
    _ = ((3 : ℝ) ^ n) ^ (-(1 / 3 : ℝ)) := by
      nth_rw 2 [← Real.rpow_one ((3 : ℝ) ^ n)]
      rw [← Real.rpow_add hp]
      congr 1
      norm_num
    _ = _ := by
      rw [← Real.rpow_natCast_mul (by norm_num : (0 : ℝ) ≤ 3), ramifiedDecayRatio,
        ← Real.rpow_natCast ((3 : ℝ) ^ (-(1 / 3 : ℝ))) n,
        ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 3)]
      congr 1
      ring

def ramifiedRawWeight (h : O) (u : Oˣ) (k : ℕ) : ℂ :=
  ((3 ^ (k + 2) : ℕ) : ℂ) ^ (-(4 / 3 : ℂ)) * arithmeticResidueSum h ((u : O) * lambda ^ (k + 2))

lemma ramifiedRawWeight_norm_le (h : O) (u : Oˣ) (k : ℕ) :
    ‖ramifiedRawWeight h u k‖ ≤ ramifiedDecayRatio ^ (k + 2) := by
  rw [ramifiedRawWeight, norm_mul]
  exact (mul_le_mul_of_nonneg_left (arithmeticResidueSum_ramified_norm_le h u (k + 2) (by omega))
    (norm_nonneg _)).trans_eq (ramifiedWeight_norm_scalar _)

lemma ramifiedRawWeight_sign_pair_norm_le (h : O) (u : Oˣ) (k : ℕ)
    (hchar : ramifiedQuotientChar u (k + 2) ≠ 1) :
    ‖ramifiedRawWeight h u k‖ + ‖ramifiedRawWeight h (-u) k‖ ≤ ramifiedDecayRatio ^ (k + 2) := by
  rw [ramifiedRawWeight, ramifiedRawWeight, norm_mul, norm_mul, ← mul_add]
  exact (mul_le_mul_of_nonneg_left (arithmeticResidueSum_sign_pair_norm_le h u (k + 2) (by omega) hchar)
    (norm_nonneg _)).trans_eq (ramifiedWeight_norm_scalar _)

lemma ramifiedRawWeight_norm_mul_primary (h b : O) (hb : lambda ^ 2 ∣ b - 1) (u : Oˣ) (k : ℕ) :
    ‖ramifiedRawWeight (h * b) u k‖ = ‖ramifiedRawWeight h u k‖ := by
  simp only [ramifiedRawWeight, norm_mul, arithmeticResidueSum_norm_mul_primary h b hb u (k + 2) (by omega)]

lemma ramifiedRawWeight_zero_of_three_dvd (h : O) (hh : (3 : O) ∣ h) (u : Oˣ) :
    ramifiedRawWeight h u 0 = 0 := by
  rw [ramifiedRawWeight, zero_add, arithmeticResidueSum_lambda_sq_zero h hh u, mul_zero]

section
local instance : Finite Oˣ := cubic_units_finite
local instance : Fintype Oˣ := Fintype.ofFinite _

lemma ramifiedRawWeight_unit_sum (h : O) (k : ℕ) :
    (∑ u : Oˣ, ‖ramifiedRawWeight h u k‖) =
      ∑ j : Fin 3, (‖ramifiedRawWeight h (cuspOmegaUnit ^ j.val) k‖ +
        ‖ramifiedRawWeight h (-(cuspOmegaUnit ^ j.val)) k‖) := by
  have he := Fintype.sum_equiv signedOmegaEquiv
    (fun p : Bool × Fin 3 => ‖ramifiedRawWeight h (signedOmegaUnit p) k‖)
    (fun u : Oˣ => ‖ramifiedRawWeight h u k‖) (fun _ => rfl)
  rw [← he]
  simp [signedOmegaUnit, Fintype.sum_prod_type, Finset.sum_add_distrib, add_comm]

lemma ramifiedRawWeight_unit_sum_le_four (h : O) (k : ℕ) :
    (∑ u : Oˣ, ‖ramifiedRawWeight h u k‖) ≤ 4 * ramifiedDecayRatio ^ (k + 2) := by
  have h0 : ‖ramifiedRawWeight h (cuspOmegaUnit ^ (0 : Fin 3).val) k‖ +
      ‖ramifiedRawWeight h (-(cuspOmegaUnit ^ (0 : Fin 3).val)) k‖ ≤
        2 * ramifiedDecayRatio ^ (k + 2) := by
    have hh := add_le_add (ramifiedRawWeight_norm_le h (cuspOmegaUnit ^ 0) k)
      (ramifiedRawWeight_norm_le h (-(cuspOmegaUnit ^ 0)) k)
    convert! hh using 1 <;> simp only [Fin.val_zero, two_mul]
  have h1 := ramifiedRawWeight_sign_pair_norm_le h (cuspOmegaUnit ^ (1 : Fin 3).val) k
    (ramifiedQuotientChar_omegaUnit_ne_one 1 (k + 2) (by decide))
  have h2 := ramifiedRawWeight_sign_pair_norm_le h (cuspOmegaUnit ^ (2 : Fin 3).val) k
    (ramifiedQuotientChar_omegaUnit_ne_one 2 (k + 2) (by decide))
  rw [ramifiedRawWeight_unit_sum, Fin.sum_univ_three]
  linarith only [h0, h1, h2]

lemma ramifiedRawWeight_unit_sum_le_three (h : O) (k : ℕ) (hk : (k + 2) % 3 ≠ 0) :
    (∑ u : Oˣ, ‖ramifiedRawWeight h u k‖) ≤ 3 * ramifiedDecayRatio ^ (k + 2) := by
  rw [ramifiedRawWeight_unit_sum]
  calc
    _ ≤ ∑ j : Fin 3, ramifiedDecayRatio ^ (k + 2) := Finset.sum_le_sum (fun j _ =>
      ramifiedRawWeight_sign_pair_norm_le h (cuspOmegaUnit ^ j.val) k
        (ramifiedQuotientChar_omegaUnit_ne_one_of_mod j (k + 2) hk))
    _ = _ := by simp

/-- Sign-pair orthogonality makes the finite ramified remainder smaller than its leading coefficient. -/
theorem lowRamifiedRawWeight_sum (a r : Fin 3) (b : O) (hb : lambda ^ 2 ∣ b - 1) :
    (∑ u : Oˣ, ∑ k : Fin 5, ‖ramifiedRawWeight (lowRamifiedFrequency a r * b) u k.val‖) ≤ 2671 / 900 := by
  simp_rw [ramifiedRawWeight_norm_mul_primary _ b hb]
  let h := lowRamifiedFrequency a r
  have hzero : (∑ u : Oˣ, ‖ramifiedRawWeight h u 0‖) = 0 := by
    apply Finset.sum_eq_zero
    intro u hu
    rw [ramifiedRawWeight_zero_of_three_dvd h (lowRamifiedFrequency_three_dvd a r) u, norm_zero]
  have h1 := ramifiedRawWeight_unit_sum_le_four h 1
  have h2 := ramifiedRawWeight_unit_sum_le_three h 2 (by norm_num)
  have h3 := ramifiedRawWeight_unit_sum_le_three h 3 (by norm_num)
  have h4 := ramifiedRawWeight_unit_sum_le_four h 4
  change (∑ u : Oˣ, ‖ramifiedRawWeight h u 1‖) ≤ 4 * ramifiedDecayRatio ^ 3 at h1
  change (∑ u : Oˣ, ‖ramifiedRawWeight h u 2‖) ≤ 3 * ramifiedDecayRatio ^ 4 at h2
  change (∑ u : Oˣ, ‖ramifiedRawWeight h u 3‖) ≤ 3 * ramifiedDecayRatio ^ 5 at h3
  change (∑ u : Oˣ, ‖ramifiedRawWeight h u 4‖) ≤ 4 * ramifiedDecayRatio ^ 6 at h4
  have hsum : (∑ k : Fin 5, ∑ u : Oˣ, ‖ramifiedRawWeight h u k.val‖) =
      (∑ u : Oˣ, ‖ramifiedRawWeight h u 0‖) + (∑ u : Oˣ, ‖ramifiedRawWeight h u 1‖) +
      (∑ u : Oˣ, ‖ramifiedRawWeight h u 2‖) + (∑ u : Oˣ, ‖ramifiedRawWeight h u 3‖) +
      (∑ u : Oˣ, ‖ramifiedRawWeight h u 4‖) := by
    simp only [Fin.sum_univ_succ, Fin.val_zero, Fin.val_succ, Finset.univ_eq_empty, Finset.sum_empty]
    ring
  have hp4 : ramifiedDecayRatio ^ 4 = (1 / 3 : ℝ) * ramifiedDecayRatio := by
    rw [show (4 : ℕ) = 3 + 1 from rfl, pow_add, ramifiedDecayRatio_cube, pow_one]
  have hp5 : ramifiedDecayRatio ^ 5 = (1 / 3 : ℝ) * ramifiedDecayRatio ^ 2 := by
    rw [show (5 : ℕ) = 3 + 2 from rfl, pow_add, ramifiedDecayRatio_cube]
  have hp6 : ramifiedDecayRatio ^ 6 = (1 / 9 : ℝ) := by
    rw [show (6 : ℕ) = 3 * 2 from rfl, pow_mul, ramifiedDecayRatio_cube]
    norm_num
  have hsq : ramifiedDecayRatio ^ 2 ≤ 49 / 100 := by
    have hp := mul_nonneg (sub_nonneg.mpr ramifiedDecayRatio_le_seven_tenths)
      (add_nonneg (by norm_num : (0 : ℝ) ≤ 7 / 10) ramifiedDecayRatio_pos.le)
    nlinarith only [hp]
  change (∑ u : Oˣ, ∑ k : Fin 5, ‖ramifiedRawWeight h u k.val‖) ≤ _
  rw [Finset.sum_comm, hsum, hzero, zero_add]
  calc
    _ ≤ 4 * ramifiedDecayRatio ^ 3 + 3 * ramifiedDecayRatio ^ 4 +
        3 * ramifiedDecayRatio ^ 5 + 4 * ramifiedDecayRatio ^ 6 := by
      linarith only [h1, h2, h3, h4]
    _ = 16 / 9 + ramifiedDecayRatio + ramifiedDecayRatio ^ 2 := by
      rw [ramifiedDecayRatio_cube, hp4, hp5, hp6]
      ring
    _ ≤ 2671 / 900 := by linarith only [ramifiedDecayRatio_le_seven_tenths, hsq]

end

def ramifiedGaussWeight (h : O) (u : Oˣ) (k : ℕ) (s : ℂ) : ℂ :=
  ((3 ^ (k + 2) : ℕ) : ℂ) ^ (-s) * arithmeticResidueSum h ((u : O) * lambda ^ (k + 2))

lemma ramifiedGaussWeight_analyticAt (h : O) (u : Oˣ) (k : ℕ) (s : ℂ) :
    AnalyticAt ℂ (ramifiedGaussWeight h u k) s := by
  apply AnalyticAt.mul _ analyticAt_const
  apply Complex.analyticAt_iff_eventually_differentiableAt.mpr
  apply Eventually.of_forall
  intro z
  exact differentiableAt_id.neg.const_cpow (Or.inl (by
    exact_mod_cast (pow_ne_zero (k + 2) (by norm_num : (3 : ℕ) ≠ 0))))

section
local instance : Finite Oˣ := cubic_units_finite
local instance : Fintype Oˣ := Fintype.ofFinite _

/-- The finite ramified decomposition survives continuation to the actual scattering residue. -/
theorem nonzeroScatteringResidue_eq_finite_gauss (h : O) (hh : h ≠ 0) (N : ℕ)
    (hN : ramifiedFrequencyBound h + 1 ≤ N) :
    nonzeroScatteringResidue h =
      (∑ u : Oˣ, ∑ k ∈ Finset.range N, ramifiedRawWeight h u k *
        unramifiedGaussResidue (9 * h * ((u : O) * lambda ^ (k + 2)))) / ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) := by
  let index : Oˣ × Fin N → O := fun i => 9 * h * ((i.1 : O) * lambda ^ (i.2.val + 2))
  let coefficient : Oˣ × Fin N → ℂ → ℂ := fun i s =>
    cuspWhittakerHeightFactor s h * ramifiedGaussWeight h i.1 i.2.val s
  have he := finite_unramified_residue index coefficient
    (fun i s hs => (cuspWhittakerHeightFactor_analyticAt h s hs).mul (ramifiedGaussWeight_analyticAt h i.1 i.2.val s))
    (kernelCuspFourierFamily h 2 3 (by norm_num) (by norm_num))
    (kernelCuspFourier h cubicEisensteinResidue)
    (fun s hs hi => kernelCuspFourierFamily_analyticAt_nonreal h 2 3 (by norm_num) (by norm_num) s hs.ne' hi.ne')
    (kernelCuspFourierFamily_residue_limit h 2 3 (by norm_num) (by norm_num))
    (by
      intro s hs hi
      rw [kernelCuspFourierFamily_eq_upper h hh ⟨by linarith, hi⟩]
      dsimp only
      rw [scatteringCoefficient]
      have hv : ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) *
          (arithmeticDirichletSeries s h / ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ)) = arithmeticDirichletSeries s h := by
        field_simp [cusp_volume_ne_zero]
      rw [hv, arithmeticDirichletSeries_finite_gauss_of_bound s (by linarith) h hh N hN]
      simp only [tsum_fintype, Fintype.sum_prod_type, coefficient, index, ramifiedGaussWeight,
        Finset.sum_mul, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro u hu
      rw [Fin.sum_univ_eq_sum_range (fun k => cuspWhittakerHeightFactor s h *
        (((3 ^ (k + 2) : ℕ) : ℂ) ^ (-s) * arithmeticResidueSum h ((u : O) * lambda ^ (k + 2))) *
          unramifiedCubicGaussSeries s (9 * h * ((u : O) * lambda ^ (k + 2))))]
      apply Finset.sum_congr rfl
      intro k hk
      ring)
  have hsum : (∑ i : Oˣ × Fin N, coefficient i (4 / 3) * unramifiedGaussResidue (index i)) =
      cuspWhittakerHeightFactor (4 / 3) h *
        (∑ u : Oˣ, ∑ k ∈ Finset.range N, ramifiedRawWeight h u k *
          unramifiedGaussResidue (9 * h * ((u : O) * lambda ^ (k + 2)))) := by
    simp only [Fintype.sum_prod_type, coefficient, index, ramifiedGaussWeight, ramifiedRawWeight,
      Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro u hu
    rw [Fin.sum_univ_eq_sum_range (fun k => cuspWhittakerHeightFactor (4 / 3) h *
      (((3 ^ (k + 2) : ℕ) : ℂ) ^ (-(4 / 3 : ℂ)) * arithmeticResidueSum h ((u : O) * lambda ^ (k + 2))) *
        unramifiedGaussResidue (9 * h * ((u : O) * lambda ^ (k + 2))))]
    apply Finset.sum_congr rfl
    intro k hk
    ring
  rw [hsum] at he
  rw [nonzeroScatteringResidue, he]
  field_simp [cusp_volume_ne_zero, cuspWhittakerHeightFactor_center_ne_zero h]

def lowRamifiedTransform (F : O → ℂ) (h : O) : ℂ :=
  3 * F (9 * h) + ∑ u : Oˣ, ∑ k : Fin 5,
    ramifiedRawWeight h u k.val * F (9 * h * ((u : O) * lambda ^ (k.val + 2)))

lemma nonzeroScatteringResidue_low (a r : Fin 3) (b : O) (hb : lambda ^ 2 ∣ b - 1) :
    nonzeroScatteringResidue (lowRamifiedFrequency a r * b) =
      (∑ u : Oˣ, ∑ k : Fin 5, ramifiedRawWeight (lowRamifiedFrequency a r * b) u k.val *
        unramifiedGaussResidue (9 * (lowRamifiedFrequency a r * b) * ((u : O) * lambda ^ (k.val + 2)))) /
          ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) := by
  let h := lowRamifiedFrequency a r * b
  let N := max (ramifiedFrequencyBound h + 1) 5
  rw [nonzeroScatteringResidue_eq_finite_gauss h
    (mul_ne_zero (lowRamifiedFrequency_ne_zero a r) (primary_ne_zero b hb)) N (le_max_left _ _)]
  congr 1
  apply Finset.sum_congr rfl
  intro u hu
  rw [Fin.sum_univ_eq_sum_range (fun k => ramifiedRawWeight h u k *
    unramifiedGaussResidue (9 * h * ((u : O) * lambda ^ (k + 2))))]
  symm
  apply Finset.sum_subset (Finset.range_mono (le_max_right _ _))
  intro k hk hk5
  have hz := lowRamifiedFrequency_primary_vanish a r b hb u k
    (by simpa only [Finset.mem_range, not_lt] using hk5)
  simp only [ramifiedRawWeight, h, hz, mul_zero, zero_mul]

end

lemma sourceRayPhase_of_three_dvd (h : O) (hh : (3 : O) ∣ h) : tracePhase (cuspFrequency h) = 1 := by
  obtain ⟨b, rfl⟩ := hh
  have he : cuspFrequency (3 * b) = cuspFrequency b * (3 * ringComplex 1) := by
    simp only [cuspFrequency, map_mul, map_ofNat, map_one]
    ring
  rw [he, cuspFrequency_period]

lemma rationalCuspPhaseSum_of_three_dvd (h : O) (hh : (3 : O) ∣ h) : rationalCuspPhaseSum h = 3 := by
  rw [rationalCuspPhaseSum, show cuspFrequency h * 2 = cuspFrequency h + cuspFrequency h by ring,
    AddChar.map_add_eq_mul, sourceRayPhase_of_three_dvd h hh]
  norm_num

section
local instance : Finite Oˣ := cubic_units_finite
local instance : Fintype Oˣ := Fintype.ofFinite _

theorem lowRamifiedTransform_actual (a r : Fin 3) (b : O) (hb : lambda ^ 2 ∣ b - 1) :
    lowRamifiedTransform unramifiedGaussResidue (lowRamifiedFrequency a r * b) =
      (4 * ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ)) *
        rationalSourceScatteringResidue (lowRamifiedFrequency a r * b) := by
  rw [rationalSourceScatteringResidue,
    if_neg (mul_ne_zero (lowRamifiedFrequency_ne_zero a r) (primary_ne_zero b hb)),
    oppositeCuspResidue_eq_unramified,
    rationalCuspPhaseSum_of_three_dvd _ (dvd_mul_of_dvd_left (lowRamifiedFrequency_three_dvd a r) b),
    nonzeroScatteringResidue_low a r b hb]
  unfold lowRamifiedTransform
  field_simp [cusp_volume_ne_zero]
  ring

lemma lowRamifiedTransform_sub (F G : O → ℂ) (h : O) :
    lowRamifiedTransform (fun x => F x - G x) h = lowRamifiedTransform F h - lowRamifiedTransform G h := by
  simp only [lowRamifiedTransform, mul_sub, Finset.sum_sub_distrib]
  ring

lemma ramifiedRawWeight_frequency_cube (h p : O) (hp : lambda ^ 2 ∣ p - 1) (u : Oˣ) (k : ℕ) :
    ramifiedRawWeight (h * p ^ 3) u k = ramifiedRawWeight h u k := by
  rw [ramifiedRawWeight, ramifiedRawWeight, arithmeticResidueSum_frequency_cube h _ p
    (ramifiedElement_ne_zero u (k + 2)) (ramifiedElement_level u (k + 2) (by omega)) hp
    (ramified_primary_coprime u (k + 2) p hp).of_mul_left_right]

lemma lowRamifiedTransform_cube_comp (F : O → ℂ) (h p : O) (hp : lambda ^ 2 ∣ p - 1) :
    lowRamifiedTransform (fun x => F (x * p ^ 3)) h = lowRamifiedTransform F (h * p ^ 3) := by
  simp only [lowRamifiedTransform, ramifiedRawWeight_frequency_cube h p hp]
  rw [show 9 * h * p ^ 3 = 9 * (h * p ^ 3) by ring]
  congr 1
  apply Finset.sum_congr rfl
  intro u hu
  apply Finset.sum_congr rfl
  intro k hk
  congr 2
  ring

theorem lowRamifiedTransform_cube_difference (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1)
    (a r : Fin 3) (b : O) (hb : lambda ^ 2 ∣ b - 1) :
    lowRamifiedTransform (fun x => unramifiedGaussResidue (x * p ^ 3) - unramifiedGaussResidue x)
      (lowRamifiedFrequency a r * b) = 0 := by
  rw [lowRamifiedTransform_sub, lowRamifiedTransform_cube_comp _ _ p hprimary]
  have hb3 : lambda ^ 2 ∣ b * p ^ 3 - 1 :=
    primary_mul b (p ^ 3) hb (primary_pow_congruence p hprimary 3)
  rw [mul_assoc, lowRamifiedTransform_actual a r (b * p ^ 3) hb3,
    lowRamifiedTransform_actual a r b hb, ← mul_assoc,
    rationalSourceScatteringResidue_mul_prime_cube p hp hprimary, sub_self]

end

lemma ramifiedFunction_reduce (F : O → ℂ) (hneg : ∀ x, F (-x) = F x)
    (hpow : ∀ x m, F (x * lambda ^ m) = F (x * lambda ^ (m % 3))) (b : O) (u : Oˣ) (m : ℕ) :
    ∃ j k : Fin 3, F (b * ((u : O) * lambda ^ m)) = F (b * omega ^ j.val * lambda ^ k.val) := by
  obtain ⟨j, hj | hj⟩ := unit_eq_sign_omega u
  · refine ⟨j, ⟨m % 3, Nat.mod_lt _ (by norm_num)⟩, ?_⟩
    rw [hj, ← mul_assoc, hpow]
  · refine ⟨j, ⟨m % 3, Nat.mod_lt _ (by norm_num)⟩, ?_⟩
    rw [hj, neg_mul, mul_neg, hneg, ← mul_assoc, hpow]

lemma lowRamified_inner_family (a r : Fin 3) (b : O) (u : Oˣ) (k : ℕ) :
    9 * (lowRamifiedFrequency a r * b) * ((u : O) * lambda ^ (k + 2)) =
      b * (((cuspOmegaUnit ^ (a.val + 1) * u : Oˣ) : O) * lambda ^ (r.val + k + 8)) := by
  simp only [lowRamifiedFrequency, ramifiedNine_eq, Units.val_mul, Units.val_pow_eq_pow_val, cuspOmegaUnit_val]
  rw [show r.val + k + 8 = 4 + ((r.val + 2) + (k + 2)) by omega]
  simp only [pow_add, pow_one]
  ring

lemma lowRamifiedLeading (F : O → ℂ)
    (hpow : ∀ x m, F (x * lambda ^ m) = F (x * lambda ^ (m % 3))) (b : O) (j k : Fin 3) :
    F (9 * (lowRamifiedFrequency ⟨(j.val + 2) % 3, Nat.mod_lt _ (by norm_num)⟩ k * b)) =
      F (b * omega ^ j.val * lambda ^ k.val) := by
  have ho : omega ^ ((j.val + 2) % 3 + 1) = omega ^ j.val := by
    fin_cases j <;> norm_num [omega_primitive.pow_eq_one]
  have he : 9 * (lowRamifiedFrequency ⟨(j.val + 2) % 3, Nat.mod_lt _ (by norm_num)⟩ k * b) =
      (b * omega ^ j.val) * lambda ^ (k.val + 6) := by
    simp only [lowRamifiedFrequency, ramifiedNine_eq]
    rw [show k.val + 6 = 4 + (k.val + 2) by omega, pow_add, ← ho, pow_succ]
    ring
  rw [he, hpow, show (k.val + 6) % 3 = k.val by omega]

section
local instance : Finite Oˣ := cubic_units_finite
local instance : Fintype Oˣ := Fintype.ofFinite _

lemma lowRamified_remainder_bound (F : O → ℂ) (hneg : ∀ x, F (-x) = F x)
    (hpow : ∀ x m, F (x * lambda ^ m) = F (x * lambda ^ (m % 3))) (b : O) (hb : lambda ^ 2 ∣ b - 1)
    (M : ℝ) (hM0 : 0 ≤ M) (hM : ∀ j k : Fin 3, ‖F (b * omega ^ j.val * lambda ^ k.val)‖ ≤ M)
    (a r : Fin 3) :
    ‖∑ u : Oˣ, ∑ k : Fin 5, ramifiedRawWeight (lowRamifiedFrequency a r * b) u k.val *
      F (9 * (lowRamifiedFrequency a r * b) * ((u : O) * lambda ^ (k.val + 2)))‖ ≤ (2671 / 900) * M := by
  have hbound (u : Oˣ) (k : Fin 5) :
      ‖F (9 * (lowRamifiedFrequency a r * b) * ((u : O) * lambda ^ (k.val + 2)))‖ ≤ M := by
    rw [lowRamified_inner_family]
    obtain ⟨j, l, he⟩ := ramifiedFunction_reduce F hneg hpow b (cuspOmegaUnit ^ (a.val + 1) * u) (r.val + k.val + 8)
    rw [he]
    exact hM j l
  calc
    _ ≤ ∑ u : Oˣ, ∑ k : Fin 5, ‖ramifiedRawWeight (lowRamifiedFrequency a r * b) u k.val *
        F (9 * (lowRamifiedFrequency a r * b) * ((u : O) * lambda ^ (k.val + 2)))‖ :=
      (norm_sum_le _ _).trans (Finset.sum_le_sum (fun _ _ => norm_sum_le _ _))
    _ ≤ ∑ u : Oˣ, ∑ k : Fin 5, ‖ramifiedRawWeight (lowRamifiedFrequency a r * b) u k.val‖ * M := by
      apply Finset.sum_le_sum
      intro u hu
      apply Finset.sum_le_sum
      intro k hk
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_left (hbound u k) (norm_nonneg _)
    _ = (∑ u : Oˣ, ∑ k : Fin 5, ‖ramifiedRawWeight (lowRamifiedFrequency a r * b) u k.val‖) * M := by
      simp only [Finset.sum_mul]
    _ ≤ (2671 / 900) * M := mul_le_mul_of_nonneg_right (lowRamifiedRawWeight_sum a r b hb) hM0

/-- Strict domination by the leading term makes the ramified transform injective on its nine residue classes. -/
theorem lowRamifiedTransform_injective (F : O → ℂ) (hneg : ∀ x, F (-x) = F x)
    (hpow : ∀ x m, F (x * lambda ^ m) = F (x * lambda ^ (m % 3))) (b : O) (hb : lambda ^ 2 ∣ b - 1)
    (hz : ∀ a r : Fin 3, lowRamifiedTransform F (lowRamifiedFrequency a r * b) = 0) :
    ∀ j k : Fin 3, F (b * omega ^ j.val * lambda ^ k.val) = 0 := by
  obtain ⟨i, hi, himax⟩ := Finset.exists_max_image (Finset.univ : Finset (Fin 3 × Fin 3))
    (fun i => ‖F (b * omega ^ i.1.val * lambda ^ i.2.val)‖) Finset.univ_nonempty
  let M := ‖F (b * omega ^ i.1.val * lambda ^ i.2.val)‖
  have hM : ∀ j k : Fin 3, ‖F (b * omega ^ j.val * lambda ^ k.val)‖ ≤ M :=
    fun j k => himax (j, k) (Finset.mem_univ _)
  let a : Fin 3 := ⟨(i.1.val + 2) % 3, Nat.mod_lt _ (by norm_num)⟩
  have hbnd := lowRamified_remainder_bound F hneg hpow b hb M (norm_nonneg _) hM a i.2
  have he := hz a i.2
  unfold lowRamifiedTransform at he
  rw [lowRamifiedLeading F hpow b i.1 i.2] at he
  have hnorm : 3 * M ≤ (2671 / 900) * M := by
    have heq : 3 * F (b * omega ^ i.1.val * lambda ^ i.2.val) =
        -(∑ u : Oˣ, ∑ k : Fin 5, ramifiedRawWeight (lowRamifiedFrequency a i.2 * b) u k.val *
          F (9 * (lowRamifiedFrequency a i.2 * b) * ((u : O) * lambda ^ (k.val + 2)))) := by
      linear_combination he
    have hh := congrArg norm heq
    rw [norm_mul, Complex.norm_ofNat, norm_neg] at hh
    exact hh.le.trans hbnd
  have hmzero : M = 0 := by have hM0 : 0 ≤ M := norm_nonneg _; linarith only [hnorm, hM0]
  intro j k
  exact norm_eq_zero.mp (le_antisymm (hmzero ▸ hM j k) (norm_nonneg _))

end

/-- Primary prime cubes leave every unramified Gauss residue unchanged. -/
theorem unramifiedGaussResidue_prime_cube (p : O) (hp : Prime p) (hprimary : lambda ^ 2 ∣ p - 1) (h : O) :
    unramifiedGaussResidue (h * p ^ 3) = unramifiedGaussResidue h := by
  by_cases hh : h = 0
  · simp only [hh, zero_mul]
  obtain ⟨u, m, I, hI, hfactor⟩ := exists_unit_lambda_primary_factor h hh
  let b := primaryIdealGenerator I
  have hb : lambda ^ 2 ∣ b - 1 := (primaryIdealGenerator_spec I hI).2
  let F : O → ℂ := fun x => unramifiedGaussResidue (x * p ^ 3) - unramifiedGaussResidue x
  have hneg (x : O) : F (-x) = F x := by
    dsimp only [F]
    rw [neg_mul, unramifiedGaussResidue_neg, unramifiedGaussResidue_neg]
  have hpow (x : O) (k : ℕ) : F (x * lambda ^ k) = F (x * lambda ^ (k % 3)) := by
    dsimp only [F]
    rw [show (x * lambda ^ k) * p ^ 3 = (x * p ^ 3) * lambda ^ k by ring,
      show (x * lambda ^ (k % 3)) * p ^ 3 = (x * p ^ 3) * lambda ^ (k % 3) by ring,
      unramifiedGaussResidue_lambda_pow (x * p ^ 3) k, unramifiedGaussResidue_lambda_pow x k]
  have hz : ∀ j k : Fin 3, F (b * omega ^ j.val * lambda ^ k.val) = 0 :=
    lowRamifiedTransform_injective F hneg hpow b hb
      (fun a r => lowRamifiedTransform_cube_difference p hp hprimary a r b hb)
  obtain ⟨j, k, hjk⟩ := ramifiedFunction_reduce F hneg hpow b u m
  have hF : F h = 0 := by
    rw [hfactor, mul_comm ((u : O) * lambda ^ m) b, hjk, hz]
  exact sub_eq_zero.mp hF

lemma unramifiedGaussResidue_prime_pow_mod (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (n : ℕ) :
    unramifiedGaussResidue (h * p ^ n) = unramifiedGaussResidue (h * p ^ (n % 3)) := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    by_cases hn : n < 3
    · rw [Nat.mod_eq_of_lt hn]
    have h3 : 3 ≤ n := by omega
    calc
      _ = unramifiedGaussResidue ((h * p ^ (n - 3)) * p ^ 3) := by
        rw [mul_assoc, ← pow_add, Nat.sub_add_cancel h3]
      _ = unramifiedGaussResidue (h * p ^ (n - 3)) := unramifiedGaussResidue_prime_cube p hp hprimary _
      _ = unramifiedGaussResidue (h * p ^ ((n - 3) % 3)) := ih (n - 3) (by omega)
      _ = _ := by rw [show (n - 3) % 3 = n % 3 by omega]

lemma unramifiedGaussResidue_prime_square_zero (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hph : ¬ p ∣ h) :
    unramifiedGaussResidue (h * p ^ 2) = 0 := by
  have hc := unramifiedGaussResidue_prime_cube p hp hprimary (h * p ^ 2)
  rw [show (h * p ^ 2) * p ^ 3 = h * p ^ 5 by ring,
    unramifiedGaussResidue_square_cube p hp hprimary h hph] at hc
  have hn := principalNorm_complex_ne_zero p hp.ne_zero
  exact (mul_eq_zero.mp (show (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ *
    unramifiedGaussResidue (h * p ^ 2) = 0 by linear_combination hc)).resolve_left (inv_ne_zero hn)

/-- The surviving first-power residue is determined by the second cubic Gauss sum. -/
theorem unramifiedGaussResidue_prime_factor (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hph : ¬ p ∣ h) :
    unramifiedGaussResidue (h * p) =
      (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-2 / 3 : ℂ) *
        primeCubicGauss p hp hprimary 2 h * unramifiedGaussResidue h := by
  have hn := principalNorm_complex_ne_zero p hp.ne_zero
  have hgg := primeCubicGauss_one_mul_two p hp hprimary h hph
  have hG : primeCubicGauss p hp hprimary 1 h ≠ 0 := by
    intro hz
    rw [hz, zero_mul] at hgg
    exact hn hgg.symm
  have hweight : (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-(4 / 3 : ℂ)) ≠ 0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl hn)
  have hfactor : (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-(4 / 3 : ℂ)) *
      ((Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-2 / 3 : ℂ) * (Ideal.absNorm (Ideal.span {p}) : ℂ)) =
      (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ := by
    conv_lhs => rhs; rhs; rw [← Complex.cpow_one (Ideal.absNorm (Ideal.span {p}) : ℂ)]
    rw [← Complex.cpow_add _ _ hn, ← Complex.cpow_add _ _ hn]
    convert Complex.cpow_neg_one (Ideal.absNorm (Ideal.span {p}) : ℂ) using 1
    congr 1
    norm_num
  have hrec := unramifiedGaussResidue_prime_recurrence p hp hprimary h hph
  rw [unramifiedGaussResidue_prime_cube p hp hprimary h] at hrec
  have hrel : (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-(4 / 3 : ℂ)) *
      primeCubicGauss p hp hprimary 1 h * unramifiedGaussResidue (h * p) =
        (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ * unramifiedGaussResidue h := by linear_combination hrec
  apply mul_left_cancel₀ (mul_ne_zero hweight hG)
  calc
    _ = (Ideal.absNorm (Ideal.span {p}) : ℂ)⁻¹ * unramifiedGaussResidue h := hrel
    _ = ((Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-(4 / 3 : ℂ)) *
        ((Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-2 / 3 : ℂ) *
          (primeCubicGauss p hp hprimary 1 h * primeCubicGauss p hp hprimary 2 h))) *
            unramifiedGaussResidue h := by rw [hgg, hfactor]
    _ = _ := by ring

/-- The unramified residue vanishes at exponents two modulo three; all other values are explicit. -/
theorem unramifiedGaussResidue_prime_power_table (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hph : ¬ p ∣ h) (n : ℕ) :
    unramifiedGaussResidue (h * p ^ n) =
      if n % 3 = 0 then unramifiedGaussResidue h
      else if n % 3 = 1 then (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-2 / 3 : ℂ) *
        primeCubicGauss p hp hprimary 2 h * unramifiedGaussResidue h
      else 0 := by
  rw [unramifiedGaussResidue_prime_pow_mod p hp hprimary h n]
  by_cases h0 : n % 3 = 0
  · simp only [h0, pow_zero, mul_one, if_true]
  by_cases h1 : n % 3 = 1
  · simp only [h1, pow_one, if_true, Nat.one_ne_zero, if_false]
    exact unramifiedGaussResidue_prime_factor p hp hprimary h hph
  rw [if_neg h0, if_neg h1, show n % 3 = 2 by omega]
  exact unramifiedGaussResidue_prime_square_zero p hp hprimary h hph

theorem unramifiedGaussResidue_primary_cube (b : O) (hb : b ≠ 0)
    (hprimary : lambda ^ 2 ∣ b - 1) (h : O) :
    unramifiedGaussResidue (h * b ^ 3) = unramifiedGaussResidue h := by
  obtain ⟨s, hs, hpr⟩ := exists_primary_prime_factorization b hb hprimary
  rw [← hs]
  clear hs hb hprimary b
  induction s using Multiset.induction_on generalizing h with
  | empty => simp only [Multiset.prod_zero, one_pow, mul_one]
  | @cons p s ih =>
    obtain ⟨hp, hprimary⟩ := hpr p (Multiset.mem_cons_self _ _)
    rw [Multiset.prod_cons, mul_pow, ← mul_assoc,
      ih (h * p ^ 3) (fun q hq => hpr q (Multiset.mem_cons_of_mem hq)),
      unramifiedGaussResidue_prime_cube p hp hprimary h]

/-- Bessel normalization of the unramified Gauss residue. -/
def unramifiedResidualCoefficient (h : O) : ℂ := sourceBesselNormalizer h * unramifiedGaussResidue h

lemma unramifiedResidualCoefficient_prime_factor (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hph : ¬ p ∣ h) :
    unramifiedResidualCoefficient (h * p) =
      (primeCubicGauss p hp hprimary 2 h / (‖ringComplex p‖ : ℂ)) * unramifiedResidualCoefficient h := by
  rw [unramifiedResidualCoefficient, sourceBesselNormalizer_mul,
    unramifiedGaussResidue_prime_factor p hp hprimary h hph, unramifiedResidualCoefficient]
  calc
    _ = ((‖ringComplex p‖ : ℂ) ^ (1 / 3 : ℂ) * (Ideal.absNorm (Ideal.span {p}) : ℂ) ^ (-2 / 3 : ℂ)) *
        primeCubicGauss p hp hprimary 2 h * (sourceBesselNormalizer h * unramifiedGaussResidue h) := by ring
    _ = _ := by rw [sourcePrimeNormalizer_powers p hp.ne_zero]; ring

lemma unramifiedResidualCoefficient_prime_norm (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hph : ¬ p ∣ h) :
    ‖unramifiedResidualCoefficient (h * p)‖ = ‖unramifiedResidualCoefficient h‖ := by
  rw [unramifiedResidualCoefficient_prime_factor p hp hprimary h hph, norm_mul, norm_div,
    primeCubicGauss_two_eq_star p hp hprimary h hph, norm_star,
    cubicUnitGaussSum_prime_norm p hp hprimary h hph, Complex.norm_real,
    Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _),
    div_self (norm_ne_zero_iff.mpr (ringComplex_ne_zero hp.ne_zero)), one_mul]

lemma unramifiedResidualCoefficient_primary_cube (b : O) (hb : b ≠ 0)
    (hprimary : lambda ^ 2 ∣ b - 1) (h : O) :
    unramifiedResidualCoefficient (h * b ^ 3) =
      (‖ringComplex b‖ : ℂ) * unramifiedResidualCoefficient h := by
  rw [unramifiedResidualCoefficient, sourceBesselNormalizer_mul_cube h b hb,
    unramifiedGaussResidue_primary_cube b hb hprimary h, unramifiedResidualCoefficient]
  ring

lemma unramifiedResidualCoefficient_prime_power_vanish (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hph : ¬ p ∣ h) (k : ℕ) (hk : k % 3 = 2) :
    unramifiedResidualCoefficient (h * p ^ k) = 0 := by
  rw [unramifiedResidualCoefficient, unramifiedGaussResidue_prime_power_table p hp hprimary h hph k, hk]
  norm_num

theorem unramifiedResidualCoefficient_full_squarefree_cube_support
    (h : O) (hh : h ≠ 0) (hF : unramifiedResidualCoefficient h ≠ 0) :
    ∃ (u : Oˣ) (m : ℕ) (I J : Ideal O), Squarefree I ∧
      primaryIdealGenerator I ≠ 0 ∧ primaryIdealGenerator J ≠ 0 ∧
      h = ((u : O) * lambda ^ m) * primaryIdealGenerator I * (primaryIdealGenerator J) ^ 3 :=
  ramifiedFunction_squarefree_cube_support unramifiedResidualCoefficient
    unramifiedResidualCoefficient_prime_power_vanish h hh hF

/-- The squarefree factor preserves norm; the cube factor contributes its complex absolute value. -/
theorem unramifiedResidualCoefficient_squarefree_cube_norm (I J : Ideal O)
    (hI : primaryIdealGenerator I ≠ 0) (hJ : primaryIdealGenerator J ≠ 0) (hsq : Squarefree I)
    (u : Oˣ) (m : ℕ) :
    ‖unramifiedResidualCoefficient
      (((u : O) * lambda ^ m) * primaryIdealGenerator I * (primaryIdealGenerator J) ^ 3)‖ =
      ‖ringComplex (primaryIdealGenerator J)‖ * ‖unramifiedResidualCoefficient ((u : O) * lambda ^ m)‖ := by
  rw [unramifiedResidualCoefficient_primary_cube _ hJ (primaryIdealGenerator_spec J hJ).2,
    norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
  congr 1
  rw [primaryIdealGenerator_squarefree_support I hI hsq]
  apply primeProduct_norm_of unramifiedResidualCoefficient unramifiedResidualCoefficient_prime_norm
  · exact fun P hP => primaryIdealPrime_isPrime_of_mem I P hI hP
  · exact fun P hP => (primaryIdealPrime_spec P
      (primaryIdealPrime_factor_ne_zero I P hI (Multiset.mem_toFinset.mp hP))).2.2.2
  · exact primaryIdealPrime_support_coprime I hI
  · intro P hP hd
    have hp := primaryIdealPrime_isPrime_of_mem I P hI hP
    have hpp := (primaryIdealPrime_spec P
      (primaryIdealPrime_factor_ne_zero I P hI (Multiset.mem_toFinset.mp hP))).2.2.2
    exact hp.2.1 ((ramified_primary_coprime u m _ hpp).of_mul_left_right.symm.isUnit_of_dvd hd)

/-- A uniform finite geometric bound, using the rational estimate for the ramified decay ratio. -/
lemma ramifiedDecayRatio_sum_le (N : ℕ) :
    (∑ k ∈ Finset.range N, ramifiedDecayRatio ^ k) ≤ 10 / 3 := by
  have hstrong : (∑ k ∈ Finset.range N, ramifiedDecayRatio ^ k) ≤
      10 / 3 - (10 / 3) * ramifiedDecayRatio ^ N := by
    induction N with
    | zero => simp only [Finset.range_zero, Finset.sum_empty, pow_zero]; norm_num
    | succ N ih =>
      rw [Finset.sum_range_succ, pow_succ]
      have hp := mul_nonneg (pow_nonneg ramifiedDecayRatio_pos.le N)
        (sub_nonneg.mpr ramifiedDecayRatio_le_seven_tenths)
      nlinarith only [ih, hp]
  exact hstrong.trans (sub_le_self _ (mul_nonneg (by norm_num) (pow_nonneg ramifiedDecayRatio_pos.le N)))

section
local instance : Finite Oˣ := cubic_units_finite
local instance : Fintype Oˣ := Fintype.ofFinite _

lemma ramifiedRawWeight_sum_le (h : O) (N : ℕ) :
    (∑ u : Oˣ, ∑ k ∈ Finset.range N, ‖ramifiedRawWeight h u k‖) ≤ 40 / 3 := by
  have hr2 : ramifiedDecayRatio ^ 2 ≤ 1 := by
    have hp := mul_nonneg (sub_nonneg.mpr ramifiedDecayRatio_le_seven_tenths)
      (add_nonneg (by norm_num : (0 : ℝ) ≤ 7 / 10) ramifiedDecayRatio_pos.le)
    nlinarith only [hp]
  calc
    _ = ∑ k ∈ Finset.range N, ∑ u : Oˣ, ‖ramifiedRawWeight h u k‖ := Finset.sum_comm
    _ ≤ ∑ k ∈ Finset.range N, 4 * ramifiedDecayRatio ^ (k + 2) :=
      Finset.sum_le_sum (fun k _ => ramifiedRawWeight_unit_sum_le_four h k)
    _ ≤ ∑ k ∈ Finset.range N, 4 * ramifiedDecayRatio ^ k := by
      apply Finset.sum_le_sum
      intro k hk
      rw [pow_add]
      exact mul_le_mul_of_nonneg_left
        ((mul_le_mul_of_nonneg_left hr2 (pow_nonneg ramifiedDecayRatio_pos.le k)).trans_eq (mul_one _))
        (by norm_num)
    _ = 4 * ∑ k ∈ Finset.range N, ramifiedDecayRatio ^ k := (Finset.mul_sum _ _ _).symm
    _ ≤ 40 / 3 := by linarith only [ramifiedDecayRatio_sum_le N]

lemma nonzeroScatteringResidue_family_bound (h : O) (hh : h ≠ 0) :
    ‖nonzeroScatteringResidue h‖ ≤
      ((40 / 3) * ramifiedResidueFamilyMass h) / (9 * Real.sqrt 3 / 2) := by
  rw [nonzeroScatteringResidue_eq_finite_gauss h hh (ramifiedFrequencyBound h + 1) le_rfl,
    norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity : (0 : ℝ) < 9 * Real.sqrt 3 / 2)]
  apply div_le_div_of_nonneg_right _ (by positivity)
  calc
    _ ≤ ∑ u : Oˣ, ∑ k ∈ Finset.range (ramifiedFrequencyBound h + 1),
        ‖ramifiedRawWeight h u k * unramifiedGaussResidue (9 * h * ((u : O) * lambda ^ (k + 2)))‖ :=
      (norm_sum_le _ _).trans (Finset.sum_le_sum (fun _ _ => norm_sum_le _ _))
    _ ≤ ∑ u : Oˣ, ∑ k ∈ Finset.range (ramifiedFrequencyBound h + 1),
        ‖ramifiedRawWeight h u k‖ * ramifiedResidueFamilyMass h := by
      apply Finset.sum_le_sum
      intro u hu
      apply Finset.sum_le_sum
      intro k hk
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_left (unramifiedGaussResidue_nine_norm_le h u (k + 2)) (norm_nonneg _)
    _ = (∑ u : Oˣ, ∑ k ∈ Finset.range (ramifiedFrequencyBound h + 1),
        ‖ramifiedRawWeight h u k‖) * ramifiedResidueFamilyMass h := by simp only [Finset.sum_mul]
    _ ≤ (40 / 3) * ramifiedResidueFamilyMass h :=
      mul_le_mul_of_nonneg_right (ramifiedRawWeight_sum_le h _) (ramifiedResidueFamilyMass_nonneg h)

/-- A finite unit–ramified family controls the projected arithmetic residue uniformly. -/
theorem rationalSourceScatteringResidue_family_bound (h : O) (hh : h ≠ 0) :
    ‖rationalSourceScatteringResidue h‖ ≤
      (49 / (12 * (9 * Real.sqrt 3 / 2))) * ramifiedResidueFamilyMass h := by
  have hV : 0 < (9 * Real.sqrt 3 / 2 : ℝ) := by positivity
  have h9 : ‖unramifiedGaussResidue (9 * h)‖ ≤ ramifiedResidueFamilyMass h := by
    simpa only [Units.val_one, pow_zero, mul_one] using unramifiedGaussResidue_nine_norm_le h 1 0
  rw [rationalSourceScatteringResidue, if_neg hh, oppositeCuspResidue_eq_unramified, norm_mul,
    norm_inv, Complex.norm_ofNat]
  calc
    _ ≤ (4 : ℝ)⁻¹ * (‖nonzeroScatteringResidue h‖ +
        ‖rationalCuspPhaseSum h * unramifiedGaussResidue (9 * h) / ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ)‖) :=
      mul_le_mul_of_nonneg_left (norm_add_le _ _) (by norm_num)
    _ ≤ (4 : ℝ)⁻¹ * (((40 / 3) * ramifiedResidueFamilyMass h) / (9 * Real.sqrt 3 / 2) +
        (3 * ramifiedResidueFamilyMass h) / (9 * Real.sqrt 3 / 2)) := by
      apply mul_le_mul_of_nonneg_left _ (by norm_num)
      apply add_le_add (nonzeroScatteringResidue_family_bound h hh)
      rw [norm_div, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hV]
      exact div_le_div_of_nonneg_right
        (mul_le_mul (rationalCuspPhaseSum_norm_le h) h9 (norm_nonneg _) (by norm_num)) hV.le
    _ = _ := by ring

def sourceArithmeticBaseBound : ℝ :=
  (49 / (12 * (9 * Real.sqrt 3 / 2))) * (Fintype.card (Oˣ × Fin 3) : ℝ) * ramifiedResidueFamilyMass 1

lemma sourceArithmeticBaseBound_nonneg : 0 ≤ sourceArithmeticBaseBound := by
  unfold sourceArithmeticBaseBound
  exact mul_nonneg (by positivity) (ramifiedResidueFamilyMass_nonneg 1)

theorem rationalSourceScatteringResidue_unit_lambda_bound (u : Oˣ) (m : ℕ) :
    ‖rationalSourceScatteringResidue ((u : O) * lambda ^ m)‖ ≤ sourceArithmeticBaseBound := by
  refine (rationalSourceScatteringResidue_family_bound _ (ramifiedElement_ne_zero u m)).trans ?_
  exact (mul_le_mul_of_nonneg_left (ramifiedResidueFamilyMass_unit_lambda_le u m)
    (by positivity)).trans_eq (by unfold sourceArithmeticBaseBound; ring)

end

lemma sourceBesselNormalizer_mul_norm (h b : O) (hb : b ≠ 0) :
    ‖sourceBesselNormalizer (h * b)‖ = ‖sourceBesselNormalizer h‖ * ‖ringComplex b‖ ^ (1 / 3 : ℝ) := by
  rw [sourceBesselNormalizer_mul, norm_mul]
  have he := Complex.norm_cpow_eq_rpow_re_of_pos
    (norm_pos_iff.mpr (ringComplex_ne_zero hb)) (1 / 3 : ℂ)
  rw [show (1 / 3 : ℂ).re = (1 / 3 : ℝ) by norm_num] at he
  rw [he, mul_comm]

def unramifiedCoefficientBaseBound : ℝ := ‖sourceBesselNormalizer 1‖ * ramifiedResidueFamilyMass 1
def sourceCoefficientBaseBound : ℝ := ‖sourceBesselNormalizer 1‖ * sourceArithmeticBaseBound

lemma unramifiedCoefficientBaseBound_nonneg : 0 ≤ unramifiedCoefficientBaseBound :=
  mul_nonneg (norm_nonneg _) (ramifiedResidueFamilyMass_nonneg 1)

lemma sourceCoefficientBaseBound_nonneg : 0 ≤ sourceCoefficientBaseBound :=
  mul_nonneg (norm_nonneg _) sourceArithmeticBaseBound_nonneg

lemma unramifiedResidualCoefficient_ramified_bound (u : Oˣ) (m : ℕ) :
    ‖unramifiedResidualCoefficient ((u : O) * lambda ^ m)‖ ≤
      unramifiedCoefficientBaseBound * ‖ringComplex ((u : O) * lambda ^ m)‖ ^ (1 / 3 : ℝ) := by
  have hn := sourceBesselNormalizer_mul_norm 1 ((u : O) * lambda ^ m) (ramifiedElement_ne_zero u m)
  rw [one_mul] at hn
  rw [unramifiedResidualCoefficient, norm_mul, hn]
  exact (mul_le_mul_of_nonneg_left (unramifiedGaussResidue_unit_lambda_norm_le u m)
    (mul_nonneg (norm_nonneg _) (Real.rpow_nonneg (norm_nonneg _) _))).trans_eq
      (by unfold unramifiedCoefficientBaseBound; ring)

lemma rationalSourceResidualFourierCoefficient_ramified_bound (u : Oˣ) (m : ℕ) :
    ‖rationalSourceResidualFourierCoefficient ((u : O) * lambda ^ m)‖ ≤
      sourceCoefficientBaseBound * ‖ringComplex ((u : O) * lambda ^ m)‖ ^ (1 / 3 : ℝ) := by
  have hn := sourceBesselNormalizer_mul_norm 1 ((u : O) * lambda ^ m) (ramifiedElement_ne_zero u m)
  rw [one_mul] at hn
  rw [rationalSourceResidualFourierCoefficient_eq _ (ramifiedElement_ne_zero u m)]
  change ‖rationalSourceScatteringResidue ((u : O) * lambda ^ m) *
    sourceBesselNormalizer ((u : O) * lambda ^ m)‖ ≤ _
  rw [norm_mul, hn]
  exact (mul_le_mul_of_nonneg_right (rationalSourceScatteringResidue_unit_lambda_bound u m)
    (mul_nonneg (norm_nonneg _) (Real.rpow_nonneg (norm_nonneg _) _))).trans_eq
      (by unfold sourceCoefficientBaseBound; ring)

def threeRamifiedUnit : Oˣ := -(cuspOmegaUnit ^ 2)

lemma three_eq_ramifiedUnit : (3 : O) = (threeRamifiedUnit : O) * lambda ^ 2 := by
  simp only [threeRamifiedUnit, Units.val_neg, Units.val_pow_eq_pow_val, cuspOmegaUnit_val, lambda_sq_eq]
  calc
    (3 : O) = 3 * omega ^ 3 := by rw [omega_primitive.pow_eq_one]; ring
    _ = _ := by ring

def ramifiedSixUnit (u t : Oˣ) : RamifiedSixBranch → Oˣ
  | .inl _ => threeRamifiedUnit * u
  | .inr (.inl _) => threeRamifiedUnit * (-u)⁻¹ ^ 4 * (-u)
  | .inr (.inr (.inl _)) => threeRamifiedUnit * (-u)⁻¹ ^ 4
  | .inr (.inr (.inr j)) => threeRamifiedUnit * (-u)⁻¹ ^ 4 * t * (-cuspOmegaUnit) * cuspOmegaUnit ^ j.val

def ramifiedSixPower : RamifiedSixBranch → ℕ
  | .inl _ => 2
  | .inr (.inl _) => 2
  | .inr (.inr (.inl _)) => 2
  | .inr (.inr (.inr _)) => 3

lemma scaledAffineGaussWeight_divides (q : O) (u : Oˣ) (n : ℕ) (h : O) (s : ℂ)
    (hw : scaledAffineGaussWeight q u n h s ≠ 0) : q ∣ h := by
  by_contra hd
  exact hw (by simp only [scaledAffineGaussWeight, dif_neg hd])

lemma scaledAffineGaussIndex_eq_mul (q : O) (u : Oˣ) (n : ℕ) (h b : O)
    (hd : q ∣ h) (hb : 3 * ((u : O) * lambda ^ n) ^ 2 = b * q) :
    scaledAffineGaussIndex q u n h = b * h := by
  rw [scaledAffineGaussIndex, dif_pos hd, hb, mul_assoc, ← Classical.choose_spec hd]

/-- Every branch with nonzero weight multiplies frequency by a unit and a ramified power. -/
theorem ramifiedSixIndex_multiplier (u t : Oˣ) (h : O) (i : RamifiedSixBranch)
    (hw : ramifiedSixWeight u t h i (4 / 3) ≠ 0) :
    ramifiedSixIndex u t h i = ((ramifiedSixUnit u t i : O) * lambda ^ ramifiedSixPower i) * h := by
  rcases i with i | i
  · have hd := scaledAffineGaussWeight_divides (u : O) u 0 h (4 / 3) (mul_ne_zero_iff.mp hw).2
    apply scaledAffineGaussIndex_eq_mul _ _ _ _ _ hd
    simp only [ramifiedSixUnit, ramifiedSixPower, Units.val_mul, pow_zero, mul_one]
    rw [three_eq_ramifiedUnit]
    ring
  rcases i with i | i
  · have hd := scaledAffineGaussWeight_divides (-(u : O)) ((-u)⁻¹ ^ 2 * (-u)) 0 h (4 / 3)
      (mul_ne_zero_iff.mp hw).2
    apply scaledAffineGaussIndex_eq_mul _ _ _ _ _ hd
    simp only [ramifiedSixUnit, ramifiedSixPower, Units.val_mul, Units.val_pow_eq_pow_val,
      Units.val_neg, pow_zero, mul_one]
    rw [three_eq_ramifiedUnit]
    ring
  rcases i with i | j
  · have hd := scaledAffineGaussWeight_divides 1 ((-u)⁻¹ ^ 2) 0 h (4 / 3) (mul_ne_zero_iff.mp hw).2
    apply scaledAffineGaussIndex_eq_mul _ _ _ _ _ hd
    simp only [ramifiedSixUnit, ramifiedSixPower, Units.val_mul, Units.val_pow_eq_pow_val, pow_zero, mul_one]
    rw [three_eq_ramifiedUnit]
    ring
  · have hd := scaledAffineGaussWeight_divides (onceCuspScale t * omega ^ j.val)
      (onceCuspArithmeticUnit (-u) t j) 1 h (4 / 3) (mul_ne_zero_iff.mp hw).2
    apply scaledAffineGaussIndex_eq_mul _ _ _ _ _ hd
    rw [pow_one, onceCuspArithmeticUnit_spec]
    simp only [ramifiedSixUnit, ramifiedSixPower, Units.val_mul, Units.val_pow_eq_pow_val,
      Units.val_neg, cuspOmegaUnit_val, onceCuspScale, traceLambda_eq_unit_mul_lambda]
    rw [three_eq_ramifiedUnit]
    ring

lemma ramifiedResidualFourierCoefficient_prime_power_vanish (u t : Oˣ) (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hph : ¬ p ∣ h) (k : ℕ) (hk : k % 3 = 2) :
    ramifiedResidualFourierCoefficient u t (h * p ^ k) = 0 := by
  have hz : ramifiedArithmeticResidue u t (h * p ^ k) = 0 := by
    apply Finset.sum_eq_zero
    intro i hi
    by_cases hw : ramifiedSixWeight u t (h * p ^ k) i (4 / 3) = 0
    · rw [hw, zero_mul]
    rw [ramifiedSixIndex_multiplier u t _ i hw, ← mul_assoc]
    have hnot : ¬ p ∣ ((ramifiedSixUnit u t i : O) * lambda ^ ramifiedSixPower i) * h := by
      intro hd
      rcases hp.dvd_mul.mp hd with hd | hd
      · exact hp.2.1 ((ramified_primary_coprime (ramifiedSixUnit u t i) (ramifiedSixPower i)
          p hprimary).of_mul_left_right.symm.isUnit_of_dvd hd)
      · exact hph hd
    rw [unramifiedGaussResidue_prime_power_table p hp hprimary _ hnot k, hk]
    norm_num
  simp only [ramifiedResidualFourierCoefficient, hz, mul_zero, zero_div, zero_mul]

theorem ramifiedBesselCoefficient_full_squarefree_cube_support (side : Bool)
    (h : O) (hh : h ≠ 0) (hF : ramifiedBesselCoefficient side h ≠ 0) :
    ∃ (u : Oˣ) (m : ℕ) (I J : Ideal O), Squarefree I ∧
      primaryIdealGenerator I ≠ 0 ∧ primaryIdealGenerator J ≠ 0 ∧
      h = ((u : O) * lambda ^ m) * primaryIdealGenerator I * (primaryIdealGenerator J) ^ 3 :=
  ramifiedFunction_squarefree_cube_support (ramifiedBesselCoefficient side)
    (ramifiedResidualFourierCoefficient_prime_power_vanish (ramifiedCuspRoot side)
      (ramifiedCuspScaleUnit side)) h hh hF

theorem unramifiedResidualCoefficient_squarefree_cube_bound (I J : Ideal O)
    (hI : primaryIdealGenerator I ≠ 0) (hJ : primaryIdealGenerator J ≠ 0) (hsq : Squarefree I)
    (u : Oˣ) (m : ℕ) :
    ‖unramifiedResidualCoefficient
      (((u : O) * lambda ^ m) * primaryIdealGenerator I * (primaryIdealGenerator J) ^ 3)‖ ≤
      unramifiedCoefficientBaseBound * ‖ringComplex ((u : O) * lambda ^ m)‖ ^ (1 / 3 : ℝ) *
        ‖ringComplex (primaryIdealGenerator J)‖ := by
  rw [unramifiedResidualCoefficient_squarefree_cube_norm I J hI hJ hsq u m]
  exact (mul_le_mul_of_nonneg_left (unramifiedResidualCoefficient_ramified_bound u m)
    (norm_nonneg _)).trans_eq (by ring)

theorem rationalSourceResidualFourierCoefficient_squarefree_cube_bound (I J : Ideal O)
    (hI : primaryIdealGenerator I ≠ 0) (hJ : primaryIdealGenerator J ≠ 0) (hsq : Squarefree I)
    (u : Oˣ) (m : ℕ) :
    ‖rationalSourceResidualFourierCoefficient
      (((u : O) * lambda ^ m) * primaryIdealGenerator I * (primaryIdealGenerator J) ^ 3)‖ ≤
      sourceCoefficientBaseBound * ‖ringComplex ((u : O) * lambda ^ m)‖ ^ (1 / 3 : ℝ) *
        ‖ringComplex (primaryIdealGenerator J)‖ := by
  rw [rationalSourceResidualFourierCoefficient_full_squarefree_cube_norm I J hI hJ hsq u m]
  exact (mul_le_mul_of_nonneg_left (rationalSourceResidualFourierCoefficient_ramified_bound u m)
    (norm_nonneg _)).trans_eq (by ring)

/-- Removing the finite-character mask leaves a bound independent of frequency. -/
def scaledAffineGaussBound (q : O) : ℝ :=
  ‖(Ideal.absNorm (Ideal.span {3 * q}) : ℂ) *
    ((‖ringComplex (3 * q)‖ ^ 2 : ℝ) : ℂ) ^ (-(4 / 3 : ℂ))‖

lemma scaledAffineGaussWeight_bound (q : O) (u : Oˣ) (n : ℕ) (h : O) :
    ‖scaledAffineGaussWeight q u n h (4 / 3)‖ ≤ scaledAffineGaussBound q := by
  unfold scaledAffineGaussWeight
  split_ifs
  · rw [norm_mul, tracePhase_norm, mul_one]
    exact le_rfl
  · rw [norm_zero]
    exact norm_nonneg _
  · rw [norm_zero]
    exact norm_nonneg _

def ramifiedSixWeightBound (u t : Oˣ) : RamifiedSixBranch → ℝ
  | .inl _ => (4 : ℝ)⁻¹ * scaledAffineGaussBound (u : O)
  | .inr (.inl _) => (4 : ℝ)⁻¹ * scaledAffineGaussBound (-(u : O))
  | .inr (.inr (.inl _)) => (4 : ℝ)⁻¹ * scaledAffineGaussBound 1
  | .inr (.inr (.inr j)) => (4 : ℝ)⁻¹ * scaledAffineGaussBound (onceCuspScale t * omega ^ j.val)

lemma ramifiedSixWeightBound_nonneg (u t : Oˣ) (i : RamifiedSixBranch) :
    0 ≤ ramifiedSixWeightBound u t i := by
  rcases i with i | i
  · exact mul_nonneg (by norm_num) (norm_nonneg _)
  rcases i with i | i
  · exact mul_nonneg (by norm_num) (norm_nonneg _)
  rcases i with i | i <;> exact mul_nonneg (by norm_num) (norm_nonneg _)

lemma ramifiedSixWeight_norm_bound (u t : Oˣ) (h : O) (i : RamifiedSixBranch) :
    ‖ramifiedSixWeight u t h i (4 / 3)‖ ≤ ramifiedSixWeightBound u t i := by
  rcases i with i | i
  · simpa only [ramifiedSixWeight, ramifiedSixWeightBound, norm_mul, norm_inv, Complex.norm_ofNat]
      using mul_le_mul_of_nonneg_left (scaledAffineGaussWeight_bound (u : O) u 0 h) (by norm_num : (0 : ℝ) ≤ 4⁻¹)
  rcases i with i | i
  · simpa only [ramifiedSixWeight, ramifiedSixWeightBound, norm_mul, norm_inv, Complex.norm_ofNat,
      tracePhase_norm, mul_one] using mul_le_mul_of_nonneg_left
        (scaledAffineGaussWeight_bound (-(u : O)) ((-u)⁻¹ ^ 2 * (-u)) 0 h) (by norm_num : (0 : ℝ) ≤ 4⁻¹)
  rcases i with i | j
  · simpa only [ramifiedSixWeight, ramifiedSixWeightBound, norm_mul, norm_inv, Complex.norm_ofNat,
      tracePhase_norm, mul_one] using mul_le_mul_of_nonneg_left
        (scaledAffineGaussWeight_bound 1 ((-u)⁻¹ ^ 2) 0 h) (by norm_num : (0 : ℝ) ≤ 4⁻¹)
  · simpa only [ramifiedSixWeight, ramifiedSixWeightBound, norm_mul, norm_inv, Complex.norm_ofNat,
      tracePhase_norm, mul_one] using mul_le_mul_of_nonneg_left
        (scaledAffineGaussWeight_bound (onceCuspScale t * omega ^ j.val)
          (onceCuspArithmeticUnit (-u) t j) 1 h) (by norm_num : (0 : ℝ) ≤ 4⁻¹)

/-- The ramified multiplier cancels exactly against the Bessel normalization. -/
lemma normalizedRamifiedGaussTerm_squarefree_cube_bound (v : Oˣ) (n : ℕ) (I J : Ideal O)
    (hI : primaryIdealGenerator I ≠ 0) (hJ : primaryIdealGenerator J ≠ 0) (hsq : Squarefree I)
    (u : Oˣ) (m : ℕ) :
    ‖sourceBesselNormalizer (((u : O) * lambda ^ m) * primaryIdealGenerator I * (primaryIdealGenerator J) ^ 3) *
      unramifiedGaussResidue (((v : O) * lambda ^ n) *
        (((u : O) * lambda ^ m) * primaryIdealGenerator I * (primaryIdealGenerator J) ^ 3))‖ ≤
      unramifiedCoefficientBaseBound * ‖ringComplex ((u : O) * lambda ^ m)‖ ^ (1 / 3 : ℝ) *
        ‖ringComplex (primaryIdealGenerator J)‖ := by
  let a := (v : O) * lambda ^ n
  let b := (u : O) * lambda ^ m
  let h := b * primaryIdealGenerator I * (primaryIdealGenerator J) ^ 3
  have ha : a ≠ 0 := ramifiedElement_ne_zero v n
  have ht : 0 < ‖ringComplex a‖ ^ (1 / 3 : ℝ) :=
    Real.rpow_pos_of_pos (norm_pos_iff.mpr (ringComplex_ne_zero ha)) _
  have he : a * b = ((v * u : Oˣ) : O) * lambda ^ (n + m) := by
    simp only [a, b, Units.val_mul, pow_add]
    ring
  have hbnd : ‖unramifiedResidualCoefficient (a * h)‖ ≤
      unramifiedCoefficientBaseBound * ‖ringComplex (a * b)‖ ^ (1 / 3 : ℝ) *
        ‖ringComplex (primaryIdealGenerator J)‖ := by
    change ‖unramifiedResidualCoefficient (a * (b * primaryIdealGenerator I * (primaryIdealGenerator J) ^ 3))‖ ≤ _
    rw [← mul_assoc, ← mul_assoc, he]
    exact unramifiedResidualCoefficient_squarefree_cube_bound I J hI hJ hsq (v * u) (n + m)
  have hn : ‖sourceBesselNormalizer h * unramifiedGaussResidue (a * h)‖ *
      ‖ringComplex a‖ ^ (1 / 3 : ℝ) = ‖unramifiedResidualCoefficient (a * h)‖ := by
    rw [unramifiedResidualCoefficient, norm_mul, norm_mul,
      mul_comm a h, sourceBesselNormalizer_mul_norm h a ha]
    ring
  have he : ‖sourceBesselNormalizer h * unramifiedGaussResidue (a * h)‖ *
      ‖ringComplex a‖ ^ (1 / 3 : ℝ) ≤
      (unramifiedCoefficientBaseBound * ‖ringComplex b‖ ^ (1 / 3 : ℝ) *
        ‖ringComplex (primaryIdealGenerator J)‖) * ‖ringComplex a‖ ^ (1 / 3 : ℝ) := by
    rw [hn]
    refine hbnd.trans_eq ?_
    rw [map_mul, norm_mul, Real.mul_rpow (norm_nonneg _) (norm_nonneg _)]
    ring
  change ‖sourceBesselNormalizer h * unramifiedGaussResidue (a * h)‖ ≤ _
  nlinarith only [ht, he]

def ramifiedCoefficientBaseBound (u t : Oˣ) : ℝ :=
  ‖(3 : ℂ) ^ (4 / 3 : ℂ) / ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ)‖ *
    (∑ i : RamifiedSixBranch, ramifiedSixWeightBound u t i) * unramifiedCoefficientBaseBound

lemma ramifiedCoefficientBaseBound_nonneg (u t : Oˣ) : 0 ≤ ramifiedCoefficientBaseBound u t :=
  mul_nonneg (mul_nonneg (norm_nonneg _)
    (Finset.sum_nonneg (fun i _ => ramifiedSixWeightBound_nonneg u t i))) unramifiedCoefficientBaseBound_nonneg

/-- All six ramified branches obey the same squarefree–cube bound. -/
theorem ramifiedResidualFourierCoefficient_squarefree_cube_bound (v t : Oˣ) (I J : Ideal O)
    (hI : primaryIdealGenerator I ≠ 0) (hJ : primaryIdealGenerator J ≠ 0) (hsq : Squarefree I)
    (u : Oˣ) (m : ℕ) :
    ‖ramifiedResidualFourierCoefficient v t
      (((u : O) * lambda ^ m) * primaryIdealGenerator I * (primaryIdealGenerator J) ^ 3)‖ ≤
      ramifiedCoefficientBaseBound v t * ‖ringComplex ((u : O) * lambda ^ m)‖ ^ (1 / 3 : ℝ) *
        ‖ringComplex (primaryIdealGenerator J)‖ := by
  let h := ((u : O) * lambda ^ m) * primaryIdealGenerator I * (primaryIdealGenerator J) ^ 3
  let D := unramifiedCoefficientBaseBound * ‖ringComplex ((u : O) * lambda ^ m)‖ ^ (1 / 3 : ℝ) *
    ‖ringComplex (primaryIdealGenerator J)‖
  have hD : 0 ≤ D := mul_nonneg (mul_nonneg unramifiedCoefficientBaseBound_nonneg
    (Real.rpow_nonneg (norm_nonneg _) _)) (norm_nonneg _)
  have hs : ‖sourceBesselNormalizer h * ramifiedArithmeticResidue v t h‖ ≤
      (∑ i : RamifiedSixBranch, ramifiedSixWeightBound v t i) * D := by
    have he : sourceBesselNormalizer h * ramifiedArithmeticResidue v t h =
        ∑ i : RamifiedSixBranch, ramifiedSixWeight v t h i (4 / 3) *
          (sourceBesselNormalizer h * unramifiedGaussResidue (ramifiedSixIndex v t h i)) := by
      rw [ramifiedArithmeticResidue, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i hi
      ring
    rw [he, Finset.sum_mul]
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum ?_)
    intro i hi
    by_cases hw : ramifiedSixWeight v t h i (4 / 3) = 0
    · rw [hw, zero_mul, norm_zero]
      exact mul_nonneg (ramifiedSixWeightBound_nonneg v t i) hD
    rw [norm_mul, ramifiedSixIndex_multiplier v t h i hw]
    exact mul_le_mul (ramifiedSixWeight_norm_bound v t h i)
      (normalizedRamifiedGaussTerm_squarefree_cube_bound (ramifiedSixUnit v t i) (ramifiedSixPower i)
        I J hI hJ hsq u m) (norm_nonneg _) (ramifiedSixWeightBound_nonneg v t i)
  have he : ramifiedResidualFourierCoefficient v t h =
      ((3 : ℂ) ^ (4 / 3 : ℂ) / ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ)) *
        (sourceBesselNormalizer h * ramifiedArithmeticResidue v t h) := by
    unfold ramifiedResidualFourierCoefficient sourceBesselNormalizer
    ring
  change ‖ramifiedResidualFourierCoefficient v t h‖ ≤ _
  rw [he, norm_mul]
  exact (mul_le_mul_of_nonneg_left hs (norm_nonneg _)).trans_eq
    (by unfold ramifiedCoefficientBaseBound; dsimp only [D]; ring)

lemma squarefreeCube_scale_le_norm_third (I J : Ideal O)
    (hI : primaryIdealGenerator I ≠ 0) (u : Oˣ) (m : ℕ) :
    ‖ringComplex ((u : O) * lambda ^ m)‖ ^ (1 / 3 : ℝ) * ‖ringComplex (primaryIdealGenerator J)‖ ≤
      ‖ringComplex (((u : O) * lambda ^ m) * primaryIdealGenerator I * (primaryIdealGenerator J) ^ 3)‖ ^ (1 / 3 : ℝ) := by
  have hn : 1 ≤ ‖ringComplex (primaryIdealGenerator I)‖ := by
    have hs := one_le_normSq_embedding (primaryIdealGenerator I) hI
    rw [Complex.normSq_eq_norm_sq] at hs
    have hp := norm_nonneg (ringComplex (primaryIdealGenerator I))
    nlinarith only [hs, hp]
  have hn' := Real.one_le_rpow hn (by norm_num : (0 : ℝ) ≤ 1 / 3)
  have hc : (‖ringComplex (primaryIdealGenerator J)‖ ^ 3) ^ (1 / 3 : ℝ) =
      ‖ringComplex (primaryIdealGenerator J)‖ := by
    rw [← Real.rpow_natCast_mul (norm_nonneg _)]
    norm_num
  conv_rhs => rw [map_mul, map_mul, map_pow, norm_mul, norm_mul, norm_pow]
  rw [Real.mul_rpow (mul_nonneg (norm_nonneg _) (norm_nonneg _)) (pow_nonneg (norm_nonneg _) _),
    Real.mul_rpow (norm_nonneg _) (norm_nonneg _), hc]
  exact mul_le_mul_of_nonneg_right
    (le_mul_of_one_le_right (Real.rpow_nonneg (norm_nonneg _) _) hn') (norm_nonneg _)

/-- Squarefree–cube support and its sharp coefficient bound imply cubic-root growth. -/
lemma coefficient_polynomial_of_squarefree_cube_support (F : O → ℂ) (C : ℝ) (hC : 0 ≤ C)
    (hsupport : ∀ h : O, h ≠ 0 → F h ≠ 0 → ∃ (u : Oˣ) (m : ℕ) (I J : Ideal O),
      Squarefree I ∧ primaryIdealGenerator I ≠ 0 ∧ primaryIdealGenerator J ≠ 0 ∧
      h = ((u : O) * lambda ^ m) * primaryIdealGenerator I * (primaryIdealGenerator J) ^ 3)
    (hbound : ∀ (I J : Ideal O), primaryIdealGenerator I ≠ 0 → primaryIdealGenerator J ≠ 0 → Squarefree I →
      ∀ (u : Oˣ) (m : ℕ),
      ‖F (((u : O) * lambda ^ m) * primaryIdealGenerator I * (primaryIdealGenerator J) ^ 3)‖ ≤
        C * ‖ringComplex ((u : O) * lambda ^ m)‖ ^ (1 / 3 : ℝ) * ‖ringComplex (primaryIdealGenerator J)‖)
    (h : O) (hh : h ≠ 0) : ‖F h‖ ≤ C * ‖ringComplex h‖ ^ (1 / 3 : ℝ) := by
  by_cases hz : F h = 0
  · rw [hz, norm_zero]
    exact mul_nonneg hC (Real.rpow_nonneg (norm_nonneg _) _)
  obtain ⟨u, m, I, J, hsq, hI, hJ, rfl⟩ := hsupport h hh hz
  refine (hbound I J hI hJ hsq u m).trans ?_
  rw [mul_assoc]
  exact mul_le_mul_of_nonneg_left (squarefreeCube_scale_le_norm_third I J hI u m) hC

theorem unramifiedResidualCoefficient_polynomial_bound (h : O) (hh : h ≠ 0) :
    ‖unramifiedResidualCoefficient h‖ ≤ unramifiedCoefficientBaseBound * ‖ringComplex h‖ ^ (1 / 3 : ℝ) :=
  coefficient_polynomial_of_squarefree_cube_support _ _ unramifiedCoefficientBaseBound_nonneg
    unramifiedResidualCoefficient_full_squarefree_cube_support
    unramifiedResidualCoefficient_squarefree_cube_bound h hh

theorem rationalSourceResidualFourierCoefficient_polynomial_bound (h : O) (hh : h ≠ 0) :
    ‖rationalSourceResidualFourierCoefficient h‖ ≤ sourceCoefficientBaseBound * ‖ringComplex h‖ ^ (1 / 3 : ℝ) :=
  coefficient_polynomial_of_squarefree_cube_support _ _ sourceCoefficientBaseBound_nonneg
    rationalSourceResidualFourierCoefficient_full_squarefree_cube_support
    rationalSourceResidualFourierCoefficient_squarefree_cube_bound h hh

theorem ramifiedBesselCoefficient_polynomial_bound (side : Bool) (h : O) (hh : h ≠ 0) :
    ‖ramifiedBesselCoefficient side h‖ ≤
      ramifiedCoefficientBaseBound (ramifiedCuspRoot side) (ramifiedCuspScaleUnit side) * ‖ringComplex h‖ ^ (1 / 3 : ℝ) :=
  coefficient_polynomial_of_squarefree_cube_support _ _ (ramifiedCoefficientBaseBound_nonneg _ _)
    (ramifiedBesselCoefficient_full_squarefree_cube_support side)
    (ramifiedResidualFourierCoefficient_squarefree_cube_bound _ _) h hh

abbrev ThetaPrimaryCubePair :=
  {I : Ideal O // Squarefree I ∧ primaryIdealGenerator I ≠ 0} × GoodIdeal

def thetaPrimaryProduct (p : ThetaPrimaryCubePair) : GoodIdeal :=
  ⟨p.1.val * p.2.val ^ 3, by
    rw [primaryIdealGenerator_mul, primaryIdealGenerator_pow]
    exact mul_ne_zero p.1.property.2 (pow_ne_zero 3 p.2.property)⟩

lemma thetaPrimaryProduct_injective : Function.Injective thetaPrimaryProduct := by
  intro p q he
  have hi : p.1.val * p.2.val ^ 3 = q.1.val * q.2.val ^ 3 := congrArg Subtype.val he
  obtain ⟨hI, hJ⟩ := squarefree_cube_decomposition_unique
    (primaryIdealGenerator_ne_zero_ideal _ p.2.property)
    (primaryIdealGenerator_ne_zero_ideal _ q.2.property) p.1.property.1 q.1.property.1 hi
  exact Prod.ext (Subtype.ext hI) (Subtype.ext hJ)

/-- Unit, ramified exponent, squarefree ideal, and cube ideal index the supported frequencies uniquely. -/
abbrev ThetaFullIndex := Oˣ × ℕ × ThetaPrimaryCubePair

def thetaFullFrequency (p : ThetaFullIndex) : O :=
  ((p.1 : O) * lambda ^ p.2.1) * primaryIdealGenerator p.2.2.1.val *
    (primaryIdealGenerator p.2.2.2.val) ^ 3

lemma thetaFullFrequency_product (p : ThetaFullIndex) :
    thetaFullFrequency p = (p.1 : O) *
      (lambda ^ p.2.1 * primaryIdealGenerator (thetaPrimaryProduct p.2.2).val) := by
  simp only [thetaFullFrequency, thetaPrimaryProduct, primaryIdealGenerator_mul, primaryIdealGenerator_pow]
  ring

lemma thetaFullFrequency_ne_zero (p : ThetaFullIndex) : thetaFullFrequency p ≠ 0 := by
  rw [thetaFullFrequency_product]
  exact mul_ne_zero p.1.ne_zero (mul_ne_zero (pow_ne_zero _ residue_lambda_prime.ne_zero)
    (thetaPrimaryProduct p.2.2).property)

lemma thetaFullFrequency_span (p : ThetaFullIndex) :
    Ideal.span {thetaFullFrequency p} = ramifiedIdeal ^ p.2.1 * (thetaPrimaryProduct p.2.2).val := by
  have hu : Ideal.span {(p.1 : O)} = (1 : Ideal O) := by
    rw [Ideal.one_eq_top]
    exact Ideal.span_singleton_eq_top.mpr p.1.isUnit
  rw [thetaFullFrequency_product, ← Ideal.span_singleton_mul_span_singleton, hu, one_mul,
    lambdaFactor_generator_span]

theorem thetaFullFrequency_injective : Function.Injective thetaFullFrequency := by
  rintro ⟨u, m, p⟩ ⟨v, n, q⟩ he
  have hs := congrArg (fun x : O => Ideal.span {x}) he
  rw [thetaFullFrequency_span, thetaFullFrequency_span] at hs
  have hmap : lambdaFactorMap (m, thetaPrimaryProduct p) = lambdaFactorMap (n, thetaPrimaryProduct q) :=
    Subtype.ext hs
  have hij := lambdaFactorMap_bijective.1 hmap
  have hmn : m = n := congrArg Prod.fst hij
  have hpq : p = q := thetaPrimaryProduct_injective (congrArg Prod.snd hij)
  subst n
  subst q
  have huv : u = v := by
    apply Units.ext
    apply mul_right_cancel₀ (mul_ne_zero (pow_ne_zero m residue_lambda_prime.ne_zero)
      (thetaPrimaryProduct p).property)
    simpa only [thetaFullFrequency_product] using he
  subst v
  rfl

/-- Reindex every supported nonzero Fourier sum without introducing multiplicities. -/
theorem thetaFullFrequency_tsum (c w : O → ℂ)
    (hsupp : ∀ h : O, h ≠ 0 → c h ≠ 0 → ∃ p : ThetaFullIndex, thetaFullFrequency p = h) :
    (∑' h : {h : O // h ≠ 0}, w h.val * c h.val) =
      ∑' p : ThetaFullIndex, w (thetaFullFrequency p) * c (thetaFullFrequency p) := by
  let φ : ThetaFullIndex → {h : O // h ≠ 0} := fun p => ⟨thetaFullFrequency p, thetaFullFrequency_ne_zero p⟩
  let f : {h : O // h ≠ 0} → ℂ := fun h => w h.val * c h.val
  have hinj : Function.Injective φ := fun p q hpq => thetaFullFrequency_injective (congrArg Subtype.val hpq)
  change (∑' h, f h) = ∑' p, f (φ p)
  apply tsum_eq_tsum_of_ne_zero_bij (fun p : Function.support (fun p : ThetaFullIndex => f (φ p)) => φ p.val)
  · exact hinj.comp Subtype.val_injective
  · intro h hh
    have hc : c h.val ≠ 0 := by intro hz; exact hh (by simp only [f, hz, mul_zero])
    obtain ⟨p, hp⟩ := hsupp h.val h.property hc
    have hφ : φ p = h := Subtype.ext hp
    exact ⟨⟨p, by change f (φ p) ≠ 0; rwa [hφ]⟩, hφ⟩
  · intro p
    rfl

theorem sourceFourier_tsum_full_index (w : O → ℂ) :
    (∑' h : {h : O // h ≠ 0}, w h.val * star (rationalSourceResidualFourierCoefficient h.val)) =
      ∑' p : ThetaFullIndex, w (thetaFullFrequency p) *
        star (rationalSourceResidualFourierCoefficient (thetaFullFrequency p)) := by
  apply thetaFullFrequency_tsum (fun h => star (rationalSourceResidualFourierCoefficient h)) w
  intro h hh hc
  have hn : rationalSourceResidualFourierCoefficient h ≠ 0 := by
    intro hz
    exact hc (by rw [hz, star_zero])
  obtain ⟨u, m, I, J, hsq, hI, hJ, he⟩ :=
    rationalSourceResidualFourierCoefficient_full_squarefree_cube_support h hh hn
  exact ⟨(u, m, (⟨I, hsq, hI⟩, ⟨J, hJ⟩)), he.symm⟩

theorem ramifiedFourier_tsum_full_index (side : Bool) (w : O → ℂ) :
    (∑' h : {h : O // h ≠ 0}, w h.val * star (ramifiedBesselCoefficient side h.val)) =
      ∑' p : ThetaFullIndex, w (thetaFullFrequency p) * star (ramifiedBesselCoefficient side (thetaFullFrequency p)) := by
  apply thetaFullFrequency_tsum (fun h => star (ramifiedBesselCoefficient side h)) w
  intro h hh hc
  have hn : ramifiedBesselCoefficient side h ≠ 0 := by
    intro hz
    exact hc (by rw [hz, star_zero])
  obtain ⟨u, m, I, J, hsq, hI, hJ, he⟩ := ramifiedBesselCoefficient_full_squarefree_cube_support side h hh hn
  exact ⟨(u, m, (⟨I, hsq, hI⟩, ⟨J, hJ⟩)), he.symm⟩

/-- Cubic-root coefficient growth gives an absolutely summable fourth-power frequency weight. -/
lemma coefficient_weighted_summable_of_polynomial (F : O → ℂ) (C : ℝ) (hC : 0 ≤ C)
    (hF : ∀ h : O, h ≠ 0 → ‖F h‖ ≤ C * ‖ringComplex h‖ ^ (1 / 3 : ℝ)) :
    Summable (fun h : O => if h = 0 then (0 : ℝ) else ‖F h‖ * ‖cuspFrequency h‖ ^ (-4 : ℝ)) := by
  let D : ℝ := ‖(3 : ℂ) * ringComplex traceLambda‖
  have hD : 0 < D := norm_pos_iff.mpr (mul_ne_zero (by norm_num) (ringComplex_ne_zero traceLambda_ne_zero))
  have hp : 0 < D ^ (-4 : ℝ) := Real.rpow_pos_of_pos hD _
  have hs := (summable_embedding_rpow (-11 / 3) (by norm_num)).mul_left (C / D ^ (-4 : ℝ))
  apply Summable.of_nonneg_of_le (fun h => by split_ifs <;> positivity) _ hs
  intro h
  split_ifs with hh
  · exact mul_nonneg (div_nonneg hC hp.le) (Real.rpow_nonneg (norm_nonneg _) _)
  · have hx : 0 < ‖ringComplex h‖ := norm_pos_iff.mpr (ringComplex_ne_zero hh)
    have he : ‖ringComplex h‖ ^ (1 / 3 : ℝ) * ‖ringComplex h‖ ^ (-4 : ℝ) =
        ‖ringComplex h‖ ^ (-11 / 3 : ℝ) := by
      rw [← Real.rpow_add hx]
      congr 1
      norm_num
    calc
      _ ≤ (C * ‖ringComplex h‖ ^ (1 / 3 : ℝ)) * ‖cuspFrequency h‖ ^ (-4 : ℝ) :=
        mul_le_mul_of_nonneg_right (hF h hh) (Real.rpow_nonneg (norm_nonneg _) _)
      _ = (C / D ^ (-4 : ℝ)) * (‖ringComplex h‖ ^ (1 / 3 : ℝ) * ‖ringComplex h‖ ^ (-4 : ℝ)) := by
        rw [cuspFrequency, norm_div, Real.div_rpow (norm_nonneg _) (norm_nonneg _)]
        change (C * ‖ringComplex h‖ ^ (1 / 3 : ℝ)) * (‖ringComplex h‖ ^ (-4 : ℝ) / D ^ (-4 : ℝ)) = _
        ring
      _ = _ := by rw [he]

theorem sourceCoefficient_weighted_summable :
    Summable (fun h : O => if h = 0 then (0 : ℝ) else
      ‖rationalSourceResidualFourierCoefficient h‖ * ‖cuspFrequency h‖ ^ (-4 : ℝ)) :=
  coefficient_weighted_summable_of_polynomial _ _ sourceCoefficientBaseBound_nonneg
    rationalSourceResidualFourierCoefficient_polynomial_bound

theorem ramifiedCoefficient_weighted_summable (side : Bool) :
    Summable (fun h : O => if h = 0 then (0 : ℝ) else
      ‖ramifiedBesselCoefficient side h‖ * ‖cuspFrequency h‖ ^ (-4 : ℝ)) :=
  coefficient_weighted_summable_of_polynomial _ _ (ramifiedCoefficientBaseBound_nonneg _ _)
    (ramifiedBesselCoefficient_polynomial_bound side)

def sourceCuspCoefficient (j : Fin 3) : O → ℂ :=
  ![rationalSourceResidualFourierCoefficient, ramifiedBesselCoefficient false, ramifiedBesselCoefficient true] j

def sourceCuspScale (j : Fin 3) : ℝ := ![1, 3, 3] j

lemma sourceCuspScale_pos (j : Fin 3) : 0 < sourceCuspScale j := by
  fin_cases j <;> norm_num [sourceCuspScale]

def sourceCuspCoefficientBound (j : Fin 3) : ℝ :=
  ![sourceCoefficientBaseBound,
    ramifiedCoefficientBaseBound (ramifiedCuspRoot false) (ramifiedCuspScaleUnit false),
    ramifiedCoefficientBaseBound (ramifiedCuspRoot true) (ramifiedCuspScaleUnit true)] j

lemma sourceCuspCoefficientBound_nonneg (j : Fin 3) : 0 ≤ sourceCuspCoefficientBound j := by
  fin_cases j
  · exact sourceCoefficientBaseBound_nonneg
  · exact ramifiedCoefficientBaseBound_nonneg _ _
  · exact ramifiedCoefficientBaseBound_nonneg _ _

theorem sourceCuspCoefficient_polynomial_bound (j : Fin 3) (h : O) (hh : h ≠ 0) :
    ‖sourceCuspCoefficient j h‖ ≤ sourceCuspCoefficientBound j * ‖ringComplex h‖ ^ (1 / 3 : ℝ) := by
  fin_cases j
  · exact rationalSourceResidualFourierCoefficient_polynomial_bound h hh
  · exact ramifiedBesselCoefficient_polynomial_bound false h hh
  · exact ramifiedBesselCoefficient_polynomial_bound true h hh

theorem sourceCuspCoefficient_weighted_summable (j : Fin 3) :
    Summable (fun h : O => if h = 0 then (0 : ℝ) else
      ‖sourceCuspCoefficient j h‖ * ‖cuspFrequency h‖ ^ (-4 : ℝ)) :=
  coefficient_weighted_summable_of_polynomial _ _ (sourceCuspCoefficientBound_nonneg j)
    (sourceCuspCoefficient_polynomial_bound j)

theorem sourceCuspCoefficient_tsum_full_index (j : Fin 3) (w : O → ℂ) :
    (∑' h : {h : O // h ≠ 0}, w h.val * star (sourceCuspCoefficient j h.val)) =
      ∑' p : ThetaFullIndex, w (thetaFullFrequency p) * star (sourceCuspCoefficient j (thetaFullFrequency p)) := by
  fin_cases j
  · exact sourceFourier_tsum_full_index w
  · exact ramifiedFourier_tsum_full_index false w
  · exact ramifiedFourier_tsum_full_index true w

def sourceCuspBarCoefficient (j : Fin 3) : O → ℂ :=
  ![sourceBarBesselCoefficient, ramifiedBarBesselCoefficient false, ramifiedBarBesselCoefficient true] j

lemma sourceCuspBarCoefficient_subexponential (j : Fin 3) (ε : ℝ) (hε : 0 < ε) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ h : O, h ≠ 0 →
      ‖sourceCuspBarCoefficient j h‖ ≤ C * Real.exp (ε * ‖cuspFrequency h‖) := by
  fin_cases j
  · exact sourceBarBesselCoefficient_subexponential ε hε
  · exact ramifiedBarBesselCoefficient_subexponential false ε hε
  · exact ramifiedBarBesselCoefficient_subexponential true ε hε

def sourceCuspZTerm (j : Fin 3) (z : ℂ) (v : ℝ) (h : O) : ℂ :=
  star (cubicBesselTerm (sourceCuspBarCoefficient j) h (v / sourceCuspScale j, z / (sourceCuspScale j : ℂ)))

theorem sourceCuspZFamily_series (j : Fin 3) (z : ℂ) (v : ℝ) (hv : 0 < v) :
    sourceCuspZFamily j z v = ∑' h : O, sourceCuspZTerm j z v h := by
  have h0 : cuspZProfile (fun w => star (cubicSourceResidualFunction w)) z v =
      ∑' h : O, star (cubicBesselTerm sourceBarBesselCoefficient h (v, z)) := by
    rw [conjugateSource_zProfile z v hv, cuspBarProfile_positive _ _ _ hv,
      cubicSource_wirtingerBar_bessel v hv z, tsum_star]
  have hr (side : Bool) : cuspZProfile
      (fun w => star (ramifiedSourceFunction (ramifiedCuspRoot side : O) w)) z v =
      ∑' h : O, star (cubicBesselTerm (ramifiedBarBesselCoefficient side) h (v / 3, z / 3)) := by
    rw [conjugateRamifiedSource_zProfile side z v hv, cuspBarProfile_positive _ _ _ hv,
      ramifiedSource_wirtingerBar_bessel side v hv z, tsum_star]
  fin_cases j
  · simpa [sourceCuspZFamily, sourceCuspZTerm, sourceCuspBarCoefficient, sourceCuspScale,
      cuspRepresentative, cuspParameter, lowerCuspMatrix_zero] using h0
  · simpa [sourceCuspZFamily, sourceCuspZTerm, sourceCuspBarCoefficient, sourceCuspScale,
      cuspRepresentative, cuspParameter, ramifiedSourceFunction, ramifiedCuspRoot, cuspOmegaUnit_val] using hr false
  · simpa [sourceCuspZFamily, sourceCuspZTerm, sourceCuspBarCoefficient, sourceCuspScale,
      cuspRepresentative, cuspParameter, ramifiedSourceFunction, ramifiedCuspRoot, cuspOmegaUnit_val] using hr true

theorem sourceCuspZTerm_summable (j : Fin 3) (z : ℂ) (v : ℝ) (hv : 0 < v) :
    Summable (sourceCuspZTerm j z v) := by
  apply Summable.of_norm
  simpa only [sourceCuspZTerm, norm_star] using
    cubicBesselTerm_summable_norm (sourceCuspBarCoefficient j) (sourceCuspBarCoefficient_subexponential j)
      (v / sourceCuspScale j, z / (sourceCuspScale j : ℂ)) (div_pos hv (sourceCuspScale_pos j))

lemma sourceCuspZTerm_zero (j : Fin 3) (z : ℂ) (v : ℝ) : sourceCuspZTerm j z v 0 = 0 := by
  simp only [sourceCuspZTerm, cubicBesselTerm, cubicBesselAmplitude, if_true, zero_mul, star_zero]

lemma sourceCuspBarCoefficient_eq (j : Fin 3) (h : O) :
    sourceCuspBarCoefficient j h =
      (2 * Real.pi * Complex.I * star (cuspFrequency h) / (sourceCuspScale j : ℂ)) * sourceCuspCoefficient j h := by
  fin_cases j
  · simp [sourceCuspBarCoefficient, sourceCuspScale, sourceCuspCoefficient, sourceBarBesselCoefficient]
  · simp [sourceCuspBarCoefficient, sourceCuspScale, sourceCuspCoefficient,
      ramifiedBarBesselCoefficient, ninthCuspFrequency_eq_third, star_div₀, mul_div_assoc]
  · simp [sourceCuspBarCoefficient, sourceCuspScale, sourceCuspCoefficient,
      ramifiedBarBesselCoefficient, ninthCuspFrequency_eq_third, star_div₀, mul_div_assoc]

lemma sourceCuspZTerm_bessel (j : Fin 3) (z : ℂ) (v : ℝ) (hv : 0 < v) (h : O) (hh : h ≠ 0) :
    sourceCuspZTerm j z v h =
      (-2 * Real.pi * Complex.I * cuspFrequency h / (sourceCuspScale j : ℂ)) *
        star (sourceCuspCoefficient j h) * ((v / sourceCuspScale j : ℝ) : ℂ) *
        schlafliBesselK (1 / 3) (4 * Real.pi * ‖cuspFrequency h‖ * (v / sourceCuspScale j)) *
          tracePhase (-cuspFrequency h * (z / (sourceCuspScale j : ℂ))) := by
  rw [sourceCuspZTerm, cubicBesselTerm, cubicBesselAmplitude, if_neg hh, sourceCuspBarCoefficient_eq]
  simp only [star_mul, star_div₀, star_star, Complex.star_def, map_ofNat,
    Complex.conj_ofReal, Complex.conj_I]
  rw [← Complex.star_def, star_schlafliBesselK_cubic _
    (mul_pos (mul_pos (by positivity) (norm_pos_iff.mpr (cuspFrequency_ne_zero h hh)))
      (div_pos hv (sourceCuspScale_pos j)))]
  rw [star_tracePhase, star_star, neg_mul]
  ring

def thetaFrequencyScale : ℂ := 1 / ((3 : ℂ) * ringComplex traceLambda)
def thetaBesselScale : ℝ := ‖thetaFrequencyScale‖

lemma thetaBesselScale_pos : 0 < thetaBesselScale :=
  norm_pos_iff.mpr (one_div_ne_zero (mul_ne_zero (by norm_num) (ringComplex_ne_zero traceLambda_ne_zero)))

lemma cuspFrequency_eq_thetaFrequencyScale (h : O) : cuspFrequency h = thetaFrequencyScale * ringComplex h := by
  unfold cuspFrequency thetaFrequencyScale
  ring

def sourceCuspRadialLength (h : O) : ℝ := if h = 0 then 1 else ‖ringComplex h‖ ^ 2
def sourceCuspRadialScale (j : Fin 3) : ℝ := thetaBesselScale / sourceCuspScale j

def sourceCuspRadialBaseCoefficient (j : Fin 3) (h : O) : ℂ :=
  (-2 * Real.pi * Complex.I * cuspFrequency h) * star (sourceCuspCoefficient j h) /
    ((sourceCuspScale j : ℂ) ^ 2 * (sourceCuspRadialLength h : ℂ))

def sourceCuspRadialCoefficient (j : Fin 3) (z : ℂ) (h : O) : ℂ :=
  sourceCuspRadialBaseCoefficient j h * tracePhase (-cuspFrequency h * (z / (sourceCuspScale j : ℂ)))

lemma sourceCuspRadialLength_pos (h : O) : 0 < sourceCuspRadialLength h := by
  by_cases hh : h = 0
  · simp only [sourceCuspRadialLength, if_pos hh, zero_lt_one]
  · rw [sourceCuspRadialLength, if_neg hh]
    exact sq_pos_of_pos (norm_pos_iff.mpr (ringComplex_ne_zero hh))

lemma sourceCuspRadialScale_pos (j : Fin 3) : 0 < sourceCuspRadialScale j :=
  div_pos thetaBesselScale_pos (sourceCuspScale_pos j)

lemma sourceCuspRadialCoefficient_norm (j : Fin 3) (z : ℂ) (h : O) :
    ‖sourceCuspRadialCoefficient j z h‖ = ‖sourceCuspRadialBaseCoefficient j h‖ := by
  rw [sourceCuspRadialCoefficient, norm_mul, tracePhase_norm, mul_one]

lemma sourceCuspRadialCoefficient_zero (j : Fin 3) (z : ℂ) : sourceCuspRadialCoefficient j z 0 = 0 := by
  simp only [sourceCuspRadialCoefficient, sourceCuspRadialBaseCoefficient, cuspFrequency,
    map_zero, zero_div, mul_zero, zero_mul]

lemma sourceCuspRadialLength_frequency (h : O) (hh : h ≠ 0) :
    ‖cuspFrequency h‖ = thetaBesselScale * Real.sqrt (sourceCuspRadialLength h) := by
  rw [cuspFrequency_eq_thetaFrequencyScale, norm_mul, sourceCuspRadialLength, if_neg hh,
    Real.sqrt_sq (norm_nonneg _)]
  rfl

/-- A radial coefficient is normalized so its Mellin series uses the squared frequency length. -/
def radialBesselProfile {ι : Type*} (length : ι → ℝ) (coefficient : ι → ℂ) (scale : ℝ) (v : ℝ) : ℂ :=
  ∑' h : ι, (coefficient h * (length h : ℂ)) * (v : ℂ) *
    schlafliBesselK (1 / 3) (4 * Real.pi * scale * Real.sqrt (length h) * v)

theorem sourceCuspZTerm_eq_radial (j : Fin 3) (z : ℂ) (v : ℝ) (hv : 0 < v) (h : O) :
    sourceCuspZTerm j z v h =
      (sourceCuspRadialCoefficient j z h * (sourceCuspRadialLength h : ℂ)) * (v : ℂ) *
        schlafliBesselK (1 / 3) (4 * Real.pi * sourceCuspRadialScale j *
          Real.sqrt (sourceCuspRadialLength h) * v) := by
  by_cases hh : h = 0
  · subst h
    rw [sourceCuspZTerm_zero, sourceCuspRadialCoefficient_zero]
    ring
  rw [sourceCuspZTerm_bessel j z v hv h hh, sourceCuspRadialLength_frequency h hh]
  rw [show 4 * Real.pi * (thetaBesselScale * Real.sqrt (sourceCuspRadialLength h)) * (v / sourceCuspScale j) =
    4 * Real.pi * sourceCuspRadialScale j * Real.sqrt (sourceCuspRadialLength h) * v by
      unfold sourceCuspRadialScale; ring]
  have hs := Complex.ofReal_ne_zero.mpr (sourceCuspScale_pos j).ne'
  have hl := Complex.ofReal_ne_zero.mpr (sourceCuspRadialLength_pos h).ne'
  simp only [sourceCuspRadialCoefficient, sourceCuspRadialBaseCoefficient, Complex.ofReal_div]
  field_simp [hs, hl]

theorem sourceCuspZFamily_eq_radialBesselProfile (j : Fin 3) (z : ℂ) (v : ℝ) (hv : 0 < v) :
    sourceCuspZFamily j z v =
      radialBesselProfile sourceCuspRadialLength (sourceCuspRadialCoefficient j z) (sourceCuspRadialScale j) v := by
  rw [sourceCuspZFamily_series j z v hv]
  exact tsum_congr (sourceCuspZTerm_eq_radial j z v hv)

theorem SourceCuspDatum.reflection_radial (d : SourceCuspDatum) (v : ℝ) (hv : 0 < v) :
    cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) d.point v =
      d.multiplier / (v : ℂ) ^ 2 *
        radialBesselProfile sourceCuspRadialLength (sourceCuspRadialCoefficient d.index d.dualPoint)
          (sourceCuspRadialScale d.index) ((d.heightScale * v)⁻¹) := by
  rw [d.reflection v hv, sourceCuspZFamily_eq_radialBesselProfile _ _ _
    (inv_pos.mpr (mul_pos d.heightScale_pos hv))]

lemma derivative_coefficient_weighted_summable (F : O → ℂ) (A : ℂ)
    (hF : Summable (fun h : O => if h = 0 then (0 : ℝ) else ‖F h‖ * ‖cuspFrequency h‖ ^ (-4 : ℝ))) :
    Summable (fun h : O => if h = 0 then (0 : ℝ) else
      ‖A * cuspFrequency h * star (F h)‖ * ‖cuspFrequency h‖ ^ (-5 : ℝ)) := by
  apply (hF.mul_left ‖A‖).congr
  intro h
  split_ifs with hh
  · rw [mul_zero]
  · have hx := norm_pos_iff.mpr (cuspFrequency_ne_zero h hh)
    have hp : ‖cuspFrequency h‖ * ‖cuspFrequency h‖ ^ (-5 : ℝ) = ‖cuspFrequency h‖ ^ (-4 : ℝ) := by
      conv_lhs => lhs; rw [← Real.rpow_one ‖cuspFrequency h‖]
      rw [← Real.rpow_add hx]
      norm_num
    rw [norm_mul, norm_mul, norm_star, ← hp]
    ring

lemma radial_inverse_weight (x : ℝ) (hx : 0 < x) : (x ^ 2) ^ (-3 / 2 : ℝ) / x ^ 2 = x ^ (-5 : ℝ) := by
  calc
    _ = (x ^ 2) ^ (-3 / 2 : ℝ) * (x ^ 2) ^ (-1 : ℝ) := by rw [Real.rpow_neg_one]; rfl
    _ = (x ^ 2) ^ (-5 / 2 : ℝ) := by
      rw [← Real.rpow_add (sq_pos_of_pos hx)]
      congr 1
      norm_num
    _ = _ := by
      rw [← Real.rpow_natCast_mul hx.le]
      congr 1
      norm_num

lemma radialCoefficient_weighted_summable_of_fourth (F : O → ℂ) (A : ℂ)
    (hF : Summable (fun h : O => if h = 0 then (0 : ℝ) else ‖F h‖ * ‖cuspFrequency h‖ ^ (-4 : ℝ))) :
    Summable (fun h : O => if h = 0 then (0 : ℝ) else
      ‖A * cuspFrequency h * star (F h) / ((‖ringComplex h‖ ^ 2 : ℝ) : ℂ)‖ *
        (‖ringComplex h‖ ^ 2) ^ (-3 / 2 : ℝ)) := by
  let D : ℝ := ‖(3 : ℂ) * ringComplex traceLambda‖
  have hD : 0 < D := norm_pos_iff.mpr (mul_ne_zero (by norm_num) (ringComplex_ne_zero traceLambda_ne_zero))
  have hp : D ^ (-5 : ℝ) ≠ 0 := (Real.rpow_pos_of_pos hD _).ne'
  apply ((derivative_coefficient_weighted_summable F A hF).mul_left (D ^ (-5 : ℝ))).congr
  intro h
  split_ifs with hh
  · rw [mul_zero]
  · have hx := norm_pos_iff.mpr (ringComplex_ne_zero hh)
    have hf : ‖cuspFrequency h‖ = ‖ringComplex h‖ / D := by rw [cuspFrequency, norm_div]
    have hw : D ^ (-5 : ℝ) * (‖ringComplex h‖ / D) ^ (-5 : ℝ) = ‖ringComplex h‖ ^ (-5 : ℝ) := by
      rw [Real.div_rpow hx.le hD.le]
      field_simp [hp]
    rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
    calc
      _ = ‖A * cuspFrequency h * star (F h)‖ * (D ^ (-5 : ℝ) * (‖ringComplex h‖ / D) ^ (-5 : ℝ)) := by rw [hf]; ring
      _ = ‖A * cuspFrequency h * star (F h)‖ * ‖ringComplex h‖ ^ (-5 : ℝ) := by rw [hw]
      _ = _ := by rw [← radial_inverse_weight _ hx]; ring

theorem sourceCuspRadialCoefficient_weighted_summable (j : Fin 3) (z : ℂ) :
    Summable (fun h : O => ‖sourceCuspRadialCoefficient j z h‖ *
      sourceCuspRadialLength h ^ (-3 / 2 : ℝ)) := by
  let A : ℂ := (-2 * Real.pi * Complex.I) / (sourceCuspScale j : ℂ) ^ 2
  have hs := radialCoefficient_weighted_summable_of_fourth (sourceCuspCoefficient j) A
    (sourceCuspCoefficient_weighted_summable j)
  apply hs.congr
  intro h
  by_cases hh : h = 0
  · subst h
    simp only [if_true, sourceCuspRadialCoefficient_zero, norm_zero, zero_mul]
  · rw [if_neg hh, sourceCuspRadialCoefficient_norm, sourceCuspRadialBaseCoefficient,
      sourceCuspRadialLength, if_neg hh]
    congr 1
    apply congrArg norm
    dsimp only [A]
    ring

lemma cubic_bessel_mellin_norm_scale (s : ℂ) (r : ℝ) (hr : 0 < r) :
    (∫ v : ℝ in Ioi 0, ‖(v : ℂ) ^ (2 * s) * schlafliBesselK (1 / 3) (4 * Real.pi * r * v)‖) =
      r ^ (-(2 * s.re + 1)) *
        (∫ v : ℝ in Ioi 0, ‖(v : ℂ) ^ (2 * s) * schlafliBesselK (1 / 3) (4 * Real.pi * v)‖) := by
  let g : ℝ → ℝ := fun v => ‖(v : ℂ) ^ (2 * s) * schlafliBesselK (1 / 3) (4 * Real.pi * v)‖
  have he (v : ℝ) (hv : 0 < v) :
      ‖(v : ℂ) ^ (2 * s) * schlafliBesselK (1 / 3) (4 * Real.pi * r * v)‖ =
        r ^ (-(2 * s.re)) * g (r * v) := by
    dsimp only [g]
    rw [norm_mul, norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos hv,
      Complex.norm_cpow_eq_rpow_re_of_pos (mul_pos hr hv)]
    simp only [show (2 * s).re = 2 * s.re by simp]
    rw [Real.mul_rpow hr.le hv.le, show 4 * Real.pi * r * v = 4 * Real.pi * (r * v) by ring]
    have hc : r ^ (-(2 * s.re)) * r ^ (2 * s.re) = 1 := by
      rw [← Real.rpow_add hr]
      simp only [neg_add_cancel, Real.rpow_zero]
    calc
      _ = (r ^ (-(2 * s.re)) * r ^ (2 * s.re)) *
          (v ^ (2 * s.re) * ‖schlafliBesselK (1 / 3) (4 * Real.pi * (r * v))‖) := by rw [hc, one_mul]
      _ = _ := by ring
  calc
    _ = ∫ v : ℝ in Ioi 0, r ^ (-(2 * s.re)) * g (r * v) := setIntegral_congr_fun measurableSet_Ioi he
    _ = r ^ (-(2 * s.re)) * (r⁻¹ * ∫ v : ℝ in Ioi 0, g v) := by
      rw [integral_const_mul, integral_comp_mul_left_Ioi g 0 hr]
      simp only [mul_zero, smul_eq_mul]
    _ = _ := by
      rw [← mul_assoc, ← Real.rpow_neg_one, ← Real.rpow_add hr]
      congr 2
      ring

lemma weighted_cubic_bessel_integral_norm (s freq a : ℂ) (hf : freq ≠ 0) :
    (∫ v : ℝ in Ioi 0, ‖a * ((v : ℂ) ^ (2 * s) *
      schlafliBesselK (1 / 3) (4 * Real.pi * ‖freq‖ * v))‖) =
      (‖a‖ * ‖freq‖ ^ (-(2 * s.re + 1))) *
        (∫ v : ℝ in Ioi 0, ‖(v : ℂ) ^ (2 * s) * schlafliBesselK (1 / 3) (4 * Real.pi * v)‖) := by
  simp only [norm_mul, integral_const_mul]
  have he := cubic_bessel_mellin_norm_scale s ‖freq‖ (norm_pos_iff.mpr hf)
  simp only [norm_mul] at he
  rw [he]
  ring

/-- Absolute integral bounds justify Mellin transformation of the Bessel series term by term. -/
theorem cubic_bessel_series_mellin {ι : Type*} [Countable ι]
    (freq a : ι → ℂ) (hf : ∀ i, freq i ≠ 0) (s : ℂ) (hs : -(1 / 3) < s.re)
    (ha : Summable (fun i => ‖a i‖ * ‖freq i‖ ^ (-(2 * s.re + 1)))) :
    (∫ v : ℝ in Ioi 0, ∑' i, a i * ((v : ℂ) ^ (2 * s) *
      schlafliBesselK (1 / 3) (4 * Real.pi * ‖freq i‖ * v))) =
      ∑' i, a i * (((2 : ℂ) ^ (2 * s - 1) * Complex.Gamma (s + 1 / 3) * Complex.Gamma (s + 2 / 3)) /
        ((4 * Real.pi * ‖freq i‖ : ℝ) : ℂ) ^ (2 * s + 1)) := by
  have hi (i : ι) := (source_cubic_bessel_mellin_integrable s (freq i) hs (hf i)).const_mul (a i)
  have hsum : Summable (fun i => ∫ v : ℝ in Ioi 0,
      ‖a i * ((v : ℂ) ^ (2 * s) * schlafliBesselK (1 / 3) (4 * Real.pi * ‖freq i‖ * v))‖) := by
    simp only [weighted_cubic_bessel_integral_norm s _ _ (hf _)]
    exact ha.mul_right _
  rw [← integral_tsum_of_summable_integral_norm hi hsum]
  apply tsum_congr
  intro i
  rw [integral_const_mul, source_cubic_bessel_mellin s (freq i) hs (hf i)]

lemma positive_sqrt_cpow_twice (r : ℝ) (hr : 0 < r) (s : ℂ) :
    (Real.sqrt r : ℂ) ^ (2 * s + 1) = (r : ℂ) ^ (s + 1 / 2) := by
  have he : (r : ℂ) = (Real.sqrt r : ℂ) * (Real.sqrt r : ℂ) := by
    rw [← pow_two, ← Complex.ofReal_pow, Real.sq_sqrt hr.le]
  conv_rhs => rw [he, Complex.mul_cpow_ofReal_nonneg (Real.sqrt_nonneg r) (Real.sqrt_nonneg r),
    ← Complex.cpow_add _ _ (Complex.ofReal_ne_zero.mpr (Real.sqrt_pos.mpr hr).ne')]
  congr 1
  ring

lemma radial_bessel_coefficient_norm (r q σ : ℝ) (hr : 0 < r) (hq : 0 < q) (a : ℂ) :
    ‖a * (r : ℂ)‖ * ‖((q * Real.sqrt r : ℝ) : ℂ)‖ ^ (-(2 * σ + 1)) =
      q ^ (-(2 * σ + 1)) * (‖a‖ * r ^ (1 / 2 - σ)) := by
  rw [norm_mul, Complex.norm_of_nonneg hr.le,
    Complex.norm_of_nonneg (mul_pos hq (Real.sqrt_pos.mpr hr)).le,
    Real.mul_rpow hq.le (Real.sqrt_nonneg r), Real.sqrt_eq_rpow, ← Real.rpow_mul hr.le]
  have hp : r * r ^ ((1 / 2) * (-(2 * σ + 1))) = r ^ (1 / 2 - σ) := by
    conv_lhs => lhs; rw [← Real.rpow_one r]
    rw [← Real.rpow_add hr]
    congr 1
    ring
  calc
    _ = q ^ (-(2 * σ + 1)) * (‖a‖ * (r * r ^ ((1 / 2) * (-(2 * σ + 1))))) := by ring
    _ = _ := by rw [hp]

lemma radial_bessel_coefficient_identity (r q : ℝ) (hr : 0 < r) (hq : 0 < q) (a B s : ℂ) :
    (a * (r : ℂ)) * (B / ((q * Real.sqrt r : ℝ) : ℂ) ^ (2 * s + 1)) =
      (B / (q : ℂ) ^ (2 * s + 1)) * (a * (r : ℂ) ^ (1 / 2 - s)) := by
  rw [Complex.ofReal_mul, Complex.mul_cpow_ofReal_nonneg hq.le (Real.sqrt_nonneg r),
    positive_sqrt_cpow_twice r hr s]
  have hp : (r : ℂ) / (r : ℂ) ^ (s + 1 / 2) = (r : ℂ) ^ (1 / 2 - s) := by
    have he := Complex.cpow_sub (1 : ℂ) (s + 1 / 2) (Complex.ofReal_ne_zero.mpr hr.ne')
    rw [Complex.cpow_one] at he
    simpa only [show (1 : ℂ) - (s + 1 / 2) = 1 / 2 - s by ring] using he.symm
  calc
    _ = (B / (q : ℂ) ^ (2 * s + 1)) * (a * ((r : ℂ) / (r : ℂ) ^ (s + 1 / 2))) := by ring
    _ = _ := by rw [hp]

theorem radialBesselProfile_mellin {ι : Type*} [Countable ι]
    (r : ι → ℝ) (hr : ∀ i, 0 < r i) (a : ι → ℂ) (q : ℝ) (hq : 0 < q)
    (s : ℂ) (hs : -(1 / 3) < s.re)
    (ha : Summable (fun i => ‖a i‖ * (r i) ^ (1 / 2 - s.re))) :
    mellin (radialBesselProfile r a q) (2 * s) =
      (((2 : ℂ) ^ (2 * s - 1) * Complex.Gamma (s + 1 / 3) * Complex.Gamma (s + 2 / 3)) /
        ((4 * Real.pi * q : ℝ) : ℂ) ^ (2 * s + 1)) * (∑' i, a i * (r i : ℂ) ^ (1 / 2 - s)) := by
  let f : ι → ℂ := fun i => ((q * Real.sqrt (r i) : ℝ) : ℂ)
  have hf (i : ι) : f i ≠ 0 := Complex.ofReal_ne_zero.mpr (mul_pos hq (Real.sqrt_pos.mpr (hr i))).ne'
  have hn (i : ι) : ‖f i‖ = q * Real.sqrt (r i) :=
    Complex.norm_of_nonneg (mul_pos hq (Real.sqrt_pos.mpr (hr i))).le
  have has : Summable (fun i => ‖a i * (r i : ℂ)‖ * ‖f i‖ ^ (-(2 * s.re + 1))) := by
    simp only [f, radial_bessel_coefficient_norm _ q s.re (hr _) hq]
    exact ha.mul_left _
  have hid := cubic_bessel_series_mellin f (fun i => a i * (r i : ℂ)) hf s hs has
  calc
    _ = ∫ v : ℝ in Ioi 0, ∑' i, (a i * (r i : ℂ)) * ((v : ℂ) ^ (2 * s) *
        schlafliBesselK (1 / 3) (4 * Real.pi * ‖f i‖ * v)) := by
      unfold mellin
      apply setIntegral_congr_fun measurableSet_Ioi
      intro v hv
      dsimp only [radialBesselProfile]
      simp only [smul_eq_mul]
      rw [← tsum_mul_left]
      apply tsum_congr
      intro i
      have hp : (v : ℂ) ^ (2 * s - 1) * (v : ℂ) = (v : ℂ) ^ (2 * s) := by
        conv_lhs => rhs; rw [← Complex.cpow_one (v : ℂ)]
        rw [← Complex.cpow_add _ _ (Complex.ofReal_ne_zero.mpr hv.ne'), sub_add_cancel]
      rw [hn i, show 4 * Real.pi * q * Real.sqrt (r i) * v = 4 * Real.pi * (q * Real.sqrt (r i)) * v by ring]
      change (v : ℂ) ^ (2 * s - 1) * _ = _
      linear_combination (a i * (r i : ℂ)) * schlafliBesselK (1 / 3) (4 * Real.pi * (q * Real.sqrt (r i)) * v) * hp
    _ = _ := by
      rw [hid, ← tsum_mul_left]
      apply tsum_congr
      intro i
      rw [hn i, show 4 * Real.pi * (q * Real.sqrt (r i)) = (4 * Real.pi * q) * Real.sqrt (r i) by ring]
      exact radial_bessel_coefficient_identity (r i) (4 * Real.pi * q) (hr i) (by positivity) (a i) _ s

/-- The Mellin factor of the cubic radial Bessel kernel. -/
def besselMellinFactor (q : ℝ) (s : ℂ) : ℂ :=
  ((2 : ℂ) ^ (2 * s - 1) * Complex.Gamma (s + 1 / 3) * Complex.Gamma (s + 2 / 3)) /
    ((4 * Real.pi * q : ℝ) : ℂ) ^ (2 * s + 1)

def inverseBesselMellinFactor (q : ℝ) (s : ℂ) : ℂ :=
  ((4 * Real.pi * q : ℝ) : ℂ) ^ (2 * s + 1) * (2 : ℂ) ^ (1 - 2 * s) *
    (Complex.Gamma (s + 1 / 3) * Complex.Gamma (s + 2 / 3))⁻¹

lemma inverseBesselMellinFactor_mul (q : ℝ) (hq : 0 < q) (s : ℂ)
    (hs : -(1 / 3) < s.re) :
    inverseBesselMellinFactor q s * besselMellinFactor q s = 1 := by
  have hq0 : (((4 * Real.pi * q : ℝ) : ℂ) ^ (2 * s + 1)) ≠ 0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (Complex.ofReal_ne_zero.mpr (by positivity)))
  have h1 : Complex.Gamma (s + 1 / 3) ≠ 0 := Complex.Gamma_ne_zero_of_re_pos (by simp; linarith)
  have h2 : Complex.Gamma (s + 2 / 3) ≠ 0 := Complex.Gamma_ne_zero_of_re_pos (by simp; linarith)
  have hp : (2 : ℂ) ^ (1 - 2 * s) * (2 : ℂ) ^ (2 * s - 1) = 1 := by
    rw [← Complex.cpow_add _ _ (by norm_num : (2 : ℂ) ≠ 0)]
    simp
  unfold inverseBesselMellinFactor besselMellinFactor
  calc
    _ = ((((4 * Real.pi * q : ℝ) : ℂ) ^ (2 * s + 1)) /
          (((4 * Real.pi * q : ℝ) : ℂ) ^ (2 * s + 1))) *
        ((2 : ℂ) ^ (1 - 2 * s) * (2 : ℂ) ^ (2 * s - 1)) *
        ((Complex.Gamma (s + 1 / 3) * Complex.Gamma (s + 2 / 3))⁻¹ *
          (Complex.Gamma (s + 1 / 3) * Complex.Gamma (s + 2 / 3))) := by ring
    _ = 1 := by rw [div_self hq0, hp, inv_mul_cancel₀ (mul_ne_zero h1 h2)]; ring

/-- Removing the Bessel factor leaves an entire function whenever the cusp Mellin transform is entire. -/
def continuedBesselDirichlet (F : ℝ → ℂ) (q : ℝ) (s : ℂ) : ℂ :=
  inverseBesselMellinFactor q s * mellin F (2 * s)

lemma sourceCuspRadialLength_one_le (h : O) : 1 ≤ sourceCuspRadialLength h := by
  by_cases hh : h = 0
  · simp only [sourceCuspRadialLength, if_pos hh, le_refl]
  · rw [sourceCuspRadialLength, if_neg hh]
    simpa only [Complex.normSq_eq_norm_sq] using one_le_normSq_embedding h hh

theorem sourceCuspRadialCoefficient_summable (j : Fin 3) (z : ℂ) (σ : ℝ) (hσ : 2 ≤ σ) :
    Summable (fun h : O => ‖sourceCuspRadialCoefficient j z h‖ *
      sourceCuspRadialLength h ^ (1 / 2 - σ)) := by
  apply (sourceCuspRadialCoefficient_weighted_summable j z).of_nonneg_of_le
    (fun h => mul_nonneg (norm_nonneg _) (Real.rpow_nonneg (sourceCuspRadialLength_pos h).le _))
  intro h
  exact mul_le_mul_of_nonneg_left
    (Real.rpow_le_rpow_of_exponent_le (sourceCuspRadialLength_one_le h) (by linarith)) (norm_nonneg _)

def sourceCuspRadialDirichlet (j : Fin 3) (z s : ℂ) : ℂ :=
  ∑' h : O, sourceCuspRadialCoefficient j z h * (sourceCuspRadialLength h : ℂ) ^ (1 / 2 - s)

/-- The actual cusp expansion, Mellin transformed in its half-plane of absolute convergence. -/
theorem sourceCuspZFamily_mellin (j : Fin 3) (z s : ℂ) (hs : 2 ≤ s.re) :
    mellin (sourceCuspZFamily j z) (2 * s) =
      besselMellinFactor (sourceCuspRadialScale j) s * sourceCuspRadialDirichlet j z s := by
  letI : Countable O := Coordinates.coordinateEquiv.injective.countable
  have he : mellin (sourceCuspZFamily j z) (2 * s) =
      mellin (radialBesselProfile sourceCuspRadialLength (sourceCuspRadialCoefficient j z)
        (sourceCuspRadialScale j)) (2 * s) := by
    unfold mellin
    apply setIntegral_congr_fun measurableSet_Ioi
    intro v hv
    dsimp only
    rw [sourceCuspZFamily_eq_radialBesselProfile j z v hv]
  rw [he]
  exact radialBesselProfile_mellin sourceCuspRadialLength sourceCuspRadialLength_pos
    (sourceCuspRadialCoefficient j z) (sourceCuspRadialScale j) (sourceCuspRadialScale_pos j)
    s (by linarith) (sourceCuspRadialCoefficient_summable j z s.re hs)

theorem sourceCuspZFamily_dirichlet (j : Fin 3) (z s : ℂ) (hs : 2 ≤ s.re) :
    continuedBesselDirichlet (sourceCuspZFamily j z) (sourceCuspRadialScale j) s =
      sourceCuspRadialDirichlet j z s := by
  rw [continuedBesselDirichlet, sourceCuspZFamily_mellin j z s hs, ← mul_assoc,
    inverseBesselMellinFactor_mul _ (sourceCuspRadialScale_pos j) s (by linarith), one_mul]

/-- The reflected cubic Gamma ratio; its argument is the Mellin variable of the smoothing kernel. -/
def cubicReflectionGamma (w : ℂ) : ℂ :=
  (Complex.Gamma (7 / 6 + w) * Complex.Gamma (5 / 6 + w)) /
    (Complex.Gamma (7 / 6 - w) * Complex.Gamma (5 / 6 - w))

def besselReflectionFactor (q d : ℝ) (s : ℂ) : ℂ :=
  ((4 * Real.pi * q : ℝ) : ℂ) ^ (2 * s + 1) * (2 : ℂ) ^ (2 - 4 * s) /
    ((4 * Real.pi * d : ℝ) : ℂ) ^ (3 - 2 * s)

lemma besselMellinFactor_reflection (q d : ℝ) (s : ℂ) :
    inverseBesselMellinFactor q s * besselMellinFactor d (1 - s) =
      besselReflectionFactor q d s * cubicReflectionGamma (1 / 2 - s) := by
  have hp : (2 : ℂ) ^ (1 - 2 * s) * (2 : ℂ) ^ (1 - 2 * s) = (2 : ℂ) ^ (2 - 4 * s) := by
    rw [← Complex.cpow_add _ _ (by norm_num : (2 : ℂ) ≠ 0)]
    congr 1
    ring
  unfold inverseBesselMellinFactor besselMellinFactor besselReflectionFactor cubicReflectionGamma
  rw [show (2 : ℂ) * (1 - s) - 1 = 1 - 2 * s by ring,
    show (2 : ℂ) * (1 - s) + 1 = 3 - 2 * s by ring,
    show (1 : ℂ) - s + 1 / 3 = 4 / 3 - s by ring,
    show (1 : ℂ) - s + 2 / 3 = 5 / 3 - s by ring,
    show (7 / 6 : ℂ) + (1 / 2 - s) = 5 / 3 - s by ring,
    show (5 / 6 : ℂ) + (1 / 2 - s) = 4 / 3 - s by ring,
    show (7 / 6 : ℂ) - (1 / 2 - s) = s + 2 / 3 by ring,
    show (5 / 6 : ℂ) - (1 / 2 - s) = s + 1 / 3 by ring]
  have he := congrArg (fun x : ℂ =>
    (((4 * Real.pi * q : ℝ) : ℂ) ^ (2 * s + 1) *
      (Complex.Gamma (s + 1 / 3))⁻¹ * (Complex.Gamma (s + 2 / 3))⁻¹ *
      Complex.Gamma (4 / 3 - s) * Complex.Gamma (5 / 3 - s) *
      (((4 * Real.pi * d : ℝ) : ℂ) ^ (3 - 2 * s))⁻¹) * x) hp
  simp only [div_eq_mul_inv, mul_inv_rev] at he ⊢
  linear_combination he

/-- Reflection of the actual source cusp, with an absolutely convergent dual Dirichlet series. -/
theorem SourceCuspDatum.dirichlet_reflection (d : SourceCuspDatum) (q : ℝ)
    (s : ℂ) (hs : s.re ≤ -1) :
    continuedBesselDirichlet
      (cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) d.point) q s =
      (d.multiplier * (d.heightScale : ℂ) ^ (2 - 2 * s) *
        besselReflectionFactor q (sourceCuspRadialScale d.index) s) *
        cubicReflectionGamma (1 / 2 - s) * sourceCuspRadialDirichlet d.index d.dualPoint (1 - s) := by
  have hs' : 2 ≤ (1 - s).re := by simp only [Complex.sub_re, Complex.one_re]; linarith
  have hm := sourceCuspZFamily_mellin d.index d.dualPoint (1 - s) hs'
  rw [show (2 : ℂ) * (1 - s) = 2 - 2 * s by ring] at hm
  rw [continuedBesselDirichlet, d.mellin_reflection, hm]
  calc
    _ = d.multiplier * (d.heightScale : ℂ) ^ (2 - 2 * s) *
        (inverseBesselMellinFactor q s * besselMellinFactor (sourceCuspRadialScale d.index) (1 - s)) *
        sourceCuspRadialDirichlet d.index d.dualPoint (1 - s) := by ring
    _ = _ := by rw [besselMellinFactor_reflection]; ring

lemma finiteMellin_linearCombination_eq {ι : Type*} [Fintype ι]
    (weight : ι → ℂ) (f : ι → ℝ → ℂ) (s : ℂ)
    (hc : ∀ i, MellinConvergent (f i) s) :
    mellin (fun v => ∑ i, weight i * f i v) s = ∑ i, weight i * mellin (f i) s := by
  have hi (i : ι) : Integrable
      (fun v : ℝ => (v : ℂ) ^ (s - 1) * (weight i * f i v))
      (volume.restrict (Set.Ioi 0)) := by
    have hh := (hc i).const_smul (weight i)
    simp only [MellinConvergent, smul_eq_mul, IntegrableOn] at hh
    convert! hh using 1
  unfold mellin
  simp only [smul_eq_mul, Finset.mul_sum]
  rw [integral_finsetSum _ (fun i _ => hi i)]
  apply Finset.sum_congr rfl
  intro i hmem
  rw [← integral_const_mul]
  exact integral_congr_ae (Eventually.of_forall (fun v => by ring))

/-- Finite arithmetic twists inherit the exact reflection into all three cusp series. -/
theorem traceTwistedBarProfile_dirichlet_reflection (c : O) (hc : c ≠ 0)
    [Fintype (O ⧸ Ideal.span {c})] (φ : (O ⧸ Ideal.span {c}) → ℂ)
    (q : ℝ) (s : ℂ) (hs : s.re ≤ -1) :
    continuedBesselDirichlet (traceTwistedBarProfile c hc φ) q s =
      ∑ h, finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 c hc) φ h *
        (((finiteTwistCusp c hc h).multiplier *
          ((finiteTwistCusp c hc h).heightScale : ℂ) ^ (2 - 2 * s) *
          besselReflectionFactor q (sourceCuspRadialScale (finiteTwistCusp c hc h).index) s) *
          cubicReflectionGamma (1 / 2 - s) *
          sourceCuspRadialDirichlet (finiteTwistCusp c hc h).index
            (finiteTwistCusp c hc h).dualPoint (1 - s)) := by
  unfold continuedBesselDirichlet traceTwistedBarProfile
  rw [finiteMellin_linearCombination_eq
      (finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 c hc) φ)
      (fun h => cuspBarProfile (fun w => star (cubicSourceResidualFunction w))
        (thetaFourierTranslation c h)) (2 * s)
      (fun h => (conjugateSource_finite_twist_cusp_mellin_entire (Quotient.out h) c hc).1 _),
    Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro h hh
  rw [← mul_assoc, mul_comm (inverseBesselMellinFactor q s), mul_assoc]
  congr 1
  rw [← finiteTwistCusp_point c hc h]
  exact (finiteTwistCusp c hc h).dirichlet_reflection q s hs

/-! The reciprocal Gamma bound follows from reflection, recurrence, and compactness.
Together with the Mellin strip bound, it permits Gaussian regularization of the contour. -/
namespace CubicGammaExponential
open scoped BigOperators Classical
open MeasureTheory
open Finset


lemma inverse_Gamma_shift (z : ℂ) (n : ℕ) :
    (Complex.Gamma z)⁻¹ = (∏ k ∈ Finset.range n, (z + k)) * (Complex.Gamma (z + n))⁻¹ := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [ih, Complex.one_div_Gamma_eq_self_mul_one_div_Gamma_add_one (z + n),
      Finset.prod_range_succ]
    push_cast
    ring

lemma norm_Gamma_le_real (z : ℂ) (hz : 0<z.re) :
    ‖Complex.Gamma z‖ ≤ Real.Gamma z.re := by
  rw [Complex.Gamma_eq_integral hz,Real.Gamma_eq_integral hz]
  unfold Complex.GammaIntegral
  refine (norm_integral_le_integral_norm _).trans_eq ?_
  apply setIntegral_congr_fun measurableSet_Ioi
  intro x hx
  dsimp only
  rw [norm_mul,Complex.norm_of_nonneg (Real.exp_pos (-x)).le,
    Complex.norm_cpow_eq_rpow_re_of_pos hx]
  simp

lemma norm_sin_le_exp_abs_im (z : ℂ) :
    ‖Complex.sin z‖ ≤ Real.exp |z.im| := by
  rw [Complex.sin,norm_div,norm_mul,Complex.norm_I,mul_one]
  norm_num only [Complex.norm_ofNat]
  apply (div_le_iff₀ (by norm_num : (0:ℝ)<2)).mpr
  calc
    _ ≤ ‖Complex.exp (-z*Complex.I)‖+‖Complex.exp (z*Complex.I)‖ := norm_sub_le _ _
    _ = Real.exp z.im+Real.exp (-z.im) := by simp [Complex.norm_exp]
    _ ≤ Real.exp |z.im|+Real.exp |z.im| :=
      add_le_add (Real.exp_le_exp.mpr (le_abs_self _)) (Real.exp_le_exp.mpr (neg_le_abs _))
    _ = _ := by ring

lemma Gamma_ne_zero_of_im_ne_zero (z : ℂ) (hz : z.im≠0) : Complex.Gamma z≠0 := by
  apply Complex.Gamma_ne_zero
  intro n he
  apply hz
  have h:=congrArg Complex.im he
  simpa using h

lemma inverse_Gamma_reflection (z : ℂ) (hz : z.im≠0) :
    (Complex.Gamma z)⁻¹=Complex.Gamma (1-z)*Complex.sin (Real.pi*z)/Real.pi := by
  have hg:=Gamma_ne_zero_of_im_ne_zero z hz
  have hh:=Gamma_ne_zero_of_im_ne_zero (1-z) (by simpa using hz)
  have hp : (Real.pi:ℂ)≠0:=Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
  have hs : Complex.sin (Real.pi*z)≠0 := by
    intro hs
    have he:=Complex.Gamma_mul_Gamma_one_sub z
    rw [hs,div_zero] at he
    exact (mul_ne_zero hg hh) he
  apply mul_left_cancel₀ hg
  rw [mul_inv_cancel₀ hg]
  symm
  calc
    _ = (Complex.Gamma z*Complex.Gamma (1-z))*Complex.sin (Real.pi*z)/Real.pi := by ring
    _ = 1 := by
      rw [Complex.Gamma_mul_Gamma_one_sub,div_mul_cancel₀ _ hs,div_self hp]

lemma inverse_Gamma_norm_of_left (z : ℂ) (hz : z.re<1) (hi : z.im≠0) :
    ‖(Complex.Gamma z)⁻¹‖ ≤ (Real.Gamma (1-z.re)/Real.pi)*Real.exp (Real.pi*|z.im|) := by
  rw [inverse_Gamma_reflection z hi,norm_div,norm_mul,
    Complex.norm_of_nonneg Real.pi_pos.le]
  have hgamma:=norm_Gamma_le_real (1-z) (by simp;linarith)
  have hsin:=norm_sin_le_exp_abs_im (Real.pi*z)
  simp only [Complex.sub_re,Complex.one_re] at hgamma
  have him : |((Real.pi:ℂ)*z).im|=Real.pi*|z.im| := by
    rw [Complex.mul_im]
    simp only [Complex.ofReal_re, Complex.ofReal_im, zero_mul, add_zero, abs_mul,
      abs_of_pos Real.pi_pos]
  rw [him] at hsin
  calc
    _ ≤ (Real.Gamma (1-z.re)*Real.exp (Real.pi*|z.im|))/Real.pi :=
      div_le_div_of_nonneg_right
        (mul_le_mul hgamma hsin (norm_nonneg _) (Real.Gamma_pos_of_pos (by linarith)).le)
        Real.pi_pos.le
    _ = _ := by ring

lemma inverse_Gamma_norm_le_shift_left (z : ℂ) (n : ℕ) (hi : 1 ≤ |z.im|) :
    ‖(Complex.Gamma z)⁻¹‖ ≤ ‖(Complex.Gamma (z-n))⁻¹‖ := by
  have he:=congrArg norm (inverse_Gamma_shift (z-n) n)
  simp only [sub_add_cancel,norm_mul] at he
  have hprod : 1 ≤ ‖∏k∈Finset.range n,(z-(n:ℂ)+k)‖ := by
    rw [norm_prod]
    calc
      1 = ∏ k ∈ Finset.range n, (1 : ℝ) := by simp
      _ ≤ ∏ k ∈ Finset.range n, ‖z - (n : ℂ) + k‖ := by
        apply Finset.prod_le_prod (fun _ _ => zero_le_one)
        intro k hk
        calc
          1 ≤ |z.im| := hi
          _ = |(z - (n : ℂ) + k).im| := by simp
          _ ≤ _ := Complex.abs_im_le_norm _
  rw [he]
  exact le_mul_of_one_le_left (norm_nonneg _) hprod

lemma real_Gamma_compact_bound (a b : ℝ) (ha : 0<a) :
    ∃C : ℝ,0<C ∧ ∀x∈Set.Icc a b,Real.Gamma x ≤ C := by
  have hc : ContinuousOn Real.Gamma (Set.Icc a b) :=
    Real.differentiableOn_Gamma_Ioi.continuousOn.mono (fun x hx=>ha.trans_le hx.1)
  obtain ⟨C,hC⟩:=(isCompact_Icc : IsCompact (Set.Icc a b)).bddAbove_image hc
  refine ⟨|C|+1,by positivity,?_⟩
  intro x hx
  exact (hC (Set.mem_image_of_mem _ hx)).trans (by linarith [le_abs_self C])

lemma inverse_Gamma_compact_strip_bound (a b : ℝ) :
    ∃C : ℝ,0<C ∧ ∀σ∈Set.Icc a b,∀t∈Set.Icc (-1:ℝ) 1,
      ‖(Complex.Gamma ((σ:ℂ)+t*Complex.I))⁻¹‖ ≤ C := by
  have hc : Continuous (fun p : ℝ×ℝ=>
      ‖(Complex.Gamma ((p.1:ℂ)+p.2*Complex.I))⁻¹‖) :=
    (Complex.differentiable_one_div_Gamma.continuous.comp (by fun_prop)).norm
  obtain ⟨C,hC⟩:=((isCompact_Icc : IsCompact (Set.Icc a b)).prod
    (isCompact_Icc : IsCompact (Set.Icc (-1:ℝ) 1))).bddAbove_image hc.continuousOn
  refine ⟨|C|+1,by positivity,?_⟩
  intro σ hσ t ht
  exact (hC ⟨(σ,t),⟨hσ,ht⟩,rfl⟩).trans (by linarith [le_abs_self C])

theorem inverse_Gamma_strip_exp_bound (a b : ℝ) :
    ∃C : ℝ,0<C ∧ ∀σ∈Set.Icc a b,∀t : ℝ,
      ‖(Complex.Gamma ((σ:ℂ)+t*Complex.I))⁻¹‖ ≤ C*Real.exp (Real.pi*|t|) := by
  obtain ⟨n,hn⟩:=exists_nat_gt b
  obtain ⟨Cg,hCg,hg⟩:=real_Gamma_compact_bound ((n:ℝ)+1-b) ((n:ℝ)+1-a) (by linarith)
  obtain ⟨Cc,hCc,hc⟩:=inverse_Gamma_compact_strip_bound a b
  refine ⟨Cc+Cg/Real.pi,by positivity,?_⟩
  intro σ hσ t
  have hexp : 1 ≤ Real.exp (Real.pi*|t|) := Real.one_le_exp (by positivity)
  by_cases ht:|t| ≤ 1
  · have hsmall:=hc σ hσ t (abs_le.mp ht)
    calc
      _ ≤ Cc := hsmall
      _ ≤ Cc+Cg/Real.pi := le_add_of_nonneg_right (by positivity)
      _ ≤ (Cc+Cg/Real.pi)*Real.exp (Real.pi*|t|) :=
        le_mul_of_one_le_right (by positivity) hexp
  · have ht1 : 1 < |t| :=lt_of_not_ge ht
    have ht0 : t≠0 := by intro ht0;subst t;norm_num at ht1
    let z : ℂ := (σ:ℂ)+t*Complex.I
    let w : ℂ := z-n
    have hw : w.re<1 := by
      dsimp [w,z]
      simp only [Complex.ofReal_re,Complex.mul_re,
        Complex.ofReal_im,Complex.I_re,Complex.I_im,mul_zero,zero_mul,
        sub_zero,add_zero]
      linarith [hσ.2]
    have hwi : w.im≠0 := by simpa [w,z] using ht0
    have he : 1-w.re=(n:ℝ)+1-σ := by simp [w,z];ring
    have hi : w.im=t := by simp [w,z]
    have hbound:=inverse_Gamma_norm_of_left w hw hwi
    rw [he,hi] at hbound
    have hgbound:=hg ((n:ℝ)+1-σ) ⟨by linarith [hσ.2],by linarith [hσ.1]⟩
    calc
      _ ≤ ‖(Complex.Gamma w)⁻¹‖ :=
        inverse_Gamma_norm_le_shift_left z n (by simpa [z] using ht1.le)
      _ ≤ (Real.Gamma ((n:ℝ)+1-σ)/Real.pi)*Real.exp (Real.pi*|t|) := hbound
      _ ≤ (Cg/Real.pi)*Real.exp (Real.pi*|t|) := by gcongr
      _ ≤ (Cc+Cg/Real.pi)*Real.exp (Real.pi*|t|) :=
        mul_le_mul_of_nonneg_right (le_add_of_nonneg_left hCc.le) (Real.exp_pos _).le

theorem inverse_Gamma_strip_exp_bound_complex (a b : ℝ) :
    ∃C : ℝ,0<C ∧ ∀z : ℂ,z.re∈Set.Icc a b →
      ‖(Complex.Gamma z)⁻¹‖ ≤ C*Real.exp (Real.pi*|z.im|) := by
  obtain ⟨C,hC,hb⟩:=inverse_Gamma_strip_exp_bound a b
  refine ⟨C,hC,?_⟩
  intro z hz
  simpa only [Complex.re_add_im] using hb z.re hz z.im

theorem inverse_cubic_Gamma_pair_strip_bound (a b : ℝ) :
    ∃C : ℝ,0<C ∧ ∀s : ℂ,s.re∈Set.Icc a b →
      ‖(Complex.Gamma (s+1/3)*Complex.Gamma (s+2/3))⁻¹‖ ≤ C*Real.exp (2*Real.pi*|s.im|) := by
  obtain ⟨C1,hC1,h1⟩:=inverse_Gamma_strip_exp_bound_complex (a+1/3) (b+1/3)
  obtain ⟨C2,hC2,h2⟩:=inverse_Gamma_strip_exp_bound_complex (a+2/3) (b+2/3)
  refine ⟨C1*C2,mul_pos hC1 hC2,?_⟩
  intro s hs
  have hb1:=h1 (s+1/3) (by norm_num;constructor <;> linarith [hs.1,hs.2])
  have hb2:=h2 (s+2/3) (by norm_num;constructor <;> linarith [hs.1,hs.2])
  norm_num at hb1 hb2
  rw [mul_inv_rev,norm_mul,norm_inv,norm_inv]
  calc
    _ ≤ (C2*Real.exp (Real.pi*|s.im|))*(C1*Real.exp (Real.pi*|s.im|)) :=
      mul_le_mul hb2 hb1 (by positivity) (by positivity)
    _ = C1*C2*Real.exp (2*Real.pi*|s.im|) := by
      rw [show 2*Real.pi*|s.im|=Real.pi*|s.im|+Real.pi*|s.im| by ring,Real.exp_add]
      ring

end CubicGammaExponential

lemma rpow_between_endpoints (y a b σ : ℝ) (hy : 0<y) (ha : a ≤ σ) (hb : σ ≤ b) :
    y^σ ≤ y^a+y^b := by
  by_cases h1 : 1 ≤ y
  · exact (Real.rpow_le_rpow_of_exponent_le h1 hb).trans
      (le_add_of_nonneg_left (Real.rpow_nonneg hy.le a))
  · exact (Real.rpow_le_rpow_of_exponent_ge hy (le_of_not_ge h1) ha).trans
      (le_add_of_nonneg_right (Real.rpow_nonneg hy.le b))

theorem mellin_uniform_strip_bound (f : ℝ→ℂ) (a b : ℝ)
    (ha : MellinConvergent f (a:ℂ)) (hb : MellinConvergent f (b:ℂ)) :
    ∃C : ℝ,0 ≤ C ∧ ∀s : ℂ,a ≤ s.re→s.re ≤ b→‖mellin f s‖ ≤ C := by
  let B : ℝ→ℝ := fun y=>‖(y:ℂ)^((a:ℂ)-1)*f y‖+‖(y:ℂ)^((b:ℂ)-1)*f y‖
  have hB : IntegrableOn B (Set.Ioi 0) := by
    exact ha.norm.add hb.norm
  refine ⟨∫y in Set.Ioi 0,B y,integral_nonneg (fun y=>add_nonneg (norm_nonneg _) (norm_nonneg _)),?_⟩
  intro s hsa hsb
  unfold mellin
  apply norm_integral_le_of_norm_le hB
  filter_upwards [ae_restrict_mem measurableSet_Ioi] with y hy
  change 0<y at hy
  have hp := rpow_between_endpoints y (a-1) (b-1) (s.re-1) hy (by linarith) (by linarith)
  change ‖(y:ℂ)^(s-1)*f y‖ ≤ B y
  dsimp only [B]
  simp only [norm_mul,Complex.norm_cpow_eq_rpow_re_of_pos hy,Complex.sub_re,
    Complex.ofReal_re,Complex.one_re]
  simpa only [add_mul] using mul_le_mul_of_nonneg_right hp (norm_nonneg (f y))

theorem inverseBesselMellinFactor_differentiable (q : ℝ) (hq : 0<q) :
    Differentiable ℂ (inverseBesselMellinFactor q) := by
  have hq0 : ((4*Real.pi*q:ℝ):ℂ)≠0 := Complex.ofReal_ne_zero.mpr (by positivity)
  have h1 : Differentiable ℂ (fun s : ℂ=>((4*Real.pi*q:ℝ):ℂ)^(2*s+1)) :=
    (show Differentiable ℂ (fun s : ℂ=>2*s+1) from by fun_prop).const_cpow (Or.inl hq0)
  have h2 : Differentiable ℂ (fun s : ℂ=>(2:ℂ)^(1-2*s)) :=
    (show Differentiable ℂ (fun s : ℂ=>1-2*s) from by fun_prop).const_cpow
      (Or.inl (by norm_num : (2:ℂ)≠0))
  have h3 : Differentiable ℂ (fun s : ℂ=>(Complex.Gamma (s+1/3))⁻¹) :=
    Complex.differentiable_one_div_Gamma.comp (by fun_prop)
  have h4 : Differentiable ℂ (fun s : ℂ=>(Complex.Gamma (s+2/3))⁻¹) :=
    Complex.differentiable_one_div_Gamma.comp (by fun_prop)
  convert! (h1.mul h2).mul (h4.mul h3) using 1
  ext s
  simp only [inverseBesselMellinFactor,Pi.mul_apply,mul_inv_rev]

theorem inverseBesselMellinFactor_strip_bound (q : ℝ) (hq : 0<q) (a b : ℝ) :
    ∃C : ℝ,0 ≤ C ∧ ∀s : ℂ,s.re∈Set.Icc a b →
      ‖inverseBesselMellinFactor q s‖ ≤ C*Real.exp (2*Real.pi*|s.im|) := by
  obtain ⟨Cg,hCg,hg⟩ := CubicGammaExponential.inverse_cubic_Gamma_pair_strip_bound a b
  let Ca := (4*Real.pi*q)^(2*a+1)+(4*Real.pi*q)^(2*b+1)
  let Cb := (2:ℝ)^(1-2*b)+(2:ℝ)^(1-2*a)
  have hqpos : 0<4*Real.pi*q := by positivity
  have hCa : 0 ≤ Ca := by dsimp [Ca];positivity
  have hCb : 0 ≤ Cb := by dsimp [Cb];positivity
  refine ⟨Ca*Cb*Cg,by positivity,?_⟩
  intro s hs
  have hp1 : ‖((4*Real.pi*q:ℝ):ℂ)^(2*s+1)‖ ≤ Ca := by
    rw [Complex.norm_cpow_eq_rpow_re_of_pos hqpos]
    have hr : (2*s+1).re=2*s.re+1 := by simp
    rw [hr]
    exact rpow_between_endpoints _ _ _ _ hqpos
      (by linarith [hs.1]) (by linarith [hs.2])
  have hp2 : ‖(2:ℂ)^(1-2*s)‖ ≤ Cb := by
    change ‖((2:ℝ):ℂ)^(1-2*s)‖ ≤ Cb
    rw [Complex.norm_cpow_eq_rpow_re_of_pos (by norm_num : 0<(2:ℝ))]
    have hr : (1-2*s).re=1-2*s.re := by simp
    rw [hr]
    exact rpow_between_endpoints _ _ _ _ (by norm_num)
      (by linarith [hs.2]) (by linarith [hs.1])
  simp only [inverseBesselMellinFactor,norm_mul]
  calc
    _ ≤ (Ca*Cb)*(Cg*Real.exp (2*Real.pi*|s.im|)) :=
      mul_le_mul (mul_le_mul hp1 hp2 (norm_nonneg _) hCa) (hg s hs)
        (norm_nonneg _) (mul_nonneg hCa hCb)
    _=_ := by ring

theorem continuedBesselDirichlet_differentiable (F : ℝ→ℂ) (q : ℝ) (hq : 0<q)
    (hF : Differentiable ℂ (mellin F)) :
    Differentiable ℂ (continuedBesselDirichlet F q) :=
  (inverseBesselMellinFactor_differentiable q hq).mul (hF.comp (by fun_prop))

theorem continuedBesselDirichlet_strip_bound (F : ℝ→ℂ) (q : ℝ) (hq : 0<q)
    (a b : ℝ) (ha : MellinConvergent F ((2*a:ℝ):ℂ))
    (hb : MellinConvergent F ((2*b:ℝ):ℂ)) :
    ∃C : ℝ,0 ≤ C ∧ ∀s : ℂ,s.re∈Set.Icc a b →
      ‖continuedBesselDirichlet F q s‖ ≤ C*Real.exp (2*Real.pi*|s.im|) := by
  obtain ⟨Ci,hCi,hi⟩ := inverseBesselMellinFactor_strip_bound q hq a b
  obtain ⟨Cm,hCm,hm⟩ := mellin_uniform_strip_bound F (2*a) (2*b) ha hb
  refine ⟨Ci*Cm,mul_nonneg hCi hCm,?_⟩
  intro s hs
  have hms : ‖mellin F (2*s)‖ ≤ Cm := hm (2*s)
    (by simp;linarith [hs.1]) (by simp;linarith [hs.2])
  rw [continuedBesselDirichlet,norm_mul]
  calc
    _ ≤ (Ci*Real.exp (2*Real.pi*|s.im|))*Cm :=
      mul_le_mul (hi s hs) hms (norm_nonneg _) (mul_nonneg hCi (Real.exp_pos _).le)
    _=_ := by ring



/-! Cauchy's theorem shifts the Gaussian-regularized contour. Dominated convergence
then removes the regulator using integrability on the two boundary lines. -/
namespace VerticalContourShift
open MeasureTheory Filter Set
open scoped Topology

theorem horizontal_integral_tendsto_zero
    (f : ℂ → ℂ) (a b C : ℝ) (hab : a ≤ b)
    (hbound : ∀ σ ∈ Icc a b, ∀ t : ℝ,
      ‖f ((σ : ℂ) + t * Complex.I)‖ ≤ C / (1 + t ^ 2)) :
    Tendsto (fun t : ℝ => ∫ σ : ℝ in a..b, f ((σ : ℂ) + t * Complex.I))
      atTop (𝓝 0) := by
  have ht : Tendsto (fun t : ℝ => 1 + t ^ 2) atTop atTop :=
    tendsto_atTop_add_const_left atTop 1 (tendsto_pow_atTop (by decide : (2 : ℕ) ≠ 0))
  have hz : Tendsto (fun t : ℝ => C / (1 + t ^ 2) * |b - a|) atTop (𝓝 0) := by
    simpa using (tendsto_const_nhds.div_atTop ht).mul_const |b - a|
  apply tendsto_zero_iff_norm_tendsto_zero.mpr
  apply squeeze_zero (fun _ => norm_nonneg _) _ hz
  intro t
  apply intervalIntegral.norm_integral_le_of_norm_le_const
  intro σ hσ
  exact hbound σ (Ioc_subset_Icc_self (by simpa [uIoc_of_le hab] using hσ)) t

theorem integral_eq_of_strip_decay
    (f : ℂ → ℂ) (a b C : ℝ) (hab : a ≤ b)
    (hdiff : ∀ z : ℂ, a ≤ z.re → z.re ≤ b → DifferentiableAt ℂ f z)
    (ha : Integrable (fun t : ℝ => f ((a : ℂ) + t * Complex.I)))
    (hb : Integrable (fun t : ℝ => f ((b : ℂ) + t * Complex.I)))
    (hbound : ∀ σ ∈ Icc a b, ∀ t : ℝ,
      ‖f ((σ : ℂ) + t * Complex.I)‖ ≤ C / (1 + t ^ 2)) :
    (∫ t : ℝ, f ((a : ℂ) + t * Complex.I)) =
      ∫ t : ℝ, f ((b : ℂ) + t * Complex.I) := by
  let H (t : ℝ) : ℂ := ∫ σ : ℝ in a..b, f ((σ : ℂ) + t * Complex.I)
  let V (σ t : ℝ) : ℂ := ∫ u : ℝ in -t..t, f ((σ : ℂ) + u * Complex.I)
  have htop : Tendsto H atTop (𝓝 0) := horizontal_integral_tendsto_zero f a b C hab hbound
  have hbottom : Tendsto (fun t : ℝ => H (-t)) atTop (𝓝 0) := by
    let g (z : ℂ) := f (star z)
    have hg : ∀ σ ∈ Icc a b, ∀ t : ℝ,
        ‖g ((σ : ℂ) + t * Complex.I)‖ ≤ C / (1 + t ^ 2) := by
      intro σ hσ t
      simpa [g] using hbound σ hσ (-t)
    convert horizontal_integral_tendsto_zero g a b C hab hg using 1 ;
      simp [g, H]
  have hVa : Tendsto (V a) atTop
      (𝓝 (∫ t : ℝ, f ((a : ℂ) + t * Complex.I))) :=
    intervalIntegral_tendsto_integral ha tendsto_neg_atTop_atBot tendsto_id
  have hVb : Tendsto (V b) atTop
      (𝓝 (∫ t : ℝ, f ((b : ℂ) + t * Complex.I))) :=
    intervalIntegral_tendsto_integral hb tendsto_neg_atTop_atBot tendsto_id
  have hrect (t : ℝ) : H (-t) - H t + Complex.I * V b t - Complex.I * V a t = 0 := by
    have hd : DifferentiableOn ℂ f
        (uIcc (((a : ℂ) - t * Complex.I).re) (((b : ℂ) + t * Complex.I).re) ×ℂ
         uIcc (((a : ℂ) - t * Complex.I).im) (((b : ℂ) + t * Complex.I).im)) := by
      intro z hz
      apply (hdiff z ?_ ?_).differentiableWithinAt
      · have hz' : z.re ∈ Icc a b := by
          simpa [uIcc_of_le hab] using hz.1
        exact hz'.1
      · have hz' : z.re ∈ Icc a b := by
          simpa [uIcc_of_le hab] using hz.1
        exact hz'.2
    have hr := Complex.integral_boundary_rect_eq_zero_of_differentiableOn f
      ((a : ℂ) - t * Complex.I) ((b : ℂ) + t * Complex.I) hd
    simpa [H, V, smul_eq_mul] using hr
  have hlim : Tendsto
      (fun t : ℝ => H (-t) - H t + Complex.I * V b t - Complex.I * V a t)
      atTop (𝓝 (0 - 0 + Complex.I * (∫ t : ℝ, f ((b : ℂ) + t * Complex.I)) -
        Complex.I * (∫ t : ℝ, f ((a : ℂ) + t * Complex.I)))) :=
    ((hbottom.sub htop).add (tendsto_const_nhds.mul hVb)).sub
      (tendsto_const_nhds.mul hVa)
  have heq : Complex.I * (∫ t : ℝ, f ((b : ℂ) + t * Complex.I)) -
      Complex.I * (∫ t : ℝ, f ((a : ℂ) + t * Complex.I)) = 0 := by
    have hzero : Tendsto (fun t : ℝ => H (-t) - H t + Complex.I * V b t - Complex.I * V a t)
        atTop (𝓝 0) := by
      simpa only [hrect] using (tendsto_const_nhds : Tendsto (fun _ : ℝ => (0 : ℂ)) atTop (𝓝 0))
    simpa using tendsto_nhds_unique hlim hzero
  exact (mul_left_cancel₀ Complex.I_ne_zero (sub_eq_zero.mp heq)).symm

end VerticalContourShift
namespace VerticalContourShift
lemma gaussian_regulator_norm (ε σ t : ℝ) :
    ‖Complex.exp ((ε:ℂ)*((σ:ℂ)+t*Complex.I)^2)‖=Real.exp (ε*(σ^2-t^2)) := by
  rw [Complex.norm_exp]
  congr 1
  simp only [pow_two,Complex.mul_re,Complex.mul_im,Complex.add_re,Complex.add_im,
    Complex.ofReal_re,Complex.ofReal_im,Complex.I_re,Complex.I_im]
  ring

lemma gaussian_regulator_norm_le (ε σ t : ℝ) (hε0 : 0 ≤ ε) (hε1 : ε ≤ 1) :
    ‖Complex.exp ((ε:ℂ)*((σ:ℂ)+t*Complex.I)^2)‖ ≤ Real.exp (σ^2) := by
  rw [gaussian_regulator_norm]
  apply Real.exp_le_exp.mpr
  nlinarith [sq_nonneg σ,sq_nonneg t,mul_nonneg hε0 (sq_nonneg t),
    mul_nonneg (sub_nonneg.mpr hε1) (sq_nonneg σ)]

def gaussianRegulatorSequence (n : ℕ) : ℝ := 1/((n:ℝ)+1)

lemma gaussianRegulatorSequence_pos (n : ℕ) : 0<gaussianRegulatorSequence n := by
  unfold gaussianRegulatorSequence
  positivity

lemma gaussianRegulatorSequence_le_one (n : ℕ) : gaussianRegulatorSequence n ≤ 1 := by
  unfold gaussianRegulatorSequence
  apply (div_le_one (by positivity)).mpr
  linarith [Nat.cast_nonneg (α:=ℝ) n]

lemma gaussianRegulatorSequence_tendsto : Tendsto gaussianRegulatorSequence atTop (𝓝 0) :=
  tendsto_one_div_add_atTop_nhds_zero_nat

theorem gaussian_regulator_integral_tendsto (g : ℝ→ℂ) (hg : Integrable g) (σ : ℝ) :
    Tendsto (fun n : ℕ=>∫t : ℝ,
      Complex.exp ((gaussianRegulatorSequence n:ℂ)*((σ:ℂ)+t*Complex.I)^2)*g t)
      atTop (𝓝 (∫t : ℝ,g t)) := by
  apply tendsto_integral_of_dominated_convergence
    (fun t : ℝ=>Real.exp (σ^2)*‖g t‖)
  · intro n
    have hc : Continuous (fun t : ℝ=>
        Complex.exp ((gaussianRegulatorSequence n:ℂ)*((σ:ℂ)+t*Complex.I)^2)) := by fun_prop
    exact hc.aestronglyMeasurable.mul hg.aestronglyMeasurable
  · exact hg.norm.const_mul _
  · intro n
    exact Filter.Eventually.of_forall (fun t=>by
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_right
        (gaussian_regulator_norm_le _ σ t (gaussianRegulatorSequence_pos n).le
          (gaussianRegulatorSequence_le_one n)) (norm_nonneg _))
  · filter_upwards with t
    have hε : Tendsto (fun n : ℕ=>(gaussianRegulatorSequence n:ℂ)) atTop (𝓝 0) :=
      by simpa only [Function.comp_def,Complex.ofReal_zero] using
        Complex.continuous_ofReal.continuousAt.tendsto.comp gaussianRegulatorSequence_tendsto
    have he := (Complex.continuous_exp.tendsto 0).comp
      (by simpa only [zero_mul] using hε.mul_const (((σ:ℂ)+t*Complex.I)^2))
    simpa only [Function.comp_def,Complex.exp_zero,one_mul] using he.mul_const (g t)


end VerticalContourShift
namespace GaussianMoment
theorem x_exp_neg_le (x : ℝ) (_hx : 0 ≤ x) :
    x * Real.exp (-x) ≤ 2 * Real.exp (-(x / 2)) := by
  have hlin : x / 2 ≤ Real.exp (x / 2) := by
    have h := Real.add_one_le_exp (x / 2)
    linarith
  have hmul := mul_le_mul_of_nonneg_right hlin (Real.exp_pos (-x)).le
  calc
    x * Real.exp (-x) = 2 * ((x / 2) * Real.exp (-x)) := by ring
    _ ≤ 2 * (Real.exp (x / 2) * Real.exp (-x)) := by
      gcongr
    _ = 2 * Real.exp (-(x / 2)) := by
      rw [← Real.exp_add]
      congr 1
      ring_nf

theorem gaussian_moment_term_bound (q t : ℝ) (hq : 0 ≤ q) (ht : 0 < t) :
    q * Real.exp (-t * q) ≤ (2 / t) * Real.exp (-(t * q / 2)) := by
  have h := x_exp_neg_le (t * q) (mul_nonneg ht.le hq)
  have hpos : 0 ≤ t := ht.le
  calc
    q * Real.exp (-t * q) =
        ((t * q) * Real.exp (-(t * q))) / t := by
          field_simp
    _ ≤ (2 * Real.exp (-(t * q / 2))) / t :=
      div_le_div_of_nonneg_right h hpos
    _ = (2 / t) * Real.exp (-(t * q / 2)) := by ring



lemma gaussian_le_inverse_quadratic (c t:ℝ) (hc:0<c) :
    Real.exp (-c*t^2) ≤ (1+2/c)/(1+t^2) := by
  have h0:Real.exp (-c*t^2) ≤ 1:=by
    apply Real.exp_le_one_iff.mpr
    nlinarith [sq_nonneg t]
  have h1:t^2*Real.exp (-c*t^2) ≤ 2/c:=by
    have hm:=gaussian_moment_term_bound (t^2) c (sq_nonneg t) hc
    have he:Real.exp (-(c*t^2/2)) ≤ 1:=by
      apply Real.exp_le_one_iff.mpr
      nlinarith [sq_nonneg t]
    exact hm.trans (by simpa only [mul_one] using
      mul_le_mul_of_nonneg_left he (div_nonneg (by norm_num) hc.le))
  apply (le_div_iff₀ (by positivity : 0<1+t^2)).mpr
  nlinarith

lemma linear_height_young (A ε t:ℝ) (hε:0<ε) :
    A*|t| ≤ ε*t^2/2+A^2/(2*ε) := by
  have hs:0 ≤ ε^2*t^2-2*ε*A*|t|+A^2:=by
    calc
      0 ≤ (ε*|t|-A)^2:=sq_nonneg _
      _=ε^2*t^2-2*ε*A*|t|+A^2:=by rw [sub_sq,mul_pow,sq_abs];ring
  apply le_of_mul_le_mul_left (a := 2*ε) ?_
    (mul_pos (by norm_num : (0:ℝ)<2) hε)
  calc
    2*ε*(A*|t|) ≤ ε^2*t^2+A^2:=by nlinarith [hs]
    _=2*ε*(ε*t^2/2+A^2/(2*ε)):=by field_simp

theorem gaussian_regulator_strip_bound (a b A B ε:ℝ) (hB:0 ≤ B) (hε:0<ε)
    (f:ℂ→ℂ)
    (hf:∀σ:ℝ,σ∈Set.Icc a b→∀t:ℝ,
      ‖f ((σ:ℂ)+(t:ℂ)*Complex.I)‖ ≤ B*Real.exp (A*|t|))
    (σ t:ℝ) (hσ:σ∈Set.Icc a b) :
    ‖Complex.exp ((ε:ℂ)*((σ:ℂ)+(t:ℂ)*Complex.I)^2)*
        f ((σ:ℂ)+(t:ℂ)*Complex.I)‖ ≤ (B*Real.exp (ε*(max |a| |b|)^2+A^2/(2*ε))*(1+4/ε))/(1+t^2) := by
  let R:ℝ:=max |a| |b|
  have hR:0 ≤ R:=le_trans (abs_nonneg a) (le_max_left _ _)
  have hsabs:|σ| ≤ R:=abs_le_max_abs_abs hσ.1 hσ.2
  have hs:σ^2 ≤ R^2:=by
    calc
      _=|σ|^2:=(sq_abs σ).symm
      _ ≤ R^2:=pow_le_pow_left₀ (abs_nonneg σ) hsabs 2
  have hre:((ε:ℂ)*((σ:ℂ)+(t:ℂ)*Complex.I)^2).re=ε*(σ^2-t^2):=by
    simp [pow_two,Complex.mul_re,Complex.mul_im]

  have hE:ε*(σ^2-t^2)+A*|t| ≤ (ε*R^2+A^2/(2*ε))-(ε/2)*t^2:=by
    have hy:=linear_height_young A ε t hε
    nlinarith
  have hg:=gaussian_le_inverse_quadratic (ε/2) t (by positivity)
  have hg':Real.exp (-(ε/2)*t^2) ≤ (1+4/ε)/(1+t^2):=by
    convert hg using 1 ;field_simp ;ring
  rw [norm_mul,Complex.norm_exp,hre]
  calc
    _ ≤ Real.exp (ε*(σ^2-t^2))*(B*Real.exp (A*|t|)):=
      mul_le_mul_of_nonneg_left (hf σ hσ t) (Real.exp_pos _).le
    _=B*Real.exp (ε*(σ^2-t^2)+A*|t|):=by rw [Real.exp_add];ring
    _ ≤ B*Real.exp ((ε*R^2+A^2/(2*ε))-(ε/2)*t^2):=
      mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr hE) hB
    _=(B*Real.exp (ε*R^2+A^2/(2*ε)))*Real.exp (-(ε/2)*t^2):=by
      rw [Real.exp_sub,div_eq_mul_inv,←Real.exp_neg,neg_mul]
      ring
    _ ≤ (B*Real.exp (ε*R^2+A^2/(2*ε)))*((1+4/ε)/(1+t^2)):=
      mul_le_mul_of_nonneg_left hg' (mul_nonneg hB (Real.exp_pos _).le)
    _=_:=by dsimp only [R];ring

theorem gaussian_regulator_strip_decay (a b A B ε:ℝ) (_hab:a ≤ b) (_hA:0 ≤ A)
    (hB:0 ≤ B) (hε:0<ε) (f:ℂ→ℂ)
    (hf:∀σ:ℝ,σ∈Set.Icc a b→∀t:ℝ,
      ‖f ((σ:ℂ)+(t:ℂ)*Complex.I)‖ ≤ B*Real.exp (A*|t|)) :
    ∃K:ℝ,0 ≤ K ∧ ∀σ:ℝ,σ∈Set.Icc a b→∀t:ℝ,
      ‖Complex.exp ((ε:ℂ)*((σ:ℂ)+(t:ℂ)*Complex.I)^2)*
        f ((σ:ℂ)+(t:ℂ)*Complex.I)‖ ≤ K/(1+t^2) := by
  refine ⟨B*Real.exp (ε*(max |a| |b|)^2+A^2/(2*ε))*(1+4/ε),by positivity,?_⟩
  intro σ hσ t
  exact gaussian_regulator_strip_bound a b A B ε hB hε f hf σ t hσ

end GaussianMoment

namespace VerticalContourShift
open Filter MeasureTheory
open scoped Classical Topology

theorem integral_eq_of_exponential_strip_growth
    (f : ℂ→ℂ) (a b A B : ℝ) (hab : a ≤ b) (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hdiff : ∀z : ℂ,a ≤ z.re→z.re ≤ b→DifferentiableAt ℂ f z)
    (ha : Integrable (fun t : ℝ=>f ((a:ℂ)+t*Complex.I)))
    (hb : Integrable (fun t : ℝ=>f ((b:ℂ)+t*Complex.I)))
    (hbound : ∀σ∈Set.Icc a b,∀t : ℝ,‖f ((σ:ℂ)+t*Complex.I)‖ ≤ B*Real.exp (A*|t|)) :
    (∫t : ℝ,f ((a:ℂ)+t*Complex.I))=∫t : ℝ,f ((b:ℂ)+t*Complex.I) := by
  let F : ℕ→ℂ→ℂ := fun n z=>Complex.exp ((gaussianRegulatorSequence n:ℂ)*z^2)*f z
  have hreg (n : ℕ) : Continuous (fun z : ℂ=>Complex.exp ((gaussianRegulatorSequence n:ℂ)*z^2)) := by
    fun_prop
  have hint (n : ℕ) (σ : ℝ) (hσ : Integrable (fun t : ℝ=>f ((σ:ℂ)+t*Complex.I))) :
      Integrable (fun t : ℝ=>F n ((σ:ℂ)+t*Complex.I)) := by
    apply hσ.bdd_mul (c:=Real.exp (σ^2))
    · exact ((hreg n).comp (by fun_prop)).aestronglyMeasurable
    · exact Filter.Eventually.of_forall (fun t=>gaussian_regulator_norm_le _ σ t
        (gaussianRegulatorSequence_pos n).le (gaussianRegulatorSequence_le_one n))
  have heq (n : ℕ) :
      (∫t : ℝ,F n ((a:ℂ)+t*Complex.I))=∫t : ℝ,F n ((b:ℂ)+t*Complex.I) := by
    obtain ⟨K,hK,hdec⟩ := GaussianMoment.gaussian_regulator_strip_decay a b A B
      (gaussianRegulatorSequence n) hab hA hB (gaussianRegulatorSequence_pos n) f hbound
    apply integral_eq_of_strip_decay (F n) a b K hab
    · intro z hza hzb
      have hg : Differentiable ℂ (fun w : ℂ=>Complex.exp ((gaussianRegulatorSequence n:ℂ)*w^2)) := by
        fun_prop
      exact hg.differentiableAt.mul (hdiff z hza hzb)
    · exact hint n a ha
    · exact hint n b hb
    · exact hdec
  have hleft := gaussian_regulator_integral_tendsto (fun t : ℝ=>f ((a:ℂ)+t*Complex.I)) ha a
  have hright := gaussian_regulator_integral_tendsto (fun t : ℝ=>f ((b:ℂ)+t*Complex.I)) hb b
  change Tendsto (fun n=>∫t : ℝ,F n ((a:ℂ)+t*Complex.I)) atTop
    (𝓝 (∫t : ℝ,f ((a:ℂ)+t*Complex.I))) at hleft
  change Tendsto (fun n=>∫t : ℝ,F n ((b:ℂ)+t*Complex.I)) atTop
    (𝓝 (∫t : ℝ,f ((b:ℂ)+t*Complex.I))) at hright
  simp only [heq] at hleft
  exact tendsto_nhds_unique hleft hright

end VerticalContourShift



open scoped ContDiff FourierTransform SchwartzMap

/-! The beta integral bounds the reflected Gamma quotient. Repeated integration by parts
gives uniform Mellin decay for compact smooth tests. -/
lemma Gamma_vertical_conj (a t : ℝ) :
    Complex.Gamma ((a : ℂ) - t * Complex.I) =
      star (Complex.Gamma ((a : ℂ) + t * Complex.I)) := by
  have he : (a : ℂ) - t * Complex.I = star ((a : ℂ) + t * Complex.I) := by
    simp only [star_add, star_mul, Complex.star_def, Complex.conj_ofReal, Complex.conj_I]
    ring
  rw [he]
  exact Complex.Gamma_conj _


def realBeta (a b : ℝ) : ℝ :=
  ∫ x : ℝ in 0..1, x ^ (a - 1) * (1 - x) ^ (b - 1)

theorem realBeta_nonneg (a b : ℝ) : 0 ≤ realBeta a b := by
  apply intervalIntegral.integral_nonneg (by norm_num)
  intro x hx
  exact mul_nonneg (Real.rpow_nonneg hx.1 _) (Real.rpow_nonneg (sub_nonneg.mpr hx.2) _)

theorem betaIntegral_ofReal (a b : ℝ) :
    Complex.betaIntegral (a : ℂ) (b : ℂ) = (realBeta a b : ℂ) := by
  rw [Complex.betaIntegral, realBeta, ← intervalIntegral.integral_ofReal]
  apply intervalIntegral.integral_congr_Ioo_of_le (by norm_num)
  intro x hx
  dsimp only
  rw [Complex.ofReal_mul, Complex.ofReal_cpow hx.1.le,
    Complex.ofReal_cpow (sub_pos.mpr hx.2).le]
  push_cast
  rfl

theorem norm_betaIntegral_le (u v : ℂ) :
    ‖Complex.betaIntegral u v‖ ≤ realBeta u.re v.re := by
  apply (intervalIntegral.norm_integral_le_integral_norm (by norm_num : (0 : ℝ) ≤ 1)).trans_eq
  apply intervalIntegral.integral_congr_Ioo_of_le (by norm_num)
  intro x hx
  dsimp only
  rw [norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos hx.1]
  have hcast : (1 - (x : ℂ)) = ((1 - x : ℝ) : ℂ) := by push_cast; rfl
  rw [hcast, Complex.norm_cpow_eq_rpow_re_of_pos (sub_pos.mpr hx.2)]
  simp

theorem realBeta_eq_Gamma (a b : ℝ) (ha : 0 < a) (hb : 0 < b) :
    realBeta a b = Real.Gamma a * Real.Gamma b / Real.Gamma (a + b) := by
  apply Complex.ofReal_injective
  rw [← betaIntegral_ofReal]
  rw [Complex.betaIntegral_eq_Gamma_mul_div _ _ (by simpa using ha) (by simpa using hb)]
  rw [← Complex.ofReal_add]
  simp only [Complex.Gamma_ofReal, Complex.ofReal_div, Complex.ofReal_mul]

theorem Gamma_ratio_eq_beta (z : ℂ) (d : ℝ) (hz : 0 < z.re) (hd : 0 < d) :
    Complex.Gamma z / Complex.Gamma (z + d) =
      Complex.betaIntegral z d / Complex.Gamma d := by
  rw [Complex.betaIntegral_eq_Gamma_mul_div _ _ hz (by simpa using hd)]
  have hdn : Complex.Gamma (d : ℂ) ≠ 0 := Complex.Gamma_ne_zero_of_re_pos (by simpa using hd)
  field_simp

theorem Gamma_vertical_ratio_bound (a d t : ℝ) (ha : 0 < a) (hd : 0 < d) :
    ‖Complex.Gamma ((a : ℂ) + t * Complex.I) /
      Complex.Gamma ((a : ℂ) + t * Complex.I + d)‖ ≤ Real.Gamma a / Real.Gamma (a + d) := by
  rw [Gamma_ratio_eq_beta _ d (by simpa using ha) hd, norm_div]
  have hg := Real.Gamma_pos_of_pos hd
  have hb := norm_betaIntegral_le ((a : ℂ) + t * Complex.I) (d : ℂ)
  simp only [Complex.add_re, Complex.ofReal_re, Complex.mul_re, Complex.ofReal_im,
    Complex.I_re, mul_zero, zero_mul, sub_zero, add_zero] at hb
  rw [Complex.Gamma_ofReal, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hg]
  calc
    _ ≤ realBeta a d / Real.Gamma d := div_le_div_of_nonneg_right hb hg.le
    _ = _ := by rw [realBeta_eq_Gamma a d ha hd]; field_simp


theorem Gamma_shifted_pair_bound (a σ t : ℝ) (n : ℕ)
    (ha : 0 < a + σ) (hd : 0 < (n : ℝ) - 2 * σ) :
    ‖Complex.Gamma ((a : ℂ) + (σ + t * Complex.I)) /
      Complex.Gamma ((a : ℂ) - (σ + t * Complex.I) + n)‖ ≤ Real.Gamma (a + σ) / Real.Gamma (a - σ + n) := by
  have hb := Gamma_vertical_ratio_bound (a + σ) ((n : ℝ) - 2 * σ) t ha hd
  have hn : ((a + σ : ℝ) : ℂ) + t * Complex.I =
      (a : ℂ) + (σ + t * Complex.I) := by push_cast; ring
  have hdp : ((a + σ : ℝ) : ℂ) + t * Complex.I + ((n : ℝ) - 2 * σ : ℝ) =
      ((a - σ + n : ℝ) : ℂ) + t * Complex.I := by push_cast; ring
  have hdm : (a : ℂ) - (σ + t * Complex.I) + n =
      ((a - σ + n : ℝ) : ℂ) - t * Complex.I := by push_cast; ring
  have hr : a + σ + ((n : ℝ) - 2 * σ) = a - σ + n := by ring
  rw [hdp, hn, hr] at hb
  rw [hdm, Gamma_vertical_conj, norm_div, norm_star]
  simpa only [norm_div] using hb


theorem norm_Gamma_shift_factor (z : ℂ) (n : ℕ) :
    ‖∏ k ∈ Finset.range n, (z + k)‖ ≤ (‖z‖ + n) ^ n := by
  rw [norm_prod]
  calc
    _ ≤ ∏ _k ∈ Finset.range n, (‖z‖ + n) := by
      apply Finset.prod_le_prod
      · intro k hk
        exact norm_nonneg _
      · intro k hk
        have hk' : (k : ℝ) ≤ n := by exact_mod_cast (Finset.mem_range.mp hk).le
        exact (norm_add_le _ _).trans (by simpa using add_le_add_left hk' ‖z‖)
    _ = _ := by simp


theorem Gamma_pair_strip_bound (a : ℝ) (ha : 1 / 4 < a) (A : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ σ ∈ Set.Icc (-(1 / 4 : ℝ)) (A : ℝ), ∀ t : ℝ,
      ‖Complex.Gamma ((a : ℂ) + (σ + t * Complex.I)) /
        Complex.Gamma ((a : ℂ) - (σ + t * Complex.I))‖ ≤ C * (1 + |t|) ^ (2 * A + 2) := by
  let n : ℕ := 2 * A + 2
  let I : Set ℝ := Set.Icc (-(1 / 4 : ℝ)) (A : ℝ)
  have hapos (σ : ℝ) (hσ : σ ∈ I) : 0 < a + σ := by
    have := hσ.1
    linarith
  have hdpos (σ : ℝ) (hσ : σ ∈ I) : 0 < (n : ℝ) - 2 * σ := by
    have := hσ.2
    dsimp [n]
    push_cast
    linarith
  have hdenpos (σ : ℝ) (hσ : σ ∈ I) : 0 < a - σ + n := by
    have h1 := hapos σ hσ
    have h2 := hdpos σ hσ
    linarith
  have hc1 : ContinuousOn (fun σ : ℝ => Real.Gamma (a + σ)) I :=
    Real.differentiableOn_Gamma_Ioi.continuousOn.comp
      (continuous_const.add continuous_id).continuousOn hapos
  have hc2 : ContinuousOn (fun σ : ℝ => Real.Gamma (a - σ + n)) I :=
    Real.differentiableOn_Gamma_Ioi.continuousOn.comp
      ((continuous_const.sub continuous_id).add continuous_const).continuousOn hdenpos
  have hc : ContinuousOn (fun σ : ℝ => Real.Gamma (a + σ) / Real.Gamma (a - σ + n)) I :=
    hc1.div hc2 (fun σ hσ => (Real.Gamma_pos_of_pos (hdenpos σ hσ)).ne')
  obtain ⟨C₀, hC₀⟩ := (isCompact_Icc : IsCompact I).bddAbove_image hc
  let C₁ : ℝ := |C₀| + 1
  have hC₁ : 0 < C₁ := by dsimp [C₁]; positivity
  have hreal (σ : ℝ) (hσ : σ ∈ I) :
      Real.Gamma (a + σ) / Real.Gamma (a - σ + n) ≤ C₁ := by
    exact (hC₀ (Set.mem_image_of_mem _ hσ)).trans (by dsimp [C₁]; linarith [le_abs_self C₀])
  let B : ℝ := |a| + A + 1 + n + 1
  have hB : 0 < B := by dsimp [B]; positivity
  refine ⟨B ^ n * C₁, mul_pos (pow_pos hB n) hC₁, ?_⟩
  intro σ hσ t
  have hσ' : σ ∈ I := hσ
  have hσabs : |σ| ≤ (A : ℝ) + 1 := by
    apply abs_le.mpr
    constructor <;> linarith [hσ.1, hσ.2, (Nat.cast_nonneg A : (0 : ℝ) ≤ A)]
  have hz : ‖(a : ℂ) - (σ + t * Complex.I)‖ ≤ |a| + A + 1 + |t| := by
    calc
      _ ≤ ‖(a : ℂ)‖ + ‖(σ : ℂ) + t * Complex.I‖ := norm_sub_le _ _
      _ ≤ ‖(a : ℂ)‖ + (‖(σ : ℂ)‖ + ‖(t : ℂ) * Complex.I‖) :=
        add_le_add le_rfl (norm_add_le _ _)
      _ = |a| + (|σ| + |t|) := by simp
      _ ≤ _ := by linarith
  have hzB : ‖(a : ℂ) - (σ + t * Complex.I)‖ + n ≤ B * (1 + |t|) := by
    dsimp [B]
    nlinarith [abs_nonneg a, abs_nonneg t, (Nat.cast_nonneg A : (0 : ℝ) ≤ A), (Nat.cast_nonneg n : (0 : ℝ) ≤ n)]
  have hprod : ‖∏ k ∈ Finset.range n, ((a : ℂ) - (σ + t * Complex.I) + k)‖ ≤ B ^ n * (1 + |t|) ^ n := by
    apply (norm_Gamma_shift_factor _ n).trans
    rw [← mul_pow]
    exact pow_le_pow_left₀ (by positivity) hzB n
  have hratio := (Gamma_shifted_pair_bound a σ t n (hapos σ hσ') (hdpos σ hσ')).trans
    (hreal σ hσ')
  have heq : Complex.Gamma ((a : ℂ) + (σ + t * Complex.I)) /
      Complex.Gamma ((a : ℂ) - (σ + t * Complex.I)) =
      (∏ k ∈ Finset.range n, ((a : ℂ) - (σ + t * Complex.I) + k)) *
      (Complex.Gamma ((a : ℂ) + (σ + t * Complex.I)) /
       Complex.Gamma ((a : ℂ) - (σ + t * Complex.I) + n)) := by
    rw [div_eq_mul_inv, CubicGammaExponential.inverse_Gamma_shift _ n, div_eq_mul_inv]
    ring
  rw [heq, norm_mul]
  calc
    _ ≤ (B ^ n * (1 + |t|) ^ n) * C₁ :=
      mul_le_mul hprod hratio (norm_nonneg _) (by positivity)
    _ = _ := by dsimp [n]; ring

theorem cubicReflectionGamma_strip_bound (A : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ σ ∈ Set.Icc (-(1 / 4 : ℝ)) (A : ℝ), ∀ t : ℝ,
      ‖cubicReflectionGamma ((σ : ℂ) + t * Complex.I)‖ ≤ C * (1 + |t|) ^ (4 * A + 4) := by
  obtain ⟨C₁, hC₁, h1⟩ := Gamma_pair_strip_bound (7 / 6) (by norm_num) A
  obtain ⟨C₂, hC₂, h2⟩ := Gamma_pair_strip_bound (5 / 6) (by norm_num) A
  refine ⟨C₁ * C₂, mul_pos hC₁ hC₂, ?_⟩
  intro σ hσ t
  have heq : cubicReflectionGamma ((σ : ℂ) + t * Complex.I) =
      (Complex.Gamma (((7 / 6 : ℝ) : ℂ) + (σ + t * Complex.I)) /
       Complex.Gamma (((7 / 6 : ℝ) : ℂ) - (σ + t * Complex.I))) *
      (Complex.Gamma (((5 / 6 : ℝ) : ℂ) + (σ + t * Complex.I)) /
       Complex.Gamma (((5 / 6 : ℝ) : ℂ) - (σ + t * Complex.I))) := by
    simp only [cubicReflectionGamma, Complex.ofReal_div, Complex.ofReal_ofNat]
    exact div_mul_div_comm _ _ _ _ |>.symm
  rw [heq, norm_mul]
  calc
    _ ≤ (C₁ * (1 + |t|) ^ (2 * A + 2)) * (C₂ * (1 + |t|) ^ (2 * A + 2)) :=
      mul_le_mul (h1 σ hσ t) (h2 σ hσ t) (norm_nonneg _) (by positivity)
    _ = _ := by
      rw [mul_mul_mul_comm, ← pow_add]
      congr 2
      omega

theorem section_deriv_smooth (F : ℝ → ℝ → ℂ)
    (hF : ContDiff ℝ ∞ (Function.uncurry F)) :
    ContDiff ℝ ∞ (fun p : ℝ × ℝ => deriv (F p.1) p.2) := by
  have hFp : ContDiff ℝ ∞
      (Function.uncurry (fun p : ℝ × ℝ => F p.1)) :=
    hF.comp (contDiff_fst.fst.prodMk contDiff_snd)
  have hd := hFp.fderiv contDiff_snd (by simp : (∞ : ℕ∞ω) + 1 ≤ (∞ : ℕ∞ω))
  simpa only [deriv] using hd.clm_apply (contDiff_const (c := (1 : ℝ)))

theorem section_iteratedDeriv_smooth (F : ℝ → ℝ → ℂ)
    (hF : ContDiff ℝ ∞ (Function.uncurry F)) (j : ℕ) :
    ContDiff ℝ ∞ (fun p : ℝ × ℝ => iteratedDeriv j (F p.1) p.2) := by
  induction j with
  | zero => simpa only [iteratedDeriv_zero, Function.uncurry_def] using hF
  | succ j ih =>
    simpa only [iteratedDeriv_succ] using
      section_deriv_smooth (fun σ => iteratedDeriv j (F σ)) ih

theorem tsupport_iteratedDeriv_subset (f : ℝ → ℂ) (j : ℕ) :
    tsupport (iteratedDeriv j f) ⊆ tsupport f := by
  induction j with
  | zero => simp
  | succ j ih =>
    rw [iteratedDeriv_succ]
    exact tsupport_deriv_subset.trans ih

theorem compact_family_deriv_integrable (F : ℝ → ℝ → ℂ)
    (hF : ContDiff ℝ ∞ (Function.uncurry F)) (K : Set ℝ) (hK : IsCompact K)
    (hsupp : ∀ σ, Function.support (F σ) ⊆ K) (σ : ℝ) (j : ℕ) :
    Integrable (iteratedDeriv j (F σ)) := by
  have hs : ContDiff ℝ ∞ (F σ) := hF.comp (contDiff_const.prodMk contDiff_id)
  have hc : HasCompactSupport (iteratedDeriv j (F σ)) := by
    apply HasCompactSupport.of_support_subset_isCompact hK
    exact (subset_tsupport _).trans ((tsupport_iteratedDeriv_subset (F σ) j).trans
      (closure_minimal (hsupp σ) hK.isClosed))
  exact (hs.continuous_iteratedDeriv j (by exact_mod_cast (le_top : (j : ℕ∞) ≤ ⊤))).integrable_of_hasCompactSupport hc

theorem compact_family_deriv_L1_bound (F : ℝ → ℝ → ℂ)
    (hF : ContDiff ℝ ∞ (Function.uncurry F)) (K : Set ℝ) (hK : IsCompact K)
    (hsupp : ∀ σ, Function.support (F σ) ⊆ K) (J : Set ℝ) (hJ : IsCompact J)
    (j : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ σ ∈ J, (∫ u : ℝ, ‖iteratedDeriv j (F σ) u‖) ≤ C := by
  have hc := (section_iteratedDeriv_smooth F hF j).continuous.norm
  obtain ⟨M, hM⟩ := (hJ.prod hK).bddAbove_image hc.continuousOn
  let C : ℝ := (|M| + 1) * (volume.real K + 1)
  refine ⟨C, by dsimp [C]; positivity, ?_⟩
  intro σ hσ
  have hbound : ∀ u ∈ K, ‖iteratedDeriv j (F σ) u‖ ≤ |M| + 1 := by
    intro u hu
    exact (hM (Set.mem_image_of_mem _ (show (σ, u) ∈ J ×ˢ K from ⟨hσ, hu⟩))).trans (by linarith [le_abs_self M])
  have hs : Function.support (iteratedDeriv j (F σ)) ⊆ K :=
    (subset_tsupport _).trans ((tsupport_iteratedDeriv_subset (F σ) j).trans
      (closure_minimal (hsupp σ) hK.isClosed))
  have hzero : ∀ u, u ∉ K → ‖iteratedDeriv j (F σ) u‖ = 0 := by
    intro u hu
    have hz : iteratedDeriv j (F σ) u = 0 := by
      by_contra hn
      exact hu (hs hn)
    simp [hz]
  have hi := norm_setIntegral_le_of_norm_le_const («μ» := volume) (f := fun u => ‖iteratedDeriv j (F σ) u‖)
    hK.measure_lt_top (C := |M| + 1) (fun u hu => by simpa using hbound u hu)
  rw [setIntegral_eq_integral_of_forall_compl_eq_zero hzero] at hi
  rw [Real.norm_of_nonneg (integral_nonneg (fun u => norm_nonneg _))] at hi
  exact hi.trans (by dsimp [C]; nlinarith [abs_nonneg M])

theorem compact_family_fourier_power_bound (F : ℝ → ℝ → ℂ)
    (hF : ContDiff ℝ ∞ (Function.uncurry F)) (K : Set ℝ) (hK : IsCompact K)
    (hsupp : ∀ σ, Function.support (F σ) ⊆ K) (J : Set ℝ) (hJ : IsCompact J)
    (j : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ σ ∈ J, ∀ w : ℝ,
      |w| ^ j * ‖𝓕 (F σ) w‖ ≤ C := by
  obtain ⟨C, hC, hb⟩ := compact_family_deriv_L1_bound F hF K hK hsupp J hJ j
  refine ⟨C / (2 * Real.pi) ^ j, by positivity, ?_⟩
  intro σ hσ w
  have hs : ContDiff ℝ ∞ (F σ) := hF.comp (contDiff_const.prodMk contDiff_id)
  have hfour := Real.fourier_iteratedDeriv (N := (⊤ : ℕ∞)) hs
    (fun k _ => compact_family_deriv_integrable F hF K hK hsupp σ k)
    (by simp : (j : ℕ∞) ≤ ⊤)
  have hid : (2 * Real.pi) ^ j * (|w| ^ j * ‖𝓕 (F σ) w‖) =
      ‖𝓕 (iteratedDeriv j (F σ)) w‖ := by
    rw [hfour]
    simp only [norm_smul, norm_pow, norm_mul, Complex.norm_I, mul_one,
      Complex.norm_real, Real.norm_eq_abs, abs_of_pos Real.pi_pos]
    norm_num
    ring
  have hn : ‖𝓕 (iteratedDeriv j (F σ)) w‖ ≤ C := by
    apply (VectorFourier.norm_fourierIntegral_le_integral_norm
      Real.fourierChar volume (innerₗ ℝ) (iteratedDeriv j (F σ)) w).trans
    exact hb σ hσ
  apply (le_div_iff₀ (by positivity : 0 < (2 * Real.pi) ^ j)).mpr
  rw [← hid] at hn
  calc
    _ = (2 * Real.pi) ^ j * (|w| ^ j * ‖𝓕 (F σ) w‖) := mul_comm _ _
    _ ≤ C := hn

theorem compact_family_fourier_weighted_bound (F : ℝ → ℝ → ℂ)
    (hF : ContDiff ℝ ∞ (Function.uncurry F)) (K : Set ℝ) (hK : IsCompact K)
    (hsupp : ∀ σ, Function.support (F σ) ⊆ K) (J : Set ℝ) (hJ : IsCompact J)
    (j : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ σ ∈ J, ∀ w : ℝ,
      (1 + |w|) ^ j * ‖𝓕 (F σ) w‖ ≤ C := by
  obtain ⟨C₀, hC₀, h0⟩ := compact_family_fourier_power_bound F hF K hK hsupp J hJ 0
  obtain ⟨Cj, hCj, hj⟩ := compact_family_fourier_power_bound F hF K hK hsupp J hJ j
  refine ⟨2 ^ j * (C₀ + Cj), by positivity, ?_⟩
  intro σ hσ w
  have hbase : ‖𝓕 (F σ) w‖ ≤ C₀ := by simpa using h0 σ hσ w
  by_cases hw : |w| ≤ 1
  · calc
      _ ≤ 2 ^ j * ‖𝓕 (F σ) w‖ :=
        mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (by positivity) (by linarith) j) (norm_nonneg _)
      _ ≤ 2 ^ j * C₀ := mul_le_mul_of_nonneg_left hbase (by positivity)
      _ ≤ _ := mul_le_mul_of_nonneg_left (by linarith) (by positivity)
  · have hw' : 1 ≤ |w| := le_of_lt (lt_of_not_ge hw)
    calc
      _ ≤ (2 * |w|) ^ j * ‖𝓕 (F σ) w‖ :=
        mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (by positivity) (by linarith) j) (norm_nonneg _)
      _ = 2 ^ j * (|w| ^ j * ‖𝓕 (F σ) w‖) := by rw [mul_pow, mul_assoc]
      _ ≤ 2 ^ j * Cj := mul_le_mul_of_nonneg_left (hj σ hσ w) (by positivity)
      _ ≤ _ := mul_le_mul_of_nonneg_left (by linarith) (by positivity)



/-! Mellin inversion and absolute convergence commute the weighted series and vertical integral. -/
open scoped ContDiff FourierTransform SchwartzMap


def mellinLogFamily (V : ℝ → ℂ) (σ u : ℝ) : ℂ :=
  Real.exp (-σ * u) • V (Real.exp (-u))

theorem mellinLogFamily_smooth (V : ℝ → ℂ) (hV : ContDiff ℝ ∞ V) :
    ContDiff ℝ ∞ (Function.uncurry (mellinLogFamily V)) := by
  change ContDiff ℝ ∞ (fun p : ℝ × ℝ => Real.exp (-p.1 * p.2) • V (Real.exp (-p.2)))
  exact (Real.contDiff_exp.comp (contDiff_fst.neg.mul contDiff_snd)).smul
    (hV.comp (Real.contDiff_exp.comp contDiff_snd.neg))

theorem mellinLogFamily_support (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hsupp : Function.support V ⊆ Set.Icc a b) (σ : ℝ) :
    Function.support (mellinLogFamily V σ) ⊆ Set.Icc (-Real.log b) (-Real.log a) := by
  intro u hu
  have hv : V (Real.exp (-u)) ≠ 0 := by
    intro hv
    exact hu (by simp [mellinLogFamily, hv])
  have hm := hsupp hv
  have hlow := Real.log_le_log ha hm.1
  have hhigh := Real.log_le_log (Real.exp_pos (-u)) hm.2
  simp only [Real.log_exp] at hlow hhigh
  constructor <;> linarith

theorem mellin_eq_logFamily_fourier (V : ℝ → ℂ) (σ t : ℝ) :
    mellin V ((σ : ℂ) + t * Complex.I) = 𝓕 (mellinLogFamily V σ) (t / (2 * Real.pi)) := by
  rw [mellin_eq_fourier]
  simp only [Complex.add_re, Complex.ofReal_re, Complex.mul_re, Complex.ofReal_im,
    Complex.I_re, mul_zero,  sub_zero, add_zero, Complex.add_im,
    Complex.mul_im, Complex.I_im, mul_one, zero_add]
  rfl



theorem compact_source_mellin_convergent
    (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hsupp : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (s : ℂ) : MellinConvergent V s := by
  have hlocal : LocallyIntegrableOn V (Set.Ioi (0 : ℝ)) :=
    hV.continuous.continuousOn.locallyIntegrableOn measurableSet_Ioi
  have htopzero : V =ᶠ[atTop] (fun _ => 0) := by
    filter_upwards [eventually_gt_atTop b] with y hy
    by_contra hn
    exact (not_le_of_gt hy) (hsupp hn).2
  have hbotzero : V =ᶠ[𝓝[>] (0 : ℝ)] (fun _ => 0) := by
    filter_upwards [Ioo_mem_nhdsGT ha] with y hy
    by_contra hn
    exact (not_le_of_gt hy.2) (hsupp hn).1
  have htop : V =O[atTop] (fun y : ℝ => y ^ (-(s.re + 1))) :=
    htopzero.isBigO.trans (isBigO_zero _ _)
  have hbot : V =O[𝓝[>] (0 : ℝ)] (fun y : ℝ => y ^ (-(s.re - 1))) :=
    hbotzero.isBigO.trans (isBigO_zero _ _)
  exact mellinConvergent_of_isBigO_rpow hlocal htop (by linarith)
    hbot (by linarith)



theorem compact_source_mellin_hasDerivAt
    (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hsupp : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (s : ℂ) :
    HasDerivAt (mellin V) (mellin (fun t => Real.log t • V t) s) s := by
  have hlocal : LocallyIntegrableOn V (Set.Ioi (0 : ℝ)) :=
    hV.continuous.continuousOn.locallyIntegrableOn measurableSet_Ioi
  have htopzero : V =ᶠ[atTop] (fun _ => 0) := by
    filter_upwards [eventually_gt_atTop b] with y hy
    by_contra hn
    exact (not_le_of_gt hy) (hsupp hn).2
  have hbotzero : V =ᶠ[𝓝[>] (0 : ℝ)] (fun _ => 0) := by
    filter_upwards [Ioo_mem_nhdsGT ha] with y hy
    by_contra hn
    exact (not_le_of_gt hy.2) (hsupp hn).1
  have htop : V =O[atTop] (fun y : ℝ => y ^ (-(s.re + 1))) :=
    htopzero.isBigO.trans (isBigO_zero _ _)
  have hbot : V =O[𝓝[>] (0 : ℝ)] (fun y : ℝ => y ^ (-(s.re - 1))) :=
    hbotzero.isBigO.trans (isBigO_zero _ _)
  exact (mellin_hasDerivAt_of_isBigO_rpow hlocal htop (by linarith)
    hbot (by linarith)).2

theorem compact_source_mellin_differentiable
    (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hsupp : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V) :
    Differentiable ℂ (mellin V) :=
  fun s => (compact_source_mellin_hasDerivAt V a b ha hsupp hV s).differentiableAt



lemma compactMellin_vertical_integrable (V : ℝ→ℂ) (a b : ℝ) (ha : 0<a)
    (hsupp : Function.support V⊆Set.Icc a b) (hV : ContDiff ℝ ∞ V) (σ : ℝ) :
    Complex.VerticalIntegrable (mellin V) σ := by
  have hc : HasCompactSupport (mellinLogFamily V σ) :=
    HasCompactSupport.of_support_subset_isCompact isCompact_Icc
      (mellinLogFamily_support V a b ha hsupp σ)
  have hd : ContDiff ℝ ∞ (mellinLogFamily V σ) :=
    (mellinLogFamily_smooth V hV).comp (contDiff_const.prodMk contDiff_id)
  let f : 𝓢(ℝ,ℂ) := hc.toSchwartzMap hd
  have hf : Integrable (fun t : ℝ=>(𝓕 f) (t/(2*Real.pi))) := by
    simpa only [div_eq_mul_inv] using
      (𝓕 f).integrable.comp_mul_right' (inv_ne_zero (mul_ne_zero (by norm_num) Real.pi_ne_zero))
  change Integrable (fun t : ℝ=>mellin V ((σ:ℂ)+t*Complex.I))
  have hfcoe : (f:ℝ→ℂ)=mellinLogFamily V σ := rfl
  simpa only [mellin_eq_logFamily_fourier,
    SchwartzMap.fourier_coe,hfcoe] using hf

theorem compactMellin_inversion (V : ℝ→ℂ) (a b : ℝ) (ha : 0<a)
    (hsupp : Function.support V⊆Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (σ x : ℝ) (hx : 0<x) :
    V x=(1/(2*Real.pi):ℂ)*∫t : ℝ,
      (x:ℂ)^(-((σ:ℂ)+t*Complex.I))*mellin V ((σ:ℂ)+t*Complex.I) := by
  have hm := mellinInv_mellin_eq σ V hx
    (compact_source_mellin_convergent V a b ha hsupp hV σ)
    (compactMellin_vertical_integrable V a b ha hsupp hV σ) hV.continuous.continuousAt
  simpa only [mellinInv,smul_eq_mul,Complex.real_smul,Complex.ofReal_div,
    Complex.ofReal_one,Complex.ofReal_mul,Complex.ofReal_ofNat] using hm.symm


lemma positive_cpow_vertical_norm (r σ t : ℝ) (hr : 0<r) :
    ‖(r:ℂ)^((σ:ℂ)+t*Complex.I)‖=r^σ := by
  rw [Complex.norm_cpow_eq_rpow_re_of_pos hr]
  simp

lemma positive_cpow_negative_vertical_norm (r σ t : ℝ) (hr : 0<r) :
    ‖(r:ℂ)^(-((σ:ℂ)+t*Complex.I))‖=r^(-σ) := by
  rw [Complex.norm_cpow_eq_rpow_re_of_pos hr]
  simp

lemma positive_cpow_vertical_continuous (r σ : ℝ) (hr : 0<r) :
    Continuous (fun t : ℝ=>(r:ℂ)^((σ:ℂ)+t*Complex.I)) := by
  let : NeZero (r:ℂ) := ⟨Complex.ofReal_ne_zero.mpr hr.ne'⟩
  exact (_root_.continuous_const_cpow (r:ℂ)).comp (by fun_prop)

lemma positive_cpow_negative_vertical_continuous (r σ : ℝ) (hr : 0<r) :
    Continuous (fun t : ℝ=>(r:ℂ)^(-((σ:ℂ)+t*Complex.I))) := by
  let : NeZero (r:ℂ) := ⟨Complex.ofReal_ne_zero.mpr hr.ne'⟩
  exact (_root_.continuous_const_cpow (r:ℂ)).comp (by fun_prop)

lemma vertical_power_mul_integrable (M : ℝ→ℂ) (hM : Integrable M)
    (r σ : ℝ) (hr : 0<r) :
    Integrable (fun t : ℝ=>(r:ℂ)^((σ:ℂ)+t*Complex.I)*M t) := by
  apply (hM.norm.const_mul (r^σ)).mono'
    ((positive_cpow_vertical_continuous r σ hr).aestronglyMeasurable.mul hM.aestronglyMeasurable)
  exact Filter.Eventually.of_forall (fun t=>by simp only [Pi.mul_apply,norm_mul,positive_cpow_vertical_norm r σ t hr,le_refl])

lemma weighted_vertical_power_integrable (M : ℝ→ℂ) (hM : Integrable M)
    (r σ : ℝ) (hr : 0<r) (c : ℂ) :
    Integrable (fun t : ℝ=>c*(r:ℂ)^(-((σ:ℂ)+t*Complex.I))*M t) := by
  apply (hM.norm.const_mul (‖c‖*r^(-σ))).mono'
    ((continuous_const.mul (positive_cpow_negative_vertical_continuous r σ hr)).aestronglyMeasurable.mul hM.aestronglyMeasurable)
  exact Filter.Eventually.of_forall (fun t=>by
    simp only [Pi.mul_apply,norm_mul,positive_cpow_negative_vertical_norm r σ t hr,le_refl])

lemma weighted_vertical_power_integral_norm (M : ℝ→ℂ) (r σ : ℝ) (hr : 0<r) (c : ℂ) :
    (∫t : ℝ,‖c*(r:ℂ)^(-((σ:ℂ)+t*Complex.I))*M t‖)=
      (‖c‖*r^(-σ))*(∫t : ℝ,‖M t‖) := by
  simp only [norm_mul,positive_cpow_negative_vertical_norm r σ _ hr,integral_const_mul]

theorem weighted_vertical_sum_integral {α : Type*} [Countable α]
    (r : α→ℝ) (hr : ∀i,0<r i) (c : α→ℂ) (σ : ℝ)
    (hc : Summable (fun i=>‖c i‖*(r i)^(-σ)))
    (M : ℝ→ℂ) (hM : Integrable M) :
    (∑' i,∫t : ℝ,c i*(r i:ℂ)^(-((σ:ℂ)+t*Complex.I))*M t)=
      ∫t : ℝ,(∑' i,c i*(r i:ℂ)^(-((σ:ℂ)+t*Complex.I)))*M t := by
  have hi (i : α) := weighted_vertical_power_integrable M hM (r i) σ (hr i) (c i)
  have hs : Summable (fun i=>∫t : ℝ,‖c i*(r i:ℂ)^(-((σ:ℂ)+t*Complex.I))*M t‖) := by
    simp only [weighted_vertical_power_integral_norm M _ σ (hr _) _]
    exact hc.mul_right _
  rw [integral_tsum_of_summable_integral_norm hi hs]
  apply integral_congr_ae
  exact Filter.Eventually.of_forall (fun t=>tsum_mul_right)

lemma positive_div_cpow (x y : ℝ) (hx : 0 ≤ x) (hy : 0 < y) (s : ℂ) :
    ((x / y : ℝ) : ℂ) ^ s = (x : ℂ) ^ s / (y : ℂ) ^ s := by
  apply (eq_div_iff (Complex.cpow_ne_zero_iff.mpr
    (Or.inl (Complex.ofReal_ne_zero.mpr hy.ne')))).mpr
  have he := Complex.mul_cpow_ofReal_nonneg (div_nonneg hx hy.le) hy.le s
  simpa only [← Complex.ofReal_mul, div_mul_cancel₀ x hy.ne'] using he.symm

lemma positive_quotient_cpow_neg (r X : ℝ) (hr : 0<r) (hX : 0<X) (s : ℂ) :
    ((r/X:ℝ):ℂ)^(-s)=(r:ℂ)^(-s)*(X:ℂ)^s := by
  rw [positive_div_cpow r X hr.le hX,
    Complex.cpow_neg,Complex.cpow_neg,div_inv_eq_mul]

theorem weightedMellin_inversion {α : Type*} [Countable α]
    (r : α→ℝ) (hr : ∀i,0<r i) (c : α→ℂ) (σ : ℝ)
    (hc : Summable (fun i=>‖c i‖*(r i)^(-σ)))
    (V : ℝ→ℂ) (a b : ℝ) (ha : 0<a)
    (hsupp : Function.support V⊆Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (X : ℝ) (hX : 0<X) :
    (∑'i,c i*V (r i/X))=(1/(2*Real.pi):ℂ)*∫t : ℝ,
      mellin V ((σ:ℂ)+t*Complex.I)*(X:ℂ)^((σ:ℂ)+t*Complex.I)*
        (∑'i,c i*(r i:ℂ)^(-((σ:ℂ)+t*Complex.I))) := by
  let M : ℝ→ℂ := fun t=>(X:ℂ)^((σ:ℂ)+t*Complex.I)*mellin V ((σ:ℂ)+t*Complex.I)
  have hM : Integrable M := vertical_power_mul_integrable _
    (compactMellin_vertical_integrable V a b ha hsupp hV σ) X σ hX
  have hi (i : α) : c i*V (r i/X)=(1/(2*Real.pi):ℂ)*
      ∫t : ℝ,c i*(r i:ℂ)^(-((σ:ℂ)+t*Complex.I))*M t := by
    rw [compactMellin_inversion V a b ha hsupp hV σ _ (div_pos (hr i) hX)]
    rw [←mul_assoc,mul_comm (c i),mul_assoc,←integral_const_mul]
    congr 1
    apply integral_congr_ae
    exact Filter.Eventually.of_forall (fun t=>by
      dsimp only
      rw [positive_quotient_cpow_neg _ _ (hr i) hX]
      dsimp only [M]
      ring)
  simp_rw [hi]
  rw [tsum_mul_left,weighted_vertical_sum_integral r hr c σ hc M hM]
  congr 1
  apply integral_congr_ae
  exact Filter.Eventually.of_forall (fun t=>by dsimp only [M];ring)


def besselSmoothingIntegrand (F : ℝ→ℂ) (q : ℝ) (V : ℝ→ℂ) (X : ℝ) (s : ℂ) : ℂ :=
  mellin V (s-1/2)*(X:ℂ)^(s-1/2)*continuedBesselDirichlet F q s

lemma besselSmoothingIntegrand_differentiable (F : ℝ→ℂ) (q : ℝ) (hq : 0<q)
    (hF : Differentiable ℂ (mellin F)) (V : ℝ→ℂ) (a b : ℝ) (ha : 0<a)
    (hVs : Function.support V⊆Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (X : ℝ) (hX : 0<X) : Differentiable ℂ (besselSmoothingIntegrand F q V X) := by
  have hm := (compact_source_mellin_differentiable V a b ha hVs hV).comp
    (show Differentiable ℂ (fun s : ℂ=>s-1/2) from by fun_prop)
  have hp : Differentiable ℂ (fun s : ℂ=>(X:ℂ)^(s-1/2)) :=
    (show Differentiable ℂ (fun s : ℂ=>s-1/2) from by fun_prop).const_cpow
      (Or.inl (Complex.ofReal_ne_zero.mpr hX.ne'))
  exact (hm.mul hp).mul (continuedBesselDirichlet_differentiable F q hq hF)

lemma besselSmoothingIntegrand_strip_bound (F : ℝ→ℂ) (q : ℝ) (hq : 0<q)
    (lo hi : ℝ) (hF : ∀s : ℂ,MellinConvergent F s)
    (V : ℝ→ℂ) (a b : ℝ) (ha : 0<a)
    (hVs : Function.support V⊆Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (X : ℝ) (hX : 0<X) :
    ∃C : ℝ,0 ≤ C ∧ ∀s : ℂ,s.re∈Set.Icc lo hi →
      ‖besselSmoothingIntegrand F q V X s‖ ≤ C*Real.exp (2*Real.pi*|s.im|) := by
  obtain ⟨Cd,hCd,hd⟩ := continuedBesselDirichlet_strip_bound F q hq lo hi (hF _) (hF _)
  have hVc (s : ℂ) := compact_source_mellin_convergent V a b ha hVs hV s
  obtain ⟨Cv,hCv,hv⟩ := mellin_uniform_strip_bound V (lo-1/2) (hi-1/2)
    (hVc _) (hVc _)
  let Cx : ℝ := X^(lo-1/2)+X^(hi-1/2)
  have hCx : 0 ≤ Cx := by dsimp [Cx];positivity
  refine ⟨Cv*Cx*Cd,mul_nonneg (mul_nonneg hCv hCx) hCd,?_⟩
  intro s hs
  have hvb : ‖mellin V (s-1/2)‖ ≤ Cv := hv (s-1/2)
    (by simp;linarith [hs.1]) (by simp;linarith [hs.2])
  have hxb : ‖(X:ℂ)^(s-1/2)‖ ≤ Cx := by
    rw [Complex.norm_cpow_eq_rpow_re_of_pos hX]
    have he : (s-1/2).re=s.re-1/2 := by simp
    rw [he]
    exact rpow_between_endpoints X (lo-1/2) (hi-1/2) (s.re-1/2) hX
      (by linarith [hs.1]) (by linarith [hs.2])
  rw [besselSmoothingIntegrand,norm_mul,norm_mul]
  calc
    _ ≤ (Cv*Cx)*(Cd*Real.exp (2*Real.pi*|s.im|)) :=
      mul_le_mul (mul_le_mul hvb hxb (norm_nonneg _) hCv) (hd s hs)
        (norm_nonneg _) (mul_nonneg hCv hCx)
    _=_ := by ring

theorem besselSmoothingIntegrand_contour_eq (F : ℝ→ℂ) (q : ℝ) (hq : 0<q)
    (hF : ∀s : ℂ,MellinConvergent F s) (hFe : Differentiable ℂ (mellin F))
    (V : ℝ→ℂ) (a b : ℝ) (ha : 0<a)
    (hVs : Function.support V⊆Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (X : ℝ) (hX : 0<X) (lo hi : ℝ) (hlh : lo ≤ hi)
    (hl : Integrable (fun t : ℝ=>besselSmoothingIntegrand F q V X ((lo:ℂ)+t*Complex.I)))
    (hh : Integrable (fun t : ℝ=>besselSmoothingIntegrand F q V X ((hi:ℂ)+t*Complex.I))) :
    (∫t : ℝ,besselSmoothingIntegrand F q V X ((lo:ℂ)+t*Complex.I))=
      ∫t : ℝ,besselSmoothingIntegrand F q V X ((hi:ℂ)+t*Complex.I) := by
  obtain ⟨C,hC,hb⟩ := besselSmoothingIntegrand_strip_bound F q hq lo hi hF V a b ha hVs hV X hX
  apply VerticalContourShift.integral_eq_of_exponential_strip_growth
    (besselSmoothingIntegrand F q V X) lo hi (2*Real.pi) C hlh (by positivity) hC
  · intro z hz1 hz2
    exact (besselSmoothingIntegrand_differentiable F q hq hFe V a b ha hVs hV X hX) z
  · exact hl
  · exact hh
  · intro σ hσ t
    simpa only [Complex.add_re,Complex.ofReal_re,Complex.mul_re,Complex.ofReal_im,
      Complex.I_re,Complex.I_im,zero_mul,mul_zero,sub_zero,add_zero,
      Complex.add_im,Complex.mul_im,mul_one,zero_add] using
      hb ((σ:ℂ)+t*Complex.I) (by simpa using hσ)



/-! The reflected Mellin kernel has integrable vertical lines and admits contour shifts. -/
theorem compact_source_mellin_strip_decay (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hsupp : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (lo hi : ℝ) (j : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ σ ∈ Set.Icc lo hi, ∀ t : ℝ,
      (1 + |t|) ^ j * ‖mellin V ((σ : ℂ) + t * Complex.I)‖ ≤ C := by
  obtain ⟨C, hC, hb⟩ := compact_family_fourier_weighted_bound
    (mellinLogFamily V) (mellinLogFamily_smooth V hV)
    (Set.Icc (-Real.log b) (-Real.log a)) isCompact_Icc
    (mellinLogFamily_support V a b ha hsupp) (Set.Icc lo hi) isCompact_Icc j
  refine ⟨(1 + 2 * Real.pi) ^ j * C, by positivity, ?_⟩
  intro σ hσ t
  rw [mellin_eq_logFamily_fourier]
  have ht : |t| = (2 * Real.pi) * |t / (2 * Real.pi)| := by
    rw [abs_div, abs_of_pos (by positivity : 0 < 2 * Real.pi)]
    field_simp
  have hbase : 1 + |t| ≤ (1 + 2 * Real.pi) * (1 + |t / (2 * Real.pi)|) := by
    rw [ht]
    nlinarith [Real.pi_pos, abs_nonneg (t / (2 * Real.pi))]
  calc
    _ ≤ ((1 + 2 * Real.pi) * (1 + |t / (2 * Real.pi)|)) ^ j *
        ‖𝓕 (mellinLogFamily V σ) (t / (2 * Real.pi))‖ :=
      mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (by positivity) hbase j) (norm_nonneg _)
    _ = (1 + 2 * Real.pi) ^ j * ((1 + |t / (2 * Real.pi)|) ^ j *
        ‖𝓕 (mellinLogFamily V σ) (t / (2 * Real.pi))‖) := by rw [mul_pow, mul_assoc]
    _ ≤ _ := mul_le_mul_of_nonneg_left (hb σ hσ _) (by positivity)


theorem Gamma_differentiableAt_of_re_pos (z : ℂ) (hz : 0 < z.re) :
    DifferentiableAt ℂ Complex.Gamma z := by
  apply Complex.differentiableAt_Gamma
  intro m hm
  have hr := congrArg Complex.re hm
  simp only [Complex.neg_re, Complex.natCast_re] at hr
  have hn : (0 : ℝ) ≤ m := Nat.cast_nonneg m
  linarith

theorem cubicReflectionGamma_differentiableAt (s : ℂ) (hs : -(5 / 6 : ℝ) < s.re) :
    DifferentiableAt ℂ cubicReflectionGamma s := by
  have h1 := (Gamma_differentiableAt_of_re_pos ((7 / 6 : ℂ) + s) (by
    norm_num [Complex.add_re, Complex.div_re]
    linarith)).comp s (differentiableAt_const _ |>.add differentiableAt_id)
  have h2 := (Gamma_differentiableAt_of_re_pos ((5 / 6 : ℂ) + s) (by
    norm_num [Complex.add_re, Complex.div_re]
    linarith)).comp s (differentiableAt_const _ |>.add differentiableAt_id)
  have h3 := (Complex.differentiable_one_div_Gamma ((7 / 6 : ℂ) - s)).comp s
    (differentiableAt_const _ |>.sub differentiableAt_id)
  have h4 := (Complex.differentiable_one_div_Gamma ((5 / 6 : ℂ) - s)).comp s
    (differentiableAt_const _ |>.sub differentiableAt_id)
  convert! ((h1.mul h2).mul (h3.mul h4)) using 1
  ext z
  simp only [cubicReflectionGamma, Function.comp_def, div_eq_mul_inv, mul_inv_rev, Pi.mul_apply]
  ring

theorem kernelMellinIntegrand_differentiableAt
    (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hsupp : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (s : ℂ) (hs : -(5 / 6 : ℝ) < s.re) :
    DifferentiableAt ℂ (fun t => mellin V (-t) * cubicReflectionGamma t) s := by
  exact ((compact_source_mellin_differentiable V a b ha hsupp hV (-s)).comp s
    differentiableAt_id.neg).mul (cubicReflectionGamma_differentiableAt s hs)


def mellinData (V : ℝ → ℂ) (s : ℂ) : ℂ := mellin V (-s) * cubicReflectionGamma s

def mellinEulerData (V : ℝ → ℂ) (j : ℕ) (s : ℂ) : ℂ := (-s) ^ j * mellinData V s

theorem mellinData_strip_decay (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hsupp : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (A j : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ σ ∈ Set.Icc (-(1 / 4 : ℝ)) (A : ℝ), ∀ t : ℝ,
      (1 + |t|) ^ j * ‖mellinData V ((σ : ℂ) + t * Complex.I)‖ ≤ C := by
  let g : ℕ := 4 * A + 4
  obtain ⟨Cγ, hCγ, hγ⟩ := cubicReflectionGamma_strip_bound A
  obtain ⟨CV, hCV, hVb⟩ := compact_source_mellin_strip_decay V a b ha hsupp hV
    (-(A : ℝ)) (1 / 4) (g + j)
  refine ⟨Cγ * CV, mul_pos hCγ hCV, ?_⟩
  intro σ hσ t
  have hσ' : -σ ∈ Set.Icc (-(A : ℝ)) (1 / 4) := by constructor <;> linarith [hσ.1, hσ.2]
  have hmb := hVb (-σ) hσ' (-t)
  have heq : (-σ : ℝ) + (-t : ℝ) * Complex.I = -((σ : ℂ) + t * Complex.I) := by
    push_cast
    ring
  rw [heq, abs_neg] at hmb
  have hgb : ‖cubicReflectionGamma ((σ : ℂ) + t * Complex.I)‖ ≤ Cγ * (1 + |t|) ^ g := hγ σ hσ t
  rw [mellinData, norm_mul]
  calc
    _ = ((1 + |t|) ^ j * ‖mellin V (-((σ : ℂ) + t * Complex.I))‖) *
        ‖cubicReflectionGamma ((σ : ℂ) + t * Complex.I)‖ := by ring
    _ ≤ ((1 + |t|) ^ j * ‖mellin V (-((σ : ℂ) + t * Complex.I))‖) *
        (Cγ * (1 + |t|) ^ g) := mul_le_mul_of_nonneg_left hgb (by positivity)
    _ = Cγ * ((1 + |t|) ^ (g + j) * ‖mellin V (-((σ : ℂ) + t * Complex.I))‖) := by
      rw [pow_add]
      ring
    _ ≤ _ := mul_le_mul_of_nonneg_left hmb hCγ.le

theorem weighted_two_to_cauchy {C B : ℝ} (hB : 0 ≤ B) (t : ℝ)
    (h : (1 + |t|) ^ 2 * B ≤ C) : B ≤ C / (1 + t ^ 2) := by
  apply (le_div_iff₀ (by positivity : 0 < 1 + t ^ 2)).mpr
  have hpow : 1 + t ^ 2 ≤ (1 + |t|) ^ 2 := by nlinarith [abs_nonneg t, sq_abs t]
  exact (mul_le_mul_of_nonneg_left hpow hB).trans (by simpa only [mul_comm] using h)

theorem mellinEulerData_strip_bound (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hsupp : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (A j : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ σ ∈ Set.Icc (-(1 / 4 : ℝ)) (A : ℝ), ∀ t : ℝ,
      ‖mellinEulerData V j ((σ : ℂ) + t * Complex.I)‖ ≤ C / (1 + t ^ 2) := by
  obtain ⟨C, hC, hb⟩ := mellinData_strip_decay V a b ha hsupp hV A (j + 2)
  refine ⟨((A : ℝ) + 2) ^ j * C, by positivity, ?_⟩
  intro σ hσ t
  apply weighted_two_to_cauchy (norm_nonneg _) t
  have hσabs : |σ| ≤ (A : ℝ) + 1 := by
    apply abs_le.mpr
    constructor <;> linarith [hσ.1, hσ.2, (Nat.cast_nonneg A : (0 : ℝ) ≤ A)]
  have hz : ‖(σ : ℂ) + t * Complex.I‖ ≤ ((A : ℝ) + 2) * (1 + |t|) := by
    have hnorm := norm_add_le (σ : ℂ) ((t : ℂ) * Complex.I)
    simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, Complex.norm_I, mul_one] at hnorm
    nlinarith [abs_nonneg t, (Nat.cast_nonneg A : (0 : ℝ) ≤ A)]
  rw [mellinEulerData, norm_mul, norm_pow, norm_neg]
  calc
    _ ≤ (1 + |t|) ^ 2 * ((((A : ℝ) + 2) * (1 + |t|)) ^ j *
        ‖mellinData V ((σ : ℂ) + t * Complex.I)‖) := by
      gcongr
    _ = ((A : ℝ) + 2) ^ j * ((1 + |t|) ^ (j + 2) *
        ‖mellinData V ((σ : ℂ) + t * Complex.I)‖) := by rw [mul_pow, pow_add]; ring
    _ ≤ _ := mul_le_mul_of_nonneg_left (hb σ hσ t) (by positivity)

theorem mellinEulerData_differentiableAt (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hsupp : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (j : ℕ) (s : ℂ) (hs : -(5 / 6 : ℝ) < s.re) :
    DifferentiableAt ℂ (mellinEulerData V j) s :=
  (differentiableAt_id.neg.pow j).mul
    (kernelMellinIntegrand_differentiableAt V a b ha hsupp hV s hs)

theorem mellinEulerData_vertical_integrable (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hsupp : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (A j : ℕ) (σ : ℝ) (hσ : σ ∈ Set.Icc (-(1 / 4 : ℝ)) (A : ℝ)) :
    Integrable (fun t : ℝ => mellinEulerData V j ((σ : ℂ) + t * Complex.I)) := by
  obtain ⟨C, hC, hb⟩ := mellinEulerData_strip_bound V a b ha hsupp hV A j
  have hc : Continuous (fun t : ℝ => mellinEulerData V j ((σ : ℂ) + t * Complex.I)) := by
    apply continuous_iff_continuousAt.mpr
    intro t
    apply (mellinEulerData_differentiableAt V a b ha hsupp hV j _ ?_).continuousAt.comp
    · fun_prop
    · simp only [Complex.add_re, Complex.ofReal_re, Complex.mul_re, Complex.ofReal_im,
        Complex.I_re, mul_zero, zero_mul, sub_zero, add_zero]
      linarith [hσ.1]
  apply (integrable_inv_one_add_sq.const_mul C).mono' hc.aestronglyMeasurable
  exact Filter.Eventually.of_forall (fun t => by simpa only [div_eq_mul_inv] using hb σ hσ t)


def inverseMellinIntegrand (V : ℝ → ℂ) (j : ℕ) (y : ℝ) (s : ℂ) : ℂ :=
  (y : ℂ) ^ (-s) * mellinEulerData V j s

theorem inverseMellinIntegrand_differentiableAt
    (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hsupp : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (j : ℕ) (y : ℝ) (hy : 0 < y) (s : ℂ) (hs : -(5 / 6 : ℝ) < s.re) :
    DifferentiableAt ℂ (inverseMellinIntegrand V j y) s := by
  exact (differentiableAt_id.neg.const_cpow
    (Or.inl (Complex.ofReal_ne_zero.mpr hy.ne'))).mul
    (mellinEulerData_differentiableAt V a b ha hsupp hV j s hs)

theorem inverseMellinIntegrand_vertical_integrable
    (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hsupp : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (A j : ℕ) (σ : ℝ) (hσ : σ ∈ Set.Icc (-(1 / 4 : ℝ)) (A : ℝ))
    (y : ℝ) (hy : 0 < y) :
    Integrable (fun t : ℝ => inverseMellinIntegrand V j y ((σ : ℂ) + t * Complex.I)) := by
  apply (mellinEulerData_vertical_integrable V a b ha hsupp hV A j σ hσ).bdd_mul
    (c := y ^ (-σ))
  · exact ((show Continuous (fun t : ℝ => -((σ : ℂ) + t * Complex.I)) by fun_prop).const_cpow
      (Or.inl (Complex.ofReal_ne_zero.mpr hy.ne'))).aestronglyMeasurable
  · filter_upwards [] with t
    rw [Complex.norm_cpow_eq_rpow_re_of_pos hy]
    simp

theorem inverseMellinIntegrand_strip_bound
    (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hsupp : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (A j : ℕ) (y : ℝ) (hy : 0 < y) :
    ∃ C : ℝ, 0 < C ∧ ∀ σ ∈ Set.Icc (-(1 / 4 : ℝ)) (A : ℝ), ∀ t : ℝ,
      ‖inverseMellinIntegrand V j y ((σ : ℂ) + t * Complex.I)‖ ≤ C / (1 + t ^ 2) := by
  obtain ⟨C, hC, hb⟩ := mellinEulerData_strip_bound V a b ha hsupp hV A j
  have hc : Continuous (fun σ : ℝ => y ^ (-σ)) :=
    (Real.continuous_const_rpow hy.ne').comp continuous_neg
  obtain ⟨B, hB⟩ := (isCompact_Icc : IsCompact (Set.Icc (-(1 / 4 : ℝ)) (A : ℝ))).bddAbove_image hc.continuousOn
  refine ⟨(|B| + 1) * C, by positivity, ?_⟩
  intro σ hσ t
  have hby : y ^ (-σ) ≤ |B| + 1 :=
    (hB (Set.mem_image_of_mem _ hσ)).trans (by linarith [le_abs_self B])
  rw [inverseMellinIntegrand, norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos hy]
  simp only [Complex.neg_re, Complex.add_re, Complex.ofReal_re, Complex.mul_re,
    Complex.ofReal_im, Complex.I_re, mul_zero, zero_mul, sub_zero, add_zero]
  calc
    _ ≤ (|B| + 1) * (C / (1 + t ^ 2)) :=
      mul_le_mul hby (hb σ hσ t) (norm_nonneg _) (by positivity)
    _ = _ := by ring

theorem mellinInv_euler_shift
    (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hsupp : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (A j : ℕ) (σ : ℝ) (hσ : σ ∈ Set.Icc (-(1 / 4 : ℝ)) (A : ℝ))
    (y : ℝ) (hy : 0 < y) :
    mellinInv 0 (mellinEulerData V j) y = mellinInv σ (mellinEulerData V j) y := by
  obtain ⟨C, hC, hb⟩ := inverseMellinIntegrand_strip_bound V a b ha hsupp hV A j y hy
  have h0 : (0 : ℝ) ∈ Set.Icc (-(1 / 4 : ℝ)) (A : ℝ) := by
    constructor
    · norm_num
    · exact Nat.cast_nonneg A
  have hshift (ρ : ℝ) (hρ : ρ ∈ Set.Icc (-(1 / 4 : ℝ)) (A : ℝ)) :
      (∫ t : ℝ, inverseMellinIntegrand V j y ((-(1 / 4) : ℝ) + t * Complex.I)) =
      ∫ t : ℝ, inverseMellinIntegrand V j y ((ρ : ℂ) + t * Complex.I) := by
    apply VerticalContourShift.integral_eq_of_strip_decay
      (inverseMellinIntegrand V j y) (-(1 / 4)) ρ C hρ.1
    · intro z hzlo hzhi
      apply inverseMellinIntegrand_differentiableAt V a b ha hsupp hV j y hy z
      linarith
    · apply inverseMellinIntegrand_vertical_integrable V a b ha hsupp hV A j
        (-(1 / 4)) ⟨le_rfl, hρ.1.trans hρ.2⟩ y hy
    · exact inverseMellinIntegrand_vertical_integrable V a b ha hsupp hV A j ρ hρ y hy
    · intro r hr t
      exact hb r ⟨hr.1, hr.2.trans hρ.2⟩ t
  have heq := (hshift 0 h0).symm.trans (hshift σ hσ)
  simpa only [mellinInv, smul_eq_mul, inverseMellinIntegrand] using
    congrArg (fun z : ℂ => (1 / (2 * Real.pi) : ℝ) • z) heq

theorem mellinInv_euler_line_bound
    (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hsupp : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (A j : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ σ ∈ Set.Icc (-(1 / 4 : ℝ)) (A : ℝ),
      ∀ y : ℝ, 0 < y → ‖mellinInv σ (mellinEulerData V j) y‖ ≤ C * y ^ (-σ) := by
  obtain ⟨C, hC, hb⟩ := mellinEulerData_strip_bound V a b ha hsupp hV A j
  refine ⟨C / 2, by positivity, ?_⟩
  intro σ hσ y hy
  have hint : ‖∫ t : ℝ, (y : ℂ) ^ (-((σ : ℂ) + t * Complex.I)) *
        mellinEulerData V j ((σ : ℂ) + t * Complex.I)‖ ≤ (y ^ (-σ) * C) * Real.pi := by
    calc
      _ ≤ ∫ t : ℝ, (y ^ (-σ) * C) * (1 + t ^ 2)⁻¹ := by
        apply norm_integral_le_of_norm_le (integrable_inv_one_add_sq.const_mul _)
        filter_upwards [] with t
        rw [norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos hy]
        simp only [Complex.neg_re, Complex.add_re, Complex.ofReal_re, Complex.mul_re,
          Complex.ofReal_im, Complex.I_re, mul_zero, zero_mul, sub_zero, add_zero]
        simpa only [div_eq_mul_inv, mul_assoc] using
          mul_le_mul_of_nonneg_left (hb σ hσ t) (Real.rpow_nonneg hy.le (-σ))
      _ = _ := by rw [integral_const_mul, integral_univ_inv_one_add_sq]
  rw [mellinInv, norm_smul, Real.norm_of_nonneg (by positivity : (0 : ℝ) ≤ 1 / (2 * Real.pi))]
  simp only [smul_eq_mul]
  calc
    _ ≤ (1 / (2 * Real.pi)) * ((y ^ (-σ) * C) * Real.pi) :=
      mul_le_mul_of_nonneg_left hint (by positivity)
    _ = _ := by field_simp


lemma weighted_vertical_series_continuous {α : Type*}
    (r : α→ℝ) (hr : ∀i,0<r i) (c : α→ℂ) (σ : ℝ)
    (hc : Summable (fun i=>‖c i‖*(r i)^(-σ))) :
    Continuous (fun t : ℝ=>∑'i,c i*(r i:ℂ)^(-((σ:ℂ)+t*Complex.I))) := by
  apply continuous_tsum
    (fun i=>continuous_const.mul (positive_cpow_negative_vertical_continuous (r i) σ (hr i))) hc
  intro i t
  change ‖c i*(r i:ℂ)^(-((σ:ℂ)+t*Complex.I))‖ ≤ ‖c i‖*(r i)^(-σ)
  rw [norm_mul,positive_cpow_negative_vertical_norm _ _ _ (hr i)]

lemma weighted_vertical_series_norm {α : Type*}
    (r : α→ℝ) (hr : ∀i,0<r i) (c : α→ℂ) (σ : ℝ)
    (hc : Summable (fun i=>‖c i‖*(r i)^(-σ))) (t : ℝ) :
    ‖∑'i,c i*(r i:ℂ)^(-((σ:ℂ)+t*Complex.I))‖ ≤ ∑'i,‖c i‖*(r i)^(-σ) := by
  have he (i : α) : ‖c i*(r i:ℂ)^(-((σ:ℂ)+t*Complex.I))‖=‖c i‖*(r i)^(-σ) := by
    rw [norm_mul,positive_cpow_negative_vertical_norm _ _ _ (hr i)]
  simpa only [he] using norm_tsum_le_tsum_norm (hc.congr (fun i=>(he i).symm))



/-! The cubic scale identifies the reflected inverse Mellin kernel and its weighted series. -/
/-- Scale matching the cubic Gamma-ratio Mellin kernel. -/
def paperScale : ℝ := (2 * Real.pi) ^ 4 / 27

lemma paperScale_pos : 0 < paperScale := by unfold paperScale; positivity

def paperKernel (V : ℝ → ℂ) (x : ℝ) : ℂ :=
  mellinInv 0 (fun s => mellin V (-s) * cubicReflectionGamma s) (paperScale * x)

lemma positive_nat_pow_cpow (x:ℝ) (hx:0 ≤ x) (n:ℕ) (s:ℂ) :
    ((x^n:ℝ):ℂ)^s=((x:ℂ)^s)^n := by
  induction n with
  | zero => simp
  | succ n hn =>
      rw [pow_succ,Complex.ofReal_mul,Complex.mul_cpow_ofReal_nonneg (pow_nonneg hx n) hx,
        hn,pow_succ]

lemma positive_reflection_powers (Q u d X r:ℝ)
    (hQ:0<Q) (hu:0<u) (hd:0<d) (hX:0<X) (hr:0<r) (w:ℂ) :
    (Q:ℂ)^(1+2*w)*(u:ℂ)^(2-2*w)*(2:ℂ)^(4*w)/(d:ℂ)^(2+2*w)*
      (X:ℂ)^(-w)*(r:ℂ)^(-w)=
      ((Q*(u/d)^2:ℝ):ℂ)*((u^2*d^2*X*r/(16*Q^2):ℝ):ℂ)^(-w) := by
  have hQ0:(Q:ℂ)≠0:=Complex.ofReal_ne_zero.mpr hQ.ne'
  have hu0:(u:ℂ)≠0:=Complex.ofReal_ne_zero.mpr hu.ne'
  have hd0:(d:ℂ)≠0:=Complex.ofReal_ne_zero.mpr hd.ne'
  have hX0:(X:ℂ)≠0:=Complex.ofReal_ne_zero.mpr hX.ne'
  have hr0:(r:ℂ)≠0:=Complex.ofReal_ne_zero.mpr hr.ne'
  have hQp:(Q:ℂ)^w≠0:=Complex.cpow_ne_zero_iff.mpr (Or.inl hQ0)
  have hup:(u:ℂ)^w≠0:=Complex.cpow_ne_zero_iff.mpr (Or.inl hu0)
  have hdp:(d:ℂ)^w≠0:=Complex.cpow_ne_zero_iff.mpr (Or.inl hd0)
  have hXp:(X:ℂ)^w≠0:=Complex.cpow_ne_zero_iff.mpr (Or.inl hX0)
  have hrp:(r:ℂ)^w≠0:=Complex.cpow_ne_zero_iff.mpr (Or.inl hr0)
  have h2p:(2:ℂ)^w≠0:=Complex.cpow_ne_zero_iff.mpr (Or.inl (by norm_num))
  have h16:((16:ℝ):ℂ)^w=((2:ℂ)^w)^4 := by
    have hh:=positive_nat_pow_cpow 2 (by norm_num) 4 w
    norm_num only [show (2:ℝ)^4=16 by norm_num] at hh
    exact hh
  have hy:((u^2*d^2*X*r/(16*Q^2):ℝ):ℂ)^w=
      (((u:ℂ)^w)^2*((d:ℂ)^w)^2*(X:ℂ)^w*(r:ℂ)^w)/
        (((2:ℂ)^w)^4*((Q:ℂ)^w)^2) := by
    rw [positive_div_cpow _ _ (by positivity) (by positivity)]
    rw [Complex.ofReal_mul,Complex.mul_cpow_ofReal_nonneg (by positivity) hr.le,
      Complex.ofReal_mul,Complex.mul_cpow_ofReal_nonneg (by positivity) hX.le,
      Complex.ofReal_mul,Complex.mul_cpow_ofReal_nonneg (by positivity) (by positivity),
      Complex.ofReal_mul,Complex.mul_cpow_ofReal_nonneg (by norm_num) (by positivity)]
    rw [positive_nat_pow_cpow u hu.le,positive_nat_pow_cpow d hd.le,
      positive_nat_pow_cpow Q hQ.le,h16]
  rw [Complex.cpow_add _ _ hQ0,Complex.cpow_one,
    Complex.cpow_sub _ _ hu0,Complex.cpow_add _ _ hd0]
  simp only [Complex.cpow_ofNat_mul,Complex.cpow_ofNat]
  rw [Complex.cpow_neg,Complex.cpow_neg,Complex.cpow_neg,hy]
  push_cast
  field_simp

theorem bessel_reflection_scale (q d Q X r:ℝ)
    (hq:0<q) (hd:0<d) (hQ:0<Q) (hX:0<X) (hr:0<r) (w:ℂ) :
    (Q:ℂ)^(2-2*(1/2-w))*besselReflectionFactor q d (1/2-w)*
      (X:ℂ)^(-w)*(r:ℂ)^(-w)=
      ((Q*(q/d)^2:ℝ):ℂ)*
        ((paperScale*(27*q^2*d^2*X*r/Q^2):ℝ):ℂ)^(-w) := by
  have he:=positive_reflection_powers Q (4*Real.pi*q) (4*Real.pi*d) X r
    hQ (by positivity) (by positivity) hX hr w
  have hp:Q*((4*Real.pi*q)/(4*Real.pi*d))^2=Q*(q/d)^2 := by
    field_simp
  have hy:(4*Real.pi*q)^2*(4*Real.pi*d)^2*X*r/(16*Q^2)=
      paperScale*(27*q^2*d^2*X*r/Q^2) := by
    unfold paperScale
    ring
  rw [hp,hy] at he
  unfold besselReflectionFactor
  convert he using 1 ; congr 2 ; ring_nf

lemma paperKernel_three_halves (V:ℝ→ℂ) (v0 v1:ℝ) (hv0:0<v0)
    (hVs:Function.support V⊆Set.Icc v0 v1) (hV:ContDiff ℝ ∞ V)
    (x:ℝ) (hx:0<x) :
    paperKernel V x=(1/(2*Real.pi):ℂ)*∫t:ℝ,
      ((paperScale*x:ℝ):ℂ)^(-((3/2:ℂ)+t*Complex.I))*
        mellinEulerData V 0 ((3/2:ℂ)+t*Complex.I) := by
  have he:=mellinInv_euler_shift V v0 v1 hv0 hVs hV 2 0 (3/2) (by norm_num)
    (paperScale*x) (mul_pos paperScale_pos hx)
  change paperKernel V x=_
  have hl:mellinInv 0 (mellinEulerData V 0) (paperScale*x)=paperKernel V x:=by
    have hf : mellinEulerData V 0=(fun s:ℂ=>mellin V (-s)*cubicReflectionGamma s) := by
      funext s
      simp only [mellinEulerData,pow_zero,one_mul,mellinData]
    rw [hf]
    rfl
  rw [hl] at he
  simpa only [mellinInv,smul_eq_mul,Complex.real_smul,Complex.ofReal_div,
    Complex.ofReal_one,Complex.ofReal_mul,Complex.ofReal_ofNat] using he

lemma paperKernel_three_halves_bound (V:ℝ→ℂ) (v0 v1:ℝ) (hv0:0<v0)
    (hVs:Function.support V⊆Set.Icc v0 v1) (hV:ContDiff ℝ ∞ V) :
    ∃C:ℝ,0<C ∧ ∀x:ℝ,0<x→‖paperKernel V x‖ ≤ C*(paperScale*x)^(-(3/2:ℝ)) := by
  obtain ⟨C,hC,hb⟩:=mellinInv_euler_line_bound V v0 v1 hv0 hVs hV 2 0
  refine ⟨C,hC,?_⟩
  intro x hx
  have he:=mellinInv_euler_shift V v0 v1 hv0 hVs hV 2 0 (3/2) (by norm_num)
    (paperScale*x) (mul_pos paperScale_pos hx)
  have hl:mellinInv 0 (mellinEulerData V 0) (paperScale*x)=paperKernel V x:=by
    have hf : mellinEulerData V 0=(fun s:ℂ=>mellin V (-s)*cubicReflectionGamma s) := by
      funext s
      simp only [mellinEulerData,pow_zero,one_mul,mellinData]
    rw [hf]
    rfl
  rw [hl] at he
  rw [he]
  exact hb (3/2) (by norm_num) (paperScale*x) (mul_pos paperScale_pos hx)

lemma paperKernel_weighted_summable {α:Type*}
    (r:α→ℝ) (hr:∀i,0<r i) (a:α→ℂ)
    (has:Summable (fun i=>‖a i‖*(r i)^(-(3/2:ℝ))))
    (V:ℝ→ℂ) (v0 v1:ℝ) (hv0:0<v0)
    (hVs:Function.support V⊆Set.Icc v0 v1) (hV:ContDiff ℝ ∞ V)
    (c:ℝ) (hc:0<c) : Summable (fun i=>a i*paperKernel V (c*r i)) := by
  obtain ⟨C,hC,hb⟩:=paperKernel_three_halves_bound V v0 v1 hv0 hVs hV
  apply Summable.of_norm
  apply (has.mul_left (C*(paperScale*c)^(-(3/2:ℝ)))).of_nonneg_of_le (fun i=>norm_nonneg _)
  intro i
  rw [norm_mul]
  calc
    _ ≤ ‖a i‖*(C*(paperScale*(c*r i))^(-(3/2:ℝ))):=
      mul_le_mul_of_nonneg_left (hb _ (mul_pos hc (hr i))) (norm_nonneg _)
    _=(C*(paperScale*c)^(-(3/2:ℝ)))*(‖a i‖*(r i)^(-(3/2:ℝ))):=by
      rw [show paperScale*(c*r i)=(paperScale*c)*r i by ring,
        Real.mul_rpow (mul_pos paperScale_pos hc).le (hr i).le]
      ring

theorem paperKernel_weighted_mellin {α:Type*} [Countable α]
    (r:α→ℝ) (hr:∀i,0<r i) (a:α→ℂ)
    (has:Summable (fun i=>‖a i‖*(r i)^(-(3/2:ℝ))))
    (V:ℝ→ℂ) (v0 v1:ℝ) (hv0:0<v0)
    (hVs:Function.support V⊆Set.Icc v0 v1) (hV:ContDiff ℝ ∞ V)
    (c:ℝ) (hc:0<c) :
    (∑'i,a i*paperKernel V (c*r i))=(1/(2*Real.pi):ℂ)*∫t:ℝ,
      (∑'i,a i*(r i:ℂ)^(-((3/2:ℂ)+t*Complex.I)))*
        (((paperScale*c:ℝ):ℂ)^(-((3/2:ℂ)+t*Complex.I))*
          mellinEulerData V 0 ((3/2:ℂ)+t*Complex.I)) := by
  let M:ℝ→ℂ:=fun t=>((paperScale*c:ℝ):ℂ)^(-((3/2:ℂ)+t*Complex.I))*
    mellinEulerData V 0 ((3/2:ℂ)+t*Complex.I)
  have hM:Integrable M:=by
    simpa only [M,inverseMellinIntegrand,Complex.ofReal_div,Complex.ofReal_ofNat] using
      inverseMellinIntegrand_vertical_integrable V v0 v1 hv0 hVs hV 2 0 (3/2)
        (by norm_num) (paperScale*c) (mul_pos paperScale_pos hc)
  have hi (i:α) : a i*paperKernel V (c*r i)=(1/(2*Real.pi):ℂ)*∫t:ℝ,
      a i*(r i:ℂ)^(-((3/2:ℂ)+t*Complex.I))*M t := by
    rw [paperKernel_three_halves V v0 v1 hv0 hVs hV _ (mul_pos hc (hr i))]
    rw [←mul_assoc,mul_comm (a i),mul_assoc,←integral_const_mul]
    congr 1
    apply integral_congr_ae
    filter_upwards with t
    rw [show paperScale*(c*r i)=(paperScale*c)*r i by ring,
      Complex.ofReal_mul,Complex.mul_cpow_ofReal_nonneg (mul_pos paperScale_pos hc).le (hr i).le]
    dsimp only [M]
    ring
  simp_rw [hi]
  rw [tsum_mul_left]
  congr 1
  simpa only [M,Complex.ofReal_div,Complex.ofReal_ofNat] using
    weighted_vertical_sum_integral r hr a (3/2) has M hM

theorem paperKernel_weighted_norm_summable {α:Type*}
    (r:α→ℝ) (hr:∀i,0<r i) (a:α→ℂ)
    (has:Summable (fun i=>‖a i‖*(r i)^(-(3/2:ℝ))))
    (V:ℝ→ℂ) (v0 v1:ℝ) (hv0:0<v0)
    (hVs:Function.support V⊆Set.Icc v0 v1) (hV:ContDiff ℝ ∞ V)
    (c:ℝ) (hc:0<c) : Summable (fun i=>‖a i*paperKernel V (c*r i)‖) := by
  obtain ⟨C,hC,hb⟩:=paperKernel_three_halves_bound V v0 v1 hv0 hVs hV
  apply (has.mul_left (C*(paperScale*c)^(-(3/2:ℝ)))).of_nonneg_of_le (fun i=>norm_nonneg _)
  intro i
  rw [norm_mul]
  calc
    _ ≤ ‖a i‖*(C*(paperScale*(c*r i))^(-(3/2:ℝ))):=
      mul_le_mul_of_nonneg_left (hb _ (mul_pos hc (hr i))) (norm_nonneg _)
    _=(C*(paperScale*c)^(-(3/2:ℝ)))*(‖a i‖*(r i)^(-(3/2:ℝ))):=by
      rw [show paperScale*(c*r i)=(paperScale*c)*r i by ring,
        Real.mul_rpow (mul_pos paperScale_pos hc).le (hr i).le]
      ring


/-! The initial source series uses the conjugate horizontal frequency. Its norm is unchanged. -/
/-- Changing Wirtinger derivative only rotates each nonzero Fourier coefficient. -/
def sourceBarRadialCoefficient (z : ℂ) (h : O) : ℂ :=
  (star (cuspFrequency h) / cuspFrequency h) * sourceCuspRadialCoefficient 0 z h

lemma sourceBarRadialCoefficient_norm (z : ℂ) (h : O) :
    ‖sourceBarRadialCoefficient z h‖ = ‖sourceCuspRadialCoefficient 0 z h‖ := by
  by_cases hh : h = 0
  · subst h
    simp only [sourceBarRadialCoefficient, sourceCuspRadialCoefficient_zero, mul_zero]
  · rw [sourceBarRadialCoefficient, norm_mul, norm_div, norm_star,
      div_self (norm_ne_zero_iff.mpr (cuspFrequency_ne_zero h hh)), one_mul]

lemma sourceZBesselTerm_eq_rotated (z : ℂ) (v : ℝ) (h : O) :
    star (cubicBesselTerm sourceZBesselCoefficient h (v, z)) =
      (star (cuspFrequency h) / cuspFrequency h) * sourceCuspZTerm 0 z v h := by
  by_cases hh : h = 0
  · subst h
    simp only [sourceCuspZTerm_zero, mul_zero, cubicBesselTerm, cubicBesselAmplitude,
      if_true, zero_mul, star_zero]
  · have hc : star (sourceZBesselCoefficient h) =
        (star (cuspFrequency h) / cuspFrequency h) * star (sourceBarBesselCoefficient h) := by
      simp only [sourceZBesselCoefficient, sourceBarBesselCoefficient, star_mul, star_star]
      field_simp [cuspFrequency_ne_zero h hh]
    simp only [sourceCuspZTerm, sourceCuspBarCoefficient, sourceCuspScale,
      Matrix.cons_val_zero, div_one, Complex.ofReal_one]
    simp only [cubicBesselTerm, cubicBesselAmplitude, if_neg hh, star_mul]
    rw [hc]
    ring

lemma sourceBarProfile_eq_radial (z : ℂ) (v : ℝ) (hv : 0 < v) :
    cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) z v =
      radialBesselProfile sourceCuspRadialLength (sourceBarRadialCoefficient z)
        (sourceCuspRadialScale 0) v := by
  rw [conjugateSource_barProfile z v hv, cuspZProfile_positive _ _ _ hv,
    cubicSource_wirtingerZ_bessel v hv z, tsum_star]
  unfold radialBesselProfile
  apply tsum_congr
  intro h
  rw [sourceZBesselTerm_eq_rotated, sourceCuspZTerm_eq_radial 0 z v hv h]
  unfold sourceBarRadialCoefficient
  ring

lemma sourceBarRadialCoefficient_summable (z : ℂ) (σ : ℝ) (hσ : 2 ≤ σ) :
    Summable (fun h : O => ‖sourceBarRadialCoefficient z h‖ *
      sourceCuspRadialLength h ^ (1 / 2 - σ)) := by
  simp only [sourceBarRadialCoefficient_norm]
  exact sourceCuspRadialCoefficient_summable 0 z σ hσ

def sourceBarRadialDirichlet (z s : ℂ) : ℂ :=
  ∑' h : O, sourceBarRadialCoefficient z h * (sourceCuspRadialLength h : ℂ) ^ (1 / 2 - s)

theorem sourceBarProfile_mellin (z s : ℂ) (hs : 2 ≤ s.re) :
    mellin (cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) z) (2 * s) =
      besselMellinFactor (sourceCuspRadialScale 0) s * sourceBarRadialDirichlet z s := by
  letI : Countable O := Coordinates.coordinateEquiv.injective.countable
  have he : mellin (cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) z) (2 * s) =
      mellin (radialBesselProfile sourceCuspRadialLength (sourceBarRadialCoefficient z)
        (sourceCuspRadialScale 0)) (2 * s) := by
    unfold mellin
    apply setIntegral_congr_fun measurableSet_Ioi
    intro v hv
    dsimp only
    rw [sourceBarProfile_eq_radial z v hv]
  rw [he]
  exact radialBesselProfile_mellin sourceCuspRadialLength sourceCuspRadialLength_pos
    (sourceBarRadialCoefficient z) (sourceCuspRadialScale 0) (sourceCuspRadialScale_pos 0)
    s (by linarith) (sourceBarRadialCoefficient_summable z s.re hs)

theorem sourceBarProfile_dirichlet (z s : ℂ) (hs : 2 ≤ s.re) :
    continuedBesselDirichlet (cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) z)
      (sourceCuspRadialScale 0) s = sourceBarRadialDirichlet z s := by
  rw [continuedBesselDirichlet, sourceBarProfile_mellin z s hs, ← mul_assoc,
    inverseBesselMellinFactor_mul _ (sourceCuspRadialScale_pos 0) s (by linarith), one_mul]


/-- The dual radial scale determined by a rational cusp. -/
def SourceCuspDatum.smoothingScale (d : SourceCuspDatum) (X : ℝ) : ℝ :=
  27 * (sourceCuspRadialScale 0) ^ 2 * (sourceCuspRadialScale d.index) ^ 2 * X / d.heightScale ^ 2

def SourceCuspDatum.smoothingMultiplier (d : SourceCuspDatum) : ℂ :=
  d.multiplier * ((d.heightScale * (sourceCuspRadialScale 0 / sourceCuspRadialScale d.index) ^ 2 : ℝ) : ℂ)

lemma SourceCuspDatum.smoothingScale_pos (d : SourceCuspDatum) (X : ℝ) (hX : 0 < X) :
    0 < d.smoothingScale X := by
  unfold SourceCuspDatum.smoothingScale
  exact div_pos (mul_pos (mul_pos (mul_pos (by norm_num)
    (sq_pos_of_pos (sourceCuspRadialScale_pos 0)))
    (sq_pos_of_pos (sourceCuspRadialScale_pos d.index))) hX) (sq_pos_of_pos d.heightScale_pos)

lemma SourceCuspDatum.smoothing_reflected_line (d : SourceCuspDatum)
    (V : ℝ → ℂ) (X : ℝ) (hX : 0 < X) (t : ℝ) :
    besselSmoothingIntegrand
      (cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) d.point)
      (sourceCuspRadialScale 0) V X ((-1 : ℂ) + (-t) * Complex.I) =
      d.smoothingMultiplier *
        ((∑' h : O, sourceCuspRadialCoefficient d.index d.dualPoint h *
          (sourceCuspRadialLength h : ℂ) ^ (-((3 / 2 : ℂ) + t * Complex.I))) *
          (((paperScale * d.smoothingScale X : ℝ) : ℂ) ^ (-((3 / 2 : ℂ) + t * Complex.I)) *
            mellinEulerData V 0 ((3 / 2 : ℂ) + t * Complex.I))) := by
  let s : ℂ := (-1 : ℂ) + (-t) * Complex.I
  let w : ℂ := (3 / 2 : ℂ) + t * Complex.I
  have hw : 1 / 2 - s = w := by dsimp [s, w]; ring
  have hsw : s - 1 / 2 = -w := by dsimp [s, w]; ring
  have hws : 1 / 2 - w = s := by dsimp [s, w]; ring
  have hp := bessel_reflection_scale (sourceCuspRadialScale 0) (sourceCuspRadialScale d.index)
    d.heightScale X 1 (sourceCuspRadialScale_pos 0) (sourceCuspRadialScale_pos d.index)
    d.heightScale_pos hX (by norm_num) w
  simp only [hws, Complex.ofReal_one, Complex.one_cpow, mul_one] at hp
  have hd : sourceCuspRadialDirichlet d.index d.dualPoint (1 - s) =
      ∑' h : O, sourceCuspRadialCoefficient d.index d.dualPoint h *
        (sourceCuspRadialLength h : ℂ) ^ (-w) := by
    unfold sourceCuspRadialDirichlet
    rw [show (1 / 2 : ℂ) - (1 - s) = -w by rw [← hsw]; ring]
  change besselSmoothingIntegrand _ _ V X s = _
  rw [besselSmoothingIntegrand, d.dirichlet_reflection _ s (by dsimp [s]; norm_num), hw, hsw, hd]
  change _ = d.smoothingMultiplier *
    ((∑' h : O, sourceCuspRadialCoefficient d.index d.dualPoint h *
      (sourceCuspRadialLength h : ℂ) ^ (-w)) *
      (((paperScale * d.smoothingScale X : ℝ) : ℂ) ^ (-w) * mellinEulerData V 0 w))
  rw [mellinEulerData, pow_zero, one_mul, mellinData]
  calc
    _ = (d.multiplier * mellin V (-w) * cubicReflectionGamma w *
          (∑' h : O, sourceCuspRadialCoefficient d.index d.dualPoint h *
            (sourceCuspRadialLength h : ℂ) ^ (-w))) *
        ((d.heightScale : ℂ) ^ (2 - 2 * s) *
          besselReflectionFactor (sourceCuspRadialScale 0) (sourceCuspRadialScale d.index) s *
          (X : ℂ) ^ (-w)) := by ring
    _ = _ := by
      rw [hp]
      unfold SourceCuspDatum.smoothingMultiplier SourceCuspDatum.smoothingScale
      ring

lemma weighted_vertical_sum_mul_integrable {α : Type*}
    (r : α → ℝ) (hr : ∀ i, 0 < r i) (a : α → ℂ) (σ : ℝ)
    (ha : Summable (fun i => ‖a i‖ * (r i) ^ (-σ)))
    (M : ℝ → ℂ) (hM : Integrable M) :
    Integrable (fun t : ℝ => (∑' i, a i * (r i : ℂ) ^ (-((σ : ℂ) + t * Complex.I))) * M t) := by
  have hD := weighted_vertical_series_continuous r hr a σ ha
  have hDb := weighted_vertical_series_norm r hr a σ ha
  simpa only [mul_comm] using hM.mul_bdd hD.aestronglyMeasurable (Eventually.of_forall hDb)

lemma SourceCuspDatum.smoothing_left_integrable (d : SourceCuspDatum)
    (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hVs : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (X : ℝ) (hX : 0 < X) :
    Integrable (fun t : ℝ => besselSmoothingIntegrand
      (cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) d.point)
      (sourceCuspRadialScale 0) V X ((-1 : ℂ) + t * Complex.I)) := by
  let M : ℝ → ℂ := fun t =>
    (∑' h : O, sourceCuspRadialCoefficient d.index d.dualPoint h *
      (sourceCuspRadialLength h : ℂ) ^ (-((3 / 2 : ℂ) + t * Complex.I))) *
      (((paperScale * d.smoothingScale X : ℝ) : ℂ) ^ (-((3 / 2 : ℂ) + t * Complex.I)) *
        mellinEulerData V 0 ((3 / 2 : ℂ) + t * Complex.I))
  have hK := inverseMellinIntegrand_vertical_integrable V a b ha hVs hV 2 0 (3 / 2)
    (by norm_num) (paperScale * d.smoothingScale X) (mul_pos paperScale_pos (d.smoothingScale_pos X hX))
  have hc : Summable (fun h : O => ‖sourceCuspRadialCoefficient d.index d.dualPoint h‖ *
      sourceCuspRadialLength h ^ (-(3 / 2 : ℝ))) := by
    simpa only [neg_div] using
      sourceCuspRadialCoefficient_weighted_summable d.index d.dualPoint
  have hi : Integrable M := by
    simpa only [M, inverseMellinIntegrand, Complex.ofReal_div, Complex.ofReal_ofNat] using
      weighted_vertical_sum_mul_integrable sourceCuspRadialLength sourceCuspRadialLength_pos
        (sourceCuspRadialCoefficient d.index d.dualPoint) (3 / 2)
        hc
        (fun t : ℝ => inverseMellinIntegrand V 0 (paperScale * d.smoothingScale X)
          (((3 / 2 : ℝ) : ℂ) + t * Complex.I)) hK
  apply ((hi.comp_neg).const_mul d.smoothingMultiplier).congr
  filter_upwards with t
  simpa only [M, Complex.ofReal_neg, neg_neg] using (d.smoothing_reflected_line V X hX (-t)).symm

theorem SourceCuspDatum.smoothing_left_kernel (d : SourceCuspDatum)
    (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hVs : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (X : ℝ) (hX : 0 < X) :
    (1 / (2 * Real.pi) : ℂ) * (∫ t : ℝ, besselSmoothingIntegrand
      (cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) d.point)
      (sourceCuspRadialScale 0) V X ((-1 : ℂ) + t * Complex.I)) =
      d.smoothingMultiplier * ∑' h : O, sourceCuspRadialCoefficient d.index d.dualPoint h *
        paperKernel V (d.smoothingScale X * sourceCuspRadialLength h) := by
  letI : Countable O := Coordinates.coordinateEquiv.injective.countable
  have hc : Summable (fun h : O => ‖sourceCuspRadialCoefficient d.index d.dualPoint h‖ *
      sourceCuspRadialLength h ^ (-(3 / 2 : ℝ))) := by
    simpa only [neg_div] using
      sourceCuspRadialCoefficient_weighted_summable d.index d.dualPoint
  have hk := paperKernel_weighted_mellin sourceCuspRadialLength sourceCuspRadialLength_pos
    (sourceCuspRadialCoefficient d.index d.dualPoint)
    hc V a b ha hVs hV
    (d.smoothingScale X) (d.smoothingScale_pos X hX)
  rw [hk]
  rw [← integral_neg_eq_self (fun t : ℝ => besselSmoothingIntegrand
    (cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) d.point)
    (sourceCuspRadialScale 0) V X ((-1 : ℂ) + t * Complex.I)) volume]
  simp only [Complex.ofReal_neg, d.smoothing_reflected_line V X hX]
  rw [integral_const_mul]
  ring

lemma sourceBar_smoothing_initial_line (z : ℂ) (V : ℝ → ℂ) (X : ℝ) (t : ℝ) :
    besselSmoothingIntegrand (cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) z)
      (sourceCuspRadialScale 0) V X ((2 : ℂ) + t * Complex.I) =
      mellin V ((3 / 2 : ℂ) + t * Complex.I) * (X : ℂ) ^ ((3 / 2 : ℂ) + t * Complex.I) *
        (∑' h : O, sourceBarRadialCoefficient z h *
          (sourceCuspRadialLength h : ℂ) ^ (-((3 / 2 : ℂ) + t * Complex.I))) := by
  rw [besselSmoothingIntegrand, sourceBarProfile_dirichlet z _ (by norm_num), sourceBarRadialDirichlet]
  rw [show (2 : ℂ) + t * Complex.I - 1 / 2 = 3 / 2 + t * Complex.I by ring,
    show (1 / 2 : ℂ) - (2 + t * Complex.I) = -(3 / 2 + t * Complex.I) by ring]

/-- Exact smoothed reflection of the actual cubic source at every rational cusp. -/
theorem SourceCuspDatum.smoothed_reflection (d : SourceCuspDatum)
    (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hVs : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (X : ℝ) (hX : 0 < X) :
    (∑' h : O, sourceBarRadialCoefficient d.point h * V (sourceCuspRadialLength h / X)) =
      d.smoothingMultiplier * ∑' h : O, sourceCuspRadialCoefficient d.index d.dualPoint h *
        paperKernel V (d.smoothingScale X * sourceCuspRadialLength h) := by
  letI : Countable O := Coordinates.coordinateEquiv.injective.countable
  have hc : Summable (fun h : O => ‖sourceBarRadialCoefficient d.point h‖ *
      sourceCuspRadialLength h ^ (-(3 / 2 : ℝ))) := by
    simpa only [show (1 / 2 : ℝ) - 2 = -(3 / 2) by norm_num] using
      sourceBarRadialCoefficient_summable d.point 2 le_rfl
  have hm := weightedMellin_inversion sourceCuspRadialLength sourceCuspRadialLength_pos
    (sourceBarRadialCoefficient d.point) (3 / 2) hc V a b ha hVs hV X hX
  have hmi := compactMellin_vertical_integrable V a b ha hVs hV (3 / 2)
  have hbase := vertical_power_mul_integrable _ hmi X (3 / 2) hX
  have hi := weighted_vertical_sum_mul_integrable sourceCuspRadialLength sourceCuspRadialLength_pos
    (sourceBarRadialCoefficient d.point) (3 / 2) hc
    (fun t : ℝ => (X : ℂ) ^ (((3 / 2 : ℝ) : ℂ) + t * Complex.I) *
      mellin V (((3 / 2 : ℝ) : ℂ) + t * Complex.I)) hbase
  have hright : Integrable (fun t : ℝ => besselSmoothingIntegrand
      (cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) d.point)
      (sourceCuspRadialScale 0) V X ((2 : ℂ) + t * Complex.I)) := by
    simp_rw [sourceBar_smoothing_initial_line]
    apply hi.congr
    filter_upwards with t
    simp only [Complex.ofReal_div, Complex.ofReal_ofNat]
    ring
  have hleft' : Integrable (fun t : ℝ => besselSmoothingIntegrand
      (cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) d.point)
      (sourceCuspRadialScale 0) V X (((-1 : ℝ) : ℂ) + t * Complex.I)) := by
    simpa only [Complex.ofReal_neg, Complex.ofReal_one] using
      d.smoothing_left_integrable V a b ha hVs hV X hX
  have hright' : Integrable (fun t : ℝ => besselSmoothingIntegrand
      (cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) d.point)
      (sourceCuspRadialScale 0) V X (((2 : ℝ) : ℂ) + t * Complex.I)) := by
    simpa only [Complex.ofReal_ofNat] using hright
  have hshift := besselSmoothingIntegrand_contour_eq
    (cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) d.point)
    (sourceCuspRadialScale 0) (sourceCuspRadialScale_pos 0)
    d.mellin_entire.1.1 d.mellin_entire.1.2 V a b ha hVs hV X hX (-1) 2 (by norm_num)
    hleft' hright'
  simp only [Complex.ofReal_neg, Complex.ofReal_one, Complex.ofReal_ofNat] at hshift
  have hm' : (∑' h : O, sourceBarRadialCoefficient d.point h * V (sourceCuspRadialLength h / X)) =
      (1 / (2 * Real.pi) : ℂ) * (∫ t : ℝ, besselSmoothingIntegrand
        (cuspBarProfile (fun w => star (cubicSourceResidualFunction w)) d.point)
        (sourceCuspRadialScale 0) V X ((2 : ℂ) + t * Complex.I)) := by
    simpa only [sourceBar_smoothing_initial_line, Complex.ofReal_div, Complex.ofReal_ofNat] using hm
  rw [hm', ← hshift]
  exact d.smoothing_left_kernel V a b ha hVs hV X hX

lemma compactMellin_power_bound (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hVs : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V) (σ : ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ, 0 < x → ‖V x‖ ≤ C * x ^ (-σ) := by
  let C : ℝ := ‖(1 / (2 * Real.pi) : ℂ)‖ *
    ∫ t : ℝ, ‖mellin V ((σ : ℂ) + t * Complex.I)‖
  refine ⟨C, mul_nonneg (norm_nonneg _) (integral_nonneg (fun _ => norm_nonneg _)), ?_⟩
  intro x hx
  rw [compactMellin_inversion V a b ha hVs hV σ x hx, norm_mul]
  calc
    _ ≤ ‖(1 / (2 * Real.pi) : ℂ)‖ *
        ∫ t : ℝ, ‖(x : ℂ) ^ (-((σ : ℂ) + t * Complex.I)) *
          mellin V ((σ : ℂ) + t * Complex.I)‖ :=
      mul_le_mul_of_nonneg_left (norm_integral_le_integral_norm _) (norm_nonneg _)
    _ = C * x ^ (-σ) := by
      simp only [norm_mul, positive_cpow_negative_vertical_norm x σ _ hx, integral_const_mul]
      dsimp only [C]
      ring

lemma weighted_compact_test_norm_summable {α : Type*}
    (r : α → ℝ) (hr : ∀ i, 0 < r i) (c : α → ℂ) (σ : ℝ)
    (hc : Summable (fun i => ‖c i‖ * (r i) ^ (-σ)))
    (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hVs : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (X : ℝ) (hX : 0 < X) : Summable (fun i => ‖c i * V (r i / X)‖) := by
  obtain ⟨C, hC, hb⟩ := compactMellin_power_bound V a b ha hVs hV σ
  apply (hc.mul_left (C / X ^ (-σ))).of_nonneg_of_le (fun i => norm_nonneg _)
  intro i
  rw [norm_mul]
  calc
    _ ≤ ‖c i‖ * (C * (r i / X) ^ (-σ)) :=
      mul_le_mul_of_nonneg_left (hb _ (div_pos (hr i) hX)) (norm_nonneg _)
    _ = _ := by rw [Real.div_rpow (hr i).le hX.le]; ring

lemma sourceBarRadialCoefficient_phase (z : ℂ) (h : O) :
    sourceBarRadialCoefficient z h =
      sourceBarRadialCoefficient 0 h * tracePhase (-cuspFrequency h * z) := by
  simp only [sourceBarRadialCoefficient, sourceCuspRadialCoefficient, sourceCuspScale,
    Matrix.cons_val_zero, Complex.ofReal_one, div_one, mul_zero, AddChar.map_zero_eq_one, mul_one]
  ring

lemma sourceBarRadialCoefficient_at_zero (h : O) :
    sourceBarRadialCoefficient 0 h = star (rationalSourceResidualFourierCoefficient h) *
      ((-2 * Real.pi * Complex.I * star (cuspFrequency h)) / (sourceCuspRadialLength h : ℂ)) := by
  by_cases hh : h = 0
  · subst h
    simp only [sourceBarRadialCoefficient, sourceCuspRadialCoefficient_zero, mul_zero,
      cuspFrequency, map_zero, zero_div, star_zero, zero_mul]
  · simp only [sourceBarRadialCoefficient, sourceCuspRadialCoefficient, sourceCuspRadialBaseCoefficient,
      sourceCuspCoefficient, sourceCuspScale, Matrix.cons_val_zero, Complex.ofReal_one,
      one_pow, one_mul, div_one, mul_zero, AddChar.map_zero_eq_one, mul_one]
    field_simp [cuspFrequency_ne_zero h hh]
    <;> ring

lemma sourceBar_smoothed_finite_translation (c : O) (hc : c ≠ 0)
    [Fintype (O ⧸ Ideal.span {c})] (φ : (O ⧸ Ideal.span {c}) → ℂ)
    (W : O → ℂ) (hW : Summable (fun h : O => ‖sourceBarRadialCoefficient 0 h * W h‖)) :
    (∑ i, finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 c hc) φ i *
      ∑' h : O, sourceBarRadialCoefficient (thetaFourierTranslation c i) h * W h) =
      ∑' h : O, φ (Ideal.Quotient.mk _ h) * sourceBarRadialCoefficient 0 h * W h := by
  let coeff : O → ℂ := fun h => star (sourceBarRadialCoefficient 0 h * W h)
  have hs : Summable (fun h => ‖coeff h‖) := by simpa only [coeff, norm_star] using hW
  have he := conjugate_cuspCharacterSeries_finite_translation coeff hs
    (thetaFourierTranslation c) (finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 c hc) φ) 0
  simp only [zero_add, thetaFourierTranslation_inversion c hc, mul_zero,
    AddChar.map_zero_eq_one, mul_one, coeff, star_star] at he
  calc
    _ = ∑ i, finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 c hc) φ i *
        star (cuspCharacterSeries coeff (thetaFourierTranslation c i)) := by
      apply Finset.sum_congr rfl
      intro i hi
      congr 1
      rw [conjugate_cuspCharacterSeries]
      apply tsum_congr
      intro h
      rw [sourceBarRadialCoefficient_phase]
      simp only [coeff, star_star]
      ring
    _ = _ := by simpa only [mul_assoc] using he

/-- The smoothed squarefree-times-cube cubic Gauss sum, with its horizontal derivative weight. -/
def thetaSmoothedGaussSum (Ψ : O →* ℂ) (V : ℝ → ℂ) (X : ℝ) : ℂ :=
  ∑' p : ThetaPrimaryCubePair,
    ((‖ringComplex (primaryIdealGenerator p.2.val)‖ : ℂ) *
      normalizedCubicUnitGauss (primaryIdealGenerator p.1.val) *
      Ψ (primaryIdealGenerator p.1.val) * (Ψ (primaryIdealGenerator p.2.val)) ^ 3) *
      (((-2 * Real.pi * Complex.I * star (cuspFrequency
        (primaryIdealGenerator p.1.val * (primaryIdealGenerator p.2.val) ^ 3))) /
        (sourceCuspRadialLength (primaryIdealGenerator p.1.val *
          (primaryIdealGenerator p.2.val) ^ 3) : ℂ)) *
        V (sourceCuspRadialLength (primaryIdealGenerator p.1.val *
          (primaryIdealGenerator p.2.val) ^ 3) / X))

/-- Finite Fourier inversion and cusp reflection give an exact dual formula for the arithmetic Gauss sum. -/
theorem thetaSmoothedGaussSum_finite_reflection (c : O) (hc : c ≠ 0)
    [Fintype (O ⧸ Ideal.span {9 * c})] (Ψ : (O ⧸ Ideal.span {c}) →* ℂ)
    (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hVs : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (X : ℝ) (hX : 0 < X) :
    thetaSmoothedGaussSum (Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom) V X =
      rationalSourceThetaScalar⁻¹ *
        ∑ i, finiteAdditiveFourierCoeff
          (residueTraceQuotientChar 1 (9 * c) (mul_ne_zero (by norm_num) hc)) (finiteThetaTwist c Ψ) i *
          ((finiteTwistCusp (9 * c) (mul_ne_zero (by norm_num) hc) i).smoothingMultiplier *
            ∑' h : O, sourceCuspRadialCoefficient
              (finiteTwistCusp (9 * c) (mul_ne_zero (by norm_num) hc) i).index
              (finiteTwistCusp (9 * c) (mul_ne_zero (by norm_num) hc) i).dualPoint h *
              paperKernel V ((finiteTwistCusp (9 * c) (mul_ne_zero (by norm_num) hc) i).smoothingScale X *
                sourceCuspRadialLength h)) := by
  let χ := Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom
  let W : O → ℂ := fun h => V (sourceCuspRadialLength h / X)
  have hcoef : Summable (fun h : O => ‖sourceBarRadialCoefficient 0 h‖ *
      sourceCuspRadialLength h ^ (-(3 / 2 : ℝ))) := by
    simpa only [show (1 / 2 : ℝ) - 2 = -(3 / 2) by norm_num] using
      sourceBarRadialCoefficient_summable 0 2 le_rfl
  have hW : Summable (fun h : O => ‖sourceBarRadialCoefficient 0 h * W h‖) :=
    weighted_compact_test_norm_summable sourceCuspRadialLength sourceCuspRadialLength_pos
      (sourceBarRadialCoefficient 0) (3 / 2) hcoef V a b ha hVs hV X hX
  have hf := sourceBar_smoothed_finite_translation (9 * c) (mul_ne_zero (by norm_num) hc)
    (finiteThetaTwist c Ψ) W hW
  calc
    _ = ∑' h : O, (rationalSourceThetaScalar⁻¹ * star (rationalSourceResidualFourierCoefficient h) *
        fixedThetaTwist χ h) *
        (((-2 * Real.pi * Complex.I * star (cuspFrequency h)) /
          (sourceCuspRadialLength h : ℂ)) * W h) := (fixedThetaTwist_source_tsum χ _).symm
    _ = rationalSourceThetaScalar⁻¹ *
        ∑' h : O, finiteThetaTwist c Ψ (Ideal.Quotient.mk _ h) * sourceBarRadialCoefficient 0 h * W h := by
      rw [← tsum_mul_left]
      apply tsum_congr
      intro h
      rw [sourceBarRadialCoefficient_at_zero, finiteThetaTwist_mk]
      ring
    _ = rationalSourceThetaScalar⁻¹ *
        ∑ i, finiteAdditiveFourierCoeff
          (residueTraceQuotientChar 1 (9 * c) (mul_ne_zero (by norm_num) hc)) (finiteThetaTwist c Ψ) i *
          ∑' h : O, sourceBarRadialCoefficient (thetaFourierTranslation (9 * c) i) h * W h := by rw [hf]
    _ = _ := by
      congr 1
      apply Finset.sum_congr rfl
      intro i hi
      congr 1
      rw [← finiteTwistCusp_point (9 * c) (mul_ne_zero (by norm_num) hc) i]
      exact (finiteTwistCusp (9 * c) (mul_ne_zero (by norm_num) hc) i).smoothed_reflection V a b ha hVs hV X hX

lemma sourceCuspRadialScale_ratio (j : Fin 3) :
    sourceCuspRadialScale 0 / sourceCuspRadialScale j = sourceCuspScale j := by
  have h0 : sourceCuspRadialScale 0 = thetaBesselScale := by
    simp only [sourceCuspRadialScale, sourceCuspScale, Matrix.cons_val_zero, div_one]
  rw [h0, sourceCuspRadialScale]
  field_simp [thetaBesselScale_pos.ne']

/-- The cusp denominator cancels from the reflected amplitude. -/
lemma SourceCuspDatum.smoothingMultiplier_norm (d : SourceCuspDatum) :
    ‖d.smoothingMultiplier‖ = (sourceCuspScale d.index) ^ 2 := by
  rw [SourceCuspDatum.smoothingMultiplier, sourceCuspRadialScale_ratio,
    norm_mul, d.multiplier_norm, Complex.norm_of_nonneg
      (mul_nonneg d.heightScale_pos.le (sq_nonneg _)), ← mul_assoc,
    inv_mul_cancel₀ d.heightScale_pos.ne', one_mul]

lemma SourceCuspDatum.smoothingMultiplier_norm_le (d : SourceCuspDatum) :
    ‖d.smoothingMultiplier‖ ≤ 9 := by
  rw [d.smoothingMultiplier_norm]
  rcases d with ⟨G, j, hj⟩
  fin_cases j <;> norm_num [sourceCuspScale]

/-- The square-root weight converting the radial derivative into the completed Gauss sum. -/
def Vstar (W : ℝ → ℂ) (y : ℝ) : ℂ := (Real.sqrt y : ℂ) * W y

lemma Vstar_support (W : ℝ → ℂ) (a b : ℝ)
    (hW : Function.support W ⊆ Set.Icc a b) : Function.support (Vstar W) ⊆ Set.Icc a b := by
  intro x hx
  apply hW
  intro hz
  exact hx (by simp only [Vstar, hz, mul_zero])

lemma Vstar_contDiff (W : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support W ⊆ Set.Icc a b) (hW : ContDiff ℝ ∞ W) :
    ContDiff ℝ ∞ (Vstar W) := by
  rw [contDiff_iff_contDiffAt]
  intro x
  by_cases hx : x = 0
  · subst x
    have hz : Vstar W =ᶠ[𝓝 (0 : ℝ)] (fun _ => (0 : ℂ)) := by
      filter_upwards [isOpen_Iio.mem_nhds ha] with y hy
      have hw : W y = 0 := by
        by_contra hn
        exact (not_le_of_gt hy) (hs hn).1
      simp only [Vstar, hw, mul_zero]
    exact contDiffAt_const.congr_of_eventuallyEq hz
  · exact (Complex.ofRealCLM.contDiff.contDiffAt.comp x
      (Real.contDiffAt_sqrt hx)).mul hW.contDiffAt

def thetaRadialDerivativeScalar : ℂ := (-2 * Real.pi * Complex.I) * star thetaFrequencyScale

def thetaDerivativeScalar : ℂ := thetaRadialDerivativeScalar * rationalSourceThetaScalar

lemma thetaRadialDerivativeScalar_ne_zero : thetaRadialDerivativeScalar ≠ 0 := by
  unfold thetaRadialDerivativeScalar
  exact mul_ne_zero (mul_ne_zero (mul_ne_zero (by norm_num)
    (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero)) Complex.I_ne_zero)
    (star_ne_zero.mpr (norm_pos_iff.mp thetaBesselScale_pos))

lemma thetaDerivativeScalar_ne_zero : thetaDerivativeScalar ≠ 0 :=
  mul_ne_zero thetaRadialDerivativeScalar_ne_zero rationalSourceThetaScalar_ne_zero

lemma sourceBarRadialWeight_eq_div (h : O) (hh : h ≠ 0) :
    (-2 * Real.pi * Complex.I * star (cuspFrequency h)) / (sourceCuspRadialLength h : ℂ) =
      thetaRadialDerivativeScalar / ringComplex h := by
  have hq := ringComplex_ne_zero hh
  have hn : ((‖ringComplex h‖ ^ 2 : ℝ) : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (pow_ne_zero 2 (norm_ne_zero_iff.mpr hq))
  have hnorm : star (ringComplex h) * ringComplex h = ((‖ringComplex h‖ ^ 2 : ℝ) : ℂ) := by
    simpa only [Complex.star_def, Complex.ofReal_pow] using Complex.conj_mul' (ringComplex h)
  rw [sourceCuspRadialLength, if_neg hh, cuspFrequency_eq_thetaFrequencyScale, star_mul]
  apply (div_eq_div_iff hn hq).mpr
  calc
    _ = thetaRadialDerivativeScalar * (star (ringComplex h) * ringComplex h) := by
      unfold thetaRadialDerivativeScalar
      ring
    _ = _ := by rw [hnorm]

/-- The squarefree and cube coefficients, with the angular factor retained. -/
def completedMellinCoefficient (Ψ : O →* ℂ) (p : ThetaPrimaryCubePair) : ℂ :=
  ((‖ringComplex (primaryIdealGenerator p.2.val)‖ : ℂ) *
    normalizedCubicUnitGauss (primaryIdealGenerator p.1.val) *
    Ψ (primaryIdealGenerator p.1.val) * Ψ (primaryIdealGenerator p.2.val) ^ 3) /
      ringComplex (primaryIdealGenerator p.1.val * primaryIdealGenerator p.2.val ^ 3)

def completedMellinLength (p : ThetaPrimaryCubePair) : ℝ :=
  sourceCuspRadialLength (primaryIdealGenerator p.1.val * primaryIdealGenerator p.2.val ^ 3)

def completedT (Ψ : O →* ℂ) (W : ℝ → ℂ) (X : ℝ) : ℂ :=
  ∑' p : ThetaPrimaryCubePair, completedMellinCoefficient Ψ p * Vstar W (completedMellinLength p / X)

lemma thetaSmoothedGaussSum_eq_completedT (Ψ : O →* ℂ) (W : ℝ → ℂ) (X : ℝ) :
    thetaSmoothedGaussSum Ψ (Vstar W) X = thetaRadialDerivativeScalar * completedT Ψ W X := by
  rw [thetaSmoothedGaussSum, completedT, ← tsum_mul_left]
  apply tsum_congr
  intro p
  dsimp only [thetaSmoothedGaussSum, completedMellinCoefficient, completedMellinLength]
  rw [sourceBarRadialWeight_eq_div _ (mul_ne_zero p.1.property.2 (pow_ne_zero 3 p.2.property))]
  ring

/-- Exact cubic reflection of the completed squarefree–cube sum at a finite character. -/
theorem completedT_finite_smoothed_reflection (c : O) (hc : c ≠ 0)
    [Fintype (O ⧸ Ideal.span {9 * c})] (Ψ : (O ⧸ Ideal.span {c}) →* ℂ)
    (W : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support W ⊆ Set.Icc a b) (hW : ContDiff ℝ ∞ W)
    (X : ℝ) (hX : 0 < X) :
    completedT (Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom) W X =
      thetaDerivativeScalar⁻¹ *
        ∑ i, finiteAdditiveFourierCoeff
          (residueTraceQuotientChar 1 (9 * c) (mul_ne_zero (by norm_num) hc)) (finiteThetaTwist c Ψ) i *
          ((finiteTwistCusp (9 * c) (mul_ne_zero (by norm_num) hc) i).smoothingMultiplier *
            ∑' h : O, sourceCuspRadialCoefficient
              (finiteTwistCusp (9 * c) (mul_ne_zero (by norm_num) hc) i).index
              (finiteTwistCusp (9 * c) (mul_ne_zero (by norm_num) hc) i).dualPoint h *
              paperKernel (Vstar W)
                ((finiteTwistCusp (9 * c) (mul_ne_zero (by norm_num) hc) i).smoothingScale X *
                  sourceCuspRadialLength h)) := by
  have he := thetaSmoothedGaussSum_finite_reflection c hc Ψ (Vstar W) a b ha
    (Vstar_support W a b hs) (Vstar_contDiff W a b ha hs hW) X hX
  rw [thetaSmoothedGaussSum_eq_completedT] at he
  apply (mul_left_cancel₀ thetaRadialDerivativeScalar_ne_zero)
  rw [he, thetaDerivativeScalar, mul_inv_rev]
  field_simp [thetaRadialDerivativeScalar_ne_zero]

/-- Moving the Mellin contour gives arbitrarily high polynomial decay. -/
theorem paperKernel_power_bound (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V) (N : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 0 < x → ‖paperKernel V x‖ ≤ C * x ^ (-(N : ℝ)) := by
  obtain ⟨C, hC, hb⟩ := mellinInv_euler_line_bound V a b ha hs hV N 0
  refine ⟨C * paperScale ^ (-(N : ℝ)), mul_pos hC (Real.rpow_pos_of_pos paperScale_pos _), ?_⟩
  intro x hx
  have hN : (N : ℝ) ∈ Set.Icc (-(1 / 4 : ℝ)) (N : ℝ) :=
    ⟨by linarith [Nat.cast_nonneg (α := ℝ) N], le_rfl⟩
  have he := mellinInv_euler_shift V a b ha hs hV N 0 (N : ℝ) hN
    (paperScale * x) (mul_pos paperScale_pos hx)
  have hl : mellinInv 0 (mellinEulerData V 0) (paperScale * x) = paperKernel V x := by
    have hf : mellinEulerData V 0 = (fun s : ℂ => mellin V (-s) * cubicReflectionGamma s) := by
      funext s
      simp only [mellinEulerData, pow_zero, one_mul, mellinData]
    rw [hf]
    rfl
  rw [hl] at he
  rw [he]
  simpa only [Real.mul_rpow paperScale_pos.le hx.le, mul_assoc] using
    hb (N : ℝ) hN (paperScale * x) (mul_pos paperScale_pos hx)

/-- Absolute radial mass is independent of the horizontal cusp coordinate. -/
def sourceCuspRadialMass (j : Fin 3) : ℝ :=
  ∑' h : O, ‖sourceCuspRadialCoefficient j 0 h‖ * sourceCuspRadialLength h ^ (-(3 / 2 : ℝ))

lemma sourceCuspRadialMass_nonneg (j : Fin 3) : 0 ≤ sourceCuspRadialMass j :=
  tsum_nonneg (fun h => mul_nonneg (norm_nonneg _) (Real.rpow_nonneg (sourceCuspRadialLength_pos h).le _))

theorem sourceCuspRadialMass_sum (j : Fin 3) (z : ℂ) :
    (∑' h : O, ‖sourceCuspRadialCoefficient j z h‖ * sourceCuspRadialLength h ^ (-(3 / 2 : ℝ))) =
      sourceCuspRadialMass j := by
  unfold sourceCuspRadialMass
  simp only [sourceCuspRadialCoefficient_norm]

/-- All three reflected series have the same polynomial bound in their radial scale. -/
theorem sourceCusp_kernel_uniform_bound (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (N : ℕ) (hN : 2 ≤ N) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : Fin 3) (z : ℂ) (c : ℝ), 0 < c →
      ‖∑' h : O, sourceCuspRadialCoefficient j z h * paperKernel V (c * sourceCuspRadialLength h)‖ ≤
        C * c ^ (-(N : ℝ)) := by
  obtain ⟨B, hB, hb⟩ := paperKernel_power_bound V a b ha hs hV N
  let S : ℝ := ∑ j : Fin 3, sourceCuspRadialMass j
  have hS : 0 ≤ S := Finset.sum_nonneg (fun j _ => sourceCuspRadialMass_nonneg j)
  refine ⟨B * (S + 1), mul_pos hB (by linarith), ?_⟩
  intro j z c hc
  have hm : Summable (fun h : O => ‖sourceCuspRadialCoefficient j z h‖ *
      sourceCuspRadialLength h ^ (-(3 / 2 : ℝ))) := by
    simpa only [neg_div] using sourceCuspRadialCoefficient_weighted_summable j z
  have hi := paperKernel_weighted_norm_summable sourceCuspRadialLength sourceCuspRadialLength_pos
    (sourceCuspRadialCoefficient j z) hm V a b ha hs hV c hc
  have hp : ∀ h : O, sourceCuspRadialLength h ^ (-(N : ℝ)) ≤
      sourceCuspRadialLength h ^ (-(3 / 2 : ℝ)) := by
    intro h
    apply Real.rpow_le_rpow_of_exponent_le (sourceCuspRadialLength_one_le h)
    have hn : (2 : ℝ) ≤ N := by exact_mod_cast hN
    linarith
  calc
    _ ≤ ∑' h : O, ‖sourceCuspRadialCoefficient j z h * paperKernel V (c * sourceCuspRadialLength h)‖ :=
      norm_tsum_le_tsum_norm hi
    _ ≤ ∑' h : O, (B * c ^ (-(N : ℝ))) *
        (‖sourceCuspRadialCoefficient j z h‖ * sourceCuspRadialLength h ^ (-(3 / 2 : ℝ))) := by
      apply Summable.tsum_le_tsum _ hi (hm.mul_left _)
      intro h
      rw [norm_mul]
      calc
        _ ≤ ‖sourceCuspRadialCoefficient j z h‖ * (B * (c * sourceCuspRadialLength h) ^ (-(N : ℝ))) :=
          mul_le_mul_of_nonneg_left (hb _ (mul_pos hc (sourceCuspRadialLength_pos h))) (norm_nonneg _)
        _ = (B * c ^ (-(N : ℝ))) *
            (‖sourceCuspRadialCoefficient j z h‖ * sourceCuspRadialLength h ^ (-(N : ℝ))) := by
          rw [Real.mul_rpow hc.le (sourceCuspRadialLength_pos h).le]
          ring
        _ ≤ _ := mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_left (hp h) (norm_nonneg _)) (by positivity)
    _ = (B * c ^ (-(N : ℝ))) * sourceCuspRadialMass j := by
      rw [tsum_mul_left, sourceCuspRadialMass_sum]
    _ ≤ (B * c ^ (-(N : ℝ))) * (S + 1) := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      have hj : sourceCuspRadialMass j ≤ S :=
        Finset.single_le_sum (fun k _ => sourceCuspRadialMass_nonneg k) (Finset.mem_univ j)
      linarith
    _ = _ := by ring

theorem sourceBar_smoothed_uniform_bound (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (N : ℕ) (hN : 2 ≤ N) :
    ∃ C : ℝ, 0 < C ∧ ∀ (d : SourceCuspDatum) (X : ℝ), 0 < X →
      ‖∑' h : O, sourceBarRadialCoefficient d.point h * V (sourceCuspRadialLength h / X)‖ ≤
        C * d.smoothingScale X ^ (-(N : ℝ)) := by
  obtain ⟨C, hC, hb⟩ := sourceCusp_kernel_uniform_bound V a b ha hs hV N hN
  refine ⟨9 * C, by positivity, ?_⟩
  intro d X hX
  rw [d.smoothed_reflection V a b ha hs hV X hX, norm_mul]
  calc
    _ ≤ 9 * (C * d.smoothingScale X ^ (-(N : ℝ))) :=
      mul_le_mul d.smoothingMultiplier_norm_le
        (hb d.index d.dualPoint (d.smoothingScale X) (d.smoothingScale_pos X hX))
        (norm_nonneg _) (by norm_num)
    _ = _ := by ring

/-- An integral primitive cusp column divides every denominator representing its point. -/
lemma SourceCuspDatum.heightScale_le_of_point (d : SourceCuspDatum) (a c : O) (hc : c ≠ 0)
    (hp : d.point = ringComplex a / ringComplex c) : d.heightScale ≤ ‖ringComplex c‖ ^ 2 := by
  let M : SL(2, O) := (d.gamma : SL(2, O)) * cuspRepresentative d.index
  have hM : integralComplexMatrix M = d.matrix := by
    dsimp only [M, SourceCuspDatum.matrix]
    exact map_mul integralComplexMatrix _ _
  have he (i j : Fin 2) : ringComplex (M i j) = d.matrix i j := by
    exact congrArg (fun A : SL(2, ℂ) => A i j) hM
  have hp' : M 0 0 * c = a * M 1 0 := by
    apply ringComplex_injective
    have hpC : d.matrix 0 0 * ringComplex c = ringComplex a * d.matrix 1 0 :=
      (div_eq_div_iff (show d.matrix 1 0 ≠ 0 from d.lower_ne_zero)
        (ringComplex_ne_zero hc)).mp hp
    simpa only [map_mul, he] using hpC
  have hd : M 0 0 * M 1 1 - M 0 1 * M 1 0 = 1 := by
    simpa only [Matrix.det_fin_two] using M.property
  let k : O := a * M 1 1 - M 0 1 * c
  have hk : M 1 0 * k = c := by
    calc
      _ = (a * M 1 0) * M 1 1 - M 0 1 * M 1 0 * c := by dsimp [k]; ring
      _ = (M 0 0 * M 1 1 - M 0 1 * M 1 0) * c := by rw [← hp']; ring
      _ = c := by rw [hd, one_mul]
  have hk0 : k ≠ 0 := by
    intro hz
    rw [hz, mul_zero] at hk
    exact hc hk.symm
  have hk1 : 1 ≤ ‖ringComplex k‖ ^ 2 := by
    simpa only [Complex.normSq_eq_norm_sq] using one_le_normSq_embedding k hk0
  have hn : ‖ringComplex c‖ ^ 2 = ‖d.matrix 1 0‖ ^ 2 * ‖ringComplex k‖ ^ 2 := by
    rw [← hk, map_mul, norm_mul, mul_pow, he]
  change ‖d.matrix 1 0‖ ^ 2 ≤ _
  rw [hn]
  exact le_mul_of_one_le_right (sq_nonneg _) hk1

lemma finiteTwistCusp_heightScale_le (c : O) (hc : c ≠ 0) (h : O ⧸ Ideal.span {c}) :
    (finiteTwistCusp c hc h).heightScale ≤ ‖ringComplex c‖ ^ 2 := by
  apply SourceCuspDatum.heightScale_le_of_point _ (-3 * Quotient.out h) c hc
  exact rationalSourceCusp_point _ _ hc

lemma finiteThetaTwist_norm_le_one (c : O) (Ψ : (O ⧸ Ideal.span {c}) →* ℂ)
    (hΨ : ∀ x, ‖Ψ x‖ ≤ 1) (x : O ⧸ Ideal.span {9 * c}) : ‖finiteThetaTwist c Ψ x‖ ≤ 1 := by
  rw [finiteThetaTwist, fixedThetaTwist_norm]
  split_ifs
  · exact hΨ _
  · norm_num

lemma finiteAdditiveFourierCoeff_norm_le_one {R : Type*} [CommRing R] [Fintype R]
    (ψ : AddChar R ℂ) (φ : R → ℂ) (hφ : ∀ x, ‖φ x‖ ≤ 1) (h : R) :
    ‖finiteAdditiveFourierCoeff ψ φ h‖ ≤ 1 := by
  apply (finiteAdditiveFourierCoeff_norm_le ψ φ h).trans
  have hcard : (0 : ℝ) < Fintype.card R := by exact_mod_cast Fintype.card_pos
  apply (div_le_iff₀ hcard).mpr
  simpa only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one, one_mul] using
    Finset.sum_le_sum (fun x (_ : x ∈ Finset.univ) => hφ x)

/-- Uniform finite-character reflection bound, with every cusp scale explicit. -/
theorem completedT_finite_reflection_bound (W : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support W ⊆ Set.Icc a b) (hW : ContDiff ℝ ∞ W)
    (N : ℕ) (hN : 2 ≤ N) :
    ∃ C : ℝ, 0 < C ∧ ∀ (c : O) (hc : c ≠ 0)
      [Fintype (O ⧸ Ideal.span {9 * c})] (Ψ : (O ⧸ Ideal.span {c}) →* ℂ),
      (∀ x, ‖Ψ x‖ ≤ 1) → ∀ X : ℝ, 0 < X →
      ‖completedT (Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom) W X‖ ≤
        C * ∑ i : O ⧸ Ideal.span {9 * c},
          (finiteTwistCusp (9 * c) (mul_ne_zero (by norm_num) hc) i).smoothingScale X ^ (-(N : ℝ)) := by
  obtain ⟨B, hB, hb⟩ := sourceCusp_kernel_uniform_bound (Vstar W) a b ha
    (Vstar_support W a b hs) (Vstar_contDiff W a b ha hs hW) N hN
  refine ⟨‖thetaDerivativeScalar⁻¹‖ * (9 * B),
    mul_pos (norm_pos_iff.mpr (inv_ne_zero thetaDerivativeScalar_ne_zero)) (by positivity), ?_⟩
  intro c hc _ Ψ hΨ X hX
  rw [completedT_finite_smoothed_reflection c hc Ψ W a b ha hs hW X hX, norm_mul]
  calc
    _ ≤ ‖thetaDerivativeScalar⁻¹‖ * ∑ i, ‖finiteAdditiveFourierCoeff
        (residueTraceQuotientChar 1 (9 * c) (mul_ne_zero (by norm_num) hc)) (finiteThetaTwist c Ψ) i *
        ((finiteTwistCusp (9 * c) (mul_ne_zero (by norm_num) hc) i).smoothingMultiplier *
          ∑' h : O, sourceCuspRadialCoefficient
            (finiteTwistCusp (9 * c) (mul_ne_zero (by norm_num) hc) i).index
            (finiteTwistCusp (9 * c) (mul_ne_zero (by norm_num) hc) i).dualPoint h *
            paperKernel (Vstar W)
              ((finiteTwistCusp (9 * c) (mul_ne_zero (by norm_num) hc) i).smoothingScale X *
                sourceCuspRadialLength h))‖ :=
      mul_le_mul_of_nonneg_left (norm_sum_le _ _) (norm_nonneg _)
    _ ≤ ‖thetaDerivativeScalar⁻¹‖ * ∑ i : O ⧸ Ideal.span {9 * c},
        (9 * B) * (finiteTwistCusp (9 * c) (mul_ne_zero (by norm_num) hc) i).smoothingScale X ^ (-(N : ℝ)) := by
      apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
      apply Finset.sum_le_sum
      intro i hi
      let d := finiteTwistCusp (9 * c) (mul_ne_zero (by norm_num) hc) i
      rw [norm_mul, norm_mul]
      have hf := finiteAdditiveFourierCoeff_norm_le_one
        (residueTraceQuotientChar 1 (9 * c) (mul_ne_zero (by norm_num) hc))
        (finiteThetaTwist c Ψ) (finiteThetaTwist_norm_le_one c Ψ hΨ) i
      calc
        _ ≤ 1 * (9 * (B * d.smoothingScale X ^ (-(N : ℝ)))) :=
          mul_le_mul hf (mul_le_mul d.smoothingMultiplier_norm_le
            (hb d.index d.dualPoint (d.smoothingScale X) (d.smoothingScale_pos X hX))
            (norm_nonneg _) (by norm_num)) (by positivity) (by norm_num)
        _ = _ := by ring
    _ = _ := by rw [← Finset.mul_sum]; ring

/-- The smallest of the three cusp scales, before division by the cusp denominator. -/
def sourceReflectionScale : ℝ := 3 * thetaBesselScale ^ 4

lemma sourceReflectionScale_pos : 0 < sourceReflectionScale :=
  mul_pos (by norm_num) (pow_pos thetaBesselScale_pos 4)

lemma SourceCuspDatum.smoothingScale_lower (d : SourceCuspDatum) (a c : O) (hc : c ≠ 0)
    (hp : d.point = ringComplex a / ringComplex c) (X : ℝ) (hX : 0 < X) :
    sourceReflectionScale * X / ‖ringComplex c‖ ^ 4 ≤ d.smoothingScale X := by
  have hQ := d.heightScale_le_of_point a c hc hp
  have hQ2 : d.heightScale ^ 2 ≤ ‖ringComplex c‖ ^ 4 := by
    have hp := mul_nonneg (sub_nonneg.mpr hQ)
      (add_nonneg (sq_nonneg ‖ringComplex c‖) d.heightScale_pos.le)
    nlinarith only [hp]
  have hj : sourceReflectionScale ≤
      27 * sourceCuspRadialScale 0 ^ 2 * sourceCuspRadialScale d.index ^ 2 := by
    rcases d with ⟨G, j, hj⟩
    fin_cases j <;> dsimp [sourceReflectionScale, sourceCuspRadialScale, sourceCuspScale] <;>
      nlinarith only [sq_nonneg (thetaBesselScale ^ 2)]
  apply (div_le_iff₀ (pow_pos (norm_pos_iff.mpr (ringComplex_ne_zero hc)) 4)).mpr
  calc
    _ ≤ (27 * sourceCuspRadialScale 0 ^ 2 * sourceCuspRadialScale d.index ^ 2) * X :=
      mul_le_mul_of_nonneg_right hj hX.le
    _ = d.smoothingScale X * d.heightScale ^ 2 := by
      rw [SourceCuspDatum.smoothingScale, div_mul_cancel₀ _ (pow_ne_zero 2 d.heightScale_pos.ne')]
    _ ≤ _ := mul_le_mul_of_nonneg_left hQ2 (d.smoothingScale_pos X hX).le

/-- The reflected Gauss sum decays uniformly once the smoothing scale exceeds the fourth power of the conductor. -/
theorem completedT_conductor_bound (W : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support W ⊆ Set.Icc a b) (hW : ContDiff ℝ ∞ W)
    (N : ℕ) (hN : 2 ≤ N) :
    ∃ C : ℝ, 0 < C ∧ ∀ (c : O) (hc : c ≠ 0)
      [Fintype (O ⧸ Ideal.span {9 * c})] (Ψ : (O ⧸ Ideal.span {c}) →* ℂ),
      (∀ x, ‖Ψ x‖ ≤ 1) → ∀ X : ℝ, 0 < X →
      ‖completedT (Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom) W X‖ ≤
        C * (Fintype.card (O ⧸ Ideal.span {9 * c}) : ℝ) *
          (sourceReflectionScale * X / ‖ringComplex (9 * c)‖ ^ 4) ^ (-(N : ℝ)) := by
  obtain ⟨C, hC, hb⟩ := completedT_finite_reflection_bound W a b ha hs hW N hN
  refine ⟨C, hC, ?_⟩
  intro c hc _ Ψ hΨ X hX
  apply (hb c hc Ψ hΨ X hX).trans
  rw [mul_assoc]
  apply mul_le_mul_of_nonneg_left _ hC.le
  calc
    _ ≤ ∑ i : O ⧸ Ideal.span {9 * c},
        (sourceReflectionScale * X / ‖ringComplex (9 * c)‖ ^ 4) ^ (-(N : ℝ)) := by
      apply Finset.sum_le_sum
      intro i hi
      have hc9 : 9 * c ≠ 0 := mul_ne_zero (by norm_num) hc
      apply Real.rpow_le_rpow_of_nonpos
        (div_pos (mul_pos sourceReflectionScale_pos hX)
          (pow_pos (norm_pos_iff.mpr (ringComplex_ne_zero hc9)) 4))
      · exact (finiteTwistCusp (9 * c) hc9 i).smoothingScale_lower
          (-3 * Quotient.out i) (9 * c) hc9 (rationalSourceCusp_point _ _ hc9) X hX
      · exact neg_nonpos.mpr (Nat.cast_nonneg N)
    _ = _ := by rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]

lemma unramifiedResidualCoefficient_prime_normalized (p : O) (hp : Prime p)
    (hprimary : lambda ^ 2 ∣ p - 1) (h : O) (hph : ¬ p ∣ h) :
    unramifiedResidualCoefficient (h * p) = ringComplex (symbol h p) *
      star (normalizedCubicUnitGauss p) * unramifiedResidualCoefficient h := by
  have hp1 : ¬ p ∣ (1 : O) := fun hd => hp.2.1 (isUnit_of_dvd_one hd)
  rw [unramifiedResidualCoefficient_prime_factor p hp hprimary h hph,
    primeCubicGauss_two_twist p hp hprimary h hph, primeCubicGauss_two_eq_star p hp hprimary 1 hp1,
    normalizedCubicUnitGauss, star_div₀, Complex.star_def, Complex.conj_ofReal]
  ring

/-- The normalized unramified coefficient retains the cubic symbol of its base frequency. -/
theorem unramifiedResidualCoefficient_prime_product {ι : Type*}
    (s : Finset ι) (p : ι → O) (hp : ∀ i ∈ s, Prime (p i))
    (hprimary : ∀ i ∈ s, lambda ^ 2 ∣ p i - 1)
    (hpair : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → IsCoprime (p i) (p j))
    (h : O) (hph : ∀ i ∈ s, ¬ p i ∣ h) :
    unramifiedResidualCoefficient (h * (∏ i ∈ s, p i)) =
      ringComplex (symbol h (∏ i ∈ s, p i)) * star (normalizedCubicUnitGauss (∏ i ∈ s, p i)) *
        unramifiedResidualCoefficient h := by
  induction s using Finset.induction_on with
  | empty => simp only [Finset.prod_empty, mul_one, symbol_one, map_one, normalizedCubicUnitGauss_one, star_one, one_mul]
  | @insert i s hi ih =>
    have hpi := hp i (Finset.mem_insert_self _ _)
    have hpri := hprimary i (Finset.mem_insert_self _ _)
    have hps : ∀ j ∈ s, Prime (p j) := fun j hj => hp j (Finset.mem_insert_of_mem hj)
    have hprs : ∀ j ∈ s, lambda ^ 2 ∣ p j - 1 := fun j hj => hprimary j (Finset.mem_insert_of_mem hj)
    have hcpi : IsCoprime (p i) (∏ j ∈ s, p j) := IsCoprime.prod_right (fun j hj =>
      hpair i (Finset.mem_insert_self _ _) j (Finset.mem_insert_of_mem hj) (by intro he; subst j; exact hi hj))
    have hbs : (∏ j ∈ s, p j) ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun j hj => (hps j hj).ne_zero)
    have hpb : ¬ p i ∣ h * (∏ j ∈ s, p j) := by
      intro hd
      rcases hpi.dvd_mul.mp hd with hd | hd
      · exact hph i (Finset.mem_insert_self _ _) hd
      · exact hpi.2.1 (hcpi.isUnit_of_dvd hd)
    have hih := ih hps hprs
      (fun j hj k hk hjk => hpair j (Finset.mem_insert_of_mem hj) k (Finset.mem_insert_of_mem hk) hjk)
      (fun j hj => hph j (Finset.mem_insert_of_mem hj))
    rw [Finset.prod_insert hi, show h * (p i * (∏ j ∈ s, p j)) = (h * (∏ j ∈ s, p j)) * p i by ring,
      unramifiedResidualCoefficient_prime_normalized (p i) hpi hpri _ hpb, hih]
    rw [mul_comm (p i) (∏ j ∈ s, p j), normalizedCubicUnitGauss_coprime_product _ _ hbs hpi.ne_zero
      (primary_finset_product s p hprs) hpri hcpi.symm, symbol_mul_denominator, map_mul,
      symbol_mul_numerator, map_mul]
    ring

lemma ramified_primaryPrime_not_dvd (I : Ideal O) (hI : primaryIdealGenerator I ≠ 0)
    (u : Oˣ) (m : ℕ) (P : Ideal O) (hP : P ∈ primeSupport I) :
    ¬ primaryIdealPrime P ∣ (u : O) * lambda ^ m := by
  have hp := primaryIdealPrime_isPrime_of_mem I P hI hP
  have hpp := (primaryIdealPrime_spec P
    (primaryIdealPrime_factor_ne_zero I P hI (Multiset.mem_toFinset.mp hP))).2.2.2
  intro hd
  exact hp.2.1 ((ramified_primary_coprime u m _ hpp).of_mul_left_right.symm.isUnit_of_dvd hd)

/-- Exact squarefree–cube factorization, including the ramified cubic-symbol phase. -/
theorem rationalSourceResidualFourierCoefficient_full_squarefree_cube (I J : Ideal O)
    (hI : primaryIdealGenerator I ≠ 0) (hJ : primaryIdealGenerator J ≠ 0) (hsq : Squarefree I)
    (u : Oˣ) (m : ℕ) :
    rationalSourceResidualFourierCoefficient
      (((u : O) * lambda ^ m) * primaryIdealGenerator I * primaryIdealGenerator J ^ 3) =
      (‖ringComplex (primaryIdealGenerator J)‖ : ℂ) *
        ringComplex (symbol (9 * ((u : O) * lambda ^ m)) (primaryIdealGenerator I)) *
        star (normalizedCubicUnitGauss (primaryIdealGenerator I)) *
        rationalSourceResidualFourierCoefficient ((u : O) * lambda ^ m) := by
  have he := rationalSourceResidualFourierCoefficient_prime_product (primeSupport I) primaryIdealPrime
    (fun P hP => primaryIdealPrime_isPrime_of_mem I P hI hP)
    (fun P hP => (primaryIdealPrime_spec P
      (primaryIdealPrime_factor_ne_zero I P hI (Multiset.mem_toFinset.mp hP))).2.2.2)
    (primaryIdealPrime_support_coprime I hI) ((u : O) * lambda ^ m)
    (ramified_primaryPrime_not_dvd I hI u m)
  rw [← primaryIdealGenerator_squarefree_support I hI hsq] at he
  rw [rationalSourceResidualFourierCoefficient_primary_cube _ hJ (primaryIdealGenerator_spec J hJ).2 _
    (mul_ne_zero (ramifiedElement_ne_zero u m) hI), he]
  ring

/-- Exact unramified-residue factorization with the base-frequency symbol. -/
theorem unramifiedResidualCoefficient_full_squarefree_cube (I J : Ideal O)
    (hI : primaryIdealGenerator I ≠ 0) (hJ : primaryIdealGenerator J ≠ 0) (hsq : Squarefree I)
    (u : Oˣ) (m : ℕ) :
    unramifiedResidualCoefficient
      (((u : O) * lambda ^ m) * primaryIdealGenerator I * primaryIdealGenerator J ^ 3) =
      (‖ringComplex (primaryIdealGenerator J)‖ : ℂ) *
        ringComplex (symbol ((u : O) * lambda ^ m) (primaryIdealGenerator I)) *
        star (normalizedCubicUnitGauss (primaryIdealGenerator I)) *
        unramifiedResidualCoefficient ((u : O) * lambda ^ m) := by
  have he := unramifiedResidualCoefficient_prime_product (primeSupport I) primaryIdealPrime
    (fun P hP => primaryIdealPrime_isPrime_of_mem I P hI hP)
    (fun P hP => (primaryIdealPrime_spec P
      (primaryIdealPrime_factor_ne_zero I P hI (Multiset.mem_toFinset.mp hP))).2.2.2)
    (primaryIdealPrime_support_coprime I hI) ((u : O) * lambda ^ m)
    (ramified_primaryPrime_not_dvd I hI u m)
  rw [← primaryIdealGenerator_squarefree_support I hI hsq] at he
  rw [unramifiedResidualCoefficient_primary_cube _ hJ (primaryIdealGenerator_spec J hJ).2, he]
  ring

/-- Bessel normalization removes the ramified frequency multiplier before squarefree–cube factorization. -/
theorem normalizedRamifiedGaussTerm_full_squarefree_cube (v : Oˣ) (n : ℕ)
    (I J : Ideal O) (hI : primaryIdealGenerator I ≠ 0) (hJ : primaryIdealGenerator J ≠ 0)
    (hsq : Squarefree I) (u : Oˣ) (m : ℕ) :
    sourceBesselNormalizer (((u : O) * lambda ^ m) * primaryIdealGenerator I * primaryIdealGenerator J ^ 3) *
      unramifiedGaussResidue (((v : O) * lambda ^ n) *
        (((u : O) * lambda ^ m) * primaryIdealGenerator I * primaryIdealGenerator J ^ 3)) =
      ((‖ringComplex (primaryIdealGenerator J)‖ : ℂ) *
        ringComplex (symbol (((v * u : Oˣ) : O) * lambda ^ (n + m)) (primaryIdealGenerator I)) *
        star (normalizedCubicUnitGauss (primaryIdealGenerator I)) *
        unramifiedResidualCoefficient (((v * u : Oˣ) : O) * lambda ^ (n + m))) /
          (‖ringComplex ((v : O) * lambda ^ n)‖ : ℂ) ^ (1 / 3 : ℂ) := by
  let a : O := (v : O) * lambda ^ n
  let h : O := ((u : O) * lambda ^ m) * primaryIdealGenerator I * primaryIdealGenerator J ^ 3
  have ha : a ≠ 0 := ramifiedElement_ne_zero v n
  have ha0 : (‖ringComplex a‖ : ℂ) ^ (1 / 3 : ℂ) ≠ 0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (Complex.ofReal_ne_zero.mpr
      (norm_ne_zero_iff.mpr (ringComplex_ne_zero ha))))
  have he : a * h = (((v * u : Oˣ) : O) * lambda ^ (n + m)) *
      primaryIdealGenerator I * primaryIdealGenerator J ^ 3 := by
    simp only [a, h, Units.val_mul, pow_add]
    ring
  have hn : sourceBesselNormalizer h * unramifiedGaussResidue (a * h) *
      (‖ringComplex a‖ : ℂ) ^ (1 / 3 : ℂ) = unramifiedResidualCoefficient (a * h) := by
    rw [unramifiedResidualCoefficient, mul_comm a h, sourceBesselNormalizer_mul h a]
    ring
  apply (eq_div_iff ha0).mpr
  change sourceBesselNormalizer h * unramifiedGaussResidue (a * h) *
    (‖ringComplex a‖ : ℂ) ^ (1 / 3 : ℂ) = _
  rw [hn, he, unramifiedResidualCoefficient_full_squarefree_cube I J hI hJ hsq]
/-- Each ramified cusp is a finite sum of explicit squarefree Gauss branches. -/
theorem ramifiedResidualFourierCoefficient_full_squarefree_cube (v t : Oˣ)
    (I J : Ideal O) (hI : primaryIdealGenerator I ≠ 0) (hJ : primaryIdealGenerator J ≠ 0)
    (hsq : Squarefree I) (u : Oˣ) (m : ℕ) :
    let h := ((u : O) * lambda ^ m) * primaryIdealGenerator I * primaryIdealGenerator J ^ 3
    ramifiedResidualFourierCoefficient v t h =
      ((3 : ℂ) ^ (4 / 3 : ℂ) / ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ)) *
        ∑ i : RamifiedSixBranch, ramifiedSixWeight v t h i (4 / 3) *
          (((‖ringComplex (primaryIdealGenerator J)‖ : ℂ) *
            ringComplex (symbol (((ramifiedSixUnit v t i * u : Oˣ) : O) *
              lambda ^ (ramifiedSixPower i + m)) (primaryIdealGenerator I)) *
            star (normalizedCubicUnitGauss (primaryIdealGenerator I)) *
            unramifiedResidualCoefficient (((ramifiedSixUnit v t i * u : Oˣ) : O) *
              lambda ^ (ramifiedSixPower i + m))) /
                (‖ringComplex ((ramifiedSixUnit v t i : O) * lambda ^ ramifiedSixPower i)‖ : ℂ) ^ (1 / 3 : ℂ)) := by
  dsimp only
  let h := ((u : O) * lambda ^ m) * primaryIdealGenerator I * primaryIdealGenerator J ^ 3
  have he : ramifiedResidualFourierCoefficient v t h =
      ((3 : ℂ) ^ (4 / 3 : ℂ) / ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ)) *
        (sourceBesselNormalizer h * ramifiedArithmeticResidue v t h) := by
    unfold ramifiedResidualFourierCoefficient sourceBesselNormalizer
    ring
  change ramifiedResidualFourierCoefficient v t h = _
  rw [he]
  congr 1
  rw [ramifiedArithmeticResidue, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  by_cases hw : ramifiedSixWeight v t h i (4 / 3) = 0
  · rw [hw, zero_mul, mul_zero, zero_mul]
  rw [ramifiedSixIndex_multiplier v t h i hw]
  calc
    _ = ramifiedSixWeight v t h i (4 / 3) *
        (sourceBesselNormalizer h * unramifiedGaussResidue
          (((ramifiedSixUnit v t i : O) * lambda ^ ramifiedSixPower i) * h)) := by ring
    _ = _ := by
      rw [normalizedRamifiedGaussTerm_full_squarefree_cube (ramifiedSixUnit v t i)
        (ramifiedSixPower i) I J hI hJ hsq u m]

lemma sourceCuspCoefficient_full_squarefree_cube_support (j : Fin 3) (h : O)
    (hh : h ≠ 0) (hc : sourceCuspCoefficient j h ≠ 0) :
    ∃ p : ThetaFullIndex, thetaFullFrequency p = h := by
  have hs : ∃ (u : Oˣ) (m : ℕ) (I J : Ideal O), Squarefree I ∧
      primaryIdealGenerator I ≠ 0 ∧ primaryIdealGenerator J ≠ 0 ∧
      h = ((u : O) * lambda ^ m) * primaryIdealGenerator I * primaryIdealGenerator J ^ 3 := by
    fin_cases j
    · exact rationalSourceResidualFourierCoefficient_full_squarefree_cube_support h hh hc
    · exact ramifiedBesselCoefficient_full_squarefree_cube_support false h hh hc
    · exact ramifiedBesselCoefficient_full_squarefree_cube_support true h hh hc
  obtain ⟨u, m, I, J, hs, hI, hJ, he⟩ := hs
  exact ⟨(u, m, (⟨I, hs, hI⟩, ⟨J, hJ⟩)), he.symm⟩

/-- Every reflected radial series is indexed exactly by unit, ramified, squarefree, and cube factors. -/
theorem sourceCuspRadial_tsum_full_index (j : Fin 3) (z : ℂ) (W : O → ℂ) :
    (∑' h : O, sourceCuspRadialCoefficient j z h * W h) =
      ∑' p : ThetaFullIndex, sourceCuspRadialCoefficient j z (thetaFullFrequency p) * W (thetaFullFrequency p) := by
  let f : O → ℂ := fun h => sourceCuspRadialCoefficient j z h * W h
  change (∑' h : O, f h) = ∑' p : ThetaFullIndex, f (thetaFullFrequency p)
  apply tsum_eq_tsum_of_ne_zero_bij
    (fun p : Function.support (fun p : ThetaFullIndex => f (thetaFullFrequency p)) => thetaFullFrequency p.val)
  · exact thetaFullFrequency_injective.comp Subtype.val_injective
  · intro h hh
    have hh0 : h ≠ 0 := by
      intro hz
      exact hh (by simp only [f, hz, sourceCuspRadialCoefficient_zero, zero_mul])
    have hf : sourceCuspCoefficient j h ≠ 0 := by
      intro hz
      exact hh (by simp only [f, sourceCuspRadialCoefficient, sourceCuspRadialBaseCoefficient,
        hz, star_zero, mul_zero, zero_div, zero_mul])
    obtain ⟨p, hp⟩ := sourceCuspCoefficient_full_squarefree_cube_support j h hh0 hf
    exact ⟨⟨p, by change f (thetaFullFrequency p) ≠ 0; rwa [hp]⟩, hp⟩
  · intro p
    rfl

lemma thetaFullFrequency_radialLength (p : ThetaFullIndex) :
    sourceCuspRadialLength (thetaFullFrequency p) =
      ‖ringComplex lambda‖ ^ (2 * p.2.1) * completedMellinLength p.2.2 := by
  have hp : primaryIdealGenerator p.2.2.1.val * primaryIdealGenerator p.2.2.2.val ^ 3 ≠ 0 :=
    mul_ne_zero p.2.2.1.property.2 (pow_ne_zero 3 p.2.2.2.property)
  rw [sourceCuspRadialLength, if_neg (thetaFullFrequency_ne_zero p), completedMellinLength,
    sourceCuspRadialLength, if_neg hp]
  simp only [thetaFullFrequency, map_mul, map_pow, norm_mul, norm_pow, norm_ringComplex_unit, one_mul]
  rw [mul_pow, mul_pow, ← pow_mul, Nat.mul_comm p.2.1 2]
  ring

/-- Full-frequency reflection keeps the arithmetic squarefree–cube indexing on every cusp. -/
theorem SourceCuspDatum.smoothed_reflection_full_index (d : SourceCuspDatum)
    (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (X : ℝ) (hX : 0 < X) :
    (∑' h : O, sourceBarRadialCoefficient d.point h * V (sourceCuspRadialLength h / X)) =
      d.smoothingMultiplier * ∑' p : ThetaFullIndex,
        sourceCuspRadialCoefficient d.index d.dualPoint (thetaFullFrequency p) *
          paperKernel V (d.smoothingScale X *
            (‖ringComplex lambda‖ ^ (2 * p.2.1) * completedMellinLength p.2.2)) := by
  rw [d.smoothed_reflection V a b ha hs hV X hX,
    sourceCuspRadial_tsum_full_index d.index d.dualPoint
      (fun h => paperKernel V (d.smoothingScale X * sourceCuspRadialLength h))]
  simp only [thetaFullFrequency_radialLength]

/-- The affine local Gauss weight depends only on the frequency modulo `9q`. -/
lemma scaledAffineGaussWeight_congr (q : O) (hq : q ≠ 0) (u : Oˣ) (n : ℕ)
    (h k : O) (hmod : 9 * q ∣ h - k) (s : ℂ) :
    scaledAffineGaussWeight q u n h s = scaledAffineGaussWeight q u n k s := by
  obtain ⟨r, hr⟩ := hmod
  have hdiff : h = k + q * (9 * r) := by linear_combination hr
  have hdq : q ∣ h - k := ⟨9 * r, by linear_combination hr⟩
  have hdiv : q ∣ h ↔ q ∣ k := by
    constructor
    · intro hh
      convert dvd_sub hh hdq using 1 <;> ring
    · intro hk
      convert dvd_add hk hdq using 1 <;> ring
  by_cases hh : q ∣ h
  · have hk := hdiv.mp hh
    have he : Classical.choose hh = Classical.choose hk + 9 * r := by
      apply mul_left_cancel₀ hq
      rw [← Classical.choose_spec hh, mul_add, ← Classical.choose_spec hk]
      exact hdiff
    have heq : (3 : O) ∣ Classical.choose hh + ramifiedArithmeticPhase u n ↔
        (3 : O) ∣ Classical.choose hk + ramifiedArithmeticPhase u n := by
      rw [he]
      have hd : (3 : O) ∣ 9 * r := ⟨3 * r, by ring⟩
      constructor
      · intro ht
        convert dvd_sub ht hd using 1 <;> ring
      · intro ht
        convert dvd_add ht hd using 1 <;> ring
    have hphase : tracePhase (cuspFrequency h / ringComplex (3 * q)) =
        tracePhase (cuspFrequency k / ringComplex (3 * q)) := by
      have he' : cuspFrequency h / ringComplex (3 * q) =
          cuspFrequency k / ringComplex (3 * q) + cuspFrequency r * 3 := by
        rw [hdiff]
        simp only [cuspFrequency, map_add, map_mul, map_ofNat]
        field_simp [ringComplex_ne_zero hq, ringComplex_ne_zero traceLambda_ne_zero]
        ring
      rw [he', AddChar.map_add_eq_mul]
      have hp : tracePhase (cuspFrequency r * 3) = 1 := by
        simpa only [map_one, mul_one] using cuspFrequency_period r 1
      rw [hp, mul_one]
    rw [scaledAffineGaussWeight, dif_pos hh, scaledAffineGaussWeight, dif_pos hk]
    by_cases ht : (3 : O) ∣ Classical.choose hh + ramifiedArithmeticPhase u n
    · rw [if_pos ht, if_pos (heq.mp ht), hphase]
    · rw [if_neg ht, if_neg (fun hk => ht (heq.mpr hk))]
  · rw [scaledAffineGaussWeight, dif_neg hh, scaledAffineGaussWeight,
      dif_neg (fun hk => hh (hdiv.mpr hk))]

lemma cuspFrequency_div_three_phase_congr (a h k : O) (hmod : (9 : O) ∣ h - k) :
    tracePhase (cuspFrequency h * (ringComplex a / 3)) =
      tracePhase (cuspFrequency k * (ringComplex a / 3)) := by
  obtain ⟨r, hr⟩ := hmod
  have he : h = k + 9 * r := by linear_combination hr
  have he' : cuspFrequency h * (ringComplex a / 3) =
      cuspFrequency k * (ringComplex a / 3) + cuspFrequency r * (3 * ringComplex a) := by
    rw [he]
    simp only [cuspFrequency, map_add, map_mul, map_ofNat]
    ring
  rw [he', AddChar.map_add_eq_mul, cuspFrequency_period, mul_one]

lemma onceCuspScale_mul_root_dvd_three (t : Oˣ) (j : ℕ) : onceCuspScale t * omega ^ j ∣ (3 : O) := by
  let v : Oˣ := t * cuspOmegaUnit ^ j
  have hv : onceCuspScale t * omega ^ j = (v : O) * traceLambda := by
    simp only [v, onceCuspScale, Units.val_mul, Units.val_pow_eq_pow_val, cuspOmegaUnit_val]
    ring
  have htrace : traceLambda ^ 2 = (-3 : O) := by
    unfold traceLambda
    linear_combination 4 * cusp_omega_relation
  rw [hv]
  refine ⟨(v⁻¹ : Oˣ) * (-traceLambda), ?_⟩
  calc
    (3 : O) = -traceLambda ^ 2 := by rw [htrace]; ring
    _ = ((v : O) * (v⁻¹ : Oˣ)) * (-traceLambda ^ 2) := by rw [Units.mul_inv]; ring
    _ = _ := by ring

/-- The six ramified weights have one fixed period, independent of the prime factors. -/
lemma ramifiedSixWeight_congr_mod_twentySeven (u t : Oˣ) (h k : O)
    (hmod : (27 : O) ∣ h - k) (i : RamifiedSixBranch) (s : ℂ) :
    ramifiedSixWeight u t h i s = ramifiedSixWeight u t k i s := by
  have hphase := cuspFrequency_div_three_phase_congr (u⁻¹ : Oˣ) h k
    ((show (9 : O) ∣ 27 from ⟨3, by norm_num⟩).trans hmod)
  have hq (q : O) (hq : q ≠ 0) (hq3 : q ∣ 3) (v : Oˣ) (n : ℕ) :
      scaledAffineGaussWeight q v n h s = scaledAffineGaussWeight q v n k s := by
    apply scaledAffineGaussWeight_congr q hq v n h k _ s
    exact (show 9 * q ∣ (27 : O) from by
      convert mul_dvd_mul_left (9 : O) hq3 using 1 <;> norm_num).trans hmod
  rcases i with i | i
  · simp only [ramifiedSixWeight]
    rw [hq (u : O) u.ne_zero (show (u : O) ∣ 3 from u.isUnit.dvd) u 0]
  rcases i with i | i
  · simp only [ramifiedSixWeight]
    rw [hphase, hq (-(u : O)) (neg_ne_zero.mpr u.ne_zero) (show -(u : O) ∣ 3 from (-u).isUnit.dvd)]
  rcases i with i | j
  · simp only [ramifiedSixWeight]
    rw [hphase, hq 1 one_ne_zero (one_dvd _)]
  · simp only [ramifiedSixWeight]
    rw [hphase, hq (onceCuspScale t * omega ^ j.val)
      (mul_ne_zero (onceCusp_scale_ne_zero t) (pow_ne_zero _
        (omega_primitive.isUnit (by decide)).ne_zero)) (onceCuspScale_mul_root_dvd_three t j.val)]

lemma ramified_symbol_primary_congr_mod_nine (u : Oˣ) (m : ℕ) (a b : O)
    (ha : lambda ^ 2 ∣ a - 1) (hb : lambda ^ 2 ∣ b - 1) (hab : (9 : O) ∣ a - b) :
    symbol ((u : O) * lambda ^ m) a = symbol ((u : O) * lambda ^ m) b := by
  rw [symbol_mul_numerator, symbol_mul_numerator,
    symbol_pow_numerator _ a ha, symbol_pow_numerator _ b hb,
    symbol_unit_congr_mod_nine u.val a b u.isUnit ha hb hab,
    symbol_lambda_congr_mod_nine a b ha hb hab]

lemma ramified_symbol_primary_exponent_mod_three (u : Oˣ) (m : ℕ) (a : O)
    (ha : lambda ^ 2 ∣ a - 1) :
    symbol ((u : O) * lambda ^ m) a = symbol ((u : O) * lambda ^ (m % 3)) a := by
  have hc : IsCoprime lambda a := coprime_of_dvd_sub_one lambda a
    ((dvd_pow_self lambda (by decide : (2 : ℕ) ≠ 0)).trans ha)
  have hz := symbol_cube_of_isCoprime lambda a ha hc
  rw [symbol_mul_numerator, symbol_mul_numerator,
    symbol_pow_numerator _ a ha, symbol_pow_numerator _ a ha]
  congr 1
  calc
    _ = symbol lambda a ^ (m % 3 + 3 * (m / 3)) := by rw [Nat.mod_add_div]
    _ = _ := by rw [pow_add, pow_mul, hz, one_pow, mul_one]

/-- Reduction modulo three labels the finitely many integral cusp configurations. -/
def fixedCuspReduction : SL(2, O) →* SL(2, O ⧸ Ideal.span {(3 : O)}) :=
  Matrix.SpecialLinearGroup.map (n := Fin 2) (Ideal.Quotient.mk (Ideal.span {(3 : O)}))

abbrev FixedCuspSector := fixedCuspReduction.range

instance : Finite FixedCuspSector := by
  letI : Finite (O ⧸ Ideal.span {(3 : O)}) :=
    (Ideal.span {(3 : O)}).finiteQuotientOfFreeOfNeBot
      (Ideal.span_singleton_eq_bot.not.mpr (by norm_num))
  infer_instance

def fixedCuspSector (M : SL(2, O)) : FixedCuspSector := ⟨fixedCuspReduction M, ⟨M, rfl⟩⟩

def fixedCuspRepresentative (s : FixedCuspSector) : SL(2, O) := s.property.choose

lemma fixedCuspRepresentative_reduction (s : FixedCuspSector) :
    fixedCuspReduction (fixedCuspRepresentative s) = s.val := s.property.choose_spec

lemma fixedCusp_difference_levelThree (M : SL(2, O)) :
    M * (fixedCuspRepresentative (fixedCuspSector M))⁻¹ ∈ levelThree := by
  change fixedCuspReduction (M * (fixedCuspRepresentative (fixedCuspSector M))⁻¹) = 1
  rw [map_mul, map_inv, fixedCuspRepresentative_reduction]
  change fixedCuspReduction M * (fixedCuspReduction M)⁻¹ = 1
  exact mul_inv_cancel _

/-- The triangular cusp coordinate change depends only on the residue of the matrix modulo three. -/
theorem exists_fixed_cusp_decomposition :
    ∃ (j : FixedCuspSector → Fin 3) (T : FixedCuspSector → SL(2, O))
      (G : SL(2, O) → rationalExtension),
      (∀ s, T s 1 0 = 0 ∧ IsUnit (T s 0 0) ∧ IsUnit (T s 1 1)) ∧
      ∀ M : SL(2, O), M = (G M : SL(2, O)) * cuspRepresentative (j (fixedCuspSector M)) *
        T (fixedCuspSector M) := by
  have h (s : FixedCuspSector) := three_cusp_decomposition (fixedCuspRepresentative s)
  choose G₀ j T hT hT0 hT1 he using h
  let D : SL(2, O) → rationalExtension := fun M =>
    ⟨M * (fixedCuspRepresentative (fixedCuspSector M))⁻¹,
      levelThree_le_rationalExtension (fixedCusp_difference_levelThree M)⟩
  refine ⟨j, T, fun M => D M * G₀ (fixedCuspSector M), fun s => ⟨hT s, hT0 s, hT1 s⟩, ?_⟩
  intro M
  change M = (M * (fixedCuspRepresentative (fixedCuspSector M))⁻¹) *
    (G₀ (fixedCuspSector M) : SL(2, O)) * cuspRepresentative (j (fixedCuspSector M)) * T (fixedCuspSector M)
  rw [he (fixedCuspSector M)]
  group

/-- The cubic Gamma quotient is unitary on the imaginary axis. -/
lemma cubicReflectionGamma_axis_norm (t : ℝ) : ‖cubicReflectionGamma (t * Complex.I)‖ = 1 := by
  have h₁ := Gamma_vertical_conj (7 / 6) t
  have h₂ := Gamma_vertical_conj (5 / 6) t
  norm_num only [Complex.ofReal_div, Complex.ofReal_ofNat] at h₁ h₂
  have hn₁ : Complex.Gamma ((7 / 6 : ℂ) + t * Complex.I) ≠ 0 :=
    Complex.Gamma_ne_zero_of_re_pos (by norm_num)
  have hn₂ : Complex.Gamma ((5 / 6 : ℂ) + t * Complex.I) ≠ 0 :=
    Complex.Gamma_ne_zero_of_re_pos (by norm_num)
  rw [cubicReflectionGamma, h₁, h₂, norm_div, norm_mul, norm_mul, norm_star, norm_star,
    div_self (mul_ne_zero (norm_ne_zero_iff.mpr hn₁) (norm_ne_zero_iff.mpr hn₂))]

def cubicKernelAxisMultiplier (u : ℝ) : ℂ :=
  cubicReflectionGamma (((2 * Real.pi * u : ℝ) : ℂ) * Complex.I)

lemma cubicKernelAxisMultiplier_continuous : Continuous cubicKernelAxisMultiplier := by
  have hl : Continuous (fun u : ℝ => ((2 * Real.pi * u : ℝ) : ℂ) * Complex.I) := by fun_prop
  apply continuous_iff_continuousAt.mpr
  intro u
  exact (cubicReflectionGamma_differentiableAt _ (by norm_num)).continuousAt.comp hl.continuousAt

/-- The reflected logarithmic spectrum is a unitary multiplier of the source Fourier transform. -/
def kernelSpectralProfile (f : SchwartzMap ℝ ℂ) (u : ℝ) : ℂ :=
  cubicKernelAxisMultiplier u * (𝓕 f) u

lemma kernelSpectralProfile_norm (f : SchwartzMap ℝ ℂ) (u : ℝ) :
    ‖kernelSpectralProfile f u‖ = ‖(𝓕 f) u‖ := by
  rw [kernelSpectralProfile, norm_mul, cubicKernelAxisMultiplier, cubicReflectionGamma_axis_norm, one_mul]

lemma kernelSpectralProfile_continuous (f : SchwartzMap ℝ ℂ) : Continuous (kernelSpectralProfile f) :=
  cubicKernelAxisMultiplier_continuous.mul (𝓕 f).continuous

lemma kernelSpectralProfile_moment_integrable (f : SchwartzMap ℝ ℂ) (j : ℕ) :
    Integrable (fun u : ℝ => ‖u‖ ^ j * ‖kernelSpectralProfile f u‖) := by
  simpa only [kernelSpectralProfile_norm] using (𝓕 f).integrable_pow_mul volume j

lemma kernelSpectralProfile_pow_integrable (f : SchwartzMap ℝ ℂ) (j : ℕ) :
    Integrable (fun u : ℝ => u ^ j • kernelSpectralProfile f u) := by
  have hn (u : ℝ) : ‖(u ^ j : ℝ) • kernelSpectralProfile f u‖ =
      ‖u‖ ^ j * ‖kernelSpectralProfile f u‖ := by rw [norm_smul, norm_pow]
  apply (kernelSpectralProfile_moment_integrable f j).mono'
    ((continuous_id.pow j).smul (kernelSpectralProfile_continuous f)).aestronglyMeasurable
  exact Eventually.of_forall (fun u => (hn u).le)

def reflectedKernelLogProfile (f : SchwartzMap ℝ ℂ) : ℝ → ℂ := 𝓕 (kernelSpectralProfile f)

lemma reflectedKernelLogProfile_smooth (f : SchwartzMap ℝ ℂ) :
    ContDiff ℝ ∞ (reflectedKernelLogProfile f) :=
  Real.contDiff_fourier (fun j _ => kernelSpectralProfile_moment_integrable f j)

lemma reflectedKernelLogProfile_deriv (f : SchwartzMap ℝ ℂ) (j : ℕ) :
    iteratedDeriv j (reflectedKernelLogProfile f) =
      𝓕 (fun u : ℝ => (-2 * Real.pi * Complex.I * u) ^ j * kernelSpectralProfile f u) := by
  simpa only [reflectedKernelLogProfile, smul_eq_mul] using
    Real.iteratedDeriv_fourier (N := (⊤ : ℕ∞))
      (fun n _ => kernelSpectralProfile_pow_integrable f n) (by simp : (j : ℕ∞) ≤ ⊤)

lemma kernelLogSource_compact (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support V ⊆ Set.Icc a b) : HasCompactSupport (fun u : ℝ => V (Real.exp u)) := by
  apply HasCompactSupport.of_support_subset_isCompact (K := Set.Icc (Real.log a) (Real.log b)) isCompact_Icc
  intro u hu
  have hm := hs (show V (Real.exp u) ≠ 0 from hu)
  constructor
  · simpa only [Real.log_exp] using Real.log_le_log ha hm.1
  · simpa only [Real.log_exp] using Real.log_le_log (Real.exp_pos u) hm.2

def kernelLogSource (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V) : SchwartzMap ℝ ℂ :=
  (kernelLogSource_compact V a b ha hs).toSchwartzMap (hV.comp Real.contDiff_exp)

lemma mellin_imaginary_eq_logFourier (V : ℝ → ℂ) (f : SchwartzMap ℝ ℂ)
    (hf : ∀ u, f u = V (Real.exp u)) (u : ℝ) :
    mellin V (-(((2 * Real.pi * u : ℝ) : ℂ) * Complex.I)) = (𝓕 f) u := by
  rw [mellin_eq_fourier]
  have hfreq : (-(((2 * Real.pi * u : ℝ) : ℂ) * Complex.I)).im / (2 * Real.pi) = -u := by
    simp only [Complex.neg_im, Complex.mul_im, Complex.ofReal_re, Complex.I_im,
      Complex.ofReal_im, Complex.I_re, mul_one, mul_zero, add_zero]
    field_simp
  rw [hfreq]
  have hfun : (fun v : ℝ => Real.exp
      (-(-(((2 * Real.pi * u : ℝ) : ℂ) * Complex.I)).re * v) • V (Real.exp (-v))) =
      (f : ℝ → ℂ) ∘ LinearIsometryEquiv.neg ℝ := by
    funext v
    simp [hf]
  rw [hfun, Real.fourier_comp_linearIsometry]
  simp
  rfl

lemma paperKernel_eq_logFourier (V : ℝ → ℂ) (f : SchwartzMap ℝ ℂ)
    (hf : ∀ u, f u = V (Real.exp u)) (x : ℝ) (hx : 0 < x) :
    paperKernel V x = reflectedKernelLogProfile f (Real.log (paperScale * x)) := by
  unfold paperKernel
  rw [mellinInv_eq_fourierInv 0 _ (mul_pos paperScale_pos hx)]
  simp only [Complex.ofReal_zero, neg_zero, Complex.cpow_zero, one_smul]
  rw [Real.fourierInv_eq_fourier_neg, neg_neg]
  have hfun : (fun y : ℝ => mellin V (-(0 + 2 * Real.pi * y * Complex.I)) *
      cubicReflectionGamma (0 + 2 * Real.pi * y * Complex.I)) = kernelSpectralProfile f := by
    funext y
    have hy : (0 + 2 * Real.pi * y * Complex.I : ℂ) =
        ((2 * Real.pi * y : ℝ) : ℂ) * Complex.I := by push_cast; ring
    rw [hy, mellin_imaginary_eq_logFourier V f hf]
    exact mul_comm _ _
  rw [hfun]
  rfl
/-- Compact smooth source functions produce smooth reflected kernels on the positive axis. -/
theorem paperKernel_compact_source_smooth (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V) :
    ContDiffOn ℝ ∞ (paperKernel V) (Set.Ioi 0) := by
  let f := kernelLogSource V a b ha hs hV
  have hf : ∀ u, f u = V (Real.exp u) := fun u => rfl
  have hg : ContDiffOn ℝ ∞
      (fun x => reflectedKernelLogProfile f (Real.log (paperScale * x))) (Set.Ioi 0) := by
    intro x hx
    apply (reflectedKernelLogProfile_smooth f).contDiffAt.comp_contDiffWithinAt x
    exact ((contDiffAt_const.mul contDiffAt_id).log
      (ne_of_gt (mul_pos paperScale_pos hx))).contDiffWithinAt
  apply hg.congr
  intro x hx
  exact paperKernel_eq_logFourier V f hf x hx

/-- Inverse Mellin representations of logarithmic derivatives of the reflected kernel. -/
def paperKernelLogDerivative (V : ℝ → ℂ) (j : ℕ) (x : ℝ) : ℂ :=
  mellinInv 0 (mellinEulerData V j) (paperScale * x)

lemma paperKernelLogDerivative_zero (V : ℝ → ℂ) (x : ℝ) :
    paperKernelLogDerivative V 0 x = paperKernel V x := by
  have he : mellinEulerData V 0 = fun s : ℂ => mellin V (-s) * cubicReflectionGamma s := by
    funext s
    simp only [mellinEulerData, pow_zero, one_mul, mellinData]
  rw [paperKernelLogDerivative, he]
  rfl

lemma paperKernelLogDerivative_eq (V : ℝ → ℂ) (f : SchwartzMap ℝ ℂ)
    (hf : ∀ u, f u = V (Real.exp u)) (j : ℕ) (x : ℝ) (hx : 0 < x) :
    paperKernelLogDerivative V j x =
      iteratedDeriv j (reflectedKernelLogProfile f) (Real.log (paperScale * x)) := by
  rw [paperKernelLogDerivative, mellinInv_eq_fourierInv 0 _ (mul_pos paperScale_pos hx)]
  simp only [Complex.ofReal_zero, neg_zero, Complex.cpow_zero, one_smul]
  rw [Real.fourierInv_eq_fourier_neg, neg_neg, reflectedKernelLogProfile_deriv]
  have he : (fun y : ℝ => mellinEulerData V j (0 + 2 * Real.pi * y * Complex.I)) =
      fun u : ℝ => (-2 * Real.pi * Complex.I * u) ^ j * kernelSpectralProfile f u := by
    funext u
    have hu : (0 + 2 * Real.pi * u * Complex.I : ℂ) =
        ((2 * Real.pi * u : ℝ) : ℂ) * Complex.I := by push_cast; ring
    rw [hu, mellinEulerData, mellinData, mellin_imaginary_eq_logFourier V f hf]
    have hp : -(((2 * Real.pi * u : ℝ) : ℂ) * Complex.I) = -2 * Real.pi * Complex.I * u := by
      push_cast
      ring
    rw [hp]
    dsimp only [kernelSpectralProfile, cubicKernelAxisMultiplier]
    ring
  rw [he]

/-- Every logarithmic derivative has arbitrary polynomial decay at infinity. -/
theorem paperKernelLogDerivative_power_bound (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V) (N j : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 0 < x →
      ‖paperKernelLogDerivative V j x‖ ≤ C * x ^ (-(N : ℝ)) := by
  obtain ⟨C, hC, hb⟩ := mellinInv_euler_line_bound V a b ha hs hV N j
  refine ⟨C * paperScale ^ (-(N : ℝ)), mul_pos hC (Real.rpow_pos_of_pos paperScale_pos _), ?_⟩
  intro x hx
  have hN : (N : ℝ) ∈ Set.Icc (-(1 / 4 : ℝ)) (N : ℝ) :=
    ⟨by linarith [Nat.cast_nonneg (α := ℝ) N], le_rfl⟩
  rw [paperKernelLogDerivative, mellinInv_euler_shift V a b ha hs hV N j (N : ℝ) hN
    (paperScale * x) (mul_pos paperScale_pos hx)]
  simpa only [Real.mul_rpow paperScale_pos.le hx.le, mul_assoc] using
    hb (N : ℝ) hN (paperScale * x) (mul_pos paperScale_pos hx)

/-- Polynomially weighted logarithmic derivatives remain bounded on the positive axis. -/
theorem paperKernelLogDerivative_weighted_bound (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V) (N j : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 0 < x →
      (1 + x) ^ N * ‖paperKernelLogDerivative V j x‖ ≤ C := by
  obtain ⟨C₀, hC₀, hb₀⟩ := paperKernelLogDerivative_power_bound V a b ha hs hV 0 j
  obtain ⟨Cₙ, hCₙ, hbₙ⟩ := paperKernelLogDerivative_power_bound V a b ha hs hV N j
  refine ⟨2 ^ N * (C₀ + Cₙ), by positivity, ?_⟩
  intro x hx
  have hzero : ‖paperKernelLogDerivative V j x‖ ≤ C₀ := by
    simpa only [Nat.cast_zero, neg_zero, Real.rpow_zero, mul_one] using hb₀ x hx
  have hhigh : ‖paperKernelLogDerivative V j x‖ ≤ Cₙ / x ^ N := by
    simpa only [Real.rpow_neg hx.le, Real.rpow_natCast, div_eq_mul_inv] using hbₙ x hx
  by_cases hx1 : x ≤ 1
  · have hp : (1 + x) ^ N ≤ (2 : ℝ) ^ N := by gcongr; linarith
    calc
      _ ≤ 2 ^ N * C₀ := mul_le_mul hp hzero (norm_nonneg _) (by positivity)
      _ ≤ _ := mul_le_mul_of_nonneg_left (by linarith) (by positivity)
  · have hp : (1 + x) ^ N ≤ (2 : ℝ) ^ N * x ^ N := by
      rw [← mul_pow]
      gcongr
      linarith
    calc
      _ ≤ (2 ^ N * x ^ N) * (Cₙ / x ^ N) :=
        mul_le_mul hp hhigh (norm_nonneg _) (by positivity)
      _ = 2 ^ N * Cₙ := by field_simp [hx.ne']
      _ ≤ _ := mul_le_mul_of_nonneg_left (by linarith) (by positivity)

lemma iteratedDeriv_paperKernel_exp (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (R : ℝ) (hR : 0 < R) (j : ℕ) (u : ℝ) :
    iteratedDeriv j (fun v : ℝ => paperKernel V (R * Real.exp v)) u =
      paperKernelLogDerivative V j (R * Real.exp u) := by
  let f := kernelLogSource V a b ha hs hV
  have hf : ∀ v, f v = V (Real.exp v) := fun _ => rfl
  have he (v : ℝ) : Real.log (paperScale * (R * Real.exp v)) = Real.log (paperScale * R) + v := by
    rw [← mul_assoc, Real.log_mul (mul_pos paperScale_pos hR).ne' (Real.exp_pos v).ne', Real.log_exp]
  have hfun : (fun v : ℝ => paperKernel V (R * Real.exp v)) =
      fun v : ℝ => reflectedKernelLogProfile f (Real.log (paperScale * R) + v) := by
    funext v
    rw [paperKernel_eq_logFourier V f hf _ (mul_pos hR (Real.exp_pos v)), he]
  rw [hfun, iteratedDeriv_comp_const_add,
    paperKernelLogDerivative_eq V f hf j _ (mul_pos hR (Real.exp_pos u)), he]

/-- On any fixed logarithmic interval, all kernel derivatives have uniform decay in the radial parameter. -/
theorem paperKernel_exp_local_derivative_bound (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (M : ℝ) (hM : 0 ≤ M) (N j : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ R : ℝ, 0 < R → ∀ u : ℝ, |u| ≤ M →
      (1 + R) ^ N * ‖iteratedDeriv j (fun v : ℝ => paperKernel V (R * Real.exp v)) u‖ ≤ C := by
  obtain ⟨C, hC, hb⟩ := paperKernelLogDerivative_weighted_bound V a b ha hs hV N j
  refine ⟨Real.exp M ^ N * C, by positivity, ?_⟩
  intro R hR u hu
  have hMu : 0 ≤ M + u := by linarith [(abs_le.mp hu).1]
  have hE : 1 ≤ Real.exp M := by simpa only [Real.exp_zero] using Real.exp_le_exp.mpr hM
  have hEu : 1 ≤ Real.exp M * Real.exp u := by
    rw [← Real.exp_add]
    simpa only [Real.exp_zero] using Real.exp_le_exp.mpr hMu
  have hbase : 1 + R ≤ Real.exp M * (1 + R * Real.exp u) := by
    have hRu := mul_le_mul_of_nonneg_left hEu hR.le
    nlinarith only [hE, hRu]
  have hp : (1 + R) ^ N ≤ Real.exp M ^ N * (1 + R * Real.exp u) ^ N := by
    rw [← mul_pow]
    gcongr
  rw [iteratedDeriv_paperKernel_exp V a b ha hs hV R hR j u]
  calc
    _ ≤ (Real.exp M ^ N * (1 + R * Real.exp u) ^ N) *
        ‖paperKernelLogDerivative V j (R * Real.exp u)‖ :=
      mul_le_mul_of_nonneg_right hp (norm_nonneg _)
    _ = Real.exp M ^ N * ((1 + R * Real.exp u) ^ N *
        ‖paperKernelLogDerivative V j (R * Real.exp u)‖) := by ring
    _ ≤ _ := mul_le_mul_of_nonneg_left (hb _ (mul_pos hR (Real.exp_pos u))) (by positivity)


lemma paperKernel_exp_smooth (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (R : ℝ) (hR : 0 < R) :
    ContDiff ℝ ∞ (fun u : ℝ => paperKernel V (R * Real.exp u)) := by
  let f := kernelLogSource V a b ha hs hV
  have he : (fun u : ℝ => paperKernel V (R * Real.exp u)) =
      fun u : ℝ => reflectedKernelLogProfile f (Real.log (paperScale * R) + u) := by
    funext u
    rw [paperKernel_eq_logFourier V f (fun _ => rfl) _ (mul_pos hR (Real.exp_pos u))]
    rw [← mul_assoc, Real.log_mul (mul_pos paperScale_pos hR).ne' (Real.exp_pos u).ne', Real.log_exp]
  rw [he]
  exact (reflectedKernelLogProfile_smooth f).comp (contDiff_const.add contDiff_id)

/-- Localization in a fixed logarithmic interval preserves uniform radial decay of every derivative. -/
theorem localized_paperKernel_derivative_bound
    (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (χ : ℝ → ℂ) (hχ : ContDiff ℝ ∞ χ) (M : ℝ) (hM : 0 ≤ M)
    (hχs : Function.support χ ⊆ Set.Icc (-M) M) (N j : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ R : ℝ, 0 < R → ∀ u : ℝ,
      (1 + R) ^ N * ‖iteratedDeriv j (fun v : ℝ => χ v * paperKernel V (R * Real.exp v)) u‖ ≤ C := by
  have hχb (i : ℕ) : ∃ D : ℝ, 0 < D ∧ ∀ u ∈ Set.Icc (-M) M, ‖iteratedDeriv i χ u‖ ≤ D := by
    obtain ⟨D, hD⟩ := isCompact_Icc.bddAbove_image
      (hχ.continuous_iteratedDeriv i (by exact_mod_cast (le_top : (i : ℕ∞) ≤ ⊤))).norm.continuousOn
    exact ⟨|D| + 1, by positivity, fun u hu =>
      (hD (Set.mem_image_of_mem _ hu)).trans (by linarith [le_abs_self D])⟩
  choose D hD hDb using hχb
  have hkb (i : ℕ) := paperKernel_exp_local_derivative_bound V a b ha hs hV M hM N i
  choose C hC hCb using hkb
  let B := ∑ i ∈ Finset.range (j + 1), ‖(j.choose i : ℂ)‖ * D i * C (j - i)
  have hB : 0 ≤ B := Finset.sum_nonneg (fun i _ =>
    mul_nonneg (mul_nonneg (norm_nonneg _) (hD i).le) (hC (j - i)).le)
  refine ⟨B + 1, by positivity, ?_⟩
  intro R hR u
  by_cases hu : u ∈ Set.Icc (-M) M
  · have hprod := iteratedDeriv_mul (n := j) (x := u)
      (hχ.of_le (by exact_mod_cast (le_top : (j : ℕ∞) ≤ ⊤))).contDiffAt
      ((paperKernel_exp_smooth V a b ha hs hV R hR).of_le
        (by exact_mod_cast (le_top : (j : ℕ∞) ≤ ⊤))).contDiffAt
    change (1 + R) ^ N * ‖iteratedDeriv j (χ * (fun v : ℝ => paperKernel V (R * Real.exp v))) u‖ ≤ _
    rw [hprod]
    calc
      _ ≤ (1 + R) ^ N * ∑ i ∈ Finset.range (j + 1),
          ‖(j.choose i : ℂ) * iteratedDeriv i χ u *
            iteratedDeriv (j - i) (fun v : ℝ => paperKernel V (R * Real.exp v)) u‖ :=
        mul_le_mul_of_nonneg_left (norm_sum_le _ _) (by positivity)
      _ ≤ B := by
        rw [Finset.mul_sum]
        apply Finset.sum_le_sum
        intro i hi
        have hDi := (hD i).le
        have hCi := (hC (j - i)).le
        rw [norm_mul, norm_mul]
        calc
          _ = (‖(j.choose i : ℂ)‖ * ‖iteratedDeriv i χ u‖) *
              ((1 + R) ^ N * ‖iteratedDeriv (j - i) (fun v : ℝ => paperKernel V (R * Real.exp v)) u‖) := by ring
          _ ≤ (‖(j.choose i : ℂ)‖ * D i) * C (j - i) :=
            mul_le_mul (mul_le_mul_of_nonneg_left (hDb i u hu) (norm_nonneg _))
              (hCb (j - i) R hR u (abs_le.mpr hu)) (by positivity) (by positivity)
      _ ≤ B + 1 := by linarith
  · have hsprod : Function.support (fun v : ℝ => χ v * paperKernel V (R * Real.exp v)) ⊆ Set.Icc (-M) M := by
      intro v hv
      apply hχs
      intro hz
      exact hv (by simp only [hz, zero_mul])
    have hsd := (subset_tsupport (iteratedDeriv j (fun v : ℝ => χ v * paperKernel V (R * Real.exp v)))).trans
      ((tsupport_iteratedDeriv_subset _ j).trans (closure_minimal hsprod isClosed_Icc))
    have hz : iteratedDeriv j (fun v : ℝ => χ v * paperKernel V (R * Real.exp v)) u = 0 := by
      by_contra hn
      exact hu (hsd hn)
    rw [hz, norm_zero, mul_zero]
    positivity

/-- Uniform bounds on compactly supported derivatives give uniform Fourier moments. -/
theorem compact_weighted_family_fourier_power_bound
    (F : ℝ → ℝ → ℂ) (P : ℝ → ℝ) (hP : ∀ R, 0 < R → 0 ≤ P R)
    (hF : ∀ R, 0 < R → ContDiff ℝ ∞ (F R))
    (K : Set ℝ) (hK : IsCompact K) (hs : ∀ R, 0 < R → Function.support (F R) ⊆ K)
    (hb : ∀ j : ℕ, ∃ C : ℝ, 0 < C ∧ ∀ R, 0 < R → ∀ u,
      P R * ‖iteratedDeriv j (F R) u‖ ≤ C) (j : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ R, 0 < R → ∀ t : ℝ,
      P R * (|t| ^ j * ‖𝓕 (F R) t‖) ≤ C := by
  obtain ⟨C, hC, hCb⟩ := hb j
  refine ⟨C * (volume.real K + 1) / (2 * Real.pi) ^ j, by positivity, ?_⟩
  intro R hR t
  have hPR := hP R hR
  have hcompact (n : ℕ) : HasCompactSupport (iteratedDeriv n (F R)) := by
    apply HasCompactSupport.of_support_subset_isCompact hK
    exact (subset_tsupport _).trans ((tsupport_iteratedDeriv_subset _ n).trans
      (closure_minimal (hs R hR) hK.isClosed))
  have hi (n : ℕ) : Integrable (iteratedDeriv n (F R)) :=
    ((hF R hR).continuous_iteratedDeriv n
      (by exact_mod_cast (le_top : (n : ℕ∞) ≤ ⊤))).integrable_of_hasCompactSupport (hcompact n)
  have hfour := Real.fourier_iteratedDeriv (N := (⊤ : ℕ∞)) (hF R hR)
    (fun n _ => hi n) (by simp : (j : ℕ∞) ≤ ⊤)
  have hid : (2 * Real.pi) ^ j * (|t| ^ j * ‖𝓕 (F R) t‖) =
      ‖𝓕 (iteratedDeriv j (F R)) t‖ := by
    rw [hfour]
    simp only [norm_smul, norm_pow, norm_mul, Complex.norm_I, mul_one,
      Complex.norm_real, Real.norm_eq_abs, abs_of_pos Real.pi_pos]
    norm_num
    ring
  have hsder : Function.support (iteratedDeriv j (F R)) ⊆ K :=
    (subset_tsupport _).trans ((tsupport_iteratedDeriv_subset _ j).trans
      (closure_minimal (hs R hR) hK.isClosed))
  have hzero : ∀ u, u ∉ K → P R * ‖iteratedDeriv j (F R) u‖ = 0 := by
    intro u hu
    have hz : iteratedDeriv j (F R) u = 0 := by
      by_contra hn
      exact hu (hsder hn)
    rw [hz, norm_zero, mul_zero]
  have hI := norm_setIntegral_le_of_norm_le_const («μ» := volume)
    (f := fun u => P R * ‖iteratedDeriv j (F R) u‖) hK.measure_lt_top
    (C := C) (fun u _ => by rw [Real.norm_of_nonneg (by positivity)]; exact hCb R hR u)
  rw [setIntegral_eq_integral_of_forall_compl_eq_zero hzero,
    Real.norm_of_nonneg (integral_nonneg (fun _ => by positivity)), integral_const_mul] at hI
  have hFourier := mul_le_mul_of_nonneg_left
    (VectorFourier.norm_fourierIntegral_le_integral_norm Real.fourierChar volume (innerₗ ℝ)
      (iteratedDeriv j (F R)) t) (hP R hR)
  apply (le_div_iff₀ (by positivity : 0 < (2 * Real.pi) ^ j)).mpr
  calc
    _ = P R * ((2 * Real.pi) ^ j * (|t| ^ j * ‖𝓕 (F R) t‖)) := by ring
    _ = P R * ‖𝓕 (iteratedDeriv j (F R)) t‖ := by rw [hid]
    _ ≤ C * volume.real K := hFourier.trans hI
    _ ≤ C * (volume.real K + 1) := by nlinarith only [hC]

/-- The Fourier transform of a localized reflected kernel decays uniformly in both parameters. -/
theorem localized_paperKernel_fourier_bound
    (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (χ : ℝ → ℂ) (hχ : ContDiff ℝ ∞ χ) (M : ℝ) (hM : 0 ≤ M)
    (hχs : Function.support χ ⊆ Set.Icc (-M) M) (N J : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ R : ℝ, 0 < R → ∀ t : ℝ,
      (1 + R) ^ N * (1 + |t|) ^ J *
        ‖𝓕 (fun u : ℝ => χ u * paperKernel V (R * Real.exp u)) t‖ ≤ C := by
  let F := fun R u : ℝ => χ u * paperKernel V (R * Real.exp u)
  have hFs (R : ℝ) (_ : 0 < R) : Function.support (F R) ⊆ Set.Icc (-M) M := by
    intro u hu
    apply hχs
    intro hz
    exact hu (by simp only [F, hz, zero_mul])
  have hbase (j : ℕ) := compact_weighted_family_fourier_power_bound F (fun R => (1 + R) ^ N)
    (fun R hR => by positivity) (fun R hR => hχ.mul (paperKernel_exp_smooth V a b ha hs hV R hR))
    (Set.Icc (-M) M) isCompact_Icc hFs
    (localized_paperKernel_derivative_bound V a b ha hs hV χ hχ M hM hχs N) j
  obtain ⟨C₀, hC₀, hb₀⟩ := hbase 0
  obtain ⟨Cj, hCj, hbj⟩ := hbase J
  refine ⟨2 ^ J * (C₀ + Cj), by positivity, ?_⟩
  intro R hR t
  have hzero : (1 + R) ^ N * ‖𝓕 (F R) t‖ ≤ C₀ := by simpa only [pow_zero, one_mul] using hb₀ R hR t
  change (1 + R) ^ N * (1 + |t|) ^ J * ‖𝓕 (F R) t‖ ≤ _
  by_cases ht : |t| ≤ 1
  · have hp : (1 + |t|) ^ J ≤ (2 : ℝ) ^ J := by gcongr; linarith
    calc
      _ ≤ (1 + R) ^ N * 2 ^ J * ‖𝓕 (F R) t‖ := by gcongr
      _ = 2 ^ J * ((1 + R) ^ N * ‖𝓕 (F R) t‖) := by ring
      _ ≤ 2 ^ J * C₀ := mul_le_mul_of_nonneg_left hzero (by positivity)
      _ ≤ _ := mul_le_mul_of_nonneg_left (by linarith) (by positivity)
  · have hp : (1 + |t|) ^ J ≤ (2 * |t|) ^ J := by gcongr; linarith
    calc
      _ ≤ (1 + R) ^ N * (2 * |t|) ^ J * ‖𝓕 (F R) t‖ := by gcongr
      _ = 2 ^ J * ((1 + R) ^ N * (|t| ^ J * ‖𝓕 (F R) t‖)) := by rw [mul_pow]; ring
      _ ≤ 2 ^ J * Cj := mul_le_mul_of_nonneg_left (hbj R hR t) (by positivity)
      _ ≤ _ := mul_le_mul_of_nonneg_left (by linarith) (by positivity)

/-- The two extra Fourier powers furnish an integrable envelope. -/
lemma weighted_fourier_L1_bound (B : ℝ → ℂ) (hB : Continuous B)
    (P C : ℝ) (hP : 0 < P) (hC : 0 ≤ C) (J : ℕ)
    (hb : ∀ t : ℝ, P * (1 + |t|) ^ (J + 2) * ‖B t‖ ≤ C) :
    Integrable (fun t : ℝ => (1 + |t|) ^ J * ‖B t‖) ∧
      P * (∫ t : ℝ, (1 + |t|) ^ J * ‖B t‖) ≤
        C * ∫ t : ℝ, ((1 + |t|) ^ (2 : ℕ))⁻¹ := by
  have hw : Integrable (fun t : ℝ => ((1 + |t|) ^ (2 : ℕ))⁻¹) := by
    have h : Integrable (fun t : ℝ => (1 + ‖t‖) ^ (-(2 : ℝ))) :=
      integrable_one_add_norm (by norm_num)
    apply h.congr
    exact Eventually.of_forall (fun t => by
      dsimp only
      rw [Real.norm_eq_abs, Real.rpow_neg (by positivity), Real.rpow_two])
  have hdom (t : ℝ) : (1 + |t|) ^ J * ‖B t‖ ≤
      (C / P) * ((1 + |t|) ^ (2 : ℕ))⁻¹ := by
    rw [← div_eq_mul_inv]
    apply (le_div_iff₀ (by positivity : 0 < (1 + |t|) ^ (2 : ℕ))).mpr
    apply (le_div_iff₀ hP).mpr
    calc
      _ = P * (1 + |t|) ^ (J + 2) * ‖B t‖ := by rw [pow_add]; ring
      _ ≤ C := hb t
  have hi : Integrable (fun t : ℝ => (1 + |t|) ^ J * ‖B t‖) :=
    (hw.const_mul (C / P)).mono'
      (((continuous_const.add continuous_abs).pow J).mul hB.norm).aestronglyMeasurable
      (Eventually.of_forall (fun t => by rw [Real.norm_of_nonneg (by positivity)]; exact hdom t))
  refine ⟨hi, ?_⟩
  have hI := integral_mono hi (hw.const_mul (C / P)) hdom
  rw [integral_const_mul] at hI
  calc
    _ ≤ P * ((C / P) * ∫ t : ℝ, ((1 + |t|) ^ (2 : ℕ))⁻¹) :=
      mul_le_mul_of_nonneg_left hI hP.le
    _ = _ := by field_simp [hP.ne']

/-- A fixed smooth cutoff turns the reflected kernel into a uniformly rapidly decaying Fourier coefficient. -/
theorem localized_paperKernel_fourier_envelope
    (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V)
    (χ : ℝ → ℂ) (hχ : ContDiff ℝ ∞ χ) (M : ℝ) (hM : 0 ≤ M)
    (hχs : Function.support χ ⊆ Set.Icc (-M) M) (N J : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ R : ℝ, 0 < R → ∃ B : SchwartzMap ℝ ℂ,
      (∀ u : ℝ, χ u * paperKernel V (R * Real.exp u) = 𝓕⁻ (B : ℝ → ℂ) u) ∧
      Integrable (fun t : ℝ => (1 + |t|) ^ J * ‖B t‖) ∧
      (1 + R) ^ N * (∫ t : ℝ, (1 + |t|) ^ J * ‖B t‖) ≤ C ∧
      ∀ t : ℝ, (1 + R) ^ N * (1 + |t|) ^ J * ‖B t‖ ≤ C := by
  obtain ⟨C₁, hC₁, hb₁⟩ := localized_paperKernel_fourier_bound V a b ha hs hV χ hχ M hM hχs N J
  obtain ⟨C₂, hC₂, hb₂⟩ := localized_paperKernel_fourier_bound V a b ha hs hV χ hχ M hM hχs N (J + 2)
  let I : ℝ := ∫ t : ℝ, ((1 + |t|) ^ (2 : ℕ))⁻¹
  have hI : 0 ≤ I := integral_nonneg (fun _ => by positivity)
  refine ⟨C₁ + C₂ * (I + 1), by positivity, ?_⟩
  intro R hR
  have hc : HasCompactSupport (fun u : ℝ => χ u * paperKernel V (R * Real.exp u)) := by
    apply HasCompactSupport.of_support_subset_isCompact (K := Set.Icc (-M) M) isCompact_Icc
    intro u hu
    apply hχs
    intro hz
    exact hu (by simp only [hz, zero_mul])
  let S : SchwartzMap ℝ ℂ := hc.toSchwartzMap (hχ.mul (paperKernel_exp_smooth V a b ha hs hV R hR))
  refine ⟨𝓕 S, ?_⟩
  have he (u : ℝ) : χ u * paperKernel V (R * Real.exp u) = 𝓕⁻ (𝓕 (S : ℝ → ℂ)) u :=
    (S.integrable.fourierInv_fourier_eq (𝓕 S).integrable S.continuous.continuousAt).symm
  have hbound := weighted_fourier_L1_bound (𝓕 (S : ℝ → ℂ)) (𝓕 S).continuous ((1 + R) ^ N) C₂
    (by positivity) hC₂.le J (hb₂ R hR)
  refine ⟨he, hbound.1, ?_, ?_⟩
  · exact hbound.2.trans (by change C₂ * I ≤ _; nlinarith only [hC₁, hC₂, hI])
  · intro t
    exact (hb₁ R hR t).trans (by nlinarith only [hC₂, hI])

/-- The unitary logarithmic Fourier character. -/
def kernelLogPhase (t u : ℝ) : ℂ := Complex.exp (((2 * Real.pi * t * u : ℝ) : ℂ) * Complex.I)

lemma kernelLogPhase_sum {ι : Type*} (s : Finset ι) (t : ℝ) (u : ι → ℝ) :
    kernelLogPhase t (∑ i ∈ s, u i) = ∏ i ∈ s, kernelLogPhase t (u i) := by
  unfold kernelLogPhase
  rw [← Complex.exp_sum]
  congr 1
  simp only [Finset.mul_sum, Complex.ofReal_sum, Finset.sum_mul]

lemma kernelLogPhase_norm (t u : ℝ) : ‖kernelLogPhase t u‖ = 1 := by
  rw [kernelLogPhase, Complex.norm_exp]
  simp

/-- Coupled logarithmic factors separate into unitary characters with a uniform integrable Fourier envelope. -/
theorem paperKernel_log_separation
    {ι : Type*} [Fintype ι] (W : ι → ℝ → ℂ) (slope M : ι → ℝ)
    (hM : ∀ i, 0 ≤ M i) (hW : ∀ i u, W i u ≠ 0 → |u| ≤ M i)
    (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V) (N J : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ R : ℝ, 0 < R → ∃ B : SchwartzMap ℝ ℂ,
      (∀ y : ι → ℝ, (∏ i, W i (y i)) * paperKernel V (R * Real.exp (∑ i, slope i * y i)) =
        ∫ t : ℝ, (∏ i, W i (y i) * kernelLogPhase t (slope i * y i)) * B t) ∧
      Integrable (fun t : ℝ => (1 + |t|) ^ J * ‖B t‖) ∧
      (1 + R) ^ N * (∫ t : ℝ, (1 + |t|) ^ J * ‖B t‖) ≤ C ∧
      ∀ t : ℝ, (1 + R) ^ N * (1 + |t|) ^ J * ‖B t‖ ≤ C := by
  classical
  let L : ℝ := ∑ i, |slope i| * M i
  have hL : 0 ≤ L := Finset.sum_nonneg (fun i _ => mul_nonneg (abs_nonneg _) (hM i))
  let χ₀ : ContDiffBump (0 : ℝ) :=
    ⟨L + 1, L + 2, by linarith, by linarith⟩
  let χ : ℝ → ℂ := fun u => (χ₀ u : ℂ)
  have hχ : ContDiff ℝ ∞ χ := Complex.ofRealCLM.contDiff.comp χ₀.contDiff
  have hχs : Function.support χ ⊆ Set.Icc (-(L + 2)) (L + 2) := by
    intro u hu
    have hu₀ : u ∈ Function.support χ₀ := by
      change χ₀ u ≠ 0
      intro hz
      exact hu (by simp only [χ, hz, Complex.ofReal_zero])
    rw [χ₀.support_eq] at hu₀
    have habs : |u| < L + 2 := by simpa only [Metric.mem_ball, Real.dist_eq, sub_zero] using hu₀
    exact abs_le.mp habs.le
  have hχone (u : ℝ) (hu : |u| ≤ L) : χ u = 1 := by
    have hu₀ : u ∈ Metric.closedBall (0 : ℝ) χ₀.rIn := by
      change dist u 0 ≤ L + 1
      rw [Real.dist_eq, sub_zero]
      linarith
    simp only [χ, χ₀.one_of_mem_closedBall hu₀, Complex.ofReal_one]
  obtain ⟨C, hC, hb⟩ := localized_paperKernel_fourier_envelope V a b ha hs hV
    χ hχ (L + 2) (by linarith) hχs N J
  refine ⟨C, hC, ?_⟩
  intro R hR
  obtain ⟨B, hsep, hi, hI, hpt⟩ := hb R hR
  refine ⟨B, ?_, hi, hI, hpt⟩
  intro y
  have hprod (t : ℝ) : (∏ i, W i (y i) * kernelLogPhase t (slope i * y i)) =
      (∏ i, W i (y i)) * kernelLogPhase t (∑ i, slope i * y i) := by
    rw [Finset.prod_mul_distrib, kernelLogPhase_sum]
  simp_rw [hprod, mul_assoc]
  rw [integral_const_mul]
  by_cases hz : (∏ i, W i (y i)) = 0
  · simp only [hz, zero_mul]
  · congr 1
    have hwy (i : ι) : W i (y i) ≠ 0 := by
      exact (Finset.prod_ne_zero_iff.mp hz) i (Finset.mem_univ i)
    have hys : |∑ i, slope i * y i| ≤ L := by
      calc
        _ ≤ ∑ i, |slope i * y i| := by
          simpa only [Real.norm_eq_abs] using norm_sum_le (s := Finset.univ) (f := fun i => slope i * y i)
        _ ≤ L := Finset.sum_le_sum (fun i _ => by rw [abs_mul]; exact mul_le_mul_of_nonneg_left (hW i (y i) (hwy i)) (abs_nonneg _))
    have he := hsep (∑ i, slope i * y i)
    rw [hχone _ hys, one_mul, Real.fourierInv_eq'] at he
    simp only [smul_eq_mul] at he
    convert he using 1
    apply integral_congr_ae
    filter_upwards [] with t
    congr 1
    unfold kernelLogPhase
    congr 1
    simp only [RCLike.inner_apply, conj_trivial]
    push_cast
    ring


/-- Cusp representatives and triangular coordinate changes are chosen once modulo three. -/
def fixedCuspIndex : FixedCuspSector → Fin 3 := exists_fixed_cusp_decomposition.choose

def fixedCuspTriangular : FixedCuspSector → SL(2, O) :=
  exists_fixed_cusp_decomposition.choose_spec.choose

def fixedCuspGamma : SL(2, O) → rationalExtension :=
  exists_fixed_cusp_decomposition.choose_spec.choose_spec.choose

lemma fixedCuspTriangular_properties (s : FixedCuspSector) :
    fixedCuspTriangular s 1 0 = 0 ∧ IsUnit (fixedCuspTriangular s 0 0) ∧
      IsUnit (fixedCuspTriangular s 1 1) :=
  exists_fixed_cusp_decomposition.choose_spec.choose_spec.choose_spec.1 s

lemma fixedCusp_factorization (M : SL(2, O)) :
    M = (fixedCuspGamma M : SL(2, O)) * cuspRepresentative (fixedCuspIndex (fixedCuspSector M)) *
      fixedCuspTriangular (fixedCuspSector M) :=
  exists_fixed_cusp_decomposition.choose_spec.choose_spec.choose_spec.2 M

lemma fixedCusp_lower_ne_zero (M : SL(2, O)) (hc : M 1 0 ≠ 0) :
    (integralComplexMatrix (fixedCuspGamma M : SL(2, O)) *
      integralComplexMatrix (cuspRepresentative (fixedCuspIndex (fixedCuspSector M)))) 1 0 ≠ 0 := by
  let g := integralComplexMatrix (fixedCuspGamma M : SL(2, O)) *
    integralComplexMatrix (cuspRepresentative (fixedCuspIndex (fixedCuspSector M)))
  let T := integralComplexMatrix (fixedCuspTriangular (fixedCuspSector M))
  have he : integralComplexMatrix M = g * T := by
    rw [fixedCusp_factorization M, map_mul, map_mul]
  have ht : T 1 0 = 0 := by
    change ringComplex (fixedCuspTriangular (fixedCuspSector M) 1 0) = 0
    rw [(fixedCuspTriangular_properties _).1, map_zero]
  exact (upperTriangular_right_cusp_ratio g T ht (by rw [← he]; exact ringComplex_ne_zero hc)).1

def fixedMatrixCusp (M : SL(2, O)) (hc : M 1 0 ≠ 0) : SourceCuspDatum :=
  ⟨fixedCuspGamma M, fixedCuspIndex (fixedCuspSector M), fixedCusp_lower_ne_zero M hc⟩

lemma fixedMatrixCusp_factorization (M : SL(2, O)) (hc : M 1 0 ≠ 0) :
    integralComplexMatrix M = (fixedMatrixCusp M hc).matrix *
      integralComplexMatrix (fixedCuspTriangular (fixedCuspSector M)) := by
  change integralComplexMatrix M =
    (integralComplexMatrix (fixedCuspGamma M : SL(2, O)) *
      integralComplexMatrix (cuspRepresentative (fixedCuspIndex (fixedCuspSector M)))) * _
  have he := congrArg integralComplexMatrix (fixedCusp_factorization M)
  simpa only [map_mul] using he

lemma fixedMatrixCusp_point (M : SL(2, O)) (hc : M 1 0 ≠ 0) :
    (fixedMatrixCusp M hc).point = ringComplex (M 0 0) / ringComplex (M 1 0) := by
  let T := integralComplexMatrix (fixedCuspTriangular (fixedCuspSector M))
  have ht : T 1 0 = 0 := by
    change ringComplex (fixedCuspTriangular (fixedCuspSector M) 1 0) = 0
    rw [(fixedCuspTriangular_properties _).1, map_zero]
  have he := fixedMatrixCusp_factorization M hc
  exact (upperTriangular_right_cusp_ratio (fixedMatrixCusp M hc).matrix T ht
    (by rw [← he]; exact ringComplex_ne_zero hc)).2.symm.trans (by rw [← he]; rfl)

/-- Integral units leave the radial height unchanged under the fixed triangular coordinate change. -/
lemma fixedMatrixCusp_heightScale (M : SL(2, O)) (hc : M 1 0 ≠ 0) :
    (fixedMatrixCusp M hc).heightScale = ‖ringComplex (M 1 0)‖ ^ 2 := by
  let T := fixedCuspTriangular (fixedCuspSector M)
  have hT : T 1 0 = 0 := (fixedCuspTriangular_properties _).1
  have hunit : IsUnit (T 0 0) := (fixedCuspTriangular_properties _).2.1
  have hn : ‖ringComplex (T 0 0)‖ = 1 := by
    rw [← hunit.unit_spec]
    exact norm_ringComplex_unit hunit.unit
  have he := congrArg (fun A : SL(2, ℂ) => A 1 0) (fixedMatrixCusp_factorization M hc)
  have hcol : ringComplex (M 1 0) = (fixedMatrixCusp M hc).matrix 1 0 * ringComplex (T 0 0) := by
    change ringComplex (M 1 0) = ∑ k : Fin 2,
      (fixedMatrixCusp M hc).matrix 1 k * ringComplex (T k 0) at he
    simpa only [Fin.sum_univ_two, hT, map_zero, mul_zero, add_zero] using he
  rw [SourceCuspDatum.heightScale, hcol, norm_mul, hn, mul_one]

lemma upperTriangular_right_dualPoint (g T : SL(2, ℂ)) (hT : T 1 0 = 0)
    (hc : (g * T) 1 0 ≠ 0) :
    -g 1 1 / g 1 0 = (T 0 0) ^ 2 * (-(g * T) 1 1 / (g * T) 1 0) + T 0 0 * T 0 1 := by
  have hcol : (g * T) 1 0 = g 1 0 * T 0 0 := by
    change (∑ k : Fin 2, g 1 k * T k 0) = _
    rw [Fin.sum_univ_two, hT, mul_zero, add_zero]
  have hrow : (g * T) 1 1 = g 1 0 * T 0 1 + g 1 1 * T 1 1 := by
    change (∑ k : Fin 2, g 1 k * T k 1) = _
    rw [Fin.sum_univ_two]
  have ht0 : T 0 0 ≠ 0 := (mul_ne_zero_iff.mp (hcol ▸ hc)).2
  have hdet : T 0 0 * T 1 1 = 1 := by
    simpa only [Matrix.det_fin_two, hT, mul_zero, sub_zero] using T.property
  have hg : (g * T) 1 0 / T 0 0 = g 1 0 := by rw [hcol, mul_div_cancel_right₀ _ ht0]
  have hd : (g * T) 1 1 * T 0 0 - (g * T) 1 0 * T 0 1 = g 1 1 := by
    rw [hrow, hcol]
    calc
      _ = g 1 1 * (T 0 0 * T 1 1) := by ring
      _ = _ := by rw [hdet, mul_one]
  calc
    _ = -((g * T) 1 1 * T 0 0 - (g * T) 1 0 * T 0 1) /
        ((g * T) 1 0 / T 0 0) := by rw [hg, hd]
    _ = _ := by field_simp [hc, ht0]; ring

/-- The dual coordinate varies by a unit rotation and a translation fixed by the matrix modulo three. -/
lemma fixedMatrixCusp_dualPoint (M : SL(2, O)) (hc : M 1 0 ≠ 0) :
    (fixedMatrixCusp M hc).dualPoint =
      ringComplex (fixedCuspTriangular (fixedCuspSector M) 0 0) ^ 2 *
        (-ringComplex (M 1 1) / ringComplex (M 1 0)) +
      ringComplex (fixedCuspTriangular (fixedCuspSector M) 0 0 *
        fixedCuspTriangular (fixedCuspSector M) 0 1) := by
  let T := integralComplexMatrix (fixedCuspTriangular (fixedCuspSector M))
  have ht : T 1 0 = 0 := by
    change ringComplex (fixedCuspTriangular (fixedCuspSector M) 1 0) = 0
    rw [(fixedCuspTriangular_properties _).1, map_zero]
  have he := fixedMatrixCusp_factorization M hc
  have hd := upperTriangular_right_dualPoint (fixedMatrixCusp M hc).matrix T ht
    (by rw [← he]; exact ringComplex_ne_zero hc)
  rw [← he] at hd
  change (fixedMatrixCusp M hc).dualPoint =
    ringComplex (fixedCuspTriangular (fixedCuspSector M) 0 0) ^ 2 *
      (-ringComplex (M 1 1) / ringComplex (M 1 0)) +
    ringComplex (fixedCuspTriangular (fixedCuspSector M) 0 0) *
      ringComplex (fixedCuspTriangular (fixedCuspSector M) 0 1) at hd
  rw [map_mul]
  exact hd

/-- Reflection is independent of the chosen coordinates at each finite cusp. -/
theorem completedT_finite_cusp_reflection (c : O) (hc : c ≠ 0)
    [Fintype (O ⧸ Ideal.span {9 * c})] (Ψ : (O ⧸ Ideal.span {c}) →* ℂ)
    (d : (O ⧸ Ideal.span {9 * c}) → SourceCuspDatum)
    (hd : ∀ i, (d i).point = thetaFourierTranslation (9 * c) i)
    (W : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support W ⊆ Set.Icc a b) (hW : ContDiff ℝ ∞ W)
    (X : ℝ) (hX : 0 < X) :
    completedT (Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom) W X =
      thetaDerivativeScalar⁻¹ * ∑ i,
        finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (9 * c) (mul_ne_zero (by norm_num) hc))
          (finiteThetaTwist c Ψ) i *
        ((d i).smoothingMultiplier * ∑' h : O, sourceCuspRadialCoefficient (d i).index (d i).dualPoint h *
          paperKernel (Vstar W) ((d i).smoothingScale X * sourceCuspRadialLength h)) := by
  rw [completedT_finite_smoothed_reflection c hc Ψ W a b ha hs hW X hX]
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  congr 1
  rw [← (d i).smoothed_reflection (Vstar W) a b ha (Vstar_support W a b hs)
      (Vstar_contDiff W a b ha hs hW) X hX,
    ← (finiteTwistCusp (9 * c) (mul_ne_zero (by norm_num) hc) i).smoothed_reflection
      (Vstar W) a b ha (Vstar_support W a b hs) (Vstar_contDiff W a b ha hs hW) X hX,
    hd i, finiteTwistCusp_point]

/-- Fixed cusp coordinates retain the exact unit, ramified, squarefree, and cube decomposition. -/
theorem completedT_finite_cusp_full_reflection (c : O) (hc : c ≠ 0)
    [Fintype (O ⧸ Ideal.span {9 * c})] (Ψ : (O ⧸ Ideal.span {c}) →* ℂ)
    (d : (O ⧸ Ideal.span {9 * c}) → SourceCuspDatum)
    (hd : ∀ i, (d i).point = thetaFourierTranslation (9 * c) i)
    (W : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support W ⊆ Set.Icc a b) (hW : ContDiff ℝ ∞ W)
    (X : ℝ) (hX : 0 < X) :
    completedT (Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom) W X =
      thetaDerivativeScalar⁻¹ * ∑ i,
        finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (9 * c) (mul_ne_zero (by norm_num) hc))
          (finiteThetaTwist c Ψ) i *
        ((d i).smoothingMultiplier * ∑' p : ThetaFullIndex,
          sourceCuspRadialCoefficient (d i).index (d i).dualPoint (thetaFullFrequency p) *
          paperKernel (Vstar W) ((d i).smoothingScale X *
            (‖ringComplex lambda‖ ^ (2 * p.2.1) * completedMellinLength p.2.2))) := by
  rw [completedT_finite_cusp_reflection c hc Ψ d hd W a b ha hs hW X hX]
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  rw [sourceCuspRadial_tsum_full_index]
  simp only [thetaFullFrequency_radialLength]


/-- The fixed cusp array includes the bounded translation phase. -/
def fixedCuspRadialArray (s : FixedCuspSector) (h : O) : ℂ :=
  sourceCuspRadialBaseCoefficient (fixedCuspIndex s) h *
    tracePhase (-cuspFrequency h *
      (ringComplex (fixedCuspTriangular s 0 0 * fixedCuspTriangular s 0 1) /
        (sourceCuspScale (fixedCuspIndex s) : ℂ)))

lemma fixedCuspRadialArray_norm (s : FixedCuspSector) (h : O) :
    ‖fixedCuspRadialArray s h‖ = ‖sourceCuspRadialBaseCoefficient (fixedCuspIndex s) h‖ := by
  rw [fixedCuspRadialArray, norm_mul, tracePhase_norm, mul_one]

/-- The moving part of a cusp coefficient is an inverse-denominator additive phase. -/
lemma fixedMatrixCusp_radialCoefficient (M : SL(2, O)) (hc : M 1 0 ≠ 0) (h : O) :
    sourceCuspRadialCoefficient (fixedMatrixCusp M hc).index (fixedMatrixCusp M hc).dualPoint h =
      fixedCuspRadialArray (fixedCuspSector M) h *
        tracePhase (cuspFrequency h * ringComplex (fixedCuspTriangular (fixedCuspSector M) 0 0) ^ 2 *
          ringComplex (M 1 1) / ((sourceCuspScale (fixedCuspIndex (fixedCuspSector M)) : ℂ) *
            ringComplex (M 1 0))) := by
  rw [sourceCuspRadialCoefficient, fixedMatrixCusp_dualPoint]
  rw [show (fixedMatrixCusp M hc).index = fixedCuspIndex (fixedCuspSector M) from rfl]
  have he : -cuspFrequency h *
      ((ringComplex (fixedCuspTriangular (fixedCuspSector M) 0 0) ^ 2 *
          (-ringComplex (M 1 1) / ringComplex (M 1 0)) +
        ringComplex (fixedCuspTriangular (fixedCuspSector M) 0 0 *
          fixedCuspTriangular (fixedCuspSector M) 0 1)) /
        (sourceCuspScale (fixedCuspIndex (fixedCuspSector M)) : ℂ)) =
      -cuspFrequency h *
        (ringComplex (fixedCuspTriangular (fixedCuspSector M) 0 0 *
          fixedCuspTriangular (fixedCuspSector M) 0 1) /
          (sourceCuspScale (fixedCuspIndex (fixedCuspSector M)) : ℂ)) +
      cuspFrequency h * ringComplex (fixedCuspTriangular (fixedCuspSector M) 0 0) ^ 2 *
        ringComplex (M 1 1) / ((sourceCuspScale (fixedCuspIndex (fixedCuspSector M)) : ℂ) *
          ringComplex (M 1 0)) := by ring
  rw [he, AddChar.map_add_eq_mul]
  simp only [fixedCuspRadialArray, mul_assoc]

lemma fixedMatrixCusp_lower (M : SL(2, O)) (hc : M 1 0 ≠ 0) :
    (fixedMatrixCusp M hc).matrix 1 0 = ringComplex (M 1 0) /
      ringComplex (fixedCuspTriangular (fixedCuspSector M) 0 0) := by
  have hu := (fixedCuspTriangular_properties (fixedCuspSector M)).2.1
  have ht0 : ringComplex (fixedCuspTriangular (fixedCuspSector M) 0 0) ≠ 0 :=
    ringComplex_ne_zero hu.ne_zero
  apply (eq_div_iff ht0).mpr
  have he := congrArg (fun A : SL(2, ℂ) => A 1 0) (fixedMatrixCusp_factorization M hc)
  change ringComplex (M 1 0) = ∑ k : Fin 2, (fixedMatrixCusp M hc).matrix 1 k *
    ringComplex (fixedCuspTriangular (fixedCuspSector M) k 0) at he
  simpa only [Fin.sum_univ_two, (fixedCuspTriangular_properties _).1, map_zero, mul_zero, add_zero] using he.symm

/-- The radial reflection scale is determined by the denominator norm and a fixed cusp class. -/
lemma fixedMatrixCusp_smoothingScale (M : SL(2, O)) (hc : M 1 0 ≠ 0) (X : ℝ) :
    (fixedMatrixCusp M hc).smoothingScale X =
      27 * (sourceCuspRadialScale 0) ^ 2 *
        (sourceCuspRadialScale (fixedCuspIndex (fixedCuspSector M))) ^ 2 * X /
        ‖ringComplex (M 1 0)‖ ^ 4 := by
  rw [SourceCuspDatum.smoothingScale, fixedMatrixCusp_heightScale, ← pow_mul]
  rfl

/-- The reflected prefactor separates the cubic character and a unit-modulus denominator phase. -/
lemma fixedMatrixCusp_smoothingMultiplier (M : SL(2, O)) (hc : M 1 0 ≠ 0) :
    (fixedMatrixCusp M hc).smoothingMultiplier =
      -star (extendedComplexCharacter (fixedCuspGamma M)) *
        ringComplex (fixedCuspTriangular (fixedCuspSector M) 0 0) ^ 2 *
        (star (ringComplex (M 1 0)) / ringComplex (M 1 0)) *
        (sourceCuspScale (fixedCuspIndex (fixedCuspSector M)) : ℂ) ^ 2 := by
  have hc0 := ringComplex_ne_zero hc
  have ht0 := ringComplex_ne_zero (fixedCuspTriangular_properties (fixedCuspSector M)).2.1.ne_zero
  have hn : star (ringComplex (M 1 0)) * ringComplex (M 1 0) =
      (‖ringComplex (M 1 0)‖ : ℂ) ^ 2 := by
    simpa only [Complex.star_def, Complex.ofReal_pow] using Complex.conj_mul' (ringComplex (M 1 0))
  rw [SourceCuspDatum.smoothingMultiplier, SourceCuspDatum.multiplier,
    fixedMatrixCusp_lower, fixedMatrixCusp_heightScale, sourceCuspRadialScale_ratio]
  simp only [Complex.ofReal_mul, Complex.ofReal_pow]
  rw [← hn]
  change -star (extendedComplexCharacter (fixedCuspGamma M)) /
      (ringComplex (M 1 0) / ringComplex (fixedCuspTriangular (fixedCuspSector M) 0 0)) ^ 2 *
      ((star (ringComplex (M 1 0)) * ringComplex (M 1 0)) *
        (sourceCuspScale (fixedCuspIndex (fixedCuspSector M)) : ℂ) ^ 2) = _
  field_simp

lemma sourceCusp_translation_phase_congr (j : Fin 3) (a h k : O) (hmod : (9 : O) ∣ h - k) :
    tracePhase (-cuspFrequency h * (ringComplex a / (sourceCuspScale j : ℂ))) =
      tracePhase (-cuspFrequency k * (ringComplex a / (sourceCuspScale j : ℂ))) := by
  fin_cases j
  · change tracePhase (-cuspFrequency h * (ringComplex a / (1 : ℂ))) =
      tracePhase (-cuspFrequency k * (ringComplex a / (1 : ℂ)))
    simp only [div_one]
    have he (x : O) : -cuspFrequency x * ringComplex a =
        cuspFrequency x * (ringComplex (-3 * a) / 3) := by
      simp only [map_mul, map_neg, map_ofNat]
      ring
    rw [he h, he k]
    exact cuspFrequency_div_three_phase_congr (-3 * a) h k hmod
  · change tracePhase (-cuspFrequency h * (ringComplex a / 3)) =
      tracePhase (-cuspFrequency k * (ringComplex a / 3))
    simpa only [map_neg, neg_div, mul_neg, neg_mul] using cuspFrequency_div_three_phase_congr (-a) h k hmod
  · change tracePhase (-cuspFrequency h * (ringComplex a / 3)) =
      tracePhase (-cuspFrequency k * (ringComplex a / 3))
    simpa only [map_neg, neg_div, mul_neg, neg_mul] using cuspFrequency_div_three_phase_congr (-a) h k hmod

/-- The fixed translation phase requires only the frequency residue modulo nine. -/
lemma fixedCusp_translation_phase_congr (s : FixedCuspSector) (h k : O) (hmod : (9 : O) ∣ h - k) :
    tracePhase (-cuspFrequency h *
      (ringComplex (fixedCuspTriangular s 0 0 * fixedCuspTriangular s 0 1) /
        (sourceCuspScale (fixedCuspIndex s) : ℂ))) =
    tracePhase (-cuspFrequency k *
      (ringComplex (fixedCuspTriangular s 0 0 * fixedCuspTriangular s 0 1) /
        (sourceCuspScale (fixedCuspIndex s) : ℂ))) :=
  sourceCusp_translation_phase_congr _ _ h k hmod

lemma sourceCusp_full_kernel_norm_summable (j : Fin 3) (z : ℂ)
    (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V) (R : ℝ) (hR : 0 < R) :
    Summable (fun p : ThetaFullIndex => ‖sourceCuspRadialCoefficient j z (thetaFullFrequency p) *
      paperKernel V (R * sourceCuspRadialLength (thetaFullFrequency p))‖) := by
  have hc : Summable (fun h : O => ‖sourceCuspRadialCoefficient j z h‖ *
      sourceCuspRadialLength h ^ (-(3 / 2 : ℝ))) := by
    simpa only [neg_div] using sourceCuspRadialCoefficient_weighted_summable j z
  exact (paperKernel_weighted_norm_summable sourceCuspRadialLength sourceCuspRadialLength_pos
    (sourceCuspRadialCoefficient j z) hc V a b ha hs hV R hR).comp_injective thetaFullFrequency_injective

/-- Fourier coefficients of a multiplicative character at unit frequencies are Gauss sums. -/
lemma finiteAdditiveFourierCoeff_mulChar_unit {F : Type*} [Field F] [Fintype F]
    (ψ : AddChar F ℂ) (χ : MulChar F ℂ) (h : Fˣ) :
    finiteAdditiveFourierCoeff ψ χ (h : F) =
      (Fintype.card F : ℂ)⁻¹ * χ⁻¹ h * gaussSum χ (ψ.mulShift (-1)) := by
  have he : (∑ t : F, χ t * ψ (-(h * t))) = χ⁻¹ h * gaussSum χ (ψ.mulShift (-1)) := by
    simpa only [gaussSum, AddChar.mulShift_apply, neg_one_mul, mul_neg] using
      gaussSum_mulShift_eq χ (ψ.mulShift (-1)) h
  rw [finiteAdditiveFourierCoeff]
  simp only [neg_mul] at *
  rw [he]
  ring

lemma finiteGauss_sum_units {F : Type*} [Field F] [Fintype F]
    (χ : MulChar F ℂ) (ψ : AddChar F ℂ) :
    gaussSum χ ψ = ∑ y : Fˣ, χ (y : F) * ψ (y : F) := by
  classical
  calc
    gaussSum χ ψ = ∑ x ∈ (Finset.univ : Finset F).erase 0, χ x * ψ x := by
      simpa only [gaussSum, MulChar.map_zero, zero_mul, add_zero] using
        (Finset.sum_erase_add (Finset.univ : Finset F) (fun x => χ x * ψ x) (Finset.mem_univ (0 : F))).symm
    _ = ∑ x : {x : F // x ≠ 0}, χ x * ψ x := by
      apply Finset.sum_subtype
      intro x
      simp only [Finset.mem_erase, Finset.mem_univ, and_true]
    _ = ∑ y : Fˣ, χ (y : F) * ψ (y : F) :=
      (Fintype.sum_equiv unitsEquivNeZero _ _ (fun _ => rfl)).symm

/-- The local reflected row retains the zero output and the cubic automorphy factor. -/
def finiteReflectionGauss {F : Type*} [Field F] [Fintype F]
    (χ : MulChar F ℂ) (ψ : AddChar F ℂ) (j : ℕ) (x : F) : ℂ :=
  ∑ h : Fˣ, finiteAdditiveFourierCoeff ψ (χ ^ j : MulChar F ℂ) (h : F) * ((χ⁻¹) ^ 2) h *
    ψ (x * ((h⁻¹ : Fˣ) : F))

/-- Local reflection is exactly a product of two Gauss sums, including exceptional powers. -/
theorem finiteReflectionGauss_product {F : Type*} [Field F] [Fintype F]
    (χ : MulChar F ℂ) (ψ : AddChar F ℂ) (j : ℕ) (x : F) :
    finiteReflectionGauss χ ψ j x = (Fintype.card F : ℂ)⁻¹ *
      gaussSum (χ ^ j) (ψ.mulShift (-1)) * gaussSum (χ ^ (j + 2)) (ψ.mulShift x) := by
  classical
  have hinv : (∑ h : Fˣ, (((χ ^ j)⁻¹ * (χ⁻¹) ^ 2) h) * ψ (x * ((h⁻¹ : Fˣ) : F))) =
      gaussSum (χ ^ (j + 2)) (ψ.mulShift x) := by
    calc
      _ = ∑ h : Fˣ, (((χ ^ j)⁻¹ * (χ⁻¹) ^ 2) (h⁻¹)) * ψ (x * (h : F)) := by
        apply Fintype.sum_equiv (Equiv.inv Fˣ)
        intro h
        simp only [Equiv.inv_apply, Units.val_inv_eq_inv_val, inv_inv]
      _ = ∑ h : Fˣ, (χ ^ (j + 2)) h * ψ (x * (h : F)) := by
        apply Finset.sum_congr rfl
        intro h hh
        have he : (((χ ^ j)⁻¹ * (χ⁻¹) ^ 2)⁻¹) = χ ^ (j + 2) := by group
        rw [← MulChar.inv_apply', he]
      _ = _ := by rw [finiteGauss_sum_units]; rfl
  rw [finiteReflectionGauss]
  simp_rw [finiteAdditiveFourierCoeff_mulChar_unit]
  calc
    _ = ((Fintype.card F : ℂ)⁻¹ * gaussSum (χ ^ j) (ψ.mulShift (-1))) *
        ∑ h : Fˣ, (((χ ^ j)⁻¹ * (χ⁻¹) ^ 2) h) * ψ (x * ((h⁻¹ : Fˣ) : F)) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro h hh
      rw [MulChar.mul_apply]
      ring
    _ = _ := by rw [hinv]

lemma finiteGauss_mulShift_all {F : Type*} [Field F] [Fintype F]
    (χ : MulChar F ℂ) (ψ : AddChar F ℂ) (hχ : χ ≠ 1) (x : F) :
    gaussSum χ (ψ.mulShift x) = χ⁻¹ x * gaussSum χ ψ := by
  by_cases hx : x = 0
  · subst x
    have he : ψ.mulShift (0 : F) = 1 := by ext t; simp
    rw [he, gaussSum_one_right hχ, MulChar.map_zero, zero_mul]
  · simpa only [Units.val_mk0] using gaussSum_mulShift_eq χ ψ (Units.mk0 x hx)

/-- A sextic row becomes its quadratic third power after the reflected cubic multiplier. -/
theorem finiteReflectionGauss_sextic {F : Type*} [Field F] [Fintype F]
    (χ : MulChar F ℂ) (ψ : AddChar F ℂ) (hχ : χ ^ 6 = 1) (hχ3 : χ ^ 3 ≠ 1) (x : F) :
    finiteReflectionGauss χ ψ 1 x =
      ((Fintype.card F : ℂ)⁻¹ * gaussSum χ (ψ.mulShift (-1)) * gaussSum (χ ^ 3) ψ) * (χ ^ 3) x := by
  have hinv : (χ ^ 3)⁻¹ = χ ^ 3 := by
    apply inv_eq_of_mul_eq_one_right
    simpa only [← pow_add] using hχ
  rw [finiteReflectionGauss_product, pow_one, show 1 + 2 = 3 from rfl,
    finiteGauss_mulShift_all _ _ hχ3, hinv]
  ring

/-- The exceptional fourth-power row has a distinct zero-frequency contribution. -/
theorem finiteReflectionGauss_fourth {F : Type*} [Field F] [Fintype F]
    (χ : MulChar F ℂ) (ψ : AddChar F ℂ) (hχ : χ ^ 6 = 1) (hψ : ψ.IsPrimitive) (x : F) :
    finiteReflectionGauss χ ψ 4 x =
      ((Fintype.card F : ℂ)⁻¹ * gaussSum (χ ^ 4) (ψ.mulShift (-1))) *
        (if x = 0 then (Nat.card Fˣ : ℂ) else -1) := by
  rw [finiteReflectionGauss_product, show 4 + 2 = 6 from rfl, hχ]
  by_cases hx : x = 0
  · subst x
    have he : ψ.mulShift (0 : F) = 1 := by ext t; simp
    rw [he, gaussSum_one_one, if_pos rfl]
  · rw [gaussSum_one_left (hψ hx), if_neg hx]

lemma finiteReflectionGauss_phase_norm {F : Type*} [Field F] [Fintype F]
    (χ : MulChar F ℂ) (ψ : AddChar F ℂ) (hψ : ψ.IsPrimitive) (j : ℕ)
    (hj : χ ^ j ≠ 1) (hj2 : χ ^ (j + 2) ≠ 1) :
    ‖(Fintype.card F : ℂ)⁻¹ * gaussSum (χ ^ j) (ψ.mulShift (-1)) * gaussSum (χ ^ (j + 2)) ψ‖ = 1 := by
  have hneg : (ψ.mulShift (-1)).IsPrimitive := by
    intro a ha
    rw [AddChar.mulShift_mulShift]
    exact hψ (mul_ne_zero (neg_ne_zero.mpr one_ne_zero) ha)
  have hnorm (χ₀ : MulChar F ℂ) (ψ₀ : AddChar F ℂ) (hc : χ₀ ≠ 1) (hp : ψ₀.IsPrimitive) :
      ‖gaussSum χ₀ ψ₀‖ ^ 2 = (Fintype.card F : ℝ) := by
    rw [← Complex.normSq_eq_norm_sq, ArithmeticEffectivityTheory.normSq_gaussSum_eq_card hc hp]
  have hq : (Fintype.card F : ℝ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  apply (sq_eq_sq₀ (norm_nonneg _) zero_le_one).mp
  simp only [norm_mul, norm_inv, Complex.norm_natCast, mul_pow, one_pow,
    hnorm _ _ hj hneg, hnorm _ _ hj2 hψ]
  field_simp

/-- The reflected sextic row is exactly a unit phase times the actual quadratic residue character. -/
theorem finiteReflectionGauss_actual_quadratic
    (P : Ideal O) [P.IsMaximal] (hg : lambda ∉ P)
    (hchar : ringChar (O ⧸ P) ≠ 2) (ψ : AddChar (O ⧸ P) ℂ) (hψ : ψ.IsPrimitive) :
    ∃ ε : ℂ, ‖ε‖ = 1 ∧ ∀ x : O ⧸ P,
      finiteReflectionGauss (complexSexticChar P hg) ψ 1 x = ε * complexQuadraticChar P x := by
  have hp := complexSexticChar_powers P hg
  have hq : complexSexticChar P hg ^ 3 ≠ 1 := by
    rw [hp.2.1]
    exact complexQuadraticChar_ne_one P hchar
  refine ⟨(Fintype.card (O ⧸ P) : ℂ)⁻¹ * gaussSum (complexSexticChar P hg) (ψ.mulShift (-1)) *
    gaussSum (complexSexticChar P hg ^ 3) ψ, ?_, ?_⟩
  · simpa only [pow_one, show 1 + 2 = 3 from rfl] using
      finiteReflectionGauss_phase_norm (complexSexticChar P hg) ψ hψ 1
        (by simpa only [pow_one] using complexSexticChar_ne_one P hg) hq
  · intro x
    rw [finiteReflectionGauss_sextic _ _ hp.2.2 hq, hp.2.1]

/-- The exceptional row separates into a divisibility term and its exact constant correction. -/
theorem finiteReflectionGauss_fourth_indicator {F : Type*} [Field F] [Fintype F]
    (χ : MulChar F ℂ) (ψ : AddChar F ℂ) (hχ : χ ^ 6 = 1) (hψ : ψ.IsPrimitive) (x : F) :
    finiteReflectionGauss χ ψ 4 x =
      ((Fintype.card F : ℂ)⁻¹ * gaussSum (χ ^ 4) (ψ.mulShift (-1))) *
        ((if x = 0 then (Fintype.card F : ℂ) else 0) - 1) := by
  classical
  have hcard : (Nat.card Fˣ : ℂ) = (Fintype.card F : ℂ) - 1 := by
    rw [Nat.card_eq_fintype_card, Fintype.card_units,
      Nat.cast_sub (Nat.succ_le_of_lt Fintype.card_pos), Nat.cast_one]
  rw [finiteReflectionGauss_fourth χ ψ hχ hψ]
  by_cases hx : x = 0
  · simp only [if_pos hx, hcard]
  · simp only [if_neg hx, zero_sub]

/-- Independent local reflected rows factor without discarding their phases or exceptional terms. -/
theorem finiteReflectionGauss_product_family
    {ι : Type*} [Fintype ι] {F : ι → Type*} [∀ i, Field (F i)] [∀ i, Fintype (F i)]
    (χ : ∀ i, MulChar (F i) ℂ) (ψ : ∀ i, AddChar (F i) ℂ) (j : ι → ℕ) (x : ∀ i, F i) :
    (∑ h : ∀ i, (F i)ˣ, ∏ i,
      finiteAdditiveFourierCoeff (ψ i) (χ i ^ j i : MulChar (F i) ℂ) (h i : F i) * ((χ i)⁻¹ ^ 2) (h i) *
        ψ i (x i * (((h i)⁻¹ : (F i)ˣ) : F i))) =
      ∏ i, ((Fintype.card (F i) : ℂ)⁻¹ * gaussSum (χ i ^ j i) ((ψ i).mulShift (-1)) *
        gaussSum (χ i ^ (j i + 2)) ((ψ i).mulShift (x i))) := by
  classical
  let f := fun (i : ι) (h : (F i)ˣ) =>
    finiteAdditiveFourierCoeff (ψ i) (χ i ^ j i : MulChar (F i) ℂ) (h : F i) *
      ((χ i)⁻¹ ^ 2) h * ψ i (x i * ((h⁻¹ : (F i)ˣ) : F i))
  change (∑ h : ∀ i, (F i)ˣ, ∏ i, f i (h i)) = _
  rw [← Fintype.prod_sum f]
  apply Finset.prod_congr rfl
  intro i hi
  exact finiteReflectionGauss_product (χ i) (ψ i) (j i) (x i)

/-- At good primes the full product reflection is a unit phase times the quadratic row. -/
theorem finiteReflectionGauss_actual_quadratic_family
    {ι : Type*} [Fintype ι] (P : ι → Ideal O) [∀ i, (P i).IsMaximal]
    (hg : ∀ i, lambda ∉ P i) (hchar : ∀ i, ringChar (O ⧸ P i) ≠ 2)
    (ψ : ∀ i, AddChar (O ⧸ P i) ℂ) (hψ : ∀ i, (ψ i).IsPrimitive) :
    ∃ ε : ℂ, ‖ε‖ = 1 ∧ ∀ x : ∀ i, O ⧸ P i,
      (∑ h : ∀ i, (O ⧸ P i)ˣ, ∏ i,
        finiteAdditiveFourierCoeff (ψ i) (complexSexticChar (P i) (hg i)) (h i : O ⧸ P i) *
          ((complexSexticChar (P i) (hg i))⁻¹ ^ 2) (h i) *
          ψ i (x i * (((h i)⁻¹ : (O ⧸ P i)ˣ) : O ⧸ P i))) =
      ε * ∏ i, complexQuadraticChar (P i) (x i) := by
  classical
  choose ε hε he using fun i => finiteReflectionGauss_actual_quadratic (P i) (hg i) (hchar i) (ψ i) (hψ i)
  refine ⟨∏ i, ε i, by simp only [norm_prod, hε, Finset.prod_const_one], ?_⟩
  intro x
  let f := fun (i : ι) (h : (O ⧸ P i)ˣ) =>
    finiteAdditiveFourierCoeff (ψ i) (complexSexticChar (P i) (hg i)) (h : O ⧸ P i) *
      ((complexSexticChar (P i) (hg i))⁻¹ ^ 2) h *
      ψ i (x i * ((h⁻¹ : (O ⧸ P i)ˣ) : O ⧸ P i))
  change (∑ h : ∀ i, (O ⧸ P i)ˣ, ∏ i, f i (h i)) = _
  rw [← Fintype.prod_sum f, ← Finset.prod_mul_distrib]
  apply Finset.prod_congr rfl
  intro i hi
  simpa only [finiteReflectionGauss, pow_one, f] using he i (x i)


/-- Reciprocity separates a fixed denominator factor from a moving primary factor. -/
lemma cuspSymbol_principal_factor (a c r : O)
    (ha : lambda ^ 2 ∣ a - 1) (hr : lambda ^ 2 ∣ r - 1) :
    symbol (c * r) a = symbol c a * symbol a r := by
  rw [symbol_mul_numerator, symbol_reciprocity r a hr ha]

/-- The determinant relation separates the ramified cusp multiplier without division by symbols. -/
lemma cuspSymbol_ramified (a b c d u : O)
    (hdet : a * d - b * (u * c) = 1)
    (ha : lambda ^ 2 ∣ a - 1) (hA : lambda ^ 2 ∣ (a - u * b) - 1) :
    symbol (u * c - u * d) (a - u * b) = symbol (-u) (a - u * b) * symbol c a := by
  have h1 : symbol a (a - u * b) * symbol (u * c - u * d) (a - u * b) =
      symbol (-u) (a - u * b) := by
    rw [← symbol_mul_numerator]
    apply symbol_congr
    refine ⟨u * c, ?_⟩
    linear_combination -u * hdet
  have h2 : symbol (a - u * b) a * symbol c a = 1 := by
    rw [← symbol_mul_numerator, ← symbol_one_numerator a ha]
    apply symbol_congr
    refine ⟨c - d, ?_⟩
    linear_combination hdet
  rw [symbol_reciprocity a (a - u * b) ha hA] at h1
  calc
    _ = (symbol (a - u * b) a * symbol c a) * symbol (u * c - u * d) (a - u * b) := by rw [h2, one_mul]
    _ = (symbol (a - u * b) a * symbol (u * c - u * d) (a - u * b)) * symbol c a := by ring
    _ = _ := by rw [h1]

lemma cuspSymbol_ramified_factor (a b c r d u : O)
    (hdet : a * d - b * (u * (c * r)) = 1)
    (ha : lambda ^ 2 ∣ a - 1) (hA : lambda ^ 2 ∣ (a - u * b) - 1)
    (hr : lambda ^ 2 ∣ r - 1) :
    symbol (u * (c * r) - u * d) (a - u * b) =
      (symbol (-u) (a - u * b) * symbol c a) * symbol a r := by
  rw [cuspSymbol_ramified a b (c * r) d u hdet ha hA, cuspSymbol_principal_factor a c r ha hr]
  ring

/-- In the Weyl chart, denominator congruence supplies the exact global cubic factor. -/
lemma cuspSymbol_weyl (a b c d : O) (hdet : a * d - b * c = 1)
    (hb : lambda ^ 2 ∣ (-b) - 1) (hc : lambda ^ 2 ∣ c - 1) (h9 : (9 : O) ∣ a * d) :
    symbol (-d) (-b) = symbol a c := by
  have hp : lambda ^ 2 ∣ (-b) * c - 1 := primary_mul (-b) c hb hc
  have hprod : symbol d (-b) * symbol d c = 1 := by
    rw [← symbol_mul_denominator]
    have hnine : (9 : O) ∣ (-b) * c - 1 := by
      convert dvd_neg.mpr h9 using 1
      linear_combination hdet
    have hd : d ∣ (-b) * c - 1 := by
      refine ⟨-a, ?_⟩
      linear_combination hdet
    rw [symbol_denominator_congr d ((-b) * c) 1 hp (by simp) hnine hd, symbol_one]
  have hother : symbol a c * symbol d c = 1 := by
    rw [← symbol_mul_numerator, ← symbol_one_numerator c hc]
    apply symbol_congr
    refine ⟨b, ?_⟩
    linear_combination hdet
  rw [symbol_neg_numerator _ _ hb]
  calc
    symbol d (-b) = symbol d (-b) * (symbol a c * symbol d c) := by rw [hother, mul_one]
    _ = (symbol d (-b) * symbol d c) * symbol a c := by ring
    _ = _ := by rw [hprod, one_mul]

lemma cuspSymbol_weyl_factor (a b c r d : O) (hdet : a * d - b * (c * r) = 1)
    (hb : lambda ^ 2 ∣ (-b) - 1) (hc : lambda ^ 2 ∣ c * r - 1) (h9 : (9 : O) ∣ a * d) :
    symbol (-d) (-b) = symbol a c * symbol a r := by
  rw [cuspSymbol_weyl a b (c * r) d hdet hb hc h9, symbol_mul_denominator]

/-- The ramified fixed factor is constant on a fixed matrix residue class. -/
lemma cuspSymbol_ramified_fixed_congr (N c u a a₀ b b₀ : O)
    (h9 : (9 : O) ∣ N) (hc : c ∣ N) (hu : u ∣ N)
    (ha : lambda ^ 2 ∣ a - 1) (ha₀ : lambda ^ 2 ∣ a₀ - 1)
    (hA : lambda ^ 2 ∣ a - u * b - 1) (hA₀ : lambda ^ 2 ∣ a₀ - u * b₀ - 1)
    (hNa : N ∣ a - a₀) (hNb : N ∣ b - b₀) :
    symbol (-u) (a - u * b) * symbol c a =
      symbol (-u) (a₀ - u * b₀) * symbol c a₀ := by
  have hdiff : N ∣ (a - u * b) - (a₀ - u * b₀) := by
    convert dvd_sub hNa (dvd_mul_of_dvd_right hNb u) using 1
    ring
  rw [symbol_denominator_congr (-u) (a - u * b) (a₀ - u * b₀) hA hA₀
      (h9.trans hdiff) (neg_dvd.mpr (hu.trans hdiff)),
    symbol_denominator_congr c a a₀ ha ha₀ (h9.trans hNa) (hc.trans hNa)]

lemma cuspSymbol_weyl_fixed_congr (N c a a₀ : O) (hc : c ∣ N) (hNa : N ∣ a - a₀) :
    symbol a c = symbol a₀ c := symbol_congr (hc.trans hNa)

lemma norm_cuspSymbol_of_coprime (a c : O) (hc : lambda ^ 2 ∣ c - 1) (hcop : IsCoprime a c) :
    ‖ringComplex (symbol a c)‖ = 1 := by
  have hcube : ringComplex (symbol a c) ^ 3 = 1 := by
    rw [← map_pow, symbol_cube_of_isCoprime a c hc hcop, map_one]
  apply (pow_eq_one_iff_of_nonneg (norm_nonneg _) (by decide : (3 : ℕ) ≠ 0)).mp
  simpa only [norm_pow, norm_one] using congrArg norm hcube

lemma cuspSymbol_principal_fixed_norm (a b c r d : O)
    (hdet : a * d - b * (c * r) = 1) (ha : lambda ^ 2 ∣ a - 1) :
    ‖ringComplex (symbol c a)‖ = 1 := by
  apply norm_cuspSymbol_of_coprime c a ha
  refine ⟨-b * r, d, ?_⟩
  linear_combination hdet

lemma cuspSymbol_weyl_fixed_norm (a b c r d : O)
    (hdet : a * d - b * (c * r) = 1) (hc : lambda ^ 2 ∣ c - 1) :
    ‖ringComplex (symbol a c)‖ = 1 := by
  apply norm_cuspSymbol_of_coprime a c hc
  refine ⟨d, -b * r, ?_⟩
  linear_combination hdet

lemma cuspSymbol_ramified_fixed_norm (a b c r d u : O)
    (hdet : a * d - b * (u * (c * r)) = 1)
    (ha : lambda ^ 2 ∣ a - 1) (hA : lambda ^ 2 ∣ a - u * b - 1) :
    ‖ringComplex (symbol (-u) (a - u * b) * symbol c a)‖ = 1 := by
  have hfirst : ‖ringComplex (symbol (-u) (a - u * b))‖ = 1 := by
    apply norm_cuspSymbol_of_coprime _ _ hA
    refine ⟨b * (c * r - d), d, ?_⟩
    linear_combination hdet
  have hsecond : ‖ringComplex (symbol c a)‖ = 1 := by
    apply norm_cuspSymbol_of_coprime _ _ ha
    refine ⟨-b * u * r, d, ?_⟩
    linear_combination hdet
  rw [map_mul, norm_mul, hfirst, hsecond, one_mul]

lemma fixedCuspSector_eq_of_relative (M N : SL(2, O)) (h : M * N⁻¹ ∈ levelThree) :
    fixedCuspSector M = fixedCuspSector N := by
  apply Subtype.ext
  change fixedCuspReduction M = fixedCuspReduction N
  have he : fixedCuspReduction (M * N⁻¹) = 1 := h
  rw [map_mul, map_inv] at he
  exact mul_inv_eq_one.mp he

/-- Within one matrix residue class, all varying automorphy is carried by the relative cubic character. -/
lemma fixedCuspGamma_character_relative (M N : SL(2, O)) (h : M * N⁻¹ ∈ levelThree) :
    extendedComplexCharacter (fixedCuspGamma M) =
      complexCharacter ⟨M * N⁻¹, h⟩ * extendedComplexCharacter (fixedCuspGamma N) := by
  have hs := fixedCuspSector_eq_of_relative M N h
  let D : levelThree := ⟨M * N⁻¹, h⟩
  let E : rationalExtension := ⟨(D : SL(2, O)), levelThree_le_rationalExtension D.property⟩
  have he : fixedCuspGamma M = E * fixedCuspGamma N := by
    apply Subtype.ext
    change (fixedCuspGamma M : SL(2, O)) = (M * N⁻¹) * (fixedCuspGamma N : SL(2, O))
    have hm := fixedCusp_factorization M
    rw [hs] at hm
    have hn := fixedCusp_factorization N
    let g : SL(2, O) := fixedCuspGamma M
    let k : SL(2, O) := fixedCuspGamma N
    let T : SL(2, O) := cuspRepresentative (fixedCuspIndex (fixedCuspSector N)) *
      fixedCuspTriangular (fixedCuspSector N)
    have hm' : M = g * T := by simpa only [mul_assoc] using hm
    have hn' : N = k * T := by simpa only [mul_assoc] using hn
    change g = (M * N⁻¹) * k
    rw [hm', hn']
    group
  rw [he, map_mul, extendedComplexCharacter_restrict]

/-- The Weyl cusp chart with integral horizontal coordinate. -/
def weylCuspMatrix (u : O) : SL(2, O) := ⟨!![u, -1; 1, 0], by simp [Matrix.det_fin_two]⟩

lemma lowerCusp_relative_matrix (M : SL(2, O)) (u : O) :
    ((M * (lowerCuspMatrix u)⁻¹ : SL(2, O)) : Matrix (Fin 2) (Fin 2) O) =
      !![M 0 0 - u * M 0 1, M 0 1; M 1 0 - u * M 1 1, M 1 1] := by
  rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_inv]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [lowerCuspMatrix, Matrix.adjugate_fin_two, Matrix.mul_apply, Fin.sum_univ_two] <;> ring

lemma weylCusp_relative_matrix (M : SL(2, O)) (u : O) :
    ((M * (weylCuspMatrix u)⁻¹ : SL(2, O)) : Matrix (Fin 2) (Fin 2) O) =
      !![-M 0 1, M 0 0 + u * M 0 1; -M 1 1, M 1 0 + u * M 1 1] := by
  rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_inv]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [weylCuspMatrix, Matrix.adjugate_fin_two, Matrix.mul_apply, Fin.sum_univ_two] <;> ring

lemma lowerCusp_relative_character (M : SL(2, O)) (u : O)
    (h : M * (lowerCuspMatrix u)⁻¹ ∈ levelThree) :
    complexCharacter ⟨M * (lowerCuspMatrix u)⁻¹, h⟩ =
      ringComplex (symbol (M 1 0 - u * M 1 1) (M 0 0 - u * M 0 1)) := by
  change ringComplex (symbol
    (((M * (lowerCuspMatrix u)⁻¹ : SL(2, O)) : Matrix (Fin 2) (Fin 2) O) 1 0)
    (((M * (lowerCuspMatrix u)⁻¹ : SL(2, O)) : Matrix (Fin 2) (Fin 2) O) 0 0)) = _
  rw [lowerCusp_relative_matrix]
  rfl

lemma weylCusp_relative_character (M : SL(2, O)) (u : O)
    (h : M * (weylCuspMatrix u)⁻¹ ∈ levelThree) :
    complexCharacter ⟨M * (weylCuspMatrix u)⁻¹, h⟩ = ringComplex (symbol (-M 1 1) (-M 0 1)) := by
  change ringComplex (symbol
    (((M * (weylCuspMatrix u)⁻¹ : SL(2, O)) : Matrix (Fin 2) (Fin 2) O) 1 0)
    (((M * (weylCuspMatrix u)⁻¹ : SL(2, O)) : Matrix (Fin 2) (Fin 2) O) 0 0)) = _
  rw [weylCusp_relative_matrix]
  rfl

lemma lowerCusp_relative_primary (M : SL(2, O)) (u : O)
    (h : M * (lowerCuspMatrix u)⁻¹ ∈ levelThree) :
    lambda ^ 2 ∣ (M 0 0 - u * M 0 1) - 1 := by
  have hp := levelThree_primary ⟨M * (lowerCuspMatrix u)⁻¹, h⟩
  change lambda ^ 2 ∣ (((M * (lowerCuspMatrix u)⁻¹ : SL(2, O)) : Matrix (Fin 2) (Fin 2) O) 0 0) - 1 at hp
  rw [lowerCusp_relative_matrix] at hp
  exact hp

/-- The ramified cusp character is a fixed factor times the moving cubic row. -/
theorem fixedCuspGamma_ramified_factor (M : SL(2, O)) (u c r : O)
    (h : M * (lowerCuspMatrix u)⁻¹ ∈ levelThree)
    (ha : lambda ^ 2 ∣ M 0 0 - 1) (hr : lambda ^ 2 ∣ r - 1)
    (hC : M 1 0 = u * (c * r)) :
    extendedComplexCharacter (fixedCuspGamma M) =
      (ringComplex (symbol (-u) (M 0 0 - u * M 0 1) * symbol c (M 0 0)) *
        extendedComplexCharacter (fixedCuspGamma (lowerCuspMatrix u))) *
      ringComplex (symbol (M 0 0) r) := by
  have hdet : M 0 0 * M 1 1 - M 0 1 * (u * (c * r)) = 1 := by
    simpa only [Matrix.det_fin_two, hC] using M.property
  rw [fixedCuspGamma_character_relative M (lowerCuspMatrix u) h, lowerCusp_relative_character, hC,
    cuspSymbol_ramified_factor _ _ _ _ _ _ hdet ha (lowerCusp_relative_primary M u h) hr, map_mul]
  ring

/-- The Weyl cusp character is a fixed factor times the moving cubic row. -/
theorem fixedCuspGamma_weyl_factor (M : SL(2, O)) (u c r : O)
    (h : M * (weylCuspMatrix u)⁻¹ ∈ levelThree)
    (hc : lambda ^ 2 ∣ M 1 0 - 1) (h9 : (9 : O) ∣ M 0 0 * M 1 1)
    (hC : M 1 0 = c * r) :
    extendedComplexCharacter (fixedCuspGamma M) =
      (ringComplex (symbol (M 0 0) c) * extendedComplexCharacter (fixedCuspGamma (weylCuspMatrix u))) *
        ringComplex (symbol (M 0 0) r) := by
  have hb := levelThree_primary ⟨M * (weylCuspMatrix u)⁻¹, h⟩
  change lambda ^ 2 ∣ (((M * (weylCuspMatrix u)⁻¹ : SL(2, O)) : Matrix (Fin 2) (Fin 2) O) 0 0) - 1 at hb
  rw [weylCusp_relative_matrix] at hb
  change lambda ^ 2 ∣ -M 0 1 - 1 at hb
  have hdet : M 0 0 * M 1 1 - M 0 1 * (c * r) = 1 := by
    simpa only [Matrix.det_fin_two, hC] using M.property
  rw [hC] at hc
  rw [fixedCuspGamma_character_relative M (weylCuspMatrix u) h, weylCusp_relative_character,
    cuspSymbol_weyl_factor _ _ _ _ _ hdet hb hc h9, map_mul]
  ring


/-- A primary numerator admits a determinant-one completion whose upper-right entry is divisible by nine. -/
lemma exists_primary_numerator_matrix (a c : O) (hac : IsCoprime a c)
    (ha : lambda ^ 2 ∣ a - 1) :
    ∃ M : SL(2, O), M 0 0 = a ∧ M 1 0 = c ∧ (9 : O) ∣ M 0 1 ∧ (3 : O) ∣ M 1 1 - 1 := by
  have ha3 := primary_coprime_three a ha
  have ha9 : IsCoprime a (9 : O) := by
    simpa only [show (3 : O) * 3 = 9 from by norm_num] using ha3.mul_right ha3
  obtain ⟨d, t, ht⟩ := ha9.mul_right hac
  have hdet : a * d - (-9 * t) * c = 1 := by linear_combination ht
  let M : SL(2, O) := ⟨!![a, -9 * t; c, d], by rw [Matrix.det_fin_two]; exact hdet⟩
  refine ⟨M, rfl, rfl, ⟨-t, by change -9 * t = 9 * (-t); ring⟩, ?_⟩
  have hb : (3 : O) ∣ -9 * t := ⟨-3 * t, by ring⟩
  change (3 : O) ∣ d - 1
  convert dvd_sub (dvd_mul_of_dvd_left hb c)
    (dvd_mul_of_dvd_left (three_dvd_primary_sub_one a ha) d) using 1
  linear_combination hdet

/-- A primary denominator admits a determinant-one completion whose lower-right entry is divisible by nine. -/
lemma exists_primary_denominator_matrix (a c : O) (hac : IsCoprime a c)
    (hc : lambda ^ 2 ∣ c - 1) :
    ∃ M : SL(2, O), M 0 0 = a ∧ M 1 0 = c ∧ (3 : O) ∣ M 0 1 + 1 ∧ (9 : O) ∣ M 1 1 := by
  have hc3 := primary_coprime_three c hc
  have hc9 : IsCoprime c (9 : O) := by
    simpa only [show (3 : O) * 3 = 9 from by norm_num] using hc3.mul_right hc3
  obtain ⟨y, x, ht⟩ := hc9.mul_right hac.symm
  have hdet : a * (9 * x) - (-y) * c = 1 := by linear_combination ht
  let M : SL(2, O) := ⟨!![a, -y; c, 9 * x], by rw [Matrix.det_fin_two]; exact hdet⟩
  refine ⟨M, rfl, rfl, ?_, ⟨x, rfl⟩⟩
  have hd : (3 : O) ∣ 9 * x := ⟨3 * x, by ring⟩
  change (3 : O) ∣ -y + 1
  convert dvd_sub (dvd_mul_of_dvd_right hd a)
    (dvd_mul_of_dvd_right (three_dvd_primary_sub_one c hc) (-y)) using 1
  linear_combination -hdet

/-- Primitive columns congruent modulo a fixed modulus admit completions in one matrix residue class. -/
lemma exists_fixed_matrix_family {ι : Type*} (i₀ : ι) (a : ι → O) (c N : O)
    (hac : ∀ i, IsCoprime (a i) c) (ha : ∀ i, N ∣ a i - a i₀)
    (M₀ : SL(2, O)) (hM₀a : M₀ 0 0 = a i₀) (hM₀c : M₀ 1 0 = c) :
    ∃ M : ι → SL(2, O), (∀ i, M i 0 0 = a i) ∧ (∀ i, M i 1 0 = c) ∧
      (∀ i r s, N ∣ M i r s - M₀ r s) ∧ ∀ i r s, N ∣ M i r s - M i₀ r s := by
  have hex (i : ι) := primitiveColumn_congruent_completion M₀ (a i) c N (hac i)
    (by simpa only [hM₀a] using ha i) (by simp only [hM₀c, sub_self, dvd_zero])
  choose M hMa hMc hMM using hex
  refine ⟨M, hMa, hMc, hMM, ?_⟩
  intro i r s
  convert dvd_sub (hMM i r s) (hMM i₀ r s) using 1
  ring

lemma primary_numerator_matrix_relative (M : SL(2, O)) (u : O)
    (ha : lambda ^ 2 ∣ M 0 0 - 1) (hb : (9 : O) ∣ M 0 1)
    (hc : (3 : O) ∣ M 1 0 - u) (hd : (3 : O) ∣ M 1 1 - 1) :
    M * (lowerCuspMatrix u)⁻¹ ∈ levelThree := by
  apply integralMatrix_congruent_levelThree
  intro i j
  fin_cases i <;> fin_cases j
  · simpa [lowerCuspMatrix] using three_dvd_primary_sub_one (M 0 0) ha
  · simpa [lowerCuspMatrix] using
      (show (3 : O) ∣ 9 from ⟨3, by norm_num⟩).trans hb
  · simpa [lowerCuspMatrix] using hc
  · simpa [lowerCuspMatrix] using hd

lemma primary_denominator_matrix_relative (M : SL(2, O)) (u : O)
    (ha : (3 : O) ∣ M 0 0 - u) (hb : (3 : O) ∣ M 0 1 + 1)
    (hc : lambda ^ 2 ∣ M 1 0 - 1) (hd : (9 : O) ∣ M 1 1) :
    M * (weylCuspMatrix u)⁻¹ ∈ levelThree := by
  apply integralMatrix_congruent_levelThree
  intro i j
  fin_cases i <;> fin_cases j
  · simpa [weylCuspMatrix] using ha
  · simpa [weylCuspMatrix] using hb
  · simpa [weylCuspMatrix] using three_dvd_primary_sub_one (M 1 0) hc
  · simpa [weylCuspMatrix] using
      (show (3 : O) ∣ 9 from ⟨3, by norm_num⟩).trans hd

/-- Unit frequencies on an active prime set, extended by zero elsewhere. -/
def assembleUnitFrequencies {ι : Type*} {F : ι → Type*} [∀ i, Field (F i)]
    (s : Finset ι) (u : ∀ i : s, (F i.val)ˣ) (i : ι) : F i := by
  classical
  exact if hi : i ∈ s then (u ⟨i, hi⟩ : F i) else 0

lemma assembleUnitFrequencies_ne_zero_iff {ι : Type*} {F : ι → Type*} [∀ i, Field (F i)]
    (s : Finset ι) (u : ∀ i : s, (F i.val)ˣ) (i : ι) :
    assembleUnitFrequencies s u i ≠ 0 ↔ i ∈ s := by
  classical
  by_cases hi : i ∈ s
  · simp only [assembleUnitFrequencies, hi, dite_true, iff_true]
    exact (u ⟨i, hi⟩).ne_zero
  · simp [assembleUnitFrequencies, hi]

lemma assembleUnitFrequencies_bijective {ι : Type*} [Fintype ι]
    {F : ι → Type*} [∀ i, Field (F i)] :
    Function.Bijective (fun v : Σ s : Finset ι, ∀ i : s, (F i.val)ˣ => assembleUnitFrequencies v.1 v.2) := by
  classical
  constructor
  · rintro ⟨s, u⟩ ⟨t, v⟩ he
    have hst : s = t := by
      apply Finset.ext
      intro i
      rw [← assembleUnitFrequencies_ne_zero_iff s u i, ← assembleUnitFrequencies_ne_zero_iff t v i]
      exact Iff.of_eq (congrArg (fun f : ∀ i, F i => f i ≠ 0) he)
    subst t
    have huv : u = v := by
      funext i
      apply Units.ext
      have h := congrFun he i.val
      simpa only [assembleUnitFrequencies, dif_pos i.property] using h
    subst v
    rfl
  · intro f
    let s : Finset ι := Finset.univ.filter (fun i => f i ≠ 0)
    let u : ∀ i : s, (F i.val)ˣ := fun i => Units.mk0 (f i.val) (Finset.mem_filter.mp i.property).2
    refine ⟨⟨s, u⟩, ?_⟩
    funext i
    by_cases hi : f i = 0
    · simp [assembleUnitFrequencies, s, hi]
    · have his : i ∈ s := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩
      simp only [assembleUnitFrequencies, dif_pos his, u, Units.val_mk0]

/-- Every finite frequency sum splits exactly into active unit-frequency strata. -/
theorem finite_frequency_sum_strata {ι : Type*} [Fintype ι]
    {F : ι → Type*} [∀ i, Field (F i)] [∀ i, Fintype (F i)] (A : (∀ i, F i) → ℂ) :
    (∑ x : ∀ i, F i, A x) =
      ∑ s : Finset ι, ∑ u : ∀ i : s, (F i.val)ˣ, A (assembleUnitFrequencies s u) := by
  classical
  let e : (Σ s : Finset ι, ∀ i : s, (F i.val)ˣ) ≃ (∀ i, F i) :=
    Equiv.ofBijective _ assembleUnitFrequencies_bijective
  have he := Fintype.sum_equiv e (fun v => A (assembleUnitFrequencies v.1 v.2)) A (fun _ => rfl)
  rw [Fintype.sum_sigma] at he
  exact he.symm

/-- Inactive frequencies vanish for nontrivial multiplicative characters. -/
lemma finiteAdditiveFourierCoeff_mulChar_zero {F : Type*} [Field F] [Fintype F]
    (χ : MulChar F ℂ) (ψ : AddChar F ℂ) :
    finiteAdditiveFourierCoeff ψ χ 0 =
      if χ = 1 then (Nat.card Fˣ : ℂ) / (Fintype.card F : ℂ) else 0 := by
  classical
  have he : (∑ x : F, χ x * ψ (-(0 : F) * x)) = gaussSum χ (1 : AddChar F ℂ) := by
    simp only [neg_zero, zero_mul, AddChar.map_zero_eq_one, mul_one, gaussSum, AddChar.one_apply]
  rw [finiteAdditiveFourierCoeff, he]
  by_cases hχ : χ = 1
  · rw [if_pos hχ, hχ, gaussSum_one_one]
  · rw [if_neg hχ, gaussSum_one_right hχ, zero_div]

/-- A stratum vanishes if it omits a prime carrying a nontrivial row character. -/
lemma finite_frequency_stratum_vanishes {ι : Type*} [Fintype ι]
    {F : ι → Type*} [∀ i, Field (F i)] [∀ i, Fintype (F i)]
    (χ : ∀ i, MulChar (F i) ℂ) (ψ : ∀ i, AddChar (F i) ℂ)
    (s : Finset ι) (u : ∀ i : s, (F i.val)ˣ) (k : ι) (hk : k ∉ s) (hχ : χ k ≠ 1) :
    (∏ i, finiteAdditiveFourierCoeff (ψ i) (χ i) (assembleUnitFrequencies s u i)) = 0 := by
  classical
  apply Finset.prod_eq_zero (Finset.mem_univ k)
  rw [assembleUnitFrequencies, dif_neg hk, finiteAdditiveFourierCoeff_mulChar_zero, if_neg hχ]

/-- A residue unit has a lift divisible by the square of any coprime fixed modulus. -/
lemma exists_unit_frequency_lift (N p : O) (hNp : IsCoprime N p)
    (v : (O ⧸ Ideal.span {p})ˣ) :
    ∃ t : O, N ^ 2 ∣ t ∧ Ideal.Quotient.mk (Ideal.span {p}) t = (v : O ⧸ Ideal.span {p}) ∧
      IsCoprime t p := by
  have hN2 : IsCoprime (N ^ 2) p := by simpa only [pow_two] using hNp.mul_left hNp
  obtain ⟨a, b, hab⟩ := hN2
  let x : O := Quotient.out (v : O ⧸ Ideal.span {p})
  let t : O := N ^ 2 * a * x
  have hd : p ∣ t - x := by
    refine ⟨-b * x, ?_⟩
    dsimp only [t]
    linear_combination x * hab
  have he : Ideal.Quotient.mk (Ideal.span {p}) t = (v : O ⧸ Ideal.span {p}) :=
    (Ideal.Quotient.eq.mpr (Ideal.mem_span_singleton.mpr hd)).trans (Ideal.Quotient.mk_out _)
  refine ⟨t, ⟨a * x, by dsimp only [t]; ring⟩, he, ?_⟩
  apply IsCoprime.symm
  apply (isUnit_quotient_span_iff p t).mp
  rw [he]
  exact v.isUnit

lemma cusp_isCoprime_of_dvd_sub (m a b : O) (hab : m ∣ a - b) (hb : IsCoprime m b) :
    IsCoprime m a := by
  obtain ⟨r, hr⟩ := hab
  obtain ⟨u, v, hv⟩ := hb
  refine ⟨u - v * r, v, ?_⟩
  linear_combination hv + v * hr

/-- The complementary prime product in a finite conductor. -/
def cuspPrimeCofactor {ι : Type*} [Fintype ι] (p : ι → O) (i : ι) : O := by
  classical
  exact ∏ k ∈ Finset.univ.erase i, p k

lemma cuspPrime_mul_cofactor {ι : Type*} [Fintype ι] (p : ι → O) (i : ι) :
    p i * cuspPrimeCofactor p i = ∏ k, p k := by
  classical
  exact Finset.mul_prod_erase Finset.univ p (Finset.mem_univ i)

lemma cuspPrime_dvd_other_cofactor {ι : Type*} [Fintype ι] (p : ι → O) {i k : ι} (hik : i ≠ k) :
    p i ∣ cuspPrimeCofactor p k := by
  classical
  exact Finset.dvd_prod_of_mem p (Finset.mem_erase.mpr ⟨hik, Finset.mem_univ i⟩)

/-- A common denominator for the fixed cusp and its local additive frequencies. -/
def cuspCrossNumerator {ι : Type*} [Fintype ι] (a c l : O) (p h : ι → O) : O :=
  a * (∏ i, p i) + l ^ 2 * c * ∑ i, h i * cuspPrimeCofactor p i

lemma cuspCrossNumerator_local {ι : Type*} [Fintype ι] (a c l : O) (p h : ι → O) (i : ι) :
    Ideal.Quotient.mk (Ideal.span {p i}) (cuspCrossNumerator a c l p h) =
      Ideal.Quotient.mk (Ideal.span {p i}) (l ^ 2 * c * cuspPrimeCofactor p i) *
        Ideal.Quotient.mk (Ideal.span {p i}) (h i) := by
  classical
  let q := Ideal.Quotient.mk (Ideal.span {p i})
  have hz : q (∏ k, p k) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr
    (Ideal.mem_span_singleton.mpr ⟨cuspPrimeCofactor p i, (cuspPrime_mul_cofactor p i).symm⟩)
  have hs : (∑ k, q (h k) * q (cuspPrimeCofactor p k)) = q (h i) * q (cuspPrimeCofactor p i) := by
    apply Finset.sum_eq_single i
    · intro k hk hki
      have hk0 : q (cuspPrimeCofactor p k) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr
        (Ideal.mem_span_singleton.mpr (cuspPrime_dvd_other_cofactor p hki.symm))
      rw [hk0, mul_zero]
    · intro hi
      exact False.elim (hi (Finset.mem_univ i))
  change q (cuspCrossNumerator a c l p h) = q (l ^ 2 * c * cuspPrimeCofactor p i) * q (h i)
  simp only [cuspCrossNumerator, map_add, map_mul, map_sum, map_pow, hz, mul_zero, zero_add, hs]
  ring

lemma cuspCrossNumerator_fixed {ι : Type*} [Fintype ι] (N a c l : O) (p h : ι → O)
    (hh : ∀ i, N ∣ h i) : N ∣ cuspCrossNumerator a c l p h - a * (∏ i, p i) := by
  have hs : N ∣ ∑ i, h i * cuspPrimeCofactor p i :=
    Finset.dvd_sum (fun i _ => dvd_mul_of_dvd_left (hh i) _)
  convert dvd_mul_of_dvd_right hs (l ^ 2 * c) using 1
  simp only [cuspCrossNumerator, add_sub_cancel_left]

/-- Pairwise coprime local moduli and unit frequencies produce a primitive cusp column. -/
lemma cuspCrossNumerator_coprime {ι : Type*} [Fintype ι] (a c l : O) (p h : ι → O)
    (hbase : IsCoprime a c) (hpair : Pairwise (Function.onFun IsCoprime p))
    (hc : ∀ i, IsCoprime c (p i)) (hl : ∀ i, IsCoprime l (p i))
    (hh : ∀ i, IsCoprime (h i) (p i)) :
    IsCoprime (cuspCrossNumerator a c l p h) (c * ∏ i, p i) := by
  classical
  have hmodc : c ∣ cuspCrossNumerator a c l p h - a * (∏ i, p i) := by
    refine ⟨l ^ 2 * (∑ i, h i * cuspPrimeCofactor p i), ?_⟩
    dsimp only [cuspCrossNumerator]
    ring
  have hcR : IsCoprime c (∏ i, p i) := IsCoprime.prod_right (fun i _ => hc i)
  have hca := cusp_isCoprime_of_dvd_sub c _ _ hmodc (hbase.symm.mul_right hcR)
  apply hca.symm.mul_right
  apply IsCoprime.prod_right
  intro i hi
  have hcof : IsCoprime (p i) (cuspPrimeCofactor p i) :=
    IsCoprime.prod_right (fun k hk => hpair (Ne.symm (Finset.mem_erase.mp hk).1))
  have hl2 : IsCoprime (p i) (l ^ 2) := by
    simpa only [pow_two] using (hl i).symm.mul_right (hl i).symm
  have hterm : IsCoprime (p i) (l ^ 2 * c * cuspPrimeCofactor p i * h i) :=
    ((hl2.mul_right (hc i).symm).mul_right hcof).mul_right (hh i).symm
  have he := cuspCrossNumerator_local a c l p h i
  rw [← map_mul] at he
  have hd : p i ∣ cuspCrossNumerator a c l p h - l ^ 2 * c * cuspPrimeCofactor p i * h i :=
    Ideal.mem_span_singleton.mp (Ideal.Quotient.eq.mp he)
  exact (cusp_isCoprime_of_dvd_sub (p i) _ _ hd hterm).symm


/-- Local unit frequencies admit primitive cusp matrices in a single residue class. -/
theorem exists_fixed_cusp_frequency_matrices {ι : Type*} [Fintype ι]
    (p : ι → O) (N a c l : O)
    (hpair : Pairwise (Function.onFun IsCoprime p))
    (hp : ∀ i, lambda ^ 2 ∣ p i - 1) (hNp : ∀ i, IsCoprime N (p i))
    (h9N : (9 : O) ∣ N) (hcN : c ∣ N) (hlN : l ∣ N)
    (hac : IsCoprime a c) (mode : Bool)
    (hbase : if mode then lambda ^ 2 ∣ a - 1 else lambda ^ 2 ∣ c - 1) :
    ∃ (lift : (∀ i, (O ⧸ Ideal.span {p i})ˣ) → ι → O)
      (M : (∀ i, (O ⧸ Ideal.span {p i})ˣ) → SL(2, O)),
      (∀ v i, N ^ 2 ∣ lift v i) ∧
      (∀ v i, Ideal.Quotient.mk (Ideal.span {p i}) (lift v i) = (v i : O ⧸ Ideal.span {p i})) ∧
      (∀ v, M v 0 0 = cuspCrossNumerator a c l p (lift v)) ∧
      (∀ v, M v 1 0 = c * ∏ i, p i) ∧
      (∀ v r s, N ∣ M v r s - M (fun _ => 1) r s) ∧
      (∀ v, if mode then (9 : O) ∣ M v 0 1 ∧ (3 : O) ∣ M v 1 1 - 1
        else (3 : O) ∣ M v 0 1 + 1 ∧ (9 : O) ∣ M v 1 1) := by
  classical
  have h3N : (3 : O) ∣ N := (show (3 : O) ∣ 9 from ⟨3, by norm_num⟩).trans h9N
  have hprimaryN : lambda ^ 2 ∣ N := lambda_sq_dvd_three.trans h3N
  have hr : lambda ^ 2 ∣ (∏ i, p i) - 1 :=
    primary_finset_product Finset.univ p (fun i _ => hp i)
  have hlf (v : ∀ i, (O ⧸ Ideal.span {p i})ˣ) (i : ι) :=
    exists_unit_frequency_lift N (p i) (hNp i) (v i)
  choose lift hperiod hres hcop using hlf
  let A := fun v => cuspCrossNumerator a c l p (lift v)
  have hA (v) : N ∣ A v - a * ∏ i, p i :=
    cuspCrossNumerator_fixed N a c l p (lift v)
      (fun i => (dvd_pow_self N (by decide : (2 : ℕ) ≠ 0)).trans (hperiod v i))
  have hAA (v) : N ∣ A v - A (fun _ => 1) := by
    convert dvd_sub (hA v) (hA (fun _ => 1)) using 1
    ring
  have hprimitive (v) : IsCoprime (A v) (c * ∏ i, p i) :=
    cuspCrossNumerator_coprime a c l p (lift v) hac hpair
      (fun i => (hNp i).of_isCoprime_of_dvd_left hcN)
      (fun i => (hNp i).of_isCoprime_of_dvd_left hlN) (hcop v)
  have hfirst : ∃ M₀ : SL(2, O), M₀ 0 0 = A (fun _ => 1) ∧ M₀ 1 0 = c * ∏ i, p i ∧
      (if mode then (9 : O) ∣ M₀ 0 1 ∧ (3 : O) ∣ M₀ 1 1 - 1
        else (3 : O) ∣ M₀ 0 1 + 1 ∧ (9 : O) ∣ M₀ 1 1) := by
    cases mode
    · exact exists_primary_denominator_matrix _ _ (hprimitive _) (primary_mul c _ hbase hr)
    · apply exists_primary_numerator_matrix _ _ (hprimitive _)
      convert dvd_add (hprimaryN.trans (hA (fun _ => 1))) (primary_mul a _ hbase hr) using 1
      ring
  obtain ⟨M₀, hM₀a, hM₀c, hM₀⟩ := hfirst
  obtain ⟨M, hMa, hMc, hMM₀, hMM⟩ := exists_fixed_matrix_family
    (fun _ => 1) A (c * ∏ i, p i) N hprimitive hAA M₀ hM₀a hM₀c
  refine ⟨lift, M, hperiod, hres, hMa, hMc, hMM, ?_⟩
  intro v
  cases mode
  · constructor
    · convert dvd_add (h3N.trans (hMM₀ v 0 1)) hM₀.1 using 1
      ring
    · convert dvd_add (h9N.trans (hMM₀ v 1 1)) hM₀.2 using 1
      ring
  · constructor
    · convert dvd_add (h9N.trans (hMM₀ v 0 1)) hM₀.1 using 1
      ring
    · convert dvd_add (h3N.trans (hMM₀ v 1 1)) hM₀.2 using 1
      ring

/-- A common-denominator cusp represents the sum of its local rational frequencies. -/
lemma cuspCrossNumerator_fraction {ι : Type*} [Fintype ι] (a c l : O) (p h : ι → O)
    (hc : c ≠ 0) (hp : ∀ i, p i ≠ 0) :
    ringComplex (cuspCrossNumerator a c l p h) / ringComplex (c * ∏ i, p i) =
      ringComplex a / ringComplex c + ringComplex l ^ 2 * ∑ i, ringComplex (h i) / ringComplex (p i) := by
  classical
  have hec : ringComplex c ≠ 0 := ringComplex_ne_zero hc
  have hep (i) : ringComplex (p i) ≠ 0 := ringComplex_ne_zero (hp i)
  have her : ringComplex (∏ i, p i) ≠ 0 :=
    ringComplex_ne_zero (Finset.prod_ne_zero_iff.mpr (fun i _ => hp i))
  have hterm (i) : ringComplex (h i * cuspPrimeCofactor p i) / ringComplex (∏ k, p k) =
      ringComplex (h i) / ringComplex (p i) := by
    rw [← cuspPrime_mul_cofactor p i, map_mul, map_mul]
    have hecof : ringComplex (cuspPrimeCofactor p i) ≠ 0 := by
      intro hz
      apply her
      rw [← cuspPrime_mul_cofactor p i, map_mul, hz, mul_zero]
    field_simp
  have hsum : (∑ i, ringComplex (h i) * ringComplex (cuspPrimeCofactor p i)) =
      (∑ i, ringComplex (h i) / ringComplex (p i)) * ringComplex (∏ i, p i) := by
    apply (div_eq_iff her).mp
    rw [Finset.sum_div]
    exact Finset.sum_congr rfl (fun i _ => by simpa only [map_mul] using hterm i)
  simp only [cuspCrossNumerator, map_add, map_mul, map_pow, map_sum]
  rw [hsum]
  field_simp

/-- The lower-right matrix entry reduces to the inverse of the local numerator. -/
lemma cuspMatrix_inverse_local {ι : Type*} [Fintype ι] (p : ι → O) (c : O)
    (M : SL(2, O)) (hM : M 1 0 = c * ∏ i, p i) (i : ι)
    (s : (O ⧸ Ideal.span {p i})ˣ)
    (hs : Ideal.Quotient.mk (Ideal.span {p i}) (M 0 0) = (s : O ⧸ Ideal.span {p i})) :
    Ideal.Quotient.mk (Ideal.span {p i}) (M 1 1) = (↑s⁻¹ : O ⧸ Ideal.span {p i}) := by
  let q := Ideal.Quotient.mk (Ideal.span {p i})
  have hz : q (M 1 0) = 0 := by
    rw [hM]
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    apply Ideal.mem_span_singleton.mpr
    exact dvd_mul_of_dvd_right ⟨cuspPrimeCofactor p i, (cuspPrime_mul_cofactor p i).symm⟩ c
  have hd : M 0 0 * M 1 1 - M 0 1 * M 1 0 = 1 := by
    simpa only [Matrix.det_fin_two] using M.property
  have he := congrArg q hd
  simp only [map_sub, map_mul, map_one, hz, mul_zero, sub_zero] at he
  have hs' : q (M 0 0) = (s : O ⧸ Ideal.span {p i}) := hs
  rw [hs'] at he
  calc
    q (M 1 1) = (↑s⁻¹ : O ⧸ Ideal.span {p i}) * ((s : O ⧸ Ideal.span {p i}) * q (M 1 1)) := by
      rw [← mul_assoc, Units.inv_mul, one_mul]
    _ = _ := by rw [he, mul_one]


lemma tracePhase_finset_sum {ι : Type*} (s : Finset ι) (f : ι → ℂ) :
    tracePhase (∑ i ∈ s, f i) = ∏ i ∈ s, tracePhase (f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp only [Finset.sum_empty, Finset.prod_empty, AddChar.map_zero_eq_one]
  | @insert i s hi ih => rw [Finset.sum_insert hi, Finset.prod_insert hi, AddChar.map_add_eq_mul, ih]

/-- Complementary-prime inverses give the exact finite CRT factorization of the trace character. -/
theorem residueTraceQuotientChar_finite_crt {ι : Type*} [Fintype ι]
    (p t : ι → O) (hp : ∀ i, p i ≠ 0)
    (hpair : Pairwise (Function.onFun IsCoprime p))
    (ht : ∀ i, p i ∣ cuspPrimeCofactor p i * t i - 1) (z : O) :
    residueTraceQuotientChar 1 (∏ i, p i)
      (Finset.prod_ne_zero_iff.mpr (fun i _ => hp i))
      (Ideal.Quotient.mk (Ideal.span {∏ i, p i}) z) =
    ∏ i, residueTraceQuotientChar 1 (p i) (hp i)
      (Ideal.Quotient.mk (Ideal.span {p i}) (t i * z)) := by
  classical
  let S : O := ∑ i, t i * z * cuspPrimeCofactor p i
  have hd : (∏ i, p i) ∣ z - S := by
    apply Fintype.prod_dvd_of_isRelPrime (fun i k hik => (hpair hik).isRelPrime)
    intro i
    let q := Ideal.Quotient.mk (Ideal.span {p i})
    apply Ideal.mem_span_singleton.mp
    apply Ideal.Quotient.eq.mp
    change q z = q S
    have ht' : q (cuspPrimeCofactor p i) * q (t i) = 1 := by
      have he := Ideal.Quotient.eq.mpr (Ideal.mem_span_singleton.mpr (ht i))
      simpa only [map_mul, map_one] using he
    have hs : (∑ k, q (t k) * q z * q (cuspPrimeCofactor p k)) =
        q (t i) * q z * q (cuspPrimeCofactor p i) := by
      apply Finset.sum_eq_single i
      · intro k hk hki
        have he : q (cuspPrimeCofactor p k) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr
          (Ideal.mem_span_singleton.mpr (cuspPrime_dvd_other_cofactor p hki.symm))
        rw [he, mul_zero]
      · intro hi
        exact False.elim (hi (Finset.mem_univ i))
    simp only [S, map_sum, map_mul, hs]
    calc
      q z = (q (cuspPrimeCofactor p i) * q (t i)) * q z := by rw [ht', one_mul]
      _ = _ := by ring
  have he : Ideal.Quotient.mk (Ideal.span {∏ i, p i}) z =
      Ideal.Quotient.mk (Ideal.span {∏ i, p i}) S :=
    Ideal.Quotient.eq.mpr (Ideal.mem_span_singleton.mpr hd)
  rw [he, residueTraceQuotientChar_phase, one_mul]
  simp_rw [residueTraceQuotientChar_phase, one_mul]
  simp only [S, map_sum, map_mul, Finset.sum_div, tracePhase_finset_sum]
  apply Finset.prod_congr rfl
  intro i hi
  congr 1
  have hep := ringComplex_ne_zero (hp i)
  have heR : ringComplex (∏ i, p i) ≠ 0 := ringComplex_ne_zero (Finset.prod_ne_zero_iff.mpr (fun i _ => hp i))
  have hel := ringComplex_ne_zero traceLambda_ne_zero
  have hprod := congrArg ringComplex (cuspPrime_mul_cofactor p i)
  simp only [map_mul] at hprod
  apply (div_eq_div_iff (mul_ne_zero heR hel) (mul_ne_zero hep hel)).mpr
  linear_combination ringComplex (t i) * ringComplex z * ringComplex traceLambda * hprod

/-- The fixed denominator and the prime conductor split by Bezout before local Fourier summation. -/
lemma cuspInverse_phase_pair (c r d U w x : O) (hc : c ≠ 0) (hr : r ≠ 0)
    (hbez : U * r + (traceLambda ^ 3 * w) * c = 1) :
    tracePhase (-(ringComplex d * ringComplex x) / (ringComplex traceLambda ^ 4 * ringComplex c * ringComplex r)) =
      tracePhase (-(ringComplex d * ringComplex U * ringComplex x) /
        (ringComplex traceLambda ^ 4 * ringComplex c)) *
      residueTraceQuotientChar 1 r hr (Ideal.Quotient.mk (Ideal.span {r}) (-d * w * x)) := by
  rw [residueTraceQuotientChar_phase, one_mul, ← AddChar.map_add_eq_mul]
  congr 1
  have he := congrArg ringComplex hbez
  simp only [map_add, map_mul, map_pow, map_one] at he
  have hec := ringComplex_ne_zero hc
  have her := ringComplex_ne_zero hr
  have hel := ringComplex_ne_zero traceLambda_ne_zero
  simp only [map_neg, map_mul]
  field_simp
  linear_combination (ringComplex d * ringComplex x) * he

lemma cuspInverse_fixed_phase_congr (c d e U x : O) (hc : c ≠ 0)
    (hde : traceLambda ^ 3 * c ∣ d - e) :
    tracePhase (-(ringComplex d * ringComplex U * ringComplex x) /
        (ringComplex traceLambda ^ 4 * ringComplex c)) =
    tracePhase (-(ringComplex e * ringComplex U * ringComplex x) /
        (ringComplex traceLambda ^ 4 * ringComplex c)) := by
  have hmod : traceLambda ^ 3 * c ∣ (-d * U * x) - (-e * U * x) := by
    convert dvd_mul_of_dvd_left hde (-U * x) using 1
    ring
  have hq := congrArg (residueTraceQuotientChar 1 (traceLambda ^ 3 * c)
    (mul_ne_zero (pow_ne_zero _ traceLambda_ne_zero) hc))
    (Ideal.Quotient.eq.mpr (Ideal.mem_span_singleton.mpr hmod))
  have hephase (y : O) :
      tracePhase (-(ringComplex y * ringComplex U * ringComplex x) /
        (ringComplex traceLambda ^ 4 * ringComplex c)) =
      residueTraceQuotientChar 1 (traceLambda ^ 3 * c)
        (mul_ne_zero (pow_ne_zero _ traceLambda_ne_zero) hc)
        (Ideal.Quotient.mk (Ideal.span {traceLambda ^ 3 * c}) (-y * U * x)) := by
    rw [residueTraceQuotientChar_phase, one_mul]
    congr 1
    simp only [map_neg, map_mul, map_pow]
    ring
  exact (hephase d).trans (hq.trans (hephase e).symm)

lemma symbol_finset_denominator {ι : Type*} (s : Finset ι) (p : ι → O) (a : O) :
    symbol a (∏ i ∈ s, p i) = ∏ i ∈ s, symbol a (p i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp only [Finset.prod_empty, symbol_one]
  | @insert i s hi ih => rw [Finset.prod_insert hi, Finset.prod_insert hi, symbol_mul_denominator, ih]

/-- The conjugate cubic symbol is the product of inverse-square sextic characters. -/
lemma cuspSymbol_sextic_product {ι : Type*} [Fintype ι] (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal] (hg : ∀ i, lambda ∉ Ideal.span {p i}) (a : O) :
    star (ringComplex (symbol a (∏ i, p i))) =
      ∏ i, ((complexSexticChar (Ideal.span {p i}) (hg i))⁻¹ ^ 2)
        (Ideal.Quotient.mk (Ideal.span {p i}) a) := by
  classical
  rw [symbol_finset_denominator, map_prod, star_prod]
  apply Finset.prod_congr rfl
  intro i hi
  have he : ringComplex (symbol a (p i)) =
      (complexSexticChar (Ideal.span {p i}) (hg i) ^ 2) (Ideal.Quotient.mk (Ideal.span {p i}) a) := by
    rw [(complexSexticChar_powers (Ideal.span {p i}) (hg i)).1]
    change ringComplex (idealSymbol (Ideal.span {p i}) a) = _
    rw [idealSymbol_prime _ (hg i)]
    rfl
  rw [he, MulChar.star_apply', inv_pow]


/-- The numerator scale and the inverse-cusp phase have unit local coefficients. -/
lemma exists_cusp_local_units {ι : Type*} [Fintype ι] (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal] (c d l : O)
    (hpair : Pairwise (Function.onFun IsCoprime p))
    (hc : ∀ i, IsCoprime c (p i)) (hd : ∀ i, IsCoprime d (p i))
    (hl : ∀ i, IsCoprime l (p i)) :
    ∃ σ ε : ∀ i, (O ⧸ Ideal.span {p i})ˣ,
      (∀ i, (σ i : O ⧸ Ideal.span {p i}) =
        Ideal.Quotient.mk (Ideal.span {p i}) (l ^ 2 * c * cuspPrimeCofactor p i)) ∧
      (∀ i, Ideal.Quotient.mk (Ideal.span {p i}) (l ^ 3 * d * cuspPrimeCofactor p i) *
        (σ i : O ⧸ Ideal.span {p i}) * (ε i : O ⧸ Ideal.span {p i}) = -1) := by
  classical
  have hcof (i) : IsCoprime (p i) (cuspPrimeCofactor p i) :=
    IsCoprime.prod_right (fun k hk => hpair (Ne.symm (Finset.mem_erase.mp hk).1))
  have hpow2 (i) : IsCoprime (p i) (l ^ 2) := by
    simpa only [pow_two] using (hl i).symm.mul_right (hl i).symm
  have hpow3 (i) : IsCoprime (p i) (l ^ 3) := by
    simpa only [show (3 : ℕ) = 2 + 1 from rfl, pow_succ] using (hpow2 i).mul_right (hl i).symm
  have hσ (i) := (isUnit_quotient_span_iff (p i) (l ^ 2 * c * cuspPrimeCofactor p i)).mpr
    (((hpow2 i).mul_right (hc i).symm).mul_right (hcof i))
  have hδ (i) := (isUnit_quotient_span_iff (p i) (l ^ 3 * d * cuspPrimeCofactor p i)).mpr
    (((hpow3 i).mul_right (hd i).symm).mul_right (hcof i))
  choose σ hσ using hσ
  choose δ hδ using hδ
  refine ⟨σ, (fun i => -(δ i * σ i)⁻¹), hσ, ?_⟩
  intro i
  rw [← hδ i, ← Units.val_mul, Units.val_neg, mul_neg, Units.mul_inv]

/-- CRT turns the inverse-cusp coordinate into independent inverse local frequencies. -/
theorem cuspMatrix_inverse_phase_product {ι : Type*} [Fintype ι] (p t : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal] (hp : ∀ i, p i ≠ 0)
    (hpair : Pairwise (Function.onFun IsCoprime p))
    (ht : ∀ i, p i ∣ cuspPrimeCofactor p i * t i - 1)
    (c U w x : O) (hc : c ≠ 0)
    (hbez : U * (∏ i, p i) + (traceLambda ^ 3 * w) * c = 1)
    (M : SL(2, O)) (hM : (∏ i, p i) ∣ M 1 0)
    (σ ε v : ∀ i, (O ⧸ Ideal.span {p i})ˣ)
    (hfreq : ∀ i, Ideal.Quotient.mk (Ideal.span {p i}) (M 0 0) =
      (σ i : O ⧸ Ideal.span {p i}) * (v i : O ⧸ Ideal.span {p i}))
    (hε : ∀ i, Ideal.Quotient.mk (Ideal.span {p i})
      (traceLambda ^ 3 * c * cuspPrimeCofactor p i) *
      (σ i : O ⧸ Ideal.span {p i}) * (ε i : O ⧸ Ideal.span {p i}) = -1) :
    tracePhase (-(ringComplex (M 1 1) * ringComplex x) /
        (ringComplex traceLambda ^ 4 * ringComplex c * ringComplex (∏ i, p i))) =
      tracePhase (-(ringComplex (M 1 1) * ringComplex U * ringComplex x) /
        (ringComplex traceLambda ^ 4 * ringComplex c)) *
      ∏ i, residueTraceQuotientChar 1 (p i) (hp i)
        ((ε i : O ⧸ Ideal.span {p i}) * Ideal.Quotient.mk (Ideal.span {p i}) x *
          (↑(v i)⁻¹ : O ⧸ Ideal.span {p i})) := by
  classical
  rw [cuspInverse_phase_pair c _ _ U w x hc
    (Finset.prod_ne_zero_iff.mpr (fun i _ => hp i)) hbez,
    residueTraceQuotientChar_finite_crt p t hp hpair ht]
  congr 1
  apply Finset.prod_congr rfl
  intro i hi
  apply congrArg (residueTraceQuotientChar 1 (p i) (hp i))
  let q := Ideal.Quotient.mk (Ideal.span {p i})
  have hR : q (∏ k, p k) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr
    (Ideal.mem_span_singleton.mpr ⟨cuspPrimeCofactor p i, (cuspPrime_mul_cofactor p i).symm⟩)
  have hw : q (traceLambda ^ 3 * c) * q w = 1 := by
    have he := congrArg q hbez
    simp only [map_add, map_mul, map_pow, map_one, hR, mul_zero, zero_add] at he
    simpa only [map_mul, map_pow, mul_assoc, mul_comm, mul_left_comm] using he
  have hti : q (cuspPrimeCofactor p i) * q (t i) = 1 := by
    have he := Ideal.Quotient.eq.mpr (Ideal.mem_span_singleton.mpr (ht i))
    simpa only [map_mul, map_one] using he
  have heps : (q (traceLambda ^ 3 * c) * q (cuspPrimeCofactor p i) *
      (σ i : O ⧸ Ideal.span {p i})) * (ε i : O ⧸ Ideal.span {p i}) = -1 := by
    have he := hε i
    change q ((traceLambda ^ 3 * c) * cuspPrimeCofactor p i) *
      (σ i : O ⧸ Ideal.span {p i}) * (ε i : O ⧸ Ideal.span {p i}) = -1 at he
    rw [map_mul] at he
    exact he
  have hD : q (traceLambda ^ 3 * c) ≠ 0 := by
    intro hz
    rw [hz, zero_mul] at hw
    exact zero_ne_one hw
  have hRi : q (cuspPrimeCofactor p i) ≠ 0 := by
    intro hz
    rw [hz, zero_mul] at hti
    exact zero_ne_one hti
  obtain ⟨c₀, hc₀⟩ := hM
  have hcol : M 1 0 = c₀ * ∏ k, p k := by rw [hc₀, mul_comm]
  have hdinv := cuspMatrix_inverse_local p c₀ M hcol i (σ i * v i) (hfreq i)
  change q (M 1 1) = (↑(σ i * v i)⁻¹ : O ⧸ Ideal.span {p i}) at hdinv
  have hsy : (σ i : O ⧸ Ideal.span {p i}) * q (M 1 1) = (↑(v i)⁻¹ : O ⧸ Ideal.span {p i}) := by
    rw [hdinv]
    simp only [mul_inv_rev, Units.val_mul]
    calc
      _ = ((σ i : O ⧸ Ideal.span {p i}) * (↑(σ i)⁻¹ : O ⧸ Ideal.span {p i})) *
          (↑(v i)⁻¹ : O ⧸ Ideal.span {p i}) := by ring
      _ = _ := by rw [Units.mul_inv, one_mul]
  change q (t i * (-M 1 1 * w * x)) = _
  simp only [map_mul, map_neg]
  apply mul_left_cancel₀ (mul_ne_zero (mul_ne_zero hD hRi) (σ i).ne_zero)
  calc
    _ = -((q (traceLambda ^ 3 * c) * q w) * (q (cuspPrimeCofactor p i) * q (t i)) *
        ((σ i : O ⧸ Ideal.span {p i}) * q (M 1 1)) * q x) := by ring
    _ = -((↑(v i)⁻¹ : O ⧸ Ideal.span {p i}) * q x) := by rw [hw, hti, hsy, one_mul, one_mul]
    _ = (q (traceLambda ^ 3 * c) * q (cuspPrimeCofactor p i) *
        (σ i : O ⧸ Ideal.span {p i})) *
        ((ε i : O ⧸ Ideal.span {p i}) * q x * (↑(v i)⁻¹ : O ⧸ Ideal.span {p i})) := by
      rw [← mul_assoc, ← mul_assoc, heps]
      ring
/-- Controlled completions have one fixed unit phase multiplying the moving cubic symbol. -/
theorem fixedCuspGamma_family_character {ι : Type*} (i₀ : ι)
    (N a c r : O) (h9N : (9 : O) ∣ N) (hcN : c ∣ N)
    (hr : lambda ^ 2 ∣ r - 1) (mode : Bool)
    (hbase : if mode then lambda ^ 2 ∣ a - 1 else lambda ^ 2 ∣ c - 1)
    (M : ι → SL(2, O)) (hMa : ∀ i, N ∣ M i 0 0 - a * r)
    (hMc : ∀ i, M i 1 0 = c * r) (hM : ∀ i j k, N ∣ M i j k - M i₀ j k)
    (hcond : ∀ i, if mode then (9 : O) ∣ M i 0 1 ∧ (3 : O) ∣ M i 1 1 - 1
      else (3 : O) ∣ M i 0 1 + 1 ∧ (9 : O) ∣ M i 1 1) :
    ∃ κ : ℂ, ‖κ‖ = 1 ∧ ∀ i,
      extendedComplexCharacter (fixedCuspGamma (M i)) = κ * ringComplex (symbol (M i 0 0) r) := by
  have h3N : (3 : O) ∣ N := (show (3 : O) ∣ 9 from ⟨3, by norm_num⟩).trans h9N
  have hprimaryN : lambda ^ 2 ∣ N := lambda_sq_dvd_three.trans h3N
  have hdet (i) : M i 0 0 * M i 1 1 - M i 0 1 * (c * r) = 1 := by
    simpa only [Matrix.det_fin_two, hMc] using (M i).property
  cases mode
  · have hprimary : lambda ^ 2 ∣ c * r - 1 := primary_mul c r hbase hr
    have hrelative (i) : M i * (weylCuspMatrix a)⁻¹ ∈ levelThree := by
      apply primary_denominator_matrix_relative (M i) a
      · convert dvd_add (h3N.trans (hMa i))
          (dvd_mul_of_dvd_right (three_dvd_primary_sub_one r hr) a) using 1
        ring
      · exact (hcond i).1
      · rw [hMc]
        exact hprimary
      · exact (hcond i).2
    refine ⟨ringComplex (symbol (M i₀ 0 0) c) *
      extendedComplexCharacter (fixedCuspGamma (weylCuspMatrix a)), ?_, ?_⟩
    · rw [norm_mul, norm_extendedComplexCharacter,
        cuspSymbol_weyl_fixed_norm _ _ _ _ _ (hdet i₀) hbase, one_mul]
    · intro i
      rw [fixedCuspGamma_weyl_factor (M i) a c r (hrelative i)
        (by rw [hMc]; exact hprimary) (dvd_mul_of_dvd_right (hcond i).2 _) (hMc i),
        cuspSymbol_weyl_fixed_congr N c _ _ hcN (hM i 0 0)]
  · have hprimary (i) : lambda ^ 2 ∣ M i 0 0 - 1 := by
      convert dvd_add (hprimaryN.trans (hMa i)) (primary_mul a r hbase hr) using 1
      ring
    have hrelative (i) : M i * (lowerCuspMatrix c)⁻¹ ∈ levelThree := by
      apply primary_numerator_matrix_relative (M i) c (hprimary i) (hcond i).1
      · rw [hMc]
        convert dvd_mul_of_dvd_right (three_dvd_primary_sub_one r hr) c using 1
        ring
      · exact (hcond i).2
    let κ : ℂ := ringComplex
      (symbol (-c) (M i₀ 0 0 - c * M i₀ 0 1) * symbol 1 (M i₀ 0 0)) *
      extendedComplexCharacter (fixedCuspGamma (lowerCuspMatrix c))
    refine ⟨κ, ?_, ?_⟩
    · dsimp only [κ]
      rw [norm_mul, norm_extendedComplexCharacter, mul_one]
      apply cuspSymbol_ramified_fixed_norm _ _ 1 r _ c
      · simpa only [one_mul] using hdet i₀
      · exact hprimary i₀
      · exact lowerCusp_relative_primary (M i₀) c (hrelative i₀)
    · intro i
      rw [fixedCuspGamma_ramified_factor (M i) c 1 r (hrelative i) (hprimary i) hr
        (by simpa only [one_mul] using hMc i),
        cuspSymbol_ramified_fixed_congr N 1 c (M i 0 0) (M i₀ 0 0) (M i 0 1) (M i₀ 0 1)
          h9N (one_dvd N) hcN (hprimary i) (hprimary i₀)
          (lowerCusp_relative_primary (M i) c (hrelative i))
          (lowerCusp_relative_primary (M i₀) c (hrelative i₀)) (hM i 0 0) (hM i 0 1)]


/-- The finite cusp sum is an exact product of local Gauss pairs, including exceptional characters. -/
theorem cuspMatrix_frequency_sum {ι : Type*} [Fintype ι] (p t : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal] (hp : ∀ i, p i ≠ 0)
    (hg : ∀ i, lambda ∉ Ideal.span {p i})
    (hpair : Pairwise (Function.onFun IsCoprime p))
    (ht : ∀ i, p i ∣ cuspPrimeCofactor p i * t i - 1)
    (c U w x : O) (hc : c ≠ 0)
    (hbez : U * (∏ i, p i) + (traceLambda ^ 3 * w) * c = 1)
    (M : (∀ i, (O ⧸ Ideal.span {p i})ˣ) → SL(2, O))
    (hM : ∀ v, (∏ i, p i) ∣ M v 1 0)
    (hfixed : ∀ v, traceLambda ^ 3 * c ∣ M v 1 1 - M (fun _ => 1) 1 1)
    (σ ε : ∀ i, (O ⧸ Ideal.span {p i})ˣ)
    (hfreq : ∀ v i, Ideal.Quotient.mk (Ideal.span {p i}) (M v 0 0) =
      (σ i : O ⧸ Ideal.span {p i}) * (v i : O ⧸ Ideal.span {p i}))
    (hε : ∀ i, Ideal.Quotient.mk (Ideal.span {p i})
      (traceLambda ^ 3 * c * cuspPrimeCofactor p i) *
      (σ i : O ⧸ Ideal.span {p i}) * (ε i : O ⧸ Ideal.span {p i}) = -1)
    (κ : ℂ) (hκ : ∀ v, extendedComplexCharacter (fixedCuspGamma (M v)) =
      κ * ringComplex (symbol (M v 0 0) (∏ i, p i))) (j : ι → ℕ) :
    (∑ v : ∀ i, (O ⧸ Ideal.span {p i})ˣ,
      (∏ i, finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (p i) (hp i))
        (complexSexticChar (Ideal.span {p i}) (hg i) ^ j i : MulChar (O ⧸ Ideal.span {p i}) ℂ)
        (v i : O ⧸ Ideal.span {p i})) *
      star (extendedComplexCharacter (fixedCuspGamma (M v))) *
      tracePhase (-(ringComplex (M v 1 1) * ringComplex x) /
        (ringComplex traceLambda ^ 4 * ringComplex c * ringComplex (∏ i, p i)))) =
    (star κ * tracePhase (-(ringComplex (M (fun _ => 1) 1 1) * ringComplex U * ringComplex x) /
        (ringComplex traceLambda ^ 4 * ringComplex c))) *
      ∏ i, ((complexSexticChar (Ideal.span {p i}) (hg i))⁻¹ ^ 2) (σ i) *
        ((Fintype.card (O ⧸ Ideal.span {p i}) : ℂ)⁻¹ *
          gaussSum (complexSexticChar (Ideal.span {p i}) (hg i) ^ j i)
            ((residueTraceQuotientChar 1 (p i) (hp i)).mulShift (-1)) *
          gaussSum (complexSexticChar (Ideal.span {p i}) (hg i) ^ (j i + 2))
            ((residueTraceQuotientChar 1 (p i) (hp i)).mulShift
              ((ε i : O ⧸ Ideal.span {p i}) * Ideal.Quotient.mk (Ideal.span {p i}) x))) := by
  classical
  let χ := fun i => complexSexticChar (Ideal.span {p i}) (hg i)
  let ψ := fun i => residueTraceQuotientChar 1 (p i) (hp i)
  let C := star κ * tracePhase
    (-(ringComplex (M (fun _ => 1) 1 1) * ringComplex U * ringComplex x) /
      (ringComplex traceLambda ^ 4 * ringComplex c))
  let f := fun (i : ι) (v : (O ⧸ Ideal.span {p i})ˣ) =>
    finiteAdditiveFourierCoeff (ψ i) (χ i ^ j i : MulChar (O ⧸ Ideal.span {p i}) ℂ) v *
      ((χ i)⁻¹ ^ 2) v * ψ i ((ε i : O ⧸ Ideal.span {p i}) *
        Ideal.Quotient.mk (Ideal.span {p i}) x * (↑v⁻¹ : O ⧸ Ideal.span {p i}))
  have hpoint (v : ∀ i, (O ⧸ Ideal.span {p i})ˣ) :
      (∏ i, finiteAdditiveFourierCoeff (ψ i) (χ i ^ j i : MulChar (O ⧸ Ideal.span {p i}) ℂ) (v i)) *
      star (extendedComplexCharacter (fixedCuspGamma (M v))) *
      tracePhase (-(ringComplex (M v 1 1) * ringComplex x) /
        (ringComplex traceLambda ^ 4 * ringComplex c * ringComplex (∏ i, p i))) =
      (C * ∏ i, ((χ i)⁻¹ ^ 2) (σ i)) * ∏ i, f i (v i) := by
    rw [hκ v, star_mul, cuspSymbol_sextic_product p hg,
      cuspMatrix_inverse_phase_product p t hp hpair ht c U w x hc hbez (M v) (hM v) σ ε v (hfreq v) hε,
      cuspInverse_fixed_phase_congr c _ _ U x hc (hfixed v)]
    simp_rw [hfreq v]
    simp only [map_mul, Finset.prod_mul_distrib, C, f, χ, ψ]
    ring
  calc
    _ = (C * ∏ i, ((χ i)⁻¹ ^ 2) (σ i)) * ∑ v : ∀ i, (O ⧸ Ideal.span {p i})ˣ, ∏ i, f i (v i) := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun v _ => hpoint v)
    _ = (C * ∏ i, ((χ i)⁻¹ ^ 2) (σ i)) * ∏ i, ∑ v : (O ⧸ Ideal.span {p i})ˣ, f i v := by
      rw [← Fintype.prod_sum f]
    _ = _ := by
      have he (i) : (∑ v : (O ⧸ Ideal.span {p i})ˣ, f i v) =
          (Fintype.card (O ⧸ Ideal.span {p i}) : ℂ)⁻¹ *
          gaussSum (χ i ^ j i) ((ψ i).mulShift (-1)) *
          gaussSum (χ i ^ (j i + 2)) ((ψ i).mulShift
            ((ε i : O ⧸ Ideal.span {p i}) * Ideal.Quotient.mk (Ideal.span {p i}) x)) :=
        finiteReflectionGauss_product (χ i) (ψ i) (j i) _
      simp_rw [he]
      dsimp only [C, χ, ψ]
      simp only [Finset.prod_mul_distrib]
      ring


/-- An integral numerator for every cusp phase, with a common fixed denominator. -/
def sourceCuspIntegralPhaseNumerator (j : Fin 3) (u h : O) : O :=
  (if j = 0 then 3 else 1) * traceLambda * u ^ 2 * h

lemma sourceCuspIntegralPhaseNumerator_embedding (j : Fin 3) (u h : O) :
    ringComplex (sourceCuspIntegralPhaseNumerator j u h) =
      -3 * ringComplex traceLambda ^ 4 * cuspFrequency h * ringComplex u ^ 2 /
        (sourceCuspScale j : ℂ) := by
  have hl := ringComplex_ne_zero traceLambda_ne_zero
  have hs : ringComplex traceLambda ^ 2 = (-3 : ℂ) := by
    simpa only [map_pow, map_neg, map_ofNat] using congrArg ringComplex traceLambda_square
  have hfour : ringComplex traceLambda ^ 4 = (9 : ℂ) := by
    rw [show ringComplex traceLambda ^ 4 = (ringComplex traceLambda ^ 2) ^ 2 by ring, hs]
    norm_num
  rw [hfour]
  fin_cases j <;>
    norm_num [sourceCuspIntegralPhaseNumerator, sourceCuspScale, cuspFrequency, map_mul, map_pow] <;>
    field_simp <;> simp only [hs, map_ofNat] <;> ring

/-- The common fixed denominator removes all divisibility requirements on cusp frequencies. -/
lemma sourceCuspIntegralPhaseNumerator_phase (j : Fin 3) (u h c d : O) (hc : c ≠ 0) :
    tracePhase (cuspFrequency h * ringComplex u ^ 2 * ringComplex d /
      ((sourceCuspScale j : ℂ) * ringComplex c)) =
    tracePhase (-(ringComplex d * ringComplex (sourceCuspIntegralPhaseNumerator j u h)) /
      (ringComplex traceLambda ^ 4 * ringComplex (3 * c))) := by
  rw [sourceCuspIntegralPhaseNumerator_embedding]
  congr 1
  have hl := ringComplex_ne_zero traceLambda_ne_zero
  have hec := ringComplex_ne_zero hc
  have hscale := Complex.ofReal_ne_zero.mpr (sourceCuspScale_pos j).ne'
  simp only [map_mul, map_ofNat]
  field_simp

lemma traceLambda_pow_four : traceLambda ^ 4 = (9 : O) := by
  rw [show traceLambda ^ 4 = (traceLambda ^ 2) ^ 2 by ring, traceLambda_square]
  norm_num

lemma cuspInverse_fixed_modulus_dvd (c : O) : traceLambda ^ 3 * (3 * c) ∣ (27 : O) * c := by
  refine ⟨traceLambda, ?_⟩
  calc
    (27 : O) * c = 3 * traceLambda ^ 4 * c := by rw [traceLambda_pow_four]; ring
    _ = _ := by ring

/-- Actual local frequencies have controlled cusp completions and a fixed unit character factor. -/
theorem exists_fixed_cusp_frequency_character {ι : Type*} [Fintype ι]
    (p : ι → O) (N a c l : O)
    (hpair : Pairwise (Function.onFun IsCoprime p))
    (hp : ∀ i, lambda ^ 2 ∣ p i - 1) (hNp : ∀ i, IsCoprime N (p i))
    (h9N : (9 : O) ∣ N) (hcN : c ∣ N) (hlN : l ∣ N)
    (hac : IsCoprime a c) (mode : Bool)
    (hbase : if mode then lambda ^ 2 ∣ a - 1 else lambda ^ 2 ∣ c - 1) :
    ∃ (lift : (∀ i, (O ⧸ Ideal.span {p i})ˣ) → ι → O)
      (M : (∀ i, (O ⧸ Ideal.span {p i})ˣ) → SL(2, O)) (κ : ℂ),
      (∀ v i, N ^ 2 ∣ lift v i) ∧
      (∀ v i, Ideal.Quotient.mk (Ideal.span {p i}) (lift v i) = (v i : O ⧸ Ideal.span {p i})) ∧
      (∀ v, M v 0 0 = cuspCrossNumerator a c l p (lift v)) ∧
      (∀ v, M v 1 0 = c * ∏ i, p i) ∧
      (∀ v r s, N ∣ M v r s - M (fun _ => 1) r s) ∧
      ‖κ‖ = 1 ∧ ∀ v, extendedComplexCharacter (fixedCuspGamma (M v)) =
        κ * ringComplex (symbol (M v 0 0) (∏ i, p i)) := by
  obtain ⟨lift, M, hperiod, hres, hMa, hMc, hM, hcond⟩ :=
    exists_fixed_cusp_frequency_matrices p N a c l hpair hp hNp h9N hcN hlN hac mode hbase
  have hMaN (v) : N ∣ M v 0 0 - a * ∏ i, p i := by
    rw [hMa]
    exact cuspCrossNumerator_fixed N a c l p (lift v)
      (fun i => (dvd_pow_self N (by decide : (2 : ℕ) ≠ 0)).trans (hperiod v i))
  obtain ⟨κ, hκnorm, hκ⟩ := fixedCuspGamma_family_character (fun _ => 1) N a c (∏ i, p i)
    h9N hcN (primary_finset_product Finset.univ p (fun i _ => hp i)) mode hbase
    M hMaN hMc hM hcond
  exact ⟨lift, M, κ, hperiod, hres, hMa, hMc, hM, hκnorm, hκ⟩

lemma exists_cuspPrime_inverse {ι : Type*} [Fintype ι] (p : ι → O)
    (hpair : Pairwise (Function.onFun IsCoprime p)) :
    ∃ t : ι → O, ∀ i, p i ∣ cuspPrimeCofactor p i * t i - 1 := by
  classical
  have hex (i) : ∃ t : O, p i ∣ cuspPrimeCofactor p i * t - 1 := by
    have hcof : IsCoprime (p i) (cuspPrimeCofactor p i) :=
      IsCoprime.prod_right (fun k hk => hpair (Ne.symm (Finset.mem_erase.mp hk).1))
    obtain ⟨u, v, h⟩ := hcof
    refine ⟨v, -u, ?_⟩
    linear_combination h
  choose t ht using hex
  exact ⟨t, ht⟩

/-- The fixed modulus supplies the inverse coefficient needed for the reflected trace phase. -/
lemma exists_cuspInverse_bezout {ι : Type*} [Fintype ι] (p : ι → O) (N c : O)
    (hN : (27 : O) * c ∣ N) (hNp : ∀ i, IsCoprime N (p i)) :
    ∃ U w : O, U * (∏ i, p i) + (traceLambda ^ 3 * w) * (3 * c) = 1 := by
  have hNr : IsCoprime N (∏ i, p i) := IsCoprime.prod_right (fun i _ => hNp i)
  have hD : traceLambda ^ 3 * (3 * c) ∣ N := (cuspInverse_fixed_modulus_dvd c).trans hN
  obtain ⟨U, w, h⟩ := hNr.symm.of_isCoprime_of_dvd_right hD
  refine ⟨U, w, ?_⟩
  linear_combination h

/-- The actual finite unit-frequency sum at a common cusp denominator. -/
def cuspUnitFrequencySum {ι : Type*} [Fintype ι] (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal] (hp : ∀ i, p i ≠ 0)
    (hg : ∀ i, lambda ∉ Ideal.span {p i}) (c : O)
    (M : (∀ i, (O ⧸ Ideal.span {p i})ˣ) → SL(2, O)) (j : ι → ℕ) (x : O) : ℂ :=
  ∑ v : ∀ i, (O ⧸ Ideal.span {p i})ˣ,
    (∏ i, finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (p i) (hp i))
      (complexSexticChar (Ideal.span {p i}) (hg i) ^ j i : MulChar (O ⧸ Ideal.span {p i}) ℂ)
      (v i : O ⧸ Ideal.span {p i})) *
    star (extendedComplexCharacter (fixedCuspGamma (M v))) *
    tracePhase (-(ringComplex (M v 1 1) * ringComplex x) /
      (ringComplex traceLambda ^ 4 * ringComplex (3 * c) * ringComplex (∏ i, p i)))

/-- The local factors retain both nontrivial Gauss sums and the exceptional zero output. -/
def cuspLocalReflectedProduct {ι : Type*} [Fintype ι] (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal] (hp : ∀ i, p i ≠ 0)
    (hg : ∀ i, lambda ∉ Ideal.span {p i})
    (σ ε : ∀ i, (O ⧸ Ideal.span {p i})ˣ) (j : ι → ℕ) (x : O) : ℂ :=
  ∏ i, ((complexSexticChar (Ideal.span {p i}) (hg i))⁻¹ ^ 2) (σ i) *
    finiteReflectionGauss (complexSexticChar (Ideal.span {p i}) (hg i))
      (residueTraceQuotientChar 1 (p i) (hp i)) (j i)
      ((ε i : O ⧸ Ideal.span {p i}) * Ideal.Quotient.mk (Ideal.span {p i}) x)

/-- Every primitive fixed cusp has an exact unit-frequency reflection with all local data constructed. -/
theorem exists_native_cusp_reflection {ι : Type*} [Fintype ι] (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal] (hp0 : ∀ i, p i ≠ 0)
    (hg : ∀ i, lambda ∉ Ideal.span {p i})
    (hpair : Pairwise (Function.onFun IsCoprime p)) (hp : ∀ i, lambda ^ 2 ∣ p i - 1)
    (N a c : O) (hc : c ≠ 0) (hN : (27 : O) * c ∣ N)
    (hNp : ∀ i, IsCoprime N (p i)) (hac : IsCoprime a c) (mode : Bool)
    (hbase : if mode then lambda ^ 2 ∣ a - 1 else lambda ^ 2 ∣ c - 1) :
    ∃ (lift : (∀ i, (O ⧸ Ideal.span {p i})ˣ) → ι → O)
      (M : (∀ i, (O ⧸ Ideal.span {p i})ˣ) → SL(2, O))
      (σ ε : ∀ i, (O ⧸ Ideal.span {p i})ˣ) (U : O) (κ : ℂ),
      (∀ v i, N ^ 2 ∣ lift v i) ∧
      (∀ v i, Ideal.Quotient.mk (Ideal.span {p i}) (lift v i) = (v i : O ⧸ Ideal.span {p i})) ∧
      (∀ v, M v 0 0 = cuspCrossNumerator a c traceLambda p (lift v)) ∧
      (∀ v, M v 1 0 = c * ∏ i, p i) ∧
      (∀ v r s, N ∣ M v r s - M (fun _ => 1) r s) ∧
      ‖κ‖ = 1 ∧ ∀ (j : ι → ℕ) (x : O),
        cuspUnitFrequencySum p hp0 hg c M j x =
          (star κ * tracePhase (-(ringComplex (M (fun _ => 1) 1 1) * ringComplex U * ringComplex x) /
            (ringComplex traceLambda ^ 4 * ringComplex (3 * c)))) *
          cuspLocalReflectedProduct p hp0 hg σ ε j x := by
  have h9N : (9 : O) ∣ N := (show (9 : O) ∣ 27 * c from ⟨3 * c, by ring⟩).trans hN
  have hcN : c ∣ N := (show c ∣ 27 * c from ⟨27, by ring⟩).trans hN
  have h3cN : 3 * c ∣ N := (show (3 : O) * c ∣ 27 * c from ⟨9, by ring⟩).trans hN
  have hlN : traceLambda ∣ N := (show traceLambda ∣ (9 : O) from
    ⟨traceLambda ^ 3, by rw [← traceLambda_pow_four]; ring⟩).trans h9N
  obtain ⟨lift, M, κ, hperiod, hres, hMa, hMc, hfixed, hκnorm, hκ⟩ :=
    exists_fixed_cusp_frequency_character p N a c traceLambda hpair hp hNp h9N hcN hlN hac mode hbase
  obtain ⟨σ, ε, hσ, hε⟩ := exists_cusp_local_units p c (3 * c) traceLambda hpair
    (fun i => (hNp i).of_isCoprime_of_dvd_left hcN)
    (fun i => (hNp i).of_isCoprime_of_dvd_left h3cN)
    (fun i => (hNp i).of_isCoprime_of_dvd_left hlN)
  obtain ⟨U, w, hbez⟩ := exists_cuspInverse_bezout p N c hN hNp
  obtain ⟨t, ht⟩ := exists_cuspPrime_inverse p hpair
  have hfreq (v) (i) : Ideal.Quotient.mk (Ideal.span {p i}) (M v 0 0) =
      (σ i : O ⧸ Ideal.span {p i}) * (v i : O ⧸ Ideal.span {p i}) := by
    rw [hMa, cuspCrossNumerator_local, hres, hσ]
  have hdenom (v) : (∏ i, p i) ∣ M v 1 0 := by
    rw [hMc]
    exact dvd_mul_left _ _
  have hD (v) : traceLambda ^ 3 * (3 * c) ∣ M v 1 1 - M (fun _ => 1) 1 1 :=
    ((cuspInverse_fixed_modulus_dvd c).trans hN).trans (hfixed v 1 1)
  refine ⟨lift, M, σ, ε, U, κ, hperiod, hres, hMa, hMc, hfixed, hκnorm, ?_⟩
  intro j x
  simpa only [cuspUnitFrequencySum, cuspLocalReflectedProduct, finiteReflectionGauss_product] using
    cuspMatrix_frequency_sum p t hp0 hg hpair ht (3 * c) U w x
      (mul_ne_zero (by norm_num) hc) hbez M hdenom hD σ ε hfreq hε κ hκ j


/-- The fixed cusp amplitude; the denominator contributes only an angular phase. -/
def fixedCuspReflectionScalar (s : FixedCuspSector) (c : O) : ℂ :=
  -ringComplex (fixedCuspTriangular s 0 0) ^ 2 *
    (star (ringComplex c) / ringComplex c) * (sourceCuspScale (fixedCuspIndex s) : ℂ) ^ 2

def fixedCuspReflectionScale (s : FixedCuspSector) (c : O) (X : ℝ) : ℝ :=
  27 * (sourceCuspRadialScale 0) ^ 2 * (sourceCuspRadialScale (fixedCuspIndex s)) ^ 2 * X /
    ‖ringComplex c‖ ^ 4

lemma fixedCuspReflectionScale_pos (s : FixedCuspSector) (c : O) (hc : c ≠ 0)
    (X : ℝ) (hX : 0 < X) : 0 < fixedCuspReflectionScale s c X := by
  have hq₀ := sourceCuspRadialScale_pos 0
  have hq := sourceCuspRadialScale_pos (fixedCuspIndex s)
  have hcn := norm_pos_iff.mpr (ringComplex_ne_zero hc)
  unfold fixedCuspReflectionScale
  positivity

/-- Integral inverse phase at a fixed cusp shape. -/
def fixedCuspInversePhase (s : FixedCuspSector) (c d h : O) : ℂ :=
  tracePhase (-(ringComplex d * ringComplex
    (sourceCuspIntegralPhaseNumerator (fixedCuspIndex s) (fixedCuspTriangular s 0 0) h)) /
    (ringComplex traceLambda ^ 4 * ringComplex (3 * c)))

lemma fixedCuspInversePhase_norm (s : FixedCuspSector) (c d h : O) :
    ‖fixedCuspInversePhase s c d h‖ = 1 := tracePhase_norm _

lemma fixedMatrixCusp_reflected_term (M : SL(2, O)) (hc : M 1 0 ≠ 0) (h : O) :
    (fixedMatrixCusp M hc).smoothingMultiplier *
      sourceCuspRadialCoefficient (fixedMatrixCusp M hc).index (fixedMatrixCusp M hc).dualPoint h =
    fixedCuspReflectionScalar (fixedCuspSector M) (M 1 0) *
      fixedCuspRadialArray (fixedCuspSector M) h * star (extendedComplexCharacter (fixedCuspGamma M)) *
      fixedCuspInversePhase (fixedCuspSector M) (M 1 0) (M 1 1) h := by
  rw [fixedMatrixCusp_smoothingMultiplier, fixedMatrixCusp_radialCoefficient,
    sourceCuspIntegralPhaseNumerator_phase _ _ _ _ _ hc]
  unfold fixedCuspReflectionScalar fixedCuspInversePhase
  ring

lemma fixedCuspRadialArray_kernel_norm_summable (s : FixedCuspSector)
    (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V) (R : ℝ) (hR : 0 < R) :
    Summable (fun h : O => ‖fixedCuspRadialArray s h * paperKernel V (R * sourceCuspRadialLength h)‖) := by
  have hcoeff : Summable (fun h : O => ‖fixedCuspRadialArray s h‖ *
      sourceCuspRadialLength h ^ (-(3 / 2 : ℝ))) := by
    simpa only [fixedCuspRadialArray_norm, sourceCuspRadialCoefficient_norm, neg_div] using
      sourceCuspRadialCoefficient_weighted_summable (fixedCuspIndex s) 0
  exact paperKernel_weighted_norm_summable sourceCuspRadialLength sourceCuspRadialLength_pos
    (fixedCuspRadialArray s) hcoeff V a b ha hs hV R hR

/-- Finite frequency summation commutes with the actual reflected source, retaining its cubic phase. -/
theorem fixedCusp_finite_smoothed_reflection {ι : Type*} [Fintype ι]
    (M : ι → SL(2, O)) (s : FixedCuspSector) (hsector : ∀ i, fixedCuspSector (M i) = s)
    (c : O) (hc : c ≠ 0) (hMc : ∀ i, M i 1 0 = c) (weight : ι → ℂ)
    (V : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support V ⊆ Set.Icc a b) (hV : ContDiff ℝ ∞ V) (X : ℝ) (hX : 0 < X) :
    (∑ i, weight i * ∑' h : O,
      sourceBarRadialCoefficient (ringComplex (M i 0 0) / ringComplex c) h * V (sourceCuspRadialLength h / X)) =
    fixedCuspReflectionScalar s c * ∑' h : O,
      (fixedCuspRadialArray s h * paperKernel V (fixedCuspReflectionScale s c X * sourceCuspRadialLength h)) *
      ∑ i, weight i * star (extendedComplexCharacter (fixedCuspGamma (M i))) *
        fixedCuspInversePhase s c (M i 1 1) h := by
  classical
  have hcn (i) : M i 1 0 ≠ 0 := by rw [hMc]; exact hc
  let A : O → ℂ := fun h => fixedCuspRadialArray s h *
    paperKernel V (fixedCuspReflectionScale s c X * sourceCuspRadialLength h)
  let f : ι → O → ℂ := fun i h => A h *
    (weight i * star (extendedComplexCharacter (fixedCuspGamma (M i))) * fixedCuspInversePhase s c (M i 1 1) h)
  have hA : Summable (fun h => ‖A h‖) := fixedCuspRadialArray_kernel_norm_summable s V a b ha hs hV _
    (fixedCuspReflectionScale_pos s c hc X hX)
  have hf (i) : Summable (f i) := by
    apply Summable.of_norm
    simpa only [f, norm_mul, norm_star, norm_extendedComplexCharacter,
      fixedCuspInversePhase_norm, mul_one] using hA.mul_right ‖weight i‖
  have he (i) : weight i * (∑' h : O,
      sourceBarRadialCoefficient (ringComplex (M i 0 0) / ringComplex c) h * V (sourceCuspRadialLength h / X)) =
      fixedCuspReflectionScalar s c * ∑' h : O, f i h := by
    have hpoint : (fixedMatrixCusp (M i) (hcn i)).point = ringComplex (M i 0 0) / ringComplex c := by
      rw [fixedMatrixCusp_point, hMc]
    rw [← hpoint, (fixedMatrixCusp (M i) (hcn i)).smoothed_reflection V a b ha hs hV X hX]
    simp only [← tsum_mul_left]
    apply tsum_congr
    intro h
    rw [← mul_assoc (fixedMatrixCusp (M i) (hcn i)).smoothingMultiplier,
      fixedMatrixCusp_reflected_term, fixedMatrixCusp_smoothingScale, hsector, hMc]
    dsimp only [f, A, fixedCuspReflectionScale]
    ring
  rw [Finset.sum_congr rfl (fun i _ => he i), ← Finset.mul_sum,
    ← Summable.tsum_finsetSum (fun i _ => hf i)]
  congr 1
  apply tsum_congr
  intro h
  simp only [f, A, Finset.mul_sum]

/-- Prime residue characters form a genuine multiplicative row on Eisenstein integers. -/
def primeCuspRowCharacter {ι : Type*} [Fintype ι] (p : ι → O)
    (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) : O →* ℂ where
  toFun x := ∏ i, χ i (Ideal.Quotient.mk (Ideal.span {p i}) x)
  map_one' := by simp only [map_one, Finset.prod_const_one]
  map_mul' x y := by simp only [map_mul, Finset.prod_mul_distrib]

lemma fixedThetaTwist_mul (Ψ Φ : O →* ℂ) (h : O) :
    fixedThetaTwist (Ψ * Φ) h = fixedThetaTwist Ψ h * Φ h := by
  by_cases hh : lambda ^ 2 ∣ h - 1
  · simp only [fixedThetaTwist, if_pos hh, MonoidHom.mul_apply, mul_assoc]
  · simp only [fixedThetaTwist, if_neg hh, zero_mul]

/-- Tensor Fourier inversion keeps the local zero frequencies. -/
lemma finiteAdditiveFourier_product_inversion {ι : Type*} [Fintype ι]
    {F : ι → Type*} [∀ i, CommRing (F i)] [∀ i, Fintype (F i)]
    (ψ : ∀ i, AddChar (F i) ℂ) (hψ : ∀ i, (ψ i).IsPrimitive)
    (φ : ∀ i, F i → ℂ) (x : ∀ i, F i) :
    (∑ h : ∀ i, F i, ∏ i, finiteAdditiveFourierCoeff (ψ i) (φ i) (h i) * ψ i (h i * x i)) =
      ∏ i, φ i (x i) := by
  classical
  let f := fun (i : ι) (h : F i) => finiteAdditiveFourierCoeff (ψ i) (φ i) h * ψ i (h * x i)
  change (∑ h : ∀ i, F i, ∏ i, f i (h i)) = _
  rw [← Fintype.prod_sum f]
  exact Finset.prod_congr rfl (fun i _ => finiteAdditiveFourier_inversion (ψ i) (hψ i) (φ i) (x i))

lemma primeCuspTranslation_phase {ι : Type*} [Fintype ι] (p t : ι → O)
    (hp : ∀ i, p i ≠ 0) (h : O) :
    tracePhase (-cuspFrequency h * (ringComplex traceLambda ^ 2 * ∑ i, ringComplex (t i) / ringComplex (p i))) =
      ∏ i, residueTraceQuotientChar 1 (p i) (hp i)
        (Ideal.Quotient.mk (Ideal.span {p i}) (t i * h)) := by
  classical
  have he : -cuspFrequency h * (ringComplex traceLambda ^ 2 * ∑ i, ringComplex (t i) / ringComplex (p i)) =
      ∑ i, -cuspFrequency h * ringComplex traceLambda ^ 2 * (ringComplex (t i) / ringComplex (p i)) := by
    rw [← Finset.mul_sum]
    ring
  rw [he, tracePhase_finset_sum]
  apply Finset.prod_congr rfl
  intro i hi
  rw [residueTraceQuotientChar_phase, one_mul]
  have hs : ringComplex traceLambda ^ 2 = (-3 : ℂ) := by
    simpa only [map_pow, map_neg, map_ofNat] using congrArg ringComplex traceLambda_square
  congr 1
  rw [hs, cuspFrequency, map_mul]
  have hl := ringComplex_ne_zero traceLambda_ne_zero
  have hpi := ringComplex_ne_zero (hp i)
  field_simp

/-- The fixed arithmetic twist and all prime rows have one exact rational-cusp expansion. -/
theorem primeCuspRow_phase_decomposition {ι : Type*} [Fintype ι]
    (p : ι → O) [∀ i, (Ideal.span {p i}).IsMaximal] (hp : ∀ i, p i ≠ 0)
    (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ)
    (lift : (∀ i, O ⧸ Ideal.span {p i}) → ι → O)
    (hlift : ∀ v i, Ideal.Quotient.mk (Ideal.span {p i}) (lift v i) = v i)
    (c : O) (hc : c ≠ 0) [Fintype (O ⧸ Ideal.span {9 * c})]
    (Ψ : (O ⧸ Ideal.span {c}) →* ℂ) (h : O) :
    (∑ k : O ⧸ Ideal.span {9 * c}, ∑ v : ∀ i, O ⧸ Ideal.span {p i},
      (finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (9 * c) (mul_ne_zero (by norm_num) hc))
          (finiteThetaTwist c Ψ) k *
        ∏ i, finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (p i) (hp i)) (χ i) (v i)) *
      tracePhase (-cuspFrequency h * (thetaFourierTranslation (9 * c) k +
        ringComplex traceLambda ^ 2 * ∑ i, ringComplex (lift v i) / ringComplex (p i)))) =
    fixedThetaTwist
      (Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom * primeCuspRowCharacter p χ) h := by
  classical
  let ψ := fun i => residueTraceQuotientChar 1 (p i) (hp i)
  have hlocal (v) : tracePhase
      (-cuspFrequency h * (ringComplex traceLambda ^ 2 * ∑ i, ringComplex (lift v i) / ringComplex (p i))) =
      ∏ i, ψ i (v i * Ideal.Quotient.mk (Ideal.span {p i}) h) := by
    rw [primeCuspTranslation_phase p (lift v) hp h]
    simp only [map_mul, hlift, ψ]
  simp_rw [mul_add, AddChar.map_add_eq_mul, hlocal]
  have hsum (k : O ⧸ Ideal.span {9 * c}) :
      (∑ v : ∀ i, O ⧸ Ideal.span {p i},
        (finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (9 * c) (mul_ne_zero (by norm_num) hc))
            (finiteThetaTwist c Ψ) k * ∏ i, finiteAdditiveFourierCoeff (ψ i) (χ i) (v i)) *
        (tracePhase (-cuspFrequency h * thetaFourierTranslation (9 * c) k) *
          ∏ i, ψ i (v i * Ideal.Quotient.mk (Ideal.span {p i}) h))) =
      (finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (9 * c) (mul_ne_zero (by norm_num) hc))
          (finiteThetaTwist c Ψ) k * tracePhase (-cuspFrequency h * thetaFourierTranslation (9 * c) k)) *
      ∏ i, χ i (Ideal.Quotient.mk (Ideal.span {p i}) h) := by
    rw [← finiteAdditiveFourier_product_inversion ψ (fun i => residueTraceQuotientChar_primitive (p i) (hp i))
      (fun i => χ i) (fun i => Ideal.Quotient.mk (Ideal.span {p i}) h), Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro v hv
    rw [Finset.prod_mul_distrib]
    ring
  calc
    _ = ∑ k : O ⧸ Ideal.span {9 * c},
        (finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (9 * c) (mul_ne_zero (by norm_num) hc))
          (finiteThetaTwist c Ψ) k * tracePhase (-cuspFrequency h * thetaFourierTranslation (9 * c) k)) *
        ∏ i, χ i (Ideal.Quotient.mk (Ideal.span {p i}) h) :=
      Finset.sum_congr rfl (fun k _ => hsum k)
    _ = _ := by
      rw [← Finset.sum_mul, thetaFourierTranslation_inversion, finiteThetaTwist_mk, fixedThetaTwist_mul]
      rfl

/-- Any finite additive decomposition acts diagonally on the absolutely convergent smoothed source. -/
lemma sourceBar_smoothed_phase_translation {ι : Type*} [Fintype ι] (z weight : ι → ℂ)
    (W : O → ℂ) (hW : Summable (fun h : O => ‖sourceBarRadialCoefficient 0 h * W h‖)) :
    (∑ i, weight i * ∑' h : O, sourceBarRadialCoefficient (z i) h * W h) =
      ∑' h : O, (∑ i, weight i * tracePhase (-cuspFrequency h * z i)) * sourceBarRadialCoefficient 0 h * W h := by
  let coeff : O → ℂ := fun h => star (sourceBarRadialCoefficient 0 h * W h)
  have hs : Summable (fun h => ‖coeff h‖) := by simpa only [coeff, norm_star] using hW
  have he := conjugate_cuspCharacterSeries_finite_translation coeff hs z weight 0
  simp only [zero_add, mul_zero, AddChar.map_zero_eq_one, mul_one, coeff, star_star] at he
  calc
    _ = ∑ i, weight i * star (cuspCharacterSeries coeff (z i)) := by
      apply Finset.sum_congr rfl
      intro i hi
      congr 1
      rw [conjugate_cuspCharacterSeries]
      apply tsum_congr
      intro h
      rw [sourceBarRadialCoefficient_phase]
      simp only [coeff, star_star]
      ring
    _ = _ := by simpa only [mul_assoc] using he

/-- The completed Gauss sum is the arithmetic twist of the smoothed source derivative. -/
lemma completedT_source_identity (Ψ : O →* ℂ) (W : ℝ → ℂ) (X : ℝ) :
    completedT Ψ W X = thetaDerivativeScalar⁻¹ *
      ∑' h : O, fixedThetaTwist Ψ h * sourceBarRadialCoefficient 0 h * Vstar W (sourceCuspRadialLength h / X) := by
  have he : thetaRadialDerivativeScalar * completedT Ψ W X = rationalSourceThetaScalar⁻¹ *
      ∑' h : O, fixedThetaTwist Ψ h * sourceBarRadialCoefficient 0 h * Vstar W (sourceCuspRadialLength h / X) := by
    rw [← thetaSmoothedGaussSum_eq_completedT]
    calc
      _ = ∑' h : O, (rationalSourceThetaScalar⁻¹ * star (rationalSourceResidualFourierCoefficient h) *
          fixedThetaTwist Ψ h) *
          (((-2 * Real.pi * Complex.I * star (cuspFrequency h)) / (sourceCuspRadialLength h : ℂ)) *
            Vstar W (sourceCuspRadialLength h / X)) := (fixedThetaTwist_source_tsum Ψ _).symm
      _ = _ := by
        rw [← tsum_mul_left]
        apply tsum_congr
        intro h
        rw [sourceBarRadialCoefficient_at_zero]
        ring
  apply mul_left_cancel₀ thetaRadialDerivativeScalar_ne_zero
  rw [he, thetaDerivativeScalar, mul_inv_rev]
  field_simp [thetaRadialDerivativeScalar_ne_zero]

/-- An exact finite phase decomposition reflects the completed Gauss sum through its actual cusps. -/
theorem completedT_finite_phase_reflection {ι : Type*} [Fintype ι]
    (Ψ : O →* ℂ) (d : ι → SourceCuspDatum) (weight : ι → ℂ)
    (hphase : ∀ h : O, (∑ i, weight i * tracePhase (-cuspFrequency h * (d i).point)) = fixedThetaTwist Ψ h)
    (W : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support W ⊆ Set.Icc a b) (hW : ContDiff ℝ ∞ W) (X : ℝ) (hX : 0 < X) :
    completedT Ψ W X = thetaDerivativeScalar⁻¹ * ∑ i, weight i *
      ((d i).smoothingMultiplier * ∑' h : O, sourceCuspRadialCoefficient (d i).index (d i).dualPoint h *
        paperKernel (Vstar W) ((d i).smoothingScale X * sourceCuspRadialLength h)) := by
  have hcoeff : Summable (fun h : O => ‖sourceBarRadialCoefficient 0 h‖ *
      sourceCuspRadialLength h ^ (-(3 / 2 : ℝ))) := by
    simpa only [show (1 / 2 : ℝ) - 2 = -(3 / 2) by norm_num] using
      sourceBarRadialCoefficient_summable 0 2 le_rfl
  have hsum := weighted_compact_test_norm_summable sourceCuspRadialLength sourceCuspRadialLength_pos
    (sourceBarRadialCoefficient 0) (3 / 2) hcoeff (Vstar W) a b ha
    (Vstar_support W a b hs) (Vstar_contDiff W a b ha hs hW) X hX
  have he := sourceBar_smoothed_phase_translation (fun i => (d i).point) weight
    (fun h => Vstar W (sourceCuspRadialLength h / X)) hsum
  simp_rw [hphase] at he
  rw [completedT_source_identity, ← he]
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  rw [(d i).smoothed_reflection (Vstar W) a b ha
    (Vstar_support W a b hs) (Vstar_contDiff W a b ha hs hW) X hX]

/-- Tensor Fourier inversion gives the exact completed reflection before active-prime regrouping. -/
theorem completedT_primeCuspRow_reflection {ι : Type*} [Fintype ι]
    (p : ι → O) [∀ i, (Ideal.span {p i}).IsMaximal] (hp : ∀ i, p i ≠ 0)
    (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ)
    (lift : (∀ i, O ⧸ Ideal.span {p i}) → ι → O)
    (hlift : ∀ v i, Ideal.Quotient.mk (Ideal.span {p i}) (lift v i) = v i)
    (c : O) (hc : c ≠ 0) [Fintype (O ⧸ Ideal.span {9 * c})]
    (Ψ : (O ⧸ Ideal.span {c}) →* ℂ)
    (d : (O ⧸ Ideal.span {9 * c}) × (∀ i, O ⧸ Ideal.span {p i}) → SourceCuspDatum)
    (hd : ∀ k v, (d (k, v)).point = thetaFourierTranslation (9 * c) k +
      ringComplex traceLambda ^ 2 * ∑ i, ringComplex (lift v i) / ringComplex (p i))
    (W : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support W ⊆ Set.Icc a b) (hW : ContDiff ℝ ∞ W) (X : ℝ) (hX : 0 < X) :
    completedT (Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom * primeCuspRowCharacter p χ) W X =
      thetaDerivativeScalar⁻¹ * ∑ k : O ⧸ Ideal.span {9 * c}, ∑ v : ∀ i, O ⧸ Ideal.span {p i},
        (finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (9 * c) (mul_ne_zero (by norm_num) hc))
            (finiteThetaTwist c Ψ) k *
          ∏ i, finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (p i) (hp i)) (χ i) (v i)) *
        ((d (k, v)).smoothingMultiplier * ∑' h : O,
          sourceCuspRadialCoefficient (d (k, v)).index (d (k, v)).dualPoint h *
          paperKernel (Vstar W) ((d (k, v)).smoothingScale X * sourceCuspRadialLength h)) := by
  let weight := fun q : (O ⧸ Ideal.span {9 * c}) × (∀ i, O ⧸ Ideal.span {p i}) =>
    finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (9 * c) (mul_ne_zero (by norm_num) hc))
      (finiteThetaTwist c Ψ) q.1 *
    ∏ i, finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (p i) (hp i)) (χ i) (q.2 i)
  have hphase (h : O) : (∑ q, weight q * tracePhase (-cuspFrequency h * (d q).point)) =
      fixedThetaTwist (Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom * primeCuspRowCharacter p χ) h := by
    rw [Fintype.sum_prod_type]
    simp_rw [hd]
    exact primeCuspRow_phase_decomposition p hp χ lift hlift c hc Ψ h
  simpa only [weight, Fintype.sum_prod_type] using
    completedT_finite_phase_reflection _ d weight hphase W a b ha hs hW X hX


lemma assembleUnitFrequencies_prod {ι : Type*} [Fintype ι] {F : ι → Type*}
    [∀ i, Field (F i)] {A : Type*} [CommMonoid A]
    (s : Finset ι) (u : ∀ i : s, (F i.val)ˣ) (f : ∀ i, F i → A) :
    (∏ i, f i (assembleUnitFrequencies s u i)) =
      (∏ i : s, f i.val (u i)) * ∏ i : {i // i ∉ s}, f i.val 0 := by
  classical
  rw [← Finset.prod_mul_prod_compl s (fun i => f i (assembleUnitFrequencies s u i)),
    Finset.prod_subtype (F := inferInstanceAs (Fintype s)) s (fun _ => Iff.rfl),
    Finset.prod_subtype (F := inferInstanceAs (Fintype {i // i ∉ s})) sᶜ (fun _ => Finset.mem_compl)]
  apply congrArg₂ (· * ·)
  · exact Finset.prod_congr rfl (fun i _ => by simp only [assembleUnitFrequencies, dif_pos i.property])
  · exact Finset.prod_congr rfl (fun i _ => by simp only [assembleUnitFrequencies, dif_neg i.property])

/-- Fourier inversion splits into unit-frequency sums and the exact inactive-prime factors. -/
theorem finiteAdditiveFourier_active_inversion {ι : Type*} [Fintype ι]
    {F : ι → Type*} [∀ i, Field (F i)] [∀ i, Fintype (F i)]
    (ψ : ∀ i, AddChar (F i) ℂ) (hψ : ∀ i, (ψ i).IsPrimitive)
    (φ : ∀ i, F i → ℂ) (x : ∀ i, F i) :
    (∏ i, φ i (x i)) = ∑ s : Finset ι,
      (∏ i : {i // i ∉ s}, finiteAdditiveFourierCoeff (ψ i.val) (φ i.val) 0) *
      ∑ u : ∀ i : s, (F i.val)ˣ, ∏ i : s,
        finiteAdditiveFourierCoeff (ψ i.val) (φ i.val) (u i) * ψ i.val ((u i : F i.val) * x i.val) := by
  classical
  rw [← finiteAdditiveFourier_product_inversion ψ hψ φ x, finite_frequency_sum_strata]
  apply Finset.sum_congr rfl
  intro s hs
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro u hu
  rw [assembleUnitFrequencies_prod s u (fun i y =>
    finiteAdditiveFourierCoeff (ψ i) (φ i) y * ψ i (y * x i))]
  simp only [zero_mul, AddChar.map_zero_eq_one, mul_one]
  ring

/-- The inactive factor vanishes unless every omitted prime carries the trivial character. -/
lemma finiteAdditiveFourier_inactive_vanishes {ι : Type*} [Fintype ι]
    {F : ι → Type*} [∀ i, Field (F i)] [∀ i, Fintype (F i)]
    (χ : ∀ i, MulChar (F i) ℂ) (ψ : ∀ i, AddChar (F i) ℂ)
    (s : Finset ι) (k : ι) (hk : k ∉ s) (hχ : χ k ≠ 1) :
    (∏ i : {i // i ∉ s}, finiteAdditiveFourierCoeff (ψ i.val) (χ i.val) 0) = 0 := by
  classical
  apply Finset.prod_eq_zero (Finset.mem_univ ⟨k, hk⟩)
  rw [finiteAdditiveFourierCoeff_mulChar_zero, if_neg hχ]

/-- Every surviving inactive prime contributes its exact coprimality density. -/
lemma finiteAdditiveFourier_inactive_density {ι : Type*} [Fintype ι]
    {F : ι → Type*} [∀ i, Field (F i)] [∀ i, Fintype (F i)]
    (χ : ∀ i, MulChar (F i) ℂ) (ψ : ∀ i, AddChar (F i) ℂ)
    (s : Finset ι) (hχ : ∀ i, i ∉ s → χ i = 1) :
    (∏ i : {i // i ∉ s}, finiteAdditiveFourierCoeff (ψ i.val) (χ i.val) 0) =
      ∏ i : {i // i ∉ s}, (1 - (Fintype.card (F i.val) : ℂ)⁻¹) := by
  classical
  apply Finset.prod_congr rfl
  intro i hi
  rw [finiteAdditiveFourierCoeff_mulChar_zero, if_pos (hχ i.val i.property),
    Nat.card_eq_fintype_card, Fintype.card_units,
    Nat.cast_sub (Nat.succ_le_of_lt Fintype.card_pos), Nat.cast_one]
  have hq : (Fintype.card (F i.val) : ℂ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  field_simp

lemma finiteMulChar_unit_norm {F : Type*} [Field F] [Fintype F]
    (χ : MulChar F ℂ) (u : Fˣ) : ‖χ u‖ = 1 :=
  Complex.norm_eq_one_of_mem_rootsOfUnity (χ.apply_mem_rootsOfUnity u)

/-- At odd good primes, the sextic character has all six distinct powers. -/
lemma complexSexticChar_pow_ne_one (P : Ideal O) [P.IsMaximal]
    (hg : lambda ∉ P) (hchar : ringChar (O ⧸ P) ≠ 2)
    (j : ℕ) (hj : j < 6) (hj0 : j ≠ 0) : complexSexticChar P hg ^ j ≠ 1 := by
  let χ := complexSexticChar P hg
  have hχ : χ ≠ 1 := complexSexticChar_ne_one P hg
  have h2 : χ ^ 2 ≠ 1 := by
    rw [(complexSexticChar_powers P hg).1]
    exact complexCubicChar_ne_one P hg
  have h3 : χ ^ 3 ≠ 1 := by
    rw [(complexSexticChar_powers P hg).2.1]
    exact complexQuadraticChar_ne_one P hchar
  have h6 : χ ^ 6 = 1 := (complexSexticChar_powers P hg).2.2
  change χ ^ j ≠ 1
  interval_cases j
  · exact False.elim (hj0 rfl)
  · simpa only [pow_one] using hχ
  · exact h2
  · exact h3
  · intro h4
    apply h2
    have he : χ ^ 2 = χ ^ 6 * (χ ^ 4)⁻¹ := by group
    rw [he, h6, h4, inv_one, one_mul]
  · intro h5
    apply hχ
    have he : χ = χ ^ 6 * (χ ^ 5)⁻¹ := by group
    rw [he, h6, h5, inv_one, one_mul]

/-- Every nonexceptional local reflection is its predicted multiplicative output character. -/
lemma finiteReflectionGauss_nonexceptional {F : Type*} [Field F] [Fintype F]
    (χ : MulChar F ℂ) (ψ : AddChar F ℂ) (j : ℕ) (hj : χ ^ (j + 2) ≠ 1) (x : F) :
    finiteReflectionGauss χ ψ j x =
      ((Fintype.card F : ℂ)⁻¹ * gaussSum (χ ^ j) (ψ.mulShift (-1)) * gaussSum (χ ^ (j + 2)) ψ) *
      (χ ^ (j + 2))⁻¹ x := by
  rw [finiteReflectionGauss_product, finiteGauss_mulShift_all _ _ hj]
  ring

/-- The trivial input row pays exactly one square root of the residue-field size. -/
lemma finiteReflectionGauss_trivial_phase_norm_sq {F : Type*} [Field F] [Fintype F]
    (χ : MulChar F ℂ) (ψ : AddChar F ℂ) (hψ : ψ.IsPrimitive) (hχ2 : χ ^ 2 ≠ 1) :
    ‖(Fintype.card F : ℂ)⁻¹ * gaussSum (1 : MulChar F ℂ) (ψ.mulShift (-1)) * gaussSum (χ ^ 2) ψ‖ ^ 2 =
      (Fintype.card F : ℝ)⁻¹ := by
  have hneg : ψ.mulShift (-1) ≠ 1 := hψ (neg_ne_zero.mpr one_ne_zero)
  have hn : ‖gaussSum (χ ^ 2) ψ‖ ^ 2 = (Fintype.card F : ℝ) := by
    rw [← Complex.normSq_eq_norm_sq, ArithmeticEffectivityTheory.normSq_gaussSum_eq_card hχ2 hψ]
  have hq : (Fintype.card F : ℝ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  rw [gaussSum_one_left hneg]
  simp only [norm_mul, norm_inv, Complex.norm_natCast, norm_neg, norm_one, mul_one, mul_pow, hn]
  field_simp

/-- The fourth-power exceptional divisor bracket has the same square-root normalization. -/
lemma finiteReflectionGauss_fourth_phase_norm_sq {F : Type*} [Field F] [Fintype F]
    (χ : MulChar F ℂ) (ψ : AddChar F ℂ) (hψ : ψ.IsPrimitive) (hχ4 : χ ^ 4 ≠ 1) :
    ‖(Fintype.card F : ℂ)⁻¹ * gaussSum (χ ^ 4) (ψ.mulShift (-1))‖ ^ 2 =
      (Fintype.card F : ℝ)⁻¹ := by
  have hneg : (ψ.mulShift (-1)).IsPrimitive := by
    intro a ha
    rw [AddChar.mulShift_mulShift]
    exact hψ (mul_ne_zero (neg_ne_zero.mpr one_ne_zero) ha)
  have hn : ‖gaussSum (χ ^ 4) (ψ.mulShift (-1))‖ ^ 2 = (Fintype.card F : ℝ) := by
    rw [← Complex.normSq_eq_norm_sq, ArithmeticEffectivityTheory.normSq_gaussSum_eq_card hχ4 hneg]
  have hq : (Fintype.card F : ℝ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  simp only [norm_mul, norm_inv, Complex.norm_natCast, mul_pow, hn]
  field_simp

/-- Local unit scales change a reflected sextic row only by one fixed phase of norm one. -/
theorem finiteReflectionGauss_scaled_quadratic_family
    {ι : Type*} [Fintype ι] (P : ι → Ideal O) [∀ i, (P i).IsMaximal]
    (hg : ∀ i, lambda ∉ P i) (hchar : ∀ i, ringChar (O ⧸ P i) ≠ 2)
    (ψ : ∀ i, AddChar (O ⧸ P i) ℂ) (hψ : ∀ i, (ψ i).IsPrimitive)
    (σ ε : ∀ i, (O ⧸ P i)ˣ) :
    ∃ η : ℂ, ‖η‖ = 1 ∧ ∀ x : ∀ i, O ⧸ P i,
      (∏ i, ((complexSexticChar (P i) (hg i))⁻¹ ^ 2) (σ i) *
        finiteReflectionGauss (complexSexticChar (P i) (hg i)) (ψ i) 1 ((ε i : O ⧸ P i) * x i)) =
      η * ∏ i, complexQuadraticChar (P i) (x i) := by
  classical
  choose η hηnorm hη using fun i =>
    finiteReflectionGauss_actual_quadratic (P i) (hg i) (hchar i) (ψ i) (hψ i)
  refine ⟨∏ i, (((complexSexticChar (P i) (hg i))⁻¹ ^ 2) (σ i) * η i *
    complexQuadraticChar (P i) (ε i)), ?_, ?_⟩
  · simp only [norm_prod, norm_mul, finiteMulChar_unit_norm, hηnorm, one_mul, Finset.prod_const_one]
  · intro x
    simp_rw [hη, map_mul]
    rw [← Finset.prod_mul_distrib]
    exact Finset.prod_congr rfl (fun i _ => by ring)

/-- Each active prime set may choose its own congruence-controlled unit lifts. -/
theorem primeCuspRow_active_phase_decomposition {ι : Type*} [Fintype ι]
    (p : ι → O) [∀ i, (Ideal.span {p i}).IsMaximal] (hp : ∀ i, p i ≠ 0)
    (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ)
    (c : O) (hc : c ≠ 0) [Fintype (O ⧸ Ideal.span {9 * c})]
    (Ψ : (O ⧸ Ideal.span {c}) →* ℂ)
    (lift : (O ⧸ Ideal.span {9 * c}) → ∀ s : Finset ι,
      (∀ i : s, (O ⧸ Ideal.span {p i.val})ˣ) → s → O)
    (hlift : ∀ k s v i, Ideal.Quotient.mk (Ideal.span {p i.val}) (lift k s v i) =
      (v i : O ⧸ Ideal.span {p i.val})) (h : O) :
    (∑ k : O ⧸ Ideal.span {9 * c}, ∑ s : Finset ι,
      ∑ v : ∀ i : s, (O ⧸ Ideal.span {p i.val})ˣ,
      (finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (9 * c) (mul_ne_zero (by norm_num) hc))
          (finiteThetaTwist c Ψ) k *
        (∏ i : {i // i ∉ s}, finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (p i.val) (hp i.val)) (χ i.val) 0) *
        ∏ i : s, finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (p i.val) (hp i.val)) (χ i.val) (v i)) *
      tracePhase (-cuspFrequency h * (thetaFourierTranslation (9 * c) k +
        ringComplex traceLambda ^ 2 * ∑ i : s, ringComplex (lift k s v i) / ringComplex (p i.val)))) =
    fixedThetaTwist
      (Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom * primeCuspRowCharacter p χ) h := by
  classical
  let ψ := fun i => residueTraceQuotientChar 1 (p i) (hp i)
  let inactive := fun s : Finset ι => ∏ i : {i // i ∉ s}, finiteAdditiveFourierCoeff (ψ i.val) (χ i.val) 0
  let active := fun (s : Finset ι) (v : ∀ i : s, (O ⧸ Ideal.span {p i.val})ˣ) =>
    ∏ i : s, finiteAdditiveFourierCoeff (ψ i.val) (χ i.val) (v i)
  let shift := fun (k : O ⧸ Ideal.span {9 * c}) (s : Finset ι) (v : ∀ i : s, (O ⧸ Ideal.span {p i.val})ˣ) =>
    ringComplex traceLambda ^ 2 * ∑ i : s, ringComplex (lift k s v i) / ringComplex (p i.val)
  have hlocal (k) (s) (v) : tracePhase (-cuspFrequency h * shift k s v) =
      ∏ i : s, ψ i.val ((v i : O ⧸ Ideal.span {p i.val}) * Ideal.Quotient.mk (Ideal.span {p i.val}) h) := by
    change tracePhase (-cuspFrequency h * (ringComplex traceLambda ^ 2 *
      ∑ i : s, ringComplex (lift k s v i) / ringComplex (p i.val))) = _
    rw [primeCuspTranslation_phase (fun i : s => p i.val) (lift k s v) (fun i => hp i.val) h]
    simp only [map_mul, hlift, ψ]
  have hsum (k : O ⧸ Ideal.span {9 * c}) : (∑ s : Finset ι, inactive s *
      ∑ v : ∀ i : s, (O ⧸ Ideal.span {p i.val})ˣ, active s v * tracePhase (-cuspFrequency h * shift k s v)) =
      ∏ i, χ i (Ideal.Quotient.mk (Ideal.span {p i}) h) := by
    rw [finiteAdditiveFourier_active_inversion ψ (fun i => residueTraceQuotientChar_primitive (p i) (hp i))
      (fun i => χ i) (fun i => Ideal.Quotient.mk (Ideal.span {p i}) h)]
    apply Finset.sum_congr rfl
    intro s hs
    congr 1
    apply Finset.sum_congr rfl
    intro v hv
    rw [hlocal k, Finset.prod_mul_distrib]
  let base := finiteAdditiveFourierCoeff
    (residueTraceQuotientChar 1 (9 * c) (mul_ne_zero (by norm_num) hc)) (finiteThetaTwist c Ψ)
  calc
    _ = ∑ k : O ⧸ Ideal.span {9 * c},
        (base k * tracePhase (-cuspFrequency h * thetaFourierTranslation (9 * c) k)) *
        (∑ s : Finset ι, inactive s *
          ∑ v : ∀ i : s, (O ⧸ Ideal.span {p i.val})ˣ, active s v * tracePhase (-cuspFrequency h * shift k s v)) := by
      apply Finset.sum_congr rfl
      intro k hk
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro s hs
      rw [Finset.mul_sum, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro v hv
      rw [mul_add, AddChar.map_add_eq_mul]
      dsimp only [base, inactive, active, shift, ψ]
      ring
    _ = _ := by
      simp_rw [hsum]
      rw [← Finset.sum_mul]
      dsimp only [base]
      rw [thetaFourierTranslation_inversion, finiteThetaTwist_mk, fixedThetaTwist_mul]
      rfl

/-- The completed row reflects stratum by stratum, with zero local frequencies kept as density factors. -/
theorem completedT_active_primeCusp_reflection {ι : Type*} [Fintype ι]
    (p : ι → O) [∀ i, (Ideal.span {p i}).IsMaximal] (hp : ∀ i, p i ≠ 0)
    (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ)
    (c : O) (hc : c ≠ 0) [Fintype (O ⧸ Ideal.span {9 * c})]
    (Ψ : (O ⧸ Ideal.span {c}) →* ℂ)
    (lift : (O ⧸ Ideal.span {9 * c}) → ∀ s : Finset ι,
      (∀ i : s, (O ⧸ Ideal.span {p i.val})ˣ) → s → O)
    (hlift : ∀ k s v i, Ideal.Quotient.mk (Ideal.span {p i.val}) (lift k s v i) =
      (v i : O ⧸ Ideal.span {p i.val}))
    (d : (O ⧸ Ideal.span {9 * c}) × (Σ s : Finset ι, ∀ i : s, (O ⧸ Ideal.span {p i.val})ˣ) → SourceCuspDatum)
    (hd : ∀ k s v, (d (k, ⟨s, v⟩)).point = thetaFourierTranslation (9 * c) k +
      ringComplex traceLambda ^ 2 * ∑ i : s, ringComplex (lift k s v i) / ringComplex (p i.val))
    (W : ℝ → ℂ) (a b : ℝ) (ha : 0 < a)
    (hs : Function.support W ⊆ Set.Icc a b) (hW : ContDiff ℝ ∞ W) (X : ℝ) (hX : 0 < X) :
    completedT (Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom * primeCuspRowCharacter p χ) W X =
      thetaDerivativeScalar⁻¹ * ∑ k : O ⧸ Ideal.span {9 * c}, ∑ s : Finset ι,
        ∑ v : ∀ i : s, (O ⧸ Ideal.span {p i.val})ˣ,
        (finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (9 * c) (mul_ne_zero (by norm_num) hc))
            (finiteThetaTwist c Ψ) k *
          (∏ i : {i // i ∉ s}, finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (p i.val) (hp i.val)) (χ i.val) 0) *
          ∏ i : s, finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (p i.val) (hp i.val)) (χ i.val) (v i)) *
        ((d (k, ⟨s, v⟩)).smoothingMultiplier * ∑' h : O,
          sourceCuspRadialCoefficient (d (k, ⟨s, v⟩)).index (d (k, ⟨s, v⟩)).dualPoint h *
          paperKernel (Vstar W) ((d (k, ⟨s, v⟩)).smoothingScale X * sourceCuspRadialLength h)) := by
  classical
  let weight := fun q : (O ⧸ Ideal.span {9 * c}) ×
      (Σ s : Finset ι, ∀ i : s, (O ⧸ Ideal.span {p i.val})ˣ) =>
    finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (9 * c) (mul_ne_zero (by norm_num) hc))
      (finiteThetaTwist c Ψ) q.1 *
    (∏ i : {i // i ∉ q.2.1}, finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (p i.val) (hp i.val)) (χ i.val) 0) *
    ∏ i : q.2.1, finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (p i.val) (hp i.val)) (χ i.val) (q.2.2 i)
  have hphase (h : O) : (∑ q, weight q * tracePhase (-cuspFrequency h * (d q).point)) =
      fixedThetaTwist (Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom * primeCuspRowCharacter p χ) h := by
    rw [Fintype.sum_prod_type]
    simp_rw [Fintype.sum_sigma, hd]
    exact primeCuspRow_active_phase_decomposition p hp χ c hc Ψ lift hlift h
  simpa only [weight, Fintype.sum_prod_type, Fintype.sum_sigma] using
    completedT_finite_phase_reflection _ d weight hphase W a b ha hs hW X hX

lemma exists_unit_primary_of_not_lambda_dvd (x : O) (hx : ¬ lambda ∣ x) :
    ∃ u : Oˣ, lambda ^ 2 ∣ (u : O) * x - 1 := by
  have hx0 : x ≠ 0 := by intro hz; exact hx (hz ▸ dvd_zero lambda)
  obtain ⟨u, m, I, hI, he⟩ := exists_unit_lambda_primary_factor x hx0
  have hm : m = 0 := by
    by_contra hm
    apply hx
    rw [he]
    exact dvd_mul_of_dvd_left (dvd_mul_of_dvd_right (dvd_pow_self lambda hm) (u : O)) _
  refine ⟨u⁻¹, ?_⟩
  rw [he, hm, pow_zero, mul_one, ← mul_assoc, Units.inv_mul, one_mul]
  exact (primaryIdealGenerator_spec I hI).2

lemma integralMatrix_cusp_denominator_dvd (M : SL(2, O)) (a c : O) (hc : c ≠ 0)
    (hM : M 1 0 ≠ 0)
    (hratio : ringComplex (M 0 0) / ringComplex (M 1 0) = ringComplex a / ringComplex c) :
    M 1 0 ∣ c := by
  have he : M 0 0 * c = a * M 1 0 := by
    apply ringComplex_injective
    simpa only [map_mul] using
      (div_eq_div_iff (ringComplex_ne_zero hM) (ringComplex_ne_zero hc)).mp hratio
  have hdet : M 0 0 * M 1 1 - M 0 1 * M 1 0 = 1 := by
    simpa only [Matrix.det_fin_two] using M.property
  refine ⟨a * M 1 1 - M 0 1 * c, ?_⟩
  linear_combination -(c * hdet) + M 1 1 * he

/-- Every rational Eisenstein cusp has primitive coordinates with one primary entry and denominator dividing the original. -/
theorem exists_primary_cusp_coordinates (a c : O) (hc : c ≠ 0) :
    ∃ a₀ c₀ : O, c₀ ≠ 0 ∧ IsCoprime a₀ c₀ ∧ c₀ ∣ c ∧
      (lambda ^ 2 ∣ a₀ - 1 ∨ lambda ^ 2 ∣ c₀ - 1) ∧
      ringComplex a₀ / ringComplex c₀ = ringComplex a / ringComplex c := by
  obtain ⟨M, hMc, hratio⟩ := exists_integral_matrix_cusp_ratio a c hc
  have hdet : M 0 0 * M 1 1 - M 0 1 * M 1 0 = 1 := by
    simpa only [Matrix.det_fin_two] using M.property
  have hprimitive : IsCoprime (M 0 0) (M 1 0) := ⟨M 1 1, -M 0 1, by linear_combination hdet⟩
  have hdiv := integralMatrix_cusp_denominator_dvd M a c hc hMc hratio
  have hu : ∃ u : Oˣ, lambda ^ 2 ∣ (u : O) * M 0 0 - 1 ∨ lambda ^ 2 ∣ (u : O) * M 1 0 - 1 := by
    by_cases ha : lambda ∣ M 0 0
    · have hcn : ¬ lambda ∣ M 1 0 := by
        intro hcm
        apply residue_lambda_prime.2.1
        apply isUnit_of_dvd_one
        rw [← hdet]
        exact dvd_sub (dvd_mul_of_dvd_left ha _) (dvd_mul_of_dvd_right hcm _)
      obtain ⟨u, hu⟩ := exists_unit_primary_of_not_lambda_dvd (M 1 0) hcn
      exact ⟨u, Or.inr hu⟩
    · obtain ⟨u, hu⟩ := exists_unit_primary_of_not_lambda_dvd (M 0 0) ha
      exact ⟨u, Or.inl hu⟩
  obtain ⟨u, hu⟩ := hu
  refine ⟨(u : O) * M 0 0, (u : O) * M 1 0, mul_ne_zero u.ne_zero hMc, ?_, ?_, hu, ?_⟩
  · refine ⟨(↑u⁻¹ : O) * M 1 1, -(↑u⁻¹ : O) * M 0 1, ?_⟩
    calc
      _ = ((↑u⁻¹ : O) * (u : O)) * (M 0 0 * M 1 1 - M 0 1 * M 1 0) := by ring
      _ = 1 := by rw [Units.inv_mul, hdet, one_mul]
  · obtain ⟨k, hk⟩ := hdiv
    refine ⟨(↑u⁻¹ : O) * k, ?_⟩
    rw [hk]
    calc
      M 1 0 * k = ((u : O) * (↑u⁻¹ : O)) * (M 1 0 * k) := by rw [Units.mul_inv, one_mul]
      _ = _ := by ring
  · rw [map_mul, map_mul, mul_div_mul_left _ _ (ringComplex_ne_zero u.ne_zero)]
    exact hratio


/-- The smoothed source attached to the unit frequencies of one active prime set. -/
def cuspUnitSourceSum {ι : Type*} [Fintype ι] (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal] (hp : ∀ i, p i ≠ 0)
    (hg : ∀ i, lambda ∉ Ideal.span {p i}) (c : O)
    (M : (∀ i, (O ⧸ Ideal.span {p i})ˣ) → SL(2, O)) (j : ι → ℕ) (V : ℝ → ℂ) (X : ℝ) : ℂ :=
  ∑ v : ∀ i, (O ⧸ Ideal.span {p i})ˣ,
    (∏ i, finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (p i) (hp i))
      (complexSexticChar (Ideal.span {p i}) (hg i) ^ j i : MulChar (O ⧸ Ideal.span {p i}) ℂ) (v i)) *
    ∑' h : O, sourceBarRadialCoefficient (ringComplex (M v 0 0) / ringComplex (c * ∏ i, p i)) h *
      V (sourceCuspRadialLength h / X)

/-- The fixed cusp array with the exact local reflected characters. -/
def nativeCuspStratumKernel {ι : Type*} [Fintype ι] (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal] (hp : ∀ i, p i ≠ 0)
    (hg : ∀ i, lambda ∉ Ideal.span {p i}) (s : FixedCuspSector) (c d U : O) (κ : ℂ)
    (σ ε : ∀ i, (O ⧸ Ideal.span {p i})ˣ) (j : ι → ℕ) (V : ℝ → ℂ) (X : ℝ) : ℂ :=
  fixedCuspReflectionScalar s (c * ∏ i, p i) * ∑' h : O,
    (fixedCuspRadialArray s h *
      paperKernel V (fixedCuspReflectionScale s (c * ∏ i, p i) X * sourceCuspRadialLength h)) *
    ((star κ * tracePhase (-(ringComplex d * ringComplex U * ringComplex
        (sourceCuspIntegralPhaseNumerator (fixedCuspIndex s) (fixedCuspTriangular s 0 0) h)) /
        (ringComplex traceLambda ^ 4 * ringComplex (3 * c)))) *
      cuspLocalReflectedProduct p hp hg σ ε j
        (sourceCuspIntegralPhaseNumerator (fixedCuspIndex s) (fixedCuspTriangular s 0 0) h))

lemma cuspUnitSourceSum_reflection {ι : Type*} [Fintype ι] (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal] (hp : ∀ i, p i ≠ 0)
    (hg : ∀ i, lambda ∉ Ideal.span {p i}) (c : O) (hc : c ≠ 0)
    (M : (∀ i, (O ⧸ Ideal.span {p i})ˣ) → SL(2, O))
    (s : FixedCuspSector) (hsector : ∀ v, fixedCuspSector (M v) = s)
    (hMc : ∀ v, M v 1 0 = c * ∏ i, p i) (j : ι → ℕ)
    (V : ℝ → ℂ) (A B : ℝ) (hA : 0 < A)
    (hs : Function.support V ⊆ Set.Icc A B) (hV : ContDiff ℝ ∞ V) (X : ℝ) (hX : 0 < X) :
    cuspUnitSourceSum p hp hg c M j V X =
      fixedCuspReflectionScalar s (c * ∏ i, p i) * ∑' h : O,
        (fixedCuspRadialArray s h *
          paperKernel V (fixedCuspReflectionScale s (c * ∏ i, p i) X * sourceCuspRadialLength h)) *
        cuspUnitFrequencySum p hp hg c M j
          (sourceCuspIntegralPhaseNumerator (fixedCuspIndex s) (fixedCuspTriangular s 0 0) h) := by
  have hcR : c * ∏ i, p i ≠ 0 := mul_ne_zero hc (Finset.prod_ne_zero_iff.mpr (fun i _ => hp i))
  rw [cuspUnitSourceSum, fixedCusp_finite_smoothed_reflection M s hsector _ hcR hMc _ V A B hA hs hV X hX]
  congr 1
  apply tsum_congr
  intro h
  congr 1
  apply Finset.sum_congr rfl
  intro v hv
  simp only [cuspUnitFrequencySum, fixedCuspInversePhase, map_mul, mul_assoc]

/-- The smoothed reflection of an active prime set uses only constructed arithmetic data. -/
theorem exists_native_smoothed_cusp_reflection {ι : Type*} [Fintype ι] (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal] (hp0 : ∀ i, p i ≠ 0)
    (hg : ∀ i, lambda ∉ Ideal.span {p i})
    (hpair : Pairwise (Function.onFun IsCoprime p)) (hp : ∀ i, lambda ^ 2 ∣ p i - 1)
    (N a c : O) (hc : c ≠ 0) (hN : (27 : O) * c ∣ N)
    (hNp : ∀ i, IsCoprime N (p i)) (hac : IsCoprime a c) (mode : Bool)
    (hbase : if mode then lambda ^ 2 ∣ a - 1 else lambda ^ 2 ∣ c - 1) :
    ∃ (lift : (∀ i, (O ⧸ Ideal.span {p i})ˣ) → ι → O)
      (M : (∀ i, (O ⧸ Ideal.span {p i})ˣ) → SL(2, O))
      (σ ε : ∀ i, (O ⧸ Ideal.span {p i})ˣ) (U : O) (κ : ℂ),
      (∀ v i, N ^ 2 ∣ lift v i) ∧
      (∀ v i, Ideal.Quotient.mk (Ideal.span {p i}) (lift v i) = (v i : O ⧸ Ideal.span {p i})) ∧
      (∀ v, M v 0 0 = cuspCrossNumerator a c traceLambda p (lift v)) ∧
      (∀ v, M v 1 0 = c * ∏ i, p i) ∧
      (∀ v r s, N ∣ M v r s - M (fun _ => 1) r s) ∧
      ‖κ‖ = 1 ∧ ∀ (j : ι → ℕ) (V : ℝ → ℂ) (A B : ℝ), 0 < A →
        Function.support V ⊆ Set.Icc A B → ContDiff ℝ ∞ V → ∀ X : ℝ, 0 < X →
        cuspUnitSourceSum p hp0 hg c M j V X =
          nativeCuspStratumKernel p hp0 hg (fixedCuspSector (M (fun _ => 1))) c
            (M (fun _ => 1) 1 1) U κ σ ε j V X := by
  obtain ⟨lift, M, σ, ε, U, κ, hperiod, hres, hMa, hMc, hfixed, hκ, hreflect⟩ :=
    exists_native_cusp_reflection p hp0 hg hpair hp N a c hc hN hNp hac mode hbase
  have h3N : (3 : O) ∣ N := (show (3 : O) ∣ 27 * c from ⟨9 * c, by ring⟩).trans hN
  have hsector (v) : fixedCuspSector (M v) = fixedCuspSector (M (fun _ => 1)) := by
    apply fixedCuspSector_eq_of_relative
    exact integralMatrix_congruent_levelThree (M v) (M (fun _ => 1))
      (fun i j => h3N.trans (hfixed v i j))
  refine ⟨lift, M, σ, ε, U, κ, hperiod, hres, hMa, hMc, hfixed, hκ, ?_⟩
  intro j V A B hA hs hV X hX
  rw [cuspUnitSourceSum_reflection p hp0 hg c hc M _ hsector hMc j V A B hA hs hV X hX]
  simp_rw [hreflect j]
  rfl


/-- The exponent of the character produced by cubic reflection. -/
def reflectedSexticExponent (j : ℕ) : ℕ := (10 - j) % 6

lemma inverse_reflectedSexticExponent {F : Type*} [CommGroup F] (χ : F) (hχ : χ ^ 6 = 1)
    (j : ℕ) (hj : j < 6) : (χ ^ (j + 2))⁻¹ = χ ^ reflectedSexticExponent j := by
  have hd : 6 ∣ j + 2 + reflectedSexticExponent j := by
    interval_cases j <;> norm_num [reflectedSexticExponent]
  obtain ⟨n, hn⟩ := hd
  apply inv_eq_of_mul_eq_one_right
  rw [← pow_add, hn, pow_mul, hχ, one_pow]

/-- The exceptional fourth power becomes a divisibility bracket; all other powers remain characters. -/
def finiteReflectionBracket {F : Type*} [Field F] [Fintype F]
    (χ : MulChar F ℂ) (j : ℕ) (x : F) : ℂ :=
  if j = 4 then (if x = 0 then (Fintype.card F : ℂ) else 0) - 1
  else (χ ^ reflectedSexticExponent j) x

/-- Canonical local reflection, with its exact squared normalization. -/
theorem finiteReflectionGauss_actual_bracket (P : Ideal O) [P.IsMaximal]
    (hg : lambda ∉ P) (hchar : ringChar (O ⧸ P) ≠ 2)
    (ψ : AddChar (O ⧸ P) ℂ) (hψ : ψ.IsPrimitive) (j : ℕ) (hj : j < 6) :
    ∃ β : ℂ, ‖β‖ ^ 2 = (if j = 0 ∨ j = 4 then (Fintype.card (O ⧸ P) : ℝ)⁻¹ else 1) ∧
      ∀ x, finiteReflectionGauss (complexSexticChar P hg) ψ j x =
        β * finiteReflectionBracket (complexSexticChar P hg) j x := by
  classical
  let χ := complexSexticChar P hg
  have h6 : χ ^ 6 = 1 := (complexSexticChar_powers P hg).2.2
  by_cases hj4 : j = 4
  · subst j
    have h4 : χ ^ 4 ≠ 1 := complexSexticChar_pow_ne_one P hg hchar 4 (by decide) (by decide)
    refine ⟨(Fintype.card (O ⧸ P) : ℂ)⁻¹ * gaussSum (χ ^ 4) (ψ.mulShift (-1)), ?_, ?_⟩
    · rw [if_pos (Or.inr rfl)]
      exact finiteReflectionGauss_fourth_phase_norm_sq χ ψ hψ h4
    · intro x
      simpa only [finiteReflectionBracket, reduceIte] using finiteReflectionGauss_fourth_indicator χ ψ h6 hψ x
  · have hexp : reflectedSexticExponent j < 6 := Nat.mod_lt _ (by decide)
    have hexp0 : reflectedSexticExponent j ≠ 0 := by
      unfold reflectedSexticExponent
      omega
    have hinv := inverse_reflectedSexticExponent χ h6 j hj
    have hnext : χ ^ (j + 2) ≠ 1 := by
      intro he
      apply complexSexticChar_pow_ne_one P hg hchar _ hexp hexp0
      rw [← hinv, he, inv_one]
    refine ⟨(Fintype.card (O ⧸ P) : ℂ)⁻¹ * gaussSum (χ ^ j) (ψ.mulShift (-1)) * gaussSum (χ ^ (j + 2)) ψ, ?_, ?_⟩
    · by_cases hj0 : j = 0
      · subst j
        rw [if_pos (Or.inl rfl)]
        simpa only [pow_zero, zero_add] using finiteReflectionGauss_trivial_phase_norm_sq χ ψ hψ hnext
      · rw [finiteReflectionGauss_phase_norm χ ψ hψ j
          (complexSexticChar_pow_ne_one P hg hchar j hj hj0) hnext,
          one_pow, if_neg (not_or.mpr ⟨hj0, hj4⟩)]
    · intro x
      rw [finiteReflectionGauss_nonexceptional χ ψ j hnext, hinv,
        finiteReflectionBracket, if_neg hj4]

/-- Scaling the reflected frequency by a unit changes only a constant phase. -/
def finiteReflectionUnitFactor {F : Type*} [Field F] [Fintype F]
    (χ : MulChar F ℂ) (j : ℕ) (u : Fˣ) : ℂ :=
  if j = 4 then 1 else (χ ^ reflectedSexticExponent j) u

lemma finiteReflectionUnitFactor_norm {F : Type*} [Field F] [Fintype F]
    (χ : MulChar F ℂ) (j : ℕ) (u : Fˣ) : ‖finiteReflectionUnitFactor χ j u‖ = 1 := by
  by_cases hj : j = 4
  · simp only [finiteReflectionUnitFactor, if_pos hj, norm_one]
  · simp only [finiteReflectionUnitFactor, if_neg hj, finiteMulChar_unit_norm]

lemma finiteReflectionBracket_unit_mul {F : Type*} [Field F] [Fintype F]
    (χ : MulChar F ℂ) (j : ℕ) (u : Fˣ) (x : F) :
    finiteReflectionBracket χ j ((u : F) * x) =
      finiteReflectionUnitFactor χ j u * finiteReflectionBracket χ j x := by
  by_cases hj : j = 4
  · simp only [finiteReflectionBracket, finiteReflectionUnitFactor, if_pos hj, mul_eq_zero, u.ne_zero,
      false_or, one_mul]
  · simp only [finiteReflectionBracket, finiteReflectionUnitFactor, if_neg hj, map_mul]

/-- After extracting one row phase, the full reflection consists of explicit characters and divisor brackets. -/
theorem finiteReflectionGauss_bracket_family
    {ι : Type*} [Fintype ι] (P : ι → Ideal O) [∀ i, (P i).IsMaximal]
    (hg : ∀ i, lambda ∉ P i) (hchar : ∀ i, ringChar (O ⧸ P i) ≠ 2)
    (ψ : ∀ i, AddChar (O ⧸ P i) ℂ) (hψ : ∀ i, (ψ i).IsPrimitive)
    (σ ε : ∀ i, (O ⧸ P i)ˣ) (j : ι → ℕ) (hj : ∀ i, j i < 6) :
    ∃ β : ℂ, ‖β‖ ^ 2 = (∏ i, if j i = 0 ∨ j i = 4 then (Fintype.card (O ⧸ P i) : ℝ)⁻¹ else 1) ∧
      ∀ x : ∀ i, O ⧸ P i,
      (∏ i, ((complexSexticChar (P i) (hg i))⁻¹ ^ 2) (σ i) *
        finiteReflectionGauss (complexSexticChar (P i) (hg i)) (ψ i) (j i) ((ε i : O ⧸ P i) * x i)) =
      β * ∏ i, finiteReflectionBracket (complexSexticChar (P i) (hg i)) (j i) (x i) := by
  classical
  choose β hβnorm hβ using fun i => finiteReflectionGauss_actual_bracket
    (P i) (hg i) (hchar i) (ψ i) (hψ i) (j i) (hj i)
  refine ⟨∏ i, (((complexSexticChar (P i) (hg i))⁻¹ ^ 2) (σ i) * β i *
    finiteReflectionUnitFactor (complexSexticChar (P i) (hg i)) (j i) (ε i)), ?_, ?_⟩
  · simp only [norm_prod, norm_mul, finiteMulChar_unit_norm, finiteReflectionUnitFactor_norm, one_mul, mul_one]
    rw [← Finset.prod_pow]
    exact Finset.prod_congr rfl (fun i _ => hβnorm i)
  · intro x
    simp_rw [hβ, finiteReflectionBracket_unit_mul]
    rw [← Finset.prod_mul_distrib]
    exact Finset.prod_congr rfl (fun i _ => by ring)


/-- The completed row has an exact active-prime reflection with every cusp, matrix, and local phase constructed. -/
theorem completedT_constructed_active_reflection {ι : Type*} [Fintype ι]
    (p : ι → O) [∀ i, (Ideal.span {p i}).IsMaximal] (hp0 : ∀ i, p i ≠ 0)
    (hg : ∀ i, lambda ∉ Ideal.span {p i}) (hp : ∀ i, lambda ^ 2 ∣ p i - 1)
    (hpair : Pairwise (Function.onFun IsCoprime p))
    (N c : O) (hc : c ≠ 0) (hN : (243 : O) * c ∣ N) (hNp : ∀ i, IsCoprime N (p i))
    [Fintype (O ⧸ Ideal.span {9 * c})] (Ψ : (O ⧸ Ideal.span {c}) →* ℂ) (j : ι → ℕ) :
    ∃ (c₀ : (O ⧸ Ideal.span {9 * c}) → O)
      (sector : (O ⧸ Ideal.span {9 * c}) → Finset ι → FixedCuspSector)
      (d U : (O ⧸ Ideal.span {9 * c}) → Finset ι → O)
      (κ : (O ⧸ Ideal.span {9 * c}) → Finset ι → ℂ)
      (σ ε : ∀ k : O ⧸ Ideal.span {9 * c}, ∀ s : Finset ι, ∀ i : s, (O ⧸ Ideal.span {p i.val})ˣ),
      (∀ k, c₀ k ≠ 0 ∧ c₀ k ∣ 9 * c) ∧ (∀ k s, ‖κ k s‖ = 1) ∧
      ∀ (W : ℝ → ℂ) (A B : ℝ), 0 < A → Function.support W ⊆ Set.Icc A B →
        ContDiff ℝ ∞ W → ∀ X : ℝ, 0 < X →
        completedT (Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom *
          primeCuspRowCharacter p (fun i => complexSexticChar (Ideal.span {p i}) (hg i) ^ j i)) W X =
        thetaDerivativeScalar⁻¹ * ∑ k : O ⧸ Ideal.span {9 * c},
          finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (9 * c) (mul_ne_zero (by norm_num) hc))
            (finiteThetaTwist c Ψ) k *
          ∑ s : Finset ι,
            (∏ i : {i // i ∉ s}, finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (p i.val) (hp0 i.val))
              (complexSexticChar (Ideal.span {p i.val}) (hg i.val) ^ j i.val : MulChar (O ⧸ Ideal.span {p i.val}) ℂ) 0) *
            nativeCuspStratumKernel (fun i : s => p i.val) (fun i => hp0 i.val) (fun i => hg i.val)
              (sector k s) (c₀ k) (d k s) (U k s) (κ k s) (σ k s) (ε k s) (fun i => j i.val) (Vstar W) X := by
  classical
  have hcoords (k : O ⧸ Ideal.span {9 * c}) :=
    exists_primary_cusp_coordinates (-3 * Quotient.out k) (9 * c) (mul_ne_zero (by norm_num) hc)
  choose a₀ c₀ hc₀ hcop hcdiv hprimary hratio using hcoords
  have hmode (k) : ∃ mode : Bool, if mode then lambda ^ 2 ∣ a₀ k - 1 else lambda ^ 2 ∣ c₀ k - 1 := by
    rcases hprimary k with ha | hc
    · exact ⟨true, ha⟩
    · exact ⟨false, hc⟩
  choose mode hmode using hmode
  have hNc₀ (k) : (27 : O) * c₀ k ∣ N := by
    apply dvd_trans _ hN
    obtain ⟨t, ht⟩ := hcdiv k
    refine ⟨t, ?_⟩
    linear_combination 27 * ht
  have hbranch (k : O ⧸ Ideal.span {9 * c}) (s : Finset ι) :=
    exists_native_smoothed_cusp_reflection (fun i : s => p i.val) (fun i => hp0 i.val) (fun i => hg i.val)
      (fun i l hil => hpair (by intro he; exact hil (Subtype.ext he))) (fun i => hp i.val)
      N (a₀ k) (c₀ k) (hc₀ k) (hNc₀ k) (fun i => hNp i.val) (hcop k) (mode k) (hmode k)
  choose lift M σ ε U κ hperiod hres hMa hMc hfixed hκ hreflect using hbranch
  let sector := fun k s => fixedCuspSector (M k s (fun _ => 1))
  let d₀ := fun k s => M k s (fun _ => 1) 1 1
  have hM0 (k) (s : Finset ι) (v) : M k s v 1 0 ≠ 0 := by
    rw [hMc]
    exact mul_ne_zero (hc₀ k) (Finset.prod_ne_zero_iff.mpr (fun i _ => hp0 i.val))
  let D := fun q : (O ⧸ Ideal.span {9 * c}) ×
      (Σ s : Finset ι, ∀ i : s, (O ⧸ Ideal.span {p i.val})ˣ) =>
    fixedMatrixCusp (M q.1 q.2.1 q.2.2) (hM0 q.1 q.2.1 q.2.2)
  have hbasePoint (k) : ringComplex (a₀ k) / ringComplex (c₀ k) = thetaFourierTranslation (9 * c) k := by
    rw [hratio]
    simp only [thetaFourierTranslation, map_mul, map_neg, map_ofNat]
  have hpoint (k) (s : Finset ι) (v) : (D (k, ⟨s, v⟩)).point = thetaFourierTranslation (9 * c) k +
      ringComplex traceLambda ^ 2 * ∑ i : s, ringComplex (lift k s v i) / ringComplex (p i.val) := by
    dsimp only [D]
    rw [fixedMatrixCusp_point, hMa, hMc,
      cuspCrossNumerator_fraction (a₀ k) (c₀ k) traceLambda (fun i : s => p i.val) (lift k s v) (hc₀ k) (fun i => hp0 i.val), hbasePoint]
  refine ⟨c₀, sector, d₀, U, κ, σ, ε, (fun k => ⟨hc₀ k, hcdiv k⟩), hκ, ?_⟩
  intro W A B hA hs hW X hX
  have hVs := Vstar_support W A B hs
  have hV := Vstar_contDiff W A B hA hs hW
  rw [completedT_active_primeCusp_reflection p hp0
    (fun i => complexSexticChar (Ideal.span {p i}) (hg i) ^ j i)
    c hc Ψ lift hres D hpoint W A B hA hs hW X hX]
  congr 1
  apply Finset.sum_congr rfl
  intro k hk
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro s hs'
  rw [show nativeCuspStratumKernel (fun i : s => p i.val) (fun i => hp0 i.val) (fun i => hg i.val)
      (sector k s) (c₀ k) (d₀ k s) (U k s) (κ k s) (σ k s) (ε k s) (fun i => j i.val) (Vstar W) X =
      cuspUnitSourceSum (fun i : s => p i.val) (fun i => hp0 i.val) (fun i => hg i.val)
        (c₀ k) (M k s) (fun i => j i.val) (Vstar W) X from
      (hreflect k s (fun i => j i.val) (Vstar W) A B hA hVs hV X hX).symm]
  simp only [cuspUnitSourceSum, Finset.mul_sum]
  refine Finset.sum_congr (by ext v; simp only [Finset.mem_univ]) ?_
  intro v hv
  rw [← (D (k, ⟨s, v⟩)).smoothed_reflection (Vstar W) A B hA hVs hV X hX]
  have hpoint' : (D (k, ⟨s, v⟩)).point = ringComplex (M k s v 0 0) / ringComplex (c₀ k * ∏ i : s, p i.val) := by
    dsimp only [D]
    rw [fixedMatrixCusp_point, hMc]
  rw [hpoint']
  ring



/-- Exceptional local factors expand into signed divisor terms before taking norms. -/
lemma finiteReflectionBracket_divisor_expansion {ι : Type*} [Fintype ι]
    {F : ι → Type*} [∀ i, Field (F i)] [∀ i, Fintype (F i)]
    (χ : ∀ i, MulChar (F i) ℂ) (j : ι → ℕ) (x : ∀ i, F i) :
    (∏ i, finiteReflectionBracket (χ i) (j i) (x i)) =
      ∑ t ∈ (Finset.univ.filter (fun i => j i = 4)).powerset,
        ((-1 : ℂ) ^ t.card * ∏ i ∈ (Finset.univ.filter (fun i => j i = 4)) \ t,
          if x i = 0 then (Fintype.card (F i) : ℂ) else 0) *
        ∏ i ∈ Finset.univ.filter (fun i => j i ≠ 4), (χ i ^ reflectedSexticExponent (j i)) (x i) := by
  classical
  let E := Finset.univ.filter (fun i => j i = 4)
  have he : (∏ i ∈ E, finiteReflectionBracket (χ i) (j i) (x i)) =
      ∏ i ∈ E, ((if x i = 0 then (Fintype.card (F i) : ℂ) else 0) - 1) := by
    apply Finset.prod_congr rfl
    intro i hi
    simp only [finiteReflectionBracket, if_pos (Finset.mem_filter.mp hi).2]
  have hn : (∏ i ∈ Eᶜ, finiteReflectionBracket (χ i) (j i) (x i)) =
      ∏ i ∈ Finset.univ.filter (fun i => j i ≠ 4), (χ i ^ reflectedSexticExponent (j i)) (x i) := by
    have hc : Eᶜ = Finset.univ.filter (fun i => j i ≠ 4) := by ext i; simp [E]
    rw [hc]
    apply Finset.prod_congr rfl
    intro i hi
    simp only [finiteReflectionBracket, if_neg (Finset.mem_filter.mp hi).2]
  rw [← Finset.prod_mul_prod_compl E, he, hn, Finset.prod_sub]
  simp only [Finset.prod_const_one, mul_one, Finset.sum_mul, E]

/-- The selected exceptional factors impose precisely simultaneous prime divisibility. -/
lemma finite_divisor_indicator_product {ι : Type*} (s : Finset ι)
    (p : ι → O) (q : ι → ℂ) (x : O) :
    (∏ i ∈ s, if p i ∣ x then q i else 0) =
      if ∀ i ∈ s, p i ∣ x then ∏ i ∈ s, q i else 0 := by
  classical
  by_cases h : ∀ i ∈ s, p i ∣ x
  · simp only [if_pos h]
    exact Finset.prod_congr rfl (fun i hi => if_pos (h i hi))
  · rw [if_neg h]
    push_neg at h
    obtain ⟨i, hi, hn⟩ := h
    exact Finset.prod_eq_zero hi (if_neg hn)


lemma finiteMulChar_norm_le_one {F : Type*} [Field F] [Fintype F]
    (χ : MulChar F ℂ) (x : F) : ‖χ x‖ ≤ 1 := by
  by_cases hx : x = 0
  · simp only [hx, MulChar.map_zero, norm_zero, zero_le_one]
  · exact (finiteMulChar_unit_norm χ (Units.mk0 x hx)).le

/-- One signed term in the simultaneous exceptional-prime expansion. -/
def finiteReflectionDivisorTerm {ι : Type*} [Fintype ι]
    {F : ι → Type*} [∀ i, Field (F i)] [∀ i, Fintype (F i)]
    (χ : ∀ i, MulChar (F i) ℂ) (j : ι → ℕ) (t : Finset ι) (x : ∀ i, F i) : ℂ :=
  ((-1 : ℂ) ^ t.card * ∏ i ∈ (Finset.univ.filter (fun i => j i = 4)) \ t,
    if x i = 0 then (Fintype.card (F i) : ℂ) else 0) *
    ∏ i ∈ Finset.univ.filter (fun i => j i ≠ 4), (χ i ^ reflectedSexticExponent (j i)) (x i)

lemma finiteReflectionDivisorTerm_norm_le {ι : Type*} [Fintype ι]
    {F : ι → Type*} [∀ i, Field (F i)] [∀ i, Fintype (F i)]
    (χ : ∀ i, MulChar (F i) ℂ) (j : ι → ℕ) (t : Finset ι) (x : ∀ i, F i) :
    ‖finiteReflectionDivisorTerm χ j t x‖ ≤
      ∏ i ∈ (Finset.univ.filter (fun i => j i = 4)) \ t, (Fintype.card (F i) : ℝ) := by
  classical
  have hq (i) : ‖if x i = 0 then (Fintype.card (F i) : ℂ) else 0‖ ≤ (Fintype.card (F i) : ℝ) := by
    split_ifs <;> simp
  have hc : (∏ i ∈ Finset.univ.filter (fun i => j i ≠ 4),
      ‖(χ i ^ reflectedSexticExponent (j i)) (x i)‖) ≤ 1 := by
    exact Finset.prod_le_one (fun _ _ => norm_nonneg _) (fun i _ => finiteMulChar_norm_le_one _ _)
  simp only [finiteReflectionDivisorTerm, norm_mul, norm_pow, norm_neg, norm_one, one_pow,
    one_mul, norm_prod]
  exact (mul_le_mul (Finset.prod_le_prod (fun _ _ => norm_nonneg _) (fun i _ => hq i))
    hc (Finset.prod_nonneg (fun _ _ => norm_nonneg _))
    (Finset.prod_nonneg (fun _ _ => Nat.cast_nonneg _))).trans_eq (mul_one _)

/-- Signed exceptional divisor blocks may be regrouped without estimating the reflected sum. -/
theorem tsum_finiteReflectionBracket_divisor_blocks {α ι : Type*} [Fintype ι]
    {F : ι → Type*} [∀ i, Field (F i)] [∀ i, Fintype (F i)]
    (χ : ∀ i, MulChar (F i) ℂ) (j : ι → ℕ) (a : α → ℂ)
    (ha : Summable (fun h => ‖a h‖)) (x : α → ∀ i, F i) :
    (∑' h, a h * ∏ i, finiteReflectionBracket (χ i) (j i) (x h i)) =
      ∑ t ∈ (Finset.univ.filter (fun i => j i = 4)).powerset,
        ∑' h, a h * finiteReflectionDivisorTerm χ j t (x h) := by
  classical
  have hs (t : Finset ι) : Summable (fun h => a h * finiteReflectionDivisorTerm χ j t (x h)) := by
    apply Summable.of_norm_bounded
      (ha.mul_right (∏ i ∈ (Finset.univ.filter (fun i => j i = 4)) \ t, (Fintype.card (F i) : ℝ)))
    intro h
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (finiteReflectionDivisorTerm_norm_le χ j t (x h)) (norm_nonneg _)
  rw [← Summable.tsum_finsetSum (fun t _ => hs t)]
  apply tsum_congr
  intro h
  rw [finiteReflectionBracket_divisor_expansion, Finset.mul_sum]
  rfl

lemma finiteReflectionDivisorTerm_eisenstein {ι : Type*} [Fintype ι]
    (p : ι → O) [∀ i, (Ideal.span {p i}).IsMaximal]
    (hg : ∀ i, lambda ∉ Ideal.span {p i}) (j : ι → ℕ) (t : Finset ι) (x : O) :
    finiteReflectionDivisorTerm (fun i => complexSexticChar (Ideal.span {p i}) (hg i)) j t
      (fun i => Ideal.Quotient.mk (Ideal.span {p i}) x) =
      ((-1 : ℂ) ^ t.card *
        (if ∀ i ∈ (Finset.univ.filter (fun i => j i = 4)) \ t, p i ∣ x then
          ∏ i ∈ (Finset.univ.filter (fun i => j i = 4)) \ t,
            (Fintype.card (O ⧸ Ideal.span {p i}) : ℂ) else 0)) *
      ∏ i ∈ Finset.univ.filter (fun i => j i ≠ 4),
        (complexSexticChar (Ideal.span {p i}) (hg i) ^ reflectedSexticExponent (j i))
          (Ideal.Quotient.mk (Ideal.span {p i}) x) := by
  classical
  unfold finiteReflectionDivisorTerm
  simp only [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton]
  rw [finite_divisor_indicator_product]
  split_ifs <;> rfl


/-- A reflected prime row has one scalar phase and explicit exceptional divisor factors. -/
theorem cuspLocalReflectedProduct_brackets {ι : Type*} [Fintype ι] (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal] (hp : ∀ i, p i ≠ 0)
    (hg : ∀ i, lambda ∉ Ideal.span {p i}) (hchar : ∀ i, ringChar (O ⧸ Ideal.span {p i}) ≠ 2)
    (σ ε : ∀ i, (O ⧸ Ideal.span {p i})ˣ) (j : ι → ℕ) (hj : ∀ i, j i < 6) :
    ∃ β : ℂ, ‖β‖ ^ 2 = (∏ i, if j i = 0 ∨ j i = 4 then
        (Fintype.card (O ⧸ Ideal.span {p i}) : ℝ)⁻¹ else 1) ∧
      ∀ x : O, cuspLocalReflectedProduct p hp hg σ ε j x =
        β * ∏ i, finiteReflectionBracket (complexSexticChar (Ideal.span {p i}) (hg i)) (j i)
          (Ideal.Quotient.mk (Ideal.span {p i}) x) := by
  obtain ⟨β, hn, he⟩ := finiteReflectionGauss_bracket_family
    (fun i => Ideal.span {p i}) hg hchar (fun i => residueTraceQuotientChar 1 (p i) (hp i))
    (fun i => residueTraceQuotientChar_primitive (p i) (hp i)) σ ε j hj
  exact ⟨β, hn, fun x => he (fun i => Ideal.Quotient.mk (Ideal.span {p i}) x)⟩

/-- The fixed array has the same exact squarefree–cube indexing as its cusp coefficient. -/
lemma fixedCuspRadialArray_tsum_full_index (s : FixedCuspSector) (W : O → ℂ) :
    (∑' h : O, fixedCuspRadialArray s h * W h) =
      ∑' q : ThetaFullIndex, fixedCuspRadialArray s (thetaFullFrequency q) * W (thetaFullFrequency q) := by
  exact sourceCuspRadial_tsum_full_index (fixedCuspIndex s)
    (ringComplex (fixedCuspTriangular s 0 0 * fixedCuspTriangular s 0 1)) W

/-- Canonical reflection exposes the cube labels before any absolute-value estimate. -/
theorem nativeCuspStratumKernel_full_brackets {ι : Type*} [Fintype ι] (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal] (hp : ∀ i, p i ≠ 0)
    (hg : ∀ i, lambda ∉ Ideal.span {p i}) (hchar : ∀ i, ringChar (O ⧸ Ideal.span {p i}) ≠ 2)
    (s : FixedCuspSector) (c d U : O) (κ : ℂ)
    (σ ε : ∀ i, (O ⧸ Ideal.span {p i})ˣ) (j : ι → ℕ) (hj : ∀ i, j i < 6) :
    ∃ β : ℂ, ‖β‖ ^ 2 = (∏ i, if j i = 0 ∨ j i = 4 then
        (Fintype.card (O ⧸ Ideal.span {p i}) : ℝ)⁻¹ else 1) ∧
      ∀ (V : ℝ → ℂ) (X : ℝ), nativeCuspStratumKernel p hp hg s c d U κ σ ε j V X =
        (fixedCuspReflectionScalar s (c * ∏ i, p i) * star κ * β) *
        ∑' q : ThetaFullIndex,
          (fixedCuspRadialArray s (thetaFullFrequency q) *
            paperKernel V (fixedCuspReflectionScale s (c * ∏ i, p i) X *
              (‖ringComplex lambda‖ ^ (2 * q.2.1) * completedMellinLength q.2.2))) *
          tracePhase (-(ringComplex d * ringComplex U * ringComplex
            (sourceCuspIntegralPhaseNumerator (fixedCuspIndex s) (fixedCuspTriangular s 0 0)
              (thetaFullFrequency q))) / (ringComplex traceLambda ^ 4 * ringComplex (3 * c))) *
          ∏ i, finiteReflectionBracket (complexSexticChar (Ideal.span {p i}) (hg i)) (j i)
            (Ideal.Quotient.mk (Ideal.span {p i})
              (sourceCuspIntegralPhaseNumerator (fixedCuspIndex s) (fixedCuspTriangular s 0 0)
                (thetaFullFrequency q))) := by
  obtain ⟨β, hn, he⟩ := cuspLocalReflectedProduct_brackets p hp hg hchar σ ε j hj
  refine ⟨β, hn, ?_⟩
  intro V X
  unfold nativeCuspStratumKernel
  simp_rw [he]
  have hr (h : O) (K P L : ℂ) :
      (fixedCuspRadialArray s h * K) * ((star κ * P) * (β * L)) =
        (star κ * β) * (fixedCuspRadialArray s h * (K * P * L)) := by ring
  simp_rw [hr]
  rw [tsum_mul_left, fixedCuspRadialArray_tsum_full_index]
  simp only [thetaFullFrequency_radialLength]
  simp only [mul_assoc]

/-- Exact divisor regrouping of the reflected cusp series; all signed blocks remain inside the row. -/
theorem nativeCuspStratumKernel_divisor_blocks {ι : Type*} [Fintype ι] (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal] (hp : ∀ i, p i ≠ 0)
    (hg : ∀ i, lambda ∉ Ideal.span {p i}) (hchar : ∀ i, ringChar (O ⧸ Ideal.span {p i}) ≠ 2)
    (s : FixedCuspSector) (c d U : O) (hc : c ≠ 0) (κ : ℂ)
    (σ ε : ∀ i, (O ⧸ Ideal.span {p i})ˣ) (j : ι → ℕ) (hj : ∀ i, j i < 6) :
    ∃ β : ℂ, ‖β‖ ^ 2 = (∏ i, if j i = 0 ∨ j i = 4 then
        (Fintype.card (O ⧸ Ideal.span {p i}) : ℝ)⁻¹ else 1) ∧
      ∀ (V : ℝ → ℂ) (A B : ℝ), 0 < A → Function.support V ⊆ Set.Icc A B →
        ContDiff ℝ ∞ V → ∀ X : ℝ, 0 < X →
        nativeCuspStratumKernel p hp hg s c d U κ σ ε j V X =
        (fixedCuspReflectionScalar s (c * ∏ i, p i) * star κ * β) *
        ∑ t ∈ (Finset.univ.filter (fun i => j i = 4)).powerset,
        ∑' q : ThetaFullIndex,
          (fixedCuspRadialArray s (thetaFullFrequency q) *
            paperKernel V (fixedCuspReflectionScale s (c * ∏ i, p i) X *
              (‖ringComplex lambda‖ ^ (2 * q.2.1) * completedMellinLength q.2.2))) *
          tracePhase (-(ringComplex d * ringComplex U * ringComplex
            (sourceCuspIntegralPhaseNumerator (fixedCuspIndex s) (fixedCuspTriangular s 0 0)
              (thetaFullFrequency q))) / (ringComplex traceLambda ^ 4 * ringComplex (3 * c))) *
          finiteReflectionDivisorTerm (fun i => complexSexticChar (Ideal.span {p i}) (hg i)) j t
            (fun i => Ideal.Quotient.mk (Ideal.span {p i})
              (sourceCuspIntegralPhaseNumerator (fixedCuspIndex s) (fixedCuspTriangular s 0 0)
                (thetaFullFrequency q))) := by
  classical
  obtain ⟨β, hn, he⟩ := cuspLocalReflectedProduct_brackets p hp hg hchar σ ε j hj
  refine ⟨β, hn, ?_⟩
  intro V A B hA hs hV X hX
  let n : O → O := sourceCuspIntegralPhaseNumerator (fixedCuspIndex s) (fixedCuspTriangular s 0 0)
  let a : O → ℂ := fun h =>
    (fixedCuspRadialArray s h * paperKernel V (fixedCuspReflectionScale s (c * ∏ i, p i) X * sourceCuspRadialLength h)) *
    tracePhase (-(ringComplex d * ringComplex U * ringComplex (n h)) /
      (ringComplex traceLambda ^ 4 * ringComplex (3 * c)))
  have ha : Summable (fun h => ‖a h‖) := by
    simpa only [a, norm_mul, tracePhase_norm, mul_one] using
      fixedCuspRadialArray_kernel_norm_summable s V A B hA hs hV _
        (fixedCuspReflectionScale_pos s _ (mul_ne_zero hc (Finset.prod_ne_zero_iff.mpr (fun i _ => hp i))) X hX)
  have hk : nativeCuspStratumKernel p hp hg s c d U κ σ ε j V X =
      (fixedCuspReflectionScalar s (c * ∏ i, p i) * star κ * β) *
        ∑' h : O, a h * ∏ i, finiteReflectionBracket (complexSexticChar (Ideal.span {p i}) (hg i)) (j i)
          (Ideal.Quotient.mk (Ideal.span {p i}) (n h)) := by
    calc
      _ = fixedCuspReflectionScalar s (c * ∏ i, p i) * ((star κ * β) *
          ∑' h : O, a h * ∏ i, finiteReflectionBracket (complexSexticChar (Ideal.span {p i}) (hg i)) (j i)
            (Ideal.Quotient.mk (Ideal.span {p i}) (n h))) := by
        unfold nativeCuspStratumKernel
        congr 1
        rw [← tsum_mul_left]
        apply tsum_congr
        intro h
        rw [he]
        dsimp only [a, n]
        ring
      _ = _ := by ring
  rw [hk, tsum_finiteReflectionBracket_divisor_blocks _ j a ha]
  congr 1
  apply Finset.sum_congr rfl
  intro t ht
  dsimp only [a, n]
  simp only [mul_assoc]
  rw [fixedCuspRadialArray_tsum_full_index]
  simp only [thetaFullFrequency_radialLength]



/-- Cubing the argument retains exactly the quadratic parity of a sextic character power. -/
lemma sextic_character_cube_parity {F : Type*} [Field F]
    (χ : MulChar F ℂ) (hχ : χ ^ 6 = 1) (k : ℕ) (a b : F) :
    (χ ^ k) (a * b ^ 3) = (χ ^ k) a * (χ ^ (3 * (k % 2))) b := by
  have he : k * 3 = 6 * (k / 2) + 3 * (k % 2) := by omega
  rw [map_mul, map_pow, ← MulChar.pow_apply' (χ ^ k) (by decide : (3 : ℕ) ≠ 0),
    ← pow_mul, he, pow_add, pow_mul, hχ, one_pow, one_mul]

lemma reflectedSexticExponent_parity (j : ℕ) (hj : j < 6) :
    reflectedSexticExponent j % 2 = j % 2 := by
  interval_cases j <;> norm_num [reflectedSexticExponent]

/-- The cube factor in every nonexceptional reflected row carries only a quadratic character. -/
lemma reflected_sextic_cube_parity (P : Ideal O) [P.IsMaximal]
    (hg : lambda ∉ P) (j : ℕ) (hj : j < 6) (a b : O ⧸ P) :
    (complexSexticChar P hg ^ reflectedSexticExponent j) (a * b ^ 3) =
      (complexSexticChar P hg ^ reflectedSexticExponent j) a *
        (complexSexticChar P hg ^ (3 * (j % 2))) b := by
  rw [sextic_character_cube_parity _ (complexSexticChar_powers P hg).2.2,
    reflectedSexticExponent_parity j hj]

/-- The simultaneous reflected cube character separates before the squarefree and cube sums. -/
theorem reflected_character_product_cube_parity {ι : Type*} [Fintype ι]
    (P : ι → Ideal O) [∀ i, (P i).IsMaximal] (hg : ∀ i, lambda ∉ P i)
    (j : ι → ℕ) (hj : ∀ i, j i < 6) (a b : O) :
    (∏ i ∈ Finset.univ.filter (fun i => j i ≠ 4),
      (complexSexticChar (P i) (hg i) ^ reflectedSexticExponent (j i))
        (Ideal.Quotient.mk (P i) (a * b ^ 3))) =
      (∏ i ∈ Finset.univ.filter (fun i => j i ≠ 4),
        (complexSexticChar (P i) (hg i) ^ reflectedSexticExponent (j i)) (Ideal.Quotient.mk (P i) a)) *
      ∏ i ∈ Finset.univ.filter (fun i => j i ≠ 4),
        (complexSexticChar (P i) (hg i) ^ (3 * (j i % 2))) (Ideal.Quotient.mk (P i) b) := by
  rw [← Finset.prod_mul_distrib]
  apply Finset.prod_congr rfl
  intro i hi
  rw [map_mul, map_pow, reflected_sextic_cube_parity _ _ _ (hj i)]

/-- The exceptional divisor condition splits into disjoint squarefree and cube cases. -/
lemma prime_divisor_cube_indicator (p a b : O) (hp : Prime p) :
    (if p ∣ a * b ^ 3 then (1 : ℂ) else 0) =
      (if p ∣ a then 1 else 0) + (if ¬ p ∣ a ∧ p ∣ b then 1 else 0) := by
  have hd : p ∣ a * b ^ 3 ↔ p ∣ a ∨ p ∣ b := by
    rw [hp.dvd_mul]
    constructor
    · exact fun h => h.elim Or.inl (fun hb => Or.inr (hp.dvd_of_dvd_pow hb))
    · exact fun h => h.elim Or.inl (fun hb => Or.inr (dvd_pow hb (by decide)))
  by_cases ha : p ∣ a <;> by_cases hb : p ∣ b <;> simp only [hd, ha, hb, or_true,
    true_or, false_or, not_true_eq_false, not_false_eq_true, and_true, and_false,
    false_and, true_and, reduceIte] <;> norm_num

/-- An omitted prime contributes its coprimality density exactly when its row exponent vanishes. -/
lemma finiteAdditiveFourier_sextic_zero (P : Ideal O) [P.IsMaximal]
    (hg : lambda ∉ P) (hchar : ringChar (O ⧸ P) ≠ 2)
    (ψ : AddChar (O ⧸ P) ℂ) (j : ℕ) (hj : j < 6) :
    finiteAdditiveFourierCoeff ψ (complexSexticChar P hg ^ j : MulChar (O ⧸ P) ℂ) 0 =
      if j = 0 then ((Fintype.card (O ⧸ P) : ℂ) - 1) / Fintype.card (O ⧸ P) else 0 := by
  rw [finiteAdditiveFourierCoeff_mulChar_zero]
  by_cases hj0 : j = 0
  · simp only [hj0, pow_zero, reduceIte]
    rw [Nat.card_eq_fintype_card, Fintype.card_units,
      Nat.cast_sub (Nat.succ_le_of_lt Fintype.card_pos), Nat.cast_one]
  · rw [if_neg (complexSexticChar_pow_ne_one P hg hchar j hj hj0), if_neg hj0]


/-- Away from the fixed modulus, the integral cusp frequency differs from the original by a unit. -/
theorem sourceCuspIntegralPhaseNumerator_quotient_unit (p N : O)
    [hp : (Ideal.span {p}).IsMaximal] (hN : (9 : O) ∣ N) (hNp : IsCoprime N p)
    (s : FixedCuspSector) :
    ∃ u : (O ⧸ Ideal.span {p})ˣ, ∀ h : O,
      Ideal.Quotient.mk (Ideal.span {p})
        (sourceCuspIntegralPhaseNumerator (fixedCuspIndex s) (fixedCuspTriangular s 0 0) h) =
        (u : O ⧸ Ideal.span {p}) * Ideal.Quotient.mk (Ideal.span {p}) h := by
  let q := Ideal.Quotient.mk (Ideal.span {p})
  have h3N : (3 : O) ∣ N := (show (3 : O) ∣ 9 from ⟨3, by norm_num⟩).trans hN
  have hlN : traceLambda ∣ N := (show traceLambda ∣ (9 : O) from
    ⟨traceLambda ^ 3, by rw [← traceLambda_pow_four]; ring⟩).trans hN
  have h3 : IsUnit (q 3) := (isUnit_quotient_span_iff p 3).mpr
    (hNp.of_isCoprime_of_dvd_left h3N).symm
  have hl : IsUnit (q traceLambda) := (isUnit_quotient_span_iff p traceLambda).mpr
    (hNp.of_isCoprime_of_dvd_left hlN).symm
  have hu : IsUnit (q (fixedCuspTriangular s 0 0)) :=
    (fixedCuspTriangular_properties s).2.1.map q
  have hfactor : IsUnit (q ((if fixedCuspIndex s = 0 then 3 else 1) * traceLambda *
      fixedCuspTriangular s 0 0 ^ 2)) := by
    rw [map_mul, map_mul, map_pow]
    apply IsUnit.mul _ (hu.pow 2)
    apply IsUnit.mul _ hl
    split_ifs
    · exact h3
    · exact isUnit_one
  obtain ⟨u, he⟩ := hfactor
  refine ⟨u, ?_⟩
  intro h
  change q (_ * h) = (u : O ⧸ Ideal.span {p}) * q h
  rw [map_mul, ← he]

/-- Unit changes of local coordinates contribute a single norm-one row factor. -/
theorem finiteReflectionBracket_unit_family {ι : Type*} [Fintype ι]
    {F : ι → Type*} [∀ i, Field (F i)] [∀ i, Fintype (F i)]
    (χ : ∀ i, MulChar (F i) ℂ) (j : ι → ℕ) (u : ∀ i, (F i)ˣ) :
    ∃ γ : ℂ, ‖γ‖ = 1 ∧ ∀ x : ∀ i, F i,
      (∏ i, finiteReflectionBracket (χ i) (j i) ((u i : F i) * x i)) =
        γ * ∏ i, finiteReflectionBracket (χ i) (j i) (x i) := by
  refine ⟨∏ i, finiteReflectionUnitFactor (χ i) (j i) (u i), ?_, ?_⟩
  · simp only [norm_prod, finiteReflectionUnitFactor_norm, Finset.prod_const_one]
  · intro x
    simp only [finiteReflectionBracket_unit_mul, Finset.prod_mul_distrib]

/-- A nonzero integral frequency scaling changes only the constant phase of a reflected row. -/
theorem cuspLocalReflectedProduct_original_frequency {ι : Type*} [Fintype ι]
    (p : ι → O) [∀ i, (Ideal.span {p i}).IsMaximal] (hp : ∀ i, p i ≠ 0)
    (hg : ∀ i, lambda ∉ Ideal.span {p i}) (hchar : ∀ i, ringChar (O ⧸ Ideal.span {p i}) ≠ 2)
    (N : O) (hN : (9 : O) ∣ N) (hNp : ∀ i, IsCoprime N (p i)) (s : FixedCuspSector)
    (σ ε : ∀ i, (O ⧸ Ideal.span {p i})ˣ) (j : ι → ℕ) (hj : ∀ i, j i < 6) :
    ∃ β : ℂ, ‖β‖ ^ 2 = (∏ i, if j i = 0 ∨ j i = 4 then
        (Fintype.card (O ⧸ Ideal.span {p i}) : ℝ)⁻¹ else 1) ∧
      ∀ h : O, cuspLocalReflectedProduct p hp hg σ ε j
          (sourceCuspIntegralPhaseNumerator (fixedCuspIndex s) (fixedCuspTriangular s 0 0) h) =
        β * ∏ i, finiteReflectionBracket (complexSexticChar (Ideal.span {p i}) (hg i)) (j i)
          (Ideal.Quotient.mk (Ideal.span {p i}) h) := by
  classical
  choose u hu using fun i => sourceCuspIntegralPhaseNumerator_quotient_unit (p i) N hN (hNp i) s
  obtain ⟨β, hn, he⟩ := cuspLocalReflectedProduct_brackets p hp hg hchar σ ε j hj
  obtain ⟨γ, hγ, hγe⟩ := finiteReflectionBracket_unit_family
    (fun i => complexSexticChar (Ideal.span {p i}) (hg i)) j u
  refine ⟨β * γ, ?_, ?_⟩
  · rw [norm_mul, mul_pow, hγ, one_pow, mul_one, hn]
  · intro h
    rw [he]
    simp_rw [hu]
    rw [hγe, mul_assoc]


/-- Reflected arithmetic coefficients range over a fixed residue modulus, independently of the prime row. -/
def fixedCuspPeriodicArray (N c : O) (s : FixedCuspSector)
    (b : O ⧸ Ideal.span {N}) (h : O) : ℂ :=
  fixedCuspRadialArray s h * fixedCuspInversePhase s c (Quotient.out b) h

lemma fixedCuspPeriodicArray_norm (N c : O) (s : FixedCuspSector)
    (b : O ⧸ Ideal.span {N}) (h : O) :
    ‖fixedCuspPeriodicArray N c s b h‖ = ‖fixedCuspRadialArray s h‖ := by
  rw [fixedCuspPeriodicArray, norm_mul, fixedCuspInversePhase_norm, mul_one]

lemma fixedCuspInversePhase_residue (N c d : O) (hc : c ≠ 0) (hN : 27 * c ∣ N)
    (s : FixedCuspSector) (h : O) :
    fixedCuspInversePhase s c d h =
      fixedCuspInversePhase s c (Quotient.out (Ideal.Quotient.mk (Ideal.span {N}) d)) h := by
  have hmod : N ∣ d - Quotient.out (Ideal.Quotient.mk (Ideal.span {N}) d) :=
    Ideal.mem_span_singleton.mp (Ideal.Quotient.eq.mp (Ideal.Quotient.mk_out _).symm)
  have he := cuspInverse_fixed_phase_congr (3 * c) d
    (Quotient.out (Ideal.Quotient.mk (Ideal.span {N}) d)) 1
    (sourceCuspIntegralPhaseNumerator (fixedCuspIndex s) (fixedCuspTriangular s 0 0) h)
    (mul_ne_zero (by norm_num) hc) (((cuspInverse_fixed_modulus_dvd c).trans hN).trans hmod)
  simpa only [fixedCuspInversePhase, map_one, mul_one] using he

lemma fixedCuspPeriodicArray_tsum_full_index (N c : O) (s : FixedCuspSector)
    (b : O ⧸ Ideal.span {N}) (W : O → ℂ) :
    (∑' h : O, fixedCuspPeriodicArray N c s b h * W h) =
      ∑' q : ThetaFullIndex, fixedCuspPeriodicArray N c s b (thetaFullFrequency q) * W (thetaFullFrequency q) := by
  simp only [fixedCuspPeriodicArray, mul_assoc]
  exact fixedCuspRadialArray_tsum_full_index s _

lemma fixedCuspPeriodicArray_kernel_norm_summable (N c : O) (s : FixedCuspSector)
    (b : O ⧸ Ideal.span {N}) (V : ℝ → ℂ) (A B : ℝ) (hA : 0 < A)
    (hs : Function.support V ⊆ Set.Icc A B) (hV : ContDiff ℝ ∞ V) (R : ℝ) (hR : 0 < R) :
    Summable (fun h : O => ‖fixedCuspPeriodicArray N c s b h * paperKernel V (R * sourceCuspRadialLength h)‖) := by
  simpa only [norm_mul, fixedCuspPeriodicArray_norm] using
    fixedCuspRadialArray_kernel_norm_summable s V A B hA hs hV R hR

lemma fixedCuspReflectionScale_prime_product {ι : Type*} [Fintype ι]
    (p : ι → O) (s : FixedCuspSector) (c : O) (X : ℝ) :
    fixedCuspReflectionScale s (c * ∏ i, p i) X =
      fixedCuspReflectionScale s c (X / ‖ringComplex (∏ i, p i)‖ ^ 4) := by
  unfold fixedCuspReflectionScale
  rw [map_mul, norm_mul, mul_pow]
  ring

lemma fixedCuspReflectionScalar_norm (s : FixedCuspSector) (c : O) (hc : c ≠ 0) :
    ‖fixedCuspReflectionScalar s c‖ = (sourceCuspScale (fixedCuspIndex s)) ^ 2 := by
  obtain ⟨u, hu⟩ := (fixedCuspTriangular_properties s).2.1
  have hn : ‖ringComplex (fixedCuspTriangular s 0 0)‖ = 1 := by
    rw [← hu]
    exact norm_ringComplex_unit u
  have hc' : ‖ringComplex c‖ ≠ 0 := (norm_pos_iff.mpr (ringComplex_ne_zero hc)).ne'
  simp only [fixedCuspReflectionScalar, norm_mul, norm_neg, norm_pow, norm_div, norm_star,
    hn, one_pow, div_self hc', one_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos (sourceCuspScale_pos _)]

lemma fixedCuspReflectionScalar_norm_sq_le (s : FixedCuspSector) (c : O) (hc : c ≠ 0) :
    ‖fixedCuspReflectionScalar s c‖ ^ 2 ≤ 81 := by
  rw [fixedCuspReflectionScalar_norm s c hc]
  have hs : (sourceCuspScale (fixedCuspIndex s)) ^ 2 ≤ 9 := by
    generalize fixedCuspIndex s = j
    fin_cases j <;> norm_num [sourceCuspScale]
  exact (pow_le_pow_left₀ (sq_nonneg _) hs 2).trans_eq (by norm_num)


/-- Signed divisor blocks built from a fixed cusp coefficient array and quadratic cube characters. -/
def fixedCuspDivisorSeries {ι : Type*} [Fintype ι] (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal] (hg : ∀ i, lambda ∉ Ideal.span {p i})
    (N c : O) (s : FixedCuspSector) (b : O ⧸ Ideal.span {N}) (j : ι → ℕ) (V : ℝ → ℂ) (X : ℝ) : ℂ :=
  ∑ t ∈ (Finset.univ.filter (fun i => j i = 4)).powerset,
    ∑' q : ThetaFullIndex,
      (fixedCuspPeriodicArray N c s b (thetaFullFrequency q) *
        paperKernel V (fixedCuspReflectionScale s c (X / ‖ringComplex (∏ i, p i)‖ ^ 4) *
          (‖ringComplex lambda‖ ^ (2 * q.2.1) * completedMellinLength q.2.2))) *
      finiteReflectionDivisorTerm (fun i => complexSexticChar (Ideal.span {p i}) (hg i)) j t
        (fun i => Ideal.Quotient.mk (Ideal.span {p i}) (thetaFullFrequency q))

/-- The arithmetic reflection is an exact finite-modulus divisor series with the sharp Gauss normalization. -/
theorem nativeCuspStratumKernel_canonical {ι : Type*} [Fintype ι] (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal] (hp : ∀ i, p i ≠ 0)
    (hg : ∀ i, lambda ∉ Ideal.span {p i}) (hchar : ∀ i, ringChar (O ⧸ Ideal.span {p i}) ≠ 2)
    (N c d U : O) (hc : c ≠ 0) (hN : 27 * c ∣ N) (hNp : ∀ i, IsCoprime N (p i))
    (s : FixedCuspSector) (κ : ℂ) (σ ε : ∀ i, (O ⧸ Ideal.span {p i})ˣ)
    (j : ι → ℕ) (hj : ∀ i, j i < 6) :
    ∃ β : ℂ, ‖β‖ ^ 2 = (∏ i, if j i = 0 ∨ j i = 4 then
        (Fintype.card (O ⧸ Ideal.span {p i}) : ℝ)⁻¹ else 1) ∧
      ∀ (V : ℝ → ℂ) (A B : ℝ), 0 < A → Function.support V ⊆ Set.Icc A B →
        ContDiff ℝ ∞ V → ∀ X : ℝ, 0 < X →
        nativeCuspStratumKernel p hp hg s c d U κ σ ε j V X =
          (fixedCuspReflectionScalar s (c * ∏ i, p i) * star κ * β) *
          fixedCuspDivisorSeries p hg N c s (Ideal.Quotient.mk (Ideal.span {N}) (d * U)) j V X := by
  classical
  have h9N : (9 : O) ∣ N := (show (9 : O) ∣ 27 * c from ⟨3 * c, by ring⟩).trans hN
  obtain ⟨β, hn, he⟩ := cuspLocalReflectedProduct_original_frequency p hp hg hchar N h9N hNp s σ ε j hj
  refine ⟨β, hn, ?_⟩
  intro V A B hA hs hV X hX
  let b := Ideal.Quotient.mk (Ideal.span {N}) (d * U)
  let R := fixedCuspReflectionScale s c (X / ‖ringComplex (∏ i, p i)‖ ^ 4)
  have hpR : 0 < R := by
    dsimp only [R]
    rw [← fixedCuspReflectionScale_prime_product p s c X]
    exact fixedCuspReflectionScale_pos s _ (mul_ne_zero hc (Finset.prod_ne_zero_iff.mpr (fun i _ => hp i))) X hX
  let a : O → ℂ := fun h => fixedCuspPeriodicArray N c s b h * paperKernel V (R * sourceCuspRadialLength h)
  have ha : Summable (fun h => ‖a h‖) := fixedCuspPeriodicArray_kernel_norm_summable N c s b V A B hA hs hV R hpR
  have hphase (h : O) : tracePhase (-(ringComplex d * ringComplex U * ringComplex
      (sourceCuspIntegralPhaseNumerator (fixedCuspIndex s) (fixedCuspTriangular s 0 0) h)) /
      (ringComplex traceLambda ^ 4 * ringComplex (3 * c))) = fixedCuspInversePhase s c (Quotient.out b) h := by
    simpa only [fixedCuspInversePhase, map_mul, b] using fixedCuspInversePhase_residue N c (d * U) hc hN s h
  have hk : nativeCuspStratumKernel p hp hg s c d U κ σ ε j V X =
      (fixedCuspReflectionScalar s (c * ∏ i, p i) * star κ * β) *
        ∑' h : O, a h * ∏ i, finiteReflectionBracket (complexSexticChar (Ideal.span {p i}) (hg i)) (j i)
          (Ideal.Quotient.mk (Ideal.span {p i}) h) := by
    calc
      _ = fixedCuspReflectionScalar s (c * ∏ i, p i) * ((star κ * β) *
          ∑' h : O, a h * ∏ i, finiteReflectionBracket (complexSexticChar (Ideal.span {p i}) (hg i)) (j i)
            (Ideal.Quotient.mk (Ideal.span {p i}) h)) := by
        unfold nativeCuspStratumKernel
        congr 1
        rw [← tsum_mul_left]
        apply tsum_congr
        intro h
        rw [he, hphase, fixedCuspReflectionScale_prime_product]
        dsimp only [a, R, fixedCuspPeriodicArray]
        ring
      _ = _ := by ring
  rw [hk, tsum_finiteReflectionBracket_divisor_blocks _ j a ha]
  unfold fixedCuspDivisorSeries
  congr 1
  apply Finset.sum_congr rfl
  intro t ht
  dsimp only [a, b, R]
  simp only [mul_assoc]
  rw [fixedCuspPeriodicArray_tsum_full_index]
  simp only [thetaFullFrequency_radialLength]




/-- Squared Gauss normalization at an active prime. -/
def reflectedActiveMass (q : ℝ) (j : ℕ) : ℝ :=
  if j = 0 ∨ j = 4 then q⁻¹ else 1

/-- Density of the zero Fourier frequency at an inactive prime. -/
def reflectedInactiveMass (q : ℝ) (j : ℕ) : ℝ :=
  if j = 0 then 1 - q⁻¹ else 0

lemma reflectedActiveMass_nonneg (q : ℝ) (hq : 0 ≤ q) (j : ℕ) :
    0 ≤ reflectedActiveMass q j := by
  unfold reflectedActiveMass
  split_ifs <;> positivity

lemma reflectedInactiveMass_nonneg (q : ℝ) (hq : 1 ≤ q) (j : ℕ) :
    0 ≤ reflectedInactiveMass q j := by
  unfold reflectedInactiveMass
  split_ifs
  · exact sub_nonneg.mpr (inv_le_one_of_one_le₀ hq)
  · exact le_rfl

/-- Summing every active-prime stratum preserves total mass; only the fourth-power primes cost density. -/
theorem reflected_branch_mass {ι : Type*} [Fintype ι] (q : ι → ℝ) (j : ι → ℕ) :
    (∑ s : Finset ι, (∏ i ∈ s, reflectedActiveMass (q i) (j i)) *
      ∏ i ∈ sᶜ, reflectedInactiveMass (q i) (j i)) =
      ∏ i, if j i = 4 then (q i)⁻¹ else 1 := by
  classical
  rw [← Fintype.prod_add]
  apply Finset.prod_congr rfl
  intro i hi
  by_cases h0 : j i = 0
  · simp [reflectedActiveMass, reflectedInactiveMass, h0] <;> ring
  · by_cases h4 : j i = 4
    · simp [reflectedActiveMass, reflectedInactiveMass, h0, h4] <;> ring
    · simp [reflectedActiveMass, reflectedInactiveMass, h0, h4] <;> ring

lemma finiteAdditiveFourier_sextic_zero_real (P : Ideal O) [P.IsMaximal]
    (hg : lambda ∉ P) (hchar : ringChar (O ⧸ P) ≠ 2)
    (ψ : AddChar (O ⧸ P) ℂ) (j : ℕ) (hj : j < 6) :
    finiteAdditiveFourierCoeff ψ (complexSexticChar P hg ^ j : MulChar (O ⧸ P) ℂ) 0 =
      (reflectedInactiveMass (Fintype.card (O ⧸ P)) j : ℂ) := by
  rw [finiteAdditiveFourier_sextic_zero P hg hchar ψ j hj]
  unfold reflectedInactiveMass
  by_cases h0 : j = 0
  · rw [if_pos h0, if_pos h0]
    push_cast
    have hq : (Fintype.card (O ⧸ P) : ℂ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
    field_simp
  · simp only [if_neg h0, Complex.ofReal_zero]

lemma finiteAdditiveFourier_inactive_sextic_density {ι : Type*} [Fintype ι]
    (P : ι → Ideal O) [∀ i, (P i).IsMaximal] (hg : ∀ i, lambda ∉ P i)
    (hchar : ∀ i, ringChar (O ⧸ P i) ≠ 2) (ψ : ∀ i, AddChar (O ⧸ P i) ℂ)
    (j : ι → ℕ) (hj : ∀ i, j i < 6) (s : Finset ι) :
    (∏ i : {i // i ∉ s}, finiteAdditiveFourierCoeff (ψ i.val)
      (complexSexticChar (P i.val) (hg i.val) ^ j i.val : MulChar (O ⧸ P i.val) ℂ) 0) =
      ((∏ i ∈ sᶜ, reflectedInactiveMass (Fintype.card (O ⧸ P i)) (j i) : ℝ) : ℂ) := by
  classical
  rw [Finset.prod_subtype (F := inferInstanceAs (Fintype {i // i ∉ s})) sᶜ (fun _ => Finset.mem_compl)]
  push_cast
  exact Finset.prod_congr rfl (fun i _ => finiteAdditiveFourier_sextic_zero_real
    (P i.val) (hg i.val) (hchar i.val) (ψ i.val) (j i.val) (hj i.val))


/-- Weighted Cauchy–Schwarz keeps inactive-prime densities in both energies. -/
theorem finite_density_energy_bound {ι : Type*} [Fintype ι]
    (D A : ι → ℝ) (phase F : ι → ℂ) (C : ℝ) (hC : 0 ≤ C)
    (hD : ∀ i, 0 ≤ D i) (hA : ∀ i, 0 ≤ A i) (hphase : ∀ i, ‖phase i‖ ^ 2 ≤ C * A i) :
    ‖∑ i, (D i : ℂ) * phase i * F i‖ ^ 2 ≤
      C * (∑ i, D i * A i) * ∑ i, D i * ‖F i‖ ^ 2 := by
  classical
  have hn : ‖∑ i, (D i : ℂ) * phase i * F i‖ ≤ ∑ i, D i * ‖phase i‖ * ‖F i‖ := by
    apply (norm_sum_le _ _).trans_eq
    apply Finset.sum_congr rfl
    intro i hi
    simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hD i)]
  have hpoint (i) : (D i * ‖phase i‖ * ‖F i‖) ^ 2 ≤
      (D i * A i) * (C * D i * ‖F i‖ ^ 2) := by
    calc
      _ = (D i ^ 2 * ‖F i‖ ^ 2) * ‖phase i‖ ^ 2 := by ring
      _ ≤ (D i ^ 2 * ‖F i‖ ^ 2) * (C * A i) :=
        mul_le_mul_of_nonneg_left (hphase i) (mul_nonneg (sq_nonneg _) (sq_nonneg _))
      _ = _ := by ring
  have hcs := Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul Finset.univ
    (fun i _ => mul_nonneg (hD i) (hA i))
    (fun i _ => mul_nonneg (mul_nonneg hC (hD i)) (sq_nonneg _)) (fun i _ => hpoint i)
  apply ((pow_le_pow_left₀ (norm_nonneg _) hn 2).trans hcs).trans_eq
  rw [show (∑ i, C * D i * ‖F i‖ ^ 2) = C * ∑ i, D i * ‖F i‖ ^ 2 by
    simp only [Finset.mul_sum, mul_assoc]]
  ring

/-- Active-stratum reflection costs only the exceptional fourth-power density in the first energy. -/
theorem reflected_stratum_energy_bound {ι : Type*} [Fintype ι]
    (q : ι → ℝ) (hq : ∀ i, 1 ≤ q i) (j : ι → ℕ)
    (phase F : Finset ι → ℂ) (C : ℝ) (hC : 0 ≤ C)
    (hphase : ∀ s : Finset ι, ‖phase s‖ ^ 2 ≤ C * ∏ i ∈ s, reflectedActiveMass (q i) (j i)) :
    ‖∑ s : Finset ι, ((∏ i ∈ sᶜ, reflectedInactiveMass (q i) (j i) : ℝ) : ℂ) * phase s * F s‖ ^ 2 ≤
      C * (∏ i, if j i = 4 then (q i)⁻¹ else 1) *
        ∑ s : Finset ι, (∏ i ∈ sᶜ, reflectedInactiveMass (q i) (j i)) * ‖F s‖ ^ 2 := by
  classical
  have he := finite_density_energy_bound
    (fun s : Finset ι => ∏ i ∈ sᶜ, reflectedInactiveMass (q i) (j i))
    (fun s : Finset ι => ∏ i ∈ s, reflectedActiveMass (q i) (j i)) phase F C hC
    (fun s => Finset.prod_nonneg (fun i _ => reflectedInactiveMass_nonneg _ (hq i) _))
    (fun s => Finset.prod_nonneg (fun i _ => reflectedActiveMass_nonneg _ (zero_le_one.trans (hq i)) _)) hphase
  have hm : (∑ s : Finset ι, (∏ i ∈ sᶜ, reflectedInactiveMass (q i) (j i)) *
      ∏ i ∈ s, reflectedActiveMass (q i) (j i)) = ∏ i, if j i = 4 then (q i)⁻¹ else 1 := by
    simpa only [mul_comm] using reflected_branch_mass q j
  rwa [hm] at he


/-- Completed Gauss rows are finite sums of canonical divisor series with uniformly bounded cusp multipliers. -/
theorem completedT_canonical_divisor_reflection {ι : Type*} [Fintype ι]
    (p : ι → O) [∀ i, (Ideal.span {p i}).IsMaximal] (hp0 : ∀ i, p i ≠ 0)
    (hg : ∀ i, lambda ∉ Ideal.span {p i}) (hp : ∀ i, lambda ^ 2 ∣ p i - 1)
    (hchar : ∀ i, ringChar (O ⧸ Ideal.span {p i}) ≠ 2)
    (hpair : Pairwise (Function.onFun IsCoprime p))
    (N c : O) (hc : c ≠ 0) (hN : (243 : O) * c ∣ N) (hNp : ∀ i, IsCoprime N (p i))
    [Fintype (O ⧸ Ideal.span {9 * c})] (Ψ : (O ⧸ Ideal.span {c}) →* ℂ)
    (j : ι → ℕ) (hj : ∀ i, j i < 6) :
    ∃ (c₀ : (O ⧸ Ideal.span {9 * c}) → O)
      (sector : (O ⧸ Ideal.span {9 * c}) → Finset ι → FixedCuspSector)
      (b : (O ⧸ Ideal.span {9 * c}) → Finset ι → (O ⧸ Ideal.span {N}))
      (phase : (O ⧸ Ideal.span {9 * c}) → Finset ι → ℂ),
      (∀ k, c₀ k ≠ 0 ∧ c₀ k ∣ 9 * c) ∧
      (∀ k s, ‖phase k s‖ ^ 2 ≤ 81 * ∏ i : s,
        if j i.val = 0 ∨ j i.val = 4 then (Fintype.card (O ⧸ Ideal.span {p i.val}) : ℝ)⁻¹ else 1) ∧
      ∀ (W : ℝ → ℂ) (A B : ℝ), 0 < A → Function.support W ⊆ Set.Icc A B →
        ContDiff ℝ ∞ W → ∀ X : ℝ, 0 < X →
        completedT (Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom *
          primeCuspRowCharacter p (fun i => complexSexticChar (Ideal.span {p i}) (hg i) ^ j i)) W X =
        thetaDerivativeScalar⁻¹ * ∑ k : O ⧸ Ideal.span {9 * c},
          finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (9 * c) (mul_ne_zero (by norm_num) hc))
            (finiteThetaTwist c Ψ) k *
          ∑ s : Finset ι,
            (∏ i : {i // i ∉ s}, finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (p i.val) (hp0 i.val))
              (complexSexticChar (Ideal.span {p i.val}) (hg i.val) ^ j i.val : MulChar (O ⧸ Ideal.span {p i.val}) ℂ) 0) *
            phase k s * fixedCuspDivisorSeries (fun i : s => p i.val) (fun i => hg i.val)
              N (c₀ k) (sector k s) (b k s) (fun i => j i.val) (Vstar W) X := by
  classical
  obtain ⟨c₀, sector, d, U, κ, σ, ε, hc₀, hκ, hrow⟩ :=
    completedT_constructed_active_reflection p hp0 hg hp hpair N c hc hN hNp Ψ j
  have hNc₀ (k) : (27 : O) * c₀ k ∣ N := by
    apply dvd_trans _ hN
    obtain ⟨t, ht⟩ := (hc₀ k).2
    refine ⟨t, ?_⟩
    linear_combination 27 * ht
  have hbranch (k : O ⧸ Ideal.span {9 * c}) (s : Finset ι) :=
    nativeCuspStratumKernel_canonical (fun i : s => p i.val) (fun i => hp0 i.val)
      (fun i => hg i.val) (fun i => hchar i.val) N (c₀ k) (d k s) (U k s)
      (hc₀ k).1 (hNc₀ k) (fun i => hNp i.val) (sector k s) (κ k s) (σ k s) (ε k s)
      (fun i => j i.val) (fun i => hj i.val)
  choose β hβnorm hβ using hbranch
  let b := fun k s => Ideal.Quotient.mk (Ideal.span {N}) (d k s * U k s)
  let phase := fun k (s : Finset ι) =>
    fixedCuspReflectionScalar (sector k s) (c₀ k * ∏ i : s, p i.val) * star (κ k s) * β k s
  refine ⟨c₀, sector, b, phase, hc₀, ?_, ?_⟩
  · intro k s
    dsimp only [phase]
    rw [norm_mul, norm_mul, norm_star, hκ, mul_one, mul_pow, hβnorm]
    apply mul_le_mul_of_nonneg_right
      (fixedCuspReflectionScalar_norm_sq_le _ _
        (mul_ne_zero (hc₀ k).1 (Finset.prod_ne_zero_iff.mpr (fun i _ => hp0 i.val))))
    apply Finset.prod_nonneg
    intro i hi
    split_ifs <;> positivity
  · intro W A B hA hs hW X hX
    rw [hrow W A B hA hs hW X hX]
    congr 1
    apply Finset.sum_congr rfl
    intro k hk
    congr 1
    apply Finset.sum_congr rfl
    intro s hs'
    rw [hβ k s (Vstar W) A B hA (Vstar_support W A B hs) (Vstar_contDiff W A B hA hs hW) X hX]
    dsimp only [b, phase]
    ring


/-- The reflection constant depends only on the fixed finite character. -/
def completedReflectionConstant (c : O) (hc : c ≠ 0)
    [Fintype (O ⧸ Ideal.span {9 * c})] (Ψ : (O ⧸ Ideal.span {c}) →* ℂ) : ℝ :=
  81 * ‖thetaDerivativeScalar⁻¹‖ ^ 2 * ∑ k : O ⧸ Ideal.span {9 * c},
    ‖finiteAdditiveFourierCoeff (residueTraceQuotientChar 1 (9 * c) (mul_ne_zero (by norm_num) hc))
      (finiteThetaTwist c Ψ) k‖ ^ 2

/-- Uniform first-reflection energy: signed divisor sums remain intact, while active-prime masses sum exactly. -/
theorem completedT_canonical_energy {ι : Type*} [Fintype ι]
    (p : ι → O) [∀ i, (Ideal.span {p i}).IsMaximal] (hp0 : ∀ i, p i ≠ 0)
    (hg : ∀ i, lambda ∉ Ideal.span {p i}) (hp : ∀ i, lambda ^ 2 ∣ p i - 1)
    (hchar : ∀ i, ringChar (O ⧸ Ideal.span {p i}) ≠ 2)
    (hpair : Pairwise (Function.onFun IsCoprime p))
    (N c : O) (hc : c ≠ 0) (hN : (243 : O) * c ∣ N) (hNp : ∀ i, IsCoprime N (p i))
    [Fintype (O ⧸ Ideal.span {9 * c})] (Ψ : (O ⧸ Ideal.span {c}) →* ℂ)
    (j : ι → ℕ) (hj : ∀ i, j i < 6) :
    ∃ (c₀ : (O ⧸ Ideal.span {9 * c}) → O)
      (sector : (O ⧸ Ideal.span {9 * c}) → Finset ι → FixedCuspSector)
      (b : (O ⧸ Ideal.span {9 * c}) → Finset ι → (O ⧸ Ideal.span {N})),
      (∀ k, c₀ k ≠ 0 ∧ c₀ k ∣ 9 * c) ∧
      ∀ (W : ℝ → ℂ) (A B : ℝ), 0 < A → Function.support W ⊆ Set.Icc A B →
        ContDiff ℝ ∞ W → ∀ X : ℝ, 0 < X →
        ‖completedT (Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom *
          primeCuspRowCharacter p (fun i => complexSexticChar (Ideal.span {p i}) (hg i) ^ j i)) W X‖ ^ 2 ≤
        completedReflectionConstant c hc Ψ *
          (∏ i, if j i = 4 then (Fintype.card (O ⧸ Ideal.span {p i}) : ℝ)⁻¹ else 1) *
          ∑ k : O ⧸ Ideal.span {9 * c}, ∑ s : Finset ι,
            (∏ i ∈ sᶜ, reflectedInactiveMass (Fintype.card (O ⧸ Ideal.span {p i})) (j i)) *
            ‖fixedCuspDivisorSeries (fun i : s => p i.val) (fun i => hg i.val)
              N (c₀ k) (sector k s) (b k s) (fun i => j i.val) (Vstar W) X‖ ^ 2 := by
  classical
  obtain ⟨c₀, sector, b, phase, hc₀, hphase, hrow⟩ :=
    completedT_canonical_divisor_reflection p hp0 hg hp hchar hpair N c hc hN hNp Ψ j hj
  refine ⟨c₀, sector, b, hc₀, ?_⟩
  intro W A B hA hs hW X hX
  let q : ι → ℝ := fun i => Fintype.card (O ⧸ Ideal.span {p i})
  let D : Finset ι → ℝ := fun s => ∏ i ∈ sᶜ, reflectedInactiveMass (q i) (j i)
  let F := fun (k : O ⧸ Ideal.span {9 * c}) (s : Finset ι) =>
    fixedCuspDivisorSeries (fun i : s => p i.val) (fun i => hg i.val)
      N (c₀ k) (sector k s) (b k s) (fun i => j i.val) (Vstar W) X
  let T := fun k => ∑ s : Finset ι, (D s : ℂ) * phase k s * F k s
  let base := finiteAdditiveFourierCoeff
    (residueTraceQuotientChar 1 (9 * c) (mul_ne_zero (by norm_num) hc)) (finiteThetaTwist c Ψ)
  let Q : ℝ := ∏ i, if j i = 4 then (q i)⁻¹ else 1
  have hq (i) : 1 ≤ q i := by
    change (1 : ℝ) ≤ (Fintype.card (O ⧸ Ideal.span {p i}) : ℝ)
    exact_mod_cast Nat.succ_le_of_lt (@Fintype.card_pos (O ⧸ Ideal.span {p i}) _ _)
  have hrow' : completedT (Ψ.comp (Ideal.Quotient.mk (Ideal.span {c})).toMonoidHom *
      primeCuspRowCharacter p (fun i => complexSexticChar (Ideal.span {p i}) (hg i) ^ j i)) W X =
      thetaDerivativeScalar⁻¹ * ∑ k, base k * T k := by
    rw [hrow W A B hA hs hW X hX]
    congr 1
    apply Finset.sum_congr rfl
    intro k hk
    congr 1
    apply Finset.sum_congr rfl
    intro s hs'
    rw [finiteAdditiveFourier_inactive_sextic_density (fun i => Ideal.span {p i}) hg hchar
      (fun i => residueTraceQuotientChar 1 (p i) (hp0 i)) j hj s]
  have hinner (k) : ‖T k‖ ^ 2 ≤ 81 * Q * ∑ s : Finset ι, D s * ‖F k s‖ ^ 2 := by
    apply reflected_stratum_energy_bound q hq j (phase k) (F k) 81 (by norm_num)
    intro s
    rw [Finset.prod_subtype (F := inferInstanceAs (Fintype s)) s (fun _ => Iff.rfl)]
    exact hphase k s
  have hsum : (∑ k, ‖T k‖ ^ 2) ≤ 81 * Q * ∑ k, ∑ s : Finset ι, D s * ‖F k s‖ ^ 2 := by
    calc
      _ ≤ ∑ k, 81 * Q * ∑ s : Finset ι, D s * ‖F k s‖ ^ 2 := Finset.sum_le_sum (fun k _ => hinner k)
      _ = _ := (Finset.mul_sum _ _ _).symm
  have houter : ‖∑ k, base k * T k‖ ^ 2 ≤ (∑ k, ‖base k‖ ^ 2) * ∑ k, ‖T k‖ ^ 2 := by
    simpa only [Complex.ofReal_one, one_mul] using
      finite_density_energy_bound (fun _ => 1) (fun k => ‖base k‖ ^ 2) base T 1 (by norm_num)
        (fun _ => by norm_num) (fun _ => sq_nonneg _) (fun _ => by simp only [one_mul, le_refl])
  rw [hrow', norm_mul, mul_pow]
  apply (mul_le_mul_of_nonneg_left houter (sq_nonneg _)).trans
  apply (mul_le_mul_of_nonneg_left
    (mul_le_mul_of_nonneg_left hsum (Finset.sum_nonneg (fun _ _ => sq_nonneg _)))
    (sq_nonneg _)).trans_eq
  dsimp only [completedReflectionConstant, base, Q, q, D, F]
  ring


/-- Uniform constants for the three exact cusp coefficient families. -/
def sourceCuspCoefficientBaseBound (j : Fin 3) : ℝ :=
  if j = 0 then sourceCoefficientBaseBound
  else ramifiedCoefficientBaseBound (ramifiedCuspRoot (decide (j = 2))) (ramifiedCuspScaleUnit (decide (j = 2)))

lemma sourceCuspCoefficientBaseBound_nonneg (j : Fin 3) : 0 ≤ sourceCuspCoefficientBaseBound j := by
  fin_cases j
  · exact sourceCoefficientBaseBound_nonneg
  · exact ramifiedCoefficientBaseBound_nonneg _ _
  · exact ramifiedCoefficientBaseBound_nonneg _ _

lemma sourceCuspCoefficient_full_bound (j : Fin 3) (q : ThetaFullIndex) :
    ‖sourceCuspCoefficient j (thetaFullFrequency q)‖ ≤ sourceCuspCoefficientBaseBound j *
      ‖ringComplex ((q.1 : O) * lambda ^ q.2.1)‖ ^ (1 / 3 : ℝ) *
        ‖ringComplex (primaryIdealGenerator q.2.2.2.val)‖ := by
  fin_cases j
  · exact rationalSourceResidualFourierCoefficient_squarefree_cube_bound _ _
      q.2.2.1.property.2 q.2.2.2.property q.2.2.1.property.1 q.1 q.2.1
  · exact ramifiedResidualFourierCoefficient_squarefree_cube_bound _ _ _ _
      q.2.2.1.property.2 q.2.2.2.property q.2.2.1.property.1 q.1 q.2.1
  · exact ramifiedResidualFourierCoefficient_squarefree_cube_bound _ _ _ _
      q.2.2.1.property.2 q.2.2.2.property q.2.2.1.property.1 q.1 q.2.1

/-- Differentiation contributes one inverse radial norm after Bessel normalization. -/
lemma sourceCuspRadialBaseCoefficient_norm_exact (j : Fin 3) (h : O) (hh : h ≠ 0) :
    ‖sourceCuspRadialBaseCoefficient j h‖ =
      (‖-2 * Real.pi * Complex.I * thetaFrequencyScale‖ / (sourceCuspScale j) ^ 2) *
        (‖sourceCuspCoefficient j h‖ / ‖ringComplex h‖) := by
  have hh' : ‖ringComplex h‖ ≠ 0 := (norm_pos_iff.mpr (ringComplex_ne_zero hh)).ne'
  have hs : sourceCuspScale j ≠ 0 := (sourceCuspScale_pos j).ne'
  have he : -2 * Real.pi * Complex.I * cuspFrequency h =
      (-2 * Real.pi * Complex.I * thetaFrequencyScale) * ringComplex h := by
    rw [cuspFrequency_eq_thetaFrequencyScale]
    ring
  have hS : ‖(sourceCuspScale j : ℂ)‖ = sourceCuspScale j := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (sourceCuspScale_pos j)]
  have hL : ‖(sourceCuspRadialLength h : ℂ)‖ = ‖ringComplex h‖ ^ 2 := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (sourceCuspRadialLength_pos h),
      sourceCuspRadialLength, if_neg hh]
  rw [sourceCuspRadialBaseCoefficient, he]
  simp only [norm_div, norm_mul, norm_star, norm_pow, hS, hL]
  field_simp [hh', hs] <;> ring

/-- Sharp squarefree–cube decay of the radial coefficient, before localization. -/
lemma fixedCuspPeriodicArray_full_bound (N c : O) (s : FixedCuspSector)
    (b : O ⧸ Ideal.span {N}) (q : ThetaFullIndex) :
    ‖fixedCuspPeriodicArray N c s b (thetaFullFrequency q)‖ ≤
      (‖-2 * Real.pi * Complex.I * thetaFrequencyScale‖ /
        (sourceCuspScale (fixedCuspIndex s)) ^ 2 * sourceCuspCoefficientBaseBound (fixedCuspIndex s)) *
      (‖ringComplex ((q.1 : O) * lambda ^ q.2.1)‖ ^ (1 / 3 : ℝ) /
        ‖ringComplex ((q.1 : O) * lambda ^ q.2.1)‖) /
      (‖ringComplex (primaryIdealGenerator q.2.2.1.val)‖ *
        ‖ringComplex (primaryIdealGenerator q.2.2.2.val)‖ ^ 2) := by
  have hr : ‖ringComplex ((q.1 : O) * lambda ^ q.2.1)‖ ≠ 0 :=
    (norm_pos_iff.mpr (ringComplex_ne_zero (mul_ne_zero q.1.ne_zero (pow_ne_zero _ residue_lambda_prime.ne_zero)))).ne'
  have hI : ‖ringComplex (primaryIdealGenerator q.2.2.1.val)‖ ≠ 0 :=
    (norm_pos_iff.mpr (ringComplex_ne_zero q.2.2.1.property.2)).ne'
  have hJ : ‖ringComplex (primaryIdealGenerator q.2.2.2.val)‖ ≠ 0 :=
    (norm_pos_iff.mpr (ringComplex_ne_zero q.2.2.2.property)).ne'
  rw [fixedCuspPeriodicArray_norm, fixedCuspRadialArray_norm,
    sourceCuspRadialBaseCoefficient_norm_exact _ _ (thetaFullFrequency_ne_zero q)]
  apply (mul_le_mul_of_nonneg_left
    (div_le_div_of_nonneg_right (sourceCuspCoefficient_full_bound (fixedCuspIndex s) q) (norm_nonneg _))
    (div_nonneg (norm_nonneg _) (sq_nonneg _))).trans_eq
  have he : ‖ringComplex (thetaFullFrequency q)‖ =
      ‖ringComplex ((q.1 : O) * lambda ^ q.2.1)‖ * ‖ringComplex (primaryIdealGenerator q.2.2.1.val)‖ *
        ‖ringComplex (primaryIdealGenerator q.2.2.2.val)‖ ^ 3 := by
    rw [thetaFullFrequency, map_mul, map_mul, map_pow, norm_mul, norm_mul, norm_pow]
  rw [he]
  field_simp [hr, hI, hJ] <;> ring



namespace SchwartzPlanePoisson

open MeasureTheory Filter LineDeriv
open scoped FourierTransform SchwartzMap Real RealInnerProductSpace
abbrev LogPlane := WithLp 2 (ℝ × ℝ)

/-- Fourier transformation in orthogonal coordinates is the iterated one-dimensional transform. -/
theorem fourier_prod_eq_iterated (f : LogPlane → ℂ) (hf : Integrable f) (ξ η : ℝ) :
    𝓕 f (WithLp.toLp 2 (ξ, η)) =
      𝓕 (fun x : ℝ => 𝓕 (fun y : ℝ => f (WithLp.toLp 2 (x, y))) η) ξ := by
  let w : LogPlane := WithLp.toLp 2 (ξ, η)
  let G : LogPlane → ℂ := fun z => Real.fourierChar (-⟪z, w⟫) • f z
  have hG : Integrable G := (Real.fourierIntegral_convergent_iff w).mpr hf
  have hGp : Integrable (fun z : ℝ × ℝ => G (WithLp.toLp 2 z)) :=
    (WithLp.volume_preserving_toLp ℝ ℝ).integrable_comp_of_integrable hG
  calc
    𝓕 f (WithLp.toLp 2 (ξ, η)) = ∫ z : LogPlane, G z := rfl
    _ = ∫ z : ℝ × ℝ, G (WithLp.toLp 2 z) :=
      ((WithLp.volume_preserving_toLp ℝ ℝ).integral_comp
        (MeasurableEquiv.toLp 2 (ℝ × ℝ)).measurableEmbedding G).symm
    _ = ∫ x : ℝ, ∫ y : ℝ, G (WithLp.toLp 2 (x, y)) := integral_prod _ hGp
    _ = 𝓕 (fun x : ℝ => 𝓕 (fun y : ℝ => f (WithLp.toLp 2 (x, y))) η) ξ := by
      simp only [Real.fourier_eq, Circle.smul_def, smul_eq_mul]
      apply integral_congr_ae
      exact Filter.Eventually.of_forall fun x => by
        dsimp only
        rw [← integral_const_mul]
        apply integral_congr_ae
        exact Filter.Eventually.of_forall fun y => by
          simp only [G, w, WithLp.prod_inner_apply,
            neg_add, Real.fourierChar.map_add_eq_mul, Circle.smul_def, smul_eq_mul,
            Circle.coe_mul, mul_assoc]

def complexPoint (x y : ℝ) : ℂ := ⟨x, y⟩

theorem complexPoint_eq (x y : ℝ) : complexPoint x y = (x : ℂ) + Complex.I * (y : ℂ) := by
  apply Complex.ext <;> simp [complexPoint]

def planeComplexIso : LogPlane ≃ₗᵢ[ℝ] ℂ where
  toLinearEquiv := (WithLp.linearEquiv 2 ℝ (ℝ × ℝ)).trans
    Complex.equivRealProdCLM.toLinearEquiv.symm
  norm_map' z := by
    apply (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp
    rw [WithLp.prod_norm_sq_eq_of_L2]
    change ‖complexPoint (WithLp.ofLp z).1 (WithLp.ofLp z).2‖ ^ 2 =
      ‖(WithLp.ofLp z).1‖ ^ 2 + ‖(WithLp.ofLp z).2‖ ^ 2
    rw [Complex.sq_norm]
    simp [Complex.normSq_apply, complexPoint, Real.norm_eq_abs,  sq]

@[simp] theorem planeComplexIso_apply (x y : ℝ) :
    planeComplexIso (WithLp.toLp 2 (x, y)) = complexPoint x y := rfl

theorem horizontal_isometry (η : ℝ) : Isometry (fun x : ℝ => complexPoint x η) := by
  apply Isometry.of_dist_eq
  intro x y
  have h : complexPoint x η - complexPoint y η = ((x - y : ℝ) : ℂ) := by
    apply Complex.ext <;> simp [complexPoint]
  simp only [dist_eq_norm, h, Complex.norm_real]

theorem horizontal_temperate (η : ℝ) :
    (fun x : ℝ => complexPoint x η).HasTemperateGrowth := by
  have heq : (fun x : ℝ => complexPoint x η) =
      (fun x : ℝ => Complex.ofRealCLM x + Complex.I * (η : ℂ)) := by
    funext x
    exact complexPoint_eq x η
  rw [heq]
  fun_prop

def horizontalSlice (f : SchwartzMap ℂ ℂ) (η : ℝ) : SchwartzMap ℝ ℂ :=
  SchwartzMap.compCLMOfAntilipschitz ℂ (horizontal_temperate η)
    (horizontal_isometry η).antilipschitz f

@[simp] theorem horizontalSlice_apply (f : SchwartzMap ℂ ℂ) (η x : ℝ) :
    horizontalSlice f η x = f (complexPoint x η) := rfl

def partialFourier (f : SchwartzMap ℂ ℂ) (η x : ℝ) : ℂ :=
  𝓕 (fun y : ℝ => f (complexPoint x y)) η

theorem partialFourier_eq_integral (f : SchwartzMap ℂ ℂ) (η x : ℝ) :
    partialFourier f η x =
      ∫ y : ℝ, Real.fourierChar (-inner ℝ y η) • f (complexPoint x y) := rfl

theorem partialFourier_eq_exp_integral (f : SchwartzMap ℂ ℂ) (η x : ℝ) :
    partialFourier f η x = ∫ y : ℝ,
      Complex.exp (((-2 * Real.pi * (y * η) : ℝ) : ℂ) * Complex.I) *
        f ((x : ℂ) + Complex.I * (y : ℂ)) := by
  have hin (y : ℝ) : inner ℝ y η = y * η := by simp [RCLike.inner_apply, mul_comm]
  simp only [partialFourier, Real.fourier_eq', hin, complexPoint_eq, smul_eq_mul]

def verticalMajorant (f : SchwartzMap ℂ ℂ) (y : ℝ) : ℝ :=
  ((SchwartzMap.seminorm ℝ 0 0) f + (SchwartzMap.seminorm ℝ 2 0) f) * (1 + y ^ 2)⁻¹

theorem verticalMajorant_integrable (f : SchwartzMap ℂ ℂ) : Integrable (verticalMajorant f) :=
  integrable_inv_one_add_sq.const_mul _

theorem norm_le_verticalMajorant (f : SchwartzMap ℂ ℂ) (x y : ℝ) :
    ‖f (complexPoint x y)‖ ≤ verticalMajorant f y := by
  have h0 := SchwartzMap.norm_le_seminorm ℝ f (complexPoint x y)
  have h2 := SchwartzMap.norm_pow_mul_le_seminorm ℝ f 2 (complexPoint x y)
  have hy : y ^ 2 ≤ ‖complexPoint x y‖ ^ 2 := by
    simp only [Complex.sq_norm, Complex.normSq_apply, complexPoint]
    nlinarith [sq_nonneg x]
  have hym := mul_le_mul_of_nonneg_right hy (norm_nonneg (f (complexPoint x y)))
  have hden : 0 < 1 + y ^ 2 := by positivity
  rw [verticalMajorant, ← div_eq_mul_inv]
  apply (le_div_iff₀ hden).mpr
  nlinarith only [h0, h2, hym]

theorem partialFourier_continuous (f : SchwartzMap ℂ ℂ) (η : ℝ) :
    Continuous (partialFourier f η) := by
  change Continuous (fun x : ℝ => ∫ y : ℝ,
    Real.fourierChar (-inner ℝ y η) • f (complexPoint x y))
  apply continuous_of_dominated
    (bound := verticalMajorant f)
  · intro x
    have hline : Continuous (fun y : ℝ => complexPoint x y) :=
      Complex.equivRealProdCLM.symm.continuous.comp (continuous_const.prodMk continuous_id)
    exact ((by fun_prop : Continuous (fun y : ℝ => Real.fourierChar (-inner ℝ y η))).smul
      (f.continuous.comp hline)).aestronglyMeasurable
  · intro x
    exact Eventually.of_forall fun y => by
      simpa only [Circle.smul_def, smul_eq_mul, norm_mul, Circle.norm_coe, one_mul] using
        norm_le_verticalMajorant f x y
  · exact verticalMajorant_integrable f
  · exact Eventually.of_forall fun y => by
      have hf : Continuous (fun x : ℝ => f (complexPoint x y)) :=
        f.continuous.comp (horizontal_isometry y).continuous
      exact continuous_const.smul hf

theorem partialFourier_integrable (f : SchwartzMap ℂ ℂ) (η : ℝ) :
    Integrable (partialFourier f η) := by
  let G : ℂ → ℂ := fun z => Real.fourierChar (-inner ℝ z.im η) • f z
  have hG : Integrable G := f.integrable.norm.mono'
    (by fun_prop : Continuous G).aestronglyMeasurable
    (Eventually.of_forall fun z => by
      simp only [G, Circle.smul_def, smul_eq_mul, norm_mul, Circle.norm_coe, one_mul]
      exact le_rfl)
  have hGp : Integrable (fun z : ℝ × ℝ => G (Complex.measurableEquivRealProd.symm z)) :=
    Complex.volume_preserving_equiv_real_prod.symm.integrable_comp_of_integrable hG
  change Integrable (fun x : ℝ => ∫ y : ℝ,
    Real.fourierChar (-inner ℝ y η) • f (complexPoint x y))
  simpa only [G, Complex.measurableEquivRealProd_symm_apply, complexPoint]
    using hGp.integral_prod_left

theorem fourier_partialFourier (f : SchwartzMap ℂ ℂ) (ξ η : ℝ) :
    𝓕 (partialFourier f η) ξ = 𝓕 (f : ℂ → ℂ) (complexPoint ξ η) := by
  let fp : SchwartzMap LogPlane ℂ :=
    SchwartzMap.compCLMOfContinuousLinearEquiv ℂ planeComplexIso.toContinuousLinearEquiv f
  have hprod := fourier_prod_eq_iterated (fp : LogPlane → ℂ) fp.integrable ξ η
  have hcoe : (fp : LogPlane → ℂ) = (f : ℂ → ℂ) ∘ planeComplexIso := rfl
  rw [hcoe, Real.fourier_comp_linearIsometry] at hprod
  change 𝓕 (fun x : ℝ => 𝓕 (fun y : ℝ => f (complexPoint x y)) η) ξ = _
  simpa only [Function.comp_apply, planeComplexIso_apply] using hprod.symm

/-- Partial Fourier transformation stays in the Schwartz class by Fourier inversion of a slice. -/
def partialFourierSchwartz (f : SchwartzMap ℂ ℂ) (η : ℝ) : SchwartzMap ℝ ℂ :=
  𝓕⁻ (horizontalSlice (𝓕 f) η)

theorem partialFourierSchwartz_apply (f : SchwartzMap ℂ ℂ) (η x : ℝ) :
    partialFourierSchwartz f η x = partialFourier f η x := by
  have heq : 𝓕 (partialFourier f η) =
      (horizontalSlice (𝓕 f) η : ℝ → ℂ) := by
    funext ξ
    rw [fourier_partialFourier, horizontalSlice_apply]
    exact (congrFun (SchwartzMap.fourier_coe f) (complexPoint ξ η)).symm
  have hi : Integrable (𝓕 (partialFourier f η)) := by
    rw [heq]
    exact (horizontalSlice (𝓕 f) η).integrable
  change (𝓕⁻ (horizontalSlice (𝓕 f) η)) x = _
  rw [congrFun (SchwartzMap.fourierInv_coe (horizontalSlice (𝓕 f) η)) x, ← heq]
  exact (partialFourier_integrable f η).fourierInv_fourier_eq hi
    (partialFourier_continuous f η).continuousAt

theorem partialFourierSchwartz_coe (f : SchwartzMap ℂ ℂ) (η : ℝ) :
    (partialFourierSchwartz f η : ℝ → ℂ) = partialFourier f η :=
  funext (partialFourierSchwartz_apply f η)

theorem fourier_partialFourierSchwartz (f : SchwartzMap ℂ ℂ) (ξ η : ℝ) :
    𝓕 (partialFourierSchwartz f η : ℝ → ℂ) ξ =
      𝓕 (f : ℂ → ℂ) ((ξ : ℂ) + Complex.I * (η : ℂ)) := by
  rw [partialFourierSchwartz_coe, fourier_partialFourier, complexPoint_eq]

theorem horizontal_hasFDerivAt (η x : ℝ) :
    HasFDerivAt (fun y : ℝ => complexPoint y η) Complex.ofRealCLM x := by
  have heq : (fun y : ℝ => complexPoint y η) =
      (fun y : ℝ => Complex.ofRealCLM y + Complex.I * (η : ℂ)) := by
    funext y
    exact complexPoint_eq y η
  rw [heq]
  exact Complex.ofRealCLM.hasFDerivAt.add_const _

theorem horizontalSlice_lineDerivOp (F : SchwartzMap ℂ ℂ) (η : ℝ) :
    ∂_{(1 : ℝ)} (horizontalSlice F η) = horizontalSlice (∂_{(1 : ℂ)} F) η := by
  apply SchwartzMap.ext
  intro x
  rw [SchwartzMap.lineDerivOp_apply_eq_fderiv, horizontalSlice_apply,
    SchwartzMap.lineDerivOp_apply_eq_fderiv]
  have hcomp := (F.hasFDerivAt (complexPoint x η)).comp x (horizontal_hasFDerivAt η x)
  change fderiv ℝ (fun y : ℝ => F (complexPoint y η)) x (1 : ℝ) = _
  change fderiv ℝ ((F : ℂ → ℂ) ∘ (fun y => complexPoint y η)) x (1 : ℝ) = _
  rw [hcomp.fderiv]
  simp only [ContinuousLinearMap.comp_apply, Complex.ofRealCLM_apply, Complex.ofReal_one]

theorem horizontalSlice_lineDerivOp_twice (F : SchwartzMap ℂ ℂ) (η : ℝ) :
    ∂_{(1 : ℝ)} (∂_{(1 : ℝ)} (horizontalSlice F η)) =
      horizontalSlice (∂_{(1 : ℂ)} (∂_{(1 : ℂ)} F)) η := by
  rw [horizontalSlice_lineDerivOp, horizontalSlice_lineDerivOp]

theorem summable_int_cauchy_weight :
    Summable (fun n : ℤ => (1 + (n : ℝ) ^ 2)⁻¹) := by
  classical
  have hp : Summable (fun n : ℤ => 1 / (n : ℝ) ^ 2) :=
    Real.summable_one_div_int_pow.mpr (by norm_num)
  rw [← Finset.summable_compl_iff (s := ({0} : Finset ℤ))]
  apply Summable.of_nonneg_of_le (fun _ => by positivity) _
    (hp.subtype (fun n : ℤ => n ∉ ({0} : Finset ℤ)))
  intro n
  have hn : n.val ≠ 0 := by simpa only [Finset.mem_singleton] using n.property
  have hnr : (n.val : ℝ) ≠ 0 := by exact_mod_cast hn
  have hsq : 0 < (n.val : ℝ) ^ 2 := sq_pos_of_ne_zero hnr
  change (1 + (n.val : ℝ) ^ 2)⁻¹ ≤ 1 / (n.val : ℝ) ^ 2
  simpa only [one_div] using
    one_div_le_one_div_of_le hsq (show (n.val : ℝ) ^ 2 ≤ 1 + (n.val : ℝ) ^ 2 by linarith)

theorem summable_int_cauchy_product :
    Summable (fun p : ℤ × ℤ =>
      (1 + (p.1 : ℝ) ^ 2)⁻¹ * (1 + (p.2 : ℝ) ^ 2)⁻¹) :=
  summable_int_cauchy_weight.mul_of_nonneg summable_int_cauchy_weight
    (fun _ => by positivity) (fun _ => by positivity)

theorem summable_norm_of_cauchy_product (F : ℤ × ℤ → ℂ) (C : ℝ)
    (hF : ∀ p, ‖F p‖ ≤ C *
      ((1 + (p.1 : ℝ) ^ 2)⁻¹ * (1 + (p.2 : ℝ) ^ 2)⁻¹)) :
    Summable (fun p => ‖F p‖) :=
  Summable.of_nonneg_of_le (fun _ => norm_nonneg _) hF
    (summable_int_cauchy_product.mul_left C)

theorem summable_of_cauchy_product (F : ℤ × ℤ → ℂ) (C : ℝ)
    (hF : ∀ p, ‖F p‖ ≤ C *
      ((1 + (p.1 : ℝ) ^ 2)⁻¹ * (1 + (p.2 : ℝ) ^ 2)⁻¹)) : Summable F :=
  (summable_norm_of_cauchy_product F C hF).of_norm

def planeDecayConstant (F : SchwartzMap ℂ ℂ) : ℝ :=
  SchwartzMap.seminorm ℝ 0 0 F + SchwartzMap.seminorm ℝ 2 0 F +
    SchwartzMap.seminorm ℝ 4 0 F

theorem planeDecayConstant_nonneg (F : SchwartzMap ℂ ℂ) : 0 ≤ planeDecayConstant F := by
  unfold planeDecayConstant
  positivity

/-- Three seminorms give a summable product majorant on the integer lattice. -/
theorem plane_schwartz_product_decay (F : SchwartzMap ℂ ℂ) (ξ η : ℝ) :
    ((1 + ξ ^ 2) * (1 + η ^ 2)) * ‖F (complexPoint ξ η)‖ ≤
      planeDecayConstant F := by
  let z := complexPoint ξ η
  have hz : ‖z‖ ^ 2 = ξ ^ 2 + η ^ 2 := by
    rw [Complex.sq_norm]
    simp [z, Complex.normSq_apply, complexPoint, sq]
  have h0 := SchwartzMap.norm_le_seminorm ℝ F z
  have h2 := SchwartzMap.norm_pow_mul_le_seminorm ℝ F 2 z
  have h4 := SchwartzMap.norm_pow_mul_le_seminorm ℝ F 4 z
  have hz4 : ‖z‖ ^ 4 = (ξ ^ 2 + η ^ 2) ^ 2 := by
    calc
      ‖z‖ ^ 4 = (‖z‖ ^ 2) ^ 2 := by ring
      _ = (ξ ^ 2 + η ^ 2) ^ 2 := congrArg (fun t : ℝ => t ^ 2) hz
  have hxy : ξ ^ 2 * η ^ 2 ≤ ‖z‖ ^ 4 := by
    rw [hz4]
    nlinarith [sq_nonneg (ξ ^ 2), sq_nonneg (η ^ 2),
      mul_nonneg (sq_nonneg ξ) (sq_nonneg η)]
  have hm := mul_le_mul_of_nonneg_right hxy (norm_nonneg (F z))
  rw [hz] at h2
  change ((1 + ξ ^ 2) * (1 + η ^ 2)) * ‖F z‖ ≤ _
  unfold planeDecayConstant
  nlinarith only [h0, h2, h4, hm]

theorem norm_horizontalSlice_le (F : SchwartzMap ℂ ℂ) (η ξ : ℝ) :
    ‖horizontalSlice F η ξ‖ ≤
      (planeDecayConstant F / (1 + η ^ 2)) * (1 + ξ ^ 2)⁻¹ := by
  rw [horizontalSlice_apply, ← div_eq_mul_inv, div_div]
  apply (le_div_iff₀ (by positivity : 0 < (1 + η ^ 2) * (1 + ξ ^ 2))).mpr
  nlinarith [plane_schwartz_product_decay F ξ η]

theorem norm_inverse_horizontalSlice_le (F : SchwartzMap ℂ ℂ) (η x : ℝ) :
    ‖(𝓕⁻ (horizontalSlice F η)) x‖ ≤
      (planeDecayConstant F / (1 + η ^ 2)) * Real.pi := by
  rw [congrFun (SchwartzMap.fourierInv_coe (horizontalSlice F η)) x,
    Real.fourierInv_eq]
  have hb : Integrable (fun ξ : ℝ =>
      (planeDecayConstant F / (1 + η ^ 2)) * (1 + ξ ^ 2)⁻¹) :=
    integrable_inv_one_add_sq.const_mul _
  have h := norm_integral_le_of_norm_le
    (f := fun ξ : ℝ => Real.fourierChar (inner ℝ ξ x) • horizontalSlice F η ξ) hb (Eventually.of_forall fun ξ => by
    simpa only [Circle.smul_def, smul_eq_mul, norm_mul, Circle.norm_coe, one_mul] using
      norm_horizontalSlice_le F η ξ)
  simpa only [integral_const_mul, integral_univ_inv_one_add_sq] using h

theorem norm_inverse_lineDeriv (g : SchwartzMap ℝ ℂ) (x : ℝ) :
    ‖(𝓕⁻ (∂_{(1 : ℝ)} g)) x‖ =
      (2 * Real.pi) * |x| * ‖(𝓕⁻ g) x‖ := by
  have ht : (fun u : ℝ => inner ℝ u (1 : ℝ)).HasTemperateGrowth := by fun_prop
  have hc : ‖(-(2 * Real.pi * Complex.I) : ℂ)‖ = 2 * Real.pi := by
    simp [ Complex.norm_real, Real.norm_eq_abs, abs_of_pos Real.pi_pos]
  rw [SchwartzMap.fourierInv_lineDerivOp_eq]
  simp only [_root_.smul_apply, SchwartzMap.smulLeftCLM_apply_apply ht,
    norm_smul, hc]
  simp [RCLike.inner_apply, Real.norm_eq_abs, mul_assoc]

theorem sq_mul_norm_inverse_le_second (g : SchwartzMap ℝ ℂ) (x : ℝ) :
    x ^ 2 * ‖(𝓕⁻ g) x‖ ≤ ‖(𝓕⁻ (∂_{(1 : ℝ)} (∂_{(1 : ℝ)} g))) x‖ := by
  rw [norm_inverse_lineDeriv, norm_inverse_lineDeriv]
  have hp : 1 ≤ (2 * Real.pi) ^ 2 := by nlinarith [Real.pi_gt_three]
  calc
    x ^ 2 * ‖(𝓕⁻ g) x‖ ≤ ((2 * Real.pi) ^ 2 * x ^ 2) * ‖(𝓕⁻ g) x‖ :=
      mul_le_mul_of_nonneg_right (le_mul_of_one_le_left (sq_nonneg x) hp) (norm_nonneg _)
    _ = ((2 * Real.pi) ^ 2 * |x| ^ 2) * ‖(𝓕⁻ g) x‖ := by rw [sq_abs]
    _ = _ := by ring

theorem inverse_horizontalSlice_product_decay (F : SchwartzMap ℂ ℂ) (η x : ℝ) :
    ((1 + x ^ 2) * (1 + η ^ 2)) * ‖(𝓕⁻ (horizontalSlice F η)) x‖ ≤
      Real.pi * (planeDecayConstant F +
        planeDecayConstant (∂_{(1 : ℂ)} (∂_{(1 : ℂ)} F))) := by
  have h0 := norm_inverse_horizontalSlice_le F η x
  have h2a := sq_mul_norm_inverse_le_second (horizontalSlice F η) x
  rw [horizontalSlice_lineDerivOp_twice] at h2a
  have h2 := h2a.trans
    (norm_inverse_horizontalSlice_le (∂_{(1 : ℂ)} (∂_{(1 : ℂ)} F)) η x)
  have hden : 0 < 1 + η ^ 2 := by positivity
  have h0' : ‖(𝓕⁻ (horizontalSlice F η)) x‖ * (1 + η ^ 2) ≤
      planeDecayConstant F * Real.pi := by
    apply (le_div_iff₀ hden).mp
    simpa only [div_mul_eq_mul_div] using h0
  have h2' : (x ^ 2 * ‖(𝓕⁻ (horizontalSlice F η)) x‖) * (1 + η ^ 2) ≤
      planeDecayConstant (∂_{(1 : ℂ)} (∂_{(1 : ℂ)} F)) * Real.pi := by
    apply (le_div_iff₀ hden).mp
    simpa only [div_mul_eq_mul_div] using h2
  nlinarith only [h0', h2']

def partialFourierDecayConstant (f : SchwartzMap ℂ ℂ) : ℝ :=
  Real.pi * (planeDecayConstant (𝓕 f) +
    planeDecayConstant (∂_{(1 : ℂ)} (∂_{(1 : ℂ)} (𝓕 f))))

theorem partialFourierDecayConstant_nonneg (f : SchwartzMap ℂ ℂ) :
    0 ≤ partialFourierDecayConstant f :=
  mul_nonneg Real.pi_pos.le
    (add_nonneg (planeDecayConstant_nonneg _) (planeDecayConstant_nonneg _))

theorem partialFourier_product_decay (f : SchwartzMap ℂ ℂ) (η x : ℝ) :
    ((1 + x ^ 2) * (1 + η ^ 2)) * ‖partialFourier f η x‖ ≤
      partialFourierDecayConstant f := by
  rw [← partialFourierSchwartz_apply]
  exact inverse_horizontalSlice_product_decay (𝓕 f) η x

theorem norm_partialFourier_le (f : SchwartzMap ℂ ℂ) (η x : ℝ) :
    ‖partialFourier f η x‖ ≤
      partialFourierDecayConstant f * ((1 + x ^ 2)⁻¹ * (1 + η ^ 2)⁻¹) := by
  rw [← mul_inv, ← div_eq_mul_inv]
  apply (le_div_iff₀ (by positivity : 0 < (1 + x ^ 2) * (1 + η ^ 2))).mpr
  nlinarith [partialFourier_product_decay f η x]

theorem partialFourier_lattice_summable_norm (f : SchwartzMap ℂ ℂ) :
    Summable (fun p : ℤ × ℤ =>
      ‖partialFourier f (p.2 : ℝ) (p.1 : ℝ)‖) := by
  apply summable_norm_of_cauchy_product
    (fun p : ℤ × ℤ => partialFourier f (p.2 : ℝ) (p.1 : ℝ))
    (partialFourierDecayConstant f)
  intro p
  exact norm_partialFourier_le f (p.2 : ℝ) (p.1 : ℝ)

theorem partialFourier_lattice_summable (f : SchwartzMap ℂ ℂ) :
    Summable (fun p : ℤ × ℤ => partialFourier f (p.2 : ℝ) (p.1 : ℝ)) :=
  (partialFourier_lattice_summable_norm f).of_norm

theorem plane_lattice_summable_norm (f : 𝓢(ℂ, ℂ)) :
    Summable (fun p : ℤ × ℤ => ‖f (complexPoint (p.1 : ℝ) (p.2 : ℝ))‖) := by
  apply summable_norm_of_cauchy_product _ (planeDecayConstant f)
  intro p
  rw [← mul_inv, ← div_eq_mul_inv]
  apply (le_div_iff₀ (by positivity :
    0 < (1 + (p.1 : ℝ) ^ 2) * (1 + (p.2 : ℝ) ^ 2))).mpr
  nlinarith [plane_schwartz_product_decay f (p.1 : ℝ) (p.2 : ℝ)]

theorem plane_lattice_summable (f : 𝓢(ℂ, ℂ)) :
    Summable (fun p : ℤ × ℤ => f (complexPoint (p.1 : ℝ) (p.2 : ℝ))) :=
  (plane_lattice_summable_norm f).of_norm

theorem vertical_isometry (x : ℝ) : Isometry (fun y : ℝ => complexPoint x y) := by
  apply Isometry.of_dist_eq
  intro y z
  have h : complexPoint x y - complexPoint x z =
      Complex.I * ((y - z : ℝ) : ℂ) := by
    apply Complex.ext <;> simp [complexPoint]
  simp only [dist_eq_norm, h, norm_mul, Complex.norm_I, one_mul, Complex.norm_real]

theorem vertical_temperate (x : ℝ) :
    (fun y : ℝ => complexPoint x y).HasTemperateGrowth := by
  have heq : (fun y : ℝ => complexPoint x y) =
      (fun y : ℝ => (x : ℂ) + Complex.I * Complex.ofRealCLM y) := by
    funext y
    exact complexPoint_eq x y
  rw [heq]
  fun_prop

def verticalSlice (f : 𝓢(ℂ, ℂ)) (x : ℝ) : 𝓢(ℝ, ℂ) :=
  SchwartzMap.compCLMOfAntilipschitz ℂ (vertical_temperate x)
    (vertical_isometry x).antilipschitz f

@[simp] theorem verticalSlice_apply (f : 𝓢(ℂ, ℂ)) (x y : ℝ) :
    verticalSlice f x y = f (complexPoint x y) := rfl

theorem schwartz_poisson_zero (g : 𝓢(ℝ, ℂ)) :
    (∑' n : ℤ, g (n : ℝ)) = ∑' n : ℤ, 𝓕 (g : ℝ → ℂ) (n : ℝ) := by
  simpa [fourier_eval_zero, SchwartzMap.fourier_coe] using g.tsum_eq_tsum_fourier 0

theorem vertical_poisson (f : 𝓢(ℂ, ℂ)) (x : ℝ) :
    (∑' n : ℤ, f (complexPoint x (n : ℝ))) =
      ∑' n : ℤ, partialFourier f (n : ℝ) x := by
  exact schwartz_poisson_zero (verticalSlice f x)

private theorem horizontal_poisson (f : 𝓢(ℂ, ℂ)) (n : ℤ) :
    (∑' m : ℤ, partialFourier f (n : ℝ) (m : ℝ)) =
      ∑' k : ℤ, (𝓕 f) (complexPoint (k : ℝ) (n : ℝ)) := by
  have h := schwartz_poisson_zero (partialFourierSchwartz f n)
  simpa only [partialFourierSchwartz_apply, partialFourierSchwartz_coe,
    fourier_partialFourier, SchwartzMap.fourier_coe] using h

private theorem iterated_poisson_pair_sum
    (f g h : ℤ → ℤ → ℂ)
    (hf : Summable (Function.uncurry f))
    (hg : Summable (Function.uncurry g))
    (hh : Summable (Function.uncurry h))
    (hvertical : ∀ m, (∑' n, f m n) = ∑' n, h m n)
    (hhorizontal : ∀ n, (∑' m, h m n) = ∑' m, g m n) :
    (∑' p : ℤ × ℤ, f p.1 p.2) = ∑' p : ℤ × ℤ, g p.1 p.2 := by
  calc
    (∑' p : ℤ × ℤ, f p.1 p.2) = ∑' m, ∑' n, f m n := hf.tsum_prod
    _ = ∑' m, ∑' n, h m n := tsum_congr hvertical
    _ = ∑' n, ∑' m, h m n := hh.tsum_comm.symm
    _ = ∑' n, ∑' m, g m n := tsum_congr hhorizontal
    _ = ∑' m, ∑' n, g m n := hg.tsum_comm
    _ = ∑' p : ℤ × ℤ, g p.1 p.2 := hg.tsum_prod.symm

/-- Absolute convergence permits two successive one-dimensional Poisson transformations. -/
theorem integer_pair_poisson (f : 𝓢(ℂ, ℂ)) :
    (∑' p : ℤ × ℤ, f (complexPoint (p.1 : ℝ) (p.2 : ℝ))) =
      ∑' p : ℤ × ℤ, (𝓕 f) (complexPoint (p.1 : ℝ) (p.2 : ℝ)) := by
  exact iterated_poisson_pair_sum
    (fun m n => f (complexPoint (m : ℝ) (n : ℝ)))
    (fun m n : ℤ => (𝓕 f : 𝓢(ℂ, ℂ)) (complexPoint (m : ℝ) (n : ℝ)))
    (fun m n => partialFourier f (n : ℝ) (m : ℝ))
    (plane_lattice_summable f) (plane_lattice_summable (𝓕 f))
    (partialFourier_lattice_summable f)
    (fun m => vertical_poisson f m) (horizontal_poisson f)



section
open MeasureTheory
open scoped FourierTransform SchwartzMap RealInnerProductSpace

def inverseJacobian (A : ℂ ≃L[ℝ] ℂ) : ℝ :=
  |(LinearMap.det (A : ℂ →ₗ[ℝ] ℂ))⁻¹|

theorem integral_comp_linearEquiv (A : ℂ ≃L[ℝ] ℂ) (f : ℂ → ℂ) :
    (∫ x : ℂ, f (A x)) = inverseJacobian A • ∫ x : ℂ, f x := by
  have h := integral_map_equiv («μ» := (volume : Measure ℂ))
    A.toHomeomorph.toMeasurableEquiv f
  have hm : Measure.map A (volume : Measure ℂ) =
      ENNReal.ofReal (inverseJacobian A) • volume := by
    exact Measure.map_linearMap_addHaar_eq_smul_addHaar volume
      A.toLinearEquiv.isUnit_det'.ne_zero
  change (∫ y : ℂ, f y ∂Measure.map A volume) = (∫ x : ℂ, f (A x)) at h
  rw [hm, integral_smul_measure, ENNReal.toReal_ofReal (show 0 ≤ inverseJacobian A from abs_nonneg _)] at h
  exact h.symm

def dualMap (A : ℂ ≃L[ℝ] ℂ) : ℂ →L[ℝ] ℂ :=
  A.symm.toContinuousLinearMap.adjoint

theorem inner_linear_dual (A : ℂ ≃L[ℝ] ℂ) (x y : ℂ) :
    inner ℝ (A x) (dualMap A y) = inner ℝ x y := by
  rw [dualMap, ContinuousLinearMap.adjoint_inner_right]
  simp

theorem fourier_comp_linearEquiv (A : ℂ ≃L[ℝ] ℂ) (f : ℂ → ℂ) (w : ℂ) :
    𝓕 (f ∘ A) w = inverseJacobian A • 𝓕 f (dualMap A w) := by
  let H : ℂ → ℂ := fun z => Real.fourierChar (-inner ℝ z (dualMap A w)) • f z
  calc
    𝓕 (f ∘ A) w = ∫ x : ℂ, H (A x) := by
      apply integral_congr_ae
      exact Filter.Eventually.of_forall fun x => by
        simp only [H, inner_linear_dual, Function.comp_apply]
        rfl
    _ = inverseJacobian A • ∫ z : ℂ, H z := integral_comp_linearEquiv A H
    _ = inverseJacobian A • 𝓕 f (dualMap A w) := rfl

def translateSchwartz (f : 𝓢(ℂ, ℂ)) (b : ℂ) : 𝓢(ℂ, ℂ) :=
  SchwartzMap.compCLMOfAntilipschitz ℂ (g := fun z : ℂ => z + b)
    (by fun_prop) (isometry_add_right b).antilipschitz f

@[simp] theorem translateSchwartz_apply (f : 𝓢(ℂ, ℂ)) (b z : ℂ) :
    translateSchwartz f b z = f (z + b) := rfl

theorem fourier_translate (f : ℂ → ℂ) (b w : ℂ) :
    𝓕 (fun z => f (z + b)) w =
      Real.fourierChar (inner ℝ b w) • 𝓕 f w := by
  exact congrFun
    (VectorFourier.fourierIntegral_comp_add_right Real.fourierChar
      (volume : Measure ℂ) (innerₗ ℂ) f b) w

def affinePullback (f : 𝓢(ℂ, ℂ)) (A : ℂ ≃L[ℝ] ℂ) (b : ℂ) : 𝓢(ℂ, ℂ) :=
  SchwartzMap.compCLMOfContinuousLinearEquiv ℂ A (translateSchwartz f b)

@[simp] theorem affinePullback_apply (f : 𝓢(ℂ, ℂ)) (A : ℂ ≃L[ℝ] ℂ) (b z : ℂ) :
    affinePullback f A b z = f (A z + b) := rfl

theorem fourier_affinePullback (f : 𝓢(ℂ, ℂ)) (A : ℂ ≃L[ℝ] ℂ) (b w : ℂ) :
    (𝓕 (affinePullback f A b)) w =
      inverseJacobian A •
        (Real.fourierChar (inner ℝ b (dualMap A w)) • (𝓕 f) (dualMap A w)) := by
  rw [congrFun (SchwartzMap.fourier_coe _) w]
  change 𝓕 ((fun z => f (z + b)) ∘ A) w = _
  rw [fourier_comp_linearEquiv, fourier_translate]
  rw [congrFun (SchwartzMap.fourier_coe f) (dualMap A w)]

theorem affine_lattice_poisson (f : 𝓢(ℂ, ℂ)) (A : ℂ ≃L[ℝ] ℂ) (b : ℂ) :
    (∑' p : ℤ × ℤ, f (A (complexPoint (p.1 : ℝ) (p.2 : ℝ)) + b)) =
      inverseJacobian A • ∑' p : ℤ × ℤ,
        Real.fourierChar (inner ℝ b (dualMap A (complexPoint (p.1 : ℝ) (p.2 : ℝ)))) •
          (𝓕 f) (dualMap A (complexPoint (p.1 : ℝ) (p.2 : ℝ))) := by
  have h := integer_pair_poisson (affinePullback f A b)
  simp only [affinePullback_apply, fourier_affinePullback] at h
  rw [tsum_const_smul''] at h
  exact h

end

section
open scoped RealInnerProductSpace

def basisMap (w : ℂ) : ℂ →L[ℝ] ℂ :=
  Complex.ofRealCLM.comp Complex.reCLM +
    w • (Complex.ofRealCLM.comp Complex.imCLM)

@[simp] theorem basisMap_apply (w z : ℂ) :
    basisMap w z = (z.re : ℂ) + w * (z.im : ℂ) := rfl

def basisEquiv (w : ℂ) (hw : w.im ≠ 0) : ℂ ≃L[ℝ] ℂ where
  toLinearEquiv :=
    { toLinearMap := (basisMap w).toLinearMap
      invFun z := complexPoint (z.re - z.im * w.re / w.im) (z.im / w.im)
      left_inv z := by
        change complexPoint ((basisMap w z).re - (basisMap w z).im * w.re / w.im)
          ((basisMap w z).im / w.im) = z
        apply Complex.ext
        · simp only [basisMap_apply, Complex.add_re, Complex.ofReal_re,
            Complex.mul_re, Complex.ofReal_im, mul_zero, sub_zero,
            Complex.add_im, Complex.mul_im,  zero_add, complexPoint]
          field_simp [hw]
          ring
        · simp [basisMap_apply, complexPoint, hw]
      right_inv z := by
        change basisMap w (complexPoint (z.re - z.im * w.re / w.im)
          (z.im / w.im)) = z
        apply Complex.ext
        · simp only [basisMap_apply, complexPoint, Complex.add_re, Complex.ofReal_re,
            Complex.mul_re, Complex.ofReal_im, mul_zero, sub_zero]
          field_simp [hw]
          ring
        · simp only [basisMap_apply, complexPoint, Complex.add_im,
            Complex.ofReal_im, Complex.mul_im, Complex.ofReal_re, mul_zero, zero_add]
          field_simp [hw] }
  continuous_toFun := (basisMap w).continuous
  continuous_invFun := by
    simp only [complexPoint_eq]
    fun_prop

@[simp] theorem basisEquiv_apply (w : ℂ) (hw : w.im ≠ 0) (z : ℂ) :
    basisEquiv w hw z = (z.re : ℂ) + w * (z.im : ℂ) := rfl

@[simp] theorem basisEquiv_symm_apply (w : ℂ) (hw : w.im ≠ 0) (z : ℂ) :
    (basisEquiv w hw).symm z =
      complexPoint (z.re - z.im * w.re / w.im) (z.im / w.im) := rfl

theorem basisEquiv_det (w : ℂ) (hw : w.im ≠ 0) :
    LinearMap.det ((basisEquiv w hw) : ℂ →ₗ[ℝ] ℂ) = w.im := by
  rw [← LinearMap.det_toMatrix Complex.basisOneI, Matrix.det_fin_two]
  simp [LinearMap.toMatrix_apply, Complex.coe_basisOneI,
    Complex.coe_basisOneI_repr, basisEquiv_apply]

def complexMulEquiv (c : ℂ) (hc : c ≠ 0) : ℂ ≃L[ℝ] ℂ :=
  ContinuousLinearEquiv.smulLeft (R₁ := ℝ) (M₁ := ℂ) (Units.mk0 c hc)

@[simp] theorem complexMulEquiv_apply (c : ℂ) (hc : c ≠ 0) (z : ℂ) :
    complexMulEquiv c hc z = c * z := rfl

@[simp] theorem complexMulEquiv_symm_apply (c : ℂ) (hc : c ≠ 0) (z : ℂ) :
    (complexMulEquiv c hc).symm z = c⁻¹ * z := rfl

theorem complexMulEquiv_det (c : ℂ) (hc : c ≠ 0) :
    LinearMap.det ((complexMulEquiv c hc) : ℂ →ₗ[ℝ] ℂ) = Complex.normSq c := by
  rw [← LinearMap.det_toMatrix Complex.basisOneI, Matrix.det_fin_two]
  simp [LinearMap.toMatrix_apply, Complex.coe_basisOneI,
    Complex.coe_basisOneI_repr, complexMulEquiv_apply, Complex.normSq_apply]

def scaledBasisEquiv (w : ℂ) (hw : w.im ≠ 0) (c : ℂ) (hc : c ≠ 0) : ℂ ≃L[ℝ] ℂ :=
  (basisEquiv w hw).trans (complexMulEquiv c hc)

@[simp] theorem scaledBasisEquiv_apply (w : ℂ) (hw : w.im ≠ 0)
    (c : ℂ) (hc : c ≠ 0) (z : ℂ) :
    scaledBasisEquiv w hw c hc z = c * ((z.re : ℂ) + w * (z.im : ℂ)) := rfl

theorem scaledBasisEquiv_det (w : ℂ) (hw : w.im ≠ 0) (c : ℂ) (hc : c ≠ 0) :
    LinearMap.det ((scaledBasisEquiv w hw c hc) : ℂ →ₗ[ℝ] ℂ) =
      Complex.normSq c * w.im := by
  change LinearMap.det
    (((complexMulEquiv c hc) : ℂ →ₗ[ℝ] ℂ).comp ((basisEquiv w hw) : ℂ →ₗ[ℝ] ℂ)) = _
  rw [LinearMap.det_comp, complexMulEquiv_det, basisEquiv_det]

end

end SchwartzPlanePoisson

namespace SchwartzPlanePoisson
open Eisenstein MeasureTheory
open scoped FourierTransform SchwartzMap RealInnerProductSpace

private theorem finite_quotient_span {c : O} (hc : c ≠ 0) :
    Finite (O ⧸ Ideal.span {c}) :=
  (Ideal.span {c}).finiteQuotientOfFreeOfNeBot
    (fun h => hc (Ideal.span_singleton_eq_bot.mp h))

namespace GaussianAbelPartition

theorem tsum_by_finite_fibers {A B : Type*} [Fintype B]
    (q : A → B) (f : A → ℂ) (hf : Summable f) :
    (∑' a : A, f a) =
      ∑ b : B, ∑' a : (q ⁻¹' {b}), f a.1 := by
  have h := (hf.hasSum.tsum_fiberwise q).tsum_eq
  simpa only [tsum_fintype] using h.symm

theorem tsum_periodic_weighted_partition {A B : Type*} [Fintype B]
    (q : A → B) (P : B → ℂ) (W : A → ℂ)
    (hf : Summable (fun a => P (q a) * W a)) :
    (∑' a : A, P (q a) * W a) =
      ∑ b : B, P b * ∑' a : (q ⁻¹' {b}), W a.1 := by
  rw [tsum_by_finite_fibers q _ hf]
  apply Finset.sum_congr rfl
  intro b hb
  calc
    (∑' a : (q ⁻¹' {b}), P (q a.1) * W a.1) =
        ∑' a : (q ⁻¹' {b}), P b * W a.1 := by
      apply tsum_congr
      intro a
      have ha : q a.1 = b := by
        simpa only [Set.mem_preimage, Set.mem_singleton_iff] using a.property
      rw [ha]
    _ = P b * ∑' a : (q ⁻¹' {b}), W a.1 := tsum_mul_left

end GaussianAbelPartition
namespace GaussianFiberEquiv


def fiberMap (c : O) (r : O ⧸ Ideal.span {c})
    (r0 : O) (hr : Ideal.Quotient.mk (Ideal.span {c}) r0 = r)
    (w : O) : ((Ideal.Quotient.mk (Ideal.span {c})) ⁻¹' {r}) := by
  refine ⟨r0 + c*w, ?_⟩
  change Ideal.Quotient.mk (Ideal.span {c}) (r0 + c*w) = r
  rw [map_add, map_mul]
  have hc0 : Ideal.Quotient.mk (Ideal.span {c}) c = 0 :=
    (Ideal.Quotient.eq_zero_iff_mem).mpr (Ideal.subset_span (Set.mem_singleton c))
  rw [hc0, zero_mul, add_zero, hr]

private theorem fiberMap_injective (c : O) (hc : c ≠ 0)
    (r : O ⧸ Ideal.span {c}) (r0 : O)
    (hr : Ideal.Quotient.mk (Ideal.span {c}) r0 = r) :
    Function.Injective (fiberMap c r r0 hr) := by
  intro u v h
  have hval := congrArg Subtype.val h
  change r0 + c*u = r0 + c*v at hval
  exact mul_left_cancel₀ hc (add_left_cancel hval)

private theorem fiberMap_surjective (c : O)
    (r : O ⧸ Ideal.span {c}) (r0 : O)
    (hr : Ideal.Quotient.mk (Ideal.span {c}) r0 = r) :
    Function.Surjective (fiberMap c r r0 hr) := by
  rintro ⟨z, hz⟩
  have hz' : Ideal.Quotient.mk (Ideal.span {c}) z = r := by
    simpa only [Set.mem_preimage, Set.mem_singleton_iff] using hz
  have hdiff : z-r0 ∈ Ideal.span {c} :=
    (Ideal.Quotient.mk_eq_mk_iff_sub_mem z r0).mp (hz'.trans hr.symm)
  obtain ⟨w, hw⟩ := (Ideal.mem_span_singleton).mp hdiff
  refine ⟨w, ?_⟩
  apply Subtype.ext
  change r0 + c*w = z
  rw [← hw]
  ring

noncomputable def fiberEquiv (c : O) (hc : c ≠ 0)
    (r : O ⧸ Ideal.span {c}) (r0 : O)
    (hr : Ideal.Quotient.mk (Ideal.span {c}) r0 = r) :
    O ≃ ((Ideal.Quotient.mk (Ideal.span {c})) ⁻¹' {r}) :=
  Equiv.ofBijective (fiberMap c r r0 hr)
    ⟨fiberMap_injective c hc r r0 hr, fiberMap_surjective c r r0 hr⟩

theorem fiber_tsum (c : O) (hc : c ≠ 0)
    (r : O ⧸ Ideal.span {c}) (r0 : O)
    (hr : Ideal.Quotient.mk (Ideal.span {c}) r0 = r)
    (W : O → ℂ) :
    (∑' z : ((Ideal.Quotient.mk (Ideal.span {c})) ⁻¹' {r}), W z.1) =
      ∑' w : O, W (r0 + c*w) := by
  have h := (fiberEquiv c hc r r0 hr).tsum_eq (fun z => W z.1)
  have happ (w : O) : ((fiberEquiv c hc r r0 hr) w).1 = r0 + c*w := rfl
  simpa only [happ] using h.symm

end GaussianFiberEquiv

namespace GaussianShiftedPartition


noncomputable def representative (c : O) (r : O ⧸ Ideal.span {c}) : O :=
  Classical.choose (Ideal.Quotient.mk_surjective r)

theorem representative_spec (c : O) (r : O ⧸ Ideal.span {c}) :
    Ideal.Quotient.mk (Ideal.span {c}) (representative c r) = r :=
  Classical.choose_spec (Ideal.Quotient.mk_surjective r)

end GaussianShiftedPartition

/-- Poisson summation for the actual Eisenstein embedding, in either orientation. -/
def eisensteinLatticeMap (c : ℂ) (hc : c ≠ 0) : ℂ ≃L[ℝ] ℂ :=
  scaledBasisEquiv (ringComplex omega) complex_omega_im_ne_zero c hc

theorem eisensteinLatticeMap_point (c : ℂ) (hc : c ≠ 0) (p : ℤ × ℤ) :
    eisensteinLatticeMap c hc (complexPoint (p.1 : ℝ) (p.2 : ℝ)) =
      c * ringComplex (Eisenstein.Coordinates.eval p.1 p.2) := by
  simp [eisensteinLatticeMap, complexPoint, ringComplex_eval, mul_comm]

theorem eisenstein_inverseJacobian (c : ℂ) (hc : c ≠ 0) :
    inverseJacobian (eisensteinLatticeMap c hc) = 2 / (Real.sqrt 3 * ‖c‖ ^ 2) := by
  unfold inverseJacobian eisensteinLatticeMap
  rw [scaledBasisEquiv_det, abs_inv, abs_mul,
    abs_of_nonneg (Complex.normSq_nonneg c), complex_omega_im_abs,
    Complex.normSq_eq_norm_sq]
  ring

def eisensteinDualFrequency (c : ℂ) (hc : c ≠ 0) (p : ℤ × ℤ) : ℂ :=
  dualMap (eisensteinLatticeMap c hc) (complexPoint (p.1 : ℝ) (p.2 : ℝ))

theorem actual_eisenstein_coset_poisson (f : 𝓢(ℂ, ℂ)) (b c : O) (hc : c ≠ 0) :
    (∑' z : O, f (ringComplex (b + c * z))) =
      (2 / (Real.sqrt 3 * ‖ringComplex c‖ ^ 2)) • ∑' p : ℤ × ℤ,
        Real.fourierChar (inner ℝ (ringComplex b)
          (eisensteinDualFrequency (ringComplex c) (ringComplex_ne_zero hc) p)) •
        (𝓕 f) (eisensteinDualFrequency (ringComplex c) (ringComplex_ne_zero hc) p) := by
  let A := eisensteinLatticeMap (ringComplex c) (ringComplex_ne_zero hc)
  have h := affine_lattice_poisson f A (ringComplex b)
  rw [eisenstein_inverseJacobian] at h
  calc
    (∑' z : O, f (ringComplex (b + c * z))) =
        ∑' p : ℤ × ℤ, f (ringComplex (b + c * Eisenstein.Coordinates.coordinateEquiv.symm p)) :=
      (Eisenstein.Coordinates.coordinateEquiv.symm.tsum_eq _).symm
    _ = ∑' p : ℤ × ℤ,
        f (A (complexPoint (p.1 : ℝ) (p.2 : ℝ)) + ringComplex b) := by
      apply tsum_congr
      intro p
      congr 1
      rw [map_add, map_mul]
      change ringComplex b + ringComplex c *
          ringComplex (Eisenstein.Coordinates.eval p.1 p.2) = _
      rw [← eisensteinLatticeMap_point]
      exact add_comm _ _
    _ = _ := h

theorem actual_eisenstein_coset_summable_norm (f : 𝓢(ℂ, ℂ)) (b c : O) (hc : c ≠ 0) :
    Summable (fun z : O => ‖f (ringComplex (b + c * z))‖) := by
  let A := eisensteinLatticeMap (ringComplex c) (ringComplex_ne_zero hc)
  have hp := plane_lattice_summable_norm (affinePullback f A (ringComplex b))
  have hpair : Summable (fun p : ℤ × ℤ =>
      ‖f (ringComplex (b + c * Eisenstein.Coordinates.coordinateEquiv.symm p))‖) := by
    convert hp using 1
    funext p
    rw [affinePullback_apply]
    apply congrArg norm
    apply congrArg f
    rw [map_add, map_mul]
    change ringComplex b + ringComplex c *
        ringComplex (Eisenstein.Coordinates.eval p.1 p.2) = _
    rw [← eisensteinLatticeMap_point]
    exact add_comm _ _
  exact (Eisenstein.Coordinates.coordinateEquiv.symm.summable_iff).mp hpair

theorem actual_eisenstein_summable_norm (f : 𝓢(ℂ, ℂ)) :
    Summable (fun z : O => ‖f (ringComplex z)‖) := by
  simpa using actual_eisenstein_coset_summable_norm f 0 1 one_ne_zero

theorem actual_eisenstein_periodic_summable (f : 𝓢(ℂ, ℂ))
    {R : Type*} [Fintype R] (q : O → R) (P : R → ℂ) :
    Summable (fun z : O => P (q z) * f (ringComplex z)) := by
  classical
  let C : ℝ := ∑ r : R, ‖P r‖
  have hP (r : R) : ‖P r‖ ≤ C :=
    Finset.single_le_sum (fun a _ => norm_nonneg (P a)) (Finset.mem_univ r)
  apply Summable.of_norm
  apply Summable.of_nonneg_of_le (fun z => norm_nonneg _) _
    ((actual_eisenstein_summable_norm f).mul_left C)
  intro z
  rw [norm_mul]
  exact mul_le_mul_of_nonneg_right (hP (q z)) (norm_nonneg _)

theorem actual_eisenstein_periodic_poisson (f : 𝓢(ℂ, ℂ)) (c : O) (hc : c ≠ 0)
    (P : O ⧸ Ideal.span {c} → ℂ) :
    letI : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
    letI : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
    (∑' z : O, P (Ideal.Quotient.mk (Ideal.span {c}) z) * f (ringComplex z)) =
      ∑ r : O ⧸ Ideal.span {c}, P r *
        ((2 / (Real.sqrt 3 * ‖ringComplex c‖ ^ 2)) • ∑' p : ℤ × ℤ,
          Real.fourierChar (inner ℝ
            (ringComplex (GaussianShiftedPartition.representative c r))
            (eisensteinDualFrequency (ringComplex c) (ringComplex_ne_zero hc) p)) •
          (𝓕 f) (eisensteinDualFrequency (ringComplex c) (ringComplex_ne_zero hc) p)) := by
  classical
  let : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
  let : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
  rw [GaussianAbelPartition.tsum_periodic_weighted_partition
    (Ideal.Quotient.mk (Ideal.span {c})) P (fun z => f (ringComplex z))
    (actual_eisenstein_periodic_summable f _ P)]
  apply Finset.sum_congr rfl
  intro r hr
  congr 1
  exact (GaussianFiberEquiv.fiber_tsum c hc r
    (GaussianShiftedPartition.representative c r)
    (GaussianShiftedPartition.representative_spec c r)
    (fun z => f (ringComplex z))).trans
      (actual_eisenstein_coset_poisson f _ c hc)

theorem inverseJacobian_pos (A : ℂ ≃L[ℝ] ℂ) : 0 < inverseJacobian A :=
  abs_pos.mpr (inv_ne_zero A.toLinearEquiv.isUnit_det'.ne_zero)

theorem dual_lattice_summable_norm (f : 𝓢(ℂ, ℂ)) (A : ℂ ≃L[ℝ] ℂ) :
    Summable (fun p : ℤ × ℤ =>
      ‖(𝓕 f) (dualMap A (complexPoint (p.1 : ℝ) (p.2 : ℝ)))‖) := by
  have hJ := inverseJacobian_pos A
  have hp := plane_lattice_summable_norm (𝓕 (affinePullback f A 0))
  have hn (p : ℤ × ℤ) :
      ‖(𝓕 (affinePullback f A 0)) (complexPoint (p.1 : ℝ) (p.2 : ℝ))‖ =
      inverseJacobian A * ‖(𝓕 f) (dualMap A (complexPoint (p.1 : ℝ) (p.2 : ℝ)))‖ := by
    rw [fourier_affinePullback]
    simp [ abs_of_pos hJ]
  simp_rw [hn] at hp
  have hi := hp.mul_left (inverseJacobian A)⁻¹
  simpa only [← mul_assoc, inv_mul_cancel₀ hJ.ne', one_mul] using hi

theorem finite_phase_sum {R : Type*} [Fintype R]
    (f : 𝓢(ℂ, ℂ)) (A : ℂ ≃L[ℝ] ℂ) (b : R → ℂ) (P : R → ℂ) :
    (∑ r : R, P r * (inverseJacobian A • ∑' p : ℤ × ℤ,
      Real.fourierChar (inner ℝ (b r) (dualMap A (complexPoint (p.1 : ℝ) (p.2 : ℝ)))) •
        (𝓕 f) (dualMap A (complexPoint (p.1 : ℝ) (p.2 : ℝ))))) =
    inverseJacobian A • ∑' p : ℤ × ℤ,
      (∑ r : R, P r * (Real.fourierChar (inner ℝ (b r)
        (dualMap A (complexPoint (p.1 : ℝ) (p.2 : ℝ)))) : ℂ)) *
        (𝓕 f) (dualMap A (complexPoint (p.1 : ℝ) (p.2 : ℝ))) := by
  classical
  have hs (r : R) : Summable (fun p : ℤ × ℤ =>
      P r * (Real.fourierChar (inner ℝ (b r)
        (dualMap A (complexPoint (p.1 : ℝ) (p.2 : ℝ)))) •
        (𝓕 f) (dualMap A (complexPoint (p.1 : ℝ) (p.2 : ℝ))))) := by
    apply Summable.mul_left
    apply Summable.of_norm
    simpa only [Circle.norm_smul] using dual_lattice_summable_norm f A
  simp_rw [mul_smul_comm, ← tsum_mul_left]
  rw [← Finset.smul_sum, ← Summable.tsum_finsetSum (fun r _ => hs r)]
  congr 1
  apply tsum_congr
  intro p
  simp only [Circle.smul_def, smul_eq_mul, Finset.sum_mul, mul_assoc]

theorem actual_eisenstein_periodic_fourier (f : 𝓢(ℂ, ℂ)) (c : O) (hc : c ≠ 0)
    (P : O ⧸ Ideal.span {c} → ℂ) :
    letI : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
    letI : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
    (∑' z : O, P (Ideal.Quotient.mk (Ideal.span {c}) z) * f (ringComplex z)) =
      (2 / (Real.sqrt 3 * ‖ringComplex c‖ ^ 2)) • ∑' p : ℤ × ℤ,
        (∑ r : O ⧸ Ideal.span {c}, P r *
          (Real.fourierChar (inner ℝ
            (ringComplex (GaussianShiftedPartition.representative c r))
            (eisensteinDualFrequency (ringComplex c) (ringComplex_ne_zero hc) p)) : ℂ)) *
          (𝓕 f) (eisensteinDualFrequency (ringComplex c) (ringComplex_ne_zero hc) p) := by
  classical
  let : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
  let : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
  rw [actual_eisenstein_periodic_poisson f c hc P]
  have h := finite_phase_sum f
    (eisensteinLatticeMap (ringComplex c) (ringComplex_ne_zero hc))
    (fun r => ringComplex (GaussianShiftedPartition.representative c r)) P
  rw [eisenstein_inverseJacobian] at h
  exact h

end SchwartzPlanePoisson

namespace SchwartzPlanePoisson
open Eisenstein MeasureTheory
open scoped FourierTransform SchwartzMap RealInnerProductSpace

/-- The trace-normalized dual frequency is independent of the embedding orientation. -/
def paperFrequency (u : ℂ) : ℂ := 2 * starRingEnd ℂ (u / ringComplex traceLambda)

def paperE (z : ℂ) : ℂ := tracePhase (z / ringComplex traceLambda)

theorem inner_paperFrequency (z u : ℂ) :
    inner ℝ z (paperFrequency u) = 2 * (z * (u / ringComplex traceLambda)).re := by
  simp only [paperFrequency, Complex.inner, Complex.mul_re, Complex.mul_im,
    Complex.conj_re, Complex.conj_im, Complex.re_ofNat, Complex.im_ofNat]
  ring

theorem fourierChar_paperFrequency (z u : ℂ) :
    (Real.fourierChar (inner ℝ z (paperFrequency u)) : ℂ) = paperE (z * u) := by
  rw [inner_paperFrequency, Real.fourierChar_apply]
  change Complex.exp _ = Complex.exp _
  congr 1
  have hdiv : z * u / ringComplex traceLambda = z * (u / ringComplex traceLambda) := by ring
  rw [hdiv]
  generalize z * (u / ringComplex traceLambda) = v
  apply Complex.ext <;> simp [Complex.mul_re, Complex.mul_im] <;> ring

theorem paperFrequency_coordinates (u : ℂ) :
    paperFrequency u = complexPoint (u.im / (ringComplex omega).im)
      (u.re / (ringComplex omega).im) := by
  have hl : ringComplex traceLambda = complexPoint 0 (2 * (ringComplex omega).im) := by
    apply Complex.ext
    · simp only [traceLambda, map_add, map_mul, map_one, map_ofNat, Complex.add_re,
        Complex.mul_re, Complex.one_re, Complex.re_ofNat, Complex.im_ofNat, zero_mul,
        sub_zero, complexPoint]
      linarith only [complex_omega_coordinates.1]
    · simp only [traceLambda, map_add, map_mul, map_one, map_ofNat, Complex.add_im,
        Complex.mul_im, Complex.one_im, Complex.re_ofNat, Complex.im_ofNat,
        zero_mul, zero_add, add_zero, complexPoint]
  rw [paperFrequency, hl]
  apply Complex.ext <;>
    simp only [Complex.mul_re, Complex.mul_im, Complex.conj_re, Complex.conj_im,
      Complex.div_re, Complex.div_im, Complex.normSq_apply, Complex.re_ofNat,
      Complex.im_ofNat, complexPoint] <;>
    field_simp [complex_omega_im_ne_zero] <;> ring

def dualFrequencyEquiv : ℤ × ℤ ≃ O :=
  ({ toFun := fun z => (z.1 + z.2, z.1)
     invFun := fun z => (z.2, z.1 - z.2)
     left_inv := by rintro ⟨k,l⟩; simp
     right_inv := by rintro ⟨k,l⟩; simp } : (ℤ × ℤ) ≃ (ℤ × ℤ)).trans
    Eisenstein.Coordinates.coordinateEquiv.symm

theorem dualFrequencyEquiv_coordinates (p : ℤ × ℤ) :
    ringComplex (dualFrequencyEquiv p) =
      complexPoint ((p.1 : ℝ) / 2 + (p.2 : ℝ))
        ((ringComplex omega).im * (p.1 : ℝ)) := by
  change ringComplex (Eisenstein.Coordinates.eval (p.1 + p.2) p.1) = _
  rw [ringComplex_eval]
  apply Complex.ext
  · simp only [Complex.add_re, Complex.mul_re, Complex.intCast_re,
      Complex.intCast_im, zero_mul, sub_zero, complexPoint]
    push_cast
    rw [complex_omega_coordinates.1]
    ring
  · simp [complexPoint, mul_comm]

theorem dualMap_trans (A B : ℂ ≃L[ℝ] ℂ) (z : ℂ) :
    dualMap (A.trans B) z = dualMap B (dualMap A z) := by
  change (ContinuousLinearMap.adjoint
    (A.symm.toContinuousLinearMap.comp B.symm.toContinuousLinearMap)) z = _
  rw [ContinuousLinearMap.adjoint_comp]
  rfl

theorem dual_basis_apply (w : ℂ) (hw : w.im ≠ 0) (z : ℂ) :
    dualMap (basisEquiv w hw) z =
      complexPoint z.re ((z.im - w.re * z.re) / w.im) := by
  apply ext_inner_left ℝ
  intro v
  rw [dualMap, ContinuousLinearMap.adjoint_inner_right]
  change inner ℝ ((basisEquiv w hw).symm v) z = _
  simp only [basisEquiv_symm_apply, Complex.inner, complexPoint,
    Complex.mul_re, Complex.conj_re, Complex.conj_im]
  field_simp [hw]
  ring

theorem dual_mul_apply (c : ℂ) (hc : c ≠ 0) (z : ℂ) :
    dualMap (complexMulEquiv c hc) z = (starRingEnd ℂ c)⁻¹ * z := by
  apply ext_inner_left ℝ
  intro v
  rw [dualMap, ContinuousLinearMap.adjoint_inner_right]
  change inner ℝ (c⁻¹ * v) z = _
  simp only [Complex.inner, map_mul, map_inv₀]
  congr 1
  ring

theorem eisensteinDualFrequency_eq_paperFrequency (c : ℂ) (hc : c ≠ 0) (p : ℤ × ℤ) :
    eisensteinDualFrequency c hc p = paperFrequency (ringComplex (dualFrequencyEquiv p) / c) := by
  have hb : dualMap (basisEquiv (ringComplex omega) complex_omega_im_ne_zero)
      (complexPoint (p.1 : ℝ) (p.2 : ℝ)) =
      paperFrequency (ringComplex (dualFrequencyEquiv p)) := by
    rw [dual_basis_apply, paperFrequency_coordinates, dualFrequencyEquiv_coordinates]
    apply Complex.ext
    · simp [complexPoint, complex_omega_im_ne_zero]
    · simp only [complexPoint]
      congr 1
      rw [complex_omega_coordinates.1]
      ring
  unfold eisensteinDualFrequency eisensteinLatticeMap scaledBasisEquiv
  rw [dualMap_trans, hb, dual_mul_apply]
  simp only [paperFrequency, map_div₀]
  ring

theorem eisensteinDualFrequency_phase (r c : ℂ) (hc : c ≠ 0) (p : ℤ × ℤ) :
    (Real.fourierChar (inner ℝ r (eisensteinDualFrequency c hc p)) : ℂ) =
      paperE (r * ringComplex (dualFrequencyEquiv p) / c) := by
  rw [eisensteinDualFrequency_eq_paperFrequency, fourierChar_paperFrequency]
  congr 1
  ring

def paperFourier (f : ℂ → ℂ) (u : ℂ) : ℂ :=
  (2 / Real.sqrt 3 : ℝ) • ∫ z : ℂ, paperE (-(z * u)) * f z

theorem paperFourier_eq_standard (f : ℂ → ℂ) (u : ℂ) :
    paperFourier f u = (2 / Real.sqrt 3 : ℝ) • 𝓕 f (paperFrequency u) := by
  unfold paperFourier
  congr 1
  rw [Real.fourier_eq]
  apply integral_congr_ae
  filter_upwards [] with z
  simp only [Circle.smul_def, smul_eq_mul]
  have hp : (Real.fourierChar (-inner ℝ z (paperFrequency u)) : ℂ) =
      paperE (-(z * u)) := by
    simpa only [inner_neg_left, neg_mul] using fourierChar_paperFrequency (-z) u
  rw [hp]

/-- Periodic Schwartz sums transform into the primitive trace-dual Eisenstein lattice. -/
theorem actual_eisenstein_paper_poisson (f : 𝓢(ℂ, ℂ)) (c : O) (hc : c ≠ 0)
    (P : O ⧸ Ideal.span {c} → ℂ) :
    letI : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
    letI : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
    (∑' z : O, P (Ideal.Quotient.mk (Ideal.span {c}) z) * f (ringComplex z)) =
      (1 / ‖ringComplex c‖ ^ 2 : ℝ) • ∑' h : O,
        (∑ r : O ⧸ Ideal.span {c}, P r *
          paperE (ringComplex (GaussianShiftedPartition.representative c r) *
            ringComplex h / ringComplex c)) *
          paperFourier f (ringComplex h / ringComplex c) := by
  classical
  let : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
  let : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
  let A : O → ℂ := fun h => ∑ r : O ⧸ Ideal.span {c}, P r *
    paperE (ringComplex (GaussianShiftedPartition.representative c r) *
      ringComplex h / ringComplex c)
  have ht : (∑' h : O, A h * paperFourier f (ringComplex h / ringComplex c)) =
      (2 / Real.sqrt 3 : ℝ) • ∑' p : ℤ × ℤ,
        A (dualFrequencyEquiv p) *
          (𝓕 f) (eisensteinDualFrequency (ringComplex c) (ringComplex_ne_zero hc) p) := by
    calc
      _ = ∑' p : ℤ × ℤ, A (dualFrequencyEquiv p) *
          paperFourier f (ringComplex (dualFrequencyEquiv p) / ringComplex c) :=
        (dualFrequencyEquiv.tsum_eq _).symm
      _ = ∑' p : ℤ × ℤ, (2 / Real.sqrt 3 : ℝ) •
          (A (dualFrequencyEquiv p) *
            (𝓕 f) (eisensteinDualFrequency (ringComplex c) (ringComplex_ne_zero hc) p)) := by
        apply tsum_congr
        intro p
        rw [paperFourier_eq_standard, ← eisensteinDualFrequency_eq_paperFrequency _ (ringComplex_ne_zero hc)]
        change A (dualFrequencyEquiv p) *
          ((2 / Real.sqrt 3 : ℝ) • (𝓕 f) (eisensteinDualFrequency (ringComplex c) (ringComplex_ne_zero hc) p)) = _
        simp only [Algebra.smul_def]
        ring
      _ = _ := tsum_const_smul'' _
    rfl
  have hp := actual_eisenstein_periodic_fourier f c hc P
  simp_rw [eisensteinDualFrequency_phase] at hp
  change _ = (1 / ‖ringComplex c‖ ^ 2 : ℝ) •
    ∑' h : O, A h * paperFourier f (ringComplex h / ringComplex c)
  rw [ht, smul_smul]
  convert hp using 1
  congr 1
  ring

end SchwartzPlanePoisson

namespace SchwartzPlanePoisson
open Eisenstein MeasureTheory
open scoped FourierTransform SchwartzMap RealInnerProductSpace ContDiff

def radialTest (W : 𝓢(ℝ, ℂ)) : 𝓢(ℂ, ℂ) :=
  SchwartzMap.compCLM ℂ (Function.hasTemperateGrowth_norm_sq ℂ)
    ⟨1, 1, fun z => by
      simp only [pow_one, one_mul, norm_pow, Real.norm_of_nonneg (norm_nonneg z)]
      nlinarith [sq_nonneg (‖z‖ - 1)]⟩ W

@[simp] theorem radialTest_apply (W : 𝓢(ℝ, ℂ)) (z : ℂ) :
    radialTest W z = W (‖z‖ ^ 2) := rfl

theorem paperFourier_comp_mul (f : ℂ → ℂ) (a : ℂ) (ha : a ≠ 0) (u : ℂ) :
    paperFourier (fun z => f (a * z)) u =
      (1 / ‖a‖ ^ 2 : ℝ) • paperFourier f (u / a) := by
  have hd : dualMap (complexMulEquiv a ha) (paperFrequency u) =
      paperFrequency (u / a) := by
    rw [dual_mul_apply]
    unfold paperFrequency
    simp only [map_div₀]
    ring
  have hj : inverseJacobian (complexMulEquiv a ha) = 1 / ‖a‖ ^ 2 := by
    rw [inverseJacobian, complexMulEquiv_det, abs_inv,
      abs_of_nonneg (Complex.normSq_nonneg a), Complex.sq_norm]
    ring
  rw [paperFourier_eq_standard, paperFourier_eq_standard]
  have hF := fourier_comp_linearEquiv (complexMulEquiv a ha) f (paperFrequency u)
  simp only [Function.comp_def, complexMulEquiv_apply] at hF
  rw [hF, hd, hj, smul_smul, smul_smul]
  congr 1
  ring

def paperRadialFourier (W : ℝ → ℂ) (t : ℝ) : ℂ :=
  paperFourier (fun z => W (‖z‖ ^ 2)) (Real.sqrt t : ℂ)

theorem paperFourier_radial (W : ℝ → ℂ) (u : ℂ) :
    paperFourier (fun z => W (‖z‖ ^ 2)) u =
      paperRadialFourier W (‖u‖ ^ 2) := by
  unfold paperRadialFourier
  rw [Real.sqrt_sq (norm_nonneg u)]
  by_cases hu : u = 0
  · simp [hu]
  have hn : ‖u‖ ≠ 0 := norm_ne_zero_iff.mpr hu
  have hnC : (‖u‖ : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hn
  let a : ℂ := u / (‖u‖ : ℂ)
  have ha : a ≠ 0 := div_ne_zero hu hnC
  have hna : ‖a‖ = 1 := by
    simp [a, Complex.norm_real, hn]
  have hq : u / a = (‖u‖ : ℂ) := by
    dsimp [a]
    field_simp
  have hfun : (fun z : ℂ => W (‖a * z‖ ^ 2)) = fun z : ℂ => W (‖z‖ ^ 2) := by
    funext z
    rw [norm_mul, hna, one_mul]
  have hF := paperFourier_comp_mul (fun z => W (‖z‖ ^ 2)) a ha u
  rw [hfun, hna, hq] at hF
  simpa using hF

theorem inverseSqrt_ne_zero (K : ℝ) (hK : 0 < K) :
    (Real.sqrt K : ℂ)⁻¹ ≠ 0 :=
  inv_ne_zero (Complex.ofReal_ne_zero.mpr (ne_of_gt (Real.sqrt_pos.mpr hK)))

theorem inverseSqrt_norm_sq (K : ℝ) (hK : 0 < K) :
    ‖(Real.sqrt K : ℂ)⁻¹‖ ^ 2 = 1 / K := by
  rw [norm_inv, inv_pow]
  simp only [Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (Real.sqrt_nonneg K), Real.sq_sqrt hK.le, one_div]

theorem paperFourier_radial_scaled (W : ℝ → ℂ) (K : ℝ) (hK : 0 < K) (u : ℂ) :
    paperFourier (fun z => W (‖z‖ ^ 2 / K)) u =
      K • paperRadialFourier W (K * ‖u‖ ^ 2) := by
  let a : ℂ := (Real.sqrt K : ℂ)⁻¹
  have ha : a ≠ 0 := inverseSqrt_ne_zero K hK
  have hna : ‖a‖ ^ 2 = 1 / K := inverseSqrt_norm_sq K hK
  have hfun : (fun z : ℂ => W (‖a * z‖ ^ 2)) =
      fun z : ℂ => W (‖z‖ ^ 2 / K) := by
    funext z
    rw [norm_mul, mul_pow, hna]
    congr 1
    ring
  have hnorm : ‖u / a‖ ^ 2 = K * ‖u‖ ^ 2 := by
    rw [norm_div, div_pow, hna]
    field_simp
  have hF := paperFourier_comp_mul (fun z => W (‖z‖ ^ 2)) a ha u
  rw [hfun, hna, one_div_one_div, paperFourier_radial, hnorm] at hF
  exact hF

def scaledRadialTest (W : 𝓢(ℝ, ℂ)) (K : ℝ) (hK : 0 < K) : 𝓢(ℂ, ℂ) :=
  affinePullback (radialTest W)
    (complexMulEquiv ((Real.sqrt K : ℂ)⁻¹) (inverseSqrt_ne_zero K hK)) 0

@[simp] theorem scaledRadialTest_apply (W : 𝓢(ℝ, ℂ)) (K : ℝ) (hK : 0 < K) (z : ℂ) :
    scaledRadialTest W K hK z = W (‖z‖ ^ 2 / K) := by
  simp only [scaledRadialTest, affinePullback_apply, complexMulEquiv_apply,
    add_zero, radialTest_apply, norm_mul, mul_pow, inverseSqrt_norm_sq K hK]
  congr 1
  ring

theorem paperFourier_scaledRadialTest (W : 𝓢(ℝ, ℂ)) (K : ℝ) (hK : 0 < K) (u : ℂ) :
    paperFourier (scaledRadialTest W K hK) u =
      K • paperRadialFourier W (K * ‖u‖ ^ 2) := by
  change paperFourier (fun z => scaledRadialTest W K hK z) u = _
  simp only [scaledRadialTest_apply]
  exact paperFourier_radial_scaled W K hK u

theorem actual_radial_paper_poisson (W : 𝓢(ℝ, ℂ)) (K : ℝ) (hK : 0 < K)
    (c : O) (hc : c ≠ 0) (P : O ⧸ Ideal.span {c} → ℂ) :
    letI : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
    letI : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
    (∑' z : O, P (Ideal.Quotient.mk (Ideal.span {c}) z) * W (‖ringComplex z‖ ^ 2 / K)) =
      (K / ‖ringComplex c‖ ^ 2 : ℝ) • ∑' h : O,
        (∑ r : O ⧸ Ideal.span {c}, P r *
          paperE (ringComplex (GaussianShiftedPartition.representative c r) * ringComplex h / ringComplex c)) *
          paperRadialFourier W (K * ‖ringComplex h‖ ^ 2 / ‖ringComplex c‖ ^ 2) := by
  classical
  let : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
  let : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
  let A : O → ℂ := fun h => ∑ r : O ⧸ Ideal.span {c}, P r *
    paperE (ringComplex (GaussianShiftedPartition.representative c r) * ringComplex h / ringComplex c)
  have ht : (∑' h : O, A h *
      paperFourier (scaledRadialTest W K hK) (ringComplex h / ringComplex c)) =
      K • ∑' h : O, A h *
        paperRadialFourier W (K * ‖ringComplex h‖ ^ 2 / ‖ringComplex c‖ ^ 2) := by
    calc
      _ = ∑' h : O, K • (A h *
          paperRadialFourier W (K * ‖ringComplex h‖ ^ 2 / ‖ringComplex c‖ ^ 2)) := by
        apply tsum_congr
        intro h
        rw [paperFourier_scaledRadialTest, norm_div, div_pow]
        have hr : K * (‖ringComplex h‖ ^ 2 / ‖ringComplex c‖ ^ 2) =
            K * ‖ringComplex h‖ ^ 2 / ‖ringComplex c‖ ^ 2 := by ring
        rw [hr]
        simp only [Algebra.smul_def]
        ring
      _ = _ := tsum_const_smul'' _
  have hp := actual_eisenstein_paper_poisson (scaledRadialTest W K hK) c hc P
  change (∑' z : O, P (Ideal.Quotient.mk (Ideal.span {c}) z) *
    scaledRadialTest W K hK (ringComplex z)) =
    (1 / ‖ringComplex c‖ ^ 2 : ℝ) • ∑' h : O, A h *
      paperFourier (scaledRadialTest W K hK) (ringComplex h / ringComplex c) at hp
  rw [ht, smul_smul] at hp
  simpa only [scaledRadialTest_apply, one_div_mul_eq_div] using hp

theorem actual_compact_radial_paper_poisson (W : ℝ → ℂ)
    (hWc : HasCompactSupport W) (hWs : ContDiff ℝ ∞ W) (K : ℝ) (hK : 0 < K)
    (c : O) (hc : c ≠ 0) (P : O ⧸ Ideal.span {c} → ℂ) :
    letI : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
    letI : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
    (∑' z : O, P (Ideal.Quotient.mk (Ideal.span {c}) z) * W (‖ringComplex z‖ ^ 2 / K)) =
      (K / ‖ringComplex c‖ ^ 2 : ℝ) • ∑' h : O,
        (∑ r : O ⧸ Ideal.span {c}, P r *
          paperE (ringComplex (GaussianShiftedPartition.representative c r) * ringComplex h / ringComplex c)) *
          paperRadialFourier W (K * ‖ringComplex h‖ ^ 2 / ‖ringComplex c‖ ^ 2) := by
  exact actual_radial_paper_poisson (hWc.toSchwartzMap hWs) K hK c hc P

end SchwartzPlanePoisson

namespace SchwartzPlanePoisson
open Eisenstein MulChar AddChar

/-- The finite transform of a primitive multiplicative row is its inverse row times one Gauss factor. -/
theorem finite_crt_gauss_transform {ι R : Type*} [Fintype ι] [DecidableEq ι]
    (F : ι → Type*) [∀ i, Field (F i)] [∀ i, Fintype (F i)]
    [CommRing R] [Fintype R] (e : R ≃+* ∀ i, F i)
    (χ : ∀ i, MulChar (F i) ℂ) (hχ : ∀ i, χ i ≠ 1)
    (ψ : AddChar R ℂ) (h : R) :
    (∑ x : R, (∏ i, χ i (e x i)) * ψ (h * x)) =
      (∏ i, (χ i)⁻¹ (e h i)) * ∑ x : R, (∏ i, χ i (e x i)) * ψ x := by
  let ψ₀ := ψ.compAddMonoidHom e.symm.toAddMonoidHom
  have hl (i : ι) :
      ProductGauss.localChar F ((ψ.mulShift h).compAddMonoidHom e.symm.toAddMonoidHom) i =
        (ProductGauss.localChar F ψ₀ i).mulShift (e h i) := by
    ext x
    change ψ (h * e.symm (Pi.single i x)) = ψ (e.symm (Pi.single i (e h i * x)))
    congr 1
    apply e.injective
    simp only [map_mul, e.apply_symm_apply]
    ext k
    by_cases hik : i = k
    · subst k; simp
    · simp [Pi.single_eq_of_ne (Ne.symm hik)]
  change (∑ x : R, (∏ i, χ i (e x i)) * (ψ.mulShift h) x) = _
  rw [ProductGauss.factorization_equiv F e χ (ψ.mulShift h),
    ProductGauss.factorization_equiv F e χ ψ]
  simp_rw [hl, finiteGauss_mulShift_all _ _ (hχ _)]
  exact Finset.prod_mul_distrib

/-- Squared Gauss mass is exactly the residue-ring size. -/
theorem finite_crt_gauss_norm_sq {ι R : Type*} [Fintype ι] [DecidableEq ι]
    (F : ι → Type*) [∀ i, Field (F i)] [∀ i, Fintype (F i)]
    [CommRing R] [Fintype R] (e : R ≃+* ∀ i, F i)
    (χ : ∀ i, MulChar (F i) ℂ) (hχ : ∀ i, χ i ≠ 1)
    (ψ : AddChar R ℂ) (hψ : ψ.IsPrimitive) :
    ‖∑ x : R, (∏ i, χ i (e x i)) * ψ x‖ ^ 2 = (Fintype.card R : ℝ) := by
  have hp := ProductGauss.primitive_comp_ringEquiv e.symm ψ hψ
  rw [ProductGauss.factorization_equiv F e χ ψ, norm_prod, ← Finset.prod_pow]
  have hn (i : ι) :
      ‖gaussSum (χ i) (ProductGauss.localChar F
        (ψ.compAddMonoidHom e.symm.toAddMonoidHom) i)‖ ^ 2 = (Fintype.card (F i) : ℝ) := by
    rw [← Complex.normSq_eq_norm_sq,
      ArithmeticEffectivityTheory.normSq_gaussSum_eq_card (hχ i)
        (ProductGauss.localChar_primitive F _ hp i)]
  simp_rw [hn]
  rw [Fintype.card_congr e.toEquiv, Fintype.card_pi, Nat.cast_prod]

end SchwartzPlanePoisson

namespace SchwartzPlanePoisson
open Eisenstein MulChar AddChar
open scoped SchwartzMap ContDiff

lemma residueTraceQuotientChar_frequency (c : O) (hc : c ≠ 0)
    (h : O) (r : O ⧸ Ideal.span {c}) :
    residueTraceQuotientChar 1 c hc (Ideal.Quotient.mk (Ideal.span {c}) h * r) =
      paperE (ringComplex (GaussianShiftedPartition.representative c r) * ringComplex h / ringComplex c) := by
  conv_lhs => rw [← GaussianShiftedPartition.representative_spec c r, ← map_mul]
  rw [residueTraceQuotientChar_phase, one_mul]
  simp only [paperE, map_mul]
  congr 1
  ring

/-- The radial second Poisson transformation uses the same primitive trace character as cubic reflection. -/
theorem actual_radial_poisson_trace (W : 𝓢(ℝ, ℂ)) (Y : ℝ) (hY : 0 < Y)
    (c : O) (hc : c ≠ 0) (P : O ⧸ Ideal.span {c} → ℂ) :
    letI : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
    letI : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
    (∑' z : O, P (Ideal.Quotient.mk (Ideal.span {c}) z) * W (‖ringComplex z‖ ^ 2 / Y)) =
      (Y / ‖ringComplex c‖ ^ 2 : ℝ) • ∑' h : O,
        (∑ r : O ⧸ Ideal.span {c}, P r *
          residueTraceQuotientChar 1 c hc (Ideal.Quotient.mk (Ideal.span {c}) h * r)) *
          paperRadialFourier W (Y * ‖ringComplex h‖ ^ 2 / ‖ringComplex c‖ ^ 2) := by
  classical
  let : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
  let : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
  simpa only [residueTraceQuotientChar_frequency] using actual_radial_paper_poisson W Y hY c hc P

/-- A nontrivial character in each prime coordinate transforms into its inverse row with exact Gauss mass. -/
theorem actual_radial_crt_character_poisson {ι : Type*} [Fintype ι] [DecidableEq ι]
    (F : ι → Type*) [∀ i, Field (F i)] [∀ i, Fintype (F i)]
    (c : O) (hc : c ≠ 0) (e : (O ⧸ Ideal.span {c}) ≃+* ∀ i, F i)
    (χ : ∀ i, MulChar (F i) ℂ) (hχ : ∀ i, χ i ≠ 1) :
    letI : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
    letI : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
    ∃ G : ℂ, ‖G‖ ^ 2 = (Fintype.card (O ⧸ Ideal.span {c}) : ℝ) ∧
      ∀ (W : 𝓢(ℝ, ℂ)) (Y : ℝ), 0 < Y →
        (∑' z : O, (∏ i, χ i (e (Ideal.Quotient.mk (Ideal.span {c}) z) i)) *
          W (‖ringComplex z‖ ^ 2 / Y)) =
        (Y / ‖ringComplex c‖ ^ 2 : ℝ) • (G * ∑' h : O,
          (∏ i, (χ i)⁻¹ (e (Ideal.Quotient.mk (Ideal.span {c}) h) i)) *
            paperRadialFourier W (Y * ‖ringComplex h‖ ^ 2 / ‖ringComplex c‖ ^ 2)) := by
  classical
  let : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
  let : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
  let ψ := residueTraceQuotientChar 1 c hc
  let P : O ⧸ Ideal.span {c} → ℂ := fun x => ∏ i, χ i (e x i)
  refine ⟨∑ x, P x * ψ x,
    finite_crt_gauss_norm_sq F e χ hχ ψ (residueTraceQuotientChar_primitive c hc), ?_⟩
  intro W Y hY
  rw [actual_radial_poisson_trace W Y hY c hc P]
  congr 1
  rw [← tsum_mul_left]
  apply tsum_congr
  intro h
  rw [finite_crt_gauss_transform F e χ hχ ψ]
  ring

end SchwartzPlanePoisson

namespace SchwartzPlanePoisson
open Eisenstein MulChar AddChar
open scoped SchwartzMap ContDiff

/-- The analytic normalization leaves a unit Gauss phase and the square-root conductor factor. -/
theorem actual_radial_crt_character_poisson_normalized {ι : Type*} [Fintype ι] [DecidableEq ι]
    (F : ι → Type*) [∀ i, Field (F i)] [∀ i, Fintype (F i)]
    (c : O) (hc : c ≠ 0) (e : (O ⧸ Ideal.span {c}) ≃+* ∀ i, F i)
    (χ : ∀ i, MulChar (F i) ℂ) (hχ : ∀ i, χ i ≠ 1) :
    ∃ β : ℂ, ‖β‖ = 1 ∧ ∀ (W : 𝓢(ℝ, ℂ)) (Y : ℝ), 0 < Y →
      (∑' z : O, (∏ i, χ i (e (Ideal.Quotient.mk (Ideal.span {c}) z) i)) *
        W (‖ringComplex z‖ ^ 2 / Y)) =
      ((Y : ℂ) * β / (‖ringComplex c‖ : ℂ)) * ∑' h : O,
        (∏ i, (χ i)⁻¹ (e (Ideal.Quotient.mk (Ideal.span {c}) h) i)) *
          paperRadialFourier W (Y * ‖ringComplex h‖ ^ 2 / ‖ringComplex c‖ ^ 2) := by
  classical
  let : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
  let : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
  obtain ⟨G, hG, hP⟩ := actual_radial_crt_character_poisson F c hc e χ hχ
  have hcard : (Fintype.card (O ⧸ Ideal.span {c}) : ℝ) = ‖ringComplex c‖ ^ 2 := by
    simpa only [Ideal.absNorm_apply, Submodule.cardQuot_apply, Nat.card_eq_fintype_card]
      using (ringComplex_norm_sq_eq_absNorm_span c).symm
  have hnorm : ‖G‖ = ‖ringComplex c‖ :=
    (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp (hG.trans hcard)
  have hn : ‖ringComplex c‖ ≠ 0 := norm_ne_zero_iff.mpr (ringComplex_ne_zero hc)
  refine ⟨G / (‖ringComplex c‖ : ℂ), ?_, ?_⟩
  · rw [norm_div, hnorm, Complex.norm_real, Real.norm_of_nonneg (norm_nonneg _), div_self hn]
  · intro W Y hY
    rw [hP W Y hY]
    change ((Y / ‖ringComplex c‖ ^ 2 : ℝ) : ℂ) * _ = _
    push_cast
    ring

lemma span_finset_prime_product {ι : Type*} (p : ι → O) (s : Finset ι) :
    Ideal.span {∏ i ∈ s, p i} = ∏ i ∈ s, Ideal.span {p i} := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
    simp only [Finset.prod_insert hi, ← Ideal.span_singleton_mul_span_singleton, ih]

/-- Second Poisson reflection for a finite family of actual prime residue characters. -/
theorem prime_row_radial_poisson {ι : Type*} [Fintype ι] [DecidableEq ι]
    (p : ι → O) (hp : ∀ i, p i ≠ 0)
    [∀ i, (Ideal.span {p i}).IsMaximal]
    (hinj : Function.Injective (fun i => Ideal.span {p i}))
    (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) (hχ : ∀ i, χ i ≠ 1) :
    ∃ β : ℂ, ‖β‖ = 1 ∧ ∀ (W : 𝓢(ℝ, ℂ)) (Y : ℝ), 0 < Y →
      (∑' z : O, primeCuspRowCharacter p χ z * W (‖ringComplex z‖ ^ 2 / Y)) =
      ((Y : ℂ) * β / (‖ringComplex (∏ i, p i)‖ : ℂ)) * ∑' h : O,
        primeCuspRowCharacter p (fun i => (χ i)⁻¹) h *
          paperRadialFourier W (Y * ‖ringComplex h‖ ^ 2 / ‖ringComplex (∏ i, p i)‖ ^ 2) := by
  classical
  let P : ι → Ideal O := fun i => Ideal.span {p i}
  let c := ∏ i, p i
  have hc : c ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun i _ => hp i)
  have hspan : Ideal.span {c} = ∏ i, P i := span_finset_prime_product p Finset.univ
  let e : (O ⧸ Ideal.span {c}) ≃+* ∀ i, O ⧸ P i :=
    (Ideal.quotEquivOfEq hspan).trans (Eisenstein.primeCRT P hinj)
  have he (z : O) (i : ι) :
      e (Ideal.Quotient.mk (Ideal.span {c}) z) i = Ideal.Quotient.mk (P i) z := by
    simp only [e, RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk, Eisenstein.primeCRT]
    rfl
  obtain ⟨β, hβ, h⟩ := actual_radial_crt_character_poisson_normalized
    (fun i => O ⧸ P i) c hc e χ hχ
  refine ⟨β, hβ, ?_⟩
  intro W Y hY
  change (∑' z : O, (∏ i, χ i (Ideal.Quotient.mk (P i) z)) * W (‖ringComplex z‖ ^ 2 / Y)) =
    ((Y : ℂ) * β / (‖ringComplex c‖ : ℂ)) * ∑' h : O,
      (∏ i, (χ i)⁻¹ (Ideal.Quotient.mk (P i) h)) *
        paperRadialFourier W (Y * ‖ringComplex h‖ ^ 2 / ‖ringComplex c‖ ^ 2)
  simpa only [he] using h W Y hY

end SchwartzPlanePoisson


namespace SchwartzPlanePoisson
open Eisenstein MeasureTheory Set
open scoped FourierTransform SchwartzMap RealInnerProductSpace ContDiff

lemma paperFrequency_norm_sq (u : ℂ) :
    ‖paperFrequency u‖ ^ 2 = (4 / 3 : ℝ) * ‖u‖ ^ 2 := by
  rw [paperFrequency_coordinates]
  simp only [Complex.sq_norm, Complex.normSq_apply, ← pow_two]
  change (u.im / (ringComplex omega).im) ^ 2 + (u.re / (ringComplex omega).im) ^ 2 =
    (4 / 3 : ℝ) * (u.re ^ 2 + u.im ^ 2)
  rw [div_pow, div_pow, complex_omega_coordinates.2]
  ring

def radialTestCLM : 𝓢(ℝ, ℂ) →L[ℝ] 𝓢(ℂ, ℂ) :=
  SchwartzMap.compCLM ℝ (Function.hasTemperateGrowth_norm_sq ℂ)
    ⟨1, 1, fun z => by
      simp only [pow_one, one_mul, norm_pow, Real.norm_of_nonneg (norm_nonneg z)]
      nlinarith [sq_nonneg (‖z‖ - 1)]⟩

@[simp] theorem radialTestCLM_apply (W : 𝓢(ℝ, ℂ)) : radialTestCLM W = radialTest W := by
  ext z
  rfl

def radialFourierCLM : 𝓢(ℝ, ℂ) →L[ℝ] 𝓢(ℂ, ℂ) :=
  (FourierTransform.fourierCLM ℝ 𝓢(ℂ, ℂ)).comp radialTestCLM

@[simp] theorem radialFourierCLM_apply (W : 𝓢(ℝ, ℂ)) :
    radialFourierCLM W = 𝓕 (radialTest W) := by
  simp [radialFourierCLM]

theorem paperRadialFourier_eq_plane (W : 𝓢(ℝ, ℂ)) (t : ℝ) :
    paperRadialFourier W t =
      (2 / Real.sqrt 3 : ℝ) • radialFourierCLM W (paperFrequency (Real.sqrt t : ℂ)) := by
  rw [paperRadialFourier, paperFourier_eq_standard, radialFourierCLM_apply]
  rfl

theorem paperFrequency_sqrt_norm_sq (t : ℝ) (ht : 0 ≤ t) :
    ‖paperFrequency (Real.sqrt t : ℂ)‖ ^ 2 = (4 / 3 : ℝ) * t := by
  rw [paperFrequency_norm_sq]
  simp only [Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (Real.sqrt_nonneg t), Real.sq_sqrt ht]

theorem paperRadialFourier_weighted_bound (W : 𝓢(ℝ, ℂ)) (A : ℕ)
    (t : ℝ) (ht : 0 ≤ t) :
    (1 + t) ^ A * ‖paperRadialFourier W t‖ ≤
      (2 / Real.sqrt 3 : ℝ) * 2 ^ (2 * A) *
        (Finset.Iic (2 * A, 0)).sup (schwartzSeminormFamily ℝ ℂ ℂ)
          (radialFourierCLM W) := by
  let ξ : ℂ := paperFrequency (Real.sqrt t : ℂ)
  have hn : ‖ξ‖ ^ 2 = (4 / 3 : ℝ) * t := paperFrequency_sqrt_norm_sq t ht
  have hscale : 0 ≤ (2 / Real.sqrt 3 : ℝ) := by positivity
  have hpow : (1 + t) ^ A ≤ (1 + ‖ξ‖) ^ (2 * A) := by
    have hbase : 1 + t ≤ (1 + ‖ξ‖) ^ 2 := by
      nlinarith [norm_nonneg ξ]
    calc
      (1 + t) ^ A ≤ ((1 + ‖ξ‖) ^ 2) ^ A := pow_le_pow_left₀ (by positivity) hbase A
      _ = _ := by rw [← pow_mul]
  have hb := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ)
    (m := (2 * A, 0)) (k := 2 * A) (n := 0) le_rfl le_rfl (radialFourierCLM W) ξ
  simp only [norm_iteratedFDeriv_zero] at hb
  have hsf : (fun m : ℕ × ℕ => SchwartzMap.seminorm ℝ m.1 m.2) =
      schwartzSeminormFamily ℝ ℂ ℂ := by
    funext m
    rcases m with ⟨k, n⟩
    rfl
  rw [hsf] at hb
  rw [paperRadialFourier_eq_plane, norm_smul, Real.norm_eq_abs, abs_of_nonneg hscale]
  change (1 + t) ^ A * ((2 / Real.sqrt 3) * ‖radialFourierCLM W ξ‖) ≤ _
  calc
    _ = (2 / Real.sqrt 3) * ((1 + t) ^ A * ‖radialFourierCLM W ξ‖) := by ring
    _ ≤ (2 / Real.sqrt 3) * ((1 + ‖ξ‖) ^ (2 * A) * ‖radialFourierCLM W ξ‖) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_right hpow (norm_nonneg _)) hscale
    _ ≤ _ := by
      simpa only [mul_assoc, add_zero] using mul_le_mul_of_nonneg_left hb hscale

theorem schwartzCLM_finite_seminorm_control
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (T : 𝓢(ℝ, ℂ) →L[ℝ] 𝓢(E, ℂ)) (S : Finset (ℕ × ℕ)) :
    ∃ (s : Finset (ℕ × ℕ)) (C : ℝ), 0 < C ∧ ∀ W : 𝓢(ℝ, ℂ),
      S.sup (schwartzSeminormFamily ℝ E ℂ) (T W) ≤
        C * s.sup (schwartzSeminormFamily ℝ ℝ ℂ) W := by
  let q : Seminorm ℝ 𝓢(ℝ, ℂ) :=
    (S.sup (schwartzSeminormFamily ℝ E ℂ)).comp T.toLinearMap
  have hq : Continuous q :=
    (((schwartz_withSeminorms ℝ E ℂ).finset_sups).continuous_seminorm S).comp T.continuous
  obtain ⟨s, C, hC, hbound⟩ :=
    Seminorm.bound_of_continuous (schwartz_withSeminorms ℝ ℝ ℂ) q hq
  refine ⟨s, C, ?_, ?_⟩
  · exact_mod_cast (pos_iff_ne_zero.mpr hC : 0 < C)
  · intro W
    exact Seminorm.le_def.mp hbound W

theorem paperRadialFourier_source_weighted_bound (A : ℕ) :
    ∃ (s : Finset (ℕ × ℕ)) (C : ℝ), 0 < C ∧
      ∀ (W : 𝓢(ℝ, ℂ)) (t : ℝ), 0 ≤ t →
        (1 + t) ^ A * ‖paperRadialFourier W t‖ ≤
          C * s.sup (schwartzSeminormFamily ℝ ℝ ℂ) W := by
  obtain ⟨s, C, hC, hbound⟩ :=
    schwartzCLM_finite_seminorm_control radialFourierCLM (Finset.Iic (2 * A, 0))
  refine ⟨s, (2 / Real.sqrt 3) * 2 ^ (2 * A) * C, by positivity, ?_⟩
  intro W t ht
  apply (paperRadialFourier_weighted_bound W A t ht).trans
  simpa only [mul_assoc] using
    mul_le_mul_of_nonneg_left (hbound W)
      (show 0 ≤ (2 / Real.sqrt 3) * 2 ^ (2 * A) by positivity)

theorem paperRadialFourier_source_decay (A : ℕ) :
    ∃ (s : Finset (ℕ × ℕ)) (C : ℝ), 0 < C ∧
      ∀ (W : 𝓢(ℝ, ℂ)) (t : ℝ), 0 ≤ t →
        ‖paperRadialFourier W t‖ ≤
          (C * s.sup (schwartzSeminormFamily ℝ ℝ ℂ) W) / (1 + t) ^ A := by
  obtain ⟨s, C, hC, hbound⟩ := paperRadialFourier_source_weighted_bound A
  refine ⟨s, C, hC, ?_⟩
  intro W t ht
  apply (le_div_iff₀ (by positivity : 0 < (1 + t) ^ A)).mpr
  simpa only [mul_comm] using hbound W t ht

theorem inverse_square_le_cauchy_product (a b q : ℝ) (hq : 0 ≤ q)
    (hQ : (a ^ 2 + b ^ 2) / 2 ≤ q) :
    ((1 + q) ^ 2)⁻¹ ≤
      4 * ((1 + a ^ 2)⁻¹ * (1 + b ^ 2)⁻¹) := by
  have hsum : 1 + a ^ 2 + b ^ 2 ≤ 2 * (1 + q) := by linarith
  have hsquare : (1 + a ^ 2 + b ^ 2) ^ 2 ≤ (2 * (1 + q)) ^ 2 := by
    apply pow_le_pow_left₀ (by positivity) hsum
  have hden : (1 + a ^ 2) * (1 + b ^ 2) ≤ 4 * (1 + q) ^ 2 := by
    nlinarith [sq_nonneg (a ^ 2), sq_nonneg (b ^ 2),
      mul_nonneg (sq_nonneg a) (sq_nonneg b)]
  calc
    _ = 1 / (1 + q) ^ 2 := by simp only [one_div]
    _ ≤ 4 / ((1 + a ^ 2) * (1 + b ^ 2)) :=
      (div_le_div_iff₀ (by positivity) (by positivity)).mpr (by simpa using hden)
    _ = _ := by simp only [div_eq_mul_inv, mul_inv_rev]; ring

theorem eisenstein_cauchy_summable :
    Summable (fun h : O => ((1 + ‖ringComplex h‖ ^ 2) ^ 2)⁻¹) := by
  apply (Eisenstein.Coordinates.coordinateEquiv.symm.summable_iff).mp
  change Summable (fun p : ℤ × ℤ =>
    ((1 + ‖ringComplex (Eisenstein.Coordinates.coordinateEquiv.symm p)‖ ^ 2) ^ 2)⁻¹)
  apply Summable.of_nonneg_of_le (fun _ => inv_nonneg.mpr (sq_nonneg _)) _
    (summable_int_cauchy_product.mul_left 4)
  intro p
  apply inverse_square_le_cauchy_product (p.1 : ℝ) (p.2 : ℝ)
    (‖ringComplex (Eisenstein.Coordinates.coordinateEquiv.symm p)‖ ^ 2) (sq_nonneg _)
  change ((p.1 : ℝ) ^ 2 + (p.2 : ℝ) ^ 2) / 2 ≤
    ‖ringComplex (Eisenstein.Coordinates.eval p.1 p.2)‖ ^ 2
  rw [Eisenstein.Coordinates.complex_norm_eval_sq]
  push_cast
  nlinarith [sq_nonneg ((p.1 : ℝ) - (p.2 : ℝ))]

def eisensteinCauchyMass : ℝ :=
  ∑' h : O, ((1 + ‖ringComplex h‖ ^ 2) ^ 2)⁻¹

theorem eisensteinCauchyMass_nonneg : 0 ≤ eisensteinCauchyMass :=
  tsum_nonneg (fun _ => by positivity)

theorem eisensteinCauchyMass_subtype (S : Set O) :
    (∑' h : S, ((1 + ‖ringComplex h.val‖ ^ 2) ^ 2)⁻¹) ≤ eisensteinCauchyMass := by
  exact (eisenstein_cauchy_summable.subtype S).tsum_le_tsum_of_inj
    Subtype.val Subtype.val_injective (fun _ _ => by positivity) (fun _ => le_rfl)
    eisenstein_cauchy_summable

theorem polynomial_tail_majorant (A : ℕ) (K T q B f : ℝ)
    (hK : 0 < K) (hT : 0 ≤ T) (hq : 0 ≤ q) (hf : 0 ≤ f)
    (htail : T ≤ K * q) (hbound : (1 + K * q) ^ (A + 2) * f ≤ B) :
    f ≤ (B / ((min 1 K) ^ 2 * (1 + T) ^ A)) * ((1 + q) ^ 2)⁻¹ := by
  have hm : 0 < min 1 K := lt_min (by norm_num) hK
  have hm1 : min 1 K ≤ 1 := min_le_left _ _
  have hmK : min 1 K ≤ K := min_le_right _ _
  have hbase : min 1 K * (1 + q) ≤ 1 + K * q := by
    nlinarith [mul_le_mul_of_nonneg_right hmK hq]
  have htwo : (min 1 K) ^ 2 * (1 + q) ^ 2 ≤ (1 + K * q) ^ 2 := by
    rw [← mul_pow]
    exact pow_le_pow_left₀ (by positivity) hbase _
  have hpow : (1 + T) ^ A ≤ (1 + K * q) ^ A :=
    pow_le_pow_left₀ (by positivity) (by linarith) _
  have hden : ((min 1 K) ^ 2 * (1 + T) ^ A) * (1 + q) ^ 2 ≤
      (1 + K * q) ^ (A + 2) := by
    have hh := mul_le_mul hpow htwo (by positivity) (by positivity)
    rw [pow_add]
    nlinarith
  have hprod : f * (((min 1 K) ^ 2 * (1 + T) ^ A) * (1 + q) ^ 2) ≤ B := by
    calc
      _ = (((min 1 K) ^ 2 * (1 + T) ^ A) * (1 + q) ^ 2) * f := mul_comm _ _
      _ ≤ (1 + K * q) ^ (A + 2) * f := mul_le_mul_of_nonneg_right hden hf
      _ ≤ B := hbound
  have hraw := (le_div_iff₀ (show 0 < ((min 1 K) ^ 2 * (1 + T) ^ A) * (1 + q) ^ 2
      by positivity)).mpr hprod
  simpa only [div_eq_mul_inv, mul_inv_rev, mul_comm, mul_left_comm, mul_assoc] using hraw

theorem paperRadialFourier_lattice_summable_norm (W : 𝓢(ℝ, ℂ)) (K : ℝ) (hK : 0 < K) :
    Summable (fun h : O => ‖paperRadialFourier W (K * ‖ringComplex h‖ ^ 2)‖) := by
  obtain ⟨s, C, hC, hb⟩ := paperRadialFourier_source_weighted_bound 2
  let B := C * s.sup (schwartzSeminormFamily ℝ ℝ ℂ) W
  let D := (min 1 K) ^ 2 * (1 + (0 : ℝ)) ^ (0 : ℕ)
  apply Summable.of_nonneg_of_le (fun _ => norm_nonneg _) _
    (eisenstein_cauchy_summable.mul_left (B / D))
  intro h
  exact polynomial_tail_majorant 0 K 0 _ B _ hK (by norm_num)
    (sq_nonneg _) (norm_nonneg _) (by positivity) (hb W _ (by positivity))


theorem scaled_cauchy_antitone (b : ℝ) :
    AntitoneOn (fun x : ℝ => (1 + (b * x) ^ 2)⁻¹) (Ici 0) := by
  intro x hx y hy hxy
  change 0 ≤ x at hx
  change 0 ≤ y at hy
  apply inv_anti₀ (by positivity)
  nlinarith [sq_nonneg b, sq_nonneg (y - x),
    mul_nonneg (sq_nonneg b) (show 0 ≤ y ^ 2 - x ^ 2 by nlinarith)]

theorem scaled_cauchy_nat_bound (b : ℝ) (hb : 0 < b) :
    (∑' n : ℕ, (1 + (b * (n : ℝ)) ^ 2)⁻¹) ≤ 1 + Real.pi / (2 * b) := by
  have hi := (integrable_inv_one_add_sq.comp_mul_left' hb.ne').integrableOn (s := Ioi 0)
  have ht := (scaled_cauchy_antitone b).tsum_le_integral hi
    (fun t ht => by positivity)
  have he : (∫ x : ℝ in Ioi 0, (1 + (b * x) ^ 2)⁻¹) = Real.pi / (2 * b) := by
    rw [integral_comp_mul_left_Ioi (fun x : ℝ => (1 + x ^ 2)⁻¹) 0 hb]
    simp only [mul_zero, integral_Ioi_inv_one_add_sq, Real.arctan_zero, sub_zero,
      smul_eq_mul]
    ring
  simpa [he] using ht

theorem summable_scaled_cauchy_nat (b : ℝ) (hb : 0 < b) :
    Summable (fun n : ℕ => (1 + (b * (n : ℝ)) ^ 2)⁻¹) := by
  exact (scaled_cauchy_antitone b).summable_of_integrableOn_Ioi_zero
    (integrable_inv_one_add_sq.comp_mul_left' hb.ne').integrableOn (fun _ _ => by positivity)

theorem summable_scaled_cauchy_int (b : ℝ) (hb : 0 < b) :
    Summable (fun n : ℤ => (1 + (b * (n : ℝ)) ^ 2)⁻¹) := by
  rw [summable_int_iff_summable_nat_and_neg]
  constructor
  · simpa using summable_scaled_cauchy_nat b hb
  · simpa [mul_neg] using summable_scaled_cauchy_nat b hb

theorem scaled_cauchy_int_bound (b : ℝ) (hb : 0 < b) :
    (∑' n : ℤ, (1 + (b * (n : ℝ)) ^ 2)⁻¹) ≤ 1 + Real.pi / b := by
  have hs := summable_scaled_cauchy_nat b hb
  have hs1 := (summable_nat_add_iff 1).mpr hs
  have hneg : Summable (fun n : ℕ =>
      (1 + (b * ((-(n + 1) : ℤ) : ℝ)) ^ 2)⁻¹) := by
    simpa only [Int.cast_neg, Int.cast_add, Int.cast_natCast, Int.cast_one,
      Nat.cast_add, Nat.cast_one, mul_neg, neg_sq] using hs1
  rw [tsum_of_nat_of_neg_add_one
    (f := fun n : ℤ => (1 + (b * (n : ℝ)) ^ 2)⁻¹)
    (by simpa only [Int.cast_natCast] using hs) hneg]
  simp only [Int.cast_natCast, Int.cast_neg, Int.cast_add, Int.cast_one, mul_neg,
    neg_sq]
  have hz := hs.tsum_eq_zero_add
  have he : (∑' n : ℕ, (1 + (b * (↑n + 1)) ^ 2)⁻¹) =
      (∑' n : ℕ, (1 + (b * (n : ℝ)) ^ 2)⁻¹) - 1 := by
    apply eq_sub_iff_add_eq.mpr
    simpa [add_comm] using hz.symm
  rw [he]
  have := scaled_cauchy_nat_bound b hb
  have hh : Real.pi / (2 * b) = (Real.pi / b) / 2 := by ring
  rw [hh] at this
  linarith

open Eisenstein

theorem scaled_eisenstein_cauchy_summable (K : ℝ) (hK : 0 < K) :
    Summable (fun h : O => ((1 + K * ‖ringComplex h‖ ^ 2) ^ 2)⁻¹) := by
  let b := Real.sqrt K
  have hb : 0 < b := Real.sqrt_pos.mpr hK
  have hbsq : b ^ 2 = K := Real.sq_sqrt hK.le
  have hs := summable_scaled_cauchy_int b hb
  have hp := hs.mul_of_nonneg hs (fun _ => by positivity) (fun _ => by positivity)
  apply (Eisenstein.Coordinates.coordinateEquiv.symm.summable_iff).mp
  change Summable (fun p : ℤ × ℤ =>
    ((1 + K * ‖ringComplex (Eisenstein.Coordinates.coordinateEquiv.symm p)‖ ^ 2) ^ 2)⁻¹)
  apply Summable.of_nonneg_of_le (fun _ => by positivity) _ (hp.mul_left 4)
  intro p
  apply inverse_square_le_cauchy_product (b * (p.1 : ℝ)) (b * (p.2 : ℝ))
    (K * ‖ringComplex (Eisenstein.Coordinates.coordinateEquiv.symm p)‖ ^ 2) (by positivity)
  change ((b * (p.1 : ℝ)) ^ 2 + (b * (p.2 : ℝ)) ^ 2) / 2 ≤
    K * ‖ringComplex (Eisenstein.Coordinates.eval p.1 p.2)‖ ^ 2
  rw [Eisenstein.Coordinates.complex_norm_eval_sq]
  push_cast
  nlinarith [mul_nonneg hK.le (sq_nonneg ((p.1 : ℝ) - (p.2 : ℝ)))]

theorem scaled_eisenstein_cauchy_bound (K : ℝ) (hK : 0 < K) :
    (∑' h : O, ((1 + K * ‖ringComplex h‖ ^ 2) ^ 2)⁻¹) ≤
      4 * (1 + Real.pi / Real.sqrt K) ^ 2 := by
  let b := Real.sqrt K
  have hb : 0 < b := Real.sqrt_pos.mpr hK
  have hbsq : b ^ 2 = K := Real.sq_sqrt hK.le
  have hs := summable_scaled_cauchy_int b hb
  have hp := hs.mul_of_nonneg hs (fun _ => by positivity) (fun _ => by positivity)
  have he : (∑' h : O, ((1 + K * ‖ringComplex h‖ ^ 2) ^ 2)⁻¹) =
      ∑' p : ℤ × ℤ, ((1 + K * ‖ringComplex (Eisenstein.Coordinates.coordinateEquiv.symm p)‖ ^ 2) ^ 2)⁻¹ :=
    (Eisenstein.Coordinates.coordinateEquiv.symm.tsum_eq _).symm
  rw [he]
  calc
    _ ≤ ∑' p : ℤ × ℤ, 4 * ((1 + (b * (p.1 : ℝ)) ^ 2)⁻¹ *
          (1 + (b * (p.2 : ℝ)) ^ 2)⁻¹) := by
      apply ((Eisenstein.Coordinates.coordinateEquiv.symm.summable_iff).mpr
        (scaled_eisenstein_cauchy_summable K hK)).tsum_le_tsum _ (hp.mul_left 4)
      intro p
      apply inverse_square_le_cauchy_product _ _ _ (by positivity)
      change ((b * (p.1 : ℝ)) ^ 2 + (b * (p.2 : ℝ)) ^ 2) / 2 ≤
        K * ‖ringComplex (Eisenstein.Coordinates.eval p.1 p.2)‖ ^ 2
      rw [Eisenstein.Coordinates.complex_norm_eval_sq]
      push_cast
      nlinarith [mul_nonneg hK.le (sq_nonneg ((p.1 : ℝ) - (p.2 : ℝ)))]
    _ = 4 * (∑' n : ℤ, (1 + (b * (n : ℝ)) ^ 2)⁻¹) ^ 2 := by
      rw [tsum_mul_left, ← hs.tsum_mul_tsum hs hp, pow_two]
    _ ≤ 4 * (1 + Real.pi / b) ^ 2 := by
      gcongr
      exact scaled_cauchy_int_bound b hb

theorem scaled_eisenstein_cauchy_small (K : ℝ) (hK : 0 < K) (hK1 : K ≤ 1) :
    K * (∑' h : O, ((1 + K * ‖ringComplex h‖ ^ 2) ^ 2)⁻¹) ≤
      4 * (1 + Real.pi) ^ 2 := by
  have hs := scaled_eisenstein_cauchy_bound K hK
  have hb : 0 < Real.sqrt K := Real.sqrt_pos.mpr hK
  have hb1 : Real.sqrt K ≤ 1 := by simpa using Real.sqrt_le_sqrt hK1
  have hsq := Real.sq_sqrt hK.le
  calc
    _ ≤ K * (4 * (1 + Real.pi / Real.sqrt K) ^ 2) :=
      mul_le_mul_of_nonneg_left hs hK.le
    _ = 4 * (Real.sqrt K + Real.pi) ^ 2 := by
      nth_rw 1 [← hsq]
      field_simp
    _ ≤ _ := by gcongr

theorem one_le_eisenstein_norm_sq (h : O) (hh : h ≠ 0) :
    1 ≤ ‖ringComplex h‖ ^ 2 := by
  rw [ringComplex_norm_sq_eq_absNorm_span]
  exact_mod_cast Nat.one_le_iff_ne_zero.mpr (show Ideal.absNorm (Ideal.span {h}) ≠ 0 by
    rw [ne_eq, Ideal.absNorm_eq_zero_iff, Ideal.span_singleton_eq_bot]
    exact hh)

theorem cauchy_large_scale_pointwise (K q : ℝ) (hK : 1 ≤ K) (hq : 1 ≤ q) :
    K * ((1 + K * q) ^ 2)⁻¹ ≤ 4 * ((1 + q) ^ 2)⁻¹ := by
  have hKp : 0 < K := by linarith
  have hqp : 0 < q := by linarith
  have h1 : K * (1 + q) ≤ 2 * (1 + K * q) := by nlinarith
  have h2 := pow_le_pow_left₀ (by positivity : 0 ≤ K * (1 + q)) h1 2
  have h3 : K * (1 + q) ^ 2 ≤ K ^ 2 * (1 + q) ^ 2 := by
    nlinarith [sq_nonneg (1 + q)]
  apply (div_le_div_iff₀ (by positivity : 0 < (1 + K * q) ^ 2)
    (by positivity : 0 < (1 + q) ^ 2)).mpr
  nlinarith

theorem lattice_profile_nonzero_scaled_bound
    (F : ℝ → ℂ) (B : ℝ) (hB : 0 ≤ B)
    (hF : ∀ t : ℝ, 0 ≤ t → (1 + t) ^ 2 * ‖F t‖ ≤ B)
    (K : ℝ) (hK : 0 < K) :
    K * (∑' h : {h : O // h ≠ 0}, ‖F (K * ‖ringComplex h.val‖ ^ 2)‖) ≤
      (4 * (1 + Real.pi) ^ 2 + 4 * eisensteinCauchyMass) * B := by
  have hm (h : O) : ‖F (K * ‖ringComplex h‖ ^ 2)‖ ≤
      B * ((1 + K * ‖ringComplex h‖ ^ 2) ^ 2)⁻¹ := by
    rw [← div_eq_mul_inv]
    apply (le_div_iff₀ (by positivity)).mpr
    simpa only [mul_comm] using hF (K * ‖ringComplex h‖ ^ 2) (by positivity)
  have hs := scaled_eisenstein_cauchy_summable K hK
  have hf : Summable (fun h : O => ‖F (K * ‖ringComplex h‖ ^ 2)‖) :=
    Summable.of_nonneg_of_le (fun _ => norm_nonneg _) hm (hs.mul_left B)
  have hsub := hf.subtype (fun h : O => h ≠ 0)
  have hc := eisenstein_cauchy_summable.subtype (fun h : O => h ≠ 0)
  by_cases hK1 : K ≤ 1
  · have htotal : (∑' h : {h : O // h ≠ 0}, ‖F (K * ‖ringComplex h.val‖ ^ 2)‖) ≤
        ∑' h : O, ‖F (K * ‖ringComplex h‖ ^ 2)‖ :=
      hsub.tsum_le_tsum_of_inj Subtype.val Subtype.val_injective
        (fun _ _ => norm_nonneg _) (fun _ => le_rfl) hf
    have hbound := hf.tsum_le_tsum hm (hs.mul_left B)
    rw [tsum_mul_left] at hbound
    calc
      _ ≤ K * (B * ∑' h : O, ((1 + K * ‖ringComplex h‖ ^ 2) ^ 2)⁻¹) :=
        mul_le_mul_of_nonneg_left (htotal.trans hbound) hK.le
      _ = B * (K * ∑' h : O, ((1 + K * ‖ringComplex h‖ ^ 2) ^ 2)⁻¹) := by ring
      _ ≤ B * (4 * (1 + Real.pi) ^ 2) :=
        mul_le_mul_of_nonneg_left (scaled_eisenstein_cauchy_small K hK hK1) hB
      _ ≤ _ := by nlinarith [eisensteinCauchyMass_nonneg]
  · have hp (h : {h : O // h ≠ 0}) :
        K * ‖F (K * ‖ringComplex h.val‖ ^ 2)‖ ≤
          (4 * B) * ((1 + ‖ringComplex h.val‖ ^ 2) ^ 2)⁻¹ := by
      calc
        _ ≤ K * (B * ((1 + K * ‖ringComplex h.val‖ ^ 2) ^ 2)⁻¹) :=
          mul_le_mul_of_nonneg_left (hm h.val) hK.le
        _ = B * (K * ((1 + K * ‖ringComplex h.val‖ ^ 2) ^ 2)⁻¹) := by ring
        _ ≤ B * (4 * ((1 + ‖ringComplex h.val‖ ^ 2) ^ 2)⁻¹) :=
          mul_le_mul_of_nonneg_left (cauchy_large_scale_pointwise K _
            (le_of_not_ge hK1) (one_le_eisenstein_norm_sq h.val h.property)) hB
        _ = _ := by ring
    calc
      _ = ∑' h : {h : O // h ≠ 0}, K * ‖F (K * ‖ringComplex h.val‖ ^ 2)‖ := tsum_mul_left.symm
      _ ≤ ∑' h : {h : O // h ≠ 0}, (4 * B) * ((1 + ‖ringComplex h.val‖ ^ 2) ^ 2)⁻¹ :=
        (hsub.mul_left K).tsum_le_tsum hp (hc.mul_left (4 * B))
      _ = (4 * B) * ∑' h : {h : O // h ≠ 0}, ((1 + ‖ringComplex h.val‖ ^ 2) ^ 2)⁻¹ := tsum_mul_left
      _ ≤ (4 * B) * eisensteinCauchyMass := mul_le_mul_of_nonneg_left
        (eisensteinCauchyMass_subtype (fun h : O => h ≠ 0)) (by positivity)
      _ ≤ _ := by nlinarith [sq_nonneg (1 + Real.pi)]

theorem paperRadialFourier_nonzero_lattice_uniform :
    ∃ (s : Finset (ℕ × ℕ)) (C : ℝ), 0 < C ∧
      ∀ (W : SchwartzMap ℝ ℂ) (K : ℝ), 0 < K →
        K * (∑' h : {h : O // h ≠ 0},
          ‖paperRadialFourier W (K * ‖ringComplex h.val‖ ^ 2)‖) ≤
            C * s.sup (schwartzSeminormFamily ℝ ℝ ℂ) W := by
  obtain ⟨s, C, hC, hb⟩ := paperRadialFourier_source_weighted_bound 2
  refine ⟨s, (4 * (1 + Real.pi) ^ 2 + 4 * eisensteinCauchyMass) * C, ?_, ?_⟩
  · have := eisensteinCauchyMass_nonneg
    have := Real.pi_pos
    positivity
  · intro W K hK
    simpa only [mul_assoc] using lattice_profile_nonzero_scaled_bound
      (paperRadialFourier W) (C * s.sup (schwartzSeminormFamily ℝ ℝ ℂ) W)
        (by positivity) (hb W) K hK

end SchwartzPlanePoisson

namespace SchwartzPlanePoisson
open Eisenstein MeasureTheory
open scoped SchwartzMap

lemma primeCuspRowCharacter_norm_le_one {ι : Type*} [Fintype ι]
    (p : ι → O) [∀ i, (Ideal.span {p i}).IsMaximal]
    (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) (x : O) :
    ‖primeCuspRowCharacter p χ x‖ ≤ 1 := by
  change ‖∏ i, χ i (Ideal.Quotient.mk (Ideal.span {p i}) x)‖ ≤ 1
  rw [norm_prod]
  exact Finset.prod_le_one (fun _ _ => norm_nonneg _)
    (fun i _ => finiteMulChar_norm_le_one (χ i) _)

lemma primeCuspRowCharacter_zero {ι : Type*} [Fintype ι] [Nonempty ι]
    (p : ι → O) [∀ i, (Ideal.span {p i}).IsMaximal]
    (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) :
    primeCuspRowCharacter p χ 0 = 0 := by
  classical
  obtain ⟨i⟩ := ‹Nonempty ι›
  exact Finset.prod_eq_zero (Finset.mem_univ i) (by rw [map_zero, MulChar.map_zero])

/-- The smoothed Pólya–Vinogradov bound is uniform in scale and in every nontrivial prime row. -/
theorem prime_row_polya_vinogradov :
    ∃ (s : Finset (ℕ × ℕ)) (C : ℝ), 0 < C ∧
      ∀ {ι : Type*} [Fintype ι] [DecidableEq ι] [Nonempty ι]
        (p : ι → O) (hp : ∀ i, p i ≠ 0)
        [∀ i, (Ideal.span {p i}).IsMaximal]
        (hinj : Function.Injective (fun i => Ideal.span {p i}))
        (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) (hχ : ∀ i, χ i ≠ 1)
        (W : 𝓢(ℝ, ℂ)) (Y : ℝ), 0 < Y →
        ‖∑' z : O, primeCuspRowCharacter p χ z * W (‖ringComplex z‖ ^ 2 / Y)‖ ≤
          (C * s.sup (schwartzSeminormFamily ℝ ℝ ℂ) W) * ‖ringComplex (∏ i, p i)‖ := by
  obtain ⟨s, C, hC, hb⟩ := paperRadialFourier_nonzero_lattice_uniform
  refine ⟨s, C, hC, ?_⟩
  intro ι _ _ _ p hp _ hinj χ hχ W Y hY
  let c := ∏ i, p i
  let q := ‖ringComplex c‖
  have hc : c ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun i _ => hp i)
  have hq : 0 < q := norm_pos_iff.mpr (ringComplex_ne_zero hc)
  let t := Y / q ^ 2
  have ht : 0 < t := div_pos hY (sq_pos_of_pos hq)
  let F : O → ℂ := fun h => primeCuspRowCharacter p (fun i => (χ i)⁻¹) h *
    paperRadialFourier W (t * ‖ringComplex h‖ ^ 2)
  have hF (h : O) : ‖F h‖ ≤ ‖paperRadialFourier W (t * ‖ringComplex h‖ ^ 2)‖ := by
    dsimp only [F]
    rw [norm_mul]
    exact mul_le_of_le_one_left (norm_nonneg _) (primeCuspRowCharacter_norm_le_one p _ h)
  have hs := paperRadialFourier_lattice_summable_norm W t ht
  have hFs : Summable (fun h : O => ‖F h‖) :=
    Summable.of_nonneg_of_le (fun _ => norm_nonneg _) hF hs
  have hzero : F 0 = 0 := by simp only [F, primeCuspRowCharacter_zero, zero_mul]
  have heq : (∑' h : O, F h) = ∑' h : {h : O // h ≠ 0}, F h := by
    symm
    apply tsum_subtype_eq_of_support_subset
    intro h hh hz
    subst h
    exact hh hzero
  have hn : ‖∑' h : O, F h‖ ≤
      ∑' h : {h : O // h ≠ 0}, ‖paperRadialFourier W (t * ‖ringComplex h.val‖ ^ 2)‖ := by
    rw [heq]
    exact (norm_tsum_le_tsum_norm (hFs.subtype _)).trans
      ((hFs.subtype _).tsum_le_tsum (fun h => hF h) (hs.subtype _))
  have hbound : t * ‖∑' h : O, F h‖ ≤ C * s.sup (schwartzSeminormFamily ℝ ℝ ℂ) W :=
    (mul_le_mul_of_nonneg_left hn ht.le).trans (hb W t ht)
  obtain ⟨β, hβ, hpoisson⟩ := prime_row_radial_poisson p hp hinj χ hχ
  rw [hpoisson W Y hY]
  have hargs (h : O) : Y * ‖ringComplex h‖ ^ 2 / ‖ringComplex c‖ ^ 2 =
      t * ‖ringComplex h‖ ^ 2 := by dsimp [t, q]; ring
  change ‖((Y : ℂ) * β / (q : ℂ)) *
    ∑' h : O, primeCuspRowCharacter p (fun i => (χ i)⁻¹) h *
      paperRadialFourier W (Y * ‖ringComplex h‖ ^ 2 / ‖ringComplex c‖ ^ 2)‖ ≤ _
  simp_rw [hargs]
  change ‖((Y : ℂ) * β / (q : ℂ)) * ∑' h : O, F h‖ ≤ _
  rw [norm_mul, norm_div, norm_mul, hβ,
    Complex.norm_real, Real.norm_eq_abs, abs_of_pos hY, mul_one,
    Complex.norm_real, Real.norm_eq_abs, abs_of_pos hq]
  calc
    Y / q * ‖∑' h : O, F h‖ = q * (t * ‖∑' h : O, F h‖) := by dsimp [t]; field_simp
    _ ≤ q * (C * s.sup (schwartzSeminormFamily ℝ ℝ ℂ) W) :=
      mul_le_mul_of_nonneg_left hbound hq.le
    _ = _ := mul_comm _ _

end SchwartzPlanePoisson

namespace SchwartzPlanePoisson
open Eisenstein MeasureTheory
open scoped SchwartzMap

/-- The finite coprimality mask keeps precisely the rows avoiding the selected primes. -/
def primeCoprimeMask {ι : Type*} (p : ι → O) (s : Finset ι) (z : O) : ℂ :=
  ∏ i ∈ s, (1 - if p i ∣ z then (1 : ℂ) else 0)

lemma primeCoprimeMask_divisor_expansion {ι : Type*} (p : ι → O)
    (hcop : Pairwise (Function.onFun IsCoprime p)) (s : Finset ι) (z : O) :
    primeCoprimeMask p s z = ∑ E ∈ s.powerset,
      (-1 : ℂ) ^ E.card * (if (∏ i ∈ E, p i) ∣ z then 1 else 0) := by
  classical
  rw [primeCoprimeMask, Finset.prod_sub]
  apply Finset.sum_congr rfl
  intro E hE
  simp only [Finset.prod_const_one, mul_one]
  have hd : (∏ i ∈ E, p i) ∣ z ↔ ∀ i ∈ E, p i ∣ z := by
    constructor
    · intro h i hi
      exact (Finset.dvd_prod_of_mem p hi).trans h
    · exact Finset.prod_dvd_of_isRelPrime (fun i _ j _ hij => (hcop hij).isRelPrime)
  have he : (∏ i ∈ E, if p i ∣ z then (1 : ℂ) else 0) =
      if ∀ i ∈ E, p i ∣ z then 1 else 0 := by
    by_cases h : ∀ i ∈ E, p i ∣ z
    · simp only [if_pos h]
      calc
        _ = ∏ _i ∈ E, (1 : ℂ) := Finset.prod_congr rfl (fun i hi => if_pos (h i hi))
        _ = 1 := Finset.prod_const_one
    · rw [if_neg h]
      push_neg at h
      obtain ⟨i, hi, hn⟩ := h
      exact Finset.prod_eq_zero hi (if_neg hn)
  rw [he, hd]
  split_ifs <;> rfl

/-- Multiples of a nonzero Eisenstein integer are parametrized without multiplicity. -/
lemma tsum_divisibility_dilation (d : O) (hd : d ≠ 0) (f : O → ℂ) :
    (∑' z : O, if d ∣ z then f z else 0) = ∑' z : O, f (d * z) := by
  classical
  let e : O ≃ {z : O // d ∣ z} := Equiv.ofBijective
    (fun z => ⟨d * z, ⟨z, rfl⟩⟩)
    ⟨fun x y h => mul_left_cancel₀ hd (congrArg Subtype.val h), by
      rintro ⟨z, w, hw⟩
      exact ⟨w, Subtype.ext hw.symm⟩⟩
  calc
    _ = ∑' z : {z : O // d ∣ z}, if d ∣ z.val then f z.val else 0 := by
      symm
      apply tsum_subtype_eq_of_support_subset
        (f := fun z : O => if d ∣ z then f z else 0) (s := {z : O | d ∣ z})
      intro z hz
      by_contra hn
      exact hz (if_neg hn)
    _ = ∑' z : {z : O // d ∣ z}, f z.val := tsum_congr (fun z => if_pos z.property)
    _ = ∑' z : O, f (d * z) := (e.tsum_eq (fun z => f z.val)).symm

/-- Inclusion–exclusion converts a coprimality mask into exact radial dilations. -/
theorem prime_row_masked_dilations {ι κ : Type*} [Fintype ι]
    (p : ι → O) [∀ i, (Ideal.span {p i}).IsMaximal]
    (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ)
    (q : κ → O) (hq : ∀ i, q i ≠ 0)
    (hcop : Pairwise (Function.onFun IsCoprime q)) (S : Finset κ)
    (W : 𝓢(ℝ, ℂ)) (Y : ℝ) (hY : 0 < Y) :
    (∑' z : O, primeCoprimeMask q S z * primeCuspRowCharacter p χ z *
      W (‖ringComplex z‖ ^ 2 / Y)) =
      ∑ E ∈ S.powerset, (-1 : ℂ) ^ E.card * primeCuspRowCharacter p χ (∏ i ∈ E, q i) *
        ∑' z : O, primeCuspRowCharacter p χ z *
          W (‖ringComplex z‖ ^ 2 / (Y / ‖ringComplex (∏ i ∈ E, q i)‖ ^ 2)) := by
  classical
  let F : O → ℂ := fun z => primeCuspRowCharacter p χ z * W (‖ringComplex z‖ ^ 2 / Y)
  have hsW : Summable (fun z : O => ‖W (‖ringComplex z‖ ^ 2 / Y)‖) := by
    simpa only [scaledRadialTest_apply] using actual_eisenstein_summable_norm (scaledRadialTest W Y hY)
  have hsF : Summable (fun z => ‖F z‖) := by
    refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun z => ?_) hsW
    dsimp only [F]
    rw [norm_mul]
    exact mul_le_of_le_one_left (norm_nonneg _) (primeCuspRowCharacter_norm_le_one p χ z)
  have hsE (E : Finset κ) : Summable (fun z : O =>
      (-1 : ℂ) ^ E.card * (if (∏ i ∈ E, q i) ∣ z then F z else 0)) := by
    apply Summable.mul_left
    apply Summable.of_norm
    refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun z => ?_) hsF
    split_ifs <;> simp only [norm_zero, le_refl, norm_nonneg]
  have he (z : O) : primeCoprimeMask q S z * primeCuspRowCharacter p χ z *
      W (‖ringComplex z‖ ^ 2 / Y) = ∑ E ∈ S.powerset,
        (-1 : ℂ) ^ E.card * (if (∏ i ∈ E, q i) ∣ z then F z else 0) := by
    rw [primeCoprimeMask_divisor_expansion q hcop, Finset.sum_mul, Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro E hE
    split_ifs <;> simp only [F, mul_one, mul_zero, zero_mul, mul_assoc]
  simp_rw [he]
  rw [Summable.tsum_finsetSum (fun E _ => hsE E)]
  apply Finset.sum_congr rfl
  intro E hE
  let d := ∏ i ∈ E, q i
  have hd : d ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun i _ => hq i)
  rw [tsum_mul_left, tsum_divisibility_dilation d hd, mul_assoc]
  congr 1
  rw [← tsum_mul_left]
  apply tsum_congr
  intro z
  dsimp only [F]
  rw [map_mul, map_mul, norm_mul, mul_pow]
  have harg : ‖ringComplex d‖ ^ 2 * ‖ringComplex z‖ ^ 2 / Y =
      ‖ringComplex z‖ ^ 2 / (Y / ‖ringComplex d‖ ^ 2) := by
    field_simp
  rw [harg]
  ring

end SchwartzPlanePoisson

namespace SchwartzPlanePoisson
open Eisenstein MeasureTheory
open scoped SchwartzMap

/-- Masks preserve the same Gauss phase; selected divisors only rescale the dual radial variable. -/
theorem prime_row_masked_radial_poisson {ι : Type*} [Fintype ι] [DecidableEq ι]
    (p : ι → O) (hp : ∀ i, p i ≠ 0)
    [∀ i, (Ideal.span {p i}).IsMaximal]
    (hinj : Function.Injective (fun i => Ideal.span {p i}))
    (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) (hχ : ∀ i, χ i ≠ 1) :
    ∃ β : ℂ, ‖β‖ = 1 ∧ ∀ {κ : Type*} (q : κ → O) (hq : ∀ i, q i ≠ 0)
      (hcop : Pairwise (Function.onFun IsCoprime q)) (S : Finset κ)
      (W : 𝓢(ℝ, ℂ)) (Y : ℝ), 0 < Y →
      (∑' z : O, primeCoprimeMask q S z * primeCuspRowCharacter p χ z *
        W (‖ringComplex z‖ ^ 2 / Y)) =
        ((Y : ℂ) * β / (‖ringComplex (∏ i, p i)‖ : ℂ)) *
          ∑ E ∈ S.powerset,
            ((-1 : ℂ) ^ E.card * primeCuspRowCharacter p χ (∏ i ∈ E, q i) /
              (‖ringComplex (∏ i ∈ E, q i)‖ ^ 2 : ℝ)) *
              ∑' h : O, primeCuspRowCharacter p (fun i => (χ i)⁻¹) h *
                paperRadialFourier W
                  (Y * ‖ringComplex h‖ ^ 2 /
                    (‖ringComplex (∏ i ∈ E, q i)‖ ^ 2 * ‖ringComplex (∏ i, p i)‖ ^ 2)) := by
  classical
  obtain ⟨β, hβ, hP⟩ := prime_row_radial_poisson p hp hinj χ hχ
  refine ⟨β, hβ, ?_⟩
  intro κ q hq hcop S W Y hY
  rw [prime_row_masked_dilations p χ q hq hcop S W Y hY, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro E hE
  have hd : (∏ i ∈ E, q i) ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun i _ => hq i)
  have hn : 0 < ‖ringComplex (∏ i ∈ E, q i)‖ ^ 2 :=
    sq_pos_of_pos (norm_pos_iff.mpr (ringComplex_ne_zero hd))
  rw [hP W _ (div_pos hY hn)]
  have harg (h : O) :
      Y / ‖ringComplex (∏ i ∈ E, q i)‖ ^ 2 * ‖ringComplex h‖ ^ 2 /
          ‖ringComplex (∏ i, p i)‖ ^ 2 =
        Y * ‖ringComplex h‖ ^ 2 /
          (‖ringComplex (∏ i ∈ E, q i)‖ ^ 2 * ‖ringComplex (∏ i, p i)‖ ^ 2) := by ring
  simp_rw [harg]
  push_cast
  ring

/-- Finite coprimality exclusions cost at most the number of their divisors in Pólya–Vinogradov. -/
theorem prime_row_masked_polya_vinogradov :
    ∃ (s : Finset (ℕ × ℕ)) (C : ℝ), 0 < C ∧
      ∀ {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Nonempty ι]
        (p : ι → O) (hp : ∀ i, p i ≠ 0)
        [∀ i, (Ideal.span {p i}).IsMaximal]
        (hinj : Function.Injective (fun i => Ideal.span {p i}))
        (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) (hχ : ∀ i, χ i ≠ 1)
        (q : κ → O) (hq : ∀ i, q i ≠ 0)
        (hcop : Pairwise (Function.onFun IsCoprime q)) (S : Finset κ)
        (W : 𝓢(ℝ, ℂ)) (Y : ℝ), 0 < Y →
        ‖∑' z : O, primeCoprimeMask q S z * primeCuspRowCharacter p χ z *
          W (‖ringComplex z‖ ^ 2 / Y)‖ ≤
          (2 : ℝ) ^ S.card *
            ((C * s.sup (schwartzSeminormFamily ℝ ℝ ℂ) W) * ‖ringComplex (∏ i, p i)‖) := by
  obtain ⟨s, C, hC, hPV⟩ := prime_row_polya_vinogradov
  refine ⟨s, C, hC, ?_⟩
  intro ι κ _ _ _ p hp _ hinj χ hχ q hq hcop S W Y hY
  classical
  rw [prime_row_masked_dilations p χ q hq hcop S W Y hY]
  refine (norm_sum_le _ _).trans ?_
  calc
    _ ≤ ∑ _E ∈ S.powerset,
        (C * s.sup (schwartzSeminormFamily ℝ ℝ ℂ) W) * ‖ringComplex (∏ i, p i)‖ := by
      apply Finset.sum_le_sum
      intro E hE
      have hd : (∏ i ∈ E, q i) ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun i _ => hq i)
      have hn : 0 < ‖ringComplex (∏ i ∈ E, q i)‖ ^ 2 :=
        sq_pos_of_pos (norm_pos_iff.mpr (ringComplex_ne_zero hd))
      simp only [norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
      exact (mul_le_of_le_one_left (norm_nonneg _)
        (primeCuspRowCharacter_norm_le_one p χ _)).trans
          (hPV p hp hinj χ hχ W _ (div_pos hY hn))
    _ = _ := by
      simp only [Finset.sum_const, Finset.card_powerset, nsmul_eq_mul, Nat.cast_pow, Nat.cast_ofNat]

end SchwartzPlanePoisson


namespace SchwartzPlanePoisson
open Eisenstein

/-- A squarefree row indexed by its selected prime coordinates. -/
def primeSubsetRow {ι : Type*} (p : ι → O)
    (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) (S : Finset ι) (z : O) : ℂ :=
  ∏ i ∈ S, χ i (Ideal.Quotient.mk (Ideal.span {p i}) z)

lemma primeSubsetRow_union {ι : Type*} [DecidableEq ι] (p : ι → O)
    (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) (S T : Finset ι)
    (hST : Disjoint S T) (z : O) :
    primeSubsetRow p χ (S ∪ T) z = primeSubsetRow p χ S z * primeSubsetRow p χ T z :=
  Finset.prod_union hST

lemma primeSubsetRow_diagonal {ι : Type*} (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal]
    (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) (S : Finset ι) (z : O) :
    star (primeSubsetRow p χ S z) * primeSubsetRow p χ S z = primeCoprimeMask p S z := by
  classical
  simp only [primeSubsetRow, star_prod, ← Finset.prod_mul_distrib, primeCoprimeMask]
  apply Finset.prod_congr rfl
  intro i hi
  rw [MulChar.star_apply', ← MulChar.mul_apply, inv_mul_cancel]
  by_cases h : p i ∣ z
  · rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton.mpr h),
      MulChar.map_zero, if_pos h]
    ring
  · have hn : Ideal.Quotient.mk (Ideal.span {p i}) z ≠ 0 := by
      intro he
      exact h (Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp he))
    rw [MulChar.one_apply (isUnit_iff_ne_zero.mpr hn), if_neg h]
    ring

lemma primeSubsetRow_pair_kernel {ι : Type*} [DecidableEq ι] (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal]
    (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) (S T : Finset ι) (z : O) :
    star (primeSubsetRow p χ S z) * primeSubsetRow p χ T z =
      primeCoprimeMask p (S ∩ T) z *
        (star (primeSubsetRow p χ (S \ T) z) * primeSubsetRow p χ (T \ S) z) := by
  have hS : S = (S \ T) ∪ (S ∩ T) := by
    ext i
    simp only [Finset.mem_union, Finset.mem_sdiff, Finset.mem_inter]
    tauto
  have hT : T = (T \ S) ∪ (S ∩ T) := by
    ext i
    simp only [Finset.mem_union, Finset.mem_sdiff, Finset.mem_inter]
    tauto
  have hdS : Disjoint (S \ T) (S ∩ T) := by
    apply Finset.disjoint_left.mpr
    intro i hi hj
    exact (Finset.mem_sdiff.mp hi).2 (Finset.mem_inter.mp hj).2
  have hdT : Disjoint (T \ S) (S ∩ T) := by
    apply Finset.disjoint_left.mpr
    intro i hi hj
    exact (Finset.mem_sdiff.mp hi).2 (Finset.mem_inter.mp hj).1
  have hs := congrArg (fun A => primeSubsetRow p χ A z) hS
  have ht := congrArg (fun A => primeSubsetRow p χ A z) hT
  rw [primeSubsetRow_union p χ _ _ hdS] at hs
  rw [primeSubsetRow_union p χ _ _ hdT] at ht
  rw [hs, ht, star_mul, ← primeSubsetRow_diagonal p χ (S ∩ T) z]
  ring

def activePrimeRowCharacter {ι : Type*} [DecidableEq ι] (p : ι → O)
    (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) (S T : Finset ι)
    (i : ↥((S \ T) ∪ (T \ S))) : MulChar (O ⧸ Ideal.span {p i.val}) ℂ :=
  if i.val ∈ S then (χ i.val)⁻¹ else χ i.val

lemma activePrimeRowCharacter_ne_one {ι : Type*} [DecidableEq ι] (p : ι → O)
    (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) (hχ : ∀ i, χ i ≠ 1)
    (S T : Finset ι) (i : ↥((S \ T) ∪ (T \ S))) :
    activePrimeRowCharacter p χ S T i ≠ 1 := by
  dsimp only [activePrimeRowCharacter]
  split_ifs
  · intro h
    apply hχ i.val
    simpa only [inv_inv, inv_one] using congrArg Inv.inv h
  · exact hχ i.val

/-- Common primes become density masks; differing primes form one primitive character row. -/
lemma primeSubsetRow_pair_active {ι : Type*} [DecidableEq ι] (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal]
    (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) (S T : Finset ι) (z : O) :
    star (primeSubsetRow p χ S z) * primeSubsetRow p χ T z =
      primeCoprimeMask p (S ∩ T) z *
        primeCuspRowCharacter (fun i : ↥((S \ T) ∪ (T \ S)) => p i.val)
          (activePrimeRowCharacter p χ S T) z := by
  classical
  rw [primeSubsetRow_pair_kernel]
  congr 1
  have hd : Disjoint (S \ T) (T \ S) := by
    apply Finset.disjoint_left.mpr
    intro i hi hj
    exact (Finset.mem_sdiff.mp hi).2 (Finset.mem_sdiff.mp hj).1
  change _ = ∏ i : ↥((S \ T) ∪ (T \ S)),
    (if i.val ∈ S then (χ i.val)⁻¹ else χ i.val)
      (Ideal.Quotient.mk (Ideal.span {p i.val}) z)
  have he (i : ↥((S \ T) ∪ (T \ S))) :
      (if i.val ∈ S then (χ i.val)⁻¹ else χ i.val)
        (Ideal.Quotient.mk (Ideal.span {p i.val}) z) =
      if i.val ∈ S then star (χ i.val (Ideal.Quotient.mk (Ideal.span {p i.val}) z))
        else χ i.val (Ideal.Quotient.mk (Ideal.span {p i.val}) z) := by
    split_ifs <;> simp only [MulChar.star_apply']
  rw [Finset.prod_congr rfl (fun i _ => he i)]
  have hc := Finset.prod_coe_sort (s := (S \ T) ∪ (T \ S))
    (f := fun i : ι => if i ∈ S then star (χ i (Ideal.Quotient.mk (Ideal.span {p i}) z))
      else χ i (Ideal.Quotient.mk (Ideal.span {p i}) z))
  rw [hc, Finset.prod_union hd]
  simp only [primeSubsetRow, star_prod]
  congr 1
  · apply Finset.prod_congr rfl
    intro i hi
    rw [if_pos (Finset.mem_sdiff.mp hi).1]
  · apply Finset.prod_congr rfl
    intro i hi
    rw [if_neg (Finset.mem_sdiff.mp hi).2]

end SchwartzPlanePoisson

namespace SchwartzPlanePoisson
open Eisenstein

/-- Norm of the squarefree conductor selected by a finite support. -/
def primeSubsetNorm {ι : Type*} (p : ι → O) (S : Finset ι) : ℝ :=
  ‖ringComplex (∏ i ∈ S, p i)‖ ^ 2

lemma primeSubsetNorm_nonneg {ι : Type*} (p : ι → O) (S : Finset ι) :
    0 ≤ primeSubsetNorm p S := sq_nonneg _

lemma primeSubsetNorm_prod {ι : Type*} (p : ι → O) (S : Finset ι) :
    primeSubsetNorm p S = ∏ i ∈ S, ‖ringComplex (p i)‖ ^ 2 := by
  rw [primeSubsetNorm, map_prod, norm_prod, Finset.prod_pow]

lemma primeSubsetNorm_union {ι : Type*} [DecidableEq ι] (p : ι → O)
    (S T : Finset ι) (hST : Disjoint S T) :
    primeSubsetNorm p (S ∪ T) = primeSubsetNorm p S * primeSubsetNorm p T := by
  simp only [primeSubsetNorm_prod, Finset.prod_union hST]

lemma primeSubsetNorm_pair {ι : Type*} [DecidableEq ι] (p : ι → O) (S T : Finset ι) :
    primeSubsetNorm p ((S \ T) ∪ (T \ S)) * primeSubsetNorm p (S ∩ T) ^ 2 =
      primeSubsetNorm p S * primeSubsetNorm p T := by
  have hS : S = (S \ T) ∪ (S ∩ T) := by
    ext i
    simp only [Finset.mem_union, Finset.mem_sdiff, Finset.mem_inter]
    tauto
  have hT : T = (T \ S) ∪ (S ∩ T) := by
    ext i
    simp only [Finset.mem_union, Finset.mem_sdiff, Finset.mem_inter]
    tauto
  have hdS : Disjoint (S \ T) (S ∩ T) := by
    apply Finset.disjoint_left.mpr
    intro i hi hj
    exact (Finset.mem_sdiff.mp hi).2 (Finset.mem_inter.mp hj).2
  have hdT : Disjoint (T \ S) (S ∩ T) := by
    apply Finset.disjoint_left.mpr
    intro i hi hj
    exact (Finset.mem_sdiff.mp hi).2 (Finset.mem_inter.mp hj).1
  have hd : Disjoint (S \ T) (T \ S) := by
    apply Finset.disjoint_left.mpr
    intro i hi hj
    exact (Finset.mem_sdiff.mp hi).2 (Finset.mem_sdiff.mp hj).1
  have hs := congrArg (primeSubsetNorm p) hS
  have ht := congrArg (primeSubsetNorm p) hT
  rw [primeSubsetNorm_union p _ _ hdS] at hs
  rw [primeSubsetNorm_union p _ _ hdT] at ht
  rw [primeSubsetNorm_union p _ _ hd, hs, ht]
  ring

lemma two_pow_card_le_primeSubsetNorm {ι : Type*} (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal] (S : Finset ι) :
    (2 : ℝ) ^ S.card ≤ primeSubsetNorm p S := by
  have hn (i : ι) : (2 : ℝ) ≤ ‖ringComplex (p i)‖ ^ 2 := by
    rw [ringComplex_norm_sq_eq_absNorm_span]
    have h0 : Ideal.absNorm (Ideal.span {p i}) ≠ 0 := by
      rw [ne_eq, Ideal.absNorm_eq_zero_iff]
      exact NeZero.ne _
    have h1 : Ideal.absNorm (Ideal.span {p i}) ≠ 1 := by
      rw [ne_eq, Ideal.absNorm_eq_one_iff]
      exact (inferInstance : (Ideal.span {p i}).IsMaximal).ne_top
    exact_mod_cast (show 2 ≤ Ideal.absNorm (Ideal.span {p i}) by omega)
  rw [primeSubsetNorm_prod]
  calc
    _ = ∏ _i ∈ S, (2 : ℝ) := by simp
    _ ≤ _ := Finset.prod_le_prod (fun _ _ => by norm_num) (fun i _ => hn i)

/-- Common-prime divisor cost is absorbed by the two original conductor norms. -/
lemma prime_gram_divisor_conductor_bound {ι : Type*} [DecidableEq ι] (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal] (S T : Finset ι)
    (N : ℝ) (hN : 0 ≤ N) (hS : primeSubsetNorm p S ≤ N) (hT : primeSubsetNorm p T ≤ N) :
    (2 : ℝ) ^ (S ∩ T).card *
      ‖ringComplex (∏ i : ↥((S \ T) ∪ (T \ S)), p i.val)‖ ≤ N := by
  rw [Finset.prod_coe_sort]
  have hpair := primeSubsetNorm_pair p S T
  have hnorm : 0 ≤ ‖ringComplex (∏ i ∈ (S \ T) ∪ (T \ S), p i)‖ := norm_nonneg _
  have hcommon := primeSubsetNorm_nonneg p (S ∩ T)
  apply (mul_le_mul_of_nonneg_right (two_pow_card_le_primeSubsetNorm p (S ∩ T)) hnorm).trans
  apply (sq_le_sq₀ (mul_nonneg hcommon hnorm) hN).mp
  calc
    _ = primeSubsetNorm p S * primeSubsetNorm p T := by
      rw [mul_pow]
      change primeSubsetNorm p (S ∩ T) ^ 2 * primeSubsetNorm p ((S \ T) ∪ (T \ S)) = _
      rw [mul_comm, hpair]
    _ ≤ N * N := mul_le_mul hS hT (primeSubsetNorm_nonneg p T) hN
    _ = N ^ 2 := by ring

end SchwartzPlanePoisson

namespace SchwartzPlanePoisson
open Eisenstein
open scoped SchwartzMap

/-- Distinct squarefree rows have scale-uniform off-diagonal Gram bounds. -/
theorem primeSubsetRow_gram_offdiagonal :
    ∃ (s : Finset (ℕ × ℕ)) (C : ℝ), 0 < C ∧
      ∀ {ι : Type*} [DecidableEq ι] (p : ι → O) (hp : ∀ i, p i ≠ 0)
        [∀ i, (Ideal.span {p i}).IsMaximal]
        (hinj : Function.Injective (fun i => Ideal.span {p i}))
        (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) (hχ : ∀ i, χ i ≠ 1)
        (S T : Finset ι), S ≠ T → ∀ (W : 𝓢(ℝ, ℂ)) (Y : ℝ), 0 < Y →
        ‖∑' z : O, (star (primeSubsetRow p χ S z) * primeSubsetRow p χ T z) *
          W (‖ringComplex z‖ ^ 2 / Y)‖ ≤
          (2 : ℝ) ^ (S ∩ T).card *
            ((C * s.sup (schwartzSeminormFamily ℝ ℝ ℂ) W) *
              ‖ringComplex (∏ i : ↥((S \ T) ∪ (T \ S)), p i.val)‖) := by
  obtain ⟨s, C, hC, hPV⟩ := prime_row_masked_polya_vinogradov
  refine ⟨s, C, hC, ?_⟩
  intro ι _ p hp _ hinj χ hχ S T hST W Y hY
  classical
  have hnonempty : ((S \ T) ∪ (T \ S)).Nonempty := by
    have hn : ¬ ∀ i, i ∈ S ↔ i ∈ T := fun h => hST (Finset.ext h)
    obtain ⟨i, hi⟩ := not_forall.mp hn
    refine ⟨i, ?_⟩
    simp only [Finset.mem_union, Finset.mem_sdiff]
    tauto
  letI : Nonempty ↥((S \ T) ∪ (T \ S)) := hnonempty.to_subtype
  have hcop : Pairwise (Function.onFun IsCoprime p) := by
    intro i j hij
    exact (Ideal.isCoprime_span_singleton_iff _ _).mp
      (Ideal.isCoprime_of_isMaximal (hinj.ne hij))
  simp_rw [primeSubsetRow_pair_active]
  exact hPV (fun i : ↥((S \ T) ∪ (T \ S)) => p i.val) (fun i => hp i.val)
    (hinj.comp Subtype.val_injective) (activePrimeRowCharacter p χ S T)
    (activePrimeRowCharacter_ne_one p χ hχ S T) p hp hcop (S ∩ T) W Y hY

end SchwartzPlanePoisson

namespace SchwartzPlanePoisson
open Eisenstein MeasureTheory
open scoped SchwartzMap

def diagonalControl (W : 𝓢(ℝ, ℂ)) : ℝ :=
  16 * (1 + Real.pi) ^ 2 *
    (Finset.Iic (2, 0)).sup (schwartzSeminormFamily ℝ ℝ ℂ) W

theorem diagonalControl_nonneg (W : 𝓢(ℝ, ℂ)) : 0 ≤ diagonalControl W := by
  unfold diagonalControl
  positivity

theorem radial_weight_lattice_bound (W : 𝓢(ℝ, ℂ)) (M : ℝ) (hM : 1 ≤ M) :
    (∑' z : O, ‖W (‖ringComplex z‖ ^ 2 / M)‖) ≤ diagonalControl W * M := by
  have hMp : 0 < M := by linarith
  let t := M⁻¹
  have ht : 0 < t := inv_pos.mpr hMp
  have ht1 : t ≤ 1 := (inv_le_one₀ hMp).mpr hM
  let B := 4 * (Finset.Iic (2, 0)).sup (schwartzSeminormFamily ℝ ℝ ℂ) W
  have hB : 0 ≤ B := by dsimp [B]; positivity
  have hp (z : O) : ‖W (‖ringComplex z‖ ^ 2 / M)‖ ≤
      B * ((1 + t * ‖ringComplex z‖ ^ 2) ^ 2)⁻¹ := by
    have hq : 0 ≤ ‖ringComplex z‖ ^ 2 / M := div_nonneg (sq_nonneg _) hMp.le
    have hh := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ)
      (m := (2, 0)) (k := 2) (n := 0) le_rfl le_rfl W (‖ringComplex z‖ ^ 2 / M)
    simp only [norm_iteratedFDeriv_zero, Real.norm_of_nonneg hq] at hh
    have hsf : (fun m : ℕ × ℕ => SchwartzMap.seminorm ℝ m.1 m.2) =
        schwartzSeminormFamily ℝ ℝ ℂ := by
      funext m
      rcases m with ⟨k, n⟩
      rfl
    rw [hsf] at hh
    norm_num only [show (2 : ℝ) ^ 2 = 4 by norm_num] at hh
    change (1 + ‖ringComplex z‖ ^ 2 / M) ^ 2 * ‖W (‖ringComplex z‖ ^ 2 / M)‖ ≤ B at hh
    rw [← div_eq_mul_inv]
    apply (le_div_iff₀ (by positivity)).mpr
    simpa only [t, div_eq_mul_inv, mul_comm, mul_left_comm, mul_assoc] using hh
  have hs : Summable (fun z : O => ‖W (‖ringComplex z‖ ^ 2 / M)‖) := by
    simpa only [scaledRadialTest_apply] using
      actual_eisenstein_summable_norm (scaledRadialTest W M hMp)
  have hb := hs.tsum_le_tsum hp ((scaled_eisenstein_cauchy_summable t ht).mul_left B)
  rw [tsum_mul_left] at hb
  have hsmall := scaled_eisenstein_cauchy_small t ht ht1
  have hmul := mul_le_mul_of_nonneg_left hb ht.le
  have hcontrol := mul_le_mul_of_nonneg_left hsmall hB
  have hfinal : t * (∑' z : O, ‖W (‖ringComplex z‖ ^ 2 / M)‖) ≤ diagonalControl W := by
    unfold diagonalControl
    dsimp [B] at hcontrol hmul
    nlinarith
  have hh := mul_le_mul_of_nonneg_left hfinal hMp.le
  simpa only [t, ← mul_assoc, mul_inv_cancel₀ hMp.ne', one_mul, mul_comm] using hh

lemma primeSubsetRow_norm_le_one {ι : Type*} (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal]
    (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) (S : Finset ι) (z : O) :
    ‖primeSubsetRow p χ S z‖ ≤ 1 := by
  rw [primeSubsetRow, norm_prod]
  exact Finset.prod_le_one (fun _ _ => norm_nonneg _)
    (fun i _ => finiteMulChar_norm_le_one (χ i) _)

lemma primeSubsetRow_pair_summable {ι : Type*} (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal]
    (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) (S T : Finset ι)
    (W : 𝓢(ℝ, ℂ)) (M : ℝ) (hM : 0 < M) :
    Summable (fun z : O => (star (primeSubsetRow p χ S z) * primeSubsetRow p χ T z) *
      W (‖ringComplex z‖ ^ 2 / M)) := by
  have hW : Summable (fun z : O => ‖W (‖ringComplex z‖ ^ 2 / M)‖) := by
    simpa only [scaledRadialTest_apply] using
      actual_eisenstein_summable_norm (scaledRadialTest W M hM)
  apply Summable.of_norm
  apply Summable.of_nonneg_of_le (fun _ => norm_nonneg _) _ hW
  intro z
  rw [norm_mul, norm_mul, norm_star]
  exact mul_le_of_le_one_left (norm_nonneg _)
    ((mul_le_mul (primeSubsetRow_norm_le_one p χ S z) (primeSubsetRow_norm_le_one p χ T z)
      (norm_nonneg _) zero_le_one).trans_eq (one_mul 1))

lemma primeSubsetRow_gram_diagonal {ι : Type*} (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal]
    (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) (S : Finset ι)
    (W : 𝓢(ℝ, ℂ)) (M : ℝ) (hM : 1 ≤ M) :
    ‖∑' z : O, (star (primeSubsetRow p χ S z) * primeSubsetRow p χ S z) *
      W (‖ringComplex z‖ ^ 2 / M)‖ ≤ diagonalControl W * M := by
  have hMp : 0 < M := lt_of_lt_of_le zero_lt_one hM
  have hs := (primeSubsetRow_pair_summable p χ S S W M hMp).norm
  have hW : Summable (fun z : O => ‖W (‖ringComplex z‖ ^ 2 / M)‖) := by
    simpa only [scaledRadialTest_apply] using
      actual_eisenstein_summable_norm (scaledRadialTest W M hMp)
  refine (norm_tsum_le_tsum_norm hs).trans ((hs.tsum_le_tsum ?_ hW).trans
    (radial_weight_lattice_bound W M hM))
  intro z
  rw [norm_mul, norm_mul, norm_star]
  exact mul_le_of_le_one_left (norm_nonneg _)
    ((mul_le_mul (primeSubsetRow_norm_le_one p χ S z) (primeSubsetRow_norm_le_one p χ S z)
      (norm_nonneg _) zero_le_one).trans_eq (one_mul 1))

end SchwartzPlanePoisson

namespace SchwartzPlanePoisson
open Eisenstein MeasureTheory
open scoped SchwartzMap

private theorem norm_sq_finite_sum {β : Type*} (C : Finset β) (a r : β → ℂ) :
    (↑(‖∑ n ∈ C, a n * r n‖ ^ 2) : ℂ) =
      ∑ n ∈ C, ∑ m ∈ C, (star (a n) * a m) * (star (r n) * r m) := by
  rw [Complex.sq_norm, Complex.normSq_eq_conj_mul_self]
  simp only [map_sum, map_mul, starRingEnd_apply]
  rw [Finset.sum_mul_sum]
  apply Finset.sum_congr rfl
  intro n hn
  apply Finset.sum_congr rfl
  intro m hm
  ring

theorem primeSubsetRow_mean_summable {α β : Type*}
    (p : α → O) [∀ i, (Ideal.span {p i}).IsMaximal]
    (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) (C : Finset β) (support : β → Finset α) (a : β → ℂ)
    (W : 𝓢(ℝ, ℂ)) (M : ℝ) (hM : 0 < M) :
    Summable (fun z : O => W (‖ringComplex z‖ ^ 2 / M) *
      (↑(‖∑ n ∈ C, a n * primeSubsetRow p χ (support n) z‖ ^ 2) : ℂ)) := by
  have hs := summable_sum (s := C) (fun n hn => summable_sum (s := C) (fun m hm =>
    (primeSubsetRow_pair_summable p χ (support n) (support m) W M hM).mul_left (star (a n) * a m)))
  apply hs.congr
  intro z
  rw [norm_sq_finite_sum]
  simp only [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro n hn
  apply Finset.sum_congr rfl
  intro m hm
  ring

theorem primeSubsetRow_mean_expand {α β : Type*}
    (p : α → O) [∀ i, (Ideal.span {p i}).IsMaximal]
    (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) (C : Finset β) (support : β → Finset α) (a : β → ℂ)
    (W : 𝓢(ℝ, ℂ)) (M : ℝ) (hM : 0 < M) :
    (∑' z : O, W (‖ringComplex z‖ ^ 2 / M) *
      (↑(‖∑ n ∈ C, a n * primeSubsetRow p χ (support n) z‖ ^ 2) : ℂ)) =
      ∑ n ∈ C, ∑ m ∈ C, (star (a n) * a m) *
        ∑' z : O, (star (primeSubsetRow p χ (support n) z) * primeSubsetRow p χ (support m) z) *
          W (‖ringComplex z‖ ^ 2 / M) := by
  let f : β → β → O → ℂ := fun n m z => (star (a n) * a m) *
    ((star (primeSubsetRow p χ (support n) z) * primeSubsetRow p χ (support m) z) *
      W (‖ringComplex z‖ ^ 2 / M))
  have hf (n m : β) : Summable (f n m) :=
    (primeSubsetRow_pair_summable p χ (support n) (support m) W M hM).mul_left _
  have heq (z : O) : W (‖ringComplex z‖ ^ 2 / M) *
      (↑(‖∑ n ∈ C, a n * primeSubsetRow p χ (support n) z‖ ^ 2) : ℂ) =
        ∑ n ∈ C, ∑ m ∈ C, f n m z := by
    rw [norm_sq_finite_sum]
    simp only [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro n hn
    apply Finset.sum_congr rfl
    intro m hm
    dsimp [f]
    ring
  rw [tsum_congr heq, Summable.tsum_finsetSum (fun n hn => summable_sum (fun m hm => hf n m))]
  apply Finset.sum_congr rfl
  intro n hn
  rw [Summable.tsum_finsetSum (fun m hm => hf n m)]
  apply Finset.sum_congr rfl
  intro m hm
  exact tsum_mul_left

/-- Initial mean-square cancellation for actual prime characters, with uniform conductor control. -/
theorem primeSubsetRow_initial_mean_bound :
    ∃ (s : Finset (ℕ × ℕ)) (K₀ : ℝ), 0 < K₀ ∧
      ∀ {α β : Type*} [DecidableEq α] [DecidableEq β]
        (p : α → O) (hp : ∀ i, p i ≠ 0)
        [∀ i, (Ideal.span {p i}).IsMaximal]
        (hinj : Function.Injective (fun i => Ideal.span {p i}))
        (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) (hχ : ∀ i, χ i ≠ 1)
        (C : Finset β) (support : β → Finset α)
        (hsupp : Set.InjOn support (↑C : Set β))
        (N : ℝ), 0 ≤ N → (∀ n ∈ C, primeSubsetNorm p (support n) ≤ N) →
        ∀ (a : β → ℂ) (W : 𝓢(ℝ, ℂ)) (M : ℝ), 1 ≤ M →
        ‖∑' z : O, W (‖ringComplex z‖ ^ 2 / M) *
          (↑(‖∑ n ∈ C, a n * primeSubsetRow p χ (support n) z‖ ^ 2) : ℂ)‖ ≤
          (diagonalControl W * M +
            (K₀ * s.sup (schwartzSeminormFamily ℝ ℝ ℂ) W) * N * C.card) *
              ∑ n ∈ C, ‖a n‖ ^ 2 := by
  obtain ⟨s, K₀, hK₀, hOff⟩ := primeSubsetRow_gram_offdiagonal
  refine ⟨s, K₀, hK₀, ?_⟩
  intro α β _ _ p hp _ hinj χ hχ C support hsupp N hN hNorm a W M hM
  classical
  have hcoef : 0 ≤ K₀ * s.sup (schwartzSeminormFamily ℝ ℝ ℂ) W := by positivity
  have hMp : 0 < M := by linarith
  let D := diagonalControl W * M
  let B := (K₀ * s.sup (schwartzSeminormFamily ℝ ℝ ℂ) W) * N
  have hB : 0 ≤ B := mul_nonneg hcoef hN
  let K : β → β → ℂ := fun n m => ∑' z : O,
    (star (primeSubsetRow p χ (support n) z) * primeSubsetRow p χ (support m) z) *
      W (‖ringComplex z‖ ^ 2 / M)
  have hK (n : β) (hn : n ∈ C) (m : β) (hm : m ∈ C) :
      ‖K n m‖ ≤ (if n = m then D else 0) + B := by
    by_cases hnm : n = m
    · subst m
      simp only [ite_true]
      exact (primeSubsetRow_gram_diagonal p χ (support n) W M hM).trans (le_add_of_nonneg_right hB)
    · simp only [hnm, ite_false, zero_add]
      have hb := hOff p hp hinj χ hχ (support n) (support m)
        (fun h => hnm (hsupp hn hm h)) W M hMp
      have hc := prime_gram_divisor_conductor_bound p (support n) (support m)
        N hN (hNorm n hn) (hNorm m hm)
      apply hb.trans
      calc
        _ = (K₀ * s.sup (schwartzSeminormFamily ℝ ℝ ℂ) W) *
            ((2 : ℝ) ^ (support n ∩ support m).card *
              ‖ringComplex (∏ i : ↥((support n \ support m) ∪ (support m \ support n)), p i.val)‖) := by ring
        _ ≤ B := mul_le_mul_of_nonneg_left hc hcoef
  have heq (n : β) (hn : n ∈ C) :
      (∑ m ∈ C, ‖a n‖ * ‖a m‖ * ((if n = m then D else 0) + B)) =
        D * ‖a n‖ ^ 2 + B * ‖a n‖ * ∑ m ∈ C, ‖a m‖ := by
    simp only [mul_add, Finset.sum_add_distrib, mul_ite, mul_zero]
    simp only [Finset.sum_ite_eq,  hn, ite_true]
    rw [← Finset.sum_mul, ← Finset.mul_sum]
    ring
  have hcalc : (∑ n ∈ C, ∑ m ∈ C,
      ‖a n‖ * ‖a m‖ * ((if n = m then D else 0) + B)) =
      D * (∑ n ∈ C, ‖a n‖ ^ 2) + B * (∑ n ∈ C, ‖a n‖) ^ 2 := by
    rw [Finset.sum_congr rfl heq]
    simp only [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.sum_mul]
    ring
  rw [primeSubsetRow_mean_expand p χ C support a W M hMp]
  calc
    _ ≤ ∑ n ∈ C, ∑ m ∈ C, ‖(star (a n) * a m) * K n m‖ := by
      exact (norm_sum_le _ _).trans (Finset.sum_le_sum (fun _ _ => norm_sum_le _ _))
    _ ≤ ∑ n ∈ C, ∑ m ∈ C, ‖a n‖ * ‖a m‖ * ((if n = m then D else 0) + B) := by
      apply Finset.sum_le_sum
      intro n hn
      apply Finset.sum_le_sum
      intro m hm
      simp only [norm_mul, norm_star]
      exact mul_le_mul_of_nonneg_left (hK n hn m hm) (mul_nonneg (norm_nonneg _) (norm_nonneg _))
    _ = D * (∑ n ∈ C, ‖a n‖ ^ 2) + B * (∑ n ∈ C, ‖a n‖) ^ 2 := hcalc
    _ ≤ D * (∑ n ∈ C, ‖a n‖ ^ 2) + B * ((C.card : ℝ) * ∑ n ∈ C, ‖a n‖ ^ 2) := by
      apply add_le_add le_rfl
      apply mul_le_mul_of_nonneg_left _ hB
      simpa only [mul_one, one_pow, Finset.sum_const, nsmul_eq_mul, mul_one, mul_comm] using
        Finset.sum_mul_sq_le_sq_mul_sq C (fun n => ‖a n‖) (fun _ => (1 : ℝ))
    _ = _ := by dsimp [D, B]; ring

end SchwartzPlanePoisson

namespace SchwartzPlanePoisson
open Eisenstein MeasureTheory
open scoped SchwartzMap ContDiff

def sieveBump : ContDiffBump (0 : ℝ) where
  rIn := 1
  rOut := 2
  rIn_pos := by norm_num
  rIn_lt_rOut := by norm_num

def sieveCutoff : 𝓢(ℝ, ℂ) := by
  have hc : HasCompactSupport (fun t : ℝ => (sieveBump t : ℂ)) :=
    sieveBump.hasCompactSupport.comp_left Complex.ofReal_zero
  have hs : ContDiff ℝ ∞ (fun t : ℝ => (sieveBump t : ℂ)) :=
    Complex.ofRealCLM.contDiff.comp sieveBump.contDiff
  exact hc.toSchwartzMap hs

@[simp] theorem sieveCutoff_apply (t : ℝ) : sieveCutoff t = (sieveBump t : ℂ) := rfl

theorem sieveBump_eq_one {t : ℝ} (ht0 : 0 ≤ t) (ht1 : t ≤ 1) : sieveBump t = 1 := by
  apply sieveBump.one_of_mem_closedBall
  change dist t 0 ≤ 1
  simpa only [dist_zero_right, Real.norm_eq_abs, abs_of_nonneg ht0] using ht1

/-- Finite-ball mean-square bound for distinct squarefree prime-character rows. -/
theorem primeSubsetRow_initial_finite_bound :
    ∃ K : ℝ, 0 < K ∧
      ∀ {α β : Type*} [DecidableEq α] [DecidableEq β]
        (p : α → O) (hp : ∀ i, p i ≠ 0)
        [∀ i, (Ideal.span {p i}).IsMaximal]
        (hinj : Function.Injective (fun i => Ideal.span {p i}))
        (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) (hχ : ∀ i, χ i ≠ 1)
        (C : Finset β) (support : β → Finset α)
        (hsupp : Set.InjOn support (↑C : Set β))
        (N : ℝ), 0 ≤ N → (∀ n ∈ C, primeSubsetNorm p (support n) ≤ N) →
        ∀ (a : β → ℂ) (M : ℝ), 1 ≤ M → ∀ R : Finset O,
        (∀ z ∈ R, ‖ringComplex z‖ ^ 2 ≤ M) →
        (∑ z ∈ R, ‖∑ n ∈ C, a n * primeSubsetRow p χ (support n) z‖ ^ 2) ≤
          K * (M + N * C.card) * ∑ n ∈ C, ‖a n‖ ^ 2 := by
  obtain ⟨s, K₀, hK₀, hb⟩ := primeSubsetRow_initial_mean_bound
  let A := diagonalControl sieveCutoff
  let B := K₀ * s.sup (schwartzSeminormFamily ℝ ℝ ℂ) sieveCutoff
  have hA : 0 ≤ A := diagonalControl_nonneg sieveCutoff
  have hB : 0 ≤ B := by dsimp [B]; positivity
  refine ⟨A + B + 1, by positivity, ?_⟩
  intro α β _ _ p hp _ hinj χ hχ C support hsupp N hN hNorm a M hM R hR
  have hMp : 0 < M := by linarith
  let E : O → ℝ := fun z => ‖∑ n ∈ C, a n * primeSubsetRow p χ (support n) z‖ ^ 2
  let F : O → ℝ := fun z => sieveBump (‖ringComplex z‖ ^ 2 / M) * E z
  let H : O → ℂ := fun z => sieveCutoff (‖ringComplex z‖ ^ 2 / M) * (E z : ℂ)
  have hF (z : O) : 0 ≤ F z := mul_nonneg sieveBump.nonneg (sq_nonneg _)
  have hH (z : O) : H z = (F z : ℂ) := by
    simp only [H, F, sieveCutoff_apply, Complex.ofReal_mul]
  have hHs : Summable H := primeSubsetRow_mean_summable p χ C support a sieveCutoff M hMp
  have hFs : Summable F := hHs.norm.congr (fun z => by
    rw [hH, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hF z)])
  have hsum : ‖∑' z : O, H z‖ = ∑' z : O, F z := by
    rw [tsum_congr hH, ← Complex.ofReal_tsum, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (tsum_nonneg hF)]
  calc
    _ = ∑ z ∈ R, F z := by
      apply Finset.sum_congr rfl
      intro z hz
      have ht0 : 0 ≤ ‖ringComplex z‖ ^ 2 / M := div_nonneg (sq_nonneg _) hMp.le
      have ht1 : ‖ringComplex z‖ ^ 2 / M ≤ 1 := (div_le_one hMp).mpr (hR z hz)
      simp only [F, sieveBump_eq_one ht0 ht1, one_mul, E]
    _ ≤ ∑' z : O, F z := hFs.sum_le_tsum R (fun z _ => hF z)
    _ = ‖∑' z : O, H z‖ := hsum.symm
    _ ≤ (A * M + B * N * C.card) * ∑ n ∈ C, ‖a n‖ ^ 2 :=
      hb p hp hinj χ hχ C support hsupp N hN hNorm a sieveCutoff M hM
    _ ≤ _ := by
      apply mul_le_mul_of_nonneg_right _ (Finset.sum_nonneg fun _ _ => sq_nonneg _)
      have hM0 : 0 ≤ M := le_trans zero_le_one hM
      have hNC : 0 ≤ N * C.card := mul_nonneg hN (Nat.cast_nonneg _)
      nlinarith only [mul_nonneg hA hNC, mul_nonneg hB hM0, hM0, hNC]


end SchwartzPlanePoisson


namespace SchwartzPlanePoisson
open Eisenstein MeasureTheory
open scoped SchwartzMap

/-- Distinct prime ideals give distinct squarefree products of their chosen generators. -/
lemma primeSubset_product_injective {ι : Type*} (p : ι → O) (hp : ∀ i, p i ≠ 0)
    [∀ i, (Ideal.span {p i}).IsMaximal]
    (hinj : Function.Injective (fun i => Ideal.span {p i})) :
    Function.Injective (fun S : Finset ι => ∏ i ∈ S, p i) := by
  classical
  have hprime (i : ι) : Prime (p i) := (Ideal.span_singleton_prime (hp i)).mp inferInstance
  have hsub (S T : Finset ι) (h : (∏ i ∈ S, p i) = ∏ i ∈ T, p i) : S ⊆ T := by
    intro i hi
    have hd : p i ∣ ∏ j ∈ T, p j := h ▸ Finset.dvd_prod_of_mem p hi
    obtain ⟨j, hj, hij⟩ := ((hprime i).dvd_finsetProd_iff p).mp hd
    have he : i = j := hinj (Ideal.span_singleton_eq_span_singleton.mpr
      ((hprime i).associated_of_dvd (hprime j) hij))
    simpa only [he] using hj
  intro S T h
  exact Finset.Subset.antisymm (hsub S T h) (hsub T S h.symm)

/-- The same positive Schwartz majorant controls the number of lattice points in a norm ball. -/
lemma finite_norm_ball_card_bound (R : Finset O) (N : ℝ) (hN : 1 ≤ N)
    (hR : ∀ z ∈ R, ‖ringComplex z‖ ^ 2 ≤ N) :
    (R.card : ℝ) ≤ diagonalControl sieveCutoff * N := by
  have hNp : 0 < N := lt_of_lt_of_le zero_lt_one hN
  have hs : Summable (fun z : O => ‖sieveCutoff (‖ringComplex z‖ ^ 2 / N)‖) := by
    simpa only [scaledRadialTest_apply] using
      actual_eisenstein_summable_norm (scaledRadialTest sieveCutoff N hNp)
  calc
    (R.card : ℝ) = ∑ _z ∈ R, (1 : ℝ) := by simp
    _ = ∑ z ∈ R, ‖sieveCutoff (‖ringComplex z‖ ^ 2 / N)‖ := by
      apply Finset.sum_congr rfl
      intro z hz
      rw [sieveCutoff_apply, sieveBump_eq_one (div_nonneg (sq_nonneg _) hNp.le)
        ((div_le_one hNp).mpr (hR z hz)), Complex.ofReal_one, norm_one]
    _ ≤ ∑' z : O, ‖sieveCutoff (‖ringComplex z‖ ^ 2 / N)‖ :=
      hs.sum_le_tsum R (fun _ _ => norm_nonneg _)
    _ ≤ _ := radial_weight_lattice_bound sieveCutoff N hN

lemma primeSubset_card_bound {α β : Type*} [DecidableEq β]
    (p : α → O) (hp : ∀ i, p i ≠ 0) [∀ i, (Ideal.span {p i}).IsMaximal]
    (hinj : Function.Injective (fun i => Ideal.span {p i}))
    (C : Finset β) (support : β → Finset α) (hsupp : Set.InjOn support (↑C : Set β))
    (N : ℝ) (hN : 1 ≤ N) (hNorm : ∀ n ∈ C, primeSubsetNorm p (support n) ≤ N) :
    (C.card : ℝ) ≤ diagonalControl sieveCutoff * N := by
  classical
  let g : β → O := fun n => ∏ i ∈ support n, p i
  have hg : Set.InjOn g (↑C : Set β) := fun n hn m hm h =>
    hsupp hn hm (primeSubset_product_injective p hp hinj h)
  have hc : (C.image g).card = C.card := Finset.card_image_iff.mpr hg
  rw [← hc]
  apply finite_norm_ball_card_bound _ N hN
  intro z hz
  obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp hz
  exact hNorm n hn

/-- Uniform initial large-sieve bound, valid for arbitrary nontrivial prime characters. -/
theorem primeSubsetRow_initial_sieve :
    ∃ K : ℝ, 0 < K ∧
      ∀ {α β : Type*} [DecidableEq α] [DecidableEq β]
        (p : α → O) (hp : ∀ i, p i ≠ 0)
        [∀ i, (Ideal.span {p i}).IsMaximal]
        (hinj : Function.Injective (fun i => Ideal.span {p i}))
        (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) (hχ : ∀ i, χ i ≠ 1)
        (C : Finset β) (support : β → Finset α)
        (hsupp : Set.InjOn support (↑C : Set β))
        (N : ℝ), 1 ≤ N → (∀ n ∈ C, primeSubsetNorm p (support n) ≤ N) →
        ∀ (a : β → ℂ) (M : ℝ), 1 ≤ M → ∀ R : Finset O,
        (∀ z ∈ R, ‖ringComplex z‖ ^ 2 ≤ M) →
        (∑ z ∈ R, ‖∑ n ∈ C, a n * primeSubsetRow p χ (support n) z‖ ^ 2) ≤
          K * (M + N ^ 2) * ∑ n ∈ C, ‖a n‖ ^ 2 := by
  obtain ⟨K, hK, hb⟩ := primeSubsetRow_initial_finite_bound
  let D := diagonalControl sieveCutoff
  have hD : 0 ≤ D := diagonalControl_nonneg sieveCutoff
  refine ⟨K * (1 + D), mul_pos hK (by positivity), ?_⟩
  intro α β _ _ p hp _ hinj χ hχ C support hsupp N hN hNorm a M hM R hR
  have hN0 : 0 ≤ N := le_trans zero_le_one hN
  have hM0 : 0 ≤ M := le_trans zero_le_one hM
  have hc := primeSubset_card_bound p hp hinj C support hsupp N hN hNorm
  apply (hb p hp hinj χ hχ C support hsupp N hN0 hNorm a M hM R hR).trans
  apply mul_le_mul_of_nonneg_right _ (Finset.sum_nonneg fun _ _ => sq_nonneg _)
  calc
    K * (M + N * C.card) ≤ K * ((1 + D) * (M + N ^ 2)) := by
      apply mul_le_mul_of_nonneg_left _ hK.le
      have hnc := mul_le_mul_of_nonneg_left hc hN0
      nlinarith only [hnc, mul_nonneg hD hM0, sq_nonneg N]
    _ = _ := by ring

end SchwartzPlanePoisson

namespace SchwartzPlanePoisson
open Eisenstein MeasureTheory
open scoped SchwartzMap

/-- Exact second reflection of a Gram entry, retaining the signed common-prime divisor sum. -/
theorem primeSubsetRow_gram_poisson {ι : Type*} [DecidableEq ι]
    (p : ι → O) (hp : ∀ i, p i ≠ 0)
    [∀ i, (Ideal.span {p i}).IsMaximal]
    (hinj : Function.Injective (fun i => Ideal.span {p i}))
    (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) (hχ : ∀ i, χ i ≠ 1)
    (S T : Finset ι) :
    let p' : ↥((S \ T) ∪ (T \ S)) → O := fun i => p i.val
    let χ' := activePrimeRowCharacter p χ S T
    ∃ β : ℂ, ‖β‖ = 1 ∧ ∀ (W : 𝓢(ℝ, ℂ)) (Y : ℝ), 0 < Y →
      (∑' z : O, (star (primeSubsetRow p χ S z) * primeSubsetRow p χ T z) *
        W (‖ringComplex z‖ ^ 2 / Y)) =
        ((Y : ℂ) * β / (‖ringComplex (∏ i, p' i)‖ : ℂ)) *
          ∑ E ∈ (S ∩ T).powerset,
            ((-1 : ℂ) ^ E.card * primeCuspRowCharacter p' χ' (∏ i ∈ E, p i) /
              (‖ringComplex (∏ i ∈ E, p i)‖ ^ 2 : ℝ)) *
              ∑' h : O, primeCuspRowCharacter p' (fun i => (χ' i)⁻¹) h *
                paperRadialFourier W
                  (Y * ‖ringComplex h‖ ^ 2 /
                    (‖ringComplex (∏ i ∈ E, p i)‖ ^ 2 * ‖ringComplex (∏ i, p' i)‖ ^ 2)) := by
  classical
  dsimp only
  obtain ⟨β, hβ, hP⟩ := prime_row_masked_radial_poisson
    (fun i : ↥((S \ T) ∪ (T \ S)) => p i.val) (fun i => hp i.val)
    (hinj.comp Subtype.val_injective) (activePrimeRowCharacter p χ S T)
    (activePrimeRowCharacter_ne_one p χ hχ S T)
  refine ⟨β, hβ, ?_⟩
  intro W Y hY
  have hcop : Pairwise (Function.onFun IsCoprime p) := by
    intro i j hij
    exact (Ideal.isCoprime_span_singleton_iff _ _).mp
      (Ideal.isCoprime_of_isMaximal (hinj.ne hij))
  simp_rw [primeSubsetRow_pair_active]
  exact hP p hp hcop (S ∩ T) W Y hY

end SchwartzPlanePoisson


/-! Quadratic trace phases from Gaussian regularization and rank-two Poisson summation. -/

open scoped BigOperators Topology
open Filter Asymptotics MeasureTheory
namespace QuadraticPhase

namespace RankTwoPoisson
private theorem gauss_int_summable {a : ℂ} (ha : 0 < a.re) :
    Summable (fun n : ℤ => Complex.exp (-((Real.pi : ℂ) * a) * (n : ℂ) ^ 2)) := by
  have hpa : 0 < ((Real.pi : ℂ) * a).re := by
    simpa using mul_pos Real.pi_pos ha
  exact summable_of_isBigO (Real.summable_abs_int_rpow (show (1 : ℝ) < 2 by norm_num))
    ((isLittleO_exp_neg_mul_sq_cocompact hpa (-2)).isBigO.comp_tendsto
      Int.tendsto_coe_cofinite)

theorem real_gauss_summable {t : ℝ} (ht : 0 < t) :
    Summable (fun n : ℤ => Real.exp (-Real.pi * t * (n : ℝ) ^ 2)) := by
  have htc : 0 < (t : ℂ).re := by simpa using ht
  have h := (gauss_int_summable htc).norm
  simpa [Complex.norm_exp, ← Complex.ofReal_intCast, ← Complex.ofReal_pow, mul_assoc] using h
end RankTwoPoisson

namespace RankTwoComplex

open Real

/-- Positive quadratic decay dominates a product of one-dimensional Gaussian series. -/
theorem lattice_gaussian_summable_of_re_bound (F : ℤ × ℤ → ℂ)
    {eps : ℝ} (heps : 0 < eps)
    (hbound : ∀ z : ℤ × ℤ,
      eps * ((z.1 : ℝ) ^ 2 + (z.2 : ℝ) ^ 2) ≤ (F z).re) :
    Summable (fun z : ℤ × ℤ => Complex.exp (-(Real.pi : ℂ) * F z)) := by
  have h1 := RankTwoPoisson.real_gauss_summable heps
  have hmaj : Summable (fun z : ℤ × ℤ =>
      Real.exp (-Real.pi * eps * (z.1 : ℝ) ^ 2) *
      Real.exp (-Real.pi * eps * (z.2 : ℝ) ^ 2)) :=
    h1.mul_of_nonneg h1 (fun _ => (Real.exp_pos _).le) (fun _ => (Real.exp_pos _).le)
  refine hmaj.of_norm_bounded ?_
  intro z
  have hb := hbound z
  have hpi : 0 ≤ Real.pi := Real.pi_pos.le
  have hm := mul_le_mul_of_nonneg_left hb hpi
  have hexp : (-(Real.pi : ℂ) * F z).re ≤
      -Real.pi * eps * (z.1 : ℝ) ^ 2 +
      -Real.pi * eps * (z.2 : ℝ) ^ 2 := by
    simp [Complex.mul_re] at *
    nlinarith [hm]
  simpa only [Complex.norm_exp, Real.exp_add] using
    (Real.exp_le_exp.mpr hexp)

noncomputable def schur (a b d : ℂ) : ℂ := d - b ^ 2 / a

noncomputable def binaryGaussian (a b d : ℂ) (z : ℤ × ℤ) : ℂ :=
  Complex.exp (-(Real.pi : ℂ) *
    (a * (z.1 : ℂ) ^ 2 + 2 * b * (z.1 : ℂ) * (z.2 : ℂ) + d * (z.2 : ℂ) ^ 2))

noncomputable def firstGaussian (a b d : ℂ) (z : ℤ × ℤ) : ℂ :=
  Complex.exp (-(Real.pi : ℂ) / a * (z.1 : ℂ) ^ 2) *
    Complex.exp (-(Real.pi : ℂ) * schur a b d * (z.2 : ℂ) ^ 2 +
      2 * (Real.pi : ℂ) * (Complex.I * b / a * (z.1 : ℂ)) * (z.2 : ℂ))

noncomputable def dualGaussian (a b d : ℂ) (z : ℤ × ℤ) : ℂ :=
  Complex.exp (-(Real.pi : ℂ) / a * (z.1 : ℂ) ^ 2) *
    Complex.exp (-(Real.pi : ℂ) / (schur a b d) *
      ((z.2 : ℂ) - b / a * (z.1 : ℂ)) ^ 2)

private theorem binary_split (a b d : ℂ) (m n : ℤ) :
    binaryGaussian a b d (m,n) =
      Complex.exp (-(Real.pi : ℂ) * d * (n : ℂ) ^ 2) *
        Complex.exp (-(Real.pi : ℂ) * a * (m : ℂ) ^ 2 +
          2 * (Real.pi : ℂ) * (-(b * (n : ℂ))) * (m : ℂ)) := by
  dsimp [binaryGaussian]
  rw [← Complex.exp_add]
  congr 1
  ring

private theorem first_exponent_identity {a b d : ℂ} (ha : a ≠ 0) (k n : ℤ) :
    (-(Real.pi : ℂ) * d * (n : ℂ) ^ 2) +
      (-(Real.pi : ℂ) / a * ((k : ℂ) + Complex.I * (-(b * (n : ℂ)))) ^ 2) =
      (-(Real.pi : ℂ) / a * (k : ℂ) ^ 2) +
        (-(Real.pi : ℂ) * schur a b d * (n : ℂ) ^ 2 +
          2 * (Real.pi : ℂ) * (Complex.I * b / a * (k : ℂ)) * (n : ℂ)) := by
  dsimp [schur]
  field_simp [ha]
  ring_nf
  simp [Complex.I_sq]

private theorem first_transform_term {a b d : ℂ} (ha : a ≠ 0) (k n : ℤ) :
    Complex.exp (-(Real.pi : ℂ) * d * (n : ℂ) ^ 2) *
      Complex.exp (-(Real.pi : ℂ) / a *
        ((k : ℂ) + Complex.I * (-(b * (n : ℂ)))) ^ 2) =
      firstGaussian a b d (k,n) := by
  rw [← Complex.exp_add, first_exponent_identity ha k n, Complex.exp_add]
  rfl

private theorem first_poisson_slice {a b d : ℂ} (ha : 0 < a.re) (n : ℤ) :
    (∑' m : ℤ, binaryGaussian a b d (m,n)) =
      (1 / a ^ (1 / 2 : ℂ)) * ∑' k : ℤ, firstGaussian a b d (k,n) := by
  have ha0 : a ≠ 0 := by
    intro h
    simp [h] at ha
  let C : ℂ := Complex.exp (-(Real.pi : ℂ) * d * (n : ℂ) ^ 2)
  let B : ℂ := -(b * (n : ℂ))
  let F : ℤ → ℂ := fun m => Complex.exp
    (-(Real.pi : ℂ) * a * (m : ℂ) ^ 2 + 2 * (Real.pi : ℂ) * B * (m : ℂ))
  let H : ℤ → ℂ := fun k => Complex.exp
    (-(Real.pi : ℂ) / a * ((k : ℂ) + Complex.I * B) ^ 2)
  have hsplit : (∑' m : ℤ, binaryGaussian a b d (m,n)) = C * ∑' m : ℤ, F m := by
    rw [← tsum_mul_left]
    apply tsum_congr
    intro m
    exact binary_split a b d m n
  have hpoisson : (∑' m : ℤ, F m) =
      (1 / a ^ (1 / 2 : ℂ)) * ∑' k : ℤ, H k :=
    Complex.tsum_exp_neg_quadratic ha B
  calc
    (∑' m : ℤ, binaryGaussian a b d (m,n)) = C * ∑' m : ℤ, F m := hsplit
    _ = C * ((1 / a ^ (1 / 2 : ℂ)) * ∑' k : ℤ, H k) := by rw [hpoisson]
    _ = (1 / a ^ (1 / 2 : ℂ)) * (C * ∑' k : ℤ, H k) := by ring
    _ = (1 / a ^ (1 / 2 : ℂ)) * ∑' k : ℤ, firstGaussian a b d (k,n) := by
      congr 1
      rw [← tsum_mul_left]
      apply tsum_congr
      intro k
      exact first_transform_term ha0 k n

private theorem second_poisson_slice {a b d : ℂ}
    (hδ : 0 < (schur a b d).re) (k : ℤ) :
    (∑' n : ℤ, firstGaussian a b d (k,n)) =
      (1 / (schur a b d) ^ (1 / 2 : ℂ)) *
        ∑' l : ℤ, dualGaussian a b d (k,l) := by
  let A : ℂ := schur a b d
  let B : ℂ := Complex.I * b / a * (k : ℂ)
  let C : ℂ := Complex.exp (-(Real.pi : ℂ) / a * (k : ℂ) ^ 2)
  let F : ℤ → ℂ := fun n => Complex.exp
    (-(Real.pi : ℂ) * A * (n : ℂ) ^ 2 + 2 * (Real.pi : ℂ) * B * (n : ℂ))
  let H : ℤ → ℂ := fun l => Complex.exp
    (-(Real.pi : ℂ) / A * ((l : ℂ) + Complex.I * B) ^ 2)
  have hsplit : (∑' n : ℤ, firstGaussian a b d (k,n)) = C * ∑' n : ℤ, F n := by
    rw [← tsum_mul_left]
    apply tsum_congr
    intro n
    rfl
  have hpoisson : (∑' n : ℤ, F n) =
      (1 / A ^ (1 / 2 : ℂ)) * ∑' l : ℤ, H l :=
    Complex.tsum_exp_neg_quadratic hδ B
  have hterm (l : ℤ) : C * H l = dualGaussian a b d (k,l) := by
    have hb : Complex.I * B = -(b / a * (k : ℂ)) := by
      dsimp [B]
      field_simp
      ring_nf
      simp [Complex.I_sq]
    dsimp [H, dualGaussian, C, A]
    rw [hb]
    ring_nf
  calc
    (∑' n : ℤ, firstGaussian a b d (k,n)) = C * ∑' n : ℤ, F n := hsplit
    _ = C * ((1 / A ^ (1 / 2 : ℂ)) * ∑' l : ℤ, H l) := by rw [hpoisson]
    _ = (1 / A ^ (1 / 2 : ℂ)) * (C * ∑' l : ℤ, H l) := by ring
    _ = (1 / (schur a b d) ^ (1 / 2 : ℂ)) *
          ∑' l : ℤ, dualGaussian a b d (k,l) := by
      change (1 / A ^ (1 / 2 : ℂ)) * (C * ∑' l : ℤ, H l) =
        (1 / A ^ (1 / 2 : ℂ)) * ∑' l : ℤ, dualGaussian a b d (k,l)
      congr 1
      rw [← tsum_mul_left]
      exact tsum_congr hterm

/-- Apply Poisson summation successively in the two integer coordinates. -/
theorem binary_gaussian_poisson {a b d : ℂ}
    (ha : 0 < a.re) (hδ : 0 < (schur a b d).re)
    (hO : Summable (binaryGaussian a b d))
    (hM : Summable (firstGaussian a b d))
    (hD : Summable (dualGaussian a b d)) :
    (∑' z : ℤ × ℤ, binaryGaussian a b d z) =
      (1 / a ^ (1 / 2 : ℂ)) *
        (1 / (schur a b d) ^ (1 / 2 : ℂ)) *
        ∑' z : ℤ × ℤ, dualGaussian a b d z := by
  have hOcomm :
      (∑' n : ℤ, ∑' m : ℤ, binaryGaussian a b d (m,n)) =
        ∑' m : ℤ, ∑' n : ℤ, binaryGaussian a b d (m,n) :=
    (show Summable (Function.uncurry (fun m n : ℤ => binaryGaussian a b d (m,n)))
      from hO).tsum_comm
  have hMcomm :
      (∑' n : ℤ, ∑' k : ℤ, firstGaussian a b d (k,n)) =
        ∑' k : ℤ, ∑' n : ℤ, firstGaussian a b d (k,n) :=
    (show Summable (Function.uncurry (fun k n : ℤ => firstGaussian a b d (k,n)))
      from hM).tsum_comm
  calc
    (∑' z : ℤ × ℤ, binaryGaussian a b d z) =
        ∑' m : ℤ, ∑' n : ℤ, binaryGaussian a b d (m,n) := hO.tsum_prod
    _ = ∑' n : ℤ, ∑' m : ℤ, binaryGaussian a b d (m,n) := hOcomm.symm
    _ = ∑' n : ℤ, (1 / a ^ (1 / 2 : ℂ)) *
          ∑' k : ℤ, firstGaussian a b d (k,n) := by
      apply tsum_congr
      intro n
      exact first_poisson_slice ha n
    _ = (1 / a ^ (1 / 2 : ℂ)) *
          (∑' n : ℤ, ∑' k : ℤ, firstGaussian a b d (k,n)) := tsum_mul_left
    _ = (1 / a ^ (1 / 2 : ℂ)) *
          (∑' k : ℤ, ∑' n : ℤ, firstGaussian a b d (k,n)) := by
      rw [hMcomm]
    _ = (1 / a ^ (1 / 2 : ℂ)) *
          (∑' k : ℤ, (1 / (schur a b d) ^ (1 / 2 : ℂ)) *
            ∑' l : ℤ, dualGaussian a b d (k,l)) := by
      congr 1
      apply tsum_congr
      intro k
      exact second_poisson_slice hδ k
    _ = (1 / a ^ (1 / 2 : ℂ)) *
          (1 / (schur a b d) ^ (1 / 2 : ℂ)) *
          (∑' k : ℤ, ∑' l : ℤ, dualGaussian a b d (k,l)) := by
      rw [tsum_mul_left]
      ring
    _ = (1 / a ^ (1 / 2 : ℂ)) *
          (1 / (schur a b d) ^ (1 / 2 : ℂ)) *
          ∑' z : ℤ × ℤ, dualGaussian a b d z := by
      rw [hD.tsum_prod]

end RankTwoComplex

namespace SqrtBranch
open Complex

private theorem arg_ne_pi_of_re_pos {a : ℂ} (ha : 0 < a.re) : a.arg ≠ Real.pi := by
  intro h
  have := (Complex.arg_eq_pi_iff.mp h).1
  linarith

/-- The positive real determinant fixes the compatible principal square-root branches. -/
theorem cpow_half_product {a : ℂ} {r : ℝ} (ha : 0 < a.re) (hr : 0 < r) :
    a ^ (1 / 2 : ℂ) * (((r : ℂ) / a) ^ (1 / 2 : ℂ)) =
      (r : ℂ) ^ (1 / 2 : ℂ) := by
  have ha0 : a ≠ 0 := by
    intro h
    simp [h] at ha
  have harg := arg_ne_pi_of_re_pos ha
  have hlog : Complex.log ((r : ℂ) / a) = (Real.log r : ℂ) - Complex.log a := by
    rw [div_eq_mul_inv, Complex.log_ofReal_mul hr (inv_ne_zero ha0),
      Complex.log_inv a harg]
    ring
  have hr0 : (r : ℂ) ≠ 0 := by exact_mod_cast hr.ne'
  have hdiv : (r : ℂ) / a ≠ 0 := div_ne_zero hr0 ha0
  rw [Complex.cpow_def_of_ne_zero ha0,
    Complex.cpow_def_of_ne_zero hdiv,
    Complex.cpow_def_of_ne_zero hr0, hlog, ← Complex.exp_add]
  congr 1
  rw [Complex.ofReal_log hr.le]
  ring

theorem prefactor_product {a : ℂ} {r : ℝ} (ha : 0 < a.re) (hr : 0 < r) :
    (1 / a ^ (1 / 2 : ℂ)) * (1 / (((r : ℂ) / a) ^ (1 / 2 : ℂ))) =
      1 / ((r : ℂ) ^ (1 / 2 : ℂ)) := by
  simpa [div_eq_mul_inv, mul_inv_rev, mul_comm] using
    congrArg (fun z : ℂ => z⁻¹) (cpow_half_product ha hr)

end SqrtBranch

namespace OscSpecial

private theorem real_quadratic_lower {u v w : ℝ}
    (hu : 0 < u) (hv : 0 < v) (_hdet : 0 < u * v - w ^ 2)
    (x y : ℝ) :
    ((u * v - w ^ 2) / (u + v)) * (x ^ 2 + y ^ 2) ≤
      u * x ^ 2 - 2 * w * x * y + v * y ^ 2 := by
  have hsum : 0 < u + v := add_pos hu hv
  have hid :
      (u + v) * (u * x ^ 2 - 2 * w * x * y + v * y ^ 2) -
        (u * v - w ^ 2) * (x ^ 2 + y ^ 2) =
      (u * x - w * y) ^ 2 + (w * x - v * y) ^ 2 := by ring
  have hsq := add_nonneg (sq_nonneg (u * x - w * y))
    (sq_nonneg (w * x - v * y))
  have hnum : (u * v - w ^ 2) * (x ^ 2 + y ^ 2) ≤
      (u + v) * (u * x ^ 2 - 2 * w * x * y + v * y ^ 2) := by
    linarith
  have h : ((u * v - w ^ 2) * (x ^ 2 + y ^ 2)) / (u + v) ≤
      u * x ^ 2 - 2 * w * x * y + v * y ^ 2 :=
    (div_le_iff₀ hsum).2 (by simpa only [mul_comm] using hnum)
  simpa only [div_mul_eq_mul_div] using h

private theorem schur_eq_real_det_div {a b d : ℂ} {R : ℝ}
    (ha : a ≠ 0) (hdet : a * d - b ^ 2 = (R : ℂ)) :
    RankTwoComplex.schur a b d = (R : ℂ) / a := by
  unfold RankTwoComplex.schur
  rw [← hdet]
  field_simp [ha]

private theorem determinant_real_components {a b d : ℂ} {R : ℝ}
    (hdet : a * d - b ^ 2 = (R : ℂ)) :
    a.re * d.re - a.im * d.im - b.re ^ 2 + b.im ^ 2 = R ∧
    a.re * d.im + a.im * d.re - 2 * b.re * b.im = 0 := by
  constructor
  · have h := congrArg Complex.re hdet
    simp only [Complex.sub_re, Complex.mul_re, Complex.ofReal_re] at h
    have hb : (b ^ 2).re = b.re ^ 2 - b.im ^ 2 := by
      rw [pow_two, Complex.mul_re]
      ring
    rw [hb] at h
    linarith
  · have h := congrArg Complex.im hdet
    simp only [Complex.sub_im, Complex.mul_im, Complex.ofReal_im] at h
    have hb : (b ^ 2).im = 2 * b.re * b.im := by
      rw [pow_two, Complex.mul_im]
      ring
    rw [hb] at h
    linarith

private theorem first_real_coefficients {a b d : ℂ} {R : ℝ}
    (ha : a ≠ 0) (hdet : a * d - b ^ 2 = (R : ℂ)) :
    (a⁻¹).re = a.re / Complex.normSq a ∧
    (RankTwoComplex.schur a b d).re = R * a.re / Complex.normSq a ∧
    (Complex.I * b / a).re =
      (b.re * a.im - b.im * a.re) / Complex.normSq a := by
  constructor
  · exact Complex.inv_re a
  constructor
  · rw [schur_eq_real_det_div ha hdet]
    simp [Complex.div_re]
  · rw [Complex.div_re]
    simp [Complex.mul_re, Complex.mul_im]
    ring

private theorem first_real_determinant {a b d : ℂ} {R : ℝ}
    (ha : a ≠ 0) (hdet : a * d - b ^ 2 = (R : ℂ)) :
    (a.re / Complex.normSq a) * (R * a.re / Complex.normSq a) -
      ((b.re * a.im - b.im * a.re) / Complex.normSq a) ^ 2 =
      (a.re * d.re - b.re ^ 2) / Complex.normSq a := by
  have hN : Complex.normSq a ≠ 0 := (Complex.normSq_pos.mpr ha).ne'
  obtain ⟨hr, hi⟩ := determinant_real_components hdet
  have hid :
      R * a.re ^ 2 - (b.re * a.im - b.im * a.re) ^ 2 =
      (a.re ^ 2 + a.im ^ 2) * (a.re * d.re - b.re ^ 2) -
        a.im * a.re * (a.re * d.im + a.im * d.re - 2 * b.re * b.im) := by
    rw [← hr]
    ring
  rw [hi, mul_zero, sub_zero] at hid
  simp only [Complex.normSq_apply] at hN ⊢
  have hN' : a.re ^ 2 + a.im ^ 2 ≠ 0 := by simpa [pow_two] using hN
  field_simp [hN']
  nlinarith only [hid]

private noncomputable def middleForm (a b d : ℂ) (z : ℤ × ℤ) : ℂ :=
  a⁻¹ * (z.1 : ℂ) ^ 2 -
    2 * (Complex.I * b / a) * (z.1 : ℂ) * (z.2 : ℂ) +
    RankTwoComplex.schur a b d * (z.2 : ℂ) ^ 2

private theorem middleForm_real (a b d : ℂ) (z : ℤ × ℤ) :
    (middleForm a b d z).re =
      (a⁻¹).re * (z.1 : ℝ) ^ 2 -
      2 * (Complex.I * b / a).re * (z.1 : ℝ) * (z.2 : ℝ) +
      (RankTwoComplex.schur a b d).re * (z.2 : ℝ) ^ 2 := by
  simp [middleForm, Complex.add_re, Complex.sub_re, Complex.mul_re, pow_two]

private theorem middleForm_exp (a b d : ℂ) (z : ℤ × ℤ) :
    RankTwoComplex.firstGaussian a b d z =
      Complex.exp (-(Real.pi : ℂ) * middleForm a b d z) := by
  simp only [RankTwoComplex.firstGaussian, middleForm]
  rw [← Complex.exp_add]
  congr 1
  simp [div_eq_mul_inv]
  ring

private theorem firstGaussian_summable {a b d : ℂ} {R : ℝ}
    (ha : 0 < a.re) (hR : 0 < R)
    (hdet : a * d - b ^ 2 = (R : ℂ))
    (hpd : 0 < a.re * d.re - b.re ^ 2) :
    Summable (RankTwoComplex.firstGaussian a b d) := by
  have ha0 : a ≠ 0 := by
    intro h
    simp [h] at ha
  have hN : 0 < Complex.normSq a := Complex.normSq_pos.mpr ha0
  let u : ℝ := a.re / Complex.normSq a
  let v : ℝ := R * a.re / Complex.normSq a
  let w : ℝ := (b.re * a.im - b.im * a.re) / Complex.normSq a
  have hu : 0 < u := div_pos ha hN
  have hv : 0 < v := div_pos (mul_pos hR ha) hN
  have hq : 0 < u * v - w ^ 2 := by
    dsimp [u, v, w]
    rw [first_real_determinant ha0 hdet]
    exact div_pos hpd hN
  let eps : ℝ := (u * v - w ^ 2) / (u + v)
  have heps : 0 < eps := div_pos hq (add_pos hu hv)
  have hcoeff := first_real_coefficients ha0 hdet
  have hbound (z : ℤ × ℤ) :
      eps * ((z.1 : ℝ) ^ 2 + (z.2 : ℝ) ^ 2) ≤
      (middleForm a b d z).re := by
    rw [middleForm_real, hcoeff.1, hcoeff.2.1, hcoeff.2.2]
    exact real_quadratic_lower hu hv hq (z.1 : ℝ) (z.2 : ℝ)
  exact (RankTwoComplex.lattice_gaussian_summable_of_re_bound
    (middleForm a b d) heps hbound).congr (fun z => (middleForm_exp a b d z).symm)

private noncomputable def originalForm (a b d : ℂ) (z : ℤ × ℤ) : ℂ :=
  a * (z.1 : ℂ) ^ 2 + 2 * b * (z.1 : ℂ) * (z.2 : ℂ) + d * (z.2 : ℂ) ^ 2

private theorem originalForm_real (a b d : ℂ) (z : ℤ × ℤ) :
    (originalForm a b d z).re =
      a.re * (z.1 : ℝ) ^ 2 + 2 * b.re * (z.1 : ℝ) * (z.2 : ℝ) +
      d.re * (z.2 : ℝ) ^ 2 := by
  simp [originalForm, Complex.add_re, Complex.mul_re, pow_two]

private theorem originalGaussian_summable {a b d : ℂ}
    (ha : 0 < a.re) (hpd : 0 < a.re * d.re - b.re ^ 2) :
    Summable (RankTwoComplex.binaryGaussian a b d) := by
  have hd : 0 < d.re := by
    by_contra h
    have h' : d.re ≤ 0 := le_of_not_gt h
    have hm := mul_nonpos_of_nonneg_of_nonpos ha.le h'
    nlinarith [sq_nonneg b.re]
  let eps : ℝ := (a.re * d.re - b.re ^ 2) / (a.re + d.re)
  have heps : 0 < eps := div_pos hpd (add_pos ha hd)
  have hbound (z : ℤ × ℤ) :
      eps * ((z.1 : ℝ) ^ 2 + (z.2 : ℝ) ^ 2) ≤
      (originalForm a b d z).re := by
    rw [originalForm_real]
    dsimp [eps]
    convert real_quadratic_lower (w := -b.re) ha hd (by simpa using hpd)
      (z.1 : ℝ) (z.2 : ℝ) using 1 <;> ring
  exact (RankTwoComplex.lattice_gaussian_summable_of_re_bound
    (originalForm a b d) heps hbound).congr (fun z => by rfl)

noncomputable def inverseForm (a b d : ℂ) (R : ℝ) (z : ℤ × ℤ) : ℂ :=
  (d * (z.1 : ℂ) ^ 2 - 2 * b * (z.1 : ℂ) * (z.2 : ℂ) +
    a * (z.2 : ℂ) ^ 2) / (R : ℂ)

private theorem inverseForm_real (a b d : ℂ) {R : ℝ} (hR : R ≠ 0) (z : ℤ × ℤ) :
    (inverseForm a b d R z).re =
      (d.re * (z.1 : ℝ) ^ 2 - 2 * b.re * (z.1 : ℝ) * (z.2 : ℝ) +
        a.re * (z.2 : ℝ) ^ 2) / R := by
  simp [inverseForm, Complex.div_re, Complex.add_re, Complex.sub_re,
    Complex.mul_re, Complex.normSq_apply, pow_two]
  field_simp [hR]

theorem dualGaussian_inverseForm {a b d : ℂ} {R : ℝ}
    (ha : a ≠ 0) (hR : R ≠ 0)
    (hdet : a * d - b ^ 2 = (R : ℂ)) (z : ℤ × ℤ) :
    RankTwoComplex.dualGaussian a b d z =
      Complex.exp (-(Real.pi : ℂ) * inverseForm a b d R z) := by
  unfold RankTwoComplex.dualGaussian
  rw [← Complex.exp_add]
  congr 1
  rw [schur_eq_real_det_div ha hdet]
  dsimp [inverseForm]
  have hdet0 : a * d - b ^ 2 ≠ 0 := by rw [hdet]; exact_mod_cast hR
  rw [← hdet]
  field_simp [ha, hdet0] ; ring

private theorem dualGaussian_summable {a b d : ℂ} {R : ℝ}
    (ha : 0 < a.re) (hR : 0 < R)
    (hdet : a * d - b ^ 2 = (R : ℂ))
    (hpd : 0 < a.re * d.re - b.re ^ 2) :
    Summable (RankTwoComplex.dualGaussian a b d) := by
  have hd : 0 < d.re := by
    by_contra h
    have h' : d.re ≤ 0 := le_of_not_gt h
    have hm := mul_nonpos_of_nonneg_of_nonpos ha.le h'
    nlinarith [sq_nonneg b.re]
  let eps : ℝ := ((d.re * a.re - b.re ^ 2) / (d.re + a.re)) / R
  have heps : 0 < eps := div_pos (div_pos (by nlinarith [hpd]) (add_pos hd ha)) hR
  have hbound (z : ℤ × ℤ) :
      eps * ((z.1 : ℝ) ^ 2 + (z.2 : ℝ) ^ 2) ≤
      (inverseForm a b d R z).re := by
    rw [inverseForm_real a b d hR.ne']
    have hbase := real_quadratic_lower (u := d.re) (v := a.re) (w := b.re)
      hd ha (by nlinarith [hpd]) (z.1 : ℝ) (z.2 : ℝ)
    have hdivide := div_le_div_of_nonneg_right hbase hR.le
    simpa [eps, div_eq_mul_inv, mul_assoc, mul_comm, mul_left_comm] using hdivide
  have ha0 : a ≠ 0 := by intro h; simp [h] at ha
  exact (RankTwoComplex.lattice_gaussian_summable_of_re_bound
    (inverseForm a b d R) heps hbound).congr
      (fun z => (dualGaussian_inverseForm ha0 hR.ne' hdet z).symm)

/-- A positive real determinant and positive definite real part give the complete transform. -/
theorem binary_gaussian_poisson_real_det {a b d : ℂ} {R : ℝ}
    (ha : 0 < a.re) (hR : 0 < R)
    (hdet : a * d - b ^ 2 = (R : ℂ))
    (hpd : 0 < a.re * d.re - b.re ^ 2) :
    (∑' z : ℤ × ℤ, RankTwoComplex.binaryGaussian a b d z) =
      (1 / ((R : ℂ) ^ (1 / 2 : ℂ))) *
        ∑' z : ℤ × ℤ, RankTwoComplex.dualGaussian a b d z := by
  have ha0 : a ≠ 0 := by intro h; simp [h] at ha
  have hN : 0 < Complex.normSq a := Complex.normSq_pos.mpr ha0
  have hδ : 0 < (RankTwoComplex.schur a b d).re := by
    rw [schur_eq_real_det_div ha0 hdet]
    simpa [Complex.div_re] using div_pos (mul_pos hR ha) hN
  have hO := originalGaussian_summable ha hpd
  have hM := firstGaussian_summable ha hR hdet hpd
  have hD := dualGaussian_summable ha hR hdet hpd
  calc
    (∑' z : ℤ × ℤ, RankTwoComplex.binaryGaussian a b d z) =
      (1 / a ^ (1 / 2 : ℂ)) *
        (1 / (RankTwoComplex.schur a b d) ^ (1 / 2 : ℂ)) *
        ∑' z : ℤ × ℤ, RankTwoComplex.dualGaussian a b d z :=
      RankTwoComplex.binary_gaussian_poisson ha hδ hO hM hD
    _ = (1 / ((R : ℂ) ^ (1 / 2 : ℂ))) *
          ∑' z : ℤ × ℤ, RankTwoComplex.dualGaussian a b d z := by
      rw [schur_eq_real_det_div ha0 hdet,
        SqrtBranch.prefactor_product ha hR]

noncomputable def q (a b : ℝ) : ℝ := a ^ 2 - a * b + b ^ 2
noncomputable def A (η a b : ℝ) : ℂ :=
  (η : ℂ) + 2 * Complex.I * (b : ℂ) / (q a b : ℂ)
noncomputable def B (η a b : ℝ) : ℂ :=
  -(η : ℂ) / 2 - 2 * Complex.I * (a : ℂ) / (q a b : ℂ)
noncomputable def D (η a b : ℝ) : ℂ :=
  (η : ℂ) + 2 * Complex.I * ((a-b : ℝ) : ℂ) / (q a b : ℂ)
noncomputable def R (η a b : ℝ) : ℝ := 4 / q a b + 3 * η ^ 2 / 4

theorem coefficient_re (η a b : ℝ) (_hq : q a b ≠ 0) :
    (A η a b).re = η ∧ (B η a b).re = -η / 2 ∧ (D η a b).re = η := by
  simp [A, B, D, Complex.div_re, Complex.normSq_apply]

theorem oscillatory_determinant (η a b : ℝ) (hq : q a b ≠ 0) :
    A η a b * D η a b - (B η a b) ^ 2 = (R η a b : ℂ) := by
  have hqc : (q a b : ℂ) ≠ 0 := by exact_mod_cast hq
  have hqexpr : (q a b : ℂ) = (a : ℂ) ^ 2 - (a : ℂ) * (b : ℂ) + (b : ℂ) ^ 2 := by
    simp [q]
  have hRcast : (R η a b : ℂ) = 4 / (q a b : ℂ) + 3 * (η : ℂ) ^ 2 / 4 := by
    simp [R]
  rw [hRcast]
  dsimp [A, B, D]
  field_simp [hqc]
  rw [hqexpr]
  ring_nf
  simp [Complex.I_sq]
  ring

theorem real_positive_definite {η a b : ℝ} (hη : 0 < η) (hq : q a b ≠ 0) :
    0 < (A η a b).re * (D η a b).re - (B η a b).re ^ 2 := by
  obtain ⟨hA, hB, hD⟩ := coefficient_re η a b hq
  rw [hA, hB, hD]
  nlinarith [sq_pos_of_pos hη]


/-- The damped quadratic trace form has an exact, absolutely convergent Poisson transform. -/
theorem oscillatory_gaussian_poisson {η a b : ℝ}
    (hη : 0 < η) (hq : 0 < q a b) :
    (∑' z : ℤ × ℤ, RankTwoComplex.binaryGaussian (A η a b) (B η a b) (D η a b) z) =
      (1 / ((R η a b : ℂ) ^ (1 / 2 : ℂ))) *
        ∑' z : ℤ × ℤ,
          RankTwoComplex.dualGaussian (A η a b) (B η a b) (D η a b) z := by
  have hq0 : q a b ≠ 0 := hq.ne'
  have ha : 0 < (A η a b).re := by
    rw [(coefficient_re η a b hq0).1]
    exact hη
  have hR : 0 < R η a b := by
    unfold R
    positivity
  exact binary_gaussian_poisson_real_det ha hR
    (oscillatory_determinant η a b hq0)
    (real_positive_definite hη hq0)

noncomputable def r (η a b : ℝ) : ℝ := 1 + 3 * q a b * η ^ 2 / 16

theorem r_pos {η a b : ℝ} (hη : 0 < η) (hq : 0 < q a b) :
    0 < r η a b := by
  unfold r
  positivity

private theorem inverseForm_explicit {η a b : ℝ} (hη : 0 < η) (hq : 0 < q a b)
    (z : ℤ × ℤ) :
    inverseForm (A η a b) (B η a b) (D η a b) (R η a b) z =
      ((η : ℂ) * (q a b : ℂ) / (4 * (r η a b : ℂ))) *
        ((z.1 : ℂ) ^ 2 + (z.1 : ℂ) * (z.2 : ℂ) + (z.2 : ℂ) ^ 2) +
      Complex.I / (2 * (r η a b : ℂ)) *
        (((a-b : ℝ) : ℂ) * (z.1 : ℂ) ^ 2 +
          2 * (a : ℂ) * (z.1 : ℂ) * (z.2 : ℂ) +
          (b : ℂ) * (z.2 : ℂ) ^ 2) := by
  have hq0 : q a b ≠ 0 := hq.ne'
  have hqc : (q a b : ℂ) ≠ 0 := by exact_mod_cast hq0
  have hr0 : r η a b ≠ 0 := (r_pos hη hq).ne'
  have hrc : (r η a b : ℂ) ≠ 0 := by exact_mod_cast hr0
  have hR : 0 < R η a b := by unfold R; positivity
  have hRexpr : (R η a b : ℂ) = 4 * (r η a b : ℂ) / (q a b : ℂ) := by
    simp [R, r]
    field_simp [hqc]
    ring
  have hqexpr : (q a b : ℂ) = (a : ℂ) ^ 2 - (a : ℂ) * (b : ℂ) + (b : ℂ) ^ 2 := by
    simp [q]
  have hrexpr : (r η a b : ℂ) = 1 + 3 * (q a b : ℂ) * (η : ℂ) ^ 2 / 16 := by
    simp [r]
  dsimp [inverseForm, A, B, D]
  rw [hRexpr]
  field_simp [hqc, hrc]
  push_cast
  ring

/-- The inverse form separates a positive Gaussian scale from its quadratic phase. -/
theorem dualGaussian_explicit {η a b : ℝ} (hη : 0 < η) (hq : 0 < q a b)
    (z : ℤ × ℤ) :
    RankTwoComplex.dualGaussian (A η a b) (B η a b) (D η a b) z =
      Complex.exp (-(Real.pi : ℂ) *
        (((η : ℂ) * (q a b : ℂ) / (4 * (r η a b : ℂ))) *
          ((z.1 : ℂ) ^ 2 + (z.1 : ℂ) * (z.2 : ℂ) + (z.2 : ℂ) ^ 2) +
         Complex.I / (2 * (r η a b : ℂ)) *
          (((a-b : ℝ) : ℂ) * (z.1 : ℂ) ^ 2 +
            2 * (a : ℂ) * (z.1 : ℂ) * (z.2 : ℂ) +
            (b : ℂ) * (z.2 : ℂ) ^ 2))) := by
  have hq0 : q a b ≠ 0 := hq.ne'
  have hA0 : A η a b ≠ 0 := by
    intro h
    have hAr : (A η a b).re = η := (coefficient_re η a b hq0).1
    simp [h] at hAr
    linarith
  have hR : 0 < R η a b := by unfold R; positivity
  rw [dualGaussian_inverseForm hA0 hR.ne'
    (oscillatory_determinant η a b hq0) z,
    inverseForm_explicit hη hq z]

end OscSpecial
end QuadraticPhase


open scoped BigOperators Topology
open Filter Asymptotics MeasureTheory
namespace QuadraticPhase

namespace RankTwoPoisson
noncomputable def cg (a : ℂ) (n : ℤ) : ℂ :=
  Complex.exp (-((Real.pi : ℂ) * a) * (n : ℂ) ^ 2)

noncomputable def eisQ (z : ℤ × ℤ) : ℝ :=
  (z.1 : ℝ) ^ 2 - (z.1 : ℝ) * (z.2 : ℝ) + (z.2 : ℝ) ^ 2

noncomputable def eisGauss (t : ℝ) (z : ℤ × ℤ) : ℂ :=
  Complex.exp ((-Real.pi * t * eisQ z : ℝ) : ℂ)

theorem eisQ_lower (z : ℤ × ℤ) :
    ((z.1 : ℝ) ^ 2 + (z.2 : ℝ) ^ 2) / 2 ≤ eisQ z := by
  dsimp [eisQ]
  nlinarith [sq_nonneg ((z.1 : ℝ) - (z.2 : ℝ))]

theorem eis_gauss_summable {t : ℝ} (ht : 0 < t) :
    Summable (eisGauss t) := by
  have ht2 : 0 < t / 2 := by positivity
  have h1 := real_gauss_summable ht2
  have hmaj : Summable (fun z : ℤ × ℤ =>
      Real.exp (-Real.pi * (t / 2) * (z.1 : ℝ) ^ 2) *
      Real.exp (-Real.pi * (t / 2) * (z.2 : ℝ) ^ 2)) :=
    h1.mul_of_nonneg h1 (fun _ => (Real.exp_pos _).le) (fun _ => (Real.exp_pos _).le)
  refine hmaj.of_norm_bounded ?_
  intro z
  have hq := eisQ_lower z
  have hpi : 0 ≤ Real.pi * t := (mul_pos Real.pi_pos ht).le
  have hmul := mul_le_mul_of_nonneg_left hq hpi
  have hexp : -Real.pi * t * eisQ z ≤
      -Real.pi * (t / 2) * (z.1 : ℝ) ^ 2 +
      -Real.pi * (t / 2) * (z.2 : ℝ) ^ 2 := by
    nlinarith [hmul]
  simpa [eisGauss, Complex.norm_exp, Real.exp_add] using
    (Real.exp_le_exp.mpr hexp)


end RankTwoPoisson

namespace RankTwoAffine

open RankTwoComplex

noncomputable def binaryGaussian (a b d u v : ℂ) (z : ℤ × ℤ) : ℂ :=
  Complex.exp (-(Real.pi : ℂ) *
    (a * (z.1 : ℂ) ^ 2 + 2 * b * (z.1 : ℂ) * (z.2 : ℂ) + d * (z.2 : ℂ) ^ 2) +
    2 * (Real.pi : ℂ) * (u * (z.1 : ℂ) + v * (z.2 : ℂ)))

noncomputable def firstGaussian (a b d u v : ℂ) (z : ℤ × ℤ) : ℂ :=
  Complex.exp (-(Real.pi : ℂ) / a * ((z.1 : ℂ) + Complex.I * u) ^ 2) *
    Complex.exp (-(Real.pi : ℂ) * schur a b d * (z.2 : ℂ) ^ 2 +
      2 * (Real.pi : ℂ) *
        (v + Complex.I * b / a * ((z.1 : ℂ) + Complex.I * u)) * (z.2 : ℂ))

noncomputable def dualGaussian (a b d u v : ℂ) (z : ℤ × ℤ) : ℂ :=
  Complex.exp (-(Real.pi : ℂ) / a * ((z.1 : ℂ) + Complex.I * u) ^ 2) *
    Complex.exp (-(Real.pi : ℂ) / (schur a b d) *
      ((z.2 : ℂ) + Complex.I *
        (v + Complex.I * b / a * ((z.1 : ℂ) + Complex.I * u))) ^ 2)

private theorem binary_split (a b d u v : ℂ) (m n : ℤ) :
    binaryGaussian a b d u v (m,n) =
      Complex.exp (-(Real.pi : ℂ) * d * (n : ℂ) ^ 2 +
        2 * (Real.pi : ℂ) * v * (n : ℂ)) *
        Complex.exp (-(Real.pi : ℂ) * a * (m : ℂ) ^ 2 +
          2 * (Real.pi : ℂ) * (u - b * (n : ℂ)) * (m : ℂ)) := by
  dsimp [binaryGaussian]
  rw [← Complex.exp_add]
  congr 1
  ring

private theorem first_exponent_identity {a b d u v : ℂ} (ha : a ≠ 0) (k n : ℤ) :
    (-(Real.pi : ℂ) * d * (n : ℂ) ^ 2 +
        2 * (Real.pi : ℂ) * v * (n : ℂ)) +
      (-(Real.pi : ℂ) / a *
        ((k : ℂ) + Complex.I * (u - b * (n : ℂ))) ^ 2) =
      (-(Real.pi : ℂ) / a * ((k : ℂ) + Complex.I * u) ^ 2) +
        (-(Real.pi : ℂ) * schur a b d * (n : ℂ) ^ 2 +
          2 * (Real.pi : ℂ) *
            (v + Complex.I * b / a * ((k : ℂ) + Complex.I * u)) * (n : ℂ)) := by
  dsimp [schur]
  field_simp [ha]
  ring_nf
  simp [Complex.I_sq]

private theorem first_transform_term {a b d u v : ℂ} (ha : a ≠ 0) (k n : ℤ) :
    Complex.exp (-(Real.pi : ℂ) * d * (n : ℂ) ^ 2 +
      2 * (Real.pi : ℂ) * v * (n : ℂ)) *
      Complex.exp (-(Real.pi : ℂ) / a *
        ((k : ℂ) + Complex.I * (u - b * (n : ℂ))) ^ 2) =
      firstGaussian a b d u v (k,n) := by
  rw [← Complex.exp_add, first_exponent_identity ha k n, Complex.exp_add]
  rfl

private theorem first_poisson_slice {a b d u v : ℂ} (ha : 0 < a.re) (n : ℤ) :
    (∑' m : ℤ, binaryGaussian a b d u v (m,n)) =
      (1 / a ^ (1 / 2 : ℂ)) * ∑' k : ℤ, firstGaussian a b d u v (k,n) := by
  have ha0 : a ≠ 0 := by
    intro h
    simp [h] at ha
  let C : ℂ := Complex.exp (-(Real.pi : ℂ) * d * (n : ℂ) ^ 2 +
    2 * (Real.pi : ℂ) * v * (n : ℂ))
  let B : ℂ := u - b * (n : ℂ)
  let F : ℤ → ℂ := fun m => Complex.exp
    (-(Real.pi : ℂ) * a * (m : ℂ) ^ 2 + 2 * (Real.pi : ℂ) * B * (m : ℂ))
  let H : ℤ → ℂ := fun k => Complex.exp
    (-(Real.pi : ℂ) / a * ((k : ℂ) + Complex.I * B) ^ 2)
  have hsplit : (∑' m : ℤ, binaryGaussian a b d u v (m,n)) = C * ∑' m : ℤ, F m := by
    rw [← tsum_mul_left]
    apply tsum_congr
    intro m
    exact binary_split a b d u v m n
  have hpoisson : (∑' m : ℤ, F m) =
      (1 / a ^ (1 / 2 : ℂ)) * ∑' k : ℤ, H k :=
    Complex.tsum_exp_neg_quadratic ha B
  calc
    (∑' m : ℤ, binaryGaussian a b d u v (m,n)) = C * ∑' m : ℤ, F m := hsplit
    _ = C * ((1 / a ^ (1 / 2 : ℂ)) * ∑' k : ℤ, H k) := by rw [hpoisson]
    _ = (1 / a ^ (1 / 2 : ℂ)) * (C * ∑' k : ℤ, H k) := by ring
    _ = (1 / a ^ (1 / 2 : ℂ)) * ∑' k : ℤ, firstGaussian a b d u v (k,n) := by
      congr 1
      rw [← tsum_mul_left]
      apply tsum_congr
      intro k
      exact first_transform_term ha0 k n

private theorem second_poisson_slice {a b d u v : ℂ}
    (hδ : 0 < (schur a b d).re) (k : ℤ) :
    (∑' n : ℤ, firstGaussian a b d u v (k,n)) =
      (1 / (schur a b d) ^ (1 / 2 : ℂ)) *
        ∑' l : ℤ, dualGaussian a b d u v (k,l) := by
  let A : ℂ := schur a b d
  let B : ℂ := v + Complex.I * b / a * ((k : ℂ) + Complex.I * u)
  let C : ℂ := Complex.exp (-(Real.pi : ℂ) / a * ((k : ℂ) + Complex.I * u) ^ 2)
  let F : ℤ → ℂ := fun n => Complex.exp
    (-(Real.pi : ℂ) * A * (n : ℂ) ^ 2 + 2 * (Real.pi : ℂ) * B * (n : ℂ))
  let H : ℤ → ℂ := fun l => Complex.exp
    (-(Real.pi : ℂ) / A * ((l : ℂ) + Complex.I * B) ^ 2)
  have hsplit : (∑' n : ℤ, firstGaussian a b d u v (k,n)) = C * ∑' n : ℤ, F n := by
    rw [← tsum_mul_left]
    apply tsum_congr
    intro n
    rfl
  have hpoisson : (∑' n : ℤ, F n) =
      (1 / A ^ (1 / 2 : ℂ)) * ∑' l : ℤ, H l :=
    Complex.tsum_exp_neg_quadratic hδ B
  calc
    (∑' n : ℤ, firstGaussian a b d u v (k,n)) = C * ∑' n : ℤ, F n := hsplit
    _ = C * ((1 / A ^ (1 / 2 : ℂ)) * ∑' l : ℤ, H l) := by rw [hpoisson]
    _ = (1 / A ^ (1 / 2 : ℂ)) * (C * ∑' l : ℤ, H l) := by ring
    _ = (1 / (schur a b d) ^ (1 / 2 : ℂ)) *
          ∑' l : ℤ, dualGaussian a b d u v (k,l) := by
      change (1 / A ^ (1 / 2 : ℂ)) * (C * ∑' l : ℤ, H l) =
        (1 / A ^ (1 / 2 : ℂ)) * ∑' l : ℤ, dualGaussian a b d u v (k,l)
      congr 1
      rw [← tsum_mul_left]
      rfl

/-- Successive one-dimensional transforms include the affine linear terms. -/
theorem affine_gaussian_poisson {a b d u v : ℂ}
    (ha : 0 < a.re) (hδ : 0 < (schur a b d).re)
    (hO : Summable (binaryGaussian a b d u v))
    (hM : Summable (firstGaussian a b d u v))
    (hD : Summable (dualGaussian a b d u v)) :
    (∑' z : ℤ × ℤ, binaryGaussian a b d u v z) =
      (1 / a ^ (1 / 2 : ℂ)) *
        (1 / (schur a b d) ^ (1 / 2 : ℂ)) *
        ∑' z : ℤ × ℤ, dualGaussian a b d u v z := by
  have hOcomm :
      (∑' n : ℤ, ∑' m : ℤ, binaryGaussian a b d u v (m,n)) =
        ∑' m : ℤ, ∑' n : ℤ, binaryGaussian a b d u v (m,n) :=
    (show Summable (Function.uncurry (fun m n : ℤ => binaryGaussian a b d u v (m,n)))
      from hO).tsum_comm
  have hMcomm :
      (∑' n : ℤ, ∑' k : ℤ, firstGaussian a b d u v (k,n)) =
        ∑' k : ℤ, ∑' n : ℤ, firstGaussian a b d u v (k,n) :=
    (show Summable (Function.uncurry (fun k n : ℤ => firstGaussian a b d u v (k,n)))
      from hM).tsum_comm
  calc
    (∑' z : ℤ × ℤ, binaryGaussian a b d u v z) =
        ∑' m : ℤ, ∑' n : ℤ, binaryGaussian a b d u v (m,n) := hO.tsum_prod
    _ = ∑' n : ℤ, ∑' m : ℤ, binaryGaussian a b d u v (m,n) := hOcomm.symm
    _ = ∑' n : ℤ, (1 / a ^ (1 / 2 : ℂ)) *
          ∑' k : ℤ, firstGaussian a b d u v (k,n) := by
      apply tsum_congr
      intro n
      exact first_poisson_slice ha n
    _ = (1 / a ^ (1 / 2 : ℂ)) *
          (∑' n : ℤ, ∑' k : ℤ, firstGaussian a b d u v (k,n)) := tsum_mul_left
    _ = (1 / a ^ (1 / 2 : ℂ)) *
          (∑' k : ℤ, ∑' n : ℤ, firstGaussian a b d u v (k,n)) := by
      rw [hMcomm]
    _ = (1 / a ^ (1 / 2 : ℂ)) *
          (∑' k : ℤ, (1 / (schur a b d) ^ (1 / 2 : ℂ)) *
            ∑' l : ℤ, dualGaussian a b d u v (k,l)) := by
      congr 1
      apply tsum_congr
      intro k
      exact second_poisson_slice hδ k
    _ = (1 / a ^ (1 / 2 : ℂ)) *
          (1 / (schur a b d) ^ (1 / 2 : ℂ)) *
          (∑' k : ℤ, ∑' l : ℤ, dualGaussian a b d u v (k,l)) := by
      rw [tsum_mul_left]
      ring
    _ = (1 / a ^ (1 / 2 : ℂ)) *
          (1 / (schur a b d) ^ (1 / 2 : ℂ)) *
          ∑' z : ℤ × ℤ, dualGaussian a b d u v z := by
      rw [hD.tsum_prod]

end RankTwoAffine

namespace RankTwoEisShift

noncomputable def Q (x y : ℝ) : ℝ := x ^ 2 - x * y + y ^ 2

noncomputable def shifted (t x y : ℝ) (z : ℤ × ℤ) : ℂ :=
  Complex.exp (((-Real.pi * t * Q ((z.1 : ℝ) + x) ((z.2 : ℝ) + y) : ℝ) : ℂ))

noncomputable def A (t : ℝ) : ℂ := (t : ℂ)
noncomputable def B (t : ℝ) : ℂ := ((-t / 2 : ℝ) : ℂ)
noncomputable def D (t : ℝ) : ℂ := (t : ℂ)
noncomputable def U (t x y : ℝ) : ℂ := ((-t * (x - y / 2) : ℝ) : ℂ)
noncomputable def V (t x y : ℝ) : ℂ := ((-t * (y - x / 2) : ℝ) : ℂ)
noncomputable def C (t x y : ℝ) : ℂ :=
  Complex.exp (((-Real.pi * t * Q x y : ℝ) : ℂ))

private theorem shifted_eq_affine (t x y : ℝ) (m n : ℤ) :
    shifted t x y (m,n) =
      C t x y * RankTwoAffine.binaryGaussian (A t) (B t) (D t) (U t x y) (V t x y) (m,n) := by
  dsimp [shifted, C, Q, RankTwoAffine.binaryGaussian, A, B, D, U, V]
  rw [← Complex.exp_add]
  congr 1
  push_cast
  ring

private theorem schur_eis {t : ℝ} (ht : 0 < t) :
    RankTwoComplex.schur (A t) (B t) (D t) = (((3 * t) / 4 : ℝ) : ℂ) := by
  have ht0 : (t : ℂ) ≠ 0 := by exact_mod_cast ne_of_gt ht
  dsimp [RankTwoComplex.schur, A, B, D]
  push_cast
  field_simp [ht0]
  ring

private theorem schur_eis_pos {t : ℝ} (ht : 0 < t) :
    0 < (RankTwoComplex.schur (A t) (B t) (D t)).re := by
  rw [schur_eis ht]
  have h : 0 < 3 * t / 4 := by positivity
  simpa using h

noncomputable def dualPhase (k l : ℤ) (x y : ℝ) : ℂ :=
  Complex.exp ((((2 * Real.pi * ((k : ℝ) * x + (l : ℝ) * y) : ℝ) : ℂ)) * Complex.I)

private theorem shifted_dual_term {t : ℝ} (ht : 0 < t) (x y : ℝ) (k l : ℤ) :
    C t x y *
      RankTwoAffine.dualGaussian (A t) (B t) (D t) (U t x y) (V t x y) (k,l) =
      RankTwoPoisson.eisGauss (4 / (3 * t)) (k,-l) * dualPhase k l x y := by
  have ht0 : (t : ℂ) ≠ 0 := by exact_mod_cast ne_of_gt ht
  dsimp [C, Q, RankTwoAffine.dualGaussian, RankTwoPoisson.eisGauss,
    RankTwoPoisson.eisQ, dualPhase, A, B, D, U, V]
  rw [show RankTwoComplex.schur (t : ℂ) ((-t / 2 : ℝ) : ℂ) (t : ℂ) =
      (((3 * t) / 4 : ℝ) : ℂ) from schur_eis ht]
  rw [← Complex.exp_add, ← Complex.exp_add, ← Complex.exp_add]
  congr 1
  push_cast
  field_simp [ht0]
  ring_nf
  norm_num [Complex.I_pow_eq_pow_mod, Complex.I_sq]
  ring_nf
  simp only [Complex.I_sq, Complex.I_pow_three]
  ring

private theorem shifted_real_gauss_summable {t : ℝ} (ht : 0 < t) (y : ℝ) :
    Summable (fun n : ℤ => Real.exp (-Real.pi * t * ((n : ℝ) + y) ^ 2)) := by
  have ht2 : 0 < t / 2 := by positivity
  have hbase := RankTwoPoisson.real_gauss_summable ht2
  have hmaj : Summable (fun n : ℤ =>
      Real.exp (Real.pi * t * y ^ 2) *
        Real.exp (-Real.pi * (t / 2) * (n : ℝ) ^ 2)) :=
    hbase.mul_left _
  refine hmaj.of_norm_bounded ?_
  intro n
  have hs : (n : ℝ) ^ 2 / 2 - y ^ 2 ≤ ((n : ℝ) + y) ^ 2 := by
    nlinarith [sq_nonneg ((n : ℝ) + 2 * y)]
  have hm := mul_le_mul_of_nonneg_left hs (mul_pos Real.pi_pos ht).le
  have he : -Real.pi * t * ((n : ℝ) + y) ^ 2 ≤
      Real.pi * t * y ^ 2 + -Real.pi * (t / 2) * (n : ℝ) ^ 2 := by
    nlinarith [hm]
  simpa [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _), Real.exp_add] using
    (Real.exp_le_exp.mpr he)

noncomputable def middlePhase (k n : ℤ) (x y : ℝ) : ℂ :=
  Complex.exp ((((2 * Real.pi * (k : ℝ) * (x - ((n : ℝ) + y) / 2) : ℝ) : ℂ)) * Complex.I)

private theorem middlePhase_norm (k n : ℤ) (x y : ℝ) :
    ‖middlePhase k n x y‖ = 1 := by
  simp [middlePhase, Complex.norm_exp, Complex.mul_re]

private theorem shifted_middle_term {t : ℝ} (ht : 0 < t) (x y : ℝ) (k n : ℤ) :
    C t x y *
      RankTwoAffine.firstGaussian (A t) (B t) (D t) (U t x y) (V t x y) (k,n) =
      RankTwoPoisson.cg ((t⁻¹ : ℝ) : ℂ) k *
        Complex.exp (((-Real.pi * (3 * t / 4) * ((n : ℝ) + y) ^ 2 : ℝ) : ℂ)) *
        middlePhase k n x y := by
  have ht0 : (t : ℂ) ≠ 0 := by exact_mod_cast ne_of_gt ht
  dsimp [C, Q, RankTwoAffine.firstGaussian, RankTwoPoisson.cg,
    middlePhase, A, B, D, U, V]
  rw [show RankTwoComplex.schur (t : ℂ) ((-t / 2 : ℝ) : ℂ) (t : ℂ) =
      (((3 * t) / 4 : ℝ) : ℂ) from schur_eis ht]
  rw [← Complex.exp_add, ← Complex.exp_add, ← Complex.exp_add, ← Complex.exp_add]
  congr 1
  push_cast
  field_simp [ht0]
  ring_nf
  norm_num [Complex.I_pow_eq_pow_mod, Complex.I_sq]
  ring_nf
  simp only [Complex.I_sq]
  ring

private theorem middle_norm {t : ℝ} (ht : 0 < t) (x y : ℝ) (k n : ℤ) :
    ‖C t x y *
      RankTwoAffine.firstGaussian (A t) (B t) (D t) (U t x y) (V t x y) (k,n)‖ =
      Real.exp (-Real.pi * t⁻¹ * (k : ℝ) ^ 2) *
      Real.exp (-Real.pi * (3 * t / 4) * ((n : ℝ) + y) ^ 2) := by
  rw [shifted_middle_term ht]
  simp [ middlePhase_norm, RankTwoPoisson.cg, Complex.norm_exp,
    ← Complex.ofReal_intCast, ← Complex.ofReal_pow, mul_assoc]

private theorem affine_middle_summable {t : ℝ} (ht : 0 < t) (x y : ℝ) :
    Summable (RankTwoAffine.firstGaussian (A t) (B t) (D t) (U t x y) (V t x y)) := by
  have htinv : 0 < t⁻¹ := inv_pos.mpr ht
  have ht3 : 0 < 3 * t / 4 := by positivity
  have h1 := RankTwoPoisson.real_gauss_summable htinv
  have h2 := shifted_real_gauss_summable ht3 y
  have hmaj : Summable (fun z : ℤ × ℤ =>
      Real.exp (-Real.pi * t⁻¹ * (z.1 : ℝ) ^ 2) *
      Real.exp (-Real.pi * (3 * t / 4) * ((z.2 : ℝ) + y) ^ 2)) :=
    h1.mul_of_nonneg h2 (fun _ => (Real.exp_pos _).le) (fun _ => (Real.exp_pos _).le)
  have hCmid : Summable (fun z : ℤ × ℤ =>
      C t x y * RankTwoAffine.firstGaussian (A t) (B t) (D t) (U t x y) (V t x y) z) := by
    refine hmaj.of_norm_bounded ?_
    intro z
    rw [middle_norm ht]
  have hC : C t x y ≠ 0 := Complex.exp_ne_zero _
  have h := hCmid.mul_left (C t x y)⁻¹
  simpa only [← mul_assoc, inv_mul_cancel₀ hC, one_mul] using h

theorem dualPhase_norm (k l : ℤ) (x y : ℝ) :
    ‖dualPhase k l x y‖ = 1 := by
  simp [dualPhase, Complex.norm_exp, Complex.mul_re]

private theorem affine_dual_summable {t : ℝ} (ht : 0 < t) (x y : ℝ) :
    Summable (RankTwoAffine.dualGaussian (A t) (B t) (D t) (U t x y) (V t x y)) := by
  have htd : 0 < 4 / (3 * t) := by positivity
  let e : ℤ × ℤ ≃ ℤ × ℤ :=
    Equiv.prodCongr (Equiv.refl ℤ) (Equiv.neg ℤ)
  have hE : Summable (fun z : ℤ × ℤ =>
      RankTwoPoisson.eisGauss (4 / (3 * t)) (z.1,-z.2)) :=
    (e.summable_iff).2 (RankTwoPoisson.eis_gauss_summable htd)
  have hCdual : Summable (fun z : ℤ × ℤ =>
      C t x y * RankTwoAffine.dualGaussian (A t) (B t) (D t) (U t x y) (V t x y) z) := by
    refine hE.norm.of_norm_bounded ?_
    intro z
    rw [shifted_dual_term ht]
    simp [ dualPhase_norm]
  have hC : C t x y ≠ 0 := Complex.exp_ne_zero _
  have h := hCdual.mul_left (C t x y)⁻¹
  simpa only [← mul_assoc, inv_mul_cancel₀ hC, one_mul] using h

private theorem shifted_summable {t : ℝ} (ht : 0 < t) (x y : ℝ) :
    Summable (shifted t x y) := by
  have ht4 : 0 < t / 4 := by positivity
  have h1 := RankTwoPoisson.real_gauss_summable ht4
  have hbase : Summable (fun z : ℤ × ℤ =>
      Real.exp (-Real.pi * (t / 4) * (z.1 : ℝ) ^ 2) *
      Real.exp (-Real.pi * (t / 4) * (z.2 : ℝ) ^ 2)) :=
    h1.mul_of_nonneg h1 (fun _ => (Real.exp_pos _).le) (fun _ => (Real.exp_pos _).le)
  have hmaj : Summable (fun z : ℤ × ℤ =>
      Real.exp (Real.pi * t * (x ^ 2 + y ^ 2) / 2) *
        (Real.exp (-Real.pi * (t / 4) * (z.1 : ℝ) ^ 2) *
         Real.exp (-Real.pi * (t / 4) * (z.2 : ℝ) ^ 2))) :=
    hbase.mul_left _
  refine hmaj.of_norm_bounded ?_
  intro z
  have hq : (((z.1 : ℝ) + x) ^ 2 + ((z.2 : ℝ) + y) ^ 2) / 2 ≤
      Q ((z.1 : ℝ) + x) ((z.2 : ℝ) + y) := by
    dsimp [Q]
    nlinarith [sq_nonneg (((z.1 : ℝ) + x) - ((z.2 : ℝ) + y))]
  have hm : (z.1 : ℝ) ^ 2 / 2 - x ^ 2 ≤ ((z.1 : ℝ) + x) ^ 2 := by
    nlinarith [sq_nonneg ((z.1 : ℝ) + 2 * x)]
  have hn : (z.2 : ℝ) ^ 2 / 2 - y ^ 2 ≤ ((z.2 : ℝ) + y) ^ 2 := by
    nlinarith [sq_nonneg ((z.2 : ℝ) + 2 * y)]
  have hl : ((z.1 : ℝ) ^ 2 + (z.2 : ℝ) ^ 2) / 4 -
      (x ^ 2 + y ^ 2) / 2 ≤ Q ((z.1 : ℝ) + x) ((z.2 : ℝ) + y) := by
    nlinarith [hq, hm, hn]
  have hpt : 0 ≤ Real.pi * t := (mul_pos Real.pi_pos ht).le
  have hmul := mul_le_mul_of_nonneg_left hl hpt
  have he : -Real.pi * t * Q ((z.1 : ℝ) + x) ((z.2 : ℝ) + y) ≤
      Real.pi * t * (x ^ 2 + y ^ 2) / 2 +
        (-Real.pi * (t / 4) * (z.1 : ℝ) ^ 2 +
         -Real.pi * (t / 4) * (z.2 : ℝ) ^ 2) := by
    nlinarith [hmul]
  simpa [shifted, Complex.norm_exp, Real.exp_add, mul_assoc] using
    (Real.exp_le_exp.mpr he)

private theorem affine_original_summable {t : ℝ} (ht : 0 < t) (x y : ℝ) :
    Summable (RankTwoAffine.binaryGaussian (A t) (B t) (D t) (U t x y) (V t x y)) := by
  have hS := shifted_summable ht x y
  have hC : C t x y ≠ 0 := Complex.exp_ne_zero _
  have hCA : Summable (fun z : ℤ × ℤ =>
      C t x y * RankTwoAffine.binaryGaussian (A t) (B t) (D t) (U t x y) (V t x y) z) :=
    hS.congr (fun z => shifted_eq_affine t x y z.1 z.2)
  have h := hCA.mul_left (C t x y)⁻¹
  simpa only [← mul_assoc, inv_mul_cancel₀ hC, one_mul] using h

/-- Poisson summation for an arbitrary real shift of the Eisenstein norm form. -/
theorem shifted_eisenstein_gaussian_poisson {t : ℝ} (ht : 0 < t) (x y : ℝ) :
    (∑' z : ℤ × ℤ, shifted t x y z) =
      (1 / (t : ℂ) ^ (1 / 2 : ℂ)) *
        (1 / ((((3 * t) / 4 : ℝ) : ℂ)) ^ (1 / 2 : ℂ)) *
        ∑' z : ℤ × ℤ,
          RankTwoPoisson.eisGauss (4 / (3 * t)) (z.1,-z.2) *
            dualPhase z.1 z.2 x y := by
  have ha : 0 < (A t).re := by simpa [A] using ht
  have hδ := schur_eis_pos ht
  have hO := affine_original_summable ht x y
  have hM := affine_middle_summable ht x y
  have hD := affine_dual_summable ht x y
  let pref : ℂ :=
    (1 / (t : ℂ) ^ (1 / 2 : ℂ)) *
      (1 / ((((3 * t) / 4 : ℝ) : ℂ)) ^ (1 / 2 : ℂ))
  have haff :
      (∑' z : ℤ × ℤ,
        RankTwoAffine.binaryGaussian (A t) (B t) (D t) (U t x y) (V t x y) z) =
      pref * (∑' z : ℤ × ℤ,
        RankTwoAffine.dualGaussian (A t) (B t) (D t) (U t x y) (V t x y) z) := by
    have h := RankTwoAffine.affine_gaussian_poisson ha hδ hO hM hD
    rw [schur_eis ht] at h
    exact h
  calc
    (∑' z : ℤ × ℤ, shifted t x y z) =
        C t x y * (∑' z : ℤ × ℤ,
          RankTwoAffine.binaryGaussian (A t) (B t) (D t) (U t x y) (V t x y) z) := by
      rw [← tsum_mul_left]
      apply tsum_congr
      intro z
      exact shifted_eq_affine t x y z.1 z.2
    _ = C t x y * (pref * (∑' z : ℤ × ℤ,
          RankTwoAffine.dualGaussian (A t) (B t) (D t) (U t x y) (V t x y) z)) := by
      rw [haff]
    _ = pref * (∑' z : ℤ × ℤ,
          C t x y * RankTwoAffine.dualGaussian (A t) (B t) (D t)
            (U t x y) (V t x y) z) := by
      rw [tsum_mul_left]
      ring
    _ = pref * (∑' z : ℤ × ℤ,
          RankTwoPoisson.eisGauss (4 / (3 * t)) (z.1,-z.2) *
            dualPhase z.1 z.2 x y) := by
      congr 1
      apply tsum_congr
      intro z
      exact shifted_dual_term ht x y z.1 z.2

end RankTwoEisShift

namespace RankTwoLimit

section

open scoped Topology

open RankTwoPoisson RankTwoEisShift Filter

private theorem eisQ_nonneg (z : ℤ × ℤ) : 0 ≤ RankTwoPoisson.eisQ z := by
  have h := RankTwoPoisson.eisQ_lower z
  nlinarith [sq_nonneg (z.1 : ℝ), sq_nonneg (z.2 : ℝ)]

private theorem eisQ_pos {z : ℤ × ℤ} (hz : z ≠ (0,0)) :
    0 < RankTwoPoisson.eisQ z := by
  by_cases hm : z.1 = 0
  · have hn : z.2 ≠ 0 := by
      intro h0
      exact hz (Prod.ext hm h0)
    have hnR : (z.2 : ℝ) ≠ 0 := by exact_mod_cast hn
    have h := RankTwoPoisson.eisQ_lower z
    nlinarith [sq_pos_of_ne_zero hnR]
  · have hmR : (z.1 : ℝ) ≠ 0 := by exact_mod_cast hm
    have h := RankTwoPoisson.eisQ_lower z
    nlinarith [sq_pos_of_ne_zero hmR, sq_nonneg (z.2 : ℝ)]

private theorem eisGauss_norm (T : ℝ) (z : ℤ × ℤ) :
    ‖RankTwoPoisson.eisGauss T z‖ =
      Real.exp (-Real.pi * T * RankTwoPoisson.eisQ z) := by
  simp [RankTwoPoisson.eisGauss, Complex.norm_exp]

noncomputable def dualTerm (T : ℝ) (x y : ℝ) (z : ℤ × ℤ) : ℂ :=
  RankTwoPoisson.eisGauss T (z.1,-z.2) * RankTwoEisShift.dualPhase z.1 z.2 x y

noncomputable def limitTerm (z : ℤ × ℤ) : ℂ :=
  if z = (0,0) then 1 else 0

private theorem dualTerm_tendsto (x y : ℝ) (z : ℤ × ℤ) :
    Tendsto (fun T : ℝ => dualTerm T x y z) atTop (𝓝 (limitTerm z)) := by
  by_cases hz : z = (0,0)
  · subst z
    simp [dualTerm, limitTerm, RankTwoPoisson.eisGauss,
      RankTwoPoisson.eisQ, RankTwoEisShift.dualPhase]
  · have hz' : (z.1,-z.2) ≠ ((0,0) : ℤ × ℤ) := by
      intro h
      apply hz
      have h1 : z.1 = 0 := by simpa using congrArg Prod.fst h
      have h2 : z.2 = 0 := by simpa using congrArg Prod.snd h
      exact Prod.ext h1 h2
    have hq := eisQ_pos hz'
    have hneg : -Real.pi * RankTwoPoisson.eisQ (z.1,-z.2) < 0 := by
      nlinarith [mul_pos Real.pi_pos hq]
    have harg : Tendsto
        (fun T : ℝ => -Real.pi * T * RankTwoPoisson.eisQ (z.1,-z.2))
        atTop atBot := by
      convert tendsto_id.const_mul_atTop_of_neg hneg using 1
      ext T
      simp [mul_assoc, mul_comm]
    have hexp : Tendsto
        (fun T : ℝ => Real.exp (-Real.pi * T * RankTwoPoisson.eisQ (z.1,-z.2)))
        atTop (𝓝 0) := Real.tendsto_exp_atBot.comp harg
    have hc : Tendsto (fun T : ℝ => RankTwoPoisson.eisGauss T (z.1,-z.2))
        atTop (𝓝 (0 : ℂ)) := by
      have hh := Complex.continuous_ofReal.continuousAt.tendsto.comp hexp
      have heq : (fun T : ℝ =>
          ((Real.exp (-Real.pi * T * RankTwoPoisson.eisQ (z.1,-z.2)) : ℝ) : ℂ)) =
          (fun T : ℝ => RankTwoPoisson.eisGauss T (z.1,-z.2)) := by
        funext T
        simp [RankTwoPoisson.eisGauss, Complex.ofReal_exp]
      change Tendsto (fun T : ℝ =>
        ((Real.exp (-Real.pi * T * RankTwoPoisson.eisQ (z.1,-z.2)) : ℝ) : ℂ))
        atTop (𝓝 (0 : ℂ)) at hh
      rw [heq] at hh
      exact hh
    simpa [dualTerm, limitTerm, hz] using
      hc.mul_const (RankTwoEisShift.dualPhase z.1 z.2 x y)

/-- A fixed Gaussian majorant permits passage to the zero-frequency limit. -/
theorem dual_sum_tendsto_one (x y : ℝ) :
    Tendsto (fun T : ℝ => ∑' z : ℤ × ℤ, dualTerm T x y z)
      atTop (𝓝 (1 : ℂ)) := by
  let e : ℤ × ℤ ≃ ℤ × ℤ :=
    Equiv.prodCongr (Equiv.refl ℤ) (Equiv.neg ℤ)
  have hE : Summable (fun z : ℤ × ℤ =>
      RankTwoPoisson.eisGauss 1 (z.1,-z.2)) :=
    (e.summable_iff).2 (RankTwoPoisson.eis_gauss_summable (by norm_num))
  have hbound : ∀ᶠ T : ℝ in atTop, ∀ z : ℤ × ℤ,
      ‖dualTerm T x y z‖ ≤ ‖RankTwoPoisson.eisGauss 1 (z.1,-z.2)‖ := by
    filter_upwards [eventually_ge_atTop (1 : ℝ)] with T hT z
    rw [dualTerm, norm_mul, RankTwoEisShift.dualPhase_norm, mul_one,
      eisGauss_norm, eisGauss_norm]
    have hq := eisQ_nonneg (z.1,-z.2)
    have hpq : 0 ≤ Real.pi * RankTwoPoisson.eisQ (z.1,-z.2) :=
      mul_nonneg Real.pi_pos.le hq
    have hm := mul_le_mul_of_nonneg_right hT hpq
    apply Real.exp_le_exp.mpr
    nlinarith [hm]
  have h := tendsto_tsum_of_dominated_convergence hE.norm
    (dualTerm_tendsto x y) hbound
  simpa [limitTerm] using h

end

open scoped Topology
open Filter

theorem dual_sum_tendsto_one_small_t (x y : ℝ) :
    Tendsto (fun t : ℝ => ∑' z : ℤ × ℤ, dualTerm (4 / (3 * t)) x y z)
      (𝓝[>] (0 : ℝ)) (𝓝 (1 : ℂ)) := by
  have hT : Tendsto (fun t : ℝ => (4 / 3 : ℝ) * t⁻¹) (𝓝[>] (0 : ℝ)) atTop :=
    (tendsto_const_mul_atTop_of_pos (by norm_num : (0 : ℝ) < 4 / 3)).2
      tendsto_inv_nhdsGT_zero
  have h := (dual_sum_tendsto_one x y).comp hT
  simpa [Function.comp_def, div_eq_mul_inv, mul_inv_rev, mul_assoc, mul_comm, mul_left_comm] using h

end RankTwoLimit

namespace EisensteinGaussianPrefactor

theorem sqrt_product (t : ℝ) (ht : 0 ≤ t) :
    Real.sqrt t * Real.sqrt (3*t/4) =
      Real.sqrt 3 * t / 2 := by
  have h3 : Real.sqrt (3/4 : ℝ) = Real.sqrt 3 / 2 := by
    rw [Real.sqrt_div (by norm_num : (0:ℝ) ≤ 3)]
    rw [show (4:ℝ) = 2^2 by norm_num, Real.sqrt_sq (by norm_num : (0:ℝ) ≤ 2)]
  have harg : 3*t/4 = (3/4:ℝ)*t := by ring
  rw [harg, Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 3/4), h3]
  calc
    Real.sqrt t * (Real.sqrt 3 / 2 * Real.sqrt t) =
        Real.sqrt 3 / 2 * (Real.sqrt t)^2 := by ring
    _ = Real.sqrt 3 * t / 2 := by rw [Real.sq_sqrt ht]; ring

theorem eta_times_prefactor (η q : ℝ) (hη : 0 < η) (hq : 0 < q) :
    η * (1 / Real.sqrt (η*q)) *
      (1 / Real.sqrt (3*(η*q)/4)) =
      2 / (Real.sqrt 3 * q) := by
  have ht : 0 < η*q := mul_pos hη hq
  have hsqrt : Real.sqrt (η*q) * Real.sqrt (3*(η*q)/4) =
      Real.sqrt 3 * (η*q) / 2 := sqrt_product (η*q) ht.le
  have hne1 : Real.sqrt (η*q) ≠ 0 := ne_of_gt (Real.sqrt_pos.2 ht)
  have hne2 : Real.sqrt (3*(η*q)/4) ≠ 0 := by
    apply ne_of_gt
    apply Real.sqrt_pos.2
    positivity
  have hne3 : Real.sqrt 3 ≠ 0 := ne_of_gt (Real.sqrt_pos.2 (by norm_num))
  calc
    η * (1 / Real.sqrt (η*q)) *
        (1 / Real.sqrt (3*(η*q)/4)) =
        η / (Real.sqrt (η*q) * Real.sqrt (3*(η*q)/4)) := by ring
    _ = η / (Real.sqrt 3 * (η*q) / 2) := by rw [hsqrt]
    _ = 2 / (Real.sqrt 3 * q) := by
      field_simp

end EisensteinGaussianPrefactor

namespace EisensteinGaussianPrefactor

theorem complex_eta_times_prefactor (η q : ℝ) (hη : 0 < η) (hq : 0 < q) :
    (η : ℂ) *
      (1 / ((η*q : ℝ) : ℂ) ^ (1/2 : ℂ)) *
      (1 / (((3*(η*q)/4 : ℝ) : ℂ) ^ (1/2 : ℂ))) =
      ((2 / (Real.sqrt 3 * q) : ℝ) : ℂ) := by
  have ht : 0 ≤ η*q := (mul_pos hη hq).le
  have hs : 0 ≤ 3*(η*q)/4 := by positivity
  have hpow1 : ((η*q : ℝ) : ℂ) ^ (1/2 : ℂ) =
      (Real.sqrt (η*q) : ℂ) := by
    calc
      ((η*q : ℝ) : ℂ) ^ (1/2 : ℂ) =
          ((η*q : ℝ) : ℂ) ^ (((1/2 : ℝ) : ℂ)) := by norm_num
      _ = (((η*q) ^ (1/2 : ℝ) : ℝ) : ℂ) :=
        (Complex.ofReal_cpow ht (1/2 : ℝ)).symm
      _ = (Real.sqrt (η*q) : ℂ) := by rw [← Real.sqrt_eq_rpow]
  have hpow2 : (((3*(η*q)/4 : ℝ) : ℂ) ^ (1/2 : ℂ)) =
      (Real.sqrt (3*(η*q)/4) : ℂ) := by
    calc
      (((3*(η*q)/4 : ℝ) : ℂ) ^ (1/2 : ℂ)) =
          (((3*(η*q)/4 : ℝ) : ℂ) ^ (((1/2 : ℝ) : ℂ))) := by norm_num
      _ = (((3*(η*q)/4) ^ (1/2 : ℝ) : ℝ) : ℂ) :=
        (Complex.ofReal_cpow hs (1/2 : ℝ)).symm
      _ = (Real.sqrt (3*(η*q)/4) : ℂ) := by rw [← Real.sqrt_eq_rpow]
  rw [hpow1, hpow2]
  exact_mod_cast eta_times_prefactor η q hη hq

end EisensteinGaussianPrefactor

namespace EisensteinAbelFiber

open scoped Topology
open Filter

/-- Every real lattice shift has Abel mass equal to the reciprocal covolume. -/
theorem shifted_gaussian_mass (x y : ℝ) :
    Tendsto (fun t : ℝ => (t : ℂ) *
      (∑' z : ℤ × ℤ, RankTwoEisShift.shifted t x y z))
      (𝓝[>] (0 : ℝ)) (𝓝 (((2 / Real.sqrt 3 : ℝ) : ℂ))) := by
  have hpoint (t : ℝ) (ht : 0 < t) :
      (t : ℂ) * (∑' z : ℤ × ℤ, RankTwoEisShift.shifted t x y z) =
        ((2 / Real.sqrt 3 : ℝ) : ℂ) *
          (∑' z : ℤ × ℤ, RankTwoLimit.dualTerm (4 / (3 * t)) x y z) := by
    rw [RankTwoEisShift.shifted_eisenstein_gaussian_poisson ht x y]
    have hpre := EisensteinGaussianPrefactor.complex_eta_times_prefactor
      t 1 ht (by norm_num)
    simp only [mul_one] at hpre
    change (t : ℂ) *
        ((1 / (t : ℂ) ^ (1 / 2 : ℂ)) *
          (1 / (((3 * t / 4 : ℝ) : ℂ) ^ (1 / 2 : ℂ))) *
          (∑' z : ℤ × ℤ,
            RankTwoLimit.dualTerm (4 / (3 * t)) x y z)) = _
    calc
      (t : ℂ) * ((1 / (t : ℂ) ^ (1 / 2 : ℂ)) *
          (1 / (((3 * t / 4 : ℝ) : ℂ) ^ (1 / 2 : ℂ))) *
          (∑' z : ℤ × ℤ,
            RankTwoLimit.dualTerm (4 / (3 * t)) x y z)) =
        (((t : ℂ) * (1 / (t : ℂ) ^ (1 / 2 : ℂ))) *
          (1 / (((3 * t / 4 : ℝ) : ℂ) ^ (1 / 2 : ℂ)))) *
          (∑' z : ℤ × ℤ,
            RankTwoLimit.dualTerm (4 / (3 * t)) x y z) := by ring
      _ = _ := by rw [hpre]
  have hlim := (RankTwoLimit.dual_sum_tendsto_one_small_t x y).const_mul
    (((2 / Real.sqrt 3 : ℝ) : ℂ))
  have heq : (fun t : ℝ => (t : ℂ) *
      (∑' z : ℤ × ℤ, RankTwoEisShift.shifted t x y z)) =ᶠ[𝓝[>] (0 : ℝ)]
      (fun t : ℝ => ((2 / Real.sqrt 3 : ℝ) : ℂ) *
        (∑' z : ℤ × ℤ, RankTwoLimit.dualTerm (4 / (3 * t)) x y z)) := by
    filter_upwards [self_mem_nhdsWithin] with t ht
    exact hpoint t ht
  simpa using hlim.congr' heq.symm

theorem scaled_shifted_gaussian_mass (q : ℝ) (hq : 0 < q)
    (x y : ℝ) :
    Tendsto (fun η : ℝ => (η : ℂ) *
      (∑' z : ℤ × ℤ, RankTwoEisShift.shifted (η*q) x y z))
      (𝓝[>] (0 : ℝ))
      (𝓝 (((2 / (Real.sqrt 3 * q) : ℝ) : ℂ))) := by
  have hscale : Tendsto (fun η : ℝ => η*q)
      (𝓝[>] (0 : ℝ)) (𝓝[>] (0 : ℝ)) := by
    apply tendsto_nhdsWithin_iff.mpr
    constructor
    · have hid : Tendsto (fun η : ℝ => η)
          (𝓝[>] (0 : ℝ)) (𝓝 (0 : ℝ)) :=
        tendsto_id.mono_right nhdsWithin_le_nhds
      simpa using hid.mul_const q
    · filter_upwards [self_mem_nhdsWithin] with η hη
      exact mul_pos hη hq
  have hlim := (shifted_gaussian_mass x y).comp hscale
  have hqC : (q : ℂ) ≠ 0 := by exact_mod_cast ne_of_gt hq
  have hlim' := hlim.const_mul (1 / (q : ℂ))
  convert hlim' using 1
  · funext η
    dsimp
    push_cast
    field_simp [hqC]
  · push_cast
    field_simp [hqC]

end EisensteinAbelFiber

end QuadraticPhase


open scoped BigOperators
namespace QuadraticPhase.Eisenstein
open Coordinates

/-- Dividing by a principal modulus gives the alternating coordinate pairing over its norm. -/
theorem trace_fraction_coordinates (a b x y : ℤ) (hc : eval a b ≠ 0) :
    Algebra.trace ℚ K
      (algebraMap O K (eval x y) /
        (algebraMap O K traceLambda * algebraMap O K (eval a b))) =
      ((a*y-b*x : ℤ) : ℚ) / ((a*a-a*b+b*b : ℤ) : ℚ) := by
  have hcK : algebraMap O K (eval a b) ≠ 0 :=
    fun h => hc (NumberField.RingOfIntegers.coe_injective h)
  have hnorm : algebraMap O K (eval a b) * algebraMap O K (conjO (eval a b)) =
      ((a*a-a*b+b*b : ℤ) : K) := by
    have h := congrArg (algebraMap O K) (eval_mul_conj a b)
    simpa only [map_mul, map_intCast, pow_two] using h
  have hnum : algebraMap O K (eval x y) * algebraMap O K (conjO (eval a b)) =
      ((x*(a-b)+y*b : ℤ) : K) + ((a*y-b*x : ℤ) : K) * algebraMap O K omega := by
    rw [← map_mul, conj_eval, eval_mul]
    simp only [eval, map_add, map_mul, map_intCast]
    push_cast
    ring
  have hquot : algebraMap O K (eval x y) / algebraMap O K (eval a b) =
      ((((x*(a-b)+y*b : ℤ) : ℚ) / ((a*a-a*b+b*b : ℤ) : ℚ)) : K) +
      ((((a*y-b*x : ℤ) : ℚ) / ((a*a-a*b+b*b : ℤ) : ℚ)) : K) * algebraMap O K omega := by
    calc
      _ = (algebraMap O K (eval x y) * algebraMap O K (conjO (eval a b))) /
          ((a*a-a*b+b*b : ℤ) : K) := by
        rw [← hnorm]
        have hconj : algebraMap O K (conjO (eval a b)) ≠ 0 := by
          intro h
          apply hc
          apply conjO.injective
          simpa only [map_zero] using NumberField.RingOfIntegers.coe_injective h
        field_simp [hcK, hconj]
      _ = _ := by rw [hnum]; push_cast; ring
  have harg : algebraMap O K (eval x y) /
      (algebraMap O K traceLambda * algebraMap O K (eval a b)) =
      (algebraMap O K (eval x y) / algebraMap O K (eval a b)) /
        algebraMap O K traceLambda := by
    simp only [div_eq_mul_inv, mul_inv_rev]
    ring
  rw [harg, hquot]
  convert trace_div_traceLambda
    (((x*(a-b)+y*b : ℤ) : ℚ) / ((a*a-a*b+b*b : ℤ) : ℚ))
    (((a*y-b*x : ℤ) : ℚ) / ((a*a-a*b+b*b : ℤ) : ℚ)) using 1
  push_cast
  rfl

/-- The analytic trace character in integral coordinates. -/
theorem principalTraceChar_eval (a b x y : ℤ) (hc : eval a b ≠ 0) :
    principalTraceChar (eval a b) hc (Ideal.Quotient.mk (Ideal.span {eval a b}) (eval x y)) =
      Complex.exp (2 * Real.pi * Complex.I *
        (((a*y-b*x : ℤ) : ℂ) / ((a*a-a*b+b*b : ℤ) : ℂ))) := by
  rw [principalTraceChar_apply, trace_fraction_coordinates a b x y hc]
  congr 1
  push_cast
  ring

/-- Squaring the residue argument gives the oscillatory binary phase. -/
theorem principalTraceChar_square (a b x y : ℤ) (hc : eval a b ≠ 0) :
    principalTraceChar (eval a b) hc
      (Ideal.Quotient.mk (Ideal.span {eval a b}) (eval x y) ^ 2) =
      Complex.exp (2 * Real.pi * Complex.I *
        (((-b*x*x+2*a*x*y+(b-a)*y*y : ℤ) : ℂ) /
          ((a*a-a*b+b*b : ℤ) : ℂ))) := by
  rw [← map_pow, pow_two, eval_mul, principalTraceChar_eval]
  congr 1
  push_cast
  ring

/-- The quadratic trace sum on the actual principal quotient. -/
def quadraticTraceGauss (c : O) (hc : c ≠ 0) : ℂ := by
  letI : Finite (O ⧸ Ideal.span {c}) :=
    (Ideal.span {c}).finiteQuotientOfFreeOfNeBot
      (fun h => hc (Ideal.span_singleton_eq_bot.mp h))
  letI : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
  exact ∑ x : O ⧸ Ideal.span {c}, principalTraceChar c hc (x ^ 2)

/-- Divide the quadratic trace sum by the complex modulus of the generator. -/
def normalizedQuadraticTraceGauss (c : O) (hc : c ≠ 0) : ℂ :=
  quadraticTraceGauss c hc / (‖ringComplex c‖ : ℂ)

/-- The fixed dual phase is an actual quadratic residue phase modulo four. -/
def fixedDualPhase (c y : O) : ℂ :=
  principalTraceChar 4 (by norm_num) (Ideal.Quotient.mk (Ideal.span {(4 : O)}) (-(c*y^2)))

/-- A shift by two changes the squared numerator by a multiple of four. -/
theorem fixedDualPhase_period_two (c y w : O) :
    fixedDualPhase c (y + 2*w) = fixedDualPhase c y := by
  apply congrArg (principalTraceChar 4 (by norm_num))
  apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr
  apply Ideal.mem_span_singleton.mpr
  refine ⟨-(c * (y*w+w^2)), ?_⟩
  ring

theorem fixedDualPhase_eq_of_mod_two (c y z : O)
    (h : Ideal.Quotient.mk (Ideal.span {(2 : O)}) y =
      Ideal.Quotient.mk (Ideal.span {(2 : O)}) z) :
    fixedDualPhase c y = fixedDualPhase c z := by
  have hsub : y-z ∈ Ideal.span {(2 : O)} :=
    (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp h
  obtain ⟨w, hw⟩ := Ideal.mem_span_singleton.mp hsub
  have hy : y = z + 2*w := by
    calc
      y = z+(y-z) := by ring
      _ = z+2*w := by rw [hw]
  rw [hy, fixedDualPhase_period_two]

/-- At modulus four, the analytic character is the fourth root prescribed by the second coordinate. -/
theorem principalTraceChar_four (x y : ℤ) :
    principalTraceChar 4 (by norm_num)
      (Ideal.Quotient.mk (Ideal.span {(4 : O)}) (eval x y)) = Complex.I ^ y := by
  have h4 : eval 4 0 = 4 := by norm_num [eval]
  have ht := trace_fraction_coordinates 4 0 x y (by rw [h4]; norm_num)
  rw [h4] at ht
  rw [principalTraceChar_apply, ht]
  calc
    _ = Complex.exp ((y : ℂ) * ((Real.pi : ℂ) / 2 * Complex.I)) := by
      congr 1
      push_cast
      ring
    _ = Complex.I ^ y := by
      rw [Complex.exp_int_mul, Complex.exp_pi_div_two_mul_I]

private theorem neg_eval (a b : ℤ) : -eval a b = eval (-a) (-b) := by
  simp only [eval, Int.cast_neg]
  ring

/-- The fixed dual phase is a fourth root of unity with an explicit integral exponent. -/
theorem fixedDualPhase_eval (a b x y : ℤ) :
    fixedDualPhase (eval a b) (eval x y) =
      Complex.I ^ (-(b*x*x + 2*(a-b)*x*y - a*y*y)) := by
  unfold fixedDualPhase
  rw [pow_two, eval_mul, eval_mul, neg_eval, principalTraceChar_four]
  congr 1
  ring

/-- The fixed phase has unit modulus. -/
theorem fixedDualPhase_norm (c y : O) : ‖fixedDualPhase c y‖ = 1 := by
  obtain ⟨a,b,rfl⟩ := exists_coordinates c
  obtain ⟨x,y,rfl⟩ := exists_coordinates y
  change ‖fixedDualPhase (eval a b) (eval x y)‖ = 1
  rw [fixedDualPhase_eval, norm_zpow, Complex.norm_I, one_zpow]

/-- The four residue phases, with the normalization from the rank-two Gaussian transform. -/
def fixedDualAverage (c : O) : ℂ := by
  letI : Finite (O ⧸ Ideal.span {(2 : O)}) :=
    (Ideal.span {(2 : O)}).finiteQuotientOfFreeOfNeBot
      (fun h => (by norm_num : (2 : O) ≠ 0) (Ideal.span_singleton_eq_bot.mp h))
  letI : Fintype (O ⧸ Ideal.span {(2 : O)}) := Fintype.ofFinite _
  exact (∑ r : O ⧸ Ideal.span {(2 : O)},
    fixedDualPhase c (Classical.choose (Ideal.Quotient.mk_surjective r))) / 2

private theorem sum_zmod_two_square (f : ZMod 2 × ZMod 2 → ℂ) :
    (∑ p : ZMod 2 × ZMod 2, f p) =
      f (0,0) + f (0,1) + f (1,0) + f (1,1) := by
  rw [Fintype.sum_prod_type]
  have hu : (Finset.univ : Finset (ZMod 2)) = {0,1} := rfl
  simp [hu]
  ring

/-- The dual residue average depends only on the modulus coordinates modulo four. -/
theorem fixedDualAverage_formula (a b : ℤ) :
    fixedDualAverage (eval a b) =
      (1 + Complex.I ^ (-b) + Complex.I ^ a + Complex.I ^ (b-a)) / 2 := by
  letI : Finite (O ⧸ Ideal.span {(2 : O)}) :=
    (Ideal.span {(2 : O)}).finiteQuotientOfFreeOfNeBot
      (fun h => (by norm_num : (2 : O) ≠ 0) (Ideal.span_singleton_eq_bot.mp h))
  letI : Fintype (O ⧸ Ideal.span {(2 : O)}) := Fintype.ofFinite _
  let e := rationalCoordEquiv 2 (by norm_num)
  let P : O ⧸ Ideal.span {(2 : O)} → ℂ := fun r =>
    fixedDualPhase (eval a b) (Classical.choose (Ideal.Quotient.mk_surjective r))
  have hpoint (p : ZMod 2 × ZMod 2) : P (e p) =
      fixedDualPhase (eval a b) (eval (ZMod.cast p.1) (ZMod.cast p.2)) := by
    apply fixedDualPhase_eq_of_mod_two
    exact (Classical.choose_spec (Ideal.Quotient.mk_surjective (e p))).trans (by rfl)
  have hsum : (∑ r, P r) = ∑ p : ZMod 2 × ZMod 2,
      fixedDualPhase (eval a b) (eval (ZMod.cast p.1) (ZMod.cast p.2)) := by
    calc
      _ = ∑ p, P (e p) := (e.sum_comp P).symm
      _ = _ := Finset.sum_congr rfl (fun p _ => hpoint p)
  change (∑ r, P r) / 2 = _
  rw [hsum, sum_zmod_two_square]
  have hcast1 : (ZMod.cast (1 : ZMod 2) : ℤ) = 1 := by decide
  simp only [ZMod.cast_zero, hcast1, fixedDualPhase_eval,
    mul_zero, mul_one, add_zero, sub_zero, neg_zero, zero_sub, zpow_zero, neg_neg]
  rw [show -(b + 2 * (a-b) - a) = b-a by ring]
  ring

theorem fixedDualPhase_eq_of_mod_four (c d y : O)
    (h : Ideal.Quotient.mk (Ideal.span {(4 : O)}) c =
      Ideal.Quotient.mk (Ideal.span {(4 : O)}) d) :
    fixedDualPhase c y = fixedDualPhase d y := by
  simp only [fixedDualPhase, map_neg, map_mul, h]

/-- The complete dual average factors through reduction of the modulus modulo four. -/
theorem fixedDualAverage_eq_of_mod_four (c d : O)
    (h : Ideal.Quotient.mk (Ideal.span {(4 : O)}) c =
      Ideal.Quotient.mk (Ideal.span {(4 : O)}) d) :
    fixedDualAverage c = fixedDualAverage d := by
  unfold fixedDualAverage
  congr 1
  exact Finset.sum_congr rfl (fun r _ => fixedDualPhase_eq_of_mod_four c d _ h)

theorem fixedDualAverage_one : fixedDualAverage 1 = 1 := by
  have h := fixedDualAverage_formula 1 0
  norm_num [eval] at h
  exact h

/-- The principal residue class modulo four has trivial dual Gauss phase. -/
theorem fixedDualAverage_eq_one (c : O)
    (h : Ideal.Quotient.mk (Ideal.span {(4 : O)}) c = 1) :
    fixedDualAverage c = 1 := by
  rw [fixedDualAverage_eq_of_mod_four c 1 (by simpa only [map_one] using h),
    fixedDualAverage_one]

end QuadraticPhase.Eisenstein


open scoped BigOperators Topology
open Filter Asymptotics MeasureTheory
namespace QuadraticPhase

namespace EisensteinFiberShift

def Q (x y : ℝ) : ℝ := x*x-x*y+y*y
def q (a b : ℝ) : ℝ := Q a b
noncomputable def shiftX (a b x y : ℝ) : ℝ := ((a-b)*x+b*y)/q a b
noncomputable def shiftY (a b x y : ℝ) : ℝ := (-b*x+a*y)/q a b

theorem exact_shift (a b x y m n : ℝ) (hq : q a b ≠ 0) :
    Q (x+a*m-b*n) (y+b*m+(a-b)*n) =
      q a b * Q (m+shiftX a b x y) (n+shiftY a b x y) := by
  dsimp [shiftX, shiftY, Q]
  field_simp [hq]
  dsimp [q, Q]
  ring

end EisensteinFiberShift

namespace GaussianAbelPartition

theorem tsum_by_finite_fibers {A B : Type*} [Fintype B]
    (q : A → B) (f : A → ℂ) (hf : Summable f) :
    (∑' a : A, f a) =
      ∑ b : B, ∑' a : (q ⁻¹' {b}), f a.1 := by
  have h := (hf.hasSum.tsum_fiberwise q).tsum_eq
  simpa only [tsum_fintype] using h.symm

theorem tsum_periodic_weighted_partition {A B : Type*} [Fintype B]
    (q : A → B) (P : B → ℂ) (W : A → ℂ)
    (hf : Summable (fun a => P (q a) * W a)) :
    (∑' a : A, P (q a) * W a) =
      ∑ b : B, P b * ∑' a : (q ⁻¹' {b}), W a.1 := by
  rw [tsum_by_finite_fibers q _ hf]
  apply Finset.sum_congr rfl
  intro b hb
  calc
    (∑' a : (q ⁻¹' {b}), P (q a.1) * W a.1) =
        ∑' a : (q ⁻¹' {b}), P b * W a.1 := by
      apply tsum_congr
      intro a
      have ha : q a.1 = b := by
        simpa only [Set.mem_preimage, Set.mem_singleton_iff] using a.property
      rw [ha]
    _ = P b * ∑' a : (q ⁻¹' {b}), W a.1 := tsum_mul_left

end GaussianAbelPartition

namespace Eisenstein

private theorem finite_quotient_span {c : O} (hc : c ≠ 0) :
    Finite (O ⧸ Ideal.span {c}) :=
  (Ideal.span {c}).finiteQuotientOfFreeOfNeBot
    (fun h => hc (Ideal.span_singleton_eq_bot.mp h))

private theorem complex_norm_coordinates_sq (a b : ℤ) :
    ‖ringComplex (Coordinates.eval a b)‖ ^ 2 = ((a*a-a*b+b*b : ℤ) : ℝ) := by
  simpa only [Int.cast_add, Int.cast_sub, Int.cast_mul, pow_two] using
    Coordinates.complex_norm_eval_sq a b

private theorem coordinate_norm_pos_of_nonzero (a b : ℤ)
    (hc : Coordinates.eval a b ≠ 0) : 0 < a*a-a*b+b*b := by
  simpa only [pow_two] using Coordinates.coordinate_norm_pos a b hc

theorem actual_quadratic_gaussian_partition (c : O) (hc : c ≠ 0)
    (W : O → ℂ)
    (hsum : Summable (fun z : O =>
      (principalTraceChar c hc)
        ((Ideal.Quotient.mk (Ideal.span {c}) z) ^ 2) * W z)) :
    letI : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
    letI : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
    (∑' z : O,
      (principalTraceChar c hc)
        ((Ideal.Quotient.mk (Ideal.span {c}) z) ^ 2) * W z) =
      ∑ r : O ⧸ Ideal.span {c},
        (principalTraceChar c hc)
          (r ^ 2) *
          ∑' z : ((Ideal.Quotient.mk (Ideal.span {c})) ⁻¹' {r}), W z.1 := by
  let : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
  let : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
  exact GaussianAbelPartition.tsum_periodic_weighted_partition
    (Ideal.Quotient.mk (Ideal.span {c}))
    (fun r => (principalTraceChar c hc)
      (r ^ 2)) W hsum

namespace GaussianFiberEquiv


def fiberMap (c : O) (r : O ⧸ Ideal.span {c})
    (r0 : O) (hr : Ideal.Quotient.mk (Ideal.span {c}) r0 = r)
    (w : O) : ((Ideal.Quotient.mk (Ideal.span {c})) ⁻¹' {r}) := by
  refine ⟨r0 + c*w, ?_⟩
  change Ideal.Quotient.mk (Ideal.span {c}) (r0 + c*w) = r
  rw [map_add, map_mul]
  have hc0 : Ideal.Quotient.mk (Ideal.span {c}) c = 0 :=
    (Ideal.Quotient.eq_zero_iff_mem).mpr (Ideal.subset_span (Set.mem_singleton c))
  rw [hc0, zero_mul, add_zero, hr]

private theorem fiberMap_injective (c : O) (hc : c ≠ 0)
    (r : O ⧸ Ideal.span {c}) (r0 : O)
    (hr : Ideal.Quotient.mk (Ideal.span {c}) r0 = r) :
    Function.Injective (fiberMap c r r0 hr) := by
  intro u v h
  have hval := congrArg Subtype.val h
  change r0 + c*u = r0 + c*v at hval
  exact mul_left_cancel₀ hc (add_left_cancel hval)

private theorem fiberMap_surjective (c : O)
    (r : O ⧸ Ideal.span {c}) (r0 : O)
    (hr : Ideal.Quotient.mk (Ideal.span {c}) r0 = r) :
    Function.Surjective (fiberMap c r r0 hr) := by
  rintro ⟨z, hz⟩
  have hz' : Ideal.Quotient.mk (Ideal.span {c}) z = r := by
    simpa only [Set.mem_preimage, Set.mem_singleton_iff] using hz
  have hdiff : z-r0 ∈ Ideal.span {c} :=
    (Ideal.Quotient.mk_eq_mk_iff_sub_mem z r0).mp (hz'.trans hr.symm)
  obtain ⟨w, hw⟩ := (Ideal.mem_span_singleton).mp hdiff
  refine ⟨w, ?_⟩
  apply Subtype.ext
  change r0 + c*w = z
  rw [← hw]
  ring

noncomputable def fiberEquiv (c : O) (hc : c ≠ 0)
    (r : O ⧸ Ideal.span {c}) (r0 : O)
    (hr : Ideal.Quotient.mk (Ideal.span {c}) r0 = r) :
    O ≃ ((Ideal.Quotient.mk (Ideal.span {c})) ⁻¹' {r}) :=
  Equiv.ofBijective (fiberMap c r r0 hr)
    ⟨fiberMap_injective c hc r r0 hr, fiberMap_surjective c r r0 hr⟩

theorem fiber_tsum (c : O) (hc : c ≠ 0)
    (r : O ⧸ Ideal.span {c}) (r0 : O)
    (hr : Ideal.Quotient.mk (Ideal.span {c}) r0 = r)
    (W : O → ℂ) :
    (∑' z : ((Ideal.Quotient.mk (Ideal.span {c})) ⁻¹' {r}), W z.1) =
      ∑' w : O, W (r0 + c*w) := by
  have h := (fiberEquiv c hc r r0 hr).tsum_eq (fun z => W z.1)
  have happ (w : O) : ((fiberEquiv c hc r r0 hr) w).1 = r0 + c*w := rfl
  simpa only [happ] using h.symm

end GaussianFiberEquiv

namespace GaussianShiftedPartition


noncomputable def representative (c : O) (r : O ⧸ Ideal.span {c}) : O :=
  Classical.choose (Ideal.Quotient.mk_surjective r)

theorem representative_spec (c : O) (r : O ⧸ Ideal.span {c}) :
    Ideal.Quotient.mk (Ideal.span {c}) (representative c r) = r :=
  Classical.choose_spec (Ideal.Quotient.mk_surjective r)

theorem actual_quadratic_shifted_partition (c : O) (hc : c ≠ 0)
    (W : O → ℂ)
    (hsum : Summable (fun z : O =>
      (principalTraceChar c hc)
        ((Ideal.Quotient.mk (Ideal.span {c}) z) ^ 2) * W z)) :
    letI : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
    letI : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
    (∑' z : O,
      (principalTraceChar c hc)
        ((Ideal.Quotient.mk (Ideal.span {c}) z) ^ 2) * W z) =
      ∑ r : O ⧸ Ideal.span {c},
        (principalTraceChar c hc)
          (r ^ 2) *
          ∑' w : O, W (representative c r + c*w) := by
  let : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
  let : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
  rw [actual_quadratic_gaussian_partition c hc W hsum]
  apply Finset.sum_congr rfl
  intro r hr
  congr 1
  exact GaussianFiberEquiv.fiber_tsum c hc r
    (representative c r) (representative_spec c r) W

end GaussianShiftedPartition

theorem fiber_coordinates (a b x y m n : ℤ) :
    Coordinates.eval x y +
      Coordinates.eval a b *
        Coordinates.eval m n =
    Coordinates.eval (x + a*m-b*n)
      (y+b*m+(a-b)*n) := by
  rw [Coordinates.eval_mul]
  simp only [Coordinates.eval]
  push_cast
  ring

theorem fiber_quadratic_expansion (a b x y m n : ℤ) :
    let q := a*a-a*b+b*b
    let X := x+a*m-b*n
    let Y := y+b*m+(a-b)*n
    X*X-X*Y+Y*Y =
      q*(m*m-m*n+n*n) +
      ((2*a-b)*x+(2*b-a)*y)*m +
      (-(a+b)*x+(2*a-b)*y)*n +
      (x*x-x*y+y*y) := by
  dsimp
  ring

theorem ringComplex_fiber_norm_sq (a b x y m n : ℤ) :
    ‖ringComplex
      (Coordinates.eval x y +
        Coordinates.eval a b *
          Coordinates.eval m n)‖ ^ 2 =
      ((a*a-a*b+b*b)*(m*m-m*n+n*n) +
      ((2*a-b)*x+(2*b-a)*y)*m +
      (-(a+b)*x+(2*a-b)*y)*n +
      (x*x-x*y+y*y) : ℤ) := by
  rw [fiber_coordinates, complex_norm_coordinates_sq]
  exact_mod_cast fiber_quadratic_expansion a b x y m n

theorem actual_fiber_gaussian_eq_shifted
    (a b x y m n : ℤ)
    (hc : Coordinates.eval a b ≠ 0) (η : ℝ) :
    Complex.exp (-(Real.pi : ℂ) * (η : ℂ) *
      (‖ringComplex
        (Coordinates.eval x y +
          Coordinates.eval a b *
            Coordinates.eval m n)‖ ^ 2 : ℂ)) =
      RankTwoEisShift.shifted
        (η * ((a*a-a*b+b*b : ℤ) : ℝ))
        (EisensteinFiberShift.shiftX (a : ℝ) (b : ℝ) (x : ℝ) (y : ℝ))
        (EisensteinFiberShift.shiftY (a : ℝ) (b : ℝ) (x : ℝ) (y : ℝ))
        (m,n) := by
  have hqZ : a*a-a*b+b*b ≠ 0 :=
    ne_of_gt (coordinate_norm_pos_of_nonzero a b hc)
  have hqR : EisensteinFiberShift.q (a : ℝ) (b : ℝ) ≠ 0 := by
    dsimp [EisensteinFiberShift.q, EisensteinFiberShift.Q]
    exact_mod_cast hqZ
  have hshift := EisensteinFiberShift.exact_shift
    (a : ℝ) (b : ℝ) (x : ℝ) (y : ℝ) (m : ℝ) (n : ℝ) hqR
  have hnormC : ((‖ringComplex
      (Coordinates.eval x y +
        Coordinates.eval a b *
          Coordinates.eval m n)‖ : ℂ)^2) =
      (((a*a-a*b+b*b)*(m*m-m*n+n*n) +
        ((2*a-b)*x+(2*b-a)*y)*m +
        (-(a+b)*x+(2*a-b)*y)*n +
        (x*x-x*y+y*y) : ℤ) : ℂ) := by
    exact_mod_cast ringComplex_fiber_norm_sq a b x y m n
  rw [hnormC]
  dsimp [RankTwoEisShift.shifted, RankTwoEisShift.Q]
  congr 1
  dsimp [EisensteinFiberShift.Q, EisensteinFiberShift.q] at hshift
  have hshiftC := congrArg (fun v : ℝ => (v : ℂ)) hshift
  push_cast at hshiftC ⊢
  linear_combination -(Real.pi : ℂ) * (η : ℂ) * hshiftC

/-- Every principal residue class has the same Gaussian mass after Abel normalization. -/
theorem actual_fiber_gaussian_mass (a b x y : ℤ)
    (hc : Coordinates.eval a b ≠ 0) :
    Tendsto (fun η : ℝ => (η : ℂ) *
      (∑' z : ℤ × ℤ,
        Complex.exp (-(Real.pi : ℂ) * (η : ℂ) *
          (‖ringComplex
            (Coordinates.eval x y +
              Coordinates.eval a b *
                Coordinates.eval z.1 z.2)‖ ^ 2 : ℂ))))
      (𝓝[>] (0 : ℝ))
      (𝓝 (((2 / (Real.sqrt 3 *
        (((a*a-a*b+b*b : ℤ) : ℝ))) : ℝ) : ℂ))) := by
  have hq : 0 < (((a*a-a*b+b*b : ℤ) : ℝ)) := by
    exact_mod_cast coordinate_norm_pos_of_nonzero a b hc
  let u := EisensteinFiberShift.shiftX (a : ℝ) (b : ℝ) (x : ℝ) (y : ℝ)
  let v := EisensteinFiberShift.shiftY (a : ℝ) (b : ℝ) (x : ℝ) (y : ℝ)
  have h := EisensteinAbelFiber.scaled_shifted_gaussian_mass
    (((a*a-a*b+b*b : ℤ) : ℝ)) hq u v
  convert h using 1
  funext η
  congr 1
  apply tsum_congr
  intro z
  exact actual_fiber_gaussian_eq_shifted a b x y z.1 z.2 hc η

theorem eis_gaussian_summable {η : ℝ} (hη : 0 < η) :
    Summable (fun z : O => Complex.exp (-(Real.pi : ℂ) * (η : ℂ) *
      (‖ringComplex z‖ ^ 2 : ℂ))) := by
  have hbase := RankTwoPoisson.eis_gauss_summable hη
  have hcomp : Summable (fun z : O =>
      RankTwoPoisson.eisGauss η (Coordinates.coordinateEquiv z)) :=
    (Coordinates.coordinateEquiv.summable_iff).2 hbase
  convert hcomp using 1
  funext z
  let p := Coordinates.coords z
  have hz : z = Coordinates.eval p.1 p.2 :=
    (Coordinates.eval_coords z).symm
  rw [hz]
  have hnormC : ((‖ringComplex
      (Coordinates.eval p.1 p.2)‖ : ℂ)^2) =
      ((p.1*p.1-p.1*p.2+p.2*p.2 : ℤ) : ℂ) := by
    exact_mod_cast complex_norm_coordinates_sq p.1 p.2
  rw [hnormC]
  change _ = RankTwoPoisson.eisGauss η
    (Coordinates.coords
      (Coordinates.eval p.1 p.2))
  rw [Coordinates.coords_eval]
  dsimp [RankTwoPoisson.eisGauss, RankTwoPoisson.eisQ]
  congr 1
  push_cast
  ring

theorem actual_oscillatory_kernel_summable (c : O) (hc : c ≠ 0)
    {η : ℝ} (hη : 0 < η) :
    Summable (fun z : O =>
      (principalTraceChar c hc)
          (Ideal.Quotient.mk (Ideal.span {c}) z ^ 2) *
      Complex.exp (-(Real.pi : ℂ) * (η : ℂ) *
        (‖ringComplex z‖ ^ 2 : ℂ))) := by
  let : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
  have hbase := (eis_gaussian_summable hη).norm
  apply hbase.of_norm_bounded
  intro z
  simp only [norm_mul]
  rw [AddChar.norm_apply]
  simp

theorem actual_O_fiber_gaussian_mass (c r : O) (hc : c ≠ 0) :
    let a := (Coordinates.coords c).1
    let b := (Coordinates.coords c).2
    Tendsto (fun η : ℝ => (η : ℂ) *
      (∑' w : O, Complex.exp (-(Real.pi : ℂ) * (η : ℂ) *
        (‖ringComplex (r+c*w)‖ ^ 2 : ℂ))))
      (𝓝[>] (0 : ℝ))
      (𝓝 (((2 / (Real.sqrt 3 *
        (((a*a-a*b+b*b : ℤ) : ℝ))) : ℝ) : ℂ))) := by
  dsimp only
  let a := (Coordinates.coords c).1
  let b := (Coordinates.coords c).2
  let x := (Coordinates.coords r).1
  let y := (Coordinates.coords r).2
  have hceq : c = Coordinates.eval a b :=
    (Coordinates.eval_coords c).symm
  have hreq : r = Coordinates.eval x y :=
    (Coordinates.eval_coords r).symm
  have hcE : Coordinates.eval a b ≠ 0 := by
    rw [← hceq]
    exact hc
  have hmass := actual_fiber_gaussian_mass a b x y hcE
  convert hmass using 1
  funext η
  congr 1
  let W : O → ℂ := fun w => Complex.exp (-(Real.pi : ℂ) * (η : ℂ) *
    (‖ringComplex (r+c*w)‖ ^ 2 : ℂ))
  have hsum := (Coordinates.coordinateEquiv.symm.tsum_eq W).symm
  have happly (z : ℤ × ℤ) : Coordinates.coordinateEquiv.symm z =
      Coordinates.eval z.1 z.2 := rfl
  simpa only [W, hceq, hreq, happly] using hsum

/-- The Abel limit of the damped quadratic phase is the finite trace Gauss sum times lattice density. -/
theorem original_abel_gauss_limit (c : O) (hc : c ≠ 0) :
    letI : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
    letI : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
    let a := (Coordinates.coords c).1
    let b := (Coordinates.coords c).2
    let K : ℂ := ((2 / (Real.sqrt 3 *
      (((a*a-a*b+b*b : ℤ) : ℝ))) : ℝ) : ℂ)
    Tendsto (fun η : ℝ => (η : ℂ) *
      (∑' z : O,
        (principalTraceChar c hc)
          (Ideal.Quotient.mk (Ideal.span {c}) z ^ 2) *
        Complex.exp (-(Real.pi : ℂ) * (η : ℂ) *
          (‖ringComplex z‖ ^ 2 : ℂ))))
      (𝓝[>] (0 : ℝ))
      (𝓝 (K * ∑ r : O ⧸ Ideal.span {c},
        (principalTraceChar c hc) (r ^ 2))) := by
  let : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
  let : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
  let a := (Coordinates.coords c).1
  let b := (Coordinates.coords c).2
  let K : ℂ := ((2 / (Real.sqrt 3 *
    (((a*a-a*b+b*b : ℤ) : ℝ))) : ℝ) : ℂ)
  let ψ := principalTraceChar c hc
  let W (η : ℝ) (z : O) := Complex.exp (-(Real.pi : ℂ) * (η : ℂ) *
    (‖ringComplex z‖ ^ 2 : ℂ))
  have hfiber (r : O ⧸ Ideal.span {c}) :
      Tendsto (fun η : ℝ => (η : ℂ) *
        (∑' w : O, W η (GaussianShiftedPartition.representative c r + c*w)))
        (𝓝[>] (0 : ℝ)) (𝓝 K) := by
    simpa only [K, a, b, W] using
      actual_O_fiber_gaussian_mass c
        (GaussianShiftedPartition.representative c r) hc
  have hsum : Tendsto (fun η : ℝ =>
      ∑ r : O ⧸ Ideal.span {c}, ψ (r ^ 2) *
        ((η : ℂ) * (∑' w : O, W η
          (GaussianShiftedPartition.representative c r + c*w))))
      (𝓝[>] (0 : ℝ))
      (𝓝 (∑ r : O ⧸ Ideal.span {c}, ψ (r ^ 2) * K)) := by
    apply tendsto_finsetSum Finset.univ
    intro r hr
    exact (hfiber r).const_mul (ψ (r ^ 2))
  have hpoint (η : ℝ) (hη : 0 < η) :
      (η : ℂ) * (∑' z : O, ψ
        (Ideal.Quotient.mk (Ideal.span {c}) z ^ 2) * W η z) =
      ∑ r : O ⧸ Ideal.span {c}, ψ (r ^ 2) *
        ((η : ℂ) * (∑' w : O, W η
          (GaussianShiftedPartition.representative c r + c*w))) := by
    have hpart := GaussianShiftedPartition.actual_quadratic_shifted_partition
      c hc (W η) (actual_oscillatory_kernel_summable c hc hη)
    change (∑' z : O, ψ (Ideal.Quotient.mk (Ideal.span {c}) z ^ 2) * W η z) =
      ∑ r : O ⧸ Ideal.span {c}, ψ (r ^ 2) *
        ∑' w : O, W η (GaussianShiftedPartition.representative c r + c*w) at hpart
    rw [hpart, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro r hr
    ring
  have heq : (fun η : ℝ => (η : ℂ) *
      (∑' z : O, ψ (Ideal.Quotient.mk (Ideal.span {c}) z ^ 2) * W η z)) =ᶠ[
        𝓝[>] (0 : ℝ)]
      (fun η : ℝ => ∑ r : O ⧸ Ideal.span {c}, ψ (r ^ 2) *
        ((η : ℂ) * (∑' w : O, W η
          (GaussianShiftedPartition.representative c r + c*w)))) := by
    filter_upwards [self_mem_nhdsWithin] with η hη
    exact hpoint η hη
  have hlim := hsum.congr' heq.symm
  simpa only [K, ψ, W, Finset.mul_sum, mul_comm] using hlim

end Eisenstein
end QuadraticPhase


open scoped BigOperators Topology
open Filter Asymptotics MeasureTheory
namespace QuadraticPhase

namespace GaussianPhasePointwise

theorem exp_imag_diff_le (u v : ℝ) :
    ‖Complex.exp (Complex.I * (u : ℂ)) -
      Complex.exp (Complex.I * (v : ℂ))‖ ≤ |u - v| := by
  have heq :
      Complex.exp (Complex.I * (u : ℂ)) -
        Complex.exp (Complex.I * (v : ℂ)) =
      (Complex.exp (Complex.I * ((u - v : ℝ) : ℂ)) - 1) *
        Complex.exp (Complex.I * (v : ℂ)) := by
    rw [sub_mul, one_mul, ← Complex.exp_add]
    congr 1
    push_cast
    ring_nf
  rw [heq, norm_mul, Complex.norm_exp_I_mul_ofReal, mul_one]
  simpa only [Real.norm_eq_abs] using
    (Real.norm_exp_I_mul_ofReal_sub_one_le (x := u - v))

theorem exp_imag_denominator_error (θ A η : ℝ) (hA : 0 ≤ A) :
    ‖Complex.exp (Complex.I * ((θ / (1 + A * η ^ 2) : ℝ) : ℂ)) -
      Complex.exp (Complex.I * (θ : ℂ))‖ ≤
      |θ| * (A * η ^ 2) := by
  let r : ℝ := 1 + A * η ^ 2
  have hAη : 0 ≤ A * η ^ 2 := mul_nonneg hA (sq_nonneg _)
  have hr : 1 ≤ r := by dsimp [r]; linarith
  have hrpos : 0 < r := lt_of_lt_of_le zero_lt_one hr
  have hdiff : |θ / r - θ| = |θ| * ((r - 1) / r) := by
    have heq : θ / r - θ = -θ * ((r - 1) / r) := by
      field_simp
      ring
    rw [heq, abs_mul, abs_neg, abs_of_nonneg (div_nonneg (by linarith) hrpos.le)]
  have hfrac : (r - 1) / r ≤ r - 1 := by
    apply (div_le_iff₀ hrpos).mpr
    nlinarith [mul_nonneg (sub_nonneg.mpr hr) (sub_nonneg.mpr hr)]
  have hbound := exp_imag_diff_le (θ / r) θ
  dsimp [r] at hbound ⊢
  calc
    ‖Complex.exp (Complex.I * ((θ / (1 + A * η ^ 2) : ℝ) : ℂ)) -
      Complex.exp (Complex.I * (θ : ℂ))‖ ≤
        |θ / (1 + A * η ^ 2) - θ| := hbound
    _ = |θ| * (((1 + A * η ^ 2) - 1) / (1 + A * η ^ 2)) := hdiff
    _ ≤ |θ| * (A * η ^ 2) := by
      have hfrac' := hfrac
      dsimp [r] at hfrac'
      nlinarith [mul_nonneg (abs_nonneg θ) (sub_nonneg.mpr hfrac')]

end GaussianPhasePointwise

namespace GaussianMoment

theorem x_exp_neg_le (x : ℝ) (_hx : 0 ≤ x) :
    x * Real.exp (-x) ≤ 2 * Real.exp (-(x / 2)) := by
  have hlin : x / 2 ≤ Real.exp (x / 2) := by
    have h := Real.add_one_le_exp (x / 2)
    linarith
  have hmul := mul_le_mul_of_nonneg_right hlin (Real.exp_pos (-x)).le
  calc
    x * Real.exp (-x) = 2 * ((x / 2) * Real.exp (-x)) := by ring
    _ ≤ 2 * (Real.exp (x / 2) * Real.exp (-x)) := by
      gcongr
    _ = 2 * Real.exp (-(x / 2)) := by
      rw [← Real.exp_add]
      congr 1
      ring_nf

theorem gaussian_moment_term_bound (q t : ℝ) (hq : 0 ≤ q) (ht : 0 < t) :
    q * Real.exp (-t * q) ≤
      (2 / t) * Real.exp (-(t * q / 2)) := by
  have h := x_exp_neg_le (t * q) (mul_nonneg ht.le hq)
  have hpos : 0 ≤ t := ht.le
  calc
    q * Real.exp (-t * q) =
        ((t * q) * Real.exp (-(t * q))) / t := by
          field_simp
    _ ≤ (2 * Real.exp (-(t * q / 2))) / t :=
      div_le_div_of_nonneg_right h hpos
    _ = (2 / t) * Real.exp (-(t * q / 2)) := by ring


noncomputable def realGauss (t : ℝ) (z : ℤ × ℤ) : ℝ :=
  Real.exp (-Real.pi * t * RankTwoPoisson.eisQ z)

theorem realGauss_nonneg (t : ℝ) (z : ℤ × ℤ) :
    0 ≤ realGauss t z := (Real.exp_pos _).le

theorem realGauss_summable {t : ℝ} (ht : 0 < t) :
    Summable (realGauss t) := by
  have h := (RankTwoPoisson.eis_gauss_summable ht).norm
  convert h using 1
  funext z
  dsimp [realGauss, RankTwoPoisson.eisGauss]
  rw [Complex.norm_exp]
  simp

theorem realGauss_cast (t : ℝ) (z : ℤ × ℤ) :
    (realGauss t z : ℂ) = RankTwoEisShift.shifted t 0 0 z := by
  dsimp [realGauss, RankTwoPoisson.eisQ,
    RankTwoEisShift.shifted, RankTwoEisShift.Q]
  rw [← Complex.ofReal_exp]
  congr 1
  ring_nf

theorem real_gaussian_mass :
    Tendsto (fun t : ℝ => t * (∑' z : ℤ × ℤ, realGauss t z))
      (𝓝[>] (0 : ℝ)) (𝓝 (2 / Real.sqrt 3)) := by
  have hC := EisensteinAbelFiber.shifted_gaussian_mass 0 0
  have hRe := (Complex.continuous_re.tendsto
    (((2 / Real.sqrt 3 : ℝ) : ℂ))).comp hC
  have hsum (t : ℝ) :
      (∑' z : ℤ × ℤ, RankTwoEisShift.shifted t 0 0 z) =
        (((∑' z : ℤ × ℤ, realGauss t z) : ℝ) : ℂ) := by
    calc
      (∑' z : ℤ × ℤ, RankTwoEisShift.shifted t 0 0 z) =
          ∑' z : ℤ × ℤ, (realGauss t z : ℂ) := by
            apply tsum_congr
            intro z
            exact (realGauss_cast t z).symm
      _ = (((∑' z : ℤ × ℤ, realGauss t z) : ℝ) : ℂ) :=
        (Complex.ofReal_tsum (realGauss t)).symm
  have hfun (t : ℝ) :
      t * (∑' z : ℤ × ℤ, realGauss t z) =
        (((t : ℂ) * (∑' z : ℤ × ℤ, RankTwoEisShift.shifted t 0 0 z)).re) := by
    rw [hsum]
    norm_cast
  have hEq :
      (fun t : ℝ => t * (∑' z : ℤ × ℤ, realGauss t z)) =
        (Complex.re ∘
          (fun t : ℝ => (t : ℂ) *
            (∑' z : ℤ × ℤ, RankTwoEisShift.shifted t 0 0 z))) := by
    funext t
    exact hfun t
  rw [← hEq] at hRe
  simpa only [Complex.ofReal_re] using hRe


private theorem eisQ_nonneg (z : ℤ × ℤ) : 0 ≤ RankTwoPoisson.eisQ z := by
  have h := RankTwoPoisson.eisQ_lower z
  nlinarith [sq_nonneg (z.1 : ℝ), sq_nonneg (z.2 : ℝ)]

private theorem moment_term_bound {t : ℝ} (ht : 0 < t) (z : ℤ × ℤ) :
    RankTwoPoisson.eisQ z * realGauss t z ≤
      (2 / (Real.pi * t)) * realGauss (t / 2) z := by
  have h := gaussian_moment_term_bound (RankTwoPoisson.eisQ z) (Real.pi * t)
    (eisQ_nonneg z) (mul_pos Real.pi_pos ht)
  convert h using 1 <;> dsimp [realGauss] <;> ring_nf

private theorem moment_summable {t : ℝ} (ht : 0 < t) :
    Summable (fun z : ℤ × ℤ => RankTwoPoisson.eisQ z * realGauss t z) := by
  have hmajor : Summable (fun z : ℤ × ℤ =>
      (2 / (Real.pi * t)) * realGauss (t / 2) z) :=
    (realGauss_summable (t := t / 2) (half_pos ht)).mul_left _
  exact hmajor.of_nonneg_of_le
    (fun z => mul_nonneg (eisQ_nonneg z) (realGauss_nonneg t z))
    (moment_term_bound ht)

private theorem moment_tsum_bound {t : ℝ} (ht : 0 < t) :
    (∑' z : ℤ × ℤ, RankTwoPoisson.eisQ z * realGauss t z) ≤
      (2 / (Real.pi * t)) *
        (∑' z : ℤ × ℤ, realGauss (t / 2) z) := by
  have hmajor : Summable (fun z : ℤ × ℤ =>
      (2 / (Real.pi * t)) * realGauss (t / 2) z) :=
    (realGauss_summable (t := t / 2) (half_pos ht)).mul_left _
  have h := Summable.tsum_le_tsum (moment_term_bound ht)
    (moment_summable ht) hmajor
  simpa only [tsum_mul_left] using h

private theorem moment_tsum_nonneg (t : ℝ) :
    0 ≤ (∑' z : ℤ × ℤ, RankTwoPoisson.eisQ z * realGauss t z) := by
  exact tsum_nonneg fun z => mul_nonneg (eisQ_nonneg z) (realGauss_nonneg t z)

private theorem half_tendsto_within :
    Tendsto (fun t : ℝ => t / 2) (𝓝[>] (0 : ℝ)) (𝓝[>] (0 : ℝ)) := by
  apply tendsto_nhdsWithin_iff.mpr
  constructor
  · have hc : ContinuousAt (fun t : ℝ => t / 2) 0 := by fun_prop
    simpa using hc.tendsto.mono_left nhdsWithin_le_nhds
  · filter_upwards [self_mem_nhdsWithin] with t ht
    change 0 < t at ht
    exact half_pos ht

private theorem t_tendsto_zero :
    Tendsto (fun t : ℝ => t) (𝓝[>] (0 : ℝ)) (𝓝 (0 : ℝ)) :=
  tendsto_id.mono_left nhdsWithin_le_nhds

private theorem scaled_half_mass_tendsto :
    Tendsto
      (fun t : ℝ => (t / 2) *
        (∑' z : ℤ × ℤ, realGauss (t / 2) z))
      (𝓝[>] (0 : ℝ)) (𝓝 (2 / Real.sqrt 3)) := by
  simpa only [Function.comp_def] using real_gaussian_mass.comp half_tendsto_within

/-- The Gaussian moment costs two inverse powers of scale, leaving one vanishing power. -/
theorem scaled_moment_vanishes :
    Tendsto
      (fun t : ℝ => t ^ 3 *
        (∑' z : ℤ × ℤ, RankTwoPoisson.eisQ z * realGauss t z))
      (𝓝[>] (0 : ℝ)) (𝓝 (0 : ℝ)) := by
  have hright : Tendsto
      (fun t : ℝ => (4 / Real.pi) * t *
        ((t / 2) * (∑' z : ℤ × ℤ, realGauss (t / 2) z)))
      (𝓝[>] (0 : ℝ)) (𝓝 (0 : ℝ)) := by
    have h := (t_tendsto_zero.mul scaled_half_mass_tendsto).const_mul (4 / Real.pi)
    simpa only [zero_mul, mul_zero, Function.comp_def, mul_assoc] using h
  have hleft : Tendsto (fun _ : ℝ => (0 : ℝ))
      (𝓝[>] (0 : ℝ)) (𝓝 (0 : ℝ)) := tendsto_const_nhds
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le' hleft hright
  · filter_upwards [self_mem_nhdsWithin] with t ht
    change 0 < t at ht
    exact mul_nonneg (pow_nonneg ht.le _) (moment_tsum_nonneg t)
  · filter_upwards [self_mem_nhdsWithin] with t ht
    change 0 < t at ht
    have h := moment_tsum_bound ht
    have ht3 : 0 ≤ t ^ 3 := pow_nonneg ht.le _
    have hmul := mul_le_mul_of_nonneg_left h ht3
    calc
      t ^ 3 * (∑' z : ℤ × ℤ, RankTwoPoisson.eisQ z * realGauss t z) ≤
          t ^ 3 * ((2 / (Real.pi * t)) *
            (∑' z : ℤ × ℤ, realGauss (t / 2) z)) := hmul
      _ = (4 / Real.pi) * t *
          ((t / 2) * (∑' z : ℤ × ℤ, realGauss (t / 2) z)) := by
        field_simp [ht.ne']
        ring


theorem scaled_moment_vanishes_const (K : ℝ) (hK : 0 < K) :
    Tendsto
      (fun η : ℝ => η ^ 3 *
        (∑' z : ℤ × ℤ, RankTwoPoisson.eisQ z * realGauss (K * η) z))
      (𝓝[>] (0 : ℝ)) (𝓝 (0 : ℝ)) := by
  have hscale : Tendsto (fun η : ℝ => K * η)
      (𝓝[>] (0 : ℝ)) (𝓝[>] (0 : ℝ)) := by
    apply tendsto_nhdsWithin_iff.mpr
    constructor
    · have hc : ContinuousAt (fun η : ℝ => K * η) 0 := by fun_prop
      simpa using hc.tendsto.mono_left nhdsWithin_le_nhds
    · filter_upwards [self_mem_nhdsWithin] with η hη
      change 0 < η at hη
      exact mul_pos hK hη
  have h := scaled_moment_vanishes.comp hscale
  have h' := h.const_mul (1 / K ^ 3)
  convert h' using 1
  · funext η
    dsimp [Function.comp_def]
    field_simp [hK.ne']
  · simp

end GaussianMoment

namespace OscSpecial

noncomputable def phaseBoundConstant (a b : ℝ) : ℝ :=
  2 * (|a - b| + |a| + |b|) + 1

theorem phaseBoundConstant_pos (a b : ℝ) :
    0 < phaseBoundConstant a b := by
  unfold phaseBoundConstant
  positivity

theorem quadratic_phase_abs_le (a b k l : ℝ) :
    |(a - b) * k ^ 2 + 2 * a * k * l + b * l ^ 2| ≤
      phaseBoundConstant a b * (k ^ 2 + k * l + l ^ 2) := by
  let Q : ℝ := k ^ 2 + k * l + l ^ 2
  have hQ : 0 ≤ Q := by
    dsimp [Q]
    nlinarith only [sq_nonneg (k + l), sq_nonneg k, sq_nonneg l]
  have hsum : k ^ 2 + l ^ 2 ≤ 2 * Q := by
    dsimp [Q]
    nlinarith only [sq_nonneg (k + l)]
  have hcross : 2 * |k| * |l| ≤ k ^ 2 + l ^ 2 := by
    nlinarith only [sq_nonneg (|k| - |l|), sq_abs k, sq_abs l]
  have hk : k ^ 2 ≤ 2 * Q := by nlinarith only [hsum, sq_nonneg l]
  have hl : l ^ 2 ≤ 2 * Q := by nlinarith only [hsum, sq_nonneg k]
  have hkl : 2 * |k| * |l| ≤ 2 * Q := hcross.trans hsum
  have h1 := mul_le_mul_of_nonneg_left hk (abs_nonneg (a - b))
  have h2 := mul_le_mul_of_nonneg_left hkl (abs_nonneg a)
  have h3 := mul_le_mul_of_nonneg_left hl (abs_nonneg b)
  have htri :
      |(a - b) * k ^ 2 + 2 * a * k * l + b * l ^ 2| ≤
        |a - b| * k ^ 2 + 2 * |a| * |k| * |l| + |b| * l ^ 2 := by
    calc
      |(a - b) * k ^ 2 + 2 * a * k * l + b * l ^ 2| ≤
          |(a - b) * k ^ 2| + |2 * a * k * l| + |b * l ^ 2| := by
        calc
          _ ≤ |(a - b) * k ^ 2 + 2 * a * k * l| + |b * l ^ 2| := abs_add_le _ _
          _ ≤ _ := by
            have hh := abs_add_le ((a - b) * k ^ 2) (2 * a * k * l)
            linarith
      _ = _ := by
        simp [abs_mul,  abs_of_nonneg (sq_nonneg k),
          abs_of_nonneg (sq_nonneg l)]
  unfold phaseBoundConstant
  nlinarith only [htri, h1, h2, h3, hQ]


noncomputable def dualQ (z : ℤ × ℤ) : ℝ :=
  (z.1 : ℝ) ^ 2 + (z.1 : ℝ) * (z.2 : ℝ) + (z.2 : ℝ) ^ 2

noncomputable def dualTrace (a b : ℝ) (z : ℤ × ℤ) : ℝ :=
  (a - b) * (z.1 : ℝ) ^ 2 + 2 * a * (z.1 : ℝ) * (z.2 : ℝ) +
    b * (z.2 : ℝ) ^ 2

noncomputable def phaseA (a b : ℝ) : ℝ := 3 * q a b / 16
noncomputable def phaseAngle (a b : ℝ) (z : ℤ × ℤ) : ℝ :=
  -(Real.pi / 2) * dualTrace a b z
noncomputable def dualAmp (η a b : ℝ) (z : ℤ × ℤ) : ℝ :=
  Real.exp (-Real.pi * (η * q a b / (4 * r η a b)) * dualQ z)
noncomputable def dualVarTerm (η a b : ℝ) (z : ℤ × ℤ) : ℂ :=
  (dualAmp η a b z : ℂ) *
    Complex.exp (Complex.I * ((phaseAngle a b z / r η a b : ℝ) : ℂ))
noncomputable def dualFixedTerm (η a b : ℝ) (z : ℤ × ℤ) : ℂ :=
  (dualAmp η a b z : ℂ) *
    Complex.exp (Complex.I * (phaseAngle a b z : ℂ))

private theorem dualQ_nonneg (z : ℤ × ℤ) : 0 ≤ dualQ z := by
  unfold dualQ
  nlinarith [sq_nonneg ((z.1 : ℝ) + (z.2 : ℝ)), sq_nonneg (z.1 : ℝ),
    sq_nonneg (z.2 : ℝ)]

private theorem phaseAngle_bound (a b : ℝ) (z : ℤ × ℤ) :
    |phaseAngle a b z| ≤
      (Real.pi / 2) * phaseBoundConstant a b * dualQ z := by
  have h := quadratic_phase_abs_le a b (z.1 : ℝ) (z.2 : ℝ)
  dsimp [phaseAngle, dualTrace, dualQ]
  rw [abs_mul, abs_neg, abs_of_pos (half_pos Real.pi_pos)]
  simpa only [mul_assoc] using
    mul_le_mul_of_nonneg_left h (half_pos Real.pi_pos).le

private theorem r_eq_one_add_phaseA (η a b : ℝ) :
    r η a b = 1 + phaseA a b * η ^ 2 := by
  unfold r phaseA
  ring

private theorem phaseA_nonneg {a b : ℝ} (hq : 0 ≤ q a b) :
    0 ≤ phaseA a b := by
  unfold phaseA
  positivity

theorem dual_phase_term_error {η a b : ℝ} (_hη : 0 < η) (hq : 0 < q a b)
    (z : ℤ × ℤ) :
    ‖dualVarTerm η a b z - dualFixedTerm η a b z‖ ≤
      dualAmp η a b z *
        ((Real.pi / 2) * phaseBoundConstant a b * dualQ z) *
        (phaseA a b * η ^ 2) := by
  have hA : 0 ≤ phaseA a b := phaseA_nonneg hq.le
  have hamp : 0 ≤ dualAmp η a b z := (Real.exp_pos _).le
  have hphase := GaussianPhasePointwise.exp_imag_denominator_error
    (phaseAngle a b z) (phaseA a b) η hA
  rw [← r_eq_one_add_phaseA η a b] at hphase
  have hangle := phaseAngle_bound a b z
  have hangle' := mul_le_mul_of_nonneg_right hangle
    (mul_nonneg hA (sq_nonneg η))
  dsimp [dualVarTerm, dualFixedTerm]
  rw [← mul_sub, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hamp]
  nlinarith only [mul_le_mul_of_nonneg_left hphase hamp,
    mul_le_mul_of_nonneg_left hangle' hamp]

noncomputable def dualRealGauss (t : ℝ) (z : ℤ × ℤ) : ℝ :=
  Real.exp (-Real.pi * t * dualQ z)

private theorem dualRealGauss_summable {t : ℝ} (ht : 0 < t) :
    Summable (dualRealGauss t) := by
  let e : ℤ × ℤ ≃ ℤ × ℤ :=
    Equiv.prodCongr (Equiv.refl ℤ) (Equiv.neg ℤ)
  have hE : Summable (fun z : ℤ × ℤ =>
      RankTwoPoisson.eisGauss t (z.1,-z.2)) :=
    (e.summable_iff).2 (RankTwoPoisson.eis_gauss_summable ht)
  convert hE.norm using 1
  funext z
  dsimp [dualRealGauss, RankTwoPoisson.eisGauss]
  rw [Complex.norm_exp]
  simp only [Complex.ofReal_re]
  congr 1
  dsimp [dualQ, RankTwoPoisson.eisQ]
  push_cast
  ring

private theorem dualMoment_summable {t : ℝ} (ht : 0 < t) :
    Summable (fun z : ℤ × ℤ => dualQ z * dualRealGauss t z) := by
  have hmaj : Summable (fun z : ℤ × ℤ =>
      (2 / (Real.pi * t)) * dualRealGauss (t / 2) z) :=
    (dualRealGauss_summable (half_pos ht)).mul_left _
  apply hmaj.of_nonneg_of_le
  · intro z
    exact mul_nonneg (dualQ_nonneg z) (Real.exp_pos _).le
  · intro z
    have h := GaussianMoment.gaussian_moment_term_bound
      (dualQ z) (Real.pi * t) (dualQ_nonneg z) (mul_pos Real.pi_pos ht)
    convert h using 1 <;> dsimp [dualRealGauss] <;> ring_nf

private theorem dualAmp_eq_realGauss (η a b : ℝ) (z : ℤ × ℤ) :
    dualAmp η a b z = dualRealGauss (η * q a b / (4 * r η a b)) z := rfl

private theorem dualAmp_norm_var (η a b : ℝ) (z : ℤ × ℤ) :
    ‖dualVarTerm η a b z‖ = dualAmp η a b z := by
  dsimp [dualVarTerm]
  rw [norm_mul, Complex.norm_exp_I_mul_ofReal, mul_one, Complex.norm_real]
  exact abs_of_nonneg (Real.exp_pos _).le

private theorem dualAmp_norm_fixed (η a b : ℝ) (z : ℤ × ℤ) :
    ‖dualFixedTerm η a b z‖ = dualAmp η a b z := by
  dsimp [dualFixedTerm]
  rw [norm_mul, Complex.norm_exp_I_mul_ofReal, mul_one, Complex.norm_real]
  exact abs_of_nonneg (Real.exp_pos _).le

private theorem dualAmp_summable {η a b : ℝ} (hη : 0 < η) (hq : 0 < q a b) :
    Summable (dualAmp η a b) := by
  have hr : 0 < r η a b := r_pos hη hq
  have ht : 0 < η * q a b / (4 * r η a b) := by positivity
  convert dualRealGauss_summable ht using 1
  funext z
  exact dualAmp_eq_realGauss η a b z

private theorem dualVar_summable {η a b : ℝ} (hη : 0 < η) (hq : 0 < q a b) :
    Summable (dualVarTerm η a b) :=
  (dualAmp_summable hη hq).of_norm_bounded
    (fun z => le_of_eq (dualAmp_norm_var η a b z))

private theorem dualFixed_summable {η a b : ℝ} (hη : 0 < η) (hq : 0 < q a b) :
    Summable (dualFixedTerm η a b) :=
  (dualAmp_summable hη hq).of_norm_bounded
    (fun z => le_of_eq (dualAmp_norm_fixed η a b z))

private theorem dualAmp_le_small {η a b : ℝ}
    (hη : 0 < η) (hq : 0 < q a b) (hrle : r η a b ≤ 2)
    (z : ℤ × ℤ) :
    dualAmp η a b z ≤ dualRealGauss (η * q a b / 8) z := by
  have hr : 0 < r η a b := r_pos hη hq
  have hp : 0 < η * q a b := mul_pos hη hq
  have ht : η * q a b / 8 ≤ η * q a b / (4 * r η a b) := by
    apply (div_le_div_iff₀ (by norm_num : (0 : ℝ) < 8)
      (by positivity : 0 < 4 * r η a b)).2
    nlinarith [mul_le_mul_of_nonneg_left hrle hp.le]
  dsimp [dualAmp, dualRealGauss]
  apply Real.exp_le_exp.mpr
  have hm := mul_le_mul_of_nonneg_right ht
    (mul_nonneg Real.pi_pos.le (dualQ_nonneg z))
  nlinarith [hm]

noncomputable def phaseErrorConstant (a b : ℝ) : ℝ :=
  (Real.pi / 2) * phaseBoundConstant a b * phaseA a b

private theorem phaseErrorConstant_nonneg {a b : ℝ} (hq : 0 < q a b) :
    0 ≤ phaseErrorConstant a b := by
  unfold phaseErrorConstant
  exact mul_nonneg (mul_nonneg (half_pos Real.pi_pos).le
    (phaseBoundConstant_pos a b).le) (phaseA_nonneg hq.le)

theorem normalized_dual_phase_sum_error {η a b : ℝ}
    (hη : 0 < η) (hq : 0 < q a b) (hrle : r η a b ≤ 2) :
    η * ‖(∑' z : ℤ × ℤ, dualVarTerm η a b z) -
      (∑' z : ℤ × ℤ, dualFixedTerm η a b z)‖ ≤
      phaseErrorConstant a b * η ^ 3 *
        (∑' z : ℤ × ℤ,
          dualQ z * dualRealGauss (η * q a b / 8) z) := by
  let t : ℝ := η * q a b / 8
  have ht : 0 < t := by dsimp [t]; positivity
  have hK : 0 ≤ phaseErrorConstant a b := phaseErrorConstant_nonneg hq
  have hpoint (z : ℤ × ℤ) :
      ‖dualVarTerm η a b z - dualFixedTerm η a b z‖ ≤
        (phaseErrorConstant a b * η ^ 2) *
          (dualQ z * dualRealGauss t z) := by
    have hbase := dual_phase_term_error hη hq z
    have hamp := dualAmp_le_small hη hq hrle z
    have hfac : 0 ≤
        ((Real.pi / 2) * phaseBoundConstant a b * dualQ z) *
          (phaseA a b * η ^ 2) := by
      exact mul_nonneg
        (mul_nonneg (mul_nonneg (half_pos Real.pi_pos).le
          (phaseBoundConstant_pos a b).le) (dualQ_nonneg z))
        (mul_nonneg (phaseA_nonneg hq.le) (sq_nonneg η))
    have hmul := mul_le_mul_of_nonneg_right hamp hfac
    dsimp [t, phaseErrorConstant]
    calc
      ‖dualVarTerm η a b z - dualFixedTerm η a b z‖ ≤
        dualAmp η a b z *
          ((Real.pi / 2) * phaseBoundConstant a b * dualQ z) *
          (phaseA a b * η ^ 2) := hbase
      _ ≤ dualRealGauss (η * q a b / 8) z *
          ((Real.pi / 2) * phaseBoundConstant a b * dualQ z) *
          (phaseA a b * η ^ 2) := by nlinarith only [hmul]
      _ = ((Real.pi / 2 * phaseBoundConstant a b * phaseA a b) * η ^ 2) *
          (dualQ z * dualRealGauss (η * q a b / 8) z) := by ring
  have hmajor : Summable (fun z : ℤ × ℤ =>
      (phaseErrorConstant a b * η ^ 2) *
        (dualQ z * dualRealGauss t z)) :=
    (dualMoment_summable ht).mul_left _
  have hnorm : Summable (fun z : ℤ × ℤ =>
      ‖dualVarTerm η a b z - dualFixedTerm η a b z‖) :=
    hmajor.of_nonneg_of_le (fun z => norm_nonneg _) hpoint
  have hsum := norm_tsum_le_tsum_norm hnorm
  have htsum := Summable.tsum_le_tsum hpoint hnorm hmajor
  have hvar := dualVar_summable hη hq
  have hfixed := dualFixed_summable hη hq
  calc
    η * ‖(∑' z : ℤ × ℤ, dualVarTerm η a b z) -
      (∑' z : ℤ × ℤ, dualFixedTerm η a b z)‖ =
      η * ‖(∑' z : ℤ × ℤ, (dualVarTerm η a b z - dualFixedTerm η a b z))‖ := by
        rw [hvar.tsum_sub hfixed]
    _ ≤ η * (∑' z : ℤ × ℤ,
          ‖dualVarTerm η a b z - dualFixedTerm η a b z‖) :=
      mul_le_mul_of_nonneg_left hsum hη.le
    _ ≤ η * (∑' z : ℤ × ℤ,
          (phaseErrorConstant a b * η ^ 2) *
            (dualQ z * dualRealGauss t z)) :=
      mul_le_mul_of_nonneg_left htsum hη.le
    _ = phaseErrorConstant a b * η ^ 3 *
          (∑' z : ℤ × ℤ, dualQ z * dualRealGauss (η * q a b / 8) z) := by
      rw [tsum_mul_left]
      dsimp [t]
      ring


private theorem dual_moment_reindex (t : ℝ) :
    (∑' z : ℤ × ℤ, dualQ z * dualRealGauss t z) =
      ∑' z : ℤ × ℤ,
        RankTwoPoisson.eisQ z * GaussianMoment.realGauss t z := by
  let e : ℤ × ℤ ≃ ℤ × ℤ :=
    Equiv.prodCongr (Equiv.refl ℤ) (Equiv.neg ℤ)
  calc
    (∑' z : ℤ × ℤ, dualQ z * dualRealGauss t z) =
        ∑' z : ℤ × ℤ,
          RankTwoPoisson.eisQ (e z) * GaussianMoment.realGauss t (e z) := by
      apply tsum_congr
      intro z
      have hQ : RankTwoPoisson.eisQ (e z) = dualQ z := by
        rcases z with ⟨k,l⟩
        change (k : ℝ) ^ 2 - (k : ℝ) * ((-l : ℤ) : ℝ) +
          ((-l : ℤ) : ℝ) ^ 2 =
          (k : ℝ) ^ 2 + (k : ℝ) * (l : ℝ) + (l : ℝ) ^ 2
        push_cast
        ring
      simp only [GaussianMoment.realGauss, dualRealGauss, hQ]
    _ = ∑' z : ℤ × ℤ,
          RankTwoPoisson.eisQ z * GaussianMoment.realGauss t z :=
      e.tsum_eq (fun z : ℤ × ℤ =>
        RankTwoPoisson.eisQ z * GaussianMoment.realGauss t z)

/-- Freezing the dual phase preserves the normalized Abel limit. -/
theorem normalized_dual_phase_sum_error_tendsto_zero {a b : ℝ}
    (hq : 0 < q a b) :
    Tendsto
      (fun η : ℝ =>
        η * ‖(∑' z : ℤ × ℤ, dualVarTerm η a b z) -
          (∑' z : ℤ × ℤ, dualFixedTerm η a b z)‖)
      (𝓝[>] (0 : ℝ)) (𝓝 (0 : ℝ)) := by
  let K : ℝ := q a b / 8
  have hK : 0 < K := by dsimp [K]; positivity
  have hmoment :
      Tendsto
        (fun η : ℝ => η ^ 3 *
          (∑' z : ℤ × ℤ,
            dualQ z * dualRealGauss (η * q a b / 8) z))
        (𝓝[>] (0 : ℝ)) (𝓝 (0 : ℝ)) := by
    convert GaussianMoment.scaled_moment_vanishes_const K hK using 1
    funext η
    dsimp [K]
    rw [dual_moment_reindex]
    ring_nf
  have hright :
      Tendsto
        (fun η : ℝ => phaseErrorConstant a b * η ^ 3 *
          (∑' z : ℤ × ℤ,
            dualQ z * dualRealGauss (η * q a b / 8) z))
        (𝓝[>] (0 : ℝ)) (𝓝 (0 : ℝ)) := by
    convert hmoment.const_mul (phaseErrorConstant a b) using 1
    · funext η
      ring
    · simp
  have hr_lim : Tendsto (fun η : ℝ => r η a b)
      (𝓝[>] (0 : ℝ)) (𝓝 (1 : ℝ)) := by
    have hc : ContinuousAt (fun η : ℝ => r η a b) 0 := by
      unfold r
      fun_prop
    simpa [r] using hc.tendsto.mono_left nhdsWithin_le_nhds
  have hrle : ∀ᶠ η : ℝ in 𝓝[>] (0 : ℝ), r η a b ≤ 2 := by
    have hevent : ∀ᶠ x : ℝ in 𝓝 (1 : ℝ), x ≤ 2 :=
      eventually_le_nhds (by norm_num)
    exact hr_lim.eventually hevent
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le'
    (tendsto_const_nhds (x := (0 : ℝ))) hright
  · filter_upwards [self_mem_nhdsWithin] with η hη
    exact mul_nonneg hη.le (norm_nonneg _)
  · filter_upwards [self_mem_nhdsWithin, hrle] with η hη hbound
    exact normalized_dual_phase_sum_error hη hq hbound

theorem dualGaussian_eq_dualVarTerm {η a b : ℝ}
    (hη : 0 < η) (hq : 0 < q a b) (z : ℤ × ℤ) :
    RankTwoComplex.dualGaussian (A η a b) (B η a b) (D η a b) z =
      dualVarTerm η a b z := by
  rw [dualGaussian_explicit hη hq z]
  have hQ :
      ((z.1 : ℂ) ^ 2 + (z.1 : ℂ) * (z.2 : ℂ) + (z.2 : ℂ) ^ 2) =
        (dualQ z : ℂ) := by
    dsimp [dualQ]
    push_cast
    ring
  have hT :
      (((a-b : ℝ) : ℂ) * (z.1 : ℂ) ^ 2 +
        2 * (a : ℂ) * (z.1 : ℂ) * (z.2 : ℂ) +
        (b : ℂ) * (z.2 : ℂ) ^ 2) =
        (dualTrace a b z : ℂ) := by
    dsimp [dualTrace]
    push_cast
    ring
  rw [hQ, hT]
  have hrC : (r η a b : ℂ) ≠ 0 := by
    exact_mod_cast (r_pos hη hq).ne'
  have harg :
      -(Real.pi : ℂ) *
        ((η : ℂ) * (q a b : ℂ) / (4 * (r η a b : ℂ)) *
          (dualQ z : ℂ) +
          Complex.I / (2 * (r η a b : ℂ)) * (dualTrace a b z : ℂ)) =
      (((-Real.pi * (η * q a b / (4 * r η a b)) * dualQ z : ℝ) : ℂ)) +
        Complex.I * ((phaseAngle a b z / r η a b : ℝ) : ℂ) := by
    dsimp [phaseAngle]
    push_cast
    field_simp [hrC]
    ring
  rw [harg, Complex.exp_add, ← Complex.ofReal_exp]
  rfl



noncomputable def dualScale (η a b : ℝ) : ℝ :=
  η * q a b / (4 * r η a b)

theorem dualScale_tendsto (a b : ℝ) (hq : 0 < q a b) :
    Tendsto (fun η : ℝ => dualScale η a b)
      (𝓝[>] (0 : ℝ)) (𝓝[>] (0 : ℝ)) := by
  have hnum : ContinuousAt (fun η : ℝ => η * q a b) 0 := by fun_prop
  have hden : ContinuousAt (fun η : ℝ => 4 * r η a b) 0 := by
    change ContinuousAt
      (fun η : ℝ => 4 * (1 + 3 * q a b * η ^ 2 / 16)) 0
    fun_prop
  have hden0 : 4 * r 0 a b ≠ 0 := by simp [r]
  have hcont : ContinuousAt (fun η : ℝ => dualScale η a b) 0 := by
    exact hnum.div hden hden0
  have hlim : Tendsto (fun η : ℝ => dualScale η a b)
      (𝓝[>] (0 : ℝ)) (𝓝 (0 : ℝ)) := by
    simpa [dualScale] using hcont.tendsto.mono_left nhdsWithin_le_nhds
  apply tendsto_nhdsWithin_iff.mpr
  constructor
  · exact hlim
  · filter_upwards [self_mem_nhdsWithin] with η hη
    change 0 < η at hη
    have hr : 0 < r η a b := by
      unfold r
      positivity
    exact div_pos (mul_pos hη hq) (mul_pos (by norm_num) hr)

/-- The dual damping rescales Abel mass by the limiting ratio of the two scales. -/
theorem abel_mass_dual_scale (a b : ℝ) (hq : 0 < q a b)
    (F : ℝ → ℂ) (L : ℂ)
    (hF : Tendsto (fun t : ℝ => (t : ℂ) * F t)
      (𝓝[>] (0 : ℝ)) (𝓝 L)) :
    Tendsto (fun η : ℝ => (η : ℂ) * F (dualScale η a b))
      (𝓝[>] (0 : ℝ))
      (𝓝 (((4 / q a b : ℝ) : ℂ) * L)) := by
  have hscale := dualScale_tendsto a b hq
  have hF' := hF.comp hscale
  have hrcont : ContinuousAt
      (fun η : ℝ => ((4 * r η a b / q a b : ℝ) : ℂ)) 0 := by
    change ContinuousAt
      (fun η : ℝ => ((4 * (1 + 3 * q a b * η ^ 2 / 16) / q a b : ℝ) : ℂ)) 0
    fun_prop
  have hr : Tendsto (fun η : ℝ => ((4 * r η a b / q a b : ℝ) : ℂ))
      (𝓝[>] (0 : ℝ)) (𝓝 ((4 / q a b : ℝ) : ℂ)) := by
    simpa [r] using hrcont.tendsto.mono_left nhdsWithin_le_nhds
  have hprod := hr.mul hF'
  have heq : ∀ᶠ η : ℝ in 𝓝[>] (0 : ℝ),
      (η : ℂ) * F (dualScale η a b) =
        ((4 * r η a b / q a b : ℝ) : ℂ) *
          (((dualScale η a b : ℝ) : ℂ) * F (dualScale η a b)) := by
    filter_upwards [self_mem_nhdsWithin] with η hη
    change 0 < η at hη
    have hrpos : 0 < r η a b := by
      unfold r
      positivity
    have hqC : (q a b : ℂ) ≠ 0 := by exact_mod_cast hq.ne'
    have hrC : (r η a b : ℂ) ≠ 0 := by exact_mod_cast hrpos.ne'
    dsimp [dualScale]
    push_cast
    field_simp [hqC, hrC]
  exact hprod.congr' (heq.mono fun η h => h.symm)


private theorem R_eq_four_r_div_q {η a b : ℝ} (hq : q a b ≠ 0) :
    R η a b = 4 * r η a b / q a b := by
  unfold R r
  field_simp [hq]
  ring

private theorem sqrt_R_eq {η a b : ℝ} (_hη : 0 < η) (hq : 0 < q a b) :
    Real.sqrt (R η a b) = 2 * Real.sqrt (r η a b) / Real.sqrt (q a b) := by
  rw [R_eq_four_r_div_q hq.ne']
  rw [Real.sqrt_div' (4 * r η a b) hq.le]
  rw [Real.sqrt_mul (by norm_num : (0 : ℝ) ≤ 4)]
  have hs4 : Real.sqrt (4 : ℝ) = 2 := by
    rw [show (4 : ℝ) = 2 ^ 2 by norm_num, Real.sqrt_sq (by norm_num : (0 : ℝ) ≤ 2)]
  rw [hs4]

theorem prefactor_eq_real_sqrt {η a b : ℝ} (hη : 0 < η) (hq : 0 < q a b) :
    (1 / ((R η a b : ℂ) ^ (1 / 2 : ℂ))) =
      ((Real.sqrt (q a b) / (2 * Real.sqrt (r η a b)) : ℝ) : ℂ) := by
  have hR : 0 ≤ R η a b := by unfold R; positivity
  have hqS : Real.sqrt (q a b) ≠ 0 := (Real.sqrt_pos.mpr hq).ne'
  have hrS : Real.sqrt (r η a b) ≠ 0 :=
    (Real.sqrt_pos.mpr (r_pos hη hq)).ne'
  have hcpow : (R η a b : ℂ) ^ (1 / 2 : ℂ) =
      ((R η a b) ^ (1 / 2 : ℝ) : ℝ) := by
    simpa using (Complex.ofReal_cpow hR (1 / 2 : ℝ)).symm
  rw [hcpow]
  simp only [Complex.ofReal_div]
  rw [← Real.sqrt_eq_rpow, sqrt_R_eq hη hq]
  push_cast
  field_simp [hqS, hrS]


/-- The principal Poisson prefactor tends to half the square root of the norm form. -/
theorem prefactor_tendsto {a b : ℝ} (hq : 0 < q a b) :
    Tendsto (fun η : ℝ => 1 / ((R η a b : ℂ) ^ (1 / 2 : ℂ)))
      (𝓝[>] (0 : ℝ))
      (𝓝 (((Real.sqrt (q a b) / 2 : ℝ) : ℂ))) := by
  have hrcont : Continuous (fun η : ℝ => r η a b) := by
    unfold r
    fun_prop
  have hr : Tendsto (fun η : ℝ => r η a b) (𝓝[>] (0 : ℝ)) (𝓝 (1 : ℝ)) := by
    simpa [r] using (hrcont.tendsto 0).mono_left nhdsWithin_le_nhds
  have hs : Tendsto (fun η : ℝ => Real.sqrt (r η a b))
      (𝓝[>] (0 : ℝ)) (𝓝 (1 : ℝ)) := by
    simpa only [Function.comp_def, Real.sqrt_one] using
      Real.continuous_sqrt.continuousAt.tendsto.comp hr
  have hd : Tendsto (fun η : ℝ => Real.sqrt (q a b) /
      (2 * Real.sqrt (r η a b))) (𝓝[>] (0 : ℝ))
      (𝓝 (Real.sqrt (q a b) / 2)) := by
    simpa only [Pi.div_def, mul_one] using
      (tendsto_const_nhds (x := Real.sqrt (q a b))).div
        ((tendsto_const_nhds (x := (2 : ℝ))).mul hs)
        (by norm_num : (2 : ℝ) * 1 ≠ 0)
  have hc : Tendsto (fun η : ℝ =>
      ((Real.sqrt (q a b) / (2 * Real.sqrt (r η a b)) : ℝ) : ℂ))
      (𝓝[>] (0 : ℝ)) (𝓝 (((Real.sqrt (q a b) / 2 : ℝ) : ℂ))) :=
    Complex.continuous_ofReal.continuousAt.tendsto.comp hd
  have heq : (fun η : ℝ => 1 / ((R η a b : ℂ) ^ (1 / 2 : ℂ))) =ᶠ[𝓝[>] (0 : ℝ)]
      (fun η : ℝ => ((Real.sqrt (q a b) / (2 * Real.sqrt (r η a b)) : ℝ) : ℂ)) := by
    filter_upwards [self_mem_nhdsWithin] with η hη
    exact prefactor_eq_real_sqrt hη hq
  exact hc.congr' heq.symm

end OscSpecial

/-- A vanishing normalized phase error transfers an Abel limit through a convergent prefactor. -/
theorem abel_transfer (P V W : ℝ → ℂ) (p w : ℂ)
    (hP : Tendsto P (𝓝[>] (0 : ℝ)) (𝓝 p))
    (hW : Tendsto (fun η : ℝ => (η : ℂ) * W η) (𝓝[>] (0 : ℝ)) (𝓝 w))
    (hE : Tendsto (fun η => η * ‖V η - W η‖)
      (𝓝[>] (0 : ℝ)) (𝓝 (0 : ℝ))) :
    Tendsto (fun η : ℝ => (η : ℂ) * (P η * V η))
      (𝓝[>] (0 : ℝ)) (𝓝 (p * w)) := by
  have hdiff : Tendsto (fun η : ℝ => (η : ℂ) * (V η - W η))
      (𝓝[>] (0 : ℝ)) (𝓝 (0 : ℂ)) := by
    rw [tendsto_zero_iff_norm_tendsto_zero]
    have heq : (fun η : ℝ => ‖(η : ℂ) * (V η - W η)‖) =ᶠ[𝓝[>] (0 : ℝ)]
        (fun η => η * ‖V η - W η‖) := by
      filter_upwards [self_mem_nhdsWithin] with η hη
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hη]
    exact hE.congr' heq.symm
  have hV : Tendsto (fun η : ℝ => (η : ℂ) * V η)
      (𝓝[>] (0 : ℝ)) (𝓝 w) := by
    convert hW.add hdiff using 1
    · funext η; ring
    · simp
  convert hP.mul hV using 1
  · funext η; ring


end QuadraticPhase


open scoped BigOperators Topology
open Filter
namespace QuadraticPhase.Eisenstein
open Coordinates

/-- The dual frequency lattice in the integral Eisenstein basis. -/
def dualFrequencyEquiv : ℤ × ℤ ≃ O :=
  ({ toFun := fun z => (z.1+z.2,z.1)
     invFun := fun z => (z.2,z.1-z.2)
     left_inv := by rintro ⟨k,l⟩; simp
     right_inv := by rintro ⟨k,l⟩; simp } : (ℤ × ℤ) ≃ (ℤ × ℤ)).trans
    coordinateEquiv.symm

theorem dualFrequencyEquiv_apply (z : ℤ × ℤ) :
    dualFrequencyEquiv z = eval (z.1+z.2) z.1 := rfl

theorem dualFrequency_norm_sq (z : ℤ × ℤ) :
    ‖ringComplex (dualFrequencyEquiv z)‖ ^ 2 = OscSpecial.dualQ z := by
  rw [dualFrequencyEquiv_apply, complex_norm_eval_sq]
  dsimp [OscSpecial.dualQ]
  push_cast
  ring

/-- The fixed phase of the inverse quadratic form is the trace phase modulo four. -/
theorem dualFrequency_phase (a b : ℤ) (z : ℤ × ℤ) :
    fixedDualPhase (eval a b) (dualFrequencyEquiv z) =
      Complex.exp (Complex.I * (OscSpecial.phaseAngle (a : ℝ) (b : ℝ) z : ℂ)) := by
  rw [dualFrequencyEquiv_apply, fixedDualPhase_eval]
  conv_lhs => rw [← Complex.exp_pi_div_two_mul_I, ← Complex.exp_int_mul]
  congr 1
  dsimp [OscSpecial.phaseAngle, OscSpecial.dualTrace]
  push_cast
  ring

/-- Reindexing the fixed dual Gaussian exposes its period-two residue classes. -/
theorem fixed_dual_sum_eq (a b : ℤ) (η : ℝ) :
    (∑' z : ℤ × ℤ, OscSpecial.dualFixedTerm η (a : ℝ) (b : ℝ) z) =
      ∑' y : O, fixedDualPhase (eval a b) y *
        Complex.exp (-(Real.pi : ℂ) * (OscSpecial.dualScale η (a : ℝ) (b : ℝ) : ℂ) *
          (‖ringComplex y‖ ^ 2 : ℂ)) := by
  rw [← dualFrequencyEquiv.tsum_eq (fun y : O => fixedDualPhase (eval a b) y *
    Complex.exp (-(Real.pi : ℂ) * (OscSpecial.dualScale η (a : ℝ) (b : ℝ) : ℂ) *
      (‖ringComplex y‖ ^ 2 : ℂ)))]
  apply tsum_congr
  intro z
  have hnorm : (‖ringComplex (dualFrequencyEquiv z)‖ : ℂ) ^ 2 =
      (OscSpecial.dualQ z : ℂ) := by exact_mod_cast dualFrequency_norm_sq z
  rw [dualFrequency_phase, hnorm]
  dsimp [OscSpecial.dualFixedTerm, OscSpecial.dualAmp, OscSpecial.dualScale]
  rw [Complex.ofReal_exp]
  push_cast
  ring

/-- The actual quadratic trace kernel is the oscillatory binary Gaussian. -/
theorem original_kernel_eq_binary (a b x y : ℤ) (hc : eval a b ≠ 0) (η : ℝ) :
    principalTraceChar (eval a b) hc
        (Ideal.Quotient.mk (Ideal.span {eval a b}) (eval x y) ^ 2) *
      Complex.exp (-(Real.pi : ℂ) * (η : ℂ) * (‖ringComplex (eval x y)‖ ^ 2 : ℂ)) =
      RankTwoComplex.binaryGaussian
        (OscSpecial.A η (a : ℝ) (b : ℝ)) (OscSpecial.B η (a : ℝ) (b : ℝ))
        (OscSpecial.D η (a : ℝ) (b : ℝ)) (x,y) := by
  have hnorm : (‖ringComplex (eval x y)‖ : ℂ) ^ 2 =
      (x : ℂ) ^ 2 - (x : ℂ) * (y : ℂ) + (y : ℂ) ^ 2 := by
    exact_mod_cast complex_norm_eval_sq x y
  rw [principalTraceChar_square, hnorm, ← Complex.exp_add]
  dsimp [RankTwoComplex.binaryGaussian, OscSpecial.A, OscSpecial.B, OscSpecial.D,
    OscSpecial.q]
  congr 1
  push_cast
  ring

theorem original_sum_eq_binary (a b : ℤ) (hc : eval a b ≠ 0) (η : ℝ) :
    (∑' z : O, principalTraceChar (eval a b) hc
        (Ideal.Quotient.mk (Ideal.span {eval a b}) z ^ 2) *
      Complex.exp (-(Real.pi : ℂ) * (η : ℂ) * (‖ringComplex z‖ ^ 2 : ℂ))) =
      ∑' z : ℤ × ℤ, RankTwoComplex.binaryGaussian
        (OscSpecial.A η (a : ℝ) (b : ℝ)) (OscSpecial.B η (a : ℝ) (b : ℝ))
        (OscSpecial.D η (a : ℝ) (b : ℝ)) z := by
  rw [← coordinateEquiv.symm.tsum_eq (fun z : O =>
    principalTraceChar (eval a b) hc (Ideal.Quotient.mk (Ideal.span {eval a b}) z ^ 2) *
      Complex.exp (-(Real.pi : ℂ) * (η : ℂ) * (‖ringComplex z‖ ^ 2 : ℂ)))]
  exact tsum_congr fun z => original_kernel_eq_binary a b z.1 z.2 hc η

private theorem finite_mod_two : Finite (O ⧸ Ideal.span {(2 : O)}) :=
  (Ideal.span {(2 : O)}).finiteQuotientOfFreeOfNeBot
    (fun h => (by norm_num : (2 : O) ≠ 0) (Ideal.span_singleton_eq_bot.mp h))

/-- Equal Abel mass in the four classes leaves their fixed phase average. -/
theorem fixed_phase_abel_limit (c : O) :
    Tendsto (fun t : ℝ => (t : ℂ) *
      (∑' y : O, fixedDualPhase c y *
        Complex.exp (-(Real.pi : ℂ) * (t : ℂ) * (‖ringComplex y‖ ^ 2 : ℂ))))
      (𝓝[>] (0 : ℝ)) (𝓝 ((1 / (Real.sqrt 3 : ℂ)) * fixedDualAverage c)) := by
  letI : Finite (O ⧸ Ideal.span {(2 : O)}) := finite_mod_two
  letI : Fintype (O ⧸ Ideal.span {(2 : O)}) := Fintype.ofFinite _
  let rep := GaussianShiftedPartition.representative (2 : O)
  let P : O ⧸ Ideal.span {(2 : O)} → ℂ := fun r => fixedDualPhase c (rep r)
  let W (t : ℝ) (y : O) : ℂ :=
    Complex.exp (-(Real.pi : ℂ) * (t : ℂ) * (‖ringComplex y‖ ^ 2 : ℂ))
  have hP (y : O) : P (Ideal.Quotient.mk (Ideal.span {(2 : O)}) y) =
      fixedDualPhase c y :=
    fixedDualPhase_eq_of_mod_two c _ _
      (GaussianShiftedPartition.representative_spec 2 _)
  have hfiber (r : O ⧸ Ideal.span {(2 : O)}) :
      Tendsto (fun t : ℝ => (t : ℂ) * (∑' y : O, W t (rep r + 2*y)))
        (𝓝[>] (0 : ℝ)) (𝓝 (1 / (2 * (Real.sqrt 3 : ℂ)))) := by
    have h := actual_O_fiber_gaussian_mass (2 : O) (rep r) (by norm_num)
    have hcoords : coords (2 : O) = (2,0) := by
      rw [← show eval 2 0 = (2 : O) by norm_num [eval], coords_eval]
    simp only [hcoords] at h
    convert h using 1
    dsimp [W]
    push_cast
    ring
  have hsum := tendsto_finsetSum Finset.univ (fun r _ => (hfiber r).const_mul (P r))
  have hpoint (t : ℝ) (ht : 0 < t) :
      (t : ℂ) * (∑' y : O, fixedDualPhase c y * W t y) =
      ∑ r : O ⧸ Ideal.span {(2 : O)}, P r *
        ((t : ℂ) * (∑' y : O, W t (rep r + 2*y))) := by
    have hconv : Summable (fun y : O => P (Ideal.Quotient.mk (Ideal.span {(2 : O)}) y) * W t y) := by
      apply (eis_gaussian_summable ht).norm.of_norm_bounded
      intro y
      simpa only [norm_mul, hP, fixedDualPhase_norm, one_mul] using (le_refl ‖W t y‖)
    have hp := GaussianAbelPartition.tsum_periodic_weighted_partition
      (Ideal.Quotient.mk (Ideal.span {(2 : O)})) P (W t) hconv
    simp only [hP] at hp
    rw [hp, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro r _
    rw [GaussianFiberEquiv.fiber_tsum 2 (by norm_num) r (rep r)
      (GaussianShiftedPartition.representative_spec 2 r) (W t)]
    ring
  have heq : (fun t : ℝ => (t : ℂ) * (∑' y : O, fixedDualPhase c y * W t y)) =ᶠ[𝓝[>] (0 : ℝ)]
      (fun t : ℝ => ∑ r : O ⧸ Ideal.span {(2 : O)}, P r *
        ((t : ℂ) * (∑' y : O, W t (rep r + 2*y)))) := by
    filter_upwards [self_mem_nhdsWithin] with t ht
    exact hpoint t ht
  have hlim := hsum.congr' heq.symm
  convert hlim using 1
  congr 1
  unfold fixedDualAverage
  change (1 / (Real.sqrt 3 : ℂ)) * ((∑ r, P r) / 2) = _
  rw [← Finset.sum_mul]
  ring

/-- The fixed dual sum has its residue average as its rescaled Abel limit. -/
theorem fixed_dual_abel_limit (a b : ℤ) (hc : eval a b ≠ 0) :
    Tendsto (fun η : ℝ => (η : ℂ) *
      (∑' z : ℤ × ℤ, OscSpecial.dualFixedTerm η (a : ℝ) (b : ℝ) z))
      (𝓝[>] (0 : ℝ))
      (𝓝 (((4 / OscSpecial.q (a : ℝ) (b : ℝ) : ℝ) : ℂ) *
        ((1 / (Real.sqrt 3 : ℂ)) * fixedDualAverage (eval a b)))) := by
  have hq : 0 < OscSpecial.q (a : ℝ) (b : ℝ) := by
    dsimp [OscSpecial.q]
    exact_mod_cast coordinate_norm_pos a b hc
  have h := OscSpecial.abel_mass_dual_scale (a : ℝ) (b : ℝ) hq
    (fun t : ℝ => ∑' y : O, fixedDualPhase (eval a b) y *
      Complex.exp (-(Real.pi : ℂ) * (t : ℂ) * (‖ringComplex y‖ ^ 2 : ℂ)))
    _ (fixed_phase_abel_limit (eval a b))
  simpa only [fixed_dual_sum_eq] using h

/-- Poisson summation and the vanishing phase error give the dual limit of the original kernel. -/
theorem original_dual_abel_limit (a b : ℤ) (hc : eval a b ≠ 0) :
    Tendsto (fun η : ℝ => (η : ℂ) *
      (∑' z : O, principalTraceChar (eval a b) hc
        (Ideal.Quotient.mk (Ideal.span {eval a b}) z ^ 2) *
        Complex.exp (-(Real.pi : ℂ) * (η : ℂ) * (‖ringComplex z‖ ^ 2 : ℂ))))
      (𝓝[>] (0 : ℝ))
      (𝓝 ((((Real.sqrt (OscSpecial.q (a : ℝ) (b : ℝ)) / 2 : ℝ) : ℂ)) *
        (((4 / OscSpecial.q (a : ℝ) (b : ℝ) : ℝ) : ℂ) *
          ((1 / (Real.sqrt 3 : ℂ)) * fixedDualAverage (eval a b))))) := by
  have hq : 0 < OscSpecial.q (a : ℝ) (b : ℝ) := by
    dsimp [OscSpecial.q]
    exact_mod_cast coordinate_norm_pos a b hc
  have h := abel_transfer
    (fun η : ℝ => 1 / ((OscSpecial.R η (a : ℝ) (b : ℝ) : ℂ) ^ (1 / 2 : ℂ)))
    (fun η : ℝ => ∑' z : ℤ × ℤ, OscSpecial.dualVarTerm η (a : ℝ) (b : ℝ) z)
    (fun η : ℝ => ∑' z : ℤ × ℤ, OscSpecial.dualFixedTerm η (a : ℝ) (b : ℝ) z)
    _ _ (OscSpecial.prefactor_tendsto hq) (fixed_dual_abel_limit a b hc)
    (OscSpecial.normalized_dual_phase_sum_error_tendsto_zero hq)
  apply h.congr'
  filter_upwards [self_mem_nhdsWithin] with η hη
  rw [original_sum_eq_binary, OscSpecial.oscillatory_gaussian_poisson hη hq]
  congr 2
  exact tsum_congr fun z => (OscSpecial.dualGaussian_eq_dualVarTerm hη hq z).symm

/-- The normalized quadratic trace Gauss sum is the four-residue dual average. -/
theorem normalizedQuadraticTraceGauss_eq_average (a b : ℤ) (hc : eval a b ≠ 0) :
    normalizedQuadraticTraceGauss (eval a b) hc = fixedDualAverage (eval a b) := by
  have ho := original_abel_gauss_limit (eval a b) hc
  simp only [coords_eval] at ho
  have hd := original_dual_abel_limit a b hc
  have heq := tendsto_nhds_unique ho hd
  let n := ‖ringComplex (eval a b)‖
  have hn : 0 < n := norm_pos_iff.mpr
    (fun h => hc (ringComplex_injective (by simpa using h)))
  have hq : OscSpecial.q (a : ℝ) (b : ℝ) = n ^ 2 :=
    (complex_norm_eval_sq a b).symm
  have hsqrt : Real.sqrt (OscSpecial.q (a : ℝ) (b : ℝ)) = n := by
    rw [hq, Real.sqrt_sq hn.le]
  have hi : (((a*a-a*b+b*b : ℤ) : ℝ)) = n ^ 2 := by
    simpa only [OscSpecial.q, Int.cast_add, Int.cast_sub, Int.cast_mul, pow_two] using hq
  change ((2 / (Real.sqrt 3 * (((a*a-a*b+b*b : ℤ) : ℝ))) : ℝ) : ℂ) *
      quadraticTraceGauss (eval a b) hc = _ at heq
  rw [hi, hsqrt, hq] at heq
  have hnC : (n : ℂ) ≠ 0 := by exact_mod_cast hn.ne'
  have hsC : (Real.sqrt 3 : ℂ) ≠ 0 := by
    exact_mod_cast (Real.sqrt_pos.mpr (by norm_num : (0 : ℝ) < 3)).ne'
  change quadraticTraceGauss (eval a b) hc / (n : ℂ) = _
  apply mul_left_cancel₀ (show (2 / ((Real.sqrt 3 : ℂ) * (n : ℂ))) ≠ 0 by
    exact div_ne_zero (by norm_num) (mul_ne_zero hsC hnC))
  convert heq using 1 <;> push_cast <;> field_simp [hnC, hsC]
  all_goals ring

/-- Every nonzero modulus has an explicit quadratic trace Gauss phase modulo four. -/
theorem normalizedQuadraticTraceGauss_formula (a b : ℤ) (hc : eval a b ≠ 0) :
    normalizedQuadraticTraceGauss (eval a b) hc =
      (1 + Complex.I ^ (-b) + Complex.I ^ a + Complex.I ^ (b-a)) / 2 := by
  rw [normalizedQuadraticTraceGauss_eq_average, fixedDualAverage_formula]

/-- The intrinsic normalized sum is the dual average, independently of coordinate choices. -/
theorem normalizedQuadraticTraceGauss_eq_fixedDualAverage (c : O) (hc : c ≠ 0) :
    normalizedQuadraticTraceGauss c hc = fixedDualAverage c := by
  obtain ⟨a,b,hab⟩ := exists_coordinates c
  change c = eval a b at hab
  subst c
  exact normalizedQuadraticTraceGauss_eq_average a b hc

/-- The normalized quadratic trace sum depends only on the modulus modulo four. -/
theorem normalizedQuadraticTraceGauss_eq_of_mod_four (c d : O) (hc : c ≠ 0) (hd : d ≠ 0)
    (h : Ideal.Quotient.mk (Ideal.span {(4 : O)}) c =
      Ideal.Quotient.mk (Ideal.span {(4 : O)}) d) :
    normalizedQuadraticTraceGauss c hc = normalizedQuadraticTraceGauss d hd := by
  rw [normalizedQuadraticTraceGauss_eq_fixedDualAverage,
    normalizedQuadraticTraceGauss_eq_fixedDualAverage,
    fixedDualAverage_eq_of_mod_four c d h]

/-- The quadratic trace Gauss sum is positive on the principal class modulo four. -/
theorem quadraticTraceGauss_eq_norm (c : O) (hc : c ≠ 0)
    (hfour : Ideal.Quotient.mk (Ideal.span {(4 : O)}) c = 1) :
    quadraticTraceGauss c hc = (‖ringComplex c‖ : ℂ) := by
  have h := normalizedQuadraticTraceGauss_eq_fixedDualAverage c hc
  rw [fixedDualAverage_eq_one _ hfour] at h
  have hn : (‖ringComplex c‖ : ℂ) ≠ 0 := by
    exact_mod_cast norm_ne_zero_iff.mpr
      (fun h => hc (ringComplex_injective (by simpa using h)))
  exact (div_eq_one_iff_eq hn).mp h

end QuadraticPhase.Eisenstein


namespace QuadraticPhase.ProductGauss
open _root_.GaloisForLFunctions.MetaplecticMobiusDescent.ProductGauss

/-- Counting square roots identifies the quadratic-character Gauss sum with its square phase. -/
theorem quadratic_eq_square_sum {F : Type*} [Field F] [Fintype F]
    (ψ : AddChar F ℂ) (hchar : ringChar F ≠ 2) (hψ : ψ ≠ 1) :
    gaussSum ((quadraticChar F).ringHomComp (Int.castRingHom ℂ)) ψ =
      ∑ x : F, ψ (x ^ 2) := by
  classical
  have hfiber : (∑ x : F, ψ (x ^ 2)) =
      ∑ y : F, (({x : F | x ^ 2 = y}.toFinset.card : ℕ) : ℂ) * ψ y := by
    rw [← Finset.sum_fiberwise (s := Finset.univ)
      (g := fun x : F => x ^ 2) (f := fun x : F => ψ (x ^ 2))]
    apply Finset.sum_congr rfl
    intro y _
    rw [Finset.sum_congr rfl (fun x hx => by
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hx
      rw [hx])]
    simp
  have hcount (y : F) : (({x : F | x ^ 2 = y}.toFinset.card : ℕ) : ℂ) =
      (quadraticChar F y : ℂ) + 1 := by
    exact_mod_cast quadraticChar_card_sqrts hchar y
  rw [hfiber]
  simp_rw [hcount, add_mul, one_mul]
  rw [Finset.sum_add_distrib, AddChar.sum_eq_zero_of_ne_one hψ, add_zero]
  rfl

variable {ι : Type*} [Fintype ι] [DecidableEq ι]
variable (F : ι → Type*) [∀ i, Field (F i)] [∀ i, Fintype (F i)]

/-- The square phase factors over the actual coordinate decomposition. -/
theorem square_sum_factorization (ψ : AddChar (∀ i, F i) ℂ) :
    (∑ x : ∀ i, F i, ψ (x ^ 2)) =
      ∏ i, ∑ y : F i, localChar F ψ i (y ^ 2) := by
  simp_rw [character_eq_prod F ψ, Pi.pow_apply]
  exact (Fintype.prod_sum (fun i y => localChar F ψ i (y ^ 2))).symm

/-- A primitive character on a product of odd finite fields has the same quadratic Gauss sum and square sum. -/
theorem quadratic_factorization_equiv {R : Type*} [CommRing R] [Fintype R]
    (e : R ≃+* ∀ i, F i) (ψ : AddChar R ℂ) (hψ : ψ.IsPrimitive)
    (hchar : ∀ i, ringChar (F i) ≠ 2) :
    (∑ x : R, (∏ i, ((quadraticChar (F i)).ringHomComp (Int.castRingHom ℂ)) (e x i)) * ψ x) =
      ∑ x : R, ψ (x ^ 2) := by
  rw [factorization_equiv F e]
  have hψ' := primitive_comp_ringEquiv e.symm ψ hψ
  calc
    _ = ∏ i, ∑ y : F i,
        localChar F (ψ.compAddMonoidHom e.symm.toAddMonoidHom) i (y ^ 2) := by
      apply Finset.prod_congr rfl
      intro i _
      apply quadratic_eq_square_sum _ (hchar i)
      have hp := localChar_primitive F _ hψ' i
      simpa only [AddChar.mulShift_one] using hp (a := 1) one_ne_zero
    _ = ∑ x : ∀ i, F i, (ψ.compAddMonoidHom e.symm.toAddMonoidHom) (x ^ 2) :=
      (square_sum_factorization F _).symm
    _ = ∑ x : R, ψ (x ^ 2) := by
      apply Fintype.sum_equiv e.symm.toEquiv
      intro x
      change ψ (e.symm (x ^ 2)) = ψ ((e.symm x) ^ 2)
      rw [map_pow]

end QuadraticPhase.ProductGauss

namespace SchwartzPlanePoisson
open Eisenstein Eisenstein.Coordinates QuadraticPhase.Eisenstein

/-- The complex-plane trace and the intrinsic number-field trace define the same character. -/
lemma principalTraceChar_eq_paperE (c : O) (hc : c ≠ 0) (x : O) :
    principalTraceChar c hc (Ideal.Quotient.mk (Ideal.span {c}) x) =
      paperE (ringComplex x / ringComplex c) := by
  obtain ⟨a, b, ha⟩ := exists_coordinates c
  obtain ⟨u, v, hx⟩ := exists_coordinates x
  change c = eval a b at ha
  change x = eval u v at hx
  subst c
  subst x
  rw [principalTraceChar_eval]
  have hcC := ringComplex_ne_zero hc
  have hlC := ringComplex_ne_zero traceLambda_ne_zero
  have hconj : starRingEnd ℂ (ringComplex (eval a b)) =
      (((a : ℝ) - b : ℝ) : ℂ) + ((-(b : ℝ) : ℝ) : ℂ) * ringComplex omega := by
    simp only [ringComplex_eval, map_add, map_mul, map_intCast, complex_omega_conjugate]
    push_cast
    ring
  have harg : ringComplex (eval u v) / ringComplex (eval a b) / ringComplex traceLambda =
      (ringComplex (eval u v) * starRingEnd ℂ (ringComplex (eval a b)) /
        ringComplex traceLambda) / (‖ringComplex (eval a b)‖ ^ 2 : ℝ) := by
    rw [Complex.sq_norm, Complex.normSq_eq_conj_mul_self]
    have hs : starRingEnd ℂ (ringComplex (eval a b)) ≠ 0 := by
      intro h
      apply hcC
      simpa only [map_zero, starRingEnd_self_apply] using congrArg (starRingEnd ℂ) h
    field_simp
  have hnum :
      (ringComplex (eval u v) * starRingEnd ℂ (ringComplex (eval a b)) / ringComplex traceLambda) +
        starRingEnd ℂ (ringComplex (eval u v) * starRingEnd ℂ (ringComplex (eval a b)) /
          ringComplex traceLambda) = (((a * v - b * u : ℤ) : ℝ) : ℂ) := by
    rw [hconj, ringComplex_eval]
    convert complexTrace_real_basis_product u v ((a : ℝ) - b) (-(b : ℝ)) using 1 <;>
      push_cast <;> ring
  change _ = Complex.exp (2 * Real.pi * Complex.I * (_ + starRingEnd ℂ _))
  rw [harg, map_div₀, Complex.conj_ofReal, ← add_div, hnum, complex_norm_eval_sq]
  congr 1
  push_cast
  ring

lemma residueTraceQuotientChar_eq_principal (c : O) (hc : c ≠ 0) :
    residueTraceQuotientChar 1 c hc = principalTraceChar c hc := by
  ext x
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [residueTraceQuotientChar_phase, principalTraceChar_eq_paperE, one_mul]
  change tracePhase _ = tracePhase _
  congr 1
  ring

end SchwartzPlanePoisson

namespace SchwartzPlanePoisson
open Eisenstein MulChar AddChar QuadraticPhase.Eisenstein
open scoped SchwartzMap

lemma complexQuadraticChar_inv (P : Ideal O) [P.IsMaximal] :
    (complexQuadraticChar P)⁻¹ = complexQuadraticChar P := by
  ext x
  rw [← MulChar.star_apply']
  change starRingEnd ℂ ((quadraticChar (O ⧸ P) x : ℤ) : ℂ) =
    ((quadraticChar (O ⧸ P) x : ℤ) : ℂ)
  exact map_intCast (starRingEnd ℂ) _

/-- Quadratic reflection has an explicit phase depending only on the conductor modulo four. -/
theorem prime_quadratic_radial_poisson {ι : Type*} [Fintype ι] [DecidableEq ι]
    (p : ι → O) (hp : ∀ i, p i ≠ 0)
    [∀ i, (Ideal.span {p i}).IsMaximal]
    (hinj : Function.Injective (fun i => Ideal.span {p i}))
    (hodd : ∀ i, ringChar (O ⧸ Ideal.span {p i}) ≠ 2)
    (W : 𝓢(ℝ, ℂ)) (Y : ℝ) (hY : 0 < Y) :
    (∑' z : O, primeCuspRowCharacter p (fun i => complexQuadraticChar (Ideal.span {p i})) z *
      W (‖ringComplex z‖ ^ 2 / Y)) =
      ((Y : ℂ) * fixedDualAverage (∏ i, p i) / (‖ringComplex (∏ i, p i)‖ : ℂ)) *
        ∑' h : O, primeCuspRowCharacter p (fun i => complexQuadraticChar (Ideal.span {p i})) h *
          paperRadialFourier W (Y * ‖ringComplex h‖ ^ 2 / ‖ringComplex (∏ i, p i)‖ ^ 2) := by
  classical
  let P : ι → Ideal O := fun i => Ideal.span {p i}
  let c := ∏ i, p i
  have hc : c ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun i _ => hp i)
  let : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
  let : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
  have hspan : Ideal.span {c} = ∏ i, P i := span_finset_prime_product p Finset.univ
  let e : (O ⧸ Ideal.span {c}) ≃+* ∀ i, O ⧸ P i :=
    (Ideal.quotEquivOfEq hspan).trans (Eisenstein.primeCRT P hinj)
  have he (z : O) (i : ι) :
      e (Ideal.Quotient.mk (Ideal.span {c}) z) i = Ideal.Quotient.mk (P i) z := by
    simp only [e, RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk, Eisenstein.primeCRT]
    rfl
  let χ : ∀ i, MulChar (O ⧸ P i) ℂ := fun i => complexQuadraticChar (P i)
  have hχ (i : ι) : χ i ≠ 1 := complexQuadraticChar_ne_one (P i) (hodd i)
  let ψ := residueTraceQuotientChar 1 c hc
  let A : O ⧸ Ideal.span {c} → ℂ := fun x => ∏ i, χ i (e x i)
  let G := ∑ x : O ⧸ Ideal.span {c}, A x * ψ x
  have hG : G = quadraticTraceGauss c hc := by
    change (∑ x : O ⧸ Ideal.span {c},
      (∏ i, ((quadraticChar (O ⧸ P i)).ringHomComp (Int.castRingHom ℂ)) (e x i)) * ψ x) = _
    rw [QuadraticPhase.ProductGauss.quadratic_factorization_equiv (fun i => O ⧸ P i) e ψ
      (residueTraceQuotientChar_primitive c hc) hodd]
    simp only [ψ, residueTraceQuotientChar_eq_principal, quadraticTraceGauss]
  have hphase : G / (‖ringComplex c‖ : ℂ) = fixedDualAverage c := by
    rw [hG]
    exact normalizedQuadraticTraceGauss_eq_fixedDualAverage c hc
  have hPoisson :
      (∑' z : O, A (Ideal.Quotient.mk (Ideal.span {c}) z) * W (‖ringComplex z‖ ^ 2 / Y)) =
      (Y / ‖ringComplex c‖ ^ 2 : ℝ) • (G * ∑' h : O,
        (∏ i, (χ i)⁻¹ (e (Ideal.Quotient.mk (Ideal.span {c}) h) i)) *
          paperRadialFourier W (Y * ‖ringComplex h‖ ^ 2 / ‖ringComplex c‖ ^ 2)) := by
    rw [actual_radial_poisson_trace W Y hY c hc A]
    congr 1
    rw [← tsum_mul_left]
    apply tsum_congr
    intro h
    rw [finite_crt_gauss_transform (fun i => O ⧸ P i) e χ hχ ψ]
    ring
  have hA (z : O) : A (Ideal.Quotient.mk (Ideal.span {c}) z) =
      primeCuspRowCharacter p (fun i => complexQuadraticChar (P i)) z := by
    change (∏ i, χ i (e (Ideal.Quotient.mk (Ideal.span {c}) z) i)) = _
    simp only [he]
    rfl
  simp only [hA, χ, complexQuadraticChar_inv, he] at hPoisson
  rw [hPoisson]
  change ((Y / ‖ringComplex c‖ ^ 2 : ℝ) : ℂ) *
      (G * ∑' h : O, (∏ i, complexQuadraticChar (P i) (Ideal.Quotient.mk (P i) h)) *
        paperRadialFourier W (Y * ‖ringComplex h‖ ^ 2 / ‖ringComplex c‖ ^ 2)) =
    ((Y : ℂ) * fixedDualAverage c / (‖ringComplex c‖ : ℂ)) *
      ∑' h : O, (∏ i, complexQuadraticChar (P i) (Ideal.Quotient.mk (P i) h)) *
        paperRadialFourier W (Y * ‖ringComplex h‖ ^ 2 / ‖ringComplex c‖ ^ 2)
  rw [← hphase]
  push_cast
  ring

end SchwartzPlanePoisson

namespace FiniteSieveOperator

variable {m n : Type*} [Fintype m] [Fintype n] [DecidableEq m] [DecidableEq n]

def operator (A : Matrix m n ℂ) : EuclideanSpace ℂ n →L[ℂ] EuclideanSpace ℂ m :=
  A.toEuclideanLin.toContinuousLinearMap

omit [DecidableEq m] in
@[simp] theorem operator_apply (A : Matrix m n ℂ) (x : EuclideanSpace ℂ n) (i : m) :
    operator A x i = ∑ j, A i j * x j := rfl

theorem operator_conjTranspose (A : Matrix m n ℂ) :
    operator A.conjTranspose = (operator A).adjoint := by
  unfold operator
  rw [Matrix.toEuclideanLin_conjTranspose_eq_adjoint, LinearMap.adjoint_toContinuousLinearMap]

theorem operator_conjTranspose_norm (A : Matrix m n ℂ) :
    ‖operator A.conjTranspose‖ = ‖operator A‖ := by
  rw [operator_conjTranspose]
  exact ContinuousLinearMap.adjoint.norm_map _

omit [DecidableEq m] in
theorem operator_zero : operator (0 : Matrix m n ℂ) = 0 := by
  ext x i
  simp

omit [DecidableEq m] in
theorem operator_add (A B : Matrix m n ℂ) : operator (A + B) = operator A + operator B := by
  ext x i
  simp [add_mul, Finset.sum_add_distrib]

omit [DecidableEq m] in
theorem operator_smul (c : ℂ) (A : Matrix m n ℂ) : operator (c • A) = c • operator A := by
  ext x i
  simp [Finset.mul_sum, mul_assoc]

omit [DecidableEq m] in
theorem operator_sum {κ : Type*} (S : Finset κ) (A : κ → Matrix m n ℂ) :
    operator (∑ k ∈ S, A k) = ∑ k ∈ S, operator (A k) := by
  classical
  induction S using Finset.induction_on with
  | empty => simp [operator_zero]
  | @insert a S ha ih => simp only [Finset.sum_insert ha, operator_add, ih]

omit [DecidableEq m] in
theorem diagonal_twist_norm_le (A : Matrix m n ℂ) (l : m → ℂ) (r : n → ℂ)
    (hl : ∀ i, ‖l i‖ ≤ 1) (hr : ∀ j, ‖r j‖ ≤ 1) :
    ‖operator (fun i j => l i * A i j * r j)‖ ≤ ‖operator A‖ := by
  apply ContinuousLinearMap.opNorm_le_bound _ (norm_nonneg _)
  intro x
  let y : EuclideanSpace ℂ n := WithLp.toLp 2 (fun j => r j * x j)
  have hy : ‖y‖ ≤ ‖x‖ := by
    apply (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mp
    rw [EuclideanSpace.norm_sq_eq, EuclideanSpace.norm_sq_eq]
    apply Finset.sum_le_sum
    intro j _
    change ‖r j * x j‖ ^ 2 ≤ ‖x j‖ ^ 2
    apply pow_le_pow_left₀ (norm_nonneg _)
    rw [norm_mul]
    exact mul_le_of_le_one_left (norm_nonneg _) (hr j)
  have heq (i : m) : operator (fun i j => l i * A i j * r j) x i = l i * operator A y i := by
    simp only [operator_apply, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    change l i * A i j * r j * x j = l i * (A i j * (r j * x j))
    ring
  have hz : ‖operator (fun i j => l i * A i j * r j) x‖ ≤ ‖operator A y‖ := by
    apply (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mp
    rw [EuclideanSpace.norm_sq_eq, EuclideanSpace.norm_sq_eq]
    apply Finset.sum_le_sum
    intro i _
    rw [heq, norm_mul]
    apply pow_le_pow_left₀ (by positivity)
    exact mul_le_of_le_one_left (norm_nonneg _) (hl i)
  exact hz.trans ((operator A).le_opNorm y |>.trans
    (mul_le_mul_of_nonneg_left hy (norm_nonneg _)))

omit [DecidableEq m] in
theorem separated_phase_norm_le {κ : Type*} [Fintype κ]
    (A B : Matrix m n ℂ) (c : κ → ℂ) (l : κ → m → ℂ) (r : κ → n → ℂ)
    (hl : ∀ k i, ‖l k i‖ ≤ 1) (hr : ∀ k j, ‖r k j‖ ≤ 1)
    (heq : ∀ i j, A i j = ∑ k, c k * (l k i * B i j * r k j)) :
    ‖operator A‖ ≤ (∑ k, ‖c k‖) * ‖operator B‖ := by
  let T : κ → Matrix m n ℂ := fun k i j => l k i * B i j * r k j
  have hA : A = ∑ k, c k • T k := by
    ext i j
    rw [Matrix.sum_apply]
    exact heq i j
  have hOp : operator A = ∑ k, c k • operator (T k) := by
    calc
      _ = operator (∑ k, c k • T k) := congrArg operator hA
      _ = ∑ k, operator (c k • T k) := operator_sum _ _
      _ = _ := Finset.sum_congr rfl (fun k _ => operator_smul (c k) (T k))
  rw [hOp]
  calc
    _ ≤ ∑ k, ‖c k • operator (T k)‖ := norm_sum_le _ _
    _ ≤ ∑ k, ‖c k‖ * ‖operator B‖ := by
      apply Finset.sum_le_sum
      intro k _
      rw [norm_smul]
      exact mul_le_mul_of_nonneg_left (diagonal_twist_norm_le B (l k) (r k) (hl k) (hr k))
        (norm_nonneg _)
    _ = _ := (Finset.sum_mul ..).symm

omit [DecidableEq m] in
theorem energy_bound (A : Matrix m n ℂ) (u : n → ℂ) :
    (∑ i, ‖∑ j, A i j * u j‖ ^ 2) ≤ ‖operator A‖ ^ 2 * ∑ j, ‖u j‖ ^ 2 := by
  let x : EuclideanSpace ℂ n := WithLp.toLp 2 u
  have h := (operator A).le_opNorm x
  have hs := pow_le_pow_left₀ (norm_nonneg _) h 2
  simpa only [mul_pow, EuclideanSpace.norm_sq_eq, operator_apply, x, PiLp.toLp_apply] using hs

theorem squared_norm_le_of_energy {m n : Type*} [Fintype m] [Fintype n]
    [DecidableEq m] [DecidableEq n]
    (A : Matrix m n ℂ) (C : ℝ) (hC : 0 ≤ C)
    (h : ∀ a : n → ℂ, (∑ i, ‖∑ j, A i j * a j‖ ^ 2) ≤ C * ∑ j, ‖a j‖ ^ 2) :
    ‖operator A‖ ^ 2 ≤ C := by
  have hop : ‖operator A‖ ≤ Real.sqrt C := by
    apply ContinuousLinearMap.opNorm_le_bound _ (Real.sqrt_nonneg C)
    intro a
    apply (sq_le_sq₀ (norm_nonneg _) (mul_nonneg (Real.sqrt_nonneg C) (norm_nonneg a))).mp
    simpa only [mul_pow, Real.sq_sqrt hC, EuclideanSpace.norm_sq_eq, operator_apply] using h a
  simpa only [Real.sq_sqrt hC] using pow_le_pow_left₀ (norm_nonneg _) hop 2

end FiniteSieveOperator

namespace SchwartzPlanePoisson
open Eisenstein

/-- The uniform finite-ball bound is the squared operator-norm bound for every prime-row matrix. -/
theorem primeSubsetRow_initial_operator_bound :
    ∃ K : ℝ, 0 < K ∧
      ∀ {ι m n : Type*} [DecidableEq ι] [Fintype m] [Fintype n] [DecidableEq m] [DecidableEq n]
        (p : ι → O) (hp : ∀ i, p i ≠ 0)
        [∀ i, (Ideal.span {p i}).IsMaximal]
        (hinj : Function.Injective (fun i => Ideal.span {p i}))
        (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) (hχ : ∀ i, χ i ≠ 1)
        (rows : m → O) (hrows : Function.Injective rows)
        (cols : n → Finset ι) (hcols : Function.Injective cols)
        (M N : ℝ), 1 ≤ M → 1 ≤ N →
        (∀ i, ‖ringComplex (rows i)‖ ^ 2 ≤ M) →
        (∀ j, primeSubsetNorm p (cols j) ≤ N) →
        ‖FiniteSieveOperator.operator (fun i j => primeSubsetRow p χ (cols j) (rows i))‖ ^ 2 ≤
          K * (M + N ^ 2) := by
  obtain ⟨K, hK, hb⟩ := primeSubsetRow_initial_sieve
  refine ⟨K, hK, ?_⟩
  intro ι m n _ _ _ _ _ p hp _ hinj χ hχ rows hrows cols hcols M N hM hN hRM hCN
  classical
  apply FiniteSieveOperator.squared_norm_le_of_energy _ _ (by positivity)
  intro a
  let R := Finset.univ.image rows
  have hR (z : O) (hz : z ∈ R) : ‖ringComplex z‖ ^ 2 ≤ M := by
    obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hz
    exact hRM i
  have h := hb p hp hinj χ hχ Finset.univ cols hcols.injOn N hN
    (fun j _ => hCN j) a M hM R hR
  have he : (∑ i, ‖∑ j, primeSubsetRow p χ (cols j) (rows i) * a j‖ ^ 2) =
      ∑ z ∈ R, ‖∑ j, a j * primeSubsetRow p χ (cols j) z‖ ^ 2 := by
    dsimp only [R]
    rw [Finset.sum_image]
    · simp only [mul_comm]
    · intro i _ j _ hij
      exact hrows hij
  rw [he]
  exact h

end SchwartzPlanePoisson

namespace SchwartzPlanePoisson
open Eisenstein QuadraticPhase.Eisenstein

local instance quotientFinite (c : O) [NeZero c] : Finite (O ⧸ Ideal.span {c}) :=
  finite_quotient_span (NeZero.ne c)

local instance quotientFintype (c : O) [NeZero c] : Fintype (O ⧸ Ideal.span {c}) :=
  Fintype.ofFinite _

/-- The trace character is trivial on integers: `exp(2πi Tr(z/λ)) = 1` for `z ∈ O`. -/
theorem traceChar_integral (z : O) :
    Complex.exp ((Algebra.trace ℚ K
      ((algebraMap O K z) / (algebraMap O K traceLambda * algebraMap O K 1)) : ℂ) *
        (2 * Real.pi * Complex.I)) = 1 := by
  rw [← principalTraceChar_apply 1 one_ne_zero z]
  have h : Ideal.Quotient.mk (Ideal.span {(1 : O)}) z = 0 := by
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.span_singleton_one]
    trivial
  rw [h, AddChar.map_zero_eq_one]

/-- **The CRT phase.** For `x = dx₁ + cx₂`, `ψ_{cd}(x²) = ψ_c(dx₁²) ψ_d(cx₂²)`. -/
theorem traceChar_crt_sq (c d : O) [NeZero c] [NeZero d] (x y : O) :
    principalTraceChar (c * d) (mul_ne_zero (NeZero.ne c) (NeZero.ne d))
        (Ideal.Quotient.mk _ ((d * x + c * y) ^ 2)) =
      principalTraceChar c (NeZero.ne c) (Ideal.Quotient.mk _ (d * x ^ 2)) *
        principalTraceChar d (NeZero.ne d) (Ideal.Quotient.mk _ (c * y ^ 2)) := by
  rw [principalTraceChar_apply, principalTraceChar_apply, principalTraceChar_apply,
    ← Complex.exp_add]
  have hinj := FaithfulSMul.algebraMap_injective O K
  have hc : algebraMap O K c ≠ 0 := fun h => NeZero.ne c (hinj (by rw [h, map_zero]))
  have hd : algebraMap O K d ≠ 0 := fun h => NeZero.ne d (hinj (by rw [h, map_zero]))
  have hl : algebraMap O K traceLambda ≠ 0 := fun h => traceLambda_ne_zero
    (hinj (by rw [h, map_zero]))
  have hsplit : (algebraMap O K ((d * x + c * y) ^ 2)) /
      (algebraMap O K traceLambda * algebraMap O K (c * d)) =
      (algebraMap O K (d * x ^ 2)) / (algebraMap O K traceLambda * algebraMap O K c) +
        (algebraMap O K (c * y ^ 2)) / (algebraMap O K traceLambda * algebraMap O K d) +
          (algebraMap O K (2 * x * y)) / (algebraMap O K traceLambda * algebraMap O K 1) := by
    simp only [map_mul, map_pow, map_add, map_one, map_ofNat]
    field_simp
    ring
  have h1 := traceChar_integral (2 * x * y)
  rw [hsplit, map_add, map_add, Rat.cast_add, Rat.cast_add, add_mul, add_mul, Complex.exp_add, h1,
    mul_one]

/-- A representative of a residue class. -/
def qrep {I : Ideal O} (x : O ⧸ I) : O := Classical.choose (Ideal.Quotient.mk_surjective x)

theorem mk_qrep {I : Ideal O} (x : O ⧸ I) : Ideal.Quotient.mk I (qrep x) = x :=
  Classical.choose_spec (Ideal.Quotient.mk_surjective x)

/-- The CRT parametrization `(x₁, x₂) ↦ dx₁ + cx₂` of `O/(cd)`. -/
def crtParam (c d : O) (p : (O ⧸ Ideal.span {c}) × (O ⧸ Ideal.span {d})) :
    O ⧸ Ideal.span {c * d} :=
  Ideal.Quotient.mk _ (d * qrep p.1 + c * qrep p.2)

theorem crtParam_bijective (c d : O) [NeZero c] [NeZero d] (hcd : IsCoprime c d) :
    Function.Bijective (crtParam c d) := by
  haveI : NeZero (c * d) := ⟨mul_ne_zero (NeZero.ne c) (NeZero.ne d)⟩
  refine (Fintype.bijective_iff_injective_and_card _).mpr ⟨?_, ?_⟩
  · rintro ⟨x₁, x₂⟩ ⟨y₁, y₂⟩ h
    simp only [crtParam, Ideal.Quotient.eq, Ideal.mem_span_singleton] at h
    have e : d * qrep x₁ + c * qrep x₂ - (d * qrep y₁ + c * qrep y₂) =
        d * (qrep x₁ - qrep y₁) + c * (qrep x₂ - qrep y₂) := by ring
    rw [e] at h
    have hc : c ∣ d * (qrep x₁ - qrep y₁) :=
      (dvd_add_left (dvd_mul_right c _)).mp ((dvd_mul_right c d).trans h)
    have hd : d ∣ c * (qrep x₂ - qrep y₂) :=
      (dvd_add_right (dvd_mul_right d _)).mp ((dvd_mul_left d c).trans h)
    have h1 : x₁ = y₁ := by
      rw [← mk_qrep x₁, ← mk_qrep y₁, Ideal.Quotient.eq, Ideal.mem_span_singleton]
      exact hcd.dvd_of_dvd_mul_left hc
    have h2 : x₂ = y₂ := by
      rw [← mk_qrep x₂, ← mk_qrep y₂, Ideal.Quotient.eq, Ideal.mem_span_singleton]
      exact hcd.symm.dvd_of_dvd_mul_left hd
    rw [h1, h2]
  · have hcard : ∀ (e : O) [NeZero e], Fintype.card (O ⧸ Ideal.span {e}) =
        Ideal.absNorm (Ideal.span {e}) := fun e _ => by
      rw [Ideal.absNorm_apply, Submodule.cardQuot_apply, Nat.card_eq_fintype_card]
    rw [Fintype.card_prod, hcard, hcard, hcard, ← Ideal.span_singleton_mul_span_singleton,
      map_mul]

/-- The quadratic trace sum, written with the instance of this file. -/
theorem quadraticTraceGauss_eq_sum (c : O) [NeZero c] :
    quadraticTraceGauss c (NeZero.ne c) =
      ∑ x : O ⧸ Ideal.span {c}, principalTraceChar c (NeZero.ne c) (x ^ 2) := rfl

/-- **The CRT splitting.** For coprime `c, d`,
`Σ_{x mod cd} ψ_{cd}(x²) = Σ_{x₁ mod c} ψ_c(dx₁²) · Σ_{x₂ mod d} ψ_d(cx₂²)`. -/
theorem quadraticTraceGauss_mul (c d : O) [NeZero c] [NeZero d] (hcd : IsCoprime c d) :
    quadraticTraceGauss (c * d) (mul_ne_zero (NeZero.ne c) (NeZero.ne d)) =
      (∑ x : O ⧸ Ideal.span {c}, principalTraceChar c (NeZero.ne c)
          (Ideal.Quotient.mk _ d * x ^ 2)) *
        ∑ y : O ⧸ Ideal.span {d}, principalTraceChar d (NeZero.ne d)
          (Ideal.Quotient.mk _ c * y ^ 2) := by
  haveI : NeZero (c * d) := ⟨mul_ne_zero (NeZero.ne c) (NeZero.ne d)⟩
  rw [quadraticTraceGauss_eq_sum, ← (Fintype.sum_bijective _ (crtParam_bijective c d hcd)
    (fun p => principalTraceChar (c * d) _ (crtParam c d p ^ 2)) _ fun _ => rfl),
    Fintype.sum_prod_type, Finset.sum_mul_sum]
  refine Finset.sum_congr rfl fun x _ => Finset.sum_congr rfl fun y _ => ?_
  have hx : Ideal.Quotient.mk (Ideal.span {c}) (d * qrep x ^ 2) =
      Ideal.Quotient.mk _ d * x ^ 2 := by rw [map_mul, map_pow, mk_qrep]
  have hy : Ideal.Quotient.mk (Ideal.span {d}) (c * qrep y ^ 2) =
      Ideal.Quotient.mk _ c * y ^ 2 := by rw [map_mul, map_pow, mk_qrep]
  show principalTraceChar (c * d) _ (Ideal.Quotient.mk _ (d * qrep x + c * qrep y) ^ 2) = _
  rw [← map_pow, traceChar_crt_sq, hx, hy]

/-! ### Odd primes -/

section Prime

variable (p : O) [NeZero p] [hP : (Ideal.span {p}).IsMaximal]

omit [NeZero p] hP in
/-- At an odd prime the residue ring has characteristic different from two. -/
theorem ringChar_ne_two (h2 : (2 : O) ∉ Ideal.span {p}) : ringChar (O ⧸ Ideal.span {p}) ≠ 2 := by
  intro h
  apply h2
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_ofNat]
  have := ringChar.spec (O ⧸ Ideal.span {p}) 2
  exact_mod_cast this.mpr (by rw [h])

/-- **Squares are counted by `1 + η`.** `Σ_{x mod p} ψ_p(ux²) = η_p(u) G(η_p)` for `p ∤ u`. -/
theorem sum_traceChar_mul_sq (h2 : (2 : O) ∉ Ideal.span {p}) {u : O ⧸ Ideal.span {p}}
    (hu : u ≠ 0) :
    ∑ x : O ⧸ Ideal.span {p}, principalTraceChar p (NeZero.ne p) (u * x ^ 2) =
      complexQuadraticChar (Ideal.span {p}) u *
        gaussSum (complexQuadraticChar (Ideal.span {p})) (principalTraceChar p (NeZero.ne p)) := by
  letI : Field (O ⧸ Ideal.span {p}) := Ideal.Quotient.field _
  set ψ := principalTraceChar p (NeZero.ne p)
  set η := complexQuadraticChar (Ideal.span {p})
  have hchar := ringChar_ne_two p h2
  -- group the `x` by their square
  have hfib : ∑ x : O ⧸ Ideal.span {p}, ψ (u * x ^ 2) =
      ∑ y : O ⧸ Ideal.span {p}, ((Finset.univ.filter fun x => x ^ 2 = y).card : ℂ) * ψ (u * y) := by
    rw [← Finset.sum_fiberwise Finset.univ (fun x => x ^ 2) (fun x => ψ (u * x ^ 2))]
    refine Finset.sum_congr rfl fun y _ => ?_
    rw [Finset.sum_congr rfl fun x hx => by rw [(Finset.mem_filter.mp hx).2], Finset.sum_const,
      nsmul_eq_mul]
  have hcount : ∀ y : O ⧸ Ideal.span {p},
      ((Finset.univ.filter fun x => x ^ 2 = y).card : ℂ) = η y + 1 := by
    intro y
    have h := quadraticChar_card_sqrts hchar y
    rw [Set.toFinset_setOf] at h
    simp only [η, complexQuadraticChar, MulChar.ringHomComp_apply, eq_intCast]
    exact_mod_cast h
  rw [hfib]
  simp only [hcount, add_mul, one_mul, Finset.sum_add_distrib]
  have hzero : ∑ y : O ⧸ Ideal.span {p}, ψ (u * y) = 0 := by
    have := AddChar.sum_mulShift u (principalTraceChar_primitive p (NeZero.ne p))
    rw [if_neg hu, Nat.cast_zero] at this
    rw [← this]
    exact Finset.sum_congr rfl fun y _ => by rw [mul_comm]
  rw [hzero, add_zero]
  -- the Gauss sum at the unit multiplier `u`
  have hunit : IsUnit u := isUnit_iff_ne_zero.mpr hu
  have hg := gaussSum_mulShift η ψ hunit.unit
  rw [IsUnit.unit_spec] at hg
  have hsq : η u * η u = 1 := by
    simp only [η, complexQuadraticChar, MulChar.ringHomComp_apply, eq_intCast]
    rw [← Int.cast_mul, ← sq, quadraticChar_sq_one hu, Int.cast_one]
  calc ∑ y, η y * ψ (u * y) = gaussSum η (AddChar.mulShift ψ u) := rfl
    _ = η u * (η u * gaussSum η (AddChar.mulShift ψ u)) := by
        rw [← mul_assoc, hsq, one_mul]
    _ = η u * gaussSum η ψ := by rw [hg]

end Prime

/-- **Quadratic reciprocity over `ℤ[ω]`.** For coprime odd primes `p, q`,
`η_p(q) η_q(p) Γ(p) Γ(q) = Γ(pq)`, where `Γ(c) = |c|⁻¹ Σ_{x mod c} ψ_c(x²)` depends only on
`c mod 4`. -/
theorem quadratic_reciprocity (p q : O) [NeZero p] [NeZero q] [(Ideal.span {p}).IsMaximal]
    [(Ideal.span {q}).IsMaximal] (hp2 : (2 : O) ∉ Ideal.span {p}) (hq2 : (2 : O) ∉ Ideal.span {q})
    (hpq : IsCoprime p q) :
    complexQuadraticChar (Ideal.span {p}) (Ideal.Quotient.mk _ q) *
        complexQuadraticChar (Ideal.span {q}) (Ideal.Quotient.mk _ p) *
          normalizedQuadraticTraceGauss p (NeZero.ne p) *
            normalizedQuadraticTraceGauss q (NeZero.ne q) =
      normalizedQuadraticTraceGauss (p * q) (mul_ne_zero (NeZero.ne p) (NeZero.ne q)) := by
  -- neither prime divides the other
  have hnd : ∀ (a b : O) [(Ideal.span {a}).IsMaximal], IsCoprime a b →
      Ideal.Quotient.mk (Ideal.span {a}) b ≠ 0 := by
    intro a b ha hab h
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at h
    exact ha.ne_top (Ideal.span_singleton_eq_top.mpr (hab.isUnit_of_dvd' (dvd_refl a) h))
  have hqp := hnd p q hpq
  have hpq' := hnd q p hpq.symm
  -- the three quadratic trace sums
  have hone : ∀ (a : O) [NeZero a] [(Ideal.span {a}).IsMaximal], (2 : O) ∉ Ideal.span {a} →
      quadraticTraceGauss a (NeZero.ne a) =
        gaussSum (complexQuadraticChar (Ideal.span {a})) (principalTraceChar a (NeZero.ne a)) := by
    intro a _ _ ha2
    have h := sum_traceChar_mul_sq a ha2 (u := 1) one_ne_zero
    simp only [one_mul, MulChar.map_one] at h
    rw [quadraticTraceGauss_eq_sum, h]
  have hprod := quadraticTraceGauss_mul p q hpq
  rw [sum_traceChar_mul_sq p hp2 hqp, sum_traceChar_mul_sq q hq2 hpq'] at hprod
  unfold normalizedQuadraticTraceGauss
  rw [hprod, hone p hp2, hone q hq2, map_mul, norm_mul, Complex.ofReal_mul]
  have hpn : (‖ringComplex p‖ : ℂ) ≠ 0 := by
    exact_mod_cast norm_ne_zero_iff.mpr fun h => NeZero.ne p (ringComplex_injective
      (by rw [h, map_zero]))
  have hqn : (‖ringComplex q‖ : ℂ) ≠ 0 := by
    exact_mod_cast norm_ne_zero_iff.mpr fun h => NeZero.ne q (ringComplex_injective
      (by rw [h, map_zero]))
  field_simp


end SchwartzPlanePoisson


namespace SchwartzPlanePoisson
open Eisenstein MulChar AddChar

lemma primitive_unit_shift {R : Type*} [CommRing R] (ψ : AddChar R ℂ)
    (hψ : ψ.IsPrimitive) (u : R) (hu : IsUnit u) : (ψ.mulShift u).IsPrimitive := by
  obtain ⟨v, rfl⟩ := hu
  intro a ha
  rw [AddChar.mulShift_mulShift]
  apply hψ
  intro h
  apply ha
  have hh := congrArg (fun b : R => (↑v⁻¹ : R) * b) h
  simpa only [← mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_mul, mul_zero] using hh

lemma finite_quadratic_character_inv {F : Type*} [Field F] [Fintype F] :
    (((quadraticChar F).ringHomComp (Int.castRingHom ℂ)) : MulChar F ℂ)⁻¹ =
      (quadraticChar F).ringHomComp (Int.castRingHom ℂ) := by
  ext x
  rw [← MulChar.star_apply']
  change starRingEnd ℂ ((quadraticChar F x : ℤ) : ℂ) = ((quadraticChar F x : ℤ) : ℂ)
  exact map_intCast (starRingEnd ℂ) _

/-- A unit multiplier of a quadratic square sum contributes exactly its quadratic character. -/
theorem finite_crt_quadratic_square_twist {ι R : Type*} [Fintype ι] [DecidableEq ι]
    (F : ι → Type*) [∀ i, Field (F i)] [∀ i, Fintype (F i)]
    [CommRing R] [Fintype R] (e : R ≃+* ∀ i, F i)
    (hodd : ∀ i, ringChar (F i) ≠ 2) (ψ : AddChar R ℂ) (hψ : ψ.IsPrimitive)
    (u : R) (hu : IsUnit u) :
    (∑ x : R, ψ (u * x ^ 2)) =
      (∏ i, (quadraticChar (F i) (e u i) : ℂ)) * ∑ x : R, ψ (x ^ 2) := by
  let χ : ∀ i, MulChar (F i) ℂ := fun i =>
    (quadraticChar (F i)).ringHomComp (Int.castRingHom ℂ)
  have hχ (i : ι) : χ i ≠ 1 :=
    (MulChar.ringHomComp_ne_one_iff (Int.cast_injective (α := ℂ))).mpr
      (quadraticChar_ne_one (hodd i))
  have ht := QuadraticPhase.ProductGauss.quadratic_factorization_equiv F e
    (ψ.mulShift u) (primitive_unit_shift ψ hψ u hu) hodd
  have h0 := QuadraticPhase.ProductGauss.quadratic_factorization_equiv F e ψ hψ hodd
  change (∑ x : R, (∏ i, χ i (e x i)) * ψ (u * x)) = ∑ x : R, ψ (u * x ^ 2) at ht
  rw [← ht, finite_crt_gauss_transform F e χ hχ ψ]
  change (∏ i, (χ i)⁻¹ (e u i)) * (∑ x : R, (∏ i, χ i (e x i)) * ψ x) = _
  rw [h0]
  congr 1
  apply Finset.prod_congr rfl
  intro i _
  dsimp only [χ]
  rw [finite_quadratic_character_inv]
  rfl

/-- Primitive quadratic square sums on products of odd fields have square-root mass. -/
theorem finite_crt_quadratic_square_norm_sq {ι R : Type*} [Fintype ι] [DecidableEq ι]
    (F : ι → Type*) [∀ i, Field (F i)] [∀ i, Fintype (F i)]
    [CommRing R] [Fintype R] (e : R ≃+* ∀ i, F i)
    (hodd : ∀ i, ringChar (F i) ≠ 2) (ψ : AddChar R ℂ) (hψ : ψ.IsPrimitive) :
    ‖∑ x : R, ψ (x ^ 2)‖ ^ 2 = (Fintype.card R : ℝ) := by
  let χ : ∀ i, MulChar (F i) ℂ := fun i =>
    (quadraticChar (F i)).ringHomComp (Int.castRingHom ℂ)
  have hχ (i : ι) : χ i ≠ 1 :=
    (MulChar.ringHomComp_ne_one_iff (Int.cast_injective (α := ℂ))).mpr
      (quadraticChar_ne_one (hodd i))
  rw [← QuadraticPhase.ProductGauss.quadratic_factorization_equiv F e ψ hψ hodd]
  exact finite_crt_gauss_norm_sq F e χ hχ ψ hψ

end SchwartzPlanePoisson

namespace SchwartzPlanePoisson
open Eisenstein QuadraticPhase.Eisenstein

/-- CRT on the principal ideal generated by a product of distinct prime generators. -/
def primeProductCRT {ι : Type*} [Fintype ι] [DecidableEq ι]
    (p : ι → O) [∀ i, (Ideal.span {p i}).IsMaximal]
    (hinj : Function.Injective (fun i => Ideal.span {p i})) :
    (O ⧸ Ideal.span {∏ i, p i}) ≃+* ∀ i, O ⧸ Ideal.span {p i} :=
  (Ideal.quotEquivOfEq (span_finset_prime_product p Finset.univ)).trans
    (Eisenstein.primeCRT (fun i => Ideal.span {p i}) hinj)

lemma primeProductCRT_mk {ι : Type*} [Fintype ι] [DecidableEq ι]
    (p : ι → O) [∀ i, (Ideal.span {p i}).IsMaximal]
    (hinj : Function.Injective (fun i => Ideal.span {p i})) (z : O) (i : ι) :
    primeProductCRT p hinj (Ideal.Quotient.mk (Ideal.span {∏ i, p i}) z) i =
      Ideal.Quotient.mk (Ideal.span {p i}) z := by
  simp only [primeProductCRT, RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk, Eisenstein.primeCRT]
  rfl

lemma prime_quadratic_trace_mass {ι : Type*} [Fintype ι] [DecidableEq ι]
    (p : ι → O) (hp : ∀ i, p i ≠ 0) [∀ i, (Ideal.span {p i}).IsMaximal]
    (hinj : Function.Injective (fun i => Ideal.span {p i}))
    (hodd : ∀ i, ringChar (O ⧸ Ideal.span {p i}) ≠ 2) :
    ‖quadraticTraceGauss (∏ i, p i) (Finset.prod_ne_zero_iff.mpr (fun i _ => hp i))‖ ^ 2 =
      ‖ringComplex (∏ i, p i)‖ ^ 2 := by
  let c := ∏ i, p i
  have hc : c ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun i _ => hp i)
  let : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
  let : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
  change ‖∑ x : O ⧸ Ideal.span {c}, principalTraceChar c hc (x ^ 2)‖ ^ 2 = _
  rw [finite_crt_quadratic_square_norm_sq (fun i => O ⧸ Ideal.span {p i})
    (primeProductCRT p hinj) hodd (principalTraceChar c hc) (principalTraceChar_primitive c hc)]
  simpa only [Ideal.absNorm_apply, Submodule.cardQuot_apply, Nat.card_eq_fintype_card]
    using (ringComplex_norm_sq_eq_absNorm_span c).symm

lemma prime_quadratic_phase_norm {ι : Type*} [Fintype ι] [DecidableEq ι]
    (p : ι → O) (hp : ∀ i, p i ≠ 0) [∀ i, (Ideal.span {p i}).IsMaximal]
    (hinj : Function.Injective (fun i => Ideal.span {p i}))
    (hodd : ∀ i, ringChar (O ⧸ Ideal.span {p i}) ≠ 2) :
    ‖fixedDualAverage (∏ i, p i)‖ = 1 := by
  have hc : (∏ i, p i) ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun i _ => hp i)
  have hn := (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp
    (prime_quadratic_trace_mass p hp hinj hodd)
  rw [← normalizedQuadraticTraceGauss_eq_fixedDualAverage _ hc,
    normalizedQuadraticTraceGauss, norm_div, hn, Complex.norm_real,
    Real.norm_of_nonneg (norm_nonneg _), div_self (norm_ne_zero_iff.mpr (ringComplex_ne_zero hc))]

/-- The quadratic trace square sum with an integral multiplier. -/
def quadraticTraceTwist (c : O) (hc : c ≠ 0) (u : O) : ℂ :=
  letI : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
  letI : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
  ∑ x : O ⧸ Ideal.span {c}, principalTraceChar c hc
    (Ideal.Quotient.mk (Ideal.span {c}) u * x ^ 2)

lemma prime_quadratic_trace_twist {ι : Type*} [Fintype ι] [DecidableEq ι]
    (p : ι → O) (hp : ∀ i, p i ≠ 0) [∀ i, (Ideal.span {p i}).IsMaximal]
    (hinj : Function.Injective (fun i => Ideal.span {p i}))
    (hodd : ∀ i, ringChar (O ⧸ Ideal.span {p i}) ≠ 2)
    (u : O) (hu : IsCoprime (∏ i, p i) u) :
    quadraticTraceTwist (∏ i, p i) (Finset.prod_ne_zero_iff.mpr (fun i _ => hp i)) u =
      primeCuspRowCharacter p (fun i => complexQuadraticChar (Ideal.span {p i})) u *
        quadraticTraceGauss (∏ i, p i) (Finset.prod_ne_zero_iff.mpr (fun i _ => hp i)) := by
  let c := ∏ i, p i
  have hc : c ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun i _ => hp i)
  let : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
  let : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
  have hunit : IsUnit (Ideal.Quotient.mk (Ideal.span {c}) u) := by
    change IsCoprime c u at hu
    obtain ⟨a, b, hab⟩ := hu
    have hm := congrArg (Ideal.Quotient.mk (Ideal.span {c})) hab
    have hz : Ideal.Quotient.mk (Ideal.span {c}) c = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self c)
    simp only [map_add, map_mul, map_one, hz, mul_zero, zero_add] at hm
    exact IsUnit.of_mul_eq_one_right _ hm
  have ht := finite_crt_quadratic_square_twist (fun i => O ⧸ Ideal.span {p i})
    (primeProductCRT p hinj) hodd (principalTraceChar c hc) (principalTraceChar_primitive c hc)
    (Ideal.Quotient.mk (Ideal.span {c}) u) hunit
  change (∑ x : O ⧸ Ideal.span {c}, principalTraceChar c hc
      (Ideal.Quotient.mk (Ideal.span {c}) u * x ^ 2)) =
    (∏ i, (quadraticChar (O ⧸ Ideal.span {p i}) (Ideal.Quotient.mk (Ideal.span {p i}) u) : ℂ)) *
      ∑ x : O ⧸ Ideal.span {c}, principalTraceChar c hc (x ^ 2)
  simpa only [c, primeProductCRT_mk] using ht

end SchwartzPlanePoisson

namespace SchwartzPlanePoisson
open Eisenstein QuadraticPhase.Eisenstein

lemma primeCuspRowCharacter_restrict {ι : Type*} (p : ι → O)
    (χ : ∀ i, MulChar (O ⧸ Ideal.span {p i}) ℂ) (S : Finset ι) (z : O) :
    primeCuspRowCharacter (fun i : S => p i.val) (fun i => χ i.val) z =
      primeSubsetRow p χ S z := by
  classical
  change (∏ i : S, χ i.val (Ideal.Quotient.mk (Ideal.span {p i.val}) z)) =
    ∏ i ∈ S, χ i (Ideal.Quotient.mk (Ideal.span {p i}) z)
  exact Finset.prod_coe_sort (s := S)
    (f := fun i : ι => χ i (Ideal.Quotient.mk (Ideal.span {p i}) z))

/-- Quadratic residue symbol between squarefree products in a common prime family. -/
def quadraticSubsetSymbol {ι : Type*} (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal] (S T : Finset ι) : ℂ :=
  primeSubsetRow p (fun i => complexQuadraticChar (Ideal.span {p i})) S (∏ i ∈ T, p i)

lemma prime_subsets_coprime {ι : Type*} [DecidableEq ι] (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal]
    (hinj : Function.Injective (fun i => Ideal.span {p i}))
    (S T : Finset ι) (hd : Disjoint S T) : IsCoprime (∏ i ∈ S, p i) (∏ i ∈ T, p i) := by
  apply IsCoprime.prod_left
  intro i hi
  apply IsCoprime.prod_right
  intro j hj
  have hij : i ≠ j := by
    intro h
    subst j
    exact Finset.disjoint_left.mp hd hi hj
  exact (Ideal.isCoprime_span_singleton_iff _ _).mp
    (Ideal.isCoprime_of_isMaximal (hinj.ne hij))

lemma quadraticSubsetSymbol_zero_of_overlap {ι : Type*} [DecidableEq ι]
    (p : ι → O) [∀ i, (Ideal.span {p i}).IsMaximal]
    (S T : Finset ι) (hd : ¬ Disjoint S T) : quadraticSubsetSymbol p S T = 0 := by
  obtain ⟨i, hi, hj⟩ := Finset.not_disjoint_iff.mp hd
  unfold quadraticSubsetSymbol primeSubsetRow
  apply Finset.prod_eq_zero hi
  have hz : Ideal.Quotient.mk (Ideal.span {p i}) (∏ j ∈ T, p j) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton.mpr (Finset.dvd_prod_of_mem p hj))
  rw [hz, MulChar.map_zero]

lemma quadraticSubsetRow_sq {ι : Type*} (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal] (S : Finset ι) (z : O)
    (hz : IsCoprime (∏ i ∈ S, p i) z) :
    primeSubsetRow p (fun i => complexQuadraticChar (Ideal.span {p i})) S z ^ 2 = 1 := by
  rw [primeSubsetRow, ← Finset.prod_pow]
  apply Finset.prod_eq_one
  intro i hi
  have hn : Ideal.Quotient.mk (Ideal.span {p i}) z ≠ 0 := by
    intro h
    have hd : p i ∣ z := Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp h)
    have hu := hz.isUnit_of_dvd' (Finset.dvd_prod_of_mem p hi) hd
    exact (inferInstance : (Ideal.span {p i}).IsMaximal).ne_top (Ideal.span_singleton_eq_top.mpr hu)
  change (quadraticChar (O ⧸ Ideal.span {p i}) (Ideal.Quotient.mk (Ideal.span {p i}) z) : ℂ) ^ 2 = 1
  exact_mod_cast quadraticChar_sq_one hn

/-- Composite quadratic reciprocity has only the fixed modulo-four Gauss phase. -/
theorem quadraticSubsetSymbol_reciprocity {ι : Type*} [DecidableEq ι]
    (p : ι → O) (hp : ∀ i, p i ≠ 0) [∀ i, (Ideal.span {p i}).IsMaximal]
    (hinj : Function.Injective (fun i => Ideal.span {p i}))
    (hodd : ∀ i, ringChar (O ⧸ Ideal.span {p i}) ≠ 2) (S T : Finset ι) :
    quadraticSubsetSymbol p S T =
      (fixedDualAverage ((∏ i ∈ S, p i) * (∏ i ∈ T, p i)) /
        (fixedDualAverage (∏ i ∈ S, p i) * fixedDualAverage (∏ i ∈ T, p i))) *
          quadraticSubsetSymbol p T S := by
  classical
  by_cases hd : Disjoint S T
  · let c := ∏ i ∈ S, p i
    let d := ∏ i ∈ T, p i
    have hc : c ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun i _ => hp i)
    have hd0 : d ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun i _ => hp i)
    letI : NeZero c := ⟨hc⟩
    letI : NeZero d := ⟨hd0⟩
    have hcd : IsCoprime c d := prime_subsets_coprime p hinj S T hd
    have hs : quadraticTraceTwist c hc d =
        quadraticSubsetSymbol p S T * quadraticTraceGauss c hc := by
      have h := prime_quadratic_trace_twist (fun i : S => p i.val) (fun i => hp i.val)
        (hinj.comp Subtype.val_injective) (fun i => hodd i.val) d
        (by simpa only [Finset.prod_coe_sort] using hcd)
      rw [primeCuspRowCharacter_restrict p (fun i => complexQuadraticChar (Ideal.span {p i})) S d] at h
      simpa only [Finset.prod_coe_sort, quadraticSubsetSymbol, c, d] using h
    have ht : quadraticTraceTwist d hd0 c =
        quadraticSubsetSymbol p T S * quadraticTraceGauss d hd0 := by
      have h := prime_quadratic_trace_twist (fun i : T => p i.val) (fun i => hp i.val)
        (hinj.comp Subtype.val_injective) (fun i => hodd i.val) c
        (by simpa only [Finset.prod_coe_sort] using hcd.symm)
      rw [primeCuspRowCharacter_restrict p (fun i => complexQuadraticChar (Ideal.span {p i})) T c] at h
      simpa only [Finset.prod_coe_sort, quadraticSubsetSymbol, c, d] using h
    have hcrt := quadraticTraceGauss_mul c d hcd
    change quadraticTraceGauss (c * d) (mul_ne_zero hc hd0) =
      quadraticTraceTwist c hc d * quadraticTraceTwist d hd0 c at hcrt
    rw [hs, ht] at hcrt
    have hphase : fixedDualAverage (c * d) =
        (quadraticSubsetSymbol p S T * quadraticSubsetSymbol p T S) *
          (fixedDualAverage c * fixedDualAverage d) := by
      rw [← normalizedQuadraticTraceGauss_eq_fixedDualAverage _ (mul_ne_zero hc hd0),
        ← normalizedQuadraticTraceGauss_eq_fixedDualAverage c hc,
        ← normalizedQuadraticTraceGauss_eq_fixedDualAverage d hd0]
      unfold normalizedQuadraticTraceGauss
      rw [hcrt, map_mul, norm_mul, Complex.ofReal_mul]
      ring
    have hcn : ‖fixedDualAverage c‖ = 1 := by
      simpa only [c, Finset.prod_coe_sort] using prime_quadratic_phase_norm
        (fun i : S => p i.val) (fun i => hp i.val)
        (hinj.comp Subtype.val_injective) (fun i => hodd i.val)
    have hdn : ‖fixedDualAverage d‖ = 1 := by
      simpa only [d, Finset.prod_coe_sort] using prime_quadratic_phase_norm
        (fun i : T => p i.val) (fun i => hp i.val)
        (hinj.comp Subtype.val_injective) (fun i => hodd i.val)
    have hcphase : fixedDualAverage c ≠ 0 := norm_ne_zero_iff.mp (by rw [hcn]; exact one_ne_zero)
    have hdphase : fixedDualAverage d ≠ 0 := norm_ne_zero_iff.mp (by rw [hdn]; exact one_ne_zero)
    have hprod : quadraticSubsetSymbol p S T * quadraticSubsetSymbol p T S =
        fixedDualAverage (c * d) / (fixedDualAverage c * fixedDualAverage d) := by
      apply (eq_div_iff (mul_ne_zero hcphase hdphase)).mpr
      exact hphase.symm
    have hsq : quadraticSubsetSymbol p T S ^ 2 = 1 := quadraticSubsetRow_sq p T c hcd.symm
    calc
      _ = quadraticSubsetSymbol p S T * quadraticSubsetSymbol p T S ^ 2 := by rw [hsq, mul_one]
      _ = _ := by rw [pow_two, ← mul_assoc, hprod]
  · rw [quadraticSubsetSymbol_zero_of_overlap p S T hd,
      quadraticSubsetSymbol_zero_of_overlap p T S (fun h => hd h.symm), mul_zero]

end SchwartzPlanePoisson

namespace SchwartzPlanePoisson
open Eisenstein Eisenstein.Coordinates QuadraticPhase.Eisenstein

/-- The four-term Gauss average is bounded by two, and every nonzero value has modulus at least one. -/
lemma fixedDualAverage_bounds (c : O) :
    ‖fixedDualAverage c‖ ≤ 2 ∧ ‖(fixedDualAverage c)⁻¹‖ ≤ 1 := by
  obtain ⟨⟨a, b⟩, hab⟩ := (rationalCoordEquiv 4 (by decide)).surjective
    (Ideal.Quotient.mk (Ideal.span {(4 : O)}) c)
  change Ideal.Quotient.mk (Ideal.span {(4 : O)})
    (eval (ZMod.cast a) (ZMod.cast b)) = Ideal.Quotient.mk (Ideal.span {(4 : O)}) c at hab
  rw [fixedDualAverage_eq_of_mod_four c _ hab.symm, fixedDualAverage_formula]
  fin_cases a <;> fin_cases b <;>
    norm_num [ZMod.cast, ZMod.val, zpow_neg, zpow_ofNat, Complex.I_sq, Complex.I_pow_three, Complex.inv_I] <;>
    ring_nf <;> norm_num [zpow_ofNat, Complex.I_sq, Complex.I_pow_three, Complex.inv_I]

abbrev QuadraticRayRing := O ⧸ Ideal.span {(4 : O)}

noncomputable instance quadraticRayRingFintype : Fintype QuadraticRayRing := by
  letI : Finite QuadraticRayRing := finite_quotient_span (by norm_num : (4 : O) ≠ 0)
  exact Fintype.ofFinite _

lemma quadraticRayRing_card : Fintype.card QuadraticRayRing = 16 := by
  have h := rational_modulus_card 4
  simpa only [Nat.card_eq_fintype_card, Nat.cast_ofNat, show (4 : ℕ) ^ 2 = 16 by decide] using h

def rayQuadraticPhase (r : QuadraticRayRing) : ℂ :=
  fixedDualAverage (QuadraticPhase.Eisenstein.GaussianShiftedPartition.representative 4 r)

lemma rayQuadraticPhase_mk (c : O) :
    rayQuadraticPhase (Ideal.Quotient.mk (Ideal.span {(4 : O)}) c) = fixedDualAverage c := by
  apply fixedDualAverage_eq_of_mod_four
  exact QuadraticPhase.Eisenstein.GaussianShiftedPartition.representative_spec _ _

def rayQuadraticPair (r s : QuadraticRayRing) : ℂ :=
  rayQuadraticPhase (r * s) / (rayQuadraticPhase r * rayQuadraticPhase s)

lemma rayQuadraticPair_mk (c d : O) :
    rayQuadraticPair (Ideal.Quotient.mk (Ideal.span {(4 : O)}) c)
      (Ideal.Quotient.mk (Ideal.span {(4 : O)}) d) =
      fixedDualAverage (c * d) / (fixedDualAverage c * fixedDualAverage d) := by
  simp only [rayQuadraticPair, ← map_mul, rayQuadraticPhase_mk]

lemma rayQuadraticPair_norm (r s : QuadraticRayRing) : ‖rayQuadraticPair r s‖ ≤ 2 := by
  rw [rayQuadraticPair, div_eq_mul_inv, mul_inv_rev, norm_mul, norm_mul]
  have hr := (fixedDualAverage_bounds (QuadraticPhase.Eisenstein.GaussianShiftedPartition.representative 4 r)).2
  have hs := (fixedDualAverage_bounds (QuadraticPhase.Eisenstein.GaussianShiftedPartition.representative 4 s)).2
  have hprod := (fixedDualAverage_bounds (QuadraticPhase.Eisenstein.GaussianShiftedPartition.representative 4 (r * s))).1
  exact (mul_le_mul hprod
    ((mul_le_mul hs hr (norm_nonneg _) zero_le_one).trans_eq (one_mul 1))
    (mul_nonneg (norm_nonneg _) (norm_nonneg _)) (by norm_num)).trans_eq (mul_one 2)

lemma rayQuadraticPair_sum_norm :
    (∑ r : QuadraticRayRing, ∑ s : QuadraticRayRing, ‖rayQuadraticPair r s‖) ≤ 512 := by
  calc
    _ ≤ ∑ _r : QuadraticRayRing, ∑ _s : QuadraticRayRing, (2 : ℝ) :=
      Finset.sum_le_sum (fun r _ => Finset.sum_le_sum (fun s _ => rayQuadraticPair_norm r s))
    _ = 512 := by simp only [Finset.sum_const, Finset.card_univ, quadraticRayRing_card, nsmul_eq_mul]; norm_num

/-- Reduction modulo four separates reciprocity into a fixed finite sum of row and column masks. -/
lemma rayQuadraticPair_separation (c d : O) :
    rayQuadraticPair (Ideal.Quotient.mk (Ideal.span {(4 : O)}) c)
      (Ideal.Quotient.mk (Ideal.span {(4 : O)}) d) =
      ∑ r : QuadraticRayRing, ∑ s : QuadraticRayRing, rayQuadraticPair r s *
        (if Ideal.Quotient.mk (Ideal.span {(4 : O)}) c = r then 1 else 0) *
        (if Ideal.Quotient.mk (Ideal.span {(4 : O)}) d = s then 1 else 0) := by
  classical
  simp [mul_ite]

lemma quadraticSubsetSymbol_star {ι : Type*} (p : ι → O)
    [∀ i, (Ideal.span {p i}).IsMaximal] (S T : Finset ι) :
    star (quadraticSubsetSymbol p S T) = quadraticSubsetSymbol p S T := by
  simp only [quadraticSubsetSymbol, primeSubsetRow, star_prod, MulChar.star_apply', complexQuadraticChar_inv]

/-- Finite quadratic sieve matrices admit uniform row-column duality. -/
theorem quadratic_subset_matrix_reverse {ι m n : Type*} [DecidableEq ι]
    [Fintype m] [Fintype n] [DecidableEq m] [DecidableEq n]
    (p : ι → O) (hp : ∀ i, p i ≠ 0) [∀ i, (Ideal.span {p i}).IsMaximal]
    (hinj : Function.Injective (fun i => Ideal.span {p i}))
    (hodd : ∀ i, ringChar (O ⧸ Ideal.span {p i}) ≠ 2)
    (rows : m → Finset ι) (cols : n → Finset ι) :
    ‖FiniteSieveOperator.operator (fun i j => quadraticSubsetSymbol p (cols j) (rows i))‖ ≤
      512 * ‖FiniteSieveOperator.operator (fun j i => quadraticSubsetSymbol p (rows i) (cols j))‖ := by
  classical
  let A : Matrix m n ℂ := fun i j => quadraticSubsetSymbol p (cols j) (rows i)
  let B := Matrix.conjTranspose (fun j i => quadraticSubsetSymbol p (rows i) (cols j) : Matrix n m ℂ)
  let C : QuadraticRayRing × QuadraticRayRing → ℂ := fun k => rayQuadraticPair k.1 k.2
  let l : QuadraticRayRing × QuadraticRayRing → m → ℂ := fun k i =>
    if Ideal.Quotient.mk (Ideal.span {(4 : O)}) (∏ s ∈ rows i, p s) = k.2 then 1 else 0
  let r : QuadraticRayRing × QuadraticRayRing → n → ℂ := fun k j =>
    if Ideal.Quotient.mk (Ideal.span {(4 : O)}) (∏ s ∈ cols j, p s) = k.1 then 1 else 0
  have hB (i : m) (j : n) : B i j = quadraticSubsetSymbol p (rows i) (cols j) :=
    quadraticSubsetSymbol_star p _ _
  have hl (k : QuadraticRayRing × QuadraticRayRing) (i : m) : ‖l k i‖ ≤ 1 := by
    dsimp only [l]
    split_ifs <;> norm_num
  have hr (k : QuadraticRayRing × QuadraticRayRing) (j : n) : ‖r k j‖ ≤ 1 := by
    dsimp only [r]
    split_ifs <;> norm_num
  have hA (i : m) (j : n) : A i j = ∑ k, C k * (l k i * B i j * r k j) := by
    change quadraticSubsetSymbol p (cols j) (rows i) = _
    rw [quadraticSubsetSymbol_reciprocity p hp hinj hodd,
      ← rayQuadraticPair_mk, rayQuadraticPair_separation, Fintype.sum_prod_type]
    simp only [Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro u _
    apply Finset.sum_congr rfl
    intro v _
    rw [hB]
    dsimp only [C, l, r]
    ring
  have hmass : (∑ k, ‖C k‖) ≤ 512 := by
    simpa only [C, Fintype.sum_prod_type] using rayQuadraticPair_sum_norm
  calc
    _ ≤ (∑ k, ‖C k‖) * ‖FiniteSieveOperator.operator B‖ :=
      FiniteSieveOperator.separated_phase_norm_le A B C l r hl hr hA
    _ ≤ 512 * ‖FiniteSieveOperator.operator B‖ := mul_le_mul_of_nonneg_right hmass (norm_nonneg _)
    _ = _ := by
      change 512 * ‖FiniteSieveOperator.operator
        (Matrix.conjTranspose (fun j i => quadraticSubsetSymbol p (rows i) (cols j) : Matrix n m ℂ))‖ = _
      rw [FiniteSieveOperator.operator_conjTranspose_norm]

end SchwartzPlanePoisson

namespace SchwartzPlanePoisson
open Eisenstein MeasureTheory QuadraticPhase.Eisenstein
open scoped SchwartzMap

/-- Masks preserve the same Gauss phase; selected divisors only rescale the dual radial variable. -/
theorem quadratic_row_masked_radial_poisson {ι : Type*} [Fintype ι] [DecidableEq ι]
    (p : ι → O) (hp : ∀ i, p i ≠ 0)
    [∀ i, (Ideal.span {p i}).IsMaximal]
    (hinj : Function.Injective (fun i => Ideal.span {p i}))
    (hodd : ∀ i, ringChar (O ⧸ Ideal.span {p i}) ≠ 2) :
    ∀ {κ : Type*} (q : κ → O) (hq : ∀ i, q i ≠ 0)
      (hcop : Pairwise (Function.onFun IsCoprime q)) (S : Finset κ)
      (W : 𝓢(ℝ, ℂ)) (Y : ℝ), 0 < Y →
      (∑' z : O, primeCoprimeMask q S z * primeCuspRowCharacter p (fun i => complexQuadraticChar (Ideal.span {p i})) z *
        W (‖ringComplex z‖ ^ 2 / Y)) =
        ((Y : ℂ) * fixedDualAverage (∏ i, p i) / (‖ringComplex (∏ i, p i)‖ : ℂ)) *
          ∑ E ∈ S.powerset,
            ((-1 : ℂ) ^ E.card * primeCuspRowCharacter p (fun i => complexQuadraticChar (Ideal.span {p i})) (∏ i ∈ E, q i) /
              (‖ringComplex (∏ i ∈ E, q i)‖ ^ 2 : ℝ)) *
              ∑' h : O, primeCuspRowCharacter p (fun i => complexQuadraticChar (Ideal.span {p i})) h *
                paperRadialFourier W
                  (Y * ‖ringComplex h‖ ^ 2 /
                    (‖ringComplex (∏ i ∈ E, q i)‖ ^ 2 * ‖ringComplex (∏ i, p i)‖ ^ 2)) := by
  classical
  intro κ q hq hcop S W Y hY
  rw [prime_row_masked_dilations p (fun i => complexQuadraticChar (Ideal.span {p i})) q hq hcop S W Y hY, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro E hE
  have hd : (∏ i ∈ E, q i) ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun i _ => hq i)
  have hn : 0 < ‖ringComplex (∏ i ∈ E, q i)‖ ^ 2 :=
    sq_pos_of_pos (norm_pos_iff.mpr (ringComplex_ne_zero hd))
  rw [prime_quadratic_radial_poisson p hp hinj hodd W _ (div_pos hY hn)]
  have harg (h : O) :
      Y / ‖ringComplex (∏ i ∈ E, q i)‖ ^ 2 * ‖ringComplex h‖ ^ 2 /
          ‖ringComplex (∏ i, p i)‖ ^ 2 =
        Y * ‖ringComplex h‖ ^ 2 /
          (‖ringComplex (∏ i ∈ E, q i)‖ ^ 2 * ‖ringComplex (∏ i, p i)‖ ^ 2) := by ring
  simp_rw [harg]
  push_cast
  ring


end SchwartzPlanePoisson

namespace FiniteSieveRestriction
open FiniteSieveOperator

variable {n p : Type*} [Fintype n] [Fintype p] [DecidableEq n] [DecidableEq p]

def extendByZero (S : Finset n) (f : n → p) (u : n → ℂ) (k : p) : ℂ :=
  ∑ j ∈ S, if f j = k then u j else 0

omit [Fintype n] [Fintype p] [DecidableEq n] in
theorem extendByZero_apply_image (S : Finset n) (f : n → p) (u : n → ℂ)
    (hf : Set.InjOn f S) (j : n) (hj : j ∈ S) : extendByZero S f u (f j) = u j := by
  unfold extendByZero
  rw [Finset.sum_eq_single j]
  · simp
  · intro k hk hkj
    simp only [if_neg (fun h => hkj (hf hk hj h))]
  · exact fun h => (h hj).elim

omit [Fintype n] [Fintype p] [DecidableEq n] in
theorem extendByZero_zero (S : Finset n) (f : n → p) (u : n → ℂ)
    (k : p) (hk : k ∉ S.image f) : extendByZero S f u k = 0 := by
  apply Finset.sum_eq_zero
  intro j hj
  exact if_neg (fun h => hk (Finset.mem_image.mpr ⟨j, hj, h⟩))

omit [Fintype n] [DecidableEq n] in
theorem extendByZero_energy (S : Finset n) (f : n → p) (u : n → ℂ)
    (hf : Set.InjOn f S) :
    (∑ k, ‖extendByZero S f u k‖ ^ 2) = ∑ j ∈ S, ‖u j‖ ^ 2 := by
  calc
    _ = ∑ k ∈ S.image f, ‖extendByZero S f u k‖ ^ 2 := by
      symm
      apply Finset.sum_subset (Finset.subset_univ _)
      intro k _ hk
      simp [extendByZero_zero S f u k hk]
    _ = ∑ j ∈ S, ‖extendByZero S f u (f j)‖ ^ 2 := by
      rw [Finset.sum_image]
      exact fun j hj k hk h => hf hj hk h
    _ = _ := Finset.sum_congr rfl (fun j hj => by rw [extendByZero_apply_image S f u hf j hj])

omit [Fintype n] [DecidableEq n] in
theorem extendByZero_matrix {m : Type*} (S : Finset n) (f : n → p)
    (u : n → ℂ) (A : Matrix m p ℂ) (i : m) :
    (∑ k, A i k * extendByZero S f u k) = ∑ j ∈ S, A i (f j) * u j := by
  simp only [extendByZero, Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro j _
  rw [Finset.sum_eq_single (f j)]
  · simp
  · intro k _ hkj
    simp [Ne.symm hkj]
  · simp

theorem masked_column_restriction_norm_le {m : Type*} [Fintype m] [DecidableEq m]
    (S : Finset n) (f : n → p) (hf : Set.InjOn f S) (A : Matrix m p ℂ) :
    ‖operator (fun i j => if j ∈ S then A i (f j) else 0)‖ ≤ ‖operator A‖ := by
  apply ContinuousLinearMap.opNorm_le_bound _ (norm_nonneg _)
  intro u
  let v : EuclideanSpace ℂ p := WithLp.toLp 2 (extendByZero S f u)
  have hv : ‖v‖ ≤ ‖u‖ := by
    apply (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mp
    rw [EuclideanSpace.norm_sq_eq, EuclideanSpace.norm_sq_eq]
    change (∑ k, ‖extendByZero S f u k‖ ^ 2) ≤ ∑ j, ‖u j‖ ^ 2
    rw [extendByZero_energy S f u hf]
    exact Finset.sum_le_univ_sum_of_nonneg (fun j => sq_nonneg ‖u j‖)
  have heq : operator (fun i j => if j ∈ S then A i (f j) else 0) u = operator A v := by
    ext i
    change (∑ j, (if j ∈ S then A i (f j) else 0) * u j) =
      ∑ k, A i k * extendByZero S f u k
    rw [extendByZero_matrix]
    simp only [ite_mul, zero_mul, ← Finset.sum_filter]
    simp
  rw [heq]
  exact ((operator A).le_opNorm v).trans (mul_le_mul_of_nonneg_left hv (norm_nonneg _))

theorem column_restriction_norm_le {m : Type*} [Fintype m] [DecidableEq m]
    (f : n → p) (hf : Function.Injective f) (A : Matrix m p ℂ) :
    ‖operator (fun i j => A i (f j))‖ ≤ ‖operator A‖ := by
  simpa only [Finset.mem_univ, ite_true] using
    masked_column_restriction_norm_le Finset.univ f hf.injOn A

theorem row_restriction_norm_le {m : Type*} [Fintype m] [DecidableEq m]
    (f : n → p) (hf : Function.Injective f) (A : Matrix p m ℂ) :
    ‖operator (fun i j => A (f i) j)‖ ≤ ‖operator A‖ := by
  let B : Matrix n m ℂ := fun i j => A (f i) j
  have h := column_restriction_norm_le f hf A.conjTranspose
  change ‖operator B.conjTranspose‖ ≤ ‖operator A.conjTranspose‖ at h
  rw [operator_conjTranspose_norm B, operator_conjTranspose_norm A] at h
  exact h

theorem submatrix_norm_le {m q : Type*} [Fintype m] [Fintype q]
    [DecidableEq m] [DecidableEq q]
    (r : m → q) (hr : Function.Injective r) (c : n → p) (hc : Function.Injective c)
    (A : Matrix q p ℂ) :
    ‖operator (fun i j => A (r i) (c j))‖ ≤ ‖operator A‖ :=
  (row_restriction_norm_le r hr (fun i j => A i (c j))).trans
    (column_restriction_norm_le c hc A)

end FiniteSieveRestriction

namespace SchwartzPlanePoisson
open Eisenstein UniqueFactorizationMonoid

/-- Odd unramified prime ideals, with their fixed primary generators. -/
abbrev QuadraticPrime := {P : Ideal O // P.IsMaximal ∧ lambda ∉ P ∧ ringChar (O ⧸ P) ≠ 2}

instance quadraticPrimeMaximal (P : QuadraticPrime) : P.val.IsMaximal := P.property.1

def quadraticPrimeGenerator (P : QuadraticPrime) : O := primaryIdealPrime P.val

lemma quadraticPrimeGenerator_ne_zero (P : QuadraticPrime) : quadraticPrimeGenerator P ≠ 0 :=
  primaryIdealPrime_ne_zero P.val P.property.2.1

lemma quadraticPrimeGenerator_span (P : QuadraticPrime) :
    Ideal.span {quadraticPrimeGenerator P} = P.val :=
  (primaryIdealPrime_spec P.val (quadraticPrimeGenerator_ne_zero P)).2.2.1

instance quadraticPrimeGeneratorMaximal (P : QuadraticPrime) :
    (Ideal.span {quadraticPrimeGenerator P}).IsMaximal := by
  rw [quadraticPrimeGenerator_span]
  infer_instance

lemma quadraticPrimeGenerator_span_injective :
    Function.Injective (fun P : QuadraticPrime => Ideal.span {quadraticPrimeGenerator P}) := by
  intro P Q h
  exact Subtype.ext (by simpa only [quadraticPrimeGenerator_span] using h)

lemma quadraticPrimeGenerator_odd (P : QuadraticPrime) :
    ringChar (O ⧸ Ideal.span {quadraticPrimeGenerator P}) ≠ 2 := by
  rw [quadraticPrimeGenerator_span]
  exact P.property.2.2

/-- Squarefree ideals coprime to the primes above two and three. -/
def quadraticIdealAdmissible (I : Ideal O) : Prop :=
  primaryIdealGenerator I ≠ 0 ∧ Squarefree I ∧ ∀ P ∈ primeSupport I, ringChar (O ⧸ P) ≠ 2

abbrev QuadraticIdeal := {I : Ideal O // quadraticIdealAdmissible I}

def quadraticIdealPrimeIndex (I : QuadraticIdeal) (P : primeSupport I.val) : QuadraticPrime :=
  ⟨P.val, (primaryIdealPrime_spec P.val
    (primaryIdealPrime_factor_ne_zero I.val P.val I.property.1 (Multiset.mem_toFinset.mp P.property))).1,
    (primaryIdealPrime_spec P.val
    (primaryIdealPrime_factor_ne_zero I.val P.val I.property.1 (Multiset.mem_toFinset.mp P.property))).2.1,
    I.property.2.2 P.val P.property⟩

def quadraticIdealSupport (I : QuadraticIdeal) : Finset QuadraticPrime :=
  (primeSupport I.val).attach.map
    ⟨quadraticIdealPrimeIndex I, fun _ _ h => Subtype.ext (congrArg (fun P : QuadraticPrime => P.val) h)⟩

lemma quadraticIdealSupport_product (I : QuadraticIdeal) :
    (∏ P ∈ quadraticIdealSupport I, quadraticPrimeGenerator P) = primaryIdealGenerator I.val := by
  rw [quadraticIdealSupport, Finset.prod_map]
  change (∏ P ∈ (primeSupport I.val).attach, primaryIdealPrime P.val) = _
  rw [Finset.prod_attach]
  exact (primaryIdealGenerator_squarefree_support I.val I.property.1 I.property.2.1).symm

lemma quadraticIdealGenerator_injective :
    Function.Injective (fun I : QuadraticIdeal => primaryIdealGenerator I.val) := by
  intro I J h
  change primaryIdealGenerator I.val = primaryIdealGenerator J.val at h
  apply Subtype.ext
  rw [← (primaryIdealGenerator_spec I.val I.property.1).1,
    ← (primaryIdealGenerator_spec J.val J.property.1).1, h]

lemma quadraticIdealSupport_injective : Function.Injective quadraticIdealSupport := by
  intro I J h
  apply quadraticIdealGenerator_injective
  change primaryIdealGenerator I.val = primaryIdealGenerator J.val
  rw [← quadraticIdealSupport_product I, ← quadraticIdealSupport_product J, h]

lemma quadraticIdealSupport_norm (I : QuadraticIdeal) :
    primeSubsetNorm quadraticPrimeGenerator (quadraticIdealSupport I) = (Ideal.absNorm I.val : ℝ) := by
  rw [primeSubsetNorm, quadraticIdealSupport_product, primaryIdealGenerator_norm_sq I.val I.property.1]

def canonicalQuadraticRow (I : QuadraticIdeal) (z : O) : ℂ :=
  primeSubsetRow quadraticPrimeGenerator
    (fun P => complexQuadraticChar (Ideal.span {quadraticPrimeGenerator P})) (quadraticIdealSupport I) z

lemma canonicalQuadraticRow_eq_symbol (I J : QuadraticIdeal) :
    canonicalQuadraticRow I (primaryIdealGenerator J.val) =
      quadraticSubsetSymbol quadraticPrimeGenerator (quadraticIdealSupport I) (quadraticIdealSupport J) := by
  rw [quadraticSubsetSymbol, quadraticIdealSupport_product]
  rfl

abbrev QuadraticIdealRange (N : ℝ) := {I : QuadraticIdeal // (Ideal.absNorm I.val : ℝ) ≤ N}

noncomputable instance quadraticIdealRangeFintype (N : ℝ) : Fintype (QuadraticIdealRange N) := by
  classical
  let S := {I : Ideal O | Ideal.absNorm I ≤ ⌈N⌉₊}
  letI : Finite S := (Ideal.finite_setOf_absNorm_le (S := O) ⌈N⌉₊).to_subtype
  let f : QuadraticIdealRange N → S := fun I => ⟨I.val.val, by
    have h : (Ideal.absNorm I.val.val : ℝ) ≤ (⌈N⌉₊ : ℝ) := I.property.trans (Nat.le_ceil N)
    exact_mod_cast h⟩
  have hf : Function.Injective f := fun I J h => Subtype.ext (Subtype.ext (congrArg (fun J : S => J.val) h))
  letI : Finite (QuadraticIdealRange N) := Finite.of_injective f hf
  exact Fintype.ofFinite _

namespace CanonicalQuadraticSieve

def matrix (M N : ℝ) : Matrix (QuadraticIdealRange M) (QuadraticIdealRange N) ℂ :=
  fun I J => canonicalQuadraticRow J.val (primaryIdealGenerator I.val.val)

def sieveNorm (M N : ℝ) : ℝ := ‖FiniteSieveOperator.operator (matrix M N)‖ ^ 2

lemma sieveNorm_nonneg (M N : ℝ) : 0 ≤ sieveNorm M N := sq_nonneg _

/-- The initial exponent is two; its constant is independent of both norm balls. -/
theorem sieveNorm_initial : ∃ C : ℝ, 0 < C ∧ ∀ M N : ℝ, 1 ≤ M → 1 ≤ N →
    sieveNorm M N ≤ C * (M + N ^ 2) := by
  obtain ⟨C, hC, hbound⟩ := primeSubsetRow_initial_operator_bound
  refine ⟨C, hC, ?_⟩
  intro M N hM hN
  classical
  exact hbound quadraticPrimeGenerator quadraticPrimeGenerator_ne_zero
    quadraticPrimeGenerator_span_injective
    (fun P => complexQuadraticChar (Ideal.span {quadraticPrimeGenerator P}))
    (fun P => complexQuadraticChar_ne_one _ (quadraticPrimeGenerator_odd P))
    (fun I : QuadraticIdealRange M => primaryIdealGenerator I.val.val)
    (quadraticIdealGenerator_injective.comp Subtype.val_injective)
    (fun J : QuadraticIdealRange N => quadraticIdealSupport J.val)
    (quadraticIdealSupport_injective.comp Subtype.val_injective) M N hM hN
    (fun I => by rw [primaryIdealGenerator_norm_sq I.val.val I.val.property.1]; exact I.property)
    (fun J => by rw [quadraticIdealSupport_norm]; exact J.property)

/-- Reciprocity costs only a fixed ray-class constant. -/
theorem sieveNorm_reverse (M N : ℝ) : sieveNorm M N ≤ 262144 * sieveNorm N M := by
  classical
  have h := quadratic_subset_matrix_reverse quadraticPrimeGenerator quadraticPrimeGenerator_ne_zero
    quadraticPrimeGenerator_span_injective quadraticPrimeGenerator_odd
    (fun I : QuadraticIdealRange M => quadraticIdealSupport I.val)
    (fun J : QuadraticIdealRange N => quadraticIdealSupport J.val)
  simp only [← canonicalQuadraticRow_eq_symbol] at h
  have hsq := pow_le_pow_left₀ (norm_nonneg _) h 2
  change ‖FiniteSieveOperator.operator
    (fun I : QuadraticIdealRange M => fun J : QuadraticIdealRange N =>
      canonicalQuadraticRow J.val (primaryIdealGenerator I.val.val))‖ ^ 2 ≤
    262144 * ‖FiniteSieveOperator.operator
      (fun J : QuadraticIdealRange N => fun I : QuadraticIdealRange M =>
        canonicalQuadraticRow I.val (primaryIdealGenerator J.val.val))‖ ^ 2
  simpa only [mul_pow, show (512 : ℝ) ^ 2 = 262144 by norm_num] using hsq

/-- Uniform power bounds for the actual quadratic residue matrix. -/
def HasSieveExponent (α : ℝ) : Prop :=
  ∀ ε : ℝ, 0 < ε → ∃ C : ℝ, 0 < C ∧ ∀ M N : ℝ, 1 ≤ M → 1 ≤ N →
    sieveNorm M N ≤ C * (M * N) ^ ε * (M + N ^ α)

lemma hasSieveExponent_two : HasSieveExponent 2 := by
  obtain ⟨C, hC, hb⟩ := sieveNorm_initial
  intro ε hε
  refine ⟨C, hC, ?_⟩
  intro M N hM hN
  have hMN : 1 ≤ M * N := one_le_mul_of_one_le_of_one_le hM hN
  have hr := Real.one_le_rpow hMN hε.le
  calc
    _ ≤ C * (M + N ^ 2) := hb M N hM hN
    _ ≤ C * (M * N) ^ ε * (M + N ^ (2 : ℝ)) := by
      rw [Real.rpow_two]
      exact mul_le_mul_of_nonneg_right (le_mul_of_one_le_right hC.le hr) (by positivity)

end CanonicalQuadraticSieve
end SchwartzPlanePoisson

namespace SchwartzPlanePoisson.CanonicalQuadraticSieve
open Eisenstein

/-- Inclusion of norm balls preserves the underlying ideal. -/
def rangeInclusion {X Y : ℝ} (h : X ≤ Y) (I : QuadraticIdealRange X) : QuadraticIdealRange Y :=
  ⟨I.val, I.property.trans h⟩

lemma rangeInclusion_injective {X Y : ℝ} (h : X ≤ Y) : Function.Injective (rangeInclusion h) := by
  intro I J he
  exact Subtype.ext (congrArg (fun J : QuadraticIdealRange Y => J.val) he)

lemma sieveNorm_mono {M N M' N' : ℝ} (hM : M ≤ M') (hN : N ≤ N') :
    sieveNorm M N ≤ sieveNorm M' N' := by
  classical
  have h := FiniteSieveRestriction.submatrix_norm_le
    (rangeInclusion hM) (rangeInclusion_injective hM)
    (rangeInclusion hN) (rangeInclusion_injective hN) (matrix M' N')
  exact pow_le_pow_left₀ (norm_nonneg _) h 2

lemma family_squared_norm_le {m n : Type*} [Fintype m] [Fintype n]
    [DecidableEq m] [DecidableEq n] (rows : m → QuadraticIdeal) (cols : n → QuadraticIdeal)
    (hrows : Function.Injective rows) (hcols : Function.Injective cols)
    (M N : ℝ) (hM : ∀ i, (Ideal.absNorm (rows i).val : ℝ) ≤ M)
    (hN : ∀ j, (Ideal.absNorm (cols j).val : ℝ) ≤ N) :
    ‖FiniteSieveOperator.operator
      (fun i j => canonicalQuadraticRow (cols j) (primaryIdealGenerator (rows i).val))‖ ^ 2 ≤
      sieveNorm M N := by
  let r : m → QuadraticIdealRange M := fun i => ⟨rows i, hM i⟩
  let c : n → QuadraticIdealRange N := fun j => ⟨cols j, hN j⟩
  have hr : Function.Injective r := fun i j h => hrows (congrArg (fun J : QuadraticIdealRange M => J.val) h)
  have hc : Function.Injective c := fun i j h => hcols (congrArg (fun J : QuadraticIdealRange N => J.val) h)
  classical
  exact pow_le_pow_left₀ (norm_nonneg _)
    (FiniteSieveRestriction.submatrix_norm_le r hr c hc (matrix M N)) 2

lemma energy_bound (M N : ℝ) (a : QuadraticIdealRange N → ℂ) :
    (∑ I : QuadraticIdealRange M,
      ‖∑ J, canonicalQuadraticRow J.val (primaryIdealGenerator I.val.val) * a J‖ ^ 2) ≤
      sieveNorm M N * ∑ J, ‖a J‖ ^ 2 := by
  classical
  exact FiniteSieveOperator.energy_bound (matrix M N) a

end SchwartzPlanePoisson.CanonicalQuadraticSieve


namespace IdealDivisorBound
open Eisenstein Filter UniqueFactorizationMonoid
open scoped BigOperators Classical

theorem divisor_ne_zero {I J : Ideal O} (hI : I ≠ ⊥) (hJ : J ∈ idealDivisors I) : J ≠ 0 := by
  intro hz
  have hd := (mem_idealDivisors hI).mp hJ
  rw [hz, zero_dvd_iff] at hd
  exact hI hd

theorem divisor_card_le_product (I : Ideal O) (hI : I ≠ ⊥) :
    (idealDivisors I).card ≤
      ∏ P ∈ primeSupport I, ((normalizedFactors I).count P + 1) := by
  change (idealDivisors I).card ≤
    ∏ P ∈ (normalizedFactors I).toFinset, ((normalizedFactors I).count P + 1)
  rw [← Multiset.card_Iic]
  apply Finset.card_le_card_of_injOn normalizedFactors
  · intro J hJ
    change normalizedFactors J ∈ Finset.Iic (normalizedFactors I)
    rw [Finset.mem_Iic]
    exact (dvd_iff_normalizedFactors_le_normalizedFactors
      (divisor_ne_zero hI hJ) hI).mp ((mem_idealDivisors hI).mp hJ)
  · intro J hJ K hK he
    calc
      J = (normalizedFactors J).prod := (Ideal.prod_normalizedFactors_eq_self (divisor_ne_zero hI hJ)).symm
      _ = (normalizedFactors K).prod := congrArg Multiset.prod he
      _ = K := Ideal.prod_normalizedFactors_eq_self (divisor_ne_zero hI hK)

theorem linear_le_geometric (b : ℝ) (hb : 1 < b) (n : ℕ) :
    (n : ℝ) + 1 ≤ (1 + (b - 1)⁻¹) * b ^ n := by
  have hδ : 0 < b - 1 := sub_pos.mpr hb
  have hn := one_add_mul_sub_le_pow (show (-1 : ℝ) ≤ b by linarith) n
  have hn' : (n : ℝ) ≤ b ^ n / (b - 1) := by
    apply (le_div_iff₀ hδ).mpr
    linarith
  have h1 : (1 : ℝ) ≤ b ^ n := one_le_pow₀ hb.le
  calc
    (n : ℝ) + 1 ≤ b ^ n / (b - 1) + b ^ n := add_le_add hn' h1
    _ = _ := by ring

theorem support_norm_two_le {I P : Ideal O} (hP : P ∈ primeSupport I) :
    2 ≤ Ideal.absNorm P := by
  have hp := support_prime hP
  have h0 : Ideal.absNorm P ≠ 0 := by
    intro h
    exact hp.ne_zero (Ideal.absNorm_eq_zero_iff.mp h)
  have h1 : Ideal.absNorm P ≠ 1 := by
    intro h
    have ht := Ideal.absNorm_eq_one_iff.mp h
    apply hp.2.1
    rw [ht]
    simpa only [Ideal.one_eq_top] using (show IsUnit (1 : Ideal O) from isUnit_one)
  omega

theorem norm_factor_product (I : Ideal O) (hI : I ≠ ⊥) :
    (∏ P ∈ primeSupport I, (Ideal.absNorm P : ℝ) ^ (normalizedFactors I).count P) =
      Ideal.absNorm I := by
  have he := congrArg (fun J : Ideal O => (Ideal.absNorm J : ℝ))
    (Ideal.prod_normalizedFactors_eq_self hI)
  rw [Finset.prod_multiset_count] at he
  simpa only [primeSupport, map_prod, map_pow, Nat.cast_prod, Nat.cast_pow] using he

theorem ideal_divisor_small_power (ε : ℝ) (hε : 0 < ε) :
    ∃ C : ℝ, 0 < C ∧ ∀ I : Ideal O, I ≠ ⊥ →
      ((idealDivisors I).card : ℝ) ≤ C * (Ideal.absNorm I : ℝ) ^ ε := by
  have ht : Tendsto (fun n : ℕ => (n : ℝ) ^ ε) atTop atTop :=
    (tendsto_rpow_atTop hε).comp tendsto_natCast_atTop_atTop
  obtain ⟨N, hN⟩ := eventually_atTop.mp (ht.eventually (eventually_ge_atTop (2 : ℝ)))
  let small : Finset (Ideal O) :=
    (Ideal.finite_setOf_absNorm_le (S := O) N).toFinset
  let b : ℝ := (2 : ℝ) ^ ε
  have hb : 1 < b := by
    dsimp [b]
    exact Real.one_lt_rpow (by norm_num) hε
  let c : ℝ := 1 + (b - 1)⁻¹
  have hc : 1 ≤ c := by
    dsimp [c]
    have hi : 0 ≤ (b - 1)⁻¹ := inv_nonneg.mpr (sub_nonneg.mpr hb.le)
    linarith
  refine ⟨c ^ small.card, by positivity, ?_⟩
  intro I hI
  let S := primeSupport I
  let e := fun P : Ideal O => (normalizedFactors I).count P
  have hfac (P : Ideal O) (hP : P ∈ S) :
      ((e P + 1 : ℕ) : ℝ) ≤
        (if P ∈ small then c else 1) * ((Ideal.absNorm P : ℝ) ^ ε) ^ e P := by
    have hnorm : (2 : ℝ) ≤ Ideal.absNorm P := by exact_mod_cast support_norm_two_le hP
    have hbase : b ≤ (Ideal.absNorm P : ℝ) ^ ε :=
      Real.rpow_le_rpow (by norm_num) hnorm hε.le
    by_cases hp : P ∈ small
    · rw [if_pos hp]
      have hlin := linear_le_geometric b hb (e P)
      have hl : ((e P + 1 : ℕ) : ℝ) ≤ c * b ^ e P := by
        simpa only [Nat.cast_add, Nat.cast_one, c] using hlin
      apply hl.trans
      exact mul_le_mul_of_nonneg_left
        (pow_le_pow_left₀ (by positivity) hbase _) (by positivity)
    · rw [if_neg hp, one_mul]
      have hn : N ≤ Ideal.absNorm P := by
        have : ¬ Ideal.absNorm P ≤ N := fun h => hp (by simpa [small] using h)
        omega
      have hp2 := hN _ hn
      calc
        _ ≤ (2 : ℝ) ^ e P := by
          have hh := one_add_mul_sub_le_pow (by norm_num : (-1 : ℝ) ≤ 2) (e P)
          norm_num at hh ⊢
          linarith
        _ ≤ _ := pow_le_pow_left₀ (by norm_num) hp2 _
  have hprod := Finset.prod_le_prod
    (fun P (_ : P ∈ S) => (by positivity : (0 : ℝ) ≤ ((e P + 1 : ℕ) : ℝ))) hfac
  have hconst : (∏ P ∈ S, if P ∈ small then c else 1) ≤ c ^ small.card := by
    have he : (∏ P ∈ S, if P ∈ small then c else 1) = c ^ (S ∩ small).card := by
      simp []
    rw [he]
    exact pow_le_pow_right₀ hc (Finset.card_le_card Finset.inter_subset_right)
  have hpow : (∏ P ∈ S, ((Ideal.absNorm P : ℝ) ^ ε) ^ e P) =
      (Ideal.absNorm I : ℝ) ^ ε := by
    calc
      _ = ∏ P ∈ S, ((Ideal.absNorm P : ℝ) ^ e P) ^ ε := by
        apply Finset.prod_congr rfl
        intro P hP
        rw [← Real.rpow_natCast, ← Real.rpow_mul (by positivity),
          ← Real.rpow_natCast, ← Real.rpow_mul (by positivity)]
        rw [mul_comm]
      _ = (∏ P ∈ S, (Ideal.absNorm P : ℝ) ^ e P) ^ ε :=
        Real.finsetProd_rpow S _ (fun _ _ => by positivity) ε
      _ = _ := by rw [norm_factor_product I hI]
  have hcard : ((idealDivisors I).card : ℝ) ≤ ∏ P ∈ S, ((e P + 1 : ℕ) : ℝ) := by
    exact_mod_cast divisor_card_le_product I hI
  apply hcard.trans
  rw [Finset.prod_mul_distrib, hpow] at hprod
  exact hprod.trans (mul_le_mul_of_nonneg_right hconst (by positivity))

end IdealDivisorBound


namespace SchwartzPlanePoisson
open Eisenstein MeasureTheory QuadraticPhase.Eisenstein
open scoped SchwartzMap

/-- Exact second reflection of a Gram entry, retaining the signed common-prime divisor sum. -/
theorem quadraticSubsetRow_gram_poisson {ι : Type*} [DecidableEq ι]
    (p : ι → O) (hp : ∀ i, p i ≠ 0)
    [∀ i, (Ideal.span {p i}).IsMaximal]
    (hinj : Function.Injective (fun i => Ideal.span {p i}))
    (hodd : ∀ i, ringChar (O ⧸ Ideal.span {p i}) ≠ 2)
    (S T : Finset ι) :
    let p' : ↥((S \ T) ∪ (T \ S)) → O := fun i => p i.val
    let χ' := fun i : ↥((S \ T) ∪ (T \ S)) => complexQuadraticChar (Ideal.span {p i.val})
    ∀ (W : 𝓢(ℝ, ℂ)) (Y : ℝ), 0 < Y →
      (∑' z : O, (star (primeSubsetRow p (fun i => complexQuadraticChar (Ideal.span {p i})) S z) * primeSubsetRow p (fun i => complexQuadraticChar (Ideal.span {p i})) T z) *
        W (‖ringComplex z‖ ^ 2 / Y)) =
        ((Y : ℂ) * fixedDualAverage (∏ i, p' i) / (‖ringComplex (∏ i, p' i)‖ : ℂ)) *
          ∑ E ∈ (S ∩ T).powerset,
            ((-1 : ℂ) ^ E.card * primeCuspRowCharacter p' χ' (∏ i ∈ E, p i) /
              (‖ringComplex (∏ i ∈ E, p i)‖ ^ 2 : ℝ)) *
              ∑' h : O, primeCuspRowCharacter p' χ' h *
                paperRadialFourier W
                  (Y * ‖ringComplex h‖ ^ 2 /
                    (‖ringComplex (∏ i ∈ E, p i)‖ ^ 2 * ‖ringComplex (∏ i, p' i)‖ ^ 2)) := by
  classical
  dsimp only
  intro W Y hY
  have hcop : Pairwise (Function.onFun IsCoprime p) := by
    intro i j hij
    exact (Ideal.isCoprime_span_singleton_iff _ _).mp
      (Ideal.isCoprime_of_isMaximal (hinj.ne hij))
  have hactive : activePrimeRowCharacter p
      (fun i => complexQuadraticChar (Ideal.span {p i})) S T =
      (fun i : ↥((S \ T) ∪ (T \ S)) => complexQuadraticChar (Ideal.span {p i.val})) := by
    funext i
    simp only [activePrimeRowCharacter, complexQuadraticChar_inv, ite_self]
  simp_rw [primeSubsetRow_pair_active, hactive]
  exact quadratic_row_masked_radial_poisson
    (fun i : ↥((S \ T) ∪ (T \ S)) => p i.val) (fun i => hp i.val)
    (hinj.comp Subtype.val_injective) (fun i => hodd i.val) p hp hcop (S ∩ T) W Y hY

end SchwartzPlanePoisson


namespace DivisorBlockCauchy
open Eisenstein
open scoped BigOperators Classical

theorem divisor_mask_energy {n : Type*} [Fintype n]
    (S : Finset (Ideal O)) (column : n → Ideal O) (hcol : ∀ j, column j ≠ 0)
    (a : n → ℂ) :
    (∑ D ∈ S, ∑ j, ‖if D ∣ column j then a j else 0‖ ^ 2) ≤
      ∑ j, ((idealDivisors (column j)).card : ℝ) * ‖a j‖ ^ 2 := by
  rw [Finset.sum_comm]
  apply Finset.sum_le_sum
  intro j _
  have hsub : S.filter (fun D => D ∣ column j) ⊆ idealDivisors (column j) := by
    intro D hD
    exact (mem_idealDivisors (hcol j)).mpr (Finset.mem_filter.mp hD).2
  have hite (D : Ideal O) : ‖if D ∣ column j then a j else 0‖ ^ 2 =
      if D ∣ column j then ‖a j‖ ^ 2 else 0 := by split_ifs <;> simp
  simp_rw [hite]
  rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
  exact mul_le_mul_of_nonneg_right (by exact_mod_cast Finset.card_le_card hsub) (sq_nonneg _)

def divisorConstant (ε : ℝ) (hε : 0 < ε) : ℝ :=
  (IdealDivisorBound.ideal_divisor_small_power ε hε).choose

theorem divisorConstant_pos (ε : ℝ) (hε : 0 < ε) : 0 < divisorConstant ε hε :=
  (IdealDivisorBound.ideal_divisor_small_power ε hε).choose_spec.1

theorem divisor_mask_energy_small_power {n : Type*} [Fintype n]
    (ε : ℝ) (hε : 0 < ε) (S : Finset (Ideal O))
    (column : n → Ideal O) (hcol : ∀ j, column j ≠ 0)
    (N : ℝ) (hnorm : ∀ j, (Ideal.absNorm (column j) : ℝ) ≤ N) (a : n → ℂ) :
    (∑ D ∈ S, ∑ j, ‖if D ∣ column j then a j else 0‖ ^ 2) ≤
      (divisorConstant ε hε * N ^ ε) * ∑ j, ‖a j‖ ^ 2 := by
  apply (divisor_mask_energy S column hcol a).trans
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro j _
  apply mul_le_mul_of_nonneg_right _ (sq_nonneg _)
  apply ((IdealDivisorBound.ideal_divisor_small_power ε hε).choose_spec.2
    (column j) (hcol j)).trans
  exact mul_le_mul_of_nonneg_left
    (Real.rpow_le_rpow (Nat.cast_nonneg _) (hnorm j) hε.le) (divisorConstant_pos ε hε).le

theorem rectangular_cauchy {α β : Type*} (S : Finset α) (T : Finset β)
    (H : α → β → ℝ) (E : α → ℝ) (F : β → ℝ) (C : ℝ)
    (_hC : 0 ≤ C) (hH : ∀ d ∈ S, ∀ e ∈ T, (H d e) ^ 2 ≤ C * E d * F e) :
    (∑ d ∈ S, ∑ e ∈ T, H d e) ^ 2 ≤
      (S.card : ℝ) * T.card * C * (∑ d ∈ S, E d) * (∑ e ∈ T, F e) := by
  classical
  have hCS := Finset.sum_mul_sq_le_sq_mul_sq (S ×ˢ T)
    (fun _ => (1 : ℝ)) (fun x => H x.1 x.2)
  simp only [one_mul, one_pow, Finset.sum_const, nsmul_eq_mul, mul_one,
    Finset.card_product, Nat.cast_mul, Finset.sum_product] at hCS
  have hsum : (∑ d ∈ S, ∑ e ∈ T, (H d e) ^ 2) ≤
      C * (∑ d ∈ S, E d) * (∑ e ∈ T, F e) := by
    calc
      _ ≤ ∑ d ∈ S, ∑ e ∈ T, C * E d * F e := by
        apply Finset.sum_le_sum
        intro d hd
        exact Finset.sum_le_sum (fun e he => hH d hd e he)
      _ = _ := by simp only [← Finset.mul_sum, ← Finset.sum_mul]
  apply hCS.trans
  simpa only [mul_assoc] using mul_le_mul_of_nonneg_left hsum
    (show (0 : ℝ) ≤ (S.card : ℝ) * T.card by positivity)

end DivisorBlockCauchy


namespace SchwartzPlanePoisson
open Eisenstein UniqueFactorizationMonoid

/-- The odd-valuation part of an ideal. -/
def quadraticSquarefreePart (I : Ideal O) : Ideal O :=
  ∏ P ∈ (primeSupport I).filter (fun P => (normalizedFactors I).count P % 2 = 1), P

/-- The square root of the maximal square ideal factor. -/
def quadraticSquarePart (I : Ideal O) : Ideal O :=
  ∏ P ∈ primeSupport I, P ^ ((normalizedFactors I).count P / 2)

lemma quadraticSquarefreePart_squarefree (I : Ideal O) : Squarefree (quadraticSquarefreePart I) :=
  squarefree_support_product (Finset.filter_subset _ _)

lemma quadraticParts_mul_square (I : Ideal O) (hI : I ≠ 0) :
    quadraticSquarefreePart I * quadraticSquarePart I ^ 2 = I := by
  rw [quadraticSquarefreePart, Finset.prod_filter, quadraticSquarePart,
    ← Finset.prod_pow, ← Finset.prod_mul_distrib]
  calc
    _ = ∏ P ∈ primeSupport I, P ^ ((normalizedFactors I).count P) := by
      apply Finset.prod_congr rfl
      intro P hP
      have hm : (normalizedFactors I).count P % 2 = 0 ∨ (normalizedFactors I).count P % 2 = 1 := by omega
      rcases hm with hm | hm
      · rw [if_neg (by omega), one_mul, ← pow_mul]
        congr 1
        omega
      · rw [if_pos hm, ← pow_mul, ← pow_succ']
        congr 1
        omega
    _ = (normalizedFactors I).prod := (Finset.prod_multiset_count (normalizedFactors I)).symm
    _ = I := Ideal.prod_normalizedFactors_eq_self hI

/-- Prime valuations recover both square factors uniquely. -/
theorem squarefree_square_decomposition_unique {A B C D : Ideal O}
    (hB : B ≠ 0) (hD : D ≠ 0) (hA : Squarefree A) (hC : Squarefree C)
    (he : A * B ^ 2 = C * D ^ 2) : A = C ∧ B = D := by
  have hf := congrArg normalizedFactors he
  rw [normalizedFactors_mul hA.ne_zero (pow_ne_zero _ hB),
    normalizedFactors_mul hC.ne_zero (pow_ne_zero _ hD),
    normalizedFactors_pow, normalizedFactors_pow] at hf
  have ha := (squarefree_iff_nodup_normalizedFactors hA.ne_zero).mp hA
  have hc := (squarefree_iff_nodup_normalizedFactors hC.ne_zero).mp hC
  have hcount (P : Ideal O) :
      (normalizedFactors A).count P = (normalizedFactors C).count P ∧
      (normalizedFactors B).count P = (normalizedFactors D).count P := by
    have hp := congrArg (Multiset.count P) hf
    simp only [Multiset.count_add, Multiset.count_nsmul] at hp
    have ha1 := Multiset.nodup_iff_count_le_one.mp ha P
    have hc1 := Multiset.nodup_iff_count_le_one.mp hc P
    omega
  constructor
  · calc
      A = (normalizedFactors A).prod := (Ideal.prod_normalizedFactors_eq_self hA.ne_zero).symm
      _ = (normalizedFactors C).prod := congrArg Multiset.prod (Multiset.ext.mpr (fun P => (hcount P).1))
      _ = C := Ideal.prod_normalizedFactors_eq_self hC.ne_zero
  · calc
      B = (normalizedFactors B).prod := (Ideal.prod_normalizedFactors_eq_self hB).symm
      _ = (normalizedFactors D).prod := congrArg Multiset.prod (Multiset.ext.mpr (fun P => (hcount P).2))
      _ = D := Ideal.prod_normalizedFactors_eq_self hD

lemma quadraticSquarePart_ne_zero (I : Ideal O) : quadraticSquarePart I ≠ 0 :=
  Finset.prod_ne_zero_iff.mpr (fun P hP => pow_ne_zero _ (support_prime hP).ne_zero)

lemma quadraticParts_of_squarefree (A B : Ideal O) (hA : Squarefree A) (hB : B ≠ 0) :
    quadraticSquarefreePart (A * B ^ 2) = A ∧ quadraticSquarePart (A * B ^ 2) = B :=
  squarefree_square_decomposition_unique (quadraticSquarePart_ne_zero _) hB
    (quadraticSquarefreePart_squarefree _) hA
    (quadraticParts_mul_square _ (mul_ne_zero hA.ne_zero (pow_ne_zero _ hB)))

/-- Ideals supported away from two and three, with arbitrary prime multiplicities. -/
def quadraticSupported (I : Ideal O) : Prop :=
  primaryIdealGenerator I ≠ 0 ∧ ∀ P ∈ primeSupport I, ringChar (O ⧸ P) ≠ 2

lemma quadraticSupported_mul (A B : Ideal O) :
    quadraticSupported (A * B) ↔ quadraticSupported A ∧ quadraticSupported B := by
  constructor
  · intro h
    have hg : primaryIdealGenerator A * primaryIdealGenerator B ≠ 0 := by
      simpa only [primaryIdealGenerator_mul] using h.1
    have hA := left_ne_zero_of_mul hg
    have hB := right_ne_zero_of_mul hg
    have hAn := primaryIdealGenerator_ne_zero_ideal A hA
    have hBn := primaryIdealGenerator_ne_zero_ideal B hB
    refine ⟨⟨hA, ?_⟩, ⟨hB, ?_⟩⟩
    · intro P hP
      apply h.2 P
      simpa only [primeSupport, normalizedFactors_mul hAn hBn, Multiset.toFinset_add,
        Finset.mem_union] using Or.inl hP
    · intro P hP
      apply h.2 P
      simpa only [primeSupport, normalizedFactors_mul hAn hBn, Multiset.toFinset_add,
        Finset.mem_union] using Or.inr hP
  · rintro ⟨hA, hB⟩
    refine ⟨by rw [primaryIdealGenerator_mul]; exact mul_ne_zero hA.1 hB.1, ?_⟩
    intro P hP
    have hAn := primaryIdealGenerator_ne_zero_ideal A hA.1
    have hBn := primaryIdealGenerator_ne_zero_ideal B hB.1
    simp only [primeSupport, normalizedFactors_mul hAn hBn, Multiset.toFinset_add,
      Finset.mem_union] at hP
    exact hP.elim (hA.2 P) (hB.2 P)

lemma quadraticSupported_sq (A : Ideal O) : quadraticSupported (A ^ 2) ↔ quadraticSupported A := by
  rw [pow_two, quadraticSupported_mul, and_self]

lemma quadraticSupported_parts (I : Ideal O) (hI : I ≠ 0) :
    quadraticSupported I ↔ quadraticIdealAdmissible (quadraticSquarefreePart I) ∧
      quadraticSupported (quadraticSquarePart I) := by
  have he := quadraticSupported_mul (quadraticSquarefreePart I) (quadraticSquarePart I ^ 2)
  rw [quadraticParts_mul_square I hI, quadraticSupported_sq] at he
  constructor
  · intro h
    obtain ⟨hA, hB⟩ := he.mp h
    exact ⟨⟨hA.1, quadraticSquarefreePart_squarefree I, hA.2⟩, hB⟩
  · rintro ⟨hA, hB⟩
    exact he.mpr ⟨⟨hA.1, hA.2.2⟩, hB⟩

end SchwartzPlanePoisson

namespace SchwartzPlanePoisson
open Eisenstein

lemma canonicalQuadraticRow_mul (I : QuadraticIdeal) (a b : O) :
    canonicalQuadraticRow I (a * b) = canonicalQuadraticRow I a * canonicalQuadraticRow I b := by
  simp only [canonicalQuadraticRow, primeSubsetRow, map_mul, Finset.prod_mul_distrib]

lemma canonicalQuadraticRow_star (I : QuadraticIdeal) (z : O) :
    star (canonicalQuadraticRow I z) = canonicalQuadraticRow I z := by
  simp only [canonicalQuadraticRow, primeSubsetRow, star_prod, MulChar.star_apply', complexQuadraticChar_inv]

def quadraticIdealMask (I : QuadraticIdeal) (z : O) : ℂ :=
  primeCoprimeMask quadraticPrimeGenerator (quadraticIdealSupport I) z

lemma canonicalQuadraticRow_square (I : QuadraticIdeal) (z : O) :
    canonicalQuadraticRow I (z ^ 2) = quadraticIdealMask I z := by
  rw [pow_two, canonicalQuadraticRow_mul]
  nth_rw 1 [← canonicalQuadraticRow_star I z]
  exact primeSubsetRow_diagonal quadraticPrimeGenerator
    (fun P => complexQuadraticChar (Ideal.span {quadraticPrimeGenerator P})) (quadraticIdealSupport I) z

/-- Square arguments leave only the coprimality density in a quadratic row. -/
lemma canonicalQuadraticRow_squarefree_argument (I : QuadraticIdeal) (A B : Ideal O) :
    canonicalQuadraticRow I (primaryIdealGenerator (A * B ^ 2)) =
      canonicalQuadraticRow I (primaryIdealGenerator A) * quadraticIdealMask I (primaryIdealGenerator B) := by
  have hp : primaryIdealGenerator (B ^ 2) = primaryIdealGenerator B ^ 2 :=
    map_pow primaryIdealGeneratorHom B 2
  rw [primaryIdealGenerator_mul, hp, canonicalQuadraticRow_mul, canonicalQuadraticRow_square]

abbrev QuadraticSupportedIdeal := {I : Ideal O // quadraticSupported I}

/-- Unique squarefree-square decomposition with the arithmetic support retained. -/
def quadraticSupportedPartsEquiv : QuadraticSupportedIdeal ≃ QuadraticIdeal × QuadraticSupportedIdeal where
  toFun I :=
    let h := (quadraticSupported_parts I.val (primaryIdealGenerator_ne_zero_ideal I.val I.property.1)).mp I.property
    (⟨quadraticSquarefreePart I.val, h.1⟩, ⟨quadraticSquarePart I.val, h.2⟩)
  invFun p := ⟨p.1.val * p.2.val ^ 2,
    quadraticSupported_mul _ _ |>.mpr ⟨⟨p.1.property.1, p.1.property.2.2⟩,
      (quadraticSupported_sq _).mpr p.2.property⟩⟩
  left_inv I := Subtype.ext (quadraticParts_mul_square I.val
    (primaryIdealGenerator_ne_zero_ideal I.val I.property.1))
  right_inv p := by
    have h := quadraticParts_of_squarefree p.1.val p.2.val p.1.property.2.1
      (primaryIdealGenerator_ne_zero_ideal p.2.val p.2.property.1)
    exact Prod.ext (Subtype.ext h.1) (Subtype.ext h.2)

lemma quadraticSupported_tsum_parts (f : Ideal O → ℂ) :
    (∑' I : QuadraticSupportedIdeal, f I.val) =
      ∑' p : QuadraticIdeal × QuadraticSupportedIdeal, f (p.1.val * p.2.val ^ 2) :=
  (quadraticSupportedPartsEquiv.symm.tsum_eq (fun I => f I.val)).symm

end SchwartzPlanePoisson


namespace SchwartzPlanePoisson
open Eisenstein

lemma canonicalQuadraticRow_norm_le_one (I : QuadraticIdeal) (z : O) :
    ‖canonicalQuadraticRow I z‖ ≤ 1 := by
  rw [canonicalQuadraticRow, ← primeCuspRowCharacter_restrict]
  exact primeCuspRowCharacter_norm_le_one _ _ z

abbrev QuadraticSupportedRange (M : ℝ) :=
  {I : QuadraticSupportedIdeal // (Ideal.absNorm I.val : ℝ) ≤ M}

noncomputable instance quadraticSupportedRangeFintype (M : ℝ) : Fintype (QuadraticSupportedRange M) := by
  classical
  let S := {I : Ideal O | Ideal.absNorm I ≤ ⌈M⌉₊}
  letI : Finite S := (Ideal.finite_setOf_absNorm_le (S := O) ⌈M⌉₊).to_subtype
  let f : QuadraticSupportedRange M → S := fun I => ⟨I.val.val, by
    have h : (Ideal.absNorm I.val.val : ℝ) ≤ (⌈M⌉₊ : ℝ) := I.property.trans (Nat.le_ceil M)
    exact_mod_cast h⟩
  have hf : Function.Injective f := fun I J h => Subtype.ext (Subtype.ext (congrArg (fun J : S => J.val) h))
  letI : Finite (QuadraticSupportedRange M) := Finite.of_injective f hf
  exact Fintype.ofFinite _

namespace CanonicalQuadraticSieve

/-- The high squarefree-part kernel over the full ideal norm ball. -/
def highMatrix (M N K : ℝ) : Matrix (QuadraticSupportedRange M) (QuadraticIdealRange N) ℂ :=
  fun I J => if K < (Ideal.absNorm (quadraticSquarefreePart I.val.val) : ℝ) then
    canonicalQuadraticRow J.val (primaryIdealGenerator I.val.val) else 0

def highKernelNorm (M N K : ℝ) : ℝ := ‖FiniteSieveOperator.operator (highMatrix M N K)‖ ^ 2

lemma highKernelNorm_nonneg (M N K : ℝ) : 0 ≤ highKernelNorm M N K := sq_nonneg _

lemma highKernel_energy_bound (M N K : ℝ) (a : QuadraticIdealRange N → ℂ) :
    (∑ I, ‖∑ J, highMatrix M N K I J * a J‖ ^ 2) ≤
      highKernelNorm M N K * ∑ J, ‖a J‖ ^ 2 := by
  classical
  exact FiniteSieveOperator.energy_bound _ _

end CanonicalQuadraticSieve
end SchwartzPlanePoisson


namespace SchwartzPlanePoisson
open Eisenstein MeasureTheory
open scoped SchwartzMap FourierTransform

/-- Squaring the real argument preserves Schwartz decay. -/
def quadraticSquareCLM : 𝓢(ℝ, ℂ) →L[ℝ] 𝓢(ℝ, ℂ) :=
  SchwartzMap.compCLM ℝ (Function.hasTemperateGrowth_norm_sq ℝ)
    ⟨1, 1, fun x => by
      simp only [pow_one, one_mul, norm_pow, Real.norm_of_nonneg (norm_nonneg x)]
      nlinarith only [sq_nonneg (‖x‖ - 1)]⟩

def quadraticSquareProfile (W : 𝓢(ℝ, ℂ)) : 𝓢(ℝ, ℂ) := quadraticSquareCLM W

@[simp] lemma quadraticSquareProfile_apply (W : 𝓢(ℝ, ℂ)) (t : ℝ) :
    quadraticSquareProfile W t = W (t ^ 2) := by
  change W (‖t‖ ^ 2) = _
  rw [Real.norm_eq_abs, sq_abs]

/-- Restricting the plane Fourier transform to its scaled imaginary axis. -/
def quadraticTransformedSquareCLM : 𝓢(ℝ, ℂ) →L[ℝ] 𝓢(ℝ, ℂ) :=
  (2 / Real.sqrt 3 : ℝ) •
    (SchwartzMap.compCLMOfContinuousLinearEquiv ℝ
      (ContinuousLinearEquiv.smulLeft (R₁ := ℝ) (M₁ := ℝ)
        (Units.mk0 ((ringComplex omega).im)⁻¹ (inv_ne_zero complex_omega_im_ne_zero)))).comp
      ((SchwartzMap.compCLMOfAntilipschitz ℝ (vertical_temperate 0)
        (vertical_isometry 0).antilipschitz).comp radialFourierCLM)

def quadraticTransformedSquareProfile (W : 𝓢(ℝ, ℂ)) : 𝓢(ℝ, ℂ) :=
  quadraticTransformedSquareCLM W

@[simp] lemma quadraticTransformedSquareProfile_apply (W : 𝓢(ℝ, ℂ)) (t : ℝ) :
    quadraticTransformedSquareProfile W t = paperRadialFourier W (t ^ 2) := by
  have ht : ‖(t : ℂ)‖ ^ 2 = t ^ 2 := by
    rw [Complex.norm_real, Real.norm_eq_abs, sq_abs]
  rw [← ht, ← paperFourier_radial W (t : ℂ), paperFourier_eq_standard]
  change (2 / Real.sqrt 3 : ℝ) •
    radialFourierCLM W (complexPoint 0 (((ringComplex omega).im)⁻¹ * t)) =
      (2 / Real.sqrt 3 : ℝ) • (𝓕 (radialTest W)) (paperFrequency (t : ℂ))
  rw [radialFourierCLM_apply, paperFrequency_coordinates]
  simp only [Complex.ofReal_im, Complex.ofReal_re, zero_div, div_eq_mul_inv, zero_mul, mul_comm]

lemma quadraticSquareProfile_seminorm_control (S : Finset (ℕ × ℕ)) :
    ∃ (s : Finset (ℕ × ℕ)) (C : ℝ), 0 < C ∧ ∀ W : 𝓢(ℝ, ℂ),
      S.sup (schwartzSeminormFamily ℝ ℝ ℂ) (quadraticSquareProfile W) ≤
        C * s.sup (schwartzSeminormFamily ℝ ℝ ℂ) W :=
  schwartzCLM_finite_seminorm_control quadraticSquareCLM S

lemma quadraticTransformedSquareProfile_seminorm_control (S : Finset (ℕ × ℕ)) :
    ∃ (s : Finset (ℕ × ℕ)) (C : ℝ), 0 < C ∧ ∀ W : 𝓢(ℝ, ℂ),
      S.sup (schwartzSeminormFamily ℝ ℝ ℂ) (quadraticTransformedSquareProfile W) ≤
        C * s.sup (schwartzSeminormFamily ℝ ℝ ℂ) W :=
  schwartzCLM_finite_seminorm_control quadraticTransformedSquareCLM S

end SchwartzPlanePoisson


namespace SchwartzPlanePoisson
open Eisenstein UniqueFactorizationMonoid

lemma quadraticIdealAdmissible_of_dvd {I J : Ideal O}
    (hI : quadraticIdealAdmissible I) (hJI : J ∣ I) : quadraticIdealAdmissible J := by
  obtain ⟨K, rfl⟩ := hJI
  have hJ := ((quadraticSupported_mul J K).mp ⟨hI.1, hI.2.2⟩).1
  exact ⟨hJ.1, hI.2.1.of_mul_left, hJ.2⟩

/-- Exact ideal quotient, used only on divisor columns. -/
def quadraticIdealQuotient (D I : Ideal O) : Ideal O :=
  if h : D ∣ I then h.choose else 0

lemma quadraticIdeal_mul_quotient {D I : Ideal O} (h : D ∣ I) :
    D * quadraticIdealQuotient D I = I := by
  rw [quadraticIdealQuotient, dif_pos h]
  exact h.choose_spec.symm

lemma quadraticIdealQuotient_dvd {D I : Ideal O} (h : D ∣ I) :
    quadraticIdealQuotient D I ∣ I :=
  ⟨D, by rw [mul_comm, quadraticIdeal_mul_quotient h]⟩

lemma quadraticIdealQuotient_admissible {D I : Ideal O}
    (hI : quadraticIdealAdmissible I) (h : D ∣ I) :
    quadraticIdealAdmissible (quadraticIdealQuotient D I) :=
  quadraticIdealAdmissible_of_dvd hI (quadraticIdealQuotient_dvd h)

lemma quadraticIdealQuotient_injective (D : Ideal O) :
    Set.InjOn (quadraticIdealQuotient D) {I : Ideal O | D ∣ I} := by
  intro I hI J hJ h
  rw [← quadraticIdeal_mul_quotient hI, ← quadraticIdeal_mul_quotient hJ, h]

lemma quadraticIdealQuotient_norm {D I : Ideal O} (hD : D ≠ 0) (h : D ∣ I) :
    (Ideal.absNorm (quadraticIdealQuotient D I) : ℝ) = (Ideal.absNorm I : ℝ) / Ideal.absNorm D := by
  have hDnorm : (Ideal.absNorm D : ℝ) ≠ 0 :=
    Nat.cast_ne_zero.mpr (Ideal.absNorm_eq_zero_iff.not.mpr hD)
  apply (eq_div_iff hDnorm).mpr
  have hn := congrArg (fun J : Ideal O => (Ideal.absNorm J : ℝ)) (quadraticIdeal_mul_quotient h)
  simpa only [map_mul, Nat.cast_mul, mul_comm] using hn

lemma quadraticIdealGenerator_factor {D I : Ideal O} (h : D ∣ I) :
    primaryIdealGenerator I = primaryIdealGenerator D * primaryIdealGenerator (quadraticIdealQuotient D I) := by
  rw [← primaryIdealGenerator_mul, quadraticIdeal_mul_quotient h]

end SchwartzPlanePoisson

namespace SchwartzPlanePoisson
open Eisenstein UniqueFactorizationMonoid

lemma mem_quadraticIdealSupport (I : QuadraticIdeal) (P : QuadraticPrime) :
    P ∈ quadraticIdealSupport I ↔ P.val ∈ primeSupport I.val := by
  constructor
  · intro h
    obtain ⟨Q, _, he⟩ := Finset.mem_map.mp h
    have hval : Q.val = P.val := congrArg (fun R : QuadraticPrime => R.val) he
    simpa only [← hval] using Q.property
  · intro h
    exact Finset.mem_map.mpr ⟨⟨P.val, h⟩, Finset.mem_attach _ _, Subtype.ext rfl⟩

lemma quadraticIdealSupport_mul (I J : Ideal O) (h : quadraticIdealAdmissible (I * J)) :
    quadraticIdealSupport ⟨I * J, h⟩ =
      quadraticIdealSupport ⟨I, quadraticIdealAdmissible_of_dvd h (dvd_mul_right I J)⟩ ∪
      quadraticIdealSupport ⟨J, quadraticIdealAdmissible_of_dvd h (dvd_mul_left J I)⟩ := by
  have hI := quadraticIdealAdmissible_of_dvd h (dvd_mul_right I J)
  have hJ := quadraticIdealAdmissible_of_dvd h (dvd_mul_left J I)
  ext P
  simp only [Finset.mem_union, mem_quadraticIdealSupport, primeSupport,
    normalizedFactors_mul (primaryIdealGenerator_ne_zero_ideal I hI.1)
      (primaryIdealGenerator_ne_zero_ideal J hJ.1), Multiset.toFinset_add]

lemma quadraticIdealSupport_disjoint (I J : Ideal O) (h : quadraticIdealAdmissible (I * J)) :
    Disjoint
      (quadraticIdealSupport ⟨I, quadraticIdealAdmissible_of_dvd h (dvd_mul_right I J)⟩)
      (quadraticIdealSupport ⟨J, quadraticIdealAdmissible_of_dvd h (dvd_mul_left J I)⟩) := by
  apply Finset.disjoint_left.mpr
  intro P hP hQ
  have hpI := Multiset.mem_toFinset.mp ((mem_quadraticIdealSupport _ P).mp hP)
  have hpJ := Multiset.mem_toFinset.mp ((mem_quadraticIdealSupport _ P).mp hQ)
  have hp := prime_of_normalized_factor P.val hpI
  exact hp.2.1 ((IsRelPrime.of_squarefree_mul h.2.1)
    (dvd_of_mem_normalizedFactors hpI) (dvd_of_mem_normalizedFactors hpJ))

/-- Squarefree products split into independent quadratic characters. -/
lemma canonicalQuadraticRow_conductor_mul (I J : Ideal O)
    (h : quadraticIdealAdmissible (I * J)) (z : O) :
    canonicalQuadraticRow ⟨I * J, h⟩ z =
      canonicalQuadraticRow ⟨I, quadraticIdealAdmissible_of_dvd h (dvd_mul_right I J)⟩ z *
      canonicalQuadraticRow ⟨J, quadraticIdealAdmissible_of_dvd h (dvd_mul_left J I)⟩ z := by
  simp only [canonicalQuadraticRow]
  rw [quadraticIdealSupport_mul I J h,
    primeSubsetRow_union _ _ _ _ (quadraticIdealSupport_disjoint I J h)]

lemma canonicalQuadraticRow_divisor_factor (I : QuadraticIdeal) (D : Ideal O)
    (h : D ∣ I.val) (z : O) :
    canonicalQuadraticRow I z =
      canonicalQuadraticRow ⟨D, quadraticIdealAdmissible_of_dvd I.property h⟩ z *
      canonicalQuadraticRow ⟨quadraticIdealQuotient D I.val,
        quadraticIdealQuotient_admissible I.property h⟩ z := by
  have hprod : quadraticIdealAdmissible (D * quadraticIdealQuotient D I.val) := by
    rw [quadraticIdeal_mul_quotient h]
    exact I.property
  have he := canonicalQuadraticRow_conductor_mul D (quadraticIdealQuotient D I.val) hprod z
  simpa only [quadraticIdeal_mul_quotient h] using he

end SchwartzPlanePoisson

namespace SchwartzPlanePoisson.CanonicalQuadraticSieve
open Eisenstein

/-- Columns divisible by a fixed ideal, with that common factor removed. -/
def quotientMatrix {m n : Type*} (D : Ideal O)
    (rows : m → QuadraticIdeal) (cols : n → QuadraticIdeal) : Matrix m n ℂ :=
  fun i j => if h : D ∣ (cols j).val then
    canonicalQuadraticRow ⟨quadraticIdealQuotient D (cols j).val,
      quadraticIdealQuotient_admissible (cols j).property h⟩ (primaryIdealGenerator (rows i).val)
    else 0

lemma quotientMatrix_squared_norm_le {m n : Type*} [Fintype m] [Fintype n]
    [DecidableEq m] [DecidableEq n] (D : Ideal O) (hD : D ≠ 0)
    (rows : m → QuadraticIdeal) (cols : n → QuadraticIdeal)
    (hr : Function.Injective rows) (hc : Function.Injective cols)
    (M N : ℝ) (hrows : ∀ i, (Ideal.absNorm (rows i).val : ℝ) ≤ M)
    (hcols : ∀ j, (Ideal.absNorm (cols j).val : ℝ) ≤ N) :
    ‖FiniteSieveOperator.operator (quotientMatrix D rows cols)‖ ^ 2 ≤
      sieveNorm M (N / Ideal.absNorm D) := by
  classical
  let S : Finset n := Finset.univ.filter (fun j => D ∣ (cols j).val)
  have hS (j : S) : D ∣ (cols j.val).val := (Finset.mem_filter.mp j.property).2
  let q : S → QuadraticIdeal := fun j => ⟨quadraticIdealQuotient D (cols j.val).val,
    quadraticIdealQuotient_admissible (cols j.val).property (hS j)⟩
  have hq : Function.Injective q := by
    intro i j he
    apply Subtype.ext
    apply hc
    apply Subtype.ext
    apply quadraticIdealQuotient_injective D (hS i) (hS j)
    exact congrArg (fun I : QuadraticIdeal => I.val) he
  have hqn (j : S) : (Ideal.absNorm (q j).val : ℝ) ≤ N / Ideal.absNorm D := by
    change (Ideal.absNorm (quadraticIdealQuotient D (cols j.val).val) : ℝ) ≤ _
    rw [quadraticIdealQuotient_norm hD (hS j)]
    exact div_le_div_of_nonneg_right (hcols j.val) (Nat.cast_nonneg _)
  have hb := family_squared_norm_le rows q hr hq M (N / Ideal.absNorm D) hrows hqn
  apply FiniteSieveOperator.squared_norm_le_of_energy _ _ (sieveNorm_nonneg _ _)
  intro a
  have hsum (i : m) : (∑ j, quotientMatrix D rows cols i j * a j) =
      ∑ j : S, canonicalQuadraticRow (q j) (primaryIdealGenerator (rows i).val) * a j.val := by
    calc
      _ = ∑ j ∈ S, quotientMatrix D rows cols i j * a j := by
        symm
        apply Finset.sum_subset (Finset.subset_univ S)
        intro j _ hj
        have hd : ¬ D ∣ (cols j).val := by
          simpa only [S, Finset.mem_filter, Finset.mem_univ, true_and] using hj
        simp only [quotientMatrix, dif_neg hd, zero_mul]
      _ = ∑ j : S, quotientMatrix D rows cols i j.val * a j.val :=
        (Finset.sum_coe_sort (s := S) (f := fun j => quotientMatrix D rows cols i j * a j)).symm
      _ = _ := by
        apply Finset.sum_congr rfl
        intro j _
        simp only [quotientMatrix, dif_pos (hS j)]
        rfl
  simp_rw [hsum]
  have he := FiniteSieveOperator.energy_bound
    (fun i j => canonicalQuadraticRow (q j) (primaryIdealGenerator (rows i).val)) (fun j : S => a j.val)
  have hE : (∑ j : S, ‖a j.val‖ ^ 2) ≤ ∑ j, ‖a j‖ ^ 2 := by
    rw [Finset.sum_coe_sort (s := S) (f := fun j : n => ‖a j‖ ^ 2)]
    exact Finset.sum_le_univ_sum_of_nonneg (fun j => sq_nonneg ‖a j‖)
  exact he.trans ((mul_le_mul_of_nonneg_right hb (by positivity)).trans
    (mul_le_mul_of_nonneg_left hE (sieveNorm_nonneg _ _)))

end SchwartzPlanePoisson.CanonicalQuadraticSieve

namespace IdealCoprimeBilinearSieve
open Eisenstein UniqueFactorizationMonoid FiniteSieveOperator DivisorBlockCauchy

/-- Coprimality is an exact signed sum over common ideal divisors. -/
lemma common_divisor_indicator (S : Finset (Ideal O)) (I J : Ideal O)
    (hI : I ≠ 0) (hS : idealDivisors I ⊆ S) :
    (if I ⊔ J = ⊤ then (1 : ℂ) else 0) =
      ∑ D ∈ S, if D ∣ I ∧ D ∣ J then (moebius D : ℂ) else 0 := by
  have hG : I ⊔ J ≠ (0 : Ideal O) := by
    intro h
    exact hI (le_antisymm (h ▸ le_sup_left) bot_le)
  have hfilter : S.filter (fun D => D ∣ I ∧ D ∣ J) = idealDivisors (I ⊔ J) := by
    ext D
    simp only [Finset.mem_filter, mem_idealDivisors hG, Ideal.dvd_iff_le, sup_le_iff]
    constructor
    · exact And.right
    · intro h
      exact ⟨hS ((mem_idealDivisors hI).mpr (Ideal.dvd_iff_le.mpr h.1)), h⟩
  rw [← Finset.sum_filter, hfilter, sum_moebius_divisors _ hG]

lemma moebius_norm_le_one (D : Ideal O) : ‖(moebius D : ℂ)‖ ≤ 1 := by
  by_cases h : Squarefree D
  · rw [h.moebius_eq]
    simp only [Int.cast_pow, Int.cast_neg, Int.cast_one, norm_pow, norm_neg,
      norm_one, one_pow, le_refl]
  · rw [moebius_of_not_squarefree h, Int.cast_zero, norm_zero]
    norm_num

/-- Möbius expansion keeps left and right coefficient masks separate. -/
lemma bilinear_expansion {n p : Type*} [Fintype n] [Fintype p]
    (S : Finset (Ideal O)) (left : n → Ideal O) (right : p → Ideal O)
    (hl : ∀ j, left j ≠ 0) (hS : ∀ j, idealDivisors (left j) ⊆ S)
    (z : n → ℂ) (v : p → ℂ) :
    (∑ j, ∑ k, if left j ⊔ right k = ⊤ then star (z j) * v k else 0) =
      ∑ D ∈ S, (moebius D : ℂ) *
        (star (∑ j, if D ∣ left j then z j else 0) *
          (∑ k, if D ∣ right k then v k else 0)) := by
  have hp (j : n) (k : p) :
      (if left j ⊔ right k = ⊤ then star (z j) * v k else 0) =
        ∑ D ∈ S, (moebius D : ℂ) *
          (if D ∣ left j ∧ D ∣ right k then star (z j) * v k else 0) := by
    calc
      _ = (if left j ⊔ right k = ⊤ then (1 : ℂ) else 0) *
          (star (z j) * v k) := by split_ifs <;> simp
      _ = _ := by
        rw [common_divisor_indicator S _ _ (hl j) (hS j), Finset.sum_mul]
        apply Finset.sum_congr rfl
        intro D _
        split_ifs <;> simp
  simp_rw [hp]
  calc
    _ = ∑ j, ∑ D ∈ S, ∑ k, (moebius D : ℂ) *
        (if D ∣ left j ∧ D ∣ right k then star (z j) * v k else 0) := by
      apply Finset.sum_congr rfl
      intro j _
      exact Finset.sum_comm
    _ = ∑ D ∈ S, ∑ j, ∑ k, (moebius D : ℂ) *
        (if D ∣ left j ∧ D ∣ right k then star (z j) * v k else 0) := Finset.sum_comm
    _ = _ := by
      apply Finset.sum_congr rfl
      intro D _
      simp_rw [← Finset.mul_sum]
      congr 1
      simp only [star_sum, Finset.sum_mul_sum]
      apply Finset.sum_congr rfl
      intro j _
      apply Finset.sum_congr rfl
      intro k _
      by_cases hj : D ∣ left j <;> by_cases hk : D ∣ right k <;> simp [hj, hk]

/-- Coprime restriction costs only a small power of both column norms. -/
theorem ideal_coprime_bilinear_operator_bound {m n p : Type*}
    [Fintype m] [Fintype n] [Fintype p]
    [DecidableEq m] [DecidableEq n] [DecidableEq p]
    (ε : ℝ) (hε : 0 < ε) (left : n → Ideal O) (right : p → Ideal O)
    (hl : ∀ j, left j ≠ 0) (hr : ∀ k, right k ≠ 0)
    (N₁ N₂ : ℝ) (hlN : ∀ j, (Ideal.absNorm (left j) : ℝ) ≤ N₁)
    (hrN : ∀ k, (Ideal.absNorm (right k) : ℝ) ≤ N₂)
    (A : Matrix m n ℂ) (B : Matrix m p ℂ) (a : n → ℂ) (b : p → ℂ) :
    (∑ i, ‖∑ j, ∑ k, if left j ⊔ right k = ⊤ then
      star (A i j * a j) * (B i k * b k) else 0‖) ^ 2 ≤
      (‖operator A‖ ^ 2 * (divisorConstant ε hε * N₁ ^ ε) * ∑ j, ‖a j‖ ^ 2) *
      (‖operator B‖ ^ 2 * (divisorConstant ε hε * N₂ ^ ε) * ∑ k, ‖b k‖ ^ 2) := by
  classical
  let S := Finset.univ.biUnion (fun j : n => idealDivisors (left j))
  have hS (j : n) : idealDivisors (left j) ⊆ S := by
    intro D hD
    exact Finset.mem_biUnion.mpr ⟨j, Finset.mem_univ _, hD⟩
  let X (D : Ideal O) (i : m) : ℂ := ∑ j, A i j * (if D ∣ left j then a j else 0)
  let Y (D : Ideal O) (i : m) : ℂ := ∑ k, B i k * (if D ∣ right k then b k else 0)
  have heq (i : m) :
      (∑ j, ∑ k, if left j ⊔ right k = ⊤ then
        star (A i j * a j) * (B i k * b k) else 0) =
        ∑ D ∈ S, (moebius D : ℂ) * (star (X D i) * Y D i) := by
    simpa only [X, Y, mul_ite, mul_zero] using
      bilinear_expansion S left right hl hS (fun j => A i j * a j) (fun k => B i k * b k)
  have hnorm :
      (∑ i, ‖∑ j, ∑ k, if left j ⊔ right k = ⊤ then
        star (A i j * a j) * (B i k * b k) else 0‖) ≤
        ∑ D ∈ S, ∑ i, ‖X D i‖ * ‖Y D i‖ := by
    rw [Finset.sum_comm]
    apply Finset.sum_le_sum
    intro i _
    rw [heq]
    apply (norm_sum_le _ _).trans
    apply Finset.sum_le_sum
    intro D _
    rw [norm_mul, norm_mul, norm_star]
    exact mul_le_of_le_one_left (mul_nonneg (norm_nonneg _) (norm_nonneg _))
      (moebius_norm_le_one D)
  have hCS := Finset.sum_mul_sq_le_sq_mul_sq (S ×ˢ (Finset.univ : Finset m))
    (fun di => ‖X di.1 di.2‖) (fun di => ‖Y di.1 di.2‖)
  simp only [Finset.sum_product] at hCS
  have hX : (∑ D ∈ S, ∑ i, ‖X D i‖ ^ 2) ≤
      ‖operator A‖ ^ 2 * (divisorConstant ε hε * N₁ ^ ε) * ∑ j, ‖a j‖ ^ 2 := by
    calc
      _ ≤ ∑ D ∈ S, ‖operator A‖ ^ 2 * ∑ j, ‖if D ∣ left j then a j else 0‖ ^ 2 :=
        Finset.sum_le_sum (fun D _ => energy_bound A _)
      _ = ‖operator A‖ ^ 2 * (∑ D ∈ S, ∑ j, ‖if D ∣ left j then a j else 0‖ ^ 2) :=
        (Finset.mul_sum ..).symm
      _ ≤ _ := by
        rw [mul_assoc]
        exact mul_le_mul_of_nonneg_left
          (divisor_mask_energy_small_power ε hε S left hl N₁ hlN a) (sq_nonneg _)
  have hY : (∑ D ∈ S, ∑ i, ‖Y D i‖ ^ 2) ≤
      ‖operator B‖ ^ 2 * (divisorConstant ε hε * N₂ ^ ε) * ∑ k, ‖b k‖ ^ 2 := by
    calc
      _ ≤ ∑ D ∈ S, ‖operator B‖ ^ 2 * ∑ k, ‖if D ∣ right k then b k else 0‖ ^ 2 :=
        Finset.sum_le_sum (fun D _ => energy_bound B _)
      _ = ‖operator B‖ ^ 2 * (∑ D ∈ S, ∑ k, ‖if D ∣ right k then b k else 0‖ ^ 2) :=
        (Finset.mul_sum ..).symm
      _ ≤ _ := by
        rw [mul_assoc]
        exact mul_le_mul_of_nonneg_left
          (divisor_mask_energy_small_power ε hε S right hr N₂ hrN b) (sq_nonneg _)
  exact (pow_le_pow_left₀ (Finset.sum_nonneg (fun _ _ => norm_nonneg _)) hnorm 2).trans
    (hCS.trans (mul_le_mul hX hY (by positivity) ((by positivity : 0 ≤ ∑ D ∈ S, ∑ i, ‖X D i‖ ^ 2).trans hX)))

end IdealCoprimeBilinearSieve

namespace IdealDivisorBilinearBlocks
open Eisenstein FiniteSieveOperator DivisorBlockCauchy IdealCoprimeBilinearSieve

/-- A coprime bilinear block with fixed divisor masks on its two columns. -/
def blockValue {m n p : Type*} [Fintype m] [Fintype n] [Fintype p]
    (left : n → Ideal O) (right : p → Ideal O)
    (A : Ideal O → Matrix m n ℂ) (B : Ideal O → Matrix m p ℂ)
    (a : n → ℂ) (b : p → ℂ) (D E : Ideal O) : ℝ :=
  ∑ i, ‖∑ j, ∑ k, if left j ⊔ right k = ⊤ then
    star (A D i j * (if D ∣ left j then a j else 0)) *
      (B E i k * (if E ∣ right k then b k else 0)) else 0‖

lemma blockValue_nonneg {m n p : Type*} [Fintype m] [Fintype n] [Fintype p]
    (left : n → Ideal O) (right : p → Ideal O)
    (A : Ideal O → Matrix m n ℂ) (B : Ideal O → Matrix m p ℂ)
    (a : n → ℂ) (b : p → ℂ) (D E : Ideal O) : 0 ≤ blockValue left right A B a b D E :=
  Finset.sum_nonneg (fun _ _ => norm_nonneg _)

/-- Two divisor Cauchy inequalities reduce the block to ordinary operator norms. -/
theorem divisor_block_bound {m n p : Type*}
    [Fintype m] [Fintype n] [Fintype p]
    [DecidableEq m] [DecidableEq n] [DecidableEq p]
    (ε : ℝ) (hε : 0 < ε) (S T : Finset (Ideal O))
    (left : n → Ideal O) (right : p → Ideal O)
    (hl : ∀ j, left j ≠ 0) (hr : ∀ k, right k ≠ 0)
    (N₁ N₂ : ℝ) (hN₁ : 0 ≤ N₁) (hN₂ : 0 ≤ N₂)
    (hlN : ∀ j, (Ideal.absNorm (left j) : ℝ) ≤ N₁)
    (hrN : ∀ k, (Ideal.absNorm (right k) : ℝ) ≤ N₂)
    (A : Ideal O → Matrix m n ℂ) (B : Ideal O → Matrix m p ℂ)
    (a : n → ℂ) (b : p → ℂ) (UA UB : ℝ) (hUA : 0 ≤ UA) (hUB : 0 ≤ UB)
    (hA : ∀ D ∈ S, ‖operator (A D)‖ ^ 2 ≤ UA)
    (hB : ∀ E ∈ T, ‖operator (B E)‖ ^ 2 ≤ UB) :
    (∑ D ∈ S, ∑ E ∈ T, blockValue left right A B a b D E) ^ 2 ≤
      (S.card : ℝ) * T.card * UA * UB *
        (divisorConstant ε hε * N₁ ^ ε) ^ 2 *
        (divisorConstant ε hε * N₂ ^ ε) ^ 2 *
        (∑ j, ‖a j‖ ^ 2) * (∑ k, ‖b k‖ ^ 2) := by
  let EL (D : Ideal O) : ℝ := ∑ j, ‖if D ∣ left j then a j else 0‖ ^ 2
  let ER (E : Ideal O) : ℝ := ∑ k, ‖if E ∣ right k then b k else 0‖ ^ 2
  let C := UA * UB * (divisorConstant ε hε * N₁ ^ ε) * (divisorConstant ε hε * N₂ ^ ε)
  have hd := (divisorConstant_pos ε hε).le
  have hC : 0 ≤ C := by dsimp [C]; positivity
  have hEL (D) : 0 ≤ EL D := by dsimp [EL]; positivity
  have hER (E) : 0 ≤ ER E := by dsimp [ER]; positivity
  have hp (D : Ideal O) (hD : D ∈ S) (E : Ideal O) (hE : E ∈ T) :
      (blockValue left right A B a b D E) ^ 2 ≤ C * EL D * ER E := by
    have h := ideal_coprime_bilinear_operator_bound ε hε left right hl hr N₁ N₂ hlN hrN
      (A D) (B E) (fun j => if D ∣ left j then a j else 0)
      (fun k => if E ∣ right k then b k else 0)
    change (blockValue left right A B a b D E) ^ 2 ≤
      (‖operator (A D)‖ ^ 2 * (divisorConstant ε hε * N₁ ^ ε) * EL D) *
      (‖operator (B E)‖ ^ 2 * (divisorConstant ε hε * N₂ ^ ε) * ER E) at h
    apply h.trans
    calc
      _ ≤ (UA * (divisorConstant ε hε * N₁ ^ ε) * EL D) *
          (UB * (divisorConstant ε hε * N₂ ^ ε) * ER E) := by
        gcongr
        · exact hA D hD
        · exact hB E hE
      _ = _ := by dsimp [C]; ring
  have hc := rectangular_cauchy S T (blockValue left right A B a b) EL ER C hC hp
  have hL := divisor_mask_energy_small_power ε hε S left hl N₁ hlN a
  have hR := divisor_mask_energy_small_power ε hε T right hr N₂ hrN b
  change (∑ D ∈ S, EL D) ≤ _ at hL
  change (∑ E ∈ T, ER E) ≤ _ at hR
  calc
    _ ≤ (S.card : ℝ) * T.card * C * (∑ D ∈ S, EL D) * (∑ E ∈ T, ER E) := hc
    _ ≤ (S.card : ℝ) * T.card * C *
        ((divisorConstant ε hε * N₁ ^ ε) * ∑ j, ‖a j‖ ^ 2) *
        ((divisorConstant ε hε * N₂ ^ ε) * ∑ k, ‖b k‖ ^ 2) := by gcongr
    _ = _ := by dsimp [C]; ring

end IdealDivisorBilinearBlocks

namespace SchwartzPlanePoisson.CanonicalQuadraticSieve
open Eisenstein IdealDivisorBilinearBlocks DivisorBlockCauchy

def quotientBlock {m n p : Type*} [Fintype m] [Fintype n] [Fintype p]
    (rows : m → QuadraticIdeal) (left : n → QuadraticIdeal) (right : p → QuadraticIdeal)
    (a : n → ℂ) (b : p → ℂ) (D E : Ideal O) : ℝ :=
  blockValue (fun j => (left j).val) (fun k => (right k).val)
    (fun D => quotientMatrix D rows left) (fun E => quotientMatrix E rows right) a b D E

/-- Removing divisors shrinks the two conductor ranges independently. -/
theorem quotient_divisor_block_bound {m n p : Type*}
    [Fintype m] [Fintype n] [Fintype p]
    [DecidableEq m] [DecidableEq n] [DecidableEq p]
    (ε : ℝ) (hε : 0 < ε) (S T : Finset (Ideal O))
    (D₁ D₂ M N : ℝ) (hD₁ : 0 < D₁) (hD₂ : 0 < D₂) (hN : 0 ≤ N)
    (hS : ∀ D ∈ S, D₁ ≤ (Ideal.absNorm D : ℝ))
    (hT : ∀ E ∈ T, D₂ ≤ (Ideal.absNorm E : ℝ))
    (rows : m → QuadraticIdeal) (left : n → QuadraticIdeal) (right : p → QuadraticIdeal)
    (hr : Function.Injective rows) (hl : Function.Injective left) (hri : Function.Injective right)
    (hrows : ∀ i, (Ideal.absNorm (rows i).val : ℝ) ≤ M)
    (hleft : ∀ j, (Ideal.absNorm (left j).val : ℝ) ≤ N)
    (hright : ∀ k, (Ideal.absNorm (right k).val : ℝ) ≤ N) (a : n → ℂ) (b : p → ℂ) :
    (∑ D ∈ S, ∑ E ∈ T, quotientBlock rows left right a b D E) ^ 2 ≤
      (S.card : ℝ) * T.card * sieveNorm M (N / D₁) * sieveNorm M (N / D₂) *
        (divisorConstant ε hε * N ^ ε) ^ 4 * (∑ j, ‖a j‖ ^ 2) * (∑ k, ‖b k‖ ^ 2) := by
  have hA (D : Ideal O) (hD : D ∈ S) :
      ‖FiniteSieveOperator.operator (quotientMatrix D rows left)‖ ^ 2 ≤ sieveNorm M (N / D₁) := by
    have hD0 : D ≠ 0 := by
      intro hz
      have hn := hS D hD
      simp only [hz, map_zero, Nat.cast_zero] at hn
      exact (not_le_of_gt hD₁) hn
    exact (quotientMatrix_squared_norm_le D hD0 rows left hr hl M N hrows hleft).trans
      (sieveNorm_mono le_rfl (div_le_div_of_nonneg_left hN hD₁ (hS D hD)))
  have hB (E : Ideal O) (hE : E ∈ T) :
      ‖FiniteSieveOperator.operator (quotientMatrix E rows right)‖ ^ 2 ≤ sieveNorm M (N / D₂) := by
    have hE0 : E ≠ 0 := by
      intro hz
      have hn := hT E hE
      simp only [hz, map_zero, Nat.cast_zero] at hn
      exact (not_le_of_gt hD₂) hn
    exact (quotientMatrix_squared_norm_le E hE0 rows right hr hri M N hrows hright).trans
      (sieveNorm_mono le_rfl (div_le_div_of_nonneg_left hN hD₂ (hT E hE)))
  have h := divisor_block_bound ε hε S T (fun j => (left j).val) (fun k => (right k).val)
    (fun j => primaryIdealGenerator_ne_zero_ideal _ (left j).property.1)
    (fun k => primaryIdealGenerator_ne_zero_ideal _ (right k).property.1)
    N N hN hN hleft hright
    (fun D => quotientMatrix D rows left) (fun E => quotientMatrix E rows right) a b
    (sieveNorm M (N / D₁)) (sieveNorm M (N / D₂)) (sieveNorm_nonneg _ _) (sieveNorm_nonneg _ _) hA hB
  change (∑ D ∈ S, ∑ E ∈ T, quotientBlock rows left right a b D E) ^ 2 ≤ _ at h
  convert h using 1 <;> ring

end SchwartzPlanePoisson.CanonicalQuadraticSieve

namespace SchwartzPlanePoisson
open Eisenstein

/-- The quadratic character vanishes outside its squarefree odd conductor family. -/
def canonicalQuadraticRowOfIdeal (I : Ideal O) (z : O) : ℂ :=
  if h : quadraticIdealAdmissible I then canonicalQuadraticRow ⟨I, h⟩ z else 0

lemma canonicalQuadraticRowOfIdeal_norm_le_one (I : Ideal O) (z : O) :
    ‖canonicalQuadraticRowOfIdeal I z‖ ≤ 1 := by
  unfold canonicalQuadraticRowOfIdeal
  split_ifs
  · exact canonicalQuadraticRow_norm_le_one _ _
  · simp

namespace CanonicalQuadraticSieve
open IdealDivisorBilinearBlocks DivisorBlockCauchy

/-- The original characters, before their common divisor is removed. -/
def originalBlock {m n p : Type*} [Fintype m] [Fintype n] [Fintype p]
    (rows : m → QuadraticIdeal) (left : n → QuadraticIdeal) (right : p → QuadraticIdeal)
    (a : n → ℂ) (b : p → ℂ) (D E : Ideal O) : ℝ :=
  blockValue (fun j => (left j).val) (fun k => (right k).val)
    (fun _ i j => canonicalQuadraticRow (left j) (primaryIdealGenerator (rows i).val))
    (fun _ i k => canonicalQuadraticRow (right k) (primaryIdealGenerator (rows i).val)) a b D E

lemma original_entry_factor {m n : Type*} (rows : m → QuadraticIdeal) (cols : n → QuadraticIdeal)
    (a : n → ℂ) (D : Ideal O) (i : m) (j : n) :
    canonicalQuadraticRow (cols j) (primaryIdealGenerator (rows i).val) *
        (if D ∣ (cols j).val then a j else 0) =
      canonicalQuadraticRowOfIdeal D (primaryIdealGenerator (rows i).val) *
        (quotientMatrix D rows cols i j * (if D ∣ (cols j).val then a j else 0)) := by
  by_cases h : D ∣ (cols j).val
  · simp only [if_pos h, quotientMatrix, dif_pos h, canonicalQuadraticRowOfIdeal,
      dif_pos (quadraticIdealAdmissible_of_dvd (cols j).property h)]
    rw [canonicalQuadraticRow_divisor_factor (cols j) D h]
    exact mul_assoc _ _ _
  · simp only [if_neg h, mul_zero]

lemma originalBlock_le_quotientBlock {m n p : Type*}
    [Fintype m] [Fintype n] [Fintype p]
    (rows : m → QuadraticIdeal) (left : n → QuadraticIdeal) (right : p → QuadraticIdeal)
    (a : n → ℂ) (b : p → ℂ) (D E : Ideal O) :
    originalBlock rows left right a b D E ≤ quotientBlock rows left right a b D E := by
  apply Finset.sum_le_sum
  intro i _
  have he : (∑ j, ∑ k, if (left j).val ⊔ (right k).val = ⊤ then
      star (canonicalQuadraticRow (left j) (primaryIdealGenerator (rows i).val) *
        (if D ∣ (left j).val then a j else 0)) *
      (canonicalQuadraticRow (right k) (primaryIdealGenerator (rows i).val) *
        (if E ∣ (right k).val then b k else 0)) else 0) =
      (star (canonicalQuadraticRowOfIdeal D (primaryIdealGenerator (rows i).val)) *
        canonicalQuadraticRowOfIdeal E (primaryIdealGenerator (rows i).val)) *
      (∑ j, ∑ k, if (left j).val ⊔ (right k).val = ⊤ then
        star (quotientMatrix D rows left i j * (if D ∣ (left j).val then a j else 0)) *
          (quotientMatrix E rows right i k * (if E ∣ (right k).val then b k else 0)) else 0) := by
    simp only [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    apply Finset.sum_congr rfl
    intro k _
    by_cases h : (left j).val ⊔ (right k).val = ⊤
    · rw [if_pos h, if_pos h, original_entry_factor rows left a D i j,
        original_entry_factor rows right b E i k, star_mul]
      ring
    · simp only [if_neg h, mul_zero]
  change ‖_‖ ≤ ‖_‖
  rw [he, norm_mul]
  apply mul_le_of_le_one_left (norm_nonneg _)
  rw [norm_mul, norm_star]
  exact (mul_le_mul (canonicalQuadraticRowOfIdeal_norm_le_one D _)
    (canonicalQuadraticRowOfIdeal_norm_le_one E _) (norm_nonneg _) zero_le_one).trans_eq (one_mul 1)

/-- Divisor removal retains the original coprime bilinear block bound. -/
theorem original_divisor_block_bound {m n p : Type*}
    [Fintype m] [Fintype n] [Fintype p]
    [DecidableEq m] [DecidableEq n] [DecidableEq p]
    (ε : ℝ) (hε : 0 < ε) (S T : Finset (Ideal O))
    (D₁ D₂ M N : ℝ) (hD₁ : 0 < D₁) (hD₂ : 0 < D₂) (hN : 0 ≤ N)
    (hS : ∀ D ∈ S, D₁ ≤ (Ideal.absNorm D : ℝ))
    (hT : ∀ E ∈ T, D₂ ≤ (Ideal.absNorm E : ℝ))
    (rows : m → QuadraticIdeal) (left : n → QuadraticIdeal) (right : p → QuadraticIdeal)
    (hr : Function.Injective rows) (hl : Function.Injective left) (hri : Function.Injective right)
    (hrows : ∀ i, (Ideal.absNorm (rows i).val : ℝ) ≤ M)
    (hleft : ∀ j, (Ideal.absNorm (left j).val : ℝ) ≤ N)
    (hright : ∀ k, (Ideal.absNorm (right k).val : ℝ) ≤ N) (a : n → ℂ) (b : p → ℂ) :
    (∑ D ∈ S, ∑ E ∈ T, originalBlock rows left right a b D E) ^ 2 ≤
      (S.card : ℝ) * T.card * sieveNorm M (N / D₁) * sieveNorm M (N / D₂) *
        (divisorConstant ε hε * N ^ ε) ^ 4 * (∑ j, ‖a j‖ ^ 2) * (∑ k, ‖b k‖ ^ 2) := by
  apply le_trans _ (quotient_divisor_block_bound ε hε S T D₁ D₂ M N hD₁ hD₂ hN hS hT
    rows left right hr hl hri hrows hleft hright a b)
  apply pow_le_pow_left₀
  · exact Finset.sum_nonneg (fun _ _ => Finset.sum_nonneg (fun _ _ => blockValue_nonneg ..))
  · exact Finset.sum_le_sum (fun D _ => Finset.sum_le_sum
      (fun E _ => originalBlock_le_quotientBlock rows left right a b D E))

end CanonicalQuadraticSieve
end SchwartzPlanePoisson

namespace SchwartzPlanePoisson.CanonicalQuadraticSieve
open Eisenstein

/-- Any injective high-kernel row family is a restriction of the canonical norm ball. -/
lemma highKernel_family_squared_norm_le {m n : Type*} [Fintype m] [Fintype n]
    [DecidableEq m] [DecidableEq n]
    (rows : m → QuadraticSupportedIdeal) (cols : n → QuadraticIdeal)
    (hr : Function.Injective rows) (hc : Function.Injective cols)
    (M N K : ℝ) (hM : ∀ i, (Ideal.absNorm (rows i).val : ℝ) ≤ M)
    (hN : ∀ j, (Ideal.absNorm (cols j).val : ℝ) ≤ N)
    (hK : ∀ i, K < (Ideal.absNorm (quadraticSquarefreePart (rows i).val) : ℝ)) :
    ‖FiniteSieveOperator.operator
      (fun i j => canonicalQuadraticRow (cols j) (primaryIdealGenerator (rows i).val))‖ ^ 2 ≤
      highKernelNorm M N K := by
  let r : m → QuadraticSupportedRange M := fun i => ⟨rows i, hM i⟩
  let c : n → QuadraticIdealRange N := fun j => ⟨cols j, hN j⟩
  have hr' : Function.Injective r := fun i j h => hr (congrArg (fun J : QuadraticSupportedRange M => J.val) h)
  have hc' : Function.Injective c := fun i j h => hc (congrArg (fun J : QuadraticIdealRange N => J.val) h)
  classical
  have hb := FiniteSieveRestriction.submatrix_norm_le r hr' c hc' (highMatrix M N K)
  have he : (fun i j => highMatrix M N K (r i) (c j)) =
      fun i j => canonicalQuadraticRow (cols j) (primaryIdealGenerator (rows i).val) := by
    funext i j
    exact if_pos (hK i)
  rw [he] at hb
  exact pow_le_pow_left₀ (norm_nonneg _) hb 2

/-- Enlarging either norm ball or lowering the squarefree threshold enlarges the kernel bound. -/
lemma highKernelNorm_mono {M N K M' N' K' : ℝ}
    (hM : M ≤ M') (hN : N ≤ N') (hK : K' ≤ K) :
    highKernelNorm M N K ≤ highKernelNorm M' N' K' := by
  classical
  let r : QuadraticSupportedRange M → QuadraticSupportedRange M' :=
    fun I => ⟨I.val, I.property.trans hM⟩
  let c := rangeInclusion hN
  have hr : Function.Injective r := fun I J h =>
    Subtype.ext (congrArg (fun J : QuadraticSupportedRange M' => J.val) h)
  let B : Matrix (QuadraticSupportedRange M) (QuadraticIdealRange N) ℂ :=
    fun I J => highMatrix M' N' K' (r I) (c J)
  let w : QuadraticSupportedRange M → ℂ := fun I =>
    if K < (Ideal.absNorm (quadraticSquarefreePart I.val.val) : ℝ) then 1 else 0
  have hw (I : QuadraticSupportedRange M) : ‖w I‖ ≤ 1 := by
    dsimp only [w]
    split_ifs <;> norm_num
  have he : highMatrix M N K = fun I J => w I * B I J * 1 := by
    funext I J
    change (if K < (Ideal.absNorm (quadraticSquarefreePart I.val.val) : ℝ) then _ else 0) = _
    by_cases h : K < (Ideal.absNorm (quadraticSquarefreePart I.val.val) : ℝ)
    · have h' := hK.trans_lt h
      simp only [highMatrix, w, B, r, c, rangeInclusion, if_pos h, if_pos h', one_mul, mul_one]
    · simp only [highMatrix, w, if_neg h, zero_mul]
  have hb := FiniteSieveRestriction.submatrix_norm_le r hr c (rangeInclusion_injective hN)
    (highMatrix M' N' K')
  have ht := FiniteSieveOperator.diagonal_twist_norm_le B w (fun _ => 1) hw
    (fun _ => by norm_num)
  rw [← he] at ht
  exact pow_le_pow_left₀ (norm_nonneg _) (ht.trans hb) 2

end SchwartzPlanePoisson.CanonicalQuadraticSieve

namespace SchwartzPlanePoisson.CanonicalQuadraticSieve
open Eisenstein

/-- Divisor columns in the high kernel keep the squarefree-part threshold unchanged. -/
def highQuotientMatrix {m n : Type*} (D : Ideal O)
    (rows : m → QuadraticSupportedIdeal) (cols : n → QuadraticIdeal) : Matrix m n ℂ :=
  fun i j => if h : D ∣ (cols j).val then
    canonicalQuadraticRow ⟨quadraticIdealQuotient D (cols j).val,
      quadraticIdealQuotient_admissible (cols j).property h⟩ (primaryIdealGenerator (rows i).val)
    else 0

lemma highQuotientMatrix_squared_norm_le {m n : Type*} [Fintype m] [Fintype n]
    [DecidableEq m] [DecidableEq n] (D : Ideal O) (hD : D ≠ 0)
    (rows : m → QuadraticSupportedIdeal) (cols : n → QuadraticIdeal)
    (hr : Function.Injective rows) (hc : Function.Injective cols)
    (M N K : ℝ) (hrows : ∀ i, (Ideal.absNorm (rows i).val : ℝ) ≤ M)
    (hcols : ∀ j, (Ideal.absNorm (cols j).val : ℝ) ≤ N)
    (hK : ∀ i, K < (Ideal.absNorm (quadraticSquarefreePart (rows i).val) : ℝ)) :
    ‖FiniteSieveOperator.operator (highQuotientMatrix D rows cols)‖ ^ 2 ≤
      highKernelNorm M (N / Ideal.absNorm D) K := by
  classical
  let S : Finset n := Finset.univ.filter (fun j => D ∣ (cols j).val)
  have hS (j : S) : D ∣ (cols j.val).val := (Finset.mem_filter.mp j.property).2
  let q : S → QuadraticIdeal := fun j => ⟨quadraticIdealQuotient D (cols j.val).val,
    quadraticIdealQuotient_admissible (cols j.val).property (hS j)⟩
  have hq : Function.Injective q := by
    intro i j he
    apply Subtype.ext
    apply hc
    apply Subtype.ext
    apply quadraticIdealQuotient_injective D (hS i) (hS j)
    exact congrArg (fun I : QuadraticIdeal => I.val) he
  have hqn (j : S) : (Ideal.absNorm (q j).val : ℝ) ≤ N / Ideal.absNorm D := by
    change (Ideal.absNorm (quadraticIdealQuotient D (cols j.val).val) : ℝ) ≤ _
    rw [quadraticIdealQuotient_norm hD (hS j)]
    exact div_le_div_of_nonneg_right (hcols j.val) (Nat.cast_nonneg _)
  have hb := highKernel_family_squared_norm_le rows q hr hq M (N / Ideal.absNorm D) K hrows hqn hK
  apply FiniteSieveOperator.squared_norm_le_of_energy _ _ (highKernelNorm_nonneg _ _ _)
  intro a
  have hsum (i : m) : (∑ j, highQuotientMatrix D rows cols i j * a j) =
      ∑ j : S, canonicalQuadraticRow (q j) (primaryIdealGenerator (rows i).val) * a j.val := by
    calc
      _ = ∑ j ∈ S, highQuotientMatrix D rows cols i j * a j := by
        symm
        apply Finset.sum_subset (Finset.subset_univ S)
        intro j _ hj
        have hd : ¬ D ∣ (cols j).val := by
          simpa only [S, Finset.mem_filter, Finset.mem_univ, true_and] using hj
        simp only [highQuotientMatrix, dif_neg hd, zero_mul]
      _ = ∑ j : S, highQuotientMatrix D rows cols i j.val * a j.val :=
        (Finset.sum_coe_sort (s := S) (f := fun j => highQuotientMatrix D rows cols i j * a j)).symm
      _ = _ := by
        apply Finset.sum_congr rfl
        intro j _
        simp only [highQuotientMatrix, dif_pos (hS j)]
        rfl
  simp_rw [hsum]
  have he := FiniteSieveOperator.energy_bound
    (fun i j => canonicalQuadraticRow (q j) (primaryIdealGenerator (rows i).val)) (fun j : S => a j.val)
  have hE : (∑ j : S, ‖a j.val‖ ^ 2) ≤ ∑ j, ‖a j‖ ^ 2 := by
    rw [Finset.sum_coe_sort (s := S) (f := fun j : n => ‖a j‖ ^ 2)]
    exact Finset.sum_le_univ_sum_of_nonneg (fun j => sq_nonneg ‖a j‖)
  exact he.trans ((mul_le_mul_of_nonneg_right hb (by positivity)).trans
    (mul_le_mul_of_nonneg_left hE (highKernelNorm_nonneg _ _ _)))

end SchwartzPlanePoisson.CanonicalQuadraticSieve

namespace SchwartzPlanePoisson
open Eisenstein

/-- Chosen generators inject ideal norm balls into Eisenstein lattice norm balls. -/
lemma finite_ideal_card_bound (S : Finset (Ideal O)) (N : ℝ) (hN : 1 ≤ N)
    (hn : ∀ I ∈ S, (Ideal.absNorm I : ℝ) ≤ N) :
    (S.card : ℝ) ≤ diagonalControl sieveCutoff * N := by
  classical
  rw [← Finset.card_image_iff.mpr cubicIdealGenerator_injective.injOn]
  apply finite_norm_ball_card_bound _ N hN
  intro z hz
  obtain ⟨I, hI, rfl⟩ := Finset.mem_image.mp hz
  rw [ringComplex_norm_sq_eq_absNorm_span, span_cubicIdealGenerator]
  exact hn I hI

end SchwartzPlanePoisson


namespace SchwartzPlanePoisson
open Eisenstein

/-- Dividing by the exact common ideal makes the remaining conductors coprime. -/
lemma quadraticIdealQuotient_coprime_iff (D I J : Ideal O) (hD : D ≠ 0)
    (hI : D ∣ I) (hJ : D ∣ J) :
    quadraticIdealQuotient D I ⊔ quadraticIdealQuotient D J = ⊤ ↔ I ⊔ J = D := by
  have he : D * (quadraticIdealQuotient D I ⊔ quadraticIdealQuotient D J) = I ⊔ J := by
    rw [← Ideal.add_eq_sup, mul_add, quadraticIdeal_mul_quotient hI,
      quadraticIdeal_mul_quotient hJ, Ideal.add_eq_sup]
  constructor
  · intro h
    rw [h, ← Ideal.one_eq_top, mul_one] at he
    exact he.symm
  · intro h
    apply mul_left_cancel₀ hD
    rw [he, h, ← Ideal.one_eq_top, mul_one]

namespace CanonicalQuadraticSieve

/-- Common ideals partition all pairs of conductor columns. -/
def commonFactorPool {n : Type*} [Fintype n] (cols : n → QuadraticIdeal) : Finset (Ideal O) :=
  Finset.univ.image (fun p : n × n => (cols p.1).val ⊔ (cols p.2).val)

lemma mem_commonFactorPool {n : Type*} [Fintype n] (cols : n → QuadraticIdeal) (j k : n) :
    (cols j).val ⊔ (cols k).val ∈ commonFactorPool cols :=
  Finset.mem_image.mpr ⟨(j, k), Finset.mem_univ _, rfl⟩

lemma commonFactorPool_admissible {n : Type*} [Fintype n]
    (cols : n → QuadraticIdeal) (D : Ideal O) (hD : D ∈ commonFactorPool cols) :
    quadraticIdealAdmissible D := by
  obtain ⟨⟨j, k⟩, _, rfl⟩ := Finset.mem_image.mp hD
  exact quadraticIdealAdmissible_of_dvd (cols j).property (Ideal.dvd_iff_le.mpr le_sup_left)

/-- Gram entries with a prescribed common conductor ideal. -/
def commonFactorBlock {m n : Type*} [Fintype m] [Fintype n]
    (D : Ideal O) (rows : m → O) (cols : n → QuadraticIdeal) (a : n → ℂ) : ℂ :=
  ∑ i, ∑ j, ∑ k, if (cols j).val ⊔ (cols k).val = D then
    star (canonicalQuadraticRow (cols j) (rows i) * a j) *
      (canonicalQuadraticRow (cols k) (rows i) * a k) else 0

end CanonicalQuadraticSieve
end SchwartzPlanePoisson

namespace SchwartzPlanePoisson.CanonicalQuadraticSieve
open Eisenstein

lemma energy_eq_commonFactorBlocks {m n : Type*} [Fintype m] [Fintype n]
    (rows : m → O) (cols : n → QuadraticIdeal) (a : n → ℂ) :
    ((∑ i, ‖∑ j, canonicalQuadraticRow (cols j) (rows i) * a j‖ ^ 2 : ℝ) : ℂ) =
      ∑ D ∈ commonFactorPool cols, commonFactorBlock D rows cols a := by
  classical
  have hp (i : m) (j k : n) :
      (∑ D ∈ commonFactorPool cols, if (cols j).val ⊔ (cols k).val = D then
        star (canonicalQuadraticRow (cols j) (rows i) * a j) *
          (canonicalQuadraticRow (cols k) (rows i) * a k) else 0) =
        star (canonicalQuadraticRow (cols j) (rows i) * a j) *
          (canonicalQuadraticRow (cols k) (rows i) * a k) := by
    rw [Finset.sum_eq_single ((cols j).val ⊔ (cols k).val)]
    · exact if_pos rfl
    · intro D _ hD
      exact if_neg (Ne.symm hD)
    · exact fun h => (h (mem_commonFactorPool cols j k)).elim
  have hi (i : m) :
      (∑ D ∈ commonFactorPool cols, ∑ j, ∑ k, if (cols j).val ⊔ (cols k).val = D then
        star (canonicalQuadraticRow (cols j) (rows i) * a j) *
          (canonicalQuadraticRow (cols k) (rows i) * a k) else 0) =
      ∑ j, ∑ k, star (canonicalQuadraticRow (cols j) (rows i) * a j) *
        (canonicalQuadraticRow (cols k) (rows i) * a k) := by
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro j _
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl (fun k _ => hp i j k)
  simp only [commonFactorBlock]
  rw [Finset.sum_comm]
  simp_rw [hi]
  rw [Complex.ofReal_sum]
  apply Finset.sum_congr rfl
  intro i _
  rw [← Finset.sum_mul_sum, ← star_sum]
  simpa only [Complex.star_def, Complex.ofReal_pow] using
    (Complex.conj_mul' (∑ j, canonicalQuadraticRow (cols j) (rows i) * a j)).symm

lemma energy_le_commonFactorBlocks {m n : Type*} [Fintype m] [Fintype n]
    (rows : m → O) (cols : n → QuadraticIdeal) (a : n → ℂ) :
    (∑ i, ‖∑ j, canonicalQuadraticRow (cols j) (rows i) * a j‖ ^ 2) ≤
      ∑ D ∈ commonFactorPool cols, ‖commonFactorBlock D rows cols a‖ := by
  have he := congrArg norm (energy_eq_commonFactorBlocks rows cols a)
  rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by positivity)] at he
  rw [he]
  exact norm_sum_le _ _

end SchwartzPlanePoisson.CanonicalQuadraticSieve

namespace SchwartzPlanePoisson.CanonicalQuadraticSieve
open Eisenstein DivisorBlockCauchy IdealCoprimeBilinearSieve

/-- A fixed common ideal reduces the column norm by its exact norm. -/
theorem highKernel_commonFactorBlock_bound {m n : Type*} [Fintype m] [Fintype n]
    [DecidableEq m] [DecidableEq n] (ε : ℝ) (hε : 0 < ε) (D : QuadraticIdeal)
    (rows : m → QuadraticSupportedIdeal) (cols : n → QuadraticIdeal)
    (hr : Function.Injective rows) (hc : Function.Injective cols)
    (M N K : ℝ) (hN : 1 ≤ N)
    (hrows : ∀ i, (Ideal.absNorm (rows i).val : ℝ) ≤ M)
    (hcols : ∀ j, (Ideal.absNorm (cols j).val : ℝ) ≤ N)
    (hK : ∀ i, K < (Ideal.absNorm (quadraticSquarefreePart (rows i).val) : ℝ)) (a : n → ℂ) :
    ‖commonFactorBlock D.val (fun i => primaryIdealGenerator (rows i).val) cols a‖ ≤
      highKernelNorm M (N / Ideal.absNorm D.val) K * (divisorConstant ε hε * N ^ ε) *
        ∑ j, ‖if D.val ∣ (cols j).val then a j else 0‖ ^ 2 := by
  classical
  have hD0 := primaryIdealGenerator_ne_zero_ideal D.val D.property.1
  have hDN : (1 : ℝ) ≤ Ideal.absNorm D.val := by
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr (Ideal.absNorm_eq_zero_iff.not.mpr hD0)
  have hN0 : 0 ≤ N := zero_le_one.trans hN
  have hdiv : N / Ideal.absNorm D.val ≤ N := by
    exact div_le_self hN0 hDN
  let S : Finset n := Finset.univ.filter (fun j => D.val ∣ (cols j).val)
  have hS (j : S) : D.val ∣ (cols j.val).val := (Finset.mem_filter.mp j.property).2
  let q : S → QuadraticIdeal := fun j => ⟨quadraticIdealQuotient D.val (cols j.val).val,
    quadraticIdealQuotient_admissible (cols j.val).property (hS j)⟩
  have hq : Function.Injective q := by
    intro i j he
    apply Subtype.ext
    apply hc
    apply Subtype.ext
    apply quadraticIdealQuotient_injective D.val (hS i) (hS j)
    exact congrArg (fun I : QuadraticIdeal => I.val) he
  have hqn (j : S) : (Ideal.absNorm (q j).val : ℝ) ≤ N / Ideal.absNorm D.val := by
    change (Ideal.absNorm (quadraticIdealQuotient D.val (cols j.val).val) : ℝ) ≤ _
    rw [quadraticIdealQuotient_norm hD0 (hS j)]
    exact div_le_div_of_nonneg_right (hcols j.val) (Nat.cast_nonneg _)
  let A : Matrix m S ℂ := fun i j => canonicalQuadraticRow (q j) (primaryIdealGenerator (rows i).val)
  let v (i : m) : ℂ := canonicalQuadraticRow D (primaryIdealGenerator (rows i).val)
  let T (i : m) (j k : n) : ℂ := if (cols j).val ⊔ (cols k).val = D.val then
    star (canonicalQuadraticRow (cols j) (primaryIdealGenerator (rows i).val) * a j) *
      (canonicalQuadraticRow (cols k) (primaryIdealGenerator (rows i).val) * a k) else 0
  have hzero_left (i : m) (j k : n) (hj : j ∉ S) : T i j k = 0 := by
    apply if_neg
    intro he
    apply hj
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ _,
      Ideal.dvd_iff_le.mpr (he ▸ (le_sup_left : (cols j).val ≤ (cols j).val ⊔ (cols k).val))⟩
  have hzero_right (i : m) (j k : n) (hk : k ∉ S) : T i j k = 0 := by
    apply if_neg
    intro he
    apply hk
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ _,
      Ideal.dvd_iff_le.mpr (he ▸ (le_sup_right : (cols k).val ≤ (cols j).val ⊔ (cols k).val))⟩
  have heq (i : m) : (∑ j, ∑ k, T i j k) =
      star (v i) * v i *
        (∑ j : S, ∑ k : S, if (q j).val ⊔ (q k).val = ⊤ then
          star (A i j * a j.val) * (A i k * a k.val) else 0) := by
    calc
      _ = ∑ j ∈ S, ∑ k ∈ S, T i j k := by
        have hj : (∑ j, ∑ k, T i j k) = ∑ j ∈ S, ∑ k, T i j k := by
          symm
          apply Finset.sum_subset (Finset.subset_univ S)
          intro j _ hj
          exact Finset.sum_eq_zero (fun k _ => hzero_left i j k hj)
        rw [hj]
        apply Finset.sum_congr rfl
        intro j _
        symm
        exact Finset.sum_subset (Finset.subset_univ S) (fun k _ hk => hzero_right i j k hk)
      _ = ∑ j : S, ∑ k : S, T i j.val k.val := by
        rw [Finset.sum_coe_sort (s := S) (f := fun j => ∑ k : S, T i j k.val)]
        exact Finset.sum_congr rfl (fun j _ =>
          (Finset.sum_coe_sort (s := S) (f := fun k => T i j k)).symm)
      _ = _ := by
        simp only [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro j _
        apply Finset.sum_congr rfl
        intro k _
        have hiff := quadraticIdealQuotient_coprime_iff D.val (cols j.val).val (cols k.val).val
          hD0 (hS j) (hS k)
        change (if (cols j.val).val ⊔ (cols k.val).val = D.val then _ else 0) = _
        by_cases h : (q j).val ⊔ (q k).val = ⊤
        · rw [if_pos (hiff.mp h), if_pos h]
          rw [canonicalQuadraticRow_divisor_factor (cols j.val) D.val (hS j),
            canonicalQuadraticRow_divisor_factor (cols k.val) D.val (hS k), star_mul, star_mul]
          change (star (a j.val) * (star (A i j) * star (v i))) * (v i * A i k * a k.val) = _
          simp only [star_mul]
          ring
        · rw [if_neg (fun hc => h (hiff.mpr hc)), if_neg h, mul_zero]
  have hn : ‖commonFactorBlock D.val (fun i => primaryIdealGenerator (rows i).val) cols a‖ ≤
      ∑ i, ‖∑ j : S, ∑ k : S, if (q j).val ⊔ (q k).val = ⊤ then
        star (A i j * a j.val) * (A i k * a k.val) else 0‖ := by
    change ‖∑ i, ∑ j, ∑ k, T i j k‖ ≤ _
    simp_rw [heq]
    apply (norm_sum_le _ _).trans
    apply Finset.sum_le_sum
    intro i _
    rw [norm_mul, norm_mul, norm_star]
    apply mul_le_of_le_one_left (norm_nonneg _)
    exact (mul_le_mul (canonicalQuadraticRow_norm_le_one D _)
      (canonicalQuadraticRow_norm_le_one D _) (norm_nonneg _) zero_le_one).trans_eq (one_mul 1)
  have hb := ideal_coprime_bilinear_operator_bound ε hε
    (fun j : S => (q j).val) (fun j : S => (q j).val)
    (fun j => primaryIdealGenerator_ne_zero_ideal _ (q j).property.1)
    (fun j => primaryIdealGenerator_ne_zero_ideal _ (q j).property.1)
    N N (fun j => (hqn j).trans hdiv) (fun j => (hqn j).trans hdiv)
    A A (fun j : S => a j.val) (fun j : S => a j.val)
  have hL : 0 ≤ divisorConstant ε hε * N ^ ε :=
    mul_nonneg (divisorConstant_pos ε hε).le (Real.rpow_nonneg hN0 _)
  have hop := highKernel_family_squared_norm_le rows q hr hq M (N / Ideal.absNorm D.val) K hrows hqn hK
  have hs : (∑ j : S, ‖a j.val‖ ^ 2) = ∑ j, ‖if D.val ∣ (cols j).val then a j else 0‖ ^ 2 := by
    rw [Finset.sum_coe_sort (s := S) (f := fun j : n => ‖a j‖ ^ 2)]
    simp only [S, Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro j _
    split_ifs <;> simp
  have hb' := (sq_le_sq₀ (Finset.sum_nonneg (fun _ _ => norm_nonneg _))
    (mul_nonneg (mul_nonneg (sq_nonneg _) hL) (by positivity))).mp
      (show (∑ i, ‖∑ j : S, ∑ k : S, if (q j).val ⊔ (q k).val = ⊤ then
        star (A i j * a j.val) * (A i k * a k.val) else 0‖) ^ 2 ≤
        (‖FiniteSieveOperator.operator A‖ ^ 2 * (divisorConstant ε hε * N ^ ε) * ∑ j : S, ‖a j.val‖ ^ 2) ^ 2 by
          simpa only [pow_two] using hb)
  apply hn.trans (hb'.trans _)
  rw [← hs]
  exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hop hL) (by positivity)

end SchwartzPlanePoisson.CanonicalQuadraticSieve

namespace SchwartzPlanePoisson.CanonicalQuadraticSieve
open Eisenstein DivisorBlockCauchy

/-- Large common conductors are absorbed into a shorter high-kernel column range. -/
theorem highKernel_large_commonFactorBlocks {m n : Type*} [Fintype m] [Fintype n]
    [DecidableEq m] [DecidableEq n] (ε : ℝ) (hε : 0 < ε)
    (rows : m → QuadraticSupportedIdeal) (cols : n → QuadraticIdeal)
    (hr : Function.Injective rows) (hc : Function.Injective cols)
    (S : Finset (Ideal O)) (hS : S ⊆ commonFactorPool cols) (G : ℝ) (hG : 0 < G)
    (hSG : ∀ D ∈ S, G ≤ (Ideal.absNorm D : ℝ))
    (M N K : ℝ) (hN : 1 ≤ N)
    (hrows : ∀ i, (Ideal.absNorm (rows i).val : ℝ) ≤ M)
    (hcols : ∀ j, (Ideal.absNorm (cols j).val : ℝ) ≤ N)
    (hK : ∀ i, K < (Ideal.absNorm (quadraticSquarefreePart (rows i).val) : ℝ)) (a : n → ℂ) :
    (∑ D ∈ S, ‖commonFactorBlock D (fun i => primaryIdealGenerator (rows i).val) cols a‖) ≤
      highKernelNorm M (N / G) K * (divisorConstant ε hε * N ^ ε) ^ 2 * ∑ j, ‖a j‖ ^ 2 := by
  have hL : 0 ≤ divisorConstant ε hε * N ^ ε :=
    mul_nonneg (divisorConstant_pos ε hε).le (Real.rpow_nonneg (zero_le_one.trans hN) _)
  have hb (D : Ideal O) (hD : D ∈ S) :
      ‖commonFactorBlock D (fun i => primaryIdealGenerator (rows i).val) cols a‖ ≤
      highKernelNorm M (N / G) K * (divisorConstant ε hε * N ^ ε) *
        ∑ j, ‖if D ∣ (cols j).val then a j else 0‖ ^ 2 := by
    have hh := highKernel_commonFactorBlock_bound ε hε
      ⟨D, commonFactorPool_admissible cols D (hS hD)⟩ rows cols hr hc M N K hN hrows hcols hK a
    have hm := highKernelNorm_mono (M := M) (M' := M) (K := K) (K' := K) le_rfl
      (div_le_div_of_nonneg_left (zero_le_one.trans hN) hG (hSG D hD)) le_rfl
    exact hh.trans (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hm hL) (by positivity))
  calc
    _ ≤ ∑ D ∈ S, highKernelNorm M (N / G) K * (divisorConstant ε hε * N ^ ε) *
        ∑ j, ‖if D ∣ (cols j).val then a j else 0‖ ^ 2 := Finset.sum_le_sum hb
    _ = highKernelNorm M (N / G) K * (divisorConstant ε hε * N ^ ε) *
        (∑ D ∈ S, ∑ j, ‖if D ∣ (cols j).val then a j else 0‖ ^ 2) := (Finset.mul_sum ..).symm
    _ ≤ highKernelNorm M (N / G) K * (divisorConstant ε hε * N ^ ε) *
        ((divisorConstant ε hε * N ^ ε) * ∑ j, ‖a j‖ ^ 2) :=
      mul_le_mul_of_nonneg_left (divisor_mask_energy_small_power ε hε S
        (fun j => (cols j).val) (fun j => primaryIdealGenerator_ne_zero_ideal _ (cols j).property.1)
        N hcols a) (mul_nonneg (highKernelNorm_nonneg _ _ _) hL)
    _ = _ := by ring

/-- Splitting common conductors separates the Poisson terms from a shorter recursive remainder. -/
theorem highKernel_energy_commonFactor_reduction {m n : Type*} [Fintype m] [Fintype n]
    [DecidableEq m] [DecidableEq n] (ε : ℝ) (hε : 0 < ε)
    (rows : m → QuadraticSupportedIdeal) (cols : n → QuadraticIdeal)
    (hr : Function.Injective rows) (hc : Function.Injective cols)
    (G : ℝ) (hG : 0 < G) (M N K : ℝ) (hN : 1 ≤ N)
    (hrows : ∀ i, (Ideal.absNorm (rows i).val : ℝ) ≤ M)
    (hcols : ∀ j, (Ideal.absNorm (cols j).val : ℝ) ≤ N)
    (hK : ∀ i, K < (Ideal.absNorm (quadraticSquarefreePart (rows i).val) : ℝ)) (a : n → ℂ) :
    (∑ i, ‖∑ j, canonicalQuadraticRow (cols j) (primaryIdealGenerator (rows i).val) * a j‖ ^ 2) ≤
      (∑ D ∈ (commonFactorPool cols).filter (fun D => (Ideal.absNorm D : ℝ) ≤ G),
        ‖commonFactorBlock D (fun i => primaryIdealGenerator (rows i).val) cols a‖) +
      highKernelNorm M (N / G) K * (divisorConstant ε hε * N ^ ε) ^ 2 * ∑ j, ‖a j‖ ^ 2 := by
  have he := energy_le_commonFactorBlocks (fun i => primaryIdealGenerator (rows i).val) cols a
  rw [← Finset.sum_filter_add_sum_filter_not (commonFactorPool cols)
    (fun D => (Ideal.absNorm D : ℝ) ≤ G)] at he
  exact he.trans (add_le_add le_rfl (highKernel_large_commonFactorBlocks ε hε rows cols hr hc _
    (Finset.filter_subset _ _) G hG (fun D hD => (lt_of_not_ge (Finset.mem_filter.mp hD).2).le)
    M N K hN hrows hcols hK a))

end SchwartzPlanePoisson.CanonicalQuadraticSieve

namespace SchwartzPlanePoisson
open Eisenstein

lemma norm_fullIdealWeight_two (I : Ideal O) :
    ‖fullIdealWeight 2 I‖ = 1 / (Ideal.absNorm I : ℝ) ^ 2 := by
  by_cases hI : I = 0
  · subst I
    simp [fullIdealWeight]
  · rw [fullIdealWeight, if_neg hI, Complex.cpow_neg, Complex.cpow_ofNat,
      norm_inv, norm_pow, Complex.norm_natCast, one_div]

/-- Absolute convergence at two uniformly bounds all finite inverse-norm-square sums. -/
lemma finite_inverse_norm_square_bound :
    ∃ C : ℝ, 0 < C ∧ ∀ S : Finset (Ideal O),
      (∑ I ∈ S, 1 / (Ideal.absNorm I : ℝ) ^ 2) ≤ C := by
  let C : ℝ := 1 + ∑' I : Ideal O, ‖fullIdealWeight 2 I‖
  have hc : 0 ≤ ∑' I : Ideal O, ‖fullIdealWeight 2 I‖ := tsum_nonneg (fun _ => norm_nonneg _)
  refine ⟨C, by dsimp [C]; positivity, ?_⟩
  intro S
  have hs := fullIdealWeight_summable_norm (2 : ℂ) (by norm_num)
  calc
    _ = ∑ I ∈ S, ‖fullIdealWeight 2 I‖ := Finset.sum_congr rfl (fun I _ => (norm_fullIdealWeight_two I).symm)
    _ ≤ ∑' I : Ideal O, ‖fullIdealWeight 2 I‖ := hs.sum_le_tsum S (fun _ _ => norm_nonneg _)
    _ ≤ C := by dsimp [C]; linarith

end SchwartzPlanePoisson

namespace SchwartzPlanePoisson.CanonicalQuadraticSieve
open Eisenstein

/-- Square factors occurring among rows above the squarefree-part threshold. -/
def highSquareParts (M K : ℝ) : Finset (Ideal O) :=
  (Finset.univ.filter (fun I : QuadraticSupportedRange M =>
    K < (Ideal.absNorm (quadraticSquarefreePart I.val.val) : ℝ))).image
      (fun I => quadraticSquarePart I.val.val)

lemma mem_highSquareParts {M K : ℝ} (I : QuadraticSupportedRange M)
    (hI : K < (Ideal.absNorm (quadraticSquarefreePart I.val.val) : ℝ)) :
    quadraticSquarePart I.val.val ∈ highSquareParts M K :=
  Finset.mem_image.mpr ⟨I, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hI⟩, rfl⟩

/-- A high squarefree factor forces its complementary square factor below the reciprocal scale. -/
lemma highSquareParts_bounds (M K : ℝ) (hK : 0 < K) (B : Ideal O)
    (hB : B ∈ highSquareParts M K) :
    quadraticSupported B ∧ (1 : ℝ) ≤ Ideal.absNorm B ∧
      (Ideal.absNorm B : ℝ) ≤ Real.sqrt (M / K) ∧
      1 ≤ M / (Ideal.absNorm B : ℝ) ^ 2 := by
  obtain ⟨I, hI, rfl⟩ := Finset.mem_image.mp hB
  have hiK := (Finset.mem_filter.mp hI).2
  have hI0 := primaryIdealGenerator_ne_zero_ideal I.val.val I.val.property.1
  have hp := (quadraticSupported_parts I.val.val hI0).mp I.val.property
  have hA0 := primaryIdealGenerator_ne_zero_ideal _ hp.1.1
  have hB0 := primaryIdealGenerator_ne_zero_ideal _ hp.2.1
  have hA : (1 : ℝ) ≤ Ideal.absNorm (quadraticSquarefreePart I.val.val) := by
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr (Ideal.absNorm_eq_zero_iff.not.mpr hA0)
  have hB : (1 : ℝ) ≤ Ideal.absNorm (quadraticSquarePart I.val.val) := by
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr (Ideal.absNorm_eq_zero_iff.not.mpr hB0)
  have hn := congrArg (fun J : Ideal O => (Ideal.absNorm J : ℝ))
    (quadraticParts_mul_square I.val.val hI0)
  simp only [map_mul, map_pow, Nat.cast_mul, Nat.cast_pow] at hn
  have hM0 : 0 ≤ M := (Nat.cast_nonneg _).trans I.property
  have hBsq : 0 < (Ideal.absNorm (quadraticSquarePart I.val.val) : ℝ) ^ 2 := by positivity
  refine ⟨hp.2, hB, ?_, ?_⟩
  · apply (sq_le_sq₀ (Nat.cast_nonneg _) (Real.sqrt_nonneg _)).mp
    rw [Real.sq_sqrt (div_nonneg hM0 hK.le)]
    apply (le_div_iff₀ hK).mpr
    have hmul := mul_le_mul_of_nonneg_right hiK.le hBsq.le
    nlinarith only [hmul, hn, I.property]
  · apply (le_div_iff₀ hBsq).mpr
    have hmul := mul_le_mul_of_nonneg_right hA hBsq.le
    nlinarith only [hmul, hn, I.property]

end SchwartzPlanePoisson.CanonicalQuadraticSieve

namespace SchwartzPlanePoisson.CanonicalQuadraticSieve
open Eisenstein

/-- Squarefree-square decomposition reduces the high kernel to ordinary quadratic sieve norms. -/
theorem highKernelNorm_le_squarePart_sum (M N K : ℝ) :
    highKernelNorm M N K ≤
      ∑ B ∈ highSquareParts M K, sieveNorm (M / (Ideal.absNorm B : ℝ) ^ 2) N := by
  classical
  apply FiniteSieveOperator.squared_norm_le_of_energy _ _
    (Finset.sum_nonneg (fun _ _ => sieveNorm_nonneg _ _))
  intro a
  let R (B : Ideal O) : Finset (QuadraticSupportedRange M) := Finset.univ.filter
    (fun I => K < (Ideal.absNorm (quadraticSquarefreePart I.val.val) : ℝ) ∧
      quadraticSquarePart I.val.val = B)
  let E (I : QuadraticSupportedRange M) : ℝ := ‖∑ J, highMatrix M N K I J * a J‖ ^ 2
  have hR (B : Ideal O) (I : R B) :
      K < (Ideal.absNorm (quadraticSquarefreePart I.val.val.val) : ℝ) ∧
      quadraticSquarePart I.val.val.val = B := (Finset.mem_filter.mp I.property).2
  have hpartition (I : QuadraticSupportedRange M) :
      E I = ∑ B ∈ highSquareParts M K, if I ∈ R B then E I else 0 := by
    by_cases hI : K < (Ideal.absNorm (quadraticSquarefreePart I.val.val) : ℝ)
    · rw [Finset.sum_eq_single (quadraticSquarePart I.val.val)]
      · rw [if_pos (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hI, rfl⟩)]
      · intro B _ hB
        exact if_neg (fun h => hB ((Finset.mem_filter.mp h).2.2).symm)
      · exact fun h => (h (mem_highSquareParts I hI)).elim
    · have hz : E I = 0 := by simp only [E, highMatrix, if_neg hI, zero_mul,
          Finset.sum_const_zero, norm_zero, zero_pow (by decide : 2 ≠ 0)]
      simp only [hz, ite_self, Finset.sum_const_zero]
  have hsum : (∑ I, E I) = ∑ B ∈ highSquareParts M K, ∑ I ∈ R B, E I := by
    calc
      _ = ∑ I, ∑ B ∈ highSquareParts M K, if I ∈ R B then E I else 0 :=
        Finset.sum_congr rfl (fun I _ => hpartition I)
      _ = ∑ B ∈ highSquareParts M K, ∑ I, if I ∈ R B then E I else 0 := Finset.sum_comm
      _ = _ := by
        apply Finset.sum_congr rfl
        intro B _
        simp only [R, Finset.mem_filter, Finset.mem_univ, true_and, Finset.sum_filter]
  have hblock (B : Ideal O) (_hB : B ∈ highSquareParts M K) :
      (∑ I ∈ R B, E I) ≤ sieveNorm (M / (Ideal.absNorm B : ℝ) ^ 2) N * ∑ J, ‖a J‖ ^ 2 := by
    let r : R B → QuadraticIdeal := fun I => ⟨quadraticSquarefreePart I.val.val.val,
      ((quadraticSupported_parts I.val.val.val
        (primaryIdealGenerator_ne_zero_ideal _ I.val.val.property.1)).mp I.val.val.property).1⟩
    have hr : Function.Injective r := by
      intro I J he
      have hf := congrArg (fun A : QuadraticIdeal => A.val) he
      apply Subtype.ext
      apply Subtype.ext
      apply Subtype.ext
      rw [← quadraticParts_mul_square I.val.val.val
        (primaryIdealGenerator_ne_zero_ideal _ I.val.val.property.1),
        ← quadraticParts_mul_square J.val.val.val
        (primaryIdealGenerator_ne_zero_ideal _ J.val.val.property.1),
        (hR B I).2, (hR B J).2]
      exact congrArg (fun A : Ideal O => A * B ^ 2) hf
    have hrn (I : R B) : (Ideal.absNorm (r I).val : ℝ) ≤ M / (Ideal.absNorm B : ℝ) ^ 2 := by
      have hI0 := primaryIdealGenerator_ne_zero_ideal _ I.val.val.property.1
      have hp := (quadraticSupported_parts I.val.val.val hI0).mp I.val.val.property
      have hB0 : B ≠ 0 := (hR B I).2 ▸ primaryIdealGenerator_ne_zero_ideal _ hp.2.1
      have hb : 0 < (Ideal.absNorm B : ℝ) := by
        exact_mod_cast Nat.pos_of_ne_zero (Ideal.absNorm_eq_zero_iff.not.mpr hB0)
      apply (le_div_iff₀ (sq_pos_of_pos hb)).mpr
      have hn := congrArg (fun A : Ideal O => (Ideal.absNorm A : ℝ))
        (quadraticParts_mul_square I.val.val.val hI0)
      simp only [map_mul, map_pow, Nat.cast_mul, Nat.cast_pow, (hR B I).2] at hn
      exact hn.trans_le I.val.property
    let b : QuadraticIdealRange N → ℂ := fun J => a J * quadraticIdealMask J.val (primaryIdealGenerator B)
    have hb (J : QuadraticIdealRange N) : ‖b J‖ ≤ ‖a J‖ := by
      have hm := canonicalQuadraticRow_norm_le_one J.val ((primaryIdealGenerator B) ^ 2)
      rw [canonicalQuadraticRow_square] at hm
      exact (norm_mul _ _).le.trans (mul_le_of_le_one_right (norm_nonneg _) hm)
    have he (I : R B) : (∑ J, highMatrix M N K I.val J * a J) =
        ∑ J, canonicalQuadraticRow J.val (primaryIdealGenerator (r I).val) * b J := by
      apply Finset.sum_congr rfl
      intro J _
      rw [highMatrix, if_pos (hR B I).1,
        ← quadraticParts_mul_square I.val.val.val
          (primaryIdealGenerator_ne_zero_ideal _ I.val.val.property.1), (hR B I).2,
        canonicalQuadraticRow_squarefree_argument]
      change (canonicalQuadraticRow J.val (primaryIdealGenerator (r I).val) *
        quadraticIdealMask J.val (primaryIdealGenerator B)) * a J = _
      dsimp only [b]
      ring
    have hop := family_squared_norm_le r (fun J : QuadraticIdealRange N => J.val)
      hr Subtype.val_injective (M / (Ideal.absNorm B : ℝ) ^ 2) N hrn (fun J => J.property)
    have hen := FiniteSieveOperator.energy_bound
      (fun I J => canonicalQuadraticRow J.val (primaryIdealGenerator (r I).val)) b
    rw [← Finset.sum_coe_sort (s := R B) (f := E)]
    change (∑ I : R B, ‖∑ J, highMatrix M N K I.val J * a J‖ ^ 2) ≤ _
    simp_rw [he]
    exact hen.trans ((mul_le_mul_of_nonneg_right hop (by positivity)).trans
      (mul_le_mul_of_nonneg_left (Finset.sum_le_sum (fun J _ =>
        pow_le_pow_left₀ (norm_nonneg _) (hb J) 2)) (sieveNorm_nonneg _ _)))
  change (∑ I, E I) ≤ _
  rw [hsum, Finset.sum_mul]
  exact Finset.sum_le_sum hblock

end SchwartzPlanePoisson.CanonicalQuadraticSieve

namespace SchwartzPlanePoisson.CanonicalQuadraticSieve
open Eisenstein

lemma highSquareParts_card_bound (M K : ℝ) (hK : 0 < K) :
    ((highSquareParts M K).card : ℝ) ≤ diagonalControl sieveCutoff * Real.sqrt (M / K) := by
  have hD := diagonalControl_nonneg sieveCutoff
  by_cases he : highSquareParts M K = ∅
  · simp only [he, Finset.card_empty, Nat.cast_zero]
    positivity
  · obtain ⟨B, hB⟩ := Finset.nonempty_iff_ne_empty.mpr he
    have hb := highSquareParts_bounds M K hK B hB
    exact finite_ideal_card_bound _ _ (hb.2.1.trans hb.2.2.1)
      (fun A hA => (highSquareParts_bounds M K hK A hA).2.2.1)

/-- A sieve power bound controls the full high kernel with only the square-factor counting cost. -/
theorem HasSieveExponent.high_kernel {α : ℝ} (h : HasSieveExponent α) :
    ∀ ε : ℝ, 0 < ε → ∃ C : ℝ, 0 < C ∧ ∀ M N K : ℝ,
      1 ≤ M → 1 ≤ N → 1 ≤ K →
      highKernelNorm M N K ≤ C * (M * N) ^ ε * (M + Real.sqrt (M / K) * N ^ α) := by
  intro ε hε
  obtain ⟨C, hC, hbound⟩ := h ε hε
  obtain ⟨A, hA, hsum⟩ := finite_inverse_norm_square_bound
  let D := diagonalControl sieveCutoff
  have hD : 0 ≤ D := diagonalControl_nonneg sieveCutoff
  refine ⟨(A + D + 1) * C, by positivity, ?_⟩
  intro M N K hM hN hK
  have hM0 := zero_le_one.trans hM
  have hN0 := zero_le_one.trans hN
  have hK0 := zero_lt_one.trans_le hK
  have hrow (B : Ideal O) (hB : B ∈ highSquareParts M K) :
      sieveNorm (M / (Ideal.absNorm B : ℝ) ^ 2) N ≤
        C * (M * N) ^ ε * (M / (Ideal.absNorm B : ℝ) ^ 2 + N ^ α) := by
    have hb := highSquareParts_bounds M K hK0 B hB
    have hquot : M / (Ideal.absNorm B : ℝ) ^ 2 ≤ M := div_le_self hM0 (one_le_pow₀ hb.2.1)
    apply (hbound _ N hb.2.2.2 hN).trans
    have hpow := Real.rpow_le_rpow
      (mul_nonneg (div_nonneg hM0 (sq_nonneg _)) hN0)
      (mul_le_mul_of_nonneg_right hquot hN0) hε.le
    exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hpow hC.le)
      (add_nonneg (div_nonneg hM0 (sq_nonneg _)) (Real.rpow_nonneg hN0 _))
  have hcard := highSquareParts_card_bound M K hK0
  have hcoeff : 0 ≤ C * (M * N) ^ ε := by positivity
  have hr : 0 ≤ Real.sqrt (M / K) * N ^ α :=
    mul_nonneg (Real.sqrt_nonneg _) (Real.rpow_nonneg hN0 _)
  calc
    _ ≤ ∑ B ∈ highSquareParts M K, sieveNorm (M / (Ideal.absNorm B : ℝ) ^ 2) N :=
      highKernelNorm_le_squarePart_sum M N K
    _ ≤ ∑ B ∈ highSquareParts M K,
        C * (M * N) ^ ε * (M / (Ideal.absNorm B : ℝ) ^ 2 + N ^ α) := Finset.sum_le_sum hrow
    _ = C * (M * N) ^ ε *
        (M * (∑ B ∈ highSquareParts M K, 1 / (Ideal.absNorm B : ℝ) ^ 2) +
          ((highSquareParts M K).card : ℝ) * N ^ α) := by
      simp only [← Finset.mul_sum, Finset.sum_add_distrib, Finset.sum_const, nsmul_eq_mul]
      congr 1
      rw [Finset.mul_sum]
      congr 1
      exact Finset.sum_congr rfl (fun _ _ => by ring)
    _ ≤ C * (M * N) ^ ε * (M * A + (D * Real.sqrt (M / K)) * N ^ α) := by
      gcongr
      exact hsum _
    _ ≤ C * (M * N) ^ ε * ((A + D + 1) * (M + Real.sqrt (M / K) * N ^ α)) := by
      apply mul_le_mul_of_nonneg_left _ hcoeff
      calc
        M * A + (D * Real.sqrt (M / K)) * N ^ α = A * M + D * (Real.sqrt (M / K) * N ^ α) := by ring
        _ ≤ (A + D + 1) * M + (A + D + 1) * (Real.sqrt (M / K) * N ^ α) :=
          add_le_add (mul_le_mul_of_nonneg_right (by linarith) hM0)
            (mul_le_mul_of_nonneg_right (by linarith) hr)
        _ = _ := by ring
    _ = ((A + D + 1) * C) * (M * N) ^ ε * (M + Real.sqrt (M / K) * N ^ α) := by ring

end SchwartzPlanePoisson.CanonicalQuadraticSieve

namespace FiniteSieveRestriction

/-- Restrict coefficients to one finite ray or size class. -/
def sectorCoefficient {n r : Type*} [DecidableEq r] (σ : n → r) (c : r) (a : n → ℂ) (j : n) : ℂ :=
  if σ j = c then a j else 0

lemma sectorCoefficient_energy {n r : Type*} [Fintype n] [Fintype r] [DecidableEq r]
    (σ : n → r) (a : n → ℂ) :
    (∑ c, ∑ j, ‖sectorCoefficient σ c a j‖ ^ 2) = ∑ j, ‖a j‖ ^ 2 := by
  classical
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro j _
  rw [Finset.sum_eq_single (σ j)]
  · simp [sectorCoefficient]
  · intro c _ hc
    simp only [sectorCoefficient, if_neg (Ne.symm hc), norm_zero, zero_pow (by decide : 2 ≠ 0)]
  · simp

lemma matrix_sector_decomposition {m n r : Type*} [Fintype n] [Fintype r] [DecidableEq r]
    (σ : n → r) (A : Matrix m n ℂ) (a : n → ℂ) (i : m) :
    (∑ j, A i j * a j) = ∑ c, ∑ j, A i j * sectorCoefficient σ c a j := by
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro j _
  rw [← Finset.mul_sum]
  simp [sectorCoefficient]

/-- Splitting columns into finitely many sectors costs only the number of sectors. -/
lemma weighted_energy_sector_bound {m n r : Type*} [Fintype m] [Fintype n] [Fintype r]
    [DecidableEq r] (σ : n → r) (A : Matrix m n ℂ) (a : n → ℂ)
    (v : m → ℝ) (hv : ∀ i, 0 ≤ v i) :
    (∑ i, v i * ‖∑ j, A i j * a j‖ ^ 2) ≤
      (Fintype.card r : ℝ) * ∑ c, ∑ i, v i * ‖∑ j, A i j * sectorCoefficient σ c a j‖ ^ 2 := by
  have hb (i : m) : ‖∑ j, A i j * a j‖ ^ 2 ≤
      (Fintype.card r : ℝ) * ∑ c, ‖∑ j, A i j * sectorCoefficient σ c a j‖ ^ 2 := by
    rw [matrix_sector_decomposition σ A a i]
    have hn := norm_sum_le (Finset.univ : Finset r) (fun c => ∑ j, A i j * sectorCoefficient σ c a j)
    have hcs := Finset.sum_mul_sq_le_sq_mul_sq (Finset.univ : Finset r)
      (fun _ => (1 : ℝ)) (fun c => ‖∑ j, A i j * sectorCoefficient σ c a j‖)
    simp only [one_mul, one_pow, Finset.sum_const, nsmul_eq_mul, mul_one, Finset.card_univ] at hcs
    exact (pow_le_pow_left₀ (norm_nonneg _) hn 2).trans hcs
  calc
    _ ≤ ∑ i, v i * ((Fintype.card r : ℝ) * ∑ c, ‖∑ j, A i j * sectorCoefficient σ c a j‖ ^ 2) :=
      Finset.sum_le_sum (fun i _ => mul_le_mul_of_nonneg_left (hb i) (hv i))
    _ = _ := by
      simp only [Finset.mul_sum]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro c _
      exact Finset.sum_congr rfl (fun i _ => by ring)

end FiniteSieveRestriction



namespace SchwartzPlanePoisson
open Eisenstein QuadraticPhase.Eisenstein

lemma principalTraceChar_star (c : O) (hc : c ≠ 0) (x : O ⧸ Ideal.span {c}) :
    star (principalTraceChar c hc x) = principalTraceChar c hc (-x) := by
  obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [← map_neg, principalTraceChar_apply, principalTraceChar_apply,
    Complex.star_def, ← Complex.exp_conj]
  congr 1
  simp only [map_neg, neg_div, Rat.cast_neg, map_mul, map_ofNat, map_ratCast,
    Complex.conj_ofReal, Complex.conj_I]
  ring

lemma quadraticTraceGauss_star (c : O) (hc : c ≠ 0) :
    star (quadraticTraceGauss c hc) = quadraticTraceTwist c hc (-1) := by
  letI : Finite (O ⧸ Ideal.span {c}) := finite_quotient_span hc
  letI : Fintype (O ⧸ Ideal.span {c}) := Fintype.ofFinite _
  change star (∑ x : O ⧸ Ideal.span {c}, principalTraceChar c hc (x ^ 2)) =
    ∑ x : O ⧸ Ideal.span {c}, principalTraceChar c hc (Ideal.Quotient.mk _ (-1) * x ^ 2)
  simp only [star_sum, principalTraceChar_star, map_neg, map_one, neg_one_mul]

/-- The value at minus one is determined by the fixed quadratic Gauss phase. -/
lemma prime_quadratic_neg_one_phase {ι : Type*} [Fintype ι] [DecidableEq ι]
    (p : ι → O) (hp : ∀ i, p i ≠ 0) [∀ i, (Ideal.span {p i}).IsMaximal]
    (hinj : Function.Injective (fun i => Ideal.span {p i}))
    (hodd : ∀ i, ringChar (O ⧸ Ideal.span {p i}) ≠ 2) :
    primeCuspRowCharacter p (fun i => complexQuadraticChar (Ideal.span {p i})) (-1) *
      fixedDualAverage (∏ i, p i) = star (fixedDualAverage (∏ i, p i)) := by
  let c := ∏ i, p i
  have hc : c ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun i _ => hp i)
  have hn : (‖ringComplex c‖ : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (norm_ne_zero_iff.mpr (ringComplex_ne_zero hc))
  have hG : quadraticTraceGauss c hc = (‖ringComplex c‖ : ℂ) * fixedDualAverage c := by
    have h := normalizedQuadraticTraceGauss_eq_fixedDualAverage c hc
    exact ((div_eq_iff hn).mp h).trans (mul_comm _ _)
  have ht := prime_quadratic_trace_twist p hp hinj hodd (-1)
    (show IsCoprime (∏ i, p i) (-1) from ⟨0, -1, by ring⟩)
  change quadraticTraceTwist c hc (-1) = _ at ht
  rw [← quadraticTraceGauss_star, hG] at ht
  simp only [star_mul, Complex.star_def, Complex.conj_ofReal] at ht
  change _ = _ * ((‖ringComplex c‖ : ℂ) * fixedDualAverage c) at ht
  apply mul_right_cancel₀ hn
  calc
    _ = primeCuspRowCharacter p (fun i => complexQuadraticChar (Ideal.span {p i})) (-1) *
        ((‖ringComplex c‖ : ℂ) * fixedDualAverage c) := by ring
    _ = star (fixedDualAverage c) * (‖ringComplex c‖ : ℂ) := by
      simpa only [Complex.star_def] using ht.symm

lemma canonicalQuadraticRow_phase_norm (I : QuadraticIdeal) :
    ‖fixedDualAverage (primaryIdealGenerator I.val)‖ = 1 := by
  have h := prime_quadratic_phase_norm (fun P : quadraticIdealSupport I => quadraticPrimeGenerator P.val)
    (fun P => quadraticPrimeGenerator_ne_zero P.val)
    (quadraticPrimeGenerator_span_injective.comp Subtype.val_injective)
    (fun P => quadraticPrimeGenerator_odd P.val)
  simpa only [Finset.prod_coe_sort, quadraticIdealSupport_product] using h

lemma canonicalQuadraticRow_neg_one_phase (I : QuadraticIdeal) :
    canonicalQuadraticRow I (-1) * fixedDualAverage (primaryIdealGenerator I.val) =
      star (fixedDualAverage (primaryIdealGenerator I.val)) := by
  have h := prime_quadratic_neg_one_phase (fun P : quadraticIdealSupport I => quadraticPrimeGenerator P.val)
    (fun P => quadraticPrimeGenerator_ne_zero P.val)
    (quadraticPrimeGenerator_span_injective.comp Subtype.val_injective)
    (fun P => quadraticPrimeGenerator_odd P.val)
  have hrow : primeCuspRowCharacter
      (fun P : quadraticIdealSupport I => quadraticPrimeGenerator P.val)
      (fun P => complexQuadraticChar (Ideal.span {quadraticPrimeGenerator P.val})) (-1) =
      canonicalQuadraticRow I (-1) := by
    change (∏ P : quadraticIdealSupport I,
      complexQuadraticChar (Ideal.span {quadraticPrimeGenerator P.val})
        (Ideal.Quotient.mk _ (-1))) = _
    exact Finset.prod_coe_sort (s := quadraticIdealSupport I)
      (f := fun P => complexQuadraticChar (Ideal.span {quadraticPrimeGenerator P}) (Ideal.Quotient.mk _ (-1)))
  rw [hrow] at h
  simpa only [Finset.prod_coe_sort, quadraticIdealSupport_product] using h

/-- The conductor class modulo four is the finite ray parameter for quadratic pairs. -/
def quadraticColumnRay (I : QuadraticIdeal) : QuadraticRayRing :=
  Ideal.Quotient.mk (Ideal.span {(4 : O)}) (primaryIdealGenerator I.val)

lemma canonicalQuadraticRow_neg_one_eq_of_same_ray (I J : QuadraticIdeal)
    (h : quadraticColumnRay I = quadraticColumnRay J) :
    canonicalQuadraticRow I (-1) = canonicalQuadraticRow J (-1) := by
  have he := fixedDualAverage_eq_of_mod_four (primaryIdealGenerator I.val) (primaryIdealGenerator J.val) h
  have hI := canonicalQuadraticRow_neg_one_phase I
  rw [he] at hI
  have hn : fixedDualAverage (primaryIdealGenerator J.val) ≠ 0 := by
    intro hz
    have hh := canonicalQuadraticRow_phase_norm J
    rw [hz, norm_zero] at hh
    exact zero_ne_one hh
  exact mul_right_cancel₀ hn (hI.trans (canonicalQuadraticRow_neg_one_phase J).symm)

lemma canonicalQuadraticRow_unit_sq (I : QuadraticIdeal) (u : Oˣ) :
    canonicalQuadraticRow I (u : O) ^ 2 = 1 := by
  apply quadraticSubsetRow_sq
  exact ⟨0, ((u⁻¹ : Oˣ) : O), by simp⟩

@[simp] lemma canonicalQuadraticRow_one (I : QuadraticIdeal) : canonicalQuadraticRow I 1 = 1 := by
  simp only [canonicalQuadraticRow, primeSubsetRow, map_one, Finset.prod_const_one]

lemma canonicalQuadraticRow_unit_cube (I : QuadraticIdeal) (u : Oˣ) :
    canonicalQuadraticRow I ((u : O) ^ 3) = canonicalQuadraticRow I (u : O) := by
  have hs := canonicalQuadraticRow_unit_sq I u
  rw [pow_succ, pow_two,
    canonicalQuadraticRow_mul, canonicalQuadraticRow_mul, ← pow_two, hs, one_mul]

/-- Equal conductor rays have equal values on every Eisenstein unit. -/
lemma canonicalQuadraticRow_unit_eq_of_same_ray (I J : QuadraticIdeal)
    (h : quadraticColumnRay I = quadraticColumnRay J) (u : Oˣ) :
    canonicalQuadraticRow I (u : O) = canonicalQuadraticRow J (u : O) := by
  rw [← canonicalQuadraticRow_unit_cube I u, ← canonicalQuadraticRow_unit_cube J u]
  rcases unit_cube_eq_sign u with hu | hu
  · rw [hu, canonicalQuadraticRow_one, canonicalQuadraticRow_one]
  · rw [hu]
    exact canonicalQuadraticRow_neg_one_eq_of_same_ray I J h

lemma canonicalQuadraticPair_unit_invariant (I J : QuadraticIdeal)
    (h : quadraticColumnRay I = quadraticColumnRay J) (u : Oˣ) (z : O) :
    canonicalQuadraticRow I ((u : O) * z) * canonicalQuadraticRow J ((u : O) * z) =
      canonicalQuadraticRow I z * canonicalQuadraticRow J z := by
  rw [canonicalQuadraticRow_mul, canonicalQuadraticRow_mul,
    canonicalQuadraticRow_unit_eq_of_same_ray I J h]
  calc
    _ = canonicalQuadraticRow J (u : O) ^ 2 * (canonicalQuadraticRow I z * canonicalQuadraticRow J z) := by ring
    _ = _ := by rw [canonicalQuadraticRow_unit_sq, one_mul]

end SchwartzPlanePoisson


namespace SchwartzPlanePoisson
open Eisenstein Eisenstein.Coordinates QuadraticPhase.Eisenstein

/-- Equal odd rays multiply to a ray with trivial quadratic Gauss phase. -/
lemma fixedDualAverage_product_of_same_ray (c d : O)
    (h : Ideal.Quotient.mk (Ideal.span {(4 : O)}) c =
      Ideal.Quotient.mk (Ideal.span {(4 : O)}) d)
    (hc : ‖fixedDualAverage c‖ = 1) : fixedDualAverage (c * d) = 1 := by
  obtain ⟨⟨a, b⟩, hab⟩ := (rationalCoordEquiv 4 (by decide)).surjective
    (Ideal.Quotient.mk (Ideal.span {(4 : O)}) c)
  change Ideal.Quotient.mk (Ideal.span {(4 : O)})
    (eval (ZMod.cast a) (ZMod.cast b)) = Ideal.Quotient.mk (Ideal.span {(4 : O)}) c at hab
  have hp : Ideal.Quotient.mk (Ideal.span {(4 : O)}) (c * d) =
      Ideal.Quotient.mk (Ideal.span {(4 : O)})
        (eval (ZMod.cast a) (ZMod.cast b) * eval (ZMod.cast a) (ZMod.cast b)) := by
    rw [map_mul, map_mul, ← h, hab]
  rw [fixedDualAverage_eq_of_mod_four c _ hab.symm, fixedDualAverage_formula] at hc
  rw [fixedDualAverage_eq_of_mod_four (c * d) _ hp, eval_mul, fixedDualAverage_formula]
  fin_cases a <;> fin_cases b <;>
    norm_num [ZMod.cast, ZMod.val, zpow_neg, zpow_ofNat, Complex.I_sq, Complex.I_pow_three, Complex.inv_I] at * <;>
    ring_nf at * <;> norm_num [zpow_ofNat, neg_pow, Complex.I_pow_eq_pow_mod,
      Complex.I_sq, Complex.I_pow_three, Complex.inv_I] at * <;> ring

lemma quadraticIdealSupport_disjoint_of_coprime (I J : QuadraticIdeal)
    (h : IsCoprime I.val J.val) : Disjoint (quadraticIdealSupport I) (quadraticIdealSupport J) := by
  apply Finset.disjoint_left.mpr
  intro P hP hQ
  have hpI := Multiset.mem_toFinset.mp ((mem_quadraticIdealSupport I P).mp hP)
  have hpJ := Multiset.mem_toFinset.mp ((mem_quadraticIdealSupport J P).mp hQ)
  exact (UniqueFactorizationMonoid.prime_of_normalized_factor P.val hpI).2.1
    (h.isUnit_of_dvd' (UniqueFactorizationMonoid.dvd_of_mem_normalizedFactors hpI)
      (UniqueFactorizationMonoid.dvd_of_mem_normalizedFactors hpJ))

open MeasureTheory
open scoped SchwartzMap

/-- On a fixed conductor ray, Poisson reflection of a coprime pair has phase one. -/
theorem canonical_same_ray_pair_poisson {κ : Type*}
    (I J : QuadraticIdeal) (hcop : IsCoprime I.val J.val)
    (hray : quadraticColumnRay I = quadraticColumnRay J)
    (q : κ → O) (hq : ∀ i, q i ≠ 0)
    (hqc : Pairwise (Function.onFun IsCoprime q)) (S : Finset κ)
    (W : 𝓢(ℝ, ℂ)) (Y : ℝ) (hY : 0 < Y) :
    (∑' z : O, primeCoprimeMask q S z *
      (canonicalQuadraticRow I z * canonicalQuadraticRow J z) * W (‖ringComplex z‖ ^ 2 / Y)) =
      ((Y : ℂ) / (‖ringComplex (primaryIdealGenerator I.val * primaryIdealGenerator J.val)‖ : ℂ)) *
        ∑ E ∈ S.powerset,
          ((-1 : ℂ) ^ E.card *
            (canonicalQuadraticRow I (∏ i ∈ E, q i) * canonicalQuadraticRow J (∏ i ∈ E, q i)) /
              (‖ringComplex (∏ i ∈ E, q i)‖ ^ 2 : ℝ)) *
            ∑' z : O, (canonicalQuadraticRow I z * canonicalQuadraticRow J z) *
              paperRadialFourier W (Y * ‖ringComplex z‖ ^ 2 /
                (‖ringComplex (∏ i ∈ E, q i)‖ ^ 2 *
                  ‖ringComplex (primaryIdealGenerator I.val * primaryIdealGenerator J.val)‖ ^ 2)) := by
  classical
  let U := quadraticIdealSupport I ∪ quadraticIdealSupport J
  have hd := quadraticIdealSupport_disjoint_of_coprime I J hcop
  have hp : (∏ P : U, quadraticPrimeGenerator P.val) =
      primaryIdealGenerator I.val * primaryIdealGenerator J.val := by
    rw [Finset.prod_coe_sort, Finset.prod_union hd,
      quadraticIdealSupport_product, quadraticIdealSupport_product]
  have hphase : fixedDualAverage (primaryIdealGenerator I.val * primaryIdealGenerator J.val) = 1 := by
    exact fixedDualAverage_product_of_same_ray _ _ hray (canonicalQuadraticRow_phase_norm I)
  have hrow (z : O) :
      primeCuspRowCharacter (fun P : U => quadraticPrimeGenerator P.val)
        (fun P => complexQuadraticChar (Ideal.span {quadraticPrimeGenerator P.val})) z =
      canonicalQuadraticRow I z * canonicalQuadraticRow J z := by
    change (∏ P : U, complexQuadraticChar (Ideal.span {quadraticPrimeGenerator P.val})
      (Ideal.Quotient.mk _ z)) = _
    rw [Finset.prod_coe_sort (s := U) (f := fun P : QuadraticPrime =>
      complexQuadraticChar (Ideal.span {quadraticPrimeGenerator P}) (Ideal.Quotient.mk _ z))]
    exact Finset.prod_union hd
  have ht := quadratic_row_masked_radial_poisson
    (fun P : U => quadraticPrimeGenerator P.val) (fun P => quadraticPrimeGenerator_ne_zero P.val)
    (quadraticPrimeGenerator_span_injective.comp Subtype.val_injective)
    (fun P => quadraticPrimeGenerator_odd P.val) q hq hqc S W Y hY
  simpa only [hphase, hp, hrow, mul_one] using ht

end SchwartzPlanePoisson


namespace SchwartzPlanePoisson
open Eisenstein

/-- Every nonzero Eisenstein integer is a unique unit multiple of the chosen ideal generator. -/
def unitIdealElement (p : NonzeroIdeal × Oˣ) : {z : O // z ≠ 0} :=
  ⟨(p.2 : O) * cubicIdealGenerator p.1.val, mul_ne_zero p.2.ne_zero (cubicIdealGenerator_ne_zero _ p.1.property)⟩

lemma unitIdealElement_bijective : Function.Bijective unitIdealElement := by
  constructor
  · rintro ⟨I, u⟩ ⟨J, v⟩ he
    have hv := congrArg (fun z : {z : O // z ≠ 0} => z.val) he
    change (u : O) * cubicIdealGenerator I.val = (v : O) * cubicIdealGenerator J.val at hv
    have hi := congrArg (fun z : O => Ideal.span {z}) hv
    rw [Ideal.span_singleton_mul_left_unit u.isUnit, Ideal.span_singleton_mul_left_unit v.isUnit,
      span_cubicIdealGenerator, span_cubicIdealGenerator] at hi
    have hIJ : I = J := Subtype.ext hi
    subst J
    have huv : u = v := Units.ext (mul_right_cancel₀ (cubicIdealGenerator_ne_zero _ I.property) hv)
    subst v
    rfl
  · intro z
    let I : NonzeroIdeal := ⟨Ideal.span {z.val}, by
      exact Ideal.span_singleton_eq_bot.not.mpr z.property⟩
    have ha : Associated (cubicIdealGenerator I.val) z.val :=
      Ideal.span_singleton_eq_span_singleton.mp (span_cubicIdealGenerator I.val)
    obtain ⟨u, hu⟩ := ha
    refine ⟨(I, u), Subtype.ext ?_⟩
    simpa only [unitIdealElement, mul_comm] using hu

def unitIdealElementEquiv : NonzeroIdeal × Oˣ ≃ {z : O // z ≠ 0} :=
  Equiv.ofBijective unitIdealElement unitIdealElement_bijective

/-- Unit-invariant lattice sums are ideal sums with the exact unit multiplicity. -/
theorem tsum_unit_invariant_ideals (f : O → ℂ) (hf : Summable f) (h0 : f 0 = 0)
    (hu : ∀ (u : Oˣ) (z : O), f ((u : O) * z) = f z) :
    (∑' z : O, f z) = (Nat.card Oˣ : ℂ) * ∑' I : NonzeroIdeal, f (cubicIdealGenerator I.val) := by
  letI : Finite Oˣ := cubic_units_finite
  letI : Fintype Oˣ := Fintype.ofFinite _
  have hs := (hf.subtype (fun z => z ≠ 0)).comp_injective unitIdealElementEquiv.injective
  change Summable (fun p : NonzeroIdeal × Oˣ => f ((p.2 : O) * cubicIdealGenerator p.1.val)) at hs
  calc
    _ = ∑' z : {z : O // z ≠ 0}, f z.val := by
      symm
      apply tsum_subtype_eq_of_support_subset
      intro z hz he
      subst z
      exact hz h0
    _ = ∑' p : NonzeroIdeal × Oˣ, f ((p.2 : O) * cubicIdealGenerator p.1.val) :=
      (unitIdealElementEquiv.tsum_eq (fun z => f z.val)).symm
    _ = ∑' I : NonzeroIdeal, ∑' u : Oˣ, f ((u : O) * cubicIdealGenerator I.val) := hs.tsum_prod
    _ = ∑' I : NonzeroIdeal, (Nat.card Oˣ : ℂ) * f (cubicIdealGenerator I.val) := by
      apply tsum_congr
      intro I
      simp only [hu, tsum_fintype, Finset.sum_const, Finset.card_univ, nsmul_eq_mul,
        Nat.card_eq_fintype_card]
    _ = _ := tsum_mul_left

/-- A same-ray quadratic pair descends to all ideals, independently of generator choice. -/
def canonicalQuadraticPairIdeal (I J : QuadraticIdeal) (D : Ideal O) : ℂ :=
  canonicalQuadraticRow I (cubicIdealGenerator D) * canonicalQuadraticRow J (cubicIdealGenerator D)

lemma canonicalQuadraticPairIdeal_span (I J : QuadraticIdeal)
    (hray : quadraticColumnRay I = quadraticColumnRay J) (z : O) :
    canonicalQuadraticPairIdeal I J (Ideal.span {z}) = canonicalQuadraticRow I z * canonicalQuadraticRow J z := by
  have ha : Associated (cubicIdealGenerator (Ideal.span {z})) z :=
    Ideal.span_singleton_eq_span_singleton.mp (span_cubicIdealGenerator _)
  obtain ⟨u, hu⟩ := ha
  have hv := canonicalQuadraticPair_unit_invariant I J hray u (cubicIdealGenerator (Ideal.span {z}))
  have he : (u : O) * cubicIdealGenerator (Ideal.span {z}) = z := by simpa only [mul_comm] using hu
  rw [he] at hv
  exact hv.symm

lemma canonicalQuadraticPairIdeal_mul (I J : QuadraticIdeal)
    (hray : quadraticColumnRay I = quadraticColumnRay J) (A B : Ideal O) :
    canonicalQuadraticPairIdeal I J (A * B) =
      canonicalQuadraticPairIdeal I J A * canonicalQuadraticPairIdeal I J B := by
  have hs : Ideal.span {cubicIdealGenerator A * cubicIdealGenerator B} = A * B := by
    rw [← Ideal.span_singleton_mul_span_singleton, span_cubicIdealGenerator, span_cubicIdealGenerator]
  rw [← hs, canonicalQuadraticPairIdeal_span I J hray, canonicalQuadraticRow_mul, canonicalQuadraticRow_mul]
  unfold canonicalQuadraticPairIdeal
  ring

lemma canonicalQuadraticPairIdeal_primary (I J : QuadraticIdeal)
    (hray : quadraticColumnRay I = quadraticColumnRay J) (D : Ideal O) (hD : primaryIdealGenerator D ≠ 0) :
    canonicalQuadraticPairIdeal I J D =
      canonicalQuadraticRow I (primaryIdealGenerator D) * canonicalQuadraticRow J (primaryIdealGenerator D) := by
  have h := canonicalQuadraticPairIdeal_span I J hray (primaryIdealGenerator D)
  rw [(primaryIdealGenerator_spec D hD).1] at h
  exact h

lemma canonicalQuadraticPairIdeal_norm_le_one (I J : QuadraticIdeal) (D : Ideal O) :
    ‖canonicalQuadraticPairIdeal I J D‖ ≤ 1 := by
  rw [canonicalQuadraticPairIdeal, norm_mul]
  exact (mul_le_mul (canonicalQuadraticRow_norm_le_one I _)
    (canonicalQuadraticRow_norm_le_one J _) (norm_nonneg _) zero_le_one).trans_eq (one_mul 1)

end SchwartzPlanePoisson


namespace SchwartzPlanePoisson
open Eisenstein MeasureTheory
open scoped SchwartzMap

lemma canonicalQuadraticRow_zero_of_ne_one (I : QuadraticIdeal) (hI : I.val ≠ 1) :
    canonicalQuadraticRow I 0 = 0 := by
  classical
  have hs : (quadraticIdealSupport I).Nonempty := by
    by_contra h
    have he := quadraticIdealSupport_product I
    rw [Finset.not_nonempty_iff_eq_empty.mp h, Finset.prod_empty] at he
    have hi := (primaryIdealGenerator_spec I.val I.property.1).1
    rw [← he, Ideal.span_singleton_one] at hi
    exact hI (by simpa only [Ideal.one_eq_top] using hi.symm)
  unfold canonicalQuadraticRow primeSubsetRow
  apply Finset.prod_eq_zero hs.choose_spec
  simp only [map_zero, MulChar.map_zero]

lemma canonicalQuadraticPair_zero (I J : QuadraticIdeal) (h : I.val ≠ 1 ∨ J.val ≠ 1) :
    canonicalQuadraticRow I 0 * canonicalQuadraticRow J 0 = 0 := by
  rcases h with h | h
  · rw [canonicalQuadraticRow_zero_of_ne_one I h, zero_mul]
  · rw [canonicalQuadraticRow_zero_of_ne_one J h, mul_zero]

lemma canonicalQuadraticPair_fourier_summable (I J : QuadraticIdeal)
    (W : 𝓢(ℝ, ℂ)) (t : ℝ) (ht : 0 < t) :
    Summable (fun z : O => (canonicalQuadraticRow I z * canonicalQuadraticRow J z) *
      paperRadialFourier W (t * ‖ringComplex z‖ ^ 2)) := by
  apply Summable.of_norm
  apply Summable.of_nonneg_of_le (fun _ => norm_nonneg _)
    (fun z => ?_) (paperRadialFourier_lattice_summable_norm W t ht)
  rw [norm_mul, norm_mul]
  have hrow : ‖canonicalQuadraticRow I z‖ * ‖canonicalQuadraticRow J z‖ ≤ 1 :=
    (mul_le_mul (canonicalQuadraticRow_norm_le_one I z)
      (canonicalQuadraticRow_norm_le_one J z) (norm_nonneg _) zero_le_one).trans_eq (one_mul 1)
  exact mul_le_of_le_one_left (norm_nonneg _) hrow

/-- Removing the zero frequency and unit orbit gives the exact unrestricted dual ideal sum. -/
theorem canonicalQuadraticPair_fourier_ideal_reindex (I J : QuadraticIdeal)
    (hray : quadraticColumnRay I = quadraticColumnRay J) (hnt : I.val ≠ 1 ∨ J.val ≠ 1)
    (W : 𝓢(ℝ, ℂ)) (t : ℝ) (ht : 0 < t) :
    (∑' z : O, (canonicalQuadraticRow I z * canonicalQuadraticRow J z) *
      paperRadialFourier W (t * ‖ringComplex z‖ ^ 2)) =
      (Nat.card Oˣ : ℂ) * ∑' D : NonzeroIdeal, canonicalQuadraticPairIdeal I J D.val *
        paperRadialFourier W (t * (Ideal.absNorm D.val : ℝ)) := by
  let f : O → ℂ := fun z => (canonicalQuadraticRow I z * canonicalQuadraticRow J z) *
    paperRadialFourier W (t * ‖ringComplex z‖ ^ 2)
  have h0 : f 0 = 0 := by
    dsimp only [f]
    rw [canonicalQuadraticPair_zero I J hnt, zero_mul]
  have hu (u : Oˣ) (z : O) : f ((u : O) * z) = f z := by
    dsimp only [f]
    rw [canonicalQuadraticPair_unit_invariant I J hray, map_mul, norm_mul,
      norm_ringComplex_unit, one_mul]
  have he := tsum_unit_invariant_ideals f (canonicalQuadraticPair_fourier_summable I J W t ht) h0 hu
  simpa only [f, ringComplex_norm_sq_eq_absNorm_span, span_cubicIdealGenerator,
    canonicalQuadraticPairIdeal] using he

end SchwartzPlanePoisson


namespace SchwartzPlanePoisson
open Eisenstein UniqueFactorizationMonoid

lemma canonicalQuadraticPairIdeal_one (I J : QuadraticIdeal)
    (hray : quadraticColumnRay I = quadraticColumnRay J) :
    canonicalQuadraticPairIdeal I J 1 = 1 := by
  have h := canonicalQuadraticPairIdeal_span I J hray 1
  simpa only [Ideal.span_singleton_one, canonicalQuadraticRow_one, one_mul,
    Ideal.one_eq_top] using h

/-- Normalizing by the square root of the ideal norm preserves multiplicativity. -/
def normalizedQuadraticPair (I J : QuadraticIdeal) (D : Ideal O) : ℂ :=
  canonicalQuadraticPairIdeal I J D / (Real.sqrt (Ideal.absNorm D : ℝ) : ℂ)

lemma normalizedQuadraticPair_mul (I J : QuadraticIdeal)
    (hray : quadraticColumnRay I = quadraticColumnRay J) (A B : Ideal O) :
    normalizedQuadraticPair I J (A * B) =
      normalizedQuadraticPair I J A * normalizedQuadraticPair I J B := by
  simp only [normalizedQuadraticPair, canonicalQuadraticPairIdeal_mul I J hray,
    map_mul, Nat.cast_mul, Real.sqrt_mul (Nat.cast_nonneg _), Complex.ofReal_mul,
    div_mul_div_comm]

def normalizedQuadraticPairHom (I J : QuadraticIdeal)
    (hray : quadraticColumnRay I = quadraticColumnRay J) : Ideal O →* ℂ where
  toFun := normalizedQuadraticPair I J
  map_one' := by
    rw [normalizedQuadraticPair, canonicalQuadraticPairIdeal_one I J hray, map_one]
    norm_num
  map_mul' := normalizedQuadraticPair_mul I J hray

lemma normalizedQuadraticPair_square (I J : QuadraticIdeal) (D : Ideal O) :
    normalizedQuadraticPair I J D ^ 2 =
      (quadraticIdealMask I (cubicIdealGenerator D) * quadraticIdealMask J (cubicIdealGenerator D)) /
        (Ideal.absNorm D : ℂ) := by
  have hr (L : QuadraticIdeal) : canonicalQuadraticRow L (cubicIdealGenerator D) ^ 2 =
      quadraticIdealMask L (cubicIdealGenerator D) := by
    simpa only [pow_two, canonicalQuadraticRow_mul] using
      canonicalQuadraticRow_square L (cubicIdealGenerator D)
  have hn : (Real.sqrt (Ideal.absNorm D : ℝ) : ℂ) ^ 2 = (Ideal.absNorm D : ℂ) := by
    exact_mod_cast Real.sq_sqrt (Nat.cast_nonneg (Ideal.absNorm D) : (0 : ℝ) ≤ _)
  rw [normalizedQuadraticPair, div_pow, canonicalQuadraticPairIdeal, mul_pow, hr, hr, hn]

/-- Divisors of a squarefree ideal are precisely products of subsets of its prime support. -/
lemma squarefree_ideal_divisor_sum (G : Ideal O) (hG : Squarefree G) (f : Ideal O → ℂ) :
    (∑ D ∈ idealDivisors G, f D) =
      ∑ S ∈ (primeSupport G).powerset, f (∏ P ∈ S, P) := by
  have hf : (idealDivisors G).filter Squarefree = idealDivisors G :=
    Finset.filter_eq_self.mpr (fun D hD => hG.squarefree_of_dvd ((mem_idealDivisors hG.ne_zero).mp hD))
  rw [← hf, squarefree_divisors_eq_image G hG.ne_zero, Finset.sum_image]
  intro S hS T hT he
  exact support_product_injective (Finset.mem_powerset.mp hS) (Finset.mem_powerset.mp hT) he

lemma squarefree_ideal_signed_divisor_product (G : Ideal O) (hG : Squarefree G)
    (f : Ideal O →* ℂ) :
    (∑ D ∈ idealDivisors G, (moebius D : ℂ) * f D) = ∏ P ∈ primeSupport G, (1 - f P) := by
  rw [squarefree_ideal_divisor_sum G hG, Finset.prod_sub]
  apply Finset.sum_congr rfl
  intro S hS
  rw [moebius_support_product (Finset.mem_powerset.mp hS), map_prod]
  simp only [Finset.prod_const_one, mul_one]

lemma squarefree_ideal_divisor_product (G : Ideal O) (hG : Squarefree G)
    (f : Ideal O →* ℂ) :
    (∑ D ∈ idealDivisors G, f D) = ∏ P ∈ primeSupport G, (f P + 1) := by
  rw [squarefree_ideal_divisor_sum G hG, Finset.prod_add]
  apply Finset.sum_congr rfl
  intro S hS
  simp only [map_prod, Finset.prod_const_one, mul_one]

/-- Source and dual divisor densities agree exactly before imposing the norm cutoff. -/
theorem normalizedQuadraticPair_density (I J : QuadraticIdeal)
    (hray : quadraticColumnRay I = quadraticColumnRay J) (G : Ideal O) (hG : Squarefree G) :
    (∑ D ∈ idealDivisors G, ∑ E ∈ idealDivisors G,
      (moebius E : ℂ) * normalizedQuadraticPair I J (D * E)) =
      ∏ P ∈ primeSupport G,
        (1 - (quadraticIdealMask I (cubicIdealGenerator P) * quadraticIdealMask J (cubicIdealGenerator P)) /
          (Ideal.absNorm P : ℂ)) := by
  let f := normalizedQuadraticPairHom I J hray
  have he : (∑ D ∈ idealDivisors G, ∑ E ∈ idealDivisors G,
      (moebius E : ℂ) * normalizedQuadraticPair I J (D * E)) =
      (∑ D ∈ idealDivisors G, f D) * (∑ E ∈ idealDivisors G, (moebius E : ℂ) * f E) := by
    rw [Finset.sum_mul]
    simp only [Finset.mul_sum, f, normalizedQuadraticPairHom,
      MonoidHom.coe_mk, OneHom.coe_mk, normalizedQuadraticPair_mul I J hray]
    apply Finset.sum_congr rfl
    intro D hD
    apply Finset.sum_congr rfl
    intro E hE
    ring
  rw [he, squarefree_ideal_divisor_product G hG, squarefree_ideal_signed_divisor_product G hG,
    ← Finset.prod_mul_distrib]
  apply Finset.prod_congr rfl
  intro P hP
  change (normalizedQuadraticPair I J P + 1) * (1 - normalizedQuadraticPair I J P) = _
  rw [show (normalizedQuadraticPair I J P + 1) * (1 - normalizedQuadraticPair I J P) =
    1 - normalizedQuadraticPair I J P ^ 2 by ring, normalizedQuadraticPair_square]

end SchwartzPlanePoisson


namespace SchwartzPlanePoisson
open Eisenstein UniqueFactorizationMonoid

lemma ideal_coprime_of_isRelPrime (A B : Ideal O) (h : IsRelPrime A B) : IsCoprime A B := by
  apply Ideal.isCoprime_iff_sup_eq.mpr
  exact Ideal.isUnit_iff.mp (h (Ideal.dvd_iff_le.mpr le_sup_left) (Ideal.dvd_iff_le.mpr le_sup_right))

/-- Removing the common prime divisors of a squarefree ideal leaves a coprime quotient. -/
lemma squarefree_sup_quotient_coprime (B G : Ideal O) (hB : Squarefree B) :
    IsCoprime (quadraticIdealQuotient (B ⊔ G) B) G := by
  let D := B ⊔ G
  have hDB : D ∣ B := Ideal.dvd_iff_le.mpr le_sup_left
  have hDG : D ∣ G := Ideal.dvd_iff_le.mpr le_sup_right
  have hD : D ≠ 0 := ne_zero_of_dvd_ne_zero hB.ne_zero hDB
  have hc : IsCoprime (quadraticIdealQuotient D B) (quadraticIdealQuotient D G) :=
    Ideal.isCoprime_iff_sup_eq.mpr ((quadraticIdealQuotient_coprime_iff D B G hD hDB hDG).mpr rfl)
  have hs : Squarefree (D * quadraticIdealQuotient D B) := by
    rw [quadraticIdeal_mul_quotient hDB]
    exact hB
  have hq := ideal_coprime_of_isRelPrime D (quadraticIdealQuotient D B) (squarefree_mul_iff.mp hs).1
  have ht := hq.symm.mul_right hc
  rw [quadraticIdeal_mul_quotient hDG] at ht
  exact ht

lemma ideal_sup_mul_of_coprime_divisor (D H G : Ideal O)
    (hDG : D ∣ G) (hHG : IsCoprime H G) : (D * H) ⊔ G = D := by
  have hleft : D ∣ (D * H) ⊔ G :=
    Ideal.dvd_iff_le.mpr (sup_le (Ideal.dvd_iff_le.mp (dvd_mul_right D H)) (Ideal.dvd_iff_le.mp hDG))
  have hcop : IsCoprime ((D * H) ⊔ G) H :=
    (hHG.mono (dvd_refl H) (Ideal.dvd_iff_le.mpr le_sup_right)).symm
  have hright : (D * H) ⊔ G ∣ D := hcop.dvd_of_dvd_mul_right (Ideal.dvd_iff_le.mpr le_sup_left)
  exact associated_iff_eq.mp (associated_of_dvd_dvd hright hleft)

/-- Splitting a squarefree ideal at a fixed squarefree support is unique. -/
def squarefreeIdealSplit (G : Ideal O) (hG : Squarefree G) :
    {B : Ideal O // Squarefree B} ≃
      (idealDivisors G) × {H : Ideal O // Squarefree H ∧ IsCoprime H G} where
  toFun B := (⟨B.val ⊔ G, (mem_idealDivisors hG.ne_zero).mpr (Ideal.dvd_iff_le.mpr le_sup_right)⟩,
    ⟨quadraticIdealQuotient (B.val ⊔ G) B.val,
      B.property.squarefree_of_dvd (quadraticIdealQuotient_dvd (Ideal.dvd_iff_le.mpr le_sup_left)),
      squarefree_sup_quotient_coprime B.val G B.property⟩)
  invFun p := ⟨p.1.val * p.2.val, squarefree_mul_iff.mpr
    ⟨(p.2.property.2.mono (dvd_refl _) ((mem_idealDivisors hG.ne_zero).mp p.1.property)).symm.isRelPrime,
      hG.squarefree_of_dvd ((mem_idealDivisors hG.ne_zero).mp p.1.property), p.2.property.1⟩⟩
  left_inv B := Subtype.ext (quadraticIdeal_mul_quotient (Ideal.dvd_iff_le.mpr le_sup_left))
  right_inv p := by
    have hDG := (mem_idealDivisors hG.ne_zero).mp p.1.property
    have hs := ideal_sup_mul_of_coprime_divisor p.1.val p.2.val G hDG p.2.property.2
    apply Prod.ext (Subtype.ext hs)
    apply Subtype.ext
    change quadraticIdealQuotient ((p.1.val * p.2.val) ⊔ G) (p.1.val * p.2.val) = p.2.val
    rw [hs]
    exact mul_left_cancel₀ (ne_zero_of_dvd_ne_zero hG.ne_zero hDG)
      (quadraticIdeal_mul_quotient (dvd_mul_right p.1.val p.2.val))

def squarefreeIdealBall (K : ℝ) : Finset (Ideal O) :=
  (Ideal.finite_setOf_absNorm_le (S := O) ⌈K⌉₊).toFinset.filter
    (fun I => Squarefree I ∧ (Ideal.absNorm I : ℝ) ≤ K)

lemma mem_squarefreeIdealBall {K : ℝ} {I : Ideal O} :
    I ∈ squarefreeIdealBall K ↔ Squarefree I ∧ (Ideal.absNorm I : ℝ) ≤ K := by
  simp only [squarefreeIdealBall, Finset.mem_filter, Set.Finite.mem_toFinset, Set.mem_setOf_eq]
  constructor
  · exact And.right
  · intro h
    exact ⟨by exact_mod_cast h.2.trans (Nat.le_ceil K), h⟩

def coprimeSquarefreeIdealBall (G : Ideal O) (K : ℝ) : Finset (Ideal O) :=
  (squarefreeIdealBall K).filter (fun H => IsCoprime H G)

lemma squarefreeIdeal_cutoff_summable (K : ℝ) (f : Ideal O → ℂ) :
    Summable (fun B : {B : Ideal O // Squarefree B} =>
      if (Ideal.absNorm B.val : ℝ) ≤ K then f B.val else 0) := by
  let e : squarefreeIdealBall K → {B : Ideal O // Squarefree B} :=
    fun B => ⟨B.val, (mem_squarefreeIdealBall.mp B.property).1⟩
  apply summable_of_hasFiniteSupport
  apply (Set.finite_range e).subset
  intro B hB
  have hN : (Ideal.absNorm B.val : ℝ) ≤ K := by
    by_contra hn
    exact hB (if_neg hn)
  exact ⟨⟨B.val, mem_squarefreeIdealBall.mpr ⟨B.property, hN⟩⟩, Subtype.ext rfl⟩

lemma tsum_squarefreeIdeal_cutoff (K : ℝ) (f : Ideal O → ℂ) :
    (∑' B : {B : Ideal O // Squarefree B}, if (Ideal.absNorm B.val : ℝ) ≤ K then f B.val else 0) =
      ∑ B : squarefreeIdealBall K, f B.val := by
  let e : squarefreeIdealBall K → {B : Ideal O // Squarefree B} :=
    fun B => ⟨B.val, (mem_squarefreeIdealBall.mp B.property).1⟩
  have he : Function.Injective e := fun B C h => Subtype.ext (congrArg (fun I : {B : Ideal O // Squarefree B} => I.val) h)
  let F : {B : Ideal O // Squarefree B} → ℂ := fun B =>
    if (Ideal.absNorm B.val : ℝ) ≤ K then f B.val else 0
  have hs : Function.support F ⊆ Set.range e := by
    intro B hB
    have hN : (Ideal.absNorm B.val : ℝ) ≤ K := by
      by_contra hn
      exact hB (if_neg hn)
    exact ⟨⟨B.val, mem_squarefreeIdealBall.mpr ⟨B.property, hN⟩⟩, Subtype.ext rfl⟩
  change (∑' B, F B) = _
  rw [← he.tsum_eq hs, tsum_fintype]
  apply Finset.sum_congr rfl
  intro B _
  exact if_pos (mem_squarefreeIdealBall.mp B.property).2

lemma tsum_coprimeSquarefreeIdeal_cutoff (G D : Ideal O) (hD : D ≠ 0) (K : ℝ) (f : Ideal O → ℂ) :
    (∑' H : {H : Ideal O // Squarefree H ∧ IsCoprime H G},
      if (Ideal.absNorm (D * H.val) : ℝ) ≤ K then f (D * H.val) else 0) =
      ∑ H : coprimeSquarefreeIdealBall G K,
        if (Ideal.absNorm (D * H.val) : ℝ) ≤ K then f (D * H.val) else 0 := by
  let e : coprimeSquarefreeIdealBall G K → {H : Ideal O // Squarefree H ∧ IsCoprime H G} :=
    fun H => ⟨H.val, (mem_squarefreeIdealBall.mp (Finset.mem_filter.mp H.property).1).1,
      (Finset.mem_filter.mp H.property).2⟩
  have he : Function.Injective e := fun H J h => Subtype.ext (congrArg (fun I : {H : Ideal O // Squarefree H ∧ IsCoprime H G} => I.val) h)
  let F : {H : Ideal O // Squarefree H ∧ IsCoprime H G} → ℂ := fun H =>
    if (Ideal.absNorm (D * H.val) : ℝ) ≤ K then f (D * H.val) else 0
  have hs : Function.support F ⊆ Set.range e := by
    intro H hH
    have hN : (Ideal.absNorm (D * H.val) : ℝ) ≤ K := by
      by_contra hn
      exact hH (if_neg hn)
    have hD1 : 1 ≤ Ideal.absNorm D := Nat.one_le_iff_ne_zero.mpr (Ideal.absNorm_eq_zero_iff.not.mpr hD)
    have hHN : (Ideal.absNorm H.val : ℝ) ≤ K := by
      have hn : Ideal.absNorm H.val ≤ Ideal.absNorm (D * H.val) := by
        simpa only [one_mul, map_mul] using Nat.mul_le_mul_right (Ideal.absNorm H.val) hD1
      exact (Nat.cast_le.mpr hn).trans hN
    exact ⟨⟨H.val, Finset.mem_filter.mpr
      ⟨mem_squarefreeIdealBall.mpr ⟨H.property.1, hHN⟩, H.property.2⟩⟩, Subtype.ext rfl⟩
  simpa only [tsum_fintype, F, e] using (he.tsum_eq hs).symm

/-- A sharp norm cutoff differs from the coprime decomposition only at its boundary. -/
theorem squarefreeIdeal_split_sum (G : Ideal O) (hG : Squarefree G) (K : ℝ) (f : Ideal O → ℂ) :
    (∑ B : squarefreeIdealBall K, f B.val) =
      ∑ D : idealDivisors G, ∑ H : coprimeSquarefreeIdealBall G K,
        if (Ideal.absNorm (D.val * H.val) : ℝ) ≤ K then f (D.val * H.val) else 0 := by
  let F : {B : Ideal O // Squarefree B} → ℂ := fun B =>
    if (Ideal.absNorm B.val : ℝ) ≤ K then f B.val else 0
  have hs := (squarefreeIdealSplit G hG).symm.summable_iff.mpr (squarefreeIdeal_cutoff_summable K f)
  have he := ((squarefreeIdealSplit G hG).symm.tsum_eq F).symm
  calc
    _ = ∑' B : {B : Ideal O // Squarefree B}, F B := (tsum_squarefreeIdeal_cutoff K f).symm
    _ = ∑' p : (idealDivisors G) × {H : Ideal O // Squarefree H ∧ IsCoprime H G},
        if (Ideal.absNorm (p.1.val * p.2.val) : ℝ) ≤ K then f (p.1.val * p.2.val) else 0 := he
    _ = ∑' D : idealDivisors G, ∑' H : {H : Ideal O // Squarefree H ∧ IsCoprime H G},
        if (Ideal.absNorm (D.val * H.val) : ℝ) ≤ K then f (D.val * H.val) else 0 := hs.tsum_prod
    _ = _ := by
      rw [tsum_fintype]
      apply Finset.sum_congr rfl
      intro D _
      exact tsum_coprimeSquarefreeIdeal_cutoff G D.val
        (ne_zero_of_dvd_ne_zero hG.ne_zero ((mem_idealDivisors hG.ne_zero).mp D.property)) K f

end SchwartzPlanePoisson


namespace SchwartzPlanePoisson
open Eisenstein UniqueFactorizationMonoid

/-- The difference is supported where multiplication by a divisor crosses the norm cutoff. -/
def quadraticCutoffDifference (K : ℝ) (H D : Ideal O) : ℝ :=
  (if (Ideal.absNorm (H * D) : ℝ) ≤ K then 1 else 0) -
    (if (Ideal.absNorm H : ℝ) ≤ K then 1 else 0)

lemma quadraticCutoffDifference_nonzero (K : ℝ) (H D : Ideal O) (hD : D ≠ 0) :
    quadraticCutoffDifference K H D ≠ 0 ↔
      (Ideal.absNorm H : ℝ) ≤ K ∧ K < (Ideal.absNorm (H * D) : ℝ) := by
  have hd : 1 ≤ Ideal.absNorm D := Nat.one_le_iff_ne_zero.mpr (Ideal.absNorm_eq_zero_iff.not.mpr hD)
  have hm : (Ideal.absNorm H : ℝ) ≤ Ideal.absNorm (H * D) := by
    exact_mod_cast (show Ideal.absNorm H ≤ Ideal.absNorm (H * D) by
      simpa only [map_mul, mul_one] using Nat.mul_le_mul_left (Ideal.absNorm H) hd)
  unfold quadraticCutoffDifference
  split_ifs <;> simp_all <;> linarith

lemma quadraticCutoffDifference_eq_neg_one (K : ℝ) (H D : Ideal O) (hD : D ≠ 0)
    (h : quadraticCutoffDifference K H D ≠ 0) : quadraticCutoffDifference K H D = -1 := by
  obtain ⟨hH, hHD⟩ := (quadraticCutoffDifference_nonzero K H D hD).mp h
  simp only [quadraticCutoffDifference, if_neg (not_le.mpr hHD), if_pos hH]
  norm_num

def quadraticBoundaryWeight (K : ℝ) (H D E : Ideal O) : ℂ :=
  (quadraticCutoffDifference K H D : ℂ) / (Real.sqrt (Ideal.absNorm (H * D * E) : ℝ) : ℂ)

lemma quadraticBoundaryWeight_norm_le (K : ℝ) (hK : 0 < K) (H D E : Ideal O)
    (hD : D ≠ 0) (hE : E ≠ 0) : ‖quadraticBoundaryWeight K H D E‖ ≤ 1 / Real.sqrt K := by
  by_cases hc : quadraticCutoffDifference K H D = 0
  · simp only [quadraticBoundaryWeight, hc, Complex.ofReal_zero, zero_div, norm_zero]
    positivity
  have he : 1 ≤ Ideal.absNorm E := Nat.one_le_iff_ne_zero.mpr (Ideal.absNorm_eq_zero_iff.not.mpr hE)
  have hN : (Ideal.absNorm (H * D) : ℝ) ≤ Ideal.absNorm (H * D * E) := by
    exact_mod_cast (show Ideal.absNorm (H * D) ≤ Ideal.absNorm (H * D * E) by
      simpa only [map_mul, mul_one] using Nat.mul_le_mul_left (Ideal.absNorm (H * D)) he)
  have hlt := ((quadraticCutoffDifference_nonzero K H D hD).mp hc).2.trans_le hN
  rw [quadraticBoundaryWeight, quadraticCutoffDifference_eq_neg_one K H D hD hc]
  simp only [Complex.ofReal_neg, Complex.ofReal_one, norm_div, norm_neg, norm_one,
    Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg _)]
  exact one_div_le_one_div_of_le (Real.sqrt_pos.mpr hK) (Real.sqrt_le_sqrt hlt.le)

def quadraticPairPartial (I J : QuadraticIdeal) (K : ℝ) : ℂ :=
  ∑ B : squarefreeIdealBall K, normalizedQuadraticPair I J B.val

def quadraticPairCoprimePartial (I J : QuadraticIdeal) (G : Ideal O) (K : ℝ) : ℂ :=
  ∑ H : coprimeSquarefreeIdealBall G K, normalizedQuadraticPair I J H.val

def quadraticPairDivisors (I J : QuadraticIdeal) (G : Ideal O) : ℂ :=
  ∑ E ∈ idealDivisors G, (moebius E : ℂ) * normalizedQuadraticPair I J E

def quadraticPairDensity (I J : QuadraticIdeal) (G : Ideal O) : ℂ :=
  ∏ P ∈ primeSupport G,
    (1 - (quadraticIdealMask I (cubicIdealGenerator P) * quadraticIdealMask J (cubicIdealGenerator P)) /
      (Ideal.absNorm P : ℂ))

def quadraticNormCutoff (K : ℝ) (H : Ideal O) : ℂ :=
  if (Ideal.absNorm H : ℝ) ≤ K then 1 else 0

lemma quadraticPairPartial_split (I J : QuadraticIdeal)
    (hray : quadraticColumnRay I = quadraticColumnRay J) (G : Ideal O) (hG : Squarefree G) (K : ℝ) :
    quadraticPairPartial I J K =
      ∑ H : coprimeSquarefreeIdealBall G K, ∑ D ∈ idealDivisors G,
        normalizedQuadraticPair I J H.val * normalizedQuadraticPair I J D * quadraticNormCutoff K (H.val * D) := by
  rw [quadraticPairPartial, squarefreeIdeal_split_sum G hG K, Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro H _
  rw [Finset.sum_coe_sort (s := idealDivisors G)
    (f := fun D => if (Ideal.absNorm (D * H.val) : ℝ) ≤ K then normalizedQuadraticPair I J (D * H.val) else 0)]
  apply Finset.sum_congr rfl
  intro D hD
  rw [mul_comm D H.val, normalizedQuadraticPair_mul I J hray]
  unfold quadraticNormCutoff
  split_ifs <;> ring

/-- The uncancelled principal contribution is exactly the cutoff boundary term. -/
theorem quadraticPair_main_difference (I J : QuadraticIdeal)
    (hray : quadraticColumnRay I = quadraticColumnRay J) (G : Ideal O) (hG : Squarefree G) (K : ℝ) :
    quadraticPairPartial I J K * quadraticPairDivisors I J G -
      quadraticPairCoprimePartial I J G K * quadraticPairDensity I J G =
      ∑ H : coprimeSquarefreeIdealBall G K, ∑ D ∈ idealDivisors G, ∑ E ∈ idealDivisors G,
        (moebius E : ℂ) * normalizedQuadraticPair I J (H.val * D * E) *
          (quadraticCutoffDifference K H.val D : ℂ) := by
  have hd : quadraticPairDensity I J G =
      ∑ D ∈ idealDivisors G, ∑ E ∈ idealDivisors G,
        (moebius E : ℂ) * (normalizedQuadraticPair I J D * normalizedQuadraticPair I J E) := by
    rw [quadraticPairDensity, ← normalizedQuadraticPair_density I J hray G hG]
    simp only [normalizedQuadraticPair_mul I J hray]
  rw [quadraticPairPartial_split I J hray G hG K, hd]
  unfold quadraticPairDivisors quadraticPairCoprimePartial
  simp only [Finset.sum_mul]
  simp only [Finset.mul_sum]
  rw [← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro H _
  rw [← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro D hD
  rw [← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro E hE
  have hHN := (mem_squarefreeIdealBall.mp (Finset.mem_filter.mp H.property).1).2
  have hc : (quadraticCutoffDifference K H.val D : ℂ) = quadraticNormCutoff K (H.val * D) - 1 := by
    unfold quadraticCutoffDifference quadraticNormCutoff
    rw [if_pos hHN]
    split_ifs <;> norm_num
  rw [hc, normalizedQuadraticPair_mul I J hray, normalizedQuadraticPair_mul I J hray]
  ring

end SchwartzPlanePoisson


namespace IdealCoprimeBilinearSieve
open Eisenstein DivisorBlockCauchy FiniteSieveOperator

/-- A bounded row weight multiplies the coprime Gram bound by its supremum. -/
theorem weighted_coprime_gram_bound {m n : Type*} [Fintype m] [Fintype n]
    [DecidableEq m] [DecidableEq n] (ε : ℝ) (hε : 0 < ε)
    (cols : n → Ideal O) (hc : ∀ j, cols j ≠ 0) (N : ℝ) (hN : 0 ≤ N)
    (hcols : ∀ j, (Ideal.absNorm (cols j) : ℝ) ≤ N) (A : Matrix m n ℂ) (a : n → ℂ)
    (w : m → ℂ) (C : ℝ) (hC : 0 ≤ C) (hw : ∀ i, ‖w i‖ ≤ C) :
    ‖∑ i, w i * (∑ j, ∑ k, if cols j ⊔ cols k = ⊤ then
      star (A i j * a j) * (A i k * a k) else 0)‖ ≤
      C * (‖operator A‖ ^ 2 * (divisorConstant ε hε * N ^ ε) * ∑ j, ‖a j‖ ^ 2) := by
  have hs := ideal_coprime_bilinear_operator_bound ε hε cols cols hc hc N N hcols hcols A A a a
  have hb : 0 ≤ ‖operator A‖ ^ 2 * (divisorConstant ε hε * N ^ ε) * ∑ j, ‖a j‖ ^ 2 := by
    have hd := (divisorConstant_pos ε hε).le
    have hn := Real.rpow_nonneg hN ε
    positivity
  have hsum : (∑ i, ‖∑ j, ∑ k, if cols j ⊔ cols k = ⊤ then
      star (A i j * a j) * (A i k * a k) else 0‖) ≤
      ‖operator A‖ ^ 2 * (divisorConstant ε hε * N ^ ε) * ∑ j, ‖a j‖ ^ 2 := by
    nlinarith only [hs, hb]
  calc
    _ ≤ ∑ i, ‖w i‖ * ‖∑ j, ∑ k, if cols j ⊔ cols k = ⊤ then
        star (A i j * a j) * (A i k * a k) else 0‖ := by
      simpa only [norm_mul] using norm_sum_le Finset.univ (fun i => w i *
        (∑ j, ∑ k, if cols j ⊔ cols k = ⊤ then star (A i j * a j) * (A i k * a k) else 0))
    _ ≤ ∑ i, C * ‖∑ j, ∑ k, if cols j ⊔ cols k = ⊤ then
        star (A i j * a j) * (A i k * a k) else 0‖ :=
      Finset.sum_le_sum (fun i _ => mul_le_mul_of_nonneg_right (hw i) (norm_nonneg _))
    _ = C * ∑ i, ‖∑ j, ∑ k, if cols j ⊔ cols k = ⊤ then
        star (A i j * a j) * (A i k * a k) else 0‖ := (Finset.mul_sum ..).symm
    _ ≤ _ := mul_le_mul_of_nonneg_left hsum hC

end IdealCoprimeBilinearSieve

namespace SchwartzPlanePoisson
open Eisenstein UniqueFactorizationMonoid DivisorBlockCauchy IdealCoprimeBilinearSieve

/-- The surviving principal boundary gains the inverse square root of its cutoff. -/
theorem quadratic_boundary_operator_bound {m n : Type*} [Fintype m] [Fintype n]
    [DecidableEq m] [DecidableEq n] (ε : ℝ) (hε : 0 < ε) (K : ℝ) (hK : 0 < K)
    (G : Ideal O) (hG : G ≠ 0) (rows : m → Ideal O) (cols : n → Ideal O)
    (hc : ∀ j, cols j ≠ 0) (N : ℝ) (hN : 0 ≤ N)
    (hcols : ∀ j, (Ideal.absNorm (cols j) : ℝ) ≤ N)
    (A : Matrix m n ℂ) (a : n → ℂ) (r : Ideal O → Ideal O → n → ℂ)
    (hr : ∀ D E j, ‖r D E j‖ ≤ 1) :
    ‖∑ D ∈ idealDivisors G, ∑ E ∈ idealDivisors G, (moebius E : ℂ) *
      (∑ i, quadraticBoundaryWeight K (rows i) D E *
        (∑ j, ∑ k, if cols j ⊔ cols k = ⊤ then
          star (A i j * (a j * r D E j)) * (A i k * (a k * r D E k)) else 0))‖ ≤
      ((idealDivisors G).card : ℝ) ^ 2 *
        ((1 / Real.sqrt K) * ‖FiniteSieveOperator.operator A‖ ^ 2 *
          (divisorConstant ε hε * N ^ ε) * ∑ j, ‖a j‖ ^ 2) := by
  let B := (1 / Real.sqrt K) * ‖FiniteSieveOperator.operator A‖ ^ 2 *
    (divisorConstant ε hε * N ^ ε) * ∑ j, ‖a j‖ ^ 2
  have hb (D : Ideal O) (hD : D ∈ idealDivisors G) (E : Ideal O) (hE : E ∈ idealDivisors G) :
      ‖(moebius E : ℂ) * (∑ i, quadraticBoundaryWeight K (rows i) D E *
        (∑ j, ∑ k, if cols j ⊔ cols k = ⊤ then
          star (A i j * (a j * r D E j)) * (A i k * (a k * r D E k)) else 0))‖ ≤ B := by
    have he := weighted_coprime_gram_bound ε hε cols hc N hN hcols A (fun j => a j * r D E j)
      (fun i => quadraticBoundaryWeight K (rows i) D E) (1 / Real.sqrt K) (by positivity)
      (fun i => quadraticBoundaryWeight_norm_le K hK (rows i) D E
        (IdealDivisorBound.divisor_ne_zero hG hD) (IdealDivisorBound.divisor_ne_zero hG hE))
    have hm : (∑ j, ‖a j * r D E j‖ ^ 2) ≤ ∑ j, ‖a j‖ ^ 2 := by
      apply Finset.sum_le_sum
      intro j _
      apply pow_le_pow_left₀ (norm_nonneg _)
      rw [norm_mul]
      exact mul_le_of_le_one_right (norm_nonneg _) (hr D E j)
    rw [norm_mul]
    apply (mul_le_of_le_one_left (norm_nonneg _) (moebius_norm_le_one E)).trans
    apply he.trans
    dsimp only [B]
    rw [← mul_assoc, ← mul_assoc]
    apply mul_le_mul_of_nonneg_left hm
    have hd := (divisorConstant_pos ε hε).le
    have hn := Real.rpow_nonneg hN ε
    positivity
  calc
    _ ≤ ∑ D ∈ idealDivisors G, ‖∑ E ∈ idealDivisors G, (moebius E : ℂ) *
        (∑ i, quadraticBoundaryWeight K (rows i) D E *
          (∑ j, ∑ k, if cols j ⊔ cols k = ⊤ then
            star (A i j * (a j * r D E j)) * (A i k * (a k * r D E k)) else 0))‖ := norm_sum_le _ _
    _ ≤ ∑ D ∈ idealDivisors G, ∑ E ∈ idealDivisors G, B := by
      apply Finset.sum_le_sum
      intro D hD
      exact (norm_sum_le _ _).trans (Finset.sum_le_sum (fun E hE => hb D hD E hE))
    _ = _ := by simp only [Finset.sum_const, nsmul_eq_mul, B]; ring

end SchwartzPlanePoisson




namespace SchwartzPlanePoisson
open Eisenstein UniqueFactorizationMonoid

lemma quadratic_twoIdeal_prime : Prime cubicTwoIdeal := by
  have hn : cubicTwoIdeal ≠ 0 := by
    intro h
    have he := cubicTwoIdeal_absNorm
    rw [h, map_zero] at he
    norm_num at he
  exact Ideal.prime_of_isPrime hn inferInstance

lemma prime_ideal_char_two_iff (P : Ideal O) (hP : Prime P) :
    ringChar (O ⧸ P) = 2 ↔ P = cubicTwoIdeal := by
  letI : P.IsMaximal := (Ideal.isPrime_of_prime hP).isMaximal hP.ne_zero
  constructor
  · intro h
    have hz : (2 : O ⧸ P) = 0 := (ringChar.spec (O ⧸ P) 2).mpr (by rw [h])
    have hm : (2 : O) ∈ P := Ideal.Quotient.eq_zero_iff_mem.mp (by simpa only [map_ofNat] using hz)
    have hle : cubicTwoIdeal ≤ P := by
      rw [cubicTwoIdeal, Ideal.span_singleton_neg]
      exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hm)
    exact ((inferInstance : cubicTwoIdeal.IsMaximal).eq_of_le
      (Ideal.IsMaximal.ne_top (inferInstance : P.IsMaximal)) hle).symm
  · rintro rfl
    exact cubicTwoIdeal_residue_char

lemma quadraticSupported_iff_bad_not_dvd (I : Ideal O) :
    quadraticSupported I ↔ ¬ ramifiedIdeal ∣ I ∧ ¬ cubicTwoIdeal ∣ I := by
  constructor
  · intro h
    refine ⟨(goodIdeal_iff_not_ramified I).mp h.1, ?_⟩
    intro hd
    have hI := primaryIdealGenerator_ne_zero_ideal I h.1
    have hm : cubicTwoIdeal ∈ primeSupport I := Multiset.mem_toFinset.mpr
      ((Ideal.mem_normalizedFactors_iff hI).mpr ⟨inferInstance, Ideal.dvd_iff_le.mp hd⟩)
    exact h.2 cubicTwoIdeal hm cubicTwoIdeal_residue_char
  · rintro ⟨hr, ht⟩
    refine ⟨(goodIdeal_iff_not_ramified I).mpr hr, ?_⟩
    intro P hP hchar
    have he := (prime_ideal_char_two_iff P (support_prime hP)).mp hchar
    apply ht
    rw [← he]
    exact dvd_of_mem_normalizedFactors (Multiset.mem_toFinset.mp hP)

/-- The finite mask contains both excluded primes and the conductor prime support. -/
def quadraticMaskPrimes (D : Ideal O) : Finset (Ideal O) :=
  {ramifiedIdeal, cubicTwoIdeal} ∪ primeSupport D

def quadraticMaskIdeal (D : Ideal O) : Ideal O := ∏ P ∈ quadraticMaskPrimes D, P

lemma quadraticMaskPrimes_prime (D P : Ideal O) (hP : P ∈ quadraticMaskPrimes D) : Prime P := by
  rcases Finset.mem_union.mp hP with h | h
  · rcases Finset.mem_insert.mp h with h | h
    · simpa only [h] using ramifiedIdeal_prime
    · simpa only [Finset.mem_singleton.mp h] using quadratic_twoIdeal_prime
  · exact support_prime h

lemma quadraticMaskIdeal_squarefree (D : Ideal O) : Squarefree (quadraticMaskIdeal D) := by
  have hn : quadraticMaskIdeal D ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr (fun P hP => (quadraticMaskPrimes_prime D P hP).ne_zero)
  have hf : normalizedFactors (quadraticMaskIdeal D) = (quadraticMaskPrimes D).val := by
    have hp : ∀ P ∈ (quadraticMaskPrimes D).val, Prime P := fun P hP => quadraticMaskPrimes_prime D P hP
    simpa [quadraticMaskIdeal] using normalizedFactors_prod_of_prime hp
  apply (squarefree_iff_nodup_normalizedFactors hn).mpr
  rw [hf]
  exact (quadraticMaskPrimes D).nodup

lemma ramifiedIdeal_dvd_quadraticMaskIdeal (D : Ideal O) : ramifiedIdeal ∣ quadraticMaskIdeal D :=
  Finset.dvd_prod_of_mem (fun P => P) (Finset.mem_union_left _ (Finset.mem_insert_self _ _))

lemma twoIdeal_dvd_quadraticMaskIdeal (D : Ideal O) : cubicTwoIdeal ∣ quadraticMaskIdeal D :=
  Finset.dvd_prod_of_mem (fun P => P)
    (Finset.mem_union_left _ (Finset.mem_insert_of_mem (Finset.mem_singleton_self _)))

/-- Coprimality with the fixed mask gives the exact admissibility needed by the native sieve. -/
lemma quadraticIdealAdmissible_of_mask_coprime (D H : Ideal O)
    (hH : Squarefree H) (hc : IsCoprime H (quadraticMaskIdeal D)) : quadraticIdealAdmissible H := by
  have hs : quadraticSupported H := (quadraticSupported_iff_bad_not_dvd H).mpr ⟨
    fun h => ramifiedIdeal_prime.2.1 (hc.isUnit_of_dvd' h (ramifiedIdeal_dvd_quadraticMaskIdeal D)),
    fun h => quadratic_twoIdeal_prime.2.1 (hc.isUnit_of_dvd' h (twoIdeal_dvd_quadraticMaskIdeal D))⟩
  exact ⟨hs.1, hH, hs.2⟩

lemma coprimeSquarefreeIdealBall_admissible (D : Ideal O) (K : ℝ)
    (H : coprimeSquarefreeIdealBall (quadraticMaskIdeal D) K) : quadraticIdealAdmissible H.val :=
  quadraticIdealAdmissible_of_mask_coprime D H.val
    (mem_squarefreeIdealBall.mp (Finset.mem_filter.mp H.property).1).1
    (Finset.mem_filter.mp H.property).2

end SchwartzPlanePoisson


namespace SchwartzPlanePoisson
open Eisenstein UniqueFactorizationMonoid

lemma quadraticPair_boundary_term (I J : QuadraticIdeal)
    (hray : quadraticColumnRay I = quadraticColumnRay J)
    (H D E : Ideal O) (hH : quadraticSupported H) (K : ℝ) (a b : ℂ) :
    (star a * b) * ((moebius E : ℂ) * normalizedQuadraticPair I J (H * D * E) *
      (quadraticCutoffDifference K H D : ℂ)) =
      (moebius E : ℂ) * quadraticBoundaryWeight K H D E *
        (star (canonicalQuadraticRow I (primaryIdealGenerator H) *
          (a * canonicalQuadraticRow I (cubicIdealGenerator D * cubicIdealGenerator E))) *
          (canonicalQuadraticRow J (primaryIdealGenerator H) *
            (b * canonicalQuadraticRow J (cubicIdealGenerator D * cubicIdealGenerator E)))) := by
  have hspan : Ideal.span {cubicIdealGenerator D * cubicIdealGenerator E} = D * E := by
    rw [← Ideal.span_singleton_mul_span_singleton, span_cubicIdealGenerator, span_cubicIdealGenerator]
  have hde := canonicalQuadraticPairIdeal_span I J hray (cubicIdealGenerator D * cubicIdealGenerator E)
  rw [hspan] at hde
  have hp : canonicalQuadraticPairIdeal I J (H * D * E) =
      (canonicalQuadraticRow I (primaryIdealGenerator H) * canonicalQuadraticRow J (primaryIdealGenerator H)) *
      (canonicalQuadraticRow I (cubicIdealGenerator D * cubicIdealGenerator E) *
        canonicalQuadraticRow J (cubicIdealGenerator D * cubicIdealGenerator E)) := by
    rw [mul_assoc, canonicalQuadraticPairIdeal_mul I J hray,
      canonicalQuadraticPairIdeal_primary I J hray H hH.1, hde]
  rw [normalizedQuadraticPair, hp]
  simp only [quadraticBoundaryWeight, div_eq_mul_inv, star_mul, canonicalQuadraticRow_star]
  ring

namespace CanonicalQuadraticSieve

/-- The principal source/dual discrepancy, retaining the coprime column pairs. -/
def principalDifference {n : Type*} [Fintype n] (cols : n → QuadraticIdeal)
    (a : n → ℂ) (D : Ideal O) (K : ℝ) : ℂ :=
  ∑ j, ∑ k, if IsCoprime (cols j).val (cols k).val then
    star (a j) * a k *
      (quadraticPairPartial (cols j) (cols k) K * quadraticPairDivisors (cols j) (cols k) (quadraticMaskIdeal D) -
       quadraticPairCoprimePartial (cols j) (cols k) (quadraticMaskIdeal D) K *
         quadraticPairDensity (cols j) (cols k) (quadraticMaskIdeal D)) else 0

/-- Cancellation leaves a boundary controlled by the smaller native quadratic sieve norm. -/
theorem principalDifference_bound {n : Type*} [Fintype n] [DecidableEq n]
    (cols : n → QuadraticIdeal) (hinj : Function.Injective cols)
    (N : ℝ) (hN : 0 ≤ N) (hcols : ∀ j, (Ideal.absNorm (cols j).val : ℝ) ≤ N)
    (hray : ∀ j k, quadraticColumnRay (cols j) = quadraticColumnRay (cols k))
    (a : n → ℂ) (D : Ideal O) (K : ℝ) (hK : 0 < K) (ε : ℝ) (hε : 0 < ε) :
    ‖principalDifference cols a D K‖ ≤
      ((idealDivisors (quadraticMaskIdeal D)).card : ℝ) ^ 2 *
        ((1 / Real.sqrt K) * sieveNorm K N * (DivisorBlockCauchy.divisorConstant ε hε * N ^ ε) *
          ∑ j, ‖a j‖ ^ 2) := by
  classical
  let rows : (coprimeSquarefreeIdealBall (quadraticMaskIdeal D) K) → QuadraticIdeal := fun H => ⟨H.val, coprimeSquarefreeIdealBall_admissible D K H⟩
  let A : (coprimeSquarefreeIdealBall (quadraticMaskIdeal D) K) → n → ℂ := fun H j => canonicalQuadraticRow (cols j) (primaryIdealGenerator H.val)
  let r (E F : Ideal O) (j : n) := canonicalQuadraticRow (cols j) (cubicIdealGenerator E * cubicIdealGenerator F)
  have hpoint (j k : n) :
      (if IsCoprime (cols j).val (cols k).val then star (a j) * a k *
        (quadraticPairPartial (cols j) (cols k) K * quadraticPairDivisors (cols j) (cols k) (quadraticMaskIdeal D) -
         quadraticPairCoprimePartial (cols j) (cols k) (quadraticMaskIdeal D) K * quadraticPairDensity (cols j) (cols k) (quadraticMaskIdeal D)) else 0) =
        ∑ E ∈ idealDivisors (quadraticMaskIdeal D), ∑ F ∈ idealDivisors (quadraticMaskIdeal D), ∑ H : (coprimeSquarefreeIdealBall (quadraticMaskIdeal D) K),
          (moebius F : ℂ) * quadraticBoundaryWeight K H.val E F *
            (if IsCoprime (cols j).val (cols k).val then
              star (A H j * (a j * r E F j)) * (A H k * (a k * r E F k)) else 0) := by
    dsimp only [A, r]
    by_cases hc : IsCoprime (cols j).val (cols k).val
    · rw [if_pos hc, quadraticPair_main_difference (cols j) (cols k) (hray j k)
        (quadraticMaskIdeal D) (quadraticMaskIdeal_squarefree D) K]
      simp only [Finset.mul_sum]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro E hE
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro F hF
      apply Finset.sum_congr rfl
      intro H _
      rw [if_pos hc]
      exact quadraticPair_boundary_term (cols j) (cols k) (hray j k) H.val E F
        ⟨(rows H).property.1, (rows H).property.2.2⟩ K (a j) (a k)
    · simp only [hc, ite_false, mul_zero, Finset.sum_const_zero]
  have heq : principalDifference cols a D K =
      ∑ E ∈ idealDivisors (quadraticMaskIdeal D), ∑ F ∈ idealDivisors (quadraticMaskIdeal D), (moebius F : ℂ) *
        (∑ H : (coprimeSquarefreeIdealBall (quadraticMaskIdeal D) K), quadraticBoundaryWeight K H.val E F *
          (∑ j, ∑ k, if (cols j).val ⊔ (cols k).val = ⊤ then
            star (A H j * (a j * r E F j)) * (A H k * (a k * r E F k)) else 0)) := by
    unfold principalDifference
    simp_rw [hpoint]
    simp_rw [Finset.sum_comm (s := (Finset.univ : Finset n)) (t := idealDivisors (quadraticMaskIdeal D)),
      Finset.sum_comm (s := (Finset.univ : Finset n)) (t := (Finset.univ : Finset (coprimeSquarefreeIdealBall (quadraticMaskIdeal D) K)))]
    simp only [Finset.mul_sum, mul_assoc, Ideal.isCoprime_iff_sup_eq]
  rw [heq]
  have hb := quadratic_boundary_operator_bound ε hε K hK (quadraticMaskIdeal D) (quadraticMaskIdeal_squarefree D).ne_zero
    (fun H : (coprimeSquarefreeIdealBall (quadraticMaskIdeal D) K) => H.val) (fun j => (cols j).val)
    (fun j => primaryIdealGenerator_ne_zero_ideal (cols j).val (cols j).property.1)
    N hN hcols A a r (fun E F j => canonicalQuadraticRow_norm_le_one (cols j) _)
  have hri : Function.Injective rows := fun H J h => Subtype.ext (congrArg (fun I : QuadraticIdeal => I.val) h)
  have hrows (H : (coprimeSquarefreeIdealBall (quadraticMaskIdeal D) K)) : (Ideal.absNorm (rows H).val : ℝ) ≤ K :=
    (mem_squarefreeIdealBall.mp (Finset.mem_filter.mp H.property).1).2
  have hA : ‖FiniteSieveOperator.operator A‖ ^ 2 ≤ sieveNorm K N :=
    family_squared_norm_le rows cols hri hinj K N hrows hcols
  apply hb.trans
  have hd := (DivisorBlockCauchy.divisorConstant_pos ε hε).le
  have hn := Real.rpow_nonneg hN ε
  gcongr

end CanonicalQuadraticSieve
end SchwartzPlanePoisson


namespace SchwartzPlanePoisson
open Eisenstein MeasureTheory
open scoped SchwartzMap

/-- Schwartz decay on the Eisenstein lattice gives absolute convergence over all ideals. -/
lemma radial_ideal_summable_norm (W : 𝓢(ℝ, ℂ)) (M : ℝ) (hM : 0 < M) :
    Summable (fun H : Ideal O => ‖W ((Ideal.absNorm H : ℝ) / M)‖) := by
  have h := (actual_eisenstein_summable_norm (scaledRadialTest W M hM)).comp_injective
    cubicIdealGenerator_injective
  simpa only [Function.comp_def, scaledRadialTest_apply, ringComplex_norm_sq_eq_absNorm_span, span_cubicIdealGenerator] using h

lemma quadraticSourcePair_summable (I J : QuadraticIdeal) (W : 𝓢(ℝ, ℂ)) (M : ℝ) (hM : 0 < M) :
    Summable (fun H : QuadraticSupportedIdeal =>
      (canonicalQuadraticRow I (primaryIdealGenerator H.val) * canonicalQuadraticRow J (primaryIdealGenerator H.val)) *
        W ((Ideal.absNorm H.val : ℝ) / M)) := by
  apply Summable.of_norm
  apply Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun H => ?_)
    ((radial_ideal_summable_norm W M hM).subtype quadraticSupported)
  rw [norm_mul, norm_mul]
  have hr : ‖canonicalQuadraticRow I (primaryIdealGenerator H.val)‖ *
      ‖canonicalQuadraticRow J (primaryIdealGenerator H.val)‖ ≤ 1 :=
    (mul_le_mul (canonicalQuadraticRow_norm_le_one I _) (canonicalQuadraticRow_norm_le_one J _)
      (norm_nonneg _) zero_le_one).trans_eq (one_mul 1)
  exact mul_le_of_le_one_left (norm_nonneg _) hr

/-- The pair kernel over all ideals supported away from two and three. -/
def quadraticSourcePair (I J : QuadraticIdeal) (W : 𝓢(ℝ, ℂ)) (M : ℝ) : ℂ :=
  ∑' H : QuadraticSupportedIdeal,
    (canonicalQuadraticRow I (primaryIdealGenerator H.val) * canonicalQuadraticRow J (primaryIdealGenerator H.val)) *
      W ((Ideal.absNorm H.val : ℝ) / M)

/-- Separating the square part leaves a squarefree character and a coprimality mask. -/
theorem quadraticSourcePair_squarefree (I J : QuadraticIdeal) (W : 𝓢(ℝ, ℂ)) (M : ℝ) (hM : 0 < M) :
    quadraticSourcePair I J W M =
      ∑' B : QuadraticIdeal, ∑' A : QuadraticSupportedIdeal,
        (canonicalQuadraticRow I (primaryIdealGenerator B.val) * canonicalQuadraticRow J (primaryIdealGenerator B.val)) *
          (quadraticIdealMask I (primaryIdealGenerator A.val) * quadraticIdealMask J (primaryIdealGenerator A.val)) *
            W (((Ideal.absNorm B.val : ℝ) * (Ideal.absNorm A.val : ℝ) ^ 2) / M) := by
  let f : QuadraticSupportedIdeal → ℂ := fun H =>
    (canonicalQuadraticRow I (primaryIdealGenerator H.val) * canonicalQuadraticRow J (primaryIdealGenerator H.val)) *
      W ((Ideal.absNorm H.val : ℝ) / M)
  have hs := quadraticSupportedPartsEquiv.symm.summable_iff.mpr (quadraticSourcePair_summable I J W M hM)
  change Summable (fun p : QuadraticIdeal × QuadraticSupportedIdeal => f (quadraticSupportedPartsEquiv.symm p)) at hs
  have he (p : QuadraticIdeal × QuadraticSupportedIdeal) :
      f (quadraticSupportedPartsEquiv.symm p) =
        (canonicalQuadraticRow I (primaryIdealGenerator p.1.val) * canonicalQuadraticRow J (primaryIdealGenerator p.1.val)) *
          (quadraticIdealMask I (primaryIdealGenerator p.2.val) * quadraticIdealMask J (primaryIdealGenerator p.2.val)) *
            W (((Ideal.absNorm p.1.val : ℝ) * (Ideal.absNorm p.2.val : ℝ) ^ 2) / M) := by
    change (canonicalQuadraticRow I (primaryIdealGenerator (p.1.val * p.2.val ^ 2)) *
      canonicalQuadraticRow J (primaryIdealGenerator (p.1.val * p.2.val ^ 2))) *
      W ((Ideal.absNorm (p.1.val * p.2.val ^ 2) : ℝ) / M) = _
    rw [canonicalQuadraticRow_squarefree_argument, canonicalQuadraticRow_squarefree_argument]
    simp only [map_mul, map_pow, Nat.cast_mul, Nat.cast_pow]
    ring
  change (∑' H, f H) = _
  rw [← quadraticSupportedPartsEquiv.symm.tsum_eq f, hs.tsum_prod]
  apply tsum_congr
  intro B
  apply tsum_congr
  intro A
  exact he (B, A)

end SchwartzPlanePoisson



namespace SchwartzPlanePoisson
open Eisenstein UniqueFactorizationMonoid

lemma ideal_coprime_prime_iff_not_dvd (I P : Ideal O) (hP : Prime P) :
    IsCoprime I P ↔ ¬ P ∣ I := by
  constructor
  · intro hc hd
    exact hP.2.1 (hc.isUnit_of_dvd' hd (dvd_refl P))
  · intro hn
    apply Ideal.isCoprime_iff_sup_eq.mpr
    by_contra ht
    have hmax := (Ideal.isPrime_of_prime hP).isMaximal hP.ne_zero
    have he := hmax.eq_of_le ht (le_sup_right : P ≤ I ⊔ P)
    exact hn (Ideal.dvd_iff_le.mpr (he.symm ▸ (le_sup_left : I ≤ I ⊔ P)))

lemma ideal_coprime_support_iff (I J : Ideal O) (hJ : J ≠ 0) :
    IsCoprime I J ↔ ∀ P ∈ primeSupport J, ¬ P ∣ I := by
  constructor
  · intro hc P hP hd
    exact (support_prime hP).2.1
      (hc.isUnit_of_dvd' hd (dvd_of_mem_normalizedFactors (Multiset.mem_toFinset.mp hP)))
  · intro h
    have hp : (∏ P ∈ primeSupport J, P ^ (normalizedFactors J).count P) = J := by
      change (∏ P ∈ (normalizedFactors J).toFinset, P ^ (normalizedFactors J).count P) = J
      rw [← Finset.prod_multiset_count]
      exact Ideal.prod_normalizedFactors_eq_self hJ
    rw [← hp]
    apply IsCoprime.prod_right
    intro P hP
    exact ((ideal_coprime_prime_iff_not_dvd I P (support_prime hP)).mpr (h P hP)).pow_right

lemma primeCoprimeMask_indicator {ι : Type*} (p : ι → O) (S : Finset ι) (z : O) :
    primeCoprimeMask p S z = if ∀ i ∈ S, ¬ p i ∣ z then 1 else 0 := by
  classical
  by_cases h : ∀ i ∈ S, ¬ p i ∣ z
  · rw [if_pos h]
    apply Finset.prod_eq_one
    intro i hi
    rw [if_neg (h i hi), sub_zero]
  · rw [if_neg h]
    push_neg at h
    obtain ⟨i, hi, hd⟩ := h
    exact Finset.prod_eq_zero hi (by rw [if_pos hd, sub_self])

lemma primeCoprimeMask_norm_le_one {ι : Type*} (p : ι → O) (S : Finset ι) (z : O) :
    ‖primeCoprimeMask p S z‖ ≤ 1 := by
  rw [primeCoprimeMask_indicator]
  split_ifs <;> norm_num

lemma primeCoprimeMask_unit_mul {ι : Type*} (p : ι → O) (S : Finset ι) (u : Oˣ) (z : O) :
    primeCoprimeMask p S ((u : O) * z) = primeCoprimeMask p S z := by
  have hd (i : ι) : p i ∣ (u : O) * z ↔ p i ∣ z := by
    constructor
    · intro h
      have hh := dvd_mul_of_dvd_right h ((u⁻¹ : Oˣ) : O)
      simpa only [← mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_mul] using hh
    · intro h
      exact dvd_mul_of_dvd_right h (u : O)
  simp only [primeCoprimeMask, hd]

lemma primeCoprimeMask_zero {ι : Type*} (p : ι → O) (S : Finset ι) (hS : S.Nonempty) :
    primeCoprimeMask p S 0 = 0 := by
  rw [primeCoprimeMask_indicator, if_neg]
  intro h
  exact h hS.choose hS.choose_spec (dvd_zero _)

lemma ideal_generator_dvd_iff (P : Ideal O) (z : O) :
    cubicIdealGenerator P ∣ z ↔ P ∣ Ideal.span {z} := by
  rw [Ideal.dvd_iff_le]
  conv_rhs => rw [← span_cubicIdealGenerator P]
  exact Ideal.span_singleton_le_span_singleton.symm

/-- An ideal prime mask is the indicator of coprimality with its product. -/
lemma primeIdealMask_indicator (S : Finset (Ideal O)) (hS : ∀ P ∈ S, Prime P) (z : O) :
    primeCoprimeMask cubicIdealGenerator S z =
      if IsCoprime (Ideal.span {z}) (∏ P ∈ S, P) then 1 else 0 := by
  have he : IsCoprime (Ideal.span {z}) (∏ P ∈ S, P) ↔ ∀ P ∈ S, ¬ P ∣ Ideal.span {z} := by
    constructor
    · intro hc P hP hd
      exact (hS P hP).2.1 (hc.isUnit_of_dvd' hd (Finset.dvd_prod_of_mem (fun Q => Q) hP))
    · intro h
      exact IsCoprime.prod_right (fun P hP =>
        (ideal_coprime_prime_iff_not_dvd (Ideal.span {z}) P (hS P hP)).mpr (h P hP))
  simp only [primeCoprimeMask_indicator, ideal_generator_dvd_iff, he]

lemma quadraticMask_coprime_iff (D A : Ideal O) (hD : D ≠ 0) :
    IsCoprime A (quadraticMaskIdeal D) ↔ quadraticSupported A ∧ IsCoprime A D := by
  have he : IsCoprime A (quadraticMaskIdeal D) ↔ ∀ P ∈ quadraticMaskPrimes D, ¬ P ∣ A := by
    constructor
    · intro hc P hP hd
      exact (quadraticMaskPrimes_prime D P hP).2.1
        (hc.isUnit_of_dvd' hd (Finset.dvd_prod_of_mem (fun Q => Q) hP))
    · intro h
      exact IsCoprime.prod_right (fun P hP =>
        (ideal_coprime_prime_iff_not_dvd A P (quadraticMaskPrimes_prime D P hP)).mpr (h P hP))
  rw [he, quadraticSupported_iff_bad_not_dvd, ideal_coprime_support_iff A D hD]
  simp only [quadraticMaskPrimes, Finset.mem_union, Finset.mem_insert, Finset.mem_singleton]
  constructor
  · intro h
    exact ⟨⟨h _ (Or.inl (Or.inl rfl)), h _ (Or.inl (Or.inr rfl))⟩,
      fun P hP => h P (Or.inr hP)⟩
  · rintro ⟨⟨hr, ht⟩, hd⟩ P (hp | hp)
    · rcases hp with rfl | rfl
      · exact hr
      · exact ht
    · exact hd P hp

lemma quadraticMask_generator_indicator (D A : Ideal O) (hD : D ≠ 0) :
    primeCoprimeMask cubicIdealGenerator (quadraticMaskPrimes D) (cubicIdealGenerator A) =
      if quadraticSupported A ∧ IsCoprime A D then 1 else 0 := by
  rw [primeIdealMask_indicator _ (quadraticMaskPrimes_prime D), span_cubicIdealGenerator]
  change (if IsCoprime A (quadraticMaskIdeal D) then (1 : ℂ) else 0) = _
  simp only [quadraticMask_coprime_iff D A hD]

end SchwartzPlanePoisson


namespace SchwartzPlanePoisson
open Eisenstein MeasureTheory
open scoped SchwartzMap

lemma quadraticIdealMask_indicator (I : QuadraticIdeal) (z : O) :
    quadraticIdealMask I z = if IsCoprime (Ideal.span {z}) I.val then 1 else 0 := by
  have hd (P : QuadraticPrime) : quadraticPrimeGenerator P ∣ z ↔ P.val ∣ Ideal.span {z} := by
    rw [Ideal.dvd_iff_le]
    conv_rhs => rw [← quadraticPrimeGenerator_span P]
    exact Ideal.span_singleton_le_span_singleton.symm
  have he : (∀ P ∈ quadraticIdealSupport I, ¬ quadraticPrimeGenerator P ∣ z) ↔
      IsCoprime (Ideal.span {z}) I.val := by
    rw [ideal_coprime_support_iff _ _ (primaryIdealGenerator_ne_zero_ideal I.val I.property.1)]
    simp only [hd]
    constructor
    · intro h P hP
      let Q := quadraticIdealPrimeIndex I ⟨P, hP⟩
      exact h Q ((mem_quadraticIdealSupport I Q).mpr hP)
    · intro h P hP
      exact h P.val ((mem_quadraticIdealSupport I P).mp hP)
  simp only [quadraticIdealMask, primeCoprimeMask_indicator, he]

lemma quadratic_joint_mask_generator (I J : QuadraticIdeal) (A : Ideal O) :
    primeCoprimeMask cubicIdealGenerator (quadraticMaskPrimes (I.val * J.val)) (cubicIdealGenerator A) =
      if quadraticSupported A then
        quadraticIdealMask I (primaryIdealGenerator A) * quadraticIdealMask J (primaryIdealGenerator A) else 0 := by
  have hIJ := mul_ne_zero (primaryIdealGenerator_ne_zero_ideal I.val I.property.1)
    (primaryIdealGenerator_ne_zero_ideal J.val J.property.1)
  rw [quadraticMask_generator_indicator _ _ hIJ]
  have hc : IsCoprime A (I.val * J.val) ↔ IsCoprime A I.val ∧ IsCoprime A J.val := by
    constructor
    · intro h
      exact ⟨h.mono (dvd_refl A) (dvd_mul_right I.val J.val),
        h.mono (dvd_refl A) (dvd_mul_left J.val I.val)⟩
    · rintro ⟨hI, hJ⟩
      exact hI.mul_right hJ
  by_cases hA : quadraticSupported A
  · rw [if_pos hA, quadraticIdealMask_indicator, quadraticIdealMask_indicator,
      (primaryIdealGenerator_spec A hA.1).1]
    by_cases hI : IsCoprime A I.val <;> by_cases hJ : IsCoprime A J.val <;> simp [hA, hc, hI, hJ]
  · simp only [hA, false_and, ite_false]

/-- The low squarefree part leaves a radial sum in the remaining square variable. -/
def quadraticLowPrincipalIdeal (I J : QuadraticIdeal) (W : 𝓢(ℝ, ℂ)) (X : ℝ) : ℂ :=
  ∑' A : QuadraticSupportedIdeal,
    (quadraticIdealMask I (primaryIdealGenerator A.val) * quadraticIdealMask J (primaryIdealGenerator A.val)) *
      W (((Ideal.absNorm A.val : ℝ) / X) ^ 2)

def quadraticLowPrincipalLattice (I J : QuadraticIdeal) (W : 𝓢(ℝ, ℂ)) (X : ℝ) : ℂ :=
  ∑' z : O, primeCoprimeMask cubicIdealGenerator (quadraticMaskPrimes (I.val * J.val)) z *
    W ((‖ringComplex z‖ ^ 2 / X) ^ 2)

/-- The full unit orbit converts the principal lattice sum exactly into its ideal sum. -/
theorem quadraticLowPrincipalLattice_eq (I J : QuadraticIdeal) (W : 𝓢(ℝ, ℂ))
    (X : ℝ) (hX : 0 < X) :
    quadraticLowPrincipalLattice I J W X = (Nat.card Oˣ : ℂ) * quadraticLowPrincipalIdeal I J W X := by
  let S := quadraticMaskPrimes (I.val * J.val)
  let V := quadraticSquareProfile W
  let f : O → ℂ := fun z => primeCoprimeMask cubicIdealGenerator S z * V (‖ringComplex z‖ ^ 2 / X)
  have hv : Summable (fun z : O => ‖V (‖ringComplex z‖ ^ 2 / X)‖) := by
    simpa only [scaledRadialTest_apply] using actual_eisenstein_summable_norm (scaledRadialTest V X hX)
  have hf : Summable f := by
    apply Summable.of_norm
    apply Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun z => ?_) hv
    dsimp only [f]
    rw [norm_mul]
    exact mul_le_of_le_one_left (norm_nonneg _) (primeCoprimeMask_norm_le_one _ _ _)
  have h0 : f 0 = 0 := by
    dsimp only [f]
    rw [primeCoprimeMask_zero _ _ ?_, zero_mul]
    exact ⟨ramifiedIdeal, Finset.mem_union_left _ (Finset.mem_insert_self _ _)⟩
  have hu (u : Oˣ) (z : O) : f ((u : O) * z) = f z := by
    dsimp only [f]
    rw [primeCoprimeMask_unit_mul, map_mul, norm_mul, norm_ringComplex_unit, one_mul]
  have he := tsum_unit_invariant_ideals f hf h0 hu
  have hn (A : Ideal O) : ‖ringComplex (cubicIdealGenerator A)‖ ^ 2 = (Ideal.absNorm A : ℝ) := by
    rw [ringComplex_norm_sq_eq_absNorm_span, span_cubicIdealGenerator]
  simp only [f, V, quadraticSquareProfile_apply, hn] at he
  have hi : (∑' A : NonzeroIdeal, primeCoprimeMask cubicIdealGenerator S (cubicIdealGenerator A.val) *
      W (((Ideal.absNorm A.val : ℝ) / X) ^ 2)) = quadraticLowPrincipalIdeal I J W X := by
    let F : Ideal O → ℂ := fun A => if quadraticSupported A then
      (quadraticIdealMask I (primaryIdealGenerator A) * quadraticIdealMask J (primaryIdealGenerator A)) *
        W (((Ideal.absNorm A : ℝ) / X) ^ 2) else 0
    calc
      _ = ∑' A : NonzeroIdeal, F A.val := by
        apply tsum_congr
        intro A
        rw [quadratic_joint_mask_generator]
        by_cases hA : quadraticSupported A.val <;> simp only [F, hA, ite_true, ite_false, zero_mul]
      _ = ∑' A : Ideal O, F A := by
        apply tsum_subtype_eq_of_support_subset
        intro A hA hz
        subst A
        exact hA (by simp [F, quadraticSupported, primaryIdealGenerator_zero])
      _ = _ := by
        change (∑' A : Ideal O, ({A | quadraticSupported A} : Set (Ideal O)).indicator
          (fun A => (quadraticIdealMask I (primaryIdealGenerator A) * quadraticIdealMask J (primaryIdealGenerator A)) *
            W (((Ideal.absNorm A : ℝ) / X) ^ 2)) A) = _
        exact (_root_.tsum_subtype _ _).symm
  rw [hi] at he
  exact he

end SchwartzPlanePoisson


namespace SchwartzPlanePoisson
open Eisenstein MeasureTheory
open scoped SchwartzMap

/-- Any polynomial tail gain survives summation over the Eisenstein lattice. -/
theorem paperRadialFourier_lattice_tail (A : ℕ) :
    ∃ (s : Finset (ℕ × ℕ)) (C : ℝ), 0 < C ∧
      ∀ (W : 𝓢(ℝ, ℂ)) (K T : ℝ), 0 < K → 0 ≤ T →
        (∑' z : {z : O // T ≤ K * ‖ringComplex z‖ ^ 2},
          ‖paperRadialFourier W (K * ‖ringComplex z.val‖ ^ 2)‖) ≤
          (C * s.sup (schwartzSeminormFamily ℝ ℝ ℂ) W) /
            ((min 1 K) ^ 2 * (1 + T) ^ A) := by
  obtain ⟨s, C, hC, hb⟩ := paperRadialFourier_source_weighted_bound (A + 2)
  refine ⟨s, C * (eisensteinCauchyMass + 1), by have := eisensteinCauchyMass_nonneg; positivity, ?_⟩
  intro W K T hK hT
  let B := C * s.sup (schwartzSeminormFamily ℝ ℝ ℂ) W
  let D := (min 1 K) ^ 2 * (1 + T) ^ A
  have hB : 0 ≤ B := by dsimp [B]; positivity
  have hD : 0 < D := by dsimp [D]; positivity
  have hp (z : {z : O // T ≤ K * ‖ringComplex z‖ ^ 2}) :
      ‖paperRadialFourier W (K * ‖ringComplex z.val‖ ^ 2)‖ ≤
        (B / D) * ((1 + ‖ringComplex z.val‖ ^ 2) ^ 2)⁻¹ :=
    polynomial_tail_majorant A K T _ B _ hK hT (sq_nonneg _) (norm_nonneg _)
      z.property (hb W _ (mul_nonneg hK.le (sq_nonneg _)))
  have hs := (paperRadialFourier_lattice_summable_norm W K hK).subtype
    (fun z => T ≤ K * ‖ringComplex z‖ ^ 2)
  calc
    _ ≤ ∑' z : {z : O // T ≤ K * ‖ringComplex z‖ ^ 2},
        (B / D) * ((1 + ‖ringComplex z.val‖ ^ 2) ^ 2)⁻¹ :=
      hs.tsum_le_tsum hp ((eisenstein_cauchy_summable.subtype _).mul_left (B / D))
    _ = (B / D) * ∑' z : {z : O // T ≤ K * ‖ringComplex z‖ ^ 2},
        ((1 + ‖ringComplex z.val‖ ^ 2) ^ 2)⁻¹ := tsum_mul_left
    _ ≤ (B / D) * eisensteinCauchyMass :=
      mul_le_mul_of_nonneg_left (eisensteinCauchyMass_subtype _) (div_nonneg hB hD.le)
    _ ≤ (B / D) * (eisensteinCauchyMass + 1) :=
      mul_le_mul_of_nonneg_left (by linarith) (div_nonneg hB hD.le)
    _ = _ := by dsimp only [B, D]; ring

end SchwartzPlanePoisson


