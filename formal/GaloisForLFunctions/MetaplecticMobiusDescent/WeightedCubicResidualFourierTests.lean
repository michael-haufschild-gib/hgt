    change IsCoprime K P.val at hP
    simp only [dif_pos hP]
    rw [Finset.sum_coe_sort nset (fun n : Ideal Eis => ∑ b : bset,
      r K*aw P.val*w n b.val*actualMixedCoefficient F K hK (S P.val) jF (D P hP) s hc u m n b.val)]
