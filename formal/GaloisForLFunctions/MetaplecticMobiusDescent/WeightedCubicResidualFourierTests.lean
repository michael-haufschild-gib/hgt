lemma fixedCoefficient_norm {m f z : Eis} (D : GoodMaskRowData m f z)
    (Ψ : Eis →* ℂ) (Q : Ideal Eis) (hΨ : ∀ n, ‖Ψ n‖ ≤ 1)
    (c : Eis) (hc : c ≠ 0) [Fintype (Eis ⧸ Ideal.span {c})]
    (h : Eis ⧸ Ideal.span {c}) :
