  norm_num [reopeningAuxiliaryScale,Real.rpow_natCast] at hs
  obtain ⟨hU,hKU,hellU,hBU,hFU,hHU,heU,hMU,hiU⟩:=hs
  have htail : (Cs*Z^4)*globalFirstTailFactor (Ksrc/Z^η) (X/B^3) (Real.exp 1*B) F
