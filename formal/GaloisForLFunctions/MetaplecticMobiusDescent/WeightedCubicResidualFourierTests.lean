    hR hη c₁ c₂ θ₁ θ₂ (zero_lt_one.trans_le hc₁) (zero_lt_one.trans_le hc₂) hsupport hn w
    (fun x hx=> hw x (Finset.mem_filter.mp (Finset.mem_filter.mp hx).1).1)
