theorem fixed_mask_change (η : Character) (Q : Ideal O) (m n A z : O)
    (hm:m≠0) (hn:n≠0) (hA:A≠0) (hz:z≠0)
    (hmLam:lambda∣m) (hm2:(2:O)∣m)
    (hnLam:lambda∣n) (hn2:(2:O)∣n) :
