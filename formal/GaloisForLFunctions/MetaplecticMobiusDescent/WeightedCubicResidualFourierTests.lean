      (s.character.modulus.absNorm:ℝ)≤ Z^q → Mrow+q+1≤ Lmod →
    ∀Q:Ideal O,s.fixedModulus=internalQ Q η₀ → Q≤ M →
    ∀(σ freq:ι→ℝ)(t V:ℝ),(∀i,lo≤σ i) → (∀i,σ i≤ hi) → 0≤ V → (∀i,|freq i|≤ V) →
    ∀(W₁ W₂:ℝ→ℂ)(X₁ X₂:ℝ),0< X₁ → 0< X₂ →
      let P:=fun i=> Z^(w i)
