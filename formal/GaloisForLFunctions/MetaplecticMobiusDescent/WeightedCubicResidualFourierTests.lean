theorem norm_tsum_of_finite_bound {α : Type*} (f : α→ℂ) (hf : Summable f) (B : ℝ)
    (hb : ∀F : Finset α,‖∑h∈F,f h‖≤ B) : ‖∑'h,f h‖≤ B := by
  exact le_of_tendsto hf.hasSum.norm (Filter.Eventually.of_forall hb)


