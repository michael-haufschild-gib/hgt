  obtain ⟨C₁,hC₁,he₁⟩:=hd (orientedLogProfile true V₁) hleftSmooth hleftSupport
  obtain ⟨C₂,hC₂,he₂⟩:=hd (orientedLogProfile false V₂) hV₂ hs₂
  obtain ⟨Z₀,hZ₀,hthreshold⟩:=canonicalInitialThreshold S
