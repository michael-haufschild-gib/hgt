  have hh:=hs.tsum_le_tsum (g:=fun z:O=> B^2*‖r.profile (‖ringComplex z‖^2/r.scale)‖) (fun z=> by
    split_ifs with hk
    · exact (mul_le_mul_of_nonneg_left (Complex.re_le_norm _) (sq_nonneg _)).trans
