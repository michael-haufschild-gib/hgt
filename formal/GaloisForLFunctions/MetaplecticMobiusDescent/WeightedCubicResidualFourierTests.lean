    (hr : ‖ringComplex (primeProduct p b.support b.rightExponent)‖^2≤ B) :
    primeProductNorm p b.support≤ B^2 :=
  (cube_whole_support_norm p hp b).trans ((mul_le_mul hl hr (sq_nonneg _) hB).trans_eq (pow_two B).symm)

