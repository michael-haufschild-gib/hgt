      ∫t:ℝ,density g xj t*kernelLogPhase t xc*
        indexedIdealMark primes I L (fun i p=> a i p*kernelLogPhase (-t) (y i p)) c := by
  simp_rw [indexed_mark_active]
  rw [←overlap_tuple_separation]
  apply Finset.sum_congr rfl
  intro p hp
