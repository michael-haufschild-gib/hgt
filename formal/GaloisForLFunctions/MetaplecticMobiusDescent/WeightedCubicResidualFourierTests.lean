theorem exists_zero_floor (a b bΦ Bmask ε:ℝ)(ha:0< a)(hb:0≤ b)
    (hbΦ:0< bΦ)(hmask:0≤ Bmask)(hε:0<ε):
    ∃degree:ℕ,∃S:Finset (ℕ×ℕ),∃C:ℝ,0< C ∧
      ∀Q:Ideal Eisenstein.O,ZeroBound Q a b bΦ Bmask (ε/16) ε degree S C 1:=by
