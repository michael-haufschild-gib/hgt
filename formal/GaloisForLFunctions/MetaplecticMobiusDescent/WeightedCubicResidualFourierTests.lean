lemma deleted_short_length (Z M:ℝ)(hZ:1< Z)(hM:0≤ M)
    (D:Finset (Ideal O))(hD:∀I∈D,Prime I):
    length Z (comparisonFirst Z M/((∏I∈D,I).absNorm:ℝ))≤ M/4:=by
