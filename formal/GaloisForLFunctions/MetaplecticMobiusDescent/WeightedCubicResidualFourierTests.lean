theorem common_gain_width (d x c w wo sigma delta reserve branch : ℝ)
    (hs : 0≤ sigma) (hd : 0≤ delta) (hr : 0≤ reserve) (hb : 1≤ branch)
    (hx : -delta≤ x) :
    0≤ x+max (d-c-2*w+wo) 0+branch*sigma+delta+reserve ∧
    (d+x)-c-2*w+wo+sigma≤
