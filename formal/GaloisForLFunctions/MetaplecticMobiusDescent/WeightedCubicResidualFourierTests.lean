lemma original_residual_norm_bounds (rows : Finset (Ideal Eis)) (J Q : Ideal Eis)
    (hbad : ∀ P∈fixedBadPrimes,P∣Q) (U : ℝ)
    (hrows : ∀ I∈rows,I≠0 ∧ (Ideal.absNorm I:ℝ)≤ U) :
    ∀ K∈originalResidualRows rows J Q,
