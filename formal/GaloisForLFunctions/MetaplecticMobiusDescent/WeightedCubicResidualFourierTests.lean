    _ ≤ ∏ i : ι, (1 : ℝ) := Finset.prod_le_prod (fun _ _ => norm_nonneg _)
      (fun i _ => finiteMulChar_norm_le_one
        (complexSexticChar (P i) (hg i) ^ j i) _)
    _ = 1 := by simp


