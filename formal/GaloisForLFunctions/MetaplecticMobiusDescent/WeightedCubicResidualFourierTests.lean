    let Q := HeckePrimeRow.canonicalPrimeAmplitude M H data.u W B ((Z^d)^r) z
    let g := amplitude ((Z^d)^r) (a-1/2) mesh Q
    0≤ g ∧ g≤ a-1/2 ∧ g∈labels (a-1/2) mesh ∧
