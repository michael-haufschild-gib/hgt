      (hr : Supported (Ideal.span {r})),k=u.val*lambda^a*(2:O)^b*r→
      ∀(P : ι→ Id)[_hmax : ∀i,(P i).IsMaximal](hg : ∀i,lambda∉P i)(c : ι→ℕ),
      (∀i,1≤ c i)→ Ideal.span {C}=∏i,P i^c i→
      ∀(p : Id)[_hpmax : p.IsMaximal],p≠0→∀_hgp : lambda∉p,
