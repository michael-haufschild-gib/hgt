  trans ∑' _ : Ideal O,(0:ℂ)
  · apply tsum_congr
    intro I
    by_cases hi:I=0
    · subst I
      simp
    rw [if_neg (not_lt.mpr (ht.trans (norm_at_least_one I hi)))]
  · exact tsum_zero

