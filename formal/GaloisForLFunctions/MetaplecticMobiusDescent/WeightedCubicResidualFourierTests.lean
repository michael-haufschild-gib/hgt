        Real.logb Z ((∏P∈U,P.val).absNorm:ℝ)+
        Real.logb Z (16*(CenteredMomentSecondRadicalBudget.fixedFactor:ℝ)):=by
  exact dyadic_log_budget h t S β radius rows W K hK n hne Z hZ χ

