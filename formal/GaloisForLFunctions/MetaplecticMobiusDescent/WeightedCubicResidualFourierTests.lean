    intro i;fin_cases i
    · exact rawScale_pos D a X₁ hX₁ 0
    · exact rawScale_pos D a X₂ hX₂ 1
  have hh:=hz s hQ hwidth (retainedPair lo hi hlo p U hU t) 0
