  rw [heq]
  calc
    _≤∑χ:RayCharacter,∑ξ:RayCharacter,‖pairCoeff (phaseTable D E) χ ξ‖*(C*E0):=by
      have hh:=weighted_norm_sum Finset.univ (fun _:RayCharacter=>(1:ℂ))
