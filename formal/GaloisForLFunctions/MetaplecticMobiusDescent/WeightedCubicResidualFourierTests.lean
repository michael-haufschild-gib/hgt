    congr 1
    apply tsum_congr
    intro i
    by_cases hi : i∈retainedDyads (familyRawScale F s X QK QP) (16*T) <;> simp [hi]
  apply hleft.trans
  have hnorm := reflected_norm_le_centers F K hK S QK QP hKr hPr
  gcongr
end
