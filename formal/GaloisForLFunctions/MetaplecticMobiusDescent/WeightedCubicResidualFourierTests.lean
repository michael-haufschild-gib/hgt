      fun x hx=> hswhole.2.2 x (hpoint hx)⟩
  rw [physicalBlock_coprimeSource p hp hcop hg hprimary Finset.univ _ hdivw hfw]
  by_cases hempty:physicalBlock p hg (pointSource Finset.univ Sc) (w∘erasePoint) Ψ
