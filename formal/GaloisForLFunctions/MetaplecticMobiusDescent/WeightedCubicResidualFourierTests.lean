    (fun t=>(complexSexticChar (Ideal.span {p i}) (hg i)^j i) t) (v i)

noncomputable def multiplierSum (D:ControlledStratumArithmetic p N a0 c0 mode)
    [∀i,(Ideal.span {p i}).IsMaximal]
