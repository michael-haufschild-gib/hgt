theorem ray_prime_bin_bound (W : ℝ→ℂ) (A B : ℝ) (hA : 0< A)
    (hWs : Function.support W⊆Icc A B) (hW : ContDiff ℝ ∞ W)
    (R dmax τ ε e κ η σmin σmax : ℝ)
