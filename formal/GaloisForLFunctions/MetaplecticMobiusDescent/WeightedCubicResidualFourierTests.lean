theorem original_pool_restriction (C D:Ideal O)(hC:C≠0)(hD:D≠0)
    (S:Finset (Ideal O))(f:Ideal O→Ideal O→ℂ):
    (∑a∈residualPool C hC (supportedColumns S),∑b∈residualPool D hD (supportedColumns S),
