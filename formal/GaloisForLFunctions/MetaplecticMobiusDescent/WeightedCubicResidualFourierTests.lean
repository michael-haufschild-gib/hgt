lemma plain_capacity_bound {m κ : ℝ} (hm : 1/3≤ m) (hm' : m≤1/2) (hκ : 3/4≤κ) :
    0≤(1-2*m)/(6*κ) ∧ (1-2*m)/(6*κ)≤2/27 := by
