    ∃C : ℝ,0< C ∧ ∀k : ℕ,k≤ N → ∀(u : FreeRow) (T : Fin k→ Finset HeckeIdealSeries.PrimeIdeal)
      (W : Fin k→ℝ→ℂ) (Y : Fin k→ℝ),
