theorem markedIdealHighSummand_summable (S : Finset Id) (D : Id) (η : HeckeFamily.Character)
    (u : O) (x w z : ℂ) (hx : 3/2< x.re) (hw : 2< w.re) (hz : 1/6< z.re) :
