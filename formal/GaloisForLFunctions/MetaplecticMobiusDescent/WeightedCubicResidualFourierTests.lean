    actualSecondProfileRow p hg F x slots₁ slots₂ lists₁ lists₂ a₁ a₂ W₁ W₂ Φ Y X=0 := by
  rw [actualSecondProfileRow_eq_whole p hp hg]
  apply Finset.sum_eq_zero
