  obtain ⟨N,hN,hterminal⟩ := reopening_terminal_order η 0 hη
  obtain ⟨w₁,w₂,Cf,C₁,Cd₁,Ct₁,C₂,Cd₂,Ct₂,Clo,Chi,Vmax₁,Vmax₂,
