      sexticReciprocityPhase_comm n₁ m₂,
      sexticReciprocityPhase_congr_right m₂ n₁ m₁ (hfour _ _ h₁),
      sexticReciprocityPhase_comm m₂ m₁]
  simp only [jointFixed,hc₁,hc₂,hb₁,hb₂,hp]

