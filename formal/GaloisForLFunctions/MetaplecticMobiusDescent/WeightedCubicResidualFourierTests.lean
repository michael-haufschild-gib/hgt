  have hCpow : 0 ≤ Cpow:=by dsimp [Cpow]; positivity
  refine ⟨w₁,w₂,Cbase*Cpow,mul_nonneg hCbase hCpow,hwc₁,hws₁,hwb₁,hwc₂,hws₂,hwb₂,?_⟩
