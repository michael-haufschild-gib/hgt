theorem error_declared_width (θ:Character)(χ₀:RayCharacter)(p:O)(hp:p≠0)
    (k:ℕ)(hk:k=0∨k=5∨k=6)
    (hN:θ.modulus.absNorm≤ radicalBound (childCharacter ρ χ₀) fixedBadMask p (errorMovingExponent k))
