    (hs : (7/8:ℝ)< s.re) (hpole : s≠1 ∨ χ.residue≠1) : LFunction χ s≠0 :=
  HeckeCommonProbe.hecke_ne_zero_of_common_probe (common_probe_of_raw_moments hmom) χ s hs hpole

