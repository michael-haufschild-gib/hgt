lemma canonical_mask_norm_cap (B F R : Ideal Eis) (Z V Q L : ℝ)
    (hZ : 1≤ Z) (hB : (Ideal.absNorm B:ℝ)≤ Z)
    (hF : (Ideal.absNorm F:ℝ)≤ Z^V) (hR : (Ideal.absNorm R:ℝ)≤ Z^Q)
    (hV : V≤ L) (hQ : Q≤ L) :
