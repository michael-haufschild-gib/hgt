  have hcap:=CenteredMomentFirstPhysicalDyadicCount.input_radius_cap hi b₁ b₂ B Z s hhi hb₁ hb₂ hblock.1.le hfixed hV
  have hpblock (p:Labels s R seed)(E:Finset (CommonIndex p.val.1 p.val.2))
