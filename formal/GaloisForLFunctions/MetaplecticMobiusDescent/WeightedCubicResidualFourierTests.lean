theorem childLogTest_physical_profiles (W:ℝ→ℂ)(θ:ℝ):
    (fun x=> star (childLogTest W θ x))=clippedSource (fun x=> star (W x)) 1 (-θ) ∧
    childLogTest W θ=clippedSource W 1 θ:=by
