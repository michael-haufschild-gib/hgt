    exact (mul_le_mul h₁ h₂ (norm_nonneg _) (by positivity)).trans_eq (by dsimp [B];ring)
  have hh:=radial_bound_on_keep _ r B hB hp
  exact hh.trans_eq (by dsimp [B];ring)

