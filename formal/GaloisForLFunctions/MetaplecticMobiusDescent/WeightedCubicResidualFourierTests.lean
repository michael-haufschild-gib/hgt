theorem balanced_endpoint_with_loss {δ x R loss : ℝ}
    (hδ : 0≤δ) (hδ' : δ≤5/6) (hx : 0≤ x) (hx' : x≤1/2)
    (hR : R≤ max (shortExponent δ x (Endpoint.balancedCutoff δ (1/2-x)))
