    (hx : (101/200:ℝ)≤ x.re) (hz : (27/80:ℝ)≤ z.re) :
    AnalyticOnNhd ℂ (fun w=> unramifiedProduct S η u x w z)
      {w : ℂ | max (-(3/200:ℝ)) (1+eps-x.re)< w.re} := by
