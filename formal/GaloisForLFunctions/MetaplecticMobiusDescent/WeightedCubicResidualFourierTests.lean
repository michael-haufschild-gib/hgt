        (V₁.profile _ (rawScale_pos D a X₁ hX₁ 0) t)
        (V₂.profile _ (rawScale_pos D a X₂ hX₂ 1) t)
        (clippedScale (rawScale D a X₁ 0)/(Ideal.absNorm (∏I∈D₁,I):ℝ))
        (clippedScale (rawScale D a X₂ 1)/(Ideal.absNorm (∏I∈D₂,I):ℝ)) r:=by
