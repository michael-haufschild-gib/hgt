      ((supported_span_primaryIdealGenerator_iff _).mpr J.property) h.val*
      paperRadialFourier U (Q*‖ringComplex h.val‖^2/‖ringComplex (primaryIdealGenerator I.val*primaryIdealGenerator J.val)‖^2))
