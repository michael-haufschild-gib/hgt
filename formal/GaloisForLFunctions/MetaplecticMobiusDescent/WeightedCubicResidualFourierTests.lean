theorem literal_nonexceptional_block (A : ℕ) (hA : 2< A) (a₀ b₀ : ℝ)
    (ha₀ : 0< a₀) (hab : a₀< b₀) :
    ∃H : Finset (ℕ×ℕ),∃K : ℝ,0< K ∧
      ∀{ι : Type*}[Fintype ι],∀(S : Finset Id)(hS : ∀p∈S,p.IsMaximal)(σ : RayRing)
