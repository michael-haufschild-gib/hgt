theorem eventually_twice_ready (N:ℕ)(b b₁ b₂ ε:ℝ)
    (hb:1≤ b)(hb₁:1≤ b₁)(hb₂:1≤ b₂)(hε:0<ε):
    ∀ᶠZ:ℝ in atTop,1< Z ∧ ∀{ι:Type*}[Fintype ι],∀s:Input ι,
