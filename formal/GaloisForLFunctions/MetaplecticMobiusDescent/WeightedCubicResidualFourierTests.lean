  let prims := poissonPrimitiveConstants sD sS sT CD CS CT CP hexp η hη D W ++
    [(Ideal.absNorm G:ℝ) ^ η,K ^ η,N ^ η,((2*K)*N) ^ η,(N*N) ^ η,
      ((Ideal.absNorm G:ℝ)*(N*N)) ^ η,(K*N) ^ η]
  have hprims : ∀x∈prims, 0 ≤ x ∧ x ≤ V := by
