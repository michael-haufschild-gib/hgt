theorem indexed_height_bound (i I : ℕ) (hi : i≤ I) (T : ℝ) (hT : 0≤ T) :
    (3+(3*i+2 : ℕ)*T)^4≤(3*(I : ℝ)+5)^4*(1+T)^4 := by
