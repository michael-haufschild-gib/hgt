  W := fun i=> s.W (e.symm i)
  lo := fun i=> s.lo (e.symm i)
  hi := fun i=> s.hi (e.symm i)
  P := fun i=> s.P (e.symm i)
  lo_pos := fun i=> s.lo_pos (e.symm i)
  P_pos := fun i=> s.P_pos (e.symm i)
  support := fun i=> s.support (e.symm i)
