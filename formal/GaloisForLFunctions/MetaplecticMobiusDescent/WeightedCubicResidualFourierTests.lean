lemma original_long_positive (Z M X₁ X₂ ell κ:ℝ)(hZ:1< Z)(hM:0< M)
    (_hX₁:0< X₁)(hX₂:0< X₂)(hell:0≤ ell)(hκ:3/4≤κ)
    (hshort:length Z X₁≤ M/4)
    (hlarge:5*M/6≤ length Z X₁+length Z X₂+ell)
    (hcap:length Z X₁+length Z X₂+6*κ*ell≤ M):
