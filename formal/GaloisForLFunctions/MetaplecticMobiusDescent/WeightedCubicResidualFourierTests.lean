lemma fixedFourierCoefficient_norm (Ψ : O→*ℂ) (Q : Ideal O) (c : O) (hc : c≠0)
    (hspan : Ideal.span {c}=Q*Ideal.span {(72:O)})
    (hΨ : ∀x y : O,x-y∈Q→Ψ x=Ψ y) (hn : ∀n,‖Ψ n‖≤1)
