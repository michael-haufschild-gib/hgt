            (frozenControl B.val s.M)^2*childNormalizedGaussSource s C R L B τ t W K
          else 0):=by
      apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
      apply Finset.sum_le_sum
      intro B hB
