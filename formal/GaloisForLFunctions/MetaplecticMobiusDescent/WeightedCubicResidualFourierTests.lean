    (hC : 0≤ C) (hU : 1≤ U) (hδ : 5/6≤δ) (hδ' : δ≤1)
    (hγ : 0≤γ) (hr : 1-γ≤ r)
    (hI : B≤ C*U^(max 1 ((1+5*r)/6)-δ*r+ε)) :
    B≤ C*U^(1-δ+ε+γ) := by
