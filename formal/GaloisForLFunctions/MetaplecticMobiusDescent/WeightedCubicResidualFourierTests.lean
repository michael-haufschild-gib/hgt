    ext t
    change (|t.1.1|≤ H ∧ ¬(|t.1.1|≤ H ∧ |t.2|≤ H)) ↔ (|t.1.1|≤ H ∧ H < |t.2|)
    constructor
    · rintro ⟨hx,hw⟩
      exact ⟨hx,lt_of_not_ge (fun h=> hw ⟨hx,h⟩)⟩
    · rintro ⟨hx,hw⟩
