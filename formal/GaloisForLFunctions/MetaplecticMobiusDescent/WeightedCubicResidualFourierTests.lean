  have hh := Nat.le_ceil ((49/100:ℝ)/e)
  have hmul := (div_le_iff₀ he).mp hh
  push_cast
  nlinarith

theorem source_cube_height_eventually (τ : ℝ) (hτ : 0<τ) :
