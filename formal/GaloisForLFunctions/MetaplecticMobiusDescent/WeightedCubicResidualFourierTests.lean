theorem raw_family_uniform (J : ℕ) :
    ∃K : ℕ,∃C : ℝ,0< C ∧ ∀(data : RowData)(c κ A : ℝ),0≤ A →
      (∀s,RawMoment data (childLogTest referenceWindow s) c κ (A*(1+‖s‖)^(2*J))) →
