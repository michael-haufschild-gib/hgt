    (mul_nonneg hΓ hC) hE hU hK hell hB hF hH hKU hellU hBU hHU heU hZ hA hV hV₁ hV₂ hVs₁ hVs₂
    hΨ hk hb₁' hb₂' he
  have hI:0≤∫t:ℝ,firstLogDensity 0 t:=integral_nonneg (fun t=>firstLogDensity_nonneg 0 t)
