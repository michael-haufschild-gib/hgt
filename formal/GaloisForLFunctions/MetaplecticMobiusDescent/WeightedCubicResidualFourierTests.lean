theorem HasSieveExponent.ball_selected_high {α : ℝ} (hexp : HasSieveExponent α)
    (hα1 : 1 ≤ α) (hα2 : α ≤ 2) (η : ℝ) (hη : 0 < η) (hη1 : η ≤ 1)
    (l A : ℕ) (hl : 4 ≤ η*l) (hA : 4 ≤ η*A) :
    ∃ C : ℝ, 0 < C ∧ ∀ (M N : ℝ),
      1 ≤ M → 28 ≤ N → N ^ (2-1/α) ≤ M →
