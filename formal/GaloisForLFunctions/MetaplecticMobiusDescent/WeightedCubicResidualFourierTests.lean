lemma paid_seed_power (Z Bseed saving seedNorm : ℝ) (hZ : 0< Z)
    (hs : 0< seedNorm) (hcap : seedNorm≤ Z^Bseed) :
    Z^(-(saving+Bseed))≤ Z^(-saving)/seedNorm := by
  apply (le_div_iff₀ hs).mpr
