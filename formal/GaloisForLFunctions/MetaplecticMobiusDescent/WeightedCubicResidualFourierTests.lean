    fun z hz=>⟨(hT z hz).1,(hT z hz).2.1,(hT z hz).2.2.1,(hT z hz).2.2.2.1⟩
  have hstate₁:=initialCanonicalState p hp (∏P∈S,P) base Ψ₁ hΨ₁
    Z (canonicalDescentPadding ε) X F K hZ.le hη hX hF hK R T hmass hinv hlab
