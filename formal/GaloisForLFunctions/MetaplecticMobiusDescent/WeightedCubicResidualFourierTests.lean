    apply mul_le_mul
    · exact mul_le_mul (mul_le_mul_of_nonneg_right hC hA)
        (by linarith only : mL ≤ 1+mL) hmL (mul_nonneg hCcap hA)
    · linarith only
    · exact hmR
    · positivity
