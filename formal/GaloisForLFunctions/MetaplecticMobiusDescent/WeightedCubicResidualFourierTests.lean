  have hZi:Zchoice ⟨⟨Jparent,Jorig⟩,θ⟩≤ Z:=by
    have hh:=Finset.single_le_sum (s:=Finset.univ)
      (fun c _=>(zero_lt_one.trans (hZchoice c)).le) (Finset.mem_univ (⟨⟨Jparent,Jorig⟩,θ⟩:Choices))
    dsimp [Z₀] at hZ
