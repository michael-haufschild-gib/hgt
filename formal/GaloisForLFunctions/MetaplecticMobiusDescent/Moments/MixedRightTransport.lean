/-- Completed weights depend only on values at primary generators. -/
lemma columnWeight_congr_primary (Ψ Φ : O →* ℂ)
    (h : ∀n : O, lambda^2 ∣ n-1 → Ψ n=Φ n) (I : Ideal O) :
    columnWeight Ψ I=columnWeight Φ I := by
  by_cases hi : primaryIdealGenerator I=0
  · simp only [columnWeight, squarefreeGaussCoefficient_of_primary_zero I hi, zero_mul]
  · rw [columnWeight, columnWeight, h _ (primaryIdealGenerator_spec I hi).2]

lemma cubeWeight_congr_primary (Ψ Φ : O →* ℂ)
    (h : ∀n : O, lambda^2 ∣ n-1 → Ψ n=Φ n) (I : Ideal O) :
    cubeWeight Ψ I=cubeWeight Φ I := by
  change star (CompletedGauss.angularFactor (primaryIdealGenerator I))^3 *
      Ψ (primaryIdealGenerator I)^3 / (Ideal.absNorm I : ℂ) =
    star (CompletedGauss.angularFactor (primaryIdealGenerator I))^3 *
      Φ (primaryIdealGenerator I)^3 / (Ideal.absNorm I : ℂ)
  by_cases hi : primaryIdealGenerator I=0
  · simp only [hi, CompletedGauss.angularFactor, map_zero, norm_zero,
      Complex.ofReal_zero, div_zero, star_zero, zero_pow (by decide : (3:ℕ)≠0),
      zero_mul, zero_div]
  · rw [h _ (primaryIdealGenerator_spec I hi).2]
end CompletedGauss

