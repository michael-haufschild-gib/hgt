    dsimp [Cbound];linarith
  have hZZ (Aorig:Finset α):Zj Aorig≤ Z₀:=by
    have hh:=Finset.single_le_sum (fun A (_:A∈(Finset.univ:Finset (Finset α)))=> abs_nonneg (Zj A))
