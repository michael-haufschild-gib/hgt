      (fun i I => idealCoeff (relativeCharacter Q H hH η₀ (θ i)) I *
        annularWeight W (Z^(w i)) (σ i) (freq i) I)
      (fun i => Z^(w i)) X₁ X₂
      state.radial.keep state.radial.profile state.radial.scale := rfl

theorem reference_energy_eq :
