    (hκ:3/4≤κ)(hxi:0≤ xi)(he:0≤ e)(hreserve:xi+11*e/7≤ s.width/14)
    (hlarge:5*s.width/6-e≤ Real.logb Z (X₁*X₂)+ell)
    (hcap:Real.logb Z (X₁*X₂)+ell+(6*κ-1)*ell≤ s.width)
