namespace ProbeFinalAssemblyUnconditional

/-- Dirichlet L-functions are nonzero to the right of seven eighths, away from the principal pole. -/
theorem dirichlet_nonzero (q : ℕ) (hq : q ≠ 0) (χ : DirichletCharacter ℂ q) (s : ℂ)
    (hs : (7/8 : ℝ) < s.re) (hexc : ¬(χ = 1 ∧ s = 1)) :
    letI : NeZero q := ⟨hq⟩
    DirichletCharacter.LFunction χ s ≠ 0 := by
  letI : NeZero q := ⟨hq⟩
  exact HeckeDirichlet.dirichlet_seven_eighths_of_hecke hecke_nonzero χ s hs hexc

/-- The zeta function is nonzero to the right of seven eighths. -/
theorem zeta_nonzero (s : ℂ) (hs : (7/8 : ℝ) < s.re) : riemannZeta s ≠ 0 :=
  HeckeDirichlet.zeta_seven_eighths_of_hecke hecke_nonzero s hs

end ProbeFinalAssemblyUnconditional

theorem riemannZeta_ne_zero_of_seven_eighths_lt_re {s : ℂ}
    (hs : (7/8 : ℝ) < s.re) : riemannZeta s ≠ 0 :=
  ProbeFinalAssemblyUnconditional.zeta_nonzero s hs

namespace DirichletCharacter

theorem LFunction_ne_zero_of_seven_eighths_lt_re {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) {s : ℂ} (hs : (7/8 : ℝ) < s.re)
    (hpole : ¬(χ = 1 ∧ s = 1)) : _root_.DirichletCharacter.LFunction χ s ≠ 0 :=
  ProbeFinalAssemblyUnconditional.dirichlet_nonzero q (NeZero.ne q) χ s hs hpole

end DirichletCharacter

