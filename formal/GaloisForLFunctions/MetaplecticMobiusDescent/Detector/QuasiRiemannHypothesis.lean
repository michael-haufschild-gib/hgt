noncomputable section

/-- The functional equation transfers right-half-plane nonvanishing to the left
edge of the critical strip. -/
theorem riemannZeta_ne_zero_of_re_lt_one_eighth {s : ℂ}
    (h0 : 0 < s.re) (h1 : s.re < (1/8 : ℝ)) : riemannZeta s ≠ 0 := by
  intro hzero
  have hs0 : s ≠ 0 := by
    intro hs
    simpa only [hs, Complex.zero_re, lt_self_iff_false] using h0
  have hΓ : Complex.Gammaℝ s ≠ 0 := Complex.Gammaℝ_ne_zero_of_re_pos h0
  have hcompleted : completedRiemannZeta s = 0 := by
    have hz := (riemannZeta_def_of_ne_zero hs0).symm.trans hzero
    exact (div_eq_zero_iff.mp hz).resolve_right hΓ
  have hsub : (1 : ℂ) - s ≠ 0 := by
    intro hs
    have he : s = 1 := (sub_eq_zero.mp hs).symm
    rw [he, Complex.one_re] at h1
    norm_num at h1
  have hreflect : riemannZeta (1 - s) = 0 := by
    rw [riemannZeta_def_of_ne_zero hsub, completedRiemannZeta_one_sub,
      hcompleted, zero_div]
  apply riemannZeta_ne_zero_of_seven_eighths_lt_re (s := 1 - s) _ hreflect
  simp only [Complex.sub_re, Complex.one_re]
  linarith only [h1]

/-- Every zeta zero with positive real part lies between one eighth and seven
eighths, including the boundary. -/
theorem riemannZeta_zero_mem_quasiRH_strip {s : ℂ}
    (h0 : 0 < s.re) (hzero : riemannZeta s = 0) :
    s.re ∈ Set.Icc (1/8 : ℝ) (7/8 : ℝ) := by
  constructor
  · exact le_of_not_gt fun hs => riemannZeta_ne_zero_of_re_lt_one_eighth h0 hs hzero
  · exact le_of_not_gt fun hs => riemannZeta_ne_zero_of_seven_eighths_lt_re hs hzero

end

