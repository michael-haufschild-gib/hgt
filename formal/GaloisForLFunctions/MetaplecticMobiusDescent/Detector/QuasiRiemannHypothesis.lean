/-- Capped width induction proves the detector bands for the chosen source profiles. -/
theorem detector_certified_bands:DetectorCertifiedBands:=by
  intro hβ D _hfine F bΦ hbΦ
  have hp:=fixed_parameters D
  apply terminal_certificate (α:=Fin D.N) F.modulus ⊤ le_top
    (fun x=> conj (F.W x)) 1 2 (1/4) (9/4) bΦ 0 1 (33/50) (33/50) 2
      (kappaPlain D) (stageError D)
  · norm_num
  · exact conjugate_source_support F
  · exact Complex.conjCLE.contDiff.comp (F.W.smooth (⊤ : ℕ∞))
  · norm_num
  · norm_num
  · norm_num
  · norm_num
  · exact hbΦ
  · norm_num
  · norm_num
  · exact hp.2.2.2.2.1.le
  · exact hp.2.2.1
  · linarith
  · unfold kappaPlain
    linarith


/-- Concrete source estimates produce the common probe without a moment assumption. -/
theorem common_probe : HeckeCommonProbe.UniformCommonProbe :=
  common_probe_of_chosen_moments (chosen_moments_of_certified detector_certified_bands)

/-- Every Hecke L-function is nonzero to the right of seven eighths, away from its pole. -/
theorem hecke_nonzero (χ : HeckeFamily.Character) (s : ℂ)
    (hs : (7/8:ℝ) < s.re) (hpole : s ≠ 1 ∨ χ.residue ≠ 1) :
    HeckeFamily.LFunction χ s ≠ 0 :=
  HeckeCommonProbe.hecke_ne_zero_of_common_probe common_probe χ s hs hpole

end ProbeFinalAssemblyUnconditional
