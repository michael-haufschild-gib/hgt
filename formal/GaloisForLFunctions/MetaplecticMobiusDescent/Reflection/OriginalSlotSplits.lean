theorem original_source_cost {χ : Type*} [Fintype χ] (rmax : ℕ) (ε : ℝ) (hε : 0<ε) :
    ∃ C : ℝ,0< C ∧ ∀ {σ : Type*} [Fintype σ] (H : σ→ℝ),
