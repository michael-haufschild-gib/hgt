noncomputable section
open Eisenstein

namespace SchwartzPlanePoisson

/-- The trace-normalized dual lattice frequency, for the chosen complex embedding. -/
def explicitDualFrequency (c : ℂ) (p : ℤ × ℤ) : ℂ :=
  paperFrequency (ringComplex (dualFrequencyEquiv p) / c)

theorem explicitDualFrequency_norm_sq (c : ℂ) (p : ℤ × ℤ) :
    ‖explicitDualFrequency c p‖ ^ 2 =
      (4 / 3 : ℝ) * ‖ringComplex (dualFrequencyEquiv p)‖ ^ 2 / ‖c‖ ^ 2 := by
  rw [explicitDualFrequency, paperFrequency_norm_sq, norm_div, div_pow]
  ring

end SchwartzPlanePoisson
