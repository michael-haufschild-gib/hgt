import GaloisForLFunctions.MultiplicativePositivityGeometry.AbelianZeroMass
import GaloisForLFunctions.MultiplicativePositivityGeometry.GrowthToForcing

/-!
# Siegel's exception is two-torsion

For a family `(Z_g)_{g ∈ G}` over a finite abelian group with nonnegative joint log-coefficients,
the joint trace `T_δ(g, u)` at abscissa `1 + δ` is positive definite on `G × ℝ`. A real zero of the
members `±g` at `β = 1 − η` enters the Gram forms of `T_δ` on the cyclic group generated by
`(g, 0)`:

* if `2g ≠ 0`, the members `g` and `−g` are distinct and both vanish at `β`; the all-ones vector on
  the cyclic group gives `T(0) + Σ_{k≠0} T(kg) ≥ 0` (`cyclic_fibre_sum_nonneg`), in which the zero is
  counted twice: purchase ratio `2`, the universal cap, attained, and a zero-free interval of
  width `(√2 − 1)²/G` (`paired_real_zero_width`);
* if `2g = 0`, the cyclic group is `{0, g}` and the only constraint is `|T(g)| ≤ T(0)`: purchase
  ratio `1`, the degree-one barrier, which excludes nothing (`unpaired_real_zero_unexcluded`).

**The exception occurs at every depth** (`siegel_isJointBoundaryDivisor`, `siegel_member_zero`).
For `h` with `2h = 0` and every `β < 1`, the weights `Λ(n) n^{−1−x}(1 − ψ(h) n^{β−1})/|G|` on the
frequencies `(ψ, log n)` are nonnegative and have joint boundary divisor `δ_{(0,0)}`; so all four
boundary invariants hold. The family is `Z_0 = ζ`, `Z_h(s) = 1/ζ(s + 1 − β)`, trivial elsewhere,
and `Z_h` vanishes at the real point `β`.

The case `h = 0` is allowed: the single Euler product `ζ(s)/ζ(s + 1 − β)`, with log-coefficients
`Λ(n)(1 − n^{β−1}) ≥ 0`, satisfies all four boundary invariants and vanishes at the real point `β`.

So a zero at a point `p` of `G × ℝ` receives a certified zero-free interval from multiplicative
positivity exactly when `2p ≠ 0`. Real zeros of the trivial member and zeros of order-two members at
height `0` receive none: an exceptional (Siegel) zero may sit at any distance from `1`, and excluding
real zeros of `ζ` itself needs information that is not positivity (the sign of `ζ` on `(0, 1)`).
This is the interior form of the two-torsion exception of `joint_boundary_classification`.
-/

open Finset Filter Topology Complex

namespace GaloisForLFunctions.MultiplicativePositivityGeometry

/-! ### The cyclic fibre of a member -/

/-- The cyclic subgroup generated by a point of order `m`, as the image of `ZMod m`. -/
theorem cyclic_fibre_sum_nonneg {Γ : Type*} [AddCommGroup Γ] {T : Γ → ℝ} (hT : IsEvenPosDef T)
    {m : ℕ} [NeZero m] {g : Γ} (hg : m • g = 0) :
    0 ≤ ∑ k : ZMod m, T ((k.val : ℕ) • g) := by
  -- Restrict `T` along the homomorphism `ZMod m → Γ`, `k ↦ k • g`.
  let f : ZMod m →+ Γ := ZMod.lift m ⟨zmultiplesHom Γ g, by simpa using hg⟩
  have hpd := hT.comp_addMonoidHom f
  have h := finite_group_mass_sum hpd
  refine h.trans_eq (Finset.sum_congr rfl fun k _ => ?_)
  have h1 : f 1 = g := by
    show ZMod.lift m ⟨zmultiplesHom Γ g, _⟩ 1 = g
    rw [← Int.cast_one, ZMod.lift_coe]
    simp
  have hk : f k = (k.val : ℕ) • g := by
    conv_lhs => rw [← ZMod.natCast_zmod_val k, ← nsmul_one, map_nsmul, h1]
  simp only [Function.comp_apply, hk]

/-- **Two-torsion: purchase ratio one.** At a point of order two the positive-definite trace only
satisfies `|T(h)| ≤ T(0)`. -/
theorem abs_le_at_order_two {Γ : Type*} [AddCommGroup Γ] {T : Γ → ℝ} (hT : IsEvenPosDef T)
    (h : Γ) : |T h| ≤ T 0 :=
  hT.abs_le_apply_zero h

/-- **An unpaired real zero is not excluded.** If the pole term is `A/δ` and the zero contributes
`−B/(δ + η)` with `B ≤ A`, the exclusion inequality fails at every depth `η` and damping `δ`, for
any growth `G ≥ 0`. -/
theorem unpaired_real_zero_unexcluded {A B G δ η : ℝ} (hA : 0 ≤ A) (hBA : B ≤ A) (hG : 0 ≤ G)
    (hδ : 0 < δ) (hη : 0 < η) : ¬ (A / δ + G < B / (δ + η)) := by
  intro h
  have h1 : B / (δ + η) ≤ A / (δ + η) := div_le_div_of_nonneg_right hBA (by linarith)
  have h2 : A / (δ + η) ≤ A / δ := div_le_div_of_nonneg_left hA hδ (by linarith)
  linarith

/-- **A paired real zero is excluded.** With purchase ratio two (`B = 2m`, pole weight `A`),
exclusion holds exactly when `√A + √(Gη) < √(2m)`. -/
theorem paired_real_zero_width {A G η m : ℝ} (hA : 0 < A) (hm : 0 ≤ m) (hG : 0 < G)
    (hη : 0 < η) :
    (∃ δ > 0, A / δ + G < 2 * m / (δ + η)) ↔ Real.sqrt A + Real.sqrt (G * η) < Real.sqrt (2 * m) :=
  exclusion_iff hA (by positivity) hG hη

/-! ### The Siegel family -/

section Siegel

universe u

variable {G : Type u} [AddCommGroup G] [Fintype G]

/-- The Siegel weights `Λ(n) n^{−1−x}(1 − ψ(h) n^{β−1})/|G|` on the frequencies `(log n, ψ)`. -/
noncomputable def siegelWeight (h : G) (β x : ℝ) (p : ℕ × AddChar G ℂ) : ℝ :=
  zetaBoundaryWeight x p.1 * ((1 - (p.2 h).re * (p.1 : ℝ) ^ (β - 1)) / Fintype.card G)

theorem rpow_sub_one_le_one {β : ℝ} (hβ : β ≤ 1) (n : ℕ) : (n : ℝ) ^ (β - 1) ≤ 1 := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · rcases eq_or_lt_of_le hβ with rfl | hlt
    · simp
    · rw [Nat.cast_zero, Real.zero_rpow (by linarith)]; norm_num
  · exact Real.rpow_le_one_of_one_le_of_nonpos (by exact_mod_cast hn) (by linarith)

theorem siegelWeight_nonneg (h : G) {β : ℝ} (hβ : β ≤ 1) (x : ℝ) (p : ℕ × AddChar G ℂ) :
    0 ≤ siegelWeight h β x p := by
  unfold siegelWeight
  refine mul_nonneg (zetaBoundaryWeight_nonneg x p.1) (div_nonneg ?_ (Nat.cast_nonneg _))
  have h1 := (Complex.abs_re_le_norm (p.2 h)).trans (norm_addChar_apply p.2 h).le
  have h2 := rpow_sub_one_le_one hβ p.1
  have h3 : 0 ≤ (p.1 : ℝ) ^ (β - 1) := Real.rpow_nonneg (Nat.cast_nonneg _) _
  have := neg_abs_le (p.2 h).re
  have := le_abs_self (p.2 h).re
  nlinarith

theorem siegelWeight_le (h : G) {β : ℝ} (hβ : β ≤ 1) (x : ℝ) (p : ℕ × AddChar G ℂ) :
    siegelWeight h β x p ≤ 2 * zetaBoundaryWeight x p.1 := by
  unfold siegelWeight
  have hG : (1 : ℝ) ≤ Fintype.card G := by exact_mod_cast Fintype.card_pos
  have h1 : (1 - (p.2 h).re * (p.1 : ℝ) ^ (β - 1)) / Fintype.card G ≤ 2 := by
    rw [div_le_iff₀ (by linarith)]
    have h1 := (Complex.abs_re_le_norm (p.2 h)).trans (norm_addChar_apply p.2 h).le
    have h2 := rpow_sub_one_le_one hβ p.1
    have h3 : 0 ≤ (p.1 : ℝ) ^ (β - 1) := Real.rpow_nonneg (Nat.cast_nonneg _) _
    have := neg_abs_le (p.2 h).re
    nlinarith
  rw [mul_comm 2]
  exact mul_le_mul_of_nonneg_left h1 (zetaBoundaryWeight_nonneg x p.1)

theorem summable_siegelWeight (h : G) {β : ℝ} (hβ : β ≤ 1) {x : ℝ} (hx : 0 < x) :
    Summable (siegelWeight h β x) := by
  refine Summable.of_nonneg_of_le (siegelWeight_nonneg h hβ x) (siegelWeight_le h hβ x) ?_
  refine (summable_prod_of_nonneg fun p => by
    simpa using mul_nonneg zero_le_two (zetaBoundaryWeight_nonneg x p.1)).mpr
    ⟨fun _ => Summable.of_finite, ?_⟩
  simp only [tsum_fintype, Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
  exact ((summable_zetaBoundaryWeight hx).mul_left 2).mul_left _

/-- The Siegel member weights `Λ(n) n^{−(2−β)−x}`: the log-coefficients of `ζ(s + 1 − β)` on
`Re s = 1 + x`. -/
theorem summable_shiftedWeight {β : ℝ} (hβ : β ≤ 1) {x : ℝ} (hx : 0 < x) :
    Summable fun n : ℕ => zetaBoundaryWeight x n * (n : ℝ) ^ (β - 1) :=
  Summable.of_nonneg_of_le (fun n => mul_nonneg (zetaBoundaryWeight_nonneg x n)
    (Real.rpow_nonneg (Nat.cast_nonneg _) _))
    (fun n => mul_le_of_le_one_right (zetaBoundaryWeight_nonneg x n) (rpow_sub_one_le_one hβ n))
    (summable_zetaBoundaryWeight hx)

/-- The shifted trace stays bounded at the boundary: `ζ(s + 1 − β)` is regular on `Re s = 1`
for `β < 1`. -/
theorem abs_shiftedTrace_le {β : ℝ} (hβ : β < 1) {x : ℝ} (hx : 0 < x) (u : ℝ) :
    |∑' n : ℕ, zetaBoundaryWeight x n * (n : ℝ) ^ (β - 1) * Real.cos (logFrequency n * u)| ≤
      ∑' n : ℕ, zetaBoundaryWeight (1 - β) n := by
  have hs : Summable fun n : ℕ => zetaBoundaryWeight (1 - β) n :=
    summable_zetaBoundaryWeight (by linarith)
  have hle : ∀ n : ℕ, |zetaBoundaryWeight x n * (n : ℝ) ^ (β - 1) * Real.cos (logFrequency n * u)| ≤
      zetaBoundaryWeight (1 - β) n := by
    intro n
    rw [abs_mul, abs_of_nonneg (mul_nonneg (zetaBoundaryWeight_nonneg x n)
      (Real.rpow_nonneg (Nat.cast_nonneg _) _))]
    refine (mul_le_of_le_one_right (mul_nonneg (zetaBoundaryWeight_nonneg x n)
      (Real.rpow_nonneg (Nat.cast_nonneg _) _)) (Real.abs_cos_le_one _)).trans ?_
    unfold zetaBoundaryWeight
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · simp
    · have hn0 : (0 : ℝ) < n := by exact_mod_cast hn
      have hn1 : (1 : ℝ) ≤ n := by exact_mod_cast hn
      rw [mul_assoc, ← Real.rpow_add hn0]
      exact mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_le hn1 (by linarith))
        ArithmeticFunction.vonMangoldt_nonneg
  have hfs : Summable fun n : ℕ =>
      |zetaBoundaryWeight x n * (n : ℝ) ^ (β - 1) * Real.cos (logFrequency n * u)| :=
    Summable.of_nonneg_of_le (fun n => abs_nonneg _) hle hs
  calc |∑' n : ℕ, zetaBoundaryWeight x n * (n : ℝ) ^ (β - 1) * Real.cos (logFrequency n * u)|
      = ‖∑' n : ℕ, zetaBoundaryWeight x n * (n : ℝ) ^ (β - 1) * Real.cos (logFrequency n * u)‖ :=
        (Real.norm_eq_abs _).symm
    _ ≤ ∑' n : ℕ, ‖zetaBoundaryWeight x n * (n : ℝ) ^ (β - 1) * Real.cos (logFrequency n * u)‖ :=
        norm_tsum_le_tsum_norm (by simpa only [Real.norm_eq_abs] using hfs)
    _ = ∑' n : ℕ, |zetaBoundaryWeight x n * (n : ℝ) ^ (β - 1) * Real.cos (logFrequency n * u)| :=
        by simp only [Real.norm_eq_abs]
    _ ≤ _ := Summable.tsum_le_tsum hle hfs hs

/-- Orthogonality with the depth factor `c`:
`Σ_ψ (1 − ψ(h) c) Re(ψ(g) e^{iθ}) = |G| ([g = 0] − c [g = h]) cos θ`. -/
theorem sum_siegel_mode [DecidableEq G] {h : G} (hh : h + h = 0) (g : G) (θ c : ℝ) :
    ∑ ψ : AddChar G ℂ, (1 - (ψ h).re * c) * (ψ g * Complex.exp ((θ : ℂ) * I)).re =
      Fintype.card G * ((if g = 0 then 1 else 0) - c * (if g = h then 1 else 0)) *
        Real.cos θ := by
  have hneg : -h = h := neg_eq_of_add_eq_zero_right hh
  have hterm : ∀ ψ : AddChar G ℂ, (1 - (ψ h).re * c) * (ψ g * Complex.exp ((θ : ℂ) * I)).re =
      ((ψ g - (c : ℂ) * ψ (g + h)) * Complex.exp ((θ : ℂ) * I)).re := by
    intro ψ
    have hre : (ψ h : ℂ) = ((ψ h).re : ℂ) := by
      apply Complex.ext <;> simp [addChar_apply_im_eq_zero hh]
    rw [← Complex.re_ofReal_mul, AddChar.map_add_eq_mul]
    congr 1
    conv_rhs => rw [hre]
    push_cast
    ring
  rw [Finset.sum_congr rfl fun ψ _ => hterm ψ, ← Complex.re_sum, ← Finset.sum_mul,
    Finset.sum_sub_distrib, ← Finset.mul_sum, AddChar.sum_apply_eq_ite, AddChar.sum_apply_eq_ite]
  have hgh : (g + h = 0) ↔ (g = h) := by
    constructor
    · intro e; rw [← hneg]; exact eq_neg_of_add_eq_zero_left e
    · intro e; rw [e, hh]
  simp only [hgh]
  split_ifs <;> simp only [Complex.mul_re, Complex.sub_re, Complex.sub_im, Complex.mul_im,
    Complex.ofReal_re, Complex.ofReal_im, Complex.natCast_re, Complex.natCast_im,
    Complex.exp_ofReal_mul_I_re, Complex.exp_ofReal_mul_I_im, Complex.zero_re,
    Complex.zero_im] <;> ring

/-- The Siegel joint trace: `[g = 0]` times the trace of `ζ` minus `[g = h]` times the trace of
`ζ(s + 1 − β)`. -/
theorem jointTrace_siegel [DecidableEq G] (h : G) (hh : h + h = 0) {β : ℝ} (hβ : β ≤ 1) {x : ℝ}
    (hx : 0 < x) (p : G × ℝ) :
    jointTrace (siegelWeight h β x) Prod.snd (fun q => logFrequency q.1) p =
      (if p.1 = 0 then 1 else 0) * cosineTrace (zetaBoundaryWeight x) logFrequency p.2 -
        (if p.1 = h then 1 else 0) *
          ∑' n : ℕ, zetaBoundaryWeight x n * (n : ℝ) ^ (β - 1) * Real.cos (logFrequency n * p.2) := by
  have hs := summable_jointTrace_terms (siegelWeight_nonneg h hβ x)
    (summable_siegelWeight h hβ hx) Prod.snd (fun q => logFrequency q.1) p
  have hz := summable_cosineTrace_terms (zetaBoundaryWeight_nonneg x)
    (summable_zetaBoundaryWeight hx) logFrequency p.2
  have hsh : Summable fun n : ℕ =>
      zetaBoundaryWeight x n * (n : ℝ) ^ (β - 1) * Real.cos (logFrequency n * p.2) :=
    Summable.of_norm_bounded (summable_shiftedWeight hβ hx) fun n => by
      rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (mul_nonneg (zetaBoundaryWeight_nonneg x n)
        (Real.rpow_nonneg (Nat.cast_nonneg _) _))]
      exact mul_le_of_le_one_right (mul_nonneg (zetaBoundaryWeight_nonneg x n)
        (Real.rpow_nonneg (Nat.cast_nonneg _) _)) (Real.abs_cos_le_one _)
  unfold jointTrace cosineTrace
  rw [hs.tsum_prod, ← tsum_mul_left, ← tsum_mul_left, ← Summable.tsum_sub (hz.mul_left _)
    (hsh.mul_left _)]
  refine tsum_congr fun n => ?_
  rw [tsum_fintype]
  have hG : (Fintype.card G : ℝ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have key := sum_siegel_mode hh p.1 (logFrequency n * p.2) ((n : ℝ) ^ (β - 1))
  simp only [siegelWeight, jointMode, jointPhase]
  rw [show ∑ ψ : AddChar G ℂ, zetaBoundaryWeight x n *
      ((1 - (ψ h).re * (n : ℝ) ^ (β - 1)) / Fintype.card G) *
      (ψ p.1 * Complex.exp (((logFrequency n * p.2 : ℝ) : ℂ) * I)).re =
      zetaBoundaryWeight x n / Fintype.card G * ∑ ψ : AddChar G ℂ,
        (1 - (ψ h).re * (n : ℝ) ^ (β - 1)) *
          (ψ p.1 * Complex.exp (((logFrequency n * p.2 : ℝ) : ℂ) * I)).re by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl fun ψ _ => by ring, key]
  field_simp

/-- **The Siegel family satisfies every boundary invariant.** For `h` of order two and `β < 1` the
Siegel weights are a joint boundary datum with joint divisor `δ_{(0,0)}`. -/
theorem siegel_isJointBoundaryDivisor [DecidableEq G] (h : G) (hh : h + h = 0) {β : ℝ}
    (hβ : β < 1) :
    IsJointBoundaryDivisor Prod.snd (fun q : ℕ × AddChar G ℂ => logFrequency q.1)
      (siegelWeight h β) fun p : G × ℝ => if p = 0 then 1 else 0 where
  nonneg x _ p := siegelWeight_nonneg h hβ.le x p
  summable x hx := summable_siegelWeight h hβ.le hx
  tendsto p := by
    set B := ∑' n : ℕ, zetaBoundaryWeight (1 - β) n
    have hz := (zeta_isBoundaryDivisor.tendsto p.2).const_mul ((if p.1 = 0 then 1 else 0) : ℝ)
    -- `x` times the bounded shifted trace tends to `0`.
    have hsh : Tendsto (fun x : ℝ => x * ∑' n : ℕ, zetaBoundaryWeight x n * (n : ℝ) ^ (β - 1) *
        Real.cos (logFrequency n * p.2)) (𝓝[>] 0) (𝓝 0) := by
      have hlin : Tendsto (fun x : ℝ => x * B) (𝓝[>] 0) (𝓝 0) := by
        simpa using ((tendsto_id (x := 𝓝 (0 : ℝ))).mul_const B).mono_left nhdsWithin_le_nhds
      refine squeeze_zero_norm' ?_ hlin
      filter_upwards [self_mem_nhdsWithin] with x hx
      rw [Real.norm_eq_abs, abs_mul, abs_of_pos (Set.mem_Ioi.mp hx)]
      exact mul_le_mul_of_nonneg_left (abs_shiftedTrace_le hβ (Set.mem_Ioi.mp hx) p.2)
        (le_of_lt hx)
    have hlim := hz.sub (hsh.const_mul ((if p.1 = h then 1 else 0) : ℝ))
    have heq : ((if p.1 = 0 then 1 else 0) : ℝ) * zetaBoundaryDivisor p.2 -
        ((if p.1 = h then 1 else 0) : ℝ) * 0 = if p = 0 then 1 else 0 := by
      rw [zetaBoundaryDivisor_eq, mul_zero, sub_zero]
      obtain ⟨g, u⟩ := p
      by_cases hu : u = 0 <;> by_cases hg : g = 0 <;> simp [hu, hg, Prod.ext_iff]
    rw [heq] at hlim
    refine hlim.congr' ?_
    filter_upwards [self_mem_nhdsWithin] with x hx
    rw [jointTrace_siegel h hh hβ.le (Set.mem_Ioi.mp hx)]
    ring

/-- **The member of order two vanishes at `β`.** Its log-coefficients are `−Λ(n) n^{β−1}`; on the
line `Re s = β + x` their normalized trace tends to `−δ₀`: a simple zero of `Z_h` at `s = β`. -/
theorem siegel_member_zero (β u : ℝ) :
    Tendsto (fun x : ℝ => x * ∑' n : ℕ, -((ArithmeticFunction.vonMangoldt n : ℝ) *
        (n : ℝ) ^ (β - 1)) * (n : ℝ) ^ (-(β + x)) * Real.cos (logFrequency n * u))
      (𝓝[>] 0) (𝓝 (-(if u = 0 then 1 else 0))) := by
  have h := ((zeta_isBoundaryDivisor.tendsto u).neg)
  rw [zetaBoundaryDivisor_eq] at h
  refine h.congr' ?_
  filter_upwards [self_mem_nhdsWithin] with x hx
  unfold cosineTrace
  rw [← mul_neg, ← tsum_neg]
  congr 1
  refine tsum_congr fun n => ?_
  unfold zetaBoundaryWeight
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp
  · have hn0 : (0 : ℝ) < n := by exact_mod_cast hn
    rw [show -((ArithmeticFunction.vonMangoldt n : ℝ) * (n : ℝ) ^ (β - 1)) * (n : ℝ) ^ (-(β + x)) =
        -((ArithmeticFunction.vonMangoldt n : ℝ) * ((n : ℝ) ^ (β - 1) * (n : ℝ) ^ (-(β + x)))) by
        ring, ← Real.rpow_add hn0]
    ring_nf

end Siegel

end GaloisForLFunctions.MultiplicativePositivityGeometry
