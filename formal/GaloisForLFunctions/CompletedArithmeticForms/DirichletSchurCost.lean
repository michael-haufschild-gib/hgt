import GaloisForLFunctions.CompletedArithmeticForms.CyclotomicCoercivity

/-!
# Exact inverse and Schur cost of the arithmetic bridge

The completed conductor kernel is the Green kernel of the Dirichlet second difference.
Its inverse measures local variation, including both endpoint differences. This identifies
the precise cost of a mixed linear coupling without replacing it by absolute row bounds.
-/

noncomputable section

open Finset

namespace GaloisForLFunctions.CompletedArithmeticForms

/-- The complete divisor-conductor kernel in natural index coordinates. -/
def bridgeKernel (Q i j : ℕ) : ℝ :=
  (Q : ℝ) * (min i j : ℕ) - (i : ℝ) * j

/-- Potential generated by an interior coefficient packet. -/
def bridgePotential (Q : ℕ) (a : ℕ → ℝ) (i : ℕ) : ℝ :=
  ∑ j ∈ Ico 1 Q, bridgeKernel Q i j * a j

/-- Positive Dirichlet second difference; endpoint values remain explicit. -/
def dirichletDifference (b : ℕ → ℝ) (i : ℕ) : ℝ :=
  2 * b i - b (i - 1) - b (i + 1)

/-- Local variation with both boundary edges retained. -/
def dirichletEnergy (Q : ℕ) (b : ℕ → ℝ) : ℝ :=
  ∑ i ∈ range Q, (b (i + 1) - b i) ^ 2

theorem bridgeKernel_symm (Q i j : ℕ) : bridgeKernel Q i j = bridgeKernel Q j i := by
  simp only [bridgeKernel, min_comm, mul_comm]

theorem bridgeKernel_zero (Q j : ℕ) : bridgeKernel Q 0 j = 0 := by
  simp [bridgeKernel]

theorem bridgeKernel_endpoint {Q j : ℕ} (hj : j ≤ Q) : bridgeKernel Q Q j = 0 := by
  simp only [bridgeKernel, min_eq_right hj, sub_self]

/-- The arithmetic Green kernel has a unit point source at each interior index. -/
theorem bridgeKernel_dirichletDifference (Q j : ℕ) {i : ℕ} (hi : 0 < i) :
    dirichletDifference (fun k => bridgeKernel Q k j) i =
      if i = j then (Q : ℝ) else 0 := by
  have hi1 : 1 ≤ i := hi
  rcases lt_trichotomy i j with hij | rfl | hji
  · simp only [dirichletDifference, bridgeKernel, if_neg (ne_of_lt hij),
      min_eq_left hij.le, min_eq_left (show i - 1 ≤ j by omega),
      min_eq_left (show i + 1 ≤ j by omega)]
    rw [Nat.cast_sub hi1]
    push_cast
    ring
  · simp only [dirichletDifference, bridgeKernel, ite_true, min_self,
      min_eq_left (show i - 1 ≤ i by omega), min_eq_right (show i ≤ i + 1 by omega)]
    rw [Nat.cast_sub hi1]
    push_cast
    ring
  · simp only [dirichletDifference, bridgeKernel, if_neg (ne_of_gt hji),
      min_eq_right hji.le, min_eq_right (show j ≤ i - 1 by omega),
      min_eq_right (show j ≤ i + 1 by omega)]
    rw [Nat.cast_sub hi1]
    push_cast
    ring

theorem bridgePotential_zero (Q : ℕ) (a : ℕ → ℝ) : bridgePotential Q a 0 = 0 := by
  simp [bridgePotential, bridgeKernel_zero]

theorem bridgePotential_endpoint (Q : ℕ) (a : ℕ → ℝ) : bridgePotential Q a Q = 0 := by
  unfold bridgePotential
  refine sum_eq_zero fun j hj => ?_
  rw [bridgeKernel_endpoint (mem_Ico.mp hj).2.le, zero_mul]

/-- The local inverse recovers every original interior coefficient exactly. -/
theorem bridgePotential_dirichletDifference (Q : ℕ) (a : ℕ → ℝ)
    {i : ℕ} (hi : i ∈ Ico 1 Q) :
    dirichletDifference (bridgePotential Q a) i = (Q : ℝ) * a i := by
  have hi0 : 0 < i := (mem_Ico.mp hi).1
  calc
    _ = ∑ j ∈ Ico 1 Q,
        dirichletDifference (fun k => bridgeKernel Q k j) i * a j := by
      simp only [dirichletDifference, bridgePotential, mul_sum, sub_mul, sum_sub_distrib]
      congr 2
      exact sum_congr rfl fun j _ => by ring
    _ = ∑ j ∈ Ico 1 Q, (if i = j then (Q : ℝ) else 0) * a j := by
      simp_rw [bridgeKernel_dirichletDifference Q _ hi0]
    _ = (Q : ℝ) * a i := by simp [hi]

private theorem affine_of_dirichletDifference_eq_zero (Q : ℕ) (b : ℕ → ℝ)
    (hb : ∀ i ∈ Ico 1 Q, dirichletDifference b i = 0) :
    ∀ k, k ≤ Q → b k = b 0 + (k : ℝ) * (b 1 - b 0) := by
  intro k
  induction k using Nat.strong_induction_on with
  | h k ih =>
    intro hk
    rcases k with _ | k
    · simp
    rcases k with _ | k
    · ring
    have hprev := ih k (by omega) (by omega)
    have hmid := ih (k + 1) (by omega) (by omega)
    have hd := hb (k + 1) (mem_Ico.mpr ⟨by omega, by omega⟩)
    simp only [dirichletDifference, Nat.add_sub_cancel] at hd
    rw [hmid, hprev] at hd
    push_cast at hd ⊢
    nlinarith only [hd]

/-- Two endpoint values and the interior second difference determine the potential. -/
theorem dirichlet_unique {Q : ℕ} (hQ : 0 < Q) (b c : ℕ → ℝ)
    (h0 : b 0 = c 0) (hQend : b Q = c Q)
    (hL : ∀ i ∈ Ico 1 Q, dirichletDifference b i = dirichletDifference c i) :
    ∀ i, i ≤ Q → b i = c i := by
  let u : ℕ → ℝ := fun i => b i - c i
  have hu0 : u 0 = 0 := sub_eq_zero.mpr h0
  have huQ : u Q = 0 := sub_eq_zero.mpr hQend
  have huL : ∀ i ∈ Ico 1 Q, dirichletDifference u i = 0 := by
    intro i hi
    have h := hL i hi
    dsimp [dirichletDifference, u] at h ⊢
    linarith only [h]
  have ha := affine_of_dirichletDifference_eq_zero Q u huL
  have hlast := ha Q le_rfl
  rw [hu0, huQ, sub_zero, zero_add] at hlast
  have hQr : (Q : ℝ) ≠ 0 := by exact_mod_cast hQ.ne'
  have hu1 : u 1 = 0 := (mul_eq_zero.mp hlast.symm).resolve_left hQr
  intro i hi
  have h := ha i hi
  rw [hu0, hu1, sub_self, mul_zero, add_zero] at h
  exact sub_eq_zero.mp h

/-- The arithmetic Green operator is also a left inverse on the zero-boundary domain. -/
theorem bridgePotential_inverse {Q : ℕ} (hQ : 0 < Q) (b : ℕ → ℝ)
    (hb0 : b 0 = 0) (hbQ : b Q = 0) :
    ∀ i, i ≤ Q →
      bridgePotential Q (fun j => dirichletDifference b j / Q) i = b i := by
  apply dirichlet_unique hQ
  · rw [bridgePotential_zero, hb0]
  · rw [bridgePotential_endpoint, hbQ]
  · intro i hi
    rw [bridgePotential_dirichletDifference Q _ hi]
    have hQr : (Q : ℝ) ≠ 0 := by exact_mod_cast hQ.ne'
    field_simp

private theorem finite_green_identity (b : ℕ → ℝ) (N : ℕ) :
    dirichletEnergy (N + 1) b =
      (∑ i ∈ Icc 1 N, b i * dirichletDifference b i) +
        b 0 ^ 2 + b (N + 1) ^ 2 - b 0 * b 1 - b N * b (N + 1) := by
  induction N with
  | zero => simp [dirichletEnergy]; ring
  | succ N ih =>
    rw [dirichletEnergy, Finset.sum_range_succ]
    change dirichletEnergy (N + 1) b + (b (N + 1 + 1) - b (N + 1)) ^ 2 = _
    rw [ih, sum_Icc_succ_top (by omega)]
    simp only [dirichletDifference, Nat.add_sub_cancel]
    ring

/-- Finite Green's identity retains both endpoint edges. -/
theorem sum_mul_dirichletDifference {Q : ℕ} (hQ : 0 < Q) (b : ℕ → ℝ)
    (hb0 : b 0 = 0) (hbQ : b Q = 0) :
    (∑ i ∈ Ico 1 Q, b i * dirichletDifference b i) = dirichletEnergy Q b := by
  rcases Q with _ | N
  · omega
  have hset : Ico 1 (N + 1) = Icc 1 N := by ext i; simp
  rw [hset, finite_green_identity]
  simp [hb0, hbQ]

/-- The quadratic arithmetic form pairs coefficients with their exact potential. -/
theorem divisorGramEnergy_eq_sum_potential {Q : ℕ} (hQ : 0 < Q) (a : ℕ → ℝ) :
    divisorGramEnergy Q a = ∑ i ∈ Ico 1 Q, a i * bridgePotential Q a i := by
  rw [divisorGramEnergy_eq_bridge hQ]
  simp only [bridgePotential, bridgeKernel, Nat.cast_min, mul_sum]
  refine sum_congr rfl fun i _ => sum_congr rfl fun j _ => ?_
  ring

theorem bridgePotential_sub (Q : ℕ) (a b : ℕ → ℝ) (i : ℕ) :
    bridgePotential Q (fun j => a j - b j) i =
      bridgePotential Q a i - bridgePotential Q b i := by
  simp only [bridgePotential, mul_sub, sum_sub_distrib]

theorem sum_mul_bridgePotential_comm (Q : ℕ) (a b : ℕ → ℝ) :
    (∑ i ∈ Ico 1 Q, a i * bridgePotential Q b i) =
      ∑ i ∈ Ico 1 Q, b i * bridgePotential Q a i := by
  simp only [bridgePotential, mul_sum]
  rw [sum_comm]
  refine sum_congr rfl fun i _ => sum_congr rfl fun j _ => ?_
  rw [bridgeKernel_symm Q j i]
  ring

theorem divisorGramEnergy_sub {Q : ℕ} (hQ : 0 < Q) (a b : ℕ → ℝ) :
    divisorGramEnergy Q (fun i => a i - b i) =
      divisorGramEnergy Q a - 2 * (∑ i ∈ Ico 1 Q, a i * bridgePotential Q b i) +
        divisorGramEnergy Q b := by
  simp only [divisorGramEnergy_eq_sum_potential hQ, bridgePotential_sub]
  have hpoint (i : ℕ) : (a i - b i) * (bridgePotential Q a i - bridgePotential Q b i) =
      a i * bridgePotential Q a i - a i * bridgePotential Q b i -
        b i * bridgePotential Q a i + b i * bridgePotential Q b i := by ring
  simp_rw [hpoint]
  rw [sum_add_distrib, sum_sub_distrib, sum_sub_distrib,
    sum_mul_bridgePotential_comm Q b a]
  ring

private theorem inverse_energy {Q : ℕ} (hQ : 0 < Q) (b : ℕ → ℝ)
    (hb0 : b 0 = 0) (hbQ : b Q = 0) :
    divisorGramEnergy Q (fun j => dirichletDifference b j / Q) = dirichletEnergy Q b / Q := by
  rw [divisorGramEnergy_eq_sum_potential hQ]
  calc
    _ = ∑ i ∈ Ico 1 Q, (b i * dirichletDifference b i) / Q := by
      refine sum_congr rfl fun i hi => ?_
      rw [bridgePotential_inverse hQ b hb0 hbQ i (mem_Ico.mp hi).2.le]
      ring
    _ = (∑ i ∈ Ico 1 Q, b i * dirichletDifference b i) / Q := by rw [sum_div]
    _ = _ := by rw [sum_mul_dirichletDifference hQ b hb0 hbQ]

/-- Zero extension records the boundary cost of an arbitrary interior coupling. -/
def interiorExtension (Q : ℕ) (b : ℕ → ℝ) (i : ℕ) : ℝ :=
  if i ∈ Ico 1 Q then b i else 0

/-- The exact coefficient vector absorbing a linear coupling to the arithmetic Gram. -/
def bridgeInverse (Q : ℕ) (b : ℕ → ℝ) (i : ℕ) : ℝ :=
  dirichletDifference (interiorExtension Q b) i / Q

/-- Exact Schur cost, measured by local variation rather than absolute row size. -/
def bridgeSchurCost (Q : ℕ) (b : ℕ → ℝ) : ℝ :=
  dirichletEnergy Q (interiorExtension Q b) / Q

theorem dirichletEnergy_mul (Q : ℕ) (r : ℝ) (b : ℕ → ℝ) :
    dirichletEnergy Q (fun i => r * b i) = r ^ 2 * dirichletEnergy Q b := by
  simp only [dirichletEnergy, ← mul_sub, mul_pow, mul_sum]

theorem interiorExtension_mul (Q : ℕ) (r : ℝ) (b : ℕ → ℝ) :
    interiorExtension Q (fun i => r * b i) = fun i => r * interiorExtension Q b i := by
  funext i
  simp only [interiorExtension, mul_ite, mul_zero]

theorem bridgeSchurCost_mul (Q : ℕ) (r : ℝ) (b : ℕ → ℝ) :
    bridgeSchurCost Q (fun i => r * b i) = r ^ 2 * bridgeSchurCost Q b := by
  rw [bridgeSchurCost, interiorExtension_mul, dirichletEnergy_mul, bridgeSchurCost]
  ring

theorem bridgePotential_bridgeInverse {Q : ℕ} (hQ : 0 < Q) (b : ℕ → ℝ)
    {i : ℕ} (hi : i ∈ Ico 1 Q) :
    bridgePotential Q (bridgeInverse Q b) i = b i := by
  have h := bridgePotential_inverse hQ (interiorExtension Q b)
    (by simp [interiorExtension]) (by simp [interiorExtension]) i (mem_Ico.mp hi).2.le
  change bridgePotential Q (fun j => dirichletDifference (interiorExtension Q b) j / Q) i = b i
  simpa only [interiorExtension, if_pos hi] using h

theorem divisorGramEnergy_bridgeInverse {Q : ℕ} (hQ : 0 < Q) (b : ℕ → ℝ) :
    divisorGramEnergy Q (bridgeInverse Q b) = bridgeSchurCost Q b :=
  inverse_energy hQ (interiorExtension Q b)
    (by simp [interiorExtension]) (by simp [interiorExtension])

/-- The exact complete-square identity pays the whole mixed coupling once. -/
theorem bridgeSchur_completion {Q : ℕ} (hQ : 0 < Q) (a b : ℕ → ℝ) :
    divisorGramEnergy Q a - 2 * (∑ i ∈ Ico 1 Q, a i * b i) + bridgeSchurCost Q b =
      divisorGramEnergy Q (fun i => a i - bridgeInverse Q b i) := by
  rw [divisorGramEnergy_sub hQ, divisorGramEnergy_bridgeInverse hQ]
  have hp : (∑ i ∈ Ico 1 Q, a i * bridgePotential Q (bridgeInverse Q b) i) =
      ∑ i ∈ Ico 1 Q, a i * b i :=
    sum_congr rfl fun i hi => by rw [bridgePotential_bridgeInverse hQ b hi]
  rw [hp]

/-- The arithmetic Schur bound retains every off-diagonal and endpoint contribution. -/
theorem bridgeSchur_bound {Q : ℕ} (hQ : 0 < Q) (a b : ℕ → ℝ) :
    2 * (∑ i ∈ Ico 1 Q, a i * b i) - divisorGramEnergy Q a ≤ bridgeSchurCost Q b := by
  have h := divisorGramEnergy_nonneg Q (fun i => a i - bridgeInverse Q b i)
  rw [← bridgeSchur_completion hQ] at h
  linarith only [h]

/-- Equality forces the exact inverse coefficient on every interior coordinate. -/
theorem bridgeSchur_equality_iff {Q : ℕ} (hQ : 0 < Q) (a b : ℕ → ℝ) :
    2 * (∑ i ∈ Ico 1 Q, a i * b i) - divisorGramEnergy Q a = bridgeSchurCost Q b ↔
      ∀ i ∈ Ico 1 Q, a i = bridgeInverse Q b i := by
  have h := bridgeSchur_completion hQ a b
  have he : (2 * (∑ i ∈ Ico 1 Q, a i * b i) - divisorGramEnergy Q a = bridgeSchurCost Q b) ↔
      divisorGramEnergy Q (fun i => a i - bridgeInverse Q b i) = 0 := by
    constructor <;> intro heq <;> linarith only [h, heq]
  rw [he, divisorGramEnergy_eq_zero_iff hQ]
  simp only [sub_eq_zero]

/-- The cost is attained, so no smaller uniform payment for the same coupling is possible. -/
theorem bridgeSchurCost_isGreatest {Q : ℕ} (hQ : 0 < Q) (b : ℕ → ℝ) :
    IsGreatest {r : ℝ | ∃ a : ℕ → ℝ,
      r = 2 * (∑ i ∈ Ico 1 Q, a i * b i) - divisorGramEnergy Q a} (bridgeSchurCost Q b) := by
  constructor
  · refine ⟨bridgeInverse Q b, ?_⟩
    exact ((bridgeSchur_equality_iff hQ _ b).mpr fun _ _ => rfl).symm
  · rintro r ⟨a, rfl⟩
    exact bridgeSchur_bound hQ a b

#print axioms bridgePotential_inverse
#print axioms bridgeSchur_completion
#print axioms bridgeSchurCost_isGreatest

end GaloisForLFunctions.CompletedArithmeticForms
