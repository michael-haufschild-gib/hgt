import GaloisForLFunctions.AbsoluteGeometryOfSpecZ.TheArithmeticSquareIsCofree
import GaloisForLFunctions.SignFreePurityMechanisms.ThePowerMapIsAFrobeniusAtOnePrime

/-!
# The Adams ring sees only the norms

The integer Dirichlet polynomials on a set `σ` of generalized primes form the ring `ℤ[u_i : i ∈ σ]`
with the Adams operations `ψ_n : u_i ↦ u_i^n`. They are commuting Frobenius lifts
(`adamsLifts`). A system of integer norms `ν : σ → ℤ` is a `ℤ`-point `u_i ↦ ν_i`, and by cofreeness
it has a canonical lift to the arithmetic square.

* **The lift goes through the norms** (`ghostLift_adams_X`,
  `ghostComponent_ghostLift_adams`): `u_i ↦ [ν_i]`, and the `n`-th component of an auxiliary `F` is
  `F((ν_iⁿ)_i)`, the value of the Dirichlet polynomial at `s = −n`. Two generalized primes with the
  same norm have the same image (`ghostLift_adams_X_eq_of_eq`): the Λ-structure sees the set of
  norms and not their multiplicities. A monoid with integer norms that is not `ℤ` is not excluded
  by the square; it is invisible to it.
* **The fixed points of a power map** (`span_pow_sub_self`): for `n ≥ 2` the ideal generated by
  the `aⁿ − a`, `a ∈ ℤ`, is generated by the product of the primes `p` with `p − 1 ∣ n − 1`. On the
  Adams ring of the integer points, with its tautological point, the fixed scheme of `ψ_n` is
  therefore `Spec ℤ/Π_{p−1 ∣ n−1} p` (`span_fixed_adams`): one Frobenius has many fixed points
  there, but they are the primes of a divisibility condition on `n − 1`, never those of a window.
-/

open Finset MvPolynomial

namespace GaloisForLFunctions.AbsoluteGeometryOfSpecZ

variable {σ : Type*}

/-! ### The Adams operations are Frobenius lifts -/

/-- **The Adams operations** `ψ_n : u_i ↦ u_i^n` on integer Dirichlet polynomials are commuting
Frobenius lifts. -/
noncomputable def adamsLifts (σ : Type*) : FrobeniusLifts (MvPolynomial σ ℤ) where
  ψ :=
    { toFun := fun n => (expand (n : ℕ) : MvPolynomial σ ℤ →ₐ[ℤ] MvPolynomial σ ℤ).toRingHom
      map_one' := RingHom.ext fun f => by
        change expand ((1 : ℕ+) : ℕ) f = f
        rw [PNat.one_coe, expand_one_apply]
      map_mul' := fun m n => RingHom.ext fun f => by
        change expand ((m * n : ℕ+) : ℕ) f = expand (m : ℕ) (expand (n : ℕ) f)
        rw [PNat.mul_coe, expand_mul] }
  lift := fun p hp f => by
    haveI : Fact (p : ℕ).Prime := ⟨hp⟩
    have h : C (((p : ℕ) : ℤ)) ∣ expand (p : ℕ) f - f ^ (p : ℕ) := by
      rw [C_dvd_iff_zmod, map_sub, map_expand, expand_zmod, map_pow, sub_self]
    obtain ⟨b, hb⟩ := h
    refine ⟨b, ?_⟩
    change expand (p : ℕ) f = f ^ (p : ℕ) + ((p : ℕ) : MvPolynomial σ ℤ) * b
    rw [← map_natCast (C : ℤ →+* MvPolynomial σ ℤ)]
    linear_combination hb

theorem adamsLifts_ψ_apply (n : ℕ+) (F : MvPolynomial σ ℤ) :
    (adamsLifts σ).ψ n F = expand (n : ℕ) F := rfl

/-! ### The lift goes through the norms -/

/-- **The components of an auxiliary are its values at the powers of the norms**:
`F ↦ (F((ν_iⁿ)_i))_n`. -/
theorem ghostComponent_ghostLift_adams (ν : σ → ℤ) (n : ℕ+) (F : MvPolynomial σ ℤ) :
    ghostComponent n (ghostLift (adamsLifts σ) (eval ν) F) = eval (fun i => ν i ^ (n : ℕ)) F := by
  rw [ghostComponent_ghostLift, adamsLifts_ψ_apply, eval_expand]
  rfl

/-- **A generalized prime goes to the Teichmüller point of its norm.** -/
theorem ghostLift_adams_X (ν : σ → ℤ) (i : σ) :
    ghostLift (adamsLifts σ) (eval ν) (X i) = teichmuller (ν i) :=
  ghostRing_ext fun n => by
    rw [ghostComponent_ghostLift_adams, eval_X, ghostComponent_teichmuller]

/-- **The square does not see multiplicities**: generalized primes of equal norm have the same
image. -/
theorem ghostLift_adams_X_eq_of_eq (ν : σ → ℤ) {i j : σ} (h : ν i = ν j) :
    ghostLift (adamsLifts σ) (eval ν) (X i) = ghostLift (adamsLifts σ) (eval ν) (X j) := by
  rw [ghostLift_adams_X, ghostLift_adams_X, h]

/-! ### The fixed points of a power map -/

/-- The primes `p` with `p − 1 ∣ n − 1`. -/
def fixedPrimes (n : ℕ) : Finset ℕ :=
  (Finset.range (n + 1)).filter fun p => p.Prime ∧ (p - 1) ∣ (n - 1)

/-- `p` divides every `aⁿ − a` exactly when `p − 1 ∣ n − 1`. -/
theorem forall_prime_dvd_pow_sub_self_iff {p : ℕ} (hp : p.Prime) {n : ℕ} (hn : 1 ≤ n) :
    (∀ a : ℤ, (p : ℤ) ∣ a ^ n - a) ↔ (p - 1) ∣ (n - 1) := by
  haveI := Fact.mk hp
  rw [← SignFreePurityMechanisms.forall_pow_eq_self_iff p hn]
  constructor
  · intro h x
    obtain ⟨a, rfl⟩ := ZMod.intCast_surjective x
    have := (ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mpr (h a)
    push_cast at this
    exact sub_eq_zero.mp this
  · intro h a
    rw [← ZMod.intCast_zmod_eq_zero_iff_dvd]
    push_cast
    rw [h, sub_self]

/-- **The fixed scheme of the `n`-th power map on the integers.** For `n ≥ 2` the differences
`aⁿ − a` generate the ideal of the product of the primes with `p − 1 ∣ n − 1`. -/
theorem span_pow_sub_self {n : ℕ} (hn : 2 ≤ n) :
    Ideal.span (Set.range fun a : ℤ => a ^ n - a) =
      Ideal.span {((∏ p ∈ fixedPrimes n, p : ℕ) : ℤ)} := by
  have hn1 : 1 ≤ n := by omega
  have hprime : ∀ p ∈ fixedPrimes n, p.Prime := fun p hp => (mem_filter.mp hp).2.1
  refine le_antisymm (Ideal.span_le.mpr ?_) ?_
  · rintro _ ⟨a, rfl⟩
    refine Ideal.mem_span_singleton.mpr (Int.natCast_dvd.mpr ?_)
    refine Finset.prod_primes_dvd _ (fun p hp => (hprime p hp).prime) fun p hp => ?_
    exact Int.natCast_dvd.mp
      ((forall_prime_dvd_pow_sub_self_iff (hprime p hp) hn1).mpr (mem_filter.mp hp).2.2 a)
  · -- a generator `g` of the ideal is squarefree with prime factors among the fixed primes
    set S : Ideal ℤ := Ideal.span (Set.range fun a : ℤ => a ^ n - a) with hS
    obtain ⟨g, hg⟩ : ∃ g : ℤ, S = Ideal.span {g} :=
      ⟨_, (Ideal.span_singleton_generator S).symm⟩
    have hgdvd : ∀ a : ℤ, g ∣ a ^ n - a := fun a =>
      Ideal.mem_span_singleton.mp (hg ▸ Ideal.subset_span ⟨a, rfl⟩)
    have hg0 : g ≠ 0 := by
      rintro rfl
      have h2 := hgdvd 2
      rw [zero_dvd_iff, sub_eq_zero] at h2
      have : (2 : ℤ) ^ 1 < 2 ^ n := pow_lt_pow_right₀ (by norm_num) (by omega)
      omega
    have hgn : g.natAbs ≠ 0 := Int.natAbs_ne_zero.mpr hg0
    have hprod0 : (∏ p ∈ fixedPrimes n, p) ≠ 0 :=
      Finset.prod_ne_zero_iff.mpr fun p hp => (hprime p hp).ne_zero
    have hdvd : g.natAbs ∣ ∏ p ∈ fixedPrimes n, p := by
      refine (Nat.factorization_le_iff_dvd hgn hprod0).mp fun q => ?_
      by_cases hq : q.Prime
      · by_cases hqg : q ∣ g.natAbs
        · -- `q ∣ g`: `q` is a fixed prime, and `q² ∤ qⁿ − q`
          have hqg' : (q : ℤ) ∣ g := Int.natCast_dvd.mpr hqg
          have hq1 : (q - 1) ∣ (n - 1) :=
            (forall_prime_dvd_pow_sub_self_iff hq hn1).mp fun a => hqg'.trans (hgdvd a)
          have hqle : q ≤ n := by
            have := Nat.le_of_dvd (by omega) hq1
            have := hq.one_lt
            omega
          have hmem : q ∈ fixedPrimes n :=
            mem_filter.mpr ⟨mem_range.mpr (by omega), hq, hq1⟩
          have h1 : 1 ≤ (∏ p ∈ fixedPrimes n, p).factorization q :=
            hq.factorization_pos_of_dvd hprod0 (Finset.dvd_prod_of_mem _ hmem)
          have h2 : g.natAbs.factorization q ≤ 1 := by
            by_contra hlt
            have hsq : q ^ 2 ∣ g.natAbs :=
              (hq.pow_dvd_iff_le_factorization hgn).mpr (by omega)
            have hsq' : (q : ℤ) ^ 2 ∣ (q : ℤ) ^ n - q := by
              have : ((q ^ 2 : ℕ) : ℤ) ∣ g := Int.natCast_dvd.mpr hsq
              exact (by exact_mod_cast this : (q : ℤ) ^ 2 ∣ g).trans (hgdvd q)
            have hfac : (q : ℤ) ^ n - q = (q : ℤ) * ((q : ℤ) ^ (n - 1) - 1) := by
              have : n = (n - 1) + 1 := by omega
              nth_rewrite 1 [this]
              rw [pow_succ]; ring
            rw [hfac, sq] at hsq'
            have hq0 : (q : ℤ) ≠ 0 := by exact_mod_cast hq.ne_zero
            have h3 : (q : ℤ) ∣ (q : ℤ) ^ (n - 1) - 1 := (mul_dvd_mul_iff_left hq0).mp hsq'
            have h4 : (q : ℤ) ∣ (q : ℤ) ^ (n - 1) := dvd_pow_self _ (by omega)
            have h5 : (q : ℤ) ∣ 1 := by
              have := dvd_sub h4 h3
              rwa [sub_sub_cancel] at this
            have h6 : q ∣ 1 := by exact_mod_cast h5
            exact hq.one_lt.ne' (Nat.dvd_one.mp h6)
          omega
        · rw [Nat.factorization_eq_zero_of_not_dvd hqg]; exact Nat.zero_le _
      · rw [Nat.factorization_eq_zero_of_not_prime _ hq]; exact Nat.zero_le _
    rw [hg]
    refine Ideal.span_le.mpr ?_
    rintro _ rfl
    refine Ideal.mem_span_singleton.mpr ?_
    exact Int.natAbs_dvd.mp (by exact_mod_cast hdvd)

/-- **The fixed scheme of `ψ_n` on the Adams ring of the integer points**, at the tautological
point `u_a ↦ a`: the primes with `p − 1 ∣ n − 1`. -/
theorem span_fixed_adams {n : ℕ+} (hn : 1 < n) :
    Ideal.span (Set.range fun F : MvPolynomial ℤ ℤ =>
      eval id F - eval id ((adamsLifts ℤ).ψ n F)) =
      Ideal.span {((∏ p ∈ fixedPrimes n, p : ℕ) : ℤ)} := by
  have hn2 : 2 ≤ (n : ℕ) := hn
  rw [← span_pow_sub_self hn2]
  set J : Ideal ℤ := Ideal.span (Set.range fun a : ℤ => a ^ (n : ℕ) - a) with hJ
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
  · -- the two evaluations agree modulo `J` on the generators
    rintro _ ⟨F, rfl⟩
    have hhom : (Ideal.Quotient.mk J).comp (eval id) =
        (Ideal.Quotient.mk J).comp (eval fun a : ℤ => a ^ (n : ℕ)) := by
      refine MvPolynomial.ringHom_ext (fun r => by simp) fun a => ?_
      simp only [RingHom.comp_apply, eval_X, id]
      refine (Ideal.Quotient.eq.mpr ?_).symm
      exact Ideal.subset_span ⟨a, rfl⟩
    have h := congrArg (fun φ : MvPolynomial ℤ ℤ →+* ℤ ⧸ J => φ F) hhom
    simp only [RingHom.comp_apply] at h
    change eval id F - eval id ((adamsLifts ℤ).ψ n F) ∈ J
    rw [adamsLifts_ψ_apply, eval_expand]
    refine Ideal.Quotient.eq.mp ?_
    exact h
  · rintro _ ⟨a, rfl⟩
    have hmem : eval id (X a : MvPolynomial ℤ ℤ) - eval id ((adamsLifts ℤ).ψ n (X a)) ∈
        Ideal.span (Set.range fun F : MvPolynomial ℤ ℤ =>
          eval id F - eval id ((adamsLifts ℤ).ψ n F)) := Ideal.subset_span ⟨X a, rfl⟩
    rw [adamsLifts_ψ_apply, expand_X, map_pow, eval_X, id] at hmem
    have := (Ideal.neg_mem_iff _).mpr hmem
    rwa [neg_sub] at this

end GaloisForLFunctions.AbsoluteGeometryOfSpecZ
