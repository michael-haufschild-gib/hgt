import GaloisForLFunctions.AbsoluteGeometryOfSpecZ.TheGhostRingOfTheArithmeticSquare

/-!
# The Frobenius graphs meet in the primes

In the arithmetic square the graph `Γ_n` is the ghost component `x ↦ x_n`. Two graphs meet in the
closed subscheme `Γ_m ∩ Γ_n = Spec ℤ/J(m, n)` of `Spec ℤ`, where `J(m, n)` is the ideal generated by
the differences `x_m − x_n` (`graphIdeal`).

* `J(m, n)` is generated by the integers `d` dividing exactly one of `m`, `n`
  (`graphIdeal_eq_span`): the orbit `e_d` separates the two graphs by `d`, and by the necklace
  decomposition nothing else does.
* **Contact order** (`graphIdeal_mul_prime_pow`): `J(m, m p^j) = (p^{v_p(m)+1})` for `j ≥ 1`. The
  graphs `Γ_m`, `Γ_{mp^j}` meet only at `p`, with multiplicity `1 + v_p(m)`: the Frobenius of degree
  `m` is inseparable exactly over the primes dividing `m`.
* **Classification** (`graphIdeal_eq_top_or`): two distinct graphs are disjoint unless one degree
  is the other times a prime power. Distinct graphs meet in at most one prime
  (`prime_unique_of_graphIdeal_le`).
* **The point count** (`log_card_quotient_graphIdeal_one`): for `n ≥ 2` the fixed scheme of `F_n` on
  the diagonal is `Spec 𝔽_p` if `n` is a power of `p` and empty otherwise, and

    `log #(ℤ/J(1, n)) = Λ(n)`.

  The prime part of the point count `N(n) = Λ(n) + 1 + 1/(n² − 1)` of `Spec ℤ` is the logarithm of
  the order of the fixed scheme of the Witt Frobenius; the count is not a cardinality.
-/

open Finset
open scoped ArithmeticFunction.vonMangoldt

namespace GaloisForLFunctions.AbsoluteGeometryOfSpecZ

/-- The ideal of the intersection `Γ_m ∩ Γ_n` in `Spec ℤ`: generated by all `x_m − x_n`. -/
def graphIdeal (m n : ℕ+) : Ideal ℤ :=
  Ideal.span (Set.range fun x : ghostRing => ghostComponent m x - ghostComponent n x)

/-- The integers dividing exactly one of `m`, `n`. -/
def splitDivisors (m n : ℕ) : Set ℕ := {d | (d ∣ m ∧ ¬ d ∣ n) ∨ (d ∣ n ∧ ¬ d ∣ m)}

theorem graphIdeal_comm (m n : ℕ+) : graphIdeal m n = graphIdeal n m := by
  refine le_antisymm ?_ ?_ <;>
  · refine Ideal.span_le.mpr ?_
    rintro _ ⟨x, rfl⟩
    refine (Ideal.neg_mem_iff _).mp ?_
    rw [neg_sub]
    exact Ideal.subset_span ⟨x, rfl⟩

/-- **The graph ideal is generated by the divisors of exactly one degree.** -/
theorem graphIdeal_eq_span (m n : ℕ+) :
    graphIdeal m n = Ideal.span ((fun d : ℕ => (d : ℤ)) '' splitDivisors m n) := by
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
  · -- necklace decomposition: only divisors of exactly one degree survive in `x_m − x_n`
    rintro _ ⟨x, rfl⟩
    have hmem : ∀ (a b : ℕ+), ∀ d ∈ (a : ℕ).divisors \ (b : ℕ).divisors,
        (d : ℤ) * coord x d ∈ Ideal.span ((fun d : ℕ => (d : ℤ)) '' splitDivisors a b) := by
      intro a b d hd
      obtain ⟨h1, h2⟩ := Finset.mem_sdiff.mp hd
      refine Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨d, Or.inl ⟨(Nat.mem_divisors.mp h1).1, ?_⟩,
        rfl⟩)
      exact fun h => h2 (Nat.mem_divisors.mpr ⟨h, b.ne_zero⟩)
    have hsymm : splitDivisors n m = splitDivisors m n := by
      ext d; simp only [splitDivisors, Set.mem_setOf_eq]; tauto
    change ghostComponent m x - ghostComponent n x ∈ _
    rw [ghostComponent_eq_sum_coord, ghostComponent_eq_sum_coord, ← Finset.sum_sdiff_sub_sum_sdiff]
    refine Ideal.sub_mem _ (Ideal.sum_mem _ (hmem m n)) (Ideal.sum_mem _ fun d hd => ?_)
    rw [← hsymm]
    exact hmem n m d hd
  · -- the orbit of length `d` separates the graphs by `d`
    rintro _ ⟨d, hd, rfl⟩
    have key : ∀ (a b : ℕ+), d ∣ (a : ℕ) → ¬ d ∣ (b : ℕ) → (d : ℤ) ∈ graphIdeal a b := by
      intro a b ha hb
      have hpos : 0 < d := Nat.pos_of_dvd_of_pos ha a.pos
      refine Ideal.subset_span ⟨orbit ⟨d, hpos⟩, ?_⟩
      change (orbit ⟨d, hpos⟩).1 a - (orbit ⟨d, hpos⟩).1 b = (d : ℤ)
      rw [orbit_apply, orbit_apply, if_pos ha, if_neg hb, sub_zero]
      rfl
    rcases hd with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact key m n h1 h2
    · rw [graphIdeal_comm]; exact key n m h1 h2

/-- A divisor of `m p^j` that does not divide `m` is divisible by `p^{v_p(m)+1}`. -/
theorem pow_succ_factorization_dvd_of_dvd_mul_pow {p d m j : ℕ} (hp : p.Prime) (hm : m ≠ 0)
    (h : d ∣ m * p ^ j) (h' : ¬ d ∣ m) : p ^ (m.factorization p + 1) ∣ d := by
  have hmp : m * p ^ j ≠ 0 := mul_ne_zero hm (pow_ne_zero _ hp.ne_zero)
  have hd : d ≠ 0 := fun h0 => by
    rw [h0, zero_dvd_iff] at h
    exact hmp h
  rw [hp.pow_dvd_iff_le_factorization hd]
  by_contra hlt
  refine h' ((Nat.factorization_le_iff_dvd hd hm).mp fun q => ?_)
  have hle := (Nat.factorization_le_iff_dvd hd hmp).mpr h q
  rw [Nat.factorization_mul hm (pow_ne_zero _ hp.ne_zero), Nat.factorization_pow,
    hp.factorization, Finsupp.add_apply, Finsupp.smul_apply] at hle
  by_cases hq : q = p
  · subst hq; omega
  · rwa [Finsupp.single_eq_of_ne hq, smul_zero, add_zero] at hle

/-- **Contact order.** `Γ_m` and `Γ_{m p^j}` meet only at `p`, with multiplicity `1 + v_p(m)`. -/
theorem graphIdeal_mul_prime_pow (m : ℕ+) {p : ℕ+} (hp : p.Prime) {j : ℕ} (hj : j ≠ 0) :
    graphIdeal m (m * p ^ j) =
      Ideal.span {((p : ℕ) : ℤ) ^ ((m : ℕ).factorization p + 1)} := by
  have hp' : (p : ℕ).Prime := hp
  rw [graphIdeal_eq_span, PNat.mul_coe, PNat.pow_coe]
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
  · rintro _ ⟨d, hd, rfl⟩
    rcases hd with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact absurd (h1.mul_right _) h2
    · refine Ideal.mem_span_singleton.mpr ?_
      exact_mod_cast pow_succ_factorization_dvd_of_dvd_mul_pow hp' m.ne_zero h1 h2
  · rintro _ rfl
    refine Ideal.subset_span ⟨(p : ℕ) ^ ((m : ℕ).factorization p + 1), Or.inr ⟨?_, ?_⟩, by
      push_cast; rfl⟩
    · rw [pow_succ]
      exact mul_dvd_mul (Nat.ordProj_dvd _ _) (dvd_pow_self _ hj)
    · exact Nat.pow_succ_factorization_not_dvd m.ne_zero hp'

/-- A prime at which the two degrees have different valuations has a power in the graph ideal. -/
theorem exists_prime_pow_mem_graphIdeal {m n : ℕ+} {p : ℕ} (hp : p.Prime)
    (h : (m : ℕ).factorization p ≠ (n : ℕ).factorization p) :
    ∃ a : ℕ, ((p : ℤ) ^ a) ∈ graphIdeal m n := by
  have key : ∀ a b : ℕ+, (a : ℕ).factorization p < (b : ℕ).factorization p →
      ∃ e : ℕ, ((p : ℤ) ^ e) ∈ graphIdeal a b := by
    intro a b hlt
    refine ⟨(a : ℕ).factorization p + 1, ?_⟩
    rw [graphIdeal_eq_span]
    refine Ideal.subset_span ⟨p ^ ((a : ℕ).factorization p + 1), Or.inr ⟨?_, ?_⟩, by push_cast; rfl⟩
    · exact (hp.pow_dvd_iff_le_factorization b.ne_zero).mpr hlt
    · exact Nat.pow_succ_factorization_not_dvd a.ne_zero hp
  rcases lt_or_gt_of_ne h with hlt | hgt
  · exact key m n hlt
  · rw [graphIdeal_comm]; exact key n m hgt

/-- **Two primes separate.** If the degrees differ at two distinct primes the graphs are disjoint. -/
theorem graphIdeal_eq_top_of_two_primes {m n : ℕ+} {p q : ℕ} (hp : p.Prime) (hq : q.Prime)
    (hpq : p ≠ q) (h1 : (m : ℕ).factorization p ≠ (n : ℕ).factorization p)
    (h2 : (m : ℕ).factorization q ≠ (n : ℕ).factorization q) : graphIdeal m n = ⊤ := by
  obtain ⟨a, ha⟩ := exists_prime_pow_mem_graphIdeal hp h1
  obtain ⟨b, hb⟩ := exists_prime_pow_mem_graphIdeal hq h2
  have hcop : IsCoprime ((p : ℤ) ^ a) ((q : ℤ) ^ b) :=
    (Nat.isCoprime_iff_coprime.mpr ((Nat.coprime_primes hp hq).mpr hpq)).pow
  obtain ⟨u, v, huv⟩ := hcop
  rw [Ideal.eq_top_iff_one, ← huv]
  exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ ha) (Ideal.mul_mem_left _ _ hb)

/-- Distinct degrees differ at some prime. -/
theorem exists_prime_factorization_ne {m n : ℕ+} (hmn : m ≠ n) :
    ∃ p : ℕ, p.Prime ∧ (m : ℕ).factorization p ≠ (n : ℕ).factorization p := by
  by_contra hcon
  push Not at hcon
  refine hmn (PNat.eq (Nat.eq_of_factorization_eq m.ne_zero n.ne_zero fun q => ?_))
  by_cases hq : q.Prime
  · exact hcon q hq
  · rw [Nat.factorization_eq_zero_of_not_prime _ hq, Nat.factorization_eq_zero_of_not_prime _ hq]

/-- **Distinct graphs meet in at most one prime.** -/
theorem prime_unique_of_graphIdeal_le {m n : ℕ+} (hmn : m ≠ n) {p q : ℕ} (hp : p.Prime)
    (hq : q.Prime) (h1 : graphIdeal m n ≤ Ideal.span {(p : ℤ)})
    (h2 : graphIdeal m n ≤ Ideal.span {(q : ℤ)}) : p = q := by
  obtain ⟨r, hr, hne⟩ := exists_prime_factorization_ne hmn
  obtain ⟨a, ha⟩ := exists_prime_pow_mem_graphIdeal hr hne
  have key : ∀ s : ℕ, s.Prime → graphIdeal m n ≤ Ideal.span {(s : ℤ)} → s = r := by
    intro s hs hle
    have hd : (s : ℤ) ∣ (r : ℤ) ^ a := Ideal.mem_span_singleton.mp (hle ha)
    have hd' : s ∣ r ^ a := by exact_mod_cast hd
    exact (Nat.prime_dvd_prime_iff_eq hs hr).mp (hs.dvd_of_dvd_pow hd')
  rw [key p hp h1, key q hq h2]

/-- **Classification.** Two distinct graphs are disjoint unless one degree is the other times a
positive power of a prime. -/
theorem graphIdeal_eq_top_or {m n : ℕ+} (hmn : m ≠ n) :
    graphIdeal m n = ⊤ ∨
      ∃ p : ℕ+, p.Prime ∧ ∃ j : ℕ, j ≠ 0 ∧ (n = m * p ^ j ∨ m = n * p ^ j) := by
  obtain ⟨r, hr, hne⟩ := exists_prime_factorization_ne hmn
  by_cases hex : ∃ q : ℕ, q.Prime ∧ q ≠ r ∧ (m : ℕ).factorization q ≠ (n : ℕ).factorization q
  · obtain ⟨q, hq, hqr, hq2⟩ := hex
    exact Or.inl (graphIdeal_eq_top_of_two_primes hr hq (Ne.symm hqr) hne hq2)
  · push Not at hex
    refine Or.inr ⟨⟨r, hr.pos⟩, hr, ?_⟩
    -- the degrees agree away from `r`: the larger is the smaller times a power of `r`
    have key : ∀ a b : ℕ+, (∀ q : ℕ, q.Prime → q ≠ r →
        (a : ℕ).factorization q = (b : ℕ).factorization q) →
        (a : ℕ).factorization r < (b : ℕ).factorization r →
        b = a * (⟨r, hr.pos⟩ : ℕ+) ^ ((b : ℕ).factorization r - (a : ℕ).factorization r) := by
      intro a b hab hlt
      refine PNat.eq (Nat.eq_of_factorization_eq b.ne_zero (PNat.ne_zero _) fun q => ?_)
      rw [PNat.mul_coe, PNat.pow_coe, PNat.mk_coe,
        Nat.factorization_mul a.ne_zero (pow_ne_zero _ hr.ne_zero), Nat.factorization_pow,
        hr.factorization, Finsupp.add_apply, Finsupp.smul_apply]
      by_cases hq : q = r
      · subst hq
        rw [Finsupp.single_eq_same, smul_eq_mul, mul_one]
        omega
      · rw [Finsupp.single_eq_of_ne hq, smul_zero, add_zero]
        by_cases hqp : q.Prime
        · exact (hab q hqp hq).symm
        · rw [Nat.factorization_eq_zero_of_not_prime _ hqp,
            Nat.factorization_eq_zero_of_not_prime _ hqp]
    rcases lt_or_gt_of_ne hne with hlt | hgt
    · exact ⟨_, (Nat.sub_pos_of_lt hlt).ne', Or.inl (key m n hex hlt)⟩
    · exact ⟨_, (Nat.sub_pos_of_lt hgt).ne', Or.inr (key n m (fun q hq hqr => (hex q hq hqr).symm) hgt)⟩

/-! ### The fixed points of the Frobenius on the diagonal -/

/-- The fixed scheme of `F_{p^k}` on the diagonal is the point `p`, with multiplicity one. -/
theorem graphIdeal_one_prime_pow {p : ℕ+} (hp : p.Prime) {k : ℕ} (hk : k ≠ 0) :
    graphIdeal 1 (p ^ k) = Ideal.span {((p : ℕ) : ℤ)} := by
  have h := graphIdeal_mul_prime_pow 1 hp hk
  rwa [one_mul, PNat.one_coe, Nat.factorization_one, Finsupp.zero_apply, zero_add, pow_one] at h

/-- If `n ≥ 2` is not a prime power, `F_n` has no fixed point on the diagonal. -/
theorem graphIdeal_one_eq_top {n : ℕ+} (hn : 1 < n) (h : ¬ IsPrimePow (n : ℕ)) :
    graphIdeal 1 n = ⊤ := by
  have hn1 : (n : ℕ) ≠ 1 := fun h1 => hn.ne' (PNat.eq (by simpa using h1))
  obtain ⟨p, hp, hpn⟩ := Nat.exists_prime_and_dvd hn1
  have hq : ∃ q : ℕ, q.Prime ∧ q ∣ (n : ℕ) ∧ q ≠ p := by
    by_contra hcon
    push Not at hcon
    exact h (isPrimePow_iff_unique_prime_dvd.mpr ⟨p, ⟨hp, hpn⟩, fun q hq => hcon q hq.1 hq.2⟩)
  obtain ⟨q, hq, hqn, hqp⟩ := hq
  have hv : ∀ r : ℕ, r.Prime → r ∣ (n : ℕ) →
      ((1 : ℕ+) : ℕ).factorization r ≠ (n : ℕ).factorization r := by
    intro r hr hrn
    rw [PNat.one_coe, Nat.factorization_one, Finsupp.zero_apply]
    exact (hr.factorization_pos_of_dvd n.ne_zero hrn).ne
  exact graphIdeal_eq_top_of_two_primes hp hq (Ne.symm hqp) (hv p hp hpn) (hv q hq hqn)

/-- **The point count of the arithmetic square.** For `n ≥ 2` the logarithm of the order of the
fixed scheme of `F_n` on the diagonal is `Λ(n)`. -/
theorem log_card_quotient_graphIdeal_one {n : ℕ+} (hn : 1 < n) :
    Real.log (Nat.card (ℤ ⧸ graphIdeal 1 n)) = Λ (n : ℕ) := by
  by_cases hpp : IsPrimePow (n : ℕ)
  · obtain ⟨p, k, hp, hk, hpk⟩ := (isPrimePow_nat_iff _).mp hpp
    have hn' : n = (⟨p, hp.pos⟩ : ℕ+) ^ k := PNat.eq (by rw [PNat.pow_coe, PNat.mk_coe, hpk])
    have hI : graphIdeal 1 n = Ideal.span {(p : ℤ)} := by
      rw [hn']; exact graphIdeal_one_prime_pow (p := ⟨p, hp.pos⟩) hp hk.ne'
    rw [hI, Nat.card_congr (Int.quotientSpanNatEquivZMod p).toEquiv, Nat.card_zmod, ← hpk,
      ArithmeticFunction.vonMangoldt_apply_pow hk.ne', ArithmeticFunction.vonMangoldt_apply_prime hp]
  · have hI := graphIdeal_one_eq_top hn hpp
    haveI : Subsingleton (ℤ ⧸ graphIdeal 1 n) := Ideal.Quotient.subsingleton_iff.mpr hI
    rw [Nat.card_of_subsingleton (0 : ℤ ⧸ graphIdeal 1 n), Nat.cast_one, Real.log_one,
      ArithmeticFunction.vonMangoldt_eq_zero_iff.mpr hpp]

end GaloisForLFunctions.AbsoluteGeometryOfSpecZ
