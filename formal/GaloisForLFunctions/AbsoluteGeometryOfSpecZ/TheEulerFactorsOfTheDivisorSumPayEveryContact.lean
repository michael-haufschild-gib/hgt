import GaloisForLFunctions.AbsoluteGeometryOfSpecZ.TheFrobeniusGraphsMeetInThePrimes
import GaloisForLFunctions.HTGeometry.MvPolynomialInfiniteVanishing

/-!
# The Euler factors of the divisor sum pay every contact

Bézout by restriction asks that a section vanishing on a set of graphs and not on `Γ_m` be at
least as large on `Γ_m` as the contacts of `Γ_m` with the set. In the arithmetic square this
holds for the graphs below `Γ_m` and for one graph above it at each prime: the graphs
`Γ_m, Γ_{mp}, Γ_{mp²}, …` pass through one point of the fibre over `p` and a section sees one
condition there. On the cyclotomic divisors of `𝔾_m` every contact is paid, but the divisor of
order `n` has the mass `φ(n)`.

This file gives a subring of the square, with unit masses, in which every contact is paid.

* **Coordinates** (`primeCoord`, `primeCoord_eq_sum_orbit`). For a prime `p` the element
  `y_p = Σ_{j ≥ 1} e_{p^j}` of the square has the components
  `(y_p)_n = p + p² + ⋯ + p^{v_p(n)}` (`chainNode`). The sum of all orbits has the components
  `σ(n)`, and `1 + y_p` are its Euler factors (`prod_one_add_chainNode`).
* **The ring** (`coordHom`, `payingRing`, `coordHom_injective`). The subring `P` generated by the
  `y_p` is the polynomial ring on the primes: the graph `Γ_n` is the lattice point
  `Y_p = (y_p)_n` (`latticePoint`), and a polynomial vanishing at all lattice points is zero.
* **Chains lie on lines** (`latticePoint_chain`, `eval_linePoly`). The graphs `Γ_{m p^l}`,
  `p ∤ m`, differ in the coordinate `Y_p` alone, where they sit at the nodes
  `p + ⋯ + p^l`; two nodes `k ≠ l` differ by a multiple of `p^{min(k,l)+1}`, the contact of the
  two graphs in the square.
* **Payment** (`IsPlanar`, `pow_sum_dvd_of_isPlanar`, `sum_contact_le_log_abs_of_isPlanar`,
  `sum_contact_le_log_abs_coordHom`). A sequence is planar when on every chain it is, up to a
  factor prime to `p`, an integer polynomial in the node. A planar sequence vanishing on
  `Γ_{m p^l}`, `l ∈ T`, is divisible on `Γ_{m p^k}` by `p^{Σ_{l ∈ T} (min(k,l)+1)}`: a polynomial
  vanishing at the nodes is divisible by the product of the linear factors. Summed over the
  primes: a planar sequence vanishing on a finite set `S` of graphs and not on `Γ_m` has
  `Σ_{n ∈ S} (Λ(n/m)[m ∣ n] + Λ(m/n)[n ∣ m]) ≤ log|x_m|`, prime powers included. Every element
  of `P` is planar, and planar sequences lie in the square (`isGhost_of_isPlanar`).
* **What is lost** (`prime_sub_orbit_notMem_payingRing`, `chainNode_sub_dvd_coordHom`,
  `three_dvd_sub_of_mem_payingRing`). The section `p − e_p` of the square is not in `P`. The
  difference of an element of `P` on two graphs of a chain is divisible by the difference of
  the nodes, which has prime factors other than `p`: on `Γ_1` and `Γ_4` every element of `P`
  agrees modulo `3`, where the square has no contact. The payment is the product formula for
  the differences of the nodes (`ghostComponent_coordHom_nodeProduct`).
-/

open Finset Polynomial
open scoped ArithmeticFunction.vonMangoldt ArithmeticFunction.sigma

noncomputable section

namespace GaloisForLFunctions.AbsoluteGeometryOfSpecZ

/-! ### The nodes of a chain -/

/-- The node `p + p² + ⋯ + p^l` of the `l`-th graph of a chain at `p`. -/
def chainNode (p l : ℕ) : ℤ := ∑ j ∈ Icc 1 l, (p : ℤ) ^ j

@[simp] theorem chainNode_zero (p : ℕ) : chainNode p 0 = 0 := by simp [chainNode]

theorem chainNode_succ (p l : ℕ) : chainNode p (l + 1) = chainNode p l + (p : ℤ) ^ (l + 1) := by
  rw [chainNode, Finset.sum_Icc_succ_top (by omega)]; rfl

/-- Two nodes differ by `p^{k+1}` times a geometric sum. -/
theorem chainNode_sub (p : ℕ) {k l : ℕ} (h : k ≤ l) :
    chainNode p l - chainNode p k = (p : ℤ) ^ (k + 1) * ∑ i ∈ range (l - k), (p : ℤ) ^ i := by
  induction l, h using Nat.le_induction with
  | base => simp
  | succ l hl ih =>
    rw [chainNode_succ, add_sub_right_comm, ih, show l + 1 - k = l - k + 1 by omega,
      Finset.sum_range_succ, mul_add, ← pow_add, show k + 1 + (l - k) = l + 1 by omega]

/-- Two nodes differ by a multiple of `p^{min(k,l)+1}`: the contact of `Γ_{m p^k}` and
`Γ_{m p^l}` in the square, for `p ∤ m`. -/
theorem pow_min_succ_dvd_chainNode_sub (p k l : ℕ) :
    (p : ℤ) ^ (min k l + 1) ∣ chainNode p k - chainNode p l := by
  rcases le_total k l with h | h
  · rw [min_eq_left h, ← neg_sub, dvd_neg, chainNode_sub p h]
    exact dvd_mul_right _ _
  · rw [min_eq_right h, chainNode_sub p h]
    exact dvd_mul_right _ _

theorem chainNode_strictMono {p : ℕ} (hp : 0 < p) : StrictMono (chainNode p) := by
  refine strictMono_nat_of_lt_succ fun l => ?_
  rw [chainNode_succ]
  have : (0 : ℤ) < (p : ℤ) ^ (l + 1) := by positivity
  linarith

/-- The geometric sum `1 + p + ⋯ + p^{j−1}`, `j ≥ 1`, is prime to `p`. -/
theorem not_dvd_geomSum {p : ℕ} (hp : p.Prime) {j : ℕ} (hj : j ≠ 0) :
    ¬ (p : ℤ) ∣ ∑ i ∈ range j, (p : ℤ) ^ i := by
  obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hj
  rw [Finset.sum_range_succ', pow_zero]
  intro h
  have h1 : (p : ℤ) ∣ ∑ i ∈ range j, (p : ℤ) ^ (i + 1) :=
    Finset.dvd_sum fun i _ => dvd_pow_self _ (Nat.succ_ne_zero i)
  have h2 : (p : ℤ) ∣ 1 := (dvd_add_right h1).mp h
  exact (Nat.prime_iff_prime_int.mp hp).not_dvd_one h2

/-- `1 + y_p` on `Γ_{p^l}` is the divisor sum of `p^l`. -/
theorem one_add_chainNode {p : ℕ} (hp : p.Prime) (l : ℕ) :
    1 + chainNode p l = ((σ 1 (p ^ l) : ℕ) : ℤ) := by
  rw [ArithmeticFunction.sigma_one_apply_prime_pow hp, Nat.cast_sum, chainNode,
    Finset.range_eq_Ico, Finset.sum_eq_sum_Ico_succ_bot (Nat.succ_pos l)]
  simp only [pow_zero, Nat.cast_one, Nat.cast_pow]
  rfl

/-- **The Euler product of the divisor sum.** The product over the primes of `n` of `1 + y_p` on
`Γ_n` is `σ(n)`, the component of the sum of all orbits. -/
theorem prod_one_add_chainNode {n : ℕ} (hn : n ≠ 0) :
    ∏ p ∈ n.primeFactors, (1 + chainNode p (n.factorization p)) = ((σ 1 n : ℕ) : ℤ) := by
  rw [ArithmeticFunction.IsMultiplicative.multiplicative_factorization (σ 1)
    ArithmeticFunction.isMultiplicative_sigma hn, Finsupp.prod, Nat.support_factorization,
    Nat.cast_prod]
  exact Finset.prod_congr rfl fun p hp => one_add_chainNode (Nat.prime_of_mem_primeFactors hp) _

/-! ### The coordinate of a prime -/

/-- The sequence `n ↦ p + ⋯ + p^{v_p(n)}`. -/
def primeCoordFun (p : ℕ) : ℕ+ → ℤ := fun n => chainNode p ((n : ℕ).factorization p)

theorem isGhost_primeCoordFun (p : ℕ) : IsGhost (primeCoordFun p) := by
  intro q hq n
  have hq' : (q : ℕ).Prime := hq
  unfold primeCoordFun
  rw [PNat.mul_coe, Nat.factorization_mul q.ne_zero n.ne_zero, Finsupp.add_apply]
  by_cases h : (q : ℕ) = p
  · subst h
    rw [hq'.factorization_self, add_comm, chainNode_succ, add_sub_cancel_left]
  · rw [hq'.factorization, Finsupp.single_eq_of_ne (Ne.symm h), zero_add, sub_self]
    exact dvd_zero _

/-- The coordinate `y_p = Σ_{j ≥ 1} e_{p^j}` of the square. -/
def primeCoord (p : ℕ) : ghostRing := ⟨primeCoordFun p, isGhost_primeCoordFun p⟩

@[simp] theorem ghostComponent_primeCoord (p : ℕ) (n : ℕ+) :
    ghostComponent n (primeCoord p) = chainNode p ((n : ℕ).factorization p) := rfl

/-- **The coordinate is the sum of the orbits of the powers of the prime.** On `Γ_n` the sum
`Σ_{1 ≤ j ≤ J} e_{p^j}` is `y_p` as soon as `J ≥ v_p(n)`. -/
theorem primeCoord_eq_sum_orbit {p : ℕ+} (hp : p.Prime) (n : ℕ+) {J : ℕ}
    (hJ : (n : ℕ).factorization p ≤ J) :
    ghostComponent n (primeCoord p) = ∑ j ∈ Icc 1 J, ghostComponent n (orbit (p ^ j)) := by
  have hp' : (p : ℕ).Prime := hp
  rw [ghostComponent_primeCoord, chainNode]
  have hterm : ∀ j ∈ Icc 1 J, ghostComponent n (orbit (p ^ j)) =
      if j ∈ Icc 1 ((n : ℕ).factorization p) then ((p : ℕ) : ℤ) ^ j else 0 := by
    intro j hj
    rw [ghostComponent_apply, orbit_apply, PNat.pow_coe,
      hp'.pow_dvd_iff_le_factorization n.ne_zero]
    have h1 : 1 ≤ j := (Finset.mem_Icc.mp hj).1
    by_cases h : j ≤ (n : ℕ).factorization p
    · rw [if_pos h, if_pos (Finset.mem_Icc.mpr ⟨h1, h⟩)]; push_cast; rfl
    · rw [if_neg h, if_neg fun h' => h (Finset.mem_Icc.mp h').2]
  rw [Finset.sum_congr rfl hterm, Finset.sum_ite_mem,
    Finset.inter_eq_right.mpr (Finset.Icc_subset_Icc_right hJ)]

/-! ### The lattice points and the ring -/

/-- A prime as a positive natural number. -/
def primePNat (p : Nat.Primes) : ℕ+ := ⟨p, p.2.pos⟩

@[simp] theorem primePNat_coe (p : Nat.Primes) : ((primePNat p : ℕ+) : ℕ) = p := rfl

/-- The graph `Γ_n` as a point of the affine space on the primes. -/
def latticePoint (n : ℕ+) : Nat.Primes → ℤ := fun p => chainNode p ((n : ℕ).factorization p)

/-- The polynomial ring on the primes in the square: `Y_p ↦ y_p`. -/
def coordHom : MvPolynomial Nat.Primes ℤ →+* ghostRing :=
  MvPolynomial.eval₂Hom (Int.castRingHom ghostRing) fun p => primeCoord p

/-- The subring of the square generated by the coordinates of the primes. -/
def payingRing : Subring ghostRing := coordHom.range

/-- On `Γ_n` an element of the ring is the value of its polynomial at the lattice point. -/
theorem ghostComponent_coordHom (n : ℕ+) (f : MvPolynomial Nat.Primes ℤ) :
    ghostComponent n (coordHom f) = MvPolynomial.eval (latticePoint n) f := by
  have h : (ghostComponent n).comp coordHom = MvPolynomial.eval (latticePoint n) := by
    refine MvPolynomial.ringHom_ext (fun r => ?_) (fun p => ?_)
    · simp [coordHom]
    · simp [coordHom, latticePoint]
  exact RingHom.congr_fun h f

/-- Every positive integer is a number prime to `p` times a power of `p`. -/
theorem exists_chain_decomposition (p : Nat.Primes) (n : ℕ+) :
    ∃ m : ℕ+, ¬ (p : ℕ) ∣ m ∧ n = m * primePNat p ^ ((n : ℕ).factorization p) := by
  refine ⟨⟨(n : ℕ) / (p : ℕ) ^ (n : ℕ).factorization p, Nat.ordCompl_pos _ n.ne_zero⟩,
    Nat.not_dvd_ordCompl p.2 n.ne_zero, PNat.eq ?_⟩
  rw [PNat.mul_coe, PNat.pow_coe, primePNat_coe, PNat.mk_coe]
  exact (Nat.ordCompl_mul_ordProj_eq_self _ _).symm

theorem factorization_chain (p : Nat.Primes) {m : ℕ+} (hm : ¬ (p : ℕ) ∣ m) (l : ℕ) :
    ((m * primePNat p ^ l : ℕ+) : ℕ).factorization p = l := by
  rw [PNat.mul_coe, PNat.pow_coe, primePNat_coe,
    Nat.factorization_mul m.ne_zero (pow_ne_zero _ p.2.ne_zero), Finsupp.add_apply,
    Nat.factorization_eq_zero_of_not_dvd hm, Nat.factorization_pow, p.2.factorization,
    Finsupp.smul_apply, Finsupp.single_eq_same, zero_add, smul_eq_mul, mul_one]

/-- **A chain lies on a line.** The graphs `Γ_{m p^l}`, `p ∤ m`, have the coordinates of `Γ_m`
except `Y_p`, which is the node `p + ⋯ + p^l`. -/
theorem latticePoint_chain (p : Nat.Primes) {m : ℕ+} (hm : ¬ (p : ℕ) ∣ m) (l : ℕ) :
    latticePoint (m * primePNat p ^ l) = Function.update (latticePoint m) p (chainNode p l) := by
  funext q
  by_cases hq : q = p
  · subst hq
    rw [Function.update_self, latticePoint, factorization_chain q hm]
  · rw [Function.update_of_ne hq, latticePoint, latticePoint, PNat.mul_coe, PNat.pow_coe,
      primePNat_coe, Nat.factorization_mul m.ne_zero (pow_ne_zero _ p.2.ne_zero),
      Finsupp.add_apply, Nat.factorization_pow, p.2.factorization, Finsupp.smul_apply,
      Finsupp.single_eq_of_ne (fun h => hq (Subtype.ext h)), smul_zero, add_zero]

/-- The restriction of a polynomial to the line through `a` in the direction of `Y_p`. -/
def linePoly (f : MvPolynomial Nat.Primes ℤ) (p : Nat.Primes) (a : Nat.Primes → ℤ) : ℤ[X] :=
  MvPolynomial.eval₂Hom (Polynomial.C : ℤ →+* ℤ[X])
    (fun q => if q = p then Polynomial.X else Polynomial.C (a q)) f

theorem eval_linePoly (f : MvPolynomial Nat.Primes ℤ) (p : Nat.Primes) (a : Nat.Primes → ℤ)
    (t : ℤ) : (linePoly f p a).eval t = MvPolynomial.eval (Function.update a p t) f := by
  have h : (Polynomial.evalRingHom t).comp (MvPolynomial.eval₂Hom (Polynomial.C : ℤ →+* ℤ[X])
      (fun q => if q = p then Polynomial.X else Polynomial.C (a q))) =
      MvPolynomial.eval (Function.update a p t) := by
    refine MvPolynomial.ringHom_ext (fun r => ?_) (fun q => ?_)
    · simp
    · by_cases hq : q = p
      · subst hq; simp
      · simp [hq]
  exact RingHom.congr_fun h f

/-- On the chain of `m` at `p` an element of the ring is its line polynomial at the nodes. -/
theorem ghostComponent_coordHom_chain (f : MvPolynomial Nat.Primes ℤ) (p : Nat.Primes) {m : ℕ+}
    (hm : ¬ (p : ℕ) ∣ m) (l : ℕ) :
    ghostComponent (m * primePNat p ^ l) (coordHom f) =
      (linePoly f p (latticePoint m)).eval (chainNode p l) := by
  rw [ghostComponent_coordHom, latticePoint_chain p hm, eval_linePoly]

/-! ### Planar sequences pay the contacts of a chain -/

/-- A polynomial vanishing on a finite set of integers has, at every integer, a value divisible
by the product of the differences. -/
theorem prod_sub_dvd_eval (g : ℤ[X]) (A : Finset ℤ) (hA : ∀ a ∈ A, g.eval a = 0) (c : ℤ) :
    ∏ a ∈ A, (c - a) ∣ g.eval c := by
  induction A using Finset.induction_on generalizing g with
  | empty => simp
  | insert a A ha ih =>
    obtain ⟨g₁, rfl⟩ := Polynomial.dvd_iff_isRoot.mpr (hA a (Finset.mem_insert_self a A))
    rw [Finset.prod_insert ha, eval_mul, eval_sub, eval_X, eval_C]
    refine mul_dvd_mul_left _ (ih g₁ fun b hb => ?_)
    have h := hA b (Finset.mem_insert_of_mem hb)
    rw [eval_mul, eval_sub, eval_X, eval_C] at h
    exact (mul_eq_zero.mp h).resolve_left (sub_ne_zero.mpr fun hba => ha (hba ▸ hb))

/-- A sequence is **planar** when on every chain `Γ_m, Γ_{mp}, Γ_{mp²}, …`, `p ∤ m`, and up to
every length it is, after multiplication by an integer prime to `p`, an integer polynomial in
the node. -/
def IsPlanar (x : ℕ+ → ℤ) : Prop :=
  ∀ (p : Nat.Primes) (m : ℕ+), ¬ (p : ℕ) ∣ m → ∀ K : ℕ, ∃ (D : ℤ) (g : ℤ[X]),
    ¬ ((p : ℕ) : ℤ) ∣ D ∧ ∀ l ≤ K, D * x (m * primePNat p ^ l) = g.eval (chainNode p l)

/-- **Payment on a chain.** A planar sequence vanishing on the graphs `Γ_{m p^l}`, `l ∈ T`, is
divisible on `Γ_{m p^k}`, `k ∉ T`, by `p^{Σ_{l ∈ T} (min(k,l)+1)}`: the product of its contacts
in the square with all these graphs. -/
theorem pow_sum_dvd_of_isPlanar {x : ℕ+ → ℤ} (hx : IsPlanar x) (p : Nat.Primes) {m : ℕ+}
    (hm : ¬ (p : ℕ) ∣ m) (k : ℕ) (T : Finset ℕ) (hk : k ∉ T)
    (hvan : ∀ l ∈ T, x (m * primePNat p ^ l) = 0) :
    ((p : ℕ) : ℤ) ^ (∑ l ∈ T, (min k l + 1)) ∣ x (m * primePNat p ^ k) := by
  obtain ⟨D, g, hD, hg⟩ := hx p m hm (max k (T.sup id))
  have hpz : Prime ((p : ℕ) : ℤ) := Nat.prime_iff_prime_int.mp p.2
  have hinj : Function.Injective (chainNode p) := (chainNode_strictMono p.2.pos).injective
  -- the polynomial vanishes at the nodes of `T`
  have hroot : ∀ a ∈ T.image (chainNode p), g.eval a = 0 := by
    intro a ha
    obtain ⟨l, hl, rfl⟩ := Finset.mem_image.mp ha
    rw [← hg l (le_max_of_le_right (Finset.le_sup (f := id) hl)), hvan l hl, mul_zero]
  have hdvd := prod_sub_dvd_eval g (T.image (chainNode p)) hroot (chainNode p k)
  rw [Finset.prod_image fun a _ b _ h => hinj h, ← hg k (le_max_left _ _)] at hdvd
  refine hpz.pow_dvd_of_dvd_mul_left _ hD (dvd_trans ?_ hdvd)
  rw [← Finset.prod_pow_eq_pow_sum]
  exact Finset.prod_dvd_prod_of_dvd _ _ fun l _ => pow_min_succ_dvd_chainNode_sub p k l

/-- **A planar sequence is a section of the square.** -/
theorem isGhost_of_isPlanar {x : ℕ+ → ℤ} (hx : IsPlanar x) : IsGhost x := by
  intro q hq n
  set P : Nat.Primes := ⟨q, hq⟩ with hP
  obtain ⟨m, hm, hn⟩ := exists_chain_decomposition P n
  set v := (n : ℕ).factorization (q : ℕ) with hv
  have hqP : primePNat P = q := PNat.eq rfl
  obtain ⟨D, g, hD, hg⟩ := hx P m hm (v + 1)
  have hpz : Prime ((q : ℕ) : ℤ) := Nat.prime_iff_prime_int.mp hq
  have h1 : q * n = m * primePNat P ^ (v + 1) := by
    rw [hn, hqP, pow_succ]
    exact mul_left_comm _ _ _
  have h2 : n = m * primePNat P ^ v := hn
  refine hpz.pow_dvd_of_dvd_mul_left _ hD ?_
  rw [mul_sub, h1, hg (v + 1) le_rfl, ← hqP]
  conv_lhs => rw [show ((primePNat P : ℕ) : ℤ) ^ (v + 1) = chainNode P (v + 1) - chainNode P v by
    rw [chainNode_succ, add_sub_cancel_left]; rfl]
  have h3 : D * x n = g.eval (chainNode P v) := by
    conv_lhs => rw [h2]
    exact hg v (Nat.le_succ v)
  rw [hqP, h3]
  exact Polynomial.sub_dvd_eval_sub _ _ g

/-- Every element of the ring of the coordinates is planar. -/
theorem isPlanar_coordHom (f : MvPolynomial Nat.Primes ℤ) : IsPlanar (coordHom f).1 := by
  intro p m hm K
  refine ⟨1, linePoly f p (latticePoint m),
    (Nat.prime_iff_prime_int.mp p.2).not_dvd_one, fun l _ => ?_⟩
  rw [one_mul]
  exact ghostComponent_coordHom_chain f p hm l

/-! ### Every contact of the normal form is paid -/

/-- The graphs of a finite set on the chain of `m` at `p`, other than `Γ_m`, are at most as many
as the exponent of `p` in the value of a planar sequence on `Γ_m` that vanishes on the set. -/
theorem card_chain_le_factorization {x : ℕ+ → ℤ} (hx : IsPlanar x) (m : ℕ+) (S : Finset ℕ+)
    (hvan : ∀ n ∈ S, x n = 0) (hne : x m ≠ 0) {p : ℕ} (hp : p.Prime) :
    (S.filter fun n : ℕ+ => (n : ℕ) * p ^ (m : ℕ).factorization p =
        (m : ℕ) * p ^ (n : ℕ).factorization p).card ≤ (x m).natAbs.factorization p := by
  set P : Nat.Primes := ⟨p, hp⟩
  obtain ⟨m₀, hm₀, hm⟩ := exists_chain_decomposition P m
  set k := (m : ℕ).factorization p with hk
  set F := S.filter fun n : ℕ+ => (n : ℕ) * p ^ k = (m : ℕ) * p ^ (n : ℕ).factorization p with hF
  -- a graph of the filter is `Γ_{m₀ p^l}` with `l` its exponent of `p`
  have hchain : ∀ n ∈ F, n = m₀ * primePNat P ^ ((n : ℕ).factorization p) := by
    intro n hn
    have h := (Finset.mem_filter.mp hn).2
    refine PNat.eq (Nat.eq_of_mul_eq_mul_right (pow_pos hp.pos k) ?_)
    rw [h, hm, PNat.mul_coe, PNat.mul_coe, PNat.pow_coe, PNat.pow_coe, primePNat_coe]
    ring
  set T := F.image fun n : ℕ+ => (n : ℕ).factorization p with hT
  have hinj : Set.InjOn (fun n : ℕ+ => (n : ℕ).factorization p) F := by
    intro a ha b hb hab
    rw [hchain a (Finset.mem_coe.mp ha), hchain b (Finset.mem_coe.mp hb)]
    exact congrArg (fun l => m₀ * primePNat P ^ l) hab
  have hkT : k ∉ T := by
    intro hkT
    obtain ⟨n, hn, hnk⟩ := Finset.mem_image.mp hkT
    have hnm : n = m := by
      have h1 := hchain n hn
      have hnk' : (n : ℕ).factorization p = k := hnk
      rw [hnk'] at h1
      exact h1.trans hm.symm
    exact hne (hnm ▸ hvan n (Finset.mem_filter.mp hn).1)
  have hvanT : ∀ l ∈ T, x (m₀ * primePNat P ^ l) = 0 := by
    intro l hl
    obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp hl
    rw [← hchain n hn]
    exact hvan n (Finset.mem_filter.mp hn).1
  have hdvd := pow_sum_dvd_of_isPlanar hx P hm₀ k T hkT hvanT
  rw [← hm] at hdvd
  have hcard : F.card ≤ ∑ l ∈ T, (min k l + 1) := by
    rw [← Finset.card_image_of_injOn hinj, Finset.card_eq_sum_ones]
    exact Finset.sum_le_sum fun l _ => Nat.le_add_left 1 _
  have hdvd' : p ^ F.card ∣ (x m).natAbs := by
    rw [← Int.natCast_dvd, Nat.cast_pow]
    exact (pow_dvd_pow _ hcard).trans hdvd
  exact (hp.pow_dvd_iff_le_factorization (Int.natAbs_ne_zero.mpr hne)).mp hdvd'

/-- A contact of the normal form between two distinct degree points is at most `log p` summed
over the primes `p` of a set containing the primes of both points, on whose chain the two points
lie together. -/
theorem contact_le_sum_chain {m n : ℕ+} (hmn : n ≠ m) {U : Finset ℕ}
    (hU : ∀ p : ℕ, p.Prime → p ∣ (m : ℕ) * n → p ∈ U) :
    ((if (m : ℕ) ∣ n then (Λ ((n : ℕ) / m) : ℝ) else 0) +
        (if (n : ℕ) ∣ m then (Λ ((m : ℕ) / n) : ℝ) else 0)) ≤
      ∑ p ∈ U, if p.Prime ∧ (n : ℕ) * p ^ (m : ℕ).factorization p =
        (m : ℕ) * p ^ (n : ℕ).factorization p then Real.log p else 0 := by
  have hnonneg : ∀ p ∈ U, (0 : ℝ) ≤ if p.Prime ∧ (n : ℕ) * p ^ (m : ℕ).factorization p =
      (m : ℕ) * p ^ (n : ℕ).factorization p then Real.log p else 0 := by
    intro p _
    split_ifs with h
    · exact Real.log_nonneg (by exact_mod_cast h.1.one_le)
    · exact le_rfl
  -- one degree point divides the other by a prime power `q^j`
  have key : ∀ a b : ℕ+, (a : ℕ) ∣ b → IsPrimePow ((b : ℕ) / a) →
      (∀ p : ℕ, p.Prime → p ∣ (b : ℕ) → p ∈ U) →
      ∃ q ∈ U, q.Prime ∧ (Λ ((b : ℕ) / a) : ℝ) = Real.log q ∧
        (b : ℕ) * q ^ (a : ℕ).factorization q = (a : ℕ) * q ^ (b : ℕ).factorization q := by
    intro a b hab hpp hUb
    obtain ⟨q, j, hq, hj, hqj⟩ := (isPrimePow_nat_iff _).mp hpp
    have hb : (b : ℕ) = a * q ^ j := by
      rw [hqj, Nat.mul_div_cancel' hab]
    refine ⟨q, hUb q hq (hb ▸ Dvd.dvd.mul_left (dvd_pow_self q hj.ne') _), hq, ?_, ?_⟩
    · rw [← hqj, ArithmeticFunction.vonMangoldt_apply_pow hj.ne',
        ArithmeticFunction.vonMangoldt_apply_prime hq]
    · rw [hb, Nat.factorization_mul a.ne_zero (pow_ne_zero _ hq.ne_zero), Finsupp.add_apply,
        Nat.factorization_pow, hq.factorization, Finsupp.smul_apply, Finsupp.single_eq_same,
        smul_eq_mul, mul_one, pow_add]
      ring
  by_cases h1 : (m : ℕ) ∣ n
  · have h2 : ¬ (n : ℕ) ∣ m := fun h2 => hmn (PNat.eq (Nat.dvd_antisymm h2 h1))
    rw [if_pos h1, if_neg h2, add_zero]
    by_cases hpp : IsPrimePow ((n : ℕ) / m)
    · obtain ⟨q, hqU, hq, hΛ, hrel⟩ := key m n h1 hpp fun p hp hpn =>
        hU p hp (Dvd.dvd.mul_left hpn _)
      rw [hΛ]
      refine le_trans (le_of_eq ?_) (Finset.single_le_sum hnonneg hqU)
      rw [if_pos ⟨hq, hrel⟩]
    · rw [ArithmeticFunction.vonMangoldt_eq_zero_iff.mpr hpp]
      exact Finset.sum_nonneg hnonneg
  · rw [if_neg h1, zero_add]
    by_cases h2 : (n : ℕ) ∣ m
    · rw [if_pos h2]
      by_cases hpp : IsPrimePow ((m : ℕ) / n)
      · obtain ⟨q, hqU, hq, hΛ, hrel⟩ := key n m h2 hpp fun p hp hpm =>
          hU p hp (Dvd.dvd.mul_right hpm _)
        rw [hΛ]
        refine le_trans (le_of_eq ?_) (Finset.single_le_sum hnonneg hqU)
        rw [if_pos ⟨hq, hrel.symm⟩]
      · rw [ArithmeticFunction.vonMangoldt_eq_zero_iff.mpr hpp]
        exact Finset.sum_nonneg hnonneg
    · rw [if_neg h2]
      exact Finset.sum_nonneg hnonneg

/-- **Every contact is paid.** A planar sequence that vanishes on the graphs of a finite set `S`
and not on `Γ_m` is at least as large on `Γ_m` as the contacts of `Γ_m` with the set in the
normal form of the pairing, `Λ(n/m)` for `m ∣ n` and `Λ(m/n)` for `n ∣ m`: the prime powers
above and below are counted each. -/
theorem sum_contact_le_log_abs_of_isPlanar {x : ℕ+ → ℤ} (hx : IsPlanar x) (m : ℕ+)
    (S : Finset ℕ+) (hvan : ∀ n ∈ S, x n = 0) (hne : x m ≠ 0) :
    ∑ n ∈ S, ((if (m : ℕ) ∣ n then (Λ ((n : ℕ) / m) : ℝ) else 0) +
        (if (n : ℕ) ∣ m then (Λ ((m : ℕ) / n) : ℝ) else 0)) ≤ Real.log |((x m : ℤ) : ℝ)| := by
  set N := (x m).natAbs with hN
  have hN0 : N ≠ 0 := Int.natAbs_ne_zero.mpr hne
  set U : Finset ℕ := N.primeFactors ∪ ((m : ℕ) * ∏ n ∈ S, (n : ℕ)).primeFactors with hU
  have hprod0 : (m : ℕ) * ∏ n ∈ S, (n : ℕ) ≠ 0 :=
    mul_ne_zero m.ne_zero (Finset.prod_ne_zero_iff.mpr fun n _ => n.ne_zero)
  have hUprime : ∀ p ∈ U, p.Prime := by
    intro p hp
    rcases Finset.mem_union.mp hp with h | h <;> exact Nat.prime_of_mem_primeFactors h
  -- contacts, summed chain by chain
  have h1 : ∑ n ∈ S, ((if (m : ℕ) ∣ n then (Λ ((n : ℕ) / m) : ℝ) else 0) +
        (if (n : ℕ) ∣ m then (Λ ((m : ℕ) / n) : ℝ) else 0)) ≤
      ∑ n ∈ S, ∑ p ∈ U, if p.Prime ∧ (n : ℕ) * p ^ (m : ℕ).factorization p =
        (m : ℕ) * p ^ (n : ℕ).factorization p then Real.log p else 0 := by
    refine Finset.sum_le_sum fun n hn => contact_le_sum_chain
      (fun h => hne (h ▸ hvan n hn)) fun p hp hpd => ?_
    refine Finset.mem_union_right _ (Nat.mem_primeFactors.mpr ⟨hp, ?_, hprod0⟩)
    rcases (Nat.Prime.dvd_mul hp).mp hpd with h | h
    · exact Dvd.dvd.mul_right h _
    · exact Dvd.dvd.mul_left (h.trans (Finset.dvd_prod_of_mem _ hn)) _
  have h2 : ∑ n ∈ S, ∑ p ∈ U, (if p.Prime ∧ (n : ℕ) * p ^ (m : ℕ).factorization p =
        (m : ℕ) * p ^ (n : ℕ).factorization p then Real.log p else 0) ≤
      ∑ p ∈ U, (N.factorization p : ℝ) * Real.log p := by
    rw [Finset.sum_comm]
    refine Finset.sum_le_sum fun p hp => ?_
    have hpp := hUprime p hp
    have hcard := card_chain_le_factorization hx m S hvan hne hpp
    have hlog : 0 ≤ Real.log p := Real.log_nonneg (by exact_mod_cast hpp.one_le)
    calc ∑ n ∈ S, (if p.Prime ∧ (n : ℕ) * p ^ (m : ℕ).factorization p =
          (m : ℕ) * p ^ (n : ℕ).factorization p then Real.log p else 0)
        = ((S.filter fun n : ℕ+ => (n : ℕ) * p ^ (m : ℕ).factorization p =
            (m : ℕ) * p ^ (n : ℕ).factorization p).card : ℝ) * Real.log p := by
          rw [Finset.card_filter, Nat.cast_sum, Finset.sum_mul]
          refine Finset.sum_congr rfl fun n _ => ?_
          by_cases h : (n : ℕ) * p ^ (m : ℕ).factorization p =
              (m : ℕ) * p ^ (n : ℕ).factorization p
          · rw [if_pos ⟨hpp, h⟩, if_pos h, Nat.cast_one, one_mul]
          · rw [if_neg fun h' => h h'.2, if_neg h, Nat.cast_zero, zero_mul]
      _ ≤ (N.factorization p : ℝ) * Real.log p :=
          mul_le_mul_of_nonneg_right (by exact_mod_cast hcard) hlog
  have h3 : ∑ p ∈ U, (N.factorization p : ℝ) * Real.log p = Real.log |((x m : ℤ) : ℝ)| := by
    have habs : |((x m : ℤ) : ℝ)| = (N : ℝ) := by
      rw [hN, ← Int.cast_abs, Int.abs_eq_natAbs, Int.cast_natCast]
    rw [habs, Real.log_nat_eq_sum_factorization, Finsupp.sum, Nat.support_factorization]
    refine (Finset.sum_subset Finset.subset_union_left fun p _ hp => ?_).symm
    rw [Finsupp.notMem_support_iff.mp (by rwa [Nat.support_factorization]), Nat.cast_zero,
      zero_mul]
  exact h1.trans (h2.trans h3.le)

/-- **Every contact is paid in the ring of the coordinates.** -/
theorem sum_contact_le_log_abs_coordHom (f : MvPolynomial Nat.Primes ℤ) (m : ℕ+)
    (S : Finset ℕ+) (hvan : ∀ n ∈ S, ghostComponent n (coordHom f) = 0)
    (hne : ghostComponent m (coordHom f) ≠ 0) :
    ∑ n ∈ S, ((if (m : ℕ) ∣ n then (Λ ((n : ℕ) / m) : ℝ) else 0) +
        (if (n : ℕ) ∣ m then (Λ ((m : ℕ) / n) : ℝ) else 0)) ≤
      Real.log |((ghostComponent m (coordHom f) : ℤ) : ℝ)| :=
  sum_contact_le_log_abs_of_isPlanar (isPlanar_coordHom f) m S hvan hne

/-- **The prime powers above the diagonal are paid.** A planar sequence vanishing on
`Γ_p, Γ_{p²}, …, Γ_{p^J}` is divisible by `p^J` on the diagonal. -/
theorem prime_pow_dvd_of_isPlanar {x : ℕ+ → ℤ} (hx : IsPlanar x) (p : Nat.Primes) (J : ℕ)
    (hvan : ∀ j ∈ Icc 1 J, x (primePNat p ^ j) = 0) : ((p : ℕ) : ℤ) ^ J ∣ x 1 := by
  have h1 : ¬ (p : ℕ) ∣ ((1 : ℕ+) : ℕ) := by
    rw [PNat.one_coe, Nat.dvd_one]; exact p.2.ne_one
  have h := pow_sum_dvd_of_isPlanar hx p h1 0 (Icc 1 J) (by simp)
    (fun l hl => by rw [one_mul]; exact hvan l hl)
  simp only [Nat.zero_min, zero_add, Finset.sum_const, Nat.card_Icc, add_tsub_cancel_right,
    smul_eq_mul, mul_one, one_mul, pow_zero, mul_one] at h
  exact h

/-! ### What is lost -/

/-- The section `p − e_p` of the square, which vanishes on every `Γ_{p^j}`, `j ≥ 1`, and is `p`
on the diagonal, is not in the ring of the coordinates. -/
theorem prime_sub_orbit_notMem_payingRing (p : Nat.Primes) :
    (((p : ℕ) : ℤ) : ghostRing) - orbit (primePNat p) ∉ payingRing := by
  rintro ⟨f, hf⟩
  have hplanar := isPlanar_coordHom f
  rw [hf] at hplanar
  have hcomp : ∀ n : ℕ+, ((((p : ℕ) : ℤ) : ghostRing) - orbit (primePNat p)).1 n =
      ((p : ℕ) : ℤ) - if (p : ℕ) ∣ n then ((p : ℕ) : ℤ) else 0 := by
    intro n
    change ghostComponent n ((((p : ℕ) : ℤ) : ghostRing) - orbit (primePNat p)) = _
    rw [map_sub, map_intCast, ghostComponent_apply, orbit_apply, primePNat_coe]
    simp
  have hvan : ∀ j ∈ Icc 1 2,
      ((((p : ℕ) : ℤ) : ghostRing) - orbit (primePNat p)).1 (primePNat p ^ j) = 0 := by
    intro j hj
    rw [hcomp, PNat.pow_coe, primePNat_coe,
      if_pos (dvd_pow_self _ (Nat.one_le_iff_ne_zero.mp (Finset.mem_Icc.mp hj).1)), sub_self]
  have h := prime_pow_dvd_of_isPlanar hplanar p 2 hvan
  rw [hcomp, PNat.one_coe, if_neg (by rw [Nat.dvd_one]; exact p.2.ne_one), sub_zero, sq] at h
  have hpz : Prime ((p : ℕ) : ℤ) := Nat.prime_iff_prime_int.mp p.2
  have h1 : ((p : ℕ) : ℤ) ∣ 1 := by
    have h' : ((p : ℕ) : ℤ) * (p : ℕ) ∣ ((p : ℕ) : ℤ) * 1 := by rwa [mul_one]
    exact (mul_dvd_mul_iff_left hpz.ne_zero).mp h'
  exact hpz.not_dvd_one h1

/-- **The contacts of the ring.** On two graphs of a chain an element of the ring differs by a
multiple of the difference of the nodes. -/
theorem chainNode_sub_dvd_coordHom (f : MvPolynomial Nat.Primes ℤ) (p : Nat.Primes) {m : ℕ+}
    (hm : ¬ (p : ℕ) ∣ m) (k l : ℕ) :
    chainNode p k - chainNode p l ∣ ghostComponent (m * primePNat p ^ k) (coordHom f) -
      ghostComponent (m * primePNat p ^ l) (coordHom f) := by
  rw [ghostComponent_coordHom_chain f p hm, ghostComponent_coordHom_chain f p hm]
  exact Polynomial.sub_dvd_eval_sub _ _ _

/-- **A contact that the square does not have.** Every element of the ring of the coordinates
agrees modulo `3` on `Γ_1` and `Γ_4`; in the square these graphs meet at the prime `2` only. -/
theorem three_dvd_sub_of_mem_payingRing {x : ghostRing} (hx : x ∈ payingRing) :
    (3 : ℤ) ∣ ghostComponent 1 x - ghostComponent 4 x := by
  obtain ⟨f, rfl⟩ := hx
  set P2 : Nat.Primes := ⟨2, Nat.prime_two⟩
  have h1 : ¬ (P2 : ℕ) ∣ ((1 : ℕ+) : ℕ) := by decide
  have h := chainNode_sub_dvd_coordHom f P2 h1 0 2
  have e0 : (1 : ℕ+) * primePNat P2 ^ 0 = 1 := by simp
  have e2 : (1 : ℕ+) * primePNat P2 ^ 2 = 4 := by
    rw [one_mul]; exact PNat.eq rfl
  rw [e0, e2] at h
  have hnode : chainNode P2 0 - chainNode P2 2 = 3 * (-2) := by
    rw [chainNode_zero, chainNode_succ, chainNode_succ, chainNode_zero]
    norm_num [P2]
  rw [hnode] at h
  exact (dvd_mul_right 3 (-2)).trans h

/-- The orbit `e_2` of the square does not agree modulo `3` on `Γ_1` and `Γ_4`. -/
theorem not_three_dvd_orbit_two :
    ¬ (3 : ℤ) ∣ ghostComponent 1 (orbit 2) - ghostComponent 4 (orbit 2) := by
  rw [ghostComponent_apply, ghostComponent_apply, orbit_apply, orbit_apply]
  decide

/-- **The forced zeros are attained, and they are the product formula.** The section
`∏_{l ∈ T} (Y_p − (p + ⋯ + p^l))` vanishes on the graphs `Γ_{m p^l}`, `l ∈ T`, and on `Γ_{m p^k}`
it is the product of the differences of the nodes. -/
theorem ghostComponent_coordHom_nodeProduct (p : Nat.Primes) {m : ℕ+} (hm : ¬ (p : ℕ) ∣ m)
    (T : Finset ℕ) (k : ℕ) :
    ghostComponent (m * primePNat p ^ k)
        (coordHom (∏ l ∈ T, (MvPolynomial.X p - MvPolynomial.C (chainNode p l)))) =
      ∏ l ∈ T, (chainNode p k - chainNode p l) := by
  rw [ghostComponent_coordHom, map_prod]
  refine Finset.prod_congr rfl fun l _ => ?_
  rw [map_sub, MvPolynomial.eval_X, MvPolynomial.eval_C, latticePoint, factorization_chain p hm]

/-! ### The ring is the polynomial ring on the primes -/

/-- **A polynomial on the primes that vanishes on every graph is zero**: the graphs are the
points of a product of infinite sets of nodes. -/
theorem coordHom_injective : Function.Injective coordHom := by
  classical
  rw [injective_iff_map_eq_zero]
  intro f hf
  obtain ⟨s, q, rfl⟩ := MvPolynomial.exists_finset_rename f
  set e : {x // x ∈ s} ≃ Fin s.card := s.equivFin with he
  set c : ℤ →+* ℂ := Int.castRingHom ℂ with hc
  have hcinj : Function.Injective c := Int.cast_injective
  -- the polynomial in finitely many complex variables
  set Q : MvPolynomial (Fin s.card) ℂ := MvPolynomial.map c (MvPolynomial.rename e q) with hQ
  have hQ0 : Q = 0 := by
    refine HTGeometry.mvPolynomial_eq_zero_of_eval_eq_zero_on_pi_infinite s.card
      (fun j => Set.range fun l : ℕ => ((chainNode ((e.symm j : {x // x ∈ s}) : Nat.Primes) l : ℤ) : ℂ))
      (fun j => Set.infinite_range_of_injective
        (hcinj.comp (chainNode_strictMono (e.symm j).1.2.pos).injective)) Q fun x hx => ?_
    choose l hl using hx
    -- the degree point with the exponents `l`
    set n : ℕ+ := ⟨∏ a : {x // x ∈ s}, ((a : Nat.Primes) : ℕ) ^ l (e a),
      Finset.prod_pos fun a _ => pow_pos a.1.2.pos _⟩ with hn
    have hfac : ∀ a : {x // x ∈ s}, (n : ℕ).factorization ((a : Nat.Primes) : ℕ) = l (e a) := by
      intro a
      rw [hn, PNat.mk_coe, Nat.factorization_prod fun b _ => pow_ne_zero _ b.1.2.ne_zero,
        Finset.sum_apply']
      rw [Finset.sum_eq_single a]
      · rw [Nat.factorization_pow, a.1.2.factorization, Finsupp.smul_apply,
          Finsupp.single_eq_same, smul_eq_mul, mul_one]
      · intro b _ hb
        rw [Nat.factorization_pow, b.1.2.factorization, Finsupp.smul_apply,
          Finsupp.single_eq_of_ne (fun h => hb (Subtype.ext (Subtype.ext h)).symm), smul_zero]
      · intro h; exact absurd (Finset.mem_univ a) h
    have hx' : x = fun j => c (latticePoint n ((e.symm j : {x // x ∈ s}) : Nat.Primes)) := by
      funext j
      rw [← hl j, latticePoint, hfac (e.symm j), Equiv.apply_symm_apply]
      rfl
    have hval : MvPolynomial.eval (latticePoint n)
        (MvPolynomial.rename (Subtype.val : {x // x ∈ s} → Nat.Primes) q) = 0 := by
      rw [← ghostComponent_coordHom, hf, map_zero]
    rw [hQ, hx', MvPolynomial.eval_map, ← Function.comp_def c, ← MvPolynomial.eval₂_comp_left,
      MvPolynomial.eval₂_rename]
    rw [MvPolynomial.eval_rename] at hval
    have hcomp : ((fun j => latticePoint n ((e.symm j : {x // x ∈ s}) : Nat.Primes)) ∘ e) =
        latticePoint n ∘ (Subtype.val : {x // x ∈ s} → Nat.Primes) := by
      funext a
      simp [Function.comp]
    rw [hcomp]
    change c (MvPolynomial.eval₂ (RingHom.id ℤ) (latticePoint n ∘ Subtype.val) q) = 0
    rw [← MvPolynomial.eval, hval, map_zero]
  have hmap : MvPolynomial.rename e q = 0 :=
    MvPolynomial.map_injective c hcinj (by rw [← hQ, hQ0, map_zero])
  have hq : q = 0 := MvPolynomial.rename_injective e e.injective (by rw [hmap, map_zero])
  rw [hq, map_zero]

end GaloisForLFunctions.AbsoluteGeometryOfSpecZ
