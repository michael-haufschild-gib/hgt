import GaloisForLFunctions.ArithmeticHarmonicAnalysis.FiniteGroup.GreedyProductContainers
import Mathlib.GroupTheory.OrderOfElement

/-!
# Repeated factors restore subgroup invariance

The subproducts of repeated copies of `g` are its initial powers. Once their number
reaches `orderOf g - 1`, these powers fill the cyclic subgroup generated by `g`.
Consequently, adjoining the remaining factors preserves invariance under `g`.
All sufficiently repeated elements together generate a subgroup of the final stabilizer.
-/

open Finset
open scoped Pointwise

namespace GaloisForLFunctions.ArithmeticHarmonicAnalysis.FiniteGroup

open HTGeometry.AddComb

variable {G ι : Type*} [CommGroup G] [Fintype G] [DecidableEq G] [DecidableEq ι]

omit [Fintype G] in
/-- Repeating a single factor produces exactly its initial powers. -/
theorem subproducts_const (g : G) (I : Finset ι) :
    subproducts (fun _ : ι => g) I = (range (I.card + 1)).image (fun k => g ^ k) := by
  induction I using Finset.induction_on with
  | empty => simp [subproducts]; rfl
  | @insert i I hi ih =>
    rw [subproducts_insert _ I i hi, ih, card_insert_of_notMem hi]
    ext x
    constructor
    · intro hx
      rcases mem_union.mp hx with hx | hx
      · obtain ⟨k, hk, rfl⟩ := mem_image.mp hx
        exact mem_image.mpr ⟨k, mem_range.mpr (by have := mem_range.mp hk; omega), rfl⟩
      · obtain ⟨y, hy, rfl⟩ := mem_smul_finset.mp hx
        obtain ⟨k, hk, rfl⟩ := mem_image.mp hy
        exact mem_image.mpr ⟨k + 1, mem_range.mpr (by have := mem_range.mp hk; omega),
          by simp only [smul_eq_mul, pow_succ']⟩
    · intro hx
      obtain ⟨k, hk, rfl⟩ := mem_image.mp hx
      cases k with
      | zero =>
        exact mem_union_left _ (mem_image.mpr ⟨0, mem_range.mpr (by omega), rfl⟩)
      | succ k =>
        apply mem_union_right
        exact mem_smul_finset.mpr ⟨g ^ k,
          mem_image.mpr ⟨k, mem_range.mpr (by have := mem_range.mp hk; omega), rfl⟩,
          by simp only [smul_eq_mul, pow_succ']⟩

private theorem const_subproducts_smul (g : G) (I : Finset ι)
    (hcount : orderOf g ≤ I.card + 1) :
    g • subproducts (fun _ : ι => g) I = subproducts (fun _ : ι => g) I := by
  have hmem (x : G) : x ∈ subproducts (fun _ : ι => g) I ↔ x ∈ Subgroup.zpowers g := by
    rw [subproducts_const]
    constructor
    · rintro hx
      obtain ⟨k, _, rfl⟩ := mem_image.mp hx
      exact (Subgroup.zpowers g).pow_mem (Subgroup.mem_zpowers g) k
    · intro hx
      have hrange := mem_zpowers_iff_mem_range_orderOf.mp hx
      exact image_subset_image (range_mono hcount) hrange
  apply eq_of_subset_of_card_le
  · intro x hx
    obtain ⟨y, hy, rfl⟩ := mem_smul_finset.mp hx
    apply (hmem _).mpr
    exact (Subgroup.zpowers g).mul_mem (Subgroup.mem_zpowers g) ((hmem y).mp hy)
  · rw [card_smul_finset]

/-- An element outside the final stabilizer occurs fewer than `orderOf g - 1` times. -/
theorem repeated_factor_stabilizes_or_short (q : ι → G) (I : Finset ι) (g : G) :
    g ∈ mulStab (subproducts q I) ∨ (I.filter fun i => q i = g).card + 1 < orderOf g := by
  by_cases hcount : orderOf g ≤ (I.filter fun i => q i = g).card + 1
  · left
    let J := I.filter fun i => q i = g
    have hconst : subproducts q J = subproducts (fun _ : ι => g) J := by
      unfold subproducts
      apply prod_congr rfl
      intro i hi
      rw [(mem_filter.mp hi).2]
    have hfix : g • subproducts q J = subproducts q J := by
      rw [hconst]
      exact const_subproducts_smul g J hcount
    have hfactor : subproducts q (I \ J) * subproducts q J = subproducts q I :=
      prod_sdiff (filter_subset _ _)
    rw [mem_mulStab, ← hfactor, ← mul_smul_comm, hfix]
  · exact Or.inr (Nat.lt_of_not_ge hcount)

/-- Elements with sufficient multiplicity generate a subgroup of the final stabilizer. -/
theorem repeated_factor_closure_le_stabilizer (q : ι → G) (I : Finset ι) :
    Subgroup.closure {g : G | orderOf g ≤ (I.filter fun i => q i = g).card + 1} ≤
      stabSubgroup (subproducts q I) := by
  apply (Subgroup.closure_le _).mpr
  intro g hg
  have h := (repeated_factor_stabilizes_or_short q I g).resolve_right (not_lt.mpr hg)
  exact mem_mulStab.mp h

/-- The restored subgroup consists entirely of represented subproducts. -/
theorem repeated_factor_closure_subset_subproducts (q : ι → G) (I : Finset ι) :
    (Subgroup.closure {g : G | orderOf g ≤ (I.filter fun i => q i = g).card + 1} : Set G) ⊆
      (subproducts q I : Set G) := by
  intro g hg
  have hperiod := repeated_factor_closure_le_stabilizer q I hg
  have hmem : g ∈ mulStab (subproducts q I) := mem_mulStab.mpr hperiod
  have hsub : mulStab (subproducts q I) ⊆ subproducts q I := by
    simpa only [one_smul] using smul_mulStab_subset (one_mem_subproducts q I)
  exact hsub hmem

end GaloisForLFunctions.ArithmeticHarmonicAnalysis.FiniteGroup

#print axioms GaloisForLFunctions.ArithmeticHarmonicAnalysis.FiniteGroup.subproducts_const
#print axioms GaloisForLFunctions.ArithmeticHarmonicAnalysis.FiniteGroup.repeated_factor_stabilizes_or_short
#print axioms GaloisForLFunctions.ArithmeticHarmonicAnalysis.FiniteGroup.repeated_factor_closure_le_stabilizer
#print axioms GaloisForLFunctions.ArithmeticHarmonicAnalysis.FiniteGroup.repeated_factor_closure_subset_subproducts
