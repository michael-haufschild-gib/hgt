import GaloisForLFunctions.ArithmeticHarmonicAnalysis.FiniteGroup.ReducedResiduePoleOrders

/-!
# Two generators when the residue multiplier divides the modulus

Write `N=A D`. Reducing an index as `i=A a+j` changes its reduced
weight to `A a+(1+mD)j`. This identifies the entire pole-order
semigroup with the semigroup generated by `A` and `1+mD`.
-/

namespace GaloisForLFunctions.ArithmeticHarmonicAnalysis

private theorem reduced_divisor_weight (A D m a j : ℕ) (hD : 0 < D) (hj : j < A) :
    (A * a + j) + m * ((A * a + j) * D % (A * D)) = A * a + (1 + m * D) * j := by
  have hprod : (A * a + j) * D = (A * D) * a + j * D := by ring
  have hlt : j * D < A * D := Nat.mul_lt_mul_of_pos_right hj hD
  rw [hprod, Nat.mul_add_mod_self_left, Nat.mod_eq_of_lt hlt]
  ring

/-- Divisibility of the residue multiplier identifies all reduced-weight orders with an explicit two-generator semigroup. -/
theorem reducedResidue_two_generator_iff (A D m M : ℕ) (hA : 0 < A) (hD : 0 < D) :
    (∃ i : Fin (A * D), ∃ k : ℕ,
      (A * D) * k + (i.val + m * (i.val * D % (A * D))) = M) ↔
      ∃ a b : ℕ, A * a + (1 + m * D) * b = M := by
  constructor
  · rintro ⟨i, k, hi⟩
    have hsplit : i.val = A * (i.val / A) + i.val % A := (Nat.div_add_mod i.val A).symm
    have hweight : i.val + m * (i.val * D % (A * D)) =
        A * (i.val / A) + (1 + m * D) * (i.val % A) := by
      simpa only [← hsplit] using
        reduced_divisor_weight A D m (i.val / A) (i.val % A) hD (Nat.mod_lt _ hA)
    refine ⟨D * k + i.val / A, i.val % A, ?_⟩
    calc
      A * (D * k + i.val / A) + (1 + m * D) * (i.val % A) =
          (A * D) * k + (A * (i.val / A) + (1 + m * D) * (i.val % A)) := by ring
      _ = M := by rw [← hweight]; exact hi
  · rintro ⟨a, b, hab⟩
    let H := 1 + m * D
    let u := a + H * (b / A)
    let j := b % A
    have hj : j < A := Nat.mod_lt _ hA
    have hu : u % D < D := Nat.mod_lt _ hD
    have hbound := Nat.mul_le_mul_left A (Nat.succ_le_of_lt hu)
    change A * (u % D + 1) ≤ A * D at hbound
    have hi : A * (u % D) + j < A * D := by
      rw [mul_add, mul_one] at hbound
      omega
    refine ⟨⟨A * (u % D) + j, hi⟩, u / D, ?_⟩
    change (A * D) * (u / D) +
      ((A * (u % D) + j) + m * ((A * (u % D) + j) * D % (A * D))) = M
    rw [reduced_divisor_weight A D m (u % D) j hD hj]
    calc
      (A * D) * (u / D) + (A * (u % D) + (1 + m * D) * j) =
          A * (D * (u / D) + u % D) + H * j := by dsimp only [H]; ring
      _ = A * u + H * j := by rw [Nat.div_add_mod]
      _ = A * a + H * (A * (b / A) + b % A) := by dsimp only [u, j]; ring
      _ = M := by rw [Nat.div_add_mod]; exact hab

end GaloisForLFunctions.ArithmeticHarmonicAnalysis
