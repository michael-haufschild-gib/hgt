import GaloisForLFunctions.ArithmeticHarmonicAnalysis.Torus.PairedNeutralNilpotence
import GaloisForLFunctions.ArithmeticHarmonicAnalysis.Torus.AffineMomentSystem

/-!
# Every affine paired moment system defines a reduced quotient

A consistent neutral affine system has a polynomial quotient; an inconsistent
system has the zero quotient. Both are reduced. The exact neutral radical
extension theorem therefore proves that every affine paired moment quotient
is reduced, over every field and for arbitrary equation families.

Equivalently, the actual ideal generated by the affine bilinear moment
equations is radical. Membership of a positive power already implies
membership of its base polynomial. Reducible moment fibres can have zero
divisors, but they acquire no nonzero nilpotents.
-/

noncomputable section
namespace GaloisForLFunctions.ArithmeticHarmonicAnalysis
open MvPolynomial Module
variable {ι : Type*} [Fintype ι] (K : Type*) [Field K]

/-- Polynomial coordinates prove reducedness of every neutral moment level. -/
theorem affineMomentQuotient_isReduced (L : Submodule K (ι → K)) (ℓ : L →ₗ[K] K) :
    IsReduced (MvPolynomial ι K ⧸ affineMomentIdeal K L ℓ) := by
  constructor
  intro x hx
  apply (affineMomentPolynomialEquiv K L ℓ).injective
  rw [map_zero]
  exact (hx.map (affineMomentPolynomialEquiv K L ℓ)).eq_zero

/-- Every paired moment level is reduced, including reducible levels. -/
theorem affinePairedQuotient_isReduced (L : Submodule K (ι → K)) (ℓ : L →ₗ[K] K) :
    IsReduced (MvPolynomial (ι ⊕ ι) K ⧸
      (affineMomentIdeal K L ℓ).map (invariantSubstitution K)) :=
  (pairedNeutralQuotient_isReduced_iff K _).mpr (affineMomentQuotient_isReduced K L ℓ)

/-- The bilinear ideal at any prescribed moment level is radical. -/
theorem affinePairedIdeal_isRadical (L : Submodule K (ι → K)) (ℓ : L →ₗ[K] K) :
    ((affineMomentIdeal K L ℓ).map (invariantSubstitution K)).IsRadical :=
  (Ideal.isRadical_iff_quotient_reduced _).mpr (affinePairedQuotient_isReduced K L ℓ)

namespace AffineMomentSystem
variable {α : Type*}

/-- Every affine system has a reduced neutral quotient, including inconsistent systems. -/
theorem neutralQuotient_isReduced (a : α → ι → K) (b : α → K) :
    IsReduced (MvPolynomial ι K ⧸ ideal K a b) := by
  by_cases h : Compatible K a b
  · rw [ideal_eq_affineMomentIdeal K a b h]
    exact affineMomentQuotient_isReduced K _ _
  · rw [ideal_eq_top_of_not_compatible K a b h]
    infer_instance

/-- Arbitrary affine paired moment equations never produce nonzero nilpotents. -/
theorem pairedQuotient_isReduced (a : α → ι → K) (b : α → K) :
    IsReduced (MvPolynomial (ι ⊕ ι) K ⧸ (ideal K a b).map (invariantSubstitution K)) :=
  (pairedNeutralQuotient_isReduced_iff K _).mpr (neutralQuotient_isReduced K a b)

/-- The ideal generated by any affine paired moment family is radical. -/
theorem pairedIdeal_isRadical (a : α → ι → K) (b : α → K) :
    ((ideal K a b).map (invariantSubstitution K)).IsRadical :=
  (Ideal.isRadical_iff_quotient_reduced _).mpr (pairedQuotient_isReduced K a b)

/-- Positive powers satisfy the affine paired equations exactly when their base polynomial does. -/
theorem pairedIdeal_pow_succ_mem_iff (a : α → ι → K) (b : α → K)
    (P : MvPolynomial (ι ⊕ ι) K) (n : ℕ) :
    P ^ (n + 1) ∈ (ideal K a b).map (invariantSubstitution K) ↔
      P ∈ (ideal K a b).map (invariantSubstitution K) := by
  constructor
  · intro h
    apply pairedIdeal_isRadical K a b
    exact ⟨n + 1, h⟩
  · intro h
    exact Ideal.pow_mem_of_mem _ h (n + 1) (Nat.succ_pos n)

end AffineMomentSystem
end GaloisForLFunctions.ArithmeticHarmonicAnalysis

#print axioms GaloisForLFunctions.ArithmeticHarmonicAnalysis.affinePairedQuotient_isReduced
#print axioms GaloisForLFunctions.ArithmeticHarmonicAnalysis.AffineMomentSystem.pairedQuotient_isReduced
#print axioms GaloisForLFunctions.ArithmeticHarmonicAnalysis.AffineMomentSystem.pairedIdeal_isRadical

#print axioms GaloisForLFunctions.ArithmeticHarmonicAnalysis.AffineMomentSystem.pairedIdeal_pow_succ_mem_iff
