import GaloisForLFunctions.ArithmeticHarmonicAnalysis.Torus.AffineMomentSystem
import GaloisForLFunctions.ArithmeticHarmonicAnalysis.Torus.AffineMomentMultiplicity

/-!
# Exact weight multiplicities for arbitrary affine moment systems

For coefficient rank `r` in `N` paired variables, a compatible system has
filtered weight multiplicity `choose (N-r+D-S(q)) (D-S(q))` above the slack.
Inconsistent systems and weights below the slack have multiplicity zero.
The formula measures actual bounded polynomial images in the quotient by
the specified equations, over any field and for any equation index set.

At the first admissible degree, every weight has dimension one exactly when
the moment equations admit a point over the original field. Thus the first
weight dimension detects consistency without assuming the affine level
already descends to the coefficient row space.
-/

noncomputable section
namespace GaloisForLFunctions.ArithmeticHarmonicAnalysis.AffineMomentSystem
open MvPolynomial Module Classical
variable {α ι : Type*} [Fintype ι] (K : Type*) [Field K]

/-- The unit ideal annihilates every bounded weight image. -/
theorem reducedBoundedPairedWeightSpace_top (q : ι → ℤ) (D : ℕ) :
    reducedBoundedPairedWeightSpace K q ⊤ D = ⊥ := by
  have he : (Ideal.Quotient.mkₐ K
      ((⊤ : Ideal (MvPolynomial ι K)).map (invariantSubstitution K))).toLinearMap = 0 := by
    apply LinearMap.ext
    intro p
    change Ideal.Quotient.mk ((⊤ : Ideal (MvPolynomial ι K)).map (invariantSubstitution K)) p = 0
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    rw [Ideal.map_top]
    trivial
  rw [reducedBoundedPairedWeightSpace, he, Submodule.map_zero]

/-- The complete multiplicity formula includes both inconsistent systems and the slack cutoff. -/
theorem finrank_weightSpace (a : α → ι → K) (b : α → K) (q : ι → ℤ) (D : ℕ) :
    finrank K (reducedBoundedPairedWeightSpace K q (ideal K a b) D) =
      if Compatible K a b ∧ weightSlack q ≤ D then
        (Fintype.card ι - finrank K (rowMap K a).range + (D - weightSlack q)).choose
          (D - weightSlack q)
      else 0 := by
  classical
  by_cases h : Compatible K a b
  · rw [ideal_eq_affineMomentIdeal K a b h, finrank_reducedAffineMomentWeightSpace]
    simp only [h, true_and]
  · rw [ideal_eq_top_of_not_compatible K a b h, reducedBoundedPairedWeightSpace_top]
    simp only [finrank_bot, h, false_and, if_false]

/-- The first admissible weight dimension is the indicator of consistency. -/
theorem finrank_weightSpace_at_slack (a : α → ι → K) (b : α → K) (q : ι → ℤ) :
    finrank K (reducedBoundedPairedWeightSpace K q (ideal K a b) (weightSlack q)) =
      if Compatible K a b then 1 else 0 := by
  classical
  rw [finrank_weightSpace]
  simp only [le_refl, and_true, Nat.sub_self, Nat.add_zero, Nat.choose_zero_right]

/-- The same formula for the explicit ideal generated by the paired moment equations. -/
theorem finrank_actualMomentWeightSpace (a : α → ι → K) (b : α → K)
    (q : ι → ℤ) (D : ℕ) :
    finrank K ((boundedPairedWeightSpace K q D).map
      (Ideal.Quotient.mkₐ K (Ideal.span (Set.range (fun j =>
        (∑ i, C (a j i) * (X (Sum.inl i) * X (Sum.inr i))) - C (b j))))).toLinearMap) =
      if Compatible K a b ∧ weightSlack q ≤ D then
        (Fintype.card ι - finrank K (rowMap K a).range + (D - weightSlack q)).choose
          (D - weightSlack q)
      else 0 := by
  classical
  rw [← ideal_extended]
  exact finrank_weightSpace K a b q D

/-- A single first weight component detects a point over the original field. -/
theorem exists_paired_point_iff_first_weight_dimension (a : α → ι → K) (b : α → K)
    (q : ι → ℤ) :
    (∃ z w : ι → K, ∀ j, ∑ i, a j i * (z i * w i) = b j) ↔
      finrank K (reducedBoundedPairedWeightSpace K q (ideal K a b) (weightSlack q)) = 1 := by
  rw [← compatible_iff_exists_paired_point, finrank_weightSpace_at_slack]
  by_cases h : Compatible K a b <;> simp [h]

end GaloisForLFunctions.ArithmeticHarmonicAnalysis.AffineMomentSystem

#print axioms GaloisForLFunctions.ArithmeticHarmonicAnalysis.AffineMomentSystem.finrank_weightSpace
#print axioms GaloisForLFunctions.ArithmeticHarmonicAnalysis.AffineMomentSystem.finrank_actualMomentWeightSpace
#print axioms GaloisForLFunctions.ArithmeticHarmonicAnalysis.AffineMomentSystem.exists_paired_point_iff_first_weight_dimension
