import GaloisForLFunctions.HTGeometry.SymmetricAlgebraSubmoduleQuotient
import GaloisForLFunctions.ArithmeticHarmonicAnalysis.Torus.PairedWeightQuotient
import Mathlib.LinearAlgebra.SymmetricAlgebra.Basis
import Mathlib.LinearAlgebra.FiniteDimensional.Defs
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.Tactic

/-!
# Linear moment equations and polynomial coordinates

A relation subspace `L ≤ K^ι` generates linear equations in the neutral
variables `hᵢ`. The quotient is the symmetric algebra of `K^ι/L`, hence a
polynomial ring in `|ι| - dim L` variables. Extending these equations by
`hᵢ = zᵢwᵢ` identifies every paired torus-weight component with this ring.

Both the coordinate map and a polynomial section send variables to linear
forms. Thus the isomorphism identifies the actual bounded-degree images,
which is the filtration needed for the cut multiplicities in §6.1 of Brown,
*Equivariant Quantisation of Hypertoric Varieties via Symplectic Cuts*.
The relation space may be generated by dependent or infinitely many equations.
-/

noncomputable section
namespace GaloisForLFunctions.ArithmeticHarmonicAnalysis
open MvPolynomial Module
open HTGeometry.SymmetricAlgebraSubmoduleQuotient
variable {ι : Type*} [Fintype ι] (K : Type*) [Field K]

/-- The linear polynomial with the specified coefficient vector. -/
def momentLinearForm : (ι → K) →ₗ[K] MvPolynomial ι K :=
  (Pi.basisFun K ι).constr K X

theorem momentLinearForm_apply (c : ι → K) :
    momentLinearForm K c = ∑ i, c i • X i := by
  classical
  rw [momentLinearForm, Basis.constr_apply]
  rw [Finsupp.sum_fintype _ _ (by intro i; simp)]
  simp

/-- The ideal generated by the full subspace of linear moment relations. -/
def momentLinearIdeal (L : Submodule K (ι → K)) : Ideal (MvPolynomial ι K) :=
  Ideal.span (momentLinearForm K '' (L : Set (ι → K)))

/-- Coordinate transport identifies these equations with a symmetric-algebra linear ideal. -/
theorem momentLinearIdeal_eq_map (L : Submodule K (ι → K)) :
    momentLinearIdeal K L =
      Ideal.map (SymmetricAlgebra.equivMvPolynomial (Pi.basisFun K ι)).toRingHom
        (linearIdeal L) := by
  rw [momentLinearIdeal, linearIdeal, Ideal.map_span, Set.image_image]
  have he (c : ι → K) :
      SymmetricAlgebra.equivMvPolynomial (Pi.basisFun K ι)
        (SymmetricAlgebra.ι K (ι → K) c) = momentLinearForm K c :=
    SymmetricAlgebra.lift_ι_apply _ _
  apply congrArg Ideal.span
  apply congrArg (fun f : (ι → K) → MvPolynomial ι K => f '' (L : Set (ι → K)))
  funext c
  exact (he c).symm

/-- Linear equations quotient the generator space before taking its symmetric algebra. -/
def momentQuotientSymmetricEquiv (L : Submodule K (ι → K)) :
    (MvPolynomial ι K ⧸ momentLinearIdeal K L) ≃ₐ[K]
      SymmetricAlgebra K ((ι → K) ⧸ L) :=
  (Ideal.quotientEquivAlg (linearIdeal L) (momentLinearIdeal K L)
    (SymmetricAlgebra.equivMvPolynomial (Pi.basisFun K ι))
    (momentLinearIdeal_eq_map K L)).symm.trans (quotientEquiv L)

/-- A basis of the quotient generator space gives polynomial coordinates on the moment quotient. -/
def momentQuotientPolynomialEquiv (L : Submodule K (ι → K)) :
    (MvPolynomial ι K ⧸ momentLinearIdeal K L) ≃ₐ[K]
      MvPolynomial (Fin (Module.finrank K ((ι → K) ⧸ L))) K :=
  (momentQuotientSymmetricEquiv K L).trans
    (SymmetricAlgebra.equivMvPolynomial (Module.finBasis K _))

/-- Only the rank of the relation space removes neutral coordinates. -/
theorem momentQuotient_variable_count (L : Submodule K (ι → K)) :
    Module.finrank K ((ι → K) ⧸ L) = Fintype.card ι - Module.finrank K L := by
  have h := Submodule.finrank_quotient_add_finrank L
  rw [Module.finrank_pi] at h
  omega

/-- Taking the span of an arbitrary family of equations adds no ideal relations. -/
theorem momentLinearIdeal_span_range {α : Type*} (a : α → ι → K) :
    momentLinearIdeal K (Submodule.span K (Set.range a)) =
      Ideal.span (Set.range (fun j => momentLinearForm K (a j))) := by
  apply le_antisymm
  · rw [momentLinearIdeal, Ideal.span_le]
    rintro _ ⟨c, hc, rfl⟩
    induction hc using Submodule.span_induction with
    | mem c hc =>
      obtain ⟨j, rfl⟩ := hc
      exact Ideal.subset_span ⟨j, rfl⟩
    | zero => simp only [map_zero]; exact Ideal.zero_mem _
    | add c d _ _ hc hd => rw [map_add]; exact Ideal.add_mem _ hc hd
    | smul r c _ hc =>
      rw [map_smul]
      exact (Ideal.span (Set.range (fun j => momentLinearForm K (a j)))).restrictScalars K
        |>.smul_mem r hc
  · rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact Ideal.subset_span ⟨a j, Submodule.subset_span ⟨j, rfl⟩, rfl⟩

/-- Substitution gives the actual bilinear moment equations in the paired variables. -/
theorem momentLinearIdeal_extended (L : Submodule K (ι → K)) :
    (momentLinearIdeal K L).map (invariantSubstitution K) =
      Ideal.span ((fun c : ι → K => ∑ i, C (c i) * (X (Sum.inl i) * X (Sum.inr i))) ''
        (L : Set (ι → K))) := by
  rw [momentLinearIdeal, Ideal.map_span, Set.image_image]
  apply congrArg Ideal.span
  apply congrArg (fun f : (ι → K) → MvPolynomial (ι ⊕ ι) K => f '' (L : Set (ι → K)))
  funext c
  simp [momentLinearForm_apply, smul_eq_C_mul, invariantSubstitution]

/-- Every reduced weight space has an ordinary monomial basis on the surviving coordinates. -/
def reducedMomentWeightEquiv (q : ι → ℤ) (L : Submodule K (ι → K)) :
    MvPolynomial (Fin (Module.finrank K ((ι → K) ⧸ L))) K ≃ₗ[K]
      reducedPairedWeightSpace K q (momentLinearIdeal K L) :=
  (momentQuotientPolynomialEquiv K L).symm.toLinearEquiv.trans
    (reducedPairedWeightEquiv K q (momentLinearIdeal K L))

/-- Homogeneous linear moment relations always give a nonzero quotient. -/
theorem momentLinearIdeal_ne_top (L : Submodule K (ι → K)) :
    momentLinearIdeal K L ≠ ⊤ := by
  intro h
  have h1 : (1 : MvPolynomial ι K) ∈ momentLinearIdeal K L := by rw [h]; trivial
  have hz : (1 : MvPolynomial ι K ⧸ momentLinearIdeal K L) = 0 := by
    simpa only [map_one] using Ideal.Quotient.eq_zero_iff_mem.mpr h1
  have he := congrArg (momentQuotientPolynomialEquiv K L) hz
  exact one_ne_zero (by simpa only [map_one, map_zero] using he)

/-- No character loses its minimal monomial under linear moment reduction. -/
theorem moment_minimalWeight_ne_zero (q : ι → ℤ) (L : Submodule K (ι → K)) :
    Ideal.Quotient.mk ((momentLinearIdeal K L).map (invariantSubstitution K))
      (monomial (normalWeightExponent q 0) (1 : K)) ≠ 0 :=
  (minimalWeight_mk_ne_zero_iff K q _).mpr (momentLinearIdeal_ne_top K L)

section
variable {σ τ : Type*}

/-- An algebra map taking variables to affine linear polynomials cannot increase total degree. -/
theorem polynomialMap_totalDegree_le (F : MvPolynomial σ K →ₐ[K] MvPolynomial τ K)
    (hF : ∀ i, (F (X i)).totalDegree ≤ 1) (p : MvPolynomial σ K) :
    (F p).totalDegree ≤ p.totalDegree := by
  classical
  have hm (s : σ →₀ ℕ) (c : K) :
      (F (monomial s c)).totalDegree ≤ s.sum (fun _ n => n) := by
    rw [monomial_eq, map_mul, map_finsuppProd]
    have hc : F (C c) = C c := F.commutes c
    rw [hc]
    apply (totalDegree_mul _ _).trans
    rw [totalDegree_C, zero_add]
    apply (totalDegree_finsetProd _ _).trans
    apply Finset.sum_le_sum
    intro i hi
    change (F (X i ^ s i)).totalDegree ≤ s i
    rw [map_pow]
    exact (totalDegree_pow _ _).trans (by simpa using Nat.mul_le_mul_left (s i) (hF i))
  conv_lhs => rw [p.as_sum, map_sum]
  apply totalDegree_finsetSum_le
  intro s hs
  exact (hm s (coeff s p)).trans (le_totalDegree hs)

end

/-- A linear combination of coordinate variables has degree at most one. -/
theorem basisLinearForm_totalDegree_le {V κ : Type*} [AddCommGroup V] [Module K V]
    [Fintype κ] (b : Basis κ K V) (v : V) :
    (b.constr K (X : κ → MvPolynomial κ K) v).totalDegree ≤ 1 := by
  classical
  rw [Basis.constr_apply, Finsupp.sum_fintype _ _ (by intro i; simp)]
  apply totalDegree_finsetSum_le
  intro i _
  exact (totalDegree_smul_le _ _).trans (by rw [totalDegree_X])

/-- Polynomial coordinates on the neutral moment quotient, composed with reduction. -/
def momentCoordinateMap (L : Submodule K (ι → K)) :
    MvPolynomial ι K →ₐ[K] MvPolynomial (Fin (Module.finrank K ((ι → K) ⧸ L))) K :=
  (momentQuotientPolynomialEquiv K L).toAlgHom.comp
    (Ideal.Quotient.mkₐ K (momentLinearIdeal K L))

/-- Linear forms descend by quotienting their coefficient vectors. -/
theorem momentCoordinateMap_linearForm (L : Submodule K (ι → K)) (c : ι → K) :
    momentCoordinateMap K L (momentLinearForm K c) =
      (Module.finBasis K ((ι → K) ⧸ L)).constr K X (L.mkQ c) := by
  have he : momentLinearForm K c =
      SymmetricAlgebra.equivMvPolynomial (Pi.basisFun K ι)
        (SymmetricAlgebra.ι K (ι → K) c) :=
    (SymmetricAlgebra.lift_ι_apply _ _).symm
  change SymmetricAlgebra.equivMvPolynomial (Module.finBasis K ((ι → K) ⧸ L))
    (quotientMap L ((SymmetricAlgebra.equivMvPolynomial (Pi.basisFun K ι)).symm
      (momentLinearForm K c))) = _
  rw [he, AlgEquiv.symm_apply_apply, quotientMap_ι]
  exact SymmetricAlgebra.lift_ι_apply _ _

theorem momentCoordinateMap_totalDegree_le (L : Submodule K (ι → K))
    (f : MvPolynomial ι K) :
    (momentCoordinateMap K L f).totalDegree ≤ f.totalDegree := by
  apply polynomialMap_totalDegree_le
  intro i
  have hi : momentLinearForm K (Pi.basisFun K ι i) = X i := by
    simp only [momentLinearForm, Basis.constr_basis]
  rw [← hi, momentCoordinateMap_linearForm]
  exact basisLinearForm_totalDegree_le K _ _

/-- Choose representatives of the surviving linear coordinates. -/
def momentCoordinateLift (L : Submodule K (ι → K))
    (j : Fin (Module.finrank K ((ι → K) ⧸ L))) : ι → K :=
  Classical.choose (L.mkQ_surjective (Module.finBasis K _ j))

theorem momentCoordinateLift_spec (L : Submodule K (ι → K))
    (j : Fin (Module.finrank K ((ι → K) ⧸ L))) :
    L.mkQ (momentCoordinateLift K L j) = Module.finBasis K _ j :=
  Classical.choose_spec (L.mkQ_surjective (Module.finBasis K _ j))

/-- Lift every surviving coordinate to a linear polynomial in the original variables. -/
def momentCoordinateSection (L : Submodule K (ι → K)) :
    MvPolynomial (Fin (Module.finrank K ((ι → K) ⧸ L))) K →ₐ[K] MvPolynomial ι K :=
  aeval (fun j => momentLinearForm K (momentCoordinateLift K L j))

/-- Linear lifts give a polynomial section of the quotient coordinate map. -/
theorem momentCoordinateMap_section (L : Submodule K (ι → K))
    (f : MvPolynomial (Fin (Module.finrank K ((ι → K) ⧸ L))) K) :
    momentCoordinateMap K L (momentCoordinateSection K L f) = f := by
  have he : (momentCoordinateMap K L).comp (momentCoordinateSection K L) =
      AlgHom.id K _ := by
    apply MvPolynomial.algHom_ext
    intro j
    simp only [AlgHom.comp_apply, momentCoordinateSection, aeval_X,
      momentCoordinateMap_linearForm, momentCoordinateLift_spec,
      Basis.constr_basis, AlgHom.id_apply]
  exact DFunLike.congr_fun he f

theorem momentCoordinateSection_totalDegree_le (L : Submodule K (ι → K))
    (f : MvPolynomial (Fin (Module.finrank K ((ι → K) ⧸ L))) K) :
    (momentCoordinateSection K L f).totalDegree ≤ f.totalDegree := by
  apply polynomialMap_totalDegree_le
  intro j
  simp only [momentCoordinateSection, aeval_X]
  exact basisLinearForm_totalDegree_le K (Pi.basisFun K ι) _

/-- Reduction preserves the full degree filtration, including surjectivity at every bound. -/
theorem momentCoordinateMap_restrictTotalDegree (L : Submodule K (ι → K)) (D : ℕ) :
    (restrictTotalDegree ι K D).map (momentCoordinateMap K L).toLinearMap =
      restrictTotalDegree (Fin (Module.finrank K ((ι → K) ⧸ L))) K D := by
  ext f
  constructor
  · rintro ⟨g, hg, rfl⟩
    apply (mem_restrictTotalDegree _ _ _).mpr
    exact (momentCoordinateMap_totalDegree_le K L g).trans
      ((mem_restrictTotalDegree _ _ _).mp hg)
  · intro hf
    refine ⟨momentCoordinateSection K L f, ?_, momentCoordinateMap_section K L f⟩
    apply (mem_restrictTotalDegree _ _ _).mpr
    exact (momentCoordinateSection_totalDegree_le K L f).trans
      ((mem_restrictTotalDegree _ _ _).mp hf)

end GaloisForLFunctions.ArithmeticHarmonicAnalysis

