import GaloisForLFunctions.ArithmeticHarmonicAnalysis.Torus.AffineMomentQuotient
import Mathlib.LinearAlgebra.Finsupp.LinearCombination

/-!
# Arbitrary affine moment equations: consistency and polynomial coordinates

A family of coefficient rows and constants defines an actual affine ideal.
It is proper exactly when every finite relation among rows annihilates the
constants. Failure has a normalized finite certificate: the rows sum to zero
while their constants sum to one, so the equations generate the unit ideal.

Compatibility is equivalent to a point over the original field, both for
the neutral linear system and for the paired moment system. In the proper
case the constants descend to a functional on the row space, and the neutral
quotient is a polynomial ring with one variable per missing row rank.
The equation family may be infinite; the coordinate set is finite.
-/

noncomputable section
namespace GaloisForLFunctions.ArithmeticHarmonicAnalysis.AffineMomentSystem
open MvPolynomial
variable {α ι : Type*} [Fintype ι] (K : Type*) [Field K]

/-- Finite linear combinations of coefficient rows. -/
def rowMap (a : α → ι → K) : (α →₀ K) →ₗ[K] (ι → K) := Finsupp.linearCombination K a

/-- The same finite combination applied to the affine constants. -/
def valueMap (b : α → K) : (α →₀ K) →ₗ[K] K := Finsupp.linearCombination K b

/-- Every relation among rows is also a relation among their constants. -/
def Compatible (a : α → ι → K) (b : α → K) : Prop :=
  (rowMap K a).ker ≤ (valueMap K b).ker

/-- The ideal generated by the specified affine linear equations. -/
def ideal (a : α → ι → K) (b : α → K) : Ideal (MvPolynomial ι K) :=
  Ideal.span (Set.range (fun j => momentLinearForm K (a j) - C (b j)))

theorem equation_linearCombination (a : α → ι → K) (b : α → K) (c : α →₀ K) :
    momentLinearForm K (rowMap K a c) - C (valueMap K b c) =
      Finsupp.linearCombination K (fun j => momentLinearForm K (a j) - C (b j)) c := by
  induction c using Finsupp.induction_linear with
  | zero => simp
  | add c d hc hd =>
    simp only [map_add]
    rw [← hc, ← hd]
    abel
  | single j r =>
    simp only [rowMap, valueMap, Finsupp.linearCombination_single, map_smul, smul_sub]
    congr 1
    simpa only [smul_eq_mul, smul_eq_C_mul] using map_mul C r (b j)

theorem equation_linearCombination_mem (a : α → ι → K) (b : α → K) (c : α →₀ K) :
    momentLinearForm K (rowMap K a c) - C (valueMap K b c) ∈ ideal K a b := by
  rw [equation_linearCombination, Finsupp.linearCombination_apply]
  exact (ideal K a b).restrictScalars K |>.sum_mem
    (fun j _ => (ideal K a b).restrictScalars K |>.smul_mem (c j)
      (Ideal.subset_span ⟨j, rfl⟩))

omit [Fintype ι] in
/-- Inconsistency has a finite certificate normalized to the impossible equation `0 = 1`. -/
theorem not_compatible_iff_certificate (a : α → ι → K) (b : α → K) :
    ¬ Compatible K a b ↔ ∃ c : α →₀ K, rowMap K a c = 0 ∧ valueMap K b c = 1 := by
  constructor
  · intro h
    have hex : ∃ c : α →₀ K, rowMap K a c = 0 ∧ valueMap K b c ≠ 0 := by
      by_contra hn
      apply h
      intro c hc
      change valueMap K b c = 0
      by_contra hb
      exact hn ⟨c, hc, hb⟩
    obtain ⟨c, ha, hb⟩ := hex
    refine ⟨(valueMap K b c)⁻¹ • c, ?_, ?_⟩
    · rw [map_smul, ha, smul_zero]
    · rw [map_smul, smul_eq_mul, inv_mul_cancel₀ hb]
  · rintro ⟨c, ha, hb⟩ h
    have hz : valueMap K b c = 0 := h ha
    exact one_ne_zero (hb.symm.trans hz)

theorem ideal_eq_top_of_not_compatible (a : α → ι → K) (b : α → K)
    (h : ¬ Compatible K a b) : ideal K a b = ⊤ := by
  obtain ⟨c, ha, hb⟩ := (not_compatible_iff_certificate K a b).mp h
  have hm := equation_linearCombination_mem K a b c
  rw [ha, hb, map_zero, map_one, zero_sub] at hm
  have h1 : (1 : MvPolynomial ι K) ∈ ideal K a b := by
    simpa only [neg_neg] using (ideal K a b).neg_mem hm
  exact Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one

/-- Compatible constants descend through the row map to a functional on its range. -/
def level (a : α → ι → K) (b : α → K) (h : Compatible K a b) :
    (rowMap K a).range →ₗ[K] K :=
  ((rowMap K a).ker.liftQ (valueMap K b) h).comp
    (rowMap K a).quotKerEquivRange.symm.toLinearMap

omit [Fintype ι] in
theorem level_rowMap (a : α → ι → K) (b : α → K) (h : Compatible K a b) (c : α →₀ K) :
    level K a b h ((rowMap K a).rangeRestrict c) = valueMap K b c := by
  change ((rowMap K a).ker.liftQ (valueMap K b) h)
    ((rowMap K a).quotKerEquivRange.symm ⟨rowMap K a c, _⟩) = _
  rw [LinearMap.quotKerEquivRange_symm_apply_image]
  rfl

omit [Fintype ι] in
theorem row_mem_range (a : α → ι → K) (j : α) : a j ∈ (rowMap K a).range := by
  refine ⟨Finsupp.single j 1, ?_⟩
  simp [rowMap]

omit [Fintype ι] in
theorem level_row (a : α → ι → K) (b : α → K) (h : Compatible K a b) (j : α) :
    level K a b h ⟨a j, row_mem_range K a j⟩ = b j := by
  have he : (rowMap K a).rangeRestrict (Finsupp.single j 1) =
      ⟨a j, row_mem_range K a j⟩ := by
    apply Subtype.ext
    change rowMap K a (Finsupp.single j 1) = a j
    simp [rowMap]
  have hv := level_rowMap K a b h (Finsupp.single j 1)
  rw [he] at hv
  simpa only [valueMap, Finsupp.linearCombination_single, one_smul] using hv

/-- Passing from generators to their row space preserves the actual affine ideal. -/
theorem ideal_eq_affineMomentIdeal (a : α → ι → K) (b : α → K) (h : Compatible K a b) :
    ideal K a b = affineMomentIdeal K (rowMap K a).range (level K a b h) := by
  apply le_antisymm
  · rw [ideal, Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    apply Ideal.subset_span
    refine ⟨⟨a j, row_mem_range K a j⟩, ?_⟩
    change momentLinearForm K (a j) - C (level K a b h ⟨a j, _⟩) = _
    rw [level_row]
  · rw [affineMomentIdeal, Ideal.span_le]
    rintro _ ⟨c, rfl⟩
    obtain ⟨v, hv⟩ := c.2
    have hc : c = (rowMap K a).rangeRestrict v := Subtype.ext hv.symm
    change momentLinearForm K c.1 - C (level K a b h c) ∈ _
    rw [hc, level_rowMap]
    exact equation_linearCombination_mem K a b v

/-- Properness of the generated ideal is exactly linear compatibility of the constants. -/
theorem ideal_ne_top_iff (a : α → ι → K) (b : α → K) :
    ideal K a b ≠ ⊤ ↔ Compatible K a b := by
  constructor
  · intro h
    by_contra hc
    exact h (ideal_eq_top_of_not_compatible K a b hc)
  · intro h
    rw [ideal_eq_affineMomentIdeal K a b h]
    exact affineMomentIdeal_ne_top K _ _

theorem ideal_eq_top_iff (a : α → ι → K) (b : α → K) :
    ideal K a b = ⊤ ↔ ¬ Compatible K a b := by
  constructor
  · intro ht hc
    exact (ideal_ne_top_iff K a b).mpr hc ht
  · exact ideal_eq_top_of_not_compatible K a b

/-- The neutral equations have a solution over the original field exactly when compatible. -/
theorem compatible_iff_exists_point (a : α → ι → K) (b : α → K) :
    Compatible K a b ↔ ∃ x : ι → K, ∀ j, eval x (momentLinearForm K (a j)) = b j := by
  constructor
  · intro h
    obtain ⟨x, hx⟩ := exists_momentLevelPoint K (rowMap K a).range (level K a b h)
    refine ⟨x, fun j => ?_⟩
    exact (hx ⟨a j, row_mem_range K a j⟩).trans (level_row K a b h j)
  · rintro ⟨x, hx⟩
    apply (ideal_ne_top_iff K a b).mp
    intro ht
    have hi : ideal K a b ≤ RingHom.ker (eval x) := by
      rw [ideal, Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      change eval x (momentLinearForm K (a j) - C (b j)) = 0
      rw [eval_sub, hx, eval_C, sub_self]
    have h1 : (1 : MvPolynomial ι K) ∈ ideal K a b := by rw [ht]; trivial
    have he : eval x (1 : MvPolynomial ι K) = 0 := hi h1
    simp only [map_one, one_ne_zero] at he

/-- Pairing coordinates introduces no further obstruction: take `z = 1` and `w = x`. -/
theorem compatible_iff_exists_paired_point (a : α → ι → K) (b : α → K) :
    Compatible K a b ↔ ∃ z w : ι → K, ∀ j, ∑ i, a j i * (z i * w i) = b j := by
  rw [compatible_iff_exists_point]
  constructor
  · rintro ⟨x, hx⟩
    refine ⟨1, x, fun j => ?_⟩
    simpa only [Pi.one_apply, one_mul, eval_momentLinearForm] using hx j
  · rintro ⟨z, w, h⟩
    exact ⟨fun i => z i * w i, fun j => (eval_momentLinearForm K _ _).trans (h j)⟩

/-- A proper neutral quotient is a polynomial ring on the quotient by the row space. -/
def quotientPolynomialEquiv (a : α → ι → K) (b : α → K) (h : Compatible K a b) :
    (MvPolynomial ι K ⧸ ideal K a b) ≃ₐ[K]
      MvPolynomial (Fin (Module.finrank K ((ι → K) ⧸ (rowMap K a).range))) K := by
  rw [ideal_eq_affineMomentIdeal K a b h]
  exact affineMomentPolynomialEquiv K _ _

/-- Neutral substitution gives precisely the original affine paired moment equations. -/
theorem ideal_extended (a : α → ι → K) (b : α → K) :
    (ideal K a b).map (invariantSubstitution K) = Ideal.span (Set.range (fun j =>
      (∑ i, C (a j i) * (X (Sum.inl i) * X (Sum.inr i))) - C (b j))) := by
  have he (j : α) : invariantSubstitution K (momentLinearForm K (a j) - C (b j)) =
      (∑ i, C (a j i) * (X (Sum.inl i) * X (Sum.inr i))) - C (b j) := by
    simp [momentLinearForm_apply, smul_eq_C_mul, invariantSubstitution]
  rw [ideal, Ideal.map_span]
  apply congrArg Ideal.span
  ext f
  constructor
  · rintro ⟨_, ⟨j, rfl⟩, rfl⟩
    exact ⟨j, (he j).symm⟩
  · rintro ⟨j, rfl⟩
    exact ⟨_, ⟨j, rfl⟩, he j⟩

end GaloisForLFunctions.ArithmeticHarmonicAnalysis.AffineMomentSystem

#print axioms GaloisForLFunctions.ArithmeticHarmonicAnalysis.AffineMomentSystem.not_compatible_iff_certificate
#print axioms GaloisForLFunctions.ArithmeticHarmonicAnalysis.AffineMomentSystem.compatible_iff_exists_point
#print axioms GaloisForLFunctions.ArithmeticHarmonicAnalysis.AffineMomentSystem.quotientPolynomialEquiv
