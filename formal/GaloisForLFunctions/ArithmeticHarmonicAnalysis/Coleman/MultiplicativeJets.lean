import Mathlib.Algebra.Polynomial.Derivative
import Mathlib.Tactic.Ring

/-!
# Integral multiplicative jets

For `D=(1+X)d/dX`, the ideal generated by `n` and `(1+X)^n-1` is
stable under `D`. Consequently every jet at zero of a multiple of
`(1+X)^n-1` is divisible by `n`. This is the polynomial congruence
mechanism of Goto–Ishii, *CM Elliptic Analogue of the Coleman–Ihara
Formula*, Lemmas 5.1–5.3; it requires neither a measure nor reciprocity.
-/

noncomputable section

namespace GaloisForLFunctions.ArithmeticHarmonicAnalysis.Coleman
open Polynomial
variable {R : Type*} [CommRing R]

/-- Invariant differentiation in the multiplicative coordinate `1+X`. -/
def multiplicativeDerivative (f : R[X]) : R[X] := (1 + X) * derivative f

/-- The `k`th invariant derivative evaluated at the identity. -/
def multiplicativeJet (k : ℕ) (f : R[X]) : R :=
  ((multiplicativeDerivative^[k]) f).eval 0

/-- The polynomial of the multiplication-by-`n` map on the multiplicative group. -/
def divisionPolynomial (n : ℕ) : R[X] := (1 + X) ^ n - 1

theorem multiplicativeDerivative_add (f g : R[X]) :
    multiplicativeDerivative (f + g) =
      multiplicativeDerivative f + multiplicativeDerivative g := by
  simp only [multiplicativeDerivative, derivative_add, mul_add]

theorem multiplicativeDerivative_mul (f g : R[X]) :
    multiplicativeDerivative (f * g) =
      multiplicativeDerivative f * g + f * multiplicativeDerivative g := by
  simp only [multiplicativeDerivative, derivative_mul]
  ring

theorem multiplicativeDerivative_C_mul (a : R) (f : R[X]) :
    multiplicativeDerivative (C a * f) = C a * multiplicativeDerivative f := by
  simp only [multiplicativeDerivative, derivative_C_mul]
  ring

theorem iterate_add (k : ℕ) (f g : R[X]) :
    (multiplicativeDerivative^[k]) (f + g) =
      (multiplicativeDerivative^[k]) f + (multiplicativeDerivative^[k]) g := by
  induction k with
  | zero => rfl
  | succ k ih =>
    simp only [Function.iterate_succ_apply', ih, multiplicativeDerivative_add]

theorem iterate_C_mul (k : ℕ) (a : R) (f : R[X]) :
    (multiplicativeDerivative^[k]) (C a * f) =
      C a * (multiplicativeDerivative^[k]) f := by
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [Function.iterate_succ_apply', ih, multiplicativeDerivative_C_mul,
      Function.iterate_succ_apply']

theorem multiplicativeJet_add (k : ℕ) (f g : R[X]) :
    multiplicativeJet k (f + g) = multiplicativeJet k f + multiplicativeJet k g := by
  simp only [multiplicativeJet, iterate_add, eval_add]

theorem multiplicativeJet_C_mul (k : ℕ) (a : R) (f : R[X]) :
    multiplicativeJet k (C a * f) = a * multiplicativeJet k f := by
  simp only [multiplicativeJet, iterate_C_mul, eval_mul, eval_C]

/-- Differentiating the division polynomial exposes the integral factor `n`. -/
theorem multiplicativeDerivative_divisionPolynomial (n : ℕ) :
    multiplicativeDerivative (divisionPolynomial (R := R) n) =
      C (n : R) * (1 + X) ^ n := by
  cases n with
  | zero => simp [divisionPolynomial, multiplicativeDerivative]
  | succ n =>
    simp only [multiplicativeDerivative, divisionPolynomial, derivative_sub,
      derivative_pow, derivative_add, derivative_one, derivative_X, zero_add,
      mul_one, sub_zero, Nat.add_sub_cancel]
    rw [pow_succ]
    ring

/-- Multiplicative characters are eigenvectors of invariant differentiation. -/
theorem multiplicativeDerivative_character (n : ℕ) :
    multiplicativeDerivative ((1 + X : R[X]) ^ n) = C (n : R) * (1 + X) ^ n := by
  have h := multiplicativeDerivative_divisionPolynomial (R := R) n
  simpa only [multiplicativeDerivative, divisionPolynomial, derivative_sub,
    derivative_one, sub_zero] using h

/-- Iteration raises the character's integral frequency to the derivative order. -/
theorem iterate_character (n k : ℕ) :
    (multiplicativeDerivative^[k]) ((1 + X : R[X]) ^ n) =
      C ((n : R) ^ k) * (1 + X) ^ n := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [Function.iterate_succ_apply', ih, multiplicativeDerivative_C_mul,
      multiplicativeDerivative_character, ← mul_assoc, ← map_mul, ← pow_succ]

/-- A character's jet is its frequency moment, including order zero. -/
theorem multiplicativeJet_character (n k : ℕ) :
    multiplicativeJet k ((1 + X : R[X]) ^ n) = (n : R) ^ k := by
  simp [multiplicativeJet, iterate_character]

/-- Every iterated derivative stays in the ideal `(n, (1+X)^n-1)`.
The displayed quotient retains the actual derivative of the original multiplier. -/
theorem iterate_divisionPolynomial_mul (n k : ℕ) (f : R[X]) :
    ∃ g : R[X],
      (multiplicativeDerivative^[k]) (divisionPolynomial n * f) =
        divisionPolynomial n * (multiplicativeDerivative^[k]) f + C (n : R) * g := by
  induction k with
  | zero => exact ⟨0, by simp⟩
  | succ k ih =>
    obtain ⟨g, hg⟩ := ih
    refine ⟨(1 + X) ^ n * (multiplicativeDerivative^[k]) f +
      multiplicativeDerivative g, ?_⟩
    rw [Function.iterate_succ_apply', hg, multiplicativeDerivative_add,
      multiplicativeDerivative_mul, multiplicativeDerivative_divisionPolynomial,
      multiplicativeDerivative_C_mul, Function.iterate_succ_apply']
    ring

/-- All multiplicative moments of a division-polynomial multiple vanish modulo `n`. -/
theorem dvd_multiplicativeJet_divisionPolynomial_mul (n k : ℕ) (f : R[X]) :
    (n : R) ∣ multiplicativeJet k (divisionPolynomial n * f) := by
  obtain ⟨g, hg⟩ := iterate_divisionPolynomial_mul n k f
  refine ⟨g.eval 0, ?_⟩
  simp only [multiplicativeJet, hg, eval_add, eval_mul, eval_C]
  simp [divisionPolynomial]

/-- Adding a division-polynomial multiple preserves every jet modulo `n`. -/
theorem dvd_multiplicativeJet_difference (n k : ℕ) (f g : R[X]) :
    (n : R) ∣ multiplicativeJet k (f + divisionPolynomial n * g) -
      multiplicativeJet k f := by
  simpa only [multiplicativeJet_add, add_sub_cancel_left] using
    dvd_multiplicativeJet_divisionPolynomial_mul n k g

/-- Translation by `n` of an atomic multiplicative transform preserves its jets modulo `n`. -/
theorem dvd_multiplicativeJet_translate (n k : ℕ) (f : R[X]) :
    (n : R) ∣ multiplicativeJet k ((1 + X) ^ n * f) - multiplicativeJet k f := by
  have h : f + divisionPolynomial n * f = (1 + X) ^ n * f := by
    simp only [divisionPolynomial]
    ring
  simpa only [h] using dvd_multiplicativeJet_difference n k f f

/-- Prime-power translation preserves every integral multiplicative jet to that precision. -/
theorem primePower_dvd_multiplicativeJet_translate (p m k : ℕ) (f : ℤ[X]) :
    (p : ℤ) ^ m ∣ multiplicativeJet k ((1 + X) ^ (p ^ m) * f) -
      multiplicativeJet k f := by
  simpa only [Nat.cast_pow] using dvd_multiplicativeJet_translate (p ^ m) k f

end GaloisForLFunctions.ArithmeticHarmonicAnalysis.Coleman

#print axioms GaloisForLFunctions.ArithmeticHarmonicAnalysis.Coleman.iterate_divisionPolynomial_mul
#print axioms GaloisForLFunctions.ArithmeticHarmonicAnalysis.Coleman.dvd_multiplicativeJet_difference
