import GaloisForLFunctions.SignedArithmeticCorrespondences.TheTrapezoidRemainderOfStridedPrefixes
import GaloisForLFunctions.SignedArithmeticCorrespondences.IndependentEnergiesOfInfiniteEndpointSections
import GaloisForLFunctions.RHTower.Sieve.MoebiusScaledReindex

/-!
# Separate energies of sieved integral divisors

At the aligned upper endpoint qm delete every lower graph divisible by q.
The remaining prime defect has one more order of decay in the separation.
Its two individual energies are adjacent differences of the degree-one
real Weil metric.
-/

noncomputable section
namespace GaloisForLFunctions.SignedArithmeticCorrespondences
open Finset MeasureTheory Filter Topology ArithmeticCastelnuovoSeveri _root_.RHTower

/-- A divisibility class and its complementary stride at a common upper cut. -/
structure SieveFactor (q : ℕ+) where
  divisor : ℕ+
  stride : ℕ+
  product_eq : (divisor:ℕ)*(stride:ℕ) = (q:ℕ)

/-- Integer multiplicity of the class of multiples of d. -/
def multipleMask (d : ℕ+) (i : ℕ) : ℤ := if (d:ℕ) ∣ i then 1 else 0

/-- Pole product minus prime-power order for lower multiplicity w and one upper endpoint. -/
def endpointPoleDefect (M : ℕ) (w : ℕ → ℤ) : ℝ :=
  poleProduct M M w (fun j => if j=M then 1 else 0) -
  signedDivisorHeight 1 M M w (upperDivisor M (fun j => if j=M then 1 else 0))

private def row (M i : ℕ) : ℝ := (M:ℝ)/i-chebyshevPsi (M/i)

private theorem endpoint_rows (M : ℕ) (w : ℕ → ℤ) :
    endpointPoleDefect M w = ∑ i ∈ Icc 1 M, (w i:ℝ)*row M i := by
  rw [endpointPoleDefect,poleProduct,height_eq_quotient]
  cases M with
  | zero => simp
  | succ m =>
    simp only [apply_ite,Int.cast_one,Int.cast_zero,ite_mul,one_mul,zero_mul,mul_ite,mul_one,mul_zero,
      sum_ite_eq',mem_Icc,Nat.succ_le_succ_iff,Nat.zero_le,le_refl,and_self,if_true]
    rw [sum_mul,← sum_sub_distrib]
    exact sum_congr rfl fun i _ => by dsimp only [row]; ring

/-- Aligned projection preserves the full pole and prime contributions on a divisibility class. -/
theorem multipleMask_defect {q : ℕ+} (f : SieveFactor q) (m : ℕ) :
    endpointPoleDefect ((q:ℕ)*m) (multipleMask f.divisor) = prefixPoleDefect ((f.stride:ℕ)*m) := by
  let d := (f.divisor:ℕ)
  let k := (f.stride:ℕ)*m
  have hcut : (q:ℕ)*m=d*k := by rw [← f.product_eq,Nat.mul_assoc]
  change endpointPoleDefect ((q:ℕ)*m) _ = endpointPoleDefect k (fun _ => 1)
  rw [hcut,endpoint_rows,endpoint_rows]
  simp only [multipleMask,apply_ite,Int.cast_one,Int.cast_zero,ite_mul,zero_mul,one_mul,← sum_filter]
  rw [Sieve.sum_filter_dvd_eq_sum_scaled f.divisor.pos,Nat.mul_div_cancel_left k f.divisor.pos]
  refine sum_congr rfl fun i _ => ?_
  have hd : (d:ℝ) ≠ 0 := (Nat.cast_pos.mpr f.divisor.pos).ne'
  simp only [row,Nat.cast_mul,Nat.mul_div_mul_left k i f.divisor.pos,mul_div_mul_left _ _ hd]

/-- The balanced integral masks generated by divisibility classes at q.
Every basis element subtracts its multiplicity on the multiples of q. -/
def sieveMask {ι : Type*} {q : ℕ+} (S : Finset ι) (f : ι → SieveFactor q)
    (a : ι → ℤ) (i : ℕ) : ℤ :=
  ∑ t ∈ S, a t*(multipleMask (f t).divisor i-multipleMask q i)

/-- The actual defect of a balanced mask is a signed sum of strided prefix differences. -/
theorem sieveMask_defect {ι : Type*} {q : ℕ+} (S : Finset ι) (f : ι → SieveFactor q)
    (a : ι → ℤ) (m : ℕ) :
    endpointPoleDefect ((q:ℕ)*m) (sieveMask S f a) =
      ∑ t ∈ S, (a t:ℝ)*(prefixPoleDefect (((f t).stride:ℕ)*m)-prefixPoleDefect m) := by
  let last : SieveFactor q := ⟨q,1,Nat.mul_one _⟩
  have hl : endpointPoleDefect ((q:ℕ)*m) (multipleMask q) = prefixPoleDefect m := by
    simpa only [last,PNat.val_ofNat,Nat.one_mul] using multipleMask_defect last m
  simp_rw [← multipleMask_defect (f _) m,← hl,endpoint_rows]
  simp only [sieveMask,Int.cast_sum,Int.cast_mul,Int.cast_sub,sum_mul]
  rw [sum_comm]
  refine sum_congr rfl fun t _ => ?_
  rw [← sum_sub_distrib,mul_sum]
  exact sum_congr rfl fun i _ => by ring

/-- Second difference with respect to the aligned upper endpoint qm. -/
def sieveCurvature (q : ℕ+) (w : ℕ → ℤ) (m : ℕ) : ℝ :=
  endpointPoleDefect ((q:ℕ)*(m+2)) w-2*endpointPoleDefect ((q:ℕ)*(m+1)) w+
    endpointPoleDefect ((q:ℕ)*m) w

/-- The common logarithmic curvature disappears on every balanced divisibility mask. -/
theorem sieve_curvature_remainders {ι : Type*} {q : ℕ+} (S : Finset ι) (f : ι → SieveFactor q)
    (a : ι → ℤ) (n : ℕ) :
    sieveCurvature q (sieveMask S f a) (n+1) = ∑ t ∈ S, (a t:ℝ)*
      (strideRemainder 1 n (fun _ => 1)-strideRemainder (f t).stride n (fun _ => 1)) := by
  unfold sieveCurvature
  simp only [sieveMask_defect,mul_sum,← sum_sub_distrib,← sum_add_distrib]
  refine sum_congr rfl fun t _ => ?_
  have h := strided_prefix_curvature (f t).stride n
  have h₁ := strided_prefix_curvature 1 n
  simp only [PNat.val_ofNat,Nat.one_mul] at h₁
  have e : (prefixPoleDefect (((f t).stride:ℕ)*(n+3))-prefixPoleDefect (n+3))-
      2*(prefixPoleDefect (((f t).stride:ℕ)*(n+2))-prefixPoleDefect (n+2))+
      (prefixPoleDefect (((f t).stride:ℕ)*(n+1))-prefixPoleDefect (n+1)) =
      strideRemainder 1 n (fun _ => 1)-strideRemainder (f t).stride n (fun _ => 1) := by
    linarith only [h,h₁]
  rw [← e]
  ring

/-- Adjacent difference of the degree-one real Weil metric, starting at offset k. -/
def weilDrop (k : ℕ) : ℝ := realEndpoint 1 k-realEndpoint 1 (k+1)

theorem weilDrop_explicit (k : ℕ) :
    weilDrop k = 1/(((k:ℝ)+1)*((k:ℝ)+2)*((k:ℝ)+3)) := by
  have h (j : ℕ) : 2*realEndpoint 1 j = 1/(((j:ℝ)+1)*((j:ℝ)+2)) := by
    simpa only [realEndpoint_moment 1 j Nat.zero_lt_one,sum_range_one,pow_zero,one_pow,mul_one]
      using sectionMass j
  have h₁ := h k
  have h₂ := h (k+1)
  rw [Nat.cast_succ,show (k:ℝ)+1+1=k+2 by ring,show (k:ℝ)+1+2=k+3 by ring] at h₂
  unfold weilDrop
  rw [eq_div_iff (by positivity)]
  field_simp at h₁ h₂
  linear_combination (((k:ℝ)+3)*h₁-((k:ℝ)+1)*h₂)/2

private def poly (S : Finset ℕ) (u : ℕ → ℝ) (y : ℝ) : ℝ := ∑ i ∈ S, u i*y^i

/-- The individual energy has an arithmetic definition using only real Weil entries. -/
def sieveEnergy (n : ℕ) (S : Finset ℕ) (u : ℕ → ℝ) : ℝ :=
  ∑ i ∈ S, ∑ j ∈ S, u i*u j*weilDrop (n+i+j)

theorem sieveEnergy_moment (n : ℕ) (S : Finset ℕ) (u : ℕ → ℝ) :
    2*sieveEnergy n S u = betaMoment n (fun y => (∑ i ∈ S, u i*y^i)^2) := by
  have h (m : ℕ) := realEndpoint_mixed 1 m Nat.zero_lt_one S S u u
  simp only [sum_range_one,pow_zero,one_pow,mul_one] at h
  have hi (m : ℕ) : IntervalIntegrable (fun x : ℝ => x^m*(1-x)*poly S u x*poly S u x) volume 0 1 :=
    Continuous.intervalIntegrable (by unfold poly; fun_prop) _ _
  change 2*∑ i ∈ S, ∑ j ∈ S, u i*u j*(realEndpoint 1 (n+i+j)-realEndpoint 1 (n+i+j+1)) = _
  simp only [mul_sub,sum_sub_distrib]
  rw [show (∑ i ∈ S, ∑ j ∈ S, u i*u j*realEndpoint 1 (n+i+j+1)) =
    ∑ i ∈ S, ∑ j ∈ S, u i*u j*realEndpoint 1 (n+1+i+j) by
      refine sum_congr rfl fun i _ => sum_congr rfl fun j _ => ?_; congr 2 <;> omega]
  rw [mul_sub,h n,h (n+1),← intervalIntegral.integral_sub (hi n) (hi (n+1))]
  exact intervalIntegral.integral_congr fun x _ => by dsimp only [poly]; rw [pow_succ]; ring

theorem sieveEnergy_nonneg (n : ℕ) (S : Finset ℕ) (u : ℕ → ℝ) : 0 ≤ sieveEnergy n S u := by
  have h := sieveEnergy_moment n S u
  have hb : 0 ≤ betaMoment n (fun y => poly S u y^2) :=
    intervalIntegral.integral_nonneg zero_le_one fun x hx => mul_nonneg
      (mul_nonneg (pow_nonneg hx.1 _) (sq_nonneg _)) (sq_nonneg _)
  linarith only [h,hb]

/-- Sum of the absolute integer coefficients of the divisibility differences. -/
def sieveCost {ι : Type*} (S : Finset ι) (a : ι → ℤ) : ℝ := ∑ t ∈ S, |(a t:ℝ)|

/-- The bound is independent of the common modulus and the endpoint support sizes. -/
theorem sieve_mixed_separate_energies {ι : Type*} {q : ℕ+} (S : Finset ι) (f : ι → SieveFactor q)
    (a : ι → ℤ) (n : ℕ) (I J : Finset ℕ) (u v : ℕ → ℝ) :
    |∑ i ∈ I, ∑ j ∈ J, u i*v j*sieveCurvature q (sieveMask S f a) (n+i+j+1)| ≤
      sieveCost S a*((sieveEnergy n I u+sieveEnergy n J v)/4) := by
  let R (r : ℕ+) := strideRemainder r n (fun x => poly I u x*poly J v x)
  have he : (∑ i ∈ I, ∑ j ∈ J, u i*v j*sieveCurvature q (sieveMask S f a) (n+i+j+1)) =
      ∑ t ∈ S, (a t:ℝ)*(R 1-R (f t).stride) := by
    simp only [sieve_curvature_remainders,mul_sum]
    apply Eq.trans (sum_congr rfl fun i _ => sum_comm)
    rw [sum_comm]
    refine sum_congr rfl fun t _ => ?_
    have hg (r : ℕ+) : R r = ∑ i ∈ I, ∑ j ∈ J, u i*v j*strideRemainder r (n+i+j) (fun _ => 1) :=
      (strideRemainder_gluing r n I J u v).symm
    rw [hg,hg]
    simp only [← sum_sub_distrib,mul_sum]
    exact sum_congr rfl fun i _ => sum_congr rfl fun j _ => by ring
  rw [he,sieveCost,sum_mul]
  refine (abs_sum_le_sum_abs _ _).trans (sum_le_sum fun t _ => ?_)
  rw [abs_mul]
  apply mul_le_mul_of_nonneg_left _ (abs_nonneg _)
  have h := stride_difference_mixed 1 (f t).stride n (U := poly I u) (V := poly J v)
    (by unfold poly; fun_prop) (by unfold poly; fun_prop)
  rw [← sieveEnergy_moment,← sieveEnergy_moment] at h
  change |R 1-R (f t).stride| ≤ _ at h
  linarith only [h]

/-- The remaining arithmetic curvature decays cubically, uniformly in the modulus. -/
theorem sieve_curvature_entry_bound {ι : Type*} {q : ℕ+} (S : Finset ι) (f : ι → SieveFactor q)
    (a : ι → ℤ) (k : ℕ) :
    |sieveCurvature q (sieveMask S f a) (k+1)| ≤ sieveCost S a/2*weilDrop k := by
  have h := sieve_mixed_separate_energies S f a k {0} {0} (fun _ => 1) (fun _ => 1)
  simp only [sieveEnergy,sum_singleton,mul_one,one_mul,Nat.add_zero] at h
  linarith only [h]

private theorem drop_nonneg (k : ℕ) : 0 ≤ weilDrop k := by rw [weilDrop_explicit]; positivity

private theorem drop_antitone : Antitone weilDrop := by
  intro j k hj
  have h : (j:ℝ) ≤ k := by exact_mod_cast hj
  rw [weilDrop_explicit,weilDrop_explicit]
  apply div_le_div_of_nonneg_left zero_le_one (by positivity)
  apply mul_le_mul _ (add_le_add_right h _) (by positivity) (by positivity)
  exact mul_le_mul (add_le_add_right h _) (add_le_add_right h _) (by positivity) (by positivity)

private theorem drop_row (n : ℕ) :
    Summable (fun j => weilDrop (n+j)) ∧ (∑' j, weilDrop (n+j)) ≤ 1/(2*((n:ℝ)+1)*((n:ℝ)+2)) := by
  have hd (k : ℕ) : 2*realEndpoint 1 k = 1/(((k:ℝ)+1)*((k:ℝ)+2)) := by
    simpa only [realEndpoint_moment 1 k Nat.zero_lt_one,sum_range_one,pow_zero,one_pow,mul_one] using sectionMass k
  have hb (M : ℕ) : ∑ j ∈ range M, weilDrop (n+j) ≤ 1/(2*((n:ℝ)+1)*((n:ℝ)+2)) := by
    have he := sum_range_sub' (fun j => realEndpoint 1 (n+j)) M
    simp only [Nat.add_zero,← Nat.add_assoc] at he
    rw [show (∑ j ∈ range M, weilDrop (n+j)) = realEndpoint 1 n-realEndpoint 1 (n+M) from he]
    have h₁ := hd n
    have h₂ : 0 ≤ realEndpoint 1 (n+M) := by
      have h := hd (n+M)
      have hz : 0 ≤ 1/((((n+M:ℕ):ℝ)+1)*(((n+M:ℕ):ℝ)+2)) := by positivity
      linarith only [h,hz]
    rw [show 1/(2*((n:ℝ)+1)*((n:ℝ)+2)) = (1/(((n:ℝ)+1)*((n:ℝ)+2)))/2 by simp only [div_eq_mul_inv,mul_inv_rev]; ring,← h₁]
    linarith only [h₂]
  exact ⟨summable_of_sum_range_le (fun j => drop_nonneg _) hb,
    Real.tsum_le_of_sum_range_le (fun j => drop_nonneg _) hb⟩

/-- The individual real energy remains an absolutely convergent nonnegative
square form for every square-summable section. -/
theorem completed_sieve_energy (n : ℕ) (u : ℕ → ℝ) (hu : Summable (fun i => u i^2)) :
    let D := fun k => weilDrop (n+k)
    Summable (fun p : ℕ × ℕ => |u p.1*u p.2*D (p.1+p.2)|) ∧
      0 ≤ ∑' p : ℕ × ℕ, u p.1*u p.2*D (p.1+p.2) := by
  intro D
  have hr (j k : ℕ) (hj : j ≤ k) : |D k| ≤ 1*D j := by
    rw [abs_of_nonneg (drop_nonneg _),one_mul]
    exact drop_antitone (Nat.add_le_add_left hj n)
  have hs := (absoluteIntersection_le_row_sum (drop_row n).1 hr u u hu hu).1
  refine ⟨hs,ge_of_tendsto (roundedIntersection_tendsto D u u hs) (Eventually.of_forall fun N => ?_)⟩
  let b (i : ℕ) := (roundedJump N (u i):ℝ)/((N:ℝ)+1)
  simpa only [roundedIntersection,sieveEnergy,D,b,Nat.add_assoc] using sieveEnergy_nonneg n (range N) b

/-- The countable sieve intersection is recovered by rounded integer divisors.
Its signed value costs two separate real energies. Its absolute series costs
the two ordinary square norms times a factor of order the inverse square of
the aligned separation. -/
theorem infinite_sieve_separate_energies {ι : Type*} {q : ℕ+} (S : Finset ι) (f : ι → SieveFactor q)
    (a : ι → ℤ) (n : ℕ) (u v : ℕ → ℝ)
    (hu : Summable (fun i => u i^2)) (hv : Summable (fun j => v j^2)) :
    let K := fun k => sieveCurvature q (sieveMask S f a) (n+k+1)
    let D := fun k => weilDrop (n+k)
    let H := ∑' p : ℕ × ℕ, u p.1*v p.2*K (p.1+p.2)
    Summable (fun p : ℕ × ℕ => |u p.1*v p.2*K (p.1+p.2)|) ∧
      absoluteIntersection K u v ≤ sieveCost S a*((∑' i, u i^2)+(∑' j, v j^2))/
        (8*((n:ℝ)+1)*((n:ℝ)+2)) ∧
      Tendsto (fun N => roundedIntersection N K u v) atTop (𝓝 H) ∧
      |H| ≤ sieveCost S a*((∑' p : ℕ × ℕ, u p.1*u p.2*D (p.1+p.2))+
        (∑' p : ℕ × ℕ, v p.1*v p.2*D (p.1+p.2)))/4 := by
  intro K D H
  have hc : 0 ≤ sieveCost S a := sum_nonneg fun t _ => abs_nonneg _
  have hrow : ∀ j k : ℕ, j≤k → |K k| ≤ sieveCost S a/2*D j := fun j k hj =>
    (sieve_curvature_entry_bound S f a (n+k)).trans
      (mul_le_mul_of_nonneg_left (drop_antitone (Nat.add_le_add_left hj n)) (by positivity))
  have hr := drop_row n
  have hk := absoluteIntersection_le_row_sum hr.1 hrow u v hu hv
  have hlim := roundedIntersection_tendsto K u v hk.1
  refine ⟨hk.1,hk.2.trans ?_,hlim,?_⟩
  · have hn := add_nonneg (tsum_nonneg fun i => sq_nonneg (u i)) (tsum_nonneg fun j => sq_nonneg (v j))
    calc _ ≤ (sieveCost S a/2/2)*((∑' i, u i^2)+(∑' j, v j^2))*(1/(2*((n:ℝ)+1)*((n:ℝ)+2))) :=
           mul_le_mul_of_nonneg_left hr.2 (mul_nonneg (by positivity) hn)
         _ = _ := by simp only [div_eq_mul_inv,mul_inv_rev]; ring
  · apply le_of_tendsto_of_tendsto' hlim.abs
      ((((roundedIntersection_tendsto D u u (completed_sieve_energy n u hu).1).add
        (roundedIntersection_tendsto D v v (completed_sieve_energy n v hv).1)).const_mul (sieveCost S a)).div_const 4)
    intro N
    let b (i : ℕ) := (roundedJump N (u i):ℝ)/((N:ℝ)+1)
    let c (i : ℕ) := (roundedJump N (v i):ℝ)/((N:ℝ)+1)
    simpa only [roundedIntersection,K,D,sieveEnergy,b,c,Nat.add_assoc,mul_div_assoc] using
      sieve_mixed_separate_energies S f a n (range N) (range N) b c

/-- Give the multiples of q an arbitrary common integer multiplicity.
Taking b equal to the sum of the coefficients yields the ordinary
linear combination of the original divisibility classes. -/
def divisorClassMask {ι : Type*} {q : ℕ+} (S : Finset ι) (f : ι → SieveFactor q)
    (a : ι → ℤ) (b : ℤ) (i : ℕ) : ℤ :=
  sieveMask S f a i+b*multipleMask q i

/-- Any signed sum of divisibility classes is recovered by restoring its value at q. -/
theorem divisorClassMask_eq_sum {ι : Type*} {q : ℕ+} (S : Finset ι) (f : ι → SieveFactor q)
    (a : ι → ℤ) (i : ℕ) :
    divisorClassMask S f a (∑ t ∈ S, a t) i = ∑ t ∈ S, a t*multipleMask (f t).divisor i := by
  simp only [divisorClassMask,sieveMask,mul_sub,sum_sub_distrib,sum_mul,sub_add_cancel]

/-- The multiplicity on the multiples of q contributes exactly one ordinary
full-prefix curvature. The rest has the cubic entry bound. -/
theorem divisorClassMask_curvature {ι : Type*} {q : ℕ+} (S : Finset ι) (f : ι → SieveFactor q)
    (a : ι → ℤ) (b : ℤ) (m : ℕ) :
    sieveCurvature q (divisorClassMask S f a b) m =
      (b:ℝ)*prefixDefectCurvature m+sieveCurvature q (sieveMask S f a) m := by
  let last : SieveFactor q := ⟨q,1,Nat.mul_one _⟩
  have h (k : ℕ) : endpointPoleDefect ((q:ℕ)*k) (divisorClassMask S f a b) =
      endpointPoleDefect ((q:ℕ)*k) (sieveMask S f a)+(b:ℝ)*prefixPoleDefect k := by
    have hl := multipleMask_defect last k
    change endpointPoleDefect ((q:ℕ)*k) (multipleMask q) = prefixPoleDefect (1*k) at hl
    rw [Nat.one_mul] at hl
    rw [← hl,endpoint_rows,endpoint_rows,endpoint_rows,mul_sum,← sum_add_distrib]
    exact sum_congr rfl fun i _ => by simp only [divisorClassMask,Int.cast_add,Int.cast_mul]; ring
  simp only [sieveCurvature,h,prefixDefectCurvature]
  ring

/-- Every signed divisibility mask pays the full-prefix Weil energy times
its common multiplicity on multiples of q, plus the adjacent-drop energies. -/
theorem divisor_class_separate_energies {ι : Type*} {q : ℕ+} (S : Finset ι) (f : ι → SieveFactor q)
    (a : ι → ℤ) (b : ℤ) (n : ℕ) (I J : Finset ℕ) (u v : ℕ → ℝ) :
    let E := fun (T : Finset ℕ) (w : ℕ → ℝ) =>
      ∑ i ∈ T, ∑ j ∈ T, w i*w j*realEndpoint 1 (n+1+i+j)
    |∑ i ∈ I, ∑ j ∈ J, u i*v j*sieveCurvature q (divisorClassMask S f a b) (n+i+j+1)| ≤
      |(b:ℝ)|*(E I u+E J v)+sieveCost S a*((sieveEnergy n I u+sieveEnergy n J v)/4) := by
  intro E
  have hs := sieve_mixed_separate_energies S f a n I J u v
  have hp := prefix_mixed_defect_le_weil_energies (n+1) I J u v
  have he : (∑ i ∈ I, ∑ j ∈ J, u i*v j*sieveCurvature q (divisorClassMask S f a b) (n+i+j+1)) =
      (b:ℝ)*(∑ i ∈ I, ∑ j ∈ J, u i*v j*prefixDefectCurvature (n+1+i+j)) +
        ∑ i ∈ I, ∑ j ∈ J, u i*v j*sieveCurvature q (sieveMask S f a) (n+i+j+1) := by
    simp only [mul_sum,← sum_add_distrib]
    refine sum_congr rfl fun i _ => sum_congr rfl fun j _ => ?_
    rw [divisorClassMask_curvature,show n+1+i+j = n+i+j+1 by omega]
    ring
  rw [he]
  exact (abs_add_le _ _).trans (add_le_add (by rw [abs_mul]; exact mul_le_mul_of_nonneg_left hp (abs_nonneg _)) hs)

/-- The full-prefix component and the balanced component complete on the
same square-summable sections, with their respective separate energies. -/
theorem completed_divisor_class_energies {ι : Type*} {q : ℕ+} (S : Finset ι) (f : ι → SieveFactor q)
    (a : ι → ℤ) (b : ℤ) (n : ℕ) (u v : ℕ → ℝ)
    (hu : Summable (fun i => u i^2)) (hv : Summable (fun j => v j^2)) :
    let K := fun k => sieveCurvature q (divisorClassMask S f a b) (n+k+1)
    let E := fun (D : ℕ → ℝ) (w : ℕ → ℝ) => ∑' p : ℕ × ℕ, w p.1*w p.2*D (p.1+p.2)
    let D := fun k => realEndpoint 1 (n+1+k)
    let B := fun k => weilDrop (n+k)
    let H := ∑' p : ℕ × ℕ, u p.1*v p.2*K (p.1+p.2)
    Summable (fun p : ℕ × ℕ => |u p.1*v p.2*K (p.1+p.2)|) ∧
      Tendsto (fun N => roundedIntersection N K u v) atTop (𝓝 H) ∧
      |H| ≤ |(b:ℝ)|*(E D u+E D v)+sieveCost S a*(E B u+E B v)/4 := by
  intro K E D B H
  let G (p : ℕ × ℕ) := u p.1*v p.2*prefixDefectCurvature (n+1+(p.1+p.2))
  let T (p : ℕ × ℕ) := u p.1*v p.2*sieveCurvature q (sieveMask S f a) (n+(p.1+p.2)+1)
  let m : ℕ+ := ⟨n+1,Nat.succ_pos n⟩
  have hg := infinite_pole_defect_from_integral_divisors m u v hu hv
  have ht := infinite_sieve_separate_energies S f a n u v hu hv
  have sg : Summable G := (summable_abs_iff.mp hg.1)
  have st : Summable T := (summable_abs_iff.mp ht.1)
  have he (p : ℕ × ℕ) : u p.1*v p.2*K (p.1+p.2) = (b:ℝ)*G p+T p := by
    dsimp only [K,G,T]
    rw [divisorClassMask_curvature,show n+1+(p.1+p.2)=n+(p.1+p.2)+1 by omega]
    ring
  have sk : Summable (fun p : ℕ × ℕ => |u p.1*v p.2*K (p.1+p.2)|) := by
    simp only [he]
    exact summable_abs_iff.mpr ((sg.mul_left (b:ℝ)).add st)
  refine ⟨sk,roundedIntersection_tendsto K u v sk,?_⟩
  change |∑' p : ℕ × ℕ, u p.1*v p.2*K (p.1+p.2)| ≤ _
  simp only [he,(sg.mul_left (b:ℝ)).tsum_add st,tsum_mul_left]
  apply (abs_add_le _ _).trans
  rw [abs_mul]
  exact add_le_add (mul_le_mul_of_nonneg_left hg.2.2.2 (abs_nonneg _)) ht.2.2.2

/-- Deleting every q-th conductor is a single balanced class of cost one. -/
theorem omitted_multiples_sieve (q : ℕ+) :
    let f : Unit → SieveFactor q := fun _ => ⟨1,q,Nat.one_mul _⟩
    sieveMask {()} f (fun _ => 1) = (fun i => if (q:ℕ) ∣ i then 0 else 1) ∧
      sieveCost {()} (fun _ : Unit => 1) = 1 := by
  intro f
  constructor
  · funext i
    by_cases h : (q:ℕ) ∣ i <;> simp [sieveMask,multipleMask,f,h]
  · norm_num [sieveCost]

