import GaloisForLFunctions.ArithmeticCastelnuovoSeveri.FiniteField.KummerPuncturedJacobiCount

/-!
# Hasse–Weil for the Kummer family from the two pairings

A proof of the Riemann hypothesis for the curves `zⁿ⁺¹ = c · x (1 − x)ᵃ` over a finite field in
which no positivity of a form enters, and the archimedean places of a number field do.

* The point count is a sum of Jacobi sums over the characters of order dividing `n + 1`
  (`puncturedKummerPoints_card_eq_jacobi_sum`, by orthogonality of characters).
* A Jacobi sum has two pairings. The polarization `J(χ, φ) · J(χ⁻¹, φ⁻¹) = q` is an identity in
  the ring of values. The conjugation `conj σ(J(χ, φ)) = σ(J(χ⁻¹, φ⁻¹))` holds for every embedding
  `σ` of that ring in `ℂ`, because characters take values in roots of unity. Hence
  `‖σ(J(χ, φ))‖² = q` at every archimedean place (`norm_map_jacobiSum_sq`).
* `abs_card_puncturedKummerPoints_sub_le`: the number of points with `x ≠ 0, 1` differs from
  `q − 2` by at most `n √q`.

The comparison of sizes is between the two pairings of one algebraic integer; the price `√q` is
paid at the archimedean places of the field generated by the values of the characters.
-/

noncomputable section

open scoped Classical
open ComplexConjugate

namespace GaloisForLFunctions.ArithmeticProducerTheory

open ArithmeticHarmonicAnalysis ArithmeticCastelnuovoSeveri

variable {K : Type*} [Field K] [Fintype K]

local instance : Fintype (MulChar K ℂ) := Fintype.ofFinite _

/-- **The conjugation pair**: `conj J(χ, φ) = J(χ⁻¹, φ⁻¹)`. -/
theorem conj_jacobiSum (χ φ : MulChar K ℂ) : conj (jacobiSum χ φ) = jacobiSum χ⁻¹ φ⁻¹ := by
  simp only [jacobiSum, map_sum, map_mul, starRingEnd_apply, MulChar.star_apply']

/-- **A Jacobi sum is pure at every archimedean place.** For characters with values in a
commutative ring `R` and every embedding `σ : R → ℂ`, `‖σ(J(χ, φ))‖² = q`: the polarization pair
is an identity in `R`, and the conjugation pair holds at `σ`. -/
theorem norm_map_jacobiSum_sq {R : Type*} [CommRing R] (σ : R →+* ℂ)
    (hσ : Function.Injective σ) {χ φ : MulChar K R} (hχ : χ ≠ 1) (hφ : φ ≠ 1)
    (hχφ : χ * φ ≠ 1) : ‖σ (jacobiSum χ φ)‖ ^ 2 = Fintype.card K := by
  have h1 : χ.ringHomComp σ ≠ 1 := (MulChar.ringHomComp_ne_one_iff hσ).mpr hχ
  have h2 : φ.ringHomComp σ ≠ 1 := (MulChar.ringHomComp_ne_one_iff hσ).mpr hφ
  have h3 : χ.ringHomComp σ * φ.ringHomComp σ ≠ 1 := by
    rw [← MulChar.ringHomComp_mul]
    exact (MulChar.ringHomComp_ne_one_iff hσ).mpr hχφ
  have hchar : ringChar ℂ ≠ ringChar K := by
    rw [ringChar.eq_zero]
    exact (CharP.ringChar_ne_zero_of_finite K).symm
  have h := jacobiSum_mul_jacobiSum_inv hchar h1 h2 h3
  rw [← conj_jacobiSum, Complex.mul_conj, Complex.normSq_eq_norm_sq, jacobiSum_ringHomComp] at h
  exact_mod_cast h

private theorem norm_eq_one_of_pow {z : ℂ} {k : ℕ} (hk : k ≠ 0) (hz : z ^ k = 1) : ‖z‖ = 1 :=
  (pow_eq_one_iff_of_nonneg (norm_nonneg z) hk).mp (by rw [← norm_pow, hz, norm_one])

/-- Every Jacobi sum other than `J(1, 1)` has modulus at most `√q`. -/
theorem norm_jacobiSum_le_sqrt {χ φ : MulChar K ℂ} (h : χ ≠ 1 ∨ φ ≠ 1) :
    ‖jacobiSum χ φ‖ ≤ Real.sqrt (Fintype.card K) := by
  have hq : (1 : ℝ) ≤ Real.sqrt (Fintype.card K) := by
    rw [Real.one_le_sqrt]
    exact_mod_cast Fintype.card_pos
  by_cases hχ : χ = 1
  · subst hχ
    rw [jacobiSum_one_nontrivial (h.resolve_left fun h => h rfl), norm_neg, norm_one]
    exact hq
  by_cases hφ : φ = 1
  · subst hφ
    rw [jacobiSum_comm, jacobiSum_one_nontrivial hχ, norm_neg, norm_one]
    exact hq
  by_cases hχφ : χ * φ = 1
  · rw [eq_inv_of_mul_eq_one_right hχφ, jacobiSum_nontrivial_inv hχ, norm_neg,
      norm_eq_one_of_pow two_ne_zero (by rw [← map_pow, neg_one_sq, map_one])]
    exact hq
  · have h2 := norm_map_jacobiSum_sq (RingHom.id ℂ) Function.injective_id hχ hφ hχφ
    rw [RingHom.id_apply] at h2
    rw [← h2, Real.sqrt_sq (norm_nonneg _)]

/-- **Hasse–Weil for the Kummer family.** The number of points of `zⁿ⁺¹ = c · x (1 − x)ᵃ` with
`x ≠ 0, 1` differs from `q − 2` by at most `n √q`. The trivial character gives `q − 2`; each of
the at most `n` others gives a Jacobi sum of modulus at most `√q`. -/
theorem abs_card_puncturedKummerPoints_sub_le (n a : ℕ) (c : Kˣ) :
    |(Nat.card (PuncturedKummerPoints n a c) : ℝ) - ((Fintype.card K : ℝ) - 2)| ≤
      n * Real.sqrt (Fintype.card K) := by
  set H := unitEndomorphismCharacters (R := ℂ) (powMonoidHom (n + 1) : Kˣ →* Kˣ) with hH
  have hcount := puncturedKummerPoints_card_eq_jacobi_sum n a c
  rw [← hH] at hcount
  -- split off the trivial character
  have hsplit : ∑ χ : H, χ.val (c : K) * jacobiSum χ.val (χ.val ^ a) =
      ((Fintype.card K : ℂ) - 2) +
        ∑ χ ∈ Finset.univ.erase (1 : H), χ.val (c : K) * jacobiSum χ.val (χ.val ^ a) := by
    rw [← Finset.add_sum_erase _ _ (Finset.mem_univ (1 : H))]
    congr 1
    rw [OneMemClass.coe_one, one_pow, jacobiSum_one_one, MulChar.one_apply_coe, one_mul]
  -- each nontrivial character contributes at most `√q`
  have hterm : ∀ χ ∈ Finset.univ.erase (1 : H),
      ‖χ.val (c : K) * jacobiSum χ.val (χ.val ^ a)‖ ≤ Real.sqrt (Fintype.card K) := by
    intro χ hχ
    have hne : χ.val ≠ 1 := fun h => Finset.ne_of_mem_erase hχ (Subtype.ext h)
    have hc : ‖χ.val (c : K)‖ = 1 :=
      norm_eq_one_of_pow (k := Fintype.card K - 1)
        (Nat.sub_ne_zero_of_lt Fintype.one_lt_card)
        (by rw [← map_pow, FiniteField.pow_card_sub_one_eq_one _ c.ne_zero, map_one])
    rw [norm_mul, hc, one_mul]
    exact norm_jacobiSum_le_sqrt (Or.inl hne)
  -- there are at most `n` of them
  have hcard : (Finset.univ.erase (1 : H)).card ≤ n := by
    have hgcd := Nat.gcd_le_right (Nat.card K - 1) (show 0 < n + 1 by omega)
    have hH' : Fintype.card H = Nat.gcd (Nat.card K - 1) (n + 1) := by
      rw [← Nat.card_eq_fintype_card]
      exact finiteField_power_characters_card (K := K) (n + 1)
    rw [Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ, hH']
    omega
  have hC : (Nat.card (PuncturedKummerPoints n a c) : ℂ) - ((Fintype.card K : ℂ) - 2) =
      ∑ χ ∈ Finset.univ.erase (1 : H), χ.val (c : K) * jacobiSum χ.val (χ.val ^ a) := by
    rw [hcount, hsplit, add_sub_cancel_left]
  have hnorm : ‖(Nat.card (PuncturedKummerPoints n a c) : ℂ) - ((Fintype.card K : ℂ) - 2)‖ ≤
      n * Real.sqrt (Fintype.card K) := by
    rw [hC]
    calc ‖∑ χ ∈ Finset.univ.erase (1 : H), χ.val (c : K) * jacobiSum χ.val (χ.val ^ a)‖
        ≤ ∑ χ ∈ Finset.univ.erase (1 : H), ‖χ.val (c : K) * jacobiSum χ.val (χ.val ^ a)‖ :=
          norm_sum_le _ _
      _ ≤ ∑ _χ ∈ Finset.univ.erase (1 : H), Real.sqrt (Fintype.card K) := Finset.sum_le_sum hterm
      _ = (Finset.univ.erase (1 : H)).card * Real.sqrt (Fintype.card K) := by
          rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ n * Real.sqrt (Fintype.card K) :=
          mul_le_mul_of_nonneg_right (by exact_mod_cast hcard) (Real.sqrt_nonneg _)
  have hreal : (((Nat.card (PuncturedKummerPoints n a c) : ℝ) - ((Fintype.card K : ℝ) - 2) : ℝ) : ℂ) =
      (Nat.card (PuncturedKummerPoints n a c) : ℂ) - ((Fintype.card K : ℂ) - 2) := by
    push_cast
    rfl
  rw [← Real.norm_eq_abs, ← Complex.norm_real, hreal]
  exact hnorm

end GaloisForLFunctions.ArithmeticProducerTheory
