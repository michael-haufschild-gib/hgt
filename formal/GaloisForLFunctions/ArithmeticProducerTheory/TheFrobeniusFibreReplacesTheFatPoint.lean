import GaloisForLFunctions.ArithmeticProducerTheory.TheDigitOperatorsLiftTheHasseDerivatives

/-!
# The Frobenius fibre replaces the fat point

Stepanov's count uses two properties of the Hasse derivatives of order `< q`: they are linear over
the Frobenius image, and they are local (a zero of order `> k` of `f` is a zero of the `k`-th
derivative). This module decides what remains of the pair when the degree of the Frobenius is not
zero in the ring of coefficients.

* `IsLocal k P`: at every point `c`, `P` maps `𝔪_c^(k+1)` into `𝔪_c`.
* `isLocal_iff_hasOrderLE`: over an infinite domain, the local operators of order `≤ k` are the
  differential operators of order `≤ k`.
* `IsLocal.eq_mul_of_expand_linear`: if `a ≠ 0` in `R`, an operator that is linear over the image
  of `ψ_a` and local of any order is a multiplication. No Frobenius-linear operator retains a zero
  of any order.
* `fibreIdeal a c`: the fibre of `ψ_a` through `c`, the extension along `ψ_a` of the ideal of the
  point `ψ_a(c)`; it is generated by the `X_iᵃ − c_iᵃ` (`fibreIdeal_eq_span`).
* `mem_fibreIdeal_iff`: on the torus, `F` lies in the fibre ideal iff `diag φ F` vanishes at `c`
  for every `a`-periodic symbol `φ`. The Frobenius-linear diagonal operators detect vanishing on
  the fibre.
* `fibreIdeal_eq_span_pow_of_charP`: in characteristic `p` the fibre of `ψ_p` is the fat point
  `((X_i − c_i)ᵖ)`.

So the multiplicity that the Frobenius-linear operators see is vanishing on the Frobenius fibre.
In characteristic `p` the fibre is concentrated at the point and this is a zero of order `p`;
where `a` is invertible the fibre is the translate of the point by the `a`-torsion.
-/

open MvPolynomial

namespace GaloisForLFunctions.ArithmeticProducerTheory

/-- An operator of order `≤ k` maps `I^(k+1)` into `I`, for every ideal `I`. -/
theorem HasOrderLE.map_mem_of_mem_pow {A : Type*} [CommRing A] {k : ℕ} {P : A →+ A}
    (hP : HasOrderLE k P) (I : Ideal A) {f : A} (hf : f ∈ I ^ (k + 1)) : P f ∈ I := by
  induction k generalizing P f with
  | zero =>
    rw [zero_add, pow_one] at hf
    have h := hP f 1
    rw [mul_one] at h
    rw [h]
    exact I.mul_mem_right _ hf
  | succ k ih =>
    rw [pow_succ', ← Ideal.smul_eq_mul] at hf
    refine Submodule.smul_induction_on hf (fun g hg h hh => ?_) (fun x y hx hy => ?_)
    · have h1 : P (g • h) = commutator P g h + g * P h := by
        rw [commutator_apply, smul_eq_mul]
        ring
      rw [h1]
      exact I.add_mem (ih (hP g) hh) (I.mul_mem_right _ hg)
    · rw [map_add]
      exact I.add_mem hx hy

variable {σ R : Type*} [CommRing R]

/-! ### Local operators are differential operators -/

/-- The ideal of the point `c`. -/
def pointIdeal (c : σ → R) : Ideal (MvPolynomial σ R) := RingHom.ker (eval c)

theorem mem_pointIdeal {c : σ → R} {f : MvPolynomial σ R} : f ∈ pointIdeal c ↔ eval c f = 0 :=
  RingHom.mem_ker

theorem X_sub_C_mem_pointIdeal (c : σ → R) (i : σ) : X i - C (c i) ∈ pointIdeal c := by
  rw [mem_pointIdeal, map_sub, eval_X, eval_C, sub_self]

/-- Locality of order `≤ k`: at every point, a zero of `f` of order `> k` is a zero of `P f`. -/
def IsLocal (k : ℕ) (P : MvPolynomial σ R →ₗ[R] MvPolynomial σ R) : Prop :=
  ∀ (c : σ → R) (f : MvPolynomial σ R), f ∈ pointIdeal c ^ (k + 1) → P f ∈ pointIdeal c

/-- The commutator of a linear operator with a coordinate. -/
def commX (P : MvPolynomial σ R →ₗ[R] MvPolynomial σ R) (i : σ) :
    MvPolynomial σ R →ₗ[R] MvPolynomial σ R :=
  P ∘ₗ LinearMap.mulLeft R (X i) - LinearMap.mulLeft R (X i) ∘ₗ P

theorem commX_apply (P : MvPolynomial σ R →ₗ[R] MvPolynomial σ R) (i : σ)
    (f : MvPolynomial σ R) : commX P i f = P (X i * f) - X i * P f := rfl

theorem commX_toAddMonoidHom (P : MvPolynomial σ R →ₗ[R] MvPolynomial σ R) (i : σ) :
    (commX P i).toAddMonoidHom = commutator P.toAddMonoidHom (X i) :=
  AddMonoidHom.ext fun _ => rfl

/-- The commutator with `X_i` is the commutator with `X_i − c_i`. -/
theorem commX_apply_sub (P : MvPolynomial σ R →ₗ[R] MvPolynomial σ R) (i : σ) (c : σ → R)
    (f : MvPolynomial σ R) :
    commX P i f = P ((X i - C (c i)) * f) - (X i - C (c i)) * P f := by
  rw [commX_apply, sub_mul, sub_mul, map_sub, ← smul_eq_C_mul, ← smul_eq_C_mul, map_smul]
  abel

theorem isLocal_commX {k : ℕ} {P : MvPolynomial σ R →ₗ[R] MvPolynomial σ R}
    (hP : IsLocal (k + 1) P) (i : σ) : IsLocal k (commX P i) := by
  intro c f hf
  rw [commX_apply_sub P i c f]
  refine Ideal.sub_mem _ (hP c _ ?_) (Ideal.mul_mem_right _ _ (X_sub_C_mem_pointIdeal c i))
  rw [pow_succ']
  exact Ideal.mul_mem_mul (X_sub_C_mem_pointIdeal c i) hf

/-- An `R`-linear operator commuting with the coordinates is linear over `R[X_σ]`. -/
theorem hasOrderLE_zero_of_X (P : MvPolynomial σ R →ₗ[R] MvPolynomial σ R)
    (h : ∀ i g, P (X i * g) = X i * P g) : HasOrderLE 0 P.toAddMonoidHom := by
  have key : ∀ f g : MvPolynomial σ R, P (f * g) = f * P g := by
    intro f
    induction f using MvPolynomial.induction_on with
    | C r =>
      intro g
      rw [← smul_eq_C_mul, map_smul, smul_eq_C_mul]
    | add f₁ f₂ h₁ h₂ =>
      intro g
      rw [add_mul, map_add, h₁, h₂, add_mul]
    | mul_X f i hf =>
      intro g
      rw [mul_assoc, hf, h, mul_assoc]
  exact key

/-- A local operator of order `≤ k` is a differential operator of order `≤ k`. Induction on `k`:
the commutator with a coordinate is local of order one less, and a local operator of order `0`
commutes with the coordinates because its commutators vanish at every point. -/
theorem IsLocal.hasOrderLE [IsDomain R] [Infinite R] :
    ∀ {k : ℕ} {P : MvPolynomial σ R →ₗ[R] MvPolynomial σ R}, IsLocal k P →
      HasOrderLE k P.toAddMonoidHom := by
  intro k
  induction k with
  | zero =>
    intro P hP
    refine hasOrderLE_zero_of_X P fun i g => ?_
    have h0 : commX P i g = 0 := by
      refine MvPolynomial.funext fun c => ?_
      have h1 : P ((X i - C (c i)) * g) ∈ pointIdeal c :=
        hP c _ (by
          rw [zero_add, pow_one]
          exact Ideal.mul_mem_right _ _ (X_sub_C_mem_pointIdeal c i))
      have h2 : (X i - C (c i)) * P g ∈ pointIdeal c :=
        Ideal.mul_mem_right _ _ (X_sub_C_mem_pointIdeal c i)
      have h3 : commX P i g ∈ pointIdeal c := by
        rw [commX_apply_sub P i c g]
        exact Ideal.sub_mem _ h1 h2
      rw [mem_pointIdeal.mp h3, map_zero]
    rw [commX_apply] at h0
    exact sub_eq_zero.mp h0
  | succ k ih =>
    intro P hP
    refine hasOrderLE_succ_of_X P fun i => ?_
    rw [← commX_toAddMonoidHom]
    exact ih (isLocal_commX hP i)

/-- A differential operator of order `≤ k` is local of order `≤ k`. -/
theorem isLocal_of_hasOrderLE {k : ℕ} {P : MvPolynomial σ R →ₗ[R] MvPolynomial σ R}
    (hP : HasOrderLE k P.toAddMonoidHom) : IsLocal k P :=
  fun c _ hf => hP.map_mem_of_mem_pow (pointIdeal c) hf

/-- **Local operators are the differential operators.** -/
theorem isLocal_iff_hasOrderLE [IsDomain R] [Infinite R] {k : ℕ}
    {P : MvPolynomial σ R →ₗ[R] MvPolynomial σ R} :
    IsLocal k P ↔ HasOrderLE k P.toAddMonoidHom :=
  ⟨IsLocal.hasOrderLE, isLocal_of_hasOrderLE⟩

/-- **No Frobenius-linear operator retains a zero.** If `a ≠ 0` in an infinite domain `R`, an
`R`-linear operator that is linear over the image of `ψ_a` and maps zeros of some fixed order
`> k` to zeros is multiplication by its value at `1`. -/
theorem IsLocal.eq_mul_of_expand_linear [IsDomain R] [Infinite R] {a : ℕ} (ha : (a : R) ≠ 0)
    {k : ℕ} {P : MvPolynomial σ R →ₗ[R] MvPolynomial σ R} (hP : IsLocal k P)
    (hlin : ∀ g f, P (expand a g * f) = expand a g * P f) (f : MvPolynomial σ R) :
    P f = f * P 1 :=
  hP.hasOrderLE.eq_mul_of_expand_linear (IsRegular.of_ne_zero ha) hlin f

/-! ### The fibre of the Frobenius -/

/-- The fibre of `ψ_a` through `c`: the extension along `ψ_a` of the ideal of the point
`ψ_a(c) = (c_iᵃ)`. -/
def fibreIdeal (a : ℕ) (c : σ → R) : Ideal (MvPolynomial σ R) :=
  Ideal.map (expand a : MvPolynomial σ R →ₐ[R] MvPolynomial σ R) (pointIdeal (c ^ a))

/-- The ideal of a point is generated by the `X_i − c_i`. -/
theorem pointIdeal_eq_span (c : σ → R) :
    pointIdeal c = Ideal.span (Set.range fun i => X i - C (c i)) := by
  refine le_antisymm (fun f hf => ?_) ?_
  · have key : ∀ g : MvPolynomial σ R,
        g - C (eval c g) ∈ Ideal.span (Set.range fun i => X i - C (c i)) := by
      intro g
      induction g using MvPolynomial.induction_on with
      | C r => rw [eval_C, sub_self]; exact Ideal.zero_mem _
      | add p q hp hq =>
        have e : p + q - C (eval c (p + q)) = (p - C (eval c p)) + (q - C (eval c q)) := by
          rw [map_add, map_add]
          ring
        rw [e]
        exact Ideal.add_mem _ hp hq
      | mul_X p i hp =>
        have e : p * X i - C (eval c (p * X i)) =
            (p - C (eval c p)) * X i + C (eval c p) * (X i - C (c i)) := by
          rw [map_mul, eval_X, map_mul]
          ring
        rw [e]
        exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp)
          (Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩))
    have h := key f
    rwa [mem_pointIdeal.mp hf, map_zero, sub_zero] at h
  · rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact X_sub_C_mem_pointIdeal c i

/-- The fibre ideal is generated by the `X_iᵃ − c_iᵃ`. -/
theorem fibreIdeal_eq_span (a : ℕ) (c : σ → R) :
    fibreIdeal a c = Ideal.span (Set.range fun i => X i ^ a - C (c i ^ a)) := by
  rw [fibreIdeal, pointIdeal_eq_span, Ideal.map_span, ← Set.range_comp]
  congr 2
  funext i
  simp only [Function.comp_apply, map_sub, expand_X, expand_C, Pi.pow_apply]

/-- **In characteristic `p` the fibre of `ψ_p` is the fat point.** -/
theorem fibreIdeal_eq_span_pow_of_charP (p : ℕ) [Fact p.Prime] [CharP R p] (c : σ → R) :
    fibreIdeal p c = Ideal.span (Set.range fun i => (X i - C (c i)) ^ p) := by
  rw [fibreIdeal_eq_span]
  congr 2
  funext i
  rw [sub_pow_char, map_pow]

/-- Coordinatewise remainder of an exponent modulo `a`. -/
def modExp (a : ℕ) (m : σ →₀ ℕ) : σ →₀ ℕ := m.mapRange (· % a) (Nat.zero_mod a)

/-- Coordinatewise quotient of an exponent by `a`. -/
def divExp (a : ℕ) (m : σ →₀ ℕ) : σ →₀ ℕ := m.mapRange (· / a) (Nat.zero_div a)

theorem modExp_add_divExp (a : ℕ) (m : σ →₀ ℕ) : modExp a m + a • divExp a m = m := by
  ext i
  simp only [Finsupp.add_apply, Finsupp.smul_apply, modExp, divExp, Finsupp.mapRange_apply,
    smul_eq_mul]
  exact Nat.mod_add_div (m i) a

theorem modExp_smul_add (a : ℕ) (k m : σ →₀ ℕ) : modExp a (a • k + m) = modExp a m := by
  ext i
  simp only [Finsupp.add_apply, Finsupp.smul_apply, modExp, Finsupp.mapRange_apply, smul_eq_mul,
    Nat.mul_add_mod]

/-- Every monomial is a reduced monomial times a Frobenius pullback. -/
theorem monomial_eq_mul_expand (a : ℕ) (m : σ →₀ ℕ) (d : R) :
    monomial m d = monomial (modExp a m) d * expand a (monomial (divExp a m) 1) := by
  rw [expand_monomial, monomial_mul, mul_one, modExp_add_divExp]

theorem eval_monomial_split (a : ℕ) (c : σ → R) (m : σ →₀ ℕ) :
    eval c (monomial m (1 : R)) =
      eval c (monomial (modExp a m) 1) * eval (c ^ a) (monomial (divExp a m) 1) := by
  conv_lhs => rw [monomial_eq_mul_expand a m 1]
  rw [map_mul, eval_expand]

/-- A vanishing condition on the fibre for every periodic symbol: one direction. -/
theorem eval_diag_eq_zero_of_mem_fibreIdeal {a : ℕ} {c : σ → R} {F : MvPolynomial σ R}
    (hF : F ∈ fibreIdeal a c) {φ : (σ →₀ ℕ) → R} (hφ : ∀ k m, φ (a • k + m) = φ m) :
    eval c (diag φ F) = 0 := by
  have hF' : F ∈ Submodule.span (MvPolynomial σ R)
      ((expand a : MvPolynomial σ R →ₐ[R] MvPolynomial σ R) ''
        (pointIdeal (c ^ a) : Set (MvPolynomial σ R))) := hF
  revert φ
  refine Submodule.span_induction
    (p := fun F _ => ∀ {φ : (σ →₀ ℕ) → R}, (∀ k m, φ (a • k + m) = φ m) → eval c (diag φ F) = 0)
    ?_ ?_ ?_ ?_ hF'
  · rintro _ ⟨g, hg, rfl⟩ φ hφ
    have h := diag_expand_mul hφ g 1
    rw [mul_one] at h
    rw [h, map_mul, eval_expand, mem_pointIdeal.mp hg, zero_mul]
  · intro φ _
    rw [map_zero, map_zero]
  · intro x y _ _ hx hy φ hφ
    rw [map_add, map_add, hx hφ, hy hφ, add_zero]
  · intro r x _ hx φ hφ
    rw [smul_eq_mul]
    induction r using MvPolynomial.induction_on' with
    | monomial k d =>
      -- a translate of a periodic symbol is periodic
      have hshift : ∀ l m, φ (k + (a • l + m)) = φ (k + m) := fun l m => by
        rw [← add_assoc, add_comm k (a • l), add_assoc, hφ]
      rw [diag_monomial_mul, map_mul, hx hshift, mul_zero]
    | add p q hp hq => rw [add_mul, map_add, map_add, hp, hq, add_zero]

/-- Reduction modulo the fibre: `X^m ↦ ψ_a(c)^(m / a) · X^(m % a)`. -/
noncomputable def fibreRed (a : ℕ) (c : σ → R) : MvPolynomial σ R →ₗ[R] MvPolynomial σ R :=
  (basisMonomials σ R).constr R fun m =>
    monomial (modExp a m) (eval (c ^ a) (monomial (divExp a m) (1 : R)))

theorem fibreRed_monomial (a : ℕ) (c : σ → R) (m : σ →₀ ℕ) (d : R) :
    fibreRed a c (monomial m d) =
      monomial (modExp a m) (d * eval (c ^ a) (monomial (divExp a m) (1 : R))) := by
  have h : monomial m d = d • basisMonomials σ R m := by
    rw [coe_basisMonomials, smul_monomial, smul_eq_mul, mul_one]
  rw [h, map_smul, fibreRed, Module.Basis.constr_basis, smul_monomial, smul_eq_mul]

/-- Every polynomial is congruent to its reduction modulo the fibre ideal. -/
theorem sub_fibreRed_mem (a : ℕ) (c : σ → R) (F : MvPolynomial σ R) :
    F - fibreRed a c F ∈ fibreIdeal a c := by
  induction F using MvPolynomial.induction_on' with
  | monomial m d =>
    have hk : monomial (divExp a m) (1 : R) - C (eval (c ^ a) (monomial (divExp a m) (1 : R))) ∈
        pointIdeal (c ^ a) := by
      rw [mem_pointIdeal, map_sub, eval_C, sub_self]
    have e : monomial m d - fibreRed a c (monomial m d) =
        monomial (modExp a m) d * expand a
          (monomial (divExp a m) (1 : R) - C (eval (c ^ a) (monomial (divExp a m) (1 : R)))) := by
      rw [fibreRed_monomial, map_sub, expand_C, mul_sub, ← monomial_eq_mul_expand,
        mul_comm (monomial (modExp a m) d) (C _), C_mul_monomial, mul_comm d]
    rw [e]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ hk)
  | add p q hp hq =>
    have e : p + q - fibreRed a c (p + q) = (p - fibreRed a c p) + (q - fibreRed a c q) := by
      rw [map_add]
      ring
    rw [e]
    exact Ideal.add_mem _ hp hq

/-- The value at `c` of the component of `F` with exponents `≡ r` is `c^r` times the coefficient
of `X^r` in the reduction. -/
theorem eval_diag_indicator (a : ℕ) (c : σ → R) (r : σ →₀ ℕ) (F : MvPolynomial σ R) :
    eval c (diag (fun m => if modExp a m = r then (1 : R) else 0) F) =
      eval c (monomial r (1 : R)) * coeff r (fibreRed a c F) := by
  classical
  induction F using MvPolynomial.induction_on' with
  | monomial m d =>
    rw [diag_monomial, fibreRed_monomial, coeff_monomial]
    by_cases h : modExp a m = r
    · rw [if_pos h, if_pos h, one_mul, ← h, ← C_mul_monomial, mul_one, map_mul, eval_C,
        eval_monomial_split a c m]
      ring
    · rw [if_neg h, if_neg h, zero_mul, mul_zero, monomial_zero, map_zero]
  | add p q hp hq => rw [map_add, map_add, hp, hq, map_add, coeff_add, mul_add]

theorem eval_monomial_ne_zero [IsDomain R] {c : σ → R} (hc : ∀ i, c i ≠ 0) (r : σ →₀ ℕ) :
    eval c (monomial r (1 : R)) ≠ 0 := by
  rw [eval_monomial, one_mul]
  exact Finsupp.prod_ne_zero_iff.mpr fun i _ => pow_ne_zero _ (hc i)

/-- **The Frobenius-linear operators cut out the Frobenius fibre.** At a point `c` of the torus
over a domain, `F` lies in the ideal of the fibre of `ψ_a` through `c` iff `diag φ F` vanishes at
`c` for every `a`-periodic symbol `φ`. -/
theorem mem_fibreIdeal_iff [IsDomain R] {a : ℕ} {c : σ → R} (hc : ∀ i, c i ≠ 0)
    {F : MvPolynomial σ R} :
    F ∈ fibreIdeal a c ↔
      ∀ φ : (σ →₀ ℕ) → R, (∀ k m, φ (a • k + m) = φ m) → eval c (diag φ F) = 0 := by
  refine ⟨fun hF φ hφ => eval_diag_eq_zero_of_mem_fibreIdeal hF hφ, fun h => ?_⟩
  have hred : fibreRed a c F = 0 := by
    ext r
    rw [coeff_zero]
    have h1 := eval_diag_indicator a c r F
    rw [h _ (fun k m => by rw [modExp_smul_add])] at h1
    exact (mul_eq_zero.mp h1.symm).resolve_left (eval_monomial_ne_zero hc r)
  have h2 := sub_fibreRed_mem a c F
  rwa [hred, sub_zero] at h2

end GaloisForLFunctions.ArithmeticProducerTheory
