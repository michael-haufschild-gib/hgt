import GaloisForLFunctions.RenormalizedIntersectionArithmeticCounts.HeckeChargeSeparation
import Mathlib.LinearAlgebra.Finsupp.LSum
import Mathlib.Data.ZMod.Basic
import Mathlib.Data.Real.Basic

/-!
# Arithmetic sections retaining every conductor dilation

Integer probes are freely generated by their conductors. The common kernel
of all dilated Möbius charges consists exactly of nonsquarefree coordinates.
The resulting section module retains every squarefree coefficient and carries
actual conductor multiplication. Prime multiplication is nonzero and nilpotent;
the single-charge quotient cannot carry the same action.
-/

noncomputable section
open Finset ArithmeticFunction
namespace GaloisForLFunctions.RenormalizedIntersectionArithmeticCounts

/-- Integer arithmetic probes with finite conductor support. -/
abbrev ArithmeticSectionProbe := ℕ →₀ ℤ

/-- Conductor multiplication on the actual integral generators. -/
def arithmeticSectionDilation (a : ℕ) : ArithmeticSectionProbe →ₗ[ℤ] ArithmeticSectionProbe :=
  Finsupp.lmapDomain ℤ ℤ (fun n => a*n)

/-- The integral arithmetic charge before taking a quotient. -/
def arithmeticSectionCharge : ArithmeticSectionProbe →ₗ[ℤ] ℤ :=
  Finsupp.linearCombination ℤ (fun n => moebius n)

/-- Discard exactly the coefficients of conductors divisible by a prime square. -/
def arithmeticSectionRelations : Submodule ℤ ArithmeticSectionProbe where
  carrier v := ∀ n, Squarefree n → v n = 0
  zero_mem' := by intro n _; rfl
  add_mem' := by intro v w hv hw n hn; simp only [Finsupp.add_apply, hv n hn, hw n hn, add_zero]
  smul_mem' := by intro c v hv n hn; simp only [Finsupp.smul_apply, hv n hn, smul_zero]

/-- Integral sections modulo nonsquarefree conductors; no charge enters the definition. -/
abbrev ArithmeticSectionQuotient := ArithmeticSectionProbe ⧸ arithmeticSectionRelations

/-- Squarefree coefficients, with their original integer conductor labels. -/
abbrev SquarefreeArithmeticSections := {n : ℕ // Squarefree n} →₀ ℤ

/-- Retain the squarefree coefficients of an integer probe. -/
def arithmeticSquarefreeRestriction : ArithmeticSectionProbe →ₗ[ℤ] SquarefreeArithmeticSections where
  toFun v := v.subtypeDomain Squarefree
  map_add' v w := by ext n; rfl
  map_smul' c v := by ext n; rfl

/-- Extend squarefree arithmetic sections by zero. -/
def arithmeticSquarefreeExtension : SquarefreeArithmeticSections →ₗ[ℤ] ArithmeticSectionProbe :=
  Finsupp.lmapDomain ℤ ℤ Subtype.val

/-- Conductors multiply on generators, including repeated prime factors. -/
theorem arithmeticSectionDilation_single (a n : ℕ) (c : ℤ) :
    arithmeticSectionDilation a (Finsupp.single n c) = Finsupp.single (a*n) c := by
  simp only [arithmeticSectionDilation, Finsupp.lmapDomain_apply, Finsupp.mapDomain_single]

/-- The dilation operators form the actual multiplicative conductor action. -/
theorem arithmeticSectionDilation_comp (a b : ℕ) :
    (arithmeticSectionDilation a).comp (arithmeticSectionDilation b) =
      arithmeticSectionDilation (a*b) := by
  apply Finsupp.lhom_ext
  intro n c
  simp only [LinearMap.comp_apply, arithmeticSectionDilation_single, mul_assoc]

/-- The unit conductor acts identically. -/
theorem arithmeticSectionDilation_one : arithmeticSectionDilation 1 = LinearMap.id := by
  apply Finsupp.lhom_ext
  intro n c
  simp only [arithmeticSectionDilation_single, one_mul, LinearMap.id_apply]

/-- A translated arithmetic observation is its original finite integer sum. -/
theorem arithmeticSectionCharge_dilation (a : ℕ) (v : ArithmeticSectionProbe) :
    arithmeticSectionCharge (arithmeticSectionDilation a v) =
      ∑ n ∈ v.support, moebius (a*n) * v n := by
  simp only [arithmeticSectionCharge, Finsupp.linearCombination_apply,
    arithmeticSectionDilation, Finsupp.lmapDomain_apply, smul_eq_mul]
  rw [Finsupp.sum_mapDomain_index (fun _ => zero_mul _)
    (fun _ _ _ => add_mul _ _ _)]
  simp only [Finsupp.sum, mul_comm]

/-- A support bound realizes the global arithmetic observation in its finite window. -/
theorem arithmeticSectionCharge_cutoff (a N : ℕ) (v : ArithmeticSectionProbe)
    (hN : ∀ n ∈ v.support, n ≤ N) :
    arithmeticSectionCharge (arithmeticSectionDilation a v) =
      conductorDilatedCharge N a (fun n => v n.val) := by
  rw [arithmeticSectionCharge_dilation]
  have hsub : v.support ⊆ insert 0 (Icc 1 N) := by
    intro n hn
    by_cases hz : n = 0
    · exact mem_insert.mpr (Or.inl hz)
    · exact mem_insert.mpr (Or.inr (mem_Icc.mpr ⟨Nat.pos_of_ne_zero hz, hN n hn⟩))
  have he : (∑ n ∈ v.support, moebius (a*n)*v n) =
      ∑ n ∈ insert 0 (Icc 1 N), moebius (a*n)*v n := by
    apply sum_subset hsub
    intro n _ hn
    rw [Finsupp.notMem_support_iff.mp hn, mul_zero]
  rw [he, sum_insert (by simp : 0 ∉ Icc 1 N)]
  simp only [mul_zero, ArithmeticFunction.map_zero, zero_mul, zero_add]
  exact sum_subtype (Icc 1 N) (by intro n; rfl) (fun n => moebius (a*n)*v n)

/-- The full family of conductor dilations detects exactly the squarefree coefficients. -/
theorem arithmeticSectionCharge_all_vanish_iff (v : ArithmeticSectionProbe) :
    (∀ a, arithmeticSectionCharge (arithmeticSectionDilation a v) = 0) ↔
      ∀ n, Squarefree n → v n = 0 := by
  constructor
  · intro h n hn
    by_cases hs : n ∈ v.support
    · let N := v.support.sup id
      have hN : ∀ m ∈ v.support, m ≤ N := fun m hm => le_sup (f := id) hm
      have hf : ∀ a : ConductorWindow N,
          conductorDilatedCharge N a.val (fun m => v m.val) = 0 := by
        intro a
        rw [← arithmeticSectionCharge_cutoff a.val N v hN]
        exact h a.val
      exact (conductorDilatedCharge_vanish_iff N (fun m => v m.val)).mp hf
        ⟨n, mem_Icc.mpr ⟨Nat.pos_of_ne_zero hn.ne_zero, hN n hs⟩⟩ hn
    · exact Finsupp.notMem_support_iff.mp hs
  · intro h a
    rw [arithmeticSectionCharge_dilation]
    apply sum_eq_zero
    intro n _
    by_cases hn : Squarefree n
    · rw [h n hn, mul_zero]
    · have hm : moebius (a*n) = 0 := by
        apply moebius_eq_zero_of_not_squarefree
        intro hs
        exact hn (fun p hp => hs p (dvd_mul_of_dvd_right hp a))
      rw [hm, zero_mul]

/-- The independent arithmetic relations are the common kernel of all dilated charges. -/
theorem arithmeticSectionRelations_eq_iInf :
    arithmeticSectionRelations =
      ⨅ a : ℕ, LinearMap.ker (arithmeticSectionCharge.comp (arithmeticSectionDilation a)) := by
  ext v
  simp only [Submodule.mem_iInf, LinearMap.mem_ker, LinearMap.comp_apply]
  exact (arithmeticSectionCharge_all_vanish_iff v).symm

/-- The independent relation quotient is exactly restriction to squarefree conductors. -/
theorem arithmeticSectionRelations_eq_ker :
    arithmeticSectionRelations = LinearMap.ker arithmeticSquarefreeRestriction := by
  ext v
  change (∀ n, Squarefree n → v n = 0) ↔ arithmeticSquarefreeRestriction v = 0
  constructor
  · intro h
    ext n
    exact h n.val n.property
  · intro h n hn
    exact congrArg (fun w : SquarefreeArithmeticSections => w ⟨n,hn⟩) h

/-- Every squarefree section is an actual integer probe. -/
theorem arithmeticSquarefreeRestriction_extension (v : SquarefreeArithmeticSections) :
    arithmeticSquarefreeRestriction (arithmeticSquarefreeExtension v) = v := by
  ext n
  change (Finsupp.mapDomain Subtype.val v) n.val = v n
  exact Finsupp.mapDomain_apply Subtype.val_injective v n

/-- The quotient retains all squarefree coordinates, integrally and without denominators. -/
def arithmeticSectionQuotientEquiv :
    ArithmeticSectionQuotient ≃ₗ[ℤ] SquarefreeArithmeticSections := by
  change (ArithmeticSectionProbe ⧸ arithmeticSectionRelations) ≃ₗ[ℤ] _
  rw [arithmeticSectionRelations_eq_ker]
  exact arithmeticSquarefreeRestriction.quotKerEquivOfSurjective
    (fun v => ⟨arithmeticSquarefreeExtension v, arithmeticSquarefreeRestriction_extension v⟩)

/-- Multiplying conductors preserves the actual common relation kernel. -/
theorem arithmeticSectionRelations_dilation (a : ℕ) (v : ArithmeticSectionProbe)
    (hv : v ∈ arithmeticSectionRelations) :
    arithmeticSectionDilation a v ∈ arithmeticSectionRelations := by
  rw [arithmeticSectionRelations_eq_iInf] at hv ⊢
  simp only [Submodule.mem_iInf, LinearMap.mem_ker, LinearMap.comp_apply] at hv ⊢
  intro b
  have he := congrArg (fun T : ArithmeticSectionProbe →ₗ[ℤ] ArithmeticSectionProbe => T v)
    (arithmeticSectionDilation_comp b a)
  change arithmeticSectionDilation b (arithmeticSectionDilation a v) = _ at he
  rw [he]
  exact hv (b*a)

/-- The relation module is the largest dilation-stable submodule of the charge kernel. -/
theorem arithmeticSectionRelations_isGreatest :
    IsGreatest {K : Submodule ℤ ArithmeticSectionProbe |
      K ≤ LinearMap.ker arithmeticSectionCharge ∧
        ∀ a, K ≤ K.comap (arithmeticSectionDilation a)} arithmeticSectionRelations := by
  constructor
  · constructor
    · intro v hv
      have h := (arithmeticSectionCharge_all_vanish_iff v).mpr hv 1
      change arithmeticSectionCharge v = 0
      simpa only [arithmeticSectionDilation_one, LinearMap.id_apply] using h
    · intro a v hv
      exact arithmeticSectionRelations_dilation a v hv
  · intro K hK v hv
    change ∀ n, Squarefree n → v n = 0
    apply (arithmeticSectionCharge_all_vanish_iff v).mp
    intro a
    exact hK.1 (hK.2 a hv)

/-- The original charge descends to the full arithmetic section module. -/
def arithmeticSectionChargeOnQuotient : ArithmeticSectionQuotient →ₗ[ℤ] ℤ :=
  arithmeticSectionRelations.liftQ arithmeticSectionCharge
    arithmeticSectionRelations_isGreatest.1.1

/-- The descended charge is evaluated on the original integer probe. -/
theorem arithmeticSectionChargeOnQuotient_mk (v : ArithmeticSectionProbe) :
    arithmeticSectionChargeOnQuotient (Submodule.Quotient.mk v) = arithmeticSectionCharge v := rfl

/-- Conductor multiplication descends to the independently defined arithmetic quotient. -/
def arithmeticSectionHecke (a : ℕ) : ArithmeticSectionQuotient →ₗ[ℤ] ArithmeticSectionQuotient :=
  Submodule.mapQ _ _ (arithmeticSectionDilation a)
    (fun v hv => arithmeticSectionRelations_dilation a v hv)

/-- The quotient action is computed by multiplying the original integer conductors. -/
theorem arithmeticSectionHecke_mk (a : ℕ) (v : ArithmeticSectionProbe) :
    arithmeticSectionHecke a (Submodule.Quotient.mk v) =
      Submodule.Quotient.mk (arithmeticSectionDilation a v) := rfl

/-- Multiplicativity survives the actual quotient. -/
theorem arithmeticSectionHecke_comp (a b : ℕ) :
    (arithmeticSectionHecke a).comp (arithmeticSectionHecke b) =
      arithmeticSectionHecke (a*b) := by
  apply LinearMap.ext
  intro q
  obtain ⟨v, rfl⟩ := Submodule.Quotient.mk_surjective arithmeticSectionRelations q
  change Submodule.Quotient.mk (arithmeticSectionDilation a (arithmeticSectionDilation b v)) = _
  have h := congrArg (fun T : ArithmeticSectionProbe →ₗ[ℤ] ArithmeticSectionProbe => T v)
    (arithmeticSectionDilation_comp a b)
  exact congrArg (Submodule.Quotient.mk (p := arithmeticSectionRelations)) h

/-- The unit conductor acts as identity on arithmetic sections. -/
theorem arithmeticSectionHecke_one : arithmeticSectionHecke 1 = LinearMap.id := by
  apply LinearMap.ext
  intro q
  obtain ⟨v, rfl⟩ := Submodule.Quotient.mk_surjective arithmeticSectionRelations q
  simp only [arithmeticSectionHecke_mk, arithmeticSectionDilation_one, LinearMap.id_apply]

/-- Every prime-square conductor acts by zero on the arithmetic section quotient. -/
theorem arithmeticSectionHecke_prime_square (p : ℕ) (hp : p.Prime) :
    arithmeticSectionHecke (p*p) = 0 := by
  apply LinearMap.ext
  intro q
  obtain ⟨v, rfl⟩ := Submodule.Quotient.mk_surjective arithmeticSectionRelations q
  rw [arithmeticSectionHecke_mk, LinearMap.zero_apply, Submodule.Quotient.mk_eq_zero]
  apply (arithmeticSectionCharge_all_vanish_iff _).mp
  intro a
  have h := congrArg (fun T : ArithmeticSectionProbe →ₗ[ℤ] ArithmeticSectionProbe => T v)
    (arithmeticSectionDilation_comp a (p*p))
  change arithmeticSectionDilation a (arithmeticSectionDilation (p*p) v) = _ at h
  rw [h, arithmeticSectionCharge_dilation]
  apply sum_eq_zero
  intro n _
  have hmu : moebius (a*(p*p)*n) = 0 := by
    apply moebius_eq_zero_of_not_squarefree
    intro hs
    have hd : p*p ∣ a*(p*p)*n := dvd_mul_of_dvd_left (dvd_mul_left (p*p) a) n
    have hu := hs p hd
    exact hp.ne_one (Nat.isUnit_iff.mp hu)
  rw [hmu, zero_mul]

/-- Prime multiplication is nonzero, despite its square vanishing. -/
theorem arithmeticSectionHecke_prime_ne_zero (p : ℕ) (hp : p.Prime) :
    arithmeticSectionHecke p ≠ 0 := by
  intro h
  have he := congrArg
    (fun T : ArithmeticSectionQuotient →ₗ[ℤ] ArithmeticSectionQuotient =>
      T (Submodule.Quotient.mk (Finsupp.single 1 1))) h
  rw [arithmeticSectionHecke_mk, arithmeticSectionDilation_single, mul_one,
    LinearMap.zero_apply, Submodule.Quotient.mk_eq_zero] at he
  have hz := he p hp.squarefree
  simp only [Finsupp.single_eq_same] at hz
  exact one_ne_zero hz

/-- A single Möbius charge cannot carry ordinary prime multiplication. -/
theorem arithmeticSectionCharge_no_prime_factor (p : ℕ) (hp : p.Prime) :
    ¬ ∃ T : ℤ →ₗ[ℤ] ℤ,
      T.comp arithmeticSectionCharge = arithmeticSectionCharge.comp (arithmeticSectionDilation p) := by
  rintro ⟨T, hT⟩
  let v : ArithmeticSectionProbe := Finsupp.single 1 1 + Finsupp.single p 1
  have hzero : arithmeticSectionCharge v = 0 := by
    simp only [v, map_add, arithmeticSectionCharge, Finsupp.linearCombination_single,
      one_smul, moebius_apply_one, moebius_apply_prime hp]
    ring
  have hpp : moebius (p*p) = 0 := by
    simpa [pow_two] using (moebius_apply_prime_pow hp (by decide : (2 : ℕ) ≠ 0))
  have hneg : arithmeticSectionCharge (arithmeticSectionDilation p v) = -1 := by
    simp only [v, map_add, arithmeticSectionDilation_single, mul_one,
      arithmeticSectionCharge, Finsupp.linearCombination_single, one_smul,
      moebius_apply_prime hp, hpp, add_zero]
  have he := congrArg (fun f : ArithmeticSectionProbe →ₗ[ℤ] ℤ => f v) hT
  simp only [LinearMap.comp_apply, hzero, _root_.map_zero, hneg] at he
  norm_num at he

/-- Residue sections on a finite window retain arbitrary labels on squarefree conductors. -/
abbrev SquarefreeResidueSections (N q : ℕ) := SquarefreeConductor N → ZMod q

/-- The independent residue count retains the complete squarefree rank. -/
theorem squarefreeResidueSections_card (N q : ℕ) :
    Nat.card (SquarefreeResidueSections N q) = q ^ Nat.card (SquarefreeConductor N) := by
  rw [SquarefreeResidueSections, Nat.card_fun, Nat.card_zmod]

/-- A nonzero similitude factor forces every normalized height on this nilpotent action to vanish. -/
theorem arithmeticSectionHecke_height_classification (p : ℕ) (hp : p.Prime) :
    {H : ArithmeticSectionQuotient → ℝ |
      H 0 = 0 ∧ ∀ x, H (arithmeticSectionHecke p x) = (p : ℝ) * H x} = {0} := by
  ext H
  constructor
  · rintro ⟨hzero, hH⟩
    apply Set.mem_singleton_iff.mpr
    funext x
    have hn : arithmeticSectionHecke p (arithmeticSectionHecke p x) = 0 := by
      have he := congrArg
        (fun T : ArithmeticSectionQuotient →ₗ[ℤ] ArithmeticSectionQuotient => T x)
        (arithmeticSectionHecke_comp p p)
      rw [arithmeticSectionHecke_prime_square p hp, LinearMap.zero_apply] at he
      exact he
    have he := hH (arithmeticSectionHecke p x)
    rw [hn, hzero, hH] at he
    have hpR : (p : ℝ) ≠ 0 := by exact_mod_cast hp.ne_zero
    exact (mul_eq_zero.mp ((mul_eq_zero.mp he.symm).resolve_left hpR)).resolve_left hpR
  · intro h
    have he : H = 0 := Set.mem_singleton_iff.mp h
    subst H
    exact ⟨rfl, fun _ => (mul_zero _).symm⟩

