import GaloisForLFunctions.ArithmeticPositiveDuality.HarmonicZeroPacketsForcePositiveAnnihilatorMass
import GaloisForLFunctions.HTGeometry.SummableSpectrumScrewHull
import GaloisForLFunctions.RHTower.WeilLagFunctionDense
import Mathlib.Topology.Algebra.Group.SubmonoidClosure

/-!
# The exact hull of nonconstant two-prime phases

Nonnegative powers of the two prime phases have the same compact closure as
integer powers. Density of the group generated by `log 2` and `log 3` identifies
this closure with the continuous phase line. Removing the constant monomial
preserves that closure.
-/

noncomputable section
set_option autoImplicit false

open Set Topology
open GaloisForLFunctions.HTGeometry

namespace GaloisForLFunctions.ArithmeticPositiveDuality.PositiveAnnihilator

variable {ι : Type*}

/-- The torus phase at the logarithmic frequency of a two-prime monomial. -/
def twoPrimePhase (γ : ι → ℝ) (d : Fin 2 →₀ ℕ) : ι → UnitAddCircle :=
  screwPhase γ (monomialLog d)

theorem twoPrimePhase_add (γ : ι → ℝ) (d e : Fin 2 →₀ ℕ) :
    twoPrimePhase γ (d + e) = twoPrimePhase γ d + twoPrimePhase γ e := by
  have hL : monomialLog (d + e) = monomialLog d + monomialLog e := by
    simp only [monomialLog, Finsupp.add_apply, Nat.cast_add]
    ring
  rw [twoPrimePhase, hL, screwPhase_add]
  rfl

private theorem twoPrimePhase_eq_nsmul (γ : ι → ℝ) (d : Fin 2 →₀ ℕ) :
    twoPrimePhase γ d = d 0 • screwPhase γ (Real.log 2) + d 1 • screwPhase γ (Real.log 3) := by
  change screwPhase γ ((d 0 : ℝ) * Real.log 2 + (d 1 : ℝ) * Real.log 3) = _
  change (screwLineHom γ) ((d 0 : ℝ) * Real.log 2 + (d 1 : ℝ) * Real.log 3) = _
  rw [map_add, ← nsmul_eq_mul, ← nsmul_eq_mul, map_nsmul, map_nsmul]
  rfl

private theorem range_twoPrimePhase (γ : ι → ℝ) :
    Set.range (twoPrimePhase γ) =
      (AddSubmonoid.closure {screwPhase γ (Real.log 2), screwPhase γ (Real.log 3)} :
        Set (ι → UnitAddCircle)) := by
  ext x
  constructor
  · rintro ⟨d, rfl⟩
    rw [twoPrimePhase_eq_nsmul]
    apply AddSubmonoid.add_mem
    · exact AddSubmonoid.nsmul_mem _ (AddSubmonoid.subset_closure (by simp)) _
    · exact AddSubmonoid.nsmul_mem _ (AddSubmonoid.subset_closure (by simp)) _
  · intro hx
    obtain ⟨m, n, rfl⟩ := (AddSubmonoid.mem_closure_pair _ _ _).mp hx
    refine ⟨Finsupp.single 0 m + Finsupp.single 1 n, ?_⟩
    rw [twoPrimePhase_eq_nsmul]
    simp

/-- Two-prime monomial phases fill the continuous relation hull densely. -/
theorem closure_range_twoPrimePhase (γ : ι → ℝ) :
    closure (Set.range (twoPrimePhase γ)) = screwHull γ := by
  let K := (AddSubgroup.closure
    {screwPhase γ (Real.log 2), screwPhase γ (Real.log 3)}).topologicalClosure
  have hK : IsClosed (K : Set (ι → UnitAddCircle)) := isClosed_closure
  have hrange : closure (Set.range (twoPrimePhase γ)) = (K : Set (ι → UnitAddCircle)) := by
    rw [range_twoPrimePhase, closure_addSubmonoidClosure_eq_closure_addSubgroupClosure]
    rfl
  have hlog : AddSubgroup.closure {Real.log 2, Real.log 3} ≤ K.comap (screwLineHom γ) := by
    apply (AddSubgroup.closure_le _).mpr
    intro x hx
    rcases hx with rfl | hx
    · exact subset_closure (AddSubgroup.subset_closure (by simp))
    · rcases hx with rfl
      exact subset_closure (AddSubgroup.subset_closure (by simp))
  have hfull (t : ℝ) : screwPhase γ t ∈ K := by
    have hclosed : IsClosed {t : ℝ | screwPhase γ t ∈ K} :=
      hK.preimage (screwPhase_continuous γ)
    have h := closure_minimal
      (show (AddSubgroup.closure {Real.log 2, Real.log 3} : Set ℝ) ⊆
        {t : ℝ | screwPhase γ t ∈ K} from hlog) hclosed
    have hdense : Dense (AddSubgroup.closure {Real.log 2, Real.log 3} : Set ℝ) := by
      simpa only [Nat.cast_ofNat] using
        (_root_.RHTower.dense_addSubgroup_log_primes (by norm_num : Nat.Prime 2)
          (by norm_num : Nat.Prime 3) (by norm_num : (2 : ℕ) ≠ 3))
    rw [hdense.closure_eq] at h
    exact h (Set.mem_univ t)
  apply Set.Subset.antisymm
  · apply closure_minimal _ (isClosed_screwHull γ)
    rintro _ ⟨d, rfl⟩
    exact screwPhase_mem_screwHull γ (monomialLog d)
  · rw [hrange]
    exact closure_minimal (Set.range_subset_iff.mpr hfull) hK

/-- Removing the constant monomial does not change the two-prime phase hull. -/
theorem closure_nonconstant_twoPrimePhase (γ : ι → ℝ) :
    closure {x | ∃ d : Fin 2 →₀ ℕ, d ≠ 0 ∧ twoPrimePhase γ d = x} = screwHull γ := by
  let D : Set (ι → UnitAddCircle) :=
    {x | ∃ d : Fin 2 →₀ ℕ, d ≠ 0 ∧ twoPrimePhase γ d = x}
  let a : Fin 2 →₀ ℕ := Finsupp.single 0 1
  have hne (d : Fin 2 →₀ ℕ) : a + d ≠ 0 := by
    intro he
    have h := congrArg (fun e : Fin 2 →₀ ℕ => e 0) he
    simp [a] at h
  have hshift : Set.range (twoPrimePhase γ) ⊆
      (fun x => twoPrimePhase γ a + x) ⁻¹' closure D := by
    rintro _ ⟨d, rfl⟩
    apply subset_closure
    exact ⟨a + d, hne d, twoPrimePhase_add γ a d⟩
  have hclosed : IsClosed ((fun x => twoPrimePhase γ a + x) ⁻¹' closure D) :=
    isClosed_closure.preimage (by fun_prop)
  have hhull := closure_minimal hshift hclosed
  rw [closure_range_twoPrimePhase] at hhull
  apply Set.Subset.antisymm
  · apply closure_minimal _ (isClosed_screwHull γ)
    rintro _ ⟨d, _, rfl⟩
    exact screwPhase_mem_screwHull γ (monomialLog d)
  · intro z hz
    have ha : twoPrimePhase γ a ∈ screwHull γ := screwPhase_mem_screwHull γ _
    have h := hhull (sub_mem_screwHull hz ha)
    change twoPrimePhase γ a + (z - twoPrimePhase γ a) ∈ closure D at h
    have he : twoPrimePhase γ a + (z - twoPrimePhase γ a) = z := by abel
    rwa [he] at h

#print axioms closure_range_twoPrimePhase
#print axioms closure_nonconstant_twoPrimePhase

end GaloisForLFunctions.ArithmeticPositiveDuality.PositiveAnnihilator
