import GaloisForLFunctions.ArithmeticPositiveDuality.PrimeGas.InverseSpectrum.HarmonicClocks.CyclicLaw
import GaloisForLFunctions.ArithmeticPositiveDuality.PrimeGas.InverseSpectrum.RapidZeros.Resonance

/-! # Primitive cycles generated by a single elementary prime -/

noncomputable section

namespace GaloisForLFunctions.ArithmeticPositiveDuality.PrimeGas.InverseSpectrum.ShellMixing

open Filter Topology
open _root_.RHTower.PrimeCoShift

/-- Clock time at which a growing block of one prime moves through one r-th of a full turn. -/
def cyclicTime (r : ℕ+) (p : Nat.Primes) (j : ℕ) := 2*resonantTime p j/(r.val:ℝ)

theorem cyclicTime_pos (r : ℕ+) (p : Nat.Primes) (j : ℕ) : 0 < cyclicTime r p j :=
  div_pos (mul_pos (by norm_num) (resonantTime_pos p j)) (Nat.cast_pos.mpr r.pos)

theorem cyclicTime_tendsto (r : ℕ+) (p : Nat.Primes) : Tendsto (cyclicTime r p) atTop (𝓝 0) := by
  change Tendsto (fun j => 2*resonantTime p j/(r.val:ℝ)) atTop (𝓝 0)
  simpa only [mul_zero,zero_div] using ((resonantTime_tendsto p).const_mul 2).div_const (r.val:ℝ)

theorem cyclicTime_primitive (r : ℕ+) (p : Nat.Primes) (j : ℕ) :
    IsPrimitiveRoot (splitPhase (cyclicTime r p j) (resonantBlock p j)) r.val := by
  have he : -2*cyclicTime r p j*energy (resonantBlock p j) = -(2*Real.pi/(r.val:ℝ)) := by
    rw [cyclicTime,resonantBlock,energy_primeRayLabel,resonantTime,primeZeroSpacing,Nat.cast_add,Nat.cast_one]
    field_simp [(prime_energy_pos p).ne',show (j:ℝ)+1 ≠ 0 by positivity,
      show (r.val:ℝ) ≠ 0 by exact_mod_cast r.ne_zero]
  rw [splitPhase_eq_exp,he]
  have hex : ((-(2*Real.pi/(r.val:ℝ)):ℝ):ℂ)*Complex.I = -(2*(Real.pi:ℂ)*Complex.I/(r.val:ℂ)) := by
    push_cast
    ring
  rw [hex,Complex.exp_neg]
  exact (Complex.isPrimitiveRoot_exp _ r.ne_zero).inv

private theorem cancel_nontrivial_harmonic {u : ℂ} {r : ℕ+} (hu : IsPrimitiveRoot u r.val)
    {h : ℕ} (hp : 0 < h) (hl : h < r.val) : clockPolynomial r.val (u^h) = 0 := by
  have hn : u^h ≠ 1 := fun e => Nat.not_dvd_of_pos_of_lt hp hl ((hu.pow_eq_one_iff_dvd h).mp e)
  have he : (u^h)^r.val = 1 := by rw [← pow_mul,Nat.mul_comm,pow_mul,hu.pow_eq_one,one_pow]
  rw [clockPolynomial,geom_sum_eq hn,he,sub_self,zero_div]

/-- At the prescribed times each tested harmonic of the mixture equals δ times that of its seed. -/
theorem cyclic_harmonic_response (r : ℕ+) (p : Nat.Primes) (j : ℕ) {δ : ℝ} (hδ : 0 ≤ δ)
    (hδ' : δ ≤ 1) (v : MissingWave) {h : ℕ} (hp : 0 < h) (hl : h < r.val) :
    harmonicReading (cyclicWave r (resonantBlock p j) δ hδ hδ' v) (cyclicTime r p j) h =
      (δ:ℂ)*harmonicReading v (cyclicTime r p j) h := by
  simp only [harmonicReading,cyclic_response,splitPhase_nat_mul,
    cancel_nontrivial_harmonic (cyclicTime_primitive r p j) hp hl,mul_zero,add_zero]

theorem cyclic_harmonic_test (r : ℕ+) (p : Nat.Primes) (j : ℕ) {δ : ℝ} (hδ : 0 ≤ δ)
    (hδ' : δ ≤ 1) (v : MissingWave) :
    harmonicTest r δ (cyclicWave r (resonantBlock p j) δ hδ hδ' v) (cyclicTime r p j) := by
  intro h hp hl
  rw [cyclic_harmonic_response r p j hδ hδ' v hp hl,norm_mul,Complex.norm_real,Real.norm_of_nonneg hδ]
  exact mul_le_of_le_one_right hδ (norm_harmonicReading_le_one _ _ _)

