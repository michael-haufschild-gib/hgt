import GaloisForLFunctions.ArithmeticHodgeTheoryOfDegenerations.HodgeWitt.RaynaudAlgebra
import Mathlib.LinearAlgebra.Quotient.Basic
import Mathlib.LinearAlgebra.Span.Basic

/-!
# Stable cycles, saturated boundaries and Verschiebung torsion

In a module over the integral Raynaud operator algebra, the stable cycles are
`⋂ r, ker(dV^r)` and the saturated boundaries are `⋃ s, im(F^s d)`.
The latter lie in the former, defining the cœur quotient. Every element killed
by a power of `V` is a stable cycle killed by the same power of `p`.
These are the algebraic inclusions in §§1 and 4 of Yang's finite-torsion comparison.
No coherence or finite-length assertion is needed for these inclusions.
-/

namespace GaloisForLFunctions.ArithmeticHodgeTheoryOfDegenerations.HodgeWitt

open RaynaudAlgebra

variable (p : ℕ) (M : Type*) [AddCommGroup M] [Module (RaynaudAlgebra p) M]

/-- An integral Raynaud operator acting as a `ℤ`-linear endomorphism. -/
def operator (a : RaynaudAlgebra p) : M →ₗ[ℤ] M where
  toFun x := a • x
  map_add' := smul_add a
  map_smul' n x := smul_comm a n x

@[simp] theorem operator_apply (a : RaynaudAlgebra p) (x : M) :
    operator p M a x = a • x := rfl

/-- Cycles that remain cycles under every iterate of Verschiebung. -/
def stableCycles : Submodule ℤ M :=
  ⨅ r : ℕ, LinearMap.ker (operator p M (d p * V p ^ r))

/-- The submodule generated by all Frobenius iterates of boundaries. -/
def saturatedBoundaries : Submodule ℤ M :=
  ⨆ s : ℕ, LinearMap.range (operator p M (F p ^ s * d p))

/-- Elements annihilated by some power of Verschiebung. -/
def verschiebungTorsion : Submodule ℤ M :=
  ⨆ n : ℕ, LinearMap.ker (operator p M (V p ^ n))

/-- Elements annihilated by some power of the integer `p`. -/
def primaryTorsion : Submodule ℤ M :=
  ⨆ n : ℕ, LinearMap.ker (operator p M ((p : RaynaudAlgebra p) ^ n))

theorem mem_stableCycles (x : M) :
    x ∈ stableCycles p M ↔ ∀ r : ℕ, (d p * V p ^ r) • x = 0 := by
  simp only [stableCycles, Submodule.mem_iInf, LinearMap.mem_ker, operator_apply]

theorem stableCycles_le_cycles : stableCycles p M ≤ LinearMap.ker (operator p M (d p)) := by
  intro x hx
  have h := (mem_stableCycles p M x).mp hx 0
  change d p • x = 0
  simpa only [pow_zero, mul_one] using h

/-- Every Frobenius iterate of every boundary is a stable cycle. -/
theorem saturatedBoundaries_le_stableCycles :
    saturatedBoundaries p M ≤ stableCycles p M := by
  refine iSup_le fun s x hx => ?_
  obtain ⟨y, rfl⟩ := hx
  apply (mem_stableCycles p M _).mpr
  intro r
  change (d p * V p ^ r) • ((F p ^ s * d p) • y) = 0
  rw [← mul_smul, ← mul_assoc, d_mul_V_pow_mul_F_pow_mul_d, zero_smul]

/-- The cœur, with saturated boundaries regarded as a submodule of stable cycles. -/
def Coeur := stableCycles p M ⧸
  (saturatedBoundaries p M).comap (stableCycles p M).subtype

/-- The differential vanishes on every Verschiebung-power torsion element,
even after an arbitrary further Verschiebung iterate. -/
theorem verschiebungTorsion_le_stableCycles :
    verschiebungTorsion p M ≤ stableCycles p M := by
  refine iSup_le fun n x hx => ?_
  change V p ^ n • x = 0 at hx
  apply (mem_stableCycles p M x).mpr
  intro r
  calc
    (d p * V p ^ r) • x = (F p ^ n * d p * V p ^ n * V p ^ r) • x := by
      rw [F_pow_mul_d_mul_V_pow]
    _ = (F p ^ n * d p * V p ^ r) • (V p ^ n • x) := by
      rw [← mul_smul]
      congr 1
      rw [mul_assoc _ (V p ^ n), (Commute.refl (V p)).pow_pow n r |>.eq,
        ← mul_assoc]
    _ = 0 := by rw [hx, smul_zero]

/-- The same exponent killing `V` kills multiplication by `p`. -/
theorem verschiebungTorsion_le_primaryTorsion :
    verschiebungTorsion p M ≤ primaryTorsion p M := by
  refine iSup_le fun n => le_trans ?_ (le_iSup _ n)
  intro x hx
  change V p ^ n • x = 0 at hx
  change (p : RaynaudAlgebra p) ^ n • x = 0
  rw [← F_pow_mul_V_pow, mul_smul, hx, smul_zero]

/-- Verschiebung torsion is always primary torsion inside the stable-cycle module. -/
theorem verschiebungTorsion_le_torsionStableCycles :
    verschiebungTorsion p M ≤ primaryTorsion p M ⊓ stableCycles p M :=
  le_inf (verschiebungTorsion_le_primaryTorsion p M)
    (verschiebungTorsion_le_stableCycles p M)

/-- Frobenius saturation forms an increasing chain, by `d = FdV`. -/
theorem boundary_range_le_succ (s : ℕ) :
    LinearMap.range (operator p M (F p ^ s * d p)) ≤
      LinearMap.range (operator p M (F p ^ (s + 1) * d p)) := by
  rintro x ⟨y, rfl⟩
  refine ⟨V p • y, ?_⟩
  change (F p ^ (s + 1) * d p) • (V p • y) = (F p ^ s * d p) • y
  rw [← mul_smul, pow_succ]
  congr 1
  calc
    F p ^ s * F p * d p * V p = F p ^ s * (F p * d p * V p) := by
      simp only [mul_assoc]
    _ = F p ^ s * d p := by rw [F_mul_d_mul_V]

/-- The saturation is a union: one Frobenius exponent suffices for each element. -/
theorem mem_saturatedBoundaries (x : M) :
    x ∈ saturatedBoundaries p M ↔ ∃ s : ℕ, ∃ y : M, (F p ^ s * d p) • y = x := by
  have hm : Monotone (fun s : ℕ => LinearMap.range (operator p M (F p ^ s * d p))) :=
    monotone_nat_of_le_succ (boundary_range_le_succ p M)
  exact Submodule.mem_iSup_of_directed _ hm.directed_le

#print axioms saturatedBoundaries_le_stableCycles
#print axioms verschiebungTorsion_le_torsionStableCycles
#print axioms mem_saturatedBoundaries

end GaloisForLFunctions.ArithmeticHodgeTheoryOfDegenerations.HodgeWitt
