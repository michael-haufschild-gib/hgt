    (r^(11 : ℕ)*evenCompactHorner9Coeff11 t v) : ℝ) : ℝ) : ℝ) : ℝ)

/-- Assemble the checked coefficient identities without expanding their polynomials. -/
theorem evenCompactHorner9_step (r t v : ℝ) :
    evenCompactHorner9 r t v = evenCompactRelativeGapGrade9 r v+
      evenCompactUnitGap r t*evenCompactHorner10 r t v := by
  unfold evenCompactHorner9 evenCompactHorner10
  rw [evenCompactHorner9Coeff0_eq, evenCompactHorner9Coeff1_eq, evenCompactHorner9Coeff2_eq, evenCompactHorner9Coeff3_eq, evenCompactHorner9Coeff4_eq, evenCompactHorner9Coeff5_eq, evenCompactHorner9Coeff6_eq, evenCompactHorner9Coeff7_eq, evenCompactHorner9Coeff8_eq, evenCompactHorner9Coeff9_eq, evenCompactHorner9Coeff10_eq, evenCompactHorner9Coeff11_eq]
  unfold evenCompactRelativeGapGrade9 evenCompactUnitGap
  ring1

end
