theorem evenCompactHorner10Coeff10_eq (t v : ℝ) :
    evenCompactHorner10Coeff10 t v = (evenCompactRelativeGapGrade10Coeff10 v)+
      (191/10+t/10)*((0 : ℝ))+(-12/5+(16/15)*t)*(evenCompactHorner11Coeff9 t v) := by
  unfold evenCompactHorner10Coeff10 evenCompactRelativeGapGrade10Coeff10 evenCompactHorner11Coeff9
  ring1

/-- The exact Horner polynomial retains its drift grading. -/
def evenCompactHorner10 (r t v : ℝ) : ℝ :=
  (((evenCompactHorner10Coeff0 t v +
    (r^(1 : ℕ)*evenCompactHorner10Coeff1 t v) : ℝ) +
    ((r^(2 : ℕ)*evenCompactHorner10Coeff2 t v) +
    ((r^(3 : ℕ)*evenCompactHorner10Coeff3 t v) +
    (r^(4 : ℕ)*evenCompactHorner10Coeff4 t v) : ℝ) : ℝ) : ℝ) +
    (((r^(5 : ℕ)*evenCompactHorner10Coeff5 t v) +
    ((r^(6 : ℕ)*evenCompactHorner10Coeff6 t v) +
    (r^(7 : ℕ)*evenCompactHorner10Coeff7 t v) : ℝ) : ℝ) +
    ((r^(8 : ℕ)*evenCompactHorner10Coeff8 t v) +
    ((r^(9 : ℕ)*evenCompactHorner10Coeff9 t v) +
    (r^(10 : ℕ)*evenCompactHorner10Coeff10 t v) : ℝ) : ℝ) : ℝ) : ℝ)

/-- Assemble the checked coefficient identities without expanding their polynomials. -/
theorem evenCompactHorner10_step (r t v : ℝ) :
    evenCompactHorner10 r t v = evenCompactRelativeGapGrade10 r v+
      evenCompactUnitGap r t*evenCompactHorner11 r t v := by
  unfold evenCompactHorner10 evenCompactHorner11
  rw [evenCompactHorner10Coeff0_eq, evenCompactHorner10Coeff1_eq, evenCompactHorner10Coeff2_eq, evenCompactHorner10Coeff3_eq, evenCompactHorner10Coeff4_eq, evenCompactHorner10Coeff5_eq, evenCompactHorner10Coeff6_eq, evenCompactHorner10Coeff7_eq, evenCompactHorner10Coeff8_eq, evenCompactHorner10Coeff9_eq, evenCompactHorner10Coeff10_eq]
