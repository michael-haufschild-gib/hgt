    (((-285878773/139968000000000000000000000000000000 : ℝ)*t^(8 : ℕ) +
    (-26000431/11664000000000000000000000000000000 : ℝ)*t^(8 : ℕ)*v^(1 : ℕ) : ℝ) +
    ((-21476623/248832000000000000000000000000000000 : ℝ)*t^(8 : ℕ)*v^(2 : ℕ) +
    (-11273/31104000000000000000000000000000 : ℝ)*t^(9 : ℕ) : ℝ) : ℝ) : ℝ) : ℝ) : ℝ) : ℝ) : ℝ)

/-- This coefficient step is an exact identity with only a linear multiplier. -/
theorem evenCompactHorner11Coeff9_eq (t v : ℝ) :
    evenCompactHorner11Coeff9 t v = (evenCompactRelativeGapGrade11Coeff9 v)+
      (191/10+t/10)*((0 : ℝ))+(-12/5+(16/15)*t)*(evenCompactHorner12Coeff8 t v) := by
  unfold evenCompactHorner11Coeff9 evenCompactRelativeGapGrade11Coeff9 evenCompactHorner12Coeff8
  ring1

/-- The exact Horner polynomial retains its drift grading. -/
def evenCompactHorner11 (r t v : ℝ) : ℝ :=
  (((evenCompactHorner11Coeff0 t v +
    (r^(1 : ℕ)*evenCompactHorner11Coeff1 t v) : ℝ) +
    ((r^(2 : ℕ)*evenCompactHorner11Coeff2 t v) +
    ((r^(3 : ℕ)*evenCompactHorner11Coeff3 t v) +
    (r^(4 : ℕ)*evenCompactHorner11Coeff4 t v) : ℝ) : ℝ) : ℝ) +
    (((r^(5 : ℕ)*evenCompactHorner11Coeff5 t v) +
    (r^(6 : ℕ)*evenCompactHorner11Coeff6 t v) : ℝ) +
    ((r^(7 : ℕ)*evenCompactHorner11Coeff7 t v) +
    ((r^(8 : ℕ)*evenCompactHorner11Coeff8 t v) +
    (r^(9 : ℕ)*evenCompactHorner11Coeff9 t v) : ℝ) : ℝ) : ℝ) : ℝ)

/-- Assemble the checked coefficient identities without expanding their polynomials. -/
theorem evenCompactHorner11_step (r t v : ℝ) :
    evenCompactHorner11 r t v = evenCompactRelativeGapGrade11 r v+
      evenCompactUnitGap r t*evenCompactHorner12 r t v := by
  unfold evenCompactHorner11 evenCompactHorner12
  rw [evenCompactHorner11Coeff0_eq, evenCompactHorner11Coeff1_eq, evenCompactHorner11Coeff2_eq, evenCompactHorner11Coeff3_eq, evenCompactHorner11Coeff4_eq, evenCompactHorner11Coeff5_eq, evenCompactHorner11Coeff6_eq, evenCompactHorner11Coeff7_eq, evenCompactHorner11Coeff8_eq, evenCompactHorner11Coeff9_eq]
  unfold evenCompactRelativeGapGrade11 evenCompactUnitGap
  ring1

end
