theorem evenCompactHorner7_step (r t v : ℝ) :
    evenCompactHorner7 r t v = evenCompactRelativeGapGrade7 r v+
      evenCompactUnitGap r t*evenCompactHorner8 r t v := by
  unfold evenCompactHorner7 evenCompactHorner8
  rw [evenCompactHorner7Coeff0_eq, evenCompactHorner7Coeff1_eq, evenCompactHorner7Coeff2_eq, evenCompactHorner7Coeff3_eq, evenCompactHorner7Coeff4_eq, evenCompactHorner7Coeff5_eq, evenCompactHorner7Coeff6_eq, evenCompactHorner7Coeff7_eq, evenCompactHorner7Coeff8_eq, evenCompactHorner7Coeff9_eq, evenCompactHorner7Coeff10_eq, evenCompactHorner7Coeff11_eq, evenCompactHorner7Coeff12_eq, evenCompactHorner7Coeff13_eq]
