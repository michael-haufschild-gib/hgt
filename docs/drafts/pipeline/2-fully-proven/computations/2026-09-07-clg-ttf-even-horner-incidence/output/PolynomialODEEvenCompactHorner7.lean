    (((r^(3 : ℕ)*evenCompactHorner7Coeff3 t v) +
    (r^(4 : ℕ)*evenCompactHorner7Coeff4 t v) : ℝ) +
    ((r^(5 : ℕ)*evenCompactHorner7Coeff5 t v) +
    (r^(6 : ℕ)*evenCompactHorner7Coeff6 t v) : ℝ) : ℝ) : ℝ) +
