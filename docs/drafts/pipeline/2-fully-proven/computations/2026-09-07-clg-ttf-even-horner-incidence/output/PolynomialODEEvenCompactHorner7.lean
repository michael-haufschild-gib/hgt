      (191/10+t/10)*((0 : ℝ))+(-12/5+(16/15)*t)*(evenCompactHorner8Coeff12 t v) := by
  unfold evenCompactHorner7Coeff13 evenCompactRelativeGapGrade7Coeff13 evenCompactHorner8Coeff12
