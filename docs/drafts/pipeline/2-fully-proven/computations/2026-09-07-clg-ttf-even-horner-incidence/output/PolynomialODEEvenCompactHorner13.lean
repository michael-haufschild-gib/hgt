/-- This coefficient step is an exact identity with only a linear multiplier. -/
theorem evenCompactHorner13Coeff7_eq (t v : ℝ) :
    evenCompactHorner13Coeff7 t v = (evenCompactRelativeGapGrade13Coeff7 v)+
      (191/10+t/10)*((0 : ℝ))+(-12/5+(16/15)*t)*(evenCompactHorner14Coeff6 t v) := by
  unfold evenCompactHorner13Coeff7 evenCompactRelativeGapGrade13Coeff7 evenCompactHorner14Coeff6
  ring1

/-- The exact Horner polynomial retains its drift grading. -/
def evenCompactHorner13 (r t v : ℝ) : ℝ :=
  (((evenCompactHorner13Coeff0 t v +
    (r^(1 : ℕ)*evenCompactHorner13Coeff1 t v) : ℝ) +
    ((r^(2 : ℕ)*evenCompactHorner13Coeff2 t v) +
    (r^(3 : ℕ)*evenCompactHorner13Coeff3 t v) : ℝ) : ℝ) +
    (((r^(4 : ℕ)*evenCompactHorner13Coeff4 t v) +
    (r^(5 : ℕ)*evenCompactHorner13Coeff5 t v) : ℝ) +
    ((r^(6 : ℕ)*evenCompactHorner13Coeff6 t v) +
    (r^(7 : ℕ)*evenCompactHorner13Coeff7 t v) : ℝ) : ℝ) : ℝ)

/-- Assemble the checked coefficient identities without expanding their polynomials. -/
theorem evenCompactHorner13_step (r t v : ℝ) :
    evenCompactHorner13 r t v = evenCompactRelativeGapGrade13 r v+
      evenCompactUnitGap r t*evenCompactHorner14 r t v := by
  unfold evenCompactHorner13 evenCompactHorner14
  rw [evenCompactHorner13Coeff0_eq, evenCompactHorner13Coeff1_eq, evenCompactHorner13Coeff2_eq, evenCompactHorner13Coeff3_eq, evenCompactHorner13Coeff4_eq, evenCompactHorner13Coeff5_eq, evenCompactHorner13Coeff6_eq, evenCompactHorner13Coeff7_eq]
  unfold evenCompactRelativeGapGrade13 evenCompactUnitGap
  ring1

