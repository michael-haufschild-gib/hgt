    (r^(2 : ℕ)*evenCompactHorner8Coeff2 t v) : ℝ) : ℝ) +
    ((r^(3 : ℕ)*evenCompactHorner8Coeff3 t v) +
    ((r^(4 : ℕ)*evenCompactHorner8Coeff4 t v) +
    (r^(5 : ℕ)*evenCompactHorner8Coeff5 t v) : ℝ) : ℝ) : ℝ) +
    (((r^(6 : ℕ)*evenCompactHorner8Coeff6 t v) +
    ((r^(7 : ℕ)*evenCompactHorner8Coeff7 t v) +
    (r^(8 : ℕ)*evenCompactHorner8Coeff8 t v) : ℝ) : ℝ) +
