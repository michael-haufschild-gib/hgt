theorem evenCompactHorner8_step (r t v : ℝ) :
    evenCompactHorner8 r t v = evenCompactRelativeGapGrade8 r v+
      evenCompactUnitGap r t*evenCompactHorner9 r t v := by
  unfold evenCompactHorner8 evenCompactHorner9
  rw [evenCompactHorner8Coeff0_eq, evenCompactHorner8Coeff1_eq, evenCompactHorner8Coeff2_eq, evenCompactHorner8Coeff3_eq, evenCompactHorner8Coeff4_eq, evenCompactHorner8Coeff5_eq, evenCompactHorner8Coeff6_eq, evenCompactHorner8Coeff7_eq, evenCompactHorner8Coeff8_eq, evenCompactHorner8Coeff9_eq, evenCompactHorner8Coeff10_eq, evenCompactHorner8Coeff11_eq, evenCompactHorner8Coeff12_eq]
  unfold evenCompactRelativeGapGrade8 evenCompactUnitGap
