private theorem compactCert11_nonneg (t z : ℝ) (ht : 0 ≤ t) (ht1 : t ≤ 1)
    (hz : 0 ≤ z) (hz1 : z ≤ 1) : 0 ≤ compactCert11 t z := by
  have h1 : 0 ≤ 1-t := sub_nonneg.mpr ht1

