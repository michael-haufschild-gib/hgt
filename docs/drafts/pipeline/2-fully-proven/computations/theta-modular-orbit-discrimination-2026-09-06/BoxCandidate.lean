/-- The compact certificate in fact allows any amplitude A ≥ 17. -/
theorem modularThetaCompactD1_pos (S A W : ℝ) (hS : -1 ≤ S) (hS0 : S ≤ 0)
    (hA : 17 ≤ A) (hW : 0 ≤ W) (hW1 : W ≤ 6/5) :
    0 < modularThetaCompactD1 S A W := by
  have ht : 0 ≤ -S := by linarith
  have ht1 : -S ≤ 1 := by linarith
  have hz : 0 ≤ 5*W/6 := by linarith
  have hz1 : 5*W/6 ≤ 1 := by linarith
  have ha : 0 ≤ A-17 := by linarith

  have h0 := compactSlice0_lower (-S) (5*W/6) ht ht1 hz hz1

  have h1 := compactSlice1_lower (-S) (5*W/6) ht ht1 hz hz1

  have h2 := compactSlice2_lower (-S) (5*W/6) ht ht1 hz hz1

  have h3 := compactSlice3_lower (-S) (5*W/6) ht ht1 hz hz1

  have h4 := compactSlice4_lower (-S) (5*W/6) ht ht1 hz hz1

  have h5 := compactSlice5_lower (-S) (5*W/6) ht ht1 hz hz1

  have h6 := compactSlice6_lower (-S) (5*W/6) ht ht1 hz hz1

  have h7 := compactSlice7_lower (-S) (5*W/6) ht ht1 hz hz1

  have h8 := compactSlice8_lower (-S) (5*W/6) ht ht1 hz hz1

  have h9 := compactSlice9_lower (-S) (5*W/6) ht ht1 hz hz1

  have h10 := compactSlice10_lower (-S) (5*W/6) ht ht1 hz hz1

  have h11 := compactSlice11_lower (-S) (5*W/6) ht ht1 hz hz1

  have h12 := compactSlice12_lower (-S) (5*W/6) ht ht1 hz hz1

  have hid : modularThetaCompactD1 S A W =
    (A-17)^0 * compactSlice0 (-S) (5*W/6) +
    (A-17)^1 * compactSlice1 (-S) (5*W/6) +
    (A-17)^2 * compactSlice2 (-S) (5*W/6) +
    (A-17)^3 * compactSlice3 (-S) (5*W/6) +
    (A-17)^4 * compactSlice4 (-S) (5*W/6) +
    (A-17)^5 * compactSlice5 (-S) (5*W/6) +
    (A-17)^6 * compactSlice6 (-S) (5*W/6) +
    (A-17)^7 * compactSlice7 (-S) (5*W/6) +
    (A-17)^8 * compactSlice8 (-S) (5*W/6) +
    (A-17)^9 * compactSlice9 (-S) (5*W/6) +
    (A-17)^10 * compactSlice10 (-S) (5*W/6) +
    (A-17)^11 * compactSlice11 (-S) (5*W/6) +
    (A-17)^12 * compactSlice12 (-S) (5*W/6) := by

    unfold modularThetaCompactD1 modularThetaCompactD1Part0 modularThetaCompactD1Part1 modularThetaCompactD1Part2 modularThetaCompactD1Part3 modularThetaCompactD1Part4 modularThetaCompactD1Part5 modularThetaCompactD1Part6 modularThetaCompactD1Part7 modularThetaCompactD1Part8 modularThetaCompactD1Part9 modularThetaCompactD1Part10 modularThetaCompactD1Part11 modularThetaCompactD1Part12 modularThetaCompactD1Part13 modularThetaCompactD1Part14 modularThetaCompactD1Part15 modularThetaCompactD1Part16 modularThetaCompactD1Part17 compactSlice0 compactSlice1 compactSlice2 compactSlice3 compactSlice4 compactSlice5 compactSlice6 compactSlice7 compactSlice8 compactSlice9 compactSlice10 compactSlice11 compactSlice12
    ring

  rw [hid]
  have hpos : 0 < compactSlice0 (-S) (5*W/6) := by linarith
  positivity
end
