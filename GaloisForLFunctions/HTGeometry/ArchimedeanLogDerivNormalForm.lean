import GaloisForLFunctions.HTGeometry.DigammaJetShiftMerge
import GaloisForLFunctions.HTGeometry.ArchimedeanLogDerivDigammaSum

/-!
# The normal form of the archimedean logarithmic derivative

`Ψ = G'/G` for `G(s) = e^{αs}·∏ Γ(n_j s + μ_j)` is `α + Σ_j n_j ψ(n_j s + μ_j)`.  The Gauss
multiplication formula replaces each scaled digamma by a sum of unscaled ones, and merging the
congruent shifts among the resulting family leaves a rational function plus a linear combination of
digammas at **pairwise incongruent** shifts.

That is what puts `L = ℂ(s)⟨Ψ⟩` inside the field generated by digamma jets at incongruent shifts,
where the boundary datum is available.
-/

open Filter Topology Complex

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

/-- **The normal form of `Ψ`.**  Up to a rational function, the logarithmic derivative of a finite
archimedean product is a linear combination of digammas at pairwise incongruent shifts. -/
theorem exists_incongruent_normalForm_archimedeanLogDeriv
    {d : ℕ} (n : Fin d → ℕ) (hn : ∀ j, 0 < n j) (μ : Fin d → ℂ) (a : ℂ) :
    ∃ (r : ℕ) (nu : Fin r → ℂ) (cc : Fin r → ℂ) (P Q : Polynomial ℂ), Q ≠ 0 ∧
      (∀ i i', i ≠ i' → ∀ m : ℤ, nu i - nu i' ≠ (m : ℂ)) ∧
      ∀ w : ℂ, (∀ (j : Fin d) (m : ℕ), (n j : ℂ) * w + μ j ≠ -(m : ℂ)) →
        (∀ (j : Fin d) (k : ℕ) (m : ℤ), w + (μ j + (k : ℂ)) / (n j : ℂ) ≠ (m : ℂ)) →
        Q.eval w ≠ 0 ∧
        a + ∑ j : Fin d, (n j : ℂ) * Complex.digamma ((n j : ℂ) * w + μ j)
          = (a + ∑ j : Fin d, (n j : ℂ) * Complex.log (n j : ℂ))
            + P.eval w / Q.eval w
            + ∑ i : Fin r, cc i * Complex.digamma (w + nu i) := by
  classical
  -- flatten the Gauss family
  set S : Type := (j : Fin d) × Fin (n j) with hS
  set rr : ℕ := Fintype.card S with hrr
  set ev : Fin rr ≃ S := (Fintype.equivFin S).symm with hev
  set nu0 : Fin rr → ℂ := fun i => (μ (ev i).1 + (((ev i).2 : ℕ) : ℂ)) / (n (ev i).1) with hnu0
  obtain ⟨P₀, Q₀, hQ₀, hmerge⟩ := exists_poly_digammaJet_sum_merge nu0 (fun _ => (1 : ℂ)) 0
  -- re-index the representatives
  set r' : ℕ := Fintype.card (CongReps nu0) with hr'
  set ev' : Fin r' ≃ CongReps nu0 := (Fintype.equivFin (CongReps nu0)).symm with hev'
  refine ⟨r', fun i => nu0 (ev' i : Fin rr),
    fun i => ∑ x ∈ Finset.univ.filter fun x => toCongRep nu0 x = ev' i, (1 : ℂ),
    P₀, Q₀, hQ₀, ?_, ?_⟩
  · intro i i' hii m hcon
    refine not_intCongruent_of_ne nu0 (a := ev' i) (b := ev' i') (fun h => hii (ev'.injective h))
      ⟨m, hcon⟩
  · intro w hpole hpole'
    have hnu : ∀ i : Fin rr, ∀ m : ℤ, w + nu0 i ≠ (m : ℂ) := by
      intro i m
      rw [hnu0]
      exact hpole' (ev i).1 ((ev i).2 : ℕ) m
    obtain ⟨hQz, hval⟩ := hmerge w hnu
    refine ⟨hQz, ?_⟩
    have hgauss := sum_scaleShift_digamma_eq n hn μ hpole
    have hflat : (∑ j : Fin d, ∑ k ∈ Finset.range (n j),
        Complex.digamma (w + (μ j + (k : ℂ)) / (n j : ℂ)))
        = ∑ i : Fin rr, Complex.digamma (w + nu0 i) := by
      have hsig : (∑ j : Fin d, ∑ k ∈ Finset.range (n j),
          Complex.digamma (w + (μ j + (k : ℂ)) / (n j : ℂ)))
          = ∑ s : S, Complex.digamma (w + (μ s.1 + ((s.2 : ℕ) : ℂ)) / (n s.1)) := by
        rw [Fintype.sum_sigma]
        exact Finset.sum_congr rfl fun j _ => by
          rw [← Fin.sum_univ_eq_sum_range
            (fun k : ℕ => Complex.digamma (w + (μ j + (k : ℂ)) / (n j : ℂ))) (n j)]
      rw [hsig, ← Equiv.sum_comp ev
        (fun s : S => Complex.digamma (w + (μ s.1 + ((s.2 : ℕ) : ℂ)) / (n s.1)))]
      exact Finset.sum_congr rfl fun i _ => by rw [hnu0]
    simp only [iteratedDeriv_zero, one_mul] at hval
    rw [hgauss, hflat, hval]
    ring

end

end GaloisForLFunctions.HTGeometry
