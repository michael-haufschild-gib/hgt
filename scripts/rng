#!/usr/bin/env python3
"""Session entropy source.

Subcommands:
  seed                       print (and pin) the session seed
  int A B [N]                N (default 1) uniform integers in [A, B], one per line
  pick X Y Z ...             one uniformly chosen argument
  shuffle X Y Z ...          the arguments in uniformly random order

The seed is stored in .rng_seed at the repo root the first time `seed` is run
so a session's draws stay reproducible and auditable.  Every subsequent call
mixes the pinned seed with fresh OS entropy, so draws are not repeatable within
a session -- the pinned seed only records which session the log belongs to.
"""

import os
import random
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SEED_FILE = ROOT / ".rng_seed"


def get_seed() -> int:
    if SEED_FILE.exists():
        return int(SEED_FILE.read_text().strip())
    seed = int.from_bytes(os.urandom(8), "big")
    SEED_FILE.write_text(str(seed) + "\n")
    return seed


def rng() -> random.Random:
    get_seed()
    return random.Random(int.from_bytes(os.urandom(16), "big"))


def main(argv):
    if not argv:
        print(__doc__)
        return 1
    cmd, rest = argv[0], argv[1:]
    if cmd == "seed":
        print(get_seed())
        return 0
    r = rng()
    if cmd == "int":
        if len(rest) < 2:
            print("usage: rng int A B [N]", file=sys.stderr)
            return 2
        a, b = int(rest[0]), int(rest[1])
        n = int(rest[2]) if len(rest) > 2 else 1
        for _ in range(n):
            print(r.randint(a, b))
        return 0
    if cmd == "pick":
        if not rest:
            print("usage: rng pick X Y ...", file=sys.stderr)
            return 2
        print(r.choice(rest))
        return 0
    if cmd == "shuffle":
        items = list(rest)
        r.shuffle(items)
        for it in items:
            print(it)
        return 0
    print(f"unknown subcommand: {cmd}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
