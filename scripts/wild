#!/usr/bin/env python3
"""wild — semantic entropy injection via a weak, UNPRIMED external model (OpenRouter).

Companion to `scripts/rng`. Where `rng` draws a random domain from a fixed deck, `wild`
asks a deliberately SMALL model (which does NOT share the frontier agents' training priors,
and is not primed on this project) for vivid metaphors/associations. Its associations come
from a different, smaller distribution — so they can hand you collisions you would never
self-generate. Use it on every convergence, exactly like `rng`.

Usage:
    scripts/wild "the object or concept to collide with"
    WILD_MODEL=mistralai/mistral-7b-instruct scripts/wild "..."   # swap the weak model

The model is intentionally weak. Do not 'fix' its output — its strangeness is the point.
Take what it returns, force the structural collision with your object, then VALIDATE
(generate-then-kill). A metaphor that survives refutation is the only thing that scores.
"""
import os, sys, json, urllib.request

def load_key():
    key = os.environ.get("OPEN_ROUTER_API_KEY")
    if key:
        return key
    d = os.path.dirname(os.path.abspath(__file__))
    for _ in range(6):
        p = os.path.join(d, ".env")
        if os.path.isfile(p):
            for line in open(p):
                line = line.strip()
                if line.startswith("OPEN_ROUTER_API_KEY="):
                    return line.split("=", 1)[1].strip().strip('"').strip("'")
        d = os.path.dirname(d)
    return None

MODEL = os.environ.get("WILD_MODEL", "meta-llama/llama-3.2-3b-instruct")

def main():
    obj = " ".join(sys.argv[1:]).strip()
    if not obj:
        print('usage: scripts/wild "<object/concept>"', file=sys.stderr)
        sys.exit(2)
    key = load_key()
    if not key:
        print("error: OPEN_ROUTER_API_KEY not found (.env)", file=sys.stderr)
        sys.exit(1)
    prompt = (
        "Give 5 wild, concrete metaphors or associations for the following, each drawn from a "
        "COMPLETELY UNRELATED everyday or physical domain (cooking, plumbing, weather, sports, "
        "animals, machines, crafts, music...). Be vivid and strange. One short line each. "
        "No explanation, no preamble, no numbering beyond a dash.\n\n"
        f"THING: {obj}"
    )
    body = json.dumps({
        "model": MODEL,
        "messages": [{"role": "user", "content": prompt}],
        "temperature": 1.15,
        "top_p": 0.98,
        "max_tokens": 320,
    }).encode()
    req = urllib.request.Request(
        "https://openrouter.ai/api/v1/chat/completions",
        data=body,
        headers={
            "Authorization": f"Bearer {key}",
            "Content-Type": "application/json",
            "X-Title": "hgt-wild",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=90) as r:
            data = json.load(r)
        print(f"[wild · {MODEL}]")
        print(data["choices"][0]["message"]["content"].strip())
    except Exception as e:
        print(f"error calling OpenRouter: {e}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
