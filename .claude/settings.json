{
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": ["agentchattr", "sequential-thinking"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-git-stash-revert.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/lean-search-reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
