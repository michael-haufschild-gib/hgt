{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "xxx*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/agent_answer_reminder.py",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/agent_answer_reminder.py",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
